// Self-test for tools/merge-recovered-join-tails.ab and mark-recovered-noinline.ab.
//
//     tools/abla-tool check-merge-recovered-join-tails

import "abla/io"
import "abla/text"
import "merge-recovered-join-tails.ab" as merge
import "mark-recovered-noinline.ab" as noinline

fun tailFunction(body: string): string =
    "// Original ABI symbol: f\ntrusted fun esp32RecoveredF(\n): u32 {\n" + body + "}\n"

fun tailRun(body: string): string = merge.processText(tailFunction(body)).text

var tailFailures = 0

fun tailCheck(name: string, source: string, expected: string): void {
    val got = tailRun(source)
    if (got != tailFunction(expected)) {
        eprintln("$name: unexpected rewrite\n--- got\n$got\n--- expected\n${tailFunction(expected)}")
        tailFailures = tailFailures + 1
    }
}

fun main: int {
    // if/else arms end with the same statements: hoisted after the branch.
    tailCheck("if-else",
        "    if (r2 == u32(0)) {\n        r3 = u32(1)\n        r10 = f(r10)\n        r11 = u32(0)\n        return r2\n" +
        "    } else {\n        r3 = u32(2)\n        r10 = f(r10)\n        r11 = u32(0)\n        return r2\n    }\n",
        "    if (r2 == u32(0)) {\n        r3 = u32(1)\n    } else {\n        r3 = u32(2)\n    }\n" +
        "    r10 = f(r10)\n    r11 = u32(0)\n    return r2\n")

    // `when` arms with a shared tail; a terminating arm is exempt.
    tailCheck("when",
        "    when (r2) {\n        0 -> {\n            r3 = u32(1)\n            r10 = g(r3)\n            return r10\n        }\n" +
        "        1 -> {\n            r3 = u32(2)\n            r10 = g(r3)\n            return r10\n        }\n" +
        "        else -> {\n            return r2\n        }\n    }\n",
        "    when (r2) {\n        0 -> {\n            r3 = u32(1)\n        }\n        1 -> {\n            r3 = u32(2)\n        }\n" +
        "        else -> {\n            return r2\n        }\n    }\n    r10 = g(r3)\n    return r10\n")

    // A name declared in an arm prefix and used by the tail must not move.
    val scoped = "    if (r2 == u32(0)) {\n        val a = u32(1)\n        r3 = a\n        r10 = f(a)\n        return r10\n" +
        "    } else {\n        val a = u32(2)\n        r3 = a\n        r10 = f(a)\n        return r10\n    }\n"
    tailCheck("scope", scoped, scoped)

    // A bare shared `return` is left alone.
    val bare = "    if (r2 == u32(0)) {\n        r3 = u32(1)\n        return r2\n" +
        "    } else {\n        r3 = u32(2)\n        return r2\n    }\n"
    tailCheck("bare-return", bare, bare)

    // Guard cascade: terminating `if` followed by a path with the same tail.
    tailCheck("guard",
        "    if (r2 == u32(0)) {\n        r3 = u32(1)\n        r10 = f(r10)\n        r11 = u32(0)\n        return r2\n    }\n" +
        "    r3 = u32(2)\n    r10 = f(r10)\n    r11 = u32(0)\n    return r2\n",
        "    if (r2 == u32(0)) {\n        r3 = u32(1)\n    } else {\n        r3 = u32(2)\n    }\n" +
        "    r10 = f(r10)\n    r11 = u32(0)\n    return r2\n")

    val marked = noinline.processNoinline(
        "@section(\".x\")\ntrusted fun esp32RecoveredA(\n    a2: u32\n): u32 {\n    var r2 = a2\n    r2 = r2 + u32(1)\n    return r2\n}\n" +
        "@naked\ntrusted fun esp32RecoveredB(\n): u32 = \$xtensa instructions {}\n", 0)
    if (marked.count != 1 || !marked.text.contains("@section(\".x\")\n@noinline\ntrusted fun esp32RecoveredA")) {
        eprintln("mark-recovered-noinline: unexpected rewrite\n${marked.text}")
        tailFailures = tailFailures + 1
    }

    if (tailFailures != 0) return 1
    println("join-tail merge and noinline marking passed")
    0
}
