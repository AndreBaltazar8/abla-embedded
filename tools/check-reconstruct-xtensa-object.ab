// Regression checks for source-level Xtensa reconstruction helpers.
//
//     tools/abla-tool check-reconstruct-xtensa-object

import "abla/io"
import "abla/bytes"
import "abla/text"
import "lib/reconstruct-xtensa.ab"

class AddmiCase(val source: string, val expected: string)

fun main: int {
    val cases = [
        AddmiCase("addmi\ta11, a7, 0xffff8000", "addmi\ta11, a7, -32768"),
        AddmiCase("addmi\ta11, a7, 0xfffffe00", "addmi\ta11, a7, -512"),
        AddmiCase("addmi\ta4, a4, 0x200", "addmi\ta4, a4, 0x200"),
        AddmiCase("movi\ta4, 0xffff8000", "movi\ta4, 0xffff8000")
    ]
    for (item in cases) {
        val actual = normalizeXtensaAssemblerImmediate(item.source)
        if (actual != item.expected) {
            eprintln("immediate normalization mismatch: '${item.source}' -> '$actual', expected '${item.expected}'")
            return 1
        }
    }
    val content: Map<string, string> = Map()
    content.set(".data.root", byteEncode(0) + byteEncode(0) + byteEncode(0) + byteEncode(0))
    content.set(".rodata.str1.1", "abc" + byteEncode(0))
    val relocations: Map<string, Map<int, ReconReloc>> = Map()
    val dataRoot: Map<int, ReconReloc> = Map()
    dataRoot.set(0, ReconReloc("32", ".rodata.str1.1"))
    relocations.set(".data.root", dataRoot)
    val metadata: Map<string, ReconMeta> = Map()
    metadata.set(".data.root", ReconMeta(4, 2))
    metadata.set(".rodata.str1.1", ReconMeta(4, 0))
    val symbols: Map<string, ReconSymbol> = Map()
    symbols.set("root", ReconSymbol(".data.root", 4))
    val starts: Map<string, int> = Map()
    val none: array<string> = []
    val internal: array<string> = ["root"]
    val prefix = recoveredDataPrefix("movi a2, root", none, internal, none, none, content, relocations,
        metadata, symbols, starts, none, false, Map())
    if (prefix.error != "") {
        eprintln(prefix.error)
        return 1
    }
    var found = false
    for (line in prefix.directives) {
        if (line.startsWith(".pushsection .rodata.str1.1,")) found = true
    }
    if (!found) {
        eprintln("data-to-data section dependency was not reconstructed")
        return 1
    }
    println("Xtensa reconstruction helper checks: ${cases.size + 1} passed")
    0
}
