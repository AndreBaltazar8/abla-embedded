#!/usr/bin/env bash
set -euo pipefail
if [[ $# -ne 2 ]]; then
    echo 'usage: bash tools/optimize-embedded-size INPUT.ll OUTPUT.bc' >&2
    exit 2
fi
# Inlining scalar facades exposes constant pins after the first interprocedural
# propagation phase. Refine those constants, then simplify the newly specialized
# callees. This remains one monolithic LLVM module, never separate objects.
exec opt '-passes=default<Oz>,globaldce,ipsccp,function(instcombine<no-verify-fixpoint>,simplifycfg),globaldce,default<Oz>,globaldce' \
    "$1" -o "$2"
