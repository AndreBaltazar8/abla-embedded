#!/usr/bin/env bash
set -euo pipefail
if [[ $# -ne 2 ]]; then
    echo 'usage: bash tools/optimize-embedded-size INPUT.ll OUTPUT.bc' >&2
    exit 2
fi
# Inlining scalar facades exposes constant pins after the first interprocedural
# propagation phase. Refine those constants, then simplify the newly specialized
# callees. This remains one monolithic LLVM module, never separate objects.
# LLVM 23 has no default<Oz>: size comes from O2 over minsize functions, the
# same way ablac optimizes MCU modules (src/toolchain.ab).
exec opt --force-attribute=minsize --disable-loop-unrolling \
    '-passes=default<O2>,globaldce,ipsccp,function(instcombine<no-verify-fixpoint>,simplifycfg),globaldce,default<O2>,globaldce' \
    "$1" -o "$2"
