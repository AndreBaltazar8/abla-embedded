#!/usr/bin/env python3
"""Replace safe recovered Xtensa symbol calls with ordinary Abla calls.

The recovered windowed-ABI functions have a uniform six-register plus ten
stack-word signature.  When an Abla-owned callee never reads its stack words,
an outgoing symbolic `$xtensa call` can call that function directly: supplied
register arguments retain their order and all absent ABI positions are zero.
This exposes the edge to normal semantic analysis, inlining, and dead-code
elimination.  Calls with stack-dependent callees, wide/void results, indirect
targets, or symbols without an Abla internal mapping remain target operations.
"""

from __future__ import annotations

