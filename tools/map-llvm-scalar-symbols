#!/usr/bin/env python3
"""Map scalar Abla LLVM fingerprints in llvm-nm -S output to source declarations.

Only plain named functions with explicit scalar parameters/results are parsed;
extensions/generics/default arguments remain unmapped, never guessed.
"""
import argparse
import pathlib
import re

def fingerprint(parts, seed, factor, modulus):
    for value in ''.join(parts):
        seed = (seed * factor + ord(value) + 1) % modulus
    return seed

def symbols(path):
    result = {}
    for line in path.read_text().splitlines():
        match = re.fullmatch(r'([0-9a-fA-F]+)\s+([0-9a-fA-F]+)\s+([tT])\s+(\S+)', line.strip())
        if match:
            result[match[4]] = (int(match[2], 16), match[1])
    return result

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('nm', type=pathlib.Path)
    parser.add_argument('roots', nargs='+', type=pathlib.Path)
    parser.add_argument('--baseline', type=pathlib.Path)
    parser.add_argument('--limit', type=int, default=20)
    args = parser.parse_args()
    scalar = r'(?:u8|u16|u32|u64|i8|i16|i32|i64|int|bool|void|f32|f64)'
    declarations = re.compile(r'\bfun\s+(\w+)\s*\(([^()]*)\)\s*:\s*(' + scalar + r')\b')
    mapping = {}
    for root in args.roots:
        for path in sorted(root.rglob('*.ab')):
            source = path.read_text()
            # Comments cannot contribute apparent declarations.
            clean = re.sub(r'/\*.*?\*/|//[^\n]*', lambda m: '\n' * m[0].count('\n'), source, flags=re.S)
            for match in declarations.finditer(clean):
                parts, valid = [match[1]], True
                for parameter in filter(None, map(str.strip, match[2].split(','))):
                    found = re.fullmatch(r'(\w+)\s*:\s*(' + scalar + ')', parameter)
                    if not found:
                        valid = False
                        break
                    parts.extend(found.groups())
                if not valid:
                    continue
                parts.append(match[3])
                first = fingerprint(parts, 41, 269, 1000000007)
                second = fingerprint(parts, 101, 271, 1000000009)
                key = f'abla_fn_{first}_{second}'
                label = f'{match[1]} {path}:{clean.count(chr(10), 0, match.start()) + 1}'
                mapping.setdefault(key, set()).add(label)
    baseline = symbols(args.baseline) if args.baseline else {}
    print('bytes\tdelta\taddress\tsymbol\tdeclaration')
    for symbol, (size, address) in sorted(symbols(args.nm).items(), key=lambda item: (-item[1][0], item[0]))[:args.limit]:
        key = symbol.removesuffix('_direct')
        matches = mapping.get(key, set())
        label = next(iter(matches)) if len(matches) == 1 else f'{symbol} [unmapped or ambiguous]'
        delta = str(size - baseline[symbol][0]) if symbol in baseline else '?'
        print(f'{size}\t{delta}\t{address}\t{symbol}\t{label}')

if __name__ == '__main__':
    main()
