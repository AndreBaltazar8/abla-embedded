// The `$xtensa` operations left in src/ may only be the exact naked CALL0 leaves restored
// from the working exception/IPC ABI. No general allowance for instruction blocks in the
// containing files: every `$xtensa instructions|call|callVoid|callWide` anywhere else is
// reported as `PATH:LINE: forbidden KIND boundary` and the exit status is 1.
//
// Called by tools/check-pure-abla-xtensa-boundaries as
//     tools/abla-tool check-pure-abla-xtensa-operations PROJECT_ROOT

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/regex"
import "abla/process/arguments"

// (file, function) pairs of the allowed naked leaves.
val leafFiles = [
    "src/esp32/system/ipc_isr_routines_esp32.ab",
    "src/esp32/freertos/port_assembly_esp32.ab",
    "src/esp32/freertos/port_assembly_esp32.ab"
]
val leafNames = ["esp32IpcIsrWaitingForFinishCommand", "esp32RecoveredFrxtTaskCoprocState", "esp32RecoveredFrxtCoprocExcHook"]

fun isLeaf(relative: string, name: string): bool {
    var index = 0
    while (index < leafFiles.size) {
        if (leafFiles[index] == relative && leafNames[index] == name) return true
        index = index + 1
    }
    false
}

// Every .ab file below `directory`, as paths joined with `/`.
fun collect(directory: Path, var files: array<string>): void {
    for (entry in directory.entries()) {
        val info = entry.info()
        if (info.isDirectory()) collect(entry, files)
        else if (info.isFile() && entry.text.endsWith(".ab")) files.append(entry.text)
    }
}

// The name of the naked function declared right before the operation (the declaration must
// end the text before `$xtensa`), or "".
fun nakedBefore(naked: Regex, source: string, start: int): string {
    val from = if (start > 2000) start - 2000 else 0
    val window = source.slice(from, start)
    val found = naked.find(window)
    if (found == null) return ""
    window.slice(found.groupStart(1), found.groupEnd(1))
}

fun main: int {
    if (processArgumentCount() != 1) {
        eprintln("usage: check-pure-abla-xtensa-operations PROJECT_ROOT")
        return 2
    }
    val root = processArgument(0)
    val operation = regexCompile("""\$xtensa\s+(instructions|call|callVoid|callWide)[\s{(]""")
    val naked = regexCompile("""@naked\s+(?:@section\("[^"\n]*"\)\s+)?trusted fun (\w+)\([^)]*\): void =\s*$""")
    if (!operation.succeeded || !naked.succeeded) {
        eprintln("internal error: bad pattern")
        return 2
    }
    val files: array<string> = []
    collect(Path(root + "/src"), files)
    var failed = false
    for (file in sortedStrings(files)) {
        val read = Path(file).readTextResult()
        if (!read.succeeded) {
            eprintln("cannot read $file")
            return 1
        }
        val source = read.text
        if (!source.contains("\$xtensa")) continue
        val relative = file.slice(root.size + 1, file.size)
        var from = 0
        while (true) {
            val found = operation.regex.find(source, from)
            if (found == null) break
            val kind = source.slice(found.groupStart(1), found.groupEnd(1))
            val start = found.start()
            val declaration = nakedBefore(naked.regex, source, start)
            if (kind == "instructions" && declaration != "" && isLeaf(relative, declaration)) {
                // allowed exact leaf
            } else {
                val line = source.slice(0, start).split("\n").size
                println("$relative:$line: forbidden $kind boundary")
                failed = true
            }
            from = found.end()
        }
    }
    if (failed) 1 else 0
}
