// Check an ELF32 target closure's allocated section placement before linking.
//
// Not final address/linker/stack/other-core proof; this catches generated tables
// and outlined helpers that would otherwise land in flash sections.
//
//     tools/abla-tool check-cache-internal-object OBJECT.o

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/arguments"
import "lib/elf.ab"

// A section as validateCacheInternalSections sees it.
class SectionPlacement(val name: string, val flags: int, val size: int)

// "" when every allocated section is IRAM code or DRAM data and some IRAM code
// exists; otherwise the reason.
fun validateCacheInternalSections(sections: array<SectionPlacement>): string {
    var code = 0
    for (section in sections) {
        if (section.size == 0 || (section.flags & ELF_SHF_ALLOC) == 0) continue
        if ((section.flags & ELF_SHF_EXECINSTR) != 0) {
            if (!(section.name == ".iram1" || section.name.startsWith(".iram1."))) {
                return "executable section outside IRAM: ${section.name} (${section.size} bytes)"
            }
            code = code + section.size
        } else if (!(section.name == ".dram1" || section.name.startsWith(".dram1."))) {
            return "allocated data outside internal DRAM: ${section.name} (${section.size} bytes)"
        }
    }
    if (code == 0) return "no allocated IRAM code found"
    ""
}

fun validateCacheInternalObject(data: string): string {
    val elf = elf32Parse(data)
    if (elf.error != "") return elf.error
    val placements: array<SectionPlacement> = []
    for (section in elf.sections) placements.append(SectionPlacement(section.name, section.flags, section.size))
    validateCacheInternalSections(placements)
}

fun main: int {
    if (processArgumentCount() != 1) {
        eprintln("usage: check-cache-internal-object OBJECT.o")
        return 2
    }
    val data = Path(processArgument(0)).readTextResult()
    if (!data.succeeded) {
        eprintln("cannot read ${processArgument(0)}")
        return 1
    }
    val error = validateCacheInternalObject(data.text)
    if (error != "") {
        eprintln(error)
        return 1
    }
    println("PASS: allocated closure uses only IRAM code and DRAM data sections (not final linker/hardware proof)")
    0
}
