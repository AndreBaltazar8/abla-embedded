#!/usr/bin/env python3
"""Give recovered functions unique subsections inside their placement family."""

from __future__ import annotations

import argparse
import pathlib
import re


FUNCTION_SECTION = re.compile(
    r'@section\("(?P<section>\.(?:iram|rtc)[^"\n]*?\.[0-9]+)"\)\n'
    r'(?P<declaration>trusted fun (?P<name>[A-Za-z_][A-Za-z0-9_]*))'
)


def rewrite(source: str) -> tuple[str, int]:
    def replace(match: re.Match[str]) -> str:
        section = match.group("section")
        name = match.group("name")
        return f'@section("{section}.abla.{name}")\n{match.group("declaration")}'

    return FUNCTION_SECTION.subn(replace, source)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--write", action="store_true")
    parser.add_argument("sources", nargs="+", type=pathlib.Path)
    arguments = parser.parse_args()
    total = 0
    for path in arguments.sources:
        source = path.read_text()
        result, changed = rewrite(source)
        if arguments.write and changed:
            path.write_text(result)
        total += changed
        action = "rewrote" if arguments.write else "would rewrite"
        if changed:
            print(f"{path}: {action} {changed} function section(s)")
    action = "rewrote" if arguments.write else "would rewrite"
    print(f"{action} {total} recovered function section(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
