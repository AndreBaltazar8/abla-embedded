#!/usr/bin/env python3
"""Check an ELF32 target closure's allocated section placement before linking.

Not final address/linker/stack/other-core proof; this catches generated tables
and outlined helpers that would otherwise land in flash sections.
"""
import struct
import sys
from pathlib import Path


def validate_sections(sections):
    code = 0
    for name, flags, size in sections:
        if not size or not flags & 2:  # SHF_ALLOC
            continue
        if flags & 4:  # SHF_EXECINSTR
            if not (name == ".iram1" or name.startswith(".iram1.")):
                raise ValueError(f"executable section outside IRAM: {name} ({size} bytes)")
            code += size
        elif not (name == ".dram1" or name.startswith(".dram1.")):
            raise ValueError(f"allocated data outside internal DRAM: {name} ({size} bytes)")
    if code == 0:
        raise ValueError("no allocated IRAM code found")


def elf_sections(data):
    if data[:6] != b"\x7fELF\x01\x01":
        raise ValueError("expected little-endian ELF32")
    table = struct.unpack_from("<I", data, 32)[0]
    stride, count, names_index = struct.unpack_from("<HHH", data, 46)
    if stride != 40 or not count or names_index >= count:
        raise ValueError("unsupported ELF32 section table")
    entries = [struct.unpack_from("<10I", data, table + index * stride) for index in range(count)]
    name_table = entries[names_index]
    names = data[name_table[4]:name_table[4] + name_table[5]]
    return [(names[entry[0]:].split(b"\0", 1)[0].decode("ascii"), entry[2], entry[5]) for entry in entries]


if __name__ == "__main__":
    try:
        if len(sys.argv) != 2:
            raise ValueError("usage: check-cache-internal-object OBJECT.o")
        validate_sections(elf_sections(Path(sys.argv[1]).read_bytes()))
    except (ValueError, OSError, struct.error) as error:
        sys.exit(str(error))
    print("PASS: allocated closure uses only IRAM code and DRAM data sections (not final linker/hardware proof)")
