#!/usr/bin/env bash
set -euo pipefail
# Run in the compiler's pinned Nix shell. No device access or firmware writes.
idf_root=${1:?usage: bash tools/check-touch-pad-registers PINNED_IDF_ROOT}
if [[ $# != 1 ]]; then exit 2; fi
idf_root=$(cd -- "$idf_root" && pwd)
project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
compiler_root=${ABLA_COMPILER_ROOT:-$project_root/../ablac}
export ABLA_SYSROOT="$compiler_root"
cd -- "$project_root"
mkdir -p build/tests
artifact=build/tests/touch-pad-register-oracle
"$compiler_root/build/ablac" build tests/touch-pad-register-oracle.ab -o "$artifact.o" --target-triple x86_64-unknown-linux-gnu --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -relocation-model=pic "$artifact.bc" -o "$artifact.opt.o"
cc -shared "$artifact.opt.o" -o "$artifact.so"
python3 tools/check-touch-pad-register-oracle.py "$artifact.so" "$idf_root"
