#!/usr/bin/env bash
set -euo pipefail
# Run in the compiler's pinned Nix shell. No device access or firmware writes.
idf_root=${1:?usage: bash tools/check-touch-pad-registers PINNED_IDF_ROOT}
if [[ $# != 1 ]]; then exit 2; fi
idf_root=$(cd -- "$idf_root" && pwd)
project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd -- "$project_root"
# The oracle imports the production planning functions and runs them on the host.
tools/abla-tool check-touch-pad-register-oracle "$idf_root"
