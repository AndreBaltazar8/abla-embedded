// Original ABI symbol: callee
trusted fun esp32RecoveredCallee(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32
): u32 {
    var r2 = a2
    var r3 = a3
    var incomingStack0 = stack0
    r2 = r2 + r3 + incomingStack0
    return r2
}

// Original ABI symbol: rawf
@naked
trusted fun esp32RecoveredRawf(): void = $xtensa instructions {
entry a1, 32
retw.n
}

// Original ABI symbol: caller
trusted fun esp32RecoveredCaller(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32
): u32 {
    var r2 = a2
    var r8 = u32(0)
    var r10 = u32(0)
    var r11 = u32(0)
    var r12 = u32(0)
    var r1 = u32(0)
    r8 = u32(1610625024)
    r10 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int((r8 + u32(4))))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(r1)), int(r2))
    r10 = esp32RecoveredCallee(r10, r11, r12, u32(0), u32(0), u32(0), stack0, stack1)
    r10 = esp32RecoveredRawf(r10, r11)
    r3 = u32(nativeFunctionAddress(esp32RecoveredRawf)) + u32(24)
    r4 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int((r2 << u32(2))))))
    return u32(ablaUnsafeCallI32I32(int(r4), int(r10)))
}
