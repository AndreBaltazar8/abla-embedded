#!/usr/bin/env bash
set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
ledger=$project_root/esp32-opaque-radio-parity.tsv

awk -F '\t' '
    /^#/ { next }
    NF != 6 { print "invalid parity row " NR > "/dev/stderr"; failed = 1; next }
    $1 !~ /^lib[A-Za-z0-9+_.-]+\.a$/ {
        print "unexpected opaque archive on row " NR > "/dev/stderr"; failed = 1
    }
    $5 != "not-started" && $5 != "partial" && $5 != "complete" {
        print "invalid parity status on row " NR > "/dev/stderr"; failed = 1
    }
    $5 == "complete" && $6 == "-" {
        print "complete row lacks evidence on row " NR > "/dev/stderr"; failed = 1
    }
    seen[$1 SUBSEP $2]++ { print "duplicate parity row " NR > "/dev/stderr"; failed = 1 }
    { rows++; bytes += $3; status[$5]++ }
    END {
        if (rows != 642) {
            print "expected 642 baseline opaque objects, found " rows > "/dev/stderr"
            failed = 1
        }
        if (bytes != 1533440) {
            print "expected 1533440 baseline opaque bytes, found " bytes > "/dev/stderr"
            failed = 1
        }
        printf "ESP32 full opaque parity: %d baseline objects, %d baseline bytes; %d complete, %d partial, %d not started\n", rows, bytes, status["complete"] + 0, status["partial"] + 0, status["not-started"] + 0
        exit failed
    }
' "$ledger"

if [[ -n ${ESP32_LINK_MAP:-} ]]; then
    [[ -f $ESP32_LINK_MAP ]] || {
        printf 'ESP32_LINK_MAP does not exist: %s\n' "$ESP32_LINK_MAP" >&2
        exit 1
    }
    while IFS= read -r member; do
        archive=${member%%:*}
        object=${member#*:}
        if ! awk -F '\t' -v archive="$archive" -v object="$object" \
            '$1 == archive && $2 == object { found = 1 } END { exit !found }' \
            "$ledger"; then
            printf 'opaque linked member missing from full-parity ledger: %s\n' \
                "$member" >&2
            exit 1
        fi
    done < <(sed -nE \
        's#^.*(lib[^ /()]+\.a)\(([^)]+\.o)\).*$#\1:\2#p' \
        "$ESP32_LINK_MAP" | sort -u)
fi
