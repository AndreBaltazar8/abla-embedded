#!/usr/bin/env python3
"""Replace exposed Xtensa zero-overhead loop markers with Abla while loops.

The recovered dispatcher models an Xtensa `loop` instruction with three
variables and a prologue that repeats the block range. Once an acyclic CFG is
structured, that hidden repetition appears as a marker triple followed by the
single visible iteration. This pass restores the exact count as an ordinary
Abla loop and removes the target-specific synthetic state.
"""

from __future__ import annotations

import argparse
from pathlib import Path
import re
import sys


MARKER = re.compile(
    r"^(?P<indent>[ ]*)loopCounter = (?P<count>[^\n]+)\n"
    r"(?P=indent)loopStart = (?P<start>[0-9]+)\n"
    r"(?P=indent)loopEnd = (?P<end>[0-9]+)\n"
    r"(?P=indent)if \((?P<condition>[^\n]+)\) \{\n",
    re.MULTILINE,
)


def transform(source: str) -> tuple[str, int]:
    replacements: list[tuple[int, int, str]] = []
    sequence = 0
    for match in MARKER.finditer(source):
        indent = match.group("indent")
        close = re.search(
            rf"^{re.escape(indent)}}}\n", source[match.end():], re.MULTILINE
        )
        if close is None:
            continue
        close_begin = match.end() + close.start()
        sequence += 1
        counter = f"recoveredHardwareLoopRemaining{sequence}"
        header = (
            f"{indent}var {counter} = {match.group('count')}\n"
            f"{indent}while ({'true' if match.group('condition') == 'true' else f'{counter} != u32(0)'}) {{\n"
        )
        decrement = (
            f"{indent}    {counter} = {counter} - u32(1)\n"
        )
        if match.group("condition") == "true":
            decrement += (
                f"{indent}    if ({counter} == u32(0)) break\n"
            )
        replacements.append((match.start(), match.end(), header))
        replacements.append((close_begin, close_begin, decrement))

    transformed = source
    for begin, end, replacement in sorted(replacements, reverse=True):
        transformed = transformed[:begin] + replacement + transformed[end:]
    return transformed, sequence


def input_files(paths: list[Path]) -> list[Path]:
    files: list[Path] = []
    for path in paths:
        if path.is_dir():
            files.extend(sorted(path.rglob("*.ab")))
        elif path.suffix == ".ab":
            files.append(path)
    return files


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="+", type=Path)
    parser.add_argument("--write", action="store_true")
    parser.add_argument("--verbose", action="store_true")
    arguments = parser.parse_args()

    changed_files = 0
    lowered_loops = 0
    for path in input_files(arguments.paths):
        source = path.read_text()
        transformed, lowered = transform(source)
        lowered_loops += lowered
        if transformed != source:
            changed_files += 1
            if arguments.verbose:
                print(f"{path}: {lowered}")
            if arguments.write:
                path.write_text(transformed)

    action = "lowered" if arguments.write else "would lower"
    print(
        f"{action} {lowered_loops} exposed hardware loop(s) "
        f"across {changed_files} file(s)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
