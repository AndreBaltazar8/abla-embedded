#!/usr/bin/env bash
# Pinned compiler Nix shell. Native models only, never opens a hardware port.
set -euo pipefail
cd "$(dirname "$0")/.."
export ABLA_SYSROOT="${ABLA_SYSROOT:-../ablac}"
mkdir -p build/tests
for fixture in adc2-register-s3 adc2-session-s3 adc2-pins-s3 adc2-arbiter-s3 adc2-config-s3 adc2-oneshot-s3 battery-adc-s3 adc1-register-s3 adc1-session-s3 adc-power-s3 adc-analog-s3 adc-bus-s3 adc-curve-s3 adc-calibration-s3 adc-fuse-s3 adc-trim-s3 adc1-oneshot-s3 adc1-config-s3 adc1-pins-s3 adc-calibration adc-two-point adc-fuse adc1-oneshot adc1-config adc1-pins sar-power adc1-session battery-adc-esp32; do
    case "$fixture" in
        adc2-register-s3) entry=abla_adc2_register_s3_test ;;
        adc2-session-s3) entry=abla_adc2_session_s3_test ;;
        adc2-pins-s3) entry=abla_adc2_pins_s3_test ;;
        adc2-arbiter-s3) entry=abla_adc2_arbiter_s3_test ;;
        adc2-config-s3) entry=abla_adc2_config_s3_test ;;
        adc2-oneshot-s3) entry=abla_adc2_oneshot_s3_test ;;
        battery-adc-s3) entry=abla_battery_adc_s3_test ;;
        adc1-register-s3) entry=abla_adc1_register_s3_test ;;
        adc1-session-s3) entry=abla_adc1_session_s3_test ;;
        adc-power-s3) entry=abla_adc_power_s3_test ;;
        adc-analog-s3) entry=abla_adc_analog_s3_test ;;
        adc-bus-s3) entry=abla_adc_bus_s3_test ;;
        adc-curve-s3) entry=abla_adc_curve_s3_test ;;
        adc-calibration-s3) entry=abla_adc_calibration_s3_test ;;
        adc-fuse-s3) entry=abla_adc_fuse_s3_test ;;
        adc-trim-s3) entry=abla_adc_trim_s3_test ;;
        adc1-oneshot-s3) entry=abla_adc1_oneshot_s3_test ;;
        adc1-config-s3) entry=abla_adc1_config_s3_test ;;
        adc1-pins-s3) entry=abla_adc1_pins_s3_test ;;
        adc-calibration) entry=abla_adc_calibration_test ;;
        adc-two-point) entry=abla_adc_two_point_test ;;
        adc-fuse) entry=abla_adc_fuse_test ;;
        adc1-oneshot) entry=abla_adc1_oneshot_test ;;
        adc1-config) entry=abla_adc1_config_test ;;
        adc1-pins) entry=abla_adc1_pins_test ;;
        sar-power) entry=abla_sar_power_test ;;
        adc1-session) entry=abla_adc1_session_test ;;
        battery-adc-esp32) entry=abla_battery_adc_esp32_test ;;
    esac
    artifact="build/tests/$fixture-native"
    ../ablac/build/ablac build "tests/$fixture-native.ab" -o "$artifact.o" \
        --target-triple x86_64-unknown-linux-gnu --object-format elf --emit object
    bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
    llc -filetype=obj -O2 -relocation-model=static "$artifact.bc" -o "$artifact.opt.o"
    cc -no-pie "-Wl,--defsym,main=$entry" "$artifact.opt.o" -o "$artifact"
    "$artifact"
    echo "PASS $fixture (native model, not hardware proof)"
done
