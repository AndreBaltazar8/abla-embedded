#!/usr/bin/env bash
# Run inside the compiler's pinned Nix shell. No device or application build.
set -euo pipefail
cd "$(dirname "$0")/.."
export ABLA_SYSROOT="${ABLA_SYSROOT:-../ablac}"
mkdir -p build/tests
artifact=build/tests/p4-irq-closure
../ablac/build/ablac build tests/esp32p4-irq-closure-target.ab -o "$artifact.o" \
    --target-triple riscv32-unknown-none-elf --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -mtriple=riscv32-unknown-none-elf -mattr=+m,+a,+zicsr "$artifact.bc" -o "$artifact.opt.o"
test -z "$(nm -u "$artifact.opt.o")"
test "$(nm -g --defined-only "$artifact.opt.o" | awk '{print $3}')" = abla_p4_irq_closure_target
ld.lld -m elf32lriscv --no-undefined -T tests/p4-irq-closure.ld \
    -Map="$artifact.map" -o "$artifact.elf" "$artifact.opt.o"
test -z "$(nm -u "$artifact.elf")"
python3 tools/check-cache-internal-object "$artifact.elf"
llvm-objdump -dr "$artifact.elf" > "$artifact.dis"
llvm-size "$artifact.elf"
echo 'PASS P4 linked IRQ closure in internal SRAM; NOT bootable/flashable or physical validation'
