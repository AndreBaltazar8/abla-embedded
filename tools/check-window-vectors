#!/usr/bin/env python3
"""Validate S3 window vector offsets and simulate emitted spill/fill opcodes.

Hardware window rotation/exception entry still needs device verification.
"""
import struct
import sys
from pathlib import Path


def check(data):
    if data[:6] != b'\x7fELF\x01\x01':
        raise ValueError('expected little-endian ELF32')
    table = struct.unpack_from('<I', data, 32)[0]
    stride, count, names_index = struct.unpack_from('<HHH', data, 46)
    if stride != 40 or names_index >= count:
        raise ValueError('invalid ELF sections')
    entries = [struct.unpack_from('<10I', data, table+i*40) for i in range(count)]
    names_header = entries[names_index]
    names = data[names_header[4]:names_header[4]+names_header[5]]
    matches = [s for s in entries if names[s[0]:].split(b'\0', 1)[0] == b'.iram1.abla.s3WindowVectors']
    assert len(matches) == 1 and matches[0][5] == 384, 'window region must be exactly384bytes'
    section = matches[0]
    code = data[section[4]:section[4]+section[5]]
    # S3 PS.OWB is bits8..11. Fixed alloca branches target40/c0/140.
    expected_alloca = bytes.fromhex('004803 f08040 20e603 203834 403330 40d103 803311 302230 20e613 102000 f774ce f08040 e77848 f08040 863000')
    assert code[0x50:0x7d] == expected_alloca, 'MOVSP recovery differs'
    for n, start in ((4, 0), (8, 0x80), (12, 0x100)):
        for seed in range(64):
            regs = [0x10000+seed*64+i for i in range(16)]
            regs[1] = 0x2000
            regs[n+1] = 0x3000
            original = regs[:]
            memory = {0x2000-12: 0x4000}
            written = set()
            def execute(offset, return_opcode):
                pc = offset
                while pc < offset+64:
                    instruction = code[pc:pc+3]
                    pc += 3
                    if instruction == return_opcode:
                        return
                    a, b, op = instruction
                    assert a & 15 == 0 and op in (9, 73), 'unexpected window opcode/prologue'
                    register, base = a >> 4, b & 15
                    # L32E/S32E use a negative-only offset: encoded 0..15
                    # means -64..-4, not a signed four-bit immediate.
                    displacement = (b >> 4) - 16
                    address = regs[base]+displacement*4
                    if op == 73:
                        memory[address] = regs[register]
                        written.add(address)
                    else:
                        regs[register] = memory[address]
                raise AssertionError('window return missing in64byte slot')
            execute(start, bytes.fromhex('003400'))
            expected = {0x3000-16+i*4 for i in range(4)} | {0x4000-n*4+i*4 for i in range(n-4)}
            assert written == expected and regs[n:] == original[n:], 'overflow clobbers caller or wrong frame'
            for i in range(n):
                regs[i] = 0xdead0000+i
            execute(start+64, bytes.fromhex('003500'))
            assert regs == original, 'underflow failed register roundtrip'
    return True


if __name__ == '__main__':
    try:
        check(Path(sys.argv[1]).read_bytes())
    except (AssertionError, ValueError, OSError, IndexError, KeyError, struct.error) as error:
        sys.exit(str(error))
    print('PASS: six window slots, MOVSP bytes,192 emitted-opcode frame roundtrips (not hardware proof)')
