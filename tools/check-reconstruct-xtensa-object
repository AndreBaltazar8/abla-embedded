#!/usr/bin/env python3
"""Regression checks for source-level Xtensa reconstruction helpers."""

from pathlib import Path
import runpy


tool = Path(__file__).with_name("reconstruct-xtensa-object")
helpers = runpy.run_path(tool)
normalize = helpers["normalize_xtensa_assembler_immediate"]

cases = {
    "addmi\ta11, a7, 0xffff8000": "addmi\ta11, a7, -32768",
    "addmi\ta11, a7, 0xfffffe00": "addmi\ta11, a7, -512",
    "addmi\ta4, a4, 0x200": "addmi\ta4, a4, 0x200",
    "movi\ta4, 0xffff8000": "movi\ta4, 0xffff8000",
}

for source, expected in cases.items():
    actual = normalize(source)
    if actual != expected:
        raise SystemExit(
            f"immediate normalization mismatch: {source!r} -> {actual!r}, "
            f"expected {expected!r}"
        )

_, data_directives = helpers["recovered_data_prefix"](
    "movi a2, root",
    [],
    ["root"],
    [],
    {
        ".data.root": b"\0\0\0\0",
        ".rodata.str1.1": b"abc\0",
    },
    {
        ".data.root": {0: ("32", ".rodata.str1.1")},
    },
    {
        ".data.root": (4, 2),
        ".rodata.str1.1": (4, 0),
    },
    {
        "root": (".data.root", 4),
    },
    {},
)
if not any(line.startswith(".pushsection .rodata.str1.1,")
           for line in data_directives):
    raise SystemExit("data-to-data section dependency was not reconstructed")

print(f"Xtensa reconstruction helper checks: {len(cases) + 1} passed")
