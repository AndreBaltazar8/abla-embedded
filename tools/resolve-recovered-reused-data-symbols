#!/usr/bin/env python3
"""Bind section-local data references to labels in a recovered companion source."""

from __future__ import annotations

import pathlib
import re
import sys


BLOCK = re.compile(
    r"\.pushsection\s+((?:[^,\\\s]|\\\$\\\$)+).*?\\n"
    r"(?P<body>.*?)\.popsection(?:\\n|\")",
    re.DOTALL,
)
LABEL = re.compile(
    r"(?:^|\\n)([.$A-Za-z_][.$A-Za-z0-9_\\\$]*):\\n"
)


def main() -> int:
    if len(sys.argv) < 4 or "--" not in sys.argv[1:]:
        print(
            f"usage: {sys.argv[0]} OWNER.ab [...] -- TARGET.ab [...]",
            file=sys.stderr,
        )
        return 2
    separator = sys.argv.index("--")
    owners = [pathlib.Path(value) for value in sys.argv[1:separator]]
    targets = [pathlib.Path(value) for value in sys.argv[separator + 1:]]
    mappings: dict[str, str] = {}
    for path in owners:
        source = path.read_text()
        for block in BLOCK.finditer(source):
            label = LABEL.search(block.group("body"))
            if label is None:
                continue
            section = block.group(1)
            previous = mappings.get(section)
            if previous is not None and previous != label.group(1):
                raise ValueError(
                    f"conflicting recovered owner for {section}: "
                    f"{previous} and {label.group(1)}"
                )
            mappings[section] = label.group(1)
    if not mappings:
        raise ValueError("owner sources contain no recovered data sections")

    symbol_byte = r"A-Za-z0-9_.$\\"
    changed = 0
    for path in targets:
        source = path.read_text()
        result = source
        count = 0
        for section in sorted(mappings, key=len, reverse=True):
            pattern = re.compile(
                rf"(?<!\.pushsection )(?<![{symbol_byte}])"
                rf"{re.escape(section)}(?![{symbol_byte}])"
            )
            result, replacements = pattern.subn(
                lambda _: mappings[section], result
            )
            count += replacements
        if count:
            path.write_text(result)
            changed += count
            print(f"{path}: resolved {count} reused data reference(s)")
    print(f"resolved {changed} reused data reference(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
