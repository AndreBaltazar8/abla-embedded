#!/usr/bin/env bash
set -euo pipefail
project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
compiler_root=${ABLA_COMPILER_ROOT:-$project_root/../ablac}
compiler=${ABLA_COMPILER:-$compiler_root/build/ablac}
export ABLA_SYSROOT="$compiler_root"
cd "$project_root"
mkdir -p build/tests
artifact=build/tests/internal-data-assembly-regression
"$compiler" build tests/internal-data-assembly-target.ab -o "$artifact.o" \
    --target-triple x86_64-unknown-none --object-format elf --emit object
ld --gc-sections --no-undefined --entry=abla_internal_data_assembly_test \
    -o "$artifact.elf" "$artifact.o"
[[ -z $(nm -u "$artifact.elf") ]]
symbols=$(nm "$artifact.elf")
for name in storage bytes words tls; do
    rg -q " [brd] abla_assembly_$name$" <<< "$symbols"
done
if rg -q ' abla_unused_(storage|bytes|tls)$' <<< "$symbols"; then
    echo 'Unreferenced native storage was retained.' >&2
    exit 1
fi
# Section-word registries deliberately survive without a code reader; they
# may be consumed solely through linker-script section boundaries.
rg -q ' r abla_unused_words$' <<< "$symbols"
exports=$(nm -g --defined-only "$artifact.elf" | awk '$3 ~ /^abla_/ {print $3}')
[[ $exports == abla_internal_data_assembly_test ]]
echo 'PASS: four local assembly data definitions, no unresolved dependencies, ordinary unused data pruned, section registry preserved.'
