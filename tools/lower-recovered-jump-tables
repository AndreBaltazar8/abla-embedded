PHY_TABLE = (
    "esp32Data_Labla_recovered_phy_chip_v7_cal_data_rodata_91220204e0"
)

INITIALIZED = re.compile(
    r"(?ms)^val\s+(?P<storage>esp32Data_[A-Za-z0-9_]+Storage)\s*=\s*"
    r"nativeStaticAllocate\((?P<size>[0-9]+)\)\n"
    r"trusted\s+fun\s+(?P<initialize>esp32Data_[A-Za-z0-9_]+Initialize)"
    r"\(\):\s*int\s*\{\n(?P<body>.*?)^\}\n"
    r"val\s+(?P<initialized>esp32Data_[A-Za-z0-9_]+Initialized)\s*=.*?\n"
    r"val\s+(?P<value>esp32Data_[A-Za-z0-9_]+)\s*=[^\n]*\n?"
)
STORE = re.compile(
    r"ablaUnsafeStoreU32\([^\n]*Storage \+ (?P<offset>[0-9]+)\),\s*"
    r"int\((?P<expression>.*?)\)\)\s*$"
)
ADDRESS = re.compile(
    r"^\(?\$xtensa\s+address\s+\{\{?\s*(?P<symbol>[^{}\s]+)\s*\}\}?"
    r"(?:\s*\+\s*u32\((?P<addend>[0-9]+)\))?\)?$"
)


def load_lifter(tools: pathlib.Path):
    path = tools / "lift-xtensa-leaves-to-abla"
    loader = importlib.machinery.SourceFileLoader(
        "abla_jump_lifter", str(path)
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load Xtensa lifter")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def function_span(source: str, name: str) -> tuple[int, int]:
    match = re.search(rf"(?m)^trusted fun {re.escape(name)}\(", source)
    if match is None:
        raise ValueError(f"missing Abla function {name}")
    opening = source.find("{", match.end())
    depth = 0
    quoted = False
    escaped = False
    for index in range(opening, len(source)):
        character = source[index]
        if quoted:
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == '"':
                quoted = False
            continue
        if character == '"':
            quoted = True
        elif character == "{":
            depth += 1
        elif character == "}":
            depth -= 1
            if depth == 0:
                return match.start(), index + 1
    raise ValueError(f"unterminated Abla function {name}")


def table_entries(source: str, table: str) -> tuple[re.Match[str], list[tuple[str, int]]]:
    block = next((match for match in INITIALIZED.finditer(source)
                  if match.group("value") == table), None)
    if block is None:
        raise ValueError(f"missing recovered table {table}")
    entries: list[tuple[str, int]] = []
    for line in block.group("body").splitlines():
        store = STORE.search(line.strip())
        if store is None:
            continue
        address = ADDRESS.fullmatch(store.group("expression").strip())
        if address is None:
            raise ValueError(f"non-address entry in {table}: {line.strip()}")
        entries.append((address.group("symbol"), int(address.group("addend") or 0)))
    expected = int(block.group("size")) // 4
    if table != PHY_TABLE and len(entries) != expected:
        raise ValueError(f"{table}: recovered {len(entries)} of {expected} entries")
    return block, entries


def object_function_start(object_path: pathlib.Path, symbol: str) -> int:
    if symbol.startswith(".text."):
        return 0
    output = subprocess.check_output(
        ["nm", "--defined-only", str(object_path)], text=True
    )
    match = re.search(
        rf"(?m)^([0-9A-Fa-f]+)\s+[Tt]\s+{re.escape(symbol)}$", output
    )
    if match is None:
        raise ValueError(f"missing {symbol} in {object_path.name}")
    return int(match.group(1), 16)


def elf_section(object_path: pathlib.Path, wanted: str) -> bytes:
    elf = object_path.read_bytes()
    if elf[:6] != b"\x7fELF\x01\x01":
        raise ValueError(f"{object_path.name} is not little-endian ELF32")
    section_offset = struct.unpack_from("<I", elf, 32)[0]
    entry_size = struct.unpack_from("<H", elf, 46)[0]
    count = struct.unpack_from("<H", elf, 48)[0]
    names_index = struct.unpack_from("<H", elf, 50)[0]

    def header(index: int) -> tuple[int, int, int]:
        offset = section_offset + index * entry_size
        return (
            struct.unpack_from("<I", elf, offset)[0],
            struct.unpack_from("<I", elf, offset + 16)[0],
            struct.unpack_from("<I", elf, offset + 20)[0],
        )

    _, names_offset, names_size = header(names_index)
    names = elf[names_offset:names_offset + names_size]
    for index in range(count):
        name_offset, data_offset, data_size = header(index)
        end = names.find(b"\0", name_offset)
        if names[name_offset:end].decode() == wanted:
            return elf[data_offset:data_offset + data_size]
    raise ValueError(f"{object_path.name} has no {wanted} section")


def abla_bytes(value: bytes) -> str:
    chunks = [
        '"' + "".join(f"\\x{byte:02x}" for byte in value[offset:offset + 32]) + '"'
        for offset in range(0, len(value), 32)
    ]
    return "\n        ".join(
        chunk + (" +" if index + 1 < len(chunks) else "")
        for index, chunk in enumerate(chunks)
    )


def block_map(
    root: pathlib.Path,
    tools: pathlib.Path,
    lifter,
    objdump: str,
    object_path: pathlib.Path,
    dispatch: Dispatch,
    temporary: pathlib.Path,
) -> tuple[int, dict[int, int]]:
    raw = temporary / f"{dispatch.abi_function}.ab"
    subprocess.run([
        str(tools / "reconstruct-xtensa-object"),
        "--objdump", objdump,
        "--output", str(raw),
        "--namespace", "jump_table_map",
        str(object_path), dispatch.abi_function,
    ], check=True)
    recovered = raw.read_text()
    match = lifter.BLOCK.search(recovered)
    if match is None:
        raise ValueError(f"cannot parse reconstructed {dispatch.abi_function}")
    executable = lifter.NESTED_SECTION.sub("", match.group("body"))
    executable = lifter.normalize_encoded_instructions(executable)
    _, blocks, _ = lifter.control_flow_records(executable)
    start = object_function_start(object_path, dispatch.abi_function)
    safe = re.sub(r"[^A-Za-z0-9_]", "_", dispatch.abi_function)
    result = {start: 0}
    label = re.compile(rf"\.Labla_recovered_{re.escape(safe)}_([0-9A-Fa-f]+)")
    for index, block in enumerate(blocks):
        found = label.fullmatch(block.label)
        if found:
            result[int(found.group(1), 16)] = index
    return start, result


def target_offset(symbol: str, addend: int, function: str, start: int) -> int:
    local = re.fullmatch(
        rf"\.Labla_recovered_{re.escape(re.sub(r'[^A-Za-z0-9_]', '_', function))}_"
        r"([0-9A-Fa-f]+)", symbol
    )
    if local:
        return int(local.group(1), 16) + addend
    if symbol == function or symbol.endswith("_section_entry"):
        return start + addend
    if symbol.startswith("."):
        return addend
    raise ValueError(f"unsupported jump-table target {symbol}+{addend}")


def lower_dispatch(
    function: str, table: str, mapping: list[int], site_limit: int
) -> tuple[str, int]:
    lines = function.splitlines(keepends=True)
    output: list[str] = []
    index = 0
    replaced = 0
    while index < len(lines):
        assignment = None if (site_limit >= 0 and replaced >= site_limit) else re.fullmatch(
            rf"(?P<indent>\s*)(?P<base>r[0-9]+) = {re.escape(table)}\n?",
            lines[index],
        )
        if assignment is None or index + 3 >= len(lines):
            output.append(lines[index])
            index += 1
            continue
        shift = re.fullmatch(
            rf"{re.escape(assignment.group('indent'))}(?P<target>r[0-9]+) = "
            rf"\((?P<selector>r[0-9]+) << u32\(2\)\) \+ "
            rf"{assignment.group('base')}\n?",
            lines[index + 1],
        )
        if shift is None:
            output.append(lines[index])
            index += 1
            continue
        address_register = shift.group("target")
        load = re.fullmatch(
            rf"(?P<jump>r[0-9]+) = u32\(ablaUnsafeLoadU32\(.*"
            rf"int\({address_register}\).*\)\)\)",
            lines[index + 2].strip(),
        )
        if load is None:
            output.append(lines[index])
            index += 1
            continue
        jump_register = load.group("jump")
        call_index = index + 3
        while (call_index < min(len(lines), index + 11) and
               not lines[call_index].strip().startswith(
                   "return u32(ablaUnsafeCall"
               )):
            call_index += 1
        if (call_index >= min(len(lines), index + 11) or
                f"int({jump_register})" not in lines[call_index]):
            output.append(lines[index])
            index += 1
            continue
        indent = assignment.group("indent")
        output.extend(lines[index + 3:call_index])
        output.append(
            f"{indent}programCounter = when ({shift.group('selector')}) {{\n"
        )
        for selector, state in enumerate(mapping):
            output.append(f"{indent}    {selector} -> {state}\n")
        output.append(f"{indent}    else -> -1\n{indent}}}\n")
        index = call_index + 1
        replaced += 1
    return "".join(output), replaced


def lower_table_sites(
    function: str, table: str
) -> list[tuple[int, int, str, int]]:
    """Find computed jumps through `table` in one dispatcher function.

    Returns (jump line index, entry offset, selector register, shift line)
    for each `rB = TABLE [; rB = rB + u32(K)] ; rT = (rS << u32(2)) + rB ;
    rJ = load(rT) ; ... ; return u32(ablaUnsafeCall*(int(rJ), ...))`
    sequence, allowing unrelated statements in between (GCC schedules
    independent loads into the gap).
    """
    lines = function.splitlines(keepends=True)
    sites = []
    for index, line in enumerate(lines):
        base = re.fullmatch(
            rf"\s*(r[0-9]+) = (?:\({re.escape(table)} \+ u32\(([0-9]+)\)\)|{re.escape(table)})\n?",
            line,
        )
        if base is None:
            continue
        register, offset, entry_register, selector, target = (
            base.group(1), int(base.group(2) or 0), None, None, None
        )
        for look in range(index + 1, min(len(lines), index + 14)):
            text = lines[look].strip()
            add = re.fullmatch(rf"{register} = {register} \+ u32\(([0-9]+)\)", text)
            if add and entry_register is None:
                offset += int(add.group(1))
                continue
            shift = re.fullmatch(rf"(r[0-9]+) = \((r[0-9]+) << u32\(2\)\) \+ {register}", text)
            if shift and entry_register is None:
                entry_register, selector = shift.group(1), shift.group(2)
                shift_line = look
                continue
            if entry_register and target is None:
                load = re.fullmatch(rf"(r[0-9]+) = u32\(ablaUnsafeLoadU32\(.*\bint\({entry_register}\).*\)\)\)", text)
                if load:
                    target = load.group(1)
                    continue
            if target and text.startswith("return u32(ablaUnsafeCall") and f"(int({target})" in text:
                sites.append((look, offset, selector, shift_line))
                break
    return sites


def section_entry_offset(objdump: str, object_path: pathlib.Path, section: str) -> int:
    """Offset of the first `entry` in a section (after its literal pool)."""
    listing = subprocess.check_output(
        shlex.split(objdump) + ["-d", "-j", section, str(object_path)], text=True, errors="replace"
    )
    match = re.search(r"(?m)^\s*([0-9a-f]+):\s+\S+\s+entry\b", listing)
    return int(match.group(1), 16) if match else 0


def lower_function_table(source, abla_function, abi_function, table, entries,
                         source_path, object_path, objdump, tools, lifter, temporary):
    """Lower one function's computed jumps through `table` (see discover)."""
    dispatch = Dispatch(str(source_path), "", object_path.name,
                        abi_function, abla_function, table)
    begin, end = function_span(source, abla_function)
    function_text = source[begin:end]
    sites = lower_table_sites(function_text, table)
    if not sites:
        print(f"{abi_function}: table {table} has no recognized jump site")
        return source, 0
    try:
        start, states = block_map(source_path.parent, tools, lifter, objdump,
                                  object_path, dispatch, temporary)
    except (ValueError, subprocess.CalledProcessError) as error:
        print(f"{abi_function}: table {table} left as data ({error})")
        return source, 0
    lines = function_text.splitlines(keepends=True)
    replacements = 0
    for line_index, offset, selector, shift_line in sorted(sites, reverse=True):
        mapping = []
        # A table shared by several functions: this site's run starts
        # at its byte offset and lasts while entries target this
        # function.
        for symbol, addend in entries[offset // 4:]:
            # The reconstructed section-local helper starts at its `entry`;
            # addends against its member-local label are relative to that.
            if abi_function.startswith(".text.") and "_local_" + re.sub(r"[^A-Za-z0-9_]", "_", abi_function) in symbol:
                addend += section_entry_offset(objdump, object_path, abi_function)
            try:
                target = target_offset(symbol, addend, abi_function, start)
            except ValueError:
                break
            if target not in states:
                mapping = []
                break
            mapping.append(states[target])
        if not mapping:
            print(f"{abi_function}: table {table}+{offset} has unmapped targets")
            return source, 0
        indent = re.match(r"\s*", lines[line_index]).group(0)
        # The shift often overwrites the selector register (`r8 = (r8 << 2)
        # + base`); keep the index in its own value.
        index_name = f"jumpTableIndex{shift_line}"
        arms = "".join(f"{indent}    {value} -> {state}\n" for value, state in enumerate(mapping))
        lines[line_index] = (f"{indent}programCounter = when ({index_name}) {{\n{arms}"
                             f"{indent}    else -> -1\n{indent}}}\n")
        shift_indent = re.match(r"\s*", lines[shift_line]).group(0)
        lines[shift_line] = f"{shift_indent}val {index_name} = {selector}\n" + lines[shift_line]
        replacements += 1
        print(f"{abi_function} -> {len(mapping)}-arm Abla when (offset {offset})")
    if not replacements:
        return source, 0
    source = source[:begin] + "".join(lines) + source[end:]
    return source, replacements


def discover(
    source_path: pathlib.Path,
    object_path: pathlib.Path,
    objdump: str,
    tools: pathlib.Path,
    write: bool,
) -> int:
    """Find and lower every computed jump table of one recovered member.

    New chips have no hand-curated DISPATCHES list. A recovered rodata table
    whose entries are all code addresses inside the one function that indexes
    it is a switch table; its targets map to that function's lifted blocks
    exactly as for the curated classic entries. Run before structurizing,
    while functions are still program-counter dispatchers.
    """
    lifter = load_lifter(tools)
    reconstruct_loader = importlib.machinery.SourceFileLoader(
        "abla_jump_reconstruct", str(tools / "reconstruct-xtensa-object")
    )
    spec = importlib.util.spec_from_loader(reconstruct_loader.name, reconstruct_loader)
    reconstruct = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = reconstruct
    reconstruct_loader.exec_module(reconstruct)
    symbols = re.findall(
        r"(?m)^[0-9A-Fa-f]+\s+[Tt]\s+(\S+)$",
        subprocess.check_output(["nm", "--defined-only", str(object_path)], text=True),
    )
    abi_by_abla = {reconstruct.abla_function_name(symbol): symbol for symbol in symbols}
    # Section-local helpers without a symbol of their own (`.text.name`).
    sections = re.findall(
        r"(?m)^\s*\d+\s+(\.text\.\S+)\s",
        subprocess.check_output(["objdump", "-h", str(object_path)], text=True, errors="replace"),
    )
    for section in sections:
        abi_by_abla.setdefault(reconstruct.abla_function_name(section), section)
    source = source_path.read_text()
    lowered_count = 0
    # Tables still defined in assembly (their entries are code relocations):
    # `LABEL:` followed by `.long symbol+0xOFFSET` lines, indexed through
    # `$xtensa address {LABEL}`.
    assembly_tables = {
        match.group(1): [
            (entry.group(1), int(entry.group(2) or "0", 16))
            for entry in re.finditer(r"\.long\s+([^\s+]+)(?:\+0x([0-9a-fA-F]+))?", match.group(2))
        ]
        for match in re.finditer(r"(?m)^(\.L[\w.$]+):\n((?:\.long\s+[^\n]+\n)+)", source)
    }
    with tempfile.TemporaryDirectory(prefix=".abla-jump-map.", dir=source_path.parent) as name:
        temporary = pathlib.Path(name)
        candidates = [(block.group("value"), None) for block in INITIALIZED.finditer(source)]
        candidates += [(f"$xtensa address {{{label}}}", entries) for label, entries in assembly_tables.items()]
        for table, assembly_entries in candidates:
            if assembly_entries is None:
                try:
                    _, entries = table_entries(source, table)
                except ValueError:
                    continue
            else:
                entries = assembly_entries
            if not entries:
                continue
            users = [m.group(1) for m in re.finditer(r"(?m)^trusted fun (\w+)\(", source)
                     if re.search(rf"(?<![\w$]){re.escape(table)}(?![\w])",
                                  source[slice(*function_span(source, m.group(1)))])]
            for abla_function in users:
                if abla_function not in abi_by_abla:
                    continue
                source, replacements = lower_function_table(
                    source, abla_function, abi_by_abla[abla_function], table, entries,
                    source_path, object_path, objdump, tools, lifter, temporary,
                )
                lowered_count += replacements
    if write and lowered_count:
        source_path.write_text(source)
    print(f"{'lowered' if write else 'would lower'} {lowered_count} computed jumps")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--write", action="store_true")
    parser.add_argument("--archive-root", type=pathlib.Path)
    parser.add_argument("--objdump", required=True)
    parser.add_argument(
        "--discover", type=pathlib.Path, metavar="OBJECT",
        help="lower every table found in ROOT (one recovered .ab) against "
        "its original OBJECT instead of the curated classic list",
    )
    parser.add_argument("root", type=pathlib.Path)
    arguments = parser.parse_args()
    if arguments.discover:
        return discover(arguments.root.resolve(), arguments.discover.resolve(),
                        arguments.objdump, pathlib.Path(__file__).resolve().parent,
                        arguments.write)
    if arguments.archive_root is None:
        parser.error("--archive-root is required without --discover")
    root = arguments.root.resolve()
    tools = root / "tools"
    lifter = load_lifter(tools)
    changed: dict[pathlib.Path, str] = {}
    table_blocks: dict[tuple[pathlib.Path, str], re.Match[str]] = {}
    total_dispatches = 0

    with tempfile.TemporaryDirectory(prefix=".abla-jump-map.", dir=root) as name:
        temporary = pathlib.Path(name)
        objects: dict[tuple[str, str], pathlib.Path] = {}
        for dispatch in DISPATCHES:
            source_path = root / dispatch.source
            source = changed.get(source_path, source_path.read_text())
            if not re.search(rf"\b{re.escape(dispatch.table)}\b", source):
                print(
                    f"{dispatch.source}: {dispatch.abi_function} already lowered"
                )
                continue
            block, entries = table_entries(source, dispatch.table)
            table_blocks[(source_path, dispatch.table)] = block
            key = (dispatch.archive, dispatch.member)
            if key not in objects:
                object_path = temporary / dispatch.member
                object_path.write_bytes(subprocess.check_output([
                    "ar", "p", str(arguments.archive_root / dispatch.archive),
                    dispatch.member,
                ]))
                objects[key] = object_path
            start, states = block_map(
                root, tools, lifter, arguments.objdump, objects[key],
                dispatch, temporary,
            )
            count = dispatch.entry_count
            selected = entries[dispatch.first_entry:]
            if count >= 0:
                selected = selected[:count]
            mapping = []
            for symbol, addend in selected:
                target = target_offset(
                    symbol, addend, dispatch.abi_function, start
                )
                if target not in states:
                    raise ValueError(
                        f"{dispatch.abi_function}: no Abla state for "
                        f"{symbol}+{addend} (0x{target:x})"
                    )
                mapping.append(states[target])
            begin, end = function_span(source, dispatch.abla_function)
            lowered, replacements = lower_dispatch(
                source[begin:end], dispatch.table, mapping,
                dispatch.site_limit,
            )
            if replacements == 0:
                raise ValueError(
                    f"{dispatch.abla_function}: no computed jump using "
                    f"{dispatch.table}"
                )
            changed[source_path] = source[:begin] + lowered + source[end:]
            total_dispatches += replacements
            print(
                f"{dispatch.source}: {dispatch.abi_function} -> "
                f"{len(mapping)}-arm Abla when ({replacements} site(s))"
            )
        phy_constant_tail = elf_section(
            objects[("esp_phy/lib/esp32/libphy.a", "phy_chip_v7_cal.o")],
            ".rodata",
        )[72:]

    phy_path = root / "src/esp32/radio/phy_chip_v7_cal_esp32.ab"
    phy_source = changed[phy_path]
    phy_block, _ = table_entries(phy_source, PHY_TABLE)
    phy_declaration = (
        "// Immutable calibration lookup data following the two lowered "
        "switch tables.\n"
        f"val {PHY_TABLE} = u32(nativeStaticBytes(\n"
        f"        {abla_bytes(phy_constant_tail)}\n"
        "))\n"
    )
    phy_source = (
        phy_source[:phy_block.start()] + phy_declaration +
        phy_source[phy_block.end():]
    )
    first = phy_source.find(f"r11 = {PHY_TABLE}")
    second = phy_source.find(f"r11 = {PHY_TABLE}", first + 1)
    if first < 0 or second < 0:
        raise ValueError("missing calibration constant-table users")
    insertion = second + len(f"r11 = {PHY_TABLE}")
    phy_source = phy_source[:insertion] + " + u32(20)" + phy_source[insertion:]
    changed[phy_path] = phy_source

    for (path, table), _ in table_blocks.items():
        if table == PHY_TABLE:
            continue
        source = changed[path]
        block, _ = table_entries(source, table)
        outside = source[:block.start()] + source[block.end():]
        if re.search(rf"\b{re.escape(table)}\b", outside):
            raise ValueError(f"{table} remains in use after dispatch lowering")
        changed[path] = outside

    action = "lowered" if arguments.write else "would lower"
    print(f"{action} {total_dispatches} computed jumps in {len(changed)} files")
    if arguments.write:
        for path, source in changed.items():
            path.write_text(source)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
