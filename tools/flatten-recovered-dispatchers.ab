// Flatten generated program-counter if ladders into Abla when expressions.
//
//     tools/abla-tool flatten-recovered-dispatchers [--write] PATH...

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/bytes"
import "abla/process/arguments"
import "lib/recfiles.ab"

class FlattenResult(val text: string, val dispatchers: int, val arms: int, val error: string)

fun flattenIndent(text: string): int {
    var end = 0
    while (end < text.size && recIsSpace(text[end])) end = end + 1
    end
}

// The arm number of `<indent><head><digits>) {` or "" (the text must end exactly there).
fun flattenArm(text: string, indent: int, head: string): string {
    if (!text.slice(indent, text.size).startsWith(head)) return ""
    val begin = indent + head.size
    var end = begin
    while (end < text.size && recIsDigit(text[end])) end = end + 1
    if (end == begin) return ""
    if (text.slice(end, text.size) != ") {") return ""
    text.slice(begin, end)
}

fun flattenDispatchers(source: string, path: string): FlattenResult {
    val out = byteBuffer()
    var active = false
    var activeIndent = ""
    var dispatchers = 0
    var arms = 0
    val lines = source.split("\n")
    var index = 0
    while (index < lines.size) {
        val text = lines[index]
        val last = index == lines.size - 1
        // A trailing empty piece after the last "\n" is not a line.
        if (last && text == "") break
        val newline = if (last) "" else "\n"
        index = index + 1
        val indent = flattenIndent(text)
        if (!active) {
            val arm = flattenArm(text, indent, "if (programCounter == ")
            if (arm == "") {
                out.appendText(text + newline)
                continue
            }
            activeIndent = text.slice(0, indent)
            active = true
            out.appendText(activeIndent + "when (programCounter) {" + newline)
            out.appendText(activeIndent + "    " + arm + " -> {" + newline)
            dispatchers = dispatchers + 1
            arms = arms + 1
            continue
        }
        val next = flattenArm(text, indent, "else if (programCounter == ")
        if (next != "" && text.slice(0, indent) == activeIndent) {
            out.appendText(activeIndent + "    " + next + " -> {" + newline)
            arms = arms + 1
            continue
        }
        if (text == activeIndent + "else ablaRuntimeTrap()") {
            out.appendText(activeIndent + "    else -> ablaRuntimeTrap()" + newline)
            out.appendText(activeIndent + "}" + newline)
            active = false
            continue
        }
        out.appendText(text + newline)
    }
    if (active) return FlattenResult("", 0, 0, "$path: unterminated recovered dispatcher")
    FlattenResult(out.toText(), dispatchers, arms, "")
}

fun main: int {
    var write = false
    val paths: array<string> = []
    var index = 0
    while (index < processArgumentCount()) {
        val argument = processArgument(index)
        index = index + 1
        if (argument == "--write") write = true
        else if (argument.startsWith("-") && argument != "-") {
            eprintln("flatten-recovered-dispatchers: unrecognized arguments: $argument")
            return 2
        } else paths.append(recNormalizePath(argument))
    }
    if (paths.size == 0) {
        eprintln("usage: flatten-recovered-dispatchers [--write] paths [paths ...]")
        return 2
    }
    var totalDispatchers = 0
    var totalArms = 0
    var changed = 0
    for (path in recInputFiles(paths)) {
        val read = recRead(path)
        if (!read.ok) {
            eprintln("cannot read $path")
            return 1
        }
        val result = flattenDispatchers(read.text, path)
        if (result.error != "") {
            eprintln(result.error)
            return 1
        }
        totalDispatchers = totalDispatchers + result.dispatchers
        totalArms = totalArms + result.arms
        if (result.text != read.text) {
            changed = changed + 1
            if (write) Path(path).writeText(result.text)
        }
    }
    val action = if (write) "rewrote" else "would rewrite"
    println("$action $changed file(s), $totalDispatchers dispatcher(s), $totalArms arm(s)")
    if (!write && changed > 0) return 1
    0
}
