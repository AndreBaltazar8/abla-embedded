#!/usr/bin/env python3
"""Recover one Espressif archive member to Abla for a chip profile.

  tools/recover-member esp32s3 libnet80211 ieee80211_action_vendor.o

The chip profile (tools/recovery/<chip>.toml) names the objdump, the ESP-IDF
archives, the ROM linker scripts and, for a new chip, the already recovered
reference chip. The driver:

1. extracts the member into build/recovery/<chip>/<archive>/<member>/;
2. classifies every function: `rom` (the chip's ROM provides it), the
   compare-xtensa-archives classes against the reference chip (`identical`,
   `reordered`, `layout`, `different`, `new`), and where the reference's
   recovered Abla lives under src/; identical/reordered functions with Abla
   are reusable as is;
3. reconstructs the member (reconstruct-xtensa-object) and runs the lifting
   passes (migrate, lift leaves, lower boundaries, structurize) until a round
   changes nothing;
4. writes reuse.tsv and status.tsv and prints a summary.

The output is a starting point for review, not a finished module: later
passes (direct calls, data lowering, jump tables) still run per corpus.
"""

from __future__ import annotations

import argparse
import collections
import hashlib
import importlib.machinery
import importlib.util
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
TOOLS = ROOT / "tools"
PASSES = (
    ["migrate-xtensa-recovered-blocks"],
    ["lift-xtensa-leaves-to-abla", "--write"],
    ["lower-xtensa-boundaries-to-abla", "--write"],
    ["structurize-acyclic-recovered-functions", "--write"],
)
REUSABLE = {"identical", "reordered"}
PROVIDE = re.compile(r"PROVIDE\s*\(\s*([A-Za-z_]\w*)\s*=")
SYMBOL = re.compile(r"^[0-9a-f]+ (.{7}) (\S+)\s+[0-9a-f]+ (\S+)$")
SELECTOR = re.compile(r'(?:internal|export)Function\("(\w+)",\s*"([^"]+)"\)')
ABLA_FUNCTION = re.compile(r"^(?:@\w+(?:\([^)]*\))?\s*)*trusted fun (\w+)\(")


def load_tool(name: str):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(TOOLS / name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def load_profile(chip: str) -> dict:
    path = TOOLS / "recovery" / f"{chip}.toml"
    if not path.exists():
        sys.exit(f"recover-member: no profile {path.relative_to(ROOT)}")
    profile = tomllib.loads(path.read_text())
    idf = pathlib.Path(os.path.expanduser(profile["idf"]))
    profile["objdump"] = os.path.expanduser(profile["objdump"])
    profile["archives"] = {k: idf / v for k, v in profile["archives"].items()}
    profile["rom_linker_scripts"] = [idf / p for p in profile.get("rom_linker_scripts", [])]
    return profile


def objdump_command(profile: dict) -> list[str]:
    # Espressif's prebuilt binaries need an FHS environment on NixOS.
    runner = ["steam-run"] if shutil.which("steam-run") and os.environ.get("ABLA_NO_STEAM_RUN") != "1" else []
    return runner + [profile["objdump"]]


def extract(archive: pathlib.Path, member: str, directory: pathlib.Path) -> pathlib.Path | None:
    directory.mkdir(parents=True, exist_ok=True)
    listing = subprocess.run(["ar", "t", str(archive)], capture_output=True, text=True, check=True).stdout.split()
    if member not in listing:
        return None
    subprocess.run(["ar", "x", str(archive), member], cwd=directory, check=True)
    return directory / member


def rom_symbols(profile: dict) -> set[str]:
    names: set[str] = set()
    for script in profile["rom_linker_scripts"]:
        names.update(PROVIDE.findall(script.read_text()))
    return names


def object_functions(objdump: list[str], obj: pathlib.Path) -> dict[str, bool]:
    """Executable function symbols mapped to whether they are global."""
    out: dict[str, bool] = {}
    text = subprocess.run(objdump + ["-t", str(obj)], capture_output=True, text=True, check=True).stdout
    for line in text.splitlines():
        m = SYMBOL.match(line.replace("\t", " "))
        if m and "F" in m.group(1):
            out[m.group(3)] = "g" in m.group(1)
    return out


def recovered_abla_index() -> dict[str, str]:
    """ABI symbol -> path:line of the reference chip's recovered Abla.

    Link selectors (`internalFunction("abla", "symbol")`) name the Abla
    function that owns each ABI symbol; hand-renamed modules are found too.
    """
    owners: dict[str, str] = {}
    definitions: dict[str, str] = {}
    for path in sorted((ROOT / "src").rglob("*.ab")):
        for number, line in enumerate(path.read_text(errors="replace").splitlines(), 1):
            for abla, symbol in SELECTOR.findall(line):
                owners.setdefault(symbol, abla)
            m = ABLA_FUNCTION.match(line.strip())
            if m:
                definitions.setdefault(m.group(1), f"{path.relative_to(ROOT)}:{number}")
    return {symbol: definitions[abla] for symbol, abla in owners.items() if abla in definitions}


def classify(compare, reference: dict[str, list[str]] | None, ours: dict[str, list[str]], name: str) -> str:
    if reference is None or name not in reference:
        return "new"
    a, b = reference[name], ours.get(name)
    if b is None:
        return "new"
    if a == b:
        return "identical"
    if collections.Counter(a) == collections.Counter(b):
        return "reordered"
    if compare.coarse(a) == compare.coarse(b):
        return "layout"
    return "different"


def digest(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def lift(source: pathlib.Path, rounds: int, log: pathlib.Path) -> int:
    with log.open("w") as out:
        for number in range(1, rounds + 1):
            before = digest(source)
            for command in PASSES:
                out.write(f"== round {number}: {' '.join(command)}\n")
                out.flush()
                result = subprocess.run([sys.executable, "-I", str(TOOLS / command[0]), *command[1:], str(source)],
                                        stdout=out, stderr=subprocess.STDOUT, cwd=source.parent)
                if result.returncode != 0:
                    out.write(f"(exit {result.returncode})\n")
            if digest(source) == before:
                return number
    return rounds


def lifted_status(source: pathlib.Path) -> dict[str, str]:
    """Abla function name -> `lifted` or `naked` (still raw instructions)."""
    status: dict[str, str] = {}
    for line in source.read_text().splitlines():
        m = ABLA_FUNCTION.match(line.strip())
        if m:
            status[m.group(1)] = "naked" if "$xtensa instructions" in line else "lifted"
    return status


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("chip")
    parser.add_argument("archive", help="archive key from the profile, e.g. libnet80211")
    parser.add_argument("member", help="object file inside the archive, e.g. wl_chm.o")
    parser.add_argument("--work", type=pathlib.Path, help="work directory (default build/recovery/...)")
    parser.add_argument("--namespace", help="assembler-local namespace (default from the member name)")
    parser.add_argument("--rounds", type=int, default=6, help="maximum lifting rounds")
    parser.add_argument("--classify-only", action="store_true", help="stop after reuse.tsv")
    args = parser.parse_args()

    profile = load_profile(args.chip)
    if args.archive not in profile["archives"]:
        sys.exit(f"recover-member: {args.chip} has no archive {args.archive}; "
                 f"known: {', '.join(sorted(profile['archives']))}")
    stem = args.member.removesuffix(".o")
    work = args.work or ROOT / "build" / "recovery" / args.chip / args.archive / stem
    if work.exists():
        shutil.rmtree(work)
    objdump = objdump_command(profile)
    obj = extract(profile["archives"][args.archive], args.member, work / "object")
    if obj is None:
        sys.exit(f"recover-member: {args.member} is not in {profile['archives'][args.archive]}")

    compare = load_tool("compare-xtensa-archives")
    ours = compare.functions(objdump, obj)
    symbols = object_functions(objdump, obj)
    reference = None
    if "reference" in profile:
        reference_profile = load_profile(profile["reference"])
        reference_archive = reference_profile["archives"].get(args.archive)
        reference_obj = reference_archive and extract(reference_archive, args.member, work / "reference")
        if reference_obj:
            reference = compare.functions(objdump_command(reference_profile), reference_obj)
    rom = rom_symbols(profile)
    reconstruct = load_tool("reconstruct-xtensa-object")
    index = recovered_abla_index() if reference is not None else {}

    rows = []
    for name in sorted(symbols):
        kind = "rom" if name in rom else classify(compare, reference, ours, name)
        abla = reconstruct.abla_function_name(name)
        location = index.get(name, "") if kind != "rom" else ""
        rows.append((name, "global" if symbols[name] else "local", kind, abla, location))
    with (work / "reuse.tsv").open("w") as out:
        out.write("symbol\tbinding\tclass\tabla\treference_abla\n")
        for row in rows:
            out.write("\t".join(row) + "\n")
    counts = collections.Counter(kind for _, _, kind, _, _ in rows)
    reusable = [row for row in rows if row[2] in REUSABLE and row[4]]
    print(f"{args.chip} {args.archive}/{args.member}: {len(rows)} functions, "
          + ", ".join(f"{k}={counts[k]}" for k in sorted(counts))
          + f"; reusable with existing Abla: {len(reusable)}")
    if args.classify_only:
        print(f"wrote {(work / 'reuse.tsv').relative_to(ROOT)}")
        return 0

    namespace = args.namespace or re.sub(r"[^A-Za-z0-9]", "", stem.title()) + args.chip.capitalize()
    recovered = work / "recovered.ab"
    command = [sys.executable, "-I", str(TOOLS / "reconstruct-xtensa-object"), str(obj),
               *(name for name, binding, kind, _, _ in rows if binding == "global" and kind != "rom"),
               "--objdump", " ".join(objdump), "--namespace", namespace, "--output", str(recovered)]
    for name, binding, kind, _, _ in rows:
        if binding == "local":
            command += ["--local-function", name]
    result = subprocess.run(command, capture_output=True, text=True)
    (work / "reconstruct.log").write_text(result.stdout + result.stderr)
    if result.returncode != 0:
        print(f"reconstruct-xtensa-object failed; see {(work / 'reconstruct.log').relative_to(ROOT)}")
        return 1
    lifted = work / "lifted.ab"
    shutil.copyfile(recovered, lifted)
    used = lift(lifted, args.rounds, work / "lift.log")

    status = lifted_status(lifted)
    by_abla = {row[3]: row for row in rows}
    with (work / "status.tsv").open("w") as out:
        out.write("abla\tsymbol\tclass\tstatus\n")
        for abla, state in sorted(status.items()):
            row = by_abla.get(abla)
            out.write(f"{abla}\t{row[0] if row else ''}\t{row[2] if row else ''}\t{state}\n")
    done = sum(state == "lifted" for state in status.values())
    print(f"lifted {done} of {len(status)} functions in {used} round(s); "
          f"output {lifted.relative_to(ROOT)}")
    naked = [abla for abla, state in sorted(status.items()) if state == "naked"]
    if naked:
        print("still raw Xtensa: " + ", ".join(naked))
    return 0


if __name__ == "__main__":
    sys.exit(main())
