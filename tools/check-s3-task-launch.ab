// Validate linked first-task transfer ABI and destination, not hardware execution.
//
//     tools/abla-tool check-s3-task-launch LINKED.elf

import "abla/io"
import "abla/text"
import "abla/process/arguments"
import "lib/xtensa-check.ab"
import "./lib/elf.ab"

fun checkTaskLaunch(data: string): string {
    val elf = elf32Parse(data)
    if (elf.error != "" || elf.kind != 2) return "expected linked ELF32"
    val launch = elfSectionFunction(elf, ".iram1.abla.s3FirstTask")
    if (launch.error != "") return launch.error
    val returns = elfSectionFunction(elf, ".iram1.abla.s3ContextReturns")
    if (returns.error != "") return returns.error
    val pc = launch.address
    val c = launch.code
    if (c.size != 54) return "first-task transfer must be 54 bytes"
    if (elfSlice(c, 0, 42) != xtensaInsns("004136 13d120 006f00 f00c 13e600 002010 000c 13e400 13e000 134800 002010 100c 134900 002010 03d110")) {
        return "first-task transfer instruction prefix differs"
    }
    val word = xtensaWord(c, 42)
    if ((word & 255) != 1) return "first-task transfer must load the PS literal with L32R"
    val literal = ((pc + 45) & ~3) + signExtend(word >> 8, 16) * 4
    val section = elf.sections[elfLastSection(elf, ".iram1.abla.s3FirstTask")]
    if (!(section.address <= literal && literal + 4 <= section.address + section.size)) {
        return "PS literal outside the first-task section"
    }
    if (elfU32(data, section.offset + literal - section.address) != 0x4003F) return "wrong PS literal"
    if (elfSlice(c, 45, 51) != xtensaInsns("13e600 002010")) return "first-task transfer PS write differs"
    val jump = xtensaWord(c, 51)
    if ((jump & 63) != 6 || pc + 55 + xtensaDisplacement18(jump) != returns.address) {
        return "first-task transfer does not jump to the return1 path"
    }
    ""
}

fun main: int {
    if (processArgumentCount() != 1) {
        eprintln("usage: check-s3-task-launch LINKED.elf")
        return 2
    }
    val file = readBinaryFile(processArgument(0))
    if (file.error != "") {
        eprintln(file.error)
        return 1
    }
    val error = checkTaskLaunch(file.data)
    if (error != "") {
        eprintln(error)
        return 1
    }
    println("PASS: windowed launch argument preserved across synchronized window reset; exact frame-SP/PS and linked return1 jump; not hardware proof")
    0
}
