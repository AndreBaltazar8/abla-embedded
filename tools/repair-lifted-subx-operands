#!/usr/bin/env python3
"""Repair the formerly reversed SUBX2/4/8 expressions in lifted Abla."""

from __future__ import annotations

import argparse
import pathlib
import re


PATTERN = re.compile(
    r"(?P<indent>^[ \t]*)(?P<dest>r(?:[0-9]|1[0-5])) = "
    r"(?P<subtrahend>r(?:[0-9]|1[0-5])) - "
    r"\((?P<scaled>r(?:[0-9]|1[0-5])) << u32\((?P<shift>[123])\)\)$",
    re.MULTILINE,
)


def repair(source: str) -> tuple[str, int]:
    def replace(match: re.Match[str]) -> str:
        return (
            f"{match['indent']}{match['dest']} = "
            f"({match['scaled']} << u32({match['shift']})) - "
            f"{match['subtrahend']}"
        )

    return PATTERN.subn(replace, source)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("root", type=pathlib.Path)
    parser.add_argument("--write", action="store_true")
    arguments = parser.parse_args()

    total = 0
    files = 0
    for path in sorted(arguments.root.rglob("*.ab")):
        source = path.read_text()
        repaired, count = repair(source)
        if count == 0:
            continue
        total += count
        files += 1
        if arguments.write:
            path.write_text(repaired)
        else:
            print(f"{path}: {count}")
    action = "repaired" if arguments.write else "would repair"
    print(f"{action} {total} SUBX expression(s) in {files} file(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
