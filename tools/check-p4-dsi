#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export ABLA_SYSROOT="${ABLA_SYSROOT:-../ablac}"
mkdir -p build/tests
for fixture in tab5_pwm ledc tab5_psram_video psram_memory psram_verify_range psram_range psram_startup cache_flush cache_autoload psram_cold_page cache_cold psram_page psram_verify psram_mmu psram_sweep psram_identity psram_command psram_mapped systimer_clock systimer watchdog uart_pins uart_clock serial board_session revision touch_scan worker irq_owner mailbox events fifo short long read ili9881c phy pll host clock ldo ldo_efuse ldo_pmu start reference_clock reference_owner bus panel timing timing_write dpi_clock rgb bridge_dma descriptor dma_channel dma_control cache publish dma_owner video rearm shutdown service tab5_video gpio i2c_lines i2c_transfer i2c_registers tab5_reset i2c_bus i2c_devices i2c_provider tab5_control tab5_detect tab5_close tab5_owner irq_route clic irq_entry; do
artifact=build/tests/esp32p4-dsi-$fixture
../ablac/build/ablac build "tests/esp32p4-dsi-$fixture-target.ab" -o "$artifact.o" --target-triple riscv32-unknown-none-elf --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -mtriple=riscv32-unknown-none-elf -mattr=+m,+a,+zicsr "$artifact.bc" -o "$artifact.opt.o"
test -z "$(nm -u "$artifact.opt.o")"
test "$(nm -g --defined-only "$artifact.opt.o" | awk '{print $3}')" = "abla_p4_dsi_${fixture}_target"
llvm-objdump -dr "$artifact.opt.o" > "$artifact.dis"
if [[ $fixture == psram_verify ]]; then
    test "$(rg -c '0ff0000f.*fence' "$artifact.dis")" = 4
    rg -q 'load volatile i32' "$artifact.o.ll"
    rg -q 'store volatile i32' "$artifact.o.ll"
    rg -q 'asm sideeffect "fence iorw, iorw", "~\{memory\}"' "$artifact.o.ll"
fi
if [[ $fixture == revision ]]; then
    test "$(rg -c '\blw\s' "$artifact.dis")" = 1
    if rg -q '\b(sb|sh|sw|amoswap|amoadd|sc\.w)\s' "$artifact.dis"; then
        echo 'FAIL revision probe must not write memory/MMIO' >&2
        exit 1
    fi
fi
if [[ $fixture == publish || $fixture == rearm ]]; then
    test "$(rg -c '0ff0000f.*fence' "$artifact.dis")" = 3
fi
echo "PASS P4 DSI $fixture target (compile only)"
done
