#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Run through the pinned compiler Nix shell, like other native host checks.
export ABLA_SYSROOT="${ABLA_SYSROOT:-../ablac}"
artifact=build/tests/touch-differential
mkdir -p build/tests
"$ABLA_SYSROOT/build/ablac" build tests/touch-differential.ab -o "$artifact.o" --target-triple x86_64-unknown-linux-gnu --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -relocation-model=static "$artifact.bc" -o "$artifact.opt.o"
c++ -std=c++17 -O2 -no-pie tests/touch-differential.cpp "$artifact.opt.o" -o "$artifact"
"$artifact"
