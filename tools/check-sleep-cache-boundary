#!/usr/bin/env python3
"""Check the cache-off function survives monolithic optimization in IRAM.

Unlike an all-IRAM fixture, the timed caller intentionally lives in flash.
This checks optimized LLVM, not final addresses, indirect calls or hardware.
"""
import re
import subprocess
import sys
from pathlib import Path


def validate(source):
    attributes = dict(re.findall(r'^attributes #(\d+) = \{([^\n]*)\}', source, re.M))
    functions = {}
    for match in re.finditer(r'^define [^\n]*@([\w.$]+)\([^\n]*\)[^\n]*\{\n.*?^\}', source, re.M | re.S):
        block = match.group(0)
        header = block.split('\n', 1)[0]
        section = re.search(r'section "([^"]+)"', header)
        attr = re.search(r'#(\d+)', header)
        functions[match.group(1)] = (section.group(1) if section else '', attributes.get(attr.group(1), '') if attr else '', block)
    roots = [name for name, (section, _, _) in functions.items() if section == '.iram1.abla.s3LightSleepSuspended']
    if not roots:
        raise ValueError('cache-off boundary vanished: potentially inlined into flash caller')
    for root in roots:
        if not re.search(r'\bnoinline\b', functions[root][1]):
            raise ValueError('cache-off boundary is not protected against inlining')
    seen = set()
    pending = roots[:]
    while pending:
        name = pending.pop()
        if name in seen:
            continue
        seen.add(name)
        section, _, body = functions[name]
        if not section.startswith('.iram1.'):
            raise ValueError(f'cache-off closure references non-IRAM function: {name}')
        pending.extend(ref for ref in re.findall(r'@([\w.$]+)', body) if ref in functions and ref not in seen)
    return len(seen)


if __name__ == '__main__':
    try:
        path = Path(sys.argv[1])
        source = subprocess.check_output(['llvm-dis', str(path), '-o', '-'], text=True) if path.suffix == '.bc' else path.read_text()
        count = validate(source)
    except (IndexError, OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
    print(f'PASS: non-inline cache-off boundary and {count} retained IRAM functions (LLVM-level only)')
