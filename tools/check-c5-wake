#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export ABLA_SYSROOT="${ABLA_SYSROOT:-../ablac}"
mkdir -p build/tests
for fixture in touch-board power-button pmic-key button-state button-frame sensors-update timer-control sensors-begin-hp sensors-begin lp-gpio-clock tough-lp-owner lp-i2c-device-io lp-i2c-provider lp-i2c-bus-io lp-i2c-bus lp-i2c-recovery lp-i2c-released lp-i2c-setup lp-i2c-teardown lp-i2c-release lp-i2c-pins lp-i2c-stream lp-i2c-transfer lp-i2c-poll lp-i2c-fifo lp-i2c-controller lp-i2c-timing lp-i2c-clock touch-button-frame touch-buttons tough-owner i2c-provider tough-boot i2c-device-io i2c-devices wake tough-wake delay i2c-timing i2c-clock i2c-fifo i2c-poll i2c-controller i2c-transfer i2c-stream i2c-pins i2c-setup i2c-teardown i2c-released i2c-recovery i2c-clear i2c-guarded i2c-guarded-recovery i2c-bus i2c-bus-io; do
artifact=build/tests/esp32c5-$fixture
entry=abla_c5_wake_target
if [[ $fixture == touch-board ]]; then entry=abla_c5_touch_board_target; fi
if [[ $fixture == power-button ]]; then entry=abla_c5_power_button_target; fi
if [[ $fixture == pmic-key ]]; then entry=abla_c5_pmic_key_target; fi
if [[ $fixture == button-state ]]; then entry=abla_c5_button_state_target; fi
if [[ $fixture == button-frame ]]; then entry=abla_c5_button_frame_target; fi
if [[ $fixture == sensors-update ]]; then entry=abla_c5_sensors_update_target; fi
if [[ $fixture == timer-control ]]; then entry=abla_c5_timer_control_target; fi
if [[ $fixture == sensors-begin-hp ]]; then entry=abla_c5_sensors_begin_hp_target; fi
if [[ $fixture == sensors-begin ]]; then entry=abla_c5_sensors_begin_target; fi
if [[ $fixture == lp-gpio-clock ]]; then entry=abla_c5_lp_gpio_clock_target; fi
if [[ $fixture == tough-lp-owner ]]; then entry=abla_c5_tough_lp_owner_target; fi
if [[ $fixture == lp-i2c-device-io ]]; then entry=abla_c5_lp_i2c_device_io_target; fi
if [[ $fixture == lp-i2c-provider ]]; then entry=abla_c5_lp_i2c_provider_target; fi
if [[ $fixture == lp-i2c-bus-io ]]; then entry=abla_c5_lp_i2c_bus_io_target; fi
if [[ $fixture == lp-i2c-bus ]]; then entry=abla_c5_lp_i2c_bus_target; fi
if [[ $fixture == lp-i2c-recovery ]]; then entry=abla_c5_lp_i2c_recovery_target; fi
if [[ $fixture == lp-i2c-released ]]; then entry=abla_c5_lp_i2c_released_target; fi
if [[ $fixture == lp-i2c-setup ]]; then entry=abla_c5_lp_i2c_setup_target; fi
if [[ $fixture == lp-i2c-teardown ]]; then entry=abla_c5_lp_i2c_teardown_target; fi
if [[ $fixture == lp-i2c-release ]]; then entry=abla_c5_lp_i2c_release_target; fi
if [[ $fixture == lp-i2c-pins ]]; then entry=abla_c5_lp_i2c_pins_target; fi
if [[ $fixture == lp-i2c-stream ]]; then entry=abla_c5_lp_i2c_stream_target; fi
if [[ $fixture == lp-i2c-transfer ]]; then entry=abla_c5_lp_i2c_transfer_target; fi
if [[ $fixture == lp-i2c-poll ]]; then entry=abla_c5_lp_i2c_poll_target; fi
if [[ $fixture == lp-i2c-fifo ]]; then entry=abla_c5_lp_i2c_fifo_target; fi
if [[ $fixture == lp-i2c-controller ]]; then entry=abla_c5_lp_i2c_controller_target; fi
if [[ $fixture == lp-i2c-timing ]]; then entry=abla_c5_lp_i2c_timing_target; fi
if [[ $fixture == lp-i2c-clock ]]; then entry=abla_c5_lp_i2c_clock_target; fi
if [[ $fixture == touch-button-frame ]]; then entry=abla_c5_touch_button_frame_target; fi
if [[ $fixture == touch-buttons ]]; then entry=abla_c5_touch_buttons_target; fi
if [[ $fixture == tough-owner ]]; then entry=abla_c5_tough_owner_target; fi
if [[ $fixture == i2c-provider ]]; then entry=abla_c5_i2c_provider_target; fi
