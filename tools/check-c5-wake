if [[ $fixture == i2c-clock ]]; then entry=abla_c5_i2c_clock_target; fi
if [[ $fixture == i2c-fifo ]]; then entry=abla_c5_i2c_fifo_target; fi
if [[ $fixture == i2c-poll ]]; then entry=abla_c5_i2c_poll_target; fi
if [[ $fixture == i2c-controller ]]; then entry=abla_c5_i2c_controller_target; fi
