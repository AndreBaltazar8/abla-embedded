if [[ $fixture == i2c-bus ]]; then entry=abla_c5_i2c_bus_target; fi
"$ABLA_SYSROOT/build/ablac" build "tests/esp32c5-$fixture-target.ab" -o "$artifact.o" --target-triple riscv32-unknown-none-elf --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -mtriple=riscv32-unknown-none-elf -mattr=+m,+a,+zicsr "$artifact.bc" -o "$artifact.opt.o"
test -z "$(nm -u "$artifact.opt.o")"
test "$(nm -g --defined-only "$artifact.opt.o" | awk '{print $3}')" = "$entry"
llvm-objdump -dr "$artifact.opt.o" > "$artifact.dis"
printf '%s: PASS (RV32 object; sole export; zero undefined)\n' "$fixture"
done
