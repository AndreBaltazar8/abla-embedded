// Repair ADDMI immediates emitted by the pre-fix Xtensa lifter.
//
// Old lifter output multiplied objdump's already-shifted ADDMI byte displacement
// by another 256. The generated register-machine spelling makes those sites
// unambiguous: ADDI cannot encode these values and other arithmetic instructions
// do not emit a register plus/minus a literal.
//
//     tools/abla-tool repair-lifted-addmi-immediates [--write] [PATHS...]

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/integer"
import "abla/process/arguments"
import "lib/abfiles.ab"

class AddmiRepair(val text: string, val count: int)

private fun isDigit(byte: int): bool = byte >= 48 && byte <= 57

private fun skipDigits(line: string, from: int): int {
    var index = from
    while (index < line.size && isDigit(line[index])) index = index + 1
    index
}

// `[ \t]*rN = rM [+-] u32(AMOUNT)[ \t]*` : returns the amount's span, or null.
private fun addmiAmountSpan(line: string): array<int> {
    var index = 0
    while (index < line.size && (line[index] == 32 || line[index] == 9)) index = index + 1
    val none: array<int> = []
    for (piece in ["r"]) {
        if (!line.slice(index, line.size).startsWith(piece)) return none
    }
    index = index + 1
    var after = skipDigits(line, index)
    if (after == index) return none
    if (!line.slice(after, line.size).startsWith(" = r")) return none
    index = after + 4
    after = skipDigits(line, index)
    if (after == index) return none
    val rest = line.slice(after, line.size)
    if (!(rest.startsWith(" + u32(") || rest.startsWith(" - u32("))) return none
    index = after + 7
    after = skipDigits(line, index)
    if (after == index) return none
    if (after >= line.size || line[after] != 41) return none
    var tail = after + 1
    while (tail < line.size && (line[tail] == 32 || line[tail] == 9)) tail = tail + 1
    if (tail != line.size) return none
    [index, after]
}

fun repairAddmi(source: string): AddmiRepair {
    var count = 0
    val lines = source.split("\n")
    val out: array<string> = []
    for (line in lines) {
        val span = addmiAmountSpan(line)
        if (span.size == 0) {
            out.append(line)
            continue
        }
        val digits = line.slice(span[0], span[1])
        val parsed = digits.parseInt()
        // An amount too large for an int is not an ADDMI repair site.
        if (parsed == null || parsed < 65536 || parsed > 8323072 || parsed % 65536 != 0) {
            out.append(line)
            continue
        }
        count = count + 1
        out.append(line.slice(0, span[0]) + "${parsed / 256}" + line.slice(span[1], line.size))
    }
    AddmiRepair(out.join("\n"), count)
}

fun main: int {
    var write = false
    val arguments: array<string> = []
    var index = 0
    while (index < processArgumentCount()) {
        val argument = processArgument(index)
        if (argument == "--write") write = true
        else arguments.append(argument)
        index = index + 1
    }
    if (arguments.size == 0) arguments.append("src")
    val found: array<string> = []
    for (argument in arguments) {
        val info = Path(argument).info()
        if (info.isDirectory()) rglobAb(argument, found)
        else if (argument.endsWith(".ab") && info.isFile()) found.append(normalizePath(argument))
    }
    var files = 0
    var sites = 0
    for (file in sortedUniquePaths(found)) {
        val source = Path(file).readText()
        val repaired = repairAddmi(source)
        if (repaired.count == 0) continue
        files = files + 1
        sites = sites + repaired.count
        if (write) Path(file).writeText(repaired.text)
        else println("$file: ${repaired.count}")
    }
    val action = if (write) "repaired" else "would repair"
    println("$action $sites ADDMI immediate(s) in $files file(s)")
    if (write || sites == 0) 0 else 1
}
