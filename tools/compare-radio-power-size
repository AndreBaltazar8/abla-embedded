#!/usr/bin/env bash
set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
esp_llvm_root=${ABLA_ESP_LLVM_ROOT:-$cache_root/abla-embedded/esp-clang-21.1.3}
output_directory=$project_root/build/benchmarks/radio-power
abla_object=$project_root/build/examples/radio-mac-registers/abla_power.o
c_object=$output_directory/reference.o
abla_text=$output_directory/abla.text
abla_literal=$output_directory/abla.literal
c_text=$output_directory/c.text
c_literal=$output_directory/c.literal
runner=()

if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi

if [[ ! -x $esp_llvm_root/bin/clang || ! -x $esp_llvm_root/bin/llvm-size ||
      ! -x $esp_llvm_root/bin/llvm-objcopy ]]; then
    printf 'missing Espressif LLVM under %s; run make setup\n' \
        "$esp_llvm_root" >&2
    exit 1
fi

if [[ ! -f $abla_object ]]; then
    "$project_root/tools/build-example" radio-mac-registers
fi

mkdir -p "$output_directory"
"${runner[@]}" "$esp_llvm_root/bin/clang" \
    --target=xtensa-esp-elf -mcpu=esp32 -O2 -fomit-frame-pointer \
    -ffunction-sections -fdata-sections -fno-unwind-tables \
    -fno-asynchronous-unwind-tables \
    -c "$project_root/benchmarks/radio-power-reference.c" -o "$c_object"

section_bytes() {
    local object=$1
    local symbol=$2
    "${runner[@]}" "$esp_llvm_root/bin/llvm-size" -A "$object" |
        awk -v text=".text.$symbol" -v literal=".literal.$symbol" \
            '$1 == text || $1 == literal { total += $2 } END { print total + 0 }'
}

abla_bytes=$(section_bytes "$abla_object" abla_wifi_radio_power_on_240mhz)
c_bytes=$(section_bytes "$c_object" c_wifi_radio_power_on_240mhz)

printf 'radio power-on leaf (.text + .literal): Abla %s bytes, C %s bytes\n' \
    "$abla_bytes" "$c_bytes"

if (( abla_bytes > c_bytes )); then
    printf 'Abla radio power-on leaf regressed past the equivalent C leaf\n' >&2
    exit 1
fi

"${runner[@]}" "$esp_llvm_root/bin/llvm-objcopy" \
    --dump-section=.text.abla_wifi_radio_power_on_240mhz="$abla_text" \
    --dump-section=.literal.abla_wifi_radio_power_on_240mhz="$abla_literal" \
    "$abla_object"
"${runner[@]}" "$esp_llvm_root/bin/llvm-objcopy" \
    --dump-section=.text.c_wifi_radio_power_on_240mhz="$c_text" \
    --dump-section=.literal.c_wifi_radio_power_on_240mhz="$c_literal" \
    "$c_object"

cmp "$abla_text" "$c_text"
cmp "$abla_literal" "$c_literal"
printf '%s\n' 'radio power-on machine code and literals: byte-identical'
