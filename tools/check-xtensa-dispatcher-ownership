#!/usr/bin/env bash
set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
esp_llvm_root=${ABLA_ESP_LLVM_ROOT:-$cache_root/abla-embedded/esp-clang-21.1.3}
toolchain_root=$project_root/.platformio/packages/toolchain-xtensa-esp32/bin
sdk_archive=$project_root/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32/lib/libxtensa.a
hal_archive=$project_root/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32/lib/libxt_hal.a
output_directory=$project_root/build/benchmarks/xtensa-dispatcher
abla_object=$project_root/build/examples/radio-mac-registers/abla_dispatcher.o
consumer_object=$output_directory/consumer.o
linked_object=$output_directory/linked.o
link_map=$output_directory/linked.map
vendor_directory=$output_directory/vendor
vendor_object=$vendor_directory/xtensa_intr_asm.S.obj
vendor_c_object=$vendor_directory/xtensa_intr.c.obj
vendor_hal_directory=$output_directory/vendor-hal
vendor_level_object=$vendor_hal_directory/interrupts--intlevel.o
vendor_get_enable_object=$vendor_hal_directory/int_asm--get_intenable.o
vendor_set_enable_object=$vendor_hal_directory/int_asm--set_intenable.o
vendor_get_pending_object=$vendor_hal_directory/int_asm--get_interrupt.o
vendor_set_pending_object=$vendor_hal_directory/int_asm--set_intset.o
vendor_clear_pending_object=$vendor_hal_directory/int_asm--set_intclear.o
vendor_save_extra_object=$vendor_hal_directory/state_asm--save_extra_nw.o
vendor_restore_extra_object=$vendor_hal_directory/state_asm--restore_extra_nw.o
vendor_window_spill_object=$vendor_hal_directory/windowspill_asm.o
runner=()

if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi

clang=$esp_llvm_root/bin/clang
llvm_size=$esp_llvm_root/bin/llvm-size
ld=$toolchain_root/xtensa-esp32-elf-ld
nm=$toolchain_root/xtensa-esp32-elf-nm
ar=$toolchain_root/xtensa-esp32-elf-ar
objdump=$toolchain_root/xtensa-esp32-elf-objdump

for executable in "$clang" "$llvm_size" "$ld" "$nm" "$ar" "$objdump"; do
    if [[ ! -x $executable ]]; then
        printf 'missing required Xtensa tool: %s\n' "$executable" >&2
        exit 1
    fi
done
if [[ ! -f $sdk_archive || ! -f $hal_archive ]]; then
    printf 'missing classic ESP32 Xtensa archive: %s or %s\n' \
        "$sdk_archive" "$hal_archive" >&2
    exit 1
fi
if [[ ! -f $abla_object ]]; then
    "$project_root/tools/build-example" radio-mac-registers
fi

mkdir -p "$output_directory" "$vendor_directory" "$vendor_hal_directory"
"${runner[@]}" "$clang" --target=xtensa-esp-elf -mcpu=esp32 -O2 \
    -ffunction-sections -fdata-sections -fno-unwind-tables \
    -fno-asynchronous-unwind-tables -std=c++17 \
    -c "$project_root/benchmarks/xtensa-dispatcher-consumer.cpp" \
    -o "$consumer_object"

"${runner[@]}" "$ld" -r -Map="$link_map" \
    "$consumer_object" "$abla_object" "$sdk_archive" "$hal_archive" \
    -o "$linked_object"
(cd "$vendor_directory" &&
    "${runner[@]}" "$ar" x "$sdk_archive" \
        xtensa_intr_asm.S.obj xtensa_intr.c.obj)
(cd "$vendor_hal_directory" &&
    "${runner[@]}" "$ar" x "$hal_archive" \
        interrupts--intlevel.o \
        int_asm--get_intenable.o int_asm--set_intenable.o \
        int_asm--get_interrupt.o int_asm--set_intset.o \
        int_asm--set_intclear.o state_asm--save_extra_nw.o \
        state_asm--restore_extra_nw.o windowspill_asm.o)

if rg -q 'xtensa_intr_asm\.S\.obj' "$link_map"; then
    echo 'vendor dispatcher assembly was still selected from libxtensa.a' >&2
    exit 1
fi
if rg -q 'xtensa_intr\.c\.obj' "$link_map"; then
    echo 'vendor C dispatcher was still selected from libxtensa.a' >&2
    exit 1
fi
if rg -q 'interrupts--intlevel\.o' "$link_map"; then
    echo 'vendor interrupt-level table was still selected from libxt_hal.a' >&2
    exit 1
fi
for member in int_asm--get_intenable.o int_asm--set_intenable.o \
    int_asm--get_interrupt.o int_asm--set_intset.o \
    int_asm--set_intclear.o state_asm--save_extra_nw.o \
    state_asm--restore_extra_nw.o windowspill_asm.o
do
    if rg -q "${member//./\\.}" "$link_map"; then
        printf 'vendor interrupt-register HAL was still selected: %s\n' \
            "$member" >&2
        exit 1
    fi
done

symbol_size() {
    local object=$1
    local symbol=$2
    "${runner[@]}" "$nm" -S --radix=d "$object" |
        awk -v wanted="$symbol" '$4 == wanted { print $2 + 0 }'
}

symbol_address() {
    local object=$1
    local symbol=$2
    "${runner[@]}" "$nm" --radix=d "$object" |
        awk -v wanted="$symbol" '$NF == wanted { print $1 + 0 }'
}

interrupt_bytes=$(symbol_size "$linked_object" _xt_interrupt_table)
exception_bytes=$(symbol_size "$linked_object" _xt_exception_table)
level_bytes=$(symbol_size "$linked_object" Xthal_intlevel)
if [[ $interrupt_bytes != 512 || $exception_bytes != 512 ||
      $level_bytes != 32 ]]; then
    printf 'unexpected table sizes: interrupt=%s exception=%s level=%s\n' \
        "${interrupt_bytes:-missing}" "${exception_bytes:-missing}" \
        "${level_bytes:-missing}" >&2
    exit 1
fi

for symbol in _xt_interrupt_table _xt_exception_table Xthal_intlevel \
    xt_ints_on xt_ints_off \
    xt_unhandled_interrupt xt_int_has_handler xt_set_interrupt_handler \
    xt_set_exception_handler \
    xthal_get_intenable xthal_set_intenable xthal_get_intread \
    xthal_get_interrupt xthal_set_intset xthal_set_intclear \
    xthal_save_extra_nw xthal_restore_extra_nw \
    xthal_window_spill_nw xthal_spill_registers_into_stack_nw \
    xthal_window_spill
do
    if ! "${runner[@]}" "$nm" "$linked_object" |
        awk -v wanted="$symbol" \
            '$NF == wanted && $1 != "U" { found = 1 } END { exit !found }'
    then
        printf 'Abla-owned symbol is not defined after linking: %s\n' \
            "$symbol" >&2
        exit 1
    fi
done

unexpected_unresolved=$("${runner[@]}" "$nm" -u "$abla_object" |
    awk '$NF != "xt_unhandled_exception" { print $NF }')
if [[ -n $unexpected_unresolved ]]; then
    printf 'unexpected unresolved Abla dispatcher symbols:\n%s\n' \
        "$unexpected_unresolved" >&2
    exit 1
fi

data_bytes=$("${runner[@]}" "$llvm_size" -A "$abla_object" |
    awk '$1 ~ /^\.data/ { total += $2 } END { print total + 0 }')
if [[ $data_bytes != 1024 ]]; then
    printf 'Abla dispatcher data is %s bytes; vendor ABI requires 1024\n' \
        "$data_bytes" >&2
    exit 1
fi

instruction_count() {
    local object=$1
    local symbol=$2
    "${runner[@]}" "$objdump" -d --disassemble="$symbol" "$object" |
        awk '/^[[:space:]]*[[:xdigit:]]+:/ { count += 1 } END { print count + 0 }'
}

machine_code() {
    local object=$1
    local symbol=$2
    "${runner[@]}" "$objdump" -d --disassemble="$symbol" "$object" |
        awk '/^[[:space:]]*[[:xdigit:]]+:/ { print $2 }'
}

section_hex() {
    local object=$1
    local section=$2
    "${runner[@]}" "$objdump" -s -j "$section" "$object" |
        awk '{
            for (field = 2; field <= 5; field += 1) {
                if ($field ~ /^[[:xdigit:]]+$/ &&
                    length($field) <= 8 && length($field) % 2 == 0) {
                    printf "%s", tolower($field)
                }
            }
        } END { print "" }'
}

symbol_hex() {
    local object=$1
    local symbol=$2
    local section=${3:-.text}
    local address size bytes
    address=$(symbol_address "$object" "$symbol")
    size=$(symbol_size "$object" "$symbol")
    bytes=$(section_hex "$object" "$section")
    printf '%s\n' "${bytes:$((address * 2)):$((size * 2))}"
}

normalized_window_wrapper_hex() {
    local object=$1
    local bytes
    bytes=$(symbol_hex "$object" xthal_window_spill)
    # The L32R literal and CALL0 targets carry the same relocations, but LLVM's
    # direct emitter and the archived assembler encode different placeholders.
    printf '%s000000%s000000%s\n' \
        "${bytes:0:6}" "${bytes:12:32}" "${bytes:50}"
}

compare_window_spill() {
    local abla_primary vendor_primary abla_wrapper vendor_wrapper
    abla_primary=$(symbol_hex "$abla_object" xthal_window_spill_nw)
    vendor_primary=$(symbol_hex \
        "$vendor_window_spill_object" xthal_window_spill_nw)
    abla_wrapper=$(normalized_window_wrapper_hex "$abla_object")
    vendor_wrapper=$(normalized_window_wrapper_hex \
        "$vendor_window_spill_object")
    if [[ $abla_primary != "$vendor_primary" ||
          $abla_wrapper != "$vendor_wrapper" ]]; then
        echo 'Abla window-spill instruction bytes differ from vendor HAL' >&2
        exit 1
    fi
    for object in "$abla_object" "$vendor_window_spill_object"; do
        if ! "${runner[@]}" "$objdump" -r -j .text "$object" |
            awk '$1 == "00000117" && $2 == "R_XTENSA_SLOT0_OP" &&
                     $3 == ".literal" { literal = 1 }
                 $1 == "0000012a" && $2 == "R_XTENSA_SLOT0_OP" &&
                     $3 == "xthal_window_spill_nw" { call = 1 }
                 END { exit !(literal && call) }'
        then
            printf 'window-spill relocation contract differs: %s\n' \
                "$object" >&2
            exit 1
        fi
    done
}

abla_on_bytes=$(symbol_size "$abla_object" xt_ints_on)
abla_off_bytes=$(symbol_size "$abla_object" xt_ints_off)
vendor_on_bytes=$(symbol_size "$vendor_object" xt_ints_on)
vendor_off_bytes=$(symbol_size "$vendor_object" xt_ints_off)
abla_on_instructions=$(instruction_count "$abla_object" xt_ints_on)
abla_off_instructions=$(instruction_count "$abla_object" xt_ints_off)
vendor_on_instructions=$(instruction_count "$vendor_object" xt_ints_on)
vendor_off_instructions=$(instruction_count "$vendor_object" xt_ints_off)
if (( abla_on_bytes > vendor_on_bytes ||
      abla_off_bytes > vendor_off_bytes ||
      abla_on_instructions > vendor_on_instructions ||
      abla_off_instructions > vendor_off_instructions )); then
    echo 'Abla interrupt helper regressed past the vendor assembly' >&2
    exit 1
fi

compare_hal_leaf() {
    local symbol=$1
    local vendor_object=$2
    local vendor_symbol=${3:-$symbol}
    local abla_bytes vendor_bytes abla_instructions vendor_instructions
    abla_bytes=$(symbol_size "$abla_object" "$symbol")
    vendor_bytes=$(symbol_size "$vendor_object" "$vendor_symbol")
    abla_instructions=$(instruction_count "$abla_object" "$symbol")
    vendor_instructions=$(instruction_count "$vendor_object" "$vendor_symbol")
    if (( abla_bytes > vendor_bytes ||
          abla_instructions > vendor_instructions )); then
        printf 'Abla %s regressed past vendor HAL\n' "$symbol" >&2
        exit 1
    fi
    if ! cmp -s \
        <(machine_code "$abla_object" "$symbol") \
        <(machine_code "$vendor_object" "$vendor_symbol")
    then
        printf 'Abla %s machine code differs from vendor HAL\n' \
            "$symbol" >&2
        exit 1
    fi
    printf '%s: Abla %s bytes/%s instructions, vendor %s/%s\n' \
        "$symbol" "$abla_bytes" "$abla_instructions" \
        "$vendor_bytes" "$vendor_instructions"
}

runtime_sections() {
    local object=$1
    shift
    local joined
    joined=$(IFS='|'; printf '%s' "$*")
    "${runner[@]}" "$llvm_size" -A "$object" |
        awk -v wanted="$joined" \
            'BEGIN { count = split(wanted, names, "|") }
             { for (i = 1; i <= count; i += 1) {
                   if ($1 == names[i]) total += $2
               }
             }
             END { print total + 0 }'
}

abla_management_bytes=$(runtime_sections "$abla_object" \
    .iram1.text \
    .literal.xt_int_has_handler .text.xt_int_has_handler \
    .literal.xt_set_interrupt_handler .text.xt_set_interrupt_handler \
    .literal.xt_set_exception_handler .text.xt_set_exception_handler)
vendor_management_bytes=$(runtime_sections "$vendor_c_object" \
    .iram1.26.literal .iram1.26 .rodata.str1.1 \
    .literal.xt_int_has_handler .text.xt_int_has_handler \
    .literal.xt_set_interrupt_handler .text.xt_set_interrupt_handler \
    .literal.xt_set_exception_handler .text.xt_set_exception_handler)
if (( abla_management_bytes > vendor_management_bytes )); then
    echo 'Abla dispatcher management unit regressed past vendor C' >&2
    exit 1
fi

abla_unhandled_bytes=$(runtime_sections "$abla_object" .iram1.text)
vendor_unhandled_bytes=$(runtime_sections "$vendor_c_object" \
    .iram1.26.literal .iram1.26 .rodata.str1.1)
abla_has_bytes=$(runtime_sections "$abla_object" \
    .literal.xt_int_has_handler .text.xt_int_has_handler)
vendor_has_bytes=$(runtime_sections "$vendor_c_object" \
    .literal.xt_int_has_handler .text.xt_int_has_handler)
abla_set_interrupt_bytes=$(runtime_sections "$abla_object" \
    .literal.xt_set_interrupt_handler .text.xt_set_interrupt_handler)
vendor_set_interrupt_bytes=$(runtime_sections "$vendor_c_object" \
    .literal.xt_set_interrupt_handler .text.xt_set_interrupt_handler)
abla_set_exception_bytes=$(runtime_sections "$abla_object" \
    .literal.xt_set_exception_handler .text.xt_set_exception_handler)
vendor_set_exception_bytes=$(runtime_sections "$vendor_c_object" \
    .literal.xt_set_exception_handler .text.xt_set_exception_handler)
if (( abla_unhandled_bytes > vendor_unhandled_bytes ||
      abla_has_bytes > vendor_has_bytes ||
      abla_set_interrupt_bytes > vendor_set_interrupt_bytes ||
      abla_set_exception_bytes > vendor_set_exception_bytes )); then
    echo 'an Abla dispatcher leaf regressed past vendor C' >&2
    exit 1
fi

abla_has_instructions=$(instruction_count "$abla_object" xt_int_has_handler)
vendor_has_instructions=$(instruction_count \
    "$vendor_c_object" xt_int_has_handler)
abla_set_interrupt_instructions=$(instruction_count \
    "$abla_object" xt_set_interrupt_handler)
vendor_set_interrupt_instructions=$(instruction_count \
    "$vendor_c_object" xt_set_interrupt_handler)
abla_set_exception_instructions=$(instruction_count \
    "$abla_object" xt_set_exception_handler)
vendor_set_exception_instructions=$(instruction_count \
    "$vendor_c_object" xt_set_exception_handler)
if (( abla_has_instructions > vendor_has_instructions ||
      abla_set_interrupt_instructions > vendor_set_interrupt_instructions ||
      abla_set_exception_instructions > vendor_set_exception_instructions )); then
    echo 'an Abla dispatcher management leaf uses more instructions than C' >&2
    exit 1
fi

if ! "${runner[@]}" "$objdump" -t "$abla_object" |
    awk '$4 == ".iram1.text" && $NF == "xt_unhandled_interrupt" \
        { found = 1 } END { exit !found }'
then
    echo 'Abla unhandled interrupt fallback is not resident in IRAM' >&2
    exit 1
fi

printf 'dispatcher tables: Abla %s bytes, vendor ABI 1024 bytes\n' "$data_bytes"
printf 'interrupt-level table: Abla %s bytes, vendor HAL %s bytes\n' \
    "$level_bytes" "$(symbol_size "$vendor_level_object" Xthal_intlevel)"
printf 'xt_ints_on: Abla %s bytes/%s instructions, vendor %s/%s\n' \
    "$abla_on_bytes" "$abla_on_instructions" \
    "$vendor_on_bytes" "$vendor_on_instructions"
printf 'xt_ints_off: Abla %s bytes/%s instructions, vendor %s/%s\n' \
    "$abla_off_bytes" "$abla_off_instructions" \
    "$vendor_off_bytes" "$vendor_off_instructions"
compare_hal_leaf xthal_get_intenable "$vendor_get_enable_object"
compare_hal_leaf xthal_set_intenable "$vendor_set_enable_object"
compare_hal_leaf xthal_get_intread "$vendor_get_pending_object"
compare_hal_leaf xthal_get_interrupt "$vendor_get_pending_object" \
    xthal_get_intread
compare_hal_leaf xthal_set_intset "$vendor_set_pending_object"
compare_hal_leaf xthal_set_intclear "$vendor_clear_pending_object"
compare_hal_leaf xthal_save_extra_nw "$vendor_save_extra_object"
compare_hal_leaf xthal_restore_extra_nw "$vendor_restore_extra_object"
compare_window_spill
abla_window_address=$(symbol_address \
    "$abla_object" xthal_window_spill_nw)
abla_window_alias_address=$(symbol_address \
    "$abla_object" xthal_spill_registers_into_stack_nw)
vendor_window_address=$(symbol_address \
    "$vendor_window_spill_object" xthal_window_spill_nw)
vendor_window_alias_address=$(symbol_address \
    "$vendor_window_spill_object" xthal_spill_registers_into_stack_nw)
if [[ $abla_window_address != "$abla_window_alias_address" ||
      $vendor_window_address != "$vendor_window_alias_address" ]]; then
    echo 'window-spill compatibility alias does not share the primary entry' >&2
    exit 1
fi
abla_window_runtime=$(runtime_sections "$abla_object" .literal .text)
vendor_window_runtime=$(runtime_sections \
    "$vendor_window_spill_object" .literal .text)
if [[ $abla_window_runtime != "$vendor_window_runtime" ]]; then
    printf 'window-spill runtime differs: Abla=%s vendor=%s\n' \
        "$abla_window_runtime" "$vendor_window_runtime" >&2
    exit 1
fi
printf 'window-spill unit: Abla %s bytes, vendor HAL %s bytes; alias exact\n' \
    "$abla_window_runtime" "$vendor_window_runtime"
printf 'dispatcher management runtime: Abla %s bytes, vendor C %s bytes\n' \
    "$abla_management_bytes" "$vendor_management_bytes"
printf 'unhandled fallback: Abla %s bytes, vendor C+ROM format %s bytes\n' \
    "$abla_unhandled_bytes" "$vendor_unhandled_bytes"
printf 'handler query: Abla %s bytes/%s instructions, vendor C %s/%s\n' \
    "$abla_has_bytes" "$abla_has_instructions" \
    "$vendor_has_bytes" "$vendor_has_instructions"
printf 'interrupt setter: Abla %s bytes/%s instructions, vendor C %s/%s\n' \
    "$abla_set_interrupt_bytes" "$abla_set_interrupt_instructions" \
    "$vendor_set_interrupt_bytes" "$vendor_set_interrupt_instructions"
printf 'exception setter: Abla %s bytes/%s instructions, vendor C %s/%s\n' \
    "$abla_set_exception_bytes" "$abla_set_exception_instructions" \
    "$vendor_set_exception_bytes" "$vendor_set_exception_instructions"
echo 'vendor Xtensa dispatcher assembly, C, interrupt-level, five interrupt-register, two extra-state, and window-spill objects excluded; all 20 ABI names are Abla-owned'
