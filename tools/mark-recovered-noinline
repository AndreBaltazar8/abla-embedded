#!/usr/bin/env python3
"""Keep recovered Xtensa functions out of their callers.

Every recovered ABI function stays in the image as its own symbol (raw
assembly, the Espressif objects and function tables reach it by name), so
inlining a copy into each caller only adds code: with `EXPORTS=all` the
eight-archive unit lost 16.6 KB of text when the recovered functions were
marked noinline. GCC kept the same calls as calls, so this also restores the
original call structure.

Functions whose body has at most `--inline-lines` statements stay inlinable
(a wrapper or getter can be smaller than its call sequence). The pass only
adds the existing `@noinline` annotation, which ablac lowers to the LLVM
`noinline` attribute; it changes no behaviour.
"""

from __future__ import annotations

import argparse
import pathlib
import re
import sys

HEAD = re.compile(r"^(?P<attrs>(?:@[^\n]*\n)*)(?P<fun>trusted fun esp32Recovered\w+\()", re.MULTILINE)
DECLARATION = re.compile(
    r"^    var (?:r\d+|incomingStack\d|shiftAmount|compareExchangeExpected) = ")


def body_statements(text: str, start: int) -> int | None:
    """Statements of the function whose `): T {` follows `start`, or None."""
    begin = text.find("\n): ", start)
    if begin < 0:
        return None
    open_brace = text.find("{\n", begin)
    end = text.find("\n}\n", open_brace)
    if open_brace < 0 or end < 0:
        return None
    lines = text[open_brace + 2:end].split("\n")
    return sum(1 for line in lines
               if line.strip() and not DECLARATION.match(line) and line.strip() != "}")


def process(text: str, inline_lines: int) -> tuple[str, int]:
    count = 0
    out: list[str] = []
    last = 0
    for match in HEAD.finditer(text):
        attrs = match.group("attrs")
        if "@noinline" in attrs or "@naked" in attrs or "@inline" in attrs:
            continue
        statements = body_statements(text, match.end())
        if statements is None or statements <= inline_lines:
            continue
        out.append(text[last:match.start("fun")])
        out.append("@noinline\n")
        last = match.start("fun")
        count += 1
    out.append(text[last:])
    return "".join(out), count


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("root")
    parser.add_argument("--write", action="store_true")
    parser.add_argument("--inline-lines", type=int, default=0)
    arguments = parser.parse_args()
    total = 0
    for path in sorted(pathlib.Path(arguments.root).rglob("*.ab")):
        text = path.read_text()
        new_text, count = process(text, arguments.inline_lines)
        total += count
        if count and arguments.write:
            path.write_text(new_text)
    print(f"{'marked' if arguments.write else 'would mark'} {total} function(s) noinline")
    return 0


if __name__ == "__main__":
    sys.exit(main())
