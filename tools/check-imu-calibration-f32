#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Pinned Nix shell; C/libm is only an independent host oracle.
export ABLA_SYSROOT=${ABLA_SYSROOT:-../ablac}
compiler=${ABLA_COMPILER:-../ablac/build/ablac}
artifact=build/tests/imu-calibration-f32-native
mkdir -p build/tests
"$compiler" build tests/imu-calibration-f32-native.ab -o "$artifact.o" \
    --target-triple x86_64-unknown-linux-gnu --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -relocation-model=static "$artifact.bc" -o "$artifact.opt.o"
cc -O2 -ffp-contract=off -fno-builtin-sqrtf -fno-builtin-roundf -no-pie \
    tests/imu-calibration-f32-reference.c "$artifact.opt.o" -lm -o "$artifact"
"$artifact"
