// Print the entry point, section addresses and defined symbols of an ELF32 file for the
// shell drivers that run an image in an emulator (they read addresses from here instead
// of parsing the ELF themselves).
//
//     tools/abla-tool elf-symbols ELF NAME...
//
// For each NAME one line `NAME VALUE SIZE` (decimal; the last definition wins, as a symbol
// table lookup by name would). `@entry` prints `@entry ENTRY`. A NAME starting with `.` is a
// section that must exist exactly once and prints `NAME ADDRESS`. Exit status 1 when a NAME
// is missing.

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/arguments"
import "lib/elf.ab"

fun main: int {
    if (processArgumentCount() < 2) {
        eprintln("usage: elf-symbols ELF NAME...")
        return 2
    }
    val read = Path(processArgument(0)).readTextResult()
    if (!read.succeeded) {
        eprintln("cannot read ${processArgument(0)}")
        return 1
    }
    val elf = elf32Parse(read.text)
    if (elf.error != "") {
        eprintln("${processArgument(0)}: ${elf.error}")
        return 1
    }
    val names: array<string> = []
    val values: array<int> = []
    val sizes: array<int> = []
    var tableIndex = 0
    while (tableIndex < elf.sections.size) {
        if (elf.sections[tableIndex].kind == ELF_SHT_SYMTAB) {
            for (symbol in elf.symbols(tableIndex)) {
                if (symbol.name != "" && symbol.sectionIndex != 0) {
                    names.append(symbol.name)
                    values.append(symbol.value)
                    sizes.append(symbol.size)
                }
            }
        }
        tableIndex = tableIndex + 1
    }
    var status = 0
    var argument = 1
    while (argument < processArgumentCount()) {
        val wanted = processArgument(argument)
        argument = argument + 1
        if (wanted == "@entry") {
            println("@entry ${elf.entry}")
        } else if (wanted.startsWith(".")) {
            val index = elf.uniqueSection(wanted)
            if (index < 0) {
                eprintln("section $wanted is missing or not unique")
                status = 1
            } else {
                println("$wanted ${elf.sections[index].address}")
            }
        } else {
            var found = -1
            var at = 0
            while (at < names.size) {
                if (names[at] == wanted) found = at
                at = at + 1
            }
            if (found < 0) {
                eprintln("symbol $wanted is not defined")
                status = 1
            } else {
                println("$wanted ${values[found]} ${sizes[found]}")
            }
        }
    }
    status
}
