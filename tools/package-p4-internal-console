#!/usr/bin/env bash
# Offline only. Firmware remains pure Abla; esptool is a host-side packager.
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ $# -lt 4 || $# -gt 5 ]]; then
    echo 'usage: package-p4-internal-console 1|3 FLASH_MODE FLASH_FREQ FLASH_SIZE [console|tab5-control|tab5-panel|psram|tab5-video|tab5-pwm]' >&2
    echo 'Uses existing layout-specific ELF; requires python3 with esptool. Never flashes.' >&2
    exit 2
fi
case "$1" in
    1) min_rev=0; max_rev=299 ;;
    3) min_rev=300; max_rev=399 ;;
    *) echo 'unsupported P4 register layout' >&2; exit 2 ;;
esac
case "${5:-console}" in
    console) output_name=p4-internal-console ;;
    tab5-control) output_name=tab5-control-bringup ;;
    tab5-panel) output_name=tab5-panel-bringup ;;
    psram) output_name=p4-psram-bringup ;;
    tab5-video) output_name=tab5-video-bringup ;;
    tab5-pwm) output_name=tab5-pwm-bringup ;;
    *) echo 'unsupported application (console|tab5-control|tab5-panel|psram|tab5-video|tab5-pwm)' >&2; exit 2 ;;
esac
artifact="build/$output_name/layout-$1/application"
python3 -m esptool --chip esp32p4 elf2image \
    --min-rev-full "$min_rev" --max-rev-full "$max_rev" \
    --flash-mode "$2" --flash-freq "$3" --flash-size "$4" \
    --output "$artifact.bin" "$artifact.elf"
python3 tools/check-p4-console-image "$artifact.elf" "$artifact.bin" "$1"
echo 'Offline console probe only; not a complete application/bootloader. Hardware boot unverified.'
