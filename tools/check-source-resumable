# Fixtures that map their buffers with MAP_32BIT (classic-ESP32 32-bit
# addresses) run only where that flag exists: x86-64 Linux.
run_map32bit_fixture() {
    local fixture=$1 expected=$2 status
    if [[ $(uname -s) != Linux || $(uname -m) != x86_64 ]]; then
        echo "$fixture skipped: its MAP_32BIT fixture needs x86-64 Linux" >&2
        return 0
    fi
    set +e
    "$compiler_root/build/ablac" run "$project_root/tests/$fixture.ab"
    status=$?
    set -e
    test "$status" = "$expected"
}
# The fixtures reach Xtensa intrinsics, which only that target lowers. `build`
# lowers what the program reaches, about 3 GiB for all of src/esp32.ab within the
# compiler's 4 GiB cap; `--emit-llvm` checks every body, which takes over 5 GiB.
export ABLA_ESP_LLVM_ROOT=${ABLA_ESP_LLVM_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/abla-embedded/esp-clang-21.1.3}
emit_xtensa_llvm() {
    local source=$1 output=$2
    PATH="$project_root/tools/esp-llvm-bin:$PATH" "$compiler_root/build/ablac" build "$source" \
        --target-triple xtensa-esp-unknown-elf --object-format elf \
        --emit object -o "$output.o" --no-cache
    mv "$output.o.ll" "$output"
}
