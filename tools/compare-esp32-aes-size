#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cache=${XDG_CACHE_HOME:-$HOME/.cache}
llvm=${ABLA_ESP_LLVM_ROOT:-$cache/abla-embedded/esp-clang-21.1.3}
out=$root/build/benchmarks/esp32-aes
abla=$root/build/examples/radio-mac-registers/abla_aes.o
cpp=$out/reference.o
run=()
command -v steam-run >/dev/null && run=(steam-run)
[[ -f $abla ]] || "$root/tools/build-example" radio-mac-registers
mkdir -p "$out"
"${run[@]}" "$llvm/bin/clang" --target=xtensa-esp-elf -mcpu=esp32 -O2 \
    -fomit-frame-pointer -ffunction-sections -fdata-sections \
    -fno-unwind-tables -fno-asynchronous-unwind-tables -std=c++17 \
    -c "$root/benchmarks/aes-esp32-reference.cpp" -o "$cpp"

bytes() {
    "${run[@]}" "$llvm/bin/llvm-size" -A "$1" |
        awk -v t=".text.$2" -v l=".literal.$2" \
            '$1==t||$1==l{s+=$2}END{print s+0}'
}
abla_bytes=$(bytes "$abla" abla_esp32_aes128_encrypt_block)
cpp_bytes=$(bytes "$cpp" cxx_esp32_aes128_encrypt_block)
printf 'ESP32 AES-128 block: Abla %s bytes, C++ %s bytes\n' \
    "$abla_bytes" "$cpp_bytes"
(( abla_bytes <= cpp_bytes )) || exit 1

bin=$root/.platformio/packages/toolchain-xtensa-esp32/bin
if [[ -x $bin/xtensa-esp32-elf-objdump ]]; then
    instructions() {
        "${run[@]}" "$bin/xtensa-esp32-elf-objdump" \
            -d --disassemble="$2" "$1" |
            awk '/^[[:space:]]*[[:xdigit:]]+:/{n++}END{print n+0}'
    }
    abla_ins=$(instructions "$abla" abla_esp32_aes128_encrypt_block)
    cpp_ins=$(instructions "$cpp" cxx_esp32_aes128_encrypt_block)
    printf 'ESP32 AES-128 instructions: Abla %s, C++ %s\n' \
        "$abla_ins" "$cpp_ins"
    (( abla_ins <= cpp_ins )) || exit 1
    ! "${run[@]}" "$bin/xtensa-esp32-elf-nm" -u "$abla" | grep -q .
fi
echo 'ESP32 AES-128 block matches or beats C++ with no unresolved calls'
