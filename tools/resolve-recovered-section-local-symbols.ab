// Bind recovered section-only helpers across one monolithic Abla unit.
//
//     tools/abla-tool resolve-recovered-section-local-symbols LINK.ab [...] -- SOURCE.ab [...]

import "abla/io"
import "abla/text"
import "abla/regex"
import "abla/process/arguments"
import "lib/recovered.ab"

// `// Original section-local symbol: OLD` followed by `if (!internalFunction("..", "NEW"))`.
val sectionLocalPattern = regexCompile("""(?:^|\n)\s*// Original section-local symbol: (\S+)\n\s*if \(!internalFunction\("[^"]+", "([^"]+)"\)\)""")

class SectionLocalMappings(val olds: array<string>, val news: array<string>, val error: string)

// A physical Abla string ends an escaped assembler identifier immediately before the backslash of
// `\n`, so backslash is a separator here, not part of the linker-symbol alphabet.
fun sectionLocalReplace(source: string, old: string, new: string): Replaced =
    replaceBounded(source, old, new, ".$", ".$", "")

fun sectionLocalCollect(links: array<string>): SectionLocalMappings {
    val olds: array<string> = []
    val news: array<string> = []
    for (source in links) {
        for (found in sectionLocalPattern.regex.findAll(source)) {
            val old = found.group(1) ?? ""
            val new = found.group(2) ?? ""
            var at = -1
            var index = 0
            while (index < olds.size) {
                if (olds[index] == old) at = index
                index = index + 1
            }
            if (at >= 0) {
                if (news[at] != new) {
                    return SectionLocalMappings(olds, news, "conflicting local symbol mapping: ${old}")
                }
            } else {
                olds.append(old)
                news.append(new)
            }
        }
    }
    SectionLocalMappings(olds, news, "")
}

fun sectionLocalResolve(source: string, mappings: SectionLocalMappings): Replaced {
    var result = source
    var count = 0
    var index = 0
    while (index < mappings.olds.size) {
        val old = mappings.olds[index]
        val new = mappings.news[index]
        // Reconstructed Abla strings spell an assembler `$` as `\$\$`. Accept both that physical
        // source form and an unescaped symbol so the resolver is also useful for assembly fixtures.
        val escaped = old.replace("$", "\\$\\$")
        val first = sectionLocalReplace(result, escaped, new)
        result = first.text
        val second = sectionLocalReplace(result, old, new)
        result = second.text
        count = count + first.count + second.count
        index = index + 1
    }
    Replaced(result, count)
}

fun main: int {
    var separator = -1
    var index = 0
    while (index < processArgumentCount()) {
        if (processArgument(index) == "--" && separator < 0) separator = index
        index = index + 1
    }
    if (separator < 0) {
        eprintln("usage: resolve-recovered-section-local-symbols LINK.ab [...] -- SOURCE.ab [...]")
        return 2
    }
    val links: array<string> = []
    val sources: array<string> = []
    index = 0
    while (index < separator) {
        links.append(processArgument(index))
        index = index + 1
    }
    index = separator + 1
    while (index < processArgumentCount()) {
        sources.append(processArgument(index))
        index = index + 1
    }
    if (links.size == 0 || sources.size == 0) {
        eprintln("provide at least one link and source file")
        return 2
    }
    val linkTexts: array<string> = []
    for (path in links) {
        val read = recoveredRead(path)
        if (read.error != "") {
            eprintln(read.error)
            return 1
        }
        linkTexts.append(read.text)
    }
    val mappings = sectionLocalCollect(linkTexts)
    if (mappings.error != "") {
        eprintln("ValueError: ${mappings.error}")
        return 1
    }
    if (mappings.olds.size == 0) {
        eprintln("ValueError: link files contain no section-local mappings")
        return 1
    }
    var changed = 0
    for (path in sources) {
        val read = recoveredRead(path)
        if (read.error != "") {
            eprintln(read.error)
            return 1
        }
        val result = sectionLocalResolve(read.text, mappings)
        if (result.count > 0) {
            Path(path).writeText(result.text)
            changed = changed + result.count
            println("${pyPath(path)}: resolved ${result.count} section-local reference(s)")
        }
    }
    println("resolved ${changed} section-local reference(s)")
    0
}
