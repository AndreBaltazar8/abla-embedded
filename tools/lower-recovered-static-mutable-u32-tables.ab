// Lower startup-written native storage to mutable initialized u32 globals.
//
// The transformation is deliberately limited to exact word-sized objects whose
// initializer consists only of aligned, non-overlapping 32-bit stores of
// compile-time expressions. Missing words retain the zero value supplied by the
// original nativeStaticAllocate call. Recovered rodata is handled by the
// immutable-table lowering pass instead.
//
//     tools/abla-tool lower-recovered-static-mutable-u32-tables [--write] PATH...
import "abla/io"
import "lib/recovered-text.ab"
import "lib/static-storage.ab"

fun main: int {
    val args = rtParseArguments(["--write"], [])
    val usage = "lower-recovered-static-mutable-u32-tables [-h] [--write] paths [paths ...]"
    if (args.help) {
        println(usage)
        return 0
    }
    if (args.error != "") return rtUsageError("lower-recovered-static-mutable-u32-tables", usage, args.error)
    if (args.positionals.size == 0) {
        return rtUsageError("lower-recovered-static-mutable-u32-tables", usage, "the following arguments are required: paths")
    }
    val write = args.has("--write")
    var changedFiles = 0
    var tables = 0
    var words = 0
    for (path in rtSourceFiles(args.positionals, false, false)) {
        val original = rtRead(path)
        if (original.error != "") {
            eprintln(original.error)
            return 1
        }
        val lowered = ssLowerU32(original.text, false)
        if (lowered.text == original.text) continue
        changedFiles += 1
        tables += lowered.count
        words += lowered.units
        if (write) {
            val error = rtWrite(path, lowered.text)
            if (error != "") {
                eprintln(error)
                return 1
            }
        }
    }
    val action = if (write) "lowered" else "would lower"
    println("${action} ${tables} mutable u32 table(s) with ${words} link-time word(s) in ${changedFiles} file(s)")
    0
}
