#!/usr/bin/env bash
set -euo pipefail
if [[ $# != 1 ]]; then echo 'usage: bash tools/check-paper-s3-sleep-link PLACED_CYCLE.o' >&2; exit 2; fi
project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
toolchain_root=${ABLA_ESP_LLVM_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/abla-embedded/esp-clang-21.1.3}
runner=()
if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi
object=$(realpath -- "$1")
cd "$project_root"
python3 tools/check-cache-internal-relocations "$object"
mkdir -p build/tests
artifact=build/tests/paper-s3-sleep-link
"${runner[@]}" "$toolchain_root/bin/xtensa-esp32s3-elf-clang-ld" \
    -T tests/paper-s3-sleep-cycle.ld --no-undefined \
    -Map="$artifact.map" -o "$artifact.elf" "$object"
undefined=$("${runner[@]}" "$toolchain_root/bin/llvm-nm" -u "$artifact.elf")
test -z "$undefined"
python3 tools/check-paper-s3-sleep-layout "$artifact.elf"
"${runner[@]}" "$toolchain_root/bin/llvm-size" -A "$artifact.elf"
echo 'PASS: link-only PaperS3 lifecycle, disjoint SRAM with reserved buffers/stacks; NOT bootable/flashable or stack-depth proof'
