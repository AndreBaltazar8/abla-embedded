#!/usr/bin/env bash
set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
compiler_root=${ABLA_COMPILER_ROOT:-$project_root/../ablac}
mkdir -p "$project_root/build/tests"
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/tests/package-import.ab" \
    >"$project_root/build/tests/package-import.ll"
grep -Fq 'define i32 @main' "$project_root/build/tests/package-import.ll"
grep -Eq '@abla\.static\.allocation(\.[0-9]+)? = internal global \[8 x i8\] zeroinitializer' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @i2s_channel_read(ptr, ptr, i32, ptr, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @i2s_channel_write(ptr, ptr, i32, ptr, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @i2c_master_transmit(ptr, ptr, i32, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @i2c_master_transmit_receive(ptr, ptr, i32, ptr, i32, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @spi_bus_initialize(i32, ptr, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @spi_device_transmit(ptr, ptr)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @spi_device_acquire_bus(ptr, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare void @spi_device_release_bus(ptr)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @nvs_open(ptr, i32, ptr)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @nvs_set_i32(i32, ptr, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @nvs_get_i32(i32, ptr, ptr)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @nvs_commit(i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @rmt_new_tx_channel(ptr, ptr)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @rmt_transmit(ptr, ptr, ptr, i32, ptr)' \
    "$project_root/build/tests/package-import.ll"
if grep -Eq 'declare i32 @i2s_channel_(read|write)\(ptr, ptr, i64' \
    "$project_root/build/tests/package-import.ll"; then
    echo 'ESP-IDF I2S size_t widened to i64' >&2
    exit 1
fi
if grep -Fq 'declare i32 @rmt_transmit(ptr, ptr, ptr, i64, ptr)' \
    "$project_root/build/tests/package-import.ll"; then
    echo 'ESP-IDF RMT size_t widened to i64' >&2
    exit 1
fi
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/tests/i2s-legacy-import.ab" \
    >"$project_root/build/tests/i2s-legacy-import.ll"
grep -Fq 'declare i32 @i2s_read(i32, ptr, i32, ptr, i32)' \
    "$project_root/build/tests/i2s-legacy-import.ll"
grep -Fq 'declare i32 @i2s_write(i32, ptr, i32, ptr, i32)' \
    "$project_root/build/tests/i2s-legacy-import.ll"
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/tests/m5stack-import.ab" \
    >"$project_root/build/tests/m5stack-import.ll"
grep -Fq 'define i32 @main' "$project_root/build/tests/m5stack-import.ll"
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/examples/board-detect-s3/main.ab" \
    >"$project_root/build/tests/board-detect-s3.ll"
grep -Fq 'declare i32 @gpio_get_io_config(i32, ptr)' \
    "$project_root/build/tests/board-detect-s3.ll"
grep -Fq 'declare i32 @gpio_set_direction(i32, i32)' \
    "$project_root/build/tests/board-detect-s3.ll"
grep -Fq 'declare i32 @gpio_set_pull_mode(i32, i32)' \
    "$project_root/build/tests/board-detect-s3.ll"
grep -Fq 'declare i32 @gpio_set_level(i32, i32)' \
    "$project_root/build/tests/board-detect-s3.ll"
grep -Fq 'declare i32 @gpio_get_level(i32)' \
    "$project_root/build/tests/board-detect-s3.ll"
grep -Fq 'declare void @esp_rom_delay_us(i32)' \
    "$project_root/build/tests/board-detect-s3.ll"
grep -Fq 'load volatile i32' \
    "$project_root/build/tests/board-detect-s3.ll"
if grep -Eq 'declare .*@i2c_' \
    "$project_root/build/tests/board-detect-s3.ll"; then
    echo 'S3 detector unexpectedly retained the ESP-IDF I2C driver ABI' >&2
    exit 1
fi
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/examples/blink/main.ab" \
    >"$project_root/build/tests/blink.ll"
grep -Fq 'load volatile i32' "$project_root/build/tests/blink.ll"
grep -Fq 'store volatile i32' "$project_root/build/tests/blink.ll"
if grep -Fq 'declare i32 @gpio_set_direction' \
    "$project_root/build/tests/blink.ll"; then
    echo 'classic ESP32 GPIO unexpectedly retained gpio_set_direction' >&2
    exit 1
fi
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/tests/radio-mac-codegen.ab" \
    >"$project_root/build/tests/radio-mac-codegen.ll"
grep -Fq 'load volatile i32' \
    "$project_root/build/tests/radio-mac-codegen.ll"
grep -Fq 'store volatile i32' \
    "$project_root/build/tests/radio-mac-codegen.ll"
if grep -Eq 'declare .*@(esp_wifi|wifi_|phy_|hal_)' \
    "$project_root/build/tests/radio-mac-codegen.ll"; then
    echo 'native MAC slice unexpectedly retained a vendor radio ABI' >&2
    exit 1
fi
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/tests/dma-descriptor-codegen.ab" \
    >"$project_root/build/tests/dma-descriptor-codegen.ll"
grep -Fq 'store volatile i32' \
    "$project_root/build/tests/dma-descriptor-codegen.ll"
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/tests/radio-power-codegen.ab" \
    >"$project_root/build/tests/radio-power-codegen.ll"
grep -Fq 'load volatile i32' \
    "$project_root/build/tests/radio-power-codegen.ll"
grep -Fq 'store volatile i32' \
    "$project_root/build/tests/radio-power-codegen.ll"
set +e
"$compiler_root/build/ablac" run "$project_root/tests/button-state.ab"
button_status=$?
set -e
test "$button_status" = 42
set +e
"$compiler_root/build/ablac" run "$project_root/tests/i2s-sample-order.ab"
i2s_order_status=$?
set -e
test "$i2s_order_status" = 43
set +e
"$compiler_root/build/ablac" run "$project_root/tests/pcf8563-logic.ab"
rtc_status=$?
set -e
test "$rtc_status" = 44
set +e
"$compiler_root/build/ablac" run "$project_root/tests/io-expander-logic.ab"
io_expander_status=$?
set -e
test "$io_expander_status" = 45
set +e
"$compiler_root/build/ablac" run "$project_root/tests/m5stack-board-registry.ab"
board_registry_status=$?
set -e
test "$board_registry_status" = 46
set +e
"$compiler_root/build/ablac" run "$project_root/tests/rx8130-logic.ab"
rx8130_status=$?
set -e
test "$rx8130_status" = 47
set +e
"$compiler_root/build/ablac" run "$project_root/tests/powerhub-rtc-logic.ab"
powerhub_rtc_status=$?
set -e
test "$powerhub_rtc_status" = 48
set +e
"$compiler_root/build/ablac" run "$project_root/tests/imu-logic.ab"
imu_status=$?
set -e
test "$imu_status" = 49
set +e
"$compiler_root/build/ablac" run "$project_root/tests/m5stack-pin-map.ab"
pin_map_status=$?
set -e
test "$pin_map_status" = 50
set +e
"$compiler_root/build/ablac" run "$project_root/tests/sd-spi-logic.ab"
sd_spi_status=$?
set -e
test "$sd_spi_status" = 51
set +e
"$compiler_root/build/ablac" run "$project_root/tests/ina-power-logic.ab"
ina_power_status=$?
set -e
test "$ina_power_status" = 52
set +e
"$compiler_root/build/ablac" run "$project_root/tests/axp192-logic.ab"
axp192_status=$?
set -e
test "$axp192_status" = 53
set +e
"$compiler_root/build/ablac" run "$project_root/tests/axp2101-logic.ab"
axp2101_status=$?
set -e
test "$axp2101_status" = 54
set +e
"$compiler_root/build/ablac" run "$project_root/tests/charger-logic.ab"
charger_status=$?
set -e
test "$charger_status" = 55
set +e
"$compiler_root/build/ablac" run "$project_root/tests/bq27220-logic.ab"
bq27220_status=$?
set -e
test "$bq27220_status" = 56
set +e
"$compiler_root/build/ablac" run "$project_root/tests/m5pm1-logic.ab"
m5pm1_status=$?
set -e
test "$m5pm1_status" = 57
set +e
"$compiler_root/build/ablac" run "$project_root/tests/led-logic.ab"
led_status=$?
set -e
test "$led_status" = 58
set +e
"$compiler_root/build/ablac" run "$project_root/tests/rmt-led-logic.ab"
rmt_led_status=$?
set -e
test "$rmt_led_status" = 59
set +e
"$compiler_root/build/ablac" run "$project_root/tests/m5stack-button-map.ab"
m5stack_button_status=$?
set -e
test "$m5stack_button_status" = 60
set +e
"$compiler_root/build/ablac" run "$project_root/tests/m5stack-detect-logic.ab"
m5stack_detect_status=$?
set -e
test "$m5stack_detect_status" = 61
set +e
"$compiler_root/build/ablac" run "$project_root/tests/imu-offsets-logic.ab"
imu_offsets_status=$?
set -e
test "$imu_offsets_status" = 62
set +e
"$compiler_root/build/ablac" run "$project_root/tests/imu-calibration-logic.ab"
imu_calibration_status=$?
set -e
test "$imu_calibration_status" = 63
set +e
"$compiler_root/build/ablac" run "$project_root/tests/gpio-probe-logic.ab"
gpio_probe_status=$?
set -e
test "$gpio_probe_status" = 64
set +e
"$compiler_root/build/ablac" run "$project_root/tests/register-logic.ab"
register_logic_status=$?
set -e
test "$register_logic_status" = 65
set +e
"$compiler_root/build/ablac" run "$project_root/tests/radio-mac-logic.ab"
radio_mac_status=$?
set -e
test "$radio_mac_status" = 66
set +e
"$compiler_root/build/ablac" run "$project_root/tests/dma-descriptor-logic.ab"
dma_descriptor_status=$?
set -e
test "$dma_descriptor_status" = 67
set +e
"$compiler_root/build/ablac" run "$project_root/tests/radio-power-logic.ab"
radio_power_status=$?
set -e
test "$radio_power_status" = 68
echo 'package entry, typed MMIO/DMA handles and native ESP DMA descriptors, native classic ESP32 GPIO and opt-in Wi-Fi power/clock/reset/MAC registers, exact I2C/SPI/I2S/RMT/NVS ABIs, audio order, RTC/IO-expander/IMU calibration/INA/AXP192/AXP2101/IP5306/AW32001/BQ27220/M5PM1/LED/SDSPI logic, complete M5Stack pin/button maps, board registry/detection decisions, and shared ESP32 API compile passed'
