#!/usr/bin/env bash
set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
compiler_root=${ABLA_COMPILER_ROOT:-$project_root/../ablac}
mkdir -p "$project_root/build/tests"
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/tests/package-import.ab" \
    >"$project_root/build/tests/package-import.ll"
grep -Fq 'define i32 @main' "$project_root/build/tests/package-import.ll"
grep -Eq '@abla\.static\.allocation(\.[0-9]+)? = internal global \[8 x i8\] zeroinitializer' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @i2s_channel_read(ptr, ptr, i32, ptr, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @i2s_channel_write(ptr, ptr, i32, ptr, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @i2c_master_transmit(ptr, ptr, i32, i32)' \
    "$project_root/build/tests/package-import.ll"
grep -Fq 'declare i32 @i2c_master_transmit_receive(ptr, ptr, i32, ptr, i32, i32)' \
    "$project_root/build/tests/package-import.ll"
if grep -Eq 'declare i32 @i2s_channel_(read|write)\(ptr, ptr, i64' \
    "$project_root/build/tests/package-import.ll"; then
    echo 'ESP-IDF I2S size_t widened to i64' >&2
    exit 1
fi
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/tests/i2s-legacy-import.ab" \
    >"$project_root/build/tests/i2s-legacy-import.ll"
grep -Fq 'declare i32 @i2s_read(i32, ptr, i32, ptr, i32)' \
    "$project_root/build/tests/i2s-legacy-import.ll"
grep -Fq 'declare i32 @i2s_write(i32, ptr, i32, ptr, i32)' \
    "$project_root/build/tests/i2s-legacy-import.ll"
"$compiler_root/build/ablac" --emit-llvm \
    "$project_root/tests/m5stack-import.ab" \
    >"$project_root/build/tests/m5stack-import.ll"
grep -Fq 'define i32 @main' "$project_root/build/tests/m5stack-import.ll"
set +e
"$compiler_root/build/ablac" run "$project_root/tests/button-state.ab"
button_status=$?
set -e
test "$button_status" = 42
echo 'package entry, exact I2S ABIs, and shared ESP32 API compile passed'
