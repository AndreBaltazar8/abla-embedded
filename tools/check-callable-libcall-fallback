#!/usr/bin/env bash
set -euo pipefail

# An RV32 callable example whose 64-bit shifts (by a variable amount) or division (by a
# constant) become compiler-runtime calls under minsize is generated again without minsize
# and then has no undefined symbols (tools/build-callable-example). With the fallback turned
# off the same example must fail with exactly those libcalls: the negative control.
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$project_root"
export ABLA_COMPILER_ROOT=${ABLA_COMPILER_ROOT:-$project_root/../ablac}
examples=(esp32c5-spi-master esp32c5-wake-pad corematrix-tone-controls)
libcalls=(__lshrdi3 __lshrdi3 __udivdi3)
for index in "${!examples[@]}"; do
  example=${examples[$index]}
  libcall=${libcalls[$index]}
  output=$(bash tools/build-callable-example "$example" 2>&1) ||
    { echo "$example failed with the fallback on:" >&2; echo "$output" >&2; exit 1; }
  grep -q "^NOTE: $example needs 64-bit compiler-runtime calls under minsize" <<<"$output" ||
    { echo "$example did not need the fallback any more; pick another example" >&2; exit 1; }
  grep -q '^PASS: .*zero undefined symbols' <<<"$output" ||
    { echo "$example: no PASS line" >&2; echo "$output" >&2; exit 1; }
  set +e
  control=$(ABLA_CALLABLE_NO_LIBCALL_FALLBACK=1 bash tools/build-callable-example "$example" 2>&1)
  status=$?
  set -e
  [[ $status != 0 ]] && grep -q "U $libcall" <<<"$control" ||
    { echo "$example: without the fallback it should fail on $libcall (status $status):" >&2
      echo "$control" >&2; exit 1; }
done
echo "callable libcall fallback: three RV32 examples link without minsize, and fail on their libcalls with it off"
