#!/usr/bin/env python3
"""Model emitted context code from a target object using GNU objdump.

Window spill is an explicitly checked primitive, not a simulated processor:
validate its instruction sequence, preconditions and preserved live registers.
Physical window exceptions, nesting and coprocessors remain unverified.
"""
import re
import sys
import os
import shutil
import struct
import subprocess
from pathlib import Path

data = Path(sys.argv[1]).read_bytes()
assert data[:6] == b'\x7fELF\x01\x01'
table = struct.unpack_from('<I',data,32)[0]
stride,count,names_index = struct.unpack_from('<HHH',data,46)
assert stride == 40 and names_index < count
headers = [struct.unpack_from('<10I',data,table+i*40) for i in range(count)]
names_header = headers[names_index]
names = data[names_header[4]:names_header[4]+names_header[5]]
save_header = next(s for s in headers if names[s[0]:].split(b'\0',1)[0] == b'.iram1.abla.s3ContextSave')
assert data[save_header[4]:save_header[4]+4] == bytes.fromhex('20000400'), 'incorrect spill PS literal'
objdump = os.environ.get('ABLA_ESP_S3_OBJDUMP') or shutil.which('xtensa-esp32s3-elf-objdump') or str(Path.home()/'.platformio/packages/toolchain-xtensa-esp32s3/xtensa-esp32s3-elf/bin/objdump')
runner = ['steam-run'] if shutil.which('steam-run') else []
listing = subprocess.check_output(runner+[objdump,'-d','-j','.iram1.abla.s3ContextSave','-j','.iram1.abla.s3ContextRestore',sys.argv[1]],text=True)

sections = {}
current = None
for line in listing.splitlines():
    match = re.match(r'Disassembly of section (.*):', line)
    if match:
        current = match[1]
        sections[current] = []
    match = re.match(r'\s*([0-9a-f]+):\s+[0-9a-f]{4,6}\s+([a-z][a-z0-9.]*)\s*(.*)', line)
    if match and current:
        operands = match[3].split('<')[0].strip().replace(' ', '')
        sections[current].append((int(match[1],16), match[2].removesuffix('.n'), operands.split(',') if operands else []))

save = sections['.iram1.abla.s3ContextSave']
restore = sections['.iram1.abla.s3ContextRestore']
extra = ['threadptr','acclo','acchi','br','scompare1','m0','m1','m2','m3']
fields = {'sar':76,'lbeg':88,'lend':92,'lcount':96, **{name:112+i*4 for i,name in enumerate(extra)}}

for seed in range(64):
    original = [0xABC00000+seed*256+i for i in range(16)]
    frame = 0x1000
    original[1] = frame+192
    regs = original[:]
    regs[0], regs[1], regs[12], regs[13] = 0x40379000, frame, 0x12345678, 0x87654321
    incoming = regs[:]
    specials = {name:0x10203000+seed*32+i for i,name in enumerate(fields)}
    specials.update(ps=0x40030 | (seed & 15), epc1=0x42000000+seed*4)
    saved_specials = specials.copy()
    memory = {frame+12+i*4:original[i] for i in (0,1,12,13)}
    written = set()
    spilled = False

    def execute(code, saving):
        global spilled
        addresses = {pc:i for i,(pc,_,_) in enumerate(code)}
        i = 0
        while i < len(code):
            _, op, args = code[i]
            i += 1
            def r(arg): return regs[int(arg[1:])]
            def put(arg, value): regs[int(arg[1:])] = value & 0xFFFFFFFF
            if op == 'and' and args == ['a12','a12','a12']:
                assert saving and not spilled
                expected = [('and',['a12','a12','a12']),('rotw',['3'])]*4 + [('and',['a12','a12','a12']),('rotw',['4'])]
                assert [(o,a) for _,o,a in code[i-1:i+9]] == expected
                assert regs[1] == original[1] and regs[4:] == original[4:], 'live ancestor registers clobbered before spill'
                assert specials['ps'] == 0x40020 | max(saved_specials['ps'] & 15,3), 'unsafe spill PS'
                # Model the specified spill primitive preserving registers but
                # changing EPC1 through its nested window exception.
                specials['epc1'] = 0xDEADBEEC
                spilled = True
                i += 9
            elif op == 's32i':
                address = r(args[1])+int(args[2],0)
                assert frame <= address < frame+148
                memory[address] = r(args[0]); written.add(address)
            elif op == 'l32i': put(args[0],memory[r(args[1])+int(args[2],0)])
            elif op.startswith(('rsr.','rur.')): put(args[0],specials[op.split('.')[1]])
            elif op.startswith(('wsr.','wur.')): specials[op.split('.')[1]] = r(args[0])
            elif op == 'movi': put(args[0],int(args[1],0))
            elif op == 'l32r':
                # Only literal in this leaf: PS_UM|PS_WOE, at section0.
                # Its actual bytes were checked in the ELF above.
                assert args == ['a0','0']; put('a0',0x40020)
            elif op in ('addi','addmi'): put(args[0],r(args[1])+int(args[2],0))
            elif op == 'and': put(args[0],r(args[1]) & r(args[2]))
            elif op == 'or': put(args[0],r(args[1]) | r(args[2]))
            elif op == 'bgeui':
                if r(args[0]) >= int(args[1],0): i=addresses[int(args[2],16)]
            elif op == 'rsync': pass
            elif op == 'ret':
                assert i == len(code), 'instructions after CALL0 return'
                return
            else: raise AssertionError(f'unexpected instruction {op} {args}')
        raise AssertionError('missing CALL0 return')

    execute(save, True)
    assert spilled and specials == saved_specials
    assert all(regs[i] == incoming[i] for i in (0,1,12,13))
    for i in range(2,16): assert memory[frame+12+i*4] == original[i]
    for name, offset in fields.items(): assert memory[frame+offset] == saved_specials[name]
    assert written == {frame+12+i*4 for i in range(2,16) if i not in (12,13)} | {frame+x for x in fields.values()} | {frame+100,frame+104,frame+108}
    regs = [0xDEAD0000+i for i in range(16)]
    regs[0],regs[1] = 0x4037A000,frame
    for name in fields: specials[name] = 0
    execute(restore, False)
    assert regs[2:] == original[2:] and regs[:2] == [0x4037A000,frame]
    assert specials == saved_specials
print('PASS:64 emitted context save/restore profiles; spill primitive checked, not hardware simulated')
