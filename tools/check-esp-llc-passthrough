#!/usr/bin/env bash
# esp-llvm-bin/llc compiles for the selected ESP CPU, and hands code for any
# other architecture (a host build driver built with it on PATH) to llc
# unchanged. Needs the ablac shell's LLVM (llc, llvm-as, llvm-readelf).
set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
out="$project_root/build/tests/esp-llc-passthrough"
mkdir -p "$out"
wrapper="$project_root/tools/esp-llvm-bin/llc"

module() { # triple file
    cat > "$2" <<EOF
target triple = "$1"

define i32 @answer(i32 %x) {
  %y = add i32 %x, 42
  ret i32 %y
}
EOF
}

machine() { # object
    llvm-readelf -h "$1" | sed -n 's/^ *Machine: *//p'
}

expect() { # cpu input expected-machine [llc arguments...]
    local cpu=$1 input=$2 expected=$3 object
    shift 3
    object="$out/$(basename "$input").$cpu.o"
    rm -f "$object"
    ABLA_ESP_CPU=$cpu "$wrapper" -filetype=obj -relocation-model=pic "$@" "$input" -o "$object"
    local found
    found=$(machine "$object")
    if [[ $found != *"$expected"* ]]; then
        echo "check-esp-llc-passthrough: $cpu, $(basename "$input") $*: expected $expected, got $found" >&2
        exit 1
    fi
}

module x86_64-unknown-linux-gnu "$out/host.ll"
llvm-as "$out/host.ll" -o "$out/host.bc"
module xtensa-esp-unknown-elf "$out/xtensa.ll"
module riscv32-unknown-elf "$out/riscv.ll"

# Another architecture than the CPU's: as llc would, from text, bitcode or -mtriple.
expect esp32s3 "$out/host.ll" X86-64
expect esp32s3 "$out/host.bc" X86-64
expect esp32 "$out/host.ll" X86-64
expect esp32c3 "$out/host.ll" X86-64
expect esp32s3 "$out/riscv.ll" RISC-V
expect esp32s3 "$out/xtensa.ll" X86-64 -mtriple=x86_64-unknown-linux-gnu
# The CPU's own architecture still gets its flags and assembly passes.
expect esp32s3 "$out/xtensa.ll" Xtensa
expect esp32c3 "$out/riscv.ll" RISC-V

echo "esp-llvm-bin/llc: other architectures pass through; Xtensa and RISC-V still compile for the CPU"
