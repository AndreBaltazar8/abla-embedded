#!/usr/bin/env bash
# Run in the pinned Abla Nix shell. Native fault models, never device tests.
set -euo pipefail
cd "$(dirname "$0")/.."
export ABLA_SYSROOT="${ABLA_SYSROOT:-../ablac}"
mkdir -p build/tests
for fixture in ledc-p4-native ledc-clock-p4-native ledc-channel-p4-native ledc-pins-p4-native tab5-pwm-native; do
    case "$fixture" in
        ledc-p4-native) entry=abla_ledc_p4_test ;;
        ledc-clock-p4-native) entry=abla_ledc_clock_p4_test ;;
        ledc-channel-p4-native) entry=abla_ledc_channel_p4_test ;;
        ledc-pins-p4-native) entry=abla_ledc_pins_p4_test ;;
        tab5-pwm-native) entry=abla_tab5_pwm_test ;;
    esac
    artifact="build/tests/$fixture"
    ../ablac/build/ablac build "tests/$fixture.ab" -o "$artifact.o" \
        --target-triple x86_64-unknown-linux-gnu --object-format elf --emit object
    bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
    llc -filetype=obj -O2 -relocation-model=static "$artifact.bc" -o "$artifact.opt.o"
    cc -no-pie "-Wl,--defsym,main=$entry" "$artifact.opt.o" -o "$artifact"
    "$artifact"
    echo "PASS $fixture (native fault model, not hardware proof)"
done
