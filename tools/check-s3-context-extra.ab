// Check emitted CALL0 extra-context leaves against the S3 register map.
//
// Checks every instruction byte, register, offset and return convention. This
// does not simulate hardware or prove integration with the exception frame.
//
//     tools/abla-tool check-s3-context-extra OBJECT.o

import "abla/io"
import "abla/text"
import "abla/process/arguments"
import "lib/xtensa-check.ab"
import "./lib/elf.ab"

fun checkContextExtra(data: string): string {
    val elf = elf32Parse(data)
    if (elf.error != "") return elf.error
    // S3 tie-asm.h full NCP layout: THREADPTR(user231), ACCLO16, ACCHI17,
    // BR4, SCOMPARE1(12), M0..3(32..35), all saved consecutively as nine u32s.
    val special = [-1, 16, 17, 4, 12, 32, 33, 34, 35]
    for (restore in [false, true]) {
        val name = ".iram1.abla.s3ContextExtra" + (if (restore) "Restore" else "Save")
        if (elfSectionCount(elf, name) != 1) return "missing/duplicate context leaf"
        val code = elf.sectionBytes(elf.sections[elf.sectionIndex(name)])
        var expected = ""
        var slot = 0
        while (slot < special.size) {
            val register = special[slot]
            // Narrow L32I/S32I: a3, base a2, offset slot*4.
            val memory = elfByte(if (restore) 0x38 else 0x39) + elfByte((slot << 4) | 2)
            val access = if (register < 0) {
                if (restore) elfHex("30e7f3") else elfHex("703ee3")
            } else {
                byteCodes3(0x30, register, if (restore) 0x13 else 3)
            }
            expected = expected + (if (restore) memory + access else access + memory)
            slot = slot + 1
        }
        if (restore) expected = expected + elfHex("102000") // RSYNC before return
        expected = expected + elfHex("0df0") // RET.N, never RETW
        if (code != expected) return "$name: context encoding/prologue/layout mismatch"
    }
    ""
}

fun main: int {
    if (processArgumentCount() != 1) {
        eprintln("usage: check-s3-context-extra OBJECT.o")
        return 2
    }
    val file = readBinaryFile(processArgument(0))
    if (file.error != "") {
        eprintln(file.error)
        return 1
    }
    val error = checkContextExtra(file.data)
    if (error != "") {
        eprintln(error)
        return 1
    }
    println("PASS: nine S3 extra registers,36-byte layout,CALL0 returns; no hardware proof")
    0
}
