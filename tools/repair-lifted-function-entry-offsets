#!/usr/bin/env python3
"""Remove verified Xtensa literal-pool entry offsets from lifted Abla pointers."""

from __future__ import annotations

import argparse
import pathlib
import re


ENTRY_OFFSETS = {
    "esp32Internal_Labla_recovered_hostap_local_text_is_esp_manufacturer_oui_5020e43800": 4,
    "esp32Internal_Labla_recovered_hostap_local_text_is_non_esp_oui_c4fef6d91d": 8,
    "esp32Internal_Labla_recovered_hostap_local_text_clear_mac_queue_8b362539fc": 28,
    "esp32Internal_Labla_recovered_timer_local_text_ieee80211_hostap_handle_47b011f7c1": 20,
    "esp32Internal_Labla_recovered_timer_local_text_ieee80211_send_beacon_4697c14d4c": 20,
    "esp32Internal_Labla_recovered_nan_common_local_text_nan_is_pkt_in_valid_slot_8eb8856e97": 8,
    "esp32RecoveredTextMtSetLmk": 64,
    "esp32RecoveredTextMtClearLmk": 8,
    "esp32RecoveredTextMtCopyPeer": 36,
    "esp32RecoveredTextMtSendCb": 28,
    "esp32RecoveredTextMtRecvCb": 4,
    "esp32RecoveredTextMtGetLmk": 20,
    "esp32RecoveredTextMtGetKeyIdxConstprop0": 24,
    "esp32RecoveredTextEspMeshSetIeConstprop0Isra0": 16,
    "esp32RecoveredTextEspMeshClearParentConstprop0Isra0": 8,
    "esp32RecoveredTextEspMeshClearParentPart0": 84,
    "esp32RecoveredTextMeshNwkFindConflictRootsPart0": 4,
    "esp32RecoveredTextWifiVndExtMeshRootsFreePart0": 12,
    "esp32RecoveredTextMeshRootsProcessFixedPart0": 12,
}

ADDRESS = re.compile(
    r"^(?P<indent>\s*)(?P<register>\w+) = u32\(nativeFunctionAddress\((?P<function>[^)]+)\)\)\s*$"
)
OFFSET = re.compile(
    r"^\s*(?P<register>\w+) = (?P=register) \+ u32\((?P<offset>\d+)\)\s*$"
)


def repair(path: pathlib.Path, write: bool) -> int:
    lines = path.read_text().splitlines(keepends=True)
    output: list[str] = []
    changes = 0
    index = 0
    while index < len(lines):
        output.append(lines[index])
        address = ADDRESS.match(lines[index].rstrip("\r\n"))
        if address and index + 1 < len(lines):
            offset = OFFSET.match(lines[index + 1].rstrip("\r\n"))
            expected = ENTRY_OFFSETS.get(address.group("function"))
            if (
                offset
                and offset.group("register") == address.group("register")
                and expected == int(offset.group("offset"))
            ):
                changes += 1
                index += 1
        index += 1
    if write and changes:
        path.write_text("".join(output))
    return changes


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--write", action="store_true")
    parser.add_argument("root", nargs="?", default="src/esp32")
    args = parser.parse_args()
    root = pathlib.Path(args.root)
    total = 0
    for path in sorted(root.rglob("*.ab")):
        changes = repair(path, args.write)
        if changes:
            print(f"{path}: {changes}")
            total += changes
    print(f"total: {total}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
