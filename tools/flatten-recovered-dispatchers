#!/usr/bin/env python3
"""Flatten generated program-counter if ladders into Abla when expressions."""

from __future__ import annotations

import argparse
import pathlib
import re
import sys


START = re.compile(r"^(?P<indent>\s*)if \(programCounter == (?P<arm>[0-9]+)\) \{$")
NEXT = re.compile(r"^(?P<indent>\s*)else if \(programCounter == (?P<arm>[0-9]+)\) \{$")


def transform(source: str, path: pathlib.Path) -> tuple[str, int, int]:
    output: list[str] = []
    active_indent: str | None = None
    dispatchers = 0
    arms = 0

    for line_number, line in enumerate(source.splitlines(keepends=True), 1):
        text = line.removesuffix("\n")
        newline = "\n" if line.endswith("\n") else ""
        if active_indent is None:
            match = START.fullmatch(text)
            if match is None:
                output.append(line)
                continue
            active_indent = match.group("indent")
            arm = match.group("arm")
            output.append(f"{active_indent}when (programCounter) {{{newline}")
            output.append(f"{active_indent}    {arm} -> {{{newline}")
            dispatchers += 1
            arms += 1
            continue

        next_match = NEXT.fullmatch(text)
        if next_match is not None and next_match.group("indent") == active_indent:
            output.append(
                f"{active_indent}    {next_match.group('arm')} -> {{{newline}"
            )
            arms += 1
            continue

        if text == f"{active_indent}else ablaRuntimeTrap()":
            output.append(f"{active_indent}    else -> ablaRuntimeTrap(){newline}")
            output.append(f"{active_indent}}}{newline}")
            active_indent = None
            continue

        output.append(line)

    if active_indent is not None:
        raise ValueError(f"{path}: unterminated recovered dispatcher")
    return "".join(output), dispatchers, arms


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="+", type=pathlib.Path)
    parser.add_argument("--write", action="store_true")
    arguments = parser.parse_args()

    files: list[pathlib.Path] = []
    for path in arguments.paths:
        if path.is_dir():
            files.extend(sorted(path.rglob("*.ab")))
        elif path.suffix == ".ab":
            files.append(path)

    total_dispatchers = 0
    total_arms = 0
    changed = 0
    for path in files:
        source = path.read_text()
        transformed, dispatchers, arms = transform(source, path)
        total_dispatchers += dispatchers
        total_arms += arms
        if transformed != source:
            changed += 1
            if arguments.write:
                path.write_text(transformed)

    action = "rewrote" if arguments.write else "would rewrite"
    print(
        f"{action} {changed} file(s), {total_dispatchers} dispatcher(s), "
        f"{total_arms} arm(s)"
    )
    if not arguments.write and changed:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
