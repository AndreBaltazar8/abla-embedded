// Line-level readers for textual LLVM IR (the output of `llvm-dis`), shared by the
// retained-path checks in tools/. Everything is a plain function over the text;
// nothing panics on odd input, a construct that is not recognised is skipped.

import "abla/text"
import "abla/process/command"

class IrDisassembly(val text: string, val error: string)

// `llvm-dis PATH -o -` (a failure carries the tool's exit status).
fun irDisassemble(path: string): IrDisassembly {
    val result = command("llvm-dis").argument(path).argument("-o").argument("-").capture()
    if (result.status != 0) return IrDisassembly("", "llvm-dis $path failed with status ${result.status}")
    IrDisassembly(result.output, "")
}

fun irIsNameChar(c: int): bool =
    (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 46 || c == 36

fun irIsDigit(c: int): bool = c >= 48 && c <= 57

// The run of [\w.$] characters of `text` starting at `from` ("" when there is none).
fun irNameAt(text: string, from: int): string {
    var end = from
    while (end < text.size && irIsNameChar(text[end])) end = end + 1
    text.slice(from, end)
}

// [A-Za-z0-9_]: the characters of a regular-expression word.
fun irIsWordChar(c: int): bool =
    (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95

// The first position at or after `from` where `word` stands as a whole word, or -1.
fun irWordAt(text: string, word: string, from: int): int {
    var at = text.indexOf(word, from)
    while (at >= 0) {
        val before = at > 0 && irIsWordChar(text[at - 1])
        val after = at + word.size < text.size && irIsWordChar(text[at + word.size])
        if (!before && !after) return at
        at = text.indexOf(word, at + 1)
    }
    -1
}

// The run of digits of `text` starting at `from`.
fun irDigitsAt(text: string, from: int): string {
    var end = from
    while (end < text.size && irIsDigit(text[end])) end = end + 1
    text.slice(from, end)
}

// Every `@name` of the text, in order (re.findall(r"@([\w.$]+)")).
fun irReferences(text: string): array<string> {
    val names: array<string> = []
    var at = text.indexOf("@")
    while (at >= 0) {
        val name = irNameAt(text, at + 1)
        if (name.size > 0) names.append(name)
        at = text.indexOf("@", at + 1 + name.size)
    }
    names
}

// The name of the last `@name(` of a define line that is followed by a `)`, "" when none.
fun irDefinedName(header: string): string {
    var found = ""
    var at = header.indexOf("@")
    while (at >= 0) {
        val name = irNameAt(header, at + 1)
        val after = at + 1 + name.size
        if (name.size > 0 && after < header.size && header[after] == 40 && header.indexOf(")", after + 1) >= 0) found = name
        at = header.indexOf("@", at + 1)
    }
    found
}

// A function definition: `header` is the define line, `body` the text between it and the
// closing brace, `block` the whole definition (header, body and the brace).
class IrFunction(val name: string, val header: string, val body: string, val block: string)

// The `define ... {` blocks that end with a `}` at the start of a line, in order. A function
// whose name appears twice is listed twice.
fun irFunctions(text: string): array<IrFunction> {
    val functions: array<IrFunction> = []
    val lines = text.split("\n")
    var index = 0
    while (index < lines.size) {
        val line = lines[index]
        index = index + 1
        if (!line.startsWith("define") || !line.endsWith("{")) continue
        if (line.size > 6 && irIsNameChar(line[6])) continue
        val name = irDefinedName(line)
        if (name == "") continue
        var end = index
        while (end < lines.size && !lines[end].startsWith("}")) end = end + 1
        if (end >= lines.size) continue
        val parts: array<string> = []
        var at = index
        while (at < end) {
            parts.append(lines[at])
            at = at + 1
        }
        val bodyText = if (end > index) parts.join("\n") + "\n" else ""
        functions.append(IrFunction(name, line, bodyText, line + "\n" + bodyText + "}"))
        index = end + 1
    }
    functions
}
