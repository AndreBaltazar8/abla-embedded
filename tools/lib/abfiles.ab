// File discovery shared by the tools that rewrite *.ab trees: the ordering and
// spelling of Python's sorted(Path.rglob("*.ab")), without Python.

import "abla/fs"
import "abla/text"

// The path as pathlib spells it: empty and "." components dropped.
fun normalizePath(text: string): string {
    val parts: array<string> = []
    for (part in text.split("/")) {
        if (part != "" && part != ".") parts.append(part)
    }
    val joined = parts.join("/")
    if (text.startsWith("/")) "/$joined" else if (joined == "") "." else joined
}

private fun pathComponents(text: string): array<string> {
    val parts: array<string> = []
    for (part in text.split("/")) {
        if (part != "") parts.append(part)
    }
    parts
}

// pathlib ordering: component by component.
fun pathLess(left: string, right: string): bool {
    val a = pathComponents(left)
    val b = pathComponents(right)
    var index = 0
    while (index < a.size && index < b.size) {
        if (a[index] != b[index]) return a[index] < b[index]
        index = index + 1
    }
    a.size < b.size
}

// Sorted, without duplicates (insertion sort: lists are short or already sorted).
fun sortedUniquePaths(values: array<string>): array<string> {
    val result: array<string> = []
    for (value in values) {
        var present = false
        for (seen in result) if (seen == value) present = true
        if (present) continue
        result.append(value)
        var index = result.size - 1
        while (index > 0 && pathLess(value, result[index - 1])) {
            result[index] = result[index - 1]
            index = index - 1
        }
        result[index] = value
    }
    result
}

private fun sortNames(names: array<string>): array<string> {
    val result: array<string> = []
    for (value in names) {
        result.append(value)
        var index = result.size - 1
        while (index > 0 && value < result[index - 1]) {
            result[index] = result[index - 1]
            index = index - 1
        }
        result[index] = value
    }
    result
}

// Every regular file named *.ab below `directory`, depth first with the names
// of each directory in sorted order (Path.rglob("*.ab") then sorted()).
fun rglobAb(directory: string, var found: array<string>): void {
    val names: array<string> = []
    for (entry in Path(directory).entries()) names.append(entry.name())
    for (name in sortNames(names)) {
        val child = if (directory == ".") name else "${normalizePath(directory)}/$name"
        val info = Path(child).info()
        if (info.isDirectory()) rglobAb(child, found)
        else if (info.isFile() && name.endsWith(".ab")) found.append(child)
    }
}
