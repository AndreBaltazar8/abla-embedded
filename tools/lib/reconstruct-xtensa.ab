// Reconstruction helpers shared by tools/reconstruct-xtensa-object.ab, its tests and the
// recovery pipeline (no main here). See the tool for what they do.

import "abla/io"
import "abla/bytes"
import "abla/fs"
import "abla/text"
import "abla/regex"
import "abla/process/arguments"
import "abla/process/command"
import "abla/process/exit"

fun reconRegex(pattern: string): Regex {
    val compiled = regexCompile(pattern)
    if (!compiled.succeeded) panic("bad regular expression $pattern: ${compiled.error.message}")
    compiled.regex
}

val RECON_SECTION = reconRegex("""^Disassembly of section (\S+):$""")
val RECON_SYMBOL = reconRegex("""^([0-9a-f]+) <([^>]+)>:$""")
val RECON_INSTRUCTION = reconRegex("""^\s*([0-9a-f]+):\s+[0-9a-f]{2,6}\s+([^\s].*?)\s*$""")
val RECON_RELOCATION = reconRegex("""^\s*([0-9a-f]+):?\s+R_XTENSA_(\S+)\s+(.+?)\s*$""")
val RECON_RELOCATION_SECTION = reconRegex("""^RELOCATION RECORDS FOR \[(\S+)\]:$""")
val RECON_CONTENTS = reconRegex("""^Contents of section (\S+):$""")
val RECON_DATA_LINE = reconRegex("""^\s*[0-9a-f]+ +(.+)$""")
val RECON_HEX_COLUMNS = reconRegex("""[0-9a-f]{2}(?:[0-9a-f]{2}){0,3}(?: [0-9a-f]{2}(?:[0-9a-f]{2}){0,3}){0,3}""")
val RECON_LOCAL_DIRECTIVE = reconRegex("""\.local\s+(\S+)""")
val RECON_LOCAL_LINE = reconRegex("""^\.local\s+(\S+)$""")
val RECON_LITERAL_LINE = reconRegex("""^\.literal\s+(\S+),\s*([.$A-Za-z_][.$A-Za-z0-9_]*)\+0x([0-9A-Fa-f]+)$""")
val RECON_L32R_LINE = reconRegex("""^l32r[\t ]+(a(?:[0-9]|1[0-5])),[\t ]*(\S+)$""")
val RECON_BRANCH_LINE = reconRegex("""^(\S+)\s+(.+,\s*)([^,\s]+)$""")
val RECON_MOVI_LINE = reconRegex("""^movi\s+(a(?:[0-9]|1[0-5])),\s*(\S+)\s*$""")
val RECON_SYMBOLIC = reconRegex("""^[A-Za-z_.][A-Za-z0-9_.$]*(?:[+-](?:0x)?[0-9A-Fa-f]+)?$""")
val RECON_LITERAL_TARGET = reconRegex("""(\.[A-Za-z0-9_.$]+)(?:\+0x([0-9A-Fa-f]+))?""")
val RECON_REGISTER = reconRegex("""a([0-9]|1[0-5])""")
val RECON_ADDMI_IMMEDIATE = reconRegex("""0x[0-9a-fA-F]{8}""")

fun reconMakeCompatibility(): Map<string, string> {
    val table: Map<string, string> = Map()
    table.set(".text._do_wifi_disconnect", "abla_esp32_ioctl_local_do_wifi_disconnect")
    table.set(".text.wifi_hw_mode_switch", "abla_esp32_ioctl_local_wifi_hw_mode_switch")
    table.set(".text.wifi_pmk_is_valid", "abla_esp32_ioctl_local_wifi_pmk_is_valid")
    table.set(".text.wifi_station_set_config_local_2\$constprop\$0",
        "abla_esp32_ioctl_local_wifi_station_set_config")
    table.set(".text.wifi_stop_old_mode", "abla_esp32_ioctl_local_wifi_stop_old_mode")
    table.set(".text.wifi_phy_bw_is_valid", "abla_esp32_ioctl_local_wifi_phy_bw_is_valid")
    table.set(".text.wifi_wps_start", "abla_esp32_ioctl_local_wifi_wps_start")
    table.set(".text.wifi_wps_stop", "abla_esp32_ioctl_local_wifi_wps_stop")
    table
}

val COMPATIBILITY_SYMBOLS = reconMakeCompatibility()

// Set by --symbol-addend-literals (see main).
var SYMBOL_ADDEND_LITERALS = false

class ReconReloc(val kind: string, val value: string)

class ReconInstruction(val offset: int, val text: string, val relocations: array<ReconReloc>)

class ReconFunction(val section: string, val start: int, val instructions: array<ReconInstruction>)

class ReconParse(
    val functions: Map<string, ReconFunction>,
    val relocations: Map<string, Map<int, ReconReloc>>
)

// A section's size and log2 alignment.
class ReconMeta(val size: int, val alignment: int)

// A symbol's section and its size (data) or section-relative value (functions).
class ReconSymbol(val section: string, val size: int)

class ReconText(val text: string, val error: string)

class ReconLines(val lines: array<string>, val error: string)

class ReconPrefix(val source: string, val directives: array<string>, val error: string)

class ReconPair(val first: string, val second: string)

class ReconAlias(val name: string, val start: int)

class ReconEmitted(val name: string, val source: string)

// ---- small text helpers ----

fun reconIsDigit(c: int): bool = c >= 48 && c <= 57

fun reconIsLowerHex(c: int): bool = (c >= 48 && c <= 57) || (c >= 97 && c <= 102)

fun reconIsHex(c: int): bool = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)

fun reconIsAlnum(c: int): bool =
    (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90)

// [A-Za-z0-9_.$], the characters of an assembler symbol (-1 is no character).
fun reconIsSymbolChar(c: int): bool = reconIsAlnum(c) || c == 95 || c == 46 || c == 36

fun reconIsWordOrDot(c: int): bool = reconIsAlnum(c) || c == 95 || c == 46

fun reconIsSpace(c: int): bool = c == 32 || (c >= 9 && c <= 13)

fun reconAllMatch(text: string, kind: int): bool {
    if (text.size == 0) return false
    for (c in text) {
        val ok = if (kind == 0) reconIsDigit(c) else if (kind == 1) reconIsHex(c) else reconIsLowerHex(c)
        if (!ok) return false
    }
    true
}

fun reconAllDigits(text: string): bool = reconAllMatch(text, 0)

fun reconAllHex(text: string): bool = reconAllMatch(text, 1)

fun reconAllLowerHex(text: string): bool = reconAllMatch(text, 2)

fun reconHexValue(c: int): int =
    if (c >= 97) c - 87 else if (c >= 65) c - 55 else c - 48

// int(text, 16): optional sign and 0x prefix; digits up to the first other byte.
fun reconParseHex(text: string): int {
    val trimmed = text.trim()
    var index = 0
    var negative = false
    if (trimmed.startsWith("-")) {
        negative = true
        index = 1
    } else if (trimmed.startsWith("+")) {
        index = 1
    }
    if (trimmed.size >= index + 2 && trimmed[index] == 48 &&
        (trimmed[index + 1] == 120 || trimmed[index + 1] == 88)) {
        index = index + 2
    }
    var value = 0
    while (index < trimmed.size && reconIsHex(trimmed[index])) {
        value = value * 16 + reconHexValue(trimmed[index])
        index = index + 1
    }
    if (negative) -value else value
}

class ReconInteger(val value: int, val ok: bool)

// int(text, 0) as the recovered operands use it: optional sign, then a
// 0x/0o/0b number or plain decimal digits (no leading zeros).
fun reconParseInteger(text: string): ReconInteger {
    val trimmed = text.trim()
    var index = 0
    var negative = false
    if (trimmed.startsWith("-")) {
        negative = true
        index = 1
    } else if (trimmed.startsWith("+")) {
        index = 1
    }
    val body = trimmed.slice(index, trimmed.size)
    var base = 10
    var digits = body
    if (body.size >= 2 && body[0] == 48) {
        val prefix = body[1]
        if (prefix == 120 || prefix == 88) {
            base = 16
            digits = body.slice(2, body.size)
        } else if (prefix == 111 || prefix == 79) {
            base = 8
            digits = body.slice(2, body.size)
        } else if (prefix == 98 || prefix == 66) {
            base = 2
            digits = body.slice(2, body.size)
        }
    }
    if (digits.size == 0) return ReconInteger(0, false)
    var value = 0
    var position = 0
    while (position < digits.size) {
        val c = digits[position]
        val digit = if (reconIsDigit(c)) c - 48 else if (reconIsHex(c)) reconHexValue(c) else 99
        if (digit >= base) return ReconInteger(0, false)
        if (value < 0x3fffffffffffff) value = value * base + digit
        position = position + 1
    }
    if (base == 10 && digits.size > 1 && digits[0] == 48 && value != 0) return ReconInteger(0, false)
    ReconInteger(if (negative) -value else value, true)
}

fun reconHex(value: int): string {
    if (value < 0) return "-" + reconHex(-value)
    if (value == 0) return "0"
    val digits = "0123456789abcdef"
    val parts: array<string> = []
    var rest = value
    while (rest > 0) {
        parts.append(digits.slice(rest & 15, (rest & 15) + 1))
        rest = rest >> 4
    }
    var out = ""
    var index = parts.size - 1
    val pieces: array<string> = []
    while (index >= 0) {
        pieces.append(parts[index])
        index = index - 1
    }
    pieces.join("")
}

// f"{value:02x}"
fun reconHex2(value: int): string {
    val text = reconHex(value)
    if (text.size < 2) "0" + text else text
}

// `str.split()`: runs of whitespace separate fields, no empty fields.
fun reconFields(text: string): array<string> {
    val fields: array<string> = []
    var index = 0
    while (index < text.size) {
        while (index < text.size && reconIsSpace(text[index])) index = index + 1
        if (index >= text.size) break
        val begin = index
        while (index < text.size && !reconIsSpace(text[index])) index = index + 1
        fields.append(text.slice(begin, index))
    }
    fields
}

// `str.splitlines()` for text whose only separator is "\n".
fun reconSplitLines(text: string): array<string> {
    val lines = text.split("\n")
    if (lines.size > 0 && lines[lines.size - 1] == "") lines.truncate(lines.size - 1)
    lines
}

fun reconContains(values: array<string>, wanted: string): bool {
    for (value in values) {
        if (value == wanted) return true
    }
    false
}

// A set of names: the keys of a map.
fun reconSetOf(values: array<string>): Map<string, bool> {
    val set: Map<string, bool> = Map()
    for (value in values) set.set(value, true)
    set
}

// `text.partition(separator)` as (head, tail) with `found` carried by the
// separator: the second member is "" when the separator is absent.
class ReconPartition(val head: string, val found: bool, val tail: string)

fun reconPartition(text: string, separator: string): ReconPartition {
    val at = text.indexOf(separator)
    if (at < 0) return ReconPartition(text, false, "")
    ReconPartition(text.slice(0, at), true, text.slice(at + separator.size, text.size))
}

// re.sub(r"[^A-Za-z0-9_]", "_", text): one underscore per code point.
fun reconSanitize(text: string): string {
    val parts: array<string> = []
    var index = 0
    while (index < text.size) {
        val c = text[index]
        if (reconIsAlnum(c) || c == 95) {
            parts.append(text.slice(index, index + 1))
        } else if (c >= 0x80 && c < 0xc0) {
            // a UTF-8 continuation byte belongs to the code point before it
        } else {
            parts.append("_")
        }
        index = index + 1
    }
    parts.join("")
}

fun reconCleanSymbol(value: string): string {
    val at = value.indexOf(" (")
    (if (at < 0) value else value.slice(0, at)).trim()
}

// Python's `str.isalnum()` for the ASCII names the tool sees.
fun reconIsAlnumText(text: string): bool {
    if (text.size == 0) return false
    for (c in text) {
        if (!reconIsAlnum(c)) return false
    }
    true
}

fun reconIsDataSectionName(section: string): bool =
    section.startsWith(".bss") || section.startsWith(".tbss") || section.startsWith(".tdata") ||
    section.startsWith(".data") || section.startsWith(".dram") || section.startsWith(".rodata")

// `names` sorted by decreasing length, equal lengths kept in order.
fun reconSortByLengthDescending(names: array<string>): array<string> {
    var longest = 0
    for (name in names) {
        if (name.size > longest) longest = name.size
    }
    val buckets: array<array<string>> = []
    var length = 0
    while (length <= longest) {
        val bucket: array<string> = []
        buckets.append(bucket)
        length = length + 1
    }
    for (name in names) buckets[name.size].append(name)
    val result: array<string> = []
    var index = longest
    while (index >= 0) {
        for (name in buckets[index]) result.append(name)
        index = index - 1
    }
    result
}

fun reconBitLength(value: int): int {
    var length = 0
    var rest = value
    while (rest > 0) {
        length = length + 1
        rest = rest >> 1
    }
    length
}

// shlex.split for the --objdump option: whitespace separates words, quotes group.
fun reconShellWords(text: string): array<string> {
    val words: array<string> = []
    var current = ""
    var inWord = false
    var quote = 0
    var index = 0
    while (index < text.size) {
        val c = text[index]
        if (quote != 0) {
            if (c == quote) {
                quote = 0
            } else if (c == 92 && quote == 34 && index + 1 < text.size) {
                index = index + 1
                current = current + text.slice(index, index + 1)
            } else {
                current = current + text.slice(index, index + 1)
            }
        } else if (c == 34 || c == 39) {
            quote = c
            inWord = true
        } else if (c == 92 && index + 1 < text.size) {
            index = index + 1
            current = current + text.slice(index, index + 1)
            inWord = true
        } else if (reconIsSpace(c)) {
            if (inWord) {
                words.append(current)
                current = ""
                inWord = false
            }
        } else {
            current = current + text.slice(index, index + 1)
            inWord = true
        }
        index = index + 1
    }
    if (inWord) words.append(current)
    words
}

// ---- running objdump ----

class ReconRun(val output: string, val error: string)

fun reconCapture(words: array<string>, extra: array<string>): ReconRun {
    if (words.size == 0) return ReconRun("", "empty objdump command")
    val process = command(words[0])
    var index = 1
    while (index < words.size) {
        process.argument(words[index])
        index = index + 1
    }
    for (argument in extra) process.argument(argument)
    val result = process.capture()
    if (result.status != 0) {
        return ReconRun("", "Command '${words[0]}' returned non-zero exit status ${result.status}")
    }
    ReconRun(result.output, "")
}

fun reconRunObjdump(objdump: string, objectPath: string): ReconRun {
    val words = reconShellWords(objdump)
    val disassembly = reconCapture(words, ["-drsh", objectPath])
    if (disassembly.error != "") return disassembly
    // `-drsh` interleaves relocations for executable sections but BFD omits
    // relocation-only data sections from that view. Append the explicit
    // relocation table so pointers and jump tables are reconstructed too.
    val relocationTable = reconCapture(words, ["-r", objectPath])
    if (relocationTable.error != "") return relocationTable
    ReconRun(disassembly.output + "\n" + relocationTable.output, "")
}

fun reconRunSymbolTable(objdump: string, objectPath: string): ReconRun =
    reconCapture(reconShellWords(objdump), ["-t", objectPath])

// ---- parsing objdump output ----

// The bytes of every "Contents of section" dump.
fun sectionBytes(output: string): Map<string, string> {
    val chunks: Map<string, array<string>> = Map()
    var active = ""
    for (line in reconSplitLines(output)) {
        val header = RECON_CONTENTS.matchFull(line)
        if (header != null) {
            active = header.group(1) ?? ""
            if (!chunks.has(active)) {
                val fresh: array<string> = []
                chunks.set(active, fresh)
            }
            continue
        }
        if (active != "") {
            // objdump's final group may contain only 1-3 bytes. Requiring
            // eight hex digits silently lost small globals and table tails.
            // Stop at the double-space ASCII delimiter (which can itself
            // contain hex-looking text), not at the end of the line.
            val data = RECON_DATA_LINE.matchFull(line)
            if (data != null) {
                val rest = data.group(1) ?? ""
                val split = rest.indexOf("  ")
                val columns = if (split < 0) rest else rest.slice(0, split)
                if (RECON_HEX_COLUMNS.matches(columns)) {
                    val row: array<string> = []
                    var high = -1
                    for (c in columns) {
                        if (c == 32) continue
                        val digit = reconHexValue(c)
                        if (high < 0) {
                            high = digit
                        } else {
                            row.append(byteEncode(high * 16 + digit))
                            high = -1
                        }
                    }
                    val list = chunks.get(active)
                    if (list != null) list.append(row.join(""))
                    continue
                }
            }
            if (line != "" && !line.startsWith(" ")) active = ""
        }
    }
    val result: Map<string, string> = Map()
    for (name in chunks.keys()) {
        val list = chunks.get(name)
        if (list != null) result.set(name, list.join(""))
    }
    result
}

fun sectionMetadata(output: string): Map<string, ReconMeta> {
    val result: Map<string, ReconMeta> = Map()
    for (line in reconSplitLines(output)) {
        val fields = reconFields(line)
        if (fields.size == 7 && reconAllDigits(fields[0]) && fields[6].startsWith("2**")) {
            result.set(fields[1], ReconMeta(reconParseHex(fields[2]),
                reconParseInteger(fields[6].slice(3, fields[6].size)).value))
        }
    }
    result
}

fun objectDataSymbols(output: string): Map<string, ReconSymbol> {
    val result: Map<string, ReconSymbol> = Map()
    for (line in reconSplitLines(output)) {
        val fields = reconFields(line)
        if (fields.size >= 6 && fields[2] == "O") {
            // BFD inserts an optional visibility token (for example
            // `.hidden`) before the symbol name.
            result.set(fields[fields.size - 1], ReconSymbol(fields[3], reconParseHex(fields[4])))
        } else if (fields.size >= 5 && reconIsDataSectionName(fields[2]) && reconAllHex(fields[3])) {
            // Hand-written and TLS assembly symbols do not always carry
            // STT_OBJECT even though their nonzero size identifies them.
            result.set(fields[4], ReconSymbol(fields[2], reconParseHex(fields[3])))
        }
    }
    result
}

// Common (tentative) definitions -> (size, log2 alignment).
//
// A COMMON symbol has no section; the linker allocates it, and keeps it
// out of any archive member that is not pulled in. Materializing it as
// zeroed `.bss.<name>` storage lets the Abla unit own it.
fun objectCommonSymbols(output: string): Map<string, ReconMeta> {
    val result: Map<string, ReconMeta> = Map()
    for (line in reconSplitLines(output)) {
        val fields = reconFields(line)
        if (fields.size >= 5) {
            var index = -1
            var position = 0
            while (position < 4 && index < 0) {
                if (fields[position] == "*COM*") index = position
                position = position + 1
            }
            if (index >= 0) {
                val alignment = reconParseHex(fields[index + 1])
                val log2 = reconBitLength(alignment) - 1
                result.set(fields[fields.size - 1],
                    ReconMeta(reconParseHex(fields[0]), if (log2 > 0) log2 else 0))
            }
        }
    }
    result
}

// Zero-sized compiler labels within data/literal sections.
//
// GCC commonly relocates code against labels such as `.LC20`. They are
// local ELF symbols, not STT_OBJECT values, and therefore cannot keep their
// original spelling once many recovered members share one assembler unit.
// Resolve them to their section plus offset before the section itself is
// namespaced and emitted.
fun objectLocalDataLabels(output: string): Map<string, ReconSymbol> {
    val result: Map<string, ReconSymbol> = Map()
    for (line in reconSplitLines(output)) {
        val fields = reconFields(line)
        if (fields.size < 5 || fields[1] != "l") continue
        var section = ""
        var position = 2
        while (position < fields.size - 1 && section == "") {
            if (fields[position].startsWith(".")) section = fields[position]
            position = position + 1
        }
        val name = fields[fields.size - 1]
        if (section == "" || name == section || !reconAllHex(fields[0])) continue
        if (reconIsDataSectionName(section) || section.contains("literal")) {
            result.set(name, ReconSymbol(section, reconParseHex(fields[0])))
        }
    }
    result
}

// Each ELF function symbol's section and section-relative value.
//
// BFD disassembly prints only one label when multiple ABI symbols share the
// same body (common for C aliases and C++ C1/C2 or D1/D2 entry points). The
// symbol table retains every spelling, so use it to recover those aliases
// without teaching the tool any library- or platform-specific names.
fun objectFunctionSymbols(output: string): Map<string, ReconSymbol> {
    val result: Map<string, ReconSymbol> = Map()
    for (line in reconSplitLines(output)) {
        val fields = reconFields(line)
        if (fields.size >= 6 && fields[2] == "F") {
            result.set(fields[fields.size - 1], ReconSymbol(fields[3], reconParseHex(fields[0])))
        }
    }
    result
}

fun reconRelocationsOf(var relocations: Map<string, Map<int, ReconReloc>>, section: string): Map<int, ReconReloc> {
    val existing = relocations.get(section)
    if (existing != null) return existing
    val created: Map<int, ReconReloc> = Map()
    relocations.set(section, created)
    created
}

// A name ending in `-0x<hex>` is a label inside a function, not a function.
fun reconEndsWithMinusHex(name: string): bool {
    val at = name.lastIndexOf("-0x")
    if (at < 0) return false
    reconAllLowerHex(name.slice(at + 3, name.size))
}

fun reconFinishFunction(
    var functions: Map<string, ReconFunction>,
    name: string,
    section: string,
    start: int,
    instructions: array<ReconInstruction>
): void {
    if (name != "" && !reconEndsWithMinusHex(name)) {
        functions.set(name, ReconFunction(section, start, instructions))
    }
}

fun reconParse(output: string): ReconParse {
    val functions: Map<string, ReconFunction> = Map()
    val relocations: Map<string, Map<int, ReconReloc>> = Map()
    var currentSection = ""
    var currentName = ""
    var currentStart = 0
    var currentInstructions: array<ReconInstruction> = []
    val lines = reconSplitLines(output)
    var index = 0
    while (index < lines.size) {
        val line = lines[index]
        val sectionMatch = RECON_SECTION.matchFull(line)
        if (sectionMatch != null) {
            reconFinishFunction(functions, currentName, currentSection, currentStart, currentInstructions)
            currentName = ""
            currentInstructions = []
            currentSection = sectionMatch.group(1) ?? ""
            reconRelocationsOf(relocations, currentSection)
            index = index + 1
            continue
        }
        val relocationSectionMatch = RECON_RELOCATION_SECTION.matchFull(line)
        if (relocationSectionMatch != null) {
            reconFinishFunction(functions, currentName, currentSection, currentStart, currentInstructions)
            currentName = ""
            currentInstructions = []
            currentSection = relocationSectionMatch.group(1) ?? ""
            reconRelocationsOf(relocations, currentSection)
            index = index + 1
            continue
        }
        val symbolMatch = RECON_SYMBOL.matchFull(line)
        if (symbolMatch != null) {
            reconFinishFunction(functions, currentName, currentSection, currentStart, currentInstructions)
            currentName = ""
            currentInstructions = []
            currentStart = reconParseHex(symbolMatch.group(1) ?? "")
            currentName = symbolMatch.group(2) ?? ""
            index = index + 1
            continue
        }
        val relocationMatch = RECON_RELOCATION.matchFull(line)
        if (relocationMatch != null) {
            val offset = reconParseHex(relocationMatch.group(1) ?? "")
            reconRelocationsOf(relocations, currentSection).set(offset,
                ReconReloc(relocationMatch.group(2) ?? "", relocationMatch.group(3) ?? ""))
            index = index + 1
            continue
        }
        val instructionMatch = RECON_INSTRUCTION.matchFull(line)
        if (instructionMatch != null && currentName != "") {
            val instruction = ReconInstruction(
                reconParseHex(instructionMatch.group(1) ?? ""),
                instructionMatch.group(2) ?? "",
                [])
            var lookahead = index + 1
            while (lookahead < lines.size) {
                val follow = RECON_RELOCATION.matchFull(lines[lookahead])
                if (follow == null) break
                val kind = follow.group(2) ?? ""
                val value = follow.group(3) ?? ""
                instruction.relocations.append(ReconReloc(kind, value))
                reconRelocationsOf(relocations, currentSection).set(
                    reconParseHex(follow.group(1) ?? ""), ReconReloc(kind, value))
                lookahead = lookahead + 1
            }
            currentInstructions.append(instruction)
            index = lookahead
            continue
        }
        index = index + 1
    }
    reconFinishFunction(functions, currentName, currentSection, currentStart, currentInstructions)
    ReconParse(functions, relocations)
}

// ---- symbol text helpers ----

// Quote arbitrary assembler text as one non-interpolated Abla string.
fun escapeAblaString(value: string): string {
    // One escaped dollar survives Abla decoding as `$`; LLVM inline assembly
    // itself requires `$$` for a literal dollar in an assembler symbol.
    value.replace("\\", "\\\\").replace("\n", "\\n").replace("\"", "\\\"").replace("\$", "\\\$\\\$")
}

// Little-endian signed 32-bit word of `content` at `offset`.
fun reconSigned32(content: string, offset: int): int {
    val value = content[offset] | (content[offset + 1] << 8) | (content[offset + 2] << 16) |
        (content[offset + 3] << 24)
    if (value >= 0x80000000) value - 0x100000000 else value
}

fun reconUnsigned32(content: string, offset: int): int =
    content[offset] | (content[offset + 1] << 8) | (content[offset + 2] << 16) | (content[offset + 3] << 24)

// Restore an in-place REL addend when BFD omits it from the target.
fun dataRelocationExpression(value: string, content: string, offset: int): string {
    var symbol = reconCleanSymbol(value)
    if (!symbol.contains("+") && !(if (symbol.size > 1) symbol.slice(1, symbol.size) else "").contains("-") && offset + 4 <= content.size) {
        val addend = reconSigned32(content, offset)
        if (addend > 0) {
            symbol = symbol + "+0x" + reconHex(addend)
        } else if (addend < 0) {
            symbol = symbol + "-0x" + reconHex(-addend)
        }
    }
    symbol
}

fun reconLocalLabel(function: string, offset: int): string =
    ".Labla_recovered_" + reconSanitize(function) + "_" + reconHex(offset)

fun reconDataLabel(section: string): string = ".Labla_recovered_ioctl_data_" + reconSanitize(section)

fun compatibilitySymbol(name: string): string = COMPATIBILITY_SYMBOLS.get(name) ?? name

// "esp32Recovered" followed by the name's alphanumeric runs, each capitalized.
fun ablaFunctionName(name: string): string {
    val parts: array<string> = ["esp32Recovered"]
    var index = 0
    while (index < name.size) {
        while (index < name.size && !reconIsAlnum(name[index])) index = index + 1
        if (index >= name.size) break
        val begin = index
        while (index < name.size && reconIsAlnum(name[index])) index = index + 1
        val part = name.slice(begin, index)
        parts.append(part.slice(0, 1).uppercase() + part.slice(1, part.size))
    }
    parts.join("")
}

// Keep source names unique when punctuation-only ABI aliases collide.
fun ablaAliasFunctionName(name: string, target: string): string {
    val spelling = ablaFunctionName(name)
    if (spelling == ablaFunctionName(target)) spelling + "Alias" else spelling
}

// Disambiguate ABI spellings which normalize to the same Abla name.
fun uniqueAblaFunctionNames(names: array<string>): Map<string, string> {
    val groups: Map<string, array<string>> = Map()
    for (name in names) {
        val base = ablaFunctionName(name)
        if (!groups.has(base)) {
            val fresh: array<string> = []
            groups.set(base, fresh)
        }
        val members = groups.get(base) ?? []
        if (!reconContains(members, name)) members.append(name)
    }
    val result: Map<string, string> = Map()
    for (base in groups.keys()) {
        val rawNames = groups.get(base) ?? []
        if (rawNames.size == 1) {
            result.set(rawNames[0], base)
            continue
        }
        // sorted by (not raw.isalnum(), raw): alphanumeric names first
        val alphanumeric: array<string> = []
        val others: array<string> = []
        for (raw in rawNames) {
            if (reconIsAlnumText(raw)) alphanumeric.append(raw) else others.append(raw)
        }
        val ordered = sortedStrings(alphanumeric)
        for (raw in sortedStrings(others)) ordered.append(raw)
        var position = 0
        while (position < ordered.size) {
            result.set(ordered[position], if (position == 0) base else "${base}Abi$position")
            position = position + 1
        }
    }
    result
}

// Rename one assembler symbol without touching longer symbol names.
fun reconReplaceExact(source: string, old: string, replacement: string): string {
    if (old.size == 0) return source
    var at = source.indexOf(old)
    if (at < 0) return source
    val parts: array<string> = []
    var last = 0
    while (at >= 0) {
        val after = at + old.size
        val beforeChar = if (at == 0) -1 else source[at - 1]
        val afterChar = if (after >= source.size) -1 else source[after]
        if (!reconIsSymbolChar(beforeChar) && !reconIsSymbolChar(afterChar)) {
            parts.append(source.slice(last, at))
            parts.append(replacement)
            last = after
            at = source.indexOf(old, after)
        } else {
            at = source.indexOf(old, at + 1)
        }
    }
    if (last == 0 && parts.size == 0) return source
    parts.append(source.slice(last, source.size))
    parts.join("")
}

fun reconReplaceExactDirective(line: string, old: string, replacement: string): string =
    if (line.startsWith(".pushsection ")) line else reconReplaceExact(line, old, replacement)

// Does `text` hold `symbol` as a whole assembler symbol?
fun reconHasExact(text: string, symbol: string): bool {
    if (symbol.size == 0) return true
    var at = text.indexOf(symbol)
    while (at >= 0) {
        val after = at + symbol.size
        val beforeChar = if (at == 0) -1 else text[at - 1]
        val afterChar = if (after >= text.size) -1 else text[after]
        if (!reconIsSymbolChar(beforeChar) && !reconIsSymbolChar(afterChar)) return true
        at = text.indexOf(symbol, at + 1)
    }
    false
}

fun reconRebased(replacement: string, addend: int): string {
    if (addend > 0) return replacement + "+0x" + reconHex(addend)
    if (addend < 0) return replacement + "-0x" + reconHex(-addend)
    replacement
}

// Retarget section-relative references after removing a literal prefix.
//
// Some Xtensa objects use the section symbol as the relocation target and
// encode the real function entry as an addend. Recovered functions start at
// their first instruction, so references beyond the entry must be rebased by
// the number of bytes which preceded that instruction in the input section.
fun replaceCompatibilityReference(value: string, old: string, replacement: string, bodyOffset: int): string {
    if (old.size == 0) return value
    var at = value.indexOf(old)
    if (at < 0) return value
    val parts: array<string> = []
    var last = 0
    while (at >= 0) {
        val after = at + old.size
        val beforeChar = if (at == 0) -1 else value[at - 1]
        var matched = false
        if (!reconIsSymbolChar(beforeChar)) {
            var end = after
            var text = replacement
            // optional ([+-])0x([0-9A-Fa-f]+) addend, then no symbol character
            val sign = if (after < value.size) value[after] else -1
            if ((sign == 43 || sign == 45) && after + 2 < value.size &&
                value[after + 1] == 48 && value[after + 2] == 120) {
                var digitsEnd = after + 3
                while (digitsEnd < value.size && reconIsHex(value[digitsEnd])) digitsEnd = digitsEnd + 1
                if (digitsEnd > after + 3) {
                    val following = if (digitsEnd >= value.size) -1 else value[digitsEnd]
                    if (!reconIsSymbolChar(following)) {
                        var addend = reconParseHex(value.slice(after + 3, digitsEnd))
                        if (sign == 45) addend = -addend
                        text = reconRebased(replacement, addend - bodyOffset)
                        end = digitsEnd
                        matched = true
                    }
                }
            }
            if (!matched) {
                val following = if (after >= value.size) -1 else value[after]
                if (!reconIsSymbolChar(following)) matched = true
            }
            if (matched) {
                parts.append(value.slice(last, at))
                parts.append(text)
                last = end
                at = value.indexOf(old, end)
                continue
            }
        }
        at = value.indexOf(old, at + 1)
    }
    if (last == 0 && parts.size == 0) return value
    parts.append(value.slice(last, value.size))
    parts.join("")
}

// ---- data sections ----

fun dataSectionDirectives(
    section: string,
    label: string,
    size: int,
    alignment: int,
    content: string,
    relocations: Map<int, ReconReloc>,
    globalSymbol: string = "",
    internalSymbol: string = "",
    weakSymbol: string = ""
): ReconLines {
    val lines: array<string> = []
    val tls = section.startsWith(".tbss") || section.startsWith(".tdata")
    val bss = section.startsWith(".bss") || section.startsWith(".tbss")
    if (!bss && content.size < size) {
        return ReconLines(lines, "incomplete initialized section $section: expected $size bytes, parsed ${content.size}")
    }
    val writable = bss || section.startsWith(".data") || section.startsWith(".dram")
    val mergeStrings = section.contains(".str1.")
    val flags = if (tls) "awT" else if (writable) "aw" else if (mergeStrings) "aMS" else "a"
    val kind = if (bss) "@nobits" else "@progbits"
    // Preserve the input section family. ESP-IDF's linker fragment places
    // Wi-Fi logging data by names such as `.rodata_wlog_debug.*`; folding all
    // recovered constants into generic `.rodata.*` changes those placement
    // rules and can add kilobytes of alignment padding. Local labels already
    // carry the reconstruction namespace, so the original section name does
    // not create a symbol collision when several objects are recovered into
    // one Abla unit.
    val sectionSuffix = if (mergeStrings) ",1" else ""
    // LLVM inline assembly reserves `$` for operands; `$$` reaches the target
    // assembler as the literal dollar used by compiler-generated section names.
    val assemblySection = section.replace("\$", "\$\$")
    lines.append(".pushsection " + assemblySection + ",\"" + flags + "\"," + kind + sectionSuffix)
    if (alignment > 0) lines.append(".p2align $alignment")
    val exactSymbol = if (globalSymbol != "") globalSymbol else if (internalSymbol != "") internalSymbol else weakSymbol
    if (exactSymbol != "") {
        lines.append(if (globalSymbol != "") ".global " + exactSymbol
            else if (weakSymbol != "") ".weak " + exactSymbol else ".local " + exactSymbol)
        lines.append(".type " + exactSymbol + ", " + (if (tls) "@tls_object" else "@object"))
        lines.append(exactSymbol + ":")
    } else {
        lines.append(label + ":")
    }
    if (bss) {
        lines.append(".zero $size")
    } else {
        var offset = 0
        while (offset < size) {
            val relocation = relocations.get(offset)
            if (relocation != null && relocation.kind == "32") {
                lines.append(".long " + dataRelocationExpression(relocation.value, content, offset))
                offset = offset + 4
            } else {
                lines.append(".byte 0x" + reconHex2(content[offset]))
                offset = offset + 1
            }
        }
    }
    if (exactSymbol != "") lines.append(".size $exactSymbol, $size")
    lines.append(".popsection")
    ReconLines(lines, "")
}

// Restore ELF object-local scope inside the monolithic assembler unit.
fun reconCollectLocals(source: string, directives: array<string>): array<string> {
    val names: array<string> = []
    val seen: Map<string, bool> = Map()
    val lines = reconSplitLines(source)
    for (line in directives) lines.append(line)
    for (line in lines) {
        val match = RECON_LOCAL_DIRECTIVE.matchFull(line.trim())
        if (match != null) {
            val name = match.group(1) ?? ""
            if (!seen.has(name)) {
                seen.set(name, true)
                names.append(name)
            }
        }
    }
    names
}

class ReconUnit(val source: string, val directives: array<string>)

fun reconRename(source: string, directives: array<string>, old: string, replacement: string): ReconUnit {
    val renamed: array<string> = []
    for (line in directives) renamed.append(reconReplaceExactDirective(line, old, replacement))
    ReconUnit(reconReplaceExact(source, old, replacement), renamed)
}

fun namespaceAssemblerLocals(source: string, directives: array<string>, namespace: string): ReconUnit {
    var current = ReconUnit(source, directives)
    for (name in reconSortByLengthDescending(reconCollectLocals(source, directives))) {
        // local_function_directives already assigns a collision-free recovered
        // name. Do not namespace that generated name a second time when its
        // directives are folded into the selected monolithic anchor.
        if (name.startsWith(".Labla_recovered_")) continue
        val replacement = ".Labla_recovered_" + namespace + "_local_" + reconSanitize(name)
        if (name == replacement) continue
        current = reconRename(current.source, current.directives, name, replacement)
    }
    current
}

// Turn member-local data labels into section-relative expressions.
fun resolveLocalDataLabels(
    source: string,
    directives: array<string>,
    labels: Map<string, ReconSymbol>,
    explicitlySelected: Map<string, bool>
): ReconUnit {
    var current = ReconUnit(source, directives)
    for (name in reconSortByLengthDescending(labels.keys())) {
        if (explicitlySelected.has(name)) continue
        val label = labels.get(name)
        if (label == null) continue
        val expression = label.section + (if (label.size != 0) "+0x" + reconHex(label.size) else "")
        val lines: array<string> = []
        for (line in current.directives) lines.append(reconReplaceExactDirective(line, name, expression))
        current = ReconUnit(reconReplaceExact(current.source, name, expression), lines)
    }
    current
}

// `symbol+0xHEX` split at the plus sign, or an empty `ok`.
class ReconAddend(val symbol: string, val addend: int, val ok: bool)

// ([.$A-Za-z_][.$A-Za-z0-9_]*)\+0x([0-9A-Fa-f]+) as a whole expression.
fun reconSymbolAddend(expression: string): ReconAddend {
    val none = ReconAddend("", 0, false)
    if (expression.size == 0) return none
    val first = expression[0]
    if (!(reconIsAlnum(first) && !reconIsDigit(first)) && first != 46 && first != 36 && first != 95) return none
    var index = 1
    while (index < expression.size && reconIsSymbolChar(expression[index])) index = index + 1
    if (!expression.slice(index, expression.size).startsWith("+0x")) return none
    val digits = expression.slice(index + 3, expression.size)
    if (!reconAllHex(digits)) return none
    ReconAddend(expression.slice(0, index), reconParseHex(digits), true)
}

class ReconLiteralRewrite(
    val symbols: Map<string, string>,
    val high: Map<string, int>,
    val low: Map<string, int>
)

fun reconRewriteLiteralLine(rewrite: ReconLiteralRewrite, line: string): string {
    val literal = RECON_LITERAL_LINE.matchFull(line)
    if (literal != null) {
        val label = literal.group(1) ?? ""
        val symbol = rewrite.symbols.get(label)
        if (symbol != null && symbol == (literal.group(2) ?? "")) return ".literal " + label + ", " + symbol
        return line
    }
    val load = RECON_L32R_LINE.matchFull(line)
    if (load != null) {
        val label = load.group(2) ?? ""
        if (rewrite.symbols.has(label)) {
            val register = load.group(1) ?? ""
            val lines: array<string> = [line]
            val highPart = rewrite.high.get(label) ?? 0
            val lowPart = rewrite.low.get(label) ?? 0
            if (highPart != 0) lines.append("addmi $register, $register, $highPart")
            if (lowPart != 0) lines.append("addi $register, $register, $lowPart")
            return lines.join("\n")
        }
    }
    line
}

// Rewrite every line of `text`.
fun reconRewriteLiteralText(rewrite: ReconLiteralRewrite, text: string): string {
    val out: array<string> = []
    for (line in text.split("\n")) out.append(reconRewriteLiteralLine(rewrite, line))
    out.join("\n")
}

// Keep Xtensa text-streamer literals to a single symbol expression.
fun normalizeSymbolicLiteralAddends(source: string, directives: array<string>): ReconPrefix {
    if (SYMBOL_ADDEND_LITERALS) {
        // Upstream LLVM keeps `symbol+addend` in the literal's relocation.
        return ReconPrefix(source, directives, "")
    }
    val literalSymbol: Map<string, string> = Map()
    val literalAddend: Map<string, int> = Map()
    val order: array<string> = []
    val scan: array<string> = source.split("\n")
    for (element in directives) {
        for (line in element.split("\n")) scan.append(line)
    }
    for (line in scan) {
        val match = RECON_LITERAL_LINE.matchFull(line)
        if (match != null) {
            val label = match.group(1) ?? ""
            if (!literalSymbol.has(label)) order.append(label)
            literalSymbol.set(label, match.group(2) ?? "")
            literalAddend.set(label, reconParseHex(match.group(3) ?? ""))
        }
    }
    val high: Map<string, int> = Map()
    val low: Map<string, int> = Map()
    for (label in order) {
        val addend = literalAddend.get(label) ?? 0
        val highPart = ((addend + 128) / 256) * 256
        val lowPart = addend - highPart
        if (highPart < -32768 || highPart > 32512 || lowPart < -128 || lowPart > 127) {
            return ReconPrefix(source, directives, "literal addend is outside Xtensa immediates: " +
                (literalSymbol.get(label) ?? "") + "+0x" + reconHex(addend))
        }
        high.set(label, highPart)
        low.set(label, lowPart)
    }
    val rewrite = ReconLiteralRewrite(literalSymbol, high, low)
    val rewritten: array<string> = []
    for (element in directives) rewritten.append(reconRewriteLiteralText(rewrite, element))
    ReconPrefix(reconRewriteLiteralText(rewrite, source), rewritten, "")
}

fun reconBranchInverse(mnemonic: string): string = when (mnemonic) {
    "ball" -> "bnall"
    "bnall" -> "ball"
    "bany" -> "bnone"
    "bnone" -> "bany"
    "bbc" -> "bbs"
    "bbs" -> "bbc"
    "bbci" -> "bbsi"
    "bbsi" -> "bbci"
    "beq" -> "bne"
    "bne" -> "beq"
    "beqi" -> "bnei"
    "bnei" -> "beqi"
    "beqz" -> "bnez"
    "bnez" -> "beqz"
    "beqz.n" -> "bnez.n"
    "bnez.n" -> "beqz.n"
    "bf" -> "bt"
    "bt" -> "bf"
    "bge" -> "blt"
    "blt" -> "bge"
    "bgei" -> "blti"
    "blti" -> "bgei"
    "bgeu" -> "bltu"
    "bltu" -> "bgeu"
    "bgeui" -> "bltui"
    "bltui" -> "bgeui"
    "bgez" -> "bltz"
    "bltz" -> "bgez"
    else -> ""
}

// re.sub(r"[+-](?:0x[0-9A-Fa-f]+|[0-9]+)$", "", target)
fun reconStripAddendSuffix(target: string): string {
    var at = target.size - 1
    while (at >= 0 && target[at] != 43 && target[at] != 45) at = at - 1
    if (at < 0) return target
    val rest = target.slice(at + 1, target.size)
    if (reconAllDigits(rest)) return target.slice(0, at)
    if (rest.startsWith("0x") && reconAllHex(rest.slice(2, rest.size))) return target.slice(0, at)
    target
}

// Turn conditional cross-section branches into inverse-branch + jump.
fun normalizeCrossSectionBranches(source: string, namespace: string): string {
    val result: array<string> = []
    var count = 0
    val localSymbols: Map<string, bool> = Map()
    val lines = reconSplitLines(source)
    for (line in lines) {
        val local = RECON_LOCAL_LINE.matchFull(line)
        if (local != null) localSymbols.set(local.group(1) ?? "", true)
    }
    for (line in lines) {
        val match = RECON_BRANCH_LINE.matchFull(line)
        if (match != null) {
            val mnemonic = match.group(1) ?? ""
            val inverse = reconBranchInverse(mnemonic)
            if (inverse != "") {
                val target = match.group(3) ?? ""
                val targetBase = reconStripAddendSuffix(target)
                val crossLocal = localSymbols.has(targetBase)
                val externalTarget = !target.startsWith(".Labla_recovered_")
                if (crossLocal || externalTarget) {
                    val label = ".Labla_recovered_${namespace}_far_branch_$count"
                    count = count + 1
                    result.append(inverse + " " + (match.group(2) ?? "") + label)
                    result.append("j " + target)
                    result.append(label + ":")
                    continue
                }
            }
        }
        result.append(line)
    }
    result.join("\n")
}

fun reconDirectiveAdd(var target: array<string>, lines: array<string>): void {
    for (line in lines) target.append(line)
}

// Emit the data sections a recovered source refers to, and rename them.
fun recoveredDataPrefix(
    source: string,
    globalNames: array<string>,
    internalNames: array<string>,
    weakNames: array<string>,
    localNames: array<string>,
    content: Map<string, string>,
    relocations: Map<string, Map<int, ReconReloc>>,
    metadata: Map<string, ReconMeta>,
    symbols: Map<string, ReconSymbol>,
    compatibilityStarts: Map<string, int>,
    additionalDirectives: array<string>,
    reuseRecoveredData: bool,
    reusedDataLabels: Map<string, string>
): ReconPrefix {
    val replacements: Map<string, string> = Map()
    var directives: array<string> = []
    for (line in additionalDirectives) directives.append(line)
    var currentSource = source
    val globalSections: Map<string, bool> = Map()
    val noRelocations: Map<int, ReconReloc> = Map()
    for (name in globalNames) {
        val symbol = symbols.get(name)
        if (symbol == null) return ReconPrefix(source, directives, "data symbol is missing: " + name)
        val sized = metadata.get(symbol.section) ?? ReconMeta(symbol.size, 2)
        val emitted = dataSectionDirectives(symbol.section, name, sized.size, sized.alignment,
            content.get(symbol.section) ?? "", relocations.get(symbol.section) ?? noRelocations, name)
        if (emitted.error != "") return ReconPrefix(source, directives, emitted.error)
        reconDirectiveAdd(directives, emitted.lines)
        globalSections.set(symbol.section, true)
    }
    for (name in internalNames) {
        val symbol = symbols.get(name)
        if (symbol == null) return ReconPrefix(source, directives, "internal data symbol is missing: " + name)
        val sized = metadata.get(symbol.section) ?? ReconMeta(symbol.size, 2)
        // ELF local/internal symbols only have object-file scope. Recovered
        // members share one LLVM assembler unit, so preserving the original
        // spelling can collide with an equally named local in another member.
        // Give internal data the same reconstruction namespace as explicit
        // local data and rewrite every reference before combining the unit.
        val label = reconDataLabel(symbol.section + "_" + name)
        val renamed: array<string> = []
        for (line in directives) renamed.append(reconReplaceExact(line, name, label))
        directives = renamed
        val emitted = dataSectionDirectives(symbol.section, label, sized.size, sized.alignment,
            content.get(symbol.section) ?? "", relocations.get(symbol.section) ?? noRelocations)
        if (emitted.error != "") return ReconPrefix(source, directives, emitted.error)
        reconDirectiveAdd(directives, emitted.lines)
        currentSource = reconReplaceExact(currentSource, name, label)
        currentSource = reconReplaceExact(currentSource, symbol.section, label)
        val moved: array<string> = []
        for (line in directives) moved.append(reconReplaceExactDirective(line, symbol.section, label))
        directives = moved
        globalSections.set(symbol.section, true)
    }
    for (name in weakNames) {
        val symbol = symbols.get(name)
        if (symbol == null) return ReconPrefix(source, directives, "weak data symbol is missing: " + name)
        val sized = metadata.get(symbol.section) ?? ReconMeta(symbol.size, 2)
        val emitted = dataSectionDirectives(symbol.section, name, sized.size, sized.alignment,
            content.get(symbol.section) ?? "", relocations.get(symbol.section) ?? noRelocations,
            weakSymbol = name)
        if (emitted.error != "") return ReconPrefix(source, directives, emitted.error)
        reconDirectiveAdd(directives, emitted.lines)
        globalSections.set(symbol.section, true)
    }
    for (name in localNames) {
        val symbol = symbols.get(name)
        if (symbol == null) return ReconPrefix(source, directives, "local data symbol is missing: " + name)
        val sized = metadata.get(symbol.section) ?? ReconMeta(symbol.size, 2)
        val label = reconDataLabel(symbol.section + "_" + name)
        val renamed: array<string> = []
        for (line in directives) renamed.append(reconReplaceExact(line, name, label))
        directives = renamed
        val emitted = dataSectionDirectives(symbol.section, label, sized.size, sized.alignment,
            content.get(symbol.section) ?? "", relocations.get(symbol.section) ?? noRelocations)
        if (emitted.error != "") return ReconPrefix(source, directives, emitted.error)
        reconDirectiveAdd(directives, emitted.lines)
        currentSource = reconReplaceExact(currentSource, name, label)
        currentSource = reconReplaceExact(currentSource, symbol.section, label)
        val moved: array<string> = []
        for (line in directives) moved.append(reconReplaceExactDirective(line, symbol.section, label))
        directives = moved
        globalSections.set(symbol.section, true)
    }
    // Named data can itself relocate against an otherwise anonymous local
    // section. Discover those references after named directives have been
    // materialized so the dependency is emitted as well.
    val referenceSource = currentSource + "\n" + directives.join("\n")
    val candidates: array<string> = []
    for (section in metadata.keys()) {
        if ((reconIsDataSectionName(section) || section.contains("literal")) &&
            (reconHasExact(referenceSource, section) ||
                reconHasExact(referenceSource, escapeAblaString(section)))) {
            candidates.append(section)
        }
    }
    for (section in sortedStrings(candidates)) {
        if (globalSections.has(section)) continue
        val meta = metadata.get(section)
        if (meta == null) continue
        val reusedLabel = reusedDataLabels.get(section) ?? ""
        val label = if (reusedLabel != "") reusedLabel else reconDataLabel(section)
        replacements.set(section, label)
        val escapedSection = escapeAblaString(section)
        if (escapedSection != section) replacements.set(escapedSection, label)
        if (!reuseRecoveredData && reusedLabel == "") {
            val emitted = dataSectionDirectives(section, label, meta.size, meta.alignment,
                content.get(section) ?? "", relocations.get(section) ?? noRelocations)
            if (emitted.error != "") return ReconPrefix(source, directives, emitted.error)
            reconDirectiveAdd(directives, emitted.lines)
        }
    }
    // A base section such as `.rodata` is a prefix of generated sections such
    // as `.rodata.__func__$0`. Rewrite the longest names first so a short
    // section cannot corrupt a more specific relocation target.
    for (old in reconSortByLengthDescending(replacements.keys())) {
        val replacement = replacements.get(old) ?? ""
        currentSource = reconReplaceExact(currentSource, old, replacement)
        val renamed: array<string> = []
        for (line in directives) renamed.append(reconReplaceExactDirective(line, old, replacement))
        directives = renamed
    }
    for (old in COMPATIBILITY_SYMBOLS.keys()) {
        val replacement = COMPATIBILITY_SYMBOLS.get(old) ?? ""
        val bodyOffset = compatibilityStarts.get(old) ?? 0
        currentSource = replaceCompatibilityReference(currentSource, old, replacement, bodyOffset)
        val renamed: array<string> = []
        for (line in directives) renamed.append(replaceCompatibilityReference(line, old, replacement, bodyOffset))
        directives = renamed
    }
    ReconPrefix(currentSource, directives, "")
}

// ---- instructions ----

class ReconExpression(val text: string, val error: string)

fun literalExpression(
    section: string,
    offset: int,
    data: Map<string, string>,
    relocations: Map<string, Map<int, ReconReloc>>
): ReconExpression {
    val sectionRelocations = relocations.get(section)
    val relocation = if (sectionRelocations == null) null else sectionRelocations.get(offset)
    if (relocation != null && relocation.kind == "32") {
        return ReconExpression(dataRelocationExpression(relocation.value, data.get(section) ?? "", offset), "")
    }
    if (relocation != null && relocation.kind == "TLS_TPOFF") {
        return ReconExpression("@abla-tpoff:" + reconCleanSymbol(relocation.value), "")
    }
    val content = data.get(section) ?? ""
    if (offset + 4 > content.size) {
        return ReconExpression("", "literal " + section + "+0x" + reconHex(offset) + " is outside section")
    }
    ReconExpression("${reconUnsigned32(content, offset)}", "")
}

// Render sign-extended addmi operands in the assembler's signed form.
fun normalizeXtensaAssemblerImmediate(text: string): string {
    var split = reconPartition(text, "\t")
    if (!split.found) split = reconPartition(text, " ")
    if (split.head != "addmi") return text
    val operands = split.tail
    val comma = operands.lastIndexOf(",")
    if (comma < 0) return text
    val registers = operands.slice(0, comma)
    val immediate = operands.slice(comma + 1, operands.size).trim()
    if (!RECON_ADDMI_IMMEDIATE.matches(immediate)) return text
    var value = reconParseHex(immediate)
    if (value < 0x80000000) return text
    value = value - 0x100000000
    if (value < -32768 || value > 32512 || value % 256 != 0) return text
    "addmi\t$registers, $value"
}

// Load a symbol plus addend without a binary literal expression.
//
// Espressif LLVM's Xtensa text streamer crashes when inline assembly asks it
// to materialize `symbol+addend` directly. Load the relocatable base and add
// the constant with ordinary Xtensa instructions instead.
fun symbolicAddressLoad(register: string, expression: string): ReconText {
    val split = reconSymbolAddend(expression)
    if (!split.ok || SYMBOL_ADDEND_LITERALS) {
        // Upstream LLVM assembles `movi aN, symbol+addend` into a literal
        // whose relocation keeps the addend: required for mergeable sections
        // and for later section-alias rebasing of the addend.
        return ReconText("movi " + register + ", " + expression, "")
    }
    val addend = split.addend
    val high = ((addend + 128) / 256) * 256
    val low = addend - high
    if (high < -32768 || high > 32512 || low < -128 || low > 127) {
        return ReconText("", "symbol addend is outside Xtensa immediates: " + expression)
    }
    val lines: array<string> = ["movi " + register + ", " + split.symbol]
    if (high != 0) lines.append("addmi $register, $register, $high")
    if (low != 0) lines.append("addi $register, $register, $low")
    ReconText(lines.join("\n"), "")
}

// ---- TARGET: `<hex> <description>` references in disassembly ----

class ReconTarget(val start: int, val end: int, val offset: int, val description: string)

// (?<![\w.])([0-9a-f]+) <([^>]+)>, every non-overlapping match.
fun reconTargets(text: string): array<ReconTarget> {
    val found: array<ReconTarget> = []
    var index = 0
    while (index < text.size) {
        if (reconIsLowerHex(text[index]) && (index == 0 || !reconIsWordOrDot(text[index - 1]))) {
            var digitsEnd = index
            while (digitsEnd < text.size && reconIsLowerHex(text[digitsEnd])) digitsEnd = digitsEnd + 1
            if (digitsEnd + 1 < text.size && text[digitsEnd] == 32 && text[digitsEnd + 1] == 60) {
                var close = digitsEnd + 2
                while (close < text.size && text[close] != 62) close = close + 1
                if (close < text.size && close > digitsEnd + 2) {
                    found.append(ReconTarget(index, close + 1, reconParseHex(text.slice(index, digitsEnd)),
                        text.slice(digitsEnd + 2, close)))
                    index = close + 1
                    continue
                }
            }
        }
        index = index + 1
    }
    found
}

fun reconFirstRelocation(instruction: ReconInstruction, kind: string, prefix: bool): string {
    for (relocation in instruction.relocations) {
        if (if (prefix) relocation.kind.startsWith(kind) else relocation.kind == kind) {
            return reconCleanSymbol(relocation.value)
        }
    }
    ""
}

fun reconHasRelocation(instruction: ReconInstruction, kind: string, prefix: bool): bool {
    for (relocation in instruction.relocations) {
        if (if (prefix) relocation.kind.startsWith(kind) else relocation.kind == kind) return true
    }
    false
}

fun reconTlsLiteral(function: string, instruction: ReconInstruction, register: string, symbol: string): ReconText {
    val label = reconLocalLabel(function + "_tpoff", instruction.offset)
    ReconText(".type " + symbol + ", @tls_object\n" + ".literal " + label + ", 0\n" +
        ".reloc " + label + ", R_XTENSA_TLS_TPOFF, " + symbol + "\n" + "l32r " + register + ", " + label, "")
}

fun recoverInstruction(
    function: string,
    section: string,
    instruction: ReconInstruction,
    data: Map<string, string>,
    relocations: Map<string, Map<int, ReconReloc>>,
    labelName: string = ""
): ReconText {
    val text = normalizeXtensaAssemblerImmediate(instruction.text)
    var split = reconPartition(text, "\t")
    if (split.tail == "") split = reconPartition(text, " ")
    val mnemonic = split.head
    val operands = split.tail

    val hasExpansion = reconHasRelocation(instruction, "ASM_EXPAND", false)
    val expansion = reconFirstRelocation(instruction, "ASM_EXPAND", false)
    if (mnemonic == "l32r") {
        val comma = operands.indexOf(",")
        val register = if (comma < 0) operands else operands.slice(0, comma)
        if (hasExpansion && expansion != "") return ReconText("movi " + register + ", " + expansion, "")
        // Hand-written Xtensa assembly commonly keeps literals in a shared
        // `.literal` section. BFD prints the resolved PC-relative address as
        // a wrapped text offset, while the relocation records the real input
        // section (and optional addend). Follow that relocation instead of
        // treating the displayed address as an offset into the function.
        val literalSlot = reconFirstRelocation(instruction, "SLOT", true)
        val literalTarget = RECON_LITERAL_TARGET.matchFull(literalSlot)
        if (literalTarget != null && data.has(literalTarget.group(1) ?? "")) {
            val literalSection = literalTarget.group(1) ?? ""
            val literalOffset = reconParseHex(literalTarget.group(2) ?? "0")
            val expression = literalExpression(literalSection, literalOffset, data, relocations)
            if (expression.error != "") return ReconText("", expression.error)
            if (expression.text.startsWith("@abla-tpoff:")) {
                return reconTlsLiteral(function, instruction, register,
                    expression.text.slice("@abla-tpoff:".size, expression.text.size))
            }
            return symbolicAddressLoad(register, expression.text)
        }
        val targets = reconTargets(operands)
        if (targets.size == 0) return ReconText("", "cannot recover literal load: " + text)
        val expression = literalExpression(section, targets[0].offset, data, relocations)
        if (expression.error != "") return ReconText("", expression.error)
        if (expression.text.startsWith("@abla-tpoff:")) {
            return reconTlsLiteral(function, instruction, register,
                expression.text.slice("@abla-tpoff:".size, expression.text.size))
        }
        return symbolicAddressLoad(register, expression.text)
    }
    if (mnemonic == ".byte") {
        return ReconText(".byte 0x" + reconHex2(reconParseHex(operands)), "")
    }
    if (mnemonic == "ssa8b") {
        // Espressif LLVM 21 does not expose this ESP32 ISA mnemonic through
        // its integrated assembler, although the core executes it. Preserve
        // the documented three-byte RRR encoding instead of requiring a
        // compiler-specific opcode hook.
        val register = RECON_REGISTER.matchFull(operands.trim())
        if (register == null) return ReconText("", "invalid ssa8b register: " + operands)
        val encoded = 0x30 + reconParseInteger(register.group(1) ?? "0").value
        return ReconText(".byte 0x00\n.byte 0x" + reconHex2(encoded) + "\n.byte 0x40", "")
    }

    val slot = reconFirstRelocation(instruction, "SLOT", true)
    if (slot != "" && (mnemonic.startsWith("call") || mnemonic == "j" || mnemonic == "j.n")) {
        if (!slot.startsWith(section)) return ReconText(mnemonic + " " + slot, "")
    }

    val parts: array<string> = []
    var last = 0
    for (target in reconTargets(text)) {
        parts.append(text.slice(last, target.start))
        val description = target.description
        if (description == function || description.startsWith(function + "+")) {
            parts.append(reconLocalLabel(if (labelName != "") labelName else function, target.offset))
        } else {
            parts.append(reconCleanSymbol(description))
        }
        last = target.end
    }
    parts.append(text.slice(last, text.size))
    ReconText(parts.join(""), "")
}

// True when `expression` is `prefix+0xHEX`; the value goes to `addend`.
fun reconPrefixAddend(expression: string, prefix: string): int {
    if (!expression.startsWith(prefix + "+0x")) return -1
    val digits = expression.slice(prefix.size + 3, expression.size)
    if (!reconAllHex(digits)) return -1
    reconParseHex(digits)
}

fun recoveredFunctionBody(
    name: string,
    section: string,
    start: int,
    instructions: array<ReconInstruction>,
    data: Map<string, string>,
    relocations: Map<string, Map<int, ReconReloc>>,
    labelName: string = ""
): ReconLines {
    val targets: Map<int, bool> = Map()
    for (instruction in instructions) {
        for (match in reconTargets(instruction.text)) {
            val description = match.description
            if (description == name || description.startsWith(name + "+")) targets.set(match.offset, true)
        }
    }
    // Relocation-backed jump tables live in data sections and therefore do
    // not appear as branch operands in objdump's function body. Label every
    // table destination too, so section-plus-offset relocations can become
    // direct references within the reconstructed monolithic unit.
    for (relocationSection in relocations.keys()) {
        val sectionRelocations = relocations.get(relocationSection)
        if (sectionRelocations == null) continue
        val content = data.get(relocationSection) ?? ""
        for (relocationOffset in sectionRelocations.keys()) {
            val relocation = sectionRelocations.get(relocationOffset)
            if (relocation == null) continue
            val expression = dataRelocationExpression(relocation.value, content, relocationOffset)
            val sectionTarget = reconPrefixAddend(expression, section)
            val functionTarget = reconPrefixAddend(expression, name)
            if (sectionTarget >= 0) targets.set(sectionTarget, true)
            if (functionTarget >= 0) targets.set(start + functionTarget, true)
        }
    }
    val body: array<string> = []
    for (instruction in instructions) {
        if (targets.has(instruction.offset)) {
            body.append(reconLocalLabel(if (labelName != "") labelName else name, instruction.offset) + ":")
        }
        val recovered = recoverInstruction(name, section, instruction, data, relocations, labelName)
        if (recovered.error != "") return ReconLines(body, recovered.error)
        body.append(recovered.text)
    }
    ReconLines(body, "")
}

// Share repeated address literals inside one recovered function.
//
// Xtensa's `movi register, symbol` pseudo-instruction creates a literal word
// for every occurrence. The input objects can contain repeated words for the
// same address, and reassembly may introduce still more. An explicit
// `.literal` plus `l32r` is instruction-equivalent and lets every occurrence
// share one relocation, reducing both the object and final image.
fun deduplicateSymbolLiterals(body: array<string>, labelStem: string): array<string> {
    val registers: array<string> = []
    val targets: array<string> = []
    val counts: Map<string, int> = Map()
    for (line in body) {
        var register = ""
        var target = ""
        val match = RECON_MOVI_LINE.matchFull(line)
        if (match != null) {
            target = match.group(2) ?? ""
            var needsLiteral = RECON_SYMBOLIC.matches(target)
            if (!needsLiteral && target != "") {
                val parsed = reconParseInteger(target)
                if (parsed.ok) needsLiteral = parsed.value < -2048 || parsed.value > 2047
            }
            if (needsLiteral) {
                register = match.group(1) ?? ""
                counts.set(target, (counts.get(target) ?? 0) + 1)
            } else {
                target = ""
            }
        }
        registers.append(register)
        targets.append(target)
    }
    val repeated: array<string> = []
    for (target in counts.keys()) {
        if ((counts.get(target) ?? 0) > 1) repeated.append(target)
    }
    if (repeated.size == 0) {
        val same: array<string> = []
        for (line in body) same.append(line)
        return same
    }
    val safeStem = reconSanitize(labelStem)
    val labels: Map<string, string> = Map()
    var index = 0
    while (index < repeated.size) {
        labels.set(repeated[index], ".Labla_recovered_${safeStem}_shared_literal_$index")
        index = index + 1
    }
    val rewritten: array<string> = []
    for (target in repeated) rewritten.append(".literal " + (labels.get(target) ?? "") + ", " + target)
    index = 0
    while (index < body.size) {
        val label = labels.get(targets[index])
        if (registers[index] != "" && label != null) {
            rewritten.append("l32r " + registers[index] + ", " + label)
        } else {
            rewritten.append(body[index])
        }
        index = index + 1
    }
    rewritten
}

fun reconEntryIndex(instructions: array<ReconInstruction>): int {
    var index = 0
    while (index < instructions.size) {
        if (instructions[index].text.trim().startsWith("entry")) return index
        index = index + 1
    }
    -1
}

fun reconInstructionsFrom(instructions: array<ReconInstruction>, from: int): array<ReconInstruction> {
    val rest: array<ReconInstruction> = []
    var index = from
    while (index < instructions.size) {
        rest.append(instructions[index])
        index = index + 1
    }
    rest
}

fun reconSectionAnnotation(section: string, emittedName: string): string {
    if (section.startsWith(".text")) return ""
    // GCC's numbered sections are only object-local identities. Reusing
    // `.iram1.4` from many recovered members in one LLVM object coalesces
    // unrelated functions and makes section-symbol relocations ambiguous.
    // Retain the linker-placement family but give every function a stable,
    // source-level subsection.
    "@section(\"" + escapeAblaString(section + ".abla." + emittedName) + "\")\n"
}

fun emitFunction(
    name: string,
    section: string,
    start: int,
    instructions: array<ReconInstruction>,
    data: Map<string, string>,
    relocations: Map<string, Map<int, ReconReloc>>,
    prefix: array<string>,
    emittedName: string = ""
): ReconText {
    val recovered = recoveredFunctionBody(name, section, start, instructions, data, relocations)
    if (recovered.error != "") return ReconText("", recovered.error)
    var body = deduplicateSymbolLiterals(recovered.lines, name)
    if (prefix.size > 0) {
        val joined: array<string> = []
        for (line in prefix) joined.append(line)
        for (line in body) joined.append(line)
        body = joined
    }
    val assembly = body.join("\n")
    val ablaName = if (emittedName != "") emittedName else ablaFunctionName(name)
    // Most recovered functions use an ordinary `.text.*` input section and
    // should let LLVM choose the final text subsection. Named executable
    // sections such as IRAM/RTC memory, however, are part of the function's
    // correctness contract and must survive reconstruction. `@section` is a
    // general LLVM boundary rather than a target-specific annotation.
    val annotation = reconSectionAnnotation(section, ablaName)
    ReconText("// Original ABI symbol: " + name + "\n" + "@naked\n" + annotation +
        "trusted fun " + ablaName + "(): void = \$xtensa instructions {\n" + assembly + "\n}\n", "")
}

// A source-owned tail alias without duplicating the target body.
fun emitAliasFunction(name: string, target: string, emittedName: string = ""): string {
    val targetSymbol = compatibilitySymbol(target)
    "// Original ABI alias: " + name + " -> " + target + "\n" + "@naked\ntrusted fun " +
        (if (emittedName != "") emittedName else ablaAliasFunctionName(name, target)) +
        "(): void = \$xtensa instructions {\n" + "movi a8, " + targetSymbol + "\njx a8\n}\n"
}

// A prunable internal owner for source-recovered data-only objects.
fun emitSyntheticAnchor(name: string, emittedName: string = ""): string =
    "// Internal data-only object anchor: " + name + "\n" + "@naked\ntrusted fun " +
        (if (emittedName != "") emittedName else ablaFunctionName(name)) +
        "(): void = \$xtensa instructions {\n" + "entry a1, 32\nretw.n\n}\n"

fun localFunctionDirectives(
    name: string,
    section: string,
    start: int,
    instructions: array<ReconInstruction>,
    data: Map<string, string>,
    relocations: Map<string, Map<int, ReconReloc>>,
    alignment: int,
    emittedName: string = ""
): ReconLines {
    // A section-only local function has no separate ELF function symbol, so
    // objdump presents its literal pool under the section label as if it were
    // instructions. Start at the Xtensa entry instruction; relocation
    // expansion below has already converted every referenced literal.
    val entry = if (name.startsWith(".text.")) reconEntryIndex(instructions) else -1
    val entryStart = if (entry >= 0) instructions[entry].offset else start
    val entryInstructions = reconInstructionsFrom(instructions, if (entry >= 0) entry else 0)
    val symbol = if (emittedName != "") emittedName else name
    val safe = reconSanitize(name)
    val recoveredSection = if (section.startsWith(".text")) ".text.abla_ioctl_local_" + safe else section + ".abla." + safe
    val lines: array<string> = [".pushsection " + recoveredSection + ",\"ax\",@progbits"]
    if (alignment > 0) lines.append(".p2align $alignment")
    lines.append(".local " + symbol)
    lines.append(".type " + symbol + ", @function")
    lines.append(symbol + ":")
    val body = recoveredFunctionBody(name, section, entryStart, entryInstructions, data, relocations, symbol)
    if (body.error != "") return ReconLines(lines, body.error)
    for (line in deduplicateSymbolLiterals(body.lines, symbol)) lines.append(line)
    lines.append(".size " + symbol + ", .-" + symbol)
    lines.append(".popsection")
    ReconLines(lines, "")
}

// Recover a section-only helper as a prunable LLVM function.
//
// The original ELF section label includes its literal pool before `entry`.
// Skip that pool just as the directive form does, but let internalFunction
// provide the exact local linker spelling. This lets a monolithic build keep
// each helper only when reachable instead of pinning a large directive blob
// to an unrelated anchor function.
fun emitStandaloneLocalFunction(
    name: string,
    section: string,
    start: int,
    instructions: array<ReconInstruction>,
    data: Map<string, string>,
    relocations: Map<string, Map<int, ReconReloc>>,
    emittedName: string,
    linkerName: string
): ReconText {
    val entry = if (name.startsWith(".text.")) reconEntryIndex(instructions) else -1
    val entryStart = if (entry >= 0) instructions[entry].offset else start
    val entryInstructions = reconInstructionsFrom(instructions, if (entry >= 0) entry else 0)
    val recovered = recoveredFunctionBody(name, section, entryStart, entryInstructions, data, relocations, linkerName)
    if (recovered.error != "") return ReconText("", recovered.error)
    val body = deduplicateSymbolLiterals(recovered.lines, linkerName)
    val assembly = body.join("\n")
    var annotation = ""
    if (!section.startsWith(".text")) {
        annotation = "@section(\"" + escapeAblaString(section + ".abla." + emittedName) + "\")\n"
    }
    ReconText("// Original section-local ABI symbol: " + name + "\n" + "@naked\n" + annotation +
        "trusted fun " + emittedName + "(): void = \$xtensa instructions {\n" + assembly + "\n}\n", "")
}

// ---- reusing data already emitted by another reconstruction ----

fun reconIsLabelStart(c: int): bool = (reconIsAlnum(c) && !reconIsDigit(c)) || c == 46 || c == 36 || c == 95

fun reconIsLabelChar(c: int): bool = reconIsAlnum(c) || c == 46 || c == 36 || c == 95 || c == 92

// A label spelled `NAME:` followed by a literal backslash-n, at the start of
// `body` or right after one: its text, or "".
fun reconBodyLabel(body: string): string {
    var at = 0
    var tryNewline = false
    while (at <= body.size) {
        var begin = -1
        if (!tryNewline) {
            if (at == 0) begin = 0
            tryNewline = true
        } else {
            if (at + 2 <= body.size && body[at] == 92 && body[at + 1] == 110) begin = at + 2
            tryNewline = false
        }
        if (begin >= 0 && begin < body.size && reconIsLabelStart(body[begin])) {
            var end = begin + 1
            while (end < body.size && reconIsLabelChar(body[end])) end = end + 1
            if (end + 2 < body.size + 0 && body[end] == 58 && body[end + 1] == 92 && body[end + 2] == 110) {
                return body.slice(begin, end)
            }
        }
        if (!tryNewline) at = at + 1
    }
    ""
}

// The sections `source` (a former reconstruction) defines and their label.
fun reconReusedLabels(source: string, var labels: Map<string, string>): string {
    var search = 0
    while (true) {
        val begin = source.indexOf(".pushsection", search)
        if (begin < 0) break
        search = begin + 1
        var index = begin + ".pushsection".size
        if (index >= source.size || !reconIsSpace(source[index])) continue
        while (index < source.size && reconIsSpace(source[index])) index = index + 1
        val tokenBegin = index
        var scanning = true
        while (scanning && index < source.size) {
            val c = source[index]
            if (c == 92 && source.slice(index, index + 4) == "\\\$\\\$") {
                index = index + 4
            } else if (c != 44 && c != 92 && !reconIsSpace(c)) {
                index = index + 1
            } else {
                scanning = false
            }
        }
        if (index == tokenBegin) continue
        val token = source.slice(tokenBegin, index)
        val lineEnd = source.indexOf("\\n", index)
        if (lineEnd < 0) continue
        val bodyBegin = lineEnd + 2
        var bodyEnd = -1
        var closeEnd = -1
        var probe = source.indexOf(".popsection", bodyBegin)
        while (probe >= 0 && bodyEnd < 0) {
            val after = probe + ".popsection".size
            if (source.slice(after, after + 2) == "\\n") {
                bodyEnd = probe
                closeEnd = after + 2
            } else if (after < source.size && source[after] == 34) {
                bodyEnd = probe
                closeEnd = after + 1
            } else {
                probe = source.indexOf(".popsection", probe + 1)
            }
        }
        if (bodyEnd < 0) continue
        val label = reconBodyLabel(source.slice(bodyBegin, bodyEnd))
        if (label != "") {
            val section = token.replace("\\\$\\\$", "\$")
            val owner = label.replace("\\\$\\\$", "\$")
            val previous = labels.get(section)
            if (previous != null && previous != owner) {
                return "conflicting reused data owner for " + section + ": " + previous + " and " + owner
            }
            labels.set(section, owner)
        }
        search = closeEnd
    }
    ""
}

