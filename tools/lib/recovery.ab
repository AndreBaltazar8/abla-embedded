// Shared parts of the recovery drivers (tools/recover-member.ab and
// tools/assemble-recovered-unit.ab): the chip profile reader, process helpers,
// the Python text conventions the drivers' output was written with (universal
// newlines, str.splitlines, str.split) and path helpers. Names start with
// `recovery` so importing this file next to a tool keeps the tool's own
// names free.

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/regex"
import "abla/bytes"
import "abla/process/arguments"
import "abla/process/command"
import "abla/process/environment"
import "toml.ab"

// ---------------------------------------------------------------- text

fun recoveryIsDigit(c: int): bool = c >= 48 && c <= 57

fun recoveryIsHexLower(c: int): bool = (c >= 48 && c <= 57) || (c >= 97 && c <= 102)

fun recoveryIsHex(c: int): bool = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)

// Python's str `\w` on source text: ASCII letters, digits, `_`, and any non-ASCII byte.
fun recoveryIsWord(c: int): bool =
    (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c >= 128

// Python's str `\s` for ASCII text.
fun recoveryIsSpace(c: int): bool = (c >= 9 && c <= 13) || c == 32 || (c >= 28 && c <= 31)

// What Path.read_text() returns: `\r\n` and `\r` read as `\n`.
fun recoveryTranslateNewlines(text: string): string {
    if (text.indexOf("\r") < 0) return text
    text.replace("\r\n", "\n").replace("\r", "\n")
}

fun recoveryReadText(path: Path): string = recoveryTranslateNewlines(path.readText())

// str.splitlines(): `\n`, `\r\n`, `\r`, VT, FF, FS, GS, RS, NEL, LS and PS end a line
// (the terminator is dropped; a final terminator adds no empty line).
fun recoverySplitLines(text: string): array<string> {
    val lines: array<string> = []
    var start = 0
    var i = 0
    while (i < text.size) {
        val c = text[i]
        var width = 0
        if (c == 10 || c == 11 || c == 12 || c == 28 || c == 29 || c == 30) {
            width = 1
        } else if (c == 13) {
            width = if (i + 1 < text.size && text[i + 1] == 10) 2 else 1
        } else if (c == 0xc2 && i + 1 < text.size && text[i + 1] == 0x85) {
            width = 2
        } else if (c == 0xe2 && i + 2 < text.size && text[i + 1] == 0x80 &&
            (text[i + 2] == 0xa8 || text[i + 2] == 0xa9)) {
            width = 3
        }
        if (width > 0) {
            lines.append(text.slice(start, i))
            i = i + width
            start = i
        } else {
            i = i + 1
        }
    }
    if (start < text.size) lines.append(text.slice(start, text.size))
    lines
}

// str.split(): the runs of non-whitespace.
fun recoverySplitWhitespace(text: string): array<string> {
    val words: array<string> = []
    var i = 0
    while (i < text.size) {
        while (i < text.size && recoveryIsSpace(text[i])) i = i + 1
        val start = i
        while (i < text.size && !recoveryIsSpace(text[i])) i = i + 1
        if (i > start) words.append(text.slice(start, i))
    }
    words
}

// str.strip() of ASCII whitespace.
fun recoveryStrip(text: string): string {
    var start = 0
    var end = text.size
    while (start < end && recoveryIsSpace(text[start])) start = start + 1
    while (end > start && recoveryIsSpace(text[end - 1])) end = end - 1
    text.slice(start, end)
}

// text.replace(old, new, 1)
fun recoveryReplaceFirst(text: string, old: string, replacement: string): string {
    val at = text.indexOf(old)
    if (at < 0) return text
    text.slice(0, at) + replacement + text.slice(at + old.size, text.size)
}

fun recoveryCount(text: string, needle: string): int {
    var count = 0
    var at = text.indexOf(needle)
    while (at >= 0) {
        count = count + 1
        at = text.indexOf(needle, at + needle.size)
    }
    count
}

// re.escape for the Abla regex dialect: every byte that is not a word character is backslashed.
fun recoveryRegexEscape(text: string): string {
    val parts: array<string> = []
    for (c in text) {
        if (c < 128 && !recoveryIsWord(c)) parts.append("\\")
        parts.append(byteString(c))
    }
    parts.join("")
}

fun byteString(c: int): string = byteEncode(c)

// Python's `re.sub(r"[^A-Za-z0-9_]", "_", name)`: every character (code point) outside the set.
fun recoverySanitize(name: string): string {
    val parts: array<string> = []
    var i = 0
    while (i < name.size) {
        val c = name[i]
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
            parts.append(name.slice(i, i + 1))
            i = i + 1
        } else {
            // one replacement per code point, not per byte
            var width = 1
            if (c >= 0xf0) width = 4 else if (c >= 0xe0) width = 3 else if (c >= 0xc0) width = 2
            parts.append("_")
            i = i + width
        }
    }
    parts.join("")
}

// ---------------------------------------------------------------- paths

fun recoveryHome(): string = processEnvironmentOr("HOME", "")

// os.path.expanduser for `~` and `~/...`.
fun recoveryExpandUser(path: string): string {
    if (path == "~") return recoveryHome()
    if (path.startsWith("~/")) return recoveryHome() + path.slice(1, path.size)
    path
}

// The repository root: the tool binary sits in <root>/build/abla-tools/<hash>/.
fun recoveryRoot(): string {
    val executable = processExecutable()
    val marker = executable.indexOf("/build/abla-tools/")
    if (marker >= 0) return executable.slice(0, marker)
    currentDirectory().text
}

// os.path.relpath(target, start) for absolute paths without `..` or `.` parts.
fun recoveryRelativePath(target: string, start: string): string {
    val a = target.split("/")
    val b = start.split("/")
    var common = 0
    while (common < a.size && common < b.size && a[common] == b[common]) common = common + 1
    val parts: array<string> = []
    var i = common
    while (i < b.size) {
        if (b[i] != "") parts.append("..")
        i = i + 1
    }
    i = common
    while (i < a.size) {
        if (a[i] != "") parts.append(a[i])
        i = i + 1
    }
    if (parts.size == 0) "." else parts.join("/")
}

// sorted(paths) the way Python sorts pathlib paths: part by part. Joining the parts with the
// smallest byte makes plain byte order the same.
fun recoverySortPaths(paths: array<string>): array<string> {
    val separator = byteString(0)
    val keys: array<string> = []
    for (path in paths) keys.append(path.replace("/", separator))
    val out: array<string> = []
    for (key in sortedStrings(keys)) out.append(key.replace(separator, "/"))
    out
}

// Every regular file under `directory` whose name ends with `suffix` (Path.rglob("*suffix")),
// as paths in pathlib order.
fun recoveryRglob(directory: string, suffix: string): array<string> {
    val found: array<string> = []
    recoveryRglobInto(directory, suffix, found)
    recoverySortPaths(found)
}

private fun recoveryRglobInto(directory: string, suffix: string, var found: array<string>): void {
    for (entry in Path(directory).entries()) {
        val info = entry.info()
        if (info.isDirectory()) {
            recoveryRglobInto(entry.text, suffix, found)
        } else if (info.isFile() && entry.name().endsWith(suffix)) {
            found.append(entry.text)
        }
    }
}

// shutil.which: the first executable regular file called `name` on PATH.
fun recoveryWhich(name: string): string {
    if (name.indexOf("/") >= 0) return if (recoveryIsExecutable(name)) name else ""
    for (directory in processEnvironmentOr("PATH", "").split(":")) {
        val candidate = (if (directory == "") "." else directory) + "/" + name
        if (recoveryIsExecutable(candidate)) return candidate
    }
    ""
}

private fun recoveryIsExecutable(path: string): bool {
    val info = Path(path).info()
    info.isFile() && (Path(path).permissions() & 0o111) != 0
}

// ---------------------------------------------------------------- processes

class RecoveryRun(val status: int, val output: string, val errors: string, val launchError: string)

// Runs `words` (words[0] found on PATH) in `directory` ("" keeps ours) with the environment
// names/values added, capturing standard output and standard error separately.
fun recoveryCapture(words: array<string>, directory: string, names: array<string>,
    values: array<string>): RecoveryRun {
    val run = command(words[0])
    var i = 1
    while (i < words.size) {
        run.argument(words[i])
        i = i + 1
    }
    if (directory != "") run.directory(directory)
    i = 0
    while (i < names.size) {
        run.environment(names[i], values[i])
        i = i + 1
    }
    val result = run.captureBoth()
    RecoveryRun(result.status, result.output, result.errors, result.launchError)
}

fun recoveryCaptureSimple(words: array<string>): RecoveryRun {
    val none: array<string> = []
    recoveryCapture(words, "", none, none)
}

// Runs `words` with standard output and error appended to the file `log`, in `directory`.
// Returns the exit status (127 when it cannot start).
fun recoveryRunLogged(words: array<string>, directory: string, log: string): int {
    val run = command("bash")
    run.argument("-c")
    run.argument("\"$@\" >> \"$0\" 2>&1")
    run.argument(log)
    for (word in words) run.argument(word)
    if (directory != "") run.directory(directory)
    run.run()
}

// ---------------------------------------------------------------- profile

// One chip profile (tools/recovery/<chip>.toml) with its paths made absolute.
class RecoveryProfile(
    val chip: string,
    val objdump: string,
    val idf: string,
    val reference: string,
    val archiveNames: array<string>,
    val archivePaths: array<string>,
    val romLinkerScripts: array<string>,
    val commonData: bool,
    val classicCompatibility: bool,
    val standardCallModules: array<string>,
    val standardCallExclude: array<string>,
    val doc: TomlDoc
)

class RecoveryProfileResult(val profile: RecoveryProfile, val error: string)

private val noStrings: array<string> = []

fun RecoveryProfile.archive(name: string): string {
    var i = 0
    while (i < this.archiveNames.size) {
        if (this.archiveNames[i] == name) return this.archivePaths[i]
        i = i + 1
    }
    ""
}

fun RecoveryProfile.hasArchive(name: string): bool {
    for (key in this.archiveNames) if (key == name) return true
    false
}

// The profile's `[features.NAME]` names, in file order.
fun RecoveryProfile.hasFeature(name: string): bool = this.doc.has("features.$name.description") ||
    this.doc.tableCount("features.$name") > 0

fun recoveryLoadProfile(root: string, chip: string): RecoveryProfileResult {
    val path = root + "/tools/recovery/" + chip + ".toml"
    val empty = RecoveryProfile(chip, "", "", "", [], [], [], false, false, [], [], tomlParse(""))
    val read = Path(path).readTextResult()
    if (!read.succeeded) {
        return RecoveryProfileResult(empty, "no profile tools/recovery/$chip.toml")
    }
    val doc = tomlParse(recoveryTranslateNewlines(read.text))
    if (doc.error != "") return RecoveryProfileResult(empty, "tools/recovery/$chip.toml: ${doc.error}")
    if (!doc.has("idf") || !doc.has("objdump")) {
        return RecoveryProfileResult(empty, "tools/recovery/$chip.toml: missing idf or objdump")
    }
    val idf = recoveryExpandUser(doc.string("idf"))
    val names = doc.childKeys("archives")
    val paths: array<string> = []
    for (name in names) paths.append(joinPath(idf, doc.string("archives.$name")))
    val scripts: array<string> = []
    for (script in doc.strings("rom_linker_scripts")) scripts.append(joinPath(idf, script))
    val profile = RecoveryProfile(chip, recoveryExpandUser(doc.string("objdump")), idf,
        doc.string("reference"), names, paths, scripts, doc.bool("common_data"),
        doc.bool("classic_compatibility_symbols"), doc.strings("standard_call_modules"),
        doc.strings("standard_call_exclude"), doc)
    RecoveryProfileResult(profile, "")
}

// pathlib's `base / part`: an absolute part replaces the base.
fun joinPath(base: string, part: string): string {
    if (part.startsWith("/")) return part
    if (base.endsWith("/")) base + part else base + "/" + part
}

// [steam-run, objdump] or [objdump]: Espressif's prebuilt binaries need an FHS environment on NixOS.
fun recoveryObjdumpCommand(profile: RecoveryProfile): array<string> {
    val words: array<string> = []
    if (recoveryWhich("steam-run") != "" && processEnvironmentOr("ABLA_NO_STEAM_RUN", "") != "1") {
        words.append("steam-run")
    }
    words.append(profile.objdump)
    words
}

// ---------------------------------------------------------------- ablac

class RecoveryCompiler(val binary: string, val names: array<string>, val values: array<string>, val error: string)

// The installed ablac payload (<root>/libexec/ablac.bin) and the environment that makes it
// work, with abla-embedded's llc wrapper first on PATH: the launcher script names the
// /nix/store tool directories its payload needs.
fun recoveryAblacEnvironment(root: string, chip: string): RecoveryCompiler {
    val none: array<string> = []
    val found = recoveryWhich("ablac")
    if (found == "") return RecoveryCompiler("", none, none, "ablac not on PATH")
    val resolved = recoveryCaptureSimple(["readlink", "-f", found])
    val launcher = if (resolved.status == 0) recoveryStrip(resolved.output) else found
    val launcherRoot = Path(Path(launcher).parent().text).parent().text
    val text = Path(launcher).readText()
    val tools: array<string> = []
    val pattern = regexCompile("/nix/store/[^:'\"\\s]*/bin").regex
    for (m in pattern.findAll(text)) {
        val one = m.text0()
        var seen = false
        for (t in tools) if (t == one) seen = true
        if (!seen) tools.append(one)
    }
    val path: array<string> = [root + "/tools/esp-llvm-bin"]
    for (t in tools) path.append(t)
    path.append(processEnvironmentOr("PATH", ""))
    RecoveryCompiler(launcherRoot + "/libexec/ablac.bin",
        ["ABLA_ESP_CPU", "ABLA_SYSROOT", "PATH"],
        [chip, launcherRoot + "/share/abla", path.join(":")], "")
}

// ---------------------------------------------------------------- added by tools/assemble-recovered-unit.ab

// Runs `words` in `directory` ("" keeps ours) with standard error merged into standard output
// (subprocess.run(stdout=PIPE, stderr=STDOUT)); `output` is the merged text.
fun recoveryCaptureMerged(words: array<string>, directory: string): RecoveryRun {
    val run = command("bash")
    run.argument("-c")
    run.argument("exec \"$@\" 2>&1")
    run.argument("bash")
    for (word in words) run.argument(word)
    if (directory != "") run.directory(directory)
    val result = run.capture()
    RecoveryRun(result.status, result.output, "", "")
}
