// Helpers for the source-text assertions of tests/*.ab ("this guard comes before that
// store"): read a file below the project root, cut a function body out of it, compare
// where two snippets appear, and report every broken expectation in one run.
//
// The project root is the first program argument or, without one, the current directory
// (the callers run from the project root). Nothing here panics: a missing file, marker
// or snippet is a recorded failure, and `sourceFinish` turns the failures into the
// exit status, so one run lists everything that no longer holds.

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/regex"
import "abla/process/arguments"

var sourceFailures = 0

fun sourceFail(label: string): void {
    sourceFailures = sourceFailures + 1
    eprintln("FAIL $label")
}

fun sourceCheck(ok: bool, label: string): bool {
    if (!ok) sourceFail(label)
    ok
}

fun sourceRoot(): string = if (processArgumentCount() > 0) processArgument(0) else "."

// The text of a file below the project root ("" and a failure when it cannot be read).
fun sourceRead(relative: string): string {
    val result = Path("${sourceRoot()}/$relative").readTextResult()
    if (!result.succeeded) {
        sourceFail("cannot read $relative")
        return ""
    }
    result.text
}

// Everything after the first `marker` (Python: text.split(marker, 1)[1]); "" and a
// failure when the marker is absent.
fun sourceAfter(text: string, marker: string): string {
    val at = text.indexOf(marker)
    if (at < 0) {
        sourceFail("marker not found: $marker")
        return ""
    }
    text.slice(at + marker.size, text.size)
}

// Everything before the first `marker` (split(marker, 1)[0]); the whole text when the
// marker is absent, like Python, because a cut-off that vanished is not an error there.
fun sourceBefore(text: string, marker: string): string {
    val at = text.indexOf(marker)
    if (at < 0) text else text.slice(0, at)
}

// The position of the first `needle` at or after `from` (str.index); -1 and a failure
// when it is absent.
fun sourceIndex(text: string, needle: string, from: int = 0): int {
    val at = text.indexOf(needle, from)
    if (at < 0) sourceFail("not found: $needle")
    at
}

fun sourceHas(text: string, needle: string, label: string): bool =
    sourceCheck(text.contains(needle), label)

fun sourceLacks(text: string, needle: string, label: string): bool =
    sourceCheck(!text.contains(needle), label)

// `first` appears before `second` (both must be present).
fun sourceOrder(text: string, first: string, second: string, label: string): bool {
    val a = text.indexOf(first)
    val b = text.indexOf(second)
    if (a < 0) sourceFail("$label: not found: $first")
    if (b < 0) sourceFail("$label: not found: $second")
    if (a < 0 || b < 0) return false
    sourceCheck(a < b, "$label: `$first` must come before `$second`")
}

// Prints the PASS line and returns 0 when nothing failed, otherwise returns 1.
fun sourceFinish(passMessage: string): int {
    if (sourceFailures != 0) return 1
    println(passMessage)
    0
}

// The text of capture group `index` of a regex match ("" when the group did not take part).
fun sourceGroup(found: RegexMatch, index: int): string =
    if (found.hasGroup(index)) found.text.slice(found.groupStart(index), found.groupEnd(index)) else ""

// The bytes written as \xNN escapes in `encoded`, in order (re.findall(r"\\x([0-9a-fA-F]{2})")).
fun sourceHexEscapes(encoded: string): array<int> {
    val bytes: array<int> = []
    val digits = "0123456789abcdef"
    var at = encoded.indexOf("\\x")
    while (at >= 0 && at + 4 <= encoded.size) {
        val high = digits.indexOf(encoded.slice(at + 2, at + 3).lowercase())
        val low = digits.indexOf(encoded.slice(at + 3, at + 4).lowercase())
        if (high >= 0 && low >= 0) bytes.append(high * 16 + low)
        at = encoded.indexOf("\\x", at + 2)
    }
    bytes
}

// The first match of `pattern` in `text`, or null (and a failure when the pattern is bad).
fun sourceFind(pattern: string, text: string, from: int = 0): RegexMatch? {
    val compiled = regexCompile(pattern)
    if (!compiled.succeeded) {
        sourceFail("bad pattern $pattern: ${compiled.error.message}")
        return null
    }
    compiled.regex.find(text, from)
}

// All non-overlapping matches of `pattern` (re.finditer), empty and a failure for a bad pattern.
fun sourceFindAll(pattern: string, text: string): array<RegexMatch> {
    val compiled = regexCompile(pattern)
    if (!compiled.succeeded) {
        sourceFail("bad pattern $pattern: ${compiled.error.message}")
        val none: array<RegexMatch> = []
        return none
    }
    compiled.regex.findAll(text)
}

// The position of `name` in `names`, or -1.
fun sourceNameIndex(names: array<string>, name: string): int {
    var index = 0
    while (index < names.size) {
        if (names[index] == name) return index
        index = index + 1
    }
    -1
}
