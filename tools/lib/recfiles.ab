// File helpers shared by the recovered-source text tools: sorted recursive
// `*.ab` listing (the order of Python's sorted(Path.rglob("*.ab"))), whole-file
// reads and a few byte-level text helpers.

import "abla/fs"
import "abla/text"
import "abla/bytes"

fun recStringLess(left: string, right: string): bool {
    var index = 0
    while (index < left.size && index < right.size) {
        if (left[index] != right[index]) return left[index] < right[index]
        index = index + 1
    }
    left.size < right.size
}

// A stable merge sort of byte strings.
fun recSortStrings(values: array<string>): array<string> {
    if (values.size < 2) { val copy: array<string> = []; for (v in values) copy.append(v); return copy }
    val middle = values.size / 2
    val left: array<string> = []
    val right: array<string> = []
    var index = 0
    while (index < values.size) {
        if (index < middle) left.append(values[index]) else right.append(values[index])
        index = index + 1
    }
    val a = recSortStrings(left)
    val b = recSortStrings(right)
    val result: array<string> = []
    var i = 0
    var j = 0
    while (i < a.size && j < b.size) {
        if (recStringLess(b[j], a[i])) {
            result.append(b[j])
            j = j + 1
        } else {
            result.append(a[i])
            i = i + 1
        }
    }
    while (i < a.size) {
        result.append(a[i])
        i = i + 1
    }
    while (j < b.size) {
        result.append(b[j])
        j = j + 1
    }
    result
}

fun recJoinPath(directory: string, name: string): string =
    if (directory == ".") name else
    if (directory.endsWith("/")) directory + name else directory + "/" + name

// Appends the `*.ab` files below `directory` in Path-comparison order (component by component).
fun recWalk(directory: string, var found: array<string>): void {
    val names: array<string> = []
    for (entry in Path(directory).entries()) names.append(entry.name())
    for (name in recSortStrings(names)) {
        val full = recJoinPath(directory, name)
        val info = Path(full).info()
        if (info.isDirectory()) {
            recWalk(full, found)
        } else if (name.endsWith(".ab")) {
            found.append(full)
        }
    }
}

// sorted(Path(root).rglob("*.ab"))
fun recRglobAb(root: string): array<string> {
    val found: array<string> = []
    recWalk(root, found)
    found
}

fun recIsDirectory(path: string): bool = Path(path).info().isDirectory()

// The files named by `paths`: a directory gives its sorted *.ab files, a *.ab path itself.
fun recInputFiles(paths: array<string>): array<string> {
    val files: array<string> = []
    for (path in paths) {
        if (recIsDirectory(path)) {
            recWalk(path, files)
        } else if (path.endsWith(".ab")) {
            files.append(path)
        }
    }
    files
}

class RecRead(val text: string, val ok: bool)

fun recRead(path: string): RecRead {
    val result = Path(path).readTextResult()
    RecRead(result.text, result.succeeded)
}

// Python's str.splitlines() for text with \n line ends (a final \n adds no empty line).
fun recSplitLines(text: string): array<string> {
    val lines: array<string> = []
    var begin = 0
    var index = 0
    while (index < text.size) {
        val byte = text[index]
        if (byte == 10) {
            lines.append(text.slice(begin, index))
            begin = index + 1
        } else if (byte == 13) {
            lines.append(text.slice(begin, index))
            if (index + 1 < text.size && text[index + 1] == 10) index = index + 1
            begin = index + 1
        }
        index = index + 1
    }
    if (begin < text.size) lines.append(text.slice(begin, text.size))
    lines
}

fun recIsSpace(byte: int): bool = byte == 32 || (byte >= 9 && byte <= 13) || (byte >= 28 && byte <= 31)

// Python's str.strip() for ASCII whitespace.
fun recStrip(text: string): string {
    var begin = 0
    var end = text.size
    while (begin < end && recIsSpace(text[begin])) begin = begin + 1
    while (end > begin && recIsSpace(text[end - 1])) end = end - 1
    text.slice(begin, end)
}

fun recIsIdentStart(byte: int): bool =
    (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95

fun recIsDigit(byte: int): bool = byte >= 48 && byte <= 57

fun recIsWord(byte: int): bool = recIsIdentStart(byte) || recIsDigit(byte)

// Position just past the identifier starting at `at`, or `at` when none starts there.
fun recIdentEnd(text: string, at: int): int {
    if (at >= text.size || !recIsIdentStart(text[at])) return at
    var end = at + 1
    while (end < text.size && recIsWord(text[end])) end = end + 1
    end
}

// Number of "\n" before `position` (Python's text.count("\n", 0, position)).
fun recCountNewlines(text: string, position: int): int {
    var count = 0
    var index = 0
    while (index < position) {
        if (text[index] == 10) count = count + 1
        index = index + 1
    }
    count
}

// How Python's str(Path(text)) spells a path: no "." components, no doubled or trailing "/".
fun recNormalizePath(text: string): string {
    if (text == "") return "."
    val absolute = text.startsWith("/")
    val parts: array<string> = []
    for (part in text.split("/")) {
        if (part != "" && part != ".") parts.append(part)
    }
    val joined = parts.join("/")
    // POSIX keeps exactly two leading slashes, a single or three or more become one.
    val lead = if (!absolute) "" else if (text.startsWith("//") && !text.startsWith("///")) "//" else "/"
    if (joined == "") return if (absolute) lead else "."
    lead + joined
}

// True when `lit` occurs in `text` exactly at `at`.
fun recAt(text: string, at: int, lit: string): bool {
    if (at < 0 || at + lit.size > text.size) return false
    var index = 0
    while (index < lit.size) {
        if (text[at + index] != lit[index]) return false
        index = index + 1
    }
    true
}

fun recSkipSpace(text: string, at: int): int {
    var index = at
    while (index < text.size && recIsSpace(text[index])) index = index + 1
    index
}

// End of the run of ASCII digits starting at `at` (== at when there is none).
fun recDigitsEnd(text: string, at: int): int {
    var index = at
    while (index < text.size && recIsDigit(text[index])) index = index + 1
    index
}

fun recIsHex(byte: int): bool =
    recIsDigit(byte) || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102)

// The text without its leading ASCII whitespace.
fun recLstrip(text: string): string {
    var begin = 0
    while (begin < text.size && recIsSpace(text[begin])) begin = begin + 1
    text.slice(begin, text.size)
}
