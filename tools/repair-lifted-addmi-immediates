#!/usr/bin/env python3
"""Repair ADDMI immediates emitted by the pre-fix Xtensa lifter.

Old lifter output multiplied objdump's already-shifted ADDMI byte displacement
by another 256.  The generated register-machine spelling makes those sites
unambiguous: ADDI cannot encode these values and other arithmetic instructions
do not emit a register plus/minus a literal.
"""

from __future__ import annotations

import argparse
from pathlib import Path
import re


BROKEN_ADDMI = re.compile(
    r"(?m)^(?P<prefix>[ \t]*r\d+ = r\d+ [+-] u32\()"
    r"(?P<amount>\d+)(?P<suffix>\)[ \t]*)$"
)


def repair(source: str) -> tuple[str, int]:
    count = 0

    def replace(match: re.Match[str]) -> str:
        nonlocal count
        amount = int(match.group("amount"))
        # ADDMI's signed immediate is a multiple of 256 in [-32768, 32512].
        # The broken lifter multiplied that byte displacement by 256 again.
        if amount < 65536 or amount > 8323072 or amount % 65536 != 0:
            return match.group(0)
        count += 1
        return (
            match.group("prefix")
            + str(amount // 256)
            + match.group("suffix")
        )

    return BROKEN_ADDMI.sub(replace, source), count


def source_paths(arguments: list[str]) -> list[Path]:
    paths: list[Path] = []
    for argument in arguments or ["src"]:
        path = Path(argument)
        if path.is_dir():
            paths.extend(path.rglob("*.ab"))
        elif path.suffix == ".ab" and path.is_file():
            paths.append(path)
    return sorted(set(paths))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--write", action="store_true")
    parser.add_argument("paths", nargs="*")
    arguments = parser.parse_args()

    files = 0
    sites = 0
    for path in source_paths(arguments.paths):
        source = path.read_text()
        repaired, count = repair(source)
        if count == 0:
            continue
        files += 1
        sites += count
        if arguments.write:
            path.write_text(repaired)
        else:
            print(f"{path}: {count}")

    action = "repaired" if arguments.write else "would repair"
    print(f"{action} {sites} ADDMI immediate(s) in {files} file(s)")
    return 0 if arguments.write or sites == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
