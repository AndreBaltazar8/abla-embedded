#!/usr/bin/env python3
"""Assemble recovered archive members into one Abla unit and compile it.

  tools/assemble-recovered-unit esp32s3 libnet80211 libpp libcoexist

Takes each member's lifted.ab and link.ab from tools/recover-member under
build/recovery/<chip>/<archive>/<member>/, copies them into
build/recovery/<chip>/unit/, and runs the cross-module passes that only make
sense once the whole corpus is Abla:

1. centralize-abla-owned-storage: data referenced from more than one module
   moves into one cycle-free shared_storage.ab;
2. lower-abla-owned-symbol-addresses: `$xtensa address {sym}` uses of
   Abla-owned functions and data become ordinary Abla values;
3. direct-recovered-xtensa-calls: symbolic calls to Abla-owned functions
   become ordinary Abla calls (inlinable, tree-shakeable);
4. merge-recovered-join-tails: tails the structurizer copied into every
   branch arm are hoisted after the branch.

Then it compiles the unit to one object with every link selector applied,
which is what an application links instead of the Espressif archives.

With --exports FILE only the listed symbols stay global; every other
`exportFunction` selector becomes `internalFunction`, which keeps the exact
link name for raw assembly in the same object but lets LLVM inline and drop
the function. --exports-from-map regenerates FILE from an application link
map (see link_map_references).
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import os
import pathlib
import re
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
TOOLS = ROOT / "tools"
SELECTOR = re.compile(r"^compile fun (\w+)\(\): bool", re.MULTILINE)


def load_driver():
    loader = importlib.machinery.SourceFileLoader("recover_member", str(TOOLS / "recover-member"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


FUNCTION_TABLE = re.compile(
    r"(?ms)^val (?P<value>esp32Data_\w+)Storage = nativeStaticAllocate\(\d+\)\n"
    r"trusted fun (?P=value)Initialize\(\): int \{\n(?P<body>.*?)^\}\n"
)


def read_function_tables_through_storage(unit: pathlib.Path) -> int:
    """Let functions reach a code-pointer table without waiting for it.

    An ops table (for example a cipher descriptor) stores the addresses of
    functions that read the table back. Abla orders initializers by what
    their bodies name, so `table -> function -> table` is a cycle even though
    taking an address runs nothing. Function bodies read the storage address
    instead, which is the same value with no initialization dependency.
    """
    texts = {path: path.read_text() for path in unit.rglob("*.ab")}
    tables = [m.group("value") for text in texts.values() for m in FUNCTION_TABLE.finditer(text)
              if "nativeFunctionAddress(" in m.group("body")]
    if not tables:
        return 0
    pattern = re.compile(r"\b(" + "|".join(map(re.escape, tables)) + r")\b(?!Storage|Initialized?)")
    changed = 0
    for path, text in texts.items():
        parts = re.split(r"(?m)^(?=trusted fun |val |@)", text)
        rewritten = "".join(
            pattern.sub(lambda m: f"u32({m.group(1)}Storage)", part)
            if part.startswith(("trusted fun ", "@")) and not re.match(r"trusted fun esp32Data_\w+Initialize\(", part)
            else part
            for part in parts
        )
        if rewritten != text:
            path.write_text(rewritten)
            changed += 1
    return changed


EXPORT = re.compile(r'exportFunction\("(\w+)",\s*"([^"]+)"\)')


def link_map_references(map_path: pathlib.Path, unit_object: str = "unit/unit.o") -> list[str]:
    """Symbols the unit defines that some other input file references.

    Reads the `-Wl,--cref` table: a symbol line names its defining file, the
    indented lines after it name the referencing files. Only references from
    outside unit.o need a global symbol; calls inside it are direct.
    """
    lines = map_path.read_text(errors="replace").split("\n")
    start = lines.index("Cross Reference Table") + 3
    needed: dict[str, bool] = {}
    current, defined_here = "", False
    for line in lines[start:]:
        if not line.strip():
            continue
        if not line.startswith(" "):
            current, _, where = line.partition(" ")
            defined_here = unit_object in where
            if defined_here:
                needed[current] = False
        elif defined_here and unit_object not in line:
            needed[current] = True
    return sorted(name for name, used in needed.items() if used)


def restrict_exports(link: str, keep: set[str]) -> tuple[str, int]:
    """Turn exportFunction selectors for symbols outside `keep` into internal ones."""
    dropped = 0

    def rewrite(match: re.Match) -> str:
        nonlocal dropped
        if match.group(2) in keep:
            return match.group(0)
        dropped += 1
        return f'internalFunction("{match.group(1)}", "{match.group(2)}")'

    return EXPORT.sub(rewrite, link), dropped


CALL_LINE = r"^(?P<ind>\s*)(?P<lhs>r\d+|val callResult\d+) = (?:\$xtensa call(?:Wide)? \{%s\}\([^)]*\))\n"


def apply_feature_rewrites(text: str, rewrites: list[dict], applied: dict[str, int]) -> str:
    """Null address-of and skip direct calls to feature symbols in named functions.

    A profile `[[features.NAME.rewrite]]` names the function (its original ABI
    symbol, the `// Original ABI symbol:` comment above its Abla body) and the
    symbols whose address stores (`null_addresses`) or direct calls
    (`skip_calls`) it must not make. The edit is textual and local: the
    callee stays in its module, so with nothing else referencing it the
    section is dropped by --gc-sections.
    """
    for item in rewrites:
        marker = f"// Original ABI symbol: {item['function']}\n"
        start = text.find(marker)
        if start < 0:
            continue
        end = text.find("\n}\n", start)
        body = text[start:end]
        for symbol in item.get("null_addresses", []):
            body, count = re.subn(r"\$xtensa address \{%s\}" % re.escape(symbol), "u32(0)", body)
            applied[f"{item['function']}:addr:{symbol}"] = count
        for symbol in item.get("skip_calls", []):
            count = 0

            def drop(match: re.Match) -> str:
                nonlocal count
                count += 1
                lhs = match.group("lhs")
                return f"{match.group('ind')}{lhs} = " + ("u64(0)" if lhs.startswith("val") else "u32(0)") + "\n"

            body = re.sub(CALL_LINE % re.escape(symbol), drop, body, flags=re.MULTILINE)
            applied[f"{item['function']}:call:{symbol}"] = count
        # lint-recovered-unit credits the dropped references and calls.
        refs = [*item.get("null_addresses", []), *item.get("skip_calls", [])]
        dropped_calls = sum(applied[f"{item['function']}:call:{s}"] for s in item.get("skip_calls", []))
        header = re.search(r"^\)[^\n]*\{\n", body, re.MULTILINE)
        body = (body[:header.end()] + f"    // abla-feature-rewrite: calls={dropped_calls} refs={','.join(refs)}\n"
                + body[header.end():])
        text = text[:start] + body + text[end:]
    return text


COVERAGE_SOURCE = """\
import "../../../../src/xtensa/assembly.ab"
import "abla/unsafe/native"
import "abla/unsafe/memory"

// ABLA_COVERAGE=1 builds only: the first call of recovered function N prints
// `ABLACOV N` once (names in coverage.tsv). IRAM and DRAM only, so callers
// that run with the flash cache disabled can reach it.
@section(".iram1.abla_coverage")
@noinline
trusted fun ablaRecoveredCoverage(index: u32): void {{
    val hits = nativeStaticAllocate({count})
    val flag = nativePointerFromAddress(hits + int(index))
    if (ablaUnsafeLoadU8(flag) != 0) return
    ablaUnsafeStoreU8(flag, 1)
    val text = nativeStaticAllocate(16)
    val prefix = "ABLACOV "
    var at = 0
    while (at < 8) {{
        ablaUnsafeStoreU8(nativePointerFromAddress(text + at), prefix[at])
        at = at + 1
    }}
    var value = int(index)
    var digits = 1
    var scale = 1
    while (value / scale >= 10) {{
        scale = scale * 10
        digits = digits + 1
    }}
    while (scale > 0) {{
        ablaUnsafeStoreU8(nativePointerFromAddress(text + at), 48 + (value / scale) % 10)
        at = at + 1
        scale = scale / 10
    }}
    ablaUnsafeStoreU8(nativePointerFromAddress(text + at), 10)
    ablaUnsafeStoreU8(nativePointerFromAddress(text + at + 1), 0)
    val printed = $xtensa call {{esp_rom_printf}}(u32(text))
}}
"""
FUNCTION_START = re.compile(r"^(?:trusted )?fun (esp32Recovered\w+)\(", re.MULTILINE)


def instrument_coverage(unit: pathlib.Path, modules: list[str]) -> int:
    """Make each lifted function report its first call (ABLA_COVERAGE=1).

    Finds which recovered code a real session executes, as opposed to what
    the linker must keep because a table or a runtime mode check reaches it.
    Raw-assembly bodies are not instrumented.
    """
    rows = []
    for module in modules:
        path = unit / module
        lines = path.read_text().split("\n")
        out = []
        pending = None
        symbol = ""
        for line in lines:
            if line.startswith("// Original ABI symbol: "):
                symbol = line.split(": ", 1)[1].strip()
            match = FUNCTION_START.match(line)
            if match and "$xtensa instructions" not in line:
                pending = match.group(1)
            out.append(line)
            if pending and line.rstrip().endswith("{") and ("): " in line or line.startswith("trusted fun") or line.startswith("fun ")):
                if "$xtensa instructions" in line:
                    pending = None
                    continue
                out.append(f"    ablaRecoveredCoverage(u32({len(rows)}))")
                rows.append((len(rows), module, pending, symbol))
                pending = None
                symbol = ""
        text = "\n".join(out)
        if f"{len(rows)}" and 'import "../coverage.ab"' not in text:
            text = 'import "../coverage.ab"\n' + text
        path.write_text(text)
    (unit / "coverage.ab").write_text(COVERAGE_SOURCE.format(count=max(len(rows), 1)))
    (unit / "coverage.tsv").write_text("".join(f"{i}\t{m}\t{f}\t{s}\n" for i, m, f, s in rows))
    return len(rows)


ROM_PROVIDE = re.compile(r"PROVIDE\s*\(\s*([A-Za-z_]\w*)\s*=\s*(0x[0-9A-Fa-f]+)")
ROM_ASSIGNMENT = re.compile(r"(?m)^\s*([A-Za-z_]\w*)\s*=\s*(0x[0-9A-Fa-f]+)\s*;")


def write_rom_entries(unit: pathlib.Path, base: pathlib.Path, archives: list[str], profile: dict) -> int:
    """Define the ROM functions recover-member left out as absolute symbols.

    Functions the chip's ROM provides (class `rom` in reuse.tsv) are not
    recovered; recovered code calls them by name. ESP-IDF's ROM script
    assigns those names, but GNU ld evaluates script assignments only after
    it has chosen archive members, so to the archive scan the names look
    undefined and Espressif's own members would be pulled in again. Defining
    them in the unit at the script's address keeps the scan satisfied; the
    script assignment then sets the same value.
    """
    addresses: dict[str, str] = {}
    for script in profile.get("rom_linker_scripts", []):
        text = re.sub(r"/\*.*?\*/", "", pathlib.Path(script).read_text(), flags=re.DOTALL)
        for name, value in ROM_PROVIDE.findall(text) + ROM_ASSIGNMENT.findall(text):
            addresses.setdefault(name, value)
    names: set[str] = set()
    for archive in archives:
        for reuse in sorted((base / archive).glob("*/reuse.tsv")):
            for line in reuse.read_text().splitlines()[1:]:
                fields = line.split("\t")
                if len(fields) > 2 and fields[2] == "rom" and fields[0] in addresses:
                    names.add(fields[0])
    if not names:
        return 0
    body = "".join(f".global {name}\n.set {name}, {addresses[name]}\n" for name in sorted(names))
    (unit / "rom_entries.ab").write_text(
        'import "../../../../src/xtensa/assembly.ab"\n\n'
        "// ROM entry points recovered code calls by name (see write_rom_entries).\n"
        "@naked\n"
        "trusted fun esp32RecoveredRomEntries(): void = $xtensa instructions {\n"
        + body + "}\n")
    (unit / "rom_entries_link.ab").write_text(
        'import "abla/build"\n\n'
        "compile fun recoveredRomEntriesLink(): bool {\n"
        '    if (!exportFunction("esp32RecoveredRomEntries", "abla_recovered_rom_entries")) return false\n'
        "    true\n}\n")
    return len(names)


PUSHSECTION = re.compile(r'(\.pushsection\s+)("?)([^,\s"]+)')


def module_unique_sections(text: str, module: str) -> str:
    """Suffix each recovered data/code section name with its module.

    Recovered section names (`.rodata_wlog_warning.29`, `.rodata`,
    `.dram1.3`, `.rodata.str1.1`) are only unique within their original
    object, and the unit is one object: equal names from different members
    become one input section, so a live member kept a dead member's strings
    (the mesh log formats rode along with wdev's). The suffix keeps the
    original name as the prefix ESP-IDF's placement patterns match
    (`.rodata_wlog_warning.*`, `.dram1.*`); names already made unique per
    function (`.abla.`) are left alone.
    """
    tag = re.sub(r"[^A-Za-z0-9_]", "_", module)

    def rename(match: re.Match[str]) -> str:
        name = match.group(3)
        if ".abla." in name:
            return match.group(0)
        return f"{match.group(1)}{match.group(2)}{name}.abla_{tag}"

    return PUSHSECTION.sub(rename, text)


INTERNAL_SELECTOR = re.compile(
    r'^\s*if \(!(internalFunction|requiredInternalFunction)\("(\w+)", "([^"]+)"\)\) return false\n',
    re.MULTILINE,
)
RAW_FUNCTION = re.compile(r"\bfun\s+(\w+)\s*\([^)]*\)\s*:\s*\w+\s*=\s*\$xtensa instructions")


def prune_internal_selectors(unit: pathlib.Path, global_names: bool = True) -> tuple[int, int, int]:
    """Drop internalFunction selectors whose link name nothing names; export the rest.

    internalFunction keeps a linker name for raw assembly and `$xtensa`
    symbol forms, but it also puts the function in llvm.used, which LLVM
    emits as a retained (SHF_GNU_RETAIN) section: neither LLVM nor
    --gc-sections may then drop it. Once direct-recovered-xtensa-calls (and
    the callAddress lowering) have turned symbolic calls into calls LLVM sees,
    most of those names have no user left, so the selector only pins dead code.

    A name that is still mentioned (raw assembly such as `movi a8, foo` or
    `.long foo`, or a `$xtensa address` the Abla passes could not lower) must
    stay a link name. It becomes a global symbol (exportFunction) instead of an
    internal one: the assembler resolves the reference with a real relocation
    that --gc-sections follows, so the function is dropped when the code that
    names it is. The same holds for raw-assembly functions themselves: a raw
    function without an export request is an "assembly owner", which ablac
    keeps in llvm.used (a retained root that pins everything it calls), so a
    raw function keeps an exportFunction selector even when no source names it.
    Assembler-local `.L` names cannot be global; they are renamed (the `.L`
    dropped) in every source that names them. `global_names=False`
    (ABLA_RAW_NAMES=internal) keeps the old retained form for comparison.
    Returns (dropped, made global, renamed).
    """
    links = sorted(unit.rglob("*_link.ab"))
    paths = [path for path in unit.rglob("*.ab") if not path.name.endswith("_link.ab") and path.name != "main.ab"]
    texts = {path: path.read_text() for path in paths}
    # Comments (`// Original ABI symbol: name`) are not users.
    sources = "\n".join(re.sub(r"//[^\n]*", "", text) for text in texts.values())
    raw = {name for text in texts.values() for name in RAW_FUNCTION.findall(text)}
    names = {name for path in links for _, _, name in INTERNAL_SELECTOR.findall(path.read_text())}
    used = {name for name in names
            if re.search(rf"(?<![\w.$]){re.escape(name)}(?![\w$])", sources)}
    dropped = exported = 0
    renames: dict[str, str] = {}
    taken = set(re.findall(r"[A-Za-z_][\w$]*", sources + "\n".join(path.read_text() for path in links)))
    for path in links:
        text = path.read_text()

        def keep(match: re.Match[str]) -> str:
            nonlocal dropped, exported
            kind, function, name = match.groups()
            if kind == "internalFunction" and name not in used and function not in raw:
                dropped += 1
                return ""
            if not global_names:
                return match.group(0)
            exported += 1
            if name.startswith("."):
                renamed = name[2:] if name.startswith(".L") else name[1:]
                if renamed in taken and renames.get(name) != renamed:
                    renamed = "abla_local_" + renamed
                renames[name] = renamed
                taken.add(renamed)
                name = renamed
            return f'    if (!exportFunction("{function}", "{name}")) return false\n'

        path.write_text(INTERNAL_SELECTOR.sub(keep, text))
    if renames:
        pattern = re.compile(r"(?<![\w.$])(" + "|".join(map(re.escape, sorted(renames, key=len, reverse=True)))
                             + r")(?![\w$])")
        for path, text in texts.items():
            renamed = pattern.sub(lambda m: renames[m.group(1)], text)
            if renamed != text:
                path.write_text(renamed)
    return dropped, exported, len(renames)


def run_pass(command: list[str], log) -> None:
    log.write(f"== {' '.join(command)}\n")
    log.flush()
    result = subprocess.run([sys.executable, "-I", str(TOOLS / command[0]), *command[1:]],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    log.write(result.stdout)
    print(f"{command[0]}: " + (result.stdout.strip().splitlines() or ["(no output)"])[-1]
          + ("" if result.returncode == 0 else f" (exit {result.returncode})"))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("chip")
    parser.add_argument("archives", nargs="*")
    parser.add_argument("--no-compile", action="store_true")
    parser.add_argument("--exclude", default="",
                        help="comma-separated archive/member stems to leave to the Espressif "
                        "archive (bisecting behavioural differences), e.g. libpp/pm")
    parser.add_argument("--exports", type=pathlib.Path,
                        help="file listing the only symbols to keep global (one per line)")
    parser.add_argument("--exports-from-map", type=pathlib.Path, metavar="MAP",
                        help="write --exports FILE from the --cref table of an application link map, then exit")
    parser.add_argument("--features", default=os.environ.get("ABLA_FEATURES", ""),
                        help="comma-separated feature profile names from [features.NAME] in the chip "
                        "profile (for example `sta`): drops the registration of Wi-Fi features the "
                        "application never uses so --gc-sections can remove them")
    args = parser.parse_args()
    if args.exports_from_map:
        names = link_map_references(args.exports_from_map)
        args.exports.write_text("".join(f"{name}\n" for name in names))
        print(f"{len(names)} symbols referenced from outside the unit -> {args.exports}")
        return 0
    keep = {line.strip() for line in args.exports.read_text().splitlines() if line.strip()} if args.exports else None
    exported = dropped = 0

    profile = load_driver().load_profile(args.chip)
    rewrites: list[dict] = []
    for name in (n for n in args.features.split(",") if n):
        if name not in profile.get("features", {}):
            sys.exit(f"assemble-recovered-unit: no [features.{name}] in the {args.chip} profile")
        rewrites += profile["features"][name].get("rewrite", [])
    applied: dict[str, int] = {}
    base = ROOT / "build" / "recovery" / args.chip
    unit = base / "unit"
    if unit.exists():
        shutil.rmtree(unit)
    unit.mkdir(parents=True)
    selectors: list[tuple[str, str]] = []
    modules: list[str] = []
    for archive in args.archives:
        (unit / archive).mkdir()
        excluded = {item for item in args.exclude.split(",") if item}
        for member in sorted(p for p in (base / archive).iterdir() if (p / "lifted.ab").exists()):
            if f"{archive}/{member.name}" in excluded:
                continue
            module = f"{archive}/{member.name}.ab"
            # Same directory depth as the member work directory, so the
            # relative src/ imports stay valid.
            text = (member / "lifted.ab").read_text()
            if rewrites:
                text = apply_feature_rewrites(text, rewrites, applied)
            (unit / module).write_text(module_unique_sections(text, f"{archive}_{member.name}"))
            modules.append(module)
            if (member / "link.ab").exists():
                link = f"{archive}/{member.name}_link.ab"
                text = (member / "link.ab").read_text()
                if keep is not None:
                    text, count = restrict_exports(text, keep)
                    dropped += count
                exported += len(EXPORT.findall(text))
                (unit / link).write_text(text)
                selectors += [(link, name) for name in SELECTOR.findall(text)]
    if rewrites:
        missing = [key for key in {f"{r['function']}:{kind}:{s}" for r in rewrites
                   for kind, field in (("addr", "null_addresses"), ("call", "skip_calls")) for s in r.get(field, [])}
                   if not applied.get(key)]
        print(f"features {args.features}: {sum(applied.values())} edits in {len(rewrites)} functions"
              + (f"; NOT APPLIED: {sorted(missing)}" if missing else ""))
    shared = unit / "shared_storage.ab"
    shared.write_text('import "abla/unsafe/native"\n\n// Data owned by more than one recovered module.\n')
    print(f"{len(modules)} modules, {len(selectors)} link selectors"
          + (f" ({exported} exported, {dropped} made internal)" if keep is not None else ""))

    skip_passes = set(os.environ.get("ABLA_SIZE_SKIP", "").split(","))
    with (unit / "passes.log").open("w") as log:
        run_pass(["centralize-abla-owned-storage", "--write", "--initialized-constants", str(unit), str(shared)], log)
        run_pass(["lower-abla-owned-symbol-addresses", "--write", "--cross-module-data",
                  "--cross-module-functions", str(unit)], log)
        direct = ["direct-recovered-xtensa-calls", str(unit), "--write", "--library-root", str(ROOT / "src")]
        for prefix in profile.get("standard_call_modules", []):
            direct += ["--standard-module-prefix", prefix]
        for symbol in profile.get("standard_call_exclude", []):
            direct += ["--standard-exclude", symbol]
        run_pass(direct, log)
        # What direct calls could not take (variadic or stack-reading raw
        # callees, ...) still names an Abla-owned function through an opaque
        # `movi sym`. Calling the function's address instead lets LLVM see
        # the edge, so the link name (and its retained section) can go.
        if "calladdress" not in skip_passes:
            run_pass(["lower-abla-owned-symbol-addresses", "--write", "--cross-module-functions",
                      "--calls", str(unit)], log)
        # ABLA_SIZE_SKIP=merge,noinline disables these size passes (bisecting).
        skip = set(os.environ.get("ABLA_SIZE_SKIP", "").split(","))
        if "merge" not in skip:
            run_pass(["merge-recovered-join-tails", str(unit), "--write"], log)
        if "noinline" not in skip:
            run_pass(["mark-recovered-noinline", str(unit), "--write",
                      "--inline-lines", os.environ.get("ABLA_RECOVERED_INLINE_LINES", "0")], log)
    print(f"function tables read through storage in {read_function_tables_through_storage(unit)} modules")
    dropped, made_global, renamed = prune_internal_selectors(
        unit, os.environ.get("ABLA_RAW_NAMES", "export") != "internal")
    print(f"internal link names dropped (no assembler user): {dropped}; "
          f"kept as global names (gc-able): {made_global} ({renamed} assembler-local names renamed)")

    if os.environ.get("ABLA_COVERAGE") == "1":
        print(f"coverage: instrumented {instrument_coverage(unit, modules)} function(s); map in coverage.tsv")
    rom_entries = write_rom_entries(unit, base, args.archives, profile)
    if rom_entries:
        modules.append("rom_entries.ab")
        selectors.append(("rom_entries_link.ab", "recoveredRomEntriesLink"))
        print(f"ROM entry points defined in the unit: {rom_entries}")
    main_source = [f'import "{module}"' for module in modules]
    main_source += [f'import "{link}"' for link in dict.fromkeys(link for link, _ in selectors)]
    main_source += [""] + [f"#{name}()" for _, name in selectors]
    (unit / "main.ab").write_text("\n".join(main_source) + "\n")
    (unit / "build.ab").write_text(
        'import "abla/compiler"\n\n'
        'val target = #compilerDefineTarget("esp32-xtensa", "xtensa-esp-unknown-elf", "elf", "none", "none", false, false)\n'
        f'val built = #compilerBuildProgram("{args.chip}-recovered-radio", "main.ab", "unit.o", "esp32-xtensa", "object", false, false)\n\n'
        'fun main: int = if (target && built) 0 else 1\n')
    if args.no_compile:
        return 0

    driver = load_driver()
    ablac, environment = driver.ablac_environment(args.chip)
    script = f'ulimit -s 131072; "{ablac}" build build.ab -o driver --no-cache && ./driver'
    result = subprocess.run(["bash", "-c", script], cwd=unit, env=environment,
                            capture_output=True, text=True, errors="replace")
    log = result.stdout + result.stderr
    (unit / "compile.log").write_text(log[-4_000_000:])
    if result.returncode == 0 and (unit / "unit.o").exists():
        print(f"compiled {(unit / 'unit.o').relative_to(ROOT)} ({(unit / 'unit.o').stat().st_size} bytes)")
        return 0
    kinds: dict[str, int] = {}
    for kind in re.findall(r"^error\[\w+\]: ([^\s@:]+(?::[^\s@]+)?)", log, re.MULTILINE):
        kinds[kind] = kinds.get(kind, 0) + 1
    print(f"compile failed: {sum(kinds.values())} error(s); see {(unit / 'compile.log').relative_to(ROOT)}")
    for kind, count in sorted(kinds.items(), key=lambda item: -item[1])[:12]:
        print(f"  {count:6} {kind}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
