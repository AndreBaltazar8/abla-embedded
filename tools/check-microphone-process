#!/usr/bin/env bash
set -euo pipefail
# Run inside the compiler's pinned Nix shell. C is test oracle only; the
# callable firmware object contains exclusively Abla-compiled definitions.
project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"
export ABLA_SYSROOT="${ABLA_SYSROOT:-../ablac}"
artifact=build/tests/microphone-process
mkdir -p build/tests
../ablac/build/ablac build examples/microphone-process/main.ab -o "$artifact.o" \
  --target-triple x86_64-unknown-linux-gnu --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -relocation-model=static "$artifact.bc" -o "$artifact.opt.o"
cc -O2 -no-pie tests/microphone-process-oracle.c "$artifact.opt.o" -o "$artifact"
"$artifact"
