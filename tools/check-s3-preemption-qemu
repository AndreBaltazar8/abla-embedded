#!/usr/bin/env bash
# Execute existing RAM ELF on Espressif S3 QEMU; no device access or build.
#
#   tools/check-s3-preemption-qemu [ELF]
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
elf=$root/build/tests/esp32s3-boot-runtime.link.elf
if [[ $# -gt 1 ]]; then echo 'usage: check-s3-preemption-qemu [ELF]' >&2; exit 2; fi
if [[ $# -eq 1 ]]; then elf=$(readlink -f -- "$1"); fi
source "$root/tools/lib/s3-qemu.sh"

# One GDB session against the running emulator: the given commands, then the output.
debug() {
    local args=("$gdb" -q -nx -batch "$elf" -ex "target remote 127.0.0.1:$port") command
    for command in "$@"; do args+=(-ex "$command"); done
    timeout 5 "${runner[@]}" "${args[@]}"
}

start_qemu
deadline=$((SECONDS + 10))
# Generic ELF loader preserves hardware ROM; -kernel does not. No
# debugger register/memory writes: initialization must come from Abla.
debug 'info registers pc atomctl' detach
result=
while ((SECONDS <= deadline)); do
    sleep 0.1
    result=$(debug 'info registers pc atomctl' 'x/4wx &__abla_preemption_state' detach)
    # `0xADDR:  v0  v1  v2  v3` (the four words of the preemption state)
    state=$(sed -n 's/^0x[0-9a-f]*:[[:space:]]*\(0x[0-9a-f]*\)[[:space:]]*\(0x[0-9a-f]*\)[[:space:]]*\(0x[0-9a-f]*\)[[:space:]]*\(0x[0-9a-f]*\).*/\1 \2 \3 \4/p' <<<"$result" | head -n 1)
    if [[ -n $state ]]; then
        read -r first second marker _ <<<"$state"
        if ((marker == 0x50524531)); then
            if ((first < 8 || second < 8)) || ! grep -Eq '^atomctl[[:space:]]+0x15\b' <<<"$result"; then
                printf 'Pass marker contradicts counters/atomic setup:\n%s\n' "$result" >&2
                exit 1
            fi
            printf '%s\n' "$result"
            echo 'PASS: S3 QEMU executed timer-driven two-task preemption; not physical hardware proof'
            exit 0
        fi
    fi
    if [[ $result == *0xbad0000* ]]; then
        details=$(debug 'info registers cpenable exccause epc1' \
            'x/4wx &__abla_current_tasks' 'x/16wx &__abla_task_cp3' 'x/16wx &__abla_second_cp3' \
            'x/32wx (char *)&__abla_task_cp3+112' 'x/32wx (char *)&__abla_second_cp3+112' \
            'x/32wx (char *)&__abla_simd_witness+288' 'x/32wx (char *)&__abla_simd_witness+704' detach)
        printf '%s\n%s\n' "$result" "$details" >&2
        exit 1
    fi
done
printf '%s\n' "$result" >&2
echo 'timed out waiting for the preemption pass marker' >&2
exit 1
