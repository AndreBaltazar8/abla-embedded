#!/usr/bin/env bash
set -euo pipefail
# Host-only differential oracle; run inside ../ablac/shell.nix.
project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"
export ABLA_SYSROOT="${ABLA_SYSROOT:-../ablac}"
artifact=build/tests/adc-calibration-c5-oracle
mkdir -p build/tests
../ablac/build/ablac build tests/adc-calibration-c5-oracle.ab -o "$artifact.o" --target-triple x86_64-unknown-linux-gnu --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -relocation-model=static "$artifact.bc" -o "$artifact.opt.o"
cc -O2 -no-pie tests/adc-calibration-c5-oracle.c "$artifact.opt.o" -o "$artifact"
"$artifact"
