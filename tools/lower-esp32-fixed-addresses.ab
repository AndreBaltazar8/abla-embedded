// Replace classic ESP32 linker constants with ordinary Abla addresses.
//
//     tools/abla-tool lower-esp32-fixed-addresses [--write] ROOT
import "abla/io"
import "abla/text"
import "lib/recovered-text.ab"

// Espressif's classic ESP32 peripherals linker map and ROM linker map define
// these as fixed addresses. Keeping them as typed u32 values exposes all
// following field arithmetic and removes an unnecessary assembler relocation.
fun fixedAddress(symbol: string): int = when (symbol) {
    "UART0" -> 0x3FF40000
    "SPI1" -> 0x3FF42000
    "SPI0" -> 0x3FF43000
    "GPIO" -> 0x3FF44000
    "RTCCNTL" -> 0x3FF48000
    "RTCIO" -> 0x3FF48400
    "SENS" -> 0x3FF48800
    "I2S0" -> 0x3FF4F000
    "UART1" -> 0x3FF50000
    "EFUSE" -> 0x3FF5A000
    "TIMERG0" -> 0x3FF5F000
    "TIMERG1" -> 0x3FF60000
    "SPI2" -> 0x3FF64000
    "SPI3" -> 0x3FF65000
    "SYSCON" -> 0x3FF66000
    "I2S1" -> 0x3FF6D000
    "UART2" -> 0x3FF6E000
    "g_rom_spiflash_chip" -> 0x3FFAE270
    "g_rom_flashchip" -> 0x3FFAE270
    "g_rom_spiflash_dummy_len_plus" -> 0x3FFAE290
    "g_ticks_per_us_pro" -> 0x3FFE01E0
    "g_ticks_per_us_app" -> 0x3FFE40F0
    else -> -1
}

fun ownedAddress(symbol: string): string = when (symbol) {
    "IP_EVENT" -> "esp32IpEventObject"
    "WIFI_EVENT" -> "esp32WifiEventObject"
    "g_i2s" -> "esp32I2sObject"
    "range_read_addr_blocks" -> "esp32RangeReadBlocks"
    "range_write_addr_blocks" -> "esp32RangeWriteBlocks"
    "start_write_addr" -> "esp32StartWriteAddresses"
    "_xt_interrupt_table" -> "esp32InterruptTableStorage"
    "_xt_exception_table" -> "esp32ExceptionTableStorage"
    else -> ""
}

class FixedLowered(val text: string, val fixed: int, val owned: int, val needsOwned: bool)

fun fixedLowerSource(source: string): FixedLowered {
    val out: array<string> = []
    var cursor = 0
    var fixed = 0
    var owned = 0
    var needsOwned = false
    for (m in rtAddresses(source)) {
        val address = fixedAddress(m.symbol)
        val name = ownedAddress(m.symbol)
        if (address >= 0) {
            out.append(source.slice(cursor, m.start))
            out.append("u32(${address})")
            cursor = m.end
            fixed += 1
        } else if (name != "") {
            out.append(source.slice(cursor, m.start))
            out.append(name)
            cursor = m.end
            owned += 1
            needsOwned = true
        }
    }
    out.append(source.slice(cursor, source.size))
    FixedLowered(out.join(""), fixed, owned, needsOwned)
}

fun fixedEnsureImport(source: string, imported: string): string {
    val statement = "import \"${imported}\""
    if (source.contains(statement)) return source
    rtInsertAfterImports(source, statement + "\n")
}

fun main: int {
    val usage = "lower-esp32-fixed-addresses [-h] [--write] root"
    val args = rtParseArguments(["--write"], [])
    if (args.help) {
        println(usage)
        return 0
    }
    if (args.error == "" && args.positionals.size > 1) {
        return rtUsageError("lower-esp32-fixed-addresses", usage, "unrecognized arguments: ${rtRest(args.positionals, 1)}")
    }
    if (args.error != "") return rtUsageError("lower-esp32-fixed-addresses", usage, args.error)
    if (args.positionals.size == 0) {
        return rtUsageError("lower-esp32-fixed-addresses", usage, "the following arguments are required: root")
    }
    val write = args.has("--write")
    val root = rtPathText(args.positionals[0])
    val linkData = rtPathJoin(root, "link_data_esp32.ab")
    var fixedCount = 0
    var ownedCount = 0
    var changed = 0
    val files = if (rtIsDirectory(root)) rtRglobAb(root) else []
    for (path in files) {
        val read = rtRead(path)
        if (read.error != "") {
            eprintln(read.error)
            return 1
        }
        val source = read.text
        val result = fixedLowerSource(source)
        fixedCount += result.fixed
        ownedCount += result.owned
        var lowered = result.text
        if (result.needsOwned && path != linkData) {
            lowered = fixedEnsureImport(lowered, rtRelativeImport(path, linkData))
        }
        if (lowered != source) {
            changed += 1
            if (write) {
                val error = rtWrite(path, lowered)
                if (error != "") {
                    eprintln(error)
                    return 1
                }
            }
        }
    }
    val action = if (write) "lowered" else "would lower"
    println("${action} fixed=${fixedCount}, Abla-owned=${ownedCount} addresses in ${changed} files")
    0
}
