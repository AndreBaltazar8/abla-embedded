compiler_root=${ABLA_COMPILER_ROOT:-$project_root/../ablac}
if ! command -v opt >/dev/null 2>&1; then
  printf -v script_q '%q' "$project_root/tools/build-callable-example"
  printf -v example_q '%q' "$example"
  printf -v compiler_q '%q' "$compiler_root"
  exec nix-shell "$compiler_root/shell.nix" --run \
    "ABLA_COMPILER_ROOT=$compiler_q bash $script_q $example_q"
fi
export ABLA_SYSROOT="$compiler_root"
export ABLA_ESP_CPU="$example_cpu"
# The local llc wrapper feeds Xtensa assembly to its external assembler.
# RV32 uses LLVM's native RISC-V object emitter, not that Xtensa-only path.
if [[ $example_triple == xtensa-esp-unknown-elf ]]; then
  export PATH="$project_root/tools/esp-llvm-bin:$PATH"
fi
llvm_root=${ABLA_ESP_LLVM_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/abla-embedded/esp-clang-21.1.3}
runner=()
if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi
cd "$project_root"
output="build/callable-examples/$example"
mkdir -p "$output"
"$compiler_root/build/ablac" build "examples/$example/main.ab" -o "$output/source.o" \
  --target-triple "$example_triple" --object-format elf --emit object
bash tools/optimize-embedded-size "$output/source.o.ll" "$output/optimized.bc"
object_output="$output/example.o"
if $place_internal_closure; then object_output="$output/example.unplaced.o"; fi
llc -filetype=obj -O2 -mtriple="$example_triple" "${example_attributes[@]}" "$output/optimized.bc" -o "$object_output"
if $place_internal_closure; then
  python3 tools/place-internal-closure "$object_output" "$output/example.o"
  python3 tools/check-cache-internal-relocations "$output/example.o"
fi
undefined=$("${runner[@]}" "$llvm_root/bin/llvm-nm" -u "$output/example.o")
if [[ -n $undefined ]]; then
  printf 'Unexpected external dependencies:\n%s\n' "$undefined" >&2
  exit 1
fi
definitions=$("${runner[@]}" "$llvm_root/bin/llvm-nm" --extern-only --defined-only "$output/example.o" | awk '{print $NF}')
if [[ $definitions != "$entry" ]]; then
  printf 'Expected only export %s; found:\n%s\n' "$entry" "$definitions" >&2
  exit 1
fi
"${runner[@]}" "$llvm_root/bin/llvm-size" "$output/example.o"
case "$example" in
  esp32c5-sleep-measured-gpio-memory-resume|esp32c5-sleep-gpio-identified-memory-resume|esp32c5-sleep-gpio-resume|esp32c5-gpio-wake-session|esp32c5-gpio-wake|esp32c5-sleep-measured-identified-memory-resume|esp32c5-sleep-identified-memory-resume|esp32c5-flash-identified-ready|esp32c5-flash-jedec|esp32c5-sleep-qualified-memory-resume|esp32c5-flash-ready|esp32c5-flash-status|esp32c5-mspi-idle|esp32c5-sleep-memory-cycle-resume|esp32c5-sleep-memory-recovery|esp32c5-mspi-transition|esp32c5-mspi-dummy|esp32c5-mspi-timing|esp32c5-mspi-clock|esp32c5-sleep-cycle-resume|esp32c5-sleep-prepare|esp32c5-sleep-time-capture|esp32c5-sleep-time-session|esp32c5-sleep-time|esp32c5-timer-load|esp32c5-sleep-entry-session|esp32c5-sleep-recovery|esp32c5-sleep-config-close|esp32c5-clock-park|esp32c5-sleep-alarm-session|esp32c5-rtc-alarm-control|esp32c5-sleep-timed-wake|esp32c5-rtc-elapsed|esp32c5-rtc-timer|esp32c5-sleep-uarts|esp32c5-sleep-uart|esp32c5-sleep-flash-ready|esp32c5-cache-suspend|esp32c5-clock-resume|esp32c5-pll-start|esp32c5-analog-bus|esp32c5-pvt-restart|esp32c5-pvt-park|esp32c5-cpu-clock|esp32c5-sleep-entry)
    # These whole callable closures must run with flash unavailable. Reject
    # outlined code/jump tables that silently lose their retained placement.
    # Unwind metadata is not accessed by these freestanding, non-unwinding paths.
    "${runner[@]}" "$llvm_root/bin/llvm-objdump" -h "$output/example.o" | awk '
      ($NF == "TEXT" || $NF == "DATA") && $3 !~ /^0+$/ {
        if ($2 == ".eh_frame") next
        if ($NF == "TEXT" && $2 ~ /^\.iram1(\.|$)/) next
        if ($NF == "DATA" && $2 ~ /^\.dram1(\.|$)/) next
        print "Unexpected non-retained closure section: " $2 > "/dev/stderr"
        failed=1
      }
      END { exit failed }
    '
    ;;
esac
if [[ $example == paper-s3-sleep-cycle ]]; then
  bash tools/check-paper-s3-sleep-link "$output/example.o"
fi
