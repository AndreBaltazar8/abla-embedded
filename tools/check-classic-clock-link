#!/usr/bin/env bash
set -euo pipefail
# Validate an existing monolithic callable fixture against real generated layout.
# No compilation, archive input, flashing, or linker-assertion overrides.
object=${1:?usage: check-classic-clock-link OBJECT GENERATED_LD_DIR IDF_ROOT OUTPUT_ELF}
layout=${2:?generated memory.ld and sections.ld directory required}
idf=${3:?ESP-IDF source directory required}
output=${4:?output ELF required}
entry=${5:-abla_unix_time_set_target}
[[ $# -ge 4 && $# -le 5 && $entry =~ ^abla_[a-z0-9_]+$ && -f $object && -f $layout/memory.ld && -f $layout/sections.ld ]]
toolchain=${ABLA_ESP_GNU_ROOT:-$HOME/.espressif/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf}
export XTENSA_GNU_CONFIG="$toolchain/lib/xtensa_esp32.so"
runner=()
if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi
definitions=$(nm -g --defined-only "$object" | awk '{print $NF}')
[[ $definitions == "$entry" ]]
"${runner[@]}" "$toolchain/bin/xtensa-esp-elf-ld" \
    --gc-sections --no-undefined --no-relax --defsym=IDF_TARGET_ESP32=0 \
    -e "$entry" -L "$layout" \
    -L "$idf/components/esp_rom/esp32/ld" -L "$idf/components/soc/esp32/ld" \
    -T esp32.peripherals.ld -T esp32.rom.ld -T esp32.rom.api.ld \
    -T esp32.rom.libgcc.ld -T esp32.rom.libc-funcs.ld -T memory.ld -T sections.ld \
    -Map "$output.map" -o "$output" "$object"
[[ -z $(nm -u "$output") ]]
size "$output"
echo 'PASS: one application export, zero final undefined symbols, real TLS/layout assertions. Callable fixture, NOT bootable or hardware-verified.'
