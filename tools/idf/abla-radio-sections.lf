# Give the recovered radio unit (libmain.a member `unit`) its own flash_text
# statement. GNU ld's Xtensa emulation moves every section of a wildcard
# statement that loads literals from another section to the statement's front
# (xtensa_move_dependencies_to_front). In ESP-IDF's one catch-all flash_text
# statement that splits the unit's functions with and without literal pools
# ~0.5 MB apart, beyond CALL8 (-xtensa-direct-calls); in a statement of its
# own the reordering stays within the unit.
[sections:abla_radio_text]
entries:
    .literal+
    .text+

[scheme:abla_radio_flash]
entries:
    abla_radio_text -> flash_text

[mapping:abla_radio]
archive: libmain.a
entries:
    unit (abla_radio_flash);
        abla_radio_text -> flash_text SURROUND(abla_radio_text)
