// Make ESP32 exception-vector literals linkable without BFD relaxation.
//
//     tools/abla-tool tools/idf/prepare-esp32-vector-literals.ab <esp-idf-root>
//
// Rewrites components/esp_system/ld/esp32/sections.ld.in of an ESP-IDF tree so each
// vector's literal section sits 4 bytes before its code (the original is kept as
// sections.ld.in.abla-original). Running it again changes nothing.

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/arguments"

class VectorPlacement(val codeOffset: string, val literalOffset: string, val literal: string, val code: string)

fun vectorPlacements(): array<VectorPlacement> = [
    VectorPlacement("0x180", "0x17c", ".Level2InterruptVector.literal", ".Level2InterruptVector.text"),
    VectorPlacement("0x1c0", "0x1bc", ".Level3InterruptVector.literal", ".Level3InterruptVector.text"),
    VectorPlacement("0x200", "0x1fc", ".Level4InterruptVector.literal", ".Level4InterruptVector.text"),
    VectorPlacement("0x240", "0x23c", ".Level5InterruptVector.literal", ".Level5InterruptVector.text"),
    VectorPlacement("0x2c0", "0x2bc", ".NMIExceptionVector.literal", ".NMIExceptionVector.text"),
    VectorPlacement("0x300", "0x2fc", ".KernelExceptionVector.literal", ".KernelExceptionVector.text"),
    VectorPlacement("0x340", "0x33c", ".UserExceptionVector.literal", ".UserExceptionVector.text"),
    VectorPlacement("0x3C0", "0x3BC", ".DoubleExceptionVector.literal", ".DoubleExceptionVector.text")
]

class VectorLiterals(val text: string, val error: string)

// `source` with every vector's literal placement added; an error names the
// vector whose layout is not the expected one.
fun placeVectorLiterals(source: string): VectorLiterals {
    var transformed = source
    for (placement in vectorPlacements()) {
        val original = "    . = ${placement.codeOffset};\n    KEEP(*(${placement.code}));"
        val replacement = "    . = ${placement.literalOffset};\n" +
            "    KEEP(*(${placement.literal}));\n" +
            "    . = ${placement.codeOffset};\n" +
            "    KEEP(*(${placement.code}));"
        if (transformed.contains(replacement)) continue
        val found = transformed.indexOf(original)
        if (found < 0) return VectorLiterals("", "unexpected ESP-IDF vector layout near ${placement.code}")
        transformed = transformed.slice(0, found) + replacement + transformed.slice(found + original.size, transformed.size)
    }
    VectorLiterals(transformed, "")
}

fun main: int {
    if (processArgumentCount() != 1) {
        eprintln("usage: prepare-esp32-vector-literals <esp-idf-root>")
        return 2
    }
    var root = processArgument(0)
    while (root.size > 1 && root.endsWith("/")) root = root.slice(0, root.size - 1)
    val template = Path(if (root == "") "components/esp_system/ld/esp32/sections.ld.in"
        else if (root == "/") "/components/esp_system/ld/esp32/sections.ld.in"
        else "$root/components/esp_system/ld/esp32/sections.ld.in")
    if (!template.info().isFile()) {
        eprintln("missing ESP32 linker template: ${template.text}")
        return 1
    }
    val read = template.readTextResult()
    if (!read.succeeded) {
        eprintln("cannot read ${template.text}")
        return 1
    }
    val source = read.text
    val result = placeVectorLiterals(source)
    if (result.error != "") {
        eprintln(result.error)
        return 1
    }
    if (result.text != source) {
        val backup = Path("${template.text}.abla-original")
        if (!backup.exists() && !template.copyTo(backup)) {
            eprintln("cannot write ${backup.text}")
            return 1
        }
        if (!template.writeText(result.text)) {
            eprintln("cannot write ${template.text}")
            return 1
        }
    }
    0
}
