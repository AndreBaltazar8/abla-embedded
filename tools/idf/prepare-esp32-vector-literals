#!/usr/bin/env bash
# Make ESP32 exception-vector literals linkable without BFD relaxation.
#
#   prepare-esp32-vector-literals <esp-idf-root>
#
# Edits components/esp_system/ld/esp32/sections.ld.in of the given ESP-IDF tree in place
# (keeping the first original as sections.ld.in.abla-original); idempotent.
set -euo pipefail

# code offset, literal offset, literal section, code section
placements=(
    "0x180 0x17c .Level2InterruptVector.literal .Level2InterruptVector.text"
    "0x1c0 0x1bc .Level3InterruptVector.literal .Level3InterruptVector.text"
    "0x200 0x1fc .Level4InterruptVector.literal .Level4InterruptVector.text"
    "0x240 0x23c .Level5InterruptVector.literal .Level5InterruptVector.text"
    "0x2c0 0x2bc .NMIExceptionVector.literal .NMIExceptionVector.text"
    "0x300 0x2fc .KernelExceptionVector.literal .KernelExceptionVector.text"
    "0x340 0x33c .UserExceptionVector.literal .UserExceptionVector.text"
    "0x3C0 0x3BC .DoubleExceptionVector.literal .DoubleExceptionVector.text"
)

if [[ $# -ne 1 ]]; then
    echo "usage: prepare-esp32-vector-literals <esp-idf-root>" >&2
    exit 2
fi
template=$1/components/esp_system/ld/esp32/sections.ld.in
if [[ ! -f $template ]]; then
    echo "missing ESP32 linker template: $template" >&2
    exit 1
fi

IFS= read -r -d '' source <"$template" || true
transformed=$source
for placement in "${placements[@]}"; do
    read -r code_offset literal_offset literal code <<<"$placement"
    original="    . = $code_offset;"$'\n'"    KEEP(*($code));"
    replacement="    . = $literal_offset;"$'\n'"    KEEP(*($literal));"$'\n'"    . = $code_offset;"$'\n'"    KEEP(*($code));"
    if [[ $transformed == *"$replacement"* ]]; then
        continue
    fi
    if [[ $transformed != *"$original"* ]]; then
        echo "unexpected ESP-IDF vector layout near $code" >&2
        exit 1
    fi
    transformed=${transformed/"$original"/"$replacement"}
done

if [[ $transformed != "$source" ]]; then
    backup=$template.abla-original
    if [[ ! -e $backup ]]; then
        cp -- "$template" "$backup"
    fi
    printf '%s' "$transformed" >"$template"
fi
