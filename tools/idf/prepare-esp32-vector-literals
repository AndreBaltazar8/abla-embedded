#!/usr/bin/env python3
"""Make ESP32 exception-vector literals linkable without BFD relaxation."""

from pathlib import Path
import shutil
import sys


PLACEMENTS = (
    ("0x180", "0x17c", ".Level2InterruptVector.literal", ".Level2InterruptVector.text"),
    ("0x1c0", "0x1bc", ".Level3InterruptVector.literal", ".Level3InterruptVector.text"),
    ("0x200", "0x1fc", ".Level4InterruptVector.literal", ".Level4InterruptVector.text"),
    ("0x240", "0x23c", ".Level5InterruptVector.literal", ".Level5InterruptVector.text"),
    ("0x2c0", "0x2bc", ".NMIExceptionVector.literal", ".NMIExceptionVector.text"),
    ("0x300", "0x2fc", ".KernelExceptionVector.literal", ".KernelExceptionVector.text"),
    ("0x340", "0x33c", ".UserExceptionVector.literal", ".UserExceptionVector.text"),
    ("0x3C0", "0x3BC", ".DoubleExceptionVector.literal", ".DoubleExceptionVector.text"),
)


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: prepare-esp32-vector-literals <esp-idf-root>", file=sys.stderr)
        return 2
    template = Path(sys.argv[1]) / "components/esp_system/ld/esp32/sections.ld.in"
    if not template.is_file():
        print(f"missing ESP32 linker template: {template}", file=sys.stderr)
        return 1

    source = template.read_text()
    transformed = source
    for code_offset, literal_offset, literal, code in PLACEMENTS:
        original = f"    . = {code_offset};\n    KEEP(*({code}));"
        replacement = (
            f"    . = {literal_offset};\n"
            f"    KEEP(*({literal}));\n"
            f"    . = {code_offset};\n"
            f"    KEEP(*({code}));"
        )
        if replacement in transformed:
            continue
        if original not in transformed:
            print(f"unexpected ESP-IDF vector layout near {code}", file=sys.stderr)
            return 1
        transformed = transformed.replace(original, replacement, 1)

    if transformed != source:
        backup = template.with_suffix(template.suffix + ".abla-original")
        if not backup.exists():
            shutil.copyfile(template, backup)
        template.write_text(transformed)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
