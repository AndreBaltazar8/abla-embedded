# Preserve SDK section contracts when their implementations live in the one
# monolithic Abla application object rather than their original archive.
[sections:abla_phy_iram]
entries:
    .phyiram+

[scheme:abla_phy_placement]
entries:
    if IDF_TARGET_ESP32 = y && ESP_WIFI_SLP_IRAM_OPT = y:
        abla_phy_iram -> iram0_text
    elif ESP_PHY_IRAM_OPT = y:
        abla_phy_iram -> iram0_text
    else:
        abla_phy_iram -> flash_text

[mapping:abla_application_phy]
archive: libmain.a
entries:
    abla_app (abla_phy_placement)
