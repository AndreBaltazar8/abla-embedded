#!/usr/bin/env python3
"""Validate linked first-task transfer ABI and destination, not hardware execution."""
import struct,sys
from pathlib import Path
d=Path(sys.argv[1]).read_bytes()
assert d[:6] == b'\x7fELF\x01\x01' and struct.unpack_from('<H',d,16)[0] == 2
t=struct.unpack_from('<I',d,32)[0]; stride,count,ni=struct.unpack_from('<HHH',d,46)
assert stride == 40
hs=[struct.unpack_from('<10I',d,t+i*40) for i in range(count)]
n=hs[ni]; names=d[n[4]:n[4]+n[5]]
sections={names[h[0]:].split(b'\0',1)[0].decode():(i,h) for i,h in enumerate(hs)}
def function(section):
    index,h=sections[section]; found=[]
    for s in hs:
        if s[1] != 2: continue
        for p in range(s[4],s[4]+s[5],16):
            _,value,size,info,_,si=struct.unpack_from('<IIIBBH',d,p)
            if si == index and info & 15 == 2: found.append((value,size))
    assert len(found) == 1
    value,size=found[0]
    return value,d[h[4]+value-h[3]:h[4]+value-h[3]+size]
pc,c=function('.iram1.abla.s3FirstTask')
target,_=function('.iram1.abla.s3ContextReturns')
def ins(words): return b''.join(bytes.fromhex(w)[::-1] for w in words.split())
assert len(c) == 54
assert c[:42] == ins('004136 13d120 006f00 f00c 13e600 002010 000c 13e400 13e000 134800 002010 100c 134900 002010 03d110')
word=int.from_bytes(c[42:45],'little'); assert word & 255 == 1
immediate=word>>8
if immediate & 32768: immediate-=65536
literal=((pc+45)&~3)+immediate*4
_,h=sections['.iram1.abla.s3FirstTask']
assert h[3] <= literal and literal+4 <= h[3]+h[5]
assert struct.unpack_from('<I',d,h[4]+literal-h[3])[0] == 0x4003F
assert c[45:51] == ins('13e600 002010')
word=int.from_bytes(c[51:54],'little'); displacement=word>>6
if displacement & (1<<17): displacement-=1<<18
assert word & 63 == 6 and pc+55+displacement == target
print('PASS: windowed launch argument preserved across synchronized window reset; exact frame-SP/PS and linked return1 jump; not hardware proof')
