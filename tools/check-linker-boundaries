#!/usr/bin/env bash
set -euo pipefail

link_map=${1:?usage: check-linker-boundaries <GNU-link-map> [object-name] [object-file]}
object_name=${2:-abla_app.o}
object_file=${3:-$(dirname "$link_map")/$object_name}

if [[ ! -s $link_map ]]; then
    echo "link map is missing or empty: $link_map" >&2
    exit 2
fi

if [[ ! -s $object_file ]]; then
    echo "object file is missing or empty: $object_file" >&2
    exit 2
fi

defined_symbols=$(mktemp)
trap 'rm -f -- "$defined_symbols"' EXIT
nm -g --defined-only "$object_file" | awk 'NF { print $NF }' > "$defined_symbols"

audit=$(awk -v owner="$object_name" '
    NR == FNR {
        owned[$1] = 1
        next
    }

    function finishSymbol() {
        if (!active) return
        definitions++
        if (outsideReference) {
            justified++
        } else {
            print "unreferenced\t" symbol
        }
    }

    /^Cross Reference Table$/ {
        crossReference = 1
        next
    }

    !crossReference || /^Symbol[[:space:]]+File$/ || NF == 0 {
        next
    }

    $0 !~ /^[[:space:]]/ {
        finishSymbol()
        symbol = $1
        active = ($2 == owner && symbol in owned)
        outsideReference = 0
        next
    }

    active && $1 != owner {
        outsideReference = 1
    }

    END {
        finishSymbol()
        if (!crossReference) exit 2
        print "summary\t" definitions + 0 "\t" justified + 0
    }
' "$defined_symbols" "$link_map") || {
    echo "link map has no GNU cross-reference table: $link_map" >&2
    exit 2
}

unreferenced=$(awk -F '\t' '$1 == "unreferenced" { print $2 }' <<<"$audit")
definitions=$(awk -F '\t' '$1 == "summary" { print $2 }' <<<"$audit")
justified=$(awk -F '\t' '$1 == "summary" { print $3 }' <<<"$audit")

if [[ -n $unreferenced ]]; then
    echo "$object_name exposes definitions with no outside caller:" >&2
    sed 's/^/  /' <<<"$unreferenced" >&2
    exit 1
fi

echo "$object_name has $definitions linker-visible definitions; all $justified have outside callers"
