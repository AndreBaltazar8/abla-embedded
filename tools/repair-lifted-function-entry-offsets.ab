// Remove verified Xtensa literal-pool entry offsets from lifted Abla pointers.
//
//     tools/abla-tool repair-lifted-function-entry-offsets [--write] [ROOT]

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/integer"
import "abla/process/arguments"
import "lib/abfiles.ab"

fun entryOffsets(): Map<string, int> {
    val offsets: Map<string, int> = Map()
    offsets.set("esp32Internal_Labla_recovered_hostap_local_text_is_esp_manufacturer_oui_5020e43800", 4)
    offsets.set("esp32Internal_Labla_recovered_hostap_local_text_is_non_esp_oui_c4fef6d91d", 8)
    offsets.set("esp32Internal_Labla_recovered_hostap_local_text_clear_mac_queue_8b362539fc", 28)
    offsets.set("esp32Internal_Labla_recovered_timer_local_text_ieee80211_hostap_handle_47b011f7c1", 20)
    offsets.set("esp32Internal_Labla_recovered_timer_local_text_ieee80211_send_beacon_4697c14d4c", 20)
    offsets.set("esp32Internal_Labla_recovered_nan_common_local_text_nan_is_pkt_in_valid_slot_8eb8856e97", 8)
    offsets.set("esp32RecoveredTextMtSetLmk", 64)
    offsets.set("esp32RecoveredTextMtClearLmk", 8)
    offsets.set("esp32RecoveredTextMtCopyPeer", 36)
    offsets.set("esp32RecoveredTextMtSendCb", 28)
    offsets.set("esp32RecoveredTextMtRecvCb", 4)
    offsets.set("esp32RecoveredTextMtGetLmk", 20)
    offsets.set("esp32RecoveredTextMtGetKeyIdxConstprop0", 24)
    offsets.set("esp32RecoveredTextEspMeshSetIeConstprop0Isra0", 16)
    offsets.set("esp32RecoveredTextEspMeshClearParentConstprop0Isra0", 8)
    offsets.set("esp32RecoveredTextEspMeshClearParentPart0", 84)
    offsets.set("esp32RecoveredTextMeshNwkFindConflictRootsPart0", 4)
    offsets.set("esp32RecoveredTextWifiVndExtMeshRootsFreePart0", 12)
    offsets.set("esp32RecoveredTextMeshRootsProcessFixedPart0", 12)
    offsets
}

private fun isSpace(byte: int): bool = byte == 32 || (byte >= 9 && byte <= 13)

private fun isWord(byte: int): bool =
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95

private fun isDigit(byte: int): bool = byte >= 48 && byte <= 57

private fun skipWord(line: string, from: int): int {
    var index = from
    while (index < line.size && isWord(line[index])) index = index + 1
    index
}

private fun onlySpace(line: string, from: int): bool {
    var index = from
    while (index < line.size) {
        if (!isSpace(line[index])) return false
        index = index + 1
    }
    true
}

// `\s*(\w+) = u32\(nativeFunctionAddress\(([^)]+)\)\)\s*$`: register, function.
private fun addressLine(line: string): array<string> {
    val none: array<string> = []
    var index = 0
    while (index < line.size && isSpace(line[index])) index = index + 1
    var after = skipWord(line, index)
    if (after == index) return none
    val register = line.slice(index, after)
    val marker = " = u32(nativeFunctionAddress("
    if (!line.slice(after, line.size).startsWith(marker)) return none
    index = after + marker.size
    after = index
    while (after < line.size && line[after] != 41) after = after + 1
    if (after == index || after >= line.size) return none
    val function = line.slice(index, after)
    if (!line.slice(after, line.size).startsWith("))")) return none
    if (!onlySpace(line, after + 2)) return none
    [register, function]
}

// `\s*(\w+) = \1 \+ u32\((\d+)\)\s*$`: register, offset.
private fun offsetLine(line: string): array<string> {
    val none: array<string> = []
    var index = 0
    while (index < line.size && isSpace(line[index])) index = index + 1
    var after = skipWord(line, index)
    if (after == index) return none
    val register = line.slice(index, after)
    val middle = " = $register + u32("
    if (!line.slice(after, line.size).startsWith(middle)) return none
    index = after + middle.size
    after = index
    while (after < line.size && isDigit(line[after])) after = after + 1
    if (after == index || after >= line.size || line[after] != 41) return none
    if (!onlySpace(line, after + 1)) return none
    [register, line.slice(index, after)]
}

class EntryRepair(val text: string, val changes: int)

// `splitlines(keepends=True)` for "\n" only: every piece but a last unterminated one ends with it.
private fun linesKeepingEnds(source: string): array<string> {
    val pieces = source.split("\n")
    val lines: array<string> = []
    var index = 0
    while (index < pieces.size) {
        if (index + 1 < pieces.size) lines.append(pieces[index] + "\n")
        else if (pieces[index] != "") lines.append(pieces[index])
        index = index + 1
    }
    lines
}

private fun withoutEnd(line: string): string =
    if (line.endsWith("\n")) line.slice(0, line.size - 1) else line

fun repairEntryOffsets(source: string, offsets: Map<string, int>): EntryRepair {
    val lines = linesKeepingEnds(source)
    val output: array<string> = []
    var changes = 0
    var index = 0
    while (index < lines.size) {
        output.append(lines[index])
        val address = addressLine(withoutEnd(lines[index]))
        if (address.size == 2 && index + 1 < lines.size) {
            val offset = offsetLine(withoutEnd(lines[index + 1]))
            val expected = offsets.get(address[1])
            if (offset.size == 2 && offset[0] == address[0] && expected != null &&
                expected == offset[1].parseInt()) {
                changes = changes + 1
                index = index + 1
            }
        }
        index = index + 1
    }
    EntryRepair(output.join(""), changes)
}

fun main: int {
    var write = false
    var root = "src/esp32"
    var index = 0
    while (index < processArgumentCount()) {
        val argument = processArgument(index)
        if (argument == "--write") write = true
        else root = argument
        index = index + 1
    }
    val offsets = entryOffsets()
    val files: array<string> = []
    rglobAb(root, files)
    var total = 0
    for (file in files) {
        val repaired = repairEntryOffsets(Path(file).readText(), offsets)
        if (repaired.changes > 0) {
            if (write) Path(file).writeText(repaired.text)
            println("$file: ${repaired.changes}")
            total = total + repaired.changes
        }
    }
    println("total: $total")
    0
}
