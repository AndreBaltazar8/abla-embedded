#!/usr/bin/env bash
set -euo pipefail
if [[ $# -ne 1 ]]; then
    echo 'usage: bash tools/check-s3-cache-link COMPOSED_MSPI_OBJECT.o' >&2
    exit 2
fi
project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
toolchain_root=${ABLA_ESP_LLVM_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/abla-embedded/esp-clang-21.1.3}
runner=()
if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi
object=$(realpath -- "$1")
cd "$project_root"
python3 tools/check-cache-internal-object "$object"
mkdir -p build/tests
"${runner[@]}" "$toolchain_root/bin/xtensa-esp32s3-elf-clang-ld" \
    -T tests/s3-cache-closure.ld --no-undefined \
    -Map=build/tests/s3-cache-closure.map \
    -o build/tests/s3-cache-closure.elf "$object"
python3 tools/check-cache-internal-object build/tests/s3-cache-closure.elf
undefined=$("${runner[@]}" "$toolchain_root/bin/llvm-nm" -u build/tests/s3-cache-closure.elf)
test -z "$undefined"
"${runner[@]}" "$toolchain_root/bin/llvm-size" build/tests/s3-cache-closure.elf
echo 'PASS: link-only MSPI closure, disjoint S3 internal SRAM slices; NOT bootable or flashable firmware'
