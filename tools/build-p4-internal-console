#!/usr/bin/env bash
# Pinned compiler Nix shell; produces an ELF only. Never opens a serial device.
set -euo pipefail
cd "$(dirname "$0")/.."
export ABLA_SYSROOT="${ABLA_SYSROOT:-../ablac}"
if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo 'usage: build-p4-internal-console 1|3 [console|tab5-control|tab5-panel|psram|tab5-video|tab5-pwm]' >&2
    exit 2
fi
case "${1:-}" in
    1) ram_base=0x4ff10000 ;;
    3) ram_base=0x4ff80000 ;;
    *) echo 'expected P4 register layout1 or3; verify silicon revision' >&2; exit 2 ;;
esac
case "${2:-console}" in
    console) source_file=examples/p4-internal-console/main.ab; output_name=p4-internal-console ;;
    tab5-control) source_file=examples/tab5-control-bringup/main.ab; output_name=tab5-control-bringup ;;
    tab5-panel) source_file=examples/tab5-panel-bringup/main.ab; output_name=tab5-panel-bringup ;;
    psram) source_file=examples/p4-psram-bringup/main.ab; output_name=p4-psram-bringup ;;
    tab5-video) source_file=examples/tab5-video-bringup/main.ab; output_name=tab5-video-bringup ;;
    tab5-pwm) source_file=examples/tab5-pwm-bringup/main.ab; output_name=tab5-pwm-bringup ;;
    *) echo 'unsupported application (console|tab5-control|tab5-panel|psram|tab5-video|tab5-pwm)' >&2; exit 2 ;;
esac
artifact=build/$output_name/layout-$1/application
mkdir -p "$(dirname "$artifact")"
../ablac/build/ablac build "$source_file" -o "$artifact.o" \
    --target-triple riscv32-unknown-none-elf --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -mtriple=riscv32-unknown-none-elf -mattr=+m,+a,+zicsr "$artifact.bc" -o "$artifact.opt.o"
test "$(nm -g --defined-only "$artifact.opt.o" | awk '{print $3}' | sort | paste -sd ' ')" = 'abla_p4_application_entry abla_p4_application_main'
# Only linker-owned data/stack boundaries may be undefined before final link.
unexpected=$(nm -u "$artifact.opt.o" | awk '{print $NF}' | rg -v '^(__abla_gp|__abla_stack_top|__abla_bss_start|__abla_bss_end)$' || true)
test -z "$unexpected"
ld.lld -m elf32lriscv --no-undefined --defsym="__abla_ram_base=$ram_base" -T examples/p4-internal-console/link.ld \
    -Map="$artifact.map" -o "$artifact.elf" "$artifact.opt.o"
test -z "$(nm -u "$artifact.elf")"
python3 tools/check-cache-internal-object "$artifact.elf"
python3 tools/check-p4-internal-entry "$artifact.elf"
llvm-objdump -dr "$artifact.elf" > "$artifact.dis"
llvm-readelf -l "$artifact.elf"
llvm-size "$artifact.elf"
echo 'ELF only: boot/console assumptions and ESP image packaging NOT physically verified. Do not flash Atom.'
