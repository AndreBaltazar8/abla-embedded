// Repack an unsigned, unencrypted ESP32 application image; never flash it.
//
// Preserve every non-padding address/byte, header field except segment count,
// entrypoint, XOR checksum and appended SHA256. Signed/trailing data is rejected.
// Use nearest modulo-64KiB alignment even just after crossing a page boundary.
//
//     tools/abla-tool repack-esp32-image INPUT OUTPUT
//
// OUTPUT must not exist. The functions below are the library tests/esp32-image-repack.ab
// uses; every error is a non-empty `error` of a result (the Python raised ValueError).

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/bytes"
import "abla/crypto"
import "abla/process/arguments"
import "lib/elf.ab"

val ESP_IMAGE_PAGE = 65536

class ImageSegment(val address: int, val payload: string)

// `header` is the first 24 bytes; `segments` the normalized non-padding load segments.
class ParsedImage(val header: string, val segments: array<ImageSegment>, val error: string)

class RepackResult(val data: string, val error: string)

fun imageZeros(count: int): string = byteEncode(0).repeat(count)

fun imageModulo(value: int, modulus: int): int = ((value % modulus) + modulus) % modulus

fun imageIsFlash(address: int): bool =
    (address >= 0x3F400000 && address < 0x3F800000) || (address >= 0x400D0000 && address < 0x40400000)

fun imageXor(data: string, start: int): int {
    var checksum = start
    var index = 0
    while (index < data.size) {
        checksum = checksum ^ data[index]
        index = index + 1
    }
    checksum
}

fun imageAnyNonzero(data: string): bool {
    var index = 0
    while (index < data.size) {
        if (data[index] != 0) return true
        index = index + 1
    }
    false
}

fun imageParseFail(message: string): ParsedImage = ParsedImage("", [], message)

fun imageSegmentsEqual(left: array<ImageSegment>, right: array<ImageSegment>): bool {
    if (left.size != right.size) return false
    var index = 0
    while (index < left.size) {
        if (left[index].address != right[index].address || left[index].payload != right[index].payload) return false
        index = index + 1
    }
    true
}

// Sorted by address; adjacent segments merge. Overlap is an error.
fun imageNormalize(segments: array<ImageSegment>): ParsedImage {
    val sorted: array<ImageSegment> = []
    for (segment in segments) {
        sorted.append(segment)
        var at = sorted.size - 1
        while (at > 0 && sorted[at - 1].address > sorted[at].address) {
            val moved = sorted[at - 1]
            sorted[at - 1] = sorted[at]
            sorted[at] = moved
            at = at - 1
        }
    }
    val result: array<ImageSegment> = []
    for (segment in sorted) {
        if (result.size > 0) {
            val last = result[result.size - 1]
            val end = last.address + last.payload.size
            if (end > segment.address) return imageParseFail("overlapping load segments")
            if (end == segment.address) {
                result[result.size - 1] = ImageSegment(last.address, last.payload + segment.payload)
                continue
            }
        }
        result.append(segment)
    }
    ParsedImage("", result, "")
}

fun imageParse(data: string): ParsedImage {
    if (data.size < 64 || data[0] != 0xE9 || data[1] < 1 || data[1] > 16) {
        return imageParseFail("invalid ESP image header")
    }
    if (data[12] != 0 || data[13] != 0 || data[23] != 1) {
        return imageParseFail("only ESP32 images with appended SHA256 are supported")
    }
    var cursor = 24
    var checksum = 0xEF
    val segments: array<ImageSegment> = []
    var remaining = data[1]
    while (remaining > 0) {
        remaining = remaining - 1
        if (cursor + 8 > data.size) return imageParseFail("truncated segment header")
        val address = elfU32(data, cursor)
        val size = elfU32(data, cursor + 4)
        cursor = cursor + 8
        if (size % 4 != 0 || cursor + size > data.size || address + size > 0x100000000) {
            return imageParseFail("invalid segment span")
        }
        val payload = data.slice(cursor, cursor + size)
        if (imageIsFlash(address) && cursor % ESP_IMAGE_PAGE != address % ESP_IMAGE_PAGE) {
            return imageParseFail("misaligned flash segment")
        }
        if (address == 0 && imageAnyNonzero(payload)) return imageParseFail("nonzero padding payload")
        checksum = imageXor(payload, checksum)
        if (address != 0) {
            if (size == 0) return imageParseFail("empty load segment")
            segments.append(ImageSegment(address, payload))
        }
        cursor = cursor + size
    }
    val checksumOffset = cursor + (15 - cursor % 16)
    if (data.size != checksumOffset + 33) return imageParseFail("signed, padded, or trailing data is unsupported")
    if (imageAnyNonzero(elfSlice(data, cursor, checksumOffset)) || data[checksumOffset] != checksum) {
        return imageParseFail("invalid XOR footer")
    }
    if (sha256(data.slice(0, data.size - 32)) != data.slice(data.size - 32, data.size)) {
        return imageParseFail("invalid SHA256 footer")
    }
    val normalized = imageNormalize(segments)
    ParsedImage(data.slice(0, 24), normalized.segments, normalized.error)
}

fun imageRepackFail(message: string): RepackResult = RepackResult("", message)

// Builds the segments of the new image behind the header and tracks checksum and count.
class ImageEmitter(var output: string, var checksum: int, var count: int) {
    fun emit(address: int, payload: string): void {
        this.output = this.output + elfBytes32(address) + elfBytes32(payload.size) + payload
        this.checksum = imageXor(payload, this.checksum)
        this.count = this.count + 1
    }
}

fun imageRepack(data: string): RepackResult {
    val parsed = imageParse(data)
    if (parsed.error != "") return imageRepackFail(parsed.error)
    val header = parsed.header
    val original = parsed.segments
    val mapped: array<ImageSegment> = []
    var ram: array<ImageSegment> = []
    for (segment in original) {
        if (imageIsFlash(segment.address)) mapped.append(segment) else ram.append(segment)
    }
    val emitter = ImageEmitter(header, 0xEF, 0)
    var ramHead = 0
    for (segment in mapped) {
        while ((emitter.output.size + 8) % ESP_IMAGE_PAGE != segment.address % ESP_IMAGE_PAGE) {
            val gap = imageModulo(segment.address - emitter.output.size - 8, ESP_IMAGE_PAGE)
            val padding = imageModulo(gap - 8, ESP_IMAGE_PAGE)
            if (ramHead < ram.size && padding > 8) {
                val chunk = ram[ramHead]
                val used = if (chunk.payload.size < padding) chunk.payload.size else padding
                emitter.emit(chunk.address, chunk.payload.slice(0, used))
                if (used < chunk.payload.size) {
                    ram[ramHead] = ImageSegment(chunk.address + used, chunk.payload.slice(used, chunk.payload.size))
                } else {
                    ramHead = ramHead + 1
                }
            } else {
                emitter.emit(0, imageZeros(padding))
            }
        }
        emitter.emit(segment.address, segment.payload)
    }
    while (ramHead < ram.size) {
        emitter.emit(ram[ramHead].address, ram[ramHead].payload)
        ramHead = ramHead + 1
    }
    if (emitter.count < 1 || emitter.count > 16) return imageRepackFail("repacked image exceeds ESP32 segment limit")
    var output = emitter.output
    output = output.slice(0, 1) + byteEncode(emitter.count) + output.slice(2, output.size)
    output = output + imageZeros(15 - output.size % 16) + byteEncode(emitter.checksum)
    output = output + sha256(output)
    val verified = imageParse(output)
    if (verified.error != "") return imageRepackFail(verified.error)
    if (verified.header.slice(0, 1) + verified.header.slice(2, 24) != header.slice(0, 1) + header.slice(2, 24) ||
        !imageSegmentsEqual(verified.segments, original)) {
        return imageRepackFail("repack changed load bytes or header fields")
    }
    if (output.size > data.size) return imageRepackFail("repack would enlarge image")
    RepackResult(output, "")
}

fun main: int {
    if (processArgumentCount() != 2) {
        eprintln("usage: repack-esp32-image INPUT OUTPUT")
        return 2
    }
    val input = Path(processArgument(0)).readTextResult()
    if (!input.succeeded) {
        eprintln("cannot read ${processArgument(0)}")
        return 1
    }
    val result = imageRepack(input.text)
    if (result.error != "") {
        eprintln("error: ${result.error}")
        return 1
    }
    // Never overwrite an original, signed release, or previous comparison.
    if (!Path(processArgument(1)).createExclusive(result.data, 0o666)) {
        eprintln("cannot create ${processArgument(1)} (it must not exist)")
        return 1
    }
    println("PASS: ${input.text.size} -> ${result.data.size} bytes; identical load addresses/data, valid checksums; not flashed")
    0
}
