#!/usr/bin/env python3
"""Relax out-of-range Xtensa conditional branches, as GNU as does.

LLVM 23.1's Xtensa assembler reports `fixup value out of range` instead of
relaxing a conditional branch whose target is beyond its 8- or 12-bit reach.
Recovered raw-assembly bodies hit this when they grow (for example
`call8 f` recovered as `movi a8, f; callx8 a8`). Usage:

  relax-xtensa-branches FILE.s LINE...

rewrites each listed line `bCC operands, target` in place as

  bNOT-CC operands, .Labla_relax_N
  j target
.Labla_relax_N:

(N unique across repeated runs on the same file), which is GNU as's own relaxation: same behavior, one extra jump on the
originally taken path.
"""

from __future__ import annotations

import pathlib
import re
import sys

INVERSE = {
    "beq": "bne", "bne": "beq", "blt": "bge", "bge": "blt",
    "bltu": "bgeu", "bgeu": "bltu", "beqi": "bnei", "bnei": "beqi",
    "blti": "bgei", "bgei": "blti", "bltui": "bgeui", "bgeui": "bltui",
    "beqz": "bnez", "bnez": "beqz", "bltz": "bgez", "bgez": "bltz",
    "ball": "bnall", "bnall": "ball", "bany": "bnone", "bnone": "bany",
    "bbc": "bbs", "bbs": "bbc", "bbci": "bbsi", "bbsi": "bbci",
    "bbci.l": "bbsi.l", "bbsi.l": "bbci.l",
}
BRANCH = re.compile(r"^(?P<indent>\s*)(?P<op>b[a-z.]+)\s+(?P<operands>.*),\s*(?P<target>[^\s,]+)\s*$")


def main() -> int:
    if len(sys.argv) < 3:
        print(__doc__, file=sys.stderr)
        return 2
    path = pathlib.Path(sys.argv[1])
    lines = path.read_text().split("\n")
    relaxed = 0
    existing = sum(1 for line in lines if re.match(r"^\.Labla_relax_\d+:", line))
    for number in sorted({int(value) for value in sys.argv[2:]}, reverse=True):
        match = BRANCH.match(lines[number - 1])
        op = match and match.group("op").removesuffix(".n")
        if not match or op not in INVERSE:
            print(f"relax-xtensa-branches: line {number} is not a conditional branch: "
                  f"{lines[number - 1].strip()}", file=sys.stderr)
            return 1
        label = f".Labla_relax_{existing + relaxed}"
        indent = match.group("indent") or "\t"
        lines[number - 1:number] = [
            f"{indent}{INVERSE[op]}\t{match.group('operands')}, {label}",
            f"{indent}j\t{match.group('target')}",
            f"{label}:",
        ]
        relaxed += 1
    path.write_text("\n".join(lines))
    print(f"relaxed {relaxed} branch(es)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
