#!/usr/bin/env bash
set -euo pipefail

# Code generation uses the same LLVM 23 that ablac optimizes with (built with
# the Xtensa target, see ablac/nix/llvm.nix), so bitcode never crosses LLVM
# versions. Espressif's toolchain is only used as an external Xtensa assembler
# for boot/vector code whose inline assembly relies on GNU-as layout
# directives (`.literal_position`, `.begin no-transform`).
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
assembler_root="${ABLA_ESP_LLVM_ROOT:-$cache_root/abla-embedded/esp-clang-21.1.3}"
cpu="${ABLA_ESP_CPU:-esp32}"
script_root=$(cd -- "$(dirname -- "$0")" && pwd -P)

# Find the next llc on PATH after this wrapper.
llc=""
IFS=: read -r -a path_entries <<< "$PATH"
for entry in "${path_entries[@]}"; do
    [[ -n $entry && -x $entry/llc ]] || continue
    [[ $(cd -- "$entry" && pwd -P) == "$script_root" ]] && continue
    llc="$entry/llc"
    break
done
if [[ -z $llc ]]; then
    echo "esp-llvm-bin/llc: no LLVM llc found on PATH" >&2
    exit 127
fi
tool_root=$(dirname -- "$llc")

# LLVM 23.1 has no esp32s3 CPU yet (upstream main does). The S3 core is the
# ESP32 core without the double-precision accelerator; Abla does not use the
# S3-only vector extension.
case "$cpu" in
    esp32) target=(-mcpu=esp32) ;;
    esp32s2) target=(-mcpu=esp32s2) ;;
    esp32s3) target=(-mcpu=esp32 -mattr=-dfpaccel) ;;
    esp32c2|esp32c3) target=(-mcpu=generic-rv32 -mattr=+m,+c,+zicsr,+zifencei) ;;
    esp32c5|esp32c6|esp32c61|esp32h2)
        target=(-mcpu=generic-rv32 -mattr=+m,+a,+c,+zicsr,+zifencei) ;;
    esp32p4) target=(-mcpu=generic-rv32 -mattr=+m,+a,+c,+f,+zicsr,+zifencei) ;;
    *) echo "esp-llvm-bin/llc: unknown ABLA_ESP_CPU '$cpu'" >&2; exit 2 ;;
esac

arguments=()
output=""
expect_output=false
filetype=""
inputs=()
for argument in "$@"; do
    if $expect_output; then
        output="$argument"
        expect_output=false
    elif [[ "$argument" == "-o" ]]; then
        expect_output=true
    elif [[ "$argument" == -o=* ]]; then
        output="${argument#-o=}"
    fi
    if [[ "$argument" == -filetype=* ]]; then
        filetype="${argument#-filetype=}"
    fi
    if [[ ($argument == *.bc || $argument == *.ll) && -f $argument ]]; then
        inputs+=("$argument")
    fi
    if [[ "$argument" != "--threads=1" && "$argument" != "-relocation-model=pic" ]]; then
        arguments+=("$argument")
    fi
done
common=("${target[@]}" -relocation-model=static --function-sections --data-sections)

# Boot/vector code marks its assembly layout for the external assembler.
needs_external_assembler=false
if [[ $filetype == obj && -n $output && ${#inputs[@]} -gt 0 && $cpu == esp32* && $cpu != esp32c* && $cpu != esp32h* && $cpu != esp32p* ]]; then
    for input in "${inputs[@]}"; do
        if { if [[ $input == *.bc ]]; then "$tool_root/llvm-dis" "$input" -o -; else cat -- "$input"; fi; } |
            grep -q 'ABLA_XTENSA_\|WindowVectors'; then
            needs_external_assembler=true
        fi
    done
fi

if $needs_external_assembler; then
    if [[ ${ABLA_KEEP_XTENSA_INPUT:-0} == 1 ]]; then
        for input in "${inputs[@]}"; do cp -- "$input" "$output.abla-input.${input##*.}"; done
    fi
    runner=()
    if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi
    output_directory=$(cd -- "$(dirname -- "$output")" && pwd -P)
    temporary_assembly=$(mktemp "$output_directory/.abla-xtensa.XXXXXX.s")
    if [[ ${ABLA_KEEP_XTENSA_ASSEMBLY:-0} != 1 ]]; then
        trap 'status=$?; if (( status == 0 )); then rm -f -- "$temporary_assembly"; fi; exit "$status"' EXIT
    fi
    assembly_arguments=()
    skip_output=false
    for argument in "${arguments[@]}"; do
        if $skip_output; then
            skip_output=false
        elif [[ $argument == -o ]]; then
            skip_output=true
        elif [[ $argument == -o=* ]]; then
            :
        elif [[ $argument == -filetype=obj ]]; then
            assembly_arguments+=("-filetype=asm")
        else
            assembly_arguments+=("$argument")
        fi
    done
    "$llc" "${common[@]}" "${assembly_arguments[@]}" -o "$temporary_assembly"
    "$script_root/prepare-xtensa-assembly" < "$temporary_assembly" | \
    "${runner[@]}" "$assembler_root/bin/xtensa-${cpu}-elf-clang-as" \
        --text-section-literals -o "$output" -c -
elif [[ $filetype == obj && -n $output && ${#inputs[@]} -gt 0 && $cpu == esp32* && $cpu != esp32c* && $cpu != esp32h* && $cpu != esp32p* &&
        ${ABLA_XTENSA_NARROW:-1} == 1 ]]; then
    # Upstream LLVM rarely selects Code Density (16-bit) encodings; emit
    # assembly, rewrite exact narrow forms, assemble with the same LLVM.
    output_directory=$(cd -- "$(dirname -- "$output")" && pwd -P)
    temporary_assembly=$(mktemp "$output_directory/.abla-xtensa.XXXXXX.s")
    trap 'rm -f -- "$temporary_assembly"' EXIT
    assembly_arguments=()
    skip_output=false
    for argument in "${arguments[@]}"; do
        if $skip_output; then
            skip_output=false
        elif [[ $argument == -o ]]; then
            skip_output=true
        elif [[ $argument == -o=* ]]; then
            :
        elif [[ $argument == -filetype=obj ]]; then
            assembly_arguments+=("-filetype=asm")
        else
            assembly_arguments+=("$argument")
        fi
    done
    # LLVM 23.1 cannot select a large constant folded into ADDX2/4/8; hide
    # the constant in the failing function behind an inline-asm identity and
    # retry (see opaque-xtensa-constant).
    if [[ ${ABLA_KEEP_XTENSA_INPUT:-0} == 1 ]]; then
        for input in "${inputs[@]}"; do cp -- "$input" "$output.abla-input.${input##*.}"; done
    fi
    temporary_errors="$temporary_assembly.err"
    temporary_inputs=()
    trap 'rm -f -- "$temporary_assembly" "$temporary_errors" "${temporary_inputs[@]}"' EXIT
    for attempt in $(seq 1 64); do
        if "$llc" "${common[@]}" "${assembly_arguments[@]}" -o "$temporary_assembly" 2> "$temporary_errors"; then
            break
        fi
        constant=$(grep -o 'Cannot select: [^ ]* i32 = Constant<-\?[0-9]*>' "$temporary_errors" | head -1 | grep -o '<-\?[0-9]*>' | tr -d '<>' || true)
        function=$(grep -o 'In function: .*' "$temporary_errors" | head -1 | cut -d' ' -f3- || true)
        if [[ -z $constant || -z $function || ${#inputs[@]} -ne 1 || $attempt -eq 64 ]]; then
            cat "$temporary_errors" >&2
            exit 1
        fi
        rewritten="$output_directory/.abla-xtensa-opaque.$attempt.$$.bc"
        temporary_inputs+=("$rewritten")
        "$tool_root/llvm-dis" "${inputs[0]}" -o - |
            python3 -I "$script_root/opaque-xtensa-constant" "$function" "$constant" |
            "$tool_root/llvm-as" -o "$rewritten"
        for index in "${!assembly_arguments[@]}"; do
            [[ ${assembly_arguments[$index]} == "${inputs[0]}" ]] && assembly_arguments[$index]="$rewritten"
        done
        inputs[0]="$rewritten"
    done
    if [[ ${ABLA_KEEP_XTENSA_ASSEMBLY:-0} == 1 ]]; then cp -- "$temporary_assembly" "$output.s"; fi
    # EXTUI for `x & (2^w-1)` (see fuse-xtensa-extui). Opt-in with
    # ABLA_XTENSA_EXTUI=1 (build-recovered-radio sets it) until application
    # builds have been checked on hardware with it.
    if [[ ${ABLA_XTENSA_EXTUI:-0} == 1 ]]; then
        python3 -I "$script_root/fuse-xtensa-extui" < "$temporary_assembly" > "$temporary_assembly.fused" &&
            mv -f "$temporary_assembly.fused" "$temporary_assembly"
    fi
    python3 -I "$script_root/narrow-xtensa-assembly" < "$temporary_assembly" > "$temporary_assembly.narrow"
    mv -f "$temporary_assembly.narrow" "$temporary_assembly"
    # Relax conditional branches the assembler reports out of range (GNU as
    # does this implicitly; LLVM 23.1's Xtensa assembler does not).
    for attempt in $(seq 1 16); do
        if "$tool_root/llvm-mc" -triple=xtensa-esp-unknown-elf "${target[@]}" -filetype=obj \
            "$temporary_assembly" -o "$output" 2> "$temporary_errors"; then
            break
        fi
        mapfile -t far < <(grep -o "^$temporary_assembly:[0-9]*:[0-9]*: error: fixup value out of range" "$temporary_errors" |
            cut -d: -f2 | sort -un)
        if [[ ${#far[@]} -eq 0 || $attempt -eq 16 ]] ||
            ! python3 -I "$script_root/relax-xtensa-branches" "$temporary_assembly" "${far[@]}" 2>> "$temporary_errors"; then
            cat "$temporary_errors" >&2
            exit 1
        fi
    done
else
    "$llc" "${common[@]}" "${arguments[@]}"
fi

# Abla's MCU panic boundary traps and never unwinds, and Arduino/ESP-IDF MCU
# builds disable C++ exceptions. Removing call-frame unwind metadata saves
# flash without changing executable instructions. Set ABLA_ESP_KEEP_UNWIND=1
# for integrations that intentionally unwind through Abla frames.
if [[ $filetype == obj && -n "$output" && -f "$output" &&
      "${ABLA_ESP_KEEP_UNWIND:-0}" != "1" ]]; then
    temporary="$output.abla-no-eh"
    "$tool_root/llvm-objcopy" --remove-section=.eh_frame "$output" "$temporary"
    mv -f "$temporary" "$output"
fi

# LLVM 23.1 emits per-function `.literal.<fn>` sections with alignment 1, and
# GNU ld packs them after whatever precedes them. l32r needs a 4-byte aligned
# literal, so a function whose neighbour has an odd size fails to link
# ("misaligned literal target"). Which functions that hits depends on layout
# (it appeared once exports shrank), so align every literal section.
if [[ $filetype == obj && -n "$output" && -f "$output" ]]; then
    # Whole section names: literal pools are `.literal.<fn>` and, for
    # sections placed by name (IRAM), `<section>.literal`.
    mapfile -t literal_alignment < <("$tool_root/llvm-readelf" -S -W "$output" |
        sed -nE 's/^ *\[ *[0-9]+\] ([^ ]*\.literal[^ ]*) .*/\1/p' | grep -v '^\.rela' | sort -u |
        sed 's/$/=4/;s/^/--set-section-alignment=/')
    if [[ ${#literal_alignment[@]} -gt 0 ]]; then
        "$tool_root/llvm-objcopy" "${literal_alignment[@]}" "$output" "$output.abla-literal"
        mv -f "$output.abla-literal" "$output"
    fi
fi
