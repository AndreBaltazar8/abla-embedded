#!/usr/bin/env bash
# Self-tests of the recovery pipeline drivers (tools/recover-member.ab, tools/assemble-recovered-unit.ab,
# tools/lint-recovered-unit.ab): the profile reader, the text rewrites of recover-member, and the lint
# fixture (tools/testdata/lint-recovered-unit must report its 7 check groups and exit 1).
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
tools/abla-tool tests/recovery-toml.ab
tools/abla-tool tests/recover-member.ab
status=0
output=$(tools/abla-tool lint-recovered-unit --root tools/testdata/lint-recovered-unit) || status=$?
groups=$(printf '%s\n' "$output" | grep -c '^== ' || true)
if ((status != 1 || groups != 7)); then
    echo "FAIL: lint fixture gave $groups check groups with exit status $status (expected 7 and 1)" >&2
    exit 1
fi
echo "PASS: lint-recovered-unit reports its 7 fixture check groups"
