#!/usr/bin/env bash
set -euo pipefail

example="${1:?usage: tools/build-example EXAMPLE}"
project_root="$(cd "$(dirname "$0")/.." && pwd)"
compiler_root="${ABLA_PROJECT_ROOT:-$(cd "$project_root/../ablac" && pwd)}"
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
esp_llvm_root="${ABLA_ESP_LLVM_ROOT:-$cache_root/abla-embedded/esp-clang-21.1.3}"

if ! command -v opt >/dev/null 2>&1; then
  printf -v script_q '%q' "$0"
  printf -v example_q '%q' "$example"
  printf -v compiler_q '%q' "$compiler_root"
  printf -v esp_llvm_q '%q' "$esp_llvm_root"
  exec nix-shell "$compiler_root/shell.nix" --run \
    "ABLA_PROJECT_ROOT=$compiler_q ABLA_ESP_LLVM_ROOT=$esp_llvm_q $script_q $example_q"
fi

case "$example" in
  blink|serial|i2c-scan|spi-jedec|sd-card|rtc-pcf8563|rtc-rx8130|rtc-powerhub|io-expander|imu|power-monitor|pmic-axp192|pmic-axp2101|pmic-ip5306|charger-aw32001|i2s-tone|wifi-connect|atom-echo) ;;
  *) echo "unknown example: $example" >&2; exit 2 ;;
esac

case "$example" in
  pmic-axp2101) export ABLA_ESP_CPU=esp32s3 ;;
  charger-aw32001) export ABLA_ESP_CPU=esp32c6 ;;
esac

export ABLA_SYSROOT="$compiler_root"
export ABLA_ESP_LLVM_ROOT="$esp_llvm_root"
export PATH="$project_root/tools/esp-llvm-bin:$PATH"

cd "$project_root"
"$compiler_root/build/ablac" build "examples/$example/build.ab" -o "build/examples/$example/build-driver"
"build/examples/$example/build-driver"
