#!/usr/bin/env bash
set -euo pipefail

project="${1:?usage: tools/idf-project PROJECT COMMAND...}"
shift
project_root="$(cd "$(dirname "$0")/.." && pwd)"
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
idf_root="${IDF_PATH:-$cache_root/abla-embedded/esp-idf-v6.0.2}"
idf_tools_root="${IDF_TOOLS_PATH:-$HOME/.espressif}"

# ESP-IDF only exports toolchains recorded for the targets selected during its
# initial install. Also admit an already-installed RISC-V archive so adding a
# C6/P4 example does not depend on reinstalling the existing Xtensa setup.
for toolchain_bin in \
  "$idf_tools_root"/tools/riscv32-esp-elf/*/riscv32-esp-elf/bin; do
  if [[ -d "$toolchain_bin" ]]; then
    export PATH="$toolchain_bin:$PATH"
  fi
done

cd "$project_root/$project"
# Keep Nix-provided Python packages from shadowing ESP-IDF's virtualenv.
unset PYTHONPATH
if command -v steam-run >/dev/null 2>&1; then
  exec steam-run bash -c \
    'source "$1/export.sh" >/dev/null && shift && exec idf.py "$@"' \
    bash "$idf_root" "$@"
fi
source "$idf_root/export.sh" >/dev/null
exec idf.py "$@"
