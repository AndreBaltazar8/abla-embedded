#!/usr/bin/env python3
"""Place native word tables before module-value users and after dependencies.

Abla functions may refer to later module values, but module-value initializers
are checked in declaration order. Recovered sources contain both aliases of a
table (which must follow it) and tables containing addresses of other tables
(which must follow those dependencies). This pass reconstructs that ordering
instead of moving every table blindly to the end of the module.
"""

from __future__ import annotations

import argparse
import heapq
import pathlib
import re


TABLE = re.compile(
    r"val (?P<base>[A-Za-z_][A-Za-z0-9_]*)Storage = "
    r"nativeStatic(?:Mutable)?U32s\(\[\n.*?\n\]\)\n"
    r"val (?P=base)Initialized = (?P=base)Storage\n"
    r"val (?P=base) = u32\((?P=base)Initialized\)",
    re.DOTALL,
)


def order_source(source: str) -> tuple[str, int]:
    matches = list(TABLE.finditer(source))
    if not matches:
        return source, 0

    blocks = [match.group(0) for match in matches]
    bases = [match.group("base") for match in matches]
    body = TABLE.sub("", source).rstrip()
    body_lines = body.splitlines()

    # The earliest top-level alias initializer using each table is its upper
    # placement bound. Uses inside function bodies are intentionally ignored:
    # functions are resolved after the complete module has been declared.
    anchors: list[int] = []
    for base in bases:
        use = re.compile(
            rf"^val (?!{re.escape(base)}(?:Storage|Initialized)?\b).*"
            rf"\b{re.escape(base)}(?:Storage|Initialized)?\b"
        )
        anchor = len(body_lines)
        for line_index, line in enumerate(body_lines):
            if use.search(line):
                anchor = line_index
                break
        anchors.append(anchor)

    # Tables can contain relocations to other table addresses. Propagate the
    # consumer's upper bound to each dependency, then topologically order the
    # blocks so every referenced address has a known module type first.
    dependencies: list[list[int]] = [[] for _ in blocks]
    dependents: list[list[int]] = [[] for _ in blocks]
    for consumer, block in enumerate(blocks):
        for dependency, base in enumerate(bases):
            if consumer != dependency and re.search(
                rf"\b{re.escape(base)}(?:Storage|Initialized)?\b", block
            ):
                dependencies[consumer].append(dependency)
                dependents[dependency].append(consumer)

    changed = True
    while changed:
        changed = False
        for consumer in range(len(blocks)):
            for dependency in dependencies[consumer]:
                if anchors[dependency] > anchors[consumer]:
                    anchors[dependency] = anchors[consumer]
                    changed = True

    indegree = [len(items) for items in dependencies]
    ready: list[tuple[int, int]] = []
    for table in range(len(blocks)):
        if indegree[table] == 0:
            heapq.heappush(ready, (anchors[table], table))
    ordered_tables: list[int] = []
    while ready:
        _, table = heapq.heappop(ready)
        ordered_tables.append(table)
        for dependent in dependents[table]:
            indegree[dependent] -= 1
            if indegree[dependent] == 0:
                heapq.heappush(ready, (anchors[dependent], dependent))
    if len(ordered_tables) != len(blocks):
        raise ValueError("cycle between native static u32 table initializers")

    insertions: dict[int, list[str]] = {}
    for table in ordered_tables:
        insertions.setdefault(anchors[table], []).append(blocks[table])

    output: list[str] = []
    for line_index in range(len(body_lines) + 1):
        if line_index in insertions:
            while output and output[-1] == "":
                output.pop()
            if output:
                output.append("")
            output.extend("\n\n".join(insertions[line_index]).splitlines())
            output.append("")
        if line_index < len(body_lines):
            output.append(body_lines[line_index])
    ordered = "\n".join(output).rstrip() + "\n"
    return ordered, len(blocks) if ordered != source else 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="+", type=pathlib.Path)
    parser.add_argument("--write", action="store_true")
    arguments = parser.parse_args()

    files: list[pathlib.Path] = []
    for path in arguments.paths:
        if path.is_dir():
            files.extend(sorted(path.rglob("*.ab")))
        elif path.suffix == ".ab":
            files.append(path)

    changed_files = tables = 0
    for path in files:
        original = path.read_text()
        ordered, file_tables = order_source(original)
        if ordered == original:
            continue
        changed_files += 1
        tables += file_tables
        if arguments.write:
            path.write_text(ordered)

    action = "ordered" if arguments.write else "would order"
    print(f"{action} {tables} static u32 table(s) in {changed_files} file(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
