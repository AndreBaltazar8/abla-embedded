#!/usr/bin/env bash
set -euo pipefail

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
esp_llvm_root=${ABLA_ESP_LLVM_ROOT:-$cache_root/abla-embedded/esp-clang-21.1.3}
output_directory=$project_root/build/benchmarks/wifi-fcs
abla_object=$project_root/build/examples/radio-mac-registers/abla_fcs.o
c_object=$output_directory/reference.o
runner=()

if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi

if [[ ! -x $esp_llvm_root/bin/clang || ! -x $esp_llvm_root/bin/llvm-size ||
      ! -x $esp_llvm_root/bin/llvm-nm ]]; then
    printf 'missing Espressif LLVM under %s; run make setup\n' \
        "$esp_llvm_root" >&2
    exit 1
fi

if [[ ! -f $abla_object ]]; then
    "$project_root/tools/build-example" radio-mac-registers
fi

mkdir -p "$output_directory"
"${runner[@]}" "$esp_llvm_root/bin/clang" \
    --target=xtensa-esp-elf -mcpu=esp32 -O2 -fomit-frame-pointer \
    -ffunction-sections -fdata-sections -fno-unwind-tables \
    -fno-asynchronous-unwind-tables \
    -c "$project_root/benchmarks/wifi-fcs-reference.c" -o "$c_object"

section_bytes() {
    local object=$1
    local symbol=$2
    "${runner[@]}" "$esp_llvm_root/bin/llvm-size" -A "$object" |
        awk -v text=".text.$symbol" -v literal=".literal.$symbol" \
            '$1 == text || $1 == literal { total += $2 } END { print total + 0 }'
}

abla_symbol=abla_wifi_fcs_native
c_symbol=c_wifi_fcs_native
abla_bytes=$(section_bytes "$abla_object" "$abla_symbol")
c_bytes=$(section_bytes "$c_object" "$c_symbol")

printf 'Wi-Fi FCS leaf (.text + .literal): Abla %s bytes, C %s bytes\n' \
    "$abla_bytes" "$c_bytes"

if (( abla_bytes > c_bytes )); then
    printf 'Abla Wi-Fi FCS leaf regressed past equivalent C\n' >&2
    exit 1
fi

if "${runner[@]}" "$esp_llvm_root/bin/llvm-nm" -u "$abla_object" |
    grep -q .; then
    printf 'Abla Wi-Fi FCS object has unresolved calls\n' >&2
    exit 1
fi

xtensa_objdump=${XTENSA_OBJDUMP:-}
if [[ -z $xtensa_objdump ]]; then
    xtensa_objdump=$(command -v xtensa-esp32-elf-objdump || true)
fi
if [[ -n $xtensa_objdump ]]; then
    instruction_count() {
        local object=$1
        local symbol=$2
        "${runner[@]}" "$xtensa_objdump" -d "--disassemble=$symbol" \
            "$object" |
            awk '/^[[:space:]]*[0-9a-f]+:[[:space:]]+[0-9a-f]+[[:space:]]/ \
                { count += 1 } END { print count + 0 }'
    }
    abla_instructions=$(instruction_count "$abla_object" "$abla_symbol")
    c_instructions=$(instruction_count "$c_object" "$c_symbol")
    printf 'Wi-Fi FCS leaf instructions: Abla %s, C %s\n' \
        "$abla_instructions" "$c_instructions"
    if (( abla_instructions > c_instructions )); then
        printf 'Abla Wi-Fi FCS leaf uses more instructions than C\n' >&2
        exit 1
    fi
fi

printf 'Wi-Fi FCS leaf beats C by %s bytes with no unresolved calls\n' \
    "$((c_bytes - abla_bytes))"
