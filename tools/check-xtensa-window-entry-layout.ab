// Reject callable symbols that branch to Xtensa ENTRY through a literal pool.
//
// Reads a disassembly (GNU or LLVM objdump -d) on standard input:
//
//     objdump -d OBJECT.o | tools/abla-tool check-xtensa-window-entry-layout

import "abla/io"
import "abla/text"
import "lib/xtensa-check.ab"

fun isHexOrSpace(ch: int): bool = ch == 32 || (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 70) || (ch >= 97 && ch <= 102)

fun isHexAny(ch: int): bool = (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 70) || (ch >= 97 && ch <= 102)

fun isMnemonicStartAny(ch: int): bool = (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 46

fun isMnemonicCharAny(ch: int): bool = isMnemonicStartAny(ch) || (ch >= 48 && ch <= 57)

// `ADDRESS <name>:` -> name, else "".
fun windowSymbolName(line: string): string {
    var i = 0
    while (i < line.size && isHexAny(line[i])) i = i + 1
    if (i == 0 || i + 2 >= line.size || line[i] != 32 || line[i + 1] != 60 || line[line.size - 1] != 58) return ""
    if (line[line.size - 2] != 62) return ""
    val name = line.slice(i + 2, line.size - 2)
    if (name == "" || name.contains(">")) return ""
    name
}

// The mnemonic of a `  ADDRESS:  BYTES  MNEMONIC ...` line, else "".
fun windowMnemonic(line: string): string {
    var i = 0
    while (i < line.size && (line[i] == 32 || line[i] == 9)) i = i + 1
    val start = i
    while (i < line.size && isHexAny(line[i])) i = i + 1
    if (i == start || i >= line.size || line[i] != 58) return ""
    i = i + 1
    val blanks = i
    while (i < line.size && (line[i] == 32 || line[i] == 9)) i = i + 1
    if (i == blanks) return ""
    val bytesStart = i
    while (i < line.size && isHexOrSpace(line[i])) i = i + 1
    if (i == bytesStart) return ""
    // A mnemonic must follow after blanks; the byte run may give back its trailing blank.
    if (i >= line.size || (line[i] != 32 && line[i] != 9)) {
        if (line[i - 1] == 32 && i - 1 > bytesStart) {
            i = i - 1
        } else {
            return ""
        }
    }
    while (i < line.size && (line[i] == 32 || line[i] == 9)) i = i + 1
    if (i >= line.size || !isMnemonicStartAny(line[i])) return ""
    val opStart = i
    while (i < line.size && isMnemonicCharAny(line[i])) i = i + 1
    line.slice(opStart, i)
}

// True when the symbol's first instruction is a J and an ENTRY follows within the next 8.
fun branchesBeforeEntry(instructions: array<string>): bool {
    if (instructions.size == 0) return false
    if (instructions[0] != "j" && instructions[0] != "j.n") return false
    var i = 1
    while (i < instructions.size && i < 9) {
        if (instructions[i] == "entry") return true
        i = i + 1
    }
    false
}

fun main: int {
    var name = ""
    var instructions: array<string> = []
    val violations: array<string> = []
    var more = true
    while (more) {
        val input = readInputLine()
        if (!input.available) {
            more = false
        } else {
            val line = input.text
            val symbol = windowSymbolName(line)
            if (symbol != "") {
                if (branchesBeforeEntry(instructions)) violations.append(name)
                name = symbol
                instructions = []
            } else {
                val mnemonic = windowMnemonic(line)
                if (mnemonic != "" && instructions.size < 9) instructions.append(mnemonic)
            }
        }
    }
    if (branchesBeforeEntry(instructions)) violations.append(name)
    if (violations.size != 0) {
        for (violation in violations) eprintln("branch precedes windowed entry: $violation")
        return 1
    }
    println("all disassembled windowed symbols enter before branching")
    0
}
