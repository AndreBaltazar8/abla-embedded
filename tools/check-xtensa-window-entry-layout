#!/usr/bin/env python3
"""Reject callable symbols that branch to Xtensa ENTRY through a literal pool."""

from __future__ import annotations

import re
import sys


SYMBOL = re.compile(r"^[0-9A-Fa-f]+ <(?P<name>[^>]+)>:$")
INSTRUCTION = re.compile(
    r"^[ \t]*[0-9A-Fa-f]+:[ \t]+[0-9A-Fa-f ]+[ \t]+"
    r"(?P<mnemonic>[A-Za-z.][A-Za-z0-9.]*)"
)


def main() -> int:
    name = ""
    instructions: list[str] = []
    violations: list[str] = []

    def finish() -> None:
        if instructions and instructions[0] in ("j", "j.n") and (
            "entry" in instructions[1:9]
        ):
            violations.append(name)

    for raw in sys.stdin:
        line = raw.strip("\n")
        symbol = SYMBOL.match(line)
        if symbol is not None:
            finish()
            name = symbol.group("name")
            instructions = []
            continue
        instruction = INSTRUCTION.match(line)
        if instruction is not None and len(instructions) < 9:
            instructions.append(instruction.group("mnemonic"))
    finish()

    if violations:
        for violation in violations:
            print(f"branch precedes windowed entry: {violation}", file=sys.stderr)
        return 1
    print("all disassembled windowed symbols enter before branching")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
