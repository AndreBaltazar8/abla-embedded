check_target() {
    local source_name=$1 artifact_name=$2 entry_name=$3
    if [[ -n ${ABLA_CHECK_TARGET:-} && $artifact_name != "$ABLA_CHECK_TARGET" ]]; then return; fi
    checked_targets=$((checked_targets + 1))
    local target_output="build/tests/$artifact_name"
    local undefined definitions
    "$compiler_root/build/ablac" build "$source_name" -o "$target_output.o" \
        --target-triple xtensa-esp-unknown-elf --object-format elf --emit object
    bash tools/optimize-embedded-size "$target_output.o.ll" "$target_output.opt.bc"
    if [[ $artifact_name == esp32s3-sleep-timed-record || $artifact_name == esp32s3-sleep-external-record ]]; then
        python3 tools/check-sleep-cache-boundary "$target_output.opt.bc"
    fi
    if [[ $artifact_name == esp32s3-axp-power ]]; then
        python3 tools/check-target-reachability "$target_output.opt.bc" "$entry_name" \
            esp32S3I2cStreamChunkOwned extension_I2cDevice_readRegister16BigEndianChecked
    fi
    llc -filetype=obj -O2 -mtriple=xtensa-esp-unknown-elf \
        "$target_output.opt.bc" -o "$target_output.opt.o"
    if [[ $artifact_name == esp32s3-window-vectors ]]; then
        python3 tools/check-window-vectors "$target_output.opt.o"
        python3 tests/window-vectors.py "$target_output.opt.o"
        python3 tools/check-cache-internal-object "$target_output.opt.o"
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
        bash tools/check-s3-window-link "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-sleep-timed-record || $artifact_name == esp32s3-sleep-retained-record || $artifact_name == esp32s3-mspi-transition || $artifact_name == esp32s3-sleep-external-record ]]; then
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-mspi-transition ]]; then
        python3 tools/check-cache-internal-object "$target_output.opt.o"
        bash tools/check-s3-cache-link "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-clock-pll || $artifact_name == esp32s3-pll-start || $artifact_name == esp32s3-analog-sleep || $artifact_name == esp32s3-clock-resume || $artifact_name == esp32s3-sleep-entry || $artifact_name == esp32s3-interrupt-guard || $artifact_name == esp32s3-peer-park || $artifact_name == esp32s3-intercore || $artifact_name == esp32s3-peer-notify ]]; then
        python3 tools/check-cache-internal-object "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-context-extra ]]; then
        python3 tools/check-s3-context-extra "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-context ]]; then
        python3 tools/check-s3-context "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-exception-policy ]]; then
        python3 tools/check-cache-internal-object "$target_output.opt.o"
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-critical-lock || $artifact_name == esp32s3-startup-memory || $artifact_name == esp32s3-task-resolver || $artifact_name == esp32s3-task-reattach || $artifact_name == esp32s3-ready-queue || $artifact_name == esp32s3-scheduler-tick ]]; then
        python3 tools/check-cache-internal-object "$target_output.opt.o"
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-coprocessor-context || $artifact_name == esp32s3-coprocessor-transfer || $artifact_name == esp32s3-coprocessor-owner || $artifact_name == esp32s3-coprocessor-fault || $artifact_name == esp32s3-coprocessor-policy ]]; then
        python3 tools/check-s3-coprocessor-context "$target_output.opt.o"
        python3 tools/check-cache-internal-object "$target_output.opt.o"
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-irq-entries || $artifact_name == esp32s3-irq-stack || $artifact_name == esp32s3-irq-runtime || $artifact_name == esp32s3-irq-vectors || $artifact_name == esp32s3-irq-resume || $artifact_name == esp32s3-scheduler-irq ]]; then
        python3 tools/check-s3-irq-entries "$target_output.opt.o"
        python3 tools/check-cache-internal-object "$target_output.opt.o"
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-runtime-prepare ]]; then
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
        python3 tools/check-s3-coprocessor-context "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-task-frame ]]; then
        python3 tools/check-cache-internal-object "$target_output.opt.o"
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
        python3 tools/check-s3-context-return "$target_output.opt.o"
    fi
    if [[ $artifact_name == esp32s3-task-detach || $artifact_name == esp32s3-task-switch || $artifact_name == esp32s3-scheduler-select || $artifact_name == esp32s3-scheduler-run ]]; then
        python3 tools/check-cache-internal-object "$target_output.opt.o"
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
        python3 tools/check-s3-coprocessor-context "$target_output.opt.o" --save-only
    fi
    if [[ $artifact_name == esp32s3-irq-vectors || $artifact_name == esp32s3-runtime-prepare || $artifact_name == esp32s3-task-launch || $artifact_name == esp32s3-irq-resume ]]; then
        "${runner[@]}" "$llvm_root/bin/xtensa-esp32s3-elf-clang-ld" \
            -T tests/s3-irq-vectors.ld -e "$entry_name" --no-undefined \
            -o "$target_output.link.elf" "$target_output.opt.o"
        python3 tools/check-window-vectors "$target_output.link.elf"
        python3 tools/check-s3-medium-vectors "$target_output.link.elf"
        python3 tools/check-s3-fatal-vectors "$target_output.link.elf"
        python3 tools/check-cache-internal-object "$target_output.link.elf"
    fi
    if [[ $artifact_name == esp32s3-task-launch ]]; then
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
        python3 tools/check-s3-context-return "$target_output.link.elf"
        python3 tools/check-s3-task-launch "$target_output.link.elf"
    fi
    if [[ $artifact_name == esp32s3-context-return ]]; then
        python3 tools/check-s3-context-return "$target_output.opt.o"
        "${runner[@]}" "$llvm_root/bin/xtensa-esp32s3-elf-clang-ld" \
            -T tests/s3-context-return.ld --no-undefined \
            -o "$target_output.link.elf" "$target_output.opt.o"
        python3 tools/check-s3-context-return "$target_output.link.elf"
        python3 tools/check-cache-internal-object "$target_output.link.elf"
    fi
    if [[ $artifact_name == esp32s3-interrupt-dispatch || $artifact_name == esp32s3-context-extra || $artifact_name == esp32s3-context || $artifact_name == esp32s3-context-return ]]; then
        python3 tools/check-cache-internal-object "$target_output.opt.o"
        python3 tools/check-cache-internal-relocations "$target_output.opt.o"
    fi
    undefined=$("${runner[@]}" "$llvm_root/bin/llvm-nm" -u "$target_output.opt.o")
    if [[ -n $undefined ]]; then
        printf '%s retains external dependencies:\n%s\n' "$artifact_name" "$undefined" >&2
        return 1
    fi
    definitions=$("${runner[@]}" "$llvm_root/bin/llvm-nm" --extern-only --defined-only \
        "$target_output.opt.o" | awk '{print $NF}')
    test "$definitions" = "$entry_name"
    "${runner[@]}" "$llvm_root/bin/llvm-size" "$target_output.opt.o"
}
