// Repair the formerly reversed SUBX2/4/8 expressions in lifted Abla.
//
//     tools/abla-tool repair-lifted-subx-operands ROOT [--write]

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/arguments"
import "lib/abfiles.ab"

class SubxRepair(val text: string, val count: int)

private fun isDigit(byte: int): bool = byte >= 48 && byte <= 57

// Alternatives for the register at `from`: [short end, long end or -1].
private fun registerEnds(line: string, from: int): array<int> {
    val ends: array<int> = []
    if (from >= line.size || line[from] != 114) return ends
    val first = from + 1
    if (first >= line.size || !isDigit(line[first])) return ends
    ends.append(first + 1)
    if (line[first] == 49 && first + 1 < line.size && line[first + 1] >= 48 && line[first + 1] <= 53) {
        ends.append(first + 2)
    }
    ends
}

// Match the whole line against
//   [ \t]*DEST = SUB - \(SCALED << u32\(S\)\)   (S in 1..3), anchored at the end.
// Returns [indentEnd, destEnd, subBegin, subEnd, scaledBegin, scaledEnd, shift] or empty.
fun subxMatch(line: string): array<int> {
    val none: array<int> = []
    var indent = 0
    while (indent < line.size && (line[indent] == 32 || line[indent] == 9)) indent = indent + 1
    for (destEnd in registerEnds(line, indent)) {
        if (!line.slice(destEnd, line.size).startsWith(" = ")) continue
        val subBegin = destEnd + 3
        for (subEnd in registerEnds(line, subBegin)) {
            if (!line.slice(subEnd, line.size).startsWith(" - (")) continue
            val scaledBegin = subEnd + 4
            for (scaledEnd in registerEnds(line, scaledBegin)) {
                val tail = line.slice(scaledEnd, line.size)
                if (!tail.startsWith(" << u32(")) continue
                if (tail.size != 8 + 3) continue
                val digit = tail[8]
                if (digit < 49 || digit > 51) continue
                if (tail.slice(9, 11) != "))") continue
                return [indent, destEnd, subBegin, subEnd, scaledBegin, scaledEnd, digit - 48]
            }
        }
    }
    none
}

fun repairSubx(source: string): SubxRepair {
    var count = 0
    val out: array<string> = []
    for (line in source.split("\n")) {
        val match = subxMatch(line)
        if (match.size == 0) {
            out.append(line)
            continue
        }
        count = count + 1
        val dest = line.slice(match[0], match[1])
        val subtrahend = line.slice(match[2], match[3])
        val scaled = line.slice(match[4], match[5])
        out.append(line.slice(0, match[0]) + "$dest = ($scaled << u32(${match[6]})) - $subtrahend")
    }
    SubxRepair(out.join("\n"), count)
}

fun main: int {
    var write = false
    var root = ""
    var rootGiven = false
    var index = 0
    while (index < processArgumentCount()) {
        val argument = processArgument(index)
        if (argument == "--write") write = true
        else {
            root = argument
            rootGiven = true
        }
        index = index + 1
    }
    if (!rootGiven) {
        eprintln("usage: repair-lifted-subx-operands ROOT [--write]")
        return 2
    }
    val files: array<string> = []
    rglobAb(root, files)
    var total = 0
    var changed = 0
    for (file in files) {
        val repaired = repairSubx(Path(file).readText())
        if (repaired.count == 0) continue
        total = total + repaired.count
        changed = changed + 1
        if (write) Path(file).writeText(repaired.text)
        else println("$file: ${repaired.count}")
    }
    val action = if (write) "repaired" else "would repair"
    println("$action $total SUBX expression(s) in $changed file(s)")
    0
}
