#!/usr/bin/env bash
set -euo pipefail

cache_root=${XDG_CACHE_HOME:-$HOME/.cache}
framework_cache=$cache_root/abla-embedded
llvm_root=${ABLA_ESP_LLVM_ROOT:-$framework_cache/esp-clang-21.1.3}
idf_root=${IDF_PATH:-$framework_cache/esp-idf-v6.0.2}
llvm_archive=$framework_cache/clang-esp-21.1.3_20260408-x86_64-linux-gnu.tar.xz
llvm_url=https://github.com/espressif/llvm-project/releases/download/esp-21.1.3_20260408/clang-esp-21.1.3_20260408-x86_64-linux-gnu.tar.xz
llvm_sha256=6e62bf1973b57b5388aad281ce1463e953e70b3d8df74ef4668c70f31fbeda63

if [[ $(uname -s) != Linux || $(uname -m) != x86_64 ]]; then
    printf '%s\n' \
        'automatic setup currently supports x86_64 Linux; set ABLA_ESP_LLVM_ROOT and IDF_PATH for another host' >&2
    exit 2
fi

if [[ ${1:-} == --check ]]; then
    [[ -x $llvm_root/bin/llc ]] || {
        printf 'missing Espressif LLVM: %s\n' "$llvm_root" >&2
        exit 1
    }
    [[ -f $idf_root/export.sh ]] || {
        printf 'missing ESP-IDF: %s\n' "$idf_root" >&2
        exit 1
    }
    riscv_available=false
    for riscv_gcc in \
      "${IDF_TOOLS_PATH:-$HOME/.espressif}"/tools/riscv32-esp-elf/*/riscv32-esp-elf/bin/riscv32-esp-elf-gcc; do
        if [[ -x "$riscv_gcc" ]]; then riscv_available=true; fi
    done
    $riscv_available || {
        printf 'missing ESP-IDF RISC-V toolchain under %s\n' \
            "${IDF_TOOLS_PATH:-$HOME/.espressif}/tools" >&2
        exit 1
    }
    printf 'Espressif LLVM: %s\nESP-IDF: %s\nESP32-C6 linker: available\n' \
        "$llvm_root" "$idf_root"
    exit 0
fi

mkdir -p "$framework_cache"
if [[ ! -x $llvm_root/bin/llc ]]; then
    if [[ ! -f $llvm_archive ]]; then
        curl --fail --location --output "$llvm_archive" "$llvm_url"
    fi
    printf '%s  %s\n' "$llvm_sha256" "$llvm_archive" | sha256sum --check
    temporary=$(mktemp -d "$framework_cache/.llvm-extract.XXXXXXXX")
    trap 'rm -rf -- "$temporary"' EXIT
    tar -xf "$llvm_archive" -C "$temporary"
    mv "$temporary/esp-clang" "$llvm_root"
fi

if [[ ! -f $idf_root/export.sh ]]; then
    git clone --branch v6.0.2 --depth 1 --recursive \
        https://github.com/espressif/esp-idf.git "$idf_root"
fi

"$idf_root/install.sh" esp32,esp32c6
"$0" --check
