#!/usr/bin/env bash
# Run an Abla check or tool from tools/: `tools/abla-tool NAME ARGS...` runs
# tools/NAME.ab with ARGS and returns its exit status (these programs replace
# the former Python scripts of the same name).
#
# The compiler is $ABLA_TOOL_COMPILER when set, otherwise
# $ABLA_COMPILER_ROOT/build/ablac (ABLA_COMPILER_ROOT defaults to ../ablac, as in
# the other tools). A native build needs the ablac nix shell, so outside one this
# re-enters it first.
set -euo pipefail
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
compiler_root=${ABLA_COMPILER_ROOT:-$project_root/../ablac}
compiler=${ABLA_TOOL_COMPILER:-$compiler_root/build/ablac}
if [[ -z ${IN_NIX_SHELL:-} && -f $compiler_root/shell.nix ]]; then
    printf -v self_q '%q' "${BASH_SOURCE[0]}"
    args_q=$(printf ' %q' "$@")
    exec nix-shell "$compiler_root/shell.nix" --run "$self_q$args_q"
fi
name=$1
shift
# `NAME` is tools/NAME.ab; a name ending in .ab is a path from the project root.
if [[ $name == *.ab ]]; then source=$project_root/$name; else source=$project_root/tools/$name.ab; fi
# Build (ablac's cache makes a rebuild of an unchanged program about 0.1 s, so
# the pipeline can call a tool for every member) and run the binary.
out_dir=$project_root/build/abla-tools/$(printf %s "$compiler" | cksum | cut -d' ' -f1)
mkdir -p "$out_dir"
binary=$out_dir/$(basename "${source%.ab}")
"$compiler" build "$source" -o "$binary" >&2
exec "$binary" "$@"
