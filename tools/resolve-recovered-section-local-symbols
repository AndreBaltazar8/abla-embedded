#!/usr/bin/env python3
"""Bind recovered section-only helpers across one monolithic Abla unit."""

from __future__ import annotations

import pathlib
import re
import sys


MAPPING = re.compile(
    r"^\s*// Original section-local symbol: (\S+)\n"
    r"\s*if \(!internalFunction\(\"[^\"]+\", \"([^\"]+)\"\)\)",
    re.MULTILINE,
)


def replace_exact(source: str, old: str, new: str) -> tuple[str, int]:
    # A physical Abla string ends an escaped assembler identifier immediately
    # before the backslash of `\n`; backslash is therefore a separator here,
    # not part of the linker-symbol alphabet.
    characters = r"A-Za-z0-9_.$"
    pattern = re.compile(
        rf"(?<![{characters}]){re.escape(old)}(?![{characters}])"
    )
    return pattern.subn(lambda _: new, source)


def main() -> int:
    if "--" not in sys.argv[1:]:
        print(
            f"usage: {sys.argv[0]} LINK.ab [...] -- SOURCE.ab [...]",
            file=sys.stderr,
        )
        return 2
    separator = sys.argv.index("--")
    links = [pathlib.Path(value) for value in sys.argv[1:separator]]
    sources = [pathlib.Path(value) for value in sys.argv[separator + 1:]]
    if not links or not sources:
        print("provide at least one link and source file", file=sys.stderr)
        return 2
    mappings: dict[str, str] = {}
    for path in links:
        for old, new in MAPPING.findall(path.read_text()):
            previous = mappings.get(old)
            if previous is not None and previous != new:
                raise ValueError(f"conflicting local symbol mapping: {old}")
            mappings[old] = new
    if not mappings:
        raise ValueError("link files contain no section-local mappings")
    changed = 0
    for path in sources:
        source = path.read_text()
        result = source
        count = 0
        for old, new in mappings.items():
            # Reconstructed Abla strings spell an assembler `$` as `\$\$`.
            # Accept both that physical source form and an unescaped symbol so
            # the resolver is also useful for generated assembly fixtures.
            escaped = old.replace("$", r"\$\$")
            result, replacements = replace_exact(result, escaped, new)
            count += replacements
            result, replacements = replace_exact(result, old, new)
            count += replacements
        if count:
            path.write_text(result)
            changed += count
            print(f"{path}: resolved {count} section-local reference(s)")
    print(f"resolved {changed} section-local reference(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
