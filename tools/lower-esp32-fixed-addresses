#!/usr/bin/env python3
"""Replace classic ESP32 linker constants with ordinary Abla addresses."""

from __future__ import annotations

import argparse
import os
import pathlib
import re


ADDRESS = re.compile(
    r"\$xtensa\s+address\s+\{\{?\s*([^{}\s]+)\s*\}\}?"
)

# Espressif's classic ESP32 peripherals linker map and ROM linker map define
# these as fixed addresses. Keeping them as typed u32 values exposes all
# following field arithmetic and removes an unnecessary assembler relocation.
FIXED = {
    "UART0": 0x3FF40000,
    "SPI1": 0x3FF42000,
    "SPI0": 0x3FF43000,
    "GPIO": 0x3FF44000,
    "RTCCNTL": 0x3FF48000,
    "RTCIO": 0x3FF48400,
    "SENS": 0x3FF48800,
    "I2S0": 0x3FF4F000,
    "UART1": 0x3FF50000,
    "EFUSE": 0x3FF5A000,
    "TIMERG0": 0x3FF5F000,
    "TIMERG1": 0x3FF60000,
    "SPI2": 0x3FF64000,
    "SPI3": 0x3FF65000,
    "SYSCON": 0x3FF66000,
    "I2S1": 0x3FF6D000,
    "UART2": 0x3FF6E000,
    "g_rom_spiflash_chip": 0x3FFAE270,
    "g_rom_flashchip": 0x3FFAE270,
    "g_rom_spiflash_dummy_len_plus": 0x3FFAE290,
    "g_ticks_per_us_pro": 0x3FFE01E0,
    "g_ticks_per_us_app": 0x3FFE40F0,
}

OWNED = {
    "IP_EVENT": "esp32IpEventObject",
    "WIFI_EVENT": "esp32WifiEventObject",
    "g_i2s": "esp32I2sObject",
    "range_read_addr_blocks": "esp32RangeReadBlocks",
    "range_write_addr_blocks": "esp32RangeWriteBlocks",
    "start_write_addr": "esp32StartWriteAddresses",
    "_xt_interrupt_table": "esp32InterruptTableStorage",
    "_xt_exception_table": "esp32ExceptionTableStorage",
}


def relative_import(caller: pathlib.Path, owner: pathlib.Path) -> str:
    value = os.path.relpath(owner, caller.parent)
    if not value.startswith("."):
        value = "./" + value
    return pathlib.PurePath(value).as_posix()


def ensure_import(source: str, imported: str) -> str:
    statement = f'import "{imported}"'
    if statement in source:
        return source
    lines = source.splitlines(keepends=True)
    insertion = 0
    while insertion < len(lines) and lines[insertion].startswith("import "):
        insertion += 1
    lines.insert(insertion, statement + "\n")
    return "".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--write", action="store_true")
    parser.add_argument("root", type=pathlib.Path)
    arguments = parser.parse_args()
    link_data = arguments.root / "link_data_esp32.ab"
    fixed_count = owned_count = changed = 0
    for path in sorted(arguments.root.rglob("*.ab")):
        source = path.read_text()
        needs_owned = False

        def replace(match: re.Match[str]) -> str:
            nonlocal fixed_count, owned_count, needs_owned
            symbol = match.group(1)
            address = FIXED.get(symbol)
            if address is not None:
                fixed_count += 1
                return f"u32({address})"
            owned = OWNED.get(symbol)
            if owned is not None:
                owned_count += 1
                needs_owned = True
                return owned
            return match.group(0)

        lowered = ADDRESS.sub(replace, source)
        if needs_owned and path != link_data:
            lowered = ensure_import(lowered, relative_import(path, link_data))
        if lowered != source:
            changed += 1
            if arguments.write:
                path.write_text(lowered)
    action = "lowered" if arguments.write else "would lower"
    print(
        f"{action} fixed={fixed_count}, Abla-owned={owned_count} "
        f"addresses in {changed} files"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
