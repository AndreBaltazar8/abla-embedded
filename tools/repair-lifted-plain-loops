#!/usr/bin/env python3
"""Restore post-tested semantics for already structured Xtensa LOOP instructions."""

from __future__ import annotations

import argparse
from pathlib import Path
import re
import sys


HEADER = re.compile(
    r"^(?P<indent> *)while \((?P<name>recoveredLoopRemaining[0-9]+) != u32\(0\)\) \{$"
)
REPAIRED_HEADER = re.compile(
    r"^(?P<indent> *)while \(true\) \{$"
)


def transform(source: str, revert: bool = False) -> tuple[str, int]:
    lines = source.splitlines(keepends=True)
    output: list[str] = []
    changed = 0
    index = 0
    while index < len(lines):
        text = lines[index].rstrip("\n")
        match = REPAIRED_HEADER.fullmatch(text) if revert else HEADER.fullmatch(text)
        if match is None:
            output.append(lines[index])
            index += 1
            continue

        indent = match.group("indent")
        name = match.groupdict().get("name")
        end = index + 1
        while end < len(lines) and lines[end].rstrip("\n") != indent + "}":
            end += 1
        if end == len(lines):
            raise ValueError(f"unterminated lifted loop at line {index + 1}")
        body_lines = lines[index + 1:end]
        body = "".join(body_lines)
        if revert:
            trailer = re.fullmatch(
                rf"{re.escape(indent)}    if "
                r"\((recoveredLoopRemaining[0-9]+) == u32\(0\)\) break\n?",
                body_lines[-1] if body_lines else "",
            )
            if trailer is None:
                output.append(lines[index])
                index += 1
                continue
            name = trailer.group(1)
            body_lines = body_lines[:-1]
            body = "".join(body_lines)
        if re.search(rf"\b{re.escape(name)}\s*=", body) is None:
            raise ValueError(f"lifted loop does not update {name} at line {index + 1}")

        newline = "\n" if lines[index].endswith("\n") else ""
        if revert:
            output.append(f"{indent}while ({name} != u32(0)) {{{newline}")
            output.extend(body_lines)
        else:
            output.append(f"{indent}while (true) {{{newline}")
            output.extend(body_lines)
            output.append(f"{indent}    if ({name} == u32(0)) break\n")
        output.append(lines[end])
        changed += 1
        index = end + 1

    return "".join(output), changed


def files(paths: list[Path]) -> list[Path]:
    result: list[Path] = []
    for path in paths:
        if path.is_dir():
            result.extend(sorted(path.rglob("*.ab")))
        elif path.suffix == ".ab":
            result.append(path)
    return result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("paths", nargs="+", type=Path)
    parser.add_argument("--write", action="store_true")
    parser.add_argument("--revert", action="store_true")
    arguments = parser.parse_args()
    total = 0
    changed_files = 0
    for path in files(arguments.paths):
        source = path.read_text()
        transformed, count = transform(source, arguments.revert)
        total += count
        if transformed != source:
            changed_files += 1
            if arguments.write:
                path.write_text(transformed)
    verb = "repaired" if arguments.write else "would repair"
    print(f"{verb} {total} plain LOOP(s) across {changed_files} file(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
