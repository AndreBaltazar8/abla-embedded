#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Run inside the compiler's pinned Nix shell. libm is a host oracle only;
# firmware compiles src/math/sqrt_f32.ab with no external implementation.
export ABLA_SYSROOT=${ABLA_SYSROOT:-../ablac}
compiler=${ABLA_COMPILER:-../ablac/build/ablac}
artifact=build/tests/sqrt-f32-native
mkdir -p build/tests
"$compiler" build tests/sqrt-f32-native.ab -o "$artifact.o" \
    --target-triple x86_64-unknown-linux-gnu --object-format elf --emit object
bash tools/optimize-embedded-size "$artifact.o.ll" "$artifact.bc"
llc -filetype=obj -O2 -relocation-model=static "$artifact.bc" -o "$artifact.opt.o"
cc -O2 -fno-builtin-sqrtf -no-pie tests/sqrt-f32-reference.c "$artifact.opt.o" -lm -o "$artifact"
"$artifact"
