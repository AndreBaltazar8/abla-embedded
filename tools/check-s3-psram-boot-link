#!/usr/bin/env bash
set -euo pipefail
if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo 'usage: bash tools/check-s3-psram-boot-link BOOT_OBJECT.o [configured|default]' >&2
    exit 2
fi
project_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
toolchain_root=${ABLA_ESP_LLVM_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/abla-embedded/esp-clang-21.1.3}
runner=()
if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi
object=$(realpath -- "$1")
case ${2:-configured} in
    configured) entry=abla_esp32s3_psram_boot80_configured_example; stem=build/tests/s3-psram-boot-closure ;;
    default) entry=abla_esp32s3_psram_boot80_default_example; stem=build/tests/s3-psram-boot-default-closure ;;
    *) echo 'unsupported boot entry profile' >&2; exit 2 ;;
esac
cd "$project_root"
python3 tools/check-cache-internal-object "$object"
# ld may only warn for a missing --entry symbol. Make that a hard failure.
"${runner[@]}" "$toolchain_root/bin/llvm-nm" -g --defined-only "$object" |
    awk -v expected="$entry" '$3 == expected { count++ } END { exit count != 1 }'
mkdir -p build/tests
"${runner[@]}" "$toolchain_root/bin/xtensa-esp32s3-elf-clang-ld" \
    -T tests/s3-psram-boot-closure.ld --entry="$entry" --no-undefined \
    -Map="$stem.map" \
    -o "$stem.elf" "$object"
python3 tools/check-cache-internal-object "$stem.elf"
undefined=$("${runner[@]}" "$toolchain_root/bin/llvm-nm" -u "$stem.elf")
test -z "$undefined"
"${runner[@]}" "$toolchain_root/bin/llvm-size" "$stem.elf"
echo 'PASS: PSRAM boot closure linked; code/data aliases, cache banks, owner and stack reservations checked'
echo 'NOT reset-entry/flashable firmware; reserved stack size is not measured worst-case stack usage'
