#!/usr/bin/env bash
set -euo pipefail
framework_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$framework_root"
# Links a test-address ELF only, never a flashable image or device operation.
exec nix-shell ../ablac/shell.nix --run '
set -e
bash tools/build-callable-example esp32p4-sleep-core
ld.lld --no-relax -m elf32lriscv -Ttext=0x4ff00000 +  --section-start=.spm.text.abla.p4_core=0x4ff01000 -Tbss=0x4ff10000 +  -e abla_esp32p4_sleep_core_example +  build/callable-examples/esp32p4-sleep-core/example.o +  -o build/tests/sleep-core-p4.elf
llvm-objdump -d --no-show-raw-insn build/tests/sleep-core-p4.elf +  > build/tests/sleep-core-p4-disassembly.txt
python3 tools/check-p4-sleep-core-instructions.py build/tests/sleep-core-p4.elf
'
