#!/usr/bin/env bash
set -euo pipefail
# Pinned Nix shell; application-entry link proof, never flashes/resets.
export ABLA_SYSROOT=${ABLA_SYSROOT:-../ablac} ABLA_ESP_CPU=esp32s3
export PATH="$PWD/tools/esp-llvm-bin:$PATH"
llvm_root=${ABLA_ESP_LLVM_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/abla-embedded/esp-clang-21.1.3}
output=build/tests/esp32s3-psram-entry
"$ABLA_SYSROOT/build/ablac" build tests/esp32s3-psram-entry-target.ab -o "$output.o" --target-triple xtensa-esp-unknown-elf --object-format elf --emit object
bash tools/optimize-embedded-size "$output.o.ll" "$output.bc"
llc -filetype=obj -O2 -mtriple=xtensa-esp-unknown-elf "$output.bc" -o "$output.unplaced.o"
boundaries=()
for symbol in __abla_boot_stack_low __abla_boot_stack_top __abla_bss_low __abla_bss_top __abla_psram_owner_low __abla_psram_request __abla_psram_result __abla_rtc_bss_low __abla_rtc_bss_top; do
    boundaries+=(--linker-symbol "$symbol")
done
python3 tools/place-internal-closure "$output.unplaced.o" "$output.opt.o" "${boundaries[@]}"
python3 tools/check-cache-internal-object "$output.opt.o"
test "$(nm -g --defined-only "$output.opt.o" | awk '{print $NF}' | sort)" = $'abla_boot_entry\nabla_boot_main'
runner=()
if command -v steam-run >/dev/null 2>&1; then runner=(steam-run); fi
"${runner[@]}" "$llvm_root/bin/xtensa-esp32s3-elf-clang-ld" -T tests/s3-psram-entry.ld --no-undefined -o "$output.link.elf" "$output.opt.o"
test -z "$(nm -u "$output.link.elf")"
python3 tools/check-s3-boot-entry "$output.link.elf"
size "$output.link.elf"
echo 'PASS: entry/BSS/admission/PSRAM monolithic link; loader request refused by default; not flashable or hardware proof'
