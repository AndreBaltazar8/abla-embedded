// Give recovered functions unique subsections inside their placement family.
//
//     tools/abla-tool namespace-recovered-function-sections [--write] SOURCE...

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/bytes"
import "abla/process/arguments"
import "lib/recfiles.ab"

class SectionRewrite(val text: string, val count: int)

// `@section("<.iram|.rtc ...>.<digits>")\ntrusted fun NAME`: the section gains `.abla.NAME`.
fun rewriteFunctionSections(source: string): SectionRewrite {
    val out = byteBuffer()
    val marker = "@section(\""
    var last = 0
    var count = 0
    var search = 0
    while (true) {
        val begin = source.indexOf(marker, search)
        if (begin < 0) break
        search = begin + 1
        val sectionBegin = begin + marker.size
        var end = sectionBegin
        while (end < source.size && source[end] != 34 && source[end] != 10) end = end + 1
        if (end >= source.size || source[end] != 34) continue
        val section = source.slice(sectionBegin, end)
        val prefix = if (section.startsWith(".iram")) 5 else if (section.startsWith(".rtc")) 4 else 0
        if (prefix == 0) continue
        var digits = section.size
        while (digits > 0 && recIsDigit(section[digits - 1])) digits = digits - 1
        if (digits == section.size || digits - 1 < prefix || section[digits - 1] != 46) continue
        val closing = ")\ntrusted fun "
        if (end + 1 + closing.size > source.size || source.slice(end + 1, end + 1 + closing.size) != closing) continue
        val nameBegin = end + 1 + closing.size
        val nameEnd = recIdentEnd(source, nameBegin)
        if (nameEnd == nameBegin) continue
        val name = source.slice(nameBegin, nameEnd)
        out.appendText(source.slice(last, begin))
        out.appendText("@section(\"" + section + ".abla." + name + "\")\ntrusted fun " + name)
        last = nameEnd
        search = nameEnd
        count = count + 1
    }
    out.appendText(source.slice(last, source.size))
    SectionRewrite(out.toText(), count)
}

fun main: int {
    var write = false
    val sources: array<string> = []
    var index = 0
    while (index < processArgumentCount()) {
        val argument = processArgument(index)
        index = index + 1
        if (argument == "--write") write = true
        else if (argument.startsWith("-") && argument != "-") {
            eprintln("namespace-recovered-function-sections: unrecognized arguments: $argument")
            return 2
        } else sources.append(recNormalizePath(argument))
    }
    if (sources.size == 0) {
        eprintln("usage: namespace-recovered-function-sections [--write] sources [sources ...]")
        return 2
    }
    val action = if (write) "rewrote" else "would rewrite"
    var total = 0
    for (path in sources) {
        val read = recRead(path)
        if (!read.ok) {
            eprintln("cannot read $path")
            return 1
        }
        val result = rewriteFunctionSections(read.text)
        if (write && result.count > 0) Path(path).writeText(result.text)
        total = total + result.count
        if (result.count > 0) println("$path: $action ${result.count} function section(s)")
    }
    println("$action $total recovered function section(s)")
    0
}
