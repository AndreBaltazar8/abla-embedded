import "../../src/esp32/i2s/clock_session_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_clock_session_example")
trusted fun example(r: NativeBuffer,tx: bool,source: int,integer: int,numerator: int,denominator: int,bclk: int,exclusive: bool,close: bool): int =
    if (close) c6I2sClockSessionCloseOwned(r,exclusive) else c6I2sClockSessionOpenOwned(r,tx,source,integer,numerator,denominator,bclk,exclusive)
