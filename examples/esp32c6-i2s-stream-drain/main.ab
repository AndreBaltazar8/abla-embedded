import "../../src/esp32/i2s/stream_drain_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_stream_drain_example")
trusted fun example(start: NativeBuffer,cursor: NativeBuffer,drain: NativeBuffer,budget: int,polls: int,prepared: bool,exclusive: bool,begin: bool): int =
    if (begin) c6I2sStreamDrainBeginOwned(start,cursor,drain,prepared,exclusive)
    else c6I2sStreamDrainPollOwned(start,cursor,drain,budget,polls,exclusive)
