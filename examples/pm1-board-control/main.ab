import "../../src/m5stack/pm1_control_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Fresh72B owner; existing board-matching bus stays caller-owned. Retain owner
// even when opening fails; close only after joining all hardware/driver users.
// action0initialize,1open,2ready,3close; no implicit reset or bus shutdown.
@export("abla_pm1_board_control_example")
trusted fun control(storage: NativeBuffer,bus: int,board: M5BoardId,action: int,exclusive: bool,consumed: bool): int {
    val owner=m5Pm1ControlAt(storage)
    if (action == 0) return if (exclusive && owner.initialize()) 1 else 2
    if (action == 1) return owner.openOwned(bus,board,exclusive,consumed)
    if (action == 2) return if (owner.ready()) 1 else owner.status()
    if (action == 3) return if (owner.closeOwned(exclusive)) 1 else 7
    return 2
}
