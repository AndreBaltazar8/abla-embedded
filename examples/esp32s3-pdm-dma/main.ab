import "../../src/esp32/i2s/pdm_dma_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Prepare a caller-owned stereo16 PCM PDM RX ring at requested Hz. PLL160M
// must already be stable. Own stopped I2S0, RX GDMA, pins and internal SRAM.
// Returns actual sample rate or failed stage; does NOT start capture.
@export("abla_esp32s3_pdm_dma_example")
trusted fun prepare(clockPin: int,dataPin: int,rate: int,channel: int,
    descriptors: int,count: int,buffers: int,blockBytes: int,owner: u32): Esp32S3PdmDmaPreparation =
    esp32s3PreparePdmReceiveDma(pdmPins(clockPin,dataPin),3,true,false,false,rate,
        2,160000000,8,channel,descriptors,count,buffers,blockBytes,owner)
