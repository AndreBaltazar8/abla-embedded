import "../../src/esp32/power/sleep_retained_esp32p4.ab"
@export("abla_esp32p4_sleep_retained_example")
trusted fun example(record: int,resume: bool,revision: int,mhz: int,regdmaBackup: bool,polls: int,eventPolls: int,exclusive: bool): int =
    if (resume) esp32p4SleepRetainedContinueOwned(nativeBufferAt(record,224),polls,eventPolls,exclusive) else esp32p4SleepRetainedBeginOwned(nativeBufferAt(record,224),revision,mhz,regdmaBackup,polls,eventPolls,exclusive)
