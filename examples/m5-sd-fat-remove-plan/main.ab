import "../../src/storage/fat_spi_s3.ab"
import "../../src/storage/fat_remove_plan.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller holds volume ownership; this only plans, never deletes media data.
@export("abla_m5_sd_fat_remove_plan_example")
trusted fun plan(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,parent: int,ordinal: int,index: int,
    expected: NativeBuffer,budget: int,output: NativeBuffer,work: NativeBuffer): FatRemovalPlan =
    fatPlanRemovalOwned(reader,boot,first,sectors,parent,ordinal,index,expected,budget,output,work)
