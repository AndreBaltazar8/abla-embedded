import "../../src/esp32/power/sleep_prepare_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5SleepPrepareExample")
@export("abla_esp32c5_sleep_prepare_example")
trusted fun prepare(record: NativeBuffer,period: int,ports: int,polls: int,pvt: bool,action: int,exclusive: bool): int {
    if (action == 1) return esp32C5SleepPrepareCancelOwned(record,exclusive)
    if (action == 2) return if (esp32C5SleepPrepareTakeOwned(record,exclusive)) 1 else 2
    if (action != 0) return 2
    esp32C5SleepPrepareOwned(record,period,ports,polls,pvt,exclusive)
}
