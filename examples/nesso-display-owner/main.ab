import "../../src/m5stack/nesso_display_owner_esp32c6.ab"
import "abla/runtime/scalar"
import "abla/build"
// Native callable only. Retain returned scalar through every close retry;
// callers must not independently close the borrowed bus or expander view.
@export("abla_nesso_display_owner_example")
trusted fun example(owner: NessoDisplayPower,bus: I2cBus,opening: bool,exclusiveCsInactive: bool): NessoDisplayPower =
    if (opening && owner == 0) nessoDisplayPowerOpenOwned(bus|0,exclusiveCsInactive)
    else if (!opening) owner.closeOwned(exclusiveCsInactive) else owner
