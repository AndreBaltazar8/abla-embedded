import "../../src/m5stack/paper_display_owner_esp32.ab"
import "../../src/m5stack/paper_display_partial.ab"
import "abla/runtime/scalar"
import "abla/build"
// Parent is open and its whole image has been initialized. A failed upload
// stops before refresh; caller retains resources for recovery.
@export("abla_paper_display_partial_example")
trusted fun example(parent: M5PaperDisplayOwner,x: int,y: int,w: int,h: int,
    pixels: NativeBuffer,stride: int,scratch: NativeBuffer,polls: int): It8951ImageResult {
    val loaded=parent.loadRectOwned(x,y,w,h,pixels,stride,scratch,polls,3000,true)
    if (!loaded.success()) return loaded
    parent.refreshRectOwned(x,y,w,h,2,scratch,polls,3000,true)
}
