import "../../src/esp32/i2s/standard_mode_esp32p4.ab"
import "abla/runtime/scalar"
@export("abla_esp32p4_i2s_mode_example")
trusted fun configure(port: i32, transmit: bool, slots: i32, flags: i32, exclusive: bool): i32 {
    i32(esp32p4I2sSetStandardModeOwned(int(port),transmit,int(slots),int(flags),exclusive))
}
