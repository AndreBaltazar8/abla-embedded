import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/imu/mpu6886.ab"
import "../../src/imu/sh200q.ab"
import "../../src/imu/bmm150.ab"
import "../../src/imu/ak8963.ab"
import "../../src/imu/bmi270.ab"

val log = serial()

trusted fun reportAxes(label: string, axes: ImuAxes): void {
    if (axes.valid()) log.line(label)
    else log.line("sensor read failed")
    return
}

@export("app_main")
trusted fun appMain(): void {
    // Atom-family Grove Port A is used only as a convenient external test bus.
    val bus = i2cMaster(1, 26, 32)
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }

    if (bus.probe(104)) {
        val sensor = mpu6886(bus)
        if (sensor.begin() != imuSpecNone) {
            reportAxes("MPU6886 acceleration ready", sensor.readAccelerationRaw())
            reportAxes("MPU6886 gyroscope ready", sensor.readGyroscopeRaw())
        } else log.line("MPU6886 initialization failed")
        sensor.close()
    }
    if (bus.probe(108)) {
        val sensor = sh200q(bus)
        if (sensor.begin() != imuSpecNone) {
            reportAxes("SH200Q acceleration ready", sensor.readAccelerationRaw())
            reportAxes("SH200Q gyroscope ready", sensor.readGyroscopeRaw())
        } else log.line("SH200Q initialization failed")
        sensor.close()
    }
    if (bus.probe(105)) {
        val sensor = bmi270(bus)
        if (sensor.begin() != imuSpecNone) {
            reportAxes("BMI270 acceleration ready", sensor.readAccelerationRaw())
            reportAxes("BMI270 gyroscope ready", sensor.readGyroscopeRaw())
        } else log.line("BMI270 initialization failed")
        sensor.close()
    }
    if (bus.probe(16)) {
        val sensor = bmm150(bus)
        if (sensor.begin() != imuSpecNone) {
            reportAxes("BMM150 magnetic field ready", sensor.readMagneticFieldRaw())
        } else log.line("BMM150 initialization failed")
        sensor.close()
    }
    if (bus.probe(12)) {
        val sensor = ak8963(bus)
        if (sensor.begin() != imuSpecNone) {
            reportAxes("AK8963 magnetic field ready", sensor.readMagneticFieldRaw())
        } else log.line("AK8963 initialization failed")
        sensor.close()
    }
    log.line("IMU probe complete")
    bus.close()
    return
}
