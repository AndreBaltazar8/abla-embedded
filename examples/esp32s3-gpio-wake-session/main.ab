import "../../src/esp32/gpio/wake_session_esp32s3.ab"
@export("abla_esp32s3_gpio_wake_session_example")
trusted fun example(record: int,pin: int,high: bool,close: bool,exclusive: bool): int =
    if (close) esp32S3GpioWakeSessionCloseOwned(nativeBufferAt(record,32),exclusive)
    else esp32S3GpioWakeSessionOpenOwned(nativeBufferAt(record,32),pin,high,exclusive)
