import "../../src/esp32/i2s/tx_drain_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_i2s_tx_drain_example")
fun example(action: int,port: int,channel: int,terminal: int,polls: int): int {
    if (action == 0) return if (esp32s3I2sSetTxDrainMode(port,true)) 1 else 0
    if (action == 1) return esp32s3I2sFinishTxStream(port,channel,terminal,polls)
    if (action == 2) return if (esp32s3I2sSetTxDrainMode(port,false)) 1 else 0
    return 2
}
