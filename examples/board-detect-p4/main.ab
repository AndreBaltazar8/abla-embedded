import "../../src/m5stack/detect_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable P4 RV32 object, not a boot image. GPIO32/0 must already be
// exclusive, settled GPIO pulldown inputs with holds released/clocks pinned.
// False refuses probing. No pin configuration, eFuse writes or SDK calls.
@export("abla_board_detect_p4_example")
trusted fun detect(current: M5BoardId,inputsPreparedExclusive: bool): int = m5DetectCurrentEsp32P4Prepared(current,inputsPreparedExclusive) | 0
