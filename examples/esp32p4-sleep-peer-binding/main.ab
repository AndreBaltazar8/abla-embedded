import "../../src/esp32/power/sleep_peer_binding_esp32p4.ab"
@export("abla_esp32p4_sleep_peer_binding_example")
trusted fun example(record: int,table: int,payload: int,layout: int,line: int,priority: int,operation: int,exclusive: bool): int =
    if (operation == 0) esp32p4SleepPeerBindingOpenOwned(nativeBufferAt(record,64),p4IrqDispatchAt(nativeBufferAt(table,272)),nativeBufferAt(payload,848),layout,line,priority,exclusive)
    else if (operation == 1) esp32p4SleepPeerBindingContinueOwned(nativeBufferAt(record,64),exclusive)
    else if (operation == 2) esp32p4SleepPeerBindingCloseOwned(nativeBufferAt(record,64),exclusive)
    else if (operation == 3) esp32p4SleepPeerPayloadRearmOwned(nativeBufferAt(record,64),exclusive)
    else if (operation == 4) esp32p4SleepPeerPayloadEnableOwned(nativeBufferAt(record,64),exclusive)
    else 2
