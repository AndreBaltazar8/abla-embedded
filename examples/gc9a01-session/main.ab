import "../../src/esp32/spi_software_esp32c61.ab"
import "../../src/display/gc9a01_session.ab"
import "../../src/display/gc9a01_power.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable lifecycle exerciser, NOT firmware. Caller provides a fresh64B
// session for action0, configured powered/reset panel/pads, exclusive record
// access and stable borrowed resources. Other actions reuse that same record.
// Actions0open,1rotate,2fill,3blit,4read,5recover,6detach. For5/detach retries
// 7sleep8wake9idle10normal11displayoff12displayon13invert14normalcolors.
// caller must quiesce every bus user and rule out unrelated gate faults.
@export("abla_gc9a01_session_example")
trusted fun run(session: Gc9a01Session,action: int,gate: PeripheralGate,owner: u32,
    clock: Pin,data: Pin,cs: Pin,dc: Pin,rotation: int,pixels: NativeBuffer,stride: int): int {
    if (action == 0) {
        if (!session.initializeFresh()) return 3
        return session.openOwned(gate,owner,clock,data,cs,dc,data,rotation,true,true).status()
    }
    if (action == 1) return session.setRotationOwned(rotation,true).status()
    if (action == 2) return session.fillRectOwned(0,0,240,240,rgb565(0,0,255),true).status()
    if (action == 3) return session.blitOwned(0,0,pixels,240,240,stride,false,true).status()
    if (action == 4) return session.readRectOwned(0,0,240,240,pixels,stride,false,true).status()
    if (action == 5) return if (session.recoverSharedReadOwned(true)) 1 else 6
    if (action == 6) return if (session.detachOwned(true)) 1 else 6
    if (action == 7 || action == 8) return session.setSleepOwned(action == 7,true).status()
    if (action == 9 || action == 10) return session.setPowerSaveOwned(action == 9,true).status()
    if (action == 11 || action == 12) return session.setDisplayEnabledOwned(action == 12,true).status()
    if (action == 13 || action == 14) return session.setInvertedOwned(action == 13,true).status()
    return 3
}
