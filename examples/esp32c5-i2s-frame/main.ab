import "../../src/esp32/i2s/frame_width_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_frame_example")
trusted fun example(owner: C5I2sFrame,port: int,transmit: bool,dataBits: int,slotBits: int,wsWidth: int,shift: bool,exclusive: bool,close: bool): C5I2sFrame =
    if (close) owner.closeOwned(exclusive) else c5I2sFrameOpenOwned(port,transmit,dataBits,slotBits,wsWidth,shift,exclusive)
