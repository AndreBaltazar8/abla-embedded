import "../../src/esp32/i2c/clear_idle_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Explicit idle-controller, single-master slave-clock permission. Retain the
// separate40B recovery and72B session records; failures do not release leases.
@export("abla_esp32p4_i2c_clear_idle_example")
fun example(recovery: int,session: int,budget: u32,exclusive: bool): int =
    esp32p4I2cClearIdleOwned(nativeBufferAt(recovery,40),nativeBufferAt(session,72),5,1000,budget,exclusive)
