import "../../src/m5stack/detect_esp32c3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable C3 ONLY, not a boot image. Quiesce GPIO20/UART0RX clients first;
// owner must initialize ROM delay calibration. Holds are refused, not removed.
// This briefly configures input pulldown then restores complete pad state.
@export("abla_board_detect_c3_example")
trusted fun detect(current: M5BoardId,exclusive: bool): int = m5DetectCurrentEsp32C3CheckedOwned(current,exclusive)
