import "../../src/esp32/i2s/dma_finite_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_dma_finite_example")
trusted fun example(r: NativeBuffer,channel: int,tx: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,budget: int,polls: int,exclusive: bool,begin: bool): int =
    if (begin) c5I2sDmaFiniteBeginOwned(r,channel,tx,descriptors,count,buffers,stride,bytes,polls,exclusive)
    else c5I2sDmaFinitePollOwned(r,budget,polls,exclusive)
