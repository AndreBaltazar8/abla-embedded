import "../../src/esp32/power/sleep_coordinator_request_esp32p4.ab"
@export("abla_esp32p4_sleep_coordinator_request_example")
trusted fun example(record: int,cpu: int,clocks: int,session: int,smp: int,generation: int,action: int,exclusive: bool): int {
    if (action == 0) return esp32p4SleepCoordinatorRequestPrepareOwned(nativeBufferAt(record,48),nativeBufferAt(cpu,816),nativeBufferAt(clocks,288),nativeBufferAt(session,464),nativeBufferAt(smp,4),generation,exclusive)
    if (action == 1) return esp32p4SleepCoordinatorRequestAddress()
    if (action == 2) return esp32p4SleepCoordinatorRequestInvokeOwned(nativeBufferAt(record,48),exclusive)
    return 4
}
