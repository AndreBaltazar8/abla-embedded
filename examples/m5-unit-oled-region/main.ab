import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/display/oled_owner_software.ab"
import "abla/runtime/scalar"
import "abla/build"
// Physical dirty rectangle; owner and complete framebuffer remain exclusive.
// Scratch capacity equals the full-row capacity already required by owner.
@export("abla_m5_unit_oled_region_example")
trusted fun example(owner: OledOwner,frame: NativeBuffer,scratch: NativeBuffer,x: int,y: int,w: int,h: int): int =
    owner.displayRegionOwned(frame,scratch,x,y,w,h,true)
