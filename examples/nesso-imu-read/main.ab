import "../../src/m5stack/nesso_imu_esp32c6.ab"
import "abla/build"
// Borrow initialized44B snapshot + disjoint20B scratch. Returns fresh sensor
// mask,0notready,-1invalid,-2I/O. Failed/empty reads preserve published data.
@export("abla_nesso_imu_read_example")
trusted fun example(power: NessoPower,bus: int,imu: M5ImuProbeResult,snapshot: ImuSnapshot,
    scratch: NativeBuffer,micros: int,exclusive: bool): int =
    power.readImuOwned(bus,imu,snapshot,scratch,micros,exclusive)
