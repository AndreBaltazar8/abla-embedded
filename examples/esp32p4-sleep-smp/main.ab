import "../../src/esp32/power/sleep_smp_esp32p4.ab"
@export("abla_esp32p4_sleep_smp_example")
trusted fun example(record: int,generation: int,operation: int,polls: int,exclusive: bool): int =
    if (operation == 15) esp32p4SleepSmpObserve(nativeBufferAt(record,4),generation)|0
    else esp32p4SleepSmpAdvanceOwned(nativeBufferAt(record,4),generation,operation,polls,exclusive)|0
