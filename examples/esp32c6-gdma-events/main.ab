import "../../src/esp32/gdma_events_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_gdma_events_example")
trusted fun example(events: C6GdmaEvents,channel: int,tx: bool,handled: int,exclusive: bool,ack: bool): int =
    if (ack) events.acknowledgeOwned(handled,exclusive) else c6GdmaEventsReadOwned(channel,tx,exclusive)|0
