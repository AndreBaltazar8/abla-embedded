import "../../src/m5stack/atom_s3_panel_native.ab"
import "abla/runtime/scalar"
import "abla/build"
// Known probe ID; caller retains reset/power/configured SPI/pads. Callable only.
@export("abla_atom_s3_panel_native_example")
trusted fun run(board: M5BoardId,id: int,gate: PeripheralGate,owner: u32,port: int,rotation: int): SpiTransactionResult =
    atomS3PanelFromId(board,id).beginNativeChecked(gate,owner,port,rotation)
