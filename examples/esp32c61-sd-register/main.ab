import "../../src/sd/session_esp32c61.ab"
import "abla/build"
@export("abla_esp32c61_sd_register_example")
trusted fun example(session: Esp32C61SdSession,owner: u32,scratch: NativeBuffer,csd: NativeBuffer): int {
    if (!session.readRegister(owner,9,scratch,csd).valid()) return 0
    return sdCsdBlockCount(csd)
}
