import "../../src/esp32/i2s/audio_stream_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_audio_stream_example")
trusted fun example(setup: NativeBuffer,stream: NativeBuffer,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,exclusive: bool,discard: bool,operation: int): int =
    if (operation == 0) c5AudioStreamBeginOwned(setup,stream,descriptors,count,buffers,stride,bytes,polls,exclusive,discard)
    else if (operation == 1) c5AudioStreamPollOwned(setup,stream,polls,exclusive)
    else if (operation == 2) c5AudioStreamRearmOwned(setup,stream,exclusive)
    else if (operation == 3) c5AudioStreamCloseOwned(setup,stream,polls,exclusive,discard) else 2
