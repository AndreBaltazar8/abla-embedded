import "../../src/esp32/i2c_idf6.ab"
import "../../src/rtc/pcf8563.ab"
import "../../src/esp32/serial.ab"

val log = serial()

trusted fun printTwoDigits(value: int): void {
    val tens = value / 10
    log.writeByte(48 + tens - (tens / 10) * 10)
    log.writeByte(48 + value - (value / 10) * 10)
    return
}

trusted fun printDateTime(value: RtcDateTime): void {
    val thousands = value.year() / 1000
    val hundreds = value.year() / 100
    log.writeByte(48 + thousands - (thousands / 10) * 10)
    log.writeByte(48 + hundreds - (hundreds / 10) * 10)
    printTwoDigits(value.year() - (value.year() / 100) * 100)
    log.writeByte(45)
    printTwoDigits(value.month())
    log.writeByte(45)
    printTwoDigits(value.day())
    log.writeByte(32)
    printTwoDigits(value.hour())
    log.writeByte(58)
    printTwoDigits(value.minute())
    log.writeByte(58)
    printTwoDigits(value.second())
    log.writeByte(10)
    return
}

@export("app_main")
trusted fun appMain(): void {
    // M5Stack Atom family Grove Port A: SDA26, SCL32.
    val bus = i2cMaster(1, 26, 32)
    val rtc = pcf8563(bus)
    if (!rtc.begin()) {
        log.line("PCF8563 initialization failed")
        return
    }
    val current = rtc.dateTime()
    if (current.valid()) printDateTime(current)
    else log.line("PCF8563 date/time is invalid")
    rtc.close()
    bus.close()
    return
}
