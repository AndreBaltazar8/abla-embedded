import "../../src/display/it8951_software_esp32.ab"
import "../../src/display/it8951_device.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller has powered/reset controller and configured exclusively owned pins.
// No refresh, VCOM programming or panel-power ownership is implied.
@export("abla_it8951_initialize_example")
trusted fun example(bus: It8951Software,response: NativeBuffer,polls: int): It8951Initialization =
    it8951Initialize(bus|0,response,polls)
