import "../../src/m5stack/corep4x_channels_window_esp32p4.ab"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Running owned192B speaker session and initialized ring; source+tail then stop.
@export("abla_corep4x_source_queues_window_example")
trusted fun play(r: NativeBuffer,queues: PcmSourceQueues,blocks: i32,accumulator: NativeBuffer,
    scratch: NativeBuffer,staging: NativeBuffer,maxIdle: i32,gain: i32,exclusive: bool): int =
    coreP4xPlaybackSourceQueuesWindowOwned(r,queues,int(blocks),accumulator,scratch,staging,int(maxIdle),int(gain),exclusive)|0
