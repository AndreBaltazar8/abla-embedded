import "../../src/esp32/mspi_timing_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MspiTimingExample")
@export("abla_esp32c5_mspi_timing_example")
trusted fun timing(record: NativeBuffer,target: int,mode: int,num: int,extra: int,close: bool,exclusiveCacheOff: bool): int =
    if (close) esp32C5MspiTimingCloseOwned(record,exclusiveCacheOff) else esp32C5MspiTimingOwned(record,target,mode,num,extra,exclusiveCacheOff)
