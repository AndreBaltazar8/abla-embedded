import "../../src/esp32/power/sleep_measured_gpio_memory_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MeasuredGpioMemoryExample")
@export("abla_esp32c5_sleep_measured_gpio_memory_example")
trusted fun sleep(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,pin: int,high: bool,slowCycles: int,fastCycles: int,action: int,exclusive: bool): int {
    if (action == 0) return esp32C5SleepMeasuredGpioMemoryBeginOwned(record,request,context,pin,high,slowCycles,fastCycles,exclusive)
    if (action == 1) return esp32C5SleepMeasuredContinueOwned(record,exclusive)
    if (action == 2) return esp32C5SleepMeasuredGpioMemoryRecheckOwned(record,exclusive)
    return 2
}
