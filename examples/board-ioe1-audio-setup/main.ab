import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/ioe1_audio_setup.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Caller owns initialized board control I2C/IOE and all stopped audio users.
@export("abla_board_ioe1_audio_setup_example")
trusted fun prepare(board: M5BoardId,io: M5Ioe1,exclusive: bool): int =
    board.prepareIoeAudioOwned(io,exclusive)
