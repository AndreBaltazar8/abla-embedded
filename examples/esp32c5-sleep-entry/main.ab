import "../../src/esp32/power/sleep_entry_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable low-level primitive, NOT a flashable or self-preparing sleep demo.
@section(".iram1.abla.c5SleepEntryExample")
@export("abla_esp32c5_sleep_entry_example")
trusted fun entry(wake: u32,reject: int,exclusive: bool): int = esp32C5LightSleepEnterOwned(wake,reject,exclusive)
