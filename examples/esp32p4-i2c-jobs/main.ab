import "../../src/esp32/i2c/jobs_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable only: caller must own a configured polling controller and pads,
// stable counter/clock, immutable phase table and disjoint payload storage.
// One deadline covers every phase. Error retains bus ownership for recovery.
@export("abla_esp32p4_i2c_jobs_example")
trusted fun run(port: int,address: int,count: int,budget: u32): int =
    i2cJobsRunOwned(port,nativeBufferAt(address,count*16),count,budget)
