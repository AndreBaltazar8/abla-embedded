import "../../src/esp32/power/sleep_peer_esp32p4.ab"
@export("abla_esp32p4_sleep_peer_example")
trusted fun example(core: int,smp: int,generation: int,polls: int,operation: int,exclusive: bool): int =
    if (operation == 0) esp32p4SleepPeerNotifyOwned(nativeBufferAt(smp,4),generation,polls,exclusive)
    else if (operation == 1) esp32p4SleepPeerAcknowledgeOwned(nativeBufferAt(smp,4),generation,polls,exclusive)
    else if (operation == 2) esp32p4SleepPeerResumeOwned(nativeBufferAt(core,144),nativeBufferAt(smp,4),generation,exclusive)
    else 2
