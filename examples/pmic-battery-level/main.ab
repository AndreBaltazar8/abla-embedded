import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/pmic_battery_level.ab"
import "abla/runtime/scalar"
import "abla/build"
// Read-only on an already-opened PMIC. Check status before percentage.
@export("abla_pmic_battery_level_example")
trusted fun example(pmic: M5PmicOpen,exclusive: bool): int = pmic.readBatteryLevelOwned(exclusive)|0
