import "../../src/esp32/power/sleep_rendezvous_esp32p4.ab"
@export("abla_esp32p4_sleep_rendezvous_example")
trusted fun example(record: int,smp: int,payload: int,binding: int,action: int,exclusive: bool): int =
    if (action == 0) esp32p4SleepRendezvousOpenOwned(nativeBufferAt(record,64),nativeBufferAt(smp,4),nativeBufferAt(payload,848),nativeBufferAt(binding,64),exclusive)
    else if (action == 1) esp32p4SleepRendezvousContinueOwned(nativeBufferAt(record,64),32,exclusive)
    else if (action == 2) esp32p4SleepRendezvousCancelOwned(nativeBufferAt(record,64),exclusive)
    else 4
