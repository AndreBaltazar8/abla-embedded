import "../../src/display/it8951_rotation.ab"
import "abla/runtime/scalar"
import "abla/build"
// CPU-only full-image orientation; pass the output to physical it8951Load4.
@export("abla_it8951_rotation_example")
trusted fun example(source: NativeBuffer,sourceStride: int,destination: NativeBuffer,
    destinationStride: int,width: int,height: int,rotation: int): bool =
    it8951Rotate4Owned(source,sourceStride,destination,destinationStride,width,height,rotation,true)
