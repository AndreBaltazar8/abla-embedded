import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/es8311_channels_pump_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Preserve returned state and immutable staging on busy; close on faults.
@export("abla_board_es8311_channels_example")
trusted fun pump(state: M5Es8311ChannelsPump,r: NativeBuffer,bank: PcmChannels,
    acc: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,gain: int,exclusive: bool): int =
    m5Es8311PumpChannelsOwned(state,r,bank,acc,scratch,staging,gain,exclusive)|0
