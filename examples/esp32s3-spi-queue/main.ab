import "../../src/esp32/spi/queue_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable external SPI NOR JEDEC-ID reader; not a boot/flash image.
// Caller owns initialized GPSPI2/3 (MSB-first single line), routed pins and
// inactive manual CS lines, stable clocks and zero-initialized canonical gate.
// Never targets flash/PSRAM controllers SPI0/1. No program/erase/write-enable.
// queue256 holds two outstanding requests; each payload3 stays pinned until
// completion is taken. Caller serializes all calls and services frequently.
// op0 initialize released queue, op1 enqueue0x9f/read3, op2 service, op3 take,
// op4 cancel the unstarted tail matching token (does not clear a fault).
// now/budget/setupTicks/holdTicks use the same monotonic wrapping tick clock.
// Setup consumes budget; successful hold is additional. Polling can extend
// delays, never shorten them. See queue
// statuses; take returns token high32/status low32. Any fault requires explicit
// recovery; do not reinitialize live storage to clear a fault.
@export("abla_esp32s3_spi_queue_example")
trusted fun spiQueueExample(operation: int,queueAddress: int,gateAddress: int,owner: u32,peripheral: int,pins: int,select: int,payloadAddress: int,token: u32,now: u32,budget: u32,released: bool,setupTicks: int = 0,holdTicks: int = 0): int {
    val queue=nativeBufferAt(queueAddress,256)
    if (operation == 0) return if (esp32s3SpiQueueInitialize(queue,2,peripheralGateAt(gateAddress),owner,peripheral,SpiPins(pins),released)) 1 else 0
    if (operation == 1) return esp32s3SpiQueueSubmit(queue,token,Pin(select),0x9f,8,0,0,0,2,nativeBufferAt(payloadAddress,3),3,budget,setupTicks,holdTicks)
    if (operation == 2) return esp32s3SpiQueueService(queue,now)
    if (operation == 3) return esp32s3SpiQueueTake(queue)
    if (operation == 4) return esp32s3SpiQueueCancelTail(queue,token)
    return 3
}
