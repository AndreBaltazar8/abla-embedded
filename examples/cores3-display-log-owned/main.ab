import "../../src/esp32/gpio_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/display_software.ab"
import "../../src/display/log_console_session.ab"
import "../../src/spi/buffer_gate.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable, NOT a boot image. Panel power/initialization and SPI pad ownership
// must already be established. Caller-exclusive state48B, frame7680B and the
// canonical gate must be disjoint RAM and retained until successful close.
// op0 fresh-state initialization + RAM clear; never call on a live session.
// op1 append once + publish; op2 publish/retry without append; op3 close RAM
// session only. Use the same gate/frame for the session's entire lifetime.
// Return0 success, -1 invalid, -2 pending/busy, -(100+SPIstatus) publish failure.
trusted fun displayLogPublishOwned(token: int,frame: NativeBuffer,width: int,height: int,stride: int,littleEndian: bool): int {
    if (width != 120 || height != 32 || stride != 240 || littleEndian) return -1
    val board=m5BoardStackCoreS3
    val result=board.softwareDisplay().blitRgb565(peripheralGateAt(token),u32(7),
        board.displayGeometry().view(board.displayRotation()),0,0,frame,width,height,stride)
    return if (result.valid()) 1 else -100-result.status()
}
@export("abla_cores3_display_log_owned_example")
trusted fun coreS3DisplayLogOwnedExample(stateAddress: u32,gateAddress: u32,bufferAddress: u32,
    operation: int,textAddress: u32,length: int,level: int): int {
    val state=nativeBufferAt(int(stateAddress),48)
    val console=rgb565LogConsoleAt(state)
    val frame=nativeBufferAt(int(bufferAddress),7680)
    val gate=peripheralGateAt(int(gateAddress))
    if (console == 0 || !gate.bufferDisjoint(state,48) || !gate.bufferDisjoint(frame,7680) ||
        operation < 0 || operation > 3) return -1
    if (frame.addressValue() < state.addressValue()+48 && state.addressValue() < frame.addressValue()+7680) return -1
    if (operation == 0) {
        if (!console.initialize() || !console.openOwned(frame,120,32,240,65535,0,1,false,true)) return -1
        return 0
    }
    if (!console.valid() || console.frame() != frame) return -1
    if (operation == 3) return if (console.closeOwned(true)) 0 else -2
    if (operation == 1) {
        if (length < 0 || length > 4096) return -1
        val result=console.appendOwned(nativeBufferAt(int(textAddress),length),length,level,level != 0,1,true)
        if (result != 1) return if (result == 3) -2 else -1
    }
    val result=console.flushOwned(int(gateAddress),true)
    return if (result == 1) 0 else if (result == 4) console.lastPublishStatus() else if (result == 3) -2 else -1
}
