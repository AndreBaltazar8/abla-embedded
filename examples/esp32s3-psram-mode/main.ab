import "../../src/esp32/psram/mode_s3_sequence.ab"
import "../../src/esp32/psram/command_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_psram_mode_example")
@section(".iram1.abla.s3PsramModeExample")
fun example(action: int,output: NativeBuffer,scratch: NativeBuffer,work: NativeBuffer,exclusiveInternal: bool): int {
    if (action == 0) return s3PsramConfigureModeOwned(scratch,work,exclusiveInternal)
    if (action == 1) return s3PsramReadIdentityOwned(output,scratch,work,exclusiveInternal)
    if (action == 2) return s3PsramIdentityFrom(output).physicalBytes()
    return 2
}
