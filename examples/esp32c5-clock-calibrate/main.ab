import "../../src/esp32/clock_calibrate_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5ClockCalibrateExample")
@export("abla_esp32c5_clock_calibrate_example")
trusted fun calibrate(record: NativeBuffer,source: int,cycles: int,exclusive: bool,polls: int): int =
    esp32C5ClockCalibrateOwned(record,source,cycles,exclusive,polls)
