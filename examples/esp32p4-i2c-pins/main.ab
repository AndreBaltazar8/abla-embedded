import "../../src/esp32/i2c/pins_esp32p4.ab"
import "abla/runtime/scalar"
// Callable only: clocks/controller prepared and exclusive ownership required.
@export("abla_esp32p4_i2c_pins_example")
trusted fun example(address: int,port: int,sda: int,scl: int,layout: int,close: bool): int {
    val record=nativeBufferAt(address,40)
    if (close) return esp32p4I2cPinsCloseOwned(record,true)
    return esp32p4I2cPinsOpenOwned(record,port,sda,scl,true,layout,true)
}
