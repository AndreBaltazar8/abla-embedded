import "../../src/esp32/i2c/fifo_esp32p4.ab"
@export("abla_esp32p4_i2c_fifo_example")
trusted fun fifo(port: i32,buffer: NativeBuffer,count: i32,command: u32,index: i32,operation: i32,exclusive: bool): int =
    if (operation == i32(0)) esp32p4I2cWriteFifoOwned(int(port),buffer,int(count),exclusive)
    else if (operation == i32(1)) esp32p4I2cReadFifoOwned(int(port),buffer,int(count),exclusive)
    else if (operation == i32(2)) esp32p4I2cWriteCommandOwned(int(port),int(index),command,exclusive) else 2
