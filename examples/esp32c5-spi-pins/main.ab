import "../../src/esp32/spi/pins_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_spi_pins_example")
trusted fun example(owner: Esp32C5SpiPins,pins: SpiPins,cs: int,opening: bool,exclusive: bool): Esp32C5SpiPins =
    if (opening) esp32C5SpiPinsOpenOwned(pins,cs,exclusive) else owner.closeOwned(exclusive)

