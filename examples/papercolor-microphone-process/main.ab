import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/papercolor_microphone_process_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Running132B capture + DSP40B initialized mono/ADCfalse/swapfalse.
// Hardware sample rate / DSP oversampling is the output sample rate.
@export("abla_papercolor_microphone_process_example")
trusted fun process(r: NativeBuffer,state: NativeBuffer,raw: NativeBuffer,output: NativeBuffer,
    stereo: bool,bits16: bool,polls: int,exclusive: bool): int =
    paperColorMicrophoneProcessBlockOwned(r,state,raw,output,stereo,bits16,polls,exclusive)|0
