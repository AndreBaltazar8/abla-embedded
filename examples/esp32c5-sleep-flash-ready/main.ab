import "../../src/esp32/power/sleep_flash_ready_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable only, NOT a standalone sleep routine. Must meet the owned API's
// retained execution, restored flash/MSPI and calibrated ROM timing contract.
@section(".iram1.abla.c5SleepFlashReadyExample")
@export("abla_esp32c5_sleep_flash_ready_example")
trusted fun resume(saved: Esp32C5CacheSuspendState,result: int,poweredDown: bool,startupUs: int,exclusiveReady: bool): bool =
    esp32C5SleepFlashResumeOwned(saved,result,poweredDown,startupUs,exclusiveReady)
