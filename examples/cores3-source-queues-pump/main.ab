import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/cores3_channels_pump.ab"
import "abla/runtime/scalar"
import "abla/build"
// Initialized/started speaker ring; keep state and staging across busy retries.
@export("abla_cores3_source_queues_pump_example")
trusted fun pump(state: CoreS3ChannelsPump,queues: PcmSourceQueues,channel: int,
    descriptors: int,buffers: int,accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,gain: int): CoreS3ChannelsPump =
    cores3PumpSourceQueues(state,queues,channel,descriptors,buffers,accumulator,scratch,staging,gain)
