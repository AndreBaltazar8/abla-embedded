import "../../src/m5stack/pm1_imu_esp32s3.ab"
import "../../src/esp32/imu_delay_1khz_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Explicit exclusive prepared scan; initialize fresh owner first, close all
// retained devices before closing PM1 control/bus. Readiness is not calibration.
@export("abla_pm1_board_imu_example")
trusted fun open(control: M5Pm1Control,imu: M5ImuOwner,exclusive: bool): int =
    control.openImuPreparedOwned(imu,exclusive)
