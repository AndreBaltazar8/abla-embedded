import "../../src/esp32/gpio_esp32c61.ab"
import "../../src/m5stack/pin_map_shared.ab"
import "abla/runtime/scalar"
import "abla/build"
// Descriptor checks only; no ownership acquisition or hardware activity.
@export("abla_m5_pin_admission_example")
fun example(clock: int,command: int,d0: int,d1: int,d2: int,d3: int): bool =
    m5SdPinMap(clock,command,d0,d1,d2,d3).usesSdmmcFourBit()
