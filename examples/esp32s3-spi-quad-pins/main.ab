import "../../src/esp32/spi/quad_pins_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller exclusively owns released pads and stopped powered peripheral.
// Routing only, not initialized SPI, display, or ownership acquisition.
@export("abla_esp32s3_spi_quad_pins_example")
trusted fun route(peripheral: int,pins: QuadSpiPins,select: Pin,exclusive: bool): int =
    if (exclusive) esp32s3SpiRouteQuadTransmitPinsOwned(peripheral,pins,select) else 2
