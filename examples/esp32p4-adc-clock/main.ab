import "../../src/esp32/adc_clock_esp32p4.ab"
// Callable ownership adapter, not a boot image. Retain failed lease tokens.
@export("abla_esp32p4_adc_clock_example")
trusted fun clock(source: i32,integer: i32,numerator: i32,denominator: i32,saved: P4AdcClock,close: bool,exclusive: bool): int =
    if (close) saved.closeOwned(exclusive)|0 else esp32p4AdcClockOpenOwned(int(source),int(integer),int(numerator),int(denominator),exclusive)|0
