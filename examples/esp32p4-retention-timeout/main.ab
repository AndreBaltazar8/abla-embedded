import "../../src/esp32/power/retention_timeout_esp32p4.ab"
@export("abla_esp32p4_retention_timeout_example")
trusted fun example(action: int,token: int,count: int,interval: int,polls: int,exclusive: bool): int {
    if (action == 0) return esp32p4RetentionTimeoutOpenOwned(count,interval,200,300,50,exclusive)|0
    if (action == 1) return P4RetentionTimeout(token).closeOwned(exclusive)|0
    return esp32p4RetentionWaitOwned(polls,exclusive)
}
