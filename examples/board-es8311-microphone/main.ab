import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/es8311_microphone_esp32s3.ab"
import "abla/runtime/scalar"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// See ownership/clock/bus requirements in the board sequence. Not capture.
@export("abla_board_es8311_microphone_example")
trusted fun microphone(board: M5BoardId,codec: Es8311,expander: M5Ioe1,
    enabled: bool,exclusive: bool): int =
    board.es8311MicrophoneOwned(codec,expander,enabled,exclusive)
