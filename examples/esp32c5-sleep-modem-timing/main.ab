import "../../src/esp32/power/sleep_modem_timing_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32c5_sleep_modem_timing_example")
fun timing(adjustment: int,slow: int,fast: int,down: bool,xtal: bool,backup: bool,enhanced: bool,fixed: int): int =
    esp32C5SleepModemWaitCycles(adjustment,slow,fast,down,xtal,backup,enhanced,fixed)
