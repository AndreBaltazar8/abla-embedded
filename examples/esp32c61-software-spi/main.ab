import "../../src/esp32/spi_software_esp32c61.ab"
import "abla/build"
// Callable transfer only. Caller owns/configures pads and CS, pins CPU clock,
// configures ROM timing, and establishes CPOL before this operation.
@export("abla_esp32c61_software_spi_example")
trusted fun example(clock: Pin,mosi: Pin,miso: Pin,output: NativeBuffer,written: int,input: NativeBuffer,read: int,mode: int): bool =
    softwareSpiTransferOwned(clock,mosi,miso,output,written,input,read,mode,2,255)
