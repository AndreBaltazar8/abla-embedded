import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3.ab"
import "../../src/storage/fat_directory_slots.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller keeps volume ownership through later directory publication.
@export("abla_m5_sd_fat_directory_slots_example")
trusted fun find(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,parent: int,
    needed: int,budget: int,sector: NativeBuffer,scratch: NativeBuffer): FatDirectorySlots =
    fatFindDirectorySlotsOwned(reader,boot,first,sectors,parent,needed,budget,sector,scratch)
