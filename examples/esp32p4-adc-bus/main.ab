import "../../src/esp32/analog/sar_bus_esp32p4.ab"
// Record is32 aligned bytes, initially zero magic, retained across failures.
@export("abla_esp32p4_adc_bus_example")
trusted fun bus(record: NativeBuffer,polls: i32,close: bool,exclusive: bool): int =
    if (close) esp32p4AnalogSarBusCloseOwned(record,int(polls),exclusive) else esp32p4AnalogSarBusOpenOwned(record,int(polls),exclusive)
