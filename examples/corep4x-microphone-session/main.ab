import "../../src/m5stack/corep4x_microphone_session_esp32p4.ab"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Exclusive192B aligned record, zero outer/inner/pin magic for new storage.
// Commands0 prepare,1 codec+DMA start,2 pump raw stereo,3 codec-reset+stop+restore pins.
// Clocks/shared rail/codec/control bus remain owned. No flashing.
@export("abla_corep4x_microphone_session_example")
trusted fun session(r: NativeBuffer,command: i32,codec: Es7210,io: M5Ioe1,channel: i32,
    descriptors: u32,count: i32,payload: u32,stride: i32,bytes: i32,revision: i32,
    polls: i32,cpu: NativeBuffer,exclusive: bool): i32 {
    if (command == i32(0)) return i32(coreP4xMicrophonePrepareOwned(r,codec,io,int(channel),int(descriptors),int(count),int(payload),int(stride),int(bytes),int(revision),int(polls),exclusive))
    if (command == i32(1)) return i32(coreP4xMicrophoneStartOwned(r,exclusive))
    if (command == i32(2)) return i32(coreP4xMicrophonePumpOwned(r,cpu,exclusive))
    if (command == i32(3)) return i32(coreP4xMicrophoneStopOwned(r,exclusive))
    return i32(0)
}
