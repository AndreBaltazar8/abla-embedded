import "../../src/esp32/power/sleep_cpu_aux_esp32p4.ab"
// Callable boundary only: never initiates sleep or powers down the CPU.
@export("abla_esp32p4_sleep_cpu_aux_example")
trusted fun example(record: int,restore: bool,exclusive: bool): int =
    if (restore) esp32p4CpuAuxRestoreOwned(nativeBufferAt(record,256),exclusive)
    else esp32p4CpuAuxSaveOwned(nativeBufferAt(record,256),exclusive)
