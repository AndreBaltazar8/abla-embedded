import "../../src/m5stack/atom_s3_probe_session.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_atom_s3_probe_session_example")
trusted fun run(record: NativeBuffer,board: M5BoardId,port: int,gate: PeripheralGate,
    owner: u32,polls: int,recover: bool,resetMode: int): int =
    if (recover) atomS3ProbeSessionRecoverOwned(record,polls,true)
    else atomS3ProbeSessionRunOwned(record,board,port,gate,owner,polls,true,resetMode)|0
