import "../../src/audio/pcm_source_render.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pcm_source_render_example")
trusted fun render(channel: PcmChannel,tone: PcmTone,useTone: bool,frames: int,output: NativeBuffer): int =
    if (useTone) tone.renderAvailable(frames,output) else channel.renderAvailable(frames,output)
