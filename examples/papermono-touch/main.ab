import "../../src/m5stack/papermono_touch_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// op0open: retain taggedresult inclfailedcleanup. op1read:decode only >=0.
// op2close:assign taggedresult back; retainedfailedhandles requirecloseretry.
@export("abla_papermono_touch_example")
trusted fun touch(control: M5Pm1Control,owned: TouchControllerOpen,snapshot: NativeBuffer,op: int,exclusive: bool): int {
    if (op == 0) return control.openPaperMonoTouchOwned(exclusive)|0
    if (op == 1) return control.readPaperMonoTouchOwned(owned,snapshot,exclusive)
    if (op == 2 && exclusive) return owned.closeOwned()|0
    return -3
}
