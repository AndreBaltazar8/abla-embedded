import "../../src/esp32/i2c/session_esp32p4.ab"
import "abla/runtime/scalar"
// Callable demonstration, not startup firmware. Exclusive prerequisites apply.
@export("abla_esp32p4_i2c_session_example")
trusted fun example(record: int,action: int,port: int,sda: int,scl: int,layout: int,
    address: int,output: int,written: int,input: int,read: int,budget: u32): int {
    val r=nativeBufferAt(record,72)
    if (action == 0) return esp32p4I2cSessionOpenOwned(r,port,0,u32(40000000),u32(100000),sda,scl,7,true,layout,true)
    if (action == 1) return esp32p4I2cSessionTransferOwned(r,address,nativeBufferAt(output,written),written,nativeBufferAt(input,read),read,budget,true)
    if (action == 2) return esp32p4I2cSessionCloseOwned(r,true)
    return 2
}
