import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_lcd_reset.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun unitLcdDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Explicit pre-initialization reset only; destroys existing display settings.
@export("abla_m5_unit_lcd_reset_example")
trusted fun example(device: I2cDevice,scratch: NativeBuffer,exclusive: bool): UnitLcdResetResult =
    if (!softwareI2cProviderBufferSafe(scratch,5)) UnitLcdResetResult(2) else device.unitLcdReset(scratch,exclusive)
