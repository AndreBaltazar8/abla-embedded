import "../../src/esp32/power/sleep_cycle_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller and stack must remain retained when Continue returns pending.
@section(".iram1.abla.c5SleepCycleExample")
@export("abla_esp32c5_sleep_cycle_example")
trusted fun cycle(record: NativeBuffer,request: NativeBuffer,resume: bool,exclusiveReady: bool): int =
    if (resume) esp32C5SleepCycleContinueOwned(record,exclusiveReady) else esp32C5SleepCycleBeginOwned(record,request,exclusiveReady)
