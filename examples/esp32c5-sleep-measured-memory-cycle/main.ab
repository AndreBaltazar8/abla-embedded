import "../../src/esp32/power/sleep_measured_memory_cycle_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MeasuredMemoryCycleExample")
@export("abla_esp32c5_sleep_measured_memory_cycle_example")
trusted fun sleep(record: NativeBuffer,request: NativeBuffer,memory: NativeBuffer,slowCycles: int,fastCycles: int,resume: bool,exclusive: bool): int =
    if (resume) esp32C5SleepMeasuredContinueOwned(record,exclusive) else esp32C5SleepMeasuredMemoryBeginOwned(record,request,memory,slowCycles,fastCycles,exclusive)
