import "../../src/display/it8951_software_esp32.ab"
import "../../src/display/it8951_read_rect.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_it8951_read_rect_example")
trusted fun example(session: It8951Session,x: int,y: int,w: int,h: int,rotation: int,
    destination: NativeBuffer,stride: int,line: NativeBuffer,args: NativeBuffer,polls: int): It8951RectReadResult =
    session.readRectOwned(x,y,w,h,rotation,destination,stride,line,args,true,false,polls,true)
