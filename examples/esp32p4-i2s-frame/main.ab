import "../../src/esp32/i2s/frame_width_esp32p4.ab"
import "abla/runtime/scalar"
// Caller owns clocked, stopped port. Does not configure clocks, pins or DMA.
@export("abla_esp32p4_i2s_frame_example")
trusted fun configure(port: i32, transmit: bool, dataBits: i32, slotBits: i32,
    wsWidth: i32, philipsShift: bool, exclusive: bool): i32 {
    i32(esp32p4I2sSetFrameWidthsOwned(int(port), transmit, int(dataBits),
        int(slotBits), int(wsWidth), philipsShift, exclusive))
}
