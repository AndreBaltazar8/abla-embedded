import "../../src/esp32/gpio/probe_owned_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable object, not boot firmware. Caller retains snapshot across every
// operation and retry; never discard it on preparation/restoration failure.
// See probe_owned_s3_sequence for mandatory pad/clock/hold ownership contract.
// op0 captures snapshot,1 prepares,2 reads,3 restores. Capture is read-only.
@export("abla_esp32s3_owned_gpio_probe_example")
trusted fun probe(operation: int,saved: S3GpioSnapshot,pin: int,pull: int,exclusive: bool): int {
    if (operation == 0) return esp32S3GpioSnapshotOwned(pin,exclusive)|0
    if (operation == 1) return saved.prepareProbeInputOwned(pull,exclusive)
    if (operation == 2) return saved.readProbeInputOwned(exclusive)
    if (operation == 3) return saved.restoreOwned(exclusive)
    return -1
}
