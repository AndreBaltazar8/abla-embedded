#requiredInternalFunction("freestandingMemorySet32", "memset")
// Running retained RX session128, initialized DSP40, full-block raw scratch,
// output; all exclusively owned/disjoint. See module for rate/format contract.
@export("abla_cores3_microphone_process_example")
trusted fun process(r: NativeBuffer,state: NativeBuffer,raw: NativeBuffer,output: NativeBuffer,
    stereo: bool,bits16: bool,polls: int,exclusive: bool): CoreS3MicrophoneBlockResult =
    coreS3MicrophoneProcessBlockOwned(r,state,raw,output,stereo,bits16,polls,exclusive)
