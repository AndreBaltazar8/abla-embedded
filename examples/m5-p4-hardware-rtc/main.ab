import "../../src/m5stack/control_bus_hardware_esp32p4.ab"
import "../../src/m5stack/rtc_open.ab"
import "abla/runtime/scalar"
// Full control-bus/RTC composition with unchanged cross-board RTC driver.
// Caller retains96B ownership record and returned RTC handle. Close RTC before
// bus. RTC begin updates its control registers; reading never invents a time.
// Callable object only; board clock/power/safed-pad prerequisites still apply.
@export("abla_m5_p4_hardware_rtc_example")
trusted fun example(action: int,record: int,board: int,port: int,layout: int,cpuHz: u32,rtc: int): int {
    val r=nativeBufferAt(record,96)
    if (action == 0) return m5P4HardwareControlOpenOwned(r,M5BoardId(board),port,layout,u32(40000000),cpuHz,true)
    if (action == 1) return m5RtcOpen(m5P4HardwareControlDeviceBus(r),M5BoardId(board))|0
    if (action == 2) return M5Rtc(rtc).dateTime()|0
    if (action == 3) return if (M5Rtc(rtc).close()) 1 else 0
    if (action == 4) return m5P4HardwareControlCloseOwned(r,true)
    return 0
}
