import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/papermono_microphone.ab"
import "abla/runtime/scalar"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Initialized native handles, stable I2C timing, exclusive shared registers.
// Caller must stop capture before disable; BOOST remains on for other users.
@export("abla_papermono_microphone_power_example")
trusted fun power(pm1: M5Pm1,ioe1: M5Ioe1,enabled: bool,exclusive: bool): int =
    paperMonoMicrophonePowerOwned(pm1,ioe1,enabled,exclusive)
