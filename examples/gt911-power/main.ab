import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/touch/gt911_power_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns a live GT911 controller and its explicit IRQ pad (PaperS3:48).
// Classic Paper GPIO36 must not be passed to this S3 register backend.
@export("abla_gt911_power_example")
trusted fun power(touch: TouchControllerOpen,interrupt: int,wake: bool,exclusive: bool): int =
    (if (wake) touch.wakeGt911CheckedOwned(interrupt,exclusive) else touch.sleepGt911CheckedOwned(interrupt,exclusive))|0
