// Live bound reader; exclusive filesystem ownership throughout the call.
@export("abla_m5_sd_spi_fat_overwrite_checked_example")
trusted fun overwrite(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,parent: int,ordinal: int,
    entry: int,expected: NativeBuffer,offset: int,length: int,budget: int,source: NativeBuffer,
    modified: RtcDateTime,workspace: NativeBuffer): FatFileOverwriteChecked =
    fatFileOverwriteCheckedOwned(reader,boot,first,sectors,parent,ordinal,entry,expected,offset,length,budget,source,modified,workspace)
