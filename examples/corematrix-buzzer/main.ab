import "../../src/m5stack/corematrix_control_esp32c61.ab"
import "../../src/m5stack/corematrix_buzzer.ab"
import "abla/runtime/scalar"
import "abla/build"
// Silent preparation only: never starts PWM or powers the buzzer.
@export("abla_corematrix_buzzer_example")
trusted fun example(control: M5CoreMatrixControl,exclusive: bool,cleanup: bool): int =
    if (cleanup) control.silenceBuzzerOwned(exclusive) else control.configureBuzzerOwned(exclusive)|0
