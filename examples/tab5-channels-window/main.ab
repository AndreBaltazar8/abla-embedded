import "../../src/m5stack/tab5_channels_window_esp32p4.ab"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Already running192B speaker session, initialized silent DMA ring,24kHz bank.
// Queues source+silence tail then stops/restores; no physical playback claim.
@export("abla_tab5_channels_window_example")
trusted fun play(r: NativeBuffer,bank: PcmChannels,blocks: i32,accumulator: NativeBuffer,
    scratch: NativeBuffer,staging: NativeBuffer,maxIdle: i32,gain: i32,exclusive: bool,tone: PcmTone=PcmTone(0)): int =
    tab5PlaybackChannelsWindowOwned(r,bank,int(blocks),accumulator,scratch,staging,int(maxIdle),int(gain),exclusive,tone)|0
