import "../../src/esp32/i2s/dma_config_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_dma_config_example")
trusted fun example(r: NativeBuffer,channel: int,data: int,slot: int,ws: int,shift: bool,polls: int,exclusive: bool,operation: int): int =
    if (operation == 0) c6I2sDmaConfigOpenOwned(r,channel,data,slot,ws,shift,polls,exclusive)
    else if (operation == 1) c6I2sDmaConfigWaitOwned(r,polls,exclusive)
    else if (operation == 2) c6I2sDmaConfigCloseOwned(r,polls,exclusive) else 2
