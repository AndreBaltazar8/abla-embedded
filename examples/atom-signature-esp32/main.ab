import "../../src/m5stack/atom_signature_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable classic ESP32 object, not boot firmware. Only after package/GPIO/
// capacitive checks establish Atom Lite/Echo family. Own stopped GPIO22/19/33
// HP/RTC/I2S users, clocks, no sleep/global holds and calibrated ROM delay.
// Fresh128B record. op0probe,1retry cleanup,2read signature after restoration.
// Signature56 identifies Echo in this family; external attachments can alter it.
@export("abla_atom_signature_esp32_example")
trusted fun signature(operation: int,record: NativeBuffer,exclusive: bool): int {
    if (operation == 0) return m5AtomSignatureProbeOwned(record,exclusive)
    if (operation == 1 && exclusive) return m5AtomSignatureCloseOwned(record)
    if (operation == 2) return m5AtomSignatureValue(record)
    return -1
}
