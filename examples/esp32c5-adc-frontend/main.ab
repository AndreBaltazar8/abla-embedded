import "../../src/esp32/adc_frontend_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_adc_frontend_example")
trusted fun example(owner: C5AdcFrontend,exclusiveStopped: bool,coldSafe: bool,close: bool): C5AdcFrontend =
    if (close) owner.closeOwned(exclusiveStopped) else c5AdcFrontendOpenOwned(exclusiveStopped,coldSafe)
