import "../../src/m5stack/tab5_microphone_process_esp32p4.ab"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Running192B RX session plus initialized40B stereo DSP. See API ownership.
// HP RISC-V FPU must be enabled and preserved by the caller's task/IRQ policy.
@export("abla_tab5_microphone_process_example")
trusted fun process(r: NativeBuffer,state: NativeBuffer,raw: NativeBuffer,output: NativeBuffer,
    stereo: bool,bits16: bool,exclusive: bool): int =
    tab5MicrophoneProcessBlockOwned(r,state,raw,output,stereo,bits16,exclusive)|0
