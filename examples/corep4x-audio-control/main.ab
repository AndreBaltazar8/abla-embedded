import "../../src/esp32/i2c_software_esp32p4.ab"
import "../../src/m5stack/corep4x_audio_esp32p4.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Initializeddevices/live24kHz256fsclock/wholecodec+rail ownership. NotDMA.
@export("abla_corep4x_audio_control_example")
trusted fun audio(mic: Es7210,speaker: Es8311,io: M5Ioe1,tx: bool,enabled: bool,exclusive: bool): int =
    if (tx) coreP4xSpeakerOwned(speaker,io,enabled,exclusive) else coreP4xMicrophoneOwned(mic,io,enabled,exclusive)
