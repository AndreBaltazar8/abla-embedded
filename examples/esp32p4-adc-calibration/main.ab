import "../../src/esp32/adc_fuse_esp32p4.ab"
// Read calibration first and retain it; apply .initCode() to the analog SAR
// before sampling. Pass the same unit/channel/attenuation's native12-bit raw.
@export("abla_esp32p4_adc_calibration_example")
trusted fun calibration(unit: i32,channel: i32,attenuation: i32,raw: i32,saved: P4AdcCalibration,convert: bool,shadowsReady: bool): int =
    if (convert) saved.millivolts(int(raw)) else esp32p4AdcReadCalibration(int(unit),int(channel),int(attenuation),shadowsReady)|0
