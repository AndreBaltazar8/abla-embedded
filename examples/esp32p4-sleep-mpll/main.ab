import "../../src/esp32/power/sleep_mpll_esp32p4.ab"
@export("abla_esp32p4_sleep_mpll_example")
trusted fun example(token: int,restore: bool,mhz: int,xtalMHz: int,polls: int,exclusiveInternal: bool): int =
    if (restore) P4SleepMpll(token).restoreOwned(polls,exclusiveInternal)|0 else esp32p4SleepMpllSuspendOwned(mhz,xtalMHz,polls,exclusiveInternal)|0
