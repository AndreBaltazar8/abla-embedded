import "../../src/esp32/ledc_pin_owner_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_ledc_pin_owner_example")
trusted fun example(record: NativeBuffer,pin: int,channel: int,inverted: bool,exclusive: bool,close: bool): int =
    if (close) c5LedcPinCloseOwned(record,exclusive) else c5LedcPinOpenOwned(record,pin,channel,inverted,exclusive)
