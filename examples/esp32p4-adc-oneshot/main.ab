import "../../src/esp32/adc_oneshot_esp32p4.ab"
// Caller has already acquired clock/power/pad and calibrated/settled analog
// SAR. Operation0 configure,1 start,2 finish,3 release,4 restore controller.
// Retain controller token independently from each sampling result.
@export("abla_esp32p4_adc_oneshot_example")
trusted fun adc(operation: i32,unit: i32,channel: i32,attenuation: i32,divider: i32,polls: i32,saved: P4AdcController,exclusive: bool): int =
    if (operation == i32(0)) esp32p4AdcControllerOpenOwned(int(unit),int(channel),int(attenuation),int(divider),exclusive)|0
    else if (operation == i32(1)) esp32p4AdcOneshotStartOwned(int(unit),int(channel),exclusive)
    else if (operation == i32(2)) esp32p4AdcOneshotFinishOwned(int(unit),int(channel),int(polls),exclusive)
    else if (operation == i32(3)) esp32p4AdcOneshotReleaseOwned(int(unit),int(channel),int(polls),exclusive)
    else if (operation == i32(4)) saved.closeOwned(exclusive)|0 else 2
