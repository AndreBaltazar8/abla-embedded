import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3.ab"
import "../../src/storage/fat_free_scan.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns mounted media across scan and subsequent compare/reservation.
@export("abla_m5_sd_fat_free_scan_example")
trusted fun scan(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,start: int,
    candidates: int,reads: int,workspace: NativeBuffer): FatFreeScan =
    fatFindFreeOwned(reader,boot,first,sectors,start,candidates,reads,workspace)
