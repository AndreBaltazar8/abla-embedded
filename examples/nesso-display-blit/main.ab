import "../../src/esp32/spi_software_esp32c6.ab"
import "../../src/display/software_blit_checked.ab"
import "../../src/m5stack/display_map.ab"
import "abla/build"
// Callable only: initialized RGB565 panel, checked GPIOs and matching view.
// Caller retains immutable source and canonical gate for the entire call.
@export("abla_nesso_display_blit_example")
trusted fun example(gate: PeripheralGate,owner: u32,view: LcdView,x: int,y: int,source: NativeBuffer,
    width: int,height: int,stride: int,littleEndian: bool): SpiTransactionResult {
    val p=m5BoardArduinoNessoN1.displaySpiPins()
    return softwareLcdBlitRgb565Checked(gate,owner,Pin(p.clock()),Pin(p.mosi()),Pin(p.chipSelect()),Pin(p.dataCommand()),view,x,y,source,width,height,stride,littleEndian,1,false)
}
