import "../../src/esp32/power/sleep_timing_esp32p4.ab"
@export("abla_esp32p4_sleep_timing_example")
trusted fun example(address: int,capacity: int,hpMin: int,lpMin: int,hpAnalog: int,lpAnalog: int,
    hpSupply: int,hpUp: int,lpSupply: int,lpUp: int,xtal: int,pll: int,close: bool,exclusive: bool): int {
    val r=nativeBufferAt(address,capacity)
    if (close) return esp32p4SleepTimingCloseOwned(r,exclusive)
    return esp32p4SleepTimingOpenOwned(r,hpMin,lpMin,hpAnalog,lpAnalog,hpSupply,hpUp,lpSupply,lpUp,xtal,pll,exclusive)
}
