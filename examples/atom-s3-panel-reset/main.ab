import "../../src/m5stack/atom_s3_panel_reset_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Owned powered panel/reset pad, inactive CS/stopped bus; delay clock ready.
@export("abla_atom_s3_panel_reset_example")
trusted fun run(board: M5BoardId,pulse: bool,recover: bool): int =
    if (recover) (if (board.releaseAtomPanelResetOwned(true)) 1 else 5)
    else board.resetAtomPanelOwned(pulse,true)
