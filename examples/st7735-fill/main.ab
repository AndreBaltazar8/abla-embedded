import "../../src/m5stack/display_esp32.ab"
import "../../src/m5stack/i2c_pin_map.ab"
import "../../src/power/axp192.ab"
import "../../src/esp32/task.ab"

// This profile is electrically specific to M5StickC. Its AXP192 drives the
// backlight rail; do not flash it to another board.
@export("app_main")
trusted fun appMain(): void {
    val board = m5BoardStickC
    val i2cPins = board.i2cPins()
    val powerBus = i2cMaster(
        1, i2cPins.internalData(), i2cPins.internalClock()
    )
    val power = axp192(powerBus)
    if (power.begin()) power.setLdo2(3300)

    val bus = board.openDisplayBus()
    if (!bus.valid()) return
    val display = board.openSpiDisplay(bus)
    if (!display.valid()) {
        bus.close()
        return
    }
    val view = board.beginDisplay(display)
    if (view.width() > 0) {
        display.fill(view, rgb565Red)
        taskDelay(500)
        display.fill(view, rgb565Green)
        taskDelay(500)
        display.fill(view, rgb565Blue)
    }
    return
}
