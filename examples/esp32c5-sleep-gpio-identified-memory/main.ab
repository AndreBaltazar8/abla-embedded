import "../../src/esp32/power/sleep_gpio_identified_memory_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5SleepGpioIdentifiedExample")
@export("abla_esp32c5_sleep_gpio_identified_memory_example")
trusted fun sleep(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,pin: int,high: bool,action: int,exclusive: bool): int {
    if (action == 0) return esp32C5SleepGpioIdentifiedMemoryBeginOwned(record,request,context,pin,high,exclusive)
    if (action == 1) return esp32C5SleepCycleContinueOwned(record,exclusive)
    if (action == 2) return esp32C5SleepGpioIdentifiedMemoryRecheckOwned(record,exclusive)
    return 2
}
