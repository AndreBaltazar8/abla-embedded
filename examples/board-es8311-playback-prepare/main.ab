import "../../src/m5stack/es8311_playback_prepare_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Initialized signed16 PCM ring with mono/stereo layout from speakerProfile.
// Prepared only: no codec enable, amplifier power or stream START.
@export("abla_board_es8311_playback_prepare_example")
trusted fun prepare(board: M5BoardId,hz: int,channel: int,desc: int,count: int,
    payload: int,bytes: int,owner: u32,exclusive: bool): int =
    board.prepareEs8311PlaybackOwned(hz,channel,desc,count,payload,bytes,owner,exclusive)|0
