import "../../src/esp32/flash/speed_esp32p4.ab"
@export("abla_esp32p4_flash_speed_example")
trusted fun example(record: int,polls: int,action: int,cpuClockRestored: bool,exclusive: bool): int {
    val r=nativeBufferAt(record,56)
    if (action == 0) return esp32p4FlashSpeedOpenOwned(r,polls,exclusive)
    if (action == 1) return esp32p4FlashSpeedContinueOwned(r,polls,exclusive)
    if (action == 2) return esp32p4FlashSpeedCloseOwned(r,polls,cpuClockRestored,exclusive)
    return 2
}
