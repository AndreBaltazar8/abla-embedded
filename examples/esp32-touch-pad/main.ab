import "../../src/esp32/touch/pad_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable classic ESP32 object, not boot firmware. Own idle controller and
// stopped HP/RTC/analog pad users, pin clocks and prevent sleep/global holds.
// Open fresh zero-magic32-byte record before configuring/scanning controller.
// Close after scans finish. On partial failure retain record and ownership.
// GPIO32/33 cannot be borrowed while the32kHz crystal oscillator is powered.
@export("abla_esp32_touch_pad_example")
trusted fun configure(close: bool,record: NativeBuffer,channel: int,speed: int,voltage: int,exclusiveIdle: bool): int {
    if (close) return esp32TouchPadCloseOwned(record,exclusiveIdle)
    return esp32TouchPadOpenOwned(record,channel,speed,voltage,exclusiveIdle)
}
