import "../../src/esp32/i2c_session_esp32c61.ab"
import "abla/build"
// Callable, NOT a boot image. Preserve returned owner on every failure.
// Caller guarantees exclusive GPIO clocks and stable measured oscillator rates.
@export("abla_esp32c61_i2c_session_example")
trusted fun example(owner: Esp32C61I2cSession,opening: bool,sda: int,scl: int,xtalHz: int,rcFastHz: int): Esp32C61I2cSession =
    if (opening) esp32C61I2cSessionOpenOwned(sda,scl,xtalHz,rcFastHz,true) else owner.closeOwned(true)
