import "../../src/esp32/power/sleep_alarm_session_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5AlarmSessionExample")
@export("abla_esp32c5_sleep_alarm_session_example")
trusted fun alarm(record: NativeBuffer,deadline: int,lead: int,close: bool,exclusive: bool): int =
    if (close) esp32C5SleepAlarmCloseOwned(record,exclusive) else esp32C5SleepAlarmBeginOwned(record,deadline,lead,exclusive)
