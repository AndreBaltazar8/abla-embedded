import "../../src/esp32/psram/flash_dummy_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_flash_dummy_example")
@section(".iram1.abla.s3FlashDummyExample")
fun example(action: int,octal: bool,base: int,baseline: int,extra: int,exclusiveInternal: bool): int {
    if (action == 0) return s3FlashDummyBaselineOwned(exclusiveInternal)
    if (action != 1 || baseline < 0 || baseline > 65535) return 2
    return s3FlashDummyOwned(octal,base,baseline&255,baseline>>>8,extra,exclusiveInternal)
}
