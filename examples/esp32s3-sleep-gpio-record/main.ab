import "../../src/esp32/power/sleep_gpio_record_esp32s3.ab"
import "abla/build"
// Callable integration boundary, NOT a flashable image. Caller prepares and
// resumes the retained sleep record and owns the GPIO wake session.
@export("abla_esp32s3_sleep_gpio_record_example")
fun example(sleepAddress: int,wakeAddress: int,flags: int,period: int,duration: int,reject: int,cleanup: bool): int {
    val sleep=nativeBufferAt(sleepAddress,128);val wake=nativeBufferAt(wakeAddress,32)
    if (cleanup) return if (esp32S3SleepGpioCleanupOwned(sleep,wake)) 1 else 0
    return esp32S3SleepGpioEnterOwned(sleep,wake,flags,period,duration,reject)
}
