import "../../src/esp32/psram/mmu_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_psram_mmu_example")
@section(".iram1.abla.s3PsramMmuExample")
fun example(action: int,record: NativeBuffer,virtual: int,physical: int,bytes: int,capacity: int,exclusiveInternal: bool): int {
    if (action == 0) return s3PsramMmuMapOwned(record,virtual,physical,bytes,capacity,exclusiveInternal)
    if (action == 1) return s3PsramMmuCloseOwned(record,exclusiveInternal)
    return 2
}
