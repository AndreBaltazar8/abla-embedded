import "../../src/m5stack/detect_owned_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable P4 object, not a boot image. Caller owns GPIO32/0 exclusively,
// stops their HP/LP/analog users, pins clocks/power, releases global/sleep
// holds and calibrates ROM delay. Individual holds are refused, not released.
// Restores temporary mux/pull/output-enable changes without changing latches.
// Negative returns are errors; -4 means retain ownership and repair state.
@export("abla_board_detect_p4_owned_example")
trusted fun detect(current: M5BoardId,layout: int,exclusive: bool): int = m5DetectCurrentEsp32P4Owned(current,layout,exclusive)
