import "../../src/esp32/i2s/buzzer_start_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_buzzer_start_example")
trusted fun example(q: NativeBuffer,start: NativeBuffer,producer: NativeBuffer,sources: int,acc: NativeBuffer,scratch: NativeBuffer,mono: NativeBuffer,staging: NativeBuffer,volume: int,budget: int,polls: int,exclusive: bool): int =
    c6BuzzerStartAdvanceOwned(q,start,producer,PcmSourceQueues(sources),acc,scratch,mono,staging,PcmVolume(volume),budget,polls,exclusive)
