import "../../src/esp32/power/sleep_cached_esp32p4.ab"
@export("abla_esp32p4_sleep_cached_example")
trusted fun example(record: int,resume: bool,revision: int,mhz: int,regdmaBackup: bool,polls: int,eventPolls: int,exclusive: bool): int =
    if (resume) esp32p4SleepCachedContinueOwned(nativeBufferAt(record,288),polls,eventPolls,exclusive) else esp32p4SleepCachedBeginOwned(nativeBufferAt(record,288),revision,mhz,regdmaBackup,polls,eventPolls,exclusive)
