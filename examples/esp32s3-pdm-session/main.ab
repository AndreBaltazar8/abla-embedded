import "../../src/esp32/i2s/pdm_session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns session64 (fresh zero/released), internal ring storage, powered
// microphone, stopped I2S0/GDMA, clock+data pads and stable PLL160MHz.
// op0 prepare stereoPCM16k,1 start,2 read full block,3 close,4 actual rate.
// Read result retains complete DMA detail. Never reinitialize a live record.
// Close confirms DMA storage reusable, but leaves clocks and pins configured.
@export("abla_esp32s3_pdm_session_example")
trusted fun session(operation: int,r: NativeBuffer,buffer: NativeBuffer,clockPin: int,dataPin: int,
    channel: int,descriptors: int,count: int,payload: int,blockBytes: int,owner: u32,polls: int,exclusive: bool): int {
    if (operation == 0) return esp32s3PdmSessionBeginOwned(r,pdmPins(clockPin,dataPin),3,true,false,false,
        16000,2,160000000,8,channel,descriptors,count,payload,blockBytes,owner,exclusive)
    if (operation == 1) return esp32s3PdmSessionStartOwned(r,polls,exclusive)
    if (operation == 2) return esp32s3PdmSessionReadOwned(r,buffer,polls,exclusive)|0
    if (operation == 3) return esp32s3PdmSessionCloseOwned(r,polls,exclusive)
    if (operation == 4) return esp32s3PdmSessionRate(r)
    return 0
}
