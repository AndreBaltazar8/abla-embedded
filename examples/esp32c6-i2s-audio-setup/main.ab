import "../../src/esp32/i2s/audio_setup_esp32c6.ab"
import "abla/build"
// Caller-owned stopped hardware, initialized FIFOs and pinned roots/GPIO.
// Callable demonstration, not a boot image. -1 clock pins select data-only TX.
@export("abla_esp32c6_i2s_audio_setup_example")
trusted fun example(r: NativeBuffer,channel: int,source: int,integer: int,numerator: int,denominator: int,bclkDivider: int,bclk: int,ws: int,data: int,mclk: int,polls: int,exclusive: bool,operation: int): int =
    if (operation == 0) c6AudioSetupOpenOwned(r,channel,source,integer,numerator,denominator,bclkDivider,bclk,ws,data,mclk,16,16,16,false,polls,exclusive)
    else if (operation == 1) c6AudioSetupWaitOwned(r,polls,exclusive)
    else if (operation == 2) c6AudioSetupCloseOwned(r,polls,exclusive) else 2
