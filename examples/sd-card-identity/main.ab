import "../../src/sd/cid.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sd_card_identity_example")
trusted fun example(cid: NativeBuffer,field: int): int {
    if (field == 0) return sdCidManufacturer(cid)
    if (field == 1) return sdCidOem(cid)
    if (field == 2) return sdCidRevision(cid)
    if (field == 3) return sdCidSerial(cid)
    if (field == 4) return sdCidManufacturingYear(cid)
    if (field == 5) return sdCidManufacturingMonth(cid)
    return sdCidProductByte(cid,field-6)
}
