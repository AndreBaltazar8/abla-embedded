import "../../src/display/it8951_software_esp32.ab"
import "../../src/display/it8951_power.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller has completed any image load and owns the live controller. No board
// rail/SD/pin changes. Sleep wake requires external reset and initialization.
@export("abla_it8951_power_example")
trusted fun example(bus: It8951Software,scratch: NativeBuffer,sleep: bool,polls: int,
    exclusive: bool): It8951ImageResult =
    it8951EnterLowPower(bus|0,sleep,scratch,polls,3000,exclusive)
