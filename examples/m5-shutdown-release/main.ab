import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/shutdown_request.ab"
import "abla/runtime/scalar"
import "abla/build"
// Explicit recovery of a retained pending/failed shutdown record. Requires
// exclusive ownership and quiescent consumers; never invokes sleep or resets.
@export("abla_m5_shutdown_release_example")
trusted fun release(record: NativeBuffer): int = m5ShutdownRequestReleasePulseOwned(record)
