import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/atom_s3r_backlight.ab"
import "abla/runtime/scalar"
import "abla/build"
// Live internal I2C device0x30; caller retains controller ownership, bus and
// delay clock. Callable only; does not acquire pads or power the board.
@export("abla_atom_s3r_backlight_example")
trusted fun run(device: I2cDevice,brightness: int,initialize: bool): int =
    if (initialize) atomS3RBacklightBeginOwned(device,brightness,true)
    else atomS3RBacklightSetOwned(device,brightness,true)
