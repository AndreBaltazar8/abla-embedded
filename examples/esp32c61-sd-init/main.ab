import "../../src/sd/selected_init_esp32c61.ab"
import "abla/build"
// Negotiation only: caller supplies power/startup clocks and holds selected gate.
@export("abla_esp32c61_sd_init_example")
trusted fun example(master: Esp32C61SpiMaster,scratch: NativeBuffer,response: NativeBuffer): SdSpiInitResult =
    sdSpiInitializeSelected(master|0,scratch,response)
