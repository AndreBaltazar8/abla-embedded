import "../../src/esp32/i2c/software_bus_esp32c61.ab"
import "abla/runtime/scalar"
import "abla/build"
// Borrow a successfully opened bus under its lifecycle/transaction exclusion.
// Report preserves status/STOP and byte counts; failures are not replayed.
@export("abla_esp32c61_i2c_transfer_example")
fun example(bus: Esp32C61SoftwareI2cBus,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,prefix: int): SoftwareI2cTransfer =
    bus.transfer(address,output,written,input,read,prefix)
