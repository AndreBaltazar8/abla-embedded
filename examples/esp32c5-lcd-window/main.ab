import "../../src/display/spi_window_c5_sequence.ab"
import "../../src/display/spi_program_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_lcd_window_example")
trusted fun example(master: Esp32C5SpiMaster,gate: PeripheralGate,owner: u32,dc: int,
    view: LcdView,x: int,y: int,width: int,height: int): SpiBufferResult =
    esp32C5LcdSetWindow(master|0,gate,owner,dc,view,x,y,width,height,1000)
