import "../../src/m5stack/atom_s3_panel_probe_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Borrowed configured controller/pads; retain snapshot on failure. Callable
// only: does not initialize/reset/power a board or take over its pad leases.
@export("abla_atom_s3_panel_probe_example")
trusted fun run(board: M5BoardId,gate: PeripheralGate,owner: u32,peripheral: int,
    snapshot: NativeBuffer,polls: int,recover: bool): int =
    if (recover) board.recoverAtomPanelProbeNativeOwned(gate,owner,peripheral,snapshot,polls,true)
    else board.readAtomPanelIdNativeChecked(gate,owner,peripheral,snapshot,polls)|0
