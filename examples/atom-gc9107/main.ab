import "../../src/esp32/gpio_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/atom_gc9107.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller has identified the actual GC9107 variant, reset/powered the LCD and
// configured the pins. This does not touch reset/backlight or detect a panel.
@export("abla_atom_gc9107_example")
trusted fun run(board: M5BoardId,gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult {
    val initialized=board.beginGc9107DisplayChecked(gate,owner,rotation)
    if (!initialized.valid()) return initialized
    val pins=board.gc9107DisplayPins()
    return gc9107FillRectChecked(gate,owner,Pin(pins.clock()),Pin(pins.mosi()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),
        atomGc9107Geometry(),rotation,0,0,128,128,rgb565(0,0,255))
}
