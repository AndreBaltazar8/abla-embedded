import "../../src/display/it8951_software_esp32.ab"
import "../../src/display/it8951_session.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller-owned initialized session and powered/reset/configured transport.
// Failure retains session and external resources for recovery. No board pins
// or power rails are acquired/released by this callable.
@export("abla_it8951_session_example")
trusted fun example(session: It8951Session,bus: It8951Software,pixels: NativeBuffer,
    stride: int,scratch: NativeBuffer,polls: int): int {
    if (session.openOwned(bus|0,scratch,polls,true) != 1) return -1
    if (!session.loadFullOwned(pixels,stride,scratch,polls,3000,true).success()) return -2
    if (!session.refreshFullOwned(2,scratch,polls,3000,true).success()) return -3
    if (session.waitOwned(scratch,polls,3000,true) != 1) return -4
    if (!session.lowPowerOwned(false,scratch,polls,3000,true).success()) return -5
    if (!session.detachStandbyOwned(true)) return -6
    0
}
