import "../../src/storage/fat_spi_s3.ab"
import "../../src/storage/fat_directory_parent.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns volume; read-only preflight, not yet a directory move.
@export("abla_m5_sd_fat_directory_move_check_example")
trusted fun check(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,source: int,parent: int,destination: int,
    budget: int,snapshot: NativeBuffer,scratch: NativeBuffer): int =
    fatCheckDirectoryMoveOwned(reader,boot,first,sectors,source,parent,destination,budget,snapshot,scratch)
