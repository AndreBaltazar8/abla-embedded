import "../../src/esp32/power/sleep_fpu_esp32p4.ab"
@export("abla_esp32p4_sleep_fpu_example")
trusted fun example(record: int,restore: bool,exclusive: bool): int =
    if (restore) esp32p4SleepFpuRestoreOwned(nativeBufferAt(record,160),exclusive)
    else esp32p4SleepFpuSaveOwned(nativeBufferAt(record,160),exclusive)
