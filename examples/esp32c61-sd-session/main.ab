import "../../src/sd/session_esp32c61.ab"
import "abla/build"
// Fresh storage; caller supplies powered card, master and canonical bus gate.
// response supplies16B for initialization and CSD capacity validation.
@export("abla_esp32c61_sd_session_example")
trusted fun example(storage: NativeBuffer,master: Esp32C61SpiMaster,gate: PeripheralGate,
    owner: u32,sourceHz: int,scratch: NativeBuffer,response: NativeBuffer,destination: NativeBuffer): SdSpiReadResult {
    if (!esp32C61SdSessionInitializeFresh(storage)) return SdSpiReadResult(2)
    val session=esp32C61SdSessionOpen(storage,master,gate,owner,sourceHz,scratch,response)
    if (session == 0) return SdSpiReadResult(3)
    val result=session.readBlock(owner,0,scratch,destination)
    session.invalidate(owner)
    return result
}
