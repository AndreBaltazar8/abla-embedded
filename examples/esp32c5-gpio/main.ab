import "../../src/esp32/gpio_esp32c5.ab"
import "abla/build"
// Callable GPIO boundary, not a boot image. Caller supplies clock/pad ownership
// and releases RTC/USB/global-hold users separately. Never guesses a board pin.
@export("abla_esp32c5_gpio_example")
fun example(pin: int,output: bool,high: bool,openDrain: bool,input: bool,pull: int,exclusive: bool): int =
    esp32C5GpioConfigureOwned(pin,output,high,openDrain,input,pull,exclusive)

