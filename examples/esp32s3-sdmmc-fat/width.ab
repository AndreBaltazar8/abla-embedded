import "./session.ab"
import "../../src/sd/mmc_scr_s3_sequence.ab"
import "../../src/sd/mmc_width_s3_sequence.ab"
// During optional4-bit negotiation, reuse NOT-YET-BOUND FAT session/reader
// bytes128..191 for protocol context64; save SCR lowword at2300. Stages8SCR,
// 9width negotiation, then10transfer-clock. FAT binding follows all three.
// No silent fallback for unsupported4-bit. 1-bit bypasses SCR/width only.
trusted fun sdMmcFatWideBegin(workspace: NativeBuffer,now: u32): int {
    if (!workspace.hasAddressRange(0,2304) || workspace.loadU32(2288) != 1) return -1
    val card=sdMmcStartupCard(nativeBufferAt(workspace.addressValue(),128))
    val status=sdMmcScrBeginOwned(nativeBufferAt(workspace.addressValue()+128,64),card,
        nativeBufferAt(workspace.loadU32(2280),16),nativeBufferAt(workspace.loadU32(2284),8),now,1000,true)
    if (status != 2) { workspace.storeU32(2288,3); return -900-status }
    workspace.storeU32(2288,8)
    return 0
}
trusted fun sdMmcFatWidePoll(workspace: NativeBuffer,now: u32): int {
    if (!workspace.hasAddressRange(0,2304)) return -1
    val stage=workspace.loadU32(2288)
    val context=nativeBufferAt(workspace.addressValue()+128,64)
    if (stage == 8) {
        val status=sdMmcScrPollOwned(context,now)
        if (status == 2) return 0
        if (status != 1) { workspace.storeU32(2288,3); return -900-status }
        val scr=sdMmcScrResultOwned(context)
        workspace.storeU32(2300,scr&4294967295)
        if (!scr.valid() || !scr.supportsFourBit()) { workspace.storeU32(2288,3); return -903 }
        val begun=sdMmcWidthBeginOwned(nativeBufferAt(context.addressValue(),48),sdMmcStartupCard(nativeBufferAt(workspace.addressValue(),128)),scr,4,now,1000,true)
        if (begun != 2) { workspace.storeU32(2288,3); return -1000-begun }
        workspace.storeU32(2288,9)
        return 0
    }
    if (stage != 9) return -1
    val status=sdMmcWidthPollOwned(nativeBufferAt(context.addressValue(),48),now)
    if (status == 2) return 0
    if (status != 1) { workspace.storeU32(2288,3); return -1000-status }
    return sdMmcFatSpeedBegin(workspace,now)
}
