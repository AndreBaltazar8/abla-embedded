import "./session.ab"
import "./width.ab"
import "../../src/sd/mmc_pin_snapshot_s3_sequence.ab"
// Additional caller-owned64-byte pin snapshot, disjoint from ALL session,
// DMA, path and destination regions. workspace2292 pointer,2296 pad lifecycle:
// 0none1captured2routed3restored4partial. Base stage7 means routing/start failed
// before host acquisition. Caller holds prior peripheral owners quiescent
// throughout, has released RTC/USB/holds/package-reserved pads, and keeps card
// clocks stopped during capture/route. Power and upstream source remain owned
// by caller; successful close restores digital pads, not PMIC/RTC/USB state.
trusted fun sdMmcFatWiredBegin(workspace: NativeBuffer,snapshot: NativeBuffer,pins: SdMmcPins,descriptor: NativeBuffer,bounce: NativeBuffer,slot: int,pll160: bool,nowMs: u32,prepared: bool): int {
    if (!prepared || !workspace.hasAddressRange(0,2304) || workspace.loadU32(2288) != 0 || workspace.loadU32(2296) != 0 ||
        !snapshot.hasAddressRange(0,64) || !pins.valid() || slot < 0 || slot > 1 ||
        !sdMmcDmaRegionsValid(descriptor,bounce,512) || fatBuffersOverlap(workspace,2304,descriptor,16) || fatBuffersOverlap(workspace,2304,bounce,512) ||
        fatBuffersOverlap(snapshot,64,workspace,2304) || fatBuffersOverlap(snapshot,64,descriptor,16) || fatBuffersOverlap(snapshot,64,bounce,512)) return -1
    val captured=sdMmcPinsCaptureOwned(pins,slot,snapshot,true)
    if (captured != 1) return -700-captured
    workspace.storeU32(2292,snapshot.addressValue()); workspace.storeU32(2296,1)
    workspace.storeU32(2268,pins.width())
    val routed=pins.routeOwned(slot,true,true)
    if (routed != 1) { workspace.storeU32(2296,4); workspace.storeU32(2288,7); return -700-routed }
    workspace.storeU32(2296,2)
    val begun=sdMmcFatExampleBegin(workspace,descriptor,bounce,slot,pll160,nowMs,true)
    if (begun != 0) workspace.storeU32(2288,7)
    return begun
}
trusted fun sdMmcFatWiredRestore(workspace: NativeBuffer): int {
    if (!workspace.hasAddressRange(0,2304)) return -1
    // Only after completed host close, or a failure BEFORE host acquisition.
    val stage=workspace.loadU32(2288)
    if (stage != 5 && stage != 7) return -1
    val pads=workspace.loadU32(2296)
    if (pads == 3) return 1
    if (pads < 1 || pads > 4) return -1
    val snapshot=nativeBufferAt(workspace.loadU32(2292),64)
    val restored=sdMmcPinsRestoreOwned(snapshot,true)
    if (restored != 1) { workspace.storeU32(2296,4); return -800-restored }
    workspace.storeU32(2296,3); workspace.storeU32(2288,5)
    return 1
}
trusted fun sdMmcFatWiredClose(workspace: NativeBuffer): int {
    if (!workspace.hasAddressRange(0,2304)) return -1
    if (workspace.loadU32(2288) == 7 || workspace.loadU32(2288) == 5) return sdMmcFatWiredRestore(workspace)
    val result=sdMmcFatExampleClose(workspace)
    if (result == 1) return sdMmcFatWiredRestore(workspace)
    return result
}
trusted fun sdMmcFatWiredPoll(workspace: NativeBuffer,nowMs: u32,nowUs: u32): int {
    if (!workspace.hasAddressRange(0,2304)) return -1
    val stage=workspace.loadU32(2288)
    if (stage == 8 || stage == 9) return sdMmcFatWidePoll(workspace,nowMs)
    if (stage == 1 && workspace.loadU32(2268) == 4) {
        val status=sdMmcStartupPollOwned(nativeBufferAt(workspace.addressValue(),128),nowMs,nowUs)
        if (status == 2) return 0
        if (status != 1) { workspace.storeU32(2288,3); return -100-status }
        return sdMmcFatWideBegin(workspace,nowMs)
    }
    val result=sdMmcFatExamplePoll(workspace,nowMs,nowUs)
    if (result == 1 && workspace.loadU32(2288) == 5) return sdMmcFatWiredRestore(workspace)
    return result
}
trusted fun sdMmcFatWiredRead(workspace: NativeBuffer,path: NativeBuffer,pathLength: int,destination: NativeBuffer,partition: int,offset: int,budget: int): int {
    if (!workspace.hasAddressRange(0,2304) || workspace.loadU32(2296) != 2 || pathLength < 1 || pathLength > 255) return -1
    val snapshot=nativeBufferAt(workspace.loadU32(2292),64)
    if (fatBuffersOverlap(snapshot,64,path,pathLength) || fatBuffersOverlap(snapshot,64,destination,512)) return -1
    return sdMmcFatExampleRead(workspace,path,pathLength,destination,partition,offset,budget)
}
