import "./pads.ab"
import "../../src/sd/mmc_pin_snapshot_esp32s3.ab"
import "../../src/sd/mmc_startup_esp32s3.ab"
import "../../src/storage/fat_sdmmc_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable object, NOT a boot/flash image. See session.ab and pads.ab for owned memory,
// board wiring, source/power and concurrency preconditions. Operations:
// 0begin ->0started;1poll ->0pending/1ready;2read ->bytes/0EOF;3drain ->raw
// read status;4close ->0pending/1closed (then operation1 polls close).
// Errors negative; preserve workspace and leases on all failures.
// No card writes. Read accepts ASCII8.3 path, explicitMBR0..3/-1superfloppy,
// offset and per-component/per-read chain budget. Destination unchanged on error.
// Begin takes packed sdMmcPins(CLK,CMD,D0[,D1,D2,D3]) and a separate64-byte
// snapshot. A4-bit profile triggers SCR/ACMD6 negotiation before FAT becomes
// available. Successful close includes digital pin/input-route restoration.
// Both widths promote to default transfer speed (<=25MHz) and verify CMD13
// before becoming ready. This requires wiring suitable for that clock rate.
trusted fun esp32s3SdMmcFatExample(operation: int,workspaceAddress: int,descriptorAddress: int,bounceAddress: int,slot: int,pll160: bool,pathAddress: int,pathLength: int,destinationAddress: int,partition: int,offset: int,budget: int,prepared: bool,pins: int,pinSnapshotAddress: int): int {
    val workspace=nativeBufferAt(workspaceAddress,2304)
    if (operation == 2) return sdMmcFatWiredRead(workspace,nativeBufferAt(pathAddress,pathLength),pathLength,nativeBufferAt(destinationAddress,512),partition,offset,budget)
    if (operation == 3) return sdMmcFatExampleDrain(workspace)
    if (operation == 4) return sdMmcFatWiredClose(workspace)
    if (operation != 0 && operation != 1) return -1
    val ticks=esp32S3TimerTicks(0,16)
    if (ticks < 0) return -2
    val ms=u32(fatSdMmcMillisecondsFromTicks(ticks))
    if (operation == 0) return sdMmcFatWiredBegin(workspace,nativeBufferAt(pinSnapshotAddress,64),SdMmcPins(pins),nativeBufferAt(descriptorAddress,16),nativeBufferAt(bounceAddress,512),slot,pll160,ms,prepared)
    return sdMmcFatWiredPoll(workspace,ms,u32((ticks>>>4)&4294967295))
}
#exportFunction("esp32s3SdMmcFatExample", "abla_esp32s3_sdmmc_fat_example")
