import "../../src/esp32/i2s/divider_owner_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_divider_owner_example")
trusted fun example(owner: C5I2sDividerOwner,port: int,tx: bool,integer: int,numerator: int,denominator: int,exclusive: bool,close: bool): C5I2sDividerOwner =
    if (close) owner.closeOwned(exclusive) else c5I2sDividerOpenOwned(port,tx,integer,numerator,denominator,exclusive)
