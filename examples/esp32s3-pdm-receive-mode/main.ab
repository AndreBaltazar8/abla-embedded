import "../../src/esp32/i2s/pdm_rx_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable mode preparation only; caller owns powered/reset RX and parked
// DMA. Clock plan does not program clocks. Pins, DMA, EOF and latch/start
// remain explicit prerequisites; this is not a capture or boot image.
@export("abla_esp32s3_pdm_receive_mode_example")
trusted fun prepare(sourceHz: int,rate: int,slots: int,pcm: bool,downsample128: bool,divider: int): Esp32S3PdmReceiveClock {
    val clock=esp32s3PdmReceiveClock(sourceHz,rate,slots,pcm,downsample128,divider)
    if (!clock.valid() || !esp32s3I2sSetPdmReceiveMode(0,slots,pcm,downsample128,false)) return Esp32S3PdmReceiveClock(0)
    return clock
}
