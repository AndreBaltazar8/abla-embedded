import "../../src/m5stack/nesso_imu_esp32c6.ab"
import "abla/build"
// Callable, not boot image. Power owner and session stay alive until this
// independent IMU owner closes. Opening resets/configures BMI270 at0x68.
@export("abla_nesso_imu_example")
trusted fun example(power: NessoPower,bus: int,imu: M5ImuProbeResult,open: bool,exclusive: bool): M5ImuProbeResult =
    if (open && imu == 0) power.openImuOwned(bus,exclusive) else if (!open) nessoImuCloseOwned(imu,exclusive) else imu
