import "../../src/esp32/i2s/source_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_source_example")
trusted fun example(owner: int,tx: bool,source: int,exclusive: bool,close: bool): int =
    if (close) C6I2sSource(owner).closeOwned(exclusive)|0 else c6I2sSourceOpenOwned(tx,source,exclusive)|0
