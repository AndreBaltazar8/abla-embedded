import "../../src/sd/selected_write_esp32c61.ab"
import "abla/build"
// Explicit sector mutation; caller owns initialized card, selected CS and gate.
@export("abla_esp32c61_sd_write_example")
trusted fun example(master: Esp32C61SpiMaster,highCapacity: bool,block: int,
    scratch: NativeBuffer,source: NativeBuffer): SdSpiWriteResult =
    sdSpiWriteBlockSelected(master|0,highCapacity,block,scratch,source)
