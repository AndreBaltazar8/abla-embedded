import "../../src/esp32/i2c/software_bus_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller retains the scalar lease on every path, owns clocks/pads and all
// bus activity. clearStuck requires explicit single-master slave-clock consent.
@export("abla_esp32p4_software_i2c_recovery_example")
fun example(action: int,lease: Esp32P4SoftwareI2cBus,sda: int,scl: int,clearStuck: bool): Esp32P4SoftwareI2cBus {
    if (action == 0) return esp32P4SoftwareI2cOpenOwned(sda,scl,5,1000)
    if (action == 1) return lease.recoverOwned(clearStuck)
    if (action == 2) return lease.closeOwned()
    return lease
}
