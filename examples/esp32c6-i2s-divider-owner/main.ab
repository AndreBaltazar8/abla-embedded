import "../../src/esp32/i2s/divider_owner_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_divider_owner_example")
trusted fun example(owner: C6I2sDividerOwner,port: int,tx: bool,integer: int,numerator: int,denominator: int,exclusive: bool,close: bool): C6I2sDividerOwner =
    if (close) owner.closeOwned(exclusive) else c6I2sDividerOpenOwned(port,tx,integer,numerator,denominator,exclusive)
