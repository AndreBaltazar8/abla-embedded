import "../../src/m5stack/corep4x_microphone_dma_esp32p4.ab"
// Callable preparation only; caller supplies all ownership described by API.
// This neither configures the ES7210 nor starts recording, and is not flashable.
@export("abla_corep4x_microphone_dma_example")
trusted fun prepare(channel: i32,descriptors: u32,count: i32,payload: u32,stride: i32,
    bytes: i32,revision: i32,polls: i32,exclusive: bool): i32 =
    i32(coreP4xPrepareMicrophoneDmaOwned(int(channel),int(descriptors),int(count),int(payload),int(stride),int(bytes),int(revision),int(polls),exclusive))
