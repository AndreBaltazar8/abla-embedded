import "../../src/esp32/power/sleep_config_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32c5_sleep_config_example")
trusted fun configure(record: NativeBuffer,policy: C5SleepPower,clocks: u32,deep: bool,xtalFast: bool,lpFast: bool,
    slow: int,fast: int,inrush: bool,modemCycles: int,pvtBias: int,close: bool,exclusive: bool): int {
    if (close) return esp32C5SleepConfigCloseOwned(record,exclusive)
    val calibration=esp32C5SleepCalibrationReadOwned(exclusive)
    esp32C5SleepConfigApplyOwned(record,policy,clocks,deep,xtalFast,lpFast,calibration,slow,fast,inrush,exclusive,modemCycles,pvtBias)
}
