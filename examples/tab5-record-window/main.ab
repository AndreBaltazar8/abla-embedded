import "../../src/m5stack/tab5_record_window_esp32p4.ab"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Starts with running192B RX session. Output retains only result.bytes() of
// raw24kHz stereo16LE; inspect session recovery state before reusing hardware.
@export("abla_tab5_record_window_example")
trusted fun record(r: NativeBuffer,output: NativeBuffer,blocks: i32,maxIdle: i32,exclusive: bool): int =
    tab5RecordWindowOwned(r,output,int(blocks),int(maxIdle),exclusive)|0
