import "../../src/esp32/i2c_hardware_esp32p4.ab"
import "../../src/io_expander/m5ioe1_device.ab"
import "abla/runtime/scalar"
// CoreP4X expander path using the unchanged driver and hardware transport.
// The caller supplies a ready exclusive session; successful binding transfers
// access ownership to the provider until bus.close succeeds. No boot image.
@export("abla_esp32p4_i2c_hardware_example")
trusted fun example(record: int,cpuHz: u32,action: int,handle: int,pin: int): int {
    if (action == 0) return i2cHardwareBindOwned(nativeBufferAt(record,72),u32(40000000),cpuHz)|0
    if (action == 1) return m5Ioe1(I2cBus(handle))|0
    if (action == 2) return if (M5Ioe1(handle).begin()) 1 else 0
    if (action == 3) return M5Ioe1(handle).digitalReadChecked(pin)|0
    if (action == 4) return if (M5Ioe1(handle).close()) 1 else 0
    if (action == 5) return if (I2cBus(handle).close()) 1 else 0
    return 0
}
