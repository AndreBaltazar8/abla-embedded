import "../../src/esp32/adc_oneshot_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_adc_oneshot_example")
trusted fun example(conversion: C5AdcConversion,channel: int,attenuation: int,sourceHz: int,polls: int,exclusive: bool,operation: int): C5AdcConversion =
    if (operation == 0) c5AdcConversionStartOwned(channel,attenuation,sourceHz,exclusive)
    else if (operation == 1) conversion.waitOwned(polls,exclusive)
    else if (operation == 2) conversion.releaseOwned(exclusive) else conversion
