import "../../src/esp32/gpio_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/atom_s3_panel.ab"
import "abla/runtime/scalar"
import "abla/build"
// RDDID supplied by caller's successful probe; no hardware identification is
// performed here. Caller owns reset/power/configured pads/backlight and gate.
@export("abla_atom_s3_panel_example")
trusted fun run(board: M5BoardId,id: int,gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult {
    val panel=atomS3PanelFromId(board,id)
    val ready=panel.beginChecked(gate,owner,rotation)
    if (!ready.valid()) return ready
    return panel.fillRectChecked(gate,owner,rotation,0,0,128,128,rgb565(0,0,255))
}
