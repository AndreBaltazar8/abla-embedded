import "../../src/esp32/power/sleep_profile_esp32p4.ab"
@export("abla_esp32p4_sleep_profile_example")
trusted fun example(address: int,capacity: int,configAddress: int,configCapacity: int,revision: int,deep: bool,close: bool,exclusive: bool): int {
    val r=nativeBufferAt(address,capacity)
    if (close) return esp32p4SleepProfileCloseOwned(r,exclusive)
    return esp32p4SleepProfileOpenOwned(r,nativeBufferAt(configAddress,configCapacity),revision,deep,exclusive)
}
