import "../../src/m5stack/core_s3_pins_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller has already configured and exclusively owns Port B's input pad.
// Read only: this does not initialize the board or seize a shared peripheral.
@export("abla_core_s3_pins_example")
trusted fun example(position: int): int = (m5CoreS3().mBusPin(position).number()+1) |
    (if (m5CoreS3().portB().pin1().read()) 256 else 0)
