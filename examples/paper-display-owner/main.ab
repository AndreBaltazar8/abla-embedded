import "../../src/m5stack/paper_display_owner_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller already owns stable board power and stopped SD/other pin users.
// Returns with parent retaining SPI gate and pin leases even after failure.
@export("abla_paper_display_owner_example")
trusted fun example(parent: M5PaperDisplayOwner,gate: PeripheralGate,token: u32,
    child: It8951Session,scratch: NativeBuffer,polls: int,action: int): int {
    if (action == 0) return parent.openOwned(gate,token,child,scratch,polls,true,true)
    if (action == 1) return if (parent.closeOwned(true)) 0 else -1
    if (action == 2) return parent.recoverControllerOwned(scratch,polls,true)
    return -1
}
