import "../../src/esp32/power/sleep_clic_esp32p4.ab"
@export("abla_esp32p4_sleep_clic_example")
trusted fun example(record: int,restore: bool,exclusive: bool): int =
    if (restore) esp32p4SleepClicRestoreOwned(nativeBufferAt(record,220),exclusive)
    else esp32p4SleepClicSaveOwned(nativeBufferAt(record,220),exclusive)
