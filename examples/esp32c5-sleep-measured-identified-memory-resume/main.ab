import "../../src/esp32/power/sleep_measured_identified_memory_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MeasuredIdentifiedMemoryResumeExample")
@export("abla_esp32c5_sleep_measured_identified_memory_resume_example")
trusted fun resume(record: NativeBuffer,recheck: bool,exclusive: bool): int =
    if (recheck) esp32C5SleepMeasuredIdentifiedMemoryRecheckOwned(record,exclusive) else esp32C5SleepMeasuredIdentifiedAfterCalibrationOwned(record,exclusive)
