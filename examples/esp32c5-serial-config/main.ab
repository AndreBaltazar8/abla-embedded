import "../../src/esp32/uart/config_esp32c5.ab"
import "abla/build"
// Caller retains stopped UART/clocks/pads and serialized PCR ownership.
@export("abla_esp32c5_serial_config_example")
trusted fun example(unit: int,sourceHz: int,baud: int,dataBits: int,parity: int,stop: int,polls: int): int =
    serial(unit).configureOwned(sourceHz,baud,dataBits,parity,stop,polls)
