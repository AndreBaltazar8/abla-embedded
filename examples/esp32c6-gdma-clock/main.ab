import "../../src/esp32/gdma_clock_esp32c6.ab"
import "abla/build"
import "../../src/esp32/gdma_clock_c6_sequence.ab"
@export("abla_esp32c6_gdma_clock_example")
trusted fun example(owner: C6GdmaClock,exclusive: bool,close: bool): C6GdmaClock =
    if (close) owner.closeOwned(exclusive) else c6GdmaClockOpenOwned(exclusive)
