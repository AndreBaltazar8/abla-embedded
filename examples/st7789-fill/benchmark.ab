import "../../src/m5stack/display_map.ab"
import "../../src/display/color.ab"
import "abla/build"

// These leaves exist only in the separately built comparison object. Internal
// linkage keeps them inspectable without turning them into firmware exports.
fun displayRgb565Benchmark(red: i32, green: i32, blue: i32): i32 =
    i32(rgb565(red, green, blue).value())

fun displayViewBenchmark(): u64 =
    m5BoardStickCPlus2.displayGeometry().view(
        m5BoardStickCPlus2.displayRotation()
    )

fun displayStickCViewBenchmark(): u64 =
    m5BoardStickC.displayGeometry().view(m5BoardStickC.displayRotation())

fun displayStackViewBenchmark(): u64 =
    m5BoardStack.displayGeometry().view(m5BoardStack.displayRotation())

val rgb565Retained = #internalFunction(
    "displayRgb565Benchmark", "abla_display_rgb565"
)
val viewRetained = #internalFunction(
    "displayViewBenchmark", "abla_display_view"
)
val stickCViewRetained = #internalFunction(
    "displayStickCViewBenchmark", "abla_display_stickc_view"
)
val stackViewRetained = #internalFunction(
    "displayStackViewBenchmark", "abla_display_stack_view"
)
