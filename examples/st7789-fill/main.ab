import "../../src/m5stack/display_esp32.ab"
import "../../src/esp32/task.ab"

// This example targets M5StickC Plus2. It only writes the LCD and backlight
// pins declared by that board profile; do not flash it to a different board.
@export("app_main")
trusted fun appMain(): void {
    val board = m5BoardStickCPlus2
    val bus = board.openDisplayBus()
    if (!bus.valid()) return
    val display = board.openSpiDisplay(bus)
    if (!display.valid()) {
        bus.close()
        return
    }
    val view = board.beginDisplay(display)
    if (view.width() > 0) {
        display.fill(view, rgb565Red)
        taskDelay(500)
        display.fill(view, rgb565Green)
        taskDelay(500)
        display.fill(view, rgb565Blue)
    }
    return
}
