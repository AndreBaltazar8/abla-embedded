import "../../src/esp32/spi/quad_transfer_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Exclusive initialized quad bus and CS already selected. Caller owns cleanup
// and must retain storage/peripheral ownership after timeout or FIFO error.
@export("abla_esp32s3_spi_quad_transfer_example")
trusted fun transmit(peripheral: int,command: int,commandBits: int,address: int,addressBits: int,
    data: NativeBuffer,bytes: int,exclusiveSelected: bool): int =
    if (exclusiveSelected) esp32s3SpiQuadTransmitOwned(peripheral,command,commandBits,address,addressBits,0,data,bytes,100000) else 2
