import "../../src/display/co5300_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns initialized panel/quad SPI and current drawing window.
@export("abla_esp32s3_co5300_transfer_example")
trusted fun transfer(gate: PeripheralGate,owner: u32,pins: QuadSpiPins,select: Pin,
    command: int,data: NativeBuffer,bytes: int,pixels: bool): int =
    esp32s3Co5300Transfer(gate,owner,2,pins,select,command,data,bytes,pixels)|0
