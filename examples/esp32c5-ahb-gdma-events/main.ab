import "../../src/esp32/ahb_gdma_events_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_ahb_gdma_events_example")
trusted fun example(events: C5AhbGdmaEvents,channel: int,tx: bool,handled: int,exclusive: bool,ack: bool): int =
    if (ack) events.acknowledgeOwned(handled,exclusive) else c5AhbGdmaEventsReadOwned(channel,tx,exclusive)|0
