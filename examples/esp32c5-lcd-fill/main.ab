import "../../src/display/spi_fill_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_lcd_fill_example")
trusted fun example(master: Esp32C5SpiMaster,gate: PeripheralGate,owner: u32,dc: int,
    view: LcdView,x: int,y: int,width: int,height: int,color: Rgb565): C5LcdDrawResult =
    esp32C5LcdFillRect(master,gate,owner,dc,view,x,y,width,height,color,1000)
