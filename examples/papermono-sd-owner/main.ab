import "../../src/m5stack/papermono_sd_owner_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_papermono_sd_owner_example")
trusted fun storage(owner: PaperMonoSdOwner,control: M5Pm1Control,descriptor: NativeBuffer,payload: NativeBuffer,
    operation: int,nowMs: u32,nowUs: u32,exclusive: bool): int {
    if (operation == 0) return owner.beginOwned(control|0,descriptor,payload,1,false,4,nowMs,2000,exclusive)
    if (operation == 1) return owner.pollOwned(nowMs,nowUs,exclusive)
    if (operation == 2) return owner.closeOwned(exclusive)
    return 3
}
