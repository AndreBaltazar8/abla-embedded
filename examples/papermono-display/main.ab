import "../../src/m5stack/papermono_display_startup_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Freshrecord, initializedimage; retained PM1control/pads/sharedrails owned.
// Success includesfirstBUSY-completedrefresh, not justcontrollerinitialization.
@export("abla_papermono_display_example")
trusted fun initialize(control: M5Pm1Control,record: NativeBuffer,canvas: NativeBuffer,history: NativeBuffer,
    gate: PeripheralGate,owner: u32,mode: int,brightness: int,polls: int,exclusive: bool): int =
    control.initializePaperMonoDisplayOwned(record,canvas,history,gate,owner,mode,brightness,polls,exclusive)
