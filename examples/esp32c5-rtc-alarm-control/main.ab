import "../../src/esp32/rtc_alarm_control_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5RtcAlarmControlExample")
@export("abla_esp32c5_rtc_alarm_control_example")
trusted fun alarm(timer: int,operation: int,enabled: bool,exclusive: bool): int {
    if (operation == 0) return esp32C5RtcAlarmPendingOwned(timer,exclusive)
    if (operation == 1) return if (esp32C5RtcAlarmInterruptOwned(timer,enabled,exclusive)) 1 else 0
    if (operation == 2) return if (esp32C5RtcAlarmCancelOwned(timer,exclusive)) 1 else 0
    return -1
}
