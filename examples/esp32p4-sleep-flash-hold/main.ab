import "../../src/esp32/power/sleep_flash_hold_esp32p4.ab"
@export("abla_esp32p4_sleep_flash_hold_example")
trusted fun example(token: int,revision: int,close: bool,exclusive: bool): int =
    (if (close) P4SleepFlashHold(token).closeOwned(exclusive) else esp32p4SleepFlashHoldOpenOwned(revision,exclusive))|0
