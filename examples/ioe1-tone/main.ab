import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/io_expander/m5ioe1_tone.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller retains device/bus and owns ALL shared PWM users. Select routing
// separately from verified board wiring. Poll or stop before releasing anything.
@export("abla_ioe1_tone_example")
trusted fun example(state: NativeBuffer,chip: M5Ioe1,channel: int,now: int,start: bool): int {
    if (!softwareI2cProviderBufferSafe(state,32)) return 2
    return if (start) ioe1ToneStartOwned(state,chip,channel,1000,1024,now,100,true) else ioe1TonePollOwned(state,now,true)
}
