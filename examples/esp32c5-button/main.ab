import "../../src/esp32/button_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller retains result.button() and consumes events only when result.valid().
// Input pad/clock ownership and timestamp source are explicit.
@export("abla_esp32c5_button_example")
trusted fun example(button: GpioButton,milliseconds: int): GpioButtonUpdate = button.updateAtOwned(milliseconds)
