import "../../src/esp32/i2s/clock_divider_esp32p4.ab"
@export("abla_esp32p4_i2s_divider_example")
trusted fun configure(port: i32, transmit: bool, integer: i32, numerator: i32,
    denominator: i32, exclusive: bool): i32 {
    i32(esp32p4I2sSetDividerOwned(int(port),transmit,int(integer),int(numerator),int(denominator),exclusive))
}
