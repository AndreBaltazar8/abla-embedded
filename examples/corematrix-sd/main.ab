import "../../src/m5stack/corematrix_sd_esp32c61.ab"
import "abla/build"
// Fresh40B owner/64B session storage only; initialized live CoreMatrix control.
// response supplies16B for initialization and CSD capacity validation.
@export("abla_corematrix_sd_example")
trusted fun example(control: M5CoreMatrixControl,storage: NativeBuffer,session: NativeBuffer,
    gate: PeripheralGate,owner: u32,sourceHz: int,scratch: NativeBuffer,response: NativeBuffer): int {
    val sd=m5CoreMatrixSdAt(storage)
    if (!sd.initializeFresh() || !esp32C61SdSessionInitializeFresh(session)) return 2
    return sd.openOwned(control|0,session,gate,owner,sourceHz,scratch,response,10000,true)
}
