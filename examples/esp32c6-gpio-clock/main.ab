import "../../src/esp32/gpio_clock_esp32c6.ab"
import "abla/build"
// Preserve returned owner through every failure. Close only after all child
// pads/buses are released; source startup and LP clocks are separate work.
@export("abla_esp32c6_gpio_clock_example")
fun example(close: bool,owner: Esp32C6GpioClock,exclusive: bool): Esp32C6GpioClock =
    if (close) owner.closeOwned(exclusive) else esp32C6GpioClockOpenOwned(exclusive)
