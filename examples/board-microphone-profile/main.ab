import "../../src/m5stack/microphone_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
// No hardware operations. Query explicitly selected board; profile availability
// does not imply power/codec setup or a supported driver on the running chip.
@export("abla_board_microphone_profile_example")
fun profile(board: int): M5MicrophoneProfile = M5BoardId(board).microphoneProfile()
