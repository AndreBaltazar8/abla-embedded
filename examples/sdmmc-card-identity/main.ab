import "../../src/sd/mmc_card_esp32s3.ab"
import "../../src/sd/mmc_identity.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_card_identity_example")
trusted fun example(card: NativeBuffer,field: int): int {
    if (field == 0) return sdMmcCardManufacturer(card)
    if (field == 1) return sdMmcCardOem(card)
    if (field == 2) return sdMmcCardRevision(card)
    if (field == 3) return sdMmcCardSerial(card)
    if (field == 4) return sdMmcCardManufacturingYear(card)
    if (field == 5) return sdMmcCardManufacturingMonth(card)
    return sdMmcCardProductByte(card,field-6)
}
