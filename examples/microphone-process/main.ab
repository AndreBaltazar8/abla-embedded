import "../../src/audio/microphone_process.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// No hardware access. Caller owns40B state, pairs*4 input, and outputBytes.
// Flags: bit0 input stereo,1 ADC,2 FIFO pair swap,3 output stereo,4 signed16.
// initialize resets filter history and partial input; otherwise config persists.
@export("abla_microphone_process_example")
trusted fun process(state: u32,input: u32,pairs: i32,output: u32,outputBytes: i32,
    oversampling: i32,gain: i32,filter: i32,flags: i32,initialize: i32): i32 {
    val buffer=nativeBufferAt(int(state),40)
    if (initialize != i32(0) && !microphoneProcessInitialize(buffer,int(oversampling),int(gain),int(filter),
        (flags&i32(1)) != i32(0),(flags&i32(2)) != i32(0),(flags&i32(4)) != i32(0))) return i32(-1)
    return i32(microphoneProcess(buffer,nativeBufferAt(int(input),int(pairs)*4),int(pairs),
        nativeBufferAt(int(output),int(outputBytes)),(flags&i32(8)) != i32(0),(flags&i32(16)) != i32(0)))
}
