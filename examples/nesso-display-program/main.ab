import "../../src/esp32/spi_software_esp32c6.ab"
import "../../src/display/software_program_checked.ab"
import "../../src/m5stack/display_map.ab"
import "abla/build"
// Native callable, not a boot image. Caller has configured LCD pins, E1
// power/reset, immutable validated panel program and pinned/calibrated clocks.
// This executes commands, not a complete RGB565 framebuffer/display owner.
@export("abla_nesso_display_program_example")
trusted fun example(gate: PeripheralGate,owner: u32,program: NativeBuffer,length: int): SpiTransactionResult {
    val p=m5BoardArduinoNessoN1.displaySpiPins()
    return softwareLcdRunProgramChecked(gate,owner,Pin(p.clock()),Pin(p.mosi()),Pin(p.chipSelect()),Pin(p.dataCommand()),program,length,1,false)
}
