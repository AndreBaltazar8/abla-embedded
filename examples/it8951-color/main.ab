import "../../src/display/it8951_color.ab"
import "abla/runtime/scalar"
import "abla/build"
// CPU-only conversion. Upload the completed4bpp buffer with it8951Load4.
@export("abla_it8951_color_example")
trusted fun example(source: NativeBuffer,sourceStride: int,destination: NativeBuffer,
    destinationStride: int,width: int,height: int,fast: bool): bool =
    it8951ConvertRgbOwned(source,sourceStride,destination,destinationStride,width,height,0,0,true,fast,false,true)
