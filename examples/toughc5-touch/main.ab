import "../../src/m5stack/tough_touch_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Close returns the replacement controller scalar. Keep it on failed cleanup.
@export("abla_toughc5_touch_example")
trusted fun touch(owner: M5ToughPowerOwner,bus: int,controller: TouchControllerOpen,snapshot: NativeBuffer,previous: NativeBuffer,operation: int,exclusive: bool,eventsConsumed: bool): int {
    if (operation == 0) return owner.openTouchOwned(bus,exclusive,eventsConsumed)|0
    if (operation == 1) return owner.readTouchOwned(bus,controller,snapshot,previous,exclusive)
    if (operation == 2 && exclusive) return controller.closeOwned()|0
    return -1
}
