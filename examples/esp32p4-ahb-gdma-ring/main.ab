import "../../src/esp32/ahb_gdma_ring_esp32p4.ab"
import "abla/runtime/scalar"
// CPU build only: cache publication and channel startup are deliberately separate.
@export("abla_esp32p4_ahb_gdma_ring_example")
trusted fun build(descriptors: u32,count: i32,buffers: u32,stride: i32,bytes: i32,
    transmit: bool,circular: bool,exclusive: bool): bool {
    esp32p4AhbGdmaBuildRingOwned(int(descriptors),int(count),int(buffers),int(stride),int(bytes),transmit,circular,exclusive)
}
