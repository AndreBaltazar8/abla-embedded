import "../../src/m5stack/stopwatch_sleep_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Initialized powered panel; serialized with all drawing/reset operations.
@export("abla_stopwatch_sleep_example")
trusted fun sleep(gate: PeripheralGate,owner: u32,sleeping: bool,brightness: int,exclusive: bool): int =
    stopWatchPanelSleepOwned(gate,owner,sleeping,brightness,exclusive)|0
