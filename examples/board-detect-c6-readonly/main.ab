import "../../src/m5stack/detect_esp32c6.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable C6-only example: no serial SDK, heap, pin probing or fuse writes.
// Preserve current selection; do not assume every ESP32-C6 is an M5 board.
@export("abla_board_detect_c6_readonly_example")
trusted fun example(current: M5BoardId): M5BoardId = m5DetectCurrentEsp32C6(current)
