// Entry owns I2C1/pins12(SDA),11(SCL) for this invocation. All other power,
// clock, stopped-DMA, pad and storage ownership prerequisites above remain.
// xtalHz/cpuHz must describe the running clocks; no clock switching is done.
// Bit59: I2C/handle setup failure (low8:2 arguments,3 bus,4 devices).
// Bit62: bus teardown/partial-setup recovery failed, independent of the phase.
// Bus.close revokes device slots, not DMA. A DMA-stop failure still forbids
// reuse of caller storage/channel; closing I2C is NOT proof of DMA shutdown.
trusted fun cores3RecordReplayExample(xtalHz: u32, cpuHz: u32,
    descriptors: u32, ring: u32, recording: u32, staging: u32, owner: u32): int {
    if (xtalHz == u32(0) || cpuHz == u32(0) || owner == u32(0))
        return (1 << 59) | 2
    val bus = i2cMaster(1, 12, 11, xtalHz, cpuHz)
    if (!bus.valid()) return (1 << 59) | 3 |
        (if (i2cAbortSetup(1)) 0 else (1 << 62))
    val power = axp2101(bus)
    val expander = aw9523(bus)
    val amplifier = aw88298(bus)
    val microphone = es7210(bus)
    var result = (1 << 59) | 4
    if (power.valid() && expander.valid() && amplifier.valid() && microphone.valid()) {
        result = cores3RecordReplayWithDevices(u32(power & 4294967295),
            u32(microphone & 4294967295), u32(amplifier & 4294967295),
            u32(expander & 4294967295), descriptors, ring, recording, staging, owner)
    }
    if (!bus.close()) result = result | (1 << 62)
    result
}
