import "../../src/audio/pcm_channels_tone.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pcm_channels_tone_example")
trusted fun render(channels: PcmChannels,tone: PcmTone,frames: int,accumulator: NativeBuffer,
    scratch: NativeBuffer,output: NativeBuffer,stereo: bool,gainQ15: int): bool =
    channels.renderWithTone(tone,frames,accumulator,scratch,output,stereo,gainQ15)
