import "../../src/esp32/i2c_esp32c5.ab"
import "../../src/m5stack/tough_tone_owner.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32c5_tough_tone_owner_example")
trusted fun example(owner: M5ToughPowerOwner,record: NativeBuffer,hz: int,duty: int,now: int,duration: int,exclusiveSharedPwm: bool,operation: int): int =
    if (operation == 0) owner.beginToneOwned(record,hz,duty,now,duration,exclusiveSharedPwm)
    else if (operation == 1) owner.pollToneOwned(record,now,exclusiveSharedPwm)
    else if (operation == 2) owner.stopToneOwned(record,exclusiveSharedPwm) else 2
