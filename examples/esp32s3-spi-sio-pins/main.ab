import "../../src/esp32/spi/shared_pins_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns stopped controller and all pads/routes; partial failure retains
// ownership. No transfer/clock setup/snapshot restoration is implied.
@export("abla_esp32s3_spi_sio_pins_example")
trusted fun run(peripheral: int,clock: Pin,data: Pin,cs: Pin): int = esp32s3SpiRouteSharedPinsOwned(peripheral,clock,data,cs)
