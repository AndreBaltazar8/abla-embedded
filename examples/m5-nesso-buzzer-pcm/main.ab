import "../../src/m5stack/buzzer_pcm_esp32c6.ab"
import "abla/build"
// Caller-pinned PLL240 and GPIO roots; prepared encoder output in DMA SRAM.
// Initialization/cancellation FIFO loss is explicit. Callable, NOT flashable.
@export("abla_m5_nesso_buzzer_pcm_example")
trusted fun example(r: NativeBuffer,rate: int,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,discard: bool,exclusive: bool,operation: int): int =
    if (operation == 0) m5BoardArduinoNessoN1.openC6BuzzerPcmOwned(r,0,1,240000000,rate,100,descriptors,count,buffers,stride,bytes,polls,discard,exclusive)
    else if (operation == 1) c6BuzzerPcmPollOwned(r,16,polls,exclusive)
    else if (operation == 2) c6BuzzerPcmCloseOwned(r,polls,exclusive)
    else if (operation == 3) c6BuzzerPcmCancelOwned(r,16,polls,0,discard,exclusive)
    else if (operation == 4) c6BuzzerPcmRetryStopOwned(r,polls,exclusive) else 2
