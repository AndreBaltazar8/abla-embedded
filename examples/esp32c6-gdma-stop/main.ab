import "../../src/esp32/gdma_control_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_gdma_stop_example")
trusted fun example(owner: C6GdmaStop,channel: int,tx: bool,polls: int,exclusive: bool,wait: bool): C6GdmaStop =
    if (wait) owner.waitDrainedOwned(polls,exclusive) else c6GdmaStopBeginOwned(channel,tx,polls,exclusive)
