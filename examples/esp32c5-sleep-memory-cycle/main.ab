import "../../src/esp32/power/sleep_memory_cycle_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5SleepMemoryCycleExample")
@export("abla_esp32c5_sleep_memory_cycle_example")
trusted fun sleep(record: NativeBuffer,request: NativeBuffer,memory: NativeBuffer,resume: bool,exclusive: bool): int =
    if (resume) esp32C5SleepCycleContinueOwned(record,exclusive) else esp32C5SleepMemoryCycleBeginOwned(record,request,memory,exclusive)
