import "../../src/esp32/pwm_session_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_pwm_duty_example")
trusted fun example(record: NativeBuffer,duty: int,polls: int,exclusive: bool,wait: bool): int =
    if (wait) c6PwmSessionWaitDutyOwned(record,polls,exclusive)
    else c6PwmSessionSetDutyOwned(record,duty,polls,exclusive)
