import "../../src/esp32/flash_jedec_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5FlashJedecExample")
@export("abla_esp32c5_flash_jedec_example")
trusted fun identify(record: NativeBuffer,polls: int,action: int,exclusive: bool): int {
    if (action == 0) return esp32C5FlashJedecReadOwned(record,polls,exclusive)
    if (action == 1) return esp32C5FlashJedecId(record)
    if (action == 2) return esp32C5FlashSuspendMaskForJedec(esp32C5FlashJedecId(record))
    return -1
}
