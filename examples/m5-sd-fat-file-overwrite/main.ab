import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3_write.ab"
import "../../src/storage/fat_file_handle.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_m5_sd_fat_file_overwrite_example")
trusted fun overwrite(file: FatFile,owner: u32,offset: int,length: int,budget: int,source: NativeBuffer,
    modified: RtcDateTime,workspace: NativeBuffer): FatFileOverwriteChecked =
    file.overwriteAt(owner,offset,length,budget,source,modified,workspace)
