import "../../src/esp32/ledc_esp32c6.ab"
import "abla/build"
// Native callable, NOT firmware. Caller owns timer/all selecting channels,
// stable LEDC/APB source and clocks, and excludes resets/IRQ/ETM. This does
// not acquire clock leases, route GPIO or implement a complete buzzer.
// action0pause,1configure while paused,2resume after update completion.
@export("abla_esp32c6_ledc_timer_example")
trusted fun example(timer: int,action: int,sourceHz: int,hz: int,resolution: int): int {
    if (action == 0) return c6LedcTimerPauseOwned(timer)
    if (action == 1) return c6LedcTimerConfigurePausedOwned(timer,resolution,c6LedcDividerForHz(sourceHz,hz,resolution))
    if (action == 2) return c6LedcTimerResumeOwned(timer)
    return 2
}
