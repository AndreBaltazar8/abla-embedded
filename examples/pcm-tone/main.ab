import "../../src/audio/pcm_tone.ab"
import "abla/runtime/scalar"
import "abla/build"
// Initialize caller-owned32B PcmTone before use. Feed rendered staging to the
// selected PCM16 mixer/speaker DMA provider; retain it across transfer retries.
@export("abla_pcm_tone_example")
trusted fun render(tone: PcmTone,frames: int,output: NativeBuffer,stereo: bool): bool =
    tone.render(frames,output,stereo)
