import "../../src/esp32/power/retention_session_esp32p4.ab"
@export("abla_esp32p4_retention_session_example")
trusted fun example(record: int,config: int,close: bool,exclusive: bool): int =
    if (close) esp32p4RetentionSessionCloseOwned(nativeBufferAt(record,64),exclusive) else esp32p4RetentionSessionOpenOwned(nativeBufferAt(record,64),nativeBufferAt(config,32),exclusive)
