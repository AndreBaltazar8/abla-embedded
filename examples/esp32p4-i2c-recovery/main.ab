import "../../src/esp32/i2c/hardware_recovery_esp32p4.ab"
import "../../src/esp32/i2c/hardware_scan_esp32p4.ab"
import "abla/runtime/scalar"
@export("abla_esp32p4_i2c_recovery_example")
trusted fun example(action: int,session: int,cpuHz: u32,bus: int,address: int,stopAfterNack: bool): int {
    if (action == 0) return i2cHardwareBindOwned(nativeBufferAt(session,72),u32(40000000),cpuHz)|0
    if (action == 1) return I2cBus(bus).probeStatus(address)
    if (action == 2) return I2cBus(bus).recoverStatus(1000,stopAfterNack)
    if (action == 3) return if (I2cBus(bus).close()) 1 else 0
    return 2
}
