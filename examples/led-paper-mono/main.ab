import "../../src/esp32/abla_host_esp_idf.ab"
import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/esp32/serial_esp32s3.ab"
import "../../src/led/paper_mono.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // M5Paper Mono internal I2C: SDA 47, SCL 48. This firmware is board-specific.
    val bus = i2cMaster(0, 47, 48, u32(40000000), u32(160000000))
    val power = m5Pm1(bus)
    val io = m5Ioe1(bus)
    if (power.begin() && io.begin()) {
        val led = paperMonoLed(power, io)
        if (led.begin()) {
            led.setAutoDisplay(false)
            led.setAllColor(rgbColor(16, 0, 16))
            led.display()
            peripheralDelayMilliseconds(250)
            led.setAllColor(rgbColor(0, 0, 0))
            led.display()
            log.line("Paper Mono LED exercised")
        }
    }
    io.close()
    power.close()
    bus.close()
    return
}
