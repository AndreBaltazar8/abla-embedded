import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/esp32/task.ab"
import "../../src/io_expander/m5ioe1.ab"
import "../../src/led/paper_mono.ab"
import "../../src/power/m5pm1.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // M5Paper Mono internal I2C: SDA 47, SCL 48. This firmware is board-specific.
    val bus = i2cMaster(0, 47, 48)
    val power = m5Pm1(bus)
    val io = m5Ioe1(bus)
    if (power.begin() && io.begin()) {
        val led = paperMonoLed(power, io)
        if (led.begin()) {
            led.setAutoDisplay(false)
            led.setAllColor(rgbColor(16, 0, 16))
            led.display()
            taskDelay(250)
            led.setAllColor(rgbColor(0, 0, 0))
            led.display()
            log.line("Paper Mono LED exercised")
        }
    }
    io.close()
    power.close()
    bus.close()
    return
}
