import "../../src/esp32/power/sleep_session_esp32p4.ab"
// Caller-owned prepared environment; not a boot image. action0 begin,
// 1 continue,2 abort publication only. All memory remains retained and owned.
@export("abla_esp32p4_sleep_session_example")
trusted fun example(record: int,config: int,entry3: int,graph: int,graphBytes: int,backing: int,backingBytes: int,revision: int,mhz: int,regdma: bool,polls: int,eventPolls: int,action: int,exclusive: bool): int {
    val r=nativeBufferAt(record,464)
    if (action == 0) return esp32p4SleepSessionBeginOwned(r,nativeBufferAt(config,32),entry3,nativeBufferAt(graph,graphBytes),nativeBufferAt(backing,backingBytes),revision,mhz,regdma,polls,eventPolls,exclusive)
    if (action == 1) return esp32p4SleepSessionContinueOwned(r,polls,eventPolls,exclusive)
    if (action == 2) return esp32p4SleepSessionAbortPublicationOwned(r,polls,eventPolls,exclusive)
    if (action == 3) return esp32p4SleepSessionPublishOwned(r,nativeBufferAt(config,32),entry3,nativeBufferAt(graph,graphBytes),nativeBufferAt(backing,backingBytes),revision,mhz,regdma,polls,exclusive)
    if (action == 4) return esp32p4SleepSessionPublishContinueOwned(r,polls,exclusive)
    if (action == 5) return esp32p4SleepSessionAbortBeforeCycleOwned(r,polls,eventPolls,exclusive)
    return 4
}
