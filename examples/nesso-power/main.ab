import "../../src/m5stack/nesso_power_esp32c6.ab"
import "abla/runtime/scalar"
import "abla/build"
// Native callable, not a boot image. Caller supplies current C6 session on
// Nesso SDA10/SCL8 and exclusive40B RAM. op0 initializes fresh RAM; op1 performs
// full board power setup INCLUDING gauge reset/unseal; op2 closes handles only.
// Keep state and bus until close succeeds. No automatic rail rollback.
@export("abla_nesso_power_example")
trusted fun example(storage: NativeBuffer,bus: I2cBus,operation: int,exclusive: bool): int {
    val power=nessoPowerAt(storage)
    if (!exclusive || power == 0) return 2
    if (operation == 0) return if (power.initialize()) 1 else 2
    if (operation == 1) return power.openOwned(bus|0,true)
    if (operation == 2) return if (power.closeOwned(true)) 1 else 7
    return 2
}
