import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/power/m5pm1_device.ab"
import "../../src/io_expander/m5ioe1_device.ab"
import "../../src/led/m5pm1_state.ab"
import "../../src/led/paper_mono_state.ab"
import "../../src/led/powerhub_device.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Caller supplies a live backend handle and owns its prepared I2C bus/power.
// kind0 PM1,1 PaperMono,2 PowerHub. Honors each handle's auto-display setting.
@export("abla_esp32s3_led_backends_packed_example")
trusted fun update(kind: int,handle: int,source: NativeBuffer,index: int,length: int,format: int): bool {
    if (kind == 0) return M5Pm1Led(handle).setPackedColors(source,index,length,format)
    if (kind == 1) return PaperMonoLed(handle).setPackedColors(source,index,length,format)
    if (kind == 2) return PowerHubLed(handle).setPackedColors(source,index,length,format)
    return false
}
