import "../../src/esp32/spi/phases_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Preconfigured clock/mode and caller-owned selected device. MOSI must have
// native SPID bidirectional routing. DC/CS management remains with caller.
// RDDID command04 + one dummy bit + four RX bytes, hardware-controlled SIO.
@export("abla_esp32s3_spi_sio_example")
trusted fun run(peripheral: int,output: NativeBuffer,polls: int): int =
    esp32s3SpiPhasesOwned(peripheral,4,8,0,0,1,2,output,4,polls,true)
