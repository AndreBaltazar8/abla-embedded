import "../../src/esp32/power/sleep_time_session_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5SleepTimeSessionExample")
@export("abla_esp32c5_sleep_time_session_example")
trusted fun time(record: NativeBuffer,start: int,before: int,period: int,outcome: int,finish: bool,exclusive: bool): int =
    if (finish) esp32C5SleepTimeFinishOwned(record,outcome,exclusive) else esp32C5SleepTimePrepareOwned(record,start,before,period,exclusive)
