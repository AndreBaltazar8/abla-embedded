import "../../src/esp32/gdma_tx_channel_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_gdma_tx_channel_example")
trusted fun example(owner: C6GdmaTxChannel,channel: int,peripheral: int,exclusive: bool,close: bool): C6GdmaTxChannel =
    if (close) owner.closeOwned(exclusive) else c6GdmaTxChannelOpenOwned(channel,peripheral,exclusive)
