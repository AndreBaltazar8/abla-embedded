import "../../src/esp32/power/sleep_clocks_esp32p4.ab"
@export("abla_esp32p4_sleep_clocks_example")
trusted fun example(record: int,sourceMHz: int,revision: int,mpllMHz: int,flash120: bool,psram: bool,polls: int,action: int,sourcesRecovered: bool,exclusive: bool): int {
    val r=nativeBufferAt(record,288)
    if (action == 0) return esp32p4SleepClocksOpenOwned(r,sourceMHz,revision,mpllMHz,flash120,psram,polls,exclusive)
    if (action == 1) return esp32p4SleepClocksContinueOwned(r,polls,exclusive)
    if (action == 2) return esp32p4SleepClocksRestoreOwned(r,polls,sourcesRecovered,exclusive)
    return 2
}
