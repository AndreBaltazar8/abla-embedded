import "../../src/esp32/i2s/dma_start_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_dma_start_example")
trusted fun example(r: NativeBuffer,channel: int,tx: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,circular: bool,polls: int,exclusive: bool,resume: bool): int =
    if (resume) c5I2sDmaStartAdvanceOwned(r,polls,exclusive) else c5I2sDmaStartBeginOwned(r,channel,tx,descriptors,count,buffers,stride,bytes,circular,polls,exclusive)
