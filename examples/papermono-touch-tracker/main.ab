import "../../src/m5stack/papermono_touch_tracker_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
// Initialized184B tracker, ready ownedtouch anddisjoint29B/40B scratch.
@export("abla_papermono_touch_tracker_example")
trusted fun update(control: M5Pm1Control,tracker: TouchTracker,touch: TouchControllerOpen,snapshot: NativeBuffer,
    frame: NativeBuffer,now: int,rotation: int,exclusive: bool): int =
    control.updatePaperMonoTouchOwned(tracker,touch,snapshot,frame,now,rotation,exclusive)
