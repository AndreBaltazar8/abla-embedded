import "../../src/storage/fat_sdmmc_esp32s3.ab"
import "../../src/storage/fat_sdmmc_utf8.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable READ stage for a mounted SDMMC session, not a boot image or new
// host initialization path. Use esp32s3-sdmmc-fat startup/width/speed/pad flow
// first, then supply its initialized reader/BPB and actual mounted extent.
// Owner keeps card/host/descriptor/bounce/source/pads and16MHz SYSTIMER alive.
// Borrow immutable UTF8 path, writable UTF16 conversion buffer sized by
// utf8Utf16Units, workspace2067 and destination1..512 bytes, all disjoint from
// transport-owned memory. No card writes. Returns bytes/0EOF or negative
// input/lookup/read errors. A failed transfer can remain pending: use existing
// explicit fatSdMmcDrainOwned before recovery or the normal close sequence.
@export("abla_esp32s3_sdmmc_utf8_read_example")
trusted fun readUtf8(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,path: NativeBuffer,bytes: int,utf16: NativeBuffer,offset: int,length: int,budget: int,destination: NativeBuffer,workspace: NativeBuffer): int =
    fatSdMmcReadPathUtf8Owned(reader,boot,first,sectors,path,bytes,utf16,offset,length,budget,destination,workspace)
