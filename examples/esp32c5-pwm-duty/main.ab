import "../../src/esp32/pwm_session_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_pwm_duty_example")
trusted fun example(record: NativeBuffer,duty: int,polls: int,exclusive: bool,wait: bool): int =
    if (wait) c5PwmSessionWaitDutyOwned(record,polls,exclusive)
    else c5PwmSessionSetDutyOwned(record,duty,polls,exclusive)
