import "../../src/esp32/i2s/standard_dma_esp32s3.ab"
import "abla/runtime/scalar"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Own both stopped directions, pads, stable PLL and internal DMA storage.
// This prepares only; TX payload must be initialized before a later start.
@export("abla_esp32s3_standard_audio_dma_example")
trusted fun prepare(port: int,tx: bool,mclk: Pin,bclk: Pin,ws: Pin,data: Pin,slots: int,
    hz: int,channel: int,desc: int,count: int,payload: int,bytes: int,owner: u32): int =
    esp32s3PrepareStandard16Dma(port,tx,mclk,bclk,ws,data,slots,hz,channel,desc,count,payload,bytes,owner)|0
