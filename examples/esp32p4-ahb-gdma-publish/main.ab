import "../../src/esp32/ahb_gdma_publish_esp32p4.ab"
import "abla/runtime/scalar"
// CPU construction + checked cache publication. No DMA start. Caller owns
// parked channel, initialized TX/owned RX slots and global cache-sync engine.
@export("abla_esp32p4_ahb_gdma_publish_example")
trusted fun prepare(descriptors: u32,count: i32,buffers: u32,stride: i32,bytes: i32,
    transmit: bool,circular: bool,polls: i32,exclusive: bool): i32 {
    if (polls < i32(1) || polls > i32(1000000)) return i32(2)
    if (!esp32p4AhbGdmaBuildRingOwned(int(descriptors),int(count),int(buffers),int(stride),int(bytes),transmit,circular,exclusive)) return i32(2)
    i32(esp32p4AhbGdmaPublishRingOwned(int(descriptors),int(count),int(buffers),int(stride),int(bytes),int(polls),exclusive))
}
