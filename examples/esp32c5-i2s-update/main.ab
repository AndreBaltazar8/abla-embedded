import "../../src/esp32/i2s/update_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_update_example")
trusted fun example(update: C5I2sUpdate,port: int,transmit: bool,polls: int,exclusive: bool,wait: bool): C5I2sUpdate =
    if (wait) update.waitOwned(polls,exclusive) else c5I2sUpdateBeginOwned(port,transmit,polls,exclusive)
