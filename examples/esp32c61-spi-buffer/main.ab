import "../../src/esp32/spi/buffer_transaction_esp32c61.ab"
import "abla/build"
@export("abla_esp32c61_spi_buffer_example")
trusted fun example(master: Esp32C61SpiMaster,gate: PeripheralGate,owner: u32,
    tx: NativeBuffer,rx: NativeBuffer,bytes: int): SpiBufferResult =
    master.transferBuffer(gate,owner,tx,rx,bytes,1000)
