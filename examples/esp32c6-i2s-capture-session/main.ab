import "../../src/esp32/i2s/capture_session_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_capture_session_example")
trusted fun example(r: NativeBuffer,operation: int,channel: int,descriptors: int,count: int,buffers: int,bytes: int,polls: int,exclusive: bool): int {
    if (operation == 0) return c6CaptureOpenOwned(r,channel,1,240000000,48000,0,0,1,2,3,-1,16,16,16,true,descriptors,count,buffers,bytes,bytes,polls,exclusive)
    if (operation == 1) return c6CapturePollOwned(r,2,polls,exclusive)
    if (operation == 2) return c6CaptureCloseOwned(r,polls,exclusive)
    if (operation == 3) return c6CaptureBufferOwned(r,0,exclusive)|0
    return 2
}
