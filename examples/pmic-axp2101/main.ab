import "../../src/esp32/abla_host_esp_idf.ab"
import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/esp32/serial_esp32s3.ab"
import "../../src/power/axp2101_device.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // CoreS3 internal I2C: SDA 12, SCL 11. This sample only reads the PMIC;
    // rail and charging setters are intentionally not exercised automatically.
    val bus = i2cMaster(0, 12, 11, u32(40000000), u32(160000000))
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }
    val power = axp2101(bus)
    if (power.begin()) {
        power.batteryLevel()
        power.batteryVoltage()
        power.vbusVoltage()
        power.tsVoltage()
        power.apsVoltage()
        power.internalTemperatureCelsius()
        power.chargeStatus()
        val irq = power.readIrqStatuses()
        if (irq.valid()) {
            val status = Axp2101IrqStatus(irq.value())
            status.has(axp2101IrqPowerKeyShortPress)
        }
        log.line("AXP2101 detected and sampled")
    } else log.line("AXP2101 not detected")
    power.close()
    bus.close()
    return
}
