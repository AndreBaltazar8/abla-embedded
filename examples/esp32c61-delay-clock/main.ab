import "../../src/esp32/delay_clock_esp32c61.ab"
import "abla/build"
// Callable only. The caller owns stable clocks and provides oscillator rates.
@export("abla_esp32c61_delay_clock_example")
trusted fun example(xtalHz: int,rcFastHz: int,exclusive: bool): Esp32C61DelayClock =
    esp32C61DelayClockConfigureOwned(xtalHz,rcFastHz,exclusive)
