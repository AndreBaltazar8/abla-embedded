import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3_write.ab"
import "../../src/storage/fat_file_handle.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller retains an initialized handle slot bound to its mounted volume.
@export("abla_m5_sd_fat_file_handle_example")
trusted fun read(storage: NativeBuffer,owner: u32,parent: int,name: NativeBuffer,units: int,offset: int,
    length: int,budget: int,destination: NativeBuffer,workspace: NativeBuffer): int {
    val file=fatFileOpen(storage,owner,parent,name,units,budget,workspace)
    if (file.status() != 1) return -100-file.status()
    val result=file.readAt(owner,offset,length,budget,destination,workspace)
    if (!file.close(owner)) return -300-result.status()
    return if (result.status() == 1) result.bytesRead() else if (result.status() == 2) 0 else -200-result.status()
}
