import "../../src/esp32/rgb_rmt_prepare_esp32s3.ab"
import "../../src/led/rmt_strip_dma_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")

// Callable S3 example, NOT a boot image. Caller owns all stopped RMT channels,
// GDMA2, output pad, stable APB80MHz and calibrated ROM delay. No SDK calls.
// Two caller-powered LEDs: dim red and blue for250ms, then transmit black.
// Caller supplies disjoint internal SRAM: state52B, descriptors12B, frame200B.
// Setup failure: bit60 plus prepare status; otherwise full DMA status/flags.
// If either transmission fails, don't reuse DMA storage based on this return
// alone: inspect recovery flags. Never blindly send another frame on failure.
trusted fun rmtStripDmaExample(pin: u32, state: u32, descriptors: u32,
    waveform: u32, owner: u32): int {
    val stateStart = int(state)
    val desc = int(descriptors)
    val frame = int(waveform)
    if (stateStart < 0x3fc88000 || stateStart > 0x3fd00000 - 52 ||
        (stateStart & 3) != 0 || !esp32s3GdmaLinearTxLayoutValid(desc, frame, 200) ||
        (stateStart < desc + 12 && desc < stateStart + 52) ||
        (stateStart < frame + 200 && frame < stateStart + 52)) return (1 << 60) | 2
    val prepared = esp32s3RmtPrepareRgbDmaOwned(Pin(int(pin)), 2, owner)
    if (prepared != 1) return (1 << 60) | prepared
    val strip = rmtLedStripAt(nativeBufferAt(stateStart, 52), int(pin), 2)
    if (!strip.valid()) return 2
    strip.storeColor(0, rgbColor(255, 0, 0))
    strip.storeColor(1, rgbColor(0, 0, 255))
    val buffer = nativeBufferAt(frame, 200)
    val displayed = strip.displayDmaOwned(2, desc, buffer, 100000)
    if ((displayed & 255) != 1) return displayed
    peripheralDelayMicroseconds(250000)
    strip.storeColor(0, rgbColor(0, 0, 0))
    strip.storeColor(1, rgbColor(0, 0, 0))
    strip.displayDmaOwned(2, desc, buffer, 100000)
}
#exportFunction("rmtStripDmaExample", "abla_s3_strip_example")
