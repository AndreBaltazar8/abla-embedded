import "../../src/sd/selected_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Operation0 negotiation,1 read sector,2 write sector. Explicitly selected
// initialized bus; not a board startup or flashable application.
@export("abla_sd_selected_s3_example")
trusted fun transfer(link: SdSpiS3Link,operation: int,state: SdSpiInitResult,block: int,
    scratch: NativeBuffer,data: NativeBuffer,polls: int): int {
    if (operation == 0) return sdSpiInitializeSelected(link|0,scratch,data,polls)|0
    if (!state.valid()) return 2
    if (operation == 1) return sdSpiReadBlockSelected(link|0,state.highCapacity(),block,scratch,data,polls)|0
    if (operation == 2) return sdSpiWriteBlockSelected(link|0,state.highCapacity(),block,scratch,data,polls)|0
    return 2
}
