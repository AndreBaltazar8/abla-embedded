import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/m5stack/oled_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
// Borrowed device0x3C, prepared/pinned C61 software bus, exclusive scratch.
// Whole-frame publication only; initialization and physical reset are explicit.
@export("abla_m5_unit_oled_example")
trusted fun example(device: I2cDevice,mini: bool,operation: int,value: int,frame: NativeBuffer,scratch: NativeBuffer): int {
    val profile=if (mini) m5UnitMiniOledProfile else m5UnitOledProfile
    if (operation == 0) return if (device.oledInitialize(profile,scratch)) 1 else 0
    if (operation == 1) return device.oledDisplay(profile,frame,scratch)
    if (operation == 2) return if (device.oledSetBrightness(profile,value,scratch)) 1 else 0
    if (operation == 3) return if (device.oledSetSleep(value != 0,scratch)) 1 else 0
    if (operation == 4) return if (device.oledSetInvert(value != 0,scratch)) 1 else 0
    return 2
}
