import "../../src/display/epd_scanout_esp32s3.ab"
import "../../src/m5stack/paper_s3_epd.ab"
import "abla/build"
@export("abla_paper_s3_epd_scanout_example")
fun example(action: int,record: int,transport: int,exclusive: bool): int {
    val r=nativeBufferAt(record,32);val t=nativeBufferAt(transport,160)
    // PaperS3:960 pixels /4 +8 padding =248bytes,540scanlines per phase.
    if (action == 0) return epdScanoutAttachOwned(r,t,paperS3EpdGatePins(),248,540,exclusive)
    if (action == 1) return epdScanoutBeginFrameOwned(r,t,exclusive)
    if (action == 2) return epdScanoutSendLineOwned(r,t,exclusive)
    if (action == 3) return epdScanoutPollLineOwned(r,t,exclusive)
    if (action == 4) return epdScanoutEndFrameOwned(r,t,exclusive)
    if (action == 5) return epdScanoutCloseOwned(r,t,exclusive)
    return 3
}
