import "../../src/esp32/spi/clock_snapshot_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns controller/gate and both clock sources. Retain the16B snapshot
// unchanged from capture through completed restoration. Callable only.
@export("abla_esp32s3_spi_clock_snapshot_example")
trusted fun run(record: NativeBuffer,peripheral: int,restore: bool,polls: int): int =
    if (restore) esp32s3SpiClockRestoreOwned(record,polls,true) else if (esp32s3SpiClockSnapshotOwned(record,peripheral,true)) 1 else 2
