import "../../src/esp32/power/retention_routed_session_esp32p4.ab"
@export("abla_esp32p4_retention_routed_session_example")
trusted fun example(record: int,config: int,entry3: int,close: bool,exclusive: bool): int =
    if (close) esp32p4RetentionRoutedSessionCloseOwned(nativeBufferAt(record,88),exclusive) else esp32p4RetentionRoutedSessionOpenOwned(nativeBufferAt(record,88),nativeBufferAt(config,32),entry3,exclusive)
