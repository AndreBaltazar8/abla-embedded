import "../../src/esp32/i2s/clock_control_esp32p4.ab"
// Caller already owns all clock consumers/RCC/pads; source is stable.
// No fractional divider, pad routing, DMA or start implied.
@export("abla_esp32p4_i2s_clock_example")
trusted fun configure(port: i32, transmit: bool, source: i32, revision: i32,
    bclkDivider: i32, exclusive: bool): i32 {
    // Preflight the whole request before enabling the bus.
    if (port < i32(0) || port > i32(2) || source < i32(0) || source > i32(3) ||
        revision < i32(0) || (source == i32(3) && revision < i32(300)) ||
        bclkDivider < i32(1) || bclkDivider > i32(64) || !exclusive) return i32(2)
    val bus=esp32p4I2sEnableBusOwned(int(port),exclusive)
    if (bus != 1) return i32(bus+16)
    i32(esp32p4I2sConfigureClockOwned(int(port),transmit,int(source),int(revision),int(bclkDivider),exclusive))
}
