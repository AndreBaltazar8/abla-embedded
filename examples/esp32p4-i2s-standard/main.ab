import "../../src/esp32/i2s/standard_config_esp32p4.ab"
// Standard16 Philips, 256fsMCLK/32fsBCLK. Caller chooses stable source and
// coefficients for its desired rate; APB already enabled, no stream started.
@export("abla_esp32p4_i2s_standard_example")
trusted fun configure(port: i32, transmit: bool, source: i32, revision: i32,
    integer: i32, numerator: i32, denominator: i32, slots: i32, mono: bool,
    exclusive: bool): i32 {
    i32(esp32p4I2sConfigureStandardOwned(int(port),transmit,int(source),int(revision),
        int(integer),int(numerator),int(denominator),8,16,16,16,true,int(slots),
        if (mono) 1 else 0,exclusive))
}
