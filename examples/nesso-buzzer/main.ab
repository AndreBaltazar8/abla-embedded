import "../../src/m5stack/buzzer_esp32c6.ab"
import "abla/build"
// Callable only: caller qualifies exclusive ownership and timing before start.
// Tone continues until caller closes successfully; no implicit timed shutdown.
@export("abla_nesso_buzzer_example")
trusted fun example(record: NativeBuffer,source: int,sourceHz: int,hz: int,
    exclusive: bool,close: bool): int =
    if (close) c6PwmSessionCloseOwned(record,1000,exclusive)
    else m5BoardArduinoNessoN1.openC6BuzzerOwned(record,source,sourceHz,hz,0,0,1000,exclusive)
