import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_glass_tone.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun glassDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Callable only, no hardware action on build. Initialize fresh24B once (op0),
// start440Hz for100ms (op1), poll (op2), explicitly stop/retry cleanup (op3).
// Retain device, bus, state and scratch until status0. Single exclusive owner.
@export("abla_m5_unit_glass_tone_example")
trusted fun example(storage: NativeBuffer,scratch: NativeBuffer,device: I2cDevice,operation: int,now: int): int {
    if (!softwareI2cProviderBufferSafe(storage,24) || !softwareI2cProviderBufferSafe(scratch,5)) return 2
    val tone=unitGlassToneAt(storage)
    if (operation == 0) return if (tone.initialize()) 0 else 2
    if (operation == 1) return tone.startOwned(device,440,128,now,100,scratch,true)
    if (operation == 2) return tone.pollOwned(now,scratch,true)
    if (operation == 3) return if (tone.stopOwned(scratch,true)) 0 else 4
    return 2
}
