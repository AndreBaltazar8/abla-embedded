import "../../src/m5stack/tough_rtc_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_toughc5_rtc_open_example")
trusted fun open(owner: M5ToughPowerOwner,bus: I2cBus,exclusive: bool,wakeEventsConsumed: bool): int =
    owner.openRtcOwned(bus|0,exclusive,wakeEventsConsumed)|0
