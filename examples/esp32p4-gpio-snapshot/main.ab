import "../../src/esp32/gpio/snapshot_esp32p4.ab"
@export("abla_esp32p4_gpio_snapshot_example")
trusted fun snapshot(pin: i32,layout: i32,saved: P4GpioSnapshot,restore: bool,exclusive: bool): int {
    if (restore) return saved.restoreOwned(exclusive)
    return esp32p4GpioSnapshotOwned(int(pin),int(layout),exclusive)|0
}
