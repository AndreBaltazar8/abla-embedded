import "../../src/esp32/i2s/update_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_update_example")
trusted fun example(update: C6I2sUpdate,port: int,transmit: bool,polls: int,exclusive: bool,wait: bool): C6I2sUpdate =
    if (wait) update.waitOwned(polls,exclusive) else c6I2sUpdateBeginOwned(port,transmit,polls,exclusive)
