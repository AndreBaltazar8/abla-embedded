import "../../src/esp32/mspi_clock_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MspiClockExample")
@export("abla_esp32c5_mspi_clock_example")
trusted fun clocks(record: NativeBuffer,core: int,flash: int,psram: int,spi1: bool,close: bool,exclusiveCacheOff: bool): int =
    if (close) esp32C5MspiClocksCloseOwned(record,exclusiveCacheOff) else esp32C5MspiClocksOwned(record,core,flash,psram,spi1,exclusiveCacheOff)
