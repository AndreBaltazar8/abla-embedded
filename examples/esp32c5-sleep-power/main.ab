import "../../src/esp32/power/sleep_power_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32c5_sleep_power_example")
trusted fun configure(record: NativeBuffer,policy: C5SleepPower,close: bool,exclusive: bool): int =
    if (close) esp32C5SleepPowerCloseOwned(record,exclusive) else esp32C5SleepPowerApplyOwned(record,policy,exclusive)
