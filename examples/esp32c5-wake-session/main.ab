import "../../src/esp32/power/wake_session_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// operation0 open,1 recheck/arm,2 cleanup. Never enters sleep.
@export("abla_esp32c5_wake_session_example")
trusted fun session(record: NativeBuffer,pin: int,operation: int,exclusive: bool): int =
    if (!exclusive) 3 else if (operation == 0) esp32C5WakeSessionOpenOwned(record,pin,true)
    else if (operation == 1) esp32C5WakeSessionArmOwned(record)
    else if (operation == 2) esp32C5WakeSessionCloseOwned(record) else 3
