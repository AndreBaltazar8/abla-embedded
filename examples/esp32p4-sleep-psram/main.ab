import "../../src/esp32/power/sleep_psram_esp32p4.ab"
// Callable in an already quiesced, internal-memory execution environment.
@export("abla_esp32p4_sleep_psram_example")
trusted fun example(token: int,close: bool,revision: int,regdmaBackup: bool,polls: int,ready: bool): int =
    if (close) P4SleepPsram(token).closeOwned(ready,true)|0 else esp32p4SleepPsramParkOwned(revision,regdmaBackup,polls,ready)|0
