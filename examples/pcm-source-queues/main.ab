import "../../src/audio/pcm_source_queues.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pcm_source_queues_example")
trusted fun render(bank: PcmSourceQueues,frames: int,accumulator: NativeBuffer,scratch: NativeBuffer,
    output: NativeBuffer,stereo: bool,gain: int): bool = bank.renderOutput(frames,accumulator,scratch,output,stereo,gain)
