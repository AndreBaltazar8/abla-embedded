import "../../src/esp32/touch/session_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable classic ESP32 object, NOT a boot image. Own idle touch hardware,
// selected HP/RTC/analog pads, clocks/power and shared register serialization;
// prevent sleep/global holds.456-byte exclusive record, initially magic0.
// M5 detection voltage/slope profile1.7V/0.5V/speed7/float; caller converts
// physical durations to ticks for actual RTC clocks (no assumed frequencies).
// op0open(mask),1start,2poll,3close,4raw(channel),5smooth(channel).
// Status2 retains ALL leases; keep polling before close. Status4 requires
// cleanup/retry, never discard the saved register records on failure.
@export("abla_esp32_touch_session_example")
trusted fun session(operation: int,record: NativeBuffer,argument: int,waitTicks: int,chargeTicks: int,intervalTicks: int,exclusiveIdle: bool): int {
    if (operation == 0) return esp32TouchSessionOpenOwned(record,argument,waitTicks,chargeTicks,intervalTicks,7,0,7,2,exclusiveIdle)
    if (operation == 1) return esp32TouchSessionStartOwned(record)
    if (operation == 2) return esp32TouchSessionPollOwned(record)
    if (operation == 3) return esp32TouchSessionCloseOwned(record)
    if (operation == 4 || operation == 5) return esp32TouchSessionRead(record,argument,operation == 5)
    return -1
}
