import "../../src/m5stack/corematrix_control_esp32c61.ab"
import "../../src/m5stack/corematrix_charge_owner.ab"
import "abla/runtime/scalar"
import "abla/build"
// Requires an opened owner and exclusive charge-selector pin ownership.
// Callable only: not a boot image or proof of physical charging current.
@export("abla_corematrix_charge_owner_example")
trusted fun example(owner: M5CoreMatrixControl,milliamps: int,exclusive: bool): int =
    owner.setChargeCurrentOwned(milliamps,exclusive)|0
