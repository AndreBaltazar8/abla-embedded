import "../../src/esp32/spi_software_esp32c61.ab"
import "abla/build"
// Caller owns the configured pads and canonical gate; D/C initially input.
@export("abla_esp32c61_spi_shared_checked_example")
trusted fun example(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,cs: Pin,dc: Pin,
    command: int,data: NativeBuffer,length: int): SpiTransactionResult =
    softwareSpiSharedCommandChecked(gate,owner,clock,mosi,cs,dc,command,data,length,0,2)
