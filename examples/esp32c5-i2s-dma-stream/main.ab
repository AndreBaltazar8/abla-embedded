import "abla/runtime/scalar"
import "abla/build"
import "../../src/esp32/i2s/dma_stream_esp32c5.ab"
// Caller supplies a running circular start record and zeroed28B cursor.
// Poll result1 exposes index@12 and valid bytes@16. Consume RX/refill TX
// before operation1. Use the separate ordered-stop API to end the stream.
@export("abla_esp32c5_i2s_dma_stream_example")
trusted fun example(start: NativeBuffer,cursor: NativeBuffer,operation: int,exclusive: bool): int {
    if (operation == 0) return c5I2sDmaStreamPollOwned(start,cursor,exclusive)
    if (operation == 1) return c5I2sDmaStreamRearmOwned(start,cursor,exclusive)
    return 2
}
