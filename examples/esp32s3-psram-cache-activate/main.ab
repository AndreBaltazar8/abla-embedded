import "../../src/esp32/psram/cache_activate_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_psram_cache_activate_example")
@section(".iram1.abla.s3PsramCacheActivateExample")
fun example(r: NativeBuffer,close: bool,proof: bool): int =
    if (close) s3PsramCacheDeactivateOwned(r,proof) else s3PsramCacheActivateOwned(r,proof)
