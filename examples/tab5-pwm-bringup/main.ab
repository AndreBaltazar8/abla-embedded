import "../../src/m5stack/tab5_pwm_esp32p4.ab"
import "../../src/m5stack/tab5_backlight_esp32p4.ab"
import "../../src/esp32/revision_esp32p4.ab"
import "../../src/esp32/serial_esp32p4.ab"
import "../../src/esp32/peripheral_delay_esp32p4.ab"
import "../../src/esp32/boot/internal_entry_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// OFFLINE probe: actual-layout internal SRAM boot/UART0 already initialized,
// core1 stopped, XTAL40 and ROM delay calibration stable, GPIO22 and whole LEDC
// available, GPIO/IOMUX power pinned, no PMU forced holds or sleep transitions.
// Does NOT power/initialize the display or PSRAM: measure GPIO22 with a scope;
// visible backlight additionally requires correctly powered Tab5 hardware.
// Eight ~44.1kHz brightness steps, 20ms each, then checked shutdown. No WDT
// modification/feeding. Failed cleanup retains leases and MAY leave PWM active;
// hardware validation must have an independent safe power/reset path available.
var pwm=Tab5PwmBacklight(0)
var pins=Esp32P4IomuxClockOwner(0)
trusted fun pwmPrint(value: int): void {
    val port=serial(0)
    var digit=0; var word=value&4294967295
    while (digit < 8) {
        val nibble=(word>>>28)&15
        if (!port.tryWriteByte(if (nibble < 10) 48+nibble else 87+nibble,100000)) return
        word=(word<<4)&4294967295; digit=digit+1
    }
    port.tryWriteByte(32,100000); return
}
@export("abla_p4_application_main")
@noinline
trusted fun tab5PwmMain(): void {
    val layout=esp32P4ChipRegisterLayout()
    pins=esp32P4IomuxClockOpenOwned(layout)
    if (!pins.ready()) { pwmPrint(pins|0); return }
    val dark=tab5BacklightConfigureOffOwned(layout)
    if (dark != 1) { pwmPrint(dark); return }
    pwm=tab5PwmBacklightOpenOwned(layout,100000)
    val opened=pwm.bits()
    var steps=0
    if (pwm.ready()) {
        var duty=32
        while (duty <= 256) {
            pwm=pwm.setDutyOwned(duty,100000)
            if (pwm.status() != 1) break
            steps=steps+1
            peripheralRomDelay(20000)
            duty=duty+32
        }
    }
    val updated=pwm.bits()
    pwm=pwm.closeOwned(100000)
    // Keep IOMUX pinned: UART0/pad consumers may share it. Never blindly close
    // it or reconfigure a potentially still-live PWM output after a timeout.
    pwmPrint(opened); pwmPrint(steps); pwmPrint(updated); pwmPrint(pwm.bits())
    val port=serial(0); port.tryWriteByte(10,100000); port.tryFlush(100000); return
}
