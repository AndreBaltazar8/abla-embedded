import "../../src/esp32/power/sleep_measured_identified_memory_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MeasuredIdentifiedMemoryExample")
@export("abla_esp32c5_sleep_measured_identified_memory_example")
trusted fun sleep(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,slowCycles: int,fastCycles: int,action: int,exclusive: bool): int {
    if (action == 0) return esp32C5SleepMeasuredIdentifiedMemoryBeginOwned(record,request,context,slowCycles,fastCycles,exclusive)
    if (action == 1) return esp32C5SleepMeasuredContinueOwned(record,exclusive)
    if (action == 2) return esp32C5SleepMeasuredIdentifiedMemoryRecheckOwned(record,exclusive)
    return 2
}
