import "../../src/esp32/ahb_gdma_start_esp32p4.ab"
@export("abla_esp32p4_ahb_gdma_start_example")
trusted fun start(channel: i32,transmit: bool,port: i32,descriptors: u32,count: i32,
    buffers: u32,stride: i32,bytes: i32,exclusive: bool): i32 {
    i32(esp32p4AhbGdmaStartRingOwned(int(channel),transmit,int(port),int(descriptors),
        int(count),int(buffers),int(stride),int(bytes),exclusive))
}
