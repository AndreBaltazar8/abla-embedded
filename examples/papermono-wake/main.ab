import "../../src/m5stack/papermono_wake_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_papermono_wake_example")
trusted fun wake(control: M5Pm1Control,session: Ssd1677Session,gate: PeripheralGate,owner: u32,polls: int,exclusive: bool): int =
    control.wakePaperMonoPanelOwned(session,gate,owner,polls,exclusive)|0
