import "../../src/esp32/spi_software_esp32c6.ab"
import "../../src/display/software_rgb565_checked.ab"
import "../../src/m5stack/display_map.ab"
import "abla/build"
// Native callable; requires initialized RGB565 panel and checked pin setup.
// View/color-order must match the panel's successful initialization.
@export("abla_nesso_display_fill_example")
trusted fun example(gate: PeripheralGate,owner: u32,view: LcdView,x: int,y: int,width: int,height: int,color: Rgb565): SpiTransactionResult {
    val p=m5BoardArduinoNessoN1.displaySpiPins()
    return softwareLcdFillRectChecked(gate,owner,Pin(p.clock()),Pin(p.mosi()),Pin(p.chipSelect()),Pin(p.dataCommand()),view,x,y,width,height,color,1,false)
}
