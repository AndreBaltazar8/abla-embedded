import "../../src/esp32/i2s/pin_session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller supplies zeroed48B record and owns stopped I2S/DMA/pads/input routes.
// op0 route,1 restore/retry. Does not start clocks, codecs or audio transfers.
@export("abla_esp32s3_i2s_pin_session_example")
trusted fun session(op: int,r: NativeBuffer,port: int,tx: bool,mclk: Pin,bclk: Pin,ws: Pin,data: Pin,flags: int,exclusive: bool): int {
    if (op == 0) return esp32S3I2sPinsOpenOwned(r,port,tx,mclk,bclk,ws,data,flags,exclusive)
    if (op == 1) return esp32S3I2sPinsCloseOwned(r,exclusive)
    return 0
}
