import "../../src/esp32/ledc_esp32c5.ab"
import "abla/build"
// Caller owns timer/all selecting channels and stable source/APB clocks.
// Configuration stays paused; operation1 resumes only after async update ends.
@export("abla_esp32c5_ledc_timer_example")
trusted fun example(timer: int,sourceHz: int,hz: int,resolution: int,operation: int): int {
    if (operation == 1) return c5LedcTimerResumeOwned(timer)
    if (operation == 2) return c5LedcTimerPauseOwned(timer)
    if (operation != 0) return 2
    return c5LedcTimerConfigurePausedOwned(timer,resolution,c5LedcDividerForHz(sourceHz,hz,resolution))
}
