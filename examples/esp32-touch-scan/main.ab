import "../../src/esp32/touch/scan_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable classic ESP32 scan harness, NOT a boot image. Controller timing,
// voltages, pads and work mask must already be configured. Caller owns the
// entire idle controller, pins clocks, stops repeated timer and disables IRQ.
// operation0: begin(argument=channel mask), returns scan token.
// operation1: poll(token), returns updated token; retain it while pending.
// operation2: read(token,argument=channel), returns raw16 sample or -1.
// Raw samples are not smoothed data. No allocation, waiting or implicit stop.
@export("abla_esp32_touch_scan_example")
trusted fun step(operation: int,scan: Esp32TouchScan,argument: int,exclusiveIdle: bool): int {
    if (operation == 0) return esp32TouchScanBeginOwned(argument,exclusiveIdle) | 0
    if (operation == 1) return scan.pollOwned() | 0
    if (operation == 2) return scan.readRawOwned(argument)
    return -1
}
