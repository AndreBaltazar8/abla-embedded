import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_lcd.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun unitLcdDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Full-frame RGB332/RGB565/RGB888/ARGB8888 wire bytes; caller supplies scratch
// >=135*(pixelBytes+(rle?1:0))+1, and an exclusive ready device.
@export("abla_m5_unit_lcd_pixels_example")
trusted fun example(device: I2cDevice,source: NativeBuffer,scratch: NativeBuffer,pixelBytes: int,rle: bool): int =
    device.unitLcdWritePixels(0,0,135,240,0,source,135*pixelBytes,pixelBytes,scratch,16,rle)
