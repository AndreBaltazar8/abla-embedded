import "../../src/esp32/i2s/rx_dma_config_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_rx_dma_config_example")
trusted fun example(r: NativeBuffer,operation: int,channel: int,bytes: int,polls: int,exclusive: bool): int {
    if (operation == 0) return c6I2sRxDmaConfigOpenOwned(r,channel,bytes,16,32,32,true,polls,exclusive)
    if (operation == 1) return c6I2sRxDmaConfigWaitOwned(r,polls,exclusive)
    if (operation == 2) return c6I2sRxDmaConfigCloseOwned(r,polls,exclusive)
    return 2
}
