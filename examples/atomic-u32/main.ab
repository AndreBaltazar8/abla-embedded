import "../../src/atomic.ab"

// Build-only, board-neutral atomic example. The caller supplies an aligned
// word it owns. Inspecting the ESP32 build shows S32C1I and MEMW, while other
// LLVM targets select their corresponding native instructions.

@export("abla_atomic_compare_exchange")
trusted fun atomicCompareExchange(
    address: int,
    expected: u32,
    replacement: u32
): u32 = atomicU32At(address).compareExchange(expected, replacement)

@export("abla_atomic_compare_exchange_relaxed")
trusted fun atomicCompareExchangeRelaxed(
    address: int,
    expected: u32,
    replacement: u32
): u32 = atomicU32At(address).compareExchangeRelaxed(expected, replacement)

@export("abla_atomic_fence")
trusted fun atomicFence(): void = atomicMemoryFence()
