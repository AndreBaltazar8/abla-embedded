import "../../src/sd/mmc_card_esp32s3.ab"
import "../../src/sd/registers.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sd_card_capacity_example")
trusted fun example(record: NativeBuffer,nativeCard: bool): int =
    if (nativeCard) sdMmcCardBlockCount(record) else sdCsdBlockCount(record)
