import "../../src/esp32/i2s/dma_session_esp32p4.ab"
// Command0 attach prepared/published ring,1 start,2 pump,3 stop. Hardware
// configuration and board codec/rail/pin lifecycle belong to the caller.
@export("abla_esp32p4_i2s_dma_session_example")
trusted fun session(r: NativeBuffer,command: i32,channel: i32,transmit: bool,port: i32,
    descriptors: u32,count: i32,buffers: u32,stride: i32,bytes: i32,polls: i32,
    cpu: NativeBuffer,exclusive: bool): i32 {
    if (command == i32(0)) return i32(esp32p4I2sDmaSessionAttachOwned(r,int(channel),transmit,int(port),int(descriptors),int(count),int(buffers),int(stride),int(bytes),int(polls),exclusive))
    if (command == i32(1)) return i32(esp32p4I2sDmaSessionStartOwned(r,exclusive))
    if (command == i32(2)) return i32(esp32p4I2sDmaSessionPumpOwned(r,cpu,exclusive))
    if (command == i32(3)) return i32(esp32p4I2sDmaSessionStopOwned(r,exclusive))
    return i32(0)
}
