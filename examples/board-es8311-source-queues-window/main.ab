#requiredInternalFunction("freestandingMemorySet32", "memset")
// Already running owned TX and initialized ring; close after source/silence tail.
@export("abla_board_es8311_source_queues_window_example")
trusted fun play(r: NativeBuffer,queues: PcmSourceQueues,blocks: int,acc: NativeBuffer,scratch: NativeBuffer,
    staging: NativeBuffer,maxIdle: int,gain: int,exclusive: bool): int =
    m5Es8311PlaybackSourceQueuesWindowOwned(r,queues,blocks,acc,scratch,staging,maxIdle,gain,exclusive)|0
