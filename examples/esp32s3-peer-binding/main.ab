import "../../src/esp32/peer_runtime_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_peer_binding_example")
fun example(close: bool,record: int,table: int,mailbox: int,channel: int,line: int,exclusiveStopped: bool): int {
    val r=nativeBufferAt(record,64)
    if (close) return esp32S3PeerBindingCloseOwned(r,exclusiveStopped)
    return esp32S3PeerBindingOpenRuntimeOwned(r,nativeBufferAt(table,512),nativeBufferAt(mailbox,4),channel,line,exclusiveStopped)
}
