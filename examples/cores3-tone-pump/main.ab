import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/cores3_channels_pump.ab"
import "abla/runtime/scalar"
import "abla/build"
// Already configured/started speaker ring; retain pump state and staging.
@export("abla_cores3_tone_pump_example")
trusted fun pump(state: CoreS3ChannelsPump,bank: PcmChannels,tone: PcmTone,channel: int,
    descriptors: int,buffers: int,accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,gain: int): CoreS3ChannelsPump =
    cores3PumpChannels(state,bank,channel,descriptors,buffers,accumulator,scratch,staging,gain,tone)
