import "../../src/esp32/power/sleep_light_esp32p4.ab"
@export("abla_esp32p4_sleep_light_example")
trusted fun example(address: int,resume: bool,revision: int,regdmaBackup: bool,mhz: int,xtalMHz: int,polls: int,eventPolls: int,exclusivePrepared: bool): int {
    val record=nativeBufferAt(address,64)
    return if (resume) esp32p4SleepLightContinueOwned(record,polls,exclusivePrepared) else esp32p4SleepLightStartPreparedOwned(record,revision,regdmaBackup,mhz,xtalMHz,polls,eventPolls,exclusivePrepared)
}
