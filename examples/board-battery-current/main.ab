import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/battery_current_owned.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable shared-policy demonstration, not a multi-board boot image.
// Caller supplies correctly bound/configured sensors for the selected board.
@export("abla_board_battery_current_example")
trusted fun example(board: M5BoardId,axp: M5AxpPower,ina: Ina3221,tab: Ina226,gauge: Bq27220,hub: PowerHubPower,exclusive: bool): PowerMeasurement {
    if (board == m5BoardArduinoNessoN1) return gauge.readBatteryMilliampsOwned(board,exclusive)
    if (board == m5BoardPowerHub) return hub.readBatteryMilliampsOwned(board,exclusive)
    if (board == m5BoardTab5 || board == m5BoardTab5X) return tab.readBatteryMilliampsOwned(board,exclusive)
    return axp.readBatteryMilliampsOwned(board,ina,exclusive)
}
