import "../../src/sd/mmc_negotiate_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Pass initialized card80 from startup, disjoint aligned descriptor16/payload8
// in DMA-capable RAM and fresh144B state. Own pads for requested width.
@export("abla_sdmmc_negotiate_example")
trusted fun negotiate(context: NativeBuffer,card: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer,
    width: int,now: u32,begin: bool,exclusive: bool): int =
    if (begin) sdMmcNegotiationBeginOwned(context,card,descriptor,payload,width,now,2000,exclusive)
    else if (exclusive) sdMmcNegotiationPollOwned(context,now) else 3
