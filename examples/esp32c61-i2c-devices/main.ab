import "../../src/esp32/i2c/software_devices_esp32c61.ab"
import "abla/runtime/scalar"
import "abla/build"
// A generation-checked device from this owner's persistent pool. Caller
// serializes all bus/device lifetime and keeps both buffers/pool alive.
@export("abla_esp32c61_i2c_devices_example")
fun example(bus: Esp32C61SoftwareI2cBus,pool: I2cDeviceSlots,handle: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int): SoftwareI2cTransfer =
    bus.transferDeviceOwned(pool,handle,output,written,input,read)
