import "../../src/m5stack/corematrix_control_esp32c61.ab"
import "../../src/m5stack/corematrix_buttons.ab"
import "abla/runtime/scalar"
import "abla/build"
// Control and PM1 inputs must be configured. Caller serializes the poll.
// Return scalar frame contains both pressed and valid masks for A/B/C.
@export("abla_corematrix_buttons_example")
trusted fun example(control: M5CoreMatrixControl): M5ButtonFrame = control.pollButtonLevelsOwned(true)
