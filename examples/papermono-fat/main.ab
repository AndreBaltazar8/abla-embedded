import "../../src/storage/fat_papermono_esp32s3.ab"
import "../../src/storage/fat_file_read.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_papermono_fat_example")
trusted fun read(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,file: FatDirectoryEntry,offset: int,
    destination: NativeBuffer,workspace: NativeBuffer): int = fatFileReadAtOwned(reader,boot,first,sectors,file,offset,512,1024,destination,workspace)|0
