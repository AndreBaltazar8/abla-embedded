import "../../src/m5stack/tough_display_sleep_esp32c5.ab"
import "abla/build"
// Live initialized72B session; caller retains rail/clocks/pads and stops users.
@export("abla_toughc5_display_sleep_example")
trusted fun example(session: NativeBuffer,sleep: bool,brightness: int,exclusiveQuiesced: bool): SpiBufferResult =
    toughDisplaySessionSleepOwned(session,sleep,brightness,exclusiveQuiesced)
