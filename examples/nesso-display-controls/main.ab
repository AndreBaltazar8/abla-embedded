import "../../src/m5stack/nesso_display_esp32c6.ab"
import "abla/build"
// Borrow an initialized retained display; never initialize/close it here.
// action0 rotation+color-order,1 logical inversion,2 idle/color-reduction.
@export("abla_nesso_display_controls_example")
trusted fun example(display: NessoDisplay,action: int,value: int,flag: bool,exclusive: bool): bool {
    if (action == 0) return display.setRotationOwned(value,flag,exclusive)
    if (action == 1) return display.setInvertedOwned(flag,exclusive)
    if (action == 2) return display.setIdleOwned(flag,exclusive)
    return false
}
