import "../../src/esp32/mspi_dummy_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MspiDummyExample")
@export("abla_esp32c5_mspi_dummy_example")
trusted fun dummy(record: NativeBuffer,target: int,lengthField: int,enabled: bool,variableDummy: bool,close: bool,exclusiveCacheOff: bool): int =
    if (close) esp32C5MspiDummyCloseOwned(record,exclusiveCacheOff) else esp32C5MspiDummyOwned(record,target,lengthField,enabled,variableDummy,exclusiveCacheOff)
