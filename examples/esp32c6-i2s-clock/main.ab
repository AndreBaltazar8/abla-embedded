import "../../src/esp32/i2s/clock_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_clock_example")
trusted fun example(owner: C6I2sClock,port: int,directions: int,txSource: int,rxSource: int,exclusive: bool,close: bool): C6I2sClock =
    if (close) owner.closeOwned(exclusive) else c6I2sClockOpenOwned(port,directions,txSource,rxSource,exclusive)
