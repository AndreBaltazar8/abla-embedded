import "../../src/esp32/power/sleep_peer_irq_esp32p4.ab"
@export("abla_esp32p4_sleep_peer_irq_example")
trusted fun example(record: int,smp: int,generation: int,peer: int,revision: int,prepare: bool,exclusive: bool): int =
    if (prepare) esp32p4SleepPeerIrqPrepareOwned(nativeBufferAt(record,848),nativeBufferAt(smp,4),generation,peer,revision,exclusive)
    else esp32p4SleepPeerIrqAddress()
