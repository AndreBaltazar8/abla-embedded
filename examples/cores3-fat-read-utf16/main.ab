import "../cores3-fat-read/read.ab"
// Callable read-only CoreS3 card init -> mount -> UTF16 path -> file chunk.
// NOT a boot image. Same settled board power, ROM delay and exclusive SPI
// gate/pad preconditions as cores3-fat-read. Supply2607-byte workspace,
// destination512 and immutable UTF16LE path1..4096 units, all disjoint.
// FatFs Unicode uppercase matching plus ASCII8.3 aliases, <=32 components.
// No normalization. Positive bytes/0EOF, error families as shared reader.
// Repeat at offset+bytes; short reads stop at sector boundaries, not EOF.
// No card writes or physical filesystem validation claim.
trusted fun cores3FatReadUtf16Example(gateAddress: u32,workspaceAddress: u32,pathAddress: u32,pathUnits: int,destinationAddress: u32,partition: int,offset: int,budget: int): int =
    cores3FatReadExampleMode(gateAddress,workspaceAddress,pathAddress,pathUnits,destinationAddress,partition,offset,budget,true)
#exportFunction("cores3FatReadUtf16Example", "abla_cores3_fat_read_utf16_example")
