import "../../src/esp32/power/sleep_scheduler_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_sleep_scheduler_example")
fun example(action: int,record: int,lock: int,mailbox: int,channel: int,proof: bool): int {
    val r=nativeBufferAt(record,64)
    if (action == 0) return esp32S3SleepSchedulerOpenOwned(r,nativeBufferAt(lock,4),nativeBufferAt(mailbox,4),channel,proof)
    if (action == 1) return esp32S3SleepSchedulerPollOwned(r)
    if (action == 2) return esp32S3SleepSchedulerCloseOwned(r,proof)
    return 3
}
