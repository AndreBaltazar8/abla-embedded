import "../../src/esp32/ledc_pin_owner_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_ledc_pin_owner_example")
trusted fun example(record: NativeBuffer,pin: int,channel: int,inverted: bool,exclusive: bool,close: bool): int =
    if (close) c6LedcPinCloseOwned(record,exclusive) else c6LedcPinOpenOwned(record,pin,channel,inverted,exclusive)
