import "../../src/esp32/ahb_gdma_channel_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_ahb_gdma_channel_example")
trusted fun example(owner: C5AhbGdmaChannel,channel: int,tx: bool,peripheral: int,burst: int,flags: int,exclusive: bool,close: bool): C5AhbGdmaChannel =
    if (close) owner.closeOwned(exclusive) else c5AhbGdmaChannelOpenOwned(channel,tx,peripheral,burst,flags,exclusive)
