import "../../src/display/ssd1677_init_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Awake/powered/reset panel, SPI2 and BUSY18 inputpullup already prepared.
@export("abla_papermono_panel_example")
trusted fun initialize(gate: PeripheralGate,owner: u32,polls: int,exclusiveAwake: bool): int =
    esp32s3Ssd1677Initialize(gate,owner,2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),polls,exclusiveAwake)|0
