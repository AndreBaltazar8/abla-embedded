import "../../src/esp32/i2s/capture_stream_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_capture_stream_example")
trusted fun example(session: NativeBuffer,cursor: NativeBuffer,polls: int,release: bool,consumersJoined: bool,exclusive: bool): int =
    if (release) c6CaptureStreamReleaseOwned(session,cursor,consumersJoined,exclusive) else c6CaptureStreamPollOwned(session,cursor,polls,exclusive)
