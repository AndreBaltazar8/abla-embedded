import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/pmic_status.ab"
import "abla/runtime/scalar"
import "abla/build"
// Read-only against an already-opened PMIC; caller serializes its lifetime.
// Decode status before value: failure/unsupported never means known absent.
@export("abla_pmic_status_example")
trusted fun example(pmic: M5PmicOpen,presence: bool,exclusive: bool): int =
    (if (presence) pmic.readBatteryPresenceOwned(exclusive) else pmic.readChargingOwned(exclusive))|0
