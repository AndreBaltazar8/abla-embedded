import "../../src/esp32/i2s/audio_setup_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_audio_setup_example")
trusted fun example(r: NativeBuffer,profile: NativeBuffer,polls: int,exclusive: bool,operation: int): int {
    if (operation == 1) return c5AudioSetupWaitOwned(r,polls,exclusive)
    if (operation == 2) return c5AudioSetupCloseOwned(r,polls,exclusive)
    // Caller-owned readable72B profile:18 u32 fields in API argument order,
    // channel through bytes. Boolean fields0/1; absent MCLK=0xffffffff.
    if (operation != 0 || !profile.hasAddressRange(0,72)) return 2
    return c5AudioSetupOpenOwned(r,profile.loadU32(0),profile.loadU32(4) != 0,profile.loadU32(8),profile.loadU32(12),profile.loadU32(16),profile.loadU32(20),profile.loadU32(24),profile.loadU32(28),profile.loadU32(32),profile.loadU32(36),if (profile.loadU32(40) == 0xffffffff) -1 else profile.loadU32(40),profile.loadU32(44),profile.loadU32(48),profile.loadU32(52),profile.loadU32(56) != 0,profile.loadU32(60),profile.loadU32(64),profile.loadU32(68),polls,exclusive)
}
