import "../../src/m5stack/pm1_capture_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Borrowed control/codec; keep alive until close4, including failure retries.
// Operations0prepare1start2close3read. Caller owns disjoint output storage.
@export("abla_pm1_board_capture_example")
trusted fun capture(op: int,r: NativeBuffer,control: M5Pm1Control,hz: int,channel: int,desc: int,count: int,
    payload: int,bytes: int,owner: u32,codec: Es8311,output: NativeBuffer,polls: int,exclusive: bool): int {
    if (op == 0) return control.beginAudioCaptureOwned(r,hz,channel,desc,count,payload,bytes,owner,codec,exclusive)
    if (op == 1) return m5Es8311CaptureStartOwned(r,polls,exclusive)
    if (op == 2) return m5Es8311CaptureCloseOwned(r,polls,exclusive)
    if (op == 3) return m5Es8311CaptureReadOwned(r,output,polls,exclusive)|0
    return 0
}
