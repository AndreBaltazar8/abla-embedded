import "../../src/m5stack/nesso_imu_temperature_esp32c6.ab"
import "abla/build"
// Sensor die temperature, not calibrated ambient temperature. Check valid()
// before using milliCelsius(); invalid is not a zero-degree reading.
@export("abla_nesso_imu_temperature_example")
trusted fun example(power: NessoPower,bus: int,imu: M5ImuProbeResult,exclusive: bool): ImuTemperature =
    power.readImuTemperatureOwned(bus,imu,exclusive)
