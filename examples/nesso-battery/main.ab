import "../../src/esp32/i2c_software_esp32c6.ab"
import "../../src/m5stack/c6_gauge.ab"
import "abla/runtime/scalar"
import "abla/build"
// Native C6 callable, NOT a boot image. Borrow a gauge bound through an open
// C6 I2C session with calibrated, pinned clocks and owned pads. No reset/unseal.
@export("abla_nesso_battery_example")
trusted fun example(gauge: Bq27220,operation: int,exclusive: bool): int {
    if (operation == 0) return m5BoardArduinoNessoN1.readBatteryMillivoltsOwned(gauge,exclusive)|0
    if (operation == 1) return m5BoardArduinoNessoN1.readBatteryLevelOwned(gauge,exclusive)|0
    if (operation == 2 && exclusive) return gauge.currentMilliampsChecked()|0
    return 0
}
