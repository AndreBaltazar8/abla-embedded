import "../../src/display/text_console_gray4.ab"
import "abla/build"
@export("abla_paper_s3_text_console_example")
fun example(cursor: TextCursor,canvas: NativeBuffer,text: NativeBuffer,length: int,foreground: int,background: int,scale: int): TextCursor =
