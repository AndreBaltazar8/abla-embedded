import "../../src/m5stack/tab5_microphone_dma_esp32p4.ab"
import "../../src/esp32/i2c_software_esp32p4.ab"
import "../../src/m5stack/tab5_microphone_esp32p4.ab"
// Caller owns codec and all stopped/prepared hardware; command0 prepares DMA,
// command1 configures codec, command2 resets codec. No automatic stream start.
@export("abla_tab5_microphone_dma_example")
trusted fun prepare(command: i32,codec: Es7210,channel: i32,desc: u32,count: i32,payload: u32,
    stride: i32,bytes: i32,revision: i32,polls: i32,exclusive: bool): i32 {
    if (command == i32(0)) return i32(tab5PrepareMicrophoneDmaOwned(int(channel),int(desc),int(count),int(payload),int(stride),int(bytes),int(revision),int(polls),exclusive))
    if (command == i32(1) || command == i32(2)) return i32(tab5MicrophoneOwned(codec,command == i32(1),exclusive))
    return i32(2)
}
