import "../../src/esp32/i2s/pin_session_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_pin_session_example")
trusted fun example(r: NativeBuffer,tx: bool,slave: bool,bclk: int,ws: int,data: int,mclk: int,mclkInput: bool,exclusive: bool,close: bool): int =
    if (close) c6I2sPinSessionCloseOwned(r,exclusive) else c6I2sPinSessionOpenOwned(r,tx,slave,bclk,ws,data,mclk,mclkInput,exclusive)
