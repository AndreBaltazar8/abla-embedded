import "../../src/esp32/spi/master_session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Zeroed40B record. Caller owns canonical bus gate, stopped SPI/DMA and pads.
// op0 initializes native CPU-master, op1 closes/retries after transactions.
// Does not touch SPI0/1 flash/PSRAM, reset busy hardware or gate shared clocks.
@export("abla_esp32s3_spi_master_session_example")
trusted fun session(op: int,r: NativeBuffer,peripheral: int,pins: SpiPins,select: Pin,
    source: int,pre: int,cycles: int,mode: int,owner: u32,polls: int,exclusive: bool): int {
    if (op == 0) return esp32S3SpiMasterSessionBeginOwned(r,peripheral,pins,select,source,pre,cycles,mode,owner,polls,exclusive)
    if (op == 1) return esp32S3SpiMasterSessionCloseOwned(r,polls,exclusive)
    return 0
}
