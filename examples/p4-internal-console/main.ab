import "../../src/esp32/serial_esp32p4.ab"
import "../../src/esp32/boot/internal_entry_esp32p4.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
// RAM-only application-entry bring-up probe, NOT a complete Tab5 firmware.
// Bootloader must load all ELF load segments and enter on core0 in M-mode,
// with internal SRAM usable and UART0 console already configured (P4 defaults
// GPIO37TX/38RX). Does not configure PSRAM/PLL/pads, stop core1 or disable WDT.
// Prints once using bounded polling; then parks. Hardware boot not yet verified.
// Build with tools/build-p4-internal-console 1|3 for the actual chip layout;
// the two revisions reserve different SRAM ranges for ROM/bootloader/cache.
// Named only for the assembly-to-Abla startup boundary, like the S3 boot entry.
@export("abla_p4_application_main")
@noinline
trusted fun p4ConsoleMain(): void {
    val port=serial(0)
    if (!port.tryWriteByte(80,100000)) return
    if (!port.tryWriteByte(52,100000)) return
    if (!port.tryWriteByte(32,100000)) return
    if (!port.tryWriteByte(65,100000)) return
    if (!port.tryWriteByte(66,100000)) return
    if (!port.tryWriteByte(76,100000)) return
    if (!port.tryWriteByte(65,100000)) return
    if (!port.tryWriteByte(10,100000)) return
    port.tryFlush(100000)
    return
}
