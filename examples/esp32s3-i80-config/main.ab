import "../../src/display/i80_config_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_i80_config_example")
fun example(action: int,width: int,groupDivider: int,pixelDivider: int,commandCycles: int,dummyCycles: int,dataCycles: int,command: int,exclusive: bool): int {
    // PaperS3 uses width8, PLL160M/group2/pixel5 =16MHz, idle-low/positive-edge.
    if (action == 0) return esp32S3LcdI80ConfigureOwned(width,groupDivider,pixelDivider,false,false,exclusive)
    return esp32S3LcdI80PhasesOwned(commandCycles,dummyCycles,dataCycles,command,true,exclusive)
}
