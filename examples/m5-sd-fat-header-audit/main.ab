// Caller holds the volume gate. A valid header may still report dirty/error.
@export("abla_m5_sd_fat_header_audit_example")
trusted fun example(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,scratch: NativeBuffer): int =
    fatAuditHeaderOwned(reader,boot,first,sectors,scratch)|0
