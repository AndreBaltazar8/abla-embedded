import "../../src/m5stack/control_bus_hardware_esp32p4.ab"
import "../../src/io_expander/m5ioe1_device.ab"
import "abla/runtime/scalar"
// Callable, NOT boot firmware. All exclusive/safed-pad prerequisites apply.
@export("abla_m5_p4_hardware_control_example")
trusted fun example(record: int,action: int,board: int,port: int,layout: int,cpuHz: u32): int {
    val r=nativeBufferAt(record,96)
    if (action == 0) return m5P4HardwareControlOpenOwned(r,M5BoardId(board),port,layout,u32(40000000),cpuHz,true)
    if (action == 1) return m5P4HardwareControlDeviceBus(r)|0
    if (action == 2) return m5P4HardwareControlCloseOwned(r,true)
    return 2
}
