import "../../src/imu/calibration.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_calibration_owned_example")
trusted fun example(state: ImuCalibration,sensor: int,axes: ImuAxes,offsets: ImuOffsets,seed: bool): int =
    if (seed) (if (state.initializeSensor(sensor,axes,offsets)) 1 else 0) else state.update(sensor,axes,offsets)
