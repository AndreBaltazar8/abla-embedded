import "../../src/esp32/power/sleep_gpio_cycle_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5SleepGpioExample")
@export("abla_esp32c5_sleep_gpio_cycle_example")
trusted fun sleep(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,pin: int,high: bool,begin: bool,exclusive: bool): int =
    if (begin) esp32C5SleepGpioBeginOwned(record,request,context,pin,high,exclusive) else esp32C5SleepCycleContinueOwned(record,exclusive)
