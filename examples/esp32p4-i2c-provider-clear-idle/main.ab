import "../../src/esp32/i2c/hardware_clear_idle_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Bind an opened session, then explicitly authorize idle-bus slave clocks.
// A pending restore must retain the same recovery record; close is blocked
// until restoration completes. Caller independently excludes other masters.
@export("abla_esp32p4_i2c_provider_clear_idle_example")
fun example(action: int,bus: I2cBus,session: int,record: int,cpuHz: u32): int {
    if (action == 0) return i2cHardwareBindOwned(nativeBufferAt(session,72),u32(40000000),cpuHz)|0
    if (action == 1) return bus.clearIdleStatus(nativeBufferAt(record,40))
    if (action == 2) return if (bus.close()) 1 else 0
    // Opt-in owned abort is accepted only for an existing failed transaction.
    if (action == 3) return bus.abortAndClearStatus(nativeBufferAt(record,40))
    return 0
}
