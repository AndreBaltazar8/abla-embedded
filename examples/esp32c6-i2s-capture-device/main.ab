import "../../src/esp32/i2s/capture_device_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_capture_device_example")
trusted fun example(r: NativeBuffer,operation: int,channel: int,descriptors: int,count: int,buffers: int,bytes: int,dmaErrors: int,i2sErrors: int,discard: bool,exclusive: bool): int {
    if (operation == 0) return c6CaptureDeviceOpenOwned(r,channel,1,240000000,48000,0,1,2,3,-1,16,16,16,true,descriptors,count,buffers,bytes,bytes,1,discard,exclusive)
    if (operation == 1) return c6CaptureDevicePollOwned(r,2,1,exclusive)
    if (operation == 2) return c6CaptureDeviceCloseOwned(r,1,exclusive)
    if (operation == 3) return c6CaptureDeviceCancelOwned(r,2,1,dmaErrors,discard,exclusive,i2sErrors)
    if (operation == 4) return c6CaptureDeviceRetryStopOwned(r,1,exclusive)
    if (operation == 5) return c6CaptureDeviceBufferOwned(r,0,exclusive)|0
    return 2
}
