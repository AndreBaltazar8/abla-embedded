import "../../src/esp32/i2s/standard_session_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_standard_session_example")
trusted fun example(r: NativeBuffer,tx: bool,data: int,slot: int,ws: int,shift: bool,slots: int,flags: int,polls: int,exclusive: bool,operation: int): int =
    if (operation == 0) c5I2sStandardOpenOwned(r,0,tx,data,slot,ws,shift,slots,flags,polls,exclusive)
    else if (operation == 1) c5I2sStandardWaitOwned(r,polls,exclusive)
    else if (operation == 2) c5I2sStandardCloseOwned(r,polls,exclusive) else 2
