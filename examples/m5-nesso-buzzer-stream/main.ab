import "../../src/m5stack/buzzer_stream_esp32c6.ab"
import "abla/build"
// Callable only. Caller pins roots and retains all buffers, services frequently,
// and explicitly handles cancellation errors/discard. No automatic boot/flash.
@export("abla_m5_nesso_buzzer_stream_example")
trusted fun example(r: NativeBuffer,operation: int,sources: int,descriptors: int,buffers: int,acc: NativeBuffer,scratch: NativeBuffer,mono: NativeBuffer,staging: NativeBuffer,volume: int,handledErrors: int,discard: bool,exclusive: bool): int {
    if (operation == 0) return m5BoardArduinoNessoN1.openC6BuzzerStreamOwned(r,PcmSourceQueues(sources),0,1,240000000,48000,0,descriptors,2,buffers,64,64,1,discard,exclusive)
    if (operation == 1) return c6BuzzerStreamAdvanceOwned(r,acc,scratch,mono,staging,PcmVolume(volume),2,1,exclusive)
    if (operation == 2) return c6BuzzerStreamEndOwned(r,acc,scratch,mono,staging,PcmVolume(volume),exclusive)
    if (operation == 3) return c6BuzzerStreamCloseOwned(r,1,exclusive)
    if (operation == 4) return c6BuzzerStreamCancelOwned(r,2,1,handledErrors,discard,exclusive)
    if (operation == 5) return c6BuzzerStreamRetryStopOwned(r,1,exclusive)
    return 2
}
