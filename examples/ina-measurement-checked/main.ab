import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/power/ina226_device.ab"
import "../../src/power/ina3221_device.ab"
import "abla/runtime/scalar"
import "abla/build"
// Borrow caller-owned devices; no calibration, bus setup or ownership change.
@export("abla_ina_measurement_checked_example")
trusted fun example(single: Ina226,triple: Ina3221,field: int): PowerMeasurement {
    if (field == 0) return single.busMillivoltsChecked()
    if (field == 1) return single.shuntMicrovoltsChecked()
    if (field == 2) return single.powerMilliwattsChecked()
    if (field >= 3 && field < 6) return triple.busMillivoltsChecked(field-3)
    if (field >= 6 && field < 9) return triple.shuntMicrovoltsChecked(field-6)
    return PowerMeasurement(0)
}
