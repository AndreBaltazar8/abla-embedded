import "../../src/esp32/spi_idf6.ab"
import "../../src/esp32/serial.ab"
import "abla/unsafe/memory"

val log = serial()

fun hexadecimalDigit(value: int): int =
    if (value < 10) 48 + value else 55 + value

trusted fun printHexByte(value: int): void {
    log.writeByte(hexadecimalDigit((value >>> 4) & 15))
    log.writeByte(hexadecimalDigit(value & 15))
    return
}

@export("app_main")
trusted fun appMain(): void {
    val bus = spiMaster(2, spiPins(23, 19, 18))
    if (!bus.valid()) {
        log.line("SPI bus initialization failed")
        return
    }
    // Connect an external SPI flash: MOSI23, MISO19, SCLK18, CS5.
    val flash = bus.device(5, 10000000, 0, true)
    if (!flash.valid()) {
        log.line("SPI device initialization failed")
        bus.close()
        return
    }

    val command = nativeBufferAt(nativeStackAllocate(1), 1)
    val identity = nativeBufferAt(nativeStackAllocate(3), 3)
    command.store(0, 159)
    if (flash.writeRead(command, 1, identity, 3)) {
        log.write("JEDEC ID: ")
        printHexByte(identity.load(0))
        printHexByte(identity.load(1))
        printHexByte(identity.load(2))
        log.writeByte(10)
    } else log.line("SPI transaction failed")

    flash.close()
    bus.close()
    return
}
