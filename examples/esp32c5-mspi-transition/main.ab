import "../../src/esp32/mspi_transition_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MspiTransitionExample")
@export("abla_esp32c5_mspi_transition_example")
trusted fun transition(record: NativeBuffer,request: NativeBuffer,action: int,cpuMHz: int,exclusiveCacheOff: bool): int {
    if (action == 0) return esp32C5MspiTransitionBeginOwned(record,request,exclusiveCacheOff)
    if (action == 1) return esp32C5MspiTransitionContinueOwned(record,exclusiveCacheOff)
    if (action == 2) return esp32C5MspiTransitionCloseAtCpuOwned(record,cpuMHz,exclusiveCacheOff)
    return 2
}
