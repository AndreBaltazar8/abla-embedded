import "../../src/esp32/power/wake_trigger_esp32p4.ab"
// Callable only. Actions0capture/park,1configure,2park,3restore.
@export("abla_esp32p4_wake_trigger_example")
trusted fun example(action: int,token: int,mask: u32,exclusive: bool): int {
    if (action == 0) return esp32p4WakeTriggerParkOwned(exclusive)|0
    if (action == 1) return P4WakeTrigger(token).configureOwned(mask,exclusive)|0
    if (action == 2) return P4WakeTrigger(token).parkOwned(exclusive)|0
    if (action == 3) return P4WakeTrigger(token).closeOwned(exclusive)|0
    return token
}
