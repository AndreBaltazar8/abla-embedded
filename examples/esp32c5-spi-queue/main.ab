import "../../src/esp32/spi/queue_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable example, not standalone firmware. Fresh/released queue storage:
// 160+48*capacity bytes, capacity1..64; requests1..65535bytes. Keep master and canonical
// gate alive. op0 initialize,1submit,2service,3take16B completion,4cancel tail.
// Completion16B words token/status/detail/completedBytes; only status1 makes RX consumable.
// After failure retain hardware context and recover explicitly before reinit.
@export("abla_esp32c5_spi_queue_example")
trusted fun example(queue: NativeBuffer,capacity: int,master: Esp32C5SpiMaster,gate: PeripheralGate,
    owner: u32,token: u32,tx: NativeBuffer,rx: NativeBuffer,bytes: int,now: u32,budget: u32,
    completion: NativeBuffer,operation: int): int {
    if (operation == 0) return if (esp32C5SpiQueueInitialize(queue,capacity,master,gate,owner,true)) 1 else 3
    if (operation == 1) return esp32C5SpiQueueSubmit(queue,token,tx,rx,bytes,budget)
    if (operation == 2) return esp32C5SpiQueueService(queue,now)
    if (operation == 3) return esp32C5SpiQueueTake(queue,completion,true)
    if (operation == 4) return esp32C5SpiQueueCancelTail(queue,token)
    return 3
}
