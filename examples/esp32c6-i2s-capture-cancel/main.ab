import "../../src/esp32/i2s/capture_cancel_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_capture_cancel_example")
trusted fun example(session: NativeBuffer,cancel: NativeBuffer,retryStop: bool,budget: int,polls: int,dmaErrors: int,i2sErrors: int,discard: bool,exclusive: bool): int =
    if (retryStop) c6CaptureCancelRetryStopOwned(session,cancel,polls,exclusive)
    else c6CaptureCancelOwned(session,cancel,budget,polls,dmaErrors,discard,exclusive,i2sErrors)
