import "../../src/storage/fat_spi_esp32c61.ab"
import "../../src/storage/fat_file_read.ab"
import "abla/build"
@export("abla_esp32c61_fat_read_example")
trusted fun example(reader: NativeBuffer,boot: NativeBuffer,sectors: int,file: FatDirectoryEntry,
    offset: int,destination: NativeBuffer,workspace: NativeBuffer): FatFileRead =
    fatFileReadAtOwned(reader,boot,0,sectors,file,offset,512,1000,destination,workspace)
