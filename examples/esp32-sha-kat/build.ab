import "abla/compiler"

val target = #compilerDefineTarget(
    "esp32-xtensa",
    "xtensa-esp-unknown-elf",
    "elf",
    "none",
    "none",
    false,
    false
)

val built = #compilerBuildProgram(
    "abla-embedded-esp32-sha-kat",
    "examples/esp32-sha-kat/main.ab",
    "build/examples/esp32-sha-kat/abla_app.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

fun main: int = if (target && built) 0 else 1
