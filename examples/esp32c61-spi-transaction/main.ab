import "../../src/esp32/spi/transaction_esp32c61.ab"
import "abla/build"
@export("abla_esp32c61_spi_transaction_example")
trusted fun example(master: Esp32C61SpiMaster,gate: PeripheralGate,owner: u32,
    tx: NativeBuffer,rx: NativeBuffer,bytes: int,recover: bool): SpiTransactionResult =
    if (recover) SpiTransactionResult((if (master.recover(gate,owner,true,false)) 1 else 6)<<32)
    else master.transfer(gate,owner,tx,rx,bytes,1000)
