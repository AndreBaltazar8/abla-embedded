import "../../src/esp32/i2s/bootstrap_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_bootstrap_example")
trusted fun example(channel: int,tx: bool,exclusive: bool,discard: bool,previous: int,recover: bool): int =
    if (recover) C5I2sBootstrap(previous).releaseOwned(exclusive)|0
    else c5I2sBootstrapOwned(channel,tx,exclusive,discard)|0
