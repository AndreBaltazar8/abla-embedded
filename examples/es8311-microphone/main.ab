import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/audio/es8311_device.ab"
import "abla/runtime/scalar"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Initialized native I2C handle and stable timing; matching external clocks,
// board rail and pads already owned/configured. Capture must be stopped.
@export("abla_es8311_microphone_example")
trusted fun microphone(codec: Es8311,enabled: bool,exclusive: bool): int =
    codec.microphoneBclkOwned(enabled,exclusive)
