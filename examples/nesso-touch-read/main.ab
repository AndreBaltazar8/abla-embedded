import "../../src/m5stack/nesso_touch_esp32c6.ab"
import "abla/build"
// Borrow29B snapshot and ready display/touch owners. Returns0..5 contacts,
// -1 invalid/read failure, -2 unstable. Decode only successful reports using
// nessoTouchPoint with the rotation captured during this exclusive interval.
@export("abla_nesso_touch_read_example")
trusted fun example(display: NessoDisplay,bus: int,touch: TouchControllerOpen,snapshot: NativeBuffer,exclusive: bool): int =
    display.readTouchOwned(bus,touch,snapshot,exclusive)
