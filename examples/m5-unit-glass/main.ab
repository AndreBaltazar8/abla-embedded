import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_glass.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun glassDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Borrowed device at configured UnitGLASS address, calibrated/pinned bus.
// Firmware/key reads do not change buzzer state. No hardware action on build.
@export("abla_m5_unit_glass_example")
trusted fun example(device: I2cDevice,operation: int,frame: NativeBuffer,scratch: NativeBuffer,value: int): int {
    if (operation == 0) return device.glassReadByte(-1,scratch)|0
    if (operation == 1) return device.glassDisplayRegion(frame,scratch,0,0,128,64)
    if (operation == 2) return device.glassReadByte(value,scratch)|0
    if (operation == 3) return if (device.glassSetSleep(value != 0,scratch)) 1 else 0
    if (operation == 4) return if (device.glassSetInvert(value != 0,scratch)) 1 else 0
    if (operation == 5) return if (device.glassBuzzerEnable(false,scratch)) 1 else 0
    return 2
}
