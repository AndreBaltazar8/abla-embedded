import "../../src/esp32/power/cpll_esp32p4.ab"
@export("abla_esp32p4_cpll_example")
trusted fun example(record: int,mhz: int,revision: int,polls: int,resume: bool,exclusiveXtal40: bool): int =
    if (resume) esp32p4CpllContinueOwned(nativeBufferAt(record,32),polls,exclusiveXtal40) else esp32p4CpllBeginOwned(nativeBufferAt(record,32),mhz,revision,polls,exclusiveXtal40)
