import "../../src/m5stack/tough_display_owner_esp32c5.ab"
import "abla/build"
@export("abla_toughc5_display_owner_example")
trusted fun example(parent: M5ToughPowerOwner,session: NativeBuffer,master: Esp32C5SpiMaster,
    bus: int,gate: PeripheralGate,owner: u32,rotation: int,brightness: int,
    exclusiveQuiesced: bool,touchClosedEventsConsumed: bool): int =
    parent.beginDisplayOwned(session,master,bus,gate,owner,rotation,brightness,exclusiveQuiesced,touchClosedEventsConsumed)
