import "../../src/m5stack/stopwatch_canvas_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller drew into a complete synchronized shadow. Clear dirty bounds only
// after result.valid(); a failed transfer requires explicit bus recovery first.
@export("abla_stopwatch_canvas_example")
trusted fun flush(gate: PeripheralGate,owner: u32,rotation: int,canvas: NativeBuffer,
    stride: int,x: int,y: int,width: int,height: int,exclusive: bool): int =
    stopWatchCanvasFlushOwned(gate,owner,rotation,canvas,stride,x,y,width,height,exclusive)|0
