import "../../src/esp32/power/ext1_esp32p4.ab"
@export("abla_esp32p4_ext1_wake_example")
trusted fun example(action: int,selection: u32,highLevels: u32,filter: bool,token: int): int {
    if (action == 0) return esp32p4Ext1OpenOwned(selection,highLevels,filter,true)|0
    if (action == 1) return P4Ext1Wake(token).closeOwned(true)|0
    if (action == 2) return int(esp32p4Ext1WakeStatus())
    if (action == 3) return if (esp32p4Ext1AcknowledgeOwned(true)) 1 else 0
    return 0
}
