import "../../src/esp32/i2s/standard_session_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_rx_session_example")
trusted fun example(r: NativeBuffer,operation: int,data: int,slot: int,ws: int,philips: bool,slave: bool,stopMode: int,polls: int,exclusive: bool): int {
    if (operation == 0) return c6I2sStandardOpenOwned(r,data,slot,ws,philips,polls,exclusive,false,slave,stopMode)
    if (operation == 1) return c6I2sStandardWaitOwned(r,polls,exclusive)
    if (operation == 2) return c6I2sStandardCloseOwned(r,polls,exclusive)
    return 2
}
