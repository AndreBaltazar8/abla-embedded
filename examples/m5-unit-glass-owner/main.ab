import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_glass_owner_software.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun glassDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Fresh open or retryable close; caller retains returned scalar even on error.
// Initial open explicitly silences the buzzer, normalizes inversion and wakes.
@export("abla_m5_unit_glass_owner_example")
trusted fun example(bus: I2cBus,owner: UnitGlassOwner,close: bool,scratch: NativeBuffer): UnitGlassOwner =
    if (close) owner.closeOwned(scratch,true) else unitGlassOpenOwned(bus,scratch,true)
