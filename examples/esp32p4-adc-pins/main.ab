import "../../src/esp32/adc_pins_esp32p4.ab"
// Analog pad ownership only, not an ADC sample. Caller retains scalar lease.
@export("abla_esp32p4_adc_pins_example")
trusted fun pad(unit: i32,channel: i32,layout: i32,saved: P4AdcPad,close: bool,exclusive: bool): int =
    if (close) saved.closeOwned(exclusive)|0 else esp32p4AdcPadOpenOwned(int(unit),int(channel),int(layout),exclusive)|0
