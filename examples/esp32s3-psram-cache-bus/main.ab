import "../../src/esp32/psram/cache_bus_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_psram_cache_bus_example")
@section(".iram1.abla.s3PsramCacheBusExample")
fun example(r: NativeBuffer,close: bool,exclusiveSuspended: bool): int =
    if (close) s3PsramCacheBusCloseOwned(r,exclusiveSuspended) else s3PsramCacheBusOpenOwned(r,exclusiveSuspended)
