import "../../src/display/i80_transfer_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_i80_transfer_example")
fun example(action: int,channel: int,descriptor: int,polls: int,exclusive: bool): int {
    if (action == 0) return esp32S3LcdI80StartOwned(channel,descriptor,polls,exclusive)
    if (action == 1) return esp32S3LcdI80PollOwned(channel,descriptor,exclusive)
    if (action == 2) return esp32S3LcdI80AbortOwned(channel,polls,exclusive)
    return 2
}
