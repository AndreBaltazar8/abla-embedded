import "../../src/esp32/gpio_esp32c6.ab"
import "abla/build"
// Callable only. Own clocks/pads and release global hold first. No takeover
// of held, LP-routed or active USB pads; board flash reservations are caller-owned.
@export("abla_esp32c6_gpio_example")
fun example(pin: int,output: bool,high: bool,openDrain: bool,input: bool,pull: int,exclusive: bool): int =
    esp32C6GpioConfigureOwned(pin,output,high,openDrain,input,pull,exclusive)
