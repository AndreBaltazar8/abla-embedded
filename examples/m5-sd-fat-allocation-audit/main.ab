import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3_write.ab"
import "../../src/storage/fat_allocation_audit.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller holds the volume gate; bitmap comes from completed tree traversal.
// Success covers this range only. No writes or repair operations.
@export("abla_m5_sd_fat_allocation_audit_example")
trusted fun example(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,start: int,count: int,budget: int,scratch: NativeBuffer,bitmap: NativeBuffer): int =
    fatAuditAllocationRangeOwned(reader,boot,first,sectors,start,count,budget,scratch,fatClusterOwnershipAt(bitmap))|0
