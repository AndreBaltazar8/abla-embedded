import "../../src/esp32/gpio_esp32s3.ab"
import "../../src/m5stack/led_strip_buffer.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// State construction only; no GPIO/I2C/RMT activity. Caller subsequently uses
// storePackedColors and its chosen prepared transport's explicit display API.
@export("abla_board_led_buffer_example")
trusted fun create(board: M5BoardId,storage: NativeBuffer): RmtLedStrip = board.ledStripAt(storage)
