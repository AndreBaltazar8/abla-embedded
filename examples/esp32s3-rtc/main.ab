import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/rtc_device.ab"
import "abla/runtime/scalar"
import "abla/build"

// Callable, read-only RTC snapshot; not a bootable image.
// Caller initializes the native S3 I2C bus and opens an M5Rtc for the board
// (or an external PCF8563/RX8130/PowerHub RTC). Caller retains bus/device
// ownership and closes them after use. Do not pass a handle from another backend.
// Supply writable, exclusively borrowed RAM: 7 bytes for mode0, 4 for mode1,
// 3 for mode2. No retained buffer, hidden scratch allocation or register writes.
// Return is the packed RtcDateTime/RtcDate/RtcTime respectively; zero means
// invalid input, transport failure or malformed fields, not a valid timestamp.
// Raw field validity does not imply a calendar-valid date or a trusted clock;
// callers should also check calendarValid() and lowVoltageChecked().
@export("abla_esp32s3_rtc_example")
trusted fun rtcSnapshot(rtc: M5Rtc,bytes: NativeBuffer,mode: int): int {
    if (mode == 0) return rtc.dateTimeWithBuffer(bytes) | 0
    if (mode == 1) return rtc.dateWithBuffer(bytes) | 0
    if (mode == 2) return rtc.timeWithBuffer(bytes) | 0
    0
}
