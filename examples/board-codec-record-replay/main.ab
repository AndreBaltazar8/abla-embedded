import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/codec_record_replay_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// See workflow's explicit ownership and work buffer layout. Zeroed136B record.
// Example fixes16000Hz and250 consecutive1ms idle waits/block; internal API
// permits caller-selected rates/timeouts without expanding the export ABI.
@export("abla_board_codec_record_replay_example")
trusted fun replay(board: M5BoardId,r: NativeBuffer,channel: int,desc: int,count: int,
    payload: int,bytes: int,owner: u32,mic: u32,speaker: Es8311,pm1: M5Pm1,io: M5Ioe1,
    recorded: NativeBuffer,work: NativeBuffer,blocks: int,exclusive: bool): int =
    m5CodecRecordReplayOwned(board,r,16000,channel,desc,count,payload,bytes,owner,mic,speaker,pm1,io,recorded,work,blocks,250,exclusive)
