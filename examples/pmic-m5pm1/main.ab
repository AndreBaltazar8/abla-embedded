import "../../src/esp32/abla_host_esp_idf.ab"
import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/esp32/serial_esp32s3.ab"
import "../../src/power/m5pm1_device.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // M5StickS3 internal I2C: SDA 47, SCL 48. begin() performs M5Unified's
    // idle-sleep/watchdog setup; this sample does not alter rails or charging.
    val bus = i2cMaster(0, 47, 48, u32(40000000), u32(160000000))
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }
    val power = m5Pm1(bus)
    if (power.begin()) {
        power.powerSource()
        power.vbatNodePowered()
        power.batteryChargeEnabled()
        power.gpioInputBits()
        power.batteryVoltageMillivolts()
        power.vbusVoltageMillivolts()
        power.output5VVoltageMillivolts()
        log.line("M5PM1 detected and sampled")
    } else log.line("M5PM1 not detected")
    power.close()
    bus.close()
    return
}
