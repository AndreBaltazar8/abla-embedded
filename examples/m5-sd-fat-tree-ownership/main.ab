import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3_write.ab"
import "../../src/storage/fat_tree_ownership.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns one immutable volume-wide lifetime and a freshly initialized
// bitmap. Tree success must still be followed by the allocation sweep.
@export("abla_m5_sd_fat_tree_ownership_example")
trusted fun example(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,budget: int,queue: NativeBuffer,data: NativeBuffer,scratch: NativeBuffer,bitmap: NativeBuffer): int =
    fatWalkOwnershipTreeOwned(reader,boot,first,sectors,budget,queue,data,scratch,fatClusterOwnershipAt(bitmap))|0
