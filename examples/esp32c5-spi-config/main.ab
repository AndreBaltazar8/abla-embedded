import "../../src/esp32/spi/config_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_spi_config_example")
trusted fun example(sourceHz: int,rootDivider: int,pre: int,cycles: int,mode: int): int {
    val clock=esp32C5SpiConfigureClockOwned(sourceHz,rootDivider,pre,cycles,if (cycles == 1) 1 else cycles>>>1)
    if (clock != 1) return clock
    val configured=esp32C5SpiConfigureModeOwned(mode,false,false)
    if (configured != 1) return 256|configured
    return esp32C5SpiLatchOwned(1000)
}

