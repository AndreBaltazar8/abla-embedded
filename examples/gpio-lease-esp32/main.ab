import "../../src/esp32/gpio/lease_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns stopped pad/peripheral users and all register serialization.
// Return4 retains the record for restoration; never discard it on failure.
@export("abla_gpio_lease_esp32_example")
trusted fun example(record: NativeBuffer,pin: int,output: bool,high: bool,close: bool): int =
    if (close) esp32GpioLeaseCloseOwned(record,true) else esp32GpioLeaseOpenOwned(record,pin,output,high,0,true)
