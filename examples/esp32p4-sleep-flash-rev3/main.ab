import "../../src/esp32/power/sleep_flash_rev3_esp32p4.ab"
@export("abla_esp32p4_sleep_flash_rev3_example")
trusted fun example(record: int,resume: bool,minimumRevision: int,exclusive: bool): int =
    if (resume) esp32p4SleepFlashRev3ContinueOwned(nativeBufferAt(record,32),exclusive) else esp32p4SleepFlashRev3BeginOwned(nativeBufferAt(record,32),minimumRevision,exclusive)
