import "../../src/esp32/power/ext1_session_esp32p4.ab"
// Callable source configuration; caller still owns actual PMU sleep setup.
@export("abla_esp32p4_ext1_session_example")
trusted fun example(address: int,capacity: int,selection: u32,highLevels: u32,pull: int,
    filter: bool,layout: int,close: bool,exclusive: bool): int {
    val r=nativeBufferAt(address,capacity)
    if (close) return esp32p4Ext1SessionCloseOwned(r,exclusive)
    return esp32p4Ext1SessionOpenOwned(r,selection,highLevels,pull,filter,layout,exclusive)
}
