import "../../src/esp32/power/wake_timer_esp32p4.ab"
// Callable primitive, NOT sleep firmware. Quiescence is a caller prerequisite.
@export("abla_esp32p4_wake_timer_example")
trusted fun example(action: int,token: int,timer: int,ticks: int,exclusiveQuiesced: bool): int {
    if (action == 0) return esp32p4WakeTimerStageOwned(timer,ticks,exclusiveQuiesced)|0
    if (action == 1) return P4WakeTimer(token).armOwned(exclusiveQuiesced)|0
    if (action == 2) return P4WakeTimer(token).restoreOwned(exclusiveQuiesced)|0
    if (action == 3) return if (esp32p4WakeTimerAlarmPending(timer)) 1 else 0
    if (action == 4) return if (esp32p4WakeTimerAcknowledgeOwned(timer,exclusiveQuiesced)) 1 else 0
    if (action == 5) return esp32p4WakeTimerCyclesOwned(timer,exclusiveQuiesced)
    // For action6, token supplies calibrated microseconds-per-tick Q19.
    if (action == 6) return esp32p4WakeTimerDeadlineOwned(timer,ticks,token,exclusiveQuiesced)
    return token
}
