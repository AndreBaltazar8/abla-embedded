import "../../src/led/rmt_strip_pixels.ab"
import "abla/runtime/scalar"
import "abla/build"
// Transport-free update of a previously constructed strip; no hardware calls.
@export("abla_led_packed_buffer_example")
trusted fun update(strip: RmtLedStrip,source: NativeBuffer,index: int,count: int,format: int): bool =
    strip.storePackedColors(source,index,count,format)
