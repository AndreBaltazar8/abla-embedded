import "../../src/esp32/gpio/rtc_input_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Own the pad, disarmed wake/analog users, active LP-IO clock and no global hold.
@export("abla_esp32s3_rtc_digital_input_example")
trusted fun input(pin: int,pull: int,exclusiveWakeDisarmed: bool): int =
    esp32S3RtcToDigitalInputOwned(pin,pull,exclusiveWakeDisarmed)
