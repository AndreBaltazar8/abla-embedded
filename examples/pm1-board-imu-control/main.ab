import "../../src/m5stack/pm1_imu_owner_esp32s3.ab"
import "../../src/m5stack/imu_owner_control.ab"
import "../../src/esp32/imu_delay_1khz_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller has stopped all acquisition and owns a ready initialized IMU.
// Sleep does not close the child or parent. Unsupported sensors return3.
@export("abla_pm1_board_imu_control_example")
trusted fun example(imu: M5ImuOwner,sleep: bool,activeHigh: bool,exclusive: bool): int =
    (if (sleep) imu.sleepOwned(exclusive) else imu.setInterruptActiveHighOwned(activeHigh,exclusive))|0
