import "../../src/esp32/i2s/clock_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_clock_example")
trusted fun example(owner: C5I2sClock,port: int,directions: int,txSource: int,rxSource: int,polls: int,exclusive: bool,close: bool): C5I2sClock =
    if (close) owner.closeOwned(exclusive) else c5I2sClockOpenOwned(port,directions,txSource,rxSource,polls,exclusive)
