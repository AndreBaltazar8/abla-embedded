import "../../src/display/epd_waveform.ab"
import "abla/build"
@export("abla_epd_waveform_example")
fun example(action: int,state: NativeBuffer,gray: NativeBuffer,output: NativeBuffer,pixels: int,mode: int,padding: int,exclusive: bool): int {
    if (action == 0) return if (epdWaveformInitialize(state,pixels,exclusive)) 1 else -1
    if (action == 1) {
        if (pixels < 2 || (pixels&1) != 0) return -1
        return if (epdWaveformUpdateOwned(state,gray,pixels/2,mode,exclusive)) 1 else -1
    }
    if (action == 2) return epdWaveformRenderOwned(state,output,pixels,padding,exclusive)
    return -1
}
