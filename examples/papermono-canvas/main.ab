import "../../src/m5stack/papermono_canvas.ab"
import "abla/runtime/scalar"
import "abla/build"
// Offscreen drawing only; no display activation, heap or hidden buffers.
@export("abla_papermono_canvas_example")
trusted fun draw(canvas: NativeBuffer,x: int,y: int,w: int,h: int,rotation: int,
    source: NativeBuffer,stride: int,fill: int,exclusive: bool): bool =
    paperMonoCanvasDrawOwned(canvas,x,y,w,h,rotation,source,stride,fill,exclusive)
