import "../../src/m5stack/chaincaptain_display_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Existing live control, stopped panel, GPIO45 CS HIGH, exclusive IOE/PWM.
@export("abla_chaincaptain_display_power_example")
trusted fun prepare(control: M5Pm1Control,reset: bool,brightness: int,exclusive: bool): int =
    control.prepareChainDisplayOwned(reset,brightness,exclusive)
