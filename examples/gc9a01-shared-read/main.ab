import "../../src/esp32/spi_software_esp32c61.ab"
import "../../src/display/gc9a01_read.ab"
import "abla/runtime/scalar"
import "abla/build"
// Panel must support bidirectional SDA. Caller owns configured GPIO pads,
// initialized rotation and canonical gate. Checked cleanup restores SDA to
// GPIO output-low, not an arbitrary previous peripheral route/pull policy.
@export("abla_gc9a01_shared_read_example")
trusted fun run(gate: PeripheralGate,owner: u32,clock: Pin,data: Pin,cs: Pin,dc: Pin,
    rotation: int,destination: NativeBuffer,stride: int): SpiTransactionResult =
    gc9a01ReadRectChecked(gate,owner,clock,data,data,cs,dc,rotation,0,0,240,240,destination,stride,false,1,true)
