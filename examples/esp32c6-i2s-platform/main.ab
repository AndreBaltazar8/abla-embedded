import "../../src/esp32/i2s/platform_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_platform_example")
trusted fun example(r: NativeBuffer,channel: int,source: int,discard: bool,exclusive: bool,close: bool): int =
    if (close) c6AudioPlatformCloseOwned(r,exclusive) else c6AudioPlatformOpenOwned(r,channel,source,discard,exclusive)
