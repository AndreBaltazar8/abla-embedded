import "../../src/esp32/power/sleep_digital_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32c5_sleep_digital_example")
trusted fun configure(record: NativeBuffer,clocks: u32,deep: bool,topDown: bool,close: bool,exclusive: bool): int =
    if (close) esp32C5SleepDigitalCloseOwned(record,exclusive) else esp32C5SleepDigitalApplyOwned(record,clocks,deep,topDown,exclusive)
