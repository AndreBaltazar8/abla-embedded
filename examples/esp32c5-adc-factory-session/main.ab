import "../../src/esp32/adc_factory_session_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_adc_factory_session_example")
trusted fun example(record: NativeBuffer,channel: int,attenuation: int,source: int,hz: int,polls: int,exclusive: bool,coldSafe: bool,shadowsReady: bool,operation: int): int =
    if (operation == 0) c5AdcSessionOpenFactoryOwned(record,channel,attenuation,source,hz,exclusive,coldSafe,shadowsReady)
    else if (operation == 1) c5AdcSessionStartAfterSettlingOwned(record,exclusive)
    else if (operation == 2) c5AdcSessionPollOwned(record,polls,exclusive)
    else if (operation == 3) c5AdcSessionCloseOwned(record,polls,exclusive)
    else if (operation == 4) c5AdcSessionRaw(record)
    else if (operation == 5) c5AdcSessionMillivolts(record) else 2
