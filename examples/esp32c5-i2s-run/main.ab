import "../../src/esp32/i2s/run_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_run_example")
trusted fun example(update: C5I2sUpdate,port: int,tx: bool,polls: int,exclusive: bool,stop: bool): int =
    if (stop) c5I2sStopOwned(port,tx,polls,exclusive) else c5I2sStartUpdatedOwned(update,exclusive)
