import "../../src/esp32/spi/async_recover_esp32s3.ab"
import "abla/runtime/scalar"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Callable recovery only, not boot firmware. Retain the failed64B context and
// all request storage. report16 must be separate. Caller owns original bus,
// stopped peers/DMA, all pads/other inactive CS and stable clocks. A wedged
// controller remains faulted. No reset, payload replay or queue restart.
@export("abla_esp32s3_spi_async_recover_example")
trusted fun recover(contextAddress: int,reportAddress: int,peripheral: int,pins: int,
    source: int,pre: int,cycles: int,mode: int,polls: int,exclusive: bool): int =
    esp32s3SpiAsyncRecoverOwned(nativeBufferAt(contextAddress,64),nativeBufferAt(reportAddress,16),
        peripheral,SpiPins(pins),source,pre,cycles,mode,polls,exclusive)
