import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/io_expander/m5ioe1.ab"
import "../../src/io_expander/pi4ioe5v6408.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // M5Stack Atom family Grove Port A: SDA26, SCL32.
    val bus = i2cMaster(1, 26, 32)
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }

    val ioe1 = m5Ioe1(bus)
    if (ioe1.begin()) {
        log.line("M5IOE1 detected")
        ioe1.setDirection(0, false)
        ioe1.setPullMode(0, pullUp)
    }
    ioe1.close()

    val pi4 = pi4Ioe5v6408(bus)
    if (pi4.begin()) {
        log.line("PI4IOE5V6408 detected")
        pi4.setDirection(0, false)
        pi4.setPullMode(0, pullUp)
    }
    pi4.close()
    bus.close()
    return
}
