import "../../src/esp32/ahb_gdma_pump_esp32p4.ab"
@export("abla_esp32p4_ahb_gdma_pump_example")
trusted fun pump(channel: i32,transmit: bool,descriptors: u32,count: i32,buffers: u32,
    stride: i32,bytes: i32,index: i32,cpu: NativeBuffer,polls: i32,exclusive: bool): int {
    esp32p4AhbGdmaPumpBlockOwned(int(channel),transmit,int(descriptors),int(count),int(buffers),int(stride),int(bytes),int(index),cpu,int(polls),exclusive)|0
}
