import "../../src/display/spi_program_esp32c5.ab"
import "../../src/display/mipi_programs.ab"
import "abla/build"
// Panel powered/reset and D/C configured; RGB565/rotation/brightness separate.
@export("abla_esp32c5_ili9342_program_example")
trusted fun example(master: Esp32C5SpiMaster,gate: PeripheralGate,owner: u32,dc: int): SpiBufferResult =
    esp32C5LcdRunProgram(master|0,gate,owner,dc,ili9342InitProgram(),72,1000)
