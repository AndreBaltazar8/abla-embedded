import "../../src/esp32/power/sleep_measured_cycle_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MeasuredCycleExample")
@export("abla_esp32c5_sleep_measured_cycle_example")
trusted fun measured(record: NativeBuffer,request: NativeBuffer,slowCycles: int,fastCycles: int,resume: bool,exclusive: bool): int =
    if (resume) esp32C5SleepMeasuredContinueOwned(record,exclusive) else esp32C5SleepMeasuredBeginOwned(record,request,slowCycles,fastCycles,exclusive)
