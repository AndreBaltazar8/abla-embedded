import "../../src/esp32/power/sleep_gpio_cancel_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_sleep_gpio_cancel_example")
fun example(sleep: int,wake: int,report: int,polls: int,clocksUnchanged: bool,exclusive: bool): int =
    esp32S3SleepGpioCancelOwned(nativeBufferAt(sleep,128),nativeBufferAt(wake,32),nativeBufferAt(report,16),polls,clocksUnchanged,exclusive)
