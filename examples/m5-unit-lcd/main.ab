import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_lcd.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun unitLcdDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Configured/identified device, exclusive queue interval, explicit rotation
// and byte-swap configuration. Raw color is serialized low-byte-first.
@export("abla_m5_unit_lcd_example")
trusted fun example(device: I2cDevice,operation: int,scratch: NativeBuffer,value: int): int {
    if (operation == 0) return device.unitLcdIdentify(scratch)|0
    if (operation == 1) return device.unitLcdControl(34,value,scratch,16)
    if (operation == 2) return device.unitLcdFill16(0,0,135,240,0,value,scratch,16)
    return 2
}
