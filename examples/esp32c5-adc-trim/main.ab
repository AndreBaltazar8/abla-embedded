import "../../src/esp32/adc_trim_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_adc_trim_example")
trusted fun example(owner: C5AdcTrimOwner,calibration: C5AdcCalibration,exclusiveStopped: bool,close: bool): C5AdcTrimOwner =
    if (close) owner.closeOwned(exclusiveStopped) else c5AdcTrimOpenOwned(calibration,exclusiveStopped)
