import "../../src/audio/buzzer_source_block.ab"
import "abla/build"
@export("abla_esp32c6_buzzer_source_block_example")
trusted fun example(r: NativeBuffer,queues: int,frames: int,acc: NativeBuffer,scratch: NativeBuffer,mono: NativeBuffer,output: NativeBuffer,volume: int,joined: bool,exclusive: bool,operation: int): int =
    if (operation == 0) (if (buzzerSourceBlockInitOwned(r,0,exclusive)) 1 else 2)
    else if (operation == 1) buzzerSourceBlockPrepareOwned(r,PcmSourceQueues(queues),frames,acc,scratch,mono,output,PcmVolume(volume),exclusive)
    else if (operation == 2) (if (buzzerSourceBlockReleaseOwned(r,joined,exclusive)) 1 else 2) else 2
