import "../../src/display/ssd1677_activation_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Already initialized SSD1677 and BUSY18inputpullup. mode4 needs validhistory.
// Caller commits history/face only on success; invalidates both on failure.
@export("abla_papermono_refresh_example")
trusted fun refresh(gate: PeripheralGate,owner: u32,canvas: NativeBuffer,history: NativeBuffer,
    mode: int,odd: bool,invert: bool,screenOn: bool,x: int,y: int,w: int,h: int,polls: int,exclusive: bool): int =
    esp32s3Ssd1677Refresh(gate,owner,2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),canvas,history,
        800,480,mode,odd,invert,screenOn,x,y,w,h,polls,exclusive)|0
