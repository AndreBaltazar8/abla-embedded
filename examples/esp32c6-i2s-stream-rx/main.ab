import "../../src/esp32/i2s/stream_rx_esp32c6.ab"
import "abla/build"
// Caller copies/consumes the acquired view before releasing it to DMA.
@export("abla_esp32c6_i2s_stream_rx_example")
trusted fun example(start: NativeBuffer,cursor: NativeBuffer,consumersJoined: bool,exclusive: bool,release: bool): int =
    if (release) c6I2sRxStreamReleaseOwned(start,cursor,consumersJoined,exclusive) else c6I2sRxStreamAcquireOwned(start,cursor,exclusive)
