import "../../src/esp32/power/sleep_digital_esp32p4.ab"
@export("abla_esp32p4_sleep_digital_example")
trusted fun example(flags: int,token: int,close: bool,exclusive: bool): int {
    if (close) return P4SleepDigital(token).closeOwned(exclusive)|0
    return esp32p4SleepDigitalOpenOwned(flags,exclusive)|0
}
