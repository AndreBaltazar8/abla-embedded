import "../../src/esp32/power/sleep_handoff_esp32p4.ab"
@export("abla_esp32p4_sleep_handoff_example")
trusted fun example(record: int,rendezvous: int,config: int,graph: int,graphBytes: int,backing: int,backingBytes: int,action: int,sourcesReady: bool,otherPolicyReady: bool,exclusive: bool): int =
    if (action == 0) esp32p4SleepRoundHandoffOwned(nativeBufferAt(record,2168),nativeBufferAt(rendezvous,64),nativeBufferAt(config,192),nativeBufferAt(graph,graphBytes),nativeBufferAt(backing,backingBytes),exclusive)
    else if (action == 1) esp32p4SleepRoundContinueOwned(nativeBufferAt(record,2168),32,32,sourcesReady,otherPolicyReady,exclusive)
    else if (action == 2) esp32p4SleepRendezvousContinueOwned(nativeBufferAt(rendezvous,64),32,exclusive)
    else 4
