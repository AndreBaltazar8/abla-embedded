import "../../src/esp32/power/ext1_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Selected pads must be prepared and wake line released. Does not enter sleep.
@export("abla_esp32c5_ext1_example")
trusted fun configure(selection: int,highLevels: int): C5Ext1Wake {
    val lease=esp32C5Ext1ParkOwned(true)
    if (lease.status() != 6) return lease
    lease.configureOwned(selection,highLevels,true,true)
}
