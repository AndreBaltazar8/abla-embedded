import "../../src/esp32/power/cpu_clock_esp32p4.ab"
@export("abla_esp32p4_cpu_clock_example")
trusted fun example(record: int,sourceMHz: int,revision: int,polls: int,action: int,exclusive: bool): int {
    val r=nativeBufferAt(record,48)
    if (action == 0) return esp32p4CpuClockOpenOwned(r,sourceMHz,revision,polls,exclusive)
    if (action == 1) return esp32p4CpuClockContinueOwned(r,polls,exclusive)
    if (action == 2) return esp32p4CpuClockCloseOwned(r,polls,exclusive)
    return 2
}
