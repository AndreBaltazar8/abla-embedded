import "../../src/m5stack/papermono_sdmmc_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_papermono_sdmmc_example")
trusted fun begin(control: M5Pm1Control,context: NativeBuffer,padSnapshot: NativeBuffer,
    now: u32,exclusivePrepared: bool): int = control.beginPaperMonoSdMmcOwned(context,padSnapshot,1,false,now,2000,exclusivePrepared)
