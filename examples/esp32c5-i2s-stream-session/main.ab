import "../../src/esp32/i2s/stream_session_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_stream_session_example")
trusted fun example(session: NativeBuffer,channel: int,tx: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,exclusive: bool,discard: bool,operation: int): int =
    if (operation == 0) c5I2sStreamSessionBeginOwned(session,channel,tx,descriptors,count,buffers,stride,bytes,polls,exclusive)
    else if (operation == 1) c5I2sStreamSessionPollOwned(session,polls,exclusive)
    else if (operation == 2) c5I2sStreamSessionRearmOwned(session,exclusive)
    else if (operation == 3) c5I2sStreamSessionStopOwned(session,polls,exclusive,discard) else 2
