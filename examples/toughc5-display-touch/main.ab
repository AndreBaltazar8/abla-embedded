import "../../src/m5stack/tough_touch_display_esp32c5.ab"
import "abla/build"
@export("abla_toughc5_display_touch_example")
trusted fun example(parent: M5ToughPowerOwner,session: NativeBuffer,touch: TouchControllerOpen,
    snapshot: NativeBuffer,previous: NativeBuffer,exclusive: bool): int =
    parent.readDisplayTouchOwned(session,touch,snapshot,previous,exclusive)
