import "../../src/esp32/power/sleep_flash_restore_esp32p4.ab"
@export("abla_esp32p4_sleep_flash_restore_example")
trusted fun example(record: int,resume: bool,minimumRevision: int,polls: int,exclusive: bool): int =
    if (resume) esp32p4SleepFlashRestoreContinueOwned(nativeBufferAt(record,80),polls,exclusive) else esp32p4SleepFlashRestoreBeginOwned(nativeBufferAt(record,80),minimumRevision,polls,exclusive)
