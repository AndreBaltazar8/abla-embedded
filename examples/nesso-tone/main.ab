import "../../src/m5stack/tone_esp32c6.ab"
import "abla/build"
// Caller pins clocks/calibrated timing and owns the full LEDC peripheral.
// operation0 starts;1 polls;2 stops early. Continue polling cleanup failures.
@export("abla_nesso_tone_example")
trusted fun example(record: NativeBuffer,source: int,sourceHz: int,hz: int,
    now: int,duration: int,operation: int,exclusive: bool): int {
    if (operation == 0) return m5BoardArduinoNessoN1.startC6ToneOwned(record,source,sourceHz,hz,0,0,now,duration,1000,exclusive)
    if (operation == 1) return c6TonePollOwned(record,now,1000,exclusive)
    if (operation == 2) return c6ToneStopOwned(record,1000,exclusive)
    return 2
}
