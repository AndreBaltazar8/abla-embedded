import "../../src/esp32/spi/command_data_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_spi_command_data_example")
trusted fun example(master: Esp32C5SpiMaster,gate: PeripheralGate,owner: u32,dc: int,
    command: int,data: NativeBuffer,bytes: int): SpiBufferResult =
    master.commandData(gate,owner,dc,command,data,bytes,1000)
