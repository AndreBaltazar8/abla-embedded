import "../../src/esp32/i2s/transfer_esp32p4.ab"
// Command0 reset (parked DMA),1 latch,2 start (prepared DMA),3 stop request,
// 4 RX block byte count. Ownership and clock prerequisites apply to every call.
@export("abla_esp32p4_i2s_transfer_example")
trusted fun control(port: i32, transmit: bool, command: i32, argument: i32, exclusive: bool): i32 {
    if (command == i32(0)) return i32(esp32p4I2sResetDirectionOwned(int(port),transmit,exclusive))
    if (command == i32(1)) return i32(esp32p4I2sLatchOwned(int(port),transmit,int(argument),exclusive))
    if (command == i32(2)) return i32(esp32p4I2sStartDirectionOwned(int(port),transmit,int(argument),exclusive))
    if (command == i32(3)) return i32(esp32p4I2sStopDirectionOwned(int(port),transmit,exclusive))
    if (command == i32(4) && !transmit) return i32(esp32p4I2sSetReceiveBlockBytesOwned(int(port),int(argument),exclusive))
    return i32(2)
}
