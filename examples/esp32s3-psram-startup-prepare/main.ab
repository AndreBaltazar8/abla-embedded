import "../../src/esp32/psram/startup_prepare_esp32s3.ab"
import "abla/build"
// Callable, not a reset entry or board preset. Caller certifies electrical,
// pad, CPU/IRQ, analog/APB and internal-memory ownership; no guessed voltage.
@export("abla_esp32s3_psram_startup_prepare_example")
@section(".iram1.abla.s3PsramStartupPrepareExample")
fun example(memoryMillivolts: int,polls: int,prepareClock: bool,owned: bool): int =
    s3PsramStartupPrepareOwned(memoryMillivolts,polls,prepareClock,owned)
