import "../../src/esp32/spi/pin_session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns stopped SPI/DMA/global MISO input and pad users; zeroed32B
// record retained until closed. No peripheral clock/start/transfer implied.
@export("abla_esp32s3_spi_pin_session_example")
trusted fun pins(op: int,record: NativeBuffer,peripheral: int,profile: SpiPins,cs: Pin,exclusive: bool): int {
    if (op == 0) return esp32S3SpiPinsOpenOwned(record,peripheral,profile,cs,exclusive)
    if (op == 1) return esp32S3SpiPinsCloseOwned(record,exclusive)
    return 0
}
