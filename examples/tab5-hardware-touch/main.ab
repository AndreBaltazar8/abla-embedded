import "../../src/m5stack/control_bus_hardware_esp32p4.ab"
import "../../src/touch/st7123_device.ab"
import "abla/runtime/scalar"
// Explicit ST7123 path: caller already identified this panel and completed
// power/reset sequencing. Do not use for GT911 panels or guess panel identity.
// Caller retains96B bus record, device handle and72B snapshot. A negative frame
// result must not be decoded as an empty report or used for point access.
@export("abla_tab5_hardware_touch_example")
trusted fun example(action: int,record: int,layout: int,cpuHz: u32,device: int,snapshot: int,index: int): int {
    val r=nativeBufferAt(record,96)
    if (action == 0) return m5P4HardwareControlOpenOwned(r,m5BoardTab5,0,layout,u32(40000000),cpuHz,true)
    if (action == 1) return st7123(m5P4HardwareControlDeviceBus(r))|0
    if (action == 2) return if (St7123(device).begin()) 1 else 0
    if (action == 3) return St7123(device).readFrame(nativeBufferAt(snapshot,72))
    if (action == 4) return st7123Point(nativeBufferAt(snapshot,72),index)|0
    if (action == 5) return if (St7123(device).close()) 1 else 0
    if (action == 6) return m5P4HardwareControlCloseOwned(r,true)
    return -1
}
