import "../../src/m5stack/chaincaptain_display_startup_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Existing ready controller and exclusively owned SPI2/display pins/PLL80M.
// Caller retains all ownership on failure; this is not an autonomous boot image.
@export("abla_chaincaptain_display_example")
trusted fun initialize(control: M5Pm1Control,gate: PeripheralGate,owner: u32,rotation: int,brightness: int,exclusive: bool): int =
    control.initializeChainDisplayOwned(gate,owner,true,rotation,brightness,exclusive)|0
