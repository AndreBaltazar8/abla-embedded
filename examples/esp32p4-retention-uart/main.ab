import "../../src/esp32/power/retention_uart_p4.ab"
import "../../src/esp32/power/retention_list_p4.ab"
// Disconnected output only, no hardware activation. Config workspace168B,
// scratch36B, backing storage88B; resulting erratum-safe list116B.
// Caller owns valid, aligned, mutually disjoint buffers. Config workspace
// is disposable and may change on failure; no UART/FIFO access occurs here.
@export("abla_esp32p4_retention_uart_example")
trusted fun example(out: int,outBytes: int,configs: int,scratch: int,storage: int,uart: int): int {
    var node=0
    while (node < 3) {
        if (!esp32p4RetentionUartConfig(nativeBufferAt(configs+node*56,56),uart,node,if (node == 0) storage else 0,0)) return 0
        node=node+1
    }
    return esp32p4RetentionListEncode(nativeBufferAt(out,outBytes),nativeBufferAt(configs,168),nativeBufferAt(scratch,36),3)
}
