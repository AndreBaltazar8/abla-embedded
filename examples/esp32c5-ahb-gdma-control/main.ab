import "../../src/esp32/ahb_gdma_control_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_ahb_gdma_control_example")
trusted fun example(stop: C5AhbGdmaStop,channel: int,tx: bool,polls: int,exclusive: bool,discard: bool,operation: int): int =
    if (operation == 0) c5AhbGdmaStopBeginOwned(channel,tx,polls,exclusive)|0
    else if (operation == 1) stop.waitOwned(polls,exclusive)|0
    else if (operation == 2 || operation == 3) c5AhbGdmaResetOwned(channel,tx,exclusive,discard,operation == 3) else 2
