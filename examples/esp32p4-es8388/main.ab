import "../../src/esp32/i2c_software_esp32p4.ab"
import "../../src/esp32/peripheral_delay_esp32p4.ab"
import "../../src/audio/es8388_device.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Owned initialized bus/codec, externalampOFF, valid live slave-mode clocks.
// For24kHz Tab5 use256fsMCLK; register24 does not select slave clock ratio.
// Shutdown must finish before clocks stop; failure retains ownership.
@export("abla_esp32p4_es8388_example")
trusted fun codec(device: Es8388,enable: bool,exclusive: bool): int =
    if (enable) device.configureStereoDacSlaveOwned(exclusive) else device.speakerPowerDownOwned(exclusive)
