import "../../src/led/rmt_strip_dma_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Callable, not boot firmware. Caller prepares/owns RMT3, APB80MHz, pad route
// and GDMA channel plus disjoint state/descriptors/waveform storage. No SDK
// begin/auto-display: buffered updates followed by one explicit DMA display.
@export("abla_esp32s3_led_buffered_dma_example")
trusted fun display(state: NativeBuffer,colors: NativeBuffer,count: int,brightness: int,
    pin: int,dma: int,descriptors: int,waveform: NativeBuffer,polls: int): int {
    // Construction clears state. Reject source aliasing before that write.
    if (count < 1 || count > 65535 || !colors.hasAddressRange(0,count*3) ||
        (colors.addressValue() < state.addressValue()+state.capacity() &&
        state.addressValue() < colors.addressValue()+count*3)) return 2
    val strip=rmtLedStripAt(state,pin,count)
    if (!strip.valid() || !strip.storeColors(colors,0,count) || !strip.storeBrightness(brightness)) return 2
    return strip.displayDmaOwned(dma,descriptors,waveform,polls)
}
