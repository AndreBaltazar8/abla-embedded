import "../../src/esp32/spi/master_esp32c5.ab"
import "abla/build"
// Fresh owned hardware, not a boot image. GPIO clocks remain caller-owned.
@export("abla_esp32c5_spi_master_example")
trusted fun example(owner: Esp32C5SpiMaster,pins: SpiPins,cs: int,sourceHz: int,opening: bool,exclusive: bool): Esp32C5SpiMaster =
    if (opening) esp32C5SpiMasterOpenOwned(pins,cs,sourceHz,2,1,8,0,1000,exclusive) else owner.closeOwned(exclusive)

