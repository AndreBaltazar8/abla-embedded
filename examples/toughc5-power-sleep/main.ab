import "../../src/esp32/i2c_esp32c5.ab"
import "../../src/m5stack/tough_power_sleep_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Cache-on preflight, caller quiescence, then one-shot Begin. Continue using
// measured framework APIs after ownership transfer; power owner stays live.
@export("abla_toughc5_power_sleep_example")
trusted fun sleep(owner: M5ToughPowerOwner,record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,scratch: NativeBuffer,touch: int,slowCycles: int,fastCycles: int,begin: bool,exclusive: bool): int =
    if (begin) owner.sleepBeginOwned(record,request,context,scratch,slowCycles,fastCycles,exclusive)
    else owner.sleepPreflightOwned(record,request,context,scratch,touch,slowCycles,fastCycles,exclusive)
