import "../../src/display/it8951_color.ab"
import "../../src/display/it8951_rotation.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_it8951_color_rotation_example")
trusted fun example(source: NativeBuffer,sourceStride: int,logical: NativeBuffer,logicalStride: int,
    physical: NativeBuffer,physicalStride: int,width: int,height: int,rotation: int): bool {
    if (!it8951ConvertRgbForRotationOwned(source,sourceStride,logical,logicalStride,width,height,rotation,true,false,false,true)) return false
    it8951Rotate4Owned(logical,logicalStride,physical,physicalStride,width,height,rotation,true)
}
