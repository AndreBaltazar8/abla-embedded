import "../../src/esp32/i2c/software_bus_esp32c6.ab"
import "abla/runtime/scalar"
import "abla/build"
// Call with owned/calibrated clocks and safed pads. A failed open may retain
// pad ownership: keep the scalar for recovery or close. Not a boot image.
@export("abla_esp32c6_i2c_software_example")
fun example(action: int,owner: Esp32C6SoftwareI2cBus,sda: int,scl: int,exclusive: bool): Esp32C6SoftwareI2cBus {
    if (action == 0) return esp32C6SoftwareI2cOpenOwned(sda,scl,5,1000,exclusive)
    if (action == 1) return owner.closeOwned()
    if (action == 2 && exclusive) return owner.recoverOwned(true)
    return owner
}
