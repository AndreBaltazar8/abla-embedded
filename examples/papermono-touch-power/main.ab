import "../../src/m5stack/papermono_touch_power_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Assignreturnedtaggedowner; status6retains handle forretry/close,notpolling.
@export("abla_papermono_touch_power_example")
trusted fun power(control: M5Pm1Control,touch: TouchControllerOpen,wake: bool,exclusive: bool): int =
    (if (wake) control.wakePaperMonoTouchOwned(touch,exclusive) else control.sleepPaperMonoTouchOwned(touch,exclusive))|0
