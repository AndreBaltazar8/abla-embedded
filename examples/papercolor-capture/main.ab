import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/papercolor_capture_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Zeroed132B retained record, initialized codec/bus and owned I2S/GDMA/pads.
// ALL consumers of codec rail GPIO45 must stay quiescent; close restores it.
// op0prepare,1start,2close/retry,3read. Not standalone boot firmware.
@export("abla_papercolor_capture_example")
trusted fun capture(op: int,r: NativeBuffer,hz: int,channel: int,desc: int,count: int,
    payload: int,bytes: int,owner: u32,codec: Es7210,output: NativeBuffer,polls: int,exclusive: bool): int {
    if (op == 0) return paperColorCaptureBeginOwned(r,hz,channel,desc,count,payload,bytes,owner,codec,exclusive)
    if (op == 1) return paperColorCaptureStartOwned(r,polls,exclusive)
    if (op == 2) return paperColorCaptureCloseOwned(r,polls,exclusive)
    if (op == 3) return paperColorCaptureReadOwned(r,output,polls,exclusive)|0
    return 0
}
