import "../../src/esp32/interrupt_matrix_esp32.ab"
import "../../src/xtensa/cpu.ab"

// Build-only leaves for instruction inspection. They are not invoked or
// flashed by this example.
@export("abla_esp32_core_id")
trusted fun esp32CoreId(): u32 = cpuCoreId()

@export("abla_wifi_mac_route_interrupt")
trusted fun routeWifiMacInterrupt(cpu: int): bool =
    esp32WifiMacInterruptSource().routeTo(
        esp32Cpu(cpu), esp32WifiMacInterrupt()
    )

@export("abla_wifi_mac_unroute_interrupt")
trusted fun unrouteWifiMacInterrupt(cpu: int): bool =
    esp32WifiMacInterruptSource().unrouteFrom(esp32Cpu(cpu))

@export("abla_wifi_mac_enable_interrupt")
trusted fun enableWifiMacInterrupt(): u32 =
    esp32WifiMacInterrupt().enable().rawValue()

@export("abla_wifi_mac_disable_interrupt")
trusted fun disableWifiMacInterrupt(): u32 =
    esp32WifiMacInterrupt().disable().rawValue()

@export("abla_xtensa_interrupts_enable")
trusted fun enableInterrupts(mask: u32): u32 =
    XtensaInterruptMask(mask).enable().rawValue()

@export("abla_xtensa_interrupts_disable")
trusted fun disableInterrupts(mask: u32): u32 =
    XtensaInterruptMask(mask).disable().rawValue()
