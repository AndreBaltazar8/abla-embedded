@export("abla_xtensa_atomic_compare_exchange_u32")
trusted fun xtensaAtomicCompareExchangeCodegen(
    address: u32,
    expected: u32,
    desired: u32
): u32 = xtensaAtomicCompareExchangeU32(address, expected, desired)

@export("abla_xtensa_spin_lock_try")
trusted fun xtensaSpinLockTryCodegen(address: u32): bool =
    xtensaSpinLock(address).tryAcquire()

