import "../../src/esp32/crypto/ccm_esp32.ab"
import "../../src/esp32/crypto/cmac_gmac_esp32.ab"
import "../../src/esp32/wifi/ccmp_packet_esp32.ab"
import "../../src/esp32/wifi/bip_packet_esp32.ab"
import "../../src/xtensa/atomic.ab"

@export("abla_wifi_ccmp_packet_number_fresh")
fun ccmpPacketNumberFreshCodegen(candidate: int, previous: int): bool =
    wifiCcmpPacketNumber(candidate).freshAfter(
        wifiCcmpPacketNumber(previous)
    )

@export("abla_esp32_ccm_encrypt_request32")
trusted fun ccmEncryptRequestCodegen(requestAddress: u32): bool =
    esp32AesCcmEncryptRequest32(requestAddress)

@export("abla_esp32_ccm_decrypt_request32")
trusted fun ccmDecryptRequestCodegen(requestAddress: u32): bool =
    esp32AesCcmDecryptRequest32(requestAddress)

@export("abla_esp32_cmac_request32")
trusted fun cmacRequestCodegen(requestAddress: u32): bool =
    esp32AesCmacRequest32(requestAddress)

@export("abla_esp32_gmac_request32")
trusted fun gmacRequestCodegen(requestAddress: u32): bool =
    esp32AesGmacRequest32(requestAddress)

@export("abla_esp32_wifi_bip_protect_request32")
trusted fun wifiBipProtectRequestCodegen(requestAddress: u32): int =
    esp32WifiBipProtectRequest32(requestAddress)

@export("abla_esp32_wifi_bip_verify_request32")
trusted fun wifiBipVerifyRequestCodegen(requestAddress: u32): int =
    esp32WifiBipVerifyRequest32(requestAddress)

@export("abla_esp32_wifi_ccmp_encrypt_request32")
trusted fun wifiCcmpEncryptRequestCodegen(requestAddress: u32): int =
    esp32WifiCcmpEncryptRequest32(requestAddress)

@export("abla_esp32_wifi_ccmp_decrypt_request32")
trusted fun wifiCcmpDecryptRequestCodegen(requestAddress: u32): int =
    esp32WifiCcmpDecryptRequest32(requestAddress)

@export("abla_xtensa_atomic_compare_exchange_u32")
trusted fun xtensaAtomicCompareExchangeCodegen(
    address: u32,
    expected: u32,
    desired: u32
): u32 = xtensaAtomicCompareExchangeU32(address, expected, desired)

@export("abla_xtensa_spin_lock_try")
trusted fun xtensaSpinLockTryCodegen(address: u32): bool =
    xtensaSpinLock(address).tryAcquire()

@export("abla_esp32_wifi_ccmp_encrypt_packet_request32")
trusted fun wifiCcmpEncryptPacketRequestCodegen(requestAddress: u32): int =
    esp32WifiCcmpEncryptPacketRequest32(requestAddress)

@export("abla_esp32_wifi_ccmp_decrypt_packet_request32")
trusted fun wifiCcmpDecryptPacketRequestCodegen(requestAddress: u32): int =
    esp32WifiCcmpDecryptPacketRequest32(requestAddress)

@export("abla_esp32_wifi_ccmp_espnow_packet_request32")
trusted fun wifiCcmpEspNowPacketRequestCodegen(requestAddress: u32): int =
    esp32WifiCcmpEspNowPacketRequest32(requestAddress)

fun main: int = 0
