@export("abla_wifi_ccmp_packet_number_fresh")
fun ccmpPacketNumberFreshCodegen(candidate: int, previous: int): bool =
    wifiCcmpPacketNumber(candidate).freshAfter(
        wifiCcmpPacketNumber(previous)
    )

@export("abla_esp32_ccm_encrypt_request32")
trusted fun ccmEncryptRequestCodegen(requestAddress: u32): bool =
    esp32AesCcmEncryptRequest32(requestAddress)

@export("abla_esp32_ccm_decrypt_request32")
trusted fun ccmDecryptRequestCodegen(requestAddress: u32): bool =
