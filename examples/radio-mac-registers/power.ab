import "../../src/esp32/radio/power_esp32.ab"

// Build-only power/clock leaves for Xtensa instruction inspection.
@export("abla_wifi_mac_clock_enabled")
trusted fun wifiMacClockEnabled(): bool = wifiRadioPower().macClockEnabled()

@export("abla_wifi_mac_module_enable")
trusted fun wifiMacModuleEnable(): void {
    wifiRadioPower().setMacModuleEnabled(true)
    return
}

@export("abla_wifi_mac_reset")
trusted fun wifiMacReset(): void {
    wifiRadioPower().resetMac()
    return
}

@export("abla_wifi_radio_power_on_240mhz")
trusted fun wifiRadioPowerOn240Mhz(): bool =
    wifiRadioPower().powerOn(240)
