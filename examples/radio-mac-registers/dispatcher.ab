import "../../src/xtensa/dispatcher_owned.ab"
import "../../src/xtensa/cpu.ab"

// Build-only object for proving that Abla owns the complete dispatcher data
// and mask-helper unit. It is linked relocatably in the comparison check and
// is never flashed by this example.
@export("abla_owned_xtensa_interrupt_table_address")
trusted fun ownedInterruptTableAddress(): u32 =
    xtensaInterruptTable().rawAddress()

fun main: int = 0
