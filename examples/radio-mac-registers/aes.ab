import "../../src/esp32/crypto/aes_esp32.ab"

@export("abla_esp32_aes128_encrypt_block")
trusted fun aes128EncryptBlockCodegen(
    keyAddress: u32,
    inputAddress: u32,
    outputAddress: u32,
    maximumPolls: u32
): bool = esp32Aes128EncryptBlock32(
    keyAddress, inputAddress, outputAddress, maximumPolls
)

fun main: int = 0
