import "../../src/esp32/radio/mac_esp32.ab"

// Build-only register-access sample. These exported leaf operations let the
// resulting Xtensa object be inspected without linking or flashing firmware.
@export("abla_wifi_mac_interrupt_status")
trusted fun wifiMacInterruptStatus(): int =
    wifiMac().interruptCause().rawValue()

@export("abla_wifi_mac_interrupt_clear")
trusted fun wifiMacInterruptClear(cause: int): void {
    wifiMac().clearInterrupts(WifiMacInterruptCause(cause))
    return
}

@export("abla_wifi_mac_time")
trusted fun wifiMacTime(): int = wifiMac().time()
