import "abla/compiler"

val target = #compilerDefineTarget(
    "esp32-xtensa",
    "xtensa-esp-unknown-elf",
    "elf",
    "none",
    "none",
    false,
    false
)

val built = #compilerBuildProgram(
    "abla-embedded-radio-mac-registers",
    "examples/radio-mac-registers/main.ab",
    "build/examples/radio-mac-registers/abla_app.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val dmaBuilt = #compilerBuildProgram(
    "abla-embedded-esp-dma-descriptor",
    "examples/radio-mac-registers/dma.ab",
    "build/examples/radio-mac-registers/abla_dma.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val powerBuilt = #compilerBuildProgram(
    "abla-embedded-esp-radio-power",
    "examples/radio-mac-registers/power.ab",
    "build/examples/radio-mac-registers/abla_power.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val chainBuilt = #compilerBuildProgram(
    "abla-embedded-esp-radio-rx-chain",
    "examples/radio-mac-registers/chain.ab",
    "build/examples/radio-mac-registers/abla_chain.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

fun main: int =
    if (target && built && dmaBuilt && powerBuilt && chainBuilt) 0 else 1
