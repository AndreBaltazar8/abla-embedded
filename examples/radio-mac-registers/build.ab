import "abla/compiler"

val target = #compilerDefineTarget(
    "esp32-xtensa",
    "xtensa-esp-unknown-elf",
    "elf",
    "none",
    "none",
    false,
    false
)

val built = #compilerBuildProgram(
    "abla-embedded-radio-mac-registers",
    "examples/radio-mac-registers/main.ab",
    "build/examples/radio-mac-registers/abla_app.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val dmaBuilt = #compilerBuildProgram(
    "abla-embedded-esp-dma-descriptor",
    "examples/radio-mac-registers/dma.ab",
    "build/examples/radio-mac-registers/abla_dma.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val powerBuilt = #compilerBuildProgram(
    "abla-embedded-esp-radio-power",
    "examples/radio-mac-registers/power.ab",
    "build/examples/radio-mac-registers/abla_power.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val chainBuilt = #compilerBuildProgram(
    "abla-embedded-esp-radio-rx-chain",
    "examples/radio-mac-registers/chain.ab",
    "build/examples/radio-mac-registers/abla_chain.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val fcsBuilt = #compilerBuildProgram(
    "abla-embedded-wifi-fcs",
    "examples/radio-mac-registers/fcs.ab",
    "build/examples/radio-mac-registers/abla_fcs.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val interruptBuilt = #compilerBuildProgram(
    "abla-embedded-esp32-interrupt-matrix",
    "examples/radio-mac-registers/interrupt.ab",
    "build/examples/radio-mac-registers/abla_interrupt.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val dispatcherBuilt = #compilerBuildProgram(
    "abla-embedded-xtensa-owned-dispatcher",
    "examples/radio-mac-registers/dispatcher.ab",
    "build/examples/radio-mac-registers/abla_dispatcher.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val rxBuilt = #compilerBuildProgram(
    "abla-embedded-esp32-wifi-rx",
    "examples/radio-mac-registers/rx.ab",
    "build/examples/radio-mac-registers/abla_rx.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val queueBuilt = #compilerBuildProgram(
    "abla-embedded-esp32-wifi-rx-queue",
    "examples/radio-mac-registers/queue.ab",
    "build/examples/radio-mac-registers/abla_queue.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val txBuilt = #compilerBuildProgram(
    "abla-embedded-esp32-wifi-tx",
    "examples/radio-mac-registers/tx.ab",
    "build/examples/radio-mac-registers/abla_tx.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val managementBuilt = #compilerBuildProgram(
    "abla-embedded-wifi-management",
    "examples/radio-mac-registers/management.ab",
    "build/examples/radio-mac-registers/abla_management.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

fun main: int =
    if (target && built && dmaBuilt && powerBuilt && chainBuilt && fcsBuilt &&
        interruptBuilt && dispatcherBuilt && rxBuilt && queueBuilt && txBuilt &&
        managementBuilt) 0
    else 1
