import "../../src/esp32/dma_descriptor_chain.ab"

@export("abla_wifi_prepare_rx_chain_native")
trusted fun prepareWifiRxChainNative(
    descriptorBase: u32,
    bufferBase: u32,
    descriptorCount: u32
): bool = espDmaInitializeRxChain(
    descriptorBase, descriptorCount, bufferBase, u32(1600), u32(1600)
)
