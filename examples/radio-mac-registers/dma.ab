import "../../src/esp32/dma_descriptor.ab"

// Build-only descriptor operation for Xtensa instruction inspection.
@export("abla_esp_dma_prepare_rx")
trusted fun prepareRxDescriptor(
    descriptorAddress: u32,
    bufferAddress: u32,
    capacity: u32,
    nextAddress: u32
): bool = dmaDescriptorAt(descriptorAddress).initializeRx(
    bufferAddress, capacity, dmaDescriptorAt(nextAddress)
)
