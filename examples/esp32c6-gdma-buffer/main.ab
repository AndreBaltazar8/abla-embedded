import "../../src/esp32/gdma_buffer_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_gdma_buffer_example")
trusted fun example(channel: int,tx: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,index: int,circular: bool,exclusive: bool,rearm: bool): int =
    if (rearm) c6GdmaRearmOwned(channel,tx,descriptors,count,buffers,stride,bytes,index,circular,exclusive)
    else c6GdmaAcquireOwned(channel,tx,descriptors,count,buffers,stride,bytes,index,circular,exclusive)|0
