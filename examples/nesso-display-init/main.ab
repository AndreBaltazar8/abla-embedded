import "../../src/esp32/spi_software_esp32c6.ab"
import "../../src/display/software_mipi_checked.ab"
import "../../src/display/mipi_programs.ab"
import "../../src/m5stack/display_map.ab"
import "abla/build"
// Native callable, NOT boot image. First prepare E1 power/reset and checked
// LCD pads, with calibrated clocks and canonical gate. Backlight stays off;
// caller may enable it only after success. Color order is explicit.
@export("abla_nesso_display_init_example")
trusted fun example(gate: PeripheralGate,owner: u32,rotation: int,bgrOrder: bool): SpiTransactionResult {
    val board=m5BoardArduinoNessoN1;val p=board.displaySpiPins()
    return softwareLcdBeginRgb565Checked(gate,owner,Pin(p.clock()),Pin(p.mosi()),Pin(p.chipSelect()),Pin(p.dataCommand()),
        board.displayGeometry(),rotation,st7789InitProgram(),NativeBuffer(0),true,bgrOrder,1,false)
}
