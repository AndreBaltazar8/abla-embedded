import "../../src/esp32/serial_esp32c5.ab"
import "abla/build"
// Caller supplies configured clocked/pad-owned UART and joins all other users.
// No byte replay on timeout: -3 write full, -4 byte queued but flush timed out.
@export("abla_esp32c5_serial_example")
trusted fun example(unit: int,value: int,polls: int,receive: bool): int {
    val port=serial(unit)
    if (!port.valid()) return -2
    if (receive) return port.tryReadByte()
    if (!port.tryWriteByte(value,polls)) return -3
    return if (port.tryFlush(polls)) 1 else -4
}
