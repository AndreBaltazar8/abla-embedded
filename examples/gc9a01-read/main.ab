import "../../src/esp32/spi_software_esp32c61.ab"
import "../../src/display/gc9a01_read.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller supplies a readable separately wired SDO/MISO panel, owned configured
// pins, initialized rotation and exclusive output buffer. Callable only.
@export("abla_gc9a01_read_example")
trusted fun run(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,miso: Pin,cs: Pin,dc: Pin,
    rotation: int,x: int,y: int,width: int,height: int,destination: NativeBuffer,stride: int): SpiTransactionResult =
    gc9a01ReadRectChecked(gate,owner,clock,mosi,miso,cs,dc,rotation,x,y,width,height,destination,stride)
