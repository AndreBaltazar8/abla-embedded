import "../../src/esp32/ahb_gdma_buffer_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_ahb_gdma_buffer_example")
trusted fun example(channel: int,tx: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,index: int,circular: bool,exclusive: bool,rearm: bool): int =
    if (rearm) c5AhbGdmaRearmOwned(channel,tx,descriptors,count,buffers,stride,bytes,index,circular,exclusive)
    else c5AhbGdmaAcquireOwned(channel,tx,descriptors,count,buffers,stride,bytes,index,circular,exclusive)|0
