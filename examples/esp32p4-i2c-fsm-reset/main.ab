import "../../src/esp32/i2c/fsm_reset_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Explicit owned abort only: caller retains fault state until lines and
// controller FIFO/command cleanup are independently verified.
@export("abla_esp32p4_i2c_fsm_reset_example")
fun example(port: int,budget: u32,exclusive: bool): int = esp32p4I2cFsmResetOwned(port,budget,exclusive)
