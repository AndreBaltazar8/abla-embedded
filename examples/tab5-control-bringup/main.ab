import "./control.ab"
import "../../src/esp32/boot/internal_entry_esp32p4.ab"
import "../../src/esp32/serial_esp32p4.ab"
@export("abla_p4_application_main")
@noinline
trusted fun tab5ApplicationMain(): void {
    val phase=tab5ControlBringup()
    val port=serial(0)
    if (!port.tryWriteByte(48+phase,100000)) return
    if (!port.tryWriteByte(10,100000)) return
    port.tryFlush(100000)
    return
}
