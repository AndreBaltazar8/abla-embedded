import "../../src/esp32/timer/clock_esp32p4.ab"
import "../../src/m5stack/tab5_board_session_esp32p4.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
// Cold Tab5 control-plane bring-up (not Tab5X, not complete video firmware).
// Boot prerequisites: selected RAM layout matches chip, core1 stopped,
// 40MHz XTAL/LP/APB clocks stable, ROM delay calibrated, GPIO holds released,
// UART0 configured. Owns all SYSTIMER and Tab5 board-control resources.
// Leaves inherited watchdog policy intact; no periodic blind feeding.
// Success leaves timer/session and board power active until reset. Failure
// never retries/reinitializes partial setup; inherited watchdogs remain armed
// if armed by boot firmware. Do not rely on dead globals surviving LLVM DCE.
// Prints phase digit0..5 then newline on UART0.5=board/touch ready, NOT video.
val sessionStorage=nativeStaticAllocate(40)
val expanderStorage=nativeStaticAllocate(32)
val scratchStorage=nativeStaticAllocate(32)
var timerLease=P4SystemTimerClockOwner(0)
var boardResult=0
trusted fun tab5ControlBringup(): int {
    val session=tab5BoardSessionAt(nativeBufferAt(sessionStorage,40))
    val expanders=m5ExpandersAt(nativeBufferAt(expanderStorage,32))
    if (!session.initialize() || !expanders.initialize()) return 0
    timerLease=p4SystemTimerClockOpenOwned(0)
    if (!timerLease.ready()) return 1
    val counter=p4SystemCounter(0)
    if (counter.configureOwned(true,false,false) != 1) return 2
    val before=counter.tryTicks(10000)
    if (before < 0) return 3
    var remaining=10000
    var advanced=false
    while (remaining > 0) {
        val now=counter.tryTicks(64)
        if (now < 0) return 3
        if (p4SystemTimerElapsed(before,now) > 0) { advanced=true; break }
        remaining=remaining-1
    }
    if (!advanced) return 3
    boardResult=session.openOnChipOwned(m5BoardTab5,nativeBufferAt(expanderStorage,32),nativeBufferAt(scratchStorage,32))
    return if (boardResult == 1 && session.ready()) 5 else 4
}
