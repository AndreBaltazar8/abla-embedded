import "../../src/m5stack/nesso_power_esp32c6.ab"
import "../../src/m5stack/nesso_power_controls.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable only; state belongs to successfully opened NessoPower. Read and
// write result encodings differ: decode the selected API's checked result.
// Operations5..7 explicitly modify charge configuration; no automatic setup.
@export("abla_nesso_power_controls_example")
trusted fun example(storage: NativeBuffer,operation: int,value: int,exclusive: bool): int {
    val power=nessoPowerAt(storage)
    if (operation == 0) {
        val frame=power.pollButtonLevelsOwned(exclusive)
        return frame.pressedMask()|(frame.validMask()<<5)
    }
    if (operation == 1) return power.readBatteryMillivoltsOwned(exclusive)|0
    if (operation == 2) return power.readBatteryLevelOwned(exclusive)|0
    if (operation == 3) return power.readBatteryMilliampsOwned(exclusive)|0
    if (operation == 4) return power.readChargingOwned(exclusive)|0
    if (operation == 5) return power.setBatteryChargeOwned(value != 0,exclusive)|0
    if (operation == 6) return power.setChargeCurrentOwned(value,exclusive)|0
    if (operation == 7) return power.setChargeVoltageOwned(value,exclusive)|0
    return 0
}
