import "../../src/esp32/rtc_timer_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5RtcTimerExample")
@export("abla_esp32c5_rtc_timer_example")
trusted fun rtc(timer: int,target: int,arm: bool,exclusive: bool): int =
    if (arm) esp32C5RtcAlarmOwned(timer,target,exclusive) else esp32C5RtcTicksOwned(timer,exclusive)
