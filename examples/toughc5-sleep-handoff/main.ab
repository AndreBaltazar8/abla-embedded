import "../../src/esp32/i2c_esp32c5.ab"
import "../../src/m5stack/toughc5_sleep_handoff.ab"
import "abla/runtime/scalar"
import "abla/build"
// Cache-on only: run preflight before quiescing; Begin after quiescing.
// Use measured framework retry APIs, not this entry, after Begin claims state.
@export("abla_toughc5_sleep_handoff_example")
trusted fun sleep(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,scratch: NativeBuffer,boot: M5ToughBoot,pmic: M5PmicOpen,touch: int,slowCycles: int,fastCycles: int,begin: bool,exclusive: bool): int =
    if (begin) toughC5SleepBeginOwned(record,request,context,scratch,boot,slowCycles,fastCycles,exclusive)
    else toughC5SleepPreflightOwned(record,request,context,scratch,boot,pmic,touch,slowCycles,fastCycles,exclusive)
