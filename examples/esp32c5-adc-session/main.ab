import "../../src/esp32/adc_session_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_adc_session_example")
trusted fun example(record: NativeBuffer,calibration: C5AdcCalibration,source: int,hz: int,polls: int,exclusive: bool,coldSafe: bool,operation: int): int =
    if (operation == 0) c5AdcSessionOpenOwned(record,calibration,source,hz,exclusive,coldSafe)
    else if (operation == 1) c5AdcSessionStartAfterSettlingOwned(record,exclusive)
    else if (operation == 2) c5AdcSessionPollOwned(record,polls,exclusive)
    else if (operation == 3) c5AdcSessionCloseOwned(record,polls,exclusive)
    else if (operation == 4) c5AdcSessionRaw(record)
    else if (operation == 5) c5AdcSessionMillivolts(record) else 2
