import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3_write.ab"
import "../../src/storage/fat_allocate.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller holds volume gate across this call AND later chain/directory publish.
// Failure requires explicit inspection/recovery; success is not yet a file.
@export("abla_m5_sd_fat_allocate_example")
trusted fun reserve(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,start: int,
    candidates: int,reads: int,workspace: NativeBuffer): FatAllocation =
    fatAllocateClusterOwned(reader,boot,first,sectors,start,candidates,reads,workspace)
