import "../../src/display/ssd1677_power_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// action0powersave,1analog-on,2deep-sleep; this is NOT CPU sleep or rail off.
@export("abla_papermono_panel_power_example")
trusted fun power(session: Ssd1677Session,gate: PeripheralGate,owner: u32,action: int,polls: int,exclusive: bool): int =
    session.powerOwned(gate,owner,2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),action,polls,exclusive)|0
