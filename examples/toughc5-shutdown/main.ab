import "../../src/esp32/i2c_esp32c5.ab"
import "../../src/m5stack/toughc5_shutdown.ab"
import "abla/runtime/scalar"
import "abla/build"
// Explicit operation0 begin,1 poll/recheck,2 close. No sleep instruction.
@export("abla_toughc5_shutdown_example")
trusted fun shutdown(record: NativeBuffer,pmic: M5PmicOpen,touch: Chsc6540,now: u32,operation: int,exclusive: bool): int =
    if (!exclusive) 3 else if (operation == 0) toughC5ShutdownBeginOwned(record,pmic,touch|0,true)
    else if (operation == 1) toughC5ShutdownPollOwned(record,now)
    else if (operation == 2) toughC5ShutdownCloseOwned(record) else 3
