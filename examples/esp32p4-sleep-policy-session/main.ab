import "../../src/esp32/power/sleep_policy_session_esp32p4.ab"
@export("abla_esp32p4_sleep_policy_session_example")
trusted fun example(record: int,config: int,revision: int,pins: u32,levels: u32,pull: int,filter: bool,reject: u32,rejectEnabled: bool,minHp: int,protection: int,close: bool,exclusive: bool): int =
    if (close) esp32p4SleepPolicySessionCloseOwned(nativeBufferAt(record,388),exclusive)
    else esp32p4SleepPolicySessionOpenOwned(nativeBufferAt(record,388),nativeBufferAt(config,108),revision,pins,levels,pull,filter,reject,rejectEnabled,minHp,protection,exclusive)
