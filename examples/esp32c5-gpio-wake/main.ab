import "../../src/esp32/gpio/wake_esp32c5.ab"
import "abla/build"
@section(".iram1.abla.c5GpioWakeExample")
@export("abla_esp32c5_gpio_wake_example")
trusted fun wake(pin: int,high: bool,token: int,close: bool,exclusive: bool): int =
    if (close) C5GpioWake(token).closeOwned(exclusive)|0 else esp32C5GpioWakeOpenOwned(pin,high,exclusive)|0
