import "../../src/esp32/gdma_rx_channel_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_gdma_rx_channel_example")
trusted fun example(channel: int,previous: int,close: bool,exclusive: bool): int =
    if (close) C6GdmaRxChannel(previous).closeOwned(exclusive)|0 else c6GdmaRxChannelOpenOwned(channel,3,exclusive)|0
