import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/pmic_shutdown.ab"
import "../../src/m5stack/pm1_shutdown_retry_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable only. Exhaustion requires board wake fallback, not blind sleep.
@export("abla_m5_pm1_shutdown_retry_example")
trusted fun retry(pmic: M5PmicOpen,record: NativeBuffer,begin: bool,quiesced: bool,now: u32): int =
    if (begin) pmic.beginShutdownRetryOwned(record,quiesced) else m5Pm1ShutdownRetryPoll(record,now)
