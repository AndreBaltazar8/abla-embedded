import "../../src/esp32/spi/register_read_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Configured controller clock/pads, SPID shared-data route and GPIO CS/DC are
// caller-owned. On failure retain ownership for explicit controller recovery.
@export("abla_esp32s3_spi_register_read_example")
trusted fun run(gate: PeripheralGate,owner: u32,peripheral: int,clock: Pin,data: Pin,cs: Pin,dc: Pin,polls: int): SpiTransactionResult =
    esp32s3SpiReadRegister32Shared(gate,owner,peripheral,clock,data,cs,dc,4,1,polls)
