import "../../src/esp32/i2s/playback_session_esp32c6.ab"
import "abla/build"
// Prepared 16-bit stereo payload, caller-pinned PLL240 source1 and GPIO clocks,
// initialized FIFO/DMA, exclusively owned pad/routes. NOT a bootable image.
@export("abla_esp32c6_i2s_playback_session_example")
trusted fun example(r: NativeBuffer,channel: int,rateHz: int,dataPin: int,descriptors: int,count: int,buffers: int,stride: int,bytes: int,budget: int,polls: int,exclusive: bool,operation: int): int =
    if (operation == 0) c6PlaybackOpenOwned(r,channel,1,240000000,rateHz,0,100,-1,-1,dataPin,-1,16,16,16,false,descriptors,count,buffers,stride,bytes,polls,exclusive)
    else if (operation == 1) c6PlaybackPollOwned(r,budget,polls,exclusive)
    else if (operation == 2) c6PlaybackCloseOwned(r,polls,exclusive) else 2
