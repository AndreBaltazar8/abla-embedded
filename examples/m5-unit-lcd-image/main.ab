import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_lcd.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun unitLcdDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Complete135x240 raw16 image, stride270, scratch>=271B; rotation0 and known
// device byte-swap configuration. Exclusive transport/queue for entire call.
@export("abla_m5_unit_lcd_image_example")
trusted fun example(device: I2cDevice,source: NativeBuffer,scratch: NativeBuffer): int =
    device.unitLcdWrite16(0,0,135,240,0,source,270,scratch,16)
