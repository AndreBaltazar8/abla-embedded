import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_lcd.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun unitLcdDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Full-frame A8 coverage, explicit RGB565 wire color, RLE scratch>=271B.
@export("abla_m5_unit_lcd_alpha_example")
trusted fun example(device: I2cDevice,alpha: NativeBuffer,scratch: NativeBuffer,rawColor: int): int =
    device.unitLcdWriteAlpha(0,0,135,240,0,alpha,135,rawColor,2,scratch,16,true)
