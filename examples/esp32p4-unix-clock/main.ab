import "../../src/esp32/unix_time_esp32p4.ab"
import "../../src/m5stack/rtc_clock_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller has already enabled a stable timer and exclusively owns snapshots.
@export("abla_esp32p4_unix_clock_example")
trusted fun synchronize(value: RtcDateTime,ticksPerSecond: int,unit: int): int {
    if (!esp32P4ConfigureUnixClock(ticksPerSecond,64,unit) || !m5RtcSynchronizeClock(value)) return -1
    unixTimeSeconds()
}
