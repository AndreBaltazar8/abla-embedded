import "../../src/m5stack/corematrix_matrix_esp32c61.ab"
import "abla/build"
@export("abla_corematrix_matrix_example")
trusted fun example(control: M5CoreMatrixControl,storage: NativeBuffer): bool {
    val matrix=m5CoreMatrixMatrixAt(storage)
    if (!matrix.initializeFresh() || matrix.openOwned(control,true) != 1) return false
    return matrix.setPixel(7,7,true) && matrix.display()
}
