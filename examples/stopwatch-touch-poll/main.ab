import "../../src/m5stack/stopwatch_touch_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Borrowed live session and exclusive6-byte snapshot. Assign returned session,
// consume only fresh reports, then project contacts with stopWatchDisplayPoint.
@export("abla_stopwatch_touch_poll_example")
trusted fun poll(session: Cst816sSession,snapshot: NativeBuffer,now: int): int =
    session.pollStopWatchOwned(snapshot,now)|0
