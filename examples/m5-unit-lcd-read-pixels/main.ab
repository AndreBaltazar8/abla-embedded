import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_lcd_read_pixels.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun unitLcdDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Caller supplies full-frame wire-format storage and six scratch bytes.
@export("abla_m5_unit_lcd_read_pixels_example")
trusted fun example(device: I2cDevice,destination: NativeBuffer,scratch: NativeBuffer,pixelBytes: int): int =
    device.unitLcdReadPixels(0,0,135,240,0,destination,135*pixelBytes,pixelBytes,scratch,16)
