import "../../src/esp32/power/sleep_coordinator_recovery_esp32p4.ab"
@export("abla_esp32p4_sleep_coordinator_recovery_example")
trusted fun example(record: int,session: int,clocks: int,cpu: int,smp: int,route: int,generation: int,action: int,sourcesReady: bool,policyReady: bool,exclusive: bool,policy: int): int =
    if (action == 1) esp32p4SleepCoordinatorRecoveryOpenOwned(nativeBufferAt(record,64),nativeBufferAt(session,464),nativeBufferAt(clocks,288),nativeBufferAt(cpu,816),nativeBufferAt(smp,4),nativeBufferAt(route,24),generation,exclusive)
    else if (action == 2) esp32p4SleepCoordinatorAbortOpenOwned(nativeBufferAt(record,64),nativeBufferAt(session,464),nativeBufferAt(clocks,288),nativeBufferAt(cpu,816),nativeBufferAt(smp,4),nativeBufferAt(route,24),generation,exclusive)
    else if (action == 0) esp32p4SleepCoordinatorRecoveryContinueOwned(nativeBufferAt(record,64),32,32,sourcesReady,policyReady,exclusive)
    else if (action == 3) esp32p4SleepCoordinatorBindPolicyOwned(nativeBufferAt(record,64),nativeBufferAt(policy,388),exclusive)
    else 4
