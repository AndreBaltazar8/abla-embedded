import "../../src/esp32/i2c/stream_esp32p4.ab"
@export("abla_esp32p4_i2c_stream_example")
trusted fun transfer(port: i32,address: i32,output: NativeBuffer,written: i32,input: NativeBuffer,read: i32,budget: u32,prefix: i32,exclusive: bool): int =
    esp32p4I2cTransferOwned(int(port),int(address),output,int(written),input,int(read),budget,exclusive,int(prefix))
