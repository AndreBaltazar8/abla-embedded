import "../../src/esp32/power/sleep_quiesce_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_sleep_quiesce_example")
fun example(action: int,record: int,mailbox: int,channel: int,proof: bool): int {
    val r=nativeBufferAt(record,32)
    if (action == 0) return esp32S3SleepQuiesceOpenOwned(r,nativeBufferAt(mailbox,4),channel,proof)
    if (action == 1) return esp32S3SleepQuiescePollOwned(r)
    if (action == 2) return esp32S3SleepQuiesceCloseOwned(r,proof)
    return 3
}
