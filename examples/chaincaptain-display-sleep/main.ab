import "../../src/m5stack/chaincaptain_display_sleep_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Borrowed ready PM1 control, previously initialized panel, exclusively owned
// powered SPI2 and IOE/PWM. Display sleep only, not CPU or power-rail shutdown.
@export("abla_chaincaptain_display_sleep_example")
trusted fun displaySleep(control: M5Pm1Control,gate: PeripheralGate,owner: u32,
    sleeping: bool,brightness: int,exclusive: bool): int =
    control.setChainDisplaySleepOwned(gate,owner,sleeping,brightness,exclusive)|0
