import "../../src/esp32/adc_session_esp32p4.ab"
import "../../src/esp32/adc_fuse_esp32p4.ab"
// Caller supplies zero-magic128B record and hardware ownership prerequisites.
// Operation0 read efuse + open;1 start AFTER settling;2 poll;3 millivolts;
// 4 close (retry until9);5 raw. No board sensor power/source startup implied.
@export("abla_esp32p4_adc_session_example")
trusted fun sample(operation: i32,r: NativeBuffer,unit: i32,channel: i32,attenuation: i32,layout: i32,polls: i32,exclusive: bool,shadowsReady: bool): int {
    if (operation == i32(0)) {
        if (!exclusive || !p4AdcSessionRange(r)) return 2
        val c=esp32p4AdcReadCalibration(int(unit),int(channel),int(attenuation),shadowsReady)
        return esp32p4AdcSessionOpenOwned(r,c,int(layout),int(polls),true)
    }
    if (operation == i32(1)) return esp32p4AdcSessionStartAfterSettlingOwned(r,exclusive)
    if (operation == i32(2)) return esp32p4AdcSessionPollOwned(r,int(polls),exclusive)
    if (operation == i32(3)) return esp32p4AdcSessionMillivolts(r)
    if (operation == i32(4)) return esp32p4AdcSessionCloseOwned(r,int(polls),exclusive)
    if (operation == i32(5)) return esp32p4AdcSessionRaw(r)
    return 2
}
