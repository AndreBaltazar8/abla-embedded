import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_lcd.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun unitLcdDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Current device rotation0; destination >=64800B, scratch >=6B, disjoint.
// Caller keeps queue/bus exclusive. Trust output only on return1.
@export("abla_m5_unit_lcd_read_example")
trusted fun example(device: I2cDevice,destination: NativeBuffer,scratch: NativeBuffer): int =
    device.unitLcdRead16(0,0,135,240,0,destination,scratch,16)
