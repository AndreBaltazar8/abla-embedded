import "../../src/esp32/gpio_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/atom_s3_panel_probe.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns configured shared-data pins and reset/power; no auto retries.
// Unknown IDs do not identify absence: software timing may not suit the panel.
@export("abla_atom_s3_panel_id_example")
trusted fun run(board: M5BoardId,gate: PeripheralGate,owner: u32,halfPeriod: int): SpiTransactionResult =
    board.readAtomPanelIdChecked(gate,owner,halfPeriod)
