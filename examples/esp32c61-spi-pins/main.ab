import "../../src/esp32/spi/pins_esp32c61.ab"
import "abla/build"
@export("abla_esp32c61_spi_pins_example")
trusted fun example(owner: Esp32C61SpiPins,pins: SpiPins,cs: int,opening: bool,exclusive: bool): Esp32C61SpiPins =
    if (opening) esp32C61SpiPinsOpenOwned(pins,cs,exclusive) else owner.closeOwned(exclusive)
