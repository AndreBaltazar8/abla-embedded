import "../../src/esp32/gpio/wake_session_esp32c5.ab"
import "abla/build"
@section(".iram1.abla.c5GpioSessionExample")
@export("abla_esp32c5_gpio_wake_session_example")
trusted fun wake(record: NativeBuffer,pin: int,high: bool,action: int,exclusive: bool): int {
    if (action == 0) return esp32C5GpioWakeSessionOpenOwned(record,pin,high,exclusive)
    if (action == 1) return esp32C5GpioWakeSessionArmOwned(record,exclusive)
    if (action == 2) return esp32C5GpioWakeSessionCloseOwned(record,exclusive)
    return 2
}
