import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/pmic_voltage.ab"
import "abla/runtime/scalar"
import "abla/build"
// Read-only battery ADC on an already-opened AXP192/AXP2101. Decode status
// before millivolts. No presence inference, rail writes or ADC configuration.
@export("abla_pmic_battery_voltage_example")
trusted fun example(pmic: M5PmicOpen,exclusive: bool): int = pmic.readBatteryMillivoltsOwned(exclusive)|0
