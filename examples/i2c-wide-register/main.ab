import "../../src/esp32/i2c_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns the bound device and its register protocol. No automatic retry;
// a failed multi-byte write can have changed a prefix of registers.
@export("abla_i2c_wide_register_example")
trusted fun example(device: I2cDevice,register: int,value: int,operation: int): int {
    if (operation == 0) return device.readRegister24LittleEndianChecked(register)|0
    if (operation == 1) return if (device.writeRegister24BigEndian(register,value)) 1 else 0
    if (operation == 2) return if (device.writeRegister24LittleEndian(register,value)) 1 else 0
    if (operation == 3) return if (device.writeRegister32BigEndian(register,value)) 1 else 0
    if (operation == 4) return if (device.writeRegister32LittleEndian(register,value)) 1 else 0
    return 0
}
