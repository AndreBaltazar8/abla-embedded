import "../../src/esp32/ahb_gdma_rearm_esp32p4.ab"
@export("abla_esp32p4_ahb_gdma_rearm_example")
trusted fun rearm(descriptors: u32,count: i32,buffers: u32,stride: i32,bytes: i32,
    index: i32,transmit: bool,circular: bool,polls: i32,exclusive: bool): i32 {
    i32(esp32p4AhbGdmaRearmBlockOwned(int(descriptors),int(count),int(buffers),int(stride),int(bytes),int(index),transmit,circular,int(polls),exclusive))
}
