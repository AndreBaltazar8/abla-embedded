import "../../src/esp32/abla_host_esp_idf.ab"
import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/esp32/serial_esp32s3.ab"
import "../../src/led/m5pm1.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // M5StickS3 internal I2C: SDA 47, SCL 48. This firmware is board-specific;
    // do not flash it to an Atom Echo or another product with different pins.
    val bus = i2cMaster(0, 47, 48, u32(40000000), u32(160000000))
    val power = m5Pm1(bus)
    if (power.begin()) {
        val led = m5Pm1Led(power, 1, 1)
        if (led.begin()) {
            led.setAutoDisplay(false)
            led.setColor(0, rgbColor(0, 16, 0))
            led.display()
            peripheralDelayMilliseconds(250)
            led.setAllColor(rgbColor(0, 0, 0))
            led.display()
            log.line("M5PM1 LED exercised")
        }
    }
    power.close()
    bus.close()
    return
}
