import "../../src/esp32/i2s/pin_session_esp32p4.ab"
// Callable only: caller supplies exclusive aligned64B record, pins, stopped
// peripheral/DMA users, clocks and released holds. Zero magic for new record.
@export("abla_esp32p4_i2s_pin_session_example")
trusted fun pins(address: i32,close: bool,port: i32,tx: bool,mclk: i32,bclk: i32,
    ws: i32,data: i32,flags: i32,layout: i32,exclusive: bool): i32 {
    val r=nativeBufferAt(int(u32(address)),64)
    if (close) return i32(esp32p4I2sPinsCloseOwned(r,exclusive))
    return i32(esp32p4I2sPinsOpenOwned(r,int(port),tx,int(mclk),int(bclk),int(ws),int(data),int(flags),int(layout),exclusive))
}
