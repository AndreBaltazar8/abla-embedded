import "../../src/display/epd_canvas_clip.ab"
import "../../src/display/epd_canvas_submit_logical.ab"
import "abla/build"
// Separate draw/queue operations: submission never implies physical refresh.
@export("abla_paper_s3_epd_logical_update_example")
fun example(action: int,canvas: NativeBuffer,state: NativeBuffer,x: int,y: int,w: int,h: int,rotation: int,source: NativeBuffer,stride: int,fill: int,mode: int,exclusive: bool): bool {
    if (action == 0) return epdCanvasDrawClippedOwned(canvas,960,540,x,y,w,h,rotation,source,stride,fill,mode,exclusive)
    if (action == 1) return epdCanvasSubmitLogicalOwned(canvas,state,960,540,x,y,w,h,rotation,mode,exclusive)
    return false
}
