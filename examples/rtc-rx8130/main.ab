import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/rtc/rx8130.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // M5Stack Atom family Grove Port A: SDA26, SCL32.
    val bus = i2cMaster(1, 26, 32)
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }
    val rtc = rx8130(bus)
    if (!rtc.begin()) log.line("RX8130 initialization failed")
    else if (rtc.dateTime().valid()) log.line("RX8130 date/time is valid")
    else log.line("RX8130 date/time is invalid")
    rtc.close()
    bus.close()
    return
}
