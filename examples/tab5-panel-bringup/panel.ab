import "../tab5-control-bringup/control.ab"
import "../../src/esp32/boot/internal_entry_esp32p4.ab"
import "../../src/esp32/serial_esp32p4.ab"
// Adds full detected-panel command initialization to the control-plane image.
// Same cold Tab5 prerequisites as control.ab, PLUS boot/platform-owned stable
// SPLL480MHz and40MHz XTAL held for the whole display lifetime. Verifies the
// F20M divider24; does not infer PLL lock/frequency from a digital gate.
// Layout1 PHY reference=PLL20M; layout3 PHY reference=XTAL40M/div1. Both use
// PLL20M configuration clock. Board touch evidence chooses900/1040Mbps lane
// and ST7121/ST7123/ILI9881C program. No framebuffer/PSRAM/video yet.
// Phase0..4 control failure,6clock preflight,7storage,8panel failure,9ready.
// Leaves complete session/child ownership in place until watchdog/user reset;
// no partial retry, blind watchdog feeding or forced-success continuation.
val panelStorage=nativeStaticAllocate(40)
val referenceStorage=nativeStaticAllocate(4)
trusted fun tab5PanelBringup(): int {
    val control=tab5ControlBringup()
    if (control != 5) return control
    if (esp32P4Reference20mDivider() != 24) return 6
    val session=tab5BoardSessionAt(nativeBufferAt(sessionStorage,40))
    val panel=tab5DsiOwnerAt(nativeBufferAt(panelStorage,40))
    val reference=nativeBufferAt(referenceStorage,4)
    if (!panel.initialize()) return 7
    reference.storeU32(0,esp32P4ReferenceClockOwner(20)|0)
    val khz=if (session.layout() == 1) 20000 else 40000
    val result=session.openPanelOwned(nativeBufferAt(panelStorage,40),reference,nativeBufferAt(scratchStorage,32),
        0,0,1,khz,0,100000,1000)
    return if (result == 1 && panel.panelReady()) 9 else 8
}
trusted fun tab5PanelPrintReport(phase: int): void {
    val port=serial(0)
    if (!port.tryWriteByte(48+phase,100000)) return
    if (!port.tryWriteByte(10,100000)) return
    port.tryFlush(100000)
    return
}
