import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/power/aw32001.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // Arduino Nesso N1 internal I2C: SDA 8, SCL 10. begin() only verifies the
    // chip and disables its charger watchdog; charge settings are read back.
    val bus = i2cMaster(0, 8, 10)
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }
    val charger = aw32001(bus)
    if (charger.begin()) {
        charger.chargeCurrentMilliamps()
        charger.chargeVoltageMillivolts()
        charger.chargeStatus()
        charger.charging()
        log.line("AW32001 detected and sampled")
    } else log.line("AW32001 not detected")
    charger.close()
    bus.close()
    return
}
