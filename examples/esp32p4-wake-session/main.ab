import "../../src/esp32/power/wake_session_esp32p4.ab"
// Callable integration only; powered PMU/LP domains, released holds and
// exclusive former pad users are prerequisites. This does not enter sleep.
@export("abla_esp32p4_wake_session_example")
trusted fun example(address: int,capacity: int,selection: u32,highLevels: u32,pull: int,
    filter: bool,layout: int,close: bool,exclusive: bool): int {
    val r=nativeBufferAt(address,capacity)
    if (close) return esp32p4WakeSessionCloseOwned(r,exclusive)
    return esp32p4WakeSessionOpenOwned(r,selection,highLevels,pull,filter,layout,exclusive)
}
