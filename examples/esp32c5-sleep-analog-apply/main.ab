import "../../src/esp32/power/sleep_analog_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32c5_sleep_analog_apply_example")
trusted fun analog(record: NativeBuffer,plan: NativeBuffer,pvtBias: int,close: bool,exclusive: bool): int =
    if (close) esp32C5SleepAnalogCloseOwned(record,exclusive) else esp32C5SleepAnalogApplyOwned(record,plan,exclusive,pvtBias)
