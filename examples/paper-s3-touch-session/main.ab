import "../../src/m5stack/paper_s3_touch_session.ab"
import "abla/build"
@export("abla_paper_s3_touch_session_example")
fun example(record: int,xtal: int,cpu: int,address: int,close: bool,exclusive: bool): int {
    val r=nativeBufferAt(record,48)
    return if (close) paperS3TouchSessionCloseOwned(r,exclusive) else paperS3TouchSessionOpenOwned(r,xtal,cpu,address,exclusive)
}
