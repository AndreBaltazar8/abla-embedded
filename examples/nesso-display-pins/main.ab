import "../../src/esp32/spi_software_esp32c6.ab"
import "../../src/display/software_pins_checked.ab"
import "../../src/m5stack/display_map.ab"
import "abla/build"
// Callable only: caller owns stable GPIO clocks and Nesso's LCD SPI pads,
// quiescent panel/reset and canonical gate. Does not initialize E1 or panel.
@export("abla_nesso_display_pins_example")
trusted fun example(gate: PeripheralGate,owner: u32,recover: bool,exclusive: bool): int {
    val p=m5BoardArduinoNessoN1.displaySpiPins()
    if (recover) return if (softwareLcdRecoverPinsChecked(gate,owner,Pin(p.clock()),Pin(p.mosi()),Pin(p.chipSelect()),Pin(p.dataCommand()),false,exclusive)) 1 else 0
    return softwareLcdConfigurePinsChecked(gate,owner,Pin(p.clock()),Pin(p.mosi()),Pin(p.chipSelect()),Pin(p.dataCommand()),false,exclusive)|0
}
