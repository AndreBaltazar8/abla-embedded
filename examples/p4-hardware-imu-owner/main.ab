import "../../src/m5stack/control_bus_hardware_esp32p4.ab"
import "../../src/esp32/i2c/hardware_prepared_scan_esp32p4.ab"
import "../../src/esp32/imu_delay_1khz_esp32p4.ab"
import "../../src/m5stack/imu_owner_prepared.ab"
import "../../src/m5stack/imu_owner_update.ab"
import "abla/runtime/scalar"
// Fresh owner36B, snapshot44B, scratch20B, retained bus96B; disjoint owned
// storage. Discovery requires powered sensors, calibrated delay and exclusive
// physical single-master scan interval. Close owner before bus, including
// failed opens. This callable composition is not boot/flash firmware.
@export("abla_p4_hardware_imu_owner_example")
trusted fun example(action: int,record: int,board: int,layout: int,cpuHz: u32,ownerAddress: int,snapshotAddress: int,scratch: int,micros: int): int {
    val r=nativeBufferAt(record,96)
    val owner=m5ImuOwnerAt(nativeBufferAt(ownerAddress,36))
    val snapshot=imuSnapshotAt(nativeBufferAt(snapshotAddress,44))
    if (action == 0) return m5P4HardwareControlOpenOwned(r,M5BoardId(board),0,layout,u32(40000000),cpuHz,true)
    if (action == 1) return if (owner.initialize() && snapshot.initialize()) 1 else 0
    if (action == 2) return owner.openPrepared(m5P4HardwareControlDeviceBus(r))
    if (action == 3) return owner.updateSnapshot(snapshot,nativeBufferAt(scratch,20),micros)|0
    if (action == 4) return if (owner.close()) 1 else 0
    if (action == 5) return m5P4HardwareControlCloseOwned(r,true)
    return -1
}
