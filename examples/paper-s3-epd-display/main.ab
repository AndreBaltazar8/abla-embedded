import "../../src/display/epd_display_sequence.ab"
import "../../src/display/epd_gate_pins_esp32s3.ab"
import "../../src/m5stack/paper_s3_epd_transport.ab"
import "../../src/m5stack/paper_s3_epd.ab"
import "abla/build"
// Caller supplies312B owner,76B config,1036800B state,259200B canvas,
// internal12B descriptor and248B payload; PSRAM/PLL/pads already accessible.
@export("abla_paper_s3_epd_display_example")
fun example(action: int,r: NativeBuffer,config: NativeBuffer,state: NativeBuffer,canvas: NativeBuffer,descriptors: NativeBuffer,payload: NativeBuffer,channel: int,owner: int,polls: int,nowMs: int,exclusive: bool): int {
    if (action == 0) return if (exclusive && paperS3EpdTransportConfig(config)) 1 else 3
    if (action == 1) return epdDisplayOpenOwned(r,config,state,canvas,descriptors,payload,paperS3EpdGatePins(),960,540,8,channel,owner,polls,exclusive)
    if (action == 2) return epdDisplayStartOwned(r,state,exclusive)
    if (action == 3) return epdDisplayPumpOwned(r,state,nowMs,exclusive)
    if (action == 4) return epdDisplayCloseOwned(r,state,exclusive)
    return 3
}
