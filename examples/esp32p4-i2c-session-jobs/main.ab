import "../../src/esp32/i2c/session_jobs_p4.ab"
import "../../src/esp32/i2c/poll_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable only. Supply a ready exclusively owned72B session and immutable
// phase table. A failed batch retains all resources for explicit recovery.
@export("abla_esp32p4_i2c_session_jobs_example")
trusted fun run(session: int,address: int,count: int,budget: u32): int =
    esp32p4I2cSessionJobsOwned(nativeBufferAt(session,72),nativeBufferAt(address,count*16),count,budget,true)
