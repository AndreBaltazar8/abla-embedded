import "../../src/m5stack/stopwatch_canvas_dirty_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Initialize shadow then rgb565DirtyOpenOwned, draw through rgb565DirtyFillOwned.
// Retain record/canvas and recover controller explicitly after failed flush.
@export("abla_stopwatch_canvas_dirty_example")
trusted fun flush(record: NativeBuffer,canvas: NativeBuffer,gate: PeripheralGate,
    owner: u32,rotation: int,exclusive: bool): int =
    stopWatchCanvasDirtyFlushOwned(record,canvas,gate,owner,rotation,exclusive)|0
