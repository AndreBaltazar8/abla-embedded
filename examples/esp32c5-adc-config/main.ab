import "../../src/esp32/adc_config_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_adc_config_example")
trusted fun example(owner: C5AdcController,channel: int,attenuation: int,exclusiveStopped: bool,close: bool): C5AdcController =
    if (close) owner.closeOwned(exclusiveStopped) else c5AdcControllerOpenOwned(channel,attenuation,exclusiveStopped)
