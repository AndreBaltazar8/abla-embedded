import "../../src/esp32/i2s/stream_tx_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_stream_tx_example")
trusted fun example(start: NativeBuffer,cursor: NativeBuffer,prepared: bool,exclusive: bool,publish: bool): int =
    if (publish) c6I2sStreamPublishOwned(start,cursor,prepared,exclusive) else c6I2sStreamAcquireOwned(start,cursor,exclusive)
