import "../../src/m5stack/papermono_frontlight_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Own sharedPM1PWM frequency domain for setup; laterupdates onlychangePWM0.
@export("abla_papermono_frontlight_example")
trusted fun light(control: M5Pm1Control,level: int,initialize: bool,exclusive: bool): int =
    if (initialize) control.preparePaperMonoFrontlightOwned(level,exclusive) else control.paperMonoFrontlightOwned(level,exclusive)
