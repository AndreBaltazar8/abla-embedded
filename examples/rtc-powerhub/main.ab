import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/rtc/powerhub.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    val bus = i2cMaster(1, 26, 32)
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }
    val rtc = powerHubRtc(bus)
    if (!rtc.begin()) log.line("PowerHub RTC initialization failed")
    else if (rtc.dateTime().valid()) log.line("PowerHub date/time is valid")
    else log.line("PowerHub date/time is invalid")
    rtc.close()
    bus.close()
    return
}
