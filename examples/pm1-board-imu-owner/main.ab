import "../../src/m5stack/pm1_imu_owner_esp32s3.ab"
import "../../src/esp32/imu_delay_1khz_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Initialized76B parent and36B child; parent already configured. This callable
// never resets the board. Keep bus and buffers alive until close succeeds.
@export("abla_pm1_board_imu_owner_example")
trusted fun example(control: M5Pm1Control,imu: M5ImuOwner,close: bool,exclusive: bool): int =
    if (close) (if (control.closeRetainedImuOwned(imu,exclusive)) 0 else 4)
    else control.openRetainedImuPreparedOwned(imu,exclusive)
