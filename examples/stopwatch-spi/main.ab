import "../../src/m5stack/stopwatch_spi_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Fresh stopped owned controller/pads/PLL80M; not complete board startup.
@export("abla_stopwatch_spi_example")
trusted fun initialize(gate: PeripheralGate,owner: u32,exclusive: bool): int =
    stopWatchSpiInitializeOwned(gate,owner,exclusive)|0
