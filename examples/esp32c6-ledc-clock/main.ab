import "../../src/esp32/ledc_clock_esp32c6.ab"
import "abla/build"
// Whole LEDC peripheral exclusive/stopped, source already selected/pinned.
// Return must replace owner. Not a boot image; no GPIO or timer setup.
@export("abla_esp32c6_ledc_clock_example")
trusted fun example(owner: C6LedcClockOwner,source: int,open: bool,exclusiveStopped: bool): C6LedcClockOwner =
    if (open && owner == 0) c6LedcClockOpenOwned(source,exclusiveStopped) else if (!open) owner.closeOwned(exclusiveStopped) else owner
