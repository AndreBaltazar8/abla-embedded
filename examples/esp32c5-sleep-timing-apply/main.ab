import "../../src/esp32/power/sleep_timing_apply_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32c5_sleep_timing_apply_example")
trusted fun apply(record: NativeBuffer,plan: NativeBuffer,inrush: bool,close: bool,exclusive: bool,modemCycles: int): int =
    if (close) esp32C5SleepTimingCloseOwned(record,exclusive) else esp32C5SleepTimingApplyOwned(record,plan,inrush,exclusive,modemCycles)
