import "../../src/esp32/psram/command_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_psram_command_example")
@section(".iram1.abla.s3PsramCommandExample")
fun example(command: int,address: int,dummy: int,payload: NativeBuffer,length: int,work: NativeBuffer,exclusiveInternal: bool): int {
    if (!exclusiveInternal) return 2
    return s3PsramCommandOwned(command,address,dummy,payload,length,work)
}
