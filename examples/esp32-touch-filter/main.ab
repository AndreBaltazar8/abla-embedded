import "../../src/esp32/touch/filter_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable classic ESP32 object, not a boot image. Use after touch-scan
// completion under the same controller lease. Start history at0, then assign
// history=history.updateFrom(scan,channel,threshold). Schedule fresh samples
// explicitly; this creates no timer, interrupt, allocation or wait loop.
@export("abla_esp32_touch_filter_example")
trusted fun update(history: CapacitiveTouchFilter,scan: Esp32TouchScan,channel: int,threshold: int,below: bool): CapacitiveTouchFilter = history.updateFrom(scan,channel,threshold,below)
