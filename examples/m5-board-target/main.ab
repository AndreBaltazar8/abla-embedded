import "../../src/m5stack/board_target.ab"
import "abla/runtime/scalar"
import "abla/build"
// Explicit C61 selection gate, before any board-specific peripheral setup.
@export("abla_m5_board_target_example")
fun example(observed: M5BoardId,fallback: M5BoardId): M5BoardId =
    m5SelectBoardForTarget(observed,fallback,m5TargetEsp32C61)
