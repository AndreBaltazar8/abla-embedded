import "../../src/esp32/spi_software_esp32c61.ab"
import "../../src/display/gc9a01_software.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns powered/reset panel, configured pads and canonical gate.
// Callable only, not firmware. Leave backlight disabled until success.
@export("abla_gc9a01_software_example")
trusted fun run(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,cs: Pin,dc: Pin,rotation: int): SpiTransactionResult {
    val started=gc9a01BeginChecked(gate,owner,clock,mosi,cs,dc,rotation)
    if (!started.valid()) return started
    return gc9a01FillRectChecked(gate,owner,clock,mosi,cs,dc,rotation,0,0,240,240,rgb565(0,0,255))
}
