import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/codec_record_window_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Started ES8311/PaperColor capture, output disjoint from entire DMA ring.
// Completes a bounded raw recording then closes; retry close if session3.
@export("abla_board_codec_record_window_example")
trusted fun record(r: NativeBuffer,output: NativeBuffer,blocks: int,maxIdle: int,exclusive: bool): int =
    m5CodecRecordWindowOwned(r,output,blocks,maxIdle,exclusive)|0
