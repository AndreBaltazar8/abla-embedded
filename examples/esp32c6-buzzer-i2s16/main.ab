import "../../src/audio/buzzer_i2s16.ab"
import "abla/build"
import "../../src/esp32/sdk/raw_buffer.ab"
import "../../src/audio/buzzer_delta_sigma.ab"
import "../../src/esp32/sdk/nativebuffer_type.ab"
@export("abla_esp32c6_buzzer_i2s16_example")
trusted fun example(source: NativeBuffer,destination: NativeBuffer,samples: int,remainder: int): int = BuzzerDeltaSigma(remainder).encodePcm16Stereo16(source,destination,samples)|0
