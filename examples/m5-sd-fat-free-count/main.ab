import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3.ab"
import "../../src/storage/fat_free_scan.ab"
import "abla/runtime/scalar"
import "abla/build"
// Hold the same volume ownership across all batches for a consistent count.
// Count output is four bytes; workspace is 1024 bytes. No writes to media.
@export("abla_m5_sd_fat_free_count_example")
trusted fun count(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,start: int,
    candidates: int,reads: int,workspace: NativeBuffer,output: NativeBuffer): FatFreeScan =
    fatCountFreeOwned(reader,boot,first,sectors,start,candidates,reads,workspace,output)
