import "../../src/esp32/power/sleep_recovery_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5SleepRecoveryExample")
@export("abla_esp32c5_sleep_recovery_example")
trusted fun recover(record: NativeBuffer,profile: NativeBuffer,alarmAddress: int,plan: C5CpuClock,pvt: bool,result: int,flashDown: bool,startupUs: int,cache: int,uarts: int,resume: bool,exclusive: bool,entryAddress: int,timeAddress: int): int =
    if (resume) esp32C5SleepRecoveryContinueOwned(record,exclusive) else esp32C5SleepRecoveryBeginOwned(record,profile,alarmAddress,plan,pvt,result,flashDown,startupUs,cache,uarts,exclusive,entryAddress,timeAddress)
