import "../../src/esp32/i2s/rate_plan_c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_rate_plan_example")
fun example(rootHz: int,rateHz: int,frameBits: int,fixedBclk: int,maxPpm: int): int {
    val plan=c6I2sRatePlan(rootHz,rateHz,frameBits,fixedBclk)
    return if (plan.withinPpm(rootHz,rateHz,frameBits,maxPpm)) plan|0 else -1
}
