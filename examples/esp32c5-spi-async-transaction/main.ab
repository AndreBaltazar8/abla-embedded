import "../../src/esp32/spi/async_transaction_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Fresh64B context (op0), begin on configured master (op1), poll (op2).
// All SPI2 clients use the same gate; caller keeps master/pads/clocks alive.
// Pending is0. Only valid() makes RX final. Failures require explicit recover
// after externally observing/completing the transfer, never an implicit reset.
@export("abla_esp32c5_spi_async_transaction_example")
trusted fun example(master: Esp32C5SpiMaster,context: NativeBuffer,gate: PeripheralGate,owner: u32,
    tx: NativeBuffer,rx: NativeBuffer,bytes: int,now: u32,budget: u32,operation: int): int {
    if (operation == 0) return if (esp32C5SpiAsyncTransactionInitialize(context)) 0 else 3<<32
    if (operation == 1) return master.beginTransferAsync(context,gate,owner,tx,rx,bytes,now,budget)|0
    if (operation == 2) return esp32C5SpiAsyncTransactionPoll(context,now)|0
    return 3<<32
}
