import "../../src/esp32/gpio_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/cores3_spi.ab"
import "../../src/sd/software_register.ab"
import "abla/runtime/scalar"
import "abla/build"

// Read-only callable CoreS3/SE example, not an ESP boot image. Startup must
// configure/settle board power and ROM delay calibration, then exclusively
// hand over SPI pads3,4,35,36,37 and the canonical physical bus gate. Do not
// invoke during display traffic. No I2C/rail changes and no card writes.
// Caller supplies a writable512-byte buffer and initialized gate storage.
// Success returns the card's sector count (up to2^32), with requested sector
// bytes in the buffer. Negative result: -1 invalid, -(100+status) pin setup,
// -(200+status) card init, -(300+status) CSD read, -400 CSD/capacity,
// -401 sector outside card, -(500+status) sector read. Buffer is untrusted
// on failure. Gate/CS are released by each operation; pads remain configured.
trusted fun cores3SdReadExample(gateAddress: u32, bufferAddress: u32, block: u32): int {
    val gate = peripheralGateAt(int(gateAddress))
    val buffer = nativeBufferAt(int(bufferAddress), 512)
    if (!buffer.hasAddressRange(0, 512)) return -1
    val pins = m5BoardStackCoreS3.configureCoreS3SpiPins(gate, u32(7))
    if (!pins.valid()) return -100 - pins.status()
    val card = softwareSdInitialize(gate, u32(7), Pin(36), Pin(37), Pin(35), Pin(4), buffer)
    if (!card.valid()) return -200 - card.status()
    val csd = softwareSdReadRegister(gate, u32(7), Pin(36), Pin(37), Pin(35), Pin(4), card, 9, buffer)
    if (!csd.valid()) return -300 - csd.status()
    val blocks = sdCsdBlockCount(buffer)
    if (blocks == 0) return -400
    if (!sdCardContainsBlocks(blocks, int(block), 1)) return -401
    val read = softwareSdReadBlock(gate, u32(7), Pin(36), Pin(37), Pin(35), Pin(4), card, int(block), buffer)
    if (!read.valid()) return -500 - read.status()
    blocks
}
#exportFunction("cores3SdReadExample", "abla_cores3_sd_read_example")
