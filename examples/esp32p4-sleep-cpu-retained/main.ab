import "../../src/esp32/power/sleep_cpu_retained_esp32p4.ab"
@export("abla_esp32p4_sleep_cpu_retained_example")
trusted fun example(record: int,callback: int,context: u32,revision: int,operation: int,exclusive: bool): int =
    if (operation == 0) esp32p4CpuRetainedOpenOwned(nativeBufferAt(record,816),revision,exclusive)
    else if (operation == 1) esp32p4CpuRetainedContinueOwned(nativeBufferAt(record,816),exclusive)
    else if (operation == 2) esp32p4CpuRetainedInvokeOwned(nativeBufferAt(record,816),callback,context,exclusive)
    else if (operation == 3) esp32p4CpuRetainedCloseOwned(nativeBufferAt(record,816),exclusive)
    else if (operation == 4) esp32p4SleepCoreWakeAddress()
    else 2
