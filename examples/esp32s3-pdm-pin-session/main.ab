import "../../src/esp32/i2s/pdm_pin_session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
//56B fresh-zero/released record. Own stopped old/new GPIO/input consumers and
// I2S0/GDMA; RTC/USB/holds/sleep released. op0capture,1route,2restore afterstop.
@export("abla_esp32s3_pdm_pin_session_example")
trusted fun pins(operation: int,r: NativeBuffer,profile: PdmPins,slots: int,slave: bool,inverted: bool,exclusive: bool): int {
    if (operation == 0) return esp32s3PdmPinsCaptureOwned(r,profile,slots,slave,exclusive)
    if (operation == 1) return esp32s3PdmPinsOpenOwned(r,profile,slots,slave,inverted,exclusive)
    if (operation == 2) return esp32s3PdmPinsCloseOwned(r,exclusive)
    return 0
}
