import "../../src/esp32/gpio_clock_esp32c61.ab"
import "abla/build"
// Preserve returned owner through every failure. Close only after all child
// pads/buses are released; source startup and LP clocks are separate work.
@export("abla_esp32c61_gpio_clock_example")
fun example(close: bool,owner: Esp32C61GpioClock,exclusive: bool): Esp32C61GpioClock =
    if (close) owner.closeOwned(exclusive) else esp32C61GpioClockOpenOwned(exclusive)
