import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/rtc_timer_sleep_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable integration, NOT a boot image. PaperColor/PaperMono/StampPLC only.
// Clock owner first fills config64 via m5RtcSleepConfigWrite using measured
// bias/period, actual cache tag plans and initialized MSPI protocol values.
// Caller opens native-S3 board RTC/PM1, powers their rails, configures the
// low-active IRQ input, reserves its timer and quiesces peers/interrupts,
// radio and peripheral clients. Passing exclusive=true asserts all of that.
// Provide separate retained internal buffers: sleep128, wake176 (both fresh
// zero headers), CPU8800 and tags sized by esp32S3TagBufferBytes (both16-align),
// config64 and report72. Keep stack/closure in internal memory/IRAM too.
// This can disconnect USB Serial/JTAG and enter sleep. Do not invoke from an
// ordinary running application or with guessed clock/power calibration.
// Status5: keep quiescence and all buffers, inspect report stage/subresults,
// retry cancellation/finish or perform indicated manual recovery; NEVER
// blindly call this entry again. It does not infer that a power request cut
// supply, and no physical sleep/wake has been validated by object compilation.
@export("abla_esp32s3_rtc_timer_sleep_example")
@section(".iram1.abla.s3RtcTimerSleepExample")
trusted fun timerSleep(board: M5BoardId,rtc: M5Rtc,pmic: M5Pm1,sleep: NativeBuffer,wake: NativeBuffer,cpu: NativeBuffer,tags: NativeBuffer,config: NativeBuffer,report: NativeBuffer,exclusive: bool): int =
    m5RtcTimerSleepS3Owned(board,rtc | 0,pmic | 0,sleep,wake,cpu,tags,config,report,exclusive)
