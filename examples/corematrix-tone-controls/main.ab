import "../../src/m5stack/corematrix_control_esp32c61.ab"
import "../../src/m5stack/corematrix_tone_controls.ab"
import "abla/runtime/scalar"
import "abla/build"
// Fresh initialized owner; pollOwned remains required between control calls.
@export("abla_corematrix_tone_controls_example")
trusted fun example(tone: M5CoreMatrixTone,control: M5CoreMatrixControl,frequency: int,volume: int,now: int,replace: bool): int =
    tone.playOwned(control,frequency,volume,now,100,replace,true)
