import "../../src/sd/selected_read_esp32c61.ab"
import "abla/build"
// Card already initialized; caller owns gate/selected CS and buffers.
@export("abla_esp32c61_sd_read_example")
trusted fun example(master: Esp32C61SpiMaster,highCapacity: bool,block: int,
    scratch: NativeBuffer,destination: NativeBuffer): SdSpiReadResult =
    sdSpiReadBlockSelected(master|0,highCapacity,block,scratch,destination)
