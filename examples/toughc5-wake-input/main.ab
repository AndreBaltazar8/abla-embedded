import "../../src/m5stack/tough_wake_sequence.ab"
import "../../src/esp32/gpio/c5_wake.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns GPIO4, has released global holds and completed board peripheral
// initialization. Status6 retains a held/partial finalizer for an explicit retry.
@export("abla_toughc5_wake_input_example")
trusted fun input(prior: M5ToughBoot,exclusive: bool): int =
    if (exclusive) prior.finishC5WakeInputOwned()|0 else prior|0
