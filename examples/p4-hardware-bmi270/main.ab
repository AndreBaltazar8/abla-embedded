import "../../src/m5stack/control_bus_hardware_esp32p4.ab"
import "../../src/esp32/imu_delay_1khz_esp32p4.ab"
import "../../src/imu/bmi270_device.ab"
import "abla/runtime/scalar"
// Dedicated known BMI270 address0x69; not automatic IMU detection. Caller
// supplies board power/reset and calibrated ROM delay, retains bus record,
// device handle and20B frame; decode only channels marked fresh by readFrame.
@export("abla_p4_hardware_bmi270_example")
trusted fun example(action: int,record: int,board: int,layout: int,cpuHz: u32,handle: int,frame: int): int {
    val r=nativeBufferAt(record,96)
    if (action == 0) return m5P4HardwareControlOpenOwned(r,M5BoardId(board),0,layout,u32(40000000),cpuHz,true)
    if (action == 1) return bmi270(m5P4HardwareControlDeviceBus(r))|0
    if (action == 2) return Bmi270(handle).begin()
    if (action == 3) return Bmi270(handle).readFrame(nativeBufferAt(frame,20))
    if (action == 4) return if (Bmi270(handle).close()) 1 else 0
    if (action == 5) return m5P4HardwareControlCloseOwned(r,true)
    return -1
}
