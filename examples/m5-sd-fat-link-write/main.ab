// Mounted exclusively managed volume; raw allocation building block only.
@export("abla_m5_sd_fat_link_write_example")
trusted fun replace(volume: FatVolume,owner: u32,cluster: int,expected: int,replacement: int,workspace: NativeBuffer): FatLinkWrite =
