import "../../src/esp32/power/sleep_core_esp32p4.ab"
@export("abla_esp32p4_sleep_core_example")
trusted fun example(record: u32,callback: u32,context: u32,revision: u32,invoke: u32,exclusive: u32): u32 =
    if (invoke != u32(0)) u32(esp32p4SleepCoreInvokeOwned(nativeBufferAt(int(record),144),int(callback),context,int(revision),exclusive != u32(0)))
    else u32(esp32p4SleepCoreWakeAddress())
