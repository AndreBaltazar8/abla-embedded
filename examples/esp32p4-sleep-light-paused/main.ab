import "../../src/esp32/power/sleep_light_esp32p4.ab"
// operation0 start,1 observe wake without releasing memory,2 explicitly
// release after external recovery,3 cleanup a pre-request aborted attempt.
@export("abla_esp32p4_sleep_light_paused_example")
trusted fun example(address: int,operation: int,revision: int,regdmaBackup: bool,mhz: int,xtalMHz: int,polls: int,eventPolls: int,exclusive: bool): int {
    val r=nativeBufferAt(address,64)
    if (operation == 0) return esp32p4SleepLightStartPausedOwned(r,revision,regdmaBackup,mhz,xtalMHz,polls,eventPolls,exclusive)
    if (operation == 1) return esp32p4SleepLightAwaitRecoveryOwned(r,polls,exclusive)
    if (operation == 2) return esp32p4SleepLightReleaseRecoveryOwned(r,polls,exclusive)
    if (operation == 3) return esp32p4SleepLightContinueOwned(r,polls,exclusive)
    return 4
}
