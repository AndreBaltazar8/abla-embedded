import "../../src/esp32/ledc_channel_esp32c6.ab"
import "abla/build"
// Caller owns channel/gamma/IRQ/ETM and running timer, clock and GPIO leases.
// Not a boot image or complete buzzer. Timeout retains in-flight ownership.
@export("abla_esp32c6_ledc_channel_example")
trusted fun example(channel: int,timer: int,duty: int,stop: bool): int =
    if (stop) c6LedcChannelStopOwned(channel,false,1000) else c6LedcChannelSetDutyOwned(channel,timer,duty,0,1000)
