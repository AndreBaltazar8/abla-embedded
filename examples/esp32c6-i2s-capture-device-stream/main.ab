import "../../src/esp32/i2s/capture_device_stream_esp32c6.ab"
import "abla/build"
// Open with caller-pinned PLL240 root, dedicated external stereo I2S input,
// two64B DMA buffers; close through explicit cancellation after readers join.
@export("abla_esp32c6_i2s_capture_device_stream_example")
trusted fun example(device: NativeBuffer,cursor: NativeBuffer,descriptors: int,buffers: int,operation: int,exclusive: bool,discard: bool,handledErrors: int,handledI2sErrors: int): int {
    if (operation == 0) return c6CaptureDeviceOpenOwned(device,0,1,240000000,48000,0,1,2,3,-1,16,16,16,true,descriptors,2,buffers,64,64,1,discard,exclusive,true)
    if (operation == 1) return c6CaptureDeviceStreamPollOwned(device,cursor,1,exclusive)
    if (operation == 2) return c6CaptureDeviceStreamReleaseOwned(device,cursor,true,exclusive)
    if (operation == 3) return c6CaptureDeviceCancelOwned(device,2,1,handledErrors,discard,exclusive,handledI2sErrors)
    if (operation == 4) return c6CaptureDeviceRetryStopOwned(device,1,exclusive)
    return 2
}
