import "../../src/esp32/spi/async_buffer_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Fresh96B context op0, begin1, poll2.1..65535bytes, continuousmanualCS,
// canonicalgate and one shared modulo32 deadline; no DMA/heap/reset/replay.
// Caller retains all buffers/master/pads; failed RX prefix is provisional.
@export("abla_esp32c5_spi_async_buffer_example")
trusted fun example(master: Esp32C5SpiMaster,context: NativeBuffer,gate: PeripheralGate,owner: u32,
    tx: NativeBuffer,rx: NativeBuffer,bytes: int,now: u32,budget: u32,receive: bool,operation: int): int {
    if (operation == 0) return if (esp32C5SpiAsyncBufferInitialize(context)) 0 else 3<<56
    if (operation == 1) return master.beginBufferAsync(context,gate,owner,tx,rx,bytes,now,budget,receive)|0
    if (operation == 2) return esp32C5SpiAsyncBufferPoll(context,now)|0
    return 3<<56
}
