import "../../src/esp32/gpio.ab"
import "../../src/arduino/time.ab"
import "abla/build"

// Arduino's C++ runtime looks for these two mangled symbols. Exporting them
// directly keeps the sketch itself entirely in Abla and needs no glue source.
@export("_Z5setupv")
fun setup(): void {
    val led = pin(27)
    led.output()
}

@export("_Z4loopv")
fun loop(): void {
    val led = pin(27)
    val now = esp_timer_get_time()
    val halfSecond = now / 500000
    val phase = halfSecond - (halfSecond / 2) * 2
    led.write(phase == 0)
    delay(10)
}
