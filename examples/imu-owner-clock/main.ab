import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/imu_owner_clock.ab"
import "abla/runtime/scalar"
import "abla/build"
// Borrow a previously opened owner. Caller excludes acquisition and teardown.
// Inspect attempted/updated masks on failure: successful changes are not undone.
@export("abla_imu_owner_clock_example")
trusted fun example(owner: M5ImuOwner,frequency: int,exclusive: bool): M5ImuClockResult =
    owner.setClockOwned(frequency,exclusive)
