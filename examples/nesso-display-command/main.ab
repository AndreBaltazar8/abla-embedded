import "../../src/esp32/spi_software_esp32c6.ab"
import "../../src/m5stack/display_map.ab"
import "abla/build"
// Native callable, NOT complete panel startup. Caller owns configured GPIOs,
// settled E1 LCD power/reset, calibrated clocks and the shared gate. Software
// bit timing is not the descriptor's40MHz hardware SPI target. No LCD reads.
@export("abla_nesso_display_command_example")
trusted fun example(gate: PeripheralGate,owner: u32,command: int,data: NativeBuffer,length: int): SpiTransactionResult {
    val pins=m5BoardArduinoNessoN1.displaySpiPins()
    return softwareSpiCommand(gate,owner,Pin(pins.clock()),Pin(pins.mosi()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),command,data,length,0,1)
}
