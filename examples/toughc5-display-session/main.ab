import "../../src/m5stack/tough_display_session_esp32c5.ab"
import "abla/build"
//72B fresh session. Quiesce retains SPI/I2C/pads/power; caller closes them
// separately only after quiesce returns5 and other board users are stopped.
@export("abla_toughc5_display_session_example")
trusted fun example(session: NativeBuffer,master: Esp32C5SpiMaster,bus: int,pmic: M5Pm1,io: M5Ioe1,
    gate: PeripheralGate,owner: u32,rotation: int,brightness: int,exclusiveQuiesced: bool,quiesce: bool): int =
    if (quiesce) toughDisplaySessionQuiesceOwned(session,exclusiveQuiesced,false)
    else toughDisplaySessionBeginOwned(session,master|0,bus,pmic|0,io|0,gate,owner,rotation,brightness,exclusiveQuiesced)
