import "../../src/esp32/power/sleep_regulator_esp32p4.ab"
@export("abla_esp32p4_sleep_regulator_example")
trusted fun example(address: int,capacity: int,configAddress: int,configCapacity: int,revision: int,close: bool,exclusive: bool): int {
    val r=nativeBufferAt(address,capacity)
    if (close) return esp32p4SleepRegulatorCloseOwned(r,exclusive)
    return esp32p4SleepRegulatorOpenOwned(r,nativeBufferAt(configAddress,configCapacity),revision,exclusive)
}
