import "../../src/display/epd_canvas.ab"
import "abla/build"
@export("abla_epd_canvas_example")
fun example(action: int,canvas: NativeBuffer,state: NativeBuffer,width: int,height: int,x: int,y: int,w: int,h: int,rotation: int,source: NativeBuffer,stride: int,fill: int,mode: int,exclusive: bool): int {
    if (action == 0) return if (epdCanvasDrawOwned(canvas,width,height,x,y,w,h,rotation,source,stride,fill,mode,exclusive)) 1 else -1
    if (action == 1) return epdCanvasRead(canvas,width,height,x,y,rotation)
    if (action == 2) return if (epdCanvasSubmitOwned(canvas,state,width,height,x,y,w,h,mode,exclusive)) 1 else -1
    return -1
}
