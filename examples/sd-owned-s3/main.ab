import "../../src/sd/owned_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sd_owned_s3_example")
trusted fun transfer(link: SdSpiS3Link,gate: PeripheralGate,owner: u32,sourceHz: int,
    operation: int,state: SdSpiInitResult,block: int,scratch: NativeBuffer,data: NativeBuffer,polls: int): int {
    if (operation == 0) return link.initializeSd(gate,owner,sourceHz,scratch,data,polls)|0
    if (operation == 1) return link.readSdBlock(gate,owner,sourceHz,state,block,scratch,data,polls)|0
    if (operation == 2) return link.writeSdBlock(gate,owner,sourceHz,state,block,scratch,data,polls)|0
    return 2
}
