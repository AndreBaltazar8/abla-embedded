import "../../src/m5stack/pm1_rtc_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Return independent RTC ownership, including failed cleanup. Preserve caller
// wake evidence first; this neither sets the time nor clears PM1 wake latches.
@export("abla_pm1_board_rtc_example")
trusted fun open(control: M5Pm1Control,exclusive: bool,wakeEventsConsumed: bool): int =
    control.openRtcOwned(exclusive,wakeEventsConsumed)|0
