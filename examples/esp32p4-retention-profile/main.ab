import "../../src/esp32/power/retention_profile_p4.ab"
// Emits ordered disconnected configs only; retain the per-node Entries
// metadata when assembling a multi-entry hardware graph.
@export("abla_esp32p4_retention_profile_example")
trusted fun example(configs: int,configBytes: int,backing: int,backingBytes: int,scratch: int,uart: int,psram: bool,pvt: bool): int =
    esp32p4RetentionProfileConfigs(nativeBufferAt(configs,configBytes),nativeBufferAt(backing,backingBytes),nativeBufferAt(scratch,56),uart,psram,pvt)
