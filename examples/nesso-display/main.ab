import "../../src/m5stack/nesso_display_esp32c6.ab"
import "abla/build"
// Native callable, NOT a boot image. Caller supplies fresh initialized 40B
// NessoDisplay storage, current calibrated I2C SDA10/SCL8 session, canonical gate and
// exclusive SPI/E1 ownership. Keep all borrowed resources alive until close.
// action0 open,1 fill,2 close,3 sleep,4 wake,5 backlight-off.
// Open clears black before backlight-on. Uses 130ms sleep/wake settling.
@export("abla_nesso_display_example")
trusted fun example(display: NessoDisplay,bus: int,gate: PeripheralGate,owner: u32,action: int,exclusive: bool): int {
    if (action == 0) return display.openOwned(bus,gate,owner,0,true,exclusive)
    if (action == 1) return display.fillRectOwned(0,0,135,240,Rgb565(63488),exclusive)|0
    if (action == 2) return if (display.closeOwned(exclusive)) 1 else 0
    if (action == 3 || action == 4) return if (display.setSleepingOwned(action == 3,130,exclusive)) 1 else 0
    if (action == 5) return if (display.setBrightnessOwned(0,exclusive)) 1 else 0
    return 2
}
