import "../../src/esp32/ledc_channel_esp32c5.ab"
import "abla/build"
// Caller owns channel/gamma RAM/IRQ/ETM, clocked running timer and GPIO.
// Operation1 polls a pending update without replay;2 stops idle-low.
@export("abla_esp32c5_ledc_channel_example")
trusted fun example(channel: int,timer: int,duty: int,hpoint: int,polls: int,operation: int): int {
    if (operation == 1) return c5LedcChannelWaitOwned(channel,polls)
    if (operation == 2) return c5LedcChannelStopOwned(channel,false,polls)
    if (operation != 0) return 2
    return c5LedcChannelSetDutyOwned(channel,timer,duty,hpoint,polls)
}
