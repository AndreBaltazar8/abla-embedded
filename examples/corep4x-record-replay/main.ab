import "../../src/m5stack/corep4x_record_replay_esp32p4.ab"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Config32B U32 fields: channel,desc,count,payload,stride,bytes,revision,polls.
// Snapshot these values before workflow mutations; config may then be reused.
// Caller owns initialized hardware, enabled/preserved HP FPU, zero-magic192B
// session, recording and work storage. Callable only, not a boot/flash image.
@export("abla_corep4x_record_replay_example")
trusted fun replay(r: NativeBuffer,config: NativeBuffer,mic: Es7210,speaker: Es8311,
    io: M5Ioe1,recorded: NativeBuffer,work: NativeBuffer,blocks: i32,maxIdle: i32,exclusive: bool): int {
    if (!config.hasAddressRange(0,32)) return 2
    return coreP4xRecordReplayOwned(r,config.loadU32(0),config.loadU32(4),config.loadU32(8),
        config.loadU32(12),config.loadU32(16),config.loadU32(20),config.loadU32(24),config.loadU32(28),
        mic,speaker,io,recorded,work,int(blocks),int(maxIdle),exclusive)
}
