import "../../src/esp32/i2s.ab"
import "../../src/arduino/time.ab"
import "abla/unsafe/memory"

@export("_Z5setupv")
trusted fun setup(): void {
    val audio = i2s(0, i2sPins(19, 33, 22, 23), 16000)
    if (audio.install(false)) {
        val samples = nativeStackAllocate(256)
        var index = 0
        while (index < 128) {
            val phase = index - (index / 18) * 18
            val sample = if (phase < 9) 2200 else -2200
            nativeAddressStoreU16(samples, index * 2, sample)
            index = index + 1
        }
        var chunk = 0
        while (chunk < 12) {
            audio.writeAddress(samples, 256)
            chunk = chunk + 1
        }
        delay(30)
        audio.uninstall()
    }
}

@export("_Z4loopv")
fun loop(): void = delay(1000)
