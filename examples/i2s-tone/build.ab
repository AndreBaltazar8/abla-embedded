import "abla/compiler"

val target = #compilerDefineTarget(
    "esp32-xtensa",
    "xtensa-esp-unknown-elf",
    "elf",
    "none",
    "none",
    false,
    false
)
val built = #compilerBuildProgram(
    "abla-embedded-i2s-tone",
    "examples/i2s-tone/main.ab",
    "build/examples/i2s-tone/abla_app.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

fun main: int = if (target && built) 0 else 1
