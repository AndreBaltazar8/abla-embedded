import "../../src/esp32/i2s/dma_start_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_dma_start_example")
trusted fun example(r: NativeBuffer,channel: int,descriptors: int,count: int,buffers: int,stride: int,bytes: int,circular: bool,polls: int,exclusive: bool,resume: bool): int =
    if (resume) c6I2sDmaStartAdvanceOwned(r,polls,exclusive) else c6I2sDmaStartBeginOwned(r,channel,descriptors,count,buffers,stride,bytes,circular,polls,exclusive)
