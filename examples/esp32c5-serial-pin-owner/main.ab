import "../../src/esp32/uart/pin_owner_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_serial_pin_owner_example")
trusted fun example(record: NativeBuffer,unit: int,tx: int,rx: int,exclusiveStopped: bool,close: bool): int =
    if (close) c5UartPinOwnerCloseOwned(record,exclusiveStopped)
    else c5UartPinOwnerOpenOwned(record,unit,tx,rx,exclusiveStopped)
