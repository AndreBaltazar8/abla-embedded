import "../../src/m5stack/tab5_speaker_dma_esp32p4.ab"
@export("abla_tab5_speaker_dma_example")
trusted fun prepare(channel: i32,descriptors: u32,count: i32,payload: u32,stride: i32,
    bytes: i32,revision: i32,polls: i32,exclusive: bool): i32 {
    i32(tab5PrepareSpeakerDmaOwned(int(channel),int(descriptors),int(count),int(payload),int(stride),int(bytes),int(revision),int(polls),exclusive))
}
