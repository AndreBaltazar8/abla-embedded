import "../../src/m5stack/corep4x_channels_pump_esp32p4.ab"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Caller retains returned scalar/bindings/staging through busy retries.
// Queued does not mean physically played. Initial DMA ring contains silence.
@export("abla_corep4x_channels_pump_example")
trusted fun pump(state: CoreP4xChannelsPump,r: NativeBuffer,bank: PcmChannels,
    accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,gain: i32,exclusive: bool): int =
    coreP4xPumpChannelsOwned(state,r,bank,accumulator,scratch,staging,int(gain),exclusive)|0
