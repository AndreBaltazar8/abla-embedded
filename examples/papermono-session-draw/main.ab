import "../../src/m5stack/papermono_session_canvas.ab"
import "abla/runtime/scalar"
import "abla/build"
// Draw/copy grayscale8 and retain dirty bounds for session.refreshOwned.
@export("abla_papermono_session_draw_example")
trusted fun draw(session: Ssd1677Session,x: int,y: int,w: int,h: int,rotation: int,
    source: NativeBuffer,stride: int,fill: int,exclusive: bool): bool =
    session.drawPaperMonoOwned(x,y,w,h,rotation,source,stride,fill,exclusive)
