import "../../src/esp32/sdk/raw_buffer.ab"
fun tab5VideoColor(bar: int): int = if (bar == 0) 65535 else if (bar == 1) 65504 else if (bar == 2) 2047 else if (bar == 3) 2016 else if (bar == 4) 63519 else if (bar == 5) 63488 else if (bar == 6) 31 else 0
trusted fun tab5VideoFillBars(frame: NativeBuffer): bool {
    if (!frame.hasAddressRange(0,1843200)) return false
    var y=0; var offset=0
    while (y < 1280) {
        var bar=0
        while (bar < 8) {
            val color=tab5VideoColor(bar); val pair=color|(color<<16)
            var x=0
            while (x < 45) { frame.storeU32(offset,pair); offset=offset+4; x=x+1 }
            bar=bar+1
        }
        y=y+1
    }
    return true
}
