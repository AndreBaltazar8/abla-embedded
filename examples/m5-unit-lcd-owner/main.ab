import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/esp32/peripheral_delay_esp32c61.ab"
import "../../src/display/unit_lcd_owner_software.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun unitLcdDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
// Returned ownership must be retained, including initialization failures.
@export("abla_m5_unit_lcd_owner_example")
trusted fun example(bus: I2cBus,scratch: NativeBuffer,previous: UnitLcdOwner,close: bool): UnitLcdOwner =
    if (close) previous.closeOwned(scratch,true) else if ((previous.device()|0) != 0) previous else unitLcdOpenOwned(bus,scratch,true)
