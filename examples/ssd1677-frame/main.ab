import "../../src/display/ssd1677_frame.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller provides stable drawing/history planes. Hardware activation and
// history commit are separate; this example encodes one full physical row.
@export("abla_ssd1677_frame_example")
trusted fun encode(output: NativeBuffer,canvas: NativeBuffer,history: NativeBuffer,row: int,bank: int,
    mode: int,odd: bool,invert: bool,x: int,y: int,w: int,h: int,exclusive: bool): bool =
    ssd1677EncodeRowOwned(output,canvas,history,800,480,row,bank,mode,odd,invert,x,y,w,h,exclusive)
