import "../../src/esp32/rtc_elapsed_c5.ab"
import "../../src/esp32/rtc_timer_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5RtcElapsedExample")
@export("abla_esp32c5_rtc_elapsed_example")
trusted fun elapsed(before: int,periodQ19: int,exclusive: bool): int =
    esp32C5RtcElapsedMicroseconds(before,esp32C5RtcTicksOwned(0,exclusive),periodQ19)
