import "../../src/esp32/i2s/buzzer_stream_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_buzzer_stream_example")
trusted fun example(start: NativeBuffer,cursor: NativeBuffer,producer: NativeBuffer,sources: int,rate: int,acc: NativeBuffer,scratch: NativeBuffer,mono: NativeBuffer,staging: NativeBuffer,volume: int,exclusive: bool): int =
    c6BuzzerStreamRefillOwned(start,cursor,producer,PcmSourceQueues(sources),rate,acc,scratch,mono,staging,PcmVolume(volume),exclusive)
