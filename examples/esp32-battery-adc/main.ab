import "../../src/m5stack/battery_adc_esp32.ab"
import "../../src/esp32/adc_fuse_esp32.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
// Callable classic ESP32 example, NOT an Atom image or autonomous boot image.
// Supports TimerCam/StickCPlus2/CoreInk/Paper only. Caller owns ADC1/Hall/LNA
// and the battery pad, disables ULP/DMA/sleep changes, and has established board
// power/hold/divider supplies. This deliberately does not toggle power-hold,
// LED, charging or external5V pins just to measure a battery.
// SAR exclusivity is a lifetime promise excluding WiFi/PWDET/other clients;
// otherwise a live upstream force-on SAR lease must be pinned by the caller.
// ROM ets_delay_us at40008534 requires current calibrated CPU ticks-per-us.
// Caller chooses settlingMicros for the board/divider/source impedance; no
// claim that one generic delay establishes analog accuracy on every board.
// op0 measure,1 retry cleanup,2 read last calibrated result,3 retained owner.
// op0 returns mV ONLY if acquisition/calibration AND cleanup succeeded.
// Negative errors preserve last owner: -1 arguments/busy, -100-status open,
// -200-status start, -300-status finish, -400 missing/calibration failure,
// -500-status close. Cleanup errors take precedence over acquisition errors.
// All globals are application state, not framework-global peripheral owners.
var batterySession=Esp32Adc1Session(0)
var batteryLastMillivolts=-1
@export("abla_esp32_battery_adc_example")
trusted fun batteryExample(operation: int,boardNumber: int,settlingMicros: int,reference: int,exclusivePower: bool): int {
    if (operation == 1) {
        batterySession=batterySession.closeOwned(100000)
        return if (batterySession.status() == 0) 0 else -500-batterySession.status()
    }
    if (operation == 2) return batteryLastMillivolts
    if (operation == 3) return batterySession.bits()
    val board=M5BoardId(boardNumber)
    if (operation != 0 || batterySession.bits() != 0 || board.batteryAdcChannelEsp32() < 0 || settlingMicros < 1 || settlingMicros > 1000000 || (reference != 0 && (reference < 995 || reference > 1205))) return -1
    batteryLastMillivolts=-1
    val calibration=esp32AdcReadCalibration()
    if (calibration.source(reference) == 0) return -400
    batterySession=board.openBatteryAdcEsp32Owned(exclusivePower,100000)
    var result=-100-batterySession.status()
    if (batterySession.ready()) {
        callNativeVoidI32(0x40008534,settlingMicros)
        batterySession=batterySession.startAfterSettlingOwned(100000)
        result=-200-batterySession.status()
        if (batterySession.status() == 1) {
            batterySession=batterySession.pollOwned(100000)
            result=-300-batterySession.status()
            if (batterySession.status() == 1) {
                val mv=batterySession.batteryMillivoltsEsp32(board,calibration,reference)
                result=if (mv < 0) -400 else mv
            }
        }
    }
    batterySession=batterySession.closeOwned(100000)
    if (batterySession.status() != 0) return -500-batterySession.status()
    if (result >= 0) batteryLastMillivolts=result
    return result
}
