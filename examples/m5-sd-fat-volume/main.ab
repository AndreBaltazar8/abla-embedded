import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3_write.ab"
import "../../src/storage/fat_volume.ab"
import "abla/runtime/scalar"
import "abla/build"
// Live mounted volume; every filesystem client must share its transaction gate.
@export("abla_m5_sd_fat_volume_example")
trusted fun overwrite(volume: FatVolume,owner: u32,parent: int,ordinal: int,entry: int,expected: NativeBuffer,
    offset: int,length: int,budget: int,source: NativeBuffer,modified: RtcDateTime,workspace: NativeBuffer): FatFileOverwriteChecked =
    volume.overwrite(owner,parent,ordinal,entry,expected,offset,length,budget,source,modified,workspace)
