import "../../src/display/ssd1677_session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Open fresh64B record with ssd1677SessionOpenOwned and initialized96000B
// drawing buffer; independently owned96000B history. Mark dirty after drawing.
@export("abla_papermono_session_example")
trusted fun refresh(session: Ssd1677Session,gate: PeripheralGate,owner: u32,mode: int,polls: int,exclusive: bool,invert: bool=false): int {
    if (!session.setInvertOwned(invert,exclusive)) return 3<<32
    return session.refreshOwned(gate,owner,2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),mode,polls,exclusive)|0
}
