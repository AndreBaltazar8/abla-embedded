import "../../src/sd/session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Fresh initialized64B record, canonical gate, powered configured SPI/card.
// Scratch2B and response16B are separate from the record and gate.
@export("abla_sd_session_s3_example")
trusted fun session(storage: NativeBuffer,link: SdSpiS3Link,gate: PeripheralGate,owner: u32,
    sourceHz: int,scratch: NativeBuffer,data: NativeBuffer,operation: int,current: Esp32S3SdSession,block: int): int {
    if (operation == 0) return esp32S3SdSessionOpen(storage,link,gate,owner,sourceHz,scratch,data,1000)|0
    if (operation == 1) return current.readBlock(owner,block,scratch,data,250)|0
    if (operation == 2) return current.writeBlock(owner,block,scratch,data,250)|0
    if (operation == 3) return current.blockCount(owner)
    if (operation == 4) return if (current.invalidate(owner)) 1 else 0
    if (operation == 5) return current.readRegister(owner,10,scratch,data,250)|0
    return 0
}
