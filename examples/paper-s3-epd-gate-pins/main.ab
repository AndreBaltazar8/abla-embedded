import "../../src/display/epd_gate_pins_esp32s3.ab"
import "../../src/m5stack/paper_s3_epd.ab"
import "abla/build"
@export("abla_paper_s3_epd_gate_pins_example")
fun example(action: int,record: NativeBuffer,scanout: NativeBuffer,transport: NativeBuffer,offIdleExclusive: bool): int {
    if (action == 0) return epdGatePinsOpenOwned(record,paperS3EpdGatePins(),offIdleExclusive)
    if (action == 1) return epdGatePinsCloseOwned(record,offIdleExclusive)
    if (action == 2) return epdGatePinsCloseAfterScanoutOwned(record,scanout,transport,offIdleExclusive)
    return 0
}
