import "../../src/m5stack/chaincaptain_panel_esp32s3.ab"
import "../../src/m5stack/chaincaptain_spi_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Fresh stopped SPI2, released pads, stablePLL80M, ready rail/reset and OFF
// backlight remain caller-owned. No framebuffer or implicit bus shutdown.
// Return actual failed transaction, leave backlight OFF on failure.
@export("abla_chaincaptain_panel_example")
trusted fun initializeAndClear(gate: PeripheralGate,owner: u32,rotation: int): int {
    if (rotation < 0 || rotation > 7) return SpiTransactionResult(3<<32)|0
    val bus=chainCaptainSpiInitializeOwned(gate,owner,true)
    if (!bus.valid()) return bus|0
    val initialized=chainCaptainPanelBeginOwned(gate,owner,rotation)
    if (!initialized.valid()) return initialized|0
    return chainCaptainPanelClearOwned(gate,owner,rotation)|0
}
