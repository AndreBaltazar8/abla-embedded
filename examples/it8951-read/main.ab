import "../../src/display/it8951_software_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Transport example, not panel initialization. Caller supplies configured,
// exclusively owned pins and40B scratch; GET_DEV_INFO is read-only.
@export("abla_it8951_read_example")
trusted fun example(bus: It8951Software,scratch: NativeBuffer,polls: int): It8951Transfer {
    if (!scratch.hasAddressRange(0,40)) return It8951Transfer(2)
    val sent=it8951Command(bus|0,770,NativeBuffer(0),0,polls)
    if (!sent.success()) return sent
    peripheralDelayMicroseconds(1000)
    it8951ReadWords(bus|0,scratch,20,polls)
}
