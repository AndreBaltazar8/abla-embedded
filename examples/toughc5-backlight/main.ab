import "../../src/m5stack/tough_backlight.ab"
import "../../src/esp32/i2c_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_toughc5_backlight_example")
trusted fun backlight(io: M5Ioe1,brightness: int,initialize: bool,exclusive: bool): int =
    if (initialize) toughBacklightBeginOwned(io,brightness,exclusive) else toughBacklightSetOwned(io,brightness,exclusive)
