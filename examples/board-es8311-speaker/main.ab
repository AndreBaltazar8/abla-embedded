import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/es8311_speaker_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Callback only; stop/park TX separately. Cardputer ADV disable is a no-op.
// ALL sharedrail/codec users must be quiescent, with initialized board outputs.
@export("abla_board_es8311_speaker_example")
trusted fun speaker(board: M5BoardId,codec: Es8311,pm1: M5Pm1,io: M5Ioe1,enabled: bool,exclusive: bool): int =
    board.es8311SpeakerOwned(codec,pm1,io,enabled,exclusive)
