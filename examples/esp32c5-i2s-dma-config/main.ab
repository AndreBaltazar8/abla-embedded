import "../../src/esp32/i2s/dma_config_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_dma_config_example")
trusted fun example(r: NativeBuffer,channel: int,tx: bool,data: int,slot: int,ws: int,shift: bool,slots: int,flags: int,bytes: int,polls: int,exclusive: bool,operation: int): int =
    if (operation == 0) c5I2sDmaConfigOpenOwned(r,channel,tx,data,slot,ws,shift,slots,flags,bytes,polls,exclusive)
    else if (operation == 1) c5I2sDmaConfigWaitOwned(r,polls,exclusive)
    else if (operation == 2) c5I2sDmaConfigCloseOwned(r,polls,exclusive) else 2
