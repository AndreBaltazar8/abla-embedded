import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/display/oled_owner_software.ab"
import "../../src/m5stack/oled_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
// Fresh32B owner; opened externally owned bus, reset/power already supplied.
// Caller serializes every operation and closes the display before the bus.
@export("abla_m5_unit_oled_owner_example")
trusted fun example(owner: OledOwner,bus: I2cBus,mini: bool,operation: int,frame: NativeBuffer,scratch: NativeBuffer): int {
    if (operation == 0) return if (owner.initializeFresh()) 1 else 0
    if (operation == 1) return owner.openOwned(bus,if (mini) m5UnitMiniOledProfile else m5UnitOledProfile,scratch,true)
    if (operation == 2) return owner.displayOwned(frame,scratch,true)
    if (operation == 3) return if (owner.closeOwned(scratch,true)) 1 else 0
    return owner.status()
}
