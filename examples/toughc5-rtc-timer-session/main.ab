import "../../src/m5stack/tough_rtc_timer_session_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_toughc5_rtc_timer_session_example")
trusted fun timer(owner: M5ToughPowerOwner,record: NativeBuffer,rtc: M5RtcOpenResult,bus: I2cBus,milliseconds: int,operation: int,exclusive: bool): int {
    if (operation == 0) return owner.beginRtcTimerSessionOwned(record,rtc,bus|0,milliseconds,exclusive)
    if (operation == 1) return owner.retryRtcTimerCleanupOwned(record,exclusive)
    if (operation == 2) return owner.closeRtcTimerSessionOwned(record,exclusive)
    return 2
}
