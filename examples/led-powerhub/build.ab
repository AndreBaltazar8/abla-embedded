import "abla/compiler"

val target = #compilerDefineTarget(
    "esp32-xtensa", "xtensa-esp-unknown-elf", "elf", "none", "none",
    false, false
)
val built = #compilerBuildProgram(
    "abla-embedded-led-powerhub", "examples/led-powerhub/main.ab",
    "build/examples/led-powerhub/abla_app.o", "esp32-xtensa", "object",
    false, false
)
fun main: int = if (target && built) 0 else 1
