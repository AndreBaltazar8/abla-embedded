import "../../src/esp32/abla_host_esp_idf.ab"
import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/esp32/serial_esp32s3.ab"
import "../../src/led/powerhub_device.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // M5PowerHub internal I2C: SDA 45, SCL 48. This firmware is board-specific.
    val bus = i2cMaster(0, 45, 48, u32(40000000), u32(160000000))
    val led = powerHubLed(bus)
    if (led.begin()) {
        led.setAutoDisplay(false)
        led.setAllColor(rgbColor(0, 0, 16))
        led.display()
        peripheralDelayMilliseconds(250)
        led.setAllColor(rgbColor(0, 0, 0))
        led.display()
        log.line("PowerHub LEDs exercised")
    }
    led.close()
    bus.close()
    return
}
