import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/esp32/task.ab"
import "../../src/led/powerhub.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // M5PowerHub internal I2C: SDA 45, SCL 48. This firmware is board-specific.
    val bus = i2cMaster(0, 45, 48)
    val led = powerHubLed(bus)
    if (led.begin()) {
        led.setAutoDisplay(false)
        led.setAllColor(rgbColor(0, 0, 16))
        led.display()
        taskDelay(250)
        led.setAllColor(rgbColor(0, 0, 0))
        led.display()
        log.line("PowerHub LEDs exercised")
    }
    led.close()
    bus.close()
    return
}
