import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/power/ip5306.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // Original M5Stack internal I2C: SDA 21, SCL 22. begin() applies the same
    // WLED-disable handshake as M5Unified; the sample changes no power rails.
    val bus = i2cMaster(0, 21, 22)
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }
    val power = ip5306(bus)
    if (power.begin()) {
        power.batteryLevel()
        power.charging()
        log.line("IP5306 detected and sampled")
    } else log.line("IP5306 not detected")
    power.close()
    bus.close()
    return
}
