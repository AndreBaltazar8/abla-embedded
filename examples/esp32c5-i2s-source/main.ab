import "../../src/esp32/i2s/source_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_source_example")
trusted fun example(tx: bool,source: int,polls: int,exclusive: bool,previous: int,close: bool): int =
    if (close) C5I2sSource(previous).closeOwned(exclusive)|0
    else c5I2sSourceOpenOwned(tx,source,polls,exclusive)|0
