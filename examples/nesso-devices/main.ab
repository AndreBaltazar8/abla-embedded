import "../../src/m5stack/nesso_devices_esp32c6.ab"
import "abla/build"
// Caller supplies initialized112B owner, current calibratedSDA10/SCL8 session,
// canonical SPI gate and all board consumers quiesced. Not a boot image.
@export("abla_nesso_devices_example")
trusted fun example(devices: NessoDevices,bus: int,gate: PeripheralGate,owner: u32,open: bool,exclusive: bool): int =
    if (open) devices.openOwned(bus,gate,owner,exclusive) else if (devices.closeOwned(exclusive)) 1 else 0
