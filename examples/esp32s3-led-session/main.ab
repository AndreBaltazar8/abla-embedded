import "../../src/led/rmt_session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller constructs strip separately, supplies zeroed40B session, retains
// ownership/storage through cleanup. op0begin,1display,2close/retry.
@export("abla_esp32s3_led_session_example")
trusted fun session(op: int,r: NativeBuffer,strip: RmtLedStrip,dma: int,owner: u32,
    descriptors: int,waveform: NativeBuffer,polls: int,exclusive: bool): int {
    if (op == 0) return rmtLedSessionBeginOwned(r,strip,dma,owner,exclusive)
    if (op == 1) return rmtLedSessionDisplayOwned(r,descriptors,waveform,polls,exclusive)
    if (op == 2) return rmtLedSessionCloseOwned(r,polls,exclusive)
    return 0
}
