import "../../src/esp32/power/retention_extra_esp32p4.ab"
@export("abla_esp32p4_retention_extra_example")
trusted fun example(record: int,operation: int,backup: bool,polls: int,exclusive: bool): int {
    val r=nativeBufferAt(record,24)
    if (operation == 0) return esp32p4RetentionExtraBeginOwned(r,backup,exclusive)
    if (operation == 1) return esp32p4RetentionExtraPollOwned(r,polls,exclusive)
    if (operation == 2) return esp32p4RetentionExtraCloseOwned(r,exclusive)
    return 2
}
