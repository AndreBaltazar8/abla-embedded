import "../../src/esp32/i2s/reset_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_reset_example")
trusted fun example(port: int,tx: bool,selection: int,exclusive: bool,discard: bool,release: bool): int =
    if (release) c5I2sResetReleaseOwned(port,tx,exclusive) else c5I2sResetOwned(port,tx,selection,exclusive,discard)
