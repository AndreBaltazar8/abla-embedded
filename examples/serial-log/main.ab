import "../../src/esp32/serial_esp32s3.ab"
import "../../src/log_policy.ab"
import "../../src/log_serial.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns configured S3 UART0 clocks/baud/pads and serializes the entire
// call against other UART writers. No hardware initialization or flash image.
// ANSI level colors with best-effort reset after failures. A failed FIFO wait
// may leave a partial line/escape; false is not a retry guarantee.
trusted fun logOutputOwned(target: int,level: int,color: bool,text: NativeBuffer,length: int,suffix: int): bool {
    if (target != 0) return false
    if (!logSerialRenderOwned(serial(),level,color,text,length,nativeBufferAt(0,0),0,1000)) return false
    if (suffix == 2 && !serial().tryWriteByte(13,1000)) return false
    if (suffix != 0 && !serial().tryWriteByte(10,1000)) return false
    return true
}
trusted fun serialLogExample(address: u32,length: int,level: int,threshold: int): int {
    if (threshold < 0 || threshold > 5 || length < 0 || length > 4096) return -1
    val policy=logPolicy().configure(0,threshold,true,true,1)
    val result=policy.writeOwned(level,nativeBufferAt(int(address),length),length,level != 0)
    if (!result.succeeded()) return -1
    return result.completed()
}
#exportFunction("serialLogExample", "abla_serial_log_example")
