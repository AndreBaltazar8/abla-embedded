import "../../src/esp32/button_esp32s3.ab"
import "../../src/m5stack/button_source_gpio.ab"
import "abla/runtime/scalar"
import "abla/build"
// Convert once and retain returned state between updates. No implicit GPIO
// configuration here; the caller owns a configured input and its clock.
@export("abla_board_button_source_example")
fun example(source: M5ButtonSource): GpioButton = source.asButton()
