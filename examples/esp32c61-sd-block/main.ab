import "../../src/sd/block_esp32c61.ab"
import "abla/build"
// Caller explicitly selects write; state belongs to this live initialized card.
@export("abla_esp32c61_sd_block_example")
trusted fun example(master: Esp32C61SpiMaster,gate: PeripheralGate,owner: u32,sourceHz: int,
    state: SdSpiInitResult,block: int,scratch: NativeBuffer,payload: NativeBuffer,write: bool): int =
    if (write) master.writeSdBlock(gate,owner,sourceHz,state,block,scratch,payload)|0
    else master.readSdBlock(gate,owner,sourceHz,state,block,scratch,payload)|0
