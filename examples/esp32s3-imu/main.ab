import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/imu_owner.ab"
import "../../src/m5stack/imu_owner_update.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns initialized S3 I2C bus, calibrated ROMdelay, powered/settled sensors, and aligned
//100-byte RAM: owner36,snapshot44,scratch20. This borrows the bus, never closes
// it or changes boardpower. RAM/bus must outlive session, including failedopen.
// Single active example session; serialized operations; no reinit livehandles.
// op0 open/probe (0success,-100-status failure retaining cleanup ownership),
// op1 update returns packed M5ImuUpdateResult with BOTH device statuses and
// freshmask accessors; transport failure is not collapsed to a zero mask.
// op2 close (-2 retry needed), op3 populated sensor mask. -1 invalid state.
// Snapshot is readable by imuSnapshotAt(work+36); timestamps use caller micros.
var sessionAddress=0
var sessionBus=0
trusted fun imuDelay(milliseconds: int): void {
    peripheralDelayMilliseconds(milliseconds)
    return
}
trusted fun esp32s3ImuExample(busValue: int,workAddress: u32,operation: int,micros: u32): int {
    val work=nativeBufferAt(int(workAddress),100)
    if (!work.hasAddressRange(0,100) || (work.addressValue()&3) != 0 || operation < 0 || operation > 3) return -1
    val owner=m5ImuOwnerAt(nativeBufferAt(work.addressValue(),36))
    val snapshot=imuSnapshotAt(nativeBufferAt(work.addressValue()+36,44))
    if (operation == 0) {
        if (sessionAddress != 0 || !I2cBus(busValue).valid()) return -1
        if (!owner.initialize() || !snapshot.initialize()) return -1
        sessionAddress=work.addressValue(); sessionBus=busValue
        val opened=owner.open(I2cBus(busValue))
        return if (opened == 1) 0 else -100-opened
    }
    if (sessionAddress != work.addressValue() || sessionBus != busValue) return -1
    if (operation == 2) {
        if (!owner.close()) return -2
        sessionAddress=0; sessionBus=0
        return 0
    }
    if (owner.status() != 1) return -1
    if (operation == 3) return snapshot.buffer().loadU32(4)
    val result=owner.updateSnapshot(snapshot,nativeBufferAt(work.addressValue()+80,20),int(micros))
    if (!result.valid()) return -1
    return result|0
}
#exportFunction("esp32s3ImuExample", "abla_esp32s3_imu_example")
