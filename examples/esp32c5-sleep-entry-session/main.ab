import "../../src/esp32/power/sleep_entry_session_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5SleepEntrySessionExample")
@export("abla_esp32c5_sleep_entry_session_example")
trusted fun session(record: NativeBuffer,wake: u32,reject: int,close: bool,exclusive: bool): int =
    if (close) esp32C5SleepEntryCloseOwned(record,exclusive) else esp32C5SleepEntryRunOwned(record,wake,reject,exclusive)
