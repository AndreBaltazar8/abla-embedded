import "../../src/esp32/i2s/audio_transfer_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_audio_transfer_example")
trusted fun example(setup: NativeBuffer,transfer: NativeBuffer,descriptors: int,count: int,buffers: int,stride: int,bytes: int,budget: int,polls: int,exclusive: bool,discard: bool,operation: int): int =
    if (operation == 0) c5AudioTransferBeginOwned(setup,transfer,descriptors,count,buffers,stride,bytes,polls,exclusive)
    else if (operation == 1) c5AudioTransferFinishOwned(setup,transfer,budget,polls,exclusive)
    else if (operation == 2) c5AudioTransferAbortOwned(setup,transfer,polls,exclusive,discard) else 2
