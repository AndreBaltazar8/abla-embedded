import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/c6_gauge.ab"
import "abla/runtime/scalar"
import "abla/build"
// S3 callable demonstration with an externally connected BQ27220. Exercises
// shared Nesso telemetry policy, but NOT a Nesso/C6 image or pin configuration.
// Borrow a bound gauge; no board or gauge initialization.
@export("abla_bq27220_telemetry_s3_example")
trusted fun example(gauge: Bq27220,operation: int,exclusive: bool): int {
    if (operation == 0) return m5BoardArduinoNessoN1.readBatteryMillivoltsOwned(gauge,exclusive)|0
    if (operation == 1) return m5BoardArduinoNessoN1.readBatteryLevelOwned(gauge,exclusive)|0
    if (operation == 2 && exclusive) return gauge.currentMilliampsChecked()|0
    return 0
}
