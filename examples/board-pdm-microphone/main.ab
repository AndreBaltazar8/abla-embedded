import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/pdm_microphone_session_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// S3 AtomS3U/Cardputer/Capsule/PaperMono only, retained152B session. Caller owns
// hardware/storage and stablePLL160M; PaperMono PM1/IOE1 handles initialized.
// op0prepare16k,1start,2read,3close. Poweroff follows confirmed DMA stop/park;
// pad/input routing is then restored; sharedBOOST/clocks remain enabled.
@export("abla_board_pdm_microphone_example")
trusted fun microphone(op: int,board: M5BoardId,r: NativeBuffer,output: NativeBuffer,
    channel: int,descriptors: int,count: int,payload: int,blockBytes: int,owner: u32,
    power: M5Pm1,expander: M5Ioe1,polls: int,exclusive: bool): int {
    if (op == 0) return board.beginPdmMicrophoneOwned(r,16000,channel,descriptors,count,payload,blockBytes,owner,power,expander,exclusive)
    if (op == 1) return m5PdmMicrophoneStartOwned(r,polls,exclusive)
    if (op == 2) return m5PdmMicrophoneReadOwned(r,output,polls,exclusive)|0
    if (op == 3) return m5PdmMicrophoneCloseOwned(r,polls,exclusive)
    return 0
}
