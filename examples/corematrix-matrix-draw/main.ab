import "../../src/m5stack/corematrix_matrix_esp32c61.ab"
import "../../src/m5stack/corematrix_matrix_draw.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller owns ready display/control and serializes the whole draw/publication.
// Bitmap16x16, MSB-first packed rows, two bytes/row. No implicit clear or retry.
@export("abla_corematrix_matrix_draw_example")
trusted fun example(matrix: M5CoreMatrixMatrix,source: NativeBuffer,rotation: int): bool =
    matrix.drawBitmap(0,0,16,16,source,2,rotation) && matrix.display()
