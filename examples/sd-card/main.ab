import "../../src/esp32/spi_idf6.ab"
import "../../src/esp32/sd_spi.ab"
import "../../src/esp32/serial.ab"
import "../../src/m5stack/pin_map.ab"
import "abla/unsafe/memory"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // Core2 is a representative SDSPI board. Other boards use the same code
    // with a different static board ID; the canonical map supplies the pins.
    val pins = m5BoardStackCore2.sdPins()
    val bus = spiMaster(2, spiPins(
        pins.spiMosi().number(),
        pins.spiMiso().number(),
        pins.spiClock().number()
    ), 1024)
    if (!bus.valid()) {
        log.line("SD SPI bus initialization failed")
        return
    }
    val card = sdSpiInitialize(bus, pins.spiChipSelect().number())
    if (!card.valid()) {
        log.line("SD card initialization failed")
        bus.close()
        return
    }
    val block = nativeBufferAt(nativeStackAllocate(512), 512)
    if (card.readBlock(0, block)) log.line("SD block 0 read")
    else log.line("SD block read failed")
    card.close()
    bus.close()
    return
}
