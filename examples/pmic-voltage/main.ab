import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/pmic_voltage.ab"
import "abla/runtime/scalar"
import "abla/build"
// Read-only VBUS telemetry on an already-opened PMIC. Decode status before mV.
// Does not initialize ADCs, enable rails or change battery charging policy.
@export("abla_pmic_voltage_example")
trusted fun example(pmic: M5PmicOpen,exclusive: bool): int = pmic.readVbusMillivoltsOwned(exclusive)|0
