import "../../src/esp32/psram/cache_mapping_esp32s3.ab"
import "abla/build"
@export("abla_esp32s3_psram_cache_mapping_example")
@section(".iram1.abla.s3PsramCacheMappingExample")
fun example(r: NativeBuffer,end: bool,proof: bool): int =
    if (end) s3PsramCacheMappingEndOwned(r,proof) else s3PsramCacheMappingBeginOwned(r,proof)
