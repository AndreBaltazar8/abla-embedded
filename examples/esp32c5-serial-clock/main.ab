import "../../src/esp32/uart/clock_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_serial_clock_example")
trusted fun example(owner: C5UartClockOwner,unit: int,source: int,exclusiveStopped: bool,close: bool): C5UartClockOwner =
    if (close) owner.closeOwned(exclusiveStopped) else c5UartClockOpenOwned(unit,source,exclusiveStopped,1000)
