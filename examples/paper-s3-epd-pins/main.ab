import "../../src/m5stack/paper_s3_epd_transport.ab"
import "abla/build"
@export("abla_paper_s3_epd_pins_example")
fun example(action: int,record: int,configuration: int,exclusive: bool): int {
    val r=nativeBufferAt(record,96);val cfg=nativeBufferAt(configuration,76)
    if (action == 0) return if (paperS3EpdTransportConfig(cfg)) 1 else 0
    if (action == 1) return esp32S3I80PinsOpenOwned(r,cfg,8,0,exclusive)
    if (action == 2) return esp32S3I80PinsCloseOwned(r,exclusive)
    return 0
}
