import "../../src/esp32/power/retention_links_esp32p4.ab"
@export("abla_esp32p4_retention_links_example")
trusted fun example(record: int,close: bool,entry0: int,entry1: int,entry2: int,exclusiveIdle: bool): int =
    if (close) esp32p4RetentionLinksCloseOwned(nativeBufferAt(record,32),exclusiveIdle) else esp32p4RetentionLinksOpenOwned(nativeBufferAt(record,32),entry0,entry1,entry2,exclusiveIdle)
