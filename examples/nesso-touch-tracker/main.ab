import "../../src/m5stack/nesso_touch_tracker_esp32c6.ab"
import "abla/build"
// Borrow initialized tracker and display/touch owners; negative is not a
// released frame. Read tracker details only after an accepted fresh report.
@export("abla_nesso_touch_tracker_example")
trusted fun example(display: NessoDisplay,bus: int,touch: TouchControllerOpen,tracker: TouchTracker,
    snapshot: NativeBuffer,now: int,exclusive: bool): int =
    display.pollTouchTrackerOwned(bus,touch,tracker,snapshot,now,exclusive)
