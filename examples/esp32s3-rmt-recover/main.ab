import "../../src/esp32/rmt_recover_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller retains RMT3/GDMA/pad/buffer ownership and running peripheral clocks.
// On failure retain them and retry; success permits separate pad restoration.
@export("abla_esp32s3_rmt_recover_example")
trusted fun recover(channel: int,polls: int): int = esp32s3RmtRecoverDmaOwned(channel,polls)
