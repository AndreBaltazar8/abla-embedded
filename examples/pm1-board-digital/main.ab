import "../../src/m5stack/pm1_digital_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller has released RTC/USB/hold ownership and stopped prior pad users.
@export("abla_pm1_board_digital_example")
trusted fun configure(board: M5BoardId,exclusiveDigitalReleased: bool): int =
    board.configurePm1DigitalOwned(exclusiveDigitalReleased)
