import "../../src/esp32/power/sleep_calibration_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32c5_sleep_calibration_example")
trusted fun calibration(output: NativeBuffer,deep: bool,xtalDown: bool,rcFastDown: bool,xtalFast: bool,lpFast: bool,exclusive: bool): bool =
    esp32C5SleepCalibrationReadOwned(exclusive).analog(output,deep,xtalDown,rcFastDown,xtalFast,lpFast)
