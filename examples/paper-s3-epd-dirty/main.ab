import "../../src/display/epd_canvas_dirty.ab"
import "abla/build"
// Caller owns40B zeroed record, packed canvas, and initialized waveform state.
// Submit queues a batch; existing frame Start/Pump performs physical refresh.
@export("abla_paper_s3_epd_dirty_example")
fun example(action: int,record: NativeBuffer,canvas: NativeBuffer,state: NativeBuffer,x: int,y: int,w: int,h: int,rotation: int,source: NativeBuffer,stride: int,fill: int,mode: int,exclusive: bool): bool {
    if (action == 0) return epdCanvasDirtyOpenOwned(record,canvas,960,540,exclusive)
    if (action == 1) return epdCanvasDirtyDrawOwned(record,canvas,x,y,w,h,rotation,source,stride,fill,mode,exclusive)
    if (action == 2) return epdCanvasDirtySubmitOwned(record,canvas,state,exclusive)
    return false
}
