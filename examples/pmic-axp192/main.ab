import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/power/axp192.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    val bus = i2cMaster(1, 26, 32)
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }
    val power = axp192(bus)
    if (power.begin()) {
        power.batteryLevel()
        power.batteryVoltage()
        power.batteryChargeCurrentMilliamps()
        power.batteryDischargeCurrentMilliamps()
        power.batteryPower()
        power.vbusVoltage()
        power.vbusCurrentMilliamps()
        power.acinVoltage()
        power.acinCurrentMilliamps()
        power.apsVoltage()
        power.internalTemperatureCelsius()
        log.line("AXP192 detected and sampled")
    } else log.line("AXP192 not detected")
    power.close()
    bus.close()
    return
}
