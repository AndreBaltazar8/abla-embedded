import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/imu/mpu6886.ab"
import "../../src/imu/calibration.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    val bus = i2cMaster(1, 26, 32)
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }
    val sensor = mpu6886(bus)
    if (sensor.begin() == imuSpecNone) {
        log.line("MPU6886 initialization failed")
        sensor.close()
        bus.close()
        return
    }

    val offsets = imuOffsets()
    offsets.clear()
    val calibration = imuCalibration()
    calibration.clear()
    calibration.configureM5UnifiedDefaults(255, 255, 0)

    val initialAcceleration = sensor.readAccelerationRaw()
    val initialGyroscope = sensor.readGyroscopeRaw()
    if (!calibration.initializeSensor(
            0, initialAcceleration, offsets
        ) || !calibration.initializeSensor(1, initialGyroscope, offsets)) {
        log.line("Initial IMU sample failed")
        sensor.close()
        bus.close()
        return
    }

    var samples = 0
    while (samples < 256) {
        val acceleration = sensor.readAccelerationRaw()
        val gyroscope = sensor.readGyroscopeRaw()
        if (acceleration.valid()) calibration.update(
            0, acceleration, offsets
        )
        if (gyroscope.valid()) calibration.update(1, gyroscope, offsets)
        imuDelay(10)
        samples = samples + 1
    }
    log.line("IMU automatic calibration complete")
    sensor.close()
    bus.close()
    return
}
