import "abla/compiler"

val target = #compilerDefineTarget(
    "esp32-xtensa",
    "xtensa-esp-unknown-elf",
    "elf",
    "none",
    "none",
    false,
    false
)

val built = #compilerBuildProgram(
    "abla-embedded-touch-gestures",
    "examples/touch-gestures/main.ab",
    "build/examples/touch-gestures/abla_app.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

val updateBuilt = #compilerBuildProgram(
    "abla-embedded-touch-update",
    "examples/touch-gestures/update.ab",
    "build/examples/touch-gestures/abla_update.o",
    "esp32-xtensa",
    "object",
    false,
    false
)

fun main: int = if (target && built && updateBuilt) 0 else 1
