import "../../src/input/touch.ab"

// A controller-independent example: a real touch driver follows the same
// startUpdate -> updatePoint -> finishUpdate sequence after converting its raw
// coordinates. This synthetic path makes the gesture API buildable everywhere.
val touch = touchTracker()

@export("abla_touch_gesture_example")
trusted fun touchGestureExample(): int {
    if (!touch.startUpdate(10)) return 0
    touch.updatePoint(gesturePoint(40, 60, 3, 0))
    touch.finishUpdate()
    if (!touch.detail().wasPressed()) return 0

    touch.startUpdate(20)
    touch.updatePoint(gesturePoint(64, 60, 3, 0))
    touch.finishUpdate()
    if (touch.detail().wasFlickStart()) 1 else 0
}
