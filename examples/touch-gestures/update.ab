import "../../src/input/touch.ab"

// Build-only leaf used for comparing the generated Xtensa implementation with
// the equivalent C++ state transition at byte and instruction level.
@export("abla_touch_detail_update")
trusted fun touchDetailUpdateExport(
    address: u32,
    nowMilliseconds: u32,
    pressed: bool,
    point: u64,
    holdMilliseconds: u32,
    flickThreshold: i32
): bool = touchDetailUpdateNative(
    nativePointerFromAddress(int(address)), nowMilliseconds, pressed, point,
    holdMilliseconds, flickThreshold
)
