import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/power/m5pm1_device.ab"
import "abla/runtime/scalar"
import "abla/build"
// Does not arm wake or enter sleep. Verify the physical IRQ after clearing.
@export("abla_m5_pm1_wake_clear_example")
trusted fun clear(pmic: M5Pm1): int = pmic.clearWakeInterruptChecked()
