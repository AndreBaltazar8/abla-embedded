import "../../src/m5stack/stopwatch_display_startup_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Existing ready PM1 controller; caller exclusively owns whole display
// startup resources. Does not install TE interrupt or initialize touch/audio.
@export("abla_stopwatch_display_example")
trusted fun initialize(control: M5Pm1Control,gate: PeripheralGate,owner: u32,
    rotation: int,brightness: int,exclusive: bool): int =
    control.initializeStopWatchDisplayOwned(gate,owner,rotation,brightness,exclusive)|0
