import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/es8311_channels_window_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Already running retainedTX, initialized ring, stable ownership. This call
// consumes a finite mixer window, queues a silence tail, then closes TX/amp.
@export("abla_board_es8311_channels_window_example")
trusted fun play(r: NativeBuffer,bank: PcmChannels,blocks: int,acc: NativeBuffer,scratch: NativeBuffer,
    staging: NativeBuffer,maxIdle: int,gain: int,exclusive: bool,tone: PcmTone=PcmTone(0)): int =
    m5Es8311PlaybackChannelsWindowOwned(r,bank,blocks,acc,scratch,staging,maxIdle,gain,exclusive,tone)|0
