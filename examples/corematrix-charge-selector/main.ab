import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/m5stack/corematrix_charge.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable peripheral/transport compilation example, NOT a CoreMatrix C61
// boot image. Native C61 GPIO transport requires owned clocks, calibrated
// ROM delay and exclusive pads. The borrowed expander
// uses the selected I2C provider. Caller owns G3 and serializes all transfers.
@export("abla_corematrix_charge_selector_example")
fun example(ioe: M5Ioe1,requestedMilliamps: int): M5CoreMatrixChargeSelection =
    m5BoardCoreMatrix.setCoreMatrixChargeCurrentOwned(ioe,requestedMilliamps)
