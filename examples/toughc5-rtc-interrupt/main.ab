import "../../src/m5stack/tough_rtc_interrupt_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_toughc5_rtc_interrupt_example")
trusted fun interrupt(owner: M5ToughPowerOwner,rtc: M5RtcOpenResult,bus: I2cBus,operation: int,duration: int,minute: int,hour: int,day: int,weekday: int,exclusive: bool): int {
    if (operation == 0) return owner.setRtcTimerOwned(rtc,bus|0,duration,exclusive)|0
    if (operation == 1) return owner.setRtcAlarmOwned(rtc,bus|0,minute,hour,day,weekday,exclusive)|0
    if (operation == 2 || operation == 3) return owner.clearRtcInterruptOwned(rtc,bus|0,operation == 3,exclusive)|0
    return 0
}
