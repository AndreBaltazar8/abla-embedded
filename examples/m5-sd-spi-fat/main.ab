import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3_owner.ab"
import "abla/runtime/scalar"
import "abla/build"
// Open through board.openSdSpiOwned first; close after joining FAT users.
@export("abla_m5_sd_spi_fat_example")
trusted fun readSector(record: S3SdMasterOwner,reader: NativeBuffer,owner: u32,scratch: NativeBuffer,
    sector: int,destination: NativeBuffer,bind: bool): bool {
    if (bind && !record.bindFatReaderOwned(reader,owner,scratch)) return false
    return fatStorageReadOwned(reader,sector,destination)
}
