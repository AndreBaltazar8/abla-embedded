import "../../src/esp32/i2s/pins_esp32p4.ab"
@export("abla_esp32p4_i2s_pins_example")
trusted fun route(port: i32,transmit: bool,mclk: i32,bclk: i32,ws: i32,data: i32,flags: i32,exclusive: bool): i32 {
    i32(esp32p4I2sRoutePinsOwned(int(port),transmit,int(mclk),int(bclk),int(ws),int(data),int(flags),exclusive))
}
