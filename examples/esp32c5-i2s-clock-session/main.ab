import "../../src/esp32/i2s/clock_session_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_i2s_clock_session_example")
trusted fun example(r: NativeBuffer,tx: bool,source: int,integer: int,numerator: int,denominator: int,bclk: int,polls: int,exclusive: bool,close: bool): int =
    if (close) c5I2sClockSessionCloseOwned(r,exclusive) else c5I2sClockSessionOpenOwned(r,tx,source,integer,numerator,denominator,bclk,polls,exclusive)
