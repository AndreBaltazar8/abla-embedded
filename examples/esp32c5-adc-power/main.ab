import "../../src/esp32/adc_power_esp32c5.ab"
import "abla/build"
import "../../src/esp32/adc_power_c5_sequence.ab"
@export("abla_esp32c5_adc_power_example")
trusted fun example(owner: C5AdcPowerOwner,exclusiveStopped: bool,close: bool): C5AdcPowerOwner =
    if (close) owner.closeOwned(exclusiveStopped) else c5AdcPowerOpenOwned(exclusiveStopped)
