import "../../src/esp32/gpio/lp_wake_pad_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller has parked EXT1/PMU, pinned LP clocks/power and released global holds.
@export("abla_esp32c5_wake_pad_example")
trusted fun open(pin: int,exclusive: bool): C5WakePad = esp32C5WakePadOpenOwned(pin,exclusive)
