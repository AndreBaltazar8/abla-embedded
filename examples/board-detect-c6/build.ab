import "abla/compiler"

val target = #compilerDefineTarget(
    "esp32-riscv",
    "riscv32-esp-unknown-elf",
    "elf",
    "none",
    "none",
    false,
    false
)

val built = #compilerBuildProgram(
    "abla-embedded-board-detect-c6",
    "examples/board-detect-c6/main.ab",
    "build/examples/board-detect-c6/abla_app.o",
    "esp32-riscv",
    "object",
    false,
    false
)

fun main: int = if (target && built) 0 else 1
