import "../../src/esp32/serial_c6.ab"
import "../../src/m5stack/detect_esp32c6.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    val board = m5DetectCurrentEsp32C6()
    if (board == m5BoardStampC6) log.line("M5StampC6")
    else if (board == m5BoardNanoC6) log.line("M5NanoC6")
    else log.line("unknown ESP32-C6 board")
    return
}
