import "../../src/esp32/ledc_clock_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_ledc_clock_example")
trusted fun example(owner: C5LedcClockOwner,source: int,exclusiveStopped: bool,close: bool): C5LedcClockOwner =
    if (close) owner.closeOwned(exclusiveStopped) else c5LedcClockOpenOwned(source,exclusiveStopped,1000)
