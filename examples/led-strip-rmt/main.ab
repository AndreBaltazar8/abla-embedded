import "../../src/esp32/task.ab"
import "../../src/led/rmt_strip.ab"

@export("app_main")
trusted fun appMain(): void {
    // Atom Echo has one SK6812-compatible RGB LED on GPIO27. The example is
    // intentionally quiet and always switches the LED off before returning.
    val led = rmtLedStrip(27)
    if (led.begin()) {
        led.setAutoDisplay(false)
        led.setColor(0, rgbColor(0, 8, 0))
        led.display()
        taskDelay(250)
        led.setAllColor(rgbColor(0, 0, 0))
        led.display()
        led.close()
    }
    return
}
