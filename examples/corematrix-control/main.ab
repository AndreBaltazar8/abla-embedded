import "../../src/m5stack/corematrix_control_esp32c61.ab"
import "abla/build"
// Caller initializes fresh64B owner and retains it across failure/retry.
// Callable only, not a C61 boot image. No charge/rail configuration implied.
@export("abla_corematrix_control_example")
trusted fun example(storage: NativeBuffer,operation: int,xtalHz: int,rcFastHz: int): int {
    val owner=m5CoreMatrixControlAt(storage)
    if (operation == 0) return if (owner.initialize()) 1 else 0
    if (operation == 1) return owner.openOwned(xtalHz,rcFastHz,true)
    if (operation == 2) return if (owner.closeOwned(true)) 1 else 0
    return owner.status()
}
