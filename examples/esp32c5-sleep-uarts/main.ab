import "../../src/esp32/power/sleep_uarts_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5SleepUartsExample")
@export("abla_esp32c5_sleep_uarts_example")
trusted fun uarts(saved: Esp32C5SleepUarts,ports: int,drain: bool,polls: int,resume: bool,exclusive: bool): int =
    (if (resume) esp32C5SleepUartsResumeOwned(saved,exclusive) else esp32C5SleepUartsPrepareOwned(ports,drain,polls,exclusive))|0
