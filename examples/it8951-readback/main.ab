import "../../src/display/it8951_software_esp32.ab"
import "../../src/display/it8951_session_readback.ab"
import "abla/runtime/scalar"
import "abla/build"
// Raw image memory only; session must be ready and controller not refreshing.
@export("abla_it8951_readback_example")
trusted fun example(session: It8951Session,offset: int,destination: NativeBuffer,
    count: int,scratch: NativeBuffer,polls: int): It8951ImageResult =
    session.readImageWordsOwned(offset,destination,count,scratch,polls,true)
