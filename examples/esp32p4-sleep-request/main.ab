import "../../src/esp32/power/sleep_request_esp32p4.ab"
// Requires complete externally prepared sleep/resume environment. Not a boot
// image and not intended to run standalone on an unprepared device.
@export("abla_esp32p4_sleep_request_example")
trusted fun example(cachePolls: int,eventPolls: int,exclusivePrepared: bool): int =
    esp32p4SleepRequestPreparedOwned(cachePolls,eventPolls,exclusivePrepared)
