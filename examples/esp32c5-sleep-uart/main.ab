import "../../src/esp32/power/sleep_uart_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5SleepUartExample")
@export("abla_esp32c5_sleep_uart_example")
trusted fun uart(port: int,drain: bool,polls: int,resume: bool,exclusive: bool): int =
    if (resume) (if (esp32C5SleepUartResumeOwned(port,exclusive)) 1 else 0) else esp32C5SleepUartPrepareOwned(port,drain,polls,exclusive)
