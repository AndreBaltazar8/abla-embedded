import "../../src/m5stack/corematrix_control_esp32c61.ab"
import "../../src/m5stack/corematrix_tone_owner.ab"
import "abla/runtime/scalar"
import "abla/build"
// Initialize fresh56B storage once. Poll until closed; retain on errors and
// explicitly close before releasing board control or other shared PWM users.
@export("abla_corematrix_tone_example")
trusted fun example(tone: M5CoreMatrixTone,control: M5CoreMatrixControl,now: int,start: bool): int =
    if (start) tone.startOwned(control,1000,64,now,100,true) else tone.pollOwned(now,true)
