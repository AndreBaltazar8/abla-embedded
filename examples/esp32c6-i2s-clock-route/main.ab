import "../../src/esp32/i2s/clock_route_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_clock_route_example")
trusted fun example(owner: C6I2sClockRoute,port: int,transmit: bool,divider: int,exclusive: bool,close: bool): C6I2sClockRoute =
    if (close) owner.closeOwned(exclusive) else c6I2sClockRouteOpenOwned(port,transmit,divider,exclusive)
