import "../../src/esp32/gpio/probe_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable classic ESP32 object, not boot firmware. Own stopped HP/RTC/analog
// pad users/clocks and shared configuration; prevent sleep/global holds.
// Fresh32-byte record. op0open(pin,pull),1change pull,2read,3restore.
// Pull0none/1up/2down; input-only34..39 reject nonzero pulls. Board/package
// exposure is caller policy (e.g.GPIO20 exists only on ESP32-PICO-V3).
// Returns4 on partial setup/restore: retain record and ownership, retry close.
@export("abla_esp32_gpio_probe_example")
trusted fun probe(operation: int,record: NativeBuffer,pin: int,pull: int,exclusive: bool): int {
    if (operation == 0) return esp32GpioProbeOpenOwned(record,pin,pull,exclusive)
    if (operation == 1) return esp32GpioProbePullOwned(record,pull)
    if (operation == 2) return esp32GpioProbeReadOwned(record)
    if (operation == 3) return esp32GpioProbeCloseOwned(record,exclusive)
    return -1
}
