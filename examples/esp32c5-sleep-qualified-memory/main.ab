import "../../src/esp32/power/sleep_qualified_memory_cycle_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5QualifiedMemoryExample")
@export("abla_esp32c5_sleep_qualified_memory_example")
trusted fun sleep(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,suspendMask: int,action: int,exclusiveQualifiedChip: bool): int {
    if (action == 0) return esp32C5SleepQualifiedMemoryBeginOwned(record,request,context,suspendMask,exclusiveQualifiedChip)
    if (action == 1) return esp32C5SleepCycleContinueOwned(record,exclusiveQualifiedChip)
    if (action == 2) return esp32C5SleepQualifiedMemoryRecheckOwned(record,exclusiveQualifiedChip)
    return 2
}
