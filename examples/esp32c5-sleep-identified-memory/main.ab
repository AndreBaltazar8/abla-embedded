import "../../src/esp32/power/sleep_identified_memory_cycle_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../../src/esp32/sdk/raw_buffer.ab"
import "../../src/esp32/power/sleep_identified_memory_cycle_c5.ab"
import "../../src/esp32/power/sleep_cycle_c5_sequence.ab"
import "../../src/esp32/sdk/nativebuffer_type.ab"
@section(".iram1.abla.c5IdentifiedMemoryExample")
@export("abla_esp32c5_sleep_identified_memory_example")
trusted fun sleep(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,action: int,exclusive: bool): int {
    if (action == 0) return esp32C5SleepIdentifiedMemoryBeginOwned(record,request,context,exclusive)
    if (action == 1) return esp32C5SleepCycleContinueOwned(record,exclusive)
    if (action == 2) return esp32C5SleepIdentifiedMemoryRecheckOwned(record,exclusive)
    return 2
}
