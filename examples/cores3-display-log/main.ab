import "../../src/esp32/gpio_esp32s3.ab"
import "../../src/esp32/peripheral_delay_esp32s3.ab"
import "../../src/m5stack/display_software.ab"
import "./session.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun coreS3DisplayLogBlitOwned(gate: PeripheralGate,frame: NativeBuffer): SpiTransactionResult {
    val board=m5BoardStackCoreS3
    return board.softwareDisplay().blitRgb565(gate,u32(7),board.displayGeometry().view(board.displayRotation()),0,0,frame,120,32,240)
}
#exportFunction("coreS3DisplayLogExample", "abla_cores3_display_log_example")
