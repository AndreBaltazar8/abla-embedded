import "../../src/display/log_console.ab"
import "../../src/log_policy.ab"
import "../../src/spi/buffer_gate.ab"
import "../../src/spi/transaction_result.ab"
// Callable on an ALREADY initialized CoreS3 display in default boardrotation.
// Caller owns settled panelpower, SPI pads/otherCS and canonical gate. RAM
// framebuffer7680bytes is120x32RGB565BE, drawn at0,0. Single active console;
// no concurrent calls. Caller must retain frame/gate until operation3 closes.
// op0 initializesRAMonly; op1 appends+flushes; op2 retries flush WITHOUT append;
// op3 releasesRAM session only (does not shut down display). Return0success,
// -1invalid, -2pendingframe (flushbeforeappend/close), -(100+SPIstatus) transfer.
// Pending frame/cursor survive failure. No device initialization/cardwrites.
var frameAddress=0
var busGateAddress=0
var cursor=textCursor()
var pending=false
trusted fun logOutputOwned(target: int,level: int,color: bool,text: NativeBuffer,length: int,suffix: int): bool {
    if (target != 1 || frameAddress == 0 || pending) return false
    val next=cursor.logRgb565Owned(nativeBufferAt(frameAddress,7680),120,32,240,text,length,level,color,65535,0,suffix)
    if (!next.valid()) return false
    cursor=next
    pending=true
    return true
}
trusted fun coreS3DisplayLogExample(gateAddress: u32,bufferAddress: u32,operation: int,textAddress: u32,length: int,level: int): int {
    val gate=peripheralGateAt(int(gateAddress))
    val frame=nativeBufferAt(int(bufferAddress),7680)
    if (!gate.bufferDisjoint(frame,7680) || operation < 0 || operation > 3) return -1
    if (operation == 0) {
        if (frameAddress != 0) return -1
        var index=0
        while (index < 7680) { frame.store(index,0); index=index+1 }
        frameAddress=int(bufferAddress); busGateAddress=int(gateAddress); cursor=textCursor(); pending=true
        return 0
    }
    if (frameAddress != int(bufferAddress) || busGateAddress != int(gateAddress)) return -1
    if (operation == 3) {
        if (pending) return -2
        frameAddress=0; busGateAddress=0
        return 0
    }
    if (operation == 1) {
        if (pending) return -2
        if (length < 0 || length > 4096 || level < 0 || level > 5) return -1
        val policy=logPolicy().configure(0,0,false,false,0).configure(1,5,true,true,1)
        if (!policy.writeOwned(level,nativeBufferAt(int(textAddress),length),length,level != 0).succeeded()) return -1
    }
    if (!pending) return 0
    val result=coreS3DisplayLogBlitOwned(gate,frame)
    if (!result.valid()) return -100-result.status()
    pending=false
    return 0
}
