import "../../src/esp32/i2s/run_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_run_example")
trusted fun example(update: C6I2sUpdate,port: int,tx: bool,polls: int,exclusive: bool,stop: bool): int =
    if (stop) c6I2sStopOwned(port,tx,polls,exclusive) else c6I2sStartUpdatedOwned(update,exclusive)
