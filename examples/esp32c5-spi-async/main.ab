import "../../src/esp32/spi/async_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Low-level cooperative transfer: caller holds canonical SPI2 gate and owns
// CS/pads/clocks. op0 fresh initialization, op1 begin, op2 poll. No flash/build
// side effects. Keep RX/context pinned through completion and failure recovery.
@export("abla_esp32c5_spi_async_example")
trusted fun example(context: NativeBuffer,tx: NativeBuffer,rx: NativeBuffer,bytes: int,
    now: u32,budget: u32,receive: bool,operation: int): int {
    if (operation == 0) return if (esp32C5SpiAsyncInitialize(context)) 0 else 2
    if (operation == 1) return esp32C5SpiAsyncBeginOwned(context,tx,rx,bytes,now,budget,receive)
    if (operation == 2) return esp32C5SpiAsyncPollOwned(context,now)
    return 2
}
