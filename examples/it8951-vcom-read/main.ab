import "../../src/display/it8951_software_esp32.ab"
import "../../src/display/it8951_vcom.ab"
import "abla/runtime/scalar"
import "abla/build"
// Read-only example: never programs panel calibration.
@export("abla_it8951_vcom_read_example")
trusted fun example(session: It8951Session,scratch: NativeBuffer,polls: int): It8951VcomRead =
    session.readVcomRawOwned(scratch,polls,true)
