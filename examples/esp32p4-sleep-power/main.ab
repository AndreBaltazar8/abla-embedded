import "../../src/esp32/power/sleep_power_esp32p4.ab"
@export("abla_esp32p4_sleep_power_example")
trusted fun example(address: int,capacity: int,configAddress: int,configCapacity: int,layout: int,close: bool,exclusive: bool): int {
    val r=nativeBufferAt(address,capacity)
    if (close) return esp32p4SleepPowerCloseOwned(r,exclusive)
    return esp32p4SleepPowerOpenOwned(r,nativeBufferAt(configAddress,configCapacity),layout,exclusive)
}
