import "../../src/m5stack/pm1_audio_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller stores a successful open result and later closes it. No DMA start,
// implicit rail recovery or codec close on failure. Select one stopped mode.
@export("abla_pm1_board_audio_example")
trusted fun audio(control: M5Pm1Control,codec: Es8311,operation: int,exclusive: bool): int {
    if (operation == 0) return control.openAudioCodecOwned(exclusive)|0
    if (operation == 1) return control.speakerOwned(codec,true,exclusive)
    if (operation == 2) return control.speakerOwned(codec,false,exclusive)
    if (operation == 3) return control.microphoneOwned(codec,true,exclusive)
    if (operation == 4) return control.microphoneOwned(codec,false,exclusive)
    return 8
}
