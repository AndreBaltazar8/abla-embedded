import "../../src/esp32/i2c/hardware_jobs_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller has bound a ready owned P4 session and keeps all table/payload
// storage alive and immutable during the call. Not a flashable application.
@export("abla_esp32p4_i2c_provider_jobs_example")
trusted fun run(bus: int,address: int,count: int,frequency: int,timeoutMilliseconds: int): int =
    I2cBus(bus).runJobsStatus(nativeBufferAt(address,count*16),count,frequency,timeoutMilliseconds)
