import "../../src/esp32/spi/shared_pin_session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable only. Caller holds gate and all prior/new pad/matrix ownership.
@export("abla_esp32s3_spi_shared_pin_session_example")
trusted fun run(record: NativeBuffer,port: int,clock: Pin,data: Pin,cs: Pin,dc: Pin,close: bool,polls: int): int =
    if (close) esp32s3SpiSharedPinsCloseOwned(record,polls,true)
    else esp32s3SpiSharedPinsOpenOwned(record,port,clock,data,cs,dc,true)
