import "../../src/esp32/serial.ab"
import "../../src/imu/offsets_nvs.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    if (!nvsInitialize()) {
        log.line("NVS initialization failed")
        return
    }
    val offsets = imuOffsets()
    if (offsets.loadFromNvs("AblaImuDemo")) {
        log.line("IMU offsets loaded")
        return
    }
    offsets.clear()
    if (offsets.saveToNvs("AblaImuDemo")) {
        log.line("IMU offsets initialized")
    } else log.line("IMU offset persistence failed")
    return
}
