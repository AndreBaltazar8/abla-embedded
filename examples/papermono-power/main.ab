import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/papermono_power.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Call only after consuming desired wake events and opening both devices.
@export("abla_papermono_power_example")
trusted fun configure(expanders: M5Expanders,pmic: M5PmicOpen,exclusive: bool,wakeEventsConsumed: bool): int =
    expanders.configurePaperMonoPower(pmic,exclusive,wakeEventsConsumed)
