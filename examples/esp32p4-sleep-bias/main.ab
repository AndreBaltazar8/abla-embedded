import "../../src/esp32/power/sleep_bias_esp32p4.ab"
@export("abla_esp32p4_sleep_bias_example")
trusted fun example(address: int,capacity: int,hp: u32,lp: u32,deep: bool,close: bool,exclusive: bool): int {
    val r=nativeBufferAt(address,capacity)
    if (close) return esp32p4SleepBiasCloseOwned(r,exclusive)
    return esp32p4SleepBiasOpenOwned(r,hp,lp,deep,exclusive)
}
