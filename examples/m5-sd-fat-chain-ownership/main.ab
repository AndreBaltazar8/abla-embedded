import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3_write.ab"
import "../../src/storage/fat_chain_ownership.ab"
import "abla/runtime/scalar"
import "abla/build"
// Borrow an initialized reader and bitmap under the same volume-wide gate.
// This checks one chain, not a complete volume. No repair/write operation.
@export("abla_m5_sd_fat_chain_ownership_example")
trusted fun example(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,head: int,budget: int,scratch: NativeBuffer,bitmap: NativeBuffer): int =
    fatClaimChainOwned(reader,boot,first,sectors,head,budget,scratch,fatClusterOwnershipAt(bitmap))|0
