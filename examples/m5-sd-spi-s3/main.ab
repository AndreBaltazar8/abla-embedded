import "../../src/m5stack/sd_spi_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_m5_sd_spi_s3_example")
trusted fun storage(board: M5BoardId,record: S3SdMasterOwner,peripheral: int,gate: PeripheralGate,
    owner: u32,scratch: NativeBuffer,response: NativeBuffer,close: bool,exclusive: bool): int =
    if (close) (if (record.closeOwned(owner,exclusive)) 1 else 0)
    else board.openSdSpiOwned(record,peripheral,gate,owner,scratch,response,1000,exclusive)
