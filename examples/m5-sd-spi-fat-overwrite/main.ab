import "../../src/sd/master_owner_esp32s3.ab"
import "../../src/storage/fat_spi_s3_owner.ab"
import "../../src/storage/fat_spi_s3_write.ab"
import "abla/runtime/scalar"
import "abla/build"
// Live bound reader and exclusive filesystem ownership; data-only overwrite.
// Directory sector must belong to this mounted medium. No metadata updates.
@export("abla_m5_sd_spi_fat_overwrite_example")
trusted fun overwrite(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,directory: NativeBuffer,
    entry: int,offset: int,length: int,budget: int,source: NativeBuffer,workspace: NativeBuffer): FatFileOverwrite =
    fatFileOverwriteAtOwned(reader,boot,first,sectors,directory,entry,offset,length,budget,source,workspace)
