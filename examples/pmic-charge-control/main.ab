import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/pmic_charge.ab"
import "abla/runtime/scalar"
import "abla/build"
// Already opened PMIC and exclusive charge-policy ownership. Caller chooses
// limits appropriate to the actual battery. This example runs nothing on build.
@export("abla_pmic_charge_control_example")
trusted fun example(pmic: M5PmicOpen,operation: int,value: int,exclusive: bool): int =
    (if (operation == 0) pmic.setBatteryChargeOwned(value != 0,exclusive)
    else if (operation == 1) pmic.setChargeCurrentOwned(value,exclusive)
    else if (operation == 2) pmic.setChargeVoltageOwned(value,exclusive)
    else M5ChargeControlResult(2))|0
