import "../../src/sd/startup_esp32c61.ab"
import "abla/build"
@export("abla_esp32c61_sd_startup_example")
trusted fun example(master: Esp32C61SpiMaster,gate: PeripheralGate,owner: u32,sourceHz: int,
    scratch: NativeBuffer,response: NativeBuffer): SdSpiInitResult =
    master.initializeSd(gate,owner,sourceHz,scratch,response)
