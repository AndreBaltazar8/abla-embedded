import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/cores3_audio_session.ab"
import "abla/runtime/scalar"
import "abla/build"
// One block on a running retained128B session. TX source or RX destination
// is separate from all ring/session storage. Busy can retry; faults require
// session close before reuse. Returned scalar retains bytes/cursor/events.
@export("abla_cores3_audio_session_pump_example")
trusted fun pump(r: NativeBuffer,pcm: NativeBuffer,polls: int,exclusive: bool): Esp32S3GdmaPumpResult =
    coreS3AudioSessionPumpOwned(r,pcm,polls,exclusive)
