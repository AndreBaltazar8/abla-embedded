import "../../src/esp32/i2s/pdm_pins_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable routing only, not boot/capture. Caller owns stopped RX/GDMA and
// pads/global inputs, released from RTC/USB/holds. Does not enable clocks.
@export("abla_esp32s3_pdm_pins_example")
trusted fun route(clock: int,data0: int,data1: int,data2: int,data3: int,
    slots: int,slave: bool,invertClock: bool): int =
    esp32s3PdmRoutePinsOwned(0,pdmPins(clock,data0,data1,data2,data3),slots,slave,invertClock)
