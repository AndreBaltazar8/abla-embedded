import "../../src/esp32/power/sleep_l2_esp32p4.ab"
@export("abla_esp32p4_sleep_l2_example")
trusted fun example(record: int,operation: int,polls: int,exclusive: bool): int {
    val r=nativeBufferAt(record,32)
    if (operation == 0) return esp32p4SleepL2OpenOwned(r,polls,exclusive)
    if (operation == 1) return esp32p4SleepL2ContinueOwned(r,polls,exclusive)
    if (operation == 2) return esp32p4SleepL2CloseOwned(r,polls,exclusive)
    return 2
}
