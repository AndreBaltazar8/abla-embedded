import "../../src/cooperative_timers.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable on caller-owned204-byte RAM; call operation0 once before using.
// operation1 arms a100ms interval,2 runs using supplied monotonic millis,
// 3 reads callback count. No GPIO, interrupts or clock assumptions.
var ticks=0
trusted fun cooperativeTimerDispatchOwned(owner: CooperativeTimers,id: int,token: u32): void {
    if (token == u32(1)) ticks=ticks+1
    return
}
trusted fun cooperativeTimersExample(address: u32,operation: int,now: u32): int {
    val timers=cooperativeTimersAt(int(address))
    if (operation == 0) { if (!timers.initialize()) return -1; ticks=0; return 0 }
    if (operation == 1) return timers.setInterval(u32(100),u32(1),now)
    if (operation == 2) return timers.run(now)
    if (operation == 3) return ticks
    return -1
}
#exportFunction("cooperativeTimersExample", "abla_cooperative_timers_example")
