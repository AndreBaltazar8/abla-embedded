import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/es8311_capture_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Zeroed132B retained record, initialized board/codec/bus and owned resources.
// op0prepare,1start,2close/retry,3read. This is not standalone boot firmware.
@export("abla_board_es8311_capture_example")
trusted fun capture(op: int,r: NativeBuffer,board: M5BoardId,hz: int,channel: int,desc: int,count: int,
    payload: int,bytes: int,owner: u32,codec: Es8311,io: M5Ioe1,output: NativeBuffer,polls: int,exclusive: bool): int {
    if (op == 0) return board.beginEs8311CaptureOwned(r,hz,channel,desc,count,payload,bytes,owner,codec,io,exclusive)
    if (op == 1) return m5Es8311CaptureStartOwned(r,polls,exclusive)
    if (op == 2) return m5Es8311CaptureCloseOwned(r,polls,exclusive)
    if (op == 3) return m5Es8311CaptureReadOwned(r,output,polls,exclusive)|0
    return 0
}
