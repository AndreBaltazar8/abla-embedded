import "../../src/esp32/i2s/audio_rx_setup_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_audio_rx_setup_example")
trusted fun example(r: NativeBuffer,operation: int,channel: int,bytes: int,bclk: int,ws: int,data: int,mclk: int,polls: int,exclusive: bool): int {
    if (operation == 0) return c6AudioRxSetupOpenOwned(r,channel,bytes,1,78,1,8,2,bclk,ws,data,mclk,16,16,16,true,polls,exclusive)
    if (operation == 1) return c6AudioRxSetupWaitOwned(r,polls,exclusive)
    if (operation == 2) return c6AudioRxSetupCloseOwned(r,polls,exclusive)
    return 2
}
