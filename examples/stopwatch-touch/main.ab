import "../../src/m5stack/stopwatch_touch_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Return pending ownership to caller; poll with a6-byte snapshot, assign each
// returned session and consume only fresh() reports. close() retains failures.
@export("abla_stopwatch_touch_example")
trusted fun open(control: M5Pm1Control,exclusive: bool): int = control.openStopWatchTouchOwned(exclusive)|0
