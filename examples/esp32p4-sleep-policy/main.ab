import "../../src/esp32/power/sleep_policy_esp32p4.ab"
@export("abla_esp32p4_sleep_policy_example")
trusted fun example(action: int,token: int,mask: u32,enabled: bool,cycles: int,protection: int,exclusive: bool): int {
    if (action == 0) return esp32p4SleepPolicyOpenOwned(mask,enabled,cycles,protection,exclusive)|0
    if (action == 1) return P4SleepPolicy(token).closeOwned(exclusive)|0
    if (action == 2) return int(esp32p4SleepWakeCause())
    if (action == 3) return int(esp32p4SleepRejectCause())
    if (action == 4) return esp32p4SleepEvents()
    if (action == 5) return if (esp32p4SleepAcknowledgeOwned(cycles,enabled,exclusive)) 1 else 0
    return token
}
