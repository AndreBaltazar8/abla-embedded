import "../../src/m5stack/pm1_rtc_owner_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// On close, pass the prior open result.handle(). No time/alarm changes.
@export("abla_pm1_board_rtc_owner_example")
trusted fun example(control: M5Pm1Control,rtc: int,close: bool,exclusive: bool,eventsConsumed: bool): int =
    if (close) (if (control.closeRetainedRtcOwned(rtc,exclusive)) 1 else 0) else control.openRetainedRtcOwned(exclusive,eventsConsumed)|0
