import "../../src/esp32/power/sleep_analog_defaults_p4.ab"
@export("abla_esp32p4_sleep_analog_defaults_example")
trusted fun example(address: int,capacity: int,flags: u32,revision: int,deep: bool,psram: bool,
    sleepDcmVset: int,activeHpDbias: int,activeLpDbias: int): bool =
    esp32p4SleepAnalogDefaults(nativeBufferAt(address,capacity),flags,revision,deep,psram,sleepDcmVset,activeHpDbias,activeLpDbias)
