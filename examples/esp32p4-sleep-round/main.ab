import "../../src/esp32/power/sleep_round_esp32p4.ab"
@export("abla_esp32p4_sleep_round_example")
trusted fun example(record: int,config: int,graph: int,graphBytes: int,backing: int,backingBytes: int,smp: int,generation: int,begin: bool,sourcesReady: bool,otherPolicyReady: bool,exclusive: bool): int =
    if (begin) esp32p4SleepRoundOpenOwned(nativeBufferAt(record,2168),nativeBufferAt(config,192),nativeBufferAt(graph,graphBytes),nativeBufferAt(backing,backingBytes),nativeBufferAt(smp,4),generation,exclusive)
    else esp32p4SleepRoundContinueOwned(nativeBufferAt(record,2168),32,32,sourcesReady,otherPolicyReady,exclusive)
