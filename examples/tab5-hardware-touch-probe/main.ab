import "../../src/m5stack/control_bus_hardware_esp32p4.ab"
import "../../src/esp32/i2c/hardware_prepared_scan_esp32p4.ab"
import "../../src/m5stack/tab5_touch_probe.ab"
import "../../src/m5stack/tab5_touch_profile.ab"
import "abla/runtime/scalar"
// Powered/reset panel, exclusive physical single-master scan interval.
// Returned GT candidate is not panel identification: verify ILI9881C separately.
@export("abla_tab5_hardware_touch_probe_example")
trusted fun example(action: int,record: int,layout: int,cpuHz: u32,handle: int): int {
    val r=nativeBufferAt(record,96)
    if (action == 0) return m5P4HardwareControlOpenOwned(r,m5BoardTab5,0,layout,u32(40000000),cpuHz,true)
    if (action == 1) return st7123(m5P4HardwareControlDeviceBus(r),85,100000)|0
    if (action == 2) return m5BoardTab5.probeTab5Touch(m5P4HardwareControlDeviceBus(r),St7123(handle))|0
    if (action == 3) return if (St7123(handle).close()) 1 else 0
    if (action == 4) return m5P4HardwareControlCloseOwned(r,true)
    return 0
}
