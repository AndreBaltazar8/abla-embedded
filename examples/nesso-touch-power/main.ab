import "../../src/m5stack/nesso_touch_power_esp32c6.ab"
import "abla/build"
// Return value MUST replace touch. Only use after quiescing all sharedGPIO3
// consumers; not a substitute for coordinated board/system power management.
@export("abla_nesso_touch_power_example")
trusted fun example(bus: int,touch: TouchControllerOpen,wake: bool,sharedIrqQuiesced: bool): TouchControllerOpen =
    if (wake) nessoTouchWakeOwned(bus,touch,sharedIrqQuiesced) else nessoTouchSleepOwned(bus,touch,sharedIrqQuiesced)
