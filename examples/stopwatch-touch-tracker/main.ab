import "../../src/m5stack/stopwatch_touch_tracker_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
@export("abla_stopwatch_touch_tracker_example")
trusted fun update(control: M5Pm1Control,session: Cst816sSession,tracker: TouchTracker,
    snapshot: NativeBuffer,now: int,rotation: int,exclusive: bool): int =
    control.updateStopWatchTouchOwned(session,tracker,snapshot,now,rotation,exclusive)|0
