import "../../src/m5stack/pm1_wake_pins_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Existing configured controller; all specified RTC/digital pad users released.
@export("abla_pm1_board_wake_pins_example")
trusted fun configure(control: M5Pm1Control,exclusiveWakeDisarmed: bool): int =
    control.configureWakePinsOwned(exclusiveWakeDisarmed)
