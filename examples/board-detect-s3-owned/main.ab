import "../../src/m5stack/detect_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Exclusive zeroed88B record, retain through failed cleanup. Caller owns
// quiescent pad users/holds/sleep/configuration and calibrated ROM delay.
// op0 begin,1 retry cleanup,2 result. Not a flashable boot image.
@export("abla_board_detect_s3_owned_example")
trusted fun detect(operation: int,record: NativeBuffer,current: M5BoardId,exclusive: bool): int {
    if (operation == 0) return m5DetectCurrentEsp32S3Owned(record,current,exclusive)
    if (operation == 1) return m5S3OwnedDetectCleanup(record,exclusive)
    if (operation == 2) return m5S3OwnedDetectResult(record)|0
    return 0
}
