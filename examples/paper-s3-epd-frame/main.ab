import "../../src/display/epd_scanout_esp32s3.ab"
import "../../src/display/epd_frame_sequence.ab"
import "../../src/display/epd_canvas_clip.ab"
import "../../src/display/epd_canvas_submit_logical.ab"
import "abla/build"
// Consumes an already attached scanout and initialized 960x540 waveform state.
@export("abla_paper_s3_epd_frame_example")
fun example(action: int,record: NativeBuffer,scanout: NativeBuffer,transport: NativeBuffer,framebuffer: NativeBuffer,nowMs: int,exclusive: bool,canvas: NativeBuffer,x: int,y: int,w: int,h: int,gray: int,mode: int): int {
    if (action == 0) return epdFrameAttachOwned(record,scanout,transport,framebuffer,960,8,exclusive)
    if (action == 1) return epdFrameStartOwned(record,scanout,transport,framebuffer,exclusive)
    if (action == 2) return epdFramePumpOwned(record,scanout,transport,framebuffer,nowMs,exclusive)
    if (action == 3) return epdFrameCloseOwned(record,scanout,transport,framebuffer,exclusive)
    // Drawing is separate from submission. This entry uses logical rotation0
    // with clipping; the reusable helpers accept all8 rotations.
    if (!exclusive || !epdFrameValid(record,scanout,transport,framebuffer) || record.loadU32(4) != 1 ||
        !canvas.hasAddressRange(0,259200) || !epdWaveformDisjoint(canvas,259200,record,48) ||
        !epdWaveformDisjoint(canvas,259200,scanout,32) || !epdWaveformDisjoint(canvas,259200,transport,160) ||
        !epdWaveformDisjoint(canvas,259200,framebuffer,1036800) ||
        !epdWaveformDisjoint(canvas,259200,nativeBufferAt(transport.loadU32(20),transport.loadU32(24)),transport.loadU32(24)) ||
        !epdWaveformDisjoint(canvas,259200,nativeBufferAt(transport.loadU32(28),transport.loadU32(32)),transport.loadU32(32))) return 3
    if (action == 4) return if (epdCanvasDrawClippedOwned(canvas,960,540,x,y,w,h,0,canvas,0,gray,mode,true)) 1 else 3
    if (action == 5) return if (epdCanvasSubmitLogicalOwned(canvas,framebuffer,960,540,x,y,w,h,0,mode,true)) 1 else 3
    return 3
}
