import "../../src/m5stack/atom_s3r_display_session.ab"
import "abla/runtime/scalar"
import "abla/build"
// Action0begin,1brightness,2blank,3from successful closed probe. Fresh40B record for begin only; caller keeps
// all configured SPI/I2C/panel ownership. Blanking does not release resources.
@export("abla_atom_s3r_display_session_example")
trusted fun run(r: NativeBuffer,action: int,id: int,device: I2cDevice,gate: PeripheralGate,
    owner: u32,port: int,rotation: int,brightness: int,probe: NativeBuffer,polls: int,
    pixels: NativeBuffer,width: int,height: int,stride: int,staging: NativeBuffer): int {
    if (action == 0) return atomS3RDisplaySessionBeginOwned(r,atomS3PanelFromId(m5BoardAtomS3R,id),device,gate,owner,port,rotation,brightness,true)
    if (action == 1) return atomS3RDisplaySessionBrightnessOwned(r,brightness,true)
    if (action == 2) return atomS3RDisplaySessionBlankOwned(r,true)
    if (action == 3) return atomS3RDisplayFromProbeOwned(r,probe,device,rotation,brightness,polls,true)
    if (action == 4) return atomS3RDisplayFillOwned(r,0,0,width,height,Rgb565(brightness&65535),true).status()
    if (action == 5) return atomS3RDisplayBlitOwned(r,0,0,pixels,width,height,stride,false,staging,true).status()
    return 2
}
