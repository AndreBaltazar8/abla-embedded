import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/es8311_playback_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Zeroed136B retained session, initialized PCM ring with boardmono/stereo
// layout. Caller owns stopped I2S/GDMA/pads/wholecodec and all rail consumers.
// op0prepare,1start,2close/retry,3refill. Not standalone boot firmware.
@export("abla_board_es8311_playback_example")
trusted fun playback(op: int,r: NativeBuffer,board: M5BoardId,hz: int,channel: int,desc: int,count: int,
    payload: int,bytes: int,owner: u32,codec: Es8311,pm1: M5Pm1,io: M5Ioe1,input: NativeBuffer,polls: int,exclusive: bool): int {
    if (op == 0) return board.beginEs8311PlaybackOwned(r,hz,channel,desc,count,payload,bytes,owner,codec,pm1,io,exclusive)
    if (op == 1) return m5Es8311PlaybackStartOwned(r,polls,exclusive)
    if (op == 2) return m5Es8311PlaybackCloseOwned(r,polls,exclusive)
    if (op == 3) return m5Es8311PlaybackWriteOwned(r,input,polls,exclusive)|0
    return 0
}
