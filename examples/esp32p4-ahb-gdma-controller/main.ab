import "../../src/esp32/ahb_gdma_controller_esp32p4.ab"
import "abla/runtime/scalar"
// Explicit whole-controller bootstrap with Espressif's default address window.
// Never call while another AHB-DMA client owns any configured channel.
@export("abla_esp32p4_ahb_gdma_controller_example")
trusted fun initialize(exclusive: bool): i32 {
    i32(esp32p4AhbGdmaControllerInitializeOwned(0x40000000,0x4ffc0000,exclusive))
}
