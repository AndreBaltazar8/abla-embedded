import "../../src/esp32/adc1_session_esp32s3.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
// Callable S3 ADC1 example, NOT a boot/flash image and NOT for classic Atom.
// Channel0..9 maps GPIO1..10; board/sensor availability is the caller's choice.
// Caller owns ADC1/pad/analog bus, stops touch/ULP/DMA/sleep changes, provides
// stable RTC_FAST/CPU clocks and external sensor/divider supplies. Exclusive
// flags are lifetime promises excluding SAR/PWDET/temperature/other users;
// otherwise pin existing upstream force-on power/prepared-bus leases.
// ROM bus waits require an independent watchdog. ROM delay40000600 requires
// calibrated CPU ticks/us. Caller chooses post-setup settling for its circuit.
// op0 measure,1 retry cleanup,2 last mV,3 retained owner. Publish mV only after
// acquisition, calibration AND cleanup succeed. Cleanup failures take priority.
// Negative: -1 args/busy,-100-status open,-200-status start,-300-status poll,
// -400 calibration unavailable,-500-status cleanup. Never discards live owner.
var adcSession=Esp32S3Adc1Session(0)
var adcLastMillivolts=-1
@export("abla_esp32s3_adc_example")
trusted fun adcExample(operation: int,channel: int,attenuation: int,settlingMicros: int,exclusivePower: bool,exclusiveBus: bool): int {
    if (operation == 1) {
        adcSession=adcSession.closeOwned(100000)
        return if (adcSession.status() == 0) 0 else -500-adcSession.status()
    }
    if (operation == 2) return adcLastMillivolts
    if (operation == 3) return adcSession.bits()
    if (operation != 0 || adcSession.bits() != 0 || channel < 0 || channel > 9 || attenuation < 0 || attenuation > 3 || settlingMicros < 1 || settlingMicros > 1000000) return -1
    adcLastMillivolts=-1
    val calibration=esp32S3AdcReadCalibration(1,attenuation)
    if (!calibration.valid()) return -400
    adcSession=esp32S3Adc1SessionOpenOwned(channel,calibration,exclusivePower,exclusiveBus,100000)
    var result=-100-adcSession.status()
    if (adcSession.ready()) {
        callNativeVoidI32(0x40000600,settlingMicros)
        adcSession=adcSession.startAfterSettlingOwned(100000)
        result=-200-adcSession.status()
        if (adcSession.status() == 1) {
            adcSession=adcSession.pollOwned(100000)
            result=-300-adcSession.status()
            if (adcSession.status() == 1) {
                val mv=adcSession.millivolts(calibration)
                result=if (mv < 0) -400 else mv
            }
        }
    }
    adcSession=adcSession.closeOwned(100000)
    if (adcSession.status() != 0) return -500-adcSession.status()
    if (result >= 0) adcLastMillivolts=result
    return result
}
