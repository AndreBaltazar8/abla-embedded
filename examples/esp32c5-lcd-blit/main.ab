import "../../src/display/spi_blit_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_lcd_blit_example")
trusted fun example(master: Esp32C5SpiMaster,gate: PeripheralGate,owner: u32,dc: int,
    view: LcdView,x: int,y: int,source: NativeBuffer,width: int,height: int,stride: int,
    littleEndian: bool,staging: NativeBuffer): C5LcdDrawResult =
    esp32C5LcdBlitRgb565(master,gate,owner,dc,view,x,y,source,width,height,stride,littleEndian,staging,1000)
