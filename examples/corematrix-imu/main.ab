import "../../src/m5stack/corematrix_imu_esp32c61.ab"
import "abla/runtime/scalar"
import "abla/build"
// Independent C61 callable composition, not a board boot image. Fresh IMU
// storage must be initialized first; close child before closing control.
@export("abla_corematrix_imu_example")
trusted fun example(control: M5CoreMatrixControl,imu: M5ImuOwner,operation: int,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int {
    if (operation == 0) return control.openImuPreparedOwned(imu,true)
    if (operation == 1) return imu.updateSnapshot(snapshot,scratch,micros)|0
    if (operation == 2) return if (control.closeImuOwned(imu,true)) 1 else 0
    return -1
}
