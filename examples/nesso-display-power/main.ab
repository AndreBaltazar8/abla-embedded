import "../../src/esp32/i2c_software_esp32c6.ab"
import "../../src/m5stack/nesso_display_power.ab"
import "abla/runtime/scalar"
import "abla/build"
// Native callable, not a boot image. Borrow begun E1 at0x44 on Nesso's current
// C6 session. Explicit exclusive ownership includes all E1 users/LCD CS.
// operation0 performs whole-expander startup; operation1 only sets backlight.
@export("abla_nesso_display_power_example")
trusted fun example(io: Pi4Ioe5v6408,operation: int,brightness: int,exclusive: bool): int {
    if (operation == 0) return io.prepareNessoDisplayOwned(exclusive)
    if (operation == 1) return if (io.setNessoBacklightOwned(brightness,exclusive)) 1 else 4
    return 3
}
