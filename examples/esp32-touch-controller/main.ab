import "../../src/esp32/touch/controller_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable classic ESP32 object, not boot firmware. Own idle controller,
// prepared RTC pads and stable clocks, with touch IRQ/repeated timer disabled.
// Open a fresh zero-magic24-byte RAM record before esp32-touch-scan. Keep
// record through every scan and close ONLY after hardware is idle again.
// Configure hardware ticks (not us) against actual fast/slow clock frequency.
// Failed setup/close retains snapshot for explicit recovery; no automatic reset.
@export("abla_esp32_touch_controller_example")
trusted fun configure(close: bool,record: NativeBuffer,channels: int,waitTicks: int,chargeTicks: int,intervalTicks: int,high: int,low: int,above: bool,both: bool,exclusiveIdle: bool): int {
    if (close) return esp32TouchControllerCloseOwned(record,exclusiveIdle)
    return esp32TouchControllerOpenOwned(record,channels,waitTicks,chargeTicks,intervalTicks,high,low,above,both,exclusiveIdle)
}
