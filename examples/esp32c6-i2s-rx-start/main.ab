import "../../src/esp32/i2s/dma_start_esp32c6.ab"
import "../../src/esp32/i2s/dma_stop_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_rx_start_example")
trusted fun example(r: NativeBuffer,stop: NativeBuffer,operation: int,channel: int,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,exclusive: bool): int {
    if (operation == 0) return c6I2sDmaStartBeginOwned(r,channel,descriptors,count,buffers,stride,bytes,false,polls,exclusive,false)
    if (operation == 1) return c6I2sDmaStartAdvanceOwned(r,polls,exclusive)
    if (operation == 2) return c6I2sDmaStopOwned(r,stop,polls,exclusive)
    return 2
}
