import "../../src/m5stack/nesso_touch_esp32c6.ab"
import "abla/build"
// Callable, not boot image. Action0 opens; action1 closes and returns the
// replacement owner. Keep both display and shared session alive while used.
@export("abla_nesso_touch_example")
trusted fun example(display: NessoDisplay,bus: int,touch: TouchControllerOpen,action: int,exclusive: bool): TouchControllerOpen {
    if (!exclusive) return touch
    if (action == 0 && touch == 0) return display.openTouchOwned(bus,true)
    if (action == 1) return touch.closeOwned()
    return touch
}
