import "../../src/m5stack/paper_s3_wake_wait.ab"
import "abla/build"
// Call with token0 to initialize; otherwise pass the returned scalar again
// after its requested retry delay. Final release must precede quiescence.
@export("abla_paper_s3_wake_wait_example")
fun example(token: int,touch: int,scratch: int,exclusive: bool): int {
    val wait=if (token == 0) paperS3WakeWait(touch) else PaperS3WakeWait(token)
    return wait.updateOwned(nativeBufferAt(scratch,40),exclusive)|0
}
