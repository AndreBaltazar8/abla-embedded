import "../../src/esp32/power/sleep_analog_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32c5_sleep_analog_example")
trusted fun analog(output: NativeBuffer,deep: bool,xtalDown: bool,rcFastDown: bool,
    xtalFast: bool,lpFast: bool,lightAtten: int,lightBias: int,deepAtten: int,
    deepBias: int,activeHp: int,activeLp: int): bool =
    esp32C5SleepAnalogCalibrated(output,deep,xtalDown,rcFastDown,xtalFast,lpFast,
        lightAtten,lightBias,deepAtten,deepBias,activeHp,activeLp)
