import "../../src/esp32/cpu_clock_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5CpuClockExample")
@export("abla_esp32c5_cpu_clock_example")
trusted fun clock(plan: C5CpuClock,capture: bool,exclusive: bool): int =
    if (capture) esp32C5CpuClockCaptureOwned(exclusive)|0 else plan.applyOwned(exclusive)
