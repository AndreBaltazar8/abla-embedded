import "../../src/esp32/power/sleep_wake_route_esp32p4.ab"
@export("abla_esp32p4_sleep_wake_route_example")
trusted fun example(record: int,address: int,action: int,exclusive: bool): int =
    if (action == 0) esp32p4SleepWakeRouteOpenOwned(nativeBufferAt(record,24),address,exclusive)
    else if (action == 1) esp32p4SleepWakeRouteContinueOwned(nativeBufferAt(record,24),exclusive)
    else if (action == 2) esp32p4SleepWakeRouteCloseOwned(nativeBufferAt(record,24),exclusive)
    else 2
