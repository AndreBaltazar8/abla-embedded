import "../../src/esp32/button.ab"
import "abla/runtime/scalar"
import "abla/build"
// Compatibility entry for the original timer-backed API. Caller owns GPIO
// and initialized timer-group timebase. No runtime parser should be retained.
@export("abla_esp32_button_classic_example")
trusted fun example(button: GpioButton): GpioButton = button.update()
