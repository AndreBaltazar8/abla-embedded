import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/power/axp192_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_axp192_current_checked_example")
trusted fun example(sensor: Axp192,field: int): PowerMeasurement {
    if (field == 0) return sensor.acinMilliampsChecked()
    if (field == 1) return sensor.vbusMilliampsChecked()
    if (field == 2) return sensor.batteryChargeMilliampsChecked()
    if (field == 3) return sensor.batteryDischargeMilliampsChecked()
    if (field == 4) return sensor.batteryMilliwattsChecked()
    if (field == 5) return sensor.batteryMilliampsChecked()
    return PowerMeasurement(0)
}
