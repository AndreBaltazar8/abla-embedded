import "../../src/display/ssd1677_transport_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Initialized idle SSD1677, native PaperMono SPI2. No activation/history commit.
@export("abla_papermono_upload_example")
trusted fun upload(gate: PeripheralGate,owner: u32,canvas: NativeBuffer,history: NativeBuffer,
    mode: int,odd: bool,invert: bool,x: int,y: int,w: int,h: int,exclusiveIdle: bool): int =
    esp32s3Ssd1677Upload(gate,owner,2,spiPins(14,-1,15),Pin(16),Pin(17),canvas,history,
        800,480,mode,odd,invert,x,y,w,h,exclusiveIdle)|0
