import "../../src/storage/fat_cluster_ownership.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_cluster_ownership_example")
trusted fun example(storage: NativeBuffer,value: int,operation: int): int {
    val tracker=fatClusterOwnershipAt(storage)
    if (operation == 0) return if (tracker.initialize(value)) 1 else 2
    if (operation == 1) return tracker.claim(value)
    if (operation == 2) return tracker.lookup(value)
    return 2
}
