import "../../src/m5stack/paper_display_owner_esp32.ab"
import "../../src/m5stack/paper_display_operations.ab"
import "abla/runtime/scalar"
import "abla/build"
// Already-open parent; complete physical960x540 packed4bpp image. All metadata
// and bus checks pass through the parent. Failure retains resources for repair.
@export("abla_paper_display_frame_example")
trusted fun example(parent: M5PaperDisplayOwner,pixels: NativeBuffer,stride: int,
    scratch: NativeBuffer,polls: int): int {
    if (!parent.loadFullOwned(pixels,stride,scratch,polls,3000,true).success()) return -1
    if (!parent.refreshFullOwned(2,scratch,polls,3000,true).success()) return -2
    if (parent.waitDisplayOwned(scratch,polls,3000,true) != 1) return -3
    if (!parent.shutdownOwned(scratch,polls,3000,true)) return -4
    return 0
}
