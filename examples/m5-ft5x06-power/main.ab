import "../../src/m5stack/ft5x06_power_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_m5_ft5x06_power_example")
trusted fun power(board: M5BoardId,bus: I2cBus,touch: TouchControllerOpen,wake: bool,exclusive: bool): int =
    (if (wake) board.wakeFt5x06TouchOwned(bus,touch,exclusive) else board.sleepFt5x06TouchOwned(bus,touch,exclusive))|0
