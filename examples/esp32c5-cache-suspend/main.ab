import "../../src/esp32/cache_suspend_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable primitive, NOT a sleep routine. Caller owns retained execution and
// exclusivity through both calls, and restores flash readiness before resume.
@section(".iram1.abla.c5CacheExample")
@export("abla_esp32c5_cache_suspend_example")
trusted fun cache(saved: Esp32C5CacheSuspendState,resume: bool): int {
    if (resume) { esp32C5CacheResumeOwned(saved);return 0 }
    esp32C5CacheSuspendOwned()|0
}
