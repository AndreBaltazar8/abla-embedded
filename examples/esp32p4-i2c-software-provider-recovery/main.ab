import "../../src/esp32/i2c/software_provider_p4.ab"
import "../../src/esp32/i2c/software_bus_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Clocks/pad leases and single-master recovery consent belong to the caller.
// Preserve successful bus handles; setup failure retains pads until recovery
// or explicit abort. No automatic pulses or retry in ordinary construction.
@export("abla_esp32p4_i2c_software_provider_recovery_example")
fun example(action: int,bus: I2cBus,sda: int,scl: int,clearStuck: bool): int {
    if (action == 0) return i2cSoftwareMaster(sda,scl)|0
    if (action == 1) return i2cSoftwareRecoverSetup(clearStuck)|0
    if (action == 2) return bus.recoverStatus(1000,clearStuck)
    if (action == 3) return if (bus.close()) 1 else 0
    if (action == 4) return if (esp32P4SoftwareI2cAbortSetup()) 1 else 0
    return 0
}
