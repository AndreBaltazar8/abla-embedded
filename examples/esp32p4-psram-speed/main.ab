import "../../src/esp32/psram/speed_esp32p4.ab"
@export("abla_esp32p4_psram_speed_example")
trusted fun example(record: int,mhz: int,polls: int,action: int,cpuClockRestored: bool,exclusive: bool): int {
    val r=nativeBufferAt(record,112)
    if (action == 0) return esp32p4PsramSpeedOpenOwned(r,mhz,polls,exclusive)
    if (action == 1) return esp32p4PsramSpeedContinueOwned(r,polls,exclusive)
    if (action == 2) return esp32p4PsramSpeedCloseOwned(r,polls,cpuClockRestored,exclusive)
    return 2
}
