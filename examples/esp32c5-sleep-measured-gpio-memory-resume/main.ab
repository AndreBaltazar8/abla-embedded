import "../../src/esp32/power/sleep_measured_gpio_memory_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@section(".iram1.abla.c5MeasuredGpioMemoryResumeExample")
@export("abla_esp32c5_sleep_measured_gpio_memory_resume_example")
trusted fun resume(record: NativeBuffer,recheck: bool,exclusive: bool): int =
    if (recheck) esp32C5SleepMeasuredGpioMemoryRecheckOwned(record,exclusive) else esp32C5SleepMeasuredAfterCalibrationOwned(record,exclusive)
