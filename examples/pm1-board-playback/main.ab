import "../../src/m5stack/pm1_playback_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Borrowed control/codec; retain on close3. Initialized PCM ring required.
// Operations0prepare1start2close3refill. Caller owns disjoint PCM input.
@export("abla_pm1_board_playback_example")
trusted fun playback(op: int,r: NativeBuffer,control: M5Pm1Control,hz: int,channel: int,desc: int,count: int,
    payload: int,bytes: int,owner: u32,codec: Es8311,input: NativeBuffer,polls: int,exclusive: bool): int {
    if (op == 0) return control.beginAudioPlaybackOwned(r,hz,channel,desc,count,payload,bytes,owner,codec,exclusive)
    if (op == 1) return m5Es8311PlaybackStartOwned(r,polls,exclusive)
    if (op == 2) return m5Es8311PlaybackCloseOwned(r,polls,exclusive)
    if (op == 3) return m5Es8311PlaybackWriteOwned(r,input,polls,exclusive)|0
    return 0
}
