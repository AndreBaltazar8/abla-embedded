import "../../src/m5stack/atom_echo.ab"
import "../../src/esp32/serial.ab"
import "../../src/arduino/time.ab"

val board = m5AtomEcho()
val log = serial()
var scanned = false

fun hexadecimalDigit(value: int): int =
    if (value < 10) 48 + value else 55 + value

trusted fun printAddress(address: int): void {
    log.write("device at 0x")
    log.writeByte(hexadecimalDigit((address >>> 4) & 15))
    log.writeByte(hexadecimalDigit(address & 15))
    log.writeByte(10)
    return
}

@export("_Z5setupv")
trusted fun setup(): void {
    board.initialize()
    val bus = board.externalI2c()
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }
    var address = 8
    while (address < 120) {
        if (bus.probe(address)) printAddress(address)
        address = address + 1
    }
    log.line("I2C scan complete")
    scanned = true
    return
}

@export("_Z4loopv")
fun loop(): void = delay(if (scanned) 1000 else 100)
