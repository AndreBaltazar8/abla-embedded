import "../../src/audio/pcm_channels.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Serialized channel bank and immutable borrowed clips. Workspaces disjoint:
// accumulator8B/frame, scratch4B/frame, output4B(stereo) or2B(mono)/frame.
@export("abla_pcm_channels_output_example")
trusted fun render(bank: PcmChannels,frames: int,acc: NativeBuffer,scratch: NativeBuffer,
    output: NativeBuffer,stereo: bool,gain: int): bool =
    bank.renderOutput(frames,acc,scratch,output,stereo,gain)
