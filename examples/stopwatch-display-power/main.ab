import "../../src/m5stack/stopwatch_display_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Ready PM1 controller and exclusive quiesced OLED/touch/audio/power ownership.
@export("abla_stopwatch_display_power_example")
trusted fun prepare(control: M5Pm1Control,exclusive: bool): int =
    control.prepareStopWatchDisplayOwned(exclusive)
