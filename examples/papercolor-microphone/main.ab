import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/papercolor_microphone_esp32s3.ab"
import "abla/runtime/scalar"
import "../../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Caller owns rail GPIO45, initialized codec, clocks and stopped capture.
@export("abla_papercolor_microphone_example")
trusted fun microphone(codec: Es7210,enabled: bool,exclusive: bool): int =
    paperColorMicrophoneOwned(codec,enabled,exclusive)
