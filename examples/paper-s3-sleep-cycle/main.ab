import "../../src/m5stack/paper_s3_sleep_parked.ab"
import "abla/build"
// Callable lifecycle; caller actually implements normal/quiesced boundary
// and internal placement. NOT a flashable board application.
@export("abla_paper_s3_sleep_cycle_example")
fun example(action: int,record: int,cpu: int,tags: int,tagBytes: int,config: int,touch: int,scratch: int,exclusive: bool,quiesce: int): int {
    val r=nativeBufferAt(record,336);val c=nativeBufferAt(cpu,8800);val t=nativeBufferAt(tags,tagBytes);val cfg=nativeBufferAt(config,72)
    if (action == 0) return paperS3SleepCycleOpenOwned(r,c,t,cfg,touch,exclusive)
    if (action == 1) return paperS3SleepCyclePollOwned(r,c,t,cfg,nativeBufferAt(scratch,40),exclusive)
    if (action == 2) return paperS3SleepCycleContinueQuiescedOwned(r,c,t,cfg,exclusive)
    if (action == 3) return paperS3SleepCycleCancelNormalOwned(r,c,t,cfg,exclusive)
    if (action == 4) return paperS3SleepCycleCancelQuiescedOwned(r,c,t,cfg,exclusive)
    if (action == 5 || action == 6) return paperS3SleepCycleContinueParkedOwned(r,c,t,cfg,nativeBufferAt(quiesce,32),action == 6,exclusive)
    if (action == 7 || action == 8) return paperS3SleepCycleContinueScheduledOwned(r,c,t,cfg,nativeBufferAt(quiesce,64),action == 8,exclusive)
    return 9
}
