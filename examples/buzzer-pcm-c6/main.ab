import "../../src/audio/buzzer_delta_sigma.ab"
import "abla/runtime/scalar"
import "abla/build"
// Data conversion only; not an I2S/DMA driver or flashable program.
@export("abla_buzzer_pcm_c6_example")
trusted fun example(state: BuzzerDeltaSigma,source: NativeBuffer,destination: NativeBuffer,samples: int): BuzzerDeltaSigma =
    state.encodePcm16(source,destination,samples)
