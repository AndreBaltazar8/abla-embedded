import "../../src/esp32/pwm_session_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_pwm_session_example")
trusted fun example(record: NativeBuffer,source: int,sourceHz: int,hz: int,resolution: int,
    timer: int,channel: int,pin: int,duty: int,exclusive: bool,close: bool): int =
    if (close) c6PwmSessionCloseOwned(record,1000,exclusive)
    else c6PwmSessionOpenOwned(record,source,sourceHz,hz,resolution,timer,channel,pin,duty,1000,exclusive)
