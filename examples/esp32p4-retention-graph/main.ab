import "../../src/esp32/power/retention_graph_p4.ab"
@export("abla_esp32p4_retention_graph_example")
trusted fun example(out: int,outBytes: int,entries: int,configs: int,configBytes: int,scratch: int,uart: int,psram: bool,pvt: bool,minimumRevision: int): int =
    esp32p4RetentionGraphEncode(nativeBufferAt(out,outBytes),nativeBufferAt(entries,16),nativeBufferAt(configs,configBytes),nativeBufferAt(scratch,56),uart,psram,pvt,minimumRevision)
