import "../../src/display/i80_session_esp32s3.ab"
import "../../src/m5stack/paper_s3_epd_transport.ab"
import "../../src/display/epd_scanout_esp32s3.ab"
import "../../src/m5stack/paper_s3_epd.ab"
import "abla/build"
@export("abla_paper_s3_i80_session_example")
fun example(action: int,record: int,config: int,descriptors: int,descriptorBytes: int,payload: int,payloadBytes: int,channel: int,bytes: int,owner: int,polls: int,exclusive: bool,scanout: int,row: NativeBuffer,gray: NativeBuffer,mode: int): int {
    val r=nativeBufferAt(record,160);val cfg=nativeBufferAt(config,76)
    if (action == 0) return if (paperS3EpdTransportConfig(cfg)) 1 else 3
    if (action == 1) return esp32S3I80SessionOpenOwned(r,cfg,nativeBufferAt(descriptors,descriptorBytes),nativeBufferAt(payload,payloadBytes),8,channel,2,5,owner,polls,exclusive)
    if (action == 2) return esp32S3I80SessionSendOwned(r,bytes,exclusive)
    if (action == 3) return esp32S3I80SessionPollOwned(r,exclusive)
    if (action == 4) return esp32S3I80SessionCloseOwned(r,exclusive)
    // Choose raw transfers OR scanout ownership; don't mix raw actions2..4
    // after attach. All sources optimize together in this single target.
    val s=nativeBufferAt(scanout,32)
    if (action == 5) return epdScanoutAttachOwned(s,r,paperS3EpdGatePins(),248,540,exclusive)
    if (action == 6) return epdScanoutBeginFrameOwned(s,r,exclusive)
    if (action == 7) return epdScanoutSendLineOwned(s,r,exclusive)
    if (action == 8) return epdScanoutPollLineOwned(s,r,exclusive)
    if (action == 9) return epdScanoutEndFrameOwned(s,r,exclusive)
    if (action == 10) return epdScanoutCloseOwned(s,r,exclusive)
    // A caller-owned 960-pixel state row (1920B), or a slice of PSRAM state.
    if (action == 11) return if (epdWaveformInitialize(row,960,exclusive)) 1 else 3
    if (action == 12) return if (epdWaveformUpdateOwned(row,gray,480,mode,exclusive)) 1 else 3
    if (action == 13) return epdScanoutRenderLineOwned(s,r,row,960,8,exclusive)
    return 3
}
