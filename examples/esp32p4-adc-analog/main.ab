import "../../src/esp32/adc_analog_esp32p4.ab"
@export("abla_esp32p4_adc_analog_example")
trusted fun analog(unit: i32,initialCode: i32,polls: i32,saved: P4AdcAnalog,close: bool,exclusive: bool): int =
    if (close) saved.closeOwned(int(polls),exclusive)|0 else esp32p4AdcAnalogOpenOwned(int(unit),int(initialCode),int(polls),exclusive)|0
