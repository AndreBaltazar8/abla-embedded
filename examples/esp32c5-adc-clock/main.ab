import "../../src/esp32/adc_clock_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_adc_clock_example")
trusted fun example(owner: C5AdcClockOwner,source: int,exclusiveStopped: bool,close: bool): C5AdcClockOwner =
    if (close) owner.closeOwned(exclusiveStopped) else c5AdcClockOpenOwned(source,exclusiveStopped)
