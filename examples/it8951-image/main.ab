import "../../src/display/it8951_software_esp32.ab"
import "../../src/display/it8951_image.ab"
import "abla/runtime/scalar"
import "abla/build"
// Full-frame4bpp upload then quality refresh. Caller owns initialized panel
// and buffers; final display completion is a separate waitDisplayIdle call.
@export("abla_it8951_image_example")
trusted fun example(bus: It8951Software,info: It8951DeviceInfo,pixels: NativeBuffer,
    stride: int,scratch: NativeBuffer,polls: int): It8951ImageResult {
    if (!info.valid() || info.width() < 5) return It8951ImageResult(2)
    val loaded=it8951Load4(bus|0,info,pixels,stride,0,0,info.width(),info.height(),scratch,polls,3000)
    if (!loaded.success()) return loaded
    it8951Refresh(bus|0,info,0,0,info.width(),info.height(),2,scratch,polls,3000)
}
