import "../../src/sd/selected_command_esp32c61.ab"
import "abla/build"
// Selected command only, not card initialization. Caller owns gate and CS.
@export("abla_esp32c61_sd_command_example")
trusted fun example(master: Esp32C61SpiMaster,command: int,argument: int,scratch: NativeBuffer,
    response: NativeBuffer,bytes: int): SdSpiCommandResult =
    sdSpiCommandSelected(master|0,command,argument,scratch,response,bytes)
