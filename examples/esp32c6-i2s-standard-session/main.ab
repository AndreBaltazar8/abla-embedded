import "../../src/esp32/i2s/standard_session_esp32c6.ab"
import "abla/build"
@export("abla_esp32c6_i2s_standard_session_example")
trusted fun example(r: NativeBuffer,data: int,slot: int,ws: int,shift: bool,polls: int,exclusive: bool,operation: int): int =
    if (operation == 0) c6I2sStandardOpenOwned(r,data,slot,ws,shift,polls,exclusive)
    else if (operation == 1) c6I2sStandardWaitOwned(r,polls,exclusive)
    else if (operation == 2) c6I2sStandardCloseOwned(r,polls,exclusive) else 2
