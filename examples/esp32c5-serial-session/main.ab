import "../../src/esp32/uart/session_esp32c5.ab"
import "abla/build"
@export("abla_esp32c5_serial_session_example")
trusted fun example(record: NativeBuffer,unit: int,source: int,sourceHz: int,baud: int,
    tx: int,rx: int,operation: int,value: int,exclusiveStopped: bool): int {
    if (operation == 0) return c5UartSessionOpenOwned(record,unit,source,sourceHz,baud,tx,rx,8,0,1,1000,exclusiveStopped)
    if (operation == 1) return c5UartSessionCloseOwned(record,exclusiveStopped)
    if (operation == 2) return if (c5UartSessionWriteByte(record,value,1000)) 1 else 0
    if (operation == 3) return c5UartSessionReadByte(record)
    if (operation == 4) return if (c5UartSessionFlush(record,1000)) 1 else 0
    if (operation == 5) return c5UartSessionDrainReadByteOwned(record,exclusiveStopped)
    return -2
}
