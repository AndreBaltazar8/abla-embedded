import "../../src/m5stack/battery_adc2_esp32s3.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
// Callable AirQ battery example, not a boot/flash image or classic Atom code.
// Caller establishes board/divider power, owns ADC2/PWDET/pad GPIO14/analog
// bus, excludes ULP/DMA/touch/sleep, and pins RTC_FAST/APB/CPU clocks.
// exclusive=true promises shared power/bus and arbiter transition ownership;
// false requires matching upstream pinned leases. Fixed WiFi-priority policy
// may preempt sampling: report that error, never use it as a battery value.
// ROM analog calls need an independent watchdog; delay40000600 requires
// calibrated CPU ticks/us. Caller chooses actual circuit settling time.
// op0measure,1retrycleanup,2lastmV,3retainedowner. All errors retain live owner;
// lastmV published only after acquisition, calibration and cleanup succeed.
var airqSession=Esp32S3Adc2Session(0)
var airqLastMillivolts=-1
@export("abla_airq_battery_adc_example")
trusted fun batteryExample(operation: int,settlingMicros: int,apbHertz: int,exclusive: bool): int {
    if (operation == 1) {
        airqSession=airqSession.closeOwned(100000)
        return if (airqSession.status() == 0) 0 else -500-airqSession.status()
    }
    if (operation == 2) return airqLastMillivolts
    if (operation == 3) return airqSession.bits()
    if (operation != 0 || airqSession.bits() != 0 || settlingMicros < 1 || settlingMicros > 1000000 || apbHertz < 8000000 || apbHertz > 80000000) return -1
    airqLastMillivolts=-1
    val calibration=esp32S3AdcReadCalibration(2,3)
    if (!calibration.valid()) return -400
    airqSession=m5BoardAirQ.openBatteryAdc2S3Owned(calibration,exclusive,exclusive,exclusive,0,apbHertz)
    var result=-100-airqSession.status()
    if (airqSession.ready()) {
        callNativeVoidI32(0x40000600,settlingMicros)
        airqSession=airqSession.startAfterSettlingOwned()
        result=-200-airqSession.status()
        if (airqSession.status() == 1) {
            airqSession=airqSession.pollOwned(100000)
            result=-300-airqSession.status()
            if (airqSession.status() == 1) {
                val mv=airqSession.batteryMillivoltsAdc2S3(m5BoardAirQ,calibration)
                result=if (mv < 0) -400 else mv
            }
        }
    }
    airqSession=airqSession.closeOwned(100000)
    if (airqSession.status() != 0) return -500-airqSession.status()
    if (result >= 0) airqLastMillivolts=result
    return result
}
