import "../../src/m5stack/tough_rtc_sleep_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Cache-on coordinator only. Actual cache-off retries use the framework's
// measured AfterCalibration/Recheck entry points, not this dispatcher.
@export("abla_toughc5_rtc_sleep_example")
trusted fun sleep(owner: M5ToughPowerOwner,wrapper: NativeBuffer,request: NativeBuffer,context: NativeBuffer,scratch: NativeBuffer,timer: NativeBuffer,rtc: M5RtcOpenResult,bus: int,touch: int,milliseconds: int,slowCycles: int,fastCycles: int,operation: int,exclusive: bool): int {
    if (operation == 0) return owner.preflightRtcSleepOwned(wrapper,request,context,scratch,timer,rtc,bus,touch,milliseconds,slowCycles,fastCycles,exclusive)
    if (operation == 1) return owner.beginRtcSleepOwned(wrapper,request,context,scratch,timer,slowCycles,fastCycles,exclusive)
    if (operation == 2) return owner.finishRtcSleepOwned(wrapper,timer,exclusive)
    return 2
}
