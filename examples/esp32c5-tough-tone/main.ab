import "../../src/esp32/i2c_esp32c5.ab"
import "../../src/m5stack/toughc5_tone.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller provides a live owned PM1 and successful boot buzzer setup. Poll
// cooperatively; no sleep may bypass the stop obligation. No automatic sound.
@export("abla_esp32c5_tough_tone_example")
trusted fun example(record: NativeBuffer,pmic: M5PmicOpen,setup: M5ToughBuzzerSetup,hz: int,duty: int,now: int,duration: int,exclusiveSharedPwm: bool,operation: int): int =
    if (operation == 0) toughToneStartOwned(record,pmic,setup,hz,duty,now,duration,exclusiveSharedPwm)
    else if (operation == 1) toughTonePollOwned(record,now,exclusiveSharedPwm)
    else if (operation == 2) toughToneStopOwned(record,exclusiveSharedPwm) else 2
