import "../../src/esp32/power/retention_published_esp32p4.ab"
// Callable, not a boot image. Caller owns generated graph, backing and all
// exclusions documented by the session. action0=open,1=continue,2=close.
@export("abla_esp32p4_retention_published_example")
trusted fun example(record: int,config: int,entry3: int,graph: int,graphBytes: int,backing: int,backingBytes: int,polls: int,action: int,exclusive: bool): int {
    val r=nativeBufferAt(record,144)
    if (action == 0) return esp32p4RetentionPublishedOpenOwned(r,nativeBufferAt(config,32),entry3,nativeBufferAt(graph,graphBytes),nativeBufferAt(backing,backingBytes),polls,exclusive)
    if (action == 1) return esp32p4RetentionPublishedContinueOwned(r,polls,exclusive)
    if (action == 2) return esp32p4RetentionPublishedCloseOwned(r,exclusive)
    return 2
}
