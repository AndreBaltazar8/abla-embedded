import "../../src/m5stack/detect_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable classic ESP32 object, NOT boot firmware. Known-M5 detection only.
// Exclusive680B record initialized magic0. Before unknown-board probing own
// quiesced GPIO2/34/13/27/22/19/33 HP/RTC/analog/I2S users, touch controller,
// stable clocks/power, ROM timing and shared register serialization; prevent
// sleep/global holds. Timing parameters are actual RTC fast/slow ticks.
// op0begin,1poll,2cancel,3result. States1pending/2detected-clean/3cleanup-needed/
//4failed-clean;0invalid. Never discard record or leases at1/3. Cancel does not
// pretend a live touch measurement stopped. Result remains unknown until2.
// Explicit display/static board selection wins without hardware probing.
@export("abla_board_detect_classic_example")
trusted fun detect(operation: int,record: NativeBuffer,current: M5BoardId,waitTicks: int,chargeTicks: int,intervalTicks: int,exclusive: bool): int {
    if (operation == 0) return m5ClassicDetectBeginOwned(record,current,waitTicks,chargeTicks,intervalTicks,exclusive)
    if (operation == 1) return m5ClassicDetectPollOwned(record)
    if (operation == 2) return m5ClassicDetectCancelOwned(record)
    if (operation == 3) return m5ClassicDetectResult(record) | 0
    return -1
}
