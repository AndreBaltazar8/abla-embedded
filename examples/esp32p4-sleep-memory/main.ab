import "../../src/esp32/power/sleep_memory_esp32p4.ab"
@export("abla_esp32p4_sleep_memory_example")
trusted fun example(recordAddress: int,close: bool,revision: int,regdmaBackup: bool,mhz: int,xtalMHz: int,polls: int,ready: bool): int {
    val record=nativeBufferAt(recordAddress,32)
    return if (close) esp32p4SleepMemoryCloseOwned(record,polls,ready,true) else esp32p4SleepMemoryOpenOwned(record,revision,regdmaBackup,mhz,xtalMHz,polls,ready)
}
