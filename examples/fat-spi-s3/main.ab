import "../../src/storage/fat_spi_esp32s3.ab"
import "../../src/storage/fat_file_read.ab"
import "abla/runtime/scalar"
import "abla/build"
// Already mounted immutable FAT volume; initialized reader tied to the live
// S3 SD session. Disjoint512B output and1536B workspace. No filesystem writes.
@export("abla_fat_spi_s3_example")
trusted fun read(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,file: FatDirectoryEntry,
    offset: int,destination: NativeBuffer,workspace: NativeBuffer): int =
    fatFileReadAtOwned(reader,boot,first,sectors,file,offset,512,1024,destination,workspace)|0
