import "../../src/esp32/i2c_software_esp32c61.ab"
import "../../src/display/tm1680_device.ab"
import "abla/build"
// Borrowed initialized I2C device at0x72; caller powers and settles matrix rail.
@export("abla_esp32c61_tm1680_example")
trusted fun example(device: I2cDevice,frame: NativeBuffer,scratch: NativeBuffer): bool {
    val panel=tm1680FromDevice(device)
    if (!panel.begin(frame,scratch)) return false
    if (!tm1680SetPixel(frame,7,7,true)) return false
    return panel.display(frame,scratch)
}
