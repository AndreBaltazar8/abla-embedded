import "../../src/esp32/spi/command_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Initialized controller/pads and caller-owned gate. Retain all resources on
// transfer failure, especially pending CS/DC cleanup. Callable, not firmware.
@export("abla_esp32s3_spi_command_example")
trusted fun run(gate: PeripheralGate,owner: u32,port: int,pins: SpiPins,cs: Pin,dc: Pin,
    command: int,data: NativeBuffer,bytes: int,shared: bool): SpiTransactionResult =
    esp32s3SpiCommand(gate,owner,port,pins,cs,dc,command,data,bytes,shared)
