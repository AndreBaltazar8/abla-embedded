import "../../src/m5stack/detect_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable RV32 object, not a boot image. Execute only on ESP32-C5.
// Returns a preserved explicit board selection or read-only eFuse detection.
// Unknown is not a hardware fault and must not silently become StampC5.
@export("abla_board_detect_c5_example")
trusted fun detect(current: M5BoardId): int = m5DetectCurrentEsp32C5(current) | 0
