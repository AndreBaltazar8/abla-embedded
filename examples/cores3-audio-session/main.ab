import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/cores3_audio_session.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Powered CoreS3, prepared I2C/device handles, exclusive I2S1/GDMA/pads and
// caller-owned internal DMA ring/PCM. Zeroed128B record retained until closed.
// op0prepare,1start,2stop/close/retry. Initialize TX PCM before op1; service
// the ring with coreS3AudioSessionPumpOwned while running. Not boot firmware.
@export("abla_cores3_audio_session_example")
trusted fun audio(op: int,r: NativeBuffer,tx: bool,hz: int,dma: int,desc: int,count: int,
    buffers: int,block: int,owner: u32,codec: u32,io: u32,polls: int,exclusive: bool): int {
    if (op == 0) return coreS3AudioSessionBeginOwned(r,tx,hz,dma,desc,count,buffers,block,owner,codec,io,exclusive)
    if (op == 1) return coreS3AudioSessionStartOwned(r,polls,exclusive)
    if (op == 2) return coreS3AudioSessionCloseOwned(r,polls,exclusive)
    return 0
}
