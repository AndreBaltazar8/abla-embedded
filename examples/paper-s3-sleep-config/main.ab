import "../../src/m5stack/paper_s3_sleep_config.ab"
import "abla/build"
@export("abla_paper_s3_sleep_config_example")
fun example(address: int,i: int,d: int,bias: int,ports: int,options: int,ramKind: int,protocol: int,baseline: int,polls: int,flags: int,period: int,duration: int,reject: int): bool =
    paperS3SleepConfigEncode(nativeBufferAt(address,72),Esp32S3TagPlan(i),Esp32S3TagPlan(d),Esp32S3ClockBias(bias),ports,options,ramKind,protocol,baseline,polls,flags,period,duration,reject)
