import "../../src/esp32/i2c_software_esp32p4.ab"
import "../../src/m5stack/tab5_speaker_esp32p4.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Caller owns livecodecclocks and initializedPI4IOE1GPIO1. Stop clocks only
// after disable succeeds. Codec handle and expander handle use existing bus.
@export("abla_tab5_speaker_control_example")
trusted fun speaker(codec: Es8388,io: Pi4Ioe5v6408,enabled: bool,exclusive: bool): int =
    tab5SpeakerOwned(codec,io,enabled,exclusive)
