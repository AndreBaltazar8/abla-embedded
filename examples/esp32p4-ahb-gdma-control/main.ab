import "../../src/esp32/ahb_gdma_control_esp32p4.ab"
// Command0 query PARK,1 stop with bounded polls,2 reset parked channel/connect
// I2S port=argument. Caller owns stopped peripheral and initialized DMA clocks.
@export("abla_esp32p4_ahb_gdma_control_example")
trusted fun control(channel: i32,transmit: bool,command: i32,argument: i32,exclusive: bool): i32 {
    if (command == i32(0)) return i32(esp32p4AhbGdmaParkedOwned(int(channel),transmit,exclusive))
    if (command == i32(1)) return i32(esp32p4AhbGdmaStopOwned(int(channel),transmit,int(argument),exclusive))
    if (command == i32(2)) return i32(esp32p4AhbGdmaPrepareI2sOwned(int(channel),transmit,int(argument),exclusive))
    return i32(2)
}
