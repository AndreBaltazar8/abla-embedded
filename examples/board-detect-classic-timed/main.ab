import "../../src/m5stack/detect_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// Same680B record and exclusive hardware contract as board-detect-classic.
// Supply known CURRENT awake RTC fast/slow Hz, not CPU Hz. No clock probing
// or frequency changes. M5 profile converts256us/5ms/320us to validated ticks.
// op0begin,1poll,2cancel,3result. Retain all leases at pending/cleanup states.
@export("abla_board_detect_classic_timed_example")
trusted fun detect(operation: int,record: NativeBuffer,current: M5BoardId,rtcFastHz: int,rtcSlowHz: int,exclusive: bool): int {
    if (operation == 0) return m5ClassicDetectBeginWithTimingOwned(record,current,esp32TouchTimingM5Classic(rtcFastHz,rtcSlowHz),exclusive)
    if (operation == 1) return m5ClassicDetectPollOwned(record)
    if (operation == 2) return m5ClassicDetectCancelOwned(record)
    if (operation == 3) return m5ClassicDetectResult(record) | 0
    return -1
}
