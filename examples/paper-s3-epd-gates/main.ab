import "../../src/m5stack/paper_s3_epd.ab"
import "abla/build"
@export("abla_paper_s3_epd_gates_example")
fun example(action: int,idleExclusive: bool): int {
    val pins=paperS3EpdGatePins()
    if (action == 0 || action == 1) return pins.powerOwned(action == 1,idleExclusive)
    if (action == 2) return pins.beginFrameOwned(idleExclusive)
    return pins.lineOwned(action-3,idleExclusive)
}
