import "../../src/esp32/i2c_esp32s3.ab"
import "../../src/m5stack/pdm_microphone_process_esp32s3.ab"
import "../../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Running board session152, initialized DSP40 (mono input,noADC,noFIFO swap),
// raw full-block scratch and output, all disjoint/owned. Actual rate=hardware
// rate/DSP oversampling. Busy/preflight preserve DSP/output. No auto-start.
@export("abla_board_pdm_microphone_process_example")
trusted fun process(r: NativeBuffer,state: NativeBuffer,raw: NativeBuffer,output: NativeBuffer,
    stereo: bool,bits16: bool,polls: int,exclusive: bool): M5PdmMicrophoneBlockResult =
    m5PdmMicrophoneProcessBlockOwned(r,state,raw,output,stereo,bits16,polls,exclusive)
