import "../../src/esp32/i2c_idf6.ab"
import "../../src/esp32/serial.ab"
import "../../src/power/ina226.ab"
import "../../src/power/ina3221.ab"

val log = serial()

@export("app_main")
trusted fun appMain(): void {
    // Atom-family Grove Port A is only a convenient external test bus. The
    // same drivers are used on built-in M5Stack power-monitor buses.
    val bus = i2cMaster(1, 26, 32)
    if (!bus.valid()) {
        log.line("I2C bus initialization failed")
        return
    }

    val ina226Device = ina226(bus)
    if (ina226Device.begin()) {
        val configured = ina226Device.configure()
        if (configured.configured()) {
            configured.busVoltage()
            configured.shuntVoltage()
            configured.current()
            configured.power()
            log.line("INA226 detected and sampled")
        } else log.line("INA226 configuration failed")
    }
    ina226Device.close()

    val ina3221Device = ina3221(bus)
    if (ina3221Device.begin()) {
        ina3221Device.busVoltage(0)
        ina3221Device.shuntVoltage(0)
        ina3221Device.current(0)
        log.line("INA3221 detected and sampled")
    }
    ina3221Device.close()
    bus.close()
    return
}
