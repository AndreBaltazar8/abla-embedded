// AW9523B V2.4 register layout, pp19-21. Import with an I2C backend and a
// peripheralDelayMicroseconds provider. Pins 0..7=P0, 8..15=P1.
// Read/modify/write operations require caller serialization for this device.
// https://doc.awinic.com/doc/202403/deffbf3b-7e7b-4ff6-8e91-fd85e2d845d5.pdf
import "../hal/delay.ab"
import "../i2c/device.ab"
import "./aw9523_type.ab"
import "../hal/aw9523.ab"
import "../i2c/results.ab"
import "../hal/i2cdevice.ab"

trusted fun aw9523(bus: I2cBus, address: int = 88): Aw9523 =
    Aw9523(if (bus.valid() && address >= 88 && address <= 91) bus.device(address, 400000) & 4294967295 else 0)
@exportLocal("abla_aw9523_valid")
fun aw9523ValidHook(recv: int): bool = Aw9523(recv) != 0
@exportLocal("abla_aw9523_device")
fun aw9523DeviceHook(recv: int): I2cDevice = I2cDevice(Aw9523(recv) & 4294967295)
@exportLocal("abla_aw9523_close")
trusted fun aw9523CloseHook(recv: int): bool = Aw9523(recv).valid() && Aw9523(recv).device().close()

// Identity probe only: never reset a chip that may already control power rails.
// Board code must respect the 5ms power-on settling time before calling this.
@exportLocal("abla_aw9523_begin")
trusted fun aw9523BeginHook(recv: int): bool {
    if (!Aw9523(recv).valid()) return false
    val result = Aw9523(recv).device().readRegister8Checked(16)
    result.valid() && result.value() == 35
}

trusted fun Aw9523.digitalWrite(pin: int, high: bool): bool {
    if (!this.valid() || pin < 0 || pin > 15) return false
    val bit = 1 << (pin & 7)
    this.device().updateRegister8(2 + pin / 8, bit, if (high) bit else 0)
}

@exportLocal("abla_aw9523_setDirection")
trusted fun aw9523SetDirectionHook(recv: int, pin: int, output: bool): bool {
    if (!Aw9523(recv).valid() || pin < 0 || pin > 15) return false
    val bit = 1 << (pin & 7)
    Aw9523(recv).device().updateRegister8(4 + pin / 8, bit, if (output) 0 else bit)
}

@exportLocal("abla_aw9523_setGpioMode")
trusted fun aw9523SetGpioModeHook(recv: int, pin: int, gpio: bool): bool {
    if (!Aw9523(recv).valid() || pin < 0 || pin > 15) return false
    val bit = 1 << (pin & 7)
    Aw9523(recv).device().updateRegister8(18 + pin / 8, bit, if (gpio) bit else 0)
}

@exportLocal("abla_aw9523_setInterruptEnabled")
trusted fun aw9523SetInterruptEnabledHook(recv: int, pin: int, enabled: bool): bool {
    if (!Aw9523(recv).valid() || pin < 0 || pin > 15) return false
    val bit = 1 << (pin & 7)
    Aw9523(recv).device().updateRegister8(6 + pin / 8, bit, if (enabled) 0 else bit)
}

// Reading a port also acknowledges that port's pending input interrupt.
@exportLocal("abla_aw9523_digitalReadChecked")
trusted fun aw9523DigitalReadCheckedHook(recv: int, pin: int): I2cByteResult {
    if (!Aw9523(recv).valid() || pin < 0 || pin > 15) return I2cByteResult(0)
    val result = Aw9523(recv).device().readRegister8Checked(pin / 8)
    if (!result.valid()) return I2cByteResult(0)
    I2cByteResult(256 | ((result.value() >> (pin & 7)) & 1))
}

// Both input registers must be read to acknowledge the whole chip. Samples
// are sequential, not simultaneous. Failure is distinct from all pins low.
@exportLocal("abla_aw9523_readPortsChecked")
trusted fun aw9523ReadPortsCheckedHook(recv: int): I2cWordResult {
    if (!Aw9523(recv).valid()) return I2cWordResult(0)
    val low = Aw9523(recv).device().readRegister8Checked(0)
    if (!low.valid()) return I2cWordResult(0)
    val high = Aw9523(recv).device().readRegister8Checked(1)
    if (!high.valid()) return I2cWordResult(0)
    I2cWordResult(65536 | low.value() | (high.value() << 8))
}

fun aw9523DimRegister(pin: int): int =
    if (pin < 0 || pin > 15) -1
    else if (pin < 8) 36 + pin else if (pin < 12) 32 + pin - 8 else 44 + pin - 12

@exportLocal("abla_aw9523_setLedCurrent")
trusted fun aw9523SetLedCurrentHook(recv: int, pin: int, level: int): bool {
    val register = aw9523DimRegister(pin)
    Aw9523(recv).valid() && register >= 0 && level >= 0 && level <= 255 &&
        Aw9523(recv).device().writeRegister8(register, level)
}

// Global control: P0 push-pull/open-drain and current scale (0=full,
// 1=3/4, 2=1/2, 3=1/4). Reserved test-mode bits must always be zero.
@exportLocal("abla_aw9523_configureControl")
trusted fun aw9523ConfigureControlHook(recv: int, port0PushPull: bool, currentScale: int): bool =
    Aw9523(recv).valid() && currentScale >= 0 && currentScale <= 3 &&
        Aw9523(recv).device().writeRegister8(17, (if (port0PushPull) 16 else 0) | currentScale)

// Explicit whole-chip reset changes ALL outputs, potentially power rails.
// Never called by begin(). Preserve the specified minimum 1ms recovery delay.
@exportLocal("abla_aw9523_softwareReset")
trusted fun aw9523SoftwareResetHook(recv: int): bool {
    if (!Aw9523(recv).valid() || !Aw9523(recv).device().writeRegister8(127, 0)) return false
    // A single RTOS tick can be shorter than 1ms at the call boundary.
    peripheralDelayMicroseconds(1000)
    true
}
