// AW9523B V2.4 register layout, pp19-21. Import with an I2C backend and a
// peripheralDelayMicroseconds provider. Pins 0..7=P0, 8..15=P1.
// Read/modify/write operations require caller serialization for this device.
// https://doc.awinic.com/doc/202403/deffbf3b-7e7b-4ff6-8e91-fd85e2d845d5.pdf
type Aw9523 = int

trusted fun aw9523(bus: I2cBus, address: int = 88): Aw9523 =
    Aw9523(if (bus.valid() && address >= 88 && address <= 91) bus.device(address, 400000) & 4294967295 else 0)
fun Aw9523.valid(): bool = this != 0
fun Aw9523.device(): I2cDevice = I2cDevice(this & 4294967295)
trusted fun Aw9523.close(): bool = this.valid() && this.device().close()

// Identity probe only: never reset a chip that may already control power rails.
// Board code must respect the 5ms power-on settling time before calling this.
trusted fun Aw9523.begin(): bool {
    if (!this.valid()) return false
    val result = this.device().readRegister8Checked(16)
    result.valid() && result.value() == 35
}

trusted fun Aw9523.digitalWrite(pin: int, high: bool): bool {
    if (!this.valid() || pin < 0 || pin > 15) return false
    val bit = 1 << (pin & 7)
    this.device().updateRegister8(2 + pin / 8, bit, if (high) bit else 0)
}

trusted fun Aw9523.setDirection(pin: int, output: bool): bool {
    if (!this.valid() || pin < 0 || pin > 15) return false
    val bit = 1 << (pin & 7)
    this.device().updateRegister8(4 + pin / 8, bit, if (output) 0 else bit)
}

trusted fun Aw9523.setGpioMode(pin: int, gpio: bool): bool {
    if (!this.valid() || pin < 0 || pin > 15) return false
    val bit = 1 << (pin & 7)
    this.device().updateRegister8(18 + pin / 8, bit, if (gpio) bit else 0)
}

trusted fun Aw9523.setInterruptEnabled(pin: int, enabled: bool): bool {
    if (!this.valid() || pin < 0 || pin > 15) return false
    val bit = 1 << (pin & 7)
    this.device().updateRegister8(6 + pin / 8, bit, if (enabled) 0 else bit)
}

// Reading a port also acknowledges that port's pending input interrupt.
trusted fun Aw9523.digitalReadChecked(pin: int): I2cByteResult {
    if (!this.valid() || pin < 0 || pin > 15) return I2cByteResult(0)
    val result = this.device().readRegister8Checked(pin / 8)
    if (!result.valid()) return I2cByteResult(0)
    I2cByteResult(256 | ((result.value() >> (pin & 7)) & 1))
}

// Both input registers must be read to acknowledge the whole chip. Samples
// are sequential, not simultaneous. Failure is distinct from all pins low.
trusted fun Aw9523.readPortsChecked(): I2cWordResult {
    if (!this.valid()) return I2cWordResult(0)
    val low = this.device().readRegister8Checked(0)
    if (!low.valid()) return I2cWordResult(0)
    val high = this.device().readRegister8Checked(1)
    if (!high.valid()) return I2cWordResult(0)
    I2cWordResult(65536 | low.value() | (high.value() << 8))
}

fun aw9523DimRegister(pin: int): int =
    if (pin < 0 || pin > 15) -1
    else if (pin < 8) 36 + pin else if (pin < 12) 32 + pin - 8 else 44 + pin - 12

trusted fun Aw9523.setLedCurrent(pin: int, level: int): bool {
    val register = aw9523DimRegister(pin)
    this.valid() && register >= 0 && level >= 0 && level <= 255 &&
        this.device().writeRegister8(register, level)
}

// Global control: P0 push-pull/open-drain and current scale (0=full,
// 1=3/4, 2=1/2, 3=1/4). Reserved test-mode bits must always be zero.
trusted fun Aw9523.configureControl(port0PushPull: bool, currentScale: int): bool =
    this.valid() && currentScale >= 0 && currentScale <= 3 &&
        this.device().writeRegister8(17, (if (port0PushPull) 16 else 0) | currentScale)

// Explicit whole-chip reset changes ALL outputs, potentially power rails.
// Never called by begin(). Preserve the specified minimum 1ms recovery delay.
trusted fun Aw9523.softwareReset(): bool {
    if (!this.valid() || !this.device().writeRegister8(127, 0)) return false
    // A single RTOS tick can be shorter than 1ms at the call boundary.
    peripheralDelayMicroseconds(1000)
    true
}
