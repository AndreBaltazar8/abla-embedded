fun m5Ioe1Register(base: int, pin: int): int = base + pin / 8

fun m5Ioe1Bit(pin: int): int {
    val bank = pin / 8
    1 << (pin - bank * 8)
}

// Low byte is the duty LSB register and the next byte is the duty MSB plus
// enable/polarity flags, ready to write as one little-endian value.
fun m5Ioe1PwmValue(duty12: int, inverted: bool, enabled: bool): int =
    (duty12 & 4095) | (if (inverted) 1 << 14 else 0) |
        (if (enabled) 1 << 15 else 0)
