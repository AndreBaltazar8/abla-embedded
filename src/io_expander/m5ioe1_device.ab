// Import alongside the selected I2cBus/I2cDevice backend.
import "../esp32/sdk/raw_buffer.ab"
import "./types.ab"
import "./m5ioe1_logic.ab"
import "abla/unsafe/memory/raw"
import "../i2c/device.ab"

import "./m5ioe1_type.ab"
import "../hal/m5ioe1.ab"
import "../i2c/results.ab"
import "../hal/native_buffer.ab"
import "../esp32/sdk/nativebuffer_type.ab"
import "../hal/i2cdevice.ab"

trusted fun m5Ioe1(bus: I2cBus): M5Ioe1 =
    M5Ioe1(if (bus.valid()) bus.device(79, 100000) & 4294967295 else 0)

@export("abla_m5ioe1_valid")
fun m5Ioe1ValidHook(recv: int): bool = M5Ioe1(recv) != 0
@export("abla_m5ioe1_device")
fun m5Ioe1DeviceHook(recv: int): I2cDevice = I2cDevice(M5Ioe1(recv) & 4294967295)

@export("abla_m5ioe1_begin")
trusted fun m5Ioe1BeginHook(recv: int): bool {
    if (!M5Ioe1(recv).valid()) return false
    val identity = nativeBufferAt(nativeStackAllocate(2), 2)
    M5Ioe1(recv).device().readRegister(0, identity, 2) &&
        M5Ioe1(recv).device().writeRegister8(35, 0)
}

@export("abla_m5ioe1_close")
trusted fun m5Ioe1CloseHook(recv: int): bool = M5Ioe1(recv).valid() && M5Ioe1(recv).device().close()

trusted fun M5Ioe1.setDirection(pin: int, output: bool): bool {
    if (!this.valid() || pin < 0 || pin >= 14) return false
    val bit = m5Ioe1Bit(pin)
    this.device().updateRegister8(
        m5Ioe1Register(3, pin), bit, if (output) bit else 0
    )
}

@export("abla_m5ioe1_setPullMode")
trusted fun m5Ioe1SetPullModeHook(recv: int, pin: int, mode: int): bool {
    if (!M5Ioe1(recv).valid() || pin < 0 || pin >= 14 || !validPullMode(mode)) {
        return false
    }
    val bit = m5Ioe1Bit(pin)
    val pullUpRegister = m5Ioe1Register(9, pin)
    val pullDownRegister = m5Ioe1Register(11, pin)
    if (mode == pullNone) {
        return M5Ioe1(recv).device().updateRegister8(pullUpRegister, bit, 0) &&
            M5Ioe1(recv).device().updateRegister8(pullDownRegister, bit, 0)
    }
    if (mode == pullUp) {
        return M5Ioe1(recv).device().updateRegister8(pullDownRegister, bit, 0) &&
            M5Ioe1(recv).device().updateRegister8(pullUpRegister, bit, bit)
    }
    M5Ioe1(recv).device().updateRegister8(pullUpRegister, bit, 0) &&
        M5Ioe1(recv).device().updateRegister8(pullDownRegister, bit, bit)
}

// On M5IOE1 this selects push-pull (false) or open-drain (true).
trusted fun M5Ioe1.setHighImpedance(pin: int, enabled: bool): bool {
    if (!this.valid() || pin < 0 || pin >= 14) return false
    val bit = m5Ioe1Bit(pin)
    this.device().updateRegister8(
        m5Ioe1Register(19, pin), bit, if (enabled) bit else 0
    )
}

@export("abla_m5ioe1_getWriteValue")
trusted fun m5Ioe1GetWriteValueHook(recv: int, pin: int): bool {
    val value=M5Ioe1(recv).getWriteValueChecked(pin)
    value.valid() && value.value() != 0
}
@export("abla_m5ioe1_getWriteValueChecked")
trusted fun m5Ioe1GetWriteValueCheckedHook(recv: int, pin: int): I2cByteResult {
    if (!M5Ioe1(recv).valid() || pin < 0 || pin >= 14) return I2cByteResult(0)
    val value = M5Ioe1(recv).device().readRegister8Checked(m5Ioe1Register(5, pin))
    if (!value.valid()) I2cByteResult(0) else I2cByteResult(256|(if ((value.value() & m5Ioe1Bit(pin)) != 0) 1 else 0))
}

trusted fun M5Ioe1.digitalWrite(pin: int, level: bool): bool {
    if (!this.valid() || pin < 0 || pin >= 14) return false
    val bit = m5Ioe1Bit(pin)
    this.device().updateRegister8(
        m5Ioe1Register(5, pin), bit, if (level) bit else 0
    )
}

@export("abla_m5ioe1_digitalRead")
trusted fun m5Ioe1DigitalReadHook(recv: int, pin: int): bool {
    if (!M5Ioe1(recv).valid() || pin < 0 || pin >= 14) return false
    val value = M5Ioe1(recv).device().readRegister8Checked(m5Ioe1Register(7, pin))
    value.valid() && (value.value() & m5Ioe1Bit(pin)) != 0
}
@export("abla_m5ioe1_digitalReadChecked")
trusted fun m5Ioe1DigitalReadCheckedHook(recv: int, pin: int): I2cByteResult {
    if (!M5Ioe1(recv).valid() || pin < 0 || pin >= 14) return I2cByteResult(0)
    val value=M5Ioe1(recv).device().readRegister8Checked(m5Ioe1Register(7,pin))
    if (!value.valid()) I2cByteResult(0) else I2cByteResult(256 | (if ((value.value() & m5Ioe1Bit(pin)) != 0) 1 else 0))
}

@export("abla_m5ioe1_setPwmFrequency")
trusted fun m5Ioe1SetPwmFrequencyHook(recv: int, frequency: int): bool {
    val data = nativeBufferAt(nativeStackAllocate(2), 2)
    M5Ioe1(recv).setPwmFrequencyWithBuffer(frequency,data)
}
@export("abla_m5ioe1_setPwmFrequencyWithBuffer")
trusted fun m5Ioe1SetPwmFrequencyWithBufferHook(recv: int, frequency: int,data: NativeBuffer): bool {
    if (!M5Ioe1(recv).valid() || frequency < 0 || frequency > 65535 || !data.hasAddressRange(0,2)) return false
    data.storeU16(0, frequency)
    M5Ioe1(recv).device().writeRegister(37, data, 2)
}

trusted fun M5Ioe1.setPwmDuty12(
    channel: int,
    duty: int,
    inverted: bool = false,
    enabled: bool = true
): bool {
    val data = nativeBufferAt(nativeStackAllocate(2), 2)
    this.setPwmDuty12WithBuffer(channel,duty,data,inverted,enabled)
}
trusted fun M5Ioe1.setPwmDuty12WithBuffer(channel: int,duty: int,data: NativeBuffer,
    inverted: bool = false,enabled: bool = true): bool {
    if (!this.valid() || channel < 0 || channel >= 4 ||
        duty < 0 || duty > 4095 || !data.hasAddressRange(0,2)) return false
    data.storeU16(0, m5Ioe1PwmValue(duty, inverted, enabled))
    this.device().writeRegister(27 + channel * 2, data, 2)
}

trusted fun M5Ioe1.setPwmDutyPercent(
    channel: int,
    duty: int,
    inverted: bool = false,
    enabled: bool = true
): bool =
    duty >= 0 && duty <= 100 && this.setPwmDuty12(
        channel, duty * 4095 / 100, inverted, enabled
    )

@export("abla_m5ioe1_resetInterrupt")
trusted fun m5Ioe1ResetInterruptHook(recv: int): bool {
    if (!M5Ioe1(recv).valid()) return false
    M5Ioe1(recv).device().writeRegister16LittleEndian(17,0)
}

@export("abla_m5ioe1_disableInterrupt")
trusted fun m5Ioe1DisableInterruptHook(recv: int): bool {
    M5Ioe1(recv).setInterruptMask(0)
}

@export("abla_m5ioe1_enableInterrupt")
trusted fun m5Ioe1EnableInterruptHook(recv: int): bool {
    M5Ioe1(recv).setInterruptMask(16383)
}
@export("abla_m5ioe1_setInterruptMask")
trusted fun m5Ioe1SetInterruptMaskHook(recv: int, enabledPins: int): bool = M5Ioe1(recv).valid() &&
    enabledPins >= 0 && enabledPins <= 16383 && M5Ioe1(recv).device().writeRegister16LittleEndian(13,enabledPins)
