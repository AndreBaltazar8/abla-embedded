// Import alongside the selected I2cBus/I2cDevice backend.
import "./types.ab"
import "../i2c/device.ab"

import "./pi4ioe5v6408_type.ab"
import "../hal/pi4ioe5v6408.ab"
import "../i2c/results.ab"
import "../hal/i2cdevice.ab"

// Tab5/Tab5X/Nesso populate both address variants. Keep the existing default.
trusted fun pi4Ioe5v6408(bus: I2cBus,address: int = 67): Pi4Ioe5v6408 =
    Pi4Ioe5v6408(if (bus.valid() && (address == 67 || address == 68)) bus.device(address, 400000) & 4294967295 else 0)

@export("abla_pi4ioe5v6408_valid")
fun pi4Ioe5v6408ValidHook(recv: int): bool = Pi4Ioe5v6408(recv) != 0
@export("abla_pi4ioe5v6408_device")
fun pi4Ioe5v6408DeviceHook(recv: int): I2cDevice = I2cDevice(Pi4Ioe5v6408(recv) & 4294967295)

@export("abla_pi4ioe5v6408_begin")
trusted fun pi4Ioe5v6408BeginHook(recv: int): bool {
    if (!Pi4Ioe5v6408(recv).valid()) return false
    val identity = Pi4Ioe5v6408(recv).device().readRegister8Checked(1)
    identity.valid() && identity.value() != 0
}

@export("abla_pi4ioe5v6408_close")
trusted fun pi4Ioe5v6408CloseHook(recv: int): bool =
    Pi4Ioe5v6408(recv).valid() && Pi4Ioe5v6408(recv).device().close()

@export("abla_pi4ioe5v6408_setDirection")
trusted fun pi4Ioe5v6408SetDirectionHook(recv: int, pin: int, output: bool): bool {
    if (!Pi4Ioe5v6408(recv).valid() || pin < 0 || pin >= 8) return false
    val bit = 1 << pin
    Pi4Ioe5v6408(recv).device().updateRegister8(3, bit, if (output) bit else 0)
}

@export("abla_pi4ioe5v6408_setPullMode")
trusted fun pi4Ioe5v6408SetPullModeHook(recv: int, pin: int, mode: int): bool {
    if (!Pi4Ioe5v6408(recv).valid() || pin < 0 || pin >= 8 || !validPullMode(mode)) {
        return false
    }
    val bit = 1 << pin
    if (mode == pullNone) return Pi4Ioe5v6408(recv).device().updateRegister8(11, bit, 0)
    val selected = if (mode == pullUp) bit else 0
    Pi4Ioe5v6408(recv).device().updateRegister8(13, bit, selected) &&
        Pi4Ioe5v6408(recv).device().updateRegister8(11, bit, bit)
}

trusted fun Pi4Ioe5v6408.setHighImpedance(
    pin: int,
    enabled: bool
): bool {
    if (!this.valid() || pin < 0 || pin >= 8) return false
    val bit = 1 << pin
    this.device().updateRegister8(7, bit, if (enabled) bit else 0)
}

@export("abla_pi4ioe5v6408_getWriteValue")
trusted fun pi4Ioe5v6408GetWriteValueHook(recv: int, pin: int): bool {
    val value=Pi4Ioe5v6408(recv).getWriteValueChecked(pin)
    value.valid() && value.value() != 0
}

@export("abla_pi4ioe5v6408_getWriteValueChecked")
trusted fun pi4Ioe5v6408GetWriteValueCheckedHook(recv: int, pin: int): I2cByteResult {
    if (!Pi4Ioe5v6408(recv).valid() || pin < 0 || pin >= 8) return I2cByteResult(0)
    val value = Pi4Ioe5v6408(recv).device().readRegister8Checked(5)
    if (!value.valid()) I2cByteResult(0) else I2cByteResult(256|(if ((value.value() & (1<<pin)) != 0) 1 else 0))
}

trusted fun Pi4Ioe5v6408.digitalWrite(pin: int, level: bool): bool {
    if (!this.valid() || pin < 0 || pin >= 8) return false
    val bit = 1 << pin
    this.device().updateRegister8(5, bit, if (level) bit else 0)
}

@export("abla_pi4ioe5v6408_digitalRead")
trusted fun pi4Ioe5v6408DigitalReadHook(recv: int, pin: int): bool {
    val value=Pi4Ioe5v6408(recv).digitalReadChecked(pin)
    value.valid() && value.value() != 0
}
@export("abla_pi4ioe5v6408_digitalReadChecked")
trusted fun pi4Ioe5v6408DigitalReadCheckedHook(recv: int, pin: int): I2cByteResult {
    if (!Pi4Ioe5v6408(recv).valid() || pin < 0 || pin >= 8) return I2cByteResult(0)
    val value = Pi4Ioe5v6408(recv).device().readRegister8Checked(15)
    if (!value.valid()) I2cByteResult(0) else I2cByteResult(256|(if ((value.value() & (1<<pin)) != 0) 1 else 0))
}

@export("abla_pi4ioe5v6408_resetInterrupt")
trusted fun pi4Ioe5v6408ResetInterruptHook(recv: int): bool =
    Pi4Ioe5v6408(recv).valid() && Pi4Ioe5v6408(recv).device().readRegister8Checked(19).valid()

@export("abla_pi4ioe5v6408_disableInterrupt")
trusted fun pi4Ioe5v6408DisableInterruptHook(recv: int): bool =
    Pi4Ioe5v6408(recv).setInterruptMask(0)

@export("abla_pi4ioe5v6408_enableInterrupt")
trusted fun pi4Ioe5v6408EnableInterruptHook(recv: int): bool =
    Pi4Ioe5v6408(recv).setInterruptMask(255)
// PI4 stores disabled pins; the public mask consistently means enabled pins.
@export("abla_pi4ioe5v6408_setInterruptMask")
trusted fun pi4Ioe5v6408SetInterruptMaskHook(recv: int, enabledPins: int): bool = Pi4Ioe5v6408(recv).valid() &&
    enabledPins >= 0 && enabledPins <= 255 && Pi4Ioe5v6408(recv).device().writeRegister8(17,255-enabledPins)
