// Import alongside the selected I2cBus/I2cDevice backend.
import "./types.ab"

type Pi4Ioe5v6408 = int

// Tab5/Tab5X/Nesso populate both address variants. Keep the existing default.
trusted fun pi4Ioe5v6408(bus: I2cBus,address: int = 67): Pi4Ioe5v6408 =
    Pi4Ioe5v6408(if (bus.valid() && (address == 67 || address == 68)) bus.device(address, 400000) & 4294967295 else 0)

fun Pi4Ioe5v6408.valid(): bool = this != 0
fun Pi4Ioe5v6408.device(): I2cDevice = I2cDevice(this & 4294967295)

trusted fun Pi4Ioe5v6408.begin(): bool {
    if (!this.valid()) return false
    val identity = this.device().readRegister8Checked(1)
    identity.valid() && identity.value() != 0
}

trusted fun Pi4Ioe5v6408.close(): bool =
    this.valid() && this.device().close()

trusted fun Pi4Ioe5v6408.setDirection(pin: int, output: bool): bool {
    if (!this.valid() || pin < 0 || pin >= 8) return false
    val bit = 1 << pin
    this.device().updateRegister8(3, bit, if (output) bit else 0)
}

trusted fun Pi4Ioe5v6408.setPullMode(pin: int, mode: int): bool {
    if (!this.valid() || pin < 0 || pin >= 8 || !validPullMode(mode)) {
        return false
    }
    val bit = 1 << pin
    if (mode == pullNone) return this.device().updateRegister8(11, bit, 0)
    val selected = if (mode == pullUp) bit else 0
    this.device().updateRegister8(13, bit, selected) &&
        this.device().updateRegister8(11, bit, bit)
}

trusted fun Pi4Ioe5v6408.setHighImpedance(
    pin: int,
    enabled: bool
): bool {
    if (!this.valid() || pin < 0 || pin >= 8) return false
    val bit = 1 << pin
    this.device().updateRegister8(7, bit, if (enabled) bit else 0)
}

trusted fun Pi4Ioe5v6408.getWriteValue(pin: int): bool {
    val value=this.getWriteValueChecked(pin)
    value.valid() && value.value() != 0
}

trusted fun Pi4Ioe5v6408.getWriteValueChecked(pin: int): I2cByteResult {
    if (!this.valid() || pin < 0 || pin >= 8) return I2cByteResult(0)
    val value = this.device().readRegister8Checked(5)
    if (!value.valid()) I2cByteResult(0) else I2cByteResult(256|(if ((value.value() & (1<<pin)) != 0) 1 else 0))
}

trusted fun Pi4Ioe5v6408.digitalWrite(pin: int, level: bool): bool {
    if (!this.valid() || pin < 0 || pin >= 8) return false
    val bit = 1 << pin
    this.device().updateRegister8(5, bit, if (level) bit else 0)
}

trusted fun Pi4Ioe5v6408.digitalRead(pin: int): bool {
    val value=this.digitalReadChecked(pin)
    value.valid() && value.value() != 0
}
trusted fun Pi4Ioe5v6408.digitalReadChecked(pin: int): I2cByteResult {
    if (!this.valid() || pin < 0 || pin >= 8) return I2cByteResult(0)
    val value = this.device().readRegister8Checked(15)
    if (!value.valid()) I2cByteResult(0) else I2cByteResult(256|(if ((value.value() & (1<<pin)) != 0) 1 else 0))
}

trusted fun Pi4Ioe5v6408.resetInterrupt(): bool =
    this.valid() && this.device().readRegister8Checked(19).valid()

trusted fun Pi4Ioe5v6408.disableInterrupt(): bool =
    this.setInterruptMask(0)

trusted fun Pi4Ioe5v6408.enableInterrupt(): bool =
    this.setInterruptMask(255)
// PI4 stores disabled pins; the public mask consistently means enabled pins.
trusted fun Pi4Ioe5v6408.setInterruptMask(enabledPins: int): bool = this.valid() &&
    enabledPins >= 0 && enabledPins <= 255 && this.device().writeRegister8(17,255-enabledPins)
