import "../esp32/i2c_idf6.ab"
import "../esp32/sdk/buffer.ab"
import "./types.ab"
import "./m5ioe1_logic.ab"
import "abla/unsafe/memory"

type M5Ioe1 = int

trusted fun m5Ioe1(bus: I2cBus): M5Ioe1 =
    M5Ioe1(if (bus.valid()) bus.device(79, 100000) & 4294967295 else 0)

fun M5Ioe1.valid(): bool = this != 0
fun M5Ioe1.device(): I2cDevice = I2cDevice(this & 4294967295)

trusted fun M5Ioe1.begin(): bool {
    if (!this.valid()) return false
    val identity = nativeBufferAt(nativeStackAllocate(2), 2)
    this.device().readRegister(0, identity, 2) &&
        this.device().writeRegister8(35, 0)
}

trusted fun M5Ioe1.close(): bool = this.valid() && this.device().close()

trusted fun M5Ioe1.setDirection(pin: int, output: bool): bool {
    if (!this.valid() || pin < 0 || pin >= 14) return false
    val bit = m5Ioe1Bit(pin)
    this.device().updateRegister8(
        m5Ioe1Register(3, pin), bit, if (output) bit else 0
    )
}

trusted fun M5Ioe1.setPullMode(pin: int, mode: int): bool {
    if (!this.valid() || pin < 0 || pin >= 14 || !validPullMode(mode)) {
        return false
    }
    val bit = m5Ioe1Bit(pin)
    val pullUpRegister = m5Ioe1Register(9, pin)
    val pullDownRegister = m5Ioe1Register(11, pin)
    if (mode == pullNone) {
        return this.device().updateRegister8(pullUpRegister, bit, 0) &&
            this.device().updateRegister8(pullDownRegister, bit, 0)
    }
    if (mode == pullUp) {
        return this.device().updateRegister8(pullDownRegister, bit, 0) &&
            this.device().updateRegister8(pullUpRegister, bit, bit)
    }
    this.device().updateRegister8(pullUpRegister, bit, 0) &&
        this.device().updateRegister8(pullDownRegister, bit, bit)
}

// On M5IOE1 this selects push-pull (false) or open-drain (true).
trusted fun M5Ioe1.setHighImpedance(pin: int, enabled: bool): bool {
    if (!this.valid() || pin < 0 || pin >= 14) return false
    val bit = m5Ioe1Bit(pin)
    this.device().updateRegister8(
        m5Ioe1Register(19, pin), bit, if (enabled) bit else 0
    )
}

trusted fun M5Ioe1.getWriteValue(pin: int): bool {
    if (!this.valid() || pin < 0 || pin >= 14) return false
    val value = this.device().readRegister8Checked(m5Ioe1Register(5, pin))
    value.valid() && (value.value() & m5Ioe1Bit(pin)) != 0
}

trusted fun M5Ioe1.digitalWrite(pin: int, level: bool): bool {
    if (!this.valid() || pin < 0 || pin >= 14) return false
    val bit = m5Ioe1Bit(pin)
    this.device().updateRegister8(
        m5Ioe1Register(5, pin), bit, if (level) bit else 0
    )
}

trusted fun M5Ioe1.digitalRead(pin: int): bool {
    if (!this.valid() || pin < 0 || pin >= 14) return false
    val value = this.device().readRegister8Checked(m5Ioe1Register(7, pin))
    value.valid() && (value.value() & m5Ioe1Bit(pin)) != 0
}

trusted fun M5Ioe1.setPwmFrequency(frequency: int): bool {
    if (!this.valid() || frequency < 0 || frequency > 65535) return false
    val data = nativeBufferAt(nativeStackAllocate(2), 2)
    data.storeU16(0, frequency)
    this.device().writeRegister(37, data, 2)
}

trusted fun M5Ioe1.setPwmDuty12(
    channel: int,
    duty: int,
    inverted: bool = false,
    enabled: bool = true
): bool {
    if (!this.valid() || channel < 0 || channel >= 4 ||
        duty < 0 || duty > 4095) return false
    val data = nativeBufferAt(nativeStackAllocate(2), 2)
    data.storeU16(0, m5Ioe1PwmValue(duty, inverted, enabled))
    this.device().writeRegister(27 + channel * 2, data, 2)
}

trusted fun M5Ioe1.setPwmDutyPercent(
    channel: int,
    duty: int,
    inverted: bool = false,
    enabled: bool = true
): bool =
    duty >= 0 && duty <= 100 && this.setPwmDuty12(
        channel, duty * 4095 / 100, inverted, enabled
    )

trusted fun M5Ioe1.resetInterrupt(): bool {
    if (!this.valid()) return false
    val data = nativeBufferAt(nativeStackAllocate(2), 2)
    data.storeU16(0, 0)
    this.device().writeRegister(17, data, 2)
}

trusted fun M5Ioe1.disableInterrupt(): bool {
    if (!this.valid()) return false
    val data = nativeBufferAt(nativeStackAllocate(2), 2)
    data.storeU16(0, 0)
    this.device().writeRegister(13, data, 2)
}

trusted fun M5Ioe1.enableInterrupt(): bool {
    if (!this.valid()) return false
    val data = nativeBufferAt(nativeStackAllocate(2), 2)
    data.storeU16(0, 16383)
    this.device().writeRegister(13, data, 2)
}
