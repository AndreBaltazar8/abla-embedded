import "../esp32/sdk/buffer.ab"

// Platform-independent 128-bit block operations shared by CMAC and GMAC.
// The buffers are caller-owned so these primitives work without an allocator
// or a platform crypto ABI.

trusted fun cryptoBlockClear(block: NativeBuffer): bool {
    if (block.capacity() < 16) return false
    var index = 0
    while (index < 16) {
        block.store(index, 0)
        index = index + 1
    }
    true
}

trusted fun cryptoBlockCopy(
    destination: NativeBuffer,
    source: NativeBuffer
): bool {
    if (destination.capacity() < 16 || source.capacity() < 16) return false
    var index = 0
    while (index < 16) {
        destination.store(index, source.load(index))
        index = index + 1
    }
    true
}

trusted fun cryptoBlockXor(
    destination: NativeBuffer,
    source: NativeBuffer
): bool {
    if (destination.capacity() < 16 || source.capacity() < 16) return false
    var index = 0
    while (index < 16) {
        destination.store(
            index, destination.load(index) ^ source.load(index)
        )
        index = index + 1
    }
    true
}

// Multiplication by x in the CMAC field, using the big-endian bit order from
// NIST SP 800-38B. In-place operation is supported.
trusted fun cryptoCmacDoubleBlock(block: NativeBuffer): bool {
    if (block.capacity() < 16) return false
    var index = 15
    var carry = 0
    while (index >= 0) {
        val value = block.load(index)
        block.store(index, ((value << 1) & 255) | carry)
        carry = (value >>> 7) & 1
        index = index - 1
    }
    if (carry != 0) block.store(15, block.load(15) ^ 135)
    true
}

// Multiplication in GF(2^128) for GHASH. Output must not alias either input;
// temporaryV is a distinct 16-byte caller-owned block.
@inline
trusted fun cryptoGhashMultiply(
    x: NativeBuffer,
    y: NativeBuffer,
    output: NativeBuffer,
    temporaryV: NativeBuffer
): bool {
    if (x.capacity() < 16 || y.capacity() < 16 ||
        output.capacity() < 16 || temporaryV.capacity() < 16 ||
        output.addressValue() == x.addressValue() ||
        output.addressValue() == y.addressValue() ||
        temporaryV.addressValue() == output.addressValue()) return false
    cryptoBlockClear(output)
    cryptoBlockCopy(temporaryV, y)
    var byteIndex = 0
    while (byteIndex < 16) {
        var bitIndex = 0
        while (bitIndex < 8) {
            if ((x.load(byteIndex) & (128 >>> bitIndex)) != 0) {
                cryptoBlockXor(output, temporaryV)
            }
            var shiftIndex = 0
            var carry = 0
            while (shiftIndex < 16) {
                val value = temporaryV.load(shiftIndex)
                val nextCarry = value & 1
                temporaryV.store(
                    shiftIndex, (value >>> 1) | (carry << 7)
                )
                carry = nextCarry
                shiftIndex = shiftIndex + 1
            }
            if (carry != 0) {
                temporaryV.store(0, temporaryV.load(0) ^ 225)
            }
            bitIndex = bitIndex + 1
        }
        byteIndex = byteIndex + 1
    }
    true
}

// Y := (Y xor X) dot H. temporaryProduct and temporaryV must be distinct
// 16-byte blocks and must not alias state, block, or hashSubkey.
@inline
trusted fun cryptoGhashUpdateBlock(
    state: NativeBuffer,
    hashSubkey: NativeBuffer,
    block: NativeBuffer,
    temporaryProduct: NativeBuffer,
    temporaryV: NativeBuffer
): bool {
    if (!cryptoBlockXor(state, block) || !cryptoGhashMultiply(
        state, hashSubkey, temporaryProduct, temporaryV
    )) return false
    cryptoBlockCopy(state, temporaryProduct)
}

trusted fun cryptoConstantTimeEqual(
    left: NativeBuffer,
    right: NativeBuffer,
    length: int
): bool {
    if (length < 0 || left.capacity() < length ||
        right.capacity() < length) return false
    var difference = 0
    var index = 0
    while (index < length) {
        difference = difference | (left.load(index) ^ right.load(index))
        index = index + 1
    }
    difference == 0
}
