import "../esp32/sdk/raw_buffer.ab"

@inline
trusted fun cryptoGhashTableWord(address: int): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(address)))

@inline
trusted fun cryptoGhashStoreBigEndianWord(address: int, value: u32): void {
    ablaUnsafeStoreU8(nativePointerFromAddress(address), int(value >>> u32(24)))
    ablaUnsafeStoreU8(nativePointerFromAddress(address + 1), int(value >>> u32(16)))
    ablaUnsafeStoreU8(nativePointerFromAddress(address + 2), int(value >>> u32(8)))
    ablaUnsafeStoreU8(nativePointerFromAddress(address + 3), int(value))
    return
}

// Internal small-table GHASH primitive. Same nibble-indexed table policy as
// Mbed TLS, not a new constant-time implementation. Caller owns sixteen
// aligned entries, each {high:u64,low:u64} in native little-endian order,
// the standard sixteen u16 reduction entries, and valid16-byte input/output.
// Input/output may overlap: output is written only after all input is read.
trusted fun cryptoGhashSmallTable(table: int, reduction: int, input: int, output: int): void {
    var a = u32(0)
    var b = u32(0)
    var c = u32(0)
    var d = u32(0)
    var remaining = u32(32)
    while (remaining != u32(0)) {
        remaining = remaining - u32(1)
        val byte = u32(ablaUnsafeLoadU8(nativePointerFromAddress(input + int(remaining >>> u32(1)))))
        val digit = if ((remaining & u32(1)) != u32(0)) byte & u32(15) else byte >>> u32(4)
        val rem = int(d & u32(15))
        d = (d >>> u32(4)) | (c << u32(28))
        c = (c >>> u32(4)) | (b << u32(28))
        b = (b >>> u32(4)) | (a << u32(28))
        a = (a >>> u32(4)) ^ (u32(ablaUnsafeLoadU16(
            nativePointerFromAddress(reduction + rem * 2))) << u32(16))
        val offset = int(digit << u32(4))
        a = a ^ cryptoGhashTableWord(table + offset + 4)
        b = b ^ cryptoGhashTableWord(table + offset)
        c = c ^ cryptoGhashTableWord(table + offset + 12)
        d = d ^ cryptoGhashTableWord(table + offset + 8)
    }
    cryptoGhashStoreBigEndianWord(output, a)
    cryptoGhashStoreBigEndianWord(output + 4, b)
    cryptoGhashStoreBigEndianWord(output + 8, c)
    cryptoGhashStoreBigEndianWord(output + 12, d)
    return
}
