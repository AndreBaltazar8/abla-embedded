import "./atomic.ab"
// One shared atomic-capable RAM word, initialized to zero before publication.
// Low31 bits identify the sole in-flight worker; bit31 closes admission.
// Tokens must be unique among outstanding calls. A copy is the SAME gate.
// Gate storage must outlive every task/ISR that could attempt admission, even
// after stop: this joins admitted work, not the scheduler/interrupt registration.
type ServiceGate = int
fun serviceGateAt(address: int): ServiceGate = ServiceGate(address)
fun ServiceGate.word(): AtomicU32 = atomicU32At(this)
trusted fun ServiceGate.tryBegin(token: u32): bool =
    this.word().valid() && token > u32(0) && token < u32(2147483648) &&
    this.word().compareExchange(u32(0),token) == u32(0)
// A fault closes admission. Stop racing with completion cannot reopen the gate.
trusted fun ServiceGate.finish(token: u32,healthy: bool): bool {
    if (!this.word().valid() || token == u32(0) || token >= u32(2147483648)) return false
    val closed=u32(2147483648)
    val seen=this.word().compareExchange(token,if (healthy) u32(0) else closed)
    if (seen == token) return true
    if (seen != (closed|token)) return false
    return this.word().compareExchange(closed|token,closed) == (closed|token)
}
// 1 closed+quiescent,2 closed but worker still running,3 contention/retry,
// 4 invalid. Once bit31 is set, no new worker can enter. Never clears a fault.
trusted fun ServiceGate.requestStop(attempts: int): int {
    if (!this.word().valid() || attempts < 1 || attempts > 1000000) return 4
    var seen=this.word().compareExchange(u32(0),u32(0))
    var left=attempts
    while (left > 0) {
        if ((seen&u32(2147483648)) != u32(0)) return if (seen == u32(2147483648)) 1 else 2
        val next=seen|u32(2147483648)
        val observed=this.word().compareExchange(seen,next)
        if (observed == seen) return if (seen == u32(0)) 1 else 2
        seen=observed; left=left-1
    }
    return 3
}
