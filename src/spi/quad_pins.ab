// Five GPIO numbers, encoded as number+1 in six bits each; zero is invalid.
// No allocation or board-specific Pin wrapper. Native admission checks actual
// output capability and the separately supplied manual chip-select pin.
type QuadSpiPins=int
fun quadSpiPins(clock: int,io0: int,io1: int,io2: int,io3: int): QuadSpiPins {
    if (clock < 0 || clock > 62 || io0 < 0 || io0 > 62 || io1 < 0 || io1 > 62 ||
        io2 < 0 || io2 > 62 || io3 < 0 || io3 > 62) return QuadSpiPins(0)
    return QuadSpiPins((clock+1)|((io0+1)<<6)|((io1+1)<<12)|((io2+1)<<18)|((io3+1)<<24))
}
fun QuadSpiPins.clockPin(): int = (this&63)-1
fun QuadSpiPins.dataPin(lane: int): int =
    if (lane < 0 || lane > 3) -1 else ((this>>>((lane+1)*6))&63)-1
