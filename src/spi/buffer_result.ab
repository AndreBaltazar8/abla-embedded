// Backend detail low32, completed-byte count16bits@32, status3bits@56.
// Status matches SpiTransactionResult. Completed bytes are not external ACKs;
// an error can leave a published RX prefix and partially accepted writes.
type SpiBufferResult=int
fun SpiBufferResult.status(): int = (this>>>56)&7
fun SpiBufferResult.valid(): bool = this.status() == 1 && (this>>>59) == 0
fun SpiBufferResult.completedBytes(): int = (this>>>32)&65535
fun SpiBufferResult.detail(): int = this&4294967295
