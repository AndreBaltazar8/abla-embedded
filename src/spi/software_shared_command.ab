import "./software_command.ab"

// For panels whose D/C pad is also another device's MISO (e.g. CoreS3).
// Other chip selects must be inactive; D/C must be input on entry. Caller
// owns the canonical gate. Release the pad only after this panel's CS is high.
// No promise is made about cleanup after a CPU fault/reset.
trusted fun softwareSpiSharedCommandOwned(clock: Pin, mosi: Pin, chipSelect: Pin, dataCommand: Pin,
    command: int, data: NativeBuffer, length: int, mode: int = 0,
    halfPeriodMicroseconds: int = 1): bool {
    if (command < 0 || command > 255 || !data.hasAddressRange(0, length) ||
        !softwareSpiCommandPinsValid(clock, mosi, chipSelect, dataCommand, mode, halfPeriodMicroseconds)) return false
    dataCommand.write(false)
    dataCommand.output()
    val completed = softwareSpiCommandOwned(clock, mosi, chipSelect, dataCommand,
        command, data, length, mode, halfPeriodMicroseconds)
    dataCommand.input()
    completed
}

// Board setup must configure the bus and leave the shared D/C pad as input.
// This is a synchronous command, not a claim that the panel acknowledged it.
trusted fun softwareSpiSharedCommand(gate: PeripheralGate, owner: u32,
    clock: Pin, mosi: Pin, chipSelect: Pin, dataCommand: Pin,
    command: int, data: NativeBuffer, length: int, mode: int = 0,
    halfPeriodMicroseconds: int = 1): SpiTransactionResult {
    if (command < 0 || command > 255 || !gate.bufferDisjoint(data, length) ||
        !softwareSpiCommandPinsValid(clock, mosi, chipSelect, dataCommand, mode, halfPeriodMicroseconds)) return SpiTransactionResult(3 << 32)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    val completed = softwareSpiSharedCommandOwned(clock, mosi, chipSelect, dataCommand,
        command, data, length, mode, halfPeriodMicroseconds)
    if (!gate.finish(owner, completed)) return SpiTransactionResult(5 << 32)
    SpiTransactionResult((if (completed) 1 else 6) << 32)
}
