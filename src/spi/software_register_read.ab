import "./software_shared_checked.ab"
// Shared-MOSI register read, caller owns configured GPIO outputs and canonical
// bus gate. Return bytes in register/FIFO little-endian order (first byte low),
// not the MSB-first numeric value of the complete32-bit wire stream.
// Completion is not peripheral ACK. Failure detail1input2CSrelease4outputrestore.
// Caller may request eight zero clocks with CS INACTIVE before the command,
// matching M5GFX panel-ID probing; this is never a selected NOP command.
trusted fun softwareSpiReadRegister32SharedOwned(clock: Pin,data: Pin,cs: Pin,dc: Pin,command: int,dummyBits: int,
    halfPeriod: int,idlePrefix: bool): SpiTransactionResult {
    if (command < 0 || command > 255 || dummyBits < 0 || dummyBits > 32 ||
        !softwareSpiCommandPinsValid(clock,data,cs,dc,0,halfPeriod)) return SpiTransactionResult(3<<32)
    if (!cs.writeLevelOwned(true)) return SpiTransactionResult((6<<32)|2)
    clock.write(false);dc.write(false)
    if (idlePrefix) { val idle=softwareSpiExchangeWordOwned(clock,data,Pin(-1),u32(0),8,0,halfPeriod) }
    cs.write(false)
    val sent=softwareSpiExchangeWordOwned(clock,data,Pin(-1),u32(command),8,0,halfPeriod)
    dc.write(true)
    val inputReady=data.inputOwned()
    var value=u32(0)
    if (inputReady) {
        if (dummyBits > 0) { val dummy=softwareSpiExchangeWordOwned(clock,Pin(-1),data,u32(0),dummyBits,0,halfPeriod) }
        var i=0
        while (i < 4) {
            value=value|(softwareSpiExchangeWordOwned(clock,Pin(-1),data,u32(0),8,0,halfPeriod)<<u32(i*8))
            i=i+1
        }
    }
    val released=cs.writeLevelOwned(true)
    val restored=if (released) data.outputLevelOwned(false) else false
    val detail=(if (inputReady) 0 else 1)|(if (released) 0 else 2)|(if (restored) 0 else 4)
    return if (detail == 0) SpiTransactionResult((1<<32)|int(value)) else SpiTransactionResult((6<<32)|detail)
}
trusted fun softwareSpiReadRegister32Shared(gate: PeripheralGate,owner: u32,clock: Pin,data: Pin,cs: Pin,dc: Pin,
    command: int,dummyBits: int = 1,halfPeriod: int = 1,idlePrefix: bool = false): SpiTransactionResult {
    if (command < 0 || command > 255 || dummyBits < 0 || dummyBits > 32 ||
        !softwareSpiCommandPinsValid(clock,data,cs,dc,0,halfPeriod)) return SpiTransactionResult(3<<32)
    val admitted=gate.tryBegin(owner)
    if (admitted != 0) return SpiTransactionResult((if (admitted == 1) 2 else if (admitted == 2) 4 else 3)<<32)
    val result=softwareSpiReadRegister32SharedOwned(clock,data,cs,dc,command,dummyBits,halfPeriod,idlePrefix)
    if (!gate.finish(owner,result.valid())) return SpiTransactionResult((5<<32)|(result&0xffffffff))
    return result
}
// Only this failed shared-read operation; caller quiesces every user and
// rules out unrelated faults. No command/pixel replay; retain fault on failure.
trusted fun softwareSpiRegisterReadRecover(gate: PeripheralGate,owner: u32,cs: Pin,data: Pin,exclusiveUsersQuiesced: bool): bool {
    if (!exclusiveUsersQuiesced || !cs.outputCapable() || !data.outputCapable() || cs == data || !gate.tryBeginRecovery(owner)) return false
    val released=cs.writeLevelOwned(true)
    val restored=if (released) data.outputLevelOwned(false) else false
    val healthy=released && restored
    val finished=gate.finishRecovery(owner,healthy)
    return healthy && finished
}
