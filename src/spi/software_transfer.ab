import "./software_bits.ab"
import "../esp32/sdk/raw_buffer.ab"

// Same-base in-place exchange is safe: each TX byte is loaded before RX store.
// Reject other overlapping ranges to avoid overwriting future transmit bytes.
fun softwareSpiRangesCompatible(output: NativeBuffer, written: int, input: NativeBuffer, read: int): bool {
    if (!output.hasAddressRange(0, written) || !input.hasAddressRange(0, read)) return false
    if (written == 0 || read == 0 || output.addressValue() == input.addressValue()) return true
    output.addressValue() + written <= input.addressValue() || input.addressValue() + read <= output.addressValue()
}

// Synchronous full-duplex byte stream, clocking max(written,read) bytes. Fill
// is sent once TX is exhausted (default0xff suits SPI reads). A missing output
// buffer is represented by null/zero length, not read from implicitly.
// Caller owns configured pins, CS and initialCPOL for the entire call. No heap,
// CS changes, locking or success claims about the external device's response.
trusted fun softwareSpiTransferOwned(clock: Pin, mosi: Pin, miso: Pin,
    output: NativeBuffer, written: int, input: NativeBuffer, read: int,
    mode: int = 0, halfPeriodMicroseconds: int = 1, fill: int = 255): bool {
    if (!softwareSpiTransferValid(clock, mosi, miso, output, written, input, read, mode, halfPeriodMicroseconds, fill)) return false
    val count = if (written > read) written else read
    var index = 0
    while (index < count) {
        val byte = if (index < written) output.load(index) else fill
        val sample = softwareSpiExchangeWordOwned(clock, mosi,
            if (index < read) miso else Pin(-1), u32(byte), 8, mode, halfPeriodMicroseconds)
        if (index < read) input.store(index, int(sample))
        index = index + 1
    }
    true
}

fun softwareSpiTransferValid(clock: Pin, mosi: Pin, miso: Pin,
    output: NativeBuffer, written: int, input: NativeBuffer, read: int,
    mode: int, halfPeriodMicroseconds: int, fill: int): bool =
    softwareSpiConfigurationValid(clock, mosi, miso, mode, halfPeriodMicroseconds) &&
    softwareSpiRangesCompatible(output, written, input, read) && fill >= 0 && fill <= 255 &&
    (written == 0 || mosi.number() >= 0) && (read == 0 || miso.number() >= 0)
