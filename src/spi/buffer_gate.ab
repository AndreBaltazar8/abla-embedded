import "../peripheral_gate.ab"
import "../esp32/sdk/raw_buffer.ab"

// Admission mutates the gate word. It cannot overlap immutable TX/program
// bytes or RX destinations: either direction corrupts data or ownership.
// Host gates may be above4GiB; NativeBuffer spans are always32-bit.
fun PeripheralGate.bufferDisjoint(buffer: NativeBuffer, bytes: int): bool {
    val address = this.word().address()
    if (address <= 0 || !this.word().valid() || !buffer.hasAddressRange(0, bytes)) return false
    bytes == 0 || address > 4294967295 || address >= buffer.addressValue() + bytes ||
        buffer.addressValue() >= address + 4
}
