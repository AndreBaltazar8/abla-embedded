// Low32 bits contain received data or backend detail. Status above it:
// 1 complete,2 busy,3 invalid,4 faulted,5 ownership failure,6 transfer failure.
// Completion is not an external device ACK.
import "./spitransactionresult_type.ab"
import "../hal/spitransactionresult.ab"
@export("abla_spitransactionresult_status")
fun spiTransactionResultStatusHook(recv: int): int = (SpiTransactionResult(recv) >>> 32) & 7
@export("abla_spitransactionresult_valid")
fun spiTransactionResultValidHook(recv: int): bool = SpiTransactionResult(recv) >= 4294967296 && (SpiTransactionResult(recv) >>> 33) == 0
@export("abla_spitransactionresult_value")
fun spiTransactionResultValueHook(recv: int): u32 = u32(SpiTransactionResult(recv) & 4294967295)
