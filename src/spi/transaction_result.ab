// Low32 bits contain received data or backend detail. Status above it:
// 1 complete,2 busy,3 invalid,4 faulted,5 ownership failure,6 transfer failure.
// Completion is not an external device ACK.
type SpiTransactionResult = int
fun SpiTransactionResult.status(): int = (this >>> 32) & 7
fun SpiTransactionResult.valid(): bool = this >= 4294967296 && (this >>> 33) == 0
fun SpiTransactionResult.value(): u32 = u32(this & 4294967295)
