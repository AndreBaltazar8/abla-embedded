import "./software_command.ab"
// Checked alternative to legacy shared-D/C helpers. Caller owns all pads,
// D/C enters as input and every other device CS is inactive. Setup failure may
// partially change a pad: always attempt input restoration, never send command
// after failed output setup. Value flags1setup,2command,4input-cleanup failure.
// No acknowledgement from the peripheral is implied by transfer completion.
trusted fun softwareSpiSharedCommandCheckedOwned(clock: Pin,mosi: Pin,chipSelect: Pin,dataCommand: Pin,
    command: int,data: NativeBuffer,length: int,mode: int = 0,halfPeriodMicroseconds: int = 1): SpiTransactionResult {
    if (command < 0 || command > 255 || !data.hasAddressRange(0,length) ||
        !softwareSpiCommandPinsValid(clock,mosi,chipSelect,dataCommand,mode,halfPeriodMicroseconds)) return SpiTransactionResult(3<<32)
    var detail=0
    if (!dataCommand.outputLevelOwned(false)) detail=1
    else if (!softwareSpiCommandOwned(clock,mosi,chipSelect,dataCommand,command,data,length,mode,halfPeriodMicroseconds)) detail=2
    if (!dataCommand.inputOwned()) detail=detail|4
    return SpiTransactionResult(((if (detail == 0) 1 else 6)<<32)|detail)
}
trusted fun softwareSpiSharedCommandChecked(gate: PeripheralGate,owner: u32,
    clock: Pin,mosi: Pin,chipSelect: Pin,dataCommand: Pin,command: int,data: NativeBuffer,length: int,
    mode: int = 0,halfPeriodMicroseconds: int = 1): SpiTransactionResult {
    if (command < 0 || command > 255 || !gate.bufferDisjoint(data,length) ||
        !softwareSpiCommandPinsValid(clock,mosi,chipSelect,dataCommand,mode,halfPeriodMicroseconds)) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    val result=softwareSpiSharedCommandCheckedOwned(clock,mosi,chipSelect,dataCommand,command,data,length,mode,halfPeriodMicroseconds)
    if (!gate.finish(owner,result.valid())) return SpiTransactionResult((5<<32)|(result&4294967295))
    return result
}
// Explicit recovery for THIS failed shared-pin operation only. Caller has
// quiesced every bus user and rules out other bus faults; no command replay.
// Both CS deassertion and checked input configuration must succeed before the
// gate reopens. A failure preserves the fault for a subsequent recovery.
trusted fun softwareSpiSharedPinRecover(gate: PeripheralGate,owner: u32,chipSelect: Pin,dataCommand: Pin,
    exclusiveUsersQuiesced: bool): bool {
    if (!exclusiveUsersQuiesced || !chipSelect.outputCapable() || !dataCommand.outputCapable() ||
        chipSelect == dataCommand || !gate.tryBeginRecovery(owner)) return false
    val deselected=chipSelect.writeLevelOwned(true)
    val restored=if (deselected) dataCommand.inputOwned() else false
    val healthy=deselected && restored
    val released=gate.finishRecovery(owner,healthy)
    return healthy && released
}
