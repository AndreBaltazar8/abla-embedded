import "./software_transaction.ab"

// M5GFX shared-bus preparation sequence, not full SD initialization or a card
// presence/ready test. Preserves an already responding card instead of always
// resetting it. CMD58's two response bytes select the same fallback as M5GFX.
// Result value: first/second CMD58 bytes at bits0/8; bit16 means CMD0 sent.
// Transaction completion means clocks sent, NOT card acknowledgement.
// Caller configures pads, MISO input, all other CS inactive, power settled,
// and serializes every device on the physical bus with this canonical gate.
trusted fun softwareSdDummyClocksOwned(clock: Pin, mosi: Pin, chipSelect: Pin,
    halfPeriodMicroseconds: int): void {
    chipSelect.write(true)
    var word = 0
    while (word < 4) {
        softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(4294967295), 32, 0, halfPeriodMicroseconds)
        word = word + 1
    }
    chipSelect.write(false)
    return
}

trusted fun softwareSdPrepareSpi(gate: PeripheralGate, owner: u32,
    clock: Pin, mosi: Pin, miso: Pin, chipSelect: Pin,
    halfPeriodMicroseconds: int = 2): SpiTransactionResult {
    // Integer-microsecond timing at least 2us keeps the clock below 400kHz.
    if (mosi.number() < 0 || miso.number() < 0 || halfPeriodMicroseconds < 2 ||
        !softwareSpiConfigurationValid(clock, mosi, miso, 0, halfPeriodMicroseconds) ||
        !softwareSpiSelectionValid(clock, mosi, miso, chipSelect, 0, 0)) return SpiTransactionResult(3 << 32)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    val value=softwareSdPrepareSpiHeld(clock,mosi,miso,chipSelect,halfPeriodMicroseconds)
    if (!gate.finish(owner, true)) return SpiTransactionResult(5 << 32)
    SpiTransactionResult((1 << 32) | value)
}
// Internal composition primitive: validated configured pins/timing, canonical
// bus gate ALREADY held, all other chip selects inactive. Does not release it.
// Same byte sequence and weak acknowledgement semantics as the public wrapper.
trusted fun softwareSdPrepareSpiHeld(clock: Pin,mosi: Pin,miso: Pin,chipSelect: Pin,
    halfPeriodMicroseconds: int): int {
    clock.write(false)
    softwareSdDummyClocksOwned(clock, mosi, chipSelect, halfPeriodMicroseconds)
    // CMD58 READ_OCR, argument zero, CRC7+end byte FD.
    softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(122), 8, 0, halfPeriodMicroseconds)
    softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(0), 32, 0, halfPeriodMicroseconds)
    softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(253), 8, 0, halfPeriodMicroseconds)
    val first = softwareSpiExchangeWordOwned(clock, mosi, miso, u32(255), 8, 0, halfPeriodMicroseconds)
    val second = softwareSpiExchangeWordOwned(clock, mosi, miso, u32(255), 8, 0, halfPeriodMicroseconds)
    var value = int(first) | (int(second) << 8)
    if (first == second) {
        softwareSdDummyClocksOwned(clock, mosi, chipSelect, halfPeriodMicroseconds)
        // CMD0 GO_IDLE_STATE, argument zero, CRC7+end byte95, two dummy bytes.
        softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(64), 8, 0, halfPeriodMicroseconds)
        softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(0), 32, 0, halfPeriodMicroseconds)
        softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(149), 8, 0, halfPeriodMicroseconds)
        softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(65535), 16, 0, halfPeriodMicroseconds)
        value = value | 65536
    }
    chipSelect.write(true)
    value
}
