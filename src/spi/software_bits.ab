// Backend supplies Pin and peripheralDelayMicroseconds. Caller exclusively
// owns configured pins, clock already at CPOL, and manages chip select. No
// scheduler/IRQ masking: preemption can lengthen pulses. Not a frequency promise.
type SpiWordResult = int
// ceil(500000/frequency), without an overflowing numerator at large u32 Hz.
fun softwareSpiHalfPeriodMicroseconds(frequency: u32): int =
    if (frequency == u32(0)) 0 else int(u32(499999) / frequency + u32(1))
fun SpiWordResult.valid(): bool = this >= 4294967296 && (this >>> 33) == 0
fun SpiWordResult.value(): u32 = u32(this & 4294967295)

// Internal bit primitive: caller has validated mode/pins/timing.
trusted fun softwareSpiExchangeBit(clock: Pin, mosi: Pin, miso: Pin,
    output: bool, mode: int, halfPeriodMicroseconds: int): bool {
    val idle = (mode & 2) != 0
    val secondEdge = (mode & 1) != 0
    if (secondEdge) clock.write(!idle)
    if (mosi.number() >= 0) mosi.write(output)
    if (halfPeriodMicroseconds > 0) peripheralDelayMicroseconds(halfPeriodMicroseconds)
    clock.write(if (secondEdge) idle else !idle)
    val input = miso.number() >= 0 && miso.read()
    if (halfPeriodMicroseconds > 0) peripheralDelayMicroseconds(halfPeriodMicroseconds)
    if (!secondEdge) clock.write(idle)
    input
}

// MSB first; low bitCount bits are sent. Pin(-1) means an absent MOSI/MISO.
// No input-only clock/MOSI or shared signal pins; bidirectional three-wire SPI
// requires an explicit direction-switching protocol and is not implied here.
trusted fun softwareSpiExchangeWord(clock: Pin, mosi: Pin, miso: Pin, output: u32,
    bitCount: int = 8, mode: int = 0, halfPeriodMicroseconds: int = 1): SpiWordResult {
    if (bitCount < 1 || bitCount > 32 ||
        !softwareSpiConfigurationValid(clock, mosi, miso, mode, halfPeriodMicroseconds)) return SpiWordResult(0)
    SpiWordResult(4294967296 | int(softwareSpiExchangeWordOwned(clock, mosi, miso, output,
        bitCount, mode, halfPeriodMicroseconds)))
}

@inline
fun softwareSpiConfigurationValid(clock: Pin, mosi: Pin, miso: Pin,
    mode: int, halfPeriodMicroseconds: int): bool =
    mode >= 0 && mode <= 3 && halfPeriodMicroseconds >= 0 && halfPeriodMicroseconds <= 65535 &&
    clock.outputCapable() && (mosi.number() == -1 || mosi.outputCapable()) &&
    (miso.number() == -1 || miso.valid()) && clock != mosi && clock != miso &&
    (mosi.number() < 0 || mosi != miso)

// Internal: validated pins/mode/timing and bitCount1..32; ownership retained.
trusted fun softwareSpiExchangeWordOwned(clock: Pin, mosi: Pin, miso: Pin, output: u32,
    bitCount: int, mode: int, halfPeriodMicroseconds: int): u32 {
    var received = u32(0)
    var bit = bitCount - 1
    while (bit >= 0) {
        val value = softwareSpiExchangeBit(clock, mosi, miso,
            (output & (u32(1) << u32(bit))) != u32(0), mode, halfPeriodMicroseconds)
        received = (received << u32(1)) | (if (value) u32(1) else u32(0))
        bit = bit - 1
    }
    received
}
