import "./software_transaction.ab"

@inline
fun softwareSpiCommandPinsValid(clock: Pin, mosi: Pin, chipSelect: Pin, dataCommand: Pin,
    mode: int, halfPeriodMicroseconds: int): bool =
    mosi.outputCapable() && dataCommand.outputCapable() && dataCommand != clock &&
    dataCommand != mosi && dataCommand != chipSelect &&
    softwareSpiConfigurationValid(clock, mosi, Pin(-1), mode, halfPeriodMicroseconds) &&
    softwareSpiSelectionValid(clock, mosi, Pin(-1), chipSelect, 0, 0)

// One8-bit command followed by arbitrary data under continuous active-low CS.
// D/C is low for command and high for data, including on normal completion.
// Canonical gate and preconfigured/exclusively owned inactive pins required.
trusted fun softwareSpiCommand(gate: PeripheralGate, owner: u32,
    clock: Pin, mosi: Pin, chipSelect: Pin, dataCommand: Pin,
    command: int, data: NativeBuffer, length: int, mode: int = 0,
    halfPeriodMicroseconds: int = 1): SpiTransactionResult {
    if (command < 0 || command > 255 || !gate.bufferDisjoint(data, length) ||
        !softwareSpiCommandPinsValid(clock, mosi, chipSelect, dataCommand, mode, halfPeriodMicroseconds)) return SpiTransactionResult(3 << 32)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    val completed = softwareSpiCommandOwned(clock, mosi, chipSelect, dataCommand, command, data, length, mode, halfPeriodMicroseconds)
    if (!gate.finish(owner, completed)) return SpiTransactionResult(5 << 32)
    SpiTransactionResult((if (completed) 1 else 6) << 32)
}

// For an enclosing multi-command operation that already owns the bus gate.
// CS is inactive on entry/return, D/C high on return. Caller retains ownership.
trusted fun softwareSpiCommandOwned(clock: Pin, mosi: Pin, chipSelect: Pin, dataCommand: Pin,
    command: int, data: NativeBuffer, length: int, mode: int = 0,
    halfPeriodMicroseconds: int = 1): bool {
    if (command < 0 || command > 255 || !data.hasAddressRange(0, length) ||
        !softwareSpiCommandPinsValid(clock, mosi, chipSelect, dataCommand, mode, halfPeriodMicroseconds)) return false
    clock.write((mode & 2) != 0)
    dataCommand.write(false)
    chipSelect.write(false)
    val ignored = softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(command), 8, mode, halfPeriodMicroseconds)
    dataCommand.write(true)
    val completed = softwareSpiTransferOwned(clock, mosi, Pin(-1), data, length,
        nativeBufferAt(0, 0), 0, mode, halfPeriodMicroseconds)
    chipSelect.write(true)
    completed
}
