import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHttpParserInternals(): bool {
    if (!internalFunction("esp32RecoveredHttpMessageNeedsEof", "http_message_needs_eof")) return false
    if (!internalFunction("esp32RecoveredHttpShouldKeepAlive", "http_should_keep_alive")) return false
    if (!internalFunction("esp32RecoveredHttpParserExecute", "http_parser_execute")) return false
    if (!internalFunction("esp32RecoveredHttpMethodStr", "http_method_str")) return false
    if (!internalFunction("esp32RecoveredHttpParserInit", "http_parser_init")) return false
    if (!internalFunction("esp32RecoveredHttpParserSettingsInit", "http_parser_settings_init")) return false
    if (!internalFunction("esp32RecoveredHttpErrnoName", "http_errno_name")) return false
    if (!internalFunction("esp32RecoveredHttpErrnoDescription", "http_errno_description")) return false
    if (!internalFunction("esp32RecoveredHttpParserUrlInit", "http_parser_url_init")) return false
    if (!internalFunction("esp32RecoveredHttpParserParseUrl", "http_parser_parse_url")) return false
    if (!internalFunction("esp32RecoveredHttpParserPause", "http_parser_pause")) return false
    if (!internalFunction("esp32RecoveredHttpBodyIsFinal", "http_body_is_final")) return false
    if (!internalFunction("esp32RecoveredHttpParserVersion", "http_parser_version")) return false
    true
}
