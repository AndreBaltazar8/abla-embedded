// One scalar: owned32-bit device handle and status above it.0 invalid/closed,
// 1 ready,2 allocation failure,3 init failed/released,4 cleanup failed,
// 5 wake failed (retained, not ready). Caller assigns all returned states.
type Cst3530Owner = int
fun Cst3530Owner.handle(): int = this&4294967295
fun Cst3530Owner.status(): int = this>>>32
fun Cst3530Owner.ready(): bool = this.status() == 1 && this.handle() != 0
// Bus/power/reset/pads already configured and caller-owned. Initial failure
// releases slot; failed release preserves it. No implicit bus-reset recovery.
trusted fun cst3530OpenOwned(bus: int,address: int,frequency: int): Cst3530Owner {
    if (bus <= 0 || bus > 8589934591 || address < 8 || address > 119 || frequency < 1 || frequency > 400000)
        return Cst3530Owner(0)
    val handle=cst3530OwnerAllocate(bus,address,frequency)
    if (handle == 0) return Cst3530Owner(2<<32)
    if (cst3530OwnerBegin(handle)) return Cst3530Owner((1<<32)|handle)
    if (cst3530OwnerRelease(handle)) return Cst3530Owner(3<<32)
    Cst3530Owner((4<<32)|handle)
}
trusted fun Cst3530Owner.wakeOwned(): Cst3530Owner {
    if (this.handle() == 0 || (this.status() != 1 && this.status() != 5)) return this
    Cst3530Owner(((if (cst3530OwnerBegin(this.handle())) 1 else 5)<<32)|this.handle())
}
trusted fun Cst3530Owner.closeOwned(): Cst3530Owner {
    if (this.handle() == 0) return Cst3530Owner(0)
    if (this.status() != 1 && this.status() != 4 && this.status() != 5) return this
    if (cst3530OwnerRelease(this.handle())) return Cst3530Owner(0)
    Cst3530Owner((4<<32)|this.handle())
}
