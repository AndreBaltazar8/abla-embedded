// Select Pin and peripheralDelayMilliseconds/Microseconds providers.
// All helpers require exclusive ownership of the specified digital pad and
// a powered controller. They do not acquire pins, configure buses, or detect
// wiring. Do not call from an ISR or while holding a bus/interrupt lock.

trusted fun touchResetPulse(reset: Pin, lowMilliseconds: int): bool {
    if (!reset.outputCapable() || lowMilliseconds < 1 || lowMilliseconds > 1000) return false
    // Set output latch before enabling it, avoiding an initial high pulse.
    reset.write(false)
    reset.output()
    peripheralDelayMilliseconds(lowMilliseconds)
    reset.write(true)
    true
}
trusted fun ft5x06WakeInterrupt(interrupt: Pin): bool {
    if (!interrupt.valid() || !interrupt.pullCapable()) return false
    interrupt.input()
    interrupt.pullDown()
    peripheralDelayMicroseconds(512)
    interrupt.pullUp()
    true
}
trusted fun gt911WakeInterrupt(interrupt: Pin): bool {
    if (!interrupt.outputCapable()) return false
    interrupt.write(false)
    interrupt.output()
    peripheralDelayMilliseconds(58)
    interrupt.write(true)
    peripheralDelayMilliseconds(2)
    interrupt.input()
    interrupt.pullUp()
    true
}
// Follow with the controller's sleepCommand; this intentionally leaves IRQ
// driven low, matching the upstream sleep sequence. Wake releases it to input.
trusted fun gt911PrepareSleepInterrupt(interrupt: Pin): bool {
    if (!interrupt.outputCapable()) return false
    interrupt.write(false)
    interrupt.output()
    true
}
