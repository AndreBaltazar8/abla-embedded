import "./controller_power_sequence.ab"
import "./controller_open.ab"
import "./pins.ab"
import "../hal/touch.ab"
import "../hal/ft5x06.ab"
import "../hal/gt911.ab"
@export("touchPowerPadValid")
fun touchPowerPadValidHook(kind: int,number: int): bool =
    if (kind == 1 && number == -1) true else
    pin(number).valid() && pin(number).pullCapable() && (kind == 1 || pin(number).outputCapable())
@export("touchPowerPrepareSleep")
trusted fun touchPowerPrepareSleepHook(number: int): void {
    gt911PrepareSleepInterrupt(pin(number))
    return
}
@export("touchPowerSleepCommand")
trusted fun touchPowerSleepCommandHook(kind: int,handle: int): bool =
    if (kind == 1) Ft5x06(handle).sleep() else Gt911(handle).sleepCommand()
@export("touchPowerWakePulse")
trusted fun touchPowerWakePulseHook(kind: int,number: int): void {
    if (number >= 0) {
        if (kind == 1) ft5x06WakeInterrupt(pin(number)) else gt911WakeInterrupt(pin(number))
    }
    return
}
@export("touchPowerMonitor")
trusted fun touchPowerMonitorHook(handle: int): bool = Ft5x06(handle).monitorMode()
trusted fun TouchControllerOpen.sleep(interrupt: Pin): TouchControllerOpen = this.sleepOwned(interrupt | 0)
trusted fun TouchControllerOpen.wake(interrupt: Pin): TouchControllerOpen = this.wakeOwned(interrupt | 0)
