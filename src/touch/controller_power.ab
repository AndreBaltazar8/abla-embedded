import "./controller_power_sequence.ab"
import "./controller_open.ab"
import "./pins.ab"
fun touchPowerPadValid(kind: int,number: int): bool =
    if (kind == 1 && number == -1) true else
    pin(number).valid() && pin(number).pullCapable() && (kind == 1 || pin(number).outputCapable())
trusted fun touchPowerPrepareSleep(number: int): void {
    gt911PrepareSleepInterrupt(pin(number))
    return
}
trusted fun touchPowerSleepCommand(kind: int,handle: int): bool =
    if (kind == 1) Ft5x06(handle).sleep() else Gt911(handle).sleepCommand()
trusted fun touchPowerWakePulse(kind: int,number: int): void {
    if (number >= 0) {
        if (kind == 1) ft5x06WakeInterrupt(pin(number)) else gt911WakeInterrupt(pin(number))
    }
    return
}
trusted fun touchPowerMonitor(handle: int): bool = Ft5x06(handle).monitorMode()
trusted fun TouchControllerOpen.sleep(interrupt: Pin): TouchControllerOpen = this.sleepOwned(interrupt | 0)
trusted fun TouchControllerOpen.wake(interrupt: Pin): TouchControllerOpen = this.wakeOwned(interrupt | 0)
