import "./point.ab"
import "../esp32/sdk/raw_buffer.ab"
// M5GFX Touch_CST816S::_check_init register ordering. Unlike its void
// configuration writes, every required write here participates in success.
// A sleeping CST816S may NACK until touched: report that failure honestly;
// the owner can explicitly retry initialization after reset or a touch.
trusted fun cst816sBeginOwned(handle: int,identity: NativeBuffer): bool {
    if (handle <= 0 || handle > 4294967295 || !identity.hasAddressRange(0,3)) return false
    cst816sWrite(handle,0,0) && cst816sRead(handle,167,identity,3) &&
        cst816sWrite(handle,250,32) && cst816sWrite(handle,237,20)
}
// Six-byte register2 report; retry malformed count at most3 times. Errors
// never fabricate an empty report. IRQ is a pulse, not a contact-level input.
trusted fun cst816sReadOwned(handle: int,snapshot: NativeBuffer): int {
    if (handle <= 0 || handle > 4294967295 || !snapshot.hasAddressRange(0,6)) return -1
    var attempt=0
    while (attempt < 3) {
        if (!cst816sRead(handle,2,snapshot,6)) return -1
        val count=snapshot.load(0)
        if (count <= 1) return count
        attempt=attempt+1
    }
    return -3
}
trusted fun cst816sPoint(snapshot: NativeBuffer): TouchPoint {
    if (!snapshot.hasAddressRange(0,6) || snapshot.load(0) != 1) return TouchPoint(0)
    touchPoint(((snapshot.load(1)&15)<<8)|snapshot.load(2),
        ((snapshot.load(3)&15)<<8)|snapshot.load(4),0,2,1)
}
