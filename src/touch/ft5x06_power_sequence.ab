import "./controller_open_sequence.ab"
// Checked FT5x06 power lifecycle; assign returned owner. Status5asleep,
// 6uncertain,1ready. Invalid requests leave ownership unchanged and do noIO.
trusted fun TouchControllerOpen.sleepFt5x06CheckedOwned(exclusive: bool): TouchControllerOpen {
    if (!exclusive || !this.ready() || this.kind() != 1) return this
    val success=ft5x06PowerSleep(this.handle())
    return TouchControllerOpen(((if (success) 5 else 6)<<40)|(1<<32)|this.handle())
}
// Interrupt pull-down512us then pull-up, never drive a push-pull output into
// the controller's IRQ. Attempt pull-up cleanup even after partialdownsetup.
// Any pin failure blocks monitor command and retains uncertain ownership.
trusted fun TouchControllerOpen.wakeFt5x06CheckedOwned(interrupt: int,exclusive: bool): TouchControllerOpen {
    if (!exclusive || this.kind() != 1 || this.handle() == 0 || (this.status() != 5 && this.status() != 6) ||
        !ft5x06PowerPinValid(interrupt)) return this
    val down=ft5x06PowerInputOwned(interrupt,1)
    if (down) ft5x06PowerDelayMicroseconds(512)
    val up=ft5x06PowerInputOwned(interrupt,0)
    val success=down && up && ft5x06PowerMonitor(this.handle())
    return TouchControllerOpen(((if (success) 1 else 6)<<40)|(1<<32)|this.handle())
}
