import "./ft5x06_snapshot.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../i2c/device.ab"

// Select I2cBus/I2cDevice separately. Register protocol follows M5GFX
// Touch_FT5x06. Reset/wake/interrupt pads remain explicitly board-owned.
import "./ft5x06_type.ab"
import "../hal/ft5x06.ab"
import "abla/unsafe/memory/raw"
import "./point.ab"
import "../hal/native_buffer.ab"
import "../esp32/sdk/nativebuffer_type.ab"
import "../hal/i2cdevice.ab"
trusted fun ft5x06(bus: I2cBus, address: int = 56, frequency: int = 400000): Ft5x06 =
    Ft5x06(if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0)
@exportLocal("abla_ft5x06_valid")
fun ft5x06ValidHook(recv: int): bool = Ft5x06(recv) > 0 && Ft5x06(recv) <= 4294967295
@exportLocal("abla_ft5x06_device")
fun ft5x06DeviceHook(recv: int): I2cDevice = I2cDevice(if (Ft5x06(recv).valid()) Ft5x06(recv) | 0 else 0)
@exportLocal("abla_ft5x06_close")
trusted fun ft5x06CloseHook(recv: int): bool = Ft5x06(recv).valid() && Ft5x06(recv).device().close()

// Board must complete any required reset before begin. No hidden retry that
// rewrites controller mode during ordinary reads or after a failed transfer.
@exportLocal("abla_ft5x06_begin")
trusted fun ft5x06BeginHook(recv: int): bool {
    if (!Ft5x06(recv).valid()) return false
    val identity = nativeBufferAt(nativeStackAllocate(6), 6)
    Ft5x06(recv).device().writeRegister8(0, 0) &&
        Ft5x06(recv).device().readRegister(163, identity, 6) &&
        Ft5x06(recv).device().writeRegister8(164, 0) && identity.load(5) != 0
}
@exportLocal("abla_ft5x06_sleep")
trusted fun ft5x06SleepHook(recv: int): bool = Ft5x06(recv).valid() && Ft5x06(recv).device().writeRegister8(165, 3)
// This register write alone is not the optional512us interrupt-pad wake pulse.
@exportLocal("abla_ft5x06_monitorMode")
trusted fun ft5x06MonitorModeHook(recv: int): bool = Ft5x06(recv).valid() && Ft5x06(recv).device().writeRegister8(165, 1)
@exportLocal("abla_ft5x06_pollingMode")
trusted fun ft5x06PollingModeHook(recv: int): bool = Ft5x06(recv).valid() && Ft5x06(recv).device().writeRegister8(164, 0)

@exportLocal("abla_ft5x06_readSnapshot")
trusted fun ft5x06ReadSnapshotHook(recv: int, destination: NativeBuffer): int {
    if (!Ft5x06(recv).valid() || !destination.hasAddressRange(0, 29)) return -1
    if (!Ft5x06(recv).device().readRegister(2, destination, 1)) return -1
    val count = destination.load(0) & 15
    val size = ft5x06SnapshotBytes(count)
    if (size == 0) return -1
    if (count == 0) return 0
    if (!Ft5x06(recv).device().readRegister(2, destination, size)) return -1
    if ((destination.load(0) & 15) != count) return -2
    count
}

// Caller storage29bytes. Return0..5 points, -1 invalid/transport failure,
// -2 unstable. Only successful captures may be decoded. Six captures max;
// compare equal-sized snapshots, never stale/uninitialized bytes after error.
@exportLocal("abla_ft5x06_readStable")
trusted fun ft5x06ReadStableHook(recv: int, destination: NativeBuffer): int {
    if (!destination.hasAddressRange(0, 29)) return -1
    val previous = nativeBufferAt(nativeStackAllocate(29), 29)
    var lastCount = Ft5x06(recv).readSnapshot(previous)
    if (lastCount == -1) return -1
    var attempt = 0
    while (attempt < 5) {
        val count = Ft5x06(recv).readSnapshot(destination)
        if (count == -1) return -1
        var equal = count >= 0 && count == lastCount
        val size = ft5x06SnapshotBytes(count)
        var index = 0
        while (index < size) {
            val value = destination.load(index)
            if (equal && previous.load(index) != value) equal = false
            previous.store(index, value)
            index = index + 1
        }
        if (equal) return count
        lastCount = count
        attempt = attempt + 1
    }
    return -2
}

