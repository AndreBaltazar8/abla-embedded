import "./controller_open.ab"
import "./ft5x06_power_sequence.ab"
import "../esp32/gpio_esp32s3.ab"
import "../esp32/gpio/input_s3_sequence.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
import "../hal/delay.ab"
import "../hal/touch.ab"
import "../hal/ft5x06.ab"
import "../esp32/soc/gpio_capabilities.ab"
import "./ft5x06_type.ab"
// Caller releases IRQ RTC/holds and owns pull/matrix/input consumers. Native
// calibratedROMdelay; no ISR/interruptmask context or implicitpad restoration.
@export("ft5x06PowerPinValid")
fun ft5x06PowerPinValidHook(interrupt: int): bool = espChipS3().gpioOutputValid(interrupt)
@export("ft5x06PowerInputOwned")
trusted fun ft5x06PowerInputOwnedHook(interrupt: int,pull: int): bool = esp32S3GpioPrepareInputOwned(interrupt,pull,true) == 1
@export("ft5x06PowerDelayMicroseconds")
trusted fun ft5x06PowerDelayMicrosecondsHook(us: int): void = peripheralDelayMicroseconds(us)
@export("ft5x06PowerSleep")
trusted fun ft5x06PowerSleepHook(handle: int): bool = Ft5x06(handle).sleep()
@export("ft5x06PowerMonitor")
trusted fun ft5x06PowerMonitorHook(handle: int): bool = Ft5x06(handle).monitorMode()
