import "./controller_open.ab"
import "./ft5x06_power_sequence.ab"
import "../esp32/gpio_esp32s3.ab"
import "../esp32/gpio/input_s3_sequence.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
// Caller releases IRQ RTC/holds and owns pull/matrix/input consumers. Native
// calibratedROMdelay; no ISR/interruptmask context or implicitpad restoration.
fun ft5x06PowerPinValid(interrupt: int): bool = espChipS3().gpioOutputValid(interrupt)
trusted fun ft5x06PowerInputOwned(interrupt: int,pull: int): bool = esp32S3GpioPrepareInputOwned(interrupt,pull,true) == 1
trusted fun ft5x06PowerDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
trusted fun ft5x06PowerSleep(handle: int): bool = Ft5x06(handle).sleep()
trusted fun ft5x06PowerMonitor(handle: int): bool = Ft5x06(handle).monitorMode()
