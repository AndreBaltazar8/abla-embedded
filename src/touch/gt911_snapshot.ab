import "./gt911_logic.ab"
import "../esp32/sdk/raw_buffer.ab"

trusted fun gt911FramePoint(frame: NativeBuffer, count: int, index: int): TouchPoint {
    if (count < 1 || count > 5 || index < 0 || index >= count ||
        !frame.hasAddressRange(0, count * 8)) return TouchPoint(0)
    val offset = index * 8
    gt911PointValues(frame.load(offset), frame.load(offset + 1) | (frame.load(offset + 2) << 8),
        frame.load(offset + 3) | (frame.load(offset + 4) << 8),
        frame.load(offset + 5) | (frame.load(offset + 6) << 8))
}
