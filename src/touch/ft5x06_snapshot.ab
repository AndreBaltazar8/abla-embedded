import "./point.ab"
import "../esp32/sdk/raw_buffer.ab"

trusted fun ft5x06SnapshotPoint(snapshot: NativeBuffer,count: int,index: int): TouchPoint {
    val size=ft5x06SnapshotBytes(count)
    if (size == 0 || index < 0 || index >= count || !snapshot.hasAddressRange(0,size)) return TouchPoint(0)
    val offset=1+index*6
    ft5x06PointBytes(snapshot.load(offset),snapshot.load(offset+1),
        snapshot.load(offset+2),snapshot.load(offset+3))
}
