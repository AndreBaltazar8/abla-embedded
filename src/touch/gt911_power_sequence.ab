import "./controller_open_sequence.ab"
// Exclusive powered controller and IRQ ownership; assign returned owner.
// 5 asleep, 6 uncertain, 1 awake. Failed transitions retain the handle and
// require retry or explicit close. Never infer success from a failed pad write.
trusted fun TouchControllerOpen.sleepGt911CheckedOwned(interrupt: int,exclusive: bool): TouchControllerOpen {
    if (!exclusive || !this.ready() || this.kind() != 2 || !gt911PowerPinValid(interrupt)) return this
    val low=gt911PowerOutputLowOwned(interrupt)
    val success=low && gt911PowerSleep(this.handle())
    // Successful sleep intentionally holds IRQ low. On uncertainty release
    // the pad to input; cleanup cannot turn an unsuccessful sleep into success.
    if (!success) gt911PowerInputPullupOwned(interrupt)
    return TouchControllerOpen(((if (success) 5 else 6)<<40)|(2<<32)|this.handle())
}
trusted fun TouchControllerOpen.wakeGt911CheckedOwned(interrupt: int,exclusive: bool): TouchControllerOpen {
    if (!exclusive || this.kind() != 2 || this.handle() == 0 ||
        (this.status() != 5 && this.status() != 6) || !gt911PowerPinValid(interrupt)) return this
    val low=gt911PowerOutputLowOwned(interrupt)
    var high=false
    if (low) {
        gt911PowerDelayMilliseconds(58)
        high=gt911PowerWriteHighOwned(interrupt)
        if (high) gt911PowerDelayMilliseconds(2)
    }
    // Always attempt release, including partially configured output failures.
    val released=gt911PowerInputPullupOwned(interrupt)
    // GT911 wake has no I2C command/ack in upstream; this confirms the checked
    // electrical sequence, not a physical touch response or new initialization.
    return TouchControllerOpen(((if (low && high && released) 1 else 6)<<40)|(2<<32)|this.handle())
}
