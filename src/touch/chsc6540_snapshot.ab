import "./point.ab"
import "../esp32/sdk/raw_buffer.ab"
// M5GFX Touch_CHSC6540: two contacts maximum, register2 count followed
// by six-byte records. IDs are report indices; high coordinate nibbles only.
trusted fun chsc6540Point(snapshot: NativeBuffer,count: int,index: int): TouchPoint {
    if (count < 1 || count > 2 || index < 0 || index >= count ||
        !snapshot.hasAddressRange(0,count*6-1)) return TouchPoint(0)
    val offset=1+index*6
    touchPoint(((snapshot.load(offset)&15)<<8)|snapshot.load(offset+1),
        ((snapshot.load(offset+2)&15)<<8)|snapshot.load(offset+3),index,2,1)
}
