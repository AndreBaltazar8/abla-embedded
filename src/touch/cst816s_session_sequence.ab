import "./cst816s_sequence.ab"
// Allocation-free owned session. Handle32, initialized1, status3, lastpoll22,
// timestamp-valid1. Caller assigns returned value, serializes access, and polls
// at intervals below2^22ms (69.9min), or calls reinitialize after longer gaps.
// Status0 pending,1 contact,2 empty,3 I/O/init failure,4 malformed,5 throttled,
// 6 cleanup failed. Only1/2 authorize consuming snapshot/report as fresh.
type Cst816sSession = int
fun cst816sSessionOwned(handle: int): Cst816sSession =
    Cst816sSession(if (handle > 0 && handle <= 4294967295) handle else 0)
fun Cst816sSession.handle(): int = this&4294967295
fun Cst816sSession.initialized(): bool = (this&(1<<32)) != 0
fun Cst816sSession.status(): int = (this>>>33)&7
fun Cst816sSession.fresh(): bool = this.status() == 1 || this.status() == 2
fun Cst816sSession.reportCount(): int = if (!this.fresh()) -1 else if (this.status() == 1) 1 else 0
// Explicit reset/power-cycle notification retains ownership but discards
// initialized state and sample freshness. Never use to bypass failed cleanup.
fun Cst816sSession.reinitialize(): Cst816sSession =
    if (this.status() == 6) this else cst816sSessionOwned(this.handle())
trusted fun Cst816sSession.pollOwned(snapshot: NativeBuffer,now: int): Cst816sSession {
    if (this.handle() == 0 || this.status() == 6) return this
    val base=this&~(7<<33)
    if (!snapshot.hasAddressRange(0,6)) return Cst816sSession(base|(3<<33))
    val time=now&4194303
    if ((this&(1<<58)) != 0 && ((time-((this>>>36)&4194303))&4194303) < 10)
        return Cst816sSession(base|(5<<33))
    var next=this.handle()|(if (this.initialized()) 1<<32 else 0)|(time<<36)|(1<<58)
    if (!this.initialized()) {
        if (!cst816sBeginOwned(this.handle(),snapshot)) return Cst816sSession(next|(3<<33))
        next=next|(1<<32)
    }
    val count=cst816sReadOwned(this.handle(),snapshot)
    val status=if (count == 1) 1 else if (count == 0) 2 else if (count == -3) 4 else 3
    Cst816sSession(next|(status<<33))
}
trusted fun Cst816sSession.closeOwned(): Cst816sSession {
    if (this.handle() == 0 || cst816sSessionRelease(this.handle())) return Cst816sSession(0)
    Cst816sSession(this.handle()|(6<<33))
}
