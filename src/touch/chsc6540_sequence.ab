import "./chsc6540_snapshot.ab"
// Borrow disjoint eleven-byte capture/previous buffers. Five captures max;
// moving contacts may never compare equal, so accept the last complete report
// (upstream behavior). Failed or malformed reads never become empty reports.
trusted fun chsc6540ReadStableOwned(handle: int,snapshot: NativeBuffer,previous: NativeBuffer): int {
    if (handle <= 0 || handle > 4294967295 || !snapshot.hasAddressRange(0,11) ||
        !previous.hasAddressRange(0,11)) return -1
    val a=snapshot.addressValue()
    val b=previous.addressValue()
    if (a < b+11 && b < a+11) return -1
    var last=-1
    var attempt=0
    while (attempt < 5) {
        val count=chsc6540Capture(handle,snapshot)
        if (count < 0) return -1
        if (count > 2) return -3
        if (count == 0) return 0
        val size=count*6-1
        var equal=count == last
        var index=0
        while (index < size) {
            val value=snapshot.load(index)
            if (equal && previous.load(index) != value) equal=false
            previous.store(index,value)
            index=index+1
        }
        if (equal) return count
        last=count
        attempt=attempt+1
    }
    last
}
