import "./cst3530_owner_sequence.ab"
import "./cst3530_device.ab"
trusted fun cst3530OwnerAllocate(bus: int,address: int,frequency: int): int = cst3530(I2cBus(bus),address,frequency) | 0
trusted fun cst3530OwnerBegin(handle: int): bool = Cst3530(handle).begin()
trusted fun cst3530OwnerRelease(handle: int): bool = Cst3530(handle).close()
trusted fun openCst3530(bus: I2cBus,address: int = 88,frequency: int = 400000): Cst3530Owner = cst3530OpenOwned(bus | 0,address,frequency)
// Borrowed view: must not outlive close/wake/reset or be used after failure.
fun Cst3530Owner.view(): Cst3530 = Cst3530(if (this.ready()) this.handle() else 0)
trusted fun Cst3530Owner.wake(): Cst3530Owner = this.wakeOwned()
trusted fun Cst3530Owner.close(): Cst3530Owner = this.closeOwned()
trusted fun Cst3530Owner.readFrame(snapshot: NativeBuffer): int =
    if (this.ready()) this.view().readFrame(snapshot) else -3
