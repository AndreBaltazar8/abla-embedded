import "./point.ab"

// Endpoint-preserving integer scaling between coordinate counts. Truncate
// fractional coordinates toward zero; no clamping and no affine calibration.
// A one-coordinate source axis maps to zero. Products fit u32 even for
// full16-bit endpoints (65535*65535), avoiding runtime64-bit division.
fun TouchPoint.scaled(sourceWidth: int,sourceHeight: int,width: int,height: int): TouchPoint {
    if (!this.inside(sourceWidth,sourceHeight) || width < 1 || width > 65536 || height < 1 || height > 65536) return TouchPoint(0)
    val x=if (sourceWidth == 1) 0 else int((u32(this.x())*u32(width-1))/u32(sourceWidth-1))
    val y=if (sourceHeight == 1) 0 else int((u32(this.y())*u32(height-1))/u32(sourceHeight-1))
    return touchPoint(x,y,this.id(),this.event(),this.size())
}

// M5GFX raw LCD rotation0..7; unlike rotated(), rotation1 is counterclockwise.
// Dimensions are unrotated controller coordinate counts. Preserve metadata.
fun TouchPoint.forLcdRotation(width: int, height: int, rotation: int): TouchPoint {
    if (!this.inside(width, height) || rotation < 0 || rotation > 7) return TouchPoint(0)
    val swapped = (rotation & 1) != 0
    val outputWidth = if (swapped) height else width
    val outputHeight = if (swapped) width else height
    val x = if (swapped) this.y() else this.x()
    val y = if (swapped) this.x() else this.y()
    touchPoint(if ((rotation & 2) != 0) outputWidth - 1 - x else x,
        if (((150 >> rotation) & 1) != 0) outputHeight - 1 - y else y,
        this.id(), this.event(), this.size())
}

// Dimensions are coordinate counts, not maximum indices. Out-of-bounds
// input is rejected, never clamped into a false edge contact.
fun TouchPoint.inside(width: int, height: int): bool =
    this.valid() && width >= 1 && width <= 65536 && height >= 1 && height <= 65536 &&
        this.x() < width && this.y() < height

// Clockwise quarter turns in top-left-origin screen coordinates. Odd turns
// swap output width/height. Contact identity and controller event are retained.
fun TouchPoint.rotated(width: int, height: int, quarterTurns: int): TouchPoint {
    if (!this.inside(width, height) || quarterTurns < 0 || quarterTurns > 3) return TouchPoint(0)
    if (quarterTurns == 0) return this
    if (quarterTurns == 1) return touchPoint(height - 1 - this.y(), this.x(), this.id(), this.event(), this.size())
    if (quarterTurns == 2) return touchPoint(width - 1 - this.x(), height - 1 - this.y(), this.id(), this.event(), this.size())
    touchPoint(this.y(), width - 1 - this.x(), this.id(), this.event(), this.size())
}

fun TouchPoint.mirrored(width: int, height: int, horizontal: bool, vertical: bool): TouchPoint {
    if (!this.inside(width, height)) return TouchPoint(0)
    touchPoint(if (horizontal) width - 1 - this.x() else this.x(),
        if (vertical) height - 1 - this.y() else this.y(), this.id(), this.event(), this.size())
}
