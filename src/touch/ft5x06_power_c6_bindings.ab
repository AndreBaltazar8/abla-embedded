import "./controller_open.ab"
import "./ft5x06_power_sequence.ab"
import "../hal/delay.ab"
import "../hal/touch.ab"
// Caller owns calibrated clocks and the IRQ pad, with hold/LP ownership
// already released. Generic power hook pull0=up,1=down; C6 pull1=up,2=down.
@export("ft5x06PowerPinValid")
fun ft5x06PowerPinValidHook(interrupt: int): bool = esp32C6GpioNumberValid(interrupt)
@export("ft5x06PowerInputOwned")
trusted fun ft5x06PowerInputOwnedHook(interrupt: int,pull: int): bool =
    (pull == 0 || pull == 1) && Pin(interrupt).inputPullOwned(if (pull == 0) 1 else 2)
@export("ft5x06PowerDelayMicroseconds")
trusted fun ft5x06PowerDelayMicrosecondsHook(us: int): void = peripheralDelayMicroseconds(us)
@export("ft5x06PowerSleep")
trusted fun ft5x06PowerSleepHook(handle: int): bool = Ft5x06(handle).sleep()
@export("ft5x06PowerMonitor")
trusted fun ft5x06PowerMonitorHook(handle: int): bool = Ft5x06(handle).monitorMode()
