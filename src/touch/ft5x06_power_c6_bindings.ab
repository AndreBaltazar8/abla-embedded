import "./controller_open.ab"
import "./ft5x06_power_sequence.ab"
// Caller owns calibrated clocks and the IRQ pad, with hold/LP ownership
// already released. Generic power hook pull0=up,1=down; C6 pull1=up,2=down.
fun ft5x06PowerPinValid(interrupt: int): bool = esp32C6GpioNumberValid(interrupt)
trusted fun ft5x06PowerInputOwned(interrupt: int,pull: int): bool =
    (pull == 0 || pull == 1) && Pin(interrupt).inputPullOwned(if (pull == 0) 1 else 2)
trusted fun ft5x06PowerDelayMicroseconds(us: int): void = peripheralDelayMicroseconds(us)
trusted fun ft5x06PowerSleep(handle: int): bool = Ft5x06(handle).sleep()
trusted fun ft5x06PowerMonitor(handle: int): bool = Ft5x06(handle).monitorMode()
