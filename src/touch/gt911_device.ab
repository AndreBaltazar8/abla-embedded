import "./gt911_logic.ab"
import "./gt911_snapshot.ab"
import "../i2c/helpers/register_address16.ab"
import "../checksum/sum8.ab"
import "../i2c/device.ab"

// Caller configures reset/IRQ address selection and wake pins. Addresses0x5d
// and0x14 are explicit; never switch addresses or drive pads behind the caller.
import "./gt911_type.ab"
import "../hal/gt911.ab"
import "abla/unsafe/memory/raw"
import "../esp32/sdk/raw_buffer.ab"
import "../i2c/results.ab"
import "../hal/native_buffer.ab"
import "../esp32/sdk/nativebuffer_type.ab"
import "../hal/i2cdevice.ab"
trusted fun gt911(bus: I2cBus, address: int = 93, frequency: int = 400000): Gt911 =
    Gt911(if (bus.valid() && (address == 93 || address == 20))
        bus.device(address, frequency) & 4294967295 else 0)
@exportLocal("abla_gt911_valid")
fun gt911ValidHook(recv: int): bool = Gt911(recv) > 0 && Gt911(recv) <= 4294967295
@exportLocal("abla_gt911_device")
fun gt911DeviceHook(recv: int): I2cDevice = I2cDevice(if (Gt911(recv).valid()) Gt911(recv) | 0 else 0)
@exportLocal("abla_gt911_close")
trusted fun gt911CloseHook(recv: int): bool = Gt911(recv).valid() && Gt911(recv).device().close()

// Explicitly acknowledge/discard a queued report. Board code can use this
// after reset or after a long polling gap, as M5GFX does before retrying.
@exportLocal("abla_gt911_discardPending")
trusted fun gt911DiscardPendingHook(recv: int): bool =
    Gt911(recv).valid() && Gt911(recv).device().writeRegisterAddress16Byte(0x814e, 0)
@exportLocal("abla_gt911_refreshPeriodMillisecondsChecked")
trusted fun gt911RefreshPeriodMillisecondsCheckedHook(recv: int): I2cByteResult {
    if (!Gt911(recv).valid()) return I2cByteResult(0)
    val value = Gt911(recv).device().readRegisterAddress16ByteChecked(0x8056)
    if (!value.valid()) return I2cByteResult(0)
    I2cByteResult(256 | (5 + (value.value() & 15)))
}
@exportLocal("abla_gt911_begin")
trusted fun gt911BeginHook(recv: int): bool =
    Gt911(recv).discardPending() && Gt911(recv).refreshPeriodMillisecondsChecked().valid()
// Caller must apply the documented IRQ-pad sleep/wake sequence separately.
@exportLocal("abla_gt911_sleepCommand")
trusted fun gt911SleepCommandHook(recv: int): bool =
    Gt911(recv).valid() && Gt911(recv).device().writeRegisterAddress16Byte(0x8040, 5)

// Caller holds exclusive sensor ownership through this read-modify-write.
// Preserve all184 current configuration bytes except the explicitly selected
// contact limit. Nothing is written if the read fails. One188-byte write sends
// register address, config, checksum and fresh flag; errors are not success.
@exportLocal("abla_gt911_updateConfiguration")
trusted fun gt911UpdateConfigurationHook(recv: int, maximumContacts: int): bool {
    if (!Gt911(recv).valid() || (maximumContacts != -1 &&
        (maximumContacts < 1 || maximumContacts > 5))) return false
    val address = nativeStackAllocate(188)
    val packet = nativeBufferAt(address, 188)
    val configuration = nativeBufferAt(address + 2, 184)
    if (!Gt911(recv).device().readRegisterAddress16(0x8047, configuration, 184)) return false
    if (maximumContacts != -1) {
        if (configuration.load(5) == maximumContacts) return true
        configuration.store(5, maximumContacts)
    }
    packet.store(0, 128)
    packet.store(1, 71)
    var sum = 0
    var index = 0
    while (index < 184) {
        sum = checksum8Add(sum, configuration.load(index))
        index = index + 1
    }
    packet.store(186, checksum8Complement(sum))
    packet.store(187, 1)
    Gt911(recv).device().write(packet, 188)
}
@exportLocal("abla_gt911_setMaximumContacts")
trusted fun gt911SetMaximumContactsHook(recv: int, count: int): bool =
    count >= 1 && count <= 5 && Gt911(recv).updateConfiguration(count)
@exportLocal("abla_gt911_refreshConfiguration")
trusted fun gt911RefreshConfigurationHook(recv: int): bool = Gt911(recv).updateConfiguration(-1)

// Up to five8-byte contacts, caller storage40bytes. Returns0..5 report count,
// -1 transport/argument error, -2 not ready, -3 malformed status. The device
// holds data until acknowledgment; read errors leave the report pending.
// Acknowledgment failure returns error (no successfully consumed report).
// Caller must serialize all readers/discard operations for this touch device.
@exportLocal("abla_gt911_readFrame")
trusted fun gt911ReadFrameHook(recv: int, destination: NativeBuffer): int {
    if (!Gt911(recv).valid() || !destination.hasAddressRange(0, 40)) return -1
    val status = Gt911(recv).device().readRegisterAddress16ByteChecked(0x814e)
    if (!status.valid()) return -1
    val count = gt911ReadyCount(status.value())
    if (count < 0) return count
    if (count > 0 && !Gt911(recv).device().readRegisterAddress16(0x814f, destination, count * 8)) return -1
    if (!Gt911(recv).discardPending()) return -1
    count
}
