// Raw controller coordinates:16-bit X/Y,8-bit contact ID,2-bit event,
// 16-bit contact size and validity bit58. One scalar, no allocation. Supports
// GT911's full wire fields as well as FT5x06 without silently truncating data.
type TouchPoint = int
fun touchPoint(x: int, y: int, id: int, event: int, size: int = 1): TouchPoint =
    TouchPoint(if (x >= 0 && x <= 65535 && y >= 0 && y <= 65535 &&
        id >= 0 && id <= 255 && event >= 0 && event <= 3 && size >= 0 && size <= 65535)
        (1 << 58) | x | (y << 16) | (id << 32) | (event << 40) | (size << 42) else 0)
fun TouchPoint.valid(): bool = this >= (1 << 58) && (this >>> 59) == 0
fun TouchPoint.x(): int = this & 65535
fun TouchPoint.y(): int = (this >>> 16) & 65535
fun TouchPoint.id(): int = (this >>> 32) & 255
fun TouchPoint.event(): int = (this >>> 40) & 3
fun TouchPoint.size(): int = (this >>> 42) & 65535

fun ft5x06PointBytes(xHigh: int, xLow: int, yHigh: int, yLow: int): TouchPoint {
    if (xHigh < 0 || xHigh > 255 || xLow < 0 || xLow > 255 ||
        yHigh < 0 || yHigh > 255 || yLow < 0 || yLow > 255) return TouchPoint(0)
    touchPoint(((xHigh & 15) << 8) | xLow, ((yHigh & 15) << 8) | yLow,
        yHigh >>> 4, xHigh >>> 6)
}
fun ft5x06SnapshotBytes(count: int): int =
    if (count == 0) 1 else if (count >= 1 && count <= 5) count * 6 - 1 else 0
