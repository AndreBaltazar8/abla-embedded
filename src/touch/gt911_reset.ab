import "./gt911_reset_sequence.ab"
// Select Pin and a calibrated peripheralDelayMicroseconds implementation.
// Completion proves the GPIO sequence was issued, not controller detection.
fun gt911ResetPadValid(number: int,interrupt: bool): bool =
    pin(number).outputCapable() && (!interrupt || pin(number).pullCapable())
trusted fun gt911ResetDrive(number: int,high: bool): void {
    val pad=pin(number)
    pad.write(high)
    pad.output()
    return
}
trusted fun gt911ResetInput(number: int): void {
    val pad=pin(number)
    pad.input()
    pad.pullUp()
    return
}
trusted fun gt911ResetDelayUs(duration: int): void {
    peripheralDelayMicroseconds(duration)
    return
}
trusted fun gt911ResetAddress(reset: Pin,interrupt: Pin,address: int): bool =
    gt911ResetAddressOwned(reset | 0,interrupt | 0,address)
