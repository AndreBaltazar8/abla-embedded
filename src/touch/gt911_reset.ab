import "./gt911_reset_sequence.ab"
import "../hal/delay.ab"
import "../hal/touch.ab"
// Select Pin and a calibrated peripheralDelayMicroseconds implementation.
// Completion proves the GPIO sequence was issued, not controller detection.
@export("gt911ResetPadValid")
fun gt911ResetPadValidHook(number: int,interrupt: bool): bool =
    pin(number).outputCapable() && (!interrupt || pin(number).pullCapable())
@export("gt911ResetDrive")
trusted fun gt911ResetDriveHook(number: int,high: bool): void {
    val pad=pin(number)
    pad.write(high)
    pad.output()
    return
}
@export("gt911ResetInput")
trusted fun gt911ResetInputHook(number: int): void {
    val pad=pin(number)
    pad.input()
    pad.pullUp()
    return
}
@export("gt911ResetDelayUs")
trusted fun gt911ResetDelayUsHook(duration: int): void {
    peripheralDelayMicroseconds(duration)
    return
}
trusted fun gt911ResetAddress(reset: Pin,interrupt: Pin,address: int): bool =
    gt911ResetAddressOwned(reset | 0,interrupt | 0,address)
