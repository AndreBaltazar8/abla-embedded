import "./point.ab"
import "../esp32/sdk/raw_buffer.ab"
// M5GFX CST3530 command ordering, including both20ms delays and all commands
// even after a failed write. Caller owns powered controller and configured bus.
trusted fun cst3530BeginOwned(handle: int): bool {
    if (handle <= 0 || handle > 4294967295) return false
    var okay=cst3530Command(handle,0xD0000400)
    cst3530Delay(20)
    okay=cst3530Command(handle,0xD0000400) && okay
    cst3530Delay(20)
    okay=cst3530Command(handle,0xD0000000) && okay
    okay=cst3530Command(handle,0xD0000C00) && okay
    cst3530Command(handle,0xD0000100) && okay
}
// The header has two4-bit counts, so consume up to30 five-byte records, not
// an unchecked/truncated50-byte snapshot. Expose at most five touch contacts.
// 154B caller scratch. -1 read/arguments, -2 acknowledgment failed.
// Even a failed continuation is acknowledged/discarded, matching upstream,
// but is NEVER reported as a successful empty frame.
trusted fun cst3530ReadOwned(handle: int,snapshot: NativeBuffer): int {
    if (handle <= 0 || handle > 4294967295 || !snapshot.hasAddressRange(0,154)) return -1
    if (!cst3530Header(handle,snapshot)) return -1
    val fingers=snapshot.load(3)&15
    val keys=(snapshot.load(3)>>>4)&15
    val total=fingers+keys
    var okay=true
    if (total > 1) okay=cst3530Continue(handle,nativeBufferAt(snapshot.addressValue()+9,(total-1)*5),(total-1)*5)
    if (!cst3530Command(handle,0xD00002AB)) return -2
    if (!okay) return -1
    if (fingers == 0 || (snapshot.load(8)>>>4) == 0) return 0
    if (fingers > 5) 5 else fingers
}
trusted fun cst3530Point(snapshot: NativeBuffer,count: int,index: int): TouchPoint {
    if (!snapshot.hasAddressRange(0,9) || count < 1 || count > 5 || index < 0 || index >= count ||
        (snapshot.load(8)>>>4) == 0) return TouchPoint(0)
    val fingers=snapshot.load(3)&15
    val keys=(snapshot.load(3)>>>4)&15
    if (count != (if (fingers > 5) 5 else fingers) || !snapshot.hasAddressRange(0,4+(keys+fingers)*5)) return TouchPoint(0)
    val offset=(keys+index)*5
    touchPoint(snapshot.load(offset+4)|((snapshot.load(offset+7)&15)<<8),
        snapshot.load(offset+5)|((snapshot.load(offset+7)&240)<<4),index,2,1)
}
