// Scalar owned controller: low32 device handle, kind in bits32..39
// (1 FT5x06, 2 GT911, 3 CHSC6540, 6 ST7123), status in bits40..47. Status0 invalid/closed,
// 1 ready, 2 allocation failure, 3 begin failed and released, 4 cleanup failed.
// Power sequencing adds5 asleep and6 uncertain after a failed command.
// Never discard status4: it retains the handle for an explicit close retry.
type TouchControllerOpen = int
fun TouchControllerOpen.kind(): int = (this>>>32)&255
fun TouchControllerOpen.status(): int = (this>>>40)&255
fun TouchControllerOpen.handle(): int = this&4294967295
fun TouchControllerOpen.ready(): bool = this.status() == 1 && this.handle() != 0 &&
    ((this.kind() >= 1 && this.kind() <= 3) || this.kind() == 6)
// Caller already owns/configured bus, power/reset/IRQ pads and any required
// settling delay. No pad guessing, recovery, address scan or implicit retry.
trusted fun touchControllerOpenOwned(bus: int,kind: int,address: int,frequency: int): TouchControllerOpen {
    if (bus <= 0 || bus > 8589934591 || !((kind >= 1 && kind <= 3) || kind == 6) ||
        address < 8 || address > 119 || (kind == 2 && address != 20 && address != 93) ||
        frequency < 1 || frequency > 400000) return TouchControllerOpen(0)
    val tag=kind<<32
    val handle=touchControllerAllocate(bus,kind,address,frequency)
    if (handle == 0) return TouchControllerOpen((2<<40)|tag)
    if (touchControllerBegin(kind,handle)) return TouchControllerOpen((1<<40)|tag|handle)
    if (touchControllerRelease(kind,handle)) return TouchControllerOpen((3<<40)|tag)
    TouchControllerOpen((4<<40)|tag|handle)
}
// Assign the result back to the owner. Borrowed Ft5x06/Gt911 views become
// invalid on successful close; failed close must not be used for polling.
trusted fun TouchControllerOpen.closeOwned(): TouchControllerOpen {
    if (this.handle() == 0) return TouchControllerOpen(0)
    if (!((this.kind() >= 1 && this.kind() <= 3) || this.kind() == 6) ||
        (this.status() != 1 && this.status() != 4 && this.status() != 5 && this.status() != 6)) return this
    if (touchControllerRelease(this.kind(),this.handle())) return TouchControllerOpen(0)
    TouchControllerOpen((4<<40)|(this.kind()<<32)|this.handle())
}
