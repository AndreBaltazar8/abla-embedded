import "./point.ab"
import "../esp32/sdk/raw_buffer.ab"
// Cached M5GFX esp32p4/Touch_ST7123.cpp register protocol. Check every
// transaction: upstream can otherwise accept failed firmware/report reads.
trusted fun st7123BeginOwned(handle: int,info: NativeBuffer): bool {
    if (handle <= 0 || handle > 4294967295 || !info.hasAddressRange(0,10)) return false
    val base=info.addressValue()
    if (!st7123Read(handle,0,nativeBufferAt(base,1),1) ||
        !st7123Read(handle,12,nativeBufferAt(base+1,4),4) ||
        !st7123Read(handle,5,nativeBufferAt(base+5,5),5)) return false
    var sum=0
    var i=0
    while (i < 10) { sum=sum+info.load(i); i=i+1 }
    sum != 0
}
// 72B snapshot: selected slot count, advance-info, up to10 seven-byte slots.
// Returns valid contact count, -1 read/arguments, -2 no coordinate report.
// No-coordinate is not a verified empty coordinate report. Never gate on IRQ
// without separately defining its polarity/meaning for the selected board.
trusted fun st7123ReadOwned(handle: int,snapshot: NativeBuffer): int {
    if (handle <= 0 || handle > 4294967295 || !snapshot.hasAddressRange(0,72)) return -1
    val base=snapshot.addressValue()
    snapshot.store(0,0)
    if (!st7123Read(handle,16,nativeBufferAt(base+1,1),1)) return -1
    if ((snapshot.load(1)&8) == 0) return -2
    if (!st7123Read(handle,9,nativeBufferAt(base,1),1)) return -1
    val slots=if (snapshot.load(0) > 10) 10 else snapshot.load(0)
    snapshot.store(0,slots)
    if (slots > 0 && !st7123Read(handle,20,nativeBufferAt(base+2,slots*7),slots*7)) return -1
    var count=0
    var slot=0
    while (slot < slots) {
        if ((snapshot.load(2+slot*7)&128) != 0) count=count+1
        slot=slot+1
    }
    count
}
// index is compact contact index; preserve sparse hardware slot ID0..9.
// Caller must have received a successful read result before decoding.
trusted fun st7123Point(snapshot: NativeBuffer,index: int): TouchPoint {
    if (!snapshot.hasAddressRange(0,2) || index < 0 || index >= 10 || (snapshot.load(1)&8) == 0) return TouchPoint(0)
    val slots=snapshot.load(0)
    if (slots > 10 || !snapshot.hasAddressRange(0,2+slots*7)) return TouchPoint(0)
    var slot=0
    var selected=0
    while (slot < slots) {
        val offset=2+slot*7
        val flags=snapshot.load(offset)
        if ((flags&128) != 0) {
            if (selected == index) return touchPoint(((flags&63)<<8)|snapshot.load(offset+1),
                (snapshot.load(offset+2)<<8)|snapshot.load(offset+3),slot,2,snapshot.load(offset+4))
            selected=selected+1
        }
        slot=slot+1
    }
    TouchPoint(0)
}
