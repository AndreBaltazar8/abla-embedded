import "./chsc6540_device.ab"
import "./chsc6540_irq_sequence.ab"
trusted fun chsc6540InterruptLevel(number: int): int =
    if (!pin(number).valid()) -1 else if (pin(number).read()) 1 else 0
trusted fun Chsc6540.readWithInterrupt(interrupt: Pin,snapshot: NativeBuffer): int =
    chsc6540ReadInterruptOwned(this | 0,interrupt | 0,snapshot,nativeBufferAt(nativeStackAllocate(11),11))
