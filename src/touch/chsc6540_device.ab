import "./chsc6540_sequence.ab"
type Chsc6540 = int
trusted fun chsc6540(bus: I2cBus,address: int = 46,frequency: int = 400000): Chsc6540 =
    Chsc6540(if (bus.valid()) bus.device(address,frequency)&4294967295 else 0)
fun Chsc6540.valid(): bool = this > 0 && this <= 4294967295
fun Chsc6540.device(): I2cDevice = I2cDevice(if (this.valid()) this | 0 else 0)
trusted fun Chsc6540.close(): bool = this.valid() && this.device().close()
// IRQ pad configuration and power/reset are explicitly board-owned.
trusted fun Chsc6540.begin(): bool {
    if (!this.valid()) return false
    val packet=nativeBufferAt(nativeStackAllocate(2),2)
    packet.store(0,90); packet.store(1,90)
    this.device().write(packet,2)
}
trusted fun chsc6540Capture(handle: int,snapshot: NativeBuffer): int {
    val device=Chsc6540(handle).device()
    if (!device.readRegister(2,snapshot,1)) return -1
    val count=snapshot.load(0)
    if (count == 0) return 0
    if (count > 2) return -3
    // Re-read count together with the complete selected report. A changed
    // count is an unstable capture, never permission to decode missing bytes.
    if (!device.readRegister(2,snapshot,count*6-1)) return -1
    if (snapshot.load(0) != count) return -1
    count
}
trusted fun Chsc6540.readStable(snapshot: NativeBuffer): int =
    chsc6540ReadStableOwned(this | 0,snapshot,nativeBufferAt(nativeStackAllocate(11),11))
