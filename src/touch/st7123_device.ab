import "./st7123_sequence.ab"
import "../i2c/register_address16.ab"
type St7123 = int
trusted fun st7123(bus: I2cBus,address: int = 85,frequency: int = 400000): St7123 =
    St7123(if (bus.valid()) bus.device(address,frequency)&4294967295 else 0)
fun St7123.valid(): bool = this > 0 && this <= 4294967295
fun St7123.device(): I2cDevice = I2cDevice(if (this.valid()) this | 0 else 0)
trusted fun St7123.close(): bool = this.valid() && this.device().close()
trusted fun st7123Read(handle: int,register: int,buffer: NativeBuffer,count: int): bool =
    St7123(handle).device().readRegisterAddress16(register,buffer,count)
// Caller supplies power/reset and bus setup; firmware version1/3 identifies
// Tab5 panel variants separately. Other nonzero firmware is not guessed here.
trusted fun St7123.begin(): bool = st7123BeginOwned(this | 0,nativeBufferAt(nativeStackAllocate(10),10))
trusted fun St7123.readFrame(snapshot: NativeBuffer): int = st7123ReadOwned(this | 0,snapshot)
