import "./controller_open_sequence.ab"
// Caller exclusively owns the powered controller and IRQ pad. Assign return
// value back to the owner; sleeping/uncertain devices cannot yield ready views.
// No bus/reset recovery. An invalid request leaves the owner unchanged.
// pin=-1 explicitly means no IRQ pad (FT only); GT wake requires a driven pad.
trusted fun TouchControllerOpen.sleepOwned(interrupt: int): TouchControllerOpen {
    if (!this.ready() || (this.kind() != 1 && this.kind() != 2) || !touchPowerPadValid(this.kind(),interrupt)) return this
    if (this.kind() == 2) touchPowerPrepareSleep(interrupt)
    val status=if (touchPowerSleepCommand(this.kind(),this.handle())) 5 else 6
    TouchControllerOpen((status<<40)|(this.kind()<<32)|this.handle())
}
trusted fun TouchControllerOpen.wakeOwned(interrupt: int): TouchControllerOpen {
    if (this.handle() == 0 || (this.kind() != 1 && this.kind() != 2) ||
        (this.status() != 5 && this.status() != 6) || !touchPowerPadValid(this.kind(),interrupt)) return this
    touchPowerWakePulse(this.kind(),interrupt)
    val success=if (this.kind() == 1) touchPowerMonitor(this.handle()) else true
    TouchControllerOpen(((if (success) 1 else 6)<<40)|(this.kind()<<32)|this.handle())
}
