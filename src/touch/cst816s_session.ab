import "./cst816s_device.ab"
import "./cst816s_session_sequence.ab"
// Allocates a device slot only; initialized() remains false until a poll has
// successfully completed all initialization writes. No fake begin success.
trusted fun openCst816sSession(bus: I2cBus,address: int = 21,frequency: int = 400000): Cst816sSession =
    cst816sSessionOwned(cst816s(bus,address,frequency) | 0)
trusted fun cst816sSessionRelease(handle: int): bool = Cst816s(handle).close()
trusted fun Cst816sSession.poll(snapshot: NativeBuffer,now: int): Cst816sSession = this.pollOwned(snapshot,now)
trusted fun Cst816sSession.close(): Cst816sSession = this.closeOwned()
