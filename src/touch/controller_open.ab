import "./controller_open_sequence.ab"
import "./ft5x06_device.ab"
import "./gt911_device.ab"
import "./chsc6540_device.ab"
import "./st7123_device.ab"
trusted fun touchControllerAllocate(bus: int,kind: int,address: int,frequency: int): int =
    if (kind == 1) ft5x06(I2cBus(bus),address,frequency) | 0 else if (kind == 2) gt911(I2cBus(bus),address,frequency) | 0 else if (kind == 3) chsc6540(I2cBus(bus),address,frequency) | 0 else st7123(I2cBus(bus),address,frequency) | 0
trusted fun touchControllerBegin(kind: int,handle: int): bool =
    if (kind == 1) Ft5x06(handle).begin() else if (kind == 2) Gt911(handle).begin() else if (kind == 3) Chsc6540(handle).begin() else St7123(handle).begin()
trusted fun touchControllerRelease(kind: int,handle: int): bool =
    if (kind == 1) Ft5x06(handle).close() else if (kind == 2) Gt911(handle).close() else if (kind == 3) Chsc6540(handle).close() else St7123(handle).close()
trusted fun openSt7123(bus: I2cBus,address: int = 85,frequency: int = 400000): TouchControllerOpen =
    touchControllerOpenOwned(bus | 0,6,address,frequency)
fun TouchControllerOpen.st7123View(): St7123 = St7123(if (this.ready() && this.kind() == 6) this.handle() else 0)
trusted fun openChsc6540(bus: I2cBus,address: int = 46,frequency: int = 400000): TouchControllerOpen =
    touchControllerOpenOwned(bus | 0,3,address,frequency)
fun TouchControllerOpen.chsc6540View(): Chsc6540 = Chsc6540(if (this.ready() && this.kind() == 3) this.handle() else 0)
trusted fun openFt5x06(bus: I2cBus,address: int = 56,frequency: int = 400000): TouchControllerOpen =
    touchControllerOpenOwned(bus | 0,1,address,frequency)
trusted fun openGt911(bus: I2cBus,address: int = 93,frequency: int = 400000): TouchControllerOpen =
    touchControllerOpenOwned(bus | 0,2,address,frequency)
fun TouchControllerOpen.ft5x06View(): Ft5x06 = Ft5x06(if (this.ready() && this.kind() == 1) this.handle() else 0)
fun TouchControllerOpen.gt911View(): Gt911 = Gt911(if (this.ready() && this.kind() == 2) this.handle() else 0)
trusted fun TouchControllerOpen.close(): TouchControllerOpen = this.closeOwned()
