import "./point.ab"

fun gt911ReadyCount(status: int): int {
    if (status < 0 || status > 255) return -3
    if ((status & 128) == 0) return -2
    val count = status & 15
    if (count > 5) return -3
    count
}

// GT911 supplies no down/up event field:2 means a reported contact sample.
// Gesture code derives transitions from successive contact IDs/report counts.
fun gt911PointValues(id: int, x: int, y: int, size: int): TouchPoint =
    touchPoint(x, y, id, 2, size)
