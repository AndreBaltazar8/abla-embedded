import "./chsc6540_sequence.ab"
// CHSC6540's high IRQ means no contacts, unlike GT911's not-ready status.
// Caller configured and exclusively owns IRQ input; negative read is failure.
trusted fun chsc6540ReadInterruptOwned(handle: int,interrupt: int,snapshot: NativeBuffer,previous: NativeBuffer): int {
    if (handle <= 0 || handle > 4294967295 || !snapshot.hasAddressRange(0,11) ||
        !previous.hasAddressRange(0,11)) return -1
    val a=snapshot.addressValue()
    val b=previous.addressValue()
    if (a < b+11 && b < a+11) return -1
    val level=chsc6540InterruptLevel(interrupt)
    if (level != 0 && level != 1) return -1
    if (level == 1) return 0
    chsc6540ReadStableOwned(handle,snapshot,previous)
}
