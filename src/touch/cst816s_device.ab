import "./cst816s_sequence.ab"
type Cst816s = int
trusted fun cst816s(bus: I2cBus,address: int = 21,frequency: int = 400000): Cst816s =
    Cst816s(if (bus.valid()) bus.device(address,frequency)&4294967295 else 0)
fun Cst816s.valid(): bool = this > 0 && this <= 4294967295
fun Cst816s.device(): I2cDevice = I2cDevice(if (this.valid()) this | 0 else 0)
trusted fun Cst816s.close(): bool = this.valid() && this.device().close()
trusted fun cst816sWrite(handle: int,register: int,value: int): bool = Cst816s(handle).device().writeRegister8(register,value)
trusted fun cst816sRead(handle: int,register: int,buffer: NativeBuffer,count: int): bool =
    Cst816s(handle).device().readRegister(register,buffer,count)
// Caller provides powered controller, reset10ms low +10ms high settling when
// reset is wired, and optional IRQ input-pullup. No automatic bus recovery.
trusted fun Cst816s.begin(): bool = cst816sBeginOwned(this | 0,nativeBufferAt(nativeStackAllocate(3),3))
trusted fun Cst816s.readFrame(snapshot: NativeBuffer): int = cst816sReadOwned(this | 0,snapshot)
