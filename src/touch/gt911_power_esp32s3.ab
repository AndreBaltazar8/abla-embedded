import "./controller_open.ab"
import "./gt911_power_sequence.ab"
import "../esp32/gpio_esp32s3.ab"
import "../esp32/gpio/input_s3_sequence.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
// Caller releases RTC/holds and owns IRQ matrix/OE/pulls for the full call.
// Calibrated ROM delays: no ISR or interrupt-masked call context.
fun gt911PowerPinValid(interrupt: int): bool = espChipS3().gpioOutputValid(interrupt)
trusted fun gt911PowerOutputLowOwned(interrupt: int): bool = esp32S3GpioOutputLevelOwned(interrupt,false)
trusted fun gt911PowerWriteHighOwned(interrupt: int): bool = esp32S3GpioWriteLevelOwned(interrupt,true)
trusted fun gt911PowerInputPullupOwned(interrupt: int): bool = esp32S3GpioPrepareInputOwned(interrupt,0,true) == 1
trusted fun gt911PowerDelayMilliseconds(ms: int): void = peripheralDelayMilliseconds(ms)
trusted fun gt911PowerSleep(handle: int): bool = Gt911(handle).sleepCommand()
