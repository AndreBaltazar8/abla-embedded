import "./controller_open.ab"
import "./gt911_power_sequence.ab"
import "../esp32/gpio_esp32s3.ab"
import "../esp32/gpio/input_s3_sequence.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
import "../hal/delay.ab"
import "../hal/touch.ab"
import "../hal/touch_2.ab"
import "../hal/gt911.ab"
// Caller releases RTC/holds and owns IRQ matrix/OE/pulls for the full call.
// Calibrated ROM delays: no ISR or interrupt-masked call context.
@export("gt911PowerPinValid")
fun gt911PowerPinValidHook(interrupt: int): bool = espChipS3().gpioOutputValid(interrupt)
@export("gt911PowerOutputLowOwned")
trusted fun gt911PowerOutputLowOwnedHook(interrupt: int): bool = esp32S3GpioOutputLevelOwned(interrupt,false)
@export("gt911PowerWriteHighOwned")
trusted fun gt911PowerWriteHighOwnedHook(interrupt: int): bool = esp32S3GpioWriteLevelOwned(interrupt,true)
@export("gt911PowerInputPullupOwned")
trusted fun gt911PowerInputPullupOwnedHook(interrupt: int): bool = esp32S3GpioPrepareInputOwned(interrupt,0,true) == 1
@export("gt911PowerDelayMilliseconds")
trusted fun gt911PowerDelayMillisecondsHook(ms: int): void = peripheralDelayMilliseconds(ms)
@export("gt911PowerSleep")
trusted fun gt911PowerSleepHook(handle: int): bool = Gt911(handle).sleepCommand()
