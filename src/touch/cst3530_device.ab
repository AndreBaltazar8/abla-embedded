import "./cst3530_sequence.ab"
type Cst3530 = int
trusted fun cst3530(bus: I2cBus,address: int = 88,frequency: int = 400000): Cst3530 =
    Cst3530(if (bus.valid()) bus.device(address,frequency)&4294967295 else 0)
fun Cst3530.valid(): bool = this > 0 && this <= 4294967295
fun Cst3530.device(): I2cDevice = I2cDevice(if (this.valid()) this | 0 else 0)
trusted fun Cst3530.close(): bool = this.valid() && this.device().close()
trusted fun cst3530Address(packet: NativeBuffer,command: int): void {
    packet.store(0,(command>>>24)&255); packet.store(1,(command>>>16)&255)
    packet.store(2,(command>>>8)&255); packet.store(3,command&255)
    return
}
trusted fun cst3530Command(handle: int,command: int): bool {
    val packet=nativeBufferAt(nativeStackAllocate(4),4)
    cst3530Address(packet,command)
    Cst3530(handle).device().write(packet,4)
}
trusted fun cst3530Header(handle: int,snapshot: NativeBuffer): bool {
    val packet=nativeBufferAt(nativeStackAllocate(4),4)
    cst3530Address(packet,0xD0070000)
    Cst3530(handle).device().writeRead(packet,4,snapshot,9)
}
trusted fun cst3530Continue(handle: int,buffer: NativeBuffer,count: int): bool = Cst3530(handle).device().read(buffer,count)
trusted fun cst3530Delay(milliseconds: int): void { peripheralDelayMilliseconds(milliseconds); return }
trusted fun Cst3530.begin(): bool = cst3530BeginOwned(this | 0)
trusted fun Cst3530.readFrame(snapshot: NativeBuffer): int = cst3530ReadOwned(this | 0,snapshot)
// Upstream wake replays initialization; no sleep command is documented there.
trusted fun Cst3530.wake(): bool = this.begin()
