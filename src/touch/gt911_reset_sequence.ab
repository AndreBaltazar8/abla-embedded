// GT911 address selection: reset low20ms, IRQ address level, settle200us,
// reset high6ms, IRQ low50ms, then release IRQ to input. Address is seven-bit:
// IRQ high selects0x14; low selects0x5d. Reference Linux goodix.c
// goodix_reset_no_int_sync/goodix_int_sync, not an address-scanning heuristic.
// https://github.com/torvalds/linux/blob/master/drivers/input/touchscreen/goodix.c
// Caller owns both pads, powered controller and all readers; no I2C or reset
// of any shared bus. Reject aliases and unsupported pads before the first write.
trusted fun gt911ResetAddressOwned(reset: int,interrupt: int,address: int): bool {
    if ((address != 20 && address != 93) || reset == interrupt ||
        !gt911ResetPadValid(reset,false) || !gt911ResetPadValid(interrupt,true)) return false
    gt911ResetDrive(reset,false)
    gt911ResetDelayUs(20000)
    gt911ResetDrive(interrupt,address == 20)
    gt911ResetDelayUs(200)
    gt911ResetDrive(reset,true)
    gt911ResetDelayUs(6000)
    gt911ResetDrive(interrupt,false)
    gt911ResetDelayUs(50000)
    gt911ResetInput(interrupt)
    true
}
