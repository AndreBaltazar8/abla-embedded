// The sample format of a PDM receive session, packed so a session begin stays within the 16 arguments a hook may take:
// bits 0..15 the slot mask, bit 16 PCM output (else raw PDM), bit 17 128x downsampling (else 64x), bit 18 inverted
// clock, bit 19 set by pdmFormat. A slot mask out of range gives PdmFormat(0), which a session begin refuses.
type PdmFormat = int
fun pdmFormat(slots: int,pcm: bool,downsample128: bool,invertClock: bool): PdmFormat {
    if (slots < 0 || slots > 65535) return PdmFormat(0)
    PdmFormat(slots | (if (pcm) 1<<16 else 0) | (if (downsample128) 1<<17 else 0) | (if (invertClock) 1<<18 else 0) | (1<<19))
}
fun PdmFormat.slots(): int = this & 65535
fun PdmFormat.pcm(): bool = (this & (1<<16)) != 0
fun PdmFormat.downsample128(): bool = (this & (1<<17)) != 0
fun PdmFormat.invertClock(): bool = (this & (1<<18)) != 0
fun PdmFormat.packed(): bool = (this>>>19) == 1
