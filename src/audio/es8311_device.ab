import "../esp32/sdk/raw_buffer.ab"

// Microphone register sequence derived from M5Unified (MIT, M5Stack).
// Selected I2C backend supplies the caller-owned device handle. No bus/pad
// switching, rail control, clock generation or implicit capture start.
type Es8311 = int
trusted fun es8311(bus: I2cBus, address: int = 24, frequency: int = 100000): Es8311 =
    Es8311(if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0)
fun Es8311.valid(): bool = this > 0 && this <= 4294967295
fun Es8311.device(): I2cDevice = I2cDevice(if (this.valid()) this | 0 else 0)
trusted fun Es8311.close(): bool = this.valid() && this.device().close()

val es8311BclkMicrophoneRegisters = nativeStaticU32s([
    0x8000, 0xba01, 0x1802, 0x010d, 0x020e, 0x1014, 0xff17, 0x6a1c
])
val es8311MicrophonePowerDownRegisters = nativeStaticU32s([0xfc0d, 0x6a0e, 0x0000])

// CoreP4X upstream initialization: 24kHz/16-bit slave, external256fs MCLK.
// Keep repeated0x44 writes/order; not interchangeable with BCLK-derived setup.
val es8311Mclk25624kRegisters=nativeStaticU32s([
    0xfa0d,0x0844,0x0844,0x3001,0x0002,0x1003,0x2416,0x1004,
    0x0005,0x000b,0x000c,0x1f10,0x7f11,0x8000,0x3f01,0x0306,
    0x1013,0x0a1b,0x6a1c,0x5844,0x0009,0xbf17,0x020e,0x0012,
    0x1a14,0x010d,0x4015,0x0837,0x0045,0x0007,0xff08,0xbf32
])
// Wholecodec owned, powered and supplied with matching MCLK/BCLK. Sets
// ADC/DAC registers as the upstream profile does; no simultaneous independent
// microphone configuration. 1ready,2invalid,3+first failed write index.
trusted fun Es8311.configureSpeakerMclk25624kOwned(exclusive: bool): int {
    if (!exclusive || !this.valid()) return 2
    var index=0
    while (index < 32) {
        val item=nativeAddressLoadU32(es8311Mclk25624kRegisters,index*4)
        if (!this.device().writeRegister8(item&255,(item>>>8)&255)) return 3+index
        index=index+1
    }
    return 1
}

val es8311BclkSpeakerRegisters = nativeStaticU32s([
    0x8000, 0xb501, 0x1802, 0x010d, 0x0012, 0x1013, 0xbf32, 0x0837
])
// Whole-codec BCLK-derived DAC profile from M5Unified. Caller owns stopped
// TX/RX and external amplifier/rail. This enables DAC, NOT board amplifier.
// dacVolume is raw register attenuation/gain, not linear software volume.
// 1 ready,2 invalid/unowned,3+zero-based failed write. Partial failure retains
// ownership. Board disable policies differ: no pretend codec shutdown here.
trusted fun Es8311.configureSpeakerBclkOwned(exclusive: bool,dacVolume: int = 191): int {
    if (!exclusive || !this.valid() || dacVolume < 0 || dacVolume > 255) return 2
    var index=0
    while (index < 8) {
        val item=nativeAddressLoadU32(es8311BclkSpeakerRegisters,index*4)
        val register=item&255
        val value=if (register == 0x32) dacVolume else (item>>>8)&255
        if (!this.device().writeRegister8(register,value)) return 3+index
        index=index+1
    }
    return 1
}

// Own the whole codec and stop I2S capture before changing its state. The
// BCLK-derived, differential microphone profile is shared by StickS3,
// StopWatch and Chain Captain. Their rail and I2C routing remain board policy.
// Result: 1 complete, 2 invalid/unowned, 3+zero-based failed write index.
// Failure leaves a partially configured codec: retain ownership for cleanup.
// Disable does not turn off shared board rails. close() only releases handle.
// adcVolume is the raw codec attenuation/gain register, not a linear gain.
// Cardputer ADV uses191 (0dB); the other supported boards use255.
trusted fun Es8311.microphoneBclkOwned(enabled: bool, exclusive: bool, adcVolume: int = 255): int {
    if (!exclusive || !this.valid() || adcVolume < 0 || adcVolume > 255) return 2
    val sequence = if (enabled) es8311BclkMicrophoneRegisters else es8311MicrophonePowerDownRegisters
    val count = if (enabled) 8 else 3
    var index = 0
    while (index < count) {
        val item = nativeAddressLoadU32(sequence, index * 4)
        val register=item&255
        val value=if (enabled && register == 0x17) adcVolume else (item>>>8)&255
        if (!this.device().writeRegister8(register,value)) return 3 + index
        index = index + 1
    }
    1
}
