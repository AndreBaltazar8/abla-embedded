import "./wav.ab"

trusted fun PcmWav.frames(): int {
    if (this <= 0 || this > 4294967276) return -1
    val channels=this.channels()
    val bits=this.bitsPerSample()
    if ((channels != 1 && channels != 2) || (bits != 8 && bits != 16) || this.sampleRate() == 0) return -1
    val source=this.samples()
    val bytesPerFrame=channels*(bits >>> 3)
    if (!source.hasAddressRange(0,source.capacity()) || (source.capacity() & (bytesPerFrame-1)) != 0) return -1
    source.capacity() >>> (if (bytesPerFrame == 4) 2 else if (bytesPerFrame == 2) 1 else 0)
}

// Convert a frame range at the original sample rate into stereo signed16 LE.
// Mono is duplicated;8-bit unsigned samples are centered and scaled by256.
// Caller owns immutable WAV/source metadata and disjoint writable output.
// No rate conversion, clipping, allocation, padding or hardware side effects.
// Returns output bytes, or-1 before mutation for invalid arguments/overlap.
trusted fun PcmWav.copyStereo16(firstFrame: int,frames: int,destination: NativeBuffer): int {
    if (this <= 0 || this > 4294967276 || firstFrame < 0 || frames < 0 || frames > 536870911) return -1
    val channels=this.channels()
    val bits=this.bitsPerSample()
    if ((channels != 1 && channels != 2) || (bits != 8 && bits != 16) || this.sampleRate() == 0) return -1
    val source=this.samples()
    val bytesPerFrame=channels*(bits >>> 3)
    if (!source.hasAddressRange(0,source.capacity()) ||
        (source.capacity() & (bytesPerFrame-1)) != 0) return -1
    val available=source.capacity() >>> (if (bytesPerFrame == 4) 2 else if (bytesPerFrame == 2) 1 else 0)
    if (firstFrame > available || frames > available-firstFrame) return -1
    val bytes=frames*4
    if (!destination.hasAddressRange(0,bytes)) return -1
    val out=destination.addressValue()
    if (bytes > 0 && ((out < source.addressValue()+source.capacity() && source.addressValue() < out+bytes) ||
        (out < this+20 && this < out+bytes))) return -1
    var input=u32(firstFrame*bytesPerFrame)
    var offset=u32(0)
    while (offset < u32(bytes)) {
        val leftByte=if (bits == 8) source.load(int(input)) else 0
        val left=if (bits == 8) (if (this.signed8()) (if (leftByte >= 128) leftByte-256 else leftByte)
            else leftByte-128)*256 else source.loadU16(int(input))
        val right=if (channels == 1) left else if (bits == 8)
            (if (this.signed8()) (if (source.load(int(input)+1) >= 128) source.load(int(input)+1)-256
                else source.load(int(input)+1)) else source.load(int(input)+1)-128)*256 else source.loadU16(int(input)+2)
        destination.storeU16(int(offset),left)
        destination.storeU16(int(offset)+2,right)
        input=input+u32(bytesPerFrame)
        offset=offset+u32(4)
    }
    bytes
}
