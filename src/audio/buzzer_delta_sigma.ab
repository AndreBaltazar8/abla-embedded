import "./pcm16.ab"
// M5Unified Speaker_Class buzzer output: 32 MSB-first one-bit delta-sigma
// decisions per mono sample. Feed words through stereo I2S without duplicating
// mono slots. This encodes data only: transport must establish wire ordering,
// clock rate and pin ownership. No GPIO/PWM timing or DMA implied here.
// Remainder0..65535; initial0 matches Speaker_Class. Preserve between chunks.
// Upstream resets remainder to32768 AFTER a no-data block; caller decides when
// a block is truly idle. Input here is already mixed/clipped signed16 PCM.
type BuzzerDeltaSigma=int
type BuzzerDeltaSigmaWord=int
fun BuzzerDeltaSigma.valid(): bool = this >= 0 && this <= 65535
fun BuzzerDeltaSigmaWord.valid(): bool = this >= 0 && this <= 0xffffffffffff
fun BuzzerDeltaSigmaWord.bits(): int = this&0xffffffff
fun BuzzerDeltaSigmaWord.next(): BuzzerDeltaSigma = if (this.valid()) BuzzerDeltaSigma(this>>>32) else BuzzerDeltaSigma(-1)
fun BuzzerDeltaSigma.sample(sample: int): BuzzerDeltaSigmaWord {
    if (!this.valid() || sample < -32768 || sample > 32767) return BuzzerDeltaSigmaWord(-1)
    var remainder=i32(this|0)
    val increment=i32(-32768-sample)
    var word=u32(0);var bit=u32(0x80000000)
    while (bit != u32(0)) {
        remainder=remainder+increment
        if (remainder < i32(0)) { remainder=remainder+i32(65536);word=word|bit }
        bit=bit>>u32(1)
    }
    return BuzzerDeltaSigmaWord(int(word)|(int(remainder)<<32))
}
// Nonoverlapping buffers: signed16 LE input ->32-bit LE words. Validate the
// entire request before writes. Returns replacement remainder, -1 on rejection.
// Caller owns both spans and must retain output while DMA consumes it.
trusted fun BuzzerDeltaSigma.encodePcm16(source: NativeBuffer,destination: NativeBuffer,samples: int): BuzzerDeltaSigma {
    if (!this.valid() || samples < 0 || samples > 536870911 ||
        !source.hasAddressRange(0,samples*2) || !destination.hasAddressRange(0,samples*4)) return BuzzerDeltaSigma(-1)
    if (samples > 0 && source.addressValue() < destination.addressValue()+samples*4 &&
        destination.addressValue() < source.addressValue()+samples*2) return BuzzerDeltaSigma(-1)
    var state=this;var index=0
    while (index < samples) {
        val raw=source.loadU16(index*2)
        val encoded=state.sample(if (raw >= 32768) raw-65536 else raw)
        destination.storeU32(index*4,encoded.bits())
        state=encoded.next();index=index+1
    }
    return state
}
