// Import alongside a selected I2cBus/I2cDevice implementation. A handle is one
// scalar; this driver does not own board enable pins, power rails or I2S DMA.
type Aw88298 = int
trusted fun aw88298(bus: I2cBus, address: int = 54, frequency: int = 400000): Aw88298 =
    Aw88298(if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0)
fun Aw88298.valid(): bool = this > 0 && this <= 4294967295
fun Aw88298.device(): I2cDevice = I2cDevice(if (this.valid()) this | 0 else 0)
trusted fun Aw88298.close(): bool = this.valid() && this.device().close()

// M5Unified's sample-rate bucket selection, bounded to the 8..96kHz range.
// This selects the amplifier register; it does not configure/generate clocks.
fun aw88298RateIndex(sampleRate: int): int {
    if (sampleRate < 8000 || sampleRate > 96000) return -1
    val rate = (sampleRate + 1102) / 2205
    if (rate <= 4) return 0
    if (rate <= 5) return 1
    if (rate <= 6) return 2
    if (rate <= 8) return 3
    if (rate <= 10) return 4
    if (rate <= 11) return 5
    if (rate <= 15) return 6
    if (rate <= 20) return 7
    if (rate <= 22) return 8
    9
}

// CoreS3's upstream 16-bit stereo-slot I2S sequence: boost disabled, I2S
// enabled, unmuted, rate selection, full-volume register. Fail fast and report
// every transport error. Caller must disable/clean up partial initialization.
trusted fun Aw88298.configureI2s16(sampleRate: int): bool {
    val rate = aw88298RateIndex(sampleRate)
    if (!this.valid() || rate < 0) return false
    val device = this.device()
    device.writeRegister16BigEndian(97, 1651) &&
        device.writeRegister16BigEndian(4, 16448) &&
        device.writeRegister16BigEndian(5, 8) &&
        device.writeRegister16BigEndian(6, 5312 | rate) &&
        device.writeRegister16BigEndian(12, 100)
}

// Stops I2S input; not a claim that the amplifier rail is powered down.
trusted fun Aw88298.disableI2s(): bool =
    this.valid() && this.device().writeRegister16BigEndian(4, 16384)
