import "./buzzer_delta_sigma.ab"
import "abla/runtime/scalar"
// Two 16-bit LE stereo slots, each serialized MSB-first, in memory order.
// Delta-sigma decisions are chronological from bit31 down to0: place the
// high16 in the FIRST memory slot and low16 in the SECOND. An unswapped LE
// 32-bit word would put the latter half of the decisions on the wire first.
// Matches the IDF C6 standard stereo/both-slots ordering; not mono duplication,
// big-endian DMA, LSB-first, 32-bit slots, padded slots or Philips shift.
// One signed16 mono input -> one stereo frame / 32 bit clocks / 4 DMA bytes.
// Configure frame rate equal to the source PCM sample rate (not twice/half).
fun BuzzerDeltaSigmaWord.stereo16Word(): int = if (!this.valid()) -1 else int((u32(this.bits())<<u32(16))|(u32(this.bits())>>u32(16)))
// Explicit alternate transport packing; existing raw32 encoder is unchanged.
// Caller owns nonoverlapping source/output and retains output through DMA.
trusted fun BuzzerDeltaSigma.encodePcm16Stereo16(source: NativeBuffer,destination: NativeBuffer,samples: int): BuzzerDeltaSigma {
    if (!this.valid() || samples < 0 || samples > 536870911 || !source.hasAddressRange(0,samples*2) || !destination.hasAddressRange(0,samples*4)) return BuzzerDeltaSigma(-1)
    if (samples > 0 && source.addressValue() < destination.addressValue()+samples*4 && destination.addressValue() < source.addressValue()+samples*2) return BuzzerDeltaSigma(-1)
    var state=this;var index=0
    while (index < samples) {
        val raw=source.loadU16(index*2)
        val encoded=state.sample(if (raw >= 32768) raw-65536 else raw)
        destination.storeU32(index*4,encoded.stereo16Word())
        state=encoded.next();index=index+1
    }
    return state
}
