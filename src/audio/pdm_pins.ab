// Board-neutral PDM clock plus four optional data lines, packed in40 bits.
// Pin numbers0..254; -1 means an unused data line. Chip-specific capability
// and active-line uniqueness checks belong to the hardware adapter.
type PdmPins=int
fun pdmPins(clock: int,data0: int,data1: int = -1,data2: int = -1,data3: int = -1): PdmPins {
    if (clock < 0 || clock > 254 || data0 < -1 || data0 > 254 || data1 < -1 || data1 > 254 ||
        data2 < -1 || data2 > 254 || data3 < -1 || data3 > 254) return PdmPins(0)
    return PdmPins((clock+1)|((data0+1)<<8)|((data1+1)<<16)|((data2+1)<<24)|((data3+1)<<32))
}
fun PdmPins.valid(): bool = (this&255) != 0 && (this>>>40) == 0
fun PdmPins.clockPin(): int = (this&255)-1
fun PdmPins.dataPin(line: int): int = if (line < 0 || line > 3) -1 else ((this>>>((line+1)*8))&255)-1
