import "./pcm_channel.ab"
import "./pcm_tone.ab"
// Bounded availability excludes silence padding. These helpers let a source
// scheduler switch kinds within one output block, without advancing either
// source twice or guessing duration from isPlaying. Invalid=-1.
trusted fun PcmChannel.availableFrames(limit: int): int {
    if (!this.valid() || limit < 0 || limit > 268435455) return -1
    val s=this.storage();var total=0;var slot=8
    while (slot <= 20 && total < limit) {
        val wav=PcmWav(s.loadU32(slot))
        if (wav != 0) {
            val repeats=s.loadU32(slot+4)
            if (repeats == 0) return limit
            val length=wav.resampledFrames(s.loadU32(0))
            // valid() bounds length<=INT32_MAX; repeats<=UINT32_MAX.
            // Their product fits signed64. Clamp BEFORE adding two slots.
            val remaining=length*repeats-(if (slot == 8) s.loadU32(16) else 0)
            if (remaining >= limit-total) return limit
            total=total+remaining
        }
        slot=slot+12
    }
    return total
}
trusted fun PcmTone.availableFrames(limit: int): int {
    if (!this.valid() || limit < 0 || limit > 268435455) return -1
    val s=this.storage()
    if ((s.loadU32(28)&1) != 0 || s.loadU32(24) != 0 || s.loadU32(20) >= limit) return limit
    return s.loadU32(20)
}
// Output capacity must cover the complete request even when source is short.
// Writes only returned frames, preserving tail for the next source.
trusted fun PcmChannel.renderAvailable(frames: int,output: NativeBuffer): int {
    val count=this.availableFrames(frames)
    if (count < 0 || !this.disjointFrom(output,frames*4)) return -1
    return if (this.render(count,nativeBufferAt(output.addressValue(),count*4))) count else -1
}
trusted fun PcmTone.renderAvailable(frames: int,output: NativeBuffer,stereo: bool=true): int {
    val count=this.availableFrames(frames);val stride=if (stereo) 4 else 2
    if (count < 0 || !this.disjointFrom(output,frames*stride)) return -1
    return if (this.render(count,nativeBufferAt(output.addressValue(),count*stride),stereo)) count else -1
}
