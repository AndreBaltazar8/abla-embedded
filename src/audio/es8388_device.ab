import "../esp32/sdk/raw_buffer.ab"
// M5Unified Tab5 ES8388 sequence (MIT, M5Stack). Select I2C and calibrated
// peripheralDelayMilliseconds providers alongside this device. No board rail,
// amplifier, bus routing or I2S lifecycle is implicitly owned by this handle.
type Es8388=int
trusted fun es8388(bus: I2cBus,address: int=16,frequency: int=100000): Es8388 =
    Es8388(if (bus.valid()) bus.device(address,frequency)&4294967295 else 0)
fun Es8388.valid(): bool = this > 0 && this <= 4294967295
fun Es8388.device(): I2cDevice = I2cDevice(if (this.valid()) this | 0 else 0)
trusted fun Es8388.close(): bool = this.valid() && this.device().close()
val es8388StereoDacRegisters=nativeStaticU32s([
    0x8000,0x0000,0x0000,0x0e00,0x0001,0x0a02,0xff03,0x3c04,
    0x0005,0x0006,0x7c07,0x0008,0x1817,0x0018,0x2019,0x001a,
    0x001b,0x081c,0x001d,0x0026,0xb827,0xb82a,0x082b,0x002d,
    0x212e,0x212f,0x2130,0x2131
])
// Slave16-bit I2S profile; all ADCs powered down, stereo DAC
// outputs enabled. Keep external amplifier disabled until success. Wholecodec
// ownership and live matching clocks required. No arbitrary clock-ratio API.
// 1configured,2invalid/unowned,3+zero-based first failed write.
// ES8388 User Guide sections5.1/5.2: slave mode auto-detects MCLK/LRCK
// and MCLK/SCLK. Register24's ratio is for master mode, NOT a requirement
// for128fs here. Supply valid slave clocks (Tab5 24kHz profile uses256fs).
// https://dl.radxa.com/rock2/docs/hw/ds/ES8388%20user%20Guide.pdf
trusted fun Es8388.configureStereoDacSlaveOwned(exclusive: bool): int {
    if (!exclusive || !this.valid()) return 2
    var index=0
    while (index < 28) {
        val item=nativeAddressLoadU32(es8388StereoDacRegisters,index*4)
        if (!this.device().writeRegister8(item&255,(item>>>8)&255)) return 3+index
        index=index+1
    }
    return 1
}
// Compatibility spelling; does NOT select or validate128fs clocks.
trusted fun Es8388.configureStereoDac128Owned(exclusive: bool): int = this.configureStereoDacSlaveOwned(exclusive)
// External amplifier MUST already be off. Keep MCLK/BCLK running throughout
// mute ->1ms soft-ramp ->DACpowerdown ->CHIPpowerdown, including retries.
// Cutting clocks first can leave stale codec state across the next reset.
// 1powered down,2invalid/unowned,3mute,4DACpower,5CHIPpower failure.
// Failed stage retains ownership; never claim shutdown or close/release it.
trusted fun Es8388.speakerPowerDownOwned(exclusive: bool): int {
    if (!exclusive || !this.valid()) return 2
    if (!this.device().writeRegister8(25,0x24)) return 3
    peripheralDelayMilliseconds(1)
    if (!this.device().writeRegister8(4,0xc0)) return 4
    if (!this.device().writeRegister8(2,0xff)) return 5
    return 1
}
