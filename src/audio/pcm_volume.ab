import "./pcm_channels.ab"
import "./pcm_tone.ab"
// M5Unified squares both master/channel volume. This is the normalized
// software curve, not board-specific analog amplification or codec gain.
//0mute255unity; rounded Q15 conversion, no float/sqrt/extra stored state.
type PcmVolume=int
fun PcmVolume.valid(): bool = this >= 0 && this <= 255
fun PcmVolume.gainQ15(): int =
    if (!this.valid()) -1 else int((u32(this|0)*u32(this|0)*u32(32768)+u32(32512))/u32(65025))
trusted fun PcmChannel.setVolume(volume: PcmVolume): bool =
    volume.valid() && this.setGain(volume.gainQ15())
trusted fun PcmTone.setVolume(volume: PcmVolume): bool =
    volume.valid() && this.setGain(volume.gainQ15())
trusted fun PcmChannels.setChannelVolume(index: int,volume: PcmVolume): bool =
    this.valid() && index >= 0 && index < this.count() && this.channel(index).setVolume(volume)
// Preflight whole bank: never partially update earlier channels if a later
// channel/queued source is malformed. Caller serializes against render/queue.
trusted fun PcmChannels.setAllChannelVolume(volume: PcmVolume): bool {
    if (!volume.valid() || !this.valid()) return false
    val gain=volume.gainQ15()
    var index=0
    while (index < this.count()) {
        this.channel(index).storage().storeU32(4,gain)
        index=index+1
    }
    return true
}
// Master gain stays a render argument: volume.gainQ15(). It is applied once
// after summing voices and before final clipping, never again on DMA retries.
