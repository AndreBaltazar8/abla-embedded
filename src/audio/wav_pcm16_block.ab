import "./wav_pcm16.ab"

// Fill exactly240 stereo frames, padding only the final/tail block with
// silence. Caller owns source/metadata and disjoint960-byte output storage.
trusted fun PcmWav.copyStereo16Block(block: int,destination: NativeBuffer): bool {
    val frames=this.frames()
    if (frames < 0 || block < 0 || block > 4095 || !destination.hasAddressRange(0,960)) return false
    val source=this.samples()
    val a=destination.addressValue()
    if ((a < this+20 && this < a+960) ||
        (a < source.addressValue()+source.capacity() && source.addressValue() < a+960)) return false
    val first=block*240
    val count=if (first >= frames) 0 else if (frames-first > 240) 240 else frames-first
    if (count > 0 && this.copyStereo16(first,count,destination) != count*4) return false
    var offset=u32(count*4)
    while (offset < u32(960)) {
        destination.storeU32(int(offset),0)
        offset=offset+u32(4)
    }
    true
}
