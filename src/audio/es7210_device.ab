import "../esp32/sdk/raw_buffer.ab"

// Selected I2C backend supplies I2cBus/I2cDevice. No allocation beyond its
// caller-owned device handle, no I2S clock generation and no board rail writes.
type Es7210 = int
trusted fun es7210(bus: I2cBus, address: int = 64, frequency: int = 400000): Es7210 =
    Es7210(if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0)
fun Es7210.valid(): bool = this > 0 && this <= 4294967295
fun Es7210.device(): I2cDevice = I2cDevice(if (this.valid()) this | 0 else 0)
trusted fun Es7210.close(): bool = this.valid() && this.device().close()

// Explicit whole-codec reset. M5Unified uses this on CoreS3 disable as well;
// it does not prove the board's microphone power rail has been turned off.
trusted fun Es7210.reset(): bool =
    this.valid() && this.device().writeRegister8(0, 255)

// CoreS3's MIC1/2 stereo profile: packed register/value words, in exact write
// order. MIC3/4 are powered down. Requires the matching external MCLK/I2S
// configuration; this is not an arbitrary sample-rate/clock-divider API.
val es7210StereoMic12Registers = nativeStaticU32s([
    0x4100, 0x1f01, 0x0006, 0x2007, 0x1008, 0x3009, 0x300a,
    0x0a20, 0x2a21, 0x0a22, 0x2a23, 0xc102, 0x0104, 0x0005,
    0x6011, 0x4240, 0x7041, 0x7042, 0x1b43, 0x1b44, 0x0045,
    0x0046, 0x0047, 0x0048, 0x0049, 0x004a, 0x004b, 0xff4c, 0x1401
])

// PaperColor uses the same clock/power sequence, with MIC2 gain zero.
// Keep both profiles in one implementation; do not duplicate the register table.
trusted fun Es7210.configureMic12Profile(secondMicGain: bool,allInputs: bool=false): bool {
    if (!this.reset()) return false
    val device = this.device()
    var index = 0
    while (index < 29) {
        val item = nativeAddressLoadU32(es7210StereoMic12Registers, index * 4)
        val register = item & 255
        val value = if (register == 0x44 && !secondMicGain) 0 else
            if (allInputs && (register == 0x45 || register == 0x46)) 27 else
            if (allInputs && register == 0x4c) 0 else (item >>> 8) & 255
        if (!device.writeRegister8(register, value)) return false
        index = index + 1
    }
    true
}
trusted fun Es7210.configureStereoMic12(): bool = this.configureMic12Profile(true)
// PaperColor's MIC1 profile still uses the codec's stereo I2S framing; the
// board capture selects the left slot. Requires board power and matching MCLK.
trusted fun Es7210.configureMic1(): bool = this.configureMic12Profile(false)
// CoreP4X powers MIC3(AEC input)/MIC4 too. External capture frame/slot setup
// is separate: this does not implement echo cancellation or select TDM slots.
trusted fun Es7210.configureMic1234(): bool = this.configureMic12Profile(true,true)
