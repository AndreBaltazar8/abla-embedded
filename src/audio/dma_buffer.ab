// Upper bound for one complete DMA ring, rounded up to whole milliseconds.
// This is a software drain budget, not proof of analog/DAC completion; callers
// must add the peripheral's FIFO/clock margin and keep the channel running.
fun audioDmaRingMilliseconds(sampleRate: int, frames: int, descriptors: int): int {
    if (sampleRate < 1 || sampleRate > 16777215 || frames < 1 ||
        frames > 4096 || descriptors < 2 || descriptors > 64) return -1
    (frames * descriptors * 1000 + sampleRate - 1) / sampleRate
}
