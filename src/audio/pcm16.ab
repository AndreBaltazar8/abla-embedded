import "../esp32/sdk/raw_buffer.ab"

// Signed16 PCM attenuation, Q15 gain:0 mute,32768 unchanged. Rounds nearest,
// ties away from zero; symmetric about zero and never amplifies/clips.
// Internal sample primitive requires signed16 sample and gain0..32768.
fun pcm16AttenuatedSample(sample: int, gain: int): int {
    val magnitude = if (sample < 0) -sample else sample
    val scaled = (magnitude * gain + 16384) >>> 15
    if (sample < 0) -scaled else scaled
}

// Checked in-place little-endian PCM; mono/stereo share this representation.
// Odd lengths/invalid ranges or gains are rejected before any mutation.
// The caller owns writable memory. No allocation or hardware state changes.
trusted fun attenuatePcm16(buffer: NativeBuffer, bytes: int, gainQ15: int): bool {
    if (gainQ15 < 0 || gainQ15 > 32768 || (bytes & 1) != 0 ||
        !buffer.hasAddressRange(0, bytes)) return false
    if (gainQ15 == 32768) return true
    var offset = 0
    while (offset < bytes) {
        val raw = buffer.loadU16(offset)
        val signed = if (raw >= 32768) raw - 65536 else raw
        buffer.storeU16(offset, pcm16AttenuatedSample(signed, gainQ15))
        offset = offset + 2
    }
    true
}
