import "./pcm_channels.ab"
import "./pcm_tone.ab"
// Mix one independently retained tone with the bank's1..8 PCM channels. All
// sources share output rate; gain is applied before the final16-bit clipping.
// Caller serializes all state and retains rendered staging for DMA retries.
trusted fun PcmChannels.renderWithTone(tone: PcmTone,frames: int,accumulator: NativeBuffer,
    scratch: NativeBuffer,output: NativeBuffer,stereo: bool=true,masterGainQ15: int=32768): bool {
    val outputBytes=frames*(if (stereo) 4 else 2)
    if (!this.valid() || !tone.valid() || frames < 0 || frames > 268435455 ||
        this.channel(0).storage().loadU32(0) != tone.storage().loadU32(4) ||
        masterGainQ15 < 0 || masterGainQ15 > 32768 ||
        !accumulator.hasAddressRange(0,frames*8) || !scratch.hasAddressRange(0,frames*4) ||
        !output.hasAddressRange(0,outputBytes) ||
        pcmMixSpansOverlap(accumulator,frames*8,scratch,frames*4) ||
        pcmMixSpansOverlap(accumulator,frames*8,output,outputBytes) ||
        pcmMixSpansOverlap(scratch,frames*4,output,outputBytes) ||
        pcmMixSpansOverlap(tone.storage(),tone.stateBytes(),accumulator,frames*8) ||
        pcmMixSpansOverlap(tone.storage(),tone.stateBytes(),scratch,frames*4) ||
        pcmMixSpansOverlap(tone.storage(),tone.stateBytes(),output,outputBytes)) return false
    val wave=tone.waveform()
    if (pcmMixSpansOverlap(wave,wave.capacity(),accumulator,frames*8) ||
        pcmMixSpansOverlap(wave,wave.capacity(),scratch,frames*4) ||
        pcmMixSpansOverlap(wave,wave.capacity(),output,outputBytes) ||
        pcmMixSpansOverlap(wave,wave.capacity(),this.storage(),this.storage().capacity()) ||
        pcmMixSpansOverlap(wave,wave.capacity(),tone.storage(),tone.stateBytes())) return false
    var index=0
    while (index < this.count()) {
        val channel=this.channel(index)
        if (!channel.disjointFrom(tone.storage(),tone.stateBytes()) ||
            !channel.disjointFrom(accumulator,frames*8) || !channel.disjointFrom(scratch,frames*4) ||
            !channel.disjointFrom(output,outputBytes)) return false
        index=index+1
    }
    // Admission is complete, including queued clips and tone state. Nothing
    // below can fail a span/state check under exclusive caller ownership.
    if (!clearPcm16Mix(accumulator,frames*2)) return false
    index=0
    while (index < this.count()) {
        if (!this.channel(index).render(frames,scratch) || !addPcm16ToMix(accumulator,scratch,frames*2)) return false
        index=index+1
    }
    if (!tone.render(frames,scratch,true) || !addPcm16ToMix(accumulator,scratch,frames*2)) return false
    return if (stereo) finishPcm16Mix(accumulator,output,frames*2,masterGainQ15)
        else finishPcm16MixMono(accumulator,output,frames,masterGainQ15)
}
