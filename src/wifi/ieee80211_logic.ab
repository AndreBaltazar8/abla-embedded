// IEEE 802.11 MAC header scalar fields. These remain u16 values through the
// native backend and are shared by every Wi-Fi-capable board implementation.
type WifiFrameControl = u16
type WifiSequenceControl = u16

val wifiFrameTypeManagement = u8(0)
val wifiFrameTypeControl = u8(1)
val wifiFrameTypeData = u8(2)

@inline
fun wifiFrameControl(
    frameType: u8,
    subtype: u8,
    toDistributionSystem: bool,
    fromDistributionSystem: bool,
    moreFragments: bool,
    retry: bool,
    powerManagement: bool,
    moreData: bool,
    protectedFrame: bool,
    ordered: bool
): WifiFrameControl = WifiFrameControl(
    (u16(frameType) & u16(3)) << u16(2) |
    (u16(subtype) & u16(15)) << u16(4) |
    (if (toDistributionSystem) u16(256) else u16(0)) |
    (if (fromDistributionSystem) u16(512) else u16(0)) |
    (if (moreFragments) u16(1024) else u16(0)) |
    (if (retry) u16(2048) else u16(0)) |
    (if (powerManagement) u16(4096) else u16(0)) |
    (if (moreData) u16(8192) else u16(0)) |
    (if (protectedFrame) u16(16384) else u16(0)) |
    (if (ordered) u16(32768) else u16(0))
)

@inline
fun WifiFrameControl.rawValue(): u16 = this

@inline
fun WifiFrameControl.protocolVersion(): u8 =
    u8(this & u16(3))

@inline
fun WifiFrameControl.frameType(): u8 =
    u8((this >> u16(2)) & u16(3))

@inline
fun WifiFrameControl.subtype(): u8 =
    u8((this >> u16(4)) & u16(15))

@inline
fun WifiFrameControl.toDistributionSystem(): bool =
    (this & u16(256)) != u16(0)

@inline
fun WifiFrameControl.fromDistributionSystem(): bool =
    (this & u16(512)) != u16(0)

@inline
fun WifiFrameControl.moreFragments(): bool =
    (this & u16(1024)) != u16(0)

@inline
fun WifiFrameControl.retry(): bool =
    (this & u16(2048)) != u16(0)

@inline
fun WifiFrameControl.powerManagement(): bool =
    (this & u16(4096)) != u16(0)

@inline
fun WifiFrameControl.moreData(): bool =
    (this & u16(8192)) != u16(0)

@inline
fun WifiFrameControl.protectedFrame(): bool =
    (this & u16(16384)) != u16(0)

@inline
fun WifiFrameControl.ordered(): bool =
    (this & u16(32768)) != u16(0)

@inline
fun wifiSequenceControl(
    sequenceNumber: u16,
    fragmentNumber: u8
): WifiSequenceControl = WifiSequenceControl(
    ((sequenceNumber & u16(4095)) << u16(4)) |
        (u16(fragmentNumber) & u16(15))
)

@inline
fun WifiSequenceControl.rawValue(): u16 = this

@inline
fun WifiSequenceControl.sequenceNumber(): u16 = this >> u16(4)

@inline
fun WifiSequenceControl.fragmentNumber(): u8 = u8(this & u16(15))
