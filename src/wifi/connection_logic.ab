import "./ieee80211_management_logic.ab"

// Shared allocation-free STA and SoftAP connection state. Protocol engines
// keep peer tables, keys, timers, and packet storage; transitions only encode
// the next state and required action in one scalar.
type WifiConnectionState = int
type WifiConnectionAction = int
type WifiConnectionTransition = int

val wifiConnectionStopped = WifiConnectionState(0)
val wifiConnectionScanning = WifiConnectionState(1)
val wifiConnectionAuthenticating = WifiConnectionState(2)
val wifiConnectionAssociating = WifiConnectionState(3)
val wifiConnectionSecuring = WifiConnectionState(4)
val wifiConnectionConnected = WifiConnectionState(5)
val wifiConnectionRoaming = WifiConnectionState(6)

val wifiConnectionNoAction = WifiConnectionAction(0)
val wifiConnectionRestartScan = WifiConnectionAction(1)
val wifiConnectionSendAuthentication = WifiConnectionAction(2)
val wifiConnectionSendSharedKeyResponse = WifiConnectionAction(3)
val wifiConnectionSendSaeConfirm = WifiConnectionAction(4)
val wifiConnectionSendAssociation = WifiConnectionAction(5)
val wifiConnectionStartKeyExchange = WifiConnectionAction(6)
val wifiConnectionReportConnected = WifiConnectionAction(7)
val wifiConnectionReportDisconnected = WifiConnectionAction(8)
val wifiConnectionDelegateAuthentication = WifiConnectionAction(9)

val wifiAccessPointAbsent = WifiConnectionState(16)
val wifiAccessPointAuthenticating = WifiConnectionState(17)
val wifiAccessPointAuthenticated = WifiConnectionState(18)
val wifiAccessPointAssociated = WifiConnectionState(19)
val wifiAccessPointSecuring = WifiConnectionState(20)
val wifiAccessPointAuthorized = WifiConnectionState(21)

val wifiAccessPointSendAuthenticationResponse = WifiConnectionAction(16)
val wifiAccessPointSendSharedKeyChallenge = WifiConnectionAction(17)
val wifiAccessPointSendSaeCommit = WifiConnectionAction(18)
val wifiAccessPointSendSaeConfirm = WifiConnectionAction(19)
val wifiAccessPointSendAssociationResponse = WifiConnectionAction(20)
val wifiAccessPointSendAssociationFailure = WifiConnectionAction(21)
val wifiAccessPointBeginKeyExchange = WifiConnectionAction(22)
val wifiAccessPointAuthorizePeer = WifiConnectionAction(23)

@inline
fun wifiConnectionTransition(
    state: WifiConnectionState,
    action: WifiConnectionAction,
    status: int = 0
): WifiConnectionTransition = WifiConnectionTransition(
    (state & 255) | ((action & 255) << 8) | ((status & 65535) << 16)
)

@inline
fun WifiConnectionTransition.state(): WifiConnectionState =
    WifiConnectionState(this & 255)

@inline
fun WifiConnectionTransition.action(): WifiConnectionAction =
    WifiConnectionAction((this >>> 8) & 255)

@inline
fun WifiConnectionTransition.status(): int = (this >>> 16) & 65535

@inline
fun wifiStationStartTransition(): WifiConnectionTransition =
    wifiConnectionTransition(wifiConnectionScanning, wifiConnectionRestartScan)

fun wifiStationCandidateTransition(
    state: WifiConnectionState,
    ssidMatches: bool,
    securityCompatible: bool,
    blacklisted: bool
): WifiConnectionTransition {
    if (state != wifiConnectionScanning || !ssidMatches ||
        !securityCompatible || blacklisted) {
        return wifiConnectionTransition(state, wifiConnectionNoAction)
    }
    wifiConnectionTransition(
        wifiConnectionAuthenticating, wifiConnectionSendAuthentication
    )
}

fun wifiStationAuthenticationTransition(
    state: WifiConnectionState,
    algorithm: int,
    transaction: int,
    status: int
): WifiConnectionTransition {
    if (state != wifiConnectionAuthenticating) {
        return wifiConnectionTransition(state, wifiConnectionNoAction)
    }
    if (status != wifiStatusSuccess) {
        return wifiConnectionTransition(
            wifiConnectionScanning, wifiConnectionRestartScan, status
        )
    }
    if (transaction == 2) {
        if (algorithm == wifiAuthenticationOpenSystem ||
            algorithm == wifiAuthenticationFastBssTransition ||
            algorithm == wifiAuthenticationFilsSharedKey ||
            algorithm == wifiAuthenticationFilsPublicKey) {
            return wifiConnectionTransition(
                wifiConnectionAssociating, wifiConnectionSendAssociation
            )
        }
        if (algorithm == wifiAuthenticationSharedKey) {
            return wifiConnectionTransition(
            wifiConnectionAuthenticating, wifiConnectionSendSharedKeyResponse
            )
        }
        if (algorithm == wifiAuthenticationSaeAlgorithm) {
            return wifiConnectionTransition(
            wifiConnectionAuthenticating, wifiConnectionSendSaeConfirm
            )
        }
    } else if (transaction == 4 &&
        (algorithm == wifiAuthenticationSharedKey ||
            algorithm == wifiAuthenticationSaeAlgorithm)) {
        return wifiConnectionTransition(
            wifiConnectionAssociating, wifiConnectionSendAssociation
        )
    }
    wifiConnectionTransition(
        state, wifiConnectionDelegateAuthentication, status
    )
}

// Native-width hot path for interrupt/task consumers on 32-bit targets.
@inline
fun wifiStationAuthenticationTransition32(
    state: u32,
    algorithm: u32,
    transaction: u32,
    status: u32
): u32 {
    if (state != u32(2)) return state & u32(255)
    if (status != u32(0)) return u32(257) | ((status & u32(65535)) << u32(16))
    if (transaction == u32(2)) {
        if (algorithm == u32(0) || algorithm == u32(2) ||
            algorithm == u32(4) || algorithm == u32(5)) return u32(1283)
        if (algorithm == u32(1)) return u32(770)
        if (algorithm == u32(3)) return u32(1026)
    } else if (transaction == u32(4) &&
        (algorithm == u32(1) || algorithm == u32(3))) return u32(1283)
    u32(2306)
}

fun wifiStationAssociationTransition(
    state: WifiConnectionState,
    status: int,
    associationId: int,
    needsKeyExchange: bool
): WifiConnectionTransition {
    if (state != wifiConnectionAssociating) {
        return wifiConnectionTransition(state, wifiConnectionNoAction)
    }
    if (status != wifiStatusSuccess || associationId < 1 ||
        associationId > 2007) {
        return wifiConnectionTransition(
            wifiConnectionScanning, wifiConnectionRestartScan, status
        )
    }
    if (needsKeyExchange) wifiConnectionTransition(
        wifiConnectionSecuring, wifiConnectionStartKeyExchange
    ) else wifiConnectionTransition(
        wifiConnectionConnected, wifiConnectionReportConnected
    )
}

fun wifiStationKeysInstalledTransition(
    state: WifiConnectionState,
    valid: bool
): WifiConnectionTransition {
    if (state != wifiConnectionSecuring) {
        return wifiConnectionTransition(state, wifiConnectionNoAction)
    }
    if (valid) wifiConnectionTransition(
        wifiConnectionConnected, wifiConnectionReportConnected
    ) else wifiConnectionTransition(
        wifiConnectionScanning, wifiConnectionRestartScan
    )
}

fun wifiStationDisassociationTransition(
    state: WifiConnectionState,
    reason: int
): WifiConnectionTransition {
    if (state == wifiConnectionConnected || state == wifiConnectionSecuring) {
        return wifiConnectionTransition(
            wifiConnectionAssociating, wifiConnectionSendAssociation, reason
        )
    }
    wifiConnectionTransition(state, wifiConnectionNoAction, reason)
}

fun wifiStationDeauthenticationTransition(
    state: WifiConnectionState,
    reason: int
): WifiConnectionTransition {
    if (state == wifiConnectionStopped || state == wifiConnectionScanning) {
        return wifiConnectionTransition(state, wifiConnectionNoAction, reason)
    }
    wifiConnectionTransition(
        wifiConnectionScanning, wifiConnectionReportDisconnected, reason
    )
}

fun wifiConnectionTimeoutTransition(
    state: WifiConnectionState,
    attempts: int,
    maximumAttempts: int
): WifiConnectionTransition {
    if (attempts >= maximumAttempts || maximumAttempts <= 0) {
        return wifiConnectionTransition(
            wifiConnectionScanning, wifiConnectionRestartScan
        )
    }
    if (state == wifiConnectionAuthenticating) return wifiConnectionTransition(
        state, wifiConnectionSendAuthentication
    )
    if (state == wifiConnectionAssociating) return wifiConnectionTransition(
        state, wifiConnectionSendAssociation
    )
    if (state == wifiConnectionSecuring) return wifiConnectionTransition(
        state, wifiConnectionStartKeyExchange
    )
    wifiConnectionTransition(state, wifiConnectionNoAction)
}

fun wifiNextScanChannel(current: int, first: int, last: int): int =
    if (first < 1 || last < first || last > 196) 0
    else if (current < first || current >= last) first else current + 1

fun wifiDeadlineRemainingMilliseconds(
    nowMilliseconds: u32,
    deadlineMilliseconds: u32
): u32 {
    val difference = deadlineMilliseconds - nowMilliseconds
    if ((difference & u32(2147483648)) != u32(0)) u32(0) else difference
}

fun wifiAccessPointAuthenticationTransition(
    state: WifiConnectionState,
    algorithm: int,
    transaction: int,
    status: int
): WifiConnectionTransition {
    if (status != wifiStatusSuccess) return wifiConnectionTransition(
        wifiAccessPointAbsent, wifiAccessPointSendAuthenticationResponse, status
    )
    if (algorithm == wifiAuthenticationOpenSystem && transaction == 1) {
        return wifiConnectionTransition(
            wifiAccessPointAuthenticated,
            wifiAccessPointSendAuthenticationResponse
        )
    }
    if (algorithm == wifiAuthenticationSharedKey) {
        if (transaction == 1) return wifiConnectionTransition(
            wifiAccessPointAuthenticating,
            wifiAccessPointSendSharedKeyChallenge
        )
        if (state == wifiAccessPointAuthenticating && transaction == 3) {
            return wifiConnectionTransition(
                wifiAccessPointAuthenticated,
                wifiAccessPointSendAuthenticationResponse
            )
        }
    }
    if (algorithm == wifiAuthenticationSaeAlgorithm) {
        if (transaction == 1) return wifiConnectionTransition(
            wifiAccessPointAuthenticating, wifiAccessPointSendSaeCommit
        )
        if (state == wifiAccessPointAuthenticating && transaction == 3) {
            return wifiConnectionTransition(
                wifiAccessPointAuthenticated, wifiAccessPointSendSaeConfirm
            )
        }
    }
    wifiConnectionTransition(state, wifiConnectionDelegateAuthentication)
}

fun wifiAccessPointAssociationTransition(
    state: WifiConnectionState,
    accepted: bool,
    associationId: int,
    needsKeyExchange: bool,
    failureStatus: int
): WifiConnectionTransition {
    if (state != wifiAccessPointAuthenticated || !accepted ||
        associationId < 1 || associationId > 2007) {
        return wifiConnectionTransition(
            state, wifiAccessPointSendAssociationFailure, failureStatus
        )
    }
    if (needsKeyExchange) wifiConnectionTransition(
        wifiAccessPointSecuring, wifiAccessPointBeginKeyExchange
    ) else wifiConnectionTransition(
        wifiAccessPointAuthorized, wifiAccessPointSendAssociationResponse
    )
}

fun wifiAccessPointKeysInstalledTransition(
    state: WifiConnectionState,
    valid: bool
): WifiConnectionTransition {
    if (state != wifiAccessPointSecuring) {
        return wifiConnectionTransition(state, wifiConnectionNoAction)
    }
    if (valid) wifiConnectionTransition(
        wifiAccessPointAuthorized, wifiAccessPointAuthorizePeer
    ) else wifiConnectionTransition(
        wifiAccessPointAuthenticated, wifiAccessPointSendAssociationFailure
    )
}

fun wifiAccessPointDisassociationTransition(
    state: WifiConnectionState,
    reason: int
): WifiConnectionTransition =
    if (state == wifiAccessPointAssociated ||
        state == wifiAccessPointSecuring || state == wifiAccessPointAuthorized) {
        wifiConnectionTransition(
            wifiAccessPointAuthenticated, wifiConnectionNoAction, reason
        )
    } else wifiConnectionTransition(state, wifiConnectionNoAction, reason)

fun wifiAccessPointDeauthenticationTransition(
    reason: int
): WifiConnectionTransition = wifiConnectionTransition(
    wifiAccessPointAbsent, wifiConnectionNoAction, reason
)
