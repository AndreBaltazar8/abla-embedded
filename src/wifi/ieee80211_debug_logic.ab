// Allocation-free decisions shared by target-specific 802.11 diagnostic
// adapters. ESP Wi-Fi uses the conventional numeric log levels 0..5.

@inline
fun ieee80211DebugLevelLetter(level: int): int {
    if (level == 0) return 78
    if (level == 1) return 69
    if (level == 2) return 87
    if (level == 3) return 73
    if (level == 4) return 68
    if (level == 5) return 86
    0
}

@inline
fun ieee80211DebugLogEnabled(
    configuredLevel: int,
    requestedLevel: int,
    adapterPresent: bool,
    writerPresent: bool
): bool = adapterPresent && writerPresent &&
    configuredLevel >= requestedLevel

@inline
fun ieee80211DebugDumpReceiveTransmit(mask: int): bool = (mask & 2) != 0
