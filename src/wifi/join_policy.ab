// When a station with no link asks to join again. ESP-IDF tries once per esp_wifi_connect:
// an AP's rejection, common just after a boot, ends that try with no retry of its own. A
// request made while a try is under way is refused and leaves it alone, so asking often is safe.
val wifiJoinTryOften = 3000
val wifiJoinTrySeldom = 10000
val wifiJoinOftenTries = 10

fun wifiJoinTryInterval(tries: int): int = if (tries < wifiJoinOftenTries) wifiJoinTryOften else wifiJoinTrySeldom

fun wifiJoinTryDue(now: int, lastTry: int, tries: int): bool = now - lastTry >= wifiJoinTryInterval(tries)
