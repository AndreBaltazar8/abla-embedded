// Allocation-free 802.11 protocol decisions shared by vendor-compatible
// transports. Frame and parameter memory stays in the target-specific layer.

val ieee80211ErpRateCount = 7

@inline
fun ieee80211ErpRate(index: int): int {
    if (index == 0) return 2
    if (index == 1) return 4
    if (index == 2) return 11
    if (index == 3) return 22
    if (index == 4) return 12
    if (index == 5) return 24
    48
}

fun ieee80211ErpRateSetValid(rates: array<int>): bool {
    if (rates.size < ieee80211ErpRateCount) return false
    var requiredIndex = 0
    while (requiredIndex < ieee80211ErpRateCount) {
        val required = ieee80211ErpRate(requiredIndex)
        var rateIndex = 0
        var found = false
        while (!found && rateIndex < rates.size) {
            val rate = rates[rateIndex] & 127
            if (rate == required) found = true
            else if (required < rate) return false
            rateIndex = rateIndex + 1
        }
        if (!found) return false
        requiredIndex = requiredIndex + 1
    }
    true
}

@inline
fun ieee80211TrafficIdentifierKind(frameControlLow: int): int {
    if ((frameControlLow & 12) == 0) return 17
    if ((frameControlLow & 140) != 136) return 16
    -1
}

@inline
fun ieee80211QosOffset(frameControlHigh: int): int =
    if ((frameControlHigh & 3) == 3) 30 else 24

@inline
fun ieee80211TrafficIdentifier(
    frameControlLow: int,
    frameControlHigh: int,
    qosAt24: int,
    qosAt30: int
): int {
    val kind = ieee80211TrafficIdentifierKind(frameControlLow)
    if (kind >= 0) return kind
    val qos = if ((frameControlHigh & 3) == 3) qosAt30 else qosAt24
    qos & 15
}

@inline
fun ieee80211ShortSlotCapabilities(capabilities: int, enabled: bool): int =
    if (enabled) capabilities | 1024 else capabilities & ~1024

@inline
fun ieee80211ContentionParameterValid(
    arbitrationSpacing: int,
    minimumWindow: int,
    maximumWindow: int
): bool = arbitrationSpacing != 0 && maximumWindow >= minimumWindow

@inline
fun ieee80211ConnectState(reconnect: int): int =
    if ((reconnect & 255) != 0) 2 else 3

@inline
fun ieee80211ConnectArgument(authentication: int, reconnect: int): int =
    if ((reconnect & 255) != 0) 176 else (authentication & 255) << 5
