import "./powerhub_types.ab"
import "../esp32/sdk/raw_buffer.ab"
import "abla/unsafe/memory/raw"
// Status1 both requests acknowledged,2 invalid input,3 control-clear failure,
// 4 shutdown-command failure. Bit8 means the six-byte clear was acknowledged.
// A failed transaction can still have reached hardware; no rollback implied.
type PowerHubShutdownResult = int
fun PowerHubShutdownResult.status(): int = this & 255
fun PowerHubShutdownResult.controlsCleared(): bool = (this & 256) != 0
fun PowerHubShutdownResult.requestAcknowledged(): bool = this == 257
// Caller has quiesced every supply consumer and exclusively owns shutdown.
// This disables registers0..5 then requests controller shutdown at0xe0.
// It does not clear charging register6 or modify RTC settings. It does not
// enter CPU sleep: PowerHub requires light-sleep fallback, not deep-sleep.
// Acknowledged is NOT proof that power has disappeared.
trusted fun PowerHubPower.requestPowerOffWithBuffer(bytes: NativeBuffer): PowerHubShutdownResult {
    if (!this.valid() || !bytes.hasAddressRange(0,6)) return PowerHubShutdownResult(2)
    bytes.storeU32(0,0); bytes.storeU16(4,0)
    if (!this.device().writeRegister(0,bytes,6)) return PowerHubShutdownResult(3)
    if (!this.device().writeRegister8(224,1)) return PowerHubShutdownResult(260)
    PowerHubShutdownResult(257)
}
trusted fun PowerHubPower.requestPowerOff(): PowerHubShutdownResult {
    if (!this.valid()) return PowerHubShutdownResult(2)
    this.requestPowerOffWithBuffer(nativeBufferAt(nativeStackAllocate(6),6))
}
