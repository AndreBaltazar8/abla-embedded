import "./powerhub_types.ab"
import "../esp32/sdk/raw_buffer.ab"
import "abla/unsafe/memory/raw"
// M5Unified ext_port_bus_t:3000..20000mV in20mV steps, limit0..232,
// enable and direction (true output,false input). Limit follows the upstream
// register units; this API does not infer the attached load's safe settings.
// Low16 voltage,next8 limit,bit24 enable,bit25 output,bit26 valid.
type PowerHubBusConfig = int
fun powerHubBusConfig(millivolts: int,currentLimit: int,enabled: bool,output: bool): PowerHubBusConfig {
    if (millivolts < 3000 || millivolts > 20000 || millivolts%20 != 0 || currentLimit < 0 || currentLimit > 232) return PowerHubBusConfig(0)
    PowerHubBusConfig(millivolts | (currentLimit<<16) | (if (enabled) 1<<24 else 0) | (if (output) 1<<25 else 0) | (1<<26))
}
fun PowerHubBusConfig.millivolts(): int = this & 65535
fun PowerHubBusConfig.currentLimit(): int = (this>>>16)&255
fun PowerHubBusConfig.enabled(): bool = (this & (1<<24)) != 0
fun PowerHubBusConfig.output(): bool = (this & (1<<25)) != 0
fun PowerHubBusConfig.valid(): bool = (this>>>26) == 1 && this.millivolts() >= 3000 && this.millivolts() <= 20000 && this.millivolts()%20 == 0 && this.currentLimit() <= 232
// Borrowed live0x50 device and exclusive5-byte scratch. One contiguous write
// to0x20..0x24; no separate enable write, rounding, retry or automatic readback.
// Failure may still have reached hardware; never implies supply is disabled.
trusted fun PowerHubPower.setExternalBusConfigWithBuffer(config: PowerHubBusConfig,bytes: NativeBuffer): bool {
    if (!this.valid() || !config.valid() || !bytes.hasAddressRange(0,5)) return false
    bytes.storeU16(0,config.millivolts())
    bytes.store(2,config.currentLimit())
    bytes.store(3,if (config.enabled()) 1 else 0)
    bytes.store(4,if (config.output()) 1 else 0)
    this.device().writeRegister(32,bytes,5)
}
trusted fun PowerHubPower.setExternalBusConfig(config: PowerHubBusConfig): bool {
    if (!this.valid() || !config.valid()) return false
    this.setExternalBusConfigWithBuffer(config,nativeBufferAt(nativeStackAllocate(5),5))
}
