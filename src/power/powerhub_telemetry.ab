import "./measurement.ab"
import "./powerhub_types.ab"
// M5Unified external-port mask and first-match priority, including mixedmasks.
fun powerHubTelemetryRegister(portMask: int,voltage: bool): int {
    val base=if ((portMask & 1) != 0) 64 else if ((portMask & 8) != 0) 68 else
        if ((portMask & 32) != 0) 60 else if ((portMask & 64) != 0) 56 else if ((portMask & 128) != 0) 52 else -1
    if (base < 0) -1 else base+(if (voltage) 0 else 2)
}
trusted fun PowerHubPower.batteryMillivoltsChecked(): PowerMeasurement {
    if (!this.valid()) return PowerMeasurement(0)
    val raw=this.device().readRegister16LittleEndianChecked(48)
    if (raw.valid()) powerMeasurement(raw.value()) else PowerMeasurement(0)
}
trusted fun PowerHubPower.batteryMilliampsChecked(): PowerMeasurement {
    if (!this.valid()) return PowerMeasurement(0)
    val raw=this.device().readRegister16LittleEndianChecked(50)
    // PowerHub register sign is opposite the public +charge/-discharge API.
    if (raw.valid()) powerMeasurement(-raw.signedValue()) else PowerMeasurement(0)
}
trusted fun PowerHubPower.externalMeasurement(portMask: int,voltage: bool): PowerMeasurement {
    val register=powerHubTelemetryRegister(portMask,voltage)
    if (!this.valid() || register < 0 || portMask < 0) return PowerMeasurement(0)
    val raw=this.device().readRegister16LittleEndianChecked(register)
    if (raw.valid()) powerMeasurement(raw.signedValue()) else PowerMeasurement(0)
}
trusted fun PowerHubPower.externalMillivoltsChecked(portMask: int): PowerMeasurement = this.externalMeasurement(portMask,true)
trusted fun PowerHubPower.externalMilliampsChecked(portMask: int): PowerMeasurement = this.externalMeasurement(portMask,false)
trusted fun PowerHubPower.chargingChecked(): I2cByteResult {
    val current=this.batteryMilliampsChecked()
    if (!current.valid()) I2cByteResult(0) else I2cByteResult(256|(if (current.value() > 10) 1 else 0))
}
