import "./powerhub_types.ab"
// Status1 complete,2 invalidmask/handle,3 I/O failure. Bits8..15 acknowledge
// successfully written ports; bits16..23 identify firstfailedregister.
// Failed bus writes may have reached hardware; no rollback is implied.
type PowerHubPortWrite = int
fun PowerHubPortWrite.status(): int = this & 255
fun PowerHubPortWrite.appliedPorts(): int = (this>>>8)&255
fun PowerHubPortWrite.failedRegister(): int = (this>>>16)&255
fun powerHubControlPorts(register: int): int =
    if (register == 1) 32 else if (register == 2) 1 else if (register == 3) 8 else if (register == 4) 192 else 0
// CAN and RS485 share one supply control; selecting either affects both.
trusted fun PowerHubPower.setExternalPorts(portMask: int,enabled: bool): PowerHubPortWrite {
    if (!this.valid() || portMask < 0 || (portMask & ~233) != 0) return PowerHubPortWrite(2)
    var register=1
    var completed=0
    while (register <= 4) {
        val ports=powerHubControlPorts(register)
        if ((portMask & ports) != 0) {
            if (!this.device().writeRegister8(register,if (enabled) 1 else 0)) return PowerHubPortWrite(3|(completed<<8)|(register<<16))
            completed=completed|ports
        }
        register=register+1
    }
    PowerHubPortWrite(1|(completed<<8))
}
// One contiguous read, never combine values from separate control snapshots.
trusted fun PowerHubPower.enabledExternalPortsChecked(): I2cByteResult {
    if (!this.valid()) return I2cByteResult(0)
    val raw=this.device().readRegister32LittleEndianChecked(1)
    if (!raw.valid()) return I2cByteResult(0)
    var ports=0
    var register=1
    while (register <= 4) {
        if (((raw.value()>>>((register-1)*8)) & 255) != 0) ports=ports|powerHubControlPorts(register)
        register=register+1
    }
    I2cByteResult(256|ports)
}
trusted fun PowerHubPower.setMeterEnabled(enabled: bool): bool = this.valid() && this.device().writeRegister8(5,if (enabled) 1 else 0)
trusted fun PowerHubPower.setBatteryCharge(enabled: bool): bool = this.valid() && this.device().writeRegister8(6,if (enabled) 1 else 0)
