import "../i2c/results.ab"
// Borrowed PowerHub device0x50, configured100kHz by caller; no allocation,
// implicit probing, power switching or ownership transfer.
type PowerHubPower = int
fun PowerHubPower.valid(): bool = this > 0 && this <= 4294967295
fun PowerHubPower.device(): I2cDevice = I2cDevice(this | 0)
