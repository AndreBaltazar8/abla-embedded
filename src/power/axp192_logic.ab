fun axp192DcdcCode(voltageMillivolts: int, maximumCode: int): int {
    if (voltageMillivolts < 700 || maximumCode < 0) return -1
    val code = (voltageMillivolts - 700) / 25
    if (code > maximumCode) maximumCode else code
}

fun axp192LdoCode(voltageMillivolts: int): int {
    if (voltageMillivolts < 1800) return -1
    val code = (voltageMillivolts - 1800) / 100
    if (code > 15) 15 else code
}

fun axp192ChargeCurrentCode(maxMilliamps: int): int {
    if (maxMilliamps < 190) return 0
    if (maxMilliamps < 280) return 1
    if (maxMilliamps < 360) return 2
    if (maxMilliamps < 450) return 3
    if (maxMilliamps < 550) return 4
    if (maxMilliamps < 630) return 5
    if (maxMilliamps < 700) return 6
    if (maxMilliamps < 780) return 7
    if (maxMilliamps < 880) return 8
    if (maxMilliamps < 960) return 9
    if (maxMilliamps < 1000) return 10
    if (maxMilliamps < 1080) return 11
    if (maxMilliamps < 1160) return 12
    if (maxMilliamps < 1240) return 13
    if (maxMilliamps < 1320) return 14
    15
}

fun axp192ChargeVoltageCode(maxMillivolts: int): int {
    if (maxMillivolts < 4150) return 0
    if (maxMillivolts < 4200) return 1
    if (maxMillivolts < 4360) return 2
    3
}

fun axp192Register12(word: int): int =
    ((word >>> 8) << 4) | (word & 15)

fun axp192Register13(word: int): int =
    ((word >>> 8) << 5) | (word & 31)

fun axp192BatteryLevel(rawVoltage: int, rawDischargeCurrent: int): int {
    var level = if (rawVoltage > 3150) {
        (rawVoltage - 3075) * 16 / 100
    } else if (rawVoltage > 2690) {
        (rawVoltage - 2690) * 27 / 1000
    } else 0
    if (rawDischargeCurrent > 16) level = level - 16
    if (level < 0) 0 else if (level > 100) 100 else level
}
