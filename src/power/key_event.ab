// Destructive read result: low8 observed key bits; status at8 is1 read/argument
// failure,2 acknowledgement failure,3 successfully read and acknowledged.
// On acknowledgement failure bits remain available, but must not be treated
// as a newly consumed event: a retry may observe the same latched interrupt.
type PowerKeyEvent = int
fun PowerKeyEvent.status(): int = (this >>> 8) & 3
fun PowerKeyEvent.valid(): bool = this.status() == 3
fun PowerKeyEvent.observed(): int = this & 255

// Import with a concrete I2cDevice backend. Only the selected W1C bits are
// written; unrelated pending interrupts are preserved. No write for no event.
trusted fun powerKeyReadAndClear(device: I2cDevice,register: int,mask: int,shift: int): PowerKeyEvent {
    if (register < 0 || register > 255 || mask < 1 || mask > 255 || shift < 0 || shift > 7) return PowerKeyEvent(256)
    val read=device.readRegister8Checked(register)
    if (!read.valid()) return PowerKeyEvent(256)
    val selected=read.value() & mask
    val bits=int(u32(selected) >>> u32(shift))
    if (selected != 0 && !device.writeRegister8(register,selected)) return PowerKeyEvent(512 | bits)
    PowerKeyEvent(768 | bits)
}
