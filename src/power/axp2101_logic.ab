fun axp2101LdoCode(voltageMillivolts: int): int {
    if (voltageMillivolts < 500) return -1
    val code = (voltageMillivolts - 500) / 100
    if (code > 30) 30 else code
}

fun axp2101DldoCode(channel: int, voltageMillivolts: int): int {
    if (channel < 0 || channel > 1 || voltageMillivolts < 500) return -1
    val code = (voltageMillivolts - 500) / (if (channel == 0) 100 else 50)
    val maximum = if (channel == 0) 28 else 19
    if (code > maximum) maximum else code
}

fun axp2101PrechargeCurrentCode(maxMilliamps: int): int {
    if (maxMilliamps < 25) return 0
    if (maxMilliamps < 50) return 1
    if (maxMilliamps < 75) return 2
    if (maxMilliamps < 100) return 3
    if (maxMilliamps < 125) return 4
    if (maxMilliamps < 150) return 5
    if (maxMilliamps < 175) return 6
    if (maxMilliamps < 200) return 7
    8
}

fun axp2101ChargeCurrentCode(maxMilliamps: int): int {
    if (maxMilliamps < 125) return 4
    if (maxMilliamps < 150) return 5
    if (maxMilliamps < 175) return 6
    if (maxMilliamps < 200) return 7
    if (maxMilliamps < 300) return 8
    if (maxMilliamps < 400) return 9
    if (maxMilliamps < 500) return 10
    if (maxMilliamps < 600) return 11
    if (maxMilliamps < 700) return 12
    if (maxMilliamps < 800) return 13
    if (maxMilliamps < 900) return 14
    if (maxMilliamps < 1000) return 15
    16
}

fun axp2101ChargeVoltageCode(maxMillivolts: int): int {
    if (maxMillivolts < 4100) return 1
    if (maxMillivolts < 4200) return 2
    if (maxMillivolts < 4350) return 3
    if (maxMillivolts < 4400) return 4
    5
}

fun axp2101Register14(word: int): int =
    ((word >>> 8) & 63) << 8 | (word & 255)

fun axp2101ChargeStatus(status: int): int {
    val state = (status >>> 5) & 3
    if (state == 1) 1 else if (state == 2) -1 else 0
}

fun axp2101AdcValid(raw: int): bool = raw >= 0 && raw < 16351

fun axp2101PackIrqStatuses(first: int, second: int, third: int): int =
    (first & 255) | ((second & 255) << 8) | ((third & 255) << 16)

fun axp2101IrqByte(mask: int, index: int): int =
    if (index < 0 || index > 2) 0 else (mask >>> (index * 8)) & 255
