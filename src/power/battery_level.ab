import "../i2c/results.ab"
import "./ip5306_logic.ab"

// M5Unified Power_Class estimate: (cell millivolts -3300)/8, clamped.
// This is a voltage estimate, not a fuel-gauge state-of-charge measurement.
fun batteryLevelFromMillivolts(voltage: I2cWordResult): I2cByteResult {
    if (!voltage.valid()) return I2cByteResult(0)
    val mv=voltage.value()
    val level=if (mv <= 3300) 0 else if (mv >= 4100) 100 else (mv-3300)/8
    I2cByteResult(256|level)
}
// Preserve the AXP192's 1.1mV fractional ADC resolution before estimating.
fun axp192PowerBatteryLevel(raw: I2cWordResult): I2cByteResult {
    if (!raw.valid() || raw.value() > 4095) return I2cByteResult(0)
    val tenths=raw.value()*11
    val level=if (tenths <= 33000) 0 else if (tenths >= 41000) 100 else (tenths-33000)/80
    I2cByteResult(256|level)
}
fun axp2101BatteryLevelChecked(raw: I2cByteResult): I2cByteResult =
    if (raw.valid() && raw.value() <= 100) raw else I2cByteResult(0)
fun ip5306BatteryLevelChecked(raw: I2cByteResult): I2cByteResult =
    if (!raw.valid()) I2cByteResult(0) else I2cByteResult(256|ip5306BatteryLevel(raw.value()))
