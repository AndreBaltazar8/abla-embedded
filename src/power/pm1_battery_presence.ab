import "../esp32/sdk/raw_buffer.ab"
import "../i2c/results.ab"

// Nonblocking CoreMatrix/ToughC5 presence policy. Caller-owned32B state;
// readings are checked results, CHG_STAT payload1=high, nodeDown is confirmed
// collapse (false when unknown, matching upstream). Caller serializes access.
type Pm1BatteryPresence = int
fun pm1BatteryPresenceAt(storage: NativeBuffer): Pm1BatteryPresence =
    if (!storage.hasAddressRange(0,32) || (storage.addressValue()&3) != 0) Pm1BatteryPresence(0) else Pm1BatteryPresence(storage | 0)
fun Pm1BatteryPresence.buffer(): NativeBuffer = NativeBuffer(this | 0)
trusted fun Pm1BatteryPresence.initialize(): bool {
    val bytes=this.buffer()
    if (!bytes.hasAddressRange(0,32) || (bytes.addressValue()&3) != 0) return false
    var offset=8
    while (offset < 32) { bytes.storeU32(offset,0); offset=offset+4 }
    bytes.storeU32(4,0xFFFFFFFF)
    bytes.storeU32(0,0x504D3142)
}
trusted fun Pm1BatteryPresence.valid(): bool = this.buffer().hasAddressRange(0,32) &&
    (this.buffer().addressValue()&3) == 0 && this.buffer().loadU32(0) == 0x504D3142
trusted fun Pm1BatteryPresence.verdict(): int {
    if (!this.valid()) return -1
    val value=this.buffer().loadU32(4)
    if (value <= 1) value else -1
}
trusted fun Pm1BatteryPresence.chargingDisabledAt(now: int): bool {
    if (!this.valid()) return false
    // Disabled time is not part of a continuous live-charge streak.
    this.buffer().storeU32(28,this.buffer().loadU32(28) & ~1)
    this.buffer().storeU32(8,now & 0xFFFFFFFF)
}
// Separate timestamp-valid flags avoid treating millis()==0 as uninitialized.
// Caller supplies voltage only when available; invalid voltage preserves state.
trusted fun Pm1BatteryPresence.observe(enabled: I2cByteResult,chargeStat: I2cByteResult,
    nodeDown: bool,voltage: I2cWordResult,now: int): int {
    if (!this.valid()) return -1
    val bytes=this.buffer()
    val time=now & 0xFFFFFFFF
    var flags=bytes.loadU32(28)
    if (enabled.valid() && enabled.value() == 0) {
        if (voltage.valid()) {
            val mv=voltage.value()
            if (mv <= 2600) bytes.storeU32(4,0)
            else if (((time-bytes.loadU32(8)) & 0xFFFFFFFF) > 1500) bytes.storeU32(4,1)
            else if ((flags&2) == 0) {
                bytes.storeU32(12,time); bytes.storeU32(20,mv); bytes.storeU32(28,flags|2)
            }
        }
        return this.verdict()
    }
    if (chargeStat.valid()) {
        if (chargeStat.value() == 0 && !nodeDown) {
            if ((flags&1) == 0) { bytes.storeU32(16,time); bytes.storeU32(28,flags|1) }
            else if (((time-bytes.loadU32(16)) & 0xFFFFFFFF) >= 100) bytes.storeU32(4,1)
            return this.verdict()
        }
        flags=flags & ~1
        bytes.storeU32(28,flags)
    }
    if (!voltage.valid()) return this.verdict()
    val mv=voltage.value()
    if (mv > 4450) { bytes.storeU32(4,0); bytes.storeU32(24,0); return this.verdict() }
    if ((flags&2) == 0) {
        bytes.storeU32(12,time); bytes.storeU32(20,mv); bytes.storeU32(28,flags|2)
        return this.verdict()
    }
    if (((time-bytes.loadU32(12)) & 0xFFFFFFFF) < 1250) return this.verdict()
    val delta=mv-bytes.loadU32(20)
    val difference=if (delta < 0) -delta else delta
    bytes.storeU32(12,time); bytes.storeU32(20,mv)
    val counts=bytes.loadU32(24)
    var stable=counts & 255
    var unstable=(counts>>>8)&255
    var low=(counts>>>16)&255
    if (mv < 2600) { if (low < 4) low=low+1 } else low=0
    if (difference > 300) { if (unstable < 4) unstable=unstable+1; stable=0 }
    else { if (stable < 4) stable=stable+1; unstable=0 }
    bytes.storeU32(24,stable|(unstable<<8)|(low<<16))
    val verdict=this.verdict()
    if (verdict < 0) {
        if (low >= 2 || unstable >= 2) bytes.storeU32(4,0)
        else if (stable >= 2 && mv >= 2600) bytes.storeU32(4,1)
    } else if (verdict == 0) {
        if (stable >= 4 && mv >= 2600) bytes.storeU32(4,1)
    } else if (low >= 2) bytes.storeU32(4,0)
    this.verdict()
}
