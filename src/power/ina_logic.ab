import "abla/float"

fun powerSigned16(value: int): int {
    val selected = value & 65535
    if (selected < 32768) selected else selected - 65536
}

fun ina226ConfigurationValue(
    sampling: int,
    busConversionTime: int,
    shuntConversionTime: int,
    mode: int
): int = ((sampling & 7) << 9) | ((busConversionTime & 7) << 6) |
    ((shuntConversionTime & 7) << 3) | (mode & 7)

fun ina226CurrentLsbNanoamps(maxExpectedMilliamps: int): int =
    if (maxExpectedMilliamps <= 0 || maxExpectedMilliamps > 70368744) 0
    else (maxExpectedMilliamps * 1000000 + 32767) / 32768

fun ina226CalibrationValue(
    shuntMicroOhms: int,
    currentLsbNanoamps: int
): int {
    if (shuntMicroOhms <= 0 || currentLsbNanoamps <= 0) return 0
    if (shuntMicroOhms > 5120000000000 / currentLsbNanoamps) return 0
    val value = 5120000000000 / (shuntMicroOhms * currentLsbNanoamps)
    if (value > 65535) 65535 else value
}

fun ina226BusVoltage(raw: int): f64 =
    f64FromInt(raw & 65535) * 0.00125

fun ina226ShuntVoltage(raw: int): f64 =
    f64FromInt(powerSigned16(raw)) * 0.0000025

fun ina226Current(raw: int, currentLsbNanoamps: int): f64 =
    f64FromInt(powerSigned16(raw) * currentLsbNanoamps) / 1000000000.0

fun ina226Power(raw: int, currentLsbNanoamps: int): f64 =
    f64FromInt((raw & 65535) * currentLsbNanoamps * 25) / 1000000000.0

fun ina3221BusMillivolts(raw: int): int = powerSigned16(raw)
fun ina3221ShuntMicrovolts(raw: int): int = powerSigned16(raw) * 5

fun ina3221BusVoltage(raw: int): f64 =
    f64FromInt(ina3221BusMillivolts(raw)) / 1000.0

fun ina3221ShuntVoltage(raw: int): f64 =
    f64FromInt(ina3221ShuntMicrovolts(raw)) / 1000000.0

fun ina3221Current(raw: int, shuntMilliOhms: int): f64 =
    if (shuntMilliOhms <= 0) 0.0
    else f64FromInt(ina3221ShuntMicrovolts(raw)) /
        f64FromInt(shuntMilliOhms) / 1000.0

fun ina3221PackedValue(
    handle: int,
    channel0MilliOhms: int = 10,
    channel1MilliOhms: int = 10,
    channel2MilliOhms: int = 10
): int = (handle & 4294967295) | ((channel0MilliOhms & 1023) << 32) |
    ((channel1MilliOhms & 1023) << 42) |
    ((channel2MilliOhms & 1023) << 52)

fun ina3221PackedShuntResistance(value: int, channel: int): int {
    if (channel < 0 || channel > 2) return 0
    (value >>> (32 + channel * 10)) & 1023
}

fun ina3221PackedWithShuntResistance(
    value: int,
    channel: int,
    resistance: int
): int {
    if (channel < 0 || channel > 2 || resistance <= 0 || resistance > 1023) {
        return value
    }
    val shift = 32 + channel * 10
    (value & ~(1023 << shift)) | ((resistance & 1023) << shift)
}
