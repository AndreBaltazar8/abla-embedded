import "./measurement.ab"
import "../i2c/results.ab"
// Die temperature in millidegrees, not ambient or an accuracy guarantee.
// Keep the register equation exact rather than rounding through floating point.
fun axp192TemperatureMilliCelsiusChecked(raw: I2cWordResult): PowerMeasurement =
    if (!raw.valid() || raw.value() > 4095) PowerMeasurement(0) else powerMeasurement(raw.value()*100-144700)
fun axp2101TemperatureMilliCelsiusChecked(raw: I2cWordResult): PowerMeasurement =
    if (!raw.valid()) PowerMeasurement(0) else powerMeasurement(22000+(7274-raw.value())*50)
