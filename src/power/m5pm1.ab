import "../esp32/i2c_idf6.ab"
import "./m5pm1_logic.ab"

type M5Pm1 = int

trusted fun m5Pm1(
    bus: I2cBus,
    address: int = 110,
    frequency: int = 100000
): M5Pm1 = M5Pm1(
    if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0
)

fun M5Pm1.valid(): bool = (this & 4294967295) != 0
fun M5Pm1.device(): I2cDevice = I2cDevice(this & 4294967295)

trusted fun M5Pm1.begin(): bool {
    if (!this.valid()) return false
    val identity = this.device().readRegister32BigEndianChecked(0)
    identity.valid() && this.device().writeRegister8(9, 0) &&
        this.device().writeRegister8(10, 0)
}

trusted fun M5Pm1.close(): bool = this.valid() && this.device().close()

trusted fun M5Pm1.setPowerConfiguration(mask: int, enabled: bool): bool =
    this.valid() && this.device().updateRegister8(
        6, mask, if (enabled) mask else 0
    )

trusted fun M5Pm1.setExtOutput(enabled: bool): bool =
    this.setPowerConfiguration(8, enabled)

trusted fun M5Pm1.extOutput(): bool {
    if (!this.valid()) return false
    val config = this.device().readRegister8Checked(6)
    config.valid() && (config.value() & 8) != 0
}

trusted fun M5Pm1.setLdoOutput(enabled: bool): bool =
    this.setPowerConfiguration(4, enabled)

trusted fun M5Pm1.setDcdcOutput(enabled: bool): bool =
    this.setPowerConfiguration(2, enabled)

trusted fun M5Pm1.setLedEnableLevel(high: bool): bool =
    this.setPowerConfiguration(16, high)

trusted fun M5Pm1.powerSourceResult(): I2cByteResult =
    if (this.valid()) {
        val source = this.device().readRegister8Checked(4)
        I2cByteResult(
            if (source.valid()) 256 | (source.value() & 7) else 0
        )
    } else I2cByteResult(0)

trusted fun M5Pm1.powerSource(): int {
    val source = this.powerSourceResult()
    if (source.valid()) source.value() else 0
}

trusted fun M5Pm1.vbatNodePowered(): bool =
    (this.powerSource() & m5Pm1PowerSourceBattery) != 0

trusted fun M5Pm1.updateGpioField(
    firstRegister: int,
    pin: int,
    value: int
): bool {
    if (!this.valid() || !m5Pm1GpioValid(pin)) return false
    val shift = m5Pm1GpioFieldShift(pin)
    val mask = 3 << shift
    this.device().updateRegister8(
        m5Pm1GpioFieldRegister(pin, firstRegister), mask, value << shift
    )
}

trusted fun M5Pm1.setGpioFunction(pin: int, function: int): bool =
    m5Pm1GpioFunctionValid(function) &&
        this.updateGpioField(22, pin, function)

trusted fun M5Pm1.setGpioMode(pin: int, mode: int): bool =
    this.valid() && m5Pm1GpioValid(pin) && m5Pm1GpioModeValid(mode) &&
        this.device().updateRegister8(
            16, 1 << pin, if (mode == m5Pm1GpioOutput) 1 << pin else 0
        )

trusted fun M5Pm1.setGpioPull(pin: int, pull: int): bool =
    m5Pm1GpioPullValid(pull) && this.updateGpioField(20, pin, pull)

trusted fun M5Pm1.setGpioDrive(pin: int, drive: int): bool =
    this.valid() && m5Pm1GpioValid(pin) && m5Pm1GpioDriveValid(drive) &&
        this.device().updateRegister8(
            19, 1 << pin, if (drive == m5Pm1GpioOpenDrain) 1 << pin else 0
        )

trusted fun M5Pm1.setGpioOutput(pin: int, high: bool): bool =
    this.valid() && m5Pm1GpioValid(pin) &&
        this.device().updateRegister8(
            17, 1 << pin, if (high) 1 << pin else 0
        )

trusted fun M5Pm1.gpioInputBits(): I2cByteResult =
    if (this.valid()) this.device().readRegister8Checked(18)
    else I2cByteResult(0)

trusted fun M5Pm1.gpioInput(pin: int): bool {
    if (!m5Pm1GpioValid(pin)) return false
    val bits = this.gpioInputBits()
    bits.valid() && (bits.value() & (1 << pin)) != 0
}

trusted fun M5Pm1.gpioOutputLatch(pin: int): bool {
    if (!this.valid() || !m5Pm1GpioValid(pin)) return false
    val bits = this.device().readRegister8Checked(17)
    bits.valid() && (bits.value() & (1 << pin)) != 0
}

trusted fun M5Pm1.setPwmFrequency(frequency: int): bool =
    this.valid() && frequency >= 0 && frequency <= 65535 &&
        this.device().writeRegister16LittleEndian(52, frequency)

trusted fun M5Pm1.setPwmDuty12(
    channel: int,
    duty12: int,
    inverted: bool = false,
    enabled: bool = true
): bool =
    this.valid() && m5Pm1PwmChannelValid(channel) &&
        duty12 >= 0 && duty12 <= 4095 &&
        this.device().writeRegister16LittleEndian(
            48 + channel * 2,
            m5Pm1PwmValue(duty12, inverted, enabled)
        )

trusted fun M5Pm1.setPwmDutyPercent(
    channel: int,
    percent: int,
    inverted: bool = false,
    enabled: bool = true
): bool {
    val duty12 = m5Pm1PwmDuty12FromPercent(percent)
    duty12 >= 0 && this.setPwmDuty12(channel, duty12, inverted, enabled)
}

trusted fun M5Pm1.clearWakeSource(mask: int = 127): bool =
    this.valid() && this.device().writeRegister8(
        5, m5Pm1WakeClearValue(mask)
    )

trusted fun M5Pm1.clearGpioIrqStatus(): bool =
    this.valid() && this.device().writeRegister8(64, 0)

trusted fun M5Pm1.clearSystemIrqStatus(): bool =
    this.valid() && this.device().writeRegister8(65, 0)

trusted fun M5Pm1.clearButtonIrqStatus(): bool =
    this.valid() && this.device().writeRegister8(66, 0)

trusted fun M5Pm1.clearIrqStatus(): bool =
    this.clearGpioIrqStatus() && this.clearSystemIrqStatus() &&
        this.clearButtonIrqStatus()

trusted fun M5Pm1.setGpioIrqMask(mask: int): bool =
    this.valid() && this.device().writeRegister8(67, mask & 31)

trusted fun M5Pm1.setSystemIrqMask(mask: int): bool =
    this.valid() && this.device().writeRegister8(68, mask & 63)

trusted fun M5Pm1.setButtonIrqMask(mask: int): bool =
    this.valid() && this.device().writeRegister8(69, mask & 7)

trusted fun M5Pm1.setBatteryCharge(enabled: bool): bool =
    this.setPowerConfiguration(1, enabled)

trusted fun M5Pm1.batteryChargeResult(): I2cByteResult {
    if (!this.valid()) return I2cByteResult(0)
    val config = this.device().readRegister8Checked(6)
    I2cByteResult(
        if (config.valid()) 256 | (config.value() & 1) else 0
    )
}

trusted fun M5Pm1.batteryChargeEnabled(): bool {
    val result = this.batteryChargeResult()
    result.valid() && result.value() != 0
}

// The M5PM1 register map has no charge-current, charge-voltage, or live
// charging-status registers. M5Unified exposes permanent stubs too.
fun M5Pm1.setChargeCurrent(maxMilliamps: int): bool = false
fun M5Pm1.setChargeVoltage(maxMillivolts: int): bool = false
fun M5Pm1.chargeCurrentMilliamps(): int = 0
fun M5Pm1.chargeVoltageMillivolts(): int = 0
fun M5Pm1.charging(): bool = false

trusted fun M5Pm1.readPowerKeyEvent(): M5Pm1PowerKeyEvent {
    if (!this.valid()) return m5Pm1PowerKeyEvent(0, false)
    val status = this.device().readRegister8Checked(66)
    if (!status.valid()) return m5Pm1PowerKeyEvent(0, false)
    val pending = m5Pm1PowerKeyPending(status.value())
    if (pending == 0) return m5Pm1PowerKeyEvent(0, true)
    val cleared = this.device().writeRegister8(66, (255 - pending) & 7)
    m5Pm1PowerKeyEvent(pending, cleared)
}

trusted fun M5Pm1.powerKeyPress(): int =
    this.readPowerKeyEvent().compatibilityCode()

trusted fun M5Pm1.vbusVoltageRaw(): I2cWordResult =
    if (this.valid()) {
        this.device().readRegister16LittleEndianChecked(36)
    } else I2cWordResult(0)

trusted fun M5Pm1.batteryVoltageRaw(): I2cWordResult =
    if (this.valid()) {
        this.device().readRegister16LittleEndianChecked(34)
    } else I2cWordResult(0)

trusted fun M5Pm1.output5VVoltageRaw(): I2cWordResult =
    if (this.valid()) {
        this.device().readRegister16LittleEndianChecked(38)
    } else I2cWordResult(0)

trusted fun M5Pm1.vbusVoltageMillivolts(): int {
    val voltage = this.vbusVoltageRaw()
    if (voltage.valid()) voltage.value() else 0
}

trusted fun M5Pm1.batteryVoltageMillivolts(): int {
    val voltage = this.batteryVoltageRaw()
    if (voltage.valid()) voltage.value() else 0
}

trusted fun M5Pm1.output5VVoltageMillivolts(): int {
    val voltage = this.output5VVoltageRaw()
    if (voltage.valid()) voltage.value() else 0
}

trusted fun M5Pm1.powerOff(): bool =
    this.valid() && this.device().writeRegister8(12, 161)
