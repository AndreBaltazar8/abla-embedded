import "../esp32/i2c_idf6.ab"
import "./aw32001_logic.ab"

type Aw32001 = int

trusted fun aw32001(
    bus: I2cBus,
    address: int = 73,
    frequency: int = 400000
): Aw32001 = Aw32001(
    if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0
)

fun Aw32001.valid(): bool = (this & 4294967295) != 0
fun Aw32001.device(): I2cDevice = I2cDevice(this & 4294967295)

trusted fun Aw32001.begin(): bool {
    if (!this.valid()) return false
    val identity = this.device().readRegister8Checked(10)
    if (!identity.valid() || identity.value() != 73) return false
    // Disable the charger watchdog just as M5Unified does during discovery.
    this.device().updateRegister8(5, 224, 0)
}

trusted fun Aw32001.close(): bool = this.valid() && this.device().close()

trusted fun Aw32001.setBatteryCharge(enabled: bool): bool =
    this.valid() && this.device().updateRegister8(
        1, 8, if (enabled) 0 else 8
    )

trusted fun Aw32001.setChargeCurrent(maxMilliamps: int): bool =
    this.valid() && maxMilliamps >= 0 && this.device().writeRegister8(
        2, aw32001ChargeCurrentCode(maxMilliamps)
    )

trusted fun Aw32001.setChargeVoltage(maxMillivolts: int): bool =
    this.valid() && maxMillivolts >= 0 && this.device().updateRegister8(
        4, 63, aw32001ChargeVoltageCode(maxMillivolts)
    )

trusted fun Aw32001.chargeCurrentMilliamps(): int {
    if (!this.valid()) return 0
    val current = this.device().readRegister8Checked(2)
    if (current.valid()) {
        aw32001ChargeCurrentMilliamps(current.value())
    } else 0
}

trusted fun Aw32001.chargeVoltageMillivolts(): int {
    if (!this.valid()) return 0
    val voltage = this.device().readRegister8Checked(4)
    if (voltage.valid()) {
        aw32001ChargeVoltageMillivolts(voltage.value())
    } else 0
}

trusted fun Aw32001.chargeStatus(): int {
    if (!this.valid()) return aw32001ChargeUnknown
    val status = this.device().readRegister8Checked(8)
    if (status.valid()) {
        aw32001ChargeStatus(status.value())
    } else aw32001ChargeUnknown
}

trusted fun Aw32001.charging(): bool =
    aw32001Charging(this.chargeStatus())
