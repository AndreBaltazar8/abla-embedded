// Signed32 value plus validitybit32. Supports negating -32768 without losing
// the resulting +32768, unlike a signed16 result. Units belong to the API.
type PowerMeasurement = int
fun powerMeasurement(value: int): PowerMeasurement =
    if (value < -2147483648 || value > 2147483647) PowerMeasurement(0) else PowerMeasurement(4294967296|(value & 4294967295))
fun PowerMeasurement.valid(): bool = (this>>>32) == 1
fun PowerMeasurement.value(): int {
    val raw=this & 4294967295
    if (raw >= 2147483648) raw-4294967296 else raw
}
