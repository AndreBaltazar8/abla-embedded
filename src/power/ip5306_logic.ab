fun ip5306BatteryLevel(status: int): int {
    val state = (status >>> 4) & 15
    if (state == 0) return 100
    if (state == 8) return 75
    if (state == 12) return 50
    if (state == 14) return 25
    0
}

fun ip5306ChargeCurrentCode(maxMilliamps: int): int {
    if (maxMilliamps <= 50) return 0
    val code = (maxMilliamps - 50) / 100
    if (code > 31) 31 else code
}

// Select the greatest documented target that does not exceed the request.
// M5Unified's current clamp makes its 4.4 V table entry unreachable; keeping
// the selection in millivolts avoids that accidental loss of the top setting.
fun ip5306ChargeVoltageCode(maxMillivolts: int): int {
    if (maxMillivolts < 4300) return 2
    if (maxMillivolts < 4350) return 5
    if (maxMillivolts < 4400) return 9
    13
}

fun ip5306Charging(activeStatus: int, fullStatus: int): bool =
    (activeStatus & 8) != 0 && (fullStatus & 8) == 0
