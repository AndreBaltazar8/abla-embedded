import "../i2c/results.ab"
// Checked charging boolean: valid payload0/1, invalid on bad device/type or
// failed I2C. M5PM1 needs external charge-status wiring, not a guessed register.
type PowerChargeKind = int
val powerChargeAxp192=PowerChargeKind(1)
val powerChargeAxp2101=PowerChargeKind(2)
val powerChargeIp5306=PowerChargeKind(3)
val powerChargeAw32001=PowerChargeKind(4)
trusted fun I2cDevice.readBatteryPresentChecked(kind: PowerChargeKind): I2cByteResult {
    if (this == 0 || (this & ~4294967295) != 0 || (kind != powerChargeAxp192 && kind != powerChargeAxp2101)) return I2cByteResult(0)
    val status=this.readRegister8Checked(if (kind == powerChargeAxp192) 1 else 0)
    if (!status.valid()) return I2cByteResult(0)
    val mask=if (kind == powerChargeAxp192) 32 else 8
    I2cByteResult(256 | (if ((status.value() & mask) != 0) 1 else 0))
}
trusted fun I2cDevice.readChargingChecked(kind: PowerChargeKind): I2cByteResult {
    if (this == 0 || (this & ~4294967295) != 0 || kind < 1 || kind > 4) return I2cByteResult(0)
    val register=if (kind == 1) 0 else if (kind == 2) 1 else if (kind == 3) 112 else 8
    val status=this.readRegister8Checked(register)
    if (!status.valid()) return I2cByteResult(0)
    val value=status.value()
    var charging=false
    if (kind == 1) charging=(value & 4) != 0
    else if (kind == 2) charging=((value>>>5)&3) == 1
    else if (kind == 4) charging=((value>>>3)&3) == 1 || ((value>>>3)&3) == 2
    else {
        val full=this.readRegister8Checked(113)
        if (!full.valid()) return I2cByteResult(0)
        charging=(value & 8) != 0 && (full.value() & 8) == 0
    }
    I2cByteResult(256 | (if (charging) 1 else 0))
}
