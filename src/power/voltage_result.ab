import "../i2c/results.ab"

// Checked integer millivolts. Preserve failed transactions separately from0V.
// AXP192 battery ADC is1.1mV/count; truncate fractional millivolts as the
// upstream integer Power API does, without floating-point conversion.
fun axp192BatteryMillivolts(raw: I2cWordResult): I2cWordResult =
    if (raw.valid() && raw.value() <= 4095) I2cWordResult(65536 | (raw.value()*11/10)) else I2cWordResult(0)

// AXP2101 battery ADC has1mV/count. Unlike its other voltage channels, the
// upstream battery read does not apply the16351 disconnected-channel cutoff.
fun axp2101BatteryMillivolts(raw: I2cWordResult): I2cWordResult =
    if (raw.valid() && raw.value() <= 16383) raw else I2cWordResult(0)
