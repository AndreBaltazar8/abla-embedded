import "abla/float"
import "../esp32/i2c_idf6.ab"
import "../esp32/task.ab"
import "./bq27220_logic.ab"

type Bq27220 = int

trusted fun bq27220(
    bus: I2cBus,
    address: int = 85,
    frequency: int = 100000
): Bq27220 = Bq27220(
    if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0
)

fun Bq27220.valid(): bool = (this & 4294967295) != 0
fun Bq27220.device(): I2cDevice = I2cDevice(this & 4294967295)

trusted fun Bq27220.control(subcommand: int): bool =
    this.valid() && subcommand >= 0 && subcommand <= 65535 &&
        this.device().writeRegister16LittleEndian(0, subcommand)

// This is the same state-changing initialization sequence used by
// M5Unified: reset, query device number, then unseal and request full access.
// Reading voltage/current does not require calling begin again on every boot.
trusted fun Bq27220.begin(): bool {
    if (!this.control(65)) return false
    if (!this.control(1)) return false
    taskDelay(10)
    val identity = this.device().readRegister32BigEndianChecked(62)
    if (!identity.valid()) return false
    taskDelay(200)
    this.control(32768) && this.control(32768) &&
        this.control(65535) && this.control(65535)
}

trusted fun Bq27220.close(): bool = this.valid() && this.device().close()

trusted fun Bq27220.currentRaw(): I2cWordResult =
    if (this.valid()) {
        this.device().readRegister16LittleEndianChecked(20)
    } else I2cWordResult(0)

trusted fun Bq27220.voltageRaw(): I2cWordResult =
    if (this.valid()) {
        this.device().readRegister16LittleEndianChecked(8)
    } else I2cWordResult(0)

trusted fun Bq27220.currentMilliamps(): int {
    val raw = this.currentRaw()
    if (raw.valid()) bq27220Signed16(raw.value()) else 0
}

trusted fun Bq27220.voltageMillivolts(): int {
    val raw = this.voltageRaw()
    if (raw.valid()) raw.value() else 0
}

trusted fun Bq27220.currentAmps(): f64 =
    f64FromInt(this.currentMilliamps()) / 1000.0

trusted fun Bq27220.voltageVolts(): f64 =
    f64FromInt(this.voltageMillivolts()) / 1000.0
