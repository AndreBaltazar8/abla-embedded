import "./measurement.ab"
import "../i2c/results.ab"
import "../runtime/unsigned_division64.ab"
// Checked integer measurements: units express representation, not accuracy.
// Truncate final values toward zero; preserve signed shunt/bus conventions.
fun ina226BusMillivoltsChecked(raw: I2cWordResult): PowerMeasurement =
    if (!raw.valid()) PowerMeasurement(0) else powerMeasurement(int((u32(raw.value())*u32(5))/u32(4)))
fun ina226ShuntMicrovoltsChecked(raw: I2cWordResult): PowerMeasurement =
    if (!raw.valid()) PowerMeasurement(0) else powerMeasurement(int((i32(raw.signedValue())*i32(5))/i32(2)))
fun ina3221BusMillivoltsChecked(raw: I2cWordResult): PowerMeasurement =
    if (!raw.valid()) PowerMeasurement(0) else powerMeasurement(raw.signedValue())
fun ina3221ShuntMicrovoltsChecked(raw: I2cWordResult): PowerMeasurement =
    if (!raw.valid()) PowerMeasurement(0) else powerMeasurement(raw.signedValue()*5)
// Positive31-bit calibrated current LSB, unsigned16 power register. Product
// fits64 bits; reject results outside signed32 instead of wrapping/saturating.
fun ina226PowerMilliwattsChecked(raw: I2cWordResult,currentLsbNanoamps: int): PowerMeasurement {
    if (!raw.valid() || currentLsbNanoamps <= 0 || currentLsbNanoamps > 2147483647) return PowerMeasurement(0)
    return powerMeasurement(int(unsignedDivide64(u64(raw.value()*currentLsbNanoamps*25),u64(1000000))))
}
