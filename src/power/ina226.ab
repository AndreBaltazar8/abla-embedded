import "../esp32/i2c_idf6.ab"
import "./ina_logic.ab"

val ina226Sampling1 = 0
val ina226Sampling4 = 1
val ina226Sampling16 = 2
val ina226Sampling64 = 3
val ina226Sampling128 = 4
val ina226Sampling256 = 5
val ina226Sampling512 = 6
val ina226Sampling1024 = 7

val ina226Conversion140Microseconds = 0
val ina226Conversion204Microseconds = 1
val ina226Conversion332Microseconds = 2
val ina226Conversion588Microseconds = 3
val ina226Conversion1100Microseconds = 4
val ina226Conversion2116Microseconds = 5
val ina226Conversion4156Microseconds = 6
val ina226Conversion8244Microseconds = 7

val ina226ModePowerDown = 0
val ina226ModeShuntVoltageSingle = 1
val ina226ModeBusVoltageSingle = 2
val ina226ModeShuntAndBusSingle = 3
val ina226ModeShuntVoltageContinuous = 5
val ina226ModeBusVoltageContinuous = 6
val ina226ModeShuntAndBusContinuous = 7

// The low 32 bits are the ESP-IDF device handle. The upper 31 bits retain the
// calibrated current LSB in nanoamps, keeping the complete driver in one
// allocation-free scalar.
type Ina226 = int

trusted fun ina226(
    bus: I2cBus,
    address: int = 64,
    frequency: int = 400000
): Ina226 = Ina226(
    if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0
)

fun Ina226.valid(): bool = (this & 4294967295) != 0
fun Ina226.configured(): bool = this.currentLsbNanoamps() > 0
fun Ina226.device(): I2cDevice = I2cDevice(this & 4294967295)
fun Ina226.currentLsbNanoamps(): int = (this >>> 32) & 2147483647

trusted fun Ina226.begin(): bool {
    if (!this.valid()) return false
    val identity = this.device().readRegister16BigEndianChecked(255)
    identity.valid() && identity.value() == 8800
}

trusted fun Ina226.close(): bool =
    this.valid() && this.device().close()

trusted fun Ina226.configure(
    shuntMicroOhms: int = 100000,
    maxExpectedMilliamps: int = 2000,
    sampling: int = ina226Sampling16,
    shuntConversionTime: int = ina226Conversion1100Microseconds,
    busConversionTime: int = ina226Conversion1100Microseconds,
    mode: int = ina226ModeShuntAndBusContinuous
): Ina226 {
    if (!this.valid() || shuntMicroOhms <= 0 ||
        maxExpectedMilliamps <= 0 || sampling < 0 || sampling > 7 ||
        shuntConversionTime < 0 || shuntConversionTime > 7 ||
        busConversionTime < 0 || busConversionTime > 7 ||
        mode < 0 || mode > 7 || mode == 4) return Ina226(this & 4294967295)
    val currentLsb = ina226CurrentLsbNanoamps(maxExpectedMilliamps)
    val calibration = ina226CalibrationValue(shuntMicroOhms, currentLsb)
    if (calibration == 0) return Ina226(this & 4294967295)
    val configured = this.device().writeRegister16BigEndian(
        0, ina226ConfigurationValue(
            sampling, busConversionTime, shuntConversionTime, mode
        )
    ) && this.device().writeRegister16BigEndian(5, calibration)
    Ina226(
        (this & 4294967295) |
            (if (configured) (currentLsb & 2147483647) << 32 else 0)
    )
}

trusted fun Ina226.busVoltageRaw(): I2cWordResult =
    if (this.valid()) this.device().readRegister16BigEndianChecked(2)
    else I2cWordResult(0)

trusted fun Ina226.shuntVoltageRaw(): I2cWordResult =
    if (this.valid()) this.device().readRegister16BigEndianChecked(1)
    else I2cWordResult(0)

trusted fun Ina226.currentRaw(): I2cWordResult =
    if (this.valid()) this.device().readRegister16BigEndianChecked(4)
    else I2cWordResult(0)

trusted fun Ina226.powerRaw(): I2cWordResult =
    if (this.valid()) this.device().readRegister16BigEndianChecked(3)
    else I2cWordResult(0)

trusted fun Ina226.busVoltage(): f64 {
    val raw = this.busVoltageRaw()
    if (raw.valid()) ina226BusVoltage(raw.value()) else 0.0
}

trusted fun Ina226.shuntVoltage(): f64 {
    val raw = this.shuntVoltageRaw()
    if (raw.valid()) ina226ShuntVoltage(raw.value()) else 0.0
}

trusted fun Ina226.current(): f64 {
    val raw = this.currentRaw()
    if (raw.valid() && this.configured()) {
        return ina226Current(raw.value(), this.currentLsbNanoamps())
    }
    0.0
}

trusted fun Ina226.power(): f64 {
    val raw = this.powerRaw()
    if (raw.valid() && this.configured()) {
        return ina226Power(raw.value(), this.currentLsbNanoamps())
    }
    0.0
}
