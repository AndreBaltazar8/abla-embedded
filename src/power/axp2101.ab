import "abla/float"
import "../esp32/i2c_idf6.ab"
import "./axp2101_logic.ab"

val axp2101IrqBatteryWorkUnderTemperature = 1
val axp2101IrqBatteryWorkOverTemperature = 2
val axp2101IrqBatteryChargeUnderTemperature = 4
val axp2101IrqBatteryChargeOverTemperature = 8
val axp2101IrqGaugeNewSoc = 16
val axp2101IrqGaugeWatchdogTimeout = 32
val axp2101IrqWarningLevel1 = 64
val axp2101IrqWarningLevel2 = 128
val axp2101IrqPowerKeyPositiveEdge = 256
val axp2101IrqPowerKeyNegativeEdge = 512
val axp2101IrqPowerKeyLongPress = 1024
val axp2101IrqPowerKeyShortPress = 2048
val axp2101IrqBatteryRemoved = 4096
val axp2101IrqBatteryInserted = 8192
val axp2101IrqVbusRemoved = 16384
val axp2101IrqVbusInserted = 32768
val axp2101IrqBatteryOverVoltage = 65536
val axp2101IrqChargeTimerExpired = 131072
val axp2101IrqDieOverTemperature = 262144
val axp2101IrqBatteryChargeStarted = 524288
val axp2101IrqBatteryChargeDone = 1048576
val axp2101IrqBatteryFetOverCurrent = 2097152
val axp2101IrqLdoOverCurrent = 4194304
val axp2101IrqWatchdogExpired = 8388608
val axp2101IrqAll = 16777215

// The driver and each IRQ snapshot are allocation-free nominal scalars. IRQ
// status bit N intentionally uses the same bit N as its enable mask.
type Axp2101 = int
type Axp2101IrqStatus = int

trusted fun axp2101(
    bus: I2cBus,
    address: int = 52,
    frequency: int = 400000
): Axp2101 = Axp2101(
    if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0
)

fun Axp2101.valid(): bool = (this & 4294967295) != 0
fun Axp2101.device(): I2cDevice = I2cDevice(this & 4294967295)

trusted fun Axp2101.begin(): bool {
    if (!this.valid()) return false
    val identity = this.device().readRegister8Checked(3)
    identity.valid() && identity.value() == 74
}

trusted fun Axp2101.close(): bool = this.valid() && this.device().close()

trusted fun Axp2101.setLdo(channel: int, voltageMillivolts: int): bool {
    if (!this.valid() || channel < 0 || channel > 5) return false
    val code = axp2101LdoCode(voltageMillivolts)
    val enabledBit = 1 << channel
    this.device().writeRegister8(146 + channel, if (code < 0) 0 else code) &&
        this.device().updateRegister8(
            144, enabledBit, if (code < 0) 0 else enabledBit
        )
}

trusted fun Axp2101.setAldo1(voltageMillivolts: int): bool =
    this.setLdo(0, voltageMillivolts)
trusted fun Axp2101.setAldo2(voltageMillivolts: int): bool =
    this.setLdo(1, voltageMillivolts)
trusted fun Axp2101.setAldo3(voltageMillivolts: int): bool =
    this.setLdo(2, voltageMillivolts)
trusted fun Axp2101.setAldo4(voltageMillivolts: int): bool =
    this.setLdo(3, voltageMillivolts)
trusted fun Axp2101.setBldo1(voltageMillivolts: int): bool =
    this.setLdo(4, voltageMillivolts)
trusted fun Axp2101.setBldo2(voltageMillivolts: int): bool =
    this.setLdo(5, voltageMillivolts)

trusted fun Axp2101.setDldo(channel: int, voltageMillivolts: int): bool {
    if (!this.valid() || channel < 0 || channel > 1) return false
    val code = axp2101DldoCode(channel, voltageMillivolts)
    val enableRegister = if (channel == 0) 144 else 145
    val enableBit = if (channel == 0) 128 else 1
    this.device().writeRegister8(153 + channel, if (code < 0) 0 else code) &&
        this.device().updateRegister8(
            enableRegister, enableBit, if (code < 0) 0 else enableBit
        )
}

trusted fun Axp2101.setDldo1(voltageMillivolts: int): bool =
    this.setDldo(0, voltageMillivolts)
trusted fun Axp2101.setDldo2(voltageMillivolts: int): bool =
    this.setDldo(1, voltageMillivolts)

trusted fun Axp2101.ldoEnabled(channel: int): bool {
    if (!this.valid() || channel < 0 || channel > 5) return false
    val enabled = this.device().readRegister8Checked(144)
    enabled.valid() && (enabled.value() & (1 << channel)) != 0
}

trusted fun Axp2101.aldo1Enabled(): bool = this.ldoEnabled(0)
trusted fun Axp2101.aldo2Enabled(): bool = this.ldoEnabled(1)
trusted fun Axp2101.aldo3Enabled(): bool = this.ldoEnabled(2)
trusted fun Axp2101.aldo4Enabled(): bool = this.ldoEnabled(3)
trusted fun Axp2101.bldo1Enabled(): bool = this.ldoEnabled(4)
trusted fun Axp2101.bldo2Enabled(): bool = this.ldoEnabled(5)

trusted fun Axp2101.setBatteryCharge(enabled: bool): bool =
    this.valid() && this.device().updateRegister8(
        24, 2, if (enabled) 2 else 0
    )

trusted fun Axp2101.setPrechargeCurrent(maxMilliamps: int): bool =
    this.valid() && maxMilliamps >= 0 && this.device().writeRegister8(
        97, axp2101PrechargeCurrentCode(maxMilliamps)
    )

trusted fun Axp2101.setChargeCurrent(maxMilliamps: int): bool =
    this.valid() && maxMilliamps >= 0 && this.device().writeRegister8(
        98, axp2101ChargeCurrentCode(maxMilliamps)
    )

trusted fun Axp2101.setChargeVoltage(maxMillivolts: int): bool =
    this.valid() && maxMillivolts >= 0 && this.device().writeRegister8(
        100, axp2101ChargeVoltageCode(maxMillivolts)
    )

trusted fun Axp2101.batteryLevel(): int {
    if (!this.valid()) return -1
    val level = this.device().readRegister8Checked(164)
    if (level.valid()) level.value() else -1
}

trusted fun Axp2101.chargeStatus(): int {
    if (!this.valid()) return 0
    val status = this.device().readRegister8Checked(1)
    if (status.valid()) axp2101ChargeStatus(status.value()) else 0
}

trusted fun Axp2101.charging(): bool = this.chargeStatus() == 1

trusted fun Axp2101.powerOff(): bool =
    this.valid() && this.device().updateRegister8(16, 1, 1)

trusted fun Axp2101.setAdcEnabled(enabled: bool): bool =
    this.valid() && this.device().writeRegister8(
        48, if (enabled) 63 else 3
    )

// AXP2101_Class exposes these calls but its current upstream implementations
// are empty. Returning false makes the unsupported operation explicit.
fun Axp2101.setAdcRate(rate: int): bool = false
fun Axp2101.setBackupEnabled(enabled: bool): bool = false
fun Axp2101.acinPresent(): bool = false

trusted fun Axp2101.statusBit(mask: int): bool {
    if (!this.valid()) return false
    val status = this.device().readRegister8Checked(0)
    status.valid() && (status.value() & mask) != 0
}

trusted fun Axp2101.vbusPresent(): bool = this.statusBit(32)
trusted fun Axp2101.batteryPresent(): bool = this.statusBit(8)

trusted fun Axp2101.powerKeyPress(): int {
    if (!this.valid()) return 0
    val status = this.device().readRegister8Checked(73)
    if (!status.valid()) return 0
    val selected = status.value() & 12
    if (selected != 0) this.device().writeRegister8(73, selected)
    selected >>> 2
}

trusted fun Axp2101.read14(register: int): I2cWordResult {
    if (!this.valid()) return I2cWordResult(0)
    val word = this.device().readRegister16BigEndianChecked(register)
    if (!word.valid()) return I2cWordResult(0)
    I2cWordResult(65536 | axp2101Register14(word.value()))
}

trusted fun Axp2101.batteryVoltage(): f64 {
    val raw = this.read14(52)
    if (raw.valid()) f64FromInt(raw.value()) / 1000.0 else 0.0
}

trusted fun Axp2101.vbusVoltage(): f64 {
    if (!this.vbusPresent()) return 0.0
    val raw = this.read14(56)
    if (raw.valid() && axp2101AdcValid(raw.value())) {
        f64FromInt(raw.value()) / 1000.0
    } else 0.0
}

trusted fun Axp2101.tsVoltage(): f64 {
    val raw = this.read14(54)
    if (raw.valid() && axp2101AdcValid(raw.value())) {
        f64FromInt(raw.value()) / 2000.0
    } else 0.0
}

trusted fun Axp2101.apsVoltage(): f64 {
    val raw = this.read14(58)
    if (raw.valid() && axp2101AdcValid(raw.value())) {
        f64FromInt(raw.value()) / 1000.0
    } else 0.0
}

trusted fun Axp2101.internalTemperatureCelsius(): f64 {
    if (!this.valid()) return 0.0
    val raw = this.device().readRegister16BigEndianChecked(60)
    if (raw.valid()) {
        22.0 + f64FromInt(7274 - raw.value()) / 20.0
    } else 0.0
}

trusted fun Axp2101.setIrqs(mask: int, enabled: bool): bool {
    if (!this.valid() || mask < 0 || mask > axp2101IrqAll) return false
    var success = true
    var index = 0
    while (index < 3) {
        val selected = axp2101IrqByte(mask, index)
        if (selected != 0 && !this.device().updateRegister8(
            64 + index, selected, if (enabled) selected else 0
        )) success = false
        index = index + 1
    }
    success
}

trusted fun Axp2101.enableIrqs(mask: int): bool = this.setIrqs(mask, true)
trusted fun Axp2101.disableIrqs(mask: int): bool = this.setIrqs(mask, false)

trusted fun Axp2101.readIrqStatuses(): I2cDwordResult {
    if (!this.valid()) return I2cDwordResult(0)
    val first = this.device().readRegister8Checked(72)
    val second = this.device().readRegister8Checked(73)
    val third = this.device().readRegister8Checked(74)
    if (!first.valid() || !second.valid() || !third.valid()) {
        return I2cDwordResult(0)
    }
    I2cDwordResult(4294967296 | axp2101PackIrqStatuses(
        first.value(), second.value(), third.value()
    ))
}

trusted fun Axp2101.clearIrqStatuses(): bool {
    if (!this.valid()) return false
    var success = true
    var index = 0
    while (index < 3) {
        if (!this.device().writeRegister8(72 + index, 255)) success = false
        index = index + 1
    }
    success
}

fun Axp2101IrqStatus.has(mask: int): bool =
    mask != 0 && (this & mask) == mask
