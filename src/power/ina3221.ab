import "../esp32/i2c_idf6.ab"
import "./ina_logic.ab"

// Handle plus three 10-bit shunt-resistance values fit in one 64-bit scalar.
// Resistance is expressed in milliohms, matching the M5Stack power hardware.
type Ina3221 = int

trusted fun ina3221(
    bus: I2cBus,
    address: int = 64,
    frequency: int = 400000
): Ina3221 = Ina3221(
    ina3221PackedValue(
        if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0
    )
)

fun Ina3221.valid(): bool = (this & 4294967295) != 0
fun Ina3221.device(): I2cDevice = I2cDevice(this & 4294967295)

fun Ina3221.shuntResistanceMilliOhms(channel: int): int {
    ina3221PackedShuntResistance(this, channel)
}

fun Ina3221.withShuntResistanceMilliOhms(
    channel: int,
    resistance: int
): Ina3221 {
    Ina3221(ina3221PackedWithShuntResistance(this, channel, resistance))
}

trusted fun Ina3221.begin(): bool {
    if (!this.valid()) return false
    val identity = this.device().readRegister16BigEndianChecked(255)
    identity.valid() && identity.value() == 12832
}

trusted fun Ina3221.close(): bool =
    this.valid() && this.device().close()

trusted fun Ina3221.busVoltageRaw(channel: int): I2cWordResult =
    if (this.valid() && channel >= 0 && channel < 3) {
        this.device().readRegister16BigEndianChecked(2 + channel * 2)
    } else I2cWordResult(0)

trusted fun Ina3221.shuntVoltageRaw(channel: int): I2cWordResult =
    if (this.valid() && channel >= 0 && channel < 3) {
        this.device().readRegister16BigEndianChecked(1 + channel * 2)
    } else I2cWordResult(0)

trusted fun Ina3221.busMillivolts(channel: int): int {
    val raw = this.busVoltageRaw(channel)
    if (raw.valid()) ina3221BusMillivolts(raw.value()) else 0
}

trusted fun Ina3221.shuntMicrovolts(channel: int): int {
    val raw = this.shuntVoltageRaw(channel)
    if (raw.valid()) ina3221ShuntMicrovolts(raw.value()) else 0
}

trusted fun Ina3221.busVoltage(channel: int): f64 =
    f64FromInt(this.busMillivolts(channel)) / 1000.0

trusted fun Ina3221.shuntVoltage(channel: int): f64 =
    f64FromInt(this.shuntMicrovolts(channel)) / 1000000.0

trusted fun Ina3221.current(channel: int): f64 {
    val resistance = this.shuntResistanceMilliOhms(channel)
    if (resistance <= 0) return 0.0
    f64FromInt(this.shuntMicrovolts(channel)) /
        f64FromInt(resistance) / 1000.0
}
