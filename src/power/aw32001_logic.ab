val aw32001ChargeUnknown = -1
val aw32001ChargeNotCharging = 0
val aw32001ChargePrecharge = 1
val aw32001ChargeActive = 2
val aw32001ChargeDone = 3

fun aw32001ChargeCurrentCode(maxMilliamps: int): int {
    if (maxMilliamps <= 8) return 0
    val code = (maxMilliamps - 8) / 8
    if (code > 63) 63 else code
}

fun aw32001ChargeCurrentMilliamps(code: int): int =
    (code & 63) * 8 + 8

// The inverse of the documented/readback formula is exact. M5Unified
// currently subtracts one after division, so every exact step above 3.6 V is
// programmed 15 mV lower than requested.
fun aw32001ChargeVoltageCode(maxMillivolts: int): int {
    if (maxMillivolts <= 3600) return 0
    val code = (maxMillivolts - 3600) / 15
    if (code > 63) 63 else code
}

fun aw32001ChargeVoltageMillivolts(code: int): int =
    (code & 63) * 15 + 3600

fun aw32001ChargeStatus(status: int): int = (status >>> 3) & 3

fun aw32001Charging(status: int): bool =
    status == aw32001ChargePrecharge || status == aw32001ChargeActive
