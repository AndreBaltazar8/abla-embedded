import "../esp32/i2c_idf6.ab"
import "./ip5306_logic.ab"

type Ip5306 = int

trusted fun ip5306(
    bus: I2cBus,
    address: int = 117,
    frequency: int = 400000
): Ip5306 = Ip5306(
    if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0
)

fun Ip5306.valid(): bool = (this & 4294967295) != 0
fun Ip5306.device(): I2cDevice = I2cDevice(this & 4294967295)

trusted fun Ip5306.begin(): bool =
    this.valid() && this.device().writeRegister8(6, 0) &&
        this.device().writeRegister8(6, 2)

trusted fun Ip5306.close(): bool = this.valid() && this.device().close()

trusted fun Ip5306.batteryLevel(): int {
    if (!this.valid()) return -1
    val status = this.device().readRegister8Checked(120)
    if (status.valid()) ip5306BatteryLevel(status.value()) else -1
}

trusted fun Ip5306.setBatteryCharge(enabled: bool): bool =
    this.valid() && this.device().updateRegister8(
        0, 16, if (enabled) 16 else 0
    )

trusted fun Ip5306.setChargeCurrent(maxMilliamps: int): bool =
    this.valid() && maxMilliamps >= 0 && this.device().updateRegister8(
        36, 31, ip5306ChargeCurrentCode(maxMilliamps)
    )

trusted fun Ip5306.setChargeVoltage(maxMillivolts: int): bool =
    this.valid() && maxMillivolts >= 0 && this.device().writeRegister8(
        34, ip5306ChargeVoltageCode(maxMillivolts)
    )

trusted fun Ip5306.charging(): bool {
    if (!this.valid()) return false
    val active = this.device().readRegister8Checked(112)
    if (!active.valid()) return false
    val full = this.device().readRegister8Checked(113)
    full.valid() && ip5306Charging(active.value(), full.value())
}

trusted fun Ip5306.setPowerBoostKeepOn(enabled: bool): bool =
    this.valid() && this.device().updateRegister8(
        0, 2, if (enabled) 2 else 0
    )
