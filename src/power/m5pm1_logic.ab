val m5Pm1GpioFunctionGpio = 0
val m5Pm1GpioFunctionIrq = 1
val m5Pm1GpioFunctionSpecial = 3

val m5Pm1GpioInput = 0
val m5Pm1GpioOutput = 1

val m5Pm1GpioPullNone = 0
val m5Pm1GpioPullUp = 1
val m5Pm1GpioPullDown = 2

val m5Pm1GpioPushPull = 0
val m5Pm1GpioOpenDrain = 1

val m5Pm1PowerSourceVin = 1
val m5Pm1PowerSourceVinOut = 2
val m5Pm1PowerSourceBattery = 4

fun m5Pm1GpioValid(pin: int): bool = pin >= 0 && pin < 5

fun m5Pm1GpioFunctionValid(function: int): bool =
    function == m5Pm1GpioFunctionGpio ||
        function == m5Pm1GpioFunctionIrq ||
        function == m5Pm1GpioFunctionSpecial

fun m5Pm1GpioModeValid(mode: int): bool =
    mode == m5Pm1GpioInput || mode == m5Pm1GpioOutput

fun m5Pm1GpioPullValid(pull: int): bool =
    pull >= m5Pm1GpioPullNone && pull <= m5Pm1GpioPullDown

fun m5Pm1GpioDriveValid(drive: int): bool =
    drive == m5Pm1GpioPushPull || drive == m5Pm1GpioOpenDrain

fun m5Pm1GpioFieldRegister(pin: int, firstRegister: int): int =
    if (pin < 4) firstRegister else firstRegister + 1

fun m5Pm1GpioFieldShift(pin: int): int =
    (if (pin < 4) pin else pin - 4) * 2

fun m5Pm1PwmChannelValid(channel: int): bool =
    channel >= 0 && channel <= 1

fun m5Pm1PwmDuty12FromPercent(percent: int): int =
    if (percent >= 0 && percent <= 100) percent * 4095 / 100 else -1

fun m5Pm1PwmValue(duty12: int, inverted: bool, enabled: bool): int =
    (duty12 & 4095) |
        (if (enabled) 1 << 12 else 0) |
        (if (inverted) 1 << 13 else 0)

fun m5Pm1WakeClearValue(mask: int): int = (255 - mask) & 127

fun m5Pm1PowerKeyPending(status: int): int = status & 5

// Low bits preserve the PM1 IRQ flags and bit eight records a successful
// read-and-clear transaction. This is a complete event snapshot, so the
// driver needs no hidden mutable state to remember a double click.
type M5Pm1PowerKeyEvent = int

fun m5Pm1PowerKeyEvent(pending: int, valid: bool): M5Pm1PowerKeyEvent =
    M5Pm1PowerKeyEvent((pending & 5) | (if (valid) 256 else 0))

fun M5Pm1PowerKeyEvent.valid(): bool = (this & 256) != 0
fun M5Pm1PowerKeyEvent.pressed(): bool =
    this.valid() && (this & 5) != 0
fun M5Pm1PowerKeyEvent.doubleClicked(): bool =
    this.valid() && (this & 4) != 0
fun M5Pm1PowerKeyEvent.compatibilityCode(): int =
    if (this.pressed()) 2 else 0
