// Import alongside the selected I2cBus/I2cDevice backend.
import "./m5pm1_logic.ab"
import "../i2c/device.ab"

import "./m5pm1_type.ab"
import "../hal/m5pm1.ab"

trusted fun m5Pm1(
    bus: I2cBus,
    address: int = 110,
    frequency: int = 100000
): M5Pm1 = M5Pm1(
    if (bus.valid()) bus.device(address, frequency) & 4294967295 else 0
)

@export("abla_m5pm1_valid")
fun m5Pm1ValidHook(recv: int): bool = M5Pm1(recv) > 0 && M5Pm1(recv) <= 4294967295
@export("abla_m5pm1_device")
fun m5Pm1DeviceHook(recv: int): I2cDevice = I2cDevice(if (M5Pm1(recv).valid()) M5Pm1(recv) | 0 else 0)

@export("abla_m5pm1_begin")
trusted fun m5Pm1BeginHook(recv: int): bool {
    if (!M5Pm1(recv).valid()) return false
    val identity = M5Pm1(recv).device().readRegister32BigEndianChecked(0)
    identity.valid() && M5Pm1(recv).device().writeRegister8(9, 0) &&
        M5Pm1(recv).device().writeRegister8(10, 0)
}

@export("abla_m5pm1_close")
trusted fun m5Pm1CloseHook(recv: int): bool = M5Pm1(recv).valid() && M5Pm1(recv).device().close()

@export("abla_m5pm1_setPowerConfiguration")
trusted fun m5Pm1SetPowerConfigurationHook(recv: int, mask: int, enabled: bool): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().updateRegister8(
        6, mask, if (enabled) mask else 0
    )

trusted fun M5Pm1.setExtOutput(enabled: bool): bool =
    this.setPowerConfiguration(8, enabled)

@export("abla_m5pm1_extOutputChecked")
trusted fun m5Pm1ExtOutputCheckedHook(recv: int): I2cByteResult {
    if (!M5Pm1(recv).valid()) return I2cByteResult(0)
    val config = M5Pm1(recv).device().readRegister8Checked(6)
    if (config.valid()) I2cByteResult(256 | (if ((config.value() & 8) != 0) 1 else 0)) else I2cByteResult(0)
}
@export("abla_m5pm1_extOutput")
trusted fun m5Pm1ExtOutputHook(recv: int): bool {
    val result=M5Pm1(recv).extOutputChecked()
    result.valid() && result.value() != 0
}

@export("abla_m5pm1_setLdoOutput")
trusted fun m5Pm1SetLdoOutputHook(recv: int, enabled: bool): bool =
    M5Pm1(recv).setPowerConfiguration(4, enabled)

@export("abla_m5pm1_setDcdcOutput")
trusted fun m5Pm1SetDcdcOutputHook(recv: int, enabled: bool): bool =
    M5Pm1(recv).setPowerConfiguration(2, enabled)

trusted fun M5Pm1.setLedEnableLevel(high: bool): bool =
    this.setPowerConfiguration(16, high)

@export("abla_m5pm1_powerSourceResult")
trusted fun m5Pm1PowerSourceResultHook(recv: int): I2cByteResult =
    if (M5Pm1(recv).valid()) {
        val source = M5Pm1(recv).device().readRegister8Checked(4)
        I2cByteResult(
            if (source.valid()) 256 | (source.value() & 7) else 0
        )
    } else I2cByteResult(0)

@export("abla_m5pm1_powerSource")
trusted fun m5Pm1PowerSourceHook(recv: int): int {
    val source = M5Pm1(recv).powerSourceResult()
    if (source.valid()) source.value() else 0
}

@export("abla_m5pm1_vbatNodePowered")
trusted fun m5Pm1VbatNodePoweredHook(recv: int): bool =
    (M5Pm1(recv).powerSource() & m5Pm1PowerSourceBattery) != 0

trusted fun M5Pm1.updateGpioField(
    firstRegister: int,
    pin: int,
    value: int
): bool {
    if (!this.valid() || !m5Pm1GpioValid(pin)) return false
    val shift = m5Pm1GpioFieldShift(pin)
    val mask = int(u32(3) << u32(shift))
    this.device().updateRegister8(
        m5Pm1GpioFieldRegister(pin, firstRegister), mask, int(u32(value & 3) << u32(shift))
    )
}

trusted fun M5Pm1.setGpioFunction(pin: int, function: int): bool =
    m5Pm1GpioFunctionValid(function) &&
        this.updateGpioField(22, pin, function)

@export("abla_m5pm1_setGpioMode")
trusted fun m5Pm1SetGpioModeHook(recv: int, pin: int, mode: int): bool =
    M5Pm1(recv).valid() && m5Pm1GpioValid(pin) && m5Pm1GpioModeValid(mode) &&
        M5Pm1(recv).device().updateRegister8(
            16, int(u32(1) << u32(pin)), if (mode == m5Pm1GpioOutput) int(u32(1) << u32(pin)) else 0
        )

@export("abla_m5pm1_setGpioPull")
trusted fun m5Pm1SetGpioPullHook(recv: int, pin: int, pull: int): bool =
    m5Pm1GpioPullValid(pull) && M5Pm1(recv).updateGpioField(20, pin, pull)

trusted fun M5Pm1.setGpioDrive(pin: int, drive: int): bool =
    this.valid() && m5Pm1GpioValid(pin) && m5Pm1GpioDriveValid(drive) &&
        this.device().updateRegister8(
            19, int(u32(1) << u32(pin)), if (drive == m5Pm1GpioOpenDrain) int(u32(1) << u32(pin)) else 0
        )

@export("abla_m5pm1_setGpioOutput")
trusted fun m5Pm1SetGpioOutputHook(recv: int, pin: int, high: bool): bool =
    M5Pm1(recv).valid() && m5Pm1GpioValid(pin) &&
        M5Pm1(recv).device().updateRegister8(
            17, int(u32(1) << u32(pin)), if (high) int(u32(1) << u32(pin)) else 0
        )

@export("abla_m5pm1_gpioInputBits")
trusted fun m5Pm1GpioInputBitsHook(recv: int): I2cByteResult =
    if (M5Pm1(recv).valid()) M5Pm1(recv).device().readRegister8Checked(18)
    else I2cByteResult(0)

@export("abla_m5pm1_gpioInput")
trusted fun m5Pm1GpioInputHook(recv: int, pin: int): bool {
    if (!m5Pm1GpioValid(pin)) return false
    val bits = M5Pm1(recv).gpioInputBits()
    bits.valid() && (bits.value() & (int(u32(1) << u32(pin)))) != 0
}

@export("abla_m5pm1_gpioOutputLatchBitsChecked")
trusted fun m5Pm1GpioOutputLatchBitsCheckedHook(recv: int): I2cByteResult =
    if (M5Pm1(recv).valid()) M5Pm1(recv).device().readRegister8Checked(17) else I2cByteResult(0)

@export("abla_m5pm1_gpioOutputLatch")
trusted fun m5Pm1GpioOutputLatchHook(recv: int, pin: int): bool {
    if (!M5Pm1(recv).valid() || !m5Pm1GpioValid(pin)) return false
    val bits = M5Pm1(recv).gpioOutputLatchBitsChecked()
    bits.valid() && (bits.value() & (int(u32(1) << u32(pin)))) != 0
}

@export("abla_m5pm1_setPwmFrequency")
trusted fun m5Pm1SetPwmFrequencyHook(recv: int, frequency: int): bool =
    M5Pm1(recv).valid() && frequency >= 0 && frequency <= 65535 &&
        M5Pm1(recv).device().writeRegister16LittleEndian(52, frequency)

trusted fun M5Pm1.setPwmDuty12(
    channel: int,
    duty12: int,
    inverted: bool = false,
    enabled: bool = true
): bool =
    this.valid() && m5Pm1PwmChannelValid(channel) &&
        duty12 >= 0 && duty12 <= 4095 &&
        this.device().writeRegister16LittleEndian(
            48 + channel * 2,
            m5Pm1PwmValue(duty12, inverted, enabled)
        )

trusted fun M5Pm1.setPwmDutyPercent(
    channel: int,
    percent: int,
    inverted: bool = false,
    enabled: bool = true
): bool {
    val duty12 = m5Pm1PwmDuty12FromPercent(percent)
    duty12 >= 0 && this.setPwmDuty12(channel, duty12, inverted, enabled)
}

@export("abla_m5pm1_clearWakeSource")
trusted fun m5Pm1ClearWakeSourceHook(recv: int, mask: int): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().writeRegister8(
        5, m5Pm1WakeClearValue(mask)
    )

@export("abla_m5pm1_clearGpioIrqStatus")
trusted fun m5Pm1ClearGpioIrqStatusHook(recv: int): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().writeRegister8(64, 0)

@export("abla_m5pm1_clearSystemIrqStatus")
trusted fun m5Pm1ClearSystemIrqStatusHook(recv: int): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().writeRegister8(65, 0)

@export("abla_m5pm1_clearButtonIrqStatus")
trusted fun m5Pm1ClearButtonIrqStatusHook(recv: int): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().writeRegister8(66, 0)

@export("abla_m5pm1_clearIrqStatus")
trusted fun m5Pm1ClearIrqStatusHook(recv: int): bool {
    val gpio=M5Pm1(recv).clearGpioIrqStatus()
    val system=M5Pm1(recv).clearSystemIrqStatus()
    val button=M5Pm1(recv).clearButtonIrqStatus()
    gpio && system && button
}

// PM1 IRQ release prerequisite for ToughC5/CoreMatrix: WAKE_SRC first, then
// every IRQ status register. Attempt all independent clears after a failure.
// Result0 invalid; bit8 accepted, low4 acknowledged writes in this order.
// 271 means all writes acknowledged, NOT that the physical IRQ is high.
// Caller must consume originating touch/RTC reports and verify GPIO separately.
@export("abla_m5pm1_clearWakeInterruptChecked")
trusted fun m5Pm1ClearWakeInterruptCheckedHook(recv: int): int {
    if (!M5Pm1(recv).valid()) return 0
    var done=256
    if (M5Pm1(recv).clearWakeSource()) done=done|1
    if (M5Pm1(recv).clearGpioIrqStatus()) done=done|2
    if (M5Pm1(recv).clearSystemIrqStatus()) done=done|4
    if (M5Pm1(recv).clearButtonIrqStatus()) done=done|8
    done
}

@export("abla_m5pm1_setGpioIrqMask")
trusted fun m5Pm1SetGpioIrqMaskHook(recv: int, mask: int): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().writeRegister8(67, mask & 31)

@export("abla_m5pm1_setSystemIrqMask")
trusted fun m5Pm1SetSystemIrqMaskHook(recv: int, mask: int): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().writeRegister8(68, mask & 63)

@export("abla_m5pm1_setButtonIrqMask")
trusted fun m5Pm1SetButtonIrqMaskHook(recv: int, mask: int): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().writeRegister8(69, mask & 7)

@export("abla_m5pm1_setBatteryCharge")
trusted fun m5Pm1SetBatteryChargeHook(recv: int, enabled: bool): bool =
    M5Pm1(recv).setPowerConfiguration(1, enabled)

@export("abla_m5pm1_batteryChargeResult")
trusted fun m5Pm1BatteryChargeResultHook(recv: int): I2cByteResult {
    if (!M5Pm1(recv).valid()) return I2cByteResult(0)
    val config = M5Pm1(recv).device().readRegister8Checked(6)
    I2cByteResult(
        if (config.valid()) 256 | (config.value() & 1) else 0
    )
}

@export("abla_m5pm1_batteryChargeEnabled")
trusted fun m5Pm1BatteryChargeEnabledHook(recv: int): bool {
    val result = M5Pm1(recv).batteryChargeResult()
    result.valid() && result.value() != 0
}

// The M5PM1 register map has no charge-current, charge-voltage, or live
// charging-status registers. M5Unified exposes permanent stubs too.
@export("abla_m5pm1_setChargeCurrent")
fun m5Pm1SetChargeCurrentHook(recv: int, maxMilliamps: int): bool = false
@export("abla_m5pm1_setChargeVoltage")
fun m5Pm1SetChargeVoltageHook(recv: int, maxMillivolts: int): bool = false
@export("abla_m5pm1_chargeCurrentMilliamps")
fun m5Pm1ChargeCurrentMilliampsHook(recv: int): int = 0
@export("abla_m5pm1_chargeVoltageMillivolts")
fun m5Pm1ChargeVoltageMillivoltsHook(recv: int): int = 0
@export("abla_m5pm1_charging")
fun m5Pm1ChargingHook(recv: int): bool = false

@export("abla_m5pm1_readPowerKeyEvent")
trusted fun m5Pm1ReadPowerKeyEventHook(recv: int): M5Pm1PowerKeyEvent {
    if (!M5Pm1(recv).valid()) return m5Pm1PowerKeyEvent(0, false)
    val status = M5Pm1(recv).device().readRegister8Checked(66)
    if (!status.valid()) return m5Pm1PowerKeyEvent(0, false)
    val pending = m5Pm1PowerKeyPending(status.value())
    if (pending == 0) return m5Pm1PowerKeyEvent(0, true)
    val cleared = M5Pm1(recv).device().writeRegister8(66, (255 - pending) & 7)
    m5Pm1PowerKeyEvent(pending, cleared)
}

@export("abla_m5pm1_powerKeyPress")
trusted fun m5Pm1PowerKeyPressHook(recv: int): int =
    M5Pm1(recv).readPowerKeyEvent().compatibilityCode()

@export("abla_m5pm1_vbusVoltageRaw")
trusted fun m5Pm1VbusVoltageRawHook(recv: int): I2cWordResult =
    if (M5Pm1(recv).valid()) {
        M5Pm1(recv).device().readRegister16LittleEndianChecked(36)
    } else I2cWordResult(0)

@export("abla_m5pm1_vbusMillivoltsChecked")
trusted fun m5Pm1VbusMillivoltsCheckedHook(recv: int): I2cWordResult = M5Pm1(recv).vbusVoltageRaw()

@export("abla_m5pm1_batteryVoltageRaw")
trusted fun m5Pm1BatteryVoltageRawHook(recv: int): I2cWordResult =
    if (M5Pm1(recv).valid()) {
        M5Pm1(recv).device().readRegister16LittleEndianChecked(34)
    } else I2cWordResult(0)

@export("abla_m5pm1_output5VVoltageRaw")
trusted fun m5Pm1Output5VVoltageRawHook(recv: int): I2cWordResult =
    if (M5Pm1(recv).valid()) {
        M5Pm1(recv).device().readRegister16LittleEndianChecked(38)
    } else I2cWordResult(0)

@export("abla_m5pm1_vbusVoltageMillivolts")
trusted fun m5Pm1VbusVoltageMillivoltsHook(recv: int): int {
    val voltage = M5Pm1(recv).vbusVoltageRaw()
    if (voltage.valid()) voltage.value() else 0
}

@export("abla_m5pm1_batteryVoltageMillivolts")
trusted fun m5Pm1BatteryVoltageMillivoltsHook(recv: int): int {
    val voltage = M5Pm1(recv).batteryVoltageRaw()
    if (voltage.valid()) voltage.value() else 0
}

@export("abla_m5pm1_batteryMillivoltsChecked")
trusted fun m5Pm1BatteryMillivoltsCheckedHook(recv: int): I2cWordResult = M5Pm1(recv).batteryVoltageRaw()

@export("abla_m5pm1_output5VVoltageMillivolts")
trusted fun m5Pm1Output5VVoltageMillivoltsHook(recv: int): int {
    val voltage = M5Pm1(recv).output5VVoltageRaw()
    if (voltage.valid()) voltage.value() else 0
}

@export("abla_m5pm1_powerOff")
trusted fun m5Pm1PowerOffHook(recv: int): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().writeRegister8(12, 161)

// HOLD_CFG (0x07) bit5: keep the 3.3 V LDO on across power-off. The PM1
// clears HOLD_CFG on reset/download/shutdown; factory firmware clears the LDO
// hold explicitly before shutdown() so the board powers fully off.
@export("abla_m5pm1_setLdoPowerHold")
trusted fun m5Pm1SetLdoPowerHoldHook(recv: int, enabled: bool): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().updateRegister8(7, 32, if (enabled) 32 else 0)

// BTN_CFG_1 (0x49) bit0 SINGLE_RST_DIS. Enabled (false) by default: a single
// power-key press resets the board, or powers it on when off.
@export("abla_m5pm1_setSingleResetDisabled")
trusted fun m5Pm1SetSingleResetDisabledHook(recv: int, disabled: bool): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().updateRegister8(73, 1, if (disabled) 1 else 0)

// BTN_CFG_2 (0x4A) bit0 DOUBLE_OFF_DIS. Enabled (false) by default: a double
// press powers off in the PM1. When disabled, the double press is reported as
// a button IRQ (0x42 bit2) so firmware can shut down itself.
@export("abla_m5pm1_setDoubleOffDisabled")
trusted fun m5Pm1SetDoubleOffDisabledHook(recv: int, disabled: bool): bool =
    M5Pm1(recv).valid() && M5Pm1(recv).device().updateRegister8(74, 1, if (disabled) 1 else 0)

// I2C_CFG (0x09) bits3:0: idle-sleep timeout in seconds (0 = never). While
// asleep the PM1 NACKs the first transfer, which only wakes it; factory
// firmware therefore writes 0 at boot (twice, the first may only wake it).
@export("abla_m5pm1_setI2cSleepSeconds")
trusted fun m5Pm1SetI2cSleepSecondsHook(recv: int, seconds: int): bool =
    M5Pm1(recv).valid() && seconds >= 0 && seconds <= 15 && M5Pm1(recv).device().updateRegister8(9, 15, seconds)
