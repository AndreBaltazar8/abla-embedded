import "./measurement.ab"
import "../i2c/results.ab"
import "../runtime/integer_logic.ab"
// Already decoded AXP192 ADC counts: ACIN12-bit0.625mA, VBUS12-bit
// 0.375mA, battery13-bit0.5mA. Reject out-of-range codes before scaling.
fun axp192AcinMilliampsChecked(raw: I2cWordResult): PowerMeasurement =
    if (!raw.valid() || raw.value() > 4095) PowerMeasurement(0) else powerMeasurement(int((u32(raw.value())*u32(5))/u32(8)))
fun axp192VbusMilliampsChecked(raw: I2cWordResult): PowerMeasurement =
    if (!raw.valid() || raw.value() > 4095) PowerMeasurement(0) else powerMeasurement(int((u32(raw.value())*u32(3))/u32(8)))
fun axp192HalfMilliampChecked(raw: I2cWordResult): PowerMeasurement =
    if (!raw.valid() || raw.value() > 8191) PowerMeasurement(0) else powerMeasurement(int(u32(raw.value())/u32(2)))
// Datasheet battery-power ADC: count*1.1mV*0.5mA/1000 gives mW,
// i.e.11/20000, NOT11/20 (which would be microwatts). Max product fitsu32.
// https://m5stack.oss-cn-shenzhen.aliyuncs.com/resource/docs/datasheet/core/AXP192_datasheet_cn.pdf
fun axp192BatteryMilliwattsChecked(raw: I2cDwordResult): PowerMeasurement =
    if (!raw.valid() || raw.value() > 16777215) PowerMeasurement(0) else powerMeasurement(int((u32(raw.value())*u32(11))/u32(20000)))
// INA226 current register uses the configured nanoamp LSB retained in its
// scalar handle. Reject unconfigured readings; signed64 product cannot
// overflow within signed16 raw and positive31-bit LSB bounds.
fun ina226CurrentMilliampsChecked(raw: I2cWordResult,currentLsbNanoamps: int): PowerMeasurement {
    if (!raw.valid() || currentLsbNanoamps <= 0 || currentLsbNanoamps > 2147483647) return PowerMeasurement(0)
    powerMeasurement(int(freestandingSignedDivide(i64(raw.signedValue()*currentLsbNanoamps),i64(1000000))))
}
// Match Power_Class: truncate each positive AXP192 half-mA reading first,
// then choose negative discharge only when it exceeds charge (not a net sum).
fun axp192BatteryCurrentChecked(charge: I2cWordResult,discharge: I2cWordResult): PowerMeasurement {
    if (!charge.valid() || !discharge.valid()) return PowerMeasurement(0)
    // Low register bits7:5 are reserved, not part of either 13-bit ADC.
    val c=int((((u32(charge.value())>>u32(8))<<u32(5))|(u32(charge.value())&u32(31)))/u32(2))
    val d=int((((u32(discharge.value())>>u32(8))<<u32(5))|(u32(discharge.value())&u32(31)))/u32(2))
    powerMeasurement(if (c < d) -d else c)
}
// INA3221 shunt raw signed16 has5uV/LSB. Microvolts/milliohms is mA.
// Caller-supplied calibration must be positive; failed reads stay invalid.
fun ina3221CurrentMilliampsChecked(raw: I2cWordResult,shuntMilliohms: int): PowerMeasurement {
    if (!raw.valid() || shuntMilliohms <= 0 || shuntMilliohms > 1023) return PowerMeasurement(0)
    val current=freestandingSignedDivide(i64(raw.signedValue()*5),i64(shuntMilliohms))
    powerMeasurement(int(current))
}
