import "../esp32/sdk/raw_buffer.ab"
// Strict Unicode scalar decoder. Overlong forms, surrogates, invalid lead/
// continuation bytes and values above U+10FFFF are rejected. No allocation.
type Utf8Scalar=int
fun Utf8Scalar.valid(): bool = (this & (1<<24)) != 0
fun Utf8Scalar.value(): int = this & 0x1FFFFF
fun Utf8Scalar.bytes(): int = (this>>>21)&7
trusted fun utf8ScalarAt(input: NativeBuffer,offset: int,length: int): Utf8Scalar {
    if (offset < 0 || offset >= length || !input.hasAddressRange(0,length)) return Utf8Scalar(0)
    val lead=input.load(offset)
    val count=if (lead < 128) 1 else if (lead >= 194 && lead <= 223) 2 else if (lead >= 224 && lead <= 239) 3 else if (lead >= 240 && lead <= 244) 4 else 0
    if (count == 0 || count > length-offset) return Utf8Scalar(0)
    var value=lead & (if (count == 1) 127 else if (count == 2) 31 else if (count == 3) 15 else 7)
    var index=1
    while (index < count) {
        val next=input.load(offset+index)
        if ((next&192) != 128) return Utf8Scalar(0)
        value=(value<<6)|(next&63); index=index+1
    }
    if ((count == 2 && value < 128) || (count == 3 && value < 2048) || (count == 4 && value < 65536) ||
        value > 0x10FFFF || (value >= 0xD800 && value <= 0xDFFF)) return Utf8Scalar(0)
    Utf8Scalar((1<<24)|(count<<21)|value)
}
// Returns required UTF16 units, or-1. Empty input is valid (zero units).
trusted fun utf8Utf16Units(input: NativeBuffer,length: int): int {
    if (!input.hasAddressRange(0,length)) return -1
    var offset=0; var units=0
    while (offset < length) {
        val scalar=utf8ScalarAt(input,offset,length)
        if (!scalar.valid()) return -1
        units=units+(if (scalar.value() < 65536) 1 else 2)
        offset=offset+scalar.bytes()
    }
    units
}
// Caller keeps input immutable across both passes and exclusively owns output.
// UTF16LE without added NUL; embedded U+0000 is preserved. Failure leaves
// output unchanged, including malformed suffixes and insufficient capacity.
trusted fun utf8ToUtf16(input: NativeBuffer,length: int,output: NativeBuffer): int {
    val units=utf8Utf16Units(input,length)
    if (units < 0 || !output.hasAddressRange(0,units*2) ||
        (length > 0 && units > 0 && input.addressValue() < output.addressValue()+units*2 && output.addressValue() < input.addressValue()+length)) return -1
    var offset=0; var position=0
    while (offset < length) {
        val scalar=utf8ScalarAt(input,offset,length)
        val value=scalar.value()
        if (value < 65536) output.storeU16(position*2,value)
        else {
            output.storeU16(position*2,0xD800+((value-65536)>>>10))
            position=position+1
            output.storeU16(position*2,0xDC00+((value-65536)&1023))
        }
        position=position+1; offset=offset+scalar.bytes()
    }
    units
}
