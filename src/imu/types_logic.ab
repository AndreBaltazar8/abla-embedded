import "abla/float"

// Three signed 16-bit sensor samples and one validity bit fit in a single
// native Abla integer. Reading axes never allocates a tuple or wrapper object.
type ImuAxes = int
type ImuSample = int

val imuSpecNone = 0
val imuSpecAcceleration = 1
val imuSpecGyroscope = 2
val imuSpecMagneticField = 4

fun imuSigned16(value: int): int {
    val selected = value & 65535
    if (selected < 32768) selected else selected - 65536
}

fun imuAxes(x: int, y: int, z: int): ImuAxes = ImuAxes(
    (x & 65535) | ((y & 65535) << 16) | ((z & 65535) << 32) |
        (1 << 48)
)

fun invalidImuAxes(): ImuAxes = ImuAxes(0)
fun ImuAxes.valid(): bool = (this & (1 << 48)) != 0
fun ImuAxes.x(): int = imuSigned16(this)
fun ImuAxes.y(): int = imuSigned16(this >>> 16)
fun ImuAxes.z(): int = imuSigned16(this >>> 32)
fun ImuAxes.xScaled(scale: f64): f64 = f64FromInt(this.x()) * scale
fun ImuAxes.yScaled(scale: f64): f64 = f64FromInt(this.y()) * scale
fun ImuAxes.zScaled(scale: f64): f64 = f64FromInt(this.z()) * scale

fun imuSample(value: int): ImuSample = ImuSample(
    (value & 65535) | (1 << 16)
)

fun invalidImuSample(): ImuSample = ImuSample(0)
fun ImuSample.valid(): bool = (this & (1 << 16)) != 0
fun ImuSample.raw(): int = imuSigned16(this)
fun ImuSample.scaled(scale: f64, offset: f64 = 0.0): f64 =
    offset + f64FromInt(this.raw()) * scale

fun imuAxesBigEndianBytes(
    xHigh: int,
    xLow: int,
    yHigh: int,
    yLow: int,
    zHigh: int,
    zLow: int
): ImuAxes = imuAxes(
    (xHigh << 8) | xLow,
    (yHigh << 8) | yLow,
    (zHigh << 8) | zLow
)

fun imuAxesLittleEndianBytes(
    xLow: int,
    xHigh: int,
    yLow: int,
    yHigh: int,
    zLow: int,
    zHigh: int
): ImuAxes = imuAxes(
    xLow | (xHigh << 8),
    yLow | (yHigh << 8),
    zLow | (zHigh << 8)
)
