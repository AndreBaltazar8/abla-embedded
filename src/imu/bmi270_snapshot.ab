import "./bmi270_frame.ab"
import "./snapshot.ab"
// No I/O on invalid/overlapping buffers. Failed/empty acquisitions leave the
// published snapshot unchanged, even when I2C wrote a partial scratch prefix.
trusted fun ImuSnapshot.updateBmi270(device: I2cDevice,scratch: NativeBuffer,micros: int,capabilities: int=7): int {
    if (!this.valid() || !scratch.hasAddressRange(0,20) || (capabilities != 3 && capabilities != 7)) return -1
    val start=this.buffer().addressValue()
    if (scratch.addressValue() < start+44 && start < scratch.addressValue()+20) return -1
    val acquired=device.readBmi270Frame(scratch)
    if (acquired <= 0) return acquired
    val mask=acquired & capabilities
    if (mask == 0) return 0
    if (!this.commit(mask,bmi270FrameAxes(scratch,0),bmi270FrameAxes(scratch,1),bmi270FrameAxes(scratch,2),micros)) return -1
    mask
}
