import "./calibration.ab"

// Call once before acquisition. loadedOffsets must be the result of a checked
// complete load (never a partial read). No implicit NVS access or flash writes.
trusted fun ImuCalibration.prepareStartup(offsets: ImuOffsets,loadedOffsets: bool): bool {
    if (!this.acceptsOffsets(offsets)) return false
    this.clear()
    if (!loadedOffsets) offsets.clear()
    val strength=if (loadedOffsets) 0 else 255
    this.configureM5UnifiedDefaults(strength,strength,strength)
}
// Once seeded, startup's one-shot correction must not keep adapting offsets.
trusted fun ImuCalibration.finishStartupSamples(initialized: int): bool {
    if (!this.valid() || initialized < 0 || initialized > 7) return false
    var sensor=0
    while (sensor < 3) {
        if ((initialized & (1<<sensor)) != 0) this.setStrength(sensor,0)
        sensor=sensor+1
    }
    true
}
