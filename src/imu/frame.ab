import "./types_logic.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../i2c/results.ab"

// Caller owns14-byte snapshot storage and sensor throughout acquisition and
// decoding. Decode only after a successful readFrame; failed bus reads can
// leave partial bytes. One burst avoids separate accel/gyro transactions.
trusted fun I2cDevice.readImuFrame14(
    statusRegister: int,readyMask: int,dataRegister: int,destination: NativeBuffer
): int {
    if (statusRegister < 0 || statusRegister > 255 || readyMask < 1 || readyMask > 255 ||
        dataRegister < 0 || dataRegister > 242 || !destination.hasAddressRange(0,14)) return -1
    val status=this.readRegister8Checked(statusRegister)
    if (!status.valid()) return -2
    if ((status.value() & readyMask) == 0) return 0
    if (!this.readRegister(dataRegister,destination,14)) return -2
    imuSpecAcceleration | imuSpecGyroscope
}

trusted fun imuFrameSample(frame: NativeBuffer,offset: int,littleEndian: bool): ImuSample {
    if (offset < 0 || offset > 12 || !frame.hasAddressRange(0,14)) return invalidImuSample()
    val first=frame.load(offset)
    val second=frame.load(offset+1)
    imuSample(if (littleEndian) first | (second << 8) else (first << 8) | second)
}

trusted fun imuFrameAxes(frame: NativeBuffer,offset: int,littleEndian: bool): ImuAxes {
    if (offset < 0 || offset > 8 || !frame.hasAddressRange(0,14)) return invalidImuAxes()
    imuAxes(imuFrameSample(frame,offset,littleEndian).raw(),
        imuFrameSample(frame,offset+2,littleEndian).raw(),
        imuFrameSample(frame,offset+4,littleEndian).raw())
}
