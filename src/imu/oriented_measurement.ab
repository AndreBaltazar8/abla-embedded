import "./axis_order.ab"
import "./offsets.ab"
// Signed34-bit Q16 result plus validity bit34. Includes the full difference
// of signed16 raw<<16 and signed32 calibration, with lossless negation.
type ImuFixedSample = int
fun ImuFixedSample.valid(): bool = (this>>>34) == 1
fun ImuFixedSample.fixed(): int {
    val raw=this & 17179869183
    if ((raw & 8589934592) != 0) raw-17179869184 else raw
}
fun ImuFixedSample.scaled(scale: f64): f64 = f64FromInt(this.fixed())*(scale/65536.0)
// Offsets belong to physical sensor axes, before board/user reorientation.
// Caller owns a stable raw snapshot and offset storage across the read.
trusted fun ImuAxisOrder.correctedAxis(raw: ImuAxes,offsets: ImuOffsets,sensor: int,axis: int): ImuFixedSample {
    if (!this.valid() || !raw.valid() || !offsets.valid() || sensor < 0 || sensor > 2 || axis < 0 || axis > 2)
        return ImuFixedSample(0)
    val selector=this.selector(axis)
    val source=selector>>>1
    val corrected=imuCorrectedFixed(raw.axis(source),offsets.sensorAxis(sensor,source))
    val oriented=if ((selector & 1) == 0) corrected else -corrected
    ImuFixedSample((oriented & 17179869183) | (1<<34))
}
