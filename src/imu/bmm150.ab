import "./types.ab"
import "./bmm150_logic.ab"

type Bmm150 = int

trusted fun bmm150(bus: I2cBus): Bmm150 = Bmm150(
    if (bus.valid()) bus.device(16, 400000) & 4294967295 else 0
)

fun Bmm150.valid(): bool = this != 0
fun Bmm150.device(): I2cDevice = I2cDevice(this & 4294967295)
fun Bmm150.magneticFieldScale(): f64 = 49120.0 / 32760.0

trusted fun Bmm150.whoAmI(): int =
    if (this.valid()) this.device().readRegister8(64) else 0

trusted fun Bmm150.begin(): int {
    if (!this.valid() || !this.device().writeRegister8(75, 131)) {
        return imuSpecNone
    }
    imuDelay(1)
    // M5Unified intentionally performs one warm-up identity transaction.
    val warmIdentity = this.whoAmI()
    if (this.whoAmI() != 50) return imuSpecNone
    if (!this.device().writeRegister8(76, 56)) return imuSpecNone
    imuSpecMagneticField
}

trusted fun Bmm150.close(): bool =
    this.valid() && this.device().close()

trusted fun Bmm150.dataReady(): bool =
    this.valid() && (this.device().readRegister8(72) & 1) != 0

trusted fun Bmm150.readMagneticFieldRaw(): ImuAxes =
    if (this.valid()) bmm150DecodeMagneticField(
        this.device().readImuAxesLittleEndian(66)
    ) else invalidImuAxes()
