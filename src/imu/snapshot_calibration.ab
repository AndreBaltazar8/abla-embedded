import "./snapshot.ab"
import "./calibration.ab"

// Caller retains the returned initialized mask (start at0) only on success.
// Seed each channel once, from its first fresh sample; no-data preserves the
// mask, acquisition errors propagate. Configure strengths before calling:
// zero strength seeds filters without changing loaded persistent offsets.
trusted fun ImuCalibration.seedSnapshot(snapshot: ImuSnapshot,offsets: ImuOffsets,
    fresh: int,initialized: int=0): int {
    if (initialized < 0 || initialized > 7 || fresh > 7) return -1
    if (fresh < 0) return fresh
    if (!this.acceptsSnapshot(snapshot,offsets)) return -1
    val pending=fresh & ~initialized
    var sensor=0
    while (sensor < 3) {
        if ((pending & (1<<sensor)) != 0 && !snapshot.axes(sensor).valid()) return -1
        sensor=sensor+1
    }
    sensor=0
    while (sensor < 3) {
        if ((pending & (1<<sensor)) != 0) this.initializeSensor(sensor,snapshot.axes(sensor),offsets)
        sensor=sensor+1
    }
    initialized | pending
}

trusted fun ImuCalibration.acceptsSnapshot(snapshot: ImuSnapshot, offsets: ImuOffsets): bool {
    if (!this.valid() || !snapshot.valid() || !offsets.valid()) return false
    val state=this.buffer().addressValue()
    val samples=snapshot.buffer().addressValue()
    val correction=offsets.buffer().addressValue()
    !((state < samples+44 && samples < state+120) ||
        (state < correction+36 && correction < state+120) ||
        (samples < correction+36 && correction < samples+44))
}

// Pass the acquisition result exactly once, not the snapshot's populated mask.
// Zero and negative acquisition results never advance calibration. All callers
// serialize snapshot/calibration/offset access. No timestamp ordering assumption:
// micros can wrap and distinct acquisitions can have the same timestamp.
trusted fun ImuCalibration.updateSnapshot(
    snapshot: ImuSnapshot, offsets: ImuOffsets, fresh: int
): int {
    if (fresh <= 0) return fresh
    if (fresh > 7 || !this.acceptsSnapshot(snapshot,offsets)) return -1
    var sensor = 0
    var selected = 0
    // Validate every fresh channel before updating any calibration state.
    while (sensor < 3) {
        val bit = 1 << sensor
        if ((fresh & bit) != 0) {
            if (!snapshot.axes(sensor).valid()) return -1
            if (imuCalibrationStrength(this.buffer().loadU32(sensor * 40 + 36)) != 0) {
                selected = selected | bit
            }
        }
        sensor = sensor + 1
    }
    sensor = 0
    while (sensor < 3) {
        if ((selected & (1 << sensor)) != 0) {
            this.update(sensor, snapshot.axes(sensor), offsets)
        }
        sensor = sensor + 1
    }
    selected
}
