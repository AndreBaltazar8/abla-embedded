import "../runtime/integer_logic.ab"

fun imuCalibrationDivide(value: int, divisor: int): int =
    int(freestandingSignedDivide(i64(value), i64(divisor)))

fun imuIntegerSqrt(value: int): int {
    if (value <= 0) return 0
    var root = value
    var next = (root + imuCalibrationDivide(value, root)) / 2
    while (next < root) {
        root = next
        next = (root + imuCalibrationDivide(value, root)) / 2
    }
    root
}

fun imuCalibrationAbsolute(value: int): int =
    if (value < 0) -value else value

fun imuCalibrationAverage(previous: int, sample: int, shift: int): int {
    if (shift <= 0) return sample
    previous + ((sample - previous + (1 << (shift - 1))) >> shift)
}

fun imuCalibrationStillness(
    previous: int,
    noiseLevel: int,
    maximumDifferenceFixed: int
): int {
    if (noiseLevel <= 0) return 0
    val threshold = noiseLevel << 8
    val difference = maximumDifferenceFixed >> 8
    var score = 0
    if (threshold > difference) {
        score = imuCalibrationDivide((threshold - (difference + 1)) << 8, threshold)
    }
    val increased = if (previous < 255) previous + 1 else 255
    if (increased < score) increased else score
}

fun imuCalibrationDistance(
    xFixed: int,
    yFixed: int,
    zFixed: int
): int {
    val x = xFixed >> 16
    val y = yFixed >> 16
    val z = zFixed >> 16
    imuIntegerSqrt(x * x + y * y + z * z)
}

// Compute rounded value*factor/divisor without forming the overflowing
// product. Inputs here are positive calibration magnitudes. Splitting factor
// into quotient/remainder bounds each remainder step below 3*divisor.
fun imuCalibrationMultiplyDivide(value: int,factor: int,divisor: int): int {
    val whole=imuCalibrationDivide(factor,divisor)
    val fraction=factor-whole*divisor
    var quotient=0
    var remainder=0
    var bit=62
    while (bit >= 0) {
        quotient=quotient*2
        remainder=remainder*2
        if (((value>>>bit)&1) != 0) {
            quotient=quotient+whole
            remainder=remainder+fraction
        }
        if (remainder >= divisor) { remainder=remainder-divisor; quotient=quotient+1 }
        if (remainder >= divisor) { remainder=remainder-divisor; quotient=quotient+1 }
        bit=bit-1
    }
    if (remainder >= (divisor+1)/2) quotient+1 else quotient
}

fun imuCalibrationDelta(
    differenceFixed: int,
    signedForce: int,
    stillness: int,
    strength: int,
    distance: int
): int {
    if (signedForce == 0 || stillness == 0 || strength == 0 ||
        distance <= 0) return 0
    val denominator = distance * 65025
    val magnitude=imuCalibrationMultiplyDivide(imuCalibrationAbsolute(differenceFixed),
        imuCalibrationAbsolute(signedForce)*stillness*strength,denominator)
    if ((differenceFixed < 0) != (signedForce < 0)) -magnitude else magnitude
}

fun imuCalibrationMetadata(
    averageShift: int,
    stillness: int,
    strength: int
): int = (averageShift & 255) | ((stillness & 255) << 8) |
    ((strength & 255) << 16)

fun imuCalibrationAverageShift(metadata: int): int = metadata & 255
fun imuCalibrationStillnessValue(metadata: int): int = (metadata >>> 8) & 255
fun imuCalibrationStrength(metadata: int): int = (metadata >>> 16) & 255
