import "./offsets_storage_sequence.ab"
import "../esp32/nvs_idf6.ab"
@inline
trusted fun imuOffsetStorageRead(handle: int,index: int,scratch: NativeBuffer,offset: int): bool {
    val value=NvsNamespace(handle).getI32(imuOffsetKey(index))
    value.valid() && scratch.storeU32(offset,value.value())
}
@inline
trusted fun imuOffsetStorageWrite(handle: int,index: int,value: int): bool =
    NvsNamespace(handle).setI32(imuOffsetKey(index),value)
@inline
trusted fun imuOffsetStorageCommit(handle: int): bool = NvsNamespace(handle).commit()
trusted fun ImuOffsets.loadFromNvsWithBuffer(scratch: NativeBuffer,namespaceName: string = "M5Unified"): bool {
    if (!this.valid() || !scratch.hasAddressRange(0,36)) return false
    val destination=this.buffer().addressValue()
    if (destination < scratch.addressValue()+36 && scratch.addressValue() < destination+36) return false
    val namespace=nvsOpen(namespaceName)
    if (!namespace.valid()) return false
    val loaded=this.loadStorage(namespace | 0,scratch)
    namespace.close()
    loaded
}
trusted fun ImuOffsets.loadFromNvs(namespaceName: string = "M5Unified"): bool =
    this.loadFromNvsWithBuffer(nativeBufferAt(nativeStackAllocate(36),36),namespaceName)
trusted fun ImuOffsets.saveToNvs(namespaceName: string = "M5Unified"): bool {
    if (!this.valid()) return false
    val namespace=nvsOpen(namespaceName,true)
    if (!namespace.valid()) return false
    val saved=this.saveStorage(namespace | 0)
    namespace.close()
    saved
}
