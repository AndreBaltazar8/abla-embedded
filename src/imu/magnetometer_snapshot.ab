import "./snapshot.ab"
import "./bmm150_logic.ab"
import "../i2c/results.ab"
//4 fresh,0 notready,-1arguments,-2transport,-3AK8963overflow.
// Always read AK8963 ST2 in the8-byte burst, including on not-ready samples.
// Caller owns snapshot and disjoint scratch throughout acquisition/publication.
trusted fun ImuSnapshot.updateMagnetometer(device: I2cDevice,scratch: NativeBuffer,micros: int,ak8963: bool): int {
    val count=if (ak8963) 8 else 6
    if (!this.valid() || !scratch.hasAddressRange(0,count)) return -1
    val start=this.buffer().addressValue()
    if (scratch.addressValue() < start+44 && start < scratch.addressValue()+count) return -1
    if (!ak8963) {
        val status=device.readRegister8Checked(72)
        if (!status.valid()) return -2
        if ((status.value() & 1) == 0) return 0
    }
    if (!device.readRegister(if (ak8963) 2 else 66,scratch,count)) return -2
    if (ak8963) {
        if ((scratch.load(7) & 8) != 0) return -3
        if ((scratch.load(0) & 1) == 0) return 0
    }
    val offset=if (ak8963) 1 else 0
    val raw=imuAxes(scratch.loadU16(offset),scratch.loadU16(offset+2),scratch.loadU16(offset+4))
    val axes=if (ak8963) raw else bmm150DecodeMagneticField(raw)
    if (!this.commit(4,invalidImuAxes(),invalidImuAxes(),axes,micros)) return -1
    4
}
trusted fun ImuSnapshot.updateAk8963(device: I2cDevice,scratch: NativeBuffer,micros: int): int =
    this.updateMagnetometer(device,scratch,micros,true)
trusted fun ImuSnapshot.updateBmm150(device: I2cDevice,scratch: NativeBuffer,micros: int): int =
    this.updateMagnetometer(device,scratch,micros,false)
