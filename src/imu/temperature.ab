import "./types_logic.ab"
// Signed millidegrees Celsius, validitybit32; no allocation or float runtime.
// Millidegree representation is not a claim of millidegree sensor accuracy.
type ImuTemperature=int
fun ImuTemperature.valid(): bool = (this>>>32) == 1
fun ImuTemperature.milliCelsius(): int = int(i32(u32(this&0xffffffff)))
// BMI270 datasheet TEMPERATURE_0/1:23C + signedraw/512;0x8000 invalid.
// Truncate the final Celsius value toward zero at one millidegree, using
// bounded32-bit arithmetic so RV32 needs no64-bit division helper.
fun bmi270Temperature(sample: ImuSample): ImuTemperature {
    if (!sample.valid() || sample.raw() == -32768) return ImuTemperature(0)
    val value=(i32(sample.raw())*i32(125)+i32(1472000))/i32(64)
    return ImuTemperature(4294967296|int(u32(value)))
}
// M5Unified MPU-family calibration:25C + signedraw/326.8.
// Exact decimal ratio, truncating final Celsius toward zero at one mC.
fun mpu6886Temperature(sample: ImuSample): ImuTemperature {
    if (!sample.valid()) return ImuTemperature(0)
    val value=(i32(sample.raw())*i32(10000)+i32(81700000))/i32(3268)
    return ImuTemperature(4294967296|int(u32(value)))
}
// SH200Q:21C + signedraw/333.87. The signed numerator exceeds i32,
// but its magnitude fits u32 for every signed16 sample. Divide at that width
// to avoid a 64-bit division helper on RV32; preserve truncation across zero.
fun sh200qTemperature(sample: ImuSample): ImuTemperature {
    if (!sample.valid()) return ImuTemperature(0)
    val numerator=sample.raw()*100000+701127000
    val magnitude=u32(if (numerator < 0) -numerator else numerator)/u32(33387)
    val value=if (numerator < 0) -int(magnitude) else int(magnitude)
    return ImuTemperature(4294967296|int(u32(value)))
}
