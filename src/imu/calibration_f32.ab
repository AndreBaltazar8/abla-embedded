import "../math/sqrt_f32.ab"
import "../esp32/runtime/libgcc_divsf3_esp32.ab"

// Q16 differences span signed33 bits. Convert their unsigned magnitude rather
// than truncating through i32; the upstream signed subtraction can overflow.
fun imuCalibrationFloatDifference(value: int): f32 {
    val magnitude=f32FromU32(u32(if (value < 0) -value else value))
    if (value < 0) -magnitude else magnitude
}
trusted fun imuCalibrationFloatGainWithLimits(dx: int,dy: int,dz: int,radius: f32,
    tolerance: f32,stillness: int,strength: int): f32 {
    val zero=f32FromBits(u32(0))
    if (stillness == 0 || strength == 0) return zero
    val x=imuCalibrationFloatDifference(dx)
    val y=imuCalibrationFloatDifference(dy)
    val z=imuCalibrationFloatDifference(dz)
    val distance=sqrtF32(((x*x+y*y)+z*z)*f32FromBits(u32(0x2f800000)))
    if (distance < f32FromBits(u32(0x3f800000))) return zero
    val error=distance-radius
    // Magnitude is nonnegative; compare its exact binary32 bits to avoid a
    // boxed conditional-value comparison in the current compiler lowering.
    val forceBits=f32ToBits(error) & u32(2147483647)
    if ((f32ToBits(tolerance)&u32(2147483648)) == u32(0) && forceBits <= f32ToBits(tolerance)) return zero
    val numerator=error*f32FromI32(i32(stillness*strength))
    val denominator=distance*f32FromI32(i32(65025))
    f32FromBits(esp32Binary32Divide(f32ToBits(numerator),f32ToBits(denominator)))
}
trusted fun imuCalibrationFloatGain(dx: int,dy: int,dz: int,radius: int,
    tolerance: int,stillness: int,strength: int): f32 =
    imuCalibrationFloatGainWithLimits(dx,dy,dz,f32FromI32(i32(radius)),f32FromI32(i32(tolerance)),stillness,strength)
// Finite calibration results fit int64. Integer decoding implements roundf's
// halfway-away-from-zero rule without a libm call or an overflowing i32 cast.
fun imuCalibrationFloatRound(value: f32): int {
    val bits=int(f32ToBits(value))
    val exponent=((bits>>>23)&255)-127
    if (exponent < -1) return 0
    val mantissa=(bits & 8388607)|8388608
    var magnitude=0
    if (exponent >= 23) magnitude=mantissa<<(exponent-23)
    else {
        val shift=23-exponent
        magnitude=(mantissa+(1<<(shift-1)))>>>shift
    }
    if ((bits & 2147483648) != 0) -magnitude else magnitude
}
fun imuCalibrationFloatDelta(difference: int,gain: f32): int =
    imuCalibrationFloatRound(imuCalibrationFloatDifference(difference)*gain)

fun imuCalibrationRoundFloat(value: f32): f32 {
    val bits=int(f32ToBits(value))
    val magnitude=bits & 2147483647
    val sign=bits & 2147483648
    val exponent=(magnitude>>>23)-127
    if (exponent >= 23) return value
    if (exponent < -1) return f32FromBits(u32(sign))
    if (exponent == -1) return f32FromBits(u32(sign|1065353216))
    val mask=(1<<(23-exponent))-1
    f32FromBits(u32(sign|((magnitude+(1<<(22-exponent))) & ~mask)))
}
// C's offset += roundf(delta) converts the OLD offset to binary32 too.
// Integer addition of rounded delta is not equivalent above 2^24.
fun imuCalibrationFloatOffset(offset: int,difference: int,gain: f32): int {
    if ((f32ToBits(gain)&u32(2147483647)) == u32(0)) return offset
    val rounded=imuCalibrationRoundFloat(imuCalibrationFloatDifference(difference)*gain)
    imuCalibrationFloatRound(f32FromI32(i32(offset))+rounded)
}
