import "./frame.ab"
import "./snapshot.ab"
// Both14-byte layouts are decoded from private scratch before publication.
// Snapshot tracks the three vector sensors; temperature remains in the frame.
trusted fun ImuSnapshot.updateFrame14(device: I2cDevice,scratch: NativeBuffer,micros: int,sh200q: bool): int {
    if (!this.valid() || !scratch.hasAddressRange(0,14)) return -1
    val start=this.buffer().addressValue()
    if (scratch.addressValue() < start+44 && start < scratch.addressValue()+14) return -1
    val fresh=device.readImuFrame14(if (sh200q) 44 else 58,if (sh200q) 32 else 1,if (sh200q) 0 else 59,scratch)
    if (fresh <= 0) return fresh
    val accel=imuFrameAxes(scratch,0,sh200q)
    val gyro=imuFrameAxes(scratch,if (sh200q) 6 else 8,sh200q)
    if (!this.commit(fresh,accel,gyro,invalidImuAxes(),micros)) return -1
    fresh
}
trusted fun ImuSnapshot.updateMpu6886(device: I2cDevice,scratch: NativeBuffer,micros: int): int =
    this.updateFrame14(device,scratch,micros,false)
trusted fun ImuSnapshot.updateSh200q(device: I2cDevice,scratch: NativeBuffer,micros: int): int =
    this.updateFrame14(device,scratch,micros,true)
