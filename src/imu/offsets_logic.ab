val imuOffsetCount = 9
val imuOffsetStorageBytes = 36

fun imuOffsetIndex(sensor: int, axis: int): int =
    if (sensor < 0 || sensor > 2 || axis < 0 || axis > 2) -1
    else sensor * 3 + axis

fun imuOffsetKey(index: int): string {
    if (index == 0) "ax"
    else if (index == 1) "ay"
    else if (index == 2) "az"
    else if (index == 3) "gx"
    else if (index == 4) "gy"
    else if (index == 5) "gz"
    else if (index == 6) "mx"
    else if (index == 7) "my"
    else if (index == 8) "mz"
    else ""
}

fun imuSigned32(value: int): int {
    val bits = value & 4294967295
    if (bits < 2147483648) bits else bits - 4294967296
}

// M5Unified stores every correction as a signed Q16 raw-sensor value.
fun imuCorrectedFixed(raw: int, offset: int): int =
    (raw << 16) - offset
