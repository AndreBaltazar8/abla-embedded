import "./types_logic.ab"
import "./bmm150_logic.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../i2c/results.ab"
// One status read and one20-byte burst from AUX_X_LSB through gyro Z.
// Result is freshness mask1accel/2gyro/4mag,0notready,-1badbuffer,-2I/O.
// Destination is scratch until success: a failed transfer may write a prefix.
trusted fun I2cDevice.readBmi270Frame(destination: NativeBuffer): int {
    if (!destination.hasAddressRange(0,20)) return -1
    val status=this.readRegister8Checked(29)
    if (!status.valid()) return -2
    val bits=status.value()
    val mask=(if ((bits & 128) != 0) 1 else 0) | (if ((bits & 64) != 0) 2 else 0) | (if ((bits & 32) != 0) 4 else 0)
    if (mask == 0) return 0
    if (!this.readRegister(4,destination,20)) return -2
    mask
}
// Decode only channels marked fresh by a successful readBmi270Frame.
trusted fun bmi270FrameAxes(frame: NativeBuffer,sensor: int): ImuAxes {
    if (!frame.hasAddressRange(0,20) || sensor < 0 || sensor > 2) return invalidImuAxes()
    val offset=if (sensor == 0) 8 else if (sensor == 1) 14 else 0
    val axes=imuAxes(frame.loadU16(offset),frame.loadU16(offset+2),frame.loadU16(offset+4))
    if (sensor == 2) bmm150DecodeMagneticField(axes) else axes
}
