import "./types.ab"

type Ak8963 = int

trusted fun ak8963(bus: I2cBus): Ak8963 = Ak8963(
    if (bus.valid()) bus.device(12, 400000) & 4294967295 else 0
)

fun Ak8963.valid(): bool = this != 0
fun Ak8963.device(): I2cDevice = I2cDevice(this & 4294967295)
fun Ak8963.magneticFieldScale(): f64 = 49120.0 / 32760.0

trusted fun Ak8963.whoAmI(): int =
    if (this.valid()) this.device().readRegister8(0) else 0

trusted fun Ak8963.begin(): int {
    if (!this.valid()) return imuSpecNone
    val device = this.device()
    if (!device.writeRegister8(10, 0)) return imuSpecNone
    imuDelay(10)
    if (!device.writeRegister8(10, 15)) return imuSpecNone
    imuDelay(10)
    val calibrationAddress = nativeStackAllocate(3)
    val calibration = nativeBufferAt(calibrationAddress, 3)
    if (!device.readRegister(16, calibration, 3)) return imuSpecNone
    if (!device.writeRegister8(10, 0)) return imuSpecNone
    imuDelay(10)
    if (!device.writeRegister8(10, 22)) return imuSpecNone
    if (this.whoAmI() != 72) return imuSpecNone
    imuSpecMagneticField
}

trusted fun Ak8963.close(): bool =
    this.valid() && this.device().close()

trusted fun Ak8963.dataReady(): bool =
    this.valid() && (this.device().readRegister8(2) & 1) != 0

trusted fun Ak8963.readMagneticFieldRaw(): ImuAxes {
    if (!this.valid()) return invalidImuAxes()
    val address = nativeStackAllocate(8)
    val bytes = nativeBufferAt(address, 8)
    if (!this.device().readRegister(2, bytes, 8) ||
        (bytes.load(0) & 1) == 0 || (bytes.load(7) & 8) != 0) {
        return invalidImuAxes()
    }
    imuAxesLittleEndianBytes(
        bytes.load(1), bytes.load(2), bytes.load(3),
        bytes.load(4), bytes.load(5), bytes.load(6)
    )
}
