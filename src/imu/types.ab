import "../esp32/i2c_idf6.ab"
import "../esp32/sdk/buffer.ab"
import "../esp32/task.ab"
import "./types_logic.ab"
import "abla/unsafe/memory"

trusted fun I2cDevice.readImuAxesBigEndian(register: int): ImuAxes {
    val address = nativeStackAllocate(6)
    val bytes = nativeBufferAt(address, 6)
    if (!this.readRegister(register, bytes, 6)) return invalidImuAxes()
    imuAxesBigEndianBytes(
        bytes.load(0), bytes.load(1), bytes.load(2),
        bytes.load(3), bytes.load(4), bytes.load(5)
    )
}

trusted fun I2cDevice.readImuAxesLittleEndian(register: int): ImuAxes {
    val address = nativeStackAllocate(6)
    val bytes = nativeBufferAt(address, 6)
    if (!this.readRegister(register, bytes, 6)) return invalidImuAxes()
    imuAxesLittleEndianBytes(
        bytes.load(0), bytes.load(1), bytes.load(2),
        bytes.load(3), bytes.load(4), bytes.load(5)
    )
}

trusted fun I2cDevice.readImuSampleBigEndian(register: int): ImuSample {
    val address = nativeStackAllocate(2)
    val bytes = nativeBufferAt(address, 2)
    if (!this.readRegister(register, bytes, 2)) return invalidImuSample()
    imuSample((bytes.load(0) << 8) | bytes.load(1))
}

trusted fun I2cDevice.readImuSampleLittleEndian(register: int): ImuSample {
    val address = nativeStackAllocate(2)
    val bytes = nativeBufferAt(address, 2)
    if (!this.readRegister(register, bytes, 2)) return invalidImuSample()
    imuSample(bytes.load(0) | (bytes.load(1) << 8))
}

trusted fun imuDelay(ticks: int): void {
    taskDelay(ticks)
    return
}
