import "./types_logic.ab"
// Signed source axes: +X=0,-X=1,+Y=2,-Y=3,+Z=4,-Z=5.
// Three3-bit selectors plus validity bit9, no allocation or mutable singleton.
type ImuAxisOrder = int
val imuAxisX=0
val imuAxisNegativeX=1
val imuAxisY=2
val imuAxisNegativeY=3
val imuAxisZ=4
val imuAxisNegativeZ=5
fun imuAxisOrder(x: int,y: int,z: int): ImuAxisOrder {
    if (x < 0 || x > 5 || y < 0 || y > 5 || z < 0 || z > 5 ||
        (x>>>1) == (y>>>1) || (x>>>1) == (z>>>1) || (y>>>1) == (z>>>1)) return ImuAxisOrder(0)
    ImuAxisOrder(512 | x | (y<<3) | (z<<6))
}
fun ImuAxisOrder.selector(axis: int): int = if (axis < 0 || axis > 2) -1 else int((u32(this | 0)>>>u32(axis*3)) & u32(7))
fun ImuAxisOrder.valid(): bool = (this>>>9) == 1 &&
    imuAxisOrder(this.selector(0),this.selector(1),this.selector(2)) == this
fun imuAxisOrderRightHanded(x: int,y: int): ImuAxisOrder {
    if (x < 0 || x > 5 || y < 0 || y > 5 || (x>>>1) == (y>>>1)) return ImuAxisOrder(0)
    val first=x>>>1; val second=y>>>1
    val third=3-first-second
    val negative=(if ((first+1)%3 == second) 0 else 1) ^ (x & 1) ^ (y & 1)
    imuAxisOrder(x,y,(third<<1)|negative)
}
fun imuAxisOrderLeftHanded(x: int,y: int): ImuAxisOrder {
    val right=imuAxisOrderRightHanded(x,y)
    if (!right.valid()) return ImuAxisOrder(0)
    imuAxisOrder(x,y,right.selector(2)^1)
}
// Apply this mapping first, then the caller's mapping (board then user).
fun ImuAxisOrder.then(next: ImuAxisOrder): ImuAxisOrder {
    if (!this.valid() || !next.valid()) return ImuAxisOrder(0)
    val x=next.selector(0); val y=next.selector(1); val z=next.selector(2)
    imuAxisOrder(this.selector(x>>>1) ^ (x & 1),
        this.selector(y>>>1) ^ (y & 1),this.selector(z>>>1) ^ (z & 1))
}
// Caller checks both values' validity. Return a full integer, not a packed
// i16: negating -32768 must yield +32768 rather than wrap back to negative.
fun ImuAxisOrder.rawAxis(value: ImuAxes,axis: int): int {
    if (!this.valid() || !value.valid() || axis < 0 || axis > 2) return 0
    val selected=this.selector(axis)
    val raw=value.axis(selected>>>1)
    if ((selected & 1) == 0) raw else -raw
}
