import "./types_logic.ab"
import "../esp32/sdk/raw_buffer.ab"
//44 bytes: magic0, populated mask4, three {axes64,time32} records at8.
// Caller serializes initialization, updates and readers; not a lock-free API.
type ImuSnapshot = int
fun imuSnapshotAt(storage: NativeBuffer): ImuSnapshot =
    if (!storage.hasAddressRange(0,44) || (storage.addressValue() & 3) != 0) ImuSnapshot(0) else ImuSnapshot(storage | 0)
fun ImuSnapshot.buffer(): NativeBuffer = NativeBuffer(this | 0)
trusted fun ImuSnapshot.initialize(): bool {
    val bytes=this.buffer()
    if (!bytes.hasAddressRange(0,44) || (bytes.addressValue() & 3) != 0) return false
    var offset=4
    while (offset < 44) { bytes.storeU32(offset,0); offset=offset+4 }
    bytes.storeU32(0,0x494D5531)
}
trusted fun ImuSnapshot.valid(): bool = this.buffer().hasAddressRange(0,44) &&
    (this.buffer().addressValue() & 3) == 0 && this.buffer().loadU32(0) == 0x494D5531 && this.buffer().loadU32(4) <= 7
trusted fun ImuSnapshot.has(sensor: int): bool = sensor >= 0 && sensor < 3 && this.valid() &&
    (u32(this.buffer().loadU32(4)) & (u32(1)<<u32(sensor))) != u32(0)
trusted fun ImuSnapshot.axes(sensor: int): ImuAxes {
    if (!this.has(sensor)) return invalidImuAxes()
    val offset=8+sensor*12
    ImuAxes(this.buffer().loadU32(offset) | (this.buffer().loadU32(offset+4)<<32))
}
trusted fun ImuSnapshot.timestamp(sensor: int): int =
    if (this.has(sensor)) this.buffer().loadU32(16+sensor*12) else 0
// Prevalidate every selected sample before changing any record. Untouched
// sensors preserve both value and timestamp. Timestamp uses micros' u32 wrap.
trusted fun ImuSnapshot.commit(mask: int,accel: ImuAxes,gyro: ImuAxes,mag: ImuAxes,micros: int): bool {
    if (!this.valid() || mask < 0 || mask > 7 ||
        ((mask & 1) != 0 && !accel.valid()) || ((mask & 2) != 0 && !gyro.valid()) ||
        ((mask & 4) != 0 && !mag.valid())) return false
    var sensor=0
    while (sensor < 3) {
        if ((u32(mask) & (u32(1)<<u32(sensor))) != u32(0)) {
            val value=if (sensor == 0) accel else if (sensor == 1) gyro else mag
            val offset=8+sensor*12
            this.buffer().storeU32(offset,value & 0xFFFFFFFF)
            this.buffer().storeU32(offset+4,value>>>32)
            this.buffer().storeU32(offset+8,micros & 0xFFFFFFFF)
        }
        sensor=sensor+1
    }
    this.buffer().storeU32(4,this.buffer().loadU32(4)|mask)
}
