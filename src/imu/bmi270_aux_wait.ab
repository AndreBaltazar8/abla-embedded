// Failed status reads are not evidence that the auxiliary bus is idle.
// Preserve the existing three-poll bound and one-tick wait per busy result.
trusted fun I2cDevice.waitBmi270AuxiliaryReady(): bool {
    var retries=3
    while (retries > 0) {
        val status=this.readRegister8Checked(3)
        if (!status.valid()) return false
        if ((status.value() & 4) == 0) return true
        imuDelay(1)
        retries=retries-1
    }
    false
}
