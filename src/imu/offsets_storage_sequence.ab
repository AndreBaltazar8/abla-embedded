import "./offsets.ab"
// Borrowed namespace: caller closes it. Failed reads never publish partial
// offsets; scratch may change. Caller serializes all buffer access.
trusted fun ImuOffsets.loadStorage(handle: int,scratch: NativeBuffer): bool {
    if (handle == 0 || !this.valid() || !scratch.hasAddressRange(0,36)) return false
    val destination=this.buffer().addressValue()
    val pending=scratch.addressValue()
    if (destination < pending+36 && pending < destination+36) return false
    var index=0
    while (index < 9) {
        if (!imuOffsetStorageRead(handle,index,scratch,index*4)) return false
        index=index+1
    }
    index=0
    while (index < 9) {
        this.set(index,imuSigned32(scratch.loadU32(index*4)))
        index=index+1
    }
    true
}
// Individual NVS writes are not transactional. Failure may leave some saved
// keys changed; report it and never claim rollback.
trusted fun ImuOffsets.saveStorage(handle: int): bool {
    if (handle == 0 || !this.valid()) return false
    var index=0
    while (index < 9) {
        if (!imuOffsetStorageWrite(handle,index,this.get(index))) return false
        index=index+1
    }
    imuOffsetStorageCommit(handle)
}
