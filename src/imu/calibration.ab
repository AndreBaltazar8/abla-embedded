import "./types_logic.ab"
import "./offsets.ab"
import "./calibration_logic.ab"
import "./calibration_f32.ab"
import "../esp32/sdk/raw_buffer.ab"
import "abla/unsafe/memory/raw"

type ImuCalibration = int

val imuCalibrationSensorBytes = 40
val imuCalibrationStorageBytes = 120

trusted fun imuCalibrationAt(address: int): ImuCalibration = ImuCalibration(
    (address & 4294967295) | (imuCalibrationStorageBytes << 32)
)

trusted fun imuCalibration(): ImuCalibration =
    imuCalibrationAt(nativeStaticAllocate(120))

fun ImuCalibration.buffer(): NativeBuffer = NativeBuffer(
    this & 9223372036854775807
)

fun ImuCalibration.valid(): bool =
    this.buffer().hasAddressRange(0, imuCalibrationStorageBytes)

// State and persistent offsets must remain separate even for direct calls.
// Reject before seeding/filter writes, not only when correction is published.
fun ImuCalibration.acceptsOffsets(offsets: ImuOffsets): bool {
    if (!this.valid() || !offsets.valid()) return false
    val state=this.buffer().addressValue();val data=offsets.buffer().addressValue()
    return !(state < data+36 && data < state+120)
}

fun imuCalibrationSensorOffset(sensor: int): int =
    if (sensor < 0 || sensor > 2) -1 else sensor * imuCalibrationSensorBytes

trusted fun ImuCalibration.clear(): void {
    if (this.valid()) nativeAddressClear(
        this.buffer().addressValue(), imuCalibrationStorageBytes
    )
    return
}

trusted fun ImuCalibration.configure(
    sensor: int,
    radius: int,
    tolerance: int,
    noiseLevel: int,
    averageShift: int,
    strength: int
): bool = this.configureFloat(sensor,f32FromI32(i32(radius)),f32FromI32(i32(tolerance)),noiseLevel,averageShift,strength)

// Radius/tolerance remain binary32 like M5Unified; persisted offsets remain
// signed Q16 integers. Reject nonfinite limits before modifying state.
trusted fun ImuCalibration.configureFloat(sensor: int,radius: f32,tolerance: f32,
    noiseLevel: int,averageShift: int,strength: int): bool {
    val base = imuCalibrationSensorOffset(sensor)
    if (!this.valid() || base < 0 ||
        (f32ToBits(radius)&u32(0x7fffffff)) >= u32(0x7f800000) ||
        (f32ToBits(tolerance)&u32(0x7fffffff)) >= u32(0x7f800000)) return false
    val buffer = this.buffer()
    buffer.storeU32(base + 24, int(f32ToBits(radius)))
    buffer.storeU32(base + 28, int(f32ToBits(tolerance)))
    buffer.storeU32(base + 32, noiseLevel)
    buffer.storeU32(
        base + 36,
        imuCalibrationMetadata(averageShift, 0, strength)
    )
}

trusted fun ImuCalibration.configureM5UnifiedDefaults(
    accelStrength: int = 0,
    gyroStrength: int = 0,
    magneticStrength: int = 0
): bool {
    val scale=esp32Binary32Divide(f32ToBits(f32FromI32(i32(49120))),f32ToBits(f32FromI32(i32(32760))))
    val radius=f32FromBits(esp32Binary32Divide(f32ToBits(f32FromI32(i32(384))),scale))
    val tolerance=f32FromBits(esp32Binary32Divide(f32ToBits(f32FromI32(i32(64))),scale))
    this.configure(0,4096,2,256,1,accelStrength) &&
        this.configure(1,0,0,32,6,gyroStrength) &&
        this.configureFloat(2,radius,tolerance,64,1,magneticStrength)
}

trusted fun ImuCalibration.setStrength(sensor: int, strength: int): bool {
    val base = imuCalibrationSensorOffset(sensor)
    if (!this.valid() || base < 0) return false
    val buffer = this.buffer()
    val metadata = buffer.loadU32(base + 36)
    buffer.storeU32(
        base + 36,
        imuCalibrationMetadata(
            imuCalibrationAverageShift(metadata),
            imuCalibrationStillnessValue(metadata),
            strength
        )
    )
}

trusted fun ImuCalibration.initializeSensor(
    sensor: int,
    axes: ImuAxes,
    offsets: ImuOffsets
): bool {
    val base = imuCalibrationSensorOffset(sensor)
    if (!this.acceptsOffsets(offsets) || base < 0 || !axes.valid()) {
        return false
    }
    val buffer = this.buffer()
    var axis = 0
    while (axis < 3) {
        val fixed = axes.axis(axis) << 16
        buffer.storeU32(base + axis * 4, fixed)
        buffer.storeU32(base + 12 + axis * 4, fixed)
        axis = axis + 1
    }
    val metadata = buffer.loadU32(base + 36)
    buffer.storeU32(
        base + 36,
        imuCalibrationMetadata(
            imuCalibrationAverageShift(metadata), 255,
            imuCalibrationStrength(metadata)
        )
    )
    this.calibrateSensor(sensor, offsets)
    true
}

trusted fun ImuCalibration.calibrateSensor(
    sensor: int,
    offsets: ImuOffsets
): bool {
    val base = imuCalibrationSensorOffset(sensor)
    if (!this.acceptsOffsets(offsets) || base < 0) return false
    val buffer = this.buffer()
    val metadata = buffer.loadU32(base + 36)
    val stillness = imuCalibrationStillnessValue(metadata)
    val strength = imuCalibrationStrength(metadata)
    if (stillness == 0 || strength == 0) return false
    val dx = imuSigned32(buffer.loadU32(base)) - offsets.sensorAxis(sensor, 0)
    val dy = imuSigned32(buffer.loadU32(base + 4)) -
        offsets.sensorAxis(sensor, 1)
    val dz = imuSigned32(buffer.loadU32(base + 8)) -
        offsets.sensorAxis(sensor, 2)
    val radius = f32FromBits(u32(buffer.loadU32(base + 24)))
    val tolerance = f32FromBits(u32(buffer.loadU32(base + 28)))
    val gain=imuCalibrationFloatGainWithLimits(dx,dy,dz,radius,tolerance,stillness,strength)
    if ((f32ToBits(gain) & u32(2147483647)) == u32(0)) return false
    offsets.setSensorAxis(
        sensor, 0, imuCalibrationFloatOffset(offsets.sensorAxis(sensor,0),dx,gain)
    )
    offsets.setSensorAxis(
        sensor, 1, imuCalibrationFloatOffset(offsets.sensorAxis(sensor,1),dy,gain)
    )
    offsets.setSensorAxis(
        sensor, 2, imuCalibrationFloatOffset(offsets.sensorAxis(sensor,2),dz,gain)
    )
    true
}

trusted fun ImuCalibration.update(
    sensor: int,
    axes: ImuAxes,
    offsets: ImuOffsets
): int {
    val base = imuCalibrationSensorOffset(sensor)
    if (!this.acceptsOffsets(offsets) || base < 0 || !axes.valid()) {
        return 0
    }
    val buffer = this.buffer()
    val metadata = buffer.loadU32(base + 36)
    val shift = imuCalibrationAverageShift(metadata)
    var maximumDifference = 0
    var axis = 0
    while (axis < 3) {
        val fixed = axes.axis(axis) << 16
        val previous = imuSigned32(buffer.loadU32(base + axis * 4))
        var difference = imuCalibrationAbsolute(fixed - previous)
        if (difference > maximumDifference) maximumDifference = difference
        buffer.storeU32(base + axis * 4, fixed)
        val average = imuSigned32(
            buffer.loadU32(base + 12 + axis * 4)
        )
        difference = imuCalibrationAbsolute(fixed - average)
        if (difference > maximumDifference) maximumDifference = difference
        buffer.storeU32(
            base + 12 + axis * 4,
            imuCalibrationAverage(average, fixed, shift)
        )
        axis = axis + 1
    }
    val stillness = imuCalibrationStillness(
        imuCalibrationStillnessValue(metadata),
        imuSigned32(buffer.loadU32(base + 32)),
        maximumDifference
    )
    buffer.storeU32(
        base + 36,
        imuCalibrationMetadata(
            shift, stillness, imuCalibrationStrength(metadata)
        )
    )
    if (stillness > 16) this.calibrateSensor(sensor, offsets)
    stillness
}
