import "./types_logic.ab"
import "./offsets_logic.ab"
import "../esp32/nvs_idf6.ab"
import "abla/float"
import "abla/unsafe/memory"

type ImuOffsets = int

trusted fun imuOffsetsAt(address: int): ImuOffsets = ImuOffsets(
    (address & 4294967295) | (imuOffsetStorageBytes << 32)
)

trusted fun imuOffsets(): ImuOffsets =
    imuOffsetsAt(nativeStaticAllocate(36))

fun ImuOffsets.buffer(): NativeBuffer = NativeBuffer(
    this & 9223372036854775807
)

fun ImuOffsets.valid(): bool =
    this.buffer().capacity() >= imuOffsetStorageBytes

trusted fun ImuOffsets.clear(): void {
    if (this.valid()) nativeAddressClear(
        this.buffer().addressValue(), imuOffsetStorageBytes
    )
    return
}

trusted fun ImuOffsets.set(index: int, value: int): bool =
    this.valid() && index >= 0 && index < imuOffsetCount &&
        this.buffer().storeU32(index * 4, value)

trusted fun ImuOffsets.get(index: int): int =
    if (!this.valid() || index < 0 || index >= imuOffsetCount) 0
    else imuSigned32(this.buffer().loadU32(index * 4))

trusted fun ImuOffsets.setSensorAxis(
    sensor: int,
    axis: int,
    value: int
): bool = this.set(imuOffsetIndex(sensor, axis), value)

trusted fun ImuOffsets.sensorAxis(sensor: int, axis: int): int =
    this.get(imuOffsetIndex(sensor, axis))

fun ImuOffsets.corrected(
    raw: int,
    sensor: int,
    axis: int,
    scale: f64
): f64 = f64FromInt(
    imuCorrectedFixed(raw, this.sensorAxis(sensor, axis))
) * (scale / 65536.0)

trusted fun ImuOffsets.loadFromNvs(
    namespaceName: string = "M5Unified"
): bool {
    if (!this.valid()) return false
    val namespace = nvsOpen(namespaceName)
    if (!namespace.valid()) return false
    val pending = imuOffsetsAt(nativeStackAllocate(36))
    var index = 0
    var loaded = true
    while (index < imuOffsetCount) {
        val value = namespace.getI32(imuOffsetKey(index))
        if (!value.valid()) loaded = false
        else pending.set(index, value.value())
        index = index + 1
    }
    namespace.close()
    if (loaded) ablaUnsafeCopyMemory(
        this.buffer().addressValue(), pending.buffer().addressValue(), 36
    )
    loaded
}

trusted fun ImuOffsets.saveToNvs(
    namespaceName: string = "M5Unified"
): bool {
    if (!this.valid()) return false
    val namespace = nvsOpen(namespaceName, true)
    if (!namespace.valid()) return false
    var index = 0
    var saved = true
    while (index < imuOffsetCount) {
        if (!namespace.setI32(imuOffsetKey(index), this.get(index))) {
            saved = false
        }
        index = index + 1
    }
    if (saved) saved = namespace.commit()
    namespace.close()
    saved
}
