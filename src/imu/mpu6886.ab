import "./types.ab"
import "./mpu6886_logic.ab"

type Mpu6886 = int

trusted fun mpu6886(bus: I2cBus): Mpu6886 = Mpu6886(
    if (bus.valid()) bus.device(104, 400000) & 4294967295 else 0
)

fun Mpu6886.valid(): bool = this != 0
fun Mpu6886.device(): I2cDevice = I2cDevice(this & 4294967295)
fun Mpu6886.accelerationScale(): f64 = 8.0 / 32768.0
fun Mpu6886.gyroscopeScale(): f64 = 2000.0 / 32768.0
fun Mpu6886.temperatureScale(): f64 = 1.0 / 326.8
fun Mpu6886.temperatureOffset(): f64 = 25.0

trusted fun Mpu6886.whoAmI(): int =
    if (this.valid()) this.device().readRegister8(117) else 0

trusted fun Mpu6886.writeRegister8Verified(
    register: int,
    value: int
): bool {
    if (!this.valid()) return false
    val device = this.device()
    var retries = 16
    var matched = false
    while (!matched && retries > 0) {
        if (!device.writeRegister8(register, value)) return false
        matched = device.readRegister8(register) == value
        retries = retries - 1
    }
    matched
}

trusted fun Mpu6886.begin(): int {
    if (!this.valid() || !mpu6886IdentityValid(this.whoAmI())) {
        return imuSpecNone
    }
    val device = this.device()
    if (!device.writeRegister8(107, 128)) return imuSpecNone
    if (!this.writeRegister8Verified(107, 1)) return imuSpecNone
    if (!this.writeRegister8Verified(28, 16)) return imuSpecNone
    if (!this.writeRegister8Verified(27, 24)) return imuSpecNone
    if (!this.writeRegister8Verified(26, 1)) return imuSpecNone
    if (!this.writeRegister8Verified(25, 3)) return imuSpecNone
    if (!this.writeRegister8Verified(55, 192)) return imuSpecNone
    if (!this.writeRegister8Verified(56, 0)) return imuSpecNone
    if (!this.writeRegister8Verified(29, 0)) return imuSpecNone
    if (!this.writeRegister8Verified(106, 0)) return imuSpecNone
    if (!this.writeRegister8Verified(35, 0)) return imuSpecNone
    // M5Unified reapplies both full-scale settings after the verified table.
    if (!device.writeRegister8(27, 24)) return imuSpecNone
    imuDelay(10)
    if (!device.writeRegister8(28, 16)) return imuSpecNone
    imuDelay(10)
    imuSpecAcceleration | imuSpecGyroscope
}

trusted fun Mpu6886.close(): bool =
    this.valid() && this.device().close()

trusted fun Mpu6886.sleep(): bool =
    this.valid() && this.device().writeRegister8(107, 64)

trusted fun Mpu6886.dataReady(): bool =
    this.valid() && (this.device().readRegister8(58) & 1) != 0

trusted fun Mpu6886.readAccelerationRaw(): ImuAxes =
    if (this.valid()) this.device().readImuAxesBigEndian(59)
    else invalidImuAxes()

trusted fun Mpu6886.readGyroscopeRaw(): ImuAxes =
    if (this.valid()) this.device().readImuAxesBigEndian(67)
    else invalidImuAxes()

trusted fun Mpu6886.readTemperatureRaw(): ImuSample =
    if (this.valid()) this.device().readImuSampleBigEndian(65)
    else invalidImuSample()

trusted fun Mpu6886.setInterruptActiveHigh(activeHigh: bool): bool =
    this.valid() && this.device().updateRegister8(
        55, 128, if (activeHigh) 0 else 128
    )

trusted fun Mpu6886.setGyroscopeOffset(x: int, y: int, z: int): bool {
    if (!this.valid()) return false
    val address = nativeStackAllocate(6)
    val bytes = nativeBufferAt(address, 6)
    bytes.store(0, x >>> 8)
    bytes.store(1, x)
    bytes.store(2, y >>> 8)
    bytes.store(3, y)
    bytes.store(4, z >>> 8)
    bytes.store(5, z)
    this.device().writeRegister(19, bytes, 6)
}
