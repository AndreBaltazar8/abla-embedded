// Portable restoring division: scalar operations only, no hosted runtime or
// compiler-rt/libgcc dependency. The divisor must be nonzero.
// Shift the dividend/quotient by one each round rather than by a variable bit:
// RV32 LLVM can otherwise introduce __ashldi3/__lshrdi3 calls.
fun unsignedDivide64(
    dividend: u64,
    divisor: u64
): u64 {
    // As with the compiler-rt/libgcc ABI, a zero divisor is outside the
    // function contract; callers must not depend on a result for that input.
    var quotient = u64(0)
    var remainder = u64(0)
    var remaining = dividend
    var bit = u64(64)
    while (bit != u64(0)) {
        bit = bit - u64(1)
        val high = remainder >>> u64(63)
        remainder = (remainder << u64(1)) |
            (remaining >>> u64(63))
        remaining = remaining << u64(1)
        quotient = quotient << u64(1)
        if (high != u64(0) || remainder >= divisor) {
            remainder = remainder - divisor
            quotient = quotient | u64(1)
        }
    }
    quotient
}
