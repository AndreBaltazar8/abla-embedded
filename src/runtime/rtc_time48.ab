import "./unsigned_division64.ab"
// Convert a full 48-bit elapsed interval without overflowing ticks*period.
// Both partial products fit signed64 (29x32 and19x32 bits); the sum fits61.
// Floor only once, preserving the fractional contribution of the low ticks.
@section(".iram1.abla.rtc48Microseconds")
fun rtc48MicrosecondsForTicks(ticks: int,periodQ19: int): int {
    if (ticks < 0 || ticks > 0xffffffffffff || periodQ19 <= 0 || periodQ19 > 0xffffffff) return -1
    ((ticks>>>19)*periodQ19)+(((ticks&0x7ffff)*periodQ19)>>>19)
}
// Measured slow-clock period in microseconds Q19, never an assumed frequency.
// Floor rounding matches IDF. Split numerator to avoid a 64-bit left overflow.
fun rtc48TicksForMicroseconds(microseconds: int,periodQ19: int): int {
    if (microseconds < 0 || periodQ19 <= 0 || periodQ19 > 0xffffffff) return -1
    val whole=int(unsignedDivide64(u64(microseconds),u64(periodQ19)))
    if (whole >= 0x10000000) return -1
    val remainder=microseconds-whole*periodQ19
    val ticks=(whole<<19)+int(unsignedDivide64(u64(remainder<<19),u64(periodQ19)))
    return if (ticks >= 0x800000000000) -1 else ticks
}
// Modulo48 arithmetic is unambiguous only within half a counter cycle.
// Zero-duration alarms are rejected; zero itself is a valid wrapped target.
@section(".iram1.abla.rtc48Deadline")
fun rtc48DeadlineAfter(now: int,ticks: int): int {
    if (now < 0 || now > 0xffffffffffff || ticks <= 0 || ticks >= 0x800000000000) return -1
    return (now+ticks)&0xffffffffffff
}
@section(".iram1.abla.rtc48Remaining")
fun rtc48TicksRemaining(now: int,deadline: int): int {
    if (now < 0 || now > 0xffffffffffff || deadline < 0 || deadline > 0xffffffffffff) return -1
    val distance=(deadline-now)&0xffffffffffff
    return if (distance >= 0x800000000000) -1 else distance
}
