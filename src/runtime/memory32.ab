import "abla/unsafe/memory/raw"
import "abla/unsafe/mmio"

// 32-bit size_t ABI fallback for compiler-generated memset on byte-addressable
// memory. No allocator or chip-specific addresses. Volatile stores prevent
// LLVM's loop-idiom pass from replacing this implementation with a call to
// itself. This does not make concurrent access or device-register fills safe.
trusted fun freestandingMemorySetBytes(base: int, value: i32, count: u32): int {
    val byte = int(value) & 255
    var index = u32(0)
    while (index < count) {
        mmioStoreU8(base + int(index), byte)
        index = index + u32(1)
    }
    base
}

// 32-bit pointer words match the target C ABI without exporting pointer-box
// adapters. The address-width-neutral body above also permits host testing.
trusted fun freestandingMemorySet32(destination: u32, value: i32, count: u32): u32 =
    u32(freestandingMemorySetBytes(int(destination), value, count))
