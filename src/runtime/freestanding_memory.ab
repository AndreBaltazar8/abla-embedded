import "abla/unsafe/memory"

// Freestanding byte and C-string primitives. These are scalar Abla loops so
// LLVM can specialize ordinary internal uses. The exports below exist only as
// compatibility entry points for remaining ESP-IDF objects.

@inline
trusted fun freestandingLoadByte(address: u32): int =
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address))) & 255

@inline
trusted fun freestandingStoreByte(address: u32, value: int): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), value & 255)

@export("memcpy")
trusted fun freestandingCopy(
    destination: u32,
    source: u32,
    count: u32
): u32 {
    var index = u32(0)
    while (index < count) {
        freestandingStoreByte(
            destination + index, freestandingLoadByte(source + index)
        )
        index = index + u32(1)
    }
    destination
}

@export("memmove")
trusted fun freestandingMove(
    destination: u32,
    source: u32,
    count: u32
): u32 {
    if (destination <= source || destination >= source + count) {
        return freestandingCopy(destination, source, count)
    }
    var index = count
    while (index != u32(0)) {
        index = index - u32(1)
        freestandingStoreByte(
            destination + index, freestandingLoadByte(source + index)
        )
    }
    destination
}

@export("memset")
trusted fun freestandingSet(
    destination: u32,
    value: i32,
    count: u32
): u32 {
    var index = u32(0)
    while (index < count) {
        freestandingStoreByte(destination + index, int(value))
        index = index + u32(1)
    }
    destination
}

@export("bzero")
trusted fun freestandingZero(destination: u32, count: u32): void {
    val ignored = freestandingSet(destination, i32(0), count)
    return
}

@export("memcmp")
trusted fun freestandingCompare(
    first: u32,
    second: u32,
    count: u32
): i32 {
    var index = u32(0)
    while (index < count) {
        val left = freestandingLoadByte(first + index)
        val right = freestandingLoadByte(second + index)
        if (left != right) return i32(left - right)
        index = index + u32(1)
    }
    i32(0)
}

@export("memchr")
trusted fun freestandingFindByte(
    source: u32,
    value: i32,
    count: u32
): u32 {
    val expected = int(value) & 255
    var index = u32(0)
    while (index < count) {
        if (freestandingLoadByte(source + index) == expected) {
            return source + index
        }
        index = index + u32(1)
    }
    u32(0)
}

trusted fun freestandingStringLength(source: u32): u32 {
    var length = u32(0)
    while (freestandingLoadByte(source + length) != 0) {
        length = length + u32(1)
    }
    length
}

@export("strnlen")
trusted fun freestandingStringLengthBounded(
    source: u32,
    maximum: u32
): u32 {
    var length = u32(0)
    while (length < maximum &&
        freestandingLoadByte(source + length) != 0) {
        length = length + u32(1)
    }
    length
}

@export("strcmp")
trusted fun freestandingStringCompare(first: u32, second: u32): i32 {
    var index = u32(0)
    while (true) {
        val left = freestandingLoadByte(first + index)
        val right = freestandingLoadByte(second + index)
        if (left != right) return i32(left - right)
        if (left == 0) return i32(0)
        index = index + u32(1)
    }
    i32(0)
}

@export("strncmp")
trusted fun freestandingStringCompareBounded(
    first: u32,
    second: u32,
    maximum: u32
): i32 {
    var index = u32(0)
    while (index < maximum) {
        val left = freestandingLoadByte(first + index)
        val right = freestandingLoadByte(second + index)
        if (left != right) return i32(left - right)
        if (left == 0) return i32(0)
        index = index + u32(1)
    }
    i32(0)
}

@inline
fun freestandingAsciiLower(value: int): int =
    if (value >= 65 && value <= 90) value + 32 else value

@export("strncasecmp")
trusted fun freestandingStringCompareCaseInsensitiveBounded(
    first: u32,
    second: u32,
    maximum: u32
): i32 {
    var index = u32(0)
    while (index < maximum) {
        val rawLeft = freestandingLoadByte(first + index)
        val rawRight = freestandingLoadByte(second + index)
        val left = freestandingAsciiLower(rawLeft)
        val right = freestandingAsciiLower(rawRight)
        if (left != right) return i32(left - right)
        if (rawLeft == 0) return i32(0)
        index = index + u32(1)
    }
    i32(0)
}

@export("strcpy")
trusted fun freestandingStringCopy(destination: u32, source: u32): u32 {
    var index = u32(0)
    var value = 1
    while (value != 0) {
        value = freestandingLoadByte(source + index)
        freestandingStoreByte(destination + index, value)
        index = index + u32(1)
    }
    destination
}

@export("strncpy")
trusted fun freestandingStringCopyBounded(
    destination: u32,
    source: u32,
    count: u32
): u32 {
    var index = u32(0)
    var ended = false
    while (index < count) {
        val value = if (ended) 0
            else freestandingLoadByte(source + index)
        freestandingStoreByte(destination + index, value)
        if (value == 0) ended = true
        index = index + u32(1)
    }
    destination
}

@export("strlcpy")
trusted fun freestandingStringCopySized(
    destination: u32,
    source: u32,
    capacity: u32
): u32 {
    val length = freestandingStringLength(source)
    if (capacity != u32(0)) {
        val copied = if (length < capacity) length else capacity - u32(1)
        val ignored = freestandingCopy(destination, source, copied)
        freestandingStoreByte(destination + copied, 0)
    }
    length
}

@export("strcat")
trusted fun freestandingStringAppend(
    destination: u32,
    source: u32
): u32 {
    val ignored = freestandingStringCopy(
        destination + freestandingStringLength(destination), source
    )
    destination
}

@export("strlcat")
trusted fun freestandingStringAppendSized(
    destination: u32,
    source: u32,
    capacity: u32
): u32 {
    val destinationLength = freestandingStringLengthBounded(
        destination, capacity
    )
    val sourceLength = freestandingStringLength(source)
    if (destinationLength < capacity) {
        val room = capacity - destinationLength
        val ignored = freestandingStringCopySized(
            destination + destinationLength, source, room
        )
    }
    destinationLength + sourceLength
}

@export("strchr")
trusted fun freestandingStringFind(source: u32, value: i32): u32 {
    val expected = int(value) & 255
    var index = u32(0)
    while (true) {
        val current = freestandingLoadByte(source + index)
        if (current == expected) return source + index
        if (current == 0) return u32(0)
        index = index + u32(1)
    }
    u32(0)
}

@export("strrchr")
trusted fun freestandingStringFindLast(source: u32, value: i32): u32 {
    val expected = int(value) & 255
    var result = u32(0)
    var index = u32(0)
    while (true) {
        val current = freestandingLoadByte(source + index)
        if (current == expected) result = source + index
        if (current == 0) return result
        index = index + u32(1)
    }
    u32(0)
}

@export("strcspn")
trusted fun freestandingStringSpanNotIn(
    source: u32,
    rejected: u32
): u32 {
    var length = u32(0)
    while (freestandingLoadByte(source + length) != 0) {
        if (freestandingStringFind(
            rejected, i32(freestandingLoadByte(source + length))
        ) != u32(0)) return length
        length = length + u32(1)
    }
    length
}

@export("strstr")
trusted fun freestandingStringFindString(
    source: u32,
    needle: u32
): u32 {
    val needleLength = freestandingStringLength(needle)
    if (needleLength == u32(0)) return source
    var index = u32(0)
    while (freestandingLoadByte(source + index) != 0) {
        if (freestandingCompare(source + index, needle, needleLength) == i32(0)) {
            return source + index
        }
        index = index + u32(1)
    }
    u32(0)
}
