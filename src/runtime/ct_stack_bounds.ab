// Keep stack wipes off FreeRTOS's overflow fill pattern and ESP-IDF's
// end-of-stack watchpoint. The same reserved margin applies to owned stacks.
@inline
fun embeddedCtStackProtectedLow(low: u32): u32 =
    if (low == u32(0) || low > u32(0xFFFFFFBF)) u32(0) else low + u32(64)

@inline
fun embeddedCtBootStackLow(stack: u32, low: u32, top: u32): u32 {
    val protected = embeddedCtStackProtectedLow(low)
    if (protected == u32(0) || protected > top || stack < protected || stack > top) u32(0)
    else protected
}
