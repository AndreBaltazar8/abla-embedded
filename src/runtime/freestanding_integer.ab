import "../xtensa/assembly.ab"
import "abla/runtime/self"

import "./integer_logic.ab"

trusted fun freestandingAbort(): void = ablaRuntimeTrap()

// Recovered C-ABI callers assign the return register even though abort and
// assertion failure never return.  Keeping that adapter in ordinary Abla lets
// LLVM propagate unreachability without retaining an opaque symbolic call.
trusted fun freestandingAbortValue(): u32 {
    freestandingAbort()
    u32(0)
}
