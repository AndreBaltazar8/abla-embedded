import "../xtensa/assembly.ab"

// Restoring 64-bit division uses only shifts, comparisons, and subtraction,
// avoiding recursive LLVM calls to libgcc on 32-bit targets.

fun freestandingUnsignedDivideOrRemainder(
    dividend: u64,
    divisor: u64,
    remainderResult: bool
): u64 {
    if (divisor == u64(0)) return u64(0)
    var quotient = u64(0)
    var remainder = u64(0)
    var bit = 64
    while (bit > 0) {
        bit = bit - 1
        remainder = (remainder << u64(1)) |
            ((dividend >> u64(bit)) & u64(1))
        if (remainder >= divisor) {
            remainder = remainder - divisor
            quotient = quotient | (u64(1) << u64(bit))
        }
    }
    if (remainderResult) remainder else quotient
}

@export("__udivdi3")
fun freestandingUnsignedDivide(dividend: u64, divisor: u64): u64 =
    freestandingUnsignedDivideOrRemainder(dividend, divisor, false)

@export("__umoddi3")
fun freestandingUnsignedRemainder(dividend: u64, divisor: u64): u64 =
    freestandingUnsignedDivideOrRemainder(dividend, divisor, true)

@inline
fun freestandingSignedMagnitude(value: i64): u64 =
    if (value >= i64(0)) u64(value)
    else (~u64(value)) + u64(1)

@export("__divdi3")
fun freestandingSignedDivide(dividend: i64, divisor: i64): i64 {
    val magnitude = freestandingUnsignedDivideOrRemainder(
        freestandingSignedMagnitude(dividend),
        freestandingSignedMagnitude(divisor),
        false
    )
    if ((dividend < i64(0)) != (divisor < i64(0))) {
        i64((~magnitude) + u64(1))
    } else i64(magnitude)
}

@export("__moddi3")
fun freestandingSignedRemainder(dividend: i64, divisor: i64): i64 {
    val magnitude = freestandingUnsignedDivideOrRemainder(
        freestandingSignedMagnitude(dividend),
        freestandingSignedMagnitude(divisor),
        true
    )
    if (dividend < i64(0)) i64((~magnitude) + u64(1))
    else i64(magnitude)
}

@export("__popcountsi2")
fun freestandingPopulationCount32(value: u32): i32 {
    var remaining = value
    var count = 0
    while (remaining != u32(0)) {
        remaining = remaining & (remaining - u32(1))
        count = count + 1
    }
    i32(count)
}

@export("__bswapsi2")
fun freestandingByteSwap32(value: u32): u32 =
    ((value & u32(255)) << u32(24)) |
        ((value & u32(65280)) << u32(8)) |
        ((value >> u32(8)) & u32(65280)) |
        ((value >> u32(24)) & u32(255))

@export("__bswapdi2")
fun freestandingByteSwap64(value: u64): u64 =
    (u64(freestandingByteSwap32(u32(value))) << u64(32)) |
        u64(freestandingByteSwap32(u32(value >> u64(32))))

@naked
@export("abort")
trusted fun freestandingAbort(): void = xtensaAssemblyVoid(
    ".Labla_abort:\nill\nj .Labla_abort",
    "~{memory}"
)
