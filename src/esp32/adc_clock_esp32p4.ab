import "./adc_clock_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("p4AdcRead")
trusted fun p4AdcReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("p4AdcWrite")
trusted fun p4AdcWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
