import "./adc_power_esp32c5.ab"
import "./adc_frontend_c5_sequence.ab"
fun c5AdcFrontendAddress(offset: int): int = if (offset == 0) 0x600a9c14 else if (offset == 4) 0x600b0158 else if (offset == 8) 0x600a0810 else if (offset == 12) 0x600af018 else if (offset == 16) 0x600af800 else 0x600af804
trusted fun c5AdcFrontendRead(offset: int): u32 = u32(mmioLoadU32(c5AdcFrontendAddress(offset)))
trusted fun c5AdcFrontendWrite(offset: int,value: u32): void { mmioStoreU32(c5AdcFrontendAddress(offset),int(value));return }
