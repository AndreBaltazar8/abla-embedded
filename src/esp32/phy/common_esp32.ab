// Classic ESP32 predates the combined phy_param_track_tot entry point used by
// newer SoCs.  Its PHY archive exposes the Wi-Fi and Bluetooth tracking
// operations separately, so preserve the generic two-flag contract by
// dispatching to those Abla-owned implementations.
trusted fun esp32PhyParamTrackTot(
    trackWifi: u32,
    trackBluetoothOr154: u32
): u32 {
    if (trackWifi != u32(0)) {
        esp32RecoveredWifiTrackPllCap(u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    }
    if (trackBluetoothOr154 != u32(0)) {
        esp32RecoveredBtTrackPllCap(u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    }
    u32(0)
}

