import "../log/core_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"

@inline
trusted fun esp32PhyPrintfStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32PhyLibPrintf(
    tag:u32, format:u32, va0:u32, va1:u32, va2:u32
):u32 {
    // PHY printf is diagnostic-only and is disabled in the compact release
    // image. Its hardware/calibration paths and return contract are unchanged.
    u32(0)
}

trusted fun esp32PhyVariadicPrintf(
    tag:u32,format:u32,arg0:u32,arg1:u32,arg2:u32,arg3:u32,arg4:u32
):u32 {
    val frame = u32(nativeStackAllocate(80))
    val registerArgs = frame + u32(16)
    val overflowArgs = frame + u32(48)
    esp32PhyPrintfStoreU32(frame, overflowArgs)
    esp32PhyPrintfStoreU32(frame + u32(4), registerArgs)
    esp32PhyPrintfStoreU32(frame + u32(8), u32(4))
    esp32PhyPrintfStoreU32(frame + u32(20), arg0)
    esp32PhyPrintfStoreU32(frame + u32(24), arg1)
    esp32PhyPrintfStoreU32(frame + u32(28), arg2)
    esp32PhyPrintfStoreU32(frame + u32(32), arg3)
    esp32PhyPrintfStoreU32(frame + u32(36), arg4)
    esp32PhyLibPrintf(tag, format, overflowArgs, registerArgs, u32(4))
}

trusted fun esp32PhyPrintf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PhyVariadicPrintf(u32(nativeCStringAddress("phy")),
    a2,a3,a4,a5,a6,a7)

trusted fun esp32RtcPrintf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PhyVariadicPrintf(u32(nativeCStringAddress("rtc")),
    a2,a3,a4,a5,a6,a7)

trusted fun esp32RecoveredPhyPrintf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PhyPrintf(a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)

trusted fun esp32RecoveredRtcPrintf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32RtcPrintf(a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
