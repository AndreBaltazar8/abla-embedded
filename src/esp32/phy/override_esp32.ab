trusted fun esp32PhyI2cEnterCritical(): void {
    esp32RecoveredRegi2cEnterCritical(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

