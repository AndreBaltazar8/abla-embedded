}

// Classic ESP32 has no SOC temperature-sensor support in this IDF path.
trusted fun esp32PhySetPowerDetectorPower(enabled: bool): void { return }

@section(".iram1.abla.esp32PhySetTemperatureSensorPower")
trusted fun esp32PhySetTemperatureSensorPower(enabled: bool): void { return }

trusted fun esp32PhyGetTemperatureSensorValue(): i32 = 0

trusted fun esp32PhyEfuseGetMac(output: u32): void {
    esp32EfuseGetMacValue(output)
    return
}

trusted fun esp32PhyEfuseGetChipVersionPackage(): u32 =
    esp32EfuseGetChipVersionPackage()

trusted fun esp32RecoveredSetXpdSar(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    // The classic ESP32 PHY symbol is a direct SENS_SAR_MEAS_WAIT2 register
    // update, not a reference-counted SAR-peripheral power request.  Preserve
    // the exact recovered mask so RF close/reset paths do not perturb ADC
    // ownership or leave the radio analog domain in the wrong state.
    val address = u32(1072990220)
    val current = esp32DportRead(address)
    val enabled = (a2 & u32(255)) != u32(0)
    val updated = (current & u32(4294180863)) |
        (if (enabled) u32(786432) else u32(0))
    xtensaMemoryBarrier()
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(address)), int(updated)
    )
    return a2 & u32(255)
}
