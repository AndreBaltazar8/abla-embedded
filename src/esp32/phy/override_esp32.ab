import "../hal/efuse_identity_esp32.ab"
import "../dport_esp32.ab"
import "../../xtensa/assembly.ab"
import "abla/unsafe/memory"

val esp32PhyAdcPowerStateStorage = nativeStaticAllocate(1)
val esp32PhyAdcPowerState = u32(esp32PhyAdcPowerStateStorage)

trusted fun esp32PhyIncludeOverride(): void { return }

trusted fun esp32PhySetAdcPower(enabled: bool): void {
    val next = if (enabled) u32(1) else u32(0)
    if (u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(esp32PhyAdcPowerState))
    )) == next) return
    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(esp32PhyAdcPowerState)),
        int(next)
    )
    if (enabled) {
        esp32RecoveredSarPeriphCtrlPwdetPowerAcquire(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    } else {
        esp32RecoveredSarPeriphCtrlPwdetPowerRelease(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    }
    return
}

