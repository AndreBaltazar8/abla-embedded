import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPhyCommonInternals(): bool {
    if (!internalFunction("esp32RecoveredPhyEnabledModemContains", "phy_enabled_modem_contains")) return false
    if (!internalFunction("esp32RecoveredPhyTrackPll", "phy_track_pll")) return false
    if (!internalFunction("esp32RecoveredPhyTrackPllInit", "phy_track_pll_init")) return false
    if (!internalFunction("esp32RecoveredPhyTrackPllDeinit", "phy_track_pll_deinit")) return false
    if (!internalFunction("esp32RecoveredPhySetModemFlag", "phy_set_modem_flag")) return false
    if (!internalFunction("esp32RecoveredPhyClrModemFlag", "phy_clr_modem_flag")) return false
    if (!internalFunction("esp32RecoveredPhyGetModemFlag", "phy_get_modem_flag")) return false
    if (!internalFunction("esp32RecoveredPhyAntNeedUpdate", "phy_ant_need_update")) return false
    if (!internalFunction("esp32RecoveredPhyAntClrUpdateFlag", "phy_ant_clr_update_flag")) return false
    if (!internalFunction("esp32RecoveredEspPhySetAntGpio", "esp_phy_set_ant_gpio")) return false
    if (!internalFunction("esp32RecoveredEspPhyGetAntGpio", "esp_phy_get_ant_gpio")) return false
    if (!internalFunction("esp32RecoveredPhyAntUpdate", "phy_ant_update")) return false
    if (!internalFunction("esp32RecoveredEspPhySetAnt", "esp_phy_set_ant")) return false
    if (!internalFunction("esp32RecoveredEspPhyGetAnt", "esp_phy_get_ant")) return false
    if (!internalFunction("esp32RecoveredPhyWaitFreqHwHopDone", "phy_wait_freq_hw_hop_done")) return false
    true
}
