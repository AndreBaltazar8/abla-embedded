import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPhyPrintfInternals(): bool {
    if (!internalFunction("esp32PhyPrintf", "phy_printf")) return false
    if (!internalFunction("esp32RtcPrintf", "rtc_printf")) return false
    true
}
