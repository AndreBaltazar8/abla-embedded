import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPhyOverrideInternals(): bool {
    if (!internalFunction("esp32PhyIncludeOverride", "include_esp_phy_override")) return false
    if (!internalFunction("esp32PhySetAdcPower", "set_xpd_sar")) return false
    if (!internalFunction("esp32PhyI2cEnterCritical", "phy_i2c_enter_critical")) return false
    if (!internalFunction("esp32PhyI2cExitCritical", "phy_i2c_exit_critical")) return false
    if (!internalFunction("esp32PhySetPowerDetectorPower", "phy_set_pwdet_power")) return false
    if (!internalFunction("esp32PhySetTemperatureSensorPower", "phy_set_tsens_power")) return false
    if (!internalFunction("esp32PhyGetTemperatureSensorValue", "phy_get_tsens_value")) return false
    if (!internalFunction("esp32PhyEfuseGetMac", "esp_phy_efuse_get_mac")) return false
    if (!internalFunction("esp32PhyEfuseGetChipVersionPackage", "esp_phy_efuse_get_chip_ver_pkg")) return false
    true
}
