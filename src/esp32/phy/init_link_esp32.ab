import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPhyInitOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredPhyEnterCritical", "phy_enter_critical")) return false
    if (!internalFunction("esp32RecoveredPhyExitCritical", "phy_exit_critical")) return false
    if (!internalFunction("esp32RecoveredEspPhyRfGetOnTs", "esp_phy_rf_get_on_ts")) return false
    if (!internalFunction("esp32RecoveredEspPhyCommonClockEnable", "esp_phy_common_clock_enable")) return false
    if (!internalFunction("esp32RecoveredEspPhyCommonClockDisable", "esp_phy_common_clock_disable")) return false
    if (!internalFunction("esp32RecoveredEspPhyDisable", "esp_phy_disable")) return false
    if (!internalFunction("esp32RecoveredEspWifiBtPowerDomainOn", "esp_wifi_bt_power_domain_on")) return false
    if (!internalFunction("esp32RecoveredEspWifiBtPowerDomainOff", "esp_wifi_bt_power_domain_off")) return false
    if (!internalFunction("esp32RecoveredEspWifiBtPowerDomainOn", "esp_wifi_power_domain_on")) return false
    if (!internalFunction("esp32RecoveredEspWifiBtPowerDomainOff", "esp_wifi_power_domain_off")) return false
    if (!internalFunction("esp32RecoveredEspPhyModemInit", "esp_phy_modem_init")) return false
    if (!internalFunction("esp32RecoveredEspPhyModemDeinit", "esp_phy_modem_deinit")) return false
    if (!internalFunction("esp32RecoveredEspPhyGetInitData", "esp_phy_get_init_data")) return false
    if (!internalFunction("esp32RecoveredEspPhyReleaseInitData", "esp_phy_release_init_data")) return false
    if (!internalFunction("esp32RecoveredEspPhyLoadCalDataFromNvs", "esp_phy_load_cal_data_from_nvs")) return false
    if (!internalFunction("esp32RecoveredEspPhyStoreCalDataToNvs", "esp_phy_store_cal_data_to_nvs")) return false
    if (!internalFunction("esp32RecoveredEspPhyEraseCalDataInNvs", "esp_phy_erase_cal_data_in_nvs")) return false
    if (!internalFunction("esp32RecoveredEspPhyLoadCalAndInit", "esp_phy_load_cal_and_init")) return false
    if (!internalFunction("esp32RecoveredEspPhyEnable", "esp_phy_enable")) return false
    if (!internalFunction("esp32RecoveredEspPhyUpdateCountryInfo", "esp_phy_update_country_info")) return false
    if (!internalFunction("esp32RecoveredPhyGetLock", "phy_get_lock")) return false
    true
}
