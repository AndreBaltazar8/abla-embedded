import "./gpio_p4_sequence.ab"
// Nominal scalar Pin, matching C5/C6/S3. Caller owns the pad, has stopped its
// prior peripheral/LP users, released holds, and pinned GPIO/HP+LP IOMUX clocks.
// These adapters do not acquire clocks, clear holds or reserve board pins.
type Pin=int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 0 && this <= 54
fun Pin.outputCapable(): bool = this.valid()
fun Pin.pullCapable(): bool = this.valid()
trusted fun Pin.read(): bool = esp32P4GpioReadOwned(this) == 1
trusted fun Pin.readLevelOwned(): int = esp32P4GpioReadOwned(this)
trusted fun Pin.write(high: bool): void { esp32P4GpioWriteOwned(this,high);return }
trusted fun Pin.writeLevelOwned(high: bool): bool = esp32P4GpioWriteOwned(this,high)
trusted fun Pin.outputLevelOwned(high: bool): bool = esp32P4GpioConfigureOwned(this,true,high,false,false,0) == 1
trusted fun Pin.inputOwned(): bool = esp32P4GpioConfigureOwned(this,false,true,false,true,0) == 1
trusted fun Pin.inputPullOwned(pull: int): bool = esp32P4GpioConfigureOwned(this,false,true,false,true,pull) == 1
