import "./gpio_p4_sequence.ab"
import "../hal/esp32.ab"
import "../hal/pin.ab"
// Nominal scalar Pin, matching C5/C6/S3. Caller owns the pad, has stopped its
// prior peripheral/LP users, released holds, and pinned GPIO/HP+LP IOMUX clocks.
// These adapters do not acquire clocks, clear holds or reserve board pins.
@export("abla_pin_valid")
fun pinValidHook(pin: int): bool = Pin(pin) >= 0 && Pin(pin) <= 54
@export("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin).valid()
@export("abla_pin_pullCapable")
fun pinPullCapableHook(pin: int): bool = Pin(pin).valid()
@export("abla_pin_read")
trusted fun pinReadHook(pin: int): bool = esp32P4GpioReadOwned(Pin(pin)) == 1
@export("abla_pin_readLevelOwned")
trusted fun pinReadLevelOwnedHook(pin: int): int = esp32P4GpioReadOwned(Pin(pin))
@export("abla_pin_write")
trusted fun pinWriteHook(pin: int, high: bool): void { esp32P4GpioWriteOwned(Pin(pin),high);return }
@export("abla_pin_writeLevelOwned")
trusted fun pinWriteLevelOwnedHook(pin: int, high: bool): bool = esp32P4GpioWriteOwned(Pin(pin),high)
@export("abla_pin_outputLevelOwned")
trusted fun pinOutputLevelOwnedHook(pin: int, high: bool): bool = esp32P4GpioConfigureOwned(Pin(pin),true,high,false,false,0) == 1
@export("abla_pin_inputOwned")
trusted fun pinInputOwnedHook(pin: int): bool = esp32P4GpioConfigureOwned(Pin(pin),false,true,false,true,0) == 1
@export("abla_pin_inputPullOwned")
trusted fun pinInputPullOwnedHook(pin: int, pull: int): bool = esp32P4GpioConfigureOwned(Pin(pin),false,true,false,true,pull) == 1
