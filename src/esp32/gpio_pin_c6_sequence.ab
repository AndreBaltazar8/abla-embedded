import "./gpio_c6_sequence.ab"
// Same nominal scalar Pin API as other backends. Validity describes silicon,
// not board reservations or ownership. All accesses require owned, clocked
// pads; configuration refuses RTC/USB/held pads rather than taking them over.
type Pin=int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this
fun Pin.valid(): bool = esp32C6GpioNumberValid(this)
fun Pin.outputCapable(): bool = this.valid()
fun Pin.pullCapable(): bool = this.valid()
trusted fun Pin.read(): bool = esp32C6GpioReadOwned(this) == 1
trusted fun Pin.readLevelOwned(): int = esp32C6GpioReadOwned(this)
trusted fun Pin.write(high: bool): void { esp32C6GpioWriteOwned(this,high);return }
trusted fun Pin.writeLevelOwned(high: bool): bool = esp32C6GpioWriteOwned(this,high)
trusted fun Pin.outputLevelOwned(high: bool): bool =
    esp32C6GpioConfigureOwned(this,true,high,false,false,0,true) == 1
trusted fun Pin.inputOwned(): bool = esp32C6GpioConfigureOwned(this,false,true,false,true,0,true) == 1
trusted fun Pin.inputPullOwned(pull: int): bool = esp32C6GpioConfigureOwned(this,false,true,false,true,pull,true) == 1
