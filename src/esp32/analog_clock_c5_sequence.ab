// C5 regi2c_ctrl_ll.h: MODEM_LPCON clock18bit2; MODEM_SYSCON4bit12
// selects160MHz. Caller pins this source and owns BOTH analog masters/PHY/LP,
// excludes IRQ/sleep/clock/reset users. Reset register is WO, never read as a
// readiness check and never pulsed. This lease does not power analog slaves.
// status0closed1ready2authority3source/lostclock4gatewrite5busy.
// bit8attempted gate ownership,bit9lease. Borrowed clocks never disabled.
type C5AnalogClock=int
fun C5AnalogClock.status(): int = this&255
fun C5AnalogClock.ready(): bool = this.status() == 1
trusted fun c5AnalogClockIdle(): bool = ((c5AnalogClockRead(8)|c5AnalogClockRead(12))&u32(0x2000000)) == u32(0)
trusted fun c5AnalogClockGate(enabled: bool): bool {
    val bit=if (enabled) u32(4) else u32(0)
    val old=c5AnalogClockRead(0)
    if ((old&u32(4)) != bit) c5AnalogClockWrite(0,(old&~u32(4))|bit)
    return (c5AnalogClockRead(0)&u32(4)) == bit
}
trusted fun c5AnalogClockOpen160Owned(exclusive: bool): C5AnalogClock {
    if (!exclusive) return C5AnalogClock(2)
    if ((c5AnalogClockRead(4)&u32(4096)) == u32(0)) return C5AnalogClock(3)
    var token=512
    if ((c5AnalogClockRead(0)&u32(4)) == u32(0)) {
        token=token|256
        if (!c5AnalogClockGate(true)) return C5AnalogClock(token|4)
    }
    if (!c5AnalogClockIdle()) return C5AnalogClock(token|5)
    return C5AnalogClock(token|1)
}
trusted fun C5AnalogClock.closeOwned(exclusive: bool): C5AnalogClock {
    if (!exclusive || this < 0 || (this&~1023) != 0 || (this&512) == 0 || this.status() > 5) return this
    val token=this&768
    if ((c5AnalogClockRead(4)&u32(4096)) == u32(0)) return C5AnalogClock(token|3)
    if ((c5AnalogClockRead(0)&u32(4)) == u32(0)) {
        // Only an unsuccessful enable (or completed owned disable) can release
        // without accessing the gated master registers. Unexpected clock loss
        // in a ready/busy lease is not proof that pending work has stopped.
        if ((token&256) != 0 && this.status() == 4) return C5AnalogClock(0)
        return C5AnalogClock(token|3)
    }
    if (!c5AnalogClockIdle()) return C5AnalogClock(token|5)
    if ((token&256) != 0 && !c5AnalogClockGate(false)) return C5AnalogClock(token|4)
    return C5AnalogClock(0)
}
