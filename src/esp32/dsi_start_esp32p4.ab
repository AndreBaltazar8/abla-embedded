import "./dsi_fifo_esp32p4.ab"
import "./dsi_start_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4DsiBridgeRead(offset: int): u32 = u32(mmioLoadU32(0x500A0800+offset))
trusted fun p4DsiBridgeWrite(offset: int,value: u32): void { mmioStoreU32(0x500A0800+offset,int(value)); return }
trusted fun esp32P4DsiStartDigital(hwVersion: int,lanes: int,referenceKhz: int,laneKbps: int,channel: int,forceHs: bool,polls: int): DsiCommandResult =
    esp32P4DsiStartDigitalOwned(hwVersion,lanes,referenceKhz,laneKbps,channel,forceHs,polls)
