import "./interrupt_install_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
@inline
@export("esp32S3InterruptInstallCore")
trusted fun esp32S3InterruptInstallCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3InterruptInstallEnabled")
trusted fun esp32S3InterruptInstallEnabledHook(): int = int(xtensaGuardRead("rsr.intenable $0","=r,~{memory}"))
@inline
@export("esp32S3InterruptInstallRead")
trusted fun esp32S3InterruptInstallReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3InterruptInstallWrite")
trusted fun esp32S3InterruptInstallWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
