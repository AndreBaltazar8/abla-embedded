import "./interrupt_install_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
@inline
trusted fun esp32S3InterruptInstallCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3InterruptInstallEnabled(): int = int(xtensaGuardRead("rsr.intenable $0","=r,~{memory}"))
@inline
trusted fun esp32S3InterruptInstallRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3InterruptInstallWrite(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
