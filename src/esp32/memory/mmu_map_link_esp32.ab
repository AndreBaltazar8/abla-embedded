import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMmuMapOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspMmuMapInit", "esp_mmu_map_init")) return false
    if (!exportFunction("esp32RecoveredEspMmuMapGetMaxConsecutiveFreeBlockSize", "esp_mmu_map_get_max_consecutive_free_block_size")) return false
    if (!internalFunction("esp32RecoveredEspMmuMapReserveBlockWithCaps", "esp_mmu_map_reserve_block_with_caps")) return false
    if (!exportFunction("esp32RecoveredEspMmuPaddrFindCaps", "esp_mmu_paddr_find_caps")) return false
    if (!exportFunction("esp32RecoveredEspMmuMap", "esp_mmu_map")) return false
    if (!exportFunction("esp32RecoveredEspMmuUnmap", "esp_mmu_unmap")) return false
    if (!exportFunction("esp32RecoveredEspMmuMapDumpMappedBlocks", "esp_mmu_map_dump_mapped_blocks")) return false
    if (!internalFunction("esp32RecoveredEspMmuMapDumpMappedBlocksPrivate", "esp_mmu_map_dump_mapped_blocks_private")) return false
    if (!exportFunction("esp32RecoveredEspMmuVaddrToPaddr", "esp_mmu_vaddr_to_paddr")) return false
    if (!exportFunction("esp32RecoveredEspMmuPaddrToVaddr", "esp_mmu_paddr_to_vaddr")) return false
    true
}
