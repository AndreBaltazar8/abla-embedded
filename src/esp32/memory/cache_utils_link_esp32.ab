import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCacheUtilsOpaqueCallers(): bool {
    if (!exportFunction("esp32CacheSuspendExternalMemory", "esp_cache_suspend_ext_mem_cache")) return false
    if (!exportFunction("esp32CacheResumeExternalMemory", "esp_cache_resume_ext_mem_cache")) return false
    true
}
