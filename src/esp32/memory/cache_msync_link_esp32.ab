import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCacheMsyncOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspCacheSyncOpsEnterCriticalSection", "esp_cache_sync_ops_enter_critical_section")) return false
    if (!internalFunction("esp32RecoveredEspCacheSyncOpsExitCriticalSection", "esp_cache_sync_ops_exit_critical_section")) return false
    if (!internalFunction("esp32RecoveredEspCacheMsync", "esp_cache_msync")) return false
    if (!internalFunction("esp32CacheGetAlignment", "esp_cache_get_alignment")) return false
    if (!internalFunction("esp32RecoveredEspCacheGetLineSizeByAddr", "esp_cache_get_line_size_by_addr")) return false
    true
}
