import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHeapAlignmentOpaqueCallers(): bool {
    if (!exportFunction("esp32HeapAdjustAlignmentToHardware", "esp_heap_adjust_alignment_to_hw")) return false
    true
}
