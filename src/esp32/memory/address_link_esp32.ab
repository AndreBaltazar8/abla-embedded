import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMemoryAddressOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspPtrDmaExtCapable", "esp_ptr_dma_ext_capable")) return false
    if (!exportFunction("esp32RecoveredEspPtrExecutable", "esp_ptr_executable")) return false
    if (!exportFunction("esp32RecoveredEspPtrByteAccessible", "esp_ptr_byte_accessible")) return false
    if (!exportFunction("esp32RecoveredEspPtrExternalRam", "esp_ptr_external_ram")) return false
    true
}
