// Abla/LLVM implementation of ESP32 DMA, executable, byte-accessible, and
// external-RAM pointer classification. These are ordinary typed comparisons:
// there is no target instruction block for LLVM to treat as opaque.

@inline
fun esp32AddressInHalfOpenRange(address: u32, low: u32, high: u32): bool =
    address - low < high - low

// Original ABI symbol: esp_ptr_dma_ext_capable
// Classic ESP32 has no external-memory DMA capability in this configuration.
@inline
trusted fun esp32RecoveredEspPtrDmaExtCapable(address: u32): u32 = u32(0)

// Original ABI symbol: esp_ptr_executable
@inline
trusted fun esp32RecoveredEspPtrExecutable(address: u32): u32 {
    val executable =
        esp32AddressInHalfOpenRange(address, u32(1074593792), u32(1077936128)) ||
        esp32AddressInHalfOpenRange(address, u32(1074266112), u32(1074438144)) ||
        esp32AddressInHalfOpenRange(address, u32(1073741824), u32(1074200576)) ||
        esp32AddressInHalfOpenRange(address, u32(1074528256), u32(1074536448))
    return if (executable) u32(1) else u32(0)
}

// Original ABI symbol: esp_ptr_byte_accessible
@inline
trusted fun esp32RecoveredEspPtrByteAccessible(address: u32): u32 =
    if (esp32AddressInHalfOpenRange(
        address,
        u32(1073283072),
        u32(1073741824)
    )) u32(1) else u32(0)

// Original ABI symbol: esp_ptr_external_ram
// CONFIG_SPIRAM is disabled for this firmware, so the IDF implementation is a
// constant false and LLVM can remove every caller branch that depends on it.
@inline
trusted fun esp32RecoveredEspPtrExternalRam(address: u32): u32 = u32(0)
