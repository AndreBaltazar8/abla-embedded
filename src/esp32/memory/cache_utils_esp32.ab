import "../hal/cache_esp32.ab"

trusted fun esp32CacheSuspendExternalMemory(): void {
    esp32CacheHalSuspend()
    return
}

trusted fun esp32CacheResumeExternalMemory(): void {
    esp32CacheHalResume()
    return
}

trusted fun esp32RecoveredEspCacheSuspendExtMemCache(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32CacheSuspendExternalMemory()
    a2
}

trusted fun esp32RecoveredEspCacheResumeExtMemCache(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32CacheResumeExternalMemory()
    a2
}
