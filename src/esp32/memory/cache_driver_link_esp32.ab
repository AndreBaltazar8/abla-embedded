import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCacheDriverOpaqueCallers(): bool {
    if (!internalFunction("esp32CacheRegisterWriteback", "cache_register_writeback")) return false
    if (!internalFunction("esp32CacheSync", "cache_sync")) return false
    true
}
