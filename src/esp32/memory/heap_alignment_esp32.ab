import "../hal/cache_esp32.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32HeapAlignmentLoad(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32HeapAlignmentStore(
    address: u32,
    value: u32
): void = ablaUnsafeStoreU32(
    nativePointerFromAddress(int(address)), int(value)
)

@section(".iram1.0.abla.esp32HeapAdjustAlignmentToHardware")
trusted fun esp32HeapAdjustAlignmentToHardware(
    alignmentAddress: u32,
    sizeAddress: u32,
    capabilitiesAddress: u32
): void {
    var capabilities = esp32HeapAlignmentLoad(capabilitiesAddress)
    if ((capabilities & u32(1966088)) == u32(0)) return

    var alignment = esp32HeapAlignmentLoad(alignmentAddress)
    var size = esp32HeapAlignmentLoad(sizeAddress)
    val cacheLevel = if ((capabilities & u32(1024)) != u32(0))
        u32(1) else u32(0)
    val cacheAlignment = esp32CacheHalGetCacheLineSize(cacheLevel)
    if (cacheAlignment > alignment) alignment = cacheAlignment

    size = (size + alignment - u32(1)) & (u32(0) - alignment)

    // Descriptor capabilities describe the same underlying DMA-capable RAM
    // to the allocator. External RAM drops the ordinary DMA flag on ESP32,
    // and CACHE_ALIGNED is consumed after choosing the alignment.
    if ((capabilities & u32(393216)) != u32(0)) {
        capabilities = (capabilities & u32(4294574079)) | u32(8)
    }
    if ((capabilities & u32(1024)) != u32(0)) {
        capabilities = capabilities & u32(4294967287)
    }
    capabilities = capabilities & u32(4294443007)

    esp32HeapAlignmentStore(alignmentAddress, alignment)
    esp32HeapAlignmentStore(sizeAddress, size)
    esp32HeapAlignmentStore(capabilitiesAddress, capabilities)
    return
}

// Compatibility for the still-lifted heap-capability callers. This is normal
// Abla and becomes unnecessary when that module is converted.
trusted fun esp32RecoveredEspHeapAdjustAlignmentToHw(
    alignmentAddress: u32,
    sizeAddress: u32,
    capabilitiesAddress: u32,
    a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32HeapAdjustAlignmentToHardware(
        alignmentAddress, sizeAddress, capabilitiesAddress
    )
    alignmentAddress
}
