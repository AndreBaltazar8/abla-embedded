import "../rom/cache_control_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"

@section(".iram1.abla.cache_flush")
trusted fun esp32CacheFlush(cpu:u32):void {
    esp32RecoveredEspIpcIsrStallOtherCpu(u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0))
    esp32RomCacheFlushValue(cpu)
    esp32RecoveredEspIpcIsrReleaseOtherCpu(u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0))
    return
}

val esp32CacheDriverStateStorage = nativeStaticMutableU32s([
    int(u32(nativeFunctionAddress(esp32CacheFlush))), 0
])
val esp32CacheDriverState = u32(esp32CacheDriverStateStorage)

trusted fun esp32CacheRegisterWriteback(driver:u32):void {
    val writeback = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(driver + u32(4)))))
    ablaUnsafeStoreU32(nativePointerFromAddress(
        int(esp32CacheDriverState + u32(4))), int(writeback))
}

@section(".iram1.abla.cache_sync")
trusted fun esp32CacheSync():void {
    val writeback = u32(ablaUnsafeLoadU32(nativePointerFromAddress(
        int(esp32CacheDriverState + u32(4)))))
    if (writeback != u32(0)) {
        ablaUnsafeCallI32I32I32I32I32I32I32(int(writeback),int(u32(0)),
            int(u32(0)),int(u32(0)),int(u32(0)),int(u32(0)),int(u32(0)))
    }
    val flush = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(esp32CacheDriverState))))
    ablaUnsafeCallI32I32I32I32I32I32I32(int(flush),int(u32(0)),int(u32(0)),
        int(u32(0)),int(u32(0)),int(u32(0)),int(u32(0)))
    ablaUnsafeCallI32I32(int(flush), int(u32(1)))
    return
}

trusted fun esp32RecoveredCacheRegisterWriteback(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32CacheRegisterWriteback(a2); a2 }

@section(".iram1.abla.cache_sync_recovered")
trusted fun esp32RecoveredCacheSync(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32CacheSync(); a2 }
