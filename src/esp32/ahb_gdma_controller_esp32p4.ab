import "./ahb_gdma_controller_p4_sequence.ab"
import "../riscv/memory.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("p4AhbControllerRead")
trusted fun p4AhbControllerReadHook(address: int): int = mmioLoadU32(address)
@export("p4AhbControllerWrite")
trusted fun p4AhbControllerWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
@export("p4AhbControllerFence")
trusted fun p4AhbControllerFenceHook(): void = riscvDeviceMemoryFence()
