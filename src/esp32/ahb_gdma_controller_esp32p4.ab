import "./ahb_gdma_controller_p4_sequence.ab"
import "../riscv/memory.ab"
import "abla/unsafe/mmio"
trusted fun p4AhbControllerRead(address: int): int = mmioLoadU32(address)
trusted fun p4AhbControllerWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
trusted fun p4AhbControllerFence(): void = riscvDeviceMemoryFence()
