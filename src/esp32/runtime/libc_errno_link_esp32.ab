import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcErrnoOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredErrno", "__errno")) return false
    if (!internalFunction(
        "esp32RecoveredErrnoStorage", "abla_esp32_errno_storage"
    )) return false
    true
}
