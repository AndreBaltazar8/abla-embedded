import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcTzsetOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredTzsetUnlocked", "_tzset_unlocked")) return false
    if (!internalFunction("esp32RecoveredTzset", "tzset")) return false
    true
}
