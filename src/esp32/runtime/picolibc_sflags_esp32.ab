import "abla/unsafe/memory"
import "libc_errno_esp32.ab"

// Parse the ISO C fopen mode string into picolibc stream flags and open flags.
// Keeping this as ordinary control flow lets LLVM fold constant mode strings.
trusted fun esp32PicolibcStdioFlags(mode: u32, openFlagsOut: u32): u32 {
    val first = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(mode))))
    var openFlags = u32(0)
    var streamFlags = u32(0)

    if (first == u32(114)) { // r
        streamFlags = u32(1)
    } else if (first == u32(119)) { // w
        openFlags = u32(577)
        streamFlags = u32(2)
    } else if (first == u32(97)) { // a
        openFlags = u32(1089)
        streamFlags = u32(2)
    } else {
        esp32LibcSetErrno(u32(22))
        return u32(0)
    }

    var cursor = mode + u32(1)
    while (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(cursor)))) != u32(0)) {
        if (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(cursor)))) == u32(43)) { // +
            openFlags = (openFlags & u32(4294967292)) | u32(2)
            streamFlags = u32(3)
        }
        cursor = cursor + u32(1)
    }

    ablaUnsafeStoreU32(nativePointerFromAddress(int(openFlagsOut)), int(openFlags))
    streamFlags
}

trusted fun esp32RecoveredStdioFlags(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcStdioFlags(a2, a3)
