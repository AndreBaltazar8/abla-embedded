import "../../runtime/freestanding_memory.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "picolibc_filestrput_esp32.ab"

@inline
trusted fun esp32SnprintfStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32PicolibcSnprintf(
    buffer:u32,size:u32,format:u32,arg0:u32,arg1:u32,arg2:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
):u32 {
    val frame = u32(nativeStackAllocate(112))
    freestandingSet(frame, i32(0), u32(36))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(frame + u32(2))), int(u32(2)))
    esp32SnprintfStoreU32(frame + u32(4), u32(nativeFunctionAddress(esp32RecoveredFileStrPut)))
    esp32SnprintfStoreU32(frame + u32(16), u32(1))
    esp32SnprintfStoreU32(frame + u32(20), buffer)

    var bufferEnd = buffer
    if (i32(size) < 0) bufferEnd = u32(0)
    else if (size != u32(0)) bufferEnd = buffer + size - u32(1)
    esp32SnprintfStoreU32(frame + u32(24), bufferEnd)

    val registerArgs = frame + u32(48)
    val overflowArgs = frame + u32(80)
    esp32SnprintfStoreU32(frame + u32(36), overflowArgs)
    esp32SnprintfStoreU32(frame + u32(40), registerArgs)
    esp32SnprintfStoreU32(frame + u32(44), u32(12))
    esp32SnprintfStoreU32(frame + u32(60), arg0)
    esp32SnprintfStoreU32(frame + u32(64), arg1)
    esp32SnprintfStoreU32(frame + u32(68), arg2)

    val result = esp32RecoveredVfprintf(frame, format, overflowArgs, registerArgs,
        u32(12),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0))
    if (size != u32(0)) {
        val cursor = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(frame + u32(20)))))
        ablaUnsafeStoreU8(nativePointerFromAddress(int(cursor)), int(u32(0)))
    }
    result
}

trusted fun esp32RecoveredSnprintf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PicolibcSnprintf(a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
