import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCxxGuardOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredCxaGuardAcquire", "__cxa_guard_acquire")) return false
    if (!internalFunction("esp32RecoveredCxaGuardRelease", "__cxa_guard_release")) return false
    if (!internalFunction("esp32RecoveredCxaGuardAbort", "__cxa_guard_abort")) return false
    if (!exportFunction("esp32RecoveredCxaGuardDummy", "__cxa_guard_dummy")) return false
    true
}
