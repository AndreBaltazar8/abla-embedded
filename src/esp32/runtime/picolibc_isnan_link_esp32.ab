import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcIsnanCallers(): bool {
    if (!internalFunction("esp32PicolibcIsnand", "__isnand")) return false
    if (!internalFunction("esp32PicolibcIsnan", "isnan")) return false
    if (!internalFunction("esp32PicolibcIsnanl", "isnanl")) return false
    if (!internalFunction("esp32PicolibcInternalIsnanl", "__isnanl")) return false
    true
}
