import "../../runtime/freestanding_memory.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "picolibc_filestrput_esp32.ab"

@inline
trusted fun esp32SprintfStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

// Xtensa variadic register layout is explicit here, but the implementation is
// ordinary structured Abla. The temporary FILE/va_list layout is picolibc's.
trusted fun esp32PicolibcSprintf(
    buffer:u32,format:u32,arg0:u32,arg1:u32,arg2:u32,arg3:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
):u32 {
    val frame = u32(nativeStackAllocate(112))
    freestandingSet(frame, i32(0), u32(36))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(frame + u32(2))), int(u32(2)))
    esp32SprintfStoreU32(frame + u32(4), u32(nativeFunctionAddress(esp32RecoveredFileStrPut)))
    esp32SprintfStoreU32(frame + u32(16), u32(1))
    esp32SprintfStoreU32(frame + u32(20), buffer)

    val registerArgs = frame + u32(48)
    val overflowArgs = frame + u32(80)
    esp32SprintfStoreU32(frame + u32(36), overflowArgs)
    esp32SprintfStoreU32(frame + u32(40), registerArgs)
    esp32SprintfStoreU32(frame + u32(44), u32(8))
    esp32SprintfStoreU32(frame + u32(56), arg0)
    esp32SprintfStoreU32(frame + u32(60), arg1)
    esp32SprintfStoreU32(frame + u32(64), arg2)
    esp32SprintfStoreU32(frame + u32(68), arg3)

    val result = esp32RecoveredVfprintf(frame, format, overflowArgs, registerArgs,
        u32(8),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0))
    if (i32(result) >= 0) {
        ablaUnsafeStoreU8(nativePointerFromAddress(int(buffer + result)), int(u32(0)))
    }
    result
}

trusted fun esp32RecoveredSprintf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PicolibcSprintf(a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
