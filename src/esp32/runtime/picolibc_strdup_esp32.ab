import "libc_heap_esp32.ab"
import "../../runtime/freestanding_memory.ab"

trusted fun esp32StringDuplicate(source: u32): u32 {
    val length = freestandingStringLength(source) + u32(1)
    val destination = esp32LibcMalloc(length)
    if (destination != u32(0)) {
        freestandingCopy(destination, source, length)
    }
    return destination
}

trusted fun esp32RecoveredStrdup(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32StringDuplicate(a2)
