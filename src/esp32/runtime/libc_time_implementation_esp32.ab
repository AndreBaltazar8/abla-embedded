import "abla/unsafe/memory"
import "abla/unsafe/mmio"

// Structured Abla implementation of ESP-IDF esp_time_impl.c.
// Both configured clocks are retained: the RTC persists across sleep while
// the high-resolution timer supplies normal runtime precision.
var esp32TimeMicrosecondsOffset = i64(0)
val esp32BootTimeLockStorage = nativeStaticAllocate(4)
val esp32BootTimeLock = u32(esp32BootTimeLockStorage)
val esp32RtcBootTimeLowRegister = u32(1072988244)
val esp32RtcBootTimeHighRegister = u32(1072988248)

@inline
trusted fun esp32TimeLoadU32(address:u32):u32 =
    u32(ablaUnsafeVolatileLoadU32(int(address)))

@inline
trusted fun esp32TimeStoreU32(address:u32, value:u32):void =
    ablaUnsafeVolatileStoreU32(int(address), int(value))

trusted fun esp32TimeLock():void {
    esp32RecoveredLockAcquire(
        esp32BootTimeLock,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}

trusted fun esp32TimeUnlock():void {
    esp32RecoveredLockRelease(
        esp32BootTimeLock,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}

trusted fun esp32TimeSinceBoot():u64 =
    u64(i64(esp32SystemGetTime()) + esp32TimeMicrosecondsOffset)

trusted fun esp32TimeCurrentTimer():u64 = esp32SystemGetTime()

trusted fun esp32TimeSetBootTime(microseconds:u64):void {
    esp32TimeLock()
    xtensaMemoryBarrier()
    esp32TimeStoreU32(esp32RtcBootTimeLowRegister, u32(microseconds))
    xtensaMemoryBarrier()
    esp32TimeStoreU32(esp32RtcBootTimeHighRegister, u32(microseconds >>> u64(32)))
    esp32TimeUnlock()
}

trusted fun esp32TimeGetBootTime():u64 {
    esp32TimeLock()
    xtensaMemoryBarrier()
    val low = esp32TimeLoadU32(esp32RtcBootTimeLowRegister)
    xtensaMemoryBarrier()
    val high = esp32TimeLoadU32(esp32RtcBootTimeHighRegister)
    esp32TimeUnlock()
    (u64(high) << u64(32)) | u64(low)
}

trusted fun esp32SetTimeFromRtc():void {
    esp32TimeMicrosecondsOffset =
        i64(esp32RtcTimeMicroseconds()) - i64(esp32SystemGetTime())
    return
}

trusted fun esp32SyncTimekeepingTimers():void {
    val timeval = u32(nativeStackAllocate(16))
    esp32RecoveredGettimeofday(
        timeval,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32RecoveredSettimeofday(
        timeval,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    val currentOffset =
        i64(esp32RtcTimeMicroseconds()) - i64(esp32SystemGetTime())
    esp32TimeSetBootTime(
        u64(i64(esp32TimeGetBootTime()) + esp32TimeMicrosecondsOffset - currentOffset))
}

// Internal compatibility adapters for the remaining lifted libc-time callers.
trusted fun esp32RecoveredEspTimeImplGetTimeSinceBoot(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = u32(esp32TimeSinceBoot())
trusted fun esp32RecoveredEspTimeImplGetTime(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = u32(esp32TimeCurrentTimer())
trusted fun esp32RecoveredEspTimeImplSetBootTime(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32TimeSetBootTime((u64(a3) << u64(32)) | u64(a2)); a2 }
trusted fun esp32RecoveredEspTimeImplGetBootTime(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = u32(esp32TimeGetBootTime())
trusted fun esp32RecoveredEspSetTimeFromRtc(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32SetTimeFromRtc(); a2 }
trusted fun esp32RecoveredEspSyncTimekeepingTimers(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32SyncTimekeepingTimers(); a2 }
