import "../vfs/calls_esp32.ab"
import "../../runtime/freestanding_integer.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Structured-Abla libc facade. Reentrant and non-reentrant calls share the
// same typed VFS implementation, so LLVM can inline through this entire layer.
val esp32LibcFailure = u32(0xffffffff)
val esp32LibcNotImplemented = u32(88)
val esp32LibcCharacterDevice = u32(8192)

@inline trusted fun esp32LibcSyscallSetErrno(value: u32): void =
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(u32(
            nativeInternalSectionThreadLocalAllocate(
                4, "errno", ".tdata.errno", 4
            )
        ))),
        int(value)
    )

// open() is variadic only when O_CREAT is set. On Xtensa the first variadic
// word is a4; keeping this ABI capture explicit avoids a generic va_list box.
trusted fun esp32LibcOpenAbi(
    path:u32,flags:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
): u32 = esp32VfsOpen(
    u32(0), path, flags,
    if ((flags & u32(64)) != u32(0)) a4 else u32(0)
)

trusted fun esp32LibcClose(fd: u32): u32 =
    esp32VfsClose(u32(0), fd)

trusted fun esp32LibcRead(
    fd: u32, data: u32, size: u32
): u32 = esp32VfsRead(u32(0), fd, data, size)

trusted fun esp32LibcWrite(
    fd: u32, data: u32, size: u32
): u32 = esp32VfsWrite(u32(0), fd, data, size)

trusted fun esp32LibcLseek(
    fd: u32, offset: u32, whence: u32
): u32 = esp32VfsLseek(u32(0), fd, offset, whence)

trusted fun esp32LibcCreat(path: u32, mode: u32): u32 =
    esp32VfsOpen(u32(0), path, u32(577), mode)

trusted fun esp32LibcGettimeofday(
    time: u32, timezone: u32
): u32 = esp32RecoveredGettimeofdayR(
    u32(0),time,timezone,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LibcTimes(output: u32): u32 =
    esp32RecoveredTimesR(
        u32(0),output,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LibcUnlink(path: u32): u32 =
    esp32VfsUnlink(u32(0), path)

trusted fun esp32LibcStat(path: u32, status: u32): u32 =
    esp32VfsStat(u32(0), path, status)

trusted fun esp32LibcLink(
    source: u32, destination: u32
): u32 = esp32VfsLink(u32(0), source, destination)

trusted fun esp32LibcRename(
    source: u32, destination: u32
): u32 = esp32VfsRename(u32(0), source, destination)

trusted fun esp32LibcIsatty(fd: u32): u32 {
    val status = u32(nativeStackAllocate(88))
    if (esp32VfsFstat(u32(0), fd, status) == esp32LibcFailure) {
        return u32(0)
    }
    val mode = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(status + u32(4)))
    )) & u32(0xf000)
    return if (mode == esp32LibcCharacterDevice) u32(1) else u32(0)
}

// fcntl() consumes one variadic register word on this ABI.
trusted fun esp32LibcFcntlAbi(
    fd:u32,command:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
): u32 = esp32VfsFcntl(u32(0), fd, command, a4)

trusted fun esp32LibcGetpid(): u32 =
    esp32RecoveredGetpidR(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LibcExit(status: u32): u32 {
    freestandingAbortValue()
    ablaRuntimeTrap()
    return status
}

trusted fun esp32LibcFstat(fd: u32, status: u32): u32 =
    esp32VfsFstat(u32(0), fd, status)

trusted fun esp32LibcSystem(command: u32): u32 =
    esp32RecoveredGetpidR(
        u32(0),command,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LibcStatvfs(path: u32, output: u32): u32 {
    esp32LibcSyscallSetErrno(esp32LibcNotImplemented)
    return esp32LibcFailure
}

trusted fun esp32LibcFstatvfs(fd: u32, output: u32): u32 {
    esp32LibcSyscallSetErrno(esp32LibcNotImplemented)
    return esp32LibcFailure
}

trusted fun esp32LibcIncludeSyscalls(): void {}

// Internal compatibility names for neighboring lifted Abla. Unlike the old
// bodies, these are one-expression calls and disappear after inlining.
trusted fun esp32RecoveredOpen(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcOpenAbi(a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
trusted fun esp32RecoveredClose(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcClose(a2)
trusted fun esp32RecoveredRead(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcRead(a2,a3,a4)
trusted fun esp32RecoveredWrite(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcWrite(a2,a3,a4)
trusted fun esp32RecoveredLseek(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcLseek(a2,a3,a4)
trusted fun esp32RecoveredCreat(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcCreat(a2,a3)
trusted fun esp32RecoveredGettimeofday(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcGettimeofday(a2,a3)
trusted fun esp32RecoveredTimes(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcTimes(a2)
trusted fun esp32RecoveredUnlink(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcUnlink(a2)
trusted fun esp32RecoveredStat(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcStat(a2,a3)
trusted fun esp32RecoveredLink(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcLink(a2,a3)
trusted fun esp32RecoveredRename(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcRename(a2,a3)
trusted fun esp32RecoveredIsatty(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcIsatty(a2)
trusted fun esp32RecoveredFcntl(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcFcntlAbi(a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
trusted fun esp32RecoveredGetpid(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcGetpid()
trusted fun esp32RecoveredExit(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LibcExit(a2)
