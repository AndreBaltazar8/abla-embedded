import "picolibc_stream_lock_esp32.ab"
import "picolibc_stream_pushback_esp32.ab"
import "abla/unsafe/memory"

trusted fun esp32PicolibcUngetc(character: u32, stream: u32): u32 {
    val lock = esp32PicolibcStreamLock(stream)
    val flagsAddress = stream + u32(2)
    var flags = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(flagsAddress))))
    if ((flags & u32(1)) == u32(0) ||
        character == u32(4294967295) ||
        !esp32PicolibcStorePushback(stream, character)) {
        esp32PicolibcStreamUnlock(lock)
        return u32(4294967295)
    }

    flags = flags & u32(4294967287)
    ablaUnsafeStoreU8(nativePointerFromAddress(int(flagsAddress)), int(flags))
    esp32PicolibcStreamUnlock(lock)
    character
}

trusted fun esp32RecoveredUngetc(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcUngetc(a2, a3)
