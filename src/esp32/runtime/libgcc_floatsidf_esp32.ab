import "binary64_esp32.ab"
import "abla/integer"

trusted fun esp32Unsigned32ToBinary64(value:u32):u64 {
    if (value == u32(0)) return u64(0)
    val leading = u32(ablaCountLeadingZerosU32(value))
    val highestBit = u32(31) - leading
    val exponent = highestBit + u32(1023)
    val normalized = u64(value) << u64(u32(52) - highestBit)
    (u64(exponent) << u64(52)) | (normalized & esp32Binary64FractionMask)
}

trusted fun esp32Signed32ToBinary64(value:i32):u64 {
    if (value == i32(0)) return u64(0)
    val raw = u32(value)
    if (value < i32(0)) {
        return esp32Binary64SignMask | esp32Unsigned32ToBinary64(u32(0) - raw)
    }
    esp32Unsigned32ToBinary64(raw)
}

trusted fun esp32LibgccFloatunsidf(value:u32):u64 =
    esp32Unsigned32ToBinary64(value)

trusted fun esp32LibgccFloatsidf(value:i32):u64 =
    esp32Signed32ToBinary64(value)

trusted fun esp32RecoveredFloatunsidf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u64 = esp32LibgccFloatunsidf(a2)

trusted fun esp32RecoveredFloatsidf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u64 = esp32LibgccFloatsidf(i32(a2))
