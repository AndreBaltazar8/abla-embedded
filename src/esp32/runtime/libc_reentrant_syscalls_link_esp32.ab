import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcReentrantSyscallsOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredGetpidR", "_getpid_r")) return false
    if (!internalFunction("esp32RecoveredRaiseR", "_raise_r")) return false
    if (!internalFunction("esp32RecoveredEspLibcIncludeReentSyscallsImpl", "esp_libc_include_reent_syscalls_impl")) return false
    true
}
