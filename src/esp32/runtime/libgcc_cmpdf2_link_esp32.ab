import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibgccCmpDf2OpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEqdf2", "__eqdf2")) return false
    if (!internalFunction("esp32RecoveredGtdf2", "__gtdf2")) return false
    if (!internalFunction("esp32RecoveredLedf2", "__ledf2")) return false
    if (!internalFunction("esp32RecoveredGedf2", "__gedf2")) return false
    if (!internalFunction("esp32RecoveredLtdf2", "__ltdf2")) return false
    if (!internalFunction("esp32RecoveredUnorddf2", "__unorddf2")) return false
    true
}
