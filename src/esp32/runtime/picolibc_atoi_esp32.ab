import "picolibc_strtol_esp32.ab"

trusted fun esp32PicolibcAtoi(input: u32): u32 =
    esp32PicolibcStrtol(input, u32(0), u32(10))

trusted fun esp32RecoveredAtoi(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcAtoi(a2)
