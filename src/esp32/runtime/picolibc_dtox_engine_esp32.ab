import "abla/unsafe/memory"

// Picolibc hexadecimal floating-point conversion, written directly in Abla.
// The input is the IEEE-754 bit pattern, so no host floating-point ABI is
// involved and LLVM can optimize the integer conversion with its caller.

@inline
trusted fun esp32DtoxStoreU8(address:u32, value:u32):void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32DtoxStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32PicolibcDtoxEngine(
    bits:u64, dtoa:u32, precision:i32, caseConvert:u32
):i32 {
    val sign = u32(bits >>> u64(63))
    esp32DtoxStoreU8(dtoa + u32(4), sign)

    var exponent = i32(u32((bits >>> u64(52)) & u64(0x7ff)))
    var significand = bits & u64(0x000fffffffffffff)

    if (significand != u64(0) || exponent != i32(0)) {
        if (exponent == i32(0x7ff)) {
            val exceptionalFlag = if (significand != u64(0)) u32(8) else u32(4)
            esp32DtoxStoreU8(dtoa + u32(4), sign | exceptionalFlag)
            return i32(0)
        }

        if (exponent == i32(0)) exponent = i32(1)
        else significand = significand | u64(0x0010000000000000)
        exponent = exponent - i32(1023)
    }
    esp32DtoxStoreU32(dtoa, u32(exponent))

    var outputPrecision = precision
    if (outputPrecision < i32(0)) outputPrecision = i32(0)
    else if (outputPrecision >= i32(13)) outputPrecision = i32(13)
    else {
        val discardedBits = u32((i32(13) - outputPrecision) * i32(4))
        val half = u64(1) << u64(discardedBits - u32(1))
        val mask = ~((half << u64(1)) - u64(1))
        val discarded = significand & ~mask

        // Round to nearest, ties to even.
        if (
            discarded > half ||
            ((significand >>> u64(discardedBits)) & u64(1)) != u64(0)
        ) significand = significand + half
        significand = significand & mask
    }

    var digitIndex = i32(13)
    while (digitIndex >= i32(0)) {
        val nibble = u32(significand & u64(0xf))
        significand = significand >>> u64(4)

        if (nibble != u32(0) || digitIndex <= outputPrecision) {
            val character = if (nibble > u32(9))
                nibble + u32(87) - caseConvert
            else nibble + u32(48)
            esp32DtoxStoreU8(dtoa + u32(5) + u32(digitIndex), character)
            if (outputPrecision < digitIndex) outputPrecision = digitIndex
        }
        digitIndex = digitIndex - i32(1)
    }
    outputPrecision
}

// Temporary adapter for the lifted vfprintf implementation.
trusted fun esp32RecoveredDtoxEngine(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = u32(esp32PicolibcDtoxEngine(
    u64(a2) | (u64(a3) << u64(32)), a4, i32(a5), a6
))
