import "../../runtime/freestanding_integer.ab"

// Typed implementation of the compiler's signed 64-bit division ABI.  This
// is ordinary Abla: LLVM receives the same i64 -> i64 contract as __divdi3,
// while the arithmetic itself uses the restoring divider in the shared
// freestanding runtime and therefore cannot recursively request libgcc.
trusted fun esp32SignedDivide64(
    dividend: i64,
    divisor: i64
): i64 = freestandingSignedDivide(dividend, divisor)

// Transitional adapter for recovered callers which still represent Xtensa
// a2:a3 and a4:a5 register pairs explicitly and consume only the low result
// word.  Delete this after those callers have typed i64 values themselves.
trusted fun esp32RecoveredDivdi3(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 = u32(esp32SignedDivide64(
    i64((u64(a3) << u64(32)) | u64(a2)),
    i64((u64(a5) << u64(32)) | u64(a4))
))
