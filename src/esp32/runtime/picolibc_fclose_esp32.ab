import "abla/unsafe/memory"
import "abla/unsafe/native"
import "picolibc_fflush_esp32.ab"

trusted fun esp32PicolibcFclose(stream: u32): u32 {
    if (stream == u32(0)) return u32(0)
    esp32PicolibcFflush(stream)

    val lock = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(stream + u32(16)))))
    if (lock >= u32(2)) {
        esp32RecoveredRetargetLockClose(
            lock, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    }

    val streamFlags = u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(stream + u32(2)))
    ))
    if ((streamFlags & u32(16)) == u32(0)) return u32(0)

    val closeFunction = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(stream + u32(20)))
    ))
    if (closeFunction == u32(0)) return u32(0)
    u32(ablaUnsafeCallI32I32I32I32I32I32I32(
        int(closeFunction), int(stream), 0, 0, 0, 0, 0
    ))
}

trusted fun esp32RecoveredFclose(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFclose(a2)
