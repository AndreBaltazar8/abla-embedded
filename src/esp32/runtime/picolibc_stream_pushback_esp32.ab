import "../../atomic.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32PicolibcPushbackWordAddress(stream: u32): u32 =
    stream & u32(4294967292)

@inline
trusted fun esp32PicolibcPushbackShift(stream: u32): u32 =
    (stream & u32(3)) * u32(8)

trusted fun esp32PicolibcTakePushback(stream: u32): u32 {
    val address = esp32PicolibcPushbackWordAddress(stream)
    val shift = esp32PicolibcPushbackShift(stream)
    val mask = u32(65535) << shift
    val atomicWord = atomicU32At(int(address))
    var observed = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))
    while (true) {
        val pushback = (observed >>> shift) & u32(65535)
        if (pushback == u32(0)) return u32(0)
        val replacement = observed & (mask ^ u32(4294967295))
        val actual = atomicWord.compareExchange(observed, replacement)
        if (actual == observed) return pushback
        observed = actual
    }
    u32(0)
}

trusted fun esp32PicolibcStorePushback(stream: u32, character: u32): bool {
    val address = esp32PicolibcPushbackWordAddress(stream)
    val shift = esp32PicolibcPushbackShift(stream)
    val mask = u32(65535) << shift
    val encoded = ((character & u32(255)) + u32(1)) << shift
    val atomicWord = atomicU32At(int(address))
    var observed = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))
    while (true) {
        if ((observed & mask) != u32(0)) return false
        val replacement = (observed & (mask ^ u32(4294967295))) | encoded
        val actual = atomicWord.compareExchange(observed, replacement)
        if (actual == observed) return true
        observed = actual
    }
    false
}

trusted fun esp32PicolibcClearPushback(stream: u32): void {
    esp32PicolibcTakePushback(stream)
    return
}
