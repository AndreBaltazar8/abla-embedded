import "abla/build"

// Standard ABI spellings resolve to the typed monolithic implementations.
// They stay internal so unused libc surface remains prunable.
compile fun esp32Idf6LinkLibcSyscallsOpaqueCallers(): bool {
    if (!internalFunction("esp32LibcOpenAbi", "open")) return false
    if (!internalFunction("esp32LibcClose", "close")) return false
    if (!internalFunction("esp32LibcRead", "read")) return false
    if (!internalFunction("esp32LibcWrite", "write")) return false
    if (!internalFunction("esp32LibcLseek", "lseek")) return false
    if (!internalFunction("esp32LibcCreat", "creat")) return false
    if (!internalFunction("esp32LibcGettimeofday", "gettimeofday")) return false
    if (!internalFunction("esp32LibcTimes", "times")) return false
    if (!internalFunction("esp32LibcUnlink", "unlink")) return false
    if (!internalFunction("esp32LibcStat", "stat")) return false
    if (!internalFunction("esp32LibcLink", "link")) return false
    if (!internalFunction("esp32LibcRename", "rename")) return false
    if (!internalFunction("esp32LibcIsatty", "isatty")) return false
    if (!internalFunction("esp32LibcFcntlAbi", "fcntl")) return false
    if (!internalFunction("esp32LibcGetpid", "getpid")) return false
    if (!internalFunction("esp32LibcExit", "_exit")) return false
    if (!internalFunction("esp32LibcFstat", "fstat")) return false
    if (!internalFunction("esp32LibcSystem", "system")) return false
    if (!internalFunction("esp32LibcStatvfs", "statvfs")) return false
    if (!internalFunction("esp32LibcFstatvfs", "fstatvfs")) return false
    if (!internalFunction("esp32LibcIncludeSyscalls", "esp_libc_include_syscalls_impl")) return false
    true
}
