import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcTimeImplementationInternals(): bool {
    if (!internalFunction("esp32TimeSinceBoot", "esp_time_impl_get_time_since_boot")) return false
    if (!internalFunction("esp32TimeCurrentTimer", "esp_time_impl_get_time")) return false
    if (!internalFunction("esp32TimeSetBootTime", "esp_time_impl_set_boot_time")) return false
    if (!internalFunction("esp32TimeGetBootTime", "esp_time_impl_get_boot_time")) return false
    if (!internalFunction("esp32SetTimeFromRtc", "esp_set_time_from_rtc")) return false
    if (!internalFunction("esp32SyncTimekeepingTimers", "esp_sync_timekeeping_timers")) return false
    true
}
