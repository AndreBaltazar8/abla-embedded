import "abla/unsafe/memory"
import "abla/unsafe/native"
import "libc_syscalls_esp32.ab"
import "picolibc_sflags_esp32.ab"
import "picolibc_fdopen_esp32.ab"

trusted fun esp32PicolibcFopen(path: u32, mode: u32): u32 {
    val flagsAddress = u32(nativeStackAllocate(4))
    if (esp32PicolibcStdioFlags(mode, flagsAddress) == u32(0)) return u32(0)

    val flags = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(flagsAddress))))
    val descriptor = esp32LibcOpenAbi(
        path, flags, u32(438), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (i32(descriptor) < 0) return u32(0)
    esp32PicolibcFdopen(descriptor, mode)
}

trusted fun esp32RecoveredFopen(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFopen(a2, a3)
