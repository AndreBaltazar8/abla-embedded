import "libc_heap_esp32.ab"
import "libc_syscalls_esp32.ab"
import "picolibc_bufio_esp32.ab"
import "picolibc_sflags_esp32.ab"
import "picolibc_fseeko_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32PicolibcFdopen(descriptor: u32, mode: u32): u32 {
    val flagsAddress = u32(nativeStackAllocate(4))
    val streamMode = esp32PicolibcStdioFlags(mode, flagsAddress)
    if (streamMode == u32(0)) return u32(0)

    val stream = esp32LibcCalloc(u32(1), u32(76))
    if (stream == u32(0)) {
        esp32LibcClose(descriptor)
        return u32(0)
    }

    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(stream + u32(2))),
        int(streamMode | u32(112))
    )
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(4))),
        int(u32(nativeFunctionAddress(esp32RecoveredBufioPut))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(8))),
        int(u32(nativeFunctionAddress(esp32RecoveredBufioGet))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(12))),
        int(u32(nativeFunctionAddress(esp32RecoveredBufioFlush))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(20))),
        int(u32(nativeFunctionAddress(esp32RecoveredBufioClose))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(24))),
        int(u32(nativeFunctionAddress(esp32RecoveredBufioSeek))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(28))),
        int(u32(nativeFunctionAddress(esp32RecoveredBufioSetvbuf))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(32))), int(descriptor))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(stream + u32(37))), 4)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(48))), -1)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(60))),
        int(u32(nativeFunctionAddress(esp32LibcRead))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(64))),
        int(u32(nativeFunctionAddress(esp32LibcWrite))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(68))),
        int(u32(nativeFunctionAddress(esp32LibcLseek))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stream + u32(72))),
        int(u32(nativeFunctionAddress(esp32LibcClose))))

    val openFlags = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(flagsAddress))))
    if ((openFlags & u32(1024)) != u32(0)) {
        esp32PicolibcFseeko(stream, u32(0), u32(2))
    }
    stream
}

trusted fun esp32RecoveredFdopen(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFdopen(a2, a3)
