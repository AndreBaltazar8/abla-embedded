import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcMktimeOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredMktime", "mktime")) return false
    if (!internalFunction("esp32RecoveredTimegm", "timegm")) return false
    true
}
