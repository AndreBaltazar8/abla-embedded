// Abla/LLVM implementation of Ryu base-10 exponent estimates.

// Original ABI symbol: __log10Pow2
@inline
trusted fun esp32RecoveredLog10Pow2(value: u32): u32 =
    (value * u32(78913)) >>> u32(18)

// Original ABI symbol: __log10Pow5
@inline
trusted fun esp32RecoveredLog10Pow5(value: u32): u32 =
    (value * u32(732923)) >>> u32(20)
