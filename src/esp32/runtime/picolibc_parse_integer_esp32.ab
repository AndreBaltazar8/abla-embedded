import "libc_errno_esp32.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32PicolibcIntegerDigit(character: u32): u32 {
    if (character >= u32(48) && character <= u32(57)) return character - u32(48)
    val lower = character | u32(32)
    if (lower >= u32(97) && lower <= u32(122)) return lower - u32(87)
    u32(255)
}

@inline
trusted fun esp32PicolibcIntegerSpace(character: u32): bool =
    character == u32(32) || (character >= u32(9) && character <= u32(13))

trusted fun esp32PicolibcParseInteger(
    input: u32,
    endOut: u32,
    requestedBase: u32,
    signedResult: bool
): u32 {
    if (requestedBase == u32(1) || requestedBase > u32(36)) {
        esp32LibcSetErrno(u32(22))
        if (endOut != u32(0)) {
            ablaUnsafeStoreU32(nativePointerFromAddress(int(endOut)), int(input))
        }
        return u32(0)
    }

    var cursor = input
    while (esp32PicolibcIntegerSpace(u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(cursor))
    )))) cursor = cursor + u32(1)

    var negative = false
    var character = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(cursor))))
    if (character == u32(43) || character == u32(45)) {
        negative = character == u32(45)
        cursor = cursor + u32(1)
        character = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(cursor))))
    }

    var base = requestedBase
    val nextCharacter = u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(cursor + u32(1)))
    ))
    val afterPrefix = u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(cursor + u32(2)))
    ))
    val hasHexPrefix = character == u32(48) &&
        (nextCharacter == u32(120) || nextCharacter == u32(88)) &&
        esp32PicolibcIntegerDigit(afterPrefix) < u32(16)
    if (base == u32(0)) {
        if (hasHexPrefix) {
            base = u32(16)
            cursor = cursor + u32(2)
        } else if (character == u32(48)) {
            base = u32(8)
        } else {
            base = u32(10)
        }
    } else if (base == u32(16) && hasHexPrefix) {
        cursor = cursor + u32(2)
    }

    val limit = if (!signedResult) u32(4294967295)
        else if (negative) u32(2147483648)
        else u32(2147483647)
    var magnitude = u32(0)
    var anyDigit = false
    var overflow = false
    while (true) {
        character = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(cursor))))
        val digit = esp32PicolibcIntegerDigit(character)
        if (digit >= base) break
        anyDigit = true
        if (magnitude > (limit - digit) / base) {
            overflow = true
        } else if (!overflow) {
            magnitude = magnitude * base + digit
        }
        cursor = cursor + u32(1)
    }

    if (endOut != u32(0)) {
        ablaUnsafeStoreU32(
            nativePointerFromAddress(int(endOut)),
            int(if (anyDigit) cursor else input)
        )
    }
    if (overflow) {
        esp32LibcSetErrno(u32(34))
        if (!signedResult) return u32(4294967295)
        return if (negative) u32(2147483648) else u32(2147483647)
    }
    if (negative) return u32(0) - magnitude
    magnitude
}
