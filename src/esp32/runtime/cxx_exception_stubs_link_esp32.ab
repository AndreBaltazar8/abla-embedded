import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCxxExceptionStubOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredWrapCxaCallUnexpected", "__wrap___cxa_call_unexpected")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindFindEnclosingFunction", "__wrap__Unwind_FindEnclosingFunction")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindGetDataRelBase", "__wrap__Unwind_GetDataRelBase")) return false
    if (!internalFunction("esp32RecoveredWrapRegisterFrameInfoBases", "__wrap___register_frame_info_bases")) return false
    if (!internalFunction("esp32RecoveredWrapRegisterFrameInfo", "__wrap___register_frame_info")) return false
    if (!internalFunction("esp32RecoveredWrapRegisterFrameInfoTableBases", "__wrap___register_frame_info_table_bases")) return false
    if (!internalFunction("esp32RecoveredWrapRegisterFrameInfoTable", "__wrap___register_frame_info_table")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindFindFDE", "__wrap__Unwind_Find_FDE")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindGetGR", "__wrap__Unwind_GetGR")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindGetCFA", "__wrap__Unwind_GetCFA")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindSetIP", "__wrap__Unwind_SetIP")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindSetGR", "__wrap__Unwind_SetGR")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindGetIPInfo", "__wrap__Unwind_GetIPInfo")) return false
    if (!internalFunction("esp32RecoveredZ17FrameStateForPvP11frameState", "_Z17__frame_state_forPvP11frame_state")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindResume", "__wrap__Unwind_Resume")) return false
    if (!exportFunction("esp32RecoveredWrapUnwindDeleteException", "__wrap__Unwind_DeleteException")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindDeleteException", "_Unwind_DeleteException")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindRaiseException", "__wrap__Unwind_RaiseException")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindForcedUnwind", "__wrap__Unwind_ForcedUnwind")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindBacktrace", "__wrap__Unwind_Backtrace")) return false
    if (!exportFunction("esp32RecoveredWrapGxxPersonalityV0", "__wrap___gxx_personality_v0")) return false
    if (!exportFunction("esp32RecoveredWrapCxaAllocateException", "__wrap___cxa_allocate_exception")) return false
    if (!exportFunction("esp32RecoveredWrapCxaThrow", "__wrap___cxa_throw")) return false
    if (!internalFunction("esp32RecoveredWrapCxaAllocateException", "__cxa_allocate_exception")) return false
    if (!internalFunction("esp32RecoveredWrapCxaThrow", "__cxa_throw")) return false
    if (!internalFunction("esp32RecoveredAbortExpectVoid", "abort_expect_void")) return false
    if (!internalFunction("esp32RecoveredWrapDeregisterFrame", "__wrap___deregister_frame")) return false
    if (!internalFunction("esp32RecoveredWrapRegisterFrameTable", "__wrap___register_frame_table")) return false
    if (!internalFunction("esp32RecoveredWrapRegisterFrame", "__wrap___register_frame")) return false
    if (!internalFunction("esp32RecoveredAbortExpectVoidAndReturn", "abort_expect_void_and_return")) return false
    if (!internalFunction("esp32RecoveredWrapDeregisterFrameInfo", "__wrap___deregister_frame_info")) return false
    if (!internalFunction("esp32RecoveredWrapDeregisterFrameInfoBases", "__wrap___deregister_frame_info_bases")) return false
    if (!internalFunction("esp32RecoveredForwardAbortUwCtx", "forward_abort_uw_ctx")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindGetLanguageSpecificData", "__wrap__Unwind_GetLanguageSpecificData")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindGetTextRelBase", "__wrap__Unwind_GetTextRelBase")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindGetRegionStart", "__wrap__Unwind_GetRegionStart")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindGetIP", "__wrap__Unwind_GetIP")) return false
    if (!internalFunction("esp32RecoveredWrapUnwindResumeOrRethrow", "__wrap__Unwind_Resume_or_Rethrow")) return false
    true
}
