import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcGetentropyOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredGetentropy", "getentropy")) return false
    if (!internalFunction("esp32RecoveredEspLibcIncludeGetentropyImpl", "esp_libc_include_getentropy_impl")) return false
    true
}
