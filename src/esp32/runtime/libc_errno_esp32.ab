import "abla/unsafe/memory"

// Not `.tdata.errno`: ESP-IDF's linker script asserts that section and the
// stdio slots are exactly picolibc's 16-byte stub, and its libc is linked too.
@inline
trusted fun esp32LibcErrnoAddress(): u32 = u32(
    nativeInternalSectionThreadLocalAllocate(4, "errno", ".tdata.abla_errno", 4)
)

@inline
trusted fun esp32LibcSetErrno(value: u32): void {
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32LibcErrnoAddress())),
        int(value)
    )
}

@inline
trusted fun esp32LibcGetErrno(): u32 = u32(ablaUnsafeLoadU32(
    nativePointerFromAddress(int(esp32LibcErrnoAddress()))
))
