import "abla/unsafe/memory"

@inline
trusted fun esp32PicolibcDelimiterContains(delimiters: u32, character: u32): bool {
    var cursor = delimiters
    while (true) {
        val delimiter = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(cursor))))
        if (delimiter == u32(0)) return false
        if (delimiter == character) return true
        cursor = cursor + u32(1)
    }
    false
}

trusted fun esp32PicolibcStrtokR(
    input: u32,
    delimiters: u32,
    stateAddress: u32,
    skipLeading: bool
): u32 {
    var cursor = input
    if (cursor == u32(0)) {
        cursor = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(stateAddress))))
        if (cursor == u32(0)) return u32(0)
    }

    if (skipLeading) {
        while (true) {
            val character = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(cursor))))
            if (character == u32(0)) {
                ablaUnsafeStoreU32(nativePointerFromAddress(int(stateAddress)), 0)
                return u32(0)
            }
            if (!esp32PicolibcDelimiterContains(delimiters, character)) break
            cursor = cursor + u32(1)
        }
    }

    val token = cursor
    while (true) {
        val character = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(cursor))))
        if (character == u32(0)) {
            ablaUnsafeStoreU32(nativePointerFromAddress(int(stateAddress)), 0)
            return token
        }
        if (esp32PicolibcDelimiterContains(delimiters, character)) {
            ablaUnsafeStoreU8(nativePointerFromAddress(int(cursor)), 0)
            ablaUnsafeStoreU32(
                nativePointerFromAddress(int(stateAddress)),
                int(cursor + u32(1))
            )
            return token
        }
        cursor = cursor + u32(1)
    }
    token
}

trusted fun esp32PicolibcInternalStrtokR(
    input: u32,
    delimiters: u32,
    stateAddress: u32,
    skipLeading: u32
): u32 = esp32PicolibcStrtokR(input, delimiters, stateAddress, skipLeading != u32(0))

trusted fun esp32PicolibcPublicStrtokR(
    input: u32,
    delimiters: u32,
    stateAddress: u32
): u32 = esp32PicolibcStrtokR(input, delimiters, stateAddress, true)

trusted fun esp32RecoveredInternalStrtokR(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcInternalStrtokR(a2, a3, a4, a5)

trusted fun esp32RecoveredStrtokR(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcPublicStrtokR(a2, a3, a4)
