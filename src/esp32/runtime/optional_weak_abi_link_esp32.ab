import "abla/build"

compile fun esp32LinkOptionalWeakAbiSymbols(): bool {
    if (!internalFunction("esp32DefaultUserStrerror", "_user_strerror")) return false
    if (!exportFunction("esp32DefaultBlockAbsorbPostHook", "block_absorb_post_hook")) return false
    if (!exportFunction("esp32DefaultTaskWdtIsrUserHandler", "esp_task_wdt_isr_user_handler")) return false
    if (!exportFunction("esp32DefaultPortStartAppHook", "port_start_app_hook")) return false
    true
}
