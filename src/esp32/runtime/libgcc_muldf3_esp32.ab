import "./binary64_esp32.ab"

// Complete integer implementation of binary64 multiplication. The u64 ABI is
// word-for-word identical to Xtensa's double ABI, while avoiding any floating
// operation that could recursively request __muldf3.
trusted fun esp32Binary64Multiply(left: u64, right: u64): u64 {
    val sign = (left ^ right) & esp32Binary64SignMask
    val leftExponentBits = esp32Binary64Exponent(left)
    val rightExponentBits = esp32Binary64Exponent(right)
    var leftSignificand = esp32Binary64Fraction(left)
    var rightSignificand = esp32Binary64Fraction(right)

    if (leftExponentBits == u32(2047)) {
        if (leftSignificand != u64(0)) return esp32Binary64QuietNanFrom(left)
        if (rightExponentBits == u32(2047) &&
            rightSignificand != u64(0)) return esp32Binary64QuietNanFrom(right)
        if (rightExponentBits == u32(0) &&
            rightSignificand == u64(0)) return esp32Binary64QuietNan
        return sign | esp32Binary64Infinity
    }
    if (rightExponentBits == u32(2047)) {
        if (rightSignificand != u64(0)) return esp32Binary64QuietNanFrom(right)
        if (leftExponentBits == u32(0) &&
            leftSignificand == u64(0)) return esp32Binary64QuietNan
        return sign | esp32Binary64Infinity
    }
    if ((leftExponentBits == u32(0) && leftSignificand == u64(0)) ||
        (rightExponentBits == u32(0) && rightSignificand == u64(0))) {
        return sign
    }

    var leftExponent = i32(leftExponentBits) - i32(1023)
    if (leftExponentBits == u32(0)) {
        leftExponent = i32(-1022)
        while (leftSignificand < esp32Binary64HiddenBit) {
            leftSignificand = leftSignificand << u64(1)
            leftExponent = leftExponent - i32(1)
        }
    } else leftSignificand = leftSignificand | esp32Binary64HiddenBit

    var rightExponent = i32(rightExponentBits) - i32(1023)
    if (rightExponentBits == u32(0)) {
        rightExponent = i32(-1022)
        while (rightSignificand < esp32Binary64HiddenBit) {
            rightSignificand = rightSignificand << u64(1)
            rightExponent = rightExponent - i32(1)
        }
    } else rightSignificand = rightSignificand | esp32Binary64HiddenBit

    val mask32 = u64(4294967295)
    val leftLow = leftSignificand & mask32
    val leftHigh = leftSignificand >>> u64(32)
    val rightLow = rightSignificand & mask32
    val rightHigh = rightSignificand >>> u64(32)
    val product0 = leftLow * rightLow
    val product1 = leftLow * rightHigh
    val product2 = leftHigh * rightLow
    val product3 = leftHigh * rightHigh
    var productLow = product0
    var productHigh = product3 + (product1 >>> u64(32)) +
        (product2 >>> u64(32))
    var nextLow = productLow + (product1 << u64(32))
    if (nextLow < productLow) productHigh = productHigh + u64(1)
    productLow = nextLow
    nextLow = productLow + (product2 << u64(32))
    if (nextLow < productLow) productHigh = productHigh + u64(1)
    productLow = nextLow

    var shift = if ((productHigh & (u64(1) << u64(41))) != u64(0))
        i32(53) else i32(52)
    var exponent = leftExponent + rightExponent + shift - i32(52)
    val subnormal = exponent < i32(-1022)
    if (subnormal) shift = shift + (i32(-1022) - exponent)
    var significand = esp32Binary64RoundShift128(
        productHigh, productLow, shift
    )

    if (subnormal) {
        // A rounded carry naturally becomes the minimum normal encoding.
        return sign | significand
    }
    if (significand >= (esp32Binary64HiddenBit << u64(1))) {
        significand = significand >>> u64(1)
        exponent = exponent + i32(1)
    }
    if (exponent > i32(1023)) return sign | esp32Binary64Infinity
    return sign | (u64(exponent + i32(1023)) << u64(52)) |
        (significand & esp32Binary64FractionMask)
}
