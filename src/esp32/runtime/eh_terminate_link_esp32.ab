import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRuntimeEhTerminateInternals(): bool {
    if (!internalFunction("esp32CxxTerminateWith", "_ZN10__cxxabiv111__terminateEPFvvE")) return false
    if (!internalFunction("esp32SetTerminate", "_ZSt13set_terminatePFvvE")) return false
    if (!internalFunction("esp32GetTerminate", "_ZSt13get_terminatev")) return false
    if (!internalFunction("esp32Terminate", "_ZSt9terminatev")) return false
    if (!internalFunction("esp32CxxUnexpectedWith", "_ZN10__cxxabiv112__unexpectedEPFvvE")) return false
    if (!internalFunction("esp32SetUnexpected", "_ZSt14set_unexpectedPFvvE")) return false
    if (!internalFunction("esp32GetUnexpected", "_ZSt14get_unexpectedv")) return false
    if (!internalFunction("esp32Unexpected", "_ZSt10unexpectedv")) return false
    true
}
