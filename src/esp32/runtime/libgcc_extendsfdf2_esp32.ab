import "binary64_esp32.ab"
import "abla/integer"

// Integer-only binary32 to binary64 conversion. The typed u64 return matches
// Xtensa's two-register soft-float ABI without hiding a second result word.
trusted fun esp32Binary32BitsToBinary64(bits:u32):u64 {
    val sign = u64(bits & u32(0x80000000)) << u64(32)
    val exponent = (bits >>> u32(23)) & u32(255)
    val fraction = bits & u32(0x007fffff)
    if (exponent == u32(255)) {
        if (fraction == u32(0)) return sign | esp32Binary64Infinity
        return sign | esp32Binary64QuietNan
    }
    if (exponent == u32(0)) {
        if (fraction == u32(0)) return sign
        val normalizationShift = u32(ablaCountLeadingZerosU32(fraction)) - u32(8)
        val normalizedFraction = (fraction << normalizationShift) & u32(0x007fffff)
        val doubleExponent = u32(897) - normalizationShift
        return sign | (u64(doubleExponent) << u64(52)) |
            (u64(normalizedFraction) << u64(29))
    }
    sign | (u64(exponent + u32(896)) << u64(52)) |
        (u64(fraction) << u64(29))
}

trusted fun esp32LibgccExtendsfdf2(bits:u32):u64 =
    esp32Binary32BitsToBinary64(bits)

trusted fun esp32RecoveredExtendsfdf2(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = u32(esp32LibgccExtendsfdf2(a2))
