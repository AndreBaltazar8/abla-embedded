import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRuntimeTinfoInternals(): bool {
    if (!internalFunction("esp32TypeInfoDestructor", "_ZNSt9type_infoD1Ev")) return false
    if (!internalFunction("esp32TypeInfoIsPointer", "_ZNKSt9type_info14__is_pointer_pEv")) return false
    if (!internalFunction("esp32TypeInfoDoUpcast", "_ZNKSt9type_info11__do_upcastEPKN10__cxxabiv117__class_type_infoEPPv")) return false
    if (!internalFunction("esp32TypeInfoDeletingDestructor", "_ZNSt9type_infoD0Ev")) return false
    if (!internalFunction("esp32TypeInfoDoCatch", "_ZNKSt9type_info10__do_catchEPKS_PPvj")) return false
    if (!internalFunction("esp32TypeInfoCompleteDestructor", "_ZNSt9type_infoD2Ev")) return false
    if (!internalFunction("esp32TypeInfoIsFunction", "_ZNKSt9type_info15__is_function_pEv")) return false
    true
}
