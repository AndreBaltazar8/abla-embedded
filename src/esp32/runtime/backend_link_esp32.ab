import "abla/build"
import "../../runtime/freestanding_memory.ab"
import "./libgcc_udivdi3_esp32.ab"
import "./libgcc_divdi3_esp32.ab"
import "./libgcc_moddi3_esp32.ab"

// Local definitions for symbols that Espressif LLVM may introduce only while
// lowering the already-optimized monolithic module. These are not public
// firmware exports; the build primitive retains exact local ABI names so the
// final object never falls back to libc or libgcc archives.
compile fun esp32LinkOwnedBackendRuntime(): bool {
    if (!requiredInternalFunction("freestandingCopy", "memcpy")) {
        return false
    }
    if (!requiredInternalFunction("freestandingSet", "memset")) {
        return false
    }
    if (!requiredInternalFunction(
        "esp32UnsignedDivide64",
        "__udivdi3"
    )) return false
    if (!requiredInternalFunction(
        "esp32SignedDivide64",
        "__divdi3"
    )) return false
    if (!requiredInternalFunction(
        "esp32SignedRemainder64",
        "__moddi3"
    )) return false
    true
}
