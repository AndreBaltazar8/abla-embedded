import "abla/unsafe/memory"
import "abla/unsafe/native"

@inline
trusted fun esp32PicolibcQsortElement(base: u32, index: u32, width: u32): u32 =
    base + index * width

@inline
trusted fun esp32PicolibcQsortCompare(comparator: u32, left: u32, right: u32): i32 =
    i32(ablaUnsafeCallI32I32I32I32I32I32I32(
        int(comparator), int(left), int(right), 0, 0, 0, 0
    ))

trusted fun esp32PicolibcQsortSwap(left: u32, right: u32, width: u32): void {
    if (left == right) return
    var offset = u32(0)
    while (offset < width) {
        val leftAddress = left + offset
        val rightAddress = right + offset
        val leftByte = ablaUnsafeLoadU8(nativePointerFromAddress(int(leftAddress)))
        val rightByte = ablaUnsafeLoadU8(nativePointerFromAddress(int(rightAddress)))
        ablaUnsafeStoreU8(nativePointerFromAddress(int(leftAddress)), rightByte)
        ablaUnsafeStoreU8(nativePointerFromAddress(int(rightAddress)), leftByte)
        offset = offset + u32(1)
    }
}

trusted fun esp32PicolibcQsortSiftDown(
    base: u32,
    rootStart: u32,
    count: u32,
    width: u32,
    comparator: u32
): void {
    var root = rootStart
    while (true) {
        var child = root * u32(2) + u32(1)
        if (child >= count) return
        if (child + u32(1) < count && esp32PicolibcQsortCompare(
            comparator,
            esp32PicolibcQsortElement(base, child, width),
            esp32PicolibcQsortElement(base, child + u32(1), width)
        ) < 0) {
            child = child + u32(1)
        }
        if (esp32PicolibcQsortCompare(
            comparator,
            esp32PicolibcQsortElement(base, root, width),
            esp32PicolibcQsortElement(base, child, width)
        ) >= 0) return
        esp32PicolibcQsortSwap(
            esp32PicolibcQsortElement(base, root, width),
            esp32PicolibcQsortElement(base, child, width),
            width
        )
        root = child
    }
}

trusted fun esp32PicolibcQsort(
    base: u32,
    count: u32,
    width: u32,
    comparator: u32
): void {
    if (count < u32(2) || width == u32(0)) return

    var start = count / u32(2)
    while (start != u32(0)) {
        start = start - u32(1)
        esp32PicolibcQsortSiftDown(base, start, count, width, comparator)
    }

    var end = count - u32(1)
    while (end != u32(0)) {
        esp32PicolibcQsortSwap(
            base,
            esp32PicolibcQsortElement(base, end, width),
            width
        )
        esp32PicolibcQsortSiftDown(base, u32(0), end, width, comparator)
        end = end - u32(1)
    }
}

trusted fun esp32RecoveredQsort(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32PicolibcQsort(a2, a3, a4, a5)
    a2
}
