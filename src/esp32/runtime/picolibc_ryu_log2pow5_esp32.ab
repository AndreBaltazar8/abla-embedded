// Abla/LLVM implementation of Ryu base-2 power-of-five exponent estimates.

// Original ABI symbol: __log2pow5
@inline
trusted fun esp32RecoveredLog2pow5(value: u32): u32 =
    (value * u32(1217359)) >>> u32(19)

// Original ABI symbol: __ceil_log2pow5
@inline
trusted fun esp32RecoveredCeilLog2pow5(value: u32): u32 =
    esp32RecoveredLog2pow5(value) + u32(1)
