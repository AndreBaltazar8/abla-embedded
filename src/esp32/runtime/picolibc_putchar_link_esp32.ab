import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcPutcharOpaqueCallers(): bool {
    if (!internalFunction("esp32PicolibcPutchar", "putchar")) return false
    if (!internalFunction("esp32PicolibcPutcharUnlocked", "putchar_unlocked")) return false
    true
}
