import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcVfscanfCallers(): bool {
    if (!internalFunction("esp32RecoveredDVfscanf", "__d_vfscanf")) return false
    if (!internalFunction("esp32RecoveredVfscanf", "vfscanf")) return false
    true
}
