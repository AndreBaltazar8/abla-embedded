import "libc_locks_esp32.ab"

trusted fun esp32FlockfileInitialize(stream: u32): void {
    esp32LibcLockTakeHandle(
        esp32LibcPicolibcRecursiveMutex,
        esp32LibcLockWaitForever,
        esp32LibcLockRecursiveMutex
    )
    val streamLockAddress = stream + u32(16)
    if (esp32LibcLockLoad(streamLockAddress) == u32(0)) {
        esp32LibcLockInit(streamLockAddress, esp32LibcLockRecursiveMutex)
    }
    esp32LibcLockReleaseHandle(
        esp32LibcPicolibcRecursiveMutex,
        esp32LibcLockRecursiveMutex
    )
}

trusted fun esp32RecoveredFlockfileInit(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32FlockfileInitialize(a2)
    return a2
}
