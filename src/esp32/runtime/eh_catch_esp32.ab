import "abla/unsafe/memory"

// Structured Abla implementation of libsupc++ eh_catch.cc.
@inline
trusted fun esp32EhCatchLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32EhCatchStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
fun esp32EhCatchIsNative(unwindException:u32):bool {
    val low = esp32EhCatchLoadU32(unwindException)
    val high = esp32EhCatchLoadU32(unwindException + u32(4))
    val adjustedLow = low + u32(3168064768)
    val carry = if (adjustedLow < u32(3168064768)) u32(1) else u32(0)
    val adjustedHigh = high + u32(3098651324) + carry
    return adjustedHigh == u32(0) && adjustedLow < u32(2)
}

trusted fun esp32CxaGetExceptionPointer(unwindException:u32):u32 =
    esp32EhCatchLoadU32(unwindException - u32(8))

trusted fun esp32CxaBeginCatch(unwindException:u32):u32 {
    val globals = esp32CxaGetGlobals()
    val header = unwindException - u32(48)
    val previous = esp32EhCatchLoadU32(globals)
    if (!esp32EhCatchIsNative(unwindException)) {
        if (previous != u32(0)) {
            esp32Terminate()
        }
        esp32EhCatchStoreU32(globals,header)
        return u32(0)
    }

    val oldCount = esp32EhCatchLoadU32(header + u32(20))
    val newCount = if (i32(oldCount) >= 0) oldCount + u32(1)
        else u32(0) - (oldCount - u32(1))
    esp32EhCatchStoreU32(header + u32(20),newCount)
    esp32EhCatchStoreU32(globals + u32(4),
        esp32EhCatchLoadU32(globals + u32(4)) - u32(1))
    if (previous != header) {
        esp32EhCatchStoreU32(header + u32(16),previous)
        esp32EhCatchStoreU32(globals,header)
    }
    esp32EhCatchLoadU32(header + u32(40))
}

trusted fun esp32CxaEndCatch():void {
    val globals = esp32CxaGetGlobalsFast()
    val header = esp32EhCatchLoadU32(globals)
    if (header == u32(0)) return

    if (!esp32EhCatchIsNative(header + u32(48))) {
        esp32EhCatchStoreU32(globals,u32(0))
        esp32RecoveredWrapUnwindDeleteException(
            header + u32(48),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        return
    }

    var count = esp32EhCatchLoadU32(header + u32(20))
    if (i32(count) < 0) {
        count = count + u32(1)
        if (count == u32(0)) {
            esp32EhCatchStoreU32(globals,esp32EhCatchLoadU32(header + u32(16)))
        }
        esp32EhCatchStoreU32(header + u32(20),count)
        return
    }

    count = count - u32(1)
    if (count == u32(0xffffffff)) {
        esp32Terminate()
    }
    if (count == u32(0)) {
        esp32EhCatchStoreU32(globals,esp32EhCatchLoadU32(header + u32(16)))
        esp32RecoveredWrapUnwindDeleteException(
            header + u32(48),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        return
    }
    esp32EhCatchStoreU32(header + u32(20),count)
}

trusted fun esp32UncaughtException():u32 =
    if (esp32EhCatchLoadU32(esp32CxaGetGlobals() + u32(4)) != u32(0)) u32(1) else u32(0)

trusted fun esp32UncaughtExceptions():u32 =
    esp32EhCatchLoadU32(esp32CxaGetGlobals() + u32(4))
