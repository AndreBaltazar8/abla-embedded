import "../../runtime/unsigned_division64.ab"

// Preserve the typed firmware interface; arithmetic is shared across targets.
@inline
trusted fun esp32UnsignedDivide64(dividend: u64,divisor: u64): u64 =
    unsignedDivide64(dividend,divisor)

// Recovered 32-bit Xtensa code naturally carries a 64-bit value in low/high
// word pairs. Keep that representation at those call sites while performing
// the operation through the typed u64 implementation above.
@inline
trusted fun esp32UnsignedDivide64Low(
    dividendLow: u32,
    dividendHigh: u32,
    divisorLow: u32,
    divisorHigh: u32
): u32 = u32(esp32UnsignedDivide64(
    (u64(dividendHigh) << u64(32)) | u64(dividendLow),
    (u64(divisorHigh) << u64(32)) | u64(divisorLow)
))
