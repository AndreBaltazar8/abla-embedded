import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcRyuUmul128Callers(): bool {
    if (!internalFunction("esp32RyuUnsignedMultiply128", "__umul128")) return false
    if (!internalFunction("esp32RyuShiftRight128", "__shiftright128")) return false
    true
}
