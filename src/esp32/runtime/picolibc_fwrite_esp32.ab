import "picolibc_fputc_esp32.ab"
import "picolibc_stream_lock_esp32.ab"
import "abla/unsafe/memory"

trusted fun esp32PicolibcFwrite(
    source: u32,
    elementSize: u32,
    elementCount: u32,
    stream: u32
): u32 {
    if (elementSize == u32(0) || elementCount == u32(0)) return u32(0)
    val byteCountWide = u64(elementSize) * u64(elementCount)
    if (byteCountWide > u64(4294967295)) return u32(0)

    val lock = esp32PicolibcStreamLock(stream)
    var cursor = source
    var completedElements = u32(0)
    while (completedElements < elementCount) {
        var bytesInElement = u32(0)
        while (bytesInElement < elementSize) {
            val character = u32(ablaUnsafeLoadU8(
                nativePointerFromAddress(int(cursor))
            ))
            if (esp32PicolibcPutcUnlocked(character, stream) == u32(4294967295)) {
                esp32PicolibcStreamUnlock(lock)
                return completedElements
            }
            cursor = cursor + u32(1)
            bytesInElement = bytesInElement + u32(1)
        }
        completedElements = completedElements + u32(1)
    }
    esp32PicolibcStreamUnlock(lock)
    completedElements
}

trusted fun esp32RecoveredFwrite(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFwrite(a2, a3, a4, a5)
