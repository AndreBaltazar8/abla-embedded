import "../linker_layout_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32LibcRunInitializers(): void {
    var cursor = esp32LinkerLibcInitializersStart
    while (cursor != esp32LinkerLibcInitializersEnd) {
        val initializer = u32(ablaUnsafeLoadU32(
            nativePointerFromAddress(int(cursor))
        ))
        cursor = cursor + u32(4)
        if (initializer != u32(0)) {
            u32(ablaUnsafeCallI32I32I32I32I32I32I32(
                int(initializer),
                0, 0, 0, 0, 0, 0
            ))
        }
    }
}

trusted fun esp32RecoveredLibcInitArray(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32LibcRunInitializers()
    return a2
}
