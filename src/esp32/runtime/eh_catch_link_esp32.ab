import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRuntimeEhCatchInternals(): bool {
    if (!internalFunction("esp32CxaGetExceptionPointer", "__cxa_get_exception_ptr")) return false
    if (!internalFunction("esp32CxaBeginCatch", "__cxa_begin_catch")) return false
    if (!internalFunction("esp32CxaEndCatch", "__cxa_end_catch")) return false
    if (!internalFunction("esp32UncaughtException", "_ZSt18uncaught_exceptionv")) return false
    if (!internalFunction("esp32UncaughtExceptions", "_ZSt19uncaught_exceptionsv")) return false
    true
}
