// Throwing scalar new retries after the installed handler. The exceptional
// edge stays explicit Abla so a future zero-cost exception implementation can
// replace the current panic-backed C++ ABI without changing allocation logic.
trusted fun esp32OperatorNew(size:u32):u32 {
    val allocationBytes = if (size > u32(1)) size else u32(1)
    while (true) {
        val allocation = esp32LibcMalloc(allocationBytes)
        if (allocation != u32(0)) return allocation

        val handler = esp32GetNewHandler()
        if (handler != u32(0)) {
            ablaUnsafeCallI32I32I32I32I32I32I32(int(handler),int(u32(0)),
                int(u32(0)),int(u32(0)),int(u32(0)),int(u32(0)),int(u32(0)))
        } else {
            val exception = esp32RecoveredWrapCxaAllocateException(u32(4),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
            ablaUnsafeStoreU32(nativePointerFromAddress(int(exception)),
                int(esp32Data_ZTVSt9bad_alloc_06530bc50a + u32(8)))
            esp32RecoveredWrapCxaThrow(exception,
                esp32Data_ZTISt9bad_alloc_cbaf4e5ce8,
                u32(nativeFunctionAddress(esp32RecoveredZNSt9badAllocD1Ev)),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
            ablaRuntimeTrap()
        }
    }
    u32(0)
}

