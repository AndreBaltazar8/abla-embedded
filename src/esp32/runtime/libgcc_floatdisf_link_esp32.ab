import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibgccFloatDiSfOpaqueCallers(): bool {
    if (!internalFunction("esp32LibgccFloatundisf", "__floatundisf")) return false
    if (!internalFunction("esp32LibgccFloatdisf", "__floatdisf")) return false
    true
}
