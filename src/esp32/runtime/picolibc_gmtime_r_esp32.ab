import "abla/unsafe/memory"

fun esp32CalendarFloorDivide(value:i64,divisor:i64):i64 {
    var quotient=value/divisor
    val remainder=value%divisor
    if(remainder!=i64(0)&&value< i64(0)) quotient=quotient-i64(1)
    quotient
}

fun esp32CalendarPositiveRemainder(value:i64,divisor:i64):i64 {
    var remainder=value%divisor
    if(remainder< i64(0)) remainder=remainder+divisor
    remainder
}

fun esp32CalendarLeapYear(year:i64):bool=
    year%i64(4)==i64(0)&&
        (year%i64(100)!=i64(0)||year%i64(400)==i64(0))

fun esp32CalendarMonthLength(month:i64,leap:bool):i64 {
    if(month==i64(2)) return if(leap) i64(29) else i64(28)
    if(month==i64(4)||month==i64(6)||month==i64(9)||month==i64(11)) {
        return i64(30)
    }
    i64(31)
}

@inline
trusted fun esp32CalendarStore(address:u32,offset:u32,value:i64):void=
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address+offset)),int(i32(value)))

trusted fun esp32PicolibcGmtimeR(timeAddress:u32,result:u32):u32 {
    val seconds=i64(ablaUnsafeLoadI64(nativePointerFromAddress(int(timeAddress))))
    var days=esp32CalendarFloorDivide(seconds,i64(86400))
    var daySeconds=esp32CalendarPositiveRemainder(seconds,i64(86400))
    esp32CalendarStore(result,u32(8),daySeconds/i64(3600))
    daySeconds=daySeconds%i64(3600)
    esp32CalendarStore(result,u32(4),daySeconds/i64(60))
    esp32CalendarStore(result,u32(0),daySeconds%i64(60))
    esp32CalendarStore(result,u32(24),
        esp32CalendarPositiveRemainder(days+i64(4),i64(7)))

    val shifted=days+i64(719468)
    val era=if(shifted>=i64(0)) shifted/i64(146097)
        else (shifted-i64(146096))/i64(146097)
    val dayOfEra=shifted-era*i64(146097)
    val yearOfEra=(dayOfEra-dayOfEra/i64(1460)+dayOfEra/i64(36524)-
        dayOfEra/i64(146096))/i64(365)
    var year=yearOfEra+era*i64(400)
    val dayOfYearMarch=dayOfEra-(i64(365)*yearOfEra+
        yearOfEra/i64(4)-yearOfEra/i64(100))
    val monthPrime=(i64(5)*dayOfYearMarch+i64(2))/i64(153)
    val day=dayOfYearMarch-(i64(153)*monthPrime+i64(2))/i64(5)+i64(1)
    val month=monthPrime+(if(monthPrime< i64(10)) i64(3) else -i64(9))
    if(month<=i64(2)) year=year+i64(1)

    var yearDay=i64(0)
    var precedingMonth=i64(1)
    val leap=esp32CalendarLeapYear(year)
    while(precedingMonth<month) {
        yearDay=yearDay+esp32CalendarMonthLength(precedingMonth,leap)
        precedingMonth=precedingMonth+i64(1)
    }
    yearDay=yearDay+day-i64(1)

    esp32CalendarStore(result,u32(12),day)
    esp32CalendarStore(result,u32(16),month-i64(1))
    esp32CalendarStore(result,u32(20),year-i64(1900))
    esp32CalendarStore(result,u32(28),yearDay)
    esp32CalendarStore(result,u32(32),i64(0))
    result
}

trusted fun esp32RecoveredGmtimeR(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32PicolibcGmtimeR(a2,a3)
