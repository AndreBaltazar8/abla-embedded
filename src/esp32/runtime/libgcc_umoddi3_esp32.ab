// Freestanding unsigned 64-bit remainder for backends which lower u64 modulo
// to __umoddi3. Only shifts, comparisons, subtraction and bit operations are
// used, so this implementation cannot recursively request itself.
trusted fun esp32UnsignedRemainder64(dividend:u64, divisor:u64):u64 {
    var remainder = u64(0)
    var bit = u64(64)
    while (bit != u64(0)) {
        bit = bit - u64(1)
        val overflow = remainder >>> u64(63)
        remainder = (remainder << u64(1)) | ((dividend >>> bit) & u64(1))
        if (overflow != u64(0) || remainder >= divisor) {
            remainder = remainder - divisor
        }
    }
    remainder
}

@inline
trusted fun esp32UnsignedRemainder64Low(
    dividendLow:u32, dividendHigh:u32, divisorLow:u32, divisorHigh:u32
):u32 = u32(esp32UnsignedRemainder64(
    (u64(dividendHigh) << u64(32)) | u64(dividendLow),
    (u64(divisorHigh) << u64(32)) | u64(divisorLow)))

trusted fun esp32RecoveredUmoddi3(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 =
    esp32UnsignedRemainder64Low(a2,a3,a4,a5)
