fun esp32RyuMultiplyShift32(
    multiplier:u32,factorLow:u32,factorHigh:u32,shift:u32
):u32 {
    val lowProduct=u64(multiplier)*u64(factorLow)
    val highProduct=u64(multiplier)*u64(factorHigh)
    val middle=(highProduct&u64(0xffffffff))+(lowProduct>>>u64(32))
    val upper=(highProduct>>>u64(32))+(middle>>>u64(32))
    val value=(upper<<u64(32))|(middle&u64(0xffffffff))
    if(shift< u32(64)) return u32(value>>>u64(shift))
    if(shift< u32(96)) return u32(upper>>>u64(shift-u32(64)))
    u32(0)
}

