import "libc_heap_esp32.ab"
import "picolibc_bufio_esp32.ab"
import "abla/unsafe/memory"

trusted fun esp32LibcWrapBufioSetvbuf(
    stream: u32,
    requestedBuffer: u32,
    mode: u32,
    requestedSize: u32
): u32 {
    var buffer = requestedBuffer
    var effectiveMode = mode
    var size = requestedSize
    var allocated = false

    if (mode == u32(2)) {
        buffer = esp32LibcMalloc(u32(1))
        if (buffer == u32(0)) return u32(4294967295)
        effectiveMode = u32(0)
        size = u32(1)
        allocated = true
    }

    val result = esp32RecoveredBufioSetvbuf(
        stream, buffer, effectiveMode, size, u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (!allocated) return result

    if (result == u32(0) && u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(stream + u32(44)))
    )) == buffer) {
        val flagsAddress = stream + u32(37)
        val flags = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(flagsAddress))))
        ablaUnsafeStoreU8(nativePointerFromAddress(int(flagsAddress)), int(flags | u32(1)))
    } else {
        esp32LibcFreeValue(buffer)
    }
    result
}

trusted fun esp32RecoveredWrapBufioSetvbuf(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32LibcWrapBufioSetvbuf(a2, a3, a4, a5)
