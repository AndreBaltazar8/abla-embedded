import "abla/unsafe/memory"
import "picolibc_gettzinfo_esp32.ab"
import "picolibc_month_lengths_esp32.ab"

@inline
trusted fun esp32TzLoadU8(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32TzLoadI32(address:u32):i32 =
    i32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32TzStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32TzIsLeapYear(year:i32):bool =
    year % i32(4) == i32(0) &&
    (year % i32(100) != i32(0) || year % i32(400) == i32(0))

trusted fun esp32PicolibcCalculateTimezoneLimits(year:i32):u32 {
    if (year < i32(1970)) return u32(0)

    val timezone = esp32PicolibcTimezoneInfo()
    esp32TzStoreU32(timezone + u32(4), u32(year))

    val years = year - i32(1970)
    val yearDays = years * i32(365) +
        (years - i32(1) + i32(2)) / i32(4) -
        (years - i32(1) + i32(70)) / i32(100) +
        (years - i32(1) + i32(370)) / i32(400)

    var firstChange = i64(0)
    var secondChange = i64(0)
    var ruleIndex = u32(0)
    while (ruleIndex < u32(2)) {
        val rule = timezone + u32(8) + ruleIndex * u32(40)
        val kind = esp32TzLoadU8(rule)
        var days = yearDays

        if (kind == u32(74)) {
            val day = esp32TzLoadI32(rule + u32(12))
            days = days + day
            if (esp32TzIsLeapYear(year) && day >= i32(60)) days = days + i32(1)
            days = days - i32(1)
        } else if (kind == u32(68)) {
            days = days + esp32TzLoadI32(rule + u32(12))
        } else {
            val leap = if (esp32TzIsLeapYear(year)) u32(1) else u32(0)
            val monthLengths = esp32Data_month_lengths_d44102b773 + leap * u32(12)
            val month = esp32TzLoadI32(rule + u32(4))

            var currentMonth = i32(1)
            while (currentMonth < month) {
                days = days + i32(esp32TzLoadU8(
                    monthLengths + u32(currentMonth - i32(1))
                ))
                currentMonth = currentMonth + i32(1)
            }

            val monthWeekday = (i32(4) + days) % i32(7)
            var weekdayDifference =
                esp32TzLoadI32(rule + u32(12)) - monthWeekday
            if (weekdayDifference < i32(0)) weekdayDifference = weekdayDifference + i32(7)

            var monthDay =
                (esp32TzLoadI32(rule + u32(8)) - i32(1)) * i32(7) +
                weekdayDifference
            val monthLength = i32(esp32TzLoadU8(
                monthLengths + u32(currentMonth - i32(1))
            ))
            while (monthDay >= monthLength) monthDay = monthDay - i32(7)
            days = days + monthDay
        }

        val change = i64(days) * i64(86400) +
            i64(esp32TzLoadI32(rule + u32(16))) +
            i64(esp32TzLoadI32(rule + u32(32)))
        val changeBits = u64(change)
        esp32TzStoreU32(rule + u32(24), u32(changeBits))
        esp32TzStoreU32(rule + u32(28), u32(changeBits >>> u64(32)))
        if (ruleIndex == u32(0)) firstChange = change
        else secondChange = change

        ruleIndex = ruleIndex + u32(1)
    }

    esp32TzStoreU32(
        timezone,
        if (firstChange < secondChange) u32(1) else u32(0)
    )
    u32(1)
}

// Temporary adapter for tzset/mktime while those files are still lifted.
trusted fun esp32RecoveredTzcalcLimits(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PicolibcCalculateTimezoneLimits(i32(a2))
