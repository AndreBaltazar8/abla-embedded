trusted fun esp32InternalScanfNextPointer(arguments: u32): u32 {
    val stack = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(arguments))
    ))
    val registers = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(arguments + u32(4)))
    ))
    val originalIndex = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(arguments + u32(8)))
    ))
    var nextIndex = originalIndex + u32(4)
    var values = registers
    if (nextIndex > u32(24)) {
        values = stack
        if (originalIndex <= u32(24)) nextIndex = u32(36)
    }
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(arguments + u32(8))), int(nextIndex)
    )
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(
        values + nextIndex - u32(4)
    ))))
}

