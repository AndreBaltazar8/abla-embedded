        negative = character == u32(45)
        width = width - u32(1)
        if (width == u32(0)) return u32(0)
        character = esp32InternalScanfGet(stream, context)
        if (i32(character) < 0) return u32(0)
    }

    val firstLower = character | u32(32)
    var value = 0.0
    if (firstLower == u32(110)) {
        if (width <= u32(2)) return u32(0)
        val a = esp32InternalScanfGet(stream, context)
        val n = esp32InternalScanfGet(stream, context)
        width = width - u32(2)
        if ((a | u32(32)) != u32(97) || (n | u32(32)) != u32(110)) {
            return u32(0)
        }
        value = f64FromBits(int(9221120237041090560))
        width = width - u32(1)
        if (width != u32(0)) {
            character = esp32InternalScanfGet(stream, context)
            if (character == u32(40)) {
                var closed = false
                while (true) {
                    width = width - u32(1)
                    if (width == u32(0)) break
                    character = esp32InternalScanfGet(stream, context)
                    if (character == u32(41)) {
                        closed = true
                        break
                    }
                    if (!esp32InternalScanfIsAlphaNumeric(character) &&
                        character != u32(95)) break
                }
                if (!closed) return u32(0)
            } else {
                esp32InternalScanfUnget(character, stream, context)
            }
        }
    } else if (firstLower == u32(105)) {
        if (width <= u32(2)) return u32(0)
        val n = esp32InternalScanfGet(stream, context)
        val f = esp32InternalScanfGet(stream, context)
        width = width - u32(2)
        if ((n | u32(32)) != u32(110) || (f | u32(32)) != u32(102)) {
            return u32(0)
        }
        value = f64FromBits(int(9218868437227405312))
        width = width - u32(1)
        if (width != u32(0)) {
            var index = u32(0)
