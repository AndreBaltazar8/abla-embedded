import "binary64_esp32.ab"

@inline
fun esp32RoundBinary64ToUnsigned(value:u64, shift:u32):u64 {
    val count = u64(shift)
    val quotient = value >>> count
    val half = u64(1) << (count - u64(1))
    val remainder = value & ((u64(1) << count) - u64(1))
    if (remainder > half ||
        (remainder == half && (quotient & u64(1)) != u64(0))) {
        return quotient + u64(1)
    }
    quotient
}

// IEEE round-to-nearest-even binary64 to binary32 conversion, implemented on
// the bit representation so it cannot recursively lower to __truncdfsf2.
trusted fun esp32Binary64BitsToBinary32(bits:u64):u32 {
    val sign = u32(bits >>> u64(32)) & u32(0x80000000)
    val exponentBits = esp32Binary64Exponent(bits)
    val fraction = esp32Binary64Fraction(bits)
    if (exponentBits == u32(2047)) {
        if (fraction == u64(0)) return sign | u32(0x7f800000)
        return sign | u32(0x7fc00000)
    }
    if (exponentBits == u32(0)) return sign

    var exponent = i32(exponentBits) - i32(1023)
    if (exponent > i32(127)) return sign | u32(0x7f800000)
    if (exponent < i32(-150)) return sign

    val significand = esp32Binary64HiddenBit | fraction
    if (exponent >= i32(-126)) {
        var rounded = esp32RoundBinary64ToUnsigned(significand, u32(29))
        if (rounded == (u64(1) << u64(24))) {
            rounded = rounded >>> u64(1)
            exponent = exponent + i32(1)
            if (exponent > i32(127)) return sign | u32(0x7f800000)
        }
        return sign | (u32(exponent + i32(127)) << u32(23)) |
            (u32(rounded) & u32(0x007fffff))
    }

    val subnormalShift = u32(-exponent - i32(97))
    val rounded = esp32RoundBinary64ToUnsigned(significand, subnormalShift)
    sign | u32(rounded)
}

trusted fun esp32LibgccTruncdfsf2(bits:u64):u32 =
    esp32Binary64BitsToBinary32(bits)

trusted fun esp32RecoveredTruncdfsf2(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32LibgccTruncdfsf2((u64(a3) << u64(32)) | u64(a2))
