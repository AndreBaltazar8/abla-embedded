import "picolibc_utoa_esp32.ab"
import "abla/unsafe/memory"

trusted fun esp32PicolibcItoa(value: u32, buffer: u32, base: u32): u32 {
    if (base < u32(2) || base > u32(36)) {
        ablaUnsafeStoreU8(nativePointerFromAddress(int(buffer)), 0)
        return u32(0)
    }
    if (base == u32(10) && i32(value) < 0) {
        ablaUnsafeStoreU8(nativePointerFromAddress(int(buffer)), 45)
        esp32PicolibcUtoa(u32(0) - value, buffer + u32(1), base)
        return buffer
    }
    esp32PicolibcUtoa(value, buffer, base)
}

trusted fun esp32PicolibcInternalItoa(value: u32, buffer: u32, base: u32): u32 =
    esp32PicolibcItoa(value, buffer, base)

trusted fun esp32RecoveredInternalItoa(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcItoa(a2, a3, a4)

trusted fun esp32RecoveredItoa(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcItoa(a2, a3, a4)
