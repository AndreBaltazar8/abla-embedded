import "picolibc_fputc_esp32.ab"
import "picolibc_initialization_esp32.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32PicolibcStdout(): u32 = u32(ablaUnsafeLoadU32(
    nativePointerFromAddress(int(esp32Data_stdout_476d9ec701))
))

trusted fun esp32PicolibcPutchar(character: u32): u32 =
    esp32PicolibcFputc(character, esp32PicolibcStdout())

trusted fun esp32PicolibcPutcharUnlocked(character: u32): u32 =
    esp32PicolibcPutcUnlocked(character, esp32PicolibcStdout())

trusted fun esp32RecoveredPutchar(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcPutchar(a2)

trusted fun esp32RecoveredPutcharUnlocked(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcPutcharUnlocked(a2)
