import "abla/runtime/self"
import "abla/unsafe/memory"

trusted fun esp32Time(destination: u32): u64 {
    // ESP-IDF timeval has an eight-byte time_t followed by tv_usec.
    val timeValue = u32(nativeStackAllocate(16))
    val status = esp32RecoveredGettimeofday(
        timeValue, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    if (i32(status) < 0) {
        ablaUnsafeStoreU32(nativePointerFromAddress(int(timeValue)), -1)
        ablaUnsafeStoreU32(
            nativePointerFromAddress(int(timeValue + u32(4))),
            -1
        )
    }
    val low = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(timeValue))))
    val high = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(timeValue + u32(4)))
    ))
    if (destination != u32(0)) {
        ablaUnsafeStoreU32(nativePointerFromAddress(int(destination)), int(low))
        ablaUnsafeStoreU32(
            nativePointerFromAddress(int(destination + u32(4))),
            int(high)
        )
    }
    return (u64(high) << u32(32)) | u64(low)
}

trusted fun esp32RecoveredTime(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = u32(esp32Time(a2))
