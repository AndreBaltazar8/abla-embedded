import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcStrerrorOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredStrerrorR", "_strerror_r")) return false
    if (!internalFunction("esp32RecoveredStrerror", "strerror")) return false
    if (!internalFunction("esp32RecoveredStrerrorL", "strerror_l")) return false
    true
}
