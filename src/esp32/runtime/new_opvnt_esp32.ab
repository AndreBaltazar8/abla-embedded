import "libc_heap_esp32.ab"
import "new_handler_esp32.ab"
import "abla/unsafe/memory"

// Nothrow array-new does not need the C++ exception machinery. Retrying the
// allocation after each installed new_handler is the required behavior; when
// no handler remains, failure is returned directly.
trusted fun esp32OperatorNewArrayNothrow(size: u32, nothrowTag: u32): u32 {
    val allocationBytes = if (size > u32(1)) size else u32(1)
    while (true) {
        val allocation = esp32LibcMalloc(allocationBytes)
        if (allocation != u32(0)) return allocation

        val handler = esp32GetNewHandler()
        if (handler == u32(0)) return u32(0)
        ablaUnsafeCallI32I32I32I32I32I32I32(
            int(handler), int(u32(0)), int(u32(0)), int(u32(0)),
            int(u32(0)), int(u32(0)), int(u32(0)))
    }
    u32(0)
}

trusted fun esp32RecoveredZnajRKSt9nothrowT(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32OperatorNewArrayNothrow(a2, a3)
