import "abla/unsafe/native"

// Process-wide timezone state: north, year, and two 40-byte transition rules.
val esp32PicolibcTimezoneInfoStorage = nativeStaticAllocate(88)
val esp32PicolibcTimezoneInfoAddress = u32(esp32PicolibcTimezoneInfoStorage)

trusted fun esp32PicolibcTimezoneInfo():u32 = esp32PicolibcTimezoneInfoAddress

// Temporary adapter for time modules which are still register-shaped lifts.
trusted fun esp32RecoveredGettzinfo(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PicolibcTimezoneInfo()
