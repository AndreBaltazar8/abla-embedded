import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibgccDivDf3OpaqueCallers(): bool {
    // Temporary foreign root while remaining recovered IDF bodies call the
    // ABI name. Once those bodies are typed, whole-module DCE can internalize
    // this automatically.
    if (!exportFunction("esp32Binary64Divide", "__divdf3")) return false
    true
}
