import "libc_locks_esp32.ab"
import "picolibc_flockfile_init_esp32.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32FileErrorUnlocked(stream: u32): u32 =
    u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(stream + u32(2)))
    )) & u32(4)

trusted fun esp32FileError(stream: u32): u32 {
    if (esp32LibcLockLoad(stream + u32(16)) == u32(0)) {
        esp32FlockfileInitialize(stream)
    }
    val lock = esp32LibcLockLoad(stream + u32(16))
    if (lock != u32(1)) {
        esp32LibcLockTakeHandle(
            lock,
            esp32LibcLockWaitForever,
            esp32LibcLockRecursiveMutex
        )
    }
    val result = esp32FileErrorUnlocked(stream)
    if (lock != u32(1)) {
        esp32LibcLockReleaseHandle(lock, esp32LibcLockRecursiveMutex)
    }
    return result
}

trusted fun esp32RecoveredFerror(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32FileError(a2)

trusted fun esp32RecoveredFerrorUnlocked(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32FileErrorUnlocked(a2)
