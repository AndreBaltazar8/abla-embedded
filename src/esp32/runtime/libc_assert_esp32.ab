import "../../runtime/freestanding_memory.ab"
import "../system/assert_esp32.ab"
import "../../runtime/freestanding_integer.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Structured Abla implementation of ESP-IDF assert.c.
val esp32AssertCachedDisabled = u32(nativeStaticBytes("<cached disabled>\x00"))
val esp32AssertPrefix = u32(nativeStaticBytes("assert failed: \x00"))
val esp32AssertMissingFunction = u32(nativeStaticBytes("\x08\x00"))
val esp32AssertSpace = u32(nativeStaticBytes(" \x00"))
val esp32AssertColon = u32(nativeStaticBytes(":\x00"))
val esp32AssertOpen = u32(nativeStaticBytes(" (\x00"))
val esp32AssertClose = u32(nativeStaticBytes(")\x00"))

@inline
fun esp32AssertPointerInDrom(address:u32):bool =
    address >= u32(0x3f400000) && address <= u32(0x3f7fffff)

@inline
trusted fun esp32AssertStoreByte(address:u32, value:u32):void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32AssertReturnAddressToString(output:u32):u32 {
    esp32AssertStoreByte(output, u32(48))
    esp32AssertStoreByte(output + u32(1), u32(120))
    val high = u32(nativeFunctionAddress(esp32AssertReturnAddressToString)) & u32(0xc0000000)
    val returnAddress = (xtensaReturnAddress() & u32(0x3fffffff)) | high
    esp32PicolibcItoa(returnAddress - u32(3), output + u32(2), u32(16))
    output
}

trusted fun esp32AssertCacheEnabled():bool = esp32RecoveredSpiFlashCacheEnabled(
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)) != u32(0)

trusted fun esp32AssertAppend(
    output:u32, offset:u32, capacity:u32, source:u32
):u32 {
    if (offset >= capacity) return offset
    val length = u32(freestandingStringLength(source))
    val remaining = capacity - offset
    val copyLength = if (length < remaining) length else remaining
    freestandingCopy(output + offset, source, copyLength)
    offset + copyLength
}

trusted fun esp32AssertFunction(
    sourceFile:u32, line:u32, sourceFunction:u32, expression:u32
):void {
    val returnAddressText = u32(nativeStackAllocate(11))
    freestandingSet(returnAddressText, i32(0), u32(11))
    val lineText = u32(nativeStackAllocate(12))
    esp32PicolibcItoa(line, lineText, u32(10))

    var file = sourceFile
    var function = sourceFunction
    var failedExpression = expression
    if (!esp32AssertCacheEnabled()) {
        if (esp32AssertPointerInDrom(file)) file = esp32AssertCachedDisabled
        if (esp32AssertPointerInDrom(function)) {
            esp32AssertReturnAddressToString(returnAddressText)
            function = returnAddressText
        }
        if (esp32AssertPointerInDrom(failedExpression)) {
            failedExpression = esp32AssertCachedDisabled
        }
    }
    if (function == u32(0)) function = esp32AssertMissingFunction

    val message = u32(nativeStackAllocate(200))
    var offset = u32(0)
    offset = esp32AssertAppend(message,offset,u32(199),esp32AssertPrefix)
    offset = esp32AssertAppend(message,offset,u32(199),function)
    offset = esp32AssertAppend(message,offset,u32(199),esp32AssertSpace)
    offset = esp32AssertAppend(message,offset,u32(199),file)
    offset = esp32AssertAppend(message,offset,u32(199),esp32AssertColon)
    offset = esp32AssertAppend(message,offset,u32(199),lineText)
    offset = esp32AssertAppend(message,offset,u32(199),esp32AssertOpen)
    offset = esp32AssertAppend(message,offset,u32(199),failedExpression)
    offset = esp32AssertAppend(message,offset,u32(199),esp32AssertClose)
    esp32AssertStoreByte(message + offset, u32(0))
    esp32RecoveredEspSystemAbort(message)
    ablaRuntimeTrap()
}

trusted fun esp32Assert(sourceFile:u32, line:u32, expression:u32):void {
    esp32AssertFailed(sourceFile, expression, u32(0), line)
    ablaRuntimeTrap()
}

trusted fun esp32LibcIncludeAssert():void {}

// Internal compatibility adapters for raw function pointers in the remaining
// lifted FreeRTOS paths.
trusted fun esp32RecoveredAssertFunc(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32AssertFunction(a2,a3,a4,a5); a2 }
trusted fun esp32RecoveredAssert(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32Assert(a2,a3,a4); a2 }
trusted fun esp32RecoveredEspLibcIncludeAssertImpl(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32LibcIncludeAssert(); a2 }
