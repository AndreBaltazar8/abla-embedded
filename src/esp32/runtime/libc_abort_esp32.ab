import "abla/build"
import "../../runtime/freestanding_memory.ab"
import "picolibc_itoa_esp32.ab"
import "../system/chip_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/native"

// Preserve ESP-IDF's useful panic reason while keeping the formatting visible
// to LLVM. The two Xtensa operations are irreducible facts: the encoded return
// address and the core-id special register.
trusted fun esp32Abort():void {
    val returnAddress = xtensaReturnAddress()
    val functionRegion = u32(nativeFunctionAddress(esp32Abort)) & u32(0xc0000000)
    val callSite = ((returnAddress << u32(2)) >>> u32(2)) |
        functionRegion

    val pcText = u32(nativeStackAllocate(12))
    val coreText = u32(nativeStackAllocate(4))
    val message = u32(nativeStackAllocate(64))
    freestandingSet(pcText, i32(0), u32(12))
    freestandingSet(coreText, i32(0), u32(4))
    freestandingSet(message, i32(0), u32(64))
    esp32PicolibcItoa(callSite - u32(3), pcText, u32(16))
    val core = (xtensaReadProcessorId() >>> u32(13)) & u32(1)
    esp32PicolibcItoa(core, coreText, u32(10))

    freestandingStringAppend(message,
        u32(nativeStaticBytes("abort() was called at PC 0x\x00")))
    freestandingStringAppend(message, pcText)
    freestandingStringAppend(message, u32(nativeStaticBytes(" on core\x00")))
    freestandingStringAppend(message, coreText)
    esp32RecoveredEspSystemAbort(message)
    ablaRuntimeTrap()
}

trusted fun esp32RecoveredAbort(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32Abort(); u32(0) }
