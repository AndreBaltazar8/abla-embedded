import "libc_locks_esp32.ab"
import "picolibc_flockfile_init_esp32.ab"

@inline
trusted fun esp32PicolibcStreamLock(stream: u32): u32 {
    if (esp32LibcLockLoad(stream + u32(16)) == u32(0)) {
        esp32FlockfileInitialize(stream)
    }
    val lock = esp32LibcLockLoad(stream + u32(16))
    if (lock != u32(1)) {
        esp32LibcLockTakeHandle(
            lock,
            esp32LibcLockWaitForever,
            esp32LibcLockRecursiveMutex
        )
    }
    lock
}

@inline
trusted fun esp32PicolibcStreamUnlock(lock: u32): void {
    if (lock != u32(1)) {
        esp32LibcLockReleaseHandle(lock, esp32LibcLockRecursiveMutex)
    }
    return
}
