import "picolibc_ryu_log2pow5_esp32.ab"
import "picolibc_ryu_divpow2_esp32.ab"
import "abla/runtime/self"

@inline
fun esp32RyuFloorLog2U32(value:u32):i32 =
    i32(31) - i32(ablaCountLeadingZerosU32(value))

fun esp32RyuMultipleOfPower2(value:u32, power:u32):bool {
    if (power == u32(0)) return true
    (value & ((u32(1) << power) - u32(1))) == u32(0)
}

fun esp32RyuMultipleOfPower5(value:u32, power:u32):bool {
    if (power == u32(0)) return true
    if (value == u32(0)) return false
    var remaining = value
    var count = u32(0)
    while ((remaining % u32(5)) == u32(0)) {
        remaining = remaining / u32(5)
        count = count + u32(1)
    }
    count >= power
}

// Exact Picolibc/Ryu m10 * 10^e10 conversion expressed on float bits. No
// floating instruction or opaque soft-float library is needed.
trusted fun esp32PicolibcAtofEngine(m10:u32, e10:i32):u32 {
    if (m10 == u32(0)) return u32(0)
    val mantissaBits = i32(23)
    val exponentBias = i32(127)
    var e2 = i32(0)
    var m2 = u32(0)
    var trailingZeros = false

    if (e10 >= i32(0)) {
        val power = u32(e10)
        val log5 = i32(esp32RecoveredLog2pow5(power))
        val ceilLog5 = i32(esp32RecoveredCeilLog2pow5(power))
        e2 = esp32RyuFloorLog2U32(m10) + e10 + log5 - (mantissaBits + i32(1))
        val shift = e2 - e10 - ceilLog5 + i32(61)
        m2 = esp32RyuMultiplyPower5DividePower2(m10, power, u32(shift))
        val binaryPower = e2 - e10
        trailingZeros = binaryPower < i32(0) ||
            (binaryPower < i32(32) &&
                esp32RyuMultipleOfPower2(m10, u32(binaryPower)))
    } else {
        val power = u32(-e10)
        val ceilLog5 = i32(esp32RecoveredCeilLog2pow5(power))
        e2 = esp32RyuFloorLog2U32(m10) + e10 - ceilLog5 -
            (mantissaBits + i32(1))
        val shift = e2 - e10 + ceilLog5 - i32(1) + i32(61)
        m2 = esp32RyuMultiplyInversePower5DividePower2(
            m10, power, u32(shift))
        val binaryPower = e2 - e10
        trailingZeros = (binaryPower < i32(0) ||
            (binaryPower < i32(32) &&
                esp32RyuMultipleOfPower2(m10, u32(binaryPower)))) &&
            esp32RyuMultipleOfPower5(m10, power)
    }

    var ieeeExponentSigned = e2 + exponentBias + esp32RyuFloorLog2U32(m2)
    if (ieeeExponentSigned < i32(0)) ieeeExponentSigned = i32(0)
    if (ieeeExponentSigned > i32(254)) return u32(0x7f800000)
    var ieeeExponent = u32(ieeeExponentSigned)

    val effectiveExponent = if (ieeeExponent == u32(0)) i32(1)
        else i32(ieeeExponent)
    val shiftSigned = effectiveExponent - e2 - exponentBias - mantissaBits
    val shift = u32(shiftSigned)
    var shifted = m2
    var roundUp = false
    if (shift != u32(0)) {
        val discardedMask = (u32(1) << (shift - u32(1))) - u32(1)
        trailingZeros = trailingZeros && (m2 & discardedMask) == u32(0)
        val lastRemovedBit = (m2 >>> (shift - u32(1))) & u32(1)
        shifted = m2 >>> shift
        roundUp = lastRemovedBit != u32(0) &&
            (!trailingZeros || (shifted & u32(1)) != u32(0))
    }
    var ieeeMantissa = shifted + (if (roundUp) u32(1) else u32(0))
    ieeeMantissa = ieeeMantissa & u32(0x007fffff)
    if (ieeeMantissa == u32(0) && roundUp) {
        ieeeExponent = ieeeExponent + u32(1)
    }
    (ieeeExponent << u32(23)) | ieeeMantissa
}

trusted fun esp32RecoveredAtofEngine(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PicolibcAtofEngine(a2, i32(a3))
