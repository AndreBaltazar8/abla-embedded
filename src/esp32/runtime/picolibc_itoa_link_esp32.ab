import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcItoaOpaqueCallers(): bool {
    if (!internalFunction("esp32PicolibcInternalItoa", "__itoa")) return false
    if (!internalFunction("esp32PicolibcItoa", "itoa")) return false
    true
}
