import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRuntimeEhUnexHandlerInternals(): bool {
    if (!internalFunction("esp32RecoveredEhUnexHandlerMemberAnchor", "eh_unex_handler_member_anchor")) return false
    true
}
