// Abla/LLVM implementation of the Xtensa 32-bit population-count runtime.

// Original ABI symbol: __popcountsi2
@inline
trusted fun esp32RecoveredPopcountsi2(value: u32): u32 {
    var bits = value
    bits = bits - ((bits >>> u32(1)) & u32(1431655765))
    bits = (bits & u32(858993459)) +
        ((bits >>> u32(2)) & u32(858993459))
    bits = (bits + (bits >>> u32(4))) & u32(252645135)
    bits = bits + (bits << u32(8))
    bits = bits + (bits << u32(16))
    bits >>> u32(24)
}
