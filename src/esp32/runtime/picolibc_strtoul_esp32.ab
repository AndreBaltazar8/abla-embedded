import "picolibc_parse_integer_esp32.ab"

trusted fun esp32PicolibcStrtoul(input: u32, endOut: u32, base: u32): u32 =
    esp32PicolibcParseInteger(input, endOut, base, false)

trusted fun esp32RecoveredStrtoul(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcStrtoul(a2, a3, a4)
