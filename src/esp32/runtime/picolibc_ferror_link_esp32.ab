import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcFerrorOpaqueCallers(): bool {
    if (!internalFunction("esp32FileError", "ferror")) return false
    if (!internalFunction("esp32FileErrorUnlocked", "ferror_unlocked")) return false
    true
}
