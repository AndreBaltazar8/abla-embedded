import "abla/unsafe/memory"

val esp32PicolibcDigitsStorage = nativeStaticBytes("0123456789abcdefghijklmnopqrstuvwxyz")
val esp32PicolibcDigits = u32(esp32PicolibcDigitsStorage)

trusted fun esp32PicolibcUtoa(value: u32, buffer: u32, base: u32): u32 {
    if (base < u32(2) || base > u32(36)) {
        ablaUnsafeStoreU8(nativePointerFromAddress(int(buffer)), 0)
        return u32(0)
    }

    var remaining = value
    var length = u32(0)
    while (true) {
        val digit = remaining % base
        ablaUnsafeStoreU8(
            nativePointerFromAddress(int(buffer + length)),
            ablaUnsafeLoadU8(nativePointerFromAddress(int(esp32PicolibcDigits + digit)))
        )
        length = length + u32(1)
        remaining = remaining / base
        if (remaining == u32(0)) break
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(int(buffer + length)), 0)

    var left = u32(0)
    var right = length - u32(1)
    while (left < right) {
        val leftByte = ablaUnsafeLoadU8(nativePointerFromAddress(int(buffer + left)))
        val rightByte = ablaUnsafeLoadU8(nativePointerFromAddress(int(buffer + right)))
        ablaUnsafeStoreU8(nativePointerFromAddress(int(buffer + left)), rightByte)
        ablaUnsafeStoreU8(nativePointerFromAddress(int(buffer + right)), leftByte)
        left = left + u32(1)
        right = right - u32(1)
    }
    buffer
}

trusted fun esp32PicolibcInternalUtoa(value: u32, buffer: u32, base: u32): u32 =
    esp32PicolibcUtoa(value, buffer, base)

trusted fun esp32RecoveredInternalUtoa(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcUtoa(a2, a3, a4)

trusted fun esp32RecoveredUtoa(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcUtoa(a2, a3, a4)
