import "picolibc_stream_lock_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32PicolibcSetvbuf(
    stream: u32,
    buffer: u32,
    mode: u32,
    size: u32
): u32 {
    val lock = esp32PicolibcStreamLock(stream)
    val flags = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(stream + u32(2)))))
    var result = u32(0)
    if ((flags & u32(32)) != u32(0)) {
        val setvbufFunction = u32(ablaUnsafeLoadU32(
            nativePointerFromAddress(int(stream + u32(28)))
        ))
        if (setvbufFunction != u32(0)) {
            result = u32(ablaUnsafeCallI32I32I32I32I32I32I32(
                int(setvbufFunction), int(stream), int(buffer), int(mode), int(size), 0, 0
            ))
        }
    }
    esp32PicolibcStreamUnlock(lock)
    result
}

trusted fun esp32RecoveredSetvbuf(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcSetvbuf(a2, a3, a4, a5)
