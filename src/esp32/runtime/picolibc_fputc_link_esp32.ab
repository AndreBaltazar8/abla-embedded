import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcFputcOpaqueCallers(): bool {
    if (!internalFunction("esp32PicolibcFputc", "fputc")) return false
    if (!internalFunction("esp32PicolibcPutc", "putc")) return false
    if (!internalFunction("esp32PicolibcPutcUnlocked", "putc_unlocked")) return false
    true
}
