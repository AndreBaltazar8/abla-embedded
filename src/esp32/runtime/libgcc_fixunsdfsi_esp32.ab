import "libgcc_fixdfsi_esp32.ab"

// Soft-float binary64 to unsigned i32, again kept in word form to avoid a
// compiler-generated call to the symbol being implemented.
trusted fun esp32Binary64BitsToUnsigned32(low: u32, high: u32): u32 {
    val exponentMask = u32(0x7ff00000)
    if ((high & exponentMask) == exponentMask) {
        val payload = (high << u32(12)) | low
        if (payload != u32(0)) return u32(0xffffffff)
        return if (i32(high) < 0) u32(0x80000000) else u32(0xffffffff)
    }

    val exponent = i32((high >>> u32(20)) & u32(2047)) - i32(1023)
    if (exponent >= 32) {
        return if (i32(high) < 0) u32(0x80000000) else u32(0xffffffff)
    }
    if (exponent < 0) return u32(0)

    val window = esp32Binary64IntegerWindow(low, high)
    if (exponent == 31) {
        return if (i32(high) < 0) u32(0x80000000) else window
    }
    val magnitude = window >>> (u32(31) - u32(exponent))
    if (i32(high) < 0) u32(0) - magnitude else magnitude
}

trusted fun esp32RecoveredFixunsdfsi(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32Binary64BitsToUnsigned32(a2, a3)
