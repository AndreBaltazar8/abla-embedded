// IDF exposes stdin/stdout/stderr as pointer slots rather than stream objects.
trusted fun esp32Data_stdout_476d9ec701Initialize(): int {
    ablaUnsafeStoreU32(
        nativePointerFromAddress(esp32Data_stdout_476d9ec701Storage),
        int(esp32PicolibcStdoutStream)
    )
    esp32Data_stdout_476d9ec701Storage
}
val esp32Data_stdout_476d9ec701Initialized = esp32Data_stdout_476d9ec701Initialize()

trusted fun esp32Data_stdin_de71957adaInitialize(): int {
    ablaUnsafeStoreU32(
        nativePointerFromAddress(esp32Data_stdin_de71957adaStorage),
        int(esp32PicolibcStdinStream)
    )
    esp32Data_stdin_de71957adaStorage
}
val esp32Data_stdin_de71957adaInitialized = esp32Data_stdin_de71957adaInitialize()

val esp32Data_stderr_351eb7019cStorage = nativeStaticMutableU32s([
    int(esp32PicolibcStdoutStream)
])
val esp32Data_stderr_351eb7019cInitialized = esp32Data_stderr_351eb7019cStorage
val esp32Data_stderr_351eb7019c = u32(esp32Data_stderr_351eb7019cInitialized)

// Original ABI symbol: esp_libc_init
trusted fun esp32RecoveredEspLibcInit(): u32 {
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32LinkerSyscallTableApp)),
        int(esp32PicolibcStubTable)
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32LinkerSyscallTablePro)),
        int(esp32PicolibcStubTable)
    )

    // Startup has already initialized module state, whose default allocation
    // policy selects ordinary internal 8-bit memory. Express this fixed
    // four-byte allocation directly so pre-scheduler startup does not cross
    // the libc/default/capability wrapper chain.
    val environment = esp32HeapCapsAllocateBeforeScheduler(
        u32(4), u32(6144)
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32Data_environ_3611ac014c)),
        int(environment)
    )
    if (environment == u32(0)) freestandingAbortValue()
    ablaUnsafeStoreU32(nativePointerFromAddress(int(environment)), 0)
    esp32LibcLocksInitialize()
    u32(0)
}

// Original ABI symbol: esp_reent_cleanup
trusted fun esp32RecoveredEspReentCleanup(reentrancy: u32): u32 {
    reentrancy
}

// Original ABI symbol: esp_libc_init_global_stdio
trusted fun esp32RecoveredEspLibcInitGlobalStdio(devicePath: u32): u32 {
    val stdinDescriptor = esp32RecoveredOpen(
        devicePath, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (i32(stdinDescriptor) <= 0) freestandingAbortValue()
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32PicolibcStdinStream + u32(32))),
        int(stdinDescriptor)
    )

    val stdoutDescriptor = esp32RecoveredOpen(
        devicePath, u32(1), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (i32(stdoutDescriptor) <= 0) freestandingAbortValue()
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32PicolibcStdoutStream + u32(32))),
        int(stdoutDescriptor)
    )
    devicePath
}

// The IDF startup order has already registered UART, nullfs, and console at
// VFS indices 0, 1, and 2.  Build the fixed console descriptor graph directly
// while startup is still single-core: fd 0 is the underlying UART, and fd 1/2
// are stdin/stdout views through the console driver.  All later opens still
// traverse the complete VFS implementation above.
trusted fun esp32PicolibcInitializeDefaultConsoleStdio(): u32 {
    esp32UartVfsSet(esp32UartVfsNonBlocking, u32(0), u32(0))
    val uartDescriptor = esp32VfsRegisterLocalFdDuringStartup(
        u32(0), u32(0)
    )
    if (uartDescriptor == u32(0xffffffff)) freestandingAbortValue()
    esp32StdioStoreU32(esp32StdioConsoleAddress(), uartDescriptor)

    val stdinDescriptor = esp32VfsRegisterLocalFdDuringStartup(
        u32(2), uartDescriptor
    )
    if (i32(stdinDescriptor) <= i32(0)) freestandingAbortValue()
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32PicolibcStdinStream + u32(32))),
        int(stdinDescriptor)
    )

    val stdoutDescriptor = esp32VfsRegisterLocalFdDuringStartup(
        u32(2), uartDescriptor
    )
    if (i32(stdoutDescriptor) <= i32(0)) freestandingAbortValue()
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32PicolibcStdoutStream + u32(32))),
        int(stdoutDescriptor)
    )
    esp32StdioStoreU32(esp32StdioOpenCountAddress(), u32(2))
    return esp32StdioConsolePathAddress()
}

// Original ABI symbol: esp_libc_include_init_funcs
trusted fun esp32RecoveredEspLibcIncludeInitFuncs(value: u32): u32 {
    value
}

// Original ABI aliases kept as ordinary Abla calls so LLVM can inline them.
trusted fun esp32RecoveredEspSetupNewlibSyscalls(): u32 {
    esp32RecoveredEspLibcInit()
}

trusted fun esp32RecoveredEspNewlibInit(): u32 {
    esp32RecoveredEspLibcInit()
}
