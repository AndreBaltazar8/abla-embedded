// Keep the first three picolibc-compatible TLS words in their IDF sections so
// ROM and IDF code observe the expected offsets without a C initializer.
val esp32PicolibcTlsStdin = nativeInternalSectionThreadLocalAllocate(
    4, "abla_picolibc_tls_stdin", ".tdata.tls_stdin", 4
)
val esp32PicolibcTlsStdout = nativeInternalSectionThreadLocalAllocate(
    4, "abla_picolibc_tls_stdout", ".tdata.tls_stdout", 4
)
val esp32PicolibcTlsStderr = nativeInternalSectionThreadLocalAllocate(
    4, "abla_picolibc_tls_stderr", ".tdata.tls_stderr", 4
)

trusted fun esp32PicolibcTlsCompatibilityReady(): bool =
    esp32PicolibcTlsStdin != 0 &&
    esp32PicolibcTlsStdout != 0 &&
    esp32PicolibcTlsStderr != 0

