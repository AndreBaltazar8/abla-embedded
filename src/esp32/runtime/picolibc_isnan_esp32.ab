@inline
trusted fun esp32PicolibcIsNanBits(low: u32, high: u32): u32 {
    val exponent = high & u32(2146435072)
    val mantissa = (high & u32(1048575)) | low
    if (exponent == u32(2146435072) && mantissa != u32(0)) u32(1) else u32(0)
}

@inline
trusted fun esp32PicolibcIsnand(value: f64): u32 =
    if (value != value) u32(1) else u32(0)

@inline
trusted fun esp32PicolibcIsnan(value: f64): u32 = esp32PicolibcIsnand(value)

@inline
trusted fun esp32PicolibcIsnanl(value: f64): u32 = esp32PicolibcIsnand(value)

@inline
trusted fun esp32PicolibcInternalIsnanl(value: f64): u32 =
    esp32PicolibcIsnand(value)

trusted fun esp32RecoveredIsnand(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcIsNanBits(a2, a3)

