import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcBufioOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBufioFlushLocked", "__bufio_flush_locked")) return false
    if (!internalFunction("esp32RecoveredBufioBufferAllocateLocked", "__bufio_buffer_allocate_locked")) return false
    if (!internalFunction("esp32RecoveredBufioFillLocked", "__bufio_fill_locked")) return false
    if (!exportFunction("esp32RecoveredBufioFlush", "__bufio_flush")) return false
    if (!internalFunction("esp32RecoveredBufioSetdirLocked", "__bufio_setdir_locked")) return false
    if (!exportFunction("esp32RecoveredBufioPut", "__bufio_put")) return false
    if (!exportFunction("esp32RecoveredBufioGet", "__bufio_get")) return false
    if (!exportFunction("esp32RecoveredBufioSeek", "__bufio_seek")) return false
    if (!exportFunction("esp32RecoveredBufioSetvbuf", "__bufio_setvbuf")) return false
    if (!exportFunction("esp32RecoveredBufioClose", "__bufio_close")) return false
    true
}
