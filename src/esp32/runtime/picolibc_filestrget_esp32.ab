import "abla/unsafe/memory"

trusted fun esp32FileStringGet(stream: u32): u32 {
    val cursor = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(stream + u32(20)))
    ))
    val byte = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(cursor))))
    if (byte == u32(0)) return u32(4294967294)
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(stream + u32(20))),
        int(cursor + u32(1))
    )
    return byte
}

trusted fun esp32RecoveredFileStrGet(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32FileStringGet(a2)
