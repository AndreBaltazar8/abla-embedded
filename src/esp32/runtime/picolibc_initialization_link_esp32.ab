import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcInitializationOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspLibcInit", "esp_libc_init")) return false
    if (!internalFunction("esp32RecoveredEspReentCleanup", "esp_reent_cleanup")) return false
    if (!internalFunction("esp32RecoveredEspLibcInitGlobalStdio", "esp_libc_init_global_stdio")) return false
    if (!internalFunction("esp32RecoveredEspLibcIncludeInitFuncs", "esp_libc_include_init_funcs")) return false
    if (!internalFunction("esp32RecoveredEspSetupNewlibSyscalls", "esp_setup_newlib_syscalls")) return false
    if (!internalFunction("esp32RecoveredEspNewlibInit", "esp_newlib_init")) return false
    true
}
