import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcRandOpaqueCallers(): bool {
    if (!internalFunction("esp32LibcSrand", "srand")) return false
    if (!internalFunction("esp32LibcRand", "rand")) return false
    true
}
