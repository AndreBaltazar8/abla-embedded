import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcVfprintfCallers(): bool {
    if (!internalFunction("esp32RecoveredDVfprintf", "__d_vfprintf")) return false
    if (!internalFunction("esp32RecoveredVfprintf", "vfprintf")) return false
    true
}
