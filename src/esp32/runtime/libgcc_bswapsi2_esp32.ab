// Abla/LLVM implementation of the Xtensa 32-bit byte-swap runtime.

// Original ABI symbol: __bswapsi2
@inline
trusted fun esp32RecoveredBswapsi2(value: u32): u32 =
    ((value & u32(255)) << u32(24)) |
    ((value & u32(65280)) << u32(8)) |
    ((value >>> u32(8)) & u32(65280)) |
    (value >>> u32(24))
