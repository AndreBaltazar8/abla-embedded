// Structured Abla implementation of libsupc++ eh_globals.cc.
val esp32EhGlobalsThreadKeyStorage = nativeStaticAllocate(4)
val esp32EhGlobalsThreadKey = u32(esp32EhGlobalsThreadKeyStorage)
val esp32EhGlobalsThreadKeyReadyStorage = nativeStaticAllocate(1)
val esp32EhGlobalsThreadKeyReady = u32(esp32EhGlobalsThreadKeyReadyStorage)
val esp32EhGlobalsStaticStorage = nativeStaticAllocate(8)
val esp32EhGlobalsStatic = u32(esp32EhGlobalsStaticStorage)

@inline
trusted fun esp32EhGlobalsLoadU8(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32EhGlobalsLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32EhGlobalsStoreU8(address:u32, value:u32):void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32EhGlobalsStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32EhGlobalsDestroy(globals:u32):void {
    if (globals == u32(0)) return
    var exception = esp32EhGlobalsLoadU32(globals)
    while (exception != u32(0)) {
        val next = esp32EhGlobalsLoadU32(exception + u32(16))
        esp32RecoveredWrapUnwindDeleteException(
            exception + u32(48),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        exception = next
    }
    esp32LibcFreeValue(globals)
    return
}

trusted fun esp32EhGlobalsInitialize():void {
    val status = esp32RecoveredPthreadKeyCreate(
        esp32EhGlobalsThreadKey,u32(nativeFunctionAddress(esp32EhGlobalsDestroy)),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32EhGlobalsStoreU8(esp32EhGlobalsThreadKeyReady,
        if (status == u32(0)) u32(1) else u32(0))
}

trusted fun esp32EhGlobalsDeinitialize():void {
    if (esp32EhGlobalsLoadU8(esp32EhGlobalsThreadKeyReady) == u32(0)) return
    esp32EhGlobalsStoreU8(esp32EhGlobalsThreadKeyReady,u32(0))
    esp32RecoveredPthreadKeyDelete(
        esp32EhGlobalsLoadU32(esp32EhGlobalsThreadKey),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0))
    return
}

trusted fun esp32CxaGetGlobalsFast():u32 {
    if (esp32EhGlobalsLoadU8(esp32EhGlobalsThreadKeyReady) == u32(0)) {
        return esp32EhGlobalsStatic
    }
    esp32RecoveredPthreadGetspecific(
        esp32EhGlobalsLoadU32(esp32EhGlobalsThreadKey),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0))
}

trusted fun esp32CxaGetGlobals():u32 {
    if (esp32EhGlobalsLoadU8(esp32EhGlobalsThreadKeyReady) == u32(0)) {
        return esp32EhGlobalsStatic
    }
    val key = esp32EhGlobalsLoadU32(esp32EhGlobalsThreadKey)
    var globals = esp32RecoveredPthreadGetspecific(
        key,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (globals != u32(0)) return globals
    globals = esp32LibcMalloc(u32(8))
    if (globals == u32(0)) {
        esp32Terminate()
    }
    if (esp32RecoveredPthreadSetspecific(
        key,globals,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)) != u32(0)) {
        esp32Terminate()
    }
    esp32EhGlobalsStoreU32(globals,u32(0))
    esp32EhGlobalsStoreU32(globals + u32(4),u32(0))
    globals
}

