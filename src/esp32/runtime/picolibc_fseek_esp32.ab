import "picolibc_stream_lock_esp32.ab"
import "picolibc_stream_pushback_esp32.ab"
import "libc_errno_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32PicolibcSeek(stream: u32, offset: u32, whence: u32): u32 {
    val lock = esp32PicolibcStreamLock(stream)
    val flagsAddress = stream + u32(2)
    var flags = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(flagsAddress))))
    val seekFunction = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(stream + u32(24)))
    ))
    if ((flags & u32(32)) == u32(0) || seekFunction == u32(0)) {
        esp32LibcSetErrno(u32(29))
        esp32PicolibcStreamUnlock(lock)
        return u32(4294967295)
    }

    val position = u64(ablaUnsafeCallI64I32I32I32I32I32I32(
        int(seekFunction), int(stream), int(offset), int(whence), 0, 0, 0
    ))
    if (i32(u32(position)) < 0) {
        esp32PicolibcStreamUnlock(lock)
        return u32(4294967295)
    }

    flags = flags & u32(4294967287)
    ablaUnsafeStoreU8(nativePointerFromAddress(int(flagsAddress)), int(flags))
    esp32PicolibcClearPushback(stream)
    esp32PicolibcStreamUnlock(lock)
    u32(0)
}

trusted fun esp32PicolibcFseek(stream: u32, offset: u32, whence: u32): u32 =
    esp32PicolibcSeek(stream, offset, whence)

trusted fun esp32RecoveredFseek(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFseek(a2, a3, a4)
