// ESP-IDF libc locks implemented as structured Abla. The queue operations
// below call the Abla FreeRTOS implementation directly; this module contains
// no recovered Xtensa register machine.

val esp32LibcLockNormalMutex = u32(1)
val esp32LibcLockRecursiveMutex = u32(4)
val esp32LibcLockWaitForever = u32(4294967295)
val esp32LibcLockSchedulerNotStarted = u32(1)
val esp32LibcLockQueueSuccess = u32(1)

// portMUX_INITIALIZER_UNLOCKED for the classic dual-core ESP32.
val esp32LibcLockInitSpinlockStorage = nativeStaticMutableU32s([
    3007315967,
    0
])
val esp32LibcLockInitSpinlock = u32(esp32LibcLockInitSpinlockStorage)

// StaticQueue_t is 84 bytes for this ESP-IDF/FreeRTOS configuration.
val esp32LibcCommonMutexStorage = nativeStaticAllocate(84)
val esp32LibcCommonMutex = u32(esp32LibcCommonMutexStorage)
val esp32LibcCommonRecursiveMutexStorage = nativeStaticAllocate(84)
val esp32LibcCommonRecursiveMutex = u32(esp32LibcCommonRecursiveMutexStorage)
val esp32LibcPicolibcRecursiveMutexStorage = nativeStaticAllocate(84)
val esp32LibcPicolibcRecursiveMutex = u32(esp32LibcPicolibcRecursiveMutexStorage)

// Source-level aliases for the lock objects used by converted picolibc code.
// The rarely-used Newlib locks share ESP-IDF's two common mutexes.
val esp32Data_lock_libc_recursive_mutex_d7926e1621Storage =
    esp32LibcPicolibcRecursiveMutexStorage
val esp32Data_lock_libc_recursive_mutex_d7926e1621 =
    esp32LibcPicolibcRecursiveMutex
val esp32Data_lock_atexit_recursive_mutex_4650964246Storage =
    esp32LibcCommonRecursiveMutexStorage
val esp32Data_lock_atexit_recursive_mutex_4650964246 =
    esp32LibcCommonRecursiveMutex
