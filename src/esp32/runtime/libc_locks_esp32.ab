    esp32LibcCommonRecursiveMutexStorage
val esp32Data_lock_sfp_recursive_mutex_377bcd7ff8 =
    esp32LibcCommonRecursiveMutex
val esp32Data_lock_env_recursive_mutex_16db7f4f47Storage =
    esp32LibcCommonRecursiveMutexStorage
val esp32Data_lock_env_recursive_mutex_16db7f4f47 =
    esp32LibcCommonRecursiveMutex
val esp32Data_lock_malloc_recursive_mutex_a3c498c90cStorage =
    esp32LibcCommonRecursiveMutexStorage
val esp32Data_lock_malloc_recursive_mutex_a3c498c90c =
    esp32LibcCommonRecursiveMutex
val esp32Data_lock_sinit_recursive_mutex_b9baad6d00Storage =
    esp32LibcCommonRecursiveMutexStorage
val esp32Data_lock_sinit_recursive_mutex_b9baad6d00 =
    esp32LibcCommonRecursiveMutex
val esp32Data_lock_arc4random_mutex_fea7dc7ecdStorage =
    esp32LibcCommonMutexStorage
val esp32Data_lock_arc4random_mutex_fea7dc7ecd = esp32LibcCommonMutex
val esp32Data_lock_dd_hash_mutex_3480d253d5Storage =
    esp32LibcCommonMutexStorage
val esp32Data_lock_dd_hash_mutex_3480d253d5 = esp32LibcCommonMutex
val esp32Data_lock_tz_mutex_4716923e6eStorage = esp32LibcCommonMutexStorage
val esp32Data_lock_tz_mutex_4716923e6e = esp32LibcCommonMutex
val esp32Data_lock_at_quick_exit_mutex_40cff3d1b6Storage =
    esp32LibcCommonMutexStorage
val esp32Data_lock_at_quick_exit_mutex_40cff3d1b6 = esp32LibcCommonMutex

@inline
trusted fun esp32LibcLockLoad(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32LibcLockStore(address: u32, value: u32): void {
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))
}

@inline
trusted fun esp32LibcLockSchedulerState(): u32 =
    esp32RecoveredXTaskGetSchedulerState(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )

@inline
trusted fun esp32LibcLockCreateMutex(mutexType: u32): u32 =
    esp32RecoveredXQueueCreateMutex(
        mutexType, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )

@inline
trusted fun esp32LibcLockCreateStaticMutex(
    mutexType: u32,
    storage: u32
): u32 {
    val queue = esp32FreertosInitializePermanentStaticMutex(storage)
    queue
}

trusted fun esp32LibcLockAbort(): void {
    freestandingAbortValue()
    return
}

trusted fun esp32LibcLockInitGeneric(
    lockAddress: u32,
    mutexType: u32
): void {
    if (lockAddress == u32(0)) esp32LibcLockAbort()
    esp32RecoveredXPortEnterCriticalTimeout(
        esp32LibcLockInitSpinlock,
        esp32LibcLockWaitForever
    )
    if (esp32LibcLockLoad(lockAddress) == u32(0)) {
        val mutex = esp32LibcLockCreateMutex(mutexType)
        if (mutex == u32(0)) esp32LibcLockAbort()
        esp32LibcLockStore(lockAddress, mutex)
    }
    esp32RecoveredVPortExitCriticalValue(esp32LibcLockInitSpinlock)
    return
}

trusted fun esp32LibcLockInit(lockAddress: u32, mutexType: u32): void {
    if (lockAddress == u32(0)) esp32LibcLockAbort()
    esp32LibcLockStore(lockAddress, u32(0))
    esp32LibcLockInitGeneric(lockAddress, mutexType)
}

trusted fun esp32LibcLockClose(lockAddress: u32): void {
    if (lockAddress == u32(0)) esp32LibcLockAbort()
    esp32RecoveredXPortEnterCriticalTimeout(
        esp32LibcLockInitSpinlock,
        esp32LibcLockWaitForever
    )
    val handle = esp32LibcLockLoad(lockAddress)
    if (handle != u32(0)) {
        val holder = esp32RecoveredXQueueGetMutexHolder(
            handle, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
        if (holder != u32(0)) esp32LibcLockAbort()
        esp32RecoveredVQueueDelete(
            handle, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
        esp32LibcLockStore(lockAddress, u32(0))
    }
    esp32RecoveredVPortExitCriticalValue(esp32LibcLockInitSpinlock)
    return
}

trusted fun esp32LibcLockTakeHandle(
    handle: u32,
    delay: u32,
    mutexType: u32
): u32 {
    if (esp32LibcLockSchedulerState() == esp32LibcLockSchedulerNotStarted) {
        return u32(0)
    }
    if (handle == u32(0)) esp32LibcLockAbort()

    var success = u32(0)
    if (esp32RecoveredXPortInIsrContext() != u32(0)) {
        if (mutexType == esp32LibcLockRecursiveMutex) esp32LibcLockAbort()
        val higherTaskWokenAddress = u32(nativeStackAllocate(4))
        esp32LibcLockStore(higherTaskWokenAddress, u32(0))
        success = esp32RecoveredXQueueReceiveFromISR(
            handle, u32(0), higherTaskWokenAddress,
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0)
        )
        if (success == u32(0) && delay != u32(0)) esp32LibcLockAbort()
        if (esp32LibcLockLoad(higherTaskWokenAddress) != u32(0)) {
            esp32RecoveredFrxtSetupSwitch()
        }
    } else if (mutexType == esp32LibcLockRecursiveMutex) {
        success = esp32RecoveredXQueueTakeMutexRecursive(
            handle, delay, u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
    } else {
        success = esp32RecoveredXQueueSemaphoreTake(
            handle, delay, u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
    }
    return if (success == esp32LibcLockQueueSuccess) u32(0)
        else u32(4294967295)
}

trusted fun esp32LibcLockAcquireGeneric(
    lockAddress: u32,
    delay: u32,
    mutexType: u32
): u32 {
    if (lockAddress == u32(0)) esp32LibcLockAbort()
    var handle = esp32LibcLockLoad(lockAddress)
    if (handle == u32(0)) {
        if (esp32LibcLockSchedulerState() ==
            esp32LibcLockSchedulerNotStarted) return u32(0)
        esp32LibcLockInitGeneric(lockAddress, mutexType)
        handle = esp32LibcLockLoad(lockAddress)
    }
    return esp32LibcLockTakeHandle(handle, delay, mutexType)
}

trusted fun esp32LibcLockReleaseHandle(
    handle: u32,
    mutexType: u32
): void {
    if (esp32LibcLockSchedulerState() == esp32LibcLockSchedulerNotStarted) {
        return
    }
    if (handle == u32(0)) esp32LibcLockAbort()

    if (esp32RecoveredXPortInIsrContext() != u32(0)) {
        if (mutexType == esp32LibcLockRecursiveMutex) esp32LibcLockAbort()
        val higherTaskWokenAddress = u32(nativeStackAllocate(4))
        esp32LibcLockStore(higherTaskWokenAddress, u32(0))
        esp32RecoveredXQueueGiveFromISR(
            handle, higherTaskWokenAddress,
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0)
        )
        if (esp32LibcLockLoad(higherTaskWokenAddress) != u32(0)) {
            esp32RecoveredFrxtSetupSwitch()
        }
    } else if (mutexType == esp32LibcLockRecursiveMutex) {
        esp32RecoveredXQueueGiveMutexRecursive(
            handle, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
    } else {
        esp32RecoveredXQueueGenericSend(
            handle, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
    }
}

trusted fun esp32LibcLockReleaseGeneric(
    lockAddress: u32,
    mutexType: u32
): void {
    if (lockAddress == u32(0)) esp32LibcLockAbort()
    esp32LibcLockReleaseHandle(esp32LibcLockLoad(lockAddress), mutexType)
}

trusted fun esp32LibcRetargetClose(handle: u32): void {
    val lockAddress = u32(nativeStackAllocate(4))
    esp32LibcLockStore(lockAddress, handle)
    esp32LibcLockClose(lockAddress)
}

@inline
trusted fun esp32LibcLocksInitialize(): void {
    if (esp32LibcLockCreateStaticMutex(
        esp32LibcLockNormalMutex,
        esp32LibcCommonMutex
    ) != esp32LibcCommonMutex) esp32LibcLockAbort()
    if (esp32LibcLockCreateStaticMutex(
        esp32LibcLockRecursiveMutex,
        esp32LibcCommonRecursiveMutex
    ) != esp32LibcCommonRecursiveMutex) esp32LibcLockAbort()
    if (esp32LibcLockCreateStaticMutex(
        esp32LibcLockRecursiveMutex,
        esp32LibcPicolibcRecursiveMutex
    ) != esp32LibcPicolibcRecursiveMutex) esp32LibcLockAbort()
}

// ABI-compatible facades remain while other converted modules still use the
// original ESP-IDF call shape. LLVM can inline them in the monolith.
trusted fun esp32RecoveredLockInit(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32LibcLockInit(a2, esp32LibcLockNormalMutex)
    return a2
}

