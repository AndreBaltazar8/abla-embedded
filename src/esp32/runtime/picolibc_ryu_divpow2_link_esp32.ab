import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcRyuDivpow2Callers(): bool {
    if (!internalFunction("esp32RyuMultiplyInversePower5DividePower2", "__mulPow5InvDivPow2")) return false
    if (!internalFunction("esp32RyuMultiplyPower5DividePower2", "__mulPow5divPow2")) return false
    true
}
