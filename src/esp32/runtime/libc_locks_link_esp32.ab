import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcLocksOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredLockInit", "_lock_init")) return false
    if (!exportFunction("esp32RecoveredLockInitRecursive", "_lock_init_recursive")) return false
    if (!exportFunction("esp32RecoveredLockClose", "_lock_close")) return false
    if (!exportFunction("esp32RecoveredLockAcquire", "_lock_acquire")) return false
    if (!exportFunction("esp32RecoveredLockAcquireRecursive", "_lock_acquire_recursive")) return false
    if (!exportFunction("esp32RecoveredLockTryAcquire", "_lock_try_acquire")) return false
    if (!exportFunction("esp32RecoveredLockTryAcquireRecursive", "_lock_try_acquire_recursive")) return false
    if (!exportFunction("esp32RecoveredLockRelease", "_lock_release")) return false
    if (!exportFunction("esp32RecoveredLockReleaseRecursive", "_lock_release_recursive")) return false
    if (!internalFunction("esp32RecoveredRetargetLockInit", "__retarget_lock_init")) return false
    if (!internalFunction("esp32RecoveredRetargetLockInitRecursive", "__retarget_lock_init_recursive")) return false
    if (!internalFunction("esp32RecoveredRetargetLockClose", "__retarget_lock_close")) return false
    if (!internalFunction("esp32RecoveredRetargetLockCloseRecursive", "__retarget_lock_close_recursive")) return false
    if (!internalFunction("esp32RecoveredRetargetLockAcquire", "__retarget_lock_acquire")) return false
    if (!internalFunction("esp32RecoveredRetargetLockAcquireRecursive", "__retarget_lock_acquire_recursive")) return false
    if (!internalFunction("esp32RecoveredRetargetLockTryAcquire", "__retarget_lock_try_acquire")) return false
    if (!internalFunction("esp32RecoveredRetargetLockTryAcquireRecursive", "__retarget_lock_try_acquire_recursive")) return false
    if (!internalFunction("esp32RecoveredRetargetLockRelease", "__retarget_lock_release")) return false
    if (!internalFunction("esp32RecoveredRetargetLockReleaseRecursive", "__retarget_lock_release_recursive")) return false
    if (!exportFunction("esp32RecoveredEspLibcLocksInit", "esp_libc_locks_init")) return false
    if (!internalFunction("esp32RecoveredEspNewlibLocksInit", "esp_newlib_locks_init")) return false
    true
}
