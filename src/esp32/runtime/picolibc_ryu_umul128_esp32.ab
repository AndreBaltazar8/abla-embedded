import "abla/unsafe/memory"

trusted fun esp32RyuUnsignedMultiply128(
    first:u64,second:u64,highOutput:u32
):u64 {
    val mask=u64(0xffffffff)
    val firstLow=first&mask
    val firstHigh=first>>>u64(32)
    val secondLow=second&mask
    val secondHigh=second>>>u64(32)
    val lowProduct=firstLow*secondLow
    val crossFirst=firstHigh*secondLow
    val crossSecond=firstLow*secondHigh
    val middle=(lowProduct>>>u64(32))+(crossFirst&mask)+(crossSecond&mask)
    val high=firstHigh*secondHigh+(crossFirst>>>u64(32))+
        (crossSecond>>>u64(32))+(middle>>>u64(32))
    val low=(lowProduct&mask)|(middle<<u64(32))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(highOutput)),int(u32(high)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(highOutput+u32(4))),
        int(u32(high>>>u64(32))))
    low
}

trusted fun esp32RyuShiftRight128(low:u64,high:u64,distance:u32):u64 {
    if(distance==u32(0)) return low
    if(distance< u32(64)) {
        return (low>>>u64(distance))|(high<<u64(u32(64)-distance))
    }
    if(distance< u32(128)) return high>>>u64(distance-u32(64))
    u64(0)
}

trusted fun esp32RecoveredUmul128(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=u32(esp32RyuUnsignedMultiply128(u64(a2)|(u64(a3)<<u64(32)),u64(a4)|(u64(a5)<<u64(32)),a6))
trusted fun esp32RecoveredShiftright128(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=u32(esp32RyuShiftRight128(u64(a2)|(u64(a3)<<u64(32)),u64(a4)|(u64(a5)<<u64(32)),a6))
