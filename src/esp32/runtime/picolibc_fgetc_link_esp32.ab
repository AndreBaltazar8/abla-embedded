import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcFgetcOpaqueCallers(): bool {
    if (!internalFunction("esp32PicolibcFgetc", "fgetc")) return false
    if (!internalFunction("esp32PicolibcGetc", "getc")) return false
    if (!internalFunction("esp32PicolibcGetcUnlocked", "getc_unlocked")) return false
    true
}
