import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcRyuLog2pow5Callers(): bool {
    if (!internalFunction("esp32RecoveredLog2pow5", "__log2pow5")) return false
    if (!internalFunction("esp32RecoveredCeilLog2pow5", "__ceil_log2pow5")) return false
    true
}
