// Abla/LLVM implementation of the Xtensa 64-bit byte-swap runtime.

// Original ABI symbol: __bswapdi2
@inline
trusted fun esp32RecoveredBswapdi2(value: u64): u64 =
    ((value & u64(255)) << u64(56)) |
    ((value & (u64(255) << u64(8))) << u64(40)) |
    ((value & (u64(255) << u64(16))) << u64(24)) |
    ((value & (u64(255) << u64(24))) << u64(8)) |
    ((value >>> u64(8)) & (u64(255) << u64(24))) |
    ((value >>> u64(24)) & (u64(255) << u64(16))) |
    ((value >>> u64(40)) & (u64(255) << u64(8))) |
    (value >>> u64(56))
