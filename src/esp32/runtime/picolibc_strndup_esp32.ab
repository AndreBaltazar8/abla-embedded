import "libc_heap_esp32.ab"
import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"

trusted fun esp32StringDuplicateBounded(source: u32, maximum: u32): u32 {
    var length = u32(0)
    while (length < maximum && u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(source + length))
    )) != u32(0)) {
        length = length + u32(1)
    }

    val destination = esp32LibcMalloc(length + u32(1))
    if (destination == u32(0)) return u32(0)
    freestandingCopy(destination, source, length)
    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(destination + length)),
        0
    )
    return destination
}

trusted fun esp32RecoveredStrndup(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32StringDuplicateBounded(a2, a3)
