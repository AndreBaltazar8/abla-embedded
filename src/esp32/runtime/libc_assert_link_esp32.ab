import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcAssertInternals(): bool {
    if (!internalFunction("esp32AssertFunction", "__assert_func")) return false
    if (!internalFunction("esp32Assert", "__assert")) return false
    if (!internalFunction("esp32LibcIncludeAssert", "esp_libc_include_assert_impl")) return false
    true
}
