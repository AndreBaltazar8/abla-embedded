import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcRyuLog10Callers(): bool {
    if (!internalFunction("esp32RecoveredLog10Pow2", "__log10Pow2")) return false
    if (!internalFunction("esp32RecoveredLog10Pow5", "__log10Pow5")) return false
    true
}
