import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRuntimeEhGlobalsInternals(): bool {
    if (!internalFunction("esp32CxaGetGlobalsFast", "__cxa_get_globals_fast")) return false
    if (!internalFunction("esp32CxaGetGlobals", "__cxa_get_globals")) return false
    true
}
