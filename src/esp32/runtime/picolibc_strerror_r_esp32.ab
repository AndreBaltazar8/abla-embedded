import "../../runtime/freestanding_memory.ab"

// GNU strerror_r semantics: return the static message when it does not fit,
// otherwise copy it into the caller buffer and return that buffer.
trusted fun esp32PicolibcStrerrorR(errorNumber: u32, buffer: u32, size: u32): u32 {
    val message = esp32RecoveredStrerrorR(
        errorNumber, u32(1), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (freestandingStringLength(message) >= size) return message
    freestandingStringCopy(buffer, message)
}

trusted fun esp32RecoveredPosixStrerrorR(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcStrerrorR(a2, a3, a4)
