import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcRyuTableCallers(): bool {
    if (!internalFunction("esp32RecoveredPow5Factor", "__pow5Factor")) return false
    if (!internalFunction("esp32RecoveredDoubleComputePow5", "__double_computePow5")) return false
    if (!internalFunction("esp32RecoveredDoubleComputeInvPow5", "__double_computeInvPow5")) return false
    true
}
