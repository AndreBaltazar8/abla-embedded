import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcBufioSetvbufOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBufioSetvbuf", "__real___bufio_setvbuf")) return false
    if (!internalFunction("esp32LibcWrapBufioSetvbuf", "__wrap___bufio_setvbuf")) return false
    true
}
