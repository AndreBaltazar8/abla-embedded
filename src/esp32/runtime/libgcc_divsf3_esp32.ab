// Integer-only binary32 division, rounded directly to nearest, ties to even.
// Floating division here could recursively lower back to __divsf3.
fun esp32Binary32DivideRounded(numerator:u32, denominator:u32, fractionBits:i32):u32 {
    var quotient = u32(0)
    var remainder = numerator
    var index = i32(0)
    while (index <= fractionBits) {
        quotient = quotient << u32(1)
        if (remainder >= denominator) {
            remainder = remainder - denominator
            quotient = quotient | u32(1)
        }
        if (index < fractionBits) remainder = remainder << u32(1)
        index = index + i32(1)
    }
    val doubled = remainder << u32(1)
    if (doubled > denominator ||
        (doubled == denominator && (quotient & u32(1)) != u32(0))) {
        quotient = quotient + u32(1)
    }
    return quotient
}

trusted fun esp32Binary32Divide(dividend:u32, divisor:u32):u32 {
    val sign = (dividend ^ divisor) & u32(0x80000000)
    val dividendExponentBits = (dividend >>> u32(23)) & u32(255)
    val divisorExponentBits = (divisor >>> u32(23)) & u32(255)
    var dividendSignificand = dividend & u32(0x007fffff)
    var divisorSignificand = divisor & u32(0x007fffff)
    if (dividendExponentBits == u32(255)) {
        if (dividendSignificand != u32(0)) return dividend | u32(0x00400000)
        if (divisorExponentBits == u32(255)) {
            if (divisorSignificand != u32(0)) return divisor | u32(0x00400000)
            return u32(0x7fc00000)
        }
        return sign | u32(0x7f800000)
    }
    if (divisorExponentBits == u32(255)) {
        if (divisorSignificand != u32(0)) return divisor | u32(0x00400000)
        return sign
    }
    val dividendZero = dividendExponentBits == u32(0) && dividendSignificand == u32(0)
    val divisorZero = divisorExponentBits == u32(0) && divisorSignificand == u32(0)
    if (dividendZero && divisorZero) return u32(0x7fc00000)
    if (divisorZero) return sign | u32(0x7f800000)
    if (dividendZero) return sign

    var dividendExponent = i32(dividendExponentBits) - i32(127)
    if (dividendExponentBits == u32(0)) {
        dividendExponent = i32(-126)
        while (dividendSignificand < u32(0x00800000)) {
            dividendSignificand = dividendSignificand << u32(1)
            dividendExponent = dividendExponent - i32(1)
        }
    } else dividendSignificand = dividendSignificand | u32(0x00800000)
    var divisorExponent = i32(divisorExponentBits) - i32(127)
    if (divisorExponentBits == u32(0)) {
        divisorExponent = i32(-126)
        while (divisorSignificand < u32(0x00800000)) {
            divisorSignificand = divisorSignificand << u32(1)
            divisorExponent = divisorExponent - i32(1)
        }
    } else divisorSignificand = divisorSignificand | u32(0x00800000)

    var exponent = dividendExponent - divisorExponent
    if (dividendSignificand < divisorSignificand) {
        dividendSignificand = dividendSignificand << u32(1)
        exponent = exponent - i32(1)
    }
    if (exponent > i32(127)) return sign | u32(0x7f800000)
    if (exponent < i32(-126)) {
        val fractionBits = exponent + i32(149)
        if (fractionBits < i32(-1)) return sign
        if (fractionBits == i32(-1)) {
            // Half a minimum subnormal ties to zero; larger ratios round up.
            return sign | (if (dividendSignificand > divisorSignificand) u32(1) else u32(0))
        }
        // A rounded carry naturally encodes the minimum normal number.
        return sign | esp32Binary32DivideRounded(dividendSignificand, divisorSignificand, fractionBits)
    }
    var significand = esp32Binary32DivideRounded(dividendSignificand, divisorSignificand, i32(23))
    if (significand >= u32(0x01000000)) {
        significand = significand >>> u32(1)
        exponent = exponent + i32(1)
    }
    if (exponent > i32(127)) return sign | u32(0x7f800000)
    return sign | (u32(exponent + i32(127)) << u32(23)) | (significand & u32(0x007fffff))
}

// Original __divsf3 ABI passes binary32 operands as two integer words.
trusted fun esp32RecoveredDivsf3(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32Binary32Divide(a2, a3)
