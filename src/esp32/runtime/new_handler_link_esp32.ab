import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRuntimeNewHandlerInternals(): bool {
    if (!internalFunction("esp32SetNewHandler", "_ZSt15set_new_handlerPFvvE")) return false
    if (!internalFunction("esp32GetNewHandler", "_ZSt15get_new_handlerv")) return false
    true
}
