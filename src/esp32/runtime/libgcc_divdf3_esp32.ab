import "./binary64_esp32.ab"

// Complete integer implementation of binary64 division. Long division emits
// only the result precision actually needed, including direct subnormal
// rounding, so there is no auxiliary libgcc body and no double rounding.
trusted fun esp32Binary64Divide(dividend: u64, divisor: u64): u64 {
    val sign = (dividend ^ divisor) & esp32Binary64SignMask
    val dividendExponentBits = esp32Binary64Exponent(dividend)
    val divisorExponentBits = esp32Binary64Exponent(divisor)
    var dividendSignificand = esp32Binary64Fraction(dividend)
    var divisorSignificand = esp32Binary64Fraction(divisor)

    if (dividendExponentBits == u32(2047)) {
        if (dividendSignificand != u64(0)) {
            return esp32Binary64QuietNanFrom(dividend)
        }
        if (divisorExponentBits == u32(2047)) {
            if (divisorSignificand != u64(0)) {
                return esp32Binary64QuietNanFrom(divisor)
            }
            return esp32Binary64QuietNan
        }
        return sign | esp32Binary64Infinity
    }
    if (divisorExponentBits == u32(2047)) {
        if (divisorSignificand != u64(0)) {
            return esp32Binary64QuietNanFrom(divisor)
        }
        return sign
    }

    val dividendZero = dividendExponentBits == u32(0) &&
        dividendSignificand == u64(0)
    val divisorZero = divisorExponentBits == u32(0) &&
        divisorSignificand == u64(0)
    if (dividendZero && divisorZero) return esp32Binary64QuietNan
    if (divisorZero) return sign | esp32Binary64Infinity
    if (dividendZero) return sign

    var dividendExponent = i32(dividendExponentBits) - i32(1023)
    if (dividendExponentBits == u32(0)) {
        dividendExponent = i32(-1022)
        while (dividendSignificand < esp32Binary64HiddenBit) {
            dividendSignificand = dividendSignificand << u64(1)
            dividendExponent = dividendExponent - i32(1)
        }
    } else dividendSignificand = dividendSignificand |
        esp32Binary64HiddenBit

    var divisorExponent = i32(divisorExponentBits) - i32(1023)
    if (divisorExponentBits == u32(0)) {
        divisorExponent = i32(-1022)
        while (divisorSignificand < esp32Binary64HiddenBit) {
            divisorSignificand = divisorSignificand << u64(1)
            divisorExponent = divisorExponent - i32(1)
        }
    } else divisorSignificand = divisorSignificand |
        esp32Binary64HiddenBit

    var exponent = dividendExponent - divisorExponent
    if (dividendSignificand < divisorSignificand) {
        dividendSignificand = dividendSignificand << u64(1)
        exponent = exponent - i32(1)
    }
    if (exponent > i32(1023)) return sign | esp32Binary64Infinity

    if (exponent < i32(-1022)) {
        val fractionBits = exponent + i32(1074)
        if (fractionBits < i32(-1)) return sign
        if (fractionBits == i32(-1)) {
            // Exactly 0.5 ulp ties to the even zero; any larger ratio rounds
            // to the minimum subnormal.
            return sign | (if (dividendSignificand > divisorSignificand)
                u64(1) else u64(0))
        }
        val fraction = esp32Binary64DivideRounded(
            dividendSignificand, divisorSignificand, fractionBits
        )
        return sign | fraction
    }

    var significand = esp32Binary64DivideRounded(
        dividendSignificand, divisorSignificand, i32(52)
    )
    if (significand >= (esp32Binary64HiddenBit << u64(1))) {
        significand = significand >>> u64(1)
        exponent = exponent + i32(1)
    }
    if (exponent > i32(1023)) return sign | esp32Binary64Infinity
    return sign | (u64(exponent + i32(1023)) << u64(52)) |
        (significand & esp32Binary64FractionMask)
}
