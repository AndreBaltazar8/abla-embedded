import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPicolibcStrtokROpaqueCallers(): bool {
    if (!internalFunction("esp32PicolibcInternalStrtokR", "__strtok_r")) return false
    if (!internalFunction("esp32PicolibcPublicStrtokR", "strtok_r")) return false
    true
}
