import "picolibc_stream_lock_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32PicolibcPutcUnlocked(character: u32, stream: u32): u32 {
    val flagsAddress = stream + u32(2)
    val flags = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(flagsAddress))))
    if ((flags & u32(2)) == u32(0)) return u32(4294967295)

    val byte = character & u32(255)
    val putFunction = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(stream + u32(4)))
    ))
    val result = i32(ablaUnsafeCallI32I32I32I32I32I32I32(
        int(putFunction), int(byte), int(stream), 0, 0, 0, 0
    ))
    if (result >= 0) return byte

    ablaUnsafeStoreU8(nativePointerFromAddress(int(flagsAddress)), int(flags | u32(4)))
    u32(4294967295)
}

trusted fun esp32PicolibcFputc(character: u32, stream: u32): u32 {
    val lock = esp32PicolibcStreamLock(stream)
    val result = esp32PicolibcPutcUnlocked(character, stream)
    esp32PicolibcStreamUnlock(lock)
    result
}

trusted fun esp32PicolibcPutc(character: u32, stream: u32): u32 =
    esp32PicolibcFputc(character, stream)

trusted fun esp32RecoveredFputc(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFputc(a2, a3)

trusted fun esp32RecoveredPutc(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFputc(a2, a3)

trusted fun esp32RecoveredPutcUnlocked(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcPutcUnlocked(a2, a3)
