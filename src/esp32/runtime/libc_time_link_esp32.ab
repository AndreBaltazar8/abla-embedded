import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcTimeOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredAdjtime", "adjtime")) return false
    if (!internalFunction("esp32RecoveredGettimeofdayR", "_gettimeofday_r")) return false
    if (!internalFunction("esp32RecoveredTimesR", "_times_r")) return false
    if (!exportFunction("esp32RecoveredSettimeofday", "settimeofday")) return false
    if (!exportFunction("esp32RecoveredUsleep", "usleep")) return false
    if (!exportFunction("esp32RecoveredSleep", "sleep")) return false
    if (!internalFunction("esp32RecoveredClockSettime", "clock_settime")) return false
    if (!exportFunction("esp32RecoveredClockGettime", "clock_gettime")) return false
    if (!internalFunction("esp32RecoveredClockGetres", "clock_getres")) return false
    if (!exportFunction("esp32RecoveredEspLibcTimeInit", "esp_libc_time_init")) return false
    if (!internalFunction("esp32RecoveredEspNewlibTimeInit", "esp_newlib_time_init")) return false
    true
}
