    if (!internalFunction("esp32RecoveredAtomicAndFetch8", "__atomic_and_fetch_8")) return false
    if (!internalFunction("esp32RecoveredAtomicFetchOr8", "__atomic_fetch_or_8")) return false
    if (!internalFunction("esp32RecoveredAtomicOrFetch8", "__atomic_or_fetch_8")) return false
    if (!internalFunction("esp32RecoveredAtomicFetchXor8", "__atomic_fetch_xor_8")) return false
    if (!internalFunction("esp32RecoveredAtomicXorFetch8", "__atomic_xor_fetch_8")) return false
    if (!internalFunction("esp32RecoveredAtomicFetchNand8", "__atomic_fetch_nand_8")) return false
    if (!internalFunction("esp32RecoveredAtomicNandFetch8", "__atomic_nand_fetch_8")) return false
    if (!internalFunction("esp32RecoveredAtomicLoad8", "__atomic_load_8")) return false
    if (!internalFunction("esp32RecoveredAtomicStore8", "__atomic_store_8")) return false
    if (!internalFunction("esp32RecoveredSyncFetchAndAdd8", "__sync_fetch_and_add_8")) return false
    if (!internalFunction("esp32RecoveredSyncAddAndFetch8", "__sync_add_and_fetch_8")) return false
