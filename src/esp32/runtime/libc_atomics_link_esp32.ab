    if (!internalFunction("esp32RecoveredSyncSubAndFetch8", "__sync_sub_and_fetch_8")) return false
    if (!internalFunction("esp32RecoveredSyncFetchAndAnd8", "__sync_fetch_and_and_8")) return false
    if (!internalFunction("esp32RecoveredSyncAndAndFetch8", "__sync_and_and_fetch_8")) return false
    if (!internalFunction("esp32RecoveredSyncFetchAndOr8", "__sync_fetch_and_or_8")) return false
