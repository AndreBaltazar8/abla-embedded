// Integer building blocks for freestanding IEEE-754 binary64 arithmetic.
// Keeping these in Abla lets LLVM inline and prune special-case paths without
// depending on libgcc's opaque auxiliary entry points.

val esp32Binary64SignMask = u64(9223372036854775808)
val esp32Binary64ExponentMask = u64(9218868437227405312)
val esp32Binary64FractionMask = u64(4503599627370495)
val esp32Binary64HiddenBit = u64(4503599627370496)
val esp32Binary64QuietBit = u64(2251799813685248)
val esp32Binary64Infinity = u64(9218868437227405312)
val esp32Binary64QuietNan = u64(9221120237041090560)

@inline
fun esp32Binary64Exponent(bits: u64): u32 =
    u32((bits >>> u64(52)) & u64(2047))

@inline
fun esp32Binary64Fraction(bits: u64): u64 =
    bits & esp32Binary64FractionMask

@inline
fun esp32Binary64QuietNanFrom(bits: u64): u64 =
    bits | esp32Binary64QuietBit

// Round an unsigned 128-bit high:low value after a right shift using IEEE
// round-to-nearest, ties-to-even. Every caller asks for a quotient <= 64 bits.
fun esp32Binary64RoundShift128(
    high: u64,
    low: u64,
    shift: i32
): u64 {
    if (shift >= i32(128)) return u64(0)
    var quotient = u64(0)
    var halfSet = false
    var sticky = false
    if (shift < i32(64)) {
        val count = u64(shift)
        quotient = (high << (u64(64) - count)) | (low >>> count)
        val half = u64(1) << (count - u64(1))
        val discarded = low & ((u64(1) << count) - u64(1))
        halfSet = (discarded & half) != u64(0)
        sticky = (discarded & (half - u64(1))) != u64(0)
    } else if (shift == i32(64)) {
        quotient = high
        val half = u64(1) << u64(63)
        halfSet = (low & half) != u64(0)
        sticky = (low & (half - u64(1))) != u64(0)
    } else {
        val count = u64(shift - i32(64))
        quotient = high >>> count
        val half = u64(1) << (count - u64(1))
        val discarded = high & ((u64(1) << count) - u64(1))
        halfSet = (discarded & half) != u64(0)
        sticky = (discarded & (half - u64(1))) != u64(0) ||
            low != u64(0)
    }
    if (halfSet && (sticky || (quotient & u64(1)) != u64(0))) {
        quotient = quotient + u64(1)
    }
    return quotient
}

// Return round((numerator / denominator) * 2^fractionBits). The normalized
// inputs are at most 53 bits, so remainder doubling cannot overflow u64.
fun esp32Binary64DivideRounded(
    numerator: u64,
    denominator: u64,
    fractionBits: i32
): u64 {
    var quotient = u64(0)
    var remainder = numerator
    var index = i32(0)
    while (index <= fractionBits) {
        quotient = quotient << u64(1)
        if (remainder >= denominator) {
            remainder = remainder - denominator
            quotient = quotient | u64(1)
        }
        if (index < fractionBits) remainder = remainder << u64(1)
        index = index + i32(1)
    }
    val doubled = remainder << u64(1)
    if (doubled > denominator ||
        (doubled == denominator && (quotient & u64(1)) != u64(0))) {
        quotient = quotient + u64(1)
    }
    return quotient
}
