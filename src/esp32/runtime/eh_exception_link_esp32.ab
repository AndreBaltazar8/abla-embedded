import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRuntimeEhExceptionInternals(): bool {
    if (!internalFunction("esp32RecoveredZNSt9exceptionD1Ev", "_ZNSt9exceptionD1Ev")) return false
    if (!internalFunction("esp32RecoveredZNSt13badExceptionD1Ev", "_ZNSt13bad_exceptionD1Ev")) return false
    if (!internalFunction("esp32RecoveredZGTtNKSt9exception4whatEv", "_ZGTtNKSt9exception4whatEv")) return false
    if (!internalFunction("esp32RecoveredZGTtNKSt13badException4whatEv", "_ZGTtNKSt13bad_exception4whatEv")) return false
    if (!internalFunction("esp32RecoveredZNSt9exceptionD0Ev", "_ZNSt9exceptionD0Ev")) return false
    if (!internalFunction("esp32RecoveredZNSt13badExceptionD0Ev", "_ZNSt13bad_exceptionD0Ev")) return false
    if (!internalFunction("esp32RecoveredZN10Cxxabiv115ForcedUnwindD1Ev", "_ZN10__cxxabiv115__forced_unwindD1Ev")) return false
    if (!internalFunction("esp32RecoveredZN10Cxxabiv115ForcedUnwindD0Ev", "_ZN10__cxxabiv115__forced_unwindD0Ev")) return false
    if (!internalFunction("esp32RecoveredZN10Cxxabiv119ForeignExceptionD1Ev", "_ZN10__cxxabiv119__foreign_exceptionD1Ev")) return false
    if (!internalFunction("esp32RecoveredZN10Cxxabiv119ForeignExceptionD0Ev", "_ZN10__cxxabiv119__foreign_exceptionD0Ev")) return false
    if (!internalFunction("esp32RecoveredZGTtNKSt9exceptionD1Ev", "_ZGTtNKSt9exceptionD1Ev")) return false
    if (!internalFunction("esp32RecoveredZGTtNKSt13badExceptionD1Ev", "_ZGTtNKSt13bad_exceptionD1Ev")) return false
    if (!internalFunction("esp32RecoveredZNSt9exceptionD2Ev", "_ZNSt9exceptionD2Ev")) return false
    if (!internalFunction("esp32RecoveredZNSt13badExceptionD2Ev", "_ZNSt13bad_exceptionD2Ev")) return false
    if (!internalFunction("esp32RecoveredZNKSt9exception4whatEv", "_ZNKSt9exception4whatEv")) return false
    if (!internalFunction("esp32RecoveredZNKSt13badException4whatEv", "_ZNKSt13bad_exception4whatEv")) return false
    if (!internalFunction("esp32RecoveredZN10Cxxabiv115ForcedUnwindD2Ev", "_ZN10__cxxabiv115__forced_unwindD2Ev")) return false
    if (!internalFunction("esp32RecoveredZN10Cxxabiv119ForeignExceptionD2Ev", "_ZN10__cxxabiv119__foreign_exceptionD2Ev")) return false
