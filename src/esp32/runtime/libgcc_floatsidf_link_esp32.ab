import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibgccFloatSiDfOpaqueCallers(): bool {
    if (!internalFunction("esp32LibgccFloatunsidf", "__floatunsidf")) return false
    if (!internalFunction("esp32LibgccFloatsidf", "__floatsidf")) return false
    true
}
