import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcPthreadOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredPthreadSetcancelstate", "pthread_setcancelstate")) return false
    if (!internalFunction("esp32RecoveredPthreadSigmask", "pthread_sigmask")) return false
    if (!internalFunction("esp32RecoveredEspLibcIncludePthreadImpl", "esp_libc_include_pthread_impl")) return false
    true
}
