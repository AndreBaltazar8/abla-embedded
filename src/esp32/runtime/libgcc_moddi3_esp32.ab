import "../../runtime/freestanding_integer.ab"

// Typed implementation of the compiler's signed 64-bit remainder ABI.  The
// shared restoring divider contains no division or remainder operation, so
// lowering this function cannot fall back to the helper it defines.
trusted fun esp32SignedRemainder64(
    dividend: i64,
    divisor: i64
): i64 = freestandingSignedRemainder(dividend, divisor)

// Transitional low-word adapter for the remaining register-pair callers.
trusted fun esp32RecoveredModdi3(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 = u32(esp32SignedRemainder64(
    i64((u64(a3) << u64(32)) | u64(a2)),
    i64((u64(a5) << u64(32)) | u64(a4))
))
