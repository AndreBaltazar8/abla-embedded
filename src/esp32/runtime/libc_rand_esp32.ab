import "abla/unsafe/memory"

trusted fun esp32RandState(): u32 =
    u32(nativeThreadLocalBytes("\x01\x00\x00\x00\x00\x00\x00\x00"))

trusted fun esp32LibcSrand(seed: u32): void {
    val state = esp32RandState()
    ablaUnsafeStoreU32(nativePointerFromAddress(int(state)), int(seed))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(state + u32(4))), 0)
}

trusted fun esp32LibcRand(): u32 {
    val stateAddress = esp32RandState()
    val low = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(stateAddress))))
    val high = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(stateAddress + u32(4)))))
    val state = u64(low) | (u64(high) << u64(32))
    val next = state * u64(6364136223846793005) + u64(1)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(stateAddress)), int(u32(next)))
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(stateAddress + u32(4))),
        int(u32(next >>> u64(32)))
    )
    u32(next >>> u64(32)) & u32(2147483647)
}

trusted fun esp32RecoveredSrand(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32LibcSrand(a2)
    a2
}

trusted fun esp32RecoveredRand(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32LibcRand()
