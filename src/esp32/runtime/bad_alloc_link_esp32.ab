import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRuntimeBadAllocInternals(): bool {
    if (!internalFunction("esp32RecoveredZNKSt9badAlloc4whatEv", "_ZNKSt9bad_alloc4whatEv")) return false
    if (!internalFunction("esp32RecoveredZNSt9badAllocD1Ev", "_ZNSt9bad_allocD1Ev")) return false
    if (!internalFunction("esp32RecoveredZNSt9badAllocD0Ev", "_ZNSt9bad_allocD0Ev")) return false
    if (!internalFunction("esp32RecoveredZNSt9badAllocD2Ev", "_ZNSt9bad_allocD2Ev")) return false
    true
}
