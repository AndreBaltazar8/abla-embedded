import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "libc_abort_esp32.ab"
import "eh_term_handler_esp32.ab"
import "../shared_storage_esp32.ab"

// Structured Abla implementation of libsupc++ termination handlers.
@inline
trusted fun esp32EhHandlerLoad(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

trusted fun esp32EhExchangeHandler(address:u32, replacement:u32):u32 {
    var expected = esp32EhHandlerLoad(address)
    while (true) {
        val observed = u32(xtensaAtomicCompareExchangeU32(
            int(address),int(expected),int(replacement)))
        if (observed == expected) return expected
        expected = observed
    }
    expected
}

trusted fun esp32CxxTerminateWith(handler:u32):void {
    ablaUnsafeCallI64(int(handler))
    freestandingAbortValue()
    ablaRuntimeTrap()
}

trusted fun esp32SetTerminate(handler:u32):u32 = esp32EhExchangeHandler(
    esp32Data_ZN10_cxxabiv119_terminate_handlerE_c140337aab,
    if (handler != u32(0)) handler else u32(nativeFunctionAddress(esp32RecoveredAbort)))

trusted fun esp32GetTerminate():u32 {
    xtensaMemoryBarrier()
    val handler = esp32EhHandlerLoad(
        esp32Data_ZN10_cxxabiv119_terminate_handlerE_c140337aab)
    xtensaMemoryBarrier()
    handler
}

trusted fun esp32Terminate():void = esp32CxxTerminateWith(esp32GetTerminate())

trusted fun esp32CxxUnexpectedWith(handler:u32):void {
    ablaUnsafeCallI64(int(handler))
    esp32Terminate()
}

trusted fun esp32SetUnexpected(handler:u32):u32 = esp32EhExchangeHandler(
    esp32Data_ZN10_cxxabiv120_unexpected_handlerE_e6c6b23de4,
    if (handler != u32(0)) handler else u32(nativeFunctionAddress(esp32Terminate)))

trusted fun esp32GetUnexpected():u32 {
    xtensaMemoryBarrier()
    val handler = esp32EhHandlerLoad(
        esp32Data_ZN10_cxxabiv120_unexpected_handlerE_e6c6b23de4)
    xtensaMemoryBarrier()
    handler
}

trusted fun esp32Unexpected():void = esp32CxxUnexpectedWith(esp32GetUnexpected())

// Compatibility name kept for the few exception-support files not converted yet.
trusted fun esp32RecoveredZSt9terminatev(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32Terminate(); a2 }
