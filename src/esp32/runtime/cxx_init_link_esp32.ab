import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCxxInitOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredCxxEhArenaSizeGet", "__cxx_eh_arena_size_get")) return false
    if (!internalFunction("esp32RecoveredEspIdfPthreadRwlockLazyAllocation", "__esp_idf_pthread_rwlock_lazy_allocation")) return false
    if (!exportFunction("esp32RecoveredCxxInitDummy", "__cxx_init_dummy")) return false
    true
}
