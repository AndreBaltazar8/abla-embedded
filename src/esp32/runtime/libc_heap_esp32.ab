import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"

// Typed libc allocation facade. Capability selection remains in the ESP heap
// layer, while these ABI entry points are ordinary Abla and LLVM-visible.
trusted fun esp32LibcMalloc(size: u32): u32 =
    esp32HeapCapsMallocDefault(size)

trusted fun esp32LibcReallocate(memory: u32, size: u32): u32 =
    esp32HeapCapsReallocateDefault(memory, size)

trusted fun esp32LibcFree(memory: u32): void {
    esp32HeapCapsFree(memory)
    return
}

trusted fun esp32LibcCfree(memory: u32): void {
    esp32HeapCapsFree(memory)
    return
}

trusted fun esp32LibcFreeValue(memory: u32): u32 {
    esp32LibcFree(memory)
    u32(0)
}

trusted fun esp32LibcCalloc(count: u32, size: u32): u32 {
    val totalWide = u64(count) * u64(size)
    if (totalWide > u64(4294967295)) return u32(0)
    val total = u32(totalWide)
    val memory = esp32HeapCapsMallocDefault(total)
    if (memory != u32(0)) ablaUnsafeSetMemory(
        nativePointerFromAddress(int(memory)), 0, int(total)
    )
    return memory
}

trusted fun esp32LibcMemalign(alignment: u32, size: u32): u32 =
    esp32HeapCapsAlignedAllocateDefault(alignment, size)

trusted fun esp32LibcAlignedAllocate(alignment: u32, size: u32): u32 =
    esp32HeapCapsAlignedAllocateDefault(alignment, size)

trusted fun esp32LibcPosixMemalign(
    output: u32,
    alignment: u32,
    size: u32
): u32 {
    if (size == u32(0)) {
        ablaUnsafeStoreU32(nativePointerFromAddress(int(output)), 0)
        return u32(0)
    }
    val memory = esp32HeapCapsAlignedAllocateDefault(alignment, size)
    if (memory == u32(0)) return u32(12)
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(output)), int(memory)
    )
    return u32(0)
}

trusted fun esp32LibcIncludeHeapImplementation(): void {
    return
}

trusted fun esp32LibcMallocTrim(padding: u32): u32 = u32(0)

trusted fun esp32LibcMallocUsableSize(memory: u32): u32 = u32(0)

trusted fun esp32LibcMallocStats(): void {
    return
}

trusted fun esp32LibcMallopt(parameter: u32, value: u32): u32 = u32(0)

trusted fun esp32LibcPageAllocate(size: u32): u32 = esp32LibcMalloc(size)

trusted fun esp32LibcVirtualAllocate(size: u32): u32 = esp32LibcMalloc(size)

// Xtensa returns this legacy 40-byte aggregate through a hidden destination
// pointer. The ESP implementation reports no dlmalloc arena statistics.
trusted fun esp32LibcMallinfo(output: u32): u32 {
    freestandingSet(output, i32(0), u32(40))
    output
}
