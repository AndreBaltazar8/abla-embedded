import "../../runtime/freestanding_memory.ab"
import "libc_locks_esp32.ab"
import "picolibc_environ_esp32.ab"
import "abla/unsafe/memory"

trusted fun esp32PicolibcFindenv(name: u32, offsetOut: u32): u32 {
    esp32LibcLockTakeHandle(
        esp32Data_lock_libc_recursive_mutex_d7926e1621,
        esp32LibcLockWaitForever,
        esp32LibcLockRecursiveMutex
    )

    val environment = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(esp32Data_environ_3611ac014c))
    ))
    if (environment == u32(0)) {
        esp32LibcLockReleaseHandle(
            esp32Data_lock_libc_recursive_mutex_d7926e1621,
            esp32LibcLockRecursiveMutex
        )
        return u32(0)
    }

    var length = u32(0)
    while (true) {
        val character = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(name + length))
        ))
        if (character == u32(61)) {
            esp32LibcLockReleaseHandle(
                esp32Data_lock_libc_recursive_mutex_d7926e1621,
                esp32LibcLockRecursiveMutex
            )
            return u32(0)
        }
        if (character == u32(0)) break
        length = length + u32(1)
    }

    var index = u32(0)
    while (true) {
        val entry = u32(ablaUnsafeLoadU32(
            nativePointerFromAddress(int(environment + index * u32(4)))
        ))
        if (entry == u32(0)) break
        if (freestandingStringCompareBounded(entry, name, length) == 0 &&
            u32(ablaUnsafeLoadU8(
                nativePointerFromAddress(int(entry + length))
            )) == u32(61)) {
            ablaUnsafeStoreU32(nativePointerFromAddress(int(offsetOut)), int(index))
            esp32LibcLockReleaseHandle(
                esp32Data_lock_libc_recursive_mutex_d7926e1621,
                esp32LibcLockRecursiveMutex
            )
            return entry + length + u32(1)
        }
        index = index + u32(1)
    }

    esp32LibcLockReleaseHandle(
        esp32Data_lock_libc_recursive_mutex_d7926e1621,
        esp32LibcLockRecursiveMutex
    )
    u32(0)
}

trusted fun esp32RecoveredFindenv(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFindenv(a2, a3)
