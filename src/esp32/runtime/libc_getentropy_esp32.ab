import "libc_errno_esp32.ab"
import "libc_getrandom_esp32.ab"

trusted fun esp32Getentropy(buffer: u32, length: u32): u32 {
    if (buffer == u32(0)) {
        esp32LibcSetErrno(u32(14))
        return u32(4294967295)
    }
    if (length > u32(256)) {
        esp32LibcSetErrno(u32(5))
        return u32(4294967295)
    }
    if (esp32Getrandom(buffer, length) == u32(4294967295)) {
        return u32(4294967295)
    }
    return u32(0)
}

trusted fun esp32RecoveredGetentropy(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32Getentropy(a2, a3)

trusted fun esp32RecoveredEspLibcIncludeGetentropyImpl(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = a2
