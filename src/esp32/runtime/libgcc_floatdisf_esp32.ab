import "abla/runtime/self"
import "abla/integer"

trusted fun esp32Unsigned64ToFloatBits(value:u64):u32 {
    if (value == u64(0)) return u32(0)
    val high = u32(value >>> u64(32))
    val leading = if (high != u32(0)) u32(ablaCountLeadingZerosU32(high))
        else u32(32) + u32(ablaCountLeadingZerosU32(u32(value)))
    var exponent = u32(63) - leading
    var significand = u64(0)
    if (exponent <= u32(23)) {
        significand = value << u64(u32(23) - exponent)
    } else {
        val shift = exponent - u32(23)
        significand = value >>> u64(shift)
        val halfway = u64(1) << u64(shift - u32(1))
        val remainder = value & ((u64(1) << u64(shift)) - u64(1))
        if (remainder > halfway ||
            (remainder == halfway && (significand & u64(1)) != u64(0))) {
            significand = significand + u64(1)
            if (significand == (u64(1) << u64(24))) {
                significand = significand >>> u64(1)
                exponent = exponent + u32(1)
            }
        }
    }
    ((exponent + u32(127)) << u32(23)) |
        (u32(significand) & u32(0x007fffff))
}

trusted fun esp32Signed64BitsToFloatBits(value:u64):u32 {
    if ((value & u64(0x8000000000000000)) == u64(0)) {
        return esp32Unsigned64ToFloatBits(value)
    }
    u32(0x80000000) | esp32Unsigned64ToFloatBits(u64(0) - value)
}

trusted fun esp32LibgccFloatundisf(value:u64):u32 =
    esp32Unsigned64ToFloatBits(value)

trusted fun esp32LibgccFloatdisf(value:u64):u32 =
    esp32Signed64BitsToFloatBits(value)

trusted fun esp32RecoveredFloatundisf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32LibgccFloatundisf(u64(a2) | (u64(a3) << u64(32)))

trusted fun esp32RecoveredFloatdisf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32LibgccFloatdisf(u64(a2) | (u64(a3) << u64(32)))
