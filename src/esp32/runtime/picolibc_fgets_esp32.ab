import "picolibc_fgetc_esp32.ab"
import "picolibc_stream_lock_esp32.ab"
import "abla/unsafe/memory"

trusted fun esp32PicolibcFgets(buffer: u32, size: u32, stream: u32): u32 {
    if (i32(size) <= 0) return u32(0)
    val flags = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(stream + u32(2)))))
    if ((flags & u32(1)) == u32(0)) return u32(0)

    val lock = esp32PicolibcStreamLock(stream)
    var cursor = buffer
    var remaining = size - u32(1)
    while (remaining != u32(0)) {
        val character = esp32PicolibcGetcUnlocked(stream)
        if (character == u32(4294967295)) {
            if (cursor == buffer) {
                esp32PicolibcStreamUnlock(lock)
                return u32(0)
            }
            break
        }
        ablaUnsafeStoreU8(nativePointerFromAddress(int(cursor)), int(character))
        cursor = cursor + u32(1)
        remaining = remaining - u32(1)
        if (character == u32(10)) break
    }
    ablaUnsafeStoreU8(nativePointerFromAddress(int(cursor)), 0)
    esp32PicolibcStreamUnlock(lock)
    buffer
}

trusted fun esp32RecoveredFgets(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFgets(a2, a3, a4)
