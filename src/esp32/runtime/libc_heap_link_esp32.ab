import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLibcHeapOpaqueCallers(): bool {
    if (!exportFunction("esp32LibcMalloc", "malloc")) return false
    if (!exportFunction("esp32LibcReallocate", "realloc")) return false
    if (!internalFunction("esp32LibcCfree", "cfree")) return false
    if (!exportFunction("esp32LibcFree", "free")) return false
    if (!exportFunction("esp32LibcCalloc", "calloc")) return false
    if (!internalFunction("esp32LibcMemalign", "memalign")) return false
    if (!internalFunction("esp32LibcAlignedAllocate", "aligned_alloc")) return false
    if (!internalFunction("esp32LibcPosixMemalign", "posix_memalign")) return false
    if (!internalFunction("esp32LibcIncludeHeapImplementation", "esp_libc_include_heap_impl")) return false
    if (!internalFunction("esp32LibcMallocTrim", "malloc_trim")) return false
    if (!internalFunction("esp32LibcMallocUsableSize", "malloc_usable_size")) return false
    if (!internalFunction("esp32LibcMallocStats", "malloc_stats")) return false
    if (!internalFunction("esp32LibcMallopt", "mallopt")) return false
    if (!internalFunction("esp32LibcMallinfo", "mallinfo")) return false
    if (!internalFunction("esp32LibcPageAllocate", "pvalloc")) return false
    if (!internalFunction("esp32LibcVirtualAllocate", "valloc")) return false
    true
}
