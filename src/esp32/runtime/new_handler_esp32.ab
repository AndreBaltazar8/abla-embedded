// The standard nothrow tag still needs an address because lifted C++ callers
// pass its identity, but the handler itself is an ordinary target-neutral
// atomic word.
val esp32Data_ZSt7nothrow_990fd8e438Storage = nativeStaticAllocate(1)
val esp32Data_ZSt7nothrow_990fd8e438 =
    u32(esp32Data_ZSt7nothrow_990fd8e438Storage)

val esp32NewHandlerStorage = nativeStaticAllocate(4)
val esp32NewHandlerAddress = int(esp32NewHandlerStorage)

@inline
trusted fun esp32GetNewHandler(): u32 =
    atomicU32At(esp32NewHandlerAddress).compareExchangeRelaxed(u32(0), u32(0))

trusted fun esp32SetNewHandler(replacement: u32): u32 {
    val handler = atomicU32At(esp32NewHandlerAddress)
    var observed = handler.compareExchangeRelaxed(u32(0), u32(0))
    while (true) {
        val nextObserved = handler.compareExchange(observed, replacement)
        if (nextObserved == observed) return observed
        observed = nextObserved
    }
    u32(0)
}

