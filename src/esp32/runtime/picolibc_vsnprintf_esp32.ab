import "../../runtime/freestanding_memory.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "picolibc_filestrput_esp32.ab"

@inline
trusted fun esp32VsnprintfStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32PicolibcVsnprintf(
    buffer:u32,size:u32,format:u32,va0:u32,va1:u32,va2:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
):u32 {
    val frame = u32(nativeStackAllocate(96))
    freestandingSet(frame, i32(0), u32(36))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(frame + u32(2))), int(u32(2)))
    esp32VsnprintfStoreU32(frame + u32(4), u32(nativeFunctionAddress(esp32RecoveredFileStrPut)))
    esp32VsnprintfStoreU32(frame + u32(16), u32(1))
    esp32VsnprintfStoreU32(frame + u32(20), buffer)
    esp32VsnprintfStoreU32(frame + u32(48), va0)
    esp32VsnprintfStoreU32(frame + u32(52), va1)
    esp32VsnprintfStoreU32(frame + u32(56), va2)

    var bufferEnd = buffer
    if (i32(size) < 0) bufferEnd = u32(0)
    else if (size != u32(0)) bufferEnd = buffer + size - u32(1)
    esp32VsnprintfStoreU32(frame + u32(24), bufferEnd)

    val result = esp32RecoveredVfprintf(frame, format, va0, va1, va2, u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (size != u32(0)) {
        val cursor = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(frame + u32(20)))))
        ablaUnsafeStoreU8(nativePointerFromAddress(int(cursor)), int(u32(0)))
    }
    result
}

trusted fun esp32RecoveredVsnprintf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PicolibcVsnprintf(a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
