import "picolibc_stream_lock_esp32.ab"
import "picolibc_stream_pushback_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32PicolibcGetcUnlocked(stream: u32): u32 {
    val flagsAddress = stream + u32(2)
    var flags = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(flagsAddress))))
    if ((flags & u32(1)) == u32(0)) {
        ablaUnsafeStoreU8(nativePointerFromAddress(int(flagsAddress)), int(flags | u32(4)))
        return u32(4294967295)
    }

    val pushback = esp32PicolibcTakePushback(stream)
    if (pushback != u32(0)) return (pushback - u32(1)) & u32(255)

    val getFunction = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(stream + u32(8)))
    ))
    val result = i32(ablaUnsafeCallI32I32I32I32I32I32I32(
        int(getFunction), int(stream), 0, 0, 0, 0, 0
    ))
    if (result >= 0) return u32(result) & u32(255)

    flags = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(flagsAddress))))
    val failureFlag = if (u32(result) == u32(4294967295)) u32(4) else u32(8)
    ablaUnsafeStoreU8(nativePointerFromAddress(int(flagsAddress)), int(flags | failureFlag))
    u32(4294967295)
}

trusted fun esp32PicolibcFgetc(stream: u32): u32 {
    val lock = esp32PicolibcStreamLock(stream)
    val result = esp32PicolibcGetcUnlocked(stream)
    esp32PicolibcStreamUnlock(lock)
    result
}

trusted fun esp32PicolibcGetc(stream: u32): u32 = esp32PicolibcFgetc(stream)

trusted fun esp32RecoveredFgetc(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcFgetc(a2)

trusted fun esp32RecoveredGetc(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcGetc(a2)

trusted fun esp32RecoveredGetcUnlocked(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PicolibcGetcUnlocked(a2)
