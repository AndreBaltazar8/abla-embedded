import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "./ahb_gdma_clock_c5_sequence.ab"
trusted fun c5AhbGdmaBusRead(): u32 = u32(mmioLoadU32(0x600960c0))
trusted fun c5AhbGdmaBusWrite(value: u32): void { mmioStoreU32(0x600960c0,int(value));return }
trusted fun c5AhbGdmaRead(offset: int): u32 = u32(mmioLoadU32(0x60080000+offset))
trusted fun c5AhbGdmaWrite(offset: int,value: u32): void { mmioStoreU32(0x60080000+offset,int(value));return }
