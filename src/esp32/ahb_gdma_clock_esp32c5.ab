import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "./ahb_gdma_clock_c5_sequence.ab"
import "../hal/esp32.ab"
@export("c5AhbGdmaBusRead")
trusted fun c5AhbGdmaBusReadHook(): u32 = u32(mmioLoadU32(0x600960c0))
@export("c5AhbGdmaBusWrite")
trusted fun c5AhbGdmaBusWriteHook(value: u32): void { mmioStoreU32(0x600960c0,int(value));return }
@export("c5AhbGdmaRead")
trusted fun c5AhbGdmaReadHook(offset: int): u32 = u32(mmioLoadU32(0x60080000+offset))
@export("c5AhbGdmaWrite")
trusted fun c5AhbGdmaWriteHook(offset: int,value: u32): void { mmioStoreU32(0x60080000+offset,int(value));return }
