import "./gpio_c61_sequence.ab"
// Return an owned RTC pad0..6 to digital INPUT. Caller has disabled wake
// routing, stopped LP users, released global/sleep holds and owns both clock
// domains for the entire operation. Never clears a hold or gates shared clocks.
// Park digital output BEFORE changing the RTC mux to prevent stale matrix/OE
// configuration driving an externally driven IRQ pin at the handoff.
// Status1ready2invalid3unowned/held4clock5digitalpark6LPcleanup7mux8digitalconfig.
// Failure retains pad ownership; retry the whole idempotent operation.
trusted fun esp32C61RtcPadInputOwned(pin: int,pull: int,exclusiveWakeDisarmed: bool): int {
    if (pin < 0 || pin > 6 || pull < 0 || pull > 2) return 2
    val bit=u32(1)<<u32(pin)
    if (!exclusiveWakeDisarmed || (c61GpioRead(0x600b102c)&bit) != u32(0)) return 3
    if ((c61GpioRead(0x600b2800)&u32(1<<27)) == u32(0) ||
        (c61GpioRead(0x600960c0)&u32(3)) != u32(1) ||
        (c61GpioRead(0x600960c4)&u32(0x400000)) == u32(0) ||
        ((c61GpioRead(0x600960c4)>>u32(20))&u32(3)) == u32(3) ||
        (c61GpioRead(0x60091df8)&u32(1)) == u32(0)) return 4
    c61GpioWrite(0x6009103c,bit)
    if ((c61GpioRead(0x60091034)&bit) != u32(0) ||
        !c61GpioField(0x60091ad4+pin*4,u32(3072),u32(1024))) return 5
    c61GpioWrite(0x600b4418,bit)
    if ((c61GpioRead(0x600b4410)&bit) != u32(0) ||
        !c61GpioField(0x600b4000+pin*4,u32(896),u32(0))) return 6
    if (!c61GpioField(0x600b1028,bit,u32(0))) return 7
    if (esp32C61GpioConfigureOwned(pin,false,true,false,true,pull,true) != 1) return 8
    return 1
}
