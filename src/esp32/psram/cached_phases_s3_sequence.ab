import "./cs_s3_sequence.ab"
import "../sdk/raw_buffer.ab"
// IDF6 esp_psram_impl_octal.c:s_config_psram_spi_phases, without its
// unconditional Cache_Resume_DCache(0). Preserve caller's cache ownership.
// SPI0 cached OPI-DTR: write8080/read0000 commands16bits,address32bits,
// read dummy18/write dummy8 (registers encode17/7), variable dummy/no swap.
// Assumes chip MR0 matching these latencies, valid pads/clocks/timing and
// cold nonECC policy. Does not install MMU entries or prove calibrated RAM.
// Entries are register offsets/masks/values, in the upstream write order.
val s3PsramCachedSteps=nativeStaticU32s([
    64,1048576,1048576,
    76,4026531840,4026531840,
    76,65535,32896,
    64,32,32,
    72,4026531840,4026531840,
    72,65535,0,
    64,1032192,507904,
    64,1,1,
    64,24,24,
    64,4032,1088,
    228,2,2,
    64,264241152,29360128,
    228,12,0,
    228,1,1,
    68,8126464,8126464,
    64,2097152,2097152
])
// 1configured,2missing proof,3busy,4readback failure/partial configuration.
// Internal-only code/stack/table; exclude cache/MSPI/peer/IRQ/DMA throughout.
@section(".iram1.abla.s3PsramCachedPhases")
trusted fun s3PsramCachedPhasesOwned(exclusiveInternal: bool): int {
    if (!exclusiveInternal) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    var step=0
    while (step < 16) {
        val offset=step*12
        val address=0x60003000+nativeAddressLoadU32(s3PsramCachedSteps,offset)
        val mask=nativeAddressLoadU32(s3PsramCachedSteps,offset+4)
        val bits=nativeAddressLoadU32(s3PsramCachedSteps,offset+8)
        val expected=(s3PsramCsRead(address)&(0xffffffff^mask))|bits
        s3PsramCsWrite(address,expected)
        if (s3PsramCsRead(address) != expected) return 4
        step=step+1
    }
    return 1
}
