import "./verify_p4_sequence.ab"
import "./clock_esp32p4.ab"
import "./command_esp32p4.ab"
import "../cache_writeback_esp32p4.ab"
import "../cache_geometry_esp32p4.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun p4PsramVerifyAsm(template: string,constraints: string): void
trusted fun p4PsramVerifyFence(): void = p4PsramVerifyAsm("fence iorw, iorw","~{memory}")
trusted fun p4PsramVerifyReady(line: int): bool = p4CacheL2GeometryMatches(line) && (p4PsramClockRead(192)&0x02800000) == 0 && (p4PsramClockRead(20)&0x80000000) != 0 &&
    (p4PsramClockRead(48)&0xc000) == 0xc000 && (p4PsramMappedRead(60)&0x80000001) == 1 && (p4PsramMappedRead(4096)&0x400f0) == 0
trusted fun p4PsramVerifyRead(address: int): int = mmioLoadU32(address)
trusted fun p4PsramVerifyWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
trusted fun p4PsramVerifyFlush(buffer: NativeBuffer,bytes: int,line: int,polls: int): int = esp32P4CacheWritebackInvalidateOwned(buffer,bytes,line,polls)
