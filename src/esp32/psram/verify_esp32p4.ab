import "./verify_p4_sequence.ab"
import "./clock_esp32p4.ab"
import "./command_esp32p4.ab"
import "../cache_writeback_esp32p4.ab"
import "../cache_geometry_esp32p4.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
import "../../hal/esp32.ab"
import "../../hal/esp32_psram_2.ab"
import "../sdk/raw_buffer.ab"
import "../cache_writeback_p4_sequence.ab"
import "../sdk/nativebuffer_type.ab"
trusted noescape extern:"inline-assembly" fun p4PsramVerifyAsm(template: string,constraints: string): void
@export("p4PsramVerifyFence")
trusted fun p4PsramVerifyFenceHook(): void = p4PsramVerifyAsm("fence iorw, iorw","~{memory}")
@export("p4PsramVerifyReady")
trusted fun p4PsramVerifyReadyHook(line: int): bool = p4CacheL2GeometryMatches(line) && (p4PsramClockRead(192)&0x02800000) == 0 && (p4PsramClockRead(20)&0x80000000) != 0 &&
    (p4PsramClockRead(48)&0xc000) == 0xc000 && (p4PsramMappedRead(60)&0x80000001) == 1 && (p4PsramMappedRead(4096)&0x400f0) == 0
@export("p4PsramVerifyRead")
trusted fun p4PsramVerifyReadHook(address: int): int = mmioLoadU32(address)
@export("p4PsramVerifyWrite")
trusted fun p4PsramVerifyWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
@export("p4PsramVerifyFlush")
trusted fun p4PsramVerifyFlushHook(buffer: NativeBuffer,bytes: int,line: int,polls: int): int = esp32P4CacheWritebackInvalidateOwned(buffer,bytes,line,polls)
