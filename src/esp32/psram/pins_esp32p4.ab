import "./pins_p4_sequence.ab"
import "./clock_esp32p4.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
@export("p4PsramPinRead")
trusted fun p4PsramPinReadHook(offset: int): int = mmioLoadU32(0x500e1200+offset)
@export("p4PsramPinWrite")
trusted fun p4PsramPinWriteHook(offset: int,value: int): void { mmioStoreU32(0x500e1200+offset,value); return }
