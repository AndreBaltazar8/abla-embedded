import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Checked pin-map entry to the configured boot coordinator. Expected map
// stays immutable/internal/disjoint from the whole boot owner across retries.
// Return2invalid/proof;0x10000|mask pin mismatch (no boot mutation); otherwise
// unchanged boot status. All other electrical/linker/clock/exclusion proofs
// remain necessary: eFuse agreement alone never authorizes using live pins.
@section(".iram1.abla.s3PsramBoot80Pins")
trusted fun s3PsramBoot80PinsOwned(expected: NativeBuffer,r: NativeBuffer,virtual: int,bytes: int,capacity: int,flashMHz: int,flashProfile: int,flashTiming: int,base: int,repetitions: int,cacheKiB: int,lineBytes: int,bootPrerequisites: bool): int {
    if (!bootPrerequisites || bytes < 65536 || bytes > 33554432 || (bytes&65535) != 0 || !expected.hasAddressRange(0,12) ||
        !s3PsramCommandStorageSafe(expected.addressValue(),12)) return 2
    val total=672+(bytes>>>16)*4
    if (!r.hasAddressRange(0,total) || !s3PsramCommandStorageSafe(r.addressValue(),total) ||
        (r.addressValue() < expected.addressValue()+12 && expected.addressValue() < r.addressValue()+total)) return 2
    val mismatch=s3MspiPinMismatchMask(expected)
    if (mismatch < 0) return 2
    if (mismatch != 0) return 65536|mismatch
    return s3PsramBoot80ConfiguredOwned(r,virtual,bytes,capacity,flashMHz,flashProfile,flashTiming,base,repetitions,cacheKiB,lineBytes,true)
}
