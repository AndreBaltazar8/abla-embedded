import "./cs_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
@export("s3PsramCsRead")
trusted fun s3PsramCsReadHook(address: int): int = mmioLoadU32(address)
@export("s3PsramCsWrite")
trusted fun s3PsramCsWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
