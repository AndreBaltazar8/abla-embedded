import "./cache_geometry_s3_sequence.ab"
import "./cache_geometry_native_s3_sequence.ab"
import "./cache_mapping_esp32s3.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
trusted fun s3PsramCacheGeometryRead(address: int): int = mmioLoadU32(address)
trusted fun s3PsramCacheGeometryWrite(address: int,value: int): void = mmioStoreU32(address,value)
trusted fun s3PsramCacheGeometryOccupy(low: int,high: int): void = s3PsramCacheGeometryOccupyNativeOwned(low,high)
trusted fun s3PsramCacheGeometryMode(size: int,ways: int,line: int): void = s3PsramCacheGeometryModeNativeOwned(size,ways,line)
trusted fun s3PsramCacheGeometryInvalidate(): void = s3PsramCacheInvalidateNativeOwned(false)
