import "./cache_geometry_s3_sequence.ab"
import "./cache_geometry_native_s3_sequence.ab"
import "./cache_mapping_esp32s3.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../../hal/esp32_psram.ab"
import "./cache_disable_s3_sequence.ab"
@export("s3PsramCacheGeometryRead")
trusted fun s3PsramCacheGeometryReadHook(address: int): int = mmioLoadU32(address)
@export("s3PsramCacheGeometryWrite")
trusted fun s3PsramCacheGeometryWriteHook(address: int,value: int): void = mmioStoreU32(address,value)
@export("s3PsramCacheGeometryOccupy")
trusted fun s3PsramCacheGeometryOccupyHook(low: int,high: int): void = s3PsramCacheGeometryOccupyNativeOwned(low,high)
@export("s3PsramCacheGeometryMode")
trusted fun s3PsramCacheGeometryModeHook(size: int,ways: int,line: int): void = s3PsramCacheGeometryModeNativeOwned(size,ways,line)
@export("s3PsramCacheGeometryInvalidate")
trusted fun s3PsramCacheGeometryInvalidateHook(): void = s3PsramCacheInvalidateNativeOwned(false)
