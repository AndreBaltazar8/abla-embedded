import "./cs_s3_sequence.ab"
// S3 octal PSRAM CS1 is fixed GPIO26, IO_MUX function0. Mirrors IDF6
// s_init_psram_pins; data/clock pad mux and efuse wiring are boot prerequisites.
// Caller reserves GPIO26 for the entire memory lifetime (no implicit allocator
// registration), releases holds/RTC users, and owns all MSPI/cache exclusion.
// Setting the PSRAM clock-drive field does NOT enable the shared pad-drive
// selector (DATE bit4): preserve it and the FLASH drive bits2..3 exactly.
// 1fields configured,2proof missing,3busy,4readback failure/partial configuration.
@section(".iram1.abla.s3PsramPins")
trusted fun s3PsramPinsOwned(exclusiveInternal: bool): int {
    if (!exclusiveInternal) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    var step=0
    while (step < 3) {
        val address=if (step < 2) 0x6000906c else 0x600033fc
        val mask=if (step == 0) 0x7000 else if (step == 1) 0xc00 else 3
        val bits=if (step == 0) 0 else mask
        val expected=(s3PsramCsRead(address)&(0xffffffff^mask))|bits
        s3PsramCsWrite(address,expected)
        if (s3PsramCsRead(address) != expected) return 4
        step=step+1
    }
    return 1
}
// Convenience startup step, still requires clocks/remaining octal pads.
// Default non-ECC profile; ECC timing is not ECC region/mode initialization.
@section(".iram1.abla.s3PsramPinsCs")
trusted fun s3PsramPinsAndCsOwned(exclusiveInternal: bool): int {
    val result=s3PsramPinsOwned(exclusiveInternal)
    if (result != 1) return result
    return s3PsramCsTimingOwned(3,3,2,-1,true)
}
