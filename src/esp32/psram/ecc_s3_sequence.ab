import "./cs_s3_sequence.ab"
// Establish non-ECC operation for the entire caller-owned PSRAM address space.
// IDF default boot clears ACE0 bit8; also clear it in ACE1..3 so a reused
// controller cannot retain an enabled ECC subregion. Permission bits0..7,
// slot addresses/sizes and global page/ECC format configuration are untouched.
// This is DESTRUCTIVE to the interpretation of existing ECC-encoded contents:
// cold/uninitialized memory only, no live data. Caller excludes every memory,
// cache, peer, IRQ and DMA user and runs entirely internally.
// 1disabled/readback verified,2missing proof,3busy,4partial write failure.
@section(".iram1.abla.s3PsramNonEcc")
trusted fun s3PsramNonEccOwned(coldMemory: bool,exclusiveInternal: bool): int {
    if (!coldMemory || !exclusiveInternal) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    var slot=0
    while (slot < 4) {
        val address=0x60026058+slot*4
        val expected=s3PsramCsRead(address)&0xfffffeff
        s3PsramCsWrite(address,expected)
        if (s3PsramCsRead(address) != expected) return 4
        slot=slot+1
    }
    return 1
}
