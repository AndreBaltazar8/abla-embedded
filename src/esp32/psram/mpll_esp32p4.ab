import "./mpll_p4_sequence.ab"
import "../analog/register_esp32p4.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
@export("p4MpllRead")
trusted fun p4MpllReadHook(address: int): int = mmioLoadU32(address)
@export("p4MpllWrite")
trusted fun p4MpllWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
