import "./mode_s3_sequence.ab"
// Destructive four-byte probe at a caller-reserved, aligned PSRAM address.
// Matches IDF6 s_check_psram_connected: write0x5a6b7c8d, write dummy8,
// read dummy18. Does not allocate or silently overwrite address0.
// Prerequisites: octal mode/MR0 latency configured, clocks/pads/DQS/variable
// dummy and no-swap prepared, all cache/MSPI users excluded, internal code/
// stack/scratch/work, watchdog recovery for the ROM's unbounded command wait.
// 1pattern verified,2invalid/proof,3/4command failure,5data mismatch.
// Scratch0..3 retains the transmitted pattern;4..7 the returned value.
// Once write starts the reserved PSRAM word may change even on failure.
@section(".iram1.abla.s3PsramProbe")
trusted fun s3PsramProbeOwned(address: int,reservedBytes: int,scratch: NativeBuffer,work: NativeBuffer,exclusiveInternal: bool): int {
    if (!exclusiveInternal || address < 0 || address > 4294967292 || (address&3) != 0 ||
        reservedBytes < 4 || reservedBytes > 4294967296-address || !s3PsramModeBuffers(scratch,work)) return 2
    val tx=nativeBufferAt(scratch.addressValue(),4)
    val rx=nativeBufferAt(scratch.addressValue()+4,4)
    tx.storeU32(0,0x5a6b7c8d);rx.storeU32(0,0)
    var result=s3PsramCommandOwned(0x8080,address,8,tx,4,work)
    if (result != 1) return result
    result=s3PsramCommandOwned(0,address,18,rx,4,work)
    if (result != 1) return result
    return if (rx.loadU32(0) == 0x5a6b7c8d) 1 else 5
}
