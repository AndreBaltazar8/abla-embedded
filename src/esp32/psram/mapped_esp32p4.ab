import "./mapped_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
// DR_REG_PSRAM_MSPI0_BASE5008e000, SPIMEM2, same fields on hw_ver1/3.
@export("p4PsramMappedRead")
trusted fun p4PsramMappedReadHook(offset: int): int = mmioLoadU32(0x5008e000+offset)
@export("p4PsramMappedWrite")
trusted fun p4PsramMappedWriteHook(offset: int,value: int): void { mmioStoreU32(0x5008e000+offset,value); return }
