import "./mapped_p4_sequence.ab"
import "abla/unsafe/mmio"
// DR_REG_PSRAM_MSPI0_BASE5008e000, SPIMEM2, same fields on hw_ver1/3.
trusted fun p4PsramMappedRead(offset: int): int = mmioLoadU32(0x5008e000+offset)
trusted fun p4PsramMappedWrite(offset: int,value: int): void { mmioStoreU32(0x5008e000+offset,value); return }
