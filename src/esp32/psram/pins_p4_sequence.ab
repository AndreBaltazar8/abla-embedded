import "./clock_p4_sequence.ab"
// Dedicated MSPI PSRAM pads, not GPIO matrix and never flash pads. Both P4
// register layouts use20 contiguous PIN0 words at1c..68, drive bits13:12.
// Caller owns pad/controller/RCC lifetime, internal execution and all peers;
// clocks must be on, reset clear, AXI closed and both ports quiescent.
// No pad holds, delay lines or calibration modified. DQS power on LAST.
// Status low8:1configured2invalid3AXI4busy5readback6clock/reset;
// high8 failed write stage1..20 drive,21/22 DQS0/1. Partial pads remain owned.
trusted fun p4PsramPinField(offset: int,mask: int,value: int): bool {
    p4PsramPinWrite(offset,(p4PsramPinRead(offset)&(4294967295^mask))|value)
    return (p4PsramPinRead(offset)&mask) == value
}
trusted fun p4PsramPinsConfigureOwned(drive: int,dqs: bool,polls: int): int {
    if (drive < 0 || drive > 3 || polls < 1 || polls > 1000000) return 2
    if ((p4PsramClockRead(192)&0x02800000) != 0 || (p4PsramClockRead(20)&0x80000000) == 0 ||
        (p4PsramClockRead(48)&0xc000) != 0xc000) return 6
    if ((p4PsramMappedRead(60)&1) != 0) return 3
    if ((p4PsramMappedRead(4096)&0x400f0) != 0 || !p4PsramMappedWaitIdle(polls)) return 4
    var pin=0
    while (pin < 20) {
        if (!p4PsramPinField(28+pin*4,0x3000,drive<<12)) return ((pin+1)<<8)|5
        pin=pin+1
    }
    if (!p4PsramPinField(60,1,if (dqs) 1 else 0)) return (21<<8)|5
    if (!p4PsramPinField(104,1,if (dqs) 1 else 0)) return (22<<8)|5
    return 1
}
