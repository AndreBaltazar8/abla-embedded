import "./timing_tables_s3.ab"
import "./timing_window_s3.ab"
// Owned160MHz core/80MHz OPI-DTR command calibration, not cached RAM enable.
// Caller enters with verified low-speed profile/MR0 and reserved64B physical
// span; proves stable480PLL and global internal/cache/peer/IRQ/DMA exclusion.
// 340B aligned internal owner: header64,table56@64,results56@120,scratch64@176,
// work100@240. Zero magic before first use. Own immutable args for lifetime.
// Header magic,phase,address,capacity,repetitions,octal,base,original0,original1,
// lastError,selection,selectedCandidate; remaining16B reserved.
// Phases1seed,2lowverify,3clock,4sweep,5select,6apply,7verify,8ready,9no-window.
// Retry resumes phase, never reseeds RAM after raising clocks. Sweep retries
// start a fresh sweep; existing partial results remain visible until retry.
// 1selected command profile verified;2invalid;3/4busy/readback;5no safe window
// or read mismatch. No fallback forced success, flash restore or cache resume.
// All failures retain owner/exclusion. Terminal9 requires caller recovery;
// never zero the owner and reseed without restoring low-speed configuration.
@section(".iram1.abla.s3PsramCalibrate80")
trusted fun s3PsramCalibrate80Owned(r: NativeBuffer,address: int,capacity: int,repetitions: int,octalFlash: bool,base: int,original0: int,original1: int,stable480Pll: bool,exclusiveInternal: bool): int {
    if (!stable480Pll || !exclusiveInternal || !r.hasAddressRange(0,340) || (r.addressValue()&3) != 0 ||
        !s3PsramCommandStorageSafe(r.addressValue(),340) || address < 0 || (address&3) != 0 || capacity < 64 || capacity > 1073741824 || address > capacity-64 ||
        repetitions < 1 || repetitions > 1024 || base < 0 || base > 63 || original0 < 0 || original0 > 255 || original1 < 0 || original1 > 255 ||
        (!octalFlash && (base+original0+4 > 63 || base+original1+4 > 63))) return 2
    val root=r.addressValue();val octal=if (octalFlash) 1 else 0
    if (!octalFlash) {
        val legacy=s3FlashLegacyPointer()
        if (!s3FlashLegacyPointerValid(legacy) || (root < legacy+28 && legacy < root+340)) return 2
    }
    val table=nativeBufferAt(root+64,56);val results=nativeBufferAt(root+120,56)
    val scratch=nativeBufferAt(root+176,64);val work=nativeBufferAt(root+240,100)
    if (r.loadU32(0) == 0) {
        if (s3PsramTimingTableCopy(1,table) != (14|(5<<8))) return 2
        r.storeU32(0,0x53334338);r.storeU32(4,1);r.storeU32(8,address);r.storeU32(12,capacity)
        r.storeU32(16,repetitions);r.storeU32(20,octal);r.storeU32(24,base);r.storeU32(28,original0);r.storeU32(32,original1)
        var offset=36
        while (offset < 64) { r.storeU32(offset,0);offset=offset+4 }
        offset=0
        while (offset < 56) { results.storeU32(offset,4294967295);offset=offset+4 }
    } else if (r.loadU32(0) != 0x53334338 || r.loadU32(4) < 1 || r.loadU32(4) > 9 ||
        r.loadU32(8) != address || r.loadU32(12) != capacity || r.loadU32(16) != repetitions || r.loadU32(20) != octal ||
        r.loadU32(24) != base || r.loadU32(28) != original0 || r.loadU32(32) != original1) return 2
    while (r.loadU32(4) < 8) {
        val phase=r.loadU32(4)
        var status=1
        if (phase == 1) {
            status=s3PsramTimingSampleOwned(0,address,capacity,scratch,work,true)
            if (status == 6) status=1
            else if (status == 1) status=2
        } else if (phase == 2 || phase == 7) status=s3PsramTimingSampleOwned(1,address,capacity,scratch,work,true)
        else if (phase == 3) status=s3PsramTimingClockOwned(160,80,true,true)
        else if (phase == 4) status=s3PsramTimingSweepOwned(table,results,14,repetitions,address,capacity,scratch,work,octalFlash,base,original0,original1,true)
        else if (phase == 5) {
            val selection=s3PsramTimingWindow(results,14,repetitions,5,160,true)
            r.storeU32(40,selection)
            if (selection < 0) status=2
            else if ((selection&255) != 1) { r.storeU32(4,9);r.storeU32(36,5);return 5 }
            else r.storeU32(44,table.loadU32(((selection>>>8)&255)*4))
        } else if (phase == 6) {
            val candidate=r.loadU32(44)
            status=s3PsramTimingCandidateOwned(candidate&7,(candidate>>>3)&3,(candidate>>>5)&7,octalFlash,base,original0,original1,true)
        }
        if (status != 1) { r.storeU32(36,status);return status }
        r.storeU32(36,0);r.storeU32(4,phase+1)
    }
    return if (r.loadU32(4) == 8) 1 else 5
}
