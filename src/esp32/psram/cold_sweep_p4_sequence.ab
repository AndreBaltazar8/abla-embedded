import "./cold_p4_sequence.ab"
// Report32B: full result0/4, four pass masks8..23, physical offset24, commit
// magic28. Zero magic means unfinished. Caller retains report and cold owner;
// no concurrent readers/publication guarantee without caller synchronization.
// No external-memory-ready promotion: success remains phase8 (configured).
// Any sweep failure marks phase10, blocking further probe/sweep until cleanup.
// A failed restore can leave fast command clocks; never discard its high word.
trusted fun p4PsramColdReadSweepOwned(record: NativeBuffer,byteOffset: int,scratch: NativeBuffer,work: NativeBuffer,report: NativeBuffer,polls: int): int {
    if (!p4PsramColdStorage(record) || !report.hasAddressRange(0,32) || (report.addressValue()&3) != 0 ||
        !p4PsramCommandStorageSafe(report.addressValue(),32) || !scratch.hasAddressRange(0,64) || !work.hasAddressRange(0,100) ||
        (work.addressValue()&3) != 0 || !p4PsramCommandStorageSafe(scratch.addressValue(),64) || !p4PsramCommandStorageSafe(work.addressValue(),100) || polls < 1 || polls > 1000000) return 2
    val r=record.addressValue(); val s=scratch.addressValue(); val w=work.addressValue(); val t=report.addressValue()
    if (!p4PsramColdDisjoint(r,48,s,64) || !p4PsramColdDisjoint(r,48,w,100) || !p4PsramColdDisjoint(r,48,t,32) ||
        !p4PsramColdDisjoint(s,64,w,100) || !p4PsramColdDisjoint(s,64,t,32) || !p4PsramColdDisjoint(w,100,t,32)) return 2
    if (record.loadU32(0) != 0x50345053 || record.loadU32(4) != 8 || !P4MpllOwner(record.loadU32(8)).ready() || !P4PsramClockOwner(record.loadU32(12)).ready()) return 3
    val mhz=record.loadU32(32)
    val identity=P4PsramIdentity(record.loadU32(24)|(record.loadU32(28)<<32))
    val hex16=(identity.mode(8)&64) != 0
    if (!identity.matchesProfile(mhz,hex16)) return 3
    if (byteOffset < 0 || (byteOffset&127) != 0 || byteOffset > identity.physicalBytes()-128) return 2
    var offset=0
    while (offset < 32) { report.storeU32(offset,0); offset=offset+4 }
    report.storeU32(24,byteOffset)
    // Mark non-reentrant before the first hardware operation. The same phase
    // remains after failure and is accepted only by the close path.
    record.storeU32(4,10)
    val result=p4PsramReadSweepOwned(mhz,hex16,identity.physicalBytes(),byteOffset,scratch,work,nativeBufferAt(t+8,16),polls)
    report.storeU32(0,result); report.storeU32(4,result>>>32)
    report.storeU32(28,0x50345452)
    if ((result&255) != 1 || (result&(1<<32)) != 0) return p4PsramColdFailure(record,14,result)
    record.storeU32(4,8); record.storeU32(36,0); record.storeU32(40,0)
    return 1
}
