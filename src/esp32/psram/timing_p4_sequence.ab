import "./mapped_p4_sequence.ab"
// Both PSRAM ports share ownership. Same internal execution, peer/cache/DMA
// exclusion and writeback prerequisites as mapped configuration. Caller has
// already enabled stable source/module clocks and released reset. This does
// NOT acquire/change PLLs, configure pins, train DLLs or prove memory works.
// Dividers refer to the already selected controller source, not CPU frequency.
// CS lengths count controller cycles; caller checks chip nanosecond minima.
// Low8 status:1configured2invalid3AXI active4busy5readback. High8 failure stage.
// On any partial failure retain ownership; never enable AXI or silently reset.
fun p4PsramBusClockValue(divider: int): int =
    if (divider < 1 || divider > 256) -1 else if (divider == 1) 0x80000000 else
    ((divider-1)<<16)|(((divider/2)-1)<<8)|(divider-1)
trusted fun p4PsramTimingConfigureOwned(mappedDivider: int,commandDivider: int,setup: int,hold: int,holdDelay: int,pageBytes: int,dll: bool,polls: int): int {
    val mappedClock=p4PsramBusClockValue(mappedDivider)
    val commandClock=p4PsramBusClockValue(commandDivider)
    val page=if (pageBytes == 256) 0 else if (pageBytes == 512) 1 else if (pageBytes == 1024) 2 else if (pageBytes == 2048) 3 else -1
    if (mappedClock < 0 || commandClock < 0 || setup < 1 || setup > 32 || hold < 1 || hold > 32 ||
        holdDelay < 1 || holdDelay > 64 || page < 0 || polls < 1 || polls > 1000000) return 2
    if ((p4PsramMappedRead(60)&1) != 0) return 3
    // MSPI3 command state resides in the NEXT 4KB bank, but both DLL controls
    // reside in SPIMEM2. Do not confuse these with flash SPIMEM0/1 registers.
    if ((p4PsramMappedRead(4096)&0x400f0) != 0 || !p4PsramMappedWaitIdle(polls)) return 4
    val ac=3|((setup-1)<<2)|((hold-1)<<7)|((holdDelay-1)<<25)|0x80000000
    if (!p4PsramMappedField(416,0xfe000fff,ac)) return 261
    if (!p4PsramMappedField(372,0x000c0000,page<<18)) return 517
    if (!p4PsramMappedField(80,0x80ffffff,mappedClock)) return 773
    if (!p4PsramMappedField(4116,0x80ffffff,commandClock)) return 1029
    if (!p4PsramMappedField(400,32,if (dll) 32 else 0)) return 1285
    if (!p4PsramMappedField(384,32,if (dll) 32 else 0)) return 1541
    return 1
}
