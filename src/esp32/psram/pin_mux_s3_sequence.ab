import "./pin_config_s3.ab"
// Default MSPI IO_MUX routes from IDF6 esp32s3/soc/io_mux_reg.h:
// GPIO26..32 function0, GPIO33..37 function4 (NOT function0).
// Custom eFuse maps can require GPIO-matrix routing and are not interpreted
// by this default-route check. No writes, no ownership or electrical proof.
// CS1 is deliberately excluded: cold PSRAM initialization owns/configures it.
// Return -1 for a non-default configured map; otherwise an 11-bit mismatch
// mask in pin_config role order. Zero proves only the selected mux functions.
// Caller keeps pin configuration stable throughout this read-only snapshot.
@section(".iram1.abla.s3MspiBootMux")
fun s3MspiDefaultBootMuxMismatch(): int {
    return s3MspiDefaultBootFieldsMismatch(false)
}
// Stronger boot admission: IO_MUX FUN_IE(bit9) must also be enabled on
// D0..D7 and DQS. CLK/CS0 are output-only here; CS1 remains cold-init owned.
// Also require MSPI input signals to bypass GPIO matrix (SIG_IN_SEL bit7=0),
// as gpio_hal_iomux_in does. Inversion/pin selection bits belong to the
// bypassed matrix and are left untouched. Strong admission also rejects
// per-pad hold requests (including CS1) and global forced hold/isolation or
// latched auto-hold. Conservative: reject requested holds even if an override
// might suppress them. Returns12bit mask; power/voltage remain caller proofs.
@section(".iram1.abla.s3MspiBootPads")
fun s3MspiDefaultBootPadMismatch(): int = s3MspiDefaultBootFieldsMismatch(true)
@section(".iram1.abla.s3MspiBootFields")
fun s3MspiDefaultBootFieldsMismatch(inputs: bool): int {
    var role=0
    while (role < 12) {
        if (s3MspiReadConfiguredPin(role) != s3MspiDefaultPin(role)) return -1
        role=role+1
    }
    var mismatch=0;role=0
    while (role < 11) {
        val pin=s3MspiDefaultPin(role)
        val function=if (pin >= 33) 4 else 0
        val fields=s3MspiMuxRead(0x60009004+4*pin)
        if (((fields>>>12)&7) != function || (inputs && role != 0 && role != 3 && (fields&512) == 0)) mismatch=mismatch|(1<<role)
        if (inputs && role != 0 && role != 3) {
            // gpio_sig_map.h: Q0,D1,HD2,WP3,DQS11,D4..D7=7..10.
            val signal=if (role < 3) role-1 else if (role < 6) role-2 else if (role == 6) 11 else role
            if ((s3MspiMuxRead(0x60004154+4*signal)&128) != 0) mismatch=mismatch|(1<<role)
        }
        role=role+1
    }
    if (inputs) {
        // S3 GPIO_HOLD_MASK: digital GPIO26..37 -> bits5..16.
        // Never clear holds implicitly: doing so can change live flash pins.
        val holds=s3MspiMuxRead(0x600080dc)
        val isolation=s3MspiMuxRead(0x60008094)
        if ((isolation&0xa200) != 0) mismatch=4095
        role=0
        while (role < 12) {
            if ((holds&(1<<(s3MspiDefaultPin(role)-21))) != 0) mismatch=mismatch|(1<<role)
            role=role+1
        }
    }
    return mismatch
}
