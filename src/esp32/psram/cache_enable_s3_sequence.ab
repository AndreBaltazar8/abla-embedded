import "abla/runtime/scalar"
// Native S3 cache enable + autoload restore. Hardware sequence verified against
// rev0 Cache_Enable_I/DCache and Cache_Resume_I/DCache_Autoload, plus EXTMEM
// register definitions. Enable CTRL0 bit0 first, then restore AUTOLOAD bit2
// only if present in the saved token. Zero token does NOT clear current bits.
// Leaves size/line/autoload-section/buffer fields untouched. No waits/calls
// through the mutable ROM function table. This is the Abla-owned controller
// implementation, not an adapter for application-installed ROM-table patches.
// Caller already owns disabled/ready cache, tags/MMU/timing and peer exclusion;
// code/stack remain internal through completion. MMIO hooks include barriers.
@section(".iram1.abla.s3PsramCacheEnable")
trusted fun s3PsramCacheEnableNativeOwned(instruction: bool,state: int): void {
    val control=if (instruction) 0x600c4060 else 0x600c4000
    s3PsramCacheMappingWrite(control,s3PsramCacheMappingRead(control)|1)
    if ((state&4) != 0) {
        val autoload=if (instruction) 0x600c40a0 else 0x600c404c
        s3PsramCacheMappingWrite(autoload,s3PsramCacheMappingRead(autoload)|4)
    }
    return
}
