import "./timing_tables_s3.ab"
import "./timing_window_s3.ab"
// Validate the completed calibration owner BEFORE installing cached timing.
// Caller owns immutable340B record and the same hardware/exclusion lifetime;
// this consistency check is not authentication or a fresh hardware test.
// Reject fallback/partial samples, modified table/selection/candidate, failed
// final read, malformed physical span and inconsistent original flash mode.
// Returns packed measured candidate0..255, or-1 invalid.
@section(".iram1.abla.s3PsramCalibration80Candidate")
fun s3PsramCalibration80Candidate(r: NativeBuffer): int {
    if (!r.hasAddressRange(0,340) || (r.addressValue()&3) != 0 || !s3PsramCommandStorageSafe(r.addressValue(),340)) return -1
    if (r.loadU32(0) != 0x53334338 || r.loadU32(4) != 8 || r.loadU32(36) != 0 ||
        r.loadU32(16) < 1 || r.loadU32(16) > 1024 || r.loadU32(20) > 1 || r.loadU32(24) > 63 || r.loadU32(28) > 255 || r.loadU32(32) > 255 ||
        r.loadU32(12) < 64 || r.loadU32(12) > 1073741824 || r.loadU32(8) > r.loadU32(12)-64 || (r.loadU32(8)&3) != 0) return -1
    if (r.loadU32(20) == 0 && (r.loadU32(24)+r.loadU32(28)+4 > 63 || r.loadU32(24)+r.loadU32(32)+4 > 63)) return -1
    var index=0
    while (index < 14) {
        if (r.loadU32(64+index*4) != nativeAddressLoadU32(s3PsramTimingCandidates,(12+index)*4)) return -1
        index=index+1
    }
    index=48
    while (index < 64) { if (r.loadU32(index) != 0) return -1;index=index+4 }
    val selection=s3PsramTimingWindow(nativeBufferAt(r.addressValue()+120,56),14,r.loadU32(16),5,160,true)
    if (selection < 0 || (selection&255) != 1 || selection != r.loadU32(40)) return -1
    val candidate=r.loadU32(64+((selection>>>8)&255)*4)
    if (candidate != r.loadU32(44)) return -1
    // The coordinator's final verification keeps all64 returned bytes.
    index=176
    while (index < 240) { if (r.loadU32(index) != 0xa5ff005a) return -1;index=index+4 }
    return candidate
}
// Only independent FLASH frequency/profile/timing remain caller-supplied.
// Profile0quad or1/2MXIC OPI must agree with the calibrated flash protocol.
// ROM dummy baseline comes from the record, never recaptured after tuning.
// Does not map memory/resume cache; same error codes as final80,2invalid.
@section(".iram1.abla.s3PsramCalibratedFinal80")
trusted fun s3PsramCalibratedFinal80Owned(r: NativeBuffer,flashMHz: int,flashProfile: int,flashTiming: int,stable480Pll: bool,exclusiveInternal: bool): int {
    if (!stable480Pll || !exclusiveInternal || flashProfile < 0 || flashProfile > 2) return 2
    val candidate=s3PsramCalibration80Candidate(r)
    if (candidate < 0 || r.loadU32(20) != (if (flashProfile == 0) 0 else 1)) return 2
    if (flashProfile == 0) {
        val legacy=s3FlashLegacyPointer()
        if (!s3FlashLegacyPointerValid(legacy) || (r.addressValue() < legacy+28 && legacy < r.addressValue()+340)) return 2
    }
    return s3PsramFinal80Owned(flashMHz,flashProfile,flashTiming,candidate,r.loadU32(24),r.loadU32(28),r.loadU32(32),true,true)
}
