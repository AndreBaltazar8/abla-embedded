import "../sdk/raw_buffer.ab"
// DESTRUCTIVE full-width CPU/mapped-port test. Caller reserves the entire
// span, has validated its one64KB PSRAM mapping, enables AXI/cache correctly,
// and excludes all other accesses/aliases/DMA. Code, stack, report internal.
// This does not create the mapping or recover CPU bus faults; keep watchdog
// and fault capture. A pass covers this span/clock only, not the whole chip.
// 38patterns:0/ff/aa/55/address/complement and32 walking bits. Each write
// pass is fenced, written back+invalidated, fenced, then read back volatile.
// low status1pass2invalid3inactive4cache failure5mismatch. Internal report16B:
// pattern0, byte offset4,expected8,actual12 (cache failure: status at8).
fun p4PsramVerifyWord(pattern: int,address: int,walking: int): int =
    if (pattern == 0) 0 else if (pattern == 1) 4294967295 else if (pattern == 2) 0xaaaaaaaa else if (pattern == 3) 0x55555555 else
    if (pattern == 4) address else if (pattern == 5) address^4294967295 else walking
trusted fun p4PsramMappedVerifyOwned(buffer: NativeBuffer,bytes: int,l2Line: int,report: NativeBuffer,polls: int): int {
    val base=buffer.addressValue()
    if (base < 0x48000000 || base >= 0x4c000000 || bytes < 64 || bytes > 65536 || (base&65535)+bytes > 65536 ||
        (l2Line != 64 && l2Line != 128) || (base&(l2Line-1)) != 0 || (bytes&(l2Line-1)) != 0 || !buffer.hasAddressRange(0,bytes) || bytes > 0x4c000000-base ||
        !report.hasAddressRange(0,16) || (report.addressValue()&3) != 0 || !p4PsramCommandStorageSafe(report.addressValue(),16) || polls < 1 || polls > 1000000) return 2
    if (!p4PsramVerifyReady(l2Line)) return 3
    report.storeU32(0,0); report.storeU32(4,0); report.storeU32(8,0); report.storeU32(12,0)
    p4PsramVerifyFence()
    var pattern=0; var walking=1
    while (pattern < 38) {
        report.storeU32(0,pattern)
        var offset=0
        while (offset < bytes) { p4PsramVerifyWrite(base+offset,p4PsramVerifyWord(pattern,base+offset,walking)); offset=offset+4 }
        p4PsramVerifyFence()
        val flushed=p4PsramVerifyFlush(buffer,bytes,l2Line,polls)
        if (flushed != 1) { report.storeU32(8,flushed); return 4 }
        p4PsramVerifyFence()
        offset=0
        while (offset < bytes) {
            val expected=p4PsramVerifyWord(pattern,base+offset,walking)
            val actual=p4PsramVerifyRead(base+offset)
            if (actual != expected) {
                report.storeU32(4,offset); report.storeU32(8,expected); report.storeU32(12,actual)
                return 5
            }
            offset=offset+4
        }
        p4PsramVerifyFence()
        if (pattern >= 6) walking=(walking<<1)&4294967295
        pattern=pattern+1
    }
    return 1
}
