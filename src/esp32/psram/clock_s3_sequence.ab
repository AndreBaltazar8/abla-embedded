import "./cs_s3_sequence.ab"
// Clock portion of IDF6 mspi_timing_enter_low_speed_mode(true).
// Core selector0 =>80MHz under the caller-proven stable PLL system clock;
// divider4 yields20MHz on SPI0 flash, SPI1 command port and SPI0 PSRAM.
// Caches/peers/IRQs/DMA/MSPI users must stay excluded; the whole continuation,
// stack and data remain internal. This does NOT reset tuning/dummy registers:
// do not resume flash/cache access until their low-speed profile is installed.
// No PLL selection/reconfiguration. Partial failures retain ownership.
// 1clocks set,2proof missing,3busy,4readback failure.
@section(".iram1.abla.s3PsramLowClock")
trusted fun s3PsramLowClockOwned(stablePllSystemClock: bool,exclusiveInternal: bool): int {
    if (!stablePllSystemClock || !exclusiveInternal) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    var step=0
    while (step < 4) {
        val address=if (step == 0) 0x600030ec else if (step == 1) 0x60003014 else if (step == 2) 0x60002014 else 0x60003050
        // N=L=3, H=1; divide-by-system disabled. Clock registers are assigned
        // exactly as the HAL does, including clearing reserved high bits.
        val expected=if (step == 0) s3PsramCsRead(address)&0xfffffffc else 0x30103
        s3PsramCsWrite(address,expected)
        if (s3PsramCsRead(address) != expected) return 4
        step=step+1
    }
    return 1
}
