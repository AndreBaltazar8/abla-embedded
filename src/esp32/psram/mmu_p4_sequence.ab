// PSRAM MMU only:1024 entries,64KB pages, virtual48000000..4c000000.
// Caller serializes the indexed table AND both controller/cache/CPU/DMA users;
// internal execution, dirty data written back, old cache/TLB aliases invalidated
// before replacement. No cache operations, MMU-global reset, or AXI enable here.
// Map/unmap are compare-before-write against the caller-owned prior raw entry.
// Low8:1done2invalid3clock/reset4active/busy5index readback6stale7entry readback
// 8encryption verification. Observed raw entry bits8..39 where available.
fun p4PsramMmuIndex(address: int): int = if (address < 0x48000000 || address >= 0x4c000000 || (address&65535) != 0) -1 else (address-0x48000000)>>>16
trusted fun p4PsramMmuPreflight(polls: int): int {
    if (polls < 1 || polls > 1000000) return 2
    if ((p4PsramClockRead(192)&0x02800000) != 0 || (p4PsramClockRead(20)&0x80000000) == 0 || (p4PsramClockRead(48)&0xc000) != 0xc000) return 3
    if ((p4PsramMappedRead(60)&1) != 0 || (p4PsramMappedRead(4096)&0x400f0) != 0 || !p4PsramMappedWaitIdle(polls)) return 4
    return 1
}
trusted fun p4PsramMmuReadOwned(address: int,polls: int): int {
    val index=p4PsramMmuIndex(address)
    if (index < 0) return 2
    val checked=p4PsramMmuPreflight(polls)
    if (checked != 1) return checked
    p4PsramMappedWrite(896,index)
    if (p4PsramMappedRead(896) != index) return 5
    return 1|(p4PsramMappedRead(892)<<8)
}
trusted fun p4PsramMmuReplaceOwned(address: int,expected: int,next: int,polls: int): int {
    if (expected < 0 || expected > 4294967295 || next < 0 || next > 8191) return 2
    val prior=p4PsramMmuReadOwned(address,polls)
    if ((prior&255) != 1) return prior
    if ((prior>>>8) != expected) return (prior&(-256))|6
    p4PsramMappedWrite(892,next)
    val observed=p4PsramMappedRead(892)
    return (observed<<8)|(if (observed == next) 1 else 7)
}
trusted fun p4PsramMmuMapOwned(address: int,physical: int,capacity: int,expected: int,polls: int): int {
    if (capacity < 65536 || capacity > 67108864 || physical < 0 || physical > capacity-65536 || (physical&65535) != 0) return 2
    val encrypted=p4PsramMmuEncryptionEnabled()
    val next=(physical>>>16)|0xc00|(if (encrypted) 0x1000 else 0)
    val result=p4PsramMmuReplaceOwned(address,expected,next,polls)
    if ((result&255) != 1) return result
    // Match IDF's post-write check; never silently map plaintext on an
    // encryption-enabled chip. Failed verification retains entry ownership.
    if (p4PsramMmuEncryptionEnabled() != encrypted) return (result&(-256))|8
    return result
}
trusted fun p4PsramMmuUnmapOwned(address: int,expected: int,polls: int): int = p4PsramMmuReplaceOwned(address,expected,0,polls)
