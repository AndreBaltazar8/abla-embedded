import "./cs_s3_sequence.ab"
// Shared nine-lane (D0..D7+DQS) input timing, SPI0 register aliases only.
// Flash extra dummy is NOT included: quad flash needs its original ROM dummy
// additions and current read-mode base, unlike octal calibration registers.
// Caller keeps clocks/caches/peers/IRQs/DMA quiesced and runs internally.
// Used with all zeros AFTER lowering both port clocks for the low-speed path;
// later calibration may install a measured nonzero profile with the same API.
// 1configured,2invalid/proof missing,3busy,4readback failure/partial state.
@section(".iram1.abla.s3PsramDin")
trusted fun s3PsramDinOwned(flashMode: int,flashNumber: int,psramMode: int,psramNumber: int,psramExtraDummy: int,exclusiveInternal: bool): int {
    if (!exclusiveInternal || flashMode < 0 || flashMode > 7 || flashNumber < 0 || flashNumber > 3 ||
        psramMode < 0 || psramMode > 7 || psramNumber < 0 || psramNumber > 3 || psramExtraDummy < 0 || psramExtraDummy > 7) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    var step=0
    while (step < 6) {
        val address=if (step == 0) 0x600030ac else if (step == 1) 0x600030b0 else if (step == 2) 0x600030c0 else if (step == 3) 0x600030c4 else 0x600030bc
        val mask=if (step == 0 || step == 2) 0x7ffffff else if (step == 1 || step == 3) 0x3ffff else if (step == 4) 2 else 28
        val bits=if (step == 0) flashMode*0x1249249 else if (step == 1) flashNumber*0x15555 else if (step == 2) psramMode*0x1249249 else if (step == 3) psramNumber*0x15555 else if (step == 4) (if (psramExtraDummy == 0) 0 else 2) else psramExtraDummy*4
        val expected=(s3PsramCsRead(address)&(0xffffffff^mask))|bits
        s3PsramCsWrite(address,expected)
        if (s3PsramCsRead(address) != expected) return 4
        step=step+1
    }
    return 1
}
