import "./pins_p4_sequence.ab"
import "./tuning_values_p4.ab"
// Candidate controls only: NOT a claim that a phase/delay has been trained.
// Phase0..3 =67.5/78.75/90/101.25 degrees; delay taps0..15. Same controller,
// pad, RCC, internal-execution and exclusion prerequisites as pin preparation.
// All20 pads touched, including BOTH DQS pins; other pad fields preserved.
// Low8 status1configured2invalid3AXI4busy5readback6clock/reset; high8failedpad+1.
trusted fun p4PsramTuningCandidateOwned(phase: int,dataDelay: int,dqsDelay: int,polls: int): int {
    if (phase < 0 || phase > 3 || dataDelay < 0 || dataDelay > 15 || dqsDelay < 0 || dqsDelay > 15 || polls < 1 || polls > 1000000) return 2
    if ((p4PsramClockRead(192)&0x02800000) != 0 || (p4PsramClockRead(20)&0x80000000) == 0 || (p4PsramClockRead(48)&0xc000) != 0xc000) return 6
    if ((p4PsramMappedRead(60)&1) != 0) return 3
    if ((p4PsramMappedRead(4096)&0x400f0) != 0 || !p4PsramMappedWaitIdle(polls)) return 4
    var pin=0
    while (pin < 20) {
        val dqs=pin == 8 || pin == 19
        val mask=if (dqs) 0x001e0786 else 240
        val value=if (dqs) (phase<<1)|(dqsDelay<<7)|(dqsDelay<<17) else dataDelay<<4
        if (!p4PsramPinField(28+pin*4,mask,value)) return ((pin+1)<<8)|5
        pin=pin+1
    }
    return 1
}
