import "./identity_p4_sequence.ab"
// DESTRUCTIVE command-port connectivity probe on a caller-reserved128-byte
// physical span, aligned128. Never select an arbitrary live memory location.
// Entire span must be unused by application/cache/DMA. No restoration claim.
// X8 uses byte addresses, X16 word addresses (AP datasheet7.1); MSPI3 OPI
// tests the lower8 data pins, not full16-bit lane integrity in X16 mode.
// 14patterns x64 command bytes:00/ff/aa/55,walking1,address/complement.
// Same unbounded ROM completion caveat as command transport; retain watchdog.
// Low8:1passed2invalid3identity/profile4write5read6mismatch;
// transport8..15,pattern16..23,index24..31,expected32..39,actual40..47.
fun p4PsramProbeByte(pattern: int,index: int): int =
    if (pattern == 0) 0 else if (pattern == 1) 255 else if (pattern == 2) 170 else if (pattern == 3) 85 else
    if (pattern == 4) 1 else if (pattern == 5) 2 else if (pattern == 6) 4 else if (pattern == 7) 8 else
    if (pattern == 8) 16 else if (pattern == 9) 32 else if (pattern == 10) 64 else if (pattern == 11) 128 else if (pattern == 12) index else index^255
trusted fun p4PsramProbeOwned(identity: P4PsramIdentity,mhz: int,byteOffset: int,scratch: NativeBuffer,work: NativeBuffer): int {
    val hex16=(identity.mode(8)&64) != 0
    if (!identity.matchesProfile(mhz,hex16)) return 3
    if (byteOffset < 0 || (byteOffset&127) != 0 || byteOffset > identity.physicalBytes()-128 ||
        !scratch.hasAddressRange(0,64) || !work.hasAddressRange(0,100) || (work.addressValue()&3) != 0 ||
        !p4PsramCommandStorageSafe(scratch.addressValue(),64) || !p4PsramCommandStorageSafe(work.addressValue(),100)) return 2
    val s=scratch.addressValue(); val w=work.addressValue()
    if (s < w+100 && w < s+64) return 2
    val address=if (hex16) byteOffset>>>1 else byteOffset
    var pattern=0
    while (pattern < 14) {
        var index=0
        while (index < 64) { scratch.store(index,p4PsramProbeByte(pattern,index)); index=index+1 }
        var result=p4PsramCommandOwned(0x8080,address,p4PsramProfileWriteDummy(mhz),scratch,64,work)
        if (result != 1) return 4|((result&255)<<8)|(pattern<<16)
        index=0
        // An omitted/short read cannot pass by comparing leftover TX bytes.
        while (index < 64) { scratch.store(index,p4PsramProbeByte(pattern,index)^255); index=index+1 }
        result=p4PsramCommandOwned(0,address,p4PsramProfileReadDummy(mhz),scratch,64,work)
        if (result != 1) return 5|((result&255)<<8)|(pattern<<16)
        index=0
        while (index < 64) {
            val expected=p4PsramProbeByte(pattern,index); val actual=scratch.load(index)
            if (actual != expected) return 6|(pattern<<16)|(index<<24)|(expected<<32)|(actual<<40)
            index=index+1
        }
        pattern=pattern+1
    }
    return 1
}
