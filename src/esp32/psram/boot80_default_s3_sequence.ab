import "../sdk/raw_buffer.ab"
// Default-wired boards only. Reject custom eFuse routing or an active mux
// or required input-buffer/matrix-bypass mismatch before changing clocks/caches/PSRAM.
// CS1 is set by cold init.
// Hold/isolation requests on any memory pad (including CS1) are rejected,
// never implicitly released; error masks now include all12 pin roles.
// 2 invalid/proof; 0x20000 unsupported custom routing; 0x20000|mask bad mux;
// otherwise configured boot status. This adds routing admission, NOT proof of
// power, pad holds, electrical wiring, PLL, exclusion, or internal stack.
@section(".iram1.abla.s3PsramBoot80Default")
trusted fun s3PsramBoot80DefaultOwned(r: NativeBuffer,virtual: int,bytes: int,capacity: int,flashMHz: int,flashProfile: int,flashTiming: int,base: int,repetitions: int,cacheKiB: int,lineBytes: int,bootPrerequisites: bool): int {
    if (!bootPrerequisites) return 2
    val mismatch=s3MspiDefaultBootPadMismatch()
    if (mismatch < 0) return 131072
    if (mismatch != 0) return 131072|mismatch
    return s3PsramBoot80ConfiguredOwned(r,virtual,bytes,capacity,flashMHz,flashProfile,flashTiming,base,repetitions,cacheKiB,lineBytes,true)
}
