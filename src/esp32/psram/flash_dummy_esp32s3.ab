import "./flash_dummy_s3_sequence.ab"
import "./cs_esp32s3.ab"
import "../sdk/raw_buffer.ab"
import "../../hal/esp32_psram.ab"
import "abla/unsafe/mmio"
import "../../hal/native_buffer.ab"
// S3 ROM pointer slot, not the structure itself. Sixu32 chip fields precede
// three dummy bytes and sig_matrix; only bytes24/25 belong to these ports.
@export("s3FlashLegacyPointer")
trusted fun s3FlashLegacyPointerHook(): int = mmioLoadU32(0x3fceffe4)
@export("s3FlashDummyByteRead")
trusted fun s3FlashDummyByteReadHook(address: int): int = nativeBufferAt(address,1).load(0)
@export("s3FlashDummyByteWrite")
trusted fun s3FlashDummyByteWriteHook(address: int,value: int): void { nativeBufferAt(address,1).store(0,value);return }
