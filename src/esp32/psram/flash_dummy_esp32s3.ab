import "./flash_dummy_s3_sequence.ab"
import "./cs_esp32s3.ab"
import "../sdk/raw_buffer.ab"
// S3 ROM pointer slot, not the structure itself. Sixu32 chip fields precede
// three dummy bytes and sig_matrix; only bytes24/25 belong to these ports.
trusted fun s3FlashLegacyPointer(): int = mmioLoadU32(0x3fceffe4)
trusted fun s3FlashDummyByteRead(address: int): int = nativeBufferAt(address,1).load(0)
trusted fun s3FlashDummyByteWrite(address: int,value: int): void { nativeBufferAt(address,1).store(0,value);return }
