import "abla/runtime/scalar"
// Pure preflight shared by loader admission and the hardware coordinator.
// It must run before clock/cache/pad changes. This validates requested ranges,
// not buffer ownership, actual capacity, calibration or electrical readiness.
fun s3PsramBoot80ArgumentsValid(virtual: int,bytes: int,physical: int,flashMHz: int,profile: int,timing: int,base: int,repetitions: int,cacheKiB: int,lineBytes: int): bool {
    if (!((cacheKiB == 0 && lineBytes == 0) || ((cacheKiB == 32 || cacheKiB == 64) && (lineBytes == 16 || lineBytes == 32 || lineBytes == 64)))) return false
    return virtual >= 0x3c000000 && virtual < 0x3e000000 && bytes >= 65536 && bytes <= 33554432 &&
        ((virtual|bytes)&65535) == 0 && bytes <= 0x3e000000-virtual && physical >= bytes && physical <= 67108864 &&
        (flashMHz == 20 || flashMHz == 40 || flashMHz == 80) && profile >= 0 && profile <= 2 && timing >= 0 && timing <= 255 &&
        base >= 0 && base <= 63 && repetitions >= 1 && repetitions <= 1024
}
