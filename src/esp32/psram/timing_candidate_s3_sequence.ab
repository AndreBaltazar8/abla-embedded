import "./flash_dummy_s3_sequence.ab"
// Candidate installation for OPI PSRAM: shared SPI0 PSRAM DIN mode/number,
// then SPI1's dedicated FMEM OPI extra-dummy field (also used for CS1).
// Select by the active COMMAND protocol, not the flash chip protocol:
// USER1 quad-flash dummy is overwritten by every OPI command descriptor.
// Does NOT alter ROM flash dummy additions, shared FLASH DIN or SPI0 dummy,
// cached PSRAM dummy, clocks, chip mode or caches. Final high-speed profile
// installation is separate. Caller owns internal/cache/peer/IRQ/DMA/MSPI
// exclusion, actual flash protocol/base and ORIGINAL pre-tuning ROM baseline.
// Failure leaves partial state under caller ownership. Retry same candidate.
@section(".iram1.abla.s3PsramTimingCandidate")
trusted fun s3PsramTimingCandidateOwned(mode: int,number: int,extra: int,octalFlash: bool,base: int,original0: int,original1: int,exclusiveInternal: bool): int {
    if (!exclusiveInternal || mode < 0 || mode > 7 || number < 0 || number > 3 ||
        extra < 0 || extra > 7 || base < 0 || base > 63 || original0 < 0 || original0 > 255 || original1 < 0 || original1 > 255 ||
        (!octalFlash && (base+original0+extra > 63 || base+original1+extra > 63))) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    var value=(s3PsramCsRead(0x600030c0)&0xf8000000)|(mode*0x1249249)
    s3PsramCsWrite(0x600030c0,value)
    if (s3PsramCsRead(0x600030c0) != value) return 4
    value=(s3PsramCsRead(0x600030c4)&0xfffc0000)|(number*0x15555)
    s3PsramCsWrite(0x600030c4,value)
    if (s3PsramCsRead(0x600030c4) != value) return 4
    return s3FlashDummyPortsOwned(1,true,base,original0,original1,extra,true)
}
