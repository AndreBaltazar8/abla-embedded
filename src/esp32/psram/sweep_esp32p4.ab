import "./sweep_p4_sequence.ab"
import "./tuning_esp32p4.ab"
import "./timing_esp32p4.ab"
import "./identity_esp32p4.ab"
import "../../hal/esp32_psram.ab"
@export("p4PsramSweepSpeed")
trusted fun p4PsramSweepSpeedHook(mapped: int,command: int,polls: int): int = p4PsramTimingConfigureOwned(mapped,command,4,4,3,2048,true,polls)
@export("p4PsramSweepCandidate")
trusted fun p4PsramSweepCandidateHook(phase: int,index: int,polls: int): int = p4PsramTuningCandidateOwned(phase,p4PsramTuningDataDelay(index),p4PsramTuningDqsDelay(index),polls)
@export("p4PsramSweepCommand")
trusted fun p4PsramSweepCommandHook(write: bool,address: int,mhz: int,scratch: NativeBuffer,work: NativeBuffer): int =
    p4PsramCommandOwned(if (write) 0x8080 else 0,address,if (write) p4PsramProfileWriteDummy(mhz) else p4PsramProfileReadDummy(mhz),scratch,64,work)
