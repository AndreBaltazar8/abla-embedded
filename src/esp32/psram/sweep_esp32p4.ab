import "./sweep_p4_sequence.ab"
import "./tuning_esp32p4.ab"
import "./timing_esp32p4.ab"
import "./identity_esp32p4.ab"
trusted fun p4PsramSweepSpeed(mapped: int,command: int,polls: int): int = p4PsramTimingConfigureOwned(mapped,command,4,4,3,2048,true,polls)
trusted fun p4PsramSweepCandidate(phase: int,index: int,polls: int): int = p4PsramTuningCandidateOwned(phase,p4PsramTuningDataDelay(index),p4PsramTuningDqsDelay(index),polls)
trusted fun p4PsramSweepCommand(write: bool,address: int,mhz: int,scratch: NativeBuffer,work: NativeBuffer): int =
    p4PsramCommandOwned(if (write) 0x8080 else 0,address,if (write) p4PsramProfileWriteDummy(mhz) else p4PsramProfileReadDummy(mhz),scratch,64,work)
