import "abla/runtime/scalar"
// Shared SPI0/1 PSRAM CS timing is controlled solely through SPI0 SMEM_AC,
// not flash CTRL2/USER timing. IDF6 esp_psram_impl_octal.c:s_set_psram_cs_timing.
// Caller has suspended/excluded all cache, peer, IRQ, DMA and MSPI clients and
// owns the clocks. Internal-only code/stack required. No clock/reset/ECC enable.
// 1configured,2invalid/proof missing,3busy,4readback failure (partial settings
// remain owned; retry while quiesced or restore before admitting clients).
@section(".iram1.abla.s3PsramCs")
trusted fun s3PsramCsTimingOwned(hold: int,setup: int,highDelay: int,eccHold: int,exclusiveInternal: bool): int {
    if (!exclusiveInternal || hold < 0 || hold > 31 || setup < 0 || setup > 31 ||
        highDelay < 0 || highDelay > 63 || eccHold < -1 || eccHold > 7) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    var step=0
    while (step < 5) {
        if (step != 3 || eccHold >= 0) {
            val mask=if (step == 0) 3 else if (step == 1) 3968 else if (step == 2) 124 else if (step == 3) 28672 else 0x7e000000
            val bits=if (step == 0) 3 else if (step == 1) hold<<7 else if (step == 2) setup<<2 else if (step == 3) eccHold<<12 else highDelay<<25
            val value=(s3PsramCsRead(0x600030dc)&(0xffffffff^mask))|bits
            s3PsramCsWrite(0x600030dc,value)
            if (s3PsramCsRead(0x600030dc) != value) return 4
        }
        step=step+1
    }
    return 1
}
