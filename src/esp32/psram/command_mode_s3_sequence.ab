import "./cs_s3_sequence.ab"
// SPI1 command port uses FMEM DDR fields even for CS1 PSRAM, as in IDF6
// esp_psram_impl_octal.c. Enable variable dummy then disable TX/RX byte swap.
// Direct MMIO replaces the ROM swap helper; does not change SPI0 flash DDR
// settings or SPI0 cached PSRAM SMEM fields. Command mode selection remains
// the command transport's responsibility, not a forced DDR-enable bit here.
// Internal/exclusive cache/MSPI/peer/IRQ/DMA ownership throughout.
// 1configured,2proof missing,3busy,4readback failure/partial configuration.
@section(".iram1.abla.s3PsramCommandMode")
trusted fun s3PsramCommandModeOwned(exclusiveInternal: bool): int {
    if (!exclusiveInternal) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    var value=s3PsramCsRead(0x600020e0)|2
    s3PsramCsWrite(0x600020e0,value)
    if (s3PsramCsRead(0x600020e0) != value) return 4
    value=s3PsramCsRead(0x600020e0)&0xfffffff3
    s3PsramCsWrite(0x600020e0,value)
    if (s3PsramCsRead(0x600020e0) != value) return 4
    return 1
}
