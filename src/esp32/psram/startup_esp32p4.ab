import "./startup_p4_sequence.ab"
import "./cold_esp32p4.ab"
import "../cache_autoload_esp32p4.ab"
import "../cache_flush_esp32p4.ab"
trusted fun p4PsramStartupSuspend(polls: int): int = p4CacheAutoloadSuspendOwned(polls)|0
trusted fun p4PsramStartupInputsValid(record: NativeBuffer,cold: NativeBuffer,mhz: int,dummy: int,scratch: NativeBuffer,work: NativeBuffer,polls: int): bool {
    if (!p4PsramColdStorage(cold) || !p4PsramProfileValid(mhz) || dummy < 0 || dummy > 64 || polls < 1 || polls > 1000000 ||
        !scratch.hasAddressRange(0,2) || !work.hasAddressRange(0,100) || (work.addressValue()&3) != 0 ||
        !p4PsramCommandStorageSafe(scratch.addressValue(),2) || !p4PsramCommandStorageSafe(work.addressValue(),100)) return false
    val r=record.addressValue(); val c=cold.addressValue(); val s=scratch.addressValue(); val w=work.addressValue()
    return p4PsramColdDisjoint(r,16,c,48) && p4PsramColdDisjoint(r,16,s,2) && p4PsramColdDisjoint(r,16,w,100) &&
        p4PsramColdDisjoint(c,48,s,2) && p4PsramColdDisjoint(c,48,w,100) && p4PsramColdDisjoint(s,2,w,100)
}
