import "../sdk/raw_buffer.ab"
// Exclusive mapped DATA range owner for framebuffers and other PSRAM users.
// Internal88B: magic0,phase4,address8,bytes12,line16,error20,MMU lease24..63,
// range-verification report64..87. Initialize only fresh owned storage.
// phase0fresh1mapping2AXIattempt3active4verified5flushed6stopped7closed.
// Phase8 reserved for an external consumer loan; generic close refuses it.
// The lending adapter must prove consumer shutdown before returning phase4.
// Caller holds initialized/trained controller/cache/clock and owns all mapped
// physical/virtual pages, excludes aliases/peers/DMA and keeps code+stack internal.
// NO DMA starts here. Before close caller MUST stop/join all consumers.
// Partial phase retained: never reflush after AXI may have been closed.
fun p4PsramMemoryStorage(record: NativeBuffer): bool = record.hasAddressRange(0,88) && (record.addressValue()&3) == 0 && p4PsramCommandStorageSafe(record.addressValue(),88)
trusted fun p4PsramMemoryInitializeOwned(record: NativeBuffer): bool {
    if (!p4PsramMemoryStorage(record)) return false
    var offset=0
    while (offset < 88) { record.storeU32(offset,0); offset=offset+4 }
    if (!p4PsramRangeInitializeOwned(nativeBufferAt(record.addressValue()+24,40))) return false
    record.storeU32(0,0x50344d45); return true
}
trusted fun p4PsramMemoryFailure(record: NativeBuffer,error: int): int { record.storeU32(20,error); return 4 }
trusted fun p4PsramMemoryOpenOwned(record: NativeBuffer,address: int,physical: int,pages: int,capacity: int,line: int,readDummy: int,writeDummy: int,hex16: bool,polls: int): int {
    if (!p4PsramMemoryStorage(record) || p4PsramMmuIndex(address) < 0 || pages < 1 || pages > 1024 || pages > ((0x4c000000-address)>>>16) ||
        capacity < 65536 || capacity > 67108864 || physical < 0 || physical > capacity || (physical&65535) != 0 || (pages<<16) > capacity-physical ||
        (line != 64 && line != 128) || !p4PsramMappedProfileValid(readDummy,writeDummy,polls)) return 2
    if (record.loadU32(0) != 0x50344d45 || record.loadU32(4) != 0) return 3
    if (!p4CacheL2GeometryMatches(line)) return p4PsramMemoryFailure(record,3)
    record.storeU32(8,address); record.storeU32(12,pages<<16); record.storeU32(16,line); record.storeU32(4,1)
    val mapped=p4PsramRangeMapOwned(nativeBufferAt(record.addressValue()+24,40),address,physical,pages,capacity,polls)
    if (mapped != 1) return p4PsramMemoryFailure(record,mapped)
    record.storeU32(4,2)
    val started=p4PsramMappedStartOwned(readDummy,writeDummy,hex16,polls)
    if (started != 1) return p4PsramMemoryFailure(record,started)
    p4PsramVerifyFence(); record.storeU32(4,3); record.storeU32(20,0); return 1
}
trusted fun p4PsramMemoryVerifyOwned(record: NativeBuffer,polls: int): int {
    if (!p4PsramMemoryStorage(record) || polls < 1 || polls > 1000000) return 2
    if (record.loadU32(0) != 0x50344d45 || record.loadU32(4) != 3) return 3
    val result=p4PsramMappedRangeVerifyOwned(nativeBufferAt(record.loadU32(8),record.loadU32(12)),record.loadU32(12),record.loadU32(16),nativeBufferAt(record.addressValue()+64,24),polls)
    if (result != 1) return p4PsramMemoryFailure(record,result)
    record.storeU32(4,4); record.storeU32(20,0); return 1
}
trusted fun p4PsramMemoryCloseOwned(record: NativeBuffer,polls: int): int {
    if (!p4PsramMemoryStorage(record) || polls < 1 || polls > 1000000) return 2
    if (record.loadU32(0) != 0x50344d45 || record.loadU32(4) > 7) return 3
    val phase=record.loadU32(4)
    if (phase == 0 || phase == 7) { record.storeU32(4,7); return 1 }
    if (phase == 3 || phase == 4) {
        if (!p4CacheL2GeometryMatches(record.loadU32(16))) return p4PsramMemoryFailure(record,3)
        p4PsramVerifyFence()
        val result=p4PsramVerifyFlush(nativeBufferAt(record.loadU32(8),record.loadU32(12)),record.loadU32(12),record.loadU32(16),polls)
        if (result != 1) return p4PsramMemoryFailure(record,result)
        p4PsramVerifyFence(); record.storeU32(4,5)
    }
    if (record.loadU32(4) == 2 || record.loadU32(4) == 5) {
        val stopped=p4PsramMappedStopOwned(polls)
        if (stopped != 1) return p4PsramMemoryFailure(record,stopped)
        p4PsramVerifyFence(); record.storeU32(4,6)
    }
    val unmapped=p4PsramRangeUnmapOwned(nativeBufferAt(record.addressValue()+24,40),polls)
    if (unmapped != 1) return p4PsramMemoryFailure(record,unmapped)
    p4PsramVerifyFence(); record.storeU32(4,7); record.storeU32(20,0); return 1
}
