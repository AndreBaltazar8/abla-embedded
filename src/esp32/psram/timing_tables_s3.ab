// Adapted from ESP-IDF v6.0.2 S3 mspi_timing_tuning_configs.h PSRAM tables.
import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Exact upstream ordering; packed mode[2:0],number[4:3],extraDummy[7:5].
val s3PsramTimingCandidates=nativeStaticU32s([
    1,42,34,0,43,35,33,74,66,32,75,67,0,84,74,76,33,68,32,116,106,108,65,100,64,148,1,0,41,90,33,32,73,122,65,64,105,154,34,0,82,33,66,32,114,65,98,64,146,97,0,76,33,68,32,108,65,100,64,140,97,132,96,172
])
// Profile identity is a clock/protocol match, not frequency configuration.
// 0=80/40DTR,1=160/80DTR,2=240/120STR,3=120/120STR,4=240/120DTR.
// A table's presence does NOT imply a supported transport/selection scheme:
// current OPI sweep is DTR-only; profile4 also needs PLL frequency scanning.
fun s3PsramTimingProfile(coreMHz: int,moduleMHz: int,dtr: bool): int {
    if (dtr) {
        if (coreMHz == 80 && moduleMHz == 40) return 0
        if (coreMHz == 160 && moduleMHz == 80) return 1
        if (coreMHz == 240 && moduleMHz == 120) return 4
    } else if (moduleMHz == 120) {
        if (coreMHz == 240) return 2
        if (coreMHz == 120) return 3
    }
    return -1
}
// count in low8; upstream default index in next8. -1 invalid.
fun s3PsramTimingTableInfo(profile: int): int {
    if (profile == 0) return 12|(4<<8)
    if (profile == 1) return 14|(5<<8)
    if (profile == 2 || profile == 3) return 12|(2<<8)
    if (profile == 4) return 14|(1<<8)
    return -1
}
@section(".iram1.abla.s3PsramTimingTable")
fun s3PsramTimingTableCopy(profile: int,output: NativeBuffer): int {
    val info=s3PsramTimingTableInfo(profile)
    if (info < 0) return -1
    val count=info&255
    if (!output.hasAddressRange(0,count*4) || (output.addressValue()&3) != 0 ||
        (output.addressValue() < s3PsramTimingCandidates+256 && s3PsramTimingCandidates < output.addressValue()+count*4)) return -1
    val start=if (profile == 0) 0 else if (profile == 1) 12 else if (profile == 2) 26 else if (profile == 3) 38 else 50
    var index=0
    while (index < count) {
        output.storeU32(index*4,nativeAddressLoadU32(s3PsramTimingCandidates,(start+index)*4))
        index=index+1
    }
    return info
}
