import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "./cache_geometry_s3_sequence.ab"
import "./boot80_arguments_s3.ab"
// Both potential DCache banks stay unavailable to the boot owner even when
// preserving caller geometry. Physical stack/code exclusions are link-owned.
fun s3PsramBootOwnerAvoidsCache(address: int,length: int): bool =
    address >= 0 && length > 0 && address <= 4294967296-length &&
    !(address < 0x3fd00000 && address+length > 0x3fcf0000)
// OPI80 boot orchestration, one internal allocation672+4*pages bytes.
// Header64:magic,stage,virtual,bytes,flashMHz,flashProfile,flashTiming,base,
// repetitions,expectedPhysicalBytes,lastError,cacheKiB,lineBytes,reserved12.
// Nested owners:
// cache32@64,cold64@96,calibration340@160,bus16@500,activation16@516,
// coldScratch8@532,coldWork100@540,MMU32+4*pages@640.
// Caller explicitly reserves physical PSRAM0..mappedBytes (including the
// destructive64B calibration reference0..63), shared MMU virtual span, all
// buffers/pads. Expected capacity is checked against chip identity.
// Prerequisites: cold PSRAM, actual efuse/pads/power/MR wiring, configured
// cache geometry, stable480PLL system source, valid OLD flash/cache mappings,
// independently valid flash timing/profile/base, both CPUs/IRQ/DMA quiesced,
// entire continuation/stack internal and watchdog recovery for ROM waits.
// Stages1cache-disable,2cold,3capacity,4calibration,5final,6MMU,7gates,
// 8cache-original-restore,9explicitDactivate,10mapped-sentinel,11ready.
// Errors/pending retain stage+nested owners. Retry only that stage, never
// reinitializes earlier hardware. No automatic rollback or release: failure
// may need platform reset/recovery while ALL external users remain excluded.
// Success verifies64B mapped reference, NOT all RAM/board boot/display parity.
@section(".iram1.abla.s3PsramBoot80")
trusted fun s3PsramBoot80Owned(r: NativeBuffer,virtual: int,bytes: int,expectedPhysicalBytes: int,flashMHz: int,flashProfile: int,flashTiming: int,base: int,repetitions: int,bootPrerequisites: bool): int {
    return s3PsramBoot80ConfiguredOwned(r,virtual,bytes,expectedPhysicalBytes,flashMHz,flashProfile,flashTiming,base,repetitions,0,0,bootPrerequisites)
}
// cacheKiB/lineBytes=0/0 preserves preconfigured geometry. Otherwise caller
// ALSO proves the selected cache SRAM banks are relinquished by every linker
// section/heap/stack/ROM user. Header44/48 binds the choice across retries.
// Configure only after cache-disable has completed and before cold PSRAM.
@section(".iram1.abla.s3PsramBoot80Configured")
trusted fun s3PsramBoot80ConfiguredOwned(r: NativeBuffer,virtual: int,bytes: int,expectedPhysicalBytes: int,flashMHz: int,flashProfile: int,flashTiming: int,base: int,repetitions: int,cacheKiB: int,lineBytes: int,bootPrerequisites: bool): int {
    if (!bootPrerequisites || !s3PsramBoot80ArgumentsValid(virtual,bytes,expectedPhysicalBytes,flashMHz,flashProfile,flashTiming,base,repetitions,cacheKiB,lineBytes)) return 2
    val total=672+(bytes>>>16)*4;val root=r.addressValue()
    if (!r.hasAddressRange(0,total) || (root&3) != 0 || !s3PsramCommandStorageSafe(root,total) || !s3PsramBootOwnerAvoidsCache(root,total)) return 2
    if (flashProfile == 0) {
        val legacy=s3FlashLegacyPointer()
        if (!s3FlashLegacyPointerValid(legacy) || (root < legacy+28 && legacy < root+total)) return 2
    }
    if (r.loadU32(0) == 0) {
        var offset=0
        while (offset < total) { r.storeU32(offset,0);offset=offset+4 }
        r.storeU32(0,0x53334238);r.storeU32(4,1);r.storeU32(8,virtual);r.storeU32(12,bytes)
        r.storeU32(16,flashMHz);r.storeU32(20,flashProfile);r.storeU32(24,flashTiming);r.storeU32(28,base)
        r.storeU32(32,repetitions);r.storeU32(36,expectedPhysicalBytes)
        r.storeU32(44,cacheKiB);r.storeU32(48,lineBytes)
    } else if (r.loadU32(0) != 0x53334238 || r.loadU32(4) < 1 || r.loadU32(4) > 11 || r.loadU32(8) != virtual || r.loadU32(12) != bytes ||
        r.loadU32(16) != flashMHz || r.loadU32(20) != flashProfile || r.loadU32(24) != flashTiming || r.loadU32(28) != base ||
        r.loadU32(32) != repetitions || r.loadU32(36) != expectedPhysicalBytes || r.loadU32(44) != cacheKiB || r.loadU32(48) != lineBytes) return 2
    val cache=nativeBufferAt(root+64,32);val cold=nativeBufferAt(root+96,64);val calibration=nativeBufferAt(root+160,340)
    val bus=nativeBufferAt(root+500,16);val activation=nativeBufferAt(root+516,16);val mapping=nativeBufferAt(root+640,total-640)
    while (r.loadU32(4) < 11) {
        val stage=r.loadU32(4);var status=1
        if (stage == 1) {
            status=s3PsramCacheMappingBeginOwned(cache,true)
            if (status == 1 && cacheKiB != 0) status=s3PsramCacheGeometryOwned(cacheKiB,lineBytes,true)
        }
        else if (stage == 2) status=s3PsramColdOwned(cold,nativeBufferAt(root+532,8),nativeBufferAt(root+540,100),0,flashProfile != 0,base,true,true,true)
        else if (stage == 3) { if (s3PsramBootPhysicalBytes(cold) != expectedPhysicalBytes) status=6 }
        else if (stage == 4) {
            val baseline=cold.loadU32(48)
            status=s3PsramCalibrate80Owned(calibration,0,expectedPhysicalBytes,repetitions,flashProfile != 0,base,baseline&255,(baseline>>>8)&255,true,true)
        } else if (stage == 5) status=s3PsramCalibratedFinal80Owned(calibration,flashMHz,flashProfile,flashTiming,true,true)
        else if (stage == 6) status=s3PsramMmuMapOwned(mapping,virtual,0,bytes,expectedPhysicalBytes,true)
        else if (stage == 7) status=s3PsramCacheBusOpenOwned(bus,true)
        else if (stage == 8) {
            status=s3PsramCacheMappingEndOwned(cache,true)
            if (status == 5) status=1 else if (status == 1) status=2
        } else if (stage == 9) status=s3PsramCacheActivateOwned(activation,true)
        else status=s3PsramMappedVerifyOwned(calibration,mapping,true)
        if (status != 1) { r.storeU32(40,status);return status }
        r.storeU32(40,0);r.storeU32(4,stage+1)
    }
    return 1
}
