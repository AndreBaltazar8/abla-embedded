import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Both S3 DBUS gates in EXTMEM_DCACHE_CTRL1 bits1:0. The IDF logical core
// mapping is reversed for DBUS; opening BOTH deliberately avoids inferring a
// per-core mapping from the field names. ICACHE gates never touched.
//16B aligned internal owner:magic,phase,original low2bits,reserved0.
// phases1acquiring,2open,3restoring,4closed. Capture before first write.
// Caller owns both caches suspended/drained/invalidated, internal code/stack,
// both CPUs/IRQ/DMA excluded and final PSRAM profile+MMU valid before open.
// Opening gates is NOT cache resume or mapped-memory verification. Before
// close, caller again drains/invalidates and suspends caches/excludes users.
// Data-cache buses are shared with FLASH: keep exclusion until old state and
// mapping/clock consistency restored. No nested/copied owner restoration.
fun s3PsramCacheBusRecord(r: NativeBuffer): bool = r.hasAddressRange(0,16) && (r.addressValue()&3) == 0 && s3PsramCacheBusStorageSafe(r.addressValue(),16)
//1open,2invalid/proof,3not idle,4readback failure. Failure retains owner.
@section(".iram1.abla.s3PsramCacheBusOpen")
trusted fun s3PsramCacheBusOpenOwned(r: NativeBuffer,exclusiveSuspended: bool): int {
    if (!exclusiveSuspended || !s3PsramCacheBusRecord(r)) return 2
    val magic=r.loadU32(0)
    if (magic != 0 && (magic != 0x53334255 || (r.loadU32(4) != 1 && r.loadU32(4) != 2) || r.loadU32(8) > 3 || r.loadU32(12) != 0)) return 2
    if ((s3PsramCacheBusRead(0x600c4130)&0xffffff) != 0x1001) return 3
    if (magic == 0) {
        r.storeU32(8,s3PsramCacheBusRead(0x600c4004)&3);r.storeU32(12,0)
        r.storeU32(0,0x53334255);r.storeU32(4,1)
    }
    val value=s3PsramCacheBusRead(0x600c4004)&0xfffffffc
    s3PsramCacheBusWrite(0x600c4004,value)
    if (s3PsramCacheBusRead(0x600c4004) != value) return 4
    r.storeU32(4,2);return 1
}
//5closed,2invalid/proof,3not idle,4readback failure. Restore only owned bits.
@section(".iram1.abla.s3PsramCacheBusClose")
trusted fun s3PsramCacheBusCloseOwned(r: NativeBuffer,exclusiveSuspended: bool): int {
    if (!exclusiveSuspended || !s3PsramCacheBusRecord(r) || r.loadU32(0) != 0x53334255 ||
        r.loadU32(4) < 1 || r.loadU32(4) > 4 || r.loadU32(8) > 3 || r.loadU32(12) != 0) return 2
    if (r.loadU32(4) == 4) return 5
    if ((s3PsramCacheBusRead(0x600c4130)&0xffffff) != 0x1001) return 3
    r.storeU32(4,3)
    val value=(s3PsramCacheBusRead(0x600c4004)&0xfffffffc)|r.loadU32(8)
    s3PsramCacheBusWrite(0x600c4004,value)
    if (s3PsramCacheBusRead(0x600c4004) != value) return 4
    r.storeU32(4,4);return 5
}
