// IDF's31 ordered relative-delay candidates, without a retained table.
fun p4PsramTuningDataDelay(index: int): int = if (index < 0 || index > 30) -1 else if (index <= 15) 0 else index-15
fun p4PsramTuningDqsDelay(index: int): int = if (index < 0 || index > 30) -1 else if (index < 15) 15-index else 0
// Select lower midpoint of longest nonwrapping pass run; ties choose first.
// No fallback to candidate0 when no qualifying run exists. Caller still must
// retest selected candidate and separately validate full data width/clock.
fun p4PsramTuningBestWindow(passes: int,count: int,minimum: int): int {
    if (passes < 0 || passes > 2147483647 || count < 1 || count > 31 || minimum < 1 || minimum > count) return -1
    var bits=passes; var index=0; var run=0; var best=0; var start=0
    while (index < count) {
        if ((bits&1) != 0) { run=run+1; if (run > best) { best=run; start=index-run+1 } } else run=0
        bits=bits>>>1; index=index+1
    }
    if (bits != 0 || best < minimum) return -1
    return start+((best-1)>>>1)
}
