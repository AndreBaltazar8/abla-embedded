import "./clock_p4_sequence.ab"
import "./mapped_esp32p4.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
@export("p4PsramClockRead")
trusted fun p4PsramClockReadHook(offset: int): int = mmioLoadU32(0x500e6000+offset)
@export("p4PsramClockWrite")
trusted fun p4PsramClockWriteHook(offset: int,value: int): void { mmioStoreU32(0x500e6000+offset,value); return }
