import "./mmu_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
@export("s3PsramMmuStorageSafe")
fun s3PsramMmuStorageSafeHook(address: int,length: int): bool = address >= 0x3fc88000 && length > 0 && address <= 0x3fd00000-length
@export("s3PsramMmuRead")
trusted fun s3PsramMmuReadHook(entry: int): int = mmioLoadU32(0x600c5000+entry*4)
@export("s3PsramMmuWrite")
trusted fun s3PsramMmuWriteHook(entry: int,value: int): void { mmioStoreU32(0x600c5000+entry*4,value);return }
