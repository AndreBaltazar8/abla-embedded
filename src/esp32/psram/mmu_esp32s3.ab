import "./mmu_s3_sequence.ab"
import "abla/unsafe/mmio"
fun s3PsramMmuStorageSafe(address: int,length: int): bool = address >= 0x3fc88000 && length > 0 && address <= 0x3fd00000-length
trusted fun s3PsramMmuRead(entry: int): int = mmioLoadU32(0x600c5000+entry*4)
trusted fun s3PsramMmuWrite(entry: int,value: int): void { mmioStoreU32(0x600c5000+entry*4,value);return }
