import "./command_p4_sequence.ab"
import "abla/unsafe/native"
import "abla/unsafe/mmio"
// Caller additionally proves these SRAM spans are outside revision-specific
// cache/ROM/bootloader reservations and other live owners (linker lifetime).
fun p4PsramCommandStorageSafe(address: int,length: int): bool =
    address >= 0x4ff00000 && length > 0 && address <= 0x4ffc0000-length
trusted fun p4PsramCommandReady(): bool =
    (mmioLoadU32(0x5008e03c)&1) == 0 && (mmioLoadU32(0x5008f000)&0x400f0) == 0
// ESP-IDF6 ROM jump table, same addresses in base and ECO5 table. No imports
// of SDK/library symbols. Descriptor pointers and narrow C args use RV32 ABI.
trusted fun p4PsramRomMode(unit: int,mode: int): void = callNativeVoidI32I32(0x4fc00110,unit,mode)
trusted fun p4PsramRomConfigure(unit: int,descriptor: int): void = callNativeVoidI32I32(0x4fc00108,unit,descriptor)
trusted fun p4PsramRomStart(unit: int,rx: int,length: int,cs: int,writeErase: bool): void =
    callNativeVoidI32I32I32I32I32(0x4fc0010c,unit,rx,length,cs,if (writeErase) 1 else 0)
