import "./command_p4_sequence.ab"
import "abla/unsafe/native"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
// Caller additionally proves these SRAM spans are outside revision-specific
// cache/ROM/bootloader reservations and other live owners (linker lifetime).
@export("p4PsramCommandStorageSafe")
fun p4PsramCommandStorageSafeHook(address: int,length: int): bool =
    address >= 0x4ff00000 && length > 0 && address <= 0x4ffc0000-length
@export("p4PsramCommandReady")
trusted fun p4PsramCommandReadyHook(): bool =
    (mmioLoadU32(0x5008e03c)&1) == 0 && (mmioLoadU32(0x5008f000)&0x400f0) == 0
// ESP-IDF6 ROM jump table, same addresses in base and ECO5 table. No imports
// of SDK/library symbols. Descriptor pointers and narrow C args use RV32 ABI.
@export("p4PsramRomMode")
trusted fun p4PsramRomModeHook(unit: int,mode: int): void = callNativeVoidI32I32(0x4fc00110,unit,mode)
@export("p4PsramRomConfigure")
trusted fun p4PsramRomConfigureHook(unit: int,descriptor: int): void = callNativeVoidI32I32(0x4fc00108,unit,descriptor)
@export("p4PsramRomStart")
trusted fun p4PsramRomStartHook(unit: int,rx: int,length: int,cs: int,writeErase: bool): void =
    callNativeVoidI32I32I32I32I32(0x4fc0010c,unit,rx,length,cs,if (writeErase) 1 else 0)
