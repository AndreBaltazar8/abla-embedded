import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Explicit DCache activation for cold boot; separate from restoration of
// original cache-enable/autoload state.16B owner:magic,phase,wasEnabled,0.
// Caller proves configured DCache geometry, invalidated tags, mapped PSRAM,
// valid clocks/timing and gates, both CPUs/IRQ/DMA quiesced, internal code/
// stack/owner. Enable uses autoload0 for newly activated cache only. Already
// active caches (including their autoload configuration) are not modified.
// Phases1enable,2wait,3open,4writeback,5disable,6wait,7closed.
// Close after new activation writes dirty data back under the SAME valid
// mapping BEFORE disabling/invalidation. Caller must not unmap beforehand.
// ROM waits may be unbounded; caller retains watchdog recovery. Pending polls
// never repeat completed ROM calls. Failures retain all external exclusions.
fun s3PsramCacheActivateRecord(r: NativeBuffer): bool = r.hasAddressRange(0,16) && (r.addressValue()&3) == 0 && s3PsramCacheMappingStorageSafe(r.addressValue(),16)
@section(".iram1.abla.s3PsramCacheActivate")
trusted fun s3PsramCacheActivateOwned(r: NativeBuffer,configuredMappedExclusive: bool): int {
    if (!configuredMappedExclusive || !s3PsramCacheActivateRecord(r)) return 2
    if (r.loadU32(0) == 0) {
        val old=s3PsramCacheMappingRead(0x600c4000)&1
        r.storeU32(0,0x53334341);r.storeU32(4,1);r.storeU32(8,old);r.storeU32(12,0)
    } else if (r.loadU32(0) != 0x53334341 || r.loadU32(4) < 1 || r.loadU32(4) > 3 || r.loadU32(8) > 1 || r.loadU32(12) != 0) return 2
    if (r.loadU32(4) == 1) {
        if (r.loadU32(8) == 0) s3PsramCacheMappingEnable(false,0)
        r.storeU32(4,2)
    }
    if ((s3PsramCacheMappingRead(0x600c4000)&1) == 0) return 3
    r.storeU32(4,3);return 1
}
//5closed,2invalid/proof,3pending. Close also accepts partially opened owner.
@section(".iram1.abla.s3PsramCacheDeactivate")
trusted fun s3PsramCacheDeactivateOwned(r: NativeBuffer,oldMappingStillValidExclusive: bool): int {
    if (!oldMappingStillValidExclusive || !s3PsramCacheActivateRecord(r) || r.loadU32(0) != 0x53334341 ||
        r.loadU32(4) < 1 || r.loadU32(4) > 7 || r.loadU32(8) > 1 || r.loadU32(12) != 0) return 2
    if (r.loadU32(4) == 7) return 5
    if (r.loadU32(8) == 1) { r.storeU32(4,7);return 5 }
    if (r.loadU32(4) < 4) r.storeU32(4,4)
    if (r.loadU32(4) == 4) {
        // Even if ENABLE readback is delayed, the completed enable ROM call
        // may have admitted accesses. Drain before disabling; do not infer
        // absence of dirty data from a transient disabled status bit.
        s3PsramCacheMappingWriteback();r.storeU32(4,5)
    }
    if (r.loadU32(4) == 5) {
        s3PsramCacheMappingDisable(false);r.storeU32(4,6)
    }
    if ((s3PsramCacheMappingRead(0x600c4000)&1) != 0 || ((s3PsramCacheMappingRead(0x600c4130)>>>12)&4095) != 1) return 3
    r.storeU32(4,7);return 5
}
