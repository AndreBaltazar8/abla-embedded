import "./pins_p4_sequence.ab"
import "./timing_p4_sequence.ab"
// AP HEX controller preparation under the SAME retained clock/pad/controller
// lifetime. Pins precede bus clocks/DLL settings. CS4/4/delay3 and page2048
// match the AP driver. Caller verifies source speed, voltage and chip timing;
// this is not chip initialization, memory training, or cache/AXI activation.
// 1prepared2invalid3stale owner; failures preserve subsystem status low16 and
// identify subsystem high16 (1pins,2timing). No rollback or ownership transfer.
trusted fun P4PsramClockOwner.prepareApControllerOwned(mappedDivider: int,commandDivider: int,drive: int,polls: int): int {
    if (mappedDivider < 1 || mappedDivider > 256 || commandDivider < 1 || commandDivider > 256 ||
        drive < 0 || drive > 3 || polls < 1 || polls > 1000000) return 2
    if (!this.ready() || this < 0 || this > 0x1fffff ||
        (p4PsramClockRead(48)&0x00ff3000) != (((this.divider()-1)<<16)|(this.source()<<12))) return 3
    val pins=p4PsramPinsConfigureOwned(drive,true,polls)
    if (pins != 1) return (1<<16)|pins
    val timing=p4PsramTimingConfigureOwned(mappedDivider,commandDivider,4,4,3,2048,true,polls)
    return if (timing == 1) 1 else (2<<16)|timing
}
