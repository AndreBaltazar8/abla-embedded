import "./probe_p4_sequence.ab"
import "./cold_esp32p4.ab"
// Cold owner remains phase8 regardless of probe result: this does not promote
// untrained memory into a usable allocator/framebuffer/cache mapping.
trusted fun p4PsramColdProbeOwned(record: NativeBuffer,byteOffset: int,scratch: NativeBuffer,work: NativeBuffer): int {
    if (!p4PsramColdStorage(record)) return 2
    if (record.loadU32(0) != 0x50345053 || record.loadU32(4) != 8) return 3
    if (!p4PsramColdDisjoint(record.addressValue(),48,scratch.addressValue(),64) || !p4PsramColdDisjoint(record.addressValue(),48,work.addressValue(),100)) return 2
    val identity=P4PsramIdentity(record.loadU32(24)|(record.loadU32(28)<<32))
    return p4PsramProbeOwned(identity,record.loadU32(32),byteOffset,scratch,work)
}
