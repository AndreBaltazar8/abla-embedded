import "abla/runtime/scalar"
// Reject inconsistent startup snapshots, not proof of electrical PLL lock,
// cold memory, DMA ownership, flash timing or valid old cache mappings.
// Cold CPU0 entry requires CPU1 held in reset (stall alone may hold locks).
// Bits:1wrong core,2IRQ state,4PLL/system state,8peer not held reset.
fun s3PsramStartupMismatch(core: int,status: int,enabled: int,sysclk: int,cpu: int,power: int,peer: int): int {
    var mismatch=if (core == 0) 0 else 1
    if ((status&15) != 15 || (status&16) != 0 || enabled != 0) mismatch=mismatch|2
    if (((sysclk>>>10)&3) != 1 || (cpu&4) == 0 || (cpu&3) == 3 || (power&0x540) != 0) mismatch=mismatch|4
    if ((peer&4) == 0) mismatch=mismatch|8
    return mismatch
}
