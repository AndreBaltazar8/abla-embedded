import "abla/runtime/scalar"
// MSPI1 PSRAM user-command mode, not SPI0 cached flash or SMEM configuration.
// Native rev0 set_op_mode(1,7), including its default mode-clear callback:
// CTRL clears previous read-width/mode bits; USER clears address-width bits.
// DTR must NOT zero DDR first: variable-dummy and byte-swap fields survive.
// Ordered RMWs match ROM4004db94 then4004dd2f. No mutable ROM-table dispatch.
// Caller owns idle MSPI1, clocks/pads and cache/peer/IRQ/DMA exclusion;
// entire continuation and stack internal. Hooks are barriered MMIO.
@section(".iram1.abla.s3PsramOpiDtr")
trusted fun s3PsramOpiDtrNativeOwned(): void {
    s3PsramOpiWrite(0x60002008,s3PsramOpiRead(0x60002008)&0xfe6f9c0f)
    s3PsramOpiWrite(0x60002018,s3PsramOpiRead(0x60002018)&0xffff0fff)
    s3PsramOpiWrite(0x60002008,s3PsramOpiRead(0x60002008)|0x2270)
    s3PsramOpiWrite(0x600020e0,s3PsramOpiRead(0x600020e0)&0xffffffef)
    s3PsramOpiWrite(0x600020e0,s3PsramOpiRead(0x600020e0)|1)
    return
}
