import "abla/runtime/scalar"
// Cold S3 DCache geometry per esp_config_data_cache_mode:32KiB uses DBANK1
// as low bank, no high bank;64KiB uses DBANK0+DBANK1. Four ways only, ROM
// enum0. Line sizes16/32/64 encode0/1/2. Occupy -> setmode -> invalidate.
// Caller relinquishes selected cache SRAM banks (including linker sections,
// heap, stack and ROM reservations), writes back old dirty data and disables
// BOTH caches, keeps all CPU/IRQ/DMA users excluded and executes internally
// outside those banks. This changes memory ownership, not just performance.
// No cache enable, MMU change, mode rollback or implied RAM availability.
// Invalidation may wait unbounded; watchdog ownership remains with caller.
//1configured/invalidated,2invalid/proof,3not disabled+idle,4bank/mode readback error.
@section(".iram1.abla.s3PsramCacheGeometry")
trusted fun s3PsramCacheGeometryOwned(kib: int,lineBytes: int,relinquishedBanksExclusive: bool): int {
    if (!relinquishedBanksExclusive || (kib != 32 && kib != 64) || (lineBytes != 16 && lineBytes != 32 && lineBytes != 64)) return 2
    if ((s3PsramCacheGeometryRead(0x600c4000)&1) != 0 || (s3PsramCacheGeometryRead(0x600c4060)&1) != 0 ||
        (s3PsramCacheGeometryRead(0x600c4130)&0xffffff) != 0x1001) return 3
    val size=if (kib == 64) 1 else 0
    val line=if (lineBytes == 16) 0 else if (lineBytes == 32) 1 else 2
    s3PsramCacheGeometryOccupy(if (kib == 32) 2 else 1,if (kib == 32) 0 else 2)
    // Bank-selection writes may be locked. CTRL0 readback alone cannot prove
    // SRAM ownership: reject before changing mode or invalidating wrong banks.
    if ((s3PsramCacheGeometryRead(0x600c1004)&240) != (if (kib == 32) 32 else 144) ||
        (s3PsramCacheGeometryRead(0x600c1014)&12) != (if (kib == 32) 4 else 0)) return 4
    s3PsramCacheGeometryMode(size,0,line)
    if ((s3PsramCacheGeometryRead(0x600c4000)&29) != ((size<<2)|(line<<3))) return 4
    s3PsramCacheGeometryInvalidate()
    if ((s3PsramCacheGeometryRead(0x600c4000)&29) != ((size<<2)|(line<<3))) return 4
    return 1
}
