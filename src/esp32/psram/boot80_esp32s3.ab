import "./boot80_s3_sequence.ab"
import "./cold_esp32s3.ab"
import "./calibrate80_esp32s3.ab"
import "./mapped_verify_esp32s3.ab"
import "./cache_mapping_esp32s3.ab"
import "./cache_bus_esp32s3.ab"
import "./cache_activate_esp32s3.ab"
import "./cache_geometry_esp32s3.ab"
fun s3PsramBootPhysicalBytes(cold: NativeBuffer): int {
    if (!cold.hasAddressRange(0,64) || cold.loadU32(0) != 0x5333434f || cold.loadU32(4) != 8) return 0
    val identity=s3PsramIdentityFrom(nativeBufferAt(cold.addressValue()+32,6))
    return if (identity.good()) identity.physicalBytes() else 0
}
