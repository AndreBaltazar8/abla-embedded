import "./din_s3_sequence.ab"
import "./flash_dummy_s3_sequence.ab"
import "./flash_restore_s3_sequence.ab"
import "./cached_phases_s3_sequence.ab"
import "abla/runtime/scalar"
// Final core160/PSRAM80 OPI profile AFTER successful command calibration.
// flashTiming/psramTiming packed mode[2:0],number[4:3],extra[7:5]. Caller
// supplies measured PSRAM and independently valid FLASH timing, not the last
// candidate left by a sweep. flashProfile0 quad,1 MXIC OPI STR,2 MXIC OPI DTR.
// Stable480PLL, actual chip/MR0/nonECC/pads, internal-only execution and total
// cache/peer/IRQ/DMA exclusion remain caller-owned; MMU/cache readiness is NOT
// established here. No ROM commands or cache resume. Partial failure retains
// all exclusion; retry reapplies complete idempotent profile with same args.
// 1installed;2preflight;otherwise low8 error, stage[15:8]:1clocks,2DIN,
// 3flashdummy,4flashrestore,5cached phases. Never releases partially set state.
@section(".iram1.abla.s3PsramFinal80")
trusted fun s3PsramFinal80Owned(flashMHz: int,flashProfile: int,flashTiming: int,psramTiming: int,base: int,original0: int,original1: int,stable480Pll: bool,exclusiveInternal: bool): int {
    if (!stable480Pll || !exclusiveInternal || (flashMHz != 20 && flashMHz != 40 && flashMHz != 80) ||
        flashProfile < 0 || flashProfile > 2 || flashTiming < 0 || flashTiming > 255 || psramTiming < 0 || psramTiming > 255 ||
        base < 0 || base > 63 || original0 < 0 || original0 > 255 || original1 < 0 || original1 > 255) return 2
    val extra=flashTiming>>>5
    if (flashProfile == 0 && (base+original0+extra > 63 || base+original1+extra > 63 || !s3FlashLegacyPointerValid(s3FlashLegacyPointer()))) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 259
    val divider=if (flashMHz == 20) 8 else if (flashMHz == 40) 4 else 2
    val clock=((divider-1)<<16)|((divider/2-1)<<8)|(divider-1)
    var step=0
    while (step < 4) {
        val address=if (step == 0) 0x600030ec else if (step == 1) 0x60003014 else if (step == 2) 0x60002014 else 0x60003050
        val value=if (step == 0) (s3PsramCsRead(address)&0xfffffffc)|2 else if (step == 3) 0x10001 else clock
        s3PsramCsWrite(address,value)
        if (s3PsramCsRead(address) != value) return 260
        step=step+1
    }
    var status=s3PsramDinOwned(flashTiming&7,(flashTiming>>>3)&3,psramTiming&7,(psramTiming>>>3)&3,psramTiming>>>5,true)
    if (status != 1) return 512|status
    status=s3FlashDummyOwned(flashProfile != 0,base,original0,original1,extra,true)
    if (status != 1) return 768|status
    status=s3PsramFlashRestoreOwned(flashProfile,true)
    if (status != 1) return 1024|status
    status=s3PsramCachedPhasesOwned(true)
    if (status != 1) return 1280|status
    return 1
}
