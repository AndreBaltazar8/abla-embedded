import "abla/runtime/scalar"
// Writeback ALL dirty DCache items while OLD mapping/timing remain valid.
// This does not invalidate tags or disable cache. Exact ROM writeback_items
// (0,0) register sequence; callers serialize against every other sync user.
@section(".iram1.abla.s3PsramCacheWriteback")
trusted fun s3PsramCacheWritebackNativeOwned(): void {
    s3PsramCacheMappingWrite(0x600c402c,0)
    s3PsramCacheMappingWrite(0x600c4030,s3PsramCacheMappingRead(0x600c4030)&0xff800000)
    s3PsramCacheMappingWrite(0x600c4028,s3PsramCacheMappingRead(0x600c4028)|2)
    while ((s3PsramCacheMappingRead(0x600c4028)&8) == 0) {}
    return
}
// Native S3 whole-cache invalidate, matching ROM invalidate_items(0,0).
// SYNC_SIZE low23=0 means all items. Preserve high9 bits and other SYNC_CTRL
// fields. I/D completion bits differ: Ibit1, Dbit3. No implicit writeback.
// Caller owns cache/MSPI/users and valid internal code/stack; waits preserve
// ROM's unbounded hardware-completion semantics (watchdog policy is caller's).
@section(".iram1.abla.s3PsramCacheInvalidate")
trusted fun s3PsramCacheInvalidateNativeOwned(instruction: bool): void {
    val control=if (instruction) 0x600c4088 else 0x600c4028
    s3PsramCacheMappingWrite(control+4,0)
    s3PsramCacheMappingWrite(control+8,s3PsramCacheMappingRead(control+8)&0xff800000)
    s3PsramCacheMappingWrite(control,s3PsramCacheMappingRead(control)|1)
    val done=if (instruction) 2 else 8
    while ((s3PsramCacheMappingRead(control)&done) == 0) {}
    return
}
// Full Disable_I/DCache sequence, NOT tag-preserving sleep Suspend.
// Clear enable, suspend autoload and clear its buffer, wait preload complete,
// invalidate all tags, then wait cache idle. Returns exact original bit2 token.
// No mutable ROM-table dispatch; this is an Abla-owned controller operation.
// Retain all ownership while waiting, with OLD mapping valid for prior
// writeback. No skipping a failed/busy stage and no invented success.
@section(".iram1.abla.s3PsramCacheDisable")
trusted fun s3PsramCacheDisableNativeOwned(instruction: bool): int {
    val control=if (instruction) 0x600c4060 else 0x600c4000
    s3PsramCacheMappingWrite(control,s3PsramCacheMappingRead(control)&0xfffffffe)
    val autoload=if (instruction) 0x600c40a0 else 0x600c404c
    val token=s3PsramCacheMappingRead(autoload)&4
    if (token != 0) {
        s3PsramCacheMappingWrite(autoload,s3PsramCacheMappingRead(autoload)&0xfffffffb)
        s3PsramCacheMappingWrite(autoload,s3PsramCacheMappingRead(autoload)|512)
    }
    while ((s3PsramCacheMappingRead(autoload)&8) == 0) {}
    s3PsramCacheMappingWrite(autoload,s3PsramCacheMappingRead(autoload)&0xfffffdff)
    val preload=if (instruction) 0x600c4094 else 0x600c4040
    while ((s3PsramCacheMappingRead(preload)&2) == 0) {}
    s3PsramCacheInvalidateNativeOwned(instruction)
    while (((s3PsramCacheMappingRead(0x600c4130)>>>(if (instruction) 0 else 12))&4095) != 1) {}
    return token
}
