import "./mmu_p4_sequence.ab"
import "./clock_esp32p4.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
@export("p4PsramMmuEncryptionEnabled")
trusted fun p4PsramMmuEncryptionEnabledHook(): bool {
    val count=(mmioLoadU32(0x5012d034)>>>18)&7
    return ((count^(count>>>1)^(count>>>2))&1) != 0
}
