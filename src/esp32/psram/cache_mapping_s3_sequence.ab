import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Mapping-change cache owner, distinct from sleep Suspend/Resume (tags kept).
//32B internal aligned record:magic,phase,originalEnabled(Ibit0/Dbit1),Iauto,
// Dauto,reserved12B. Zero magic initially. Native Disable invalidates tags.
// Writeback occurs BEFORE disabling or changing clocks/mapping, only if D
// originally enabled. Caller has quiesced both CPUs/IRQ/DMA/all memory users,
// valid OLD memory clocks/mapping, internal stack/code/record and watchdog.
// Hardware operations may wait unbounded. Subsequent polling is nonblocking; no retry
// ever repeats a completed disable or overwrites saved autoload state.
// Phases1writeback,2Idisable,3Iwait,4Ddisable,5Dwait,6disabled,
// 7Ienable,8Icheck,9Denable,10Dcheck,11closed. Original disabled caches stay off.
fun s3PsramCacheMappingRecord(r: NativeBuffer): bool = r.hasAddressRange(0,32) && (r.addressValue()&3) == 0 && s3PsramCacheMappingStorageSafe(r.addressValue(),32)
fun s3PsramCacheMappingIdle(instruction: bool): bool =
    ((s3PsramCacheMappingRead(0x600c4130)>>>(if (instruction) 0 else 12))&4095) == 1
//1disabled/invalidated,2invalid/proof,3pending hardware. Keep ownership.
@section(".iram1.abla.s3PsramCacheMappingBegin")
trusted fun s3PsramCacheMappingBeginOwned(r: NativeBuffer,exclusiveInternal: bool): int {
    if (!exclusiveInternal || !s3PsramCacheMappingRecord(r)) return 2
    if (r.loadU32(0) == 0) {
        val flags=(s3PsramCacheMappingRead(0x600c4060)&1)|((s3PsramCacheMappingRead(0x600c4000)&1)<<1)
        r.storeU32(0,0x5333434d);r.storeU32(4,1);r.storeU32(8,flags)
        var offset=12
        while (offset < 32) { r.storeU32(offset,0);offset=offset+4 }
    } else if (r.loadU32(0) != 0x5333434d || r.loadU32(4) < 1 || r.loadU32(4) > 6 || r.loadU32(8) > 3) return 2
    while (r.loadU32(4) < 6) {
        val phase=r.loadU32(4)
        if (phase == 1) { if ((r.loadU32(8)&2) != 0) s3PsramCacheMappingWriteback() }
        else if (phase == 2) r.storeU32(12,s3PsramCacheMappingDisable(true))
        else if (phase == 4) r.storeU32(16,s3PsramCacheMappingDisable(false))
        else {
            val instruction=phase == 3
            if ((s3PsramCacheMappingRead(if (instruction) 0x600c4060 else 0x600c4000)&1) != 0 || !s3PsramCacheMappingIdle(instruction)) return 3
        }
        r.storeU32(4,phase+1)
    }
    return 1
}
//5restored,2invalid/proof,3pending. Caller proves final/old MMU, gates,
// clocks and timing consistent BEFORE calling; no rollback implied here.
@section(".iram1.abla.s3PsramCacheMappingEnd")
trusted fun s3PsramCacheMappingEndOwned(r: NativeBuffer,memoryReadyExclusiveInternal: bool): int {
    if (!memoryReadyExclusiveInternal || !s3PsramCacheMappingRecord(r) || r.loadU32(0) != 0x5333434d ||
        r.loadU32(4) < 6 || r.loadU32(4) > 11 || r.loadU32(8) > 3 || r.loadU32(20) != 0 || r.loadU32(24) != 0 || r.loadU32(28) != 0) return 2
    if (r.loadU32(4) == 6) r.storeU32(4,7)
    while (r.loadU32(4) < 11) {
        val phase=r.loadU32(4);val instruction=phase <= 8
        val enabled=(r.loadU32(8)&(if (instruction) 1 else 2)) != 0
        if (phase == 7 || phase == 9) {
            if (enabled) s3PsramCacheMappingEnable(instruction,r.loadU32(if (instruction) 12 else 16))
        } else if ((s3PsramCacheMappingRead(if (instruction) 0x600c4060 else 0x600c4000)&1) != (if (enabled) 1 else 0)) return 3
        r.storeU32(4,phase+1)
    }
    return 5
}
