import "../sdk/raw_buffer.ab"
// DESTRUCTIVE mapped, exclusively owned, whole64KB-page range,1..1024pages.
// Same hardware/ROM/clock/internal execution/watchdog prerequisites as the
// single-page verifier. No map/AXI activation or CPU bus-fault recovery.
// First38patterns per page, THEN address-derived words written to ALL pages
// before flushing/reading ANY page. This catches cross-page physical aliases
// that sequential single-page tests cannot detect. Final contents=addresses.
// Internal24B report: page0, childStatus4, pattern8, offset12,expected16,actual20.
// Child pattern38 indicates cross-page pass, offset then relative to whole span.
// Return1pass2invalid3inactive4page failure5flush failure6cross-page mismatch.
trusted fun p4PsramMappedRangeVerifyOwned(buffer: NativeBuffer,bytes: int,line: int,report: NativeBuffer,polls: int): int {
    val base=buffer.addressValue()
    if (base < 0x48000000 || base >= 0x4c000000 || (base&65535) != 0 || bytes < 65536 ||
        (bytes&65535) != 0 || bytes > 0x4c000000-base || !buffer.hasAddressRange(0,bytes) ||
        (line != 64 && line != 128) || !report.hasAddressRange(0,24) || (report.addressValue()&3) != 0 ||
        !p4PsramCommandStorageSafe(report.addressValue(),24) || polls < 1 || polls > 1000000) return 2
    if (!p4PsramVerifyReady(line)) return 3
    var offset=0
    while (offset < 24) { report.storeU32(offset,0); offset=offset+4 }
    offset=0
    while (offset < bytes) {
        report.storeU32(0,offset>>>16)
        val result=p4PsramMappedVerifyOwned(nativeBufferAt(base+offset,65536),65536,line,nativeBufferAt(report.addressValue()+8,16),polls)
        report.storeU32(4,result)
        if (result != 1) return 4
        offset=offset+65536
    }
    report.storeU32(8,38); report.storeU32(12,0); report.storeU32(16,0); report.storeU32(20,0)
    p4PsramVerifyFence()
    offset=0
    while (offset < bytes) { p4PsramVerifyWrite(base+offset,base+offset); offset=offset+4 }
    p4PsramVerifyFence()
    val flushed=p4PsramVerifyFlush(buffer,bytes,line,polls)
    report.storeU32(4,flushed)
    if (flushed != 1) return 5
    p4PsramVerifyFence()
    offset=0
    while (offset < bytes) {
        val actual=p4PsramVerifyRead(base+offset)
        if (actual != base+offset) {
            report.storeU32(0,offset>>>16); report.storeU32(12,offset)
            report.storeU32(16,base+offset); report.storeU32(20,actual); return 6
        }
        offset=offset+4
    }
    p4PsramVerifyFence(); return 1
}
