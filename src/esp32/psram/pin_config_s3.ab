import "abla/runtime/scalar"
// ROM get_spiconfig/get_wp_pad share a36-bit eFuse bundle: SYS1 high16,
// SYS2 low20. Only WHOLE-bundle allzero/allone is the default sentinel.
// Return packed normalized FLASH low30 + WP high6. Default WP is63 (the
// configured-pin decoder maps it to GPIO28). Upper OPI bits are unrelated.
fun s3MspiFlashPinConfig(sys1: int,sys2: int): int {
    val raw=((sys1>>>16)&65535)|((sys2&0xfffff)<<16)
    return if (raw == 0 || raw == 0xfffffffff) 0xfc0000000 else raw
}
// S3 esp_rom_efuse.c OPI patch: high18bits from SYS3, low12 from SYS2.
// All-zero/all-one OPI config denotes default wiring. No fuse writes.
fun s3MspiOpiConfig(sys2: int,sys3: int): int {
    val packed=((sys2>>>20)&4095)|((sys3&0x3ffff)<<12)
    return if (packed == 0x3fffffff) 0 else packed
}
// Roles CLK,Q(D1),D(D0),CS0,HD(D3),WP(D2),DQS,D4,D5,D6,D7,CS1.
// Defaults from esp_hal_gpspi/esp32s3/soc/spi_pins.h. CS1 is fixedGPIO26
// for the current OPI PSRAM controller, not an eFuse-remappable role here.
fun s3MspiDefaultPin(role: int): int {
    if (role == 0) return 30
    if (role == 1) return 31
    if (role == 2) return 32
    if (role == 3) return 29
    if (role == 4) return 27
    if (role == 5) return 28
    if (role == 6) return 37
    if (role >= 7 && role <= 10) return role+26
    if (role == 11) return 26
    return -1
}
// flashConfig/wp are ROM-normalized getter results. WP sentinel63 is special;
// other roles use the WHOLE zero config as default, not each zero pad field.
// Preserve custom0/63 fields exactly; caller decides whether pins are usable.
// -1 invalid arguments. This decodes configuration, not physical wiring proof.
fun s3MspiConfiguredPin(role: int,flashConfig: int,wp: int,opiConfig: int): int {
    if (role < 0 || role > 11 || flashConfig < 0 || flashConfig > 0x3fffffff || wp < 0 || wp > 63 || opiConfig < 0 || opiConfig > 0x3fffffff) return -1
    if (role == 11) return 26
    if (role == 5) return if (wp == 63) 28 else wp
    val config=if (role < 5) flashConfig else opiConfig
    if (config == 0) return s3MspiDefaultPin(role)
    return (config>>>((if (role < 5) role else role-6)*6))&63
}
