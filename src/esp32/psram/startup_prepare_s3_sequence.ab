import "../power/memory_supply_s3.ab"
// Default-wired S3 OPI PSRAM startup admission and optional cold PLL setup.
// Caller owns CPU/interrupt exclusion, memory pads, analog/APB consumers,
// watchdog recovery, internal continuation/stack and actual electrical safety.
// A configured supply is NOT a voltage measurement or board-rating proof.
// All read-only admission precedes clock mutation. No voltage/pad writes.
// Ready clocks still require the caller's calibration/ownership proof.
// 2 invalid/proof; 0x20000|mask pad routing; 0x40000|mask CPU/clock/peer;
// 0x80000|status clock setup; 0x100000 configured supply mismatch/off.
// Errors retain ownership; no automatic rollback or retry of hardware.
@section(".iram1.abla.s3PsramStartupPrepare")
trusted fun s3PsramStartupPrepareOwned(memoryMillivolts: int,polls: int,prepareClock: bool,owned: bool): int {
    if (!owned || (memoryMillivolts != 1800 && memoryMillivolts != 3300) || polls < 1 || polls > 1000000) return 2
    val mismatch=s3PsramStartupHardwareMismatch()
    if ((mismatch&11) != 0 || (!prepareClock && mismatch != 0)) return 0x40000|mismatch
    if (!esp32S3MemorySupplyReadOwned().matchesConfiguredMillivolts(memoryMillivolts)) return 0x100000
    val pads=s3MspiDefaultBootPadMismatch()
    if (pads < 0) return 0x20000
    if (pads != 0) return 0x20000|pads
    if (prepareClock) {
        val prepared=esp32S3StartupClock480Owned(polls,true)
        if (prepared != 1) return 0x80000|prepared
        val after=s3PsramStartupHardwareMismatch()
        if (after != 0) return 0x40000|after
    }
    return 1
}
