import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Verify the64B calibration reference THROUGH mapped DBUS/cache, not SPI1.
// Caller owns immutable calibration/MMU records and the same physical memory
// lifetime, completed final timing, invalidated stale tags BEFORE mapping,
// enabled DCache, opened both DBUS gates, and still excludes all other users.
// This is a read-only sentinel check, NOT a full RAM test or allocation proof.
// MMU owner32+4*pages must be fully mapped, cover physical reference64B, and
// every owned MMU entry must still match. No memory access before all guards.
//1reference matches,2invalid records/range/proof,3hardware mapping/cache not
// ready,5reference mismatch. No writes, rollback or releasing ownership.
@section(".iram1.abla.s3PsramMappedVerify")
trusted fun s3PsramMappedVerifyOwned(calibration: NativeBuffer,mapping: NativeBuffer,exclusiveFreshMapping: bool): int {
    if (!exclusiveFreshMapping || s3PsramCalibration80Candidate(calibration) < 0 ||
        !mapping.hasAddressRange(0,32) || (mapping.addressValue()&3) != 0 || !s3PsramMmuStorageSafe(mapping.addressValue(),32)) return 2
    val count=mapping.loadU32(12);val first=mapping.loadU32(8);val page=mapping.loadU32(16)
    if (mapping.loadU32(0) != 0x53334d4d || mapping.loadU32(4) != 2 || count < 1 || count > 512 || first > 512-count ||
        page > 16384-count || mapping.loadU32(20) != count || mapping.loadU32(24) != calibration.loadU32(12) || mapping.loadU32(28) != 0 ||
        !mapping.hasAddressRange(0,32+count*4) || !s3PsramMmuStorageSafe(mapping.addressValue(),32+count*4)) return 2
    val c=calibration.addressValue();val m=mapping.addressValue()
    if (c < m+32+count*4 && m < c+340) return 2
    val physical=page*65536;val reference=calibration.loadU32(8);val length=count*65536
    if (physical > calibration.loadU32(12)-length || reference < physical || reference-physical > length-64) return 2
    var index=0
    while (index < count) {
        if ((mapping.loadU32(32+index*4)&16384) == 0) return 2
        if (s3PsramMmuRead(first+index) != (32768+page+index)) return 3
        index=index+1
    }
    if ((s3PsramMappedRead(0x600c4000)&1) == 0 || (s3PsramMappedRead(0x600c4004)&3) != 0) return 3
    val virtual=0x3c000000+first*65536+reference-physical
    index=0
    while (index < 64) {
        if (s3PsramMappedRead(virtual+index) != 0xa5ff005a) return 5
        index=index+4
    }
    return 1
}
