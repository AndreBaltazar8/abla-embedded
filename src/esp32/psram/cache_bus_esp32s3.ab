import "./cache_bus_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
@export("s3PsramCacheBusStorageSafe")
fun s3PsramCacheBusStorageSafeHook(address: int,length: int): bool = address >= 0x3fc88000 && length > 0 && address <= 0x3fd00000-length
@export("s3PsramCacheBusRead")
trusted fun s3PsramCacheBusReadHook(address: int): int = mmioLoadU32(address)
@export("s3PsramCacheBusWrite")
trusted fun s3PsramCacheBusWriteHook(address: int,value: int): void = mmioStoreU32(address,value)
