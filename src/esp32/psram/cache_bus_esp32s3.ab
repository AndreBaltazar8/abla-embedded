import "./cache_bus_s3_sequence.ab"
import "abla/unsafe/mmio"
fun s3PsramCacheBusStorageSafe(address: int,length: int): bool = address >= 0x3fc88000 && length > 0 && address <= 0x3fd00000-length
trusted fun s3PsramCacheBusRead(address: int): int = mmioLoadU32(address)
trusted fun s3PsramCacheBusWrite(address: int,value: int): void = mmioStoreU32(address,value)
