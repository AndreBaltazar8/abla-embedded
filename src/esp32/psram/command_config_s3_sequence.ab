import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Native MSPI descriptor configuration, matching rev0 ROM4004dd9c.
// Internal low-level contract: unit0/1, owned immutable descriptor32B,
// command0..16 bits, address0..32 bits with valid address word if nonzero,
// TX/RX0..512 bits, dummy0..64. Non-null TX has ceil(bits/32) owned words;
// null TX deliberately reuses existing FIFO. RX pointer is not read here.
// Caller excludes cache/peers/IRQ/DMA, runs internally and retains watchdog.
// Waits on the ENTIRE CMD word, as ROM does, not just transaction bits.
// Does not launch transfers or modify absent-phase address/FIFO contents.
@section(".iram1.abla.s3PsramCommandConfig")
trusted fun s3PsramCommandConfigNativeOwned(unit: int,descriptor: int): void {
    val base=0x60003000-unit*4096
    val d=nativeBufferAt(descriptor,32)
    while (s3PsramOpiRead(base) != 0) {}
    val command=d.loadU32(0)
    val commandBits=command>>>16
    if (commandBits != 0) {
        s3PsramOpiWrite(base+32,(s3PsramOpiRead(base+32)&0x0fffffff)|((commandBits-1)<<28))
        s3PsramOpiWrite(base+24,s3PsramOpiRead(base+24)|0x80000000)
        s3PsramOpiWrite(base+32,(s3PsramOpiRead(base+32)&0xffff0000)|(command&65535))
    } else {
        s3PsramOpiWrite(base+24,s3PsramOpiRead(base+24)&0x7fffffff)
        s3PsramOpiWrite(base+32,s3PsramOpiRead(base+32)&0x0fffffff)
    }
    val addressBits=d.loadU32(8)
    if (addressBits != 0) {
        s3PsramOpiWrite(base+28,(s3PsramOpiRead(base+28)&0x03ffffff)|((addressBits-1)<<26))
        s3PsramOpiWrite(base+24,s3PsramOpiRead(base+24)|0x40000000)
        s3PsramOpiWrite(base+4,nativeBufferAt(d.loadU32(4),4).loadU32(0))
        val misc=s3PsramOpiRead(base+60)
        s3PsramOpiWrite(base+60,if (addressBits == 32) misc|2 else misc&0xfffffffd)
    } else {
        s3PsramOpiWrite(base+24,s3PsramOpiRead(base+24)&0xbfffffff)
        s3PsramOpiWrite(base+28,s3PsramOpiRead(base+28)&0x03ffffff)
    }
    val txBits=d.loadU32(16)
    if (txBits != 0) {
        s3PsramOpiWrite(base+24,s3PsramOpiRead(base+24)|0x08000000)
        val tx=d.loadU32(12)
        if (tx != 0) {
            val words=(txBits+31)>>>5
            val fifo=nativeBufferAt(tx,words*4)
            var i=0
            while (i < words) { s3PsramOpiWrite(base+88+i*4,fifo.loadU32(i*4));i=i+1 }
        }
    } else s3PsramOpiWrite(base+24,s3PsramOpiRead(base+24)&0xf7ffffff)
    s3PsramOpiWrite(base+36,(s3PsramOpiRead(base+36)&0xfffffc00)|(if (txBits == 0) 0 else (txBits-1)&1023))
    val rxBits=d.loadU32(24)
    s3PsramOpiWrite(base+24,if (rxBits == 0) s3PsramOpiRead(base+24)&0xefffffff else s3PsramOpiRead(base+24)|0x10000000)
    s3PsramOpiWrite(base+40,(s3PsramOpiRead(base+40)&0xfffffc00)|(if (rxBits == 0) 0 else (rxBits-1)&1023))
    val dummy=d.loadU32(28)
    s3PsramOpiWrite(base+24,if (dummy == 0) s3PsramOpiRead(base+24)&0xdfffffff else s3PsramOpiRead(base+24)|0x20000000)
    s3PsramOpiWrite(base+28,(s3PsramOpiRead(base+28)&0xffffffc0)|(if (dummy == 0) 0 else (dummy-1)&63))
    return
}
