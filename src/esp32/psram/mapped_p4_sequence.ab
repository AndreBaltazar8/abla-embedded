// P4 SPIMEM2 mapped PSRAM controller (NOT flash SPIMEM0/1, not command MSPI3).
// Caller owns controller + clocks/pins/PSRAM, with both CPUs/cache/ETM/DMA
// consumers stopped. Code/constants/stack must be internal and all dirty
// PSRAM data written back before reconfiguration. No reset or cache operations
// here. Chip mode-register programming, MPLL/DLL setup and calibration are
// separate prerequisites, not inferred from these configuration readbacks.
// Status low8:1done2invalid3AXI active4idle timeout5readback; high8failedstage.
// Partial config stays owned; AXI enable is not attempted after failed config.
// Stage7 readback failure may mean partially enabled AXI: retain all leases.
// Neither
// successful configuration nor AXI enable proves external memory is working.
fun p4PsramMappedProfileValid(readDummy: int,writeDummy: int,polls: int): bool =
    readDummy >= 1 && readDummy <= 64 && writeDummy >= 1 && writeDummy <= 64 && polls >= 1 && polls <= 1000000
trusted fun p4PsramMappedField(offset: int,mask: int,value: int): bool {
    val next=(p4PsramMappedRead(offset)&(4294967295^mask))|value
    p4PsramMappedWrite(offset,next)
    return (p4PsramMappedRead(offset)&mask) == value
}
trusted fun p4PsramMappedWaitIdle(polls: int): bool {
    if (polls < 1 || polls > 1000000) return false
    var remaining=polls
    while (remaining > 0) {
        if ((p4PsramMappedRead(0)&0x400f0) == 0 && (p4PsramMappedRead(376)&0xfc000000) == 0xfc000000) return true
        remaining=remaining-1
    }
    return false
}
// AP/compatible synchronous DDR:16bit read0000/write8080,32bit address,
// octal command/address and selectable8/16bit data. Dummy counts MUST match
// the trained chip mode/clock. All other/reserved register fields preserved.
trusted fun p4PsramMappedConfigureOwned(readDummy: int,writeDummy: int,hex16: bool,polls: int): int {
    if (!p4PsramMappedProfileValid(readDummy,writeDummy,polls)) return 2
    if ((p4PsramMappedRead(60)&1) != 0) return 3
    if (!p4PsramMappedWaitIdle(polls)) return 4
    if (!p4PsramMappedField(76,0xf000ffff,0xf0008080)) return 261
    if (!p4PsramMappedField(72,0xf000ffff,0xf0000000)) return 517
    val sctrl=1|8|16|32|((readDummy-1)<<6)|(31<<14)|(1<<20)|(1<<21)|((writeDummy-1)<<22)
    if (!p4PsramMappedField(64,0x0fffcff9,sctrl)) return 773
    if (!p4PsramMappedField(216,15,3)) return 1029
    val command=(15<<18)|(1<<23)|(if (hex16) 3<<26 else 0)
    if (!p4PsramMappedField(68,0x0cbc0000,command)) return 1285
    if (!p4PsramMappedField(12,0x06000000,0x06000000)) return 1541
    return 1
}
// Only after device programming/timing calibration and cache/MMU preparation.
// Rechecks all configuration; opens AXI LAST, never by forced-success bypass.
trusted fun p4PsramMappedStartOwned(readDummy: int,writeDummy: int,hex16: bool,polls: int): int {
    val prepared=p4PsramMappedConfigureOwned(readDummy,writeDummy,hex16,polls)
    if (prepared != 1) return prepared
    return if (p4PsramMappedField(60,0x80000001,1)) 1 else 1797
}
// Caller first excludes new cache/CPU/DMA requests and completes writeback.
// Drain BEFORE closing AXI, avoiding SLV_ERR responses for in-flight requests.
// No FIFO/event clearing; timeout leaves active access unchanged.
trusted fun p4PsramMappedStopOwned(polls: int): int {
    if (polls < 1 || polls > 1000000) return 2
    if (!p4PsramMappedWaitIdle(polls)) return 4
    return if (p4PsramMappedField(60,0x80000001,0x80000000)) 1 else 1797
}
