import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Sweep already-seeded reserved64B PSRAM at caller-installed target clocks.
// Table:count u32 candidates, mode[2:0],number[4:3],extra[7:5],upper bits0.
// Results:count u32 pass counts. FFFFFFFF marks incomplete, NEVER a failure
// count. Completed candidates survive subsequent errors. A new invocation
// deliberately starts a fresh sweep; partial counts must not be selected.
// Each repetition reinstalls the candidate then reads the reference, matching
// IDF. Only data mismatch5 counts as failed measurement; other errors abort.
// Result1 COMPLETE (not selected/calibrated); otherwise low8 error2/3/4,
// candidate index in bits8..15 after execution starts. Preflight error2.
// All4buffers internal, disjoint, exclusive and immutable except results/
// scratch/work. Caller owns seeded physical span, verified chip/flash mode,
// original ROM baseline, clocks, all caches/peers/IRQ/DMA, internal stack and
// watchdog. No cache resume or restoration: last/partial candidate remains.
fun s3PsramSweepOverlap(a: int,an: int,b: int,bn: int): bool = a < b+bn && b < a+an
@section(".iram1.abla.s3PsramTimingSweep")
trusted fun s3PsramTimingSweepOwned(table: NativeBuffer,results: NativeBuffer,count: int,repetitions: int,address: int,capacity: int,scratch: NativeBuffer,work: NativeBuffer,octalFlash: bool,base: int,original0: int,original1: int,exclusiveInternal: bool): int {
    if (!exclusiveInternal || count < 1 || count > 20 || repetitions < 1 || repetitions > 1024 ||
        address < 0 || (address&3) != 0 || capacity < 64 || capacity > 1073741824 || address > capacity-64 ||
        base < 0 || base > 63 || original0 < 0 || original0 > 255 || original1 < 0 || original1 > 255) return 2
    val bytes=count*4;val t=table.addressValue();val r=results.addressValue();val s=scratch.addressValue();val w=work.addressValue()
    if (!table.hasAddressRange(0,bytes) || !results.hasAddressRange(0,bytes) || !scratch.hasAddressRange(0,64) || !work.hasAddressRange(0,100) ||
        ((t|r|w)&3) != 0 || !s3PsramCommandStorageSafe(t,bytes) || !s3PsramCommandStorageSafe(r,bytes) ||
        !s3PsramCommandStorageSafe(s,64) || !s3PsramCommandStorageSafe(w,100) ||
        s3PsramSweepOverlap(t,bytes,r,bytes) || s3PsramSweepOverlap(t,bytes,s,64) || s3PsramSweepOverlap(t,bytes,w,100) ||
        s3PsramSweepOverlap(r,bytes,s,64) || s3PsramSweepOverlap(r,bytes,w,100) || s3PsramSweepOverlap(s,64,w,100)) return 2
    if (!octalFlash) {
        val legacy=s3FlashLegacyPointer()
        if (!s3FlashLegacyPointerValid(legacy) || s3PsramSweepOverlap(t,bytes,legacy,28) ||
            s3PsramSweepOverlap(r,bytes,legacy,28) || s3PsramSweepOverlap(s,64,legacy,28) || s3PsramSweepOverlap(w,100,legacy,28)) return 2
    }
    var index=0
    while (index < count) {
        val candidate=table.loadU32(index*4);val extra=(candidate>>>5)&7
        if (candidate > 255 || (!octalFlash && (base+original0+extra > 63 || base+original1+extra > 63))) return 2
        index=index+1
    }
    index=0
    while (index < count) { results.storeU32(index*4,4294967295);index=index+1 }
    index=0
    while (index < count) {
        val candidate=table.loadU32(index*4)
        var pass=0;var repetition=0
        while (repetition < repetitions) {
            var status=s3PsramTimingCandidateOwned(candidate&7,(candidate>>>3)&3,(candidate>>>5)&7,octalFlash,base,original0,original1,true)
            if (status != 1) return (index<<8)|status
            status=s3PsramTimingSampleOwned(1,address,capacity,scratch,work,true)
            if (status == 1) pass=pass+1 else if (status != 5) return (index<<8)|status
            repetition=repetition+1
        }
        results.storeU32(index*4,pass);index=index+1
    }
    return 1
}
