import "./command_s3_sequence.ab"
// S3 IDF timing reference:64 bytes of repeated a5ff005a, transferred as
// two32-byte commands. Action0 seeds a caller-reserved physical64-byte span
// at verified LOW speed; action1 measures at the installed candidate timing.
// Caller owns physical span, correct capacity/mode/pads, internal buffers/
// stack, cache/peer/IRQ/DMA exclusion, and watchdog for unbounded ROM waits.
// Seeding is destructive even on failure. Measurement does not change RAM.
// 6seed commands returned (NOT verified),1exact match,5mismatch,2invalid,
// 3busy,4command failure. Never convert command failure into a failed sample.
@section(".iram1.abla.s3PsramTimingSample")
trusted fun s3PsramTimingSampleOwned(action: int,address: int,capacity: int,scratch: NativeBuffer,work: NativeBuffer,exclusiveInternal: bool): int {
    if (!exclusiveInternal || action < 0 || action > 1 || address < 0 || (address&3) != 0 ||
        capacity < 64 || capacity > 1073741824 || address > capacity-64 ||
        !scratch.hasAddressRange(0,64) || !work.hasAddressRange(0,100) || (work.addressValue()&3) != 0) return 2
    val s=scratch.addressValue();val w=work.addressValue()
    if (!s3PsramCommandStorageSafe(s,64) || !s3PsramCommandStorageSafe(w,100) || (s < w+100 && w < s+64)) return 2
    if (!s3PsramCommandReady()) return 3
    var offset=0
    while (offset < 64) { scratch.storeU32(offset,if (action == 0) 0xa5ff005a else 0x5a00ffa5);offset=offset+4 }
    offset=0
    while (offset < 64) {
        if (!s3PsramCommandReady()) return 3
        // Clear hardware FIFO before reads, as mspi_timing_ll_clear_fifo(1).
        // Clearing only the software receive buffer would leave stale FIFO.
        if (action == 1) {
            var word=0
            while (word < 16) { s3PsramTimingFifoWrite(word,0);word=word+1 }
        }
        val result=s3PsramCommandOwned(if (action == 0) 0x8080 else 0,address+offset,
            if (action == 0) 8 else 18,nativeBufferAt(s+offset,32),32,work)
        if (result != 1) return result
        offset=offset+32
    }
    if (action == 0) return 6
    offset=0
    while (offset < 64) { if (scratch.loadU32(offset) != 0xa5ff005a) return 5;offset=offset+4 }
    return 1
}
