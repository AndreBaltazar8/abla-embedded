import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// AP/compatible PSRAM command port MSPI1 only, CS1, OPI DDR. Native Abla
// mode/config/start use MMIO, without ROM calls or linked implementations.
// Start waits without a software deadline: this API does NOT promise bounded
// completion. Caller provides stable clocks/pads/modes, excludes other CPUs,
// caches/IRQ/DMA/users, runs entirely internal, and retains watchdog recovery.
// Work100B aligned4: descriptor32, address4, private padded FIFO64.
// Payload may be byte-aligned and needs only requested length; no FIFO word
// access reaches it. Both spans must be internal, owned and disjoint.
// 1transfer completed (not chip verification),2invalid,3busy,4stillbusy.
fun s3PsramCommandIsRead(command: int): bool = command == 0 || command == 0x4040
fun s3PsramCommandIsWrite(command: int): bool = command == 0x8080 || command == 0xc0c0
@section(".iram1.abla.s3PsramCommand")
trusted fun s3PsramCommandOwned(command: int,address: int,dummy: int,payload: NativeBuffer,length: int,work: NativeBuffer): int {
    val read=s3PsramCommandIsRead(command)
    if ((!read && !s3PsramCommandIsWrite(command)) || address < 0 || address > 4294967295 || dummy < 0 || dummy > 64 ||
        length < 1 || length > 64 || !payload.hasAddressRange(0,length) || !work.hasAddressRange(0,100) || (work.addressValue()&3) != 0) return 2
    val p=payload.addressValue(); val w=work.addressValue()
    if ((p < w+100 && w < p+length) || !s3PsramCommandStorageSafe(p,length) || !s3PsramCommandStorageSafe(w,100)) return 2
    if (!s3PsramCommandReady()) return 3
    val fifo=w+36
    work.storeU32(0,command|(16<<16))
    work.storeU32(4,w+32)
    work.storeU32(8,32)
    work.storeU32(12,if (read) 0 else fifo)
    work.storeU32(16,if (read) 0 else length*8)
    work.storeU32(20,if (read) fifo else 0)
    work.storeU32(24,if (read) length*8 else 0)
    work.storeU32(28,dummy)
    work.storeU32(32,address)
    var offset=0
    while (offset < 64) { work.store(offset+36,if (!read && offset < length) payload.load(offset) else 0); offset=offset+1 }
    s3PsramOpiDtrMode()
    s3PsramCommandConfigure(1,w)
    // IDF psram_ctrlr_ll passes CS BIT(1)=2 despite ambiguous ROM header prose.
    // is_write_erase=false for PSRAM, matching ROM permission semantics in IDF.
    s3PsramCommandStart(if (read) fifo else 0,if (read) length else 0)
    if (!s3PsramCommandReady()) return 4
    if (read) {
        offset=0
        while (offset < length) { payload.store(offset,work.load(offset+36)); offset=offset+1 }
    }
    return 1
}
