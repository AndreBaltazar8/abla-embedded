import "./clock_s3_sequence.ab"
import "./din_s3_sequence.ab"
import "./flash_dummy_s3_sequence.ab"
import "../sdk/raw_buffer.ab"
// Internal24B owner:magic,phase,originalROMbaseline,octal,encodedBase,lastError.
// Phase1clock pending,2DIN pending,3flash dummy pending,4ready. On failure the
// current phase remains owned/retryable; NEVER resume caches/other clients.
// Capture ROM additions once before mutation, never recapture adjusted values.
// This composes a low-speed profile only, not pin/PSRAM mode/MMU/boot setup.
// Caller proves actual flash mode and vendor/HPM base, stable PLL system clock,
// full cache/peer/IRQ/DMA/MSPI exclusion and internal code/stack/data throughout.
@section(".iram1.abla.s3PsramLow")
trusted fun s3PsramLowSpeedOwned(r: NativeBuffer,octal: bool,base: int,stablePllSystemClock: bool,exclusiveInternal: bool): int {
    if (!exclusiveInternal || !stablePllSystemClock || base < 0 || base > 63 ||
        !r.hasAddressRange(0,24) || (r.addressValue()&3) != 0 || !s3PsramLowStorageSafe(r.addressValue(),24)) return 2
    val mode=if (octal) 1 else 0
    if (r.loadU32(0) == 0) {
        val baseline=if (octal) 0 else s3FlashDummyBaselineOwned(true)
        if (baseline < 0 || (!octal && (base+(baseline&255) > 63 || base+(baseline>>>8) > 63))) return 2
        // Owner must not overlap the ROM legacy structure it will modify.
        if (!octal) {
            val legacy=s3FlashLegacyPointer()
            if (!s3FlashLegacyPointerValid(legacy) || (r.addressValue() < legacy+28 && legacy < r.addressValue()+24)) return 2
        }
        r.storeU32(0,0x53334c4f);r.storeU32(4,1);r.storeU32(8,baseline)
        r.storeU32(12,mode);r.storeU32(16,base);r.storeU32(20,0)
    } else if (r.loadU32(0) != 0x53334c4f || r.loadU32(4) < 1 || r.loadU32(4) > 4 ||
        r.loadU32(12) != mode || r.loadU32(16) != base) return 2
    var phase=r.loadU32(4)
    while (phase < 4) {
        var result=1
        if (phase == 1) result=s3PsramLowClockOwned(true,true)
        else if (phase == 2) result=s3PsramDinOwned(0,0,0,0,0,true)
        else result=s3FlashDummyOwned(octal,base,r.loadU32(8)&255,r.loadU32(8)>>>8,0,true)
        if (result != 1) { r.storeU32(20,phase*256+result);return result }
        phase=phase+1;r.storeU32(4,phase);r.storeU32(20,0)
    }
    return 1
}
