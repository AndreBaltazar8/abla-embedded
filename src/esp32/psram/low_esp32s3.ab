import "./low_s3_sequence.ab"
import "./flash_dummy_esp32s3.ab"
import "../../hal/esp32_psram.ab"
// Caller excludes linker/ROM/bootloader reservations within this physical SRAM.
@export("s3PsramLowStorageSafe")
fun s3PsramLowStorageSafeHook(address: int,length: int): bool =
    address >= 0x3fc88000 && length > 0 && address <= 0x3fd00000-length
