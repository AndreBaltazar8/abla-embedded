import "./cs_s3_sequence.ab"
// Post-PSRAM command/tuning restoration, matching IDF6 flash_ops.c and
// esp32s3/spi_flash_oct_flash_init.c s_mxic_set_required_regs.
// Profile0 quad flash,1 Macronix OPI STR,2 Macronix OPI DTR. Caller verifies
// the actual initialized chip/protocol; these are NOT chip-mode transitions.
// Unknown OPI vendors must not be represented as Macronix.
// Caller retains internal-only cache/MSPI/peer/IRQ/DMA exclusion and has
// already installed the selected flash/PSRAM clock and timing profile.
// Does not resume caches, issue flash commands or alter PSRAM SMEM fields.
// 1restored,2invalid/proof,3busy,4readback failure: retain exclusion and retry.
@section(".iram1.abla.s3PsramFlashRestore")
trusted fun s3PsramFlashRestoreOwned(profile: int,exclusiveInternal: bool): int {
    if (!exclusiveInternal || profile < 0 || profile > 2) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    if (profile != 0) {
        var value=s3PsramCsRead(0x600020e0)&0xfffffffd
        s3PsramCsWrite(0x600020e0,value)
        if (s3PsramCsRead(0x600020e0) != value) return 4
        var port=0
        while (port < 2) {
            val address=0x600030e0-port*4096
            value=(s3PsramCsRead(address)&0xfffffff3)|(if (profile == 2) 12 else 0)
            s3PsramCsWrite(address,value)
            if (s3PsramCsRead(address) != value) return 4
            port=port+1
        }
    }
    val value=(s3PsramCsRead(0x6000203c)&0xfffffffd)|(if (profile == 0) 0 else 2)
    s3PsramCsWrite(0x6000203c,value)
    if (s3PsramCsRead(0x6000203c) != value) return 4
    return 1
}
