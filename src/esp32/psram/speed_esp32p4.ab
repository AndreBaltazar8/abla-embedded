import "./speed_p4_sequence.ab"
import "./pins_esp32p4.ab"
import "./mpll_esp32p4.ab"
trusted fun p4PsramSpeedMpllReady(mhz: int,polls: int): bool {
    if ((p4MpllRead(0x5011515c)&0x01000000) == 0 || (p4MpllRead(0x50111040)&0x10000000) == 0 ||
        !p4AnalogClockReady() || (p4AnalogRead(52)&1) == 0) return false
    val value=p4AnalogRegisterOwned(0x63,2,0,false,polls)
    return (value&255) == 1 && ((value>>>8)&255) == (if (mhz == 320) 121 else if (mhz == 400) 153 else 193)
}
