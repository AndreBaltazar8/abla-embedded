import "./cs_s3_sequence.ab"
// Clock portion of S3 IDF mspi_timing_psram_init: shared core, BOTH flash
// port dividers at PSRAM measurement frequency, then PSRAM timing HCLK.
// SPI1 commands use the FLASH clock register even when targeting CS1 PSRAM.
// This is a measurement clock profile, NOT final flash/PSRAM clock setup.
// SPI0 cached PSRAM divider remains untouched. No memory/cache access until
// suitable candidate timing is installed; all exclusions remain held.
// Caller proves stable480MHz PLL system source and internal-only continuation,
// all cache/MSPI/peer/IRQ/DMA exclusion, watchdog recovery. No PLL writes.
// DTR requires power-of-two divider; reject truncated frequency requests.
fun s3PsramTimingClockDivider(coreMHz: int,moduleMHz: int): int {
    if ((coreMHz != 80 && coreMHz != 120 && coreMHz != 160 && coreMHz != 240) ||
        (moduleMHz != 20 && moduleMHz != 40 && moduleMHz != 80 && moduleMHz != 120) || coreMHz%moduleMHz != 0) return -1
    val divider=coreMHz/moduleMHz
    if (divider < 1 || divider > 256 || (divider&(divider-1)) != 0) return -1
    return divider
}
// 1clock profile installed,2invalid/proof,3busy,4partial/readback failure.
@section(".iram1.abla.s3PsramTimingClock")
trusted fun s3PsramTimingClockOwned(coreMHz: int,moduleMHz: int,stable480PllSystemClock: bool,exclusiveInternal: bool): int {
    val divider=s3PsramTimingClockDivider(coreMHz,moduleMHz)
    if (!stable480PllSystemClock || !exclusiveInternal || divider < 0) return 2
    if ((s3PsramCsRead(0x60002000)&0xfffe0000) != 0 || (s3PsramCsRead(0x60003000)&0xfffe0000) != 0) return 3
    val selector=if (coreMHz == 80) 0 else if (coreMHz == 120) 1 else if (coreMHz == 160) 2 else 3
    val clock=if (divider == 1) 0x80000000 else ((divider-1)<<16)|((divider/2-1)<<8)|(divider-1)
    var step=0
    while (step < 4) {
        val address=if (step == 0) 0x600030ec else if (step == 1) 0x60003014 else if (step == 2) 0x60002014 else 0x600030bc
        val value=if (step == 0) (s3PsramCsRead(address)&0xfffffffc)|selector else if (step == 3) s3PsramCsRead(address)|1 else clock
        s3PsramCsWrite(address,value)
        if (s3PsramCsRead(address) != value) return 4
        step=step+1
    }
    return 1
}
