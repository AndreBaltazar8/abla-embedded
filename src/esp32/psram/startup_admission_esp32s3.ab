import "./startup_admission_s3.ab"
import "../../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.s3PsramStartupAdmission")
trusted fun s3PsramStartupHardwareMismatch(): int = s3PsramStartupMismatch(
    xtensaGuardCore(),xtensaGuardStatus(),int(xtensaGuardRead("rsr.intenable $0","=a,~{memory}")),
    mmioLoadU32(0x600c0060),mmioLoadU32(0x600c0010),mmioLoadU32(0x60008000),mmioLoadU32(0x600c0000))
