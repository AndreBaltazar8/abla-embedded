import "./cache_mapping_s3_sequence.ab"
import "./cache_enable_s3_sequence.ab"
import "./cache_disable_s3_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
fun s3PsramCacheMappingStorageSafe(address: int,length: int): bool = address >= 0x3fc88000 && length > 0 && address <= 0x3fd00000-length
trusted fun s3PsramCacheMappingRead(address: int): int = mmioLoadU32(address)
trusted fun s3PsramCacheMappingWrite(address: int,value: int): void = mmioStoreU32(address,value)
trusted fun s3PsramCacheMappingWriteback(): void = s3PsramCacheWritebackNativeOwned()
trusted fun s3PsramCacheMappingDisable(instruction: bool): int = s3PsramCacheDisableNativeOwned(instruction)
trusted fun s3PsramCacheMappingEnable(instruction: bool,state: int): void = s3PsramCacheEnableNativeOwned(instruction,state)
