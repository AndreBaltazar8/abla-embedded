import "./cache_mapping_s3_sequence.ab"
import "./cache_enable_s3_sequence.ab"
import "./cache_disable_s3_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../../hal/esp32_psram.ab"
@export("s3PsramCacheMappingStorageSafe")
fun s3PsramCacheMappingStorageSafeHook(address: int,length: int): bool = address >= 0x3fc88000 && length > 0 && address <= 0x3fd00000-length
@export("s3PsramCacheMappingRead")
trusted fun s3PsramCacheMappingReadHook(address: int): int = mmioLoadU32(address)
@export("s3PsramCacheMappingWrite")
trusted fun s3PsramCacheMappingWriteHook(address: int,value: int): void = mmioStoreU32(address,value)
@export("s3PsramCacheMappingWriteback")
trusted fun s3PsramCacheMappingWritebackHook(): void = s3PsramCacheWritebackNativeOwned()
@export("s3PsramCacheMappingDisable")
trusted fun s3PsramCacheMappingDisableHook(instruction: bool): int = s3PsramCacheDisableNativeOwned(instruction)
@export("s3PsramCacheMappingEnable")
trusted fun s3PsramCacheMappingEnableHook(instruction: bool,state: int): void = s3PsramCacheEnableNativeOwned(instruction,state)
