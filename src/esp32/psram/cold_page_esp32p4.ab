import "./cold_page_p4_sequence.ab"
import "./cold_esp32p4.ab"
import "./page_esp32p4.ab"
import "../cache_cold_esp32p4.ab"
// Compact validated profile: read dummy8,write dummy8,width1,capacity pages.
trusted fun p4PsramColdPageProfile(cold: NativeBuffer): int {
    if (cold.loadU32(0) != 0x50345053 || cold.loadU32(4) != 8 || !P4MpllOwner(cold.loadU32(8)).ready() || !P4PsramClockOwner(cold.loadU32(12)).ready()) return 0
    val identity=P4PsramIdentity(cold.loadU32(24)|(cold.loadU32(28)<<32))
    val mhz=cold.loadU32(32); val hex16=(identity.mode(8)&64) != 0
    if (!identity.matchesProfile(mhz,hex16)) return 0
    return p4PsramProfileReadDummy(mhz)|(p4PsramProfileWriteDummy(mhz)<<8)|(if (hex16) 65536 else 0)|((identity.physicalBytes()>>>16)<<17)
}
