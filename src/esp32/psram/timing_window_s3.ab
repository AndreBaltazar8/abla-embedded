import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Pure selection over COMPLETED sweep pass counts, not hardware calibration.
// Caller records each candidate's successful repetitions in a u32. Only an
// exact match to repetitions passes; partial reads never count as success.
// S3 IDF6: earliest longest run (no wrap); DTR/core160 accepts lengths3..5,
// STR/core120 or240 accepts3..4. DTR/core240 needs a PLL-frequency scan and
// is deliberately unsupported here, not silently handled as core160.
// Result -1 invalid/unsupported; otherwise packed status[7:0] (1selected,
// 2upstream-default fallback), index[15:8], run length[23:16], end[31:24].
// Fallback is NOT verified calibration; caller must not treat status2 as1.
// When caches are unavailable, samples and the entire caller stack must be
// internal too; section placement alone does not validate supplied pointers.
@section(".iram1.abla.s3PsramTimingWindow")
fun s3PsramTimingWindow(samples: NativeBuffer,count: int,repetitions: int,defaultIndex: int,coreMHz: int,dtr: bool): int {
    if (count < 1 || count > 20 || repetitions < 1 || repetitions > 4294967295 ||
        defaultIndex < 0 || defaultIndex >= count || !samples.hasAddressRange(0,count*4) ||
        (samples.addressValue()&3) != 0 ||
        (if (dtr) coreMHz != 160 else coreMHz != 120 && coreMHz != 240)) return -1
    var best=0;var end=0;var run=0;var index=0
    while (index < count) {
        val successes=samples.loadU32(index*4)
        if (successes > repetitions) return -1
        run=if (successes == repetitions) run+1 else 0
        if (run > best) { best=run;end=index }
        index=index+1
    }
    val accepted=best >= 3 && best <= (if (dtr) 5 else 4)
    val selected=if (!accepted) defaultIndex else if (dtr) end-(if (best == 5) 2 else 1) else end-best/2
    return (if (accepted) 1 else 2)|(selected<<8)|(best<<16)|(end<<24)
}
