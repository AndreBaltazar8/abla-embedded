import "./clock_p4_sequence.ab"
// Destructive CONTROLLER reset, not a PSRAM-chip reset. Caller owns both
// ports, has stopped/joined all cache/CPU/IRQ/DMA users and written back dirty
// data. Run internally with stable clock owner. Never resets flash MSPI.
// Invalidates prior controller configuration; reprepare before commands/AXI.
// low8:1released2invalid3clock/reset4busy5readback; ownership8AXI9APB;
// failed stage16..23:1assert AXI,2assert APB,3release APB,4release AXI.
// On failure retain result and clock owner, then releaseOwned before cleanup.
// A successful release does NOT mean an interrupted reset fully completed.
type P4PsramReset = int
fun P4PsramReset.status(): int = this&255
fun P4PsramReset.failedStage(): int = (this>>>16)&255
trusted fun P4PsramReset.releaseOwned(): P4PsramReset {
    if (this < 0 || this > 0x0403ff || this.status() > 5 || this.failedStage() > 4) return this
    var state=(this|0)&768
    if (state == 0) return P4PsramReset(1)
    // Only RCC accesses here: controller registers may be held in reset.
    if ((p4PsramClockRead(20)&0x80000000) == 0 || (p4PsramClockRead(48)&0xc000) != 0xc000) return P4PsramReset(state|3)
    if ((state&512) != 0) {
        if (!p4PsramClockField(192,0x02000000,0)) return P4PsramReset(state|(3<<16)|5)
        state=state^512
    }
    if ((state&256) != 0 && !p4PsramClockField(192,0x00800000,0)) return P4PsramReset(state|(4<<16)|5)
    return P4PsramReset(1)
}
trusted fun P4PsramClockOwner.resetControllerOwned(polls: int): P4PsramReset {
    if (!this.ready() || this < 0 || this > 0x1fffff || polls < 1 || polls > 1000000) return P4PsramReset(2)
    if ((p4PsramClockRead(192)&0x02800000) != 0 || (p4PsramClockRead(20)&0x80000000) == 0 ||
        (p4PsramClockRead(48)&0x00fff000) != (((this.divider()-1)<<16)|(this.source()<<12)|0xc000)) return P4PsramReset(3)
    if ((p4PsramMappedRead(60)&1) != 0 || (p4PsramMappedRead(4096)&0x400f0) != 0 || !p4PsramMappedWaitIdle(polls)) return P4PsramReset(4)
    if (!p4PsramClockField(192,0x00800000,0x00800000)) return P4PsramReset(256|(1<<16)|5)
    if (!p4PsramClockField(192,0x02000000,0x02000000)) return P4PsramReset(768|(2<<16)|5)
    return P4PsramReset(768).releaseOwned()
}
