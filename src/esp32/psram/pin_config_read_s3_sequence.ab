import "./pin_config_s3.ab"
// Latched eFuse register reads only. No ROM getter, reload or programming.
// Capture SYS2 once: it straddles the flash/WP and OPI configuration bundles.
@section(".iram1.abla.s3MspiConfiguredPinRead")
trusted fun s3MspiReadConfiguredPin(role: int): int {
    if (role < 0 || role > 11) return -1
    val sys1=s3MspiEfuseRead(0x60007048)
    val sys2=s3MspiEfuseRead(0x6000704c)
    val sys3=s3MspiEfuseRead(0x60007050)
    val flash=s3MspiFlashPinConfig(sys1,sys2)
    return s3MspiConfiguredPin(role,flash&0x3fffffff,flash>>>30,s3MspiOpiConfig(sys2,sys3))
}
