import "../sdk/raw_buffer.ab"
// Internal16B startup record: magic0,phase4,autoload owner8,error12.
// phase0fresh1suspend attempted2flush attempted3cold attempted4configured.
// Each failed attempt retains all child ownership. No automatic retry/reset.
// Caller owns inherited valid cache tags/mappings and backing memory, executes
// internally, excludes peers/IRQ/DMA/preload/locked lines, pins upstream clocks,
// and owns PSRAM/controller/pads. NO inherited live PSRAM mapping is allowed:
// flush must complete before cold-start reconfigures that controller.
// Autoload remains suspended after success; restore only when its configured
// address ranges and backing clocks/mappings are safe again, not blindly at close.
fun p4PsramStartupStorage(record: NativeBuffer): bool = record.hasAddressRange(0,16) && (record.addressValue()&3) == 0 && p4PsramCommandStorageSafe(record.addressValue(),16)
trusted fun p4PsramStartupInitializeOwned(record: NativeBuffer): bool {
    if (!p4PsramStartupStorage(record)) return false
    record.storeU32(0,0x50345354); record.storeU32(4,0); record.storeU32(8,0); record.storeU32(12,0); return true
}
trusted fun p4PsramStartupColdOwned(record: NativeBuffer,cold: NativeBuffer,mhz: int,hex16: bool,dummy: int,scratch: NativeBuffer,work: NativeBuffer,polls: int): int {
    if (!p4PsramStartupStorage(record) || !p4PsramStartupInputsValid(record,cold,mhz,dummy,scratch,work,polls)) return 2
    if (record.loadU32(0) != 0x50345354 || record.loadU32(4) != 0 || record.loadU32(8) != 0 ||
        cold.loadU32(0) != 0x50345053 || cold.loadU32(4) != 0 || cold.loadU32(8) != 0 || cold.loadU32(12) != 0 || cold.loadU32(16) != 0 || cold.loadU32(44) != 0) return 3
    record.storeU32(4,1)
    val autoload=p4PsramStartupSuspend(polls)
    record.storeU32(8,autoload)
    if ((autoload&255) != 1) { record.storeU32(12,autoload&255); return 4 }
    record.storeU32(4,2)
    val flushed=p4CacheFlushAllDataOwned(polls)
    if (flushed != 1) { record.storeU32(12,flushed); return 4 }
    record.storeU32(4,3)
    val result=p4PsramColdStartOwned(cold,mhz,hex16,dummy,scratch,work,polls)
    if (result != 1) { record.storeU32(12,result); return 4 }
    record.storeU32(4,4); return 1
}
