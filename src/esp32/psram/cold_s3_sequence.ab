import "./pins_s3_sequence.ab"
import "./ecc_s3_sequence.ab"
import "./low_s3_sequence.ab"
import "./command_mode_s3_sequence.ab"
import "./probe_s3_sequence.ab"
// Internal64B cold-start owner:magic,phase,probeAddress,scratch,work,octalFlash,
// encodedFlashBase,lastError,identity6B@32,reserved2B,lowOwner24B@40.
// Phases1pins/CS,2nonECC,3low clocks/timing,4command-mode,5MR0,6probe,
// 7identity,8verified low-speed command access. Not calibrated or MMU mapped.
// Probe overwrites an explicitly caller-reserved4B physical PSRAM word.
// Both success and failure RETAIN cache/MSPI/peer/IRQ/DMA/pad ownership:
// restoring flash SPI1 state, tuning and mapping are later boot steps.
// Caller proves cold entire PSRAM, correct octal pins/power/efuse wiring,
// actual flash protocol/HPM base, stable PLL, internal stack/code/watchdog
// recovery and all exclusions. ROM command waits remain unbounded.
// 1verified,2invalid/proof,3busy,4write/command error,5mismatch,6bad identity.
@section(".iram1.abla.s3PsramCold")
trusted fun s3PsramColdOwned(r: NativeBuffer,scratch: NativeBuffer,work: NativeBuffer,probeAddress: int,octalFlash: bool,encodedFlashBase: int,coldMemory: bool,stablePll: bool,exclusiveInternal: bool): int {
    if (!coldMemory || !stablePll || !exclusiveInternal || !r.hasAddressRange(0,64) || (r.addressValue()&3) != 0 ||
        !s3PsramLowStorageSafe(r.addressValue(),64) || !s3PsramModeBuffers(scratch,work) ||
        probeAddress < 0 || probeAddress > 4294967292 || (probeAddress&3) != 0 || encodedFlashBase < 0 || encodedFlashBase > 63 ||
        (r.addressValue() < scratch.addressValue()+8 && scratch.addressValue() < r.addressValue()+64) ||
        (r.addressValue() < work.addressValue()+100 && work.addressValue() < r.addressValue()+64)) return 2
    val mode=if (octalFlash) 1 else 0
    if (!octalFlash) {
        val legacy=s3FlashLegacyPointer()
        if (!s3FlashLegacyPointerValid(legacy) ||
            (r.addressValue() < legacy+28 && legacy < r.addressValue()+64) ||
            (scratch.addressValue() < legacy+28 && legacy < scratch.addressValue()+8) ||
            (work.addressValue() < legacy+28 && legacy < work.addressValue()+100)) return 2
    }
    if (r.loadU32(0) == 0) {
        // Capture/validate original dummy additions before even pad mutations.
        val baseline=if (octalFlash) 0 else s3FlashDummyBaselineOwned(true)
        if (baseline < 0 || (!octalFlash && (encodedFlashBase+(baseline&255) > 63 || encodedFlashBase+(baseline>>>8) > 63))) return 2
        var offset=0
        while (offset < 64) { r.storeU32(offset,0);offset=offset+4 }
        r.storeU32(0,0x5333434f);r.storeU32(4,1);r.storeU32(8,probeAddress)
        r.storeU32(12,scratch.addressValue());r.storeU32(16,work.addressValue());r.storeU32(20,mode);r.storeU32(24,encodedFlashBase)
        // Publish the actual low-profile owner's captured state; no hardware
        // has changed yet. Its retry semantics must not recapture ROM bytes.
        r.storeU32(40,0x53334c4f);r.storeU32(44,1);r.storeU32(48,baseline)
        r.storeU32(52,mode);r.storeU32(56,encodedFlashBase)
    } else if (r.loadU32(0) != 0x5333434f || r.loadU32(4) < 1 || r.loadU32(4) > 8 ||
        r.loadU32(8) != probeAddress || r.loadU32(12) != scratch.addressValue() || r.loadU32(16) != work.addressValue() ||
        r.loadU32(20) != mode || r.loadU32(24) != encodedFlashBase) return 2
    var phase=r.loadU32(4)
    while (phase < 8) {
        var result=1
        if (phase == 1) result=s3PsramPinsAndCsOwned(true)
        else if (phase == 2) result=s3PsramNonEccOwned(true,true)
        else if (phase == 3) result=s3PsramLowSpeedOwned(nativeBufferAt(r.addressValue()+40,24),octalFlash,encodedFlashBase,true,true)
        else if (phase == 4) result=s3PsramCommandModeOwned(true)
        else if (phase == 5) result=s3PsramConfigureModeOwned(scratch,work,true)
        else if (phase == 6) result=s3PsramProbeOwned(probeAddress,4,scratch,work,true)
        else {
            val output=nativeBufferAt(r.addressValue()+32,6)
            result=s3PsramReadIdentityOwned(output,scratch,work,true)
            if (result == 1) {
                val identity=s3PsramIdentityFrom(output)
                if (!identity.good() || identity.physicalBytes() == 0 || probeAddress > identity.physicalBytes()-4) result=6
            }
        }
        if (result != 1) { r.storeU32(28,phase*256+result);return result }
        phase=phase+1;r.storeU32(4,phase);r.storeU32(28,0)
    }
    return 1
}
