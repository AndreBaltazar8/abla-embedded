import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
//12byte expected pin map in pin_config_s3 role order. GPIO22..25 absent on
// S3; all memory signals must be distinct valid GPIOs. CS1 must match fixed26
// via configured-pin getter. This checks configuration, not physical wiring,
// active mux, pull/drive, voltage, pin ownership or chip flash protocol.
// -1 malformed map/getter result;0 match;otherwise12bit mismatch mask.
// Preflight entire expected map before hardware reads; custom maps supported.
@section(".iram1.abla.s3MspiPinAdmission")
fun s3MspiPinMismatchMask(expected: NativeBuffer): int {
    if (!expected.hasAddressRange(0,12)) return -1
    var role=0
    while (role < 12) {
        val pin=expected.load(role)
        if (pin > 48 || (pin >= 22 && pin <= 25)) return -1
        var other=0
        while (other < role) { if (expected.load(other) == pin) return -1;other=other+1 }
        role=role+1
    }
    var mismatch=0;role=0
    while (role < 12) {
        val pin=s3MspiReadConfiguredPin(role)
        if (pin < 0 || pin > 63) return -1
        if (pin != expected.load(role)) mismatch=mismatch|(1<<role)
        role=role+1
    }
    return mismatch
}
