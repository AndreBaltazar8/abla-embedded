import "./command_s3_sequence.ab"
import "./opi_dtr_s3_sequence.ab"
import "./command_config_s3_sequence.ab"
import "./command_start_s3_sequence.ab"
import "abla/unsafe/mmio"
// Entire call graph, stack, buffers, interrupt/peer continuation must be
// internal. Caller excludes cache/MSPI/flash/PSRAM clients, owns configured
// OPI pads, clocks, latency and variable-dummy mode. Not boot initialization.
fun s3PsramCommandStorageSafe(address: int,length: int): bool =
    address >= 0x3fc88000 && length > 0 && address <= 0x3fd00000-length
trusted fun s3PsramCommandReady(): bool =
    (mmioLoadU32(0x60002000)&0xfffe0000) == 0 && (mmioLoadU32(0x60003000)&0xfffe0000) == 0
// IDF6 S3 ROM table and esp_rom_spi_cmd_t (32B descriptor) in opi_flash.h.
trusted fun s3PsramOpiRead(address: int): int = mmioLoadU32(address)
trusted fun s3PsramOpiWrite(address: int,value: int): void = mmioStoreU32(address,value)
trusted fun s3PsramOpiDtrMode(): void = s3PsramOpiDtrNativeOwned()
trusted fun s3PsramCommandConfigure(unit: int,descriptor: int): void = s3PsramCommandConfigNativeOwned(unit,descriptor)
trusted fun s3PsramCommandStart(rx: int,length: int): void = s3PsramCommandStartNativeOwned(rx,length)
