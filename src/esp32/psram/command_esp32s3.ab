import "./command_s3_sequence.ab"
import "./opi_dtr_s3_sequence.ab"
import "./command_config_s3_sequence.ab"
import "./command_start_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_psram.ab"
// Entire call graph, stack, buffers, interrupt/peer continuation must be
// internal. Caller excludes cache/MSPI/flash/PSRAM clients, owns configured
// OPI pads, clocks, latency and variable-dummy mode. Not boot initialization.
@export("s3PsramCommandStorageSafe")
fun s3PsramCommandStorageSafeHook(address: int,length: int): bool =
    address >= 0x3fc88000 && length > 0 && address <= 0x3fd00000-length
@export("s3PsramCommandReady")
trusted fun s3PsramCommandReadyHook(): bool =
    (mmioLoadU32(0x60002000)&0xfffe0000) == 0 && (mmioLoadU32(0x60003000)&0xfffe0000) == 0
// IDF6 S3 ROM table and esp_rom_spi_cmd_t (32B descriptor) in opi_flash.h.
@export("s3PsramOpiRead")
trusted fun s3PsramOpiReadHook(address: int): int = mmioLoadU32(address)
@export("s3PsramOpiWrite")
trusted fun s3PsramOpiWriteHook(address: int,value: int): void = mmioStoreU32(address,value)
@export("s3PsramOpiDtrMode")
trusted fun s3PsramOpiDtrModeHook(): void = s3PsramOpiDtrNativeOwned()
@export("s3PsramCommandConfigure")
trusted fun s3PsramCommandConfigureHook(unit: int,descriptor: int): void = s3PsramCommandConfigNativeOwned(unit,descriptor)
@export("s3PsramCommandStart")
trusted fun s3PsramCommandStartHook(rx: int,length: int): void = s3PsramCommandStartNativeOwned(rx,length)
