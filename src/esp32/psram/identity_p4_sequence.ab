import "../sdk/raw_buffer.ab"
// AP/UnilC HEX device readback. Packed scalar: status0..7; MR0,MR1,MR2,MR3,
// MR4,MR8 bytes at8,16,24,32,40,48. Failed command status56..59,stage60..62.
// Status1recognized good die,2invalid buffers,3transport,4vendor,5density,6KGD.
// Raw successfully read bytes survive failure. Recognized is identification,
// NOT memory-test/timing-calibration/cache-mapping evidence.
type P4PsramIdentity = int
fun P4PsramIdentity.status(): int = this&255
fun P4PsramIdentity.recognized(): bool = this.status() == 1
fun P4PsramIdentity.failedStage(): int = (this>>>60)&7
fun P4PsramIdentity.transportStatus(): int = (this>>>56)&15
fun P4PsramIdentity.mode(index: int): int {
    if (index == 0) return (this>>>8)&255
    if (index == 1) return (this>>>16)&255
    if (index == 2) return (this>>>24)&255
    if (index == 3) return (this>>>32)&255
    if (index == 4) return (this>>>40)&255
    if (index == 8) return (this>>>48)&255
    return -1
}
fun P4PsramIdentity.vendor(): int = this.mode(1)&31
fun P4PsramIdentity.physicalBytes(): int {
    val density=this.mode(2)&7
    if (density == 1) return 4194304
    if (density == 3) return 8388608
    if (density == 5) return 16777216
    if (density == 7) return 33554432
    if (density == 6) return 67108864
    return 0
}
fun p4PsramClassifyIdentity(raw: int): P4PsramIdentity {
    val value=P4PsramIdentity(raw&0x00ffffffffffff00)
    if (value.vendor() != 13 && value.vendor() != 26) return P4PsramIdentity((value|0)|4)
    if (value.physicalBytes() == 0) return P4PsramIdentity((value|0)|5)
    if ((value.mode(2)>>>5) != 6) return P4PsramIdentity((value|0)|6)
    return P4PsramIdentity((value|0)|1)
}
// Explicit IDF AP HEX timing profiles. Caller checks actual chip/revision,
// voltage/temperature and clock support before applying; no frequency switch.
fun p4PsramProfileValid(mhz: int): bool = mhz == 20 || mhz == 80 || mhz == 200 || mhz == 250
fun p4PsramProfileReadDummy(mhz: int): int = if (!p4PsramProfileValid(mhz)) -1 else if (mhz == 250) 34 else if (mhz == 200) 26 else 18
fun p4PsramProfileRegisterDummy(mhz: int): int = if (!p4PsramProfileValid(mhz)) -1 else if (mhz == 250) 16 else if (mhz == 200) 12 else 8
fun p4PsramProfileWriteDummy(mhz: int): int = p4PsramProfileRegisterDummy(mhz)
fun p4PsramProfileMpllMHz(mhz: int): int = if (!p4PsramProfileValid(mhz)) -1 else if (mhz == 250) 500 else if (mhz == 80) 320 else 400
// AP APS128XXO datasheet rev1.2 sections7.7/Table5: MR0[6]/MR8[7]
// must be written zero and RBX is forbidden at read-latency code6 (250MHz).
// https://www.apmemory.com/en/downloadFiles/0324112221ec577846
// These only PLAN values. Default to internal temperature-controlled refresh
// (TSO0, also safe for older parts reserving MR0[7]); preserve MR4 RF/PASR.
fun p4PsramProfileMode0(mhz: int,old: int): int =
    if (!p4PsramProfileValid(mhz) || old < 0 || old > 255) -1 else 32|((if (mhz == 250) 6 else if (mhz == 200) 4 else 2)<<2)
fun p4PsramProfileMode4(mhz: int,old: int): int =
    if (!p4PsramProfileValid(mhz) || old < 0 || old > 255) -1 else (old&31)|((if (mhz == 250) 3 else if (mhz == 200) 1 else 2)<<5)
fun p4PsramProfileMode8(hex16: bool,old: int,mhz: int = 200): int =
    if (!p4PsramProfileValid(mhz) || old < 0 || old > 255) -1 else (old&0x30)|3|(if (mhz <= 200) 8 else 0)|(if (hex16) 64 else 0)
fun P4PsramIdentity.matchesProfile(mhz: int,hex16: bool): bool = this.recognized() && p4PsramProfileValid(mhz) &&
    this.mode(0) == p4PsramProfileMode0(mhz,this.mode(0)) && this.mode(4) == p4PsramProfileMode4(mhz,this.mode(4)) &&
    this.mode(8) == p4PsramProfileMode8(hex16,this.mode(8),mhz) && (this.mode(4)&7) == 0
fun p4PsramIdentityFailure(raw: int,result: int,stage: int): P4PsramIdentity = P4PsramIdentity(raw|3|((result&15)<<56)|(stage<<60))
// Four read-only commands; same command transport preconditions/unbounded ROM
// completion caveat. Scratch2B and work100B are caller-owned internal/disjoint.
// Dummy is the CURRENT register-read timing, not an assumed target profile.
trusted fun p4PsramIdentifyOwned(dummy: int,scratch: NativeBuffer,work: NativeBuffer): P4PsramIdentity {
    if (dummy < 0 || dummy > 64 || !scratch.hasAddressRange(0,2) || !work.hasAddressRange(0,100) || (work.addressValue()&3) != 0) return P4PsramIdentity(2)
    val s=scratch.addressValue(); val w=work.addressValue()
    if ((s < w+100 && w < s+2) || !p4PsramCommandStorageSafe(s,2) || !p4PsramCommandStorageSafe(w,100)) return P4PsramIdentity(2)
    var raw=0
    var result=p4PsramCommandOwned(0x4040,0,dummy,scratch,2,work)
    if (result != 1) return p4PsramIdentityFailure(raw,result,1)
    raw=(scratch.load(0)<<8)|(scratch.load(1)<<16)
    result=p4PsramCommandOwned(0x4040,2,dummy,scratch,2,work)
    if (result != 1) return p4PsramIdentityFailure(raw,result,2)
    raw=raw|(scratch.load(0)<<24)|(scratch.load(1)<<32)
    result=p4PsramCommandOwned(0x4040,4,dummy,scratch,1,work)
    if (result != 1) return p4PsramIdentityFailure(raw,result,3)
    raw=raw|(scratch.load(0)<<40)
    result=p4PsramCommandOwned(0x4040,8,dummy,scratch,1,work)
    if (result != 1) return p4PsramIdentityFailure(raw,result,4)
    return p4PsramClassifyIdentity(raw|(scratch.load(0)<<48))
}
// Caller owns a quiescent device/controller, internal code/stack and stable
// command clock safe for BOTH old and requested latencies (use a low bring-up
// rate). Current read dummy must match the chip BEFORE this operation.
// This changes chip modes only, not controller timing, clocks or cache mapping.
// AP-compatible HEX parts only; caller verifies exact part/package speed rating.
// No rollback: after a failed write the chip may have changed. Do not retry
// assuming old timing. Status3 stages5/6/7 mean MR8/MR4/MR0 write failed;
// stages1..4 are identification/readback transport failures. Status7 is a
// readback mismatch,8 is unsupported vendor. Raw bytes on write failure are
// PRE-write observations, not a claim about the partially modified device.
// MR0 is last so read timing changes only after all other writes. MR4 PASR
// is explicitly cleared for full-array refresh; unrelated RF bits are retained.
trusted fun p4PsramApplyProfileOwned(mhz: int,hex16: bool,currentDummy: int,scratch: NativeBuffer,work: NativeBuffer): P4PsramIdentity {
    if (!p4PsramProfileValid(mhz)) return P4PsramIdentity(2)
    val before=p4PsramIdentifyOwned(currentDummy,scratch,work)
    if (!before.recognized()) return before
    if (before.vendor() != 13) return P4PsramIdentity(((before|0)&(-256))|8)
    val mr8=p4PsramProfileMode8(hex16,before.mode(8),mhz)
    val mr4=p4PsramProfileMode4(mhz,before.mode(4))&248
    val mr0=p4PsramProfileMode0(mhz,before.mode(0))
    // Register write carries one 8-bit MR value, not the paired-register read
    // mapping. Explicitly repeat it over the 16-bit controller transaction,
    // avoiding IDF's two-byte read from the final byte of its mode struct.
    // Fig14 latency1 is inherent in this command waveform: no added dummy.
    scratch.store(0,mr8); scratch.store(1,mr8)
    var result=p4PsramCommandOwned(0xc0c0,8,0,scratch,2,work)
    if (result != 1) return p4PsramIdentityFailure((before|0)&(-256),result,5)
    scratch.store(0,mr4); scratch.store(1,mr4)
    result=p4PsramCommandOwned(0xc0c0,4,0,scratch,2,work)
    if (result != 1) return p4PsramIdentityFailure((before|0)&(-256),result,6)
    scratch.store(0,mr0); scratch.store(1,mr0)
    result=p4PsramCommandOwned(0xc0c0,0,0,scratch,2,work)
    if (result != 1) return p4PsramIdentityFailure((before|0)&(-256),result,7)
    val after=p4PsramIdentifyOwned(p4PsramProfileRegisterDummy(mhz),scratch,work)
    if (!after.recognized()) return after
    if (!after.matchesProfile(mhz,hex16) || after.mode(0) != mr0 || after.mode(4) != mr4 || after.mode(8) != mr8 ||
        after.mode(1) != before.mode(1) || after.mode(2) != before.mode(2) || after.mode(3) != before.mode(3))
        return P4PsramIdentity(((after|0)&(-256))|7)
    return after
}
