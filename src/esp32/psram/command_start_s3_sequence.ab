import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// PSRAM-only MSPI1 CS1 USER transfer (ROM start(1,rx,len,2,false)).
// No flash write/erase permission command and no ROM-table polling callback.
// Owned idle/configured controller; internal immutable TX and owned RX0..64B;
// caller excludes cache/peer/IRQ/DMA and retains watchdog for unbounded waits.
// Completion restores CS0 enabled / CS1 disabled, NOT previous chip selection,
// exactly as ROM. RX FIFO reads occur only afterwards, one per padded word;
// byte stores preserve tails and permit unaligned RX without libc memcpy.
@section(".iram1.abla.s3PsramCommandStart")
trusted fun s3PsramCommandStartNativeOwned(rx: int,length: int): void {
    s3PsramOpiWrite(0x60002034,(s3PsramOpiRead(0x60002034)&0xfffffffc)|1)
    s3PsramOpiWrite(0x60002000,s3PsramOpiRead(0x60002000)|0x40000)
    while (s3PsramOpiRead(0x60002000) != 0) {}
    s3PsramOpiWrite(0x60002034,s3PsramOpiRead(0x60002034)|2)
    s3PsramOpiWrite(0x60002034,s3PsramOpiRead(0x60002034)&0xfffffffe)
    val output=nativeBufferAt(rx,length)
    var offset=0
    while (offset < length) {
        val word=s3PsramOpiRead(0x60002058+offset)
        var byte=0
        while (byte < 4 && offset+byte < length) {
            output.store(offset+byte,(word>>>(byte*8))&255)
            byte=byte+1
        }
        offset=offset+4
    }
    return
}
