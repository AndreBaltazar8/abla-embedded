import "abla/runtime/scalar"
// Native equivalents of S3 Cache_Occupy_DCache_MEMORY and Set_DCache_Mode.
// Low-level prevalidated controller operations: caller owns disabled caches,
// relinquished SRAM banks and internal code/stack outside those banks.
// Connect bits4..7 select low/high banks; SRAM_USAGE bits2..3 are the inverse
// of their union. Preserve ICache/CPU/other users. No lock-register writes.
@section(".iram1.abla.s3PsramCacheBanks")
trusted fun s3PsramCacheGeometryOccupyNativeOwned(low: int,high: int): void {
    val connection=((low<<4)|(high<<6))&255
    s3PsramCacheGeometryWrite(0x600c1004,(s3PsramCacheGeometryRead(0x600c1004)&0xffffff0f)|connection)
    s3PsramCacheGeometryWrite(0x600c1014,(s3PsramCacheGeometryRead(0x600c1014)&0xfffffff3)|((~((low|high)<<2))&12))
    return
}
// Four-way hardware ignores ways, as the ROM does. Coordinator accepts only
// size0/1 and line0/1/2. Two ordered RMWs, not a combined speculative write.
@section(".iram1.abla.s3PsramCacheMode")
trusted fun s3PsramCacheGeometryModeNativeOwned(size: int,ways: int,line: int): void {
    s3PsramCacheGeometryWrite(0x600c4000,(s3PsramCacheGeometryRead(0x600c4000)&0xfffffffb)|(if (size == 0) 0 else 4))
    s3PsramCacheGeometryWrite(0x600c4000,(s3PsramCacheGeometryRead(0x600c4000)&0xffffffe7)|(if (line == 0) 0 else if (line == 1) 8 else 16))
    return
}
