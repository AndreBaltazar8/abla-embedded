import "abla/runtime/scalar"
// Read-only sleep admission, not stream stop/drain. All GDMA clients and RCC
// users must be excluded from starting/reconfiguring transfers across this
// snapshot and sleep. Includes all five RX/TX pairs, not just owned audio.
// 0 idle/reset held; positive bits[2*channel+TX] busy; -1 missing exclusion;
// -2 clock gated without reset (state unobservable); -3 clock/reset changed.
// Does NOT prove peripheral/analog completion, non-GDMA masters or DMA buffer
// ownership. Never reset FIFOs, discard payload, force STOP or toggle clocks.
@section(".iram1.abla.s3GdmaSleepStatus")
trusted fun esp32S3GdmaSleepStatusOwned(clientsAndRccExcluded: bool): int {
    if (!clientsAndRccExcluded) return -1
    val clock=esp32S3GdmaSleepRead(0x600C001C)&64
    val reset=esp32S3GdmaSleepRead(0x600C0024)&64
    var result=0
    if (reset == 0) {
        if (clock == 0) result=-2
        else {
            var index=0
            while (index < 10) {
                val tx=(index&1) != 0
                val base=0x6003F000+(index/2)*192+(if (tx) 96 else 0)
                val link=esp32S3GdmaSleepRead(base+32)
                val fifo=esp32S3GdmaSleepRead(base+24)
                val park=if (tx) 1<<23 else 1<<24
                val commands=if (tx) 7<<20 else 7<<21
                // All three EMPTY bits set, all FULL bits/counts zero. RX
                // counts occupy6+7+5bits, TX5+7+5bits. Ignore reserved high bits.
                val fifoMask=if (tx) 0x7FFFFF else 0xFFFFFF
                if ((link&park) == 0 || (link&commands) != 0 || (fifo&fifoMask) != 42) result=result|(1<<index)
                index=index+1
            }
        }
    }
    if ((esp32S3GdmaSleepRead(0x600C001C)&64) != clock || (esp32S3GdmaSleepRead(0x600C0024)&64) != reset) return -3
    return result
}
