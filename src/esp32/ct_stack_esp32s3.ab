import "../runtime/ct_stack_bounds.ab"
// Isolated CPU boundary: importing the provider must not root HAL hook exports.
trusted noescape extern:"inline-assembly" fun esp32S3CtStackRead(template: string,constraints: string): u32

// Compiler/C runtime ABI, not a HAL hook. Boot uses this reserved stack;
// irq_entries_esp32s3 switches callbacks to dedicated per-core IRQ stacks.
// Other task/IRQ stacks deliberately get no wipe until they provide bounds.
@export("abla_ct_stack_low")
@section(".iram1.abla.s3CtStackLow")
trusted fun esp32S3CtStackLow(): u32 {
    val stack = esp32S3CtStackRead("mov $0, a1", "=r,~{memory}")
    val low = esp32S3CtStackRead("movi $0, __abla_boot_stack_low", "=r,~{memory}")
    val top = esp32S3CtStackRead("movi $0, __abla_boot_stack_top", "=r,~{memory}")
    embeddedCtBootStackLow(stack,low,top)
}
