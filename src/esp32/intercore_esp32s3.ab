import "./intercore_s3_sequence.ab"
import "abla/unsafe/mmio"
@inline
trusted fun esp32S3IntercoreRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3IntercoreUpdate(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
