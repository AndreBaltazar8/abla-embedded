import "./intercore_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@inline
@export("esp32S3IntercoreRead")
trusted fun esp32S3IntercoreReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3IntercoreUpdate")
trusted fun esp32S3IntercoreUpdateHook(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
