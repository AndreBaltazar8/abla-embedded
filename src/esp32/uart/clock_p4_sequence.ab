// P4 HP UART0..4, both layouts. Exclusive UART lifetime and RCC serialization.
// Source must already be selected and stable:0XTAL/1RTC/2PLL80; no implicit PLL
// enable, source switch or peripheral reset. Existing gates are borrowed.
// status low4,unit4..6,owned APB256/SYS512/source1024/TX2048/RX4096.
type P4UartClockOwner = int
fun P4UartClockOwner.status(): int = this&15
fun P4UartClockOwner.unit(): int = (this>>>4)&7
fun P4UartClockOwner.ready(): bool = this.status() == 1
// RCC-only source selection, before clock open.1selected,2invalid,3unexpected
// prior source,4running gate,5readback failure. Idempotent selection never gates
// a running UART. Caller pins new source and excludes all source/RCC writers.
trusted fun p4UartClockSelectOwned(unit: int,expected: int,source: int): int {
    if (unit < 0 || unit > 4 || expected < 0 || expected > 2 || source < 0 || source > 2) return 2
    val offset=104+unit*4
    val before=p4UartRccRead(offset)
    if (((before>>>24)&3) != expected) return 3
    if (source == expected) return 1
    if ((before&(1<<26)) != 0 || (p4UartRccRead(24)&(1<<(18+unit))) != 0) return 4
    p4UartRccWrite(offset,(before&0xfcffffff)|(source<<24))
    return if (((p4UartRccRead(offset)>>>24)&3) == source) 1 else 5
}
trusted fun p4UartClockField(offset: int,mask: int,enabled: bool): bool {
    val prior=p4UartRccRead(offset)
    p4UartRccWrite(offset,if (enabled) prior|mask else prior&(4294967295^mask))
    return (p4UartRccRead(offset)&mask) == (if (enabled) mask else 0)
}
// 1ready,2invalid,3reset/source mismatch,4APB,5SYS,6source gate,7TX/RX.
// Failure records attempted ownership; keep lease for closeOwned retry.
trusted fun p4UartClockOpenOwned(unit: int,source: int): P4UartClockOwner {
    if (unit < 0 || unit > 4 || source < 0 || source > 2) return P4UartClockOwner(2)
    var state=unit<<4
    val sourceOffset=104+unit*4
    if ((p4UartRccRead(196)&(1<<(13+unit))) != 0 || ((p4UartRccRead(sourceOffset)>>>24)&3) != source) return P4UartClockOwner(state|3)
    val apb=1<<(7+unit); val sys=1<<(18+unit)
    if ((p4UartRccRead(28)&apb) == 0) {
        state=state|256
        if (!p4UartClockField(28,apb,true)) return P4UartClockOwner(state|4)
    }
    if ((p4UartRccRead(24)&sys) == 0) {
        state=state|512
        if (!p4UartClockField(24,sys,true)) return P4UartClockOwner(state|5)
    }
    if ((p4UartRccRead(sourceOffset)&(1<<26)) == 0) {
        state=state|1024
        if (!p4UartClockField(sourceOffset,1<<26,true)) return P4UartClockOwner(state|6)
    }
    val prior=p4UartLocalClockRead(unit)
    if ((prior&(1<<24)) == 0) state=state|2048
    if ((prior&(1<<25)) == 0) state=state|4096
    if ((state&6144) != 0) {
        p4UartLocalClockWrite(unit,prior|(3<<24))
        if ((p4UartLocalClockRead(unit)&(3<<24)) != (3<<24)) return P4UartClockOwner(state|7)
    }
    return P4UartClockOwner(state|1)
}
// Only after UART drained, RX peer quiet, all IRQ/DMA/users joined. No MMIO
// through UART after closing starts. Reverse only owned gates, preserving
// borrowed ones. Failed phase retains remaining flags; no forced resets.
trusted fun P4UartClockOwner.closeOwned(): P4UartClockOwner {
    if (this < 0 || (this&(-8064)) != 0 || this.unit() > 4 || this.status() > 7) return this
    val unit=this.unit()
    var state=this&(-16)
    val local=((state&6144)>>>11)<<24
    if (local != 0) {
        p4UartLocalClockWrite(unit,p4UartLocalClockRead(unit)&(4294967295^local))
        if ((p4UartLocalClockRead(unit)&local) != 0) return P4UartClockOwner(state|7)
        state=state&(-6145)
    }
    if ((state&1024) != 0) {
        if (!p4UartClockField(104+unit*4,1<<26,false)) return P4UartClockOwner(state|6)
        state=state&(-1025)
    }
    if ((state&512) != 0) {
        if (!p4UartClockField(24,1<<(18+unit),false)) return P4UartClockOwner(state|5)
        state=state&(-513)
    }
    if ((state&256) != 0 && !p4UartClockField(28,1<<(7+unit),false)) return P4UartClockOwner(state|4)
    return P4UartClockOwner(0)
}
