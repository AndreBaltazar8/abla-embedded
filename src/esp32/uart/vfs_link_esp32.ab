import "abla/build"

compile fun esp32Idf6LinkUartVfsCallers(): bool {
    if (!internalFunction("esp32UartVfsGetVfs", "esp_vfs_uart_get_vfs")) return false
    if (!internalFunction("esp32UartVfsDevRegister", "uart_vfs_dev_register")) return false
    if (!internalFunction("esp32UartVfsDevPortSetRxLineEndings", "uart_vfs_dev_port_set_rx_line_endings")) return false
    if (!internalFunction("esp32UartVfsDevPortSetTxLineEndings", "uart_vfs_dev_port_set_tx_line_endings")) return false
    if (!internalFunction("esp32UartVfsDevSetRxLineEndings", "uart_vfs_dev_set_rx_line_endings")) return false
    if (!internalFunction("esp32UartVfsDevSetTxLineEndings", "uart_vfs_dev_set_tx_line_endings")) return false
    if (!internalFunction("esp32UartVfsDevUseNonblocking", "uart_vfs_dev_use_nonblocking")) return false
    if (!internalFunction("esp32UartVfsDevUseDriver", "uart_vfs_dev_use_driver")) return false
    if (!internalFunction("esp32UartVfsIncludeDevInit", "uart_vfs_include_dev_init")) return false
    true
}
