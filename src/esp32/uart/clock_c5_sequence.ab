import "./config_c5_sequence.ab"
// Exclusive stopped HP UART0/1; peer/IRQ/DMA users joined, PCR serialized,
// selected source0XTAL/1RC_FAST/2PLL80 pinned. Never reset or switch source.
// Status low4,unit bit4; attempted ownership8APB9source10TX11RX.
// 0closed1ready2invalid3reset/source4APB5ready-timeout6source7local8busy.
// Return replacement scalar after every operation; retain failures for cleanup.
type C5UartClockOwner=int
fun C5UartClockOwner.status(): int = this&15
fun C5UartClockOwner.unit(): int = (this>>>4)&1
fun C5UartClockOwner.ready(): bool = this.status() == 1
trusted fun c5UartClockField(unit: int,functional: bool,enabled: bool): bool {
    val mask=if (functional) 0x400000 else 1
    val before=if (functional) c5SerialClockRead(unit) else c5SerialBusRead(unit)
    val wanted=if (enabled) before|mask else before&~mask
    if (functional) c5SerialClockWrite(unit,wanted) else c5SerialBusWrite(unit,wanted)
    return ((if (functional) c5SerialClockRead(unit) else c5SerialBusRead(unit))&mask) == (if (enabled) mask else 0)
}
trusted fun c5UartClockOpenOwned(unit: int,source: int,exclusiveStopped: bool,polls: int): C5UartClockOwner {
    if (!exclusiveStopped || unit < 0 || unit > 1 || source < 0 || source > 2 || polls < 1 || polls > 1000000) return C5UartClockOwner(2)
    var state=unit<<4
    val bus=c5SerialBusRead(unit);val clock=c5SerialClockRead(unit)
    if ((bus&2) != 0 || ((clock>>>20)&3) != source) return C5UartClockOwner(state|3)
    if ((bus&1) == 0) {
        state=state|256
        if (!c5UartClockField(unit,false,true)) return C5UartClockOwner(state|4)
    }
    var left=polls
    while ((c5SerialBusRead(unit)&4) == 0 && left > 0) left=left-1
    if (left == 0) return C5UartClockOwner(state|5)
    val local=c5SerialRead(unit,136)
    if ((local&0x0c000000) != 0) return C5UartClockOwner(state|3)
    if ((clock&0x400000) == 0) {
        state=state|512
        if (!c5UartClockField(unit,true,true)) return C5UartClockOwner(state|6)
    }
    if ((local&0x1000000) == 0) state=state|1024
    if ((local&0x2000000) == 0) state=state|2048
    if ((state&3072) != 0) {
        c5SerialConfigWrite(unit,136,local|0x3000000)
        if ((c5SerialRead(unit,136)&0x3000000) != 0x3000000) return C5UartClockOwner(state|7)
    }
    return C5UartClockOwner(state|1)
}
// No peripheral access after APB release. Only owned gates are reversed.
// Ready timeout before local acquisition can still release its APB attempt.
trusted fun C5UartClockOwner.closeOwned(exclusiveStopped: bool): C5UartClockOwner {
    if (!exclusiveStopped || this < 0 || (this&~3871) != 0 || this.status() > 8) return this
    val unit=this.unit();var state=this&3856
    if ((state&3840) == 0) return C5UartClockOwner(0)
    val bus=c5SerialBusRead(unit)
    if ((bus&2) != 0) return C5UartClockOwner(state|8)
    if ((bus&5) == 5) {
        if (c5SerialRead(unit,12) != 0 || (c5SerialRead(unit,28)&0xff00ff) != 0 ||
            (c5SerialRead(unit,112)&255) != 0 || (c5SerialRead(unit,152)&1) != 0) return C5UartClockOwner(state|8)
    } else if ((state&3072) != 0) return C5UartClockOwner(state|8)
    val localMask=((state&3072)>>>10)<<24
    if (localMask != 0) {
        c5SerialConfigWrite(unit,136,c5SerialRead(unit,136)&~localMask)
        if ((c5SerialRead(unit,136)&localMask) != 0) return C5UartClockOwner(state|7)
        state=state&~3072
    }
    if ((state&512) != 0) {
        if (!c5UartClockField(unit,true,false)) return C5UartClockOwner(state|6)
        state=state&~512
    }
    if ((state&256) != 0 && !c5UartClockField(unit,false,false)) return C5UartClockOwner(state|4)
    return C5UartClockOwner(0)
}
