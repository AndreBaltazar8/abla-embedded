import "./serial_c5_sequence.ab"
import "../../runtime/unsigned_division64.ab"
// Bit32valid, UART divider bits0..23, planned PCR integer prescaler-1 at24.
// Wide arithmetic avoids sourceHz<<4 overflow. No source-frequency guessing.
fun c5SerialBaudPlan(sourceHz: int,baud: int): int {
    if (sourceHz < 1 || sourceHz > 4294967295 || baud < 1 || baud > sourceHz) return 0
    val denominator=4095*baud
    val prescale=int(unsignedDivide64(u64(sourceHz+denominator-1),u64(denominator)))
    if (prescale < 1 || prescale > 256) return 0
    val divider=int(unsignedDivide64(u64(sourceHz*16),u64(baud*prescale)))
    if (divider < 16 || divider > 65535) return 0
    return (1<<32)|((prescale-1)<<24)|(divider>>>4)|((divider&15)<<20)
}
// C5 HP UART0/1. Caller owns stopped UART, RX peer quiesced, IRQ/DMA users joined, source
// clock pinned and PCR serialization held. Clocks/pads/source selection remain
// separate. No FIFO reset or event acknowledgement; buffered bytes are refused.
// dataBits5..8; parity0none/1odd/2even; stop1one/2one-and-half/3two.
// 1configured,2invalid,3busy,4partial readback failure,5update timeout.
// Retain UART/clock ownership on4/5; do not print through partially configured UART.
trusted fun SerialPort.configureOwned(sourceHz: int,baud: int,dataBits: int,parity: int,stop: int,polls: int): int {
    val plan=c5SerialBaudPlan(sourceHz,baud)
    if (!this.valid() || plan == 0 || dataBits < 5 || dataBits > 8 || parity < 0 || parity > 2 ||
        stop < 1 || stop > 3 || polls < 1 || polls > 1000000) return 2
    val clock=c5SerialClockRead(this)
    // C5 differs from P4: divider lives at12..19; A/B fractional root clock
    // fields are separate. Reject noninteger roots instead of silently retiming.
    if ((c5SerialBusRead(this)&7) != 5 || (clock&0x400000) == 0 ||
        ((clock>>>20)&3) == 3 || (clock&4095) != 0) return 3
    if ((c5SerialRead(this,152)&1) != 0 || c5SerialRead(this,12) != 0 ||
        (c5SerialRead(this,28)&0x00ff00ff) != 0 || (c5SerialRead(this,112)&255) != 0) return 3
    val divider=(c5SerialRead(this,20)&0xff0ff000)|(plan&0x00f00fff)
    val prescale=(clock&0xfff00fff)|(((plan>>>24)&255)<<12)
    val framing=(c5SerialRead(this,32)&0xffffffc0)|((dataBits-5)<<2)|(stop<<4)|
        (if (parity == 1) 3 else if (parity == 2) 2 else 0)
    c5SerialConfigWrite(this,20,divider)
    if ((c5SerialRead(this,20)&0x00f00fff) != (divider&0x00f00fff)) return 4
    c5SerialClockWrite(this,prescale)
    if ((c5SerialClockRead(this)&0x7fffff) != (prescale&0x7fffff)) return 4
    c5SerialConfigWrite(this,32,framing)
    if ((c5SerialRead(this,32)&63) != (framing&63)) return 4
    c5SerialConfigWrite(this,152,1)
    var left=polls
    while (left > 0) {
        if ((c5SerialRead(this,152)&1) == 0) return 1
        left=left-1
    }
    return 5
}
