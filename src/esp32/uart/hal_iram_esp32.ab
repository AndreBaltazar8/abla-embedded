import "abla/unsafe/memory"
import "abla/unsafe/mmio"
import "abla/unsafe/native"

// IRAM-safe UART FIFO operations expressed as direct volatile accesses. The
// APB FIFO is used for reads and the uncached AHB alias for writes, matching
// the classic ESP32 hardware requirement without recovered instruction flow.

val esp32UartIram0Base = u32(0x3ff40000)
val esp32UartIram1Base = u32(0x3ff50000)
val esp32UartIram2Base = u32(0x3ff6e000)
val esp32UartIram0AhbFifo = 0x60000000
val esp32UartIram1AhbFifo = 0x60010000
val esp32UartIram2AhbFifo = 0x6002e000

@inline
trusted fun esp32UartIramLoad(address: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32UartIramStore(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32UartIramDevice(context: u32): u32 =
    esp32UartIramLoad(context)

@inline
trusted fun esp32UartIramReadRegister(device: u32, offset: u32): u32 =
    u32(mmioLoadU32(int(device + offset)))

@inline
trusted fun esp32UartIramWriteRegister(
    device: u32, offset: u32, value: u32
): void = mmioStoreU32(int(device + offset), int(value))

@inline
trusted fun esp32UartIramUpdate(
    device: u32, offset: u32, clearMask: u32, setMask: u32
): void {
    val current = esp32UartIramReadRegister(device, offset)
    esp32UartIramWriteRegister(
        device, offset, (current & ~clearMask) | setMask
    )
    return
}

@inline
trusted fun esp32UartIramAhbFifo(device: u32): int =
    if (device == esp32UartIram0Base) esp32UartIram0AhbFifo
    else if (device == esp32UartIram1Base) esp32UartIram1AhbFifo
    else esp32UartIram2AhbFifo

trusted fun esp32UartIramReceiveCount(device: u32): u32 {
    val statusCount = esp32UartIramReadRegister(device, u32(28)) & u32(255)
    val memory = esp32UartIramReadRegister(device, u32(96))
    val readAddress = (memory >>> u32(2)) & u32(2047)
    val writeAddress = (memory >>> u32(13)) & u32(2047)
    if (readAddress < writeAddress) return writeAddress - readAddress
    if (writeAddress < readAddress)
        return writeAddress + u32(128) - readAddress
    return if (statusCount == u32(0)) u32(0) else u32(128)
}

trusted fun esp32UartHalResetTransmitFifo(a2: u32): void {
    val device = esp32UartIramDevice(a2)
    // ESP32 has a shared FIFO-reset erratum on UART1/2; only UART0 may use
    // the register bit after startup.
    if (device == esp32UartIram0Base) {
        esp32UartIramUpdate(device, u32(32), u32(0), u32(1) << u32(18))
        esp32UartIramUpdate(device, u32(32), u32(1) << u32(18), u32(0))
    }
    return
}

trusted fun esp32UartHalResetReceiveFifo(a2: u32): void {
    val device = esp32UartIramDevice(a2)
    while (esp32UartIramReceiveCount(device) != u32(0)) {
        mmioLoadU32(int(device))
    }
    return
}

trusted fun esp32UartHalSetTransmitBreak(a2: u32, a3: u32): void {
    val device = esp32UartIramDevice(a2)
    if (a3 == u32(0)) {
        esp32UartIramUpdate(device, u32(32), u32(1) << u32(8), u32(0))
    } else {
        esp32UartIramUpdate(
            device, u32(64), u32(255) << u32(20),
            (a3 & u32(255)) << u32(20)
        )
        esp32UartIramUpdate(device, u32(32), u32(0), u32(1) << u32(8))
    }
    return
}

@section(".iram1.0.abla.uartHalWriteTxfifo")
trusted fun esp32UartHalWriteTransmitFifo(
    a2: u32, a3: u32, a4: u32, a5: u32
): void {
    val device = esp32UartIramDevice(a2)
    val occupied = (esp32UartIramReadRegister(device, u32(28)) >>> u32(16)) &
        u32(255)
    val available = u32(128) - occupied
    val count = if (a4 < available) a4 else available
    esp32UartIramStore(a5, count)
    val fifo = esp32UartIramAhbFifo(device)
    var index = u32(0)
    while (index < count) {
        val byte = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(a3 + index))
        ))
        mmioStoreU32(fifo, int(byte))
        index = index + u32(1)
    }
    return
}

trusted fun esp32UartHalReadReceiveFifo(
    a2: u32, a3: u32, a4: u32
): void {
    val device = esp32UartIramDevice(a2)
    var count = esp32UartIramLoad(a4)
    if (i32(count) < i32(1)) {
        count = esp32UartIramReceiveCount(device)
        esp32UartIramStore(a4, count)
    }
    var index = u32(0)
    while (index < count) {
        ablaUnsafeStoreU8(
            nativePointerFromAddress(int(a3 + index)),
            mmioLoadU32(int(device)) & 255
        )
        index = index + u32(1)
    }
    return
}
