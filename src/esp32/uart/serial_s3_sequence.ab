// ESP32-S3 UART0 only; caller owns initialized UART clocks, baud and pads.
// No USB-console routing, implicit initialization, locks or IRQ masking.
// Match the classic SerialPort byte/text API. Use tryWriteByte in bounded
// startup/error paths; the compatibility writeByte deliberately blocks.
type SerialPort = int
fun serial(unit: int = 0): SerialPort = SerialPort(unit)
trusted fun SerialPort.tryWriteByte(value: int, polls: int = 100000): bool {
    if (this != 0 || polls < 1 || polls > 1000000) return false
    var attempt = 0
    while (attempt < polls) {
        // S3 TX count occupies ten bits (SDK uart_reg.h), FIFO capacity128.
        if (((esp32S3SerialReadStatus() >>> 16) & 1023) < 128) {
            esp32S3SerialWriteFifo(value & 255)
            return true
        }
        attempt = attempt + 1
    }
    false
}
trusted fun SerialPort.writeByte(value: int): void {
    if (this != 0) return
    while (!this.tryWriteByte(value)) {}
    return
}
trusted fun SerialPort.write(text: string): void {
    var index = 0
    while (index < text.size) {
        this.writeByte(text[index])
        index = index + 1
    }
    return
}
trusted fun SerialPort.line(text: string): void {
    this.write(text)
    this.writeByte(10)
    return
}
trusted fun SerialPort.writeUnsigned(value: u32): void {
    var divisor = u32(1000000000)
    var started = false
    while (divisor != u32(0)) {
        val digit = (value / divisor) % u32(10)
        if (digit != u32(0) || started || divisor == u32(1)) {
            this.writeByte(int(digit + u32(48)))
            started = true
        }
        divisor = divisor / u32(10)
    }
    return
}
