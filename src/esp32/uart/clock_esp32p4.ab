import "./clock_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4UartRccRead(offset: int): int = mmioLoadU32(0x500e6000+offset)
trusted fun p4UartRccWrite(offset: int,value: int): void { mmioStoreU32(0x500e6000+offset,value); return }
trusted fun p4UartLocalClockRead(unit: int): int = mmioLoadU32(0x500ca088+unit*4096)
trusted fun p4UartLocalClockWrite(unit: int,value: int): void { mmioStoreU32(0x500ca088+unit*4096,value); return }
