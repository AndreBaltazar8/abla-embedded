import "./clock_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_uart.ab"
@export("p4UartRccRead")
trusted fun p4UartRccReadHook(offset: int): int = mmioLoadU32(0x500e6000+offset)
@export("p4UartRccWrite")
trusted fun p4UartRccWriteHook(offset: int,value: int): void { mmioStoreU32(0x500e6000+offset,value); return }
@export("p4UartLocalClockRead")
trusted fun p4UartLocalClockReadHook(unit: int): int = mmioLoadU32(0x500ca088+unit*4096)
@export("p4UartLocalClockWrite")
trusted fun p4UartLocalClockWriteHook(unit: int,value: int): void { mmioStoreU32(0x500ca088+unit*4096,value); return }
