// C5 HP UART0..1, not LP UART2. Caller owns an
// already-clocked/configured UART and pads (e.g. ROM console) and serializes
// users. No implicit baud/clock/reset/USB routing, allocation or IRQ changes.
// Bounded API for boot/failure paths. FIFO access MUST be32bit: narrower writes
// can cause a hardware read-modify-write that consumes an RX byte (IDF uart_ll).
type SerialPort = int
fun serial(unit: int = 0): SerialPort = SerialPort(unit)
fun SerialPort.valid(): bool = this >= 0 && this <= 1
trusted fun SerialPort.tryWriteByte(value: int,polls: int = 100000): bool {
    if (!this.valid() || polls < 1 || polls > 1000000) return false
    var left=polls
    while (left > 0) {
        if (((c5SerialRead(this,28)>>>16)&255) < 128) {
            c5SerialWriteFifo(this,value&255); return true
        }
        left=left-1
    }
    return false
}
// -2invalid port,-1empty,0..255 received byte. Do not read FIFO on empty.
// Framing/overflow errors require separate status handling, not guessed here.
trusted fun SerialPort.tryReadByte(): int {
    if (!this.valid()) return -2
    if ((c5SerialRead(this,28)&255) == 0) return -1
    return c5SerialRead(this,0)&255
}
// True only once both FIFO and the output state machine are idle. A FIFO-empty
// test alone can return while the last byte is still on the wire.
trusted fun SerialPort.tryFlush(polls: int = 100000): bool {
    if (!this.valid() || polls < 1 || polls > 1000000) return false
    var left=polls
    while (left > 0) {
        if (((c5SerialRead(this,28)>>>16)&255) == 0 && ((c5SerialRead(this,112)>>>4)&15) == 0) return true
        left=left-1
    }
    return false
}
