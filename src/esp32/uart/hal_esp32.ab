import "abla/unsafe/memory"
import "abla/unsafe/mmio"
import "abla/unsafe/native"

// Classic ESP32 UART configuration HAL. Register fields are kept in typed
// Abla so the optimizer can see every mask and constant. Only volatile MMIO
// accesses cross into the compiler's target-independent hardware primitive.

@inline
trusted fun esp32UartHalLoad(address: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32UartHalStore(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32UartHalDevice(context: u32): u32 = esp32UartHalLoad(context)

@inline
trusted fun esp32UartHalRead(context: u32, offset: u32): u32 =
    u32(mmioLoadU32(int(esp32UartHalDevice(context) + offset)))

@inline
trusted fun esp32UartHalWrite(
    context: u32, offset: u32, value: u32
): void = mmioStoreU32(
    int(esp32UartHalDevice(context) + offset), int(value)
)

@inline
trusted fun esp32UartHalUpdate(
    context: u32, offset: u32, clearMask: u32, setMask: u32
): void {
    esp32UartHalWrite(
        context, offset,
        (esp32UartHalRead(context, offset) & ~clearMask) | setMask
    )
    return
}

trusted fun esp32UartHalGetSclk(context: u32, destination: u32): void {
    val apb = (esp32UartHalRead(context, u32(32)) &
        (u32(1) << u32(27))) != u32(0)
    esp32UartHalStore(destination, if (apb) u32(0) else u32(3))
    return
}

trusted fun esp32UartHalGetBaudrate(
    context: u32, destination: u32
): void {
    val apb = (esp32UartHalRead(context, u32(32)) &
        (u32(1) << u32(27))) != u32(0)
    val source = if (apb) u32(80000000) else u32(1000000)
    val divisor = esp32UartHalRead(context, u32(20)) & u32(0x00ffffff)
    esp32UartHalStore(
        destination,
        if (divisor == u32(0)) u32(0) else (source << u32(4)) / divisor
    )
    return
}

trusted fun esp32UartHalSetStopBits(context: u32, stopBits: u32): void {
    if (stopBits == u32(3)) {
        esp32UartHalUpdate(context, u32(68), u32(0), u32(1) << u32(2))
        esp32UartHalUpdate(
            context, u32(32), u32(3) << u32(4), u32(1) << u32(4)
        )
    } else {
        esp32UartHalUpdate(context, u32(68), u32(1) << u32(2), u32(0))
        esp32UartHalUpdate(
            context, u32(32), u32(3) << u32(4),
            (stopBits & u32(3)) << u32(4)
        )
    }
    return
}

trusted fun esp32UartHalGetStopBits(
    context: u32, destination: u32
): void {
    val stopBits = (esp32UartHalRead(context, u32(32)) >>> u32(4)) & u32(3)
    val delayed = (esp32UartHalRead(context, u32(68)) &
        (u32(1) << u32(2))) != u32(0)
    esp32UartHalStore(
        destination,
        if (delayed && stopBits == u32(1)) u32(3) else stopBits
    )
    return
}

trusted fun esp32UartHalSetDataBits(context: u32, dataBits: u32): void {
    esp32UartHalUpdate(
        context, u32(32), u32(3) << u32(2),
        (dataBits & u32(3)) << u32(2)
    )
    return
}

trusted fun esp32UartHalGetDataBits(
    context: u32, destination: u32
): void {
    esp32UartHalStore(
        destination,
        (esp32UartHalRead(context, u32(32)) >>> u32(2)) & u32(3)
    )
    return
}

trusted fun esp32UartHalSetParity(context: u32, parity: u32): void {
    var value = u32(0)
    if (parity != u32(0))
        value = (parity & u32(1)) | (u32(1) << u32(1))
    esp32UartHalUpdate(context, u32(32), u32(3), value)
    return
}

trusted fun esp32UartHalGetParity(
    context: u32, destination: u32
): void {
    val configuration = esp32UartHalRead(context, u32(32))
    val enabled = (configuration & u32(2)) != u32(0)
    esp32UartHalStore(
        destination,
        if (enabled) u32(2) | (configuration & u32(1)) else u32(0)
    )
    return
}

trusted fun esp32UartHalSetHardwareFlowControl(
    context: u32, flowControl: u32, receiveThreshold: u32
): void {
    var conf0Set = u32(0)
    var conf1Set = u32(0)
    if ((flowControl & u32(1)) != u32(0)) {
        conf1Set = ((receiveThreshold & u32(127)) << u32(16)) |
            (u32(1) << u32(23))
    }
    if ((flowControl & u32(2)) != u32(0))
        conf0Set = u32(1) << u32(15)
    esp32UartHalUpdate(
        context, u32(36),
        (u32(127) << u32(16)) | (u32(1) << u32(23)), conf1Set
    )
    esp32UartHalUpdate(
        context, u32(32), u32(1) << u32(15), conf0Set
    )
    return
}

trusted fun esp32UartHalGetHardwareFlowControl(
    context: u32, destination: u32
): void {
    var result = u32(0)
    if ((esp32UartHalRead(context, u32(36)) &
        (u32(1) << u32(23))) != u32(0)) result = result | u32(1)
    if ((esp32UartHalRead(context, u32(32)) &
        (u32(1) << u32(15))) != u32(0)) result = result | u32(2)
    esp32UartHalStore(destination, result)
    return
}

trusted fun esp32UartHalSetSoftwareFlowControl(
    context: u32, configuration: u32, enabled: u32
): void {
    if (enabled != u32(0)) {
        val xonCharacter = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(configuration))
        ))
        val xoffCharacter = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(configuration + u32(1)))
        ))
        val xonThreshold = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(configuration + u32(2)))
        ))
        val xoffThreshold = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(configuration + u32(3)))
        ))
        esp32UartHalWrite(
            context, u32(60), xonThreshold | (xoffThreshold << u32(8)) |
                (xonCharacter << u32(16)) | (xoffCharacter << u32(24))
        )
        esp32UartHalUpdate(context, u32(52), u32(0), u32(3))
    } else {
        esp32UartHalUpdate(context, u32(52), u32(3), u32(0))
    }
    return
}

trusted fun esp32UartHalSetAtCommand(
    context: u32, configuration: u32
): void {
    val character = u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(configuration))
    ))
    val count = u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(configuration + u32(1)))
    ))
    esp32UartHalWrite(
        context, u32(84), character | (count << u32(8))
    )
    esp32UartHalWrite(
        context, u32(80), esp32UartHalLoad(configuration + u32(4)) &
            u32(0x00ffffff)
    )
    esp32UartHalWrite(
        context, u32(72), esp32UartHalLoad(configuration + u32(8)) &
            u32(0x00ffffff)
    )
    esp32UartHalWrite(
        context, u32(76), esp32UartHalLoad(configuration + u32(12)) &
            u32(0x00ffffff)
    )
    return
}

trusted fun esp32UartHalSetTxIdle(context: u32, cycles: u32): void {
    esp32UartHalUpdate(
        context, u32(64), u32(1023) << u32(10),
        (cycles & u32(1023)) << u32(10)
    )
    return
}

trusted fun esp32UartHalSetDtr(context: u32, level: u32): void {
    esp32UartHalUpdate(
        context, u32(32), u32(1) << u32(7),
        (level & u32(1)) << u32(7)
    )
    return
}

trusted fun esp32UartHalSetReceiveThreshold(
    context: u32, threshold: u32
): void {
    esp32UartHalUpdate(
        context, u32(36), u32(127), threshold & u32(127)
    )
    return
}

trusted fun esp32UartHalSetTransmitThreshold(
    context: u32, threshold: u32
): void {
    esp32UartHalUpdate(
        context, u32(36), u32(127) << u32(8),
        (threshold & u32(127)) << u32(8)
    )
    return
}

trusted fun esp32UartHalSetWakeupThreshold(
    context: u32, threshold: u32
): void {
    esp32UartHalUpdate(
        context, u32(56), u32(1023), (threshold - u32(2)) & u32(1023)
    )
    return
}

trusted fun esp32UartHalGetWakeupThreshold(
    context: u32, destination: u32
): void {
    esp32UartHalStore(
        destination, (esp32UartHalRead(context, u32(56)) & u32(1023)) +
            u32(2)
    )
    return
}

trusted fun esp32UartHalSetMode(context: u32, mode: u32): void {
    var conf0 = esp32UartHalRead(context, u32(32))
    var rs485 = esp32UartHalRead(context, u32(68))
    // Clear IRDA, software RTS, and the RS485 enable/loop/receive-busy fields.
    conf0 = conf0 & ~((u32(1) << u32(6)) | (u32(1) << u32(16)))
    rs485 = rs485 & ~(u32(1) | (u32(1) << u32(3)) |
        (u32(1) << u32(4)))
    if (mode == u32(1)) {
        conf0 = conf0 | (u32(1) << u32(6))
        rs485 = rs485 | u32(1) | (u32(1) << u32(4))
    } else if (mode == u32(2)) {
        conf0 = conf0 | (u32(1) << u32(16))
    } else if (mode == u32(3)) {
        rs485 = rs485 | u32(1) | (u32(1) << u32(3)) |
            (u32(1) << u32(4))
    } else if (mode == u32(4)) {
        rs485 = rs485 | u32(1) | (u32(1) << u32(4))
    }
    esp32UartHalWrite(context, u32(32), conf0)
    esp32UartHalWrite(context, u32(68), rs485)
    return
}

trusted fun esp32UartHalHardwareRtsEnabled(context: u32): u32 =
    if ((esp32UartHalRead(context, u32(36)) &
        (u32(1) << u32(23))) != u32(0)) u32(1) else u32(0)

trusted fun esp32UartHalInverseSignals(context: u32, mask: u32): void {
    val hardwareMask = (u32(1) << u32(12)) | (u32(1) << u32(13)) |
        (u32(1) << u32(19)) | (u32(1) << u32(20)) |
        (u32(1) << u32(21)) | (u32(1) << u32(22)) |
        (u32(1) << u32(23)) | (u32(1) << u32(24))
    val value = ((mask & u32(1)) << u32(12)) |
        ((mask & u32(2)) << u32(12)) |
        ((mask & u32(4)) << u32(17)) |
        ((mask & u32(8)) << u32(17)) |
        ((mask & u32(16)) << u32(17)) |
        ((mask & u32(32)) << u32(17)) |
        ((mask & u32(64)) << u32(17)) |
        ((mask & u32(128)) << u32(17))
    esp32UartHalUpdate(context, u32(32), hardwareMask, value)
    return
}

trusted fun esp32UartHalSetLoopback(context: u32, enabled: u32): void {
    esp32UartHalUpdate(
        context, u32(32), u32(1) << u32(14),
        if (enabled != u32(0)) u32(1) << u32(14) else u32(0)
    )
    return
}

trusted fun esp32UartHalInitialize(context: u32): void {
    // Normal UART, parity disabled, eight data bits, one stop bit, no flow
    // control, no idle delay, and no IRDA/RS485 loopback.
    esp32UartHalUpdate(
        context, u32(68), u32(1) | (u32(1) << u32(2)) |
            (u32(1) << u32(3)) | (u32(1) << u32(4)), u32(0)
    )
    esp32UartHalUpdate(
        context, u32(32), u32(3) | (u32(3) << u32(2)) |
            (u32(3) << u32(4)) | (u32(1) << u32(15)) |
            (u32(1) << u32(16)),
        (u32(3) << u32(2)) | (u32(1) << u32(4))
    )
    esp32UartHalUpdate(
        context, u32(64), u32(1023) << u32(10), u32(0)
    )
    esp32UartHalUpdate(
        context, u32(36), u32(1) << u32(23), u32(0)
    )
    return
}

trusted fun esp32UartHalSymbolLength(context: u32): u32 {
    val conf0 = esp32UartHalRead(context, u32(32))
    val data = ((conf0 >>> u32(2)) & u32(3)) + u32(5)
    var stop = (conf0 >>> u32(4)) & u32(3)
    if ((esp32UartHalRead(context, u32(68)) &
        (u32(1) << u32(2))) != u32(0) && stop == u32(1)) stop = u32(3)
    val stopLength = if (stop < u32(2)) u32(1) else u32(2)
    val parityLength = if ((conf0 & u32(2)) != u32(0)) u32(1) else u32(0)
    return u32(1) + data + stopLength + parityLength
}

trusted fun esp32UartHalSetReceiveTimeout(
    context: u32, symbolCount: u32
): void {
    var ticks = (esp32UartHalSymbolLength(context) *
        (symbolCount & u32(255))) & u32(65535)
    val apb = (esp32UartHalRead(context, u32(32)) &
        (u32(1) << u32(27))) != u32(0)
    ticks = if (apb) (ticks + u32(7)) / u32(8) else ticks * u32(8)
    if (ticks == u32(0)) {
        esp32UartHalUpdate(context, u32(36), u32(1) << u32(31), u32(0))
    } else {
        esp32UartHalUpdate(
            context, u32(36),
            (u32(127) << u32(24)) | (u32(1) << u32(31)),
            ((ticks & u32(127)) << u32(24)) | (u32(1) << u32(31))
        )
    }
    return
}

trusted fun esp32UartHalMaximumReceiveTimeout(context: u32): u32 {
    val apb = (esp32UartHalRead(context, u32(32)) &
        (u32(1) << u32(27))) != u32(0)
    val ticks = if (apb) u32(1016) else u32(15)
    return ticks / esp32UartHalSymbolLength(context)
}
