import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkUartHalOpaqueCallers(): bool {
    if (!internalFunction("esp32UartHalGetSclk", "uart_hal_get_sclk")) return false
    if (!internalFunction("esp32UartHalGetBaudrate", "uart_hal_get_baudrate")) return false
    if (!internalFunction("esp32UartHalSetStopBits", "uart_hal_set_stop_bits")) return false
    if (!internalFunction("esp32UartHalGetStopBits", "uart_hal_get_stop_bits")) return false
    if (!internalFunction("esp32UartHalSetDataBits", "uart_hal_set_data_bit_num")) return false
    if (!internalFunction("esp32UartHalGetDataBits", "uart_hal_get_data_bit_num")) return false
    if (!internalFunction("esp32UartHalSetParity", "uart_hal_set_parity")) return false
    if (!internalFunction("esp32UartHalGetParity", "uart_hal_get_parity")) return false
    if (!internalFunction("esp32UartHalSetHardwareFlowControl", "uart_hal_set_hw_flow_ctrl")) return false
    if (!internalFunction("esp32UartHalGetHardwareFlowControl", "uart_hal_get_hw_flow_ctrl")) return false
    if (!internalFunction("esp32UartHalSetSoftwareFlowControl", "uart_hal_set_sw_flow_ctrl")) return false
    if (!internalFunction("esp32UartHalSetAtCommand", "uart_hal_set_at_cmd_char")) return false
    if (!internalFunction("esp32UartHalSetTxIdle", "uart_hal_set_tx_idle_num")) return false
    if (!internalFunction("esp32UartHalSetDtr", "uart_hal_set_dtr")) return false
    if (!internalFunction("esp32UartHalSetReceiveThreshold", "uart_hal_set_rxfifo_full_thr")) return false
    if (!internalFunction("esp32UartHalSetTransmitThreshold", "uart_hal_set_txfifo_empty_thr")) return false
    if (!internalFunction("esp32UartHalSetWakeupThreshold", "uart_hal_set_wakeup_edge_thrd")) return false
    if (!internalFunction("esp32UartHalGetWakeupThreshold", "uart_hal_get_wakeup_edge_thrd")) return false
    if (!internalFunction("esp32UartHalSetMode", "uart_hal_set_mode")) return false
    if (!internalFunction("esp32UartHalHardwareRtsEnabled", "uart_hal_is_hw_rts_en")) return false
    if (!internalFunction("esp32UartHalInverseSignals", "uart_hal_inverse_signal")) return false
    if (!internalFunction("esp32UartHalSetLoopback", "uart_hal_set_loop_back")) return false
    if (!internalFunction("esp32UartHalInitialize", "uart_hal_init")) return false
    if (!internalFunction("esp32UartHalSymbolLength", "uart_hal_get_symb_len")) return false
    if (!internalFunction("esp32UartHalSetReceiveTimeout", "uart_hal_set_rx_timeout")) return false
    if (!internalFunction("esp32UartHalMaximumReceiveTimeout", "uart_hal_get_max_rx_timeout_thrd")) return false
    true
}
