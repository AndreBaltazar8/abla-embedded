import "../serial_esp32c5.ab"
import "./config_c5_sequence.ab"
import "../../hal/esp32_uart.ab"
// PCR UART groups have12-byte stride on C5, not P4's four-byte clock array.
@export("c5SerialBusRead")
trusted fun c5SerialBusReadHook(unit: int): int = mmioLoadU32(0x60096000+unit*12)
@export("c5SerialClockRead")
trusted fun c5SerialClockReadHook(unit: int): int = mmioLoadU32(0x60096004+unit*12)
@export("c5SerialClockWrite")
trusted fun c5SerialClockWriteHook(unit: int,value: int): void { mmioStoreU32(0x60096004+unit*12,value);return }
@export("c5SerialConfigWrite")
trusted fun c5SerialConfigWriteHook(unit: int,offset: int,value: int): void { mmioStoreU32(0x60000000+unit*4096+offset,value);return }
