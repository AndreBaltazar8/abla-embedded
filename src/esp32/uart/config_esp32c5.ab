import "../serial_esp32c5.ab"
import "./config_c5_sequence.ab"
// PCR UART groups have12-byte stride on C5, not P4's four-byte clock array.
trusted fun c5SerialBusRead(unit: int): int = mmioLoadU32(0x60096000+unit*12)
trusted fun c5SerialClockRead(unit: int): int = mmioLoadU32(0x60096004+unit*12)
trusted fun c5SerialClockWrite(unit: int,value: int): void { mmioStoreU32(0x60096004+unit*12,value);return }
trusted fun c5SerialConfigWrite(unit: int,offset: int,value: int): void { mmioStoreU32(0x60000000+unit*4096+offset,value);return }
