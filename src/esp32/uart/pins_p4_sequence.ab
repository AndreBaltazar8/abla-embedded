// HP UART0..4 signals10+3*unit, both P4 layouts. Caller exclusively owns UART
// input route and distinct TX/RX pads, clocks/IOMUX pinned, pad holds released,
// peers/prior peripherals quiesced. Board flash/PSRAM/strapping pin suitability
// is caller policy. UART must already be configured with idle-high TX.
// 1configured,2invalid,3TX pad,4RX pad,5matrix,6TX enable failure.
// Every failure retains both pad/route leases; no reset/free/implicit rollback.
trusted fun p4UartPinsConfigureOwned(unit: int,tx: int,rx: int): int {
    if (unit < 0 || unit > 4 || tx < 0 || tx > 54 || rx < 0 || rx > 54 || tx == rx) return 2
    // Both outputs disabled while changing routes. GPIO latch high is installed
    // before matrix output switches to UART; TX is enabled only at the end.
    if (p4UartPinConfigure(tx,false) != 1) return 3
    if (p4UartPinConfigure(rx,true) != 1) return 4
    val signal=10+unit*3
    if (!p4UartPinField(1368+tx*4,4095,signal|1024) ||
        !p4UartPinField(344+signal*4,255,rx|128)) return 5
    val enable=if (tx < 32) 32 else 44
    val bit=u32(1)<<u32(tx&31)
    p4UartPinWrite(enable+4,bit)
    return if ((p4UartPinRead(enable)&bit) != u32(0)) 1 else 6
}
