import "./config_c5_sequence.ab"
import "../gpio_c5_sequence.ab"
// HP UART0/1 signals6/9. Caller owns both relinquished pads and global RX
// input route, UART/peers stopped, clocks/global holds pinned, board pins safe.
// UART must already be configured idle-high. No implicit clock/reset/USB/RTC
// takeover. Retain BOTH pads and RX route on any failure; no automatic restore.
// 1configured2invalid3admission4TXpad5RXpad6routes7TX-enable failure.
trusted fun c5UartPinsAdmission(unit: int,tx: int,rx: int,exclusiveStopped: bool,outputsOff: bool): int {
    if (unit < 0 || unit > 1 || !esp32C5GpioNumberValid(tx) || !esp32C5GpioNumberValid(rx) || tx == rx) return 2
    val mask=(u32(1)<<u32(tx))|(u32(1)<<u32(rx))
    if (!exclusiveStopped || (c5SerialBusRead(unit)&7) != 5 ||
        (c5SerialClockRead(unit)&0x400000) == 0 || ((c5SerialClockRead(unit)>>>20)&3) == 3 ||
        (c5GpioRead(0x600960f0)&u32(3)) != u32(1) ||
        (c5GpioRead(0x600960f4)&u32(0x400000)) == u32(0) ||
        ((c5GpioRead(0x600960f4)>>u32(20))&u32(3)) == u32(3) ||
        (c5GpioRead(0x60091df8)&u32(1)) == u32(0) ||
        (outputsOff && (c5GpioRead(0x60091034)&mask) != u32(0)) || (c5GpioRead(0x600b102c)&mask) != u32(0) ||
        (c5GpioRead(0x600b1028)&mask&u32(127)) != u32(0) ||
        ((mask&u32(0x6000)) != u32(0) && (c5GpioRead(0x6000f018)&u32(16384)) != u32(0))) return 3
    if ((c5SerialRead(unit,136)&0xf000000) != 0x3000000 || c5SerialRead(unit,12) != 0 ||
        (c5SerialRead(unit,28)&0xff00ff) != 0 || (c5SerialRead(unit,112)&255) != 0 ||
        (c5SerialRead(unit,152)&1) != 0 || (c5SerialRead(unit,32)&0x10040) != 0) return 3
    return 1
}
trusted fun c5UartPinsConfigureOwned(unit: int,tx: int,rx: int,exclusiveStopped: bool): int {
    val admission=c5UartPinsAdmission(unit,tx,rx,exclusiveStopped,true)
    if (admission != 1) return admission
    if (esp32C5GpioConfigureOwned(tx,false,true,false,false,0,true) != 1) return 4
    if (esp32C5GpioConfigureOwned(rx,false,true,false,true,0,true) != 1) return 5
    val signal=6+unit*3
    if (!c5GpioField(0x60091ad4+tx*4,u32(4095),u32(1024|signal)) ||
        !c5GpioField(0x600912d4+signal*4,u32(511),u32(256|rx))) return 6
    c5GpioWrite(0x60091038,u32(1)<<u32(tx))
    return if ((c5GpioRead(0x60091034)&(u32(1)<<u32(tx))) != u32(0)) 1 else 7
}
