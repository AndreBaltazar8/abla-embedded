import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkUartPeriphData(): bool {
    if (!internalFunction("esp32RecoveredEsp32UartPeriphDataAnchor", "esp32_uart_periph_data_anchor")) return false
    true
}
