import "abla/build"

// Public IDF spellings alias directly to typed Abla implementations. These
// are internal roots unless a final foreign caller proves otherwise.
compile fun esp32Idf6LinkUartDriverCallers(): bool {
    if (!internalFunction("esp32UartGetSclkFreq", "uart_get_sclk_freq")) return false
    if (!internalFunction("esp32UartSetWordLength", "uart_set_word_length")) return false
    if (!internalFunction("esp32UartGetWordLength", "uart_get_word_length")) return false
    if (!internalFunction("esp32UartSetStopBits", "uart_set_stop_bits")) return false
    if (!internalFunction("esp32UartGetStopBits", "uart_get_stop_bits")) return false
    if (!internalFunction("esp32UartSetParity", "uart_set_parity")) return false
    if (!internalFunction("esp32UartGetParity", "uart_get_parity")) return false
    if (!internalFunction("esp32UartSetBaudrate", "uart_set_baudrate")) return false
    if (!internalFunction("esp32UartGetBaudrate", "uart_get_baudrate")) return false
    if (!internalFunction("esp32UartSetLineInverse", "uart_set_line_inverse")) return false
    if (!internalFunction("esp32UartSetSoftwareFlowControl", "uart_set_sw_flow_ctrl")) return false
    if (!internalFunction("esp32UartSetHardwareFlowControl", "uart_set_hw_flow_ctrl")) return false
    if (!internalFunction("esp32UartGetHardwareFlowControl", "uart_get_hw_flow_ctrl")) return false
    if (!internalFunction("esp32UartClearInterruptStatus", "uart_clear_intr_status")) return false
    if (!internalFunction("esp32UartEnableInterruptMask", "uart_enable_intr_mask")) return false
    if (!internalFunction("esp32UartDisableInterruptMask", "uart_disable_intr_mask")) return false
    if (!internalFunction("esp32UartPatternPopPos", "uart_pattern_pop_pos")) return false
    if (!internalFunction("esp32UartPatternGetPos", "uart_pattern_get_pos")) return false
    if (!internalFunction("esp32UartPatternQueueReset", "uart_pattern_queue_reset")) return false
    if (!internalFunction("esp32UartEnablePatternDetection", "uart_enable_pattern_det_baud_intr")) return false
    if (!internalFunction("esp32UartDisablePatternDetection", "uart_disable_pattern_det_intr")) return false
    if (!internalFunction("esp32UartEnableRxInterrupt", "uart_enable_rx_intr")) return false
    if (!internalFunction("esp32UartDisableRxInterrupt", "uart_disable_rx_intr")) return false
    if (!internalFunction("esp32UartDisableTxInterrupt", "uart_disable_tx_intr")) return false
    if (!internalFunction("esp32UartEnableTxInterrupt", "uart_enable_tx_intr")) return false
    if (!internalFunction("esp32UartSetPin6", "_uart_set_pin6")) return false
    if (!internalFunction("esp32UartSetRts", "uart_set_rts")) return false
    if (!internalFunction("esp32UartSetDtr", "uart_set_dtr")) return false
    if (!internalFunction("esp32UartSetTxIdleNum", "uart_set_tx_idle_num")) return false
    if (!internalFunction("esp32UartParamConfig", "uart_param_config")) return false
    if (!internalFunction("esp32UartIntrConfig", "uart_intr_config")) return false
    if (!internalFunction("esp32UartWaitTxDone", "uart_wait_tx_done")) return false
    if (!internalFunction("esp32UartTxChars", "uart_tx_chars")) return false
    if (!internalFunction("esp32UartWriteBytes", "uart_write_bytes")) return false
    if (!internalFunction("esp32UartWriteBytesWithBreak", "uart_write_bytes_with_break")) return false
    if (!internalFunction("esp32UartReadBytes", "uart_read_bytes")) return false
    if (!internalFunction("esp32UartGetBufferedDataLen", "uart_get_buffered_data_len")) return false
    if (!internalFunction("esp32UartGetTxBufferFreeSize", "uart_get_tx_buffer_free_size")) return false
    if (!internalFunction("esp32UartFlush", "uart_flush")) return false
    if (!internalFunction("esp32UartDriverDelete", "uart_driver_delete")) return false
    if (!internalFunction("esp32UartDriverInstall", "uart_driver_install")) return false
    if (!internalFunction("esp32UartIsDriverInstalled", "uart_is_driver_installed")) return false
    if (!internalFunction("esp32UartSetSelectNotifCallback", "uart_set_select_notif_callback")) return false
    if (!internalFunction("esp32UartGetSelectLock", "uart_get_selectlock")) return false
    if (!internalFunction("esp32UartSetMode", "uart_set_mode")) return false
    if (!internalFunction("esp32UartSetRxFullThreshold", "uart_set_rx_full_threshold")) return false
    if (!internalFunction("esp32UartSetTxEmptyThreshold", "uart_set_tx_empty_threshold")) return false
    if (!internalFunction("esp32UartSetRxTimeout", "uart_set_rx_timeout")) return false
    if (!internalFunction("esp32UartGetCollisionFlag", "uart_get_collision_flag")) return false
    if (!internalFunction("esp32UartSetWakeupThreshold", "uart_set_wakeup_threshold")) return false
    if (!internalFunction("esp32UartGetWakeupThreshold", "uart_get_wakeup_threshold")) return false
    if (!internalFunction("esp32UartWaitTxIdlePolling", "uart_wait_tx_idle_polling")) return false
    if (!internalFunction("esp32UartSetLoopBack", "uart_set_loop_back")) return false
    if (!internalFunction("esp32UartSetAlwaysRxTimeout", "uart_set_always_rx_timeout")) return false
    if (!internalFunction("esp32UartDetectBitrateStart", "uart_detect_bitrate_start")) return false
    if (!internalFunction("esp32UartDetectBitrateStop", "uart_detect_bitrate_stop")) return false
    if (!internalFunction("esp32UartFlushInput", "uart_flush_input")) return false
    true
}
