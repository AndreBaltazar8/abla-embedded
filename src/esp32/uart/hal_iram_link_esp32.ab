import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkUartHalIramOpaqueCallers(): bool {
    if (!internalFunction("esp32UartHalResetTransmitFifo", "uart_hal_txfifo_rst")) return false
    if (!internalFunction("esp32UartHalResetReceiveFifo", "uart_hal_rxfifo_rst")) return false
    if (!internalFunction("esp32UartHalSetTransmitBreak", "uart_hal_tx_break")) return false
    if (!exportFunction("esp32UartHalWriteTransmitFifo", "uart_hal_write_txfifo")) return false
    if (!internalFunction("esp32UartHalReadReceiveFifo", "uart_hal_read_rxfifo")) return false
    true
}
