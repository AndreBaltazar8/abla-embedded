import "./pins_p4_sequence.ab"
import "../gpio_esp32p4.ab"
trusted fun p4UartPinConfigure(pin: int,input: bool): int = esp32P4GpioConfigureOwned(pin,false,true,false,input,if (input) 1 else 0)
trusted fun p4UartPinField(offset: int,mask: int,value: int): bool = p4GpioField(offset,u32(mask),u32(value))
trusted fun p4UartPinRead(offset: int): u32 = p4GpioRead(offset)
trusted fun p4UartPinWrite(offset: int,value: u32): void = p4GpioWrite(offset,value)
