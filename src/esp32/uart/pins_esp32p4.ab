import "./pins_p4_sequence.ab"
import "../gpio_esp32p4.ab"
import "../../hal/esp32_uart.ab"
@export("p4UartPinConfigure")
trusted fun p4UartPinConfigureHook(pin: int,input: bool): int = esp32P4GpioConfigureOwned(pin,false,true,false,input,if (input) 1 else 0)
@export("p4UartPinField")
trusted fun p4UartPinFieldHook(offset: int,mask: int,value: int): bool = p4GpioField(offset,u32(mask),u32(value))
@export("p4UartPinRead")
trusted fun p4UartPinReadHook(offset: int): u32 = p4GpioRead(offset)
@export("p4UartPinWrite")
trusted fun p4UartPinWriteHook(offset: int,value: u32): void = p4GpioWrite(offset,value)
