import "../cpu/interrupt_allocator_esp32.ab"
import "../freertos/queue_esp32.ab"
import "../freertos/tasks_esp32.ab"
import "../gpio/driver_esp32.ab"
import "../rom/gpio_esp32.ab"
import "../rom/system_esp32.ab"
