trusted fun esp32UartVfsFstat(context:u32,port:u32,status:u32):u32 {if(port>=u32(3)||status==u32(0))return u32(0xffffffff);freestandingSet(status,i32(0),u32(88));esp32UartVfsStore(status+u32(4),u32(8192));return u32(0)}
