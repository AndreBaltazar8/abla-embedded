    var count=u32(0);while(count==u32(0)){esp32UartVfsStore(written,u32(0));esp32UartHalWriteTransmitFifo(esp32UartContext(port),byte,u32(1),written);count=esp32UartVfsLoad(written)}
}
trusted fun esp32UartVfsTransmit(port:u32,character:u32):void {
    if(esp32UartVfsGet(esp32UartVfsDriverModes,port)==u32(0)){esp32UartVfsRawTransmit(port,character);return}
    val byte=u32(nativeStackAllocate(1));esp32UartVfsStoreByte(byte,character);esp32UartWriteBytes(port,byte,u32(1))
    return
}
trusted fun esp32UartVfsRawReceive(port:u32):u32 {
    if(esp32UartVfsRawAvailable(port)==u32(0))return esp32UartVfsNone
    return u32(ablaUnsafeVolatileLoadU32(int(esp32UartVfsDevice(port))))&u32(255)
}
trusted fun esp32UartVfsReceive(port:u32):u32 {
    if(esp32UartVfsGet(esp32UartVfsDriverModes,port)==u32(0))return esp32UartVfsRawReceive(port)
    val out=u32(nativeStackAllocate(1));val ticks=if(esp32UartVfsGet(esp32UartVfsNonBlocking,port)!=u32(0))u32(0)else u32(0xffffffff)
    return if(esp32UartReadBytes(port,out,u32(1),ticks)==u32(1))esp32UartVfsLoadByte(out)else esp32UartVfsNone
}
trusted fun esp32UartVfsReadCharacter(port:u32):u32 {
    val peek=esp32UartVfsGet(esp32UartVfsPeek,port);if(peek!=esp32UartVfsNone){esp32UartVfsSet(esp32UartVfsPeek,port,esp32UartVfsNone);return peek};return esp32UartVfsReceive(port)
