@inline trusted fun esp32UartVfsLoad(address:u32):u32 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))
@inline trusted fun esp32UartVfsStore(address:u32,value:u32):void = ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))
@inline trusted fun esp32UartVfsLoadByte(address:u32):u32 = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))
@inline trusted fun esp32UartVfsStoreByte(address:u32,value:u32):void = ablaUnsafeStoreU8(nativePointerFromAddress(int(address)),int(value&u32(255)))
@inline trusted fun esp32UartVfsDevice(port:u32):u32 = esp32UartVfsLoad(esp32UartVfsDevices+port*u32(4))
@inline trusted fun esp32UartVfsArray(array:u32,port:u32):u32 = array+port*u32(4)
@inline trusted fun esp32UartVfsGet(array:u32,port:u32):u32 = esp32UartVfsLoad(esp32UartVfsArray(array,port))
@inline trusted fun esp32UartVfsSet(array:u32,port:u32,value:u32):void = esp32UartVfsStore(esp32UartVfsArray(array,port),value)
trusted fun esp32UartVfsSetErrno(value:u32):void = esp32UartVfsStore(u32(nativeInternalSectionThreadLocalAllocate(4,"errno",".tdata.errno",4)),value)

trusted fun esp32UartVfsAcquire(port:u32,write:bool):void {
    val lock=esp32UartVfsLocks+port*u32(8)+(if(write)u32(4)else u32(0))
    esp32RecoveredLockAcquireRecursive(lock,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}
trusted fun esp32UartVfsRelease(port:u32,write:bool):void {
    val lock=esp32UartVfsLocks+port*u32(8)+(if(write)u32(4)else u32(0))
    esp32RecoveredLockReleaseRecursive(lock,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}

trusted fun esp32UartVfsRawAvailable(port:u32):u32 = esp32UartIramReceiveCount(esp32UartVfsDevice(port))
trusted fun esp32UartVfsAvailable(port:u32):u32 {
