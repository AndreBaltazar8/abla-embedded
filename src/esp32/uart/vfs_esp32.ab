trusted fun esp32UartVfsAny(args:u32,fd:u32):bool=esp32UartVfsFdSetContains(args+u32(20),fd)||esp32UartVfsFdSetContains(args+u32(28),fd)||esp32UartVfsFdSetContains(args+u32(36),fd)
