    while(i<size){val c=esp32UartVfsLoadByte(data+i);if(c==u32(10)&&mode!=esp32UartVfsLineFeed){esp32UartVfsTransmit(port,u32(13));if(mode!=esp32UartVfsCarriageReturn)esp32UartVfsTransmit(port,c)}else esp32UartVfsTransmit(port,c);i=i+u32(1)}
    esp32UartVfsRelease(port,true);return size
}
trusted fun esp32UartVfsRead(context:u32,port:u32,data:u32,size:u32):u32 {
    if(port>=u32(3)||data==u32(0))return u32(0xffffffff);esp32UartVfsAcquire(port,false);var first=esp32UartVfsNone
    if(esp32UartVfsGet(esp32UartVfsNonBlocking,port)==u32(0))first=esp32UartVfsReadCharacter(port)
    var available=esp32UartVfsAvailable(port);if(first!=esp32UartVfsNone)available=available+u32(1);if(esp32UartVfsGet(esp32UartVfsPeek,port)!=esp32UartVfsNone)available=available+u32(1)
    val fetch=if(available<size)available else size;var received=u32(0);var current=first
    while(received<fetch){if(current==esp32UartVfsNone)current=esp32UartVfsReadCharacter(port);if(current==esp32UartVfsNone)break
        if(current==u32(13)){val mode=esp32UartVfsGet(esp32UartVfsRxModes,port);if(mode==esp32UartVfsCarriageReturn)current=u32(10)else if(mode==esp32UartVfsCarriageReturnLineFeed){val next=esp32UartVfsReadCharacter(port);if(next==u32(10))current=u32(10)else if(next!=esp32UartVfsNone)esp32UartVfsReturnCharacter(port,next)}}
        esp32UartVfsStoreByte(data+received,current);received=received+u32(1);current=esp32UartVfsNone
    }
    if(current!=esp32UartVfsNone)esp32UartVfsReturnCharacter(port,current);esp32UartVfsRelease(port,false)
    if(received!=u32(0))return received;esp32UartVfsSetErrno(u32(11));return u32(0xffffffff)
