trusted fun esp32UartVfsReturnCharacter(port:u32,character:u32):void = esp32UartVfsSet(esp32UartVfsPeek,port,character)

trusted fun esp32UartVfsWrite(context:u32,port:u32,data:u32,size:u32):u32 {
