trusted fun esp32UartVfsAccess(context:u32,path:u32,mode:u32):u32 {if(esp32UartVfsPathPort(path)==esp32UartVfsNone){esp32UartVfsSetErrno(u32(2));return u32(0xffffffff)};if(mode==u32(0)||((mode&u32(1))==u32(0)&&(mode&u32(6))!=u32(0)))return u32(0);esp32UartVfsSetErrno(u32(13));return u32(0xffffffff)}

