trusted fun esp32S3Adc2SessionHardwareMatches(channel: int,attenuation: int,mode: int): bool {
    // Original ownership excludes pad/trim/clock changes throughout session.
    return (esp32S3SarRead(0x60008904)&0x40000000) != 0 &&
        (esp32S3SarRead(0x6000883c)&0x60000000) == 0x60000000 &&
        esp32S3AdcBusState() == 5 && esp32S3Adc2Prepared() &&
        (esp32S3Adc2ArbiterRead()&0x1ffc) == esp32S3Adc2ArbiterProfile(mode) &&
        (esp32S3Adc2Read(36)&0x600000ff) == 1 &&
        (esp32S3Adc2Read(52)&0x70000000) == 0x40000000 &&
        ((esp32S3Adc2Read(56)>>(channel*2))&3) == attenuation
}
