import "./irq_entries_esp32s3.ab"
// XEA2 medium-priority vectors. Direct jump preserves interrupted a0 until
// the shared IRQ entry saves it to EXCSAVEn. Link at VECBASE+180/+1c0.
// Other exception/high-level vectors are deliberately NOT supplied here.
// Address operands retain private LLVM definitions referenced by assembly;
// no exported/linker-visible callback names or opaque implementation.
trusted noescape extern:"inline-assembly" fun esp32S3MediumVectorAddressAssembly(template: string,constraints: string,vector: u32,entries: u32): u32
@naked
@noinline
@section(".iram1.abla.s3Level2Vector")
trusted fun esp32S3Level2Vector(): void =
    esp32S3ContextExtraAssembly(".Labla_s3_level2_vector:\nj .Labla_s3_irq_base+512\n.org .Labla_s3_level2_vector+64", "~{memory}")
@inline
trusted fun esp32S3Level2VectorAddress(): int =
    int(esp32S3MediumVectorAddressAssembly("movi $0, .Labla_s3_level2_vector", "=a,i,i,~{memory}", u32(nativeFunctionAddress(esp32S3Level2Vector)), u32(nativeFunctionAddress(esp32S3IrqEntries))))
@naked
@noinline
@section(".iram1.abla.s3Level3Vector")
trusted fun esp32S3Level3Vector(): void =
    esp32S3ContextExtraAssembly(".Labla_s3_level3_vector:\nj .Labla_s3_irq_base+1024\n.org .Labla_s3_level3_vector+64", "~{memory}")
@inline
trusted fun esp32S3Level3VectorAddress(): int =
    int(esp32S3MediumVectorAddressAssembly("movi $0, .Labla_s3_level3_vector", "=a,i,i,~{memory}", u32(nativeFunctionAddress(esp32S3Level3Vector)), u32(nativeFunctionAddress(esp32S3IrqEntries))))
