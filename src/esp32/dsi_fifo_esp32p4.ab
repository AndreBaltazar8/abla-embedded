import "./dsi_fifo_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4DsiRead(offset: int): u32 = u32(mmioLoadU32(0x500A0000+offset))
trusted fun p4DsiWrite(offset: int,value: u32): void { mmioStoreU32(0x500A0000+offset,int(value)); return }
trusted fun esp32P4DsiSubmitHeader(header: int,polls: int): int = esp32P4DsiSubmitHeaderOwned(header,polls)
trusted fun esp32P4DsiWritePayload(value: u32,polls: int): int = esp32P4DsiWritePayloadOwned(value,polls)
trusted fun esp32P4DsiReadPayload(polls: int): int = esp32P4DsiReadPayloadOwned(polls)
trusted fun esp32P4DsiWaitIdle(polls: int): bool = esp32P4DsiWaitIdleOwned(polls)
