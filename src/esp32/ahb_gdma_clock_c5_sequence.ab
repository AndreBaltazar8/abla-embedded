// C5 AHB GDMA v2: three RX/TX pairs, base60080000, PCRclock600960c0.
// Whole-controller lease: caller owns all DMA clients/ETM/IRQs/power and
// pins roots. Does not reset, clear events, alter arbitration or memory windows.
// status1ready2invalid3reset4bus-write5busy6local-write7closed.
// Attempted gate ownership: bit8 bus, bit9 force-register-clock; leasebit10.
type C5AhbGdmaClock=int
fun C5AhbGdmaClock.status(): int = this&255
fun c5AhbGdmaChannelBase(channel: int,tx: bool): int = if (channel < 0 || channel > 2) -1 else 0x70+channel*192+(if (tx) 96 else 0)
fun c5AhbGdmaEventBase(channel: int,tx: bool): int = if (channel < 0 || channel > 2) -1 else channel*16+(if (tx) 48 else 0)
trusted fun c5AhbGdmaAllParked(): bool {
    var channel=0
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            val tx=direction == 1
            val base=c5AhbGdmaChannelBase(channel,tx)
            val events=c5AhbGdmaEventBase(channel,tx)
            if ((c5AhbGdmaRead(base)&u32(if (tx) 65 else 33)) != u32(0) ||
                (c5AhbGdmaRead(base+16)&u32(if (tx) 15 else 30)) != u32(if (tx) 8 else 16) ||
                c5AhbGdmaRead(events) != u32(0) || c5AhbGdmaRead(events+8) != u32(0)) return false
            direction=direction+1
        }
        channel=channel+1
    }
    return true
}
trusted fun c5AhbGdmaClockOpenOwned(exclusive: bool): C5AhbGdmaClock {
    if (!exclusive) return C5AhbGdmaClock(2)
    val bus=c5AhbGdmaBusRead()
    if ((bus&u32(2)) != u32(0)) return C5AhbGdmaClock(3)
    var token=1024
    if ((bus&u32(1)) == u32(0)) {
        token=token|256;c5AhbGdmaBusWrite(bus|u32(1))
        if ((c5AhbGdmaBusRead()&u32(3)) != u32(1)) return C5AhbGdmaClock(token|4)
    }
    val misc=c5AhbGdmaRead(0x64)
    if ((misc&u32(1)) != u32(0)) return C5AhbGdmaClock(token|3)
    if (!c5AhbGdmaAllParked()) return C5AhbGdmaClock(token|5)
    if ((misc&u32(8)) == u32(0)) {
        token=token|512;c5AhbGdmaWrite(0x64,misc|u32(8))
        if ((c5AhbGdmaRead(0x64)&u32(9)) != u32(8)) return C5AhbGdmaClock(token|6)
    }
    return C5AhbGdmaClock(token|1)
}
trusted fun C5AhbGdmaClock.closeOwned(exclusive: bool): C5AhbGdmaClock {
    if (!exclusive || this < 0 || (this&~2047) != 0 || (this&1024) == 0 || this.status() < 1 || this.status() > 6) return this
    var token=this&1792
    val bus=c5AhbGdmaBusRead()
    if ((bus&u32(2)) != u32(0)) return C5AhbGdmaClock(token|3)
    if ((bus&u32(1)) != u32(0)) {
        if ((c5AhbGdmaRead(0x64)&u32(1)) != u32(0)) return C5AhbGdmaClock(token|3)
        if (!c5AhbGdmaAllParked()) return C5AhbGdmaClock(token|5)
    } else if (this.status() != 4 || (token&512) != 0) return C5AhbGdmaClock(token|4)
    if ((token&512) != 0) {
        c5AhbGdmaWrite(0x64,c5AhbGdmaRead(0x64)&~u32(8))
        if ((c5AhbGdmaRead(0x64)&u32(8)) != u32(0)) return C5AhbGdmaClock(token|6)
        token=token&~512
    }
    if ((token&256) != 0 && (bus&u32(1)) != u32(0)) {
        c5AhbGdmaBusWrite(c5AhbGdmaBusRead()&~u32(1))
        if ((c5AhbGdmaBusRead()&u32(1)) != u32(0)) return C5AhbGdmaClock(token|4)
    }
    return C5AhbGdmaClock(7)
}
