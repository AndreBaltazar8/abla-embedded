// ESP32/S3 scheduler critical level is XCHAL_EXCM_LEVEL=3. Architecture
// instructions are the only boundary; no runtime, allocation or SDK linkage.
trusted noescape extern:"inline-assembly" fun espXtensaCriticalRead(
    template: string, constraints: string): u32
trusted noescape extern:"inline-assembly" fun espXtensaCriticalUpdate(
    template: string, constraints: string, value: u32): u32

@inline
trusted fun espXtensaMaskSchedulerInterrupts(): u32 {
    val current = espXtensaCriticalRead("rsr.ps $0", "=a,~{memory}")
    // RSIL replaces the level, so do not lower an already stronger mask.
    if ((current & u32(15)) >= u32(3)) return current
    espXtensaCriticalRead("rsil $0, 3", "=a,~{memory}")
}

@inline
trusted fun espXtensaRestoreInterruptMask(saved: u32): void {
    // As XTOS_RESTORE_JUST_INTLEVEL: retain current window/exception state,
    // replacing only PS.INTLEVEL, then synchronize special-register writes.
    val ignored = espXtensaCriticalUpdate(
        "rsr.ps $0\nxor a8, $0, $1\nextui a8, a8, 0, 4\nxor a8, $0, a8\nwsr.ps a8\nrsync",
        "=&a,a,~{a8},~{memory}", saved)
    return
}
