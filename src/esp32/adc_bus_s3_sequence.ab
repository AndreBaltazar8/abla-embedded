// S3 adc_ll_calibration_prepare bus controls, IDF v6.0.2.
// Caller serializes all analog register access/RMW across cores and excludes
// sleep. exclusive=true additionally excludes every SAR/PWDET/temperature
// client for the lifetime; false can only borrow a prepared upstream lease.
// This is NOT an interoperation reference counter or SAR supply controller.
type Esp32S3AdcBus = int
fun Esp32S3AdcBus.bits(): int = this
fun Esp32S3AdcBus.status(): int = this&255
fun Esp32S3AdcBus.ready(): bool = this.status() == 1
// status0closed1ready2exclusive-required3readback4busy5borrow-lost.
// Original3 bits8..10, bit11attempted/owned, bit12borrowed. Preserve returned
// token even on failure. Close is retryable; never discard an unsuccessful one.
fun esp32S3AdcBusAddress(index: int): int = if (index == 0) 0x60008034 else if (index == 1) 0x6000e044 else 0x6000e048
fun esp32S3AdcBusMask(index: int): int = if (index == 0) 0x400000 else if (index == 1) 0x40000 else 0x10000
trusted fun esp32S3AdcBusState(): int {
    var result=0
    var index=0
    while (index < 3) {
        if ((esp32S3AdcBusRead(esp32S3AdcBusAddress(index))&esp32S3AdcBusMask(index)) != 0) result=result|(1<<index)
        index=index+1
    }
    return result
}
trusted fun esp32S3AdcBusField(index: int,set: bool): bool {
    val address=esp32S3AdcBusAddress(index)
    val mask=esp32S3AdcBusMask(index)
    val before=esp32S3AdcBusRead(address)
    val desired=(before&(4294967295^mask))|(if (set) mask else 0)
    if (desired != before) esp32S3AdcBusWrite(address,desired)
    return (esp32S3AdcBusRead(address)&mask) == (desired&mask)
}
trusted fun esp32S3AdcBusOpenOwned(exclusive: bool): Esp32S3AdcBus {
    val before=esp32S3AdcBusState()
    if (before == 5) return Esp32S3AdcBus(4097)
    if (!exclusive) return Esp32S3AdcBus(2)
    val token=(before<<8)|2048
    if (!esp32S3AdcBusField(0,true) || !esp32S3AdcBusField(1,false) || !esp32S3AdcBusField(2,true)) return Esp32S3AdcBus(token|3)
    return Esp32S3AdcBus(token|1)
}
// Caller must finish all analog calls/conversions and release dependent
// resources first. RTC busy checks supplement, not replace, that contract.
// No ROM analog access occurs while dismantling its bus.
trusted fun Esp32S3AdcBus.closeOwned(): Esp32S3AdcBus {
    val flags=this&0x1f00
    if ((flags&4096) != 0) return if (esp32S3AdcBusState() == 5) Esp32S3AdcBus(0) else Esp32S3AdcBus(flags|5)
    if ((flags&2048) == 0) return Esp32S3AdcBus(0)
    if ((esp32S3AdcBusRead(0x60008840)&0x3fc00000) != 0 ||
        (esp32S3AdcBusRead(0x6000880c)&0x30000) == 0x20000 ||
        (esp32S3AdcBusRead(0x60008830)&0x30000) == 0x20000) return Esp32S3AdcBus(flags|4)
    val original=(flags>>8)&7
    var index=2
    while (index >= 0) {
        if (!esp32S3AdcBusField(index,(original&(1<<index)) != 0)) return Esp32S3AdcBus(flags|3)
        index=index-1
    }
    return Esp32S3AdcBus(0)
}
