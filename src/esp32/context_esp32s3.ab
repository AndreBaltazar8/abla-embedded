import "./context_extra_esp32s3.ab"
// S3 windowed interrupt context, fixed no-SWPRI/no-overlay 192-byte frame.
// CALL0-only leaves; never invoke using an ordinary Abla function call.
// Entry: a1=allocated frame, original PC/PS/A0/A1/A12/A13 already saved by
// the vector shell at4/8/12/16/60/64. PS.EXCM set; working window vectors,
// valid interrupted stack and original a2..a11/a14/a15 still live.
// Save preserves shell a12/a13 and CALL0 return a0; spills all64 registers.
// Restore reloads original a2..a15/SAR/loops/NCP; shell must restore PC/PS/A0/SP.
// This is not an interrupt entry, scheduler or FPU/SIMD coprocessor owner.
// Frame: base112, NCP36, padding12, nested/base-save reserve32 =192.
// NCP operations inline so no external or address-taken helper dependency.
@naked
@noinline
@section(".iram1.abla.s3ContextSave")
trusted fun esp32S3ContextSave(): void =
    esp32S3ContextExtraAssembly("s32i a2, a1, 20\ns32i a3, a1, 24\ns32i a4, a1, 28\ns32i a5, a1, 32\ns32i a6, a1, 36\ns32i a7, a1, 40\ns32i a8, a1, 44\ns32i a9, a1, 48\ns32i a10, a1, 52\ns32i a11, a1, 56\ns32i a14, a1, 68\ns32i a15, a1, 72\nrsr.sar a3\ns32i a3, a1, 76\nrsr.lbeg a3\ns32i a3, a1, 88\nrsr.lend a3\ns32i a3, a1, 92\nrsr.lcount a3\ns32i a3, a1, 96\ns32i a12, a1, 100\ns32i a13, a1, 104\ns32i a0, a1, 108\nrur.threadptr a3\ns32i a3, a1, 112\nrsr.acclo a3\ns32i a3, a1, 116\nrsr.acchi a3\ns32i a3, a1, 120\nrsr.br a3\ns32i a3, a1, 124\nrsr.scompare1 a3\ns32i a3, a1, 128\nrsr.m0 a3\ns32i a3, a1, 132\nrsr.m1 a3\ns32i a3, a1, 136\nrsr.m2 a3\ns32i a3, a1, 140\nrsr.m3 a3\ns32i a3, a1, 144\nl32i a12, a1, 60\nl32i a13, a1, 64\nrsr.ps a2\nmovi a0, 15\nand a3, a2, a0\nbgeui a3, 3, .Labla_s3_context_level\nmovi a3, 3\n.Labla_s3_context_level:\nmovi a0, 262176\nor a3, a3, a0\nwsr.ps a3\nrsr.epc1 a0\naddmi a1, a1, 256\naddi a1, a1, -64\nand a12, a12, a12\nrotw 3\nand a12, a12, a12\nrotw 3\nand a12, a12, a12\nrotw 3\nand a12, a12, a12\nrotw 3\nand a12, a12, a12\nrotw 4\naddmi a1, a1, -256\naddi a1, a1, 64\nwsr.ps a2\nrsync\nwsr.epc1 a0\nl32i a12, a1, 100\nl32i a13, a1, 104\nl32i a0, a1, 108\nret", "~{memory}")
@naked
@noinline
@section(".iram1.abla.s3ContextRestore")
trusted fun esp32S3ContextRestore(): void =
    esp32S3ContextExtraAssembly("l32i a3, a1, 112\nwur.threadptr a3\nl32i a3, a1, 116\nwsr.acclo a3\nl32i a3, a1, 120\nwsr.acchi a3\nl32i a3, a1, 124\nwsr.br a3\nl32i a3, a1, 128\nwsr.scompare1 a3\nl32i a3, a1, 132\nwsr.m0 a3\nl32i a3, a1, 136\nwsr.m1 a3\nl32i a3, a1, 140\nwsr.m2 a3\nl32i a3, a1, 144\nwsr.m3 a3\nl32i a3, a1, 88\nwsr.lbeg a3\nl32i a3, a1, 92\nwsr.lend a3\nl32i a3, a1, 96\nwsr.lcount a3\nl32i a3, a1, 76\nwsr.sar a3\nl32i a2, a1, 20\nl32i a3, a1, 24\nl32i a4, a1, 28\nl32i a5, a1, 32\nl32i a6, a1, 36\nl32i a7, a1, 40\nl32i a8, a1, 44\nl32i a9, a1, 48\nl32i a10, a1, 52\nl32i a11, a1, 56\nl32i a12, a1, 60\nl32i a13, a1, 64\nl32i a14, a1, 68\nl32i a15, a1, 72\nrsync\nret", "~{memory}")
@inline
trusted fun esp32S3ContextSaveAddress(): int = nativeFunctionAddress(esp32S3ContextSave)
@inline
trusted fun esp32S3ContextRestoreAddress(): int = nativeFunctionAddress(esp32S3ContextRestore)
