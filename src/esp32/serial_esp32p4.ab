import "./uart/serial_p4_sequence.ab"
import "./uart/config_p4_sequence.ab"
import "abla/unsafe/mmio"
// Both P4 register layouts share HP UART bases/status/FIFO/FSM offsets.
trusted fun p4SerialRead(unit: int,offset: int): int = mmioLoadU32(0x500ca000+unit*4096+offset)
trusted fun p4SerialWriteFifo(unit: int,value: int): void { mmioStoreU32(0x500ca000+unit*4096,value); return }
trusted fun p4SerialConfigWrite(unit: int,offset: int,value: int): void { mmioStoreU32(0x500ca000+unit*4096+offset,value); return }
trusted fun p4SerialClockRead(unit: int): int = mmioLoadU32(0x500e606c+unit*4)
trusted fun p4SerialClockWrite(unit: int,value: int): void { mmioStoreU32(0x500e606c+unit*4,value); return }
