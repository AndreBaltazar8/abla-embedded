import "./uart/serial_p4_sequence.ab"
import "./uart/config_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
// Both P4 register layouts share HP UART bases/status/FIFO/FSM offsets.
@export("p4SerialRead")
trusted fun p4SerialReadHook(unit: int,offset: int): int = mmioLoadU32(0x500ca000+unit*4096+offset)
@export("p4SerialWriteFifo")
trusted fun p4SerialWriteFifoHook(unit: int,value: int): void { mmioStoreU32(0x500ca000+unit*4096,value); return }
@export("p4SerialConfigWrite")
trusted fun p4SerialConfigWriteHook(unit: int,offset: int,value: int): void { mmioStoreU32(0x500ca000+unit*4096+offset,value); return }
@export("p4SerialClockRead")
trusted fun p4SerialClockReadHook(unit: int): int = mmioLoadU32(0x500e606c+unit*4)
@export("p4SerialClockWrite")
trusted fun p4SerialClockWriteHook(unit: int,value: int): void { mmioStoreU32(0x500e606c+unit*4,value); return }
