import "./ahb_gdma_acquire_p4_sequence.ab"
import "./ahb_gdma_ring_esp32p4.ab"
import "./cache_writeback_esp32p4.ab"
import "../riscv/memory.ab"
trusted fun p4AhbAcquireFence(): void = riscvDeviceMemoryFence()
trusted fun p4AhbAcquireEvents(address: int): int = mmioLoadU32(address)
trusted fun p4AhbAcquireLoad(address: int): int = nativeAddressLoadU32(address,0)
trusted fun p4AhbAcquireInvalidate(buffer: NativeBuffer,bytes: int,polls: int): int = esp32P4CacheInvalidateDataOwned(buffer,bytes,64,polls)
