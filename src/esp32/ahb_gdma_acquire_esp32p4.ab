import "./ahb_gdma_acquire_p4_sequence.ab"
import "./ahb_gdma_ring_esp32p4.ab"
import "./cache_writeback_esp32p4.ab"
import "../riscv/memory.ab"
import "../hal/esp32.ab"
import "abla/unsafe/mmio"
import "./sdk/raw_buffer.ab"
import "./cache_writeback_p4_sequence.ab"
import "./sdk/nativebuffer_type.ab"
@export("p4AhbAcquireFence")
trusted fun p4AhbAcquireFenceHook(): void = riscvDeviceMemoryFence()
@export("p4AhbAcquireEvents")
trusted fun p4AhbAcquireEventsHook(address: int): int = mmioLoadU32(address)
@export("p4AhbAcquireLoad")
trusted fun p4AhbAcquireLoadHook(address: int): int = nativeAddressLoadU32(address,0)
@export("p4AhbAcquireInvalidate")
trusted fun p4AhbAcquireInvalidateHook(buffer: NativeBuffer,bytes: int,polls: int): int = esp32P4CacheInvalidateDataOwned(buffer,bytes,64,polls)
