import "abla/unsafe/memory"

// Target memory-layout values supplied by the final linker script. These are
// object-format boundaries, not Xtensa instructions and not opaque libraries.
val esp32LinkerThreadLocalDataStart = u32(nativeLinkerSymbolAddress("_thread_local_data_start"))
val esp32LinkerThreadLocalDataEnd = u32(nativeLinkerSymbolAddress("_thread_local_data_end"))
val esp32LinkerThreadLocalBssStart = u32(nativeLinkerSymbolAddress("_thread_local_bss_start"))
val esp32LinkerThreadLocalBssEnd = u32(nativeLinkerSymbolAddress("_thread_local_bss_end"))
val esp32LinkerThreadLocalAlignment = u32(nativeLinkerSymbolAddress("_tls_section_alignment"))

val esp32LinkerInstructionReservedStart = u32(nativeLinkerSymbolAddress("_instruction_reserved_start"))
val esp32LinkerInstructionReservedEnd = u32(nativeLinkerSymbolAddress("_instruction_reserved_end"))
