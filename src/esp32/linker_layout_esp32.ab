val esp32LinkerIramStart = u32(nativeLinkerSymbolAddress("_iram_start"))
val esp32LinkerIramEnd = u32(nativeLinkerSymbolAddress("_iram_end"))
val esp32LinkerDataStart = u32(nativeLinkerSymbolAddress("_data_start"))
val esp32LinkerHeapStart = u32(nativeLinkerSymbolAddress("_heap_start"))

val esp32LinkerVectorTable = u32(nativeLinkerSymbolAddress("_vector_table"))
val esp32LinkerBssStart = u32(nativeLinkerSymbolAddress("_bss_start"))
val esp32LinkerBssEnd = u32(nativeLinkerSymbolAddress("_bss_end"))
val esp32LinkerRtcBssStart = u32(nativeLinkerSymbolAddress("_rtc_bss_start"))
