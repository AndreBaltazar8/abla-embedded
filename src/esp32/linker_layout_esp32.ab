val esp32LinkerRodataReservedEnd = u32(nativeLinkerSymbolAddress("_rodata_reserved_end"))

val esp32LinkerSocReservedMemoryStart = u32(nativeLinkerSymbolAddress("soc_reserved_memory_region_start"))
val esp32LinkerSocReservedMemoryEnd = u32(nativeLinkerSymbolAddress("soc_reserved_memory_region_end"))
val esp32LinkerRtcSlowReservedStart = u32(nativeLinkerSymbolAddress("_rtc_slow_reserved_start"))
val esp32LinkerRtcSlowReservedEnd = u32(nativeLinkerSymbolAddress("_rtc_slow_reserved_end"))
val esp32LinkerRtcFastReservedStart = u32(nativeLinkerSymbolAddress("_rtc_fast_reserved_start"))
