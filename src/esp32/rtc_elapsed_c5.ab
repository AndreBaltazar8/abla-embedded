import "./rtc_timer_c5_sequence.ab"
import "../runtime/rtc_time48.ab"
// Same uninterrupted RTC clock/calibration across both snapshots. At most
// one modulo48 interval; caller rules out reset and multiple wraps. Return
// elapsed microseconds, not a scheduler adjustment: subtract independently
// measured awake time before advancing any clock which kept running.
@section(".iram1.abla.c5RtcElapsedUs")
fun esp32C5RtcElapsedMicroseconds(before: int,after: int,periodQ19: int): int =
    rtc48MicrosecondsForTicks(esp32C5RtcElapsedTicks(before,after),periodQ19)
