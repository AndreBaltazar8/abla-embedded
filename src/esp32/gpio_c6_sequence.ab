import "abla/runtime/scalar"
// ESP32-C6 GPIO0..30, IDF6 register map. GPIO base60091000, IOMUX60090000.
// Caller owns pad/former peripheral users, pins GPIO/IOMUX clocks and proves
// global sleep/force holds released. Board reservations (flash etc.) are NOT
// inferred from a valid pin number. No IRQ/clock/RTC/USB takeover here.
fun esp32C6GpioNumberValid(pin: int): bool = pin >= 0 && pin < 31
trusted fun esp32C6GpioReadOwned(pin: int): int =
    if (!esp32C6GpioNumberValid(pin)) -1 else int((c6GpioRead(0x6009103c)>>u32(pin))&u32(1))
trusted fun esp32C6GpioWriteOwned(pin: int,high: bool): bool {
    if (!esp32C6GpioNumberValid(pin)) return false
    c6GpioWrite(if (high) 0x60091008 else 0x6009100c,u32(1)<<u32(pin))
    return true
}
trusted fun c6GpioField(address: int,mask: u32,value: u32): bool {
    c6GpioWrite(address,(c6GpioRead(address)&(u32(0xffffffff)^mask))|value)
    return (c6GpioRead(address)&mask) == value
}
// 1configured2invalid3unowned/held/RTC-or-USB active4readback failure.
// Disable GPIO OE then select that OE before changing latch/route; this
// disconnects peripheral OE without a transient output during configuration.
// No rollback: partial failure retains pad ownership, output not guaranteed.
trusted fun esp32C6GpioConfigureOwned(pin: int,output: bool,high: bool,openDrain: bool,input: bool,pull: int,exclusive: bool): int {
    if (!esp32C6GpioNumberValid(pin) || pull < 0 || pull > 2) return 2
    val bit=u32(1)<<u32(pin)
    if (!exclusive || (c6GpioRead(0x600b102c)&bit) != u32(0) ||
        (pin < 8 && (c6GpioRead(0x600b1028)&bit) != u32(0)) ||
        ((pin == 12 || pin == 13) && (c6GpioRead(0x6000f018)&u32(16384)) != u32(0))) return 3
    val route=0x60091554+pin*4
    c6GpioWrite(0x60091028,bit)
    if ((c6GpioRead(0x60091020)&bit) != u32(0) || !c6GpioField(route,u32(1536),u32(512))) return 4
    esp32C6GpioWriteOwned(pin,high)
    if (((c6GpioRead(0x60091004)&bit) != u32(0)) != high) return 4
    if (!c6GpioField(0x60091074+pin*4,u32(4),if (openDrain) u32(4) else u32(0)) ||
        !c6GpioField(route,u32(2047),u32(640))) return 4
    val mux=u32(4096)|(if (input) u32(512) else u32(0))|
        (if (pull == 1) u32(256) else if (pull == 2) u32(128) else u32(0))
    if (!c6GpioField(0x60090004+pin*4,u32(29570),mux)) return 4
    if (output) {
        c6GpioWrite(0x60091024,bit)
        if ((c6GpioRead(0x60091020)&bit) == u32(0)) return 4
    }
    return 1
}
