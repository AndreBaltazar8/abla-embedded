// P4 internal analog register bus, NOT external GPIO I2C. Caller holds global
// analog-bus/RCC exclusion across both CPUs and masters for the whole sequence.
// Root clock/configuration and target analog power are caller prerequisites.
// Routing remains changed/owned after return. Never reset or gate off a timed
// out transaction: it may still complete. No ROM/SDK library dependency.
// Low8 status1complete2invalid3clock/reset4prebusy5route readback6posttimeout;
// read byte bits8..15. Write completion means BUSY cleared, not byte readback.
fun p4AnalogBlockMask(block: int): int {
    if (block == 0x6d) return 1<<10
    if (block == 0x67) return 1<<11
    if (block == 0x62) return 1<<6
    if (block == 0x6a) return 1<<12
    if (block == 0x63) return 1<<9
    if (block == 0x66) return 1<<5
    if (block == 0x6f) return 1<<8
    if (block == 0x69) return 1<<7
    return 0
}
trusted fun p4AnalogWaitIdle(offset: int,polls: int): bool {
    var remaining=polls
    while (remaining > 0) {
        if ((p4AnalogRead(offset)&0x02000000) == 0) return true
        remaining=remaining-1
    }
    return false
}
trusted fun p4AnalogRouteField(offset: int,value: int): bool {
    p4AnalogWrite(offset,(p4AnalogRead(offset)&0xff000000)|value)
    return (p4AnalogRead(offset)&0x00ffffff) == value
}
trusted fun p4AnalogRegisterOwned(block: int,index: int,value: int,write: bool,polls: int): int {
    val mask=p4AnalogBlockMask(block)
    if (mask == 0 || index < 0 || index > 255 || value < 0 || value > 255 || polls < 1 || polls > 1000000) return 2
    if (!p4AnalogClockReady()) return 3
    // Check BOTH masters before changing routing, unlike changing routes and
    // only then waiting for master0. Exclusion prevents a new peer transaction.
    if (!p4AnalogWaitIdle(0,polls) || !p4AnalogWaitIdle(4,polls)) return 4
    if (!p4AnalogRouteField(32,0) || !p4AnalogRouteField(28,0) || !p4AnalogRouteField(32,mask)) return 5
    p4AnalogWrite(0,block|(index<<8)|(if (write) (1<<24)|(value<<16) else 0))
    if (!p4AnalogWaitIdle(0,polls)) return 6
    return if (write) 1 else 1|(((p4AnalogRead(0)>>>16)&255)<<8)
}
// Read/modify/write under the same caller exclusion; unselected bits retained.
// On write timeout the device may have changed; no forced-success or rollback.
trusted fun p4AnalogRegisterMaskOwned(block: int,index: int,lsb: int,msb: int,value: int,polls: int): int {
    if (lsb < 0 || msb > 7 || msb < lsb || value < 0) return 2
    val fieldMask=(u32(1)<<u32(msb-lsb+1))-u32(1)
    if (u32(value) > fieldMask || value > 255) return 2
    val read=p4AnalogRegisterOwned(block,index,0,false,polls)
    if ((read&255) != 1) return read
    val mask=fieldMask<<u32(lsb)
    val desired=((u32(read)>>u32(8))&(u32(255)^mask))|(u32(value)<<u32(lsb))
    return p4AnalogRegisterOwned(block,index,int(desired),true,polls)
}
