import "./register_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4AnalogClockReady(): bool = (mmioLoadU32(0x50120000)&0x08000000) != 0 && (mmioLoadU32(0x50120008)&0x04000000) == 0
trusted fun p4AnalogRead(offset: int): int = mmioLoadU32(0x50124000+offset)
trusted fun p4AnalogWrite(offset: int,value: int): void { mmioStoreU32(0x50124000+offset,value); return }
