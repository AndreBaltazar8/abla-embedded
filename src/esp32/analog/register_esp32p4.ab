import "./register_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_analog.ab"
trusted fun p4AnalogClockReady(): bool = (mmioLoadU32(0x50120000)&0x08000000) != 0 && (mmioLoadU32(0x50120008)&0x04000000) == 0
@export("p4AnalogRead")
trusted fun p4AnalogReadHook(offset: int): int = mmioLoadU32(0x50124000+offset)
@export("p4AnalogWrite")
trusted fun p4AnalogWriteHook(offset: int,value: int): void { mmioStoreU32(0x50124000+offset,value); return }
