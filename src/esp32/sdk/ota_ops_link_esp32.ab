import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkOtaOpsOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspOtaEraseLastBootAppPartition", "esp_ota_erase_last_boot_app_partition")) return false
    if (!internalFunction("esp32RecoveredEspOtaInvalidateInactiveOtaDataSlot", "esp_ota_invalidate_inactive_ota_data_slot")) return false
    if (!internalFunction("esp32RecoveredEspOtaMarkAppInvalidRollback", "esp_ota_mark_app_invalid_rollback")) return false
    if (!internalFunction("esp32RecoveredEspOtaMarkAppValidCancelRollback", "esp_ota_mark_app_valid_cancel_rollback")) return false
    if (!internalFunction("esp32RecoveredEspOtaMarkAppInvalidRollbackAndReboot", "esp_ota_mark_app_invalid_rollback_and_reboot")) return false
    if (!internalFunction("esp32RecoveredEspOtaAbort", "esp_ota_abort")) return false
    if (!internalFunction("esp32RecoveredEspOtaGetAppPartitionCount", "esp_ota_get_app_partition_count")) return false
    if (!internalFunction("esp32RecoveredEspOtaGetPartitionDescription", "esp_ota_get_partition_description")) return false
    if (!internalFunction("esp32RecoveredEspOtaSetBootPartition", "esp_ota_set_boot_partition")) return false
    if (!internalFunction("esp32RecoveredEspOtaGetLastInvalidPartition", "esp_ota_get_last_invalid_partition")) return false
    if (!internalFunction("esp32RecoveredEspOtaGetNextUpdatePartition", "esp_ota_get_next_update_partition")) return false
    if (!internalFunction("esp32RecoveredEspOtaGetBootloaderDescription", "esp_ota_get_bootloader_description")) return false
    if (!internalFunction("esp32RecoveredEspOtaGetBootPartition", "esp_ota_get_boot_partition")) return false
    if (!exportFunction("esp32RecoveredEspOtaGetRunningPartition", "esp_ota_get_running_partition")) return false
    if (!internalFunction("esp32RecoveredEspOtaGetStatePartition", "esp_ota_get_state_partition")) return false
    if (!internalFunction("esp32RecoveredEspOtaSetFinalPartition", "esp_ota_set_final_partition")) return false
    if (!internalFunction("esp32RecoveredEspOtaResume", "esp_ota_resume")) return false
    if (!internalFunction("esp32RecoveredEspOtaCheckRollbackIsPossible", "esp_ota_check_rollback_is_possible")) return false
    if (!internalFunction("esp32RecoveredEspOtaWriteWithOffset", "esp_ota_write_with_offset")) return false
    if (!internalFunction("esp32RecoveredEspOtaBegin", "esp_ota_begin")) return false
    if (!internalFunction("esp32RecoveredEspOtaEnd", "esp_ota_end")) return false
    if (!internalFunction("esp32RecoveredEspOtaWrite", "esp_ota_write")) return false
    true
}
