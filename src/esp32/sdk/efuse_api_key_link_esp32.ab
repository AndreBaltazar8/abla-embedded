import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEfuseApiKeyOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspEfuseSetWriteProtect", "esp_efuse_set_write_protect")) return false
    if (!internalFunction("esp32RecoveredEspEfuseSetReadProtect", "esp_efuse_set_read_protect")) return false
    if (!internalFunction("esp32RecoveredEspEfuseGetCodingScheme", "esp_efuse_get_coding_scheme")) return false
    if (!internalFunction("esp32RecoveredEspEfuseBlockIsEmpty", "esp_efuse_block_is_empty")) return false
    if (!internalFunction("esp32RecoveredEspEfuseGetKeyDisRead", "esp_efuse_get_key_dis_read")) return false
    if (!internalFunction("esp32RecoveredEspEfuseSetKeyDisRead", "esp_efuse_set_key_dis_read")) return false
    if (!internalFunction("esp32RecoveredEspEfuseGetKeyDisWrite", "esp_efuse_get_key_dis_write")) return false
    if (!internalFunction("esp32RecoveredEspEfuseSetKeyDisWrite", "esp_efuse_set_key_dis_write")) return false
    if (!internalFunction("esp32RecoveredEspEfuseKeyBlockUnused", "esp_efuse_key_block_unused")) return false
    if (!internalFunction("esp32RecoveredEspEfuseGetKeyPurpose", "esp_efuse_get_key_purpose")) return false
    if (!internalFunction("esp32RecoveredEspEfuseGetKeypurposeDisWrite", "esp_efuse_get_keypurpose_dis_write")) return false
    if (!internalFunction("esp32RecoveredEspEfuseFindPurpose", "esp_efuse_find_purpose")) return false
    if (!internalFunction("esp32RecoveredEspEfuseWriteKey", "esp_efuse_write_key")) return false
    if (!internalFunction("esp32RecoveredEspEfuseWriteKeys", "esp_efuse_write_keys")) return false
    true
}
