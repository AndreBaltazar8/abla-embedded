import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun linkRecoveredOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspEfuseSetTiming", "esp_efuse_set_timing")) return false
    if (!internalFunction("esp32RecoveredApplyRepeatEncoding", "apply_repeat_encoding")) return false
    if (!internalFunction("esp32RecoveredReadRData", "read_r_data")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityClearProgramRegisters", "esp_efuse_utility_clear_program_registers")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityCheckErrors", "esp_efuse_utility_check_errors")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityBurnChip", "esp_efuse_utility_burn_chip")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityBurnChipOpt", "esp_efuse_utility_burn_chip_opt")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityApplyNewCodingScheme", "esp_efuse_utility_apply_new_coding_scheme")) return false
    true
}
