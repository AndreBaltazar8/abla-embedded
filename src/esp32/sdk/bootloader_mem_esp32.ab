import "../cpu/region_protection_esp32.ab"

// Abla/LLVM implementation of ESP32 bootloader memory-region initialization.
// The call is now visible in the Abla/LLVM graph even while the target-specific
// MPU sequence is migrated separately.

// Original ABI symbol: bootloader_init_mem
trusted fun esp32RecoveredBootloaderInitMem(): void {
    esp32RecoveredEspCpuConfigureRegionProtection(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}
