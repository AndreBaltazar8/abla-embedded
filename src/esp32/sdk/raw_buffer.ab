import "abla/unsafe/memory/raw"

// A checked persistent native region encoded as one scalar: the low 32 bits
// hold the ESP32 address and the high 31 bits hold its capacity. This keeps
// buffer arguments on the direct scalar ABI and avoids a heap wrapper.
import "./nativebuffer_type.ab"
import "../../hal/native_buffer.ab"

@export("nativeBufferAt")
trusted fun nativeBufferAtHook(address: int, capacity: int): NativeBuffer {
    var size = capacity
    if (size < 0) size = 0
    if (size > 2147483647) size = 2147483647
    NativeBuffer((address & 4294967295) | (size << 32))
}

fun NativeBuffer.addressValue(): int = this & 4294967295

fun NativeBuffer.capacity(): int = (this >>> 32) & 2147483647

// Check both the logical slice and the 32-bit target address span. This does
// not prove memory ownership/accessibility; the caller still supplies those.
// Empty spans require no dereference, including an empty null buffer.
// The body is in IRAM, like loadU32 and storeU32: the sleep, wake and MSPI code
// calls these with the caches off (tools/check-iram-calls), and each is only a
// few words. A method cannot take @section, so the inline method calls it.
@inline
fun NativeBuffer.hasAddressRange(offset: int, count: int): bool =
    nativeBufferHasAddressRange(this, offset, count)

@section(".iram1.abla.nativeBufferHasAddressRange")
fun nativeBufferHasAddressRange(buffer: NativeBuffer, offset: int, count: int): bool {
    if (offset < 0 || count < 0 || offset > buffer.capacity() ||
        count > buffer.capacity() - offset) return false
    if (count == 0) return true
    buffer.addressValue() != 0 &&
        buffer.addressValue() + offset <= 4294967296 - count
}

trusted fun NativeBuffer.pointer(): i64* =
    nativePointerFromAddress(this.addressValue())

trusted fun NativeBuffer.pointerAt(offset: int): i64* {
    var result = nativeNullPointer()
    if (offset >= 0 && offset <= this.capacity()) {
        result = nativePointerFromAddress(this.addressValue() + offset)
    }
    result
}

trusted fun NativeBuffer.load(index: int): int {
    if (index < 0 || index >= this.capacity()) 0
    else ablaUnsafeLoadU8(
        nativePointerFromAddress(this.addressValue() + index)
    )
}

trusted fun NativeBuffer.store(index: int, value: int): bool {
    var stored = false
    if (index >= 0 && index < this.capacity()) {
        ablaUnsafeStoreU8(
            nativePointerFromAddress(this.addressValue() + index), value
        )
        stored = true
    }
    stored
}

trusted fun NativeBuffer.storeU16(offset: int, value: int): bool {
    var stored = false
    if (offset >= 0 && offset <= this.capacity() - 2) {
        val address = this.addressValue() + offset
        ablaUnsafeStoreU8(nativePointerFromAddress(address), value)
        ablaUnsafeStoreU8(
            nativePointerFromAddress(address + 1), value >>> 8
        )
        stored = true
    }
    stored
}

@inline
trusted fun NativeBuffer.storeU32(offset: int, value: int): bool =
    nativeBufferStoreU32(this, offset, value)

@section(".iram1.abla.nativeBufferStoreU32")
trusted fun nativeBufferStoreU32(buffer: NativeBuffer, offset: int, value: int): bool {
    var stored = false
    if (offset >= 0 && offset <= buffer.capacity() - 4) {
        val address = buffer.addressValue() + offset
        ablaUnsafeStoreU8(nativePointerFromAddress(address), value)
        ablaUnsafeStoreU8(
            nativePointerFromAddress(address + 1), value >>> 8
        )
        ablaUnsafeStoreU8(
            nativePointerFromAddress(address + 2), value >>> 16
        )
        ablaUnsafeStoreU8(
            nativePointerFromAddress(address + 3), value >>> 24
        )
        stored = true
    }
    stored
}

trusted fun NativeBuffer.loadU16(offset: int): int {
    if (offset < 0 || offset > this.capacity() - 2) 0
    else {
        val address = this.addressValue() + offset
        ablaUnsafeLoadU8(nativePointerFromAddress(address)) |
            (ablaUnsafeLoadU8(nativePointerFromAddress(address + 1)) << 8)
    }
}

@inline
trusted fun NativeBuffer.loadU32(offset: int): int =
    nativeBufferLoadU32(this, offset)

@section(".iram1.abla.nativeBufferLoadU32")
trusted fun nativeBufferLoadU32(buffer: NativeBuffer, offset: int): int {
    if (offset < 0 || offset > buffer.capacity() - 4) 0
    else {
        val address = buffer.addressValue() + offset
        ablaUnsafeLoadU8(nativePointerFromAddress(address)) |
            (ablaUnsafeLoadU8(nativePointerFromAddress(address + 1)) << 8) |
            (ablaUnsafeLoadU8(nativePointerFromAddress(address + 2)) << 16) |
            (ablaUnsafeLoadU8(nativePointerFromAddress(address + 3)) << 24)
    }
}

trusted fun nativeAddressPointer(address: int, offset: int): i64* =
    nativePointerFromAddress(address + offset)

trusted fun nativeAddressStoreU8(
    address: int,
    offset: int,
    value: int
): void {
    ablaUnsafeStoreU8(nativeAddressPointer(address, offset), value)
    return
}

trusted fun nativeAddressStoreU16(
    address: int,
    offset: int,
    value: int
): void {
    ablaUnsafeStoreU16(nativeAddressPointer(address, offset), value)
    return
}

trusted fun nativeAddressStoreU32(
    address: int,
    offset: int,
    value: int
): void {
    ablaUnsafeStoreU32(nativeAddressPointer(address, offset), value)
    return
}

trusted fun nativeAddressLoadU16(address: int, offset: int): int =
    ablaUnsafeLoadU16(nativeAddressPointer(address, offset))

trusted fun nativeAddressLoadU32(address: int, offset: int): int =
    ablaUnsafeLoadU32(nativeAddressPointer(address, offset))

trusted fun nativeAddressClear(address: int, size: int): void {
    ablaUnsafeSetMemory(nativePointerFromAddress(address), 0, size)
    return
}

trusted fun nativeAddressCopyText(
    address: int,
    offset: int,
    capacity: int,
    text: string
): int {
    var copied = 0
    while (copied < text.size && copied + 1 < capacity) {
        nativeAddressStoreU8(address, offset + copied, text[copied])
        copied = copied + 1
    }
    if (capacity > 0) nativeAddressStoreU8(address, offset + copied, 0)
    copied
}
