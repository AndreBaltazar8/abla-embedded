import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkBootloaderCommonLoaderOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBootloaderCommonOtaSelectCrc", "bootloader_common_ota_select_crc")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonOtaSelectInvalid", "bootloader_common_ota_select_invalid")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonOtaSelectValid", "bootloader_common_ota_select_valid")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonGetActiveOtadata", "bootloader_common_get_active_otadata")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonSelectOtadata", "bootloader_common_select_otadata")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonCheckChipValidity", "bootloader_common_check_chip_validity")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonCheckChipRevisionValidity", "bootloader_common_check_chip_revision_validity")) return false
    true
}
