import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEfuseUtilityOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspEfuseUtilityFillBuff", "esp_efuse_utility_fill_buff")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityCountOnce", "esp_efuse_utility_count_once")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityProcess", "esp_efuse_utility_process")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityReset", "esp_efuse_utility_reset")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityBurnEfuses", "esp_efuse_utility_burn_efuses")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityEraseVirtBlocks", "esp_efuse_utility_erase_virt_blocks")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityUpdateVirtBlocks", "esp_efuse_utility_update_virt_blocks")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityDebugDumpSingleBlock", "esp_efuse_utility_debug_dump_single_block")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityDebugDumpPending", "esp_efuse_utility_debug_dump_pending")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityDebugDumpBlocks", "esp_efuse_utility_debug_dump_blocks")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityGetNumberOfItems", "esp_efuse_utility_get_number_of_items")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityReadReg", "esp_efuse_utility_read_reg")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityWriteCnt", "esp_efuse_utility_write_cnt")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityWriteReg", "esp_efuse_utility_write_reg")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityWriteBlob", "esp_efuse_utility_write_blob")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityGetReadRegisterAddress", "esp_efuse_utility_get_read_register_address")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUtilityIsCorrectWrittenData", "esp_efuse_utility_is_correct_written_data")) return false
    true
}
