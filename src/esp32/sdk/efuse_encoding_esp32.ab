import "../../runtime/freestanding_integer.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32EfuseEncodingLoad(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32EfuseEncodingStore(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32EfuseApplyThreeQuarterEncoding(
    input: u32, output: u32, inputLength: u32
): u32 {
    if (input == u32(0) || output == u32(0) ||
        inputLength % u32(6) != u32(0)) return u32(258)
    var source = input
    var destination = output
    var remaining = inputLength
    while (remaining != u32(0)) {
        var parity = u32(0)
        var weighted = u32(0)
        var index = u32(0)
        while (index < u32(6)) {
            val byte = esp32EfuseEncodingLoad(source + index)
            esp32EfuseEncodingStore(destination + index, byte)
            parity = parity ^ byte
            weighted = weighted + (index + u32(1)) *
                u32(freestandingPopulationCount32(byte))
            index = index + u32(1)
        }
        esp32EfuseEncodingStore(destination + u32(6), parity)
        esp32EfuseEncodingStore(destination + u32(7), weighted)
        source = source + u32(6)
        destination = destination + u32(8)
        remaining = remaining - u32(6)
    }
    u32(0)
}

trusted fun esp32RecoveredEspEfuseUtilityApply34Encoding(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32EfuseApplyThreeQuarterEncoding(a2,a3,a4)
