import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkBootloaderFlashOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBootloaderFlashIsOctalModeEnabled", "bootloader_flash_is_octal_mode_enabled")) return false
    if (!internalFunction("esp32RecoveredBootloaderMmapGetFreePages", "bootloader_mmap_get_free_pages")) return false
    if (!internalFunction("esp32RecoveredBootloaderEnableWp", "bootloader_enable_wp")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashEraseRange", "bootloader_flash_erase_range")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashEraseSector", "bootloader_flash_erase_sector")) return false
    if (!internalFunction("esp32RecoveredBootloaderMunmap", "bootloader_munmap")) return false
    if (!internalFunction("esp32RecoveredBootloaderExecuteFlashCommand", "bootloader_execute_flash_command")) return false
    if (!internalFunction("esp32RecoveredBootloaderSpiFlashReset", "bootloader_spi_flash_reset")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashWrite", "bootloader_flash_write")) return false
    if (!internalFunction("esp32RecoveredBootloaderReadFlashId", "bootloader_read_flash_id")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashRead", "bootloader_flash_read")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashGetSpiMode", "bootloader_flash_get_spi_mode")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashReadSfdp", "bootloader_flash_read_sfdp")) return false
    if (!internalFunction("esp32RecoveredBootloaderMmap", "bootloader_mmap")) return false
    if (!exportFunction("esp32RecoveredBootloaderFlashResetChip", "bootloader_flash_reset_chip")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashXmcStartup", "bootloader_flash_xmc_startup")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashUnlockDefault", "bootloader_flash_unlock_default")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashUnlock", "bootloader_flash_unlock")) return false
    if (!internalFunction("esp32RecoveredBootloaderFlashExecuteCommandCommon", "bootloader_flash_execute_command_common")) return false
    true
}
