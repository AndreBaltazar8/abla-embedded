import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkBootloaderUtilityOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBootloaderDebugBuffer", "bootloader_debug_buffer")) return false
    if (!internalFunction("esp32RecoveredBootloaderAtexit", "bootloader_atexit")) return false
    if (!internalFunction("esp32RecoveredBootloaderReset", "bootloader_reset")) return false
    if (!internalFunction("esp32RecoveredBootloaderSha256FlashContents", "bootloader_sha256_flash_contents")) return false
    if (!internalFunction("esp32RecoveredBootloaderSha256HexToStr", "bootloader_sha256_hex_to_str")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonGetPartitionDescription", "bootloader_common_get_partition_description")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonReadOtadata", "bootloader_common_read_otadata")) return false
    if (!internalFunction("esp32RecoveredBootloaderUtilityGetSelectedBootPartition", "bootloader_utility_get_selected_boot_partition")) return false
    if (!internalFunction("esp32RecoveredBootloaderUtilityLoadBootImage", "bootloader_utility_load_boot_image")) return false
    if (!internalFunction("esp32RecoveredBootloaderUtilityLoadPartitionTable", "bootloader_utility_load_partition_table")) return false
    true
}
