import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEfuseApiOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspEfuseReadFieldBlob", "esp_efuse_read_field_blob")) return false
    if (!internalFunction("esp32RecoveredEspEfuseReadFieldBit", "esp_efuse_read_field_bit")) return false
    if (!internalFunction("esp32RecoveredEspEfuseReadFieldCnt", "esp_efuse_read_field_cnt")) return false
    if (!internalFunction("esp32RecoveredEspEfuseWriteFieldBlob", "esp_efuse_write_field_blob")) return false
    if (!internalFunction("esp32RecoveredEspEfuseWriteFieldCnt", "esp_efuse_write_field_cnt")) return false
    if (!internalFunction("esp32RecoveredEspEfuseWriteFieldBit", "esp_efuse_write_field_bit")) return false
    if (!exportFunction("esp32RecoveredEspEfuseGetFieldSize", "esp_efuse_get_field_size")) return false
    if (!internalFunction("esp32RecoveredEspEfuseWriteReg", "esp_efuse_write_reg")) return false
    if (!internalFunction("esp32RecoveredEspEfuseReadBlock", "esp_efuse_read_block")) return false
    if (!internalFunction("esp32RecoveredEspEfuseReadReg", "esp_efuse_read_reg")) return false
    if (!internalFunction("esp32RecoveredEspEfuseWriteBlock", "esp_efuse_write_block")) return false
    if (!internalFunction("esp32RecoveredEspEfuseBatchWriteBegin", "esp_efuse_batch_write_begin")) return false
    if (!internalFunction("esp32RecoveredEspEfuseBatchWriteCancel", "esp_efuse_batch_write_cancel")) return false
    if (!internalFunction("esp32RecoveredEspEfuseBatchWriteCommit", "esp_efuse_batch_write_commit")) return false
    if (!internalFunction("esp32RecoveredEspEfuseCheckErrors", "esp_efuse_check_errors")) return false
    if (!internalFunction("esp32RecoveredEspEfuseDestroyBlock", "esp_efuse_destroy_block")) return false
    true
}
