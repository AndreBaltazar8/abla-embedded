import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkAppDescriptionCallers(): bool {
    if (!internalFunction("esp32ApplicationGetDescription", "esp_app_get_description")) return false
    if (!internalFunction("esp32ApplicationGetElfSha256", "esp_app_get_elf_sha256")) return false
    true
}
