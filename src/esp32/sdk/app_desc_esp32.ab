// Executable metadata must be present before startup so elf2image can replace
// bytes 144..175 with the application ELF digest.
val esp32Data_esp_app_desc_136b83261bStorage = nativeInternalSectionBytes(
    "\x32\x54\xcd\xab\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x30\x61\x36\x39\x30\x36\x62\x2d\x64\x69\x72\x74\x79\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x6d\x35\x65\x63\x68\x6f\x5f\x66\x69\x72\x6d\x77\x61\x72\x65\x5f\x61\x62\x6c\x61\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x30\x30\x3a\x30\x30\x3a\x30\x30\x00\x00\x00\x00\x00\x00\x00\x00\x4a\x61\x6e\x20\x20\x31\x20\x31\x39\x38\x30\x00\x00\x00\x00\x00\x76\x36\x2e\x30\x2e\x32\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x63\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
    "esp_app_desc", ".rodata_desc", 16)
val esp32Data_esp_app_desc_136b83261b = u32(esp32Data_esp_app_desc_136b83261bStorage)

// CONFIG_APP_RETRIEVE_LEN_ELF_SHA is 9 for this image.
val esp32AppElfSha256TextStorage = nativeStaticAllocate(10)
val esp32AppElfSha256Text = u32(esp32AppElfSha256TextStorage)

val esp32AppInfoHeader = u32(nativeStaticBytes("I app_init: Application information:\n\x00"))
val esp32AppInfoProject = u32(nativeStaticBytes("I app_init: Project name:     \x00"))
val esp32AppInfoVersion = u32(nativeStaticBytes("I app_init: App version:      \x00"))
val esp32AppInfoCompile = u32(nativeStaticBytes("I app_init: Compile time:     \x00"))
val esp32AppInfoHash = u32(nativeStaticBytes("I app_init: ELF file SHA256:  \x00"))
val esp32AppInfoIdf = u32(nativeStaticBytes("I app_init: ESP-IDF:          \x00"))
val esp32AppInfoEllipsis = u32(nativeStaticBytes("...\n\x00"))

@inline
trusted fun esp32AppStoreByte(address:u32, value:u32):void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32ApplicationFormatElfSha256():void {
    if (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(esp32AppElfSha256Text)))) != u32(0)) return
    var index = u32(0)
    while (index < u32(5)) {
        val byte = u32(ablaUnsafeLoadU8(nativePointerFromAddress(
            int(esp32Data_esp_app_desc_136b83261b + u32(144) + index))))
        val high = byte >>> u32(4)
        val low = byte & u32(15)
        esp32AppStoreByte(esp32AppElfSha256Text + index * u32(2),
            if (high < u32(10)) high + u32(48) else high + u32(87))
        esp32AppStoreByte(esp32AppElfSha256Text + index * u32(2) + u32(1),
            if (low < u32(10)) low + u32(48) else low + u32(87))
        index = index + u32(1)
    }
    esp32AppStoreByte(esp32AppElfSha256Text + u32(9), u32(0))
}

trusted fun esp32ApplicationGetDescription():u32 = esp32Data_esp_app_desc_136b83261b

trusted fun esp32ApplicationGetElfSha256(destination:u32, size:u32):u32 {
    if (destination == u32(0) || size < u32(2)) return u32(0)
    esp32ApplicationFormatElfSha256()
    val count = if (size < u32(10)) size else u32(10)
    freestandingCopy(destination, esp32AppElfSha256Text, count)
    esp32AppStoreByte(destination + count - u32(1), u32(0))
    count
}

trusted fun esp32ApplicationShowInfo():u32 {
    esp32ApplicationFormatElfSha256()
    val logLevel = u32(ablaUnsafeLoadU32(nativePointerFromAddress(
        int(esp32Data_esp_log_default_level_865ba35f32))))
    if (logLevel < u32(3)) return u32(0)
    val descriptor = esp32Data_esp_app_desc_136b83261b
    esp32RomOutputCString(esp32AppInfoHeader)
    esp32RomOutputCString(esp32AppInfoProject)
    esp32RomOutputCString(descriptor + u32(48))
    esp32RomOutputPutc(u32(10))
    esp32RomOutputCString(esp32AppInfoVersion)
    esp32RomOutputCString(descriptor + u32(16))
    esp32RomOutputPutc(u32(10))
    esp32RomOutputCString(esp32AppInfoCompile)
    esp32RomOutputCString(descriptor + u32(96))
    esp32RomOutputPutc(u32(32))
    esp32RomOutputCString(descriptor + u32(80))
    esp32RomOutputPutc(u32(10))
    val shortHash = u32(nativeStackAllocate(17))
    esp32ApplicationGetElfSha256(shortHash,u32(17))
    esp32RomOutputCString(esp32AppInfoHash)
    esp32RomOutputCString(shortHash)
    esp32RomOutputCString(esp32AppInfoEllipsis)
    esp32RomOutputCString(esp32AppInfoIdf)
    esp32RomOutputCString(descriptor + u32(112))
    esp32RomOutputPutc(u32(10))
    u32(0)
}

trusted fun esp32ApplicationDescriptorReady():bool =
    esp32Data_esp_app_desc_136b83261b != u32(0)

val esp32ApplicationShowInfoDescriptorStorage = nativeInternalSectionU32s([
    int(u32(nativeFunctionAddress(esp32ApplicationShowInfo))), 1
], "abla_esp32_system_init_20_show_app_info", ".esp_system_init_fn.20")
val esp32ApplicationShowInfoDescriptor = u32(esp32ApplicationShowInfoDescriptorStorage)
