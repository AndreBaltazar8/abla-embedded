import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkBootloaderShaOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBootloaderSha256Data", "bootloader_sha256_data")) return false
    if (!internalFunction("esp32RecoveredBootloaderSha512Data", "bootloader_sha512_data")) return false
    if (!internalFunction("esp32RecoveredBootloaderSha256Start", "bootloader_sha256_start")) return false
    if (!internalFunction("esp32RecoveredBootloaderSha256Finish", "bootloader_sha256_finish")) return false
    if (!internalFunction("esp32RecoveredBootloaderSha512Start", "bootloader_sha512_start")) return false
    if (!internalFunction("esp32RecoveredBootloaderSha512Finish", "bootloader_sha512_finish")) return false
    true
}
