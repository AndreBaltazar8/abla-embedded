import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun linkRecoveredOpaqueCallers(): bool {
    if (!internalFunction("esp32EfuseApplyThreeQuarterEncoding", "esp_efuse_utility_apply_34_encoding")) return false
    true
}
