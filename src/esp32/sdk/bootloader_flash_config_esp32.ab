// Original ABI symbol: bootloader_flash_get_wp_pin
trusted fun esp32FlashWriteProtectPin(): u32 {
    val package = esp32ChipPackage()
    if (package == u32(2) || package == u32(4)) return u32(7)
    if (package == u32(6)) return u32(18)
    if (package != u32(5)) return u32(10)

    // PICO-D4 and PICO-V3 share package ID 5.  Revision 3.0 and newer use
    // GPIO18; earlier PICO-D4 silicon uses GPIO7.
    val major = esp32ChipRevisionMajor()
    val minor = esp32ChipRevisionMinor()
    if (major * u32(100) + minor >= u32(300)) u32(18) else u32(7)
}

