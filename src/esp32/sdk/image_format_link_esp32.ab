import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkImageFormatOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBootloaderLoadImage", "bootloader_load_image")) return false
    if (!internalFunction("esp32RecoveredBootloaderLoadImageNoVerify", "bootloader_load_image_no_verify")) return false
    if (!internalFunction("esp32RecoveredEspImageBootloaderOffsetGet", "esp_image_bootloader_offset_get")) return false
    if (!internalFunction("esp32RecoveredEspImageVerify", "esp_image_verify")) return false
    if (!internalFunction("esp32RecoveredEspImageVerifyBootloader", "esp_image_verify_bootloader")) return false
    if (!internalFunction("esp32RecoveredEspImageVerifyBootloaderData", "esp_image_verify_bootloader_data")) return false
    if (!internalFunction("esp32RecoveredEspImageBootloaderOffsetSet", "esp_image_bootloader_offset_set")) return false
    if (!internalFunction("esp32RecoveredEspImageGetFlashSize", "esp_image_get_flash_size")) return false
    if (!internalFunction("esp32RecoveredEspImageGetMetadata", "esp_image_get_metadata")) return false
    true
}
