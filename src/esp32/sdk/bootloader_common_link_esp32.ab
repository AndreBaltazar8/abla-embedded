import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkBootloaderCommonOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBootloaderCommonCheckLongHoldGpio", "bootloader_common_check_long_hold_gpio")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonVddsdioConfigure", "bootloader_common_vddsdio_configure")) return false
    if (!exportFunction("esp32RecoveredBootloaderCommonGetSha256OfPartition", "bootloader_common_get_sha256_of_partition")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonLabelSearch", "bootloader_common_label_search")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonCheckLongHoldGpioLevel", "bootloader_common_check_long_hold_gpio_level")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonErasePartTypeData", "bootloader_common_erase_part_type_data")) return false
    true
}
