// Original ABI symbol: bootloader_common_get_chip_ver_pkg
@inline
trusted fun esp32ChipPackage(): u32 {
    val packageWord = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(1073061900)
    ))
    (((packageWord >>> u32(2)) & u32(1)) << u32(3)) |
        ((packageWord >>> u32(9)) & u32(7))
}

@inline
trusted fun esp32ChipRevisionMajor(): u32 {
    val word3 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(1073061900)))
    val word5 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(1073061908)))
    val apbControlDate = u32(ablaUnsafeLoadU32(nativePointerFromAddress(1073111164)))
    val encoded = ((word3 >>> u32(15)) & u32(1)) |
        (((word5 >>> u32(20)) & u32(1)) << u32(1)) |
        (((apbControlDate >>> u32(31)) & u32(1)) << u32(2))
    when (encoded) {
        1 -> u32(1)
        3 -> u32(2)
        7 -> u32(3)
        else -> u32(0)
    }
}

@inline
trusted fun esp32ChipRevisionMinor(): u32 =
    (u32(ablaUnsafeLoadU32(nativePointerFromAddress(1073061908))) >>> u32(24)) & u32(3)

