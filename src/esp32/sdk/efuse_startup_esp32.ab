import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../log/level_esp32.ab"
import "../rom/serial_output_esp32.ab"

// Structured Abla implementation of the active ESP32 configuration of
// esp_efuse_startup.c.
val esp32EfuseStartupSummary = u32(nativeStaticBytes(
    "I efuse_init: chip revision constraints checked\n\x00"))

@inline
trusted fun esp32EfuseStartupLogLevel():u32 = u32(ablaUnsafeLoadU32(
    nativePointerFromAddress(int(esp32Data_esp_log_default_level_865ba35f32))))

trusted fun esp32EfuseStartupTimestamp():u32 = esp32RecoveredEspLogTimestamp(
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

trusted fun esp32EfuseCheckAtStartup():u32 {
    val status = esp32RecoveredEspEfuseCheckErrors(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (status != u32(0)) {
        esp32RecoveredEspRestart(
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    }
    u32(0)
}

trusted fun esp32EfuseShowAppInfo():u32 {
    if (esp32EfuseStartupLogLevel() < u32(3)) return u32(0)
    // The detailed revision values remain available through the eFuse API.
    // Startup only needs a lock-free confirmation before the scheduler exists.
    esp32RomOutputCString(esp32EfuseStartupSummary)
    u32(0)
}

// The selected original-ESP32 configuration has no anti-rollback, secure-boot,
// flash-encryption-init, virtual-eFuse, or ROM-log branch enabled here.
trusted fun esp32EfuseSecureInitialize():u32 = u32(0)
trusted fun esp32EfuseInitialize():u32 = esp32EfuseSecureInitialize()
trusted fun esp32EfuseStartupInclude():void {}

val esp32EfuseInitDescriptorStorage = nativeInternalSectionU32s([
    int(u32(nativeFunctionAddress(esp32EfuseInitialize))), 1
], "abla_esp32_system_init_140_init_efuse", ".esp_system_init_fn.140")
val esp32EfuseInitDescriptor = u32(esp32EfuseInitDescriptorStorage)

val esp32EfuseShowInfoDescriptorStorage = nativeInternalSectionU32s([
    int(u32(nativeFunctionAddress(esp32EfuseShowAppInfo))), 1
], "abla_esp32_system_init_21_efuse_show_app_info", ".esp_system_init_fn.21")
val esp32EfuseShowInfoDescriptor = u32(esp32EfuseShowInfoDescriptorStorage)

val esp32EfuseCheckDescriptorStorage = nativeInternalSectionU32s([
    int(u32(nativeFunctionAddress(esp32EfuseCheckAtStartup))), 1
], "abla_esp32_system_init_1_efuse_check", ".esp_system_init_fn.1")
val esp32EfuseCheckDescriptor = u32(esp32EfuseCheckDescriptorStorage)

trusted fun esp32RecoveredEspEfuseStartupIncludeFunc(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32EfuseStartupInclude(); a2 }
