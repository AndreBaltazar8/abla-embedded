import "../rom/basic_system_esp32.ab"
import "../../runtime/freestanding_integer.ab"
import "abla/unsafe/memory"
import "efuse_table_esp32.ab"

// Secure-version and flash-encryption eFuse policy in structured Abla.
val esp32EfuseSecureVersionBits = u32(4)

trusted fun esp32RecoveredEspEfuseReset():void {
    esp32RecoveredEspEfuseUtilityReset(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}

trusted fun esp32EfuseSecureVersionFieldSize():u32 {
    val physicalSize = esp32RecoveredEspEfuseGetFieldSize(
        esp32Data_ESP_EFUSE_SECURE_VERSION_e5f48cd90f,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (physicalSize < esp32EfuseSecureVersionBits) physicalSize else esp32EfuseSecureVersionBits
}

trusted fun esp32RecoveredEspEfuseReadSecureVersion():u32 {
    val storage = u32(nativeStackAllocate(4))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(storage)),0)
    val size = esp32EfuseSecureVersionFieldSize()
    esp32RecoveredEspEfuseReadFieldBlob(
        esp32Data_ESP_EFUSE_SECURE_VERSION_e5f48cd90f,storage,size,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    val value = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(storage))))
    val mask = if (size == u32(32)) u32(0xffffffff) else (u32(1) << size) - u32(1)
    u32(freestandingPopulationCount32(value & mask))
}

trusted fun esp32EfuseFaultAssert(condition:bool):void {
    if (condition) return
    esp32RomSoftwareResetSystemValue()
    while (true) {}
}

trusted fun esp32RecoveredEspEfuseCheckSecureVersion(secureVersion:u32):u32 {
    val hardwareVersion = esp32RecoveredEspEfuseReadSecureVersion()
    val copy1 = esp32RecoveredEspEfuseReadSecureVersion()
    val copy2 = esp32RecoveredEspEfuseReadSecureVersion()
    esp32EfuseFaultAssert(hardwareVersion == copy1)
    esp32EfuseFaultAssert(hardwareVersion == copy2)
    val accepted = secureVersion >= hardwareVersion
    esp32EfuseFaultAssert(accepted == (secureVersion >= hardwareVersion))
    if (accepted) u32(1) else u32(0)
}

trusted fun esp32RecoveredEspEfuseUpdateSecureVersion(secureVersion:u32):u32 {
    val size = esp32EfuseSecureVersionFieldSize()
    if (size < secureVersion) return u32(258)

    val codingScheme = esp32RecoveredEspEfuseGetCodingScheme(
        u32(3),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (codingScheme != u32(0)) return u32(262)

    val hardwareVersion = esp32RecoveredEspEfuseReadSecureVersion()
    if (hardwareVersion > secureVersion) return u32(0xffffffff)
    if (hardwareVersion == secureVersion) return u32(0)

    val hardwareMask = (u32(1) << hardwareVersion) - u32(1)
    val requestedMask = (u32(1) << secureVersion) - u32(1)
    val newBitsAddress = u32(nativeStackAllocate(4))
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(newBitsAddress)),
        int(requestedMask - hardwareMask))
    esp32RecoveredEspEfuseWriteFieldBlob(
        esp32Data_ESP_EFUSE_SECURE_VERSION_e5f48cd90f,newBitsAddress,size,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
}

@section(".iram1.0.abla.esp32RecoveredEspEfuseIsFlashEncryptionEnabled")
trusted fun esp32RecoveredEspEfuseIsFlashEncryptionEnabled():u32 =
    esp32RecoveredEfuseHalFlashEncryptionEnabled(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
