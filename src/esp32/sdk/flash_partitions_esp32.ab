import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../log/core_esp32.ab"
import "../log/timestamp_esp32.ab"
import "../rom/md5_esp32.ab"

// Partition-table validation is normal structured Abla. The MD5 implementation
// it invokes is also Abla, so the complete verification path can be optimized
// together with its caller.

val esp32FlashPartsTagStorage = nativeStaticBytes("flash_parts\x00")
val esp32FlashPartsBoundsStorage = nativeStaticBytes(
    "E (%lu) %s: partition %d invalid - offset 0x%lx size 0x%lx exceeds flash chip size 0x%lx\n\x00"
)
val esp32FlashPartsDuplicateMd5Storage = nativeStaticBytes(
    "E (%lu) %s: Only one MD5 checksum is allowed\n\x00"
)
val esp32FlashPartsIncorrectMd5Storage = nativeStaticBytes(
    "E (%lu) %s: Incorrect MD5 checksum\n\x00"
)
val esp32FlashPartsMagicStorage = nativeStaticBytes(
    "E (%lu) %s: partition %d invalid magic number 0x%x\n\x00"
)
val esp32FlashPartsNoEndStorage = nativeStaticBytes(
    "E (%lu) %s: partition table has no terminating entry, not valid\n\x00"
)

val esp32FlashPartsTag = u32(esp32FlashPartsTagStorage)

trusted fun esp32FlashPartsLog(
    format:u32, argument:u32, stack0:u32, stack1:u32, stack2:u32
):void {
    esp32Log(
        u32(1), esp32FlashPartsTag, format,
        esp32LogTimestamp(), esp32FlashPartsTag, argument,
        stack0, stack1, stack2,
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

@inline
trusted fun esp32FlashPartsLoadU8(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32FlashPartsLoadU16(address:u32):u32 =
    u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32FlashPartsLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

trusted fun esp32FlashPartsDigestMatches(left:u32, right:u32):bool {
    var index = u32(0)
    while (index < u32(16)) {
        if (esp32FlashPartsLoadU8(left + index) != esp32FlashPartsLoadU8(right + index)) return false
        index = index + u32(1)
    }
    true
}

trusted fun esp32PartitionTableVerify(
    partitionTable:u32, logErrors:u32, partitionCountOut:u32
):u32 {
    // g_rom_flashchip.chip_size is the second u32 in the ROM descriptor.
    val flashSize = esp32FlashPartsLoadU32(u32(1073406580))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(partitionCountOut)), 0)

    var md5Found = u32(0)
    var index = u32(0)
    while (index < u32(96)) {
        val entry = partitionTable + (index << u32(5))
        val magic = esp32FlashPartsLoadU16(entry)

        if (magic == u32(0x50aa)) {
            val offset = esp32FlashPartsLoadU32(entry + u32(4))
            val size = esp32FlashPartsLoadU32(entry + u32(8))
            if (offset > flashSize || offset + size > flashSize) {
                if (logErrors != u32(0)) {
                    esp32FlashPartsLog(
                        u32(esp32FlashPartsBoundsStorage), index,
                        offset, size, flashSize
                    )
                }
                return u32(260)
            }
        } else if (magic == u32(0xebeb)) {
            if (md5Found != u32(0)) {
                if (logErrors != u32(0)) {
                    esp32FlashPartsLog(
                        u32(esp32FlashPartsDuplicateMd5Storage), u32(0),
                        u32(0), u32(0), u32(0)
                    )
                }
                return u32(259)
            }

            val frame = u32(nativeStackAllocate(104))
            val context = frame
            val digest = frame + u32(88)
            esp32RomMd5Init(context)
            esp32RomMd5Update(context, partitionTable, index << u32(5))
            esp32RomMd5Final(digest, context)
            if (!esp32FlashPartsDigestMatches(entry + u32(16), digest)) {
                if (logErrors != u32(0)) {
                    esp32FlashPartsLog(
                        u32(esp32FlashPartsIncorrectMd5Storage), u32(0),
                        u32(0), u32(0), u32(0)
                    )
                }
                return u32(259)
            }
            md5Found = u32(1)
        } else if (
            index != u32(0) && magic == u32(0xffff) &&
            esp32FlashPartsLoadU8(entry + u32(2)) == u32(0xff) &&
            esp32FlashPartsLoadU8(entry + u32(3)) == u32(0xff)
        ) {
            ablaUnsafeStoreU32(
                nativePointerFromAddress(int(partitionCountOut)),
                int(index - md5Found)
            )
            return u32(0)
        } else {
            if (logErrors != u32(0)) {
                esp32FlashPartsLog(
                    u32(esp32FlashPartsMagicStorage), index,
                    magic, u32(0), u32(0)
                )
            }
            return u32(259)
        }

        index = index + u32(1)
    }

    if (logErrors != u32(0)) {
        esp32FlashPartsLog(
            u32(esp32FlashPartsNoEndStorage), u32(0),
            u32(0), u32(0), u32(0)
        )
    }
    u32(259)
}

// Temporary ABI adapter for lifted callers that have not yet been rewritten.
trusted fun esp32RecoveredEspPartitionTableVerify(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32PartitionTableVerify(a2,a3,a4)
