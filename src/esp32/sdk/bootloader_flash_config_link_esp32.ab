import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkBootloaderFlashConfigOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBootloaderFlashUpdateSize", "bootloader_flash_update_size")) return false
    if (!exportFunction("esp32RecoveredBootloaderFlashUpdateId", "bootloader_flash_update_id")) return false
    if (!exportFunction("esp32RecoveredBootloaderFlashGetWpPin", "bootloader_flash_get_wp_pin")) return false
    if (!exportFunction("esp32RecoveredBootloaderFlashClockConfig", "bootloader_flash_clock_config")) return false
    if (!internalFunction("esp32RecoveredBootloaderInitSpiFlash", "bootloader_init_spi_flash")) return false
    if (!exportFunction("esp32RecoveredBootloaderFlashCsTimingConfig", "bootloader_flash_cs_timing_config")) return false
    if (!exportFunction("esp32RecoveredBootloaderFlashDummyConfig", "bootloader_flash_dummy_config")) return false
    if (!internalFunction("esp32RecoveredBootloaderConfigureSpiPins", "bootloader_configure_spi_pins")) return false
    if (!exportFunction("esp32RecoveredBootloaderFlashGpioConfig", "bootloader_flash_gpio_config")) return false
    true
}
