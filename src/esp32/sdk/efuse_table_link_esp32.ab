import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEfuseTableData(): bool {
    if (!internalFunction("esp32RecoveredEsp32EfuseTableDataAnchor", "esp32_efuse_table_data_anchor")) return false
    true
}
