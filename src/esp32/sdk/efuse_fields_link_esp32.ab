import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEfuseFieldsOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspEfuseReset", "esp_efuse_reset")) return false
    if (!internalFunction("esp32RecoveredEspEfuseReadSecureVersion", "esp_efuse_read_secure_version")) return false
    if (!internalFunction("esp32RecoveredEspEfuseCheckSecureVersion", "esp_efuse_check_secure_version")) return false
    if (!internalFunction("esp32RecoveredEspEfuseUpdateSecureVersion", "esp_efuse_update_secure_version")) return false
    if (!internalFunction("esp32RecoveredEspEfuseIsFlashEncryptionEnabled", "esp_efuse_is_flash_encryption_enabled")) return false
    true
}
