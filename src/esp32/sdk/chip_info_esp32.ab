import "../hal/efuse_esp32.ab"
import "../hal/efuse_runtime_esp32.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32ChipInfoStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32ChipInfoStoreU16(address: u32, value: u32): void =
    ablaUnsafeStoreU16(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32ChipInfoStoreU8(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32ChipInfo(output: u32): void {
    esp32ChipInfoStoreU32(output, u32(1))
    esp32ChipInfoStoreU16(output + u32(8), esp32EfuseHalChipRevision())

    val configuration = esp32EfuseRead(12)
    val applicationCpuDisabled = (configuration & u32(1)) != u32(0)
    val bluetoothDisabled = (configuration & u32(2)) != u32(0)
    esp32ChipInfoStoreU8(output + u32(10),
        if (applicationCpuDisabled) u32(1) else u32(2))

    var features = u32(2)
    if (!bluetoothDisabled) features = features | u32(48)
    val package = ((configuration >>> u32(2)) & u32(1)) << u32(3) |
        ((configuration >>> u32(9)) & u32(7))
    if (package == u32(2) || package == u32(4) || package == u32(5) ||
        package == u32(6)) features = features | u32(1)
    if (package == u32(6) || package == u32(7)) {
        features = features | u32(128)
    }
    esp32ChipInfoStoreU32(output + u32(4), features)
}

trusted fun esp32RecoveredEspChipInfo(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32ChipInfo(a2); a2 }
