import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMacAddressOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspMacAddrLenGet", "esp_mac_addr_len_get")) return false
    if (!internalFunction("esp32RecoveredEspIfaceMacAddrSet", "esp_iface_mac_addr_set")) return false
    if (!internalFunction("esp32RecoveredEspBaseMacAddrSet", "esp_base_mac_addr_set")) return false
    if (!internalFunction("esp32RecoveredEspEfuseMacGetCustom", "esp_efuse_mac_get_custom")) return false
    if (!internalFunction("esp32RecoveredEspEfuseMacGetDefault", "esp_efuse_mac_get_default")) return false
    if (!internalFunction("esp32RecoveredEspDeriveLocalMac", "esp_derive_local_mac")) return false
    if (!internalFunction("esp32RecoveredEspReadMac", "esp_read_mac")) return false
    if (!internalFunction("esp32RecoveredEspBaseMacAddrGet", "esp_base_mac_addr_get")) return false
    true
}
