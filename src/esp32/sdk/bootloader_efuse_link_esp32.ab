import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkBootloaderEfuseOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBootloaderClockGetRatedFreqMhz", "bootloader_clock_get_rated_freq_mhz")) return false
    if (!internalFunction("esp32RecoveredBootloaderCommonGetChipVerPkg", "bootloader_common_get_chip_ver_pkg")) return false
    true
}
