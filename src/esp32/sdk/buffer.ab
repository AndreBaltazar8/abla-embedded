import "abla/unsafe/memory"

trusted fun nativeAddressPointer(address: int, offset: int): i64* =
    nativePointerFromAddress(address + offset)

trusted fun nativeAddressStoreU8(
    address: int,
    offset: int,
    value: int
): void {
    ablaUnsafeStoreU8(nativeAddressPointer(address, offset), value)
    return
}

trusted fun nativeAddressStoreU16(
    address: int,
    offset: int,
    value: int
): void {
    ablaUnsafeStoreU16(nativeAddressPointer(address, offset), value)
    return
}

trusted fun nativeAddressStoreU32(
    address: int,
    offset: int,
    value: int
): void {
    ablaUnsafeStoreU32(nativeAddressPointer(address, offset), value)
    return
}

trusted fun nativeAddressLoadU16(address: int, offset: int): int =
    ablaUnsafeLoadU16(nativeAddressPointer(address, offset))

trusted fun nativeAddressLoadU32(address: int, offset: int): int =
    ablaUnsafeLoadU32(nativeAddressPointer(address, offset))

trusted fun nativeAddressClear(address: int, size: int): void {
    ablaUnsafeSetMemory(nativePointerFromAddress(address), 0, size)
    return
}

trusted fun nativeAddressCopyText(
    address: int,
    offset: int,
    capacity: int,
    text: string
): int {
    var copied = 0
    while (copied < text.size && copied + 1 < capacity) {
        nativeAddressStoreU8(address, offset + copied, text[copied])
        copied = copied + 1
    }
    if (capacity > 0) nativeAddressStoreU8(address, offset + copied, 0)
    copied
}

fun nativeStoreU16(var buffer: NativeByteBuffer, offset: int, value: int): void {
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value / 256) & 255)
    return
}

fun nativeStoreU32(var buffer: NativeByteBuffer, offset: int, value: int): void {
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value / 256) & 255)
    buffer.store(offset + 2, (value / 65536) & 255)
    buffer.store(offset + 3, (value / 16777216) & 255)
    return
}

fun nativeLoadU16(buffer: NativeByteBuffer, offset: int): int =
    buffer.load(offset) + buffer.load(offset + 1) * 256

fun nativeLoadU32(buffer: NativeByteBuffer, offset: int): int =
    buffer.load(offset) + buffer.load(offset + 1) * 256 +
    buffer.load(offset + 2) * 65536 + buffer.load(offset + 3) * 16777216

fun nativeCopyText(
    var buffer: NativeByteBuffer,
    offset: int,
    capacity: int,
    text: string
): int {
    var copied = 0
    while (copied < text.size && copied + 1 < capacity) {
        buffer.store(offset + copied, text[copied])
        copied = copied + 1
    }
    if (capacity > 0) buffer.store(offset + copied, 0)
    copied
}
