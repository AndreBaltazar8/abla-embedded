import "abla/unsafe/memory"

// A checked persistent native region encoded as one scalar: the low 32 bits
// hold the ESP32 address and the high 31 bits hold its capacity. This keeps
// buffer arguments on the direct scalar ABI and avoids a heap wrapper.
type NativeBuffer = int

trusted fun nativeBufferAt(address: int, capacity: int): NativeBuffer {
    var size = capacity
    if (size < 0) size = 0
    if (size > 2147483647) size = 2147483647
    NativeBuffer((address & 4294967295) | (size << 32))
}

fun NativeBuffer.addressValue(): int = this & 4294967295

fun NativeBuffer.capacity(): int = (this >>> 32) & 2147483647

trusted fun NativeBuffer.pointer(): i64* =
    nativePointerFromAddress(this.addressValue())

trusted fun NativeBuffer.pointerAt(offset: int): i64* {
    var result = nativeNullPointer()
    if (offset >= 0 && offset <= this.capacity()) {
        result = nativePointerFromAddress(this.addressValue() + offset)
    }
    result
}

trusted fun NativeBuffer.load(index: int): int {
    if (index < 0 || index >= this.capacity()) 0
    else ablaUnsafeLoadU8(
        nativePointerFromAddress(this.addressValue() + index)
    )
}

trusted fun NativeBuffer.store(index: int, value: int): bool {
    var stored = false
    if (index >= 0 && index < this.capacity()) {
        ablaUnsafeStoreU8(
            nativePointerFromAddress(this.addressValue() + index), value
        )
        stored = true
    }
    stored
}

trusted fun NativeBuffer.storeU16(offset: int, value: int): bool {
    var stored = false
    if (offset >= 0 && offset + 2 <= this.capacity()) {
        ablaUnsafeStoreU16(
            nativePointerFromAddress(this.addressValue() + offset), value
        )
        stored = true
    }
    stored
}

trusted fun NativeBuffer.storeU32(offset: int, value: int): bool {
    var stored = false
    if (offset >= 0 && offset + 4 <= this.capacity()) {
        ablaUnsafeStoreU32(
            nativePointerFromAddress(this.addressValue() + offset), value
        )
        stored = true
    }
    stored
}

trusted fun NativeBuffer.loadU16(offset: int): int {
    if (offset < 0 || offset + 2 > this.capacity()) 0
    else ablaUnsafeLoadU16(
        nativePointerFromAddress(this.addressValue() + offset)
    )
}

trusted fun NativeBuffer.loadU32(offset: int): int {
    if (offset < 0 || offset + 4 > this.capacity()) 0
    else ablaUnsafeLoadU32(
        nativePointerFromAddress(this.addressValue() + offset)
    )
}

trusted fun nativeAddressPointer(address: int, offset: int): i64* =
    nativePointerFromAddress(address + offset)

trusted fun nativeAddressStoreU8(
    address: int,
    offset: int,
    value: int
): void {
    ablaUnsafeStoreU8(nativeAddressPointer(address, offset), value)
    return
}

trusted fun nativeAddressStoreU16(
    address: int,
    offset: int,
    value: int
): void {
    ablaUnsafeStoreU16(nativeAddressPointer(address, offset), value)
    return
}

trusted fun nativeAddressStoreU32(
    address: int,
    offset: int,
    value: int
): void {
    ablaUnsafeStoreU32(nativeAddressPointer(address, offset), value)
    return
}

trusted fun nativeAddressLoadU16(address: int, offset: int): int =
    ablaUnsafeLoadU16(nativeAddressPointer(address, offset))

trusted fun nativeAddressLoadU32(address: int, offset: int): int =
    ablaUnsafeLoadU32(nativeAddressPointer(address, offset))

trusted fun nativeAddressClear(address: int, size: int): void {
    ablaUnsafeSetMemory(nativePointerFromAddress(address), 0, size)
    return
}

trusted fun nativeAddressCopyText(
    address: int,
    offset: int,
    capacity: int,
    text: string
): int {
    var copied = 0
    while (copied < text.size && copied + 1 < capacity) {
        nativeAddressStoreU8(address, offset + copied, text[copied])
        copied = copied + 1
    }
    if (capacity > 0) nativeAddressStoreU8(address, offset + copied, 0)
    copied
}

fun nativeStoreU16(var buffer: NativeByteBuffer, offset: int, value: int): void {
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value / 256) & 255)
    return
}

fun nativeStoreU32(var buffer: NativeByteBuffer, offset: int, value: int): void {
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value / 256) & 255)
    buffer.store(offset + 2, (value / 65536) & 255)
    buffer.store(offset + 3, (value / 16777216) & 255)
    return
}

fun nativeLoadU16(buffer: NativeByteBuffer, offset: int): int =
    buffer.load(offset) + buffer.load(offset + 1) * 256

fun nativeLoadU32(buffer: NativeByteBuffer, offset: int): int =
    buffer.load(offset) + buffer.load(offset + 1) * 256 +
    buffer.load(offset + 2) * 65536 + buffer.load(offset + 3) * 16777216

fun nativeCopyText(
    var buffer: NativeByteBuffer,
    offset: int,
    capacity: int,
    text: string
): int {
    var copied = 0
    while (copied < text.size && copied + 1 < capacity) {
        buffer.store(offset + copied, text[copied])
        copied = copied + 1
    }
    if (capacity > 0) buffer.store(offset + copied, 0)
    copied
}
