// One read attempt. Peer close-notify maps to EOF; WANT is returned unchanged
// without error capture. Other negative results remain terminal diagnostics.
trusted fun esp32TlsReadOnce(tls: u32,destination: u32,length: u32): u32 {
    val result=esp32TlsReadChunk(tls,destination,length)
    if (result == u32(4294936448)) return u32(0)
    if (i32(result) < i32(0) && result != u32(4294940416) && result != u32(4294940544)) {
        esp32TlsReadError(tls,result)
    }
    result
}
