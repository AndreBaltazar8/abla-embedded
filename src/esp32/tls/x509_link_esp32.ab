import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMbedtlsX509Internals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsX509GetSerial", "mbedtls_x509_get_serial")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetAlgNull", "mbedtls_x509_get_alg_null")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetAlg", "mbedtls_x509_get_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509PkTypeAsString", "mbedtls_x509_pk_type_as_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetRsassaPssParams", "mbedtls_x509_get_rsassa_pss_params")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetName", "mbedtls_x509_get_name")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetTime", "mbedtls_x509_get_time")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetSig", "mbedtls_x509_get_sig")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetSigAlg", "mbedtls_x509_get_sig_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetExt", "mbedtls_x509_get_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsOidGetNumericString", "mbedtls_oid_get_numeric_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509DnGets", "mbedtls_x509_dn_gets")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509SerialGets", "mbedtls_x509_serial_gets")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509SigAlgGets", "mbedtls_x509_sig_alg_gets")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509KeySizeHelper", "mbedtls_x509_key_size_helper")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509TimeCmp", "mbedtls_x509_time_cmp")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509TimeIsPast", "mbedtls_x509_time_is_past")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509TimeIsFuture", "mbedtls_x509_time_is_future")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetNsCertType", "mbedtls_x509_get_ns_cert_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetKeyUsage", "mbedtls_x509_get_key_usage")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509ParseSubjectAltName", "mbedtls_x509_parse_subject_alt_name")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509FreeSubjectAltName", "mbedtls_x509_free_subject_alt_name")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetSubjectAltNameExt", "mbedtls_x509_get_subject_alt_name_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509GetSubjectAltName", "mbedtls_x509_get_subject_alt_name")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509InfoSubjectAltName", "mbedtls_x509_info_subject_alt_name")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509InfoCertType", "mbedtls_x509_info_cert_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509InfoKeyUsage", "mbedtls_x509_info_key_usage")) return false
    true
}
