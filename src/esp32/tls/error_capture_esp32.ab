import "../runtime/libc_heap_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Four compact error classes: TLS, system, socket and certificate.
@inline trusted fun esp32TlsErrorLoad(address:u32):u32=u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)
@inline trusted fun esp32TlsErrorStore(address:u32,value:u32):void=
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))

trusted fun esp32TlsErrorOffset(kind:u32):u32 {
    if(kind==u32(4))return u32(0)
    if(kind==u32(2)||kind==u32(5))return u32(4)
    if(kind==u32(3)||kind==u32(6))return u32(8)
    if(kind==u32(1))return u32(12)
    return u32(0xffffffff)
}

trusted fun esp32TlsEventTrackerCapture(
    tracker:u32,kind:u32,error:u32
):void{
    if(tracker==u32(0))return
    val offset=esp32TlsErrorOffset(kind)
    if(offset!=u32(0xffffffff))esp32TlsErrorStore(tracker+offset,error)
}

trusted fun esp32TlsEventTrackerCreate():u32=esp32LibcCalloc(u32(1),u32(16))

trusted fun esp32TlsEventTrackerDestroy(tracker:u32):void {
    esp32LibcFree(tracker)
}

trusted fun esp32TlsGetAndClearErrorType(
    tracker:u32,kind:u32,output:u32
):u32{
    if(tracker==u32(0)||kind>=u32(7)||output==u32(0))return u32(258)
    val offset=esp32TlsErrorOffset(kind)
    if(offset==u32(0xffffffff))return u32(258)
    esp32TlsErrorStore(output,esp32TlsErrorLoad(tracker+offset))
    esp32TlsErrorStore(tracker+offset,u32(0))
    return u32(0)
}

trusted fun esp32RecoveredEspTlsInternalEventTrackerCapture(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32{esp32TlsEventTrackerCapture(a2,a3,a4);return a2}
trusted fun esp32RecoveredEspTlsInternalEventTrackerCreate(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32TlsEventTrackerCreate()
trusted fun esp32RecoveredEspTlsInternalEventTrackerDestroy(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32{esp32TlsEventTrackerDestroy(a2);return a2}
trusted fun esp32RecoveredEspTlsGetAndClearErrorType(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32TlsGetAndClearErrorType(a2,a3,a4)
