import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMbedtlsClientHelloInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsSslWriteClientHello", "mbedtls_ssl_write_client_hello")) return false
    true
}
