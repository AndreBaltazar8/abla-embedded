import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMbedtlsNetworkSocketsInternals(): bool {
    if (!internalFunction("esp32MbedtlsNetInit", "mbedtls_net_init")) return false
    if (!internalFunction("esp32MbedtlsNetConnect", "mbedtls_net_connect")) return false
    if (!internalFunction("esp32MbedtlsNetBind", "mbedtls_net_bind")) return false
    if (!internalFunction("esp32MbedtlsNetAccept", "mbedtls_net_accept")) return false
    if (!internalFunction("esp32MbedtlsNetSetBlock", "mbedtls_net_set_block")) return false
    if (!internalFunction("esp32MbedtlsNetSetNonblock", "mbedtls_net_set_nonblock")) return false
    if (!internalFunction("esp32MbedtlsNetUsleep", "mbedtls_net_usleep")) return false
    if (!internalFunction("esp32MbedtlsNetRecv", "mbedtls_net_recv")) return false
    if (!internalFunction("esp32MbedtlsNetRecvTimeout", "mbedtls_net_recv_timeout")) return false
    if (!internalFunction("esp32MbedtlsNetSend", "mbedtls_net_send")) return false
    if (!internalFunction("esp32MbedtlsNetFree", "mbedtls_net_free")) return false
    true
}
