import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMbedtlsMemoryInternals(): bool {
    if (!internalFunction("esp32MbedtlsMemoryCalloc", "esp_mbedtls_mem_calloc")) return false
    if (!internalFunction("esp32MbedtlsMemoryFree", "esp_mbedtls_mem_free")) return false
    true
}
