import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMbedtlsTls12ClientInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsSslTls12WriteClientHelloExts", "mbedtls_ssl_tls12_write_client_hello_exts")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslHandshakeClientStep", "mbedtls_ssl_handshake_client_step")) return false
    true
}
