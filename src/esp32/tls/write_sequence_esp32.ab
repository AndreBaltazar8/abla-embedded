// ESP-TLS write semantics: fragment at4096bytes; on WANT/zero return an
// accepted prefix if there is one. Fatal errors remain fatal even after a
// prefix, and capture their diagnostic exactly once. Never retry WANT here.
trusted fun esp32TlsWriteChunks(tls: u32,source: u32,length: u32): u32 {
    var written=u32(0)
    while (written < length) {
        val remaining=length-written
        val chunk=if (remaining > u32(4096)) u32(4096) else remaining
        val result=esp32TlsWriteChunk(tls,source+written,chunk)
        if (i32(result) <= i32(0)) {
            if (result == u32(0) || result == u32(4294940416) || result == u32(4294940544)) {
                return if (written > u32(0)) written else result
            }
            esp32TlsWriteError(tls,result)
            return result
        }
        written=written+result
    }
    written
}
