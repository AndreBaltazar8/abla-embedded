import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTlsCore(): bool {
    if (!internalFunction("esp32RecoveredEspTlsCfgServerSessionTicketsFree", "esp_tls_cfg_server_session_tickets_free")) return false
    if (!internalFunction("esp32RecoveredEspTlsCfgServerSessionTicketsInit", "esp_tls_cfg_server_session_tickets_init")) return false
    if (!internalFunction("esp32RecoveredEspTlsConnDestroy", "esp_tls_conn_destroy")) return false
    if (!internalFunction("esp32RecoveredEspTlsConnHttpNewAsync", "esp_tls_conn_http_new_async")) return false
    if (!internalFunction("esp32RecoveredEspTlsConnHttpNewSync", "esp_tls_conn_http_new_sync")) return false
    if (!internalFunction("esp32RecoveredEspTlsConnNewAsync", "esp_tls_conn_new_async")) return false
    if (!internalFunction("esp32RecoveredEspTlsConnNewSync", "esp_tls_conn_new_sync")) return false
    if (!internalFunction("esp32RecoveredEspTlsConnRead", "esp_tls_conn_read")) return false
    if (!internalFunction("esp32RecoveredEspTlsConnWrite", "esp_tls_conn_write")) return false
    if (!internalFunction("esp32RecoveredEspTlsFreeGlobalCaStore", "esp_tls_free_global_ca_store")) return false
    if (!internalFunction("esp32RecoveredEspTlsGetAndClearLastError", "esp_tls_get_and_clear_last_error")) return false
    if (!internalFunction("esp32RecoveredEspTlsGetBytesAvail", "esp_tls_get_bytes_avail")) return false
    if (!internalFunction("esp32RecoveredEspTlsGetCiphersuitesList", "esp_tls_get_ciphersuites_list")) return false
    if (!internalFunction("esp32RecoveredEspTlsGetConnSockfd", "esp_tls_get_conn_sockfd")) return false
    if (!internalFunction("esp32RecoveredEspTlsGetConnState", "esp_tls_get_conn_state")) return false
    if (!internalFunction("esp32RecoveredEspTlsGetErrorHandle", "esp_tls_get_error_handle")) return false
    if (!internalFunction("esp32RecoveredEspTlsGetGlobalCaStore", "esp_tls_get_global_ca_store")) return false
    if (!internalFunction("esp32RecoveredEspTlsGetSslContext", "esp_tls_get_ssl_context")) return false
    if (!internalFunction("esp32RecoveredEspTlsInit", "esp_tls_init")) return false
    if (!internalFunction("esp32RecoveredEspTlsInitGlobalCaStore", "esp_tls_init_global_ca_store")) return false
    if (!internalFunction("esp32RecoveredEspTlsPlainTcpConnect", "esp_tls_plain_tcp_connect")) return false
    if (!internalFunction("esp32RecoveredEspTlsServerSessionContinueAsync", "esp_tls_server_session_continue_async")) return false
