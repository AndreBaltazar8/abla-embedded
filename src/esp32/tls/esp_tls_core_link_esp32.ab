    if (!internalFunction("esp32RecoveredEspTlsSetConnState", "esp_tls_set_conn_state")) return false
    if (!internalFunction("esp32RecoveredEspTlsSetGlobalCaStore", "esp_tls_set_global_ca_store")) return false
    true
