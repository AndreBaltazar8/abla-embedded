import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTlsErrorCaptureCallers(): bool {
    if (!internalFunction("esp32TlsEventTrackerCapture", "esp_tls_internal_event_tracker_capture")) return false
    if (!internalFunction("esp32TlsEventTrackerCreate", "esp_tls_internal_event_tracker_create")) return false
    if (!internalFunction("esp32TlsEventTrackerDestroy", "esp_tls_internal_event_tracker_destroy")) return false
    if (!internalFunction("esp32TlsGetAndClearErrorType", "esp_tls_get_and_clear_error_type")) return false
    true
}
