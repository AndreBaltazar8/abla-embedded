import "../timer/lac_esp32.ab"
// ESP-IDF TLS platform time is a full 64-bit microsecond timestamp.

// Original ABI symbol: esp_tls_get_platform_time
trusted fun esp32RecoveredEspTlsGetPlatformTime(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u64 = esp32TimerTimeMicroseconds()
