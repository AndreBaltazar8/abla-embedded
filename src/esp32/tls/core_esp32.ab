    if (keyExchange < u32(1) || keyExchange > u32(2) ||
        (esp32SslCertificateLoadU8(config + u32(8)) == u32(1) && authMode == u32(0))) {
        esp32SslCertificateStoreU32(session + u32(116), u32(128))
    } else {
        result = esp32RecoveredMbedtlsSslReadRecord(
            ssl, u32(1), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
        if (result == u32(0)) {
            val input = esp32SslCertificateLoadU32(ssl + u32(120))
            val noClientCertificate = esp32SslCertificateLoadU8(config + u32(8)) == u32(1) &&
                esp32SslCertificateLoadU32(ssl + u32(140)) == u32(7) &&
                esp32SslCertificateLoadU32(ssl + u32(128)) == u32(22) &&
                esp32SslCertificateLoadU8(input) == u32(11) &&
                esp32SslCertificateLoadU8(input + u32(4)) == u32(0) &&
                esp32SslCertificateLoadU8(input + u32(5)) == u32(0) &&
                esp32SslCertificateLoadU8(input + u32(6)) == u32(0)
            if (noClientCertificate) {
                esp32SslCertificateStoreU32(session + u32(116), u32(64))
                if (authMode != u32(1)) result = u32(0xffff8b80)
            } else {
                esp32SslCertificateClearPeer(session)
                var chain = esp32SslCertificateAllocate(u32(952))
                if (chain == u32(0)) {
                    esp32SslCertificateAlert(ssl, u32(80))
                    result = u32(0xffffff73)
                } else {
                    esp32RecoveredMbedtlsX509CrtInit(
                        chain, u32(0), u32(0), u32(0), u32(0), u32(0),
                        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
                    result = esp32SslCertificateParseChain(ssl, chain)
                    if (result == u32(0)) {
                        result = esp32RecoveredMbedtlsSslVerifyCertificate(
                            ssl, authMode, chain, ciphersuite, u32(0), u32(0),
                            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
                    }
                    if (result == u32(0)) {
                        result = esp32SslCertificateRememberPeer(ssl, chain)
                        chain = u32(0)
                    }
                    if (chain != u32(0)) esp32SslCertificateFreeChain(chain)
                }
            }
        }
    }

    if (result == u32(0)) {
        esp32SslCertificateStoreU32(ssl + u32(4), esp32SslCertificateLoadU32(ssl + u32(4)) + u32(1))
    }
    return result
}
