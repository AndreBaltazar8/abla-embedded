// PSA's TLS 1.2 PSK derivation has a compact, fixed sequence of typed inputs.
// This is the source-level form of setup_psa_key_derivation from ssl_tls.c.
trusted fun esp32TlsCoreSetupPskDerivation(
    operation: u32,
    opaquePsk: u32,
    algorithm: u32,
    rawPsk: u32,
    rawPskLength: u32,
    seed: u32,
    seedLength: u32,
    label: u32,
    labelLength: u32,
    otherSecret: u32,
    otherSecretLength: u32,
    capacity: u32
): u32 {
    var status = esp32TlsCorePsaDerivationSetup(operation, algorithm)
    if (status != u32(0)) return status
    status = esp32TlsCorePsaDerivationInputBytes(operation, u32(516), seed, seedLength)
    if (status != u32(0)) return status
    if (otherSecret != u32(0)) {
        status = esp32TlsCorePsaDerivationInputBytes(
            operation, u32(259), otherSecret, otherSecretLength
        )
        if (status != u32(0)) return status
    }
    if (opaquePsk == u32(0)) {
        status = esp32TlsCorePsaDerivationInputBytes(
            operation, u32(257), rawPsk, rawPskLength
        )
    } else {
        status = esp32TlsCorePsaDerivationInputKey(operation, u32(257), opaquePsk)
    }
    if (status != u32(0)) return status
    status = esp32TlsCorePsaDerivationInputBytes(
        operation, u32(513), label, labelLength
    )
    if (status != u32(0)) return status
    return esp32TlsCorePsaDerivationSetCapacity(operation, capacity)
}

