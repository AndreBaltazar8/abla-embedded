import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMbedtlsCiphersuitesInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsSslCiphersuiteFromString", "mbedtls_ssl_ciphersuite_from_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslCiphersuiteFromId", "mbedtls_ssl_ciphersuite_from_id")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslListCiphersuites", "mbedtls_ssl_list_ciphersuites")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslGetCiphersuiteName", "mbedtls_ssl_get_ciphersuite_name")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslGetCiphersuiteId", "mbedtls_ssl_get_ciphersuite_id")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslCiphersuiteGetCipherKeyBitlen", "mbedtls_ssl_ciphersuite_get_cipher_key_bitlen")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslGetCiphersuiteSigPkAlg", "mbedtls_ssl_get_ciphersuite_sig_pk_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslGetCiphersuiteSigPkPsaAlg", "mbedtls_ssl_get_ciphersuite_sig_pk_psa_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslGetCiphersuiteSigPkPsaUsage", "mbedtls_ssl_get_ciphersuite_sig_pk_psa_usage")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslGetCiphersuiteSigAlg", "mbedtls_ssl_get_ciphersuite_sig_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslCiphersuiteUsesEc", "mbedtls_ssl_ciphersuite_uses_ec")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslCiphersuiteUsesPsk", "mbedtls_ssl_ciphersuite_uses_psk")) return false
    true
}
