import "../../runtime/freestanding_integer.ab"
import "../../runtime/freestanding_memory.ab"
import "abla/build"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../security/crypto/psa_util_internal_esp32.ab"
import "../runtime/picolibc_time_esp32.ab"
import "core_esp32.ab"
// Structured mbedTLS TLS 1.2 client handshake for the selected ESP-IDF configuration.

@inline
trusted fun esp32Tls12ClientLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32Tls12ClientLoadU8(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32Tls12ClientLoadU16(address: u32): u32 = u32(
    ablaUnsafeLoadU16(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32Tls12ClientStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32Tls12ClientStoreU8(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32Tls12ClientStoreU16(address: u32, value: u32): void =
    ablaUnsafeStoreU16(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32Tls12ClientHasSpace(
    cursor: u32, end: u32, required: u32
): bool = cursor <= end && required <= end - cursor

@inline
trusted fun esp32Tls12ClientWriteEmptyExtension(
    cursor: u32, extension: u32
): void {
    esp32Tls12ClientStoreU8(cursor, extension >> u32(8))
    esp32Tls12ClientStoreU8(cursor + u32(1), extension)
    esp32Tls12ClientStoreU8(cursor + u32(2), u32(0))
    esp32Tls12ClientStoreU8(cursor + u32(3), u32(0))
}

// Structured implementation for the exact ESP32 Mbed TLS configuration.
// The compiled object contains six extensions; ECJPAKE, CID, and DTLS-SRTP
// are absent from this build and therefore need no runtime branches here.
trusted fun esp32RecoveredMbedtlsSslTls12WriteClientHelloExts(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    esp32Tls12ClientStoreU32(a6, u32(0))
    var cursor = a3

    if (esp32Tls12ClientLoadU32(a2 + u32(12)) == u32(1)) {
        val verifyLength = esp32Tls12ClientLoadU32(a2 + u32(220))
        val extensionLength = verifyLength + u32(5)
        if (!esp32Tls12ClientHasSpace(cursor, a4, extensionLength)) {
            return u32(4294967158)
        }
        esp32Tls12ClientStoreU8(cursor, u32(255))
        esp32Tls12ClientStoreU8(cursor + u32(1), u32(1))
        esp32Tls12ClientStoreU8(cursor + u32(2), u32(0))
        esp32Tls12ClientStoreU8(cursor + u32(3), verifyLength + u32(1))
        esp32Tls12ClientStoreU8(cursor + u32(4), verifyLength)
        val copied = freestandingCopy(
            cursor + u32(5), a2 + u32(224), verifyLength
        )
        cursor = cursor + extensionLength
    }

    if (a5 != u32(0)) {
        if (!esp32Tls12ClientHasSpace(cursor, a4, u32(6))) {
            return u32(4294967158)
        }
        esp32Tls12ClientStoreU8(cursor, u32(0))
        esp32Tls12ClientStoreU8(cursor + u32(1), u32(11))
        esp32Tls12ClientStoreU8(cursor + u32(2), u32(0))
        esp32Tls12ClientStoreU8(cursor + u32(3), u32(2))
        esp32Tls12ClientStoreU8(cursor + u32(4), u32(1))
        esp32Tls12ClientStoreU8(cursor + u32(5), u32(0))
        cursor = cursor + u32(6)
    }

    val configuration = esp32Tls12ClientLoadU32(a2)
    val fragmentLength = esp32Tls12ClientLoadU8(
        configuration + u32(12)
    )
    if (fragmentLength != u32(0)) {
        if (!esp32Tls12ClientHasSpace(cursor, a4, u32(5))) {
            return u32(4294967158)
        }
        esp32Tls12ClientStoreU8(cursor, u32(0))
        esp32Tls12ClientStoreU8(cursor + u32(1), u32(1))
        esp32Tls12ClientStoreU8(cursor + u32(2), u32(0))
        esp32Tls12ClientStoreU8(cursor + u32(3), u32(1))
        esp32Tls12ClientStoreU8(cursor + u32(4), fragmentLength)
        cursor = cursor + u32(5)
    }

    if (esp32Tls12ClientLoadU8(configuration + u32(13)) != u32(0)) {
        if (!esp32Tls12ClientHasSpace(cursor, a4, u32(4))) {
            return u32(4294967158)
        }
        esp32Tls12ClientWriteEmptyExtension(cursor, u32(22))
        cursor = cursor + u32(4)
    }

    if (esp32Tls12ClientLoadU8(configuration + u32(14)) != u32(0)) {
        if (!esp32Tls12ClientHasSpace(cursor, a4, u32(4))) {
            return u32(4294967158)
        }
        esp32Tls12ClientWriteEmptyExtension(cursor, u32(23))
        cursor = cursor + u32(4)
    }

    if (esp32Tls12ClientLoadU8(configuration + u32(16)) != u32(0)) {
        val session = esp32Tls12ClientLoadU32(a2 + u32(64))
        val ticketLength = esp32Tls12ClientLoadU32(session + u32(124))
        if (!esp32Tls12ClientHasSpace(
            cursor, a4, ticketLength + u32(4)
        )) return u32(4294967158)

        esp32Tls12ClientStoreU8(cursor, u32(0))
        esp32Tls12ClientStoreU8(cursor + u32(1), u32(35))
        esp32Tls12ClientStoreU8(
            cursor + u32(2), ticketLength >> u32(8)
        )
        esp32Tls12ClientStoreU8(cursor + u32(3), ticketLength)
        val ticket = esp32Tls12ClientLoadU32(session + u32(120))
        if (ticket != u32(0) && ticketLength != u32(0)) {
            val copied = freestandingCopy(
                cursor + u32(4), ticket, ticketLength
            )
        }
        cursor = cursor + u32(4) + ticketLength
    }

    esp32Tls12ClientStoreU32(a6, cursor - a3)
    return u32(0)
}

// Typed TLS 1.2 client helpers.  The recovered entry points retain the
// original register ABI at the ownership boundary, while all implementation
// code below uses only the arguments that carry source-level meaning.  LLVM
// can therefore eliminate the adapter arguments in the monolithic image.
@inline
trusted fun esp32Tls12ClientReadRecord(ssl: u32): u32 =
    esp32RecoveredMbedtlsSslReadRecord(
        ssl, u32(1), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )

@inline
trusted fun esp32Tls12ClientSendFatalAlert(ssl: u32, alert: u32): void {
    esp32RecoveredMbedtlsSslSendAlertMessage(
        ssl, u32(2), alert, u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

@inline
trusted fun esp32Tls12ClientHandshakeHeaderLength(ssl: u32): u32 {
    val config = esp32Tls12ClientLoadU32(ssl)
    if (esp32Tls12ClientLoadU8(config + u32(9)) == u32(1)) return u32(12)
    return u32(4)
}

@inline
trusted fun esp32Tls12ClientIncrementState(ssl: u32): void =
    esp32Tls12ClientStoreU32(ssl + u32(4), esp32Tls12ClientLoadU32(ssl + u32(4)) + u32(1))

@inline
trusted fun esp32Tls12ClientCertRequestAllowed(ciphersuite: u32): bool {
    val keyExchange = esp32Tls12ClientLoadU8(ciphersuite + u32(10))
    return keyExchange == u32(1) || keyExchange == u32(2)
}

@inline
trusted fun esp32Tls12ClientOwnKey(ssl: u32): u32 {
    val handshake = esp32Tls12ClientLoadU32(ssl + u32(68))
    var keyCertificate = u32(0)
    if (handshake != u32(0)) keyCertificate = esp32Tls12ClientLoadU32(handshake + u32(1132))
    if (keyCertificate == u32(0)) {
        keyCertificate = esp32Tls12ClientLoadU32(esp32Tls12ClientLoadU32(ssl) + u32(84))
    }
    if (keyCertificate == u32(0)) return u32(0)
    return esp32Tls12ClientLoadU32(keyCertificate + u32(4))
}

@inline
trusted fun esp32Tls12ClientOwnCertificate(ssl: u32): u32 {
    val handshake = esp32Tls12ClientLoadU32(ssl + u32(68))
    var keyCertificate = u32(0)
    if (handshake != u32(0)) keyCertificate = esp32Tls12ClientLoadU32(handshake + u32(1132))
    if (keyCertificate == u32(0)) {
        keyCertificate = esp32Tls12ClientLoadU32(esp32Tls12ClientLoadU32(ssl) + u32(84))
    }
    if (keyCertificate == u32(0)) return u32(0)
    return esp32Tls12ClientLoadU32(keyCertificate)
}

@inline
trusted fun esp32Tls12ClientWriteHandshake(ssl: u32): u32 =
    esp32RecoveredMbedtlsSslWriteHandshakeMsgExt(
        ssl, u32(1), u32(1), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )

// ssl_parse_certificate_request, specialized only for the features actually
// present in the selected ESP-IDF object.  Debug-only DN material was never
// part of the release object, so the source parser only validates its bounds.
trusted fun esp32Tls12ClientParseCertificateRequest(ssl: u32): u32 {
    val handshake = esp32Tls12ClientLoadU32(ssl + u32(68))
    val ciphersuite = esp32Tls12ClientLoadU32(handshake + u32(16))
    if (!esp32Tls12ClientCertRequestAllowed(ciphersuite)) {
        esp32Tls12ClientIncrementState(ssl)
        return u32(0)
    }

    val readStatus = esp32Tls12ClientReadRecord(ssl)
    if (readStatus != u32(0)) return readStatus
    if (esp32Tls12ClientLoadU32(ssl + u32(128)) != u32(22)) {
        esp32Tls12ClientSendFatalAlert(ssl, u32(10))
        return u32(4294936832)
    }

    esp32Tls12ClientIncrementState(ssl)
    val message = esp32Tls12ClientLoadU32(ssl + u32(120))
    val clientAuth = esp32Tls12ClientLoadU8(message) == u32(13)
    esp32Tls12ClientStoreU8(handshake + u32(2000), if (clientAuth) u32(1) else u32(0))
    if (!clientAuth) {
        esp32Tls12ClientStoreU32(ssl + u32(152), u32(1))
        return u32(0)
    }

    val headerLength = esp32Tls12ClientHandshakeHeaderLength(ssl)
    val handshakeLength = esp32Tls12ClientLoadU32(ssl + u32(140))
    if (handshakeLength <= headerLength) {
        esp32Tls12ClientSendFatalAlert(ssl, u32(50))
        return u32(4294937856)
    }
    var consumed = esp32Tls12ClientLoadU8(message + headerLength)
    if (handshakeLength <= headerLength + u32(2) + consumed) {
        esp32Tls12ClientSendFatalAlert(ssl, u32(50))
        return u32(4294937856)
    }
    val signatureLengthOffset = message + headerLength + u32(1) + consumed
    val signatureLength = (esp32Tls12ClientLoadU8(signatureLengthOffset) << u32(8)) |
        esp32Tls12ClientLoadU8(signatureLengthOffset + u32(1))
    if (handshakeLength <= headerLength + u32(3) + consumed + signatureLength) {
        esp32Tls12ClientSendFatalAlert(ssl, u32(50))
        return u32(4294937856)
    }
    consumed = consumed + u32(2) + signatureLength
    val authorityLengthOffset = message + headerLength + u32(1) + consumed
    val authorityLength = (esp32Tls12ClientLoadU8(authorityLengthOffset) << u32(8)) |
        esp32Tls12ClientLoadU8(authorityLengthOffset + u32(1))
    consumed = consumed + authorityLength
    if (handshakeLength != headerLength + u32(3) + consumed) {
        esp32Tls12ClientSendFatalAlert(ssl, u32(50))
        return u32(4294937856)
    }
    return u32(0)
}

trusted fun esp32Tls12ClientParseServerHelloDone(ssl: u32): u32 {
    val readStatus = esp32Tls12ClientReadRecord(ssl)
    if (readStatus != u32(0)) return readStatus
    if (esp32Tls12ClientLoadU32(ssl + u32(128)) != u32(22)) {
        return u32(4294936832)
    }
    val message = esp32Tls12ClientLoadU32(ssl + u32(120))
    if (esp32Tls12ClientLoadU32(ssl + u32(140)) != esp32Tls12ClientHandshakeHeaderLength(ssl) ||
        esp32Tls12ClientLoadU8(message) != u32(14)) {
        esp32Tls12ClientSendFatalAlert(ssl, u32(50))
        return u32(4294937856)
    }
    esp32Tls12ClientIncrementState(ssl)
    return u32(0)
}

@inline
trusted fun esp32Tls12ClientTranslatePsaStatus(status: u32): u32 =
    esp32RecoveredPsaStatusToMbedtls(
        status,
        esp32Data_psa_to_ssl_errors_6704f3bce3,
        u32(7),
        u32(nativeFunctionAddress(esp32RecoveredPsaGenericStatusToMbedtls)),
        u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )

@inline
trusted fun esp32Tls12ClientDestroyKey(key: u32): u32 =
    esp32RecoveredPsaDestroyKey(
        key, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )

@inline
trusted fun esp32Tls12ClientConfigureEcdhAttributes(attributes: u32, handshake: u32): void {
    freestandingSecureZero(attributes, u32(24))
    esp32Tls12ClientStoreU16(attributes, esp32Tls12ClientLoadU8(handshake + u32(76)) |
        (esp32Tls12ClientLoadU8(handshake + u32(77)) << u32(8)))
    esp32Tls12ClientStoreU16(attributes + u32(2), esp32Tls12ClientLoadU32(handshake + u32(80)))
    esp32Tls12ClientStoreU32(attributes + u32(8), u32(16384))
    esp32Tls12ClientStoreU32(attributes + u32(12), u32(151126016))
}

@inline
trusted fun esp32Tls12ClientGenerateEcdhKey(attributes: u32, handshake: u32): u32 =
    esp32RecoveredPsaGenerateKey(
        attributes, handshake + u32(84), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )

@inline
trusted fun esp32Tls12ClientExportEcdhPublicKey(
    handshake: u32, output: u32, capacity: u32, outputLength: u32
): u32 = esp32RecoveredPsaExportPublicKey(
    esp32Tls12ClientLoadU32(handshake + u32(84)), output, capacity, outputLength,
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
)

@inline
trusted fun esp32Tls12ClientComputeEcdhSecret(
    handshake: u32, output: u32, capacity: u32, outputLength: u32
): u32 = esp32RecoveredPsaRawKeyAgreement(
    u32(151126016),
    esp32Tls12ClientLoadU32(handshake + u32(84)),
    handshake + u32(89),
    esp32Tls12ClientLoadU32(handshake + u32(1116)),
    output,
    capacity,
    outputLength,
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
)

// ssl_write_client_key_exchange, expressed once instead of four duplicated
// recovered register paths.  The key-exchange discriminator is byte-sized and
// the PSA attribute record remains a stack value, so no boxing or allocation
// is introduced by the Abla representation.
trusted fun esp32Tls12ClientWriteClientKeyExchange(ssl: u32): u32 {
    val handshake = esp32Tls12ClientLoadU32(ssl + u32(68))
    val ciphersuite = esp32Tls12ClientLoadU32(handshake + u32(16))
    val keyExchange = esp32Tls12ClientLoadU8(ciphersuite + u32(10))
    val output = esp32Tls12ClientLoadU32(ssl + u32(184))
    val config = esp32Tls12ClientLoadU32(ssl)
    var headerLength = u32(4)
    var contentLength = u32(0)

    if (keyExchange == u32(1) || keyExchange == u32(2)) {
        val frame = u32(nativeStackAllocate(28))
        val attributes = frame
        val publicLength = frame + u32(24)
        esp32Tls12ClientConfigureEcdhAttributes(attributes, handshake)
        var status = esp32Tls12ClientGenerateEcdhKey(attributes, handshake)
        if (status != u32(0)) return u32(4294934656)
        status = esp32Tls12ClientExportEcdhPublicKey(
            handshake, output + u32(5), u32(4091), publicLength
        )
        if (status != u32(0)) {
            esp32Tls12ClientDestroyKey(esp32Tls12ClientLoadU32(handshake + u32(84)))
            esp32Tls12ClientStoreU32(handshake + u32(84), u32(0))
            return u32(4294934656)
        }
        val publicKeyLength = esp32Tls12ClientLoadU32(publicLength)
        esp32Tls12ClientStoreU8(output + u32(4), publicKeyLength)
        contentLength = publicKeyLength + u32(1)
        status = esp32Tls12ClientComputeEcdhSecret(
            handshake, handshake + u32(2140), u32(102), handshake + u32(2244)
        )
        val destruction = esp32Tls12ClientDestroyKey(
            esp32Tls12ClientLoadU32(handshake + u32(84))
        )
        esp32Tls12ClientStoreU32(handshake + u32(84), u32(0))
        if (status != u32(0) || destruction != u32(0)) return u32(4294934656)
    } else if (keyExchange == u32(4)) {
        val hasPsk = esp32RecoveredMbedtlsSslConfHasStaticPsk(
            config, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        if (hasPsk == u32(0)) return u32(4294939648)
        val identityLength = esp32Tls12ClientLoadU32(config + u32(120))
        if (u32(6) + identityLength > u32(4096)) return u32(4294967158)
        esp32Tls12ClientStoreU8(output + u32(4), identityLength >> u32(8))
        esp32Tls12ClientStoreU8(output + u32(5), identityLength)
        freestandingCopy(output + u32(6), esp32Tls12ClientLoadU32(config + u32(116)), identityLength)
        headerLength = u32(6) + identityLength

        val frame = u32(nativeStackAllocate(32))
        val attributes = frame
        val publicLength = frame + u32(24)
        val sharedLength = frame + u32(28)
        esp32Tls12ClientConfigureEcdhAttributes(attributes, handshake)
        var status = esp32Tls12ClientGenerateEcdhKey(attributes, handshake)
        if (status != u32(0)) return esp32Tls12ClientTranslatePsaStatus(status)
        status = esp32Tls12ClientExportEcdhPublicKey(
            handshake, output + headerLength + u32(1),
            u32(4095) - headerLength, publicLength
        )
        if (status != u32(0)) {
            esp32Tls12ClientDestroyKey(esp32Tls12ClientLoadU32(handshake + u32(84)))
            esp32Tls12ClientStoreU32(handshake + u32(84), u32(0))
            return esp32Tls12ClientTranslatePsaStatus(status)
        }
        val publicKeyLength = esp32Tls12ClientLoadU32(publicLength)
        esp32Tls12ClientStoreU8(output + headerLength, publicKeyLength)
        contentLength = publicKeyLength + u32(1)
        val premaster = handshake + u32(2140)
        status = esp32Tls12ClientComputeEcdhSecret(
            handshake, premaster + u32(2), u32(100), sharedLength
        )
        val destruction = esp32Tls12ClientDestroyKey(
            esp32Tls12ClientLoadU32(handshake + u32(84))
        )
        esp32Tls12ClientStoreU32(handshake + u32(84), u32(0))
        if (status != u32(0)) return esp32Tls12ClientTranslatePsaStatus(status)
        if (destruction != u32(0)) return esp32Tls12ClientTranslatePsaStatus(destruction)
        val sharedSecretLength = esp32Tls12ClientLoadU32(sharedLength)
        esp32Tls12ClientStoreU8(premaster, sharedSecretLength >> u32(8))
        esp32Tls12ClientStoreU8(premaster + u32(1), sharedSecretLength)
    } else if (keyExchange == u32(3)) {
        val hasPsk = esp32RecoveredMbedtlsSslConfHasStaticPsk(
            config, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        if (hasPsk == u32(0)) return u32(4294939648)
        val identityLength = esp32Tls12ClientLoadU32(config + u32(120))
        if (u32(6) + identityLength > u32(4096)) return u32(4294967158)
        esp32Tls12ClientStoreU8(output + u32(4), identityLength >> u32(8))
        esp32Tls12ClientStoreU8(output + u32(5), identityLength)
        freestandingCopy(output + u32(6), esp32Tls12ClientLoadU32(config + u32(116)), identityLength)
        headerLength = u32(6) + identityLength
        contentLength = u32(0)
    } else {
        return u32(4294939648)
    }

    esp32Tls12ClientStoreU32(ssl + u32(192), headerLength + contentLength)
    esp32Tls12ClientStoreU32(ssl + u32(188), u32(22))
    esp32Tls12ClientStoreU8(output, u32(16))
    esp32Tls12ClientIncrementState(ssl)
    return esp32Tls12ClientWriteHandshake(ssl)
}

trusted fun esp32Tls12ClientWriteCertificateVerify(ssl: u32): u32 {
    var status = esp32RecoveredMbedtlsSslDeriveKeys(
        ssl, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (status != u32(0)) return status

    val handshake = esp32Tls12ClientLoadU32(ssl + u32(68))
    val ciphersuite = esp32Tls12ClientLoadU32(handshake + u32(16))
    if (!esp32Tls12ClientCertRequestAllowed(ciphersuite) ||
        esp32Tls12ClientLoadU8(handshake + u32(2000)) == u32(0) ||
        esp32Tls12ClientOwnCertificate(ssl) == u32(0)) {
        esp32Tls12ClientIncrementState(ssl)
        return u32(0)
    }
    val key = esp32Tls12ClientOwnKey(ssl)
    if (key == u32(0)) return u32(4294937088)

    val frame = u32(nativeStackAllocate(56))
    val hash = frame
    val hashLength = frame + u32(48)
    val signatureLength = frame + u32(52)
    val calculateVerify = esp32Tls12ClientLoadU32(handshake + u32(24))
    status = u32(ablaUnsafeCallI32I32I32I32(
        int(calculateVerify), int(ssl), int(hash), int(hashLength)
    ))
    if (status != u32(0)) return status

    val output = esp32Tls12ClientLoadU32(ssl + u32(184))
    var digestAlgorithm = u32(9)
    var wireHash = u32(4)
    if (esp32Tls12ClientLoadU8(ciphersuite + u32(9)) == u32(10)) {
        digestAlgorithm = u32(10)
        wireHash = u32(5)
    }
    esp32Tls12ClientStoreU8(output + u32(4), wireHash)
    val signature = esp32RecoveredMbedtlsSslSigFromPk(
        key, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    esp32Tls12ClientStoreU8(output + u32(5), signature)
