        if (esp32Tls12ClientLoadU8(config + u32(14)) == u32(0) || length != u32(0)) {
            esp32Tls12ClientSendFatalAlert(ssl, u32(110))
            return u32(4294937344)
        }
        esp32Tls12ClientStoreU8(handshake + u32(12), u32(1))
        return u32(0)
    }
    if (identifier == u32(35)) {
        if (esp32Tls12ClientLoadU8(config + u32(16)) == u32(0) || length != u32(0)) {
            esp32Tls12ClientSendFatalAlert(ssl, u32(110))
            return u32(4294937344)
        }
