// Preserve all descriptor flags except O_NONBLOCK. Negative fcntl results
// fail; F_SETFL is never attempted after F_GETFL failure.
trusted fun esp32TlsSetSocketNonblocking(descriptor: u32,enabled: bool): u32 {
    val flags=esp32TlsSocketFlags(descriptor,u32(3),u32(0))
    if (i32(flags) < i32(0)) {
        esp32TlsSocketModeError(descriptor,false)
        return u32(32773)
    }
    val updated=if (enabled) flags | u32(16384) else flags & ~u32(16384)
    if (i32(esp32TlsSocketFlags(descriptor,u32(4),updated)) < i32(0)) {
        esp32TlsSocketModeError(descriptor,true)
        return u32(32773)
    }
    u32(0)
}
