import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMbedtlsTls12ServerInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsSslHandshakeServerStep", "mbedtls_ssl_handshake_server_step")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSslConfPreferenceOrder", "mbedtls_ssl_conf_preference_order")) return false
    true
}
