import "../heap/capabilities_policy_esp32.ab"
import "../heap/capabilities_base_esp32.ab"
trusted fun esp32MbedtlsMemoryCalloc(count:u32,size:u32):u32 =
    esp32HeapCapsCallocate(count,size,u32(524292))

trusted fun esp32MbedtlsMemoryFree(memory:u32):void =
    esp32HeapCapsFree(memory)

trusted fun esp32RecoveredEspMbedtlsMemCalloc(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsMemoryCalloc(a2,a3)
trusted fun esp32RecoveredEspMbedtlsMemFree(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32{esp32MbedtlsMemoryFree(a2);return a2}
