import "../runtime/libc_syscalls_esp32.ab"
import "../vfs/calls_esp32.ab"
import "../../network/lwip/netdb_esp32.ab"
import "../../network/lwip/sockets_esp32.ab"
import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"
