// Complete Mbed TLS socket transport in structured Abla.
val esp32TlsNetInvalidDescriptor = u32(0xffffffff)
val esp32TlsNetUdp = u32(1)
val esp32TlsNetSocketFailed = u32(0xffffffbe)
val esp32TlsNetUnknownHost = u32(0xffffffae)
val esp32TlsNetConnectFailed = u32(0xffffffbc)
val esp32TlsNetBindFailed = u32(0xffffffba)
val esp32TlsNetListenFailed = u32(0xffffffb8)
val esp32TlsNetAcceptFailed = u32(0xffffffb6)
val esp32TlsNetBufferTooSmall = u32(0xffffff76)
val esp32TlsNetInvalidContext = u32(0xffffffbb)
val esp32TlsNetConnectionReset = u32(0xffffffb0)
val esp32TlsNetReceiveFailed = u32(0xffffffb4)
val esp32TlsNetSendFailed = u32(0xffffffb2)
val esp32TlsWantRead = u32(0xffff9700)
val esp32TlsWantWrite = u32(0xffff9780)
val esp32TlsTimeout = u32(0xffff9800)

@inline trusted fun esp32TlsNetLoad(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline trusted fun esp32TlsNetStore(
    address: u32, value: u32
): void = ablaUnsafeStoreU32(
    nativePointerFromAddress(int(address)), int(value)
)

@inline trusted fun esp32TlsNetLoadByte(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
)

trusted fun esp32TlsNetErrno(): u32 = esp32TlsNetLoad(u32(
    nativeInternalSectionThreadLocalAllocate(
        4, "errno", ".tdata.errno", 4
    )
))

trusted fun esp32TlsLwipSocket(
    domain: u32, kind: u32, protocol: u32
): u32 = esp32RecoveredLwipSocket(
    domain,kind,protocol,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32TlsLwipConnect(
    fd: u32, address: u32, length: u32
): u32 = esp32RecoveredLwipConnect(
    fd,address,length,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32TlsLwipBind(
    fd: u32, address: u32, length: u32
): u32 = esp32RecoveredLwipBind(
    fd,address,length,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32TlsLwipListen(fd: u32, backlog: u32): u32 =
    esp32RecoveredLwipListen(
        fd,backlog,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32TlsLwipSetOption(
    fd:u32,level:u32,option:u32,value:u32,length:u32
): u32 = esp32RecoveredLwipSetsockopt(
    fd,level,option,value,length,u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32TlsLwipGetOption(
    fd:u32,level:u32,option:u32,value:u32,length:u32
): u32 = esp32RecoveredLwipGetsockopt(
    fd,level,option,value,length,u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32TlsLwipAccept(
    fd:u32,address:u32,length:u32
): u32 = esp32RecoveredLwipAccept(
    fd,address,length,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32TlsLwipRecvfrom(
    fd:u32,data:u32,size:u32,flags:u32,address:u32,length:u32
): u32 = esp32RecoveredLwipRecvfrom(
    fd,data,size,flags,address,length,u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32TlsLwipGetsockname(
    fd:u32,address:u32,length:u32
): u32 = esp32RecoveredLwipGetsockname(
    fd,address,length,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32TlsLwipShutdown(fd:u32,direction:u32):u32 =
    esp32RecoveredLwipShutdown(
        fd,direction,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32TlsLwipGetaddrinfo(
    host:u32,service:u32,hints:u32,output:u32
): u32 = esp32RecoveredLwipGetaddrinfo(
    host,service,hints,output,u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32TlsLwipFreeaddrinfo(list:u32):void {
    esp32RecoveredLwipFreeaddrinfo(
        list,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    return
}

trusted fun esp32MbedtlsNetInit(context: u32): void =
    esp32TlsNetStore(context, esp32TlsNetInvalidDescriptor)

trusted fun esp32MbedtlsNetHints(protocol: u32): u32 {
    val hints = u32(nativeStackAllocate(32))
    freestandingSet(hints, i32(0), u32(32))
    esp32TlsNetStore(hints + u32(8),
        if (protocol == esp32TlsNetUdp) u32(2) else u32(1))
    esp32TlsNetStore(hints + u32(12),
        if (protocol == esp32TlsNetUdp) u32(17) else u32(6))
    return hints
}

trusted fun esp32MbedtlsNetConnect(
    context:u32,host:u32,port:u32,protocol:u32
): u32 {
    val hints = esp32MbedtlsNetHints(protocol)
    val output = u32(nativeStackAllocate(4))
    esp32TlsNetStore(output, u32(0))
    if (esp32TlsLwipGetaddrinfo(host,port,hints,output) != u32(0)) {
        return esp32TlsNetUnknownHost
    }
    val list = esp32TlsNetLoad(output)
    var current = list
    var result = esp32TlsNetUnknownHost
    while (current != u32(0)) {
        val fd = esp32TlsLwipSocket(
            esp32TlsNetLoad(current + u32(4)),
            esp32TlsNetLoad(current + u32(8)),
            esp32TlsNetLoad(current + u32(12))
        )
        if (i32(fd) < i32(0)) {
            result = esp32TlsNetSocketFailed
        } else if (esp32TlsLwipConnect(
            fd,
            esp32TlsNetLoad(current + u32(20)),
            esp32TlsNetLoad(current + u32(16))
        ) == u32(0)) {
            esp32TlsNetStore(context, fd)
            result = u32(0)
            current = u32(0)
        } else {
            esp32LibcClose(fd)
            result = esp32TlsNetConnectFailed
        }
        if (current != u32(0)) {
            current = esp32TlsNetLoad(current + u32(28))
        }
    }
    esp32TlsLwipFreeaddrinfo(list)
    return result
}

trusted fun esp32MbedtlsNetBind(
    context:u32,bindAddress:u32,port:u32,protocol:u32
): u32 {
    val hints = esp32MbedtlsNetHints(protocol)
    if (bindAddress == u32(0)) esp32TlsNetStore(hints + u32(4),u32(1))
    val output = u32(nativeStackAllocate(4))
    esp32TlsNetStore(output, u32(0))
    if (esp32TlsLwipGetaddrinfo(
        bindAddress,port,hints,output
    ) != u32(0)) return esp32TlsNetUnknownHost
    val list = esp32TlsNetLoad(output)
    var current = list
    var result = esp32TlsNetUnknownHost
    while (current != u32(0)) {
        val fd = esp32TlsLwipSocket(
            esp32TlsNetLoad(current + u32(4)),
            esp32TlsNetLoad(current + u32(8)),
            esp32TlsNetLoad(current + u32(12))
        )
        if (i32(fd) < i32(0)) {
            result = esp32TlsNetSocketFailed
        } else {
            val one = u32(nativeStackAllocate(4))
            esp32TlsNetStore(one,u32(1))
            if (esp32TlsLwipSetOption(
                fd,u32(4095),u32(4),one,u32(4)
            ) != u32(0)) {
                esp32LibcClose(fd)
                result = esp32TlsNetSocketFailed
            } else {
                val address=esp32TlsNetLoad(current+u32(20))
                val family=esp32TlsNetLoad(current+u32(4))
                if(family==u32(2))esp32TlsNetStore(address+u32(4),u32(0))
                if(family==u32(10))freestandingSet(address+u32(8),i32(0),u32(16))
                if (esp32TlsLwipBind(
                    fd,address,esp32TlsNetLoad(current+u32(16))
                ) != u32(0)) {
                    esp32LibcClose(fd)
                    result = esp32TlsNetBindFailed
                } else if (protocol != esp32TlsNetUdp &&
                    esp32TlsLwipListen(fd,u32(10)) != u32(0)) {
                    esp32LibcClose(fd)
                    result = esp32TlsNetListenFailed
                } else {
                    esp32TlsNetStore(context,fd)
                    result=u32(0)
                    current=u32(0)
                }
            }
        }
        if(current!=u32(0))current=esp32TlsNetLoad(current+u32(28))
    }
    esp32TlsLwipFreeaddrinfo(list)
    return result
}

trusted fun esp32MbedtlsNetWouldBlock(): bool =
    esp32TlsNetErrno() == u32(11)

trusted fun esp32MbedtlsNetAccept(
    listener:u32,client:u32,clientIp:u32,
    clientIpCapacity:u32,clientIpLength:u32
): u32 {
    val frame=u32(nativeStackAllocate(72))
    val address=frame
    val addressLength=frame+u32(32)
    val socketType=frame+u32(36)
    val socketTypeLength=frame+u32(40)
    esp32TlsNetStore(addressLength,u32(28))
    esp32TlsNetStore(socketTypeLength,u32(4))
    val listenerFd=esp32TlsNetLoad(listener)
    if(esp32TlsLwipGetOption(
        listenerFd,u32(4095),u32(1048584),
        socketType,socketTypeLength
    )!=u32(0))return esp32TlsNetAcceptFailed
    val kind=esp32TlsNetLoad(socketType)
    if(kind!=u32(1)&&kind!=u32(2))return esp32TlsNetAcceptFailed
    var accepted=u32(0)
    if(kind==u32(1)){
        accepted=esp32TlsLwipAccept(listenerFd,address,addressLength)
        esp32TlsNetStore(client,accepted)
    }else{
        accepted=esp32TlsLwipRecvfrom(
            listenerFd,frame+u32(44),u32(1),u32(1),
            address,addressLength
        )
    }
    if(i32(accepted)<i32(0)){
        return if(esp32MbedtlsNetWouldBlock())
            esp32TlsWantRead else esp32TlsNetAcceptFailed
    }
    if(kind!=u32(1)){
        val length=esp32TlsNetLoad(addressLength)
        if(esp32TlsLwipConnect(listenerFd,address,length)!=u32(0)){
            return esp32TlsNetAcceptFailed
        }
        esp32TlsNetStore(client,listenerFd)
        esp32TlsNetStore(listener,esp32TlsNetInvalidDescriptor)
        esp32TlsNetStore(addressLength,u32(28))
        if(esp32TlsLwipGetsockname(
            esp32TlsNetLoad(client),frame+u32(44),addressLength
        )!=u32(0))return esp32TlsNetSocketFailed
        val family=esp32TlsNetLoadByte(frame+u32(45))
        val replacement=esp32TlsLwipSocket(family,u32(2),u32(17))
        esp32TlsNetStore(listener,replacement)
        if(i32(replacement)<i32(0))return esp32TlsNetSocketFailed
        val one=frame+u32(68)
        esp32TlsNetStore(one,u32(1))
        if(esp32TlsLwipSetOption(
            replacement,u32(4095),u32(4),one,u32(4)
        )!=u32(0))return esp32TlsNetSocketFailed
        if(esp32TlsLwipBind(
            replacement,frame+u32(44),esp32TlsNetLoad(addressLength)
        )!=u32(0))return esp32TlsNetBindFailed
    }
    if(clientIp!=u32(0)){
        val family=esp32TlsNetLoadByte(address+u32(1))
        val bytes=if(family==u32(2))u32(4)else u32(16)
        esp32TlsNetStore(clientIpLength,bytes)
        if(clientIpCapacity<bytes)return esp32TlsNetBufferTooSmall
        val source=if(family==u32(2))address+u32(4)else address+u32(8)
        freestandingCopy(clientIp,source,bytes)
    }
    return u32(0)
}

trusted fun esp32MbedtlsNetSetBlock(context:u32):u32 {
    val fd=esp32TlsNetLoad(context)
    val flags=esp32LibcFcntlAbi(
        fd,u32(3),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    return esp32VfsFcntl(u32(0),fd,u32(4),flags&~u32(16384))
}

trusted fun esp32MbedtlsNetSetNonblock(context:u32):u32 {
    val fd=esp32TlsNetLoad(context)
    val flags=esp32LibcFcntlAbi(
        fd,u32(3),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    return esp32VfsFcntl(u32(0),fd,u32(4),flags|u32(16384))
}

trusted fun esp32MbedtlsNetUsleep(microseconds:u32):void {
    val timeout=u32(nativeStackAllocate(12))
    esp32TlsNetStore(timeout,microseconds/u32(1000000))
    esp32TlsNetStore(timeout+u32(4),u32(0))
    esp32TlsNetStore(timeout+u32(8),microseconds%u32(1000000))
    esp32VfsSelect(u32(0),u32(0),u32(0),u32(0),timeout)
    return
}

trusted fun esp32MbedtlsNetRecv(
    context:u32,data:u32,size:u32
):u32{
    val fd=esp32TlsNetLoad(context)
    if(i32(fd)<i32(0))return esp32TlsNetInvalidContext
    val result=esp32LibcRead(fd,data,size)
    if(i32(result)>=i32(0))return result
    val error=esp32TlsNetErrno()
    if(error==u32(11)||error==u32(4))return esp32TlsWantRead
    if(error==u32(32)||error==u32(104))return esp32TlsNetConnectionReset
    return esp32TlsNetReceiveFailed
}

trusted fun esp32MbedtlsNetRecvTimeout(
    context:u32,data:u32,size:u32,timeoutMilliseconds:u32
):u32{
    val fd=esp32TlsNetLoad(context)
    if(i32(fd)<i32(0))return esp32TlsNetInvalidContext
    val readSet=u32(nativeStackAllocate(8))
    freestandingSet(readSet,i32(0),u32(8))
    esp32VfsFdSetAdd(readSet,fd)
    val timeout=u32(nativeStackAllocate(12))
    esp32TlsNetStore(timeout,timeoutMilliseconds/u32(1000))
    esp32TlsNetStore(timeout+u32(4),u32(0))
    esp32TlsNetStore(
        timeout+u32(8),(timeoutMilliseconds%u32(1000))*u32(1000)
    )
    val selected=esp32VfsSelect(
        fd+u32(1),readSet,u32(0),u32(0),
        if(timeoutMilliseconds==u32(0))u32(0)else timeout
    )
    if(selected==u32(0))return esp32TlsTimeout
    if(i32(selected)<i32(0)){
        return if(esp32TlsNetErrno()==u32(4))
            esp32TlsWantRead else esp32TlsNetReceiveFailed
    }
    return esp32MbedtlsNetRecv(context,data,size)
}

trusted fun esp32MbedtlsNetSend(
    context:u32,data:u32,size:u32
):u32{
    val fd=esp32TlsNetLoad(context)
    if(i32(fd)<i32(0))return esp32TlsNetInvalidContext
    val result=esp32LibcWrite(fd,data,size)
    if(i32(result)>=i32(0))return result
    val error=esp32TlsNetErrno()
    if(error==u32(11)||error==u32(4))return esp32TlsWantWrite
    if(error==u32(32)||error==u32(104))return esp32TlsNetConnectionReset
    return esp32TlsNetSendFailed
}

trusted fun esp32MbedtlsNetFree(context:u32):void{
    if(context==u32(0))return
    val fd=esp32TlsNetLoad(context)
    if(fd==esp32TlsNetInvalidDescriptor)return
    esp32TlsLwipShutdown(fd,u32(2))
    esp32LibcClose(fd)
    esp32TlsNetStore(context,esp32TlsNetInvalidDescriptor)
}

trusted fun esp32RecoveredMbedtlsNetInit(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32{esp32MbedtlsNetInit(a2);return a2}
trusted fun esp32RecoveredMbedtlsNetConnect(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsNetConnect(a2,a3,a4,a5)
trusted fun esp32RecoveredMbedtlsNetBind(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsNetBind(a2,a3,a4,a5)
trusted fun esp32RecoveredMbedtlsNetAccept(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsNetAccept(a2,a3,a4,a5,a6)
trusted fun esp32RecoveredMbedtlsNetSetBlock(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsNetSetBlock(a2)
trusted fun esp32RecoveredMbedtlsNetSetNonblock(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsNetSetNonblock(a2)
trusted fun esp32RecoveredMbedtlsNetUsleep(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32{esp32MbedtlsNetUsleep(a2);return a2}
trusted fun esp32RecoveredMbedtlsNetRecv(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsNetRecv(a2,a3,a4)
trusted fun esp32RecoveredMbedtlsNetRecvTimeout(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsNetRecvTimeout(a2,a3,a4,a5)
trusted fun esp32RecoveredMbedtlsNetSend(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsNetSend(a2,a3,a4)
trusted fun esp32RecoveredMbedtlsNetFree(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32{esp32MbedtlsNetFree(a2);return a2}
