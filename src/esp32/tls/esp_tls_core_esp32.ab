val esp32TlsErrnoInterrupted = u32(nativeStaticBytes("Interrupted system call\x00"))
val esp32TlsErrnoIo = u32(nativeStaticBytes("I/O error\x00"))
val esp32TlsErrnoBadDescriptor = u32(nativeStaticBytes("Bad file number\x00"))
val esp32TlsErrnoInProgress =
    u32(nativeStaticBytes("Connection already in progress\x00"))
val esp32TlsErrnoUnreachable = u32(nativeStaticBytes("Host is unreachable\x00"))
val esp32TlsErrnoReset = u32(nativeStaticBytes("Connection reset by peer\x00"))
val esp32TlsErrnoTimeout = u32(nativeStaticBytes("Connection timed out\x00"))
val esp32TlsErrnoRefused = u32(nativeStaticBytes("Connection refused\x00"))
val esp32TlsErrnoUnknown = u32(nativeStaticBytes("socket error\x00"))

// TLS only consumes strerror for diagnostics. Keep its usual socket failures
// descriptive while allowing the complete hosted errno table and its large
// decision tree to disappear from a freestanding firmware image.
trusted fun esp32TlsErrnoText(error:u32):u32 {
    if (error == u32(4)) return esp32TlsErrnoInterrupted
    if (error == u32(5)) return esp32TlsErrnoIo
    if (error == u32(9)) return esp32TlsErrnoBadDescriptor
    if (error == u32(104)) return esp32TlsErrnoReset
    if (error == u32(110)) return esp32TlsErrnoTimeout
    if (error == u32(111)) return esp32TlsErrnoRefused
    if (error == u32(113)) return esp32TlsErrnoUnreachable
    if (error == u32(115)) return esp32TlsErrnoInProgress
    esp32TlsErrnoUnknown
}

