import "../runtime/libc_time_esp32.ab"
import "../runtime/picolibc_time_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Monotonic milliseconds for Mbed TLS. The ESP32 configuration uses one
// millisecond scheduler ticks, with wall-clock seconds only as a fallback.
trusted fun esp32MbedtlsMilliseconds(): u32 {
    val time = u32(nativeStackAllocate(16))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(time)), int(u32(0)))
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(time + u32(4))), int(u32(0))
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(time + u32(8))), int(u32(0))
    )
    val result = esp32RecoveredClockGettime(
        u32(4),time,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    if (result != u32(0)) {
        return esp32RecoveredTime(
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
        ) * u32(1000)
    }
    val seconds = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(time))
    ))
    val nanoseconds = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(time + u32(8)))
    ))
    return seconds * u32(1000) + nanoseconds / u32(1000000)
}

trusted fun esp32RecoveredMbedtlsMsTime(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsMilliseconds()
