import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMbedtlsPsaCryptoInitInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPsaCryptoInitIncludeImpl", "mbedtls_psa_crypto_init_include_impl")) return false
    true
}
