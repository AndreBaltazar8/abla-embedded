import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMbedtlsX509OidInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsX509OidGetAttrShortName", "mbedtls_x509_oid_get_attr_short_name")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509OidGetX509ExtType", "mbedtls_x509_oid_get_x509_ext_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509OidGetExtendedKeyUsage", "mbedtls_x509_oid_get_extended_key_usage")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509OidGetCertificatePolicies", "mbedtls_x509_oid_get_certificate_policies")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509OidGetSigAlgDesc", "mbedtls_x509_oid_get_sig_alg_desc")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509OidGetSigAlg", "mbedtls_x509_oid_get_sig_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsX509OidGetMdAlg", "mbedtls_x509_oid_get_md_alg")) return false
    true
}
