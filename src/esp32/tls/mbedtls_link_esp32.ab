import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTlsMbedtlsCallers(): bool {
    if (!internalFunction("esp32RecoveredEspMbedtlsRead", "esp_mbedtls_read")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsWrite", "esp_mbedtls_write")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsGetSslContext", "esp_mbedtls_get_ssl_context")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsVerifyCertificate", "esp_mbedtls_verify_certificate")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsHandshake", "esp_mbedtls_handshake")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsGetBytesAvail", "esp_mbedtls_get_bytes_avail")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsCleanup", "esp_mbedtls_cleanup")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsConnDelete", "esp_mbedtls_conn_delete")) return false
    if (!internalFunction("esp32RecoveredSetClientConfig", "set_client_config")) return false
    if (!internalFunction("esp32RecoveredEspCreateMbedtlsHandle", "esp_create_mbedtls_handle")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsServerSessionInit", "esp_mbedtls_server_session_init")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsServerSessionContinueAsync", "esp_mbedtls_server_session_continue_async")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsServerSessionCreate", "esp_mbedtls_server_session_create")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsServerSessionDelete", "esp_mbedtls_server_session_delete")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsInitGlobalCaStore", "esp_mbedtls_init_global_ca_store")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsSetGlobalCaStore", "esp_mbedtls_set_global_ca_store")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsGetGlobalCaStore", "esp_mbedtls_get_global_ca_store")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsFreeGlobalCaStore", "esp_mbedtls_free_global_ca_store")) return false
    if (!internalFunction("esp32RecoveredEspMbedtlsGetCiphersuitesList", "esp_mbedtls_get_ciphersuites_list")) return false
    true
}
