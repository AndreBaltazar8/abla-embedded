import "./dw_gdma_dsi_p4_sequence.ab"
import "./dw_gdma_channel_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4DwDmaRead(offset: int): u32 = u32(mmioLoadU32(0x50081000+offset))
trusted fun p4DwDmaWrite(offset: int,value: u32): void { mmioStoreU32(0x50081000+offset,int(value)); return }
trusted fun esp32P4DwDmaDsiConfigure(channel: int,descriptorAddress: int): int = esp32P4DwDmaDsiConfigureOwned(channel,descriptorAddress)
trusted fun esp32P4DwDmaDsiStartPrepared(channel: int): int = esp32P4DwDmaDsiStartPreparedOwned(channel)
trusted fun esp32P4DwDmaStop(channel: int,polls: int): int = esp32P4DwDmaStopOwned(channel,polls)
trusted fun esp32P4DwDmaEvents(channel: int): int = esp32P4DwDmaEventsOwned(channel)
trusted fun esp32P4DwDmaAcknowledge(channel: int,events: int): int = esp32P4DwDmaAcknowledgeOwned(channel,events)
