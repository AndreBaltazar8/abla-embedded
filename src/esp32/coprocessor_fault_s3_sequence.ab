import "./coprocessor_owner_s3_sequence.ab"
// Exception-policy building block, NOT a callback with implicit task lookup.
// Caller supplies the interrupted task's CP record while holding cross-core
// scheduler ownership, with live PS at INTLEVEL15/WOE/!EXCM. The exception
// record must belong to the interrupted task; any other saved enable bit must
// already have that task's state resident on this core. No task-ID inference.
// shell runs integer-only and restores saved CPENABLE at frame+148 on return.
// Only CP0/CP3 disabled faults are handled. Retry the same PC: do not advance
// PC or hardware-loop state. False requires the caller's repair/fatal policy.
@section(".iram1.abla.s3CpFault")
trusted fun esp32S3CoprocessorFaultOwned(frame: NativeBuffer,table: NativeBuffer,record: NativeBuffer,core: int): bool {
    if (!frame.hasAddressRange(0,192) || !esp32S3CpOwnerRange(frame.addressValue(),192,15)) return false
    val address=frame.addressValue()
    val cause=esp32S3CpOwnerRead(address+80)
    if (cause != 32 && cause != 35) return false
    val cp=cause-32
    if (!esp32S3CpOwnerGuard(table,core,cp) || !record.hasAddressRange(0,256)) return false
    val saved=esp32S3CpOwnerRead(address+148)
    if ((saved & ~9) != 0 || (saved & (1<<cp)) != 0) return false
    val tab=table.addressValue()
    val target=record.addressValue()
    if (!esp32S3CpOwnerRange(target,256,15) ||
        (address < tab+16 && tab < address+192) ||
        (address < target+256 && target < address+192)) return false
    var offset=0
    while (offset < 16) {
        val resident=esp32S3CpOwnerRead(tab+offset)
        if (resident != 0 && (!esp32S3CpOwnerRange(resident,256,15) ||
            (address < resident+256 && resident < address+192))) return false
        offset=offset+4
    }
    if (!esp32S3CpOwnerAcquireOwned(table,record,core,cp)) return false
    // Publish only after the requested task state is fully resident. Other
    // already-owned coprocessors keep their interrupted enable bits unchanged.
    esp32S3CpOwnerWrite(address+148,saved | (1<<cp))
    true
}
