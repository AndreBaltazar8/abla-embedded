import "./startup_memory_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
@inline
trusted fun esp32S3StartupMemoryCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3StartupMemoryEnabled(): int = int(xtensaGuardRead("rsr.intenable $0","=a,~{memory}"))
@inline
trusted fun esp32S3StartupMemoryStackPointer(): int = int(xtensaGuardRead("mov $0, a1","=a,~{memory}"))
@inline
trusted fun esp32S3StartupMemoryResetReason(): int = callNativeU32I32(0x4000057C,0)
@inline
trusted fun esp32S3StartupMemoryZero(address: int): void { mmioStoreU32(address,0); return }
