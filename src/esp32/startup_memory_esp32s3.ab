import "./startup_memory_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
@inline
@export("esp32S3StartupMemoryCore")
trusted fun esp32S3StartupMemoryCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3StartupMemoryEnabled")
trusted fun esp32S3StartupMemoryEnabledHook(): int = int(xtensaGuardRead("rsr.intenable $0","=r,~{memory}"))
@inline
@export("esp32S3StartupMemoryStackPointer")
trusted fun esp32S3StartupMemoryStackPointerHook(): int = int(xtensaGuardRead("mov $0, a1","=r,~{memory}"))
@inline
@export("esp32S3StartupMemoryResetReason")
trusted fun esp32S3StartupMemoryResetReasonHook(): int = callNativeU32I32(0x4000057C,0)
@inline
@export("esp32S3StartupMemoryZero")
trusted fun esp32S3StartupMemoryZeroHook(address: int): void { mmioStoreU32(address,0); return }
