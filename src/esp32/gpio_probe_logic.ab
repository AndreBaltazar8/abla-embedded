// Compact state used by the opt-in GPIO probe adapter. Hardware configuration
// is captured by gpio_probe_idf6.ab; these helpers stay pure for host tests.

fun gpioProbeState(
    pullUp: bool,
    pullDown: bool,
    inputEnabled: bool,
    outputEnabled: bool,
    openDrain: bool,
    drive: int,
    levelHigh: bool
): int = 1 |
    (if (pullUp) 1 << 1 else 0) |
    (if (pullDown) 1 << 2 else 0) |
    (if (inputEnabled) 1 << 3 else 0) |
    (if (outputEnabled) 1 << 4 else 0) |
    (if (openDrain) 1 << 5 else 0) |
    ((drive & 3) << 6) |
    (if (levelHigh) 1 << 8 else 0)

fun gpioProbeStateValid(state: int): bool = (state & 1) != 0
fun gpioProbeStatePullUp(state: int): bool = (state & (1 << 1)) != 0
fun gpioProbeStatePullDown(state: int): bool = (state & (1 << 2)) != 0
fun gpioProbeStateInput(state: int): bool = (state & (1 << 3)) != 0
fun gpioProbeStateOutput(state: int): bool = (state & (1 << 4)) != 0
fun gpioProbeStateOpenDrain(state: int): bool = (state & (1 << 5)) != 0
fun gpioProbeStateDrive(state: int): int = (state >>> 6) & 3
fun gpioProbeStateLevel(state: int): bool = (state & (1 << 8)) != 0

fun gpioProbeDirection(state: int): int {
    if (!gpioProbeStateValid(state)) return 0
    val input = gpioProbeStateInput(state)
    val output = gpioProbeStateOutput(state)
    val openDrain = gpioProbeStateOpenDrain(state)
    if (input && output && openDrain) return 7
    if (output && openDrain) return 6
    if (input && output) return 3
    if (output) return 2
    if (input) 1 else 0
}

fun gpioProbePullMode(state: int): int {
    val up = gpioProbeStatePullUp(state)
    val down = gpioProbeStatePullDown(state)
    if (up && down) return 2
    if (down) return 1
    if (up) 0 else 3
}
