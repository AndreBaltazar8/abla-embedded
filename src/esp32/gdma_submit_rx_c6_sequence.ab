import "./gdma_submit_c6_sequence.ab"
import "./gdma_rx_channel_c6_sequence.ab"
// RX uses empty length/EOF fields before DMA, preserves LINK AUTO_RET20,
// and uses STOP/START/RESTART21..23. Same retained16B submission contract:
// once head or START attempted no implicit retry; result1 is command issued,
// not proof of DMA activation (self-clearing command delivery is assumed).
trusted fun c6GdmaSubmitRxOwned(r: NativeBuffer,channel: int,peripheral: int,descriptors: int,
    count: int,buffers: int,stride: int,bytes: int,circular: bool,exclusive: bool): int {
    if (!exclusive || !c6GdmaSubmissionStorage(r) || r.loadU32(0) != 0 || c6GdmaRxBase(channel) < 0 ||
        (peripheral != 0 && peripheral != 2 && peripheral != 3 && peripheral != 6 && peripheral != 7 && peripheral != 8 && peripheral != 9) ||
        !c6GdmaRingValid(descriptors,count,buffers,stride,bytes)) return 2
    val address=r.addressValue()
    if ((address < descriptors+count*12 && descriptors < address+16) ||
        (address < buffers+(count-1)*stride+bytes && buffers < address+16)) return 2
    if (!c6GdmaClocksReady()) return 3
    if (!c6GdmaRxParked(channel)) return 4
    val base=c6GdmaRxBase(channel)
    if ((c6GdmaRead(base)&u32(30)) != u32(0) || (c6GdmaRead(base+4)&u32(4096)) == u32(0) ||
        (c6GdmaRead(base+48)&u32(63)) != u32(peripheral)) return 5
    c6GdmaDescriptorFence()
    var index=0
    while (index < count) {
        val at=descriptors+index*12
        val expected=u32(0x80000000)|u32(bytes)
        val next=if (index+1 < count) at+12 else if (circular) descriptors else 0
        if (c6GdmaDescriptorRead(at) != expected || c6GdmaDescriptorRead(at+4) != u32(buffers+index*stride) ||
            c6GdmaDescriptorRead(at+8) != u32(next)) return 7
        index=index+1
    }
    r.storeU32(0,0x43364453);r.storeU32(4,3);r.storeU32(8,channel);r.storeU32(12,descriptors)
    val link=base+16
    val head=(c6GdmaRead(link)&~u32(0xefffff))|u32(descriptors&0xfffff)
    c6GdmaWrite(link,head)
    if ((c6GdmaRead(link)&u32(0xefffff)) != u32(descriptors&0xfffff)) return 8
    c6GdmaDescriptorFence()
    r.storeU32(4,4)
    c6GdmaDescriptorFence()
    c6GdmaWrite(link,(c6GdmaRead(link)&~u32(0xe00000))|u32(0x400000))
    return 1
}
