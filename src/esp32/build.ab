import "abla/compiler"

// ESP32 platform policy stays in the framework. The Abla compiler remains
// target-generic and asks Espressif LLVM to produce one relocatable object.
compile fun esp32XtensaTarget(): bool = compilerDefineTarget(
    "esp32-xtensa",
    "xtensa-esp-unknown-elf",
    "elf",
    "none",
    "none",
    false,
    false
)

compile fun esp32BuildObject(
    name: string,
    entry: string,
    output: string,
    fast: bool = false,
    cache: bool = true
): bool {
    val target = esp32XtensaTarget()
    val program = compilerBuildProgram(
        name,
        entry,
        output,
        "esp32-xtensa",
        "object",
        fast,
        cache
    )
    target && program
}
