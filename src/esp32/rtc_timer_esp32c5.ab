import "./rtc_timer_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@inline
@export("c5RtcTimerRead")
trusted fun c5RtcTimerReadHook(offset: int): int = mmioLoadU32(0x600b0c00+offset)
@inline
@export("c5RtcTimerWrite")
trusted fun c5RtcTimerWriteHook(offset: int,value: int): void { mmioStoreU32(0x600b0c00+offset,value);return }
