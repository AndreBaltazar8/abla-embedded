import "./window_vectors_esp32s3.ab"
import "./medium_vectors_esp32s3.ab"
import "./user_vector_esp32s3.ab"
import "./high_vectors_esp32s3.ab"
// Root the entire default vector set in one LLVM compilation. Return zero
// when the final linker did not place every required slot at its fixed offset.
// Caller still installs ISR/exception policy and valid stacks before VECBASE;
// this does not initialize the CPU, scheduler, caches or peripheral interrupts.
// High/debug/NMI defaults halt; replace those for resumable high-level services.
@section(".iram1.abla.s3VectorsAddress")
trusted fun esp32S3VectorsAddress(): int {
    val base=esp32S3WindowVectorsAddress()
    if (base < 0x40370000 || base > 0x403DFC00 || (base & 1023) != 0 ||
        esp32S3Level2VectorAddress() != base+0x180 || esp32S3Level3VectorAddress() != base+0x1C0 ||
        esp32S3Level4VectorAddress() != base+0x200 || esp32S3Level5VectorAddress() != base+0x240 ||
        esp32S3Level6VectorAddress() != base+0x280 || esp32S3Level7VectorAddress() != base+0x2C0 ||
        esp32S3KernelVectorAddress() != base+0x300 || esp32S3UserVectorAddress() != base+0x340 ||
        esp32S3DoubleVectorAddress() != base+0x3C0) return 0
    base
}
