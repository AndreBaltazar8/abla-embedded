import "./clock_state_s3.ab"
import "abla/runtime/scalar"
// Cold-start preparation only: undivided XTAL32/40, PLL fully powered down,
// both caches disabled/idle, both MSPI ports idle, CPU1 held reset, interrupts,
// DMA/radio/UART/analog clients excluded, internal continuation/stack and
// watchdog owned. Caller proves initialized voltage safe for CPU80MHz and
// accounts for the resulting APB80MHz before releasing any peripherals.
// Does not guess bias or retune a live PLL. Existing calibrated PLL480 state
// may be accepted only under the caller's calibration/ownership proof.
// 1ready;2invalid/proof;3unsupported state (no mutation);4calibration timeout;
// 5PLL/switch failure. Failure retains all exclusions; no automatic retry.
@section(".iram1.abla.s3StartupClock")
trusted fun esp32S3StartupClock480Owned(polls: int,ownedColdBoot: bool): int {
    if (!ownedColdBoot || polls < 1 || polls > 1000000) return 2
    val sys=esp32S3ClockRead(0x600c0060)
    val cpu=esp32S3ClockRead(0x600c0010)
    val power=esp32S3ClockRead(0x60008000)&0x540
    if (((sys>>>10)&3) == 1 && (cpu&4) != 0 && (cpu&3) != 3 && power == 0) return 1
    val xtal=esp32S3StoredXtalMegahertz(esp32S3ClockRead(0x600080c0))
    if ((sys&4095) != 0 || (xtal != 32 && xtal != 40) || power != 0x540 ||
        (esp32S3ClockRead(0x600c0000)&4) == 0 ||
        (esp32S3ClockRead(0x600c4000)&1) != 0 || (esp32S3ClockRead(0x600c4060)&1) != 0 ||
        (esp32S3ClockRead(0x600c4130)&0xffffff) != 0x1001 ||
        esp32S3ClockRead(0x60002000) != 0 || esp32S3ClockRead(0x60003000) != 0) return 3
    // Calibrator's delay uses the current undivided crystal frequency.
    esp32S3ClockRomTicks(xtal)
    val started=esp32S3PllStartOwned(480,polls)
    if (started == 3) return 4
    if (started != 1) return 5
    // This path is XTAL<=40 -> CPU80, never a240MHz bias transition, so
    // these unused bias arguments cannot cause voltage-register writes.
    if (!esp32S3ClockToReadyPllOwned(80,0,0,0,0).valid()) return 5
    if ((esp32S3ClockRead(0x600c0060)&4095) != 1024 ||
        (esp32S3ClockRead(0x600c0010)&7) != 4 || (esp32S3ClockRead(0x60008000)&0x540) != 0) return 5
    return 1
}
