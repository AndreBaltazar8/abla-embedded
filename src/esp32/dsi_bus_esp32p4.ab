import "./dsi_clock_esp32p4.ab"
import "./dsi_start_esp32p4.ab"
import "./dsi_bus_p4_sequence.ab"
trusted fun esp32P4DsiOpen(hwVersion: int,lanes: int,cfgSource: int,refSource: int,referenceDiv: int,referenceKhz: int,laneKbps: int,channel: int,forceHs: bool,polls: int): Esp32P4DsiBus =
    esp32P4DsiOpenOwned(hwVersion,lanes,cfgSource,refSource,referenceDiv,referenceKhz,laneKbps,channel,forceHs,polls)
trusted fun Esp32P4DsiBus.close(polls: int): Esp32P4DsiBus = this.closeOwned(polls)
