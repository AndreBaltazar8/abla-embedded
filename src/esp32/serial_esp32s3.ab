import "abla/unsafe/mmio"
import "./uart/serial_s3_sequence.ab"
import "../hal/esp32.ab"
@export("esp32S3SerialReadStatus")
trusted fun esp32S3SerialReadStatusHook(): int = mmioLoadU32(0x6000001c)
@export("esp32S3SerialWriteFifo")
trusted fun esp32S3SerialWriteFifoHook(value: int): void {
    mmioStoreU32(0x60000000,value)
    return
}
