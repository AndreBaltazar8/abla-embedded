// Calibrated P4 LDO selection from IDF6 hal/ldo_ll.h. Pure calculation:
// no eFuse writes, rail switching, allocation or implicit supply ownership.
// Channels are hardware VO1..VO4. Caller supplies READ eFuse calibration.
type Esp32P4LdoVoltage = int
fun Esp32P4LdoVoltage.valid(): bool = (this&256) != 0
fun Esp32P4LdoVoltage.dref(): int = this&15
fun Esp32P4LdoVoltage.multiplier(): int = (this>>>4)&7
fun Esp32P4LdoVoltage.bypass(): bool = (this&128) != 0
// Predicted voltage in mV*80000, not a physical voltage measurement.
fun Esp32P4LdoVoltage.predictedScaled(): int = (this>>>32)&4294967295

fun esp32P4LdoSelectVoltage(channel: int,millivolts: int,calibrated: bool,kRaw: int,vosRaw: int,cRaw: int,factoryDref: int,factoryMul: int): Esp32P4LdoVoltage {
    if (channel < 1 || channel > 4 || (millivolts != 3300 && (millivolts < 500 || millivolts > 2700)) ||
        kRaw < 0 || kRaw > 255 || vosRaw < 0 || vosRaw > 63 || cRaw < 0 || cRaw > 63 ||
        factoryDref < 0 || factoryDref > 15 || factoryMul < 0 || factoryMul > 7) return Esp32P4LdoVoltage(0)
    var k=1000
    var vos=0
    var c=1000
    if (calibrated && channel >= 3) {
        if (kRaw != 0) k=975+(if ((kRaw&128) != 0) -(kRaw&127) else kRaw)
        if (vosRaw != 0) vos= -3+(if ((vosRaw&32) != 0) -(vosRaw&31) else vosRaw)
        if (cRaw != 0) c=990+(if ((cRaw&32) != 0) -(cRaw&31) else cRaw)
    }
    var bestDifference=u32(400000000)
    var bestDref=0
    var bestMul=0
    var bestVoltage=u32(0)
    val target=u32(millivolts)*u32(80000)
    var dref=0
    while (dref < 16) {
        val vref=if (dref < 9) 10+dref else 20+(dref-9)*2
        var mul=0
        while (mul < 8) {
            // Positive and <2^32 throughout the validated calibration range.
            val voltage=u32(vref*k+20*vos)*u32(4000+mul*c)
            val difference=if (voltage > target) voltage-target else target-voltage
            if (difference < bestDifference) {
                bestDifference=difference; bestDref=dref; bestMul=mul; bestVoltage=voltage
            }
            mul=mul+1
        }
        dref=dref+1
    }
    if (calibrated && channel <= 2 && millivolts == 1800 && factoryDref != 0 && factoryMul != 0) {
        bestDref=factoryDref; bestMul=factoryMul
        val vref=if (bestDref < 9) 10+bestDref else 20+(bestDref-9)*2
        bestVoltage=u32(vref*1000)*u32(4000+bestMul*1000)
    }
    if (millivolts == 3300) bestVoltage=u32(264000000)
    Esp32P4LdoVoltage(256|(if (millivolts == 3300) 128 else 0)|bestDref|(bestMul<<4)|(int(bestVoltage)<<32))
}
