import "./context_extra_esp32s3.ab"
// Final integer/NCP return paths entered with a1=192-byte frame, EXCM set,
// interrupts masked. Caller restores separately owned coprocessor state first.
// Private region contains level1/2/3 entry offsets0/64/128 and shared CALL0
// restore at192. Not a C/Abla-callable ABI, not standalone exception vectors.
// Level1 saved PS includes EXCM; RFE clears it. RFI2/3 atomically restore EPSn.
// No external names: all architectural branches use local assembly labels.
// Shared restore layout matches context_esp32s3.ab; instruction checks cover it.
@naked
@noinline
@section(".iram1.abla.s3ContextReturns")
trusted fun esp32S3ContextReturns(): void =
    esp32S3ContextExtraAssembly(".Labla_s3_returns_base:\n.org .Labla_s3_returns_base+0\ncall0 .Labla_s3_returns_restore\nl32i a0, a1, 8\nwsr.ps a0\nl32i a0, a1, 4\nwsr.epc1 a0\nl32i a0, a1, 12\nl32i a1, a1, 16\nrsync\nrfe\n.org .Labla_s3_returns_base+64\ncall0 .Labla_s3_returns_restore\nl32i a0, a1, 8\nwsr.eps2 a0\nl32i a0, a1, 4\nwsr.epc2 a0\nl32i a0, a1, 12\nl32i a1, a1, 16\nrsync\nrfi 2\n.org .Labla_s3_returns_base+128\ncall0 .Labla_s3_returns_restore\nl32i a0, a1, 8\nwsr.eps3 a0\nl32i a0, a1, 4\nwsr.epc3 a0\nl32i a0, a1, 12\nl32i a1, a1, 16\nrsync\nrfi 3\n.org .Labla_s3_returns_base+192\n.Labla_s3_returns_restore:\nl32i a3, a1, 112\nwur.threadptr a3\nl32i a3, a1, 116\nwsr.acclo a3\nl32i a3, a1, 120\nwsr.acchi a3\nl32i a3, a1, 124\nwsr.br a3\nl32i a3, a1, 128\nwsr.scompare1 a3\nl32i a3, a1, 132\nwsr.m0 a3\nl32i a3, a1, 136\nwsr.m1 a3\nl32i a3, a1, 140\nwsr.m2 a3\nl32i a3, a1, 144\nwsr.m3 a3\nl32i a3, a1, 88\nwsr.lbeg a3\nl32i a3, a1, 92\nwsr.lend a3\nl32i a3, a1, 96\nwsr.lcount a3\nl32i a3, a1, 76\nwsr.sar a3\nl32i a2, a1, 20\nl32i a3, a1, 24\nl32i a4, a1, 28\nl32i a5, a1, 32\nl32i a6, a1, 36\nl32i a7, a1, 40\nl32i a8, a1, 44\nl32i a9, a1, 48\nl32i a10, a1, 52\nl32i a11, a1, 56\nl32i a12, a1, 60\nl32i a13, a1, 64\nl32i a14, a1, 68\nl32i a15, a1, 72\nrsync\nret", "~{memory}")
@inline
trusted fun esp32S3ContextReturn1Address(): int = nativeFunctionAddress(esp32S3ContextReturns)
@inline
trusted fun esp32S3ContextReturn2Address(): int = nativeFunctionAddress(esp32S3ContextReturns)+64
@inline
trusted fun esp32S3ContextReturn3Address(): int = nativeFunctionAddress(esp32S3ContextReturns)+128
