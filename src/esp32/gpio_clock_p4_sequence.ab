// P4 layouts1/3: RCC SOC_CLK_CTRL3+0x20 bit3 IOMUX APB,
// PERI_CLK_CTRL26+0xac bit9 functional gate; HP_RST_EN1+0xc4 bit3 reset.
// Caller serializes ALL RCC writers and holds one lease covering every pad/
// peripheral consumer until close. Copies are not independent leases. Source
// clock must already be stable; never change source/divider or pulse reset.
// Existing gates are borrowed, never disabled. This is IOMUX, not a claim to
// initialize LP GPIO, PMU force holds or the complete GPIO power domain.
type Esp32P4IomuxClockOwner = int
fun Esp32P4IomuxClockOwner.status(): int = this&255
fun Esp32P4IomuxClockOwner.ownsApb(): bool = (this&256) != 0
fun Esp32P4IomuxClockOwner.ownsFunctional(): bool = (this&512) != 0
fun Esp32P4IomuxClockOwner.ready(): bool = this.status() == 1
trusted fun p4IomuxClockField(offset: int,bit: u32,enabled: bool): bool {
    val before=p4IomuxClockRead(offset)
    p4IomuxClockWrite(offset,if (enabled) before|bit else before&(u32(4294967295)^bit))
    return ((p4IomuxClockRead(offset)&bit) != u32(0)) == enabled
}
// 0closed,1ready,2invalid,3held in reset,4APB failure,5functional failure.
// Failed writes retain attempted ownership; caller must close partial setup.
trusted fun esp32P4IomuxClockOpenOwned(layout: int): Esp32P4IomuxClockOwner {
    if (layout != 1 && layout != 3) return Esp32P4IomuxClockOwner(2)
    if ((p4IomuxClockRead(196)&u32(8)) != u32(0)) return Esp32P4IomuxClockOwner(3)
    var owned=0
    if ((p4IomuxClockRead(32)&u32(8)) == u32(0)) {
        owned=owned|256
        if (!p4IomuxClockField(32,u32(8),true)) return Esp32P4IomuxClockOwner(owned|4)
    }
    if ((p4IomuxClockRead(172)&u32(512)) == u32(0)) {
        owned=owned|512
        if (!p4IomuxClockField(172,u32(512),true)) return Esp32P4IomuxClockOwner(owned|5)
    }
    return Esp32P4IomuxClockOwner(owned|1)
}
// Only after every consumer is quiesced and all child pad/peripheral leases
// returned. Partial close keeps remaining flags and can be retried under RCC
// serialization. No mux/pad MMIO after this operation begins.
trusted fun Esp32P4IomuxClockOwner.closeOwned(): Esp32P4IomuxClockOwner {
    if (this < 0 || this > 773 || this.status() > 5) return this
    var owned=this&768
    if ((owned&512) != 0) {
        if (!p4IomuxClockField(172,u32(512),false)) return Esp32P4IomuxClockOwner(owned|5)
        owned=owned&256
    }
    if ((owned&256) != 0) {
        if (!p4IomuxClockField(32,u32(8),false)) return Esp32P4IomuxClockOwner(owned|4)
    }
    return Esp32P4IomuxClockOwner(0)
}
