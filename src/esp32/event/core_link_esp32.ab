import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEventCoreOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspEventLoopCreate", "esp_event_loop_create")) return false
    if (!internalFunction("esp32RecoveredEspEventLoopRun", "esp_event_loop_run")) return false
    if (!internalFunction("esp32RecoveredEspEventLoopDelete", "esp_event_loop_delete")) return false
    if (!internalFunction("esp32RecoveredEspEventHandlerRegisterWithInternal", "esp_event_handler_register_with_internal")) return false
    if (!internalFunction("esp32RecoveredEspEventHandlerRegisterWith", "esp_event_handler_register_with")) return false
    if (!internalFunction("esp32RecoveredEspEventHandlerInstanceRegisterWith", "esp_event_handler_instance_register_with")) return false
    if (!internalFunction("esp32RecoveredEspEventPostTo", "esp_event_post_to")) return false
    if (!internalFunction("esp32RecoveredEspEventHandlerUnregisterWithInternal", "esp_event_handler_unregister_with_internal")) return false
    if (!internalFunction("esp32RecoveredEspEventHandlerUnregisterWith", "esp_event_handler_unregister_with")) return false
    if (!internalFunction("esp32RecoveredEspEventHandlerInstanceUnregisterWith", "esp_event_handler_instance_unregister_with")) return false
    if (!internalFunction("esp32RecoveredEspEventIsrPostTo", "esp_event_isr_post_to")) return false
    if (!internalFunction("esp32RecoveredEspEventDump", "esp_event_dump")) return false
    true
}
