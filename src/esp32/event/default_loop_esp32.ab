import "abla/unsafe/memory"

// Default ESP event-loop facade implemented as typed Abla. The loop handle is
// private module state, so every wrapper remains an internal DCE candidate.
var esp32DefaultEventLoop = u32(0)

val esp32DefaultEventLoopTaskNameStorage = nativeStaticBytes("\x73\x79\x73\x5f\x65\x76\x74\x00")
val esp32DefaultEventLoopTaskName = u32(esp32DefaultEventLoopTaskNameStorage)

@inline
trusted fun esp32DefaultEventLoopMissing():u32 = u32(259)

trusted fun esp32RecoveredEspEventHandlerRegister(eventBase:u32,eventId:u32,handler:u32,handlerArgument:u32):u32 {
    if (esp32DefaultEventLoop == u32(0)) return esp32DefaultEventLoopMissing()
    esp32RecoveredEspEventHandlerRegisterWith(
        esp32DefaultEventLoop,eventBase,eventId,handler,handlerArgument,u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
}

trusted fun esp32RecoveredEspEventHandlerInstanceRegister(eventBase:u32,eventId:u32,handler:u32,handlerArgument:u32,instance:u32):u32 {
    if (esp32DefaultEventLoop == u32(0)) return esp32DefaultEventLoopMissing()
    esp32RecoveredEspEventHandlerInstanceRegisterWith(
        esp32DefaultEventLoop,eventBase,eventId,handler,handlerArgument,instance,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
}

trusted fun esp32RecoveredEspEventHandlerUnregister(eventBase:u32,eventId:u32,handler:u32):u32 {
    if (esp32DefaultEventLoop == u32(0)) return esp32DefaultEventLoopMissing()
    esp32RecoveredEspEventHandlerUnregisterWith(
        esp32DefaultEventLoop,eventBase,eventId,handler,u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
}

trusted fun esp32RecoveredEspEventHandlerInstanceUnregister(eventBase:u32,eventId:u32,instance:u32):u32 {
    if (esp32DefaultEventLoop == u32(0)) return esp32DefaultEventLoopMissing()
    esp32RecoveredEspEventHandlerInstanceUnregisterWith(
        esp32DefaultEventLoop,eventBase,eventId,instance,u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
}

trusted fun esp32RecoveredEspEventPost(eventBase:u32,eventId:u32,eventData:u32,eventDataSize:u32,ticksToWait:u32):u32 {
    if (esp32DefaultEventLoop == u32(0)) return esp32DefaultEventLoopMissing()
    esp32RecoveredEspEventPostTo(
        esp32DefaultEventLoop,eventBase,eventId,eventData,eventDataSize,ticksToWait,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
}

trusted fun esp32RecoveredEspEventIsrPost(eventBase:u32,eventId:u32,eventData:u32,eventDataSize:u32,taskUnblocked:u32):u32 {
    if (esp32DefaultEventLoop == u32(0)) return esp32DefaultEventLoopMissing()
    esp32RecoveredEspEventIsrPostTo(
        esp32DefaultEventLoop,eventBase,eventId,eventData,eventDataSize,taskUnblocked,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
}

trusted fun esp32RecoveredEspEventLoopCreateDefault():u32 {
    if (esp32DefaultEventLoop != u32(0)) return esp32DefaultEventLoopMissing()
    // esp_event_loop_args_t: queue size, task name, priority, stack, core.
    val configuration = u32(nativeStackAllocate(20))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(configuration)),32)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(configuration + u32(4))),int(esp32DefaultEventLoopTaskName))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(configuration + u32(8))),20)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(configuration + u32(12))),2816)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(configuration + u32(16))),0)
    val output = u32(nativeStackAllocate(4))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(output)),0)
    val result = esp32RecoveredEspEventLoopCreate(
        configuration,output,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (result == u32(0)) esp32DefaultEventLoop = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(output))))
    result
}

trusted fun esp32RecoveredEspEventLoopDeleteDefault():u32 {
    if (esp32DefaultEventLoop == u32(0)) return esp32DefaultEventLoopMissing()
    val result = esp32RecoveredEspEventLoopDelete(
        esp32DefaultEventLoop,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (result == u32(0)) esp32DefaultEventLoop = u32(0)
    result
}
