import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkDefaultEventLoopOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspEventHandlerRegister", "esp_event_handler_register")) return false
    if (!internalFunction("esp32RecoveredEspEventHandlerInstanceRegister", "esp_event_handler_instance_register")) return false
    if (!internalFunction("esp32RecoveredEspEventHandlerUnregister", "esp_event_handler_unregister")) return false
    if (!internalFunction("esp32RecoveredEspEventHandlerInstanceUnregister", "esp_event_handler_instance_unregister")) return false
    if (!internalFunction("esp32RecoveredEspEventPost", "esp_event_post")) return false
    if (!internalFunction("esp32RecoveredEspEventIsrPost", "esp_event_isr_post")) return false
    if (!internalFunction("esp32RecoveredEspEventLoopCreateDefault", "esp_event_loop_create_default")) return false
    if (!internalFunction("esp32RecoveredEspEventLoopDeleteDefault", "esp_event_loop_delete_default")) return false
    true
}
