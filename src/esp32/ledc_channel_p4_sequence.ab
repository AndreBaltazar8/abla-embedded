import "./ledc_p4_sequence.ab"
// Static duty updates through P4's gamma engine, matching IDF v6.0.2
// ledc_duty_config + _ledc_update_duty. Caller owns channel/gamma RAM/IRQ/ETM
// and a stable running timer and clock lease; GPIO routing is separate.
// 1 applied, 2 invalid, 3 busy, 4 readback, 5 timeout, 6 timer unavailable.
// A timeout is NOT cancellation: retain channel/clock ownership and poll again.
// Readback failures before publication retain the previous output and partially
// staged parameters. Never enable another channel, reset or gate clocks here.
trusted fun p4LedcChannelField(offset: int,mask: int,value: int): bool {
    p4LedcWrite(offset,(p4LedcRead(offset)&(0xffffffff^mask))|value)
    return (p4LedcRead(offset)&mask) == value
}
trusted fun p4LedcChannelWaitOwned(channel: int,polls: int): int {
    if (channel < 0 || channel > 7 || polls < 1 || polls > 1000000) return 2
    var remaining=polls
    while (remaining > 0) {
        if ((p4LedcRead(channel*20)&16) == 0 && (p4LedcRead(channel*20+12)&0x80000000) == 0) return 1
        remaining=remaining-1
    }
    return 5
}
trusted fun p4LedcChannelSetDutyOwned(channel: int,timer: int,duty: int,hpoint: int,polls: int): int {
    val timerOffset=p4LedcTimerOffset(timer)
    if (channel < 0 || channel > 7 || timerOffset < 0 || duty < 0 || hpoint < 0 || hpoint > 1048575 || polls < 1 || polls > 1000000) return 2
    val timerConfig=p4LedcRead(timerOffset)
    val resolution=timerConfig&31
    if ((timerConfig&0x5800000) != 0 || p4LedcTimerParameters(resolution,(timerConfig>>5)&262143) < 0) return 6
    var limit=1; var bit=0
    while (bit < resolution) { limit=limit*2; bit=bit+1 }
    // Full-scale at maximum counter width may overflow the hardware counter.
    if (duty > limit || (resolution == 20 && duty == limit) || hpoint >= limit) return 2
    val offset=channel*20
    val config=p4LedcRead(offset)
    if ((config&0x8010) != 0 || (p4LedcRead(offset+12)&0x80000000) != 0 ||
        ((config&4) != 0 && (config&3) != timer)) return 3
    if (!p4LedcChannelField(offset+4,0xfffff,hpoint) ||
        !p4LedcChannelField(offset+8,0x1ffffff,duty<<4)) return 4
    // One cycle, one step, increase, zero scale: constant duty, not a ramp.
    // Clear ALL unused ranges: IDF notes stale RAM can corrupt the waveform.
    var range=0
    while (range < 16) {
        if (!p4LedcChannelField(1024+channel*64+range*4,0x7fffffff,if (range == 0) 0x200003 else 0)) return 4
        range=range+1
    }
    // Do not replay the write-trigger gamma pause/resume fields.
    val gamma=256+channel*4
    p4LedcWrite(gamma,(p4LedcRead(gamma)&0xffffff80)|1)
    if ((p4LedcRead(gamma)&31) != 1) return 4
    val enabled=(config&0xfffeffe0)|timer|4
    p4LedcWrite(offset,enabled)
    if ((p4LedcRead(offset)&15) != (timer|4)) return 4
    p4LedcWrite(offset+12,p4LedcRead(offset+12)|0x80000000)
    p4LedcWrite(offset,enabled|16)
    val waited=p4LedcChannelWaitOwned(channel,polls)
    if (waited != 1) return waited
    return if ((p4LedcRead(offset+16)&0x1ffffff) == (duty<<4)) 1 else 4
}
trusted fun p4LedcChannelStopOwned(channel: int,idleHigh: bool,polls: int): int {
    if (channel < 0 || channel > 7 || polls < 1 || polls > 1000000) return 2
    if (p4LedcChannelWaitOwned(channel,1) != 1) return 3
    val offset=channel*20
    val value=(p4LedcRead(offset)&0xfffeffe3)|(if (idleHigh) 8 else 0)
    p4LedcWrite(offset,value)
    if ((p4LedcRead(offset)&12) != (if (idleHigh) 8 else 0)) return 4
    p4LedcWrite(offset,value|16)
    return p4LedcChannelWaitOwned(channel,polls)
}
