// Pure classic-ESP32 GPIO topology. Keeping this separate makes the register
// mapping host-testable without touching MMIO.
@inline
fun esp32GpioValid(number: int): bool =
    number >= 0 && number < 40 && number != 24 &&
        (number < 28 || number > 31)

@inline
fun esp32GpioOutputValid(number: int): bool =
    esp32GpioValid(number) && number < 34

@inline
fun esp32IoMuxOffset(number: int): int {
    if (!esp32GpioValid(number)) return -1
    val group = number / 4
    val packed = if (group == 0) 2218821700
        else if (group == 1) 1684040776
        else if (group == 2) 1549292648
        else if (group == 3) 1009793076
        else if (group == 4) 1953517644
        else if (group == 5) 2357230712
        else if (group == 6) 740828415
        else if (group == 7) 4294967295
        else if (group == 8) 403972124
        else 269223940
    (packed >>> ((number & 3) * 8)) & 255
}
