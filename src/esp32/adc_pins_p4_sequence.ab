import "./gpio_p4_sequence.ab"
import "./gpio/snapshot_p4_sequence.ab"
// ESP-IDF6 esp32p4 adc_channel.h: ADC1 channels0..7 onGPIO16..23;
// ADC2 channels0..5 onGPIO49..54. Neither bank is an LP GPIO pad.
fun esp32p4AdcPin(unit: int,channel: int): int =
    if (unit == 1 && channel >= 0 && channel < 8) 16+channel
    else if (unit == 2 && channel >= 0 && channel < 6) 49+channel else -1
// Scalar39bit GPIO snapshot plus status4bits at40. No allocation or hidden
// conversion start. Caller owns/quiesces former digital/analog/ADC users,
// holds released and GPIO/IOMUX clocks pinned, including PMU/globalholds.
// Analog setup follows IDF gpio_config_as_analog: floating digital input/output,
// pulls disabled, GPIO mux. ADC power/clock/calibration/conversion is separate.
// Status1configured2invalid/unowned3held4partialsetup5restored6restorefailure.
// Both status1/4 retain the original snapshot; neither failure releases pins.
type P4AdcPad=int
fun P4AdcPad.status(): int = (this >>> 40)&15
fun P4AdcPad.pin(): int = P4GpioSnapshot(this&0x7fffffffff).pin()
fun P4AdcPad.hasSnapshot(): bool = P4GpioSnapshot(this&0x7fffffffff).valid()
trusted fun esp32p4AdcPadOpenOwned(unit: int,channel: int,layout: int,exclusive: bool): P4AdcPad {
    val pin=esp32p4AdcPin(unit,channel)
    if (!exclusive || pin < 0 || (layout != 1 && layout != 3)) return P4AdcPad(2 << 40)
    val saved=esp32p4GpioSnapshotOwned(pin,layout,true)
    if (!saved.valid()) return P4AdcPad(3 << 40)
    val configured=esp32P4GpioConfigureOwned(pin,false,false,false,false,0)
    return P4AdcPad((saved|0)|((if (configured == 1) 1 else 4) << 40))
}
// ADC must be stopped and no conversion/DMA may own the pin when closing.
// Failed restore preserves the snapshot for retry; released state5 is idempotent.
trusted fun P4AdcPad.closeOwned(exclusive: bool): P4AdcPad {
    val status=this.status()
    if (!exclusive || !this.hasSnapshot() || (status != 1 && status != 4 && status != 5 && status != 6)) return this
    if (status == 5) return this
    val saved=P4GpioSnapshot(this&0x7fffffffff)
    return P4AdcPad((saved|0)|((if (saved.restoreOwned(true) == 1) 5 else 6) << 40))
}
