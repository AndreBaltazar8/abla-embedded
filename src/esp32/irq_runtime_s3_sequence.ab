import "./sdk/raw_buffer.ab"
// Runtime record16 bytes: table0,faultCallback4,faultContext8,lastError12.
// All memory/callbacks remain owned and internal while IRQs are installed.
// Fault callback ABI void(u32 frame,i32 status,u32 context). It must repair
// the dispatch failure before returning, or enter the application's fatal path.
// Never return to the interrupted task with a silently ignored dispatch error.
@section(".iram1.abla.s3IrqRuntimeDispatch")
trusted fun esp32S3IrqRuntimeDispatch(frame: int,level: int,core: int,record: int): void {
    val table=nativeBufferAt(esp32S3IrqRuntimeRead(record),512)
    while (true) {
        val status=esp32S3IrqRuntimeDrain(table,core,level)
        if (status == 0) return
        esp32S3IrqRuntimeWrite(record+12,status & 0xFFFFFFFF)
        esp32S3IrqRuntimeFault(esp32S3IrqRuntimeRead(record+4),frame,status,esp32S3IrqRuntimeRead(record+8))
    }
    return
}

// Boot-time serialized setup, current core/all CPU lines disabled. Initializes
// only our16-byte record, never the user's dispatcher table. Both cores must
// serialize setup and own disjoint records/stacks; no implicit lock or enable.
@section(".iram1.abla.s3IrqRuntimeInit")
trusted fun esp32S3IrqRuntimeInitializeOwned(stack: NativeBuffer,table: NativeBuffer,record: NativeBuffer,core: int,fault: int,context: int): bool {
    if (core < 0 || core > 1 || !table.hasAddressRange(0,512) || !record.hasAddressRange(0,16) ||
        (table.addressValue() & 3) != 0 || (record.addressValue() & 3) != 0 ||
        table.addressValue() < 0x3FC88000 || table.addressValue()+512 > 0x3FD00000 ||
        record.addressValue() < 0x3FC88000 || record.addressValue()+16 > 0x3FD00000 ||
        !stack.hasAddressRange(0,1024) || fault < 0x40370000 || fault >= 0x403E0000 ||
        (fault & 3) != 0 || context < 0 || context > 0xFFFFFFFF) return false
    if (esp32S3IrqRuntimeCore() != core || esp32S3IrqRuntimeEnabled() != 0) return false
    val rec=record.addressValue()
    val tab=table.addressValue()
    val low=stack.addressValue()
    val end=low+stack.capacity()
    val cfg=esp32S3IrqRuntimeConfig()
    if ((rec < tab+512 && tab < rec+16) || (rec < end && low < rec+16) ||
        (tab < end && low < tab+512) || (rec < cfg+64 && cfg < rec+16) ||
        (tab < cfg+64 && cfg < tab+512)) return false
    val entry=cfg+core*32
    if (esp32S3IrqRuntimeRead(entry) != 0 || esp32S3IrqRuntimeRead(entry+4) != 0) return false
    val old0=esp32S3IrqRuntimeRead(rec)
    val old1=esp32S3IrqRuntimeRead(rec+4)
    val old2=esp32S3IrqRuntimeRead(rec+8)
    val old3=esp32S3IrqRuntimeRead(rec+12)
    esp32S3IrqRuntimeWrite(rec,tab)
    esp32S3IrqRuntimeWrite(rec+4,fault)
    esp32S3IrqRuntimeWrite(rec+8,context)
    esp32S3IrqRuntimeWrite(rec+12,0)
    if (esp32S3IrqRuntimeStackInit(stack,core,esp32S3IrqRuntimeAddress(),rec)) return true
    esp32S3IrqRuntimeWrite(rec,old0)
    esp32S3IrqRuntimeWrite(rec+4,old1)
    esp32S3IrqRuntimeWrite(rec+8,old2)
    esp32S3IrqRuntimeWrite(rec+12,old3)
    false
}

@section(".iram1.abla.s3IrqRuntimeRelease")
trusted fun esp32S3IrqRuntimeReleaseOwned(record: NativeBuffer,core: int): bool {
    if (core < 0 || core > 1 || !record.hasAddressRange(0,16) ||
        esp32S3IrqRuntimeCore() != core || esp32S3IrqRuntimeEnabled() != 0) return false
    val cfg=esp32S3IrqRuntimeConfig()+core*32
    if (esp32S3IrqRuntimeRead(cfg+8) != esp32S3IrqRuntimeAddress() ||
        esp32S3IrqRuntimeRead(cfg+12) != record.addressValue()) return false
    // Keep the record/error intact for inspection; stack release revokes access.
    esp32S3IrqRuntimeStackRelease(core)
}
