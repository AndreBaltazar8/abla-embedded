import "./dsi_fifo_esp32p4.ab"
import "./dsi_pll_p4_sequence.ab"
trusted fun esp32P4DsiConfigurePll(referenceKhz: int,mbps: int): DsiPhyPll =
    esp32P4DsiConfigurePllOwned(referenceKhz,mbps)
trusted fun esp32P4DsiConfigurePllKbps(referenceKhz: int,kbps: int): DsiPhyPll =
    esp32P4DsiConfigurePllKbpsOwned(referenceKhz,kbps)
