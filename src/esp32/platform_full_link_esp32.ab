import "./platform_full_esp32.ab"
import "./runtime/backend_link_esp32.ab"
import "abla/build"

// Opt-in complete classic ESP32 exception/scheduler linkage. Does not export
// a boot entry or configure an application callback. The application owns its
// linker layout and boot root. Hardware vector sections are intentional roots;
// use this profile only when providing the complete scheduler/exception graph.

// These two names occur inside the architecture-owned exception/scheduler
// instructions. Bind them to their Abla implementations with internal linkage
// so the monolithic call graph retains them only when those instructions are
// reachable. They are not firmware exports and do not appear in the public ABI.
#internalFunction(
    "esp32RecoveredFrxtDispatch",
    "_frxt_dispatch"
)
#internalFunction(
    "ownedXtensaWindowSpillNonWindowed",
    "xthal_window_spill_nw"
)
#internalFunction(
    "esp32RecoveredXtContextRestore",
    "_xt_context_restore"
)
#internalFunction(
    "esp32RecoveredXthalRestoreExtraNw",
    "xthal_restore_extra_nw"
)
#internalFunction(
    "esp32RecoveredVTaskSwitchContext",
    "vTaskSwitchContext"
)

// The CPU reaches these routines through instruction operands rather than
// ordinary LLVM calls. Retain their local ABI labels as one closed hardware
// exception/interrupt graph; none is exported from the firmware ABI.
#requiredInternalFunction("esp32RecoveredXtDebugexception", "xt_debugexception")
#requiredInternalFunction("esp32XtKernelException", "abla_esp32_xt_kernel_exc")
#requiredInternalFunction("esp32RecoveredXtPanic", "_xt_panic")
#requiredInternalFunction("esp32RecoveredPanicHandler", "panicHandler")
#requiredInternalFunction("esp32XtUserException", "abla_esp32_xt_user_exc")
#requiredInternalFunction("esp32XtHandleException", "abla_esp32_xt_handle_exc")
#requiredInternalFunction("esp32XtHandleExceptionBody", "abla_esp32_xt_handle_exception_body")
#requiredInternalFunction("esp32XtSyscallException", "abla_esp32_xt_syscall_exc")
#requiredInternalFunction("esp32XtCoprocessorException", "abla_esp32_xt_coproc_exc")
#requiredInternalFunction("esp32XtLowInterrupt1", "abla_esp32_xt_lowint1")
#requiredInternalFunction("esp32XtMediumInterrupt2", "abla_esp32_xt_medint2")
#requiredInternalFunction("esp32XtMediumInterrupt3", "abla_esp32_xt_medint3")
#requiredInternalFunction("esp32RecoveredXtContextSave", "_xt_context_save")
#requiredInternalFunction("esp32RecoveredXthalSaveExtraNw", "xthal_save_extra_nw")
#requiredInternalFunction("esp32RecoveredXtUserExit", "_xt_user_exit")
#requiredInternalFunction("esp32RecoveredXtMedint2Exit", "_xt_medint2_exit")
#requiredInternalFunction("esp32RecoveredXtMedint3Exit", "_xt_medint3_exit")
#requiredInternalFunction("esp32RecoveredXtCoprocSavecs", "_xt_coproc_savecs")
#requiredInternalFunction("esp32RecoveredXtCoprocRestorecs", "_xt_coproc_restorecs")
#requiredInternalFunction("esp32RecoveredFrxtIntEnter", "_frxt_int_enter")
#requiredInternalFunction("esp32RecoveredFrxtIntExit", "_frxt_int_exit")
#requiredInternalFunction("esp32RecoveredVPortYieldFromInt", "vPortYieldFromInt")
#requiredInternalFunction("esp32FrxtDispatchInterrupts", "abla_esp32_frxt_dispatch_interrupts")
#requiredInternalFunction("esp32RecoveredFrxtTaskCoprocState", "_frxt_task_coproc_state")
#requiredInternalFunction("esp32RecoveredFrxtCoprocExcHook", "_frxt_coproc_exc_hook")
#requiredInternalFunction("esp32RecoveredXtHighint4", "xt_highint4")
#requiredInternalFunction("esp32HighInterrupt4PanicReason", "abla_esp32_highint4_panic_reason")
#requiredInternalFunction("esp32RecoveredEspIpcIsrHandler", "esp_ipc_isr_handler")
#requiredInternalFunction("esp32IpcIsrPrepare", "abla_esp32_ipc_isr_prepare")
#requiredInternalFunction("esp32RecoveredXtHighint5", "xt_highint5")
#requiredInternalFunction("esp32RecoveredXtNmi", "xt_nmi")

// LLVM can introduce these memory/compiler-runtime calls after its final
// source-level reachability pass. Keep the matching Abla implementations as
// local symbols in this same object; none becomes part of the public ABI.
#esp32LinkOwnedBackendRuntime()

// CPU vector-table entries are implicit hardware roots. Keep their aliases
// internal while preventing whole-program DCE from removing their sections.
#requiredInternalFunction("esp32DebugExceptionVector", "_DebugExceptionVector")
#requiredInternalFunction("esp32KernelExceptionVector", "_KernelExceptionVector")
#requiredInternalFunction("esp32DoubleExceptionVector", "_DoubleExceptionVector")
#requiredInternalFunction("esp32RecoveredUserExceptionVector", "_UserExceptionVector")
#requiredInternalFunction("esp32RecoveredLevel2Vector", "_Level2Vector")
#requiredInternalFunction("esp32RecoveredLevel3Vector", "_Level3Vector")
#requiredInternalFunction("esp32RecoveredLevel4Vector", "_Level4Vector")
#requiredInternalFunction("esp32RecoveredLevel5Vector", "_Level5Vector")
#requiredInternalFunction("esp32RecoveredNMIExceptionVector", "_NMIExceptionVector")
#requiredInternalFunction("esp32WindowOverflow4", "_WindowOverflow4")
#requiredInternalFunction("esp32WindowUnderflow4", "_WindowUnderflow4")
#requiredInternalFunction("esp32WindowOverflow8", "_WindowOverflow8")
#requiredInternalFunction("esp32WindowUnderflow8", "_WindowUnderflow8")
#requiredInternalFunction("esp32WindowOverflow12", "_WindowOverflow12")
#requiredInternalFunction("esp32WindowUnderflow12", "_WindowUnderflow12")
#requiredInternalFunction("esp32RecoveredInvalidPcPlaceholder", "_invalid_pc_placeholder")
