import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "./analog_clock_c5_sequence.ab"
fun c5AnalogClockAddress(offset: int): int = if (offset == 0) 0x600af018 else if (offset == 4) 0x600a9c04 else if (offset == 8) 0x600af800 else 0x600af804
trusted fun c5AnalogClockRead(offset: int): u32 = u32(mmioLoadU32(c5AnalogClockAddress(offset)))
trusted fun c5AnalogClockWrite(offset: int,value: u32): void { mmioStoreU32(c5AnalogClockAddress(offset),int(value));return }
