import "./sdk/raw_buffer.ab"
//32byte caller-owned record, magic initially0. Exclusive pad/EXT0/RTCIO-clock
// ownership until restored. Outputs/analog/USB-OTG must be relinquished first.
// EXT0 requires RTC_PERIPH powered throughout sleep. This does not select a
// sleep trigger or cut power. Do not independently nest shared-clock owners.
trusted fun esp32S3Ext0RecordPrepareOwned(record: NativeBuffer,pin: int,level: int): bool {
    if (!record.hasAddressRange(0,32) || (record.addressValue() & 3) != 0 || pin < 0 || pin > 21 || level < 0 || level > 1) return false
    val base=record.addressValue()
    if (esp32S3RtcWakeRead(base) != 0 || (esp32S3RtcWakeRead(0x600080D8) & (1<<pin)) != 0) return false
    if ((pin == 19 || pin == 20) && (esp32S3RtcWakeRead(0x60038018) & 16384) != 0) return false
    esp32S3RtcWakeWrite(base+4,pin)
    esp32S3RtcWakeWrite(base+8,level)
    esp32S3RtcWakeWrite(base+12,esp32S3RtcWakeRead(esp32S3RtcPadAddress(pin)) & 0xE2000)
    esp32S3RtcWakeWrite(base+16,esp32S3RtcWakeRead(0x600084DC) & 0xF8000000)
    esp32S3RtcWakeWrite(base+20,esp32S3RtcWakeRead(0x60008064) & 0x40000000)
    esp32S3RtcWakeWrite(base+24,esp32S3RtcWakeRead(0x60008904) & 0x80000000)
    esp32S3RtcWakeWrite(base,0x45585430)
    if (!esp32S3PrepareExt0Owned(pin,level)) { esp32S3RtcWakeWrite(base,0); return false }
    true
}
trusted fun esp32S3Ext0RecordRestoreOwned(record: NativeBuffer): bool {
    if (!record.hasAddressRange(0,32) || (record.addressValue() & 3) != 0) return false
    val base=record.addressValue()
    if (esp32S3RtcWakeRead(base) != 0x45585430) return false
    val pin=esp32S3RtcWakeRead(base+4)
    val level=esp32S3RtcWakeRead(base+8)
    if (pin < 0 || pin > 21 || level < 0 || level > 1) return false
    val pad=esp32S3RtcPadAddress(pin)
    if ((esp32S3RtcWakeRead(0x600080D8) & (1<<pin)) != 0 ||
        (esp32S3RtcWakeRead(pad) & 0xE2000) != 0x82000 ||
        (esp32S3RtcWakeRead(0x600084DC)>>>27) != pin ||
        ((esp32S3RtcWakeRead(0x60008064)>>>30) & 1) != level) return false
    esp32S3RtcWakeUpdate(pad,0xE2000,esp32S3RtcWakeRead(base+12))
    esp32S3RtcWakeUpdate(0x600084DC,0xF8000000,esp32S3RtcWakeRead(base+16))
    esp32S3RtcWakeUpdate(0x60008064,0x40000000,esp32S3RtcWakeRead(base+20))
    esp32S3RtcWakeUpdate(0x60008904,0x80000000,esp32S3RtcWakeRead(base+24))
    esp32S3RtcWakeWrite(base,0)
    true
}
