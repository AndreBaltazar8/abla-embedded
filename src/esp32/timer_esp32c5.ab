import "abla/unsafe/mmio"
import "./timer_c5_sequence.ab"
import "../hal/esp32.ab"
@inline
@export("esp32C5TimerRead")
trusted fun esp32C5TimerReadHook(address: int): u32 = u32(mmioLoadU32(address))
@inline
@export("esp32C5TimerWrite")
trusted fun esp32C5TimerWriteHook(address: int, value: u32): void {
    mmioStoreU32(address,int(value))
    return
}
