import "./adc1_pins_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("esp32Adc1PadRead")
trusted fun esp32Adc1PadReadHook(offset: int): int = mmioLoadU32(0x3ff48400+offset)
@export("esp32Adc1PadWrite")
trusted fun esp32Adc1PadWriteHook(offset: int,value: int): void { mmioStoreU32(0x3ff48400+offset,value); return }
@export("esp32Adc1ForceHoldRead")
trusted fun esp32Adc1ForceHoldReadHook(): int = mmioLoadU32(0x3ff480c8)
@export("esp32Adc1DigitalEnableRead")
trusted fun esp32Adc1DigitalEnableReadHook(): int = mmioLoadU32(0x3ff4402c)
@export("esp32Adc1DigitalDisable")
trusted fun esp32Adc1DigitalDisableHook(mask: int): void { mmioStoreU32(0x3ff44034,mask); return }
