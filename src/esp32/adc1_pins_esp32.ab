import "./adc1_pins_sequence.ab"
import "abla/unsafe/mmio"
trusted fun esp32Adc1PadRead(offset: int): int = mmioLoadU32(0x3ff48400+offset)
trusted fun esp32Adc1PadWrite(offset: int,value: int): void { mmioStoreU32(0x3ff48400+offset,value); return }
trusted fun esp32Adc1ForceHoldRead(): int = mmioLoadU32(0x3ff480c8)
trusted fun esp32Adc1DigitalEnableRead(): int = mmioLoadU32(0x3ff4402c)
trusted fun esp32Adc1DigitalDisable(mask: int): void { mmioStoreU32(0x3ff44034,mask); return }
