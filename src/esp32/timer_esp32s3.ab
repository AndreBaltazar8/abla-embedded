import "abla/unsafe/mmio"
import "./timer_s3_sequence.ab"
import "../hal/esp32.ab"
@export("esp32S3TimerRead")
trusted fun esp32S3TimerReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("esp32S3TimerWrite")
trusted fun esp32S3TimerWriteHook(address: int, value: u32): void {
    mmioStoreU32(address,int(value))
    return
}
