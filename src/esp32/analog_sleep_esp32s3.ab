import "./analog_sleep_s3_sequence.ab"
import "abla/unsafe/native"
// ROM raw regi2c calls: caller supplies serialization, just as clock primitives.
@section(".iram1.abla.s3AnalogSleepRead")
trusted fun esp32S3AnalogSleepRead(register: int): int =
    callNativeU32I32I32I32(0x40005D48,105,1,register) & 255
@section(".iram1.abla.s3AnalogSleepWrite")
trusted fun esp32S3AnalogSleepWrite(register: int,value: int): void {
    callNativeVoidI32I32I32I32I32I32(0x40005D6C,105,1,register,7,0,value)
    return
}
