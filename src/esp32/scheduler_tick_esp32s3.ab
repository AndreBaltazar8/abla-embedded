import "./scheduler_tick_s3_sequence.ab"
import "./scheduler_run_esp32s3.ab"
// S3 core-isa.h: XCHAL_TIMER0_INTERRUPT=6, XCHAL_INT6_LEVEL=1.
@inline
trusted fun esp32S3SchedulerTickCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3SchedulerTickCount(): int = int(xtensaGuardRead("rsr.ccount $0","=r,~{memory}"))
@inline
trusted fun esp32S3SchedulerTickCompare(deadline: int): void {
    xtensaGuardWrite("wsr.ccompare0 $0\nrsync","r,~{memory}",u32(deadline)); return
}
@inline
trusted fun esp32S3SchedulerTickRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3SchedulerTickWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3SchedulerTickRequest(context: NativeBuffer): bool = esp32S3SchedulerRequestOwned(context)
@section(".iram1.abla.s3SchedulerTickCallback")
trusted fun esp32S3SchedulerTickCallback(record: u32): void {
    if (!esp32S3SchedulerTickOwned(nativeBufferAt(int(record),16))) {
        while (true) { xtensaGuardRead("rsil $0, 15\nwaiti 15","=r,~{memory}") }
    }
    return
}
@inline
trusted fun esp32S3SchedulerTickAddress(): int = nativeFunctionAddress(esp32S3SchedulerTickCallback)
