import "./task_switch_s3_sequence.ab"
import "./task_detach_esp32s3.ab"
import "./task_reattach_esp32s3.ab"
import "./irq_resume_esp32s3.ab"
@inline
trusted fun esp32S3TaskSwitchDetach(current: NativeBuffer,binding: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,core: int): bool =
    esp32S3TaskDetachOwned(current,binding,owners,frame,core)
@inline
trusted fun esp32S3TaskSwitchAttach(current: NativeBuffer,binding: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,core: int): bool =
    esp32S3TaskReattachOwned(current,binding,owners,frame,core)
@inline
trusted fun esp32S3TaskSwitchSelect(interrupted: NativeBuffer,resume: NativeBuffer,core: int,level: int): bool =
    esp32S3IrqResumeSelectOwned(interrupted,resume,core,level)
