import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverEspAesInternals(): bool {
    if (!internalFunction("esp32RecoveredEspAesCipherEncryptSetup", "esp_aes_cipher_encrypt_setup")) return false
    if (!internalFunction("esp32RecoveredEspAesCipherDecryptSetup", "esp_aes_cipher_decrypt_setup")) return false
    if (!internalFunction("esp32RecoveredEspAesCipherSetIv", "esp_aes_cipher_set_iv")) return false
    if (!internalFunction("esp32RecoveredEspAesCipherUpdate", "esp_aes_cipher_update")) return false
    if (!internalFunction("esp32RecoveredEspAesCipherFinish", "esp_aes_cipher_finish")) return false
    if (!internalFunction("esp32RecoveredEspAesCipherAbort", "esp_aes_cipher_abort")) return false
    if (!internalFunction("esp32RecoveredEspAesCipherEncrypt", "esp_aes_cipher_encrypt")) return false
    if (!internalFunction("esp32RecoveredEspAesCipherDecrypt", "esp_aes_cipher_decrypt")) return false
    true
}
