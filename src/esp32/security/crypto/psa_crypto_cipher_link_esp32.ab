import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoCipherInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsCipherValuesFromPsa", "mbedtls_cipher_values_from_psa")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherInfoFromPsa", "mbedtls_cipher_info_from_psa")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaCipherEncryptSetup", "mbedtls_psa_cipher_encrypt_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaCipherDecryptSetup", "mbedtls_psa_cipher_decrypt_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaCipherSetIv", "mbedtls_psa_cipher_set_iv")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaCipherUpdate", "mbedtls_psa_cipher_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaCipherFinish", "mbedtls_psa_cipher_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaCipherAbort", "mbedtls_psa_cipher_abort")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaCipherEncrypt", "mbedtls_psa_cipher_encrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaCipherDecrypt", "mbedtls_psa_cipher_decrypt")) return false
    true
}
