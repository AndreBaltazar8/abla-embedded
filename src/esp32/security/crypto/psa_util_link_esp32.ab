import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaUtilInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPsaGetRandom", "mbedtls_psa_get_random")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaRawToDer", "mbedtls_ecdsa_raw_to_der")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaDerToRaw", "mbedtls_ecdsa_der_to_raw")) return false
    true
}
