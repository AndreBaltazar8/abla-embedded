import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoConstantTimeInternals(): bool {
    if (!internalFunction("esp32MbedtlsConstantTimeMemcmp", "mbedtls_ct_memcmp")) return false
    if (!internalFunction("esp32MbedtlsConstantTimeMemmoveLeft", "mbedtls_ct_memmove_left")) return false
    if (!internalFunction("esp32MbedtlsConstantTimeMemcpyIf", "mbedtls_ct_memcpy_if")) return false
    if (!internalFunction("esp32MbedtlsConstantTimeMemcpyOffset", "mbedtls_ct_memcpy_offset")) return false
    if (!internalFunction("esp32MbedtlsConstantTimeZeroizeIf", "mbedtls_ct_zeroize_if")) return false
    true
}
