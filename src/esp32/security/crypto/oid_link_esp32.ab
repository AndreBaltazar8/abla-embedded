import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoOidInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsOidGetPkAlg", "mbedtls_oid_get_pk_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsOidGetOidByPkAlg", "mbedtls_oid_get_oid_by_pk_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsOidGetEcGrp", "mbedtls_oid_get_ec_grp")) return false
    if (!internalFunction("esp32RecoveredMbedtlsOidGetOidByEcGrp", "mbedtls_oid_get_oid_by_ec_grp")) return false
    if (!internalFunction("esp32RecoveredMbedtlsOidGetEcGrpAlgid", "mbedtls_oid_get_ec_grp_algid")) return false
    if (!internalFunction("esp32RecoveredMbedtlsOidGetOidByEcGrpAlgid", "mbedtls_oid_get_oid_by_ec_grp_algid")) return false
    if (!internalFunction("esp32RecoveredMbedtlsOidGetMdHmac", "mbedtls_oid_get_md_hmac")) return false
    if (!internalFunction("esp32RecoveredMbedtlsOidGetCipherAlg", "mbedtls_oid_get_cipher_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsOidGetOidByMd", "mbedtls_oid_get_oid_by_md")) return false
    true
}
