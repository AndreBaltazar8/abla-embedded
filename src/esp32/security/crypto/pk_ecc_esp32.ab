import "../../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

@inline
trusted fun esp32PkEccLoadU8(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32PkEccLoadU16(address:u32):u32 =
    u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32PkEccLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32PkEccStoreU8(address:u32, value:u32):void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32PkEccStoreU16(address:u32, value:u32):void =
    ablaUnsafeStoreU16(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32PkEccStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32PkEccImport(attributes:u32, key:u32, length:u32, keyIdOut:u32):u32 =
    esp32RecoveredPsaImportKey(
        attributes,key,length,keyIdOut,u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32PkEccDestroy(keyId:u32):u32 = esp32RecoveredPsaDestroyKey(
    keyId,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32PkEccMapStatus(status:u32):u32 =
    esp32RecoveredPsaPkStatusToMbedtls(
        status,u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32MbedtlsPkEccSetGroup(pk:u32, groupId:u32):u32 {
    val bitsOut = u32(nativeStackAllocate(4))
    val family = esp32RecoveredMbedtlsEccGroupToPsa(
        groupId,bitsOut,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    val bits = esp32PkEccLoadU32(bitsOut)
    val existingFamily = esp32PkEccLoadU8(pk + u32(548))
    val existingBits = esp32PkEccLoadU32(pk + u32(544))
    if (
        (existingFamily != u32(0) && existingFamily != family) ||
        (existingBits != u32(0) && existingBits != bits)
    ) return u32(0xffffc300)

    esp32PkEccStoreU8(pk + u32(548), family)
    esp32PkEccStoreU32(pk + u32(544), bits)
    u32(0)
}

trusted fun esp32MbedtlsPkEccSetKey(pk:u32, key:u32, keyLength:u32):u32 {
    val attributes = u32(nativeStackAllocate(24))
    freestandingSet(attributes, i32(0), u32(24))

    val family = esp32PkEccLoadU8(pk + u32(548))
    val keyType = u32(0x7100) | family
    esp32PkEccStoreU16(pk + u32(4), keyType)
    esp32PkEccStoreU16(attributes, keyType)

    if (family == u32(0x41)) {
        esp32PkEccStoreU32(attributes + u32(8), u32(0x0001))
    } else {
        esp32PkEccStoreU32(attributes + u32(12), u32(0x060007ff))
        esp32PkEccStoreU32(attributes + u32(8), u32(0x1401))
    }

    val status = esp32PkEccImport(attributes,key,keyLength,pk + u32(8))
    esp32PkEccMapStatus(status)
}

trusted fun esp32PkEccNormalizeCompressedPublicKey(
    pk:u32, publicKey:u32, publicKeyLength:u32
):u32 {
    val keypair = u32(nativeStackAllocate(176))
    val groupId = esp32RecoveredMbedtlsEccGroupFromPsa(
        esp32PkEccLoadU8(pk + u32(548)),
        esp32PkEccLoadU32(pk + u32(544)),
        u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    esp32RecoveredMbedtlsEcpKeypairInit(
        keypair,u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    var result = esp32RecoveredMbedtlsEcpGroupLoad(
        keypair,groupId,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    if (result == u32(0)) {
        result = esp32RecoveredMbedtlsEcpPointReadBinary(
            keypair,keypair + u32(104),publicKey,publicKeyLength,u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
        )
    }
    if (result == u32(0)) {
        result = esp32RecoveredMbedtlsEcpPointWriteBinary(
            keypair,keypair + u32(104),u32(0),pk + u32(540),pk + u32(12),u32(528),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
        )
    }
    esp32RecoveredMbedtlsEcpKeypairFree(
        keypair,u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    result
}

trusted fun esp32MbedtlsPkEccSetPublicKey(
    pk:u32, publicKey:u32, publicKeyLength:u32
):u32 {
    val family = esp32PkEccLoadU8(pk + u32(548))
    if ((family & u32(0xc0)) != u32(0) || esp32PkEccLoadU8(publicKey) == u32(4)) {
        if (publicKeyLength > u32(528)) return u32(0xffffff76)
        freestandingCopy(pk + u32(12), publicKey, publicKeyLength)
        esp32PkEccStoreU32(pk + u32(540), publicKeyLength)
    } else {
        val normalization = esp32PkEccNormalizeCompressedPublicKey(
            pk,publicKey,publicKeyLength
        )
        if (normalization != u32(0)) return normalization
    }

    val frame = u32(nativeStackAllocate(28))
    val attributes = frame
    val keyIdOut = frame + u32(24)
    freestandingSet(frame, i32(0), u32(28))
    val keyType = u32(0x4100) | family
    esp32PkEccStoreU16(attributes, keyType)
    val bits = esp32PkEccLoadU32(pk + u32(544))
    esp32PkEccStoreU16(
        attributes + u32(2),
        if (bits > u32(0xfff8)) u32(0xffff) else bits
    )

    val imported = esp32PkEccImport(
        attributes,pk + u32(12),esp32PkEccLoadU32(pk + u32(540)),keyIdOut
    )
    if (imported != u32(0)) return u32(0xffffc500)
    if (esp32PkEccDestroy(esp32PkEccLoadU32(keyIdOut)) != u32(0))
        return u32(0xffffc500)

    val existingType = esp32PkEccLoadU16(pk + u32(4))
    if (existingType == u32(0)) esp32PkEccStoreU16(pk + u32(4), keyType)
    else if ((existingType & u32(0xcfff)) != keyType) return u32(0xffffff79)
    u32(0)
}

// Temporary adapters for pkparse/pk while those modules remain lifted.
trusted fun esp32RecoveredMbedtlsPkEccSetGroup(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPkEccSetGroup(a2,a3)

trusted fun esp32RecoveredMbedtlsPkEccSetKey(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPkEccSetKey(a2,a3,a4)

trusted fun esp32RecoveredMbedtlsPkEccSetPubkey(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPkEccSetPublicKey(a2,a3,a4)
