import "abla/unsafe/mmio"

@inline
fun esp32ConstantTimeBoolMask(value:u32):u32 {
    val sign=((u32(0)-value)|(u32(0)-(value>>>u32(1))))>>>u32(31)
    u32(0)-sign
}

@inline
fun esp32ConstantTimeSelect(mask:u32,whenTrue:u32,whenFalse:u32):u32=
    (mask&whenTrue)|(~mask&whenFalse)

@inline
fun esp32ConstantTimeLessMask(left:u32,right:u32):u32 {
    val differentSign=esp32ConstantTimeBoolMask((left^right)>>>u32(31))
    val selected=esp32ConstantTimeSelect(differentSign,right,left-right)
    esp32ConstantTimeBoolMask(selected>>>u32(31))
}

@inline
fun esp32ConstantTimeEqualMask(left:u32,right:u32):u32=
    ~esp32ConstantTimeBoolMask(left^right)

@inline
trusted fun esp32ConstantTimeLoad(address:u32):u32=
    u32(mmioLoadU8(int(address)))

@inline
trusted fun esp32ConstantTimeStore(address:u32,value:u32):void=
    mmioStoreU8(int(address),int(value))

trusted fun esp32MbedtlsConstantTimeMemcmp(
    first:u32,second:u32,length:u32
):u32 {
    var difference=u32(0)
    var index=u32(0)
    while(index<length) {
        difference=difference|(
            esp32ConstantTimeLoad(first+index)^
            esp32ConstantTimeLoad(second+index))
        index=index+u32(1)
    }
    difference
}

trusted fun esp32MbedtlsConstantTimeMemmoveLeft(
    start:u32,total:u32,offset:u32
):void {
    if(total==u32(0)) return
    val unchangedPasses=total-offset
    var pass=u32(0)
    while(pass<total) {
        val noOp=esp32ConstantTimeLessMask(pass,unchangedPasses)
        var index=u32(0)
        while(index+u32(1)<total) {
            val current=esp32ConstantTimeLoad(start+index)
            val next=esp32ConstantTimeLoad(start+index+u32(1))
            esp32ConstantTimeStore(start+index,
                esp32ConstantTimeSelect(noOp,current,next))
            index=index+u32(1)
        }
        val last=start+total-u32(1)
        esp32ConstantTimeStore(last,esp32ConstantTimeLoad(last)&noOp)
        pass=pass+u32(1)
    }
}

trusted fun esp32MbedtlsConstantTimeMemcpyIf(
    condition:u32,destination:u32,sourceTrue:u32,
    sourceFalseValue:u32,length:u32
):void {
    val sourceFalse=if(sourceFalseValue==u32(0)) destination else sourceFalseValue
    val inverse=~condition
    var index=u32(0)
    while(index<length) {
        val selected=(esp32ConstantTimeLoad(sourceTrue+index)&condition)|
            (esp32ConstantTimeLoad(sourceFalse+index)&inverse)
        esp32ConstantTimeStore(destination+index,selected)
        index=index+u32(1)
    }
}

trusted fun esp32MbedtlsConstantTimeMemcpyOffset(
    destination:u32,source:u32,offset:u32,
    minimum:u32,maximum:u32,length:u32
):void {
    var candidate=minimum
    while(candidate<=maximum) {
        esp32MbedtlsConstantTimeMemcpyIf(
            esp32ConstantTimeEqualMask(candidate,offset),
            destination,source+candidate,u32(0),length)
        candidate=candidate+u32(1)
    }
}

trusted fun esp32MbedtlsConstantTimeZeroizeIf(
    condition:u32,buffer:u32,length:u32
):void {
    val keepMask=~condition
    var index=u32(0)
    while(index<length) {
        esp32ConstantTimeStore(buffer+index,
            esp32ConstantTimeLoad(buffer+index)&keepMask)
        index=index+u32(1)
    }
}

trusted fun esp32RecoveredMbedtlsCtMemcmp(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32MbedtlsConstantTimeMemcmp(a2,a3,a4)
trusted fun esp32RecoveredMbedtlsCtMemmoveLeft(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32MbedtlsConstantTimeMemmoveLeft(a2,a3,a4); a2 }
trusted fun esp32RecoveredMbedtlsCtMemcpyIf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32MbedtlsConstantTimeMemcpyIf(a2,a3,a4,a5,a6); a2 }
trusted fun esp32RecoveredMbedtlsCtMemcpyOffset(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32MbedtlsConstantTimeMemcpyOffset(a2,a3,a4,a5,a6,a7); a2 }
trusted fun esp32RecoveredMbedtlsCtZeroizeIf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32MbedtlsConstantTimeZeroizeIf(a2,a3,a4); a2 }
