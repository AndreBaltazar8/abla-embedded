import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoAsn1writeInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteLen", "mbedtls_asn1_write_len")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteTag", "mbedtls_asn1_write_tag")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteRawBuffer", "mbedtls_asn1_write_raw_buffer")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteNull", "mbedtls_asn1_write_null")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteOid", "mbedtls_asn1_write_oid")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteAlgorithmIdentifierExt", "mbedtls_asn1_write_algorithm_identifier_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteAlgorithmIdentifier", "mbedtls_asn1_write_algorithm_identifier")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteBool", "mbedtls_asn1_write_bool")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteInt", "mbedtls_asn1_write_int")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteEnum", "mbedtls_asn1_write_enum")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteTaggedString", "mbedtls_asn1_write_tagged_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteUtf8String", "mbedtls_asn1_write_utf8_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WritePrintableString", "mbedtls_asn1_write_printable_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteIa5String", "mbedtls_asn1_write_ia5_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteBitstring", "mbedtls_asn1_write_bitstring")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteNamedBitstring", "mbedtls_asn1_write_named_bitstring")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteOctetString", "mbedtls_asn1_write_octet_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1StoreNamedData", "mbedtls_asn1_store_named_data")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1WriteInteger", "mbedtls_asn1_write_integer")) return false
    true
}
