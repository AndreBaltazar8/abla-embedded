import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoEspBignumInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMpiMulMpiMod", "esp_mpi_mul_mpi_mod")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiExpMod", "mbedtls_mpi_exp_mod")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiMulMpi", "mbedtls_mpi_mul_mpi")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiMulInt", "mbedtls_mpi_mul_int")) return false
    true
}
