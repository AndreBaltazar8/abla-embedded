import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoEspAesGcmInternals(): bool {
    if (!internalFunction("esp32RecoveredEspAesGcmSetkey", "esp_aes_gcm_setkey")) return false
    if (!internalFunction("esp32RecoveredEspAesGcmInit", "esp_aes_gcm_init")) return false
    if (!internalFunction("esp32RecoveredEspAesGcmFree", "esp_aes_gcm_free")) return false
    if (!internalFunction("esp32RecoveredEspAesGcmStarts", "esp_aes_gcm_starts")) return false
    if (!internalFunction("esp32RecoveredEspAesGcmUpdateAd", "esp_aes_gcm_update_ad")) return false
    if (!internalFunction("esp32RecoveredEspAesGcmUpdate", "esp_aes_gcm_update")) return false
    if (!internalFunction("esp32RecoveredEspAesGcmFinish", "esp_aes_gcm_finish")) return false
    if (!internalFunction("esp32RecoveredEspAesGcmCryptAndTag", "esp_aes_gcm_crypt_and_tag")) return false
    if (!internalFunction("esp32RecoveredEspAesGcmAuthDecrypt", "esp_aes_gcm_auth_decrypt")) return false
    true
}
