import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoEcpInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsEcpCurveList", "mbedtls_ecp_curve_list")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpGrpIdList", "mbedtls_ecp_grp_id_list")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpCurveInfoFromGrpId", "mbedtls_ecp_curve_info_from_grp_id")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpCurveInfoFromTlsId", "mbedtls_ecp_curve_info_from_tls_id")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpCurveInfoFromName", "mbedtls_ecp_curve_info_from_name")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpGetType", "mbedtls_ecp_get_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpPointInit", "mbedtls_ecp_point_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpGroupInit", "mbedtls_ecp_group_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpKeypairInit", "mbedtls_ecp_keypair_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpPointFree", "mbedtls_ecp_point_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpGroupFree", "mbedtls_ecp_group_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpKeypairFree", "mbedtls_ecp_keypair_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpCopy", "mbedtls_ecp_copy")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpGroupCopy", "mbedtls_ecp_group_copy")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpSetZero", "mbedtls_ecp_set_zero")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpIsZero", "mbedtls_ecp_is_zero")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpPointCmp", "mbedtls_ecp_point_cmp")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpPointReadString", "mbedtls_ecp_point_read_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpPointWriteBinary", "mbedtls_ecp_point_write_binary")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpPointReadBinary", "mbedtls_ecp_point_read_binary")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpTlsReadPoint", "mbedtls_ecp_tls_read_point")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpTlsWritePoint", "mbedtls_ecp_tls_write_point")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpTlsReadGroupId", "mbedtls_ecp_tls_read_group_id")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpTlsReadGroup", "mbedtls_ecp_tls_read_group")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpTlsWriteGroup", "mbedtls_ecp_tls_write_group")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpCheckPubkey", "mbedtls_ecp_check_pubkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpCheckPrivkey", "mbedtls_ecp_check_privkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpMuladdRestartable", "mbedtls_ecp_muladd_restartable")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpMuladd", "mbedtls_ecp_muladd")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpMulRestartable", "mbedtls_ecp_mul_restartable")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpMul", "mbedtls_ecp_mul")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpGenPrivkey", "mbedtls_ecp_gen_privkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpGenKeypairBase", "mbedtls_ecp_gen_keypair_base")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpGenKeypair", "mbedtls_ecp_gen_keypair")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpGenKey", "mbedtls_ecp_gen_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpSetPublicKey", "mbedtls_ecp_set_public_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpReadKey", "mbedtls_ecp_read_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpWriteKeyExt", "mbedtls_ecp_write_key_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpWritePublicKey", "mbedtls_ecp_write_public_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpCheckPubPriv", "mbedtls_ecp_check_pub_priv")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpKeypairCalcPublic", "mbedtls_ecp_keypair_calc_public")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpKeypairGetGroupId", "mbedtls_ecp_keypair_get_group_id")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpExport", "mbedtls_ecp_export")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcpSelfTest", "mbedtls_ecp_self_test")) return false
