import "psa_status_esp32.ab"
import "psa_util_esp32.ab"
import "../../../runtime/freestanding_memory.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
// Reconstructed ESP-IDF PSA crypto psa_crypto_ecp member for Xtensa ESP32.

@inline
trusted fun esp32PsaEcpLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32PsaEcpStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
fun esp32PsaEcpIsPublicKey(keyType: u32): bool =
    (keyType & u32(28672)) == u32(16384)

@inline
fun esp32PsaEcpFamily(keyType: u32): u32 = keyType & u32(255)

@inline
fun esp32PsaEcpBitsAreValid(family: u32, bits: u32): bool {
    if (family == u32(18)) {
        return bits == u32(192) || bits == u32(224) ||
            bits == u32(256) || bits == u32(384) || bits == u32(521)
    }
    if (family == u32(48)) {
        return bits == u32(256) || bits == u32(384) || bits == u32(512)
    }
    if (family == u32(65)) {
        return bits == u32(255) || bits == u32(448)
    }
    if (family == u32(23)) {
        return bits == u32(192) || bits == u32(256)
    }
    return false
}

@inline
trusted fun esp32PsaEcpRelease(keypair: u32): void {
    val ignoredFree = esp32RecoveredMbedtlsEcpKeypairFree(
        keypair, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    val ignoredMemory = esp32RecoveredMbedtlsFree(
        keypair, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
}

// Structured version of mbedtls_psa_ecp_load_representation. Keeping the
// source-level branches exposes the curve/type constants to whole-program LLVM
// instead of preserving hundreds of recovered Xtensa register transitions.
// This helper has several callers; keeping one shared copy is smaller than
// cloning its allocation, curve loading, and validation paths into each one.
@noinline
trusted fun esp32RecoveredMbedtlsPsaEcpLoadRepresentation(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    val keyType = a2 & u32(65535)
    val family = esp32PsaEcpFamily(keyType)
    val publicKey = esp32PsaEcpIsPublicKey(keyType)
    var curveBits = a3
    var curveBytes = a5

    if (publicKey && family != u32(65)) {
        if ((a5 & u32(1)) == u32(0)) return u32(4294967161)
        curveBytes = a5 >> u32(1)
    }

    if (curveBits == u32(0)) {
        curveBits = curveBytes << u32(3)
    } else if (((curveBits + u32(7)) >> u32(3)) != curveBytes) {
        return u32(4294967161)
    }

    if (family == u32(18) && curveBits == u32(528)) {
        curveBits = u32(521)
    } else if (family == u32(65) && curveBits == u32(256)) {
        curveBits = u32(255)
    }
    if (!esp32PsaEcpBitsAreValid(family, curveBits)) {
        return u32(4294967161)
    }

    val keypair = esp32RecoveredMbedtlsCalloc(
        u32(1), u32(128), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (keypair == u32(0)) return u32(4294967155)

    val ignoredInit = esp32RecoveredMbedtlsEcpKeypairInit(
        keypair, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    val group = esp32RecoveredMbedtlsEccGroupFromPsa(
        family, curveBits, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (group == u32(0)) {
        esp32PsaEcpRelease(keypair)
        return u32(4294967162)
    }

    var status = u32(esp32MbedtlsToPsaError(i32(
        esp32RecoveredMbedtlsEcpGroupLoad(
            keypair, group, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    )))
    if (status != u32(0)) {
        esp32PsaEcpRelease(keypair)
        return status
    }

    if (publicKey) {
        status = u32(esp32MbedtlsToPsaError(i32(
            esp32RecoveredMbedtlsEcpPointReadBinary(
                keypair, keypair + u32(104), a4, a5, u32(0), u32(0),
                u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
                u32(0), u32(0), u32(0)
            )
        )))
        if (status == u32(0)) {
            status = u32(esp32MbedtlsToPsaError(i32(
                esp32RecoveredMbedtlsEcpCheckPubkey(
                    keypair, keypair + u32(104), u32(0), u32(0), u32(0),
                    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
                    u32(0), u32(0), u32(0), u32(0)
                )
            )))
        }
    } else {
        status = u32(esp32MbedtlsToPsaError(i32(
            esp32RecoveredMbedtlsEcpReadKey(
                esp32PsaEcpLoadU32(keypair), keypair, a4, a5, u32(0), u32(0),
                u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
                u32(0), u32(0), u32(0)
            )
        )))
    }

    if (status != u32(0)) {
        esp32PsaEcpRelease(keypair)
        return status
    }
    esp32PsaEcpStoreU32(a6, keypair)
    return u32(0)
}

// Structured version of mbedtls_psa_ecp_export_key.
@noinline
trusted fun esp32RecoveredMbedtlsPsaEcpExportKey(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    if (!esp32PsaEcpIsPublicKey(a2)) {
        return u32(esp32MbedtlsToPsaError(i32(
            esp32RecoveredMbedtlsEcpWriteKeyExt(
                a3, a6, a4, a5, u32(0), u32(0), u32(0), u32(0), u32(0),
                u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
            )
        )))
    }

    val publicPoint = a3 + u32(104)
    if (esp32RecoveredMbedtlsEcpIsZero(
        publicPoint, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    ) != u32(0)) {
        val multiplyStatus = u32(esp32MbedtlsToPsaError(i32(
            esp32RecoveredMbedtlsEcpMul(
                a3, publicPoint, a3 + u32(96), a3 + u32(28),
                u32(nativeFunctionAddress(esp32RecoveredMbedtlsPsaGetRandom)),
                u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
                u32(0), u32(0), u32(0), u32(0)
            )
        )))
        if (multiplyStatus != u32(0)) return multiplyStatus
    }

    val status = u32(esp32MbedtlsToPsaError(i32(
        esp32RecoveredMbedtlsEcpPointWriteBinary(
            a3, publicPoint, u32(0), a6, a4, a5, u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    )))
    if (status != u32(0)) {
        val ignoredClear = freestandingSet(a4, i32(0), a5)
    }
    return status
}

// Structured wrapper; the public-key type is 0x4100 plus the family byte.
trusted fun esp32RecoveredMbedtlsPsaEcpExportPublicKey(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    val keypairCell = u32(nativeStackAllocate(4))
    esp32PsaEcpStoreU32(keypairCell, u32(0))
    val keyType = u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(a2))))
    val curveBits = u32(
        ablaUnsafeLoadU16(nativePointerFromAddress(int(a2 + u32(2))))
    )
    var status = esp32RecoveredMbedtlsPsaEcpLoadRepresentation(
        keyType, curveBits, a3, a4, keypairCell, u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (status != u32(0)) return status

    val keypair = esp32PsaEcpLoadU32(keypairCell)
    status = esp32RecoveredMbedtlsPsaEcpExportKey(
        u32(16640) | esp32PsaEcpFamily(keyType), keypair, a5, a6, a7, u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0)
    )
    esp32PsaEcpRelease(keypair)
    return status
}

