import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoStorageInternals(): bool {
    if (!internalFunction("esp32RecoveredPsaIsKeyPresentInStorage", "psa_is_key_present_in_storage")) return false
    if (!internalFunction("esp32RecoveredPsaDestroyPersistentKey", "psa_destroy_persistent_key")) return false
    if (!internalFunction("esp32RecoveredPsaFormatKeyDataForStorage", "psa_format_key_data_for_storage")) return false
    if (!internalFunction("esp32RecoveredPsaParseKeyDataFromStorage", "psa_parse_key_data_from_storage")) return false
    if (!internalFunction("esp32RecoveredPsaSavePersistentKey", "psa_save_persistent_key")) return false
    if (!internalFunction("esp32RecoveredPsaFreePersistentKeyData", "psa_free_persistent_key_data")) return false
    if (!internalFunction("esp32RecoveredPsaLoadPersistentKey", "psa_load_persistent_key")) return false
    true
}
