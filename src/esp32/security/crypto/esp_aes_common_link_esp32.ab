import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoEspAesCommonInternals(): bool {
    if (!internalFunction("esp32AesValidKeyLength", "valid_key_length")) return false
    if (!internalFunction("esp32AesInit", "esp_aes_init")) return false
    if (!internalFunction("esp32AesFree", "esp_aes_free")) return false
    if (!internalFunction("esp32AesSetKey", "esp_aes_setkey")) return false
    true
}
