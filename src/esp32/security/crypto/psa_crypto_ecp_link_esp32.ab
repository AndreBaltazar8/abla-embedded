import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoEcpInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPsaEcpLoadRepresentation", "mbedtls_psa_ecp_load_representation")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaEcpExportKey", "mbedtls_psa_ecp_export_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaEcpImportKey", "mbedtls_psa_ecp_import_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaEcpExportPublicKey", "mbedtls_psa_ecp_export_public_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaEcpGenerateKey", "mbedtls_psa_ecp_generate_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaEcdsaSignHash", "mbedtls_psa_ecdsa_sign_hash")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaEcpLoadPublicPart", "mbedtls_psa_ecp_load_public_part")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaEcdsaVerifyHash", "mbedtls_psa_ecdsa_verify_hash")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaKeyAgreementEcdh", "mbedtls_psa_key_agreement_ecdh")) return false
    true
}
