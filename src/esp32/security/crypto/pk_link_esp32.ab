import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPkInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPkInit", "mbedtls_pk_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkFree", "mbedtls_pk_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkInfoFromType", "mbedtls_pk_info_from_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkSetup", "mbedtls_pk_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkSetPubkeyFromPrv", "mbedtls_pk_set_pubkey_from_prv")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkWrapPsa", "mbedtls_pk_wrap_psa")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkCanDo", "mbedtls_pk_can_do")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkGetKeyType", "mbedtls_pk_get_key_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkCopyFromPsa", "mbedtls_pk_copy_from_psa")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkCopyPublicFromPsa", "mbedtls_pk_copy_public_from_psa")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkVerifyRestartable", "mbedtls_pk_verify_restartable")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkVerify", "mbedtls_pk_verify")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkSignRestartable", "mbedtls_pk_sign_restartable")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkSign", "mbedtls_pk_sign")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkGetBitlen", "mbedtls_pk_get_bitlen")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkCheckPair", "mbedtls_pk_check_pair")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkGetType", "mbedtls_pk_get_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkCanDoExt", "mbedtls_pk_can_do_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkCanDoPsa", "mbedtls_pk_can_do_psa")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkGetPsaAttributes", "mbedtls_pk_get_psa_attributes")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkVerifyExt", "mbedtls_pk_verify_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkSignExt", "mbedtls_pk_sign_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkImportIntoPsa", "mbedtls_pk_import_into_psa")) return false
    true
}
