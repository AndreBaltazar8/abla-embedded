import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoMdInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsMdInfoFromType", "mbedtls_md_info_from_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdInit", "mbedtls_md_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdFree", "mbedtls_md_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdSetup", "mbedtls_md_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdGetSize", "mbedtls_md_get_size")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdGetType", "mbedtls_md_get_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdErrorFromPsa", "mbedtls_md_error_from_psa")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdClone", "mbedtls_md_clone")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdStarts", "mbedtls_md_starts")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdUpdate", "mbedtls_md_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdFinish", "mbedtls_md_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMd", "mbedtls_md")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdList", "mbedtls_md_list")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdHmacSetup", "mbedtls_md_hmac_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdInfoFromString", "mbedtls_md_info_from_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdGetName", "mbedtls_md_get_name")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdInfoFromCtx", "mbedtls_md_info_from_ctx")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdFile", "mbedtls_md_file")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdHmacStarts", "mbedtls_md_hmac_starts")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdHmacUpdate", "mbedtls_md_hmac_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdHmacFinish", "mbedtls_md_hmac_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdHmacReset", "mbedtls_md_hmac_reset")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMdHmac", "mbedtls_md_hmac")) return false
    true
}
