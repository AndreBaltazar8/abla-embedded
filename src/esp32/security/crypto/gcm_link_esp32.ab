import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoGcmInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsGcmInit", "mbedtls_gcm_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsGcmSetkey", "mbedtls_gcm_setkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsGcmStarts", "mbedtls_gcm_starts")) return false
    if (!internalFunction("esp32RecoveredMbedtlsGcmUpdateAd", "mbedtls_gcm_update_ad")) return false
    if (!internalFunction("esp32RecoveredMbedtlsGcmUpdate", "mbedtls_gcm_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsGcmFinish", "mbedtls_gcm_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsGcmCryptAndTag", "mbedtls_gcm_crypt_and_tag")) return false
    if (!internalFunction("esp32RecoveredMbedtlsGcmAuthDecrypt", "mbedtls_gcm_auth_decrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsGcmFree", "mbedtls_gcm_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsGcmSelfTest", "mbedtls_gcm_self_test")) return false
    true
}
