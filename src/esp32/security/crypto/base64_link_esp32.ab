import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoBase64Internals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsBase64Encode", "mbedtls_base64_encode")) return false
    if (!internalFunction("esp32RecoveredMbedtlsBase64Decode", "mbedtls_base64_decode")) return false
    if (!internalFunction("esp32RecoveredMbedtlsBase64SelfTest", "mbedtls_base64_self_test")) return false
    true
}
