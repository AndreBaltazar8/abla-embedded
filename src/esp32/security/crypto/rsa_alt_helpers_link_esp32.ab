import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoRsaAltHelpersInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsRsaDeducePrivateExponent", "mbedtls_rsa_deduce_private_exponent")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaDeduceCrt", "mbedtls_rsa_deduce_crt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaValidateParams", "mbedtls_rsa_validate_params")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaValidateCrt", "mbedtls_rsa_validate_crt")) return false
    true
}
