import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoXofInternals(): bool {
    if (!internalFunction("esp32MbedtlsPsaXofAbort", "mbedtls_psa_xof_abort")) return false
    if (!internalFunction("esp32MbedtlsPsaXofSetup", "mbedtls_psa_xof_setup")) return false
    if (!internalFunction("esp32MbedtlsPsaXofSetContext", "mbedtls_psa_xof_set_context")) return false
    if (!internalFunction("esp32MbedtlsPsaXofUpdate", "mbedtls_psa_xof_update")) return false
    if (!internalFunction("esp32MbedtlsPsaXofOutput", "mbedtls_psa_xof_output")) return false
    true
}
