import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoAesInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsAesInit", "mbedtls_aes_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesFree", "mbedtls_aes_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesGetImplementation", "mbedtls_aes_get_implementation")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesXtsInit", "mbedtls_aes_xts_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesXtsFree", "mbedtls_aes_xts_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesSetkeyEnc", "mbedtls_aes_setkey_enc")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesSetkeyDec", "mbedtls_aes_setkey_dec")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesXtsSetkeyEnc", "mbedtls_aes_xts_setkey_enc")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesXtsSetkeyDec", "mbedtls_aes_xts_setkey_dec")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesCryptEcb", "mbedtls_aes_crypt_ecb")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesCryptCbc", "mbedtls_aes_crypt_cbc")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesCryptXts", "mbedtls_aes_crypt_xts")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesCryptCfb128", "mbedtls_aes_crypt_cfb128")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesCryptCfb8", "mbedtls_aes_crypt_cfb8")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesCryptOfb", "mbedtls_aes_crypt_ofb")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesCryptCtr", "mbedtls_aes_crypt_ctr")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesSelfTest", "mbedtls_aes_self_test")) return false
    true
}
