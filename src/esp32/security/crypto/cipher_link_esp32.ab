import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoCipherInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsCipherList", "mbedtls_cipher_list")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherInfoFromType", "mbedtls_cipher_info_from_type")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherInfoFromString", "mbedtls_cipher_info_from_string")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherInfoFromValues", "mbedtls_cipher_info_from_values")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherInit", "mbedtls_cipher_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherFree", "mbedtls_cipher_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherSetup", "mbedtls_cipher_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherSetkey", "mbedtls_cipher_setkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherSetIv", "mbedtls_cipher_set_iv")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherReset", "mbedtls_cipher_reset")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherUpdateAd", "mbedtls_cipher_update_ad")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherUpdate", "mbedtls_cipher_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherFinishPadded", "mbedtls_cipher_finish_padded")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherFinish", "mbedtls_cipher_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherSetPaddingMode", "mbedtls_cipher_set_padding_mode")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherWriteTag", "mbedtls_cipher_write_tag")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherCheckTag", "mbedtls_cipher_check_tag")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherCrypt", "mbedtls_cipher_crypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherAuthEncryptExt", "mbedtls_cipher_auth_encrypt_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherAuthDecryptExt", "mbedtls_cipher_auth_decrypt_ext")) return false
    true
}
