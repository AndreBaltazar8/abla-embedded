// Original ABI symbol: mbedtls_aes_self_test
trusted fun esp32RecoveredMbedtlsAesSelfTest(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    val frame = u32(nativeStackAllocate(112))
    val context = frame
    val key = frame + u32(36)
    val plain = frame + u32(52)
    val output = frame + u32(68)
    val expected = frame + u32(84)
    var index = u32(0)
    while (index < u32(16)) {
        esp32MbedtlsAesStoreByte(key + index, index)
        esp32MbedtlsAesStoreByte(plain + index, index * u32(17))
        index = index + u32(1)
    }
    ablaUnsafeStoreU32(nativePointerFromAddress(int(expected)), int(u32(3638609001)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(expected + u32(4))), int(u32(805600106)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(expected + u32(8))), int(u32(2159529432)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(expected + u32(12))), int(u32(1522906224)))
    esp32AesInit(context)
    var status = esp32AesSetKey(context, key, u32(128))
    if (status == u32(0)) {
        status = esp32MbedtlsAesEcb(context, u32(1), plain, output)
    }
    index = u32(0)
    while (status == u32(0) && index < u32(16)) {
        if (esp32MbedtlsAesByte(output + index) !=
            esp32MbedtlsAesByte(expected + index)) {
            status = u32(1)
        }
        index = index + u32(1)
    }
    freestandingSecureZero(frame, u32(112))
    status
}
