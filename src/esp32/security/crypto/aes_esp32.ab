import "../../../runtime/freestanding_memory.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

// Mbed TLS AES compatibility implemented directly over the classic ESP32 AES
// peripheral. A context now keeps only the raw key rather than a 280-byte
// expanded software schedule, so no forward or reverse lookup tables remain.
val esp32MbedtlsAesContextStride = u32(280)
val esp32MbedtlsAesBadInput = u32(4294967161)
val esp32MbedtlsAesInvalidLength = u32(4294967262)

@inline
trusted fun esp32MbedtlsAesByte(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32MbedtlsAesStoreByte(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32MbedtlsAesEcb(
    context: u32, mode: u32, input: u32, output: u32
): u32 {
    if (mode > u32(1)) return esp32MbedtlsAesBadInput
    esp32RecoveredEspAesCryptEcb(
        context, mode, input, output, u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0)
    )
}

trusted fun esp32MbedtlsXorBlock(
    left: u32, right: u32, output: u32
): void {
    var index = u32(0)
    while (index < u32(16)) {
        esp32MbedtlsAesStoreByte(
            output + index,
            esp32MbedtlsAesByte(left + index) ^
                esp32MbedtlsAesByte(right + index)
        )
        index = index + u32(1)
    }
}

// XTS uses the IEEE 1619 little-endian GF(2^128) convention.
trusted fun esp32MbedtlsXtsMultiplyX(tweak: u32): void {
    var carry = u32(0)
    var index = u32(0)
    while (index < u32(16)) {
        val value = esp32MbedtlsAesByte(tweak + index)
        esp32MbedtlsAesStoreByte(
            tweak + index, ((value << u32(1)) & u32(255)) | carry
        )
        carry = value >>> u32(7)
        index = index + u32(1)
    }
    if (carry != u32(0)) {
        esp32MbedtlsAesStoreByte(
            tweak, esp32MbedtlsAesByte(tweak) ^ u32(135)
        )
    }
}

trusted fun esp32MbedtlsXtsBlock(
    context: u32,
    mode: u32,
    tweak: u32,
    input: u32,
    output: u32,
    temporary: u32
): u32 {
    esp32MbedtlsXorBlock(input, tweak, temporary)
    val status = esp32MbedtlsAesEcb(context, mode, temporary, temporary)
    if (status != u32(0)) return status
    esp32MbedtlsXorBlock(temporary, tweak, output)
    u32(0)
}

// Original ABI symbol: mbedtls_aes_init
trusted fun esp32RecoveredMbedtlsAesInit(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    esp32AesInit(a2)
    a2
}

// Original ABI symbol: mbedtls_aes_free
trusted fun esp32RecoveredMbedtlsAesFree(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    esp32AesFree(a2)
    a2
}

// Original ABI symbol: mbedtls_aes_get_implementation
trusted fun esp32RecoveredMbedtlsAesGetImplementation(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = u32(0)

// Original ABI symbol: mbedtls_aes_xts_init
trusted fun esp32RecoveredMbedtlsAesXtsInit(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    esp32AesInit(a2)
    esp32AesInit(a2 + esp32MbedtlsAesContextStride)
    a2
}

// Original ABI symbol: mbedtls_aes_xts_free
trusted fun esp32RecoveredMbedtlsAesXtsFree(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    if (a2 != u32(0)) {
        esp32AesFree(a2)
        esp32AesFree(a2 + esp32MbedtlsAesContextStride)
    }
    a2
}

// Encryption and decryption contexts share the raw-key form. Direction is
// selected when the peripheral starts each block.
trusted fun esp32RecoveredMbedtlsAesSetkeyEnc(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32AesSetKey(a2, a3, a4)

trusted fun esp32RecoveredMbedtlsAesSetkeyDec(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32AesSetKey(a2, a3, a4)

trusted fun esp32MbedtlsAesXtsSetKey(
    context: u32, key: u32, keyBits: u32
): u32 {
    if (keyBits != u32(256) && keyBits != u32(512)) {
        return esp32AesBadInput
    }
    val halfBits = keyBits >>> u32(1)
    val halfBytes = keyBits >>> u32(4)
    val tweakStatus = esp32AesSetKey(
        context + esp32MbedtlsAesContextStride,
        key + halfBytes,
        halfBits
    )
    if (tweakStatus != u32(0)) return tweakStatus
    esp32AesSetKey(context, key, halfBits)
}

trusted fun esp32RecoveredMbedtlsAesXtsSetkeyEnc(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsAesXtsSetKey(a2, a3, a4)

trusted fun esp32RecoveredMbedtlsAesXtsSetkeyDec(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsAesXtsSetKey(a2, a3, a4)

// Original ABI symbol: mbedtls_aes_crypt_ecb
trusted fun esp32RecoveredMbedtlsAesCryptEcb(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsAesEcb(a2, a3, a4, a5)

// Original ABI symbol: mbedtls_aes_crypt_cbc
trusted fun esp32RecoveredMbedtlsAesCryptCbc(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    if (a3 > u32(1)) return esp32MbedtlsAesBadInput
    if ((a4 & u32(15)) != u32(0)) return esp32MbedtlsAesInvalidLength
    if (a4 == u32(0)) return u32(0)
    esp32RecoveredEspAesCryptCbc(
        a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9
    )
}

// Original ABI symbol: mbedtls_aes_crypt_xts
trusted fun esp32RecoveredMbedtlsAesCryptXts(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    if (a3 > u32(1) || a4 < u32(16) || a4 > u32(1048576)) {
        return esp32MbedtlsAesBadInput
    }
    val frame = u32(nativeStackAllocate(80))
    val tweak = frame
    val nextTweak = frame + u32(16)
    val temporary = frame + u32(32)
    val stolen = frame + u32(48)
    var status = esp32MbedtlsAesEcb(
        a2 + esp32MbedtlsAesContextStride, u32(1), a5, tweak
    )
    if (status != u32(0)) return status
    val completeBlocks = a4 >>> u32(4)
    val remainder = a4 & u32(15)
    val ordinaryBlocks = if (remainder == u32(0)) completeBlocks
        else completeBlocks - u32(1)
    var block = u32(0)
    while (block < ordinaryBlocks) {
        val offset = block << u32(4)
        status = esp32MbedtlsXtsBlock(
            a2, a3, tweak, a6 + offset, a7 + offset, temporary
        )
        if (status != u32(0)) return status
        esp32MbedtlsXtsMultiplyX(tweak)
        block = block + u32(1)
    }
    if (remainder == u32(0)) return u32(0)
    val lastOffset = ordinaryBlocks << u32(4)
    val partialOffset = lastOffset + u32(16)
    freestandingCopy(nextTweak, tweak, u32(16))
    esp32MbedtlsXtsMultiplyX(nextTweak)
    if (a3 != u32(0)) {
        status = esp32MbedtlsXtsBlock(
            a2, u32(1), tweak, a6 + lastOffset, stolen, temporary
        )
        if (status != u32(0)) return status
        freestandingCopy(a7 + partialOffset, stolen, remainder)
        freestandingCopy(temporary, a6 + partialOffset, remainder)
        freestandingCopy(
            temporary + remainder, stolen + remainder,
            u32(16) - remainder
        )
        status = esp32MbedtlsXtsBlock(
            a2, u32(1), nextTweak, temporary,
            a7 + lastOffset, stolen
        )
    } else {
        status = esp32MbedtlsXtsBlock(
            a2, u32(0), nextTweak, a6 + lastOffset,
            temporary, stolen
        )
        if (status != u32(0)) return status
        freestandingCopy(a7 + partialOffset, temporary, remainder)
        freestandingCopy(stolen, a6 + partialOffset, remainder)
        freestandingCopy(
            stolen + remainder, temporary + remainder,
            u32(16) - remainder
        )
        status = esp32MbedtlsXtsBlock(
            a2, u32(0), tweak, stolen,
            a7 + lastOffset, temporary
        )
    }
    freestandingSecureZero(frame, u32(80))
    status
}

// Original ABI symbol: mbedtls_aes_crypt_cfb128
trusted fun esp32RecoveredMbedtlsAesCryptCfb128(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    if (a3 > u32(1)) return esp32MbedtlsAesBadInput
    esp32RecoveredEspAesCryptCfb128(
        a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9
    )
}

