import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoSha256Internals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsSha256Init", "mbedtls_sha256_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha256Free", "mbedtls_sha256_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha256Clone", "mbedtls_sha256_clone")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha256Starts", "mbedtls_sha256_starts")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha256Update", "mbedtls_sha256_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha256Finish", "mbedtls_sha256_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha256", "mbedtls_sha256")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha256SelfTest", "mbedtls_sha256_self_test")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha224SelfTest", "mbedtls_sha224_self_test")) return false
    true
}
