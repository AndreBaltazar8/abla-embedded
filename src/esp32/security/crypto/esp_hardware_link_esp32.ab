import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoEspHardwareInternals(): bool {
    if (!internalFunction("esp32MbedtlsHardwarePoll", "mbedtls_hardware_poll")) return false
    if (!internalFunction("esp32MbedtlsPsaExternalGetRandom", "mbedtls_psa_external_get_random")) return false
    true
}
