import "psa_crypto_esp32.ab"
import "abla/unsafe/memory"

val esp32PsaErrorNotSupported = u32(0xffffff79)
val esp32PsaErrorDoesNotExist = u32(0xffffff74)

trusted fun esp32PsaDriverWrapperGetKeyBufferSize(
    attributes: u32, sizeOutput: u32
): u32 {
    ablaUnsafeStoreU32(nativePointerFromAddress(int(sizeOutput)), int(u32(0)))
    esp32PsaErrorNotSupported
}

trusted fun esp32PsaDriverWrapperExportPublicKey(
    attributes:u32,keyBuffer:u32,keyBufferSize:u32,
    data:u32,dataSize:u32,dataLength:u32
):u32 {
    val lifetime = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(attributes + u32(4)))))
    if ((lifetime >>> u32(8)) != u32(0)) return esp32PsaErrorNotSupported
    esp32RecoveredPsaExportPublicKeyInternal(
        attributes,keyBuffer,keyBufferSize,data,dataSize,dataLength,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
}

trusted fun esp32PsaDriverWrapperGetBuiltinKey(
    slot:u32,attributes:u32,keyBuffer:u32,keyBufferSize:u32,keyLength:u32
):u32=esp32PsaErrorDoesNotExist

trusted fun esp32RecoveredPsaDriverWrapperGetKeyBufferSize(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32PsaDriverWrapperGetKeyBufferSize(a2,a3)
trusted fun esp32RecoveredPsaDriverWrapperExportPublicKey(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32PsaDriverWrapperExportPublicKey(a2,a3,a4,a5,a6,a7)
trusted fun esp32RecoveredPsaDriverWrapperGetBuiltinKey(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32PsaDriverWrapperGetBuiltinKey(a2,a3,a4,a5,a6)
