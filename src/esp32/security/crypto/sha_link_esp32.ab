import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoShaInternals(): bool {
    if (!internalFunction("esp32RecoveredEspShaLockMemoryBlock", "esp_sha_lock_memory_block")) return false
    if (!internalFunction("esp32RecoveredEspShaUnlockMemoryBlock", "esp_sha_unlock_memory_block")) return false
    if (!internalFunction("esp32RecoveredEspShaTryLockEngine", "esp_sha_try_lock_engine")) return false
    if (!internalFunction("esp32RecoveredEspShaLockEngine", "esp_sha_lock_engine")) return false
    if (!internalFunction("esp32RecoveredEspShaUnlockEngine", "esp_sha_unlock_engine")) return false
    if (!internalFunction("esp32RecoveredEspShaReadDigestState", "esp_sha_read_digest_state")) return false
    if (!internalFunction("esp32RecoveredEspShaSetMode", "esp_sha_set_mode")) return false
    if (!internalFunction("esp32RecoveredEspShaBlock", "esp_sha_block")) return false
    true
}
