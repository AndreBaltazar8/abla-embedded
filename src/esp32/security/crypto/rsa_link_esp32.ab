import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoRsaInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsRsaWriteKey", "mbedtls_rsa_write_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaWritePubkey", "mbedtls_rsa_write_pubkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaInit", "mbedtls_rsa_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaSetPadding", "mbedtls_rsa_set_padding")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaGetPaddingMode", "mbedtls_rsa_get_padding_mode")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaGetMdAlg", "mbedtls_rsa_get_md_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaGetBitlen", "mbedtls_rsa_get_bitlen")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaGetLen", "mbedtls_rsa_get_len")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaCheckPubkey", "mbedtls_rsa_check_pubkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaParsePubkey", "mbedtls_rsa_parse_pubkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaCheckPrivkey", "mbedtls_rsa_check_privkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaCheckPubPriv", "mbedtls_rsa_check_pub_priv")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaPublic", "mbedtls_rsa_public")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaPrivate", "mbedtls_rsa_private")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaRsaesOaepEncrypt", "mbedtls_rsa_rsaes_oaep_encrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaRsaesPkcs1V15Encrypt", "mbedtls_rsa_rsaes_pkcs1_v15_encrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaPkcs1Encrypt", "mbedtls_rsa_pkcs1_encrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaRsaesOaepDecrypt", "mbedtls_rsa_rsaes_oaep_decrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaRsaesPkcs1V15Decrypt", "mbedtls_rsa_rsaes_pkcs1_v15_decrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaPkcs1Decrypt", "mbedtls_rsa_pkcs1_decrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaRsassaPssSignNoModeCheck", "mbedtls_rsa_rsassa_pss_sign_no_mode_check")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaRsassaPssSignExt", "mbedtls_rsa_rsassa_pss_sign_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaRsassaPkcs1V15Sign", "mbedtls_rsa_rsassa_pkcs1_v15_sign")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaPkcs1Sign", "mbedtls_rsa_pkcs1_sign")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaRsassaPssVerifyExt", "mbedtls_rsa_rsassa_pss_verify_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaRsassaPkcs1V15Verify", "mbedtls_rsa_rsassa_pkcs1_v15_verify")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaPkcs1Verify", "mbedtls_rsa_pkcs1_verify")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaFree", "mbedtls_rsa_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaParseKey", "mbedtls_rsa_parse_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaGenKey", "mbedtls_rsa_gen_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaCopy", "mbedtls_rsa_copy")) return false
    if (!internalFunction("esp32RecoveredMbedtlsRsaSelfTest", "mbedtls_rsa_self_test")) return false
    true
}
