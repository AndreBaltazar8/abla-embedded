import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoClientInternals(): bool {
    if (!internalFunction("esp32RecoveredPsaResetKeyAttributes", "psa_reset_key_attributes")) return false
    true
}
