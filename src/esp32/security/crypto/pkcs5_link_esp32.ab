import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPkcs5Internals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPkcs5Pbkdf2HmacExt", "mbedtls_pkcs5_pbkdf2_hmac_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkcs5Pbes2Ext", "mbedtls_pkcs5_pbes2_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkcs5SelfTest", "mbedtls_pkcs5_self_test")) return false
    true
}
