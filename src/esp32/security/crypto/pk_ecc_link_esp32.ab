import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPkEccInternals(): bool {
    if (!internalFunction("esp32MbedtlsPkEccSetGroup", "mbedtls_pk_ecc_set_group")) return false
    if (!internalFunction("esp32MbedtlsPkEccSetKey", "mbedtls_pk_ecc_set_key")) return false
    if (!internalFunction("esp32MbedtlsPkEccSetPublicKey", "mbedtls_pk_ecc_set_pubkey")) return false
    true
}
