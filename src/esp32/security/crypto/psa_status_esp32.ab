import "abla/unsafe/memory"
import "abla/unsafe/native"

// Typed PSA status helpers for the ESP-IDF 6.0.2 configuration used by the
// classic ESP32 firmware. These are ordinary Abla so LLVM can inline and prune
// them together with every caller in the monolithic firmware module.

var esp32PsaInterruptibleMaximumOperations = u32(4294967295)

fun esp32PsaCanDoHash(hashAlgorithm: u32): i32 = 1

fun esp32PsaInterruptibleSetMaximumOperations(maximum: u32): void {
    esp32PsaInterruptibleMaximumOperations = maximum
    return
}

fun esp32PsaInterruptibleGetMaximumOperations(): u32 =
    esp32PsaInterruptibleMaximumOperations

trusted fun esp32PsaInterruptibleOperationCount(operation: u32): u32 =
    ablaUnsafeLoadU32(nativePointerFromAddress(int(operation) + 12))

fun esp32MbedtlsPsaInterruptibleSetMaximumOperations(maximum: u32): void {
    return
}

fun esp32MbedtlsPsaInterruptibleOperationCount(operation: u32): u32 = u32(0)

fun esp32MbedtlsPsaInterruptibleUnsupported(
    operation: u32,
    output: u32,
    outputSize: u32,
    outputLength: u32
): i32 = -134

fun esp32MbedtlsPsaInterruptibleAbort(operation: u32): i32 = -134

fun esp32MbedtlsToPsaError(ret: i32): i32 {
    // Legacy Mbed TLS codes in this interval are already PSA status values.
    if (ret > i32(-4096) && ret < i32(-128)) return ret

    // Combined errors contain a high-level code and a seven-bit low-level
    // root cause. Match the low-level cause first, exactly like Mbed TLS.
    val lowLevel = -((-ret) & i32(127))
    val error = if (lowLevel != 0) lowLevel else ret

    if (error == 0) return 0
    if (error == -32 || error == -34 || error == -24704 || error == -20608 ||
        error == -15488 || error == -14976 || error == -14848 ||
        error == -14720) return -134
    if (error == -96 || error == -98 || error == -100 || error == -102 || error == -104 ||
        error == -25216 || error == -6 || error == -10 || error == -12 || error == -14 ||
        error == -16128 || error == -15744 || error == -15616 || error == -15104 ||
        error == -16896 || error == -19584) return -135
    if (error == -25472 || error == -17024 || error == -17152) return -151
    if (error == -64 || error == -61 || error == -17536) return -148
    if (error == -20992 || error == -2 || error == -15872) return -146
    if (error == -15360 || error == -15232) return -133
    if (error == -16768) return -147
    return -132
}

// Exact enabled key categories for the same ESP-IDF configuration. The raw
// ABI values are kept register-sized; masking reproduces psa_key_type_t.
fun esp32PsaValidateUnstructuredKeyBitSize(rawType: i32, bits: i32): i32 {
    val keyType = rawType & i32(65535)
    val unrestricted = keyType == i32(4097) || keyType == i32(4352) ||
        keyType == i32(4608) || keyType == i32(4611) || keyType == i32(4613)
    if (!unrestricted) {
        if (keyType != i32(9216)) return -134
        if (bits != i32(128) && bits != i32(192) && bits != i32(256)) return -135
    }
    return if ((bits & i32(7)) == 0) i32(0) else i32(-135)
}
