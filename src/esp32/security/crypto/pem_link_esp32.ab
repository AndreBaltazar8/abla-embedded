import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPemInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPemInit", "mbedtls_pem_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPemReadBuffer", "mbedtls_pem_read_buffer")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPemFree", "mbedtls_pem_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPemWriteBuffer", "mbedtls_pem_write_buffer")) return false
    true
}
