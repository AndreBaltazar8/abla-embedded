import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPkparseInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPkParseSubpubkey", "mbedtls_pk_parse_subpubkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkParseKey", "mbedtls_pk_parse_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkParsePublicKey", "mbedtls_pk_parse_public_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkLoadFile", "mbedtls_pk_load_file")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkParseKeyfile", "mbedtls_pk_parse_keyfile")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPkParsePublicKeyfile", "mbedtls_pk_parse_public_keyfile")) return false
    true
}
