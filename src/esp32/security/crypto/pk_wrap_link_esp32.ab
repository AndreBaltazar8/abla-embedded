import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPkWrapInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPkPsaRsaSignExt", "mbedtls_pk_psa_rsa_sign_ext")) return false
    true
}
