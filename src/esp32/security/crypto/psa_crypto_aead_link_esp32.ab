import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoAeadInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadEncryptSetup", "mbedtls_psa_aead_encrypt_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadDecryptSetup", "mbedtls_psa_aead_decrypt_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadSetNonce", "mbedtls_psa_aead_set_nonce")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadSetLengths", "mbedtls_psa_aead_set_lengths")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadUpdateAd", "mbedtls_psa_aead_update_ad")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadUpdate", "mbedtls_psa_aead_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadFinish", "mbedtls_psa_aead_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadAbort", "mbedtls_psa_aead_abort")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadEncrypt", "mbedtls_psa_aead_encrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAeadDecrypt", "mbedtls_psa_aead_decrypt")) return false
    true
}
