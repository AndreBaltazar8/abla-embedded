import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverEspSha1Internals(): bool {
    if (!internalFunction("esp32RecoveredEspSha1DriverClone", "esp_sha1_driver_clone")) return false
    if (!internalFunction("esp32RecoveredEspSha1Starts", "esp_sha1_starts")) return false
    if (!internalFunction("esp32RecoveredEspInternalSha1Process", "esp_internal_sha1_process")) return false
    if (!internalFunction("esp32RecoveredEspSha1Update", "esp_sha1_update")) return false
    if (!internalFunction("esp32RecoveredEspSha1Finish", "esp_sha1_finish")) return false
    if (!internalFunction("esp32RecoveredEspSha1DriverUpdate", "esp_sha1_driver_update")) return false
    if (!internalFunction("esp32RecoveredEspSha1DriverFinish", "esp_sha1_driver_finish")) return false
    if (!internalFunction("esp32RecoveredEspSha1DriverCompute", "esp_sha1_driver_compute")) return false
    if (!internalFunction("esp32RecoveredEspSha1DriverAbort", "esp_sha1_driver_abort")) return false
    true
}
