import "../../../runtime/freestanding_memory.ab"
import "platform_esp32.ab"

// Mbed TLS clearing helpers expressed directly in Abla. Secure zero uses the
// runtime primitive whose write cannot be discarded as a dead ordinary store.

trusted fun esp32MbedtlsPlatformZeroize(address: u32, length: u32): void {
    if (address != u32(0) && length != u32(0)) {
        freestandingSecureZero(address, length)
    }
}

trusted fun esp32MbedtlsZeroizeAndFree(address: u32, length: u32): void {
    if (address != u32(0)) {
        esp32MbedtlsPlatformZeroize(address, length)
        esp32RecoveredMbedtlsFree(address,
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    }
}

trusted fun esp32RecoveredMbedtlsPlatformZeroize(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32MbedtlsPlatformZeroize(a2, a3); a2 }

trusted fun esp32RecoveredMbedtlsZeroizeAndFree(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32MbedtlsZeroizeAndFree(a2, a3); a2 }
