import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverEspHmacTransparentInternals(): bool {
    if (!internalFunction("esp32RecoveredEspHmacAbortTransparent", "esp_hmac_abort_transparent")) return false
    if (!internalFunction("esp32RecoveredEspHmacSetupTransparent", "esp_hmac_setup_transparent")) return false
    if (!internalFunction("esp32RecoveredEspHmacUpdateTransparent", "esp_hmac_update_transparent")) return false
    if (!internalFunction("esp32RecoveredEspHmacFinishTransparent", "esp_hmac_finish_transparent")) return false
    if (!internalFunction("esp32RecoveredEspHmacComputeTransparent", "esp_hmac_compute_transparent")) return false
    if (!internalFunction("esp32RecoveredEspHmacVerifyFinishTransparent", "esp_hmac_verify_finish_transparent")) return false
    true
}
