import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoEcdsaInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaCanDo", "mbedtls_ecdsa_can_do")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaSignRestartable", "mbedtls_ecdsa_sign_restartable")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaSign", "mbedtls_ecdsa_sign")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaSignDetRestartable", "mbedtls_ecdsa_sign_det_restartable")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaSignDetExt", "mbedtls_ecdsa_sign_det_ext")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaVerifyRestartable", "mbedtls_ecdsa_verify_restartable")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaVerify", "mbedtls_ecdsa_verify")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaWriteSignatureRestartable", "mbedtls_ecdsa_write_signature_restartable")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaWriteSignature", "mbedtls_ecdsa_write_signature")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaReadSignatureRestartable", "mbedtls_ecdsa_read_signature_restartable")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaReadSignature", "mbedtls_ecdsa_read_signature")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaGenkey", "mbedtls_ecdsa_genkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaInit", "mbedtls_ecdsa_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaFree", "mbedtls_ecdsa_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEcdsaFromKeypair", "mbedtls_ecdsa_from_keypair")) return false
    true
}
