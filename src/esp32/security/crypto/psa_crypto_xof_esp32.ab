import "abla/unsafe/memory"

@inline
trusted fun esp32PsaXofAlgorithm(operation:u32):u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(operation)))
)

@inline
trusted fun esp32PsaXofSetAlgorithm(operation:u32, algorithm:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(operation)), int(algorithm))

trusted fun esp32PsaXofIsShake(algorithm:u32):bool =
    algorithm == u32(0x0d000100) || algorithm == u32(0x0d000200)

trusted fun esp32MbedtlsPsaXofAbort(operation:u32):u32 {
    val algorithm = esp32PsaXofAlgorithm(operation)
    if (esp32PsaXofIsShake(algorithm)) {
        esp32RecoveredMbedtlsSha3Free(
            operation + u32(8),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
        )
    } else if (algorithm != u32(0)) return u32(0xffffff77)

    esp32PsaXofSetAlgorithm(operation,u32(0))
    u32(0)
}

trusted fun esp32MbedtlsPsaXofSetup(operation:u32, algorithm:u32):u32 {
    if (esp32PsaXofAlgorithm(operation) != u32(0)) return u32(0xffffff77)

    var mode = u32(0)
    if (algorithm == u32(0x0d000100)) mode = u32(5)
    else if (algorithm == u32(0x0d000200)) mode = u32(6)
    else {
        return if ((algorithm & u32(0x7f000000)) == u32(0x0d000000))
            u32(0xffffff7a) else u32(0xffffff79)
    }

    esp32RecoveredMbedtlsSha3Starts(
        operation + u32(8),mode,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    esp32PsaXofSetAlgorithm(operation,algorithm)
    u32(0)
}

trusted fun esp32MbedtlsPsaXofSetContext(
    operation:u32, context:u32, contextLength:u32
):u32 = if (esp32PsaXofAlgorithm(operation) == u32(0))
    u32(0xffffff77) else u32(0xffffff79)

trusted fun esp32MbedtlsPsaXofUpdate(
    operation:u32, input:u32, inputLength:u32
):u32 {
    if (!esp32PsaXofIsShake(esp32PsaXofAlgorithm(operation)))
        return u32(0xffffff77)
    esp32RecoveredMbedtlsSha3Update(
        operation + u32(8),input,inputLength,u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    u32(0)
}

trusted fun esp32MbedtlsPsaXofOutput(
    operation:u32, output:u32, outputLength:u32
):u32 {
    if (!esp32PsaXofIsShake(esp32PsaXofAlgorithm(operation)))
        return u32(0xffffff77)
    esp32RecoveredMbedtlsSha3Finish(
        operation + u32(8),output,outputLength,u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    u32(0)
}

// Temporary adapters for the still-lifted PSA orchestration module.
trusted fun esp32RecoveredMbedtlsPsaXofAbort(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPsaXofAbort(a2)

trusted fun esp32RecoveredMbedtlsPsaXofSetup(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPsaXofSetup(a2,a3)

trusted fun esp32RecoveredMbedtlsPsaXofSetContext(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPsaXofSetContext(a2,a3,a4)

trusted fun esp32RecoveredMbedtlsPsaXofUpdate(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPsaXofUpdate(a2,a3,a4)

trusted fun esp32RecoveredMbedtlsPsaXofOutput(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPsaXofOutput(a2,a3,a4)
