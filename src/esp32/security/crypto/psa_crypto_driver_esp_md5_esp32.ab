import "../../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"

// Structured Abla implementation of the ESP PSA MD5 driver.
val esp32PsaSuccess = u32(0)
val esp32PsaErrorInvalidArgument = u32(0xffffff79)
val esp32PsaErrorBufferTooSmall = u32(0xffffff76)
val esp32PsaMd5ErrorNotSupported = u32(0xffffff7a)
val esp32PsaAlgorithmMd5 = u32(0x02000003)
val esp32Md5DigestSize = u32(16)
val esp32Md5ContextSize = u32(88)

@inline
trusted fun esp32Md5StoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))

trusted fun esp32Md5HashCompute(
    algorithm:u32,input:u32,inputLength:u32,hash:u32,hashSize:u32,hashLength:u32
):u32 {
    if (hash == u32(0) || hashLength == u32(0)) return esp32PsaErrorInvalidArgument
    if (inputLength != u32(0) && input == u32(0)) return esp32PsaErrorInvalidArgument
    if (hashSize < esp32Md5DigestSize) return esp32PsaErrorBufferTooSmall
    if (algorithm != esp32PsaAlgorithmMd5) return esp32PsaMd5ErrorNotSupported
    val context = u32(nativeStackAllocate(88))
    freestandingSet(context,i32(0),esp32Md5ContextSize)
    esp32RomMd5Init(context)
    esp32RomMd5Update(context,input,inputLength)
    esp32RomMd5Final(hash,context)
    esp32Md5StoreU32(hashLength,esp32Md5DigestSize)
    esp32PsaSuccess
}

trusted fun esp32Md5HashSetup(operation:u32, algorithm:u32):u32 {
    if (operation == u32(0)) return esp32PsaErrorInvalidArgument
    if (algorithm != esp32PsaAlgorithmMd5) return esp32PsaMd5ErrorNotSupported
    esp32RomMd5Init(operation)
    esp32PsaSuccess
}

trusted fun esp32Md5HashUpdate(operation:u32,input:u32,inputLength:u32):u32 {
    if (operation == u32(0)) return esp32PsaErrorInvalidArgument
    if (inputLength != u32(0) && input == u32(0)) return esp32PsaErrorInvalidArgument
    esp32RomMd5Update(operation,input,inputLength)
    esp32PsaSuccess
}

trusted fun esp32Md5HashFinish(
    operation:u32,hash:u32,hashSize:u32,hashLength:u32
):u32 {
    if (operation == u32(0) || hash == u32(0) || hashLength == u32(0)) {
        return esp32PsaErrorInvalidArgument
    }
    if (hashSize < esp32Md5DigestSize) return esp32PsaErrorBufferTooSmall
    esp32RomMd5Final(hash,operation)
    esp32Md5StoreU32(hashLength,esp32Md5DigestSize)
    esp32PsaSuccess
}

trusted fun esp32Md5HashAbort(operation:u32):u32 {
    if (operation == u32(0)) return esp32PsaErrorInvalidArgument
    freestandingSet(operation,i32(0),esp32Md5ContextSize)
    esp32PsaSuccess
}

trusted fun esp32Md5HashClone(source:u32,target:u32):u32 {
    if (source == u32(0) || target == u32(0)) return esp32PsaErrorInvalidArgument
    freestandingCopy(target,source,esp32Md5ContextSize)
    esp32PsaSuccess
}

// Compatibility adapters for the two larger PSA/HMAC modules still awaiting
// structured conversion.
trusted fun esp32RecoveredEspMd5HashCompute(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32Md5HashCompute(a2,a3,a4,a5,a6,a7)
trusted fun esp32RecoveredEspMd5HashSetup(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32Md5HashSetup(a2,a3)
trusted fun esp32RecoveredEspMd5HashUpdate(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32Md5HashUpdate(a2,a3,a4)
trusted fun esp32RecoveredEspMd5HashFinish(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32Md5HashFinish(a2,a3,a4,a5)
trusted fun esp32RecoveredEspMd5HashAbort(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32Md5HashAbort(a2)
trusted fun esp32RecoveredEspMd5HashClone(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32Md5HashClone(a2,a3)
