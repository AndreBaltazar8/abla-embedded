import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoHashInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPsaHashAbort", "mbedtls_psa_hash_abort")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaHashSetup", "mbedtls_psa_hash_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaHashClone", "mbedtls_psa_hash_clone")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaHashUpdate", "mbedtls_psa_hash_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaHashFinish", "mbedtls_psa_hash_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaHashCompute", "mbedtls_psa_hash_compute")) return false
    true
}
