import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoHmacDrbgInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgInit", "mbedtls_hmac_drbg_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgUpdate", "mbedtls_hmac_drbg_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgSeedBuf", "mbedtls_hmac_drbg_seed_buf")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgReseed", "mbedtls_hmac_drbg_reseed")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgSeed", "mbedtls_hmac_drbg_seed")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgSetPredictionResistance", "mbedtls_hmac_drbg_set_prediction_resistance")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgSetEntropyLen", "mbedtls_hmac_drbg_set_entropy_len")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgSetReseedInterval", "mbedtls_hmac_drbg_set_reseed_interval")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgRandomWithAdd", "mbedtls_hmac_drbg_random_with_add")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgRandom", "mbedtls_hmac_drbg_random")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgFree", "mbedtls_hmac_drbg_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgWriteSeedFile", "mbedtls_hmac_drbg_write_seed_file")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgUpdateSeedFile", "mbedtls_hmac_drbg_update_seed_file")) return false
    if (!internalFunction("esp32RecoveredMbedtlsHmacDrbgSelfTest", "mbedtls_hmac_drbg_self_test")) return false
    true
}
