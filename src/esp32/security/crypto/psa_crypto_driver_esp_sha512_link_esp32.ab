import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverEspSha512Internals(): bool {
    if (!internalFunction("esp32RecoveredEspSha512Starts", "esp_sha512_starts")) return false
    if (!internalFunction("esp32RecoveredEspInternalSha512Process", "esp_internal_sha512_process")) return false
    if (!internalFunction("esp32RecoveredEspSha512DriverCompute", "esp_sha512_driver_compute")) return false
    if (!internalFunction("esp32RecoveredEspSha512DriverUpdate", "esp_sha512_driver_update")) return false
    if (!internalFunction("esp32RecoveredEspSha512DriverFinish", "esp_sha512_driver_finish")) return false
    if (!internalFunction("esp32RecoveredEspSha512DriverAbort", "esp_sha512_driver_abort")) return false
    if (!internalFunction("esp32RecoveredEspSha512DriverClone", "esp_sha512_driver_clone")) return false
    true
}
