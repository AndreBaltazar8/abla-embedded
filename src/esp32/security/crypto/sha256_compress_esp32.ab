import "abla/unsafe/memory"

// Shared source-level SHA-224/SHA-256 compression core.  Both the ordinary
// Mbed TLS context and the ESP parallel-engine context store their eight state
// words contiguously, so one internal Abla implementation replaces two
// separately expanded recovered register machines.
val esp32Sha256RoundConstants = u32(nativeStaticU32s([
    int(u32(0x428a2f98)), int(u32(0x71374491)),
    int(u32(0xb5c0fbcf)), int(u32(0xe9b5dba5)),
    int(u32(0x3956c25b)), int(u32(0x59f111f1)),
    int(u32(0x923f82a4)), int(u32(0xab1c5ed5)),
    int(u32(0xd807aa98)), int(u32(0x12835b01)),
    int(u32(0x243185be)), int(u32(0x550c7dc3)),
    int(u32(0x72be5d74)), int(u32(0x80deb1fe)),
    int(u32(0x9bdc06a7)), int(u32(0xc19bf174)),
    int(u32(0xe49b69c1)), int(u32(0xefbe4786)),
    int(u32(0x0fc19dc6)), int(u32(0x240ca1cc)),
    int(u32(0x2de92c6f)), int(u32(0x4a7484aa)),
    int(u32(0x5cb0a9dc)), int(u32(0x76f988da)),
    int(u32(0x983e5152)), int(u32(0xa831c66d)),
    int(u32(0xb00327c8)), int(u32(0xbf597fc7)),
    int(u32(0xc6e00bf3)), int(u32(0xd5a79147)),
    int(u32(0x06ca6351)), int(u32(0x14292967)),
    int(u32(0x27b70a85)), int(u32(0x2e1b2138)),
    int(u32(0x4d2c6dfc)), int(u32(0x53380d13)),
    int(u32(0x650a7354)), int(u32(0x766a0abb)),
    int(u32(0x81c2c92e)), int(u32(0x92722c85)),
    int(u32(0xa2bfe8a1)), int(u32(0xa81a664b)),
    int(u32(0xc24b8b70)), int(u32(0xc76c51a3)),
    int(u32(0xd192e819)), int(u32(0xd6990624)),
    int(u32(0xf40e3585)), int(u32(0x106aa070)),
    int(u32(0x19a4c116)), int(u32(0x1e376c08)),
    int(u32(0x2748774c)), int(u32(0x34b0bcb5)),
    int(u32(0x391c0cb3)), int(u32(0x4ed8aa4a)),
    int(u32(0x5b9cca4f)), int(u32(0x682e6ff3)),
    int(u32(0x748f82ee)), int(u32(0x78a5636f)),
    int(u32(0x84c87814)), int(u32(0x8cc70208)),
    int(u32(0x90befffa)), int(u32(0xa4506ceb)),
    int(u32(0xbef9a3f7)), int(u32(0xc67178f2))
]))

@inline
trusted fun esp32Sha256LoadU32(address: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32Sha256StoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32Sha256LoadBigEndian(address: u32): u32 =
    (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))) << u32(24)) |
    (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address + u32(1))))) << u32(16)) |
    (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address + u32(2))))) << u32(8)) |
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address + u32(3)))))

@inline
fun esp32Sha256RotateRight(value: u32, amount: u32): u32 =
    (value >>> amount) | (value << (u32(32) - amount))

trusted fun esp32Sha256Compress(state: u32, data: u32): void {
    val schedule = u32(nativeStackAllocate(256))
    var index = u32(0)
    while (index < u32(16)) {
        esp32Sha256StoreU32(
            schedule + index * u32(4),
            esp32Sha256LoadBigEndian(data + index * u32(4))
        )
        index = index + u32(1)
    }
    while (index < u32(64)) {
        val word2 = esp32Sha256LoadU32(schedule + (index - u32(2)) * u32(4))
        val word15 = esp32Sha256LoadU32(schedule + (index - u32(15)) * u32(4))
        val sigma1 = esp32Sha256RotateRight(word2, u32(17)) ^
            esp32Sha256RotateRight(word2, u32(19)) ^ (word2 >>> u32(10))
        val sigma0 = esp32Sha256RotateRight(word15, u32(7)) ^
            esp32Sha256RotateRight(word15, u32(18)) ^ (word15 >>> u32(3))
        esp32Sha256StoreU32(
            schedule + index * u32(4),
            sigma1 + esp32Sha256LoadU32(schedule + (index - u32(7)) * u32(4)) +
            sigma0 + esp32Sha256LoadU32(schedule + (index - u32(16)) * u32(4))
        )
        index = index + u32(1)
    }

    var a = esp32Sha256LoadU32(state)
    var b = esp32Sha256LoadU32(state + u32(4))
    var c = esp32Sha256LoadU32(state + u32(8))
    var d = esp32Sha256LoadU32(state + u32(12))
    var e = esp32Sha256LoadU32(state + u32(16))
    var f = esp32Sha256LoadU32(state + u32(20))
    var g = esp32Sha256LoadU32(state + u32(24))
    var h = esp32Sha256LoadU32(state + u32(28))
    index = u32(0)
    while (index < u32(64)) {
        val bigSigma1 = esp32Sha256RotateRight(e, u32(6)) ^
            esp32Sha256RotateRight(e, u32(11)) ^
            esp32Sha256RotateRight(e, u32(25))
        val choice = g ^ (e & (f ^ g))
        val temporary1 = h + bigSigma1 + choice +
            esp32Sha256LoadU32(esp32Sha256RoundConstants + index * u32(4)) +
            esp32Sha256LoadU32(schedule + index * u32(4))
        val bigSigma0 = esp32Sha256RotateRight(a, u32(2)) ^
            esp32Sha256RotateRight(a, u32(13)) ^
            esp32Sha256RotateRight(a, u32(22))
        val majority = (a & b) | (c & (a | b))
        val temporary2 = bigSigma0 + majority
        h = g
        g = f
        f = e
        e = d + temporary1
        d = c
        c = b
        b = a
        a = temporary1 + temporary2
        index = index + u32(1)
    }

    esp32Sha256StoreU32(state, esp32Sha256LoadU32(state) + a)
    esp32Sha256StoreU32(state + u32(4), esp32Sha256LoadU32(state + u32(4)) + b)
    esp32Sha256StoreU32(state + u32(8), esp32Sha256LoadU32(state + u32(8)) + c)
    esp32Sha256StoreU32(state + u32(12), esp32Sha256LoadU32(state + u32(12)) + d)
    esp32Sha256StoreU32(state + u32(16), esp32Sha256LoadU32(state + u32(16)) + e)
    esp32Sha256StoreU32(state + u32(20), esp32Sha256LoadU32(state + u32(20)) + f)
    esp32Sha256StoreU32(state + u32(24), esp32Sha256LoadU32(state + u32(24)) + g)
    esp32Sha256StoreU32(state + u32(28), esp32Sha256LoadU32(state + u32(28)) + h)
}
