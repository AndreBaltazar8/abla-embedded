import "../../../runtime/freestanding_memory.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

val esp32AesContextBytes = u32(34)
val esp32AesBadInput = u32(0xffffffe0)

@inline
trusted fun esp32AesLoadU8(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32AesStoreU8(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

// The software AES context is exactly the key size byte, one state byte and
// the largest supported key. Keeping this representation visible to LLVM lets
// unused software-AES paths disappear with their callers.
trusted fun esp32AesValidKeyLength(context: u32): u32 {
    val length = esp32AesLoadU8(context)
    if (length == u32(16) || length == u32(24) || length == u32(32)) return u32(1)
    u32(0)
}

trusted fun esp32AesInit(context: u32): void {
    freestandingSet(context, i32(0), esp32AesContextBytes)
    return
}

trusted fun esp32AesFree(context: u32): void {
    if (context != u32(0)) freestandingSecureZero(context, esp32AesContextBytes)
}

trusted fun esp32AesSetKey(context: u32, key: u32, keyBits: u32): u32 {
    if (keyBits != u32(128) && keyBits != u32(192) && keyBits != u32(256)) {
        return esp32AesBadInput
    }
    val keyBytes = keyBits >>> u32(3)
    esp32AesStoreU8(context, keyBytes)
    freestandingCopy(context + u32(2), key, keyBytes)
    esp32AesStoreU8(context + u32(1), u32(0))
    u32(0)
}

// Temporary register-shaped adapters for neighboring lifted callers. These
// remain internal and disappear once those callers have typed signatures.
trusted fun esp32RecoveredValidKeyLength(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32AesValidKeyLength(a2)

trusted fun esp32RecoveredEspAesInit(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32AesInit(a2); a2 }

trusted fun esp32RecoveredEspAesFree(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32AesFree(a2); a2 }

trusted fun esp32RecoveredEspAesSetkey(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32AesSetKey(a2, a3, a4)
