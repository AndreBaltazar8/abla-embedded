import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoSha3Internals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsSha3Init", "mbedtls_sha3_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha3Free", "mbedtls_sha3_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha3Clone", "mbedtls_sha3_clone")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha3Starts", "mbedtls_sha3_starts")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha3Update", "mbedtls_sha3_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha3Finish", "mbedtls_sha3_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha3", "mbedtls_sha3")) return false
    if (!internalFunction("esp32RecoveredMbedtlsSha3SelfTest", "mbedtls_sha3_self_test")) return false
    true
}
