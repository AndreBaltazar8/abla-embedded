import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverEspSha256Internals(): bool {
    if (!internalFunction("esp32RecoveredEspSha256DriverClone", "esp_sha256_driver_clone")) return false
    if (!internalFunction("esp32RecoveredEspSha256Starts", "esp_sha256_starts")) return false
    if (!internalFunction("esp32RecoveredEspInternalSha256Process", "esp_internal_sha256_process")) return false
    if (!internalFunction("esp32RecoveredEspSha256DriverUpdate", "esp_sha256_driver_update")) return false
    if (!internalFunction("esp32RecoveredEspSha256DriverCompute", "esp_sha256_driver_compute")) return false
    if (!internalFunction("esp32RecoveredEspSha256DriverFinish", "esp_sha256_driver_finish")) return false
    if (!internalFunction("esp32RecoveredEspSha256DriverAbort", "esp_sha256_driver_abort")) return false
    true
}
