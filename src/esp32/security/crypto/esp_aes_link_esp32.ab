import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoEspAesInternals(): bool {
    if (!internalFunction("esp32RecoveredEspAesAcquireHardware", "esp_aes_acquire_hardware")) return false
    if (!internalFunction("esp32RecoveredEspAesReleaseHardware", "esp_aes_release_hardware")) return false
    if (!internalFunction("esp32RecoveredEspAesCryptEcb", "esp_aes_crypt_ecb")) return false
    if (!internalFunction("esp32RecoveredEspInternalAesEncrypt", "esp_internal_aes_encrypt")) return false
    if (!internalFunction("esp32RecoveredEspInternalAesDecrypt", "esp_internal_aes_decrypt")) return false
    if (!internalFunction("esp32RecoveredEspAesCryptCbc", "esp_aes_crypt_cbc")) return false
    if (!internalFunction("esp32RecoveredEspAesCryptCfb8", "esp_aes_crypt_cfb8")) return false
    if (!internalFunction("esp32RecoveredEspAesCryptCfb128", "esp_aes_crypt_cfb128")) return false
    if (!internalFunction("esp32RecoveredEspAesCryptOfb", "esp_aes_crypt_ofb")) return false
    if (!internalFunction("esp32RecoveredEspAesCryptCtr", "esp_aes_crypt_ctr")) return false
    true
}
