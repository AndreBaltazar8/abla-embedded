import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaUtilInternalInternals(): bool {
    if (!internalFunction("esp32RecoveredPsaGenericStatusToMbedtls", "psa_generic_status_to_mbedtls")) return false
    if (!internalFunction("esp32RecoveredPsaStatusToMbedtls", "psa_status_to_mbedtls")) return false
    if (!internalFunction("esp32RecoveredPsaPkStatusToMbedtls", "psa_pk_status_to_mbedtls")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEccGroupToPsa", "mbedtls_ecc_group_to_psa")) return false
    if (!internalFunction("esp32RecoveredMbedtlsEccGroupFromPsa", "mbedtls_ecc_group_from_psa")) return false
    true
}
