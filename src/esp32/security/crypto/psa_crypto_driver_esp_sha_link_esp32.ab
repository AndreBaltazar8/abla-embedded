import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverEspShaInternals(): bool {
    if (!internalFunction("esp32RecoveredEspShaHashCompute", "esp_sha_hash_compute")) return false
    if (!internalFunction("esp32RecoveredEspShaHashSetup", "esp_sha_hash_setup")) return false
    if (!internalFunction("esp32RecoveredEspShaHashUpdate", "esp_sha_hash_update")) return false
    if (!internalFunction("esp32RecoveredEspShaHashFinish", "esp_sha_hash_finish")) return false
    if (!internalFunction("esp32RecoveredEspShaHashAbort", "esp_sha_hash_abort")) return false
    if (!internalFunction("esp32RecoveredEspShaHashClone", "esp_sha_hash_clone")) return false
    true
}
