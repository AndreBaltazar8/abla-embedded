import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoMacInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPsaMacAbort", "mbedtls_psa_mac_abort")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaMacSignSetup", "mbedtls_psa_mac_sign_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaMacVerifySetup", "mbedtls_psa_mac_verify_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaMacUpdate", "mbedtls_psa_mac_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaMacSignFinish", "mbedtls_psa_mac_sign_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaMacVerifyFinish", "mbedtls_psa_mac_verify_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaMacCompute", "mbedtls_psa_mac_compute")) return false
    true
}
