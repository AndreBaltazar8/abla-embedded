import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverEspMd5Internals(): bool {
    if (!internalFunction("esp32Md5HashCompute", "esp_md5_hash_compute")) return false
    if (!internalFunction("esp32Md5HashSetup", "esp_md5_hash_setup")) return false
    if (!internalFunction("esp32Md5HashUpdate", "esp_md5_hash_update")) return false
    if (!internalFunction("esp32Md5HashFinish", "esp_md5_hash_finish")) return false
    if (!internalFunction("esp32Md5HashAbort", "esp_md5_hash_abort")) return false
    if (!internalFunction("esp32Md5HashClone", "esp_md5_hash_clone")) return false
    true
}
