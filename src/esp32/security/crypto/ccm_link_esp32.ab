import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoCcmInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsCcmInit", "mbedtls_ccm_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmSetkey", "mbedtls_ccm_setkey")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmFree", "mbedtls_ccm_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmStarts", "mbedtls_ccm_starts")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmSetLengths", "mbedtls_ccm_set_lengths")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmUpdateAd", "mbedtls_ccm_update_ad")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmUpdate", "mbedtls_ccm_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmFinish", "mbedtls_ccm_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmStarEncryptAndTag", "mbedtls_ccm_star_encrypt_and_tag")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmEncryptAndTag", "mbedtls_ccm_encrypt_and_tag")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmStarAuthDecrypt", "mbedtls_ccm_star_auth_decrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmAuthDecrypt", "mbedtls_ccm_auth_decrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCcmSelfTest", "mbedtls_ccm_self_test")) return false
    true
}
