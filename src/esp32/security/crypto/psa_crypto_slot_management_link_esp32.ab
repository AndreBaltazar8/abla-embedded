import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoSlotManagementInternals(): bool {
    if (!internalFunction("esp32RecoveredPsaInitializeKeySlots", "psa_initialize_key_slots")) return false
    if (!internalFunction("esp32RecoveredPsaWipeAllKeySlots", "psa_wipe_all_key_slots")) return false
    if (!internalFunction("esp32RecoveredPsaFreeKeySlot", "psa_free_key_slot")) return false
    if (!internalFunction("esp32RecoveredPsaReserveFreeKeySlot", "psa_reserve_free_key_slot")) return false
    if (!internalFunction("esp32RecoveredPsaGetAndLockKeySlot", "psa_get_and_lock_key_slot")) return false
    if (!internalFunction("esp32RecoveredPsaUnregisterRead", "psa_unregister_read")) return false
    if (!internalFunction("esp32RecoveredPsaUnregisterReadUnderMutex", "psa_unregister_read_under_mutex")) return false
    if (!internalFunction("esp32RecoveredPsaValidateKeyPersistence", "psa_validate_key_persistence")) return false
    if (!internalFunction("esp32RecoveredPsaPurgeKey", "psa_purge_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaGetStats", "mbedtls_psa_get_stats")) return false
    true
}
