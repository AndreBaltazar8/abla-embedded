import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoBignumCoreInternals(): bool {
    if (!internalFunction("esp32MbedtlsMpiCoreClz", "mbedtls_mpi_core_clz")) return false
    if (!internalFunction("esp32MbedtlsMpiCoreBitlen", "mbedtls_mpi_core_bitlen")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreBigendianToHost", "mbedtls_mpi_core_bigendian_to_host")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreUintLeMpi", "mbedtls_mpi_core_uint_le_mpi")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreLtCt", "mbedtls_mpi_core_lt_ct")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreCondAssign", "mbedtls_mpi_core_cond_assign")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreCondSwap", "mbedtls_mpi_core_cond_swap")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreReadLe", "mbedtls_mpi_core_read_le")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreReadBe", "mbedtls_mpi_core_read_be")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreWriteLe", "mbedtls_mpi_core_write_le")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreWriteBe", "mbedtls_mpi_core_write_be")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreShiftR", "mbedtls_mpi_core_shift_r")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreShiftL", "mbedtls_mpi_core_shift_l")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreAdd", "mbedtls_mpi_core_add")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreAddIf", "mbedtls_mpi_core_add_if")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreSub", "mbedtls_mpi_core_sub")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreMla", "mbedtls_mpi_core_mla")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreMul", "mbedtls_mpi_core_mul")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreMontmulInit", "mbedtls_mpi_core_montmul_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreMontmul", "mbedtls_mpi_core_montmul")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreGetMontR2Unsafe", "mbedtls_mpi_core_get_mont_r2_unsafe")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreFillRandom", "mbedtls_mpi_core_fill_random")) return false
