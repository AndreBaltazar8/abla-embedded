    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreExpModWorkingLimbs", "mbedtls_mpi_core_exp_mod_working_limbs")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreExpMod", "mbedtls_mpi_core_exp_mod")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreExpModUnsafe", "mbedtls_mpi_core_exp_mod_unsafe")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreSubInt", "mbedtls_mpi_core_sub_int")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMpiCoreCheckZeroCt", "mbedtls_mpi_core_check_zero_ct")) return false
