import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverEspCmacInternals(): bool {
    if (!internalFunction("esp32RecoveredEspCmacAbort", "esp_cmac_abort")) return false
    if (!internalFunction("esp32RecoveredEspCmacSetup", "esp_cmac_setup")) return false
    if (!internalFunction("esp32RecoveredEspCmacUpdate", "esp_cmac_update")) return false
    if (!internalFunction("esp32RecoveredEspCmacFinish", "esp_cmac_finish")) return false
    if (!internalFunction("esp32RecoveredEspCmacCompute", "esp_cmac_compute")) return false
    if (!internalFunction("esp32RecoveredEspCmacVerifyFinish", "esp_cmac_verify_finish")) return false
    true
}
