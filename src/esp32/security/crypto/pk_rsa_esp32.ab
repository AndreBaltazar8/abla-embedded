import "../../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Mbed TLS RSA/PSA bridge in structured Abla. Constants are taken from the PSA
// API definitions, avoiding the shifted-immediate truncation present in the
// mechanical Xtensa lift.

@inline
trusted fun esp32PkRsaLoadU16(address:u32):u32 =
    u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32PkRsaLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32PkRsaStoreU16(address:u32, value:u32):void =
    ablaUnsafeStoreU16(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32PkRsaStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32PkRsaImport(attributes:u32, key:u32, keyLength:u32, keyIdOut:u32):u32 =
    esp32RecoveredPsaImportKey(
        attributes,key,keyLength,keyIdOut,u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32PkRsaGetAttributes(keyId:u32, attributes:u32):u32 =
    esp32RecoveredPsaGetKeyAttributes(
        keyId,attributes,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32PkRsaDestroy(keyId:u32):u32 = esp32RecoveredPsaDestroyKey(
    keyId,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32PkRsaResetAttributes(attributes:u32):void {
    esp32RecoveredPsaResetKeyAttributes(
        attributes,u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    return
}

trusted fun esp32PkRsaMapStatus(status:u32):u32 =
    esp32RecoveredPsaPkStatusToMbedtls(
        status,u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32MbedtlsPkRsaSetKey(pk:u32, key:u32, keyLength:u32):u32 {
    val attributes = u32(nativeStackAllocate(24))
    freestandingSet(attributes, i32(0), u32(24))

    esp32PkRsaStoreU16(pk + u32(4), u32(0x7001))
    esp32PkRsaStoreU16(attributes, u32(0x7001))
    esp32PkRsaStoreU32(attributes + u32(8), u32(0x3c03))
    esp32PkRsaStoreU32(attributes + u32(12), u32(0x060002ff))
    esp32PkRsaStoreU32(attributes + u32(16), u32(0x060003ff))

    var status = esp32PkRsaImport(attributes, key, keyLength, pk + u32(8))
    if (status != u32(0)) return esp32PkRsaMapStatus(status)

    val keyId = esp32PkRsaLoadU32(pk + u32(8))
    status = esp32PkRsaGetAttributes(keyId, attributes)
    if (status != u32(0)) {
        esp32PkRsaDestroy(keyId)
        return esp32PkRsaMapStatus(status)
    }

    val bits = esp32PkRsaLoadU16(attributes + u32(2))
    val existingBits = esp32PkRsaLoadU32(pk + u32(544))
    if (existingBits != u32(0) && existingBits != bits) {
        esp32PkRsaDestroy(keyId)
        return u32(0xffffff79)
    }

    esp32PkRsaStoreU32(pk + u32(544), bits)
    esp32PkRsaResetAttributes(attributes)
    u32(0)
}

trusted fun esp32MbedtlsPkRsaSetPublicKey(pk:u32, key:u32, keyLength:u32):u32 {
    if (keyLength > u32(528)) return u32(0xffffc500)

    val frame = u32(nativeStackAllocate(28))
    val attributes = frame
    val keyIdOut = frame + u32(24)
    freestandingSet(frame, i32(0), u32(28))

    esp32PkRsaStoreU16(attributes, u32(0x4001))
    esp32PkRsaStoreU32(attributes + u32(8), u32(0x2803))
    esp32PkRsaStoreU32(attributes + u32(12), u32(0x060002ff))

    var status = esp32PkRsaImport(attributes, key, keyLength, keyIdOut)
    if (status != u32(0)) return u32(0xffffc500)

    val keyId = esp32PkRsaLoadU32(keyIdOut)
    status = esp32PkRsaGetAttributes(keyId, attributes)
    if (status != u32(0)) {
        esp32PkRsaDestroy(keyId)
        return esp32PkRsaMapStatus(status)
    }

    status = esp32PkRsaDestroy(keyId)
    if (status != u32(0)) {
        esp32PkRsaResetAttributes(attributes)
        return esp32PkRsaMapStatus(status)
    }

    val bits = esp32PkRsaLoadU16(attributes + u32(2))
    esp32PkRsaResetAttributes(attributes)
    val existingBits = esp32PkRsaLoadU32(pk + u32(544))
    if (existingBits != u32(0) && existingBits != bits) return u32(0xffffff79)

    esp32PkRsaStoreU32(pk + u32(544), bits)
    freestandingCopy(pk + u32(12), key, keyLength)
    esp32PkRsaStoreU32(pk + u32(540), keyLength)
    esp32PkRsaStoreU16(pk + u32(4), u32(0x4001))
    u32(0)
}

// Temporary adapters for pkparse/pk while those larger modules are rewritten.
trusted fun esp32RecoveredMbedtlsPkRsaSetKey(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPkRsaSetKey(a2,a3,a4)

trusted fun esp32RecoveredMbedtlsPkRsaSetPubkey(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32MbedtlsPkRsaSetPublicKey(a2,a3,a4)
