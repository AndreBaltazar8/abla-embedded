import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoEspAesXtsInternals(): bool {
    if (!internalFunction("esp32RecoveredEspAesXtsInit", "esp_aes_xts_init")) return false
    if (!internalFunction("esp32RecoveredEspAesXtsFree", "esp_aes_xts_free")) return false
    if (!internalFunction("esp32RecoveredEspAesXtsSetkeyEnc", "esp_aes_xts_setkey_enc")) return false
    if (!internalFunction("esp32RecoveredEspAesXtsSetkeyDec", "esp_aes_xts_setkey_dec")) return false
    if (!internalFunction("esp32RecoveredEspAesCryptXts", "esp_aes_crypt_xts")) return false
    true
}
