import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoThreadingInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsConditionVariableInit", "mbedtls_condition_variable_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsConditionVariableFree", "mbedtls_condition_variable_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsConditionVariableSignal", "mbedtls_condition_variable_signal")) return false
    if (!internalFunction("esp32RecoveredMbedtlsConditionVariableBroadcast", "mbedtls_condition_variable_broadcast")) return false
    if (!internalFunction("esp32RecoveredMbedtlsConditionVariableWait", "mbedtls_condition_variable_wait")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMutexInit", "mbedtls_mutex_init")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMutexFree", "mbedtls_mutex_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMutexLock", "mbedtls_mutex_lock")) return false
    if (!internalFunction("esp32RecoveredMbedtlsMutexUnlock", "mbedtls_mutex_unlock")) return false
    true
}
