import "abla/integer"
import "abla/unsafe/memory"

@inline
fun esp32MbedtlsMpiCoreClz(value: u32): u32 = value.countLeadingZeros()

trusted fun esp32MbedtlsMpiCoreBitlen(
    limbsAddress: u32,
    limbCount: u32
): u32 {
    var remaining = limbCount
    while (remaining > u32(0)) {
        remaining = remaining - u32(1)
        val limb = u32(ablaUnsafeLoadU32(
            nativePointerFromAddress(
                int(limbsAddress + (remaining << u32(2)))
            )
        ))
        if (limb != u32(0)) {
            return ((remaining + u32(1)) << u32(5)) -
                limb.countLeadingZeros()
        }
    }
    u32(0)
}
