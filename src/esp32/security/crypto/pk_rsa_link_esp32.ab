import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPkRsaInternals(): bool {
    if (!internalFunction("esp32MbedtlsPkRsaSetKey", "mbedtls_pk_rsa_set_key")) return false
    if (!internalFunction("esp32MbedtlsPkRsaSetPublicKey", "mbedtls_pk_rsa_set_pubkey")) return false
    true
}
