import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoBignumAltInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMpiEnableHardwareHwOp", "esp_mpi_enable_hardware_hw_op")) return false
    if (!internalFunction("esp32RecoveredEspMpiDisableHardwareHwOp", "esp_mpi_disable_hardware_hw_op")) return false
    if (!internalFunction("esp32RecoveredEspMpiHardwareWords", "esp_mpi_hardware_words")) return false
    if (!internalFunction("esp32RecoveredEspMpiInterruptEnable", "esp_mpi_interrupt_enable")) return false
    if (!internalFunction("esp32RecoveredEspMpiInterruptClear", "esp_mpi_interrupt_clear")) return false
    if (!internalFunction("esp32RecoveredEspMpiMulMpiModHwOp", "esp_mpi_mul_mpi_mod_hw_op")) return false
    if (!internalFunction("esp32RecoveredEspMpiMulMpiHwOp", "esp_mpi_mul_mpi_hw_op")) return false
    if (!internalFunction("esp32RecoveredEspMpiMultMpiFailoverModMultHwOp", "esp_mpi_mult_mpi_failover_mod_mult_hw_op")) return false
    if (!internalFunction("esp32RecoveredEspMontHwOp", "esp_mont_hw_op")) return false
    true
}
