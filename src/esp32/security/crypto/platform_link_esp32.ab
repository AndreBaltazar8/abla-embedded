import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPlatformInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsCalloc", "mbedtls_calloc")) return false
    if (!internalFunction("esp32RecoveredMbedtlsFree", "mbedtls_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPlatformSetCallocFree", "mbedtls_platform_set_calloc_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPlatformSetup", "mbedtls_platform_setup")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPlatformTeardown", "mbedtls_platform_teardown")) return false
    true
}
