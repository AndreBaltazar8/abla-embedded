import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoFfdhInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPsaFfdhExportPublicKey", "mbedtls_psa_ffdh_export_public_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaFfdhGenerateKey", "mbedtls_psa_ffdh_generate_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaFfdhImportKey", "mbedtls_psa_ffdh_import_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaFfdhKeyAgreement", "mbedtls_psa_ffdh_key_agreement")) return false
    true
}
