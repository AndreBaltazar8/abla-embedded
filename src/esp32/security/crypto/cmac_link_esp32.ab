import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoCmacInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsCipherCmacStarts", "mbedtls_cipher_cmac_starts")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherCmacUpdate", "mbedtls_cipher_cmac_update")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherCmacFinish", "mbedtls_cipher_cmac_finish")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherCmacReset", "mbedtls_cipher_cmac_reset")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCipherCmac", "mbedtls_cipher_cmac")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAesCmacPrf128", "mbedtls_aes_cmac_prf_128")) return false
    if (!internalFunction("esp32RecoveredMbedtlsCmacSelfTest", "mbedtls_cmac_self_test")) return false
    true
}
