import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPlatformUtilInternals(): bool {
    if (!internalFunction("esp32MbedtlsPlatformZeroize", "mbedtls_platform_zeroize")) return false
    if (!internalFunction("esp32MbedtlsZeroizeAndFree", "mbedtls_zeroize_and_free")) return false
    true
}
