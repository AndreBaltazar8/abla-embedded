import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoAsn1parseInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetLen", "mbedtls_asn1_get_len")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetTag", "mbedtls_asn1_get_tag")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetBool", "mbedtls_asn1_get_bool")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetInt", "mbedtls_asn1_get_int")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetEnum", "mbedtls_asn1_get_enum")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetInteger", "mbedtls_asn1_get_integer")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetBitstring", "mbedtls_asn1_get_bitstring")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1TraverseSequenceOf", "mbedtls_asn1_traverse_sequence_of")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetBitstringNull", "mbedtls_asn1_get_bitstring_null")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1SequenceFree", "mbedtls_asn1_sequence_free")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetSequenceOf", "mbedtls_asn1_get_sequence_of")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetAlg", "mbedtls_asn1_get_alg")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1GetAlgNull", "mbedtls_asn1_get_alg_null")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1FreeNamedDataList", "mbedtls_asn1_free_named_data_list")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1FreeNamedDataListShallow", "mbedtls_asn1_free_named_data_list_shallow")) return false
    if (!internalFunction("esp32RecoveredMbedtlsAsn1FindNamedData", "mbedtls_asn1_find_named_data")) return false
    true
}
