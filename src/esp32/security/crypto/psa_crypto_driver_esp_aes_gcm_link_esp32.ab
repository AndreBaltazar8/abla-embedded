import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverEspAesGcmInternals(): bool {
    if (!internalFunction("esp32RecoveredEspCryptoAesGcmEncryptSetup", "esp_crypto_aes_gcm_encrypt_setup")) return false
    if (!internalFunction("esp32RecoveredEspCryptoAesGcmDecryptSetup", "esp_crypto_aes_gcm_decrypt_setup")) return false
    if (!internalFunction("esp32RecoveredEspCryptoAesGcmSetNonce", "esp_crypto_aes_gcm_set_nonce")) return false
    if (!internalFunction("esp32RecoveredEspCryptoAesGcmUpdateAd", "esp_crypto_aes_gcm_update_ad")) return false
    if (!internalFunction("esp32RecoveredEspCryptoAesGcmUpdate", "esp_crypto_aes_gcm_update")) return false
    if (!internalFunction("esp32RecoveredEspCryptoAesGcmFinish", "esp_crypto_aes_gcm_finish")) return false
    if (!internalFunction("esp32RecoveredEspCryptoAesGcmAbort", "esp_crypto_aes_gcm_abort")) return false
    if (!internalFunction("esp32RecoveredEspCryptoAesGcmEncrypt", "esp_crypto_aes_gcm_encrypt")) return false
    if (!internalFunction("esp32RecoveredEspCryptoAesGcmDecrypt", "esp_crypto_aes_gcm_decrypt")) return false
    true
}
