import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoRsaInternals(): bool {
    if (!internalFunction("esp32RecoveredMbedtlsPsaRsaLoadRepresentation", "mbedtls_psa_rsa_load_representation")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaRsaExportKey", "mbedtls_psa_rsa_export_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaRsaImportKey", "mbedtls_psa_rsa_import_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaRsaExportPublicKey", "mbedtls_psa_rsa_export_public_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaRsaGenerateKey", "mbedtls_psa_rsa_generate_key")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaRsaSignHash", "mbedtls_psa_rsa_sign_hash")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaRsaVerifyHash", "mbedtls_psa_rsa_verify_hash")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAsymmetricEncrypt", "mbedtls_psa_asymmetric_encrypt")) return false
    if (!internalFunction("esp32RecoveredMbedtlsPsaAsymmetricDecrypt", "mbedtls_psa_asymmetric_decrypt")) return false
    true
}
