import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoPsaCryptoDriverWrappersNoStaticInternals(): bool {
    if (!internalFunction("esp32PsaDriverWrapperGetKeyBufferSize", "psa_driver_wrapper_get_key_buffer_size")) return false
    if (!internalFunction("esp32PsaDriverWrapperExportPublicKey", "psa_driver_wrapper_export_public_key")) return false
    if (!internalFunction("esp32PsaDriverWrapperGetBuiltinKey", "psa_driver_wrapper_get_builtin_key")) return false
    true
}
