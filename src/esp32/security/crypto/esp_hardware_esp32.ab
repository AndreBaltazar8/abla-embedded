import "../../crypto/random_hardware_esp32.ab"
import "abla/unsafe/memory"

trusted fun esp32MbedtlsHardwarePoll(
    context: u32,
    output: u32,
    length: u32,
    outputLength: u32
): i32 {
    esp32FillHardwareRandom(output, length)
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(outputLength)), int(length)
    )
    i32(0)
}

trusted fun esp32MbedtlsPsaExternalGetRandom(
    context: u32,
    output: u32,
    outputSize: u32,
    outputLength: u32
): i32 {
    if (context == u32(0) || output == u32(0) ||
        outputLength == u32(0)) return i32(-135)
    esp32FillHardwareRandom(output, outputSize)
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(outputLength)), int(outputSize)
    )
    i32(0)
}
