import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoEspPsaItsInternals(): bool {
    if (!internalFunction("esp32RecoveredPsaItsGetInfo", "psa_its_get_info")) return false
    if (!internalFunction("esp32RecoveredPsaItsGet", "psa_its_get")) return false
    if (!internalFunction("esp32RecoveredPsaItsSet", "psa_its_set")) return false
    if (!internalFunction("esp32RecoveredPsaItsRemove", "psa_its_remove")) return false
    true
}
