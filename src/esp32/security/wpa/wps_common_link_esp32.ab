import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpsCommonInternals(): bool {
    if (!internalFunction("esp32RecoveredWpsKdf", "wps_kdf")) return false
    if (!internalFunction("esp32RecoveredWpsDeriveKeys", "wps_derive_keys")) return false
    if (!internalFunction("esp32RecoveredWpsDerivePsk", "wps_derive_psk")) return false
    if (!internalFunction("esp32RecoveredWpsDecryptEncrSettings", "wps_decrypt_encr_settings")) return false
    if (!internalFunction("esp32RecoveredWpsPinChecksum", "wps_pin_checksum")) return false
    if (!internalFunction("esp32RecoveredWpsPinValid", "wps_pin_valid")) return false
    if (!internalFunction("esp32RecoveredWpsGeneratePin", "wps_generate_pin")) return false
    if (!internalFunction("esp32RecoveredWpsPinStrValid", "wps_pin_str_valid")) return false
    if (!internalFunction("esp32RecoveredWpsFailEvent", "wps_fail_event")) return false
    if (!internalFunction("esp32RecoveredWpsSuccessEvent", "wps_success_event")) return false
    if (!internalFunction("esp32RecoveredWpsPwdAuthFailEvent", "wps_pwd_auth_fail_event")) return false
    if (!internalFunction("esp32RecoveredWpsPbcOverlapEvent", "wps_pbc_overlap_event")) return false
    if (!internalFunction("esp32RecoveredWpsSelectedRegistrarTimeoutEvent", "wps_selected_registrar_timeout_event")) return false
    if (!internalFunction("esp32RecoveredWpsPbcTimeoutEvent", "wps_pbc_timeout_event")) return false
    if (!internalFunction("esp32RecoveredWpsPbcActiveEvent", "wps_pbc_active_event")) return false
    if (!internalFunction("esp32RecoveredWpsPbcDisableEvent", "wps_pbc_disable_event")) return false
    if (!internalFunction("esp32RecoveredWpsDevTypeStr2bin", "wps_dev_type_str2bin")) return false
    if (!internalFunction("esp32RecoveredWpsDevTypeBin2str", "wps_dev_type_bin2str")) return false
    if (!internalFunction("esp32RecoveredUuidGenMacAddr", "uuid_gen_mac_addr")) return false
    if (!internalFunction("esp32RecoveredWpsConfigMethodsStr2bin", "wps_config_methods_str2bin")) return false
    if (!internalFunction("esp32RecoveredWpsBuildWscAck", "wps_build_wsc_ack")) return false
    if (!internalFunction("esp32RecoveredWpsBuildWscNack", "wps_build_wsc_nack")) return false
    true
}
