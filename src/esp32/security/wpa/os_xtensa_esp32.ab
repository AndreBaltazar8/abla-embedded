import "../../../runtime/freestanding_memory.ab"
import "../../crypto/random_hardware_esp32.ab"
import "../../runtime/libc_syscalls_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

@inline
trusted fun esp32WpaStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32WpaGetTime(output:u32):u32 {
    val timeval = u32(nativeStackAllocate(12))
    val status = esp32LibcGettimeofday(timeval, u32(0))
    esp32WpaStoreU32(output, u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(timeval)))))
    esp32WpaStoreU32(output + u32(4), u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(timeval + u32(4))))))
    esp32WpaStoreU32(output + u32(8), u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(timeval + u32(8))))))
    // os_time_t is u64 even though suseconds_t is a 32-bit ESP32 value.
    esp32WpaStoreU32(output + u32(12), u32(0))
    status
}

trusted fun esp32WpaRandom():u32 = esp32HardwareRandom()

trusted fun esp32WpaGetRandom(buffer:u32, length:u32):u32 {
    esp32FillHardwareRandom(buffer, length)
    u32(0)
}

trusted fun esp32WpaSleep(seconds:u64, microseconds:u64):void {
    if (seconds != u64(0)) {
        esp32RecoveredSleep(u32(seconds),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    }
    if (microseconds != u64(0)) {
        esp32RecoveredUsleep(u32(microseconds),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    }
}

trusted fun esp32WpaForcedMemzero(address:u32, length:u32):void {
    freestandingSecureZero(address, length)
    return
}

trusted fun esp32RecoveredOsGetTime(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32WpaGetTime(a2)

trusted fun esp32RecoveredOsRandom(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32WpaRandom()

trusted fun esp32RecoveredOsGetRandom(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32WpaGetRandom(a2, a3)

trusted fun esp32RecoveredOsSleep(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    esp32WpaSleep(u64(a2) | (u64(a3) << u64(32)),
        u64(a4) | (u64(a5) << u64(32)))
    a2
}

trusted fun esp32RecoveredForcedMemzero(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32WpaForcedMemzero(a2, a3); a2 }
