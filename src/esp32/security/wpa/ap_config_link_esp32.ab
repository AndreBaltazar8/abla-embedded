import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaApConfigInternals(): bool {
    if (!internalFunction("esp32RecoveredHostapdConfigDefaultsBss", "hostapd_config_defaults_bss")) return false
    if (!internalFunction("esp32RecoveredHostapdConfigDefaults", "hostapd_config_defaults")) return false
    if (!internalFunction("esp32RecoveredHostapdMacComp", "hostapd_mac_comp")) return false
    if (!internalFunction("esp32RecoveredHostapdMacCompEmpty", "hostapd_mac_comp_empty")) return false
    if (!internalFunction("esp32RecoveredHostapdSetupSaePt", "hostapd_setup_sae_pt")) return false
    if (!internalFunction("esp32RecoveredHostapdSetupWpaPsk", "hostapd_setup_wpa_psk")) return false
    if (!internalFunction("esp32RecoveredHostapdWepKeyCmp", "hostapd_wep_key_cmp")) return false
    if (!internalFunction("esp32RecoveredHostapdMaclistFound", "hostapd_maclist_found")) return false
    if (!internalFunction("esp32RecoveredHostapdRateFound", "hostapd_rate_found")) return false
    if (!internalFunction("esp32RecoveredHostapdGetPsk", "hostapd_get_psk")) return false
    if (!internalFunction("esp32RecoveredHostapdConfigClearWpaPsk", "hostapd_config_clear_wpa_psk")) return false
    if (!internalFunction("esp32RecoveredHostapdConfigFreeBss", "hostapd_config_free_bss")) return false
    true
}
