import "abla/unsafe/memory"

@inline
trusted fun esp32UuidHexDigit(value: u32): u32 =
    if (value < u32(10)) u32(48) + value else u32(87) + value

// Source-level replacement for uuid_bin2str.  It preserves snprintf-style
// truncation and termination while returning the WPA utility's 0/-1 result.
trusted fun esp32UuidBinToString(
    source: u32,
    destination: u32,
    capacity: u32
): u32 {
    var sourceIndex = u32(0)
    var outputIndex = u32(0)
    while (sourceIndex < u32(16)) {
        val byte = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(source + sourceIndex))
        ))
        if (outputIndex + u32(1) < capacity) {
            ablaUnsafeStoreU8(
                nativePointerFromAddress(int(destination + outputIndex)),
                int(esp32UuidHexDigit(byte >>> u32(4)))
            )
        }
        outputIndex = outputIndex + u32(1)
        if (outputIndex + u32(1) < capacity) {
            ablaUnsafeStoreU8(
                nativePointerFromAddress(int(destination + outputIndex)),
                int(esp32UuidHexDigit(byte & u32(15)))
            )
        }
        outputIndex = outputIndex + u32(1)

        if (sourceIndex == u32(3) || sourceIndex == u32(5) ||
            sourceIndex == u32(7) || sourceIndex == u32(9)) {
            if (outputIndex + u32(1) < capacity) {
                ablaUnsafeStoreU8(
                    nativePointerFromAddress(int(destination + outputIndex)),
                    45
                )
            }
            outputIndex = outputIndex + u32(1)
        }
        sourceIndex = sourceIndex + u32(1)
    }

    if (capacity != u32(0)) {
        val terminator = if (outputIndex < capacity)
            outputIndex else capacity - u32(1)
        ablaUnsafeStoreU8(
            nativePointerFromAddress(int(destination + terminator)), 0
        )
    }
    if (outputIndex < capacity) u32(0) else u32(4294967295)
}
