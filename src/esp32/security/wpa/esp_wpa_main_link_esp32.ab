import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaEspWpaMainInternals(): bool {
    if (!internalFunction("esp32RecoveredWpaAttach", "wpa_attach")) return false
    if (!internalFunction("esp32RecoveredWpaConfigDone", "wpa_config_done")) return false
    if (!internalFunction("esp32RecoveredWpaDeattach", "wpa_deattach")) return false
    if (!internalFunction("esp32RecoveredWpaParseWpaIeWrapper", "wpa_parse_wpa_ie_wrapper")) return false
    if (!internalFunction("esp32RecoveredWpaInstallKey", "wpa_install_key")) return false
    if (!internalFunction("esp32RecoveredWpaGetKey", "wpa_get_key")) return false
    if (!internalFunction("esp32RecoveredWpaSendtoWrapper", "wpa_sendto_wrapper")) return false
    if (!internalFunction("esp32RecoveredWpaDeauthenticate", "wpa_deauthenticate")) return false
    if (!internalFunction("esp32RecoveredWpaConfigProfile", "wpa_config_profile")) return false
    if (!internalFunction("esp32RecoveredWpaConfigBss", "wpa_config_bss")) return false
    if (!internalFunction("esp32RecoveredWpaStaConnect", "wpa_sta_connect")) return false
    if (!internalFunction("esp32RecoveredWpaConfigAssocIe", "wpa_config_assoc_ie")) return false
    if (!internalFunction("esp32RecoveredWpaNegComplete", "wpa_neg_complete")) return false
    if (!internalFunction("esp32RecoveredWpaApGetWpaIe", "wpa_ap_get_wpa_ie")) return false
    if (!internalFunction("esp32RecoveredWpaApRxEapol", "wpa_ap_rx_eapol")) return false
    if (!internalFunction("esp32RecoveredWpaApGetPeerSppMsg", "wpa_ap_get_peer_spp_msg")) return false
    if (!internalFunction("esp32RecoveredEspSupplicantInit", "esp_supplicant_init")) return false
    if (!internalFunction("esp32RecoveredEspSupplicantDeinit", "esp_supplicant_deinit")) return false
    if (!internalFunction("esp32RecoveredEspSupplicantDisablePmkCaching", "esp_supplicant_disable_pmk_caching")) return false
    true
}
