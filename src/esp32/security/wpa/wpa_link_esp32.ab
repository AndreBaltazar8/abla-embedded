import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpaInternals(): bool {
    if (!internalFunction("esp32RecoveredEapolSmNotifyEapSuccess", "eapol_sm_notify_eap_success")) return false
    if (!internalFunction("esp32RecoveredCipherTypeMapSuppToPublic", "cipher_type_map_supp_to_public")) return false
    if (!internalFunction("esp32RecoveredCipherTypeMapPublicToSupp", "cipher_type_map_public_to_supp")) return false
    if (!internalFunction("esp32RecoveredWpaSmGetAuthAddr", "wpa_sm_get_auth_addr")) return false
    if (!internalFunction("esp32RecoveredWpaEapolKeySend", "wpa_eapol_key_send")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantSend2Of4", "wpa_supplicant_send_2_of_4")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantGtkTxBitWorkaround", "wpa_supplicant_gtk_tx_bit_workaround")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantPairwiseGtk", "wpa_supplicant_pairwise_gtk")) return false
    if (!internalFunction("esp32RecoveredWpaReportIeMismatch", "wpa_report_ie_mismatch")) return false
    if (!internalFunction("esp32RecoveredWpaSmGetTransitionDisable", "wpa_sm_get_transition_disable")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantStopCountermeasures", "wpa_supplicant_stop_countermeasures")) return false
    if (!internalFunction("esp32RecoveredWpaSmSetState", "wpa_sm_set_state")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantKeyNegComplete", "wpa_supplicant_key_neg_complete")) return false
    if (!internalFunction("esp32RecoveredWpaSmSetPmk", "wpa_sm_set_pmk")) return false
    if (!internalFunction("esp32RecoveredWpaSmSetPmkFromPmksa", "wpa_sm_set_pmk_from_pmksa")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantProcess1Of4", "wpa_supplicant_process_1_of_4")) return false
    if (!internalFunction("esp32RecoveredWpaSmInit", "wpa_sm_init")) return false
    if (!internalFunction("esp32RecoveredWpaSmNotifyAssoc", "wpa_sm_notify_assoc")) return false
    if (!internalFunction("esp32RecoveredWpaSetProfile", "wpa_set_profile")) return false
    if (!internalFunction("esp32RecoveredWpaSetPmk", "wpa_set_pmk")) return false
    if (!internalFunction("esp32RecoveredWpaSetPassphrase", "wpa_set_passphrase")) return false
    if (!internalFunction("esp32RecoveredSetAssocIe", "set_assoc_ie")) return false
    if (!internalFunction("esp32RecoveredWpaSmSetKey", "wpa_sm_set_key")) return false
    if (!internalFunction("esp32RecoveredWpaSmRxEapol", "wpa_sm_rx_eapol")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantClrCountermeasures", "wpa_supplicant_clr_countermeasures")) return false
    if (!internalFunction("esp32RecoveredWpaMichaelMicFailure", "wpa_michael_mic_failure")) return false
    if (!internalFunction("esp32RecoveredEapolTxcb", "eapol_txcb")) return false
    if (!internalFunction("esp32RecoveredWpaStaIn4wayHandshake", "wpa_sta_in_4way_handshake")) return false
    if (!internalFunction("esp32RecoveredWpaStaIsCurPmksaSet", "wpa_sta_is_cur_pmksa_set")) return false
    if (!internalFunction("esp32RecoveredWpaStaCurPmksaMatchesAkm", "wpa_sta_cur_pmksa_matches_akm")) return false
    if (!internalFunction("esp32RecoveredWpaStaClearCurrPmksa", "wpa_sta_clear_curr_pmksa")) return false
    if (!internalFunction("esp32RecoveredGetWpaSm", "get_wpa_sm")) return false
    if (!internalFunction("esp32RecoveredWpaSmSetApRsnIe", "wpa_sm_set_ap_rsn_ie")) return false
    if (!internalFunction("esp32RecoveredWpaSmSetApRsnxe", "wpa_sm_set_ap_rsnxe")) return false
    if (!internalFunction("esp32RecoveredWpaSmSetAssocRsnxe", "wpa_sm_set_assoc_rsnxe")) return false
    if (!internalFunction("esp32RecoveredWpaSmDropSa", "wpa_sm_drop_sa")) return false
    if (!internalFunction("esp32RecoveredWpaSmDeinit", "wpa_sm_deinit")) return false
    if (!internalFunction("esp32RecoveredWpaSmNotifyDisassoc", "wpa_sm_notify_disassoc")) return false
    if (!internalFunction("esp32RecoveredWpaSetBss", "wpa_set_bss")) return false
    if (!internalFunction("esp32RecoveredWpaSmPmksaCacheFlush", "wpa_sm_pmksa_cache_flush")) return false
    true
}
