import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpsEnrolleeInternals(): bool {
    if (!internalFunction("esp32RecoveredWpsEnrolleeGetMsg", "wps_enrollee_get_msg")) return false
    if (!internalFunction("esp32RecoveredWpsEnrolleeProcessMsg", "wps_enrollee_process_msg")) return false
    true
}
