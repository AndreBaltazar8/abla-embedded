import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaPmksaCacheAuthInternals(): bool {
    if (!internalFunction("esp32RecoveredPmksaCacheFreeEntry", "pmksa_cache_free_entry")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAuthFlush", "pmksa_cache_auth_flush")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAuthCreateEntry", "pmksa_cache_auth_create_entry")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAuthDeinit", "pmksa_cache_auth_deinit")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAuthGet", "pmksa_cache_auth_get")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAuthAddEntry", "pmksa_cache_auth_add_entry")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAuthAdd", "pmksa_cache_auth_add")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAuthInit", "pmksa_cache_auth_init")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAuthList", "pmksa_cache_auth_list")) return false
    true
}
