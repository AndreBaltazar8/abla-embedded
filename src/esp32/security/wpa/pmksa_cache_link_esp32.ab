import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaPmksaCacheInternals(): bool {
    if (!internalFunction("esp32RecoveredPmksaCacheFlush", "pmksa_cache_flush")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAddEntry", "pmksa_cache_add_entry")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheAdd", "pmksa_cache_add")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheDeinit", "pmksa_cache_deinit")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheGet", "pmksa_cache_get")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheGetOpportunistic", "pmksa_cache_get_opportunistic")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheGetCurrent", "pmksa_cache_get_current")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheClearCurrent", "pmksa_cache_clear_current")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheSetCurrent", "pmksa_cache_set_current")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheList", "pmksa_cache_list")) return false
    if (!internalFunction("esp32RecoveredPmksaCacheInit", "pmksa_cache_init")) return false
    true
}
