import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpaCommonInternals(): bool {
    if (!internalFunction("esp32RecoveredWpaMicLen", "wpa_mic_len")) return false
    if (!internalFunction("esp32RecoveredWpaCipherValidMgmtGroup", "wpa_cipher_valid_mgmt_group")) return false
    if (!internalFunction("esp32RecoveredWpaParseWpaIeRsnxe", "wpa_parse_wpa_ie_rsnxe")) return false
    if (!internalFunction("esp32RecoveredWpaParseWpaIeRsn", "wpa_parse_wpa_ie_rsn")) return false
    if (!internalFunction("esp32RecoveredWpaParseWpaIeWpa", "wpa_parse_wpa_ie_wpa")) return false
    if (!internalFunction("esp32RecoveredWpaUseAkmDefined", "wpa_use_akm_defined")) return false
    if (!internalFunction("esp32RecoveredWpaUseAesKeyWrap", "wpa_use_aes_key_wrap")) return false
    if (!internalFunction("esp32RecoveredWpaEapolKeyMic", "wpa_eapol_key_mic")) return false
    if (!internalFunction("esp32RecoveredWpaAkmToSuite", "wpa_akm_to_suite")) return false
    if (!internalFunction("esp32RecoveredWpaCompareRsnIe", "wpa_compare_rsn_ie")) return false
    if (!internalFunction("esp32RecoveredWpaCipherTxt", "wpa_cipher_txt")) return false
    if (!internalFunction("esp32RecoveredRsnPmkid", "rsn_pmkid")) return false
    if (!internalFunction("esp32RecoveredWpaInsertPmkid", "wpa_insert_pmkid")) return false
    if (!internalFunction("esp32RecoveredWpaCipherKeyLen", "wpa_cipher_key_len")) return false
    if (!internalFunction("esp32RecoveredWpaPmkToPtk", "wpa_pmk_to_ptk")) return false
    if (!internalFunction("esp32RecoveredWpaCipherRscLen", "wpa_cipher_rsc_len")) return false
    if (!internalFunction("esp32RecoveredWpaCipherToAlg", "wpa_cipher_to_alg")) return false
    if (!internalFunction("esp32RecoveredWpaCipherValidPairwise", "wpa_cipher_valid_pairwise")) return false
    if (!internalFunction("esp32RecoveredWpaCipherToSuite", "wpa_cipher_to_suite")) return false
    if (!internalFunction("esp32RecoveredRsnCipherPutSuites", "rsn_cipher_put_suites")) return false
    if (!internalFunction("esp32RecoveredWpaCipherPutSuites", "wpa_cipher_put_suites")) return false
    if (!internalFunction("esp32RecoveredWpaParseKdeIes", "wpa_parse_kde_ies")) return false
    if (!internalFunction("esp32RecoveredRsnSetSnonceCookie", "rsn_set_snonce_cookie")) return false
    if (!internalFunction("esp32RecoveredRsnIsSnonceCookie", "rsn_is_snonce_cookie")) return false
    true
}
