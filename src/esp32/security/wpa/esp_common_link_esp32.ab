import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaEspCommonInternals(): bool {
    if (!internalFunction("esp32RecoveredEspSupplicantStrToMac", "esp_supplicant_str_to_mac")) return false
    if (!internalFunction("esp32RecoveredEspSupplicantUnsetAllAppie", "esp_supplicant_unset_all_appie")) return false
    if (!internalFunction("esp32RecoveredEspSupplicantCommonDeinit", "esp_supplicant_common_deinit")) return false
    if (!internalFunction("esp32RecoveredEspSupplicantCommonInit", "esp_supplicant_common_init")) return false
    if (!internalFunction("esp32RecoveredSupplicantStaConnHandler", "supplicant_sta_conn_handler")) return false
    if (!internalFunction("esp32RecoveredSupplicantStaDisconnHandler", "supplicant_sta_disconn_handler")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantConnect", "wpa_supplicant_connect")) return false
    if (!internalFunction("esp32RecoveredEspGetTxPower", "esp_get_tx_power")) return false
    if (!internalFunction("esp32RecoveredWpaDrvSendAction", "wpa_drv_send_action")) return false
    if (!internalFunction("esp32RecoveredEspSetScanIe", "esp_set_scan_ie")) return false
    if (!internalFunction("esp32RecoveredEspWnmIsBtmSupportedConnection", "esp_wnm_is_btm_supported_connection")) return false
    if (!internalFunction("esp32RecoveredEspWnmSendBssTransitionMgmtQuery", "esp_wnm_send_bss_transition_mgmt_query")) return false
    if (!internalFunction("esp32RecoveredEspRrmIsRrmSupportedConnection", "esp_rrm_is_rrm_supported_connection")) return false
    if (!internalFunction("esp32RecoveredEspRrmSendNeighborReportRequest", "esp_rrm_send_neighbor_report_request")) return false
    if (!internalFunction("esp32RecoveredEspSetAssocIe", "esp_set_assoc_ie")) return false
    if (!internalFunction("esp32RecoveredMapWifiConfigSaePweToSupp", "map_wifi_config_sae_pwe_to_supp")) return false
    true
}
