import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpsDevAttrInternals(): bool {
    if (!internalFunction("esp32RecoveredWpsBuildManufacturer", "wps_build_manufacturer")) return false
    if (!internalFunction("esp32RecoveredWpsBuildModelName", "wps_build_model_name")) return false
    if (!internalFunction("esp32RecoveredWpsBuildModelNumber", "wps_build_model_number")) return false
    if (!internalFunction("esp32RecoveredWpsBuildSerialNumber", "wps_build_serial_number")) return false
    if (!internalFunction("esp32RecoveredWpsBuildPrimaryDevType", "wps_build_primary_dev_type")) return false
    if (!internalFunction("esp32RecoveredWpsBuildSecondaryDevType", "wps_build_secondary_dev_type")) return false
    if (!internalFunction("esp32RecoveredWpsBuildReqDevType", "wps_build_req_dev_type")) return false
    if (!internalFunction("esp32RecoveredWpsBuildDevName", "wps_build_dev_name")) return false
    if (!internalFunction("esp32RecoveredWpsBuildDeviceAttrs", "wps_build_device_attrs")) return false
    if (!internalFunction("esp32RecoveredWpsBuildOsVersion", "wps_build_os_version")) return false
    if (!internalFunction("esp32RecoveredWpsBuildVendorExtM1", "wps_build_vendor_ext_m1")) return false
    if (!internalFunction("esp32RecoveredWpsBuildRfBands", "wps_build_rf_bands")) return false
    if (!internalFunction("esp32RecoveredWpsBuildVendorExt", "wps_build_vendor_ext")) return false
    if (!internalFunction("esp32RecoveredWpsBuildApplicationExt", "wps_build_application_ext")) return false
    if (!internalFunction("esp32RecoveredWpsProcessDeviceAttrs", "wps_process_device_attrs")) return false
    if (!internalFunction("esp32RecoveredWpsProcessOsVersion", "wps_process_os_version")) return false
    if (!internalFunction("esp32RecoveredWpsProcessVendorExtM1", "wps_process_vendor_ext_m1")) return false
    if (!internalFunction("esp32RecoveredWpsProcessRfBands", "wps_process_rf_bands")) return false
    if (!internalFunction("esp32RecoveredWpsDeviceDataFree", "wps_device_data_free")) return false
    true
}
