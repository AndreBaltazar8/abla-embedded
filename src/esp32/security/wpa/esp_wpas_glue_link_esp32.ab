import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaEspWpasGlueInternals(): bool {
    if (!internalFunction("esp32RecoveredWpaAllocEapol", "wpa_alloc_eapol")) return false
    if (!internalFunction("esp32RecoveredWpaFreeEapol", "wpa_free_eapol")) return false
    if (!internalFunction("esp32RecoveredWpaEtherSend", "wpa_ether_send")) return false
    if (!internalFunction("esp32RecoveredHostapdSendEapol", "hostapd_send_eapol")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantTransitionDisable", "wpa_supplicant_transition_disable")) return false
    if (!internalFunction("esp32RecoveredWpaSmAllocEapol", "wpa_sm_alloc_eapol")) return false
    if (!internalFunction("esp32RecoveredWpaSmFreeEapol", "wpa_sm_free_eapol")) return false
    if (!internalFunction("esp32RecoveredWpaSmDeauthenticate", "wpa_sm_deauthenticate")) return false
    if (!internalFunction("esp32RecoveredWpaSmMlmeSetprotection", "wpa_sm_mlme_setprotection")) return false
    if (!internalFunction("esp32RecoveredWpaSmGetBeaconIe", "wpa_sm_get_beacon_ie")) return false
    if (!internalFunction("esp32RecoveredWpaSmDisassociate", "wpa_sm_disassociate")) return false
    if (!internalFunction("esp32RecoveredWpaSupplicantGetTransitionDisable", "wpa_supplicant_get_transition_disable")) return false
    true
}
