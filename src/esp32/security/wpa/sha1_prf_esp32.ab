import "crypto_mbedtls_esp32.ab"
import "../../../runtime/freestanding_memory.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

@inline
trusted fun esp32PrfStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32PrfStoreU8(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32PrfLoadU8(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

trusted fun esp32Sha1Prf(
    key: u32, keyLength: u32, label: u32, data: u32,
    dataLength: u32, output: u32, outputLength: u32
): u32 {
    val counter = u32(nativeStackAllocate(1))
    val hash = u32(nativeStackAllocate(20))
    val addresses = u32(nativeStackAllocate(12))
    val lengths = u32(nativeStackAllocate(12))
    esp32PrfStoreU8(counter, u32(0))
    esp32PrfStoreU32(addresses, label)
    esp32PrfStoreU32(addresses + u32(4), data)
    esp32PrfStoreU32(addresses + u32(8), counter)
    esp32PrfStoreU32(lengths, freestandingStringLength(label) + u32(1))
    esp32PrfStoreU32(lengths + u32(4), dataLength)
    esp32PrfStoreU32(lengths + u32(8), u32(1))

    var position = u32(0)
    while (position < outputLength) {
        val remaining = outputLength - position
        val full = remaining >= u32(20)
        val destination = if (full) output + position else hash
        val result = esp32RecoveredHmacSha1Vector(
            key,keyLength,u32(3),addresses,lengths,destination,
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        if (result != u32(0)) {
            freestandingSecureZero(hash, u32(20))
            return u32(0xffffffff)
        }
        if (!full) {
            freestandingCopy(output + position, hash, remaining)
            position = outputLength
        } else {
            position = position + u32(20)
            esp32PrfStoreU8(counter, esp32PrfLoadU8(counter) + u32(1))
        }
    }
    freestandingSecureZero(hash, u32(20))
    u32(0)
}

trusted fun esp32RecoveredSha1Prf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32Sha1Prf(a2,a3,a4,a5,a6,a7,s0)
