import "crypto_mbedtls_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

@inline
trusted fun esp32AesWrapLoad(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32AesWrapStore(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32AesWrapCopy(destination: u32, source: u32, length: u32): void {
    var index = u32(0)
    while (index < length) {
        esp32AesWrapStore(destination + index, esp32AesWrapLoad(source + index))
        index = index + u32(1)
    }
}

trusted fun esp32AesWrapXorCounter(block: u32, counter: u32): void {
    esp32AesWrapStore(block + u32(4),
        esp32AesWrapLoad(block + u32(4)) ^ (counter >>> u32(24)))
    esp32AesWrapStore(block + u32(5),
        esp32AesWrapLoad(block + u32(5)) ^ ((counter >>> u32(16)) & u32(255)))
    esp32AesWrapStore(block + u32(6),
        esp32AesWrapLoad(block + u32(6)) ^ ((counter >>> u32(8)) & u32(255)))
    esp32AesWrapStore(block + u32(7),
        esp32AesWrapLoad(block + u32(7)) ^ (counter & u32(255)))
}

trusted fun esp32AesWrap(
    key: u32, keyLength: u32, blocks: u32, plain: u32, cipher: u32
): u32 {
    var index = u32(0)
    while (index < u32(8)) {
        esp32AesWrapStore(cipher + index, u32(166))
        index = index + u32(1)
    }
    esp32AesWrapCopy(cipher + u32(8), plain, blocks << u32(3))

    val context = esp32RecoveredAesEncryptInit(key, keyLength,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (context == u32(0)) return u32(0xffffffff)
    val work = u32(nativeStackAllocate(16))
    var round = u32(0)
    while (round < u32(6)) {
        var block = u32(1)
        while (block <= blocks) {
            esp32AesWrapCopy(work, cipher, u32(8))
            val blockAddress = cipher + (block << u32(3))
            esp32AesWrapCopy(work + u32(8), blockAddress, u32(8))
            esp32RecoveredAesEncrypt(context, work, work,
                u32(0),u32(0),u32(0),u32(0),u32(0),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
            esp32AesWrapCopy(cipher, work, u32(8))
            esp32AesWrapXorCounter(cipher, round * blocks + block)
            esp32AesWrapCopy(blockAddress, work + u32(8), u32(8))
            block = block + u32(1)
        }
        round = round + u32(1)
    }
    esp32RecoveredAesEncryptDeinit(context,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    u32(0)
}

trusted fun esp32RecoveredAesWrap(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32AesWrap(a2,a3,a4,a5,a6)
