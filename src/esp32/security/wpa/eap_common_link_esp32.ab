import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaEapCommonInternals(): bool {
    if (!internalFunction("esp32RecoveredEapHdrLenValid", "eap_hdr_len_valid")) return false
    if (!internalFunction("esp32RecoveredEapHdrValidate", "eap_hdr_validate")) return false
    if (!internalFunction("esp32RecoveredEapMsgAlloc", "eap_msg_alloc")) return false
    if (!internalFunction("esp32RecoveredEapUpdateLen", "eap_update_len")) return false
    if (!internalFunction("esp32RecoveredEapGetId", "eap_get_id")) return false
    if (!internalFunction("esp32RecoveredEapGetType", "eap_get_type")) return false
    true
}
