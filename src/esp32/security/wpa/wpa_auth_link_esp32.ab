import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpaAuthInternals(): bool {
    if (!internalFunction("esp32RecoveredResendEapolHandle", "resend_eapol_handle")) return false
    if (!internalFunction("esp32RecoveredHostapEapolResendProcess", "hostap_eapol_resend_process")) return false
    if (!internalFunction("esp32RecoveredWpaAuthForEachSta", "wpa_auth_for_each_sta")) return false
    if (!internalFunction("esp32RecoveredWpaInit", "wpa_init")) return false
    if (!internalFunction("esp32RecoveredWpaAuthStaInit", "wpa_auth_sta_init")) return false
    if (!internalFunction("esp32RecoveredWpaAuthStaNoWpa", "wpa_auth_sta_no_wpa")) return false
    if (!internalFunction("esp32RecoveredWpaAuthStaDeinit", "wpa_auth_sta_deinit")) return false
    if (!internalFunction("esp32RecoveredWpaAuthPmksaAddSae", "wpa_auth_pmksa_add_sae")) return false
    if (!internalFunction("esp32RecoveredWpaAuthAddSaePmkid", "wpa_auth_add_sae_pmkid")) return false
    if (!internalFunction("esp32RecoveredWpaSendEapol", "__wpa_send_eapol")) return false
    if (!internalFunction("esp32RecoveredWpaRemovePtk", "wpa_remove_ptk")) return false
    if (!internalFunction("esp32RecoveredWpaAuthStaAssociated", "wpa_auth_sta_associated")) return false
    if (!internalFunction("esp32RecoveredWpaReceive", "wpa_receive")) return false
    if (!internalFunction("esp32RecoveredWpaAuthSmEvent", "wpa_auth_sm_event")) return false
    if (!internalFunction("esp32RecoveredWpaDeinit", "wpa_deinit")) return false
    if (!internalFunction("esp32RecoveredWpaAuthPmksaRemove", "wpa_auth_pmksa_remove")) return false
    if (!internalFunction("esp32RecoveredWpaAuthUsesSae", "wpa_auth_uses_sae")) return false
    true
}
