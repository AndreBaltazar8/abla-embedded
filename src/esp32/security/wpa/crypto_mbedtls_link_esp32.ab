import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaCryptoMbedtlsInternals(): bool {
    if (!internalFunction("esp32RecoveredSha256Vector", "sha256_vector")) return false
    if (!internalFunction("esp32RecoveredSha384Vector", "sha384_vector")) return false
    if (!internalFunction("esp32RecoveredSha512Vector", "sha512_vector")) return false
    if (!internalFunction("esp32RecoveredSha1Vector", "sha1_vector")) return false
    if (!internalFunction("esp32RecoveredMd5Vector", "md5_vector")) return false
    if (!internalFunction("esp32RecoveredCryptoHashInit", "crypto_hash_init")) return false
    if (!internalFunction("esp32RecoveredCryptoHashUpdate", "crypto_hash_update")) return false
    if (!internalFunction("esp32RecoveredCryptoHashFinish", "crypto_hash_finish")) return false
    if (!internalFunction("esp32RecoveredHmacSha384Vector", "hmac_sha384_vector")) return false
    if (!internalFunction("esp32RecoveredHmacSha384", "hmac_sha384")) return false
    if (!internalFunction("esp32RecoveredHmacSha256Vector", "hmac_sha256_vector")) return false
    if (!internalFunction("esp32RecoveredHmacSha256", "hmac_sha256")) return false
    if (!internalFunction("esp32RecoveredHmacMd5Vector", "hmac_md5_vector")) return false
    if (!internalFunction("esp32RecoveredHmacMd5", "hmac_md5")) return false
    if (!internalFunction("esp32RecoveredHmacSha1Vector", "hmac_sha1_vector")) return false
    if (!internalFunction("esp32RecoveredHmacSha1", "hmac_sha1")) return false
    if (!internalFunction("esp32RecoveredAesEncryptInit", "aes_encrypt_init")) return false
    if (!internalFunction("esp32RecoveredAesEncrypt", "aes_encrypt")) return false
    if (!internalFunction("esp32RecoveredAesEncryptDeinit", "aes_encrypt_deinit")) return false
    if (!internalFunction("esp32RecoveredAesDecryptInit", "aes_decrypt_init")) return false
    if (!internalFunction("esp32RecoveredAesDecrypt", "aes_decrypt")) return false
    if (!internalFunction("esp32RecoveredAesDecryptDeinit", "aes_decrypt_deinit")) return false
    if (!internalFunction("esp32RecoveredAes128CbcEncrypt", "aes_128_cbc_encrypt")) return false
    if (!internalFunction("esp32RecoveredAes128CbcDecrypt", "aes_128_cbc_decrypt")) return false
    if (!internalFunction("esp32RecoveredCryptoCipherInit", "crypto_cipher_init")) return false
    if (!internalFunction("esp32RecoveredCryptoCipherEncrypt", "crypto_cipher_encrypt")) return false
    if (!internalFunction("esp32RecoveredCryptoCipherDecrypt", "crypto_cipher_decrypt")) return false
    if (!internalFunction("esp32RecoveredCryptoCipherDeinit", "crypto_cipher_deinit")) return false
    if (!internalFunction("esp32RecoveredAesCtrEncrypt", "aes_ctr_encrypt")) return false
    if (!internalFunction("esp32RecoveredAes128CtrEncrypt", "aes_128_ctr_encrypt")) return false
    if (!internalFunction("esp32RecoveredCryptoModExp", "crypto_mod_exp")) return false
    if (!internalFunction("esp32RecoveredPbkdf2Sha1", "pbkdf2_sha1")) return false
    if (!internalFunction("esp32RecoveredOmac1AesVector", "omac1_aes_vector")) return false
    if (!internalFunction("esp32RecoveredOmac1Aes128Vector", "omac1_aes_128_vector")) return false
    if (!internalFunction("esp32RecoveredOmac1Aes128", "omac1_aes_128")) return false
    if (!internalFunction("esp32RecoveredCryptoDhInit", "crypto_dh_init")) return false
    if (!internalFunction("esp32RecoveredCryptoGlobalInit", "crypto_global_init")) return false
    if (!internalFunction("esp32RecoveredCryptoGlobalDeinit", "crypto_global_deinit")) return false
    true
}
