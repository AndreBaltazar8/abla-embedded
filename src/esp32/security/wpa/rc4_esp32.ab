import "abla/runtime/self"
import "abla/unsafe/memory"

@inline
trusted fun esp32Rc4Load(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32Rc4Store(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32Rc4Swap(state: u32, first: u32, second: u32): void {
    val firstValue = esp32Rc4Load(state + first)
    val secondValue = esp32Rc4Load(state + second)
    esp32Rc4Store(state + first, secondValue)
    esp32Rc4Store(state + second, firstValue)
}

trusted fun esp32Rc4Skip(
    key: u32, keyLength: u32, skip: u32, data: u32, dataLength: u32
): u32 {
    if (keyLength == u32(0)) return u32(0xffffffff)
    val state = u32(nativeStackAllocate(256))
    var index = u32(0)
    while (index < u32(256)) {
        esp32Rc4Store(state + index, index)
        index = index + u32(1)
    }

    var j = u32(0)
    var keyIndex = u32(0)
    index = u32(0)
    while (index < u32(256)) {
        j = (j + esp32Rc4Load(state + index) +
            esp32Rc4Load(key + keyIndex)) & u32(255)
        esp32Rc4Swap(state, index, j)
        keyIndex = keyIndex + u32(1)
        if (keyIndex == keyLength) keyIndex = u32(0)
        index = index + u32(1)
    }

    var i = u32(0)
    j = u32(0)
    var discarded = u32(0)
    while (discarded < skip) {
        i = (i + u32(1)) & u32(255)
        j = (j + esp32Rc4Load(state + i)) & u32(255)
        esp32Rc4Swap(state, i, j)
        discarded = discarded + u32(1)
    }

    index = u32(0)
    while (index < dataLength) {
        i = (i + u32(1)) & u32(255)
        j = (j + esp32Rc4Load(state + i)) & u32(255)
        esp32Rc4Swap(state, i, j)
        val streamIndex = (esp32Rc4Load(state + i) +
            esp32Rc4Load(state + j)) & u32(255)
        esp32Rc4Store(data + index,
            esp32Rc4Load(data + index) ^ esp32Rc4Load(state + streamIndex))
        index = index + u32(1)
    }
    u32(0)
}

trusted fun esp32RecoveredRc4Skip(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32Rc4Skip(a2,a3,a4,a5,a6)
