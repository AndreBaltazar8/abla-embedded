import "eap_common_esp32.ab"
import "wpabuf_esp32.ab"
import "abla/unsafe/memory"

// Build the two-byte WSC fragment acknowledgement payload.
trusted fun esp32EapWscBuildFragAck(identifier: u32, code: u32): u32 {
    val message = esp32RecoveredEapMsgAlloc(
        u32(14122), u32(1), u32(2), code & u32(255),
        identifier & u32(255), u32(0), u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (message == u32(0)) return u32(0)

    val opcode = esp32RecoveredWpabufPut(message, u32(1),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(opcode)), int(u32(6)))
    val flags = esp32RecoveredWpabufPut(message, u32(1),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(flags)), int(u32(0)))
    message
}

trusted fun esp32RecoveredEapWscBuildFragAck(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32EapWscBuildFragAck(a2, a3)
