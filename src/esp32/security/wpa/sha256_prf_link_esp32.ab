import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaSha256PrfInternals(): bool {
    if (!internalFunction("esp32Sha256PrfBits", "sha256_prf_bits")) return false
    if (!internalFunction("esp32Sha256Prf", "sha256_prf")) return false
    true
}
