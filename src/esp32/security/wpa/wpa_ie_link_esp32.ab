import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpaIeInternals(): bool {
    if (!internalFunction("esp32RecoveredWpaParseWpaIe", "wpa_parse_wpa_ie")) return false
    if (!internalFunction("esp32RecoveredWpaGenWpaIe", "wpa_gen_wpa_ie")) return false
    if (!internalFunction("esp32RecoveredWpaGenRsnxe", "wpa_gen_rsnxe")) return false
    true
}
