import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpaAuthIeInternals(): bool {
    if (!internalFunction("esp32RecoveredWpaWriteRsnIe", "wpa_write_rsn_ie")) return false
    if (!internalFunction("esp32RecoveredWpaWriteRsnxe", "wpa_write_rsnxe")) return false
    if (!internalFunction("esp32RecoveredWpaAuthGenWpaIe", "wpa_auth_gen_wpa_ie")) return false
    if (!internalFunction("esp32RecoveredWpaAddKde", "wpa_add_kde")) return false
    if (!internalFunction("esp32RecoveredWpaValidateWpaIe", "wpa_validate_wpa_ie")) return false
    if (!internalFunction("esp32RecoveredWpaAuthUsesMfp", "wpa_auth_uses_mfp")) return false
    true
}
