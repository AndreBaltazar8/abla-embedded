import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaEloopInternals(): bool {
    if (!internalFunction("esp32RecoveredEloopInit", "eloop_init")) return false
    if (!internalFunction("esp32RecoveredEloopRegisterTimeout", "eloop_register_timeout")) return false
    if (!internalFunction("esp32RecoveredEloopRegisterTimeoutBlocking", "eloop_register_timeout_blocking")) return false
    if (!internalFunction("esp32RecoveredEloopCancelTimeout", "eloop_cancel_timeout")) return false
    if (!internalFunction("esp32RecoveredEloopCancelTimeoutOne", "eloop_cancel_timeout_one")) return false
    if (!internalFunction("esp32RecoveredEloopIsTimeoutRegistered", "eloop_is_timeout_registered")) return false
    if (!internalFunction("esp32RecoveredEloopDepleteTimeout", "eloop_deplete_timeout")) return false
    if (!internalFunction("esp32RecoveredEloopReplenishTimeout", "eloop_replenish_timeout")) return false
    if (!internalFunction("esp32RecoveredEloopRun", "eloop_run")) return false
    if (!internalFunction("esp32RecoveredEloopDestroy", "eloop_destroy")) return false
    true
}
