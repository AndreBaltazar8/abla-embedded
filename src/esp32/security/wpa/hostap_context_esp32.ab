// Abla-owned hostapd application context.  The ESP-IDF implementation uses
// the same single mutable pointer; keeping it here makes reads and writes
// visible to LLVM and avoids an externally linked accessor function.

var esp32HostapdContext: u32 = u32(0)

trusted fun esp32HostapdSetContext(context: u32): void {
    esp32HostapdContext = context
    return
}

trusted fun esp32HostapdGetContext(): u32 = esp32HostapdContext
