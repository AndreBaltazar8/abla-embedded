import "sha1_prf_esp32.ab"

trusted fun esp32Sha256PrfBits(
    key: u32, keyLength: u32, label: u32, data: u32,
    dataLength: u32, output: u32, outputBits: u32
): u32 {
    val counterBytes = u32(nativeStackAllocate(2))
    val lengthBytes = u32(nativeStackAllocate(2))
    val hash = u32(nativeStackAllocate(32))
    val addresses = u32(nativeStackAllocate(16))
    val lengths = u32(nativeStackAllocate(16))
    val outputLength = (outputBits + u32(7)) >>> u32(3)

    esp32PrfStoreU32(addresses, counterBytes)
    esp32PrfStoreU32(addresses + u32(4), label)
    esp32PrfStoreU32(addresses + u32(8), data)
    esp32PrfStoreU32(addresses + u32(12), lengthBytes)
    esp32PrfStoreU32(lengths, u32(2))
    esp32PrfStoreU32(lengths + u32(4), freestandingStringLength(label))
    esp32PrfStoreU32(lengths + u32(8), dataLength)
    esp32PrfStoreU32(lengths + u32(12), u32(2))
    esp32PrfStoreU8(lengthBytes, outputBits & u32(255))
    esp32PrfStoreU8(lengthBytes + u32(1),
        (outputBits >>> u32(8)) & u32(255))

    var position = u32(0)
    var counter = u32(1)
    while (position < outputLength) {
        esp32PrfStoreU8(counterBytes, counter & u32(255))
        esp32PrfStoreU8(counterBytes + u32(1),
            (counter >>> u32(8)) & u32(255))
        val remaining = outputLength - position
        val full = remaining >= u32(32)
        val destination = if (full) output + position else hash
        val result = esp32RecoveredHmacSha256Vector(
            key,keyLength,u32(4),addresses,lengths,destination,
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        if (i32(result) < 0) {
            freestandingSecureZero(hash, u32(32))
            return u32(0xffffffff)
        }
        if (!full) {
            freestandingCopy(output + position, hash, remaining)
            position = outputLength
        } else {
            position = position + u32(32)
            counter = (counter + u32(1)) & u32(65535)
        }
    }

    val remainderBits = outputBits & u32(7)
    if (position != u32(0) && remainderBits != u32(0)) {
        val last = output + position - u32(1)
        esp32PrfStoreU8(last, esp32PrfLoadU8(last) &
            (u32(255) << (u32(8) - remainderBits)))
    }
    freestandingSecureZero(hash, u32(32))
    u32(0)
}

trusted fun esp32Sha256Prf(
    key:u32,keyLength:u32,label:u32,data:u32,dataLength:u32,
    output:u32,outputLength:u32
):u32=esp32Sha256PrfBits(key,keyLength,label,data,dataLength,output,
    outputLength << u32(3))

trusted fun esp32RecoveredSha256PrfBits(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32Sha256PrfBits(a2,a3,a4,a5,a6,a7,s0)
trusted fun esp32RecoveredSha256Prf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32Sha256Prf(a2,a3,a4,a5,a6,a7,s0)
