import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpaDebugInternals(): bool {
    if (!internalFunction("esp32WpaSnprintfHexUppercase", "wpa_snprintf_hex_uppercase")) return false
    if (!internalFunction("esp32WpaSnprintfHex", "wpa_snprintf_hex")) return false
    true
}
