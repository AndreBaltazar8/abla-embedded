import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaDhGroupsInternals(): bool {
    if (!internalFunction("esp32DhGroupsGet", "dh_groups_get")) return false
    if (!internalFunction("esp32DhInitialize", "dh_init")) return false
    if (!internalFunction("esp32DhDeriveShared", "dh_derive_shared")) return false
    true
}
