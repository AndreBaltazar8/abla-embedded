import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaDhGroup5Internals(): bool {
    if (!internalFunction("esp32Dh5Init", "dh5_init")) return false
    if (!internalFunction("esp32Dh5InitFixed", "dh5_init_fixed")) return false
    if (!internalFunction("esp32Dh5DeriveShared", "dh5_derive_shared")) return false
    if (!internalFunction("esp32Dh5Free", "dh5_free")) return false
    true
}
