import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpsInternals(): bool {
    if (!internalFunction("esp32RecoveredWpsInit", "wps_init")) return false
    if (!internalFunction("esp32RecoveredWpsDeinit", "wps_deinit")) return false
    if (!internalFunction("esp32RecoveredWpsProcessMsg", "wps_process_msg")) return false
    if (!internalFunction("esp32RecoveredWpsGetMsg", "wps_get_msg")) return false
    if (!internalFunction("esp32RecoveredWpsIsSelectedPbcRegistrar", "wps_is_selected_pbc_registrar")) return false
    if (!internalFunction("esp32RecoveredWpsIsSelectedPinRegistrar", "wps_is_selected_pin_registrar")) return false
    if (!internalFunction("esp32RecoveredWpsIsAddrAuthorized", "wps_is_addr_authorized")) return false
    if (!internalFunction("esp32RecoveredWpsApPriorityCompar", "wps_ap_priority_compar")) return false
    if (!internalFunction("esp32RecoveredWpsGetUuidE", "wps_get_uuid_e")) return false
    if (!internalFunction("esp32RecoveredWpsIs20", "wps_is_20")) return false
    if (!internalFunction("esp32RecoveredWpsBuildAssocReqIe", "wps_build_assoc_req_ie")) return false
    if (!internalFunction("esp32RecoveredWpsBuildAssocRespIe", "wps_build_assoc_resp_ie")) return false
    if (!internalFunction("esp32RecoveredWpsBuildProbeReqIe", "wps_build_probe_req_ie")) return false
    if (!internalFunction("esp32RecoveredWpsAttrText", "wps_attr_text")) return false
    true
}
