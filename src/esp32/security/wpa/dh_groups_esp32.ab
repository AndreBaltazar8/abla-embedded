import "../../../runtime/freestanding_memory.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

// Structured Abla implementation of ESP-IDF's dh_groups.c. The ESP32 WPA
// configuration contains only RFC 3526 group 5.
val esp32DhGroup5GeneratorStorage = nativeStaticBytes("\x02")
val esp32DhGroup5Generator = u32(esp32DhGroup5GeneratorStorage)

val esp32DhGroup5PrimeStorage = nativeStaticBytes(
    (
        "\xff\xff\xff\xff\xff\xff\xff\xff\xc9\x0f\xda\xa2\x21\x68\xc2\x34\xc4\xc6\x62\x8b\x80\xdc\x1c\xd1\x29\x02\x4e\x08\x8a\x67\xcc\x74" +
        "\x02\x0b\xbe\xa6\x3b\x13\x9b\x22\x51\x4a\x08\x79\x8e\x34\x04\xdd\xef\x95\x19\xb3\xcd\x3a\x43\x1b\x30\x2b\x0a\x6d\xf2\x5f\x14\x37" +
        "\x4f\xe1\x35\x6d\x6d\x51\xc2\x45\xe4\x85\xb5\x76\x62\x5e\x7e\xc6\xf4\x4c\x42\xe9\xa6\x37\xed\x6b\x0b\xff\x5c\xb6\xf4\x06\xb7\xed" +
        "\xee\x38\x6b\xfb\x5a\x89\x9f\xa5\xae\x9f\x24\x11\x7c\x4b\x1f\xe6\x49\x28\x66\x51\xec\xe4\x5b\x3d\xc2\x00\x7c\xb8\xa1\x63\xbf\x05" +
        "\x98\xda\x48\x36\x1c\x55\xd3\x9a\x69\x16\x3f\xa8\xfd\x24\xcf\x5f\x83\x65\x5d\x23\xdc\xa3\xad\x96\x1c\x62\xf3\x56\x20\x85\x52\xbb" +
        "\x9e\xd5\x29\x07\x70\x96\x96\x6d\x67\x0c\x35\x4e\x4a\xbc\x98\x04\xf1\x74\x6c\x08\xca\x23\x73\x27\xff\xff\xff\xff\xff\xff\xff\xff"
    )
)
val esp32DhGroup5Prime = u32(esp32DhGroup5PrimeStorage)

val esp32DhGroup5OrderStorage = nativeStaticBytes(
    (
        "\x7f\xff\xff\xff\xff\xff\xff\xff\xe4\x87\xed\x51\x10\xb4\x61\x1a\x62\x63\x31\x45\xc0\x6e\x0e\x68\x94\x81\x27\x04\x45\x33\xe6\x3a" +
        "\x01\x05\xdf\x53\x1d\x89\xcd\x91\x28\xa5\x04\x3c\xc7\x1a\x02\x6e\xf7\xca\x8c\xd9\xe6\x9d\x21\x8d\x98\x15\x85\x36\xf9\x2f\x8a\x1b" +
        "\xa7\xf0\x9a\xb6\xb6\xa8\xe1\x22\xf2\x42\xda\xbb\x31\x2f\x3f\x63\x7a\x26\x21\x74\xd3\x1b\xf6\xb5\x85\xff\xae\x5b\x7a\x03\x5b\xf6" +
        "\xf7\x1c\x35\xfd\xad\x44\xcf\xd2\xd7\x4f\x92\x08\xbe\x25\x8f\xf3\x24\x94\x33\x28\xf6\x72\x2d\x9e\xe1\x00\x3e\x5c\x50\xb1\xdf\x82" +
        "\xcc\x6d\x24\x1b\x0e\x2a\xe9\xcd\x34\x8b\x1f\xd4\x7e\x92\x67\xaf\xc1\xb2\xae\x91\xee\x51\xd6\xcb\x0e\x31\x79\xab\x10\x42\xa9\x5d" +
        "\xcf\x6a\x94\x83\xb8\x4b\x4b\x36\xb3\x86\x1a\xa7\x25\x5e\x4c\x02\x78\xba\x36\x04\x65\x11\xb9\x93\xff\xff\xff\xff\xff\xff\xff\xff"
    )
)
val esp32DhGroup5Order = u32(esp32DhGroup5OrderStorage)

// struct dh_group: id, generator, generator_len, prime, prime_len, order,
// order_len, safe_prime.
val esp32DhGroup5DescriptorStorage = nativeStaticU32s([
    5, int(esp32DhGroup5Generator), 1,
    int(esp32DhGroup5Prime), 192,
    int(esp32DhGroup5Order), 192, 1
])
val esp32DhGroup5Descriptor = u32(esp32DhGroup5DescriptorStorage)

@inline
trusted fun esp32DhLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32DhStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32DhStoreU8(address:u32, value:u32):void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32DhWpabufHead(buffer:u32):u32 = esp32DhLoadU32(buffer + u32(8))

@inline
trusted fun esp32DhWpabufLength(buffer:u32):u32 = esp32DhLoadU32(buffer + u32(4))

trusted fun esp32DhWpabufAlloc(length:u32):u32 = esp32RecoveredWpabufAlloc(
    length,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

trusted fun esp32DhWpabufFree(buffer:u32):void {
    esp32RecoveredWpabufFree(buffer,u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}

trusted fun esp32DhWpabufPut(buffer:u32, length:u32):u32 = esp32RecoveredWpabufPut(
    buffer,length,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

trusted fun esp32DhModExp(
    base:u32, baseLength:u32, exponent:u32, exponentLength:u32,
    modulus:u32, modulusLength:u32, output:u32, outputLength:u32
):u32 = esp32RecoveredCryptoModExp(
    base,baseLength,exponent,exponentLength,modulus,modulusLength,
    output,outputLength,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

trusted fun esp32DhGroupsGet(id:u32):u32 =
    if (id == u32(5)) esp32DhGroup5Descriptor else u32(0)

trusted fun esp32DhInitialize(group:u32, privateOutput:u32):u32 {
    if (group == u32(0)) return u32(0)
    esp32DhWpabufFree(esp32DhLoadU32(privateOutput))
    val prime = esp32DhLoadU32(group + u32(12))
    val primeLength = esp32DhLoadU32(group + u32(16))
    val privateBuffer = esp32DhWpabufAlloc(primeLength)
    esp32DhStoreU32(privateOutput, privateBuffer)
    if (privateBuffer == u32(0)) return u32(0)

    val privateBytes = esp32DhWpabufPut(privateBuffer, primeLength)
    if (esp32WpaGetRandom(privateBytes, primeLength) != u32(0)) {
        esp32DhWpabufFree(privateBuffer)
        esp32DhStoreU32(privateOutput, u32(0))
        return u32(0)
    }
    if (i32(freestandingCompare(privateBytes, prime, primeLength)) > i32(0)) {
        esp32DhStoreU8(privateBytes, u32(0))
    }

    val publicBuffer = esp32DhWpabufAlloc(primeLength)
    if (publicBuffer == u32(0)) {
        esp32DhWpabufFree(privateBuffer)
        esp32DhStoreU32(privateOutput, u32(0))
        return u32(0)
    }
    val publicLengthAddress = u32(nativeStackAllocate(4))
    esp32DhStoreU32(publicLengthAddress, primeLength)
    val status = esp32DhModExp(
        esp32DhLoadU32(group + u32(4)), esp32DhLoadU32(group + u32(8)),
        esp32DhWpabufHead(privateBuffer), esp32DhWpabufLength(privateBuffer),
        prime, primeLength, esp32DhWpabufHead(publicBuffer), publicLengthAddress)
    if (status != u32(0)) {
        esp32DhWpabufFree(publicBuffer)
        return u32(0)
    }
    esp32DhWpabufPut(publicBuffer, esp32DhLoadU32(publicLengthAddress))
    publicBuffer
}

trusted fun esp32DhDeriveShared(peerPublic:u32, ownPrivate:u32, group:u32):u32 {
    if (peerPublic == u32(0) || ownPrivate == u32(0) || group == u32(0)) {
        return u32(0)
    }
    val prime = esp32DhLoadU32(group + u32(12))
    val primeLength = esp32DhLoadU32(group + u32(16))
    val shared = esp32DhWpabufAlloc(primeLength)
    if (shared == u32(0)) return u32(0)

    val sharedLengthAddress = u32(nativeStackAllocate(4))
    esp32DhStoreU32(sharedLengthAddress, primeLength)
    val status = esp32DhModExp(
        esp32DhWpabufHead(peerPublic), esp32DhWpabufLength(peerPublic),
        esp32DhWpabufHead(ownPrivate), esp32DhWpabufLength(ownPrivate),
        prime, primeLength, esp32DhWpabufHead(shared), sharedLengthAddress)
    if (status != u32(0)) {
        esp32DhWpabufFree(shared)
        return u32(0)
    }
    esp32DhWpabufPut(shared, esp32DhLoadU32(sharedLengthAddress))
    shared
}
