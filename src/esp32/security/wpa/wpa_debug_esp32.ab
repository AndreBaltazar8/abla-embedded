import "abla/unsafe/memory"

@inline
trusted fun esp32WpaHexLoad(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32WpaHexStore(address:u32, value:u32):void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
fun esp32WpaHexDigit(nibble:u32, uppercase:bool):u32 {
    if (nibble < u32(10)) return u32(48) + nibble
    if (uppercase) u32(55) + nibble else u32(87) + nibble
}

trusted fun esp32WpaSnprintfHexInternal(
    buffer:u32, bufferSize:u32, data:u32, length:u32,
    uppercase:bool, whitespace:bool
):u32 {
    if (bufferSize == u32(0)) return u32(0)
    val end = buffer + bufferSize
    val width = if (whitespace) u32(3) else u32(2)
    var cursor = buffer
    var index = u32(0)
    while (index < length) {
        // snprintf needs one byte beyond the formatted characters for NUL.
        if (end - cursor <= width) {
            esp32WpaHexStore(end - u32(1), u32(0))
            return cursor - buffer
        }
        val byte = esp32WpaHexLoad(data + index)
        esp32WpaHexStore(cursor,
            esp32WpaHexDigit((byte >>> u32(4)) & u32(15), uppercase))
        esp32WpaHexStore(cursor + u32(1),
            esp32WpaHexDigit(byte & u32(15), uppercase))
        if (whitespace) esp32WpaHexStore(cursor + u32(2), u32(32))
        cursor = cursor + width
        esp32WpaHexStore(cursor, u32(0))
        index = index + u32(1)
    }
    esp32WpaHexStore(end - u32(1), u32(0))
    cursor - buffer
}

trusted fun esp32WpaSnprintfHexUppercase(
    buffer:u32, bufferSize:u32, data:u32, length:u32
):u32 = esp32WpaSnprintfHexInternal(
    buffer, bufferSize, data, length, true, false)

trusted fun esp32WpaSnprintfHex(
    buffer:u32, bufferSize:u32, data:u32, length:u32
):u32 = esp32WpaSnprintfHexInternal(
    buffer, bufferSize, data, length, false, false)

trusted fun esp32RecoveredWpaSnprintfHexUppercase(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32WpaSnprintfHexUppercase(a2,a3,a4,a5)

trusted fun esp32RecoveredWpaSnprintfHex(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32WpaSnprintfHex(a2,a3,a4,a5)
