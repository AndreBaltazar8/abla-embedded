import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpabufInternals(): bool {
    if (!internalFunction("esp32RecoveredWpabufAlloc", "wpabuf_alloc")) return false
    if (!internalFunction("esp32RecoveredWpabufResize", "wpabuf_resize")) return false
    if (!internalFunction("esp32RecoveredWpabufAllocExtData", "wpabuf_alloc_ext_data")) return false
    if (!internalFunction("esp32RecoveredWpabufFree", "wpabuf_free")) return false
    if (!internalFunction("esp32RecoveredWpabufClearFree", "wpabuf_clear_free")) return false
    if (!internalFunction("esp32RecoveredWpabufPut", "wpabuf_put")) return false
    if (!internalFunction("esp32RecoveredWpabufAllocCopy", "wpabuf_alloc_copy")) return false
    if (!internalFunction("esp32RecoveredWpabufDup", "wpabuf_dup")) return false
    if (!internalFunction("esp32RecoveredWpabufConcat", "wpabuf_concat")) return false
    if (!internalFunction("esp32RecoveredWpabufZeropad", "wpabuf_zeropad")) return false
    if (!internalFunction("esp32RecoveredWpabufPrintf", "wpabuf_printf")) return false
    true
}
