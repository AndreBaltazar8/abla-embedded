import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaEspWpsInternals(): bool {
    if (!internalFunction("esp32RecoveredWifiStationWpsEapolStartHandle", "wifi_station_wps_eapol_start_handle")) return false
    if (!internalFunction("esp32RecoveredWpsSetFactoryInfo", "wps_set_factory_info")) return false
    if (!internalFunction("esp32RecoveredWpsDevDeinit", "wps_dev_deinit")) return false
    if (!internalFunction("esp32RecoveredWpsInitCfgPin", "wps_init_cfg_pin")) return false
    if (!internalFunction("esp32RecoveredWpsGetWpsSmCb", "wps_get_wps_sm_cb")) return false
    if (!internalFunction("esp32RecoveredWpsSmGet", "wps_sm_get")) return false
    if (!internalFunction("esp32RecoveredWpsStartMsgTimer", "wps_start_msg_timer")) return false
    if (!internalFunction("esp32RecoveredWpsDevInit", "wps_dev_init")) return false
    if (!internalFunction("esp32RecoveredWpsGetOwner", "wps_get_owner")) return false
    if (!internalFunction("esp32RecoveredEspWifiWpsEnable", "esp_wifi_wps_enable")) return false
    if (!internalFunction("esp32RecoveredWpsSetOwner", "wps_set_owner")) return false
    if (!internalFunction("esp32RecoveredEspWifiWpsDisable", "esp_wifi_wps_disable")) return false
    if (!internalFunction("esp32RecoveredEspWifiWpsStart", "esp_wifi_wps_start")) return false
    true
}
