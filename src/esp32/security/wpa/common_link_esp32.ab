import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaCommonInternals(): bool {
    if (!internalFunction("esp32RecoveredHex2byte", "hex2byte")) return false
    if (!internalFunction("esp32RecoveredHwaddrAton2", "hwaddr_aton2")) return false
    if (!internalFunction("esp32RecoveredHexstr2bin", "hexstr2bin")) return false
    if (!internalFunction("esp32RecoveredIncByteArray", "inc_byte_array")) return false
    if (!internalFunction("esp32RecoveredBufShiftRight", "buf_shift_right")) return false
    if (!internalFunction("esp32RecoveredWpaGetNtpTimestamp", "wpa_get_ntp_timestamp")) return false
    if (!internalFunction("esp32RecoveredPrintfEncode", "printf_encode")) return false
    if (!internalFunction("esp32RecoveredPrintfDecode", "printf_decode")) return false
    if (!internalFunction("esp32RecoveredWpaSsidTxt", "wpa_ssid_txt")) return false
    if (!internalFunction("esp32RecoveredHideAliasingTypecast", "__hide_aliasing_typecast")) return false
    if (!internalFunction("esp32RecoveredWpaIsHex", "wpa_is_hex")) return false
    if (!internalFunction("esp32RecoveredHasCtrlChar", "has_ctrl_char")) return false
    if (!internalFunction("esp32RecoveredWpaMergeByteArrays", "wpa_merge_byte_arrays")) return false
    if (!internalFunction("esp32RecoveredDupBinstr", "dup_binstr")) return false
    if (!internalFunction("esp32RecoveredWpaConfigParseString", "wpa_config_parse_string")) return false
    if (!internalFunction("esp32RecoveredIntArrayLen", "int_array_len")) return false
    if (!internalFunction("esp32RecoveredStrClearFree", "str_clear_free")) return false
    if (!internalFunction("esp32RecoveredBinClearFree", "bin_clear_free")) return false
    if (!internalFunction("esp32RecoveredOsGmtime", "os_gmtime")) return false
    if (!internalFunction("esp32RecoveredOsMktime", "os_mktime")) return false
    if (!internalFunction("esp32RecoveredOsMemdup", "os_memdup")) return false
    if (!internalFunction("esp32RecoveredOsReltimeExpired", "os_reltime_expired")) return false
    if (!internalFunction("esp32RecoveredOsReltimeInitialized", "os_reltime_initialized")) return false
    if (!internalFunction("esp32RecoveredOsReltimeAddMs", "os_reltime_add_ms")) return false
    if (!internalFunction("esp32RecoveredOsReltimeInMs", "os_reltime_in_ms")) return false
    if (!internalFunction("esp32RecoveredRssiToRcpi", "rssi_to_rcpi")) return false
    if (!internalFunction("esp32RecoveredGetParam", "get_param")) return false
    true
}
