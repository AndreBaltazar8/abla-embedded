import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpsAttrBuildInternals(): bool {
    if (!internalFunction("esp32RecoveredWpsBuildPublicKey", "wps_build_public_key")) return false
    if (!internalFunction("esp32RecoveredWpsBuildReqType", "wps_build_req_type")) return false
    if (!internalFunction("esp32RecoveredWpsBuildRespType", "wps_build_resp_type")) return false
    if (!internalFunction("esp32RecoveredWpsBuildConfigMethods", "wps_build_config_methods")) return false
    if (!internalFunction("esp32RecoveredWpsBuildUuidE", "wps_build_uuid_e")) return false
    if (!internalFunction("esp32RecoveredWpsBuildDevPasswordId", "wps_build_dev_password_id")) return false
    if (!internalFunction("esp32RecoveredWpsBuildConfigError", "wps_build_config_error")) return false
    if (!internalFunction("esp32RecoveredWpsBuildAuthenticator", "wps_build_authenticator")) return false
    if (!internalFunction("esp32RecoveredWpsBuildVersion", "wps_build_version")) return false
    if (!internalFunction("esp32RecoveredWpsBuildWfaExt", "wps_build_wfa_ext")) return false
    if (!internalFunction("esp32RecoveredWpsBuildMsgType", "wps_build_msg_type")) return false
    if (!internalFunction("esp32RecoveredWpsBuildEnrolleeNonce", "wps_build_enrollee_nonce")) return false
    if (!internalFunction("esp32RecoveredWpsBuildRegistrarNonce", "wps_build_registrar_nonce")) return false
    if (!internalFunction("esp32RecoveredWpsBuildAuthTypeFlags", "wps_build_auth_type_flags")) return false
    if (!internalFunction("esp32RecoveredWpsBuildEncrTypeFlags", "wps_build_encr_type_flags")) return false
    if (!internalFunction("esp32RecoveredWpsBuildConnTypeFlags", "wps_build_conn_type_flags")) return false
    if (!internalFunction("esp32RecoveredWpsBuildAssocState", "wps_build_assoc_state")) return false
    if (!internalFunction("esp32RecoveredWpsBuildKeyWrapAuth", "wps_build_key_wrap_auth")) return false
    if (!internalFunction("esp32RecoveredWpsBuildEncrSettings", "wps_build_encr_settings")) return false
    if (!internalFunction("esp32RecoveredWpsIeEncapsulate", "wps_ie_encapsulate")) return false
    if (!internalFunction("esp32RecoveredWpsBuildMacAddr", "wps_build_mac_addr")) return false
    if (!internalFunction("esp32RecoveredWpsBuildRfBandsAttr", "wps_build_rf_bands_attr")) return false
    if (!internalFunction("esp32RecoveredWpsBuildApChannel", "wps_build_ap_channel")) return false
    true
}
