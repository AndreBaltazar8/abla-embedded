import "aes_wrap_esp32.ab"

trusted fun esp32AesUnwrap(
    key: u32, keyLength: u32, blocks: u32, cipher: u32, plain: u32
): u32 {
    val accumulator = u32(nativeStackAllocate(8))
    esp32AesWrapCopy(accumulator, cipher, u32(8))
    esp32AesWrapCopy(plain, cipher + u32(8), blocks << u32(3))

    val context = esp32RecoveredAesDecryptInit(key, keyLength,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (context == u32(0)) return u32(0xffffffff)
    val input = u32(nativeStackAllocate(16))
    val output = u32(nativeStackAllocate(16))
    var round = i32(5)
    while (round >= 0) {
        var block = i32(blocks)
        while (block >= 1) {
            esp32AesWrapCopy(input, accumulator, u32(8))
            esp32AesWrapXorCounter(input, u32(round) * blocks + u32(block))
            val blockAddress = plain + (u32(block - i32(1)) << u32(3))
            esp32AesWrapCopy(input + u32(8), blockAddress, u32(8))
            esp32RecoveredAesDecrypt(context, input, output,
                u32(0),u32(0),u32(0),u32(0),u32(0),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
            esp32AesWrapCopy(accumulator, output, u32(8))
            esp32AesWrapCopy(blockAddress, output + u32(8), u32(8))
            block = block - i32(1)
        }
        round = round - i32(1)
    }
    esp32RecoveredAesDecryptDeinit(context,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

    var index = u32(0)
    while (index < u32(8)) {
        if (esp32AesWrapLoad(accumulator + index) != u32(166)) {
            return u32(0xffffffff)
        }
        index = index + u32(1)
    }
    u32(0)
}

trusted fun esp32RecoveredAesUnwrap(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32AesUnwrap(a2,a3,a4,a5,a6)
