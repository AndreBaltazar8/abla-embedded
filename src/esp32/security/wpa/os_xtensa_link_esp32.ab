import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaOsXtensaInternals(): bool {
    if (!internalFunction("esp32WpaGetTime", "os_get_time")) return false
    if (!internalFunction("esp32WpaRandom", "os_random")) return false
    if (!internalFunction("esp32WpaGetRandom", "os_get_random")) return false
    if (!internalFunction("esp32WpaSleep", "os_sleep")) return false
    if (!internalFunction("esp32WpaForcedMemzero", "forced_memzero")) return false
    true
}
