import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaWpsAttrProcessInternals(): bool {
    if (!internalFunction("esp32RecoveredWpsProcessAuthenticator", "wps_process_authenticator")) return false
    if (!internalFunction("esp32RecoveredWpsProcessKeyWrapAuth", "wps_process_key_wrap_auth")) return false
    if (!internalFunction("esp32RecoveredWpsProcessCred", "wps_process_cred")) return false
    if (!internalFunction("esp32RecoveredWpsProcessApSettings", "wps_process_ap_settings")) return false
    true
}
