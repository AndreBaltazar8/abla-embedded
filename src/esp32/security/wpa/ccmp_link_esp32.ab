import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWpaCcmpInternals(): bool {
    if (!internalFunction("esp32RecoveredCcmpDecrypt", "ccmp_decrypt")) return false
    if (!internalFunction("esp32RecoveredCcmpGetPn", "ccmp_get_pn")) return false
    if (!internalFunction("esp32RecoveredCcmpEncrypt", "ccmp_encrypt")) return false
    if (!internalFunction("esp32RecoveredCcmpEncryptPv1", "ccmp_encrypt_pv1")) return false
    if (!internalFunction("esp32RecoveredCcmp256Decrypt", "ccmp_256_decrypt")) return false
    if (!internalFunction("esp32RecoveredCcmp256Encrypt", "ccmp_256_encrypt")) return false
    true
}
