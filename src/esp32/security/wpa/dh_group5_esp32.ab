import "dh_groups_esp32.ab"
import "wpabuf_esp32.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32DhGroup5LoadPointer(address:u32):u32=u32(ablaUnsafeLoadU32(
    nativePointerFromAddress(int(address))))

@inline
trusted fun esp32DhGroup5StorePointer(address:u32,value:u32):void=
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))

trusted fun esp32DhGroup5():u32=esp32DhGroupsGet(u32(5))

trusted fun esp32Dh5Init(privateOutput:u32,publicOutput:u32):u32 {
    esp32RecoveredWpabufFree(esp32DhGroup5LoadPointer(publicOutput),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    val public=esp32DhInitialize(esp32DhGroup5(),privateOutput)
    esp32DhGroup5StorePointer(publicOutput,public)
    if(public==u32(0)) u32(0) else u32(1)
}

trusted fun esp32Dh5InitFixed(privateValue:u32,publicValue:u32):u32=u32(1)

trusted fun esp32Dh5DeriveShared(
    context:u32,peerPublic:u32,ownPrivate:u32
):u32=esp32DhDeriveShared(peerPublic,ownPrivate,esp32DhGroup5())

trusted fun esp32Dh5Free(context:u32):void { return }

trusted fun esp32RecoveredDh5Init(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32Dh5Init(a2,a3)
trusted fun esp32RecoveredDh5InitFixed(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32Dh5InitFixed(a2,a3)
trusted fun esp32RecoveredDh5DeriveShared(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32Dh5DeriveShared(a2,a3,a4)
trusted fun esp32RecoveredDh5Free(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=a2
