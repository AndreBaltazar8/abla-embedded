import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCryptoClockInternals(): bool {
    if (!internalFunction("esp32RecoveredEspCryptoAesEnablePeriphClk", "esp_crypto_aes_enable_periph_clk")) return false
    if (!internalFunction("esp32RecoveredEspCryptoShaEnablePeriphClk", "esp_crypto_sha_enable_periph_clk")) return false
    if (!internalFunction("esp32RecoveredEspCryptoMpiEnablePeriphClk", "esp_crypto_mpi_enable_periph_clk")) return false
    true
}
