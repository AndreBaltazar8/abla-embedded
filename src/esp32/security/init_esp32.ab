import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32SecurityInitialize(): i32 = i32(0)

trusted fun esp32SecurityIncludeImplementation(): void {
    return
}

// ESP-IDF discovers system initializers through this linker section. The
// callback and descriptor are both Abla-owned data in the monolithic image.
val esp32SecurityInitializerStorage = nativeInternalSectionU32s([
    int(u32(nativeFunctionAddress(esp32SecurityInitialize))),
    65537
], "abla_esp32_system_init_103_security", ".esp_system_init_fn.103")
val esp32SecurityInitializer = u32(esp32SecurityInitializerStorage)
