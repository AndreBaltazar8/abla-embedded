import "../runtime/libc_locks_esp32.ab"
import "abla/unsafe/memory"

// The two ESP32 hardware accelerator lock handles. They start at zero and are
// initialized lazily by the pure-Abla libc lock implementation.
val esp32CryptoShaAesLockStorage = nativeStaticAllocate(4)
val esp32CryptoShaAesLock = u32(esp32CryptoShaAesLockStorage)
val esp32CryptoMpiLockStorage = nativeStaticAllocate(4)
val esp32CryptoMpiLock = u32(esp32CryptoMpiLockStorage)

trusted fun esp32CryptoShaAesLockAcquire(): void {
    esp32LibcLockAcquireGeneric(
        esp32CryptoShaAesLock,
        esp32LibcLockWaitForever,
        esp32LibcLockNormalMutex
    )
    return
}

trusted fun esp32CryptoShaAesLockRelease(): void {
    esp32LibcLockReleaseGeneric(
        esp32CryptoShaAesLock,
        esp32LibcLockNormalMutex
    )
}

trusted fun esp32CryptoMpiLockAcquire(): void {
    esp32LibcLockAcquireGeneric(
        esp32CryptoMpiLock,
        esp32LibcLockWaitForever,
        esp32LibcLockNormalMutex
    )
    return
}

trusted fun esp32CryptoMpiLockRelease(): void {
    esp32LibcLockReleaseGeneric(
        esp32CryptoMpiLock,
        esp32LibcLockNormalMutex
    )
}
