import "../esp32/sdk/raw_buffer.ab"
// Configure only from the owning core's quiescent boot/teardown context,
// never from a callback. MIE and all48CLIC enables must be off. Caller owns
// handler code/context lifetime and serializes config updates. Other core's
//16B config is never changed. Callback ABI void(u32,u32,u32,u32), integer-only.
// 1published/removed,2invalid,3not quiesced/unexpected owner,4readback failure.
trusted fun p4IrqConfigQuiescent(core: int): bool {
    if (core < 0 || core > 1 || p4IrqConfigCurrentCore() != core || (p4IrqConfigMachineStatus()&u32(8)) != u32(0)) return false
    var line=0
    while (line < 48) {
        if (p4IrqConfigLineEnabled(line)) return false
        line=line+1
    }
    return true
}
trusted fun esp32P4IrqConfigureOwned(core: int,callback: int,context: int): int {
    if (core < 0 || core > 1 || callback <= 0 || callback > 4294967294 || (callback&1) != 0 || context < 0 || context > 4294967295) return 2
    if (!p4IrqConfigQuiescent(core)) return 3
    val config=p4IrqConfigStorage(core)
    if (!config.hasAddressRange(0,16) || (config.addressValue()&3) != 0) return 2
    if (config.loadU32(0) != 0) return 3
    config.storeU32(4,context)
    if (config.loadU32(4) != context) return 4
    p4IrqConfigFence()
    config.storeU32(0,callback)
    return if (config.loadU32(0) == callback) 1 else 4
}
trusted fun esp32P4IrqUnconfigureOwned(core: int,expectedCallback: int): int {
    if (core < 0 || core > 1 || expectedCallback <= 0 || expectedCallback > 4294967294 || (expectedCallback&1) != 0) return 2
    if (!p4IrqConfigQuiescent(core)) return 3
    val config=p4IrqConfigStorage(core)
    if (!config.hasAddressRange(0,16) || (config.addressValue()&3) != 0) return 2
    if (config.loadU32(0) != expectedCallback) return 3
    config.storeU32(0,0)
    if (config.loadU32(0) != 0) return 4
    p4IrqConfigFence()
    config.storeU32(4,0)
    return if (config.loadU32(4) == 0) 1 else 4
}
