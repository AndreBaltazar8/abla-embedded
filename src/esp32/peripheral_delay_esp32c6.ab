import "./peripheral_delay_rom_sequence.ab"
import "abla/unsafe/native"
import "../hal/esp32.ab"
// C6 ROM ets_delay_us. Require successful delay-clock configuration and a
// pinned CPU clock; this busy wait never configures clocks itself.
@export("peripheralRomDelay")
trusted fun peripheralRomDelayHook(microseconds: int): void { callNativeVoidI32(0x40000040,microseconds);return }
