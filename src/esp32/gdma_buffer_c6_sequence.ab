import "./gdma_events_c6_sequence.ab"
import "./gdma_ring_c6_sequence.ab"
// SRAM-only block acquisition:status8,length12@8,raw events8@24.
// 1CPU-owned2invalid3clock/IRQ/unknown-event4DMA-error5DMA-owned6descriptor.
// Caller owns channel/ring lifetime, excludes CPU/ISR writers, enables owner
// checking and TX writeback. No ack/stop/restart or payload access on failure.
type C6GdmaBuffer=int
fun C6GdmaBuffer.status(): int = this&255
fun C6GdmaBuffer.bytes(): int = (this>>>8)&4095
fun C6GdmaBuffer.events(): int = (this>>>24)&255
// finalIndex optionally seals one link of a TX circular ring to NULL. Only
// the exclusive sealing owner may use it; ordinary rings keep default-1.
trusted fun c6GdmaAcquireOwned(channel: int,tx: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,index: int,circular: bool,exclusive: bool,finalIndex: int=-1): C6GdmaBuffer {
    if (!exclusive || channel < 0 || channel > 2 || index < 0 || index >= count || finalIndex < -1 || finalIndex >= count || (finalIndex >= 0 && (!tx || !circular)) || !c6GdmaRingValid(descriptors,count,buffers,stride,bytes)) return C6GdmaBuffer(2)
    val first=c6GdmaEventsReadOwned(channel,tx,true)
    if (first.status() != 1) return C6GdmaBuffer(3)
    val evidence=first.raw()<<24
    if (first.errors() != 0) return C6GdmaBuffer(evidence|4)
    val at=descriptors+index*12
    val control=c6GdmaDescriptorRead(at)
    if ((control&u32(0x80000000)) != u32(0)) return C6GdmaBuffer(evidence|5)
    // Observe DMA's owner release before reading metadata or payload.
    c6GdmaDescriptorFence()
    val length=int((control>>u32(12))&u32(4095))
    val next=if (index == finalIndex) 0 else if (index+1 < count) at+12 else if (circular) descriptors else 0
    if ((control&u32(4095)) != u32(bytes) || (control&u32(0x3f000000)) != u32(0) || length > bytes ||
        (tx && (length != bytes || (control&u32(0x40000000)) == u32(0))) ||
        c6GdmaDescriptorRead(at+4) != u32(buffers+index*stride) || c6GdmaDescriptorRead(at+8) != u32(next)) return C6GdmaBuffer(evidence|6)
    val second=c6GdmaEventsReadOwned(channel,tx,true)
    if (second.status() != 1) return C6GdmaBuffer(evidence|3)
    val combined=(first.raw()|second.raw())<<24
    if (second.errors() != 0) return C6GdmaBuffer(combined|4)
    c6GdmaDescriptorFence()
    return C6GdmaBuffer(combined|(length<<8)|1)
}
// After acquire, caller consumed RX or initialized replacement TX bytes.
// Returns acquire failure unchanged, or 65537 meaning ownership publication
// attempted. No post-owner readback: DMA can immediately consume/write back.
// Do not retry/edit/free after publication; working SRAM and fences assumed.
trusted fun c6GdmaRearmOwned(channel: int,tx: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,index: int,circular: bool,exclusive: bool,finalIndex: int=-1): int {
    val acquired=c6GdmaAcquireOwned(channel,tx,descriptors,count,buffers,stride,bytes,index,circular,exclusive,finalIndex)
    if (acquired.status() != 1) return acquired|0
    val control=u32(bytes)|u32(0x80000000)|(if (tx) (u32(bytes)<<u32(12))|u32(0x40000000) else u32(0))
    c6GdmaDescriptorFence()
    c6GdmaDescriptorWrite(descriptors+index*12,control)
    c6GdmaDescriptorFence()
    return 65537
}
