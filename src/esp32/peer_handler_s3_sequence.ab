import "./sdk/raw_buffer.ab"
import "./interrupt_capabilities_s3.ab"

// Destination-core setup only, owned disabled native level1..3 line. Caller
// must install appropriate S3 vectors/dispatcher, acquire scheduler-safe
// ownership, route channel, and enable line only AFTER this returns true.
// Keep context/mailbox/table/previous alive; never reuse context until line is
// disabled, requests stopped and the installed handler removed. Previous saves
// the exact old handler/argument pair. A failed call may initialize context.
trusted fun esp32S3PeerHandlerInstallOwned(table: NativeBuffer,previous: NativeBuffer,context: NativeBuffer,mailbox: NativeBuffer,channel: int,line: int): bool {
    if (!context.hasAddressRange(0,8) || !mailbox.hasAddressRange(0,4) ||
        !table.hasAddressRange(0,512) || !previous.hasAddressRange(0,8) ||
        (context.addressValue() & 3) != 0 || (mailbox.addressValue() & 3) != 0 ||
        channel < 0 || channel > 3 || !esp32S3InterruptExternalLevel(line) ||
        !esp32S3InterruptSupportsNativeHandler(line)) return false
    val ctx=context.addressValue()
    val box=mailbox.addressValue()
    val tab=table.addressValue()
    val save=previous.addressValue()
    if ((ctx < box+4 && box < ctx+8) || (ctx < tab+512 && tab < ctx+8) ||
        (ctx < save+8 && save < ctx+8) || (box < tab+512 && tab < box+4) ||
        (box < save+8 && save < box+4)) return false
    val word=xtensaPeerParkCas(box,0,0)
    if (word != 0 && (word & 7) != 4 && (word & 7) != 5) return false
    if (((esp32S3InterruptInstallEnabled()>>>line) & 1) != 0) return false
    esp32S3PeerHandlerWrite(ctx,box)
    esp32S3PeerHandlerWrite(ctx+4,channel)
    esp32S3InterruptInstallOwned(table,previous,esp32S3InterruptInstallCore(),line,
        esp32S3PeerHandlerAddress(),ctx)
}

// Request producer stopped, line disabled and no active handler on this core.
// Leaves context intact on failure. Does not restore channel routing or enable
// a previous interrupt: those follow separately under the same ownership.
trusted fun esp32S3PeerHandlerRemoveOwned(table: NativeBuffer,previous: NativeBuffer,context: NativeBuffer,line: int): bool {
    if (!context.hasAddressRange(0,8) || (context.addressValue() & 3) != 0) return false
    val ctx=context.addressValue()
    val mailbox=esp32S3PeerHandlerRead(ctx)
    val channel=esp32S3PeerHandlerRead(ctx+4)
    if (mailbox == 0 || (mailbox & 3) != 0 || channel > 3) return false
    val word=xtensaPeerParkCas(mailbox,0,0)
    if (word != 0 && (word & 7) != 4 && (word & 7) != 5) return false
    if ((esp32S3IntercoreRead(0x600C0030+channel*4) & 1) != 0) return false
    if (!esp32S3InterruptRestoreOwned(table,previous,esp32S3InterruptInstallCore(),line,
        esp32S3PeerHandlerAddress(),ctx)) return false
    esp32S3PeerHandlerWrite(ctx,0)
    esp32S3PeerHandlerWrite(ctx+4,0)
    true
}
