import "./window_vectors_esp32s3.ab"
import "./irq_entries_esp32s3.ab"
import "./exception_handler_esp32s3.ab"
// User vector only: IRQ1 preserves original a0; MOVSP uses saved EXCSAVE1;
// remaining causes enter a real mutable exception frame callback. Requires a
// registered exception callback before activation. No automatic syscall or
// lazy coprocessor policy; those must be supplied by the owning runtime.
// Kernel/double/high-level/debug/NMI vectors are not supplied here.
trusted noescape extern:"inline-assembly" fun esp32S3UserVectorAddressAssembly(template: string,constraints: string,vector: u32,window: u32,entries: u32,fault: u32): u32
@naked
@noinline
@section(".iram1.abla.s3UserVector")
trusted fun esp32S3UserVector(): void =
    esp32S3ContextExtraAssembly(".Labla_s3_user_vector:\nwsr.excsave1 a0\nrsr.exccause a0\nbnei a0, 4, .Labla_s3_user_not_irq\nrsr.excsave1 a0\nj .Labla_s3_irq_base\n.Labla_s3_user_not_irq:\nbnei a0, 5, .Labla_s3_user_fault\nj .Labla_s3_alloca\n.Labla_s3_user_fault:\nj .Labla_s3_exception_entry\n.org .Labla_s3_user_vector+64", "~{memory}")
// Stay on interrupted stack, like IDF _xt_handle_exc. Frame includes cause80,
// vaddr84 and editable CPENABLE148. Callback may update PC/registers/CP state.
// Shared active-callback count blocks config release while handling a fault.
// INTLEVEL4 masks ordinary IRQs; debug/NMI/nested faults need own vectors.
@naked
@noinline
@section(".iram1.abla.s3ExceptionEntry")
trusted fun esp32S3ExceptionEntry(): void =
    esp32S3ContextExtraAssembly(".Labla_s3_exception_entry:\nmov a0, a1\naddmi a1, a1, -256\naddi a1, a1, 64\ns32i a0, a1, 16\nrsr.ps a0\ns32i a0, a1, 8\nrsr.epc1 a0\ns32i a0, a1, 4\nrsr.excsave1 a0\ns32i a0, a1, 12\ns32i a12, a1, 60\ns32i a13, a1, 64\ncall0 .Labla_s3_irq_save\nrsr.exccause a0\ns32i a0, a1, 80\nrsr.excvaddr a0\ns32i a0, a1, 84\nrsr.cpenable a0\ns32i a0, a1, 148\nmovi a0, 0\nwsr.cpenable a0\nrsr.prid a8\nextui a8, a8, 13, 1\nmovi a12, .Labla_s3_irq_config\nslli a0, a8, 5\nadd a12, a12, a0\ns32i a12, a1, 152\nl32i a0, a12, 4\naddi a0, a0, 1\ns32i a0, a12, 4\nl32i a4, a12, 24\nl32i a9, a12, 28\nmov a6, a1\nl32i a7, a1, 80\nl32i a0, a1, 12\ns32e a0, a1, -16\nl32i a0, a1, 16\ns32e a0, a1, -12\nmovi a0, 262180\nwsr.ps a0\nrsync\ncallx4 a4\nrsil a0, 15\nmovi a0, 262207\nwsr.ps a0\nrsync\nl32i a12, a1, 152\nl32i a0, a12, 4\naddi a0, a0, -1\ns32i a0, a12, 4\nl32i a0, a1, 148\nwsr.cpenable a0\ncall0 .Labla_s3_irq_restore\nl32i a0, a1, 8\nwsr.ps a0\nl32i a0, a1, 4\nwsr.epc1 a0\nl32i a0, a1, 12\nl32i a1, a1, 16\nrsync\nrfe", "~{memory}")
@inline
trusted fun esp32S3UserVectorAddress(): int =
    int(esp32S3UserVectorAddressAssembly("movi $0, .Labla_s3_user_vector", "=r,i,i,i,i,~{memory}", u32(nativeFunctionAddress(esp32S3UserVector)), u32(nativeFunctionAddress(esp32S3WindowVectors)), u32(nativeFunctionAddress(esp32S3IrqEntries)), u32(nativeFunctionAddress(esp32S3ExceptionEntry))))
