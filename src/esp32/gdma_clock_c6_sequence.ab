// C6 GDMA: three RX/TX pairs, base60080000, PCRclock600960bc.
// Whole-controller lease: caller owns all DMA clients/ETM/IRQs/power and
// pins roots. Does not reset, clear events, alter arbitration or memory windows.
// status1ready2invalid3reset4bus-write5busy6local-write7closed.
// Attempted gate ownership: bit8 bus, bit9 force-register-clock; leasebit10.
type C6GdmaClock=int
fun C6GdmaClock.status(): int = this&255
fun c6GdmaChannelBase(channel: int,tx: bool): int = if (channel < 0 || channel > 2) -1 else 0x70+channel*192+(if (tx) 96 else 0)
fun c6GdmaEventBase(channel: int,tx: bool): int = if (channel < 0 || channel > 2) -1 else channel*16+(if (tx) 48 else 0)
trusted fun c6GdmaAllParked(): bool {
    var channel=0
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            val tx=direction == 1
            val base=c6GdmaChannelBase(channel,tx)
            val events=c6GdmaEventBase(channel,tx)
            if ((c6GdmaRead(base)&u32(if (tx) 65 else 33)) != u32(0) ||
                (c6GdmaRead(base+16)&u32(if (tx) 0xf00000 else 0x1e00000)) != u32(if (tx) 0x800000 else 0x1000000) ||
                (c6GdmaRead(base+8)&u32(2)) == u32(0) ||
                c6GdmaRead(events) != u32(0) || c6GdmaRead(events+8) != u32(0)) return false
            direction=direction+1
        }
        channel=channel+1
    }
    return true
}
trusted fun c6GdmaClockOpenOwned(exclusive: bool): C6GdmaClock {
    if (!exclusive) return C6GdmaClock(2)
    val bus=c6GdmaBusRead()
    if ((bus&u32(2)) != u32(0)) return C6GdmaClock(3)
    var token=1024
    if ((bus&u32(1)) == u32(0)) {
        token=token|256;c6GdmaBusWrite(bus|u32(1))
        if ((c6GdmaBusRead()&u32(3)) != u32(1)) return C6GdmaClock(token|4)
    }
    val misc=c6GdmaRead(0x64)
    if ((misc&u32(1)) != u32(0)) return C6GdmaClock(token|3)
    if (!c6GdmaAllParked()) return C6GdmaClock(token|5)
    if ((misc&u32(8)) == u32(0)) {
        token=token|512;c6GdmaWrite(0x64,misc|u32(8))
        if ((c6GdmaRead(0x64)&u32(9)) != u32(8)) return C6GdmaClock(token|6)
    }
    return C6GdmaClock(token|1)
}
trusted fun C6GdmaClock.closeOwned(exclusive: bool): C6GdmaClock {
    if (!exclusive || this < 0 || (this&~2047) != 0 || (this&1024) == 0 || this.status() < 1 || this.status() > 6) return this
    var token=this&1792
    val bus=c6GdmaBusRead()
    if ((bus&u32(2)) != u32(0)) return C6GdmaClock(token|3)
    if ((bus&u32(1)) != u32(0)) {
        if ((c6GdmaRead(0x64)&u32(1)) != u32(0)) return C6GdmaClock(token|3)
        if (!c6GdmaAllParked()) return C6GdmaClock(token|5)
    } else if (this.status() != 4 || (token&512) != 0) return C6GdmaClock(token|4)
    if ((token&512) != 0) {
        c6GdmaWrite(0x64,c6GdmaRead(0x64)&~u32(8))
        if ((c6GdmaRead(0x64)&u32(8)) != u32(0)) return C6GdmaClock(token|6)
        token=token&~512
    }
    if ((token&256) != 0 && (bus&u32(1)) != u32(0)) {
        c6GdmaBusWrite(c6GdmaBusRead()&~u32(1))
        if ((c6GdmaBusRead()&u32(1)) != u32(0)) return C6GdmaClock(token|4)
    }
    return C6GdmaClock(7)
}
