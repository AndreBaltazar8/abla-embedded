import "./ledc_esp32c6.ab"
import "./ledc_clock_c6_sequence.ab"
import "../hal/esp32.ab"
@export("c6LedcClockRead")
trusted fun c6LedcClockReadHook(offset: int): int = mmioLoadU32(0x60096034+offset)
@export("c6LedcClockWrite")
trusted fun c6LedcClockWriteHook(offset: int,value: int): void { mmioStoreU32(0x60096034+offset,value);return }
