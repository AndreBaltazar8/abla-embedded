import "./sdk/raw_buffer.ab"

// Caller holds RCC lock and owns ALL stopped channels. Memory power/mode is
// shared; refuse preparation while the group source clock is active.
trusted fun esp32s3RmtPrepareMemoryLocked(): bool {
    val prior = esp32s3RmtRead(0x600160c0)
    if ((prior & 0x04000000) != 0) return false
    val powered = prior | 8
    esp32s3RmtWrite(0x600160c0, powered)
    esp32s3RmtWrite(0x600160c0, powered & 0xfffffffb)
    esp32s3RmtWrite(0x600160c0, (powered & 0xfffffffb) | 1)
    true
}

// Caller owns a stopped, configured single-block TX channel and powered
// non-FIFO RMT memory. Copy up to47 full symbols, append a zero terminator.
// No start, reset, clock gating or allocation. Source must stay immutable
// throughout validation/copy; this is not a concurrent producer interface.
trusted fun esp32s3RmtLoadFrameOwned(channel: int, source: NativeBuffer, symbols: int): bool {
    if (channel < 0 || channel > 3 || symbols < 1 || symbols > 47 ||
        !source.hasAddressRange(0, symbols * 4)) return false
    val address = source.addressValue()
    if (address < 0x60016e00 && address + symbols * 4 > 0x60016800) return false
    var index = 0
    while (index < symbols) {
        val symbol = source.loadU32(index * 4)
        if ((symbol & 32767) == 0 || ((symbol >>> 16) & 32767) == 0) return false
        index = index + 1
    }
    val destination = 0x60016800 + channel * 192
    index = 0
    while (index < symbols) {
        esp32s3RmtWrite(destination + index * 4, source.loadU32(index * 4))
        index = index + 1
    }
    esp32s3RmtWrite(destination + symbols * 4, 0)
    esp32s3RmtPublish()
    true
}
