import "./coprocessor_owner_s3_sequence.ab"
import "./task_resolver_s3_sequence.ab"
// Rebind an already-detached task on this core under scheduler ownership.
// Does not restore integer registers/enable IRQs. Saved CP bits stay0: first
// use faults and restores this binding's preserved snapshot lazily. All guards
// run before any write. No simultaneous execution or stealing remote state.
@section(".iram1.abla.s3TaskReattach")
trusted fun esp32S3TaskReattachOwned(current: NativeBuffer,binding: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,core: int): bool {
    if (!esp32S3CpOwnerGuard(owners,core,0) || !esp32S3CpOwnerGuard(owners,core,3) ||
        !current.hasAddressRange(0,8) || !esp32S3CpOwnerRange(current.addressValue(),8,3) ||
        !binding.hasAddressRange(0,16) || !esp32S3CpOwnerRange(binding.addressValue(),16,3) ||
        !frame.hasAddressRange(0,192) || !esp32S3CpOwnerRange(frame.addressValue(),192,15)) return false
    val table=current.addressValue()
    val address=binding.addressValue()
    val ownerTable=owners.addressValue()
    val saved=frame.addressValue()
    if (esp32S3TaskResolverOverlap(saved,192,table,8) || esp32S3TaskResolverOverlap(saved,192,address,16) ||
        esp32S3TaskResolverOverlap(saved,192,ownerTable,16) || esp32S3TaskResolverOverlap(ownerTable,16,table,8) ||
        esp32S3TaskResolverOverlap(ownerTable,16,address,16) || esp32S3CpOwnerRead(saved+148) != 0) return false
    val first=esp32S3CpOwnerRead(address)
    val second=esp32S3CpOwnerRead(address+4)
    if (!esp32S3TaskResolverCpFresh(first,0) || !esp32S3TaskResolverCpFresh(second,3) ||
        esp32S3TaskResolverOverlap(saved,192,first,256) || esp32S3TaskResolverOverlap(saved,192,second,256) ||
        esp32S3TaskResolverOverlap(ownerTable,16,first,256) || esp32S3TaskResolverOverlap(ownerTable,16,second,256)) return false
    var offset=0
    while (offset < 16) {
        val resident=esp32S3CpOwnerRead(ownerTable+offset)
        if (resident == first || resident == second) return false
        if (resident != 0 && (!esp32S3CpOwnerRange(resident,256,15) || esp32S3TaskResolverOverlap(resident,256,saved,192))) return false
        offset=offset+4
    }
    esp32S3TaskBindingPublishOwned(current,binding,nativeBufferAt(first,256),nativeBufferAt(second,256),core,false)
}
