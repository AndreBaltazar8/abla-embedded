// Calibrated ROM microsecond provider. Negative/zero durations do no work;
// bounded calls avoid narrowing a large Abla integer into the ROM uint32 ABI.
// Busy wait: caller must not use long delays with interrupts masked/in an ISR.
trusted fun peripheralDelayMicroseconds(microseconds: int): void {
    var remaining=microseconds
    while (remaining > 0) {
        val chunk=if (remaining > 1000) 1000 else remaining
        peripheralRomDelay(chunk)
        remaining=remaining-chunk
    }
    return
}
trusted fun peripheralDelayMilliseconds(milliseconds: int): void {
    var remaining=milliseconds
    while (remaining > 0) {
        peripheralRomDelay(1000)
        remaining=remaining-1
    }
    return
}
