import "./runtime/libc_time_esp32.ab"
import "./unix_time_set_sequence.ab"
// Call the existing Abla timekeeping implementation directly, without an
// exported C alias or a second wall-clock state. Caller initializes runtime.
// Optional setter module leaves existing read-only clock imports unchanged.
@inline
trusted fun esp32SetUnixTimeValue(address: int): int = int(i32(esp32RecoveredSettimeofday(
    u32(address),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))))
trusted fun setUnixTimeSeconds(seconds: int): bool =
    esp32SetUnixTimeWithBuffer(seconds,nativeBufferAt(nativeStackAllocate(16),16))
