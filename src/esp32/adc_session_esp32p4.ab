import "./adc_session_p4_sequence.ab"
import "./adc_analog_esp32p4.ab"
import "./adc_pins_esp32p4.ab"
import "./analog/sar_bus_esp32p4.ab"
// Internal, statically linked adapters. These are not ABI exports/callbacks.
trusted fun p4AdcSessionResourceOpen(stage: int,r: NativeBuffer,c: P4AdcCalibration,layout: int,polls: int): int {
    if (stage == 0) return esp32p4AnalogSarBusOpenOwned(nativeBufferAt(r.addressValue(),32),polls,true)
    if (stage == 1) return esp32p4AdcClockOpenOwned(0,0,0,1,true)|0
    if (stage == 2) return esp32p4AdcPowerOpenOwned(c.unit(),true)|0
    if (stage == 3) return esp32p4AdcPadOpenOwned(c.unit(),c.channel(),layout,true)|0
    if (stage == 4) return esp32p4AdcControllerOpenOwned(c.unit(),c.channel(),c.attenuation(),1,true)|0
    return esp32p4AdcAnalogOpenOwned(c.unit(),c.initCode(),polls,true)|0
}
trusted fun p4AdcSessionResourceClose(stage: int,r: NativeBuffer,token: int,polls: int): int {
    if (stage == 0) {
        // Open can fail preflight before claiming any bus resources.
        if (r.loadU32(0) == 0) return 6
        return esp32p4AnalogSarBusCloseOwned(nativeBufferAt(r.addressValue(),32),polls,true)
    }
    if (stage == 1) return P4AdcClock(token).closeOwned(true)|0
    if (stage == 2) return P4AdcPower(token).closeOwned(true)|0
    if (stage == 3) return P4AdcPad(token).closeOwned(true)|0
    if (stage == 4) return P4AdcController(token).closeOwned(true)|0
    return P4AdcAnalog(token).closeOwned(polls,true)|0
}
fun p4AdcSessionResourceStatus(stage: int,token: int): int = if (stage == 3) P4AdcPad(token).status() else if (stage == 5) token&65535 else token&255
fun p4AdcSessionResourceReady(stage: int,token: int,closing: bool): bool {
    if (!closing) return (if (stage == 3) P4AdcPad(token).status() else token&255) == 1
    if (stage == 0) return token == 6
    if (stage == 1) return !P4AdcClock(token).hasSnapshot() || P4AdcClock(token).status() == 5
    if (stage == 2) return !P4AdcPower(token).hasSnapshot() || P4AdcPower(token).status() == 6
    if (stage == 3) return !P4AdcPad(token).hasSnapshot() || P4AdcPad(token).status() == 5
    if (stage == 4) return !P4AdcController(token).hasSnapshot() || P4AdcController(token).status() == 6
    return !P4AdcAnalog(token).hasSnapshot() || P4AdcAnalog(token).status() == 5
}
trusted fun p4AdcSessionMatches(c: P4AdcCalibration): bool {
    if (!esp32p4AdcOneshotPrepared(c.unit())) return false
    val base=p4AdcRtcBase(c.unit())
    return (p4AdcRead(base)&u32(255)) == u32(1) &&
        ((p4AdcRead(base+20)>>u32(2*p4AdcPadIndex(c.unit(),c.channel())))&u32(3)) == u32(c.attenuation())
}
trusted fun p4AdcSessionAnalogIdle(polls: int): bool = p4AnalogClockReady() && p4AnalogWaitIdle(0,polls) && p4AnalogWaitIdle(4,polls)
trusted fun p4AdcSessionStart(c: P4AdcCalibration): int = esp32p4AdcOneshotStartOwned(c.unit(),c.channel(),true)
trusted fun p4AdcSessionFinish(c: P4AdcCalibration,polls: int): int = esp32p4AdcOneshotFinishOwned(c.unit(),c.channel(),polls,true)
trusted fun p4AdcSessionRelease(c: P4AdcCalibration,polls: int): int = esp32p4AdcOneshotReleaseOwned(c.unit(),c.channel(),polls,true)
