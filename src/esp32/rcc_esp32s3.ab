import "../atomic.ab"
import "./critical_xtensa.ab"
import "abla/unsafe/memory/raw"

// Canonical RCC word for framework drivers, independent of any peripheral.
val esp32S3SharedRccWord = nativeStaticMutableU32s([0])
fun esp32S3RccSharedLock(): AtomicU32 = atomicU32At(esp32S3SharedRccWord)

// All S3 RCC register users on both cores must share this atomic RAM word.
// No waiting while masked: one failed CAS restores interrupts immediately.
// Nonnegative result is the previous PS mask token; -1 means no lock acquired.
// Only level<=3 code may contend for this lock; higher-priority handlers must
// not touch RCC. Nesting the same nonrecursive lock fails instead of spinning.
trusted fun esp32S3RccTryEnter(lock: AtomicU32, owner: u32): int {
    if (!lock.valid() || owner == u32(0)) return -1
    val saved = espXtensaMaskSchedulerInterrupts()
    if (lock.tryClaim(owner)) return int(saved)
    espXtensaRestoreInterruptMask(saved)
    return -1
}

trusted fun esp32S3RccLeave(lock: AtomicU32, owner: u32, saved: int): bool {
    if (saved < 0 || saved > 4294967295) return false
    val released = lock.releaseClaim(owner)
    // Restore even on ownership misuse; do not strand this core masked.
    espXtensaRestoreInterruptMask(u32(saved))
    released
}
