import "abla/unsafe/native"
// Non-nesting M-mode external interrupt entry, current-core config16B x2.
// Caller provides healthy16-aligned interrupted stack with144B frame+callback
// stack reserve, cache-safe integer-only callback void(u32 frame,u32 cause,
// u32 core,u32 context). Callback frame is borrowed/read-only, no scheduling.
// No FPU/PIE/DSP/hardware-loop instructions in callback: FS/XS disabled while
// servicing so interrupted extension registers remain untouched. No fp save.
// Frame x0..31 at4*reg (originalsp at8), mepc128,mstatus132,mcause136,mtval140.
// Restores mcause (CLIC prior-level state), mepc, mstatus, all integer registers.
// No global IRQ enable here; callback must not enable nesting or change trap
// CSRs. Unsupported exceptions/core/interrupt/unconfigured callback fail closed
// with frame preserved on stack and watchdogs untouched; not a panic runtime.
trusted noescape extern:"inline-assembly" fun p4IrqEntryAssembly(template: string,constraints: string): void
trusted noescape extern:"inline-assembly" fun p4IrqAddressAssembly(template: string,constraints: string,root: u32): u32
@naked
@noinline
@section(".iram1.abla.p4IrqEntry")
trusted fun esp32P4IrqEntryRegion(): void =
    p4IrqEntryAssembly(".option push\n.option norvc\n.option norelax\n.balign 64\n.Labla_p4_irq_entry:\naddi sp, sp, -144\nsw zero, 0(sp)\nsw x1, 4(sp)\nsw x3, 12(sp)\nsw x4, 16(sp)\nsw x5, 20(sp)\nsw x6, 24(sp)\nsw x7, 28(sp)\nsw x8, 32(sp)\nsw x9, 36(sp)\nsw x10, 40(sp)\nsw x11, 44(sp)\nsw x12, 48(sp)\nsw x13, 52(sp)\nsw x14, 56(sp)\nsw x15, 60(sp)\nsw x16, 64(sp)\nsw x17, 68(sp)\nsw x18, 72(sp)\nsw x19, 76(sp)\nsw x20, 80(sp)\nsw x21, 84(sp)\nsw x22, 88(sp)\nsw x23, 92(sp)\nsw x24, 96(sp)\nsw x25, 100(sp)\nsw x26, 104(sp)\nsw x27, 108(sp)\nsw x28, 112(sp)\nsw x29, 116(sp)\nsw x30, 120(sp)\nsw x31, 124(sp)\naddi t0, sp, 144\nsw t0, 8(sp)\ncsrr t0, mepc\nsw t0, 128(sp)\ncsrr t0, mstatus\nsw t0, 132(sp)\ncsrr t0, mcause\nsw t0, 136(sp)\ncsrr t0, mtval\nsw t0, 140(sp)\ncsrr t0, mstatus\nli t1, 0x1e008\nnot t1, t1\nand t0, t0, t1\ncsrw mstatus, t0\nlw t0, 136(sp)\nbgez t0, .Labla_p4_irq_fatal\nli t1, 4095\nand a1, t0, t1\nli t1, 16\nbltu a1, t1, .Labla_p4_irq_fatal\nli t1, 48\nbgeu a1, t1, .Labla_p4_irq_fatal\ncsrr a2, mhartid\nli t1, 2\nbgeu a2, t1, .Labla_p4_irq_fatal\nla t0, .Labla_p4_irq_config\nslli t1, a2, 4\nadd t0, t0, t1\nlw t1, 0(t0)\nbeqz t1, .Labla_p4_irq_fatal\nlw a3, 4(t0)\nmv a0, sp\njalr ra, 0(t1)\ncsrci mstatus, 8\nlw t0, 128(sp)\ncsrw mepc, t0\nlw t0, 136(sp)\ncsrw mcause, t0\nlw t0, 132(sp)\nandi t0, t0, -9\ncsrw mstatus, t0\nlw x1, 4(sp)\nlw x3, 12(sp)\nlw x4, 16(sp)\nlw x5, 20(sp)\nlw x6, 24(sp)\nlw x7, 28(sp)\nlw x8, 32(sp)\nlw x9, 36(sp)\nlw x10, 40(sp)\nlw x11, 44(sp)\nlw x12, 48(sp)\nlw x13, 52(sp)\nlw x14, 56(sp)\nlw x15, 60(sp)\nlw x16, 64(sp)\nlw x17, 68(sp)\nlw x18, 72(sp)\nlw x19, 76(sp)\nlw x20, 80(sp)\nlw x21, 84(sp)\nlw x22, 88(sp)\nlw x23, 92(sp)\nlw x24, 96(sp)\nlw x25, 100(sp)\nlw x26, 104(sp)\nlw x27, 108(sp)\nlw x28, 112(sp)\nlw x29, 116(sp)\nlw x30, 120(sp)\nlw x31, 124(sp)\naddi sp, sp, 144\nmret\n.Labla_p4_irq_fatal:\ncsrci mstatus, 8\nwfi\nj .Labla_p4_irq_fatal\n.option pop\n.pushsection .dram1.abla.p4IrqConfig,\"aw\",@progbits\n.balign 4\n.Labla_p4_irq_config:\n.zero 32\n.popsection","~{memory}")
trusted fun esp32P4IrqEntryAddress(): int =
    int(p4IrqAddressAssembly(".option push\n.option norelax\nla $0, .Labla_p4_irq_entry\n.option pop","=r,i,~{memory}",u32(nativeFunctionAddress(esp32P4IrqEntryRegion))))
trusted fun esp32P4IrqConfigAddress(): int =
    int(p4IrqAddressAssembly(".option push\n.option norelax\nla $0, .Labla_p4_irq_config\n.option pop","=r,i,~{memory}",u32(nativeFunctionAddress(esp32P4IrqEntryRegion))))
