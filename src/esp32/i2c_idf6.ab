import "abla/unsafe/memory"
import "./sdk/buffer.ab"

trusted noescape extern:"c" fun i2c_new_master_bus(
    config: i64*,
    handle: i64*
): i32
trusted noescape extern:"c" fun i2c_del_master_bus(handle: i64*): i32
trusted noescape extern:"c" fun i2c_master_probe(
    handle: i64*,
    address: u16,
    timeoutMilliseconds: i32
): i32
trusted noescape extern:"c" fun i2c_master_bus_add_device(
    bus: i64*,
    config: i64*,
    handle: i64*
): i32
trusted noescape extern:"c" fun i2c_master_bus_rm_device(
    handle: i64*
): i32
trusted noescape extern:"c" fun i2c_master_transmit(
    device: i64*,
    source: i64*,
    length: u32,
    timeoutMilliseconds: i32
): i32
trusted noescape extern:"c" fun i2c_master_receive(
    device: i64*,
    destination: i64*,
    length: u32,
    timeoutMilliseconds: i32
): i32
trusted noescape extern:"c" fun i2c_master_transmit_receive(
    device: i64*,
    source: i64*,
    sourceLength: u32,
    destination: i64*,
    destinationLength: u32,
    timeoutMilliseconds: i32
): i32
trusted noescape extern:"c" fun i2c_master_multi_buffer_transmit(
    device: i64*,
    buffers: i64*,
    bufferCount: u32,
    timeoutMilliseconds: i32
): i32

// Both values lower to one native pointer-sized integer. The vendor driver
// owns its internal allocation; Abla owns the explicit close operation.
type I2cBus = int
type I2cDevice = int
// Low eight bits contain the byte; bit eight records a successful transfer.
// This distinguishes a real zero register value from an I2C error without an
// allocation, tuple, or out pointer in application code.
type I2cByteResult = int
// Low sixteen bits contain the word; bit sixteen records a successful
// transfer. Register-oriented drivers can therefore preserve a legitimate
// zero value without allocating an option/result object.
type I2cWordResult = int

fun I2cByteResult.valid(): bool = (this & 256) != 0
fun I2cByteResult.value(): int = this & 255
fun I2cWordResult.valid(): bool = (this & 65536) != 0
fun I2cWordResult.value(): int = this & 65535
fun I2cWordResult.signedValue(): int {
    val value = this.value()
    if (value < 32768) value else value - 65536
}

var idf6I2cBus0 = 0
var idf6I2cBus1 = 0
var idf6I2cPins0 = -1
var idf6I2cPins1 = -1

fun i2cPinsValue(sda: int, scl: int): int =
    (sda & 255) | ((scl & 255) << 8)

fun storedI2cBus(port: int): int =
    if (port == 0) idf6I2cBus0 else idf6I2cBus1

fun storedI2cPins(port: int): int =
    if (port == 0) idf6I2cPins0 else idf6I2cPins1

fun setStoredI2cBus(port: int, handle: int, pins: int): void {
    if (port == 0) {
        idf6I2cBus0 = handle
        idf6I2cPins0 = pins
    } else {
        idf6I2cBus1 = handle
        idf6I2cPins1 = pins
    }
    return
}

trusted fun i2cMaster(port: int, sda: int, scl: int): I2cBus {
    val pins = i2cPinsValue(sda, scl)
    val existing = storedI2cBus(port)
    if (existing != 0) {
        return if (storedI2cPins(port) == pins) I2cBus(existing) else I2cBus(0)
    }
    if (port < 0 || port > 1 || sda < 0 || scl < 0) return I2cBus(0)

    // i2c_master_bus_config_t on 32-bit ESP-IDF 6.
    val config = nativeStackAllocate(32)
    nativeAddressClear(config, 32)
    nativeAddressStoreU32(config, 0, port)
    nativeAddressStoreU32(config, 4, sda)
    nativeAddressStoreU32(config, 8, scl)
    nativeAddressStoreU8(config, 16, 7)
    nativeAddressStoreU32(config, 28, 1)

    val handleCell = nativeStackAllocate(4)
    nativeAddressStoreU32(handleCell, 0, 0)
    val status = i2c_new_master_bus(
        nativePointerFromAddress(config),
        nativePointerFromAddress(handleCell)
    )
    val handle = if (status == 0) nativeAddressLoadU32(handleCell, 0) else 0
    if (handle != 0) setStoredI2cBus(port, handle, pins)
    I2cBus(handle)
}

fun I2cBus.valid(): bool = this != 0

trusted fun I2cBus.close(): bool {
    if (this == 0) return false
    val status = i2c_del_master_bus(nativePointerFromAddress(this))
    if (status == 0) {
        if (idf6I2cBus0 == this) setStoredI2cBus(0, 0, -1)
        if (idf6I2cBus1 == this) setStoredI2cBus(1, 0, -1)
    }
    status == 0
}

trusted fun I2cBus.probe(
    address: int,
    timeoutMilliseconds: int = 50
): bool =
    this != 0 && address >= 0 && address < 128 && i2c_master_probe(
        nativePointerFromAddress(this), address, timeoutMilliseconds
    ) == 0

trusted fun I2cBus.device(
    address: int,
    frequency: int = 400000
): I2cDevice {
    if (this == 0 || address < 0 || address >= 128 || frequency <= 0) {
        return I2cDevice(0)
    }
    // i2c_device_config_t on 32-bit ESP-IDF 6.
    val config = nativeStackAllocate(20)
    nativeAddressClear(config, 20)
    nativeAddressStoreU16(config, 4, address)
    nativeAddressStoreU32(config, 8, frequency)
    val handleCell = nativeStackAllocate(4)
    nativeAddressStoreU32(handleCell, 0, 0)
    val status = i2c_master_bus_add_device(
        nativePointerFromAddress(this),
        nativePointerFromAddress(config),
        nativePointerFromAddress(handleCell)
    )
    I2cDevice(if (status == 0) nativeAddressLoadU32(handleCell, 0) else 0)
}

fun I2cDevice.valid(): bool = this != 0

trusted fun I2cDevice.close(): bool =
    this != 0 && i2c_master_bus_rm_device(
        nativePointerFromAddress(this)
    ) == 0

trusted fun I2cDevice.write(
    source: NativeBuffer,
    length: int,
    timeoutMilliseconds: int = 1000
): bool =
    this != 0 && length >= 0 && length <= source.capacity() &&
        i2c_master_transmit(
            nativePointerFromAddress(this), source.pointer(), length,
            timeoutMilliseconds
        ) == 0

trusted fun I2cDevice.read(
    destination: NativeBuffer,
    length: int,
    timeoutMilliseconds: int = 1000
): bool =
    this != 0 && length >= 0 && length <= destination.capacity() &&
        i2c_master_receive(
            nativePointerFromAddress(this), destination.pointer(), length,
            timeoutMilliseconds
        ) == 0

trusted fun I2cDevice.writeRead(
    source: NativeBuffer,
    sourceLength: int,
    destination: NativeBuffer,
    destinationLength: int,
    timeoutMilliseconds: int = 1000
): bool =
    this != 0 && sourceLength >= 0 &&
        sourceLength <= source.capacity() && destinationLength >= 0 &&
        destinationLength <= destination.capacity() &&
        i2c_master_transmit_receive(
            nativePointerFromAddress(this), source.pointer(), sourceLength,
            destination.pointer(), destinationLength, timeoutMilliseconds
        ) == 0

trusted fun I2cDevice.readRegister(
    register: int,
    destination: NativeBuffer,
    length: int,
    timeoutMilliseconds: int = 1000
): bool {
    val registerCell = nativeStackAllocate(1)
    nativeAddressStoreU8(registerCell, 0, register)
    this != 0 && length >= 0 && length <= destination.capacity() &&
        i2c_master_transmit_receive(
            nativePointerFromAddress(this),
            nativePointerFromAddress(registerCell), 1,
            destination.pointer(), length, timeoutMilliseconds
        ) == 0
}

trusted fun I2cDevice.writeRegister(
    register: int,
    source: NativeBuffer,
    length: int,
    timeoutMilliseconds: int = 1000
): bool {
    if (this == 0 || length < 0 || length > source.capacity()) return false
    val registerCell = nativeStackAllocate(1)
    nativeAddressStoreU8(registerCell, 0, register)
    // Two 32-bit pointer/size pairs avoid copying the payload merely to add a
    // one-byte register prefix.
    val buffers = nativeStackAllocate(16)
    nativeAddressStoreU32(buffers, 0, registerCell)
    nativeAddressStoreU32(buffers, 4, 1)
    nativeAddressStoreU32(buffers, 8, source.addressValue())
    nativeAddressStoreU32(buffers, 12, length)
    i2c_master_multi_buffer_transmit(
        nativePointerFromAddress(this), nativePointerFromAddress(buffers), 2,
        timeoutMilliseconds
    ) == 0
}

trusted fun I2cDevice.readRegister8(
    register: int,
    fallback: int = 0
): int {
    val byte = nativeStackAllocate(1)
    nativeAddressStoreU8(byte, 0, fallback)
    val registerCell = nativeStackAllocate(1)
    nativeAddressStoreU8(registerCell, 0, register)
    var status = -1
    if (this != 0) {
        status = i2c_master_transmit_receive(
            nativePointerFromAddress(this),
            nativePointerFromAddress(registerCell), 1,
            nativePointerFromAddress(byte), 1, 1000
        )
    }
    if (status == 0) ablaUnsafeLoadU8(nativePointerFromAddress(byte))
    else fallback
}

trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    val byte = nativeStackAllocate(1)
    val registerCell = nativeStackAllocate(1)
    nativeAddressStoreU8(registerCell, 0, register)
    var status = -1
    if (this != 0) status = i2c_master_transmit_receive(
        nativePointerFromAddress(this),
        nativePointerFromAddress(registerCell), 1,
        nativePointerFromAddress(byte), 1, 1000
    )
    I2cByteResult(
        if (status == 0) 256 | ablaUnsafeLoadU8(
            nativePointerFromAddress(byte)
        ) else 0
    )
}

trusted fun I2cDevice.writeRegister8(register: int, value: int): bool {
    val bytes = nativeStackAllocate(2)
    nativeAddressStoreU8(bytes, 0, register)
    nativeAddressStoreU8(bytes, 1, value)
    this != 0 && i2c_master_transmit(
        nativePointerFromAddress(this), nativePointerFromAddress(bytes), 2,
        1000
    ) == 0
}

trusted fun I2cDevice.readRegister16BigEndianChecked(
    register: int
): I2cWordResult {
    val address = nativeStackAllocate(2)
    val bytes = nativeBufferAt(address, 2)
    if (!this.readRegister(register, bytes, 2)) return I2cWordResult(0)
    I2cWordResult(65536 | (bytes.load(0) << 8) | bytes.load(1))
}

trusted fun I2cDevice.writeRegister16BigEndian(
    register: int,
    value: int
): bool {
    val address = nativeStackAllocate(2)
    val bytes = nativeBufferAt(address, 2)
    bytes.store(0, value >>> 8)
    bytes.store(1, value)
    this.writeRegister(register, bytes, 2)
}

trusted fun I2cDevice.updateRegister8(
    register: int,
    mask: int,
    value: int
): bool {
    val current = this.readRegister8Checked(register)
    if (!current.valid()) return false
    val selected = mask & 255
    this.writeRegister8(
        register,
        (current.value() & (255 - selected)) | (value & selected)
    )
}
