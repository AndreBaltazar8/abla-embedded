import "./reference_clock_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4ReferenceClockRead(offset: int): u32 = u32(mmioLoadU32(0x500E6000+offset))
trusted fun p4ReferenceClockWrite(offset: int,value: u32): void { mmioStoreU32(0x500E6000+offset,int(value)); return }
trusted fun esp32P4ReferenceClockRead(mhz: int): int = esp32P4ReferenceClockReadOwned(mhz)
trusted fun esp32P4ReferenceClockSet(mhz: int,enable: bool): int = esp32P4ReferenceClockSetOwned(mhz,enable)
