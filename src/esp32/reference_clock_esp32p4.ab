import "./reference_clock_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("p4ReferenceClockRead")
trusted fun p4ReferenceClockReadHook(offset: int): u32 = u32(mmioLoadU32(0x500E6000+offset))
@export("p4ReferenceClockWrite")
trusted fun p4ReferenceClockWriteHook(offset: int,value: u32): void { mmioStoreU32(0x500E6000+offset,int(value)); return }
trusted fun esp32P4ReferenceClockRead(mhz: int): int = esp32P4ReferenceClockReadOwned(mhz)
trusted fun esp32P4ReferenceClockSet(mhz: int,enable: bool): int = esp32P4ReferenceClockSetOwned(mhz,enable)
