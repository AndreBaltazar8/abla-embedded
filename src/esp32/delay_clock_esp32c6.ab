import "./delay_clock_c6_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../hal/esp32.ab"
@export("c6DelayClockRead")
trusted fun c6DelayClockReadHook(address: int): int = mmioLoadU32(address)
// IDF6 C6 ROM ets_update_cpu_frequency. Retains a changed ROM setting on
// clock-change failure: resolve that failure before permitting any delay user.
@export("c6DelayClockSetRomTicks")
trusted fun c6DelayClockSetRomTicksHook(ticks: int): void { callNativeVoidI32(0x40000048,ticks);return }
