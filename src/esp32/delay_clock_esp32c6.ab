import "./delay_clock_c6_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
trusted fun c6DelayClockRead(address: int): int = mmioLoadU32(address)
// IDF6 C6 ROM ets_update_cpu_frequency. Retains a changed ROM setting on
// clock-change failure: resolve that failure before permitting any delay user.
trusted fun c6DelayClockSetRomTicks(ticks: int): void { callNativeVoidI32(0x40000048,ticks);return }
