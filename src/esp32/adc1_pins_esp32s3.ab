import "./adc1_pins_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("esp32S3AdcPadRead")
trusted fun esp32S3AdcPadReadHook(address: int): int = mmioLoadU32(address)
@export("esp32S3AdcPadWrite")
trusted fun esp32S3AdcPadWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
