import "./gpio_esp32c6.ab"
import "./peripheral_delay_esp32c6.ab"
import "../spi/software_transaction.ab"
import "../spi/software_command.ab"
import "../spi/software_shared_checked.ab"
import "../spi/software_sd_mode.ab"
// Native C6 transport for the shared software SPI API, modes0..3.
// No opaque driver or allocator. Caller owns/configures pins, clocks,
// calibrated timing and canonical PeripheralGate before transactions.
// Software timing is an upper frequency bound, not hardware SPI/DMA support.
// Shared D/C-MISO commands use checked direction setup/cleanup and fault-gated
// explicit recovery; the legacy void direction-change API is not imported.
