import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "./gdma_clock_c6_sequence.ab"
trusted fun c6GdmaBusRead(): u32 = u32(mmioLoadU32(0x600960bc))
trusted fun c6GdmaBusWrite(value: u32): void { mmioStoreU32(0x600960bc,int(value));return }
trusted fun c6GdmaRead(offset: int): u32 = u32(mmioLoadU32(0x60080000+offset))
trusted fun c6GdmaWrite(offset: int,value: u32): void { mmioStoreU32(0x60080000+offset,int(value));return }
