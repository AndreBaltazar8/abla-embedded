import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "./gdma_clock_c6_sequence.ab"
import "../hal/esp32.ab"
@export("c6GdmaBusRead")
trusted fun c6GdmaBusReadHook(): u32 = u32(mmioLoadU32(0x600960bc))
@export("c6GdmaBusWrite")
trusted fun c6GdmaBusWriteHook(value: u32): void { mmioStoreU32(0x600960bc,int(value));return }
@export("c6GdmaRead")
trusted fun c6GdmaReadHook(offset: int): u32 = u32(mmioLoadU32(0x60080000+offset))
@export("c6GdmaWrite")
trusted fun c6GdmaWriteHook(offset: int,value: u32): void { mmioStoreU32(0x60080000+offset,int(value));return }
