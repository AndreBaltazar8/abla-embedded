// HP_SYS_CLKRST offsets verified against IDF6 hw_ver1 and hw_ver3.
// Entire call MUST hold the caller's cross-core RCC critical section.
// Source oscillators/PLLs are borrowed, already stable and pinned on; these
// functions only route/gate DSI clocks. Never power down a shared source.
// hwVersion is the verified register-layout version (1 or 3), not a guess.
// cfgSource:0 PLL20M,1 RC_FAST,2 PLL25M. On v1 this also IS the reference
// source, and no reference divider exists. On v3 refSource:0 XTAL,1 APLL,
// 2 CPLL,3 SPLL,4 MPLL; referenceDiv1..256.
// 1complete,2invalid,3preexisting owner,4partial setup/readback failure.
// On4 only RCC was touched; retain the newly attempted gates for cleanup.
trusted fun esp32P4DsiClockStartOwned(hwVersion: int,cfgSource: int,refSource: int,referenceDiv: int): int {
    if ((hwVersion != 1 && hwVersion != 3) || cfgSource < 0 || cfgSource > 2 ||
        refSource < 0 || referenceDiv < 1 || referenceDiv > 256) return 2
    if ((hwVersion == 1 && (refSource != cfgSource || referenceDiv != 1)) ||
        (hwVersion == 3 && refSource > 4)) return 2
    val bus=p4DsiClockRead(24)
    val clocks=p4DsiClockRead(60)
    // Refuse to reset an existing user, including an active DPI clock.
    if ((bus&u32(4096)) != u32(0) || (clocks&u32(131)) != u32(0)) return 3
    p4DsiClockWrite(24,bus|u32(4096))
    if ((p4DsiClockRead(24)&u32(4096)) == u32(0)) return 4
    p4DsiClockWrite(192,p4DsiClockRead(192)|u32(67108864))
    if ((p4DsiClockRead(192)&u32(67108864)) == u32(0)) return 4
    p4DsiClockWrite(192,p4DsiClockRead(192)&u32(4227858431))
    if ((p4DsiClockRead(192)&u32(67108864)) != u32(0)) return 4
    p4DsiClockWrite(56,(p4DsiClockRead(56)&u32(1073741823))|(u32(cfgSource)<<u32(30)))
    if ((p4DsiClockRead(56)>>u32(30)) != u32(cfgSource)) return 4
    p4DsiClockWrite(60,p4DsiClockRead(60)|u32(1))
    if ((p4DsiClockRead(60)&u32(1)) == u32(0)) return 4
    if (hwVersion == 3) {
        p4DsiClockWrite(60,(p4DsiClockRead(60)&u32(4160815103))|
            (u32(refSource)<<u32(16))|(u32(referenceDiv-1)<<u32(19)))
        if ((p4DsiClockRead(60)&u32(134152192)) != ((u32(refSource)<<u32(16))|(u32(referenceDiv-1)<<u32(19)))) return 4
    }
    p4DsiClockWrite(60,p4DsiClockRead(60)|u32(2))
    if ((p4DsiClockRead(60)&u32(3)) != u32(3)) return 4
    return 1
}

// Only after owned host+PHY shutdown and bridge quiescence. Do not use this
// as cleanup following a refused start: those clocks belong to another user.
trusted fun esp32P4DsiClockStopOwned(): void {
    p4DsiClockWrite(60,p4DsiClockRead(60)&u32(4294967164))
    p4DsiClockWrite(24,p4DsiClockRead(24)&u32(4294963199))
    return
}
