// Import with gdma_esp32s3.ab. Caller owns this channel direction and keeps
// its clock enabled. Events are sticky/coalescing, not a completed-buffer
// counter. EOF alone does not prove an entire ring is safe to reclaim.
fun esp32s3GdmaEventMask(transmit: bool): int = if (transmit) 255 else 1023
fun esp32s3GdmaEventErrors(events: int, transmit: bool): int =
    events & (if (transmit) 244 else 988)
fun esp32s3GdmaEventEof(events: int): bool = (events & 2) != 0

// -1 means invalid channel, zero means no event. Reading never clears events.
trusted fun esp32s3GdmaEvents(channel: int, transmit: bool): int {
    val base = esp32s3GdmaChannelBase(channel, transmit)
    if (base == 0) return -1
    esp32s3GdmaRead(base + 8) & esp32s3GdmaEventMask(transmit)
}

// W1C: clear only explicitly consumed events, never read-modify-write this
// register. Serialize acknowledgments with the channel's ISR/polling owner.
trusted fun esp32s3GdmaAcknowledge(channel: int, transmit: bool, events: int): bool {
    val base = esp32s3GdmaChannelBase(channel, transmit)
    val mask = esp32s3GdmaEventMask(transmit)
    if (base == 0 || events < 0 || events > mask) return false
    if (events != 0) esp32s3GdmaWrite(base + 20, events)
    true
}

// A snapshot of the last successful EOF descriptor, not a lifetime guarantee.
// Read after observing EOF; a running circular chain may advance again.
trusted fun esp32s3GdmaEofDescriptor(channel: int, transmit: bool): int {
    val base = esp32s3GdmaChannelBase(channel, transmit)
    if (base == 0) return 0
    esp32s3GdmaRead(base + 40)
}
