// Cold/bootstrap setup of the WHOLE AHB controller, not a per-channel open.
// Caller owns all six directions, RCC, global windows, ISR/ETM/PMS/power users;
// no configured client may resume across this reset. Refuses any active/pending
// channel or interrupt evidence before resetting. No implicit close/clock gate.
// 1 ready,2 invalid/unowned,3 reset already asserted,4 bus-clock readback,
// 5 active/pending direction,6 event/IRQ evidence,7 reset assertion readback,
// 8 reset deassertion,9 misc clock/arbitration,10 window-start,11 window-end.
// Failure retains controller ownership; bus clock may already be enabled and
// reset/window state may be partial. No automatic rollback or event clearing.
trusted fun esp32p4AhbGdmaControllerInitializeOwned(low: int,high: int,exclusive: bool): int {
    if (!exclusive || low < 0x40000000 || high > 0x4ffc0000 || high <= low ||
        (low & 63) != 0 || (high & 63) != 0) return 2
    val reset=0x500e60c4
    if ((p4AhbControllerRead(reset)&2) != 0) return 3
    if (!p4AhbControllerField(0x500e6018,8,8)) return 4
    var channel=0
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            val base=0x50085070+channel*192+direction*96
            if ((p4AhbControllerRead(base+16)&(if (direction == 1) 15 else 30)) != (if (direction == 1) 8 else 16) ||
                (p4AhbControllerRead(base)&1) != 0) return 5
            val events=0x50085000+channel*16+direction*48
            if (p4AhbControllerRead(events) != 0 || p4AhbControllerRead(events+8) != 0) return 6
            direction=direction+1
        }
        channel=channel+1
    }
    if (!p4AhbControllerField(reset,2,2)) return 7
    if (!p4AhbControllerField(reset,2,0)) return 8
    // Force register clock, fixed-priority arbitration enabled, internal reset off.
    if (!p4AhbControllerField(0x50085064,13,8)) return 9
    if (!p4AhbControllerField(0x500853c4,0xffffffff,low)) return 10
    if (!p4AhbControllerField(0x500853c8,0xffffffff,high)) return 11
    p4AhbControllerFence()
    return 1
}
trusted fun p4AhbControllerField(address: int,mask: int,value: int): bool {
    p4AhbControllerWrite(address,(p4AhbControllerRead(address)&(0xffffffff ^ mask))|value)
    return (p4AhbControllerRead(address)&mask) == value
}
