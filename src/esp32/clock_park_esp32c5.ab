import "./clock_park_c5_sequence.ab"
import "./cpu_clock_esp32c5.ab"
import "./power/pvt_park_esp32c5.ab"
@section(".iram1.abla.c5ClockParkPvtActive")
trusted fun c5ClockParkPvtActive(): bool {
    val revision=mmioLoadU32(0x600b484c)
    return ((revision>>11)&3)*100+((revision>>8)&7) >= 2 &&
        (mmioLoadU32(0x600960b8)&3) == 1 && (mmioLoadU32(0x600960bc)&0x400000) != 0 &&
        (mmioLoadU32(0x60019064)&0x80000000) != 0 && (mmioLoadU32(0x600b0028)&0x4000) == 0
}
@section(".iram1.abla.c5ClockParkPvt")
trusted fun c5ClockParkPvt(record: NativeBuffer): int = esp32C5PvtParkOwned(record,true)
