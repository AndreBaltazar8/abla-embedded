import "./scheduler_run_s3_sequence.ab"
import "./scheduler_select_esp32s3.ab"
import "../xtensa/critical_lock.ab"
@inline
trusted fun esp32S3SchedulerRunRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3SchedulerRunWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3SchedulerRunCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3SchedulerRunStatus(): int = xtensaGuardStatus()
@inline
trusted fun esp32S3SchedulerRunLock(lock: NativeBuffer): XtensaInterruptGuard = xtensaCriticalLockTry(lock)
@inline
trusted fun esp32S3SchedulerRunUnlock(lock: NativeBuffer,guard: XtensaInterruptGuard): bool = xtensaCriticalLockRelease(lock,guard)
@inline
trusted fun esp32S3SchedulerRunSelect(queue: NativeBuffer,records: NativeBuffer,running: NativeBuffer,current: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,core: int,level: int): int =
    esp32S3SchedulerSelectOwned(queue,records,running,current,owners,frame,core,level)
// Install this address through SchedulerIrqInstallOwned. Negative outcomes use
// a deterministic masked fatal stop, with lastResult available in the context;
// never return into potentially inconsistent ownership after rollback failure.
@section(".iram1.abla.s3SchedulerRunCallback")
trusted fun esp32S3SchedulerRunCallback(frame: u32,level: u32,core: u32,context: u32): void {
    val result=esp32S3SchedulerRunOwned(nativeBufferAt(int(context),44),nativeBufferAt(int(frame),192),int(core),int(level))
    if (result < 0) {
        while (true) { xtensaGuardRead("rsil $0, 15\nwaiti 15","=a,~{memory}") }
    }
    return
}
@inline
trusted fun esp32S3SchedulerRunAddress(): int = nativeFunctionAddress(esp32S3SchedulerRunCallback)
