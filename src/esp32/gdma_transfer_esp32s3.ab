import "./sdk/raw_buffer.ab"

// CPU buffers must be caller-owned and disjoint from the ENTIRE DMA ring.
// Bounds below additionally reject overlap with this descriptor/payload.
// Return transferred bytes; -1 invalid descriptor, -2 still DMA-owned,
// -3 bad metadata/length, -4 caller buffer bounds/overlap, -5 rearm failed.
// On -5 the copy already occurred, but storage remains CPU-owned. No waiting
// or DMA restart is hidden here: caller handles underrun/overrun separately.
trusted fun esp32s3GdmaTransferBuffer(descriptor: int, buffer: NativeBuffer,
    transmit: bool, transmitBytes: int, eof: bool): int {
    val completed = esp32s3GdmaCompletedBytes(descriptor)
    if (completed < 0) return completed
    val flags = esp32s3GdmaRead(descriptor)
    val capacity = flags & 4095
    val count = if (transmit) transmitBytes else completed
    if (count < 1 || count > capacity || (!transmit && (transmitBytes != 0 || eof))) return -3
    val payload = esp32s3GdmaRead(descriptor + 4)
    val next = esp32s3GdmaRead(descriptor + 8)
    if (payload < 0x3fc88000 || (payload & 3) != 0 || payload > 0x3fd00000 - capacity ||
        (next != 0 && !esp32s3GdmaDescriptorValid(next))) return -3
    if (!buffer.hasAddressRange(0, count)) return -4
    val address = buffer.addressValue()
    val end = address + count
    if ((address < descriptor + 12 && end > descriptor) ||
        (address < payload + capacity && end > payload)) return -4
    if (transmit) esp32s3GdmaCopyBytes(payload, address, count)
    else esp32s3GdmaCopyBytes(address, payload, count)
    if (!esp32s3GdmaRearm(descriptor, transmit, if (transmit) count else 0, if (transmit) eof else false)) return -5
    count
}
