import "./cache_autoload_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("p4CacheAutoloadRead")
trusted fun p4CacheAutoloadReadHook(offset: int): int = mmioLoadU32(0x3ff10000+offset)
@export("p4CacheAutoloadWrite")
trusted fun p4CacheAutoloadWriteHook(offset: int,value: int): void { mmioStoreU32(0x3ff10000+offset,value); return }
trusted noescape extern:"inline-assembly" fun p4CacheAutoloadAsm(template: string,constraints: string): void
@export("p4CacheAutoloadFence")
trusted fun p4CacheAutoloadFenceHook(): void = p4CacheAutoloadAsm("fence iorw, iorw","~{memory}")
