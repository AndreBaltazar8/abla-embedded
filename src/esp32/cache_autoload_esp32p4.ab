import "./cache_autoload_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4CacheAutoloadRead(offset: int): int = mmioLoadU32(0x3ff10000+offset)
trusted fun p4CacheAutoloadWrite(offset: int,value: int): void { mmioStoreU32(0x3ff10000+offset,value); return }
trusted noescape extern:"inline-assembly" fun p4CacheAutoloadAsm(template: string,constraints: string): void
trusted fun p4CacheAutoloadFence(): void = p4CacheAutoloadAsm("fence iorw, iorw","~{memory}")
