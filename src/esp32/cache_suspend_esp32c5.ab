import "./cache_suspend_c5_sequence.ab"
import "abla/unsafe/native"
// ESP32-C5 M-mode MHCR (not a portable RISC-V CSR). Hardware ROM boundaries
// from esp32c5.rom.ld; no linked cache HAL or software enable-state emulation.
trusted noescape extern:"inline-assembly" fun c5CacheCsrClear(template: string,constraints: string,mask: u32): u32
trusted noescape extern:"inline-assembly" fun c5CacheCsrSet(template: string,constraints: string,mask: u32): void
@inline
trusted fun c5CachePredictorDisable(): int =
    int(c5CacheCsrClear("csrrc $0, 0x7c1, $1","=r,r,~{memory}",u32(0x1030)))
@inline
trusted fun c5CachePredictorRestore(saved: int): void {
    c5CacheCsrSet("csrs 0x7c1, $0","r,~{memory}",u32(saved))
    return
}
@inline
trusted fun c5CacheRomSuspend(): int = callNativeU32Zero(0x400006b4)
@inline
trusted fun c5CacheRomResume(saved: int): void {
    callNativeVoidI32(0x400006b8,saved)
    return
}
