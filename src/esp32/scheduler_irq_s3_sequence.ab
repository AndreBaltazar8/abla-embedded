import "./sdk/raw_buffer.ab"
// Optional adapter over an already installed IRQ runtime. Caller owns immutable
// record12: runtimeRecord0, schedulingCallback4, callbackContext8. Install/remove
// only during serialized boot with local INTENABLE=0; no storage is allocated.
// Scheduling callback ABI void(u32 frame,u32 level,u32 core,u32 context).
// Called only after successful drain, at depth1 and INTLEVEL15. It owns scheduler
// locking, CP detach/reattach, and final frame selection; no interrupt enable or
// further dispatch is permitted after selection. Return goes directly to shell.
// This is not a ready queue or scheduler policy. Nested callbacks only drain.
@section(".iram1.abla.s3SchedulerIrqDispatch")
trusted fun esp32S3SchedulerIrqDispatch(frame: int,level: int,core: int,record: int): void {
    esp32S3SchedulerIrqDrain(frame,level,core,esp32S3SchedulerIrqRead(record))
    esp32S3SchedulerIrqMask()
    if (esp32S3SchedulerIrqRead(esp32S3SchedulerIrqConfig()+core*32+4) == 1)
        esp32S3SchedulerIrqCall(esp32S3SchedulerIrqRead(record+4),frame,level,core,esp32S3SchedulerIrqRead(record+8))
    // Shell immediately masks and restores saved PS. Do not unmask here: a
    // selected task's ownership may already differ from the interrupted task.
    return
}
@inline
fun esp32S3SchedulerIrqBuffer(buffer: NativeBuffer,size: int): bool = buffer.hasAddressRange(0,size) &&
    (buffer.addressValue() & 3) == 0 && buffer.addressValue() >= 0x3FC88000 && buffer.addressValue()+size <= 0x3FD00000
@inline
fun esp32S3SchedulerIrqOverlap(a: int,an: int,b: int,bn: int): bool = a < b+bn && b < a+an
@section(".iram1.abla.s3SchedulerIrqInstall")
trusted fun esp32S3SchedulerIrqInstallOwned(record: NativeBuffer,runtime: NativeBuffer,core: int,callback: int,context: int): bool {
    if (core < 0 || core > 1 || esp32S3SchedulerIrqCore() != core || esp32S3SchedulerIrqEnabled() != 0 ||
        !esp32S3SchedulerIrqBuffer(record,12) || !esp32S3SchedulerIrqBuffer(runtime,16) ||
        callback < 0x40370000 || callback >= 0x403E0000 || (callback & 3) != 0 || context < 0 || context > 0xFFFFFFFF) return false
    val rec=record.addressValue()
    val run=runtime.addressValue()
    val cfg=esp32S3SchedulerIrqConfig()
    val entry=cfg+core*32
    if (esp32S3SchedulerIrqRead(entry) == 0 || esp32S3SchedulerIrqRead(entry+4) != 0 ||
        esp32S3SchedulerIrqRead(entry+8) != esp32S3SchedulerIrqRuntimeAddress() || esp32S3SchedulerIrqRead(entry+12) != run ||
        esp32S3SchedulerIrqOverlap(rec,12,run,16) || esp32S3SchedulerIrqOverlap(rec,12,cfg,64) ||
        esp32S3SchedulerIrqOverlap(rec,12,esp32S3SchedulerIrqRead(run),512)) return false
    // Exclude both live ISR stacks and peer runtime/adapter data. Other live
    // task, policy and application storage must remain disjoint by ownership.
    var peer=0
    while (peer < 2) {
        val p=cfg+peer*32
        val low=esp32S3SchedulerIrqRead(p+16)
        val end=esp32S3SchedulerIrqRead(p+20)
        if (rec < end && low < rec+12) return false
        if (peer != core && esp32S3SchedulerIrqRead(p) != 0) {
            val handler=esp32S3SchedulerIrqRead(p+8)
            val data=esp32S3SchedulerIrqRead(p+12)
            if (handler == esp32S3SchedulerIrqAddress()) {
                if (esp32S3SchedulerIrqOverlap(rec,12,data,12)) return false
                val other=esp32S3SchedulerIrqRead(data)
                if (esp32S3SchedulerIrqOverlap(rec,12,other,16) ||
                    esp32S3SchedulerIrqOverlap(rec,12,esp32S3SchedulerIrqRead(other),512)) return false
            } else if (handler == esp32S3SchedulerIrqRuntimeAddress()) {
                if (esp32S3SchedulerIrqOverlap(rec,12,data,16) ||
                    esp32S3SchedulerIrqOverlap(rec,12,esp32S3SchedulerIrqRead(data),512)) return false
            }
        }
        peer=peer+1
    }
    esp32S3SchedulerIrqWrite(rec,run)
    esp32S3SchedulerIrqWrite(rec+4,callback)
    esp32S3SchedulerIrqWrite(rec+8,context)
    esp32S3SchedulerIrqWrite(entry+12,rec)
    esp32S3SchedulerIrqWrite(entry+8,esp32S3SchedulerIrqAddress())
    true
}
@section(".iram1.abla.s3SchedulerIrqRemove")
trusted fun esp32S3SchedulerIrqRemoveOwned(record: NativeBuffer,core: int): bool {
    if (core < 0 || core > 1 || esp32S3SchedulerIrqCore() != core || esp32S3SchedulerIrqEnabled() != 0 ||
        !esp32S3SchedulerIrqBuffer(record,12)) return false
    val entry=esp32S3SchedulerIrqConfig()+core*32
    if (esp32S3SchedulerIrqRead(entry+4) != 0 || esp32S3SchedulerIrqRead(entry+8) != esp32S3SchedulerIrqAddress() ||
        esp32S3SchedulerIrqRead(entry+12) != record.addressValue()) return false
    esp32S3SchedulerIrqWrite(entry+12,esp32S3SchedulerIrqRead(record.addressValue()))
    esp32S3SchedulerIrqWrite(entry+8,esp32S3SchedulerIrqRuntimeAddress())
    true
}
