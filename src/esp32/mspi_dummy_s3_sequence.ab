// kind: 0 quad/dual/single flash, 1 octal flash, 2 quad PSRAM, 3 octal PSRAM.
// SPI0/1 flash supported; PSRAM cache timing is owned through SPI0 only.
type Esp32S3MspiDummy = int
@inline
fun Esp32S3MspiDummy.valid(): bool = (this & 1024) != 0
@section(".iram1.abla.s3DummyValid")
fun esp32S3MspiDummyArgs(kind: int,port: int): bool = kind >= 0 && kind <= 3 && port >= 0 && port <= 1 && (kind < 2 || port == 0)

@section(".iram1.abla.s3DummyCapture")
trusted fun esp32S3MspiDummyCaptureOwned(kind: int,port: int): Esp32S3MspiDummy {
    if (!esp32S3MspiDummyArgs(kind,port)) return Esp32S3MspiDummy(0)
    val base=if (port == 0) 0x60003000 else 0x60002000
    var fields=0
    if (kind == 0) {
        val enabled=(esp32S3MspiDummyRead(base+24)>>>29) & 1
        fields=(esp32S3MspiDummyRead(base+28) & 63) | (enabled<<6)
    } else if (kind == 2) {
        val value=esp32S3MspiDummyRead(base+64)
        fields=((value>>>6) & 63) | (((value>>>4) & 1)<<6)
    } else {
        val value=esp32S3MspiDummyRead(base+(if (kind == 1) 168 else 188))
        fields=((value>>>2) & 7) | (((value>>>1) & 1)<<6)
    }
    Esp32S3MspiDummy(fields | (kind<<7) | (port<<9) | 1024)
}

// Exclusive MSPI ownership and cache/internal-memory preconditions as DIN.
// The token records its register target; reserved and unrelated fields survive.
@section(".iram1.abla.s3DummyRestore")
trusted fun esp32S3MspiDummyRestoreOwned(token: Esp32S3MspiDummy): bool {
    if (!token.valid()) return false
    val kind=(token>>>7) & 3
    val port=(token>>>9) & 1
    if (!esp32S3MspiDummyArgs(kind,port)) return false
    val count=token & 63
    val enabled=(token>>>6) & 1
    val base=if (port == 0) 0x60003000 else 0x60002000
    if (kind == 0) {
        esp32S3MspiDummyUpdate(base+24,1<<29,enabled<<29)
        esp32S3MspiDummyUpdate(base+28,63,count)
    } else if (kind == 2) esp32S3MspiDummyUpdate(base+64,(63<<6) | 16,(count<<6) | (enabled<<4))
    else {
        if (count > 7) return false
        esp32S3MspiDummyUpdate(base+(if (kind == 1) 168 else 188),30,(count<<2) | (enabled<<1))
    }
    true
}

// For quad flash baselineEncoded includes protocol dummy and any ROM/HPM
// adjustment; owner must also synchronize ROM dummy state if it uses ROM flash
// commands. Quad PSRAM's standard six-cycle read baseline is encoded5.
// Octal uses a separate EXTRA field: baselineEncoded must0; protocol untouched.
@section(".iram1.abla.s3DummySet")
trusted fun esp32S3MspiDummySetOwned(kind: int,port: int,baselineEncoded: int,extra: int): bool {
    if (!esp32S3MspiDummyArgs(kind,port) || baselineEncoded < 0 || baselineEncoded > 63 || extra < 0 || extra > 63) return false
    val octal=(kind & 1) != 0
    if (octal && (baselineEncoded != 0 || extra > 7)) return false
    val count=baselineEncoded+extra
    if (count > 63) return false
    val enabled=if (!octal || extra != 0) 64 else 0
    esp32S3MspiDummyRestoreOwned(Esp32S3MspiDummy(count | enabled | (kind<<7) | (port<<9) | 1024))
}
