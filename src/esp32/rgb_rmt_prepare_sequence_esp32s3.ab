// Exclusive initialization, not live reconfiguration: caller owns ALL stopped
// RMT channels and the output pad, with stable APB80MHz and calibrated ROM
// delay. Pad must be released from RTC/USB/other peripherals. GDMA must be
// parked; no peripheral reset pulses, DMA START, or waveform writes occur.
// Shared clocks stay powered on failures; no implicit rollback of other pads.
// Status:1 ready,2 invalid,3 RMTbus,4 GDMAbus,5 busy,6 groupstop,
// 7 clocksource,8 memory,9 channel,10 padroute,11 groupstart.
trusted fun esp32s3RmtPrepareRgbDmaOwned(output: Pin, dmaChannel: int, owner: u32): int {
    if (!output.outputCapable() || dmaChannel < 0 || dmaChannel > 4 || owner == u32(0)) return 2
    if (!esp32s3RmtEnableBusClock(owner)) return 3
    if (!esp32s3GdmaEnableClock(owner)) return 4
    if (!esp32s3GdmaParked(dmaChannel, true)) return 5
    if (!esp32s3RmtSetGroupClockOwned(false, owner)) return 6
    if (!esp32s3RmtConfigureClock(1, 1, 0, 0, owner)) return 7
    if (!esp32s3RmtPrepareMemory(owner)) return 8
    if (!esp32s3RmtConfigureSingleBlockTxOwned(3, 8)) return 9
    // Idle-low is established before the output route can drive the pad.
    if (!output.routeOutputSignal(84, false)) return 10
    if (!esp32s3RmtSetGroupClockOwned(true, owner)) return 11
    1
}
