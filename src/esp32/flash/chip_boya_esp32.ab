trusted fun esp32FlashBoyaGetCaps(chip:u32):u32 = u32(4)

trusted fun esp32FlashBoyaProbe(chip:u32, flashId:u32):u32 {
    if ((flashId >>> u32(16)) != u32(0x68)) return u32(261)
    if ((flashId & u32(0xff00)) != u32(0x4000)) return u32(261)
    u32(0)
}

