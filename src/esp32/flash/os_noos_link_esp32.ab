import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashOsNoosInternals(): bool {
    if (!internalFunction("esp32RecoveredGetTempBufferNotSupported", "get_temp_buffer_not_supported")) return false
    if (!internalFunction("esp32RecoveredEspFlashAppDisableOsFunctions", "esp_flash_app_disable_os_functions")) return false
    true
}
