import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashHalIramOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredSpiFlashHalPollCmdDone", "spi_flash_hal_poll_cmd_done")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalDeviceConfig", "spi_flash_hal_device_config")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalConfigureHostIoMode", "spi_flash_hal_configure_host_io_mode")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalCommonCommand", "spi_flash_hal_common_command")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalRead", "spi_flash_hal_read")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalEraseChip", "spi_flash_hal_erase_chip")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalEraseSector", "spi_flash_hal_erase_sector")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalEraseBlock", "spi_flash_hal_erase_block")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalProgramPage", "spi_flash_hal_program_page")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalSetWriteProtect", "spi_flash_hal_set_write_protect")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalCheckStatus", "spi_flash_hal_check_status")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalSetupReadSuspend", "spi_flash_hal_setup_read_suspend")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalResume", "spi_flash_hal_resume")) return false
    if (!exportFunction("esp32RecoveredSpiFlashHalSuspend", "spi_flash_hal_suspend")) return false
    true
}
