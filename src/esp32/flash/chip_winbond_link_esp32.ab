import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashChipWinbondInternals(): bool {
    if (!internalFunction("esp32RecoveredSpiFlashChipWinbondProbe", "spi_flash_chip_winbond_probe")) return false
    if (!internalFunction("esp32RecoveredSpiFlashChipWinbondGetCaps", "spi_flash_chip_winbond_get_caps")) return false
    if (!internalFunction("esp32RecoveredSpiFlashChipWinbondSuspendCmdConf", "spi_flash_chip_winbond_suspend_cmd_conf")) return false
    if (!internalFunction("esp32RecoveredSpiFlashChipWinbondPageProgram", "spi_flash_chip_winbond_page_program")) return false
    if (!internalFunction("esp32RecoveredSpiFlashChipWinbondEraseSector", "spi_flash_chip_winbond_erase_sector")) return false
    if (!internalFunction("esp32RecoveredSpiFlashChipWinbondEraseBlock", "spi_flash_chip_winbond_erase_block")) return false
    if (!internalFunction("esp32RecoveredSpiFlashChipWinbondRead", "spi_flash_chip_winbond_read")) return false
    true
}
