import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashSpiInitInternals(): bool {
    if (!internalFunction("esp32RecoveredSpiBusRemoveFlashDevice", "spi_bus_remove_flash_device")) return false
    if (!internalFunction("esp32RecoveredSpiBusAddFlashDevice", "spi_bus_add_flash_device")) return false
    if (!internalFunction("esp32RecoveredEspFlashInitDefaultChip", "esp_flash_init_default_chip")) return false
    if (!internalFunction("esp32RecoveredEspFlashAppInit", "esp_flash_app_init")) return false
    if (!internalFunction("esp32RecoveredEspFlashSpiInitIncludeFunc", "esp_flash_spi_init_include_func")) return false
    true
}
