import "./speed_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_flash.ab"
trusted noescape extern:"inline-assembly" fun p4FlashSpeedAsm(template: string,constraints: string): void
@export("p4FlashSpeedFence")
trusted fun p4FlashSpeedFenceHook(): void = p4FlashSpeedAsm("fence iorw, iorw","~{memory}")
@export("p4FlashSpeedRead")
trusted fun p4FlashSpeedReadHook(offset: int): int = mmioLoadU32(0x5008c000+offset)
@export("p4FlashSpeedWrite")
trusted fun p4FlashSpeedWriteHook(offset: int,value: int): void { mmioStoreU32(0x5008c000+offset,value);return }
@export("p4FlashSpeedRccRead")
trusted fun p4FlashSpeedRccReadHook(offset: int): int = mmioLoadU32(0x500e6000+offset)
