import "./speed_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun p4FlashSpeedAsm(template: string,constraints: string): void
trusted fun p4FlashSpeedFence(): void = p4FlashSpeedAsm("fence iorw, iorw","~{memory}")
trusted fun p4FlashSpeedRead(offset: int): int = mmioLoadU32(0x5008c000+offset)
trusted fun p4FlashSpeedWrite(offset: int,value: int): void { mmioStoreU32(0x5008c000+offset,value);return }
trusted fun p4FlashSpeedRccRead(offset: int): int = mmioLoadU32(0x500e6000+offset)
