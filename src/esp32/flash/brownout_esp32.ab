import "abla/runtime/self"
import "abla/unsafe/memory"

val esp32FlashBrownoutNeedsResetStorage = nativeStaticAllocate(1)
val esp32FlashBrownoutNeedsReset = u32(esp32FlashBrownoutNeedsResetStorage)
val esp32FlashErasingStorage = nativeStaticAllocate(1)
val esp32FlashErasing = u32(esp32FlashErasingStorage)

// g_rom_flashchip.device_id is a ROM-maintained packed field at 0x3ffae272.
trusted fun esp32FlashNeedsResetCheck():void {
    val manufacturer = u32(ablaUnsafeVolatileLoadU16(int(u32(0x3ffae272))))
    if (manufacturer == u32(0x20)) {
        ablaUnsafeStoreU8(nativePointerFromAddress(
            int(esp32FlashBrownoutNeedsReset)), int(u32(1)))
    }
}

trusted fun esp32FlashSetErasingFlag(erasing:u32):void {
    ablaUnsafeStoreU8(nativePointerFromAddress(int(esp32FlashErasing)), int(erasing))
}

trusted fun esp32FlashBrownoutNeedReset():u32 {
    val needsReset = u32(ablaUnsafeLoadU8(nativePointerFromAddress(
        int(esp32FlashBrownoutNeedsReset))))
    val erasing = u32(ablaUnsafeLoadU8(nativePointerFromAddress(
        int(esp32FlashErasing))))
    if (needsReset != u32(0) && erasing != u32(0)) u32(1) else u32(0)
}

trusted fun esp32RecoveredSpiFlashNeedsResetCheck(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32FlashNeedsResetCheck(); a2 }

trusted fun esp32RecoveredSpiFlashSetErasingFlag(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32FlashSetErasingFlag(a2); a2 }

trusted fun esp32RecoveredSpiFlashBrownoutNeedReset(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32FlashBrownoutNeedReset()
