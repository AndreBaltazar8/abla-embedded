import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashChipMxicInternals(): bool {
    if (!internalFunction("esp32FlashMxicProbe", "spi_flash_chip_mxic_probe")) return false
    if (!internalFunction("esp32FlashMxicDetectSize", "spi_flash_chip_mxic_detect_size")) return false
    if (!internalFunction("esp32FlashMxicGetCaps", "spi_flash_chip_mxic_get_caps")) return false
    true
}
