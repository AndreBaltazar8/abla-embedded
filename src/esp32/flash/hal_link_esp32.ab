import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashHalOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredSpiFlashHalInit", "spi_flash_hal_init")) return false
    if (!internalFunction("esp32RecoveredSpiFlashHalSupportsDirectWrite", "spi_flash_hal_supports_direct_write")) return false
    if (!internalFunction("esp32RecoveredSpiFlashHalSupportsDirectRead", "spi_flash_hal_supports_direct_read")) return false
    true
}
