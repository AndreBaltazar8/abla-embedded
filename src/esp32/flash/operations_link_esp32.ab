import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashOperationsInternals(): bool {
    if (!internalFunction("esp32RecoveredSpiFlashGuardSet", "spi_flash_guard_set")) return false
    if (!internalFunction("esp32RecoveredSpiFlashGuardGet", "spi_flash_guard_get")) return false
    if (!internalFunction("esp32RecoveredEspMspiPinInit", "esp_mspi_pin_init")) return false
    if (!internalFunction("esp32RecoveredSpiFlashInitChipState", "spi_flash_init_chip_state")) return false
    if (!internalFunction("esp32RecoveredSpiFlashSetRomRequiredRegs", "spi_flash_set_rom_required_regs")) return false
    if (!internalFunction("esp32RecoveredEspMspiGetIo", "esp_mspi_get_io")) return false
    if (!internalFunction("esp32RecoveredEspMspiPinReserve", "esp_mspi_pin_reserve")) return false
    if (!internalFunction("esp32RecoveredEspMspi32bitAddressFlashFeatureCheck", "esp_mspi_32bit_address_flash_feature_check")) return false
    true
}
