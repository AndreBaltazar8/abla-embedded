import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashBrownoutInternals(): bool {
    if (!internalFunction("esp32FlashNeedsResetCheck", "spi_flash_needs_reset_check")) return false
    if (!internalFunction("esp32FlashSetErasingFlag", "spi_flash_set_erasing_flag")) return false
    if (!internalFunction("esp32FlashBrownoutNeedReset", "spi_flash_brownout_need_reset")) return false
    true
}
