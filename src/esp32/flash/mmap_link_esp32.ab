import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashMmapInternals(): bool {
    if (!internalFunction("esp32RecoveredSpiFlashMmap", "spi_flash_mmap")) return false
    if (!internalFunction("esp32RecoveredSpiFlashMmapPages", "spi_flash_mmap_pages")) return false
    if (!internalFunction("esp32RecoveredSpiFlashMunmap", "spi_flash_munmap")) return false
    if (!internalFunction("esp32RecoveredSpiFlashMmapDump", "spi_flash_mmap_dump")) return false
    if (!internalFunction("esp32RecoveredSpiFlashMmapGetFreePages", "spi_flash_mmap_get_free_pages")) return false
    if (!internalFunction("esp32RecoveredSpiFlashCheckAndFlushCache", "spi_flash_check_and_flush_cache")) return false
    if (!internalFunction("esp32RecoveredSpiFlashCache2phys", "spi_flash_cache2phys")) return false
    if (!internalFunction("esp32RecoveredSpiFlashPhys2cache", "spi_flash_phys2cache")) return false
    true
}
