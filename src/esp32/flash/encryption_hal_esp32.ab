import "../dport_esp32.ab"
import "abla/unsafe/memory"

// ESP32 flash-encryption hardware interface. These are direct register
// operations expressed in Abla; there is no retained vendor HAL object.
val esp32FlashEncryptionClockRegister = u32(0x3ff000c8)
val esp32FlashEncryptionClockBits = u32(0x101)
val esp32FlashEncryptionPlaintextBase = u32(0x3ff5b000)
val esp32FlashEncryptionStartRegister = u32(0x3ff5b020)
val esp32FlashEncryptionAddressRegister = u32(0x3ff5b024)
val esp32FlashEncryptionDoneRegister = u32(0x3ff5b028)

@inline
trusted fun esp32FlashEncryptionRead(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32FlashEncryptionWrite(address:u32, value:u32):void {
    xtensaMemoryBarrier()
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))
    xtensaMemoryBarrier()
}

trusted fun esp32RecoveredSpiFlashEncryptionHalEnable():void {
    val current = esp32DportRead(esp32FlashEncryptionClockRegister)
    esp32FlashEncryptionWrite(
        esp32FlashEncryptionClockRegister,current | esp32FlashEncryptionClockBits)
}

trusted fun esp32RecoveredSpiFlashEncryptionHalDisable():void {
    val current = esp32DportRead(esp32FlashEncryptionClockRegister)
    esp32FlashEncryptionWrite(
        esp32FlashEncryptionClockRegister,current & ~esp32FlashEncryptionClockBits)
}

trusted fun esp32FlashEncryptionSavePlaintext(plaintext:u32):void {
    var word = u32(0)
    while (word < u32(8)) {
        esp32FlashEncryptionWrite(
            esp32FlashEncryptionPlaintextBase + (word << u32(2)),
            esp32FlashEncryptionRead(plaintext + (word << u32(2))))
        word = word + u32(1)
    }
}

trusted fun esp32RecoveredSpiFlashEncryptionHalPrepare(
    flashAddress:u32, plaintext:u32, plaintextLength:u32
):void {
    esp32FlashEncryptionWrite(esp32FlashEncryptionAddressRegister,flashAddress)
    esp32FlashEncryptionSavePlaintext(plaintext)
    esp32FlashEncryptionWrite(esp32FlashEncryptionStartRegister,u32(1))
}

trusted fun esp32RecoveredSpiFlashEncryptionHalDone():void {
    while ((esp32FlashEncryptionRead(esp32FlashEncryptionDoneRegister) & u32(1)) == u32(0)) {}
}

trusted fun esp32RecoveredSpiFlashEncryptionHalDestroy():void {}

trusted fun esp32RecoveredSpiFlashEncryptionHalCheck(flashAddress:u32, plaintextLength:u32):u32 =
    if ((flashAddress & u32(15)) == u32(0)) u32(1) else u32(0)
