                    val selected = if (index < 32)
                        (lowMask & (u32(1) << u32(index))) != u32(0)
                    else
                        (highMask & (u32(1) << u32(index - 32))) != u32(0)
                    if (selected) {
                        val regionAddress = regions + u32(index * 8)
                        val regionStart = esp32FlashApiLoadU32(regionAddress)
                        val regionLength = esp32FlashApiLoadU32(
