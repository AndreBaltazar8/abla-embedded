import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMspiTimingOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredSRegisterConfigDriver", "s_register_config_driver")) return false
    if (!internalFunction("esp32RecoveredMspiTimingFlashTuning", "mspi_timing_flash_tuning")) return false
    if (!internalFunction("esp32RecoveredMspiTimingPsramTuning", "mspi_timing_psram_tuning")) return false
    if (!internalFunction("esp32RecoveredMspiTimingGetPsramLowSpeedFreqMhz", "mspi_timing_get_psram_low_speed_freq_mhz")) return false
    if (!internalFunction("esp32RecoveredMspiTimingEnterLowSpeedMode", "mspi_timing_enter_low_speed_mode")) return false
    if (!internalFunction("esp32RecoveredMspiTimingEnterHighSpeedMode", "mspi_timing_enter_high_speed_mode")) return false
    if (!internalFunction("esp32RecoveredMspiTimingChangeSpeedModeCacheSafe", "mspi_timing_change_speed_mode_cache_safe")) return false
    if (!internalFunction("esp32RecoveredMspiTimingEnterLowSpeedEarly", "mspi_timing_enter_low_speed_early")) return false
    if (!internalFunction("esp32RecoveredMspiTimingEnterHighSpeedEarly", "mspi_timing_enter_high_speed_early")) return false
    if (!internalFunction("esp32RecoveredSpiFlashTimingIsTuned", "spi_flash_timing_is_tuned")) return false
    if (!internalFunction("esp32RecoveredSpiTimingGetFlashTimingParam", "spi_timing_get_flash_timing_param")) return false
    if (!internalFunction("esp32RecoveredMspiTimingSetPinDriveStrength", "mspi_timing_set_pin_drive_strength")) return false
    true
}
