import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashCacheInternals(): bool {
    if (!internalFunction("esp32RecoveredSpiFlashInitLock", "spi_flash_init_lock")) return false
    if (!internalFunction("esp32RecoveredSpiFlashOpLock", "spi_flash_op_lock")) return false
    if (!internalFunction("esp32RecoveredSpiFlashOpUnlock", "spi_flash_op_unlock")) return false
    if (!internalFunction("esp32RecoveredSpiFlashDisableCache", "spi_flash_disable_cache")) return false
    if (!internalFunction("esp32RecoveredSpiFlashOpBlockFunc", "spi_flash_op_block_func")) return false
    if (!internalFunction("esp32RecoveredSpiFlashDisableInterruptsCachesAndOtherCpu", "spi_flash_disable_interrupts_caches_and_other_cpu")) return false
    if (!internalFunction("esp32RecoveredSpiFlashDisableInterruptsCachesAndOtherCpuNoOs", "spi_flash_disable_interrupts_caches_and_other_cpu_no_os")) return false
    if (!internalFunction("esp32RecoveredSpiFlashRestoreCache", "spi_flash_restore_cache")) return false
    if (!internalFunction("esp32RecoveredSpiFlashEnableInterruptsCachesAndOtherCpu", "spi_flash_enable_interrupts_caches_and_other_cpu")) return false
    if (!internalFunction("esp32RecoveredSpiFlashEnableInterruptsCachesNoOs", "spi_flash_enable_interrupts_caches_no_os")) return false
    if (!internalFunction("esp32RecoveredSpiFlashEnableCache", "spi_flash_enable_cache")) return false
    if (!internalFunction("esp32RecoveredSpiFlashCacheEnabled", "spi_flash_cache_enabled")) return false
    true
}
