// Original ABI symbol: esp_mspi_get_io
// Resolve the ESP32 flash pin directly from the eFuse encoding used by the
// hardware.  Keeping this as ordinary Abla lets LLVM inline the six boot-time
// calls made by esp32MspiPinReserveBeforeOtherCore.
trusted fun esp32MspiIo(io: u32): u32 {
    if (io >= u32(6)) return u32(0)

    // ESP32 stores WP in the image header rather than EFUSE_SPICONFIG.
    if (io == u32(5)) {
        return esp32FlashWriteProtectPin()
    }

    val spiConfiguration = esp32RomEfuseGetFlashGpioInfo()
    if (spiConfiguration == u32(0)) {
        when (io) {
            0 -> return u32(6)
            1 -> return u32(7)
            2 -> return u32(8)
            3 -> return u32(11)
            4 -> return u32(9)
            else -> return u32(10)
        }
    }

    (spiConfiguration >>> (io * u32(6))) & u32(63)
}

