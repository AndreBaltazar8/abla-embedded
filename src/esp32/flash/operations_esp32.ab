// Original ABI symbol: esp_mspi_pin_reserve
// This runs during CPU0 early initialization, before CPU1 is released.  A
// regular pair of word updates is therefore the exact required synchronization
// policy and avoids entering a FreeRTOS critical section before the port is
// initialized.
trusted fun esp32MspiPinReserveBeforeOtherCore(): void {
    var reserveLow = u32(0)
    var reserveHigh = u32(0)
    var io = u32(0)
    while (io < u32(6)) {
        val pin = esp32MspiIo(io)
        if (pin < u32(32)) {
            reserveLow = reserveLow | (u32(1) << pin)
        } else if (pin < u32(64)) {
            reserveHigh = reserveHigh | (u32(1) << (pin - u32(32)))
        }
        io = io + u32(1)
    }

    val reservation = esp32Data_Labla_recovered_esp32_gpio_reservation_data_data_s_reserved_pin_mask_s_reserved_pin_mask_0601628ed5
    val oldLow = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(reservation))))
    val oldHigh = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(reservation + u32(4)))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(reservation)), int(oldLow | reserveLow))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(reservation + u32(4))), int(oldHigh | reserveHigh))
    return
}

