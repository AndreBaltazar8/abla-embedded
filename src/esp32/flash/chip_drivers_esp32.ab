import "abla/unsafe/native"
import "chip_gd_esp32.ab"
import "chip_generic_esp32.ab"
import "chip_issi_esp32.ab"
import "chip_mxic_esp32.ab"
import "chip_winbond_esp32.ab"

// Every optional driver referenced by this firmware is present in the same
// Abla module, so the weak-symbol warning cases from ESP-IDF collapse away.
// Keeping this source-level hook preserves the SDK interface at zero runtime
// cost and lets another board configuration add warning cases explicitly.
trusted fun esp32FlashChipListCheck(chip:u32, deviceId:u32):void {}

trusted fun esp32RecoveredSpiFlashChipListCheck(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32FlashChipListCheck(a2, a3); a2 }

// Ordered exactly like the selected IDF configuration: specific probes first,
// generic catch-all last. Unreferenced chip modules are not rooted here.
val esp32DefaultRegisteredFlashChipsStorage = nativeStaticMutableU32s([
    int(esp32Data_esp_flash_chip_issi_3ef46c5e18),
    int(esp32Data_esp_flash_chip_gd_11fbfbab6a),
    int(esp32Data_esp_flash_chip_mxic_2236d3d2f6),
    int(esp32Data_esp_flash_chip_winbond_ff5689f5b3),
    int(esp32Data_esp_flash_chip_generic_100cd88a75),
    0
])
val esp32DefaultRegisteredFlashChips =
    u32(esp32DefaultRegisteredFlashChipsStorage)

val esp32Data_esp_flash_registered_chips_f2f66c589dStorage =
    nativeStaticMutableU32s([int(esp32DefaultRegisteredFlashChips)])
val esp32Data_esp_flash_registered_chips_f2f66c589d =
    u32(esp32Data_esp_flash_registered_chips_f2f66c589dStorage)
