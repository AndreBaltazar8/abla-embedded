import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"

// Memory-SPI host configuration expressed directly in Abla.
val esp32FlashSpi1Registers = u32(0x3ff42000)
val esp32FlashSpi2Registers = u32(0x3ff64000)
val esp32FlashSpi3Registers = u32(0x3ff65000)

@inline
trusted fun esp32FlashHalLoadU8(address:u32):u32 = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))
@inline
trusted fun esp32FlashHalLoadU32(address:u32):u32 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))
@inline
trusted fun esp32FlashHalStoreU8(address:u32,value:u32):void = ablaUnsafeStoreU8(nativePointerFromAddress(int(address)),int(value))
@inline
trusted fun esp32FlashHalStoreU32(address:u32,value:u32):void = ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))

trusted fun esp32FlashHalRegisters(hostId:u32):u32 {
    when (hostId) {
        0 -> esp32FlashSpi1Registers
        1 -> esp32FlashSpi2Registers
        2 -> esp32FlashSpi3Registers
        else -> freestandingAbortValue()
    }
}

trusted fun esp32FlashHalClockDivider(configuration:u32):u32 {
    val targetFrequency = esp32FlashHalLoadU32(configuration + u32(44))
    val sourceFrequency = esp32FlashHalLoadU32(configuration + u32(48))
    if (sourceFrequency < targetFrequency || targetFrequency == u32(0)) {
        freestandingAbortValue()
        return u32(1)
    }
    // The ESP32 26 MHz setting is represented by an exact divider of three.
    if (targetFrequency == u32(26) || targetFrequency == u32(27)) return u32(3)
    (sourceFrequency + targetFrequency - u32(1)) / targetFrequency
}

trusted fun esp32FlashHalClockRegister(divider:u32):u32 {
    if (divider == u32(1)) return u32(0x80000000)
    val period = divider - u32(1)
    val high = ((divider >>> u32(1)) - u32(1)) & u32(255)
    period | (high << u32(6)) | ((period & u32(255)) << u32(12))
}

trusted fun esp32FlashHalDummyCycles(configuration:u32,divider:u32):u32 {
    val inputDelay = esp32FlashHalLoadU32(configuration + u32(24))
    val usesIoMux = esp32FlashHalLoadU8(configuration + u32(20)) != u32(0)
    val matrixDelay = if (usesIoMux) u32(0) else u32(25)
    val apbPeriods = u32(
        (u64(inputDelay + matrixDelay + u32(1)) * u64(80000000)) /
        u64(1000000000))
    apbPeriods / divider
}

trusted fun esp32RecoveredSpiFlashHalInit(context:u32,configuration:u32):u32 {
    val chipSelect = esp32FlashHalLoadU32(configuration + u32(32))
    if (chipSelect >= u32(3)) return u32(258)

    val functionTable = esp32FlashHalLoadU32(context)
    freestandingSet(context,i32(0),u32(48))
    esp32FlashHalStoreU32(context,functionTable)
    esp32FlashHalStoreU32(
        context + u32(4),
        esp32FlashHalRegisters(esp32FlashHalLoadU32(configuration + u32(28))))
    esp32FlashHalStoreU32(context + u32(8),chipSelect)
    esp32FlashHalStoreU8(context + u32(14),esp32FlashHalLoadU8(configuration + u32(12)))
    esp32FlashHalStoreU8(context + u32(15),esp32FlashHalLoadU8(configuration + u32(8)))
    esp32FlashHalStoreU32(context + u32(20),esp32FlashHalLoadU32(configuration + u32(40)))
    esp32FlashHalStoreU32(context + u32(40),esp32FlashHalLoadU32(configuration + u32(44)))

    val divider = esp32FlashHalClockDivider(configuration)
    esp32FlashHalStoreU8(context + u32(12),esp32FlashHalDummyCycles(configuration,divider))
    xtensaMemoryBarrier()
    esp32FlashHalStoreU32(context + u32(16),esp32FlashHalClockRegister(divider))

    if (esp32FlashHalLoadU8(configuration + u32(36)) != u32(0)) {
        esp32FlashHalStoreU32(context + u32(24),esp32FlashHalLoadU32(context + u32(24)) | u32(3))
        esp32FlashHalStoreU8(context + u32(44),esp32FlashHalLoadU8(configuration + u32(52)))
        esp32FlashHalStoreU8(context + u32(45),esp32FlashHalLoadU8(configuration + u32(53)))
        esp32FlashHalStoreU8(context + u32(46),esp32FlashHalLoadU8(configuration + u32(54)))
    }
    if (esp32FlashHalLoadU8(configuration + u32(55)) != u32(0)) {
        esp32FlashHalStoreU32(context + u32(24),esp32FlashHalLoadU32(context + u32(24)) & u32(0xfffffffd))
    }
    u32(0)
}

trusted fun esp32RecoveredSpiFlashHalSupportsDirectWrite(host:u32,buffer:u32):u32 =
    if (esp32FlashHalLoadU32(host + u32(4)) == esp32FlashSpi1Registers) u32(0) else u32(1)

trusted fun esp32RecoveredSpiFlashHalSupportsDirectRead(host:u32,buffer:u32):u32 =
    if (esp32FlashHalLoadU32(host + u32(4)) == esp32FlashSpi1Registers) u32(0) else u32(1)
