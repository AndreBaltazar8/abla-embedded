trusted fun esp32FlashThProbe(chip:u32, flashId:u32):u32 {
    if ((flashId >>> u32(16)) != u32(0xcd)) return u32(261)
    if ((flashId & u32(0xff00)) != u32(0x6000)) return u32(261)
    u32(0)
}

