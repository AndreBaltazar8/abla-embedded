import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashEncryptHalOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredSpiFlashEncryptionHalEnable", "spi_flash_encryption_hal_enable")) return false
    if (!internalFunction("esp32RecoveredSpiFlashEncryptionHalDisable", "spi_flash_encryption_hal_disable")) return false
    if (!internalFunction("esp32RecoveredSpiFlashEncryptionHalPrepare", "spi_flash_encryption_hal_prepare")) return false
    if (!internalFunction("esp32RecoveredSpiFlashEncryptionHalDone", "spi_flash_encryption_hal_done")) return false
    if (!internalFunction("esp32RecoveredSpiFlashEncryptionHalDestroy", "spi_flash_encryption_hal_destroy")) return false
    if (!internalFunction("esp32RecoveredSpiFlashEncryptionHalCheck", "spi_flash_encryption_hal_check")) return false
    true
}
