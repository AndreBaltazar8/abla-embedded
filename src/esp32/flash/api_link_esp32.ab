import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashApiInternals(): bool {
    if (!internalFunction("esp32RecoveredEspFlashChipDriverInitialized", "esp_flash_chip_driver_initialized")) return false
    if (!internalFunction("esp32RecoveredEspFlashReadChipId", "esp_flash_read_chip_id")) return false
    if (!internalFunction("esp32RecoveredEspFlashReadId", "esp_flash_read_id")) return false
    if (!internalFunction("esp32RecoveredEspFlashReadUniqueChipId", "esp_flash_read_unique_chip_id")) return false
    if (!internalFunction("esp32RecoveredEspFlashGetPhysicalSize", "esp_flash_get_physical_size")) return false
    if (!internalFunction("esp32RecoveredEspFlashGetSize", "esp_flash_get_size")) return false
    if (!internalFunction("esp32RecoveredEspFlashEraseRegion", "esp_flash_erase_region")) return false
    if (!internalFunction("esp32RecoveredEspFlashEraseChip", "esp_flash_erase_chip")) return false
    if (!internalFunction("esp32RecoveredEspFlashGetChipWriteProtect", "esp_flash_get_chip_write_protect")) return false
    if (!internalFunction("esp32RecoveredEspFlashSetChipWriteProtect", "esp_flash_set_chip_write_protect")) return false
    if (!internalFunction("esp32RecoveredEspFlashGetProtectableRegions", "esp_flash_get_protectable_regions")) return false
    if (!internalFunction("esp32RecoveredEspFlashGetProtectedRegion", "esp_flash_get_protected_region")) return false
    if (!internalFunction("esp32RecoveredEspFlashSetProtectedRegion", "esp_flash_set_protected_region")) return false
    if (!internalFunction("esp32RecoveredEspFlashRead", "esp_flash_read")) return false
    if (!internalFunction("esp32RecoveredEspFlashWrite", "esp_flash_write")) return false
    if (!internalFunction("esp32RecoveredEspFlashReadEncrypted", "esp_flash_read_encrypted")) return false
    if (!internalFunction("esp32RecoveredEspFlashGetIoMode", "esp_flash_get_io_mode")) return false
    if (!internalFunction("esp32RecoveredEspFlashSetIoMode", "esp_flash_set_io_mode")) return false
    if (!internalFunction("esp32RecoveredEspFlashWriteEncrypted", "esp_flash_write_encrypted")) return false
    if (!internalFunction("esp32RecoveredEspFlashSuspendCmdInit", "esp_flash_suspend_cmd_init")) return false
    if (!internalFunction("esp32RecoveredEspFlashAppDisableProtect", "esp_flash_app_disable_protect")) return false
    if (!internalFunction("esp32RecoveredEspFlashIsQuadMode", "esp_flash_is_quad_mode")) return false
    if (!internalFunction("esp32RecoveredEspFlashInit", "esp_flash_init")) return false
    if (!internalFunction("esp32RecoveredEspFlashInitMain", "esp_flash_init_main")) return false
    true
}
