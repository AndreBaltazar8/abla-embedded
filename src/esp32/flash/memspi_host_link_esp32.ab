import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashMemspiHostInternals(): bool {
    if (!internalFunction("esp32RecoveredMemspiHostReadStatusHs", "memspi_host_read_status_hs")) return false
    if (!internalFunction("esp32RecoveredMemspiHostWriteDataSlicer", "memspi_host_write_data_slicer")) return false
    if (!internalFunction("esp32RecoveredMemspiHostReadDataSlicer", "memspi_host_read_data_slicer")) return false
    if (!internalFunction("esp32RecoveredMemspiHostReadIdHs", "memspi_host_read_id_hs")) return false
    if (!internalFunction("esp32RecoveredMemspiHostFlushCache", "memspi_host_flush_cache")) return false
    if (!internalFunction("esp32RecoveredMemspiHostInitPointers", "memspi_host_init_pointers")) return false
    if (!internalFunction("esp32RecoveredMemspiHostEraseChip", "memspi_host_erase_chip")) return false
    if (!internalFunction("esp32RecoveredMemspiHostEraseSector", "memspi_host_erase_sector")) return false
    if (!internalFunction("esp32RecoveredMemspiHostEraseBlock", "memspi_host_erase_block")) return false
    if (!internalFunction("esp32RecoveredMemspiHostProgramPage", "memspi_host_program_page")) return false
    if (!internalFunction("esp32RecoveredMemspiHostRead", "memspi_host_read")) return false
    if (!internalFunction("esp32RecoveredMemspiHostSetWriteProtect", "memspi_host_set_write_protect")) return false
    true
}
