import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashChipGdInternals(): bool {
    if (!internalFunction("esp32FlashGdGetCaps", "spi_flash_chip_gd_get_caps")) return false
    if (!internalFunction("esp32FlashGdDetectSize", "spi_flash_chip_gd_detect_size")) return false
    if (!internalFunction("esp32FlashGdProbe", "spi_flash_chip_gd_probe")) return false
    if (!internalFunction("esp32FlashGdSuspendCommandConfigure", "spi_flash_chip_gd_suspend_cmd_conf")) return false
    if (!internalFunction("esp32FlashGdSetIoMode", "spi_flash_chip_gd_set_io_mode")) return false
    if (!internalFunction("esp32FlashGdGetIoMode", "spi_flash_chip_gd_get_io_mode")) return false
    true
}
