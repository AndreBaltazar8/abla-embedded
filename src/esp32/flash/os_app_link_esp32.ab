import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashOsAppInternals(): bool {
    if (!internalFunction("esp32RecoveredEspFlashInitOsFunctions", "esp_flash_init_os_functions")) return false
    if (!internalFunction("esp32RecoveredEspFlashDeinitOsFunctions", "esp_flash_deinit_os_functions")) return false
    if (!internalFunction("esp32RecoveredEspFlashInitMainBusLock", "esp_flash_init_main_bus_lock")) return false
    if (!internalFunction("esp32RecoveredEspFlashAppEnableOsFunctions", "esp_flash_app_enable_os_functions")) return false
    if (!internalFunction("esp32RecoveredEspFlashSetDangerousWriteProtection", "esp_flash_set_dangerous_write_protection")) return false
    true
}
