import "../../runtime/freestanding_integer.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

// ESP32 memory-SPI timing state. The IDF layout contains one shared word at
// offset 4, six flash-timing words at offsets 0 and 8..24, and six PSRAM
// timing words at offsets 28..48.
val esp32MspiTimingConfigurationStorage = nativeStaticAllocate(52)
val esp32MspiTimingConfiguration = u32(esp32MspiTimingConfigurationStorage)

trusted fun esp32MspiTimingCopyWord(source: u32, destination: u32, offset: u32): void {
    val value = ablaUnsafeLoadU32(nativePointerFromAddress(int(source + offset)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(destination + offset)), value)
}

// Original ABI symbol: s_register_config_driver
trusted fun esp32RecoveredSRegisterConfigDriver(configuration: u32, flash: u32): u32 {
    if ((flash & u32(255)) != u32(0)) {
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(0))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(8))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(12))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(16))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(20))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(24))
    } else {
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(28))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(32))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(36))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(40))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(44))
        esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(48))
    }
    esp32MspiTimingCopyWord(configuration, esp32MspiTimingConfiguration, u32(4))
    configuration
}

// Timing tuning is compiled out for this ESP32 configuration. Keeping the
// operations as typed Abla identities makes that configuration explicit and
// lets LLVM remove calls whose results are unused.
// Original ABI symbol: mspi_timing_flash_tuning
trusted fun esp32RecoveredMspiTimingFlashTuning(value: u32): u32 {
    value
}

// Original ABI symbol: mspi_timing_psram_tuning
trusted fun esp32RecoveredMspiTimingPsramTuning(value: u32): u32 {
    value
}

// Original ABI symbol: mspi_timing_get_psram_low_speed_freq_mhz
trusted fun esp32RecoveredMspiTimingGetPsramLowSpeedFreqMhz(): u32 {
    u32(20)
}

// Original ABI symbol: mspi_timing_enter_low_speed_mode
trusted fun esp32RecoveredMspiTimingEnterLowSpeedMode(value: u32): u32 {
    value
}

// Original ABI symbol: mspi_timing_enter_high_speed_mode
trusted fun esp32RecoveredMspiTimingEnterHighSpeedMode(value: u32): u32 {
    value
}

// Original ABI symbol: mspi_timing_change_speed_mode_cache_safe
trusted fun esp32RecoveredMspiTimingChangeSpeedModeCacheSafe(value: u32): u32 {
    value
}

trusted fun esp32MspiTimingCycleCache(): void {
    val savedStateAddress = u32(nativeStackAllocate(4))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(savedStateAddress)), int(u32(0)))
    esp32RecoveredSpiFlashDisableCache(
        u32(0), savedStateAddress, u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    val savedState = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(savedStateAddress))))
    esp32RecoveredSpiFlashRestoreCache(
        u32(0), savedState, u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

// Original ABI symbol: mspi_timing_enter_low_speed_early
trusted fun esp32RecoveredMspiTimingEnterLowSpeedEarly(value: u32): u32 {
    esp32MspiTimingCycleCache()
    value
}

// Original ABI symbol: mspi_timing_enter_high_speed_early
trusted fun esp32RecoveredMspiTimingEnterHighSpeedEarly(value: u32): u32 {
    esp32MspiTimingCycleCache()
    value
}

// Original ABI symbol: spi_flash_timing_is_tuned
trusted fun esp32RecoveredSpiFlashTimingIsTuned(): u32 {
    u32(0)
}

// This configuration has no flash timing parameter table. The original IDF
// path aborts if a caller requests one, so retain that fail-fast behavior.
// Original ABI symbol: spi_timing_get_flash_timing_param
trusted fun esp32RecoveredSpiTimingGetFlashTimingParam(): u32 {
    freestandingAbortValue()
}

// Original ABI symbol: mspi_timing_set_pin_drive_strength
trusted fun esp32RecoveredMspiTimingSetPinDriveStrength(value: u32): u32 {
    value
}
