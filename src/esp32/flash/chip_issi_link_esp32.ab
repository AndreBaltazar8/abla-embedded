import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiFlashChipIssiInternals(): bool {
    if (!internalFunction("esp32FlashIssiProbe", "spi_flash_chip_issi_probe")) return false
    if (!internalFunction("esp32FlashIssiGetCaps", "spi_flash_chip_issi_get_caps")) return false
    if (!internalFunction("esp32FlashIssiSetIoMode", "spi_flash_chip_issi_set_io_mode")) return false
    if (!internalFunction("esp32FlashIssiGetIoMode", "spi_flash_chip_issi_get_io_mode")) return false
    true
}
