    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericSetWriteProtect))),
    0, 0, 0, 0,
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericRead))),
