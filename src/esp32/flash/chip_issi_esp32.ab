import "abla/unsafe/memory"
import "abla/unsafe/native"
import "chip_generic_esp32.ab"

// Integrated Silicon Solution SPI flash support, expressed as structured Abla.

val esp32IssiChipNameStorage = nativeStaticBytes("\x69\x73\x73\x69\x00")
val esp32IssiChipName = u32(esp32IssiChipNameStorage)

trusted fun esp32FlashIssiProbe(chip:u32, flashId:u32):u32 {
    if ((flashId >>> u32(16)) != u32(0x9d)) return u32(261)
    if ((flashId & u32(0xcf00)) != u32(0x4000)) return u32(261)
    u32(0)
}

trusted fun esp32FlashIssiGetCaps(chip:u32):u32 = u32(4)

trusted fun esp32FlashIssiSetIoMode(chip:u32):u32 {
    esp32RecoveredSpiFlashCommonSetIoMode(
        chip,
        u32(nativeFunctionAddress(esp32RecoveredSpiFlashCommonWriteStatus8bWrsr)),
        u32(nativeFunctionAddress(esp32RecoveredSpiFlashCommonReadStatus8bRdsr)),
        u32(0x40),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
}

trusted fun esp32FlashIssiGetIoMode(chip:u32, readModeOut:u32):u32 {
    val statusAddress = u32(nativeStackAllocate(4))
    val result = esp32RecoveredSpiFlashCommonReadStatus8bRdsr(
        chip, statusAddress,
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (result != u32(0)) return result

    val status = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(statusAddress))))
    val readMode = if ((status & u32(0x40)) != u32(0)) u32(4) else u32(0)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(readModeOut)), int(readMode))
    u32(0)
}

