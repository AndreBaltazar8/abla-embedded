    int(esp32IssiChipName),
    int(esp32Data_spi_flash_chip_generic_timeout_aef8bb4dbd),
    int(u32(nativeFunctionAddress(esp32FlashIssiProbe))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericReset))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericDetectSize))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericEraseChip))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericEraseSector))),
