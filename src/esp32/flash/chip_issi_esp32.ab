    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericConfigHostIoMode)))
])
val esp32Data_esp_flash_chip_issi_3ef46c5e18 =
    u32(esp32Data_esp_flash_chip_issi_3ef46c5e18Storage)
