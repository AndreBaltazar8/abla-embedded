import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "chip_generic_esp32.ab"
import "chip_winbond_esp32.ab"

// Structured Abla implementation of the GigaDevice SPI-flash driver. Keep the
// driver name in Abla-owned static storage so its address is a link-time
// constant inside the monolithic LLVM unit; nativeCStringAddress is a runtime
// string conversion and therefore cannot be part of a static driver table.
val esp32FlashGdNameStorage = nativeStaticBytes("gd\x00")
val esp32FlashGdName = u32(esp32FlashGdNameStorage)
val esp32FlashErrorNotFound = u32(261)
val esp32FlashErrorUnsupportedChip = u32(24581)

@inline
trusted fun esp32FlashGdLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32FlashGdStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32FlashGdGetCaps(chip:u32):u32 {
    val capacityCode = esp32FlashGdLoadU32(chip + u32(24)) & u32(255)
    val largeAddressSupport = if (capacityCode >= u32(25)) u32(2) else u32(0)
    largeAddressSupport | u32(4) // unique-ID support
}

trusted fun esp32FlashGdDetectSize(chip:u32, sizeOutput:u32):u32 {
    val id = esp32FlashGdLoadU32(chip + u32(24))
    esp32FlashGdStoreU32(sizeOutput, u32(0))
    val product = id & u32(0xffff)
    if (product == u32(0) || product == u32(0xffff)) {
        return esp32FlashErrorUnsupportedChip
    }
    esp32FlashGdStoreU32(sizeOutput, u32(1) << (id & u32(255)))
    u32(0)
}

trusted fun esp32FlashGdProbe(chip:u32, flashId:u32):u32 {
    if ((flashId >>> u32(16)) != u32(0xc8)) return esp32FlashErrorNotFound
    val product = flashId & u32(0xff00)
    if (product != u32(0x4000) && product != u32(0x6000) &&
        product != u32(0x8300) && product != u32(0x4300)) {
        return esp32FlashErrorNotFound
    }
    u32(0)
}

trusted fun esp32FlashGdSuspendCommandConfigure(chip:u32):u32 {
    val configuration = u32(nativeStackAllocate(8))
    freestandingSet(configuration, i32(0), u32(8))
    esp32FlashGdStoreU32(configuration, u32(0x84))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(configuration + u32(4))), int(u32(0x35)))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(configuration + u32(5))), int(u32(0x75)))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(configuration + u32(6))), int(u32(0x7a)))
    val host = esp32FlashGdLoadU32(chip)
    val driver = esp32FlashGdLoadU32(host)
    val setup = esp32FlashGdLoadU32(driver + u32(84))
    u32(ablaUnsafeCallI32I32I32(int(setup), int(host), int(configuration)))
}

trusted fun esp32FlashGdSetIoMode(chip:u32):u32 {
    val id = esp32FlashGdLoadU32(chip + u32(24))
    val needs16BitStatus = (id & u32(0xff00)) == u32(0x6000) ||
        (id & u32(255)) <= u32(0x15)
    if (needs16BitStatus) {
        return esp32RecoveredSpiFlashCommonSetIoMode(
            chip,
            u32(nativeFunctionAddress(esp32RecoveredSpiFlashCommonWriteStatus16bWrsr)),
            u32(nativeFunctionAddress(esp32RecoveredSpiFlashCommonReadStatus16bRdsrRdsr2)),
            u32(512),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    }
    esp32RecoveredSpiFlashCommonSetIoMode(
        chip,
        u32(nativeFunctionAddress(esp32RecoveredSpiFlashCommonWriteStatus8bWrsr2)),
        u32(nativeFunctionAddress(esp32RecoveredSpiFlashCommonReadStatus8bRdsr2)),
        u32(2),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
}

trusted fun esp32FlashGdGetIoMode(chip:u32, modeOutput:u32):u32 {
    val statusValue = u32(nativeStackAllocate(4))
    val status = esp32RecoveredSpiFlashCommonReadStatus8bRdsr2(
        chip,statusValue,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (status == u32(0)) {
        esp32FlashGdStoreU32(modeOutput,
            if ((esp32FlashGdLoadU32(statusValue) & u32(2)) != u32(0)) u32(4) else u32(0))
    }
    status
}

val esp32Data_esp_flash_chip_gd_11fbfbab6aStorage = nativeStaticMutableU32s([
    int(esp32FlashGdName),
    int(esp32Data_spi_flash_chip_generic_timeout_aef8bb4dbd),
    int(u32(nativeFunctionAddress(esp32FlashGdProbe))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericReset))),
    int(u32(nativeFunctionAddress(esp32FlashGdDetectSize))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericEraseChip))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipWinbondEraseSector))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipWinbondEraseBlock))),
    4096, 65536,
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericGetWriteProtect))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericSetWriteProtect))),
    0, 0, 0, 0,
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipWinbondRead))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericWrite))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipWinbondPageProgram))),
    256,
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericWriteEncrypted))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericWaitIdle))),
    int(u32(nativeFunctionAddress(esp32FlashGdSetIoMode))),
    int(u32(nativeFunctionAddress(esp32FlashGdGetIoMode))),
    0,
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericReadReg))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericYield))),
    int(u32(nativeFunctionAddress(esp32FlashGdSuspendCommandConfigure))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericReadUniqueId))),
    int(u32(nativeFunctionAddress(esp32FlashGdGetCaps))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericConfigHostIoMode)))
])
val esp32Data_esp_flash_chip_gd_11fbfbab6a = u32(esp32Data_esp_flash_chip_gd_11fbfbab6aStorage)
