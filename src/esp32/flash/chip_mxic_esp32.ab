    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericReadUniqueIdNone))),
    int(u32(nativeFunctionAddress(esp32FlashMxicGetCaps))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericConfigHostIoMode)))
])
val esp32Data_esp_flash_chip_mxic_2236d3d2f6 =
    u32(esp32Data_esp_flash_chip_mxic_2236d3d2f6Storage)
