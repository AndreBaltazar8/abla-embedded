import "abla/unsafe/memory"
import "abla/unsafe/native"
import "chip_generic_esp32.ab"
import "chip_issi_esp32.ab"

// Macronix SPI flash support. Ordinary policy and decoding stay in Abla; the
// shared command transport is implemented by chip_generic_esp32.ab.

val esp32MxicChipNameStorage = nativeStaticBytes("\x6d\x78\x69\x63\x00")
val esp32MxicChipName = u32(esp32MxicChipNameStorage)

trusted fun esp32FlashMxicProbe(chip:u32, flashId:u32):u32 {
    if ((flashId >>> u32(16)) != u32(0xc2)) return u32(261)

    // The legacy MXIC driver handles only non-OPI chips. OPI mode has its own
    // driver and starts at SPI_FLASH_OPI_FLAG (bit 4).
    val readMode = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(chip + u32(16)))))
    if (readMode >= u32(16)) return u32(261)
    u32(0)
}

trusted fun esp32FlashMxicDetectSize(chip:u32, sizeOut:u32):u32 {
    ablaUnsafeStoreU32(nativePointerFromAddress(int(sizeOut)), 0)

    val chipId = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(chip + u32(24)))))
    val deviceId = chipId & u32(0xffff)
    if (deviceId == u32(0) || deviceId == u32(0xffff)) return u32(24581)

    var density = chipId & u32(0xff)
    if (density > u32(0x30)) density = density - u32(0x20)
    val size = u32(1) << density
    ablaUnsafeStoreU32(nativePointerFromAddress(int(sizeOut)), int(size))
    u32(0)
}

trusted fun esp32FlashMxicGetCaps(chip:u32):u32 = u32(0)

val esp32Data_esp_flash_chip_mxic_2236d3d2f6Storage = nativeStaticMutableU32s([
    int(esp32MxicChipName),
    int(esp32Data_spi_flash_chip_generic_timeout_aef8bb4dbd),
    int(u32(nativeFunctionAddress(esp32FlashMxicProbe))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericReset))),
    int(u32(nativeFunctionAddress(esp32FlashMxicDetectSize))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericEraseChip))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericEraseSector))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericEraseBlock))),
    4096, 65536,
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericGetWriteProtect))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericSetWriteProtect))),
    0, 0, 0, 0,
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericRead))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericWrite))),
    int(u32(nativeFunctionAddress(esp32RecoveredSpiFlashChipGenericPageProgram))),
    256,
