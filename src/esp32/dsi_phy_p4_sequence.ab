// P4 D-PHY digital controls; offsets/edges follow IDF6 mipi_dsi_phy_ll.h
// and mipi_dsi_hal_phy_write_register. Exclusive host ownership required.
// Peripheral clocks, analog supply and reference clock must already be on.
// None of these routines configures the PLL, bridge or panel power/reset.
trusted fun esp32P4DsiPhyWriteRegisterOwned(address: int,value: int): bool {
    if (address < 0 || address > 255 || value < 0 || value > 255) return false
    p4DsiWrite(180,u32(0))
    p4DsiWrite(184,u32(65536 | address))
    p4DsiWrite(180,u32(2))
    p4DsiWrite(180,u32(0))
    p4DsiWrite(184,u32(value))
    p4DsiWrite(180,u32(2))
    p4DsiWrite(180,u32(0))
    true
}

// Destructive initialization boundary: caller has stopped all host traffic.
// Mirrors HAL ordering: lane count, host power, PHY power, reset pulse,
// clock lane enable, force PLL. Return means sequence issued, NOT lock.
trusted fun esp32P4DsiPhyStartOwned(lanes: int): bool {
    if (lanes < 1 || lanes > 2) return false
    p4DsiWrite(164,(p4DsiRead(164)&u32(4294967292))|u32(lanes-1))
    p4DsiWrite(4,p4DsiRead(4)|u32(1))
    p4DsiWrite(160,p4DsiRead(160)|u32(1))
    p4DsiWrite(160,p4DsiRead(160)&u32(4294967293))
    p4DsiWrite(160,p4DsiRead(160)|u32(2))
    p4DsiWrite(160,p4DsiRead(160)|u32(4))
    p4DsiWrite(160,p4DsiRead(160)|u32(8))
    true
}

// PLL locked AND clock/all selected data lanes stopped. Bounded iterations,
// not milliseconds. No reset, power-down or hidden retry on timeout.
trusted fun esp32P4DsiPhyWaitReadyOwned(lanes: int,polls: int): bool {
    if (lanes < 1 || lanes > 2 || polls < 1 || polls > 1000000) return false
    val mask=u32(if (lanes == 1) 21 else 149)
    var remaining=polls
    while (remaining > 0) {
        if ((p4DsiRead(176)&mask) == mask) return true
        remaining=remaining-1
    }
    false
}

// Caller has quiesced traffic and owns shutdown of the host as well as PHY.
trusted fun esp32P4DsiPhyStopOwned(): void {
    p4DsiWrite(160,p4DsiRead(160)&u32(4294967294))
    p4DsiWrite(4,p4DsiRead(4)&u32(4294967294))
    return
}
