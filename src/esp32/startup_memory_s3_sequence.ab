import "./sdk/raw_buffer.ab"
@inline
fun esp32S3StartupMemoryRange(buffer: NativeBuffer,low: int,high: int): bool =
    buffer.capacity() >= 0 && (buffer.capacity() & 3) == 0 &&
    buffer.addressValue() >= low && buffer.addressValue() <= high &&
    buffer.capacity() <= high-buffer.addressValue() && (buffer.addressValue() & 3) == 0
// First-core boot only, before secondary release, globals or runtime setup.
// Bootloader already loaded initialized data. Clear only linker-designated
// BSS; caller owns these regions and excludes executing code/initialized data,
// including IRAM/DRAM physical aliases. No .data copy or implicit reset.
// Supply the entire reserved live stack, not just the current frame. Existing
// ROM/vector state must remain valid; boot stack is excluded from both clears.
// Optional RTC BSS may be in slow or fast RTC RAM, preserved on reset reason5.
@section(".iram1.abla.s3StartupMemory")
trusted fun esp32S3StartupMemoryInitializeOwned(bss: NativeBuffer,rtc: NativeBuffer,stack: NativeBuffer): bool {
    if (esp32S3StartupMemoryCore() != 0 || esp32S3StartupMemoryEnabled() != 0 ||
        !esp32S3StartupMemoryRange(stack,0x3FC88000,0x3FD00000) || stack.capacity() < 256 ||
        (stack.addressValue() & 15) != 0 || (stack.capacity() & 15) != 0) return false
    if (bss.capacity() != 0 && !esp32S3StartupMemoryRange(bss,0x3FC88000,0x3FD00000)) return false
    if (rtc.capacity() != 0 && !esp32S3StartupMemoryRange(rtc,0x50000000,0x50002000) &&
        !esp32S3StartupMemoryRange(rtc,0x600FE000,0x60100000)) return false
    val low=stack.addressValue()
    val end=low+stack.capacity()
    val sp=esp32S3StartupMemoryStackPointer()
    if (sp < low || sp >= end || (sp & 15) != 0 ||
        (bss.capacity() != 0 && bss.addressValue() < end && low < bss.addressValue()+bss.capacity())) return false
    val reason=esp32S3StartupMemoryResetReason()
    var offset=0
    while (offset < bss.capacity()) { esp32S3StartupMemoryZero(bss.addressValue()+offset); offset=offset+4 }
    if (reason != 5) {
        offset=0
        while (offset < rtc.capacity()) { esp32S3StartupMemoryZero(rtc.addressValue()+offset); offset=offset+4 }
    }
    true
}
