import "./ldo_p4_logic.ab"
// READ-only eFuse shadow registers. Caller ensures shadow loading completed;
// no read command, programming voltage, burn operation or write is issued.
trusted fun esp32P4LdoReadVoltagePlanOwned(channel: int,millivolts: int): Esp32P4LdoVoltage {
    if (channel < 1 || channel > 4 || (millivolts != 3300 && (millivolts < 500 || millivolts > 2700))) return Esp32P4LdoVoltage(0)
    val sys2=p4LdoEfuseRead(76)
    // HAL block version major*100+minor >=1. Disable-major is unrelated.
    val calibrated=(sys2&u32(7936)) != u32(0)
    if (!calibrated) return esp32P4LdoSelectVoltage(channel,millivolts,false,0,0,0,0,0)
    val sys3=p4LdoEfuseRead(80)
    if (channel == 1) return esp32P4LdoSelectVoltage(channel,millivolts,true,0,0,0,int((sys2>>u32(24))&u32(15)),int(sys3&u32(7)))
    if (channel == 2) return esp32P4LdoSelectVoltage(channel,millivolts,true,0,0,0,int(sys2>>u32(28)),int((sys3>>u32(3))&u32(7)))
    if (channel == 3) return esp32P4LdoSelectVoltage(channel,millivolts,true,
        int((sys3>>u32(6))&u32(255)),int((sys3>>u32(14))&u32(63)),int((sys3>>u32(20))&u32(63)),0,0)
    val sys4=p4LdoEfuseRead(84)
    esp32P4LdoSelectVoltage(channel,millivolts,true,int((sys3>>u32(26))|((sys4&u32(3))<<u32(6))),
        int((sys4>>u32(2))&u32(63)),int((sys4>>u32(8))&u32(63)),0,0)
}
