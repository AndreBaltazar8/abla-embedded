// P4 D-PHY range codes from IDF6 esp32p4/mipi_dsi_periph.c.
// Integer Mbps helper; fractional requests use the kbit/s entry below.
fun esp32P4DsiHsRange(mbps: int): int {
    if (mbps < 80 || mbps > 1500) return -1
    if (mbps < 90) return 0
    if (mbps < 100) return 16
    if (mbps < 110) return 32
    if (mbps < 130) return 1
    if (mbps < 140) return 17
    if (mbps < 150) return 33
    if (mbps < 170) return 2
    if (mbps < 180) return 18
    if (mbps < 200) return 34
    if (mbps < 220) return 3
    if (mbps < 240) return 19
    if (mbps < 250) return 35
    if (mbps < 270) return 4
    if (mbps < 300) return 20
    if (mbps < 330) return 5
    if (mbps < 360) return 21
    if (mbps < 400) return 37
    if (mbps < 450) return 6
    if (mbps < 500) return 22
    if (mbps < 550) return 7
    if (mbps < 600) return 23
    if (mbps < 650) return 8
    if (mbps < 700) return 24
    if (mbps < 750) return 9
    if (mbps < 800) return 25
    if (mbps < 850) return 41
    if (mbps < 900) return 57
    if (mbps < 950) return 10
    if (mbps < 1000) return 26
    if (mbps < 1050) return 42
    if (mbps < 1100) return 58
    if (mbps < 1150) return 11
    if (mbps < 1200) return 27
    if (mbps < 1250) return 43
    if (mbps < 1300) return 59
    if (mbps < 1350) return 12
    if (mbps < 1400) return 28
    if (mbps < 1450) return 44
    60
}

type DsiPhyPll = int
fun DsiPhyPll.valid(): bool = (this & (1 << 22)) != 0
fun DsiPhyPll.divider(): int = this & 63
fun DsiPhyPll.multiplier(): int = (this >>> 6) & 1023
fun DsiPhyPll.hsRange(): int = (this >>> 16) & 63

// Exact integer version of HAL's floor-M, even-M candidate search. Reference
// is in kHz (caller supplies the actual stable clock, not a nominal guess).
// Require 5..40MHz at the PLL input after N division; encoded M is 9 bits.
// No viable factors => invalid, never silently emit an all-zero PLL setup.
// Products fit u32 within these bounds; no floating-point/libc runtime.
fun esp32P4DsiChoosePll(referenceKhz: int,mbps: int): DsiPhyPll {
    if (mbps < 80 || mbps > 1500) return DsiPhyPll(0)
    esp32P4DsiChoosePllKbps(referenceKhz,mbps*1000)
}

// Half-open range boundaries follow the table comments, avoiding its float
// comparison gaps (e.g. 89.5Mbps). 1kbit/s resolution; no float dependency.
fun esp32P4DsiChoosePllKbps(referenceKhz: int,kbps: int): DsiPhyPll {
    if (kbps < 80000 || kbps > 1500000) return DsiPhyPll(0)
    val range=esp32P4DsiHsRange(kbps/1000)
    if (range < 0 || referenceKhz < 5000 || referenceKhz > 160000) return DsiPhyPll(0)
    val reference=u32(referenceKhz)
    val target=u32(kbps)
    var n=u32((referenceKhz+39999)/40000)
    val limit=u32(referenceKhz/5000)
    var bestN=u32(0)
    var bestM=u32(0)
    var bestDelta=u32(0)
    while (n <= limit) {
        val m=(target*n)/reference
        if ((m & u32(1)) == u32(0) && m >= u32(2) && m <= u32(512)) {
            val delta=target*n-reference*m
            if (bestN == u32(0) || delta*bestN < bestDelta*n) {
                bestN=n; bestM=m; bestDelta=delta
                if (delta == u32(0)) return DsiPhyPll((1 << 22) | (range << 16) | (int(m) << 6) | int(n))
            }
        }
        n=n+u32(1)
    }
    if (bestN == u32(0)) return DsiPhyPll(0)
    DsiPhyPll((1 << 22) | (range << 16) | (int(bestM) << 6) | int(bestN))
}
