import "./delay_clock_c61_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../hal/esp32.ab"
@export("c61DelayClockRead")
trusted fun c61DelayClockReadHook(address: int): int = mmioLoadU32(address)
// IDF6 C61 ROM ets_update_cpu_frequency; hardware ROM primitive only.
@export("c61DelayClockSetRomTicks")
trusted fun c61DelayClockSetRomTicksHook(ticks: int): void { callNativeVoidI32(0x40000044,ticks);return }
