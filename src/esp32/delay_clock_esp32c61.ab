import "./delay_clock_c61_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
trusted fun c61DelayClockRead(address: int): int = mmioLoadU32(address)
// IDF6 C61 ROM ets_update_cpu_frequency; hardware ROM primitive only.
trusted fun c61DelayClockSetRomTicks(ticks: int): void { callNativeVoidI32(0x40000044,ticks);return }
