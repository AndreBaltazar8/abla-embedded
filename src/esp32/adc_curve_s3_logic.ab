// ESP-IDF v6.0.2 ESP32-S3 second-step curve coefficients. This operates on
// FIRST-STEP calibrated millivolts, not ADC raw counts. No fuse/acquisition yet.
// Exact integer terms with truncation before signs, as in the reference driver.
fun s3AdcCurveCoeff0(term: int): int = if (term == 0) 27856531419538344 else if (term == 1) 50871540569528 else if (term == 2) 9798249589 else if (term == 3) 0 else if (term == 4) 0 else 0
fun s3AdcCurveCoeff1(term: int): int = if (term == 0) 29831022915028695 else if (term == 1) 49393185868806 else if (term == 2) 101379430548 else if (term == 3) 0 else if (term == 4) 0 else 0
fun s3AdcCurveCoeff2(term: int): int = if (term == 0) 23285545746296417 else if (term == 1) 147640181047414 else if (term == 2) 208385525314 else if (term == 3) 0 else if (term == 4) 0 else 0
fun s3AdcCurveCoeff3(term: int): int = if (term == 0) 644403418269478 else if (term == 1) 644334888647536 else if (term == 2) 1297891447611 else if (term == 3) 70769718 else if (term == 4) 13515 else 0
fun s3AdcCurveCoeff4(term: int): int = if (term == 0) 25668651654328927 else if (term == 1) 1353548869615 else if (term == 2) 36615265189 else if (term == 3) 0 else if (term == 4) 0 else 0
fun s3AdcCurveCoeff5(term: int): int = if (term == 0) 23690184690298404 else if (term == 1) 66319894226185 else if (term == 2) 118964995959 else if (term == 3) 0 else if (term == 4) 0 else 0
fun s3AdcCurveCoeff6(term: int): int = if (term == 0) 9452499397020617 else if (term == 1) 200996773954387 else if (term == 2) 259011467956 else if (term == 3) 0 else if (term == 4) 0 else 0
fun s3AdcCurveCoeff7(term: int): int = if (term == 0) 12247719764336924 else if (term == 1) 755717904943462 else if (term == 2) 1478791187119 else if (term == 3) 79672528 else if (term == 4) 15038 else 0
fun s3AdcCurveCoefficient(group: int,term: int): int = if (group == 0) s3AdcCurveCoeff0(term) else if (group == 1) s3AdcCurveCoeff1(term) else if (group == 2) s3AdcCurveCoeff2(term) else if (group == 3) s3AdcCurveCoeff3(term) else if (group == 4) s3AdcCurveCoeff4(term) else if (group == 5) s3AdcCurveCoeff5(term) else if (group == 6) s3AdcCurveCoeff6(term) else if (group == 7) s3AdcCurveCoeff7(term) else 0
// Multiply a rational by X repeatedly in quotient/remainder form. Products
// such as coefficient*X^4 need not fit64bits. Remainder doubling/addition is
// <3e16, safe in signed64; no runtime division or allocation is required.
fun s3AdcCurveTerm(coefficient: int,denominator: int,mv: int,exponent: int): int {
    // Every coefficient is below3*denominator. Explicit bounded reductions
    // prevent loop-idiom optimization from introducing __udivdi3 on Xtensa.
    var quotient=if (coefficient >= denominator*2) 2 else if (coefficient >= denominator) 1 else 0
    var remainder=coefficient-quotient*denominator
    var power=0
    while (power < exponent) {
        val baseQ=quotient; val baseR=remainder
        quotient=0; remainder=0
        var bit=2048
        while (bit > 0) {
            quotient=quotient*2; remainder=remainder*2
            if ((mv&bit) != 0) { quotient=quotient+baseQ; remainder=remainder+baseR }
            if (remainder >= denominator) { remainder=remainder-denominator; quotient=quotient+1 }
            if (remainder >= denominator) { remainder=remainder-denominator; quotient=quotient+1 }
            bit=bit/2
        }
        power=power+1
    }
    return quotient
}
// Validated engineering range0..4000mV; out-of-range inputs return-1 instead
// of wrapping unsigned products. Physical ADC accuracy is not implied.
fun esp32S3AdcCorrectMillivolts(unit: int,attenuation: int,firstStepMillivolts: int): int {
    if (unit < 1 || unit > 2 || attenuation < 0 || attenuation > 3 || firstStepMillivolts < 0 || firstStepMillivolts > 4000) return -1
    if (firstStepMillivolts == 0) return 0
    val group=(unit-1)*4+attenuation
    val count=if (attenuation == 3) 5 else 3
    var term=0; var error=0
    while (term < count) {
        val denominator=if ((group == 0 && term == 2) || (group == 3 && term == 0) || (attenuation == 3 && term >= 3)) 1000000000000000 else 10000000000000000
        val magnitude=s3AdcCurveTerm(s3AdcCurveCoefficient(group,term),denominator,firstStepMillivolts,term)
        val positive=term == 2 || term == 4 || (group == 4 && term == 1) || (group == 7 && term == 0)
        error=error+(if (positive) magnitude else -magnitude)
        term=term+1
    }
    return firstStepMillivolts-error
}
