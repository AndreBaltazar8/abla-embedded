import "./sdk/raw_buffer.ab"
// Construct a fresh, unreferenced task frame. Caller owns the ENTIRE stack,
// disjoint from live stacks/code/data/CP records. No allocation or scheduling.
// 192-byte context matches context_return_esp32s3. Mimic CALL4 as IDF does:
// PS.CALLINC1|WOE|UM|EXCM (RFE clears EXCM), wrapper args in saved A6/A7/A8.
// onReturn(arg) must retire the task or enter a fatal path, never return.
// Threadptr is caller-owned TLS state (0 if unused); no implicit TLS runtime.
@section(".iram1.abla.s3TaskFrameInit")
trusted fun esp32S3TaskFrameInitializeOwned(stack: NativeBuffer,entry: int,arg: int,onReturn: int,threadptr: int): int {
    if (!stack.hasAddressRange(0,1024) || stack.addressValue() < 0x3FC88000 ||
        stack.addressValue()+stack.capacity() > 0x3FD00000 ||
        ((stack.addressValue() | stack.capacity()) & 15) != 0 ||
        entry < 0x40370000 || entry >= 0x403E0000 || (entry & 3) != 0 ||
        onReturn < 0x40370000 || onReturn >= 0x403E0000 || (onReturn & 3) != 0 ||
        arg < 0 || arg > 0xFFFFFFFF || threadptr < 0 || threadptr > 0xFFFFFFFF) return 0
    val top=stack.addressValue()+stack.capacity()-16
    val frame=top-192
    var address=frame-16
    while (address < top+16) { esp32S3TaskFrameWrite(address,0); address=address+4 }
    esp32S3TaskFrameWrite(frame,esp32S3TaskFrameReturnAddress())
    esp32S3TaskFrameWrite(frame+4,esp32S3TaskFrameEntryAddress())
    esp32S3TaskFrameWrite(frame+8,0x50030)
    esp32S3TaskFrameWrite(frame+16,top)
    esp32S3TaskFrameWrite(frame+36,entry)
    esp32S3TaskFrameWrite(frame+40,arg)
    esp32S3TaskFrameWrite(frame+44,onReturn)
    esp32S3TaskFrameWrite(frame+112,threadptr)
    frame
}
