import "../runtime/rtc_time48.ab"

// Calibration is the measured slow-clock period in microseconds, Q19.
// Split before shifting so long durations cannot overflow the numerator.
// Returns -1 when invalid or beyond half the 48-bit counter range; floor
// rounding matches IDF rtc_time_us_to_slowclk. No assumed oscillator speed.
fun esp32S3RtcTicksForMicroseconds(microseconds: int, periodQ19: int): int {
    rtc48TicksForMicroseconds(microseconds,periodQ19)
}

// S3 rtc_timer_ll_get_cycle_count: TIME_UPDATE snapshots both counter words.
// Caller serializes this shared latch with other RTC timer users.
trusted fun esp32S3RtcCyclesOwned(): int {
    esp32S3RtcWakeUpdate(0x6000800C,0x80000000,0x80000000)
    val low=esp32S3RtcWakeRead(0x60008010) & 0xFFFFFFFF
    val high=esp32S3RtcWakeRead(0x60008014) & 65535
    low | (high<<32)
}

// Absolute 48-bit slow-clock deadline, not a duration. Programs the alarm
// but does not select the timer wake trigger or enter sleep. Caller owns RTC
// timer/interrupt configuration and must ensure the deadline is still future.
trusted fun esp32S3RtcSetAlarmOwned(deadline: int): bool {
    if (deadline < 0 || deadline > 0xFFFFFFFFFFFF) return false
    esp32S3RtcWakeWrite(0x60008004,deadline & 0xFFFFFFFF)
    esp32S3RtcWakeWrite(0x60008008,deadline>>>32)
    // W1C: clear only MAIN_TIMER, never replay other pending interrupts.
    esp32S3RtcWakeWrite(0x6000804C,1024)
    esp32S3RtcWakeUpdate(0x60008008,65536,65536)
    true
}

trusted fun esp32S3RtcAlarmAfterOwned(microseconds: int, periodQ19: int): bool {
    val ticks=esp32S3RtcTicksForMicroseconds(microseconds,periodQ19)
    if (ticks <= 0) return false
    val now=esp32S3RtcCyclesOwned()
    esp32S3RtcSetAlarmOwned((now+ticks) & 0xFFFFFFFFFFFF)
}
