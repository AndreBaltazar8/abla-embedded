// Shared ADC/PWDET/temperature SAR controls, from S3 sar_ctrl_ll.h.
// Mode0 FSM,1 forced-on,2 forced-off. Callers serialize all shared users and
// regi2c access; these primitives do not acquire clocks/locks or track leases.
@inline
trusted fun esp32S3SarUpdate(address: int,mask: int,value: int): void {
    esp32S3SarWrite(address,(esp32S3SarRead(address) & (0xFFFFFFFF ^ mask)) | (value & mask))
    return
}
@section(".iram1.abla.s3SarPower")
trusted fun esp32S3SarPowerSetOwned(mode: int): bool {
    if (mode < 0 || mode > 2) return false
    esp32S3SarUpdate(0x60008904,0x40000000,if (mode == 2) 0 else 0x40000000)
    esp32S3SarUpdate(0x6000883C,0x60000000,if (mode == 0) 0 else if (mode == 1) 0x60000000 else 0x40000000)
    true
}
// Separate PHY/PWDET route; do not confuse this register with SENS controls.
@section(".iram1.abla.s3SarPwdetPower")
trusted fun esp32S3SarPwdetPowerSetOwned(mode: int): bool {
    if (mode < 0 || mode > 2) return false
    if (mode == 0) esp32S3SarUpdate(0x6000E060,128,0)
    else {
        esp32S3SarUpdate(0x6000E060,128,128)
        esp32S3SarUpdate(0x6000E060,64,if (mode == 1) 64 else 0)
    }
    true
}
// IDF sleep workaround intentionally restores FSM, not a stale force-on mode.
// A live ADC/temperature sleep monitor must KEEP SAR powered instead.
// Token4=monitor untouched,5=forced off; single-use under exclusive ownership.
type Esp32S3SleepSar = int
@section(".iram1.abla.s3SleepSarPrepare")
trusted fun esp32S3SleepSarPrepareOwned(monitorActive: bool): Esp32S3SleepSar {
    if (monitorActive) return Esp32S3SleepSar(4)
    esp32S3SarPowerSetOwned(2)
    Esp32S3SleepSar(5)
}
@section(".iram1.abla.s3SleepSarRestore")
trusted fun esp32S3SleepSarRestoreOwned(saved: Esp32S3SleepSar): bool {
    if ((saved | 0) == 4) return true
    if ((saved | 0) != 5) return false
    if ((esp32S3SarRead(0x60008904) & 0x40000000) != 0 || (esp32S3SarRead(0x6000883C) & 0x60000000) != 0x40000000) return false
    esp32S3SarPowerSetOwned(0)
}
