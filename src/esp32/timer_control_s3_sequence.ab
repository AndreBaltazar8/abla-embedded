// Canonical RCC lock held; caller exclusively owns the selected counter.
// Preserve the other unit, alarms, counter values and interrupt configuration.
// Enable bus/register clocks and deassert reset WITHOUT a reset pulse.
trusted fun esp32S3TimerConfigureLocked(unit: int, enabled: bool,
    stallCore0: bool, stallCore1: bool): bool {
    if (unit < 0 || unit > 1) return false
    esp32S3TimerWrite(0x600c0018,esp32S3TimerRead(0x600c0018) | u32(1 << 29))
    esp32S3TimerWrite(0x600c0020,esp32S3TimerRead(0x600c0020) & ~u32(1 << 29))
    esp32S3TimerWrite(0x60023000,esp32S3TimerRead(0x60023000) | u32(0x80000000))
    val work = u32(1) << u32(30-unit)
    val stall0 = u32(1) << u32(28-unit*2)
    val stall1 = stall0 >>> u32(1)
    val mask = work | stall0 | stall1
    val fields = (if (enabled) work else u32(0)) |
        (if (stallCore0) stall0 else u32(0)) | (if (stallCore1) stall1 else u32(0))
    esp32S3TimerWrite(0x60023000,(esp32S3TimerRead(0x60023000) & ~mask) | fields)
    true
}
