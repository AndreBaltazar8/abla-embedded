// Integrates an exclusively owned/routed S3 FROM_CPU channel with the atomic
// peer parking mailbox. Caller has installed serialized service on OTHER core
// and coordinated scheduler locks; this layer does not allocate interrupts.
@section(".iram1.abla.s3PeerParkNotify")
trusted fun esp32S3PeerParkNotifyOwned(address: int,channel: int): int {
    if (channel < 0 || channel > 3) return 0
    val ticket=xtensaPeerParkRequestOwned(address)
    if (ticket == 0) return 0
    // Publish ticket through acquire/release CAS BEFORE raising the doorbell.
    esp32S3IntercoreSignalOwned(channel,true)
    ticket
}
// Called by the owned peer handler at its scheduler-safe rendezvous. Clear the
// level-triggered source FIRST, then acquire the current mailbox ticket. This
// handles coalesced notifications without clearing a new request after capture.
// A cancelled request or a late old interrupt is harmless; Serve rechecks CAS.
// Never call this on the requesting core or from a reentrant shared handler.
@section(".iram1.abla.s3PeerParkService")
trusted fun esp32S3PeerParkServiceOwned(address: int,channel: int): bool {
    if (channel < 0 || channel > 3 || address <= 0 || address > 0xFFFFFFFC || (address & 3) != 0) return false
    esp32S3IntercoreSignalOwned(channel,false)
    val word=xtensaPeerParkCas(address,0,0)
    if ((word & 7) != 1 || word < 8) return false
    xtensaPeerParkServeOwned(address,word & 0xFFFFFFF8)
}
