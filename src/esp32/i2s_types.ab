type I2sPins = int
type I2sDevice = int

fun i2sPins(clock: int, wordSelect: int, output: int, input: int): I2sPins =
    I2sPins(
        (clock & 255) |
        ((wordSelect & 255) << 8) |
        ((output & 255) << 16) |
        ((input & 255) << 24)
    )

fun i2sPinDecode(value: int): int = if (value < 128) value else value - 256

fun I2sPins.clockPin(): int = i2sPinDecode(this & 255)
fun I2sPins.wordSelectPin(): int = i2sPinDecode((this >>> 8) & 255)
fun I2sPins.outputPin(): int = i2sPinDecode((this >>> 16) & 255)
fun I2sPins.inputPin(): int = i2sPinDecode((this >>> 24) & 255)

fun i2s(port: int, pins: I2sPins, sampleRate: int): I2sDevice =
    I2sDevice(
        (pins & 4294967295) |
        ((sampleRate & 16777215) << 32) |
        ((port & 255) << 56)
    )

fun I2sDevice.portNumber(): int = (this >>> 56) & 255
fun I2sDevice.pinsValue(): I2sPins = I2sPins(this & 4294967295)
fun I2sDevice.sampleRateValue(): int = (this >>> 32) & 16777215
