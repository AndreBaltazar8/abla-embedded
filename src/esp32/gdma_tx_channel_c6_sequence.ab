import "abla/runtime/scalar"
// C6 TX channel0..2: D0+C0*n, events30+10*n; link address0..19,
// stop/start/restart20..22,park23. NOT C5's relocated link controls.
// Caller owns channel/peripheral trigger, initialized/drained FIFO, pinned
// GDMA clocks/PMS/SRAM and joined IRQ/ETM users. No reset/IRQ clear/start.
// Snapshot conf0@8,owner40,oldperipheral41..46,channel47..48,valid49.
//1ready2invalid3clock4busy5write6restored7restore-failed; retain on failure.
type C6GdmaTxChannel=int
fun C6GdmaTxChannel.status(): int = this&255
fun c6GdmaTxBase(channel: int): int = if (channel < 0 || channel > 2) -1 else 0xd0+channel*0xc0
trusted fun c6GdmaClocksReady(): bool = (c6GdmaBusRead()&u32(3)) == u32(1) && (c6GdmaRead(0x64)&u32(9)) == u32(8)
trusted fun c6GdmaTxParked(channel: int): bool {
    val base=c6GdmaTxBase(channel)
    if (base < 0) return false
    val events=0x30+channel*16
    return (c6GdmaRead(base)&u32(65)) == u32(0) &&
        (c6GdmaRead(base+16)&u32(0xf00000)) == u32(0x800000) &&
        (c6GdmaRead(base+8)&u32(2)) != u32(0) &&
        c6GdmaRead(events) == u32(0) && c6GdmaRead(events+8) == u32(0)
}
trusted fun c6GdmaField(at: int,mask: u32,value: u32): bool {
    val old=c6GdmaRead(at)
    if ((old&mask) != value) c6GdmaWrite(at,(old&~mask)|value)
    return (c6GdmaRead(at)&mask) == value
}
// Single-word data/descriptor access, automatic writeback and EOF after pop.
// I2S0=3. Other verified TX trigger IDs: SPI2=0,UHCI0=2,AES6,SHA7,PARLIO9.
trusted fun c6GdmaTxChannelOpenOwned(channel: int,peripheral: int,exclusive: bool): C6GdmaTxChannel {
    val base=c6GdmaTxBase(channel)
    if (!exclusive || base < 0 || (peripheral != 0 && peripheral != 2 && peripheral != 3 && peripheral != 6 && peripheral != 7 && peripheral != 9)) return C6GdmaTxChannel(2)
    if (!c6GdmaClocksReady()) return C6GdmaTxChannel(3)
    if (!c6GdmaTxParked(channel)) return C6GdmaTxChannel(4)
    val token=(1<<49)|(channel<<47)|(int(c6GdmaRead(base))<<8)|
        (int((c6GdmaRead(base+4)>>u32(12))&u32(1))<<40)|(int(c6GdmaRead(base+48)&u32(63))<<41)
    if (!c6GdmaField(base,u32(62),u32(12)) || !c6GdmaField(base+4,u32(4096),u32(4096)) ||
        !c6GdmaField(base+48,u32(63),u32(peripheral))) return C6GdmaTxChannel(token|5)
    return C6GdmaTxChannel(token|1)
}
trusted fun C6GdmaTxChannel.closeOwned(exclusive: bool): C6GdmaTxChannel {
    if (!exclusive || this < 0 || (this&~0x3ffffffffffff) != 0 || (this&(1<<49)) == 0 ||
        (this.status() != 1 && this.status() != 5 && this.status() != 7)) return this
    val token=this&~255;val channel=(token>>>47)&3
    if (!c6GdmaClocksReady() || !c6GdmaTxParked(channel)) return C6GdmaTxChannel(token|7)
    val base=c6GdmaTxBase(channel)
    if (!c6GdmaField(base+48,u32(63),u32((token>>>41)&63)) ||
        !c6GdmaField(base+4,u32(4096),u32((token>>>40)&1)<<u32(12)) ||
        !c6GdmaField(base,u32(62),u32(token>>>8)&u32(62))) return C6GdmaTxChannel(token|7)
    return C6GdmaTxChannel(token|6)
}
