// Shared S3 ADC analog pad setup. Caller owns/quiesces pin/peripherals,
// pins RTCIO/USB register access clocks and excludes sleep/reconfiguration.
// Preserves holds, drive and neighbors; never enables outputs or restores them.
// 1configured2invalid3held4touch6crystal7legacyanalog8USB5readback/high8stage.
trusted fun esp32S3AdcPadField(address: int,mask: int,value: int): bool {
    esp32S3AdcPadWrite(address,(esp32S3AdcPadRead(address)&(4294967295^mask))|value)
    return (esp32S3AdcPadRead(address)&mask) == value
}
trusted fun esp32S3AdcPadConfigureOwned(pin: int): int {
    if (pin < 1 || pin > 20) return 2
    val bit=1<<pin
    val pad=0x60008484+pin*4
    if ((esp32S3AdcPadRead(0x600080d8)&bit) != 0 ||
        (esp32S3AdcPadRead(0x60008088)&0x200000) != 0 ||
        (esp32S3AdcPadRead(0x60008094)&0x8000) != 0) return 3
    if (pin <= 14 && (esp32S3AdcPadRead(pad)&0x500000) != 0) return 4
    if ((pin == 15 || pin == 16) && (esp32S3AdcPadRead(0x60008060)&0x10000) != 0) return 6
    // S3 has no supported DAC, but refuse a powered legacy pad analog block.
    if ((pin == 17 || pin == 18) && (esp32S3AdcPadRead(pad)&0x800) != 0) return 7
    // Conservative USB release proof: both USB controllers and RTC override
    // must have pad enable clear. Never disconnect a live USB/debug session.
    if (pin >= 19 && ((esp32S3AdcPadRead(0x60038018)&0x4000) != 0 ||
        (esp32S3AdcPadRead(0x60039000)&0x40000) != 0 ||
        (esp32S3AdcPadRead(0x60008120)&0x1000) != 0)) return 8
    esp32S3AdcPadWrite(0x60004028,bit)
    if ((esp32S3AdcPadRead(0x60004020)&bit) != 0) return 261
    // GPIO_ENABLE controls output, non-inverted: peripheral OEN cannot bypass.
    if (!esp32S3AdcPadField(0x60004554+pin*4,0xc00,0x400)) return 517
    esp32S3AdcPadWrite(0x60008414,bit<<10)
    if ((esp32S3AdcPadRead(0x6000840c)&(bit<<10)) != 0) return 773
    // Stage digital floating state before relinquishing RTC mux ownership.
    if (!esp32S3AdcPadField(0x60009004+pin*4,0x7382,0x1000)) return 1029
    // No RTC pull/input/sleep selection, digital mux; preserve touch/drive bits.
    if (!esp32S3AdcPadField(pad,0x180f2000,0)) return 1285
    return 1
}
