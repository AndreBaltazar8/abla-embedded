// Pure conversion only: caller supplies measured/eFuse reference millivolts.
// Not acquisition, automatic eFuse selection, or two-point characterization.
// Units1/2, attenuation codes0..3, widths9..12. Invalid input returns -1.
// Never silently substitutes a nominal1100mV reference for absent calibration.
fun esp32AdcVrefFromFuse(bits: int): int =
    if (bits < 1 || bits > 31) -1 else 1100+(if ((bits&16) != 0) -(bits&15) else bits)*7
fun adc1_vref_atten_scale(index: int): int =
    if (index == 0) 57431 else if (index == 1) 76236 else if (index == 2) 105481 else if (index == 3) 196602 else -1
fun adc2_vref_atten_scale(index: int): int =
    if (index == 0) 57236 else if (index == 1) 76175 else if (index == 2) 105678 else if (index == 3) 197170 else -1
fun adc1_vref_atten_offset(index: int): int =
    if (index == 0) 75 else if (index == 1) 78 else if (index == 2) 107 else if (index == 3) 142 else -1
fun adc2_vref_atten_offset(index: int): int =
    if (index == 0) 63 else if (index == 1) 66 else if (index == 2) 89 else if (index == 3) 128 else -1
fun lut_adc1_low(index: int): int =
    if (index == 0) 2240 else if (index == 1) 2297 else if (index == 2) 2352 else if (index == 3) 2405 else if (index == 4) 2457 else if (index == 5) 2512 else if (index == 6) 2564 else if (index == 7) 2616 else if (index == 8) 2664 else if (index == 9) 2709 else if (index == 10) 2754 else if (index == 11) 2795 else if (index == 12) 2832 else if (index == 13) 2868 else if (index == 14) 2903 else if (index == 15) 2937 else if (index == 16) 2969 else if (index == 17) 3000 else if (index == 18) 3030 else if (index == 19) 3060 else -1
fun lut_adc1_high(index: int): int =
    if (index == 0) 2667 else if (index == 1) 2706 else if (index == 2) 2745 else if (index == 3) 2780 else if (index == 4) 2813 else if (index == 5) 2844 else if (index == 6) 2873 else if (index == 7) 2901 else if (index == 8) 2928 else if (index == 9) 2956 else if (index == 10) 2982 else if (index == 11) 3006 else if (index == 12) 3032 else if (index == 13) 3059 else if (index == 14) 3084 else if (index == 15) 3110 else if (index == 16) 3135 else if (index == 17) 3160 else if (index == 18) 3184 else if (index == 19) 3209 else -1
fun lut_adc2_low(index: int): int =
    if (index == 0) 2238 else if (index == 1) 2293 else if (index == 2) 2347 else if (index == 3) 2399 else if (index == 4) 2451 else if (index == 5) 2507 else if (index == 6) 2561 else if (index == 7) 2613 else if (index == 8) 2662 else if (index == 9) 2710 else if (index == 10) 2754 else if (index == 11) 2792 else if (index == 12) 2831 else if (index == 13) 2869 else if (index == 14) 2904 else if (index == 15) 2937 else if (index == 16) 2968 else if (index == 17) 2999 else if (index == 18) 3029 else if (index == 19) 3059 else -1
fun lut_adc2_high(index: int): int =
    if (index == 0) 2657 else if (index == 1) 2698 else if (index == 2) 2738 else if (index == 3) 2774 else if (index == 4) 2807 else if (index == 5) 2838 else if (index == 6) 2867 else if (index == 7) 2894 else if (index == 8) 2921 else if (index == 9) 2946 else if (index == 10) 2971 else if (index == 11) 2996 else if (index == 12) 3020 else if (index == 13) 3043 else if (index == 14) 3067 else if (index == 15) 3092 else if (index == 16) 3116 else if (index == 17) 3139 else if (index == 18) 3162 else if (index == 19) 3185 else -1
fun esp32AdcVrefMillivolts(unit: int,attenuation: int,width: int,raw: int,vref: int): int {
    if (unit < 1 || unit > 2 || attenuation < 0 || attenuation > 3 || width < 9 || width > 12 || raw < 0 || vref < 995 || vref > 1205) return -1
    val samples=if (width == 9) 512 else if (width == 10) 1024 else if (width == 11) 2048 else 4096
    if (raw >= samples) return -1
    val adc=raw*(if (width == 9) 8 else if (width == 10) 4 else if (width == 11) 2 else 1)
    val scale=if (unit == 1) adc1_vref_atten_scale(attenuation) else adc2_vref_atten_scale(attenuation)
    val offset=if (unit == 1) adc1_vref_atten_offset(attenuation) else adc2_vref_atten_offset(attenuation)
    val a=vref*scale/4096
    val linear=(a*adc+32768)/65536+offset
    return esp32AdcCorrectNonlinear(unit,attenuation,adc,vref,linear)
}
// Internal validated-input correction shared by Vref and two-point paths.
fun esp32AdcCorrectNonlinear(unit: int,attenuation: int,adc: int,vref: int,linear: int): int {
    if (attenuation != 3 || adc < 2880) return linear
    val index=(adc-2880)/64
    val fraction=(adc-2880)&63
    val low0=if (unit == 1) lut_adc1_low(index) else lut_adc2_low(index)
    val low1=if (unit == 1) lut_adc1_low(index+1) else lut_adc2_low(index+1)
    val high0=if (unit == 1) lut_adc1_high(index) else lut_adc2_high(index)
    val high1=if (unit == 1) lut_adc1_high(index+1) else lut_adc2_high(index+1)
    val low=low0*(64-fraction)+low1*fraction
    val high=high0*(64-fraction)+high1*fraction
    // Validated references995..1205 and table values bound this positive sum
    // below2^31. Expose that bound to LLVM to avoid a 64-bit division helper.
    val sum=(low*(1200-vref)+high*(vref-1000)+6400)&2147483647
    val nonlinear=sum/12800
    return if (adc <= 2944) (linear*(2944-adc)+nonlinear*(adc-2880)+32)/64 else nonlinear
}
