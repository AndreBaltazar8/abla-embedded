import "./adc_trim_s3_sequence.ab"
// ESP-IDF v6.0.2 adc_ll_calibration_init/finish + set_calibration_param:
// DREF=4, trim from eFuse, external pad instead of internal calibration ground.
// Caller owns analog bus and selected ADC, pins bus/SAR power and excludes
// conversions, DMA, ULP, arbiter, touch/sleep/reconfiguration throughout.
// Bus preparation/power and post-setup analog settling remain prerequisites.
// ROM bus waits require an independent watchdog/recovery policy.
// Low8:1verified2invalid3DREF4trim5ground6final; high8 underlying trim status.
// Partial failure retains ownership. No conversion until full setup succeeds;
// retry the complete setup, no rollback to a possibly uncalibrated state.
trusted fun esp32S3AdcAnalogConfigureOwned(calibration: Esp32S3AdcCalibration): int {
    if (!calibration.valid()) return 2
    val referenceRegister=if (calibration.unit() == 1) 2 else 5
    val groundMask=if (calibration.unit() == 1) 32 else 128
    val reference=(esp32S3SarAnalogRead(referenceRegister)&143)|64
    esp32S3SarAnalogWrite(referenceRegister,reference)
    if (esp32S3SarAnalogRead(referenceRegister) != reference) return 3
    val trim=esp32S3AdcApplyTrimOwned(calibration)
    if (trim != 1) return (trim<<8)|4
    val ground=esp32S3SarAnalogRead(7)&(255^groundMask)
    esp32S3SarAnalogWrite(7,ground)
    if (esp32S3SarAnalogRead(7) != ground) return 5
    // Verify the complete profile, including shared-byte neighbors.
    val high=referenceRegister-1
    if (esp32S3SarAnalogRead(referenceRegister) != reference ||
        esp32S3SarAnalogRead(7) != ground ||
        (esp32S3SarAnalogRead(high)&15) != (calibration.initCode()>>8) ||
        esp32S3SarAnalogRead(high-1) != (calibration.initCode()&255)) return 6
    return 1
}
