import "abla/build"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../shared_storage_esp32.ab"

// Policy state is ordinary cycle-free Abla storage shared with the recovered
// compatibility entry points. No public linker alias is required.
@inline
trusted fun esp32HeapCapsFailedCallbackCell(): u32 =
    esp32Data_Labla_recovered_Esp32HeapCapabilities_data_bss_alloc_failed_callback_alloc_failed_callback_44a6846669

@inline
trusted fun esp32HeapCapsMallocLimitCell(): u32 =
    esp32HeapCapsMallocLimit

@inline
trusted fun esp32HeapCapsPolicyLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32HeapCapsPolicyStoreU32(
    address: u32,
    value: u32
): void {
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))
    return
}

@section(".iram1.0.abla.esp32HeapCapsAllocationFailed")
trusted fun esp32HeapCapsAllocationFailed(
    size: u32,
    capabilities: u32,
    functionName: u32
): void {
    val callback = esp32HeapCapsPolicyLoadU32(
        esp32HeapCapsFailedCallbackCell()
    )
    if (callback != u32(0)) callNativeVoidI32I32I32(
        int(callback),
        int(size),
        int(capabilities),
        int(functionName)
    )
    return
}

@inline
trusted fun esp32HeapCapsMatch(
    heapRecord: u32,
    capabilities: u32
): u32 {
    if (heapRecord == u32(0) ||
        esp32HeapCapsPolicyLoadU32(heapRecord + u32(28)) == u32(0)) {
        return u32(0)
    }
    val available = esp32HeapCapsPolicyLoadU32(heapRecord) |
        esp32HeapCapsPolicyLoadU32(heapRecord + u32(4)) |
        esp32HeapCapsPolicyLoadU32(heapRecord + u32(8))
    return if ((available & capabilities) == capabilities)
        u32(1) else u32(0)
}

@section(".iram1.1.abla.esp32HeapCapsMalloc")
trusted fun esp32HeapCapsMalloc(
    size: u32,
    capabilities: u32
): u32 {
    val memory = esp32HeapCapsAllocateForCurrentLifecycle(size, capabilities)
    if (memory == u32(0) && size != u32(0)) {
        esp32HeapCapsAllocationFailed(
            size,
            capabilities,
            u32(nativeStaticBytes("heap_caps_malloc\x00"))
        )
    }
    return memory
}

trusted fun esp32HeapCapsMallocExtmemEnable(limit: u32): void {
    esp32HeapCapsPolicyStoreU32(esp32HeapCapsMallocLimitCell(), limit)
    return
}

@section(".iram1.2.abla.esp32HeapCapsMallocDefault")
trusted fun esp32HeapCapsMallocDefault(size: u32): u32 {
    val limit = esp32HeapCapsPolicyLoadU32(esp32HeapCapsMallocLimitCell())
    if (limit == u32(4294967295)) {
        return esp32HeapCapsMalloc(size, u32(6144))
    }

    val firstCapabilities = if (size <= limit) u32(6144) else u32(5120)
    var memory = esp32HeapCapsAllocateForCurrentLifecycle(
        size, firstCapabilities
    )
    if (memory == u32(0) && size != u32(0)) {
        memory = esp32HeapCapsAllocateForCurrentLifecycle(size, u32(4096))
    }
    if (memory == u32(0) && size != u32(0)) {
        esp32HeapCapsAllocationFailed(
            size,
            u32(4096),
            u32(nativeStaticBytes("heap_caps_malloc_default\x00"))
        )
    }
    return memory
}

@section(".iram1.7.abla.esp32HeapCapsReallocate")
trusted fun esp32HeapCapsReallocate(
    memory: u32,
    size: u32,
    capabilities: u32
): u32 {
    val result = esp32HeapCapsReallocateBase(
        memory, size, capabilities
    )
    if (result == u32(0) && size != u32(0)) {
        esp32HeapCapsAllocationFailed(
            size,
            capabilities,
            u32(nativeStaticBytes("heap_caps_realloc\x00"))
        )
    }
    return result
}

@section(".iram1.abla.esp32HeapCapsReallocateDefault")
trusted fun esp32HeapCapsReallocateDefault(
    memory: u32,
    size: u32
): u32 {
    val limit = esp32HeapCapsPolicyLoadU32(esp32HeapCapsMallocLimitCell())
    if (limit == u32(4294967295)) {
        return esp32HeapCapsReallocate(memory, size, u32(6144))
    }

    val firstCapabilities = if (size <= limit) u32(6144) else u32(5120)
    var result = esp32HeapCapsReallocateBase(
        memory, size, firstCapabilities
    )
    if (result == u32(0) && size != u32(0)) {
        result = esp32HeapCapsReallocateBase(
            memory, size, u32(4096)
        )
    }
    if (result == u32(0) && size != u32(0)) {
        esp32HeapCapsAllocationFailed(
            size,
            u32(4096),
            u32(nativeStaticBytes("heap_caps_realloc_default\x00"))
        )
    }
    return result
}

@section(".iram1.8.abla.esp32HeapCapsCallocate")
trusted fun esp32HeapCapsCallocate(
    count: u32,
    size: u32,
    capabilities: u32
): u32 {
    val memory = esp32HeapCapsCallocBase(
        count, size, capabilities
    )
    if (memory == u32(0) && size != u32(0)) {
        esp32HeapCapsAllocationFailed(
            count * size,
            capabilities,
            u32(nativeStaticBytes("heap_caps_calloc\x00"))
        )
    }
    return memory
}

@inline
trusted fun esp32HeapCapsAlignedArgumentsValid(
    alignment: u32,
    size: u32,
    capabilities: u32,
    functionName: u32
): bool {
    if (alignment == u32(0) ||
        (alignment & (alignment - u32(1))) != u32(0) ||
        size == u32(0)) return false
    if (size > u32(4194300)) {
        esp32HeapCapsAllocationFailed(size, capabilities, functionName)
        return false
    }
    return true
}

@section(".iram1.abla.esp32HeapCapsAlignedAllocate")
trusted fun esp32HeapCapsAlignedAllocate(
    alignment: u32,
    size: u32,
    capabilities: u32
): u32 {
    val functionName = u32(nativeStaticBytes("heap_caps_aligned_alloc\x00"))
    if (!esp32HeapCapsAlignedArgumentsValid(
        alignment, size, capabilities, functionName
    )) return u32(0)
    val memory = esp32HeapCapsAlignedAllocateBase(
        alignment, size, capabilities
    )
    if (memory == u32(0)) {
        esp32HeapCapsAllocationFailed(size, capabilities, functionName)
    }
    return memory
}

@section(".iram1.abla.esp32HeapCapsAlignedAllocateDefault")
trusted fun esp32HeapCapsAlignedAllocateDefault(
    alignment: u32,
    size: u32
): u32 {
    val limit = esp32HeapCapsPolicyLoadU32(esp32HeapCapsMallocLimitCell())
    if (limit == u32(4294967295)) {
        return esp32HeapCapsAlignedAllocate(alignment, size, u32(6144))
    }

    val functionName = u32(
        nativeStaticBytes("heap_caps_aligned_alloc_default\x00")
    )
    if (!esp32HeapCapsAlignedArgumentsValid(
        alignment, size, u32(4096), functionName
    )) return u32(0)

    val firstCapabilities = if (size <= limit) u32(6144) else u32(5120)
    var memory = esp32HeapCapsAlignedAllocateBase(
        alignment, size, firstCapabilities
    )
    if (memory != u32(0)) return memory
    memory = esp32HeapCapsAlignedAllocateBase(
        alignment, size, u32(4096)
    )
    if (memory == u32(0)) {
        esp32HeapCapsAllocationFailed(size, u32(4096), functionName)
    }
    return memory
}

@section(".iram1.abla.esp32HeapCapsAlignedFree")
trusted fun esp32HeapCapsAlignedFree(memory: u32): void {
    esp32HeapCapsFree(memory)
    return
}

trusted fun esp32HeapCapsAlignedCallocate(
    alignment: u32,
    count: u32,
    size: u32,
    capabilities: u32
): u32 {
    val totalWide = u64(count) * u64(size)
    if (totalWide > u64(4294967295)) return u32(0)
    val total = u32(totalWide)
    val memory = esp32HeapCapsAlignedAllocate(
        alignment, total, capabilities
    )
    if (memory != u32(0)) ablaUnsafeSetMemory(
        nativePointerFromAddress(int(memory)), 0, int(total)
    )
    return memory
}
