import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHeapCapabilitiesInitInternals(): bool {
    if (!internalFunction("esp32RecoveredHeapCapsEnableNonosStackHeaps", "heap_caps_enable_nonos_stack_heaps")) return false
    if (!internalFunction("esp32RecoveredHeapCapsInit", "heap_caps_init")) return false
    if (!internalFunction("esp32RecoveredHeapCapsCheckAddRegionAllowed", "heap_caps_check_add_region_allowed")) return false
    if (!internalFunction("esp32RecoveredHeapCapsAddRegionWithCaps", "heap_caps_add_region_with_caps")) return false
    if (!internalFunction("esp32RecoveredHeapCapsAddRegion", "heap_caps_add_region")) return false
    true
}
