import "../../xtensa/assembly.ab"
import "../shared_storage_esp32.ab"

// The registered heap list is created by heap initialization. Iteration and
// capability filtering are ordinary Abla; only resolving the link-time cell
// address is target-specific.
@inline
trusted fun esp32HeapCapsRegisteredHeapsCell(): u32 =
    esp32Data_registered_heaps_d5e1318ad9

@inline
trusted fun esp32HeapCapsFirstRegisteredHeap(): u32 =
    esp32HeapCapsPolicyLoadU32(esp32HeapCapsRegisteredHeapsCell())

@inline
trusted fun esp32HeapCapsNextRegisteredHeap(heap: u32): u32 =
    esp32HeapCapsPolicyLoadU32(heap + u32(32))

trusted fun esp32HeapCapsGetTotalSize(capabilities: u32): u32 {
    var total = u32(0)
    var heap = esp32HeapCapsFirstRegisteredHeap()
    while (heap != u32(0)) {
        if (esp32HeapCapsMatch(heap, capabilities) != u32(0)) {
            total = total +
                esp32HeapCapsPolicyLoadU32(heap + u32(16)) -
                esp32HeapCapsPolicyLoadU32(heap + u32(12))
        }
        heap = esp32HeapCapsNextRegisteredHeap(heap)
    }
    return total
}

trusted fun esp32HeapCapsGetFreeSize(capabilities: u32): u32 {
    var total = u32(0)
    var heap = esp32HeapCapsFirstRegisteredHeap()
    while (heap != u32(0)) {
        if (esp32HeapCapsMatch(heap, capabilities) != u32(0)) {
            total = total + esp32MultiHeapFreeSize(
                esp32HeapCapsPolicyLoadU32(heap + u32(28))
            )
        }
        heap = esp32HeapCapsNextRegisteredHeap(heap)
    }
    return total
}

trusted fun esp32HeapCapsGetMinimumFreeSize(capabilities: u32): u32 {
    var total = u32(0)
    var heap = esp32HeapCapsFirstRegisteredHeap()
    while (heap != u32(0)) {
        if (esp32HeapCapsMatch(heap, capabilities) != u32(0)) {
            total = total + esp32MultiHeapMinimumFreeSize(
                esp32HeapCapsPolicyLoadU32(heap + u32(28))
            )
        }
        heap = esp32HeapCapsNextRegisteredHeap(heap)
    }
    return total
}

trusted fun esp32HeapCapsCheckIntegrity(
    capabilities: u32,
    printErrors: u32
): u32 {
    val allHeaps = (capabilities & u32(2147483648)) != u32(0)
    var valid = u32(1)
    var heap = esp32HeapCapsFirstRegisteredHeap()
    while (heap != u32(0)) {
        val handle = esp32HeapCapsPolicyLoadU32(heap + u32(28))
        if (handle != u32(0) &&
            (allHeaps || esp32HeapCapsMatch(heap, capabilities) != u32(0))) {
            if (esp32MultiHeapCheck(handle, printErrors) == u32(0)) {
                valid = u32(0)
            }
        }
        heap = esp32HeapCapsNextRegisteredHeap(heap)
    }
    return valid
}

trusted fun esp32HeapCapsCheckIntegrityAll(printErrors: u32): u32 =
    esp32HeapCapsCheckIntegrity(u32(2147483648), printErrors)

trusted fun esp32HeapCapsDump(capabilities: u32): void {
    val allHeaps = (capabilities & u32(2147483648)) != u32(0)
    var heap = esp32HeapCapsFirstRegisteredHeap()
    while (heap != u32(0)) {
        val handle = esp32HeapCapsPolicyLoadU32(heap + u32(28))
        if (handle != u32(0) &&
            (allHeaps || esp32HeapCapsMatch(heap, capabilities) != u32(0))) {
            esp32MultiHeapDump(handle)
        }
        heap = esp32HeapCapsNextRegisteredHeap(heap)
    }
    return
}

trusted fun esp32HeapCapsDumpAll(): void {
    esp32HeapCapsDump(u32(2147483648))
    return
}
