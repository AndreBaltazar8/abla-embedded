import "abla/unsafe/memory"

@inline
trusted fun esp32TlsfLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

// These are TLSF layout operations, not Xtensa operations. Expressing them
// as scalar Abla lets LLVM fold constants and inline through multi_heap.
@inline
trusted fun esp32TlsfBlockSize(memory: u32): u32 =
    if (memory == u32(0)) u32(0)
    else esp32TlsfLoadU32(memory - u32(4)) & ~u32(3)

@inline
trusted fun esp32TlsfSize(control: u32): u32 =
    if (control == u32(0)) u32(0)
    else esp32TlsfLoadU32(control + u32(20))

@inline
trusted fun esp32TlsfPoolOverhead(): u32 = u32(8)

@inline
trusted fun esp32TlsfAllocationOverhead(): u32 = u32(4)

trusted fun esp32TlsfDestroy(control: u32): void {
    return
}

@inline
trusted fun esp32TlsfGetPool(control: u32): u32 =
    control + esp32TlsfSize(control)
