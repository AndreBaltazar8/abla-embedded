import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHeapMemoryLayoutInternals(): bool {
    if (!internalFunction("esp32RecoveredEsp32HeapMemoryLayoutDataAnchor", "esp32HeapMemoryLayoutDataAnchor")) return false
    true
}
