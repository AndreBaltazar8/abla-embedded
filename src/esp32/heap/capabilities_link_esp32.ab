import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHeapCapabilitiesInternals(): bool {
    if (!internalFunction("esp32RecoveredHeapCapsRegisterFailedAllocCallback", "heap_caps_register_failed_alloc_callback")) return false
    if (!internalFunction("esp32HeapCapsMatch", "heap_caps_match")) return false
    if (!internalFunction("esp32HeapCapsMalloc", "heap_caps_malloc")) return false
    if (!internalFunction("esp32HeapCapsMallocExtmemEnable", "heap_caps_malloc_extmem_enable")) return false
    if (!internalFunction("esp32HeapCapsMallocDefault", "heap_caps_malloc_default")) return false
    if (!internalFunction("esp32RecoveredHeapCapsMallocPrefer", "heap_caps_malloc_prefer")) return false
    if (!internalFunction("esp32RecoveredHeapCapsReallocPrefer", "heap_caps_realloc_prefer")) return false
    if (!internalFunction("esp32RecoveredHeapCapsCallocPrefer", "heap_caps_calloc_prefer")) return false
    if (!internalFunction("esp32HeapCapsReallocate", "heap_caps_realloc")) return false
    if (!internalFunction("esp32HeapCapsReallocateDefault", "heap_caps_realloc_default")) return false
    if (!internalFunction("esp32HeapCapsCallocate", "heap_caps_calloc")) return false
    if (!internalFunction("esp32HeapCapsGetTotalSize", "heap_caps_get_total_size")) return false
    if (!internalFunction("esp32HeapCapsGetFreeSize", "heap_caps_get_free_size")) return false
    if (!internalFunction("esp32HeapCapsGetMinimumFreeSize", "heap_caps_get_minimum_free_size")) return false
    if (!internalFunction("esp32RecoveredHeapCapsMonitorLocalMinimumFreeSizeStart", "heap_caps_monitor_local_minimum_free_size_start")) return false
    if (!internalFunction("esp32RecoveredHeapCapsMonitorLocalMinimumFreeSizeStop", "heap_caps_monitor_local_minimum_free_size_stop")) return false
    if (!internalFunction("esp32RecoveredHeapCapsGetInfo", "heap_caps_get_info")) return false
    if (!internalFunction("esp32RecoveredHeapCapsGetLargestFreeBlock", "heap_caps_get_largest_free_block")) return false
    if (!internalFunction("esp32RecoveredHeapCapsPrintHeapInfo", "heap_caps_print_heap_info")) return false
    if (!internalFunction("esp32HeapCapsCheckIntegrity", "heap_caps_check_integrity")) return false
    if (!internalFunction("esp32HeapCapsCheckIntegrityAll", "heap_caps_check_integrity_all")) return false
    if (!internalFunction("esp32RecoveredHeapCapsCheckIntegrityAddr", "heap_caps_check_integrity_addr")) return false
    if (!internalFunction("esp32HeapCapsDump", "heap_caps_dump")) return false
    if (!internalFunction("esp32HeapCapsDumpAll", "heap_caps_dump_all")) return false
    if (!internalFunction("esp32RecoveredHeapCapsGetAllocatedSize", "heap_caps_get_allocated_size")) return false
    if (!internalFunction("esp32RecoveredHeapCapsGetContainingBlockSize", "heap_caps_get_containing_block_size")) return false
    if (!internalFunction("esp32HeapCapsAlignedAllocate", "heap_caps_aligned_alloc")) return false
    if (!internalFunction("esp32HeapCapsAlignedAllocateDefault", "heap_caps_aligned_alloc_default")) return false
    if (!internalFunction("esp32HeapCapsAlignedFree", "heap_caps_aligned_free")) return false
    if (!internalFunction("esp32HeapCapsAlignedCallocate", "heap_caps_aligned_calloc")) return false
    if (!internalFunction("esp32RecoveredHeapCapsWalk", "heap_caps_walk")) return false
    if (!internalFunction("esp32RecoveredHeapCapsWalkAll", "heap_caps_walk_all")) return false
    true
}
