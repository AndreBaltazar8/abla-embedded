import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHeapTlsfInternals(): bool {
    if (!internalFunction("esp32RecoveredTlsfCheck", "tlsf_check")) return false
    if (!internalFunction("esp32RecoveredTlsfWalkPool", "tlsf_walk_pool")) return false
    if (!internalFunction("esp32TlsfBlockSize", "tlsf_block_size")) return false
    if (!internalFunction("esp32RecoveredTlsfCheckPool", "tlsf_check_pool")) return false
    if (!internalFunction("esp32TlsfFitSize", "tlsf_fit_size")) return false
    if (!internalFunction("esp32TlsfSize", "tlsf_size")) return false
    if (!internalFunction("esp32TlsfPoolOverhead", "tlsf_pool_overhead")) return false
    if (!internalFunction("esp32TlsfAllocationOverhead", "tlsf_alloc_overhead")) return false
    if (!internalFunction("esp32TlsfAddPool", "tlsf_add_pool")) return false
    if (!internalFunction("esp32RecoveredTlsfRemovePool", "tlsf_remove_pool")) return false
    if (!internalFunction("esp32TlsfCreate", "tlsf_create")) return false
    if (!internalFunction("esp32TlsfCreateWithPool", "tlsf_create_with_pool")) return false
    if (!internalFunction("esp32TlsfDestroy", "tlsf_destroy")) return false
    if (!internalFunction("esp32TlsfGetPool", "tlsf_get_pool")) return false
    if (!internalFunction("esp32TlsfMalloc", "tlsf_malloc")) return false
    if (!internalFunction("esp32RecoveredTlsfMallocAddr", "tlsf_malloc_addr")) return false
    if (!internalFunction("esp32RecoveredTlsfMemalignOffs", "tlsf_memalign_offs")) return false
    if (!internalFunction("esp32RecoveredTlsfMemalign", "tlsf_memalign")) return false
    if (!internalFunction("esp32TlsfFree", "tlsf_free")) return false
    if (!internalFunction("esp32RecoveredTlsfRealloc", "tlsf_realloc")) return false
    if (!internalFunction("esp32RecoveredTlsfFindContainingBlock", "tlsf_find_containing_block")) return false
    true
}
