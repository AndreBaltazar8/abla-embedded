import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHeapMemoryLayoutUtilsInternals(): bool {
    if (!internalFunction("esp32RecoveredSocGetAvailableMemoryRegionMaxCount", "soc_get_available_memory_region_max_count")) return false
    if (!internalFunction("esp32RecoveredSocGetAvailableMemoryRegions", "soc_get_available_memory_regions")) return false
    true
}
