import "../../runtime/freestanding_integer.ab"
import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"
import "memory_layout_esp32.ab"
import "../linker_layout_esp32.ab"

trusted fun esp32ReservedMemoryRegionCount(): u32 {
    // The Abla memory-layout unit owns these nine descriptors directly. C's
    // SOC_RESERVE_MEMORY_REGION macro normally discovers them through linker
    // sections, but that section is intentionally absent once the C object is
    // removed from the monolithic firmware.
    u32(9)
}

trusted fun esp32MemoryLayoutLoadWord(address: u32): u32 {
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))
}

trusted fun esp32MemoryLayoutStoreWord(address: u32, value: u32): void {
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))
}

trusted fun esp32ReservedRegionAddress(regions: u32, index: u32): u32 {
    regions + index * u32(8)
}

trusted fun esp32MemoryRegionAddress(regions: u32, index: u32): u32 {
    regions + index * u32(20)
}

trusted fun esp32SwapReservedRegions(left: u32, right: u32): void {
    val leftStart = esp32MemoryLayoutLoadWord(left)
    val leftEnd = esp32MemoryLayoutLoadWord(left + u32(4))
    esp32MemoryLayoutStoreWord(left, esp32MemoryLayoutLoadWord(right))
    esp32MemoryLayoutStoreWord(left + u32(4), esp32MemoryLayoutLoadWord(right + u32(4)))
    esp32MemoryLayoutStoreWord(right, leftStart)
    esp32MemoryLayoutStoreWord(right + u32(4), leftEnd)
}

// Copy, order, align, and validate linker-provided reserved ranges. Insertion
// sort keeps the whole operation in Abla and is ideal for this very small
// startup-only table.
trusted fun esp32PrepareReservedMemoryRegions(regions: u32, count: u32): void {
    freestandingCopy(
        regions,
        esp32Data_Labla_recovered_Esp32HeapMemoryLayout_data_reserved_memory_address_reserved_region_rtc_reserved_data_f5138a09c7,
        count * u32(8)
    )

    var index = u32(1)
    while (index < count) {
        var current = index
        while (current != u32(0)) {
            val left = esp32ReservedRegionAddress(regions, current - u32(1))
            val right = esp32ReservedRegionAddress(regions, current)
            if (esp32MemoryLayoutLoadWord(left) <= esp32MemoryLayoutLoadWord(right)) {
                current = u32(0)
            } else {
                esp32SwapReservedRegions(left, right)
                current = current - u32(1)
            }
        }
        index = index + u32(1)
    }

    index = u32(0)
    while (index < count) {
        val reservedRegion = esp32ReservedRegionAddress(regions, index)
        val start = esp32MemoryLayoutLoadWord(reservedRegion) & ~u32(3)
        val end = (esp32MemoryLayoutLoadWord(reservedRegion + u32(4)) + u32(3)) & ~u32(3)
        esp32MemoryLayoutStoreWord(reservedRegion, start)
        esp32MemoryLayoutStoreWord(reservedRegion + u32(4), end)

        if (start > end) freestandingAbortValue()
        if (index + u32(1) < count) {
            val nextStart = esp32MemoryLayoutLoadWord(
                esp32ReservedRegionAddress(regions, index + u32(1))
            ) & ~u32(3)
            if (nextStart <= start || end > nextStart) freestandingAbortValue()
        }
        index = index + u32(1)
    }
}

// Original ABI symbol: soc_get_available_memory_region_max_count
trusted fun esp32RecoveredSocGetAvailableMemoryRegionMaxCount(): u32 {
    val regionCount = esp32MemoryLayoutLoadWord(esp32Data_soc_memory_region_count_a9a61f1f1f)
    regionCount + esp32ReservedMemoryRegionCount()
}

// Original ABI symbol: soc_get_available_memory_regions
trusted fun esp32RecoveredSocGetAvailableMemoryRegions(outputRegions: u32): u32 {
    val inputCount = esp32MemoryLayoutLoadWord(esp32Data_soc_memory_region_count_a9a61f1f1f)
    val reservedCount = esp32ReservedMemoryRegionCount()
    val reservedRegions =
        esp32Data_Labla_recovered_Esp32HeapMemoryLayout_data_reserved_memory_address_reserved_region_rtc_reserved_data_f5138a09c7

    // The linker-owned ranges are not emitted in address order. ESP-IDF sorts
    // its reservation section before subtracting it from the SoC memory map;
    // do the same before the ordered walk below so the live startup stacks and
    // application data can never be registered as heap storage.
    esp32PrepareReservedMemoryRegions(reservedRegions, reservedCount)

    var inputIndex = u32(0)
    var outputCount = u32(0)
    while (inputIndex < inputCount) {
        val inputRegion = esp32MemoryRegionAddress(
            esp32Data_soc_memory_regions_490acd9023,
            inputIndex
        )
        var cursor = esp32MemoryLayoutLoadWord(inputRegion)
        val end = cursor + esp32MemoryLayoutLoadWord(inputRegion + u32(4))

        var reservedIndex = u32(0)
        var finished = false
        while (reservedIndex < reservedCount && !finished) {
            val reserved = esp32ReservedRegionAddress(reservedRegions, reservedIndex)
            val reservedStart = esp32MemoryLayoutLoadWord(reserved)
            val reservedEnd = esp32MemoryLayoutLoadWord(reserved + u32(4))

            if (reservedEnd <= cursor) {
                reservedIndex = reservedIndex + u32(1)
            } else if (reservedStart >= end) {
                finished = true
            } else {
                if (reservedStart > cursor && reservedStart - cursor > u32(16)) {
                    val output = esp32MemoryRegionAddress(outputRegions, outputCount)
                    esp32MemoryLayoutStoreWord(output, cursor)
                    esp32MemoryLayoutStoreWord(output + u32(4), reservedStart - cursor)
                    esp32MemoryLayoutStoreWord(output + u32(8), esp32MemoryLayoutLoadWord(inputRegion + u32(8)))
                    esp32MemoryLayoutStoreWord(output + u32(12), esp32MemoryLayoutLoadWord(inputRegion + u32(12)))
                    esp32MemoryLayoutStoreWord(output + u32(16), esp32MemoryLayoutLoadWord(inputRegion + u32(16)))
                    outputCount = outputCount + u32(1)
                }
                if (reservedEnd > cursor) cursor = reservedEnd
                if (cursor >= end) finished = true
                reservedIndex = reservedIndex + u32(1)
            }
        }

        if (cursor < end && end - cursor > u32(16)) {
            val output = esp32MemoryRegionAddress(outputRegions, outputCount)
            esp32MemoryLayoutStoreWord(output, cursor)
            esp32MemoryLayoutStoreWord(output + u32(4), end - cursor)
            esp32MemoryLayoutStoreWord(
                output + u32(8),
                esp32MemoryLayoutLoadWord(inputRegion + u32(8))
            )
            esp32MemoryLayoutStoreWord(
                output + u32(12),
                esp32MemoryLayoutLoadWord(inputRegion + u32(12))
            )
            esp32MemoryLayoutStoreWord(
                output + u32(16),
                esp32MemoryLayoutLoadWord(inputRegion + u32(16))
            )
            outputCount = outputCount + u32(1)
        }
        inputIndex = inputIndex + u32(1)
    }
    outputCount
}
