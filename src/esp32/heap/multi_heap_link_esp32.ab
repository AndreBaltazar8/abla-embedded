import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMultiHeapInternals(): bool {
    if (!internalFunction("esp32MultiHeapGetBlockAddress", "multi_heap_get_block_address")) return false
    if (!internalFunction("esp32MultiHeapGetAllocatedSize", "multi_heap_get_allocated_size")) return false
    if (!internalFunction("esp32MultiHeapGetFullBlockSize", "multi_heap_get_full_block_size")) return false
    if (!internalFunction("esp32MultiHeapRegister", "multi_heap_register")) return false
    if (!internalFunction("esp32MultiHeapSetLock", "multi_heap_set_lock")) return false
    if (!internalFunction("esp32MultiHeapInternalLock", "multi_heap_internal_lock")) return false
    if (!internalFunction("esp32MultiHeapInternalUnlock", "multi_heap_internal_unlock")) return false
    if (!internalFunction("esp32MultiHeapGetFirstBlock", "multi_heap_get_first_block")) return false
    if (!internalFunction("esp32MultiHeapGetNextBlock", "multi_heap_get_next_block")) return false
    if (!internalFunction("esp32MultiHeapIsFree", "multi_heap_is_free")) return false
    if (!internalFunction("esp32MultiHeapMalloc", "multi_heap_malloc")) return false
    if (!internalFunction("esp32MultiHeapAlignedFree", "multi_heap_aligned_free")) return false
    if (!internalFunction("esp32MultiHeapReallocate", "multi_heap_realloc")) return false
    if (!internalFunction("esp32MultiHeapAlignedAllocateOffset", "multi_heap_aligned_alloc_impl_offs")) return false
    if (!internalFunction("esp32MultiHeapAlignedAllocateOffset", "multi_heap_aligned_alloc_offs")) return false
    if (!internalFunction("esp32MultiHeapAlignedAllocate", "multi_heap_aligned_alloc")) return false
    if (!internalFunction("esp32MultiHeapCheck", "multi_heap_check")) return false
    if (!internalFunction("esp32MultiHeapDump", "multi_heap_dump")) return false
    if (!internalFunction("esp32MultiHeapFreeSize", "multi_heap_free_size")) return false
    if (!internalFunction("esp32MultiHeapMinimumFreeSize", "multi_heap_minimum_free_size")) return false
    if (!internalFunction("esp32MultiHeapGetInfo", "multi_heap_get_info")) return false
    if (!internalFunction("esp32MultiHeapWalk", "multi_heap_walk")) return false
    if (!internalFunction("esp32MultiHeapFindContainingBlock", "multi_heap_find_containing_block")) return false
    if (!internalFunction("esp32MultiHeapResetMinimumFreeBytes", "multi_heap_reset_minimum_free_bytes")) return false
    if (!internalFunction("esp32MultiHeapRestoreMinimumFreeBytes", "multi_heap_restore_minimum_free_bytes")) return false
    if (!internalFunction("esp32MultiHeapGetBlockAddressImpl", "multi_heap_get_block_address_impl")) return false
    if (!internalFunction("esp32MultiHeapGetAllocatedSizeImpl", "multi_heap_get_allocated_size_impl")) return false
    if (!internalFunction("esp32MultiHeapRegisterImpl", "multi_heap_register_impl")) return false
    if (!internalFunction("esp32MultiHeapMallocImpl", "multi_heap_malloc_impl")) return false
    if (!internalFunction("esp32MultiHeapFreeImpl", "multi_heap_free_impl")) return false
    if (!internalFunction("esp32MultiHeapFree", "multi_heap_free")) return false
    if (!internalFunction("esp32MultiHeapReallocateImpl", "multi_heap_realloc_impl")) return false
    if (!internalFunction("esp32MultiHeapAlignedAllocateImpl", "multi_heap_aligned_alloc_impl")) return false
    if (!internalFunction("esp32MultiHeapFreeSizeImpl", "multi_heap_free_size_impl")) return false
    if (!internalFunction("esp32MultiHeapMinimumFreeSizeImpl", "multi_heap_minimum_free_size_impl")) return false
    if (!internalFunction("esp32MultiHeapGetInfoImpl", "multi_heap_get_info_impl")) return false
    if (!internalFunction("esp32MultiHeapFindContainingBlockImpl", "multi_heap_find_containing_block_impl")) return false
    true
}
