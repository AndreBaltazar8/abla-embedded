import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHeapCapabilitiesBaseInternals(): bool {
    if (!internalFunction("esp32HeapCapsFree", "heap_caps_free")) return false
    if (!internalFunction("esp32HeapCapsAlignedAllocateBase", "heap_caps_aligned_alloc_base")) return false
    if (!internalFunction("esp32HeapCapsMallocBase", "heap_caps_malloc_base")) return false
    if (!internalFunction("esp32HeapCapsReallocateBase", "heap_caps_realloc_base")) return false
    if (!internalFunction("esp32HeapCapsCallocBase", "heap_caps_calloc_base")) return false
    true
}
