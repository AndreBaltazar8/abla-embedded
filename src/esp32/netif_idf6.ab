import "./network/netif_lwip_esp32.ab"

// Source-owned network initialization. The reconstructed implementation keeps
// its original register-shaped arguments internally, but callers use a normal
// typed Abla function and do not create an external linker symbol.
trusted fun esp_netif_init(): i32 =
    i32(esp32RecoveredEspNetifInit(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    ))
