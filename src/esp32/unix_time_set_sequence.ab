import "./sdk/raw_buffer.ab"
// ESP-IDF6 timeval: signed64 seconds at0, signed32 microseconds at8.
// This runtime reads wall time through unsigned microsecond division, so
// pre-1970 dates cannot roundtrip. Reject them rather than report false success.
// Bound conversion to signed64 microseconds before invoking timekeeping.
trusted fun esp32SetUnixTimeWithBuffer(seconds: int,value: NativeBuffer): bool {
    if (seconds < 0 || seconds > 9223372036854 || !value.hasAddressRange(0,16)) return false
    value.storeU32(0,seconds & 0xFFFFFFFF)
    value.storeU32(4,seconds>>>32)
    value.storeU32(8,0)
    value.storeU32(12,0)
    esp32SetUnixTimeValue(value.addressValue()) == 0
}
