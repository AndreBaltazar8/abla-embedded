import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPthreadConditionVariableInternals(): bool {
    if (!internalFunction("esp32RecoveredPthreadCondattrInit", "pthread_condattr_init")) return false
    if (!internalFunction("esp32RecoveredPthreadCondattrDestroy", "pthread_condattr_destroy")) return false
    if (!internalFunction("esp32RecoveredPthreadCondattrGetpshared", "pthread_condattr_getpshared")) return false
    if (!internalFunction("esp32RecoveredPthreadCondattrSetpshared", "pthread_condattr_setpshared")) return false
    if (!internalFunction("esp32RecoveredPthreadCondattrGetclock", "pthread_condattr_getclock")) return false
    if (!internalFunction("esp32RecoveredPthreadCondattrSetclock", "pthread_condattr_setclock")) return false
    if (!internalFunction("esp32RecoveredPthreadCondInit", "pthread_cond_init")) return false
    if (!internalFunction("esp32RecoveredPthreadCondSignal", "pthread_cond_signal")) return false
    if (!internalFunction("esp32RecoveredPthreadCondBroadcast", "pthread_cond_broadcast")) return false
    if (!internalFunction("esp32RecoveredPthreadCondTimedwait", "pthread_cond_timedwait")) return false
    if (!internalFunction("esp32RecoveredPthreadCondWait", "pthread_cond_wait")) return false
    if (!internalFunction("esp32RecoveredPthreadCondDestroy", "pthread_cond_destroy")) return false
    if (!internalFunction("esp32RecoveredPthreadIncludePthreadCondVarImpl", "pthread_include_pthread_cond_var_impl")) return false
    true
}
