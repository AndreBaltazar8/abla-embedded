import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPthreadRwlockInternals(): bool {
    if (!internalFunction("esp32RecoveredPthreadRwlockInit", "pthread_rwlock_init")) return false
    if (!internalFunction("esp32RecoveredPthreadRwlockDestroy", "pthread_rwlock_destroy")) return false
    if (!internalFunction("esp32RecoveredPthreadRwlockRdlock", "pthread_rwlock_rdlock")) return false
    if (!internalFunction("esp32RecoveredPthreadRwlockTryrdlock", "pthread_rwlock_tryrdlock")) return false
    if (!internalFunction("esp32RecoveredPthreadRwlockWrlock", "pthread_rwlock_wrlock")) return false
    if (!internalFunction("esp32RecoveredPthreadRwlockTrywrlock", "pthread_rwlock_trywrlock")) return false
    if (!internalFunction("esp32RecoveredPthreadRwlockUnlock", "pthread_rwlock_unlock")) return false
    if (!internalFunction("esp32RecoveredPthreadRwlockTimedwrlock", "pthread_rwlock_timedwrlock")) return false
    if (!internalFunction("esp32RecoveredPthreadRwlockTimedrdlock", "pthread_rwlock_timedrdlock")) return false
    if (!internalFunction("esp32RecoveredPthreadIncludePthreadRwlockImpl", "pthread_include_pthread_rwlock_impl")) return false
    true
}
