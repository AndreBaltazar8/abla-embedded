import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPthreadSemaphoreInternals(): bool {
    if (!internalFunction("esp32RecoveredSemDestroy", "sem_destroy")) return false
    if (!internalFunction("esp32RecoveredSemInit", "sem_init")) return false
    if (!internalFunction("esp32RecoveredSemPost", "sem_post")) return false
    if (!internalFunction("esp32RecoveredSemTimedwait", "sem_timedwait")) return false
    if (!internalFunction("esp32RecoveredSemTrywait", "sem_trywait")) return false
    if (!internalFunction("esp32RecoveredSemWait", "sem_wait")) return false
    if (!internalFunction("esp32RecoveredSemGetvalue", "sem_getvalue")) return false
    if (!internalFunction("esp32RecoveredPthreadIncludePthreadSemaphoreImpl", "pthread_include_pthread_semaphore_impl")) return false
    true
}
