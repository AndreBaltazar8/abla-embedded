import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPthreadLocalStorageInternals(): bool {
    if (!internalFunction("esp32RecoveredPthreadKeyCreate", "pthread_key_create")) return false
    if (!internalFunction("esp32RecoveredPthreadKeyDelete", "pthread_key_delete")) return false
    if (!internalFunction("esp32RecoveredPthreadInternalLocalStorageDestructorCallback", "pthread_internal_local_storage_destructor_callback")) return false
    if (!internalFunction("esp32RecoveredPthreadGetspecific", "pthread_getspecific")) return false
    if (!internalFunction("esp32RecoveredPthreadSetspecific", "pthread_setspecific")) return false
    if (!internalFunction("esp32RecoveredPthreadIncludePthreadLocalStorageImpl", "pthread_include_pthread_local_storage_impl")) return false
    true
}
