import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPthreadPthreadInternals(): bool {
    if (!internalFunction("esp32RecoveredEspPthreadInit", "esp_pthread_init")) return false
    if (!internalFunction("esp32RecoveredEspPthreadSetCfg", "esp_pthread_set_cfg")) return false
    if (!internalFunction("esp32RecoveredEspPthreadGetCfg", "esp_pthread_get_cfg")) return false
    if (!internalFunction("esp32RecoveredEspPthreadGetDefaultConfig", "esp_pthread_get_default_config")) return false
    if (!internalFunction("esp32RecoveredPthreadCreate", "pthread_create")) return false
    if (!internalFunction("esp32RecoveredPthreadJoin", "pthread_join")) return false
    if (!internalFunction("esp32RecoveredPthreadDetach", "pthread_detach")) return false
    if (!internalFunction("esp32RecoveredPthreadExit", "pthread_exit")) return false
    if (!internalFunction("esp32RecoveredPthreadCancel", "pthread_cancel")) return false
    if (!internalFunction("esp32RecoveredSchedYield", "sched_yield")) return false
    if (!internalFunction("esp32RecoveredPthreadSelf", "pthread_self")) return false
    if (!internalFunction("esp32RecoveredPthreadEqual", "pthread_equal")) return false
    if (!internalFunction("esp32RecoveredPthreadOnce", "pthread_once")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexInit", "pthread_mutex_init")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexDestroy", "pthread_mutex_destroy")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexLock", "pthread_mutex_lock")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexTimedlock", "pthread_mutex_timedlock")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexTrylock", "pthread_mutex_trylock")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexUnlock", "pthread_mutex_unlock")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexattrInit", "pthread_mutexattr_init")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexattrDestroy", "pthread_mutexattr_destroy")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexattrGettype", "pthread_mutexattr_gettype")) return false
    if (!internalFunction("esp32RecoveredPthreadMutexattrSettype", "pthread_mutexattr_settype")) return false
    if (!internalFunction("esp32RecoveredPthreadAttrInit", "pthread_attr_init")) return false
    if (!internalFunction("esp32RecoveredPthreadAttrDestroy", "pthread_attr_destroy")) return false
    if (!internalFunction("esp32RecoveredPthreadAttrGetstacksize", "pthread_attr_getstacksize")) return false
    if (!internalFunction("esp32RecoveredPthreadAttrSetstacksize", "pthread_attr_setstacksize")) return false
    if (!internalFunction("esp32RecoveredPthreadAttrGetdetachstate", "pthread_attr_getdetachstate")) return false
    if (!internalFunction("esp32RecoveredPthreadAttrSetdetachstate", "pthread_attr_setdetachstate")) return false
    if (!internalFunction("esp32RecoveredPthreadGetschedparam", "pthread_getschedparam")) return false
    if (!internalFunction("esp32RecoveredSchedGetPriorityMin", "sched_get_priority_min")) return false
    if (!internalFunction("esp32RecoveredSchedGetPriorityMax", "sched_get_priority_max")) return false
    if (!internalFunction("esp32RecoveredPthreadSetschedparam", "pthread_setschedparam")) return false
    if (!internalFunction("esp32RecoveredPthreadSetschedprio", "pthread_setschedprio")) return false
    if (!internalFunction("esp32RecoveredPthreadIncludePthreadImpl", "pthread_include_pthread_impl")) return false
    true
}
