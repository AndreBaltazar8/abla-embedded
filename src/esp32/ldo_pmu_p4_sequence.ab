import "./ldo_efuse_p4_sequence.ab"
// VO1,VO2,VO3,VO4 map to PMU ext_ldo indices0,3,1,4 (NOT channel-1).
fun esp32P4LdoControlOffset(channel: int): int {
    if (channel == 1) return 440
    if (channel == 2) return 464
    if (channel == 3) return 448
    if (channel == 4) return 472
    return -1
}
// Requires exclusive rail ownership and a cross-core PMU critical section.
// eFuse shadows already loaded. Refuses an active rail: no silent takeover,
// live voltage adjustment or reset of a possible flash/PSRAM/SD supply.
// revision is verified chip major*100+minor, NOT the register-layout number.
// 1 configured+readback,2 invalid,3 active/refused,4 readback failure (retain
// ownership; hardware may be on). Readback is NOT analog settling proof.
trusted fun esp32P4LdoStartOwned(channel: int,millivolts: int,revision: int): int {
    val offset=esp32P4LdoControlOffset(channel)
    if (offset < 0 || revision < 0 || revision > 399 ||
        (millivolts != 3300 && (millivolts < 500 || millivolts > 2700))) return 2
    val initial=p4LdoPmuRead(offset)
    if ((initial&u32(256)) != u32(0)) return 3
    if (channel == 1 && revision >= 100 && (p4LdoPmuRead(40)&u32(4194304)) != u32(0)) return 3
    val plan=esp32P4LdoReadVoltagePlanOwned(channel,millivolts)
    if (!plan.valid()) return 2
    // Bit6 is a write-trigger on newer silicon: never replay it in RMW.
    val control=(initial&u32(4294947263))|u32(128)|(if (plan.bypass()) u32(16384) else u32(0))
    p4LdoPmuWrite(offset,control)
    val analog=(p4LdoPmuRead(offset+4)&u32(142606335))|
        (u32(plan.dref())<<u32(28))|(u32(plan.multiplier())<<u32(23))|u32(67108864)
    p4LdoPmuWrite(offset+4,analog)
    if (channel == 1 && revision >= 100) {
        p4LdoPmuWrite(40,(p4LdoPmuRead(40)&u32(4287102975))|u32(4194304))
    }
    p4LdoPmuWrite(offset,control|u32(256))
    if ((p4LdoPmuRead(offset)&u32(20352)) != ((control|u32(256))&u32(20352)) ||
        (p4LdoPmuRead(offset+4)&u32(4152360960)) != (analog&u32(4152360960))) return 4
    if (channel == 1 && revision >= 100 && (p4LdoPmuRead(40)&u32(7864320)) != u32(4194304)) return 4
    return 1
}
// Only for a rail owned by the caller, with consumers shut down. Do not call
// following a refused start. No voltage/source ownership restoration guessed.
trusted fun esp32P4LdoStopOwned(channel: int,revision: int): int {
    val offset=esp32P4LdoControlOffset(channel)
    if (offset < 0 || revision < 0 || revision > 399) return 2
    if (channel == 1 && revision >= 100) p4LdoPmuWrite(40,p4LdoPmuRead(40)&u32(4287102975))
    p4LdoPmuWrite(offset,p4LdoPmuRead(offset)&u32(4294966975))
    if ((p4LdoPmuRead(offset)&u32(256)) != u32(0)) return 4
    if (channel == 1 && revision >= 100 && (p4LdoPmuRead(40)&u32(7864320)) != u32(0)) return 4
    return 1
}
