import "./sdk/raw_buffer.ab"
// Final post-drain operation under caller's cross-core scheduler lock, local
// INTLEVEL15 and live CP disabled. Caller owns disjoint current/next bindings,
// their CP records and both live stacks, plus current/owner tables. No queue
// mutation or unlock is performed here. Never call while IRQ dispatch continues.
// 1 committed: publish queue state, release lock WITHOUT unmasking, return to
// IRQ shell. 0 invalid; -1 detach refused (old binding remains current, saved
// CP may now be disabled); -2 next rejected and old restored; -3 selection
// rejected and old restored. -4 rollback failed: MUST take a fatal path, never
// return to interrupted task. Preserved CP snapshots permit lazy recovery.
@section(".iram1.abla.s3TaskSwitch")
trusted fun esp32S3TaskSwitchOwned(current: NativeBuffer,previous: NativeBuffer,next: NativeBuffer,owners: NativeBuffer,interrupted: NativeBuffer,resume: NativeBuffer,core: int,level: int): int {
    // Reject obviously invalid identity before any ownership mutation. Detailed
    // memory/header/core checks belong to detach, reattach and selector.
    if (core < 0 || core > 1 || level < 1 || level > 3 ||
        !previous.hasAddressRange(0,16) || !next.hasAddressRange(0,16) ||
        !interrupted.hasAddressRange(0,192) || !resume.hasAddressRange(0,192) ||
        (previous.addressValue() < next.addressValue()+16 && next.addressValue() < previous.addressValue()+16) ||
        (interrupted.addressValue() < resume.addressValue()+192 && resume.addressValue() < interrupted.addressValue()+192)) return 0
    if (!esp32S3TaskSwitchDetach(current,previous,owners,interrupted,core)) return -1
    if (!esp32S3TaskSwitchAttach(current,next,owners,resume,core)) {
        if (!esp32S3TaskSwitchAttach(current,previous,owners,interrupted,core)) return -4
        return -2
    }
    if (esp32S3TaskSwitchSelect(interrupted,resume,core,level)) return 1
    if (!esp32S3TaskSwitchDetach(current,next,owners,resume,core)) return -4
    if (!esp32S3TaskSwitchAttach(current,previous,owners,interrupted,core)) return -4
    return -3
}
