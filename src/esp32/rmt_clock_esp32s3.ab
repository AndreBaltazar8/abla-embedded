import "abla/unsafe/mmio"
import "./rcc_esp32s3.ab"
import "./rmt_clock_sequence_esp32s3.ab"
import "./rmt_tx_sequence_esp32s3.ab"
import "./rmt_memory_sequence_esp32s3.ab"
import "./rmt_transmit_sequence_esp32s3.ab"
trusted fun esp32s3RmtPublish(): void = atomicMemoryFence()
trusted fun esp32s3RmtRead(address: int): int = mmioLoadU32(address)
trusted fun esp32s3RmtWrite(address: int, value: int): void = mmioStoreU32(address, value)
trusted fun esp32s3RmtEnableBusClock(owner: u32): bool {
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    esp32s3RmtEnableBusClockLocked()
    atomicMemoryFence()
    esp32S3RccLeave(lock, owner, saved)
}
trusted fun esp32s3RmtConfigureClock(source: int, integer: int,
    numerator: int, denominator: int, owner: u32): bool {
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    val configured = esp32s3RmtConfigureClockLocked(source, integer, numerator, denominator)
    atomicMemoryFence()
    val released = esp32S3RccLeave(lock, owner, saved)
    configured && released
}

// Both functions require exclusive ownership of ALL stopped RMT channels.
// Disabling the shared clock is not a channel stop/recovery operation.
trusted fun esp32s3RmtSetGroupClockOwned(active: bool, owner: u32): bool {
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    val previous = esp32s3RmtRead(0x600160c0)
    esp32s3RmtWrite(0x600160c0, (previous & 0xfbffffff) | (if (active) 0x04000000 else 0))
    atomicMemoryFence()
    esp32S3RccLeave(lock, owner, saved)
}
trusted fun esp32s3RmtPrepareMemory(owner: u32): bool {
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    val prepared = esp32s3RmtPrepareMemoryLocked()
    atomicMemoryFence()
    val released = esp32S3RccLeave(lock, owner, saved)
    prepared && released
}
