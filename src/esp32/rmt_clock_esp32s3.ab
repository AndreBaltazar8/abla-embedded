import "abla/unsafe/mmio"
import "./rcc_esp32s3.ab"
import "./rmt_clock_sequence_esp32s3.ab"
import "./rmt_tx_sequence_esp32s3.ab"
import "./rmt_memory_sequence_esp32s3.ab"
import "./rmt_transmit_sequence_esp32s3.ab"
import "../hal/esp32.ab"
import "../hal/esp32_2.ab"
@export("esp32s3RmtPublish")
trusted fun esp32s3RmtPublishHook(): void = atomicMemoryFence()
@export("esp32s3RmtRead")
trusted fun esp32s3RmtReadHook(address: int): int = mmioLoadU32(address)
@export("esp32s3RmtWrite")
trusted fun esp32s3RmtWriteHook(address: int, value: int): void = mmioStoreU32(address, value)
@export("esp32s3RmtEnableBusClock")
trusted fun esp32s3RmtEnableBusClockHook(owner: u32): bool {
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    esp32s3RmtEnableBusClockLocked()
    atomicMemoryFence()
    esp32S3RccLeave(lock, owner, saved)
}
@export("esp32s3RmtConfigureClock")
trusted fun esp32s3RmtConfigureClockHook(source: int, integer: int,
    numerator: int, denominator: int, owner: u32): bool {
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    val configured = esp32s3RmtConfigureClockLocked(source, integer, numerator, denominator)
    atomicMemoryFence()
    val released = esp32S3RccLeave(lock, owner, saved)
    configured && released
}

// Both functions require exclusive ownership of ALL stopped RMT channels.
// Disabling the shared clock is not a channel stop/recovery operation.
@export("esp32s3RmtSetGroupClockOwned")
trusted fun esp32s3RmtSetGroupClockOwnedHook(active: bool, owner: u32): bool {
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    val previous = esp32s3RmtRead(0x600160c0)
    esp32s3RmtWrite(0x600160c0, (previous & 0xfbffffff) | (if (active) 0x04000000 else 0))
    atomicMemoryFence()
    esp32S3RccLeave(lock, owner, saved)
}
@export("esp32s3RmtPrepareMemory")
trusted fun esp32s3RmtPrepareMemoryHook(owner: u32): bool {
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    val prepared = esp32s3RmtPrepareMemoryLocked()
    atomicMemoryFence()
    val released = esp32S3RccLeave(lock, owner, saved)
    prepared && released
}
