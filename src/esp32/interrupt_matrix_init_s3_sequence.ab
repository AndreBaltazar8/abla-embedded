// Boot-time clear of all99 S3 peripheral sources, matching
// cpu_start.c core_intr_matrix_clear / ETS_MAX_INTR_SOURCE. Local core only.
// Caller owns the entire local interrupt matrix, with no installed live
// interrupt clients. This does not clear peripheral pending causes or install
// vectors/handlers. CPU INTENABLE must remain zero throughout the operation.
@section(".iram1.abla.s3InterruptMatrixInit")
trusted fun esp32S3InterruptMatrixInitOwned(core: int): bool {
    if (core < 0 || core > 1 || esp32S3MatrixInitCore() != core || esp32S3MatrixInitEnabled() != 0) return false
    val base=if (core == 0) 0x600C2000 else 0x600C2800
    var source=0
    while (source < 99) {
        val address=base+source*4
        // S3 IDF ETS_INVALID_INUM=6: CPU-internal timer line, not an
        // external level input. Retain all reserved register bits.
        esp32S3MatrixInitWrite(address,(esp32S3MatrixInitRead(address) & 0xFFFFFFE0) | 6)
        source=source+1
    }
    true
}
