import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTimerCoreInternals(): bool {
    if (!internalFunction("esp32RecoveredEspTimerCreate", "esp_timer_create")) return false
    if (!internalFunction("esp32RecoveredEspTimerRestart", "esp_timer_restart")) return false
    if (!internalFunction("esp32RecoveredEspTimerStartOnce", "esp_timer_start_once")) return false
    if (!internalFunction("esp32RecoveredEspTimerStartPeriodic", "esp_timer_start_periodic")) return false
    if (!internalFunction("esp32RecoveredEspTimerStop", "esp_timer_stop")) return false
    if (!internalFunction("esp32RecoveredEspTimerDelete", "esp_timer_delete")) return false
    if (!internalFunction("esp32RecoveredEspTimerInit", "esp_timer_init")) return false
    if (!internalFunction("esp32RecoveredEspTimerDeinit", "esp_timer_deinit")) return false
    if (!internalFunction("esp32RecoveredEspTimerDump", "esp_timer_dump")) return false
    if (!internalFunction("esp32RecoveredEspTimerGetNextAlarm", "esp_timer_get_next_alarm")) return false
    if (!internalFunction("esp32RecoveredEspTimerGetNextAlarmForWakeUp", "esp_timer_get_next_alarm_for_wake_up")) return false
    if (!internalFunction("esp32RecoveredEspTimerGetPeriod", "esp_timer_get_period")) return false
    if (!internalFunction("esp32RecoveredEspTimerGetExpiryTime", "esp_timer_get_expiry_time")) return false
    if (!internalFunction("esp32RecoveredEspTimerIsActive", "esp_timer_is_active")) return false
    true
}
