import "abla/unsafe/native"
import "../freertos/port_esp32.ab"

// Shared ESP timer state. These are real Abla module values so LLVM sees the
// lock and alarm timestamps in the same optimization unit as their users.
val esp32Data_s_time_update_lock_0e86f461dfStorage = nativeStaticMutableU32s([
    3007315967, 0
])
val esp32Data_s_time_update_lock_0e86f461df =
    u32(esp32Data_s_time_update_lock_0e86f461dfStorage)

val esp32Data_timestamp_id_265d089f1fStorage = nativeStaticMutableU32s([
    4294967295, 4294967295, 4294967295, 4294967295
])
val esp32Data_timestamp_id_265d089f1f =
    u32(esp32Data_timestamp_id_265d089f1fStorage)

trusted fun esp32TimerImplementationLock():void {
    esp32RecoveredXPortEnterCriticalTimeout(
        esp32Data_s_time_update_lock_0e86f461df, u32(0xffffffff)
    )
    return
}

trusted fun esp32TimerImplementationUnlock():void {
    esp32RecoveredVPortExitCriticalValue(esp32Data_s_time_update_lock_0e86f461df)
    return
}

@section(".iram1.abla.esp32TimerImplementationSetAlarm")
trusted fun esp32TimerImplementationSetAlarm(timestamp:u64):void {
    esp32RecoveredEspTimerImplSetAlarmId(
        u32(timestamp), u32(timestamp >>> u64(32)), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

@section(".iram1.1.abla.esp32TimerImplementationGetMinPeriodUs")
trusted fun esp32TimerImplementationGetMinPeriodUs():u64 = u64(50)

trusted fun esp32TimerPrivateLock():void = esp32TimerImplementationLock()
trusted fun esp32TimerPrivateUnlock():void = esp32TimerImplementationUnlock()

// Temporary register-shaped adapters used by still-lifted timer/power callers.
trusted fun esp32RecoveredEspTimerImplGetMinPeriodUs(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = u32(esp32TimerImplementationGetMinPeriodUs())

trusted fun esp32RecoveredEspTimerPrivateLock(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    esp32TimerPrivateLock()
    a2
}

trusted fun esp32RecoveredEspTimerPrivateUnlock(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    esp32TimerPrivateUnlock()
    a2
}
