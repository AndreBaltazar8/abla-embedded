import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTimerInitInternals(): bool {
    if (!internalFunction("esp32RecoveredEspTimerEarlyInit", "esp_timer_early_init")) return false
    if (!internalFunction("esp32RecoveredEspTimerInitIncludeFunc", "esp_timer_init_include_func")) return false
    true
}
