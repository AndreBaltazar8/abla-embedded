import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTimerLacInternals(): bool {
    if (!internalFunction("esp32TimerCounterTicks", "esp_timer_impl_get_counter_reg")) return false
    if (!internalFunction("esp32TimerTimeMicroseconds", "esp_timer_get_time")) return false
    if (!internalFunction("esp32RecoveredEspTimerImplSetAlarmId", "esp_timer_impl_set_alarm_id")) return false
    if (!internalFunction("esp32RecoveredEspTimerImplSet", "esp_timer_impl_set")) return false
    if (!internalFunction("esp32RecoveredEspTimerImplAdvance", "esp_timer_impl_advance")) return false
    if (!internalFunction("esp32RecoveredEspTimerImplEarlyInit", "esp_timer_impl_early_init")) return false
    if (!internalFunction("esp32RecoveredEspTimerImplInit", "esp_timer_impl_init")) return false
    if (!internalFunction("esp32RecoveredEspTimerImplDeinit", "esp_timer_impl_deinit")) return false
    if (!internalFunction("esp32RecoveredEspTimerImplGetAlarmReg", "esp_timer_impl_get_alarm_reg")) return false
    if (!internalFunction("esp32TimerTimeMicroseconds", "esp_timer_impl_get_time")) return false
    if (!internalFunction("esp32RecoveredEspTimerPrivateSet", "esp_timer_private_set")) return false
    if (!internalFunction("esp32RecoveredEspTimerPrivateAdvance", "esp_timer_private_advance")) return false
    true
}
