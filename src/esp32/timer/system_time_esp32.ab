import "../clock/runtime_esp32.ab"
import "../system/startup_esp32.ab"
import "../system/restart_esp32.ab"
import "../runtime/libc_time_implementation_esp32.ab"
import "../log/core_esp32.ab"
import "lac_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"

var esp32SystemTimeCorrectionMicroseconds = u64(0)

@inline
trusted fun esp32SystemTimeLoadU64(address:u32):u64 {
    val low = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))
    val high = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(address + u32(4)))))
    (u64(high) << u64(32)) | u64(low)
}

trusted fun esp32TimerInitializeSystemTime():void {
    val rtcTime = esp32RtcTimeMicroseconds()
    val startupTime = esp32SystemTimeLoadU64(esp32Data_g_startup_time_4759b0e698)
    esp32SystemTimeCorrectionMicroseconds =
        rtcTime - startupTime - esp32TimerTimeMicroseconds()

    val status = esp32RegisterShutdownHandler(
        u32(nativeFunctionAddress(esp32SyncTimekeepingTimers)))
    if (status != u32(0)) {
        esp32Log(u32(2),u32(nativeCStringAddress("system_time")),
            u32(nativeCStringAddress("Register shutdown handler failed, err = 0x%x")),
            status,u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    }
}

@section(".iram1.0.abla.esp32SystemGetTime")
trusted fun esp32SystemGetTime():u64 =
    esp32TimerTimeMicroseconds() + esp32SystemTimeCorrectionMicroseconds

@section(".iram1.abla.esp32SystemGetTimeResolution")
trusted fun esp32SystemGetTimeResolution():u32 = u32(1000)

trusted fun esp32RecoveredEspTimerImplInitSystemTime(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32TimerInitializeSystemTime(); a2 }

trusted fun esp32RecoveredEspSystemGetTime(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = u32(esp32SystemGetTime())

trusted fun esp32RecoveredEspSystemGetTimeResolution(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32SystemGetTimeResolution()
