import "./system_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_timer.ab"
// SYSTIMER base500e2000 and counter/alarm offsets identical on both layouts.
@export("p4SystemTimerRead")
trusted fun p4SystemTimerReadHook(offset: int): int = mmioLoadU32(0x500e2000+offset)
@export("p4SystemTimerWrite")
trusted fun p4SystemTimerWriteHook(offset: int,value: int): void { mmioStoreU32(0x500e2000+offset,value); return }
