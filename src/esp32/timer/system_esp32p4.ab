import "./system_p4_sequence.ab"
import "abla/unsafe/mmio"
// SYSTIMER base500e2000 and counter/alarm offsets identical on both layouts.
trusted fun p4SystemTimerRead(offset: int): int = mmioLoadU32(0x500e2000+offset)
trusted fun p4SystemTimerWrite(offset: int,value: int): void { mmioStoreU32(0x500e2000+offset,value); return }
