import "./clock_p4_sequence.ab"
import "./system_esp32p4.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_timer.ab"
@export("p4SystemTimerClockRead")
trusted fun p4SystemTimerClockReadHook(offset: int): int = mmioLoadU32(0x500e6000+offset)
@export("p4SystemTimerClockWrite")
trusted fun p4SystemTimerClockWriteHook(offset: int,value: int): void { mmioStoreU32(0x500e6000+offset,value); return }
