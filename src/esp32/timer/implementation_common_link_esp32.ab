import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTimerImplementationCommonInternals(): bool {
    if (!internalFunction("esp32TimerImplementationLock", "esp_timer_impl_lock")) return false
    if (!internalFunction("esp32TimerImplementationUnlock", "esp_timer_impl_unlock")) return false
    if (!internalFunction("esp32TimerImplementationSetAlarm", "esp_timer_impl_set_alarm")) return false
    if (!internalFunction("esp32TimerImplementationGetMinPeriodUs", "esp_timer_impl_get_min_period_us")) return false
    if (!internalFunction("esp32TimerPrivateLock", "esp_timer_private_lock")) return false
    if (!internalFunction("esp32TimerPrivateUnlock", "esp_timer_private_unlock")) return false
    true
}
