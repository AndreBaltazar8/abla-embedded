import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSystemTimeInternals(): bool {
    if (!internalFunction("esp32TimerInitializeSystemTime", "esp_timer_impl_init_system_time")) return false
    if (!internalFunction("esp32SystemGetTime", "esp_system_get_time")) return false
    if (!internalFunction("esp32SystemGetTimeResolution", "esp_system_get_time_resolution")) return false
    true
}
