import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLegacyEtsTimerInternals(): bool {
    if (!internalFunction("esp32RecoveredEtsTimerSetfn", "ets_timer_setfn")) return false
    if (!internalFunction("esp32RecoveredEtsTimerArmUs", "ets_timer_arm_us")) return false
    if (!internalFunction("esp32RecoveredEtsTimerArm", "ets_timer_arm")) return false
    if (!internalFunction("esp32RecoveredEtsTimerDone", "ets_timer_done")) return false
    if (!internalFunction("esp32RecoveredEtsTimerDisarm", "ets_timer_disarm")) return false
    if (!internalFunction("esp32RecoveredEtsTimerInit", "ets_timer_init")) return false
    if (!internalFunction("esp32RecoveredEtsTimerDeinit", "ets_timer_deinit")) return false
    if (!internalFunction("esp32RecoveredOsTimerSetfn", "os_timer_setfn")) return false
    if (!internalFunction("esp32RecoveredOsTimerArmUs", "os_timer_arm_us")) return false
    if (!internalFunction("esp32RecoveredOsTimerArm", "os_timer_arm")) return false
    if (!internalFunction("esp32RecoveredOsTimerDone", "os_timer_done")) return false
    if (!internalFunction("esp32RecoveredOsTimerDisarm", "os_timer_disarm")) return false
    true
}
