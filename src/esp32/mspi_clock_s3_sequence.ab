import "../runtime/unsigned_division64.ab"

@section(".iram1.abla.s3MspiCoreSelector")
fun esp32S3MspiCoreSelector(megahertz: int): int =
    if (megahertz == 80) 0 else if (megahertz == 120) 1 else if (megahertz == 160) 2 else if (megahertz == 240) 3 else -1

// Exact SPI_MEM_CLOCK/SRAM_CLK encoding; -1 denotes invalid divider.
@section(".iram1.abla.s3MspiDividerBits")
fun esp32S3MspiDividerBits(divider: int): int {
    if (divider < 1 || divider > 256) return -1
    if (divider == 1) return 0x80000000
    ((divider-1)<<16) | (((divider>>>1)-1)<<8) | (divider-1)
}

@section(".iram1.abla.s3MspiFrequencyBits")
fun esp32S3MspiFrequencyBits(coreMHz: int,targetMHz: int): int {
    if (esp32S3MspiCoreSelector(coreMHz) < 0 || targetMHz <= 0 || targetMHz > coreMHz) return -1
    val divider=int(unsignedDivide64(u64(coreMHz),u64(targetMHz)))
    if (divider*targetMHz != coreMHz) return -1
    esp32S3MspiDividerBits(divider)
}

// Only the clock phase of mspi_timing_config. Caller freezes caches, owns both
// cores/interrupts/MSPI/flash operations, executes from internal memory, and
// applies the matching flash/PSRAM mode, dummy and delay tuning before unfreeze.
// psramMHz=0 leaves PSRAM clock untouched. SPI0/1 share the core-clock selector;
// controlSpi1=false preserves SPI1's command clock, as IDF sleep entry does.
@section(".iram1.abla.s3MspiClocks")
trusted fun esp32S3MspiClocksOwned(coreMHz: int,flashMHz: int,psramMHz: int,controlSpi1: bool): bool {
    val selector=esp32S3MspiCoreSelector(coreMHz)
    val flash=esp32S3MspiFrequencyBits(coreMHz,flashMHz)
    val psram=if (psramMHz == 0) 0 else esp32S3MspiFrequencyBits(coreMHz,psramMHz)
    if (selector < 0 || flash < 0 || psram < 0) return false
    esp32S3MspiClockUpdate(0x600030EC,3,selector)
    esp32S3MspiClockWrite(0x60003014,flash)
    if (controlSpi1) esp32S3MspiClockWrite(0x60002014,flash)
    if (psramMHz != 0) esp32S3MspiClockWrite(0x60003050,psram)
    true
}
