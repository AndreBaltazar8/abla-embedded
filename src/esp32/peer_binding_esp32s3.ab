import "./peer_binding_s3_sequence.ab"
import "./peer_handler_esp32s3.ab"
// Serialize the INTENABLE read/modify/write against local maskable IRQs.
// Only the owned line changes; original PS level is restored exactly.
trusted fun esp32S3PeerBindingEnable(line: int,enabled: bool): bool {
    val guard=xtensaInterruptGuardEnter()
    val before=esp32S3InterruptInstallEnabled()
    val after=if (enabled) before|(1<<line) else before&(~(1<<line))
    xtensaGuardWrite("wsr.intenable $0\nrsync","a,~{memory}",u32(after))
    val matched=esp32S3InterruptInstallEnabled() == after
    val restored=xtensaInterruptGuardLeave(guard)
    return matched && restored
}
