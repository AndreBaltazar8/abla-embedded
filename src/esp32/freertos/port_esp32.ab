// Original ABI symbol: xPortStartScheduler
// Everything that has ordinary scalar semantics is typed Abla. Only the final
// CALL0 handoff, which replaces A1 and never returns to this window, remains a
// validated Xtensa target operation.
@section(".iram1.abla.freertos.port_start_scheduler")
trusted fun esp32RecoveredXPortStartScheduler(): u32 {
    val ignoredPreviousProcessorState = xtensaRaiseInterruptLevel3()
    esp32RecoveredXtCoprocInit()
    esp32RecoveredVPortSetupTimer()

    val core = cpuCoreId()
    val coreOffset = core << u32(2)
    val schedulerRunning =
        esp32Data_port_xSchedulerRunning_2618692451 + coreOffset
    val coreStartupDone =
        esp32Data_port_uxCoreStartupDone_cd9c7f39be + coreOffset
    xtensaMemoryBarrier()
    ablaUnsafeVolatileStoreU32(int(schedulerRunning), 1)
    xtensaMemoryBarrier()
    ablaUnsafeVolatileStoreU32(int(coreStartupDone), 0)

    ownedXtensaWindowSpill()
    $xtensa startDispatcher {_frxt_dispatch}
    return u32(1)
}

