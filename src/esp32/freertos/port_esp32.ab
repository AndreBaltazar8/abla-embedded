// FreeRTOS task-frame creation is data layout, not an ISA operation. Keeping
// it typed exposes all alignment, TLS sizing, copies, zeroing, and frame stores
// to the monolithic LLVM optimization graph. Linker-script boundaries use the
// target-neutral linker-layout module rather than target assembly syntax.
trusted fun esp32RecoveredPxPortInitialiseStack(
    pxTopOfStack: u32,
    pxCode: u32,
    pvParameters: u32
): u32 {
    esp32FreertosAssertInitialStackAligned(pxTopOfStack)

    // Reserve and initialize the coprocessor save area (XT_CP_SIZE = 96).
    var stack = esp32FreertosAlignDown(pxTopOfStack - u32(96), u32(16))
    esp32FreertosStackStoreU32(stack, u32(0))
    esp32FreertosStackStoreU32(stack + u32(4), u32(0))
    esp32FreertosStackStoreU32(
        stack + u32(8),
        esp32FreertosAlignUp(stack + u32(12), u32(4))
    )

    // Place this task's initialized TLS data and zeroed TLS BSS below CPSA.
    val tlsDataStart = esp32LinkerThreadLocalDataStart
    val tlsDataEnd = esp32LinkerThreadLocalDataEnd
    val tlsBssStart = esp32LinkerThreadLocalBssStart
    val tlsBssEnd = esp32LinkerThreadLocalBssEnd
    val tlsDataSize = tlsDataEnd - tlsDataStart
    val tlsBssSize = tlsBssEnd - tlsBssStart
    val tlsAreaSize = esp32FreertosAlignUp(
        tlsDataSize + tlsBssSize,
        u32(16)
    )
    stack = esp32FreertosAlignDown(stack - tlsAreaSize, u32(16))
    ablaUnsafeCopyMemory(int(stack), int(tlsDataStart), int(tlsDataSize))
    ablaUnsafeSetMemory(
        nativePointerFromAddress(int(stack + tlsDataSize)),
        0,
        int(tlsBssSize)
    )

    val tlsAlignment = esp32LinkerThreadLocalAlignment
    val threadPointerOffset =
        (tlsAlignment + u32(7)) & (u32(0) - tlsAlignment)
    val initialThreadPointer = stack - threadPointerOffset

    // Build the 192-byte Xtensa exception frame expected by _frxt_dispatch.
    val frame = esp32FreertosAlignDown(stack - u32(192), u32(16))
    ablaUnsafeSetMemory(
        nativePointerFromAddress(int(frame)),
        0,
        int(stack - frame)
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(frame)),
        int(u32(nativeFunctionAddress(esp32RecoveredXtUserExit)))
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(frame + u32(4))),
        int(u32(nativeFunctionAddress(esp32FreertosPortTaskWrapper)))
    )
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame + u32(8))), 327728)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame + u32(12))), 0)
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(frame + u32(16))),
        int(frame + u32(192))
    )
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame + u32(36))), int(pxCode))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame + u32(40))), int(pvParameters))
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(frame + u32(112))),
        int(initialThreadPointer)
    )
    return frame
}

