// The task entry itself is a dynamic function pointer, but its invocation and
// all wrapper control flow remain visible LLVM IR. The fixed-arity unsafe call
// expresses the Xtensa C ABI without hiding it in an instruction string.
trusted fun esp32FreertosPortTaskWrapper(
    taskFunction: u32,
    taskParameter: u32
): void {
    ablaUnsafeCallVoidI32(int(taskFunction), int(taskParameter))

    val taskName = u32(ablaUnsafeCallI32Pointer(
        int(u32(nativeFunctionAddress(esp32RecoveredPcTaskGetName))),
        nativeNullPointer()
    ))
    val timestamp = ablaUnsafeCallI32(
        int(u32(nativeFunctionAddress(esp32RecoveredEspLogTimestamp)))
    )
    val tag = esp32Data_Labla_recovered_Esp32FreertosPort_data_rodata_vPortTaskWrapper_str1_4_b62978fc74
    val format = tag + u32(12)
    ablaUnsafeCallVoidI32I32I32I32I32I32(
        int(u32(nativeFunctionAddress(esp32RecoveredEspLog))),
        1,
        int(tag),
        int(format),
        timestamp,
        int(tag),
        int(taskName)
    )
    freestandingAbort()
}

// CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS is two and IDF reserves half
// for deletion callbacks, so this build has exactly one callback slot. Keeping
// that configuration fact in typed Abla lets LLVM completely remove the loop.
trusted fun esp32FreertosPortTlsPointersDelete(tcb: u32): void {
    val callback = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(tcb + u32(88)))))
    if (callback == u32(0)) return

    if (esp32RecoveredEspPtrExecutable(callback) == u32(0)) {
        val logLevel = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(esp32Data_esp_log_default_level_865ba35f32))))
        if (logLevel != u32(0)) {
            val timestamp = ablaUnsafeCallI32(
                int(u32(nativeFunctionAddress(esp32RecoveredEspLogTimestamp)))
            )
            val tag = esp32Data_Labla_recovered_Esp32FreertosPort_data_rodata_vPortTaskWrapper_str1_4_b62978fc74
            val format = esp32Data_Labla_recovered_Esp32FreertosPort_data_rodata_vPortTLSPointersDelCb_str1_4_c3cbd01361
            ablaUnsafeCallVoidI32I32I32I32I32(
                int(u32(nativeFunctionAddress(esp32RomPrintfArguments))),
                int(format),
                timestamp,
                int(tag),
                0,
                int(callback)
            )
        }
        freestandingAbort()
    }

    val pointer = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(tcb + u32(84)))))
    ablaUnsafeCallVoidI32I32(int(callback), 0, int(pointer))
    return
}

