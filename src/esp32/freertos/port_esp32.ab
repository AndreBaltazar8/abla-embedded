@inline
trusted fun esp32FreertosAlignDown(value: u32, alignment: u32): u32 =
    value & (u32(0) - alignment)

@inline
trusted fun esp32FreertosAlignUp(value: u32, alignment: u32): u32 =
    esp32FreertosAlignDown(value + alignment - u32(1), alignment)

