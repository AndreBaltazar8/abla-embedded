import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosPortCommonInternals(): bool {
    if (!internalFunction("esp32RecoveredVApplicationGetIdleTaskMemory", "vApplicationGetIdleTaskMemory")) return false
    if (!internalFunction("esp32RecoveredVApplicationGetTimerTaskMemory", "vApplicationGetTimerTaskMemory")) return false
    true
}
