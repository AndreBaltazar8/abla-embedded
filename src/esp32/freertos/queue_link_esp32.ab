import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosQueueInternals(): bool {
    if (!internalFunction("esp32RecoveredXQueueGenericReset", "xQueueGenericReset")) return false
    if (!internalFunction("esp32RecoveredXQueueGenericCreateStatic", "xQueueGenericCreateStatic")) return false
    if (!internalFunction("esp32RecoveredXQueueGenericGetStaticBuffers", "xQueueGenericGetStaticBuffers")) return false
    if (!internalFunction("esp32RecoveredXQueueGenericCreate", "xQueueGenericCreate")) return false
    if (!internalFunction("esp32RecoveredXQueueGetMutexHolder", "xQueueGetMutexHolder")) return false
    if (!internalFunction("esp32RecoveredXQueueGetMutexHolderFromISR", "xQueueGetMutexHolderFromISR")) return false
    if (!internalFunction("esp32RecoveredXQueueCreateCountingSemaphoreStatic", "xQueueCreateCountingSemaphoreStatic")) return false
    if (!internalFunction("esp32RecoveredXQueueCreateCountingSemaphore", "xQueueCreateCountingSemaphore")) return false
    if (!internalFunction("esp32RecoveredXQueueGenericSend", "xQueueGenericSend")) return false
    if (!internalFunction("esp32RecoveredXQueueCreateMutex", "xQueueCreateMutex")) return false
    if (!internalFunction("esp32RecoveredXQueueCreateMutexStatic", "xQueueCreateMutexStatic")) return false
    if (!internalFunction("esp32RecoveredXQueueGiveMutexRecursive", "xQueueGiveMutexRecursive")) return false
    if (!internalFunction("esp32RecoveredXQueueGenericSendFromISR", "xQueueGenericSendFromISR")) return false
    if (!internalFunction("esp32RecoveredXQueueGiveFromISR", "xQueueGiveFromISR")) return false
    if (!internalFunction("esp32RecoveredXQueueReceive", "xQueueReceive")) return false
    if (!internalFunction("esp32RecoveredXQueueSemaphoreTake", "xQueueSemaphoreTake")) return false
    if (!internalFunction("esp32RecoveredXQueueTakeMutexRecursive", "xQueueTakeMutexRecursive")) return false
    if (!internalFunction("esp32RecoveredXQueuePeek", "xQueuePeek")) return false
    if (!internalFunction("esp32RecoveredXQueueReceiveFromISR", "xQueueReceiveFromISR")) return false
    if (!internalFunction("esp32RecoveredXQueuePeekFromISR", "xQueuePeekFromISR")) return false
    if (!internalFunction("esp32RecoveredUxQueueMessagesWaiting", "uxQueueMessagesWaiting")) return false
    if (!internalFunction("esp32RecoveredUxQueueSpacesAvailable", "uxQueueSpacesAvailable")) return false
    if (!internalFunction("esp32RecoveredUxQueueMessagesWaitingFromISR", "uxQueueMessagesWaitingFromISR")) return false
    if (!internalFunction("esp32RecoveredVQueueDelete", "vQueueDelete")) return false
    if (!internalFunction("esp32RecoveredXQueueIsQueueEmptyFromISR", "xQueueIsQueueEmptyFromISR")) return false
    if (!internalFunction("esp32RecoveredXQueueIsQueueFullFromISR", "xQueueIsQueueFullFromISR")) return false
    if (!internalFunction("esp32RecoveredVQueueWaitForMessageRestricted", "vQueueWaitForMessageRestricted")) return false
    if (!internalFunction("esp32RecoveredXQueueCreateSet", "xQueueCreateSet")) return false
    if (!internalFunction("esp32RecoveredXQueueAddToSet", "xQueueAddToSet")) return false
    if (!internalFunction("esp32RecoveredXQueueRemoveFromSet", "xQueueRemoveFromSet")) return false
    if (!internalFunction("esp32RecoveredXQueueSelectFromSet", "xQueueSelectFromSet")) return false
    if (!internalFunction("esp32RecoveredXQueueSelectFromSetFromISR", "xQueueSelectFromSetFromISR")) return false
    true
}
