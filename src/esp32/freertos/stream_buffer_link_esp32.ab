import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosStreamBufferInternals(): bool {
    if (!internalFunction("esp32RecoveredXStreamBufferGenericCreate", "xStreamBufferGenericCreate")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferGenericCreateStatic", "xStreamBufferGenericCreateStatic")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferGetStaticBuffers", "xStreamBufferGetStaticBuffers")) return false
    if (!internalFunction("esp32RecoveredVStreamBufferDelete", "vStreamBufferDelete")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferReset", "xStreamBufferReset")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferSetTriggerLevel", "xStreamBufferSetTriggerLevel")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferSpacesAvailable", "xStreamBufferSpacesAvailable")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferBytesAvailable", "xStreamBufferBytesAvailable")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferSend", "xStreamBufferSend")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferSendFromISR", "xStreamBufferSendFromISR")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferReceive", "xStreamBufferReceive")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferNextMessageLengthBytes", "xStreamBufferNextMessageLengthBytes")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferReceiveFromISR", "xStreamBufferReceiveFromISR")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferIsEmpty", "xStreamBufferIsEmpty")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferIsFull", "xStreamBufferIsFull")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferSendCompletedFromISR", "xStreamBufferSendCompletedFromISR")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferReceiveCompletedFromISR", "xStreamBufferReceiveCompletedFromISR")) return false
    true
}
