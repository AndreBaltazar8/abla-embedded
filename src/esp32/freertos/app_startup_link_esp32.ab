import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosAppStartupInternals(): bool {
    if (!internalFunction("esp32StartApplication", "esp_startup_start_app")) return false
    if (!internalFunction("esp32StartApplicationOtherCore", "esp_startup_start_app_other_cores")) return false
    true
}
