import "abla/unsafe/memory"

@inline
trusted fun esp32FreertosListLoad(address: u32): u32 = u32(
    ablaUnsafeVolatileLoadU32(int(address))
)

@inline
trusted fun esp32FreertosListStore(
    address: u32,
    value: u32
): void = ablaUnsafeVolatileStoreU32(
    int(address), int(value)
)

@inline
trusted fun esp32FreertosListInitialise(list: u32): void {
    val end = list + u32(8)
    esp32FreertosListStore(list, u32(0))
    esp32FreertosListStore(list + u32(4), end)
    esp32FreertosListStore(end, u32(4294967295))
    esp32FreertosListStore(end + u32(4), end)
    esp32FreertosListStore(end + u32(8), end)
    return
}

trusted fun esp32RecoveredVListInitialise(
    list: u32,
    a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32FreertosListInitialise(list)
    list
}

@inline
trusted fun esp32FreertosListInitialiseItem(item: u32): void {
    esp32FreertosListStore(item + u32(16), u32(0))
    return
}

trusted fun esp32RecoveredVListInitialiseItem(
    item: u32,
    a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32FreertosListInitialiseItem(item)
    item
}

@inline
@section(".iram1.abla.freertos.list_insert_end")
trusted fun esp32FreertosListInsertEnd(list: u32, item: u32): void {
    val index = esp32FreertosListLoad(list + u32(4))
    val previous = esp32FreertosListLoad(index + u32(8))
    esp32FreertosListStore(item + u32(4), index)
    esp32FreertosListStore(item + u32(8), previous)
    esp32FreertosListStore(previous + u32(4), item)
    esp32FreertosListStore(index + u32(8), item)
    esp32FreertosListStore(item + u32(16), list)
    esp32FreertosListStore(
        list, esp32FreertosListLoad(list) + u32(1)
    )
    return
}

trusted fun esp32RecoveredVListInsertEnd(
    list: u32,
    item: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32FreertosListInsertEnd(list, item)
    list
}

trusted fun esp32RecoveredVListInsert(
    list: u32,
    item: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    val itemValue = esp32FreertosListLoad(item)
    var iterator = if (itemValue == u32(4294967295))
        esp32FreertosListLoad(list + u32(16))
    else list + u32(8)
    if (itemValue != u32(4294967295)) {
        var next = esp32FreertosListLoad(iterator + u32(4))
        while (itemValue >= esp32FreertosListLoad(next)) {
            iterator = next
            next = esp32FreertosListLoad(iterator + u32(4))
        }
    }
    val next = esp32FreertosListLoad(iterator + u32(4))
    esp32FreertosListStore(item + u32(4), next)
    esp32FreertosListStore(item + u32(8), iterator)
    esp32FreertosListStore(next + u32(8), item)
    esp32FreertosListStore(iterator + u32(4), item)
    esp32FreertosListStore(item + u32(16), list)
    esp32FreertosListStore(
        list, esp32FreertosListLoad(list) + u32(1)
    )
    list
}

@section(".iram1.abla.freertos.list_remove")
trusted fun esp32RecoveredUxListRemove(
    item: u32,
    a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    val list = esp32FreertosListLoad(item + u32(16))
    val next = esp32FreertosListLoad(item + u32(4))
    val previous = esp32FreertosListLoad(item + u32(8))
    esp32FreertosListStore(previous + u32(4), next)
    esp32FreertosListStore(next + u32(8), previous)
    if (esp32FreertosListLoad(list + u32(4)) == item) {
        esp32FreertosListStore(list + u32(4), previous)
    }
    esp32FreertosListStore(item + u32(16), u32(0))
    val remaining = esp32FreertosListLoad(list) - u32(1)
    esp32FreertosListStore(list, remaining)
    remaining
}
