import "abla/build"

// Exact names used by recovered assembly and mixed callers. Keep internal
// linkage unless an ESP-IDF object has a real undefined reference to the ABI
// name. Those eleven foreign roots replace port.c; the remaining five names
// stay module-private and can still be pruned.
compile fun esp32Idf6LinkFreertosPortInternals(): bool {
    if (!internalFunction(
        "esp32FreertosPortTaskWrapper",
        "abla_esp32_freertos_port_task_wrapper"
    )) return false
    if (!exportFunction("esp32RecoveredXPortStartScheduler", "xPortStartScheduler")) return false
    if (!exportFunction("esp32RecoveredVPortEndScheduler", "vPortEndScheduler")) return false
    if (!exportFunction("esp32RecoveredPxPortInitialiseStack", "pxPortInitialiseStack")) return false
    if (!exportFunction("esp32RecoveredXPortInIsrContext", "xPortInIsrContext")) return false
    if (!exportFunction("esp32RecoveredVPortAssertIfInISR", "vPortAssertIfInISR")) return false
    if (!exportFunction("esp32RecoveredXPortInterruptedFromISRContext", "xPortInterruptedFromISRContext")) return false
    if (!exportFunction("esp32RecoveredXPortEnterCriticalTimeout", "xPortEnterCriticalTimeout")) return false
    if (!exportFunction("esp32RecoveredVPortExitCritical", "vPortExitCritical")) return false
    if (!internalFunction("esp32RecoveredXPortEnterCriticalTimeoutCompliance", "xPortEnterCriticalTimeoutCompliance")) return false
    if (!internalFunction("esp32RecoveredVPortExitCriticalCompliance", "vPortExitCriticalCompliance")) return false
    if (!exportFunction("esp32RecoveredVPortYieldOtherCore", "vPortYieldOtherCore")) return false
    if (!exportFunction("esp32RecoveredVApplicationStackOverflowHook", "vApplicationStackOverflowHook")) return false
    if (!internalFunction("esp32RecoveredXPortGetTickRateHz", "xPortGetTickRateHz")) return false
    if (!internalFunction("esp32RecoveredVPortSetStackWatchpoint", "vPortSetStackWatchpoint")) return false
    if (!exportFunction("esp32RecoveredVPortTCBPreDeleteHook", "vPortTCBPreDeleteHook")) return false
    true
}
