import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosListInternals(): bool {
    if (!internalFunction("esp32RecoveredVListInitialise", "vListInitialise")) return false
    if (!internalFunction("esp32RecoveredVListInitialiseItem", "vListInitialiseItem")) return false
    if (!internalFunction("esp32RecoveredVListInsertEnd", "vListInsertEnd")) return false
    if (!internalFunction("esp32RecoveredVListInsert", "vListInsert")) return false
    if (!internalFunction("esp32RecoveredUxListRemove", "uxListRemove")) return false
    true
}
