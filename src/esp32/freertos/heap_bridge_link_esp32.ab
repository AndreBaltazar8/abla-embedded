import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosHeapBridgeInternals(): bool {
    if (!internalFunction("esp32RecoveredPvPortMalloc", "pvPortMalloc")) return false
    if (!internalFunction("esp32RecoveredVPortFree", "vPortFree")) return false
    if (!internalFunction("esp32RecoveredXPortGetFreeHeapSize", "xPortGetFreeHeapSize")) return false
    if (!internalFunction("esp32RecoveredXPortGetMinimumEverFreeHeapSize", "xPortGetMinimumEverFreeHeapSize")) return false
    if (!internalFunction("esp32RecoveredXPortCheckValidListMem", "xPortCheckValidListMem")) return false
    if (!internalFunction("esp32RecoveredXPortCheckValidTCBMem", "xPortCheckValidTCBMem")) return false
    if (!internalFunction("esp32RecoveredXPortcheckValidStackMem", "xPortcheckValidStackMem")) return false
    true
}
