import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosIdfAdditionsInternals(): bool {
    if (!internalFunction("esp32RecoveredXTaskCreatePinnedToCoreWithCaps", "xTaskCreatePinnedToCoreWithCaps")) return false
    if (!internalFunction("esp32RecoveredVTaskDeleteWithCaps", "vTaskDeleteWithCaps")) return false
    if (!internalFunction("esp32RecoveredXQueueCreateWithCaps", "xQueueCreateWithCaps")) return false
    if (!internalFunction("esp32RecoveredVQueueDeleteWithCaps", "vQueueDeleteWithCaps")) return false
    if (!internalFunction("esp32RecoveredXSemaphoreCreateGenericWithCaps", "xSemaphoreCreateGenericWithCaps")) return false
    if (!internalFunction("esp32RecoveredVSemaphoreDeleteWithCaps", "vSemaphoreDeleteWithCaps")) return false
    if (!internalFunction("esp32RecoveredXStreamBufferGenericCreateWithCaps", "xStreamBufferGenericCreateWithCaps")) return false
    if (!internalFunction("esp32RecoveredVStreamBufferGenericDeleteWithCaps", "vStreamBufferGenericDeleteWithCaps")) return false
    true
}
