import "../../runtime/freestanding_integer.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
// Abla/LLVM implementation of statically allocated FreeRTOS idle-task and timer-task memory provisioning.

trusted fun esp32FreertosProvideTaskMemory(
    tcbOutput: u32,
    stackOutput: u32,
    stackSizeOutput: u32,
    stackSize: u32
): u32 {
    val stack = esp32RecoveredPvPortMalloc(
        stackSize,
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    val tcb = esp32RecoveredPvPortMalloc(
        u32(100),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    if (stack == u32(0) || tcb == u32(0)) freestandingAbortValue()
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(tcbOutput)), int(tcb)
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(stackOutput)), int(stack)
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(stackSizeOutput)), int(stackSize)
    )
    return tcbOutput
}

// Original ABI symbol: vApplicationGetIdleTaskMemory
trusted fun esp32RecoveredVApplicationGetIdleTaskMemory(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 =
    esp32FreertosProvideTaskMemory(a2, a3, a4, u32(1536))

// Original ABI symbol: vApplicationGetTimerTaskMemory
trusted fun esp32RecoveredVApplicationGetTimerTaskMemory(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 =
    esp32FreertosProvideTaskMemory(a2, a3, a4, u32(2048))
