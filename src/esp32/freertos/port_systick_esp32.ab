import "./port_assembly_esp32.ab"
import "./xtensa_init_esp32.ab"

// Abla/LLVM implementation of ESP32 FreeRTOS tick-timer setup.

// Original ABI symbol: vPortSetupTimer
// Both callees are already part of the same Abla module. Keeping this as an
// ordinary typed call chain lets LLVM inline or prune the façade completely.
@section(".iram1.abla.freertos.port_setup_timer")
trusted fun esp32RecoveredVPortSetupTimer(): void {
    esp32RecoveredXtTickDivisorInit()
    esp32RecoveredFrxtTickTimerInit()
}
