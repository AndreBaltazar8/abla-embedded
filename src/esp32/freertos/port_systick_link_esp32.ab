import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosPortSystickInternals(): bool {
    // port.c calls this setup root after the superseded port_systick.c is
    // removed. The tick handler is called directly from typed Abla timer code.
    if (!internalFunction("esp32RecoveredVPortSetupTimer", "vPortSetupTimer")) return false
    true
}
