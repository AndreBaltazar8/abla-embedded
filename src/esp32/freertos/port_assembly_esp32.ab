// Abla/LLVM implementation of the Xtensa FreeRTOS interrupt entry and exit, context dispatch, tick setup, yielding, and coprocessor exception assembly.

// Original ABI symbol: _frxt_setup_switch
// This leaf does not need an architecture instruction body: only PRID itself
// is target-specific. Addressing, scaling, and the flag store stay in typed IR.
@section(".iram1.abla.freertos.setup_switch")
trusted fun esp32RecoveredFrxtSetupSwitch(): void {
    val freertosSetupCore = cpuCoreId()
    val freertosSetupFlags = esp32Data_port_switch_flag_a22483054f
    val freertosSetupFlagAddress =
        freertosSetupFlags + (freertosSetupCore << u32(2))
    val freertosSetupFlagValue = u32(1)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(freertosSetupFlagAddress)), int(freertosSetupFlagValue))
}

// Shared policy for the level 1..3 interrupt-vector shells. The shell owns
// only the interrupted register frame and exception return ABI; pending-mask
// selection, interrupt-table lookup, acknowledgement, and callback dispatch
// are ordinary Abla so LLVM can inline and prune them with their users.
@section(".iram1.abla.freertos.interrupt_dispatch")
trusted fun esp32FrxtDispatchInterrupts(
    levelMask: u32,
    dispatchTick: u32
): void {
    while (true) {
        val pending =
            xtensaReadInterruptEnableRegister() &
            xtensaReadPendingInterruptRegister() &
            levelMask
        if (pending == u32(0)) return

        // Match dispatch_c_isr: the highest numbered pending interrupt wins
        // within a hardware level. Selecting the lowest bit can starve the
        // higher-priority peripheral when several sources remain asserted.
        var selected = pending
        var lowerCleared = selected & (selected - u32(1))
        while (lowerCleared != u32(0)) {
            selected = lowerCleared
            lowerCleared = selected & (selected - u32(1))
        }
        xtensaWritePendingInterruptClear(selected)
        if (dispatchTick != u32(0) && selected == u32(64)) {
            val core = cpuCoreId()
            val runningAddress =
                esp32Data_port_xSchedulerRunning_2618692451 +
                (core << u32(2))
            if (u32(ablaUnsafeVolatileLoadU32(
                int(runningAddress)
            )) == u32(0)) return
            esp32RecoveredFrxtTimerInt()
        } else {
            var interrupt = u32(0)
            var remaining = selected
            while ((remaining & u32(1)) == u32(0)) {
                interrupt = interrupt + u32(1)
                remaining = remaining >> u32(1)
            }

            val core = cpuCoreId()
            val slot = u32(esp32InterruptTableStorage) +
                ((((interrupt << u32(1)) + core)) << u32(3))
            val handler = u32(ablaUnsafeLoadU32(
                nativePointerFromAddress(int(slot))
            ))
            val argument = u32(ablaUnsafeLoadU32(
                nativePointerFromAddress(int(slot + u32(4)))
            ))
            // BSS is visible before early startup has published the default
            // table. Resume startup instead of attempting a null callback.
            if (handler == u32(0)) return
            u32(ablaUnsafeCallI32I32(int(handler), int(argument)))
        }
    }
}

// Original ABI symbol: xPortSysTickHandler
// This is still a naked ABI façade while the task increment functions beneath
// it are converted. Keeping it here lets the typed timer call it directly,
// without a linker-name lookup or a circular module dependency.
@section(".iram1.abla.freertos.systick_handler")
trusted fun esp32RecoveredXPortSysTickHandler(): void {
    // The interrupt watchdog is part of this monolithic runtime, so keep its
    // required tick edge as a typed call. Routing it through the generic
    // integer-address callback table hides the write/read alias from LLVM and
    // allowed the dispatcher load to be folded to the zero initializer.
    esp32InterruptWatchdogTickHook()
    esp32RecoveredEspVApplicationTickHook()
    val switchRequired = if (
        cpuCoreId() == u32(0)
    ) esp32RecoveredXTaskIncrementTick()
    else esp32RecoveredXTaskIncrementTickOtherCores()
    if (switchRequired != u32(0)) esp32RecoveredFrxtSetupSwitch()
}

// Original ABI symbol: _frxt_int_enter
@section(".iram1.abla.freertos.int_enter")
@naked
trusted fun esp32RecoveredFrxtIntEnter(): void =
    $xtensa call0ExceptionEnter {
        _xt_context_save,
        port_xSchedulerRunning,
        port_interruptNesting,
        pxCurrentTCBs,
        port_IntStack,
        1536}

// Original ABI symbol: _frxt_int_exit
@section(".iram1.abla.freertos.int_exit")
@naked
trusted fun esp32RecoveredFrxtIntExit(): void =
    $xtensa call0ExceptionExit {
        port_xSchedulerRunning,
        port_interruptNesting,
        pxCurrentTCBs,
        port_switch_flag,
        vPortYieldFromInt,
        _frxt_dispatch,
        _xt_context_restore,
        3}

// Original ABI symbol: vPortYieldFromInt
@section(".iram1.abla.freertos.yield_from_int")
trusted fun esp32RecoveredVPortYieldFromInt(): void {
    val freertosYieldCore = cpuCoreId()
    val freertosYieldCurrentTasks = esp32Data_pxCurrentTCBs_70ee642553
    val freertosYieldCurrentTaskAddress =
        freertosYieldCurrentTasks + (freertosYieldCore << u32(2))
    val freertosYieldCurrentTask =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosYieldCurrentTaskAddress))))
    val freertosYieldEndOffsetAddress =
        esp32Data_offset_pxEndOfStack_d8f2163a68
    val freertosYieldEndOffset =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosYieldEndOffsetAddress))))
    val freertosYieldEndOfStackAddress =
        freertosYieldCurrentTask + freertosYieldEndOffset
    val freertosYieldEndOfStack =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosYieldEndOfStackAddress))))
    val freertosYieldSaveOffsetAddress = esp32Data_offset_cpsa_06aa27df39
    val freertosYieldSaveOffset =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosYieldSaveOffsetAddress))))
    val freertosYieldSaveArea =
        (freertosYieldEndOfStack - freertosYieldSaveOffset) &
        u32(4294967280)

    val freertosYieldCoprocessorEnable = xtensaReadCoprocessorEnable()
    ablaUnsafeStoreU16(nativePointerFromAddress(int(freertosYieldSaveArea)), int(freertosYieldCoprocessorEnable))
    xtensaWriteCoprocessorEnable(u32(0))
}

// Original ABI symbol: _frxt_dispatch
@section(".iram1.abla.freertos.dispatch")
@naked
trusted fun esp32RecoveredFrxtDispatch(): void =
    $xtensa contextDispatch {
        vTaskSwitchContext,
        pxCurrentTCBs,
        port_uxCoreStartupDone,
        72,
        96,
        _xt_context_restore}

// Original ABI symbol: _frxt_timer_int
@section(".iram1.abla.freertos.timer_int")
trusted fun esp32RecoveredFrxtTimerInt(): void {
    while (true) {
        val divisor = esp32XtTickDivisor
        val previousCompare = xtensaReadCompare0()
        xtensaWriteCompare0(previousCompare + divisor)
        xtensaEventSynchronize()
        esp32RecoveredXPortSysTickHandler()
        xtensaEventSynchronize()
        val elapsed = xtensaReadCycleCount() - previousCompare
        if (!(i32(divisor) < i32(elapsed))) return
    }
}

// Original ABI symbol: _frxt_tick_timer_init
@section(".iram1.abla.freertos.tick_timer_init")
trusted fun esp32RecoveredFrxtTickTimerInit(): void {
    xtensaWriteCompare0(xtensaReadCycleCount() + esp32XtTickDivisor)
    val ignoredPreviousMask = esp32RecoveredXtIntsOn(u32(64))
    return
}

