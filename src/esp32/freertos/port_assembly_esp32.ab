        _xt_coproc_savecs,
        pxCurrentTCBs,
        72,
        96,
        _frxt_dispatch,
        32,
        3}

@section(".iram1.abla.freertos.task_coproc_state_body")
trusted fun esp32FrxtTaskCoprocStateValue(): u32 {
    val freertosTaskStateCore = cpuCoreId()
    val freertosTaskStateCoreOffset = freertosTaskStateCore << u32(2)
    val freertosTaskStateSchedulerTable =
        esp32Data_port_xSchedulerRunning_2618692451
    val freertosTaskStateSchedulerAddress =
        freertosTaskStateSchedulerTable + freertosTaskStateCoreOffset
    val freertosTaskStateSchedulerRunning =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosTaskStateSchedulerAddress))))
    if (freertosTaskStateSchedulerRunning == u32(0)) return u32(0)
    val freertosTaskStateNestingTable =
        esp32Data_port_interruptNesting_1a1c8ca6a6
    val freertosTaskStateNestingAddress =
        freertosTaskStateNestingTable + freertosTaskStateCoreOffset
    val freertosTaskStateNesting =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosTaskStateNestingAddress))))
    if (freertosTaskStateNesting != u32(0)) return u32(0)

    val freertosTaskStateCurrentTable = esp32Data_pxCurrentTCBs_70ee642553
    val freertosTaskStateCurrentAddress =
        freertosTaskStateCurrentTable + freertosTaskStateCoreOffset
    val freertosTaskStateCurrent =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosTaskStateCurrentAddress))))
    if (freertosTaskStateCurrent == u32(0)) return u32(0)
    val freertosTaskStateEndOffsetAddress =
        esp32Data_offset_pxEndOfStack_d8f2163a68
    val freertosTaskStateEndOffset =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosTaskStateEndOffsetAddress))))
    val freertosTaskStateEndAddress =
        freertosTaskStateCurrent + freertosTaskStateEndOffset
    val freertosTaskStateEnd =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosTaskStateEndAddress))))
    val freertosTaskStateSaveOffsetAddress =
        esp32Data_offset_cpsa_06aa27df39
    val freertosTaskStateSaveOffset =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosTaskStateSaveOffsetAddress))))
    return (freertosTaskStateEnd - freertosTaskStateSaveOffset) &
        u32(4294967280)
}

// This is an architectural CALL0 leaf, not a windowed ABI function. The
// coprocessor paths that invoke it permit only a3 and a15 to be clobbered.
@naked
@section(".iram1.abla.freertos.task_coproc_state")
trusted fun esp32RecoveredFrxtTaskCoprocState(): void =
    $xtensa instructions {
rsr.prid a3
extui a3, a3, 13, 1
movi a15, port_xSchedulerRunning
addx4 a15, a3, a15
l32i a15, a15, 0
beqz a15, 1f
movi a15, port_interruptNesting
addx4 a15, a3, a15
l32i a15, a15, 0
bnez a15, 1f
movi a15, pxCurrentTCBs
addx4 a15, a3, a15
l32i a15, a15, 0
beqz a15, 2f
addi a15, a15, 72
l32i a15, a15, 0
addi a15, a15, -96
movi a3, -16
and a15, a15, a3
ret
1:
movi a15, 0
2:
ret
}

@section(".iram1.abla.freertos.coproc_exc_hook_body")
trusted fun esp32FrxtCoprocExceptionHookBody(): void {
    val freertosCoprocHookCore = cpuCoreId()
    val freertosCoprocHookCoreOffset = freertosCoprocHookCore << u32(2)
    val freertosCoprocHookSchedulerTable =
        esp32Data_port_xSchedulerRunning_2618692451
    val freertosCoprocHookSchedulerAddress =
        freertosCoprocHookSchedulerTable + freertosCoprocHookCoreOffset
    val freertosCoprocHookSchedulerRunning =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosCoprocHookSchedulerAddress))))
    if (freertosCoprocHookSchedulerRunning == u32(0)) return
    val freertosCoprocHookNestingTable =
        esp32Data_port_interruptNesting_1a1c8ca6a6
    val freertosCoprocHookNestingAddress =
        freertosCoprocHookNestingTable + freertosCoprocHookCoreOffset
    val freertosCoprocHookNesting =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosCoprocHookNestingAddress))))
    if (freertosCoprocHookNesting != u32(0)) return

    val freertosCoprocHookCurrentTable = esp32Data_pxCurrentTCBs_70ee642553
    val freertosCoprocHookCurrentAddress =
        freertosCoprocHookCurrentTable + freertosCoprocHookCoreOffset
    val freertosCoprocHookCurrent =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosCoprocHookCurrentAddress))))
    val freertosCoprocHookCoreIdOffsetAddress =
        esp32Data_offset_xCoreID_6d7dbc7cac
    val freertosCoprocHookCoreIdOffset =
        u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(freertosCoprocHookCoreIdOffsetAddress))))
    val freertosCoprocHookCoreIdAddress =
        freertosCoprocHookCurrent + freertosCoprocHookCoreIdOffset
    ablaUnsafeStoreU32(nativePointerFromAddress(int(freertosCoprocHookCoreIdAddress)), int(freertosCoprocHookCore))
}

@naked
@section(".iram1.abla.freertos.coproc_exc_hook")
trusted fun esp32RecoveredFrxtCoprocExcHook(): void =
    $xtensa instructions {
rsr.prid a2
extui a2, a2, 13, 1
movi a3, port_xSchedulerRunning
addx4 a3, a2, a3
l32i a3, a3, 0
beqz a3, 1f
movi a3, port_interruptNesting
addx4 a3, a2, a3
l32i a3, a3, 0
bnez a3, 1f
movi a3, pxCurrentTCBs
addx4 a3, a2, a3
l32i a3, a3, 0
s32i a2, a3, 68
1:
ret
}
