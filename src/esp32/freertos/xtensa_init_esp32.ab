import "../../xtensa/assembly.ab"
import "abla/unsafe/memory"

// The divisor is ordinary module state in the monolithic LLVM graph. It no
// longer needs a hand-emitted BSS symbol merely so recovered assembly can find
// it, and unused clock compatibility code can now be pruned normally.
var esp32XtTickDivisor: u32 = u32(0)

@inline
trusted fun esp32XtensaCpuFrequencyHz(): u32 {
    val ticksPerMicrosecond = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(u32(1073611232)))))
    return ticksPerMicrosecond * u32(1000000)
}

// Original ABI symbol: _xt_tick_divisor_init
trusted fun esp32RecoveredXtTickDivisorInit(): void {
    esp32XtTickDivisor = esp32XtensaCpuFrequencyHz() / u32(1000)
    return
}

// Original ABI symbol: xt_clock_freq
trusted fun esp32RecoveredXtClockFreq(): u32 =
    esp32XtensaCpuFrequencyHz()
