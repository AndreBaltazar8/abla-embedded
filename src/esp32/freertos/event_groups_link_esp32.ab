import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosEventGroupsInternals(): bool {
    if (!internalFunction("esp32RecoveredXEventGroupCreateStatic", "xEventGroupCreateStatic")) return false
    if (!internalFunction("esp32RecoveredXEventGroupCreate", "xEventGroupCreate")) return false
    if (!internalFunction("esp32RecoveredXEventGroupWaitBits", "xEventGroupWaitBits")) return false
    if (!internalFunction("esp32RecoveredXEventGroupClearBits", "xEventGroupClearBits")) return false
    if (!internalFunction("esp32RecoveredXEventGroupGetBitsFromISR", "xEventGroupGetBitsFromISR")) return false
    if (!internalFunction("esp32RecoveredXEventGroupSetBits", "xEventGroupSetBits")) return false
    if (!internalFunction("esp32RecoveredXEventGroupSync", "xEventGroupSync")) return false
    if (!internalFunction("esp32RecoveredVEventGroupDelete", "vEventGroupDelete")) return false
    if (!internalFunction("esp32RecoveredXEventGroupGetStaticBuffer", "xEventGroupGetStaticBuffer")) return false
    if (!internalFunction("esp32RecoveredVEventGroupSetBitsCallback", "vEventGroupSetBitsCallback")) return false
    if (!internalFunction("esp32RecoveredVEventGroupClearBitsCallback", "vEventGroupClearBitsCallback")) return false
    true
}
