import "../heap/capabilities_policy_esp32.ab"
import "../heap/capabilities_base_esp32.ab"
import "../heap/capabilities_telemetry_esp32.ab"
import "../memory/address_esp32.ab"

@inline
fun esp32FreertosHeapCandidateAddress(address: u32): bool =
    esp32AddressInHalfOpenRange(
        address, u32(1073283072), u32(1074536448)
    ) || esp32AddressInHalfOpenRange(
        address, u32(1342177280), u32(1342185472)
    )

@inline
trusted fun esp32FreertosHeapValidAddress(address: u32): u32 {
    if (!esp32FreertosHeapCandidateAddress(address)) return u32(0)
    esp32RecoveredEspPtrByteAccessible(address)
}

trusted fun esp32RecoveredPvPortMalloc(
    size: u32,
    a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32HeapCapsMalloc(size, u32(2052))

trusted fun esp32RecoveredVPortFree(
    memory: u32,
    a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32HeapCapsFree(memory)
    memory
}

trusted fun esp32RecoveredXPortGetFreeHeapSize(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32HeapCapsGetFreeSize(u32(2052))

trusted fun esp32RecoveredXPortGetMinimumEverFreeHeapSize(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32HeapCapsGetMinimumFreeSize(u32(2052))

trusted fun esp32RecoveredXPortCheckValidListMem(
    address: u32,
    a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32FreertosHeapValidAddress(address)

trusted fun esp32RecoveredXPortCheckValidTCBMem(
    address: u32,
    a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32FreertosHeapValidAddress(address)

trusted fun esp32RecoveredXPortcheckValidStackMem(
    address: u32,
    a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32FreertosHeapValidAddress(address)
