import "abla/build"

// Exact names used by recovered assembly and mixed callers. ESP-IDF vectors,
// libc locks, and the remaining scheduler C source call the port roots below,
// so those roots need object-visible ABI symbols. vPortYieldFromInt is reached
// only from the Abla-owned interrupt-exit body and remains internal.
compile fun esp32Idf6LinkFreertosPortAssemblyInternals(): bool {
    if (!exportFunction("esp32RecoveredFrxtSetupSwitch", "_frxt_setup_switch")) return false
    if (!exportFunction("esp32RecoveredFrxtIntEnter", "_frxt_int_enter")) return false
    if (!exportFunction("esp32RecoveredFrxtIntExit", "_frxt_int_exit")) return false
    if (!internalFunction("esp32RecoveredVPortYieldFromInt", "vPortYieldFromInt")) return false
    if (!internalFunction("esp32RecoveredFrxtDispatch", "_frxt_dispatch")) return false
    if (!internalFunction(
        "esp32FrxtDispatchInterrupts",
        "abla_esp32_frxt_dispatch_interrupts"
    )) return false
    if (!exportFunction("esp32RecoveredFrxtTimerInt", "_frxt_timer_int")) return false
    if (!exportFunction("esp32RecoveredVPortYield", "vPortYield")) return false
    if (!exportFunction("esp32RecoveredFrxtTaskCoprocState", "_frxt_task_coproc_state")) return false
    if (!exportFunction("esp32RecoveredFrxtCoprocExcHook", "_frxt_coproc_exc_hook")) return false
    true
}
