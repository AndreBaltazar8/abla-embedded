import "./adc1_config_sequence.ab"
import "./adc1_oneshot_esp32.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("esp32Adc1HallRead")
trusted fun esp32Adc1HallReadHook(): int = mmioLoadU32(0x3ff48478)
@export("esp32Adc1HallWrite")
trusted fun esp32Adc1HallWriteHook(value: int): void { mmioStoreU32(0x3ff48478,value); return }
