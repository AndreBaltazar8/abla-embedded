// Finite, contiguous internal-SRAM TX chain. Caller exclusively owns the
// parked channel, full descriptor storage and initialized payload. No start,
// allocation, cache/externalRAM support or peripheral-specific terminator.
// 4092-byte nodes keep every payload4-byte aligned; EOF only on the last node.
fun esp32s3GdmaLinearTxCount(bytes: int): int =
    if (bytes < 4 || bytes > 491520 || (bytes & 3) != 0) 0 else (bytes + 4091) / 4092

fun esp32s3GdmaLinearTxLayoutValid(descriptors: int, buffer: int, bytes: int): bool {
    val count = esp32s3GdmaLinearTxCount(bytes)
    if (count == 0 || descriptors < 0x3fc88000 || buffer < 0x3fc88000 ||
        descriptors > 0x3fd00000 - count * 12 || buffer > 0x3fd00000 - bytes ||
        (descriptors & 3) != 0 || (buffer & 3) != 0) return false
    descriptors >= buffer + bytes || buffer >= descriptors + count * 12
}

// Returns descriptor count,0 on invalid input with NO writes.
trusted fun esp32s3GdmaInitializeTxChainOwned(descriptors: int, buffer: int, bytes: int): int {
    if (!esp32s3GdmaLinearTxLayoutValid(descriptors, buffer, bytes)) return 0
    val count = esp32s3GdmaLinearTxCount(bytes)
    var index = 0
    var offset = 0
    while (index < count) {
        val remaining = bytes - offset
        val length = if (remaining > 4092) 4092 else remaining
        val address = descriptors + index * 12
        val last = index + 1 == count
        esp32s3GdmaWrite(address + 4, buffer + offset)
        esp32s3GdmaWrite(address + 8, if (last) 0 else address + 12)
        esp32s3GdmaWrite(address, 0x80000000 | (if (last) 0x40000000 else 0) |
            (length << 12) | length)
        offset = offset + length
        index = index + 1
    }
    esp32s3GdmaPublish()
    count
}
