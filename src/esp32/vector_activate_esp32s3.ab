import "./vector_activate_s3_sequence.ab"
import "./vectors_esp32s3.ab"
import "./core_local_init_esp32s3.ab"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
@inline
@export("esp32S3VectorStatus")
trusted fun esp32S3VectorStatusHook(): int = xtensaGuardStatus()
@inline
@export("esp32S3VectorConfig")
trusted fun esp32S3VectorConfigHook(): int = esp32S3IrqConfigAddress()
@inline
@export("esp32S3VectorRead")
trusted fun esp32S3VectorReadHook(address: int): int = mmioLoadU32(address)
