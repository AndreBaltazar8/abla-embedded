import "./vector_activate_s3_sequence.ab"
import "./vectors_esp32s3.ab"
import "./core_local_init_esp32s3.ab"
@inline
trusted fun esp32S3VectorStatus(): int = xtensaGuardStatus()
@inline
trusted fun esp32S3VectorConfig(): int = esp32S3IrqConfigAddress()
@inline
trusted fun esp32S3VectorRead(address: int): int = mmioLoadU32(address)
