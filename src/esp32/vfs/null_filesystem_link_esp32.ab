import "abla/build"

// Direct ABI names for the structured-Abla null filesystem.
compile fun esp32Idf6LinkVfsNullFilesystemInternals(): bool {
    if (!internalFunction("esp32VfsNullGetOperations", "esp_vfs_null_get_vfs")) return false
    if (!internalFunction("esp32VfsNullRegister", "esp_vfs_null_register")) return false
    if (!internalFunction("esp32VfsIncludeNullRegistration", "esp_vfs_include_nullfs_register")) return false
    true
}
