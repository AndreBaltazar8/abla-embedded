import "abla/build"

// All public libc/ESP-IDF spellings resolve directly to structured Abla.
// Internal linkage keeps unused syscall families removable by LLVM.
compile fun esp32Idf6LinkVfsCallsInternals(): bool {
    if (!internalFunction("esp32VfsOpen", "_open_r")) return false
    if (!internalFunction("esp32VfsWrite", "_write_r")) return false
    if (!internalFunction("esp32VfsLseek", "_lseek_r")) return false
    if (!internalFunction("esp32VfsRead", "_read_r")) return false
    if (!internalFunction("esp32VfsPread", "esp_vfs_pread")) return false
    if (!internalFunction("esp32VfsPwrite", "esp_vfs_pwrite")) return false
    if (!internalFunction("esp32VfsClose", "_close_r")) return false
    if (!internalFunction("esp32VfsFstat", "_fstat_r")) return false
    if (!internalFunction("esp32VfsFcntl", "_fcntl_r")) return false
    if (!internalFunction("esp32VfsIoctlAbi", "esp_vfs_ioctl")) return false
    if (!internalFunction("esp32VfsFsync", "esp_vfs_fsync")) return false
    if (!internalFunction("esp32VfsStat", "_stat_r")) return false
    if (!internalFunction("esp32VfsUtime", "esp_vfs_utime")) return false
    if (!internalFunction("esp32VfsLink", "_link_r")) return false
    if (!internalFunction("esp32VfsUnlink", "_unlink_r")) return false
    if (!internalFunction("esp32VfsRename", "_rename_r")) return false
    if (!internalFunction("esp32VfsOpendir", "esp_vfs_opendir")) return false
    if (!internalFunction("esp32VfsReaddir", "esp_vfs_readdir")) return false
    if (!internalFunction("esp32VfsReaddirR", "esp_vfs_readdir_r")) return false
    if (!internalFunction("esp32VfsTelldir", "esp_vfs_telldir")) return false
    if (!internalFunction("esp32VfsSeekdir", "esp_vfs_seekdir")) return false
    if (!internalFunction("esp32VfsRewinddir", "esp_vfs_rewinddir")) return false
    if (!internalFunction("esp32VfsClosedir", "closedir")) return false
    if (!internalFunction("esp32VfsMkdir", "esp_vfs_mkdir")) return false
    if (!internalFunction("esp32VfsRmdir", "esp_vfs_rmdir")) return false
    if (!internalFunction("esp32VfsAccess", "access")) return false
    if (!internalFunction("esp32VfsTruncate", "esp_vfs_truncate")) return false
    if (!internalFunction("esp32VfsFtruncate", "esp_vfs_ftruncate")) return false
    if (!internalFunction("esp32VfsSelect", "esp_vfs_select")) return false
    if (!internalFunction("esp32VfsSelectTriggered", "esp_vfs_select_triggered")) return false
    if (!internalFunction("esp32VfsSelectTriggeredIsr", "esp_vfs_select_triggered_isr")) return false
    if (!internalFunction("esp32VfsIncludeSyscallsImplementation", "vfs_include_syscalls_impl")) return false
    if (!internalFunction("esp32VfsOpen", "esp_vfs_open")) return false
    if (!internalFunction("esp32VfsWrite", "esp_vfs_write")) return false
    if (!internalFunction("esp32VfsLseek", "esp_vfs_lseek")) return false
    if (!internalFunction("esp32VfsRead", "esp_vfs_read")) return false
    if (!internalFunction("esp32VfsPread", "pread")) return false
    if (!internalFunction("esp32VfsPwrite", "pwrite")) return false
    if (!internalFunction("esp32VfsClose", "esp_vfs_close")) return false
    if (!internalFunction("esp32VfsFstat", "esp_vfs_fstat")) return false
    if (!internalFunction("esp32VfsFcntl", "esp_vfs_fcntl_r")) return false
    if (!internalFunction("esp32VfsIoctlAbi", "ioctl")) return false
    if (!internalFunction("esp32VfsFsync", "fsync")) return false
    if (!internalFunction("esp32VfsStat", "esp_vfs_stat")) return false
    if (!internalFunction("esp32VfsUtime", "utime")) return false
    if (!internalFunction("esp32VfsLink", "esp_vfs_link")) return false
    if (!internalFunction("esp32VfsUnlink", "esp_vfs_unlink")) return false
    if (!internalFunction("esp32VfsRename", "esp_vfs_rename")) return false
    if (!internalFunction("esp32VfsOpendir", "opendir")) return false
    if (!internalFunction("esp32VfsReaddir", "readdir")) return false
    if (!internalFunction("esp32VfsReaddirR", "readdir_r")) return false
    if (!internalFunction("esp32VfsTelldir", "telldir")) return false
    if (!internalFunction("esp32VfsSeekdir", "seekdir")) return false
    if (!internalFunction("esp32VfsRewinddir", "rewinddir")) return false
    if (!internalFunction("esp32VfsClosedir", "esp_vfs_closedir")) return false
    if (!internalFunction("esp32VfsMkdir", "mkdir")) return false
    if (!internalFunction("esp32VfsRmdir", "rmdir")) return false
    if (!internalFunction("esp32VfsAccess", "esp_vfs_access")) return false
    if (!internalFunction("esp32VfsTruncate", "truncate")) return false
    if (!internalFunction("esp32VfsFtruncate", "ftruncate")) return false
    if (!internalFunction("esp32VfsSelect", "select")) return false
    true
}
