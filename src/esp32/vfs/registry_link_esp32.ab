import "abla/build"

// ESP-IDF ABI spellings resolve directly to structured Abla functions.
// They remain internal by default so monolithic LLVM DCE can discard every
// registry path which the selected firmware does not use.
compile fun esp32Idf6LinkVfsRegistryInternals(): bool {
    if (!internalFunction("esp32VfsRegisterFs", "esp_vfs_register_fs")) return false
    if (!internalFunction("esp32VfsRegisterCommon", "esp_vfs_register_common")) return false
    if (!internalFunction("esp32VfsRegister", "esp_vfs_register")) return false
    if (!internalFunction("esp32VfsRegisterWithId", "esp_vfs_register_with_id")) return false
    if (!internalFunction("esp32VfsRegisterFdRange", "esp_vfs_register_fd_range")) return false
    if (!internalFunction("esp32VfsRegisterFsWithId", "esp_vfs_register_fs_with_id")) return false
    if (!internalFunction("esp32VfsUnregisterWithId", "esp_vfs_unregister_fs_with_id")) return false
    if (!internalFunction("esp32VfsUnregister", "esp_vfs_unregister")) return false
    if (!internalFunction("esp32VfsRegisterFdWithLocalFd", "esp_vfs_register_fd_with_local_fd")) return false
    if (!internalFunction("esp32VfsRegisterFd", "esp_vfs_register_fd")) return false
    if (!internalFunction("esp32VfsUnregisterFd", "esp_vfs_unregister_fd")) return false
    if (!internalFunction("esp32VfsDumpFds", "esp_vfs_dump_fds")) return false
    if (!internalFunction("esp32VfsDumpRegisteredPaths", "esp_vfs_dump_registered_paths")) return false
    if (!internalFunction("esp32VfsSetReadonlyFlag", "esp_vfs_set_readonly_flag")) return false
    if (!internalFunction("esp32VfsGetForIndex", "get_vfs_for_index")) return false
    if (!internalFunction("esp32VfsRegisterLocalFd", "register_fd")) return false
    if (!internalFunction("esp32VfsUnregisterLocalFd", "unregister_fd")) return false
    if (!internalFunction("esp32VfsGetFdEntry", "get_fd_entry")) return false
    if (!internalFunction("esp32VfsGetForFd", "get_vfs_for_fd")) return false
    if (!internalFunction("esp32VfsGetLocalFd", "get_local_fd")) return false
    if (!internalFunction("esp32VfsTranslatePath", "translate_path")) return false
    if (!internalFunction("esp32VfsGetForPath", "get_vfs_for_path")) return false
    if (!internalFunction("esp32VfsGetCount", "get_vfs_count")) return false
    if (!internalFunction("esp32VfsClosePending", "close_pending")) return false
    if (!internalFunction("esp32VfsStartSelect", "start_select")) return false
    if (!internalFunction("esp32VfsUnregisterWithId", "esp_vfs_unregister_with_id")) return false
    if (!internalFunction("esp32VfsUnregister", "esp_vfs_unregister_fs")) return false
    true
}
