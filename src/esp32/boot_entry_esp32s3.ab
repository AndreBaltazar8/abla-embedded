import "./context_extra_esp32s3.ab"
import "./boot_vectors_esp32s3.ab"
trusted noescape extern:"inline-assembly" fun esp32S3BootEntryAssembly(template: string,constraints: string): void
// Application-image entry, NOT a ROM/second-stage bootloader replacement.
// Loader must have loaded internal code/data and kept CPU1 stopped. Linker
// defines __abla_boot_stack_top (16-aligned reserved internal stack); the app
// provides abla_boot_main as a void(), windowed-ABI IRAM function. These are
// intentional image/linker boundaries, not SDK/libc implementation imports.
// No incoming return path survives resetting register windows. Startup must
// initialize BSS/runtime before globals/IRQs; returning main halts masked.
// Own early vectors before enabling WOE or making any Abla call. The early
// table handles windows/MOVSP without BSS; other faults halt until runtime
// installs its normal exception policy. Link early vectors aligned1024.
// Standard boot_main roots both private tables through BootVectorAddress;
// custom mains must do the same (otherwise linking fails, never a ROM fallback).
@export("abla_boot_entry")
@naked
@noinline
@section(".iram1.abla.s3BootEntry")
trusted fun esp32S3BootEntry(): void =
esp32S3BootEntryAssembly("rsil a0, 15\nmovi a0, 15\nwsr.ps a0\nrsync\nmovi a0, 0\nwsr.intenable a0\nwsr.cpenable a0\nwsr.windowbase a0\nrsync\nmovi a0, 1\nwsr.windowstart a0\nrsync\nmovi a1, __abla_boot_stack_top\naddi a1, a1, -32\nmovi a0, 0\ns32i a0, a1, 0\ns32i a0, a1, 4\ns32i a0, a1, 8\ns32i a0, a1, 12\ns32e a0, a1, -16\ns32e a0, a1, -12\nmovi a0, .Labla_s3_boot_vectors\nwsr.vecbase a0\nrsync\nmovi a0, 262191\nwsr.ps a0\nrsync\nmovi a0, 0\ncall4 abla_boot_main\nrsil a0, 15\n.Labla_s3_boot_returned:\nj .Labla_s3_boot_returned", "~{memory}")
