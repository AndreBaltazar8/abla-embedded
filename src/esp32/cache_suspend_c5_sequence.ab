// Same-core, non-nested ownership only. Caller masks interrupts, quiesces cache
// users and retains the ENTIRE closure, stack and token in internal memory.
// C5 cannot query cache enabled state: caller must know it is enabled on entry.
// Never copy/reuse a consumed token or change MMU/tags while suspended.
// Low32 preserves the complete ROM autoload token; high32 saves predictor bits.
type Esp32C5CacheSuspendState = int
@section(".iram1.abla.c5CacheSuspend")
trusted fun esp32C5CacheSuspendOwned(): Esp32C5CacheSuspendState {
    val predictor=c5CachePredictorDisable() & 0x1030
    val autoload=c5CacheRomSuspend() & 0xFFFFFFFF
    Esp32C5CacheSuspendState(autoload | (predictor<<32))
}
@section(".iram1.abla.c5CacheResume")
trusted fun esp32C5CacheResumeOwned(saved: Esp32C5CacheSuspendState): void {
    // Flash and its clocks must already be ready before resuming the cache.
    c5CacheRomResume((saved|0)&0xFFFFFFFF)
    c5CachePredictorRestore(((saved|0)>>>32)&0x1030)
    return
}
