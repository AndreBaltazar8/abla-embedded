trusted fun esp32S3Adc1SessionHardwareMatches(channel: int,attenuation: int): bool {
    if ((esp32S3SarRead(0x60008904)&0x40000000) == 0 ||
        (esp32S3SarRead(0x6000883c)&0x60000000) != 0x60000000 ||
        esp32S3AdcBusState() != 5 || !esp32S3Adc1Prepared() ||
        (esp32S3Adc1Read(0)&0x300000ff) != 1 ||
        ((esp32S3Adc1Read(20)>>(channel*2))&3) != attenuation) return false
    val pin=channel+1
    val bit=1<<pin
    return (esp32S3AdcPadRead(0x600080d8)&bit) == 0 &&
        (esp32S3AdcPadRead(0x60008088)&0x200000) == 0 &&
        (esp32S3AdcPadRead(0x60008094)&0x8000) == 0 &&
        (esp32S3AdcPadRead(0x60008484+pin*4)&0x185f2000) == 0 &&
        (esp32S3AdcPadRead(0x60009004+pin*4)&0x7382) == 0x1000 &&
        (esp32S3AdcPadRead(0x60004554+pin*4)&0xc00) == 0x400 &&
        (esp32S3AdcPadRead(0x60004020)&bit) == 0 &&
        (esp32S3AdcPadRead(0x6000840c)&(bit<<10)) == 0
}
