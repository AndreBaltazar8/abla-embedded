import "./jobs_sequence.ab"
import "./stream_chunk_p4_sequence.ab"
// Same immutable job table as S3/C5. The caller retains controller, pads,
// clocks and exclusive bus ownership across all phases and any failed batch.
// No automatic STOP/replay/reset on error; use explicit owned recovery.
fun i2cJobsFifoBytes(port: int): int = if (port >= 0 && port <= 1) 32 else 0
trusted fun i2cJobsCounter(): u32 = p4I2cCounter()
trusted fun i2cJobsChunk(port: int,address: int,data: NativeBuffer,count: int,reading: bool,first: bool,finish: bool,continued: bool,started: u32,budget: u32,nackLast: bool): int =
    esp32p4I2cStreamChunkOwned(port,address,data,count,reading,first,finish,continued,started,budget,-1,nackLast)
