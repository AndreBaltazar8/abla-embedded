import "./poll_p4_sequence.ab"
// Address-only probe: ACK checking is disabled for its single address byte,
// allowing the already-queued STOP on either response. SR.RESP_REC bit0 then
// distinguishes presence. NEVER apply this to ordinary data transfers.
// Result1 ACK+completedSTOP,9 NACK+completedSTOP; other results retain poll
// meanings, including raw3NACK error (NOT proof of a completed absent probe).
// Require STOP DONE, empty FIFOs and idle controller before reporting9.
// Clock/timing/pads prepared, IRQ/DMA stopped, exclusive stable counter owner.
trusted fun esp32p4I2cProbeOwned(port: int,address: int,budget: u32,exclusive: bool): int {
    if (!exclusive || port < 0 || port > 1 || address < 1 || address > 127 || budget == u32(0) || budget > u32(0x7fffffff)) return 7
    val started=p4I2cCounter()
    if (!p4I2cFifoReady(port)) return 7
    val base=p4I2cBase(port)
    if (!p4I2cIdle(port)) return 8
    val before=p4I2cRead(base+8)
    if (esp32S3I2cTxCount(before) != 0 || esp32S3I2cRxCount(before) != 0) return 6
    if (esp32p4I2cWriteCommandOwned(port,0,esp32S3I2cCommand(6,0),true) != 1 ||
        esp32p4I2cWriteCommandOwned(port,1,esp32S3I2cCommand(1,1,false),true) != 1 ||
        esp32p4I2cWriteCommandOwned(port,2,esp32S3I2cCommand(2,0),true) != 1) return 6
    p4I2cWrite(base+28,u32(address*2))
    val result=esp32p4I2cRunBatchUntilOwned(port,2,started,budget,false,true)
    if (result != 1) return result
    val after=p4I2cRead(base+8)
    if ((after&u32(16)) != u32(0) || (p4I2cRead(base+4)&u32(32)) != u32(0)) return 8
    if (esp32S3I2cTxCount(after) != 0 || esp32S3I2cRxCount(after) != 0) return 6
    return if ((after&u32(1)) != u32(0)) 9 else 1
}
