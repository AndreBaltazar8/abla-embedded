import "../../i2c/software_lines.ab"
import "../gpio_esp32c61.ab"
import "../peripheral_delay_esp32c61.ab"
trusted fun softwareI2cDrive(pin: int,released: bool): void { esp32C61GpioWriteOwned(pin,released);return }
trusted fun softwareI2cSample(pin: int): bool = esp32C61GpioReadOwned(pin) == 1
trusted fun softwareI2cDelay(us: int): void = peripheralRomDelay(us)
