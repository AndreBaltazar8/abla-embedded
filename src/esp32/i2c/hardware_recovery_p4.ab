import "./hardware_provider_p4.ab"
// Explicit idle recovery, optionally terminating this owner's halted NACK.
// stopAfterNack requires physical single-master exclusivity from caller.
// 1recovered2invalid3timeout4busy/arbitration6transport7not recoverable.
// Original session.primary remains available after successful recovery.
trusted fun I2cBus.recoverStatus(timeoutMilliseconds: int = 1000,stopAfterNack: bool = false): int {
    if (!this.valid() || timeoutMilliseconds < 1 || timeoutMilliseconds > 1000000) return 2
    if (!p4HardwareEnter()) return 4
    var result=2
    if (this.current()) {
        val r=p4HardwareSession()
        val perMs=(u32(p4HardwareLoad(16))+u32(999))/u32(1000)
        if ((r.loadU32(4) != 1 && r.loadU32(4) != 3) || r.loadU32(24) != 3 ||
            (stopAfterNack && r.loadU32(8) != 3)) result=7
        else if (u32(timeoutMilliseconds) <= u32(2147483647)/perMs) {
            r.storeU32(4,2)
            val raw=p4HardwareRecover(r,perMs*u32(timeoutMilliseconds),stopAfterNack)
            r.storeU32(12,if (raw == 1) 0 else raw)
            r.storeU32(4,if (raw == 1) 1 else 3)
            result=if (raw == 1) 1 else if (raw == 5) 3 else if (raw == 4 || raw == 8) 4 else if (raw == 7) 7 else 6
        }
    }
    if (!p4HardwareLeave()) return 4
    return result
}
trusted fun I2cBus.recover(): bool = this.recoverStatus() == 1
