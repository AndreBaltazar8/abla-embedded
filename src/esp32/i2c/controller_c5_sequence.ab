// Reset, clock-enabled HP I2C0 only; caller owns controller and keeps pads
// disconnected/safe. Destroys pending FIFO/IRQ/commands; not a resume helper.
// C5 FORCE_OUT bits0/1 must be ZERO for open drain (not the S3 value).
trusted fun c5I2cControllerField(address: int,mask: int,value: int): void {
    c5I2cControllerStore(address,(c5I2cControllerLoad(address)&~mask)|(value&mask))
    return
}
trusted fun esp32C5I2cInitializeControllerOwned(port: int,filter: int): bool {
    if (port != 0 || filter < 0 || filter > 15) return false
    // Master, register clock on, MSB-first, no arbitration, RX-full ACK low.
    // Also clear inherited START/FSM_RESET/UPDATE/slave-auto-start controls.
    c5I2cControllerField(0x60004004,0x1FFB,0x110)
    c5I2cControllerField(0x60004018,0x4400,0x4000)
    val fifo=c5I2cControllerLoad(0x60004018)
    c5I2cControllerStore(0x60004018,fifo|12288)
    c5I2cControllerStore(0x60004018,fifo&~12288)
    c5I2cControllerField(0x60004050,1023,if (filter == 0) 0 else filter|(filter<<4)|768)
    c5I2cControllerStore(0x60004028,0)
    c5I2cControllerStore(0x60004024,0x3FFFF)
    var index=0
    while (index < 8) {
        c5I2cControllerStore(0x60004058+index*4,8192)
        index=index+1
    }
    c5I2cControllerField(0x60004004,2048,2048)
    true
}
