import "./fifo_p4_sequence.ab"
// Destructive initialization of a quiesced, clock-enabled HP I2C controller.
// Caller disconnected/safed pads, stopped former IRQ/DMA users, owns RCC and
// controller throughout. NOT live recovery: never resets an active bus.
// Open drain FORCE_OUT=0 on P4, unlike S3. Single-master/MSB-first polling.
// 1configured2invalid3clock/reset4busy5readback6FIFO-count. Retry whole setup
// while still disconnected after failure; no implicit controller reset.
trusted fun esp32p4I2cInitializeControllerOwned(port: int,filter: int,exclusive: bool): int {
    if (!exclusive || port < 0 || port > 1 || filter < 0 || filter > 15) return 2
    if (!esp32p4I2cClockReady(port)) return 3
    if (!p4I2cIdle(port)) return 4
    val base=p4I2cBase(port)
    if (!p4I2cField(base+40,u32(0x7ffff),u32(0)) ||
        !p4I2cField(base+4,u32(0x1ffb),u32(0x110)) ||
        !p4I2cField(base+24,u32(0x4c00),u32(0x4000)) ||
        !p4I2cField(base+24,u32(0x3000),u32(0x3000)) ||
        !p4I2cField(base+24,u32(0x3000),u32(0)) ||
        !p4I2cField(base+80,u32(1023),if (filter == 0) u32(0) else u32(filter)|(u32(filter)<<u32(4))|u32(768))) return 5
    val status=p4I2cRead(base+8)
    if (esp32S3I2cTxCount(status) != 0 || esp32S3I2cRxCount(status) != 0) return 6
    // P4 has19 interrupt bits, including slave-address-unmatched at18.
    p4I2cWrite(base+36,u32(0x7ffff))
    var index=0
    while (index < 8) {
        p4I2cWrite(base+88+index*4,u32(8192))
        if (p4I2cRead(base+88+index*4) != u32(8192)) return 5
        index=index+1
    }
    p4I2cWrite(base+4,p4I2cRead(base+4)|u32(2048))
    return 1
}
