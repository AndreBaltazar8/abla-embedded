import "./lp_timing_c5_sequence.ab"
// Status1 ready,2 invalid,3 unavailablepads,4 clockfailure,5 controllerfailure,
// 6 timingfailure,7 routingfailure. Bit8 cleanup attempted,bit9 cleanup failed.
// Success means configured registers, not verified bus communication.
type Esp32C5LpI2cSetup = int
fun Esp32C5LpI2cSetup.status(): int = this & 255
fun Esp32C5LpI2cSetup.valid(): bool = this.status() == 1
fun Esp32C5LpI2cSetup.cleanupAttempted(): bool = (this&256) != 0
fun Esp32C5LpI2cSetup.cleanupFailed(): bool = (this&512) != 0
trusted fun c5LpI2cSetupFailure(status: int): Esp32C5LpI2cSetup =
    Esp32C5LpI2cSetup(status|256|(if (c5LpI2cSetupDisable()) 0 else 512))
// Exclusive LP controller + shared LPPERI/LP_CLKRST/GPIO ownership spans call.
// LP GPIO clocks are caller-owned/enabled; never acquired or disabled here.
// Caller excludes LP CPU/ULP. source0 LP_FAST,1 XTAL_D2.
// Initial pads must be safe/disconnected, sources already stable/calibrated.
// Preflight before reset, then clock/controller/timing and route pads LAST.
// No pin mutation on any failure: route rejects before its first write.
trusted fun esp32C5LpI2cSetupOwned(port: int,sda: int,scl: int,source: int,
    sourceHz: u32,busHz: u32,filter: int = 7,pullup: bool = true): Esp32C5LpI2cSetup {
    val timing=esp32C5LpI2cTiming(sourceHz,busHz)
    if (port != 0 || sda != 2 || scl != 3 || source < 0 || source > 1 || filter < 0 || filter > 15 || !timing.valid()) return Esp32C5LpI2cSetup(2)
    if (!c5LpI2cSetupPadsAvailable(sda,scl)) return Esp32C5LpI2cSetup(3)
    if (!c5LpI2cSetupClock(source)) return c5LpI2cSetupFailure(4)
    if (!c5LpI2cSetupController(filter)) return c5LpI2cSetupFailure(5)
    if (!c5LpI2cSetupTiming(timing)) return c5LpI2cSetupFailure(6)
    if (!c5LpI2cSetupRoute(sda,scl,pullup)) return c5LpI2cSetupFailure(7)
    Esp32C5LpI2cSetup(1)
}
