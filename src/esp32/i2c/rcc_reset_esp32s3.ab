import "../rcc_esp32s3.ab"
import "./recovery_esp32s3.ab"

// Caller already owns/quiesced this I2C controller (lock order: peripheral,
// then RCC). Lock covers only bounded local reset/configuration work, never
// a transfer or waiting for an external slave. False must not clear a fault.
trusted fun esp32S3I2cResetWithRccLock(port: int, rcc: AtomicU32,
    owner: u32, preserveConfiguration: bool): bool {
    if (esp32S3I2cControllerAddress(port) == 0) return false
    val saved = esp32S3RccTryEnter(rcc, owner)
    if (saved < 0) return false
    val reset = if (preserveConfiguration) esp32S3I2cResetPollingControllerLocked(port)
        else esp32S3I2cResetClockedControllerLocked(port)
    val released = esp32S3RccLeave(rcc, owner, saved)
    reset && released
}

// Caller already owns a stopped/reset peripheral; do not gate a live transfer.
trusted fun esp32S3I2cDisableClockWithRccLock(port: int, rcc: AtomicU32, owner: u32): bool {
    if (esp32S3I2cControllerAddress(port) == 0) return false
    val saved = esp32S3RccTryEnter(rcc, owner)
    if (saved < 0) return false
    val mask = if (port == 0) u32(128) else u32(262144)
    esp32S3I2cTimingField(0x600c0018, mask, u32(0))
    esp32S3RccLeave(rcc, owner, saved)
}
