import "./pins_c5_sequence.ab"
// Verify actual C5 matrix/mux/open-drain routing before passive bus checks.
// Caller owns a SINGLE-MASTER bus and keeps routing serialized. This cannot
// detect another master's idle gaps and is NOT permission to recover after
// arbitration loss on a multi-master bus.
trusted fun esp32C5I2cConfiguredPinsMatchOwned(port: int,sda: int,scl: int): bool {
    if (!esp32C5I2cPinsAvailableOwned(port,sda,scl)) return false
    var index=0
    while (index < 2) {
        val pin=if (index == 0) scl else sda
        val signal=46+index
        if ((c5I2cPinLoad(0x60090000+pin*4)&0x7202) != 0x1200 ||
            (c5I2cPinLoad(0x600910D4+pin*4)&4) == 0 ||
            (c5I2cPinLoad(0x600912D4+signal*4)&511) != (256|pin) ||
            (c5I2cPinLoad(0x60091AD4+pin*4)&4095) != signal) return false
        index=index+1
    }
    true
}
trusted fun esp32C5I2cBusReleasedOwned(port: int,sda: int,scl: int): bool {
    if (!esp32C5I2cConfiguredPinsMatchOwned(port,sda,scl)) return false
    val mask=int((u32(1)<<u32(sda))|(u32(1)<<u32(scl)))
    if ((c5I2cPinLoad(0x60004008)&16) != 0 || (c5I2cPinLoad(0x60091064)&mask) != mask) return false
    // Standard-mode tBUF4.7us;5us covers the faster supported modes too.
    c5I2cReleasedDelay()
    (c5I2cPinLoad(0x60004008)&16) == 0 && (c5I2cPinLoad(0x60091064)&mask) == mask
}
