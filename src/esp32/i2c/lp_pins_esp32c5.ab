import "./lp_pins_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@export("c5LpI2cPinLoad")
trusted fun c5LpI2cPinLoadHook(address: int): int = mmioLoadU32(address)
@export("c5LpI2cPinStore")
trusted fun c5LpI2cPinStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
