import "./recovery_s3_logic.ab"
import "../sdk/raw_buffer.ab"
fun esp32C5LpI2cRecoveryAddress(index: int): int =
    if (index == 13) 0x600B0428 else if (index >= 0 && index <= 12) 0x600B1800+esp32S3I2cRecoveryOffset(index) else 0
fun esp32C5LpI2cRecoveryMask(index: int): u32 =
    if (index == 13) u32(0x40000000) else if (index == 12) u32(0x2CF) else if (index == 11) u32(0x45EF) else esp32S3I2cRecoveryMask(index)
// EXCLUSIVE SINGLE-MASTER recovery only; NEVER while another master may own
// the bus after arbitration loss. Caller quiesces transfers and serializes
// LP_CLKRST/LPPERI/GPIO changes; source/CPU clocks remain stable. Scratch is caller-owned
// aligned56B RAM, disjoint from all live ownership records. No allocation.
// 1 recovered,7 invalid/mismatched routing,9 reset/init failed,10 lines held.
// Failure must keep transfer admission faulted. No GPIO pulses or STOP.
trusted fun esp32C5LpI2cRecoverOwned(port: int,sda: int,scl: int,scratch: NativeBuffer): int {
    if (port != 0 || sda != 2 || scl != 3 || !scratch.hasAddressRange(0,56) || (scratch.addressValue()&3) != 0 ||
        !c5LpI2cRecoveryPinsMatch(sda,scl)) return 7
    var index=0
    while (index < 14) {
        scratch.storeU32(index*4,c5LpI2cRecoveryLoad(esp32C5LpI2cRecoveryAddress(index))&int(esp32C5LpI2cRecoveryMask(index)))
        index=index+1
    }
    // Restore clock source selected before reset; do not infer its frequency.
    if (!c5LpI2cRecoveryReset((scratch.loadU32(52)>>>30)&1)) return 9
    if (!c5LpI2cRecoveryInitialize()) return 9
    index=0
    while (index < 13) {
        val address=esp32C5LpI2cRecoveryAddress(index)
        val mask=int(esp32C5LpI2cRecoveryMask(index))
        c5LpI2cRecoveryStore(address,(c5LpI2cRecoveryLoad(address)&~mask)|(scratch.loadU32(index*4)&mask))
        index=index+1
    }
    // Explicit config commit; never replay START/FSM_RESET/FIFO_RESET/DONE.
    c5LpI2cRecoveryStore(0x600B1804,c5LpI2cRecoveryLoad(0x600B1804)|2048)
    if (c5LpI2cRecoveryReleased(sda,scl)) 1 else 10
}
