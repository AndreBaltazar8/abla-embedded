import "./lp_teardown_c5_sequence.ab"
import "./lp_release_esp32c5.ab"
import "./lp_clock_esp32c5.ab"
// Don't read an unclocked controller on repeated teardown. Pads still require
// confirmed ownership, and shared LP GPIO clocks are never switched off here.
trusted fun c5LpI2cTeardownBusy(): bool = (mmioLoadU32(0x600B2800)&0x10000000) != 0 && (mmioLoadU32(0x600B1808)&16) != 0
trusted fun c5LpI2cTeardownRelease(): bool = esp32C5LpI2cReleasePinsOwned(0,2,3)
trusted fun c5LpI2cTeardownDisable(): bool = esp32C5LpI2cDisableClockOwned(0)
