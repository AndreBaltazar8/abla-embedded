import "./lp_teardown_c5_sequence.ab"
import "./lp_release_esp32c5.ab"
import "./lp_clock_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
import "abla/unsafe/mmio"
import "./lp_release_c5_sequence.ab"
import "./lp_clock_c5_sequence.ab"
// Don't read an unclocked controller on repeated teardown. Pads still require
// confirmed ownership, and shared LP GPIO clocks are never switched off here.
@export("c5LpI2cTeardownBusy")
trusted fun c5LpI2cTeardownBusyHook(): bool = (mmioLoadU32(0x600B2800)&0x10000000) != 0 && (mmioLoadU32(0x600B1808)&16) != 0
@export("c5LpI2cTeardownRelease")
trusted fun c5LpI2cTeardownReleaseHook(): bool = esp32C5LpI2cReleasePinsOwned(0,2,3)
@export("c5LpI2cTeardownDisable")
trusted fun c5LpI2cTeardownDisableHook(): bool = esp32C5LpI2cDisableClockOwned(0)
