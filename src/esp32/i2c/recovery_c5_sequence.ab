import "./recovery_s3_logic.ab"
import "../sdk/raw_buffer.ab"
fun esp32C5I2cRecoveryAddress(index: int): int =
    if (index == 0) 0x60096024 else if (index >= 1 && index <= 12) 0x60004000+esp32S3I2cRecoveryOffset(index) else 0
fun esp32C5I2cRecoveryMask(index: int): u32 =
    if (index == 0) u32(0x5FFFFF) else if (index == 12) u32(0x3DF) else esp32S3I2cRecoveryMask(index)
// EXCLUSIVE SINGLE-MASTER recovery only; NEVER while another master may own
// the bus after arbitration loss. Caller quiesces transfers and serializes
// PCR/GPIO changes; source/CPU clocks remain stable. Scratch is caller-owned
// aligned52B RAM, disjoint from all live ownership records. No allocation.
// 1 recovered,7 invalid/mismatched routing,9 reset/init failed,10 lines held.
// Failure must keep transfer admission faulted. No GPIO pulses or STOP.
trusted fun esp32C5I2cRecoverOwned(port: int,sda: int,scl: int,scratch: NativeBuffer): int {
    if (port != 0 || !scratch.hasAddressRange(0,52) || (scratch.addressValue()&3) != 0 ||
        !c5I2cRecoveryPinsMatch(sda,scl)) return 7
    var index=0
    while (index < 13) {
        scratch.storeU32(index*4,c5I2cRecoveryLoad(esp32C5I2cRecoveryAddress(index))&int(esp32C5I2cRecoveryMask(index)))
        index=index+1
    }
    // Restore clock source selected before reset; do not infer its frequency.
    if (!c5I2cRecoveryReset((scratch.loadU32(0)>>>20)&1)) return 9
    if (!c5I2cRecoveryInitialize()) return 9
    index=0
    while (index < 13) {
        val address=esp32C5I2cRecoveryAddress(index)
        val mask=int(esp32C5I2cRecoveryMask(index))
        c5I2cRecoveryStore(address,(c5I2cRecoveryLoad(address)&~mask)|(scratch.loadU32(index*4)&mask))
        index=index+1
    }
    // Explicit config commit; never replay START/FSM_RESET/FIFO_RESET/DONE.
    c5I2cRecoveryStore(0x60004004,c5I2cRecoveryLoad(0x60004004)|2048)
    if (c5I2cRecoveryReleased(sda,scl)) 1 else 10
}
