import "../../i2c/software_lines.ab"
import "../gpio_esp32c6.ab"
import "../peripheral_delay_esp32c6.ab"
import "../../hal/esp32_i2c.ab"
@export("softwareI2cDrive")
trusted fun softwareI2cDriveHook(pin: int,released: bool): void { esp32C6GpioWriteOwned(pin,released);return }
trusted fun softwareI2cSample(pin: int): bool = esp32C6GpioReadOwned(pin) == 1
@export("softwareI2cDelay")
trusted fun softwareI2cDelayHook(us: int): void = peripheralRomDelay(us)
