import "./released_c5_sequence.ab"
import "./pins_esp32c5.ab"
import "../peripheral_delay_esp32c5.ab"
trusted fun c5I2cReleasedDelay(): void {
    peripheralDelayMicroseconds(5)
    return
}
trusted fun esp32C5I2cBusReleased(port: int,sda: int,scl: int): bool =
    esp32C5I2cBusReleasedOwned(port,sda,scl)
