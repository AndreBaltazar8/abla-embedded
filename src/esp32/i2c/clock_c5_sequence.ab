// C5 HP I2C0 PCR registers, IDF6 i2c_ll + pcr_reg.h.
// Caller owns idle controller and serializes PCR updates. Reset destroys prior
// controller/FIFO configuration. Pads must already be safe/disconnected.
// Source0 XTAL,1 RC_FAST: caller has enabled/calibrated selected source and
// keeps it stable. No oscillator startup, frequency guessing, or bus recovery.
trusted fun c5I2cClockField(address: int,mask: int,value: int): void {
    c5I2cClockStore(address,(c5I2cClockLoad(address)&~mask)|(value&mask))
    return
}
trusted fun esp32C5I2cResetClockOwned(port: int,source: int): bool {
    if (port != 0 || source < 0 || source > 1) return false
    c5I2cClockField(0x60096024,1<<22,0)
    c5I2cClockField(0x60096020,3,3)
    c5I2cClockField(0x60096020,2,0)
    c5I2cClockField(0x60096024,0x500000,(source<<20)|(1<<22))
    // Acknowledges register state only, not an externally measured clock.
    (c5I2cClockLoad(0x60096020)&3) == 1 &&
        (c5I2cClockLoad(0x60096024)&0x500000) == ((source<<20)|(1<<22))
}
trusted fun esp32C5I2cDisableClockOwned(port: int): bool {
    if (port != 0) return false
    c5I2cClockField(0x60096024,1<<22,0)
    c5I2cClockField(0x60096020,1,0)
    (c5I2cClockLoad(0x60096020)&1) == 0 &&
        (c5I2cClockLoad(0x60096024)&(1<<22)) == 0
}
