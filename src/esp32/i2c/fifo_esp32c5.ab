import "./fifo_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@export("esp32C5I2cFifoRegisterRead")
trusted fun esp32C5I2cFifoRegisterReadHook(address: int): int = mmioLoadU32(address)
@export("esp32C5I2cFifoRegisterWrite")
trusted fun esp32C5I2cFifoRegisterWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
