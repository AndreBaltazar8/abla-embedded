import "./timing_c5_sequence.ab"
// Status1 ready,2 invalid,3 unavailablepads,4 clockfailure,5 controllerfailure,
// 6 timingfailure,7 routingfailure. Bit8 cleanup attempted,bit9 cleanup failed.
// Success means configured registers, not verified bus communication.
type Esp32C5I2cSetup = int
fun Esp32C5I2cSetup.status(): int = this & 255
fun Esp32C5I2cSetup.valid(): bool = this.status() == 1
fun Esp32C5I2cSetup.cleanupAttempted(): bool = (this&256) != 0
fun Esp32C5I2cSetup.cleanupFailed(): bool = (this&512) != 0
trusted fun c5I2cSetupFailure(status: int): Esp32C5I2cSetup =
    Esp32C5I2cSetup(status|256|(if (c5I2cSetupDisable()) 0 else 512))
// Exclusive controller + shared PCR/GPIO ownership must span this call.
// Initial pads must be safe/disconnected, sources already stable/calibrated.
// Preflight before reset, then clock/controller/timing and route pads LAST.
// No pin mutation on any failure: route rejects before its first write.
trusted fun esp32C5I2cSetupOwned(port: int,sda: int,scl: int,source: int,
    sourceHz: u32,busHz: u32,filter: int = 7,pullup: bool = true): Esp32C5I2cSetup {
    val timing=esp32C5I2cTiming(sourceHz,busHz)
    if (port != 0 || source < 0 || source > 1 || filter < 0 || filter > 15 || !timing.valid()) return Esp32C5I2cSetup(2)
    if (!c5I2cSetupPadsAvailable(sda,scl)) return Esp32C5I2cSetup(3)
    if (!c5I2cSetupClock(source)) return c5I2cSetupFailure(4)
    if (!c5I2cSetupController(filter)) return c5I2cSetupFailure(5)
    if (!c5I2cSetupTiming(timing)) return c5I2cSetupFailure(6)
    if (!c5I2cSetupRoute(sda,scl,pullup)) return c5I2cSetupFailure(7)
    Esp32C5I2cSetup(1)
}
