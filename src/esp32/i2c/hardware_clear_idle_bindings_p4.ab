import "./hardware_clear_idle_p4.ab"
import "./clear_idle_bindings_p4.ab"
import "./fsm_reset_p4_sequence.ab"
trusted fun p4HardwareClearIdle(record: NativeBuffer,session: NativeBuffer,budget: u32): int =
    esp32p4I2cClearIdleOwned(record,session,5,1000,budget,true)
trusted fun p4HardwareAbortFailed(session: NativeBuffer,budget: u32): int {
    if (!p4I2cSessionValid(session) || session.loadU32(4) != 3 || session.loadU32(24) != 3 ||
        !p4HardwarePinsReady(session)) return 3
    session.storeU32(4,2)
    val status=esp32p4I2cFsmResetOwned(session.loadU32(20),budget,true)
    // Even successful FSM abort does not prove bus-line/FIFO readiness.
    session.storeU32(4,3);session.storeU32(12,if (status == 1) 0 else status)
    return status
}
