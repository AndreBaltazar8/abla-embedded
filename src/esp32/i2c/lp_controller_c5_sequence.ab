// Reset, clock-enabled LP I2C0 only; caller owns controller and keeps pads
// disconnected/safe. Destroys pending FIFO/IRQ/commands; not a resume helper.
// LP is master-only: preserve reserved master-mode bit4 and clock bit8.
// FIFO depth16 (not HP32); only16 interrupt bits. FORCE_OUT0/1=0 open drain.
trusted fun c5LpI2cControllerField(address: int,mask: int,value: int): void {
    c5LpI2cControllerStore(address,(c5LpI2cControllerLoad(address)&~mask)|(value&mask))
    return
}
trusted fun esp32C5LpI2cInitializeControllerOwned(port: int,filter: int): bool {
    if (port != 0 || filter < 0 || filter > 15) return false
    // MSB-first, no arbitration, RX-full ACK low; preserve sample mode.
    // Clear inherited START/FSM_RESET/UPDATE without writing HP-only fields.
    c5LpI2cControllerField(0x600B1804,0xEEB,0)
    c5LpI2cControllerField(0x600B1818,0x4400,0x4000)
    val fifo=c5LpI2cControllerLoad(0x600B1818)
    c5LpI2cControllerStore(0x600B1818,fifo|12288)
    c5LpI2cControllerStore(0x600B1818,fifo&~12288)
    c5LpI2cControllerField(0x600B1850,1023,if (filter == 0) 0 else filter|(filter<<4)|768)
    c5LpI2cControllerStore(0x600B1828,0)
    c5LpI2cControllerStore(0x600B1824,0xFFFF)
    var index=0
    while (index < 8) {
        c5LpI2cControllerStore(0x600B1858+index*4,8192)
        index=index+1
    }
    c5LpI2cControllerField(0x600B1804,2048,2048)
    true
}
