import "../../peripheral_gate.ab"
import "./stream_esp32s3.ab"

// Gate must be the canonical shared word for this physical controller, used
// by setup/recovery as well. Pads and source clocks must remain configured and
// owned; this does not allocate a controller or establish a shared RCC lock.
// Additional results:9 another caller owns the gate,10 recovery required,
// 11 ownership invariant violated. No error is replaced with success.
trusted fun esp32S3I2cTransferGuarded(gate: PeripheralGate, owner: u32,
    port: int, address: int, output: NativeBuffer, written: int,
    input: NativeBuffer, read: int, budget: u32): int {
    if (!gate.word().valid() || !peripheralOwnerValid(owner) ||
        esp32S3I2cControllerAddress(port) == 0 || address < 0 || address > 127 ||
        !output.hasAddressRange(0, written) || !input.hasAddressRange(0, read) ||
        budget == u32(0) || budget > u32(0x7fffffff)) return 7
    val admission = gate.tryBegin(owner)
    if (admission == 1) return 9
    if (admission == 2) return 10
    if (admission != 0) return 7
    val result = esp32S3I2cTransferOwned(port, address, output, written, input, read, budget)
    // Even BUS_BUSY can arrive from RunBatch after FIFO preloading. Without
    // proof that nothing was queued, every failure must require recovery.
    if (!gate.finish(owner, result == 1)) return 11
    result
}
