import "./guarded_recovery_c5_sequence.ab"
import "./recovery_esp32c5.ab"
import "./clear_esp32c5.ab"
trusted fun c5I2cGuardedRecover(sda: int,scl: int,scratch: NativeBuffer): int = esp32C5I2cRecoverOwned(0,sda,scl,scratch)
trusted fun c5I2cGuardedClear(sda: int,scl: int,budget: u32): bool = esp32C5I2cClearStuckBusOwned(0,sda,scl,budget)
trusted fun esp32C5I2cRecoverGuarded(gate: PeripheralGate,owner: u32,port: int,sda: int,scl: int,
    scratch: NativeBuffer,budget: u32,clearStuck: bool = false): int =
    esp32C5I2cRecoverGuardedOwned(gate,owner,port,sda,scl,scratch,budget,clearStuck)
