import "../soc/gpio_capabilities.ab"

// Normal (HP) controller count; C6's separate LP controller is not a second
// interchangeable master port. Values match ESP-IDF6.0.2 soc_caps.h.
fun EspChip.i2cMasterControllerCount(): int {
    if (this == 1 || this == 2 || this == 3) return 2
    if (this == 4 || this == 5) return 1
    0
}

fun EspChip.i2cMasterConfigurationValid(port: int, sda: int, scl: int): bool =
    port >= 0 && port < this.i2cMasterControllerCount() && sda != scl &&
        this.gpioOutputValid(sda) && this.gpioOutputValid(scl)
