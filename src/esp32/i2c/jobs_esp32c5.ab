import "./jobs_sequence.ab"
import "./stream_esp32c5.ab"
fun i2cJobsFifoBytes(port: int): int = if (esp32C5I2cControllerAddress(port) != 0) 32 else 0
trusted fun i2cJobsCounter(): u32 = esp32C5I2cReadCounter()
trusted fun i2cJobsChunk(port: int,address: int,data: NativeBuffer,count: int,reading: bool,first: bool,finish: bool,continued: bool,started: u32,budget: u32,nackLast: bool): int =
    esp32C5I2cStreamChunkOwned(port,address,data,count,reading,first,finish,continued,started,budget,-1,nackLast)
