import "./jobs_sequence.ab"
import "./stream_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
@export("i2cJobsFifoBytes")
fun i2cJobsFifoBytesHook(port: int): int = if (esp32C5I2cControllerAddress(port) != 0) 32 else 0
@export("i2cJobsCounter")
trusted fun i2cJobsCounterHook(): u32 = esp32C5I2cReadCounter()
@export("i2cJobsChunk")
trusted fun i2cJobsChunkHook(port: int,address: int,data: NativeBuffer,count: int,reading: bool,first: bool,finish: bool,continued: bool,started: u32,budget: u32,nackLast: bool): int =
    esp32C5I2cStreamChunkOwned(port,address,data,count,reading,first,finish,continued,started,budget,-1,nackLast)
