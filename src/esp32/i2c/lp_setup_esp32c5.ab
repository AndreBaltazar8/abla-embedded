import "./lp_setup_c5_sequence.ab"
import "./lp_clock_esp32c5.ab"
import "./lp_controller_esp32c5.ab"
import "./lp_timing_esp32c5.ab"
import "./lp_pins_esp32c5.ab"
trusted fun c5LpI2cSetupPadsAvailable(sda: int,scl: int): bool = esp32C5LpI2cPinsAvailableOwned(0,sda,scl)
trusted fun c5LpI2cSetupClock(source: int): bool = esp32C5LpI2cResetClockOwned(0,source)
trusted fun c5LpI2cSetupController(filter: int): bool = esp32C5LpI2cInitializeControllerOwned(0,filter)
trusted fun c5LpI2cSetupTiming(timing: Esp32C5LpI2cTiming): bool = esp32C5LpI2cConfigureTimingOwned(0,timing)
trusted fun c5LpI2cSetupRoute(sda: int,scl: int,pullup: bool): bool = esp32C5LpI2cRoutePinsOwned(0,sda,scl,pullup)
trusted fun c5LpI2cSetupDisable(): bool = esp32C5LpI2cDisableClockOwned(0)
