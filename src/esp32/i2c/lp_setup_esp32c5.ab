import "./lp_setup_c5_sequence.ab"
import "./lp_clock_esp32c5.ab"
import "./lp_controller_esp32c5.ab"
import "./lp_timing_esp32c5.ab"
import "./lp_pins_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
import "../../hal/esp32_i2c_3.ab"
import "./lp_pins_c5_sequence.ab"
import "./lp_clock_c5_sequence.ab"
import "./lp_controller_c5_sequence.ab"
import "./lp_timing_c5_sequence.ab"
@export("c5LpI2cSetupPadsAvailable")
trusted fun c5LpI2cSetupPadsAvailableHook(sda: int,scl: int): bool = esp32C5LpI2cPinsAvailableOwned(0,sda,scl)
@export("c5LpI2cSetupClock")
trusted fun c5LpI2cSetupClockHook(source: int): bool = esp32C5LpI2cResetClockOwned(0,source)
@export("c5LpI2cSetupController")
trusted fun c5LpI2cSetupControllerHook(filter: int): bool = esp32C5LpI2cInitializeControllerOwned(0,filter)
@export("c5LpI2cSetupTiming")
trusted fun c5LpI2cSetupTimingHook(timing: Esp32C5LpI2cTiming): bool = esp32C5LpI2cConfigureTimingOwned(0,timing)
@export("c5LpI2cSetupRoute")
trusted fun c5LpI2cSetupRouteHook(sda: int,scl: int,pullup: bool): bool = esp32C5LpI2cRoutePinsOwned(0,sda,scl,pullup)
@export("c5LpI2cSetupDisable")
trusted fun c5LpI2cSetupDisableHook(): bool = esp32C5LpI2cDisableClockOwned(0)
