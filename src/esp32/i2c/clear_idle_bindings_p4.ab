import "./clear_idle_p4_sequence.ab"
import "./hardware_recovery_bindings_p4.ab"
trusted fun p4I2cClearIdleAdmission(session: NativeBuffer): bool {
    val port=session.loadU32(20)
    return p4HardwarePinsReady(session) && p4I2cFifoReady(port) && p4I2cIdle(port) &&
        (p4I2cRead(p4I2cBase(port)+32)&u32(32)) == u32(0) &&
        (p4I2cRead(p4I2cBase(port)+40)&u32(0x7ffff)) == u32(0)
}
trusted fun p4I2cClearIdleCapture(session: NativeBuffer,index: int): P4GpioSnapshot {
    val previous=p4I2cPinsSaved(nativeBufferAt(session.addressValue()+32,40),index)
    return esp32p4GpioSnapshotOwned(previous.pin(),if ((previous&(1<<38)) != 0) 3 else 1,true)
}
trusted fun p4I2cClearIdlePrepare(pin: int): bool {
    // Preserve the caller's existing pull choice while switching to GPIO OD.
    val mux=p4GpioRead(4100+pin*4)
    return esp32P4GpioConfigureOwned(pin,true,true,true,true,if ((mux&u32(256)) != u32(0)) 1 else if ((mux&u32(128)) != u32(0)) 2 else 0) == 1
}
trusted fun p4I2cClearIdleRestore(saved: P4GpioSnapshot): bool = saved.restoreOwned(true) == 1
trusted fun p4I2cClearIdleFinish(session: NativeBuffer,budget: u32): int = p4HardwareRecover(session,budget,false)
