import "./session_p4_sequence.ab"
import "./pins_esp32p4.ab"
import "./stream_esp32p4.ab"
import "./controller_esp32p4.ab"
import "./timing_esp32p4.ab"
trusted fun p4I2cSessionClockOpen(port: int,source: int): int = esp32p4I2cClockOpenOwned(port,source,true)|0
trusted fun p4I2cSessionClockClose(token: int): int = P4I2cClock(token).closeOwned(true)|0
trusted fun p4I2cSessionInitialize(port: int,filter: int): int = esp32p4I2cInitializeControllerOwned(port,filter,true)
trusted fun p4I2cSessionTiming(port: int,timing: P4I2cTiming): int = esp32p4I2cConfigureTimingOwned(port,timing,true)
trusted fun p4I2cSessionPinsOpen(r: NativeBuffer,port: int,sda: int,scl: int,pullup: bool,layout: int): int = esp32p4I2cPinsOpenOwned(r,port,sda,scl,pullup,layout,true)
trusted fun p4I2cSessionPinsClose(r: NativeBuffer): int = esp32p4I2cPinsCloseOwned(r,true)
trusted fun p4I2cSessionTransfer(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32p4I2cTransferOwned(port,address,output,written,input,read,budget,true,prefix)
