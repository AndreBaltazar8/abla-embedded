import "./session_p4_sequence.ab"
import "./pins_esp32p4.ab"
import "./stream_esp32p4.ab"
import "./controller_esp32p4.ab"
import "./timing_esp32p4.ab"
import "../../hal/esp32_i2c.ab"
import "./clock_p4_sequence.ab"
import "./controller_p4_sequence.ab"
import "./timing_p4_logic.ab"
import "./timing_p4_sequence.ab"
import "../sdk/raw_buffer.ab"
import "./pins_p4_sequence.ab"
import "./stream_p4_sequence.ab"
import "../sdk/nativebuffer_type.ab"
@export("p4I2cSessionClockOpen")
trusted fun p4I2cSessionClockOpenHook(port: int,source: int): int = esp32p4I2cClockOpenOwned(port,source,true)|0
@export("p4I2cSessionClockClose")
trusted fun p4I2cSessionClockCloseHook(token: int): int = P4I2cClock(token).closeOwned(true)|0
@export("p4I2cSessionInitialize")
trusted fun p4I2cSessionInitializeHook(port: int,filter: int): int = esp32p4I2cInitializeControllerOwned(port,filter,true)
trusted fun p4I2cSessionTiming(port: int,timing: P4I2cTiming): int = esp32p4I2cConfigureTimingOwned(port,timing,true)
@export("p4I2cSessionPinsOpen")
trusted fun p4I2cSessionPinsOpenHook(r: NativeBuffer,port: int,sda: int,scl: int,pullup: bool,layout: int): int = esp32p4I2cPinsOpenOwned(r,port,sda,scl,pullup,layout,true)
@export("p4I2cSessionPinsClose")
trusted fun p4I2cSessionPinsCloseHook(r: NativeBuffer): int = esp32p4I2cPinsCloseOwned(r,true)
@export("p4I2cSessionTransfer")
trusted fun p4I2cSessionTransferHook(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32p4I2cTransferOwned(port,address,output,written,input,read,budget,true,prefix)
