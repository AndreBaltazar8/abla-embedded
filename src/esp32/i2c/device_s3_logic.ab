// Internal scalar descriptors (public device handles index a slot). Generation
// is checked against controller state under ownership before hardware access.
// Generations never wrap: after0x7fffffff the owner must refuse reopening.
fun esp32S3I2cBusKey(port: int, generation: int): int {
    if (port < 0 || port > 1 || generation < 1 || generation > 2147483647) return 0
    (generation << 2) | (port + 1)
}

fun esp32S3I2cBusKeyValid(key: int): bool = key > 0 &&
    (key >>> 33) == 0 && (key >>> 2) != 0 &&
    ((key & 3) == 1 || (key & 3) == 2)

fun esp32S3I2cBusKeyPort(key: int): int = (key & 3) - 1
fun esp32S3I2cBusKeyGeneration(key: int): int = key >>> 2

// valid bit0, port bit1, address bits2..8, frequency bits9..28,
// generation bits29..59. All arguments checked before packing.
fun esp32S3I2cDeviceKey(port: int, address: int, frequency: int, generation: int): int {
    if (esp32S3I2cBusKey(port, generation) == 0 || address < 0 || address > 127 ||
        frequency < 1 || frequency > 1000000) return 0
    1 | (port << 1) | (address << 2) | (frequency << 9) | (generation << 29)
}

fun esp32S3I2cDeviceKeyPort(key: int): int = (key >>> 1) & 1
fun esp32S3I2cDeviceKeyAddress(key: int): int = (key >>> 2) & 127
fun esp32S3I2cDeviceKeyFrequency(key: int): int = (key >>> 9) & 1048575
fun esp32S3I2cDeviceKeyGeneration(key: int): int = (key >>> 29) & 2147483647
fun esp32S3I2cDeviceKeyValid(key: int): bool = key > 0 && (key >>> 60) == 0 &&
    (key & 1) != 0 && esp32S3I2cDeviceKeyGeneration(key) != 0 &&
    esp32S3I2cDeviceKeyFrequency(key) >= 1 && esp32S3I2cDeviceKeyFrequency(key) <= 1000000

fun esp32S3I2cDeviceKeyMatchesBus(device: int, bus: int): bool =
    esp32S3I2cDeviceKeyValid(device) && esp32S3I2cBusKeyValid(bus) &&
    esp32S3I2cDeviceKeyPort(device) == esp32S3I2cBusKeyPort(bus) &&
    esp32S3I2cDeviceKeyGeneration(device) == esp32S3I2cBusKeyGeneration(bus)
