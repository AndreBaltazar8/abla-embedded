import "./lp_timing_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@export("c5LpI2cTimingLoad")
trusted fun c5LpI2cTimingLoadHook(address: int): int = mmioLoadU32(address)
@export("c5LpI2cTimingStore")
trusted fun c5LpI2cTimingStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
