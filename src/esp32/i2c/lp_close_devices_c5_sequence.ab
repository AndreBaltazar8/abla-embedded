import "./lp_devices_c5_sequence.ab"
// expectedEpoch0 is explicit abort of partial setup, never a live bus close.
// Revoke software views before hardware teardown. A teardown failure keeps
// ownership+fault for retry; old handles remain invalid even after recovery.
trusted fun Esp32C5LpI2cBusState.closeDevicesOwned(pool: I2cDeviceSlots,owner: u32,expectedEpoch: int): bool {
    if (!this.devicePoolValid(pool) || !peripheralOwnerValid(owner) || expectedEpoch < 0 || expectedEpoch > 2147483647) return false
    val gate=this.gate()
    val admission=gate.tryBegin(owner)
    if (admission == 1 || admission == 3) return false
    val faulted=admission == 2
    if (faulted && !gate.tryBeginRecovery(owner)) return false
    val buffer=this.buffer()
    val phase=buffer.loadU32(12)
    val matches=if (expectedEpoch == 0) phase == 2 else buffer.loadU32(8) == expectedEpoch && phase != 2
    var closed=false
    var healthy= !faulted
    if (matches) {
        // Pool is dedicated to LP I2C0 (logical descriptor port1). Include stale epochs so all remaining
        // software views are reclaimed, without resetting slot generations.
        if (pool.releaseMatching(3,3) >= 0) {
            closed=phase == 0
            if (!closed) {
                val status=if (phase == 2) c5LpI2cBusAbortSetup() else c5LpI2cBusTeardown(buffer.loadU32(16),buffer.loadU32(20))
                buffer.storeU32(48,status)
                closed=status == 1
                if (closed) buffer.storeU32(12,0)
            }
            healthy=closed
        }
    }
    val released=if (faulted) gate.finishRecovery(owner,healthy) else gate.finish(owner,healthy)
    closed && released
}
