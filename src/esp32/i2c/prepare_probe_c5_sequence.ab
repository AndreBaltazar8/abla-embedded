import "./bus_io_c5_sequence.ab"
// Explicit SINGLE-MASTER probe boundary. Caller excludes other masters,
// shared clock/pad writers. Does not retry the failed transfer,
// generate GPIO pulses, or clear arbitrary faults. Call before a new candidate.
// Healthy live buses are left unchanged; only a prior NACK may be recovered.
trusted fun Esp32C5I2cBusState.prepareProbeOwned(epoch: int,owner: u32,scratch: NativeBuffer): int {
    if (!this.valid() || !peripheralOwnerValid(owner) || epoch <= 0 || epoch > 2147483647 ||
        !scratch.hasAddressRange(0,52) || (scratch.addressValue()&3) != 0 || this.overlaps(scratch,52)) return 7
    val gate=this.gate()
    val admission=gate.tryBegin(owner)
    if (admission == 1) return 9
    if (admission == 3) return 7
    val faulted=admission == 2
    if (faulted && !gate.tryBeginRecovery(owner)) return 9
    var result=7
    var healthy= !faulted
    if (this.matches(epoch)) {
        result=if (faulted) 10 else 1
        // Check the cause under the same gate as recovery, not before locking.
        if (faulted && this.buffer().loadU32(48) == 3) {
            result=c5I2cBusRecover(this.buffer().loadU32(16),this.buffer().loadU32(20),scratch)
            this.buffer().storeU32(48,result)
            healthy=result == 1
        }
    }
    val released=if (faulted) gate.finishRecovery(owner,healthy) else gate.finish(owner,healthy)
    if (!released) return 11
    result
}
