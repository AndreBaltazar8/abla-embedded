import "./software_bus_c61_sequence.ab"
import "../gpio_c61_sequence.ab"
trusted fun c61SoftwareI2cReady(sda: int,scl: int): bool {
    val pins=(u32(1)<<u32(sda))|(u32(1)<<u32(scl))
    if ((c61GpioRead(0x600960c0)&u32(3)) != u32(1) ||
        (c61GpioRead(0x600960c4)&u32(0x400000)) == u32(0) ||
        ((c61GpioRead(0x600960c4)>>u32(20))&u32(3)) == u32(3) ||
        (c61GpioRead(0x60091df8)&u32(1)) == u32(0) ||
        (c61GpioRead(0x60091034)&pins) != u32(0) ||
        (c61GpioRead(0x600b102c)&pins) != u32(0) ||
        (c61GpioRead(0x600b1028)&pins&u32(127)) != u32(0)) return false
    return ((pins&u32(0x3000)) == u32(0)) || (c61GpioRead(0x6000f018)&u32(16384)) == u32(0)
}
trusted fun c61SoftwareI2cConfigure(pin: int,enabled: bool): bool =
    esp32C61GpioConfigureOwned(pin,enabled,true,true,true,0,true) == 1
