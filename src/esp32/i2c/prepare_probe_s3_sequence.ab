import "../../peripheral_gate.ab"
import "../sdk/raw_buffer.ab"
import "./device_s3_logic.ab"
// State belongs to key's physical port:36B gate/epoch/phase/pins/clocks/last.
// Explicit exclusive SINGLE-MASTER boundary, no GPIO pulses or transfer retry.
trusted fun esp32S3I2cPrepareProbeOwned(state: int,key: int,owner: u32): int {
    if (!nativeBufferAt(state,36).hasAddressRange(0,36) || (state&3) != 0 ||
        !esp32S3I2cBusKeyValid(key) || !peripheralOwnerValid(owner)) return 7
    val gate=peripheralGateAt(state)
    val admission=gate.tryBegin(owner)
    if (admission == 1) return 9
    if (admission == 3) return 7
    val faulted=admission == 2
    if (faulted && !gate.tryBeginRecovery(owner)) return 9
    var result=7
    var healthy= !faulted
    if (nativeAddressLoadU32(state,8) == 1 && nativeAddressLoadU32(state,4) == esp32S3I2cBusKeyGeneration(key)) {
        result=if (faulted) 10 else 1
        if (faulted && nativeAddressLoadU32(state,32) == 3) {
            result=s3PrepareProbeRecover(state,esp32S3I2cBusKeyPort(key),owner)
            nativeAddressStoreU32(state,32,result)
            healthy=result == 1
        }
    }
    val released=if (faulted) gate.finishRecovery(owner,healthy) else gate.finish(owner,healthy)
    if (!released) return 11
    result
}
