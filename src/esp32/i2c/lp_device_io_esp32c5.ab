import "./lp_device_io_c5_sequence.ab"
import "./lp_bus_esp32c5.ab"
import "./lp_stream_esp32c5.ab"
import "./lp_timing_esp32c5.ab"
trusted fun c5LpI2cDeviceIdle(): bool {
    val status=u32(mmioLoadU32(0x600B1808))
    (status&u32(16)) == u32(0) && esp32C5LpI2cTxCount(status) == 0 && esp32C5LpI2cRxCount(status) == 0
}
trusted fun c5LpI2cDeviceTiming(timing: u32): bool = esp32C5LpI2cConfigureTimingOwned(0,Esp32C5LpI2cTiming(timing))
trusted fun c5LpI2cDeviceTransfer(address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32C5LpI2cTransferOwned(0,address,output,written,input,read,budget,prefix)
