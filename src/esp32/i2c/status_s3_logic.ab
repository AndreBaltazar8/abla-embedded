// 0 pending, 1 STOP/transaction complete, 2 END (bus retained), 3 NACK,
// 4 arbitration lost, 5 timeout, 6 FIFO error, 7 invalid, 8 bus busy.
// Error precedence follows S3 LL; extra FIFO/state-timeout flags must never
// be mistaken for a successful transfer when completion is also asserted.
fun esp32S3I2cPollResult(raw: u32, expectStop: bool): int {
    if ((raw & u32(32)) != u32(0)) return 4
    if ((raw & u32(1024)) != u32(0)) return 3
    if ((raw & u32(0x6100)) != u32(0)) return 5
    if ((raw & u32(0x1844)) != u32(0)) return 6
    if ((raw & u32(128)) != u32(0)) return 1
    if (!expectStop && (raw & u32(8)) != u32(0)) return 2
    0
}

fun esp32S3I2cDeadlineExpired(start: u32, now: u32, budget: u32): bool =
    now - start >= budget
