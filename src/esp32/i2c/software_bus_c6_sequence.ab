import "../../i2c/software_lines.ab"
import "../../i2c/software_transfer.ab"
// Retained scalar owner of two initially safed pads, not snapshots of a live
// previous peripheral. Caller pins clocks/calibrated ROM delay, serializes
// all transactions/lifecycle and keeps external pullups available. Closing
// releases pad outputs; it never gates shared clocks. Keep returned state.
// Layout matches common line view46bits, status8@48, SDA/SCLownership56/57.
// Status0closed1ready2invalid3admission4SDAsetup5SCLsetup6busy7SDAclose
// 8SCLclose10recoveryClockTimeout. Failed writes retain attempted ownership.
type Esp32C6SoftwareI2cBus=int
fun Esp32C6SoftwareI2cBus.lines(): SoftwareI2cLines = SoftwareI2cLines(this&70368744177663)
fun Esp32C6SoftwareI2cBus.status(): int = (this>>>48)&255
fun Esp32C6SoftwareI2cBus.ownsSda(): bool = (this&(1<<56)) != 0
fun Esp32C6SoftwareI2cBus.ownsScl(): bool = (this&(1<<57)) != 0
fun Esp32C6SoftwareI2cBus.ready(): bool = this.status() == 1 && this.ownsSda() && this.ownsScl()
trusted fun esp32C6SoftwareI2cOpenOwned(sda: int,scl: int,halfPeriodUs: int,stretchPolls: int,exclusive: bool): Esp32C6SoftwareI2cBus {
    val lines=softwareI2cLines(sda,scl,halfPeriodUs,stretchPolls)
    if (!lines.valid() || sda >= 31 || scl >= 31) return Esp32C6SoftwareI2cBus(2<<48)
    if (!exclusive || !c6SoftwareI2cReady(sda,scl)) return Esp32C6SoftwareI2cBus((lines|0)|(3<<48))
    var state=(lines|0)|(1<<56)
    if (!c6SoftwareI2cConfigure(sda,true)) return Esp32C6SoftwareI2cBus(state|(4<<48))
    state=state|(1<<57)
    if (!c6SoftwareI2cConfigure(scl,true)) return Esp32C6SoftwareI2cBus(state|(5<<48))
    var remaining=stretchPolls
    while (remaining > 0) {
        if (softwareI2cSample(scl) && softwareI2cSample(sda)) return Esp32C6SoftwareI2cBus(state|(1<<48))
        softwareI2cDelay(1);remaining=remaining-1
    }
    return Esp32C6SoftwareI2cBus(state|(6<<48))
}
trusted fun Esp32C6SoftwareI2cBus.closeOwned(): Esp32C6SoftwareI2cBus {
    var state=this&(70368744177663|(1<<56)|(1<<57))
    if (this.ownsSda()) {
        if (!c6SoftwareI2cConfigure(this.lines().sda(),false)) return Esp32C6SoftwareI2cBus(state|(7<<48))
        state=state&~(1<<56)
    }
    if (this.ownsScl()) {
        if (!c6SoftwareI2cConfigure(this.lines().scl(),false)) return Esp32C6SoftwareI2cBus(state|(8<<48))
        state=state&~(1<<57)
    }
    return Esp32C6SoftwareI2cBus(0)
}
// Explicit single-master consent; never recover automatically after loss of
// arbitration. Partial setup/close is not eligible for recovery clock pulses.
trusted fun Esp32C6SoftwareI2cBus.recoverOwned(clearStuck: bool = false): Esp32C6SoftwareI2cBus {
    if (!this.ownsSda() || !this.ownsScl() || !this.lines().valid() || this.lines().sda() >= 31 || this.lines().scl() >= 31 ||
        (this.status() != 1 && this.status() != 6 && this.status() != 10)) return this
    val raw=this.lines().recoverOwned(clearStuck)
    return Esp32C6SoftwareI2cBus((this&~(255<<48))|((if (raw == 1) 1 else if (raw == 3) 10 else 6)<<48))
}
trusted fun Esp32C6SoftwareI2cBus.transfer(address: int,tx: NativeBuffer,txLength: int,rx: NativeBuffer,rxLength: int,prefix: int = -1): SoftwareI2cTransfer =
    if (this.ready()) this.lines().transfer(address,tx,txLength,rx,rxLength,prefix) else SoftwareI2cTransfer(2)
