// ESP-IDF6 C5 i2c_ll.h, lpperi_reg.h and lp_clkrst_reg.h.
// Caller exclusively owns LP-I2C (including against LP CPU/ULP), idle safe
// pads, and serializes shared LPPERI/LP_CLKRST register updates.
// Source0 LP_FAST,1 XTAL/2. This differs from HP source encoding. Caller
// provides/enables the stable source; no oscillator or low-power policy here.
trusted fun c5LpI2cClockField(address: int,mask: int,value: int): void {
    c5LpI2cClockStore(address,(c5LpI2cClockLoad(address)&~mask)|(value&mask))
    return
}
trusted fun esp32C5LpI2cResetClockOwned(port: int,source: int): bool {
    if (port != 0 || source < 0 || source > 1) return false
    c5LpI2cClockField(0x600B2800,0x10000000,0x10000000)
    c5LpI2cClockField(0x600B2804,0x10000000,0x10000000)
    c5LpI2cClockField(0x600B0428,0x40000000,source<<30)
    c5LpI2cClockField(0x600B2804,0x10000000,0)
    // Register readback only; failure retains ownership for explicit cleanup.
    (c5LpI2cClockLoad(0x600B2800)&0x10000000) != 0 &&
        (c5LpI2cClockLoad(0x600B2804)&0x10000000) == 0 &&
        (c5LpI2cClockLoad(0x600B0428)&0x40000000) == (source<<30)
}
trusted fun esp32C5LpI2cDisableClockOwned(port: int): bool {
    if (port != 0) return false
    c5LpI2cClockField(0x600B2800,0x10000000,0)
    (c5LpI2cClockLoad(0x600B2800)&0x10000000) == 0
}
