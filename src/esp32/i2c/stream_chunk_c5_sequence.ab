import "./stream_s3_logic.ab"
import "../sdk/raw_buffer.ab"
// Implementation boundary for TransferOwned; same exclusive-owner contract.
trusted fun esp32C5I2cStreamChunkOwned(port: int, address: int,
    data: NativeBuffer, count: int, reading: bool, first: bool, finish: bool,
    continued: bool, started: u32, budget: u32, registerPrefix: int = -1,nackLast: bool = false): int {
    val base = esp32C5I2cControllerAddress(port)
    if (count < 0 || count > 32 || registerPrefix < -1 || registerPrefix > 255 ||
        (registerPrefix >= 0 && (reading || !first))) return 7
    val commandCount = count + (if (registerPrefix >= 0) 1 else 0)
    val last = esp32S3I2cStreamLast(reading, first, finish, commandCount,nackLast)
    if (base == 0 || address < 0 || address > 127 || last < 0 ||
        !data.hasAddressRange(0, count) || budget == u32(0) ||
        budget > u32(0x7fffffff)) return 7
    var elapsed = esp32C5I2cReadCounter() - started
    if (elapsed >= budget) return 5
    val status = u32(c5I2cStreamLoad(base + 8))
    if (!continued && (status & u32(16)) != u32(0)) return 8
    if (esp32C5I2cTxCount(status) != 0 || esp32C5I2cRxCount(status) != 0) return 6
    var index = u32(0)
    while (index <= u32(last)) {
        if (!esp32C5I2cWriteCommand(port, int(index),
            esp32S3I2cStreamCommand(reading, first, finish, commandCount, int(index),nackLast))) return 7
        index = index + u32(1)
    }
    if (first) c5I2cStreamStore(base + 0x1c, (address << 1) | (if (reading) 1 else 0))
    if (registerPrefix >= 0) c5I2cStreamStore(base + 0x1c, registerPrefix)
    if (!reading && !esp32C5I2cWriteFifo(port, data, count)) return 6
    elapsed = esp32C5I2cReadCounter() - started
    if (elapsed >= budget) return 5
    val result = esp32C5I2cRunBatch(port, last, budget - elapsed, continued)
    if (result != (if (finish) 1 else 2)) return result
    val completed = u32(c5I2cStreamLoad(base + 8))
    if (esp32C5I2cTxCount(completed) != 0 ||
        esp32C5I2cRxCount(completed) != (if (reading) count else 0)) return 6
    if (reading && !esp32C5I2cReadFifo(port, data, count)) return 6
    result
}
