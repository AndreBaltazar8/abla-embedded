import "./recovery_c5_sequence.ab"
import "./clock_esp32c5.ab"
import "./controller_esp32c5.ab"
import "./released_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
@export("c5I2cRecoveryPinsMatch")
trusted fun c5I2cRecoveryPinsMatchHook(sda: int,scl: int): bool = esp32C5I2cConfiguredPinsMatchOwned(0,sda,scl)
@export("c5I2cRecoveryLoad")
trusted fun c5I2cRecoveryLoadHook(address: int): int = mmioLoadU32(address)
@export("c5I2cRecoveryStore")
trusted fun c5I2cRecoveryStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
@export("c5I2cRecoveryReset")
trusted fun c5I2cRecoveryResetHook(source: int): bool = esp32C5I2cResetClock(0,source)
@export("c5I2cRecoveryInitialize")
trusted fun c5I2cRecoveryInitializeHook(): bool = esp32C5I2cInitializeController(0,0)
@export("c5I2cRecoveryReleased")
trusted fun c5I2cRecoveryReleasedHook(sda: int,scl: int): bool = esp32C5I2cBusReleased(0,sda,scl)
