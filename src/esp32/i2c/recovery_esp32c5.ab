import "./recovery_c5_sequence.ab"
import "./clock_esp32c5.ab"
import "./controller_esp32c5.ab"
import "./released_esp32c5.ab"
trusted fun c5I2cRecoveryPinsMatch(sda: int,scl: int): bool = esp32C5I2cConfiguredPinsMatchOwned(0,sda,scl)
trusted fun c5I2cRecoveryLoad(address: int): int = mmioLoadU32(address)
trusted fun c5I2cRecoveryStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun c5I2cRecoveryReset(source: int): bool = esp32C5I2cResetClock(0,source)
trusted fun c5I2cRecoveryInitialize(): bool = esp32C5I2cInitializeController(0,0)
trusted fun c5I2cRecoveryReleased(sda: int,scl: int): bool = esp32C5I2cBusReleased(0,sda,scl)
