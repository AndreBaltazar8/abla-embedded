import "./lp_release_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@export("c5LpI2cReleaseLoad")
trusted fun c5LpI2cReleaseLoadHook(address: int): int = mmioLoadU32(address)
@export("c5LpI2cReleaseStore")
trusted fun c5LpI2cReleaseStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
