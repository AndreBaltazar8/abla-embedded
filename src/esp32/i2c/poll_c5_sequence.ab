import "./fifo_c5_sequence.ab"
import "./status_s3_logic.ab"
// C5 raw interrupt bits match S3; reuse pure precedence/deadline arithmetic.
fun esp32C5I2cPollResult(raw: u32,expectStop: bool): int = esp32S3I2cPollResult(raw,expectStop)
fun esp32C5I2cDeadlineExpired(start: u32,now: u32,budget: u32): bool = esp32S3I2cDeadlineExpired(start,now,budget)
trusted fun c5I2cPollField(address: int,mask: u32,value: u32): void {
    c5I2cPollStore(address,int((u32(c5I2cPollLoad(address))&~mask)|(value&mask)))
    return
}
// Execute one fully queued, <=32-byte TX/RX command batch. Controller, FIFO,
// clock frequency and bus ownership must remain exclusive/stable throughout.
// Continuation is allowed only after this owner's preceding END result.
// On any error caller must perform recovery before reusing the controller;
// notably we must NOT generate STOP after losing arbitration to another master.
trusted fun esp32C5I2cRunBatch(port: int, lastCommand: int,
    timeoutCycles: u32, continuation: bool = false): int {
    val base = esp32C5I2cControllerAddress(port)
    if (base == 0 || lastCommand < 0 || lastCommand >= 8 ||
        timeoutCycles == u32(0) || timeoutCycles > u32(0x7fffffff)) return 7
    var index = 0
    var writeCount = 0
    var readCount = 0
    var terminal = 0
    while (index <= lastCommand) {
        val command = u32(c5I2cPollLoad(base + 0x58 + index * 4))
        if (!esp32C5I2cCommandValid(command)) return 7
        val operation = int((command >>> u32(11)) & u32(7))
        val count = int(command & u32(255))
        if (operation == 1) writeCount = writeCount + count
        if (operation == 3) readCount = readCount + count
        if (index < lastCommand && (operation == 2 || operation == 4)) return 7
        if (index == lastCommand) terminal = operation
        index = index + 1
    }
    if ((terminal != 2 && terminal != 4) || writeCount > 32 || readCount > 32) return 7
    val status = u32(c5I2cPollLoad(base + 8))
    if (!continuation && (status & u32(16)) != u32(0)) return 8
    if (esp32C5I2cTxCount(status) != writeCount || esp32C5I2cRxCount(status) != 0) return 7
    c5I2cPollStore(base + 0x24, 0x3ffff)
    val start = esp32C5I2cReadCounter()
    c5I2cPollField(base + 4, u32(2048), u32(2048))
    c5I2cPollField(base + 4, u32(32), u32(32))
    while (true) {
        val result = esp32C5I2cPollResult(u32(c5I2cPollLoad(base + 0x20)), terminal == 2)
        if (result >= 3) return result
        if (result != 0 && (u32(c5I2cPollLoad(base + 0x58 + lastCommand * 4)) & u32(0x80000000)) != u32(0)) return result
        if (esp32C5I2cDeadlineExpired(start, esp32C5I2cReadCounter(), timeoutCycles)) return 5
    }
    return 5
}
