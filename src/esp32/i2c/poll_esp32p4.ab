import "./poll_p4_sequence.ab"
import "./clock_esp32p4.ab"
import "../../hal/esp32_i2c.ab"
trusted noescape extern:"inline-assembly" fun p4I2cCounterInstruction(template: string,constraints: string): u32
@export("p4I2cCounter")
trusted fun p4I2cCounterHook(): u32 = p4I2cCounterInstruction("csrr $0, mcycle","=r,~{memory}")
