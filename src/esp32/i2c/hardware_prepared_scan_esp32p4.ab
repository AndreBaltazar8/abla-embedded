import "./hardware_prepared_scan_p4.ab"
import "./hardware_recovery_esp32p4.ab"
import "./hardware_scan_esp32p4.ab"
trusted fun p4HardwareProbeReady(r: NativeBuffer): bool {
    val port=r.loadU32(20)
    if (r.loadU32(24) != 3 || !p4HardwarePinsReady(r) || !p4I2cFifoReady(port) || !p4I2cIdle(port)) return false
    val status=p4I2cRead(p4I2cBase(port)+8)
    val pins=nativeBufferAt(r.addressValue()+32,40)
    return esp32S3I2cTxCount(status) == 0 && esp32S3I2cRxCount(status) == 0 &&
        p4I2cRecoveryLinesHigh(p4I2cPinsSaved(pins,1).pin(),p4I2cPinsSaved(pins,0).pin())
}
