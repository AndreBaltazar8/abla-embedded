import "./lp_bus_io_c5_sequence.ab"
import "./lp_bus_esp32c5.ab"
import "./lp_stream_esp32c5.ab"
import "./lp_recovery_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
@export("c5LpI2cBusTransfer")
trusted fun c5LpI2cBusTransferHook(address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32C5LpI2cTransferOwned(0,address,output,written,input,read,budget,prefix)
@export("c5LpI2cBusRecover")
trusted fun c5LpI2cBusRecoverHook(sda: int,scl: int,scratch: NativeBuffer): int = esp32C5LpI2cRecoverOwned(0,sda,scl,scratch)
