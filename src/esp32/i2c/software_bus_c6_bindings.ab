import "./software_bus_c6_sequence.ab"
import "../gpio_c6_sequence.ab"
trusted fun c6SoftwareI2cReady(sda: int,scl: int): bool {
    if (!esp32C6GpioNumberValid(sda) || !esp32C6GpioNumberValid(scl) || sda == scl) return false
    val pins=(u32(1)<<u32(sda))|(u32(1)<<u32(scl))
    if ((c6GpioRead(0x600960e8)&u32(3)) != u32(1) ||
        (c6GpioRead(0x600960ec)&u32(0x400000)) == u32(0) ||
        ((c6GpioRead(0x600960ec)>>u32(20))&u32(3)) == u32(0) ||
        (c6GpioRead(0x6009162c)&u32(1)) == u32(0) ||
        (c6GpioRead(0x60091020)&pins) != u32(0) ||
        (c6GpioRead(0x600b102c)&pins) != u32(0) ||
        (c6GpioRead(0x600b1028)&pins&u32(255)) != u32(0)) return false
    return ((pins&u32(0x3000)) == u32(0)) || (c6GpioRead(0x6000f018)&u32(16384)) == u32(0)
}
trusted fun c6SoftwareI2cConfigure(pin: int,enabled: bool): bool =
    esp32C6GpioConfigureOwned(pin,enabled,true,true,true,0,true) == 1
