// Owned, idle LP-I2C only. Caller excludes LP CPU/ULP/shared GPIO writers and
// has released global hold. Leaves pads as floating LP GPIO inputs; does NOT
// select digital routing, which could expose stale HP peripheral outputs.
trusted fun esp32C5LpI2cReleasePinsOwned(port: int,sda: int,scl: int): bool {
    if (port != 0 || sda != 2 || scl != 3) return false
    if ((c5LpI2cReleaseLoad(0x600B102C)&12) != 0 ||
        (c5LpI2cReleaseLoad(0x600B1028)&12) != 12 ||
        (c5LpI2cReleaseLoad(0x600B2800)&0x08000000) == 0 ||
        (c5LpI2cReleaseLoad(0x600B47F8)&1) == 0) return false
    val sdaMux=c5LpI2cReleaseLoad(0x600B4008)
    val sclMux=c5LpI2cReleaseLoad(0x600B400C)
    val enabled=c5LpI2cReleaseLoad(0x600B4410)
    // Accept previously released pads too, so clock-shutdown failure can retry.
    val sdaMatches=(sdaMux&0x7202) == 0x3200 || (sdaMux&0x7382) == 0x1200 && (enabled&4) == 0
    val sclMatches=(sclMux&0x7202) == 0x3200 || (sclMux&0x7382) == 0x1200 && (enabled&8) == 0
    if (!sdaMatches || !sclMatches) return false
    c5LpI2cReleaseStore(0x600B4418,12)
    c5LpI2cReleaseStore(0x600B4008,(sdaMux&~0x7382)|0x1200)
    c5LpI2cReleaseStore(0x600B400C,(sclMux&~0x7382)|0x1200)
    true
}
