// C5 HP GPIO matrix: SCL46/SDA47, input selection bit8 (NOT S3 bit7).
// Caller owns both pads, controller idle/configured open-drain, PCR/GPIO
// updates serialized, global force-hold released. Must not claim flash/PSRAM
// pins in use. USB13/14 deliberately unsupported pending USB ownership adapter.
fun esp32C5I2cPadValid(pin: int): bool = pin >= 0 && pin <= 28 && pin != 13 && pin != 14
trusted fun c5I2cPinField(address: int,mask: int,value: int): void {
    c5I2cPinStore(address,(c5I2cPinLoad(address)&~mask)|(value&mask))
    return
}
trusted fun esp32C5I2cPinsAvailableOwned(port: int,sda: int,scl: int): bool {
    if (port != 0 || sda == scl || !esp32C5I2cPadValid(sda) || !esp32C5I2cPadValid(scl)) return false
    val mask=int((u32(1)<<u32(sda))|(u32(1)<<u32(scl)))
    if ((c5I2cPinLoad(0x600B102C)&mask) != 0) return false
    // Do not take pads away from an LP owner. Caller explicitly releases them.
    val lpMask=mask&127
    if (lpMask != 0 && (c5I2cPinLoad(0x600B1028)&lpMask) != 0) return false
    true
}
trusted fun esp32C5I2cRoutePinsOwned(port: int,sda: int,scl: int,pullup: bool): bool {
    if (!esp32C5I2cPinsAvailableOwned(port,sda,scl)) return false
    val mask=int((u32(1)<<u32(sda))|(u32(1)<<u32(scl)))
    c5I2cPinStore(0x6009103C,mask)
    c5I2cPinStore(0x60091008,mask)
    var index=0
    while (index < 2) {
        val pin=if (index == 0) scl else sda
        val signal=46+index
        c5I2cPinField(0x600910D4+pin*4,4,4)
        c5I2cPinField(0x60090000+pin*4,0x7382,0x1200|(if (pullup) 256 else 0))
        c5I2cPinField(0x600912D4+signal*4,511,256|pin)
        // Use peripheral output-enable; pad open-drain also prevents driving
        // high. Clear inherited output/enable inversion and GPIO-OE override.
        c5I2cPinField(0x60091AD4+pin*4,4095,signal)
        index=index+1
    }
    c5I2cPinStore(0x60091038,mask)
    true
}
// Exclusive idle-bus teardown, not arbitration-loss recovery. Release outputs
// before removing input routes; leave pads digital inputs without internal
// pulls, and route controller inputs to constant high. No clock changes.
trusted fun esp32C5I2cReleasePinsOwned(port: int,sda: int,scl: int): bool {
    if (!esp32C5I2cPinsAvailableOwned(port,sda,scl)) return false
    val mask=int((u32(1)<<u32(sda))|(u32(1)<<u32(scl)))
    c5I2cPinStore(0x6009103C,mask)
    var index=0
    while (index < 2) {
        val pin=if (index == 0) scl else sda
        c5I2cPinField(0x60091AD4+pin*4,4095,1280)
        c5I2cPinField(0x60090000+pin*4,0x7382,0x1200)
        c5I2cPinField(0x600912D4+(46+index)*4,511,320)
        index=index+1
    }
    true
}
