import "./fifo_sequence_esp32s3.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@inline
@export("esp32S3I2cFifoRegisterRead")
trusted fun esp32S3I2cFifoRegisterReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3I2cFifoRegisterWrite")
trusted fun esp32S3I2cFifoRegisterWriteHook(address: int, value: int): void {
    mmioStoreU32(address,value)
    return
}
