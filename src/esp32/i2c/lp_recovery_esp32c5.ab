import "./lp_recovery_c5_sequence.ab"
import "./lp_clock_esp32c5.ab"
import "./lp_controller_esp32c5.ab"
import "./lp_released_esp32c5.ab"
trusted fun c5LpI2cRecoveryPinsMatch(sda: int,scl: int): bool = esp32C5LpI2cConfiguredPinsMatchOwned(0,sda,scl)
trusted fun c5LpI2cRecoveryLoad(address: int): int = mmioLoadU32(address)
trusted fun c5LpI2cRecoveryStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun c5LpI2cRecoveryReset(source: int): bool = esp32C5LpI2cResetClockOwned(0,source)
trusted fun c5LpI2cRecoveryInitialize(): bool = esp32C5LpI2cInitializeControllerOwned(0,0)
trusted fun c5LpI2cRecoveryReleased(sda: int,scl: int): bool = esp32C5LpI2cBusReleasedOwned(0,sda,scl)
