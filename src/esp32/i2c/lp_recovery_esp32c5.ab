import "./lp_recovery_c5_sequence.ab"
import "./lp_clock_esp32c5.ab"
import "./lp_controller_esp32c5.ab"
import "./lp_released_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
@export("c5LpI2cRecoveryPinsMatch")
trusted fun c5LpI2cRecoveryPinsMatchHook(sda: int,scl: int): bool = esp32C5LpI2cConfiguredPinsMatchOwned(0,sda,scl)
@export("c5LpI2cRecoveryLoad")
trusted fun c5LpI2cRecoveryLoadHook(address: int): int = mmioLoadU32(address)
@export("c5LpI2cRecoveryStore")
trusted fun c5LpI2cRecoveryStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
@export("c5LpI2cRecoveryReset")
trusted fun c5LpI2cRecoveryResetHook(source: int): bool = esp32C5LpI2cResetClockOwned(0,source)
@export("c5LpI2cRecoveryInitialize")
trusted fun c5LpI2cRecoveryInitializeHook(): bool = esp32C5LpI2cInitializeControllerOwned(0,0)
@export("c5LpI2cRecoveryReleased")
trusted fun c5LpI2cRecoveryReleasedHook(sda: int,scl: int): bool = esp32C5LpI2cBusReleasedOwned(0,sda,scl)
