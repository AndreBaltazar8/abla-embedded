import "./poll_esp32s3.ab"
import "./transfer_s3_logic.ab"

// Synchronous, allocation-free single-FIFO operation on an exclusively owned,
// configured, idle controller. No clock/ownership acquisition is implicit.
// Return codes match RunBatch. On errors the owner must recover before reuse;
// this layer must not send STOP after another master wins arbitration.
// Large transfers belong in a streaming layer, not silently truncated here.
trusted fun esp32S3I2cSmallTransferOwned(port: int, address: int,
    output: NativeBuffer, written: int, input: NativeBuffer, read: int,
    timeoutCycles: u32): int {
    val base = esp32S3I2cControllerAddress(port)
    if (base == 0 || !esp32S3I2cSmallTransferValid(address, written, read) ||
        !output.hasAddressRange(0, written) || !input.hasAddressRange(0, read) ||
        timeoutCycles == u32(0) || timeoutCycles > u32(0x7fffffff)) return 7
    val status = u32(mmioLoadU32(base + 8))
    if ((status & u32(16)) != u32(0)) return 8
    // Refuse stale FIFO data rather than silently discarding another operation.
    if (esp32S3I2cTxCount(status) != 0 || esp32S3I2cRxCount(status) != 0) return 7
    val last = esp32S3I2cSmallTransferLast(written, read)
    var index = 0
    while (index <= last) {
        if (!esp32S3I2cWriteCommand(port, index,
            esp32S3I2cSmallTransferCommand(written, read, index))) return 7
        index = index + 1
    }
    mmioStoreU32(base + 0x1c, (address << 1) |
        (if (written == 0 && read > 0) 1 else 0))
    if (!esp32S3I2cWriteFifo(port, output, written)) return 7
    if (written > 0 && read > 0) mmioStoreU32(base + 0x1c, (address << 1) | 1)
    val result = esp32S3I2cRunBatch(port, last, timeoutCycles)
    if (result != 1) return result
    // Completion must account for every requested byte, not just the IRQ.
    val completed = u32(mmioLoadU32(base + 8))
    if (esp32S3I2cTxCount(completed) != 0 ||
        esp32S3I2cRxCount(completed) != read) return 6
    if (!esp32S3I2cReadFifo(port, input, read)) return 6
    1
}
