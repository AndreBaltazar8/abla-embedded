import "./hardware_provider_p4.ab"
import "./jobs_sequence.ab"
// Addressed multi-device phases under ONE provider lock and selected bus
// frequency. All addressed devices must support that frequency. Unlike a
// device handle, the job table carries each phase's address explicitly.
// Caller owns immutable table/payloads throughout. No allocation or replay.
// Status family matches transferStatus; raw failure retained in session.
trusted fun I2cBus.runJobsStatus(jobs: NativeBuffer,count: int,frequency: int = 400000,timeoutMilliseconds: int = 1000): int {
    if (!this.valid() || count < 1 || count > 64 || !jobs.hasAddressRange(0,count*16) ||
        frequency < 1000 || frequency > 400000 || timeoutMilliseconds < 1 || timeoutMilliseconds > 1000000) return 2
    if (!p4HardwareEnter()) return 4
    var result=2
    if (this.current() && p4HardwareSafe(jobs,count*16) && i2cJobsValid(jobs,count)) {
        var safe=true;var i=0
        while (i < count) {
            val bytes=jobs.loadU32(i*16+4)
            if (!p4HardwareSafe(nativeBufferAt(jobs.loadU32(i*16+8),bytes),bytes)) safe=false
            i=i+1
        }
        val r=p4HardwareSession()
        val perMs=(u32(p4HardwareLoad(16))+u32(999))/u32(1000)
        val timing=esp32p4I2cTiming(u32(p4HardwareLoad(12)),u32(frequency))
        if (safe && r.loadU32(4) != 1) result=7
        else if (safe && r.loadU32(24) == 3 && timing.valid() && u32(timeoutMilliseconds) <= u32(2147483647)/perMs) {
            if (p4I2cSessionTiming(r.loadU32(20),timing) != 1) {
                r.storeU32(4,3);r.storeU32(8,5);result=6
            } else {
                val raw=p4HardwareJobsRun(r,jobs,count,perMs*u32(timeoutMilliseconds))
                result=if (raw == 1) 1 else if (raw == 3) 5 else if (raw == 4 || raw == 8) 4 else if (raw == 5) 3 else if (raw == 7) 2 else 6
            }
        }
    }
    if (!p4HardwareLeave()) return 4
    return result
}
