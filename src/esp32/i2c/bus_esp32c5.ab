import "./bus_c5_sequence.ab"
import "./setup_esp32c5.ab"
import "./teardown_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
import "./setup_c5_sequence.ab"
import "./teardown_c5_sequence.ab"
@export("c5I2cBusSetup")
trusted fun c5I2cBusSetupHook(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int =
    esp32C5I2cSetupOwned(0,sda,scl,source,sourceHz,busHz,filter,pulls) | 0
@export("c5I2cBusTeardown")
trusted fun c5I2cBusTeardownHook(sda: int,scl: int): int = esp32C5I2cTeardownOwned(0,sda,scl) | 0
