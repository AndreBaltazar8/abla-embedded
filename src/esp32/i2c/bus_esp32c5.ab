import "./bus_c5_sequence.ab"
import "./setup_esp32c5.ab"
import "./teardown_esp32c5.ab"
trusted fun c5I2cBusSetup(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int =
    esp32C5I2cSetupOwned(0,sda,scl,source,sourceHz,busHz,filter,pulls) | 0
trusted fun c5I2cBusTeardown(sda: int,scl: int): int = esp32C5I2cTeardownOwned(0,sda,scl) | 0
