import "./poll_esp32c5.ab"
import "./transfer_c5_sequence.ab"
import "../../hal/esp32_i2c.ab"
@export("c5I2cTransferLoad")
trusted fun c5I2cTransferLoadHook(address: int): int = mmioLoadU32(address)
@export("c5I2cTransferStore")
trusted fun c5I2cTransferStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
