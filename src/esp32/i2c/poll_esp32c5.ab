import "./poll_c5_sequence.ab"
import "./fifo_esp32c5.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
trusted noescape extern:"inline-assembly" fun c5I2cCounterInstruction(template: string,constraints: string): u32
// Machine-mode C5 cycle counter. Caller keeps CPU clock stable and counter
// running throughout the bounded wait; no scheduler/library dependency.
@export("esp32C5I2cReadCounter")
trusted fun esp32C5I2cReadCounterHook(): u32 = c5I2cCounterInstruction("csrr $0, mcycle","=r,~{memory}")
@export("c5I2cPollLoad")
trusted fun c5I2cPollLoadHook(address: int): int = mmioLoadU32(address)
@export("c5I2cPollStore")
trusted fun c5I2cPollStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
