import "./poll_c5_sequence.ab"
import "./fifo_esp32c5.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun c5I2cCounterInstruction(template: string,constraints: string): u32
// Machine-mode C5 cycle counter. Caller keeps CPU clock stable and counter
// running throughout the bounded wait; no scheduler/library dependency.
trusted fun esp32C5I2cReadCounter(): u32 = c5I2cCounterInstruction("csrr $0, mcycle","=r,~{memory}")
trusted fun c5I2cPollLoad(address: int): int = mmioLoadU32(address)
trusted fun c5I2cPollStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
