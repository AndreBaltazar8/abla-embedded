import "./command_s3_logic.ab"
// C5 HP-I2C command layout, opcodes, FIFO depth and count fields match S3.
// Reuse pure encodings only; C5 has one HP controller at a different base.
fun esp32C5I2cControllerAddress(port: int): int = if (port == 0) 0x60004000 else 0
fun esp32C5I2cCommandValid(command: u32): bool = esp32S3I2cCommandValid(command)
fun esp32C5I2cTxCount(status: u32): int = esp32S3I2cTxCount(status)
fun esp32C5I2cRxCount(status: u32): int = esp32S3I2cRxCount(status)
import "../sdk/raw_buffer.ab"

// Polling primitives: caller exclusively owns a clock-enabled controller.
// These do not start a transaction or claim that queued data reached a device.
trusted fun esp32C5I2cWriteCommand(port: int, index: int, command: u32): bool {
    val base = esp32C5I2cControllerAddress(port)
    if (base == 0 || index < 0 || index >= 8 || !esp32C5I2cCommandValid(command)) return false
    esp32C5I2cFifoRegisterWrite(base + 0x58 + index * 4, int(command))
    true
}

trusted fun esp32C5I2cWriteFifo(port: int, buffer: NativeBuffer, count: int): bool {
    val base = esp32C5I2cControllerAddress(port)
    if (base == 0 || count > 32 || !buffer.hasAddressRange(0, count)) return false
    if (count == 0) return true
    val used = esp32C5I2cTxCount(u32(esp32C5I2cFifoRegisterRead(base + 8)))
    if (used > 32 || count > 32 - used) return false
    // Full span and FIFO capacity were checked above; no per-byte recheck.
    var index = u32(0)
    while (index < u32(count)) {
        esp32C5I2cFifoRegisterWrite(base + 0x1c, ablaUnsafeLoadU8(nativePointerFromAddress(buffer.addressValue() + int(index))))
        index = index + u32(1)
    }
    true
}

trusted fun esp32C5I2cReadFifo(port: int, buffer: NativeBuffer, count: int): bool {
    val base = esp32C5I2cControllerAddress(port)
    if (base == 0 || count > 32 || !buffer.hasAddressRange(0, count)) return false
    if (count == 0) return true
    val ready = esp32C5I2cRxCount(u32(esp32C5I2cFifoRegisterRead(base + 8)))
    if (ready > 32 || count > ready) return false
    // Full destination span is valid before the first destructive FIFO read.
    var index = u32(0)
    while (index < u32(count)) {
        ablaUnsafeStoreU8(nativePointerFromAddress(buffer.addressValue() + int(index)), esp32C5I2cFifoRegisterRead(base + 0x1c) & 255)
        index = index + u32(1)
    }
    true
}

// Idle-only destructive FIFO reset, explicit to avoid dropping queued data
// implicitly in a write/read operation. Preserve thresholds and access mode.
trusted fun esp32C5I2cResetFifos(port: int): bool {
    val base = esp32C5I2cControllerAddress(port)
    if (base == 0) return false
    val config = esp32C5I2cFifoRegisterRead(base + 0x18)
    esp32C5I2cFifoRegisterWrite(base + 0x18, config | 12288)
    esp32C5I2cFifoRegisterWrite(base + 0x18, config & ~12288)
    true
}
