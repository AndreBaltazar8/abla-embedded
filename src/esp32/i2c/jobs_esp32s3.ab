import "./jobs_sequence.ab"
import "./stream_esp32s3.ab"
import "../../hal/esp32_i2c.ab"
import "./poll_esp32s3.ab"
import "../sdk/raw_buffer.ab"
import "../sdk/nativebuffer_type.ab"
@export("i2cJobsFifoBytes")
fun i2cJobsFifoBytesHook(port: int): int = if (port >= 0 && port <= 1) 32 else 0
@export("i2cJobsCounter")
trusted fun i2cJobsCounterHook(): u32 = esp32S3I2cReadCounter()
@export("i2cJobsChunk")
trusted fun i2cJobsChunkHook(port: int,address: int,data: NativeBuffer,count: int,reading: bool,first: bool,finish: bool,continued: bool,started: u32,budget: u32,nackLast: bool): int =
    esp32S3I2cStreamChunkOwned(port,address,data,count,reading,first,finish,continued,started,budget,-1,nackLast)
