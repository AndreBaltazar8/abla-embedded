import "./command_s3_logic.ab"

// A prefix occupies one first-batch FIFO byte in addition to the address.
fun esp32C5LpI2cStreamPayloadCapacity(first: bool, prefix: int): int {
    if (prefix < -1 || prefix > 255 || (!first && prefix >= 0)) return -1
    if (first) 15 - (if (prefix >= 0) 1 else 0) else 16
}

fun esp32C5LpI2cStreamLast(reading: bool, first: bool, finish: bool, count: int,nackLast: bool = false): int {
    if (reading) {
        if (count < 1 || count > 16) return -1
        return (if (first) 2 else 0) + (if ((finish || nackLast) && count > 1) 2 else 1)
    }
    if (count < (if (first) 0 else 1) || count > (if (first) 15 else 16)) return -1
    if (first) 2 else 1
}

fun esp32C5LpI2cStreamCommand(reading: bool, first: bool, finish: bool,
    count: int, index: int,nackLast: bool = false): u32 {
    val last = esp32C5LpI2cStreamLast(reading, first, finish, count,nackLast)
    if (last < 0 || index < 0 || index > last) return u32(0xffffffff)
    if (index == last) return esp32S3I2cCommand(if (finish) 2 else 4, 0)
    if (first && index == 0) return esp32S3I2cCommand(6, 0)
    if (!reading) return esp32S3I2cCommand(1, count + (if (first) 1 else 0), true)
    if (first && index == 1) return esp32S3I2cCommand(1, 1, true)
    if ((finish || nackLast) && index == last - 1) return esp32S3I2cCommand(3, 1, false, false, true)
    esp32S3I2cCommand(3, count - (if (finish || nackLast) 1 else 0))
}
