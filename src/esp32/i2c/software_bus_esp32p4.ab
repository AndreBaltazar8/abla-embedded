import "./software_bus_p4_sequence.ab"
import "./software_transfer_esp32p4.ab"
trusted fun p4SoftwareI2cOutputEnabled(pin: int): bool = (p4GpioRead(if (pin < 32) 32 else 44)&(u32(1)<<u32(pin&31))) != u32(0)
trusted fun p4SoftwareI2cConfigurePad(pin: int,enable: bool): bool = esp32P4GpioConfigureOwned(pin,enable,true,true,true,0) == 1
trusted fun esp32P4SoftwareI2cOpen(sda: int,scl: int,halfPeriodUs: int,stretchPolls: int): Esp32P4SoftwareI2cBus = esp32P4SoftwareI2cOpenOwned(sda,scl,halfPeriodUs,stretchPolls)
trusted fun Esp32P4SoftwareI2cBus.transfer(address: int,tx: NativeBuffer,txLength: int,rx: NativeBuffer,rxLength: int,registerPrefix: int = -1): SoftwareI2cTransfer =
    if (this.ready()) this.lines().transfer(address,tx,txLength,rx,rxLength,registerPrefix) else SoftwareI2cTransfer(2)
