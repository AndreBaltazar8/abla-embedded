import "./recovery_p4_sequence.ab"
import "./pins_p4_sequence.ab"
trusted fun p4I2cRecoveryLinesHigh(sda: int,scl: int): bool = esp32P4GpioReadOwned(sda) == 1 && esp32P4GpioReadOwned(scl) == 1
trusted fun p4HardwarePinsReady(r: NativeBuffer): bool {
    val pins=nativeBufferAt(r.addressValue()+32,40)
    if (!p4I2cPinsRecordValid(pins) || pins.loadU32(4) != 1 || pins.loadU32(12) != r.loadU32(20)) return false
    var i=0
    while (i < 2) {
        val saved=p4I2cPinsSaved(pins,i)
        if (!saved.valid()) return false
        val pin=saved.pin()
        val signal=68+r.loadU32(20)*2+i
        if (esp32P4GpioIndividualHoldOwned(if (((saved|0)&(1<<38)) != 0) 3 else 1,pin) != 0 ||
            (p4GpioRead(344+signal*4)&u32(255)) != u32(128|pin) ||
            (p4GpioRead(1368+pin*4)&u32(4095)) != u32(signal) ||
            (p4GpioRead(116+pin*4)&u32(4)) == u32(0) ||
            (p4GpioRead(4100+pin*4)&u32(0x7202)) != u32(0x1200) ||
            (p4GpioRead(if (pin < 32) 32 else 44)&(u32(1)<<u32(pin&31))) == u32(0) ||
            (pin < 16 && (p4GpioRead(0x4b008+pin*4)&u32(16)) != u32(0))) return false
        i=i+1
    }
    return true
}
trusted fun p4HardwareRecover(r: NativeBuffer,budget: u32,stopAfterNack: bool): int {
    if (!p4HardwarePinsReady(r)) return 7
    val pins=nativeBufferAt(r.addressValue()+32,40)
    return esp32p4I2cRecoverOwned(r.loadU32(20),p4I2cPinsSaved(pins,1).pin(),p4I2cPinsSaved(pins,0).pin(),budget,true,stopAfterNack)
}
