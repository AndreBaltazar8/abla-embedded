import "./clock_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@export("p4I2cRead")
trusted fun p4I2cReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("p4I2cWrite")
trusted fun p4I2cWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
