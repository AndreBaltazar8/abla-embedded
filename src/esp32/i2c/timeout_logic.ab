// Decompose into whole seconds and subsecond terms so a32-bit target needs
// only32-bit division. No libgcc/libc64-bit divide helper, and no rounding down.
fun esp32S3I2cTimeoutCycles(milliseconds: int, cpuHz: int): u32 {
    if (milliseconds < 1 || milliseconds > 2147483647 || cpuHz < 1 || cpuHz > 4294967295) return u32(0)
    val ms = u32(milliseconds)
    val hz = u32(cpuHz)
    val fraction = ms % u32(1000)
    val cycles = int(ms / u32(1000)) * cpuHz +
        int(fraction) * int(hz / u32(1000)) +
        int((fraction * (hz % u32(1000)) + u32(999)) / u32(1000))
    if (cycles < 1 || cycles > 2147483647) return u32(0)
    u32(cycles)
}
