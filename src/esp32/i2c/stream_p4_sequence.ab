import "./stream_chunk_p4_sequence.ab"
// Full seven-bit write/read/probe with optional8-bit register prefix.
// One immutable cycle deadline covers all queue work and command batches.
// Write->read uses repeated START, intermediate chunks END, only final byte
// of the read phase NACK, exactly one final STOP. No allocations or FIFO reset.
// Caller owns configured controller/bus/CPU counter and stable clocks across
// all chunks. Failure can leave data consumed and bus retained; caller must
// explicitly recover. No automatic STOP/reset, particularly after arbitration.
// Same results as RunBatch:1success3NACK4arbitration5timeout6FIFO7invalid8busy.
trusted fun esp32p4I2cTransferOwned(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,exclusive: bool,registerPrefix: int = -1): int {
    if (!exclusive || port < 0 || port > 1 || address < 0 || address > 127 ||
        !output.hasAddressRange(0,written) || !input.hasAddressRange(0,read) ||
        budget == u32(0) || budget > u32(0x7fffffff) || registerPrefix < -1 || registerPrefix > 255) return 7
    val started=p4I2cCounter()
    if (!p4I2cFifoReady(port)) return 7
    val status=p4I2cRead(p4I2cBase(port)+8)
    if ((status&u32(16)) != u32(0)) return 8
    if (esp32S3I2cTxCount(status) != 0 || esp32S3I2cRxCount(status) != 0) return 6
    var continued=false
    if (written > 0 || read == 0 || registerPrefix >= 0) {
        var offset=0
        var first=true
        while (first || offset < written) {
            val prefix=if (first) registerPrefix else -1
            val capacity=esp32S3I2cStreamPayloadCapacity(first,prefix)
            val count=if (written-offset < capacity) written-offset else capacity
            val finish=offset+count == written && read == 0
            val result=esp32p4I2cStreamChunkOwned(port,address,nativeBufferAt(output.addressValue()+offset,count),count,false,first,finish,continued,started,budget,prefix)
            if (result != (if (finish) 1 else 2)) return if (result <= 2) 6 else result
            offset=offset+count;first=false;continued=true
        }
    }
    var offset=0
    while (offset < read) {
        val count=if (read-offset < 32) read-offset else 32
        val finish=offset+count == read
        val result=esp32p4I2cStreamChunkOwned(port,address,nativeBufferAt(input.addressValue()+offset,count),count,true,offset == 0,finish,continued,started,budget)
        if (result != (if (finish) 1 else 2)) return if (result <= 2) 6 else result
        offset=offset+count;continued=true
    }
    return 1
}
