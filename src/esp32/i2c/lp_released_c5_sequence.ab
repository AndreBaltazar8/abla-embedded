import "./lp_pins_c5_sequence.ab"
// Passive SINGLE-MASTER check, not permission to take a multi-master bus.
// Caller owns pads/controller/shared registers and excludes LP CPU/ULP.
trusted fun esp32C5LpI2cConfiguredPinsMatchOwned(port: int,sda: int,scl: int): bool {
    if (!esp32C5LpI2cPinsAvailableOwned(port,sda,scl)) return false
    if ((c5LpI2cPinLoad(0x600B1028)&12) != 12 ||
        (c5LpI2cPinLoad(0x600B2800)&0x10000000) == 0 ||
        (c5LpI2cPinLoad(0x600B4410)&12) != 12) return false
    if ((c5LpI2cPinLoad(0x600B4008)&0x7202) != 0x3200 ||
        (c5LpI2cPinLoad(0x600B400C)&0x7202) != 0x3200 ||
        (c5LpI2cPinLoad(0x600B4438)&4) == 0 ||
        (c5LpI2cPinLoad(0x600B443C)&4) == 0) return false
    true
}
trusted fun esp32C5LpI2cBusReleasedOwned(port: int,sda: int,scl: int): bool {
    if (!esp32C5LpI2cConfiguredPinsMatchOwned(port,sda,scl)) return false
    if ((c5LpI2cPinLoad(0x600B1808)&16) != 0 || (c5LpI2cPinLoad(0x600B441C)&12) != 12) return false
    // Standard-mode tBUF4.7us; ROM delay requires calibrated ticks/us.
    c5LpI2cReleasedDelay()
    (c5LpI2cPinLoad(0x600B1808)&16) == 0 && (c5LpI2cPinLoad(0x600B441C)&12) == 12
}
