import "./command_s3_logic.ab"

// One preloaded FIFO batch. Combined transfers need two address bytes.
fun esp32S3I2cSmallTransferValid(address: int, written: int, read: int): bool {
    if (address < 0 || address > 127 || written < 0 || written > 31 ||
        read < 0 || read > 32) return false
    written + 1 + (if (written > 0 && read > 0) 1 else 0) <= 32
}

fun esp32S3I2cSmallTransferLast(written: int, read: int): int {
    if (!esp32S3I2cSmallTransferValid(0, written, read)) return -1
    if (read == 0) return 2
    (if (written > 0) 4 else 2) + (if (read > 1) 2 else 1)
}

// Indexed command generation avoids a heap-allocated command list. A zero-
// length transfer is an address-only write probe, not a forced success.
fun esp32S3I2cSmallTransferCommand(written: int, read: int, index: int): u32 {
    val last = esp32S3I2cSmallTransferLast(written, read)
    if (last < 0 || index < 0 || index > last) return u32(0xffffffff)
    if (index == last) return esp32S3I2cCommand(2, 0)
    if (index == 0) return esp32S3I2cCommand(6, 0)
    if (index == 1) return esp32S3I2cCommand(1, written + 1, true)
    if (written > 0) {
        if (index == 2) return esp32S3I2cCommand(6, 0)
        if (index == 3) return esp32S3I2cCommand(1, 1, true)
    }
    if (index == last - 1) return esp32S3I2cCommand(3, 1, false, false, true)
    esp32S3I2cCommand(3, read - 1)
}
