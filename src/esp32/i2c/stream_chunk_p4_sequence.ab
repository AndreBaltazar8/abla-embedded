import "./stream_s3_logic.ab"
import "./poll_p4_sequence.ab"
// Internal chunk primitive also usable by explicit multi-phase jobs. A final
// READ before a repeated START must set nackLast even when finish=false.
// Caller owns configured, paused polling controller and entire buffer spans.
trusted fun esp32p4I2cStreamChunkOwned(port: int,address: int,data: NativeBuffer,count: int,reading: bool,first: bool,finish: bool,continued: bool,started: u32,budget: u32,registerPrefix: int = -1,nackLast: bool = false): int {
    if (port < 0 || port > 1 || address < 0 || address > 127 || count < 0 || count > 32 ||
        !data.hasAddressRange(0,count) || registerPrefix < -1 || registerPrefix > 255 ||
        (registerPrefix >= 0 && (reading || !first)) || budget == u32(0) || budget > u32(0x7fffffff)) return 7
    val commandCount=count+(if (registerPrefix >= 0) 1 else 0)
    val last=esp32S3I2cStreamLast(reading,first,finish,commandCount,nackLast)
    if (last < 0) return 7
    if (esp32S3I2cDeadlineExpired(started,p4I2cCounter(),budget)) return 5
    if (!p4I2cFifoReady(port)) return 7
    val base=p4I2cBase(port)
    val status=p4I2cRead(base+8)
    if (!continued && (status&u32(16)) != u32(0)) return 8
    if (esp32S3I2cTxCount(status) != 0 || esp32S3I2cRxCount(status) != 0) return 6
    var index=0
    while (index <= last) {
        if (esp32p4I2cWriteCommandOwned(port,index,esp32S3I2cStreamCommand(reading,first,finish,commandCount,index,nackLast),true) != 1) return 6
        index=index+1
    }
    if (first) p4I2cWrite(base+28,u32((address<<1)|(if (reading) 1 else 0)))
    if (registerPrefix >= 0) p4I2cWrite(base+28,u32(registerPrefix))
    if (!reading && (esp32p4I2cWriteFifoOwned(port,data,count,true)&255) != 1) return 6
    // Same started/budget enters the batch; queue time is included.
    val result=esp32p4I2cRunBatchUntilOwned(port,last,started,budget,continued,true)
    if (result != (if (finish) 1 else 2)) return result
    val completed=p4I2cRead(base+8)
    if (esp32S3I2cTxCount(completed) != 0 || esp32S3I2cRxCount(completed) != (if (reading) count else 0)) return 6
    if (reading && (esp32p4I2cReadFifoOwned(port,data,count,true)&255) != 1) return 6
    return result
}
