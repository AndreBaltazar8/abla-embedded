import "./software_bus_p4_sequence.ab"
import "../../i2c/software_devices.ab"
// Compatibility names; implementation shared with every software-I2C backend.
trusted fun p4SoftwareDevicePoolBytes(pool: I2cDeviceSlots): int = softwareI2cDevicePoolBytes(pool)
fun p4SoftwareDeviceBufferSafe(pool: I2cDeviceSlots,bytes: int,buffer: NativeBuffer,length: int): bool = softwareI2cDeviceBufferSafe(pool,bytes,buffer,length)
fun Esp32P4SoftwareI2cBus.matchesDevice(descriptor: int): bool = this.lines().matchesDevice(descriptor)
trusted fun Esp32P4SoftwareI2cBus.deviceOwned(pool: I2cDeviceSlots,address: int,frequency: int): int =
    if (this.ready()) this.lines().deviceOwned(pool,address,frequency) else 0
trusted fun Esp32P4SoftwareI2cBus.transferDeviceOwned(pool: I2cDeviceSlots,handle: int,tx: NativeBuffer,txLength: int,rx: NativeBuffer,rxLength: int,prefix: int = -1): SoftwareI2cTransfer =
    if (this.ready()) this.lines().transferDeviceOwned(pool,handle,tx,txLength,rx,rxLength,prefix) else SoftwareI2cTransfer(2)
trusted fun Esp32P4SoftwareI2cBus.closeDeviceOwned(pool: I2cDeviceSlots,handle: int): bool = this.lines().closeDeviceOwned(pool,handle)
// Status9 retains pad ownership if handle revocation fails; retry this close,
// never bypass it with raw pad close or attempt to recover a closing bus.
trusted fun Esp32P4SoftwareI2cBus.closeWithDevicesOwned(pool: I2cDeviceSlots): Esp32P4SoftwareI2cBus {
    if (!this.lines().revokeDevicesOwned(pool)) return Esp32P4SoftwareI2cBus((this&~(255<<48))|(9<<48))
    return this.closeOwned()
}
