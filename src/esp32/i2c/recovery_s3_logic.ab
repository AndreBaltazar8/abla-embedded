// Clock first, control last. Never replay write-trigger bits (START/FSM reset/
// config update), FIFO reset bits, interrupt status, or command DONE bits.
fun esp32S3I2cRecoveryOffset(index: int): int {
    if (index == 0) return 0x54
    if (index == 1) return 0x00
    if (index == 2) return 0x38
    if (index == 3) return 0x30
    if (index == 4) return 0x34
    if (index == 5) return 0x40
    if (index == 6) return 0x44
    if (index == 7) return 0x48
    if (index == 8) return 0x4c
    if (index == 9) return 0x0c
    if (index == 10) return 0x50
    if (index == 11) return 0x18
    if (index == 12) return 0x04
    return -1
}

fun esp32S3I2cRecoveryMask(index: int): u32 {
    if (index == 0) return u32(0x3fffff)
    if (index == 2) return u32(0xffff)
    if (index >= 1 && index <= 8) return u32(0x1ff)
    if (index == 9) return u32(0x3f)
    if (index == 10) return u32(0x3ff)
    if (index == 11) return u32(0x4fff)
    if (index == 12) return u32(0x3db)
    u32(0)
}
