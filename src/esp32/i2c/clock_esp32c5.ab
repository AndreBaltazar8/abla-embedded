import "./clock_c5_sequence.ab"
import "abla/unsafe/mmio"
trusted fun c5I2cClockLoad(address: int): int = mmioLoadU32(address)
trusted fun c5I2cClockStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun esp32C5I2cResetClock(port: int,source: int): bool = esp32C5I2cResetClockOwned(port,source)
trusted fun esp32C5I2cDisableClock(port: int): bool = esp32C5I2cDisableClockOwned(port)
