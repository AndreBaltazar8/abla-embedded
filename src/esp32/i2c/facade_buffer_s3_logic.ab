import "../sdk/raw_buffer.ab"
// Provider-private storage: two36B controller records and a200B slot pool.
// Protect both controllers, even when a transfer selects only one. Used for
// input AND output: DMA/readback or accidental disclosure of handles is invalid.
fun esp32S3I2cFacadeBufferSafe(buffer: NativeBuffer,length: int,state0: int,state1: int,pool: int): bool {
    if (!buffer.hasAddressRange(0,length)) return false
    if (length == 0) return true
    if (!nativeBufferAt(state0,36).hasAddressRange(0,36) ||
        !nativeBufferAt(state1,36).hasAddressRange(0,36) ||
        !nativeBufferAt(pool,200).hasAddressRange(0,200)) return false
    val begin=buffer.addressValue()
    val end=begin+length
    (end <= state0 || begin >= state0+36) &&
        (end <= state1 || begin >= state1+36) && (end <= pool || begin >= pool+200)
}
