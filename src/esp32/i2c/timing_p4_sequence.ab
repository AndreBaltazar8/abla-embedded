import "./clock_p4_sequence.ab"
import "./timing_p4_logic.ab"
// P4 HP I2C uses the same LL timing formula and controller field widths as
// S3/C5, but DIFFERENT RCC divider layouts. No copied timing arithmetic.
// Caller owns idle clock-enabled controller, pads and shared RCC; supplies
// actual source frequency. Failed writes leave partial config owned; retry
// complete setup, never start a transaction after failure. No reset/FIFO/pins.
// Return1 fields verified + UPDATE issued (not physical bus-frequency proof),
// 2invalid3clock/reset4busy5readback. Commit UPDATE exactly once, LAST.
trusted fun esp32p4I2cConfigureTimingOwned(port: int,value: P4I2cTiming,exclusive: bool): int {
    if (!exclusive || port < 0 || port > 1 || !value.valid()) return 2
    if (!esp32p4I2cClockReady(port)) return 3
    if (!p4I2cIdle(port)) return 4
    val t=Esp32S3I2cTiming(value|u32(0))
    val half=t.halfCycle()
    val base=p4I2cBase(port)
    val shift=u32(if (port == 0) 2 else 0)
    if (!p4I2cField(0x500e6040+port*4,u32(0xffffff)<<shift,t.dividerRegister()<<shift) ||
        !p4I2cField(base,u32(511),half-u32(1)) ||
        !p4I2cField(base+56,u32(65535),t.highPeriod()|(t.waitHigh()<<u32(9))) ||
        !p4I2cField(base+48,u32(511),(half>>u32(2))-u32(1)) ||
        !p4I2cField(base+52,u32(511),(half>>u32(1))-u32(1)) ||
        !p4I2cField(base+64,u32(511),half-u32(1)) ||
        !p4I2cField(base+68,u32(511),half-u32(1)) ||
        !p4I2cField(base+72,u32(511),half-u32(1)) ||
        !p4I2cField(base+76,u32(511),half-u32(1)) ||
        !p4I2cField(base+12,u32(63),t.timeoutExponent()|u32(32))) return 5
    // Synchronization strobe: do not mistake self-clear for a dropped write.
    p4I2cWrite(base+4,p4I2cRead(base+4)|u32(2048))
    return 1
}
