import "./timing_s3_logic.ab"
// LP register fields from C5 lp_i2c_reg.h; shared pure timing arithmetic.
// LP divider is local CLK_CONF low8, NOT the HP PCR divider at bits12..19.
type Esp32C5LpI2cTiming = u32
fun esp32C5LpI2cTiming(sourceHz: u32,busHz: u32): Esp32C5LpI2cTiming =
    Esp32C5LpI2cTiming(esp32S3I2cTiming(sourceHz,busHz) | u32(0))
fun Esp32C5LpI2cTiming.valid(): bool = Esp32S3I2cTiming(this | u32(0)).valid()
trusted fun esp32C5LpI2cTimingField(address: int,mask: u32,value: u32): void {
    c5LpI2cTimingStore(address,int((u32(c5LpI2cTimingLoad(address))&~mask)|(value&mask)))
    return
}
// LP I2C0 only. Caller owns idle, clock-enabled controller (also against LP CPU),
// supplies actual selected source frequency, and keeps it stable while active.
// Configures timing, not clocks/pins/FIFO/transactions. Commit update LAST.
trusted fun esp32C5LpI2cConfigureTimingOwned(port: int,value: Esp32C5LpI2cTiming): bool {
    if (port != 0 || !value.valid()) return false
    val timing=Esp32S3I2cTiming(value | u32(0))
    val half=timing.halfCycle()
    esp32C5LpI2cTimingField(0x600B1854,u32(0xFFFFF),timing.dividerRegister())
    esp32C5LpI2cTimingField(0x600B1800,u32(511),half-u32(1))
    esp32C5LpI2cTimingField(0x600B1838,u32(65535),timing.highPeriod()|(timing.waitHigh()<<u32(9)))
    esp32C5LpI2cTimingField(0x600B1830,u32(511),half/u32(4)-u32(1))
    esp32C5LpI2cTimingField(0x600B1834,u32(511),half/u32(2)-u32(1))
    esp32C5LpI2cTimingField(0x600B1840,u32(511),half-u32(1))
    esp32C5LpI2cTimingField(0x600B1844,u32(511),half-u32(1))
    esp32C5LpI2cTimingField(0x600B1848,u32(511),half-u32(1))
    esp32C5LpI2cTimingField(0x600B184C,u32(511),half-u32(1))
    esp32C5LpI2cTimingField(0x600B180C,u32(63),timing.timeoutExponent()|u32(32))
    esp32C5LpI2cTimingField(0x600B1804,u32(2048),u32(2048))
    true
}
