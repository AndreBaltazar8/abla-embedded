import "./fifo_p4_sequence.ab"
import "./command_s3_logic.ab"
// Pinned IDF6 P4 i2c_ll_master_fsm_rst: CTR.FSM_RST bit10 self-clears.
// Explicit abort of this owner's failed transaction, not whole-peripheral
// reset. Preserves clock source, timing/filter registers, routes and FIFO
// evidence. Does NOT prove free bus lines or reopen transfer admission.
// Caller pins clocks/counter, owns controller/IRQ/DMA and independently
// excludes all other physical masters. Arbitration evidence is never cleared.
// 1FSM idle,2invalid,3not configured/interrupts enabled,4arbitration,
// 5deadline,6configuration changed. Keep ownership after every failure.
// If reset is already asserted, only wait; never retrigger it in the loop.
trusted fun esp32p4I2cFsmResetOwned(port: int,budget: u32,exclusive: bool): int {
    if (!exclusive || port < 0 || port > 1 || budget == u32(0) || budget > u32(0x7fffffff)) return 2
    if (!p4I2cFifoReady(port)) return 3
    val base=p4I2cBase(port)
    if ((p4I2cRead(base+40)&u32(0x7ffff)) != u32(0)) return 3
    if ((p4I2cRead(base+32)&u32(32)) != u32(0)) return 4
    val started=p4I2cCounter()
    val before=p4I2cRead(base+4)
    if ((before&u32(0x420)) == u32(0) && (p4I2cRead(base+8)&u32(16)) == u32(0)) return 1
    // Never echo TRANS_START/CONF_UPGATE command bits while aborting.
    val stable=before&u32(0xfffff3df)
    if ((before&u32(1024)) == u32(0)) p4I2cWrite(base+4,stable|u32(1024))
    while (true) {
        val control=p4I2cRead(base+4)
        if ((control&u32(0xfffff3df)) != stable) return 6
        if ((p4I2cRead(base+32)&u32(32)) != u32(0)) return 4
        if ((control&u32(0x420)) == u32(0) && (p4I2cRead(base+8)&u32(16)) == u32(0)) return 1
        if (p4I2cCounter()-started >= budget) return 5
    }
    return 5
}
