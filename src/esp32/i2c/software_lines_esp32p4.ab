import "../../i2c/software_lines.ab"
import "../gpio_esp32p4.ab"
import "../peripheral_delay_esp32p4.ab"
import "../../hal/esp32_i2c.ab"
import "../../hal/esp32.ab"
import "../../hal/esp32_i2c_2.ab"
import "../gpio_p4_sequence.ab"
@export("softwareI2cDrive")
trusted fun softwareI2cDriveHook(pin: int,released: bool): void { esp32P4GpioWriteOwned(pin,released); return }
@export("softwareI2cSample")
trusted fun softwareI2cSampleHook(pin: int): bool = esp32P4GpioReadOwned(pin) == 1
@export("softwareI2cDelay")
trusted fun softwareI2cDelayHook(us: int): void = peripheralRomDelay(us)
// Only constructs a line view; it does not claim/configure pins or clocks.
fun esp32P4SoftwareI2cLines(sda: int,scl: int,halfPeriodUs: int,stretchPolls: int): SoftwareI2cLines =
    if (sda > 54 || scl > 54) SoftwareI2cLines(0) else softwareI2cLines(sda,scl,halfPeriodUs,stretchPolls)
