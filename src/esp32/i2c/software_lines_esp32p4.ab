import "../../i2c/software_lines.ab"
import "../gpio_esp32p4.ab"
import "../peripheral_delay_esp32p4.ab"
trusted fun softwareI2cDrive(pin: int,released: bool): void { esp32P4GpioWriteOwned(pin,released); return }
trusted fun softwareI2cSample(pin: int): bool = esp32P4GpioReadOwned(pin) == 1
trusted fun softwareI2cDelay(us: int): void = peripheralRomDelay(us)
// Only constructs a line view; it does not claim/configure pins or clocks.
fun esp32P4SoftwareI2cLines(sda: int,scl: int,halfPeriodUs: int,stretchPolls: int): SoftwareI2cLines =
    if (sda > 54 || scl > 54) SoftwareI2cLines(0) else softwareI2cLines(sda,scl,halfPeriodUs,stretchPolls)
