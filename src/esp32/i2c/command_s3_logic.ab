// S3 opcodes differ from classic ESP32: RESTART6, WRITE1, READ3, STOP2, END4.
// UINT32_MAX denotes invalid input and is never written to a command register.
fun esp32S3I2cCommand(operation: int, count: int, checkAck: bool = false,
    expectedNack: bool = false, sendNack: bool = false): u32 {
    if (operation == 1 || operation == 3) {
        if (count < 1 || count > 255) return u32(0xffffffff)
    } else if (operation == 2 || operation == 4 || operation == 6) {
        if (count != 0) return u32(0xffffffff)
    } else return u32(0xffffffff)
    if ((checkAck || expectedNack) && operation != 1) return u32(0xffffffff)
    if (sendNack && operation != 3) return u32(0xffffffff)
    u32(count) | (u32(operation) << u32(11)) |
        (if (checkAck) u32(256) else u32(0)) |
        (if (expectedNack) u32(512) else u32(0)) |
        (if (sendNack) u32(1024) else u32(0))
}

fun esp32S3I2cCommandValid(command: u32): bool =
    command != u32(0xffffffff) && command == esp32S3I2cCommand(
        int((command >>> u32(11)) & u32(7)), int(command & u32(255)),
        (command & u32(256)) != u32(0), (command & u32(512)) != u32(0),
        (command & u32(1024)) != u32(0))

fun esp32S3I2cControllerAddress(port: int): int =
    if (port == 0) 0x60013000 else if (port == 1) 0x60027000 else 0

fun esp32S3I2cTxCount(status: u32): int = int((status >>> u32(18)) & u32(63))
fun esp32S3I2cRxCount(status: u32): int = int((status >>> u32(8)) & u32(63))
