import "./lp_bus_c5_sequence.ab"
import "./lp_setup_esp32c5.ab"
import "./lp_teardown_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
import "./lp_setup_c5_sequence.ab"
import "./lp_teardown_c5_sequence.ab"
import "./lp_clock_c5_sequence.ab"
@export("c5LpI2cBusSetup")
trusted fun c5LpI2cBusSetupHook(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int =
    esp32C5LpI2cSetupOwned(0,sda,scl,source,sourceHz,busHz,filter,pulls) | 0
@export("c5LpI2cBusTeardown")
trusted fun c5LpI2cBusTeardownHook(sda: int,scl: int): int = esp32C5LpI2cTeardownOwned(0,sda,scl)
@export("c5LpI2cBusAbortSetup")
trusted fun c5LpI2cBusAbortSetupHook(): int = if (esp32C5LpI2cDisableClockOwned(0)) 1 else 5
