import "./lp_bus_c5_sequence.ab"
import "./lp_setup_esp32c5.ab"
import "./lp_teardown_esp32c5.ab"
trusted fun c5LpI2cBusSetup(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int =
    esp32C5LpI2cSetupOwned(0,sda,scl,source,sourceHz,busHz,filter,pulls) | 0
trusted fun c5LpI2cBusTeardown(sda: int,scl: int): int = esp32C5LpI2cTeardownOwned(0,sda,scl)
trusted fun c5LpI2cBusAbortSetup(): int = if (esp32C5LpI2cDisableClockOwned(0)) 1 else 5
