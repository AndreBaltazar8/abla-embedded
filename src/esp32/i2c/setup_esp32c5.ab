import "./setup_c5_sequence.ab"
import "./clock_esp32c5.ab"
import "./controller_esp32c5.ab"
import "./timing_esp32c5.ab"
import "./pins_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
@export("c5I2cSetupPadsAvailable")
trusted fun c5I2cSetupPadsAvailableHook(sda: int,scl: int): bool = esp32C5I2cPinsAvailableOwned(0,sda,scl)
@export("c5I2cSetupClock")
trusted fun c5I2cSetupClockHook(source: int): bool = esp32C5I2cResetClock(0,source)
@export("c5I2cSetupController")
trusted fun c5I2cSetupControllerHook(filter: int): bool = esp32C5I2cInitializeController(0,filter)
trusted fun c5I2cSetupTiming(timing: Esp32C5I2cTiming): bool = esp32C5I2cConfigureTiming(0,timing)
@export("c5I2cSetupRoute")
trusted fun c5I2cSetupRouteHook(sda: int,scl: int,pullup: bool): bool = esp32C5I2cRoutePins(0,sda,scl,pullup)
@export("c5I2cSetupDisable")
trusted fun c5I2cSetupDisableHook(): bool = esp32C5I2cDisableClock(0)
