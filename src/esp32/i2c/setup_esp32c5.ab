import "./setup_c5_sequence.ab"
import "./clock_esp32c5.ab"
import "./controller_esp32c5.ab"
import "./timing_esp32c5.ab"
import "./pins_esp32c5.ab"
trusted fun c5I2cSetupPadsAvailable(sda: int,scl: int): bool = esp32C5I2cPinsAvailableOwned(0,sda,scl)
trusted fun c5I2cSetupClock(source: int): bool = esp32C5I2cResetClock(0,source)
trusted fun c5I2cSetupController(filter: int): bool = esp32C5I2cInitializeController(0,filter)
trusted fun c5I2cSetupTiming(timing: Esp32C5I2cTiming): bool = esp32C5I2cConfigureTiming(0,timing)
trusted fun c5I2cSetupRoute(sda: int,scl: int,pullup: bool): bool = esp32C5I2cRoutePins(0,sda,scl,pullup)
trusted fun c5I2cSetupDisable(): bool = esp32C5I2cDisableClock(0)
