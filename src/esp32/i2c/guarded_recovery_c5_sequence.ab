import "../../peripheral_gate.ab"
import "../sdk/raw_buffer.ab"
// Same canonical gate as transfers. Caller separately serializes PCR/GPIO
// and owns a SINGLE-MASTER bus; no recovery while another master may own it.
// clearStuck explicitly authorizes slave clocks only after reset restored
// configuration but passive checks found held lines. No automatic retries.
// 7 invalid,9 recovery unavailable/reset failure,10 held,11 owner violation.
trusted fun esp32C5I2cRecoverGuardedOwned(gate: PeripheralGate,owner: u32,port: int,sda: int,scl: int,
    scratch: NativeBuffer,budget: u32,clearStuck: bool = false): int {
    if (!gate.word().valid() || !peripheralOwnerValid(owner) || port != 0 ||
        sda < 0 || sda > 28 || scl < 0 || scl > 28 || sda == scl ||
        sda == 13 || sda == 14 || scl == 13 || scl == 14 ||
        !scratch.hasAddressRange(0,52) || (scratch.addressValue()&3) != 0 ||
        budget == u32(0) || budget > u32(0x7FFFFFFF)) return 7
    val address=gate.word().address()
    if (scratch.addressValue() < address+4 && address < scratch.addressValue()+52) return 7
    if (!gate.tryBeginRecovery(owner)) return 9
    var result=c5I2cGuardedRecover(sda,scl,scratch)
    if (result == 10 && clearStuck) {
        val token=owner|u32(0x80000000)
        if (gate.word().compareExchange(token,token) != token) return 11
        if (c5I2cGuardedClear(sda,scl,budget)) result=1
    }
    if (!gate.finishRecovery(owner,result == 1)) return 11
    result
}
