import "./software_devices_c6_sequence.ab"
import "../../i2c/software_provider.ab"
fun softwareI2cProviderPinsValid(sda: int,scl: int): bool = sda >= 0 && sda < 31 && scl >= 0 && scl < 31 && sda != scl
trusted fun softwareI2cProviderOpenOwner(sda: int,scl: int,halfPeriod: int,polls: int): SoftwareI2cProviderOwner =
    SoftwareI2cProviderOwner(esp32C6SoftwareI2cOpenOwned(sda,scl,halfPeriod,polls,true)|0)
trusted fun softwareI2cProviderCloseDevices(owner: SoftwareI2cProviderOwner,pool: I2cDeviceSlots): SoftwareI2cProviderOwner =
    SoftwareI2cProviderOwner(Esp32C6SoftwareI2cBus(owner|0).closeWithDevicesOwned(pool)|0)
trusted fun softwareI2cProviderRecoverOwner(owner: SoftwareI2cProviderOwner,clearStuck: bool): SoftwareI2cProviderOwner =
    SoftwareI2cProviderOwner(Esp32C6SoftwareI2cBus(owner|0).recoverOwned(clearStuck)|0)
