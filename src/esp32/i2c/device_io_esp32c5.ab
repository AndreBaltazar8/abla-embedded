import "./device_io_c5_sequence.ab"
import "./bus_esp32c5.ab"
import "./stream_esp32c5.ab"
import "./timing_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
@export("c5I2cDeviceIdle")
trusted fun c5I2cDeviceIdleHook(): bool {
    val status=u32(mmioLoadU32(0x60004008))
    (status&u32(16)) == u32(0) && esp32C5I2cTxCount(status) == 0 && esp32C5I2cRxCount(status) == 0
}
@export("c5I2cDeviceTiming")
trusted fun c5I2cDeviceTimingHook(timing: u32): bool = esp32C5I2cConfigureTimingOwned(0,Esp32C5I2cTiming(timing))
@export("c5I2cDeviceTransfer")
trusted fun c5I2cDeviceTransferHook(address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32C5I2cTransferOwned(0,address,output,written,input,read,budget,prefix)
