import "./device_io_c5_sequence.ab"
import "./bus_esp32c5.ab"
import "./stream_esp32c5.ab"
import "./timing_esp32c5.ab"
trusted fun c5I2cDeviceIdle(): bool {
    val status=u32(mmioLoadU32(0x60004008))
    (status&u32(16)) == u32(0) && esp32C5I2cTxCount(status) == 0 && esp32C5I2cRxCount(status) == 0
}
trusted fun c5I2cDeviceTiming(timing: u32): bool = esp32C5I2cConfigureTimingOwned(0,Esp32C5I2cTiming(timing))
trusted fun c5I2cDeviceTransfer(address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32C5I2cTransferOwned(0,address,output,written,input,read,budget,prefix)
