import "./clear_c5_sequence.ab"
import "./released_esp32c5.ab"
import "./poll_esp32c5.ab"
import "../../hal/delay.ab"
import "../../hal/esp32_i2c.ab"
@export("c5I2cClearPinsMatch")
trusted fun c5I2cClearPinsMatchHook(port: int,sda: int,scl: int): bool = esp32C5I2cConfiguredPinsMatchOwned(port,sda,scl)
@export("c5I2cClearReleased")
trusted fun c5I2cClearReleasedHook(port: int,sda: int,scl: int): bool = esp32C5I2cBusReleased(port,sda,scl)
@export("c5I2cClearCounter")
trusted fun c5I2cClearCounterHook(): u32 = esp32C5I2cReadCounter()
@export("c5I2cClearDelay")
trusted fun c5I2cClearDelayHook(us: int): void { peripheralDelayMicroseconds(us); return }
@export("c5I2cClearRead")
trusted fun c5I2cClearReadHook(pin: int): bool = (u32(mmioLoadU32(0x60091064))&(u32(1)<<u32(pin))) != u32(0)
@export("c5I2cClearWrite")
trusted fun c5I2cClearWriteHook(pin: int,high: bool): void {
    mmioStoreU32(if (high) 0x60091008 else 0x6009100C,int(u32(1)<<u32(pin)))
    return
}
@export("c5I2cClearCapture")
trusted fun c5I2cClearCaptureHook(pin: int): int {
    val latch=(u32(mmioLoadU32(0x60091004))>>>u32(pin))&u32(1)
    val enabled=(u32(mmioLoadU32(0x60091034))>>>u32(pin))&u32(1)
    val drain=(mmioLoadU32(0x600910D4+pin*4)>>>2)&1
    (mmioLoadU32(0x60091AD4+pin*4)&4294967295)|(int(latch)<<32)|(int(enabled)<<33)|(drain<<34)
}
@export("c5I2cClearPrepare")
trusted fun c5I2cClearPrepareHook(pin: int): void {
    val mask=int(u32(1)<<u32(pin))
    mmioStoreU32(0x6009103C,mask)
    c5I2cClearWrite(pin,true)
    c5I2cPinField(0x600910D4+pin*4,4,4)
    c5I2cPinField(0x60091AD4+pin*4,4095,1280)
    mmioStoreU32(0x60091038,mask)
    return
}
@export("c5I2cClearRestore")
trusted fun c5I2cClearRestoreHook(pin: int,saved: int): void {
    val mask=int(u32(1)<<u32(pin))
    c5I2cClearWrite(pin,true)
    mmioStoreU32(0x6009103C,mask)
    mmioStoreU32(0x60091AD4+pin*4,saved&4294967295)
    c5I2cPinField(0x600910D4+pin*4,4,if ((saved&(1<<34)) != 0) 4 else 0)
    c5I2cClearWrite(pin,(saved&(1<<32)) != 0)
    mmioStoreU32(if ((saved&(1<<33)) != 0) 0x60091038 else 0x6009103C,mask)
    return
}
