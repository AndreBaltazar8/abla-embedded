import "./clear_c5_sequence.ab"
import "./released_esp32c5.ab"
import "./poll_esp32c5.ab"
trusted fun c5I2cClearPinsMatch(port: int,sda: int,scl: int): bool = esp32C5I2cConfiguredPinsMatchOwned(port,sda,scl)
trusted fun c5I2cClearReleased(port: int,sda: int,scl: int): bool = esp32C5I2cBusReleased(port,sda,scl)
trusted fun c5I2cClearCounter(): u32 = esp32C5I2cReadCounter()
trusted fun c5I2cClearDelay(us: int): void { peripheralDelayMicroseconds(us); return }
trusted fun c5I2cClearRead(pin: int): bool = (u32(mmioLoadU32(0x60091064))&(u32(1)<<u32(pin))) != u32(0)
trusted fun c5I2cClearWrite(pin: int,high: bool): void {
    mmioStoreU32(if (high) 0x60091008 else 0x6009100C,int(u32(1)<<u32(pin)))
    return
}
trusted fun c5I2cClearCapture(pin: int): int {
    val latch=(u32(mmioLoadU32(0x60091004))>>>u32(pin))&u32(1)
    val enabled=(u32(mmioLoadU32(0x60091034))>>>u32(pin))&u32(1)
    val drain=(mmioLoadU32(0x600910D4+pin*4)>>>2)&1
    (mmioLoadU32(0x60091AD4+pin*4)&4294967295)|(int(latch)<<32)|(int(enabled)<<33)|(drain<<34)
}
trusted fun c5I2cClearPrepare(pin: int): void {
    val mask=int(u32(1)<<u32(pin))
    mmioStoreU32(0x6009103C,mask)
    c5I2cClearWrite(pin,true)
    c5I2cPinField(0x600910D4+pin*4,4,4)
    c5I2cPinField(0x60091AD4+pin*4,4095,1280)
    mmioStoreU32(0x60091038,mask)
    return
}
trusted fun c5I2cClearRestore(pin: int,saved: int): void {
    val mask=int(u32(1)<<u32(pin))
    c5I2cClearWrite(pin,true)
    mmioStoreU32(0x6009103C,mask)
    mmioStoreU32(0x60091AD4+pin*4,saved&4294967295)
    c5I2cPinField(0x600910D4+pin*4,4,if ((saved&(1<<34)) != 0) 4 else 0)
    c5I2cClearWrite(pin,(saved&(1<<32)) != 0)
    mmioStoreU32(if ((saved&(1<<33)) != 0) 0x60091038 else 0x6009103C,mask)
    return
}
