// C5 fixed LP SDA2/SCL3, IOMUX function3. Caller owns BOTH digital/LP pad
// paths, excludes LP CPU/ULP and shared-register writers, releases global
// force/sleep hold, and supplies an idle/reset open-drain LP-I2C controller.
// LP IO clocks must already be owned/enabled; do not steal or disable them.
trusted fun c5LpI2cPinField(address: int,mask: int,value: int): void {
    c5LpI2cPinStore(address,(c5LpI2cPinLoad(address)&~mask)|(value&mask))
    return
}
trusted fun esp32C5LpI2cPinsAvailableOwned(port: int,sda: int,scl: int): bool {
    if (port != 0 || sda != 2 || scl != 3) return false
    if ((c5LpI2cPinLoad(0x600B102C)&12) != 0 ||
        (c5LpI2cPinLoad(0x600B2800)&0x08000000) == 0 ||
        (c5LpI2cPinLoad(0x600B47F8)&1) == 0) return false
    true
}
trusted fun esp32C5LpI2cRoutePinsOwned(port: int,sda: int,scl: int,pulls: bool): bool {
    if (!esp32C5LpI2cPinsAvailableOwned(port,sda,scl)) return false
    c5LpI2cPinStore(0x6009103C,12)
    c5LpI2cPinStore(0x600B4418,12)
    c5LpI2cPinStore(0x600B4408,12)
    c5LpI2cPinField(0x600B4438,4,4)
    c5LpI2cPinField(0x600B4008,0x7382,0x3200|(if (pulls) 256 else 0))
    c5LpI2cPinField(0x600B443C,4,4)
    c5LpI2cPinField(0x600B400C,0x7382,0x3200|(if (pulls) 256 else 0))
    c5LpI2cPinStore(0x600B4414,12)
    // Select LP only after both pad configurations are complete.
    c5LpI2cPinField(0x600B1028,12,12)
    true
}
