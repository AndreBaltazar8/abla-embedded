import "./bus_io_c5_sequence.ab"
import "./bus_esp32c5.ab"
import "./stream_esp32c5.ab"
import "./recovery_esp32c5.ab"
import "./clear_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
@export("c5I2cBusTransfer")
trusted fun c5I2cBusTransferHook(address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32C5I2cTransferOwned(0,address,output,written,input,read,budget,prefix)
@export("c5I2cBusRecover")
trusted fun c5I2cBusRecoverHook(sda: int,scl: int,scratch: NativeBuffer): int = esp32C5I2cRecoverOwned(0,sda,scl,scratch)
@export("c5I2cBusClear")
trusted fun c5I2cBusClearHook(sda: int,scl: int,budget: u32): bool = esp32C5I2cClearStuckBusOwned(0,sda,scl,budget)
