import "./lp_poll_esp32c5.ab"
import "./lp_stream_c5_sequence.ab"
import "./lp_stream_chunk_c5_sequence.ab"
import "../../hal/esp32_i2c.ab"
import "abla/unsafe/mmio"
@export("c5LpI2cStreamLoad")
trusted fun c5LpI2cStreamLoadHook(address: int): int = mmioLoadU32(address)
trusted fun c5LpI2cStreamStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
