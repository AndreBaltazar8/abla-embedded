import "./lp_controller_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@export("c5LpI2cControllerLoad")
trusted fun c5LpI2cControllerLoadHook(address: int): int = mmioLoadU32(address)
@export("c5LpI2cControllerStore")
trusted fun c5LpI2cControllerStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
