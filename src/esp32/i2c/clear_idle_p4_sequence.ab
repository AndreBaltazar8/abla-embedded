import "./session_record_p4.ab"
import "../gpio/snapshot_p4_value.ab"
import "../../i2c/software_lines.ab"
// Explicit single-master clearing for an IDLE HP controller with a stuck
// slave. Busy/arbitrating controllers are refused, not reset behind a live
// transaction. Caller owns the session, GPIO/LP clocks and all external bus
// activity, and authorizes nine recovery clocks + STOP. No automatic replay.
// Separate retained40B recovery record: magic,stage,primary,cleanup,session,
// controllerResult,clockSnapshot64,dataSnapshot64. Must remain disjoint from
// session72B and all live memory. Zero it only before first use.
// stage2 means restore-only retry: never clock slaves again after a fault.
// stage3 is terminal; session remains fault-latched unless all phases succeed.
// Results1recovered2invalid3admission4restore5padSetup6SDAheld7SCLtimeout
// 8controllerCleanup. Preserve both records/exclusion on every failure.
trusted fun esp32p4I2cClearIdleOwned(r: NativeBuffer,session: NativeBuffer,
    halfPeriodUs: int,stretchPolls: int,budget: u32,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,40) || (r.addressValue()&3) != 0 ||
        !p4I2cSessionValid(session) || (session.loadU32(4) != 1 && session.loadU32(4) != 3) ||
        session.loadU32(24) != 3 || budget == u32(0) || budget > u32(0x7fffffff) ||
        halfPeriodUs < 5 || halfPeriodUs > 1000 || stretchPolls < 1 || stretchPolls > 1000000 ||
        (r.addressValue() < session.addressValue()+72 && session.addressValue() < r.addressValue()+40)) return 2
    if (r.loadU32(0) == 0) {
        if (!p4I2cClearIdleAdmission(session)) return 3
        val clock=p4I2cClearIdleCapture(session,0)
        val data=p4I2cClearIdleCapture(session,1)
        if (!clock.valid() || !data.valid() || clock.pin() == data.pin()) return 3
        r.storeU32(24,(clock|0)&0xffffffff);r.storeU32(28,(clock|0)>>>32)
        r.storeU32(32,(data|0)&0xffffffff);r.storeU32(36,(data|0)>>>32)
        r.storeU32(0,0x4932434c);r.storeU32(4,2);r.storeU32(8,5);r.storeU32(12,0)
        r.storeU32(16,session.addressValue());r.storeU32(20,0)
        session.storeU32(4,2)
        // Both snapshots published BEFORE any GPIO mutation. Checked setup
        // releases open-drain latches; input routes are never modified.
        if (p4I2cClearIdlePrepare(clock.pin()) && p4I2cClearIdlePrepare(data.pin())) {
            val lines=softwareI2cLines(data.pin(),clock.pin(),halfPeriodUs,stretchPolls)
            val cleared=lines.recoverOwned(true)
            r.storeU32(8,if (cleared == 1) 1 else if (cleared == 3) 7 else 6)
        }
    } else if (r.loadU32(0) != 0x4932434c || r.loadU32(16) != session.addressValue() ||
        (r.loadU32(4) != 2 && r.loadU32(4) != 3)) return 2
    // A completed recovery record cannot clear a later session fault.
    if (r.loadU32(4) == 3) return if (r.loadU32(8) == 1 && session.loadU32(4) != 1) 3 else r.loadU32(8)
    val clock=P4GpioSnapshot(r.loadU32(24)|(r.loadU32(28)<<32))
    val data=P4GpioSnapshot(r.loadU32(32)|(r.loadU32(36)<<32))
    if (!clock.valid() || !data.valid() || clock.pin() == data.pin()) return 2
    session.storeU32(4,3)
    // Keep admissions closed even if one restore fails; try both releases.
    val restoredClock=p4I2cClearIdleRestore(clock)
    val restoredData=p4I2cClearIdleRestore(data)
    if (!restoredClock || !restoredData) {
        r.storeU32(12,(if (restoredClock) 0 else 1)|(if (restoredData) 0 else 2));return 4
    }
    r.storeU32(12,0)
    if (r.loadU32(8) == 1) {
        val recovered=p4I2cClearIdleFinish(session,budget)
        r.storeU32(20,recovered)
        if (recovered != 1) { r.storeU32(8,8) }
    }
    r.storeU32(4,3)
    if (r.loadU32(8) == 1) { session.storeU32(12,0);session.storeU32(4,1) }
    return r.loadU32(8)
}
