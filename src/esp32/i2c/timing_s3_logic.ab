// ESP32-S3 i2c_ll_master_cal_bus_clk and register field widths, IDF6.0.2.
// Encodes half-cycle, divider-1 and wait-high in one word. Invalid input is
// zero; no allocation, division by zero, or silent register-field truncation.
type Esp32S3I2cTiming = u32

fun esp32S3I2cTiming(sourceHz: u32, busHz: u32): Esp32S3I2cTiming {
    if (sourceHz == u32(0) || busHz == u32(0) || busHz > u32(1000000)) return Esp32S3I2cTiming(u32(0))
    val divider = sourceHz / (busHz * u32(1024)) + u32(1)
    if (divider > u32(256)) return Esp32S3I2cTiming(u32(0))
    val half = sourceHz / divider / busHz / u32(2)
    if (half < u32(4) || half > u32(511)) return Esp32S3I2cTiming(u32(0))
    val wait = if (busHz >= u32(80000)) half / u32(2) - u32(2) else half / u32(4)
    val sample = half / u32(2)
    if (wait > u32(127) || wait >= sample || sample >= half - wait) return Esp32S3I2cTiming(u32(0))
    Esp32S3I2cTiming(u32(16777216) | half | ((divider - u32(1)) << u32(9)) | (wait << u32(17)))
}

fun Esp32S3I2cTiming.valid(): bool {
    val half = this.halfCycle()
    val wait = this.waitHigh()
    // Reject forged nominal values too, before register subtraction or MMIO.
    (this & u32(0xfe000000)) == u32(0) &&
        (this & u32(16777216)) != u32(0) && half >= u32(4) &&
        wait < half / u32(2) && half / u32(2) < half - wait
}
fun Esp32S3I2cTiming.halfCycle(): u32 = this & u32(511)
fun Esp32S3I2cTiming.dividerRegister(): u32 = (this >>> u32(9)) & u32(255)
fun Esp32S3I2cTiming.waitHigh(): u32 = (this >>> u32(17)) & u32(127)
fun Esp32S3I2cTiming.highPeriod(): u32 = this.halfCycle() - this.waitHigh()
fun Esp32S3I2cTiming.timeoutExponent(): u32 {
    var remaining = this.halfCycle() * u32(5)
    var bits = u32(0)
    while (remaining != u32(0)) {
        remaining = remaining >>> u32(1)
        bits = bits + u32(1)
    }
    bits + u32(2)
}
