import "./lp_poll_c5_sequence.ab"
import "./lp_fifo_esp32c5.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun c5LpI2cCounterInstruction(template: string,constraints: string): u32
// HP CPU machine-mode access to LP peripheral; NOT code for the LP CPU.
// Caller keeps this counter running and CPU clock stable for the deadline.
trusted fun esp32C5LpI2cReadCounter(): u32 = c5LpI2cCounterInstruction("csrr $0, mcycle","=r,~{memory}")
trusted fun c5LpI2cPollLoad(address: int): int = mmioLoadU32(address)
trusted fun c5LpI2cPollStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
