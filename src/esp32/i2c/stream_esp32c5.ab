import "./poll_esp32c5.ab"
import "./stream_c5_sequence.ab"
import "./stream_chunk_c5_sequence.ab"
import "../../hal/esp32_i2c.ab"
import "abla/unsafe/mmio"
@export("c5I2cStreamLoad")
trusted fun c5I2cStreamLoadHook(address: int): int = mmioLoadU32(address)
trusted fun c5I2cStreamStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
