import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRegisterI2cControlOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredRegi2cCtrlReadReg", "regi2c_ctrl_read_reg")) return false
    if (!exportFunction("esp32RecoveredRegi2cCtrlReadRegMask", "regi2c_ctrl_read_reg_mask")) return false
    if (!exportFunction("esp32RecoveredRegi2cCtrlWriteReg", "regi2c_ctrl_write_reg")) return false
    if (!exportFunction("esp32RecoveredRegi2cCtrlWriteRegMask", "regi2c_ctrl_write_reg_mask")) return false
    if (!exportFunction("esp32RecoveredRegi2cEnterCritical", "regi2c_enter_critical")) return false
    if (!exportFunction("esp32RecoveredRegi2cExitCritical", "regi2c_exit_critical")) return false
    if (!internalFunction("esp32RecoveredRegi2cSaradcEnable", "regi2c_saradc_enable")) return false
    if (!internalFunction("esp32RecoveredRegi2cSaradcDisable", "regi2c_saradc_disable")) return false
    true
}
