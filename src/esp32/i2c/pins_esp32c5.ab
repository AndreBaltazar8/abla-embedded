import "./pins_c5_sequence.ab"
import "abla/unsafe/mmio"
trusted fun c5I2cPinLoad(address: int): int = mmioLoadU32(address)
trusted fun c5I2cPinStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun esp32C5I2cRoutePins(port: int,sda: int,scl: int,pullup: bool = true): bool =
    esp32C5I2cRoutePinsOwned(port,sda,scl,pullup)
