// 1closed,2invalid,3busy,4pad/clock ownership mismatch,5clock-disable
// unconfirmed after pad release. Retain ownership on failures; retry is safe.
trusted fun esp32C5LpI2cTeardownOwned(port: int,sda: int,scl: int): int {
    if (port != 0 || sda != 2 || scl != 3) return 2
    if (c5LpI2cTeardownBusy()) return 3
    if (!c5LpI2cTeardownRelease()) return 4
    if (!c5LpI2cTeardownDisable()) return 5
    1
}
