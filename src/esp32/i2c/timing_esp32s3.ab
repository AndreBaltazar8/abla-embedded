import "./timing_s3_logic.ab"
import "abla/unsafe/mmio"

trusted fun esp32S3I2cTimingField(address: int, mask: u32, value: u32): void {
    mmioStoreU32(address, int((u32(mmioLoadU32(address)) & ~mask) | (value & mask)))
    return
}

// Caller owns an idle, clock-enabled controller and supplies its actual
// selected source frequency. This configures timing only, not pins or clocks.
trusted fun esp32S3I2cConfigureTiming(port: int, timing: Esp32S3I2cTiming): bool {
    if (port < 0 || port > 1 || !timing.valid()) return false
    val base = if (port == 0) 0x60013000 else 0x60027000
    val half = timing.halfCycle()
    // Integer divider, no fractional component. Preserve source/enable bits.
    esp32S3I2cTimingField(base + 0x54, u32(0xfffff), timing.dividerRegister())
    esp32S3I2cTimingField(base, u32(511), half - u32(1))
    esp32S3I2cTimingField(base + 0x38, u32(65535), timing.highPeriod() | (timing.waitHigh() << u32(9)))
    esp32S3I2cTimingField(base + 0x30, u32(511), half / u32(4) - u32(1))
    esp32S3I2cTimingField(base + 0x34, u32(511), half / u32(2) - u32(1))
    esp32S3I2cTimingField(base + 0x40, u32(511), half - u32(1))
    esp32S3I2cTimingField(base + 0x44, u32(511), half - u32(1))
    esp32S3I2cTimingField(base + 0x48, u32(511), half - u32(1))
    esp32S3I2cTimingField(base + 0x4c, u32(511), half - u32(1))
    // The LL exponent (~100us at 100kHz) trips on clock-stretching MCU slaves
    // such as M5PM1/M5IOE1 reads. M5GFX (M5Unified's S3 I2C) uses 2^21 cycles.
    val exponent = timing.timeoutExponent()
    esp32S3I2cTimingField(base + 0x0c, u32(63), (if (exponent < u32(21)) u32(21) else exponent) | u32(32))
    esp32S3I2cTimingField(base + 0x04, u32(2048), u32(2048))
    true
}
