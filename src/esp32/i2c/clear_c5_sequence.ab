// Explicit SINGLE-MASTER stuck-slave clearing; caller authorizes slave clocks.
// Controller already reset, pads owned/configured, CPU stable/counter running.
// Never use while another master may own bus. At most9 recovery clocks+STOP;
// one cycle deadline covers stretching. Always restore captured GPIO state.
trusted fun c5I2cClearWaitClock(scl: int,started: u32,budget: u32): bool {
    while (c5I2cClearCounter()-started < budget) {
        if (c5I2cClearRead(scl)) return true
        c5I2cClearDelay(1)
    }
    false
}
trusted fun esp32C5I2cClearStuckBusOwned(port: int,sda: int,scl: int,budget: u32): bool {
    if (budget == u32(0) || budget > u32(0x7FFFFFFF) || !c5I2cClearPinsMatch(port,sda,scl)) return false
    if (c5I2cClearReleased(port,sda,scl)) return true
    val savedData=c5I2cClearCapture(sda)
    val savedClock=c5I2cClearCapture(scl)
    val started=c5I2cClearCounter()
    c5I2cClearPrepare(sda)
    c5I2cClearPrepare(scl)
    c5I2cClearWrite(scl,false)
    c5I2cClearDelay(5)
    var healthy=true
    var pulses=0
    while (healthy && !c5I2cClearRead(sda) && pulses < 9) {
        c5I2cClearWrite(scl,true)
        healthy=c5I2cClearWaitClock(scl,started,budget)
        if (healthy) {
            c5I2cClearDelay(5)
            c5I2cClearWrite(scl,false)
            c5I2cClearDelay(5)
        }
        pulses=pulses+1
    }
    if (healthy) {
        c5I2cClearWrite(sda,false)
        c5I2cClearWrite(scl,true)
        healthy=c5I2cClearWaitClock(scl,started,budget)
        if (healthy) {
            c5I2cClearDelay(5)
            c5I2cClearWrite(sda,true)
            c5I2cClearDelay(5)
            healthy=c5I2cClearRead(sda) && c5I2cClearRead(scl) && c5I2cClearCounter()-started < budget
        }
    }
    c5I2cClearRestore(scl,savedClock)
    c5I2cClearRestore(sda,savedData)
    healthy && c5I2cClearReleased(port,sda,scl)
}
