import "./lp_clock_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@export("c5LpI2cClockLoad")
trusted fun c5LpI2cClockLoadHook(address: int): int = mmioLoadU32(address)
@export("c5LpI2cClockStore")
trusted fun c5LpI2cClockStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
