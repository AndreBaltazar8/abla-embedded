import "./hardware_provider_p4.ab"
// Opt-in scan contract: caller excludes ALL other physical bus masters and
// owns the scan interval. This is stronger than taking the provider's mutex.
// Ready path only observes hardware. Fault path may finish this owner's NACK
// with STOP, but never recovers arbitration, timeout, FIFO or setup failures.
// 1prepared2invalid/stale3prior non-NACK fault4busy/recovery blocked.
trusted fun I2cBus.prepareProbeStatus(): int {
    if (!this.valid()) return 2
    if (!p4HardwareEnter()) return 4
    var result=2
    if (this.current()) {
        val r=p4HardwareSession()
        if (r.loadU32(4) == 1) result=if (p4HardwareProbeReady(r)) 1 else 4
        else if (r.loadU32(4) != 3 || r.loadU32(8) != 3 || r.loadU32(24) != 3 ||
            (r.loadU32(12) != 0 && r.loadU32(12) != 3)) result=3
        else {
            r.storeU32(4,2)
            val perMs=(u32(p4HardwareLoad(16))+u32(999))/u32(1000)
            val raw=p4HardwareRecover(r,perMs*u32(50),true)
            r.storeU32(12,if (raw == 1) 0 else raw)
            r.storeU32(4,if (raw == 1) 1 else 3)
            // Primary remains available; a stronger cleanup error blocks the
            // next prepared scan from repeating STOP after late arbitration.
            result=if (raw == 1) 1 else 4
        }
    }
    if (!p4HardwareLeave()) return 4
    return result
}
