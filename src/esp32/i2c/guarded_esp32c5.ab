import "./guarded_c5_sequence.ab"
import "./stream_esp32c5.ab"
trusted fun c5I2cGuardedTransfer(port: int,address: int,output: NativeBuffer,written: int,
    input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32C5I2cTransferOwned(port,address,output,written,input,read,budget,prefix)
trusted fun esp32C5I2cTransferGuarded(gate: PeripheralGate,owner: u32,port: int,address: int,
    output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int = -1): int =
    esp32C5I2cTransferGuardedOwned(gate,owner,port,address,output,written,input,read,budget,prefix)
