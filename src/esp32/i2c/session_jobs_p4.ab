import "./jobs_p4_bindings.ab"
import "./session_record_p4.ab"
// Retained-session multi-phase jobs. Caller serializes the entire operation,
// including the immutable table/payloads, and owns physical bus exclusivity.
// Validate every span before marking the session transferring. Any execution
// error retains a faulted session; there is no implicit retry or STOP.
trusted fun esp32p4I2cSessionJobsOwned(r: NativeBuffer,jobs: NativeBuffer,count: int,budget: u32,exclusive: bool): int {
    if (!exclusive || !p4I2cSessionValid(r) || r.loadU32(4) != 1 || r.loadU32(24) != 3 ||
        budget == u32(0) || budget > u32(0x7fffffff) || !i2cJobsValid(jobs,count)) return 7
    if (jobs.addressValue() < r.addressValue()+72 && r.addressValue() < jobs.addressValue()+count*16) return 7
    var i=0
    while (i < count) {
        val address=jobs.loadU32(i*16+8);val bytes=jobs.loadU32(i*16+4)
        if (bytes > 0 && address < r.addressValue()+72 && r.addressValue() < address+bytes) return 7
        i=i+1
    }
    r.storeU32(4,2)
    val result=i2cJobsRunOwned(r.loadU32(20),jobs,count,budget)
    r.storeU32(8,result);r.storeU32(4,if (result == 1) 1 else 3)
    return result
}
