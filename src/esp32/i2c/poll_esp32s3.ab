import "./fifo_esp32s3.ab"
import "./timing_esp32s3.ab"
import "./status_s3_logic.ab"

// Architecture boundary only. No ROM/SDK scheduler or allocator dependency.
trusted noescape extern:"inline-assembly" fun esp32S3I2cCounterInstruction(
    template: string, constraints: string
): u32

trusted fun esp32S3I2cReadCounter(): u32 =
    esp32S3I2cCounterInstruction("rsr.ccount $0", "=a,~{memory}")

// Execute one fully queued, <=32-byte TX/RX command batch. Controller, FIFO,
// clock frequency and bus ownership must remain exclusive/stable throughout.
// Continuation is allowed only after this owner's preceding END result.
// On any error caller must perform recovery before reusing the controller;
// notably we must NOT generate STOP after losing arbitration to another master.
trusted fun esp32S3I2cRunBatch(port: int, lastCommand: int,
    timeoutCycles: u32, continuation: bool = false): int {
    val base = esp32S3I2cControllerAddress(port)
    if (base == 0 || lastCommand < 0 || lastCommand >= 8 ||
        timeoutCycles == u32(0) || timeoutCycles > u32(0x7fffffff)) return 7
    var index = 0
    var writeCount = 0
    var readCount = 0
    var terminal = 0
    while (index <= lastCommand) {
        val command = u32(mmioLoadU32(base + 0x58 + index * 4))
        if (!esp32S3I2cCommandValid(command)) return 7
        val operation = int((command >>> u32(11)) & u32(7))
        val count = int(command & u32(255))
        if (operation == 1) writeCount = writeCount + count
        if (operation == 3) readCount = readCount + count
        if (index < lastCommand && (operation == 2 || operation == 4)) return 7
        if (index == lastCommand) terminal = operation
        index = index + 1
    }
    if ((terminal != 2 && terminal != 4) || writeCount > 32 || readCount > 32) return 7
    val status = u32(mmioLoadU32(base + 8))
    if (!continuation && (status & u32(16)) != u32(0)) return 8
    if (esp32S3I2cTxCount(status) != writeCount || esp32S3I2cRxCount(status) != 0) return 7
    mmioStoreU32(base + 0x24, 0x3ffff)
    val start = esp32S3I2cReadCounter()
    esp32S3I2cTimingField(base + 4, u32(2048), u32(2048))
    esp32S3I2cTimingField(base + 4, u32(32), u32(32))
    while (true) {
        val result = esp32S3I2cPollResult(u32(mmioLoadU32(base + 0x20)), terminal == 2)
        if (result >= 3) return result
        if (result != 0 && (u32(mmioLoadU32(base + 0x58 + lastCommand * 4)) & u32(0x80000000)) != u32(0)) return result
        if (esp32S3I2cDeadlineExpired(start, esp32S3I2cReadCounter(), timeoutCycles)) return 5
    }
    return 5
}
