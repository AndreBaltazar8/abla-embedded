import "./timing_s3_logic.ab"
// C5 LL uses the same timing arithmetic/field widths as S3, but a different
// PCR divider layout. Reuse pure calculation only, never S3 MMIO.
type Esp32C5I2cTiming = u32
fun esp32C5I2cTiming(sourceHz: u32,busHz: u32): Esp32C5I2cTiming =
    Esp32C5I2cTiming(esp32S3I2cTiming(sourceHz,busHz) | u32(0))
fun Esp32C5I2cTiming.valid(): bool = Esp32S3I2cTiming(this | u32(0)).valid()
trusted fun esp32C5I2cTimingField(address: int,mask: u32,value: u32): void {
    c5I2cTimingStore(address,int((u32(c5I2cTimingLoad(address))&~mask)|(value&mask)))
    return
}
// HP I2C0 only. Caller owns idle, clock-enabled controller and PCR updates,
// supplies actual selected source frequency, and keeps it stable while active.
// Configures timing, not clocks/pins/FIFO/transactions. Commit update LAST.
trusted fun esp32C5I2cConfigureTimingOwned(port: int,value: Esp32C5I2cTiming): bool {
    if (port != 0 || !value.valid()) return false
    val timing=Esp32S3I2cTiming(value | u32(0))
    val half=timing.halfCycle()
    esp32C5I2cTimingField(0x60096024,u32(0xFFFFF),timing.dividerRegister()<<u32(12))
    esp32C5I2cTimingField(0x60004000,u32(511),half-u32(1))
    esp32C5I2cTimingField(0x60004038,u32(65535),timing.highPeriod()|(timing.waitHigh()<<u32(9)))
    esp32C5I2cTimingField(0x60004030,u32(511),half/u32(4)-u32(1))
    esp32C5I2cTimingField(0x60004034,u32(511),half/u32(2)-u32(1))
    esp32C5I2cTimingField(0x60004040,u32(511),half-u32(1))
    esp32C5I2cTimingField(0x60004044,u32(511),half-u32(1))
    esp32C5I2cTimingField(0x60004048,u32(511),half-u32(1))
    esp32C5I2cTimingField(0x6000404C,u32(511),half-u32(1))
    esp32C5I2cTimingField(0x6000400C,u32(63),timing.timeoutExponent()|u32(32))
    esp32C5I2cTimingField(0x60004004,u32(2048),u32(2048))
    true
}
