// Status1 closed,2 invalid,3 busbusy,4 held/LP-owned pads,5 clock shutdown
// unconfirmed after successful pad release. Never close ownership on status5;
// caller retains state and may retry. No STOP, reset, or FIFO dropping here.
type Esp32C5I2cTeardown = int
fun Esp32C5I2cTeardown.status(): int = this | 0
fun Esp32C5I2cTeardown.valid(): bool = this == 1
fun Esp32C5I2cTeardown.pinsReleased(): bool = this == 1 || this == 5
trusted fun esp32C5I2cTeardownOwned(port: int,sda: int,scl: int): Esp32C5I2cTeardown {
    if (port != 0 || sda == scl || sda < 0 || sda > 28 || scl < 0 || scl > 28 ||
        sda == 13 || sda == 14 || scl == 13 || scl == 14) return Esp32C5I2cTeardown(2)
    if (c5I2cTeardownBusy()) return Esp32C5I2cTeardown(3)
    if (!c5I2cTeardownRelease(sda,scl)) return Esp32C5I2cTeardown(4)
    if (!c5I2cTeardownDisable()) return Esp32C5I2cTeardown(5)
    Esp32C5I2cTeardown(1)
}
