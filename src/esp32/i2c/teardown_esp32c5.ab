import "./teardown_c5_sequence.ab"
import "./pins_esp32c5.ab"
import "./clock_esp32c5.ab"
import "../../hal/esp32_i2c.ab"
import "abla/unsafe/mmio"
import "./pins_c5_sequence.ab"
@export("c5I2cTeardownBusy")
trusted fun c5I2cTeardownBusyHook(): bool = (mmioLoadU32(0x60004008)&16) != 0
@export("c5I2cTeardownRelease")
trusted fun c5I2cTeardownReleaseHook(sda: int,scl: int): bool = esp32C5I2cReleasePinsOwned(0,sda,scl)
@export("c5I2cTeardownDisable")
trusted fun c5I2cTeardownDisableHook(): bool = esp32C5I2cDisableClock(0)
