import "./teardown_c5_sequence.ab"
import "./pins_esp32c5.ab"
import "./clock_esp32c5.ab"
trusted fun c5I2cTeardownBusy(): bool = (mmioLoadU32(0x60004008)&16) != 0
trusted fun c5I2cTeardownRelease(sda: int,scl: int): bool = esp32C5I2cReleasePinsOwned(0,sda,scl)
trusted fun c5I2cTeardownDisable(): bool = esp32C5I2cDisableClock(0)
