import "./device_s3_logic.ab"
import "./timing_s3_logic.ab"
import "../../i2c/device_slots.ab"
// Caller holds the current ready controller gate. Change future transactions
// only; preserve device handle, address, port, and controller generation.
trusted fun esp32S3I2cDeviceFrequencyOwned(pool: I2cDeviceSlots,handle: int,bus: int,sourceHz: u32,frequency: int): bool {
    if (frequency < 1 || frequency > 1000000 || !esp32S3I2cBusKeyValid(bus) ||
        !esp32S3I2cTiming(sourceHz,u32(frequency)).valid()) return false
    val before=pool.resolve(handle)
    if (!esp32S3I2cDeviceKeyMatchesBus(before,bus)) return false
    val after=esp32S3I2cDeviceKey(esp32S3I2cDeviceKeyPort(before),esp32S3I2cDeviceKeyAddress(before),
        frequency,esp32S3I2cDeviceKeyGeneration(before))
    return pool.replace(handle,before,after)
}
