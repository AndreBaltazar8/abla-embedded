import "./hardware_provider_p4.ab"
// Scan/probe does not allocate device slots. One gate covers timing and probe.
// Address NACK is nonfatal ONLY when the primitive proves STOP+idle+empty.
// 1present2invalid3timeout4busy/arbitration5absent6transport7priorfault.
trusted fun I2cBus.probeStatus(address: int,timeoutMilliseconds: int = 50): int {
    if (!this.valid() || address < 1 || address > 127 || timeoutMilliseconds < 1 || timeoutMilliseconds > 1000000) return 2
    if (!p4HardwareEnter()) return 4
    var result=2
    if (this.current()) {
        val r=p4HardwareSession()
        val perMs=(u32(p4HardwareLoad(16))+u32(999))/u32(1000)
        if (r.loadU32(4) != 1) result=7
        else if (u32(timeoutMilliseconds) <= u32(2147483647)/perMs) {
            r.storeU32(4,2)
            if (p4I2cSessionTiming(r.loadU32(20),esp32p4I2cTiming(u32(p4HardwareLoad(12)),u32(100000))) != 1) {
                r.storeU32(8,5);r.storeU32(4,3);result=6
            } else {
                val raw=p4HardwareProbe(r.loadU32(20),address,perMs*u32(timeoutMilliseconds))
                r.storeU32(8,raw);r.storeU32(4,if (raw == 1 || raw == 9) 1 else 3)
                // This probe disabled ACK checking. A raw NACK interrupt is
                // unexpected, not the ordinary data-write NACK eligible for
                // prepared-scan STOP. Preserve raw evidence, block that path.
                if (raw == 3) r.storeU32(12,7)
                result=if (raw == 1) 1 else if (raw == 9) 5 else if (raw == 5) 3 else if (raw == 4 || raw == 8) 4 else if (raw == 7) 2 else 6
            }
        }
    }
    if (!p4HardwareLeave()) return 4
    return result
}
trusted fun I2cBus.probe(address: int,timeoutMilliseconds: int = 50): bool = this.probeStatus(address,timeoutMilliseconds) == 1
