import "./software_devices_p4_sequence.ab"
import "../../i2c/software_provider.ab"
// Existing P4 helper names remain aliases; state and policy are shared.
val p4SoftwareProviderState=softwareI2cProviderState
val p4SoftwareProviderSlots=softwareI2cProviderSlots
fun p4SoftwareProviderPool(): I2cDeviceSlots = softwareI2cProviderPool()
trusted fun p4SoftwareProviderLoad(offset: int): int = softwareI2cProviderLoad(offset)
trusted fun p4SoftwareProviderStore(offset: int,value: int): void = softwareI2cProviderStore(offset,value)
trusted fun p4SoftwareProviderOwner(): Esp32P4SoftwareI2cBus = Esp32P4SoftwareI2cBus(softwareI2cProviderOwner()|0)
trusted fun p4SoftwareProviderSave(owner: Esp32P4SoftwareI2cBus): void = softwareI2cProviderSave(SoftwareI2cProviderOwner(owner|0))
trusted fun p4SoftwareProviderEnter(): bool = softwareI2cProviderEnter()
trusted fun p4SoftwareProviderLeave(): bool = softwareI2cProviderLeave()
trusted fun p4SoftwareProviderPrepare(): int = softwareI2cProviderPrepare()
trusted fun p4SoftwareProviderClose(): bool = softwareI2cProviderClose()
fun p4SoftwareProviderBufferSafe(buffer: NativeBuffer,length: int): bool = softwareI2cProviderBufferSafe(buffer,length)
trusted fun esp32P4SoftwareI2cAbortSetup(): bool = i2cSoftwareAbortSetup()
fun softwareI2cProviderPinsValid(sda: int,scl: int): bool = sda >= 0 && sda <= 54 && scl >= 0 && scl <= 54 && sda != scl
trusted fun softwareI2cProviderOpenOwner(sda: int,scl: int,halfPeriod: int,polls: int): SoftwareI2cProviderOwner =
    SoftwareI2cProviderOwner(esp32P4SoftwareI2cOpenOwned(sda,scl,halfPeriod,polls)|0)
trusted fun softwareI2cProviderCloseDevices(owner: SoftwareI2cProviderOwner,pool: I2cDeviceSlots): SoftwareI2cProviderOwner =
    SoftwareI2cProviderOwner(Esp32P4SoftwareI2cBus(owner|0).closeWithDevicesOwned(pool)|0)
trusted fun softwareI2cProviderRecoverOwner(owner: SoftwareI2cProviderOwner,clearStuck: bool): SoftwareI2cProviderOwner =
    SoftwareI2cProviderOwner(Esp32P4SoftwareI2cBus(owner|0).recoverOwned(clearStuck)|0)
