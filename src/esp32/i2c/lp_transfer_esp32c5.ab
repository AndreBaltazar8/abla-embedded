import "./lp_poll_esp32c5.ab"
import "./lp_transfer_c5_sequence.ab"
import "../../hal/esp32_i2c.ab"
import "abla/unsafe/mmio"
@export("c5LpI2cTransferLoad")
trusted fun c5LpI2cTransferLoadHook(address: int): int = mmioLoadU32(address)
@export("c5LpI2cTransferStore")
trusted fun c5LpI2cTransferStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
