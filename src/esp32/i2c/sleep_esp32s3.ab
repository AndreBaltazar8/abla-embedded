import "./sleep_s3_sequence.ab"
import "../i2c_esp32s3.ab"
trusted fun s3I2cSleepAcquire(bus: int): int = peripheralGateAt(esp32S3I2cState(esp32S3I2cBusKeyPort(bus))).tryBegin(u32(2))
trusted fun s3I2cSleepHeld(bus: int): bool = peripheralGateAt(esp32S3I2cState(esp32S3I2cBusKeyPort(bus))).word().compareExchange(u32(2),u32(2)) == u32(2)
trusted fun s3I2cSleepRelease(bus: int): bool = peripheralGateAt(esp32S3I2cState(esp32S3I2cBusKeyPort(bus))).finish(u32(2),true)
trusted fun s3I2cSleepBusOpen(bus: int): bool = esp32S3I2cBusKeyOpen(esp32S3I2cState(esp32S3I2cBusKeyPort(bus)),bus)
trusted fun s3I2cSleepIdle(bus: int): bool {
    val status=u32(mmioLoadU32(esp32S3I2cControllerAddress(esp32S3I2cBusKeyPort(bus))+8))
    return (status&u32(16)) == u32(0) && esp32S3I2cTxCount(status) == 0 && esp32S3I2cRxCount(status) == 0
}
trusted fun I2cBus.pauseForSleepOwned(): S3I2cSleepLease = esp32S3I2cPauseForSleepOwned(this|0)
