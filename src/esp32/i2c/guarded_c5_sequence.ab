import "../../peripheral_gate.ab"
import "../sdk/raw_buffer.ab"
// One canonical shared gate per physical controller, also used by lifecycle
// and recovery. No implicit allocation/pad/clock setup. Unique owner tokens.
// 9 busy,10 recoveryrequired,11 ownershipviolation; other codes from transfer.
trusted fun esp32C5I2cTransferGuardedOwned(gate: PeripheralGate,owner: u32,port: int,address: int,
    output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,registerPrefix: int = -1): int {
    if (!gate.word().valid() || !peripheralOwnerValid(owner) || port != 0 || address < 0 || address > 127 ||
        !output.hasAddressRange(0,written) || !input.hasAddressRange(0,read) ||
        budget == u32(0) || budget > u32(0x7FFFFFFF) || registerPrefix < -1 || registerPrefix > 255) return 7
    val gateAddress=gate.word().address()
    // A receive buffer must never overwrite the live atomic gate; also forbid
    // reading gate bytes as payload while its owner token changes.
    if (written > 0 && output.addressValue() < gateAddress+4 && gateAddress < output.addressValue()+written ||
        read > 0 && input.addressValue() < gateAddress+4 && gateAddress < input.addressValue()+read) return 7
    val admission=gate.tryBegin(owner)
    if (admission == 1) return 9
    if (admission == 2) return 10
    if (admission != 0) return 7
    val result=c5I2cGuardedTransfer(port,address,output,written,input,read,budget,registerPrefix)
    // All failures fault admission: even BUS_BUSY may occur after preloading.
    if (!gate.finish(owner,result == 1)) return 11
    result
}
