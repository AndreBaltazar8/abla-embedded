import "./software_bus_c6_sequence.ab"
import "../../i2c/software_devices.ab"
fun Esp32C6SoftwareI2cBus.matchesDevice(descriptor: int): bool = this.lines().matchesDevice(descriptor)
trusted fun Esp32C6SoftwareI2cBus.deviceOwned(pool: I2cDeviceSlots,address: int,frequency: int): int =
    if (this.ready()) this.lines().deviceOwned(pool,address,frequency) else 0
trusted fun Esp32C6SoftwareI2cBus.transferDeviceOwned(pool: I2cDeviceSlots,handle: int,tx: NativeBuffer,txLength: int,rx: NativeBuffer,rxLength: int,prefix: int = -1): SoftwareI2cTransfer =
    if (this.ready()) this.lines().transferDeviceOwned(pool,handle,tx,txLength,rx,rxLength,prefix) else SoftwareI2cTransfer(2)
trusted fun Esp32C6SoftwareI2cBus.closeDeviceOwned(pool: I2cDeviceSlots,handle: int): bool = this.lines().closeDeviceOwned(pool,handle)
// Status9 retains pad ownership if handle revocation fails; retry this close,
// never bypass it with raw pad close or attempt to recover a closing bus.
trusted fun Esp32C6SoftwareI2cBus.closeWithDevicesOwned(pool: I2cDeviceSlots): Esp32C6SoftwareI2cBus {
    if (!this.lines().revokeDevicesOwned(pool)) return Esp32C6SoftwareI2cBus((this&~(255<<48))|(9<<48))
    return this.closeOwned()
}
