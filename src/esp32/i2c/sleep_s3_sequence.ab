import "./device_s3_logic.ab"
import "abla/runtime/scalar"
// Key33, status8@33, owned41. Reserve canonical peripheral gate token2;
// ordinary transfers use1. No spinning, no clock/reset/pad writes, no slots
// revoked. Caller retains lease+gate in internal RAM and keeps digital I2C
// powered; clocks must be restored BEFORE resuming transfer admission.
// Status1paused2invalid3busy4fault5notidle6released. Faults may retain ownership.
type S3I2cSleepLease=int
fun S3I2cSleepLease.bus(): int = this&0x1ffffffff
fun S3I2cSleepLease.status(): int = (this>>>33)&255
fun S3I2cSleepLease.owned(): bool = (this>>>41) == 1 && esp32S3I2cBusKeyValid(this.bus())
trusted fun S3I2cSleepLease.pausedOwned(): bool = this.owned() && this.status() == 1 && s3I2cSleepHeld(this.bus()) && s3I2cSleepBusOpen(this.bus()) && s3I2cSleepIdle(this.bus())
trusted fun esp32S3I2cPauseForSleepOwned(bus: int): S3I2cSleepLease {
    if (!esp32S3I2cBusKeyValid(bus)) return S3I2cSleepLease(2<<33)
    val admitted=s3I2cSleepAcquire(bus)
    if (admitted != 0) return S3I2cSleepLease(bus|((if (admitted == 1) 3 else 4)<<33))
    val status=if (!s3I2cSleepBusOpen(bus)) 2 else if (!s3I2cSleepIdle(bus)) 5 else 1
    if (status == 1) return S3I2cSleepLease(bus|(1<<33)|(1<<41))
    if (!s3I2cSleepRelease(bus)) return S3I2cSleepLease(bus|(4<<33)|(1<<41))
    return S3I2cSleepLease(bus|(status<<33))
}
trusted fun S3I2cSleepLease.resumeOwned(clocksRestored: bool): S3I2cSleepLease {
    if (!clocksRestored || !this.owned()) return this
    if (!s3I2cSleepBusOpen(this.bus())) return S3I2cSleepLease(this.bus()|(4<<33)|(1<<41))
    if (!s3I2cSleepIdle(this.bus())) return S3I2cSleepLease(this.bus()|(5<<33)|(1<<41))
    if (!s3I2cSleepRelease(this.bus())) return S3I2cSleepLease(this.bus()|(4<<33)|(1<<41))
    return S3I2cSleepLease(this.bus()|(6<<33))
}
