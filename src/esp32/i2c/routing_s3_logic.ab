import "./configuration_logic.ab"

fun esp32S3I2cPinRouteValid(number: int, signal: int, mux: u32,
    inputMatrix: u32, outputMatrix: u32): bool =
    espChipS3().gpioOutputValid(number) && signal >= 89 && signal <= 92 &&
    (mux & u32(0x7200)) == u32(0x1200) &&
    (inputMatrix & u32(255)) == (u32(128) | u32(number)) &&
    (outputMatrix & u32(4095)) == u32(signal)
