import "./timing_s3_logic.ab"
// HP P4 uses the shared timing arithmetic, not the S3 register map.
type P4I2cTiming=u32
fun esp32p4I2cTiming(sourceHz: u32,busHz: u32): P4I2cTiming = P4I2cTiming(esp32S3I2cTiming(sourceHz,busHz)|u32(0))
fun P4I2cTiming.valid(): bool = Esp32S3I2cTiming(this|u32(0)).valid()
