import "./timing_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@export("c5I2cTimingLoad")
trusted fun c5I2cTimingLoadHook(address: int): int = mmioLoadU32(address)
@export("c5I2cTimingStore")
trusted fun c5I2cTimingStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun esp32C5I2cConfigureTiming(port: int,value: Esp32C5I2cTiming): bool =
    esp32C5I2cConfigureTimingOwned(port,value)
