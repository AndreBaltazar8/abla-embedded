import "./timing_c5_sequence.ab"
import "abla/unsafe/mmio"
trusted fun c5I2cTimingLoad(address: int): int = mmioLoadU32(address)
trusted fun c5I2cTimingStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun esp32C5I2cConfigureTiming(port: int,value: Esp32C5I2cTiming): bool =
    esp32C5I2cConfigureTimingOwned(port,value)
