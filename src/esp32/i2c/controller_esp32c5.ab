import "./controller_c5_sequence.ab"
import "abla/unsafe/mmio"
trusted fun c5I2cControllerLoad(address: int): int = mmioLoadU32(address)
trusted fun c5I2cControllerStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun esp32C5I2cInitializeController(port: int,filter: int = 7): bool =
    esp32C5I2cInitializeControllerOwned(port,filter)
