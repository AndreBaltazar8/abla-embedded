import "./controller_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2c.ab"
@export("c5I2cControllerLoad")
trusted fun c5I2cControllerLoadHook(address: int): int = mmioLoadU32(address)
@export("c5I2cControllerStore")
trusted fun c5I2cControllerStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun esp32C5I2cInitializeController(port: int,filter: int = 7): bool =
    esp32C5I2cInitializeControllerOwned(port,filter)
