import "./setup_esp32s3.ab"
import "./recovery_s3_logic.ab"

// Reset only this polling controller, preserving its clock/timing/filter
// configuration. Caller owns the controller, has stopped all software users,
// and holds the shared RCC critical section across both cores throughout.
// SDK deliberately avoids S3's FSM-only reset: it leaves other state intact.
// Success means local registers were reset, NOT that the external bus is free.
// No GPIO bus-clear clocks or STOP are emitted here. The owner must separately
// establish bus availability before another transfer; stuck slaves may need
// explicit board-authorized single-master bus recovery.
trusted fun esp32S3I2cResetPollingControllerLocked(port: int): bool {
    val base = esp32S3I2cControllerAddress(port)
    if (base == 0) return false
    val saved = nativeStackAllocate(52)
    var index = 0
    while (index < 13) {
        nativeAddressStoreU32(saved, index * 4, int(
            u32(mmioLoadU32(base + esp32S3I2cRecoveryOffset(index))) &
                esp32S3I2cRecoveryMask(index)))
        index = index + 1
    }
    // Suppress stale interrupts before resetting the failed peripheral.
    mmioStoreU32(base + 0x28, 0)
    if (!esp32S3I2cResetClockedControllerLocked(port)) return false
    mmioStoreU32(base + 0x28, 0)
    index = 0
    while (index < 13) {
        esp32S3I2cTimingField(base + esp32S3I2cRecoveryOffset(index),
            esp32S3I2cRecoveryMask(index),
            u32(nativeAddressLoadU32(saved, index * 4)))
        index = index + 1
    }
    esp32S3I2cResetFifos(port)
    index = 0
    while (index < 8) {
        esp32S3I2cWriteCommand(port, index, esp32S3I2cCommand(4, 0))
        index = index + 1
    }
    mmioStoreU32(base + 0x24, 0x3ffff)
    esp32S3I2cTimingField(base + 4, u32(2048), u32(2048))
    true
}
