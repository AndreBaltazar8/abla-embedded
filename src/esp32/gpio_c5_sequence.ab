import "abla/runtime/scalar"
// ESP32-C5 GPIO0..28, IDF6 register map. GPIO base60091000, IOMUX60090000.
// Caller owns pad/former peripheral users, pins GPIO/IOMUX clocks and proves
// global sleep/force holds released. Board reservations (flash etc.) are NOT
// inferred from a valid pin number. No IRQ/clock/RTC/USB takeover here.
fun esp32C5GpioNumberValid(pin: int): bool = pin >= 0 && pin < 29
trusted fun esp32C5GpioReadOwned(pin: int): int =
    if (!esp32C5GpioNumberValid(pin)) -1 else int((c5GpioRead(0x60091064)>>u32(pin))&u32(1))
trusted fun esp32C5GpioWriteOwned(pin: int,high: bool): bool {
    if (!esp32C5GpioNumberValid(pin)) return false
    c5GpioWrite(if (high) 0x60091008 else 0x6009100c,u32(1)<<u32(pin))
    return true
}
trusted fun c5GpioField(address: int,mask: u32,value: u32): bool {
    c5GpioWrite(address,(c5GpioRead(address)&(u32(0xffffffff)^mask))|value)
    return (c5GpioRead(address)&mask) == value
}
// 1configured2invalid3unowned/held/RTC-or-USB active4readback failure.
// Disable GPIO OE then select that OE before changing latch/route; this
// disconnects peripheral OE without a transient output during configuration.
// No rollback: partial failure retains pad ownership, output not guaranteed.
trusted fun esp32C5GpioConfigureOwned(pin: int,output: bool,high: bool,openDrain: bool,input: bool,pull: int,exclusive: bool): int {
    if (!esp32C5GpioNumberValid(pin) || pull < 0 || pull > 2) return 2
    val bit=u32(1)<<u32(pin)
    if (!exclusive || (c5GpioRead(0x600b102c)&bit) != u32(0) ||
        (pin < 7 && (c5GpioRead(0x600b1028)&bit) != u32(0)) ||
        ((pin == 13 || pin == 14) && (c5GpioRead(0x6000f018)&u32(16384)) != u32(0))) return 3
    val route=0x60091ad4+pin*4
    c5GpioWrite(0x6009103c,bit)
    if ((c5GpioRead(0x60091034)&bit) != u32(0) || !c5GpioField(route,u32(3072),u32(1024))) return 4
    esp32C5GpioWriteOwned(pin,high)
    if (((c5GpioRead(0x60091004)&bit) != u32(0)) != high) return 4
    if (!c5GpioField(0x600910d4+pin*4,u32(4),if (openDrain) u32(4) else u32(0)) ||
        !c5GpioField(route,u32(4095),u32(1280))) return 4
    val mux=u32(4096)|(if (input) u32(512) else u32(0))|
        (if (pull == 1) u32(256) else if (pull == 2) u32(128) else u32(0))
    if (!c5GpioField(0x60090000+pin*4,u32(29570),mux)) return 4
    if (output) {
        c5GpioWrite(0x60091038,bit)
        if ((c5GpioRead(0x60091034)&bit) == u32(0)) return 4
    }
    return 1
}

