import "./peripheral_delay_rom_sequence.ab"
import "abla/unsafe/native"
// IDF6 esp32p4.rom.ld and .eco5.ld agree on this HP-ROM address.
// Boot must calibrate ROM ticks-per-us for the actual CPU frequency.
// Busy wait, not scheduler yielding: never hold an RCC lock/mask interrupts
// across long panel delays. A scheduled caller can supply a yielding hook.
trusted fun peripheralRomDelay(microseconds: int): void {
    callNativeVoidI32(0x4fc0003c,microseconds)
    return
}
