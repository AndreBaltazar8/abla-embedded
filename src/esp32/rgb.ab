trusted noescape extern:"c" fun neopixelWrite(
    pin: u8,
    red: u8,
    green: u8,
    blue: u8
): void

type RgbLed = int

fun rgbLed(pin: int): RgbLed = RgbLed(pin)

trusted fun RgbLed.set(red: int, green: int, blue: int): void {
    neopixelWrite(this, red, green, blue)
    return
}

trusted fun RgbLed.off(): void = this.set(0, 0, 0)
