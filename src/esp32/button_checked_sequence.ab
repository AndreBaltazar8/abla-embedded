import "./button_shared.ab"
// Bit63 validates an acquired sample; low63 contains the resulting button.
// Invalid result preserves prior state but must NOT be consumed as new events.
// No automatic clock read or initialization. Caller owns input pad and clocks.
type GpioButtonUpdate=int
fun GpioButtonUpdate.valid(): bool = (this>>>63) == 1
fun GpioButtonUpdate.button(): GpioButton = GpioButton(this & 9223372036854775807)
fun GpioButton.updateFromLevel(level: int,nowMilliseconds: int,debounceMilliseconds: int=10,holdMilliseconds: int=500,clickDecisionMilliseconds: int=250): GpioButtonUpdate {
    if (level < 0 || level > 1 || this < 0) return GpioButtonUpdate(this & 9223372036854775807)
    val pressed=if (this.activeLow()) level == 0 else level == 1
    return GpioButtonUpdate((this.updateWith(pressed,nowMilliseconds,debounceMilliseconds,holdMilliseconds,clickDecisionMilliseconds)|0)|(1<<63))
}
trusted fun GpioButton.initializeOwned(): bool = this >= 0 && this.pin().valid() && this.pin().inputOwned()
trusted fun GpioButton.updateAtOwned(nowMilliseconds: int,debounceMilliseconds: int=10,holdMilliseconds: int=500,clickDecisionMilliseconds: int=250): GpioButtonUpdate {
    if (this < 0 || !this.pin().valid()) return GpioButtonUpdate(this & 9223372036854775807)
    return this.updateFromLevel(this.pin().readLevelOwned(),nowMilliseconds,debounceMilliseconds,holdMilliseconds,clickDecisionMilliseconds)
}
