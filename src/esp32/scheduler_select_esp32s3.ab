import "./scheduler_select_s3_sequence.ab"
import "../scheduler/ready_queue.ab"
import "./task_switch_esp32s3.ab"
@inline
trusted fun esp32S3SchedulerSelectRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3SchedulerSelectWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3SchedulerSelectSwitch(current: NativeBuffer,previous: NativeBuffer,next: NativeBuffer,owners: NativeBuffer,interrupted: NativeBuffer,resume: NativeBuffer,core: int,level: int): int =
    esp32S3TaskSwitchOwned(current,previous,next,owners,interrupted,resume,core,level)
