import "./scheduler_select_s3_sequence.ab"
import "../scheduler/ready_queue.ab"
import "./task_switch_esp32s3.ab"
import "../hal/esp32.ab"
import "abla/unsafe/mmio"
import "./sdk/raw_buffer.ab"
import "./task_switch_s3_sequence.ab"
import "./sdk/nativebuffer_type.ab"
@inline
@export("esp32S3SchedulerSelectRead")
trusted fun esp32S3SchedulerSelectReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3SchedulerSelectWrite")
trusted fun esp32S3SchedulerSelectWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
@export("esp32S3SchedulerSelectSwitch")
trusted fun esp32S3SchedulerSelectSwitchHook(current: NativeBuffer,previous: NativeBuffer,next: NativeBuffer,owners: NativeBuffer,interrupted: NativeBuffer,resume: NativeBuffer,core: int,level: int): int =
    esp32S3TaskSwitchOwned(current,previous,next,owners,interrupted,resume,core,level)
