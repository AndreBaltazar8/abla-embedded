import "./mspi_dummy_s3_sequence.ab"

// ESP32-S3 ROM exports a POINTER slot, not an inline legacy-data struct.
// esp_rom_spiflash_chip_t has six u32 fields, then dummy_len_plus[3].
// Caller owns ROM flash state and MSPI/cache/other-core access throughout.
type Esp32S3RomDummyChange = int
@inline
fun Esp32S3RomDummyChange.valid(): bool = (this & (1<<60)) != 0

@section(".iram1.abla.s3RomDummyApply")
trusted fun esp32S3QuadFlashDummyApplyOwned(port: int,protocolEncoded: int,romBaseline: int,extra: int): Esp32S3RomDummyChange {
    if (port < 0 || port > 1 || protocolEncoded < 0 || protocolEncoded > 63 ||
        romBaseline < 0 || romBaseline > 255 || extra < 0 || extra > 63 ||
        protocolEncoded+romBaseline+extra > 63) return Esp32S3RomDummyChange(0)
    val data=esp32S3MspiDummyRead(0x3FCEFFE4) & 0xFFFFFFFF
    if (data == 0 || (data & 3) != 0 || data > 0xFFFFFFE0) return Esp32S3RomDummyChange(0)
    val address=data+24+port
    val previous=esp32S3RomDummyReadByte(address) & 255
    val original=esp32S3MspiDummyCaptureOwned(0,port)
    esp32S3RomDummyWriteByte(address,romBaseline+extra)
    esp32S3MspiDummySetOwned(0,port,protocolEncoded+romBaseline,extra)
    Esp32S3RomDummyChange(address | (previous<<32) | ((original & 2047)<<40) | (1<<60))
}

// Restores BOTH the ROM command-driver adjustment and exact USER registers.
// Caller must not reuse a copied change token after restoring it.
@section(".iram1.abla.s3RomDummyRestore")
trusted fun esp32S3QuadFlashDummyRestoreOwned(change: Esp32S3RomDummyChange): bool {
    if (!change.valid()) return false
    val original=Esp32S3MspiDummy((change>>>40) & 2047)
    if (!original.valid() || ((original>>>7) & 3) != 0) return false
    esp32S3RomDummyWriteByte(change & 0xFFFFFFFF,(change>>>32) & 255)
    esp32S3MspiDummyRestoreOwned(original)
}
