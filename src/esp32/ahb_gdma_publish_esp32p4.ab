import "./ahb_gdma_publish_p4_sequence.ab"
import "./ahb_gdma_ring_esp32p4.ab"
import "./cache_writeback_esp32p4.ab"
import "../riscv/memory.ab"
trusted fun p4AhbPublishFence(): void = riscvDeviceMemoryFence()
// Internal SRAM uses the 64-byte L1 line only; L2 argument is not used there.
trusted fun p4AhbPublishFlush(buffer: NativeBuffer,bytes: int,polls: int): int =
    esp32P4CacheWritebackInvalidateOwned(buffer,bytes,64,polls)
