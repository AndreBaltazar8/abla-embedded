import "./sdk/raw_buffer.ab"
@section(".iram1.abla.s3SchedulerSetupRegion")
fun esp32S3SchedulerSetupRegion(index: int,context: NativeBuffer,queue: NativeBuffer,records: NativeBuffer,running: NativeBuffer,current: NativeBuffer,owners: NativeBuffer,lock: NativeBuffer): NativeBuffer {
    if (index == 0) return nativeBufferAt(context.addressValue(),44)
    if (index == 1) return queue
    if (index == 2) return records
    if (index == 3) return nativeBufferAt(running.addressValue(),8)
    if (index == 4) return nativeBufferAt(current.addressValue(),8)
    if (index == 5) return nativeBufferAt(owners.addressValue(),16)
    nativeBufferAt(lock.addressValue(),4)
}
// Fresh unpublished per-core context. Serialized boot with CPU lines disabled;
// caller already initialized queue/task metadata and owns all task/CP storage.
// Validates internal ranges and pairwise overlap before the first write. Does
// not modify queue, descriptors, bindings, owners or lock; publish only after
// success through SchedulerIrqInstallOwned with SchedulerRunAddress.
@section(".iram1.abla.s3SchedulerSetup")
trusted fun esp32S3SchedulerSetupOwned(context: NativeBuffer,queue: NativeBuffer,records: NativeBuffer,running: NativeBuffer,current: NativeBuffer,owners: NativeBuffer,lock: NativeBuffer,core: int): bool {
    if (core < 0 || core > 1 || esp32S3SchedulerSetupCore() != core || esp32S3SchedulerSetupEnabled() != 0 ||
        !context.hasAddressRange(0,44) || !running.hasAddressRange(0,8) || !current.hasAddressRange(0,8) ||
        !owners.hasAddressRange(0,16) || !lock.hasAddressRange(0,4) ||
        records.capacity() < 16 || (records.capacity() & 15) != 0 || queue.capacity() < 20 || (queue.capacity() & 3) != 0) return false
    var i=0
    while (i < 7) {
        val a=esp32S3SchedulerSetupRegion(i,context,queue,records,running,current,owners,lock)
        val start=a.addressValue()
        val end=start+a.capacity()
        if (start < 0x3FC88000 || end > 0x3FD00000 || (start & 3) != 0) return false
        var j=0
        while (j < i) {
            val b=esp32S3SchedulerSetupRegion(j,context,queue,records,running,current,owners,lock)
            if (start < b.addressValue()+b.capacity() && b.addressValue() < end) return false
            j=j+1
        }
        i=i+1
    }
    if (esp32S3SchedulerSetupRead(lock.addressValue()) != 0 || !esp32S3SchedulerSetupQueueValid(queue)) return false
    val base=context.addressValue()
    esp32S3SchedulerSetupWrite(base,lock.addressValue())
    esp32S3SchedulerSetupWrite(base+4,queue.addressValue()); esp32S3SchedulerSetupWrite(base+8,queue.capacity())
    esp32S3SchedulerSetupWrite(base+12,records.addressValue()); esp32S3SchedulerSetupWrite(base+16,records.capacity())
    esp32S3SchedulerSetupWrite(base+20,running.addressValue()); esp32S3SchedulerSetupWrite(base+24,current.addressValue())
    esp32S3SchedulerSetupWrite(base+28,owners.addressValue())
    esp32S3SchedulerSetupWrite(base+32,0); esp32S3SchedulerSetupWrite(base+36,0)
    esp32S3SchedulerSetupWrite(base+40,core)
    true
}
