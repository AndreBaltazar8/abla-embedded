import "./context_extra_esp32s3.ab"
// Windowed ABI siblings of the CALL0 exception leaves. One u32 buffer argument
// is in a2 after ENTRY; a3 scratch. Leaf routines do not call another function.
// Explicit ENTRY/RETW are the whole architecture boundary; no compiler prologue.
// Caller must enable the correct CP and own its live state before invoking.
@naked
@noinline
@section(".iram1.abla.s3Cp0SaveWindowed")
trusted fun esp32S3Cp0SaveWindowed(buffer: u32): void =
    esp32S3ContextExtraAssembly("entry a1, 32\nssi f0, a2, 0\nssi f1, a2, 4\nssi f2, a2, 8\nssi f3, a2, 12\nssi f4, a2, 16\nssi f5, a2, 20\nssi f6, a2, 24\nssi f7, a2, 28\nssi f8, a2, 32\nssi f9, a2, 36\nssi f10, a2, 40\nssi f11, a2, 44\nssi f12, a2, 48\nssi f13, a2, 52\nssi f14, a2, 56\nssi f15, a2, 60\nrur.fcr a3\ns32i a3, a2, 64\nrur.fsr a3\ns32i a3, a2, 68\nretw", "~{memory}")
@inline
trusted fun esp32S3Cp0SaveWindowedAddress(): int = nativeFunctionAddress(esp32S3Cp0SaveWindowed)
