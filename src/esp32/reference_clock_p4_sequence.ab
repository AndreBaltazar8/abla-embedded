// Shared P4 PLL-derived reference output gates, IDF6 clk_gate_ll.h.
// Both hw_ver1 and hw_ver3 use the same gate fields. These are NOT PLL
// power/lock controls. Caller owns cross-core RCC critical section and source
// lifetime/refcount, especially before disabling a shared reference output.
fun esp32P4ReferenceClockField(mhz: int): int {
    if (mhz == 20) return (44<<8)|8
    if (mhz == 25) return (40<<8)|28
    if (mhz == 50) return (40<<8)|27
    if (mhz == 80) return (44<<8)|4
    if (mhz == 120) return (44<<8)|2
    if (mhz == 160) return (44<<8)|0
    if (mhz == 240) return (40<<8)|30
    return -1
}
// F20M actual divider1..256, independent of the gate. Nominal20MHz only when
// SPLL is480MHz and divider24; neither this read nor gate state proves lock.
trusted fun esp32P4Reference20mDivider(): int = int((p4ReferenceClockRead(40)>>u32(16))&u32(255))+1
// -1 invalid,0 gated,1 enabled. Enabled readback is not PLL-lock evidence.
trusted fun esp32P4ReferenceClockReadOwned(mhz: int): int {
    val field=esp32P4ReferenceClockField(mhz)
    if (field < 0) return -1
    val mask=u32(1)<<u32(field&255)
    if ((p4ReferenceClockRead(field>>>8)&mask) != u32(0)) 1 else 0
}
// 1 verified (including already desired),2 invalid,3 readback failure.
// Read-modify-write exactly one gate; do not alter source/divider controls.
trusted fun esp32P4ReferenceClockSetOwned(mhz: int,enable: bool): int {
    val field=esp32P4ReferenceClockField(mhz)
    if (field < 0) return 2
    val mask=u32(1)<<u32(field&255)
    val offset=field>>>8
    val old=p4ReferenceClockRead(offset)
    if (((old&mask) != u32(0)) == enable) return 1
    p4ReferenceClockWrite(offset,if (enable) old|mask else old&(u32(4294967295)^mask))
    if (((p4ReferenceClockRead(offset)&mask) != u32(0)) == enable) 1 else 3
}
