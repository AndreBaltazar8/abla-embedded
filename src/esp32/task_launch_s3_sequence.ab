import "./sdk/raw_buffer.ab"
// FIRST task only: destroys boot call-chain/window state, never a task switch.
// Caller owns fresh frame/stack and has published task identity/CP records to
// the scheduler resolver. CPU lines remain disabled; task/runtime arms them.
// False means no transfer occurred. Successful hardware transfer never returns.
@section(".iram1.abla.s3TaskLaunch")
trusted fun esp32S3TaskLaunchFirstOwned(stack: NativeBuffer,frame: NativeBuffer,core: int): bool {
    if (core < 0 || core > 1 || esp32S3TaskLaunchCore() != core || esp32S3TaskLaunchEnabled() != 0 ||
        (esp32S3TaskLaunchStatus() & 0x40010) != 0x40000 ||
        !stack.hasAddressRange(0,1024) || stack.addressValue() < 0x3FC88000 ||
        stack.addressValue()+stack.capacity() > 0x3FD00000 || ((stack.addressValue() | stack.capacity()) & 15) != 0 ||
        !frame.hasAddressRange(0,192) || frame.addressValue() != stack.addressValue()+stack.capacity()-208) return false
    val base=esp32S3TaskLaunchVectors()
    if (base == 0 || esp32S3TaskLaunchCurrentVectors() != base) return false
    val cfg=esp32S3TaskLaunchConfig()+core*32
    if (esp32S3TaskLaunchRead(cfg) == 0 || esp32S3TaskLaunchRead(cfg+4) != 0 ||
        esp32S3TaskLaunchRead(cfg+8) == 0 || esp32S3TaskLaunchRead(cfg+24) == 0) return false
    val address=frame.addressValue()
    if (esp32S3TaskLaunchRead(address) != esp32S3TaskFrameReturnAddress() ||
        esp32S3TaskLaunchRead(address+4) != esp32S3TaskFrameEntryAddress() ||
        esp32S3TaskLaunchRead(address+8) != 0x50030 ||
        esp32S3TaskLaunchRead(address+12) != 0 || esp32S3TaskLaunchRead(address+16) != address+192 ||
        esp32S3TaskLaunchRead(address+148) != 0) return false
    esp32S3TaskLaunchTransfer(address)
    // Reachable only in the native model; hardware leaf cannot return.
    true
}
