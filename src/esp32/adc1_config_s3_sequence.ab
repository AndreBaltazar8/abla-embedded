import "./adc1_oneshot_s3_sequence.ab"
// ESP-IDF v6.0.2 S3 adc_ll.h: RTC_FAST divider1, non-inverted 12bit,
// channel attenuation, RTC software trigger/pad bitmap. Unlike ESP32, no Hall.
// Caller owns ADC1 (including IRQ policy) and selected pad; stops/excludes
// ULP/DMA and pins SAR/RTC clocks/power. Trim/settling/pad setup are separate.
// This does not take over a digital/ULP transaction or touch ADC2's arbiter.
// Partial write failure retains ownership; retry under the same exclusions.
// Low8:1configured2invalid3foreigncontroller/channel4busy5readback.
// High8 gives failed stage; does not mean rollback occurred.
trusted fun esp32S3Adc1Field(offset: int,mask: int,value: int): bool {
    esp32S3Adc1Write(offset,(esp32S3Adc1Read(offset)&(4294967295^mask))|value)
    return (esp32S3Adc1Read(offset)&mask) == value
}
trusted fun esp32S3Adc1ConfigureOwned(channel: int,attenuation: int,polls: int): int {
    if (channel < 0 || channel > 9 || attenuation < 0 || attenuation > 3 || polls < 1 || polls > 1000000) return 2
    if ((esp32S3Adc1Read(16)&0x80000000) != 0) return 3
    val before=esp32S3Adc1Read(12)
    val pads=before&0x7ff80000
    if (pads != 0 && pads != ((1<<channel)<<19)) return 3
    if ((before&0x30000) == 0x20000) return 4
    var remaining=polls
    while ((esp32S3Adc1Read(64)&0x3fc00000) != 0) {
        remaining=remaining-1
        if (remaining == 0) return 4
    }
    // Polling profile disables ADC1 interrupt generation, preserves sample
    // count/clock gate and other fields. No RTC interrupt W1C or shared reset.
    if (!esp32S3Adc1Field(0,0x300000ff,1)) return 261
    val shift=channel*2
    if (!esp32S3Adc1Field(20,3<<shift,attenuation<<shift)) return 517
    // Software RTC start/pad control; no selected pad or start until startOwned.
    esp32S3Adc1Write(12,0x80040000)
    if ((esp32S3Adc1Read(12)&0xfffe0000) != 0x80040000) return 773
    return 1
}
