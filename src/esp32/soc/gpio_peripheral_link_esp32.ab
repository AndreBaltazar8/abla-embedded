import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSocGpioPeripheralInternals(): bool {
    if (!internalFunction("esp32RecoveredGpioPeriphMemberAnchor", "gpio_periph_member_anchor")) return false
    true
}
