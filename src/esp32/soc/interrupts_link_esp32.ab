import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSocInterruptsInternals(): bool {
    if (!internalFunction("esp32RecoveredInterruptsMemberAnchor", "interrupts_member_anchor")) return false
    true
}
