import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSocDportInternals(): bool {
    if (!internalFunction("esp32DportReadShared", "esp_dport_access_reg_read")) return false
    if (!internalFunction("esp32DportSequenceReadShared", "esp_dport_access_sequence_reg_read")) return false
    true
}
