import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSocDportCommonInternals(): bool {
    if (!internalFunction("esp32RecoveredEspDportAccessReadBuffer", "esp_dport_access_read_buffer")) return false
    true
}
