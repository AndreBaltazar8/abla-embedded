// Silicon topology from ESP-IDF 6.0.2 soc_caps.h. This does not imply a pin
// is exposed or safe on a board: flash, PSRAM and board wiring reserve pins.
// No MMIO or target detection; callers select their known build target.
type EspChip = int

fun espChip32(): EspChip = EspChip(1)
fun espChipS2(): EspChip = EspChip(2)
fun espChipS3(): EspChip = EspChip(3)
fun espChipC3(): EspChip = EspChip(4)
fun espChipC6(): EspChip = EspChip(5)

@inline
fun EspChip.gpioLimit(): int {
    if (this == 1) return 40
    if (this == 2) return 47
    if (this == 3) return 49
    if (this == 4) return 22
    if (this == 5) return 31
    0
}

@inline
fun EspChip.gpioValid(number: int): bool {
    if (number < 0 || number >= this.gpioLimit()) return false
    if (this == 1) return number != 24 && (number < 28 || number > 31)
    if (this == 2 || this == 3) return number < 22 || number > 25
    true
}

@inline
fun EspChip.gpioOutputValid(number: int): bool {
    if (!this.gpioValid(number)) return false
    if (this == 1) return number < 34
    if (this == 2) return number != 46
    true
}
