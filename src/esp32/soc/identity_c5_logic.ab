// ESP-IDF6.0.2 C5 EFUSE_RD_MAC_SYS2 mirror: embedded FLASH_CAP[15:13]
// and PSRAM_CAP[21:19]. Values are hardware capacity codes, not byte sizes.
fun esp32C5FlashCapacityFromEfuse(sys2: u32): int = int((sys2>>>13)&u32(7))
fun esp32C5PsramCapacityFromEfuse(sys2: u32): int = int((sys2>>>19)&u32(7))
