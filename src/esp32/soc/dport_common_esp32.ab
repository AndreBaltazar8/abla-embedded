import "../../xtensa/assembly.ab"
import "abla/unsafe/memory"

// Original ABI symbol: esp_dport_access_read_buffer.
trusted fun esp32RecoveredEspDportAccessReadBuffer(
    destination: u32,
    source: u32,
    words: u32
): void {
    var index = u32(0)
    while (index < words) {
        val offset = index << u32(2)
        xtensaMemoryBarrier()
        val value = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(source + offset))))
        ablaUnsafeStoreU32(nativePointerFromAddress(int(destination + offset)), int(value))
        index = index + u32(1)
    }
    return
}
