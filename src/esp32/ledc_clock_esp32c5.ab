import "./ledc_esp32c5.ab"
import "./ledc_clock_c5_sequence.ab"
import "../hal/esp32.ab"
@export("c5LedcClockRead")
trusted fun c5LedcClockReadHook(offset: int): int = mmioLoadU32(0x60096048+offset)
@export("c5LedcClockWrite")
trusted fun c5LedcClockWriteHook(offset: int,value: int): void { mmioStoreU32(0x60096048+offset,value);return }
