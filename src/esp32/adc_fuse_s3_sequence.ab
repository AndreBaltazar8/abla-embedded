import "./adc_calibration_s3_logic.ab"
// Immutable per-unit/attenuation S3 calibration. Init12bits, reference13bits,
// unit-1 bit25, attenuation26..27, valid28. Invalid low8:2input3version4codes.
// Valid software calibration does not mean the matching hardware trim has
// been programmed. Caller must apply initCode before using converted samples.
type Esp32S3AdcCalibration = int
fun Esp32S3AdcCalibration.bits(): int = this
fun Esp32S3AdcCalibration.valid(): bool = (this&268435456) != 0
fun Esp32S3AdcCalibration.error(): int = if (this.valid()) 0 else this&255
fun Esp32S3AdcCalibration.initCode(): int = if (this.valid()) this&4095 else -1
fun Esp32S3AdcCalibration.referenceCode(): int = if (this.valid()) (this>>12)&8191 else -1
fun Esp32S3AdcCalibration.unit(): int = if (this.valid()) 1+((this>>25)&1) else 0
fun Esp32S3AdcCalibration.attenuation(): int = if (this.valid()) (this>>26)&3 else -1
fun Esp32S3AdcCalibration.millivolts(raw: int): int =
    if (!this.valid()) -1 else esp32S3AdcCalibratedMillivolts(this.unit(),this.attenuation(),raw,this.referenceCode())
fun esp32S3AdcCalibrationFromWords(unit: int,attenuation: int,b1w5: int,w4: int,w5: int,w6: int,w7: int): Esp32S3AdcCalibration {
    if (unit < 1 || unit > 2 || attenuation < 0 || attenuation > 3) return Esp32S3AdcCalibration(2)
    if ((w4&3) != 1) return Esp32S3AdcCalibration(3)
    val init=esp32S3AdcInitCode(unit,attenuation,w4,w5,w6)
    val reference=esp32S3AdcReferenceCode(unit,attenuation,b1w5,w4,w6,w7)
    if (init < 0 || init > 4095 || reference < 852 || reference > 4260) return Esp32S3AdcCalibration(4)
    return Esp32S3AdcCalibration(268435456|init|(reference<<12)|((unit-1)<<25)|(attenuation<<26))
}
// Only read-shadow accesses. Caller guarantees ESP32-S3 and stable loaded
// eFuse shadows; no READ/PGM commands, key blocks, or power/clock writes.
trusted fun esp32S3AdcReadCalibration(unit: int,attenuation: int): Esp32S3AdcCalibration {
    if (unit < 1 || unit > 2 || attenuation < 0 || attenuation > 3) return Esp32S3AdcCalibration(2)
    val w4=esp32S3AdcFuseRead(108)
    if ((w4&3) != 1) return Esp32S3AdcCalibration(3)
    val w5=esp32S3AdcFuseRead(112)
    val w6=esp32S3AdcFuseRead(116)
    val w7=esp32S3AdcFuseRead(120)
    val b1w5=if (unit == 2 && attenuation == 3) esp32S3AdcFuseRead(88) else 0
    return esp32S3AdcCalibrationFromWords(unit,attenuation,b1w5,w4,w5,w6,w7)
}
