import "./coprocessor_owner_s3_sequence.ab"
import "./coprocessor_transfer_esp32s3.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
import "./sdk/raw_buffer.ab"
import "./coprocessor_transfer_s3_sequence.ab"
import "./sdk/nativebuffer_type.ab"
@inline
@export("esp32S3CpOwnerRead")
trusted fun esp32S3CpOwnerReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3CpOwnerWrite")
trusted fun esp32S3CpOwnerWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
@export("esp32S3CpOwnerCore")
trusted fun esp32S3CpOwnerCoreHook(): int = esp32S3CpTransferCore()
@inline
@export("esp32S3CpOwnerStatus")
trusted fun esp32S3CpOwnerStatusHook(): int = esp32S3CpTransferStatus()
@inline
@export("esp32S3CpOwnerEnabled")
trusted fun esp32S3CpOwnerEnabledHook(): int = esp32S3CpTransferEnabled()
@inline
@export("esp32S3CpOwnerTransfer")
trusted fun esp32S3CpOwnerTransferHook(buffer: NativeBuffer,core: int,cp: int,restore: bool): bool = esp32S3CoprocessorTransferOwned(buffer,core,cp,restore)
