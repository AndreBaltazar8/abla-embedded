import "./coprocessor_owner_s3_sequence.ab"
import "./coprocessor_transfer_esp32s3.ab"
import "abla/unsafe/mmio"
@inline
trusted fun esp32S3CpOwnerRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3CpOwnerWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3CpOwnerCore(): int = esp32S3CpTransferCore()
@inline
trusted fun esp32S3CpOwnerStatus(): int = esp32S3CpTransferStatus()
@inline
trusted fun esp32S3CpOwnerEnabled(): int = esp32S3CpTransferEnabled()
@inline
trusted fun esp32S3CpOwnerTransfer(buffer: NativeBuffer,core: int,cp: int,restore: bool): bool = esp32S3CoprocessorTransferOwned(buffer,core,cp,restore)
