import "./sleep_digital_c5_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.c5SleepDigitalRead")
trusted fun c5SleepDigitalRead(offset: int): int = mmioLoadU32(0x600b0000+offset)
@section(".iram1.abla.c5SleepDigitalWrite")
trusted fun c5SleepDigitalWrite(offset: int,value: int): void { mmioStoreU32(0x600b0000+offset,value);return }
