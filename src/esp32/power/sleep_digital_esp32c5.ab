import "./sleep_digital_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@section(".iram1.abla.c5SleepDigitalRead")
@export("c5SleepDigitalRead")
trusted fun c5SleepDigitalReadHook(offset: int): int = mmioLoadU32(0x600b0000+offset)
@section(".iram1.abla.c5SleepDigitalWrite")
@export("c5SleepDigitalWrite")
trusted fun c5SleepDigitalWriteHook(offset: int,value: int): void { mmioStoreU32(0x600b0000+offset,value);return }
