// Inner light-sleep operation, corresponding to IDF esp_sleep_start_safe.
// Outer owner already configured clocks/MSPI/power/wake/retention, parked peer
// and masked interrupts. Full closure/stack/data must be retained internal RAM.
// CPU, analog, MSPI and UART restoration remain OUTSIDE this operation and must
// complete before peer/interrupt release. Flash must be ready before resumption;
// do not use with flash power-down lacking its separate wake-delay handling.
// Status matches LightSleepEnterOwned. No early return after cache suspension.
@section(".iram1.abla.s3LightSleepSuspended")
// A flash-resident caller is safe only if this entire cache-off interval
// remains out-of-line. Section placement alone does not prevent LLVM inlining.
@noinline
trusted fun esp32S3LightSleepSuspendedOwned(wakeMask: int,rejectMask: int): int {
    if (wakeMask <= 0 || wakeMask > 0x1FFFF || rejectMask < 0 || rejectMask > 0x3FFFF) return -1
    if ((esp32S3SleepEntryRead(0x60008018) & 0x80000000) != 0 ||
        (esp32S3SleepEntryRead(0x60008090) & 0x80000000) != 0) return -2
    val cache=esp32S3CachesSuspendOwned()
    val result=esp32S3LightSleepEnterOwned(wakeMask,rejectMask)
    esp32S3CachesResumeOwned(cache)
    result
}
