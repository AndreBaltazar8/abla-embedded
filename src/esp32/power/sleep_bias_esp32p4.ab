import "./sleep_bias_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepBiasRead")
trusted fun p4SleepBiasReadHook(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
@export("p4SleepBiasWrite")
trusted fun p4SleepBiasWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value));return }
