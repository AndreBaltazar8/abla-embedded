import "rtc_sleep_typed_esp32.ab"
import "sar_control_esp32.ab"

// Typed ESP32 RTC initialization and VDDSDIO configuration. rtc_config_t and
// rtc_vddsdio_config_t are packed scalar ABIs, so no wrapper allocation is
// needed and every register transition remains visible to LLVM.

trusted fun esp32RtcInit(configuration: u32): void {
    // A deep-sleep reset may leave the modem force-powered-down and isolated.
    // Clear both controls before touching the remaining RTC state.
    esp32RtcSleepUpdate(u32(0x3ff48084), u32(0x00020000), u32(0))
    esp32RtcSleepUpdate(u32(0x3ff48088), u32(0x10000000), u32(0))
    esp32RtcSleepUpdate(u32(0x3ff48030), u32(0xdc000000), u32(0))

    val clockWaits =
        (((configuration >>> u32(16)) & u32(0xff)) << u32(24)) |
        (((configuration >>> u32(8)) & u32(0xff)) << u32(14)) |
        ((configuration & u32(0xff)) << u32(6))
    esp32RtcSleepUpdate(
        u32(0x3ff4801c),
        u32(0xffffffc0),
        clockWaits
    )

    // Default debug attenuation/heartbeat and 1.10 V wake/sleep bias.
    esp32RtcSleepUpdate(
        u32(0x3ff48078),
        u32(0x03000000),
        u32(0x63000000)
    )
    esp32RtcSleepUpdate(
        u32(0x3ff4807c),
        u32(0x0fc00000),
        u32(0x09000000)
    )

    if (esp32RtcSleepConfigBit(configuration, u32(24)) != u32(0)) {
        esp32DportUpdate(u32(0x3ff00044), u32(0x800), u32(0))
        esp32DportUpdate(u32(0x3ff0005c), u32(0x800), u32(0))
        esp32DportUpdate(u32(0x3ff00094), u32(0xff), u32(0))
        esp32DportWrite(u32(0x3ff000a0), u32(0))
        esp32DportUpdate(u32(0x3ff000a4), u32(1), u32(0))
        esp32DportUpdate(u32(0x3ff000ac), u32(0x101), u32(0))
    }

    if (esp32RtcSleepConfigBit(configuration, u32(25)) != u32(0)) {
        esp32RtcSleepUpdate(u32(0x3ff48070), u32(0x04000000), u32(0))
        esp32RtcSleepUpdate(
            u32(0x3ff48000),
            u32(0x00492a00),
            u32(0x00124000)
        )
        esp32RtcSleepUpdate(
            u32(0x3ff48030),
            u32(0x01000000),
            u32(0x00800000)
        )

        val dboostPowerDown =
            esp32RtcSleepConfigBit(configuration, u32(26)) << u32(28)
        esp32RtcSleepUpdate(
            u32(0x3ff4807c),
            u32(0xb0000000),
            dboostPowerDown
        )

        esp32RtcSleepUpdate(u32(0x3ff48084), u32(0x00155550), u32(0))
        esp32RtcSleepUpdate(u32(0x3ff48080), u32(0x00092025), u32(0))
        esp32RtcSleepUpdate(u32(0x3ff48088), u32(0xaaaa5000), u32(0))
    }

    // Leave the modem forced down and isolated until its driver acquires it.
    esp32RtcSleepUpdate(u32(0x3ff48088), u32(0), u32(0x10000000))
    esp32RtcSleepUpdate(u32(0x3ff48084), u32(0), u32(0x00020000))

    xtensaDeviceStoreU32(u32(0x3ff4803c), u32(0))
    xtensaDeviceStoreU32(u32(0x3ff48048), u32(0xffffffff))
    esp32RecoveredSarPeriphCtrlInit(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return
}

// rtc_vddsdio_config_t scalar layout:
// bit 0 force, bit 1 enable, bit 2 tieh,
// bits 3..4 drefh, 5..6 drefm, 7..8 drefl.
trusted fun esp32RtcVddsdioGetConfig(): u32 {
    val sdio = xtensaDeviceLoadU32(u32(0x3ff48074))
    var result =
        (((sdio >>> u32(29)) & u32(3)) << u32(3)) |
        (((sdio >>> u32(27)) & u32(3)) << u32(5)) |
        (((sdio >>> u32(25)) & u32(3)) << u32(7))

    if ((sdio & u32(0x00400000)) != u32(0)) {
        result = result | u32(1)
        result = result | (((sdio >>> u32(31)) & u32(1)) << u32(1))
        result = result | (((sdio >>> u32(23)) & u32(1)) << u32(2))
        return result
    }

    val efuseConfig = xtensaDeviceLoadU32(u32(0x3ff5a010))
    if ((efuseConfig & u32(0x00010000)) != u32(0)) {
        result = result | (((efuseConfig >>> u32(14)) & u32(1)) << u32(1))
        result = result | (((efuseConfig >>> u32(15)) & u32(1)) << u32(2))
        val efuseBlock3 = xtensaDeviceLoadU32(u32(0x3ff5a00c))
        if ((efuseBlock3 & u32(0x00004000)) == u32(0)) {
            result = result & u32(0x7)
            result = result | (((efuseConfig >>> u32(8)) & u32(3)) << u32(3))
            result = result | (((efuseConfig >>> u32(10)) & u32(3)) << u32(5))
            result = result | (((efuseConfig >>> u32(12)) & u32(3)) << u32(7))
        }
        return result
    }

    // Otherwise the MTDI bootstrap pin selects 1.8 V (high) or 3.3 V (low).
    val strap = xtensaDeviceLoadU32(u32(0x3ff44038))
    result = (result & u32(0x1f8)) | u32(2)
    if ((strap & u32(0x20)) == u32(0)) result = result | u32(4)
    result
}

trusted fun esp32RtcVddsdioSetConfig(configuration: u32): void {
    val registerValue =
        ((configuration & u32(1)) << u32(22)) |
        (((configuration >>> u32(1)) & u32(1)) << u32(31)) |
        (((configuration >>> u32(3)) & u32(3)) << u32(29)) |
        (((configuration >>> u32(5)) & u32(3)) << u32(27)) |
        (((configuration >>> u32(7)) & u32(3)) << u32(25)) |
        (((configuration >>> u32(2)) & u32(1)) << u32(23)) |
        u32(0x00200000)
    xtensaDeviceStoreU32(u32(0x3ff48074), registerValue)
}
