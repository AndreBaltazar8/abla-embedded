import "abla/runtime/scalar"
// ROM rtc.h defines RTC_SLEEP_MODE_REG as LP_STORE8, despite lp_sys_ll.h's
// stale STORE9 comment. STORE9 belongs to LP UART init control; never touch it.
// Exclusive retained wake-mode lease: only STORE8 bit0, deep1/light0.
// Caller excludes sleep/reset/ROM wake consumption until configuration is
// ready; restore only after wake completed or before any request was issued.
// Token oldbit@8,owned9; 1configured2invalid3partial4closed.
type P4SleepMarker=int
fun P4SleepMarker.status(): int = this&255
fun P4SleepMarker.hasSnapshot(): bool = (this&512) != 0
trusted fun p4SleepMarkerField(value: u32): bool {
    p4SleepMarkerWrite((p4SleepMarkerRead()&u32(0xfffffffe))|value)
    return (p4SleepMarkerRead()&u32(1)) == value
}
trusted fun esp32p4SleepMarkerOpenOwned(deep: bool,exclusive: bool): P4SleepMarker {
    if (!exclusive) return P4SleepMarker(2)
    val token=512|(int(p4SleepMarkerRead()&u32(1))<<8)
    return P4SleepMarker(token|(if (p4SleepMarkerField(if (deep) u32(1) else u32(0))) 1 else 3))
}
trusted fun P4SleepMarker.closeOwned(exclusive: bool): P4SleepMarker {
    if (!exclusive || !this.hasSnapshot() || this.status() == 4) return this
    return P4SleepMarker((this&(~255))|(if (p4SleepMarkerField(u32((this>>>8)&1))) 4 else 3))
}
