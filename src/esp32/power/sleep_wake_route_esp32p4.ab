import "./sleep_wake_route_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun p4WakeRouteAsmRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4WakeRouteAsmFence(template: string,constraints: string): void
trusted fun p4WakeRouteHart(): u32 = p4WakeRouteAsmRead("csrr $0, mhartid","=r,~{memory}")
trusted fun p4WakeRouteRead(): u32 = u32(mmioLoadU32(0x5011004c))
trusted fun p4WakeRouteWrite(value: u32): void { mmioStoreU32(0x5011004c,int(value));return }
trusted fun p4WakeRouteFence(): void = p4WakeRouteAsmFence("fence iorw, iorw","~{memory}")
