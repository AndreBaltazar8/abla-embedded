import "./sleep_wake_route_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
trusted noescape extern:"inline-assembly" fun p4WakeRouteAsmRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4WakeRouteAsmFence(template: string,constraints: string): void
@export("p4WakeRouteHart")
trusted fun p4WakeRouteHartHook(): u32 = p4WakeRouteAsmRead("csrr $0, mhartid","=r,~{memory}")
@export("p4WakeRouteRead")
trusted fun p4WakeRouteReadHook(): u32 = u32(mmioLoadU32(0x5011004c))
@export("p4WakeRouteWrite")
trusted fun p4WakeRouteWriteHook(value: u32): void { mmioStoreU32(0x5011004c,int(value));return }
@export("p4WakeRouteFence")
trusted fun p4WakeRouteFenceHook(): void = p4WakeRouteAsmFence("fence iorw, iorw","~{memory}")
