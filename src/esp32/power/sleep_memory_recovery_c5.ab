import "./sleep_recovery_c5_sequence.ab"
import "../mspi_transition_c5_sequence.ab"
// Begin with esp32C5SleepRecoveryBeginOwned(...,memoryAddress=lease.address).
// Thereafter use this Continue operation, including when Begin returns pending.
// The ordinary recovery operation cannot bypass the stored memory fence.
// Restores profile/CPU/alarm, then the actual MSPI children, then cache/UART/time.
// Caller has stable PLL480, retained memory/code/stack and exclusive consumers;
// the temporary memory profile must be safe through the CPU restoration itself.
// No memory powerdown/chip latency programming or missing retention is implied.
@section(".iram1.abla.c5SleepMemoryRecovery")
trusted fun esp32C5SleepMemoryRecoveryContinueOwned(record: NativeBuffer,exclusive: bool): int {
    val result=esp32C5SleepRecoveryContinueOwned(record,exclusive)
    if (result != 3 || !exclusive) return result
    if (c5SleepRecordRead(record,8) != 3) return 3
    val address=c5SleepRecordRead(record,60)
    if (address == 0) return 3
    val cpu=c5CpuClockMHz(C5CpuClock(c5SleepRecordRead(record,20)))
    val closed=esp32C5MspiTransitionCloseAtCpuOwned(nativeBufferAt(address,448),cpu,true)
    c5SleepRecordWrite(record,48,closed)
    if (closed != 4) return 3
    c5SleepRecordWrite(record,60,0)
    esp32C5SleepRecoveryContinueOwned(record,true)
}
