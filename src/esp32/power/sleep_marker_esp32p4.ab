import "./sleep_marker_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepMarkerRead")
trusted fun p4SleepMarkerReadHook(): u32 = u32(mmioLoadU32(0x5011004c))
@export("p4SleepMarkerWrite")
trusted fun p4SleepMarkerWriteHook(value: u32): void { mmioStoreU32(0x5011004c,int(value));return }
