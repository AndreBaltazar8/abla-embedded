import "../../runtime/rtc_time48.ab"
import "../sdk/raw_buffer.ab"
// IDF6 C5 PMU_SLEEP_MC_DEFAULT and pmu_sleep_param_config_default.
//14 words:HP/LP minimum sleep,HP/LP analog,HP supply/up,LP supply/up,
// HP isolate/reset,LP isolate/reset,XTAL,PLL. No MMIO or sleep admission.
// Modem/REGDMA adjustment and power-domain inrush workaround are separate.
fun c5SleepTimingMicroseconds(index: int,deep: bool): int = if (index < 2) 450 else
    if (index == 2) 154 else if (index == 3) (if (deep) 500 else 154) else
    if (index < 8) 2 else if (index < 12) 1 else if (index == 12) 250 else 50
fun c5SleepTimingLimit(index: int): int = if (index == 2 || index >= 12) 65535 else
    if (index >= 4 && index <= 6) 511 else if (index == 7) 127 else 255
fun c5SleepTimingPeriod(index: int,slow: int,fast: int,minimum: int,xtalPoweredInHpSleep: bool): int =
    if (index < 2) minimum else if (index == 3 || (index == 12 && xtalPoweredInHpSleep)) slow else fast
// Periods are microseconds/tick in Q19. minimumPeriod optionally supplies
// IDF's fixed minimum-sleep period for enhanced modem sleep;0 selects slow.
// Floor rounding matches rtc_time_us_to_slowclk. Two passes leave output
// unchanged on any failure, including invalid calibration or field overflow.
trusted fun esp32C5SleepTimingCalibrated(output: NativeBuffer,slow: int,fast: int,
    deep: bool,xtalPoweredInHpSleep: bool,minimumPeriod: int = 0): bool {
    if (!output.hasAddressRange(0,56) || (output.addressValue()&3) != 0 || slow < 1 || slow > 4294967295 ||
        fast < 1 || fast > 4294967295 || minimumPeriod < 0 || minimumPeriod > 4294967295) return false
    val minimum=if (minimumPeriod == 0) slow else minimumPeriod
    var pass=0
    while (pass < 2) {
        var index=0
        while (index < 14) {
            val value=rtc48TicksForMicroseconds(c5SleepTimingMicroseconds(index,deep),
                c5SleepTimingPeriod(index,slow,fast,minimum,xtalPoweredInHpSleep))
            if (value < 0 || value > c5SleepTimingLimit(index)) return false
            if (pass == 1) output.storeU32(index*4,value)
            index=index+1
        }
        pass=pass+1
    }
    true
}
