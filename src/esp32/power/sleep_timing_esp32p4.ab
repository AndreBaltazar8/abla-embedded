import "./sleep_timing_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepTimingRead")
trusted fun p4SleepTimingReadHook(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
@export("p4SleepTimingWrite")
trusted fun p4SleepTimingWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value));return }
