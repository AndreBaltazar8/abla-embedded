import "./retention_descriptor_p4.ab"
// Complete upstream flash8/PSRAM14 controller retention node configurations.
// Pure builders: NOT live MMIO copies, clock changes, or calibration calls.
// Compose in exact node order. Preserve cache/PSRAM/flash exclusion, retained
// buffers and hardware recovery context; MMU ITEM_CONTENT/INDEX are excluded.
// Flash timing update is restore-only. PSRAM core/system gates enable on
// restore before copies, disable on backup after copies (never both passes).
fun esp32p4RetentionMspiWords(psram: bool,node: int): int {
    if (!psram) return if (node == 0) 42 else if (node == 1) 6 else if (node == 2 || node == 5) 1 else if (node == 3) 55 else if (node == 4) 41 else if (node == 6) 2 else 0
    return if (node == 2 || node == 4) 7 else if (node == 3) 9 else if (node == 5) 18 else if (node == 6) 2 else if (node == 7) 16 else if (node == 8) 4 else if (node == 9) 6 else if (node == 10 || node == 11) 1 else 0
}
fun esp32p4RetentionMspiAddress(psram: bool,node: int): int {
    if (!psram) return if (node == 0) 0x5008d000 else if (node == 1) 0x5008d0c0 else if (node == 2) 0x5008d180 else if (node == 3) 0x5008c000 else
        if (node == 4) 0x5008c100 else if (node == 5) 0x5008c200 else if (node == 6) 0x5008c384 else if (node == 7) 0x5008c180 else 0
    return if (node == 0 || node == 12) 0x500e6030 else if (node == 1 || node == 13) 0x500e6014 else if (node == 2) 0x5008e008 else if (node == 3) 0x5008e034 else
        if (node == 4) 0x5008e0c0 else if (node == 5) 0x5008e168 else if (node == 6) 0x5008e384 else if (node == 7) 0x5008f000 else
        if (node == 8) 0x5008f098 else if (node == 9) 0x5008f0c0 else if (node == 10) 0x5008f180 else if (node == 11) 0x5008f200 else 0
}
// Matches CONFIG_ESP_REV_MIN_FULL, not the detected chip revision. Flash
// entry3 participation is needed for the min-rev300 MSPI power-up workaround.
fun esp32p4RetentionMspiEntries(psram: bool,minimumRevision: int): int =
    if (minimumRevision < 0 || minimumRevision > 399) 0 else if (!psram && minimumRevision == 300) 9 else 1
trusted fun esp32p4RetentionMspiConfig(c: NativeBuffer,psram: bool,node: int,storage: int,next: int): bool {
    if (node < 0 || node >= (if (psram) 14 else 8) || !c.hasAddressRange(0,56) || (c.addressValue()&3) != 0 ||
        (next != 0 && !p4RetentionAddressSpan(next,4))) return false
    val words=esp32p4RetentionMspiWords(psram,node)
    if (words != 0) {
        if (!p4RetentionAddressSpan(storage,words*4) || (storage < c.addressValue()+56 && c.addressValue() < storage+words*4)) return false
    } else if (storage != 0) return false
    if (next != 0 && next < c.addressValue()+56 && c.addressValue() < next+4) return false
    var i=4
    while (i < 56) { c.storeU32(i,0);i=i+4 }
    val address=esp32p4RetentionMspiAddress(psram,node)
    c.storeU32(4,next);c.storeU32(20,address)
    var header=if (next == 0) 0x80000000 else 0
    if (words != 0) {
        header=header|words;c.storeU32(24,address);c.storeU32(28,storage)
    } else {
        val backupOnly=psram && node >= 12
        val mask=if (!psram) 64 else if (node == 0 || node == 12) 0x8000 else 0x80000000
        header=header|0x20000|(if (backupOnly) 0x20000000 else 0x40000000)
        c.storeU32(48,if (backupOnly) 0 else mask);c.storeU32(52,mask)
    }
    c.storeU32(0,header);return true
}
