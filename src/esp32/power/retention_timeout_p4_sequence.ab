import "abla/runtime/scalar"
// Exclusive quiescent PAU + LP recovery timeout configuration. Caller excludes
// PMU/ETM/software triggers and proves no operation outstanding; START/START_MAC
// are WT and MUST NOT be interpreted as an idle predicate. Clocks stay pinned.
// No start/reset/ack/power changes. Snapshot17bits@8,LP27bits@25,owned52.
// 1configured2invalid3clock4partial5closed. Preserve original LP burst limit.
type P4RetentionTimeout=int
fun P4RetentionTimeout.status(): int = this&255
fun P4RetentionTimeout.hasSnapshot(): bool = (this&(1<<52)) != 0
trusted fun p4RetentionTimeoutPau(value: u32): bool {
    p4RetentionPauWrite(44,(p4RetentionPauRead(44)&u32(0xfffe0000))|value)
    return (p4RetentionPauRead(44)&u32(0x1ffff)) == value
}
trusted fun p4RetentionTimeoutLp(value: u32): bool {
    p4RetentionLpWrite(340,(p4RetentionLpRead(340)&u32(31))|value)
    return (p4RetentionLpRead(340)&u32(0xffffffe0)) == value
}
trusted fun esp32p4RetentionTimeoutOpenOwned(waitCount: int,readInterval: int,lpWaitCount: int,lpBackupCount: int,lpInterval: int,exclusiveIdle: bool): P4RetentionTimeout {
    if (!exclusiveIdle || waitCount < 1 || waitCount > 1023 || readInterval < 1 || readInterval > 127 ||
        lpWaitCount < 1 || lpWaitCount > 1023 || lpBackupCount < 1 || lpBackupCount > 1023 || lpInterval < 1 || lpInterval > 127) return P4RetentionTimeout(2)
    if (!p4RetentionClockReady()) return P4RetentionTimeout(3)
    val token=(1<<52)|(int(p4RetentionPauRead(44)&u32(0x1ffff))<<8)|(int(p4RetentionLpRead(340)>>u32(5))<<25)
    if (!p4RetentionTimeoutPau(u32((waitCount<<7)|readInterval)) ||
        !p4RetentionTimeoutLp(u32((lpWaitCount<<22)|(lpBackupCount<<12)|(lpInterval<<5)))) return P4RetentionTimeout(token|4)
    return P4RetentionTimeout(token|1)
}
trusted fun P4RetentionTimeout.closeOwned(exclusiveIdle: bool): P4RetentionTimeout {
    if (!exclusiveIdle || !this.hasSnapshot() || this.status() == 5) return this
    if (!p4RetentionClockReady()) return P4RetentionTimeout((this&(~255))|3)
    val closed=p4RetentionTimeoutLp(u32(((this>>>25)&0x7ffffff)<<5)) && p4RetentionTimeoutPau(u32((this>>>8)&0x1ffff))
    return P4RetentionTimeout((this&(~255))|(if (closed) 5 else 4))
}
// For an operation already issued under caller ownership with its stale IRQs
// explicitly cleared BEFORE issuance. Does not start/stop/acknowledge anything.
// Error takes precedence over DONE. Timeout6 retains engine/list ownership.
// Low8:1done2invalid3clock4flow-error5error-IRQ6pending. flow8..10,raw16..17.
trusted fun esp32p4RetentionWaitOwned(polls: int,exclusiveIssued: bool): int {
    if (!exclusiveIssued || polls < 1 || polls > 1000000) return 2
    if (!p4RetentionClockReady()) return 3
    var remaining=polls
    while (remaining > 0) {
        val raw=int(p4RetentionPauRead(52)&u32(3))
        val flow=int(p4RetentionPauRead(0)&u32(7))
        val detail=(raw<<16)|(flow<<8)
        if (flow != 0) return detail|4
        if ((raw&2) != 0) return detail|5
        if ((raw&1) != 0) return detail|1
        remaining=remaining-1
    }
    return 6
}
