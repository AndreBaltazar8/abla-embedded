import "./sleep_memory_cycle_base_c5.ab"
import "../flash_identified_ready_c5.ab"
import "../gpio/wake_session_c5_sequence.ab"
// Retained context772B: memory request48,lease448@48,identified readiness240
// @496,GPIO session32@736,immutable pin/high@768. Caller qualifies SDR/MSPI,
// GPIO pads/domain, all digital wake sources and clock/voltage ownership.
// Requires timer+GPIO in entry mask; no implicit pin or domain reconfiguration.
// Waiting for pin release retains applied memory lease and suspended caches.
// Chip-blocked5/6 occurs before GPIO or memory mutation; explicit Recheck
// re-observes chip status, never resumes the chip or forces compatibility.
@section(".iram1.abla.c5SleepGpioIdentifiedBegin")
trusted fun esp32C5SleepGpioIdentifiedMemoryBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,pin: int,high: bool,exclusive: bool): int {
    if (!exclusive || pin < 0 || pin > 28 || !context.hasAddressRange(0,772) ||
        (context.addressValue()&3) != 0 || !record.hasAddressRange(0,792) || (record.addressValue()&3) != 0 ||
        c5SleepRecordRead(record,0) != 0 || !c5SleepCycleRequestValid(request,true) || (request.loadU32(60)&4) == 0) return 2
    val address=context.addressValue();val base=record.addressValue();val input=request.addressValue()
    if ((base < address+772 && address < base+792) || (input < address+772 && address < input+68) ||
        (base < input+68 && input < base+792) || c5SleepRecordRead(context,48) != 0 ||
        c5SleepRecordRead(context,496) != 0 || c5SleepRecordRead(context,736) != 0) return 2
    c5SleepRecordWrite(context,768,pin|(if (high) 64 else 0))
    c5SleepCycleBeginContextOwned(record,request,true,address)
}
@section(".iram1.abla.c5SleepGpioIdentifiedRecheck")
trusted fun esp32C5SleepGpioIdentifiedMemoryRecheckOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,792) || (record.addressValue()&3) != 0 ||
        c5SleepRecordRead(record,0) != 0x43594331 || c5SleepRecordRead(record,4) != 7) return 2
    val address=c5SleepRecordRead(record,108)
    if (address == 0) return 2
    val context=nativeBufferAt(address,772)
    if (c5SleepRecordRead(context,48) != 0 || c5SleepRecordRead(context,736) != 0 ||
        c5SleepRecordRead(context,496) != 0x43495231) return 2
    val state=c5SleepRecordRead(context,500)
    if (state != 4 && state != 5) return 2
    c5SleepRecordWrite(context,496,0)
    esp32C5SleepCycleContinueOwned(record,true)
}
@inline
trusted fun c5SleepCyclePrepare(record: NativeBuffer): int = c5SleepMemoryPrepareBase(record)
@inline
trusted fun c5SleepCycleEntry(record: NativeBuffer): int {
    val address=c5SleepRecordRead(record,108)
    if (address == 0) return -3
    val context=nativeBufferAt(address,772)
    val ready=esp32C5FlashIdentifiedReadyOwned(nativeBufferAt(address+496,240),c5SleepRecordRead(record,80),true)
    if (ready == 3) return -5
    if (ready == 4) return -6
    if (ready == 5) return -7
    if (ready != 1) return -3
    if (c5SleepRecordRead(context,48) == 0) {
        if (esp32C5MspiTransitionBeginOwned(nativeBufferAt(address+48,448),nativeBufferAt(address,48),true) != 1) return -3
    } else if (c5SleepRecordRead(context,48) != 0x434d5831 || c5SleepRecordRead(context,52) != 1) return -3
    if (!c5SleepCycleDeadlineReady(record)) return -3
    val session=nativeBufferAt(address+736,32);val plan=c5SleepRecordRead(context,768)
    val pinReady=if (c5SleepRecordRead(session,0) == 0)
        esp32C5GpioWakeSessionOpenOwned(session,plan&63,(plan&64) != 0,true)
        else esp32C5GpioWakeSessionArmOwned(session,true)
    if (pinReady == 5) return -5
    if (pinReady != 1) return -3
    c5SleepCycleTimedEntry(record)
}
@inline
trusted fun c5SleepCycleRecovery(record: NativeBuffer): int {
    val result=c5SleepMemoryRecoveryBase(record)
    if (result != 1) return result
    val address=c5SleepRecordRead(record,108)
    if (address == 0) return 2
    val session=nativeBufferAt(address+736,32)
    if (c5SleepRecordRead(session,0) == 0) return 1
    if (esp32C5GpioWakeSessionCloseOwned(session,true) != 4) return 3
    return 1
}
