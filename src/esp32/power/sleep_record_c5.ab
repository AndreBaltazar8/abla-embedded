import "../sdk/raw_buffer.ab"
import "abla/unsafe/mmio"
// Internal record access after the owning API validates its complete range.
// Byte operations preserve NativeBuffer's unaligned little-endian behavior;
// explicit retained placement prevents a cache-off cleanup calling outlined
// general-purpose buffer helpers in flash. Records must reside in internal RAM.
@section(".iram1.abla.c5SleepRecordRead")
trusted fun c5SleepRecordRead(record: NativeBuffer,offset: int): int {
    val address=record.addressValue()+offset
    mmioLoadU8(address)|(mmioLoadU8(address+1)<<8)|(mmioLoadU8(address+2)<<16)|(mmioLoadU8(address+3)<<24)
}
@section(".iram1.abla.c5SleepRecordWrite")
trusted fun c5SleepRecordWrite(record: NativeBuffer,offset: int,value: int): void {
    val address=record.addressValue()+offset
    mmioStoreU8(address,value&255);mmioStoreU8(address+1,(value>>>8)&255)
    mmioStoreU8(address+2,(value>>>16)&255);mmioStoreU8(address+3,(value>>>24)&255)
    return
}
