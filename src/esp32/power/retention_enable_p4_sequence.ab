import "abla/runtime/scalar"
// PMU HP_ACTIVE<->HP_SLEEP backup-enable lease, matching pmu_hal ordering.
// Caller has prepared PAU graphs/timeout/backup modes/clocks and excludes ALL
// PMU transitions and PAU triggers throughout configuration and cleanup.
// Setting these bits arms future transitions; it does not start a backup.
// No AON-bypass change: its separate lifecycle must remain owned by caller.
// Token oldSleep31@8,oldActive29@9,owned10;1armed2invalid3partial4closed.
type P4RetentionEnable=int
fun P4RetentionEnable.status(): int = this&255
fun P4RetentionEnable.hasSnapshot(): bool = (this&1024) != 0
trusted fun p4RetentionEnableField(offset: int,mask: u32,value: u32): bool {
    p4RetentionPmuWrite(offset,(p4RetentionPmuRead(offset)&~mask)|value)
    return (p4RetentionPmuRead(offset)&mask) == value
}
trusted fun esp32p4RetentionEnableOpenOwned(exclusivePrepared: bool): P4RetentionEnable {
    if (!exclusivePrepared) return P4RetentionEnable(2)
    val token=1024|(int(p4RetentionPmuRead(132)>>u32(31))<<8)|
        (int((p4RetentionPmuRead(28)>>u32(29))&u32(1))<<9)
    if (!p4RetentionEnableField(132,u32(0x80000000),u32(0x80000000)) ||
        !p4RetentionEnableField(28,u32(0x20000000),u32(0x20000000))) return P4RetentionEnable(token|3)
    return P4RetentionEnable(token|1)
}
trusted fun P4RetentionEnable.closeOwned(exclusiveIdle: bool): P4RetentionEnable {
    if (!exclusiveIdle || !this.hasSnapshot() || this.status() == 4) return this
    val closed=p4RetentionEnableField(28,u32(0x20000000),u32((this>>>9)&1)<<u32(29)) &&
        p4RetentionEnableField(132,u32(0x80000000),u32((this>>>8)&1)<<u32(31))
    return P4RetentionEnable((this&(~255))|(if (closed) 4 else 3))
}
