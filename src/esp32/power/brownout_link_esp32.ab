import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkBrownoutControlOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspBrownoutInit", "esp_brownout_init")) return false
    if (!internalFunction("esp32RecoveredEspBrownoutDisable", "esp_brownout_disable")) return false
    if (!internalFunction("esp32RecoveredEspBrownoutRegisterCallback", "esp_brownout_register_callback")) return false
    true
}
