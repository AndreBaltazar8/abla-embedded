import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Exclusive EXT1 + LP pads + clocks lease. No PMU trigger enable, sleep entry,
// power-domain startup or wake-status acknowledgment. Caller excludes sleep,
// former pad users and all RCC/LP writers throughout this record's lifetime.
// 160B aligned, zero-initialized caller storage: magic/state/primary/cleanup,
// clock32@16, reserved@20, EXT1 scalar64@24, sixteen pad scalars64@32.
// State1ready3partial4closed. Results1ready2invalid4clock5EXT1park6pad
// 7EXT1configure8closed9cleanup. Primary is retained independently of cleanup.
trusted fun p4WakeSessionValid(r: NativeBuffer): bool =
    r.hasAddressRange(0,160) && (r.addressValue()&3) == 0 && r.loadU32(0) == 0x50345731
trusted fun p4WakeSessionLoad(r: NativeBuffer,offset: int): int =
    r.loadU32(offset)|(r.loadU32(offset+4)<<32)
trusted fun p4WakeSessionStore(r: NativeBuffer,offset: int,value: int): void {
    r.storeU32(offset,value&0xffffffff);r.storeU32(offset+4,value>>>32);return
}
trusted fun esp32p4WakeSessionOpenOwned(r: NativeBuffer,selection: u32,highLevels: u32,
    pull: int,filter: bool,layout: int,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,160) || (r.addressValue()&3) != 0 ||
        r.loadU32(0) != 0 || selection == u32(0) || selection > u32(65535) ||
        (highLevels&~selection) != u32(0) || pull < 0 || pull > 2 || (layout != 1 && layout != 3)) return 2
    var offset=4
    while (offset < 160) { r.storeU32(offset,0);offset=offset+4 }
    r.storeU32(0,0x50345731);r.storeU32(4,3)
    val clock=p4WakeSessionClockOpen(layout)
    r.storeU32(16,clock)
    if ((clock&255) != 1) { r.storeU32(8,4);return 4 }
    val ext=p4WakeSessionExtOpen()
    p4WakeSessionStore(r,24,ext)
    if ((ext&255) != 6) { r.storeU32(8,5);return 5 }
    var pin=0
    while (pin < 16) {
        if ((selection&(u32(1)<<u32(pin))) != u32(0)) {
            val pad=p4WakeSessionPadOpen(pin,pull,layout)
            p4WakeSessionStore(r,32+pin*8,pad)
            if ((pad&255) != 1) { r.storeU32(8,6);return 6 }
        }
        pin=pin+1
    }
    val configured=p4WakeSessionExtConfigure(ext,selection,highLevels,filter)
    p4WakeSessionStore(r,24,configured)
    if ((configured&255) != 1) { r.storeU32(8,7);return 7 }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4WakeSessionCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !p4WakeSessionValid(r)) return 2
    if (r.loadU32(4) == 4) return 8
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    r.storeU32(4,3)
    var ext=p4WakeSessionLoad(r,24)
    // Once EXT1 is restored, never park it again during a clock-close retry.
    if ((ext&(1<<41)) != 0 && (ext&255) != 5) {
        ext=p4WakeSessionExtPark(ext)
        p4WakeSessionStore(r,24,ext)
        if ((ext&255) != 6) { r.storeU32(12,5);return 9 }
    }
    var pin=15
    while (pin >= 0) {
        val offset=32+pin*8
        val pad=p4WakeSessionLoad(r,offset)
        if ((pad&(1<<34)) != 0 && (pad&255) != 6) {
            val restored=p4WakeSessionPadClose(pad)
            p4WakeSessionStore(r,offset,restored)
            if ((restored&255) != 6) { r.storeU32(12,6);return 9 }
        }
        pin=pin-1
    }
    if ((ext&(1<<41)) != 0 && (ext&255) != 5) {
        ext=p4WakeSessionExtClose(ext)
        p4WakeSessionStore(r,24,ext)
        if ((ext&255) != 5) { r.storeU32(12,7);return 9 }
    }
    val clock=p4WakeSessionClockClose(r.loadU32(16))
    r.storeU32(16,clock)
    if ((clock&255) != 6) { r.storeU32(12,4);return 9 }
    r.storeU32(12,0);r.storeU32(4,4);return 8
}
