import "./sleep_policy_esp32s3.ab"

// First domain/isolation phase of rtc_sleep_init, not a sleep-entry routine.
// Disabling PD intentionally does not force the domain on or undo isolation:
// these overrides belong to the coordinated resume/power-up sequence.
trusted fun esp32S3SleepDomainsPrepareOwned(policy: Esp32S3SleepPolicy): bool {
    if (!policy.valid()) return false
    val flags=policy.flags()
    if ((flags & 64) != 0) {
        esp32S3RtcWakeUpdate(0x60008094,1<<29,0)
        esp32S3RtcWakeUpdate(0x60008090,1<<18,0)
    }
    esp32S3RtcWakeUpdate(0x60008090,1<<30,if ((flags & 64) != 0) 1<<30 else 0)
    if ((flags & 256) != 0) {
        esp32S3RtcWakeUpdate(0x60008094,(1<<27) | (1<<26),0)
        esp32S3RtcWakeUpdate(0x60008090,1<<22,0)
    }
    esp32S3RtcWakeUpdate(0x60008090,1<<29,if ((flags & 256) != 0) 1<<29 else 0)
    if ((flags & 512) != 0) {
        esp32S3RtcWakeUpdate(0x60008094,(1<<25) | (1<<24),0)
        esp32S3RtcWakeUpdate(0x60008090,1<<14,0)
    }
    esp32S3RtcWakeUpdate(0x60008090,1<<28,if ((flags & 512) != 0) 1<<28 else 0)
    if ((flags & 2) != 0) esp32S3RtcWakeUpdate(0x60008088,(1<<19) | 48,0)
    esp32S3RtcWakeUpdate(0x60008088,1<<20,if ((flags & 2) != 0) 1<<20 else 0)
    true
}
