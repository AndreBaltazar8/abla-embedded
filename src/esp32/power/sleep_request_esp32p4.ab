import "./sleep_request_p4_sequence.ab"
import "./sleep_cache_esp32p4.ab"
import "../../hal/esp32_power.ab"
import "abla/unsafe/mmio"
@export("p4SleepRequestRead")
trusted fun p4SleepRequestReadHook(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
@export("p4SleepRequestWrite")
trusted fun p4SleepRequestWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value));return }
