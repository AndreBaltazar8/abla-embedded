import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSarPeripheralControlOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredSarPeriphCtrlInit", "sar_periph_ctrl_init")) return false
    if (!exportFunction("esp32RecoveredSarPeriphCtrlPowerEnable", "sar_periph_ctrl_power_enable")) return false
    if (!exportFunction("esp32RecoveredSarPeriphCtrlPowerDisable", "sar_periph_ctrl_power_disable")) return false
    if (!exportFunction("esp32RecoveredSarPeriphCtrlPwdetPowerAcquire", "sar_periph_ctrl_pwdet_power_acquire")) return false
    if (!exportFunction("esp32RecoveredSarPeriphCtrlPwdetPowerRelease", "sar_periph_ctrl_pwdet_power_release")) return false
    if (!internalFunction("esp32RecoveredSarPeriphCtrlAdcOneshotPowerAcquire", "sar_periph_ctrl_adc_oneshot_power_acquire")) return false
    if (!internalFunction("esp32RecoveredSarPeriphCtrlAdcOneshotPowerRelease", "sar_periph_ctrl_adc_oneshot_power_release")) return false
    if (!internalFunction("esp32RecoveredSarPeriphCtrlAdcContinuousPowerAcquire", "sar_periph_ctrl_adc_continuous_power_acquire")) return false
    if (!internalFunction("esp32RecoveredSarPeriphCtrlAdcContinuousPowerRelease", "sar_periph_ctrl_adc_continuous_power_release")) return false
    if (!internalFunction("esp32RecoveredSarPeriphCtrlAdcReset", "sar_periph_ctrl_adc_reset")) return false
    if (!internalFunction("esp32RecoveredAdcResetLockAcquire", "adc_reset_lock_acquire")) return false
    if (!internalFunction("esp32RecoveredAdcResetLockRelease", "adc_reset_lock_release")) return false
    true
}
