fun p4SleepRegulatorOffset(i: int): int = if (i < 2) 144+i*4 else if (i < 4) 156+(i-2)*4 else 180+(i-4)*4
fun p4SleepRegulatorMask(i: int,revision: int): u32 = if ((i&1) != 0) u32(0xfc000000) else
    if (i != 0) u32(0xffe00000) else if (revision >= 100) u32(0xffff0000) else u32(0xff870000)
fun p4SleepBiasOffset(i: int): int = if (i == 0) 24 else if (i == 1) 128 else 200
fun p4SleepBiasMask(i: int): u32 = if (i == 0) u32(0x01800000) else if (i == 1) u32(0xfdfc0000) else u32(0xfc000000)
fun p4SleepAnalogOffset(slot: int): int = if (slot < 3) p4SleepBiasOffset(slot) else p4SleepRegulatorOffset(slot-3)
fun p4SleepAnalogMask(slot: int,rev: int): u32 = if (slot < 3) p4SleepBiasMask(slot) else p4SleepRegulatorMask(slot-3,rev)
