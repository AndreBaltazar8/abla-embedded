import "./sleep_cpu_retained_p4_sequence.ab"
import "./sleep_cpu_aux_esp32p4.ab"
import "./sleep_clic_esp32p4.ab"
import "./sleep_fpu_esp32p4.ab"
import "./sleep_core_esp32p4.ab"
import "../../hal/esp32_power.ab"
@export("p4CpuRetainedHart")
trusted fun p4CpuRetainedHartHook(): u32 = p4CpuAuxHart()
@export("p4CpuRetainedStatus")
trusted fun p4CpuRetainedStatusHook(): u32 = p4CpuAuxStatus()
@export("p4CpuRetainedInvoke")
trusted fun p4CpuRetainedInvokeHook(core: NativeBuffer,callback: int,context: u32,revision: int): int =
    esp32p4SleepCoreInvokeOwned(core,callback,context,revision,true)
