import "./sleep_cpu_retained_p4_sequence.ab"
import "./sleep_cpu_aux_esp32p4.ab"
import "./sleep_clic_esp32p4.ab"
import "./sleep_fpu_esp32p4.ab"
import "./sleep_core_esp32p4.ab"
trusted fun p4CpuRetainedHart(): u32 = p4CpuAuxHart()
trusted fun p4CpuRetainedStatus(): u32 = p4CpuAuxStatus()
trusted fun p4CpuRetainedInvoke(core: NativeBuffer,callback: int,context: u32,revision: int): int =
    esp32p4SleepCoreInvokeOwned(core,callback,context,revision,true)
