import "./pvt_park_c5_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.c5PvtParkRead")
trusted fun c5PvtParkRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5PvtParkWrite")
trusted fun c5PvtParkWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
