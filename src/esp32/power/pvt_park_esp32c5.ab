import "./pvt_park_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@section(".iram1.abla.c5PvtParkRead")
@export("c5PvtParkRead")
trusted fun c5PvtParkReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5PvtParkWrite")
@export("c5PvtParkWrite")
trusted fun c5PvtParkWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
