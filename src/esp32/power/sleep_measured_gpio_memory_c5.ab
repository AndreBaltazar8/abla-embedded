import "./sleep_measured_cycle_common_c5.ab"
import "./sleep_gpio_identified_memory_c5.ab"
//1024B measured lifecycle + disjoint retained772B identified-memory/GPIO
// context. Measurements run cache-on before any chip/memory/GPIO access.
// General Continue covers calibration; AfterCalibration is retained-only.
// All underlying SDR, pad, domain, clock, voltage and exclusion prerequisites
// apply.5/6 preserve chip-blocked ownership;3 may mean cache-off GPIO waiting.
// Cache-on, read-only admission for board coordinators before device I/O.
trusted fun c5SleepMeasuredGpioMemoryAdmitted(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,pin: int,slowCycles: int,fastCycles: int,exclusive: bool): bool {
    if (!exclusive || pin < 0 || pin > 28 || !context.hasAddressRange(0,772) || (context.addressValue()&3) != 0 ||
        !record.hasAddressRange(0,1024) || (record.addressValue()&3) != 0 || c5SleepRecordRead(record,0) != 0 ||
        !c5SleepCycleRequestValid(request,false) || (request.loadU32(60)&4) == 0 ||
        slowCycles < 1 || slowCycles >= 32767 || fastCycles < 32 || fastCycles > 1048512) return false
    val address=context.addressValue();val base=record.addressValue();val input=request.addressValue()
    if ((base < address+772 && address < base+1024) || (input < address+772 && address < input+68) ||
        (base < input+68 && input < base+1024) || c5SleepRecordRead(context,48) != 0 ||
        c5SleepRecordRead(context,496) != 0 || c5SleepRecordRead(context,736) != 0) return false
    return true
}
@section(".iram1.abla.c5MeasuredGpioMemoryBegin")
trusted fun esp32C5SleepMeasuredGpioMemoryBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,pin: int,high: bool,slowCycles: int,fastCycles: int,exclusive: bool): int {
    if (!c5SleepMeasuredGpioMemoryAdmitted(record,request,context,pin,slowCycles,fastCycles,exclusive)) return 2
    c5SleepRecordWrite(context,768,pin|(if (high) 64 else 0))
    c5SleepMeasuredBeginContextOwned(record,request,slowCycles,fastCycles,true,context.addressValue())
}
@section(".iram1.abla.c5MeasuredGpioMemoryRecheck")
trusted fun esp32C5SleepMeasuredGpioMemoryRecheckOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,1024) || (record.addressValue()&3) != 0 ||
        c5SleepRecordRead(record,0) != 0x434d4331 || c5SleepRecordRead(record,4) != 3 || c5SleepRecordRead(record,8) != 3) return 2
    val result=esp32C5SleepGpioIdentifiedMemoryRecheckOwned(nativeBufferAt(record.addressValue()+232,792),true)
    if (result == 2) return 2
    c5MeasuredCycleResult(record,result)
}
