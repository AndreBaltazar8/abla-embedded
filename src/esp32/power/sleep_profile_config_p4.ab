import "./sleep_power_fields_p4.ab"
import "./sleep_analog_fields_p4.ab"
import "./sleep_timing_logic_p4.ab"
trusted fun p4SleepProfileConfigValid(c: NativeBuffer,revision: int): bool {
    if (revision < 0 || revision > 399 || !c.hasAddressRange(0,108) || (c.addressValue()&3) != 0) return false
    val layout=if (revision >= 300) 3 else 1
    var i=0
    while (i < 8) {
        if ((u32(c.loadU32(i*4))&~p4SleepPowerMask(i,layout)) != u32(0) ||
            (u32(c.loadU32(32+i*4))&~p4SleepAnalogMask(i+1,revision)) != u32(0)) return false
        i=i+1
    }
    if (revision >= 100 && (c.loadU32(40)&0x00380000) != 0) return false
    i=0
    while (i < 10) { if (c.loadU32(64+i*4) > p4SleepProfileTimingLimit(i)) return false;i=i+1 }
    return c.loadU32(104) <= 63
}
