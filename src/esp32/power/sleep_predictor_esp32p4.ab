import "./sleep_predictor_p4_sequence.ab"
import "../../hal/esp32_power.ab"
trusted noescape extern:"inline-assembly" fun p4SleepPredictorCsrRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4SleepPredictorCsrMask(template: string,constraints: string,mask: u32): u32
@export("p4SleepPredictorHart")
trusted fun p4SleepPredictorHartHook(): u32 = p4SleepPredictorCsrRead("csrr $0, mhartid","=r,~{memory}")
@export("p4SleepPredictorRead")
trusted fun p4SleepPredictorReadHook(): u32 = p4SleepPredictorCsrRead("csrr $0, 0x7c1","=r,~{memory}")
@export("p4SleepPredictorClear")
trusted fun p4SleepPredictorClearHook(mask: u32): u32 = p4SleepPredictorCsrMask("csrrc $0, 0x7c1, $1","=r,r,~{memory}",mask)
@export("p4SleepPredictorSet")
trusted fun p4SleepPredictorSetHook(mask: u32): u32 = p4SleepPredictorCsrMask("csrrs $0, 0x7c1, $1","=r,r,~{memory}",mask)
