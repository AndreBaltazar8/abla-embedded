import "./sleep_predictor_p4_sequence.ab"
trusted noescape extern:"inline-assembly" fun p4SleepPredictorCsrRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4SleepPredictorCsrMask(template: string,constraints: string,mask: u32): u32
trusted fun p4SleepPredictorHart(): u32 = p4SleepPredictorCsrRead("csrr $0, mhartid","=r,~{memory}")
trusted fun p4SleepPredictorRead(): u32 = p4SleepPredictorCsrRead("csrr $0, 0x7c1","=r,~{memory}")
trusted fun p4SleepPredictorClear(mask: u32): u32 = p4SleepPredictorCsrMask("csrrc $0, 0x7c1, $1","=r,r,~{memory}",mask)
trusted fun p4SleepPredictorSet(mask: u32): u32 = p4SleepPredictorCsrMask("csrrs $0, 0x7c1, $1","=r,r,~{memory}",mask)
