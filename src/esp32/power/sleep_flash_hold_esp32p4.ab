import "./sleep_flash_hold_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepFlashHoldRead")
trusted fun p4SleepFlashHoldReadHook(): int = mmioLoadU32(0x501101cc)
@export("p4SleepFlashHoldWrite")
trusted fun p4SleepFlashHoldWriteHook(value: int): void { mmioStoreU32(0x501101cc,value);return }
