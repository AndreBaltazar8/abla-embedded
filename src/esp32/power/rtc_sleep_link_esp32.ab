import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRtcSleepOpaqueCallers(): bool {
    if (!internalFunction("esp32RtcSleepPd", "rtc_sleep_pd")) return false
    if (!exportFunction("esp32RtcSleepGetDefaultConfig", "rtc_sleep_get_default_config")) return false
    if (!exportFunction("esp32RtcSleepInit", "rtc_sleep_init")) return false
    if (!exportFunction("esp32RtcSleepLowInit", "rtc_sleep_low_init")) return false
    if (!exportFunction("esp32RtcSleepStart", "rtc_sleep_start")) return false
    if (!internalFunction("esp32RtcDeepSleepStart", "rtc_deep_sleep_start")) return false
    true
}
