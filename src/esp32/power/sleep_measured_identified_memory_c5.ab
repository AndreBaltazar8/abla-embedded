import "./sleep_measured_cycle_common_c5.ab"
import "./sleep_identified_memory_cycle_c5.ab"
//1024B measured wrapper + disjoint retained736B observed-ID memory context.
// Calibration precedes cache-off ID/status admission.5/6 preserve all ownership;
// use explicit Recheck after owner action, never remeasure/reissue sleep.
// Dedicated post-calibration entry keeps its entire callable closure in IRAM;
// unlike the general Continue, it cannot dispatch to cache-on calibration.
@section(".iram1.abla.c5MeasuredIdentifiedMemoryAfterCalibration")
trusted fun esp32C5SleepMeasuredIdentifiedAfterCalibrationOwned(record: NativeBuffer,exclusive: bool): int =
    esp32C5SleepMeasuredAfterCalibrationOwned(record,exclusive)
@section(".iram1.abla.c5MeasuredIdentifiedMemoryBegin")
trusted fun esp32C5SleepMeasuredIdentifiedMemoryBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,slowCycles: int,fastCycles: int,exclusiveQualifiedSdr: bool): int {
    if (!exclusiveQualifiedSdr || !context.hasAddressRange(0,736) || (context.addressValue()&3) != 0 ||
        !record.hasAddressRange(0,1024) || !request.hasAddressRange(0,68)) return 2
    val address=context.addressValue();val base=record.addressValue();val input=request.addressValue()
    if ((base < address+736 && address < base+1024) || (input < address+736 && address < input+68) ||
        c5SleepRecordRead(context,48) != 0 || c5SleepRecordRead(context,496) != 0) return 2
    c5SleepMeasuredBeginContextOwned(record,request,slowCycles,fastCycles,true,address)
}
@section(".iram1.abla.c5MeasuredIdentifiedMemoryRecheck")
trusted fun esp32C5SleepMeasuredIdentifiedMemoryRecheckOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,1024) || (record.addressValue()&3) != 0 ||
        c5SleepRecordRead(record,0) != 0x434d4331 || c5SleepRecordRead(record,4) != 3 || c5SleepRecordRead(record,8) != 3) return 2
    val result=esp32C5SleepIdentifiedMemoryRecheckOwned(nativeBufferAt(record.addressValue()+232,792),true)
    if (result == 2) return 2
    c5MeasuredCycleResult(record,result)
}
