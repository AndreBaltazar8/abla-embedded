import "./cpll_p4_sequence.ab"
import "../analog/register_esp32p4.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun p4CpllCsr(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4CpllVoidAsm(template: string,constraints: string): void
trusted fun p4CpllFence(): void = p4CpllVoidAsm("fence iorw, iorw","~{memory}")
trusted fun p4CpllHart(): u32 = p4CpllCsr("csrr $0, mhartid","=r,~{memory}")
trusted fun p4CpllCycle(): u32 = p4CpllCsr("csrr $0, mcycle","=r,~{memory}")
trusted fun p4CpllRead(address: int): int = mmioLoadU32(address)
trusted fun p4CpllWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
