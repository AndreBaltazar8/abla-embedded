import "./cpll_p4_sequence.ab"
import "../analog/register_esp32p4.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
trusted noescape extern:"inline-assembly" fun p4CpllCsr(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4CpllVoidAsm(template: string,constraints: string): void
@export("p4CpllFence")
trusted fun p4CpllFenceHook(): void = p4CpllVoidAsm("fence iorw, iorw","~{memory}")
@export("p4CpllHart")
trusted fun p4CpllHartHook(): u32 = p4CpllCsr("csrr $0, mhartid","=r,~{memory}")
@export("p4CpllCycle")
trusted fun p4CpllCycleHook(): u32 = p4CpllCsr("csrr $0, mcycle","=r,~{memory}")
@export("p4CpllRead")
trusted fun p4CpllReadHook(address: int): int = mmioLoadU32(address)
@export("p4CpllWrite")
trusted fun p4CpllWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
