import "./sleep_measured_cycle_common_c5.ab"
import "./sleep_memory_cycle_composition_c5.ab"
// Same1024B measured lifecycle, with an external retained496B memory context.
// Word100 retains its address throughout calibration retries; cycle340 takes
// the same address when calibration/binding completes. Never remeasure after
// that transfer. Context request48 and transition448 must remain exclusively
// owned through completion, including calibration failure before memory use.
// All measured-cycle and memory-cycle hardware prerequisites still apply.
@section(".iram1.abla.c5MeasuredMemoryCycleBegin")
trusted fun esp32C5SleepMeasuredMemoryBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,slowCycles: int,fastCycles: int,exclusiveReady: bool): int {
    if (!exclusiveReady || !context.hasAddressRange(0,496) || (context.addressValue()&3) != 0 ||
        !record.hasAddressRange(0,1024) || !request.hasAddressRange(0,68)) return 2
    val address=context.addressValue();val base=record.addressValue();val input=request.addressValue()
    if ((base < address+496 && address < base+1024) || (input < address+496 && address < input+68) ||
        c5SleepRecordRead(context,48) != 0) return 2
    c5SleepMeasuredBeginContextOwned(record,request,slowCycles,fastCycles,true,address)
}
