import "../rtc_timer_s3_sequence.ab"
import "./sleep_init_s3_sequence.ab"

// TIMER1 PLL[31:24], XTAL[23:14], RC-fast[13:6], low six bits unrelated.
// Returns -1 if a calibrated light-sleep wait cannot fit the 10-bit field.
// Deep-sleep defaults are cycle counts and do not consume calibration.
fun esp32S3SleepTimingBits(periodQ19: int, deep: bool): int {
    if (deep) return (20<<24) | (100<<14) | (20<<6)
    val xtal=esp32S3RtcTicksForMicroseconds(250,periodQ19)
    if (xtal < 0 || xtal > 1023) return -1
    (1<<24) | (xtal<<14) | (4<<6)
}

trusted fun esp32S3SleepLowInitOwned(periodQ19: int, deep: bool): bool {
    val timing=esp32S3SleepTimingBits(periodQ19,deep)
    if (timing < 0) return false
    esp32S3RtcWakeUpdate(0x6000801C,0xFFFFFFC0,timing)
    true
}

// Default register preparation as one validated operation. Reject bad timing
// BEFORE any regulator/domain write. This still does not enter sleep: caller
// must implement the clock/cache/retention/other-core coordination around it.
trusted fun esp32S3SleepRegistersPrepareOwned(flags: int,periodQ19: int): bool {
    val policy=esp32S3SleepPolicy(flags)
    if (!policy.valid()) return false
    val timing=esp32S3SleepTimingBits(periodQ19,(flags & 1) != 0)
    if (timing < 0) return false
    esp32S3SleepInitOwned(policy)
    esp32S3RtcWakeUpdate(0x6000801C,0xFFFFFFC0,timing)
    true
}
