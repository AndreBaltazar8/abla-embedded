import "./sleep_profile_config_p4.ab"
import "./retention_config_p4.ab"
trusted fun p4RoundConfigValid(c: NativeBuffer): bool =
    c.hasAddressRange(0,192) && (c.addressValue()&3) == 0 && c.loadU32(0) == 300 && (c.loadU32(4) == 20 || c.loadU32(4) == 40 || c.loadU32(4) == 360 || c.loadU32(4) == 400) &&
    (c.loadU32(8) == 320 || c.loadU32(8) == 400 || c.loadU32(8) == 500) && c.loadU32(12) <= 7 &&
    c.loadU32(16) > 0 && c.loadU32(16) <= 65535 && (c.loadU32(20)&~c.loadU32(16)) == 0 &&
    c.loadU32(24) <= 2 && c.loadU32(28) <= 1 && c.loadU32(32) <= 0xfffff && c.loadU32(36) <= 1 &&
    c.loadU32(40) <= 255 && c.loadU32(44) <= 3 && c.loadU32(48) != 0 && p4RetentionLinkAddressValid(c.loadU32(48)) &&
    p4SleepProfileConfigValid(nativeBufferAt(c.addressValue()+52,108),300) && p4RetentionSessionConfigValid(nativeBufferAt(c.addressValue()+160,32))
// Build the complete revision300 record from validated child configurations.
// No hardware/heap access. Invalid arguments or aliasing leave output intact.
trusted fun esp32p4SleepRoundConfigEncode(out: NativeBuffer,profile: NativeBuffer,retention: NativeBuffer,cpuMHz: int,mpllMHz: int,flags: int,pins: u32,levels: u32,pull: int,filter: bool,reject: u32,rejectEnabled: bool,minHp: int,protection: int,entry3: int): bool {
    if (!out.hasAddressRange(0,192) || (out.addressValue()&3) != 0 ||
        !p4SleepProfileConfigValid(profile,300) || !p4RetentionSessionConfigValid(retention) ||
        (cpuMHz != 20 && cpuMHz != 40 && cpuMHz != 360 && cpuMHz != 400) ||
        (mpllMHz != 320 && mpllMHz != 400 && mpllMHz != 500) || flags < 0 || flags > 7 ||
        pins == u32(0) || pins > u32(65535) || (levels&~pins) != u32(0) || pull < 0 || pull > 2 ||
        reject > u32(0xfffff) || minHp < 0 || minHp > 255 || protection < 0 || protection > 3 ||
        entry3 == 0 || !p4RetentionLinkAddressValid(entry3) ||
        (out.addressValue() < profile.addressValue()+108 && profile.addressValue() < out.addressValue()+192) ||
        (out.addressValue() < retention.addressValue()+32 && retention.addressValue() < out.addressValue()+192)) return false
    out.storeU32(0,300);out.storeU32(4,cpuMHz);out.storeU32(8,mpllMHz);out.storeU32(12,flags)
    out.storeU32(16,int(pins));out.storeU32(20,int(levels));out.storeU32(24,pull);out.storeU32(28,if (filter) 1 else 0)
    out.storeU32(32,int(reject));out.storeU32(36,if (rejectEnabled) 1 else 0);out.storeU32(40,minHp);out.storeU32(44,protection);out.storeU32(48,entry3)
    var offset=0
    while (offset < 108) { out.storeU32(52+offset,profile.loadU32(offset));offset=offset+4 }
    offset=0
    while (offset < 32) { out.storeU32(160+offset,retention.loadU32(offset));offset=offset+4 }
    return true
}
