import "./sleep_power_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@section(".iram1.abla.c5SleepPowerRead")
@export("c5SleepPowerRead")
trusted fun c5SleepPowerReadHook(offset: int): int = mmioLoadU32(0x600b0000+offset)
@section(".iram1.abla.c5SleepPowerWrite")
@export("c5SleepPowerWrite")
trusted fun c5SleepPowerWriteHook(offset: int,value: int): void { mmioStoreU32(0x600b0000+offset,value);return }
