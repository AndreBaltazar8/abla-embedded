import "./sleep_power_c5_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.c5SleepPowerRead")
trusted fun c5SleepPowerRead(offset: int): int = mmioLoadU32(0x600b0000+offset)
@section(".iram1.abla.c5SleepPowerWrite")
trusted fun c5SleepPowerWrite(offset: int,value: int): void { mmioStoreU32(0x600b0000+offset,value);return }
