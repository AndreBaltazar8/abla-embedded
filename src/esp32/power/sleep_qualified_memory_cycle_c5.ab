import "./sleep_memory_cycle_common_c5.ab"
import "../flash_ready_c5_sequence.ab"
// Alternative composition, not imported with sleep_memory_cycle_composition_c5.
// Context624B: memory request48+transition448, SUS mask496,reserved500,
// actual flash-readiness120@504. All three input/storage buffers disjoint.
// Caller qualifies command05 WIP0, command35 SUS mask and current SDR status
// timings, CS0 flash, no new flash operations, retained code/stack/records and
// all existing sleep/memory/PLL prerequisites. No inferred chip compatibility.
// Result5 means suspended chip: caches STAY OFF, no sleep or memory transition
// or PLL recalibration. Caller must handle suspension with chip-specific code;
// retries keep reporting5 without issuing further status commands. Never free
// the live records or enable cache merely because this is a distinct result.
// Recheck is explicit after the owner handles the chip; it reads statuses again,
// never assumes a RESUME succeeded and never issues RESUME itself.
@section(".iram1.abla.c5QualifiedMemoryRecheck")
trusted fun esp32C5SleepQualifiedMemoryRecheckOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,792) || (record.addressValue()&3) != 0 ||
        c5SleepRecordRead(record,0) != 0x43594331 || c5SleepRecordRead(record,4) != 7) return 2
    val address=c5SleepRecordRead(record,108)
    if (address == 0) return 2
    val context=nativeBufferAt(address,624)
    if (c5SleepRecordRead(context,48) != 0 || c5SleepRecordRead(context,504) != 0x43465231 ||
        c5SleepRecordRead(context,508) != 4) return 2
    // Terminal readiness means both borrowed status-command records were
    // restored. Only that completed observation is released for a fresh read.
    c5SleepRecordWrite(context,504,0)
    esp32C5SleepCycleContinueOwned(record,true)
}
@section(".iram1.abla.c5QualifiedMemoryBegin")
trusted fun esp32C5SleepQualifiedMemoryBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,suspendMask: int,exclusiveQualifiedChip: bool): int {
    if (!exclusiveQualifiedChip || !context.hasAddressRange(0,624) || (context.addressValue()&3) != 0 ||
        !record.hasAddressRange(0,792) || (record.addressValue()&3) != 0 || c5SleepRecordRead(record,0) != 0 ||
        !c5SleepCycleRequestValid(request,true) || suspendMask < 1 || suspendMask > 255) return 2
    val address=context.addressValue();val base=record.addressValue();val input=request.addressValue()
    if ((base < address+624 && address < base+792) || (input < address+624 && address < input+68) ||
        (base < input+68 && input < base+792) || c5SleepRecordRead(context,48) != 0 || c5SleepRecordRead(context,504) != 0) return 2
    c5SleepRecordWrite(context,496,suspendMask)
    c5SleepCycleBeginContextOwned(record,request,true,address)
}
@inline
trusted fun c5SleepCycleEntry(record: NativeBuffer): int {
    val address=c5SleepRecordRead(record,108)
    if (address == 0) return -3
    val context=nativeBufferAt(address,624)
    // Each status command already waits for both controllers; child state
    // tracks an in-flight read across pending returns without replaying it.
    val ready=esp32C5FlashReadyOwned(nativeBufferAt(address+504,120),c5SleepRecordRead(context,496),c5SleepRecordRead(record,80),true)
    if (ready == 3) return -5
    if (ready == 4) return -6
    if (ready != 1) return -3
    val applied=esp32C5MspiTransitionBeginOwned(nativeBufferAt(address+48,448),nativeBufferAt(address,48),true)
    if (applied != 1) return -3
    c5SleepCycleTimedEntry(record)
}
