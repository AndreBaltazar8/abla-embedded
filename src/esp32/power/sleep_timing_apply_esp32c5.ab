import "./sleep_timing_apply_c5_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.c5SleepTimingRead")
trusted fun c5SleepTimingRead(offset: int): int = mmioLoadU32(0x600b0000+offset)
@section(".iram1.abla.c5SleepTimingWrite")
trusted fun c5SleepTimingWrite(offset: int,value: int): void { mmioStoreU32(0x600b0000+offset,value);return }
