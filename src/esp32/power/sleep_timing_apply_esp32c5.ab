import "./sleep_timing_apply_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@section(".iram1.abla.c5SleepTimingRead")
@export("c5SleepTimingRead")
trusted fun c5SleepTimingReadHook(offset: int): int = mmioLoadU32(0x600b0000+offset)
@section(".iram1.abla.c5SleepTimingWrite")
@export("c5SleepTimingWrite")
trusted fun c5SleepTimingWriteHook(offset: int,value: int): void { mmioStoreU32(0x600b0000+offset,value);return }
