// IDF6 S3 rtc_sleep_start/finish, default lslp_mem_inf_fpu=0 preparation.
// Low-level light sleep ONLY. Caller has prepared wake sources, clocks/MSPI,
// analog snapshot, retention and exclusive cores/interrupts, and runs the full
// closure plus stack/data from retained internal memory. No ownership implied.
// Returns -1 invalid configuration, -2 already entering/deep configured,
// 0 wake, 1 sleep rejected. After return caller MUST restore clocks, MSPI,
// analog state and UARTs before releasing quiescence.
// No artificial polling timeout: returning while sleep entry is still pending
// would let the caller resume peripherals during a hardware power transition.
@section(".iram1.abla.s3LightSleepEntry")
trusted fun esp32S3LightSleepEnterOwned(wakeMask: int,rejectMask: int): int {
    if (wakeMask <= 0 || wakeMask > 0x1FFFF || rejectMask < 0 || rejectMask > 0x3FFFF) return -1
    if ((esp32S3SleepEntryRead(0x60008018) & 0x80000000) != 0 ||
        (esp32S3SleepEntryRead(0x60008090) & 0x80000000) != 0) return -2
    esp32S3SleepEntryUpdate(0x6000803C,0xFFFF8000,wakeMask<<15)
    esp32S3SleepEntryUpdate(0x60008068,0x3FFFF000,rejectMask<<12)
    // W1C: never read-modify-write interrupt clear, which could ack others.
    esp32S3SleepEntryWrite(0x6000804C,3)
    esp32S3SleepEntryUpdate(0x60008018,2,2)
    esp32S3SleepEntryUpdate(0x60008018,0x80000000,0x80000000)
    var raw=esp32S3SleepEntryRead(0x60008044)
    while ((raw & 3) == 0) raw=esp32S3SleepEntryRead(0x60008044)
    val rejected=(raw>>>1) & 1
    esp32S3SleepEntryWrite(0x6000804C,3)
    esp32S3SleepEntryUpdate(0x60008020,0xFF8000,0x80000)
    rejected
}
