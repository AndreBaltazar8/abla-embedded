import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "./sleep_analog_fields_p4.ab"
// Remaining bias/DCM fields from P4 pmu_sleep_analog_init. LP_SLEEP bias is
// +0xc8 RW; +0xb0 is the UNUSED LP-active bias/reserve slot. Never access it.
// This includes ACTIVE DCM mode: caller must have a validated supply policy,
// own PMU/analog power globally, exclude transitions and retain recovery code
// in powered memory. This is NOT safe to invoke with guessed voltage values.
// 28B record: magic/state/primary/cleanup + original activeDCM/HPsleep/LPsleep.
trusted fun p4SleepBiasSet(i: int,value: u32): bool {
    val address=p4SleepBiasOffset(i);val mask=p4SleepBiasMask(i)
    p4SleepBiasWrite(address,(p4SleepBiasRead(address)&~mask)|(value&mask))
    return (p4SleepBiasRead(address)&mask) == (value&mask)
}
// HP fields: DCMvset5@18/mode2@23,atten4@26,pdCurrent30,biasSleep31.
// LP fields: atten4@26,pdCurrent30,biasSleep31. Both preserve xpdBias25.
// Active DCM mode follows upstream: deep0 (software controlled), light1.
//1ready2invalid3partial4closed; field-index primary and cleanup retained.
trusted fun esp32p4SleepBiasOpenOwned(r: NativeBuffer,hp: u32,lp: u32,deep: bool,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,28) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 ||
        (hp&~p4SleepBiasMask(1)) != u32(0) || (lp&~p4SleepBiasMask(2)) != u32(0)) return 2
    r.storeU32(0,0x50344231);r.storeU32(4,3);r.storeU32(8,0);r.storeU32(12,0)
    var i=0
    while (i < 3) { r.storeU32(16+i*4,int(p4SleepBiasRead(p4SleepBiasOffset(i))&p4SleepBiasMask(i)));i=i+1 }
    i=0
    while (i < 3) {
        val value=if (i == 0) (if (deep) u32(0) else u32(0x00800000)) else if (i == 1) hp else lp
        if (!p4SleepBiasSet(i,value)) { r.storeU32(8,i+1);return 3 }
        i=i+1
    }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4SleepBiasCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,28) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50344231) return 2
    if (r.loadU32(4) == 4) return 4
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    r.storeU32(4,3)
    var i=2
    while (i >= 0) {
        if (!p4SleepBiasSet(i,u32(r.loadU32(16+i*4)))) { r.storeU32(12,i+1);return 3 }
        i=i-1
    }
    r.storeU32(12,0);r.storeU32(4,4);return 4
}
