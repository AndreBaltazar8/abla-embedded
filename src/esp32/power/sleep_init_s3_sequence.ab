import "./sleep_domains_s3_sequence.ab"

// Default-config rtc_sleep_init port (lslp_mem_inf_fpu=0). No C ABI bitfields.
// Caller owns RTC/analog I2C and has quiesced concurrent radio/ADC/clock users,
// including interrupt/other-core access. NOT a public deepSleep replacement:
// low-init timings, wake/retention, clock switch and entry remain separate.
trusted fun esp32S3SleepInitOwned(policy: Esp32S3SleepPolicy): bool {
    if (!policy.valid()) return false
    esp32S3SleepDomainsPrepareOwned(policy)
    esp32S3SleepBiasWriteOwned(5,policy.rtcBias())
    esp32S3SleepBiasWriteOwned(7,policy.digitalBias())
    val bias=(policy.attenuation()<<18) |
        (if (policy.biasSleep()) 1<<16 else 0) |
        (if (policy.sleepCurrentDown()) 1<<14 else 0) |
        (if (policy.monitorBiasSleep()) 1<<17 else 0) |
        (if (policy.monitorCurrentDown()) 1<<15 else 0)
    // Include monitor attenuation (zero) and preserve wakeup bias fields.
    esp32S3RtcWakeUpdate(0x60008080,0x03FFC000,bias)
    val flags=policy.flags()
    if ((flags & 1) != 0) {
        esp32S3RtcWakeUpdate(0x60008090,1<<31,1<<31)
        esp32S3RtcWakeUpdate(0x60008034,0xD8000000,0)
        esp32S3RtcWakeUpdate(0x60008000,128,0)
    } else {
        esp32S3RtcWakeUpdate(0x6000808C,0xFF000,0xF000)
        esp32S3RtcWakeUpdate(0x60008090,1<<31,0)
    }
    esp32S3RtcWakeUpdate(0x60008090,16,16)
    esp32S3RtcWakeUpdate(0x60008088,256,256)
    esp32S3RtcWakeUpdate(0x60008088,2048,2048)
    esp32S3RtcWakeUpdate(0x60008084,1<<31,if (policy.regulatorForced()) 1<<31 else 0)
    esp32S3RtcWakeUpdate(0x60008074,1<<26,if ((flags & 1024) == 0) 1<<26 else 0)
    esp32S3RtcWakeUpdate(0x6000807C,1<<22,0)
    esp32S3RtcWakeUpdate(0x6000807C,1<<21,if ((flags & 32) != 0) 1<<21 else 0)
    esp32S3RtcWakeUpdate(0x60008068,0xC0000000,0xC0000000)
    esp32S3RtcWakeUpdate(0x60008020,0xFF8000,0x7F8000)
    esp32S3RtcWakeUpdate(0x60008000,8192,if ((flags & 2048) == 0) 8192 else 0)
    esp32S3RtcWakeUpdate(0x60008074,1<<28,if ((flags & 2048) == 0) 1<<28 else 0)
    true
}
