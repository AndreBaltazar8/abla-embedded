import "./sleep_power_defaults_p4.ab"
import "./sleep_analog_defaults_p4.ab"
import "./sleep_timing_logic_p4.ab"
// Complete108B configuration for esp32p4SleepProfileOpenOwned. No hardware
// access, heap allocation or temporary buffer. Caller exclusively owns output.
// Explicit chip revision, PSRAM presence, configured sleep voltage, measured
// active bias codes and slow/fast clock periods. This is configuration, not
// validation that powering down a domain preserves the running application.
// No partial output on invalid inputs: validate ALL components before writing.
trusted fun esp32p4SleepProfileDefaults(output: NativeBuffer,flags: u32,revision: int,deep: bool,psram: bool,
    sleepDcmVset: int,activeHpDbias: int,activeLpDbias: int,slowPeriodQ19: int,fastPeriodQ19: int): bool {
    if (!output.hasAddressRange(0,108) || (output.addressValue()&3) != 0 || revision < 0 || revision > 399 ||
        (flags&~u32(0x5600ffd3)) != u32(0) || (revision < 300 && (flags&u32(16)) != u32(0)) ||
        (!deep && (flags&u32(0x04000000)) != u32(0)) || sleepDcmVset < 0 || sleepDcmVset > 31 ||
        activeHpDbias < 0 || activeHpDbias > 31 || activeLpDbias < 0 || activeLpDbias > 31 ||
        slowPeriodQ19 <= 0 || slowPeriodQ19 > 0xffffffff || fastPeriodQ19 <= 0 || fastPeriodQ19 > 0xffffffff) return false
    val topDown=(flags&u32(1)) != u32(0)
    // XTAL-as-fast keeps HP XTAL powered even when its ordinary PD flag is set.
    val hpXtal=(flags&u32(0x400)) == u32(0) || (flags&u32(0x40000000)) != u32(0)
    var i=0
    while (i < 10) {
        val cycles=p4SleepTimingCalibratedValue(i,slowPeriodQ19,fastPeriodQ19,topDown,hpXtal)
        if (cycles < 0 || cycles > p4SleepProfileTimingLimit(i)) return false
        i=i+1
    }
    // All three calls are now guaranteed valid for these checked subspans.
    val power=esp32p4SleepPowerDefaults(nativeBufferAt(output.addressValue(),32),flags&u32(0x4400ffd1),revision,deep)
    val analog=esp32p4SleepAnalogDefaults(nativeBufferAt(output.addressValue()+32,32),flags&u32(0x52000402),revision,deep,psram,
        sleepDcmVset,activeHpDbias,activeLpDbias)
    val timing=esp32p4SleepTimingCalibrated(nativeBufferAt(output.addressValue()+64,40),slowPeriodQ19,fastPeriodQ19,topDown,hpXtal)
    output.storeU32(104,esp32p4SleepDigitalDefaults(flags,revision))
    return power && analog && timing
}
