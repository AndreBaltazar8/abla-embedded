import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSleepEventOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspSleepExecuteEventCallbacks", "esp_sleep_execute_event_callbacks")) return false
    true
}
