import "./sleep_round_p4_sequence.ab"
import "./sleep_coordinator_request_esp32p4.ab"
import "./sleep_coordinator_recovery_esp32p4.ab"
import "./sleep_round_finish_p4_sequence.ab"
trusted fun p4RoundFinish(r: NativeBuffer): int = esp32p4SleepRoundFinishOwned(r,true)
import "./sleep_round_config_p4.ab"
trusted fun p4RoundStage(r: NativeBuffer,step: int,polls: int,eventPolls: int,sourcesReady: bool,otherPolicyReady: bool): int {
    val c=nativeBufferAt(r.loadU32(16),192);val base=r.addressValue()
    val policy=nativeBufferAt(base+64,388);val clocks=nativeBufferAt(base+464,288)
    val session=nativeBufferAt(base+752,464);val cpu=nativeBufferAt(base+1216,816)
    val route=nativeBufferAt(base+2032,24);val request=nativeBufferAt(base+2056,48)
    val recovery=nativeBufferAt(base+2104,64);val smp=nativeBufferAt(r.loadU32(36),4);val generation=r.loadU32(40)
    if (step == 1) return if (route.loadU32(0) == 0) esp32p4SleepWakeRouteOpenOwned(route,esp32p4SleepCoreWakeAddress(),true) else esp32p4SleepWakeRouteContinueOwned(route,true)
    if (step == 2) return esp32p4SleepPolicySessionOpenOwned(policy,nativeBufferAt(c.addressValue()+52,108),300,u32(c.loadU32(16)),u32(c.loadU32(20)),c.loadU32(24),c.loadU32(28) != 0,u32(c.loadU32(32)),c.loadU32(36) != 0,c.loadU32(40),c.loadU32(44),true)
    if (step == 3) return if (clocks.loadU32(0) == 0) esp32p4SleepClocksOpenOwned(clocks,c.loadU32(4),300,c.loadU32(8),(c.loadU32(12)&1) != 0,(c.loadU32(12)&2) != 0,polls,true) else esp32p4SleepClocksContinueOwned(clocks,polls,true)
    if (step == 4) return if (session.loadU32(0) == 0) esp32p4SleepSessionPublishOwned(session,nativeBufferAt(c.addressValue()+160,32),c.loadU32(48),nativeBufferAt(r.loadU32(20),r.loadU32(24)),nativeBufferAt(r.loadU32(28),r.loadU32(32)),300,c.loadU32(8),(c.loadU32(12)&4) != 0,polls,true) else esp32p4SleepSessionPublishContinueOwned(session,polls,true)
    if (step == 5) return esp32p4CpuRetainedOpenOwned(cpu,300,true)
    if (step == 6) return esp32p4SleepCoordinatorRequestPrepareOwned(request,cpu,clocks,session,smp,generation,true)
    if (step == 7) return esp32p4SleepCoordinatorRequestInvokeOwned(request,true)
    if (step == 8) return if (r.loadU32(48) != 0) esp32p4SleepCoordinatorAbortOpenOwned(recovery,session,clocks,cpu,smp,route,generation,true) else esp32p4SleepCoordinatorRecoveryOpenOwned(recovery,session,clocks,cpu,smp,route,generation,true)
    if (step == 9) return if (policy.loadU32(0) == 0) 7 else esp32p4SleepCoordinatorBindPolicyOwned(recovery,policy,true)
    if (step == 10) return esp32p4SleepCoordinatorRecoveryContinueOwned(recovery,polls,eventPolls,sourcesReady,otherPolicyReady,true)
    return 4
}
