import "../sdk/raw_buffer.ab"
import "abla/unsafe/mmio"
// Local aligned record access is used only after complete range admission.
// Keep these helpers in IRAM without changing shared NativeBuffer code.
@section(".iram1.abla.c5PvtRecordRead")
trusted fun c5PvtRecordRead(base: int,offset: int): int = mmioLoadU32(base+offset)
@section(".iram1.abla.c5PvtRecordWrite")
trusted fun c5PvtRecordWrite(base: int,offset: int,value: int): void { mmioStoreU32(base+offset,value);return }
// C5 rtc_clk_cpu_freq_set_xtal_for_sleep: charge pump off, then
// pvt_func_enable(false). Copies live PVT HP/LP bias before handing control
// to PMU; never substitutes nominal/calibrated defaults for live voltage.
//24B:tag0,status4,HP8,LP12,next stage16,reserved20.
//1parked2invalid3partial. Retry same record after failure; captured bias is
// retained. Terminal1 is idempotent; new lifecycle requires explicit fresh
// record AFTER separately reinitializing/enabling PVT. This is not rollback.
// Caller excludes eFuse reload/PVT/PMU/PCR writers and executes retained code,
// stack/data; CPU must already be on stable XTAL. Active PVT only: upstream
// config-disabled/unsupported cases must not call this operation.
@section(".iram1.abla.c5PvtParkField")
trusted fun c5PvtParkField(address: int,mask: int,value: int): bool {
    c5PvtParkWrite(address,(c5PvtParkRead(address)&~mask)|(value&mask))
    (c5PvtParkRead(address)&mask) == (value&mask)
}
@section(".iram1.abla.c5PvtPark")
trusted fun esp32C5PvtParkOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,24) || (record.addressValue()&3) != 0) return 2
    if (c5PvtRecordRead(record.addressValue(),0) == 0x43505631 && c5PvtRecordRead(record.addressValue(),4) == 1) return 1
    if ((c5PvtParkRead(0x60096144)&1) != 0 || (c5PvtParkRead(0x60096110)&0x30000) != 0) return 2
    if (c5PvtRecordRead(record.addressValue(),0) != 0x43505631) {
        val revision=c5PvtParkRead(0x600b484c)
        val block=((revision>>11)&3)*100+((revision>>8)&7)
        if (block < 2 || (c5PvtParkRead(0x600960b8)&3) != 1 ||
            (c5PvtParkRead(0x600960bc)&0x400000) == 0) return 2
        if ((c5PvtParkRead(0x60019064)&0x80000000) == 0 || (c5PvtParkRead(0x600b0028)&0x4000) != 0) return 2
        c5PvtRecordWrite(record.addressValue(),0,0x43505631);c5PvtRecordWrite(record.addressValue(),4,3);c5PvtRecordWrite(record.addressValue(),8,0);c5PvtRecordWrite(record.addressValue(),12,0);c5PvtRecordWrite(record.addressValue(),16,0);c5PvtRecordWrite(record.addressValue(),20,0)
    }
    if (c5PvtRecordRead(record.addressValue(),4) != 3 || c5PvtRecordRead(record.addressValue(),16) > 7) return 2
    val stage=c5PvtRecordRead(record.addressValue(),16)
    // Ordered fall-through avoids a flash-resident switch/jump table.
    if (stage <= 0) {
        if (!c5PvtParkField(0x60019028,512,0)) return 3
        c5PvtRecordWrite(record.addressValue(),16,1)
    }
    if (stage <= 1) {
        val live=c5PvtParkRead(0x600b0028)
        c5PvtRecordWrite(record.addressValue(),8,(live>>9)&31);c5PvtRecordWrite(record.addressValue(),12,(live>>4)&31)
        c5PvtRecordWrite(record.addressValue(),16,2)
    }
    if (stage <= 2) {
        if (!c5PvtParkField(0x600b0028,0xf8000000,c5PvtRecordRead(record.addressValue(),8)<<27)) return 3
        c5PvtRecordWrite(record.addressValue(),16,3)
    }
    if (stage <= 3) {
        if (!c5PvtParkField(0x600b009c,0xf8000000,c5PvtRecordRead(record.addressValue(),12)<<27)) return 3
        c5PvtRecordWrite(record.addressValue(),16,4)
    }
    if (stage <= 4) {
        if (!c5PvtParkField(0x60019064,0x80000000,0)) return 3
        c5PvtRecordWrite(record.addressValue(),16,5)
    }
    if (stage <= 5) {
        if (!c5PvtParkField(0x600b0028,0x4000,0x4000)) return 3
        c5PvtRecordWrite(record.addressValue(),16,6)
    }
    if (stage <= 6) {
        if (!c5PvtParkField(0x600960b8,1,0)) return 3
        c5PvtRecordWrite(record.addressValue(),16,7)
    }
    if (!c5PvtParkField(0x600960bc,0x400000,0)) return 3
    c5PvtRecordWrite(record.addressValue(),16,8)
    c5PvtRecordWrite(record.addressValue(),4,1)
    1
}
