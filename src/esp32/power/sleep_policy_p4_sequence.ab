import "abla/runtime/scalar"
// Exclusive PMU configuration lease, with sleep entry excluded throughout.
// Not a complete power/retention profile and never writes SLEEP_REQ.
// Snapshot reject32@8, HP minimum/protect10@40, owned50. LP minimum preserved.
type P4SleepPolicy=int
fun P4SleepPolicy.status(): int = this&255
fun P4SleepPolicy.hasSnapshot(): bool = (this&(1<<50)) != 0
trusted fun p4SleepPolicyField(offset: int,mask: u32,value: u32): bool {
    p4SleepPolicyWrite(offset,(p4SleepPolicyRead(offset)&~mask)|(value&mask))
    return (p4SleepPolicyRead(offset)&mask) == (value&mask)
}
// Change timing only while reject checking disabled; restore enable last.
trusted fun p4SleepPolicyApply(reject: u32,timing: u32): bool {
    if (!p4SleepPolicyField(292,u32(0x80000000),u32(0)) ||
        !p4SleepPolicyField(300,u32(0x3ff00),timing<<u32(8)) ||
        !p4SleepPolicyField(292,u32(0xffffffff),reject)) return false
    return true
}
//1ready2invalid3partialwrite4closed. Protect0 HP,1 XTAL,2 HP+LP,3 disabled.
trusted fun esp32p4SleepPolicyOpenOwned(rejectMask: u32,rejectEnabled: bool,minHpCycles: int,
    protection: int,exclusive: bool): P4SleepPolicy {
    if (!exclusive || rejectMask > u32(0xfffff) || minHpCycles < 0 || minHpCycles > 255 ||
        protection < 0 || protection > 3) return P4SleepPolicy(2)
    val token=(1<<50)|(int(p4SleepPolicyRead(292))<<8)|
        (int((p4SleepPolicyRead(300)>>u32(8))&u32(1023))<<40)
    val reject=rejectMask|(if (rejectEnabled) u32(0x80000000) else u32(0))
    return P4SleepPolicy(token|(if (p4SleepPolicyApply(reject,u32(minHpCycles|(protection<<8)))) 1 else 3))
}
trusted fun P4SleepPolicy.closeOwned(exclusive: bool): P4SleepPolicy {
    if (!exclusive || !this.hasSnapshot() || this.status() == 4) return this
    return P4SleepPolicy((this&(~255))|(if (p4SleepPolicyApply(u32((this>>>8)&0xffffffff),u32((this>>>40)&1023))) 4 else 3))
}
trusted fun esp32p4SleepWakeCause(): u32 = p4SleepPolicyRead(324)&u32(0x7fffffff)
trusted fun esp32p4SleepRejectCause(): u32 = p4SleepPolicyRead(328)&u32(0x7fffffff)
// bit0 rejected, bit1 woke. Both may be pending; do not impose precedence.
trusted fun esp32p4SleepEvents(): int = int(p4SleepPolicyRead(356)>>u32(30))
// Explicit irreversible acknowledgments. Exact WT writes preserve other IRQs.
trusted fun esp32p4SleepAcknowledgeOwned(events: int,clearRejectCause: bool,exclusive: bool): bool {
    if (!exclusive || events < 0 || events > 3) return false
    if (events != 0) p4SleepPolicyWrite(368,u32(events)<<u32(30))
    if (clearRejectCause) p4SleepPolicyWrite(304,u32(0x80000000))
    return true
}
