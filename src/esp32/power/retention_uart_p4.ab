import "./retention_descriptor_p4.ab"
// P4 HP UART0..4: retain22 selected configuration words, then restore-only
// REG_UPDATE and wait for completion. Entry0; console uses priority5.
// Matches esp_hal_uart/esp32p4/uart_periph.c, not LP UART or FIFO contents.
// Caller drains/quiesces UART, owns clocks and retained memory, and assembles
// using the P4 WAIT workaround before publishing; this only builds configs.
trusted fun esp32p4RetentionUartConfig(c: NativeBuffer,uart: int,node: int,storage: int,next: int): bool {
    if (uart < 0 || uart > 4 || node < 0 || node > 2 || !c.hasAddressRange(0,56) ||
        (c.addressValue()&3) != 0 || (next != 0 && !p4RetentionAddressSpan(next,4))) return false
    if (node == 0) {
        if (!p4RetentionAddressSpan(storage,88) || (storage < c.addressValue()+56 && c.addressValue() < storage+88)) return false
    } else if (storage != 0) return false
    if (next != 0 && next < c.addressValue()+56 && c.addressValue() < next+4) return false
    var i=4
    while (i < 56) { c.storeU32(i,0);i=i+4 }
    val base=0x500ca000+uart*0x1000
    var head=if (next == 0) 0x80000000 else 0
    c.storeU32(4,next)
    if (node == 0) {
        head=head|0x10016
        c.storeU32(20,base+12);c.storeU32(24,base+12);c.storeU32(28,storage)
        c.storeU32(32,0x807fff6d);c.storeU32(36,16)
    } else {
        head=head|0x40000000|((node+1)<<16)
        c.storeU32(20,base+0x98);c.storeU32(48,if (node == 1) 1 else 0);c.storeU32(52,1)
    }
    c.storeU32(0,head);return true
}
