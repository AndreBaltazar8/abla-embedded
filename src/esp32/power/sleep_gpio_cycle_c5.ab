import "./sleep_cycle_common_c5.ab"
import "../gpio/wake_session_c5_sequence.ab"
// Alternative timed-sleep composition with HP digital GPIO wake. Retained
// cycle792B plus disjoint context36B: wake session32, immutable pin/high@32.
// Context and caller's stack stay retained through cache-off pending calls.
// Own HP GPIO/pad/PMU wake sources and usual plain-cycle MSPI prerequisites.
// Does not replace the separately qualified memory-transition composition.
// Inactive input can return3pending while caches are OFF, before any sleep
// request. Continue rechecks the source. Pin/global settings close only after
// real clock/cache/UART/time recovery; pending close never repeats sleep.
@section(".iram1.abla.c5SleepGpioBegin")
trusted fun esp32C5SleepGpioBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,pin: int,high: bool,exclusive: bool): int {
    if (!exclusive || pin < 0 || pin > 28 || !context.hasAddressRange(0,36) ||
        (context.addressValue()&3) != 0 || c5SleepRecordRead(context,0) != 0 ||
        !record.hasAddressRange(0,792) || (record.addressValue()&3) != 0 || c5SleepRecordRead(record,0) != 0 ||
        !c5SleepCycleRequestValid(request,true) || (request.loadU32(60)&4) == 0) return 2
    val address=context.addressValue();val base=record.addressValue();val input=request.addressValue()
    if ((base < address+36 && address < base+792) || (input < address+36 && address < input+68) ||
        (base < input+68 && input < base+792)) return 2
    c5SleepRecordWrite(context,32,pin|(if (high) 64 else 0))
    c5SleepCycleBeginContextOwned(record,request,true,address)
}
@inline
trusted fun c5SleepCyclePrepare(record: NativeBuffer): int = c5SleepCyclePrepareBase(record)
@inline
trusted fun c5SleepCycleEntry(record: NativeBuffer): int {
    val address=c5SleepRecordRead(record,108)
    if (address == 0) return -3
    if (!c5SleepCycleDeadlineReady(record)) return -3
    val context=nativeBufferAt(address,36);val session=nativeBufferAt(address,32)
    val plan=c5SleepRecordRead(context,32)
    val ready=if (c5SleepRecordRead(session,0) == 0)
        esp32C5GpioWakeSessionOpenOwned(session,plan&63,(plan&64) != 0,true)
        else esp32C5GpioWakeSessionArmOwned(session,true)
    if (ready == 5) return -5
    if (ready != 1) return -3
    c5SleepCycleTimedEntry(record)
}
@inline
trusted fun c5SleepCycleRecovery(record: NativeBuffer): int {
    val base=record.addressValue();val recovery=nativeBufferAt(base+664,128)
    val entry=if (c5SleepRecordRead(record,632) != 0) base+632 else 0
    val result=if (c5SleepRecordRead(record,664) != 0) esp32C5SleepRecoveryContinueOwned(recovery,true)
        else esp32C5SleepRecoveryBeginOwned(recovery,nativeBufferAt(base+304,304),base+608,C5CpuClock(c5SleepRecordRead(record,204)),
            (c5SleepRecordRead(record,72)&8) != 0,int(i32(c5SleepRecordRead(record,12))),false,0,
            c5SleepRecordRead(record,28)|(c5SleepRecordRead(record,32)<<32),c5SleepRecordRead(record,148),true,entry,base+152)
    if (result != 1) return result
    val address=c5SleepRecordRead(record,108)
    if (address == 0) return 2
    val session=nativeBufferAt(address,32)
    if (c5SleepRecordRead(session,0) == 0) return 1
    if (esp32C5GpioWakeSessionCloseOwned(session,true) != 4) return 3
    return 1
}
