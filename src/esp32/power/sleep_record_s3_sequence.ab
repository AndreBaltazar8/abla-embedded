import "../sdk/raw_buffer.ab"
// Extends the104byte preparation record. Low stage byte:3prepared,8entering,
// 4resuming,6completed,7manual recovery. Byte1 saves signed entry status.
// Caller retains ownership/quiescence until resume.complete(); a return from
// Enter alone is NOT permission to resume clients or discard the record.
@section(".iram1.abla.s3SleepRecordEnter")
trusted fun esp32S3SleepRecordEnterOwned(record: NativeBuffer,wake: int,reject: int): int {
    if (!record.hasAddressRange(0,104) || (record.addressValue() & 3) != 0) return -3
    val base=record.addressValue()
    if (esp32S3MspiStateRead(base) != 0x53504C50 || esp32S3MspiStateRead(base+4) != 3) return -3
    // Publish entering before hardware access; never allow repeated entry if
    // ownership is lost or execution is interrupted during the transition.
    esp32S3MspiStateWrite(base+4,8)
    val result=esp32S3LightSleepSuspendedOwned(wake,reject)
    esp32S3MspiStateWrite(base+4,4 | ((result & 255)<<8))
    result
}
// Can also cancel a prepared cycle before entry. Progress is persisted before
// reporting any failure; success clears magic LAST, permitting record reuse.
@section(".iram1.abla.s3SleepRecordResume")
trusted fun esp32S3SleepRecordResumeOwned(record: NativeBuffer,polls: int): Esp32S3SleepResume {
    if (!record.hasAddressRange(0,104) || (record.addressValue() & 3) != 0) return esp32S3SleepResumeResult(0,5,0,0)
    val base=record.addressValue()
    if (esp32S3MspiStateRead(base) != 0x53504C50) return esp32S3SleepResumeResult(0,5,0,0)
    val state=esp32S3MspiStateRead(base+4)
    val stage=state & 255
    val progress=Esp32S3SleepResume(esp32S3MspiStateLoad64(base+40))
    if (!progress.valid()) return esp32S3SleepResumeResult(0,5,0,0)
    if (stage == 7) return esp32S3SleepResumeResult(progress.phase(),4,progress.apbHertz(),progress.detail())
    if (stage != 3 && stage != 4) return esp32S3SleepResumeResult(0,5,0,0)
    val result=esp32S3SleepResumeOwned(progress,
        Esp32S3ClockState(esp32S3MspiStateLoad64(base+8)),
        Esp32S3ClockBias(esp32S3MspiStateLoad64(base+32)),
        Esp32S3AnalogSleepState(esp32S3MspiStateLoad64(base+16)),
        nativeBufferAt(base+48,56),Esp32S3SleepUarts(esp32S3MspiStateLoad64(base+24)),polls)
    esp32S3MspiStateStore64(base+40,result | 0)
    esp32S3MspiStateWrite(base+4,(state & 0xFF00) | (if (result.complete()) 6 else if (result.status() == 4) 7 else 4))
    if (result.complete()) esp32S3MspiStateWrite(base,0)
    result
}
