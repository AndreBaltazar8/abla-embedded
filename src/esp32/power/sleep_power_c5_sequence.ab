import "./sleep_record_c5.ab"
import "../sdk/raw_buffer.ab"
// C5 IDF6 PMU_SLEEP_POWER_CONFIG_DEFAULT. Power-down policy bits:
//0VDD_SPI,1modem,2CPU,3HP_AON,4TOP,5XTAL,6LP peripheral,7XTAL32K,
//8RC32K,9RC_FAST. This is NOT a sleep-ready certificate: caller supplies
// retention/clock/wake requirements and owns all affected domains. HP memory
// remains powered; no memory-bank/analog/regulator/force overrides here.
type C5SleepPower=int
fun C5SleepPower.valid(): bool = this >= 0 && this <= 1023
@section(".iram1.abla.c5SleepPowerOffset")
fun c5SleepPowerOffset(index: int): int = if (index == 0) 0x68 else if (index == 1) 0x7c else if (index == 2) 0x98 else
    if (index == 3) 0xa8 else if (index == 4) 0xac else if (index == 5) 0xc0 else if (index == 6) 0xc4 else 0xbc
@section(".iram1.abla.c5SleepPowerMask")
fun c5SleepPowerMask(index: int): int = if (index == 0) 0xffe00000 else if (index == 1) 0x7c000000 else
    if (index == 2 || index == 7) 0x80000000 else if (index == 3 || index == 5) 0xc0000000 else 0xf0000000
fun C5SleepPower.registerValue(index: int): int {
    if (!this.valid() || index < 0 || index > 7) return -1
    if (index == 0) return ((this&1)<<21)|((this&2)<<26)|((this&4)<<27)|((this&8)<<27)|((this&16)<<27)
    if (index == 1) return 0x0c000000
    if (index == 2 || index == 7) return if ((this&32) == 0) 0x80000000 else 0
    if (index == 3) return 0
    if (index == 5) return (this&64)<<25
    return (if ((this&128) == 0) 0x10000000 else 0)|(if ((this&256) == 0) 0x20000000 else 0)|
        (if (index == 4 || (this&512) == 0) 0x40000000 else 0)
}
//48B record:tag0,status4,original8words@8,reverse close index40,policy44.
//1configured2invalid3partial failure4closed. Config registers only; never
// requests sleep or drives a rail directly. Quiesce/exclude sleep entry and
// other PMU writers before begin, and retain ownership through recovery.
@section(".iram1.abla.esp32C5SleepPowerStatus")
trusted fun esp32C5SleepPowerStatus(record: NativeBuffer): int = if (!record.hasAddressRange(0,48) || c5SleepRecordRead(record,0) != 0x43505731) 2 else c5SleepRecordRead(record,4)
@section(".iram1.abla.c5SleepPowerField")
@inline
trusted fun c5SleepPowerField(index: int,value: int): bool {
    val offset=c5SleepPowerOffset(index);val mask=c5SleepPowerMask(index)
    c5SleepPowerWrite(offset,(c5SleepPowerRead(offset)&~mask)|(value&mask))
    (c5SleepPowerRead(offset)&mask) == (value&mask)
}
trusted fun esp32C5SleepPowerApplyOwned(record: NativeBuffer,policy: C5SleepPower,exclusive: bool,hpKeepXtal: bool = false): int {
    if (!exclusive || !policy.valid() || !record.hasAddressRange(0,48)) return 2
    if (c5SleepRecordRead(record,0) == 0x43505731 && c5SleepRecordRead(record,4) != 4) return 2
    c5SleepRecordWrite(record,0,0x43505731);c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,40,7);c5SleepRecordWrite(record,44,policy|0)
    var i=0;while (i < 8) { c5SleepRecordWrite(record,8+i*4,c5SleepPowerRead(c5SleepPowerOffset(i)));i=i+1 }
    // RTC_FAST sourced from XTAL overrides HP_SLEEP only, not LP_SLEEP.
    i=0;while (i < 8) { if (!c5SleepPowerField(i,if (i == 2 && hpKeepXtal) 0x80000000 else policy.registerValue(i))) return 3;i=i+1 }
    c5SleepRecordWrite(record,4,1)
    1
}
@section(".iram1.abla.esp32C5SleepPowerCloseOwned")
trusted fun esp32C5SleepPowerCloseOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive) return 2
    val status=esp32C5SleepPowerStatus(record)
    if (status == 2 || status == 4) return status
    var index=c5SleepRecordRead(record,40)
    if (index > 7) return 2
    // Fixed reverse stages keep offset/mask selection constant: no flash jump tables.
    if (index >= 7) {
        if (!c5SleepPowerField(7,c5SleepRecordRead(record,36))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,6)
    }
    if (index >= 6) {
        if (!c5SleepPowerField(6,c5SleepRecordRead(record,32))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,5)
    }
    if (index >= 5) {
        if (!c5SleepPowerField(5,c5SleepRecordRead(record,28))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,4)
    }
    if (index >= 4) {
        if (!c5SleepPowerField(4,c5SleepRecordRead(record,24))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,3)
    }
    if (index >= 3) {
        if (!c5SleepPowerField(3,c5SleepRecordRead(record,20))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,2)
    }
    if (index >= 2) {
        if (!c5SleepPowerField(2,c5SleepRecordRead(record,16))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,1)
    }
    if (index >= 1) {
        if (!c5SleepPowerField(1,c5SleepRecordRead(record,12))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,0)
    }
    if (index >= 0) {
        if (!c5SleepPowerField(0,c5SleepRecordRead(record,8))) { c5SleepRecordWrite(record,4,3);return 3 }
    }
    c5SleepRecordWrite(record,4,4)
    4
}
