import "./sleep_l2_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4SleepL2Read(offset: int): u32 = u32(mmioLoadU32(0x3ff10000+offset))
trusted fun p4SleepL2Write(offset: int,value: u32): void { mmioStoreU32(0x3ff10000+offset,int(value));return }
trusted fun p4SleepL2FlashRead(): u32 = u32(mmioLoadU32(0x5008c03c))
trusted fun p4SleepL2FlashWrite(value: u32): void { mmioStoreU32(0x5008c03c,int(value));return }
trusted noescape extern:"inline-assembly" fun p4SleepL2Asm(template: string,constraints: string): void
trusted fun p4SleepL2Fence(): void { p4SleepL2Asm("fence iorw, iorw","~{memory}");return }
