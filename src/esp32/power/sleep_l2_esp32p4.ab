import "./sleep_l2_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepL2Read")
trusted fun p4SleepL2ReadHook(offset: int): u32 = u32(mmioLoadU32(0x3ff10000+offset))
@export("p4SleepL2Write")
trusted fun p4SleepL2WriteHook(offset: int,value: u32): void { mmioStoreU32(0x3ff10000+offset,int(value));return }
@export("p4SleepL2FlashRead")
trusted fun p4SleepL2FlashReadHook(): u32 = u32(mmioLoadU32(0x5008c03c))
@export("p4SleepL2FlashWrite")
trusted fun p4SleepL2FlashWriteHook(value: u32): void { mmioStoreU32(0x5008c03c,int(value));return }
trusted noescape extern:"inline-assembly" fun p4SleepL2Asm(template: string,constraints: string): void
@export("p4SleepL2Fence")
trusted fun p4SleepL2FenceHook(): void { p4SleepL2Asm("fence iorw, iorw","~{memory}");return }
