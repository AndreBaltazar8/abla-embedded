import "./sleep_coordinator_recovery_p4_sequence.ab"
import "./sleep_session_esp32p4.ab"
import "./sleep_clocks_esp32p4.ab"
import "./sleep_cpu_retained_esp32p4.ab"
import "./sleep_peer_esp32p4.ab"
import "./sleep_wake_route_esp32p4.ab"
import "./sleep_policy_session_esp32p4.ab"
trusted fun p4CoordinatorPolicyClose(policy: NativeBuffer): int = esp32p4SleepPolicySessionCloseOwned(policy,true)
trusted fun p4CoordinatorPeer(cpu: NativeBuffer,smp: NativeBuffer,generation: int): int =
    esp32p4SleepPeerResumeOwned(esp32p4CpuRetainedCore(cpu),smp,generation,true)
trusted fun p4CoordinatorSession(session: NativeBuffer,polls: int,eventPolls: int): int =
    esp32p4SleepSessionContinueOwned(session,polls,eventPolls,true)
trusted fun p4CoordinatorSessionAbort(session: NativeBuffer,polls: int,eventPolls: int): int =
    if (session.loadU32(4) < 3) esp32p4SleepSessionAbortBeforeCycleOwned(session,polls,eventPolls,true)
    else esp32p4SleepSessionContinueOwned(session,polls,eventPolls,true)
trusted fun p4CoordinatorClocks(clocks: NativeBuffer,polls: int): int =
    esp32p4SleepClocksRestoreOwned(clocks,polls,true,true)
trusted fun p4CoordinatorCpu(cpu: NativeBuffer): int = esp32p4CpuRetainedCloseOwned(cpu,true)
trusted fun p4CoordinatorRoute(route: NativeBuffer): int = esp32p4SleepWakeRouteCloseOwned(route,true)
