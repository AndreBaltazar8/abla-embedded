import "./sleep_coordinator_recovery_p4_sequence.ab"
import "./sleep_session_esp32p4.ab"
import "./sleep_clocks_esp32p4.ab"
import "./sleep_cpu_retained_esp32p4.ab"
import "./sleep_peer_esp32p4.ab"
import "./sleep_wake_route_esp32p4.ab"
import "./sleep_policy_session_esp32p4.ab"
import "../../hal/esp32_power.ab"
@export("p4CoordinatorPolicyClose")
trusted fun p4CoordinatorPolicyCloseHook(policy: NativeBuffer): int = esp32p4SleepPolicySessionCloseOwned(policy,true)
@export("p4CoordinatorPeer")
trusted fun p4CoordinatorPeerHook(cpu: NativeBuffer,smp: NativeBuffer,generation: int): int =
    esp32p4SleepPeerResumeOwned(esp32p4CpuRetainedCore(cpu),smp,generation,true)
@export("p4CoordinatorSession")
trusted fun p4CoordinatorSessionHook(session: NativeBuffer,polls: int,eventPolls: int): int =
    esp32p4SleepSessionContinueOwned(session,polls,eventPolls,true)
@export("p4CoordinatorSessionAbort")
trusted fun p4CoordinatorSessionAbortHook(session: NativeBuffer,polls: int,eventPolls: int): int =
    if (session.loadU32(4) < 3) esp32p4SleepSessionAbortBeforeCycleOwned(session,polls,eventPolls,true)
    else esp32p4SleepSessionContinueOwned(session,polls,eventPolls,true)
@export("p4CoordinatorClocks")
trusted fun p4CoordinatorClocksHook(clocks: NativeBuffer,polls: int): int =
    esp32p4SleepClocksRestoreOwned(clocks,polls,true,true)
@export("p4CoordinatorCpu")
trusted fun p4CoordinatorCpuHook(cpu: NativeBuffer): int = esp32p4CpuRetainedCloseOwned(cpu,true)
@export("p4CoordinatorRoute")
trusted fun p4CoordinatorRouteHook(route: NativeBuffer): int = esp32p4SleepWakeRouteCloseOwned(route,true)
