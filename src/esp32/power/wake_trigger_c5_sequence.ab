// C5 PMU_SLP_WAKEUP_CNTL2 at600b012c, EXT1 enable bit1 (not P4 bit12).
// Own EXT1 and serialize shared PMU RMW; exclude sleep entry/other writers.
// Only bit1 is borrowed. Other timer/GPIO/radio wake enables stay unchanged.
// Status1armed2invalid3writefailure4closed5parked, original bit@8,owned9.
type C5Ext1Trigger=int
fun C5Ext1Trigger.status(): int = this&255
fun C5Ext1Trigger.hasSnapshot(): bool = (this&512) != 0
trusted fun c5Ext1TriggerSet(enabled: bool): bool {
    val before=c5WakeTriggerRead()
    val next=(before&4294967293)|(if (enabled) 2 else 0)
    c5WakeTriggerWrite(next)
    return c5WakeTriggerRead() == next
}
trusted fun esp32C5Ext1TriggerParkOwned(exclusive: bool): C5Ext1Trigger {
    if (!exclusive) return C5Ext1Trigger(2)
    val token=512|((c5WakeTriggerRead()&2)<<7)
    C5Ext1Trigger(token|(if (c5Ext1TriggerSet(false)) 5 else 3))
}
trusted fun C5Ext1Trigger.parkOwned(exclusive: bool): C5Ext1Trigger {
    if (!exclusive || !this.hasSnapshot() || this.status() == 4) return this
    C5Ext1Trigger((this&~255)|(if (c5Ext1TriggerSet(false)) 5 else 3))
}
// sourceReady certifies pad routing/holds and EXT1 polarity/selection, plus
// fresh physical inactive-level verification. Bus ACK alone is insufficient.
trusted fun C5Ext1Trigger.armOwned(sourceReady: bool,exclusive: bool): C5Ext1Trigger {
    if (!exclusive || !this.hasSnapshot() || this.status() == 4) return this
    if (!sourceReady) return C5Ext1Trigger((this&~255)|2)
    C5Ext1Trigger((this&~255)|(if (c5Ext1TriggerSet(true)) 1 else 3))
}
// Restore only after parking and restoring borrowed source/pad configuration.
trusted fun C5Ext1Trigger.closeOwned(exclusive: bool): C5Ext1Trigger {
    if (!exclusive || !this.hasSnapshot() || this.status() == 4) return this
    C5Ext1Trigger((this&~255)|(if (c5Ext1TriggerSet((this&256) != 0)) 4 else 3))
}
