import "./retention_links_p4_sequence.ab"
import "./retention_timeout_p4_sequence.ab"
import "./retention_enable_p4_sequence.ab"
// Prepared graph configuration session: timeouts -> entry pointers -> PMU
// enables LAST. Reverse cleanup stops at failed child, retaining every token.
// Caller proves PAU idle, excludes all PMU/ETM/software starts throughout,
// owns clocks/backup modes/AON policy and validated retained graph+buffers.
// This does not validate graph semantics, activate backup, or power down PAU.
// Config32B: entries0/1/2,PAUwait,PAUinterval,LPwait,LPbackup,LPinterval.
// Record64B: magic,state,primary,cleanup,timeout64,enable32,reserved,links32.
// State1ready3partial4closed. Results1ready2invalid3timeout4links5enable
// 6cleanup8closed. Do not independently manipulate child leases.
trusted fun p4RetentionSessionTimeoutStore(r: NativeBuffer,t: P4RetentionTimeout): void {
    r.storeU32(16,t&0xffffffff);r.storeU32(20,t>>>32);return
}
trusted fun esp32p4RetentionSessionOpenOwned(r: NativeBuffer,c: NativeBuffer,exclusivePrepared: bool): int {
    if (!exclusivePrepared || !r.hasAddressRange(0,64) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 || !p4RetentionSessionConfigValid(c)) return 2
    if (r.addressValue() < c.addressValue()+32 && c.addressValue() < r.addressValue()+64) return 2
    var i=0
    while (i < 3) {
        val address=c.loadU32(i*4)
        if (address != 0 && address < r.addressValue()+64 && r.addressValue() < address+4) return 2
        i=i+1
    }
    i=4
    while (i < 64) { r.storeU32(i,0);i=i+4 }
    r.storeU32(0,0x50345331);r.storeU32(4,3)
    val timeout=esp32p4RetentionTimeoutOpenOwned(c.loadU32(12),c.loadU32(16),c.loadU32(20),c.loadU32(24),c.loadU32(28),true)
    p4RetentionSessionTimeoutStore(r,timeout)
    if (timeout.status() != 1) { r.storeU32(8,3);return 3 }
    if (esp32p4RetentionLinksOpenOwned(nativeBufferAt(r.addressValue()+32,32),c.loadU32(0),c.loadU32(4),c.loadU32(8),true) != 1) { r.storeU32(8,4);return 4 }
    val enabled=esp32p4RetentionEnableOpenOwned(true);r.storeU32(24,enabled|0)
    if (enabled.status() != 1) { r.storeU32(8,5);return 5 }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4RetentionSessionCloseOwned(r: NativeBuffer,exclusiveIdle: bool): int {
    if (!exclusiveIdle || !r.hasAddressRange(0,64) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50345331) return 2
    if (r.loadU32(4) == 4) return 8
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    r.storeU32(4,3)
    var enabled=P4RetentionEnable(r.loadU32(24))
    if (enabled.hasSnapshot()) {
        enabled=enabled.closeOwned(true);r.storeU32(24,enabled|0)
        if (enabled.status() != 4) { r.storeU32(12,5);return 6 }
    }
    val links=nativeBufferAt(r.addressValue()+32,32)
    if (links.loadU32(0) != 0 && esp32p4RetentionLinksCloseOwned(links,true) != 5) { r.storeU32(12,4);return 6 }
    var timeout=P4RetentionTimeout(r.loadU32(16)|(r.loadU32(20)<<32))
    if (timeout.hasSnapshot()) {
        timeout=timeout.closeOwned(true);p4RetentionSessionTimeoutStore(r,timeout)
        if (timeout.status() != 5) { r.storeU32(12,3);return 6 }
    }
    r.storeU32(12,0);r.storeU32(4,4);return 8
}
