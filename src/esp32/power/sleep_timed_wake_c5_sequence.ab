import "../rtc_timer_c5_sequence.ab"
import "../../runtime/rtc_time48.ab"
// Last admission before programming HP wake comparator0. Absolute deadline
// must lie within a half48bit cycle of now; no timer reset/calibration change.
// minimumLeadTicks includes IDF's16tick alarm-to-sleep guard PLUS actual
// remaining retention/entry work. Caller bounds that work, owns snapshot0 and
// an inactive comparator0, and must route RTC timer wake into PMU before sleep.
// This does not enable IRQ routing, enter sleep or cancel an armed comparator.
// 1armed,2invalid/noIO,3target-write failure/unarmed,4late/no alarm mutation.
// A snapshot publishes UPDATE even on4. On1 retain comparator ownership until
// wake or explicit platform cleanup; do not blindly retry an armed alarm.
@section(".iram1.abla.c5TimedWake")
trusted fun esp32C5TimedWakePrepareOwned(deadline: int,minimumLeadTicks: int,exclusiveInactive: bool): int {
    if (!exclusiveInactive || deadline < 0 || deadline > 0xffffffffffff || minimumLeadTicks < 16 || minimumLeadTicks >= 0x800000000000) return 2
    val now=esp32C5RtcTicksOwned(0,true)
    val remaining=rtc48TicksRemaining(now,deadline)
    if (remaining < minimumLeadTicks) return 4
    esp32C5RtcAlarmOwned(0,deadline,true)
}
