import "abla/runtime/scalar"
// Read-only rtc_vddsdio_get_config semantics for ESP32-S3 (not classic ESP32's
// different eFuse/register map). Compact scalar: force0,enable1,tieh2,
// drefh3..4,drefm5..6,drefl7..8,valid9. TIEH1=3.3V,0=1.8V.
// These are configured settings, NOT a voltage measurement, power-good signal,
// external-regulator detection or proof that a particular memory chip is safe.
type Esp32S3MemorySupply = int
fun Esp32S3MemorySupply.valid(): bool = (this&512) != 0 && (this&~1023) == 0
fun Esp32S3MemorySupply.forced(): bool = this.valid() && (this&1) != 0
fun Esp32S3MemorySupply.configuredEnabled(): bool = this.valid() && (this&2) != 0
fun Esp32S3MemorySupply.configuredMillivolts(): int =
    if (!this.configuredEnabled()) -1 else if ((this&4) != 0) 3300 else 1800
fun Esp32S3MemorySupply.highTrim(): int = if (this.valid()) (this>>>3)&3 else -1
fun Esp32S3MemorySupply.middleTrim(): int = if (this.valid()) (this>>>5)&3 else -1
fun Esp32S3MemorySupply.lowTrim(): int = if (this.valid()) (this>>>7)&3 else -1
fun Esp32S3MemorySupply.matchesConfiguredMillivolts(expected: int): bool =
    (expected == 1800 || expected == 3300) && this.configuredMillivolts() == expected
fun esp32S3MemorySupplyDecode(sdio: int,strap: int): Esp32S3MemorySupply {
    val trims=(((sdio>>>29)&3)<<3)|(((sdio>>>27)&3)<<5)|(((sdio>>>25)&3)<<7)
    if ((sdio&0x400000) != 0) return Esp32S3MemorySupply(512|trims|1|(((sdio>>>31)&1)<<1)|(((sdio>>>23)&1)<<2))
    return Esp32S3MemorySupply(512|trims|2|(if ((strap&32) == 0) 4 else 0))
}
@section(".iram1.abla.s3MemorySupplyRead")
trusted fun esp32S3MemorySupplyReadOwned(): Esp32S3MemorySupply {
    // Caller serializes with RTC supply changes. Forced mode never consults
    // bootstrap pins; otherwise use the latched strap, not today's GPIO level.
    val sdio=esp32S3MemorySupplyRead(0x6000807c)
    val strap=if ((sdio&0x400000) != 0) 0 else esp32S3MemorySupplyRead(0x60004038)
    return esp32S3MemorySupplyDecode(sdio,strap)
}
