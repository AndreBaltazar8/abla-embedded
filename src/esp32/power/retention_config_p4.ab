import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
fun p4RetentionLinkAddressValid(address: int): bool = address >= 0 && address <= 0xfffffffc && (address&3) == 0
trusted fun p4RetentionSessionConfigValid(c: NativeBuffer): bool {
    if (!c.hasAddressRange(0,32) || (c.addressValue()&3) != 0 || c.loadU32(0) == 0) return false
    var i=0
    while (i < 3) { if (!p4RetentionLinkAddressValid(c.loadU32(i*4))) return false;i=i+1 }
    i=3
    while (i < 8) {
        val value=c.loadU32(i*4)
        if (value < 1 || value > (if (i == 4 || i == 7) 127 else 1023)) return false
        i=i+1
    }
    return true
}
