import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Power-only subset of IDF sleep flags: TOP0,CPU4,MEM6..9,XTAL10,
// RCfast11,XTAL32k12,RC32k13,LPperiph14,CNNT15,VBAT26,XTAL-as-fast30.
// Do not pass unrelated flags here; the full analog policy consumes others.
// Pure builder of existing power config32B; no MMIO or automatic sleep.
// This does not prove selected memory/oscillators are safe to power down.
trusted fun esp32p4SleepPowerDefaults(output: NativeBuffer,flags: u32,revision: int,deep: bool): bool {
    if (!output.hasAddressRange(0,32) || (output.addressValue()&3) != 0 || revision < 0 || revision > 399 ||
        (flags&~u32(0x4400ffd1)) != u32(0) || (revision < 300 && (flags&u32(16)) != u32(0)) ||
        (!deep && (flags&u32(0x04000000)) != u32(0))) return false
    var hp=u32(0)
    if ((flags&u32(1)) != u32(0)) hp=hp|u32(0x80000000)
    if ((flags&u32(16)) != u32(0)) hp=hp|u32(0x20000000)
    if ((flags&u32(0x3c0)) != u32(0)) hp=hp|u32(0x00800000)
    if ((flags&u32(0x8000)) != u32(0)) hp=hp|u32(0x40000000)
    if (deep) hp=hp|u32(0x00200000)
    val xtal=if ((flags&u32(0x400)) == u32(0)) u32(0x80000000) else u32(0)
    var slow=u32(0)
    if ((flags&u32(0x1000)) == u32(0)) slow=slow|u32(0x10000000)
    if ((flags&u32(0x2000)) == u32(0)) slow=slow|u32(0x20000000)
    var lp=if ((flags&u32(0x4000)) != u32(0)) u32(0x80000000) else u32(0)
    if ((flags&u32(0x04000000)) != u32(0)) lp=lp|u32(0x18000000)
    output.storeU32(0,int(hp))
    output.storeU32(4,0x00600000)
    output.storeU32(8,int(xtal|(if ((flags&u32(0x40000000)) != u32(0)) u32(0x80000000) else u32(0))))
    output.storeU32(12,0)
    output.storeU32(16,int(slow|u32(0x48000000)))
    output.storeU32(20,int(lp))
    output.storeU32(24,int(slow|(if ((flags&u32(0x800)) == u32(0)) u32(0x40000000) else u32(0))))
    output.storeU32(28,int(xtal))
    return true
}
// Upstream digital defaults depend on silicon layout, not deep vs light.
// Rev<3 holds LP pads when powering LP peripherals down; rev3 does not.
fun esp32p4SleepDigitalDefaults(flags: u32,revision: int): int =
    if (revision < 0 || revision > 399) -1 else if (revision < 300 && (flags&u32(0x4000)) != u32(0)) 2 else 0
