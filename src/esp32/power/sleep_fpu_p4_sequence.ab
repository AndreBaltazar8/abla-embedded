import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// P4 floating-point bank retention.160B: magic,state,hart,savedFS,fcsr,
// f0..f31 at20..144; reserved148..159. No allocation or lazy-task-FPU policy.
// Exclusive same hart, machine mode, interrupts disabled, retained internal
// record/code/stack. Save any enabled bank, including CLEAN (not just DIRTY).
// Retention path must use the integer-only soft-float ABI (+f is enabled only
// inside explicit register-transfer instructions), not compiler-generated FP.
// FS=Off means no live architectural FP bank; never read fcsr/FP registers.
// Restore bank before restoring saved FS; preserve unrelated mstatus bits.
// No CPU sleep request; integrate before the critical integer context boundary.
// Results1saved2invalid3prerequisite4restored.
trusted fun p4SleepFpuRecord(r: NativeBuffer): bool = r.hasAddressRange(0,160) && (r.addressValue()&3) == 0
trusted fun esp32p4SleepFpuSaveOwned(r: NativeBuffer,exclusiveHart: bool): int {
    if (!exclusiveHart || !p4SleepFpuRecord(r) || r.loadU32(0) != 0) return 2
    val hart=p4SleepFpuHart()
    val status=p4SleepFpuStatus()
    if (hart > u32(1) || (status&u32(8)) != u32(0)) return 3
    val fs=status&u32(0x6000)
    r.storeU32(0,0x50344650);r.storeU32(4,0);r.storeU32(8,int(hart));r.storeU32(12,int(fs))
    r.storeU32(148,0);r.storeU32(152,0);r.storeU32(156,0)
    if (fs != u32(0)) {
        r.storeU32(16,int(p4SleepFpuControlRead()))
        r.storeU32(20,int(p4SleepFpuRead(0)))
        r.storeU32(24,int(p4SleepFpuRead(1)))
        r.storeU32(28,int(p4SleepFpuRead(2)))
        r.storeU32(32,int(p4SleepFpuRead(3)))
        r.storeU32(36,int(p4SleepFpuRead(4)))
        r.storeU32(40,int(p4SleepFpuRead(5)))
        r.storeU32(44,int(p4SleepFpuRead(6)))
        r.storeU32(48,int(p4SleepFpuRead(7)))
        r.storeU32(52,int(p4SleepFpuRead(8)))
        r.storeU32(56,int(p4SleepFpuRead(9)))
        r.storeU32(60,int(p4SleepFpuRead(10)))
        r.storeU32(64,int(p4SleepFpuRead(11)))
        r.storeU32(68,int(p4SleepFpuRead(12)))
        r.storeU32(72,int(p4SleepFpuRead(13)))
        r.storeU32(76,int(p4SleepFpuRead(14)))
        r.storeU32(80,int(p4SleepFpuRead(15)))
        r.storeU32(84,int(p4SleepFpuRead(16)))
        r.storeU32(88,int(p4SleepFpuRead(17)))
        r.storeU32(92,int(p4SleepFpuRead(18)))
        r.storeU32(96,int(p4SleepFpuRead(19)))
        r.storeU32(100,int(p4SleepFpuRead(20)))
        r.storeU32(104,int(p4SleepFpuRead(21)))
        r.storeU32(108,int(p4SleepFpuRead(22)))
        r.storeU32(112,int(p4SleepFpuRead(23)))
        r.storeU32(116,int(p4SleepFpuRead(24)))
        r.storeU32(120,int(p4SleepFpuRead(25)))
        r.storeU32(124,int(p4SleepFpuRead(26)))
        r.storeU32(128,int(p4SleepFpuRead(27)))
        r.storeU32(132,int(p4SleepFpuRead(28)))
        r.storeU32(136,int(p4SleepFpuRead(29)))
        r.storeU32(140,int(p4SleepFpuRead(30)))
        r.storeU32(144,int(p4SleepFpuRead(31)))
    }
    p4SleepFpuFence();r.storeU32(4,1)
    return 1
}
trusted fun esp32p4SleepFpuRestoreOwned(r: NativeBuffer,exclusiveHart: bool): int {
    if (!exclusiveHart || !p4SleepFpuRecord(r) || r.loadU32(0) != 0x50344650 || r.loadU32(4) != 1 ||
        (r.loadU32(12)&(~0x6000)) != 0 || r.loadU32(148) != 0 || r.loadU32(152) != 0 || r.loadU32(156) != 0) return 2
    if (p4SleepFpuHart() != u32(r.loadU32(8)) || (p4SleepFpuStatus()&u32(8)) != u32(0)) return 3
    r.storeU32(4,2)
    val fs=u32(r.loadU32(12))
    if (fs != u32(0)) {
        p4SleepFpuSetFs(u32(0x6000))
        p4SleepFpuWrite(0,u32(r.loadU32(20)))
        p4SleepFpuWrite(1,u32(r.loadU32(24)))
        p4SleepFpuWrite(2,u32(r.loadU32(28)))
        p4SleepFpuWrite(3,u32(r.loadU32(32)))
        p4SleepFpuWrite(4,u32(r.loadU32(36)))
        p4SleepFpuWrite(5,u32(r.loadU32(40)))
        p4SleepFpuWrite(6,u32(r.loadU32(44)))
        p4SleepFpuWrite(7,u32(r.loadU32(48)))
        p4SleepFpuWrite(8,u32(r.loadU32(52)))
        p4SleepFpuWrite(9,u32(r.loadU32(56)))
        p4SleepFpuWrite(10,u32(r.loadU32(60)))
        p4SleepFpuWrite(11,u32(r.loadU32(64)))
        p4SleepFpuWrite(12,u32(r.loadU32(68)))
        p4SleepFpuWrite(13,u32(r.loadU32(72)))
        p4SleepFpuWrite(14,u32(r.loadU32(76)))
        p4SleepFpuWrite(15,u32(r.loadU32(80)))
        p4SleepFpuWrite(16,u32(r.loadU32(84)))
        p4SleepFpuWrite(17,u32(r.loadU32(88)))
        p4SleepFpuWrite(18,u32(r.loadU32(92)))
        p4SleepFpuWrite(19,u32(r.loadU32(96)))
        p4SleepFpuWrite(20,u32(r.loadU32(100)))
        p4SleepFpuWrite(21,u32(r.loadU32(104)))
        p4SleepFpuWrite(22,u32(r.loadU32(108)))
        p4SleepFpuWrite(23,u32(r.loadU32(112)))
        p4SleepFpuWrite(24,u32(r.loadU32(116)))
        p4SleepFpuWrite(25,u32(r.loadU32(120)))
        p4SleepFpuWrite(26,u32(r.loadU32(124)))
        p4SleepFpuWrite(27,u32(r.loadU32(128)))
        p4SleepFpuWrite(28,u32(r.loadU32(132)))
        p4SleepFpuWrite(29,u32(r.loadU32(136)))
        p4SleepFpuWrite(30,u32(r.loadU32(140)))
        p4SleepFpuWrite(31,u32(r.loadU32(144)))
        p4SleepFpuControlWrite(u32(r.loadU32(16)))
    }
    p4SleepFpuSetFs(fs)
    p4SleepFpuFence();r.storeU32(4,3)
    return 4
}
