import "./sleep_memory_cycle_common_c5.ab"
import "../flash_identified_ready_c5.ab"
// Alternative composition with observed chip policy, no caller-provided mask.
// Retained736B context: memory request48,transition448,identified readiness240
// at496. Observe JEDEC at508 and selected SUSmask512 after identification.
// Caller still qualifies SDR transport/current timings/CS0 and all memory/PLL
// ownership/voltage prerequisites. An ID match does not qualify board wiring.
// Results5suspended/6unsupported-no-response keep state7 and caches OFF, with
// no sleep, MSPI reconfiguration or PLL restart. Continue reports the same
// state without more commands. Recheck explicitly re-reads WIP/ID/status after
// owner action; no RESUME, forced compatibility or cache enable is performed.
@section(".iram1.abla.c5IdentifiedMemoryRecheck")
trusted fun esp32C5SleepIdentifiedMemoryRecheckOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,792) || (record.addressValue()&3) != 0 ||
        c5SleepRecordRead(record,0) != 0x43594331 || c5SleepRecordRead(record,4) != 7) return 2
    val address=c5SleepRecordRead(record,108)
    if (address == 0) return 2
    val context=nativeBufferAt(address,736)
    if (c5SleepRecordRead(context,48) != 0 || c5SleepRecordRead(context,496) != 0x43495231) return 2
    val state=c5SleepRecordRead(context,500)
    if (state != 4 && state != 5) return 2
    c5SleepRecordWrite(context,496,0)
    esp32C5SleepCycleContinueOwned(record,true)
}
@section(".iram1.abla.c5IdentifiedMemoryBegin")
trusted fun esp32C5SleepIdentifiedMemoryBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,exclusiveQualifiedSdr: bool): int {
    if (!exclusiveQualifiedSdr || !context.hasAddressRange(0,736) || (context.addressValue()&3) != 0 ||
        !record.hasAddressRange(0,792) || (record.addressValue()&3) != 0 || c5SleepRecordRead(record,0) != 0 ||
        !c5SleepCycleRequestValid(request,true)) return 2
    val address=context.addressValue();val base=record.addressValue();val input=request.addressValue()
    if ((base < address+736 && address < base+792) || (input < address+736 && address < input+68) ||
        (base < input+68 && input < base+792) || c5SleepRecordRead(context,48) != 0 || c5SleepRecordRead(context,496) != 0) return 2
    c5SleepCycleBeginContextOwned(record,request,true,address)
}
@inline
trusted fun c5SleepCycleEntry(record: NativeBuffer): int {
    val address=c5SleepRecordRead(record,108)
    if (address == 0) return -3
    val ready=esp32C5FlashIdentifiedReadyOwned(nativeBufferAt(address+496,240),c5SleepRecordRead(record,80),true)
    if (ready == 3) return -5
    if (ready == 4) return -6
    if (ready == 5) return -7
    if (ready != 1) return -3
    val applied=esp32C5MspiTransitionBeginOwned(nativeBufferAt(address+48,448),nativeBufferAt(address,48),true)
    if (applied != 1) return -3
    c5SleepCycleTimedEntry(record)
}
