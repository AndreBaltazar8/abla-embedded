import "./sleep_flash_rev3_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepFlashRead")
trusted fun p4SleepFlashReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("p4SleepFlashWrite")
trusted fun p4SleepFlashWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
@export("p4SleepFlashEncrypted")
trusted fun p4SleepFlashEncryptedHook(): bool {
    val count=(mmioLoadU32(0x5012d034)>>>18)&7
    return ((count^(count>>>1)^(count>>>2))&1) != 0
}
trusted noescape extern:"inline-assembly" fun p4SleepFlashAsm(template: string,constraints: string): void
@export("p4SleepFlashFence")
trusted fun p4SleepFlashFenceHook(): void { p4SleepFlashAsm("fence iorw, iorw","~{memory}");return }
