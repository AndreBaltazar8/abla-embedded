import "./sleep_flash_rev3_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4SleepFlashRead(address: int): u32 = u32(mmioLoadU32(address))
trusted fun p4SleepFlashWrite(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
trusted fun p4SleepFlashEncrypted(): bool {
    val count=(mmioLoadU32(0x5012d034)>>>18)&7
    return ((count^(count>>>1)^(count>>>2))&1) != 0
}
trusted noescape extern:"inline-assembly" fun p4SleepFlashAsm(template: string,constraints: string): void
trusted fun p4SleepFlashFence(): void { p4SleepFlashAsm("fence iorw, iorw","~{memory}");return }
