// C5 IDF6 pmu_sleep_start/finish, retained-CPU light sleep primitive ONLY.
// Caller has prepared wake sources, PMU profile, clocks/MSPI/flash and required
// retention, excluded interrupts/other writers, and placed this entire call
// closure, stack and data in retained internal memory. This does not provide
// those preparations, deep sleep, or CPU power-down context restoration.
// Returns -1 invalid ownership/mask, -2 CPU-off or HP regulator-off profile,
// -3 pre-request configuration/ack failure, 0 wake, 1 rejected (takes priority).
// Mutates wake/reject masks and ROM mode flag; acknowledges OLD wake/reject
// causes irreversibly. Caller captures them before entry if needed. New causes
// stay latched on return. Caller MUST restore clocks/MSPI/configuration before
// releasing quiescence, including on -3; this function does not roll them back.
// After request there is deliberately no timeout: returning while the PMU is
// still transitioning would permit unsafe peripheral reuse. Finish also waits
// for eFuse reload to become idle, exactly as pmu_sleep_finish.
@section(".iram1.abla.c5LightSleepEntry")
trusted fun esp32C5LightSleepEnterOwned(wakeMask: u32,rejectMask: int,exclusive: bool): int {
    if (!exclusive || wakeMask == u32(0) || rejectMask < 0 || rejectMask > 0x7fffffff) return -1
    if ((c5SleepEntryRead(0x600b0068)&0x20000000) != 0 || (c5SleepEntryRead(0x600b0090)&0x40000) == 0) return -2
    // RTC_SLEEP_MODE_REG is STORE8 (+0x20) in C5 ROM rtc.h, despite the
    // lp_aon_ll comment mentioning STORE9. Preserve other persistent bits.
    c5SleepEntryWrite(0x600b1020,c5SleepEntryRead(0x600b1020)&~1)
    c5SleepEntryWrite(0x600b012c,int(wakeMask))
    c5SleepEntryWrite(0x600b0128,rejectMask|0x80000000)
    if ((c5SleepEntryRead(0x600b1020)&1) != 0 || c5SleepEntryRead(0x600b012c) != int(wakeMask) ||
        c5SleepEntryRead(0x600b0128) != (rejectMask|0x80000000)) return -3
    // WT/W1C: direct writes only, never RMW/replay unrelated interrupt clears.
    c5SleepEntryWrite(0x600b016c,0xc0000000)
    c5SleepEntryWrite(0x600b0134,0x80000000)
    if ((c5SleepEntryRead(0x600b0160)&0xc0000000) != 0 || c5SleepEntryRead(0x600b0148) != 0) return -3
    c5SleepEntryWrite(0x600b0124,0x80000000)
    var raw=c5SleepEntryRead(0x600b0160)
    while ((raw&0xc0000000) == 0) raw=c5SleepEntryRead(0x600b0160)
    while ((c5SleepEntryRead(0x600b49d4)&15) != 1) { }
    // Re-read reject after eFuse completion, matching pmu_sleep_finish.
    (c5SleepEntryRead(0x600b0160)>>30)&1
}
