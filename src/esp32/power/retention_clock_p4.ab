import "./retention_descriptor_p4.ab"
// All9 P4 sleep_clock.c PCR nodes, PAU entry0, priority0 (before peripherals).
// Restore-only: analog-master gate, SYSPLL calibration start/wait/stop;
// copy60 clock/reset words; apply/wait root divider, apply/wait SDIO edges.
// Pure plan generation, NOT safe to execute as ordinary live CPU MMIO.
// Caller supplies retained backing memory, PAU WAIT timeout and valid oscillator,
// power/CPU/root/recovery context. Calibration END is not a frequency measure.
fun p4RetentionClockAddress(node: int): int =
    if (node == 0) 0x50120000 else if (node <= 3) 0x500e60bc else if (node == 4) 0x500e6000 else if (node <= 6) 0x500e6004 else 0x500e6038
fun p4RetentionClockMask(node: int): int =
    if (node == 0) 1<<27 else if (node == 2) 64 else if (node <= 3) 128 else if (node <= 6) 16 else 256
trusted fun esp32p4RetentionClockConfig(c: NativeBuffer,node: int,storage: int,next: int): bool {
    if (node < 0 || node > 8 || !c.hasAddressRange(0,56) || (c.addressValue()&3) != 0 ||
        (next != 0 && !p4RetentionAddressSpan(next,4))) return false
    if (node == 4) {
        if (!p4RetentionAddressSpan(storage,240) || (storage < c.addressValue()+56 && c.addressValue() < storage+240)) return false
    } else if (storage != 0) return false
    if (next != 0 && next < c.addressValue()+56 && c.addressValue() < next+4) return false
    var i=4
    while (i < 56) { c.storeU32(i,0);i=i+4 }
    val address=p4RetentionClockAddress(node)
    c.storeU32(4,next);c.storeU32(20,address)
    var head=if (next == 0) 0x80000000 else 0
    if (node == 4) {
        head=head|60;c.storeU32(24,address);c.storeU32(28,storage)
    } else {
        val waiting=node == 2 || node == 6 || node == 8
        val mask=p4RetentionClockMask(node)
        head=head|0x40000000|(if (waiting) 0x30000 else 0x20000)
        c.storeU32(48,if (node == 1 || node == 6 || node == 8) 0 else mask);c.storeU32(52,mask)
    }
    c.storeU32(0,head);return true
}
