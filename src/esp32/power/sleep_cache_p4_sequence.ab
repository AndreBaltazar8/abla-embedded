import "abla/runtime/scalar"
// Whole L1 DATA writeback, not invalidation or L2/PSRAM shutdown. Required
// before P4 sleep even with TOP retained when REGDMA reads cacheable links.
// Caller excludes all other cores/IRQs/DMA/global-sync users and refills,
// keeps backing memory/power/clocks valid, and supplies memory barriers.
// No stack/record writes in this source; generated code must also be audited
// in the final entry tail. Returning to an arbitrary caller does NOT guarantee
// cache stays clean. Timeout retains global sync-engine ownership.
//1done2invalid3busy4setup5timeout. No unbounded polling/reset/forced success.
trusted fun esp32p4SleepCacheWritebackOwned(polls: int,exclusive: bool): int {
    if (!exclusive || polls < 1 || polls > 1000000) return 2
    if ((p4SleepCacheRead(152)&u32(15)) != u32(0)) return 3
    p4SleepCacheFence()
    p4SleepCacheWrite(160,u32(0));p4SleepCacheWrite(164,u32(0));p4SleepCacheWrite(156,u32(16))
    if (p4SleepCacheRead(160) != u32(0) || (p4SleepCacheRead(164)&u32(0x0fffffff)) != u32(0) ||
        (p4SleepCacheRead(156)&u32(63)) != u32(16)) return 4
    // Two commands match the existing P4 writeback erratum workaround.
    // Writing4 also explicitly selects default SMMU group0 (RGID bits5..8).
    var pass=0
    while (pass < 2) {
        p4SleepCacheWrite(152,u32(4))
        var remaining=polls
        while ((p4SleepCacheRead(152)&u32(31)) != u32(16)) {
            remaining=remaining-1
            if (remaining == 0) return 5
        }
        pass=pass+1
    }
    p4SleepCacheFence();return 1
}
