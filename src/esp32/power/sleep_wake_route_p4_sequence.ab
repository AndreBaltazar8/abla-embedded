import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// ROM rtc.h: STORE8 bits31:2 are the CPU light-sleep restore entry. Low bits
// are separate mode ownership (bit0 deep/light); STORE9 is LP UART metadata.
// 24B retained record: magic,state,oldAddress,newAddress,hart,lastResult.
// Caller publishes executable internal wake code + per-hart retained context
// BEFORE open, excludes both harts' wake-route users and all sleep requests.
// Continue under that exclusion; close only after wake recovery/aborted entry,
// never while ROM could still consume the route. No instruction-cache publish,
// CPU context save or sleep request is implied by installing this pointer.
// Results1installed2invalid3ownership-conflict4write-pending5closed.
trusted fun p4WakeRouteRecord(r: NativeBuffer): bool =
    r.hasAddressRange(0,24) && (r.addressValue()&3) == 0
trusted fun p4WakeRouteResult(r: NativeBuffer,result: int): int { r.storeU32(20,result);return result }
trusted fun esp32p4SleepWakeRouteContinueOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !p4WakeRouteRecord(r) || r.loadU32(0) != 0x50345752 ||
        r.loadU32(4) < 1 || r.loadU32(4) > 4) return 2
    if (p4WakeRouteHart() != u32(r.loadU32(16))) return 3
    val state=r.loadU32(4)
    if (state == 4) return 5
    val before=p4WakeRouteRead()
    val pointer=before&u32(0xfffffffc)
    val old=u32(r.loadU32(8))
    val desired=u32(r.loadU32(12))
    if (pointer != old && pointer != desired) return p4WakeRouteResult(r,3)
    val target=if (state == 3) old else desired
    if (pointer != target) {
        p4WakeRouteWrite((before&u32(3))|target)
        p4WakeRouteFence()
        if ((p4WakeRouteRead()&u32(0xfffffffc)) != target) return p4WakeRouteResult(r,4)
    }
    r.storeU32(4,if (state == 3) 4 else 2)
    return p4WakeRouteResult(r,if (state == 3) 5 else 1)
}
trusted fun esp32p4SleepWakeRouteOpenOwned(r: NativeBuffer,address: int,exclusivePublished: bool): int {
    if (!exclusivePublished || !p4WakeRouteRecord(r) || r.loadU32(0) != 0 ||
        address <= 0 || address > 4294967292 || (address&3) != 0 || p4WakeRouteHart() > u32(1)) return 2
    val before=p4WakeRouteRead()
    r.storeU32(0,0x50345752);r.storeU32(4,1);r.storeU32(8,int(before&u32(0xfffffffc)))
    r.storeU32(12,address);r.storeU32(16,int(p4WakeRouteHart()));r.storeU32(20,0)
    return esp32p4SleepWakeRouteContinueOwned(r,true)
}
trusted fun esp32p4SleepWakeRouteCloseOwned(r: NativeBuffer,exclusiveRecovered: bool): int {
    if (!exclusiveRecovered || !p4WakeRouteRecord(r) || r.loadU32(0) != 0x50345752 ||
        r.loadU32(4) < 1 || r.loadU32(4) > 4) return 2
    if (p4WakeRouteHart() != u32(r.loadU32(16))) return 3
    if (r.loadU32(4) != 4) r.storeU32(4,3)
    return esp32p4SleepWakeRouteContinueOwned(r,true)
}
