import "./retention_descriptor_p4.ab"
// Six P4 IOMUX/GPIO retention nodes, ordered as system_retention_periph.c.
// Pure descriptor configurations; no live GPIO writes or PAU activation.
// 0 ordinary IOMUX through GPIO54;1 dedicated flash/PSRAM pins;2 GPIO sparse
// outputs/enables/status;3 GPIO PIN0..56;4 matrix inputs1..255+outputs0..56;
// 5 GPIO clock/control sparse registers. Both backup and restore, entry0.
// Correct upstream MSPI range mismatch: count was computed from CLK_EN0@0
// although copying begins FLASH_CS@4, extending to0x6c past the sizeof0x6c
// register block. Copy26 actual pin words4..68; clocks remain caller-owned.
// Preserve hardware pin holds/isolation and full recovery ordering externally.
fun esp32p4RetentionIomuxBase(node: int): int =
    if (node == 0) 0x500e1000 else if (node == 1) 0x500e1204 else if (node == 2) 0x500e0004 else
    if (node == 3) 0x500e0074 else if (node == 4) 0x500e015c else if (node == 5) 0x500e064c else 0
fun esp32p4RetentionIomuxWords(node: int): int =
    if (node == 0) 56 else if (node == 1) 26 else if (node == 2) 6 else if (node == 3) 57 else if (node == 4) 312 else if (node == 5) 9 else 0
trusted fun esp32p4RetentionIomuxConfig(c: NativeBuffer,node: int,storage: int,next: int): bool {
    val words=esp32p4RetentionIomuxWords(node)
    if (words == 0 || !c.hasAddressRange(0,56) || (c.addressValue()&3) != 0 || !p4RetentionAddressSpan(storage,words*4) ||
        (next != 0 && !p4RetentionAddressSpan(next,4))) return false
    if (storage < c.addressValue()+56 && c.addressValue() < storage+words*4) return false
    if (next != 0 && next < c.addressValue()+56 && c.addressValue() < next+4) return false
    var i=4
    while (i < 56) { c.storeU32(i,0);i=i+4 }
    val address=esp32p4RetentionIomuxBase(node)
    c.storeU32(4,next);c.storeU32(20,address);c.storeU32(24,address);c.storeU32(28,storage)
    if (node == 2) c.storeU32(32,0x90489)
    if (node == 5) { c.storeU32(32,1);c.storeU32(36,0x6fa000) }
    c.storeU32(0,words|(if (node == 2 || node == 5) 0x10000 else 0)|(if (next == 0) 0x80000000 else 0))
    return true
}
