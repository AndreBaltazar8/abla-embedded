import "./cpu_clock_p4_sequence.ab"
import "./cpll_esp32p4.ab"
trusted noescape extern:"inline-assembly" fun p4CpuClockAsm(template: string,constraints: string): void
trusted fun p4CpuClockFence(): void = p4CpuClockAsm("fence iorw, iorw","~{memory}")
trusted fun p4CpuClockRead(address: int): int = mmioLoadU32(address)
trusted fun p4CpuClockWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
