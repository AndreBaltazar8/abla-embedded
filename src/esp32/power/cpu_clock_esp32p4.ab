import "./cpu_clock_p4_sequence.ab"
import "./cpll_esp32p4.ab"
import "../../hal/esp32_power.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun p4CpuClockAsm(template: string,constraints: string): void
@export("p4CpuClockFence")
trusted fun p4CpuClockFenceHook(): void = p4CpuClockAsm("fence iorw, iorw","~{memory}")
@export("p4CpuClockRead")
trusted fun p4CpuClockReadHook(address: int): int = mmioLoadU32(address)
@export("p4CpuClockWrite")
trusted fun p4CpuClockWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
