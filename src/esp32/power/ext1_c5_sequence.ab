// C5 LP_AON_EXT_WAKEUP_CNTL at600b1040: selection8@15, levels8@23,
// filter31, RO status0..7 and write-trigger clear14. Never echo clear14.
// Caller exclusively owns EXT1 and selected LP pads; excludes sleep/LP/core
// writers. This configures selection only, NOT pad mux/holds or PMU wake enable.
type C5Ext1Wake=int
fun C5Ext1Wake.status(): int = this&255
fun C5Ext1Wake.hasSnapshot(): bool = (this&(1<<25)) != 0
//1configured2invalid3clearbusy4writefailure5closed6parked.
// Saved17bit configuration@8, ownership25. Failed writes retain the snapshot.
trusted fun c5Ext1StoreConfig(configuration: int): bool {
    val before=c5Ext1Read()
    if ((before&16384) != 0) return false
    c5Ext1Write((before&16128)|(configuration&0xffff8000))
    return (c5Ext1Read()&0xffff8000) == (configuration&0xffff8000)
}
trusted fun esp32C5Ext1ParkOwned(exclusive: bool): C5Ext1Wake {
    if (!exclusive) return C5Ext1Wake(2)
    val before=c5Ext1Read()
    if ((before&16384) != 0) return C5Ext1Wake(3)
    val token=(1<<25)|((before>>>15)<<8)
    if (!c5Ext1StoreConfig(before&0xff800000)) return C5Ext1Wake(token|4)
    C5Ext1Wake(token|6)
}
trusted fun C5Ext1Wake.parkOwned(exclusive: bool): C5Ext1Wake {
    if (!exclusive || !this.hasSnapshot() || this.status() == 5) return this
    val before=c5Ext1Read()
    if ((before&16384) != 0) return C5Ext1Wake((this&~255)|3)
    C5Ext1Wake((this&~255)|(if (c5Ext1StoreConfig(before&0xff800000)) 6 else 4))
}
trusted fun C5Ext1Wake.configureOwned(selection: int,highLevels: int,filter: bool,exclusive: bool): C5Ext1Wake {
    if (!exclusive || !this.hasSnapshot() || this.status() == 5) return this
    val token=this&~255
    if (selection < 1 || selection > 255 || highLevels < 0 || (highLevels&~selection) != 0) return C5Ext1Wake(token|2)
    if ((c5Ext1Read()&16384) != 0) return C5Ext1Wake(token|3)
    // All writable fields share one register, so publish polarity/selection
    // atomically after caller has prepared pads; no transient wrong polarity.
    C5Ext1Wake(token|(if (c5Ext1StoreConfig((selection<<15)|(highLevels<<23)|(if (filter) 0x80000000 else 0))) 1 else 4))
}
trusted fun C5Ext1Wake.closeOwned(exclusive: bool): C5Ext1Wake {
    if (!exclusive || !this.hasSnapshot() || this.status() == 5) return this
    if ((c5Ext1Read()&16384) != 0) return C5Ext1Wake((this&~255)|3)
    // Restore only after owned child pads have been restored while parked.
    C5Ext1Wake((this&~255)|(if (c5Ext1StoreConfig(((this>>>8)&131071)<<15)) 5 else 4))
}
trusted fun esp32C5Ext1WakeStatus(): int = c5Ext1Read()&255
// Explicit irreversible acknowledgment. Caller captures status first and
// parks PMU wake/selection. Preserve config/reserved bits; do not echo RO bits.
//1cleared2input3clearbusy4timeout. Bounded verification, not invented success.
trusted fun esp32C5Ext1AcknowledgeOwned(exclusive: bool,readLimit: int = 64): int {
    if (!exclusive || readLimit < 1 || readLimit > 65535) return 2
    val before=c5Ext1Read()
    if ((before&16384) != 0) return 3
    c5Ext1Write((before&0xffffbf00)|16384)
    var i=0
    while (i < readLimit) {
        val after=c5Ext1Read()
        if ((after&255) == 0 && (after&0xffff8000) == (before&0xffff8000)) return 1
        i=i+1
    }
    4
}
