import "abla/runtime/scalar"
// P4 PMU SLP_WAKEUP_CNTL2 +0x128, layouts1/3/ECO5: enable bits0..30.
// Source identities from P4 pmu_bit_defs.h, NOT the C6/S3 bit numbering.
// Entire global trigger mask is exclusively owned; caller excludes sleep
// entry and all HP/LP PMU writers, keeps PMU powered. No sleep-request writes,
// interrupt acknowledgment, reject configuration or source initialization.
// Capture/park before preparing sources; configure only after sources ready.
// Park before restoring sources; close after their original state is restored.
type P4WakeTrigger=int
fun P4WakeTrigger.status(): int = this&255
fun P4WakeTrigger.hasSnapshot(): bool = (this&(1<<39)) != 0
fun esp32p4WakeTriggerExt1(): u32 = u32(1)<<u32(12)
fun esp32p4WakeTriggerTimer(): u32 = u32(1)<<u32(13)
fun esp32p4WakeTriggerTimer1(): u32 = u32(1)<<u32(18)
//1configured2invalid3partialwrite4closed5parked. Original31@8, owned39.
trusted fun p4WakeTriggerSet(mask: u32): bool {
    val before=p4WakeTriggerRead()
    p4WakeTriggerWrite((before&u32(0x80000000))|mask)
    return (p4WakeTriggerRead()&u32(0x7fffffff)) == mask
}
trusted fun esp32p4WakeTriggerParkOwned(exclusive: bool): P4WakeTrigger {
    if (!exclusive) return P4WakeTrigger(2)
    val token=(1<<39)|(int(p4WakeTriggerRead()&u32(0x7fffffff))<<8)
    return P4WakeTrigger(token|(if (p4WakeTriggerSet(u32(0))) 5 else 3))
}
trusted fun P4WakeTrigger.parkOwned(exclusive: bool): P4WakeTrigger {
    if (!exclusive || !this.hasSnapshot() || this.status() == 4) return this
    return P4WakeTrigger((this&(~255))|(if (p4WakeTriggerSet(u32(0))) 5 else 3))
}
trusted fun P4WakeTrigger.configureOwned(mask: u32,exclusive: bool): P4WakeTrigger {
    if (!exclusive || !this.hasSnapshot() || this.status() == 4) return this
    val token=this&(~255)
    // Only documented P4 source bits0..19; zero is the parked operation.
    if (mask == u32(0) || mask > u32(0xfffff)) return P4WakeTrigger(token|2)
    return P4WakeTrigger(token|(if (p4WakeTriggerSet(mask)) 1 else 3))
}
trusted fun P4WakeTrigger.closeOwned(exclusive: bool): P4WakeTrigger {
    if (!exclusive || !this.hasSnapshot() || this.status() == 4) return this
    return P4WakeTrigger((this&(~255))|(if (p4WakeTriggerSet(u32((this>>>8)&0x7fffffff))) 4 else 3))
}
