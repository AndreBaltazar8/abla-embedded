// ESP-IDF6 S3 sleep_uart.c/uart_ll.h. Caller exclusively owns UART, clocks,
// FIFO producers and interrupts throughout prepare -> clock change -> resume.
// Poll budgets count MMIO observations, not microseconds. Never discard data.
fun esp32S3SleepUartBase(port: int): int =
    if (port == 0) 0x60000000 else if (port == 1) 0x60010000 else if (port == 2) 0x6002E000 else 0

// 0 invalid; 1 disabled/reset (untouched); 2 drained; 3 suspended;
// 4 timed out (suspension undone); 5 preexisting software-flow ownership.
// A successful suspension must be resumed after wake OR entry rejection.
trusted fun esp32S3SleepUartPrepareOwned(port: int,deep: bool,polls: int): int {
    val base=esp32S3SleepUartBase(port)
    if (base == 0 || polls <= 0 || polls > 0x7FFFFFFF) return 0
    val gate=1<<(if (port == 0) 2 else if (port == 1) 5 else 9)
    if ((esp32S3SleepUartRead(0x600C0020) & gate) != 0 ||
        (esp32S3SleepUartRead(0x600C0018) & gate) == 0) return 1
    if (!deep) {
        if ((esp32S3SleepUartRead(base+0x34) & 13) != 0) return 5
        esp32S3SleepUartUpdate(base+0x34,4,0)
        esp32S3SleepUartUpdate(base+0x34,9,9)
    }
    var remaining=polls
    while (remaining > 0) {
        if (deep) {
            // Both FIFO and shifter must drain. Producers are quiesced.
            val queued=(esp32S3SleepUartRead(base+0x1C)>>>16) & 1023
            val fsm=(esp32S3SleepUartRead(base+0x6C)>>>4) & 15
            if (queued == 0 && fsm == 0) return 2
        } else {
            val fsm=(esp32S3SleepUartRead(base+0x6C)>>>4) & 15
            if (fsm == 0 || fsm == 15) return 3
        }
        remaining=remaining-1
    }
    if (!deep) esp32S3SleepUartResumeOwned(port)
    4
}

// Only call for a successful status3 from PrepareOwned on this owned port.
// XON must be pulsed before removing software flow control, matching S3 LL.
@section(".iram1.abla.s3SleepUartResume")
trusted fun esp32S3SleepUartResumeOwned(port: int): bool {
    val base=esp32S3SleepUartBase(port)
    if (base == 0) return false
    esp32S3SleepUartUpdate(base+0x34,8,0)
    esp32S3SleepUartUpdate(base+0x34,4,4)
    esp32S3SleepUartUpdate(base+0x34,5,0)
    true
}
