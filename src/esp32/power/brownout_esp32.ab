import "../rom/serial_output_esp32.ab"
import "../rom/basic_system_esp32.ab"
import "../dport_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../log/level_esp32.ab"

// Structured implementation of the original ESP32 brownout control path.
// The fixed addresses below are RTC_CNTL/DPORT MMIO, not linked vendor code.
val esp32BrownoutRtcBase = u32(0x3ff48000)
val esp32BrownoutInterruptBit = u32(0x80)
var esp32BrownoutCallback = u32(0)

val esp32BrownoutEnabledConfigurationStorage =
    nativeStaticBytes("\x00\x01\x00\x01\x00")
val esp32BrownoutEnabledConfiguration = u32(esp32BrownoutEnabledConfigurationStorage)

val esp32BrownoutDisabledConfigurationStorage = nativeStaticAllocate(5)
val esp32BrownoutDisabledConfiguration = u32(esp32BrownoutDisabledConfigurationStorage)

val esp32BrownoutTagStorage = nativeStaticMutableU32s([4476738])
val esp32BrownoutTag = u32(esp32BrownoutTagStorage)
val esp32BrownoutMessageStorage = nativeStaticMutableBytes(
    "\x45\x20\x25\x73\x3a\x20\x42\x72\x6f\x77\x6e\x6f\x75\x74\x20\x64\x65\x74\x65\x63\x74\x6f\x72\x20\x77\x61\x73\x20\x74\x72\x69\x67\x67\x65\x72\x65\x64\x0d\x0a\x0d\x00")
val esp32BrownoutMessage = u32(esp32BrownoutMessageStorage)

@inline
trusted fun esp32BrownoutRead(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32BrownoutWrite(address:u32, value:u32):void {
    xtensaMemoryBarrier()
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))
    xtensaMemoryBarrier()
}

@inline
trusted fun esp32BrownoutSetBits(address:u32, bits:u32):void =
    esp32BrownoutWrite(address,esp32BrownoutRead(address) | bits)

@inline
trusted fun esp32BrownoutClearBits(address:u32, bits:u32):void =
    esp32BrownoutWrite(address,esp32BrownoutRead(address) & ~bits)

trusted fun esp32BrownoutWaitForSerial():void {
    var port = u32(0)
    while (port < u32(3)) {
        val mask = when (port) {
            0 -> u32(4)
            1 -> u32(32)
            else -> u32(0x800000)
        }
        val clockDisabled = (esp32DportRead(u32(0x3ff000c4)) & mask) != u32(0)
        val clockEnabled = (esp32DportRead(u32(0x3ff000c0)) & mask) != u32(0)
        if (!clockDisabled && clockEnabled) esp32RomOutputTxWaitIdleValue(port)
        port = port + u32(1)
    }
}

trusted fun esp32BrownoutInterruptHandler(arguments:u32):u32 {
    // Clear/acknowledge the RTC brownout interrupt immediately.
    esp32BrownoutSetBits(esp32BrownoutRtcBase + u32(72),esp32BrownoutInterruptBit)

    if (esp32BrownoutCallback != u32(0)) {
        ablaUnsafeCallI32I32I32I32I32I32I32(
            int(esp32BrownoutCallback),0,0,0,0,0,0)
    }

    val currentCore = (xtensaReadProcessorId() >>> u32(13)) & u32(1)
    esp32RecoveredEspCpuStall(u32(1) - currentCore)
    esp32RecoveredEspResetReasonSetHint(u32(9))

    if (esp32RecoveredSpiFlashBrownoutNeedReset(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)) != u32(0)) {
        esp32RecoveredBootloaderFlashResetChip(
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    }

    if (esp32BrownoutRead(esp32Data_esp_log_default_level_865ba35f32) != u32(0)) {
        esp32RomPrintfArguments(
            esp32BrownoutMessage,esp32BrownoutTag,u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    }
    esp32BrownoutWaitForSerial()
    esp32RomSoftwareResetSystemValue()
    while (true) {}
    arguments
}

trusted fun esp32RecoveredEspBrownoutInit():u32 {
    esp32BrownoutHalConfig(esp32BrownoutEnabledConfiguration)
    esp32BrownoutSetBits(esp32BrownoutRtcBase + u32(72),esp32BrownoutInterruptBit)
    esp32RecoveredRtcIsrRegister(
        u32(nativeFunctionAddress(esp32BrownoutInterruptHandler)),u32(0),
        esp32BrownoutInterruptBit,u32(1),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32BrownoutSetBits(esp32BrownoutRtcBase + u32(60),esp32BrownoutInterruptBit)
    u32(0)
}

trusted fun esp32RecoveredEspBrownoutDisable():u32 {
    esp32BrownoutHalConfig(esp32BrownoutDisabledConfiguration)
    esp32BrownoutClearBits(esp32BrownoutRtcBase + u32(60),esp32BrownoutInterruptBit)
    esp32RecoveredRtcIsrDeregister(
        u32(nativeFunctionAddress(esp32BrownoutInterruptHandler)),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    u32(0)
}

trusted fun esp32RecoveredEspBrownoutRegisterCallback(callback:u32):u32 {
    // ESP32 IRAM spans 0x40080000 through 0x400a9fff in this target image.
    if (callback != u32(0) &&
        (callback < u32(0x40080000) || callback > u32(0x400a9fff))) return u32(258)
    esp32BrownoutCallback = callback
    u32(0)
}
