import "./sleep_smp_p4_sequence.ab"
// Coordinator AFTER integer boundary returned (CPU owner state6).
// One64B owner references live child leases; all remain exclusive/pinned.
// Header magic,step,outcome,detail,session,clocks,cpu,smp,route,generation,hart,
// preEntryAbort,policySession388(optional),policyClosed,reserved2.
// States1core1resume/cancel2session3publish-event4clocks5restore-start
// 6CPUclose7global-policy/done8wait-peer9routeclose10release11wait-ack12done.
// Session performs actual flash/PSRAM/cache recovery; clock owner restores
// CPLL/CPU/memory speed before CPU banks (MHCR last). Peer phase4 is not
// published until shared recovery and caller-owned PMU/wake/rail cleanup are
// complete. Global policy cleanup can run while this owner pauses atstep7.
// No new sleep request, IRQ acknowledgment or forced hardware success here.
// Results1wake2reject3both4invalid7pending9child-failure10no-request-abort.
// Inputs: session464,clock288,CPU816,sharedSMP4,ROMroute24,owner64; no aliases.
fun p4CoordinatorOverlap(a: NativeBuffer,asize: int,b: NativeBuffer,bsize: int): bool =
    a.addressValue() < b.addressValue()+bsize && b.addressValue() < a.addressValue()+asize
trusted fun p4CoordinatorReport(r: NativeBuffer,result: int,detail: int): int { r.storeU32(12,detail);return result }
trusted fun p4CoordinatorRecoveryOpen(r: NativeBuffer,session: NativeBuffer,clocks: NativeBuffer,cpu: NativeBuffer,smp: NativeBuffer,route: NativeBuffer,generation: int,exclusiveReturned: bool,preEntryAbort: bool): int {
    if (!exclusiveReturned || !r.hasAddressRange(0,64) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 ||
        !session.hasAddressRange(0,464) || (session.addressValue()&3) != 0 ||
        !clocks.hasAddressRange(0,288) || (clocks.addressValue()&3) != 0 ||
        !cpu.hasAddressRange(0,816) || (cpu.addressValue()&15) != 0 ||
        !route.hasAddressRange(0,24) || (route.addressValue()&3) != 0 ||
        !smp.hasAddressRange(0,4) || (smp.addressValue()&3) != 0) return 4
    if (p4CoordinatorOverlap(r,64,session,464) || p4CoordinatorOverlap(r,64,clocks,288) ||
        p4CoordinatorOverlap(r,64,cpu,816) || p4CoordinatorOverlap(r,64,smp,4) || p4CoordinatorOverlap(r,64,route,24) ||
        p4CoordinatorOverlap(session,464,clocks,288) || p4CoordinatorOverlap(session,464,cpu,816) ||
        p4CoordinatorOverlap(session,464,smp,4) || p4CoordinatorOverlap(session,464,route,24) ||
        p4CoordinatorOverlap(clocks,288,cpu,816) || p4CoordinatorOverlap(clocks,288,smp,4) ||
        p4CoordinatorOverlap(clocks,288,route,24) || p4CoordinatorOverlap(cpu,816,smp,4) ||
        p4CoordinatorOverlap(cpu,816,route,24) || p4CoordinatorOverlap(smp,4,route,24)) return 4
    val hart=int(p4SmpHart())
    val state=esp32p4SleepSmpObserve(smp,generation)
    if (hart < 0 || hart > 1 || (p4SmpStatus()&u32(8)) != u32(0) || state.status() != 1 || state.coordinator() != hart) return 4
    if (preEntryAbort) {
        // Never use rollback for an authorized request or a live/returned CPU
        // boundary. Fresh children are optional; partial acquisitions remain owned.
        if ((state.stage() != 1 && state.stage() != 4) || (state.phase(hart) != 1 && state.phase(hart) != 2) ||
            (cpu.loadU32(0) != 0 && (cpu.loadU32(0) != 0x50345243 || cpu.loadU32(8) != hart ||
                cpu.loadU32(4) < 1 || cpu.loadU32(4) > 10 || cpu.loadU32(4) == 5 || cpu.loadU32(4) == 6 || cpu.loadU32(672) != 0)) ||
            (clocks.loadU32(0) != 0 && (clocks.loadU32(0) != 0x50344353 || clocks.loadU32(32) != hart || clocks.loadU32(4) < 1 || clocks.loadU32(4) > 9)) ||
            (session.loadU32(0) != 0 && (session.loadU32(0) != 0x50345332 || session.loadU32(4) < 1 || session.loadU32(4) > 4 ||
                session.loadU32(176) != 0 || (session.loadU32(4) >= 3 && session.loadU32(16) != 10))) ||
            (route.loadU32(0) != 0 && (route.loadU32(0) != 0x50345752 || route.loadU32(16) != hart || route.loadU32(4) < 1 || route.loadU32(4) > 4))) return 4
    } else if (state.stage() != 2 || state.phase(0) != 2 || state.phase(1) != 2 ||
        cpu.loadU32(0) != 0x50345243 || cpu.loadU32(4) != 6 || cpu.loadU32(8) != hart ||
        cpu.loadU32(672) != 0x50344358 || (cpu.loadU32(676) != 2 && cpu.loadU32(676) != 3) ||
        cpu.loadU32(680) != hart || clocks.loadU32(32) != hart || clocks.loadU32(4) < 4 || clocks.loadU32(4) > 9 ||
        session.loadU32(0) != 0x50345332 || clocks.loadU32(0) != 0x50344353 ||
        route.loadU32(0) != 0x50345752 || route.loadU32(4) != 2 || route.loadU32(16) != hart) return 4
    var i=4
    while (i < 64) { r.storeU32(i,0);i=i+4 }
    r.storeU32(0,0x50344352);r.storeU32(4,1);r.storeU32(16,session.addressValue());r.storeU32(20,clocks.addressValue())
    r.storeU32(24,cpu.addressValue());r.storeU32(28,smp.addressValue());r.storeU32(32,route.addressValue())
    r.storeU32(36,generation);r.storeU32(40,hart);r.storeU32(44,if (preEntryAbort) 1 else 0)
    return 7
}
trusted fun esp32p4SleepCoordinatorRecoveryOpenOwned(r: NativeBuffer,session: NativeBuffer,clocks: NativeBuffer,cpu: NativeBuffer,smp: NativeBuffer,route: NativeBuffer,generation: int,exclusiveReturned: bool): int =
    p4CoordinatorRecoveryOpen(r,session,clocks,cpu,smp,route,generation,exclusiveReturned,false)
// Pre-entry failure path. Caller must revoke any prepared request callback and
// hold all children exclusively; no concurrent entry is allowed after this.
trusted fun esp32p4SleepCoordinatorAbortOpenOwned(r: NativeBuffer,session: NativeBuffer,clocks: NativeBuffer,cpu: NativeBuffer,smp: NativeBuffer,route: NativeBuffer,generation: int,exclusiveNoEntry: bool): int =
    p4CoordinatorRecoveryOpen(r,session,clocks,cpu,smp,route,generation,exclusiveNoEntry,true)
// Bind before recovery starts; transfers exclusive cleanup ownership. The
// remaining globalPolicyRecovered proof covers only other board/rail owners.
trusted fun esp32p4SleepCoordinatorBindPolicyOwned(r: NativeBuffer,policy: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,64) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50344352 ||
        r.loadU32(4) != 1 || r.loadU32(48) != 0 || !policy.hasAddressRange(0,388) || (policy.addressValue()&3) != 0 ||
        policy.loadU32(0) != 0x50345053 || (policy.loadU32(4) != 1 && policy.loadU32(4) != 3 && policy.loadU32(4) != 4) ||
        policy.loadU32(16) != r.loadU32(40) || int(p4SmpHart()) != r.loadU32(40) || (p4SmpStatus()&u32(8)) != u32(0)) return 4
    if (p4CoordinatorOverlap(r,64,policy,388) ||
        p4CoordinatorOverlap(nativeBufferAt(r.loadU32(16),464),464,policy,388) ||
        p4CoordinatorOverlap(nativeBufferAt(r.loadU32(20),288),288,policy,388) ||
        p4CoordinatorOverlap(nativeBufferAt(r.loadU32(24),816),816,policy,388) ||
        p4CoordinatorOverlap(nativeBufferAt(r.loadU32(28),4),4,policy,388) ||
        p4CoordinatorOverlap(nativeBufferAt(r.loadU32(32),24),24,policy,388)) return 4
    r.storeU32(48,policy.addressValue());return 7
}
trusted fun esp32p4SleepCoordinatorRecoveryContinueOwned(r: NativeBuffer,polls: int,eventPolls: int,sourcesRecovered: bool,globalPolicyRecovered: bool,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,64) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50344352 ||
        r.loadU32(4) < 1 || r.loadU32(4) > 12 || polls < 1 || polls > 1000000 || eventPolls < 1 || eventPolls > 1000000 ||
        int(p4SmpHart()) != r.loadU32(40) || (p4SmpStatus()&u32(8)) != u32(0)) return 4
    if (r.loadU32(4) == 12) return r.loadU32(8)
    val cpu=nativeBufferAt(r.loadU32(24),816)
    val smp=nativeBufferAt(r.loadU32(28),4)
    val generation=r.loadU32(36)
    val abort=r.loadU32(44) == 1
    while (r.loadU32(4) < 12) {
        val step=r.loadU32(4)
        val state=esp32p4SleepSmpObserve(smp,generation)
        // A newer generation can only open after the peer acknowledged our
        // release. All children are already closed at this point.
        if (step == 11 && state.status() == 5) { r.storeU32(4,12);return p4CoordinatorReport(r,r.loadU32(8),0) }
        if (state.status() != 1) return p4CoordinatorReport(r,9,state.status())
        if (step == 1) {
            if (abort) {
                if (state.stage() == 1) {
                    val canceled=esp32p4SleepSmpAdvanceOwned(smp,generation,6,polls,true)
                    if (canceled.status() != 1) return p4CoordinatorReport(r,if (canceled.status() == 3) 7 else 9,canceled.status())
                } else if (state.stage() != 4) return p4CoordinatorReport(r,9,4)
            } else if (r.loadU32(40) == 0 && cpu.loadU32(676) == 3) {
                val resumed=p4CoordinatorPeer(cpu,smp,generation)
                if (resumed != 1) return p4CoordinatorReport(r,9,resumed)
            }
        } else if (step == 2) {
            val session=nativeBufferAt(r.loadU32(16),464)
            val recovered=if (abort) (if (session.loadU32(0) == 0) 10 else p4CoordinatorSessionAbort(session,polls,eventPolls)) else p4CoordinatorSession(session,polls,eventPolls)
            if ((recovered < 1 || recovered > 3) && recovered != 10) return p4CoordinatorReport(r,if (recovered == 7) 7 else 9,recovered)
            r.storeU32(8,recovered)
        } else if (step == 3 && !abort) {
            val event=r.loadU32(8)
            // Session10 proves pre-request abort, not fabricated rejection.
            val reported=esp32p4SleepSmpAdvanceOwned(smp,generation,if (event == 10) 14 else if (event == 2) 5 else 4,polls,true)
            if (reported.status() != 1) return p4CoordinatorReport(r,9,reported.status())
        } else if (step == 4 && (!abort || nativeBufferAt(r.loadU32(20),288).loadU32(0) != 0)) {
            if (!sourcesRecovered) return p4CoordinatorReport(r,7,4)
            val restored=p4CoordinatorClocks(nativeBufferAt(r.loadU32(20),288),polls)
            if (restored != 5) return p4CoordinatorReport(r,if (restored == 4) 7 else 9,restored)
        } else if (step == 5 || step == 7 || step == 10) {
            if (step == 7 && r.loadU32(48) != 0 && r.loadU32(52) == 0) {
                val closed=p4CoordinatorPolicyClose(nativeBufferAt(r.loadU32(48),388))
                if (closed != 8) return p4CoordinatorReport(r,9,closed)
                r.storeU32(52,1)
            }
            if (step == 7 && !globalPolicyRecovered) return p4CoordinatorReport(r,7,7)
            val changed=esp32p4SleepSmpAdvanceOwned(smp,generation,if (step == 5) 7 else if (step == 7) 8 else 9,polls,true)
            if (changed.status() != 1) return p4CoordinatorReport(r,if (changed.status() == 3) 7 else 9,changed.status())
        } else if (step == 6 && (!abort || cpu.loadU32(0) != 0)) {
            val restored=p4CoordinatorCpu(cpu)
            if (restored != 8) return p4CoordinatorReport(r,9,restored)
        } else if (step == 8) {
            if (state.phase(1-r.loadU32(40)) != 4 && !(abort && state.phase(1-r.loadU32(40)) == 0)) return p4CoordinatorReport(r,7,8)
        } else if (step == 9 && (!abort || nativeBufferAt(r.loadU32(32),24).loadU32(0) != 0)) {
            val closed=p4CoordinatorRoute(nativeBufferAt(r.loadU32(32),24))
            if (closed != 5) return p4CoordinatorReport(r,9,closed)
        } else if (step == 11) {
            if (state.stage() != 0) return p4CoordinatorReport(r,7,11)
        }
        r.storeU32(4,step+1)
    }
    return p4CoordinatorReport(r,r.loadU32(8),0)
}
