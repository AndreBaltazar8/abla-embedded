import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRtcInitializationOpaqueCallers(): bool {
    if (!exportFunction("esp32RtcInit", "rtc_init")) return false
    if (!exportFunction("esp32RtcVddsdioGetConfig", "rtc_vddsdio_get_config")) return false
    if (!exportFunction("esp32RtcVddsdioSetConfig", "rtc_vddsdio_set_config")) return false
    true
}
