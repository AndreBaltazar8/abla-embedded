import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSleepGpioOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspSleepGpioPupdConfigWorkaroundApply", "esp_sleep_gpio_pupd_config_workaround_apply")) return false
    if (!exportFunction("esp32RecoveredEspSleepGpioPupdConfigWorkaroundUnapply", "esp_sleep_gpio_pupd_config_workaround_unapply")) return false
    if (!internalFunction("esp32RecoveredEspSleepConfigGpioIsolate", "esp_sleep_config_gpio_isolate")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableGpioSwitch", "esp_sleep_enable_gpio_switch")) return false
    if (!exportFunction("esp32RecoveredEspSleepIsolateDigitalGpio", "esp_sleep_isolate_digital_gpio")) return false
    if (!exportFunction("esp32RecoveredEspDeepSleepWakeupIoReset", "esp_deep_sleep_wakeup_io_reset")) return false
    true
}
