import "./retention_descriptor_p4.ab"
// All19 nodes of upstream P4 systimer_regs_retention, in exact order.
// Pure configuration, not live timer access. Caller assembles entry0 with
// bounded PAU WAIT policy, retained storage and both timer users excluded.
// This plan uses upstream target policy: target0/1 periodic, target2 one-shot.
// Do not use unchanged for an application with different comparator roles.
// Backup latches both counters before copying; restore writes their LOAD
// registers (not read-only VALUE registers), then triggers the hardware loads.
fun esp32p4RetentionSystimerWords(node: int): int =
    if (node == 2 || node == 6) 2 else if (node == 8) 9 else if (node == 17 || node == 18) 1 else 0
fun p4RetentionSystimerOffset(node: int): int =
    if (node <= 1) 4 else if (node == 2) 0x40 else if (node == 3) 0x5c else if (node <= 5) 8 else if (node == 6) 0x48 else if (node == 7) 0x60 else
    if (node == 8) 0x1c else if (node <= 11) 0x50+(node-9)*4 else if (node <= 16) 0x34+((node-12)/2)*4 else if (node == 17) 0 else 0x64
trusted fun esp32p4RetentionSystimerConfig(c: NativeBuffer,node: int,storage: int,next: int): bool {
    if (node < 0 || node > 18 || !c.hasAddressRange(0,56) || (c.addressValue()&3) != 0 ||
        (next != 0 && !p4RetentionAddressSpan(next,4))) return false
    val words=esp32p4RetentionSystimerWords(node)
    if (words != 0) {
        if (!p4RetentionAddressSpan(storage,words*4) || (storage < c.addressValue()+56 && c.addressValue() < storage+words*4)) return false
    } else if (storage != 0) return false
    if (next != 0 && next < c.addressValue()+56 && c.addressValue() < next+4) return false
    var i=4
    while (i < 56) { c.storeU32(i,0);i=i+4 }
    val address=0x500e2000+p4RetentionSystimerOffset(node)
    c.storeU32(4,next);c.storeU32(20,address)
    var head=if (next == 0) 0x80000000 else 0
    if (words != 0) {
        head=head|words
        c.storeU32(24,if (node == 2) 0x500e200c else if (node == 6) 0x500e2014 else address)
        c.storeU32(28,storage)
    } else {
        val waiting=node == 1 || node == 5
        val backupOnly=node == 0 || node == 1 || node == 4 || node == 5
        val mask=if (waiting) 0x20000000 else if (node == 0 || node == 4 || node >= 12) 0x40000000 else 1
        val value=if (node == 12 || node == 14 || node == 16) 0 else mask
        head=head|(if (waiting) 0x30000 else 0x20000)|(if (backupOnly) 0x20000000 else 0x40000000)
        c.storeU32(48,value);c.storeU32(52,mask)
    }
    c.storeU32(0,head);return true
}
