import "./sleep_cycle_c5_sequence.ab"
import "./sleep_measured_periods_c5.ab"
//1024B owned measured lifecycle: tag0,state4,stage8,slow samples12,
// fast samples16,polls20,failing stage24/child status28,request68@32,
// optional retained memory-context address100,
// slow calibration64@104,fast64@168,actual cycle792@232.
//1complete2invalid3pending4aborted5chip suspended6unsupported chip.
//5/6 preserve outer pending ownership and inner cache-off state, not abort.
// Stages0slow1fast2bind/start3cycle.
// In addition to cycle prerequisites, caller owns/discards previous TIMG0
// calibration, has stable powered RC_FAST/RTC_SLOW/XTAL and enabled TG0 bus.
// Calibration runs cache-on; after stage3 pending may have cache suspended.
// Keep caller/stack/record retained and all exclusions until terminal result.
// Request is copied once, measured words replace its supplied periods. Failure
// metadata is wrapper stage1/2calibration,3binding,4cycle; actual sleep outcome
// remains at cycle+12 (244). Never remeasure or issue sleep twice on retries.
@section(".iram1.abla.c5MeasuredCycleResult")
trusted fun c5MeasuredCycleResult(record: NativeBuffer,result: int): int {
    if (result == 5 || result == 6) return result
    if (result == 1) { c5SleepRecordWrite(record,4,1);return 1 }
    if (result == 4 || (result == 2 && c5SleepRecordRead(record,232) == 0)) {
        c5SleepRecordWrite(record,24,4);c5SleepRecordWrite(record,28,result)
        c5SleepRecordWrite(record,4,4);return 4
    }
    return 3
}
// Structurally cache-off-safe retry shared by measured compositions. Unlike
// general Continue it cannot reach the calibration/profile construction path.
@section(".iram1.abla.c5MeasuredAfterCalibration")
trusted fun esp32C5SleepMeasuredAfterCalibrationOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,1024) || (record.addressValue()&3) != 0 ||
        c5SleepRecordRead(record,0) != 0x434d4331 || c5SleepRecordRead(record,8) != 3) return 2
    if (c5SleepRecordRead(record,4) == 1) return 1
    if (c5SleepRecordRead(record,4) == 4) return 4
    if (c5SleepRecordRead(record,4) != 3) return 2
    val result=esp32C5SleepCycleContinueOwned(nativeBufferAt(record.addressValue()+232,792),true)
    return c5MeasuredCycleResult(record,result)
}
@section(".iram1.abla.c5MeasuredCycleAdvance")
trusted fun c5MeasuredCycleAdvance(record: NativeBuffer): int {
    val base=record.addressValue();val polls=c5SleepRecordRead(record,20)
    if (c5SleepRecordRead(record,8) == 0) {
        val result=esp32C5ClockCalibrateOwned(nativeBufferAt(base+104,64),0,c5SleepRecordRead(record,12),true,polls)
        if (result != 1) {
            c5SleepRecordWrite(record,24,1);c5SleepRecordWrite(record,28,result)
            if (result == 5 || (result == 2 && c5SleepRecordRead(record,104) == 0)) {
                c5SleepRecordWrite(record,4,4);return 4
            }
            return 3
        }
        c5SleepRecordWrite(record,8,1)
    }
    if (c5SleepRecordRead(record,8) == 1) {
        val result=esp32C5ClockCalibrateOwned(nativeBufferAt(base+168,64),4,c5SleepRecordRead(record,16),true,polls)
        if (result != 1) {
            c5SleepRecordWrite(record,24,2);c5SleepRecordWrite(record,28,result)
            if (result == 5 || (result == 2 && c5SleepRecordRead(record,168) == 0)) {
                c5SleepRecordWrite(record,4,4);return 4
            }
            return 3
        }
        c5SleepRecordWrite(record,8,2)
    }
    if (!esp32C5SleepMeasuredPeriodsOwned(nativeBufferAt(base+32,68),nativeBufferAt(base+104,64),nativeBufferAt(base+168,64),true)) {
        c5SleepRecordWrite(record,24,3);c5SleepRecordWrite(record,28,2);c5SleepRecordWrite(record,4,4);return 4
    }
    c5SleepRecordWrite(record,24,0);c5SleepRecordWrite(record,28,0)
    c5SleepRecordWrite(record,8,3)
    val result=c5SleepCycleBeginContextOwned(nativeBufferAt(base+232,792),nativeBufferAt(base+32,68),true,c5SleepRecordRead(record,100))
    c5MeasuredCycleResult(record,result)
}
@section(".iram1.abla.c5MeasuredCycleContinue")
trusted fun esp32C5SleepMeasuredContinueOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,1024) || (record.addressValue()&3) != 0 ||
        c5SleepRecordRead(record,0) != 0x434d4331) return 2
    // Volatile observations keep cache-off retry dispatch free of flash tables.
    if (c5SleepRecordRead(record,4) == 1) return 1
    if (c5SleepRecordRead(record,4) == 4) return 4
    if (c5SleepRecordRead(record,4) != 3) return 2
    if (c5SleepRecordRead(record,8) == 3) {
        val result=esp32C5SleepCycleContinueOwned(nativeBufferAt(record.addressValue()+232,792),true)
        return c5MeasuredCycleResult(record,result)
    }
    if (c5SleepRecordRead(record,8) > 2) return 2
    c5MeasuredCycleAdvance(record)
}
@section(".iram1.abla.c5MeasuredCycleBegin")
trusted fun c5SleepMeasuredBeginContextOwned(record: NativeBuffer,request: NativeBuffer,slowCycles: int,fastCycles: int,exclusiveReady: bool,memoryContext: int): int {
    if (!exclusiveReady || !record.hasAddressRange(0,1024) || (record.addressValue()&3) != 0 ||
        c5SleepRecordRead(record,0) != 0 || !c5SleepCycleRequestValid(request,false) ||
        slowCycles < 1 || slowCycles >= 32767 || fastCycles < 32 || fastCycles > 1048512) return 2
    val base=record.addressValue();val input=request.addressValue()
    if (base < input+68 && input < base+1024) return 2
    var offset=0
    while (offset < 68) { c5SleepRecordWrite(record,32+offset,request.loadU32(offset));offset=offset+4 }
    c5SleepRecordWrite(record,12,slowCycles);c5SleepRecordWrite(record,16,fastCycles)
    c5SleepRecordWrite(record,20,request.loadU32(40));c5SleepRecordWrite(record,24,0);c5SleepRecordWrite(record,28,0)
    c5SleepRecordWrite(record,100,memoryContext);
    c5SleepRecordWrite(record,104,0);c5SleepRecordWrite(record,168,0);c5SleepRecordWrite(record,232,0)
    c5SleepRecordWrite(record,244,-4);c5SleepRecordWrite(record,8,0)
    c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,0,0x434d4331)
    c5MeasuredCycleAdvance(record)
}
@section(".iram1.abla.c5MeasuredCycleBeginPlain")
trusted fun esp32C5SleepMeasuredBeginOwned(record: NativeBuffer,request: NativeBuffer,slowCycles: int,fastCycles: int,exclusiveReady: bool): int =
    c5SleepMeasuredBeginContextOwned(record,request,slowCycles,fastCycles,exclusiveReady,0)
