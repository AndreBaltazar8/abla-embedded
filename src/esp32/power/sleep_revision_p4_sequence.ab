import "../analog/register_p4_sequence.ab"
// pmu_sleep_finish uses !ESP_CHIP_REV_ABOVE(revision,1): revision0 ONLY.
// Caller owns pinned analog160MHz/both masters, excludes affected PLL users,
// and keeps HP root on XTAL until this finishes. Run AFTER memory restoration
// but BEFORE restoring the application's CPU-frequency configuration.
// Sets revision0 wake defaults CPLL400MHz/SYSPLL480MHz, not prior frequencies.
// No rollback of the required workaround; partial failure retains ownership
// and can retry with consumers still quiescent. No ROM/opaque implementation.
// 1done/not-needed2invalid3clock-prerequisite4analog (stage8,error16).
trusted fun p4SleepRevisionByte(block: int,value: int,polls: int): int {
    val written=p4AnalogRegisterOwned(block,3,value,true,polls)
    if ((written&255) != 1) return written&255
    val read=p4AnalogRegisterOwned(block,3,0,false,polls)
    if ((read&255) != 1) return read&255
    return if (((read>>>8)&255) == value) 1 else 7
}
trusted fun esp32p4SleepRevisionFinishOwned(revision: int,polls: int,exclusiveXtal: bool): int {
    if (!exclusiveXtal || revision < 0 || revision > 399 || polls < 1 || polls > 1000000) return 2
    if (revision != 0) return 1
    if (!p4SleepRevisionXtalReady() || !p4AnalogClockReady() || !p4AnalogWaitIdle(0,polls) || !p4AnalogWaitIdle(4,polls)) return 3
    var result=p4SleepRevisionByte(0x67,6,polls)
    if (result != 1) return 260|(result<<16)
    result=p4SleepRevisionByte(0x66,8,polls)
    return if (result == 1) 1 else 516|(result<<16)
}
