import "./sleep_cache_p4_sequence.ab"
// FINAL request primitive, not a complete sleep API. Caller has configured
// PMU/wake sources, retention, revision workarounds, PSRAM/PLL/rails and resume
// path; both CPU and stack/code remain accessible on return. Excludes all
// competing CPUs/IRQs/DMA/cache users; dirty backing memory stays accessible.
// Follow mode-specific resume ordering: active pad selection precedes eFuse
// reload/MPLL recovery in light sleep; dedicated PSRAM holds and ownership
// remain retained until their power/clock recovery finishes.
// Deep sleep normally resets rather than returning. A returned event is NOT
// evidence the chip physically slept or the complete wake path is restored.
// No status acknowledgment here: stale events are rejected before mutation.
// 1wake observed2reject observed3both4invalid/unconfigured5stale-event
// 6cache failure (cache result high8),7uncertain/no event: retain ownership.
trusted fun esp32p4SleepRequestPreparedOwned(cachePolls: int,eventPolls: int,exclusivePrepared: bool): int {
    if (!exclusivePrepared || cachePolls < 1 || cachePolls > 1000000 || eventPolls < 1 || eventPolls > 1000000) return 4
    if ((p4SleepRequestRead(296)&u32(0x7fffffff)) == u32(0)) return 4
    if ((p4SleepRequestRead(356)&u32(0xc0000000)) != u32(0)) return 5
    val clean=esp32p4SleepCacheWritebackOwned(cachePolls,true)
    if (clean != 1) return 6|(clean<<8)
    // Exact WT writes: never replay unrelated hold/reset bits via RMW.
    p4SleepRequestWrite(228,u32(0x04000000))
    p4SleepCacheFence()
    p4SleepRequestWrite(288,u32(0x80000000))
    var remaining=u32(eventPolls)
    while (remaining != u32(0)) {
        val events=p4SleepRequestRead(356)>>u32(30)
        if (events != u32(0)) return if (events == u32(1)) 2 else if (events == u32(2)) 1 else 3
        remaining=remaining-u32(1)
    }
    return 7
}
