// ESP-IDF v6.0.2 esp32s3 rtc_sleep_get_default_config, expressed as a scalar
// policy rather than a C bitfield ABI. Input bits match RTC_SLEEP_PD_* flags.
// This policy is not permission to cut power: the entry owner must coordinate
// flash, other CPU, radio, retention, wake sources and RTC pad ownership.
type Esp32S3SleepPolicy = int
// Scalar casts are public; a tag alone must not authorize arbitrary bias or
// domain settings. Accept only the canonical policy derived from valid flags.
fun Esp32S3SleepPolicy.valid(): bool = (this & (1<<39)) != 0 &&
    this == esp32S3SleepPolicy(this.flags())
fun Esp32S3SleepPolicy.flags(): int = this & 0xFFFFF
fun Esp32S3SleepPolicy.digitalBias(): int = (this>>>20) & 31
fun Esp32S3SleepPolicy.rtcBias(): int = (this>>>25) & 31
fun Esp32S3SleepPolicy.attenuation(): int = (this>>>30) & 15
fun Esp32S3SleepPolicy.regulatorForced(): bool = (this & (1<<34)) != 0
fun Esp32S3SleepPolicy.monitorBiasSleep(): bool = (this & (1<<35)) != 0
fun Esp32S3SleepPolicy.biasSleep(): bool = (this & (1<<36)) != 0
fun Esp32S3SleepPolicy.monitorCurrentDown(): bool = (this & (1<<37)) != 0
fun Esp32S3SleepPolicy.sleepCurrentDown(): bool = (this & (1<<38)) != 0

fun esp32S3SleepPolicy(flags: int): Esp32S3SleepPolicy {
    if (flags < 0 || (flags & ~0xF0F7F) != 0) return Esp32S3SleepPolicy(0)
    val deep=(flags & 1) != 0
    val xtalOff=(flags & 2048) != 0
    val rcOff=(flags & 1024) != 0
    val monitor=(flags & 0x20000) != 0
    if (deep && !xtalOff) return Esp32S3SleepPolicy(0)
    var dig=0
    var attenuation=0
    var regulator=true
    if (deep) {
        if (monitor || !rcOff) attenuation=0
        else if ((flags & 0x40000) != 0) attenuation=14
        else { attenuation=15; regulator=false }
    } else {
        if ((flags & 0x10000) != 0 || !xtalOff) dig=23
        else if (!rcOff) dig=0
        else { attenuation=5; dig=5 }
    }
    Esp32S3SleepPolicy(flags | (dig<<20) | (23<<25) | (attenuation<<30) |
        (if (regulator) 1<<34 else 0) | (if (xtalOff) (1<<35) | (1<<36) | (1<<38) else 0) |
        (if (xtalOff && !monitor) 1<<37 else 0) | (1<<39))
}
