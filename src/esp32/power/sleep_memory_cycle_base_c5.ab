import "./sleep_cycle_common_c5.ab"
import "./sleep_memory_recovery_c5.ab"
import "../mspi_cpu_guard_c5.ab"
import "../mspi_idle_c5_sequence.ab"
@inline
trusted fun c5SleepMemoryPrepareBase(record: NativeBuffer): int {
    val context=c5SleepRecordRead(record,108)
    if (context != 0) {
        // Check before time/UART/CPU preparation claims any hardware. The
        // original CPU plan is captured again by preparation under the same
        // exclusion, with no intervening CPU writes here.
        val original=esp32C5CpuClockCaptureOwned(true)
        val before=c5CpuClockMHz(original)
        val xtal=(original>>18)&127
        if (!esp32C5MspiCpuChangeSafeOwned(before,xtal,c5SleepRecordRead(nativeBufferAt(context,496),8),true)) return 2
    }
    c5SleepCyclePrepareBase(record)
}
@inline
trusted fun c5SleepMemoryRecoveryBase(record: NativeBuffer): int {
    val base=record.addressValue();val recovery=nativeBufferAt(base+664,128)
    if (c5SleepRecordRead(record,664) != 0) return esp32C5SleepMemoryRecoveryContinueOwned(recovery,true)
    val context=c5SleepRecordRead(record,108)
    val memoryAddress=if (context != 0 && c5SleepRecordRead(nativeBufferAt(context,496),48) != 0) context+48 else 0
    // Memory admission can fail before the entry session is claimed.
    val entryAddress=if (c5SleepRecordRead(record,632) != 0) base+632 else 0
    val result=esp32C5SleepRecoveryBeginOwned(recovery,nativeBufferAt(base+304,304),base+608,C5CpuClock(c5SleepRecordRead(record,204)),
        (c5SleepRecordRead(record,72)&8) != 0,int(i32(c5SleepRecordRead(record,12))),false,0,
        c5SleepRecordRead(record,28)|(c5SleepRecordRead(record,32)<<32),c5SleepRecordRead(record,148),true,entryAddress,base+152,memoryAddress)
    if (result != 3) return result
    esp32C5SleepMemoryRecoveryContinueOwned(recovery,true)
}
