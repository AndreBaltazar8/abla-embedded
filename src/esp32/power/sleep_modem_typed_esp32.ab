import "abla/unsafe/memory"
import "abla/unsafe/native"

// ESP32 has no PMU modem-state retention path, so the first four APIs reduce
// to their compile-time target policy. Callback ownership stays in internal
// Abla storage and can be pruned with its users from the monolithic graph.
val esp32LightSleepOverheadCallbacks = nativeStaticAllocate(8)
val esp32LightSleepDefaultParametersCallback = nativeStaticAllocate(4)

@inline
trusted fun esp32SleepModemLoad(address: int): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(address))
)

@inline
trusted fun esp32SleepModemStore(address: int, value: u32): void =
    ablaUnsafeStoreU32(
        nativePointerFromAddress(address),
        int(value)
    )

fun esp32ModemDomainPowerDownAllowed(): u32 = u32(0)

fun esp32SleepModemRejectTriggers(): u32 = u32(0)

@section(".iram1.abla.esp32SleepModemSkipLightSleep")
fun esp32SleepModemSkipLightSleep(): u32 = u32(0)

fun esp32SleepModemConfigure(
    maximumFrequencyMhz: u32,
    minimumFrequencyMhz: u32,
    lightSleepEnabled: u32
): u32 = u32(0)

trusted fun esp32RegisterLightSleepOverheadCallback(callback: u32): u32 {
    var index = 0
    while (index < 2) {
        val address = esp32LightSleepOverheadCallbacks + index * 4
        val present = esp32SleepModemLoad(address)
        if (present == callback) return u32(0)
        if (present == u32(0)) {
            esp32SleepModemStore(address, callback)
            return u32(0)
        }
        index = index + 1
    }
    return u32(0x101)
}

trusted fun esp32UnregisterLightSleepOverheadCallback(callback: u32): u32 {
    var index = 0
    while (index < 2) {
        val address = esp32LightSleepOverheadCallbacks + index * 4
        if (esp32SleepModemLoad(address) == callback) {
            esp32SleepModemStore(address, u32(0))
            return u32(0)
        }
        index = index + 1
    }
    return u32(0x103)
}

trusted fun esp32InformLightSleepOverhead(timeMicroseconds: u32): void {
    var index = 0
    while (index < 2) {
        val callback = esp32SleepModemLoad(
            esp32LightSleepOverheadCallbacks + index * 4
        )
        if (callback != u32(0)) {
            callNativeVoidI32(int(callback), int(timeMicroseconds))
        }
        index = index + 1
    }
}

trusted fun esp32RegisterLightSleepDefaultParametersCallback(
    callback: u32
): void {
    if (esp32SleepModemLoad(
        esp32LightSleepDefaultParametersCallback
    ) == u32(0)) {
        esp32SleepModemStore(
            esp32LightSleepDefaultParametersCallback,
            callback
        )
    }
}

trusted fun esp32UnregisterLightSleepDefaultParametersCallback(): void {
    if (esp32SleepModemLoad(
        esp32LightSleepDefaultParametersCallback
    ) != u32(0)) {
        esp32SleepModemStore(
            esp32LightSleepDefaultParametersCallback,
            u32(0)
        )
    }
}
