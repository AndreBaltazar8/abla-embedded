import "../../runtime/rtc_time48.ab"
import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
fun p4SleepProfileTimingLimit(i: int): int = if (i == 2 || i >= 8) 65535 else if (i >= 4) 511 else 255
// IDF P4 machine constants, in microseconds. TOP retention requires the
// extra685us regulator/REGDMA wait. Do not infer this from deep vs light mode.
fun p4SleepTimingDefaultMicroseconds(i: int,topPoweredDown: bool): int = if (i < 2) 450 else
    if (i == 2) (if (topPoweredDown) 260 else 945) else if (i == 3) 154 else
    if (i == 5) 26 else if (i < 8) 2 else if (i == 8) 250 else 50
fun p4SleepTimingCalibratedValue(i: int,slowPeriodQ19: int,fastPeriodQ19: int,topPoweredDown: bool,xtalPoweredInHpSleep: bool): int =
    rtc48TicksForMicroseconds(p4SleepTimingDefaultMicroseconds(i,topPoweredDown),
        if (i < 4 || (i == 8 && xtalPoweredInHpSleep)) slowPeriodQ19 else fastPeriodQ19)
// Output40B follows the profile's ten timing words. Explicit measured periods
// Q19, not guessed oscillator rates. Floor rounding matches upstream. Reject
// values that cannot fit hardware instead of truncating. Two passes leave
// output untouched on failure; caller owns the output throughout. No MMIO.
trusted fun esp32p4SleepTimingCalibrated(output: NativeBuffer,slowPeriodQ19: int,fastPeriodQ19: int,
    topPoweredDown: bool,xtalPoweredInHpSleep: bool): bool {
    if (!output.hasAddressRange(0,40) || (output.addressValue()&3) != 0 || slowPeriodQ19 <= 0 || fastPeriodQ19 <= 0 ||
        slowPeriodQ19 > 0xffffffff || fastPeriodQ19 > 0xffffffff) return false
    var i=0
    while (i < 10) {
        val value=p4SleepTimingCalibratedValue(i,slowPeriodQ19,fastPeriodQ19,topPoweredDown,xtalPoweredInHpSleep)
        if (value < 0 || value > p4SleepProfileTimingLimit(i)) return false
        i=i+1
    }
    i=0
    while (i < 10) {
        output.storeU32(i*4,p4SleepTimingCalibratedValue(i,slowPeriodQ19,fastPeriodQ19,topPoweredDown,xtalPoweredInHpSleep));i=i+1
    }
    return true
}
