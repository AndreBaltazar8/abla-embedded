import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPeripheralControlOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredPeriphRccEnter", "periph_rcc_enter")) return false
    if (!exportFunction("esp32RecoveredPeriphRccExit", "periph_rcc_exit")) return false
    if (!exportFunction("esp32RecoveredPeriphRccAcquireEnter", "periph_rcc_acquire_enter")) return false
    if (!exportFunction("esp32RecoveredPeriphRccAcquireExit", "periph_rcc_acquire_exit")) return false
    if (!exportFunction("esp32RecoveredPeriphRccReleaseEnter", "periph_rcc_release_enter")) return false
    if (!exportFunction("esp32RecoveredPeriphRccReleaseExit", "periph_rcc_release_exit")) return false
    if (!exportFunction("esp32RecoveredPeriphModuleEnable", "periph_module_enable")) return false
    if (!internalFunction("esp32RecoveredPeriphModuleDisable", "periph_module_disable")) return false
    if (!exportFunction("esp32RecoveredPeriphModuleReset", "periph_module_reset")) return false
    if (!exportFunction("esp32RecoveredWifiBtCommonModuleEnable", "wifi_bt_common_module_enable")) return false
    if (!exportFunction("esp32RecoveredWifiBtCommonModuleDisable", "wifi_bt_common_module_disable")) return false
    if (!exportFunction("esp32RecoveredWifiModuleEnable", "wifi_module_enable")) return false
    if (!exportFunction("esp32RecoveredWifiModuleDisable", "wifi_module_disable")) return false
    if (!exportFunction("esp32RecoveredPhyModuleEnable", "phy_module_enable")) return false
    if (!exportFunction("esp32RecoveredPhyModuleDisable", "phy_module_disable")) return false
    if (!exportFunction("esp32RecoveredPhyModuleHasClockBits", "phy_module_has_clock_bits")) return false
    if (!internalFunction("esp32RecoveredCoexModuleEnable", "coex_module_enable")) return false
    if (!internalFunction("esp32RecoveredCoexModuleDisable", "coex_module_disable")) return false
    true
}
