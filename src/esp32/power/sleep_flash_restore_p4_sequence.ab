import "./sleep_flash_rev3_p4_sequence.ab"
import "./retention_extra_p4_sequence.ab"
import "./sleep_flash_hold_p4_sequence.ab"
// Revision300 TOP wake: actual MSPI workaround -> entry3 restore -> release
// temporary PAU control/AON lease. Never resumes cache or releases pin holds.
// Caller owns the installed graph AND a completed backup, published retained
// descriptors/backing, clocks/timeouts, RAM code/stack/record and exclusion of
// every other MSPI/cache/PAU/CPU user throughout; all wake power prerequisites
// must already hold. Not a substitute for the full sleep orchestration.
// Record80B: magic,state,lastResult,detail,entry3,reserved,workaround32,extra24.
// States1workaround2setup3issued4cleanup5done6engineFault.
// Results1done2invalid3workaround4setup5pending6engineFault7cleanup.
// Timeout retains ownership. Engine faults latch until independent recovery;
// never automatically reset the engine, clear errors, or assume graph valid.
trusted fun esp32p4SleepFlashRestoreContinueOwned(r: NativeBuffer,polls: int,exclusivePublishedWake: bool): int {
    if (!exclusivePublishedWake || polls < 1 || polls > 1000000 || !r.hasAddressRange(0,80) ||
        (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50344652 || r.loadU32(4) < 1 || r.loadU32(4) > 6) return 2
    if (r.loadU32(4) == 5) return 1
    if (r.loadU32(4) == 6) return 6
    // Caller retains the flash hold lease across every retry. Do not proceed
    // with reset, mapping changes or restore after an unexpected hold loss.
    if ((p4SleepFlashHoldRead()&63) != 63) return 4
    val workaround=nativeBufferAt(r.addressValue()+24,32)
    val extra=nativeBufferAt(r.addressValue()+56,24)
    if (r.loadU32(4) == 1) {
        val result=if (workaround.loadU32(0) == 0) esp32p4SleepFlashRev3BeginOwned(workaround,300,true) else esp32p4SleepFlashRev3ContinueOwned(workaround,true)
        if (result != 1) { r.storeU32(8,3);r.storeU32(12,result);return 3 }
        r.storeU32(4,2)
    }
    if (r.loadU32(4) == 2) {
        if (!p4RetentionClockReady() || int(p4RetentionPauRead(24)) != r.loadU32(16)) { r.storeU32(8,4);r.storeU32(12,4);return 4 }
        // A failed setup never issued START. Restore its snapshot before
        // retrying setup; failed cleanup retains the existing child token.
        if (extra.loadU32(0) != 0) {
            val closed=esp32p4RetentionExtraCloseOwned(extra,true)
            if (closed != 8) { r.storeU32(8,7);r.storeU32(12,closed);return 7 }
            var i=0
            while (i < 24) { extra.storeU32(i,0);i=i+4 }
        }
        val result=esp32p4RetentionExtraBeginOwned(extra,false,true)
        if (result != 1) { r.storeU32(8,4);r.storeU32(12,result);return 4 }
        r.storeU32(4,3)
    }
    if (r.loadU32(4) == 3) {
        val result=esp32p4RetentionExtraPollOwned(extra,polls,true)
        if (result != 1) {
            r.storeU32(12,extra.loadU32(16))
            if (result == 7) { r.storeU32(4,6);r.storeU32(8,6);return 6 }
            r.storeU32(8,5);return 5
        }
        r.storeU32(4,4)
    }
    val closed=esp32p4RetentionExtraCloseOwned(extra,true)
    if (closed != 8) { r.storeU32(8,7);r.storeU32(12,closed);return 7 }
    r.storeU32(4,5);r.storeU32(8,1);r.storeU32(12,0);return 1
}
trusted fun esp32p4SleepFlashRestoreBeginOwned(r: NativeBuffer,minimumRevision: int,polls: int,exclusivePublishedWake: bool): int {
    if (!exclusivePublishedWake || minimumRevision != 300 || polls < 1 || polls > 1000000 || !r.hasAddressRange(0,80) ||
        (r.addressValue()&3) != 0 || r.loadU32(0) != 0) return 2
    if (!p4RetentionClockReady()) return 4
    if ((p4SleepFlashHoldRead()&63) != 63) return 4
    val entry=int(p4RetentionPauRead(24))
    if (entry == 0 || !p4RetentionLinkAddressValid(entry) || (entry < r.addressValue()+80 && r.addressValue() < entry+4) ||
        (p4RetentionPauRead(0)&u32(7)) != u32(0) || (p4RetentionPauRead(52)&u32(2)) != u32(0)) return 4
    var i=8
    while (i < 80) { r.storeU32(i,0);i=i+4 }
    r.storeU32(0,0x50344652);r.storeU32(4,1);r.storeU32(16,entry)
    return esp32p4SleepFlashRestoreContinueOwned(r,polls,true)
}
