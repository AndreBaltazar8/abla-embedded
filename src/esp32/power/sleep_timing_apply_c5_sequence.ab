import "./sleep_record_c5.ab"
import "./sleep_timing_c5.ab"
// Exclusive PMU timing lease48B:tag0,status4,original7words@8,
// applied mask36,reverse cleanup index40,owns modem wait44. No sleep/trigger writes.
// Status1applied2input3partialwrite4closed. All14 values validated before MMIO.
@section(".iram1.abla.c5SleepTimingOffset")
fun c5SleepTimingOffset(index: int): int = if (index == 0) 0x130 else if (index == 1) 0x140 else
    if (index == 2) 0x138 else if (index == 3) 0xec else if (index == 4) 0xf0 else if (index == 5) 0xf4 else 0x120
@section(".iram1.abla.c5SleepTimingMask")
fun c5SleepTimingMask(index: int): int = if (index == 0) 65535 else if (index == 1 || index == 4) 0xffff0000 else
    if (index == 2) 0xff000000 else if (index == 3) 0xffffc000 else 4294967295
trusted fun c5SleepTimingPacked(plan: NativeBuffer,index: int,inrushWorkaround: bool): int = if (index == 0)
    (plan.loadU32(0)<<8)|plan.loadU32(4) else if (index == 1) plan.loadU32(8)<<16 else if (index == 2) plan.loadU32(12)<<24 else
    if (index == 3) ((plan.loadU32(16)|(if (inrushWorkaround) 3 else 0))<<23)|(plan.loadU32(20)<<14) else
    if (index == 4) (plan.loadU32(24)<<23)|(plan.loadU32(28)<<16) else if (index == 5)
    plan.loadU32(40)|(plan.loadU32(44)<<8)|(plan.loadU32(32)<<16)|(plan.loadU32(36)<<24) else plan.loadU32(48)|(plan.loadU32(52)<<16)
@section(".iram1.abla.c5SleepTimingField")
@inline
trusted fun c5SleepTimingField(index: int,value: int,modem: bool = false): bool {
    val offset=c5SleepTimingOffset(index);val mask=c5SleepTimingMask(index)|(if (modem && index == 2) 1048575 else 0)
    val next=(c5SleepTimingRead(offset)&~mask)|(value&mask)
    c5SleepTimingWrite(offset,next)
    (c5SleepTimingRead(offset)&mask) == (value&mask)
}
@section(".iram1.abla.esp32C5SleepTimingStatus")
trusted fun esp32C5SleepTimingStatus(record: NativeBuffer): int = if (!record.hasAddressRange(0,48) || c5SleepRecordRead(record,0) != 0x43544d31) 2 else c5SleepRecordRead(record,4)
// inrushWorkaround is selected from actual chip revision (IDF's >v1.2 rule),
// not inferred from the timer calibration. Caller excludes all PMU writers.
trusted fun esp32C5SleepTimingApplyOwned(record: NativeBuffer,plan: NativeBuffer,inrushWorkaround: bool,exclusive: bool,modemWaitCycles: int = -1): int {
    if (!exclusive || modemWaitCycles < -1 || modemWaitCycles > 1048575 || !record.hasAddressRange(0,48) || !plan.hasAddressRange(0,56) ||
        (record.addressValue() < plan.addressValue()+56 && plan.addressValue() < record.addressValue()+48)) return 2
    if (c5SleepRecordRead(record,0) == 0x43544d31 && c5SleepRecordRead(record,4) != 4) return 2
    var i=0;while (i < 14) { if (plan.loadU32(i*4) > c5SleepTimingLimit(i)) return 2;i=i+1 }
    c5SleepRecordWrite(record,0,0x43544d31);c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,36,0);c5SleepRecordWrite(record,40,6);c5SleepRecordWrite(record,44,if (modemWaitCycles >= 0) 1 else 0)
    i=0;while (i < 7) { c5SleepRecordWrite(record,8+i*4,c5SleepTimingRead(c5SleepTimingOffset(i)));i=i+1 }
    i=0
    while (i < 7) {
        val value=c5SleepTimingPacked(plan,i,inrushWorkaround)|(if (i == 2 && modemWaitCycles >= 0) modemWaitCycles else 0)
        if (!c5SleepTimingField(i,value,modemWaitCycles >= 0)) return 3
        c5SleepRecordWrite(record,36,c5SleepRecordRead(record,36)|int(u32(1)<<u32(i)));i=i+1
    }
    c5SleepRecordWrite(record,4,1)
    1
}
// Explicit resumable restoration; partial application cannot silently retry
// begin and overwrite original snapshots. Caller retains power/ownership.
@section(".iram1.abla.esp32C5SleepTimingCloseOwned")
trusted fun esp32C5SleepTimingCloseOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive) return 2
    val status=esp32C5SleepTimingStatus(record)
    if (status == 2 || status == 4) return status
    var remaining=c5SleepRecordRead(record,40)
    if (remaining > 6) return 2
    // Fixed reverse stages keep offset/mask selection constant: no flash jump tables.
    if (remaining >= 6) {
        if (!c5SleepTimingField(6,c5SleepRecordRead(record,32),c5SleepRecordRead(record,44) != 0)) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,5)
    }
    if (remaining >= 5) {
        if (!c5SleepTimingField(5,c5SleepRecordRead(record,28),c5SleepRecordRead(record,44) != 0)) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,4)
    }
    if (remaining >= 4) {
        if (!c5SleepTimingField(4,c5SleepRecordRead(record,24),c5SleepRecordRead(record,44) != 0)) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,3)
    }
    if (remaining >= 3) {
        if (!c5SleepTimingField(3,c5SleepRecordRead(record,20),c5SleepRecordRead(record,44) != 0)) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,2)
    }
    if (remaining >= 2) {
        if (!c5SleepTimingField(2,c5SleepRecordRead(record,16),c5SleepRecordRead(record,44) != 0)) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,1)
    }
    if (remaining >= 1) {
        if (!c5SleepTimingField(1,c5SleepRecordRead(record,12),c5SleepRecordRead(record,44) != 0)) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,40,0)
    }
    if (remaining >= 0) {
        if (!c5SleepTimingField(0,c5SleepRecordRead(record,8),c5SleepRecordRead(record,44) != 0)) { c5SleepRecordWrite(record,4,3);return 3 }
    }
    c5SleepRecordWrite(record,4,4)
    4
}
