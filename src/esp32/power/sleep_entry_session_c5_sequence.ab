import "./sleep_entry_c5_sequence.ab"
import "./sleep_record_c5.ab"
//32B:tag0,state4,original wake8/reject12/modebit16,entry result20,
// reverse-cleanup stage24,reserved28. State1returned3cleanup pending4closed.
// Same retained-CPU entry prerequisites, plus exclusive mask/mode ownership
// through close. New wake/reject causes remain latched; only settings restore.
// Run returns actual entry outcome -3..1, or -4 invalid/reused record/noIO.
// Always close after an admitted run, even when entry failed before request.
@section(".iram1.abla.c5SleepEntrySessionRun")
trusted fun esp32C5SleepEntryRunOwned(record: NativeBuffer,wakeMask: u32,rejectMask: int,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,32) || wakeMask == u32(0) || rejectMask < 0 || rejectMask > 0x7fffffff) return -4
    if (c5SleepRecordRead(record,0) != 0) return -4
    c5SleepRecordWrite(record,8,c5SleepEntryRead(0x600b012c))
    c5SleepRecordWrite(record,12,c5SleepEntryRead(0x600b0128))
    c5SleepRecordWrite(record,16,c5SleepEntryRead(0x600b1020)&1)
    c5SleepRecordWrite(record,24,0);c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,0,0x43455331)
    val result=esp32C5LightSleepEnterOwned(wakeMask,rejectMask,true)
    c5SleepRecordWrite(record,20,result);c5SleepRecordWrite(record,4,1)
    result
}
//1/3 child state are live; 2invalid3pending4closed. Caller must ensure PMU is
// no longer transitioning before close; never call concurrently with Run.
@section(".iram1.abla.c5SleepEntrySessionClose")
trusted fun esp32C5SleepEntryCloseOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,32) || c5SleepRecordRead(record,0) != 0x43455331) return 2
    val status=c5SleepRecordRead(record,4)
    if (status == 4) return 4
    if ((status != 1 && status != 3) || c5SleepRecordRead(record,24) > 2) return 2
    val stage=c5SleepRecordRead(record,24)
    c5SleepRecordWrite(record,4,3)
    if (stage <= 0) {
        val saved=c5SleepRecordRead(record,8)
        c5SleepEntryWrite(0x600b012c,saved)
        if (c5SleepEntryRead(0x600b012c) != saved) return 3
        c5SleepRecordWrite(record,24,1)
    }
    if (stage <= 1) {
        val saved=c5SleepRecordRead(record,12)
        c5SleepEntryWrite(0x600b0128,saved)
        if (c5SleepEntryRead(0x600b0128) != saved) return 3
        c5SleepRecordWrite(record,24,2)
    }
    val bit=c5SleepRecordRead(record,16)
    c5SleepEntryWrite(0x600b1020,(c5SleepEntryRead(0x600b1020)&~1)|bit)
    if ((c5SleepEntryRead(0x600b1020)&1) != bit) return 3
    c5SleepRecordWrite(record,4,4)
    4
}
