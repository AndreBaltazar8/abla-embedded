import "abla/runtime/scalar"
// HP_SLEEP digital state only. Does not stall the current CPU, pause a live
// watchdog or assert an immediate pad hold. Caller excludes sleep transitions
// and immediate pad-sleep selection, owns GPIO2..5 sleep configuration and
// PMU globally, quiesces JTAG, and pins HP/LP IOMUX clocks and power.
// Includes P4 IDF JTAG leakage workaround when requesting LP hold: isolate
// sleep configuration only for pads2..5 still HP-owned in JTAG function0.
// Scalar snapshot: PMU6@8, four sleep-fields5@14, owned34, selected pads4@35.
type P4SleepDigital=int
fun P4SleepDigital.status(): int = this&255
fun P4SleepDigital.hasSnapshot(): bool = (this&(1<<34)) != 0
trusted fun p4SleepDigitalField(address: int,mask: u32,value: u32): bool {
    p4SleepDigitalWrite(address,(p4SleepDigitalRead(address)&~mask)|(value&mask))
    return (p4SleepDigitalRead(address)&mask) == (value&mask)
}
trusted fun p4SleepDigitalClocks(): bool =
    (p4SleepDigitalRead(0x500e6020)&u32(8)) != u32(0) && (p4SleepDigitalRead(0x5012b000)&u32(1)) != u32(0)
//1ready2invalid3clock4partialwrite5closed. Bits0UART,1LP-hold,2HP-hold,
// 3pad-sleep-select,4pause-watchdog,5CPU-stall; power-detect bypass untouched.
trusted fun esp32p4SleepDigitalOpenOwned(flags: int,exclusive: bool): P4SleepDigital {
    if (!exclusive || flags < 0 || flags > 63) return P4SleepDigital(2)
    if ((flags&2) != 0 && !p4SleepDigitalClocks()) return P4SleepDigital(3)
    var token=(1<<34)|(int((p4SleepDigitalRead(0x50115078)>>u32(24))&u32(63))<<8)
    var i=0
    if ((flags&2) != 0) {
        while (i < 4) {
            val pin=i+2
            val mux=p4SleepDigitalRead(0x500e1004+pin*4)
            if ((p4SleepDigitalRead(0x5012b008+pin*4)&u32(16)) == u32(0) && (mux&u32(0x7000)) == u32(0)) {
                token=token|(int(u32(1)<<u32(i))<<35)|(int((mux&u32(31))<<u32(i*5))<<14)
            }
            i=i+1
        }
    }
    i=0
    while (i < 4) {
        if ((u32(token>>>35)&(u32(1)<<u32(i))) != u32(0) && !p4SleepDigitalField(0x500e100c+i*4,u32(31),u32(2))) return P4SleepDigital(token|4)
        i=i+1
    }
    if (!p4SleepDigitalField(0x50115078,u32(0x3f000000),u32(flags)<<u32(24))) return P4SleepDigital(token|4)
    return P4SleepDigital(token|1)
}
trusted fun P4SleepDigital.closeOwned(exclusive: bool): P4SleepDigital {
    if (!exclusive || !this.hasSnapshot() || this.status() == 5) return this
    val token=this&(~255)
    if ((this&(15<<35)) != 0 && !p4SleepDigitalClocks()) return P4SleepDigital(token|3)
    var i=3
    while (i >= 0) {
        if ((u32(this>>>35)&(u32(1)<<u32(i))) != u32(0) && !p4SleepDigitalField(0x500e100c+i*4,u32(31),(u32(this>>>14)>>u32(i*5))&u32(31))) return P4SleepDigital(token|4)
        i=i-1
    }
    if (!p4SleepDigitalField(0x50115078,u32(0x3f000000),u32((this>>>8)&63)<<u32(24))) return P4SleepDigital(token|4)
    return P4SleepDigital(token|5)
}
