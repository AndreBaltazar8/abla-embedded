import "./wake_trigger_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4WakeTriggerRead")
trusted fun p4WakeTriggerReadHook(): u32 = u32(mmioLoadU32(0x50115128))
@export("p4WakeTriggerWrite")
trusted fun p4WakeTriggerWriteHook(value: u32): void { mmioStoreU32(0x50115128,int(value));return }
