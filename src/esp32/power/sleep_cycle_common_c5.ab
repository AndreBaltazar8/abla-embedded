import "./sleep_cycle_c5_sequence.ab"
import "./sleep_prepare_composition_c5.ab"
import "./sleep_recovery_composition_c5.ab"
// A previously armed timer can become late during flash qualification or
// GPIO waiting. Do not enter sleep against a stale comparator. Only call
// after command sessions finish; abandoning live SPI cleanup is unsafe.
@section(".iram1.abla.c5SleepCycleDeadline")
trusted fun c5SleepCycleDeadlineReady(record: NativeBuffer): bool {
    val now=esp32C5RtcTicksOwned(0,true)
    val deadline=c5SleepRecordRead(record,84)|(c5SleepRecordRead(record,88)<<32)
    val lead=c5SleepRecordRead(record,92)|(c5SleepRecordRead(record,96)<<32)
    if (rtc48TicksRemaining(now,deadline) >= lead) return true
    c5SleepRecordWrite(record,16,5);c5SleepRecordWrite(record,20,4)
    return false
}
@section(".iram1.abla.c5SleepCycleTimedEntry")
trusted fun c5SleepCycleTimedEntry(record: NativeBuffer): int {
    if (!c5SleepCycleDeadlineReady(record)) return -3
    return esp32C5SleepEntryRunOwned(nativeBufferAt(record.addressValue()+632,32),u32(c5SleepRecordRead(record,100)),c5SleepRecordRead(record,104),true)
}
@inline
trusted fun c5SleepCyclePrepareBase(record: NativeBuffer): int =
    esp32C5SleepPrepareOwned(nativeBufferAt(record.addressValue()+112,192),c5SleepRecordRead(record,52),c5SleepRecordRead(record,76),c5SleepRecordRead(record,80),(c5SleepRecordRead(record,72)&8) != 0,true)
// Called only before cache suspension; plan construction is allowed in flash.
trusted fun c5SleepCycleProfile(record: NativeBuffer): int {
    val flags=c5SleepRecordRead(record,72)
    var pvtBias=int(i32(c5SleepRecordRead(record,68)))
    if ((flags&8) != 0) {
        // IDF pmu_sleep_analog_init copies live PVT HP bias into HP_MODEM.
        // Our completed park owns that captured value; -1 means automatic,
        // not "skip the PVT voltage handoff". Reject conflicting overrides.
        if (c5SleepRecordRead(record,216) != 0x43505631 || c5SleepRecordRead(record,220) != 1) return 2
        val live=c5SleepRecordRead(record,224)
        if (live > 31 || (pvtBias != -1 && pvtBias != live)) return 2
        pvtBias=live
    }
    esp32C5SleepConfigApplyOwned(nativeBufferAt(record.addressValue()+304,304),C5SleepPower(c5SleepRecordRead(record,40)),u32(c5SleepRecordRead(record,44)),false,
        (flags&1) != 0,(flags&2) != 0,C5SleepCalibration(c5SleepRecordRead(record,48)),c5SleepRecordRead(record,52),c5SleepRecordRead(record,56),
        (flags&4) != 0,true,int(i32(c5SleepRecordRead(record,64))),pvtBias,c5SleepRecordRead(record,60))
}
@inline
trusted fun c5SleepCycleAlarm(record: NativeBuffer): int =
    esp32C5SleepAlarmBeginOwned(nativeBufferAt(record.addressValue()+608,24),c5SleepRecordRead(record,84)|(c5SleepRecordRead(record,88)<<32),c5SleepRecordRead(record,92)|(c5SleepRecordRead(record,96)<<32),true)
@inline
trusted fun c5SleepCycleProfileClose(record: NativeBuffer): int = esp32C5SleepConfigCloseOwned(record,true)
@inline
trusted fun c5SleepCycleAlarmClose(record: NativeBuffer): int = esp32C5SleepAlarmCloseOwned(record,true)
@inline
trusted fun c5SleepCyclePrepareCancel(record: NativeBuffer): int = esp32C5SleepPrepareCancelOwned(record,true)
@inline
trusted fun c5SleepCycleTake(record: NativeBuffer): bool = esp32C5SleepPrepareTakeOwned(record,true)
@inline
trusted fun c5SleepCycleCacheSuspend(): int = esp32C5CacheSuspendOwned()|0
