import "../../xtensa/assembly.ab"
import "../runtime/libc_abort_esp32.ab"
import "abla/unsafe/memory"

// Typed ESP32 watchdog HAL. wdt_hal_context_t is two 32-bit words: instance
// followed by the selected peripheral base. All peripheral operations are
// ordinary volatile LLVM accesses, allowing constant instance call sites to
// specialize away the RWDT/MWDT branch.

@inline
trusted fun esp32WdtContextLoad(context: u32, offset: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(context + offset)))
)

@inline
trusted fun esp32WdtContextStore(
    context: u32,
    offset: u32,
    value: u32
): void = ablaUnsafeStoreU32(
    nativePointerFromAddress(int(context + offset)),
    int(value)
)

@inline
trusted fun esp32WdtUpdate(
    address: u32,
    clearMask: u32,
    setMask: u32
): void {
    val current = xtensaDeviceLoadU32(address)
    xtensaDeviceStoreU32(address, (current & ~clearMask) | setMask)
}

@inline
trusted fun esp32WdtInstance(context: u32): u32 =
    esp32WdtContextLoad(context, u32(0))

@inline
trusted fun esp32WdtBase(context: u32): u32 =
    esp32WdtContextLoad(context, u32(4))

@inline
trusted fun esp32WdtWriteProtect(context: u32, value: u32): void {
    val base = esp32WdtBase(context)
    val offset = if (esp32WdtInstance(context) == u32(0)) u32(164) else u32(100)
    xtensaDeviceStoreU32(base + offset, value)
}

trusted fun esp32WdtHalInit(
    context: u32,
    instance: u32,
    prescaler: u32,
    enableInterrupt: u32
): void {
    val base = if (instance == u32(1)) u32(0x3ff5f000) else
        if (instance == u32(2)) u32(0x3ff60000) else
        u32(0x3ff48000)
    esp32WdtContextStore(context, u32(0), instance)
    esp32WdtContextStore(context, u32(4), base)

    val interruptEnabled = enableInterrupt & u32(1)
    if (instance == u32(0)) {
        xtensaDeviceStoreU32(base + u32(164), u32(0x50d83aa1))
        esp32WdtUpdate(
            base + u32(140),
            u32(0xfffe0000),
            (interruptEnabled << u32(17)) | u32(0x0001fb80)
        )
        esp32WdtUpdate(base + u32(72), u32(0), u32(8))
        esp32WdtUpdate(
            base + u32(60),
            u32(8),
            interruptEnabled << u32(3)
        )
        xtensaDeviceStoreU32(base + u32(164), u32(0))
    } else {
        xtensaDeviceStoreU32(base + u32(100), u32(0x50d83aa1))
        esp32WdtUpdate(
            base + u32(72),
            u32(0xffe00000),
            (interruptEnabled << u32(21)) | u32(0x001f8000)
        )
        esp32WdtUpdate(base + u32(164), u32(0), u32(4))
        esp32WdtUpdate(
            base + u32(152),
            u32(4),
            interruptEnabled << u32(2)
        )
        esp32WdtUpdate(
            base + u32(76),
            u32(0xffff0000),
            (prescaler & u32(0xffff)) << u32(16)
        )
        xtensaDeviceStoreU32(base + u32(100), u32(0))
    }
}

trusted fun esp32WdtHalDeinit(context: u32): void {
    val base = esp32WdtBase(context)
    if (esp32WdtInstance(context) == u32(0)) {
        xtensaDeviceStoreU32(base + u32(164), u32(0x50d83aa1))
        esp32WdtUpdate(base + u32(160), u32(0), u32(0x80000000))
        esp32WdtUpdate(base + u32(140), u32(0x80000000), u32(0))
        esp32WdtUpdate(base + u32(72), u32(0), u32(8))
        esp32WdtUpdate(base + u32(60), u32(8), u32(0))
        xtensaDeviceStoreU32(base + u32(164), u32(0))
    } else {
        xtensaDeviceStoreU32(base + u32(100), u32(0x50d83aa1))
        xtensaDeviceStoreU32(base + u32(96), u32(1))
        esp32WdtUpdate(base + u32(72), u32(0x80000000), u32(0))
        esp32WdtUpdate(base + u32(164), u32(0), u32(4))
        esp32WdtUpdate(base + u32(152), u32(4), u32(0))
        xtensaDeviceStoreU32(base + u32(100), u32(0))
    }
    esp32WdtContextStore(context, u32(4), u32(0))
}

trusted fun esp32WdtHalConfigStage(
    context: u32,
    stage: u32,
    timeoutTicks: u32,
    behavior: u32
): void {
    if (stage >= u32(4)) {
        esp32RecoveredAbort(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        return
    }

    val base = esp32WdtBase(context)
    if (esp32WdtInstance(context) == u32(0)) {
        val shift = u32(28) - stage * u32(3)
        val fieldMask = u32(7) << shift
        esp32WdtUpdate(
            base + u32(140),
            fieldMask,
            (behavior & u32(7)) << shift
        )
        xtensaDeviceStoreU32(base + u32(144) + stage * u32(4), timeoutTicks)
    } else {
        val shift = u32(29) - stage * u32(2)
        val fieldMask = u32(3) << shift
        esp32WdtUpdate(
            base + u32(72),
            fieldMask,
            (behavior & u32(3)) << shift
        )
        xtensaDeviceStoreU32(base + u32(80) + stage * u32(4), timeoutTicks)
    }
}

trusted fun esp32WdtHalWriteProtectDisable(context: u32): void =
    esp32WdtWriteProtect(context, u32(0x50d83aa1))

trusted fun esp32WdtHalWriteProtectEnable(context: u32): void =
    esp32WdtWriteProtect(context, u32(0))

trusted fun esp32WdtHalWriteProtectDisableValue(context: u32): u32 {
    esp32WdtHalWriteProtectDisable(context)
    u32(0)
}

trusted fun esp32WdtHalWriteProtectEnableValue(context: u32): u32 {
    esp32WdtHalWriteProtectEnable(context)
    u32(0)
}

trusted fun esp32WdtHalConfigStageValue(
    context: u32,
    stage: u32,
    timeoutTicks: u32,
    behavior: u32
): u32 {
    esp32WdtHalConfigStage(context, stage, timeoutTicks, behavior)
    u32(0)
}

trusted fun esp32WdtHalEnable(context: u32): void {
    val base = esp32WdtBase(context)
    if (esp32WdtInstance(context) == u32(0)) {
        esp32WdtUpdate(base + u32(160), u32(0), u32(0x80000000))
        esp32WdtUpdate(base + u32(140), u32(0), u32(0x80000000))
    } else {
        xtensaDeviceStoreU32(base + u32(96), u32(1))
        esp32WdtUpdate(base + u32(72), u32(0), u32(0x80000000))
    }
}

trusted fun esp32WdtHalEnableValue(context: u32): u32 {
    esp32WdtHalEnable(context)
    u32(0)
}

trusted fun esp32WdtHalDisable(context: u32): void {
    val base = esp32WdtBase(context)
    val offset = if (esp32WdtInstance(context) == u32(0)) u32(140) else u32(72)
    esp32WdtUpdate(base + offset, u32(0x80000000), u32(0))
}

trusted fun esp32WdtHalDisableValue(context: u32): u32 {
    esp32WdtHalDisable(context)
    u32(0)
}

trusted fun esp32WdtHalHandleIntr(context: u32): void {
    val base = esp32WdtBase(context)
    if (esp32WdtInstance(context) == u32(0)) {
        esp32WdtUpdate(base + u32(160), u32(0), u32(0x80000000))
        esp32WdtUpdate(base + u32(72), u32(0), u32(8))
    } else {
        xtensaDeviceStoreU32(base + u32(96), u32(1))
        esp32WdtUpdate(base + u32(164), u32(0), u32(4))
    }
}

trusted fun esp32WdtHalFeed(context: u32): void {
    val base = esp32WdtBase(context)
    if (esp32WdtInstance(context) == u32(0)) {
        esp32WdtUpdate(base + u32(160), u32(0), u32(0x80000000))
    } else {
        xtensaDeviceStoreU32(base + u32(96), u32(1))
    }
}

trusted fun esp32WdtHalFeedValue(context: u32): u32 {
    esp32WdtHalFeed(context)
    u32(0)
}

trusted fun esp32WdtHalSetFlashbootEn(context: u32, enabled: u32): void {
    val base = esp32WdtBase(context)
    val mask = if (esp32WdtInstance(context) == u32(0)) u32(0x400) else u32(0x4000)
    esp32WdtUpdate(
        base + (if (
            esp32WdtInstance(context) == u32(0)
        ) u32(140) else u32(72)),
        mask,
        if ((enabled & u32(1)) != u32(0)) mask else u32(0)
    )
}

trusted fun esp32WdtHalIsEnabled(context: u32): u32 {
    val base = esp32WdtBase(context)
    val offset = if (esp32WdtInstance(context) == u32(0)) u32(140) else u32(72)
    xtensaDeviceLoadU32(base + offset) >>> u32(31)
}
