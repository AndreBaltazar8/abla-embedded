import "./pvt_park_c5_sequence.ab"
// C5 IDF6 pmu_pvt.c init + enable + charge pump, with resumable checked
// stages.16B:tag0,status4,next stage8,encoded LP gap12.1active2invalid3partial.
// Caller owns entire PVT block: reset is destructive, no rollback promised.
// CPU stable XTAL, SPLL160 source enabled/stable, calibrated manual PMU bias,
// ROM delay timing current; closure/record/stack retained; no concurrent users.
// Initial admission requires manual PMU voltage control, modern eFuse block,
// idle eFuse, and CPU clock latch idle. Do not reset live automatic regulation.
// Retry same record after failure; stage captures irreversible reset/clock
// enable and voltage handoff. Completion record must be explicitly discarded
// only after a later successful park/reset lifecycle, never to bypass a fault.
@section(".iram1.abla.c5PvtGap")
fun esp32C5PvtGap(raw: int): int {
    if (raw < 0 || raw > 31) return -1
    val signedGap=(if ((raw&16) != 0) -(raw&15) else raw&15)-8
    if (signedGap >= 0) return signedGap
    if (signedGap < -15) return 31
    16-signedGap
}
@section(".iram1.abla.c5PvtRestartField")
trusted fun c5PvtRestartField(address: int,mask: int,value: int): bool {
    var current=c5PvtParkRead(address)
    // Never replay the monitor cell's timing-error clear WT bit.
    if (address == 0x600190d8 || address == 0x600190dc || address == 0x600190e0) current=current&~2
    c5PvtParkWrite(address,(current&~mask)|(value&mask))
    (c5PvtParkRead(address)&mask) == (value&mask)
}
@section(".iram1.abla.c5PvtRestart")
trusted fun esp32C5PvtRestartOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,16) || (record.addressValue()&3) != 0) return 2
    val base=record.addressValue()
    // Refuse another session's storage before touching voltage/clock hardware.
    if (c5PvtRecordRead(base,0) != 0 && c5PvtRecordRead(base,0) != 0x43505231) return 2
    if (c5PvtRecordRead(base,0) == 0x43505231 && c5PvtRecordRead(base,4) == 1) return 1
    if ((c5PvtParkRead(0x60096144)&1) != 0 || (c5PvtParkRead(0x60096110)&0x30000) != 0) return 2
    if (c5PvtRecordRead(base,0) != 0x43505231) {
        if ((c5PvtParkRead(0x600b49d4)&15) != 1 || (c5PvtParkRead(0x600b0028)&0x4000) == 0) return 2
        val rev=c5PvtParkRead(0x600b484c)
        if (((rev>>11)&3)*100+((rev>>8)&7) < 2) return 2
        val offset=esp32C5PvtGap((c5PvtParkRead(0x600b4854)>>1)&31)
        c5PvtRecordWrite(base,0,0x43505231);c5PvtRecordWrite(base,4,3);c5PvtRecordWrite(base,8,0)
        c5PvtRecordWrite(base,12,((offset>>4)<<16)|((offset&15)<<11))
    }
    if (c5PvtRecordRead(base,4) != 3 || c5PvtRecordRead(base,8) >= 36) return 2
    val stage=c5PvtRecordRead(base,8);val gap=c5PvtRecordRead(base,12)
    if (stage <= 0) {
        if (!c5PvtRestartField(0x600960b8,2,2)) return 3
        c5PvtRecordWrite(base,8,1)
    }
    if (stage <= 1) {
        if (!c5PvtRestartField(0x600960b8,2,0)) return 3
        c5PvtRecordWrite(base,8,2)
    }
    if (stage <= 2) {
        if (!c5PvtRestartField(0x600960b8,1,1)) return 3
        c5PvtRecordWrite(base,8,3)
    }
    if (stage <= 3) {
        if (!c5PvtRestartField(0x600960bc,0x400000,0x400000)) return 3
        c5PvtRecordWrite(base,8,4)
    }
    if (stage <= 4) {
        if (!c5PvtRestartField(0x60019064,0x80000000,0)) return 3
        c5PvtRecordWrite(base,8,5)
    }
    if (stage <= 5) {
        c5PvtRestartDelay(1)
        c5PvtRecordWrite(base,8,6)
    }
    if (stage <= 6) {
        if (!c5PvtRestartField(0x60019034,0xfffc0000,(33<<25)|(37<<18))) return 3
        c5PvtRecordWrite(base,8,7)
    }
    if (stage <= 7) {
        if (!c5PvtRestartField(0x6001903c,0x1ffff,0x13e80)) return 3
        c5PvtRecordWrite(base,8,8)
    }
    if (stage <= 8) {
        if (!c5PvtRestartField(0x60019040,0x1ffff,0x13e80)) return 3
        c5PvtRecordWrite(base,8,9)
    }
    if (stage <= 9) {
        if (!c5PvtRestartField(0x60019044,0x1ffff,0x10000)) return 3
        c5PvtRecordWrite(base,8,10)
    }
    if (stage <= 10) {
        if (!c5PvtRestartField(0x60019050,0x7ff,0x24)) return 3
        c5PvtRecordWrite(base,8,11)
    }
    if (stage <= 11) {
        if (!c5PvtRestartField(0x60019054,0x7ff,5)) return 3
        c5PvtRecordWrite(base,8,12)
    }
    if (stage <= 12) {
        if (!c5PvtRestartField(0x60019058,0x7ff,0x427)) return 3
        c5PvtRecordWrite(base,8,13)
    }
    if (stage <= 13) {
        if (!c5PvtRestartField(0x60019064,0x7fff8000,0x7fff8000)) return 3
        c5PvtRecordWrite(base,8,14)
    }
    if (stage <= 14) {
        if (!c5PvtRestartField(0x600960bc,15,1)) return 3
        c5PvtRecordWrite(base,8,15)
    }
    if (stage <= 15) {
        if (!c5PvtRestartField(0x600960bc,0x100000,0x100000)) return 3
        c5PvtRecordWrite(base,8,16)
    }
    if (stage <= 16) {
        if (!c5PvtRestartField(0x600190d8,1020,154<<2)) return 3
        c5PvtRecordWrite(base,8,17)
    }
    if (stage <= 17) {
        if (!c5PvtRestartField(0x600190dc,1020,147<<2)) return 3
        c5PvtRecordWrite(base,8,18)
    }
    if (stage <= 18) {
        if (!c5PvtRestartField(0x600190e0,1020,143<<2)) return 3
        c5PvtRecordWrite(base,8,19)
    }
    if (stage <= 19) {
        if (!c5PvtRestartField(0x60019050,0x1f800,gap)) return 3
        c5PvtRecordWrite(base,8,20)
    }
    if (stage <= 20) {
        if (!c5PvtRestartField(0x60019054,0x1f800,gap)) return 3
        c5PvtRecordWrite(base,8,21)
    }
    if (stage <= 21) {
        if (!c5PvtRestartField(0x60019058,0x1f800,gap)) return 3
        c5PvtRecordWrite(base,8,22)
    }
    if (stage <= 22) {
        if (!c5PvtRestartField(0x6001902c,0xf8000000,0x08000000)) return 3
        c5PvtRecordWrite(base,8,23)
    }
    if (stage <= 23) {
        if (!c5PvtRestartField(0x60019014,0xffffffff,1<<22)) return 3
        c5PvtRecordWrite(base,8,24)
    }
    if (stage <= 24) {
        if (!c5PvtRestartField(0x60019028,0x78000000,0)) return 3
        c5PvtRecordWrite(base,8,25)
    }
    if (stage <= 25) {
        if (!c5PvtRestartField(0x600b0028,8,8)) return 3
        c5PvtRecordWrite(base,8,26)
    }
    if (stage <= 26) {
        if (!c5PvtRestartField(0x600960bc,0x400000,0x400000)) return 3
        c5PvtRecordWrite(base,8,27)
    }
    if (stage <= 27) {
        if (!c5PvtRestartField(0x600960b8,1,1)) return 3
        c5PvtRecordWrite(base,8,28)
    }
    if (stage <= 28) {
        if (!c5PvtRestartField(0x60019030,256,256)) return 3
        c5PvtRecordWrite(base,8,29)
    }
    if (stage <= 29) {
        if (!c5PvtRestartField(0x600190d8,1,1)) return 3
        c5PvtRecordWrite(base,8,30)
    }
    if (stage <= 30) {
        c5PvtRestartDelay(10)
        c5PvtRecordWrite(base,8,31)
    }
    if (stage <= 31) {
        if (!c5PvtRestartField(0x600b0028,0x4000,0)) return 3
        c5PvtRecordWrite(base,8,32)
    }
    if (stage <= 32) {
        if (!c5PvtRestartField(0x600b0028,8,0)) return 3
        c5PvtRecordWrite(base,8,33)
    }
    if (stage <= 33) {
        if (!c5PvtRestartField(0x60019064,0x80000000,0x80000000)) return 3
        c5PvtRecordWrite(base,8,34)
    }
    if (stage <= 34) {
        c5PvtRestartDelay(50)
        c5PvtRecordWrite(base,8,35)
    }
    if (stage <= 35) {
        if (!c5PvtRestartField(0x60019028,512,512)) return 3
        c5PvtRecordWrite(base,8,36)
    }
    c5PvtRecordWrite(base,4,1)
    1
}
