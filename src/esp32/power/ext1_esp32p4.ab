import "./ext1_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4Ext1Read")
trusted fun p4Ext1ReadHook(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
@export("p4Ext1Write")
trusted fun p4Ext1WriteHook(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value));return }
