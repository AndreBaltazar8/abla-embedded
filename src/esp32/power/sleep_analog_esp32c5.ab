import "./sleep_analog_apply_c5_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.c5SleepAnalogRead")
trusted fun c5SleepAnalogRead(offset: int): int = mmioLoadU32(0x600b0000+offset)
@section(".iram1.abla.c5SleepAnalogWrite")
trusted fun c5SleepAnalogWrite(offset: int,value: int): void { mmioStoreU32(0x600b0000+offset,value);return }
