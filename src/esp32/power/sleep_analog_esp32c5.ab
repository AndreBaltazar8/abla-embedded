import "./sleep_analog_apply_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@section(".iram1.abla.c5SleepAnalogRead")
@export("c5SleepAnalogRead")
trusted fun c5SleepAnalogReadHook(offset: int): int = mmioLoadU32(0x600b0000+offset)
@section(".iram1.abla.c5SleepAnalogWrite")
@export("c5SleepAnalogWrite")
trusted fun c5SleepAnalogWriteHook(offset: int,value: int): void { mmioStoreU32(0x600b0000+offset,value);return }
