import "./sleep_round_p4_sequence.ab"
import "./sleep_rendezvous_p4_sequence.ab"
// Transfer a backed peer generation exactly once into the coordinator round.
// Rendezvous state13 means consumed: its Continue/Cancel APIs reject it.
// All IRQ owners/table/payload remain pinned until the actual handler returns.
// No automatic reuse or binding removal. Return7round-ready,9cancel-requested,
// 4invalid handoff ownership. On9 drive rendezvous cancellation to completion.
fun p4HandoffInputOverlap(input: NativeBuffer,size: int,rv: NativeBuffer,payload: NativeBuffer,binding: NativeBuffer,table: NativeBuffer): bool =
    p4RoundOverlap(input,size,rv,64) || p4RoundOverlap(input,size,payload,848) ||
    p4RoundOverlap(input,size,binding,64) || p4RoundOverlap(input,size,table,272)
trusted fun esp32p4SleepRoundHandoffOwned(r: NativeBuffer,rv: NativeBuffer,c: NativeBuffer,graph: NativeBuffer,backing: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !p4RendezvousValid(rv) || rv.loadU32(4) != 5) return 4
    val payload=nativeBufferAt(rv.loadU32(20),848);val binding=nativeBufferAt(rv.loadU32(24),64)
    val table=nativeBufferAt(binding.loadU32(32),272)
    // The whole coordinator owner (not merely each nested child) must not
    // overwrite the live peer frame, dispatch table or rendezvous bookkeeping.
    val overlap=p4HandoffInputOverlap(r,2168,rv,payload,binding,table) ||
        p4HandoffInputOverlap(c,192,rv,payload,binding,table) ||
        p4HandoffInputOverlap(graph,graph.capacity(),rv,payload,binding,table) ||
        p4HandoffInputOverlap(backing,backing.capacity(),rv,payload,binding,table)
    // This complete retention round is revision300/layout3 only. The binding
    // must still name the same installed handler payload on the peer hart.
    if (overlap || binding.loadU32(0) != 0x50344249 || binding.loadU32(4) != 5 || binding.loadU32(56) != 0 || binding.loadU32(20) != 3 ||
        binding.loadU32(16) != 1-rv.loadU32(32) || binding.loadU32(36) != payload.addressValue()) {
        esp32p4SleepRendezvousCancelOwned(rv,true);return 9
    }
    val opened=esp32p4SleepRoundOpenOwned(r,c,graph,backing,nativeBufferAt(rv.loadU32(16),4),rv.loadU32(28),true)
    if (opened != 7) { esp32p4SleepRendezvousCancelOwned(rv,true);return 9 }
    rv.storeU32(4,13);return 7
}
