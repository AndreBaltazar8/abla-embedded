import "./sleep_policy_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepPolicyRead")
trusted fun p4SleepPolicyReadHook(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
@export("p4SleepPolicyWrite")
trusted fun p4SleepPolicyWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value));return }
