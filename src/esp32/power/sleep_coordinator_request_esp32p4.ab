import "./sleep_coordinator_request_p4_sequence.ab"
import "./sleep_smp_esp32p4.ab"
import "./sleep_session_esp32p4.ab"
import "./sleep_cpu_retained_esp32p4.ab"
import "abla/unsafe/native"
trusted noescape extern:"inline-assembly" fun p4RequestAsm(template: string,constraints: string): void
trusted fun p4RequestRelax(): void = p4RequestAsm("nop","~{memory}")
trusted fun p4RequestSession(r: NativeBuffer,polls: int,eventPolls: int): int = esp32p4SleepSessionContinueOwned(r,polls,eventPolls,true)
trusted fun esp32p4SleepCoordinatorRequestAddress(): int = nativeFunctionAddress(esp32p4SleepCoordinatorRequest)
// Returns CpuRetained boundary status (6ROM wake/7callback return), NOT a
// fabricated sleep event. Both successful returns must enter coordinator
// recovery. Refused entry retains prepared children for explicit rollback.
trusted fun esp32p4SleepCoordinatorRequestInvokeOwned(r: NativeBuffer,exclusivePublished: bool): int {
    if (!exclusivePublished || !r.hasAddressRange(0,48) || (r.addressValue()&3) != 0 ||
        r.loadU32(0) != 0x50344351 || r.loadU32(4) != 1 || int(p4SmpHart()) != r.loadU32(36) ||
        (p4SmpStatus()&u32(8)) != u32(0)) return 2
    val state=esp32p4SleepSmpObserve(nativeBufferAt(r.loadU32(28),4),r.loadU32(32))
    if (state.status() != 1 || state.stage() != 1 || state.coordinator() != r.loadU32(36) ||
        state.phase(r.loadU32(36)) != 1 || state.phase(1-r.loadU32(36)) != 2) return 3
    return esp32p4CpuRetainedInvokeOwned(nativeBufferAt(r.loadU32(16),816),esp32p4SleepCoordinatorRequestAddress(),u32(r.addressValue()),true)
}
