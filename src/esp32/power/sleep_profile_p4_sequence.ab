import "./sleep_power_p4_sequence.ab"
import "./sleep_digital_p4_sequence.ab"
import "./sleep_analog_p4_sequence.ab"
import "./sleep_timing_p4_sequence.ab"
import "./sleep_timing_logic_p4.ab"
// Combined pmu_sleep_init ordering: power -> digital -> analog -> timing.
// Caller owns PMU, clocks, pad sleep state and calibrated supply policy,
// excludes all HP/LP transitions, and retains recovery code in powered memory.
// This prepares settings, NOT cache/PSRAM/retention or a SLEEP_REQ operation.
// Config108B: power32, analog32, ten timing cycle words40, digital flags4.
// Record180B: header24; power52@24; digital token64@76; analog56@84; timing40@140.
// Do not independently operate on children. Keep record exclusive until closed.
// State1ready3partial4closed; results1ready2invalid3power4digital5analog6timing
// 8closed9cleanup. Primary/cleanup give stage; child records retain exact field.
import "./sleep_profile_config_p4.ab"
trusted fun p4SleepProfileDigitalStore(r: NativeBuffer,token: P4SleepDigital): void {
    r.storeU32(76,token&0xffffffff);r.storeU32(80,token>>>32);return
}
trusted fun esp32p4SleepProfileOpenOwned(r: NativeBuffer,c: NativeBuffer,revision: int,deep: bool,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,180) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 || !p4SleepProfileConfigValid(c,revision)) return 2
    if (r.addressValue() < c.addressValue()+108 && c.addressValue() < r.addressValue()+180) return 2
    var i=4
    while (i < 180) { r.storeU32(i,0);i=i+4 }
    r.storeU32(0,0x50344631);r.storeU32(4,3);r.storeU32(16,revision);r.storeU32(20,if (deep) 1 else 0)
    if (esp32p4SleepPowerOpenOwned(nativeBufferAt(r.addressValue()+24,52),nativeBufferAt(c.addressValue(),32),if (revision >= 300) 3 else 1,true) != 1) {
        r.storeU32(8,3);return 3
    }
    val digital=esp32p4SleepDigitalOpenOwned(c.loadU32(104),true)
    p4SleepProfileDigitalStore(r,digital)
    if (digital.status() != 1) { r.storeU32(8,4);return 4 }
    if (esp32p4SleepAnalogOpenOwned(nativeBufferAt(r.addressValue()+84,56),nativeBufferAt(c.addressValue()+32,32),revision,deep,true) != 1) {
        r.storeU32(8,5);return 5
    }
    if (esp32p4SleepTimingOpenOwned(nativeBufferAt(r.addressValue()+140,40),c.loadU32(64),c.loadU32(68),c.loadU32(72),c.loadU32(76),
        c.loadU32(80),c.loadU32(84),c.loadU32(88),c.loadU32(92),c.loadU32(96),c.loadU32(100),true) != 1) {
        r.storeU32(8,6);return 6
    }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4SleepProfileCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,180) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50344631) return 2
    if (r.loadU32(4) == 4) return 8
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    r.storeU32(4,3)
    val timing=nativeBufferAt(r.addressValue()+140,40)
    if (timing.loadU32(0) != 0 && esp32p4SleepTimingCloseOwned(timing,true) != 4) { r.storeU32(12,6);return 9 }
    val analog=nativeBufferAt(r.addressValue()+84,56)
    if (analog.loadU32(0) != 0 && esp32p4SleepAnalogCloseOwned(analog,true) != 4) { r.storeU32(12,5);return 9 }
    var digital=P4SleepDigital(r.loadU32(76)|(r.loadU32(80)<<32))
    if (digital.hasSnapshot()) {
        digital=digital.closeOwned(true);p4SleepProfileDigitalStore(r,digital)
        if (digital.status() != 5) { r.storeU32(12,4);return 9 }
    }
    val power=nativeBufferAt(r.addressValue()+24,52)
    if (power.loadU32(0) != 0 && esp32p4SleepPowerCloseOwned(power,true) != 4) { r.storeU32(12,3);return 9 }
    r.storeU32(12,0);r.storeU32(4,4);return 8
}
