import "../gpio/wake_session_s3_sequence.ab"
// Caller owns powered input/mux/pulls/holds, has released the board interrupt,
// and excludes pin/global-trigger writers, peers and clients through cleanup.
// Wake32 and retained sleep128 must also be disjoint from retention buffers.
// Every entry return (including refusal) still requires retained resume.
fun esp32S3SleepGpioRecordsDisjoint(sleep: NativeBuffer,wake: NativeBuffer): bool =
    sleep.hasAddressRange(0,128) && wake.hasAddressRange(0,32) &&
    ((sleep.addressValue()|wake.addressValue())&3) == 0 &&
    (sleep.addressValue()+128 <= wake.addressValue() || wake.addressValue()+32 <= sleep.addressValue())
trusted fun esp32S3SleepGpioReadyOwned(sleep: NativeBuffer,wake: NativeBuffer): bool {
    if (!esp32S3SleepGpioRecordsDisjoint(sleep,wake) || wake.loadU32(0) != 0x53335747 || wake.loadU32(4) != 1 || wake.loadU32(24) != 1) return false
    val pad=S3GpioWake(wake.loadU32(16))
    if (!pad.hasSnapshot() || pad.status() != 1) return false
    val pin=pad.pin()
    if ((pin == 19 || pin == 20) && (sleep.loadU32(108)&2) != 0) return false
    val fields=s3GpioWakeRead(0x60004074+pin*4)
    val kind=(fields>>>7)&7
    return (fields&0x3e400) == 0x400 && (kind == 4 || kind == 5) && (s3GpioWakeRead(0x6000803c)&0x20000) != 0
}
// Positive duration: GPIO or timer. Zero: GPIO only (not M5 zero-duration API).
// -6 refuses missing/stolen GPIO ownership without entering the sleep engine.
trusted fun esp32S3SleepGpioEnterOwned(sleep: NativeBuffer,wake: NativeBuffer,flags: int,period: int,duration: int,reject: int): int {
    if (!esp32S3SleepGpioReadyOwned(sleep,wake) || duration < 0) return -6
    if (duration == 0) return esp32S3SleepExternalOnlyRecordEnterOwned(sleep,flags,period,4,reject)
    return esp32S3SleepTimedRecordEnterOwned(sleep,flags,period,duration,4,reject)
}
// Cache-enabled cleanup AFTER actual retained resume, never clock recovery
// from this flash-resident function. Consume wake causes before calling.
trusted fun esp32S3SleepGpioCleanupOwned(sleep: NativeBuffer,wake: NativeBuffer): bool {
    if (!esp32S3SleepGpioRecordsDisjoint(sleep,wake) || sleep.loadU32(0) != 0 || (sleep.loadU32(4)&255) != 6) return false
    val progress=Esp32S3SleepResume(esp32S3MspiStateLoad64(sleep.addressValue()+40))
    if (!progress.valid() || !progress.complete()) return false
    return esp32S3GpioWakeSessionCloseOwned(wake,true) == 8
}
