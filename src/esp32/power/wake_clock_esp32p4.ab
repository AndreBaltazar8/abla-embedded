import "./wake_clock_p4_sequence.ab"
import "../gpio_esp32p4.ab"
import "../../hal/esp32_power.ab"
@export("p4WakeClockRead")
trusted fun p4WakeClockReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("p4WakeClockWrite")
trusted fun p4WakeClockWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
