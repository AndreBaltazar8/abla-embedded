import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSleepUartOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredSleepUartPrepare", "sleep_uart_prepare")) return false
    if (!internalFunction("esp32RecoveredSleepUartResume", "sleep_uart_resume")) return false
    if (!internalFunction("esp32RecoveredSleepUartSetHandlingMode", "sleep_uart_set_handling_mode")) return false
    if (!internalFunction("esp32RecoveredEspSleepSetConsoleUartHandlingMode", "esp_sleep_set_console_uart_handling_mode")) return false
    true
}
