import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/unsafe/native"
// C ABI call boundary, NOT a setjmp/returns-twice API. The enclosed callback
// returns normally (rejected/no CPU loss), or ROM wakes at entry+16, restores
// this boundary's retained stack/callee-saved GPRs and returns to its caller.
// 144B internal record: magic,phase,hart,revision,result,context,reserved2;
// ra/sp/gp/tp32..44; s0..s11 at48..92; trap CSRs96..132; callback136,reserved140.
// Phase1 callback active,2 callback returned,3 ROM wake. Return is callback's
// u32 result for phase2, zero for phase3; phase MUST distinguish these cases.
// Caller keeps global interrupts OFF, internal code/stack/record/table powered,
// owns this hart and ROM route, and publishes wakeEntry before requesting sleep.
// Callback ABI u32(u32 context), integer-only soft-float, respects callee-saved
// registers. It owns final writeback + actual PMU request, cannot return while
// any hardware could still wake through this frame. Nested use is rejected.
// Wake route is shared across harts; table has one exclusive live frame/hart.
// No automatic cache recovery, FPU/aux/CLIC retention, SMP/PMU/wake setup.
// Those owners surround this call; all code reached before recovery is internal.
// Interrupts remain OFF on return. Rev>=300 alone accesses mintthresh.
// Low-level assembly is limited to execution-state and architecture boundaries.
trusted noescape extern:"inline-assembly" fun p4SleepCoreAsm(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4SleepCoreCallAsm(template: string,constraints: string,frame: u32,callback: u32,context: u32,revision: u32,entry: u32): u32
@naked
@noinline
@section(".spm.text.abla.p4_core")
trusted fun p4SleepCoreBoundary(): u32 =
    p4SleepCoreAsm(".option push\n.option norvc\n.option norelax\n.Labla_p4_core_base:\nj .Labla_p4_core_save\n.org .Labla_p4_core_base+16\nj .Labla_p4_core_wake\n.org .Labla_p4_core_base+32\n.Labla_p4_core_save:\ncsrr t0, mstatus\nandi t0, t0, 8\nbnez t0, .Labla_p4_core_invalid\ncsrr t0, mhartid\nli t1, 1\nbltu t1, t0, .Labla_p4_core_invalid\nla t1, .Labla_p4_core_frames\nslli t2, t0, 2\nadd t1, t1, t2\nlw t2, 0(t1)\nbnez t2, .Labla_p4_core_invalid\nsw t0, 8(a0)\nsw a3, 12(a0)\nsw zero, 16(a0)\nsw a2, 20(a0)\nsw zero, 24(a0)\nsw zero, 28(a0)\nsw ra, 32(a0)\nsw sp, 36(a0)\nsw gp, 40(a0)\nsw tp, 44(a0)\nsw x8, 48(a0)\nsw x9, 52(a0)\nsw x18, 56(a0)\nsw x19, 60(a0)\nsw x20, 64(a0)\nsw x21, 68(a0)\nsw x22, 72(a0)\nsw x23, 76(a0)\nsw x24, 80(a0)\nsw x25, 84(a0)\nsw x26, 88(a0)\nsw x27, 92(a0)\ncsrr t2, 0x300\nsw t2, 96(a0)\ncsrr t2, 0x305\nsw t2, 100(a0)\ncsrr t2, 0x307\nsw t2, 104(a0)\ncsrr t2, 0x342\nsw t2, 112(a0)\ncsrr t2, 0x343\nsw t2, 116(a0)\ncsrr t2, 0x304\nsw t2, 120(a0)\ncsrr t2, 0x344\nsw t2, 124(a0)\ncsrr t2, 0x341\nsw t2, 128(a0)\ncsrr t2, 0x340\nsw t2, 132(a0)\nsw zero, 108(a0)\nli t2, 300\nbltu a3, t2, .Labla_p4_core_saved_threshold\ncsrr t2, 0x347\nsw t2, 108(a0)\n.Labla_p4_core_saved_threshold:\nsw a1, 136(a0)\nsw zero, 140(a0)\nli t2, 0x50344358\nsw t2, 0(a0)\nli t2, 1\nsw t2, 4(a0)\nsw a0, 0(t1)\nfence iorw, iorw\nmv s0, a0\nmv t0, a1\nmv a0, a2\njalr ra, t0, 0\nmv t0, s0\nsw a0, 16(t0)\nli t1, 2\nsw t1, 4(t0)\nj .Labla_p4_core_restore\n.Labla_p4_core_invalid:\nli a0, 3\nret\n.Labla_p4_core_wake:\ncsrci mstatus, 8\ncsrr t1, mhartid\nli t2, 1\nbltu t2, t1, .Labla_p4_core_no_frame\nla t0, .Labla_p4_core_frames\nslli t2, t1, 2\nadd t0, t0, t2\nlw t0, 0(t0)\nbeqz t0, .Labla_p4_core_no_frame\nlw t2, 0(t0)\nli t3, 0x50344358\nbne t2, t3, .Labla_p4_core_no_frame\nlw t2, 8(t0)\nbne t2, t1, .Labla_p4_core_no_frame\nlw t2, 4(t0)\nli t3, 1\nbne t2, t3, .Labla_p4_core_no_frame\nli t1, 3\nsw t1, 4(t0)\nsw zero, 16(t0)\n.Labla_p4_core_restore:\ncsrci mstatus, 8\nlw t1, 100(t0)\ncsrw 0x305, t1\nlw t1, 104(t0)\ncsrw 0x307, t1\nlw t1, 112(t0)\ncsrw 0x342, t1\nlw t1, 116(t0)\ncsrw 0x343, t1\nlw t1, 120(t0)\ncsrw 0x304, t1\nlw t1, 124(t0)\ncsrw 0x344, t1\nlw t1, 128(t0)\ncsrw 0x341, t1\nlw t1, 132(t0)\ncsrw 0x340, t1\nlw t1, 12(t0)\nli t2, 300\nbltu t1, t2, .Labla_p4_core_restored_threshold\nlw t1, 108(t0)\ncsrw 0x347, t1\n.Labla_p4_core_restored_threshold:\nla t1, .Labla_p4_core_frames\nlw t2, 8(t0)\nslli t2, t2, 2\nadd t1, t1, t2\nsw zero, 0(t1)\nfence iorw, iorw\nlw t1, 96(t0)\nandi t1, t1, -9\ncsrw mstatus, t1\nlw ra, 32(t0)\nlw sp, 36(t0)\nlw gp, 40(t0)\nlw tp, 44(t0)\nlw x8, 48(t0)\nlw x9, 52(t0)\nlw x18, 56(t0)\nlw x19, 60(t0)\nlw x20, 64(t0)\nlw x21, 68(t0)\nlw x22, 72(t0)\nlw x23, 76(t0)\nlw x24, 80(t0)\nlw x25, 84(t0)\nlw x26, 88(t0)\nlw x27, 92(t0)\nlw a0, 16(t0)\nret\n.Labla_p4_core_no_frame:\nret\n.pushsection .bss.abla.p4_core_frames,\"aw\",@nobits\n.balign 4\n.Labla_p4_core_frames:\n.zero 8\n.popsection\n.option pop","~{memory}")
@inline
trusted fun esp32p4SleepCoreWakeAddress(): int = nativeFunctionAddress(p4SleepCoreBoundary)+16
// Record zero-initialized by owner, not overlapping active stack or callback
// storage. exclusivePublished certifies mapped/powered retained RAM + route.
trusted fun esp32p4SleepCoreInvokeOwned(r: NativeBuffer,callback: int,context: u32,revision: int,exclusivePublished: bool): int {
    if (!exclusivePublished || !r.hasAddressRange(0,144) || (r.addressValue()&15) != 0 || r.loadU32(0) != 0 ||
        callback <= 0 || callback > 4294967294 || (callback&1) != 0 || revision < 0 || revision > 399) return 2
    // Explicit architectural ABI: unused naked formal arguments can otherwise
    // be removed by LLVM dead-argument elimination. Inputs cannot overlap any
    // of the clobbered caller-saved registers; a0 is an early-clobber output.
    return int(p4SleepCoreCallAsm("mv a0, $1\n mv a1, $2\n mv a2, $3\n mv a3, $4\n jalr ra, $5, 0",
        "=&{a0},r,r,r,r,r,~{ra},~{a1},~{a2},~{a3},~{a4},~{a5},~{a6},~{a7},~{t0},~{t1},~{t2},~{t3},~{t4},~{t5},~{t6},~{memory}",
        u32(r.addressValue()),u32(callback),context,u32(revision),u32(nativeFunctionAddress(p4SleepCoreBoundary))))
}
