import "../../runtime/rtc_time48.ab"
// IDF6 C5 pmu_sleep_calculate_hw_wait_time, default machine constants.
// No guessed oscillator rate. fixedMinimumPeriod is supplied only for the
// enhanced-light-sleep RC_SLOW fixed-minimum policy;0 disables that adjustment.
// Return microseconds, -1 invalid. This does not configure or enable REGDMA.
fun esp32C5SleepHardwareWait(slowPeriod: int,xtalPoweredDown: bool,xtalIsFastClock: bool,
    regdmaBackup: bool,enhancedModem: bool,fixedMinimumPeriod: int = 0): int {
    if (slowPeriod < 1 || slowPeriod > 4294967295 || fixedMinimumPeriod < 0 || fixedMinimumPeriod > 4294967295 ||
        (fixedMinimumPeriod != 0 && !enhancedModem)) return -1
    val one=slowPeriod>>>19
    val lp=610+(if (xtalPoweredDown && xtalIsFastClock) 250 else one)+((slowPeriod*4)>>>19)+one
    val hp=210+(if (xtalPoweredDown && !xtalIsFastClock) 250 else 0)+(if (regdmaBackup) 720 else 0)
    var adjustment=0
    if (fixedMinimumPeriod != 0) {
        val calibrated=rtc48TicksForMicroseconds(450,slowPeriod)
        val fixed=rtc48TicksForMicroseconds(450,fixedMinimumPeriod)
        val difference=if (calibrated > fixed) calibrated-fixed else fixed-calibrated
        val micros=(difference*fixedMinimumPeriod)>>>19
        adjustment=if (calibrated > fixed) micros else -micros
    }
    val total=lp+hp+adjustment+(if (enhancedModem) 70 else 0)
    if (total < 0) -1 else total
}
// Upstream adjustment - hardwareWait + M2A430 + DFS124 + LPminimum450 +
// RFon68. Reject negative subtraction and20bit register overflow, not wrap.
fun esp32C5SleepModemWaitCycles(adjustmentMicroseconds: int,slowPeriod: int,fastPeriod: int,
    xtalPoweredDown: bool,xtalIsFastClock: bool,regdmaBackup: bool,enhancedModem: bool,fixedMinimumPeriod: int = 0): int {
    if (adjustmentMicroseconds < 0 || adjustmentMicroseconds > 4294967295 || fastPeriod < 1 || fastPeriod > 4294967295) return -1
    val hardware=esp32C5SleepHardwareWait(slowPeriod,xtalPoweredDown,xtalIsFastClock,regdmaBackup,enhancedModem,fixedMinimumPeriod)
    if (hardware < 0) return -1
    val duration=adjustmentMicroseconds-hardware+1072
    if (duration < 0) return -1
    val cycles=rtc48TicksForMicroseconds(duration,fastPeriod)
    if (cycles < 0 || cycles > 1048575) -1 else cycles
}
