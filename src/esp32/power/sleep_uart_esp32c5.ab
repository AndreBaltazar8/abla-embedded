import "./sleep_uart_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@inline
@export("c5SleepUartRead")
trusted fun c5SleepUartReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("c5SleepUartWrite")
trusted fun c5SleepUartWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
