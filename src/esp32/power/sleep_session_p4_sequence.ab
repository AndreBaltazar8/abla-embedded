import "./retention_published_p4_sequence.ab"
import "./sleep_cached_p4_sequence.ab"
// Revision300 generated graph publication -> cached retained cycle -> session
// close AFTER caches/predictor/flash/PSRAM have recovered. One retained owner;
// callers must not manipulate the child records or leases independently.
// Still requires prepared PMU/wake/CPU/rail policy, powered/drained flash,
// retained internal code/stack/record and peer-core/IRQ/DMA/trigger exclusion.
// Graph/backing remain alive and immutable until completion (PAU writes backup).
// This composes lifecycle, NOT board-ready sleep or full CPU context retention.
// Record464B: magic,state,last,detail,outcome,mhz,regdma,reserved;
// publication144@32; cachedCycle288@176. States1publication2cycle3close
// 4done5engineFault. Results1wake2reject3both4invalid7pending9stageFailure
// 10aborted11engineFault12published. Engine faults latch without releasing any resources.
trusted fun p4SleepSessionResult(r: NativeBuffer,result: int,detail: int): int {
    r.storeU32(8,result);r.storeU32(12,detail);return result
}
trusted fun p4SleepSessionValid(r: NativeBuffer): bool = r.hasAddressRange(0,464) && (r.addressValue()&3) == 0 && r.loadU32(0) == 0x50345332 && r.loadU32(4) >= 1 && r.loadU32(4) <= 5
trusted fun esp32p4SleepSessionContinueOwned(r: NativeBuffer,polls: int,eventPolls: int,exclusive: bool): int {
    if (!exclusive || polls < 1 || polls > 1000000 || eventPolls < 1 || eventPolls > 1000000 || !p4SleepSessionValid(r)) return 4
    if (r.loadU32(4) == 4) return r.loadU32(16)
    if (r.loadU32(4) == 5) return 11
    val publication=nativeBufferAt(r.addressValue()+32,144)
    val cycle=nativeBufferAt(r.addressValue()+176,288)
    while (true) {
        val state=r.loadU32(4)
        if (state == 1) {
            val published=esp32p4RetentionPublishedContinueOwned(publication,polls,true)
            if (published == 5 || published == 3) return p4SleepSessionResult(r,7,published)
            if (published != 1) { r.storeU32(16,10);r.storeU32(4,3);return p4SleepSessionResult(r,9,published) }
            r.storeU32(4,2)
        } else if (state == 2) {
            val slept=if (cycle.loadU32(0) == 0) esp32p4SleepCachedBeginOwned(cycle,300,r.loadU32(20),r.loadU32(24) != 0,polls,eventPolls,true) else esp32p4SleepCachedContinueOwned(cycle,polls,eventPolls,true)
            if (slept == 11) { r.storeU32(4,5);return p4SleepSessionResult(r,11,cycle.loadU32(12)) }
            if (slept == 4 && cycle.loadU32(0) == 0) {
                // Cached preflight failed before owning predictor/cache state.
                r.storeU32(16,10);r.storeU32(4,3);return p4SleepSessionResult(r,9,4)
            }
            if ((slept < 1 || slept > 3) && slept != 10) return p4SleepSessionResult(r,if (slept == 7) 7 else if (slept == 4) 4 else 9,slept)
            r.storeU32(16,slept);r.storeU32(4,3)
        } else if (state == 3) {
            if (publication.loadU32(0) != 0) {
                val closed=esp32p4RetentionPublishedCloseOwned(publication,true)
                if (closed != 8) return p4SleepSessionResult(r,if (closed == 5) 7 else 9,closed)
            }
            r.storeU32(4,4);return p4SleepSessionResult(r,r.loadU32(16),0)
        } else return 4
    }
    return 4
}
trusted fun p4SleepSessionOpen(r: NativeBuffer,c: NativeBuffer,entry3: int,graph: NativeBuffer,backing: NativeBuffer,revision: int,mhz: int,regdma: bool,polls: int,eventPolls: int,exclusive: bool,start: bool): int {
    if (!exclusive || revision != 300 || (mhz != 320 && mhz != 400 && mhz != 500) || polls < 1 || polls > 1000000 ||
        eventPolls < 1 || eventPolls > 1000000 || !r.hasAddressRange(0,464) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 ||
        !p4RetentionSessionConfigValid(c) || entry3 == 0 || !p4RetentionLinkAddressValid(entry3) ||
        p4RetentionRangesOverlap(r.addressValue(),464,c.addressValue(),32) ||
        p4RetentionRangesOverlap(r.addressValue(),464,graph.addressValue(),graph.capacity()) ||
        p4RetentionRangesOverlap(r.addressValue(),464,backing.addressValue(),backing.capacity())) return 4
    var i=4
    while (i < 464) { r.storeU32(i,0);i=i+4 }
    r.storeU32(0,0x50345332);r.storeU32(4,1);r.storeU32(20,mhz);r.storeU32(24,if (regdma) 1 else 0)
    val published=esp32p4RetentionPublishedOpenOwned(nativeBufferAt(r.addressValue()+32,144),c,entry3,graph,backing,polls,true)
    if (published == 5 || published == 3) return p4SleepSessionResult(r,7,published)
    if (published != 1) { r.storeU32(16,10);r.storeU32(4,3);return p4SleepSessionResult(r,9,published) }
    r.storeU32(4,2)
    if (!start) return p4SleepSessionResult(r,12,0)
    return esp32p4SleepSessionContinueOwned(r,polls,eventPolls,true)
}
trusted fun esp32p4SleepSessionBeginOwned(r: NativeBuffer,c: NativeBuffer,entry3: int,graph: NativeBuffer,backing: NativeBuffer,revision: int,mhz: int,regdma: bool,polls: int,eventPolls: int,exclusive: bool): int = p4SleepSessionOpen(r,c,entry3,graph,backing,revision,mhz,regdma,polls,eventPolls,exclusive,true)
// Preparation only: publish descriptors before the coordinator saves its CPU
// context and grants SMP authorization. No predictor/cache suspend or request.
// ContinueOwned is the explicit entry into the cycle after authorization.
trusted fun esp32p4SleepSessionPublishOwned(r: NativeBuffer,c: NativeBuffer,entry3: int,graph: NativeBuffer,backing: NativeBuffer,revision: int,mhz: int,regdma: bool,polls: int,exclusive: bool): int = p4SleepSessionOpen(r,c,entry3,graph,backing,revision,mhz,regdma,polls,1,exclusive,false)
trusted fun esp32p4SleepSessionPublishContinueOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || polls < 1 || polls > 1000000 || !p4SleepSessionValid(r) ||
        r.loadU32(176) != 0 || (r.loadU32(4) != 1 && r.loadU32(4) != 2)) return 4
    if (r.loadU32(4) == 2) return p4SleepSessionResult(r,12,0)
    val published=esp32p4RetentionPublishedContinueOwned(nativeBufferAt(r.addressValue()+32,144),polls,true)
    if (published == 5 || published == 3) return p4SleepSessionResult(r,7,published)
    if (published != 1) { r.storeU32(16,10);r.storeU32(4,3);return p4SleepSessionResult(r,9,published) }
    r.storeU32(4,2);return p4SleepSessionResult(r,12,0)
}
// Also permits aborting a fully published graph, but NEVER an entered cycle.
trusted fun esp32p4SleepSessionAbortBeforeCycleOwned(r: NativeBuffer,polls: int,eventPolls: int,exclusive: bool): int {
    if (!exclusive || polls < 1 || polls > 1000000 || eventPolls < 1 || eventPolls > 1000000 ||
        !p4SleepSessionValid(r) || r.loadU32(176) != 0 || (r.loadU32(4) != 1 && r.loadU32(4) != 2)) return 4
    r.storeU32(16,10);r.storeU32(4,3)
    return esp32p4SleepSessionContinueOwned(r,polls,eventPolls,true)
}
// Cancellation is available only before entering the cached cycle. An active
// backup/sleep/restore cannot be cancelled by discarding uncertain ownership.
trusted fun esp32p4SleepSessionAbortPublicationOwned(r: NativeBuffer,polls: int,eventPolls: int,exclusive: bool): int {
    if (!exclusive || polls < 1 || polls > 1000000 || eventPolls < 1 || eventPolls > 1000000 || !p4SleepSessionValid(r) || r.loadU32(4) != 1) return 4
    r.storeU32(16,10);r.storeU32(4,3)
    return esp32p4SleepSessionContinueOwned(r,polls,eventPolls,true)
}
