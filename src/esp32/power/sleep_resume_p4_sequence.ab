import "abla/runtime/scalar"
// Initial LIGHT-sleep resume barrier, not complete wake restoration. Caller
// owns an issued sleep request and all PMU/retention/memory leases, runs from
// internal retained memory, and excludes CPUs/IRQs/DMA/eFuse operations.
// Never use for deep-sleep rejection before its DCDC/LDO recovery sequence.
// Select active pad settings first (not release dedicated PSRAM pin holds),
// then wait for eFuse reload. MPLL/PSRAM restoration follows successful return.
// Events remain unacknowledged; repeated calls after timeout are safe under
// the same ownership. No eFuse writes, power changes or forced success.
// 1wake 2reject 3both 4invalid 5no event yet 6eFuse timeout: retain all leases.
trusted fun esp32p4SleepLightResumeBarrierOwned(polls: int,exclusiveRequested: bool): int {
    if (!exclusiveRequested || polls < 1 || polls > 1000000) return 4
    val events=p4SleepRequestRead(356)>>u32(30)
    if (events == u32(0)) return 5
    // Exact write-trigger bit27; no RMW replay of other pad hold commands.
    p4SleepRequestWrite(228,u32(0x08000000))
    p4SleepCacheFence()
    var remaining=u32(polls)
    while (remaining != u32(0)) {
        // HAL defines IDLE=1, not the reset value0. Other status bits ignored.
        if ((p4SleepResumeEfuseStatus()&u32(15)) == u32(1)) {
            p4SleepCacheFence()
            return if (events == u32(1)) 2 else if (events == u32(2)) 1 else 3
        }
        remaining=remaining-u32(1)
    }
    return 6
}
