import "./sleep_smp_p4_sequence.ab"
import "abla/unsafe/native"
trusted noescape extern:"inline-assembly" fun p4SmpAsmRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4SmpAsmLoad(template: string,constraints: string,address: u32): u32
trusted fun p4SmpHart(): u32 = p4SmpAsmRead("csrr $0, mhartid","=r,~{memory}")
trusted fun p4SmpStatus(): u32 = p4SmpAsmRead("csrr $0, mstatus","=r,~{memory}")
trusted fun p4SmpLoad(address: int): u32 = p4SmpAsmLoad("lw $0, 0($1)\n fence r, rw","=r,r,~{memory}",u32(address))
trusted fun p4SmpCas(address: int,expected: u32,replacement: u32): u32 =
    nativeAtomicCompareExchangeU32(address,expected,replacement)
