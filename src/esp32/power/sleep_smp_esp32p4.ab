import "./sleep_smp_p4_sequence.ab"
import "abla/unsafe/native"
import "../../hal/esp32_power.ab"
trusted noescape extern:"inline-assembly" fun p4SmpAsmRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4SmpAsmLoad(template: string,constraints: string,address: u32): u32
@export("p4SmpHart")
trusted fun p4SmpHartHook(): u32 = p4SmpAsmRead("csrr $0, mhartid","=r,~{memory}")
@export("p4SmpStatus")
trusted fun p4SmpStatusHook(): u32 = p4SmpAsmRead("csrr $0, mstatus","=r,~{memory}")
@export("p4SmpLoad")
trusted fun p4SmpLoadHook(address: int): u32 = p4SmpAsmLoad("lw $0, 0($1)\n fence r, rw","=r,r,~{memory}",u32(address))
@export("p4SmpCas")
trusted fun p4SmpCasHook(address: int,expected: u32,replacement: u32): u32 =
    nativeAtomicCompareExchangeU32(address,expected,replacement)
