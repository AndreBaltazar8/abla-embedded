import "./retention_timeout_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
import "../../hal/esp32_power_2.ab"
@export("p4RetentionClockReady")
trusted fun p4RetentionClockReadyHook(): bool = (mmioLoadU32(0x500e6018)&4) != 0 && (mmioLoadU32(0x500e60c0)&64) == 0
@export("p4RetentionPauRead")
trusted fun p4RetentionPauReadHook(offset: int): u32 = u32(mmioLoadU32(0x50082000+offset))
@export("p4RetentionPauWrite")
trusted fun p4RetentionPauWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50082000+offset,int(value));return }
@export("p4RetentionLpRead")
trusted fun p4RetentionLpReadHook(offset: int): u32 = u32(mmioLoadU32(0x50110000+offset))
@export("p4RetentionLpWrite")
trusted fun p4RetentionLpWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50110000+offset,int(value));return }
