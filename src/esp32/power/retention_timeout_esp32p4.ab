import "./retention_timeout_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4RetentionClockReady(): bool = (mmioLoadU32(0x500e6018)&4) != 0 && (mmioLoadU32(0x500e60c0)&64) == 0
trusted fun p4RetentionPauRead(offset: int): u32 = u32(mmioLoadU32(0x50082000+offset))
trusted fun p4RetentionPauWrite(offset: int,value: u32): void { mmioStoreU32(0x50082000+offset,int(value));return }
trusted fun p4RetentionLpRead(offset: int): u32 = u32(mmioLoadU32(0x50110000+offset))
trusted fun p4RetentionLpWrite(offset: int,value: u32): void { mmioStoreU32(0x50110000+offset,int(value));return }
