import "./wake_pad_p4_sequence.ab"
import "../gpio_esp32p4.ab"
import "../../hal/esp32_power.ab"
@export("p4WakePadRead")
trusted fun p4WakePadReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("p4WakePadWrite")
trusted fun p4WakePadWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
