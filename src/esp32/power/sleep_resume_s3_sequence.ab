import "../sdk/raw_buffer.ab"
import "../../hal/esp32.ab"
import "../../hal/esp32_3.ab"
import "../../hal/esp32_power_3.ab"
// Caller stores returned progress in retained internal RAM before retrying.
// Phase bits: clock1, analog2, MSPI4, UART8. Status:0new,1complete,
// 2clock-timeout retryable,3MSPI acquisition retryable,4manual recovery needed,
// 5invalid inputs. Detail is absolute clock error or MSPI status.
import "./esp32s3sleepresume_type.ab"
import "../../hal/esp32s3sleepresume.ab"
fun esp32S3SleepResumeStart(): Esp32S3SleepResume = Esp32S3SleepResume(1<<40)
@export("abla_esp32s3sleepresume_phase")
fun esp32S3SleepResumePhaseHook(recv: int): int = Esp32S3SleepResume(recv) & 15
@export("abla_esp32s3sleepresume_status")
fun esp32S3SleepResumeStatusHook(recv: int): int = (Esp32S3SleepResume(recv)>>>4) & 15
@export("abla_esp32s3sleepresume_apbHertz")
fun esp32S3SleepResumeApbHertzHook(recv: int): int = (Esp32S3SleepResume(recv)>>>8) & 0x7FFFFFF
@export("abla_esp32s3sleepresume_detail")
fun esp32S3SleepResumeDetailHook(recv: int): int = (Esp32S3SleepResume(recv)>>>35) & 31
@export("abla_esp32s3sleepresume_complete")
fun esp32S3SleepResumeCompleteHook(recv: int): bool = Esp32S3SleepResume(recv).phase() == 15 && Esp32S3SleepResume(recv).status() == 1
@inline
@export("abla_esp32s3sleepresume_valid")
fun esp32S3SleepResumeValidHook(recv: int): bool {
    val phase=Esp32S3SleepResume(recv).phase()
    return (Esp32S3SleepResume(recv) & (1<<40)) != 0 && (Esp32S3SleepResume(recv) & ~0x1FFFFFFFFFF) == 0 &&
        (phase == 0 || phase == 1 || phase == 3 || phase == 7 || phase == 15) &&
        Esp32S3SleepResume(recv).status() <= 5 && (if (phase == 0) Esp32S3SleepResume(recv).apbHertz() == 0 else Esp32S3SleepResume(recv).apbHertz() > 0 && Esp32S3SleepResume(recv).apbHertz() <= 80000000)
}
@inline
@export("esp32S3SleepResumeResult")
fun esp32S3SleepResumeResultHook(phase: int,status: int,apb: int,detail: int): Esp32S3SleepResume =
    Esp32S3SleepResume((1<<40) | phase | (status<<4) | (apb<<8) | ((detail & 31)<<35))

// Restores an already prepared light-sleep cycle, including rejected sleep.
// Both cores/interrupts and all clients remain quiescent. Caller retains all
// original snapshots; MSPI record must be active until its successful restore.
// Do not retry status4: cache/PLL state requires explicit owner recovery.
// Final APB Hz is for software clock bookkeeping before releasing clients.
@section(".iram1.abla.s3SleepResume")
@export("esp32S3SleepResumeOwned")
trusted fun esp32S3SleepResumeOwnedHook(progress: Esp32S3SleepResume,clock: Esp32S3ClockState,bias: Esp32S3ClockBias,analog: Esp32S3AnalogSleepState,mspi: NativeBuffer,uarts: Esp32S3SleepUarts,polls: int): Esp32S3SleepResume {
    if (!progress.valid()) return esp32S3SleepResumeResult(0,5,0,0)
    if (progress.complete() || progress.status() == 4) return progress
    var phase=progress.phase()
    var apb=progress.apbHertz()
    if (!mspi.hasAddressRange(0,56) || (mspi.addressValue() & 3) != 0 ||
        !uarts.ready() || polls <= 0 || polls > 0x7FFFFFFF) return esp32S3SleepResumeResult(phase,5,apb,0)
    if ((phase & 1) == 0) {
        val result=esp32S3ClockResumeFromXtalOwned(clock,bias,polls)
        if (result <= 0) return esp32S3SleepResumeResult(phase,if (result == -3) 2 else 4,apb,-result)
        apb=result; phase=1
    }
    if ((phase & 2) == 0) {
        esp32S3AnalogSleepRestoreOwned(analog)
        phase=3
    }
    if ((phase & 4) == 0) {
        val result=esp32S3MspiLowEndOwned(mspi,polls)
        if (result != 1) return esp32S3SleepResumeResult(phase,if (result >= 2 && result <= 5) 3 else 4,apb,result)
        phase=7
    }
    if ((phase & 8) == 0) {
        uarts.resumeOwned()
        phase=15
    }
    esp32S3SleepResumeResult(phase,1,apb,0)
}
