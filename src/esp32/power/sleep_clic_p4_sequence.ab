import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Per-hart CLIC retention: SDK sleep_cpu_static.c's two regions, 51 words.
// 220B record: magic,state,hart,reserved, config/info/threshold, controls0..47.
// CLIC is the current hart's local aperture: no hart*0x10000 adjustment here.
// Caller disables global interrupts, pins this hart, quiesces interrupt sources
// and retains internal code/stack/record. Trap/vector state must be restored
// separately before interrupts are reenabled. No CPU power-down is initiated.
// Snapshot includes INFO for inspection; restore skips this read-only register.
// Pending bit restoration follows SDK semantics; live level inputs remain
// hardware-owned, so raw register equality is NOT a completion criterion.
// Results1 saved2 invalid3 prerequisite4 restored.
fun p4SleepClicAddress(slot: int): int =
    if (slot < 3) 0x20800000+slot*4 else 0x20801000+(slot-3)*4
trusted fun p4SleepClicRecord(r: NativeBuffer): bool =
    r.hasAddressRange(0,220) && (r.addressValue()&3) == 0
trusted fun esp32p4SleepClicSaveOwned(r: NativeBuffer,exclusiveHart: bool): int {
    if (!exclusiveHart || !p4SleepClicRecord(r) || r.loadU32(0) != 0) return 2
    val hart=p4SleepClicHart()
    if (hart > u32(1) || (p4SleepClicStatus()&u32(8)) != u32(0)) return 3
    r.storeU32(0,0x50344349);r.storeU32(4,0);r.storeU32(8,int(hart));r.storeU32(12,0)
    var slot=0
    while (slot < 51) {
        r.storeU32(16+slot*4,p4SleepClicRead(p4SleepClicAddress(slot)))
        slot=slot+1
    }
    p4SleepClicFence();r.storeU32(4,1)
    return 1
}
trusted fun esp32p4SleepClicRestoreOwned(r: NativeBuffer,exclusiveQuiesced: bool): int {
    if (!exclusiveQuiesced || !p4SleepClicRecord(r) || r.loadU32(0) != 0x50344349 ||
        r.loadU32(4) != 1 || r.loadU32(12) != 0) return 2
    if (p4SleepClicHart() != u32(r.loadU32(8)) || (p4SleepClicStatus()&u32(8)) != u32(0)) return 3
    r.storeU32(4,2)
    var slot=0
    while (slot < 51) {
        if (slot != 1) {
            val mask=if (slot == 0) 0x1e else if (slot == 2) 0xff000000 else 0xff070101
            p4SleepClicWrite(p4SleepClicAddress(slot),r.loadU32(16+slot*4)&mask)
        }
        slot=slot+1
    }
    p4SleepClicFence();r.storeU32(4,3)
    return 4
}
