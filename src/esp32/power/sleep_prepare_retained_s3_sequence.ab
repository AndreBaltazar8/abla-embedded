import "./sleep_prepare_s3_sequence.ab"
import "./sleep_retained_record_s3_sequence.ab"
// Atomically prepare an owned cycle from the caller's perspective: preflight
// storage before clocks change, then arm retention; undo clocks if arm fails.
// Return1 armed,2 invalid storage/config (no mutation),3 preparation failed
// with clocks unchanged/restored,4 retention failed and clocks restored,
// 5 manual recovery or retryable restoration remains. NEVER enter on failure.
// 16-byte report: raw preparation result0, arm result4 (-1 not attempted),
// exact resume result8..15 (0 if not attempted). Preserve on failure/retry.
// All storage must be retained internal RAM, disjoint from wake record and
// active stack. Retention buffers must already be initialized. Caller owns
// peer/interrupt/peripheral quiescence and full IRAM closure until restored.
// This neither configures wake nor releases RTC timer/pad/board ownership.
@section(".iram1.abla.s3SleepPrepareRetained")
@noinline
trusted fun esp32S3SleepPrepareRetainedOwned(record: NativeBuffer,cpu: NativeBuffer,tags: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan,bias: Esp32S3ClockBias,ports: int,flashOctal: bool,ramKind: int,protocol: int,romBaseline: int,polls: int,small: bool,monitor: bool,report: NativeBuffer): int {
    if (!record.hasAddressRange(0,128) || (record.addressValue() & 3) != 0 ||
        !report.hasAddressRange(0,16) || !esp32S3RetentionBuffersValid(cpu,tags,i,d) ||
        d.logical16K() != small || (small && !d.enabled()) ||
        ((bias | 0) & ~0x1FFFFF) != 0 || ports < 0 || ports > 7 || polls <= 0 || polls > 0x7FFFFFFF ||
        ramKind < -1 || ramKind > 3 || ramKind == 0 || ramKind == 1 || protocol < 0 || protocol > 63 ||
        romBaseline < 0 || romBaseline > 63 || protocol+romBaseline > 63 || (flashOctal && (protocol != 0 || romBaseline != 0))) return 2
    val base=record.addressValue()
    val output=report.addressValue()
    val cpuBase=cpu.addressValue()
    val tagBase=tags.addressValue()
    val tagSize=esp32S3TagBufferBytes(i,d)
    if ((base < cpuBase+8800 && cpuBase < base+128) ||
        (base < tagBase+tagSize && tagBase < base+128) ||
        (output < base+128 && base < output+16) ||
        (output < cpuBase+8800 && cpuBase < output+16) ||
        (output < tagBase+tagSize && tagBase < output+16) || esp32S3MspiStateRead(base) != 0) return 2
    report.storeU32(4,-1); report.storeU32(8,0); report.storeU32(12,0)
    val prepared=esp32S3SleepPrepareOwned(record,bias,ports,flashOctal,ramKind,protocol,romBaseline,polls)
    report.storeU32(0,prepared)
    if (prepared != 1) return if (prepared == 7) 5 else 3
    val armed=esp32S3SleepRecordArmRetentionOwned(record,cpu,tags,i,d,small,monitor)
    report.storeU32(4,armed)
    if (armed == 1) return 1
    val restored=esp32S3SleepRetainedRecordResumeOwned(record,polls)
    report.storeU32(8,restored | 0); report.storeU32(12,(restored | 0)>>>32)
    if (restored.complete()) 4 else 5
}
