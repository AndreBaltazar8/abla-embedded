import "../sdk/raw_buffer.ab"
// IDF6 C5 pmu_sleep_config_default analog policy. No MMIO or sleep entry.
// Caller supplies chip-calibrated values from the corresponding upstream
// get_lslp_dbg/hp_dbias, get_dslp_dbg/lp_dbias and get_act_hp/lp_dbias.
// Output14 U32: HP atten,pd_cur,bias_sleep,xpd,dbias,drv_b;
// LP atten,pd_cur,bias_sleep,slp_xpd,xpd,slp_dbias,dbias,drv_b.
// Valid field encodings alone do not prove safe voltage or retention policy.
trusted fun esp32C5SleepAnalogCalibrated(output: NativeBuffer,deep: bool,
    xtalDown: bool,rcFastDown: bool,xtalAsRtcFast: bool,lpUsesRcFast: bool,
    lightAtten: int,lightHpBias: int,deepAtten: int,deepLpBias: int,
    activeHpBias: int,activeLpBias: int): bool {
    if (!output.hasAddressRange(0,56) || (output.addressValue()&3) != 0 ||
        lightAtten < 0 || lightAtten > 15 || deepAtten < 0 || deepAtten > 15 ||
        lightHpBias < 0 || lightHpBias > 31 || deepLpBias < 0 || deepLpBias > 31 ||
        activeHpBias < 0 || activeHpBias > 31 || activeLpBias < 0 || activeLpBias > 31) return false
    var hpAtten=if (deep) 0 else lightAtten
    var hpCurrent=if (deep) 0 else 1
    var hpBias=if (deep) 0 else lightHpBias
    var lpAtten=if (deep) deepAtten else 1
    var lpCurrent=1
    var lpBias=if (deep) deepLpBias else 15
    if (!deep && (!xtalDown || !rcFastDown)) {
        hpAtten=0;hpCurrent=0;hpBias=activeHpBias
        lpAtten=0;lpCurrent=0;lpBias=activeLpBias
    }
    // These overrides are outside the deep/light branch upstream.
    // XTAL-as-fast also requires the separate power profile to keep HP XTAL on.
    if (xtalAsRtcFast) { hpAtten=0;hpCurrent=0;hpBias=activeHpBias }
    if (lpUsesRcFast) { hpBias=activeHpBias;lpAtten=0;lpBias=activeLpBias }
    output.storeU32(0,hpAtten);output.storeU32(4,hpCurrent);output.storeU32(8,hpCurrent)
    output.storeU32(12,if (deep) 0 else 1);output.storeU32(16,hpBias);output.storeU32(20,0)
    output.storeU32(24,lpAtten);output.storeU32(28,lpCurrent);output.storeU32(32,lpCurrent)
    output.storeU32(36,0);output.storeU32(40,1);output.storeU32(44,0)
    output.storeU32(48,lpBias);output.storeU32(52,0)
    true
}
