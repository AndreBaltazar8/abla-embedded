import "./sleep_entry_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@section(".iram1.abla.c5SleepEntryRead")
@export("c5SleepEntryRead")
trusted fun c5SleepEntryReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5SleepEntryWrite")
@export("c5SleepEntryWrite")
trusted fun c5SleepEntryWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
