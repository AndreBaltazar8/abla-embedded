import "./sleep_entry_c5_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.c5SleepEntryRead")
trusted fun c5SleepEntryRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5SleepEntryWrite")
trusted fun c5SleepEntryWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
