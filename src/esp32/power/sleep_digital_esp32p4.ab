import "./sleep_digital_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepDigitalRead")
trusted fun p4SleepDigitalReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("p4SleepDigitalWrite")
trusted fun p4SleepDigitalWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
