import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// ESP-IDF v6.0.2 esp32p4/sleep_cpu.c noncritical CSR bank, in SDK order.
// 256 bytes: magic,state,hart,reserved; 60 x u32 CSR values.
// Caller owns this hart, disables interrupts, and retains internal code/stack/
// record. Protection mappings must keep those regions accessible throughout
// restore. No debugger/CSR user may modify this bank during the lease.
// Restore AFTER cache/memory recovery: MHCR includes prediction/cache controls.
// This is NOT a context-switch or a CPU power-down entry point: critical GPRs,
// trap CSRs, FPU, CLIC, ROM wake routing and peer-core handshake are separate.
// Matches SDK mcycle LOW-word restoration; not elapsed-time compensation.
// Results 1 saved,2 invalid,3 prerequisite,4 restored. A closed record must be
// explicitly reinitialized by its owner; no implicit overwrite of a live bank.
trusted fun p4CpuAuxRecord(r: NativeBuffer): bool =
    r.hasAddressRange(0,256) && (r.addressValue()&3) == 0
trusted fun esp32p4CpuAuxSaveOwned(r: NativeBuffer,exclusiveHart: bool): int {
    if (!exclusiveHart || !p4CpuAuxRecord(r) || r.loadU32(0) != 0) return 2
    val hart=p4CpuAuxHart()
    if (hart > u32(1) || (p4CpuAuxStatus()&u32(8)) != u32(0)) return 3
    r.storeU32(0,0x50344158);r.storeU32(4,0);r.storeU32(8,int(hart));r.storeU32(12,0)
    r.storeU32(16,int(p4CpuAuxRead(0)))
    r.storeU32(20,int(p4CpuAuxRead(1)))
    r.storeU32(24,int(p4CpuAuxRead(2)))
    r.storeU32(28,int(p4CpuAuxRead(3)))
    r.storeU32(32,int(p4CpuAuxRead(4)))
    r.storeU32(36,int(p4CpuAuxRead(5)))
    r.storeU32(40,int(p4CpuAuxRead(6)))
    r.storeU32(44,int(p4CpuAuxRead(7)))
    r.storeU32(48,int(p4CpuAuxRead(8)))
    r.storeU32(52,int(p4CpuAuxRead(9)))
    r.storeU32(56,int(p4CpuAuxRead(10)))
    r.storeU32(60,int(p4CpuAuxRead(11)))
    r.storeU32(64,int(p4CpuAuxRead(12)))
    r.storeU32(68,int(p4CpuAuxRead(13)))
    r.storeU32(72,int(p4CpuAuxRead(14)))
    r.storeU32(76,int(p4CpuAuxRead(15)))
    r.storeU32(80,int(p4CpuAuxRead(16)))
    r.storeU32(84,int(p4CpuAuxRead(17)))
    r.storeU32(88,int(p4CpuAuxRead(18)))
    r.storeU32(92,int(p4CpuAuxRead(19)))
    r.storeU32(96,int(p4CpuAuxRead(20)))
    r.storeU32(100,int(p4CpuAuxRead(21)))
    r.storeU32(104,int(p4CpuAuxRead(22)))
    r.storeU32(108,int(p4CpuAuxRead(23)))
    r.storeU32(112,int(p4CpuAuxRead(24)))
    r.storeU32(116,int(p4CpuAuxRead(25)))
    r.storeU32(120,int(p4CpuAuxRead(26)))
    r.storeU32(124,int(p4CpuAuxRead(27)))
    r.storeU32(128,int(p4CpuAuxRead(28)))
    r.storeU32(132,int(p4CpuAuxRead(29)))
    r.storeU32(136,int(p4CpuAuxRead(30)))
    r.storeU32(140,int(p4CpuAuxRead(31)))
    r.storeU32(144,int(p4CpuAuxRead(32)))
    r.storeU32(148,int(p4CpuAuxRead(33)))
    r.storeU32(152,int(p4CpuAuxRead(34)))
    r.storeU32(156,int(p4CpuAuxRead(35)))
    r.storeU32(160,int(p4CpuAuxRead(36)))
    r.storeU32(164,int(p4CpuAuxRead(37)))
    r.storeU32(168,int(p4CpuAuxRead(38)))
    r.storeU32(172,int(p4CpuAuxRead(39)))
    r.storeU32(176,int(p4CpuAuxRead(40)))
    r.storeU32(180,int(p4CpuAuxRead(41)))
    r.storeU32(184,int(p4CpuAuxRead(42)))
    r.storeU32(188,int(p4CpuAuxRead(43)))
    r.storeU32(192,int(p4CpuAuxRead(44)))
    r.storeU32(196,int(p4CpuAuxRead(45)))
    r.storeU32(200,int(p4CpuAuxRead(46)))
    r.storeU32(204,int(p4CpuAuxRead(47)))
    r.storeU32(208,int(p4CpuAuxRead(48)))
    r.storeU32(212,int(p4CpuAuxRead(49)))
    r.storeU32(216,int(p4CpuAuxRead(50)))
    r.storeU32(220,int(p4CpuAuxRead(51)))
    r.storeU32(224,int(p4CpuAuxRead(52)))
    r.storeU32(228,int(p4CpuAuxRead(53)))
    r.storeU32(232,int(p4CpuAuxRead(54)))
    r.storeU32(236,int(p4CpuAuxRead(55)))
    r.storeU32(240,int(p4CpuAuxRead(56)))
    r.storeU32(244,int(p4CpuAuxRead(57)))
    r.storeU32(248,int(p4CpuAuxRead(58)))
    r.storeU32(252,int(p4CpuAuxRead(59)))
    p4CpuAuxFence()
    r.storeU32(4,1)
    return 1
}
trusted fun esp32p4CpuAuxRestoreOwned(r: NativeBuffer,exclusiveRecovered: bool): int {
    if (!exclusiveRecovered || !p4CpuAuxRecord(r) || r.loadU32(0) != 0x50344158 ||
        r.loadU32(4) != 1 || r.loadU32(12) != 0) return 2
    if (p4CpuAuxHart() != u32(r.loadU32(8)) || (p4CpuAuxStatus()&u32(8)) != u32(0)) return 3
    r.storeU32(4,2)
    p4CpuAuxWrite(0,u32(r.loadU32(16)))
    p4CpuAuxWrite(1,u32(r.loadU32(20)))
    p4CpuAuxWrite(2,u32(r.loadU32(24)))
    p4CpuAuxWrite(3,u32(r.loadU32(28)))
    p4CpuAuxWrite(4,u32(r.loadU32(32)))
    p4CpuAuxWrite(5,u32(r.loadU32(36)))
    p4CpuAuxWrite(6,u32(r.loadU32(40)))
    p4CpuAuxWrite(7,u32(r.loadU32(44)))
    p4CpuAuxWrite(8,u32(r.loadU32(48)))
    p4CpuAuxWrite(9,u32(r.loadU32(52)))
    p4CpuAuxWrite(10,u32(r.loadU32(56)))
    p4CpuAuxWrite(11,u32(r.loadU32(60)))
    p4CpuAuxWrite(12,u32(r.loadU32(64)))
    p4CpuAuxWrite(13,u32(r.loadU32(68)))
    p4CpuAuxWrite(14,u32(r.loadU32(72)))
    p4CpuAuxWrite(15,u32(r.loadU32(76)))
    p4CpuAuxWrite(16,u32(r.loadU32(80)))
    p4CpuAuxWrite(17,u32(r.loadU32(84)))
    p4CpuAuxWrite(18,u32(r.loadU32(88)))
    p4CpuAuxWrite(19,u32(r.loadU32(92)))
    p4CpuAuxWrite(20,u32(r.loadU32(96)))
    p4CpuAuxWrite(21,u32(r.loadU32(100)))
    p4CpuAuxWrite(22,u32(r.loadU32(104)))
    p4CpuAuxWrite(23,u32(r.loadU32(108)))
    p4CpuAuxWrite(24,u32(r.loadU32(112)))
    p4CpuAuxWrite(25,u32(r.loadU32(116)))
    p4CpuAuxWrite(26,u32(r.loadU32(120)))
    p4CpuAuxWrite(27,u32(r.loadU32(124)))
    p4CpuAuxWrite(28,u32(r.loadU32(128)))
    p4CpuAuxWrite(29,u32(r.loadU32(132)))
    p4CpuAuxWrite(30,u32(r.loadU32(136)))
    p4CpuAuxWrite(31,u32(r.loadU32(140)))
    p4CpuAuxWrite(32,u32(r.loadU32(144)))
    p4CpuAuxWrite(33,u32(r.loadU32(148)))
    p4CpuAuxWrite(34,u32(r.loadU32(152)))
    p4CpuAuxWrite(35,u32(r.loadU32(156)))
    p4CpuAuxWrite(36,u32(r.loadU32(160)))
    p4CpuAuxWrite(37,u32(r.loadU32(164)))
    p4CpuAuxWrite(38,u32(r.loadU32(168)))
    p4CpuAuxWrite(39,u32(r.loadU32(172)))
    p4CpuAuxWrite(40,u32(r.loadU32(176)))
    p4CpuAuxWrite(41,u32(r.loadU32(180)))
    p4CpuAuxWrite(42,u32(r.loadU32(184)))
    p4CpuAuxWrite(43,u32(r.loadU32(188)))
    p4CpuAuxWrite(44,u32(r.loadU32(192)))
    p4CpuAuxWrite(45,u32(r.loadU32(196)))
    p4CpuAuxWrite(46,u32(r.loadU32(200)))
    p4CpuAuxWrite(47,u32(r.loadU32(204)))
    p4CpuAuxWrite(48,u32(r.loadU32(208)))
    p4CpuAuxWrite(49,u32(r.loadU32(212)))
    p4CpuAuxWrite(50,u32(r.loadU32(216)))
    p4CpuAuxWrite(51,u32(r.loadU32(220)))
    p4CpuAuxWrite(52,u32(r.loadU32(224)))
    p4CpuAuxWrite(53,u32(r.loadU32(228)))
    p4CpuAuxWrite(54,u32(r.loadU32(232)))
    p4CpuAuxWrite(55,u32(r.loadU32(236)))
    p4CpuAuxWrite(56,u32(r.loadU32(240)))
    p4CpuAuxWrite(57,u32(r.loadU32(244)))
    p4CpuAuxWrite(58,u32(r.loadU32(248)))
    p4CpuAuxWrite(59,u32(r.loadU32(252)))
    p4CpuAuxFence()
    r.storeU32(4,3)
    return 4
}
