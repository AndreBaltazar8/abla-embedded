import "./retention_descriptor_p4.ab"
// Exact continuous entries from P4 system_retention_periph.c, hw_ver1/3.
// Profiles0/1: CPU0/CPU1 interrupt matrices;2 HP system;3 PAU;4 PVT.
// All belong to PAU entry0 and backup+restore in both directions. These are
// configuration builders ONLY, not live software copies or complete plans.
// PAU self-retention includes its control registers per upstream: caller must
// use the correct quiescent hardware recovery context, not replay via CPU MMIO.
// Complete sleep also needs cache, clocks, IOMUX, MSPI, timers and CPU context.
fun esp32p4RetentionSystemBase(profile: int): int =
    if (profile == 0) 0x500d6000 else if (profile == 1) 0x500d6800 else if (profile == 2) 0x500e5000 else
    if (profile == 3) 0x50082000 else if (profile == 4) 0x5009e000 else 0
fun esp32p4RetentionSystemWords(profile: int): int =
    if (profile == 0 || profile == 1) 133 else if (profile == 2) 101 else if (profile == 3) 13 else if (profile == 4) 115 else 0
// Fill the generic descriptor encoder's56B config; no allocation/activation.
// Zero next means terminal leaf. Storage points at retained backup words,
// not at a descriptor. All invalid requests preserve the entire config.
trusted fun esp32p4RetentionSystemConfig(c: NativeBuffer,profile: int,storage: int,next: int): bool {
    val words=esp32p4RetentionSystemWords(profile)
    if (words == 0 || !c.hasAddressRange(0,56) || (c.addressValue()&3) != 0 ||
        !p4RetentionAddressSpan(storage,words*4) || (next != 0 && !p4RetentionAddressSpan(next,4))) return false
    if (storage < c.addressValue()+56 && c.addressValue() < storage+words*4) return false
    if (next != 0 && next < c.addressValue()+56 && c.addressValue() < next+4) return false
    var i=4
    while (i < 56) { c.storeU32(i,0);i=i+4 }
    c.storeU32(4,next);c.storeU32(20,esp32p4RetentionSystemBase(profile));c.storeU32(24,esp32p4RetentionSystemBase(profile));c.storeU32(28,storage)
    c.storeU32(0,words|(if (next == 0) 0x80000000 else 0));return true
}
