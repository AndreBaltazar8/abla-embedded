import "./sleep_rendezvous_p4_sequence.ab"
import "./sleep_peer_irq_esp32p4.ab"
import "../../hal/esp32_power.ab"
import "../sdk/raw_buffer.ab"
import "./sleep_peer_irq_p4_sequence.ab"
import "./sleep_peer_p4_sequence.ab"
import "../sdk/nativebuffer_type.ab"
@export("p4RendezvousPrepare")
trusted fun p4RendezvousPrepareHook(payload: NativeBuffer,smp: NativeBuffer,generation: int,peer: int): int = esp32p4SleepPeerIrqPrepareOwned(payload,smp,generation,peer,300,true)
@export("p4RendezvousNotify")
trusted fun p4RendezvousNotifyHook(smp: NativeBuffer,generation: int,polls: int): int = esp32p4SleepPeerNotifyOwned(smp,generation,polls,true)
