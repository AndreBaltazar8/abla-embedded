import "./sleep_rendezvous_p4_sequence.ab"
import "./sleep_peer_irq_esp32p4.ab"
trusted fun p4RendezvousPrepare(payload: NativeBuffer,smp: NativeBuffer,generation: int,peer: int): int = esp32p4SleepPeerIrqPrepareOwned(payload,smp,generation,peer,300,true)
trusted fun p4RendezvousNotify(smp: NativeBuffer,generation: int,polls: int): int = esp32p4SleepPeerNotifyOwned(smp,generation,polls,true)
