import "abla/runtime/scalar"
// P4 current-core branch prediction lease, preceding external-cache suspend.
// MHCR0x7c1: return stack4, predictive jump5, BTB12 (mask1030).
// Caller executes in machine mode (no TEE delegation), pins this hart and
// excludes concurrent CSR users. Other core/IRQs/DMA remain separate owners.
// Restore only AFTER external memory/cache is usable. Other MHCR bits may
// change independently and are preserved by atomic CSR clear/set operations.
// Token old3bits@8,owned11,hart@12.1disabled2invalid3partial4restored.
type P4SleepPredictor=int
fun P4SleepPredictor.status(): int = this&255
fun P4SleepPredictor.hasSnapshot(): bool = (this&2048) != 0
trusted fun esp32p4SleepPredictorDisableOwned(exclusiveHart: bool): P4SleepPredictor {
    if (!exclusiveHart) return P4SleepPredictor(2)
    val hart=int(p4SleepPredictorHart())
    if (hart < 0 || hart > 1) return P4SleepPredictor(2)
    val old=int(p4SleepPredictorClear(u32(0x1030)))
    val saved=((old>>>4)&3)|(((old>>>12)&1)<<2)
    val token=2048|(saved<<8)|(hart<<12)
    return P4SleepPredictor(token|(if ((p4SleepPredictorRead()&u32(0x1030)) == u32(0)) 1 else 3))
}
trusted fun P4SleepPredictor.closeOwned(exclusiveCacheRestored: bool): P4SleepPredictor {
    if (!exclusiveCacheRestored || !this.hasSnapshot() || this.status() == 4 || int(p4SleepPredictorHart()) != ((this>>>12)&1)) return this
    val bits=(this>>>8)&7
    val expected=u32(((bits&3)<<4)|((bits>>>2)<<12))
    p4SleepPredictorClear(u32(0x1030))
    p4SleepPredictorSet(expected)
    return P4SleepPredictor((this&(~255))|(if ((p4SleepPredictorRead()&u32(0x1030)) == expected) 4 else 3))
}
