import "./sleep_fpu_p4_sequence.ab"
trusted noescape extern:"inline-assembly" fun p4SleepFpuAsmRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4SleepFpuAsmWrite(template: string,constraints: string,value: u32): void
trusted noescape extern:"inline-assembly" fun p4SleepFpuAsmFence(template: string,constraints: string): void
trusted fun p4SleepFpuHart(): u32 = p4SleepFpuAsmRead("csrr $0, mhartid","=r,~{memory}")
trusted fun p4SleepFpuStatus(): u32 = p4SleepFpuAsmRead("csrr $0, mstatus","=r,~{memory}")
trusted fun p4SleepFpuFence(): void = p4SleepFpuAsmFence("fence iorw, iorw","~{memory}")
trusted fun p4SleepFpuSetFs(fs: u32): void {
    p4SleepFpuAsmWrite("csrc mstatus, $0","r,~{memory}",u32(0x6000))
    p4SleepFpuAsmWrite("csrs mstatus, $0","r,~{memory}",fs)
    return
}
trusted fun p4SleepFpuControlRead(): u32 = p4SleepFpuAsmRead("csrr $0, 0x003","=r,~{memory}")
trusted fun p4SleepFpuControlWrite(value: u32): void = p4SleepFpuAsmWrite("csrw 0x003, $0","r,~{memory}",value)
