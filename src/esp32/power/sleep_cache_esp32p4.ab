import "./sleep_cache_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun p4SleepCacheAsm(template: string,constraints: string): void
trusted fun p4SleepCacheFence(): void = p4SleepCacheAsm("fence iorw, iorw","~{memory}")
trusted fun p4SleepCacheRead(offset: int): u32 = u32(mmioLoadU32(0x3ff10000+offset))
trusted fun p4SleepCacheWrite(offset: int,value: u32): void { mmioStoreU32(0x3ff10000+offset,int(value));return }
