import "./sleep_cache_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
trusted noescape extern:"inline-assembly" fun p4SleepCacheAsm(template: string,constraints: string): void
@export("p4SleepCacheFence")
trusted fun p4SleepCacheFenceHook(): void = p4SleepCacheAsm("fence iorw, iorw","~{memory}")
@export("p4SleepCacheRead")
trusted fun p4SleepCacheReadHook(offset: int): u32 = u32(mmioLoadU32(0x3ff10000+offset))
@export("p4SleepCacheWrite")
trusted fun p4SleepCacheWriteHook(offset: int,value: u32): void { mmioStoreU32(0x3ff10000+offset,int(value));return }
