import "./sleep_record_c5.ab"
import "../sdk/raw_buffer.ab"
// C5 pmu_sleep_digital_init: SYSCLK enable27, full functional gate mask,
// and light-sleep pad selection27. Deep sleep leaves pad selection untouched.
// Caller owns PMU sleep configuration, excludes sleep entry/other writers and
// separately supplies retention/power policy. No CPU stall or live gate writes.
//32B:tag0,status4,original SYSCLK8/FUNC12/PAD16,close index20,count24,reserved28.
//1configured2invalid3partial failure4closed; cleanup resumable in reverse.
@section(".iram1.abla.c5SleepDigitalOffset")
fun c5SleepDigitalOffset(index: int): int = if (index == 0) 0x8c else if (index == 1) 0x6c else 0x78
@section(".iram1.abla.c5SleepDigitalMask")
fun c5SleepDigitalMask(index: int): int = if (index == 1) 4294967295 else 0x08000000
@section(".iram1.abla.c5SleepDigitalField")
@inline
trusted fun c5SleepDigitalField(index: int,value: int): bool {
    val offset=c5SleepDigitalOffset(index);val mask=c5SleepDigitalMask(index)
    c5SleepDigitalWrite(offset,(c5SleepDigitalRead(offset)&~mask)|(value&mask))
    (c5SleepDigitalRead(offset)&mask) == (value&mask)
}
@section(".iram1.abla.esp32C5SleepDigitalStatus")
trusted fun esp32C5SleepDigitalStatus(record: NativeBuffer): int =
    if (!record.hasAddressRange(0,32) || c5SleepRecordRead(record,0) != 0x43444731) 2 else c5SleepRecordRead(record,4)
trusted fun esp32C5SleepDigitalApplyOwned(record: NativeBuffer,functionalClocks: u32,deep: bool,topPoweredDown: bool,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,32) || (deep && functionalClocks != u32(0))) return 2
    if (c5SleepRecordRead(record,0) == 0x43444731 && c5SleepRecordRead(record,4) != 4) return 2
    val count=if (deep) 2 else 3
    c5SleepRecordWrite(record,0,0x43444731);c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,20,count-1);c5SleepRecordWrite(record,24,count);c5SleepRecordWrite(record,28,0)
    var i=0;while (i < count) { c5SleepRecordWrite(record,8+i*4,c5SleepDigitalRead(c5SleepDigitalOffset(i)));i=i+1 }
    if (!c5SleepDigitalField(0,if (functionalClocks != u32(0)) 0x08000000 else 0) ||
        !c5SleepDigitalField(1,int(functionalClocks))) return 3
    if (!deep && !c5SleepDigitalField(2,if (topPoweredDown) 0 else 0x08000000)) return 3
    c5SleepRecordWrite(record,4,1)
    1
}
@section(".iram1.abla.esp32C5SleepDigitalCloseOwned")
trusted fun esp32C5SleepDigitalCloseOwned(record: NativeBuffer,exclusive: bool): int {
    if (!exclusive) return 2
    val status=esp32C5SleepDigitalStatus(record)
    if (status == 2 || status == 4) return status
    var index=c5SleepRecordRead(record,20)
    if (c5SleepRecordRead(record,24) < 2 || c5SleepRecordRead(record,24) > 3 || index >= c5SleepRecordRead(record,24)) return 2
    // Fixed reverse stages keep offset/mask selection constant: no flash jump tables.
    if (index >= 2) {
        if (!c5SleepDigitalField(2,c5SleepRecordRead(record,16))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,20,1)
    }
    if (index >= 1) {
        if (!c5SleepDigitalField(1,c5SleepRecordRead(record,12))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,20,0)
    }
    if (index >= 0) {
        if (!c5SleepDigitalField(0,c5SleepRecordRead(record,8))) { c5SleepRecordWrite(record,4,3);return 3 }
    }
    c5SleepRecordWrite(record,4,4)
    4
}
