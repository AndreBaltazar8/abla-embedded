import "./sleep_policy_p4_sequence.ab"
import "../sdk/raw_buffer.ab"
// Called only by the round after all owners and SMP peers have recovered.
// Capture causes before irreversible WT acknowledgement. Keep captures through
// dropped-write retries. No-request abort never clears an unrelated old event.
// Caller still excludes new requests/PMU writers even though SMP is now idle.
// Results1finished2invalid3event mismatch4ack/readback pending.
trusted fun esp32p4SleepRoundFinishOwned(r: NativeBuffer,exclusiveCompleted: bool): int {
    if (!exclusiveCompleted || !r.hasAddressRange(0,2168) || (r.addressValue()&15) != 0 ||
        r.loadU32(0) != 0x5034524e || r.loadU32(4) != 13) return 2
    val outcome=r.loadU32(52)
    if (outcome == 10) return 1
    if (outcome < 1 || outcome > 3 || r.loadU32(460) > 2) return 2
    val expected=if (outcome == 1) 2 else if (outcome == 2) 1 else 3
    if (r.loadU32(460) == 2) return 1
    if (r.loadU32(460) == 0) {
        val events=esp32p4SleepEvents()
        if (events != expected) return 3
        r.storeU32(60,int(esp32p4SleepWakeCause()));r.storeU32(452,int(esp32p4SleepRejectCause()))
        r.storeU32(456,events);r.storeU32(460,1)
    }
    if (!esp32p4SleepAcknowledgeOwned(expected,(expected&1) != 0,true)) return 4
    val remaining=esp32p4SleepEvents()
    if ((remaining&(~expected)) != 0) return 3
    if ((remaining&expected) != 0 || ((expected&1) != 0 && esp32p4SleepRejectCause() != u32(0))) return 4
    r.storeU32(460,2);return 1
}
