import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// P4 pmu_sleep_power_init state fields, NOT immediate force-power controls.
// Caller excludes every HP/LP state transition, owns PMU globally, and has
// validated its retention/oscillator/voltage policy. No fabricated defaults.
// Configuration32B: HPsleep digital/clock/XTAL, LPactive digital/clock,
// LPsleep digital/clock/XTAL, each already positioned register bits.
// Record52B: magic/state/primary/cleanup/layout then eight old field values.
import "./sleep_power_fields_p4.ab"
trusted fun p4SleepPowerSet(i: int,layout: int,value: u32): bool {
    val offset=p4SleepPowerOffset(i);val mask=p4SleepPowerMask(i,layout)
    p4SleepPowerWrite(offset,(p4SleepPowerRead(offset)&~mask)|(value&mask))
    return (p4SleepPowerRead(offset)&mask) == (value&mask)
}
//1ready2invalid3partial4closed. Reject CPU powerdown bit29 on layout1.
trusted fun esp32p4SleepPowerOpenOwned(r: NativeBuffer,config: NativeBuffer,layout: int,exclusive: bool): int {
    if (!exclusive || (layout != 1 && layout != 3) || !r.hasAddressRange(0,52) ||
        !config.hasAddressRange(0,32) || (r.addressValue()&3) != 0 || (config.addressValue()&3) != 0 || r.loadU32(0) != 0) return 2
    if (r.addressValue() < config.addressValue()+32 && config.addressValue() < r.addressValue()+52) return 2
    var i=0
    while (i < 8) {
        if ((u32(config.loadU32(i*4))&~p4SleepPowerMask(i,layout)) != u32(0)) return 2
        i=i+1
    }
    r.storeU32(0,0x50345031);r.storeU32(4,3);r.storeU32(8,0);r.storeU32(12,0);r.storeU32(16,layout)
    i=0
    while (i < 8) {
        r.storeU32(20+i*4,int(p4SleepPowerRead(p4SleepPowerOffset(i))&p4SleepPowerMask(i,layout)));i=i+1
    }
    i=0
    while (i < 8) {
        if (!p4SleepPowerSet(i,layout,u32(config.loadU32(i*4)))) { r.storeU32(8,i+1);return 3 }
        i=i+1
    }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4SleepPowerCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,52) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50345031) return 2
    val layout=r.loadU32(16)
    if (layout != 1 && layout != 3) return 2
    if (r.loadU32(4) == 4) return 4
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    r.storeU32(4,3)
    var i=7
    while (i >= 0) {
        if (!p4SleepPowerSet(i,layout,u32(r.loadU32(20+i*4)))) { r.storeU32(12,i+1);return 3 }
        i=i-1
    }
    r.storeU32(12,0);r.storeU32(4,4);return 4
}
