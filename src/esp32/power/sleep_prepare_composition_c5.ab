import "./sleep_prepare_c5_sequence.ab"
import "./sleep_time_session_c5_sequence.ab"
import "./sleep_uarts_c5_sequence.ab"
import "../clock_park_c5_sequence.ab"
import "../clock_resume_c5_sequence.ab"
@inline
trusted fun c5SleepPrepareTimeCapture(record: NativeBuffer,period: int,polls: int): int = esp32C5SleepTimeCaptureOwned(record,period,true,polls)
@inline
trusted fun c5SleepPrepareTimeCancel(record: NativeBuffer): int = esp32C5SleepTimeFinishOwned(record,-1,true)
@inline
trusted fun c5SleepPrepareUarts(ports: int,polls: int): int = esp32C5SleepUartsPrepareOwned(ports,false,polls,true)|0
@inline
trusted fun c5SleepPrepareUartsResume(token: int): int = esp32C5SleepUartsResumeOwned(Esp32C5SleepUarts(token),true)|0
@inline
trusted fun c5SleepPreparePark(record: NativeBuffer,pvt: bool): int = esp32C5ClockParkOwned(record,pvt,true)
@inline
trusted fun c5SleepPrepareRestore(record: NativeBuffer,plan: C5CpuClock,pvt: bool): int = esp32C5ClockResumeOwned(record,plan,pvt,true)
