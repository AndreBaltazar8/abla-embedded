import "./sleep_prepare_c5_sequence.ab"
import "./sleep_time_session_c5_sequence.ab"
import "./sleep_uarts_c5_sequence.ab"
import "../clock_park_c5_sequence.ab"
import "../clock_resume_c5_sequence.ab"
import "../../hal/esp32_power.ab"
@inline
@export("c5SleepPrepareTimeCapture")
trusted fun c5SleepPrepareTimeCaptureHook(record: NativeBuffer,period: int,polls: int): int = esp32C5SleepTimeCaptureOwned(record,period,true,polls)
@inline
@export("c5SleepPrepareTimeCancel")
trusted fun c5SleepPrepareTimeCancelHook(record: NativeBuffer): int = esp32C5SleepTimeFinishOwned(record,-1,true)
@inline
@export("c5SleepPrepareUarts")
trusted fun c5SleepPrepareUartsHook(ports: int,polls: int): int = esp32C5SleepUartsPrepareOwned(ports,false,polls,true)|0
@inline
@export("c5SleepPrepareUartsResume")
trusted fun c5SleepPrepareUartsResumeHook(token: int): int = esp32C5SleepUartsResumeOwned(Esp32C5SleepUarts(token),true)|0
@inline
@export("c5SleepPreparePark")
trusted fun c5SleepPrepareParkHook(record: NativeBuffer,pvt: bool): int = esp32C5ClockParkOwned(record,pvt,true)
@inline
trusted fun c5SleepPrepareRestore(record: NativeBuffer,plan: C5CpuClock,pvt: bool): int = esp32C5ClockResumeOwned(record,plan,pvt,true)
