import "./sleep_power_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepPowerRead")
trusted fun p4SleepPowerReadHook(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
@export("p4SleepPowerWrite")
trusted fun p4SleepPowerWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value));return }
