// S3 USB Serial/JTAG pad-leakage workaround from IDF sleep_console.c.
// Exclusive ownership of USB console, pads19/20 and shared RCC required.
// Quiesce producers first: this disconnects USB, it does not preserve traffic.
// A disabled/reset module is reset and normalized to clock-off/reset-clear,
// pads-off, matching IDF. It does NOT restore stale disabled-module registers.
type Esp32S3SleepUsbSerial = int
@inline
fun Esp32S3SleepUsbSerial.valid(): bool = this == 4 || this == 5 || this == 7
@inline
trusted fun esp32S3SleepUsbUpdate(address: int,mask: int,value: int): void {
    esp32S3SleepUsbWrite(address,(esp32S3SleepUsbRead(address) & (0xFFFFFFFF ^ mask)) | (value & mask))
    return
}
@section(".iram1.abla.s3SleepUsbPrepare")
trusted fun esp32S3SleepUsbSerialPrepareOwned(): Esp32S3SleepUsbSerial {
    val enabled=(esp32S3SleepUsbRead(0x600C001C) & 1024) != 0 && (esp32S3SleepUsbRead(0x600C0024) & 1024) == 0
    var pad=false
    if (!enabled) {
        esp32S3SleepUsbUpdate(0x600C001C,1024,1024)
        esp32S3SleepUsbUpdate(0x600C0024,1024,1024)
        esp32S3SleepUsbUpdate(0x600C0024,1024,0)
    } else pad=(esp32S3SleepUsbRead(0x60038018) & 16384) != 0
    esp32S3SleepUsbUpdate(0x60038018,16384,0)
    esp32S3SleepUsbUpdate(0x600C001C,1024,0)
    Esp32S3SleepUsbSerial(4 | (if (enabled) 1 else 0) | (if (pad) 2 else 0))
}
// Single-use token; no nesting/copies. Refuse external clock/reset ownership
// changes before any write. Other register bits are preserved, not replayed.
@section(".iram1.abla.s3SleepUsbRestore")
trusted fun esp32S3SleepUsbSerialRestoreOwned(saved: Esp32S3SleepUsbSerial): bool {
    if (!saved.valid()) return false
    if ((esp32S3SleepUsbRead(0x600C001C) & 1024) != 0 || (esp32S3SleepUsbRead(0x600C0024) & 1024) != 0) return false
    esp32S3SleepUsbUpdate(0x600C001C,1024,1024)
    esp32S3SleepUsbUpdate(0x60038018,16384,if (((saved | 0) & 2) != 0) 16384 else 0)
    if (((saved | 0) & 1) == 0) esp32S3SleepUsbUpdate(0x600C001C,1024,0)
    true
}
