import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Complete pmu_sleep_param_init timing fields, in hardware cycles, not us.
// Caller owns PMU timing globally and excludes sleep/HP-LP mode transitions.
// No calibrated defaults, power profile, cache retention or sleep request.
// 40B aligned caller record: magic/state/primary/cleanup, six original fields.
// Nest inside sleep-policy ownership (both touch HP minimum); close in reverse.
fun p4SleepTimingOffset(i: int): int = if (i == 0) 300 else if (i == 1) 316 else
    if (i == 2) 308 else if (i == 3) 236 else if (i == 4) 240 else 284
fun p4SleepTimingMask(i: int): u32 = if (i == 0) u32(65535) else if (i == 1) u32(0xffff0000) else
    if (i == 2) u32(0xff000000) else if (i == 3 || i == 4) u32(0xffffc000) else u32(0xffffffff)
trusted fun p4SleepTimingSet(i: int,value: u32): bool {
    val offset=p4SleepTimingOffset(i);val mask=p4SleepTimingMask(i)
    p4SleepTimingWrite(offset,(p4SleepTimingRead(offset)&~mask)|(value&mask))
    return (p4SleepTimingRead(offset)&mask) == (value&mask)
}
//1ready2invalid3partial4closed. All inputs checked before any MMIO or mutation.
trusted fun esp32p4SleepTimingOpenOwned(r: NativeBuffer,hpMin: int,lpMin: int,hpAnalog: int,lpAnalog: int,
    hpSupply: int,hpUp: int,lpSupply: int,lpUp: int,xtal: int,pll: int,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,40) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 ||
        hpMin < 0 || hpMin > 255 || lpMin < 0 || lpMin > 255 || hpAnalog < 0 || hpAnalog > 65535 ||
        lpAnalog < 0 || lpAnalog > 255 || hpSupply < 0 || hpSupply > 511 || hpUp < 0 || hpUp > 511 ||
        lpSupply < 0 || lpSupply > 511 || lpUp < 0 || lpUp > 511 || xtal < 0 || xtal > 65535 || pll < 0 || pll > 65535) return 2
    r.storeU32(0,0x50345431);r.storeU32(4,3);r.storeU32(8,0);r.storeU32(12,0)
    var i=0
    while (i < 6) {
        r.storeU32(16+i*4,int(p4SleepTimingRead(p4SleepTimingOffset(i))&p4SleepTimingMask(i)));i=i+1
    }
    i=0
    while (i < 6) {
        val value=if (i == 0) u32((hpMin<<8)|lpMin) else if (i == 1) u32(hpAnalog)<<u32(16) else
            if (i == 2) u32(lpAnalog)<<u32(24) else if (i == 3) (u32(hpSupply)<<u32(23))|(u32(hpUp)<<u32(14)) else
            if (i == 4) (u32(lpSupply)<<u32(23))|(u32(lpUp)<<u32(14)) else u32(xtal)|(u32(pll)<<u32(16))
        if (!p4SleepTimingSet(i,value)) { r.storeU32(8,i+1);return 3 }
        i=i+1
    }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4SleepTimingCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,40) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50345431) return 2
    if (r.loadU32(4) == 4) return 4
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    r.storeU32(4,3)
    var i=5
    while (i >= 0) {
        if (!p4SleepTimingSet(i,u32(r.loadU32(16+i*4)))) { r.storeU32(12,i+1);return 3 }
        i=i-1
    }
    r.storeU32(12,0);r.storeU32(4,4);return 4
}
