import "./wake_timer_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4WakeTimerRead")
trusted fun p4WakeTimerReadHook(offset: int): u32 = u32(mmioLoadU32(0x50112000+offset))
@export("p4WakeTimerWrite")
trusted fun p4WakeTimerWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50112000+offset,int(value));return }
