import "./retention_routed_session_p4_sequence.ab"
import "./retention_list_p4.ab"
import "./sleep_cache_p4_sequence.ab"
// Publish immutable generated descriptors/backing before installing ANY PAU
// pointers or PMU enables. Caller supplies GraphEncode output and its backing,
// owns retained DMA-accessible memory, clocks, all triggers/cache users, and
// keeps buffers alive and unchanged until close. Semantic graph validation is
// the encoder's job; this checks supplied heads, spans and ownership aliases.
// No sleep request or CPU/rail setup. Record144B in retained internal RAM:
// magic,state,result,detail; routed88@16; config32@104; entry3@136;reserved.
// States1publication,2ready,3partial child,4closed. Results1ready2invalid
// 3clock/engine unavailable4publication failure5pending6child failure7cleanup
// 8closed. A cache timeout retains ownership; retry only after engine idle.
trusted fun p4RetentionPublishedResult(r: NativeBuffer,result: int,detail: int): int {
    r.storeU32(8,result);r.storeU32(12,detail);return result
}
trusted fun esp32p4RetentionPublishedContinueOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || polls < 1 || polls > 1000000 || !r.hasAddressRange(0,144) ||
        (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50345031) return 2
    if (r.loadU32(4) == 2) return 1
    if (r.loadU32(4) == 3) return 6
    if (r.loadU32(4) != 1) return 2
    if (!p4RetentionClockReady() || (p4RetentionPauRead(0)&u32(7)) != u32(0) ||
        (p4RetentionPauRead(52)&u32(2)) != u32(0)) return p4RetentionPublishedResult(r,3,0)
    if ((p4SleepCacheRead(152)&u32(15)) != u32(0)) return p4RetentionPublishedResult(r,5,3)
    val clean=esp32p4SleepCacheWritebackOwned(polls,true)
    if (clean != 1) return p4RetentionPublishedResult(r,if (clean == 5 || clean == 3) 5 else 4,clean)
    // The helper ends with a memory fence. Subsequent stores affect only this
    // internal record and MMIO, never the published graph or backup storage.
    r.storeU32(4,3)
    val opened=esp32p4RetentionRoutedSessionOpenOwned(nativeBufferAt(r.addressValue()+16,88),nativeBufferAt(r.addressValue()+104,32),r.loadU32(136),true)
    if (opened != 1) return p4RetentionPublishedResult(r,6,opened)
    r.storeU32(4,2);return p4RetentionPublishedResult(r,1,0)
}
trusted fun esp32p4RetentionPublishedOpenOwned(r: NativeBuffer,c: NativeBuffer,entry3: int,graph: NativeBuffer,backing: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || polls < 1 || polls > 1000000 || !r.hasAddressRange(0,144) ||
        (r.addressValue()&3) != 0 || r.loadU32(0) != 0 || !p4RetentionSessionConfigValid(c) ||
        !graph.hasAddressRange(0,20) || !backing.hasAddressRange(0,4) ||
        (graph.addressValue()&3) != 0 || (backing.addressValue()&3) != 0) return 2
    // Exact supplied extents must be valid 32-bit hardware spans.
    if (!p4RetentionAddressSpan(graph.addressValue(),graph.capacity()) || !p4RetentionAddressSpan(backing.addressValue(),backing.capacity()) ||
        p4RetentionRangesOverlap(graph.addressValue(),graph.capacity(),backing.addressValue(),backing.capacity()) ||
        p4RetentionRangesOverlap(r.addressValue(),144,graph.addressValue(),graph.capacity()) ||
        p4RetentionRangesOverlap(r.addressValue(),144,backing.addressValue(),backing.capacity()) ||
        p4RetentionRangesOverlap(r.addressValue(),144,c.addressValue(),32)) return 2
    var i=0
    while (i < 4) {
        val head=if (i == 3) entry3 else c.loadU32(i*4)
        if (head != 0 && ((head&3) != 0 || !graph.hasAddressRange(head-graph.addressValue(),20))) return 2
        i=i+1
    }
    i=4
    while (i < 144) { r.storeU32(i,0);i=i+4 }
    i=0
    while (i < 32) { r.storeU32(104+i,c.loadU32(i));i=i+4 }
    r.storeU32(136,entry3);r.storeU32(0,0x50345031);r.storeU32(4,1)
    return esp32p4RetentionPublishedContinueOwned(r,polls,true)
}
trusted fun esp32p4RetentionPublishedCloseOwned(r: NativeBuffer,exclusiveIdle: bool): int {
    if (!exclusiveIdle || !r.hasAddressRange(0,144) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50345031) return 2
    val state=r.loadU32(4)
    if (state == 4) return 8
    if (state < 1 || state > 3) return 2
    if ((p4SleepCacheRead(152)&u32(15)) != u32(0)) return p4RetentionPublishedResult(r,5,3)
    val child=nativeBufferAt(r.addressValue()+16,88)
    if (child.loadU32(0) != 0) {
        if (!p4RetentionClockReady() || (p4RetentionPauRead(0)&u32(7)) != u32(0)) return p4RetentionPublishedResult(r,7,3)
        // Cleanup may have disabled only part of the session on failure.
        // Never advertise readiness again once a child close was attempted.
        r.storeU32(4,3)
        val closed=esp32p4RetentionRoutedSessionCloseOwned(child,true)
        if (closed != 8) return p4RetentionPublishedResult(r,7,closed)
    }
    r.storeU32(4,4);return p4RetentionPublishedResult(r,8,0)
}
