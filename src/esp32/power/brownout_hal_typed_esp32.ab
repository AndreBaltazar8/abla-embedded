import "../../xtensa/assembly.ab"
import "abla/unsafe/memory"

// ESP32 brownout detector policy expressed through the target instruction
// parser. Ordinary loads and bit arithmetic expand to typed Abla IR; only the
// volatile RTCCNTL access retains device semantics. The six sequential C
// read-modify-writes collapse into one because no intermediate register state
// is observable.
trusted fun esp32BrownoutHalConfig(configuration: u32): void {
    val threshold = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(configuration))))
    val enabled = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(configuration + u32(1)))))
    val resetEnabled = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(configuration + u32(2)))))
    val flashPowerDown = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(configuration + u32(3)))))
    val radioPowerDown = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(configuration + u32(4)))))

    val configured =
        u32(0x03ff0000) |
        ((flashPowerDown & u32(1)) << u32(14)) |
        ((radioPowerDown & u32(1)) << u32(15)) |
        ((resetEnabled & u32(1)) << u32(26)) |
        ((threshold & u32(7)) << u32(27)) |
        ((enabled & u32(1)) << u32(30))

    val registerAddress = u32(0x3ff480d4)
    val previous = xtensaDeviceLoadU32(registerAddress)
    xtensaDeviceStoreU32(registerAddress, (previous & ~u32(0x7c00c000)) | configured)
}
