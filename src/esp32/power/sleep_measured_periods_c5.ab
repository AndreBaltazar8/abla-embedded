import "../clock_calibrate_c5_sequence.ab"
// Populate only the slow/fast Q19 words of the unified68B sleep request from
// successfully completed hardware measurements. IDF PMU fast timing uses
// measured RC_FAST, not the selected LP_FAST XTAL/2 period.
// Caller excludes all clock/mux/oscillator changes and uses fresh measurements.
// Reject in-progress/failed/stale-source records before either output write.
trusted fun esp32C5SleepMeasuredPeriodsOwned(request: NativeBuffer,slow: NativeBuffer,fast: NativeBuffer,exclusive: bool): bool {
    if (!exclusive || !request.hasAddressRange(0,68) || !slow.hasAddressRange(0,64) || !fast.hasAddressRange(0,64)) return false
    val output=request.addressValue();val a=slow.addressValue();val b=fast.addressValue()
    if ((output < a+64 && a < output+68) || (output < b+64 && b < output+68)) return false
    if (c5SleepRecordRead(slow,0) != 0x43414c31 || c5SleepRecordRead(fast,0) != 0x43414c31 ||
        c5SleepRecordRead(slow,4) != 1 || c5SleepRecordRead(fast,4) != 1 || c5SleepRecordRead(fast,12) != 4) return false
    val source=c5CalibrationRead(0x600b0400)&3
    if (source == 2 || c5SleepRecordRead(slow,12) != (if (source == 0) 3 else if (source == 1) 1 else 2)) return false
    val xtal=(c5CalibrationRead(0x60096110)>>>24)&127
    if (c5SleepRecordRead(slow,20) != xtal || c5SleepRecordRead(fast,20) != xtal) return false
    val slowPeriod=c5SleepRecordRead(slow,48);val fastPeriod=c5SleepRecordRead(fast,48)
    if (slowPeriod == 0 || fastPeriod == 0) return false
    request.storeU32(12,slowPeriod);request.storeU32(16,fastPeriod)
    true
}
