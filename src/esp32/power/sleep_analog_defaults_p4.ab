import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Pure32B analog config for sleep_analog/profile. Mirrors P4 IDF default
// macros plus runtime overrides, not a claim these voltages suit every board.
// Flags consumed: VDDSDIO-PD1,XTAL-PD10,LP-use-RCfast25,ADC-monitor28,
// XTAL-as-fast30. Caller supplies configured sleep DCM voltage and measured
// active bias codes (0..31); no guessed calibration or hardware writes.
trusted fun esp32p4SleepAnalogDefaults(output: NativeBuffer,flags: u32,revision: int,deep: bool,psram: bool,
    sleepDcmVset: int,activeHpDbias: int,activeLpDbias: int): bool {
    if (!output.hasAddressRange(0,32) || (output.addressValue()&3) != 0 || revision < 0 || revision > 399 ||
        (flags&~u32(0x52000402)) != u32(0) || sleepDcmVset < 0 || sleepDcmVset > 31 ||
        activeHpDbias < 0 || activeHpDbias > 31 || activeLpDbias < 0 || activeLpDbias > 31) return false
    var hpPd=true;var hpSleep=true;var lpPd=true;var lpSleep=true
    var hpDbias=if (deep) 0 else 1
    var lpDbias=if (deep) 23 else 12
    var lpAtten=if (deep) 12 else 0
    if (!deep && psram) { hpPd=false;lpPd=false }
    if (!deep && (flags&u32(0x400)) == u32(0)) {
        hpPd=false;hpSleep=false;lpPd=false;lpSleep=false;hpDbias=24;lpAtten=0
    }
    if ((flags&u32(0x50000000)) != u32(0)) { hpPd=false;hpSleep=false }
    if ((flags&u32(0x40000000)) != u32(0)) hpDbias=24
    if ((flags&u32(0x02000000)) != u32(0)) { hpDbias=activeHpDbias;lpDbias=activeLpDbias;lpAtten=0 }
    val hpBias=(if (deep) u32(0) else (u32(sleepDcmVset)<<u32(18))|u32(0x00800000))|
        (if (hpPd) u32(0x40000000) else u32(0))|(if (hpSleep) u32(0x80000000) else u32(0))
    val lpBias=(u32(lpAtten)<<u32(26))|(if (lpPd) u32(0x40000000) else u32(0))|(if (lpSleep) u32(0x80000000) else u32(0))
    val flash=revision >= 100 && !deep && (flags&u32(2)) == u32(0)
    output.storeU32(0,int(hpBias));output.storeU32(4,int(lpBias))
    output.storeU32(8,int((u32(hpDbias)<<u32(27))|(if (flash) u32(0x00400000) else u32(0))))
    output.storeU32(12,0)
    output.storeU32(16,int((u32(if (deep) 26 else 29)<<u32(27))|u32(0x00400000)))
    output.storeU32(20,if (deep) 7<<26 else 0)
    output.storeU32(24,int((u32(lpDbias)<<u32(27))|u32(0x00400000)))
    output.storeU32(28,0)
    return true
}
