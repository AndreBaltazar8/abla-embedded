import "./sleep_peer_binding_p4_sequence.ab"
import "./sleep_peer_irq_esp32p4.ab"
import "../irq_dispatch_esp32p4.ab"
import "../interrupt_route_esp32p4.ab"
import "../../hal/esp32_power.ab"
import "abla/unsafe/mmio"
@export("p4PeerBindingSource")
trusted fun p4PeerBindingSourceHook(core: int): u32 = u32(mmioLoadU32(0x500e5018+core*4))
@export("p4PeerBindingHandlerAddress")
trusted fun p4PeerBindingHandlerAddressHook(): int = esp32p4SleepPeerIrqAddress()
@export("p4PeerBindingSharedLoad")
trusted fun p4PeerBindingSharedLoadHook(address: int): u32 = p4SmpLoad(address)
