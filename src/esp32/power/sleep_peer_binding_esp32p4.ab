import "./sleep_peer_binding_p4_sequence.ab"
import "./sleep_peer_irq_esp32p4.ab"
import "../irq_dispatch_esp32p4.ab"
import "../interrupt_route_esp32p4.ab"
trusted fun p4PeerBindingSource(core: int): u32 = u32(mmioLoadU32(0x500e5018+core*4))
trusted fun p4PeerBindingHandlerAddress(): int = esp32p4SleepPeerIrqAddress()
trusted fun p4PeerBindingSharedLoad(address: int): u32 = p4SmpLoad(address)
