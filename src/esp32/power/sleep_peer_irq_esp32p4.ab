import "./sleep_peer_irq_p4_sequence.ab"
import "./sleep_cpu_retained_esp32p4.ab"
import "./sleep_peer_esp32p4.ab"
import "../clic_esp32p4.ab"
trusted noescape extern:"inline-assembly" fun p4PeerIrqAsm(template: string,constraints: string): void
trusted fun p4PeerIrqRelax(): void = p4PeerIrqAsm("nop","~{memory}")
trusted fun p4PeerIrqParkAddress(): int = nativeFunctionAddress(esp32p4SleepPeerPark)
// Matches P4IrqDispatch slot ABI. Validation failure before ownership disables
// the local line; it does not pretend to have acknowledged/completed the IPC.
// Once owned, failure parks in the handler with payload result/detail retained;
// never return into a task with incomplete banks or an active core boundary.
trusted fun esp32p4SleepPeerIrqEntry(frame: u32,line: u32,core: u32,context: u32): void {
    val r=nativeBufferAt(int(context),848)
    if (core != p4SmpHart() || line < u32(16) || line > u32(47) ||
        !nativeBufferAt(int(frame),144).hasAddressRange(0,144) || (frame&u32(15)) != u32(0) ||
        !p4PeerIrqValid(r) || r.loadU32(0) != 0x50344950 || r.loadU32(24) != int(core) ||
        (int(frame) < r.addressValue()+848 && r.addressValue() < int(frame)+144)) {
        if (core == p4SmpHart() && line >= u32(16) && line <= u32(47)) esp32P4ClicEnableOwned(int(line),false)
        return
    }
    while (esp32p4SleepPeerIrqContinueOwned(r,true) != 1) p4PeerIrqRelax()
    return
}
trusted fun esp32p4SleepPeerIrqAddress(): int = nativeFunctionAddress(esp32p4SleepPeerIrqEntry)
