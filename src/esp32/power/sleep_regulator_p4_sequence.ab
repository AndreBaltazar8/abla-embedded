import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "./sleep_analog_fields_p4.ab"
// Six documented RW regulator registers used by pmu_sleep_analog_init.
// Bias/DCM fields are owned separately by sleep_bias_p4_sequence. The reserved
// LP-active bias slot is NOT the LP-sleep RW bias register used by the HAL.
// Caller validates voltage/retention settings against measured calibration,
// owns PMU and excludes ALL HP/LP mode transitions. No voltage defaults.
// Config24B: HPsleep reg0/reg1, LPactive reg0/reg1, LPsleep reg0/reg1.
// Record44B: magic/state/primary/cleanup/revision + six original fields.
trusted fun p4SleepRegulatorSet(i: int,revision: int,value: u32): bool {
    val offset=p4SleepRegulatorOffset(i);val mask=p4SleepRegulatorMask(i,revision)
    p4SleepRegulatorWrite(offset,(p4SleepRegulatorRead(offset)&~mask)|(value&mask))
    return (p4SleepRegulatorRead(offset)&mask) == (value&mask)
}
//1ready2invalid3partial4closed. Revision is actual major*100+minor, not layout.
trusted fun esp32p4SleepRegulatorOpenOwned(r: NativeBuffer,c: NativeBuffer,revision: int,exclusive: bool): int {
    if (!exclusive || revision < 0 || revision > 399 || !r.hasAddressRange(0,44) || !c.hasAddressRange(0,24) ||
        (r.addressValue()&3) != 0 || (c.addressValue()&3) != 0 || r.loadU32(0) != 0) return 2
    if (r.addressValue() < c.addressValue()+24 && c.addressValue() < r.addressValue()+44) return 2
    var i=0
    while (i < 6) {
        if ((u32(c.loadU32(i*4))&~p4SleepRegulatorMask(i,revision)) != u32(0)) return 2
        i=i+1
    }
    // HAL writes the four-bit xpd_0p1a field as 0 or 8, not arbitrary bias.
    if (revision >= 100 && (c.loadU32(0)&0x00380000) != 0) return 2
    r.storeU32(0,0x50345231);r.storeU32(4,3);r.storeU32(8,0);r.storeU32(12,0);r.storeU32(16,revision)
    i=0
    while (i < 6) { r.storeU32(20+i*4,int(p4SleepRegulatorRead(p4SleepRegulatorOffset(i))&p4SleepRegulatorMask(i,revision)));i=i+1 }
    i=0
    while (i < 6) {
        if (!p4SleepRegulatorSet(i,revision,u32(c.loadU32(i*4)))) { r.storeU32(8,i+1);return 3 }
        i=i+1
    }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4SleepRegulatorCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,44) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50345231) return 2
    val revision=r.loadU32(16)
    if (revision > 399) return 2
    if (r.loadU32(4) == 4) return 4
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    r.storeU32(4,3)
    var i=5
    while (i >= 0) {
        if (!p4SleepRegulatorSet(i,revision,u32(r.loadU32(20+i*4)))) { r.storeU32(12,i+1);return 3 }
        i=i-1
    }
    r.storeU32(12,0);r.storeU32(4,4);return 4
}
