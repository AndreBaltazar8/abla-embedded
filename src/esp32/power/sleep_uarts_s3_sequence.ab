// Scalar transaction for all owned UART ports. The low-level per-port
// preparation must undo its own suspension on failure; this transaction then
// resumes earlier ports. No allocations, global ownership table or FIFO reset.
type Esp32S3SleepUarts = int
fun Esp32S3SleepUarts.ready(): bool = (this & 255) == 1
fun Esp32S3SleepUarts.status(): int = this & 255
fun Esp32S3SleepUarts.suspendedMask(): int = (this>>>8) & 7
fun Esp32S3SleepUarts.failedPort(): int = ((this>>>16) & 3)-1

@section(".iram1.abla.s3SleepUartsResumeMask")
trusted fun esp32S3SleepUartsResumeMaskOwned(mask: int): void {
    var port=2
    while (port >= 0) {
        if ((mask & (1<<port)) != 0) esp32S3SleepUartResumeOwned(port)
        port=port-1
    }
    return
}

// ports is a three-bit ownership mask; zero is a valid empty transaction.
// polls bounds each port, so total work is at most three such polling loops.
// Caller keeps all selected producers/interrupts/other-core access quiesced.
trusted fun esp32S3SleepUartsPrepareOwned(ports: int,deep: bool,polls: int): Esp32S3SleepUarts {
    if (ports < 0 || ports > 7 || polls <= 0 || polls > 0x7FFFFFFF) return Esp32S3SleepUarts(0)
    var suspended=0
    var port=0
    while (port < 3) {
        if ((ports & (1<<port)) != 0) {
            val result=esp32S3SleepUartPrepareOwned(port,deep,polls)
            if (result == 3) suspended=suspended | (1<<port)
            else if (result != 1 && result != 2) {
                esp32S3SleepUartsResumeMaskOwned(suspended)
                return Esp32S3SleepUarts((result & 255) | ((port+1)<<16))
            }
        }
        port=port+1
    }
    Esp32S3SleepUarts(1 | (suspended<<8))
}

// Resume after wake, rejection, or any later preparation error. Replace the
// caller's token with the returned consumed token; do not resume copied tokens.
@inline
trusted fun Esp32S3SleepUarts.resumeOwned(): Esp32S3SleepUarts {
    if (this.ready()) esp32S3SleepUartsResumeMaskOwned(this.suspendedMask())
    Esp32S3SleepUarts(0)
}
