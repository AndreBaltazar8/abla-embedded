import "./sleep_usb_serial_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@inline
@export("esp32S3SleepUsbRead")
trusted fun esp32S3SleepUsbReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3SleepUsbWrite")
trusted fun esp32S3SleepUsbWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
