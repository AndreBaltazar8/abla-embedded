import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// PMU retention entries0..2 plus LP-domain recovery entry (same as entry0).
// Entry3/software-test and MAC are not changed. This does not enable PAU/PMU.
// Caller owns validated retained descriptor graphs/buffers/cache visibility,
// pinned PAU clock and LP registers, and excludes ALL PMU/ETM/software starts.
// Prove engine quiescence externally: WT START bits cannot establish idle.
// Keep graphs and this32B internal retained record alive until close succeeds.
// Record: magic,state,primaryStage,cleanupStage,oldPAU[3],oldLPfallback.
// State1ready3partial4closed; result1ready2invalid3clock4partial5closed.
import "./retention_config_p4.ab"
trusted fun p4RetentionLinkRead(slot: int): u32 =
    if (slot == 3) p4RetentionLpRead(348) else p4RetentionPauRead(12+slot*4)
trusted fun p4RetentionLinkWrite(slot: int,value: u32): bool {
    if (slot == 3) p4RetentionLpWrite(348,value) else p4RetentionPauWrite(12+slot*4,value)
    return p4RetentionLinkRead(slot) == value
}
trusted fun esp32p4RetentionLinksOpenOwned(r: NativeBuffer,entry0: int,entry1: int,entry2: int,exclusiveIdle: bool): int {
    if (!exclusiveIdle || !r.hasAddressRange(0,32) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 ||
        entry0 == 0 || !p4RetentionLinkAddressValid(entry0) || !p4RetentionLinkAddressValid(entry1) || !p4RetentionLinkAddressValid(entry2)) return 2
    var slot=0
    while (slot < 3) {
        val address=if (slot == 0) entry0 else if (slot == 1) entry1 else entry2
        if (address != 0 && address < r.addressValue()+32 && r.addressValue() < address+4) return 2
        slot=slot+1
    }
    if (!p4RetentionClockReady()) return 3
    // Snapshot every register before the first mutation, including the
    // independent old LP fallback (not assumed equal to the old PAU entry0).
    slot=0
    while (slot < 4) { r.storeU32(16+slot*4,int(p4RetentionLinkRead(slot)));slot=slot+1 }
    r.storeU32(0,0x50345231);r.storeU32(4,3);r.storeU32(8,0);r.storeU32(12,0)
    slot=0
    while (slot < 4) {
        val address=if (slot == 1) entry1 else if (slot == 2) entry2 else entry0
        if (!p4RetentionLinkWrite(slot,u32(address))) { r.storeU32(8,slot+1);return 4 }
        slot=slot+1
    }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4RetentionLinksCloseOwned(r: NativeBuffer,exclusiveIdle: bool): int {
    if (!exclusiveIdle || !r.hasAddressRange(0,32) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50345231) return 2
    if (r.loadU32(4) == 4) return 5
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    if (!p4RetentionClockReady()) return 3
    r.storeU32(4,3)
    var slot=3
    while (slot >= 0) {
        if (!p4RetentionLinkWrite(slot,u32(r.loadU32(16+slot*4)))) { r.storeU32(12,slot+1);return 4 }
        slot=slot-1
    }
    r.storeU32(12,0);r.storeU32(4,4);return 5
}
