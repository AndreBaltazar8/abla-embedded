import "./retention_enable_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4RetentionPmuRead")
trusted fun p4RetentionPmuReadHook(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
@export("p4RetentionPmuWrite")
trusted fun p4RetentionPmuWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value));return }
