import "./sleep_gpio_record_s3_sequence.ab"
// Cancel BEFORE entry, including failed GPIO/clock/retention preparation.
// Exact report16: result0,reserved4,resume64@8. Results1cancelled,2invalid,
// 3clock/retention restoration incomplete,4GPIO restoration incomplete.
// clocksUnchanged is ONLY a proof for a fresh zero-header/zero-stage record;
// it never bypasses recovery of an owned or previously entered sleep record.
// Caller owns quiescence and all buffers; keep the recovery closure/stack in
// retained internal memory until clocks/cache restored. No sleep request.
@section(".iram1.abla.s3SleepGpioCancel")
@noinline
trusted fun esp32S3SleepGpioCancelOwned(sleep: NativeBuffer,wake: NativeBuffer,report: NativeBuffer,polls: int,clocksUnchanged: bool,exclusive: bool): int {
    if (!exclusive || polls <= 0 || polls > 0x7fffffff || !esp32S3SleepGpioRecordsDisjoint(sleep,wake) ||
        !report.hasAddressRange(0,16) || (report.addressValue()&3) != 0 ||
        (report.addressValue() < sleep.addressValue()+128 && sleep.addressValue() < report.addressValue()+16) ||
        (report.addressValue() < wake.addressValue()+32 && wake.addressValue() < report.addressValue()+16) ||
        wake.loadU32(0) != 0x53335747 || (wake.loadU32(4) != 1 && wake.loadU32(4) != 3 && wake.loadU32(4) != 4) || wake.loadU32(24) != 1) return 2
    val magic=sleep.loadU32(0)
    val state=sleep.loadU32(4)
    var resume=Esp32S3SleepResume(0)
    if (magic == 0) {
        if (state == 0) { if (!clocksUnchanged) return 2 }
        else {
            if (state != 6) return 2
            resume=Esp32S3SleepResume(esp32S3MspiStateLoad64(sleep.addressValue()+40))
            if (!resume.valid() || !resume.complete()) return 2
        }
    } else if (magic != 0x53504c50 || (state != 3 && state != 4 && state != 7 && state != 9)) return 2
    report.storeU32(0,0);report.storeU32(4,0)
    if (magic != 0) resume=esp32S3SleepRetainedRecordResumeOwned(sleep,polls)
    report.storeU32(8,resume|0);report.storeU32(12,(resume|0)>>>32)
    if (magic != 0 && (!resume.valid() || !resume.complete() || sleep.loadU32(0) != 0 || sleep.loadU32(4) != 6)) {
        report.storeU32(0,3);return 3
    }
    if (esp32S3GpioWakeSessionCloseOwned(wake,true) != 8) { report.storeU32(0,4);return 4 }
    report.storeU32(0,1);return 1
}
