import "./retention_session_p4_sequence.ab"
// Four-entry graph session. Preserve the existing three-entry session ABI.
// Entry3 at PAU+18 is a full pointer, NOT a start command or MAC link.
// Acquire entry3 first, then the standard timeout/links/enables session;
// close standard session completely before restoring entry3. All triggers
// must remain excluded, including software entry3 operations and PMU/ETM.
// Caller proves engine idle, owns graph backing/cache publication, PAU clock,
// PMU backup modes/AON policy and internal retained record until closed.
// Config remains32B; entry3 supplied separately (zero allowed).
// Record88B: magic,state,primary,cleanup,oldEntry3,owned,childSession64.
// State1ready3partial4closed; results1ready2invalid3entry3clock/write,
// 4childOpen6cleanup8closed. Child retains detailed failure stage.
trusted fun esp32p4RetentionRoutedSessionOpenOwned(r: NativeBuffer,c: NativeBuffer,entry3: int,exclusivePrepared: bool): int {
    if (!exclusivePrepared || !r.hasAddressRange(0,88) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 ||
        !p4RetentionSessionConfigValid(c) || !p4RetentionLinkAddressValid(entry3) ||
        (r.addressValue() < c.addressValue()+32 && c.addressValue() < r.addressValue()+88)) return 2
    var i=0
    while (i < 4) {
        val address=if (i == 3) entry3 else c.loadU32(i*4)
        if (address != 0 && address < r.addressValue()+88 && r.addressValue() < address+4) return 2
        i=i+1
    }
    if (!p4RetentionClockReady()) return 3
    val old=p4RetentionPauRead(24)
    i=4
    while (i < 88) { r.storeU32(i,0);i=i+4 }
    r.storeU32(0,0x50344731);r.storeU32(4,3);r.storeU32(16,int(old));r.storeU32(20,1)
    p4RetentionPauWrite(24,u32(entry3))
    if (p4RetentionPauRead(24) != u32(entry3)) { r.storeU32(8,3);return 3 }
    if (esp32p4RetentionSessionOpenOwned(nativeBufferAt(r.addressValue()+24,64),c,true) != 1) { r.storeU32(8,4);return 4 }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4RetentionRoutedSessionCloseOwned(r: NativeBuffer,exclusiveIdle: bool): int {
    if (!exclusiveIdle || !r.hasAddressRange(0,88) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50344731) return 2
    if (r.loadU32(4) == 4) return 8
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    r.storeU32(4,3)
    val child=nativeBufferAt(r.addressValue()+24,64)
    if (child.loadU32(0) != 0 && esp32p4RetentionSessionCloseOwned(child,true) != 8) { r.storeU32(12,4);return 6 }
    if (r.loadU32(20) != 0) {
        if (!p4RetentionClockReady()) { r.storeU32(12,3);return 6 }
        val old=u32(r.loadU32(16))
        p4RetentionPauWrite(24,old)
        if (p4RetentionPauRead(24) != old) { r.storeU32(12,3);return 6 }
        r.storeU32(20,0)
    }
    r.storeU32(12,0);r.storeU32(4,4);return 8
}
