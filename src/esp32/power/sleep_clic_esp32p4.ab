import "./sleep_clic_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
trusted noescape extern:"inline-assembly" fun p4SleepClicAsmRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4SleepClicAsmFence(template: string,constraints: string): void
@export("p4SleepClicHart")
trusted fun p4SleepClicHartHook(): u32 = p4SleepClicAsmRead("csrr $0, mhartid","=r,~{memory}")
@export("p4SleepClicStatus")
trusted fun p4SleepClicStatusHook(): u32 = p4SleepClicAsmRead("csrr $0, mstatus","=r,~{memory}")
@export("p4SleepClicFence")
trusted fun p4SleepClicFenceHook(): void = p4SleepClicAsmFence("fence iorw, iorw","~{memory}")
@export("p4SleepClicRead")
trusted fun p4SleepClicReadHook(address: int): int = mmioLoadU32(address)
@export("p4SleepClicWrite")
trusted fun p4SleepClicWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
