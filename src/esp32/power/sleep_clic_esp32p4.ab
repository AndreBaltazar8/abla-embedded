import "./sleep_clic_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun p4SleepClicAsmRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4SleepClicAsmFence(template: string,constraints: string): void
trusted fun p4SleepClicHart(): u32 = p4SleepClicAsmRead("csrr $0, mhartid","=r,~{memory}")
trusted fun p4SleepClicStatus(): u32 = p4SleepClicAsmRead("csrr $0, mstatus","=r,~{memory}")
trusted fun p4SleepClicFence(): void = p4SleepClicAsmFence("fence iorw, iorw","~{memory}")
trusted fun p4SleepClicRead(address: int): int = mmioLoadU32(address)
trusted fun p4SleepClicWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
