import "./sleep_uart_c5_sequence.ab"
// Allocation-free ownership token for both HP UARTs. Status low8: 0consumed,
// 1ready, otherwise per-port preparation error. Bits8..9 retain suspended
// ownership, bits16..17 encode failedPort+1. No copied-token restoration.
// On failure reverse-cleanup is attempted; remaining mask MUST be resumed
// before releasing exclusion, including when status is not ready.
type Esp32C5SleepUarts = int
fun Esp32C5SleepUarts.ready(): bool = (this&255) == 1
fun Esp32C5SleepUarts.status(): int = this&255
fun Esp32C5SleepUarts.suspendedMask(): int = (this>>>8)&3
fun Esp32C5SleepUarts.failedPort(): int = ((this>>>16)&3)-1
@section(".iram1.abla.c5SleepUartsCleanup")
trusted fun c5SleepUartsCleanup(mask: int): int {
    var remaining=mask
    if ((remaining&2) != 0 && esp32C5SleepUartResumeOwned(1,true)) remaining=remaining&~2
    if ((remaining&1) != 0 && esp32C5SleepUartResumeOwned(0,true)) remaining=remaining&~1
    remaining
}
@section(".iram1.abla.c5SleepUartsPrepare")
trusted fun esp32C5SleepUartsPrepareOwned(ports: int,drain: bool,polls: int,exclusive: bool): Esp32C5SleepUarts {
    if (!exclusive || ports < 0 || ports > 3 || polls < 1 || polls > 0x7fffffff) return Esp32C5SleepUarts(0)
    var suspended=0
    var port=0
    while (port < 2) {
        // The port mask is 32-bit. Keep variable shifts narrow on RV32 even
        // when this loop is retained by a larger monolithic caller.
        val bit=int(u32(1)<<u32(port))
        if ((ports&bit) != 0) {
            val result=esp32C5SleepUartPrepareOwned(port,drain,polls,true)
            if (result == 3) suspended=suspended|bit
            else if (result != 1 && result != 2) {
                if (result == 6) suspended=suspended|bit
                val remaining=c5SleepUartsCleanup(suspended)
                return Esp32C5SleepUarts(result|(remaining<<8)|((port+1)<<16))
            }
        }
        port=port+1
    }
    Esp32C5SleepUarts(1|(suspended<<8))
}
// Replace the caller's token with the returned value. A failed resume retains
// only the outstanding ports, so successful ports are not resumed twice.
@section(".iram1.abla.c5SleepUartsResume")
trusted fun esp32C5SleepUartsResumeOwned(saved: Esp32C5SleepUarts,exclusive: bool): Esp32C5SleepUarts {
    if (!exclusive) return saved
    val remaining=c5SleepUartsCleanup(((saved|0)>>>8)&3)
    if (remaining == 0) return Esp32C5SleepUarts(0)
    Esp32C5SleepUarts(((saved|0)&~0x300)|(remaining<<8))
}
