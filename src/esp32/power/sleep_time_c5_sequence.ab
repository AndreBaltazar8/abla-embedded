import "../rtc_elapsed_c5.ab"
import "../timer_c5_sequence.ab"
import "../timer_load_c5_sequence.ab"
// C5 systimer.c:16ticks/us for BOTH40/48MHz XTAL via eFuse-selected fixed
// fractional divider when PCR selects XTAL (RC_FAST selection is rejected).
// Target follows upstream high_res_start + RTCelapsed,
// not current SYSTIMER + RTCelapsed (which would double-count awake time).
// All snapshots belong to the same uninterrupted clock/calibration interval.
@section(".iram1.abla.c5SleepTimeTarget")
fun esp32C5SleepTimeTarget(startUs: int,rtcBefore: int,rtcAfter: int,periodQ19: int): int {
    if (startUs < 0 || startUs > 0xffffffffffff) return -1
    val elapsed=esp32C5RtcElapsedMicroseconds(rtcBefore,rtcAfter,periodQ19)
    if (elapsed < 0 || elapsed > 0xffffffffffff-startUs) return -1
    (startUs+elapsed)<<4
}
//1load published2invalid/overflow3clock unavailable4shadow failure5no change,
// 6snapshot failure. Rejected/pre-request failed sleep never changes time.
// Caller owns counter0/load/alarms/scheduler/observers through publication.
// Gate snapshots and loads only after restoring SYSTIMER clocks. Cache-off
// requires retained closure/stack. Current-counter check avoids loading an
// already-past target, but the running counter may advance before the strobe;
// this does not promise instruction-level monotonicity to concurrent readers.
// On1 consume this compensation request: do not reapply a stale absolute time.
@section(".iram1.abla.c5SleepTimeCompensate")
trusted fun esp32C5SleepTimeCompensateOwned(startUs: int,rtcBefore: int,rtcAfter: int,periodQ19: int,sleepResult: int,exclusive: bool,polls: int = 64): int {
    if (!exclusive || sleepResult < -3 || sleepResult > 1 || polls < 1 || polls > 1000000) return 2
    val target=esp32C5SleepTimeTarget(startUs,rtcBefore,rtcAfter,periodQ19)
    if (target < 0) return 2
    if (sleepResult != 0 || target == (startUs<<4)) return 5
    if ((esp32C5TimerRead(0x6009606c)&u32(7)) != u32(5) || (esp32C5TimerRead(0x60096070)&u32(0x500000)) != u32(0x400000)) return 3
    val current=esp32C5TimerTicks(0,polls)
    if (current < 0) return 6
    if (target <= current) return 5
    esp32C5TimerLoadOwned(0,target,true)
}
