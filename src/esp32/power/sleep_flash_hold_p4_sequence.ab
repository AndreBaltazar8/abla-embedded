import "abla/runtime/scalar"
// Revision3+ dedicated flash pins CS/Q/WP/HOLD/CK/D, LP_SYS+1cc bits0..5.
// Independent of PSRAM holds6..25 in the SAME register: preserve all others.
// Caller drains/suspends flash/cache/CPU/IRQ/DMA access before acquiring,
// owns pin/controller/rail context and retains RAM execution until release.
// Release only after flash controller/MMU/retention recovery is complete.
// Oldholds6@8,owned14.1held2invalid3partial4closed. No heap/clock/reset.
type P4SleepFlashHold=int
fun P4SleepFlashHold.status(): int = this&255
fun P4SleepFlashHold.hasSnapshot(): bool = (this&16384) != 0
trusted fun p4SleepFlashHoldField(value: int): bool {
    p4SleepFlashHoldWrite((p4SleepFlashHoldRead()&0xffffffc0)|(value&63))
    return (p4SleepFlashHoldRead()&63) == (value&63)
}
trusted fun esp32p4SleepFlashHoldOpenOwned(revision: int,exclusiveDrained: bool): P4SleepFlashHold {
    if (!exclusiveDrained || revision < 300 || revision > 399) return P4SleepFlashHold(2)
    val token=16384|((p4SleepFlashHoldRead()&63)<<8)
    return P4SleepFlashHold(token|(if (p4SleepFlashHoldField(63)) 1 else 3))
}
trusted fun P4SleepFlashHold.closeOwned(exclusiveRecovered: bool): P4SleepFlashHold {
    if (!exclusiveRecovered || !this.hasSnapshot() || this.status() == 4) return this
    return P4SleepFlashHold((this&(~255))|(if (p4SleepFlashHoldField((this>>>8)&63)) 4 else 3))
}
