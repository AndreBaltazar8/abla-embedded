import "./sleep_memory_cycle_common_c5.ab"
// Alternative cycle composition: do not import sleep_cycle_composition_c5 too.
// External retained496B context: caller's qualified request48 followed by owned
// transition448. Its request and storage stay exclusively owned until cycle
// completion/abort. Apply only after caches suspend, before the sleep request;
// partial/invalid apply never requests sleep and runs the full recovery path.
// Busy controllers instead retain cycle state7 for Continue: no second cache
// suspension or preparation, no memory lease claim, and no PLL recalibration.
// Existing/proposed PSRAM frequency ratios are checked against both CPU
// endpoints before preparation. Chip timings/voltage must still be qualified
// for sleep/wake and CPU restoration. PLL480 stays available;
// this adds no memory powerdown, chip command, or TOP/CPU retention support.
@section(".iram1.abla.c5SleepMemoryCycleBegin")
trusted fun esp32C5SleepMemoryCycleBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,exclusiveReady: bool): int {
    if (!exclusiveReady || !context.hasAddressRange(0,496) || (context.addressValue()&3) != 0 ||
        !record.hasAddressRange(0,792) || !request.hasAddressRange(0,68)) return 2
    val address=context.addressValue();val base=record.addressValue();val input=request.addressValue()
    if ((base < address+496 && address < base+792) || (input < address+496 && address < input+68) ||
        c5SleepRecordRead(context,48) != 0) return 2
    c5SleepCycleBeginContextOwned(record,request,true,address)
}
@inline
trusted fun c5SleepCycleEntry(record: NativeBuffer): int {
    val address=c5SleepRecordRead(record,108)
    if (address != 0) {
        // Both controllers share the memory clock/timing hardware, including
        // SPI1 when this profile does not change its settings. Ordinary busy
        // retains the post-cache state: no mutation, entry, or PLL recovery.
        if (esp32C5MspiWaitIdleOwned(3,c5SleepRecordRead(record,80),true) != 1) return -5
        val result=esp32C5MspiTransitionBeginOwned(nativeBufferAt(address+48,448),nativeBufferAt(address,48),true)
        // -3 remains an entry-precondition failure, not a hardware rejection.
        // Transition's own stage/child result preserves the precise cause.
        if (result != 1) return -3
    }
    c5SleepCycleTimedEntry(record)
}
