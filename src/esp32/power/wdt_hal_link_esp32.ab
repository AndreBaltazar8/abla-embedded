import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWdtHalIramOpaqueCallers(): bool {
    if (!exportFunction("esp32WdtHalInit", "wdt_hal_init")) return false
    if (!exportFunction("esp32WdtHalDeinit", "wdt_hal_deinit")) return false
    if (!exportFunction("esp32WdtHalConfigStage", "wdt_hal_config_stage")) return false
    if (!exportFunction("esp32WdtHalWriteProtectDisable", "wdt_hal_write_protect_disable")) return false
    if (!exportFunction("esp32WdtHalWriteProtectEnable", "wdt_hal_write_protect_enable")) return false
    if (!exportFunction("esp32WdtHalEnable", "wdt_hal_enable")) return false
    if (!exportFunction("esp32WdtHalDisable", "wdt_hal_disable")) return false
    if (!exportFunction("esp32WdtHalHandleIntr", "wdt_hal_handle_intr")) return false
    if (!exportFunction("esp32WdtHalFeed", "wdt_hal_feed")) return false
    if (!exportFunction("esp32WdtHalSetFlashbootEn", "wdt_hal_set_flashboot_en")) return false
    if (!exportFunction("esp32WdtHalIsEnabled", "wdt_hal_is_enabled")) return false
    true
}
