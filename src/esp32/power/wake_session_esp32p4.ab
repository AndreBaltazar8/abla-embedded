import "./wake_session_p4_sequence.ab"
import "./wake_clock_esp32p4.ab"
import "./wake_pad_esp32p4.ab"
import "./ext1_esp32p4.ab"
import "../../hal/esp32_power.ab"
@export("p4WakeSessionClockOpen")
trusted fun p4WakeSessionClockOpenHook(layout: int): int = esp32p4WakeClockOpenOwned(layout,true)|0
@export("p4WakeSessionClockClose")
trusted fun p4WakeSessionClockCloseHook(token: int): int = P4WakeClock(token).closeOwned(true)|0
@export("p4WakeSessionExtOpen")
trusted fun p4WakeSessionExtOpenHook(): int = esp32p4Ext1ParkOwned(true)|0
@export("p4WakeSessionExtPark")
trusted fun p4WakeSessionExtParkHook(token: int): int = P4Ext1Wake(token).parkOwned(true)|0
@export("p4WakeSessionExtConfigure")
trusted fun p4WakeSessionExtConfigureHook(token: int,selection: u32,highLevels: u32,filter: bool): int =
    P4Ext1Wake(token).configureOwned(selection,highLevels,filter,true)|0
@export("p4WakeSessionExtClose")
trusted fun p4WakeSessionExtCloseHook(token: int): int = P4Ext1Wake(token).closeOwned(true)|0
@export("p4WakeSessionPadOpen")
trusted fun p4WakeSessionPadOpenHook(pin: int,pull: int,layout: int): int = esp32p4WakePadOpenOwned(pin,pull,layout,true)|0
@export("p4WakeSessionPadClose")
trusted fun p4WakeSessionPadCloseHook(token: int): int = P4WakePad(token).closeOwned(true)|0
