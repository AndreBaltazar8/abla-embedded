import "./wake_session_p4_sequence.ab"
import "./wake_clock_esp32p4.ab"
import "./wake_pad_esp32p4.ab"
import "./ext1_esp32p4.ab"
trusted fun p4WakeSessionClockOpen(layout: int): int = esp32p4WakeClockOpenOwned(layout,true)|0
trusted fun p4WakeSessionClockClose(token: int): int = P4WakeClock(token).closeOwned(true)|0
trusted fun p4WakeSessionExtOpen(): int = esp32p4Ext1ParkOwned(true)|0
trusted fun p4WakeSessionExtPark(token: int): int = P4Ext1Wake(token).parkOwned(true)|0
trusted fun p4WakeSessionExtConfigure(token: int,selection: u32,highLevels: u32,filter: bool): int =
    P4Ext1Wake(token).configureOwned(selection,highLevels,filter,true)|0
trusted fun p4WakeSessionExtClose(token: int): int = P4Ext1Wake(token).closeOwned(true)|0
trusted fun p4WakeSessionPadOpen(pin: int,pull: int,layout: int): int = esp32p4WakePadOpenOwned(pin,pull,layout,true)|0
trusted fun p4WakeSessionPadClose(token: int): int = P4WakePad(token).closeOwned(true)|0
