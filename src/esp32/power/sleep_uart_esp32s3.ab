import "./sleep_uart_s3_sequence.ab"
import "./sleep_uarts_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("esp32S3SleepUartRead")
trusted fun esp32S3SleepUartReadHook(address: int): int = mmioLoadU32(address)
@export("esp32S3SleepUartUpdate")
trusted fun esp32S3SleepUartUpdateHook(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
