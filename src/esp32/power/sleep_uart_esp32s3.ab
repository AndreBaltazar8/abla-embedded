import "./sleep_uart_s3_sequence.ab"
import "./sleep_uarts_s3_sequence.ab"
import "abla/unsafe/mmio"
trusted fun esp32S3SleepUartRead(address: int): int = mmioLoadU32(address)
trusted fun esp32S3SleepUartUpdate(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
