import "./sleep_analog_c5.ab"
// C5 IDF6 pmu_sleep.c / pmu_param.c calibration decoding. Packed scalar:
// lightAtten4@0,lightHp5@4,deepAtten4@9,deepLp5@13,activeHp5@18,activeLp5@23.
// -1 means acquisition failed. Defaults are upstream revision fallbacks,
// not inferred voltages. Zero sleep fields remain valid burnt calibration.
type C5SleepCalibration=int
fun c5ChipRevision(sys2: u32): int = int((sys2>>u32(4))&u32(3))*100+int(sys2&u32(15))
fun c5BlockRevision(sys2: u32): int = int((sys2>>u32(11))&u32(3))*100+int((sys2>>u32(8))&u32(7))
fun c5SleepCalibrationPresent(sys2: u32): bool {
    val chip=c5ChipRevision(sys2);val block=c5BlockRevision(sys2)
    (chip == 1 && block >= 1) || (chip >= 100 && block >= 2)
}
fun c5ActiveCalibration(raw: int): int = if (raw == 0) 28 else if (raw > 12) 31 else raw+19
fun esp32C5SleepCalibrationDecode(sys2: u32,sys3: u32,sys4: u32): C5SleepCalibration {
    if (!c5SleepCalibrationPresent(sys2)) return C5SleepCalibration(1|(9<<9)|(15<<13)|(28<<18)|(28<<23))
    val decodedLightAtten=int((sys3>>u32(18))&u32(3))
    val decodedLightHp=int((sys3>>u32(20))&u32(15))
    val decodedDeepAtten=int((sys3>>u32(24))&u32(15))
    val decodedDeepLp=int((sys3>>u32(28))&u32(15))|(int(sys4&u32(1))<<4)
    val decodedActiveHp=c5ActiveCalibration(int((sys3>>u32(10))&u32(15)))
    val decodedActiveLp=c5ActiveCalibration(int((sys3>>u32(14))&u32(15)))
    C5SleepCalibration(decodedLightAtten|(decodedLightHp<<4)|(decodedDeepAtten<<9)|(decodedDeepLp<<13)|(decodedActiveHp<<18)|(decodedActiveLp<<23))
}
fun C5SleepCalibration.valid(): bool = this >= 0 && this <= 0x0fffffff
trusted fun C5SleepCalibration.analog(output: NativeBuffer,deep: bool,xtalDown: bool,rcFastDown: bool,xtalFast: bool,lpFast: bool): bool {
    if (!this.valid()) return false
    esp32C5SleepAnalogCalibrated(output,deep,xtalDown,rcFastDown,xtalFast,lpFast,
        this&15,(this>>4)&31,(this>>9)&15,(this>>13)&31,(this>>18)&31,(this>>23)&31)
}
// Caller excludes eFuse programming/reload and keeps its register clock on.
// Never burns, reloads, or changes eFuse registers. Idle before/after snapshot
// checks readiness; it is not a substitute for exclusive writer ownership.
trusted fun esp32C5SleepCalibrationReadOwned(exclusive: bool,readLimit: int = 64): C5SleepCalibration {
    if (!exclusive || readLimit < 1 || readLimit > 1000000) return C5SleepCalibration(-1)
    var i=0
    while (i < readLimit) {
        if ((c5SleepEfuseRead(0x1d4)&15) == 1) {
            val sys2=u32(c5SleepEfuseRead(0x4c));val sys3=u32(c5SleepEfuseRead(0x50));val sys4=u32(c5SleepEfuseRead(0x54))
            if ((c5SleepEfuseRead(0x1d4)&15) != 1) return C5SleepCalibration(-1)
            return esp32C5SleepCalibrationDecode(sys2,sys3,sys4)
        }
        i=i+1
    }
    C5SleepCalibration(-1)
}
