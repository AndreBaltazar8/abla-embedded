import "./sleep_peer_p4_sequence.ab"
import "./sleep_smp_esp32p4.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
trusted noescape extern:"inline-assembly" fun p4SleepPeerAsmFence(template: string,constraints: string): void
@export("p4SleepPeerFence")
trusted fun p4SleepPeerFenceHook(): void = p4SleepPeerAsmFence("fence iorw, iorw","~{memory}")
@export("p4SleepPeerRead")
trusted fun p4SleepPeerReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("p4SleepPeerWrite")
trusted fun p4SleepPeerWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
