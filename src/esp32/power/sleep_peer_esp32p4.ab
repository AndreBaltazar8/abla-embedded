import "./sleep_peer_p4_sequence.ab"
import "./sleep_smp_esp32p4.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun p4SleepPeerAsmFence(template: string,constraints: string): void
trusted fun p4SleepPeerFence(): void = p4SleepPeerAsmFence("fence iorw, iorw","~{memory}")
trusted fun p4SleepPeerRead(address: int): u32 = u32(mmioLoadU32(address))
trusted fun p4SleepPeerWrite(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
