import "./sleep_analog_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepAnalogRead")
trusted fun p4SleepAnalogReadHook(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
@export("p4SleepAnalogWrite")
trusted fun p4SleepAnalogWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value));return }
