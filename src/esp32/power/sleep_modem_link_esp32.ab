import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSleepModemOpaqueCallers(): bool {
    if (!internalFunction("esp32ModemDomainPowerDownAllowed", "modem_domain_pd_allowed")) return false
    if (!exportFunction("esp32SleepModemRejectTriggers", "sleep_modem_reject_triggers")) return false
    if (!internalFunction("esp32SleepModemSkipLightSleep", "sleep_modem_wifi_modem_state_skip_light_sleep")) return false
    if (!internalFunction("esp32SleepModemConfigure", "sleep_modem_configure")) return false
    if (!internalFunction("esp32RegisterLightSleepOverheadCallback", "esp_pm_register_inform_out_light_sleep_overhead_callback")) return false
    if (!internalFunction("esp32UnregisterLightSleepOverheadCallback", "esp_pm_unregister_inform_out_light_sleep_overhead_callback")) return false
    if (!exportFunction("esp32InformLightSleepOverhead", "periph_inform_out_light_sleep_overhead")) return false
    if (!internalFunction("esp32RegisterLightSleepDefaultParametersCallback", "esp_pm_register_light_sleep_default_params_config_callback")) return false
    if (!internalFunction("esp32UnregisterLightSleepDefaultParametersCallback", "esp_pm_unregister_light_sleep_default_params_config_callback")) return false
    true
}
