import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSleepModesOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspDefaultWakeDeepSleep", "esp_default_wake_deep_sleep")) return false
    if (!internalFunction("esp32RecoveredEspSleepOverheadOutTimeRefresh", "esp_sleep_overhead_out_time_refresh")) return false
    if (!internalFunction("esp32RecoveredEspGetDeepSleepWakeStub", "esp_get_deep_sleep_wake_stub")) return false
    if (!internalFunction("esp32RecoveredEspSetDeepSleepWakeStub", "esp_set_deep_sleep_wake_stub")) return false
    if (!internalFunction("esp32RecoveredEspDeepSleepRegisterHook", "esp_deep_sleep_register_hook")) return false
    if (!internalFunction("esp32RecoveredEspDeepSleepDeregisterHook", "esp_deep_sleep_deregister_hook")) return false
    if (!internalFunction("esp32RecoveredEspDeepSleepRegisterPhyHook", "esp_deep_sleep_register_phy_hook")) return false
    if (!internalFunction("esp32RecoveredEspDeepSleepDeregisterPhyHook", "esp_deep_sleep_deregister_phy_hook")) return false
    if (!internalFunction("esp32RecoveredEspDeepSleepStart", "esp_deep_sleep_start")) return false
    if (!internalFunction("esp32RecoveredEspDeepSleepTryToStart", "esp_deep_sleep_try_to_start")) return false
    if (!internalFunction("esp32RecoveredEspLightSleepStart", "esp_light_sleep_start")) return false
    if (!internalFunction("esp32RecoveredEspSleepDisableWakeupSource", "esp_sleep_disable_wakeup_source")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableUlpWakeup", "esp_sleep_enable_ulp_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableTimerWakeup", "esp_sleep_enable_timer_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspDeepSleep", "esp_deep_sleep")) return false
    if (!internalFunction("esp32RecoveredEspDeepSleepTry", "esp_deep_sleep_try")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableTouchpadWakeup", "esp_sleep_enable_touchpad_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepIsValidWakeupGpio", "esp_sleep_is_valid_wakeup_gpio")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableExt0Wakeup", "esp_sleep_enable_ext0_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableExt1WakeupIo", "esp_sleep_enable_ext1_wakeup_io")) return false
    if (!internalFunction("esp32RecoveredEspSleepDisableExt1WakeupIo", "esp_sleep_disable_ext1_wakeup_io")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableExt1Wakeup", "esp_sleep_enable_ext1_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableGpioWakeup", "esp_sleep_enable_gpio_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableUartWakeup", "esp_sleep_enable_uart_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableWifiWakeup", "esp_sleep_enable_wifi_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepDisableWifiWakeup", "esp_sleep_disable_wifi_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableWifiBeaconWakeup", "esp_sleep_enable_wifi_beacon_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepDisableWifiBeaconWakeup", "esp_sleep_disable_wifi_beacon_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepEnableBtWakeup", "esp_sleep_enable_bt_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepDisableBtWakeup", "esp_sleep_disable_bt_wakeup")) return false
    if (!internalFunction("esp32RecoveredEspSleepGetWakeupCause", "esp_sleep_get_wakeup_cause")) return false
    if (!internalFunction("esp32RecoveredEspSleepGetWakeupCauses", "esp_sleep_get_wakeup_causes")) return false
    if (!internalFunction("esp32RecoveredEspSleepGetTouchpadWakeupStatus", "esp_sleep_get_touchpad_wakeup_status")) return false
    if (!internalFunction("esp32RecoveredEspSleepGetExt1WakeupStatus", "esp_sleep_get_ext1_wakeup_status")) return false
    if (!internalFunction("esp32RecoveredEspSleepPdConfig", "esp_sleep_pd_config")) return false
    if (!internalFunction("esp32RecoveredEspSleepSubModeConfig", "esp_sleep_sub_mode_config")) return false
    if (!internalFunction("esp32RecoveredEspSleepAcquireLpUseXtal", "esp_sleep_acquire_lp_use_xtal")) return false
    if (!internalFunction("esp32RecoveredEspSleepReleaseLpUseXtal", "esp_sleep_release_lp_use_xtal")) return false
    if (!internalFunction("esp32RecoveredEspSleepSubModeForceDisable", "esp_sleep_sub_mode_force_disable")) return false
    if (!internalFunction("esp32RecoveredEspSleepSubModeDumpConfig", "esp_sleep_sub_mode_dump_config")) return false
