import "./sleep_cycle_common_c5.ab"
@inline
trusted fun c5SleepCyclePrepare(record: NativeBuffer): int = c5SleepCyclePrepareBase(record)
@inline
trusted fun c5SleepCycleEntry(record: NativeBuffer): int =
    c5SleepCycleTimedEntry(record)
@inline
trusted fun c5SleepCycleRecovery(record: NativeBuffer): int {
    val base=record.addressValue();val recovery=nativeBufferAt(base+664,128)
    if (c5SleepRecordRead(record,664) != 0) return esp32C5SleepRecoveryContinueOwned(recovery,true)
    esp32C5SleepRecoveryBeginOwned(recovery,nativeBufferAt(base+304,304),base+608,C5CpuClock(c5SleepRecordRead(record,204)),
        (c5SleepRecordRead(record,72)&8) != 0,int(i32(c5SleepRecordRead(record,12))),false,0,
        c5SleepRecordRead(record,28)|(c5SleepRecordRead(record,32)<<32),c5SleepRecordRead(record,148),true,
        if (c5SleepRecordRead(record,632) != 0) base+632 else 0,base+152)
}
