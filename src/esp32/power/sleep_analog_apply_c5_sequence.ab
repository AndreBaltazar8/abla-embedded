import "./sleep_record_c5.ab"
import "./sleep_analog_c5.ab"
// Checked C5 pmu_sleep_analog_init register ownership. Caller excludes sleep
// entry, PMU/PVT writers, and keeps plan/record storage stable and disjoint.
//48B:tag0,status4,original7words@8,reverse index36,count40,reserved44.
//1configured2invalid3partial4closed. Failed writes retain all snapshots;
// cleanup retries in reverse with fresh masked RMW. No live-rail force writes.
// pvtModemBias=-1 leaves HP_MODEM untouched. Otherwise caller supplies the
// calibrated active HP voltage (IDF PVT reads ACTIVE regulator0 bits9..13).
@section(".iram1.abla.c5SleepAnalogOffset")
fun c5SleepAnalogOffset(index: int): int = if (index == 0) 0x80 else if (index == 1) 0x90 else
    if (index == 2) 0x94 else if (index == 3) 0xc8 else if (index == 4) 0xb4 else if (index == 5) 0xb8 else 0x5c
@section(".iram1.abla.c5SleepAnalogMask")
fun c5SleepAnalogMask(index: int): int = if (index == 0 || index == 3) 0xfc000000 else
    if (index == 1) 0xf8040000 else if (index == 2) 0xffffff00 else if (index == 4) 0xffe00000 else if (index == 5) 0xf0000000 else 0xf8000000
fun c5SleepAnalogLimit(index: int): int = if (index == 0 || index == 6 || index == 11 || index == 13) 15 else
    if (index == 4 || index == 12) 31 else if (index == 5) 16777215 else 1
trusted fun c5SleepAnalogValue(plan: NativeBuffer,index: int,pvt: int): int {
    if (index == 0) return (plan.loadU32(0)<<26)|(plan.loadU32(4)<<30)|(plan.loadU32(8)<<31)
    if (index == 1) return (plan.loadU32(12)<<18)|(plan.loadU32(16)<<27)
    if (index == 2) return plan.loadU32(20)<<8
    if (index == 3) return (plan.loadU32(24)<<26)|(plan.loadU32(28)<<30)|(plan.loadU32(32)<<31)
    if (index == 4) return (plan.loadU32(36)<<21)|(plan.loadU32(40)<<22)|(plan.loadU32(44)<<23)|(plan.loadU32(48)<<27)
    if (index == 5) return plan.loadU32(52)<<28
    pvt<<27
}
@section(".iram1.abla.c5SleepAnalogField")
@inline
trusted fun c5SleepAnalogField(index: int,value: int): bool {
    val offset=c5SleepAnalogOffset(index);val mask=c5SleepAnalogMask(index)
    c5SleepAnalogWrite(offset,(c5SleepAnalogRead(offset)&~mask)|(value&mask))
    (c5SleepAnalogRead(offset)&mask) == (value&mask)
}
@section(".iram1.abla.esp32C5SleepAnalogStatus")
trusted fun esp32C5SleepAnalogStatus(record: NativeBuffer): int =
    if (!record.hasAddressRange(0,48) || c5SleepRecordRead(record,0) != 0x43414e31) 2 else c5SleepRecordRead(record,4)
trusted fun esp32C5SleepAnalogApplyOwned(record: NativeBuffer,plan: NativeBuffer,exclusive: bool,pvtModemBias: int = -1): int {
    if (!exclusive || !record.hasAddressRange(0,48) || !plan.hasAddressRange(0,56) ||
        (record.addressValue()&3) != 0 || (plan.addressValue()&3) != 0 || pvtModemBias < -1 || pvtModemBias > 31) return 2
    if (record.addressValue() < plan.addressValue()+56 && plan.addressValue() < record.addressValue()+48) return 2
    if (c5SleepRecordRead(record,0) == 0x43414e31 && c5SleepRecordRead(record,4) != 4) return 2
    var i=0;while (i < 14) { if (plan.loadU32(i*4) > c5SleepAnalogLimit(i)) return 2;i=i+1 }
    val count=if (pvtModemBias < 0) 6 else 7
    c5SleepRecordWrite(record,0,0x43414e31);c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,36,count-1);c5SleepRecordWrite(record,40,count);c5SleepRecordWrite(record,44,0)
    i=0;while (i < count) { c5SleepRecordWrite(record,8+i*4,c5SleepAnalogRead(c5SleepAnalogOffset(i)));i=i+1 }
    i=0;while (i < count) { if (!c5SleepAnalogField(i,c5SleepAnalogValue(plan,i,pvtModemBias))) return 3;i=i+1 }
    c5SleepRecordWrite(record,4,1)
    1
}
@section(".iram1.abla.esp32C5SleepAnalogCloseOwned")
trusted fun esp32C5SleepAnalogCloseOwned(record: NativeBuffer,exclusive: bool): int {
    val status=esp32C5SleepAnalogStatus(record)
    if (!exclusive) return 2
    if (status == 2 || status == 4) return status
    var index=c5SleepRecordRead(record,36);val count=c5SleepRecordRead(record,40)
    if (count < 6 || count > 7 || index >= count) return 2
    // Fixed reverse stages keep offset/mask selection constant: no flash jump tables.
    if (index >= 6) {
        if (!c5SleepAnalogField(6,c5SleepRecordRead(record,32))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,36,5)
    }
    if (index >= 5) {
        if (!c5SleepAnalogField(5,c5SleepRecordRead(record,28))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,36,4)
    }
    if (index >= 4) {
        if (!c5SleepAnalogField(4,c5SleepRecordRead(record,24))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,36,3)
    }
    if (index >= 3) {
        if (!c5SleepAnalogField(3,c5SleepRecordRead(record,20))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,36,2)
    }
    if (index >= 2) {
        if (!c5SleepAnalogField(2,c5SleepRecordRead(record,16))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,36,1)
    }
    if (index >= 1) {
        if (!c5SleepAnalogField(1,c5SleepRecordRead(record,12))) { c5SleepRecordWrite(record,4,3);return 3 }
        c5SleepRecordWrite(record,36,0)
    }
    if (index >= 0) {
        if (!c5SleepAnalogField(0,c5SleepRecordRead(record,8))) { c5SleepRecordWrite(record,4,3);return 3 }
    }
    c5SleepRecordWrite(record,4,4)
    4
}
