import "./sleep_recovery_c5_sequence.ab"
import "./sleep_entry_session_c5_sequence.ab"
import "./sleep_time_session_c5_sequence.ab"
import "./sleep_config_c5_sequence.ab"
import "../clock_resume_c5_sequence.ab"
import "./sleep_alarm_session_c5_sequence.ab"
import "./sleep_flash_ready_c5_sequence.ab"
import "./sleep_uarts_c5_sequence.ab"
@inline
trusted fun c5SleepRecoveryProfile(record: NativeBuffer): int = esp32C5SleepConfigCloseOwned(record,true)
@inline
trusted fun c5SleepRecoveryEntry(record: NativeBuffer): int = esp32C5SleepEntryCloseOwned(record,true)
@inline
trusted fun c5SleepRecoveryTime(record: NativeBuffer,outcome: int): int = esp32C5SleepTimeFinishOwned(record,outcome,true)
@inline
trusted fun c5SleepRecoveryClock(record: NativeBuffer,plan: C5CpuClock,pvt: bool,peripheralPll: bool): int = esp32C5ClockResumeOwned(record,plan,pvt,true,64,peripheralPll)
@inline
trusted fun c5SleepRecoveryAlarm(record: NativeBuffer): int = esp32C5SleepAlarmCloseOwned(record,true)
@inline
trusted fun c5SleepRecoveryCache(token: int,result: int,down: bool,us: int): bool = esp32C5SleepFlashResumeOwned(Esp32C5CacheSuspendState(token),result,down,us,true)
@inline
trusted fun c5SleepRecoveryUarts(token: int): int = esp32C5SleepUartsResumeOwned(Esp32C5SleepUarts(token),true)|0
