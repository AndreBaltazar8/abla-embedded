import "./sleep_recovery_c5_sequence.ab"
import "./sleep_entry_session_c5_sequence.ab"
import "./sleep_time_session_c5_sequence.ab"
import "./sleep_config_c5_sequence.ab"
import "../clock_resume_c5_sequence.ab"
import "./sleep_alarm_session_c5_sequence.ab"
import "./sleep_flash_ready_c5_sequence.ab"
import "./sleep_uarts_c5_sequence.ab"
import "../../hal/esp32_power.ab"
import "../sdk/raw_buffer.ab"
import "../cpu_clock_c5_sequence.ab"
import "../cache_suspend_c5_sequence.ab"
import "../sdk/nativebuffer_type.ab"
// These hooks are called from the .iram1 sleep sequences, which may run with the cache off: each is inlined there,
// and placed in .iram1 in case a call remains, so the sleep path never calls into flash.
@inline
@section(".iram1.abla.c5SleepRecoveryProfile")
@export("c5SleepRecoveryProfile")
trusted fun c5SleepRecoveryProfileHook(record: NativeBuffer): int = esp32C5SleepConfigCloseOwned(record,true)
@inline
@section(".iram1.abla.c5SleepRecoveryEntry")
@export("c5SleepRecoveryEntry")
trusted fun c5SleepRecoveryEntryHook(record: NativeBuffer): int = esp32C5SleepEntryCloseOwned(record,true)
@inline
@section(".iram1.abla.c5SleepRecoveryTime")
@export("c5SleepRecoveryTime")
trusted fun c5SleepRecoveryTimeHook(record: NativeBuffer,outcome: int): int = esp32C5SleepTimeFinishOwned(record,outcome,true)
@inline
@section(".iram1.abla.c5SleepRecoveryClock")
@export("c5SleepRecoveryClock")
trusted fun c5SleepRecoveryClockHook(record: NativeBuffer,plan: C5CpuClock,pvt: bool,peripheralPll: bool): int = esp32C5ClockResumeOwned(record,plan,pvt,true,64,peripheralPll)
@inline
@section(".iram1.abla.c5SleepRecoveryAlarm")
@export("c5SleepRecoveryAlarm")
trusted fun c5SleepRecoveryAlarmHook(record: NativeBuffer): int = esp32C5SleepAlarmCloseOwned(record,true)
@inline
@section(".iram1.abla.c5SleepRecoveryCache")
@export("c5SleepRecoveryCache")
trusted fun c5SleepRecoveryCacheHook(token: int,result: int,down: bool,us: int): bool = esp32C5SleepFlashResumeOwned(Esp32C5CacheSuspendState(token),result,down,us,true)
@inline
@section(".iram1.abla.c5SleepRecoveryUarts")
@export("c5SleepRecoveryUarts")
trusted fun c5SleepRecoveryUartsHook(token: int): int = esp32C5SleepUartsResumeOwned(Esp32C5SleepUarts(token),true)|0
