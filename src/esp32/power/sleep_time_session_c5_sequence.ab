import "./sleep_time_c5_sequence.ab"
import "./sleep_record_c5.ab"
//40B retained session:tag0,state4,startUs8/12,RTCbefore16/20,period24,
// immutable signed sleep outcome28,child result32,reserved36.
// Prepare1prepared2invalid; Finish1complete2invalid3pending.
// Caller supplies paired pre-sleep timestamps and measured Q19 period, owns
// RTC snapshots/SYSTIMER0/load/alarms and excludes scheduler/time observers.
// Finish only after clocks recover, before releasing those users. On retry
// sample RTC end afresh: reusing an old end could omit the retry interval.
// Terminal state prevents a second publication; do not copy/reinitialize a
// live or completed record until starting an independently owned sleep cycle.
@section(".iram1.abla.c5SleepTimePrepare")
trusted fun esp32C5SleepTimePrepareOwned(record: NativeBuffer,startUs: int,rtcBefore: int,period: int,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,40) || startUs < 0 || startUs > 0xffffffffffff || rtcBefore < 0 || rtcBefore > 0xffffffffffff || period < 1 || period > 0xffffffff) return 2
    if (c5SleepRecordRead(record,0) != 0) return 2
    c5SleepRecordWrite(record,8,startUs&0xffffffff);c5SleepRecordWrite(record,12,startUs>>>32)
    c5SleepRecordWrite(record,16,rtcBefore&0xffffffff);c5SleepRecordWrite(record,20,rtcBefore>>>32)
    c5SleepRecordWrite(record,24,period);c5SleepRecordWrite(record,28,0);c5SleepRecordWrite(record,32,0)
    c5SleepRecordWrite(record,4,1);c5SleepRecordWrite(record,0,0x43545331)
    1
}
// Capture in upstream order: RTC first, then high-resolution time, before
// clock parking/sleep preparation. Caller excludes writers and supplies a
// running, XTAL-clocked SYSTIMER0 and calibrated stable RTC slow clock.
//1prepared2invalid3clock unavailable4snapshot failure. Failure leaves record
// unclaimed; snapshot strobes may have occurred but no counter/clock changes.
@section(".iram1.abla.c5SleepTimeCapture")
trusted fun esp32C5SleepTimeCaptureOwned(record: NativeBuffer,period: int,exclusive: bool,polls: int = 64): int {
    if (!exclusive || !record.hasAddressRange(0,40) || period < 1 || period > 0xffffffff || polls < 1 || polls > 1000000 || c5SleepRecordRead(record,0) != 0) return 2
    if ((esp32C5TimerRead(0x6009606c)&u32(7)) != u32(5) || (esp32C5TimerRead(0x60096070)&u32(0x500000)) != u32(0x400000)) return 3
    val rtc=esp32C5RtcTicksOwned(0,true)
    val timer=esp32C5TimerTicks(0,polls)
    if (rtc < 0 || timer < 0) return 4
    esp32C5SleepTimePrepareOwned(record,timer>>>4,rtc,period,true)
}
@section(".iram1.abla.c5SleepTimeFinish")
trusted fun esp32C5SleepTimeFinishOwned(record: NativeBuffer,outcome: int,exclusive: bool,polls: int = 64): int {
    if (!exclusive || !record.hasAddressRange(0,40) || outcome < -3 || outcome > 1 || polls < 1 || polls > 1000000 || c5SleepRecordRead(record,0) != 0x43545331) return 2
    val state=c5SleepRecordRead(record,4)
    if (state < 1 || state > 3) return 2
    if (state != 1 && int(i32(c5SleepRecordRead(record,28))) != outcome) return 2
    if (state == 3) return 1
    if (state == 1) { c5SleepRecordWrite(record,28,outcome);c5SleepRecordWrite(record,4,2) }
    if (outcome != 0) { c5SleepRecordWrite(record,32,5);c5SleepRecordWrite(record,4,3);return 1 }
    val start=c5SleepRecordRead(record,8)|(c5SleepRecordRead(record,12)<<32)
    val before=c5SleepRecordRead(record,16)|(c5SleepRecordRead(record,20)<<32)
    val after=esp32C5RtcTicksOwned(0,true)
    val result=esp32C5SleepTimeCompensateOwned(start,before,after,c5SleepRecordRead(record,24),outcome,true,polls)
    c5SleepRecordWrite(record,32,result)
    if (result != 1 && result != 5) return 3
    c5SleepRecordWrite(record,4,3)
    1
}
