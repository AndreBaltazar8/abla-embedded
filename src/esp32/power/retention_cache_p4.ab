import "./retention_descriptor_p4.ab"
// All12 entries in upstream P4 cache_regs_retention, in exact sequence.
// 0/1 clear access errors;2/3 save five L1/six L2 configuration registers;
// 4..9 restore-only L1 invalidate setup/trigger/wait;10/11 pulse L2sync reset.
// Pure56B descriptor configuration, never performs these MMIO operations.
// Assemble ALL nodes in order into entry0. Execution requires valid retained
// buffers, PAU WAIT timeout, inaccessible dirty cache data already written
// back and proper hardware recovery context; NOT a live cache-flush API.
fun esp32p4RetentionCacheWords(node: int): int = if (node == 2) 5 else if (node == 3) 6 else 0
fun p4RetentionCacheOffset(node: int): int =
    if (node == 0) 0x170 else if (node == 1) 0x2f0 else if (node == 2) 0 else if (node == 3) 0x270 else
    if (node == 4) 0xa0 else if (node == 5) 0xa4 else if (node == 6) 0x9c else if (node <= 9) 0x98 else 0x3ac
fun p4RetentionCacheValue(node: int): int =
    if (node == 0) 31 else if (node == 6) 19 else if (node == 1 || node == 10) 32 else if (node == 8) 1 else if (node == 9) 16 else 0
fun p4RetentionCacheMask(node: int): int =
    if (node == 0) 31 else if (node == 1 || node >= 10) 32 else if (node == 4) 0xffffffff else if (node == 5) 0x0fffffff else
    if (node == 6) 63 else if (node == 7) 0x1e0 else if (node == 8) 1 else if (node == 9) 16 else 0
trusted fun esp32p4RetentionCacheConfig(c: NativeBuffer,node: int,storage: int,next: int): bool {
    if (node < 0 || node > 11 || !c.hasAddressRange(0,56) || (c.addressValue()&3) != 0 ||
        (next != 0 && !p4RetentionAddressSpan(next,4))) return false
    val words=esp32p4RetentionCacheWords(node)
    if (words != 0) {
        if (!p4RetentionAddressSpan(storage,words*4) || (storage < c.addressValue()+56 && c.addressValue() < storage+words*4)) return false
    } else if (storage != 0) return false
    if (next != 0 && next < c.addressValue()+56 && c.addressValue() < next+4) return false
    var i=4
    while (i < 56) { c.storeU32(i,0);i=i+4 }
    val address=0x3ff10000+p4RetentionCacheOffset(node)
    c.storeU32(4,next);c.storeU32(20,address)
    var head=if (next == 0) 0x80000000 else 0
    if (words != 0) {
        head=head|0x10000|words;c.storeU32(24,address);c.storeU32(28,storage)
        c.storeU32(32,if (node == 2) 7 else 0xc000000f)
        if (node == 2) c.storeU32(40,0x0c000000)
    } else {
        head=head|0x40000000|(if (node == 9) 0x30000 else 0x20000)
        c.storeU32(48,p4RetentionCacheValue(node));c.storeU32(52,p4RetentionCacheMask(node))
    }
    c.storeU32(0,head);return true
}
