import "../cache_suspend_c5_sequence.ab"
// C5 esp_light_sleep_inner ordering: after a successful flash power-down sleep,
// wait for flash power-on before permitting cache access. Rejected sleep did
// not power-cycle flash. No speculative credit for retention/CPU elapsed time:
// a full board-selected startup interval is conservative even with TOP off.
// Caller has restored flash power, pins, MSPI configuration and clocks; ROM
// delay ticks match the current CPU clock. The ENTIRE closure/stack/token must
// remain internal, with interrupts and cache users excluded until return.
// startupUs is the actual board flash startup budget (IDF default700us plus
// board-specific extra delay), not a readiness measurement or universal max.
// Owns exactly one live cache token. Successful return consumes it; do not
// retry/copy it. False changes nothing and retains ownership for correction.
@section(".iram1.abla.c5SleepFlashReady")
trusted fun esp32C5SleepFlashResumeOwned(saved: Esp32C5CacheSuspendState,sleepResult: int,flashPoweredDown: bool,startupUs: int,exclusiveReady: bool): bool {
    if (!exclusiveReady || (sleepResult != 0 && sleepResult != 1) || startupUs < 0 || startupUs > 0xFFFFFFFF ||
        (flashPoweredDown && startupUs == 0)) return false
    if (sleepResult == 0 && flashPoweredDown) c5SleepFlashReadyDelay(startupUs)
    esp32C5CacheResumeOwned(saved)
    true
}
