import "./sleep_policy_session_p4_sequence.ab"
import "./sleep_profile_esp32p4.ab"
import "./wake_session_esp32p4.ab"
import "./sleep_policy_esp32p4.ab"
import "./wake_trigger_esp32p4.ab"
import "../../hal/esp32_power.ab"
trusted noescape extern:"inline-assembly" fun p4PolicyCsr(template: string,constraints: string): u32
@export("p4PolicyHart")
trusted fun p4PolicyHartHook(): u32 = p4PolicyCsr("csrr $0, mhartid","=r")
@export("p4PolicyStatus")
trusted fun p4PolicyStatusHook(): u32 = p4PolicyCsr("csrr $0, mstatus","=r")
@export("p4PolicyProfileValid")
trusted fun p4PolicyProfileValidHook(c: NativeBuffer,revision: int): bool = p4SleepProfileConfigValid(c,revision)
@export("p4PolicyProfileOpen")
trusted fun p4PolicyProfileOpenHook(r: NativeBuffer,c: NativeBuffer,revision: int): int = esp32p4SleepProfileOpenOwned(r,c,revision,false,true)
@export("p4PolicyProfileClose")
trusted fun p4PolicyProfileCloseHook(r: NativeBuffer): int = esp32p4SleepProfileCloseOwned(r,true)
@export("p4PolicySourceOpen")
trusted fun p4PolicySourceOpenHook(r: NativeBuffer,selection: u32,levels: u32,pull: int,filter: bool,layout: int): int = esp32p4WakeSessionOpenOwned(r,selection,levels,pull,filter,layout,true)
@export("p4PolicySourceClose")
trusted fun p4PolicySourceCloseHook(r: NativeBuffer): int = esp32p4WakeSessionCloseOwned(r,true)
