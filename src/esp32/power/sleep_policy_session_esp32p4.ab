import "./sleep_policy_session_p4_sequence.ab"
import "./sleep_profile_esp32p4.ab"
import "./wake_session_esp32p4.ab"
import "./sleep_policy_esp32p4.ab"
import "./wake_trigger_esp32p4.ab"
trusted noescape extern:"inline-assembly" fun p4PolicyCsr(template: string,constraints: string): u32
trusted fun p4PolicyHart(): u32 = p4PolicyCsr("csrr $0, mhartid","=r")
trusted fun p4PolicyStatus(): u32 = p4PolicyCsr("csrr $0, mstatus","=r")
trusted fun p4PolicyProfileValid(c: NativeBuffer,revision: int): bool = p4SleepProfileConfigValid(c,revision)
trusted fun p4PolicyProfileOpen(r: NativeBuffer,c: NativeBuffer,revision: int): int = esp32p4SleepProfileOpenOwned(r,c,revision,false,true)
trusted fun p4PolicyProfileClose(r: NativeBuffer): int = esp32p4SleepProfileCloseOwned(r,true)
trusted fun p4PolicySourceOpen(r: NativeBuffer,selection: u32,levels: u32,pull: int,filter: bool,layout: int): int = esp32p4WakeSessionOpenOwned(r,selection,levels,pull,filter,layout,true)
trusted fun p4PolicySourceClose(r: NativeBuffer): int = esp32p4WakeSessionCloseOwned(r,true)
