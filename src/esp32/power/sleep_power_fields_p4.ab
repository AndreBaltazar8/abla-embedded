import "abla/runtime/scalar"
fun p4SleepPowerOffset(i: int): int = if (i == 0) 104 else if (i == 1) 124 else if (i == 2) 152 else
    if (i == 3) 168 else if (i == 4) 172 else if (i == 5) 192 else if (i == 6) 196 else 188
fun p4SleepPowerMask(i: int,layout: int): u32 = if (i == 0) (if (layout == 3) u32(0xe0e00000) else u32(0xc0e00000)) else
    if (i == 1) u32(0x7fe00000) else if (i == 2 || i == 7) u32(0x80000000) else
    if (i == 3 || i == 5) u32(0xfc000000) else u32(0xf8000000)
