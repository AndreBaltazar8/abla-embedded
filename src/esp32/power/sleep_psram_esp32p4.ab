import "./sleep_psram_p4_sequence.ab"
import "../psram/clock_esp32p4.ab"
import "../../hal/esp32_power.ab"
@export("p4SleepPsramHoldRead")
trusted fun p4SleepPsramHoldReadHook(): int = mmioLoadU32(0x501101cc)
@export("p4SleepPsramHoldWrite")
trusted fun p4SleepPsramHoldWriteHook(value: int): void { mmioStoreU32(0x501101cc,value);return }
