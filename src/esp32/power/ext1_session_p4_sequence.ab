import "./wake_session_p4_sequence.ab"
import "./wake_trigger_p4_sequence.ab"
// Full EXT1 source preparation, not sleep entry. Exclusive global PMU/RCC/LP
// ownership and former pad users quiesced; powered domains, released holds.
// Retain this whole184B aligned record until closed. Never independently use
// the inner160B lease. Trigger snapshot64@16; magic/state/primary/cleanup@0..12.
// Open parks ALL PMU triggers before changing pads; enables only EXT1 last.
// Close parks triggers, restores source/pads/clocks, then original trigger mask.
// State1ready3partial4closed; result1ready2invalid3triggerpark4source5triggerarm
// 8closed9cleanup. Inner source primary/cleanup details remain at offsets32/36.
trusted fun p4Ext1SessionValid(r: NativeBuffer): bool =
    r.hasAddressRange(0,184) && (r.addressValue()&3) == 0 && r.loadU32(0) == 0x50344531
trusted fun esp32p4Ext1SessionOpenOwned(r: NativeBuffer,selection: u32,highLevels: u32,
    pull: int,filter: bool,layout: int,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,184) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 ||
        selection == u32(0) || selection > u32(65535) || (highLevels&~selection) != u32(0) ||
        pull < 0 || pull > 2 || (layout != 1 && layout != 3)) return 2
    var offset=4
    while (offset < 184) { r.storeU32(offset,0);offset=offset+4 }
    r.storeU32(0,0x50344531);r.storeU32(4,3)
    var trigger=esp32p4WakeTriggerParkOwned(true)
    p4WakeSessionStore(r,16,trigger|0)
    if (trigger.status() != 5) { r.storeU32(8,3);return 3 }
    val inner=nativeBufferAt(r.addressValue()+24,160)
    if (esp32p4WakeSessionOpenOwned(inner,selection,highLevels,pull,filter,layout,true) != 1) {
        r.storeU32(8,4);return 4
    }
    trigger=trigger.configureOwned(esp32p4WakeTriggerExt1(),true)
    p4WakeSessionStore(r,16,trigger|0)
    if (trigger.status() != 1) { r.storeU32(8,5);return 5 }
    r.storeU32(4,1);return 1
}
trusted fun esp32p4Ext1SessionCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !p4Ext1SessionValid(r)) return 2
    if (r.loadU32(4) == 4) return 8
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 2
    r.storeU32(4,3)
    var trigger=P4WakeTrigger(p4WakeSessionLoad(r,16))
    trigger=trigger.parkOwned(true)
    p4WakeSessionStore(r,16,trigger|0)
    if (trigger.status() != 5) { r.storeU32(12,3);return 9 }
    val inner=nativeBufferAt(r.addressValue()+24,160)
    if (inner.loadU32(0) != 0 && esp32p4WakeSessionCloseOwned(inner,true) != 8) {
        r.storeU32(12,4);return 9
    }
    trigger=trigger.closeOwned(true)
    p4WakeSessionStore(r,16,trigger|0)
    if (trigger.status() != 4) { r.storeU32(12,5);return 9 }
    r.storeU32(12,0);r.storeU32(4,4);return 8
}
