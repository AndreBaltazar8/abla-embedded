import "./sleep_entry_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@section(".iram1.abla.s3SleepEntryRead")
@export("esp32S3SleepEntryRead")
trusted fun esp32S3SleepEntryReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3SleepEntryWrite")
@export("esp32S3SleepEntryWrite")
trusted fun esp32S3SleepEntryWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
@section(".iram1.abla.s3SleepEntryUpdate")
@export("esp32S3SleepEntryUpdate")
trusted fun esp32S3SleepEntryUpdateHook(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
