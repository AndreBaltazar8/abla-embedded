import "./sleep_entry_s3_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.s3SleepEntryRead")
trusted fun esp32S3SleepEntryRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3SleepEntryWrite")
trusted fun esp32S3SleepEntryWrite(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
@section(".iram1.abla.s3SleepEntryUpdate")
trusted fun esp32S3SleepEntryUpdate(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
