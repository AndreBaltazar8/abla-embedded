import "./wake_trigger_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("c5WakeTriggerRead")
trusted fun c5WakeTriggerReadHook(): int = mmioLoadU32(0x600b012c)
@export("c5WakeTriggerWrite")
trusted fun c5WakeTriggerWriteHook(value: int): void { mmioStoreU32(0x600b012c,value);return }
