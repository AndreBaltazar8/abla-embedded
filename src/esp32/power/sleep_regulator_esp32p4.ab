import "./sleep_regulator_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_power.ab"
@export("p4SleepRegulatorRead")
trusted fun p4SleepRegulatorReadHook(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
@export("p4SleepRegulatorWrite")
trusted fun p4SleepRegulatorWriteHook(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value));return }
