import "./fatal_vectors_esp32s3.ab"
// Default fatal handlers for unclaimed level4/5, debug6 and NMI7 slots.
// These do NOT implement resumable high-level ISRs or a debug monitor. A
// runtime using those services must supply its own architecture-level vectors.
@naked
@noinline
@section(".iram1.abla.s3Level4Vector")
trusted fun esp32S3Level4Vector(): void =
    esp32S3ContextExtraAssembly(".Labla_s3_level4_vector:\nwsr.excsave6 a0\nwsr.excsave7 a1\nmovi a1, 4\nj .Labla_s3_fatal_entry\n.org .Labla_s3_level4_vector+64", "~{memory}")
@inline
trusted fun esp32S3Level4VectorAddress(): int =
    int(esp32S3FatalAddressAssembly("movi $0, .Labla_s3_level4_vector", "=a,i,i,~{memory}",u32(nativeFunctionAddress(esp32S3Level4Vector)),u32(nativeFunctionAddress(esp32S3FatalEntry))))
