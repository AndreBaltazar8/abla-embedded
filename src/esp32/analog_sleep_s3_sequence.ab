// S3 light-sleep SAR analog calibration workaround, IDF regi2c_ctrl.c.
// All eight bytes are significant; zero is a valid snapshot, not an error.
// Caller owns analog bus and preserves this scalar in internal retained RAM.
// Capture before sleep; restore after wake before analog clients resume.
type Esp32S3AnalogSleepState = int
@section(".iram1.abla.s3AnalogSleepCapture")
trusted fun esp32S3AnalogSleepCaptureOwned(): Esp32S3AnalogSleepState {
    var state=0
    var register=0
    while (register < 8) {
        state=state | ((esp32S3AnalogSleepRead(register) & 255) << (register*8))
        register=register+1
    }
    Esp32S3AnalogSleepState(state)
}
@section(".iram1.abla.s3AnalogSleepRestore")
trusted fun esp32S3AnalogSleepRestoreOwned(state: Esp32S3AnalogSleepState): void {
    var register=0
    while (register < 8) {
        esp32S3AnalogSleepWrite(register,((state | 0) >>> (register*8)) & 255)
        register=register+1
    }
    return
}
