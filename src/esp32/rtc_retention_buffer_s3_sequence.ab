import "./sdk/raw_buffer.ab"
// S3 CPU retention:549 register-file blocks x16bytes +16byte DMA node.
// Unlike ordinary DMA, RTC descriptor size/length count16byte BLOCKS.
// Caller owns8800bytes in retained, RTC-DMA-accessible internal RAM, aligned16.
// Only initialize while retention DMA is stopped and the buffer is unpublished.
// Mirrors IDF aligned calloc + dma_link_init + CPU cfg initialization, without
// heap allocation. This does not arm retention or handle cache-tag retention.
@section(".iram1.abla.s3CpuRetentionBuffer")
trusted fun esp32S3CpuRetentionBufferInitOwned(storage: NativeBuffer): bool {
    if (!storage.hasAddressRange(0,8800) || (storage.addressValue() & 15) != 0) return false
    val base=storage.addressValue()
    var offset=0
    while (offset < 8800) {
        esp32S3RetentionBufferWrite(base+offset,0)
        offset=offset+4
    }
    // Hardware buffer configuration occupies its first128bit block.
    esp32S3RetentionBufferWrite(base+28,0xFFFE0000)
    esp32S3RetentionBufferWrite(base+4,base+16)
    // next=0 and padding=0 already initialized. Publish owner+EOF last.
    esp32S3RetentionBufferWrite(base,0xC0000000 | 549 | (549<<12))
    true
}
