import "./runtime_prepare_s3_sequence.ab"
import "./irq_runtime_esp32s3.ab"
import "./coprocessor_policy_esp32s3.ab"
import "./vector_activate_esp32s3.ab"
@inline
trusted fun esp32S3RuntimePrepareCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3RuntimePrepareEnabled(): int = esp32S3IrqStackEnabled()
@inline
trusted fun esp32S3RuntimePrepareIrq(stack: NativeBuffer,table: NativeBuffer,record: NativeBuffer,core: int,fault: int,context: int): bool =
    esp32S3IrqRuntimeInitializeOwned(stack,table,record,core,fault,context)
@inline
trusted fun esp32S3RuntimePreparePolicy(record: NativeBuffer,table: NativeBuffer,lock: NativeBuffer,core: int,fault: int,context: int,resolver: int): bool =
    esp32S3CoprocessorPolicyInstallOwned(record,table,lock,core,fault,context,resolver,context)
@inline
trusted fun esp32S3RuntimePrepareActivate(core: int): bool = esp32S3VectorsActivateOwned(core)
@inline
trusted fun esp32S3RuntimePreparePolicyRemove(record: NativeBuffer,core: int): bool = esp32S3CoprocessorPolicyRemoveOwned(record,core)
@inline
trusted fun esp32S3RuntimePrepareIrqRemove(record: NativeBuffer,core: int): bool = esp32S3IrqRuntimeReleaseOwned(record,core)
