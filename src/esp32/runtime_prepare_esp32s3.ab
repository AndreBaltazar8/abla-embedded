import "./runtime_prepare_s3_sequence.ab"
import "./irq_runtime_esp32s3.ab"
import "./coprocessor_policy_esp32s3.ab"
import "./vector_activate_esp32s3.ab"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
import "./sdk/raw_buffer.ab"
import "./irq_runtime_s3_sequence.ab"
import "./coprocessor_policy_s3_sequence.ab"
import "./vector_activate_s3_sequence.ab"
import "./sdk/nativebuffer_type.ab"
@inline
@export("esp32S3RuntimePrepareCore")
trusted fun esp32S3RuntimePrepareCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3RuntimePrepareEnabled")
trusted fun esp32S3RuntimePrepareEnabledHook(): int = esp32S3IrqStackEnabled()
@inline
@export("esp32S3RuntimePrepareIrq")
trusted fun esp32S3RuntimePrepareIrqHook(stack: NativeBuffer,table: NativeBuffer,record: NativeBuffer,core: int,fault: int,context: int): bool =
    esp32S3IrqRuntimeInitializeOwned(stack,table,record,core,fault,context)
@inline
@export("esp32S3RuntimePreparePolicy")
trusted fun esp32S3RuntimePreparePolicyHook(record: NativeBuffer,table: NativeBuffer,lock: NativeBuffer,core: int,fault: int,context: int,resolver: int): bool =
    esp32S3CoprocessorPolicyInstallOwned(record,table,lock,core,fault,context,resolver,context)
@inline
@export("esp32S3RuntimePrepareActivate")
trusted fun esp32S3RuntimePrepareActivateHook(core: int): bool = esp32S3VectorsActivateOwned(core)
@inline
@export("esp32S3RuntimePreparePolicyRemove")
trusted fun esp32S3RuntimePreparePolicyRemoveHook(record: NativeBuffer,core: int): bool = esp32S3CoprocessorPolicyRemoveOwned(record,core)
@inline
@export("esp32S3RuntimePrepareIrqRemove")
trusted fun esp32S3RuntimePrepareIrqRemoveHook(record: NativeBuffer,core: int): bool = esp32S3IrqRuntimeReleaseOwned(record,core)
