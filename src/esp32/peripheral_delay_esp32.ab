import "./peripheral_delay_rom_sequence.ab"
import "abla/unsafe/native"
import "../hal/esp32.ab"
// Classic ESP32 ROM ets_delay_us; caller calibrated ticks/us for actual CPU.
@export("peripheralRomDelay")
trusted fun peripheralRomDelayHook(microseconds: int): void {
    callNativeVoidI32(0x40008534,microseconds)
    return
}
