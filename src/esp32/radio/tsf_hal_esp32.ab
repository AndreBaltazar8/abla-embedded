import "abla/unsafe/memory"
import "../../xtensa/assembly.ab"

// Timing-synchronization controls for classic ESP32. NAN and SoftAP remain
// normal Abla functions and therefore disappear from station-only firmware.
// The two STA shims are temporary while the station state machine is opaque.

val esp32StaTsfControlRegister = 1073172512
val esp32SoftApTsfControlRegister = 1073172572
val esp32NanTsfControlRegister = 1073172632
val esp32TsfEnableMask = 2550136832

@inline
trusted fun esp32TsfUpdate(address: int, clearMask: u32, setMask: u32): void {
    val value = u32(ablaUnsafeVolatileLoadU32(address))
    ablaUnsafeVolatileStoreU32(address, (value & ~clearMask) | setMask)
    return
}

@export("hal_enable_sta_tsf")
trusted fun esp32EnableStationTsf(): void {
    // The vendor object also owns this public eight-byte scratch record.
    // Defining it here keeps data compatibility without retaining a function.
    xtensaAssemblyVoid(
        ".pushsection .bss.s_tbttstart,\"aw\",@nobits\n.global s_tbttstart\n.type s_tbttstart,@object\n.size s_tbttstart,8\ns_tbttstart:\n.space 8\n.popsection",
        "~{memory}"
    )
    esp32TsfUpdate(
        esp32StaTsfControlRegister, u32(0), u32(esp32TsfEnableMask)
    )
    return
}

@export("hal_disable_sta_tsf")
trusted fun esp32DisableStationTsf(): void {
    esp32TsfUpdate(
        esp32StaTsfControlRegister, u32(esp32TsfEnableMask), u32(0)
    )
    return
}

@export("hal_enable_nan_tsf")
trusted fun esp32EnableNanTsf(): void = esp32TsfUpdate(
    esp32NanTsfControlRegister, u32(0), u32(esp32TsfEnableMask)
)

@export("hal_disable_nan_tsf")
trusted fun esp32DisableNanTsf(): void = esp32TsfUpdate(
    esp32NanTsfControlRegister, u32(esp32TsfEnableMask), u32(0)
)

@export("hal_disable_softap_tsf")
trusted fun esp32DisableSoftApTsf(): void = esp32TsfUpdate(
    esp32SoftApTsfControlRegister, u32(3254779904), u32(0)
)
