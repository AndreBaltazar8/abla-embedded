import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRtcInternals(): bool {
    if (!internalFunction("esp32RecoveredCfgSdioVolt", "cfg_sdio_volt")) return false
    if (!internalFunction("esp32RecoveredRtcApbbridgeSel", "rtc_apbbridge_sel")) return false
    if (!internalFunction("esp32RecoveredRtcCmdExtWakeup", "rtc_cmd_ext_wakeup")) return false
    if (!internalFunction("esp32RecoveredRtcCmdWakeupConf", "rtc_cmd_wakeup_conf")) return false
    if (!internalFunction("esp32RecoveredRtcGetSt", "rtc_get_st")) return false
    if (!internalFunction("esp32RecoveredRtcInitFull", "rtc_init_full")) return false
    if (!internalFunction("esp32RecoveredRtcIsStIdle", "rtc_is_st_idle")) return false
    if (!internalFunction("esp32RecoveredRtcPadExtWakeup", "rtc_pad_ext_wakeup")) return false
    if (!internalFunction("esp32RecoveredRtcPadGpioWakeup", "rtc_pad_gpio_wakeup")) return false
    if (!internalFunction("esp32RecoveredRtcPadsFunie", "rtc_pads_funie")) return false
    if (!internalFunction("esp32RecoveredRtcPadsFunsel", "rtc_pads_funsel")) return false
    if (!internalFunction("esp32RecoveredRtcPadsHold", "rtc_pads_hold")) return false
    if (!internalFunction("esp32RecoveredRtcPadsMuxsel", "rtc_pads_muxsel")) return false
    if (!internalFunction("esp32RecoveredRtcPadsPd", "rtc_pads_pd")) return false
    if (!internalFunction("esp32RecoveredRtcPadsPu", "rtc_pads_pu")) return false
    if (!internalFunction("esp32RecoveredRtcPadsSlpie", "rtc_pads_slpie")) return false
    if (!internalFunction("esp32RecoveredRtcPadsSlpoe", "rtc_pads_slpoe")) return false
    if (!internalFunction("esp32RecoveredRtcPadsSlpsel", "rtc_pads_slpsel")) return false
    if (!internalFunction("esp32RecoveredRtcPowerdownRf", "rtc_powerdown_rf")) return false
    if (!internalFunction("esp32RecoveredRtcPowerupRf", "rtc_powerup_rf")) return false
    if (!internalFunction("esp32RecoveredRtcSdregOff", "rtc_sdreg_off")) return false
    if (!internalFunction("esp32RecoveredRtcSlpPrepLite12M", "rtc_slp_prep_lite_12M")) return false
    if (!internalFunction("esp32RecoveredRtcSocClkCk12m", "rtc_soc_clk_ck12m")) return false
    if (!internalFunction("esp32RecoveredRtcWifiForcePd", "rtc_wifi_force_pd")) return false
    true
}
