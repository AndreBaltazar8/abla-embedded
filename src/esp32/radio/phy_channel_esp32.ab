import "../../xtensa/assembly.ab"

// Thin channel-selection policy formerly supplied by libphy.a:phy.o. Only the
// no-MAC transition is still reached in station firmware, so it alone keeps a
// temporary external name. The actual synthesizer routines are the next PHY
// layer to move into this module.

trusted fun esp32RadioFrequencyChannelSelect(
    channel: u32,
    secondary: u32
): void {
    var r2 = channel
    var r3 = secondary
    var r4 = u32(0)
    var r5 = u32(0)
    var r6 = u32(0)
    var r7 = u32(0)
    var r8 = u32(0)
    var r9 = u32(0)
    var r10 = u32(0)
    var r11 = u32(0)
    var r12 = u32(0)
    var r13 = u32(0)
    var r14 = u32(0)
    var r15 = u32(0)
    var incomingStack0 = u32(0)
    var incomingStack1 = u32(0)
    var incomingStack2 = u32(0)
    var incomingStack3 = u32(0)
    var incomingStack4 = u32(0)
    var incomingStack5 = u32(0)
    var incomingStack6 = u32(0)
    var incomingStack7 = u32(0)
    var incomingStack8 = u32(0)
    var incomingStack9 = u32(0)
    var shiftAmount = u32(0)
    var compareExchangeExpected = u32(0)
    r11 = u32(i32(r3 << u32(24)) >> 24)
    r10 = u32(i32(r2 << u32(24)) >> 24)
    r10 = esp32RecoveredChipV7SetChan(r10, r11, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    return
}

