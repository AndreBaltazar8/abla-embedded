import "../../xtensa/assembly.ab"

// Thin channel-selection policy formerly supplied by libphy.a:phy.o. Only the
// no-MAC transition is still reached in station firmware, so it alone keeps a
// temporary external name. The actual synthesizer routines are the next PHY
// layer to move into this module.

@naked
trusted fun esp32RadioFrequencyChannelSelect(
    channel: u32,
    secondary: u32
): void = xtensaAssemblyVoid(
    "entry a1, 32\nsext a11, a3, 7\nsext a10, a2, 7\ncall8 chip_v7_set_chan\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32PhyChangeChannel(
    channel: u32,
    ignoredSecond: u32,
    ignoredThird: u32,
    secondary: u32
): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nextui a10, a2, 0, 16\nsext a11, a5, 7\ncall8 set_chanfreq\nmovi.n a2, 0\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32PhyChangeChannelWithoutMac(
    channel: u32,
    ignoredSecond: u32,
    ignoredThird: u32,
    secondary: u32
): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nextui a10, a2, 0, 16\nsext a11, a5, 7\ncall8 set_chanfreq_nomac\nmovi.n a2, 0\nretw.n",
    "~{memory}"
)
