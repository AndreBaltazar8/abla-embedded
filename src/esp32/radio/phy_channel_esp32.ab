    r10 = (r2 >>> u32(0)) & u32(65535)
    r11 = u32(i32(r5 << u32(24)) >> 24)
    r10 = esp32RecoveredSetChanfreq(r10, r11, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    r2 = u32(0)
    return r2
}

