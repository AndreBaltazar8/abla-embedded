import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkBluetoothBasebandOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBTInitRxFilters", "BT_init_rx_filters")) return false
    if (!internalFunction("esp32RecoveredBTTx8mEnable", "BT_tx_8m_enable")) return false
    if (!internalFunction("esp32RecoveredBTTxIfInit", "BT_tx_if_init")) return false
    if (!internalFunction("esp32RecoveredBtBbInitCmplx", "bt_bb_init_cmplx")) return false
    if (!internalFunction("esp32RecoveredBtBbInitCmplxReg", "bt_bb_init_cmplx_reg")) return false
    if (!internalFunction("esp32RecoveredBtBbVersion", "bt_bb_version")) return false
    if (!internalFunction("esp32RecoveredBtCmplxHqRe", "bt_cmplx_hq_re")) return false
    if (!internalFunction("esp32RecoveredBtCmplxLqRe", "bt_cmplx_lq_re")) return false
    if (!internalFunction("esp32RecoveredBtDgmixerFstep250k", "bt_dgmixer_fstep_250k")) return false
    if (!internalFunction("esp32RecoveredBtRfoffsetEn", "bt_rfoffset_en")) return false
    if (!internalFunction("esp32RecoveredCoexBtHighPrio", "coex_bt_high_prio")) return false
    if (!internalFunction("esp32RecoveredForceBtMode", "force_bt_mode")) return false
    if (!internalFunction("esp32RecoveredForceWifiMode", "force_wifi_mode")) return false
    if (!internalFunction("esp32RecoveredRwCoexOn", "rw_coex_on")) return false
    if (!internalFunction("esp32RecoveredUnforceWifiMode", "unforce_wifi_mode")) return false
    true
}
