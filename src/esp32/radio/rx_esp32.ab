import "../dma_descriptor.ab"
import "./rx_esp32_logic.ab"

// Validate a completed descriptor before exposing its hardware header or MPDU.
// The flags are sampled once, then the bounded header word is read only after
// the descriptor length, capacity, ownership, EOF, and address checks pass.
trusted fun DmaDescriptor.wifiRxFrameValid(): bool {
    if (this.isNull() || !this.isAligned(4)) return false
    val flags = this.flags()
    if (!esp32WifiRxDescriptorFlagsValid(flags)) return false
    val buffer = this.bufferAddress()
    if (buffer <= 0 || buffer > 4294967264) return false
    esp32WifiRxFrameMetadataValid(
        flags,
        buffer,
        register32(buffer + esp32WifiRxSignalLengthsOffset).read()
    )
}

@inline
trusted fun DmaDescriptor.wifiRxPaddedMpduAddress(): int =
    if (!this.wifiRxFrameValid()) 0
    else this.bufferAddress() + esp32WifiRxControlHeaderBytes

@inline
trusted fun DmaDescriptor.wifiRxPaddedMpduLength(): int =
    if (!this.wifiRxFrameValid()) 0
    else this.length() - esp32WifiRxControlHeaderBytes
