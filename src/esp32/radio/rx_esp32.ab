import "../dma_descriptor.ab"
import "./rx_esp32_logic.ab"
import "abla/unsafe/mmio"

@inline
trusted fun esp32WifiRxFrameValidNative(descriptorAddress: u32): bool {
    val zero = u32(0)
    if (descriptorAddress == zero ||
        descriptorAddress > u32(4294967284) ||
        (descriptorAddress & u32(3)) != zero) return false
    val flags = u32(mmioLoadU32(i64(descriptorAddress)))
    val length = (flags >> u32(12)) & u32(4095)
    if ((flags & u32(2147483648)) != zero ||
        (flags & u32(1073741824)) == zero || length < u32(32) ||
        length > (flags & u32(4095))) return false
    val buffer = u32(mmioLoadU32(i64(descriptorAddress + u32(4))))
    if (buffer == zero || buffer > u32(4294967264)) return false
    val signal = u32(mmioLoadU32(i64(buffer + u32(24))))
    (signal & u32(4095)) < length &&
        ((signal >> u32(12)) & u32(4095)) < length
}

// Validate a completed descriptor before exposing its hardware header or MPDU.
// The flags are sampled once, then the bounded header word is read only after
// the descriptor length, capacity, ownership, EOF, and address checks pass.
trusted fun DmaDescriptor.wifiRxFrameValid(): bool {
    val address = this.addressValue()
    if (address <= 0 || address > 4294967295) return false
    esp32WifiRxFrameValidNative(u32(address))
}

@inline
trusted fun DmaDescriptor.wifiRxPaddedMpduAddress(): int =
    if (!this.wifiRxFrameValid()) 0
    else this.bufferAddress() + esp32WifiRxControlHeaderBytes

@inline
trusted fun DmaDescriptor.wifiRxPaddedMpduLength(): int =
    if (!this.wifiRxFrameValid()) 0
    else this.length() - esp32WifiRxControlHeaderBytes
