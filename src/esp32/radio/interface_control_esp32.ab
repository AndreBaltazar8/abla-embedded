// Stateful policy portion of the classic ESP32 if_hwctrl façade. The original
// private `if_ctrl` array is internal static Abla storage rather than a public
// linker object. Exact ic_* names exist only while opaque net80211 callers
// remain outside this LLVM unit.

val esp32InterfaceControlAddress = nativeStaticAllocate(40)
val esp32InterfaceSixMegabitAddress = nativeStaticAllocate(1)

@inline
trusted fun esp32InterfaceControlRecordAddress(index: u32): int =
    esp32InterfaceControlAddress + esp32InterfaceControlOffset(index)

@inline
trusted fun esp32InterfaceControlLoad(index: u32, offset: int): u32 = u32(
    ablaUnsafeVolatileLoadU8(
        esp32InterfaceControlRecordAddress(index) + offset
    ) & 255
)

@inline
trusted fun esp32InterfaceControlStore(
    index: u32,
    offset: int,
    value: u32
): void {
    ablaUnsafeVolatileStoreU8(
        esp32InterfaceControlRecordAddress(index) + offset,
        int(value & u32(255))
    )
    return
}

@inline
trusted fun esp32InterfaceControlZero(address: int, count: int): void {
    var index = 0
    while (index < count) {
        ablaUnsafeVolatileStoreU8(address + index, 0)
        index = index + 1
    }
    return
}

trusted fun esp32MeshSetSixMegabitRate(enabled: u32): u32 {
    ablaUnsafeVolatileStoreU8(
        esp32InterfaceSixMegabitAddress, int(enabled & u32(255))
    )
    u32(0)
}

trusted fun esp32InterfaceControlGetAddress(index: u32): u32 =
    u32(esp32InterfaceControlRecordAddress(index))

trusted fun esp32InterfaceControlGetPairwiseAlgorithm(index: u32): u32 =
    esp32InterfaceControlLoad(index, 8)

trusted fun esp32InterfaceControlDeleteAlgorithms(index: u32): void {
    esp32InterfaceControlStore(index, 8, u32(0))
    esp32InterfaceControlStore(index, 9, u32(0))
    return
}

trusted fun esp32InterfaceControlIsPureStation(index: u32): u32 =
    esp32InterfaceControlPureStation(
        esp32InterfaceControlLoad(index, 6),
        esp32InterfaceControlLoad(index, 7)
    )

trusted fun esp32InterfaceControlIsEnabled(index: u32): u32 {
    val deviceControl = int(esp32Data_wDevCtrl_5f76fe526c)
    val mask = u32(ablaUnsafeVolatileLoadU8(deviceControl + 49) & 255)
    esp32InterfaceControlEnabled(mask, index)
}

trusted fun esp32InterfaceBasebandInterrupt(): u32 = u32(
    ablaUnsafeVolatileLoadU32(1073074252)
)

trusted fun esp32InterfaceEnableSniffer(): void {
    callNativeVoidI32(
        int(u32(nativeFunctionAddress(esp32RecoveredWdevSetPromis))), 1
    )
    return
}

trusted fun esp32InterfaceDisableSniffer(): void {
    callNativeVoidI32(
        int(u32(nativeFunctionAddress(esp32RecoveredWdevSetPromis))), 0
    )
    return
}

trusted fun esp32InterfaceEnableReceive(): void {
    val address = 1073164420
    ablaUnsafeVolatileStoreU32(
        address,
        ablaUnsafeVolatileLoadU32(address) | int(u32(2147483648))
    )
    return
}

trusted fun esp32InterfaceDisableReceive(): void {
    val address = 1073164420
    ablaUnsafeVolatileStoreU32(
        address,
        ablaUnsafeVolatileLoadU32(address) & 2147483647
    )
    return
}

trusted fun esp32InterfaceDisableCrypto(
    index: u32,
    retainAlgorithms: u32
): void {
    if ((retainAlgorithms & u32(255)) != u32(0)) return
    val interfaceIndex = index & u32(255)
    esp32InterfaceControlStore(interfaceIndex, 8, u32(0))
    esp32InterfaceControlStore(interfaceIndex, 9, u32(0))
    callNativeVoidI32(
        int(u32(nativeFunctionAddress(esp32RecoveredWDevCryptoDisable))),
        int(interfaceIndex)
    )
    return
}

trusted fun esp32InterfaceBeaconOffsetConfigure(configuration: u32): void {
    val cell = int(esp32Data_ptr_beacon_offset_funcs_9937a6c219)
    val provider = ablaUnsafeVolatileLoadU32(cell)
    if (provider == 0) return
    val callback = ablaUnsafeVolatileLoadU32(provider + 20)
    if (callback != 0) callNativeVoidPointer(
        callback, nativePointerFromAddress(int(configuration))
    )
    return
}

trusted fun esp32InterfaceBeaconOffsetSetReceiveStandard(value: u32): void {
    val cell = int(esp32Data_ptr_beacon_offset_funcs_9937a6c219)
    val provider = ablaUnsafeVolatileLoadU32(cell)
    if (provider == 0) return
    val callback = ablaUnsafeVolatileLoadU32(provider + 28)
    if (callback != 0) callNativeVoidI32(callback, int(value & u32(255)))
    return
}

trusted fun esp32InterfaceTransmitPacket(packet: u32): u32 = u32(
    callNativeI32PointerI32(
        int(u32(nativeFunctionAddress(esp32RecoveredPpTxPkt))),
        nativePointerFromAddress(int(packet)),
        1
    )
)

