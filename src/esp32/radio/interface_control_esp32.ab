trusted fun esp32InterfaceAmpduOperation(
    interfaceIndex: u32,
    traceIndex: u32,
    parameter: u32,
    operation: u32
): void {
    val trace = callNativeI32PointerI32(
        int(u32(nativeFunctionAddress(esp32RecoveredRcGetTrcByIndex))),
        nativePointerFromAddress(int(interfaceIndex & u32(255))),
        int(traceIndex & u32(255))
    )
    callNativeVoidPointerI32I32(
        int(u32(nativeFunctionAddress(esp32RecoveredTrcOnAmpduOp))),
        nativePointerFromAddress(trace),
        if (operation == u32(1)) 2 else 1,
        int(parameter & u32(255))
    )
    return
}

trusted fun esp32InterfaceUpdateTraceParameters(
    interfaceIndex: u32,
    traceIndex: u32,
    parameter: u32,
    packed: u32
): void {
    val trace = callNativeI32PointerI32(
        int(u32(nativeFunctionAddress(esp32RecoveredRcGetTrcByIndex))),
        nativePointerFromAddress(int(interfaceIndex & u32(255))),
        int(traceIndex & u32(255))
    )
    if (trace == 0) return
    val value = parameter & u32(255)
    ablaUnsafeVolatileStoreU8(trace + 130, int(value))
    callNativeVoidPointerI32I32I32(
        int(u32(nativeFunctionAddress(esp32RecoveredRcUpdateAMPDUParam))),
        nativePointerFromAddress(trace),
        int(value),
        int(packed & u32(3)),
        int((packed >> u32(2)) & u32(7))
    )
    return
}

