import "abla/unsafe/memory"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"
import "./ampdu_esp32.ab"
import "./crypto_table_esp32.ab"
import "./interface_control_forward_esp32.ab"
import "./interface_control_logic.ab"

// Stateful policy portion of the classic ESP32 if_hwctrl façade. The original
// private `if_ctrl` array is internal static Abla storage rather than a public
// linker object. Exact ic_* names exist only while opaque net80211 callers
// remain outside this LLVM unit.

val esp32InterfaceControlAddress = nativeStaticAllocate(40)
val esp32InterfaceSixMegabitAddress = nativeStaticAllocate(1)

@inline
trusted fun esp32InterfaceControlRecordAddress(index: u32): int =
    esp32InterfaceControlAddress + esp32InterfaceControlOffset(index)

@inline
trusted fun esp32InterfaceControlLoad(index: u32, offset: int): u32 = u32(
    ablaUnsafeVolatileLoadU8(
        esp32InterfaceControlRecordAddress(index) + offset
    ) & 255
)

@inline
trusted fun esp32InterfaceControlStore(
    index: u32,
    offset: int,
    value: u32
): void {
    ablaUnsafeVolatileStoreU8(
        esp32InterfaceControlRecordAddress(index) + offset,
        int(value & u32(255))
    )
    return
}

@inline
trusted fun esp32InterfaceControlZero(address: int, count: int): void {
    var index = 0
    while (index < count) {
        ablaUnsafeVolatileStoreU8(address + index, 0)
        index = index + 1
    }
    return
}

trusted fun esp32MeshSetSixMegabitRate(enabled: u32): u32 {
    ablaUnsafeVolatileStoreU8(
        esp32InterfaceSixMegabitAddress, int(enabled & u32(255))
    )
    u32(0)
}

trusted fun esp32InterfaceControlGetAddress(index: u32): u32 =
    u32(esp32InterfaceControlRecordAddress(index))

trusted fun esp32InterfaceControlGetPairwiseAlgorithm(index: u32): u32 =
    esp32InterfaceControlLoad(index, 8)

trusted fun esp32InterfaceControlDeleteAlgorithms(index: u32): void {
    esp32InterfaceControlStore(index, 8, u32(0))
    esp32InterfaceControlStore(index, 9, u32(0))
    return
}

trusted fun esp32InterfaceControlIsPureStation(index: u32): u32 =
    esp32InterfaceControlPureStation(
        esp32InterfaceControlLoad(index, 6),
        esp32InterfaceControlLoad(index, 7)
    )

trusted fun esp32InterfaceControlIsEnabled(index: u32): u32 {
    val deviceControl = int(xtensaAssemblyReadU32(
        "movi $0, wDevCtrl", "=a"
    ))
    val mask = u32(ablaUnsafeVolatileLoadU8(deviceControl + 49) & 255)
    esp32InterfaceControlEnabled(mask, index)
}

trusted fun esp32InterfaceBasebandInterrupt(): u32 = u32(
    ablaUnsafeVolatileLoadU32(1073074252)
)

trusted fun esp32InterfaceEnableSniffer(): void {
    callNativeVoidI32(
        int(xtensaAssemblyReadU32("movi $0, wdev_set_promis", "=a")), 1
    )
    return
}

trusted fun esp32InterfaceDisableSniffer(): void {
    callNativeVoidI32(
        int(xtensaAssemblyReadU32("movi $0, wdev_set_promis", "=a")), 0
    )
    return
}

trusted fun esp32InterfaceEnableReceive(): void {
    val address = 1073164420
    ablaUnsafeVolatileStoreU32(
        address,
        ablaUnsafeVolatileLoadU32(address) | int(u32(2147483648))
    )
    return
}

trusted fun esp32InterfaceDisableReceive(): void {
    val address = 1073164420
    ablaUnsafeVolatileStoreU32(
        address,
        ablaUnsafeVolatileLoadU32(address) & 2147483647
    )
    return
}

trusted fun esp32InterfaceDisableCrypto(
    index: u32,
    retainAlgorithms: u32
): void {
    if ((retainAlgorithms & u32(255)) != u32(0)) return
    val interfaceIndex = index & u32(255)
    esp32InterfaceControlStore(interfaceIndex, 8, u32(0))
    esp32InterfaceControlStore(interfaceIndex, 9, u32(0))
    callNativeVoidI32(
        int(xtensaAssemblyReadU32(
            "movi $0, wDev_Crypto_Disable", "=a"
        )),
        int(interfaceIndex)
    )
    return
}

trusted fun esp32InterfaceBeaconOffsetConfigure(configuration: u32): void {
    val cell = int(xtensaAssemblyReadU32(
        "movi $0, ptr_beacon_offset_funcs", "=a"
    ))
    val provider = ablaUnsafeVolatileLoadU32(cell)
    if (provider == 0) return
    val callback = ablaUnsafeVolatileLoadU32(provider + 20)
    if (callback != 0) callNativeVoidPointer(
        callback, nativePointerFromAddress(int(configuration))
    )
    return
}

trusted fun esp32InterfaceBeaconOffsetSetReceiveStandard(value: u32): void {
    val cell = int(xtensaAssemblyReadU32(
        "movi $0, ptr_beacon_offset_funcs", "=a"
    ))
    val provider = ablaUnsafeVolatileLoadU32(cell)
    if (provider == 0) return
    val callback = ablaUnsafeVolatileLoadU32(provider + 28)
    if (callback != 0) callNativeVoidI32(callback, int(value & u32(255)))
    return
}

trusted fun esp32InterfaceTransmitPacket(packet: u32): u32 = u32(
    callNativeI32PointerI32(
        int(xtensaAssemblyReadU32("movi $0, ppTxPkt", "=a")),
        nativePointerFromAddress(int(packet)),
        1
    )
)

trusted fun esp32InterfaceSetAccessCategory(
    interfaceIndex: u32,
    category: u32,
    arbitration: u32,
    exponent: u32,
    transmitOpportunity: u32
): void {
    callNativeVoidPointerI32I32I32I32(
        int(xtensaAssemblyReadU32("movi $0, lmacSetAcParam", "=a")),
        nativePointerFromAddress(int(interfaceIndex & u32(255))),
        int(category & u32(255)),
        int(arbitration & u32(255)),
        int(exponent & u32(255)),
        int(transmitOpportunity & u32(65535))
    )
    return
}

trusted fun esp32InterfaceSetReceivePolicy(
    interfaceIndex: u32,
    policy: u32,
    bufferType: u32,
    filter: u32
): u32 {
    callNativeVoidPointerI32I32I32(
        int(xtensaAssemblyReadU32(
            "movi $0, hal_mac_rx_set_policy", "=a"
        )),
        nativePointerFromAddress(int(interfaceIndex & u32(255))),
        int(policy & u32(255)),
        int(bufferType & u32(255)),
        int(filter & u32(255))
    )
    u32(1)
}

trusted fun esp32InterfaceSetReceiveQueuePolicy(
    interfaceIndex: u32,
    enabled: u32
): u32 {
    val index = interfaceIndex & u32(255)
    if (!esp32InterfaceControlReceivePolicyIndexValid(index)) return u32(0)
    callNativeVoidPointerI32(
        int(xtensaAssemblyReadU32(
            "movi $0, hal_mac_set_rxq_policy", "=a"
        )),
        nativePointerFromAddress(int(index)),
        int(enabled & u32(255))
    )
    u32(1)
}

trusted fun esp32InterfaceAmpduOperation(
    interfaceIndex: u32,
    traceIndex: u32,
    parameter: u32,
    operation: u32
): void {
    val trace = callNativeI32PointerI32(
        int(xtensaAssemblyReadU32(
            "movi $0, rc_get_trc_by_index", "=a"
        )),
        nativePointerFromAddress(int(interfaceIndex & u32(255))),
        int(traceIndex & u32(255))
    )
    callNativeVoidPointerI32I32(
        int(xtensaAssemblyReadU32("movi $0, trc_onAmpduOp", "=a")),
        nativePointerFromAddress(trace),
        if (operation == u32(1)) 2 else 1,
        int(parameter & u32(255))
    )
    return
}

trusted fun esp32InterfaceUpdateTraceParameters(
    interfaceIndex: u32,
    traceIndex: u32,
    parameter: u32,
    packed: u32
): void {
    val trace = callNativeI32PointerI32(
        int(xtensaAssemblyReadU32(
            "movi $0, rc_get_trc_by_index", "=a"
        )),
        nativePointerFromAddress(int(interfaceIndex & u32(255))),
        int(traceIndex & u32(255))
    )
    if (trace == 0) return
    val value = parameter & u32(255)
    ablaUnsafeVolatileStoreU8(trace + 130, int(value))
    callNativeVoidPointerI32I32I32(
        int(xtensaAssemblyReadU32(
            "movi $0, rcUpdateAMPDUParam", "=a"
        )),
        nativePointerFromAddress(trace),
        int(value),
        int(packed & u32(3)),
        int((packed >> u32(2)) & u32(7))
    )
    return
}

trusted fun esp32InterfaceMacInitialize(): u32 {
    callNativeVoid0(int(xtensaAssemblyReadU32(
        "movi $0, hal_mac_init", "=a"
    )))
    u32(0)
}

trusted fun esp32InterfaceMacDeinitialize(): u32 {
    callNativeVoid0(int(xtensaAssemblyReadU32(
        "movi $0, hal_mac_deinit", "=a"
    )))
    u32(0)
}

trusted fun esp32InterfaceUpdateListenInterval(interval: u32): void {
    callNativeVoidI32(
        int(xtensaAssemblyReadU32(
            "movi $0, wifi_nvs_set_sta_listen_interval", "=a"
        )),
        int(interval & u32(65535))
    )
    val open = xtensaAssemblyReadU32(
        "movi a8, pm_is_open\ncallx8 a8\nmov.n $0, a10",
        "=a,~{a8},~{a10},~{memory}"
    )
    if (open != u32(0)) callNativeVoid0(int(xtensaAssemblyReadU32(
        "movi $0, pm_scale_listen_interval", "=a"
    )))
    return
}

trusted fun esp32InterfaceGetKey(
    interfaceOutput: u32,
    cipherOutput: u32,
    keyIdentifierOutput: u32,
    peerOutput: u32,
    slot: u32,
    keyOutput: u32,
    keyLength: u32
): u32 {
    val configuration = nativeStackAllocate(9)
    esp32InterfaceControlZero(configuration, 9)
    esp32HalCryptoGetKeyEntry(
        i32(slot & u32(255)),
        keyOutput,
        i32(keyLength),
        u32(configuration)
    )
    ablaUnsafeVolatileStoreU8(
        int(interfaceOutput), ablaUnsafeVolatileLoadU8(configuration)
    )
    ablaUnsafeVolatileStoreU32(
        int(cipherOutput),
        ablaUnsafeVolatileLoadU8(configuration + 1)
    )
    ablaUnsafeVolatileStoreU32(
        int(keyIdentifierOutput),
        ablaUnsafeVolatileLoadU8(configuration + 2)
    )
    var index = 0
    while (index < 6) {
        ablaUnsafeVolatileStoreU8(
            int(peerOutput) + index,
            ablaUnsafeVolatileLoadU8(configuration + 3 + index)
        )
        index = index + 1
    }
    u32(0)
}

trusted fun esp32InterfaceObtainKey(
    interfaceIndex: u32,
    cipher: u32,
    keyIdentifier: u32,
    peerAddress: u32,
    keyOutput: u32,
    keyLength: u32
): u32 {
    val configuration = nativeStackAllocate(9)
    var slot = 4
    while (slot < 25) {
        if (esp32HalCryptoKeyValid(i32(slot)) != i32(0)) {
            esp32InterfaceControlZero(configuration, 9)
            esp32HalCryptoGetKeyEntry(
                i32(slot), keyOutput, i32(keyLength), u32(configuration)
            )
            var matches =
                u32(ablaUnsafeVolatileLoadU8(configuration)) ==
                    (interfaceIndex & u32(255)) &&
                u32(ablaUnsafeVolatileLoadU8(configuration + 1)) ==
                    (cipher & u32(255)) &&
                u32(ablaUnsafeVolatileLoadU8(configuration + 2)) ==
                    (keyIdentifier & u32(255))
            var index = 0
            while (matches && index < 6) {
                if (ablaUnsafeVolatileLoadU8(configuration + 3 + index) !=
                    ablaUnsafeVolatileLoadU8(int(peerAddress) + index)) {
                    matches = false
                }
                index = index + 1
            }
            if (matches) return u32(slot)
        }
        slot = slot + 1
    }
    u32(0)
}

trusted fun esp32InterfaceSetKey(
    interfaceIndex: u32,
    cipher: u32,
    flags: u32,
    keyAddress: u32,
    keyLength: u32,
    peerAddress: u32,
    keyIndex: u32,
    receiveSequence: u32,
    transmitSequence: u32
): void {
    val index = interfaceIndex & u32(255)
    val algorithm = cipher & u32(255)
    val length = keyLength & u32(255)
    if (length >= u32(4)) {
        esp32InterfaceControlStore(index, 8, algorithm)
    } else {
        if (algorithm == u32(0)) {
            esp32InterfaceControlStore(index, 8, u32(0))
        }
        esp32InterfaceControlStore(index, 9, algorithm)
    }

    val osi = ablaUnsafeVolatileLoadU32(int(xtensaAssemblyReadU32(
        "movi $0, g_osi_funcs_p", "=a"
    )))
    if (osi != 0) {
        val enterCritical = ablaUnsafeVolatileLoadU32(osi + 216)
        if (enterCritical != 0) callNativeVoid0(enterCritical)
    }
    xtensaAssemblyCallVoid9(
        "s32i $6, a1, 0\ns32i $7, a1, 4\ns32i $8, a1, 8\ncall8 wDev_Insert_KeyEntry",
        "{a10},{a11},{a12},{a13},{a14},{a15},a,a,a,~{a8},~{a9},~{memory}",
        algorithm,
        index,
        flags & u32(255),
        keyAddress,
        length,
        peerAddress,
        keyIndex & u32(255),
        receiveSequence & u32(255),
        transmitSequence & u32(255)
    )
    if (osi != 0) {
        val exitCritical = ablaUnsafeVolatileLoadU32(osi + 220)
        if (exitCritical != 0) callNativeVoid0(exitCritical)
    }
    return
}

trusted fun esp32InterfaceSetTrace(configuration: u32): void {
    val address = int(configuration)
    val interfaceIndex = u32(ablaUnsafeVolatileLoadU8(address + 1) & 255)
    if (ablaUnsafeVolatileLoadU8(address) == 0) {
        callNativeVoidI32(
            int(xtensaAssemblyReadU32("movi $0, rc_disable_trc", "=a")),
            int(interfaceIndex)
        )
        return
    }

    val trace = int(xtensaAssemblyReadU32WithU32U32U32U32(
        "movi a8, rc_enable_trc\ncallx8 a8\nmov $0, a10",
        "=&a,{a10},{a11},{a12},{a13},~{a8},~{a9},~{a14},~{a15},~{memory}",
        interfaceIndex,
        u32(ablaUnsafeVolatileLoadU32(address + 4)),
        u32(ablaUnsafeVolatileLoadU8(address + 8) & 255),
        u32(ablaUnsafeVolatileLoadU8(address + 10) & 255)
    ))
    if (trace == 0) return

    // The windowed ABI returns the trace pointer in a10, the same fixed
    // register used for the first call argument. Reload the interface byte as
    // the original implementation does instead of carrying that value across
    // the inline-assembly call.
    val activeInterfaceIndex = u32(
        ablaUnsafeVolatileLoadU8(address + 1) & 255
    )
    var physicalMode = esp32InterfaceControlLoad(activeInterfaceIndex, 7)
    val meshStarted = ablaUnsafeVolatileLoadU8(
        int(xtensaAssemblyReadU32("movi $0, g_mesh_is_started", "=a"))
    ) != 0
    if (meshStarted) {
        if (activeInterfaceIndex != u32(0) || ablaUnsafeVolatileLoadU8(
            int(xtensaAssemblyReadU32("movi $0, g_mesh_is_root", "=a"))
        ) == 0) {
            physicalMode = u32(ablaUnsafeVolatileLoadU8(
                esp32InterfaceSixMegabitAddress
            ) & 255)
        }
    }

    val ampdu = u32(ablaUnsafeVolatileLoadU8(address + 12) & 255)
    val packed = u32(ablaUnsafeVolatileLoadU8(address + 26) & 255)
    callNativeVoidPointerI32I32I32(
        int(xtensaAssemblyReadU32("movi $0, rcUpdateAMPDUParam", "=a")),
        nativePointerFromAddress(trace),
        int(ampdu),
        int(packed & u32(3)),
        int((packed >> u32(2)) & u32(7))
    )
    ablaUnsafeVolatileStoreU8(trace + 130, int(ampdu))
    val optional = ablaUnsafeVolatileLoadU32(address + 20)
    if (optional != 0) {
        ablaUnsafeVolatileStoreU8(
            trace + 135, ablaUnsafeVolatileLoadU8(optional + 1)
        )
        if (ablaUnsafeVolatileLoadU8(optional) != 0) {
            ablaUnsafeVolatileStoreU8(trace + 130, 6)
        }
    }
    var rate = int(
        (u32(ablaUnsafeVolatileLoadU32(address + 16)) + u32(96)) & u32(127)
    )
    if (rate >= 64) rate = rate - 128
    callNativeVoidPointerI32I32I32I32(
        int(xtensaAssemblyReadU32("movi $0, rcUpdatePhyMode", "=a")),
        nativePointerFromAddress(trace),
        rate,
        ablaUnsafeVolatileLoadU8(address + 24),
        ablaUnsafeVolatileLoadU8(address + 25),
        int(physicalMode)
    )
    return
}

trusted fun esp32InterfaceLogPolicy(policy: u32): void {
    xtensaAssemblyCallVoid5(
        "call8 wifi_log",
        "{a10},{a11},{a12},{a13},{a14},~{a8},~{a9},~{a15},~{memory}",
        u32(1),
        u32(12),
        u32(4),
        u32(nativeCStringAddress("filter: set rx policy=%d")),
        policy
    )
    return
}

trusted fun esp32InterfaceApplyReceivePolicy(
    interfaceIndex: u32,
    enabling: bool
): void {
    var policy = u32(0)
    if (interfaceIndex == u32(0)) {
        policy = if (enabling) u32(1) else u32(2)
    } else if (interfaceIndex == u32(1)) {
        policy = if (enabling) u32(8) else u32(9)
    } else if (interfaceIndex == u32(2)) {
        policy = if (enabling) u32(10) else u32(12)
    } else if (interfaceIndex == u32(3)) {
        if (enabling) esp32InterfaceEnableSniffer()
        else esp32InterfaceDisableSniffer()
        return
    } else {
        xtensaAssemblyCallVoid5(
            "call8 wifi_log",
            "{a10},{a11},{a12},{a13},{a14},~{a8},~{a9},~{a15},~{memory}",
            u32(6),
            u32(1),
            u32(1),
            u32(nativeCStringAddress("set vif: invalid index=%d")),
            interfaceIndex
        )
        return
    }
    esp32InterfaceLogPolicy(policy)
    callNativeVoidI32(
        int(xtensaAssemblyReadU32("movi $0, wifi_set_rx_policy", "=a")),
        int(policy)
    )
    return
}

trusted fun esp32InterfaceSetVirtualInterface(
    interfaceValue: u32,
    operationValue: u32,
    macAddress: u32,
    modeValue: u32,
    physicalModeValue: u32,
    retainAlgorithmsValue: u32
): void {
    val interfaceIndex = interfaceValue & u32(255)
    val operation = operationValue & u32(255)
    val mode = modeValue & u32(255)
    val physicalMode = physicalModeValue & u32(255)
    val retainAlgorithms = retainAlgorithmsValue & u32(255)

    if (operation == u32(2)) {
        esp32InterfaceControlStore(interfaceIndex, 6, mode)
        esp32InterfaceControlStore(interfaceIndex, 7, physicalMode)
        return
    }

    val deviceControl = int(xtensaAssemblyReadU32(
        "movi $0, wDevCtrl", "=a"
    ))
    val interfaceMaskAddress = deviceControl + 49
    val interfaceBit = u32(1) << interfaceIndex

    if (operation == u32(0)) {
        esp32InterfaceApplyReceivePolicy(interfaceIndex, true)
        var byteIndex = 0
        while (byteIndex < 6) {
            esp32InterfaceControlStore(
                interfaceIndex,
                byteIndex,
                u32(ablaUnsafeVolatileLoadU8(int(macAddress) + byteIndex))
            )
            byteIndex = byteIndex + 1
        }
        esp32InterfaceControlStore(interfaceIndex, 6, mode)
        esp32InterfaceControlStore(interfaceIndex, 7, physicalMode)
        val enabledMask =
            u32(ablaUnsafeVolatileLoadU8(interfaceMaskAddress) & 255) |
            interfaceBit
        ablaUnsafeVolatileStoreU8(interfaceMaskAddress, int(enabledMask))
        if (enabledMask != u32(0)) {
            val receiveControl = 1073164420
            ablaUnsafeVolatileStoreU32(
                receiveControl,
                ablaUnsafeVolatileLoadU32(receiveControl) |
                    int(u32(2147483648))
            )
        }
        esp32InterfaceDisableCrypto(interfaceIndex, retainAlgorithms)
        return
    }

    if (operation == u32(1)) {
        val oldMask = u32(
            ablaUnsafeVolatileLoadU8(interfaceMaskAddress) & 255
        )
        var newMask = oldMask
        if ((oldMask & interfaceBit) != u32(0)) {
            newMask = oldMask & ~interfaceBit
            ablaUnsafeVolatileStoreU8(interfaceMaskAddress, int(newMask))
            callNativeVoidI32(
                int(xtensaAssemblyReadU32(
                    "movi $0, rc_disable_trc_by_interface", "=a"
                )),
                int(interfaceIndex)
            )
        }
        if (newMask == u32(0)) {
            val receiveControl = 1073164420
            ablaUnsafeVolatileStoreU32(
                receiveControl,
                ablaUnsafeVolatileLoadU32(receiveControl) & 2147483647
            )
            callNativeVoid0(int(xtensaAssemblyReadU32(
                "movi $0, pm_force_scan_unlock", "=a"
            )))
        }
        esp32InterfaceApplyReceivePolicy(interfaceIndex, false)
        return
    }

    xtensaAssemblyCallVoid5(
        "call8 wifi_log",
        "{a10},{a11},{a12},{a13},{a14},~{a8},~{a9},~{a15},~{memory}",
        u32(6),
        u32(1),
        u32(1),
        u32(nativeCStringAddress("set vif: invalid index=%d")),
        interfaceIndex
    )
    return
}

trusted fun esp32InterfaceConfigureCsi(configuration: u32): u32 {
    val address = int(configuration)
    callNativeVoidPointerI32I32I32I32(
        int(xtensaAssemblyReadU32(
            "movi $0, phy_chan_dump_cfg", "=a"
        )),
        nativePointerFromAddress(ablaUnsafeVolatileLoadU8(address + 5)),
        ablaUnsafeVolatileLoadU8(address + 6),
        ablaUnsafeVolatileLoadU8(address),
        ablaUnsafeVolatileLoadU8(address + 1),
        ablaUnsafeVolatileLoadU8(address + 2)
    )
    callNativeVoidI32I32(
        int(xtensaAssemblyReadU32(
            "movi $0, phy_chan_filt_set", "=a"
        )),
        ablaUnsafeVolatileLoadU8(address + 4),
        ablaUnsafeVolatileLoadU8(address + 3)
    )
    val enabled = ablaUnsafeVolatileLoadU8(address + 7) != 0
    val mask = if (enabled) int(u32(536870912)) else 536870911
    val first = 1073164536
    val second = 1073164540
    if (enabled) {
        ablaUnsafeVolatileStoreU32(
            first, ablaUnsafeVolatileLoadU32(first) | mask
        )
        ablaUnsafeVolatileStoreU32(
            second, ablaUnsafeVolatileLoadU32(second) | mask
        )
    } else {
        ablaUnsafeVolatileStoreU32(
            first, ablaUnsafeVolatileLoadU32(first) & mask
        )
        ablaUnsafeVolatileStoreU32(
            second, ablaUnsafeVolatileLoadU32(second) & mask
        )
    }
    u32(0)
}

trusted fun esp32InterfaceDeinitialize(): u32 {
    callNativeVoid0(int(xtensaAssemblyReadU32(
        "movi $0, pm_deattach", "=a"
    )))
    callNativeVoid0(int(xtensaAssemblyReadU32(
        "movi $0, wDev_Rxbuf_Deinit", "=a"
    )))
    callNativeVoid0(int(xtensaAssemblyReadU32(
        "movi $0, pp_deattach", "=a"
    )))
    callNativeVoid0(int(xtensaAssemblyReadU32(
        "movi $0, trc_deinit", "=a"
    )))
    u32(0)
}

trusted fun esp32InterfaceInitialize(
    receiveBuffers: u32,
    packetConfiguration: u32,
    traceMode: u32
): u32 {
    callNativeVoidI32(
        int(xtensaAssemblyReadU32("movi $0, trc_init", "=a")),
        int(traceMode & u32(255))
    )
    callNativeVoid0(int(xtensaAssemblyReadU32(
        "movi $0, lmacInit", "=a"
    )))
    var status = callNativeI32Pointer(
        int(xtensaAssemblyReadU32("movi $0, pp_attach", "=a")),
        nativePointerFromAddress(int(packetConfiguration))
    )
    if (status == 0) status = callNativeI32Pointer(
        int(xtensaAssemblyReadU32("movi $0, wDev_Rxbuf_Init", "=a")),
        nativePointerFromAddress(int(receiveBuffers))
    )
    if (status != 0) {
        esp32InterfaceDeinitialize()
        return u32(status)
    }
    callNativeVoid0(int(xtensaAssemblyReadU32(
        "movi $0, pm_attach", "=a"
    )))
    val osiCell = int(xtensaAssemblyReadU32(
        "movi $0, g_osi_funcs_p", "=a"
    ))
    val osi = ablaUnsafeVolatileLoadU32(osiCell)
    if (osi != 0) {
        val coexistStart = ablaUnsafeVolatileLoadU32(osi + 464)
        if (coexistStart != 0) callNativeVoidPointer(
            coexistStart,
            nativePointerFromAddress(int(xtensaAssemblyReadU32(
