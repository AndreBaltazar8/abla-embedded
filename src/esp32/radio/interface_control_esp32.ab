trusted fun esp32InterfaceUpdateListenInterval(interval: u32): void {
    callNativeVoidI32(
        int(u32(nativeFunctionAddress(esp32RecoveredWifiNvsSetStaListenInterval))),
        int(interval & u32(65535))
    )
    val open = esp32RecoveredPmIsOpen(u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    if (open != u32(0)) callNativeVoid0(int(u32(nativeFunctionAddress(esp32RecoveredPmScaleListenInterval))))
    return
}

trusted fun esp32InterfaceGetKey(
    interfaceOutput: u32,
    cipherOutput: u32,
    keyIdentifierOutput: u32,
    peerOutput: u32,
    slot: u32,
    keyOutput: u32,
    keyLength: u32
): u32 {
    val configuration = nativeStackAllocate(9)
    esp32InterfaceControlZero(configuration, 9)
    esp32HalCryptoGetKeyEntry(
        i32(slot & u32(255)),
        keyOutput,
        i32(keyLength),
        u32(configuration)
    )
    ablaUnsafeVolatileStoreU8(
        int(interfaceOutput), ablaUnsafeVolatileLoadU8(configuration)
    )
    ablaUnsafeVolatileStoreU32(
        int(cipherOutput),
        ablaUnsafeVolatileLoadU8(configuration + 1)
    )
    ablaUnsafeVolatileStoreU32(
        int(keyIdentifierOutput),
        ablaUnsafeVolatileLoadU8(configuration + 2)
    )
    var index = 0
    while (index < 6) {
        ablaUnsafeVolatileStoreU8(
            int(peerOutput) + index,
            ablaUnsafeVolatileLoadU8(configuration + 3 + index)
        )
        index = index + 1
    }
    u32(0)
}

trusted fun esp32InterfaceObtainKey(
    interfaceIndex: u32,
    cipher: u32,
    keyIdentifier: u32,
    peerAddress: u32,
    keyOutput: u32,
    keyLength: u32
): u32 {
    val configuration = nativeStackAllocate(9)
    var slot = 4
    while (slot < 25) {
        if (esp32HalCryptoKeyValid(i32(slot)) != i32(0)) {
            esp32InterfaceControlZero(configuration, 9)
            esp32HalCryptoGetKeyEntry(
                i32(slot), keyOutput, i32(keyLength), u32(configuration)
            )
            var matches =
                u32(ablaUnsafeVolatileLoadU8(configuration)) ==
                    (interfaceIndex & u32(255)) &&
                u32(ablaUnsafeVolatileLoadU8(configuration + 1)) ==
                    (cipher & u32(255)) &&
                u32(ablaUnsafeVolatileLoadU8(configuration + 2)) ==
                    (keyIdentifier & u32(255))
            var index = 0
            while (matches && index < 6) {
                if (ablaUnsafeVolatileLoadU8(configuration + 3 + index) !=
                    ablaUnsafeVolatileLoadU8(int(peerAddress) + index)) {
                    matches = false
                }
                index = index + 1
            }
            if (matches) return u32(slot)
        }
        slot = slot + 1
    }
    u32(0)
}

trusted fun esp32InterfaceSetKey(
    interfaceIndex: u32,
    cipher: u32,
    flags: u32,
    keyAddress: u32,
    keyLength: u32,
    peerAddress: u32,
    keyIndex: u32,
    receiveSequence: u32,
    transmitSequence: u32
): void {
    val index = interfaceIndex & u32(255)
    val algorithm = cipher & u32(255)
    val length = keyLength & u32(255)
    if (length >= u32(4)) {
        esp32InterfaceControlStore(index, 8, algorithm)
    } else {
        if (algorithm == u32(0)) {
            esp32InterfaceControlStore(index, 8, u32(0))
        }
        esp32InterfaceControlStore(index, 9, algorithm)
    }

    val osi = ablaUnsafeVolatileLoadU32(int(esp32Data_g_osi_funcs_p_7cce4a7228))
    if (osi != 0) {
        val enterCritical = ablaUnsafeVolatileLoadU32(osi + 216)
        if (enterCritical != 0) callNativeVoid0(enterCritical)
    }
    esp32RecoveredWDevInsertKeyEntry(algorithm, index, flags & u32(255), keyAddress, length, peerAddress, keyIndex & u32(255), receiveSequence & u32(255), transmitSequence & u32(255), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    if (osi != 0) {
        val exitCritical = ablaUnsafeVolatileLoadU32(osi + 220)
        if (exitCritical != 0) callNativeVoid0(exitCritical)
    }
    return
}

trusted fun esp32InterfaceSetTrace(configuration: u32): void {
    val address = int(configuration)
    val interfaceIndex = u32(ablaUnsafeVolatileLoadU8(address + 1) & 255)
    if (ablaUnsafeVolatileLoadU8(address) == 0) {
        // ic_set_trc passes interface, peer MAC, and AID on both branches.
        esp32RecoveredRcDisableTrc(
            interfaceIndex,
            u32(ablaUnsafeVolatileLoadU32(address + 4)),
            u32(ablaUnsafeVolatileLoadU8(address + 8) & 255),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0)
        )
        return
    }

    val trace = int(esp32RecoveredRcEnableTrc(interfaceIndex, u32(ablaUnsafeVolatileLoadU32(address + 4)), u32(ablaUnsafeVolatileLoadU8(address + 8) & 255), u32(ablaUnsafeVolatileLoadU8(address + 10) & 255), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)))
    if (trace == 0) return

    // The windowed ABI returns the trace pointer in a10, the same fixed
    // register used for the first call argument. Reload the interface byte as
    // the original implementation does instead of carrying that value across
    // the inline-assembly call.
    val activeInterfaceIndex = u32(
        ablaUnsafeVolatileLoadU8(address + 1) & 255
    )
    var physicalMode = esp32InterfaceControlLoad(activeInterfaceIndex, 7)
    val meshStarted = ablaUnsafeVolatileLoadU8(
        int(esp32Data_g_mesh_is_started_97bfe60706)
    ) != 0
    if (meshStarted) {
        if (activeInterfaceIndex != u32(0) || ablaUnsafeVolatileLoadU8(
            int(esp32Data_g_mesh_is_root_ada96cde9d)
        ) == 0) {
            physicalMode = u32(ablaUnsafeVolatileLoadU8(
                esp32InterfaceSixMegabitAddress
            ) & 255)
        }
    }

    val ampdu = u32(ablaUnsafeVolatileLoadU8(address + 12) & 255)
    val packed = u32(ablaUnsafeVolatileLoadU8(address + 26) & 255)
    callNativeVoidPointerI32I32I32(
        int(u32(nativeFunctionAddress(esp32RecoveredRcUpdateAMPDUParam))),
        nativePointerFromAddress(trace),
        int(ampdu),
        int(packed & u32(3)),
        int((packed >> u32(2)) & u32(7))
    )
    ablaUnsafeVolatileStoreU8(trace + 130, int(ampdu))
    val optional = ablaUnsafeVolatileLoadU32(address + 20)
    if (optional != 0) {
        ablaUnsafeVolatileStoreU8(
            trace + 135, ablaUnsafeVolatileLoadU8(optional + 1)
        )
        if (ablaUnsafeVolatileLoadU8(optional) != 0) {
            ablaUnsafeVolatileStoreU8(trace + 130, 6)
        }
    }
    var rate = int(
        (u32(ablaUnsafeVolatileLoadU32(address + 16)) + u32(96)) & u32(255)
    )
    if (rate >= 128) rate = rate - 256
    callNativeVoidPointerI32I32I32I32(
        int(u32(nativeFunctionAddress(esp32RecoveredRcUpdatePhyMode))),
        nativePointerFromAddress(trace),
        rate,
        int(physicalMode),
        ablaUnsafeVolatileLoadU8(address + 24),
        ablaUnsafeVolatileLoadU8(address + 25)
    )
    return
}

trusted fun esp32InterfaceLogPolicy(policy: u32): void {
    esp32WifiLogValue(u32(1), u32(12), u32(4), u32(nativeCStringAddress("filter: set rx policy=%d")), policy, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    return
}

trusted fun esp32InterfaceApplyReceivePolicy(
    interfaceIndex: u32,
    enabling: bool
): void {
    var policy = u32(0)
    if (interfaceIndex == u32(0)) {
        policy = if (enabling) u32(1) else u32(2)
    } else if (interfaceIndex == u32(1)) {
        policy = if (enabling) u32(8) else u32(9)
    } else if (interfaceIndex == u32(2)) {
        policy = if (enabling) u32(10) else u32(12)
    } else if (interfaceIndex == u32(3)) {
        if (enabling) esp32InterfaceEnableSniffer()
        else esp32InterfaceDisableSniffer()
        return
    } else {
        esp32WifiLogValue(u32(6), u32(1), u32(1), u32(nativeCStringAddress("set vif: invalid index=%d")), interfaceIndex, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
        return
    }
    esp32InterfaceLogPolicy(policy)
    callNativeVoidI32(
        int(u32(nativeFunctionAddress(esp32RecoveredWifiSetRxPolicy))),
        int(policy)
    )
    return
}

trusted fun esp32InterfaceSetVirtualInterface(
    interfaceValue: u32,
    operationValue: u32,
    macAddress: u32,
    modeValue: u32,
    physicalModeValue: u32,
    retainAlgorithmsValue: u32
): void {
    val interfaceIndex = interfaceValue & u32(255)
    val operation = operationValue & u32(255)
    val mode = modeValue & u32(255)
    val physicalMode = physicalModeValue & u32(255)
    val retainAlgorithms = retainAlgorithmsValue & u32(255)

    if (operation == u32(2)) {
        esp32InterfaceControlStore(interfaceIndex, 6, mode)
        esp32InterfaceControlStore(interfaceIndex, 7, physicalMode)
        return
    }

    val deviceControl = int(esp32Data_wDevCtrl_5f76fe526c)
    val interfaceMaskAddress = deviceControl + 49
    val interfaceBit = u32(1) << interfaceIndex

    if (operation == u32(0)) {
        esp32InterfaceApplyReceivePolicy(interfaceIndex, true)
        var byteIndex = 0
        while (byteIndex < 6) {
            esp32InterfaceControlStore(
                interfaceIndex,
                byteIndex,
                u32(ablaUnsafeVolatileLoadU8(int(macAddress) + byteIndex))
            )
            byteIndex = byteIndex + 1
        }
        esp32InterfaceControlStore(interfaceIndex, 6, mode)
        esp32InterfaceControlStore(interfaceIndex, 7, physicalMode)
        val enabledMask =
            u32(ablaUnsafeVolatileLoadU8(interfaceMaskAddress) & 255) |
            interfaceBit
        ablaUnsafeVolatileStoreU8(interfaceMaskAddress, int(enabledMask))
        if (enabledMask != u32(0)) {
            val receiveControl = 1073164420
            ablaUnsafeVolatileStoreU32(
                receiveControl,
                ablaUnsafeVolatileLoadU32(receiveControl) |
                    int(u32(2147483648))
            )
        }
        esp32InterfaceDisableCrypto(interfaceIndex, retainAlgorithms)
        return
    }

    if (operation == u32(1)) {
        val oldMask = u32(
            ablaUnsafeVolatileLoadU8(interfaceMaskAddress) & 255
        )
        var newMask = oldMask
        if ((oldMask & interfaceBit) != u32(0)) {
            newMask = oldMask & ~interfaceBit
            ablaUnsafeVolatileStoreU8(interfaceMaskAddress, int(newMask))
            callNativeVoidI32(
                int(u32(nativeFunctionAddress(esp32RecoveredRcDisableTrcByInterface))),
                int(interfaceIndex)
            )
        }
        if (newMask == u32(0)) {
            val receiveControl = 1073164420
            ablaUnsafeVolatileStoreU32(
                receiveControl,
                ablaUnsafeVolatileLoadU32(receiveControl) & 2147483647
            )
            callNativeVoid0(int(u32(nativeFunctionAddress(esp32RecoveredPmForceScanUnlock))))
        }
        esp32InterfaceApplyReceivePolicy(interfaceIndex, false)
        return
    }

    esp32WifiLogValue(u32(6), u32(1), u32(1), u32(nativeCStringAddress("set vif: invalid index=%d")), interfaceIndex, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    return
}

trusted fun esp32InterfaceConfigureCsi(configuration: u32): u32 {
    val address = int(configuration)
    callNativeVoidPointerI32I32I32I32(
        int(u32(nativeFunctionAddress(esp32RecoveredPhyChanDumpCfg))),
        nativePointerFromAddress(ablaUnsafeVolatileLoadU8(address + 5)),
        ablaUnsafeVolatileLoadU8(address + 6),
        ablaUnsafeVolatileLoadU8(address),
        ablaUnsafeVolatileLoadU8(address + 1),
        ablaUnsafeVolatileLoadU8(address + 2)
    )
    callNativeVoidI32I32(
        int(u32(nativeFunctionAddress(esp32RecoveredPhyChanFiltSet))),
        ablaUnsafeVolatileLoadU8(address + 4),
        ablaUnsafeVolatileLoadU8(address + 3)
    )
    val enabled = ablaUnsafeVolatileLoadU8(address + 7) != 0
    val mask = if (enabled) int(u32(536870912)) else 536870911
    val first = 1073164536
    val second = 1073164540
    if (enabled) {
        ablaUnsafeVolatileStoreU32(
            first, ablaUnsafeVolatileLoadU32(first) | mask
        )
        ablaUnsafeVolatileStoreU32(
            second, ablaUnsafeVolatileLoadU32(second) | mask
        )
    } else {
        ablaUnsafeVolatileStoreU32(
            first, ablaUnsafeVolatileLoadU32(first) & mask
        )
        ablaUnsafeVolatileStoreU32(
            second, ablaUnsafeVolatileLoadU32(second) & mask
        )
    }
    u32(0)
}

trusted fun esp32InterfaceDeinitialize(): u32 {
    callNativeVoid0(int(u32(nativeFunctionAddress(esp32RecoveredPmDeattach))))
    callNativeVoid0(int(u32(nativeFunctionAddress(esp32RecoveredWDevRxbufDeinit))))
    callNativeVoid0(int(u32(nativeFunctionAddress(esp32RecoveredPpDeattach))))
    esp32TrcDeinitialize()
    u32(0)
}

trusted fun esp32InterfaceInitialize(
    receiveBuffers: u32,
    packetConfiguration: u32,
    traceMode: u32
): u32 {
    val rateControlStatus = esp32TrcInitialize()
    if (rateControlStatus != u32(0)) return rateControlStatus
    callNativeVoid0(int(u32(nativeFunctionAddress(esp32RecoveredLmacInit))))
    val packetStatus = esp32RecoveredPpAttach(
        packetConfiguration,
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    // This monolithic station build owns every packet buffer used above.
    // Completion of the fixed pool setup is the success condition; the
    // recovered register-shaped return is not part of the station ABI.
    var status = int(packetStatus)
    if (status == 0) {
        status = int(esp32RecoveredWDevRxbufInit(
            receiveBuffers,
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        ))
    }
    if (status != 0) {
        esp32InterfaceDeinitialize()
        return u32(status)
    }
    callNativeVoid0(int(u32(nativeFunctionAddress(esp32RecoveredPmAttach))))
    val osiCell = int(esp32Data_g_osi_funcs_p_7cce4a7228)
    val osi = ablaUnsafeVolatileLoadU32(osiCell)
    if (osi != 0) {
        val coexistStart = ablaUnsafeVolatileLoadU32(osi + 464)
        if (coexistStart != 0) callNativeVoidPointer(
            coexistStart,
            nativePointerFromAddress(int(u32(nativeFunctionAddress(esp32RecoveredEspWifiInternalOnCoexStart))))
        )
        val coexistPhase = ablaUnsafeVolatileLoadU32(osi + 460)
        if (coexistPhase != 0) callNativeVoidPointerPointer(
