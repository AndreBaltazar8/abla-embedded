import "../../register.ab"
import "./power_esp32_logic.ab"

// Opt-in classic ESP32 radio power and clock primitives. The scalar carries
// no storage. Callers own serialization against Bluetooth, the hardware RNG,
// sleep, and both CPU cores; no hidden global reference count is introduced.
type WifiRadioPower = int

@inline
fun wifiRadioPower(): WifiRadioPower = WifiRadioPower(esp32DportWifiClockAddress)

@inline
fun WifiRadioPower.clockRegister(): Register32 =
    register32(esp32DportWifiClockAddress)

@inline
fun WifiRadioPower.resetRegister(): Register32 =
    register32(esp32DportWifiResetAddress)

@inline
fun WifiRadioPower.powerRegister(): Register32 =
    register32(esp32RtcWifiPowerAddress)

@inline
fun WifiRadioPower.isolationRegister(): Register32 =
    register32(esp32RtcWifiIsolationAddress)

@inline
trusted fun WifiRadioPower.macClockEnabled(): bool =
    esp32WifiClockEnabled(this.clockRegister().read(), esp32WifiMacClockMask)

@inline
trusted fun WifiRadioPower.commonClockEnabled(): bool =
    esp32WifiClockEnabled(
        this.clockRegister().read(), esp32WifiBtCommonClockMask
    )

@inline
trusted fun WifiRadioPower.powerDownForced(): bool =
    esp32WifiPowerForced(
        this.powerRegister().read(), esp32WifiForcePowerDownMask
    )

@inline
trusted fun WifiRadioPower.isolationForced(): bool =
    esp32WifiPowerForced(
        this.isolationRegister().read(), esp32WifiForceIsolationMask
    )

trusted fun WifiRadioPower.setMacModuleEnabled(enabled: bool): void {
    if (enabled) {
        this.clockRegister().setBits(esp32WifiMacClockMask)
        this.resetRegister().clearBits(esp32WifiMacResetMask)
    } else {
        this.clockRegister().clearBits(esp32WifiMacClockMask)
        this.resetRegister().setBits(esp32WifiMacResetMask)
    }
    return
}

trusted fun WifiRadioPower.setCommonClockEnabled(enabled: bool): void {
    if (enabled) {
        this.clockRegister().setBits(esp32WifiBtCommonClockMask)
    } else {
        this.clockRegister().clearBits(esp32WifiBtCommonClockMask)
    }
    return
}

trusted fun WifiRadioPower.resetMac(): void {
    this.resetRegister().setBits(esp32WifiMacResetMask)
    this.resetRegister().clearBits(esp32WifiMacResetMask)
    return
}

trusted fun WifiRadioPower.setMacState(initialized: bool): void {
    val control = register32(esp32WifiMacControlAddress)
    if (initialized) control.clearBits(esp32WifiMacStateMask)
    else control.setBits(esp32WifiMacStateMask)
    return
}

// Power-on is intentionally split around the hardware's required delay.
// After beginPowerOn(), the caller must wait at least 10 microseconds before
// completePowerOn(). A native cycle-delay primitive is still being added to
// Abla; pretending an ordinary optimized loop is a timer would be unsafe.
trusted fun WifiRadioPower.beginPowerOn(): void {
    this.powerRegister().clearBits(esp32WifiForcePowerDownMask)
    return
}

trusted fun WifiRadioPower.completePowerOn(): void {
    val clock = this.clockRegister()
    val previousSharedClockBits =
        clock.read() & esp32WifiBtCommonClockMask
    clock.setBits(esp32WifiBtCommonClockMask)
    this.resetRegister().setBits(esp32WifiPowerOnResetMask)
    this.resetRegister().clearBits(esp32WifiPowerOnResetMask)
    this.isolationRegister().clearBits(esp32WifiForceIsolationMask)
    clock.update(esp32WifiBtCommonClockMask, previousSharedClockBits)
    return
}

trusted fun WifiRadioPower.powerOff(): void {
    this.isolationRegister().setBits(esp32WifiForceIsolationMask)
    this.powerRegister().setBits(esp32WifiForcePowerDownMask)
    return
}
