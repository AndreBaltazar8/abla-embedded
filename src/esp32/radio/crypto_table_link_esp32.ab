import "abla/build"

// The complete hal_crypto.o surface is implemented by crypto_table_esp32.ab.
// Its only remaining users are Abla-owned radio functions, so every ABI name
// has internal linkage and remains eligible for whole-program pruning.
compile fun esp32Idf6LinkCryptoTableInternals(): bool {
    if (!internalFunction("esp32HalCryptoInitialize", "hal_crypto_init")) return false
    if (!internalFunction("esp32HalCryptoGetKeyEntry", "hal_crypto_get_key_entry")) return false
    if (!internalFunction("esp32HalCryptoUsingKeyIndex", "hal_crypto_get_using_key_idx")) return false
    if (!internalFunction("esp32HalCryptoKeyValid", "hal_crypto_is_key_valid")) return false
    if (!internalFunction("esp32HalCryptoManagementReceiveEnabled", "hal_crypto_mgmt_rx_enabled")) return false
    if (!internalFunction("esp32HalCryptoClearKeyEntry", "hal_crypto_clr_key_entry")) return false
    if (!internalFunction("esp32HalCryptoEnable", "hal_crypto_enable")) return false
    if (!internalFunction("esp32HalCryptoDisable", "hal_crypto_disable")) return false
    if (!internalFunction("esp32HalCryptoSetKeyEntry", "hal_crypto_set_key_entry")) return false
    true
}
