import "../dma_descriptor_logic.ab"

val esp32WifiRxQueueBytes = 8
val esp32WifiRxQueueFirstOffset = 0
val esp32WifiRxQueueStateOffset = 4
val esp32WifiRxQueuePendingMask = 3
val esp32WifiRxQueueLastMask = 4294967292

val esp32WifiRxQueueIdle = 0
val esp32WifiRxQueueTaking = 1
val esp32WifiRxQueueRecycling = 2

@inline
fun esp32WifiRxQueueStorageAddressValid(address: int): bool =
    address > 0 && address <= 4294967288 &&
        (address / 4) * 4 == address

@inline
fun esp32WifiRxQueueState(last: int, pendingKind: int): int =
    if (!espDmaDescriptorAddressValid(last, true) ||
        !esp32WifiRxQueuePendingKindValid(pendingKind)) -1
    else last | pendingKind

@inline
fun esp32WifiRxQueueStateLast(state: int): int =
    state & esp32WifiRxQueueLastMask

@inline
fun esp32WifiRxQueueStatePendingKind(state: int): int =
    state & esp32WifiRxQueuePendingMask

@inline
fun esp32WifiRxQueueDescriptorAddressValid(address: int): bool =
    espDmaDescriptorAddressValid(address, true)

fun esp32WifiRxQueueEndpointsValid(first: int, last: int): bool =
    esp32WifiRxQueueDescriptorAddressValid(first) &&
        esp32WifiRxQueueDescriptorAddressValid(last) &&
        ((first == 0 && last == 0) || (first != 0 && last != 0))

@inline
fun esp32WifiRxQueuePendingKindValid(kind: int): bool =
    kind >= esp32WifiRxQueueIdle && kind <= esp32WifiRxQueueRecycling
