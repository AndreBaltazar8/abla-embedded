import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"

// Exact rate maps recovered from trc.o. Keeping them as data gives LLVM a
// bounds-checked byte lookup and removes the old jump-into-the-middle-of-a-
// function reconstruction.
val esp32TransmitRate11GMapStorage = nativeStaticBytes(
    "\x0a\x09\x08\xff\xff\x09\x08\xff\x01\x03\x05\x07\x00\x02\x04\x06" +
    "\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" +
    "\xff\xff\xff\xff\xff\xff\xff\xff\xff\x0c\x0b"
)
val esp32TransmitRate11GMap = u32(esp32TransmitRate11GMapStorage)

val esp32TransmitRate11BMapStorage = nativeStaticBytes(
    "\x03\x02\x01\x00\xff\x02\x01\x00\xff\xff\xff\xff\xff\xff\xff\xff" +
    "\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff" +
    "\xff\xff\xff\xff\xff\xff\xff\xff\xff\x05\x04"
)
val esp32TransmitRate11BMap = u32(esp32TransmitRate11BMapStorage)

@inline
trusted fun esp32TransmitRateMapLookup(map:u32, rate:u32):u32 {
    val normalizedRate = rate & u32(0xff)
    if (normalizedRate > u32(42)) return u32(0xff)
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(map + normalizedRate))))
}

trusted fun esp32TransmitRate11NToScheduleIndex(rate:u32):u32 {
    val normalizedRate = rate & u32(0xff)
    if (normalizedRate == u32(0)) return u32(11)
    if (normalizedRate == u32(1)) return u32(10)
    if (normalizedRate == u32(2)) return u32(9)
    if (normalizedRate == u32(3) || normalizedRate == u32(4))
        return u32(24) - normalizedRate
    if (normalizedRate == u32(5)) return u32(10)
    if (normalizedRate == u32(6)) return u32(9)
    if (normalizedRate == u32(41)) return u32(13)
    if (normalizedRate == u32(42)) return u32(12)
    if (normalizedRate == u32(31)) return u32(0)
    (u32(24) - normalizedRate) & u32(0xff)
}

trusted fun esp32TransmitRate11BToScheduleIndex(rate:u32):u32 =
    esp32TransmitRateMapLookup(esp32TransmitRate11BMap,rate)

trusted fun esp32TransmitRate11GToScheduleIndex(rate:u32):u32 =
    esp32TransmitRateMapLookup(esp32TransmitRate11GMap,rate)

trusted fun esp32TransmitRateBuildIndex(entries:u32, count:u32):u32 {
    // The binary intentionally treats a low-byte count of zero as 256.
    var remaining = ((count - u32(1)) & u32(0xff)) + u32(1)
    var index = u32(0)
    var entry = entries
    while (remaining != u32(0)) {
        ablaUnsafeStoreU8(
            nativePointerFromAddress(int(entry + u32(10))), int(index)
        )
        xtensaMemoryBarrier()
        index = (index + u32(1)) & u32(0xff)
        entry = entry + u32(12)
        remaining = remaining - u32(1)
    }
    xtensaMemoryBarrier()
    entry
}
