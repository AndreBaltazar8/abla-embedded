import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPacketDebugInternals(): bool {
    if (!internalFunction("esp32RecoveredDbgEbufLocShow", "dbg_ebuf_loc_show")) return false
    if (!internalFunction("esp32RecoveredDbgHisLmacEbShow", "dbg_his_lmac_eb_show")) return false
    if (!internalFunction("esp32RecoveredDbgHisLmacEventShow", "dbg_his_lmac_event_show")) return false
    if (!internalFunction("esp32RecoveredDbgHisLmacIntShow", "dbg_his_lmac_int_show")) return false
    if (!internalFunction("esp32RecoveredDbgHisLmacRxShow", "dbg_his_lmac_rx_show")) return false
    if (!internalFunction("esp32RecoveredDbgHisLmacTxShow", "dbg_his_lmac_tx_show")) return false
    if (!internalFunction("esp32RecoveredDbgLmacDiagStatisDump", "dbg_lmac_diag_statis_dump")) return false
    if (!internalFunction("esp32RecoveredDbgLmacHwStatisDump", "dbg_lmac_hw_statis_dump")) return false
    if (!internalFunction("esp32RecoveredDbgLmacInit", "dbg_lmac_init")) return false
    if (!internalFunction("esp32RecoveredDbgLmacPsStatisDump", "dbg_lmac_ps_statis_dump")) return false
    if (!internalFunction("esp32RecoveredDbgLmacPsStatisReset", "dbg_lmac_ps_statis_reset")) return false
    if (!internalFunction("esp32RecoveredDbgLmacRxtxStatisDump", "dbg_lmac_rxtx_statis_dump")) return false
    if (!internalFunction("esp32RecoveredDbgLmacStatisDump", "dbg_lmac_statis_dump")) return false
    if (!internalFunction("esp32RecoveredDbgPerfPathSet", "dbg_perf_path_set")) return false
    if (!internalFunction("esp32RecoveredDbgPerfPathShow", "dbg_perf_path_show")) return false
    if (!internalFunction("esp32RecoveredDbgPerfThroughputCal", "dbg_perf_throughput_cal")) return false
    if (!internalFunction("esp32RecoveredWifiGpioDebug", "wifi_gpio_debug")) return false
    if (!internalFunction("esp32RecoveredWifiGpioDebugMaxEventGet", "wifi_gpio_debug_max_event_get")) return false
    if (!internalFunction("esp32RecoveredWifiSetGpioDebugCb", "wifi_set_gpio_debug_cb")) return false
    true
}
