import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEsfBufferOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEsfBufAlloc", "esf_buf_alloc")) return false
    if (!internalFunction("esp32RecoveredEsfBufAllocDefaultHandler", "esf_buf_alloc_default_handler")) return false
    if (!internalFunction("esp32RecoveredEsfBufAllocDynamic", "esf_buf_alloc_dynamic")) return false
    if (!internalFunction("esp32RecoveredEsfBufAllocDynamicDefaultHandler", "esf_buf_alloc_dynamic_default_handler")) return false
    if (!internalFunction("esp32RecoveredEsfBufFreeStatic", "esf_buf_free_static")) return false
    if (!internalFunction("esp32RecoveredEsfBufRecycle", "esf_buf_recycle")) return false
    if (!internalFunction("esp32RecoveredEsfBufRecycleDefaultHandler", "esf_buf_recycle_default_handler")) return false
    if (!internalFunction("esp32RecoveredEsfBufSetdown", "esf_buf_setdown")) return false
    if (!internalFunction("esp32RecoveredEsfBufSetup", "esf_buf_setup")) return false
    if (!internalFunction("esp32RecoveredEsfBufSetupForMesh", "esf_buf_setup_for_mesh")) return false
    if (!internalFunction("esp32RecoveredEsfBufSetupStatic", "esf_buf_setup_static")) return false
    if (!internalFunction("esp32RecoveredEsfBufStatisDump", "esf_buf_statis_dump")) return false
    true
}
