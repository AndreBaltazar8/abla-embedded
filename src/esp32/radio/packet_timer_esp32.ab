import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"

// Classic ESP32 packet-processing timer dispatch. The vendor implementation
// materializes a writable 120-byte {kind, callback} table plus fourteen tiny
// forwarding functions. Abla selects the handler directly, so the table and
// forwarding functions do not become permanent linker-visible roots.

var esp32PacketTimerPostCallback = u32(0)

@inline
trusted fun esp32PacketTimerLoadU8(address: u32): i32 =
    i32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))) & 255)

@inline
trusted fun esp32PacketTimerLoadU32(address: u32): u32 =
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))

@inline
trusted fun esp32PacketTimerSymbol(name: i32): u32 {
    if (name == 0) return xtensaAssemblyReadU32(
        "movi $0, pm_noise_check_process", "=a"
    )
    if (name == 1) return xtensaAssemblyReadU32(
        "movi $0, pm_tbtt_process", "=a"
    )
    if (name == 2) return xtensaAssemblyReadU32(
        "movi $0, pm_dream_timeout_process", "=a"
    )
    if (name == 3) return xtensaAssemblyReadU32(
        "movi $0, pm_active_timeout_process", "=a"
    )
    if (name == 4) return xtensaAssemblyReadU32(
        "movi $0, pm_coex_slice_timeout_process", "=a"
    )
    if (name == 5) return xtensaAssemblyReadU32(
        "movi $0, pm_sleep_delay_timeout_process", "=a"
    )
    if (name == 6) return xtensaAssemblyReadU32(
        "movi $0, pm_disconnected_sleep_delay_timeout_process", "=a"
    )
    if (name == 7) return xtensaAssemblyReadU32(
        "movi $0, pm_connectionless_wake_interval_timeout_process", "=a"
    )
    if (name == 8) return xtensaAssemblyReadU32(
        "movi $0, pm_connectionless_wake_window_timeout_process", "=a"
    )
    if (name == 9) return xtensaAssemblyReadU32(
        "movi $0, pm_beacon_monitor_timeout_process", "=a"
    )
    if (name == 10) return xtensaAssemblyReadU32(
        "movi $0, pm_beacon_monitor_tbtt_timeout_process", "=a"
    )
    if (name == 11) return xtensaAssemblyReadU32(
        "movi $0, pm_max_idle_timeout_process", "=a"
    )
    if (name == 13) return xtensaAssemblyReadU32(
        "movi $0, pm_coex_restart_timeout_process", "=a"
    )
    u32(0)
}

trusted fun esp32PacketTimerRelease(timerAddress: u32): void {
    val osiCell = xtensaAssemblyReadU32("movi $0, g_osi_funcs_p", "=a")
    val osi = esp32PacketTimerLoadU32(osiCell)
    if (osi != u32(0)) {
        val release = esp32PacketTimerLoadU32(osi + u32(176))
        if (release != u32(0)) callNativeVoidPointer(
            int(release), nativePointerFromAddress(int(timerAddress))
        )
    }
    return
}

trusted fun esp32PacketTimerResample(argument: u32): void {
    val providerCell = xtensaAssemblyReadU32(
        "movi $0, ptr_beacon_offset_funcs", "=a"
    )
    val provider = esp32PacketTimerLoadU32(providerCell)
    if (provider != u32(0)) {
        val callback = esp32PacketTimerLoadU32(provider + u32(24))
        if (callback != u32(0)) callNativeVoidI32(
            int(callback), int(argument)
        )
    }
    return
}

trusted fun esp32PacketTimerDispatch(timerAddress: u32): bool {
    if (timerAddress == u32(0)) return false

    val kind = esp32PacketTimerLoadU8(timerAddress)
    if (kind < 0 || kind > 13) {
        esp32PacketTimerRelease(timerAddress)
        return false
    }

    val argument = esp32PacketTimerLoadU32(timerAddress + u32(4))
    if (kind == 12) {
        esp32PacketTimerResample(argument)
    } else {
        val handler = esp32PacketTimerSymbol(kind)
        if (handler != u32(0)) callNativeVoidI32(
            int(handler), int(argument)
        )
    }

    esp32PacketTimerRelease(timerAddress)
    return true
}

@section(".wifislpiram")
trusted fun esp32PacketTimerDoProcess(timerAddress: u32): i32 =
    if (esp32PacketTimerDispatch(timerAddress)) i32(1) else i32(0)

trusted fun esp32PacketTimerRegisterPostCallback(callback: u32): i32 {
    esp32PacketTimerPostCallback = callback
    xtensaAssemblyVoid("memw", "~{memory}")
    return i32(0)
}

trusted fun esp32PacketTimerProcess(kind: u32, argument: u32): i32 {
    val callback = esp32PacketTimerPostCallback
    if (callback == u32(0)) return i32(-1)
    return i32(callNativeI32Pointer3(
        int(callback),
        nativePointerFromAddress(8),
        nativePointerFromAddress(int(kind & u32(255))),
        nativePointerFromAddress(int(argument))
    ))
}
