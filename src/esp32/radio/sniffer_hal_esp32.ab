import "abla/unsafe/mmio"

val esp32SnifferControl = u32(0x3ff730e4)
val esp32SnifferFilter = u32(0x3ff73c40)
val esp32SnifferMode = u32(0x3ff73104)
val esp32SnifferRxControl0 = u32(0x3ff730f8)
val esp32SnifferRxControl1 = u32(0x3ff730fc)
val esp32SnifferStatistics = u32(0x3ff73d7c)

@inline
trusted fun esp32SnifferRegisterUpdate(
    address: u32,
    clearMask: u32,
    setMask: u32
): void {
    val current = u32(mmioLoadU32(int(address)))
    mmioStoreU32(int(address), int((current & ~clearMask) | setMask))
}

trusted fun esp32SnifferEnableHardware(): void {
    esp32SnifferRegisterUpdate(esp32SnifferControl, u32(0), u32(1) << u32(15))
    esp32SnifferRegisterUpdate(esp32SnifferControl, u32(1), u32(0))
    esp32SnifferRegisterUpdate(esp32SnifferControl, u32(2), u32(0))
    esp32SnifferRegisterUpdate(esp32SnifferControl, u32(4), u32(0))
    esp32SnifferRegisterUpdate(esp32SnifferControl, u32(8), u32(0))
    esp32SnifferRegisterUpdate(
        esp32SnifferControl,
        u32(0),
        u32(32) | u32(64) | u32(128)
    )
}

trusted fun esp32SnifferDisableHardware(): void {
    esp32SnifferRegisterUpdate(esp32SnifferControl, u32(1) << u32(15), u32(0))
    esp32SnifferRegisterUpdate(
        esp32SnifferControl,
        u32(32) | u32(64) | u32(128),
        u32(1) | u32(2) | u32(4) | u32(8)
    )
}

trusted fun esp32SnifferSetPromiscuousHardware(
    selector: u32,
    enabledValue: u32,
    mask: u32
): void {
    val enabled = (enabledValue & u32(255)) != u32(0)
    if (selector == u32(0)) {
        esp32SnifferRegisterUpdate(
            esp32SnifferFilter,
            u32(4),
            if (enabled) u32(4) else u32(0)
        )
        return
    }
    if (selector != u32(1)) return

    mmioStoreU32(
        int(esp32SnifferMode),
        int(u32(mmioLoadU32(int(esp32SnifferMode))) & u32(65535))
    )
    if (enabled) {
        esp32SnifferRegisterUpdate(esp32SnifferMode, u32(0), mask)
        esp32SnifferRegisterUpdate(esp32SnifferRxControl0, u32(0), mask)
        esp32SnifferRegisterUpdate(esp32SnifferRxControl1, u32(0), mask)
    } else {
        val defaultMode = u32(5) << u32(24)
        esp32SnifferRegisterUpdate(esp32SnifferRxControl0, mask, defaultMode)
        esp32SnifferRegisterUpdate(esp32SnifferRxControl1, mask, defaultMode)
    }
}

trusted fun esp32SnifferClearStatisticsHardware(): void {
    esp32SnifferRegisterUpdate(
        esp32SnifferStatistics,
        u32(0),
        u32(1) << u32(31)
    )
    esp32SnifferRegisterUpdate(
        esp32SnifferStatistics,
        u32(1) << u32(31),
        u32(0)
    )
}

trusted fun esp32SnifferEnable(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32SnifferEnableHardware()
    a2
}

trusted fun esp32SnifferDisable(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32SnifferDisableHardware()
    a2
}

trusted fun esp32SnifferSetPromiscuous(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32SnifferSetPromiscuousHardware(a2, a3, a4)
    a2
}

trusted fun esp32SnifferClearStatistics(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32SnifferClearStatisticsHardware()
    a2
}
