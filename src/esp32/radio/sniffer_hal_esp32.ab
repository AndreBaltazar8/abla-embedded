import "../../xtensa/assembly.ab"

// Classic ESP32 promiscuous-receive register control. These four functions are
// the complete public ABI of the former HAL member; all operations are direct
// MAC-register updates and require no retained framework state.

@naked
trusted fun esp32SnifferEnable(): void = xtensaAssemblyVoid(
    "entry a1, 32\nmovi a8, 0x3ff730e4\nmovi.n a10, 1\nslli a10, a10, 15\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a10\nmovi.n a10, -2\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nand a9, a9, a10\nmovi.n a10, -3\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nand a9, a9, a10\nmovi.n a10, -5\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nand a9, a9, a10\nmovi.n a10, -9\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nand a9, a9, a10\nmovi.n a10, 32\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a10\nmovi.n a10, 64\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a10\nmovi a10, 128\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a10\nmemw\ns32i.n a9, a8, 0\nmemw\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32SnifferDisable(): void = xtensaAssemblyVoid(
    "entry a1, 32\nmovi a8, 0x3ff730e4\nmovi a10, 0xffff7fff\nmemw\nl32i.n a9, a8, 0\nand a9, a9, a10\nmovi.n a10, 1\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a10\nmovi.n a10, 2\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a10\nmovi.n a10, 4\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a10\nmovi.n a10, 8\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a10\nmovi a10, -33\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nand a9, a9, a10\nmovi a10, -65\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nand a9, a9, a10\nmovi a10, -129\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nand a9, a9, a10\nmemw\ns32i.n a9, a8, 0\nmemw\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32SnifferSetPromiscuous(mode: u32, enabled: u32): void =
    xtensaAssemblyVoid(
        "entry a1, 32\nextui a3, a3, 0, 8\nbeqz a2, .Labla_promis_mode_zero\nbeqi a2, 1, .Labla_promis_mode_one\nj .Labla_promis_done\n.Labla_promis_mode_zero:\nmovi a8, 0x3ff73c40\nmovi.n a4, -5\nmemw\nl32i.n a9, a8, 0\nand a4, a9, a4\nbeqz a3, .Labla_promis_write\nmovi.n a4, 4\nj .Labla_promis_or_write\n.Labla_promis_mode_one:\nmovi a8, 0x3ff73104\nmemw\nl32i.n a9, a8, 0\nextui a9, a9, 0, 16\nmemw\ns32i.n a9, a8, 0\nbeqz a3, .Labla_promis_disable_one\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a4\nmemw\ns32i.n a9, a8, 0\nmovi a9, 0x3ff730f8\nmemw\nl32i.n a8, a9, 0\nor a8, a8, a4\nmemw\ns32i.n a8, a9, 0\nmovi a9, 0x3ff730fc\nmemw\nl32i.n a8, a9, 0\nor a8, a8, a4\nmemw\ns32i.n a8, a9, 0\nmemw\nj .Labla_promis_done\n.Labla_promis_disable_one:\nmovi a9, 0x3ff730f8\nmovi.n a8, -1\nxor a4, a8, a4\nmemw\nl32i.n a10, a9, 0\nand a10, a10, a4\nmovi a8, 0x3ff730fc\nmemw\ns32i.n a10, a9, 0\nmemw\nl32i.n a2, a8, 0\nand a4, a4, a2\nmemw\ns32i.n a4, a8, 0\nmovi.n a4, 5\nslli a4, a4, 24\nmemw\nl32i.n a10, a9, 0\nor a10, a10, a4\nmemw\ns32i.n a10, a9, 0\nmemw\nl32i.n a9, a8, 0\n.Labla_promis_or_write:\nor a4, a9, a4\n.Labla_promis_write:\nmemw\ns32i.n a4, a8, 0\n.Labla_promis_done:\nmemw\nretw.n",
        "~{memory}"
    )

@naked
trusted fun esp32SnifferClearStatistics(): void = xtensaAssemblyVoid(
    "entry a1, 32\nmovi a8, 0x3ff73d7c\nmovi.n a10, -1\nslli a10, a10, 31\nmemw\nl32i.n a9, a8, 0\nor a9, a9, a10\nmemw\ns32i.n a9, a8, 0\nmemw\nl32i.n a9, a8, 0\nmovi a10, 0x7fffffff\nand a9, a9, a10\nmemw\ns32i.n a9, a8, 0\nmemw\nretw.n",
    "~{memory}"
)
