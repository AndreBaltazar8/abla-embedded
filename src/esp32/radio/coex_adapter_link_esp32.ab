import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCoexAdapterOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspCoexCommonMallocInternalWrapper", "esp_coex_common_malloc_internal_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonSpinLockCreateWrapper", "esp_coex_common_spin_lock_create_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonIntDisableWrapper", "esp_coex_common_int_disable_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonIntRestoreWrapper", "esp_coex_common_int_restore_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonTaskYieldFromIsrWrapper", "esp_coex_common_task_yield_from_isr_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonTimerDisarmWrapper", "esp_coex_common_timer_disarm_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonTimerDoneWrapper", "esp_coex_common_timer_done_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonTimerSetfnWrapper", "esp_coex_common_timer_setfn_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonTimerArmUsWrapper", "esp_coex_common_timer_arm_us_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonEnvIsChipWrapper", "esp_coex_common_env_is_chip_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonSemphrCreateWrapper", "esp_coex_common_semphr_create_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonSemphrDeleteWrapper", "esp_coex_common_semphr_delete_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonSemphrTakeWrapper", "esp_coex_common_semphr_take_wrapper")) return false
    if (!internalFunction("esp32RecoveredEspCoexCommonSemphrGiveWrapper", "esp_coex_common_semphr_give_wrapper")) return false
    true
}
