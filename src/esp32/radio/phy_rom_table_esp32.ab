import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"
import "phy_chip_v7_esp32.ab"

// The classic ESP32 ROM exposes a pointer to 106 PHY function slots at this
// fixed ABI cell. Reading the pointer is ordinary data access; no ROM function
// call is required.
val esp32PhyRomFunctionTablePointer = u32(0x3ffae0c0)
val esp32PhyRomFunctionCount = u32(106)

@inline
trusted fun esp32PhyLoadU32(address: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32PhyStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32PhyInstallRomFunction(
    table: u32,
    byteOffset: u32,
    implementation: u32
): void = esp32PhyStoreU32(table + byteOffset, implementation)

// Typed replacement for phy_get_romfunc_addr. The old recovered body was a
// 700-line assembly string containing only MOVI relocations and S32I stores.
// Keeping the addresses and writes as expressions exposes the whole override
// set to LLVM and lets unused implementations be pruned with their callers.
trusted fun esp32PhyInstallRomFunctionOverrides(): void {
    val table = esp32PhyLoadU32(esp32PhyRomFunctionTablePointer)
    esp32PhyStoreU32(esp32Data_g_phyFuns_ac61c356b5, table)

    esp32PhyInstallRomFunction(table, u32(172), u32(nativeFunctionAddress(esp32PhyRamPbusForceMode)))
    esp32PhyInstallRomFunction(table, u32(224), u32(nativeFunctionAddress(esp32RecoveredRamRfpllReset)))
    esp32PhyInstallRomFunction(table, u32(228), u32(nativeFunctionAddress(esp32RecoveredRamRestartCal)))
    esp32PhyInstallRomFunction(table, u32(236), u32(nativeFunctionAddress(esp32RecoveredRamWaitRfpllCalEnd)))
    esp32PhyInstallRomFunction(table, u32(408), u32(nativeFunctionAddress(esp32RecoveredRamPhyGetVdd33)))
    esp32PhyInstallRomFunction(table, u32(360), u32(nativeFunctionAddress(esp32RecoveredRamSetChanCalInterp)))
    esp32PhyInstallRomFunction(table, u32(336), u32(nativeFunctionAddress(esp32RecoveredRamPbusRxDcoCal)))
    esp32PhyInstallRomFunction(table, u32(280), u32(nativeFunctionAddress(esp32RecoveredRamTxdcCalV70)))
    esp32PhyInstallRomFunction(table, u32(100), u32(nativeFunctionAddress(esp32RecoveredRamSpurCoefCfg)))
    esp32PhyInstallRomFunction(table, u32(48), u32(nativeFunctionAddress(esp32RecoveredRamSetPbusMem)))
    esp32PhyInstallRomFunction(table, u32(52), u32(nativeFunctionAddress(esp32RecoveredRamWriteGainMem)))
    esp32PhyInstallRomFunction(table, u32(80), u32(nativeFunctionAddress(esp32RecoveredRamBbBssBw40En)))
    esp32PhyInstallRomFunction(table, u32(92), u32(nativeFunctionAddress(esp32RecoveredRamBbTxHt20Cen)))
    esp32PhyInstallRomFunction(table, u32(112), u32(nativeFunctionAddress(esp32RecoveredRamBbBssCbw40Dig)))
    esp32PhyInstallRomFunction(table, u32(116), u32(nativeFunctionAddress(esp32RecoveredRamCbw2040Cfg)))
    esp32PhyInstallRomFunction(table, u32(4), u32(nativeFunctionAddress(esp32RecoveredRamEnableAgc)))
    esp32PhyInstallRomFunction(table, u32(12), u32(nativeFunctionAddress(esp32RecoveredRamEnableAgc)))
    esp32PhyInstallRomFunction(table, u32(332), u32(nativeFunctionAddress(esp32RecoveredRamDcIqEst)))
    esp32PhyInstallRomFunction(table, u32(420), u32(nativeFunctionAddress(esp32RecoveredRamTxPwctrlBgInit)))
    esp32PhyInstallRomFunction(table, u32(72), u32(nativeFunctionAddress(esp32RecoveredRamStartTxTone)))
    esp32PhyInstallRomFunction(table, u32(304), u32(nativeFunctionAddress(esp32RecoveredRamGetFmSarDout)))
    esp32PhyInstallRomFunction(table, u32(312), u32(nativeFunctionAddress(esp32RecoveredRamTxiqGetMisPwr)))
    esp32PhyInstallRomFunction(table, u32(324), u32(nativeFunctionAddress(esp32RecoveredRamIqEstEnable)))
    esp32PhyInstallRomFunction(table, u32(328), u32(nativeFunctionAddress(esp32RecoveredRamIqEstDisable)))
    esp32PhyInstallRomFunction(table, u32(128), u32(nativeFunctionAddress(esp32RecoveredRamCheckNoiseFloor)))
    esp32PhyInstallRomFunction(table, u32(388), u32(nativeFunctionAddress(esp32RecoveredRamRfcalPwrctrl)))
    esp32PhyInstallRomFunction(table, u32(124), u32(nativeFunctionAddress(esp32RecoveredRamPhyGetNoisefloor)))
    esp32PhyInstallRomFunction(table, u32(284), u32(nativeFunctionAddress(esp32RecoveredRamEnPwdet)))
    esp32PhyInstallRomFunction(table, u32(132), u32(nativeFunctionAddress(esp32RecoveredRamSetNoiseFloor)))
    esp32PhyInstallRomFunction(table, u32(0), u32(nativeFunctionAddress(esp32RecoveredRamDisableAgc)))
    esp32PhyInstallRomFunction(table, u32(8), u32(nativeFunctionAddress(esp32RecoveredRamDisableAgc)))
    esp32PhyInstallRomFunction(table, u32(300), u32(nativeFunctionAddress(esp32RecoveredRamReadSarDout)))
    esp32PhyInstallRomFunction(table, u32(216), u32(nativeFunctionAddress(esp32PhyRamPbusPowerUpTx)))
    esp32PhyInstallRomFunction(table, u32(368), u32(nativeFunctionAddress(esp32RecoveredRamRfcalTxcap)))
    esp32PhyInstallRomFunction(table, u32(268), u32(nativeFunctionAddress(esp32RecoveredRamTxbbgainToIndex)))
    esp32PhyInstallRomFunction(table, u32(272), u32(nativeFunctionAddress(esp32RecoveredRamIndexToTxbbgain)))
    esp32PhyInstallRomFunction(table, u32(148), u32(nativeFunctionAddress(esp32RecoveredRamChipI2cReadReg)))
    esp32PhyInstallRomFunction(table, u32(156), u32(nativeFunctionAddress(esp32RecoveredRamChipI2cWriteReg)))
    esp32PhyInstallRomFunction(table, u32(292), u32(nativeFunctionAddress(esp32RecoveredRamTxcalWorkMode)))
    esp32PhyInstallRomFunction(table, u32(364), u32(nativeFunctionAddress(esp32RecoveredRamSetTxcapReg)))
    esp32PhyInstallRomFunction(table, u32(380), u32(nativeFunctionAddress(esp32RecoveredRamMeasTonePwrDb)))
    esp32PhyInstallRomFunction(table, u32(192), u32(nativeFunctionAddress(esp32RecoveredRamPbusDebugmode)))
    esp32PhyInstallRomFunction(table, u32(184), u32(nativeFunctionAddress(esp32PhyRamPbusForceTest)))
    esp32PhyInstallRomFunction(table, u32(60), u32(nativeFunctionAddress(esp32RecoveredRamSetTxclkEn)))
    esp32PhyInstallRomFunction(table, u32(64), u32(nativeFunctionAddress(esp32RecoveredRamSetRxclkEn)))
    esp32PhyInstallRomFunction(table, u32(240), u32(nativeFunctionAddress(esp32RecoveredRamRfpllSetFreq)))
    esp32PhyInstallRomFunction(table, u32(400), u32(nativeFunctionAddress(esp32RecoveredRamGetRfGainQdb)))

    // All other entries remain the chip's immutable ROM primitives. They are
    // the hardware boundary, not linked code, and retaining their calibrated
    // silicon implementation avoids replacing them with board-sensitive MMIO.
}
