@section(".iram1.text")
trusted fun esp32MacRxSetDescriptorReload(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    var r2 = a2
    var r3 = a3
    var r4 = a4
    var r5 = a5
    var r6 = a6
    var r7 = a7
    var r8 = u32(0)
    var r9 = u32(0)
    var r10 = u32(0)
    var r11 = u32(0)
    var r12 = u32(0)
    var r13 = u32(0)
    var r14 = u32(0)
    var r15 = u32(0)
    var shiftAmount = u32(0)
    r9 = u32(1073164420)
    r10 = u32(1)
    xtensaMemoryBarrier()
    r8 = u32(ablaUnsafeVolatileLoadU32(int(r9)))
    r8 = r8 | r10
    xtensaMemoryBarrier()
    ablaUnsafeVolatileStoreU32(int(r9), int(r8))
    xtensaMemoryBarrier()
    return r2
}

@section(".iram1.text")
trusted fun esp32MacRxEndInformation(
    descriptorAddress: u32,
    endAddress: u32,
    stateAddress: u32,
    timestampAddress: u32,
    lengthAddress: u32,
    signatureAddress: u32
