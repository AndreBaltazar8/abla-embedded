    var incomingStack8 = u32(0)
    var incomingStack9 = u32(0)
    var shiftAmount = u32(0)
    var compareExchangeExpected = u32(0)
    r8 = u32(1073167748)
    xtensaMemoryBarrier()
    r8 = u32(ablaUnsafeVolatileLoadU32(int(r8)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(r2)), int(r8))
    r8 = u32(1073167752)
    xtensaMemoryBarrier()
    r8 = u32(ablaUnsafeVolatileLoadU32(int(r8)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(r3)), int(r8))
    r8 = u32(1073164452)
    xtensaMemoryBarrier()
    r8 = u32(ablaUnsafeVolatileLoadU32(int(r8)))
    r8 = (r8 >>> u32(0)) & u32(255)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(r4)), int(r8))
    r8 = u32(1073165048)
    xtensaMemoryBarrier()
    r8 = u32(ablaUnsafeVolatileLoadU32(int(r8)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(r5)), int(r8))
    r8 = u32(1073165044)
    xtensaMemoryBarrier()
    r8 = u32(ablaUnsafeVolatileLoadU32(int(r8)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(r6)), int(r8))
    r8 = u32(1073165040)
    xtensaMemoryBarrier()
    r8 = u32(ablaUnsafeVolatileLoadU32(int(r8)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(r7)), int(r8))
