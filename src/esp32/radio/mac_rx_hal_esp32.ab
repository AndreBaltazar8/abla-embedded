import "abla/unsafe/memory"
import "abla/unsafe/mmio"
import "../../xtensa/assembly.ab"

// Classic ESP32 MAC receive-completion ABI. These leaves are resident in IRAM
// because the packet engine can use them while cache availability is limited.
// The register addresses and ordering mirror the ESP32 Wi-Fi HAL exactly.

@section(".iram1.text")
trusted fun esp32MacRxEndState(): u32 {
    var r2 = u32(0)
    var r3 = u32(0)
    var r4 = u32(0)
    var r5 = u32(0)
    var r6 = u32(0)
    var r7 = u32(0)
    var r8 = u32(0)
    var r9 = u32(0)
    var r10 = u32(0)
    var r11 = u32(0)
    var r12 = u32(0)
    var r13 = u32(0)
    var r14 = u32(0)
    var r15 = u32(0)
    var incomingStack0 = u32(0)
    var incomingStack1 = u32(0)
    var incomingStack2 = u32(0)
    var incomingStack3 = u32(0)
    var incomingStack4 = u32(0)
    var incomingStack5 = u32(0)
    var incomingStack6 = u32(0)
    var incomingStack7 = u32(0)
    var incomingStack8 = u32(0)
    var incomingStack9 = u32(0)
    var shiftAmount = u32(0)
    var compareExchangeExpected = u32(0)
    r2 = u32(1073164452)
    xtensaMemoryBarrier()
    r2 = u32(ablaUnsafeVolatileLoadU32(int(r2)))
    r2 = (r2 >>> u32(0)) & u32(255)
    return r2
}

