import "../../xtensa/assembly.ab"

// Classic ESP32 MAC receive-completion ABI. These leaves are resident in IRAM
// because the packet engine can use them while cache availability is limited.
// The register addresses and ordering mirror the ESP32 Wi-Fi HAL exactly.

@naked
@section(".iram1.text")
trusted fun esp32MacRxEndState(): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nmovi a2, 0x3ff730a4\nmemw\nl32i a2, a2, 0\nextui a2, a2, 0, 8\nretw.n",
    "~{memory}"
)

@naked
@section(".iram1.text")
trusted fun esp32MacRxLastDescriptor(): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nmovi a2, 0x3ff73090\nmemw\nl32i a2, a2, 0\nretw.n",
    "~{memory}"
)

@naked
@section(".iram1.text")
trusted fun esp32MacRxDescriptorReloading(): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nmovi a2, 0x3ff73084\nmemw\nl32i a2, a2, 0\nextui a2, a2, 0, 1\nretw.n",
    "~{memory}"
)

@naked
@section(".iram1.text")
trusted fun esp32MacRxSetDescriptorReload(): void = xtensaAssemblyVoid(
    "entry a1, 32\nmovi a9, 0x3ff73084\nmovi.n a10, 1\nmemw\nl32i a8, a9, 0\nor a8, a8, a10\nmemw\ns32i a8, a9, 0\nmemw\nretw.n",
    "~{memory}"
)

@naked
@section(".iram1.text")
trusted fun esp32MacRxEndInformation(
    descriptorAddress: u32,
    endAddress: u32,
    stateAddress: u32,
    timestampAddress: u32,
    lengthAddress: u32,
    signatureAddress: u32
): void = xtensaAssemblyVoid(
    "entry a1, 32\nmovi a8, 0x3ff73d84\nmemw\nl32i a8, a8, 0\ns32i a8, a2, 0\nmovi a8, 0x3ff73d88\nmemw\nl32i a8, a8, 0\ns32i a8, a3, 0\nmovi a8, 0x3ff730a4\nmemw\nl32i a8, a8, 0\nextui a8, a8, 0, 8\ns32i a8, a4, 0\nmovi a8, 0x3ff732f8\nmemw\nl32i a8, a8, 0\ns32i a8, a5, 0\nmovi a8, 0x3ff732f4\nmemw\nl32i a8, a8, 0\ns32i a8, a6, 0\nmovi a8, 0x3ff732f0\nmemw\nl32i a8, a8, 0\ns32i a8, a7, 0\nmemw\nretw.n",
    "~{memory}"
)
