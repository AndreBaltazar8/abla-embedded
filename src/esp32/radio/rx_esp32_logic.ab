import "../dma_descriptor_logic.ab"

// Classic ESP32 prepends eight hardware-owned words to each received MPDU.
// The word at 0x18 contains the legacy and HT signal lengths observed by the
// open MAC driver. Both must point inside the completed DMA transfer.
val esp32WifiRxControlHeaderBytes = 32
val esp32WifiRxSignalLengthsOffset = 24
val esp32WifiRxSignalLengthMask = 4095

@inline
fun esp32WifiRxLegacySignalLength(signalLengths: int): int =
    signalLengths & esp32WifiRxSignalLengthMask

@inline
fun esp32WifiRxHtSignalLength(signalLengths: int): int =
    (signalLengths >>> 12) & esp32WifiRxSignalLengthMask

fun esp32WifiRxSignalLengthsValid(
    frameLength: int,
    signalLengths: int
): bool = frameLength >= esp32WifiRxControlHeaderBytes &&
    esp32WifiRxLegacySignalLength(signalLengths) < frameLength &&
    esp32WifiRxHtSignalLength(signalLengths) < frameLength

fun esp32WifiRxDescriptorFlagsValid(flags: int): bool {
    val length = espDmaDescriptorLength(flags)
    !espDmaDescriptorOwnedByDma(flags) &&
        espDmaDescriptorSuccessfulEof(flags) &&
        length >= esp32WifiRxControlHeaderBytes &&
        length <= espDmaDescriptorCapacity(flags)
}

fun esp32WifiRxFrameMetadataValid(
    flags: int,
    bufferAddress: int,
    signalLengths: int
): bool = esp32WifiRxDescriptorFlagsValid(flags) &&
    bufferAddress > 0 && bufferAddress <= 4294967264 &&
    esp32WifiRxSignalLengthsValid(
        espDmaDescriptorLength(flags), signalLengths
    )
