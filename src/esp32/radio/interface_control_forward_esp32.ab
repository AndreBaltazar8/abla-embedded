}

trusted fun esp32InterfaceRegisterTimerPostCallback(
    callback: u32
): i32 = esp32PacketTimerRegisterPostCallback(callback)

trusted fun esp32InterfaceRegisterTransmitCallback(
    callback: u32,
    interfaceIndex: u32,
    kind: u32
): i32 = i32(xtensaAssemblyReadU32WithU32U32U32(
    "mov.n a10, $1\nmov.n a11, $2\nmov.n a12, $3\nmovi a8, ppRegisterTxCallback\ncallx8 a8\nmov.n $0, a10",
    "=&a,a,a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
    callback,
    interfaceIndex & u32(255),
    kind & u32(255)
))

