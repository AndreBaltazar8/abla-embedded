trusted fun esp32InterfaceSetCurrentChannel(channel: u32): void {
    if (channel == u32(0)) return
    xtensaAssemblyCallVoid1(
        "movi a8, wDev_SetCurChannel\ncallx8 a8",
        "{a10},~{a8},~{a9},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
        channel
    )
    return
}

