trusted fun esp32InterfaceRegisterNet80211TransmitCallback(
    callback: u32
): i32 {
    if (callback == u32(0)) return i32(0)
    return i32(xtensaAssemblyReadU32WithU32(
        "mov.n a10, $1\nmovi a8, pp_register_net80211_tx_cb\ncallx8 a8\nmov.n $0, a10",
        "=&a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
        callback
    ))
}

