}

trusted fun esp32InterfaceRegisterTransmitDoneCallback(callback: u32): i32 =
    i32(xtensaAssemblyReadU32WithU32(
        "mov.n a10, $1\nmovi a8, ppRegisterTxDoneUserActionCallback\ncallx8 a8\nmov.n $0, a10",
        "=&a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
        callback
    ))

trusted fun esp32InterfaceRegisterPromiscuousReceiveCallback(
    callback: u32
): i32 = if (xtensaAssemblyReadU32WithU32(
    "mov.n a10, $1\nmovi a8, ppRegisterPromisRxCallback\ncallx8 a8\nmov.n $0, a10",
    "=&a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
    callback
) == 0) i32(0) else i32(1)

trusted fun esp32InterfaceRegisterReceiveCallback(
    callback: u32,
    interfaceIndex: u32
): i32 = i32(xtensaAssemblyReadU32WithU32U32(
    "mov.n a10, $1\nmov.n a11, $2\nmovi a8, ppRegisterRxCallback\ncallx8 a8\nmov.n $0, a10",
    "=&a,a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
    callback,
    interfaceIndex & u32(255)
))

trusted fun esp32InterfaceRegisterTimerCallback(callback: u32): i32 {
    if (callback == u32(0)) return i32(0)
    return i32(xtensaAssemblyReadU32WithU32(
        "mov.n a10, $1\nmovi a8, pp_register_timer_cb\ncallx8 a8\nmov.n $0, a10",
        "=&a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
        callback
