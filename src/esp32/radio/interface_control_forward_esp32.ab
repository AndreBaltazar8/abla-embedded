import "../../xtensa/assembly.ab"
import "./packet_timer_esp32.ab"

// Zero-storage portion of the classic ESP32 if_hwctrl surface. These entries
// are ABI adapters, not framework APIs: opaque net80211 callers still require
// their exact names. Truly transparent calls use a generic windowed adapter;
// wrappers that narrow arguments, skip null callbacks, or normalize results
// spell out those semantics with typed inline assembly. Behavior-bearing policy
// lives in interface_control_esp32.ab instead of being hidden in this list.

@naked
trusted fun esp32InterfaceFreeReceiveBuffer(): void =
    $xtensa tail1 {ppRecycleRxPkt}

@naked
trusted fun esp32InterfaceBeaconMonitorConfigure(): void =
    $xtensa tail1 {pm_beacon_monitor_configure}

@naked
trusted fun esp32InterfaceCreateWifiTask(): void =
    $xtensa tail0 {pp_create_task}

@naked
trusted fun esp32InterfaceDeleteWifiTask(): void =
    $xtensa tail0 {pp_delete_task}

@naked
trusted fun esp32InterfaceDeleteKey(entryAddress: u32): void =
    xtensaAssemblyVoid(
        "entry a1, 32\nmovi a3, g_osi_funcs_p\nl32i.n a8, a3, 0\nl32i a8, a8, 216\ncallx8 a8\nmov.n a10, a2\nmovi a8, wDev_remove_KeyEntry\ncallx8 a8\nl32i.n a3, a3, 0\nl32i a3, a3, 220\ncallx8 a3\nretw.n",
        "~{memory}"
    )

trusted fun esp32InterfaceDeleteAllKeys(
    interfaceIndex: u32,
    connection: u32
): void {
    xtensaAssemblyCallVoid2(
        "movi a8, wDev_remove_KeyEntry_all_cnx\ncallx8 a8",
        "{a10},{a11},~{a8},~{a9},~{a12},~{a13},~{a14},~{a15},~{memory}",
        interfaceIndex & u32(255),
        connection
    )
    return
}

@naked
trusted fun esp32InterfacePacketBufferAllocate(): void =
    $xtensa tail3 {esf_buf_alloc}

@naked
trusted fun esp32InterfacePacketBufferRecycleReceive(): void =
    $xtensa tail1 {ppRecycleRxPkt}

@naked
trusted fun esp32InterfacePacketBufferRecycleTransmit(): void =
    $xtensa tail1 {esf_buf_recycle}

trusted fun esp32InterfaceGetTransmitRate(interfaceIndex: u32): u32 =
    xtensaAssemblyReadU32WithU32(
        "mov.n a10, $1\nmovi a8, trc_get_80211_tx_rate\ncallx8 a8\nmov.n $0, a10",
        "=&a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
        interfaceIndex & u32(255)
    )

trusted fun esp32InterfaceGetTransmitRateConfiguration(
    interfaceIndex: u32,
    configuration: u32
): void {
    xtensaAssemblyCallVoid2(
        "movi a8, trc_get_80211_tx_rate_config\ncallx8 a8",
        "{a10},{a11},~{a8},~{a9},~{a12},~{a13},~{a14},~{a15},~{memory}",
        interfaceIndex & u32(255),
        configuration
    )
    return
}

