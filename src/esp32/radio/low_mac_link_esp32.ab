import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLowMacOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredGetAccess", "GetAccess")) return false
    if (!internalFunction("esp32RecoveredDbgCntLmacDrop", "dbg_cnt_lmac_drop")) return false
    if (!internalFunction("esp32RecoveredDbgLmacGetAcs", "dbg_lmac_get_acs")) return false
    if (!internalFunction("esp32RecoveredEspWifiInternalGetMib", "esp_wifi_internal_get_mib")) return false
    if (!internalFunction("esp32RecoveredEspWifiInternalGetRts", "esp_wifi_internal_get_rts")) return false
    if (!internalFunction("esp32RecoveredEspWifiInternalSetMsduLifetime", "esp_wifi_internal_set_msdu_lifetime")) return false
    if (!internalFunction("esp32RecoveredEspWifiInternalSetRetryCounter", "esp_wifi_internal_set_retry_counter")) return false
    if (!internalFunction("esp32RecoveredEspWifiInternalSetRts", "esp_wifi_internal_set_rts")) return false
    if (!internalFunction("esp32RecoveredEspWifiSet11bTxPlcp", "esp_wifi_set_11b_tx_plcp")) return false
    if (!internalFunction("esp32RecoveredIsLmacIdle", "is_lmac_idle")) return false
    if (!internalFunction("esp32RecoveredLmacAdjustTimestamp", "lmacAdjustTimestamp")) return false
    if (!internalFunction("esp32RecoveredLmacDisableTransmit", "lmacDisableTransmit")) return false
    if (!internalFunction("esp32RecoveredLmacDiscardAgedMSDU", "lmacDiscardAgedMSDU")) return false
    if (!internalFunction("esp32RecoveredLmacDiscardFrameExchangeSequence", "lmacDiscardFrameExchangeSequence")) return false
    if (!internalFunction("esp32RecoveredLmacDiscardMSDU", "lmacDiscardMSDU")) return false
    if (!internalFunction("esp32RecoveredLmacEndFrameExchangeSequence", "lmacEndFrameExchangeSequence")) return false
    if (!internalFunction("esp32RecoveredLmacEndRetryAMPDUFail", "lmacEndRetryAMPDUFail")) return false
    if (!internalFunction("esp32RecoveredLmacGetTxFrame", "lmacGetTxFrame")) return false
    if (!internalFunction("esp32RecoveredLmacInit", "lmacInit")) return false
    if (!internalFunction("esp32RecoveredLmacInitAc", "lmacInitAc")) return false
    if (!internalFunction("esp32RecoveredLmacIsIdle", "lmacIsIdle")) return false
    if (!internalFunction("esp32RecoveredLmacIsLongFrame", "lmacIsLongFrame")) return false
    if (!internalFunction("esp32RecoveredLmacMSDUAged", "lmacMSDUAged")) return false
    if (!internalFunction("esp32RecoveredLmacPostTxComplete", "lmacPostTxComplete")) return false
    if (!internalFunction("esp32RecoveredLmacProcessAckTimeout", "lmacProcessAckTimeout")) return false
    if (!internalFunction("esp32RecoveredLmacProcessAllTxTimeout", "lmacProcessAllTxTimeout")) return false
    if (!internalFunction("esp32RecoveredLmacProcessCollision", "lmacProcessCollision")) return false
    if (!internalFunction("esp32RecoveredLmacProcessCollisions", "lmacProcessCollisions")) return false
    if (!internalFunction("esp32RecoveredLmacProcessCollisionsTask", "lmacProcessCollisions_task")) return false
    if (!internalFunction("esp32RecoveredLmacProcessCtsTimeout", "lmacProcessCtsTimeout")) return false
    if (!internalFunction("esp32RecoveredLmacProcessLongFrameSuccess", "lmacProcessLongFrameSuccess")) return false
    if (!internalFunction("esp32RecoveredLmacProcessLongRetryFail", "lmacProcessLongRetryFail")) return false
    if (!internalFunction("esp32RecoveredLmacProcessRxSucData", "lmacProcessRxSucData")) return false
    if (!internalFunction("esp32RecoveredLmacProcessShortFrameSuccess", "lmacProcessShortFrameSuccess")) return false
    if (!internalFunction("esp32RecoveredLmacProcessShortRetryFail", "lmacProcessShortRetryFail")) return false
    if (!internalFunction("esp32RecoveredLmacProcessTBSuccess", "lmacProcessTBSuccess")) return false
    if (!internalFunction("esp32RecoveredLmacProcessTxComplete", "lmacProcessTxComplete")) return false
    if (!internalFunction("esp32RecoveredLmacProcessTxError", "lmacProcessTxError")) return false
    if (!internalFunction("esp32RecoveredLmacProcessTxRtsError", "lmacProcessTxRtsError")) return false
    if (!internalFunction("esp32RecoveredLmacProcessTxSuccess", "lmacProcessTxSuccess")) return false
    if (!internalFunction("esp32RecoveredLmacProcessTxTimeout", "lmacProcessTxTimeout")) return false
    if (!internalFunction("esp32RecoveredLmacProcessTxopSuccess", "lmacProcessTxopSuccess")) return false
    if (!internalFunction("esp32RecoveredLmacProcessTxseckiderr", "lmacProcessTxseckiderr")) return false
    if (!internalFunction("esp32RecoveredLmacReachLongLimit", "lmacReachLongLimit")) return false
    if (!internalFunction("esp32RecoveredLmacReachShortLimit", "lmacReachShortLimit")) return false
    if (!internalFunction("esp32RecoveredLmacRecycleMPDU", "lmacRecycleMPDU")) return false
    if (!internalFunction("esp32RecoveredLmacRetryTxFrame", "lmacRetryTxFrame")) return false
    if (!internalFunction("esp32RecoveredLmacRxDone", "lmacRxDone")) return false
    if (!internalFunction("esp32RecoveredLmacSetAcParam", "lmacSetAcParam")) return false
    if (!internalFunction("esp32RecoveredLmacSetTxFrame", "lmacSetTxFrame")) return false
    if (!internalFunction("esp32RecoveredLmacStopTransmit", "lmacStopTransmit")) return false
    if (!internalFunction("esp32RecoveredLmacTxDone", "lmacTxDone")) return false
    if (!internalFunction("esp32RecoveredLmacTxFrame", "lmacTxFrame")) return false
    if (!internalFunction("esp32RecoveredLmacRecordTxtime", "lmac_record_txtime")) return false
    if (!internalFunction("esp32RecoveredLmacStopHwTxq", "lmac_stop_hw_txq")) return false
    if (!internalFunction("esp32RecoveredLmacUpdateTxStatistic", "lmac_update_tx_statistic")) return false
    true
}
