import "../../xtensa/assembly.ab"

// Classic ESP32 Bluetooth/Wi-Fi coexistence priority setup. ESP-IDF's PHY
// initializer calls this ABI entry while caches may be unavailable, so the
// boundary itself is resident in IRAM. Everything behind that one required
// symbol remains ordinary Abla code and can still be discarded independently.
//
// The read/modify/write sequence mirrors the ESP32 ROM-library implementation:
// DPORT-safe reads are followed by the original peripheral writes and barriers.

@naked
@section(".iram1.text")
trusted fun esp32BluetoothCoexistenceHighPriority(): void = xtensaAssemblyVoid(
    "entry a1, 32\nmovi a3, 0x3ff5c080\nmovi a2, -193\nmov.n a10, a3\ncall8 esp_dport_access_reg_read\nand a2, a10, a2\nmovi a5, 0x600310d0\nmov.n a10, a5\nmemw\ns32i.n a2, a3, 0\ncall8 esp_dport_access_reg_read\nmovi a2, -241\nand a3, a10, a2\nmovi a4, 0x60031300\nmov.n a10, a4\nmemw\ns32i.n a3, a5, 0\ncall8 esp_dport_access_reg_read\nand a3, a10, a2\nmovi a2, 0x60033d30\nmov.n a10, a2\nmemw\ns32i.n a3, a4, 0\ncall8 esp_dport_access_reg_read\nmovi.n a3, 1\nor a6, a10, a3\nmov.n a10, a2\nmemw\ns32i.n a6, a2, 0\ncall8 esp_dport_access_reg_read\nmovi a6, 0xf0ffffff\nand a8, a10, a6\nmov.n a10, a2\nmovi a6, 0x01000000\nor a6, a8, a6\nmemw\ns32i.n a6, a2, 0\ncall8 esp_dport_access_reg_read\nmovi a8, 0xff0fffff\nand a10, a10, a8\nmovi a6, 0x00400000\nor a8, a10, a6\nmovi a6, 0x60033d38\nmov.n a10, a6\nmemw\ns32i.n a8, a2, 0\ncall8 esp_dport_access_reg_read\nextui a8, a10, 0, 16\nmov.n a10, a6\nmovi a2, 0x0c800000\nor a2, a8, a2\nmemw\ns32i.n a2, a6, 0\ncall8 esp_dport_access_reg_read\nmovi.n a2, 10\nmovi a8, 0xffff0000\nand a10, a10, a8\nor a8, a10, a2\nmovi a2, 0x60033d40\nmov.n a10, a2\nmemw\ns32i.n a8, a6, 0\ncall8 esp_dport_access_reg_read\nmovi a8, -57\nand a10, a10, a8\nmovi.n a8, 16\nmovi a6, 0x600041c4\nor a8, a10, a8\nmov.n a10, a6\nmemw\ns32i.n a8, a2, 0\ncall8 esp_dport_access_reg_read\nmovi.n a2, 64\nor a2, a10, a2\nmov.n a10, a5\nmemw\ns32i.n a2, a6, 0\ncall8 esp_dport_access_reg_read\nor a2, a10, a3\nmov.n a10, a4\nmemw\ns32i.n a2, a5, 0\ncall8 esp_dport_access_reg_read\nor a3, a10, a3\nmovi a5, 0x3ff5d040\nmov.n a10, a5\nmemw\ns32i.n a3, a4, 0\ncall8 esp_dport_access_reg_read\nmovi a2, 0x7fffffff\nand a10, a10, a2\nmemw\ns32i.n a10, a5, 0\nretw.n",
    "~{a2},~{a3},~{a4},~{a5},~{a6},~{a7},~{a8},~{a9},~{a10},~{a11},~{memory}"
)
