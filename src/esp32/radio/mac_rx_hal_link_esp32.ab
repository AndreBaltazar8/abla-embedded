import "abla/build"

// hal_mac_rx.o is fully represented by the five direct MMIO leaves in
// mac_rx_hal_esp32.ab. All callers are now Abla-owned, so no foreign roots are
// needed and unused receive helpers remain prunable.
compile fun esp32Idf6LinkMacRxHalInternals(): bool {
    if (!internalFunction("esp32MacRxEndState", "hal_mac_rx_get_end_state")) return false
    if (!internalFunction("esp32MacRxLastDescriptor", "hal_mac_rx_get_last_dscr")) return false
    if (!internalFunction("esp32MacRxDescriptorReloading", "hal_mac_rx_is_dscr_reload")) return false
    if (!internalFunction("esp32MacRxSetDescriptorReload", "hal_mac_rx_set_dscr_reload")) return false
    if (!internalFunction("esp32MacRxEndInformation", "hal_mac_rx_get_end_info")) return false
    true
}
