import "./crypto_table_logic.ab"
import "abla/unsafe/memory"

// Exact classic-ESP32 libpp hal_crypto.o ABI. The MAC crypto block owns 25
// fixed 40-byte key slots: eight bytes of peer/cipher metadata followed by up
// to 32 key bytes. Direct byte packing removes the original temporary aligned
// heap allocation without changing the register representation.

val esp32HalCryptoInterface0Register = 1073166336
val esp32HalCryptoInterface1Register = 1073166340
val esp32HalCryptoControlRegister = 1073166352
val esp32HalCryptoValidRegister = 1073166356
val esp32HalCryptoUsingKeyRegister = 1073169452

@inline
trusted fun esp32HalCryptoLoadU8(address: int): int =
    ablaUnsafeVolatileLoadU8(address)

@inline
trusted fun esp32HalCryptoLoadU32(address: int): int =
    ablaUnsafeVolatileLoadU32(address)

@inline
trusted fun esp32HalCryptoStoreU8(address: int, value: int): void =
    ablaUnsafeVolatileStoreU8(address, value & 255)

@inline
trusted fun esp32HalCryptoStoreU32(address: int, value: int): void =
    ablaUnsafeVolatileStoreU32(address, u32(value))

@inline
fun esp32HalCryptoInterfaceRegister(interfaceIndex: int): int =
    if ((interfaceIndex & 255) == 1) esp32HalCryptoInterface1Register
    else esp32HalCryptoInterface0Register

@inline
trusted fun esp32HalCryptoReadBytesU32(
    address: int,
    available: int
): int {
    var value = 0
    var index = 0
    while (index < 4 && index < available) {
        value = value | (esp32HalCryptoLoadU8(address + index) << (index * 8))
        index = index + 1
    }
    value
}

@inline
trusted fun esp32HalCryptoWriteBytesU32(
    address: int,
    value: int,
    count: int
): void {
    var index = 0
    while (index < 4 && index < count) {
        esp32HalCryptoStoreU8(address + index, value >>> (index * 8))
        index = index + 1
    }
    return
}

@export("hal_crypto_init")
trusted fun esp32HalCryptoInitialize(): void {
    esp32HalCryptoStoreU32(esp32HalCryptoInterface0Register, 196608)
    esp32HalCryptoStoreU32(esp32HalCryptoInterface1Register, 196608)
    esp32HalCryptoStoreU32(1073166344, 0)
    esp32HalCryptoStoreU32(1073166348, 0)
    esp32HalCryptoStoreU32(esp32HalCryptoControlRegister, 0)
    return
}

trusted fun esp32HalCryptoUsingKeyIndex(): i32 = i32(
    (esp32HalCryptoLoadU32(esp32HalCryptoUsingKeyRegister) >>> 30) & 3
)

@export("hal_crypto_is_key_valid")
trusted fun esp32HalCryptoKeyValid(slot: i32): i32 =
    if ((esp32HalCryptoLoadU32(esp32HalCryptoValidRegister) &
        (1 << int(slot))) == 0) i32(0) else i32(1)

@export("hal_crypto_mgmt_rx_enabled")
trusted fun esp32HalCryptoManagementReceiveEnabled(
    interfaceIndex: u32
): i32 = i32(
    (esp32HalCryptoLoadU32(esp32HalCryptoInterfaceRegister(
        int(interfaceIndex)
    )) >>> 17) & 1
)

@export("hal_crypto_clr_key_entry")
trusted fun esp32HalCryptoClearKeyEntry(slot: i32): void {
    val index = int(slot)
    esp32HalCryptoStoreU32(
        esp32HalCryptoValidRegister,
        esp32HalCryptoLoadU32(esp32HalCryptoValidRegister) & ~(1 << index)
    )
    val address = esp32HalCryptoSlotAddress(index)
    var word = 0
    while (word < 10) {
        esp32HalCryptoStoreU32(address + word * 4, 0)
        word = word + 1
    }
    return
}

@export("hal_crypto_enable")
trusted fun esp32HalCryptoEnable(
    interfaceIndex: u32,
    modeValue: u32,
    managementReceive: u32,
    option: u32
): void {
    val interfaceRegister = esp32HalCryptoInterfaceRegister(
        int(interfaceIndex)
    )
    val mode = int(modeValue) & 255
    var interfaceControl = if ((mode & ~4) == 1) 268501251
        else 65795
    if ((managementReceive & u32(255)) != u32(0)) {
        interfaceControl = interfaceControl | 131072
    }
    if ((option & u32(255)) != u32(0)) {
        interfaceControl = interfaceControl | 512
    }
    esp32HalCryptoStoreU32(interfaceRegister, interfaceControl)
    var control = esp32HalCryptoLoadU32(esp32HalCryptoControlRegister)
    if (mode == 4) {
        control = control | 16776960
        esp32HalCryptoStoreU32(esp32HalCryptoControlRegister, control)
        interfaceControl =
            (esp32HalCryptoLoadU32(interfaceRegister) & 1073741823) |
                2147483648
    } else {
        control = control & 4278190335
        esp32HalCryptoStoreU32(esp32HalCryptoControlRegister, control)
        interfaceControl =
            esp32HalCryptoLoadU32(interfaceRegister) & 1073741823
    }
    esp32HalCryptoStoreU32(interfaceRegister, interfaceControl)
    return
}

@export("hal_crypto_disable")
trusted fun esp32HalCryptoDisable(
    interfaceIndex: u32,
    keyMask: u32
): void {
    val interfaceValue = int(interfaceIndex) & 255
    if (interfaceValue == 0 || interfaceValue == 1) {
        esp32HalCryptoStoreU32(
            esp32HalCryptoInterfaceRegister(interfaceValue), 196608
        )
    }
    esp32HalCryptoStoreU32(
        esp32HalCryptoValidRegister,
        esp32HalCryptoLoadU32(esp32HalCryptoValidRegister) & ~int(keyMask)
    )
    return
}

@export("hal_crypto_set_key_entry")
trusted fun esp32HalCryptoSetKeyEntry(
    slotValue: i32,
    keyAddress: u32,
    keyLengthValue: i32,
    configurationAddress: u32
): void {
    val slot = int(slotValue)
    val keyLength = int(keyLengthValue)
    val configuration = int(configurationAddress)
    if (keyAddress == u32(0) || configurationAddress == u32(0)) return
    val address = esp32HalCryptoSlotAddress(slot)
    val peerLow = esp32HalCryptoReadBytesU32(configuration + 3, 4)
    val peerHigh = esp32HalCryptoLoadU8(configuration + 7) |
        (esp32HalCryptoLoadU8(configuration + 8) << 8)
    val control = esp32HalCryptoEncodeControl(
        slot,
        esp32HalCryptoLoadU8(configuration),
        esp32HalCryptoLoadU8(configuration + 1),
        esp32HalCryptoLoadU8(configuration + 2),
        peerHigh
    )
    esp32HalCryptoStoreU32(address, peerLow)
    esp32HalCryptoStoreU32(address + 4, control)
    val roundedLength = (keyLength + 3) & ~3
    var offset = 0
    while (offset < roundedLength) {
        esp32HalCryptoStoreU32(
            address + 8 + offset,
            esp32HalCryptoReadBytesU32(int(keyAddress) + offset,
                (if ((keyAddress & u32(3)) == u32(0)) roundedLength
                 else keyLength) - offset)
        )
        offset = offset + 4
    }
    esp32HalCryptoStoreU32(
        esp32HalCryptoValidRegister,
        esp32HalCryptoLoadU32(esp32HalCryptoValidRegister) | (1 << slot)
    )
    return
}

@export("hal_crypto_get_key_entry")
trusted fun esp32HalCryptoGetKeyEntry(
    slotValue: i32,
    keyAddress: u32,
    keyLengthValue: i32,
    configurationAddress: u32
): void {
    val slot = int(slotValue)
    val keyLength = int(keyLengthValue)
    if (keyAddress == u32(0) || configurationAddress == u32(0)) return
    val address = esp32HalCryptoSlotAddress(slot)
    val peerLow = esp32HalCryptoLoadU32(address)
    val control = esp32HalCryptoLoadU32(address + 4)
    val configuration = int(configurationAddress)
    esp32HalCryptoStoreU8(
        configuration, esp32HalCryptoControlInterface(control)
    )
    esp32HalCryptoStoreU8(
        configuration + 1, esp32HalCryptoControlCipher(control)
    )
    esp32HalCryptoStoreU8(
        configuration + 2,
        esp32HalCryptoControlKeyIdentifier(control)
    )
    esp32HalCryptoWriteBytesU32(configuration + 3, peerLow, 4)
    esp32HalCryptoStoreU8(configuration + 7, control)
    esp32HalCryptoStoreU8(configuration + 8, control >>> 8)
    val roundedLength = (keyLength + 3) & ~3
    var offset = 0
    while (offset < roundedLength) {
        esp32HalCryptoWriteBytesU32(
            int(keyAddress) + offset,
            esp32HalCryptoLoadU32(address + 8 + offset),
            roundedLength - offset
        )
        offset = offset + 4
    }
    return
}
