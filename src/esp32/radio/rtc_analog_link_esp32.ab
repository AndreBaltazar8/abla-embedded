import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRtcAnalogInternals(): bool {
    if (!internalFunction("esp32RecoveredAdc1AmpRead", "adc1_amp_read")) return false
    if (!internalFunction("esp32RecoveredAdc1AmpReadFull", "adc1_amp_read_full")) return false
    if (!internalFunction("esp32RecoveredAdc1PadInit", "adc1_pad_init")) return false
    if (!internalFunction("esp32RecoveredAdc1Read", "adc1_read")) return false
    if (!internalFunction("esp32RecoveredAdc1ReadTest", "adc1_read_test")) return false
    if (!internalFunction("esp32RecoveredAdc2PadInit", "adc2_pad_init")) return false
    if (!internalFunction("esp32RecoveredAdc2Read", "adc2_read")) return false
    if (!internalFunction("esp32RecoveredAdc2ReadTest", "adc2_read_test")) return false
    if (!internalFunction("esp32RecoveredAdcPadInit", "adc_pad_init")) return false
    if (!internalFunction("esp32RecoveredAdcPadInt", "adc_pad_int")) return false
    if (!internalFunction("esp32RecoveredDacOut", "dac_out")) return false
    if (!internalFunction("esp32RecoveredDacPadInit", "dac_pad_init")) return false
    if (!internalFunction("esp32RecoveredGetVdd33", "get_vdd33")) return false
    if (!internalFunction("esp32RecoveredHallSensAmpRead", "hall_sens_amp_read")) return false
    if (!internalFunction("esp32RecoveredHallSensAmpReadFull", "hall_sens_amp_read_full")) return false
    if (!internalFunction("esp32RecoveredHallSensRead", "hall_sens_read")) return false
    if (!internalFunction("esp32RecoveredHallSensReadFull", "hall_sens_read_full")) return false
    if (!internalFunction("esp32RecoveredVdd33Init", "vdd33_init")) return false
    true
}
