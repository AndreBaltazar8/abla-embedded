// Classic ESP32 Wi-Fi power, clock, reset, and MAC-state register facts.
val esp32DportWifiClockAddress = 1072693452
val esp32DportWifiResetAddress = 1072693456
val esp32RtcWifiPowerAddress = 1072988292
val esp32RtcWifiIsolationAddress = 1072988296
val esp32WifiMacControlAddress = 1073167544

val esp32WifiMacClockMask = 1030
val esp32WifiBtCommonClockMask = 969
val esp32WifiMacResetMask = 4
val esp32WifiPowerOnResetMask = 541
val esp32WifiForcePowerDownMask = 131072
val esp32WifiForceIsolationMask = 268435456
val esp32WifiMacStateMask = 6143

@inline
fun esp32WifiClockEnabled(value: int, mask: int): bool =
    (value & mask) == mask

@inline
fun esp32WifiPowerForced(value: int, mask: int): bool =
    (value & mask) != 0
