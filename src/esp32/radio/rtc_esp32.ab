import "abla/unsafe/mmio"
import "../dport_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
// Complete Abla/LLVM reconstruction of classic ESP32 librtc rtc.o: all 24 RTC clock, pad, wake, RF-power, sleep-preparation, and SDIO routines are internal to the firmware unit.

// These extension points are referenced only by legacy/test-only members of
// Espressif's classic-ESP32 librtc archive.  The shipped archive and ROM leave
// rtc_init_clk and rtc_slp_prep undefined, and both callers ignore the return
// value.  Express the classic default policy internally so those wrappers are
// prunable without introducing foreign linker roots.
trusted fun esp32RtcInitializeClockPolicy(
    mode: u32,
    clockConfig: u32,
    calibrationConfig: u32,
    source: u32,
    divider: u32,
    flags: u32
): u32 = u32(0)

trusted fun esp32RtcSleepPreparePolicy(
    mode: u32,
    rejectMask: u32,
    wakeMask: u32,
    source: u32,
    divider: u32,
    flags: u32
): u32 = u32(0)

