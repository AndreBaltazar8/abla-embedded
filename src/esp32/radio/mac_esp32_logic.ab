// Pure classic-ESP32 Wi-Fi MAC topology and bit packing. These definitions
// are independently expressed from the esp32 0.40.2 PAC and esp-wifi-hal
// 0.3.2 register use. See RADIO.md for provenance and the remaining boundary.
val esp32WifiMacBase = 1073164288
val esp32WifiMacRxControlOffset = 132
val esp32WifiMacRxDescriptorBaseOffset = 136
val esp32WifiMacRxDescriptorNextOffset = 140
val esp32WifiMacRxDescriptorLastOffset = 144
val esp32WifiMacInterruptStatusOffset = 3144
val esp32WifiMacInterruptClearOffset = 3148
val esp32WifiMacTxErrorClearOffset = 3260
val esp32WifiMacTxErrorStatusOffset = 3264
val esp32WifiMacTxCompleteClearOffset = 3268
val esp32WifiMacTxCompleteStatusOffset = 3272
val esp32WifiMacTxSlotBaseOffset = 3324
val esp32WifiMacTxParameterBaseOffset = 4456
val esp32WifiMacTimeOffset = 3072

val esp32WifiMacRxReloadMask = 1
val esp32WifiMacRxEnableMask = 2147483648
val esp32WifiMacInterruptRxMask = 1048612
val esp32WifiMacInterruptTxSuccessMask = 128
val esp32WifiMacInterruptTxCollisionMask = 256
val esp32WifiMacInterruptTxTimeoutMask = 524288

type WifiMacRxFilter = int
type WifiMacTxQueue = int

fun wifiMacBssidFilter(): WifiMacRxFilter = WifiMacRxFilter(0)
fun wifiMacReceiverFilter(): WifiMacRxFilter = WifiMacRxFilter(1)

fun wifiMacBeaconQueue(): WifiMacTxQueue = WifiMacTxQueue(0)
fun wifiMacBackgroundQueue(): WifiMacTxQueue = WifiMacTxQueue(1)
fun wifiMacBestEffortQueue(): WifiMacTxQueue = WifiMacTxQueue(2)
fun wifiMacVideoQueue(): WifiMacTxQueue = WifiMacTxQueue(3)
fun wifiMacVoiceQueue(): WifiMacTxQueue = WifiMacTxQueue(4)

@inline
fun WifiMacRxFilter.valid(): bool = this >= 0 && this < 2

@inline
fun WifiMacTxQueue.valid(): bool = this >= 0 && this < 5

@inline
fun WifiMacTxQueue.hardwareSlot(): int = this

@inline
fun WifiMacTxQueue.statusBit(): int =
    if (this.valid()) 1 << (4 - this.hardwareSlot()) else 0

@inline
fun esp32WifiMacRegisterAddress(offset: int): int =
    esp32WifiMacBase + offset

@inline
fun esp32WifiMacFilterAddress(
    filter: WifiMacRxFilter,
    interfaceIndex: int,
    fieldOffset: int
): int {
    if (!filter.valid() || interfaceIndex < 0 || interfaceIndex >= 4) return -1
    esp32WifiMacBase + filter * 64 + interfaceIndex * 8 + fieldOffset
}

@inline
fun esp32WifiMacFilterControlAddress(interfaceIndex: int): int =
    if (interfaceIndex < 0 || interfaceIndex >= 4) -1
    else esp32WifiMacBase + 216 + interfaceIndex * 4

@inline
fun esp32WifiMacControlFrameFilterAddress(interfaceIndex: int): int =
    if (interfaceIndex < 0 || interfaceIndex >= 4) -1
    else esp32WifiMacBase + 248 + interfaceIndex * 4

@inline
fun esp32WifiMacTxConfigAddress(queue: WifiMacTxQueue): int =
    if (!queue.valid()) -1
    else esp32WifiMacBase + esp32WifiMacTxSlotBaseOffset +
        queue.hardwareSlot() * 8

@inline
fun esp32WifiMacTxPlcp0Address(queue: WifiMacTxQueue): int =
    if (!queue.valid()) -1 else esp32WifiMacTxConfigAddress(queue) + 4

@inline
fun esp32WifiMacTxParameterAddress(
    queue: WifiMacTxQueue,
    fieldOffset: int
): int =
    if (!queue.valid()) -1
    else esp32WifiMacBase + esp32WifiMacTxParameterBaseOffset +
        queue.hardwareSlot() * 60 + fieldOffset

fun esp32WifiMacPackChannelAccess(
    timeout: int,
    backoffSlots: int,
    aifsn: int
): int =
    (timeout & 4095) | ((backoffSlots & 1023) << 12) |
        ((aifsn & 15) << 24)

fun esp32WifiMacPackPlcp0(
    descriptor: int,
    waitForAck: bool,
    enableRts: bool
): int =
    (descriptor & 1048575) |
        (if (waitForAck) 16777216 else 0) |
        (if (enableRts) 134217728 else 0)

fun esp32WifiMacPackPlcp1(
    frameLength: int,
    rate: int,
    keySlot: int,
    highThroughput: bool,
    bandwidth40Mhz: bool,
    interfaceIndex: int
): int =
    (frameLength & 4095) | ((rate & 31) << 12) |
        ((keySlot & 31) << 17) |
        (if (highThroughput) 33554432 else 0) |
        (if (bandwidth40Mhz) 268435456 else 0) |
        ((interfaceIndex & 3) << 30)

fun esp32WifiMacPackDuration(duration: int): int =
    (duration & 65535) | ((duration & 65535) << 16)

fun esp32WifiMacPackHtSignal(
    modulationCoding: int,
    shortGuardInterval: bool,
    frameLength: int
): int =
    (modulationCoding & 7) | ((frameLength & 65535) << 8) |
        (7 << 24) | (if (shortGuardInterval) 2147483648 else 0)

fun esp32WifiMacPackHtLength(frameLength: int): int =
    (frameLength & 1048575) | 327680
