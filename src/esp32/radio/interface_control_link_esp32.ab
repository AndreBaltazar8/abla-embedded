import "abla/build"

// Enable only while opaque users of the Abla interface-control replacement remain.
compile fun esp32Idf6LinkInterfaceControlOpaqueCallers(): bool {
    if (!exportFunction("esp32InterfaceControlGetAddress", "ic_get_addr")) return false
    if (!exportFunction("esp32InterfaceControlGetPairwiseAlgorithm", "ic_get_ptk_alg")) return false
    if (!exportFunction("esp32InterfaceControlDeleteAlgorithms", "ic_del_ptk_and_gtk_alg")) return false
    if (!exportFunction("esp32InterfaceControlIsEnabled", "ic_interface_enabled")) return false
    if (!internalFunction("esp32InterfaceEnableReceive", "ic_enable_rx")) return false
    if (!internalFunction("esp32InterfaceDisableReceive", "ic_disable_rx")) return false
    if (!exportFunction("esp32InterfaceDisableCrypto", "ic_disable_crypto")) return false
    if (!exportFunction("esp32InterfaceBeaconOffsetConfigure", "ic_beacon_offset_configure")) return false
    if (!exportFunction("esp32InterfaceBeaconOffsetSetReceiveStandard", "ic_beacon_offset_set_rx_beacon_standard")) return false
    if (!exportFunction("esp32InterfaceTransmitPacket", "ic_tx_pkt")) return false
    if (!exportFunction("esp32InterfaceSetReceivePolicy", "ic_set_rx_policy")) return false
    if (!exportFunction("esp32InterfaceSetReceiveQueuePolicy", "ic_set_rx_policy_ubssid_check")) return false
    if (!exportFunction("esp32InterfaceAmpduOperation", "ic_ampdu_op")) return false
    if (!exportFunction("esp32InterfaceUpdateTraceParameters", "ic_update_trc_params")) return false
    if (!exportFunction("esp32InterfaceMacInitialize", "ic_mac_init")) return false
    if (!exportFunction("esp32InterfaceMacDeinitialize", "ic_mac_deinit")) return false
    if (!internalFunction("esp32InterfaceUpdateListenInterval", "ic_update_listen_interval")) return false
    if (!exportFunction("esp32InterfaceGetKey", "ic_get_key")) return false
    if (!exportFunction("esp32InterfaceObtainKey", "ic_obtain_key")) return false
    if (!exportFunction("esp32InterfaceSetKey", "ic_set_key")) return false
    if (!exportFunction("esp32InterfaceSetTrace", "ic_set_trc")) return false
    if (!exportFunction("esp32InterfaceSetVirtualInterface", "ic_set_vif")) return false
    if (!internalFunction("esp32InterfaceConfigureCsi", "ic_csi_set_config")) return false
    if (!internalFunction("esp32InterfaceDeinitialize", "ic_deinit")) return false
    if (!internalFunction("esp32InterfaceInitialize", "ic_init")) return false
    if (!internalFunction("esp32InterfaceSetInterruptHandler", "ic_set_interrupt_handler")) return false
    if (!internalFunction("esp32InterfaceClearInterruptHandler", "ic_clear_interrupt_handler")) return false
    if (!internalFunction("esp32InterfaceStopSoftwareTransmitQueue", "ic_stop_sw_txq")) return false
    if (!exportFunction("esp32InterfaceDeleteReceiveBlockAck", "ic_del_rx_ba")) return false
    if (!exportFunction("esp32InterfaceResetReceiveBlockAck", "ic_reset_rx_ba")) return false
    if (!exportFunction("esp32InterfaceAddReceiveBlockAck", "ic_add_rx_ba")) return false
    if (!exportFunction("esp32InterfaceFreeReceiveBuffer", "esp_wifi_internal_free_rx_buffer")) return false
    if (!exportFunction("esp32InterfaceBeaconMonitorConfigure", "ic_beacon_monitor_configure")) return false
    if (!exportFunction("esp32InterfaceCreateWifiTask", "ic_create_wifi_task")) return false
    if (!exportFunction("esp32InterfaceDeleteWifiTask", "ic_delete_wifi_task")) return false
    if (!exportFunction("esp32InterfaceDeleteKey", "ic_del_key")) return false
    if (!exportFunction("esp32InterfaceDeleteAllKeys", "ic_del_key_all")) return false
    if (!exportFunction("esp32InterfacePacketBufferAllocate", "ic_ebuf_alloc")) return false
    if (!exportFunction("esp32InterfacePacketBufferRecycleReceive", "ic_ebuf_recycle_rx")) return false
    if (!exportFunction("esp32InterfacePacketBufferRecycleTransmit", "ic_ebuf_recycle_tx")) return false
    if (!exportFunction("esp32InterfaceGetTransmitRate", "ic_get_80211_tx_rate")) return false
    if (!exportFunction("esp32InterfaceGetSixMegabitSchedule", "ic_get_G6M_sched")) return false
    if (!exportFunction("esp32InterfaceGetDefaultSchedule", "ic_get_default_sched")) return false
    if (!exportFunction("esp32InterfaceGetEspNowRate", "ic_get_espnow_rate")) return false
    if (!exportFunction("esp32InterfaceGetFixedRate", "ic_get_fix_rate")) return false
    if (!exportFunction("esp32InterfaceGetKeepAliveTime", "ic_get_keep_alive_time")) return false
    if (!exportFunction("esp32InterfaceGetNextBeaconOffset", "ic_get_next_bcnoffset")) return false
    if (!exportFunction("esp32InterfaceGetNextTbtt", "ic_get_next_tbtt")) return false
    if (!internalFunction("esp32InterfaceGetPacketTaskHandle", "ic_get_pp_hdl")) return false
    if (!exportFunction("esp32InterfaceGetPromiscuousControlFilter", "ic_get_promis_ctrl_filter")) return false
    if (!exportFunction("esp32InterfaceGetPromiscuousFilter", "ic_get_promis_filter")) return false
    if (!exportFunction("esp32InterfaceGetRandom", "ic_get_random")) return false
    if (!exportFunction("esp32InterfaceGetRateControl", "ic_get_trc")) return false
    if (!exportFunction("esp32InterfaceManagementHardwareDecryptEnabled", "ic_is_mgmt_hwdecr_enabled")) return false
    if (!internalFunction("esp32InterfaceRegisterConfigurationCallback", "ic_register_config_cb")) return false
    if (!exportFunction("esp32InterfaceRegisterCsiReceiveCallback", "ic_register_csi_rx_cb")) return false
    if (!exportFunction("esp32InterfaceRegisterNanCallbacks", "ic_register_nan_callbacks")) return false
    if (!exportFunction("esp32InterfaceRegisterNet80211TransmitCallback", "ic_register_net80211_tx_cb")) return false
    if (!internalFunction("esp32InterfaceRegisterPowerNullTransmitCallback", "ic_register_pm_tx_null_cb")) return false
    if (!exportFunction("esp32InterfaceRegisterTransmitDoneCallback", "ic_register_pp_tx_done_cb")) return false
    if (!exportFunction("esp32InterfaceRegisterPromiscuousReceiveCallback", "ic_register_promis_rx_cb")) return false
    if (!internalFunction("esp32InterfaceRegisterTimerCallback", "ic_register_timer_cb")) return false
    if (!internalFunction("esp32InterfaceRegisterTimerPostCallback", "ic_register_timer_post_cb")) return false
    if (!exportFunction("esp32InterfaceRegisterTransmitCallback", "ic_register_tx_cb")) return false
    if (!exportFunction("esp32InterfaceResetTbtt", "ic_reset_tbtt")) return false
    if (!exportFunction("esp32InterfaceSetTransmitRate", "ic_set_80211_tx_rate")) return false
    if (!exportFunction("esp32InterfaceSetTransmitRateConfiguration", "ic_set_80211_tx_rate_config")) return false
    if (!exportFunction("esp32InterfaceSetBlockAckRequestRate", "ic_set_bar_rate")) return false
    if (!exportFunction("esp32InterfaceSetBeaconInterval", "ic_set_beacon_int")) return false
    if (!exportFunction("esp32InterfaceSetBssid", "ic_set_bssid")) return false
    if (!internalFunction("esp32InterfaceSetCsi", "ic_set_csi")) return false
    if (!exportFunction("esp32InterfaceSetCurrentChannel", "ic_set_current_channel")) return false
    if (!internalFunction("esp32InterfaceSetFixedRate", "ic_set_fix_rate")) return false
    if (!exportFunction("esp32InterfaceSetKeepAliveTime", "ic_set_keep_alive_time")) return false
    if (!exportFunction("esp32InterfaceSetMacAddress", "ic_set_mac")) return false
    if (!internalFunction("esp32InterfaceSetPromiscuousControlFilter", "ic_set_promis_ctrl_filter")) return false
    if (!internalFunction("esp32InterfaceSetPromiscuousFilter", "ic_set_promis_filter")) return false
    if (!exportFunction("esp32InterfaceSetMinimumActiveTime", "ic_set_sleep_min_active_time")) return false
    if (!exportFunction("esp32InterfaceSetBroadcastWaitTime", "ic_set_sleep_wait_broadcast_data_time")) return false
    if (!internalFunction("esp32InterfaceStopHardwareTransmitQueue", "ic_stop_hw_txq")) return false
    if (!exportFunction("esp32InterfaceSetPerPacketRate", "ic_trc_set_per_pkt_rate")) return false
    if (!exportFunction("esp32InterfaceUpdateDefaultRate", "ic_trc_update_def_rate")) return false
    if (!internalFunction("esp32InterfaceTransmitQueueEmpty", "ic_txq_empty")) return false
    if (!exportFunction("esp32InterfaceUpdateLightSleepDefaults", "ic_update_light_sleep_default_params")) return false
    if (!exportFunction("esp32InterfaceUpdateModemSleepDefaults", "ic_update_modem_sleep_default_params")) return false
    true
}
