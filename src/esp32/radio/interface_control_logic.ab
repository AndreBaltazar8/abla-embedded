// Portable layout and policy shared by the classic ESP32 interface-control
// implementation. Each of the four hardware interfaces owns one ten-byte
// record; the address itself stays target-owned.

val esp32InterfaceControlRecordSize = 10
val esp32InterfaceControlRecordCount = 4

@inline
fun esp32InterfaceControlOffset(index: u32): int =
    int(index & u32(255)) * esp32InterfaceControlRecordSize

@inline
fun esp32InterfaceControlPureStation(mode: u32, secondary: u32): u32 =
    if ((mode & u32(255)) == u32(1)) u32(0)
    else (secondary ^ u32(1)) & u32(1)

@inline
fun esp32InterfaceControlEnabled(mask: u32, index: u32): u32 =
    (mask >> (index & u32(31))) & u32(1)

@inline
fun esp32InterfaceControlReceivePolicyIndexValid(index: u32): bool =
    (index & u32(255)) < u32(4)
