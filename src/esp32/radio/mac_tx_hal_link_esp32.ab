import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMacTxHalInternals(): bool {
    if (!internalFunction("esp32RecoveredHalAttennaInit", "hal_attenna_init")) return false
    if (!internalFunction("esp32RecoveredHalMacClrTxqState", "hal_mac_clr_txq_state")) return false
    if (!internalFunction("esp32RecoveredHalMacGetTxqPmd", "hal_mac_get_txq_pmd")) return false
    if (!internalFunction("esp32RecoveredHalMacGetTxqState", "hal_mac_get_txq_state")) return false
    if (!internalFunction("esp32RecoveredHalMacRateAutoackInit", "hal_mac_rate_autoack_init")) return false
    if (!internalFunction("esp32RecoveredHalMacTxIsCbw40", "hal_mac_tx_is_cbw40")) return false
    if (!internalFunction("esp32RecoveredMacTxSetHtsig", "mac_tx_set_htsig")) return false
    if (!internalFunction("esp32RecoveredMacTxSetPlcp1", "mac_tx_set_plcp1")) return false
    if (!internalFunction("esp32RecoveredMacTxSetPlcp2", "mac_tx_set_plcp2")) return false
    true
}
