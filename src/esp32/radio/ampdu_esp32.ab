import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"
import "./ampdu_logic.ab"

// Complete classic ESP32 receive A-MPDU block-ack hardware surface. Session
// state is held only in the MAC registers or caller-provided arrays; this
// module owns no permanent table. Exact linker names remain only because
// opaque MAC/HT callers have not yet moved into this LLVM unit.

val esp32AmpduActiveMask = u32(2147483648)

@inline
trusted fun esp32AmpduRead(index: u32, offset: int): u32 {
    return u32(ablaUnsafeVolatileLoadU32(
        esp32AmpduSessionRegisterAddress(index, offset)
    ))
}

@inline
trusted fun esp32AmpduWrite(index: u32, offset: int, value: u32): void {
    ablaUnsafeVolatileStoreU32(
        esp32AmpduSessionRegisterAddress(index, offset), int(value)
    )
    return
}

@inline
trusted fun esp32AmpduLoadU8(address: u32, offset: int): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address) + offset)) & 255
)

@inline
trusted fun esp32AmpduLoadU32(address: u32, index: int): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address) + index * 4))
)

@inline
trusted fun esp32AmpduStoreU32(
    address: u32,
    index: int,
    value: u32
): void {
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(address) + index * 4), int(value)
    )
    return
}

// wifi_log is variadic after its six register arguments. These three internal
// leaves express that ABI without an extern C declaration or an exported
// trampoline; the block-ack register operations themselves remain typed Abla.
// Ordinary typed arguments are passed directly; there is no hidden argument
// count or synthetic incoming stack prefix.
val esp32Data_Labla_ampdu_add_5bfafbe97bStorage = nativeStaticMutableBytes(
    (
        "\x3c\x62\x61\x2d\x61\x64\x64\x3e\x69\x64\x78\x3a\x25\x64\x20\x28\x69\x66\x78\x3a\x25\x64\x2c\x20\x25\x30\x32\x78\x3a\x25\x30\x32" +
        "\x78\x3a\x25\x30\x32\x78\x3a\x25\x30\x32\x78\x3a\x25\x30\x32\x78\x3a\x25\x30\x32\x78\x29\x2c\x20\x74\x69\x64\x3a\x25\x64\x2c\x20" +
        "\x73\x73\x6e\x3a\x25\x64\x2c\x20\x77\x69\x6e\x53\x69\x7a\x65\x3a\x25\x64\x00\x3c\x62\x61\x2d\x63\x6c\x72\x3e\x69\x64\x78\x3a\x25" +
        "\x64\x2c\x20\x74\x69\x64\x3a\x25\x64\x2c\x20\x73\x73\x6e\x3a\x25\x64\x2c\x20\x77\x69\x6e\x53\x69\x7a\x65\x3a\x25\x64\x00\x3c\x62" +
        "\x61\x2d\x64\x65\x6c\x3e\x69\x64\x78\x3a\x25\x64\x2c\x20\x74\x69\x64\x3a\x25\x64\x00"
    )
)
val esp32Data_Labla_ampdu_add_5bfafbe97bInitialized = esp32Data_Labla_ampdu_add_5bfafbe97bStorage
val esp32Data_Labla_ampdu_add_5bfafbe97b = u32(esp32Data_Labla_ampdu_add_5bfafbe97bInitialized)
val esp32Data_Labla_ampdu_clear_85407bca12 = u32(esp32Data_Labla_ampdu_add_5bfafbe97bInitialized + 83)
val esp32Data_Labla_ampdu_delete_2d7345415d = u32(esp32Data_Labla_ampdu_add_5bfafbe97bInitialized + 126)

trusted fun esp32AmpduLogAdd(
    index: u32,
    interfaceIndex: u32,
    macAddress: u32,
    tid: u32,
    sequence: u32,
    window: u32
): void {
    xtensaMemoryBarrier()
    esp32WifiLogValue(
        u32(5), u32(8192), u32(3), esp32Data_Labla_ampdu_add_5bfafbe97b,
        index & u32(255), interfaceIndex & u32(255),
        esp32AmpduLoadU8(macAddress, 0), esp32AmpduLoadU8(macAddress, 1),
        esp32AmpduLoadU8(macAddress, 2), esp32AmpduLoadU8(macAddress, 3),
        esp32AmpduLoadU8(macAddress, 4), esp32AmpduLoadU8(macAddress, 5),
        tid & u32(255), sequence & u32(65535), window & u32(255), u32(0)
    )
    return
}

trusted fun esp32AmpduLogClear(
    index: u32,
    tid: u32,
    sequence: u32,
    window: u32
): void {
    xtensaMemoryBarrier()
    esp32WifiLogValue(
        u32(5), u32(8192), u32(3), esp32Data_Labla_ampdu_clear_85407bca12,
        index & u32(255), tid & u32(255), sequence & u32(65535),
        window & u32(255), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp32AmpduLogDelete(index: u32, tid: u32): void {
    esp32WifiLogValue(
        u32(5), u32(8192), u32(3), esp32Data_Labla_ampdu_delete_2d7345415d,
        index & u32(255), tid & u32(15),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp32AmpduAddReceiveAgreement(
    index: u32,
    interfaceIndex: u32,
    macAddress: u32,
    tid: u32,
    sequence: u32,
    window: u32
): void {
    esp32AmpduLogAdd(
        index, interfaceIndex, macAddress, tid, sequence, window
    )
    esp32AmpduWrite(index, 8, esp32AmpduMacLow(
        esp32AmpduLoadU8(macAddress, 0),
        esp32AmpduLoadU8(macAddress, 1),
        esp32AmpduLoadU8(macAddress, 2),
        esp32AmpduLoadU8(macAddress, 3)
    ))
    esp32AmpduWrite(index, 4, esp32AmpduMacHigh(
        interfaceIndex,
        esp32AmpduLoadU8(macAddress, 4),
        esp32AmpduLoadU8(macAddress, 5)
    ))
    esp32AmpduWrite(index, 12, esp32AmpduWindowControl(sequence, window))
    esp32AmpduWrite(
        index, 0, esp32AmpduRead(index, 0) & ~esp32AmpduActiveMask
    )
    esp32AmpduWrite(index, 16, u32(0))
    esp32AmpduWrite(index, 20, u32(0))
    esp32AmpduWrite(index, 0, esp32AmpduSessionCommand(tid))
    xtensaMemoryBarrier()
    return
}

trusted fun esp32AmpduClearReceiveAgreement(
    index: u32,
    tid: u32,
    sequence: u32,
    window: u32
): void {
    esp32AmpduLogClear(index, tid, sequence, window)
    esp32AmpduWrite(index, 0, u32(0))
    esp32AmpduWrite(index, 12, esp32AmpduWindowControl(sequence, window))
    esp32AmpduWrite(index, 16, u32(0))
    esp32AmpduWrite(index, 20, u32(0))
    esp32AmpduWrite(index, 0, esp32AmpduSessionCommand(tid))
    xtensaMemoryBarrier()
    return
}

trusted fun esp32AmpduDeleteReceiveAgreement(index: u32): void {
    val control = esp32AmpduRead(index, 0)
    esp32AmpduLogDelete(
        index, (control >> u32(12)) & u32(15)
    )
    esp32AmpduWrite(index, 0, esp32AmpduRead(index, 0) & ~esp32AmpduActiveMask)
    esp32AmpduWrite(index, 16, u32(0))
    esp32AmpduWrite(index, 20, u32(0))
    esp32AmpduWrite(index, 0, esp32AmpduRead(index, 0) | esp32AmpduActiveMask)
    esp32AmpduWrite(index, 0, u32(0))
    xtensaMemoryBarrier()
    return
}

trusted fun esp32AmpduStoreSessions(
    sequences: u32,
    receiveAddresses: u32,
    bitmapAddresses: u32
): void {
    var index = 0
    val sessionCount = int(u32(8))
    while (index < sessionCount) {
        val sessionIndex = u32(index)
        if ((esp32AmpduRead(sessionIndex, 0) & esp32AmpduActiveMask) !=
            u32(0)) {
            esp32AmpduStoreU32(
                sequences,
                index,
                esp32AmpduRead(sessionIndex, 12) >> u32(20)
            )
            esp32AmpduStoreU32(
                receiveAddresses, index, esp32AmpduRead(sessionIndex, 24)
            )
            esp32AmpduStoreU32(
                bitmapAddresses, index, esp32AmpduRead(sessionIndex, 28)
            )
        }
        index = index + 1
    }
    xtensaMemoryBarrier()
    return
}

trusted fun esp32AmpduRestoreSessions(
    sequences: u32,
    receiveAddresses: u32,
    bitmapAddresses: u32
): void {
    var index = 0
    val sessionCount = int(u32(8))
    while (index < sessionCount) {
        val sessionIndex = u32(index)
        val control = esp32AmpduRead(sessionIndex, 0)
        if ((control & esp32AmpduActiveMask) != u32(0)) {
            esp32AmpduWrite(
                sessionIndex, 0, esp32AmpduRead(sessionIndex, 0) & ~esp32AmpduActiveMask
            )
            esp32AmpduWrite(
                sessionIndex,
                12,
                (esp32AmpduRead(sessionIndex, 12) & u32(4294963200)) |
                    (esp32AmpduLoadU32(sequences, index) & u32(4095))
            )
            esp32AmpduWrite(
                sessionIndex, 16, esp32AmpduLoadU32(receiveAddresses, index)
            )
            esp32AmpduWrite(
                sessionIndex, 20, esp32AmpduLoadU32(bitmapAddresses, index)
            )
            esp32AmpduWrite(
                sessionIndex,
                0,
                esp32AmpduRead(sessionIndex, 0) | esp32AmpduActiveMask
            )
        }
        index = index + 1
    }
    xtensaMemoryBarrier()
    return
}

trusted fun esp32AmpduRestoreSession(
    index: u32,
    sequences: u32,
    receiveAddresses: u32,
    bitmapAddresses: u32
): void {
    val sessionIndex = index & u32(255)
    val control = esp32AmpduRead(sessionIndex, 0)
    if ((control & esp32AmpduActiveMask) == u32(0)) {
        xtensaMemoryBarrier()
        return
    }
    val arrayIndex = int(sessionIndex)
    esp32AmpduWrite(sessionIndex, 0, esp32AmpduRead(sessionIndex, 0) & ~esp32AmpduActiveMask)
    esp32AmpduWrite(
        sessionIndex, 16, esp32AmpduLoadU32(receiveAddresses, arrayIndex)
    )
    esp32AmpduWrite(
        sessionIndex, 20, esp32AmpduLoadU32(bitmapAddresses, arrayIndex)
    )
    esp32AmpduWrite(
        sessionIndex,
        12,
        (esp32AmpduRead(sessionIndex, 12) & u32(4294963200)) |
            (esp32AmpduLoadU32(sequences, arrayIndex) & u32(4095))
    )
    esp32AmpduWrite(
        sessionIndex,
        0,
        esp32AmpduRead(sessionIndex, 0) | esp32AmpduActiveMask
    )
    xtensaMemoryBarrier()
    return
}
