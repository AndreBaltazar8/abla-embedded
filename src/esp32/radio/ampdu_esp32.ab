import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"
import "./ampdu_logic.ab"

// Complete classic ESP32 receive A-MPDU block-ack hardware surface. Session
// state is held only in the MAC registers or caller-provided arrays; this
// module owns no permanent table. Exact linker names remain only because
// opaque MAC/HT callers have not yet moved into this LLVM unit.

val esp32AmpduActiveMask = u32(2147483648)

@inline
trusted fun esp32AmpduRead(index: u32, offset: int): u32 {
    return u32(ablaUnsafeVolatileLoadU32(
        esp32AmpduSessionRegisterAddress(index, offset)
    ))
}

@inline
trusted fun esp32AmpduWrite(index: u32, offset: int, value: u32): void {
    ablaUnsafeVolatileStoreU32(
        esp32AmpduSessionRegisterAddress(index, offset), int(value)
    )
    return
}

@inline
trusted fun esp32AmpduLoadU8(address: u32, offset: int): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address) + offset)) & 255
)

@inline
trusted fun esp32AmpduLoadU32(address: u32, index: int): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address) + index * 4))
)

@inline
trusted fun esp32AmpduStoreU32(
    address: u32,
    index: int,
    value: u32
): void {
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(address) + index * 4), int(value)
    )
    return
}

// wifi_log is variadic after its six register arguments. These three internal
// leaves express that ABI without an extern C declaration or an exported
// trampoline; the block-ack register operations themselves remain typed Abla.
// Internal direct Abla calls place their i64 argument count in a2/a3, followed
// by scalar arguments in a4..a7 and then the caller stack.
@naked
trusted fun esp32AmpduLogAdd(
    index: u32,
    interfaceIndex: u32,
    macAddress: u32,
    tid: u32,
    sequence: u32,
    window: u32
): void = xtensaAssemblyVoid(
    ".pushsection .rodata.abla_ampdu,\"aMS\",@progbits,1\n.Labla_ampdu_add:\n.asciz \"<ba-add>idx:%d (ifx:%d, %02x:%02x:%02x:%02x:%02x:%02x), tid:%d, ssn:%d, winSize:%d\"\n.Labla_ampdu_clear:\n.asciz \"<ba-clr>idx:%d, tid:%d, ssn:%d, winSize:%d\"\n.Labla_ampdu_delete:\n.asciz \"<ba-del>idx:%d, tid:%d\"\n.popsection\nentry a1, 80\nextui a4, a4, 0, 8\nextui a5, a5, 0, 8\nextui a7, a7, 0, 8\nl32i a9, a1, 80\nextui a9, a9, 0, 16\nl32i a2, a1, 84\nextui a2, a2, 0, 8\nl8ui a8, a6, 0\ns32i a8, a1, 0\nl8ui a8, a6, 1\ns32i a8, a1, 4\nl8ui a8, a6, 2\ns32i a8, a1, 8\nl8ui a8, a6, 3\ns32i a8, a1, 12\nl8ui a8, a6, 4\ns32i a8, a1, 16\nl8ui a8, a6, 5\ns32i a8, a1, 20\ns32i a7, a1, 24\ns32i a9, a1, 28\ns32i a2, a1, 32\nmovi a10, 5\nmovi a11, 8192\nmovi.n a12, 3\nmovi a13, .Labla_ampdu_add\nmov.n a14, a4\nmov.n a15, a5\nmemw\ncall8 wifi_log\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32AmpduLogClear(
    index: u32,
    tid: u32,
    sequence: u32,
    window: u32
): void = xtensaAssemblyVoid(
    "entry a1, 48\nextui a4, a4, 0, 8\nextui a5, a5, 0, 8\nextui a6, a6, 0, 16\nextui a7, a7, 0, 8\ns32i a6, a1, 0\ns32i a7, a1, 4\nmovi a10, 5\nmovi a11, 8192\nmovi.n a12, 3\nmovi a13, .Labla_ampdu_clear\nmov.n a14, a4\nmov.n a15, a5\nmemw\ncall8 wifi_log\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32AmpduLogDelete(index: u32, tid: u32): void =
    xtensaAssemblyVoid(
        "entry a1, 32\nextui a14, a4, 0, 8\nextui a15, a5, 0, 8\nmovi a10, 5\nmovi a11, 8192\nmovi.n a12, 3\nmovi a13, .Labla_ampdu_delete\ncall8 wifi_log\nretw.n",
        "~{memory}"
    )

@export("hal_agreement_add_rx_ba")
trusted fun esp32AmpduAddReceiveAgreement(
    index: u32,
    interfaceIndex: u32,
    macAddress: u32,
    tid: u32,
    sequence: u32,
    window: u32
): void {
    esp32AmpduLogAdd(
        index, interfaceIndex, macAddress, tid, sequence, window
    )
    esp32AmpduWrite(index, 8, esp32AmpduMacLow(
        esp32AmpduLoadU8(macAddress, 0),
        esp32AmpduLoadU8(macAddress, 1),
        esp32AmpduLoadU8(macAddress, 2),
        esp32AmpduLoadU8(macAddress, 3)
    ))
    esp32AmpduWrite(index, 4, esp32AmpduMacHigh(
        interfaceIndex,
        esp32AmpduLoadU8(macAddress, 4),
        esp32AmpduLoadU8(macAddress, 5)
    ))
    esp32AmpduWrite(index, 12, esp32AmpduWindowControl(sequence, window))
    esp32AmpduWrite(
        index, 0, esp32AmpduRead(index, 0) & ~esp32AmpduActiveMask
    )
    esp32AmpduWrite(index, 16, u32(0))
    esp32AmpduWrite(index, 20, u32(0))
    esp32AmpduWrite(index, 0, esp32AmpduSessionCommand(tid))
    return
}

@export("hal_agreement_clr_rx_ba")
trusted fun esp32AmpduClearReceiveAgreement(
    index: u32,
    tid: u32,
    sequence: u32,
    window: u32
): void {
    esp32AmpduLogClear(index, tid, sequence, window)
    esp32AmpduWrite(index, 8, u32(0))
    esp32AmpduWrite(index, 12, esp32AmpduWindowControl(sequence, window))
    esp32AmpduWrite(index, 16, u32(0))
    esp32AmpduWrite(index, 20, u32(0))
    esp32AmpduWrite(index, 8, esp32AmpduSessionCommand(tid))
    return
}

@export("hal_agreement_del_rx_ba")
trusted fun esp32AmpduDeleteReceiveAgreement(index: u32): void {
    val control = esp32AmpduRead(index, 0)
    esp32AmpduLogDelete(index, (control >> u32(12)) & u32(15))
    esp32AmpduWrite(index, 0, control & ~esp32AmpduActiveMask)
    esp32AmpduWrite(index, 16, u32(0))
    esp32AmpduWrite(index, 20, u32(0))
    esp32AmpduWrite(index, 0, control | esp32AmpduActiveMask)
    esp32AmpduWrite(index, 0, u32(0))
    return
}

@export("hal_ba_session_store")
trusted fun esp32AmpduStoreSessions(
    sequences: u32,
    receiveAddresses: u32,
    bitmapAddresses: u32
): void {
    var index = 0
    val sessionCount = int(xtensaAssemblyReadU32("movi $0, 8", "=a"))
    while (index < sessionCount) {
        val sessionIndex = u32(index)
        if ((esp32AmpduRead(sessionIndex, 0) & esp32AmpduActiveMask) !=
            u32(0)) {
            esp32AmpduStoreU32(
                sequences,
                index,
                esp32AmpduRead(sessionIndex, 12) >> u32(20)
            )
            esp32AmpduStoreU32(
                receiveAddresses, index, esp32AmpduRead(sessionIndex, 24)
            )
            esp32AmpduStoreU32(
                bitmapAddresses, index, esp32AmpduRead(sessionIndex, 28)
            )
        }
        index = index + 1
    }
    return
}

@export("hal_ba_session_restore")
trusted fun esp32AmpduRestoreSessions(
    sequences: u32,
    receiveAddresses: u32,
    bitmapAddresses: u32
): void {
    var index = 0
    val sessionCount = int(xtensaAssemblyReadU32("movi $0, 8", "=a"))
    while (index < sessionCount) {
        val sessionIndex = u32(index)
        val control = esp32AmpduRead(sessionIndex, 0)
        if ((control & esp32AmpduActiveMask) != u32(0)) {
            esp32AmpduWrite(
                sessionIndex, 0, control & ~esp32AmpduActiveMask
            )
            esp32AmpduWrite(
                sessionIndex,
                12,
                (esp32AmpduRead(sessionIndex, 12) & u32(4294963200)) |
                    (esp32AmpduLoadU32(sequences, index) & u32(4095))
            )
            esp32AmpduWrite(
                sessionIndex, 16, esp32AmpduLoadU32(receiveAddresses, index)
            )
            esp32AmpduWrite(
                sessionIndex, 20, esp32AmpduLoadU32(bitmapAddresses, index)
            )
            esp32AmpduWrite(
                sessionIndex,
                0,
                esp32AmpduRead(sessionIndex, 0) | esp32AmpduActiveMask
            )
        }
        index = index + 1
    }
    return
}

@export("hal_ba_session_restore_by_hw_index")
trusted fun esp32AmpduRestoreSession(
    index: u32,
    sequences: u32,
    receiveAddresses: u32,
    bitmapAddresses: u32
): void {
    val sessionIndex = index & u32(255)
    val control = esp32AmpduRead(sessionIndex, 0)
    if ((control & esp32AmpduActiveMask) == u32(0)) return
    val arrayIndex = int(sessionIndex)
    esp32AmpduWrite(sessionIndex, 0, control & ~esp32AmpduActiveMask)
    esp32AmpduWrite(
        sessionIndex, 16, esp32AmpduLoadU32(receiveAddresses, arrayIndex)
    )
    esp32AmpduWrite(
        sessionIndex, 20, esp32AmpduLoadU32(bitmapAddresses, arrayIndex)
    )
    esp32AmpduWrite(
        sessionIndex,
        12,
        (esp32AmpduRead(sessionIndex, 12) & u32(4294963200)) |
            (esp32AmpduLoadU32(sequences, arrayIndex) & u32(4095))
    )
    esp32AmpduWrite(
        sessionIndex,
        0,
        esp32AmpduRead(sessionIndex, 0) | esp32AmpduActiveMask
    )
    return
}
