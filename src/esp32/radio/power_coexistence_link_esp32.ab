import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPowerCoexistenceOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredPmCoexCustomizedWifiTimeSlice", "pm_coex_customized_wifi_time_slice")) return false
    if (!internalFunction("esp32RecoveredPmCoexPwrConfigure", "pm_coex_pwr_configure")) return false
    if (!internalFunction("esp32RecoveredPmCoexPwrUpdate", "pm_coex_pwr_update")) return false
    if (!internalFunction("esp32RecoveredPmCoexRecalculateWifiTimeSlice", "pm_coex_recalculate_wifi_time_slice")) return false
    if (!internalFunction("esp32RecoveredPmCoexReconnectPolicy", "pm_coex_reconnect_policy")) return false
    if (!internalFunction("esp32RecoveredPmCoexSchmOverallPeriodGet", "pm_coex_schm_overall_period_get")) return false
    if (!internalFunction("esp32RecoveredPmCoexSetReconnectPolicy", "pm_coex_set_reconnect_policy")) return false
    if (!internalFunction("esp32RecoveredPmCoexUpdateWifiTimeSliceState", "pm_coex_update_wifi_time_slice_state")) return false
    if (!internalFunction("esp32RecoveredPmGetNullMaxTxTime", "pm_get_null_max_tx_time")) return false
    true
}
