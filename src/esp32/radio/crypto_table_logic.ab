// Pure classic-ESP32 MAC key-table packing. Keeping this independent from the
// MMIO transport makes every cipher/control encoding host-testable.

val esp32HalCryptoKeyTableAddress = 1073169408
val esp32HalCryptoSlotBytes = 40
val esp32HalCryptoSlotCount = 25

@inline
fun esp32HalCryptoSlotAddress(slot: int): int =
    esp32HalCryptoKeyTableAddress + slot * esp32HalCryptoSlotBytes

@inline
fun esp32HalCryptoEncodeControl(
    slot: int,
    interfaceIndex: int,
    cipher: int,
    keyIdentifier: int,
    peerHigh: int
): int {
    val cipherBits = if (cipher == 5) cipher << 16
        else (cipher & 7) << 18
    var algorithm = 7
    if ((cipherBits & 1835008) != 262144) {
        algorithm = if (slot < 4) 6 else 3
    }
    (peerHigh & 65535) | ((interfaceIndex & 3) << 24) |
        (algorithm << 21) | ((keyIdentifier & 3) << 30) | cipherBits
}

@inline
fun esp32HalCryptoControlInterface(control: int): int =
    (control >>> 24) & 3

@inline
fun esp32HalCryptoControlCipher(control: int): int =
    if ((control & 2031616) == 327680) 5 else (control >>> 18) & 7

@inline
fun esp32HalCryptoControlKeyIdentifier(control: int): int =
    (control >>> 30) & 3

@inline
fun esp32HalCryptoControlPeerHigh(control: int): int = control & 65535
