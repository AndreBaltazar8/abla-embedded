import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"

// Packet-engine diagnostics are state, not a reason to retain several KiB of
// formatting code. Counters stay ABI-compatible while unused dump routines
// remain ordinary Abla functions and are eliminated from production images.

var esp32WifiGpioDebugCallback = 0

trusted fun esp32WifiGpioDebug(event: i32, value: i32): void {
    val callback = esp32WifiGpioDebugCallback
    if (callback != 0) callNativeVoidI32I32(callback, int(event), int(value))
    return
}

trusted fun esp32WifiSetGpioDebugCallback(callback: u32): void {
    if (callback != u32(0)) esp32WifiGpioDebugCallback = int(callback)
    return
}

fun esp32WifiGpioDebugMaximumEvent(): i32 = i32(18)

fun esp32PacketDebugDump(mask: u32): void {
    // Counter formatting is intentionally internal. Production station builds
    // retain this tiny dispatcher only while ieee80211_api.o calls its ABI.
    if ((mask & u32(16)) != u32(0)) esp32PacketDebugHistoryShow()
    return
}

trusted fun esp32PacketDebugResetPowerCounters(): void {
    xtensaAssemblyVoid(
        ".pushsection .bss.g_pm_cnt,\"aw\",@nobits\n.global g_pm_cnt\n.type g_pm_cnt,@object\n.size g_pm_cnt,72\ng_pm_cnt:\n.space 72\n.popsection\n.pushsection .bss.g_lmac_cnt,\"aw\",@nobits\n.global g_lmac_cnt\n.type g_lmac_cnt,@object\n.size g_lmac_cnt,180\ng_lmac_cnt:\n.space 180\n.popsection",
        "~{memory}"
    )
    val counters = int(xtensaAssemblyReadU32("movi $0, g_pm_cnt", "=a"))
    var offset = 0
    while (offset < 72) {
        ablaUnsafeVolatileStoreU32(counters + offset, u32(0))
        offset = offset + 4
    }
    return
}

// Kept only because the opaque packet engine still calls this hook.
fun esp32PacketDebugInitialize(): void { return }

fun esp32PacketDebugHistoryShow(): void { return }
fun esp32PacketDebugBufferShow(): void { return }
fun esp32PacketDebugPerformanceShow(): void { return }
