import "../../xtensa/assembly.ab"

// Classic ESP32 legacy-rate timing. Five names still own data or cross the
// opaque ABI. RTS-rate selection is an internal Abla operation and is pruned
// from firmware that does not call it.

@naked
trusted fun esp32RateControlSetBasicRate(): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nmovi.n a2, 0\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32RateControlAckTime(rate: u32): u32 = xtensaAssemblyReadU32(
    ".pushsection .rodata.abla_rate_controls,\"a\",@progbits\n.balign 4\n.Labla_rate_controls:\n.long 0x00040000,0x0000013a,0x00020000,0x00050102\n.long 0x0000ba2e,0x000600df,0x00005d17,0x000700d5\n.long 0x00040000,0x0004013a,0x00020000,0x000500a2\n.long 0x0000ba2e,0x0006007f,0x00005d17,0x00070075\n.long 0x00001555,0x0009002c,0x00002aaa,0x0009002c\n.long 0x00005555,0x000a0030,0x0000aaaa,0x000b003c\n.long 0x000012f6,0x0009002c,0x00001c71,0x0009002c\n.long 0x000038e3,0x000a0030,0x000071c7,0x000b003c\n.long 0x00009d89,0x000b003c,0x00004ec4,0x000a0030\n.long 0x00003483,0x000a0030,0x00002762,0x0009002c\n.long 0x00001a41,0x0009002c,0x000013b1,0x0009002c\n.long 0x00001181,0x0009002c,0x00000fc0,0x0009002c\n.long 0x00008dc8,0x000b003c,0x000046e4,0x000a0030\n.long 0x00002f42,0x000a0030,0x00002372,0x0009002c\n.long 0x000017a1,0x0009002c,0x000011b9,0x0009002c\n.long 0x00000fc0,0x0009002c,0x00000e2d,0x0009002c\n.long 0x00080000,0x002a020a,0x00100000,0x002902ea\n.zero 72\n.size .Labla_rate_controls, .-.Labla_rate_controls\n.popsection\n.pushsection .text.abla_rc_get_duration,\"ax\",@progbits\n.balign 4\n.type .Labla_rc_get_duration,@function\n.Labla_rc_get_duration:\nentry a1, 32\nslli a3, a3, 3\nbltui a2, 8, .Labla_duration_rate_ready\naddi a3, a3, 22\n.Labla_duration_rate_ready:\nmovi a8, .Labla_rate_controls\naddx8 a8, a2, a8\nmovi a9, 0x3fff\nl32i.n a8, a8, 0\nbltu a9, a3, .Labla_duration_wide\nmull a3, a3, a8\nmovi a8, 0x3ffff\nadd.n a3, a3, a8\nextui a3, a3, 18, 14\nj .Labla_duration_round\n.Labla_duration_wide:\nextui a10, a3, 0, 9\nextui a9, a8, 0, 9\nsrli a3, a3, 9\nextui a8, a8, 9, 16\nmull a11, a3, a8\nmull a3, a9, a3\nmull a8, a10, a8\nmull a9, a9, a10\nadd.n a3, a3, a8\nslli a3, a3, 9\nmovi a8, 0x3ffff\nadd.n a3, a3, a9\nadd.n a3, a3, a8\nsrai a3, a3, 18\nadd.n a3, a3, a11\n.Labla_duration_round:\nbltui a2, 8, .Labla_duration_done\naddi.n a3, a3, 3\nmovi.n a2, -4\nand a3, a3, a2\n.Labla_duration_done:\nextui a2, a3, 0, 16\nretw.n\n.size .Labla_rc_get_duration, .-.Labla_rc_get_duration\n.popsection\nentry a1, 32\nmovi a9, .Labla_rate_controls\nextui a2, a2, 0, 8\naddx8 a2, a2, a9\nl8ui a8, a2, 6\naddx8 a8, a8, a9\nl16ui a2, a8, 4\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32RateControlRtsRate(rate: u32): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nmovi a8, .Labla_rate_controls\nextui a2, a2, 0, 8\naddx8 a2, a2, a8\nl8ui a2, a2, 6\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32RateControlCtsTime(
    rate: u32,
    frameLength: u32,
    extraTime: u32
): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nextui a10, a2, 0, 8\nextui a11, a3, 0, 16\nextui a4, a4, 0, 16\nmovi.n a8, 10\nbltui a10, 8, .Labla_cts_preamble_ready\nmovi a8, 16\n.Labla_cts_preamble_ready:\naddi a9, a10, -41\nextui a9, a9, 0, 8\nmovi a5, 0x120\nbltui a9, 2, .Labla_cts_phy_ready\nmovi a5, 192\nbltui a10, 5, .Labla_cts_phy_ready\nmovi a5, 96\nbltui a10, 8, .Labla_cts_phy_ready\nmovi.n a9, 15\nmovi.n a5, 36\nbltu a9, a10, .Labla_cts_phy_ready\nmovi.n a5, 20\n.Labla_cts_phy_ready:\nadd.n a8, a8, a4\nextui a4, a8, 0, 16\nadd.n a5, a5, a4\nmovi a8, .Labla_rc_get_duration\ncallx8 a8\nadd.n a5, a10, a5\nextui a2, a5, 0, 16\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32RateControlBlockAckTime(rate: u32): u32 =
    xtensaAssemblyReadU32(
        "entry a1, 32\nmovi a3, .Labla_rate_controls\nextui a2, a2, 0, 8\naddx8 a2, a2, a3\nl8ui a10, a2, 6\nmovi a2, 10\nbltui a10, 8, .Labla_block_ack_preamble_ready\nmovi a2, 16\n.Labla_block_ack_preamble_ready:\naddi a8, a10, -41\nextui a8, a8, 0, 8\nmovi a3, 0x120\nbltui a8, 2, .Labla_block_ack_phy_ready\nmovi a3, 192\nbltui a10, 5, .Labla_block_ack_phy_ready\nmovi a3, 96\nbltui a10, 8, .Labla_block_ack_phy_ready\nmovi.n a8, 15\nmovi.n a3, 36\nbltu a8, a10, .Labla_block_ack_phy_ready\nmovi.n a3, 20\n.Labla_block_ack_phy_ready:\nmovi.n a11, 30\nmovi a8, .Labla_rc_get_duration\ncallx8 a8\nadd.n a10, a10, a3\nadd.n a2, a2, a10\nextui a2, a2, 0, 16\nretw.n",
        "~{memory}"
    )
