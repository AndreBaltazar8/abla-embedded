import "../dport_esp32.ab"
import "../../xtensa/cpu.ab"

val esp32RtcSensorControlRegister = u32(1072990284)
val esp32RtcSensorDataRegister = u32(1072990276)

// Compatibility spelling follows the ROM/PHY ABI. Analog setup, settling,
// sample extraction, and teardown are all emitted from Abla.
trusted fun esp32RadioTemperatureSensorRead(): i32 {
    esp32DportUpdate(
        esp32RtcSensorControlRegister, u32(16711680), u32(131072)
    )
    esp32DportUpdate(
        esp32RtcSensorControlRegister, u32(0), u32(33554432)
    )
    esp32DportUpdate(
        esp32RtcSensorControlRegister, u32(16777216), u32(0)
    )
    esp32DportUpdate(
        esp32RtcSensorControlRegister, u32(0), u32(16777216)
    )
    val frequency = esp32CurrentCpuFrequencyMegahertz()
    val settled = delayMicroseconds(100, frequency)
    esp32DportUpdate(
        esp32RtcSensorControlRegister, u32(0), u32(67108864)
    )
    val sampled = delayMicroseconds(2, frequency)
    val raw = esp32DportRead(esp32RtcSensorDataRegister)
    esp32DportUpdate(
        esp32RtcSensorControlRegister, u32(67108864), u32(0)
    )
    esp32DportUpdate(
        esp32RtcSensorControlRegister, u32(16777216), u32(0)
    )
    esp32DportUpdate(
        esp32RtcSensorControlRegister, u32(33554432), u32(0)
    )
    i32((raw & u32(1069547520)) >> u32(22))
}
