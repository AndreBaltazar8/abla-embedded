// Pure packing and address rules for the classic ESP32 receive block-ack
// engine. Keeping these independently testable avoids baking protocol fields
// into the MMIO implementation.

val esp32AmpduFirstSessionRegister = 1073164880

@inline
fun esp32AmpduSessionRegisterAddress(index: u32, offset: int): int =
    esp32AmpduFirstSessionRegister - int(index & u32(255)) * 32 + offset

@inline
fun esp32AmpduMacLow(
    first: u32,
    second: u32,
    third: u32,
    fourth: u32
): u32 = (first & u32(255)) |
    ((second & u32(255)) << u32(8)) |
    ((third & u32(255)) << u32(16)) |
    ((fourth & u32(255)) << u32(24))

@inline
fun esp32AmpduMacHigh(
    interfaceIndex: u32,
    fifth: u32,
    sixth: u32
): u32 = ((interfaceIndex & u32(3)) << u32(16)) |
    (fifth & u32(255)) |
    ((sixth & u32(255)) << u32(8))

@inline
fun esp32AmpduWindowControl(sequence: u32, window: u32): u32 =
    (sequence & u32(4095)) | ((window << u32(13)) & u32(1040384))

@inline
fun esp32AmpduSessionCommand(tid: u32): u32 =
    u32(3221225477) | ((tid << u32(12)) & u32(65535))
