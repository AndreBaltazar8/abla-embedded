import "../dma_descriptor_logic.ab"
import "./mac_esp32_logic.ab"

type WifiTxOutcome = i32

@inline
fun wifiTxPending(): WifiTxOutcome = WifiTxOutcome(i32(0))
@inline
fun wifiTxComplete(): WifiTxOutcome = WifiTxOutcome(i32(1))
@inline
fun wifiTxTimeout(): WifiTxOutcome = WifiTxOutcome(i32(2))
@inline
fun wifiTxCollision(): WifiTxOutcome = WifiTxOutcome(i32(3))
@inline
fun wifiTxConflicting(): WifiTxOutcome = WifiTxOutcome(i32(4))
@inline
fun wifiTxInvalid(): WifiTxOutcome = WifiTxOutcome(i32(-1))

@inline
fun WifiTxOutcome.rawValue(): i32 = this

@inline
fun WifiTxOutcome.terminal(): bool =
    this.rawValue() >= wifiTxComplete().rawValue() &&
        this.rawValue() <= wifiTxConflicting().rawValue()

@inline
fun esp32WifiTxFrameLength(mpduLength: int): int =
    if (mpduLength < 0 || mpduLength > 4091) -1 else mpduLength + 4

fun esp32WifiTxOutcome(
    completeStatus: int,
    errorStatus: int,
    queue: WifiMacTxQueue
): WifiTxOutcome {
    val bit = queue.statusBit()
    if (bit == 0) return wifiTxInvalid()
    val complete = (completeStatus & bit) != 0
    val collision = (errorStatus & bit) != 0
    val timeout = (errorStatus & (bit << 16)) != 0
    val count = (if (complete) 1 else 0) +
        (if (collision) 1 else 0) + (if (timeout) 1 else 0)
    if (count > 1) return wifiTxConflicting()
    if (complete) return wifiTxComplete()
    if (timeout) return wifiTxTimeout()
    if (collision) return wifiTxCollision()
    wifiTxPending()
}
