import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMacHalOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredHalDeinit", "hal_deinit")) return false
    if (!internalFunction("esp32RecoveredHalDisableMac", "hal_disable_mac")) return false
    if (!internalFunction("esp32RecoveredHalEnableMac", "hal_enable_mac")) return false
    if (!internalFunction("esp32RecoveredHalGetTsfTime", "hal_get_tsf_time")) return false
    if (!internalFunction("esp32RecoveredHalInit", "hal_init")) return false
    if (!internalFunction("esp32RecoveredHalMacClrBssid", "hal_mac_clr_bssid")) return false
    if (!internalFunction("esp32RecoveredHalMacDeinit", "hal_mac_deinit")) return false
    if (!internalFunction("esp32RecoveredHalMacDisableLowRate", "hal_mac_disable_low_rate")) return false
    if (!internalFunction("esp32RecoveredHalMacEnableLowRate", "hal_mac_enable_low_rate")) return false
    if (!internalFunction("esp32RecoveredHalMacInit", "hal_mac_init")) return false
    if (!internalFunction("esp32RecoveredHalMacInterruptClrEvent", "hal_mac_interrupt_clr_event")) return false
    if (!internalFunction("esp32RecoveredHalMacInterruptClrWatchdog", "hal_mac_interrupt_clr_watchdog")) return false
    if (!internalFunction("esp32RecoveredHalMacInterruptGetEvent", "hal_mac_interrupt_get_event")) return false
    if (!internalFunction("esp32RecoveredHalMacIsLowRateEnabled", "hal_mac_is_low_rate_enabled")) return false
    if (!internalFunction("esp32RecoveredHalMacIsTxqEnabled", "hal_mac_is_txq_enabled")) return false
    if (!internalFunction("esp32RecoveredHalMacIsTxqValid", "hal_mac_is_txq_valid")) return false
    if (!internalFunction("esp32RecoveredHalMacRxDisable", "hal_mac_rx_disable")) return false
    if (!internalFunction("esp32RecoveredHalMacRxEnable", "hal_mac_rx_enable")) return false
    if (!internalFunction("esp32RecoveredHalMacRxReadRxdscrlast", "hal_mac_rx_read_rxdscrlast")) return false
    if (!internalFunction("esp32RecoveredHalMacRxReadRxdscrnext", "hal_mac_rx_read_rxdscrnext")) return false
    if (!internalFunction("esp32RecoveredHalMacRxSetBase", "hal_mac_rx_set_base")) return false
    if (!internalFunction("esp32RecoveredHalMacRxSetPolicy", "hal_mac_rx_set_policy")) return false
    if (!internalFunction("esp32RecoveredHalMacSetAddr", "hal_mac_set_addr")) return false
    if (!internalFunction("esp32RecoveredHalMacSetBssid", "hal_mac_set_bssid")) return false
    if (!internalFunction("esp32RecoveredHalMacSetCsi", "hal_mac_set_csi")) return false
    if (!internalFunction("esp32RecoveredHalMacSetRxqPolicy", "hal_mac_set_rxq_policy")) return false
    if (!internalFunction("esp32RecoveredHalMacSetTxqInvalid", "hal_mac_set_txq_invalid")) return false
    if (!internalFunction("esp32RecoveredHalMacTsfGetTime", "hal_mac_tsf_get_time")) return false
    if (!internalFunction("esp32RecoveredHalMacTsfReset", "hal_mac_tsf_reset")) return false
    if (!internalFunction("esp32RecoveredHalMacTsfSetTime", "hal_mac_tsf_set_time")) return false
    if (!internalFunction("esp32RecoveredHalMacTxConfigEdca", "hal_mac_tx_config_edca")) return false
    if (!internalFunction("esp32RecoveredHalMacTxConfigTimeout", "hal_mac_tx_config_timeout")) return false
    if (!internalFunction("esp32RecoveredHalMacTxGetBlockack", "hal_mac_tx_get_blockack")) return false
    if (!internalFunction("esp32RecoveredHalMacTxSetCca", "hal_mac_tx_set_cca")) return false
    if (!internalFunction("esp32RecoveredHalMacTxSetPpdu", "hal_mac_tx_set_ppdu")) return false
    if (!internalFunction("esp32RecoveredHalMacTxqDisable", "hal_mac_txq_disable")) return false
    if (!internalFunction("esp32RecoveredHalMacTxqEnable", "hal_mac_txq_enable")) return false
    if (!internalFunction("esp32RecoveredHalNow", "hal_now")) return false
    if (!internalFunction("esp32RecoveredHalRandom", "hal_random")) return false
    if (!internalFunction("esp32RecoveredHalRxDisableBssidCheck", "hal_rx_disable_bssid_check")) return false
    if (!internalFunction("esp32RecoveredHalRxEnableBssidCheck", "hal_rx_enable_bssid_check")) return false
    if (!internalFunction("esp32RecoveredMacLastRxbufDeinit", "mac_last_rxbuf_deinit")) return false
    if (!internalFunction("esp32RecoveredMacLastRxbufInit", "mac_last_rxbuf_init")) return false
    if (!internalFunction("esp32RecoveredMacRxbufDisable", "mac_rxbuf_disable")) return false
    if (!internalFunction("esp32RecoveredMacRxbufInit", "mac_rxbuf_init")) return false
    if (!internalFunction("esp32RecoveredMacTxSetDuration", "mac_tx_set_duration")) return false
    if (!internalFunction("esp32RecoveredMacTxSetPlcp0", "mac_tx_set_plcp0")) return false
    if (!internalFunction("esp32RecoveredMacTxrxInit", "mac_txrx_init")) return false
    if (!internalFunction("esp32RecoveredWDevMeshDisableTsf", "wDev_Mesh_Disable_Tsf")) return false
    true
}
