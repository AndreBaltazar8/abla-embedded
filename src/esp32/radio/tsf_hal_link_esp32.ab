import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTsfHalOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredHalDisableNanTsf", "hal_disable_nan_tsf")) return false
    if (!internalFunction("esp32RecoveredHalDisableSoftapTsf", "hal_disable_softap_tsf")) return false
    if (!internalFunction("esp32RecoveredHalDisableStaTsf", "hal_disable_sta_tsf")) return false
    if (!internalFunction("esp32RecoveredHalEnableNanTsf", "hal_enable_nan_tsf")) return false
    if (!internalFunction("esp32RecoveredHalEnableStaTsf", "hal_enable_sta_tsf")) return false
    true
}
