import "./adc_clock_c5_sequence.ab"
// C5 adc_ll_set_power_manage: clock bit6, XPD mode27..28, mode1 reserved.
// Requires exclusive, stopped ADC complex and pinned live clocks throughout.
// Ready verifies register state ONLY, not analog settling or trim completion.
// status0closed1ready2authority3clock4busy5reserved-mode6write.
// snapshot: bit8clock, bits9..10mode, bit11valid. Retain on failure.
type C5AdcPowerOwner=int
fun C5AdcPowerOwner.status(): int = this&255
fun C5AdcPowerOwner.ready(): bool = this.status() == 1
trusted fun c5AdcPowerField(mask: u32,value: u32): bool {
    val before=c5AdcRead(0)
    val desired=(before&~mask)|value
    if (desired != before) c5AdcWrite(0,desired)
    return (c5AdcRead(0)&mask) == value
}
trusted fun c5AdcPowerOpenOwned(exclusiveStopped: bool): C5AdcPowerOwner {
    if (!exclusiveStopped) return C5AdcPowerOwner(2)
    if (!c5AdcClocksReady()) return C5AdcPowerOwner(3)
    if (!c5AdcAllStopped()) return C5AdcPowerOwner(4)
    val before=c5AdcRead(0)
    val mode=int((before>>u32(27))&u32(3))
    if (mode == 1) return C5AdcPowerOwner(5)
    val snapshot=2048|(int((before>>u32(6))&u32(1))<<8)|(mode<<9)
    // Match LL ordering: clock first, then software-force-on.
    if (!c5AdcPowerField(u32(64),u32(64)) || !c5AdcPowerField(u32(0x18000000),u32(0x18000000))) return C5AdcPowerOwner(snapshot|6)
    return C5AdcPowerOwner(snapshot|1)
}
trusted fun C5AdcPowerOwner.closeOwned(exclusiveStopped: bool): C5AdcPowerOwner {
    if (!exclusiveStopped || this < 0 || (this&~4095) != 0 || this.status() > 6 || (this&2048) == 0) return this
    val snapshot=this&3840
    if (!c5AdcClocksReady()) return C5AdcPowerOwner(snapshot|3)
    if (!c5AdcAllStopped()) return C5AdcPowerOwner(snapshot|4)
    val mode=(snapshot>>>9)&3
    if (mode == 1) return C5AdcPowerOwner(snapshot|5)
    // Restore mode before withdrawing SAR clock; no conversion cancellation.
    if (!c5AdcPowerField(u32(0x18000000),u32(mode)<<u32(27)) ||
        !c5AdcPowerField(u32(64),u32((snapshot>>>8)&1)<<u32(6))) return C5AdcPowerOwner(snapshot|6)
    return C5AdcPowerOwner(0)
}
