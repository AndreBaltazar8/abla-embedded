import "./sdk/raw_buffer.ab"
//128byte caller-owned record; word0 initially0. Exclusive RTC/selected-pad
// ownership across prepare/sleep/restore. Caller has disabled output/analog
// drivers. Existing selected holds are refused, never stolen. Status latch
// clearing at prepare is intentional and cannot be undone by restoration.
trusted fun esp32S3Ext1RecordPrepareOwned(record: NativeBuffer,pins: int,level: int,holdPads: bool): bool {
    if (!record.hasAddressRange(0,128) || (record.addressValue() & 3) != 0 || !esp32S3RtcWakeMaskValid(pins) || level < 0 || level > 1) return false
    val base=record.addressValue()
    if (esp32S3RtcWakeRead(base) != 0 || (esp32S3RtcWakeRead(0x600080D8) & pins) != 0) return false
    if ((pins & 0x180000) != 0 && (esp32S3RtcWakeRead(0x60038018) & 16384) != 0) return false
    esp32S3RtcWakeWrite(base+4,pins)
    esp32S3RtcWakeWrite(base+8,if (holdPads) pins else 0)
    esp32S3RtcWakeWrite(base+12,esp32S3RtcWakeRead(0x60008904) & 0x80000000)
    esp32S3RtcWakeWrite(base+16,esp32S3RtcWakeRead(0x600080E0) & 0x3FFFFF)
    esp32S3RtcWakeWrite(base+20,esp32S3RtcWakeRead(0x60008064) & 0x80000000)
    esp32S3RtcWakeWrite(base+112,level)
    var pin=0
    while (pin < 22) {
        if ((pins & (1<<pin)) != 0) esp32S3RtcWakeWrite(base+24+pin*4,esp32S3RtcWakeRead(esp32S3RtcPadAddress(pin)) & 0xE2000)
        pin=pin+1
    }
    esp32S3RtcWakeWrite(base,0x45585431)
    if (!esp32S3PrepareExt1Owned(pins,level,holdPads)) {
        esp32S3RtcWakeWrite(base,0)
        return false
    }
    true
}
// Invoke after wake status is consumed and RTC peripheral power restored,
// before releasing pin owners. Preflight every field before changing anything.
trusted fun esp32S3Ext1RecordRestoreOwned(record: NativeBuffer): bool {
    if (!record.hasAddressRange(0,128) || (record.addressValue() & 3) != 0) return false
    val base=record.addressValue()
    if (esp32S3RtcWakeRead(base) != 0x45585431) return false
    val pins=esp32S3RtcWakeRead(base+4)
    val holds=esp32S3RtcWakeRead(base+8)
    val level=esp32S3RtcWakeRead(base+112)
    if (!esp32S3RtcWakeMaskValid(pins) || (holds != 0 && holds != pins) || level < 0 || level > 1) return false
    if ((esp32S3RtcWakeRead(0x600080D8) & pins) != holds || (esp32S3RtcWakeRead(0x600080E0) & 0x3FFFFF) != pins || ((esp32S3RtcWakeRead(0x60008064)>>>31) & 1) != level) return false
    var pin=0
    while (pin < 22) {
        if ((pins & (1<<pin)) != 0 && (esp32S3RtcWakeRead(esp32S3RtcPadAddress(pin)) & 0xE2000) != 0x82000) return false
        pin=pin+1
    }
    if (holds != 0) esp32S3RtcWakeUpdate(0x600080D8,holds,0)
    pin=0
    while (pin < 22) {
        if ((pins & (1<<pin)) != 0) esp32S3RtcWakeUpdate(esp32S3RtcPadAddress(pin),0xE2000,esp32S3RtcWakeRead(base+24+pin*4))
        pin=pin+1
    }
    // Do not replay the W1C status-clear bit in EXT_WAKEUP1.
    esp32S3RtcWakeWrite(0x600080E0,(esp32S3RtcWakeRead(0x600080E0) & ~0x7FFFFF) | (esp32S3RtcWakeRead(base+16) & 0x3FFFFF))
    esp32S3RtcWakeUpdate(0x60008064,0x80000000,esp32S3RtcWakeRead(base+20))
    esp32S3RtcWakeUpdate(0x60008904,0x80000000,esp32S3RtcWakeRead(base+12))
    esp32S3RtcWakeWrite(base,0)
    true
}
