import "./pll_start_c5_sequence.ab"
import "./analog_bus_esp32c5.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
@section(".iram1.abla.c5PllRead")
trusted fun c5PllRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5PllWrite")
trusted fun c5PllWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
@section(".iram1.abla.c5PllDelay")
trusted fun c5PllDelay(us: int): void { callNativeVoidI32(0x4000003c,us);return }
