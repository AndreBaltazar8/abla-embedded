import "./pll_start_c5_sequence.ab"
import "./analog_bus_esp32c5.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../hal/esp32.ab"
@section(".iram1.abla.c5PllRead")
@export("c5PllRead")
trusted fun c5PllReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5PllWrite")
@export("c5PllWrite")
trusted fun c5PllWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
@section(".iram1.abla.c5PllDelay")
@export("c5PllDelay")
trusted fun c5PllDelayHook(us: int): void { callNativeVoidI32(0x4000003c,us);return }
