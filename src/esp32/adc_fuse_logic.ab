import "./adc_two_point_logic.ab"
// ESP32 only, IDF v6.0.2 efuse_ll/register definitions. Snapshot of loaded
// read-shadow registers, not fuse programming. low32 TP, bits32..36 Vref,
// bit37 block3 calibration reservation. No heap, no nominal-reference fallback.
type Esp32AdcCalibration = int
fun esp32AdcCalibrationFromWords(block0word3: int,block0word4: int,block3word3: int): Esp32AdcCalibration =
    Esp32AdcCalibration((block3word3&4294967295)|(((block0word4>>8)&31)<<32)|(((block0word3>>14)&1)<<37))
fun Esp32AdcCalibration.bits(): int = this
fun Esp32AdcCalibration.vref(): int = esp32AdcVrefFromFuse((this>>32)&31)
fun Esp32AdcCalibration.hasTwoPoint(): bool = (this&137438953472) != 0 &&
    (this&127) != 0 && ((this>>7)&511) != 0 && ((this>>16)&127) != 0 && ((this>>23)&511) != 0
// Explicit two's-complement sign extension, including the minimum code.
// IDF's mask-after-negation decode maps that minimum to0; do not lose its sign.
fun Esp32AdcCalibration.lowPoint(unit: int): int {
    if ((unit != 1 && unit != 2) || !this.hasTwoPoint()) return -1
    val raw=if (unit == 1) this&127 else (this>>16)&127
    return (if (unit == 1) 278 else 421)+(if (raw >= 64) raw-128 else raw)*4
}
fun Esp32AdcCalibration.highPoint(unit: int): int {
    if ((unit != 1 && unit != 2) || !this.hasTwoPoint()) return -1
    val raw=if (unit == 1) (this>>7)&511 else (this>>23)&511
    return (if (unit == 1) 3265 else 3406)+(if (raw >= 256) raw-512 else raw)*4
}
// 1two-point,2fuseVref,3explicitcallerreference,0unavailable. This identifies
// provenance, not proof that every raw sample/decoded coefficient is usable.
fun Esp32AdcCalibration.source(reference: int): int =
    if (this.hasTwoPoint()) 1 else if (this.vref() >= 0) 2 else if (reference >= 995 && reference <= 1205) 3 else 0
fun Esp32AdcCalibration.millivolts(unit: int,attenuation: int,width: int,raw: int,reference: int): int {
    val selected=this.source(reference)
    val vref=if (this.vref() >= 0) this.vref() else reference
    if (selected == 1) return esp32AdcTwoPointMillivolts(unit,attenuation,width,raw,this.lowPoint(unit),this.highPoint(unit),vref)
    if (selected == 2 || selected == 3) return esp32AdcVrefMillivolts(unit,attenuation,width,raw,vref)
    return -1
}
