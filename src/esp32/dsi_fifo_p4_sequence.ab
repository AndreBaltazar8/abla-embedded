// ESP32-P4 DSI host, verified IDF6 hw_ver1/hw_ver3: header+6c,
// payload+70, status+74. Caller owns enabled/configured host+PHY and queues.
// No implicit clock/reset/mode changes; never run concurrently with video or
// another command producer without the host's required serialization.
fun dsiPacketHeader(channel: int,dataType: int,low: int,high: int): int =
    if (channel < 0 || channel > 3 || dataType < 0 || dataType > 63 ||
        low < 0 || low > 255 || high < 0 || high > 255) -1 else
    (high<<16)|(low<<8)|(channel<<6)|dataType
// Poll counts are bounded iterations, not wall-clock milliseconds.
// Return1 enqueued, -1 invalid, -2 timeout. Enqueued is NOT panel acceptance.
trusted fun esp32P4DsiSubmitHeaderOwned(header: int,polls: int): int {
    if (header < 0 || header > 16777215 || polls < 1 || polls > 1000000) return -1
    var remaining=polls
    while (remaining > 0) {
        if ((p4DsiRead(116)&u32(2)) == u32(0)) { p4DsiWrite(108,u32(header)); return 1 }
        remaining=remaining-1
    }
    return -2
}
trusted fun esp32P4DsiWritePayloadOwned(value: u32,polls: int): int {
    if (polls < 1 || polls > 1000000) return -1
    var remaining=polls
    while (remaining > 0) {
        if ((p4DsiRead(116)&u32(8)) == u32(0)) { p4DsiWrite(112,value); return 1 }
        remaining=remaining-1
    }
    return -2
}
// Full32-bit payload plus success bit32;0 failure/timeout, no FIFO read on
// empty. Caller must distinguish response framing and hardware errors later.
trusted fun esp32P4DsiReadPayloadOwned(polls: int): int {
    if (polls < 1 || polls > 1000000) return 0
    var remaining=polls
    while (remaining > 0) {
        if ((p4DsiRead(116)&u32(16)) == u32(0)) return (1<<32)|int(p4DsiRead(112))
        remaining=remaining-1
    }
    0
}
// Idle means command/write queues empty and no read command busy. Does not
// consume response words, clear errors, or prove the display handled a packet.
trusted fun esp32P4DsiWaitIdleOwned(polls: int): bool {
    if (polls < 1 || polls > 1000000) return false
    var remaining=polls
    while (remaining > 0) {
        if ((p4DsiRead(116)&u32(69)) == u32(5)) return true
        remaining=remaining-1
    }
    false
}
