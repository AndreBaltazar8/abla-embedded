import "./app_cpu_start_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
@inline
@export("esp32S3AppCpuRead")
trusted fun esp32S3AppCpuReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3AppCpuWrite")
trusted fun esp32S3AppCpuWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
@export("esp32S3AppCpuCurrentCore")
trusted fun esp32S3AppCpuCurrentCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3AppCpuPublishEntry")
trusted fun esp32S3AppCpuPublishEntryHook(entry: int): void {
    callNativeVoidI32(0x40000720,entry)
    return
}
