import "./app_cpu_start_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
@inline
trusted fun esp32S3AppCpuRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3AppCpuWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3AppCpuCurrentCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3AppCpuPublishEntry(entry: int): void {
    callNativeVoidI32(0x40000720,entry)
    return
}
