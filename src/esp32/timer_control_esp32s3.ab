import "./timer_esp32s3.ab"
import "./timer_control_s3_sequence.ab"
import "./rcc_esp32s3.ab"

// No clock-source retuning or counter-value load. S3 uses its XTAL-derived
// timer source; caller must maintain that source and own this counter.
trusted fun esp32S3TimerConfigure(unit: int, enabled: bool,
    stallCore0: bool, stallCore1: bool, owner: u32): bool {
    if (unit < 0 || unit > 1) return false
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock,owner)
    if (saved < 0) return false
    val configured = esp32S3TimerConfigureLocked(unit,enabled,stallCore0,stallCore1)
    atomicMemoryFence()
    val released = esp32S3RccLeave(lock,owner,saved)
    configured && released
}
