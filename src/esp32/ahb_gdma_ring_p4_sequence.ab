// P4 AHB descriptor is 12 bytes, aligned4, but internal SRAM is L1-cached.
// Give each descriptor its OWN 64-byte cache line for independent ownership
// transfers. Hardware follows explicit next pointers; no packed12 assumption.
// All descriptor lines and full strided buffer slots are exclusively owned.
// Internal SRAM only here; PSRAM needs separate alignment/L2/PMS handling.
fun esp32p4AhbGdmaRingLayoutValid(descriptors: int,count: int,buffers: int,
    stride: int,bytes: int): bool {
    if (count < 1 || count > 4095 || bytes < 1 || bytes > 4095 ||
        stride < bytes || stride < 64 || stride > 0xc0000 || (stride & 63) != 0 ||
        descriptors < 0x4ff00000 || descriptors >= 0x4ffc0000 || (descriptors & 63) != 0 ||
        buffers < 0x4ff00000 || buffers >= 0x4ffc0000 || (buffers & 63) != 0) return false
    val descriptorEnd=descriptors+count*64
    val bufferEnd=buffers+count*stride
    if (descriptorEnd > 0x4ffc0000 || bufferEnd > 0x4ffc0000) return false
    return descriptorEnd <= buffers || bufferEnd <= descriptors
}
// Builds CPU-visible descriptors only. Does NOT publish caches or start DMA.
// Caller owns parked channel and all lines, initialized TX payload (or RX
// destination). Publish/flush full descriptor and payload lines with barriers
// before DMA start; cache-sync failure must not be bypassed.
// Circular rings raise TX EOF per block; finite chains raise EOF only at end.
// RX length starts zero and hardware supplies EOF/length. Padding untouched.
trusted fun esp32p4AhbGdmaBuildRingOwned(descriptors: int,count: int,buffers: int,
    stride: int,bytes: int,transmit: bool,circular: bool,exclusive: bool): bool {
    if (!exclusive || !esp32p4AhbGdmaRingLayoutValid(descriptors,count,buffers,stride,bytes)) return false
    var index=0
    while (index < count) {
        val descriptor=descriptors+index*64
        val last=index+1 == count
        val next=if (last) (if (circular) descriptors else 0) else descriptor+64
        val flags=bytes | 0x80000000 | (if (transmit) (bytes << 12) | (if (circular || last) 0x40000000 else 0) else 0)
        p4AhbDescriptorWrite(descriptor+4,buffers+index*stride)
        p4AhbDescriptorWrite(descriptor+8,next)
        p4AhbDescriptorWrite(descriptor,flags)
        index=index+1
    }
    return true
}
