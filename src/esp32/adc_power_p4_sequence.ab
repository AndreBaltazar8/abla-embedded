import "./adc_clock_p4_sequence.ab"
// Selected HP SAR plus both LP SARs, matching IDF's shared sar_ctrl power
// acquisition followed by oneshot setup. Caller exclusively owns BOTH ADCs:
// SAR_CLK_GATED is shared. HP/LP clocks remain pinned through close/retries.
// Does not calibrate, settle, select a controller or start a conversion.
type P4AdcPower=int
fun P4AdcPower.status(): int = this&255
fun P4AdcPower.hasSnapshot(): bool = (this&16384) != 0
trusted fun esp32p4AdcStopped(): bool =
    (p4AdcRead(0x500de004)&u32(0x1000000)) == u32(0) &&
    (p4AdcRead(0x500de060)&u32(0x80000000)) == u32(0) &&
    (p4AdcRead(0x5012700c)&u32(0x20000)) == u32(0) &&
    (p4AdcRead(0x50127030)&u32(0x20000)) == u32(0)
// 1on2invalid/unowned3clocks/reset4reserved mode5readback6closed7busy.
// Snapshot: HPmode8..9, LPmode10..11, shared clock12, unit2 bit13, owned14,
// other LP SAR mode15..16. Restore both LP modes, not just selected SAR.
trusted fun esp32p4AdcPowerOpenOwned(unit: int,exclusive: bool): P4AdcPower {
    if (!exclusive || (unit != 1 && unit != 2)) return P4AdcPower(2)
    if (!esp32p4AdcClocksReady()) return P4AdcPower(3)
    if (!esp32p4AdcStopped()) return P4AdcPower(7)
    val shift=u32(if (unit == 1) 26 else 28)
    val lpShift=u32(if (unit == 1) 0 else 2)
    val hp=p4AdcRead(0x500de000)
    val hpMode=(hp>>shift)&u32(3)
    val lp=p4AdcRead(0x5012703c)
    val lpMode=(lp>>lpShift)&u32(3)
    val other=(lp>>(u32(2)-lpShift))&u32(3)
    if (hpMode == u32(1) || lpMode == u32(1) || other == u32(1)) return P4AdcPower(4)
    val token=(int(hpMode)<<8)|(int(lpMode)<<10)|(int((hp>>u32(5))&u32(1))<<12)|
        (if (unit == 2) 8192 else 0)|16384|(int(other)<<15)
    if (!p4AdcField(0x500de000,u32(32),u32(32)) ||
        !p4AdcField(0x500de000,u32(3)<<shift,u32(3)<<shift) ||
        !p4AdcField(0x5012703c,u32(15),u32(15))) return P4AdcPower(token|5)
    return P4AdcPower(token|1)
}
// Caller stops all DMA/RTC/LP/temperature/PWDET users before restoration.
// Visible timer/DMA/start guards supplement, not replace, this exclusion.
trusted fun P4AdcPower.closeOwned(exclusive: bool): P4AdcPower {
    if (!exclusive || !this.hasSnapshot() || this.status() == 6) return this
    val token=this&0x1ff00
    if (!esp32p4AdcClocksReady()) return P4AdcPower(token|3)
    if (!esp32p4AdcStopped()) return P4AdcPower(token|7)
    val shift=u32(if ((this&8192) == 0) 26 else 28)
    val lpShift=u32(if ((this&8192) == 0) 0 else 2)
    if (!p4AdcField(0x5012703c,u32(15),((u32(this>>10)&u32(3))<<lpShift)|((u32(this>>15)&u32(3))<<(u32(2)-lpShift))) ||
        !p4AdcField(0x500de000,u32(3)<<shift,(u32(this>>8)&u32(3))<<shift) ||
        !p4AdcField(0x500de000,u32(32),(u32(this>>12)&u32(1))<<u32(5))) return P4AdcPower(token|5)
    return P4AdcPower(token|6)
}
