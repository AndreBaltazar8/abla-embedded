import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkIpcInternals(): bool {
    if (!internalFunction("esp32RecoveredEspIpcCall", "esp_ipc_call")) return false
    if (!internalFunction("esp32RecoveredEspIpcCallBlocking", "esp_ipc_call_blocking")) return false
    if (!internalFunction("esp32RecoveredEspIpcCallNonblocking", "esp_ipc_call_nonblocking")) return false
    true
}
