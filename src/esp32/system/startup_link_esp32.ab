import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkStartupInternals(): bool {
    if (!internalFunction("esp32RecoveredStartCpu0", "start_cpu0")) return false
    if (!internalFunction("esp32RecoveredStartCpuOtherCores", "start_cpu_other_cores")) return false
    true
}
