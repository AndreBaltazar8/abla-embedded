import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPanicHandlerInternals(): bool {
    if (!internalFunction("esp32RecoveredPanicHandler", "panicHandler")) return false
    if (!internalFunction("esp32RecoveredXtUnhandledException", "xt_unhandled_exception")) return false
    if (!internalFunction("esp32RecoveredPanicRestart", "panic_restart")) return false
    true
}
