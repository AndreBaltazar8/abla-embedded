import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"
import "../../xtensa/cpu.ab"
import "../dport_esp32.ab"
import "../power/wdt_hal_typed_esp32.ab"
import "../rom/system_esp32.ab"

val esp32InterruptWatchdogContextStorage = nativeStaticAllocate(8)
val esp32InterruptWatchdogContext = u32(esp32InterruptWatchdogContextStorage)

// Shared between the two cores. Match ESP-IDF's volatile bool exactly: an
// ordinary load/store is not sufficient because each CPU's tick handler must
// observe the other CPU independently of LLVM's single-threaded alias model.
val esp32InterruptWatchdogCpu1TickedStorage = nativeStaticAllocate(4)
val esp32InterruptWatchdogCpu1Ticked = u32(esp32InterruptWatchdogCpu1TickedStorage)

@section(".iram1.abla.esp32InterruptWatchdogReconfigure")
trusted fun esp32InterruptWatchdogReconfigure(stage0Ticks:u32, stage1Ticks:u32):void {
    esp32WdtHalWriteProtectDisableValue(esp32InterruptWatchdogContext)
    esp32WdtHalConfigStageValue(
        esp32InterruptWatchdogContext, u32(0), stage0Ticks, u32(1)
    )
    esp32WdtHalConfigStageValue(
        esp32InterruptWatchdogContext, u32(1), stage1Ticks, u32(3)
    )
    esp32WdtHalFeedValue(esp32InterruptWatchdogContext)
    esp32WdtHalWriteProtectEnableValue(esp32InterruptWatchdogContext)
    return
}

@section(".iram1.abla.esp32InterruptWatchdogTickHook")
trusted fun esp32InterruptWatchdogTickHook():void {
    if (cpuCoreId() != u32(0)) {
        xtensaMemoryBarrier()
        ablaUnsafeVolatileStoreU32(
            int(esp32InterruptWatchdogCpu1Ticked), 1
        )
        return
    }

    xtensaMemoryBarrier()
    val cpu1Ticked = u32(ablaUnsafeVolatileLoadU32(
        int(esp32InterruptWatchdogCpu1Ticked)
    ))
    if (cpu1Ticked == u32(0)) return
    xtensaMemoryBarrier()
    ablaUnsafeVolatileStoreU32(
        int(esp32InterruptWatchdogCpu1Ticked), 0
    )
    esp32InterruptWatchdogReconfigure(u32(600), u32(1200))
}

trusted fun esp32InterruptWatchdogInitialize():void {
    val referenceCount = esp32RecoveredPeriphRccAcquireEnter(
        u32(4),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    if (referenceCount == u32(0)) {
        val clockRegister = u32(1072693440)
        xtensaDeviceStoreU32(
            clockRegister,
            esp32DportRead(clockRegister) | u32(0x8000)
        )
        val resetRegister = u32(1072693444)
        xtensaDeviceStoreU32(resetRegister, u32(0x8000))
        xtensaDeviceStoreU32(resetRegister, u32(0))

        val timerConfiguration = u32(1073086464 + 72)
        xtensaDeviceStoreU32(
            timerConfiguration,
            xtensaDeviceLoadU32(timerConfiguration) & u32(0xffffbfff)
        )
    }
    esp32RecoveredPeriphRccAcquireExit(
        u32(4),referenceCount,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

    esp32WdtHalInit(
        esp32InterruptWatchdogContext, u32(2), u32(40000), u32(1)
    )
    esp32InterruptWatchdogReconfigure(u32(10000), u32(10000))
    esp32WdtHalWriteProtectDisableValue(esp32InterruptWatchdogContext)
    esp32WdtHalEnableValue(esp32InterruptWatchdogContext)
    esp32WdtHalWriteProtectEnableValue(esp32InterruptWatchdogContext)
    return
}

trusted fun esp32InterruptWatchdogInitializeCurrentCpu():void {
    val core = cpuCoreId()
    esp32RecoveredEspIntrDisableSource(
        u32(24),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    esp32RomRouteInterruptMatrixValue(core, u32(20), u32(24))
    esp32RecoveredEspIntrEnableSource(
        u32(24),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    return
}
