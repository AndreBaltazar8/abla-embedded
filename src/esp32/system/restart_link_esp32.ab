import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSystemRestartInternals(): bool {
    if (!internalFunction("esp32RegisterShutdownHandler", "esp_register_shutdown_handler")) return false
    if (!internalFunction("esp32UnregisterShutdownHandler", "esp_unregister_shutdown_handler")) return false
    if (!internalFunction("esp32Restart", "esp_restart")) return false
    true
}
