import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkDebugHelpersInternals(): bool {
    if (!internalFunction("esp32RecoveredEspBacktraceGetNextFrame", "esp_backtrace_get_next_frame")) return false
    if (!internalFunction("esp32RecoveredEspBacktracePrintFromFrame", "esp_backtrace_print_from_frame")) return false
    if (!internalFunction("esp32RecoveredEspBacktracePrint", "esp_backtrace_print")) return false
    if (!internalFunction("esp32RecoveredEspBacktracePrintAllTasks", "esp_backtrace_print_all_tasks")) return false
    true
}
