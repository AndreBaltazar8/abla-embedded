import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHighInterruptHandlerInternals(): bool {
    if (!internalFunction(
        "esp32HighInterrupt4PanicReason",
        "abla_esp32_highint4_panic_reason"
    )) return false
    if (!internalFunction("esp32RecoveredXtHighint4", "xt_highint4")) return false
    true
}
