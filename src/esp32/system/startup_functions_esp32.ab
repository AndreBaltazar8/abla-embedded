import "../../runtime/freestanding_integer.ab"
import "../../xtensa/assembly.ab"
import "../power/wdt_hal_typed_esp32.ab"
import "abla/build"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Typed, source-owned system initializers. The linker table keeps the ESP-IDF
// priority/core-mask contract, but each entry points directly to a small Abla
// function instead of a recovered sixteen-register dispatcher.

trusted fun esp32InitializeCpuFrequencyReport(): u32 {
    // The clock is already configured before system initializers run. This
    // priority-10 hook intentionally has no state change; applications can
    // choose their own logging without retaining printf and timestamp code.
    return u32(0)
}

trusted fun esp32InitializeBrownoutDetector(): u32 {
    xtensaRaiseInterruptLevel3()
    esp32RecoveredEspBrownoutInit()
    xtensaRaiseInterruptLevel0()
    return u32(0)
}

trusted fun esp32InitializeLibcTime(): u32 {
    esp32RecoveredEspLibcTimeInit(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return u32(0)
}

trusted fun esp32DisableRtcWatchdogAfterStartup(): u32 {
    val watchdog = u32(nativeStackAllocate(8))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(watchdog)), 0)
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(watchdog + u32(4))),
        int(u32(0x3ff48000))
    )
    esp32WdtHalWriteProtectDisable(watchdog)
    esp32WdtHalDisable(watchdog)
    esp32WdtHalWriteProtectEnable(watchdog)
    return u32(0)
}

val esp32StartupRtcWatchdogStorage = nativeInternalSectionU32s([
    int(u32(nativeFunctionAddress(esp32DisableRtcWatchdogAfterStartup))),
    65537
], "abla_esp32_system_init_999_disable_rtc_wdt", ".esp_system_init_fn.999")
val esp32StartupRtcWatchdog = u32(esp32StartupRtcWatchdogStorage)

val esp32StartupLibcTimeStorage = nativeInternalSectionU32s([
    int(u32(nativeFunctionAddress(esp32InitializeLibcTime))),
    1
], "abla_esp32_system_init_105_newlib_time", ".esp_system_init_fn.105")
val esp32StartupLibcTimeInitialized = esp32StartupLibcTimeStorage
val esp32StartupLibcTime = u32(esp32StartupLibcTimeInitialized)

val esp32StartupBrownoutStorage = nativeInternalSectionU32s([
    int(u32(nativeFunctionAddress(esp32InitializeBrownoutDetector))),
    1
], "abla_esp32_system_init_104_brownout", ".esp_system_init_fn.104")
val esp32StartupBrownoutInitialized = esp32StartupBrownoutStorage
val esp32StartupBrownout = u32(esp32StartupBrownoutInitialized)

val esp32StartupCpuFrequencyStorage = nativeInternalSectionU32s([
    int(u32(nativeFunctionAddress(esp32InitializeCpuFrequencyReport))),
    1
], "abla_esp32_system_init_10_show_cpu_freq", ".esp_system_init_fn.10")
val esp32StartupCpuFrequencyInitialized = esp32StartupCpuFrequencyStorage
val esp32StartupCpuFrequency = u32(esp32StartupCpuFrequencyInitialized)
