import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"
import "../../xtensa/cpu.ab"
import "../dport_esp32.ab"
import "../power/wdt_hal_typed_esp32.ab"
import "../rom/basic_system_esp32.ab"
import "../rom/cache_control_esp32.ab"
import "../rom/serial_output_esp32.ab"

trusted fun esp32SystemResetModulesOnExit():void {
    var uart = u32(0)
    while (uart < u32(3)) {
        var enableBit = u32(0)
        if (uart == u32(0)) enableBit = u32(4)
        else if (uart == u32(1)) enableBit = u32(32)
        else enableBit = u32(0x00800000)

        val heldInReset =
            (esp32DportRead(u32(1072693444)) & enableBit) != u32(0)
        val clockEnabled =
            (esp32DportRead(u32(1072693440)) & enableBit) != u32(0)
        if (!heldInReset && clockEnabled) esp32RomOutputTxWaitIdleValue(uart)
        uart = uart + u32(1)
    }

    val coreReset = u32(1072693456)
    xtensaDeviceStoreU32(coreReset, esp32DportRead(coreReset) | u32(0x7ff))
    xtensaDeviceStoreU32(coreReset, u32(0))

    val peripheralReset = u32(1072693444)
    xtensaDeviceStoreU32(
        peripheralReset,
        esp32DportRead(peripheralReset) | u32(32706935)
    )
    xtensaDeviceStoreU32(peripheralReset, u32(0))

    val cryptoReset = u32(1072693280)
    xtensaDeviceStoreU32(cryptoReset, esp32DportRead(cryptoReset) | u32(23))
    xtensaDeviceStoreU32(cryptoReset, u32(0))
}

trusted fun esp32RestartNoOperatingSystem():void {
    esp32RecoveredXtIntsOff(u32(0xffffffff))

    val contexts = u32(nativeStackAllocate(24))
    val rtcWatchdog = contexts
    val timer0Watchdog = contexts + u32(8)
    val timer1Watchdog = contexts + u32(16)

    esp32WdtHalInit(rtcWatchdog, u32(0), u32(0), u32(0))
    val timeoutTicks = esp32RecoveredRtcClkSlowFreqGetHz()
    esp32WdtHalWriteProtectDisableValue(rtcWatchdog)
    esp32WdtHalConfigStageValue(rtcWatchdog,u32(0),timeoutTicks,u32(3))
    esp32WdtHalConfigStageValue(rtcWatchdog,u32(1),timeoutTicks,u32(4))
    esp32WdtHalSetFlashbootEn(rtcWatchdog,u32(1))

    val core = cpuCoreId()
    val otherCore = if (core == u32(0)) u32(1) else u32(0)
    esp32RomSoftwareResetCpuValue(otherCore)
    esp32RecoveredEspCpuStall(otherCore)
    esp32RecoveredEspIpcIsrStallAbort(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

    ablaUnsafeStoreU32(nativePointerFromAddress(int(timer0Watchdog)), 1)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(timer0Watchdog + u32(4))), 1073082368)
    esp32WdtHalWriteProtectDisableValue(timer0Watchdog)
    esp32WdtHalDisableValue(timer0Watchdog)
    esp32WdtHalWriteProtectEnableValue(timer0Watchdog)

    ablaUnsafeStoreU32(nativePointerFromAddress(int(timer1Watchdog)), 2)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(timer1Watchdog + u32(4))), 1073086464)
    esp32WdtHalWriteProtectDisableValue(timer1Watchdog)
    esp32WdtHalDisableValue(timer1Watchdog)
    esp32WdtHalWriteProtectEnableValue(timer1Watchdog)

    esp32RomCacheReadDisableValue(u32(0))
    esp32RomCacheReadDisableValue(u32(1))

    var signal = u32(0)
    while (signal < u32(6)) {
        xtensaDeviceStoreU32(u32(1072972080) + signal * u32(4), u32(0x30))
        signal = signal + u32(1)
    }

    esp32SystemResetModulesOnExit()
    esp32RecoveredRtcClkCpuSetToDefaultConfig(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    xtensaDeviceStoreU32(u32(1072693304), u32(0))

    if (core == u32(0)) {
        esp32RomSoftwareResetCpuValue(u32(1))
        esp32RomSoftwareResetCpuValue(u32(0))
    } else {
        esp32RomSoftwareResetCpuValue(u32(0))
        esp32RecoveredEspCpuUnstall(u32(0))
        esp32RomSoftwareResetCpuValue(u32(1))
    }
    while (true) {}
}

// Temporary adapters for panic paths which have not yet been structurally rewritten.
trusted fun esp32RecoveredEspSystemResetModulesOnExit(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    esp32SystemResetModulesOnExit()
    a2
}

trusted fun esp32RecoveredEspRestartNoos(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    esp32RestartNoOperatingSystem()
    u32(0)
}
