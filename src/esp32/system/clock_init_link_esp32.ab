import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkClockInitInternals(): bool {
    if (!internalFunction("esp32RecoveredEspRtcInit", "esp_rtc_init")) return false
    if (!internalFunction("esp32RecoveredEspClkInit", "esp_clk_init")) return false
    if (!internalFunction("esp32RecoveredEspPeripClkInit", "esp_perip_clk_init")) return false
    if (!internalFunction("esp32RecoveredRtcClkSelectRtcSlowClk", "rtc_clk_select_rtc_slow_clk")) return false
    true
}
