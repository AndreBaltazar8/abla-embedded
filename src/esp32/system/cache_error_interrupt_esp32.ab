import "../rom/system_esp32.ab"
import "../dport_esp32.ab"

val esp32CacheErrorInterruptSource = u32(25)
val esp32CacheErrorInterruptNumber = u32(68)
val esp32CacheControl1 = u32(0x3ff005a0)
val esp32CacheDebug0 = u32(0x3ff003fc)
val esp32CacheDebug1 = u32(0x3ff00424)

// ESP32 has no additional panic record for cache errors; the exception frame
// and the DPORT debug registers carry all available information.
trusted fun esp32CacheErrorGetPanicInfo(info:u32):void {}

trusted fun esp32CacheErrorInterruptInit():void {
    val cpu = (xtensaReadProcessorId() >>> u32(13)) & u32(1)
    esp32RecoveredEspIntrDisableSource(esp32CacheErrorInterruptSource,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32RomRouteInterruptMatrixValue(cpu, esp32CacheErrorInterruptNumber,
        esp32CacheErrorInterruptSource)
    val enableMask = if (cpu == u32(0)) u32(0x000fc000) else u32(0x0000003f)
    esp32DportUpdate(esp32CacheControl1, u32(0), enableMask)
    esp32RecoveredEspIntrEnableSource(esp32CacheErrorInterruptSource,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}

trusted fun esp32CacheErrorCpuId():u32 {
    if (((esp32DportRead(esp32CacheDebug0) >>> u32(9)) & u32(63)) != u32(0)) {
        return u32(0)
    }
    if (((esp32DportRead(esp32CacheDebug1) >>> u32(9)) & u32(63)) != u32(0)) {
        return u32(1)
    }
    u32(0xffffffff)
}

trusted fun esp32RecoveredEspCacheErrGetPanicInfo(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32CacheErrorGetPanicInfo(a2); a2 }

trusted fun esp32RecoveredEspCacheErrIntInit(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32CacheErrorInterruptInit(); a2 }

trusted fun esp32RecoveredEspCacheErrGetCpuid(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32CacheErrorCpuId()
