import "../rom/system_esp32.ab"
import "abla/unsafe/mmio"

trusted fun esp32IpcIsrPortInit(core: u32): void {
    val source = core + u32(26)
    esp32RecoveredEspIntrDisableSource(u32(28),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32RomRouteInterruptMatrixValue(core, source, u32(28))
    esp32RecoveredEspIntrEnableSource(u32(28),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}

@section(".iram1.abla.esp32IpcIsrPortInterruptTrigger")
trusted fun esp32IpcIsrPortInterruptTrigger(core: u32): void {
    val register = if (core == u32(0)) int(0x3ff000e4) else int(0x3ff000e8)
    mmioStoreU32(register, 1)
}

trusted fun esp32RecoveredEspIpcIsrPortInit(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32IpcIsrPortInit(a2); a2 }
trusted fun esp32RecoveredEspIpcIsrPortIntTrigger(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32IpcIsrPortInterruptTrigger(a2); a2 }
