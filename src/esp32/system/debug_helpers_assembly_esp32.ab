import "abla/unsafe/memory"
import "../../xtensa/assembly.ab"
import "../../xtensa/window_spill_esp32.ab"

// Typed Abla implementation of the initial ESP32 backtrace-frame capture.
// L32E is a register-window operation rather than a normal memory load, so its
// two architectural reads remain explicit target primitives. The call, data
// flow, and all output stores are ordinary Abla and therefore visible to LLVM.
// Original ABI symbol: esp_backtrace_get_start
@section(".iram1")
trusted fun esp32RecoveredEspBacktraceGetStart(
    programCounterAddress: u32,
    stackPointerAddress: u32,
    nextProgramCounterAddress: u32
): void {
    ownedXtensaWindowSpill()

    val ownStackPointer = xtensaStackPointer()
    val programCounter = $xtensa windowLoad(ownStackPointer) {-16}
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(programCounterAddress)),
        int(programCounter)
    )

    val callerStackPointer = $xtensa windowLoad(ownStackPointer) {-12}
    val stackPointer = $xtensa windowLoad(callerStackPointer) {-12}
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(stackPointerAddress)),
        int(stackPointer)
    )

    val nextProgramCounter = $xtensa windowLoad(callerStackPointer) {-16}
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(nextProgramCounterAddress)),
        int(nextProgramCounter)
    )
}
