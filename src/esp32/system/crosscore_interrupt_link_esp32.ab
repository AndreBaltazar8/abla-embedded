import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCrosscoreInterruptInternals(): bool {
    if (!internalFunction("esp32RecoveredEspCrosscoreIntInit", "esp_crosscore_int_init")) return false
    if (!internalFunction("esp32RecoveredEspCrosscoreIntSendYield", "esp_crosscore_int_send_yield")) return false
    if (!internalFunction("esp32RecoveredEspCrosscoreIntSendFreqSwitch", "esp_crosscore_int_send_freq_switch")) return false
    if (!internalFunction("esp32RecoveredEspCrosscoreIntSendGdbCall", "esp_crosscore_int_send_gdb_call")) return false
    if (!internalFunction("esp32RecoveredEspCrosscoreIntSendPrintBacktrace", "esp_crosscore_int_send_print_backtrace")) return false
    if (!internalFunction("esp32RecoveredEspCrosscoreIntSendTwdtAbort", "esp_crosscore_int_send_twdt_abort")) return false
    true
}
