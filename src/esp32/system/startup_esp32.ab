import "../rom/system_esp32.ab"
import "../../runtime/freestanding_integer.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../linker_layout_esp32.ab"
import "../link_data_esp32.ab"
import "../shared_storage_esp32.ab"

// Shared startup state used by the timer and CPU-start modules.
val esp32Data_g_startup_time_4759b0e698Storage = nativeStaticAllocate(8)
val esp32Data_g_startup_time_4759b0e698 = u32(esp32Data_g_startup_time_4759b0e698Storage)

val esp32SystemInitializedStorage = nativeStaticAllocate(2)
val esp32SystemInitialized = u32(esp32SystemInitializedStorage)

val esp32SystemFullyInitializedStorage = nativeStaticAllocate(1)
val esp32SystemFullyInitialized = u32(esp32SystemFullyInitializedStorage)

@inline
trusted fun esp32RunSystemInitializers(priority: u32): void {
    val core = (xtensaReadProcessorId() >>> u32(13)) & u32(1)
    var entry = esp32LinkerSystemInitializersStart
    while (entry < esp32LinkerSystemInitializersEnd) {
        val initializer = u32(ablaUnsafeLoadU32(
            nativePointerFromAddress(int(entry))
        ))
        val coreMask = u32(ablaUnsafeLoadU16(
            nativePointerFromAddress(int(entry + u32(4)))
        ))
        val entryPriority = u32(ablaUnsafeLoadU16(
            nativePointerFromAddress(int(entry + u32(6)))
        ))

        if (entryPriority == priority &&
            (coreMask & (u32(1) << core)) != u32(0)) {
            val result = u32(ablaUnsafeCallI32I32I32I32I32I32I32(
                int(initializer), 0, 0, 0, 0, 0, 0
            ))
            if (result != u32(0)) freestandingAbortValue()
        }
        entry = entry + u32(8)
    }

    xtensaMemoryBarrier()
    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(esp32SystemInitialized + core)),
        1
    )
}

trusted fun esp32WaitForBothCoresInitialized(): void {
    var initialized = false
    while (!initialized) {
        xtensaMemoryBarrier()
        val core0 = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(esp32SystemInitialized))
        ))
        xtensaMemoryBarrier()
        val core1 = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(esp32SystemInitialized + u32(1)))
        ))
        initialized = core0 != u32(0) && core1 != u32(0)
        if (!initialized) esp32RomDelayUsValue(u32(100))
    }
}

trusted fun esp32ResumeOtherCores(): void {
    xtensaMemoryBarrier()
    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(
            esp32Data_Labla_recovered_Esp32CpuStart_data_bss_s_resume_cores_s_resume_cores_359b8f61b1
        )),
        1
    )
    return
}

// Original ABI symbol: start_cpu0
trusted fun esp32RecoveredStartCpu0(): void {
    esp32LinkInterruptTablesInitialize(
        u32(nativeFunctionAddress(esp32RecoveredXtUnhandledInterrupt)),
        u32(nativeFunctionAddress(esp32RecoveredXtUnhandledException))
    )
    esp32RunSystemInitializers(u32(0))
    // Abla module state is the firmware's constructor set. Core-stage system
    // initialization has prepared heap/runtime services, and BSS has long
    // since been cleared, so this is the first universally safe point to run
    // it. nativeInitializeGlobals is once-only and also covers app callbacks.
    nativeInitializeGlobals()
    esp32LinkDataInitialize()
    esp32RecoveredLibcInitArray(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )

    esp32ResumeOtherCores()

    esp32RunSystemInitializers(u32(1))
    esp32WaitForBothCoresInitialized()

    xtensaMemoryBarrier()
    ablaUnsafeStoreU8(nativePointerFromAddress(int(esp32SystemFullyInitialized)), 1)
    esp32StartApplication()
    while (true) {}
}

// Original ABI symbol: start_cpu_other_cores
@section(".iram1.0.abla.esp32RecoveredStartCpuOtherCores")
trusted fun esp32RecoveredStartCpuOtherCores(): void {
    // Every SECONDARY-stage descriptor in the classic-ESP32 firmware graph is
    // core-0-only.  Core 1 therefore has no callback to dispatch: the generic
    // table walk would only touch flash and then write this byte.  Keep that
    // exact result in IRAM so the secondary core can synchronize without an
    // indirect call, a DROM read, or a mutable startup-function table.
    xtensaMemoryBarrier()
    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(esp32SystemInitialized + u32(1))),
        1
    )
    var initialized = false
    while (!initialized) {
        xtensaMemoryBarrier()
        initialized = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(esp32SystemFullyInitialized))
        )) != u32(0)
        if (!initialized) esp32RomDelayUsValue(u32(100))
    }
    esp32StartApplicationOtherCore()
    ablaRuntimeTrap()
}
