import "abla/build"
import "../../runtime/freestanding_integer.ab"
import "abla/runtime/self"
import "abla/unsafe/native"

@inline
trusted fun esp32ErrorCheckCallAddress(returnAddress:u32, functionAddress:u32):u32 =
    ((returnAddress & u32(0x3fffffff)) |
        (functionAddress & u32(0xc0000000))) - u32(3)

trusted fun esp32ErrorCheckPrint(
    message:u32, error:u32, file:u32, line:u32,
    functionName:u32, expression:u32, callAddress:u32
):void {
    esp32RomPrintfArguments(
        u32(nativeStaticBytes("%s failed: esp_err_t 0x%x\x00")),
        message,error,u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    val errorName = esp32CompactErrorName(error)
    esp32RomPrintfArguments(u32(nativeStaticBytes(" (%s)\x00")),
        errorName,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32RomPrintfArguments(u32(nativeStaticBytes(" at 0x%08x\n\x00")),
        callAddress,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    val cacheEnabled = esp32RecoveredSpiFlashCacheEnabled(u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (cacheEnabled != u32(0)) {
        esp32RomPrintfArguments(u32(nativeStaticBytes("file: \"%s\" line %d\nfunc: %s\nexpression: %s\n\x00")),
            file,line,functionName,expression,u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    }
}

trusted fun esp32ErrorCheckFailedWithoutAbort(
    error:u32, file:u32, line:u32, functionName:u32, expression:u32
):void {
    val callAddress = esp32ErrorCheckCallAddress(xtensaReturnAddress(),
        u32(nativeFunctionAddress(esp32ErrorCheckFailedWithoutAbort)))
    esp32ErrorCheckPrint(u32(nativeStaticBytes("ESP_ERROR_CHECK_WITHOUT_ABORT\x00")),
        error,file,line,functionName,expression,callAddress)
}

trusted fun esp32ErrorCheckFailed(
    error:u32, file:u32, line:u32, functionName:u32, expression:u32
):void {
    val callAddress = esp32ErrorCheckCallAddress(xtensaReturnAddress(),
        u32(nativeFunctionAddress(esp32ErrorCheckFailed)))
    esp32ErrorCheckPrint(u32(nativeStaticBytes("ESP_ERROR_CHECK\x00")),
        error,file,line,functionName,expression,callAddress)
    freestandingAbort()
}

trusted fun esp32RecoveredEspErrorCheckFailedWithoutAbort(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32ErrorCheckFailedWithoutAbort(a2,a3,a4,a5,a6); a2 }

trusted fun esp32RecoveredEspErrorCheckFailed(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32ErrorCheckFailed(a2,a3,a4,a5,a6); a2 }
