import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkIpcIsrPortInternals(): bool {
    if (!internalFunction("esp32IpcIsrPortInit", "esp_ipc_isr_port_init")) return false
    if (!internalFunction("esp32IpcIsrPortInterruptTrigger", "esp_ipc_isr_port_int_trigger")) return false
    true
}
