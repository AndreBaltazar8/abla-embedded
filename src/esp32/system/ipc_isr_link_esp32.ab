import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkIpcIsrInternals(): bool {
    if (!internalFunction("esp32RecoveredEspIpcIsrInit", "esp_ipc_isr_init")) return false
    if (!internalFunction("esp32RecoveredEspIpcIsrCall", "esp_ipc_isr_call")) return false
    if (!internalFunction("esp32RecoveredEspIpcIsrCallBlocking", "esp_ipc_isr_call_blocking")) return false
    if (!internalFunction("esp32RecoveredEspIpcIsrStallOtherCpu", "esp_ipc_isr_stall_other_cpu")) return false
    if (!internalFunction("esp32RecoveredEspIpcIsrReleaseOtherCpu", "esp_ipc_isr_release_other_cpu")) return false
    if (!internalFunction("esp32RecoveredEspIpcIsrStallPause", "esp_ipc_isr_stall_pause")) return false
    if (!internalFunction("esp32RecoveredEspIpcIsrStallAbort", "esp_ipc_isr_stall_abort")) return false
    if (!internalFunction("esp32RecoveredEspIpcIsrStallResume", "esp_ipc_isr_stall_resume")) return false
    true
}
