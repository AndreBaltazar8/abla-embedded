import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTaskWatchdogTimergroupInternals(): bool {
    if (!internalFunction("esp32RecoveredEspTaskWdtImplTimerAllocate", "esp_task_wdt_impl_timer_allocate")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtImplTimerReconfigure", "esp_task_wdt_impl_timer_reconfigure")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtImplTimerFree", "esp_task_wdt_impl_timer_free")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtImplTimerFeed", "esp_task_wdt_impl_timer_feed")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtImplTimeoutTriggered", "esp_task_wdt_impl_timeout_triggered")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtImplTimerStop", "esp_task_wdt_impl_timer_stop")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtImplTimerRestart", "esp_task_wdt_impl_timer_restart")) return false
    true
}
