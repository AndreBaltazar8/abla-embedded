import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkFreertosHooksInternals(): bool {
    if (!internalFunction("esp32RecoveredEspVApplicationTickHook", "esp_vApplicationTickHook")) return false
    if (!exportFunction("esp32RecoveredEspVApplicationIdleHook", "esp_vApplicationIdleHook")) return false
    if (!exportFunction("esp32RecoveredEspRegisterFreertosIdleHookForCpu", "esp_register_freertos_idle_hook_for_cpu")) return false
    if (!internalFunction("esp32RecoveredEspRegisterFreertosIdleHook", "esp_register_freertos_idle_hook")) return false
    if (!exportFunction("esp32RecoveredEspRegisterFreertosTickHookForCpu", "esp_register_freertos_tick_hook_for_cpu")) return false
    if (!internalFunction("esp32RecoveredEspRegisterFreertosTickHook", "esp_register_freertos_tick_hook")) return false
    if (!exportFunction("esp32RecoveredEspDeregisterFreertosIdleHookForCpu", "esp_deregister_freertos_idle_hook_for_cpu")) return false
    if (!internalFunction("esp32RecoveredEspDeregisterFreertosIdleHook", "esp_deregister_freertos_idle_hook")) return false
    if (!internalFunction("esp32RecoveredEspDeregisterFreertosTickHookForCpu", "esp_deregister_freertos_tick_hook_for_cpu")) return false
    if (!internalFunction("esp32RecoveredEspDeregisterFreertosTickHook", "esp_deregister_freertos_tick_hook")) return false
    true
}
