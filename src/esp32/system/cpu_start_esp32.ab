trusted fun esp32CallStartCpu0(): void {
    val frame = u32(nativeStackAllocate(48))

    xtensaWriteVectorBase(esp32LinkerVectorTable)

    val cpu0ResetReason = esp32RomGetResetReason(u32(0))
    val cpu1ResetReason = esp32RomGetResetReason(u32(1))
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(frame)), int(cpu0ResetReason)
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(frame + u32(4))),
        int(cpu1ResetReason)
    )
    freestandingSet(
        esp32LinkerBssStart,
        i32(0),
        esp32LinkerBssEnd - esp32LinkerBssStart
    )
    if (cpu0ResetReason != u32(5)) {
        freestandingSet(
            esp32LinkerRtcBssStart,
            i32(0),
            esp32LinkerRtcBssEnd - esp32LinkerRtcBssStart
        )
    }
    val watchdog = frame + u32(28)
