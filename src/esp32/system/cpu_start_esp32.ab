    esp32WdtHalWriteProtectDisable(watchdog)
    esp32WdtHalDisable(watchdog)
    esp32WdtHalWriteProtectEnable(watchdog)
    xtensaWriteThreadPointer(
        esp32Data_Labla_recovered_Esp32CpuStart_data_bss_s_errno_array_1_s_errno_array_1_1911c0be8b
    )
    esp32ConfigureMulticoreCaches()

    val cacheContext = frame + u32(8)
    freestandingSet(cacheContext, i32(0), u32(12))
    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(cacheContext)), int(u32(2))
    )
    esp32CacheHalInit()

    val mmuContext = frame + u32(20)
    freestandingSet(mmuContext, i32(0), u32(8))
    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(mmuContext)), int(u32(2))
    )
    esp32MmuHalCtxInit(mmuContext)

    esp32Internal_Labla_recovered_Esp32CpuStart_local_sys_rtc_init_54a5ad1778(
        frame, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    esp32Internal_Labla_recovered_Esp32CpuStart_local_mspi_init_70e245c255(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    // Interrupts can be restored by early system services, so publish safe
    // handlers before any such service can expose a pending hardware line.
    esp32XtensaContextStorageInitialize()
    esp32FreertosPortStorageInitialize()
    esp32LinkInterruptTablesInitialize(
        u32(nativeFunctionAddress(esp32RecoveredXtUnhandledInterrupt)),
        u32(nativeFunctionAddress(esp32RecoveredXtUnhandledException))
    )
    esp32SystemEarlyInit(frame)

    // This is ESP-IDF's start_cpu0 constructor sequence in the same visible
    // boot function. Keeping nativeInitializeGlobals here makes the actual
    // ownership/order explicit to the compiler: no lazy guard may run before
    // BSS and hardware initialization, while Abla module state is ready before
    // secondary-stage services and the application task are started.
    esp32RunSystemInitializers(u32(0))
    nativeInitializeGlobals()
    // Shared objects are consumed through raw addresses, so their initializer
    // result alone cannot keep these stores live. Run it after Abla module
    // state is available and before any application peripheral can use them.
    esp32LinkDataInitialize()
    esp32LibcRunInitializers()
    esp32ResumeOtherCores()

    // The monolithic Abla image owns this initializer, so call its typed entry
    // directly.  This removes the generic function-pointer ABI and lets LLVM
    // optimize the timer task, allocator, and startup path as one call graph.
    if (esp32TimerInitializeOs() != u32(0)) freestandingAbortValue()
    esp32RunSystemInitializers(u32(1))
    esp32WaitForBothCoresInitialized()
    xtensaMemoryBarrier()
    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(esp32SystemFullyInitialized)), 1
