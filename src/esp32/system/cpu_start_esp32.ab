    var source = u32(0)
    while (source <= u32(68)) {
        esp32RomRouteInterruptMatrixValue(core, source, u32(6))
        source = source + u32(1)
    }
    return
}

trusted fun esp32RestoreAppMmuFromProMmu(): void {
    var entry = u32(0)
    var proAddress = u32(1072758784)
    var appAddress = u32(1072766976)
    while (entry <= u32(2047)) {
        xtensaDeviceStoreU32(appAddress, xtensaDeviceLoadU32(proAddress))
        entry = entry + u32(1)
        proAddress = proAddress + u32(4)
        appAddress = appAddress + u32(4)
    }
    return
}

@inline
fun esp32EnabledCacheBusMask(control: u32): u32 {
    var enabled = u32(0)
    if ((control & u32(1)) == u32(0)) enabled = enabled | u32(1)
    if ((control & u32(2)) == u32(0)) enabled = enabled | u32(2)
    if ((control & u32(4)) == u32(0)) enabled = enabled | u32(4)
    if ((control & u32(16)) == u32(0)) enabled = enabled | u32(8)
    if ((control & u32(8)) == u32(0)) enabled = enabled | u32(16)
    enabled
}

trusted fun esp32ConfigureMulticoreCaches(): void {
    val appCpuDisabled = (xtensaDeviceLoadU32(u32(0x3ff5a00c)) & u32(1)) != u32(0)
    val appCacheControl = u32(0x3ff0005c)
    if (!appCpuDisabled) {
        esp32RomCacheReadDisableValue(u32(1))
        esp32RomCacheFlushValue(u32(1))
        esp32DportUpdate(appCacheControl, u32(0), u32(8192))
        esp32RomMmuInit(u32(1))
        esp32DportUpdate(appCacheControl, u32(8192), u32(0))
    }

    esp32RestoreAppMmuFromProMmu()

    val proCacheControl = esp32DportRead(u32(0x3ff00044))
    val enabledBusMask = esp32EnabledCacheBusMask(proCacheControl)
    val appDisableMask = (enabledBusMask & u32(7)) |
        ((enabledBusMask << u32(1)) & u32(16)) |
        ((enabledBusMask >>> u32(1)) & u32(8))
    esp32DportUpdate(appCacheControl, appDisableMask, u32(0))
    return
}

