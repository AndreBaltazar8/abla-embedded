import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTaskWatchdogInternals(): bool {
    if (!internalFunction("esp32RecoveredTaskWdtTimeoutAbort", "task_wdt_timeout_abort")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtStop", "esp_task_wdt_stop")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtRestart", "esp_task_wdt_restart")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtAdd", "esp_task_wdt_add")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtInit", "esp_task_wdt_init")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtAddUser", "esp_task_wdt_add_user")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtReset", "esp_task_wdt_reset")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtResetUser", "esp_task_wdt_reset_user")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtDelete", "esp_task_wdt_delete")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtReconfigure", "esp_task_wdt_reconfigure")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtDeinit", "esp_task_wdt_deinit")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtDeleteUser", "esp_task_wdt_delete_user")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtStatus", "esp_task_wdt_status")) return false
    if (!internalFunction("esp32RecoveredEspTaskWdtPrintTriggeredTasks", "esp_task_wdt_print_triggered_tasks")) return false
    true
}
