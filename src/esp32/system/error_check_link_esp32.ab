import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkErrorCheckInternals(): bool {
    if (!internalFunction("esp32ErrorCheckFailedWithoutAbort", "_esp_error_check_failed_without_abort")) return false
    if (!internalFunction("esp32ErrorCheckFailed", "_esp_error_check_failed")) return false
    true
}
