import "../../runtime/freestanding_integer.ab"
import "../../xtensa/assembly.ab"
import "abla/unsafe/memory"

// Freestanding ESP32 assertion reporting.  Formatting and C-string traversal
// are ordinary Abla; only volatile UART MMIO and the terminal illegal-
// instruction trap remain target operations.

@inline
trusted fun esp32AssertWriteCharacter(character: u32): void {
    val uart0 = u32(1072955392)
    var status = xtensaDeviceLoadU32(uart0 + u32(28))
    while ((status & u32(8388608)) != u32(0)) {
        status = xtensaDeviceLoadU32(uart0 + u32(28))
    }
    xtensaDeviceStoreU32(uart0, character & u32(255))
}

trusted fun esp32AssertWriteCString(address: u32): void {
    if (address == u32(0)) return
    var cursor = address
    var character = u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(cursor))
    ))
    while (character != u32(0)) {
        esp32AssertWriteCharacter(character)
        cursor = cursor + u32(1)
        character = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(cursor))
        ))
    }
}

trusted fun esp32AssertWriteUnsigned(value: u32): void {
    var divisor = u32(1)
    while (divisor <= u32(100000000) && value / divisor >= u32(10)) {
        divisor = divisor * u32(10)
    }
    while (divisor != u32(0)) {
        val quotient = value / divisor
        val digit = quotient - (quotient / u32(10)) * u32(10)
        esp32AssertWriteCharacter(u32(48) + digit)
        divisor = divisor / u32(10)
    }
}

@inline
trusted fun esp32AssertWritePrefix(): void {
    esp32AssertWriteCharacter(u32(97))  // a
    esp32AssertWriteCharacter(u32(115)) // s
    esp32AssertWriteCharacter(u32(115)) // s
    esp32AssertWriteCharacter(u32(101)) // e
    esp32AssertWriteCharacter(u32(114)) // r
    esp32AssertWriteCharacter(u32(116)) // t
    esp32AssertWriteCharacter(u32(105)) // i
    esp32AssertWriteCharacter(u32(111)) // o
    esp32AssertWriteCharacter(u32(110)) // n
    esp32AssertWriteCharacter(u32(32))
}

@inline
trusted fun esp32AssertWriteFailed(): void {
    esp32AssertWriteCharacter(u32(32))
    esp32AssertWriteCharacter(u32(102)) // f
    esp32AssertWriteCharacter(u32(97))  // a
    esp32AssertWriteCharacter(u32(105)) // i
    esp32AssertWriteCharacter(u32(108)) // l
    esp32AssertWriteCharacter(u32(101)) // e
    esp32AssertWriteCharacter(u32(100)) // d
    esp32AssertWriteCharacter(u32(58))
    esp32AssertWriteCharacter(u32(32))
}

@inline
trusted fun esp32AssertWriteLineLabel(): void {
    esp32AssertWriteCharacter(u32(58))
    esp32AssertWriteCharacter(u32(32))
    esp32AssertWriteCharacter(u32(108)) // l
    esp32AssertWriteCharacter(u32(105)) // i
    esp32AssertWriteCharacter(u32(110)) // n
    esp32AssertWriteCharacter(u32(101)) // e
    esp32AssertWriteCharacter(u32(32))
}

@inline
trusted fun esp32AssertWriteFunctionLabel(): void {
    esp32AssertWriteCharacter(u32(58))
    esp32AssertWriteCharacter(u32(32))
    esp32AssertWriteCharacter(u32(102)) // f
    esp32AssertWriteCharacter(u32(117)) // u
    esp32AssertWriteCharacter(u32(110)) // n
    esp32AssertWriteCharacter(u32(99))  // c
    esp32AssertWriteCharacter(u32(116)) // t
    esp32AssertWriteCharacter(u32(105)) // i
    esp32AssertWriteCharacter(u32(111)) // o
    esp32AssertWriteCharacter(u32(110)) // n
    esp32AssertWriteCharacter(u32(32))
}

trusted fun esp32AssertFailed(
    fileAddress: u32,
    line: u32,
    functionAddress: u32,
    expressionAddress: u32
): u32 {
    esp32AssertWritePrefix()
    esp32AssertWriteCString(expressionAddress)
    esp32AssertWriteFailed()
    esp32AssertWriteCString(fileAddress)
    esp32AssertWriteLineLabel()
    esp32AssertWriteUnsigned(line)
    esp32AssertWriteFunctionLabel()
    esp32AssertWriteCString(functionAddress)
    esp32AssertWriteCharacter(u32(10))
    freestandingAbortValue()
}
