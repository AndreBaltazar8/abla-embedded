import "abla/unsafe/memory"
import "../../xtensa/assembly.ab"
import "interrupt_watchdog_esp32.ab"

// Abla/LLVM implementation of the Xtensa level-4 interrupt dispatcher for IPC and interrupt-watchdog panic handling.

@section(".iram1")
trusted fun esp32HighInterrupt4PanicReason(): u32 {
    val watchdogInterrupt =
        (xtensaReadPendingInterruptRegister() >> u32(25)) & u32(1)
    if (watchdogInterrupt != u32(0)) {
        val enabled = xtensaReadInterruptEnableRegister()
        xtensaWriteInterruptEnableRegister(enabled & u32(4261412863))
        return u32(7)
    }

    val otherCoreTicked = u32(ablaUnsafeVolatileLoadU32(
        int(esp32InterruptWatchdogCpu1Ticked)
    ))
    if (otherCoreTicked == u32(0)) return u32(6)
    u32(5)
}

// Original ABI symbol: xt_highint4
@naked
@section(".iram1")
trusted fun esp32RecoveredXtHighint4(): void =
    $xtensa highInterruptDispatch {
        4,
        28,
        esp_ipc_isr_handler,
        _xt_context_save,
        abla_esp32_highint4_panic_reason,
        panicHandler,
        _xt_context_restore,
        262181
    }
