import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkUbsanInternals(): bool {
    if (!internalFunction("esp32RecoveredUbsanHandleTypeMismatch", "__ubsan_handle_type_mismatch")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleTypeMismatchV1", "__ubsan_handle_type_mismatch_v1")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleAddOverflow", "__ubsan_handle_add_overflow")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleSubOverflow", "__ubsan_handle_sub_overflow")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleMulOverflow", "__ubsan_handle_mul_overflow")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleNegateOverflow", "__ubsan_handle_negate_overflow")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleDivremOverflow", "__ubsan_handle_divrem_overflow")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleShiftOutOfBounds", "__ubsan_handle_shift_out_of_bounds")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleOutOfBounds", "__ubsan_handle_out_of_bounds")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleMissingReturn", "__ubsan_handle_missing_return")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleVlaBoundNotPositive", "__ubsan_handle_vla_bound_not_positive")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleLoadInvalidValue", "__ubsan_handle_load_invalid_value")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleNonnullArg", "__ubsan_handle_nonnull_arg")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleNonnullReturn", "__ubsan_handle_nonnull_return")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleBuiltinUnreachable", "__ubsan_handle_builtin_unreachable")) return false
    if (!internalFunction("esp32RecoveredUbsanHandlePointerOverflow", "__ubsan_handle_pointer_overflow")) return false
    if (!internalFunction("esp32RecoveredUbsanHandleInvalidBuiltin", "__ubsan_handle_invalid_builtin")) return false
    if (!internalFunction("esp32RecoveredUbsanInclude", "__ubsan_include")) return false
    true
}
