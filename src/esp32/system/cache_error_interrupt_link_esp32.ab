import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCacheErrorInterruptInternals(): bool {
    if (!internalFunction("esp32CacheErrorGetPanicInfo", "esp_cache_err_get_panic_info")) return false
    if (!internalFunction("esp32CacheErrorInterruptInit", "esp_cache_err_int_init")) return false
    if (!internalFunction("esp32CacheErrorCpuId", "esp_cache_err_get_cpuid")) return false
    true
}
