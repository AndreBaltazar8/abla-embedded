import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkInterruptWatchdogInternals(): bool {
    if (!internalFunction("esp32InterruptWatchdogInitialize", "esp_int_wdt_init")) return false
    if (!internalFunction("esp32InterruptWatchdogInitializeCurrentCpu", "esp_int_wdt_cpu_init")) return false
    true
}
