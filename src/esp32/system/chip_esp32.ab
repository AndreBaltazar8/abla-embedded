import "../../xtensa/assembly.ab"
import "../../xtensa/cpu.ab"
import "../clock/rtc_esp32.ab"
import "../cpu/control_esp32.ab"
import "../heap/capabilities_telemetry_esp32.ab"
import "../rom/basic_system_esp32.ab"
import "../rom/serial_output_esp32.ab"
import "../xtensa/interrupt_assembly_esp32.ab"
import "./panic_esp32.ab"

// Abla/LLVM implementation of ESP32 digital restart, heap telemetry, IDF
// version identity, and panic-abort dispatch.

// Original ABI symbol: esp_restart_noos_dig
// All scalar and device behavior stays visible to LLVM. The target subparser
// is needed only for the core-id register and the terminal unreachable loop.
trusted fun esp32RecoveredEspRestartNoosDig(): void {
    val ignoredInterruptMask = esp32RecoveredXtIntsOff(u32(4294967295))
    esp32RomOutputTxWaitIdle(u32(0))

    // ESP32's memory-SPI synchronization hook is intentionally empty, so the
    // monolithic graph need not read RTC_XTAL_FREQ_REG merely to feed it two
    // ignored arguments.
    esp32RecoveredRtcClkCpuSetToDefaultConfig(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )

    val currentCore = cpuCoreId()
    esp32RecoveredEspCpuUnstall(currentCore ^ u32(1))

    esp32RomSoftwareResetSystem()
    xtensaTrapForever()
}

// Original ABI symbol: esp_get_free_heap_size
trusted fun esp32RecoveredEspGetFreeHeapSize(): u32 =
    esp32HeapCapsGetFreeSize(u32(4096))

// Original ABI symbol: esp_get_free_internal_heap_size
trusted fun esp32RecoveredEspGetFreeInternalHeapSize(): u32 =
    esp32HeapCapsGetFreeSize(u32(2060))

// Original ABI symbol: esp_get_minimum_free_heap_size
trusted fun esp32RecoveredEspGetMinimumFreeHeapSize(): u32 =
    esp32HeapCapsGetMinimumFreeSize(u32(4096))

// Original ABI symbol: esp_get_idf_version
trusted fun esp32RecoveredEspGetIdfVersion(): u32 = u32(
    nativeCStringAddress("v6.0")
)

// Original ABI symbol: esp_system_abort.
trusted fun esp32RecoveredEspSystemAbort(reason: u32): void =
    esp32RecoveredPanicAbort(reason)
