import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkIpcIsrRoutinesInternals(): bool {
    if (!internalFunction("esp32IpcIsrWaitingForFinishCommand", "esp_ipc_isr_waiting_for_finish_cmd")) return false
    true
}
