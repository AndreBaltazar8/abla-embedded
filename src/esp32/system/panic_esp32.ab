// Original ABI symbol: panic_print_char
@noinline
trusted fun esp32RecoveredPanicPrintChar(character: u32): void {
    val uart0 = u32(0x3ff40000)
    while (((xtensaDeviceLoadU32(uart0 + u32(28)) >>> u32(16)) &
        u32(255)) == u32(128)) {}
    xtensaDeviceStoreU32(uart0, character & u32(255))
}

// Original ABI symbol: panic_print_str
trusted fun esp32RecoveredPanicPrintStr(text: u32): void {
    var index = u32(0)
    var character = esp32PanicLoadU8(text)
    while (character != u32(0)) {
        esp32RecoveredPanicPrintChar(character)
        index = index + u32(1)
        character = esp32PanicLoadU8(text + index)
    }
}

// Original ABI symbol: panic_print_hex
trusted fun esp32RecoveredPanicPrintHex(value: u32): void {
    var remaining = value
    var digitIndex = u32(0)
    while (digitIndex < u32(8)) {
        val digit = (remaining >>> u32(28)) & u32(15)
        esp32RecoveredPanicPrintChar(
            if (digit < u32(10)) digit + u32(48) else digit + u32(87)
        )
        remaining = remaining << u32(4)
        digitIndex = digitIndex + u32(1)
    }
}

// Original ABI symbol: panic_print_dec
trusted fun esp32RecoveredPanicPrintDec(value: u32): void {
    val tens = value / u32(10)
    val ones = value - tens * u32(10)
    esp32RecoveredPanicPrintChar(
        if (tens == u32(0)) u32(32) else tens + u32(48)
    )
    esp32RecoveredPanicPrintChar(ones + u32(48))
}

trusted fun esp32RecoveredPanicPrintStrValue(text: u32): u32 {
    esp32RecoveredPanicPrintStr(text)
    u32(0)
}

trusted fun esp32RecoveredPanicPrintHexValue(value: u32): u32 {
    esp32RecoveredPanicPrintHex(value)
    u32(0)
}

trusted fun esp32RecoveredPanicPrintDecValue(value: u32): u32 {
    esp32RecoveredPanicPrintDec(value)
    u32(0)
}

trusted fun esp32PanicPrintAbortDetails(frame: u32): void =
    esp32RecoveredPanicPrintStr(
        esp32PanicLoadU32(esp32PanicAbortDetailsAddress())
    )

@inline
trusted fun esp32PanicInitializeWdtContext(
    context: u32,
    instance: u32,
    base: u32
): void {
    esp32WdtContextStore(context, u32(0), instance)
    esp32WdtContextStore(context, u32(4), base)
}

@inline
trusted fun esp32PanicDisableWdt(context: u32): void {
    esp32WdtHalWriteProtectDisable(context)
    esp32WdtHalDisable(context)
    esp32WdtHalWriteProtectEnable(context)
}

@inline
trusted fun esp32PanicFeedWdtIfEnabled(context: u32): void {
    if (esp32WdtHalIsEnabled(context) != u32(0)) {
        esp32WdtHalWriteProtectDisable(context)
        esp32WdtHalFeed(context)
        esp32WdtHalWriteProtectEnable(context)
    }
}

// Original ABI symbol: esp_panic_handler_disable_timg_wdts
trusted fun esp32RecoveredEspPanicHandlerDisableTimgWdts(): void {
    val context = u32(nativeStackAllocate(8))
    esp32PanicInitializeWdtContext(
        context, u32(1), u32(0x3ff5f000)
    )
    esp32PanicDisableWdt(context)
    esp32PanicInitializeWdtContext(
        context, u32(2), u32(0x3ff60000)
    )
    esp32PanicDisableWdt(context)
}

// Original ABI symbol: esp_panic_handler_enable_rtc_wdt
trusted fun esp32RecoveredEspPanicHandlerEnableRtcWdt(
    timeoutMilliseconds: u32
): void {
    val context = u32(nativeStackAllocate(8))
    esp32WdtHalInit(context, u32(0), u32(0), u32(0))
    val timeoutTicks = u32(
        (u64(timeoutMilliseconds) *
            u64(esp32RecoveredRtcClkSlowFreqGetHz())) / u64(1000)
    )
    esp32WdtHalWriteProtectDisable(context)
    esp32WdtHalConfigStage(context, u32(0), timeoutTicks, u32(4))
    esp32WdtHalEnable(context)
    esp32WdtHalWriteProtectEnable(context)
}

// Original ABI symbol: esp_panic_handler_feed_wdts
trusted fun esp32RecoveredEspPanicHandlerFeedWdts(): void {
    val core = cpuCoreId()
    if (esp32PanicLoadU32(
        esp32PanicEntryCountAddress() + core * u32(4)
    ) > u32(2)) return

    val context = u32(nativeStackAllocate(8))
    esp32PanicInitializeWdtContext(
        context, u32(1), u32(0x3ff5f000)
    )
    esp32PanicFeedWdtIfEnabled(context)
    esp32PanicInitializeWdtContext(
        context, u32(2), u32(0x3ff60000)
    )
    esp32PanicFeedWdtIfEnabled(context)
    esp32PanicFeedWdtIfEnabled(esp32PanicRtcWdtContextAddress())
}

trusted fun esp32PanicDisableAllWdts(): void {
    esp32RecoveredEspPanicHandlerDisableTimgWdts()
    esp32PanicDisableWdt(esp32PanicRtcWdtContextAddress())
}

// Original ABI symbol: esp_panic_handler_reset_modules_on_exit_and_halt
@section(".iram1.abla.esp32RecoveredEspPanicHandlerResetModulesOnExitAndHalt")
trusted fun esp32RecoveredEspPanicHandlerResetModulesOnExitAndHalt(): void {
    esp32RecoveredEspSystemResetModulesOnExit(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    while (true) {}
}

// Original ABI symbol: esp_panic_handler_increment_entry_count
trusted fun esp32RecoveredEspPanicHandlerIncrementEntryCount(): void {
    val core = cpuCoreId()
    val countAddress = esp32PanicEntryCountAddress() + core * u32(4)
    val count = esp32PanicLoadU32(countAddress) + u32(1)
    esp32PanicStoreU32(countAddress, count)
    if (count > u32(2)) {
        esp32RecoveredPanicPrintStr(esp32PanicReenteredText())
        esp32RecoveredPanicRestart(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    }
}

// Original ABI symbol: panic_abort
trusted fun esp32RecoveredPanicAbort(reason: u32): void {
    esp32PanicStoreU8(esp32PanicAbortFlagAddress(), u32(1))
    esp32PanicStoreU32(esp32PanicAbortDetailsAddress(), reason)
    xtensaTrapForever()
}

// Internal implementation of the ESP32 RTC reset-reason hint format. The
// value is repeated in both halfwords and marked with bit 31.
trusted fun esp32RecoveredEspResetReasonSetHint(hint: u32): void {
    val value = (hint & u32(0x7fff)) |
        ((hint & u32(0x7fff)) << u32(16)) | u32(0x80000000)
    xtensaDeviceStoreU32(u32(0x3ff480b8), value)
}

trusted fun esp32RecoveredEspResetReasonGetHint(): u32 {
    val encoded = xtensaDeviceLoadU32(u32(0x3ff480b8))
    val low = encoded & u32(0x7fff)
    val high = (encoded >>> u32(16)) & u32(0x7fff)
    if ((encoded & u32(0x80000000)) == u32(0) || high != low) {
        return u32(0)
    }
    return low
}

trusted fun esp32PanicStringLength(text: u32): u32 {
    var length = u32(0)
    while (esp32PanicLoadU8(text + length) != u32(0)) {
        length = length + u32(1)
    }
    return length
}

@inline
trusted fun esp32PanicDebuggerAttached(): bool =
    (xtensaExternalRegisterRead(u32(0x10200c)) & u32(1)) != u32(0)

@inline
trusted fun esp32PanicDump(info: u32, functionOffset: u32): void {
    val callback = esp32PanicInfoLoad(info, functionOffset)
    if (callback != u32(0)) ablaUnsafeCallVoidI32(
        int(callback),
        int(esp32PanicInfoLoad(info, u32(28)))
    )
}

// Original ABI symbol: esp_panic_handler
trusted fun esp32RecoveredEspPanicHandler(info: u32): void {
    esp32RecoveredEspPanicHandlerFeedWdts()

    if (esp32PanicLoadU8(esp32PanicAbortFlagAddress()) != u32(0)) {
        val abortDetails = esp32PanicLoadU32(
            esp32PanicAbortDetailsAddress()
        )
        esp32PanicInfoStore(info, u32(12), u32(0))
        esp32PanicInfoStore(
            info,
            u32(16),
            if (abortDetails != u32(0))
                u32(nativeFunctionAddress(esp32PanicPrintAbortDetails))
            else u32(0)
        )
        esp32PanicInfoStore(info, u32(8), u32(0))
        esp32PanicInfoStore(info, u32(4), u32(3))
    }

    val reason = esp32PanicInfoLoad(info, u32(8))
    if (reason != u32(0)) {
        esp32RecoveredPanicPrintStr(esp32PanicGuruText())
        esp32RecoveredPanicPrintDec(esp32PanicInfoLoad(info, u32(0)))
        esp32RecoveredPanicPrintStr(esp32PanicReasonPrefixText())
        esp32RecoveredPanicPrintStr(reason)
        esp32RecoveredPanicPrintStr(esp32PanicReasonSuffixText())
    }

    val description = esp32PanicInfoLoad(info, u32(12))
    if (description != u32(0)) {
        esp32RecoveredPanicPrintStr(description)
    }

    esp32RecoveredPanicPrintStr(esp32PanicNewlineText())
    esp32PanicDump(info, u32(16))
    esp32RecoveredPanicPrintStr(esp32PanicNewlineText())

    if (esp32PanicDebuggerAttached()) {
        var debuggerReason = u32(0)
        if (esp32PanicLoadU8(info + u32(32)) != u32(0)) {
            debuggerReason = esp32PanicInfoLoad(info, u32(8))
        } else if (esp32PanicLoadU8(
            esp32PanicAbortFlagAddress()
        ) != u32(0)) {
            debuggerReason = esp32PanicLoadU32(
                esp32PanicAbortDetailsAddress()
            )
        }

        if (debuggerReason != u32(0)) {
            val arguments = nativeStackAllocate(8)
            ablaUnsafeStoreU32(
                nativePointerFromAddress(arguments),
                int(debuggerReason)
            )
            ablaUnsafeStoreU32(
                nativePointerFromAddress(arguments + 4),
                int(esp32PanicStringLength(debuggerReason))
            )
            xtensaSemihosting(u32(0x116), u32(arguments))
        }

        esp32RecoveredPanicPrintStr(esp32PanicBreakpointPrefixText())
        val address = esp32PanicInfoLoad(info, u32(24))
        esp32RecoveredPanicPrintHex(address)
        esp32RecoveredPanicPrintStr(esp32PanicBreakpointSuffixText())
        esp32PanicDisableAllWdts()
        esp32RecoveredEspCpuSetBreakpoint(u32(0), address)
        return
    }

    esp32RecoveredEspPanicHandlerFeedWdts()
    esp32PanicDump(info, u32(20))
    esp32RecoveredPanicPrintStr(esp32PanicNewlineText())
    esp32RecoveredPanicClearActiveInterrupts(
        esp32PanicInfoLoad(info, u32(28))
    )
    esp32PanicStoreU8(esp32PanicAbortFlagAddress(), u32(0))

    esp32RecoveredPanicPrintStr(esp32PanicShaPrefixText())
    esp32RecoveredPanicPrintStr(esp32AppElfSha256Text)
    esp32RecoveredPanicPrintStr(esp32PanicNewlineText())
    esp32RecoveredPanicPrintStr(esp32PanicNewlineText())

    esp32RecoveredEspPanicHandlerFeedWdts()
    if (esp32RecoveredEspResetReasonGetHint() == u32(0)) {
        val exception = esp32PanicInfoLoad(info, u32(4))
        esp32RecoveredEspResetReasonSetHint(
            if (exception == u32(1)) u32(5)
            else if (exception == u32(2)) u32(6)
            else u32(4)
        )
    }

    esp32RecoveredPanicPrintStr(esp32PanicRebootingText())
    esp32RecoveredPanicRestart(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

