import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkIpcIsrHandlerInternals(): bool {
    if (!internalFunction(
        "esp32IpcIsrPrepare",
        "abla_esp32_ipc_isr_prepare"
    )) return false
    if (!internalFunction("esp32RecoveredEspIpcIsrHandler", "esp_ipc_isr_handler")) return false
    true
}
