import "abla/build"

// Exact names used by recovered assembly and mixed callers. The panic handler
// and libc diagnostics are the only remaining foreign callers; telemetry and
// version queries stay internal to the monolithic Abla graph.
compile fun esp32Idf6LinkSystemChipInternals(): bool {
    if (!exportFunction("esp32RecoveredEspRestartNoosDig", "esp_restart_noos_dig")) return false
    if (!internalFunction("esp32RecoveredEspGetFreeHeapSize", "esp_get_free_heap_size")) return false
    if (!internalFunction("esp32RecoveredEspGetFreeInternalHeapSize", "esp_get_free_internal_heap_size")) return false
    if (!internalFunction("esp32RecoveredEspGetMinimumFreeHeapSize", "esp_get_minimum_free_heap_size")) return false
    if (!internalFunction("esp32RecoveredEspGetIdfVersion", "esp_get_idf_version")) return false
    if (!exportFunction("esp32RecoveredEspSystemAbort", "esp_system_abort")) return false
    true
}
