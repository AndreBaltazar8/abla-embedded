import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkInternalRestartInternals(): bool {
    if (!internalFunction("esp32SystemResetModulesOnExit", "esp_system_reset_modules_on_exit")) return false
    if (!internalFunction("esp32RestartNoOperatingSystem", "esp_restart_noos")) return false
    true
}
