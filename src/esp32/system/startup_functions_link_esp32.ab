import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkStartupFunctionsInternals(): bool {
    // The Abla linker-section values above retain the initializer table
    // directly; there is no synthetic include symbol to expose or root.
    true
}
