import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPanicArchInternals(): bool {
    if (!internalFunction("esp32RecoveredPanicPrintRegisters", "panic_print_registers")) return false
    if (!internalFunction("esp32RecoveredPanicArchFillInfo", "panic_arch_fill_info")) return false
    if (!internalFunction("esp32RecoveredPanicSocCheckPseudoCause", "panic_soc_check_pseudo_cause")) return false
    if (!internalFunction("esp32RecoveredPanicSocFillInfo", "panic_soc_fill_info")) return false
    if (!internalFunction("esp32RecoveredPanicGetAddress", "panic_get_address")) return false
    if (!internalFunction("esp32RecoveredPanicGetCause", "panic_get_cause")) return false
    if (!internalFunction("esp32RecoveredPanicSetAddress", "panic_set_address")) return false
    if (!internalFunction("esp32RecoveredPanicPrintBacktrace", "panic_print_backtrace")) return false
    if (!internalFunction("esp32RecoveredPanicPrepareFrameFromCtx", "panic_prepare_frame_from_ctx")) return false
    if (!internalFunction("esp32RecoveredPanicClearActiveInterrupts", "panic_clear_active_interrupts")) return false
    true
}
