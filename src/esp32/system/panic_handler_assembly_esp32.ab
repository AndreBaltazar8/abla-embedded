// Abla/LLVM implementation of the Xtensa panic exception-entry context save and panic-handler trampoline.

// Original ABI symbol: _xt_panic
@naked
@section(".iram1")
trusted fun esp32RecoveredXtPanic(): void =
    $xtensa panicExceptionEntry {
        1,
        262180,
        _xt_context_save,
        panicHandler
    }
