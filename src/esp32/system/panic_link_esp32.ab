import "abla/build"

// Exact names used by recovered assembly and mixed callers. ESP-IDF's port
// panic entry, architecture printer, and debug helpers are the only remaining
// foreign roots after panic.c is removed; every other function stays internal
// to the monolithic Abla graph.
compile fun esp32Idf6LinkPanicInternals(): bool {
    if (!internalFunction("esp32RecoveredPanicPrintChar", "panic_print_char")) return false
    if (!exportFunction("esp32RecoveredPanicPrintStr", "panic_print_str")) return false
    if (!exportFunction("esp32RecoveredPanicPrintHex", "panic_print_hex")) return false
    if (!exportFunction("esp32RecoveredPanicPrintDec", "panic_print_dec")) return false
    if (!exportFunction("esp32RecoveredEspPanicHandlerDisableTimgWdts", "esp_panic_handler_disable_timg_wdts")) return false
    if (!exportFunction("esp32RecoveredEspPanicHandlerEnableRtcWdt", "esp_panic_handler_enable_rtc_wdt")) return false
    if (!internalFunction("esp32RecoveredEspPanicHandlerFeedWdts", "esp_panic_handler_feed_wdts")) return false
    if (!internalFunction("esp32RecoveredEspPanicHandlerResetModulesOnExitAndHalt", "esp_panic_handler_reset_modules_on_exit_and_halt")) return false
    if (!exportFunction("esp32RecoveredEspPanicHandlerIncrementEntryCount", "esp_panic_handler_increment_entry_count")) return false
    if (!internalFunction("esp32RecoveredPanicAbort", "panic_abort")) return false
    if (!internalFunction("esp32RecoveredEspResetReasonSetHint", "esp_reset_reason_set_hint")) return false
    if (!internalFunction("esp32RecoveredEspResetReasonGetHint", "esp_reset_reason_get_hint")) return false
    if (!exportFunction("esp32RecoveredEspPanicHandler", "esp_panic_handler")) return false
    true
}
