        ~esp32DportRead(u32(0x3ff000c0))
    else u32(102403080)
    val hardwareCryptoClocks = if (preserveEnabled)
        ~esp32DportRead(u32(0x3ff0001c))
    else u32(15)
    val wifiBluetoothSdioClocks = if (preserveEnabled)
        ~esp32DportRead(u32(0x3ff000cc))
    else u32(228406)

