// TIMG0 one-shot RTC calibration. This is the register-level implementation
// of rtc_clk_cal for the sources used by ESP32 startup, expressed entirely as
// typed Abla operations and bounded control flow.
trusted fun esp32CalibrateRtcClock(source: u32, cycles: u32): u32 {
    if (cycles == u32(0) || cycles >= u32(32767)) return u32(0)

    val configuration = u32(0x3ff5f068)
    val result = u32(0x3ff5f06c)
    esp32ClockMmioUpdate(
        configuration,
        u32(0x00007000),
        (source & u32(3)) << u32(13)
    )
    esp32ClockMmioUpdate(
        configuration,
        u32(0x7fff0000),
        (cycles & u32(32767)) << u32(16)
    )

    val expectedFrequency = if (source == u32(2)) u32(32768) else
        if (source == u32(1)) u32(33203) else
        esp32RecoveredRtcClkSlowFreqGetHz()
    val expectedMicroseconds = u32(esp32UnsignedDivide64(
        u64(cycles) * u64(1000000),
        u64(expectedFrequency)
    ))
    if (expectedMicroseconds == u32(0)) return u32(0)

    esp32ClockMmioUpdate(configuration, u32(0x80000000), u32(0))
    esp32ClockMmioUpdate(configuration, u32(0), u32(0x80000000))
    esp32RomDelayUsValue(expectedMicroseconds)

    var remaining = expectedMicroseconds
    while ((xtensaDeviceLoadU32(configuration) & u32(0x00008000)) == u32(0) &&
        remaining != u32(0)) {
        remaining = remaining - u32(1)
        esp32RomDelayUsValue(u32(1))
    }
    if (remaining == u32(0)) return u32(0)

    val xtalCycles = (xtensaDeviceLoadU32(result) >>> u32(7)) & u32(0x01ffffff)
    val xtalFrequencyMhz = esp32RecoveredRtcClkXtalFreqGet(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    val divider = u64(xtalFrequencyMhz) * u64(cycles)
    if (divider == u64(0)) return u32(0)
    u32(esp32UnsignedDivide64(
        (u64(xtalCycles) << u64(19)) + (divider >>> u64(1)) - u64(1),
        divider
    ))
}

// Select the sdkconfig's internal 150 kHz RTC clock using ordinary Abla
// control flow. This replaces the recovered instruction dispatcher in the
// live startup path and lets LLVM see and optimize the complete loop.
trusted fun esp32SelectRtcSlowClockInternalRc(): void {
    val previousSource = esp32RecoveredRtcClkSlowSrcGet()
    esp32ClockCallRtcSlowSourceSet(u32(0))

    if (previousSource == u32(1)) {
        esp32ClockCallRtc32kEnable(u32(0))
        esp32ClockCallRtc32kDisableExternal()
    }

    esp32RtcCalibrationTimerInitialize()
    var calibration = esp32ClockCallRtcCal(u32(0), u32(1024))
    while (calibration == u32(0)) {
        calibration = esp32ClockCallRtcCal(u32(0), u32(1024))
    }
    esp32ClockCallSlowCalibrationSet(calibration)
    return
}

