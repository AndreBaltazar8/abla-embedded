        (commonPeripheralClocks | u32(15012848)) & ~u32(2)
    esp32DportUpdate(u32(0x3ff4f0ac), u32(0), u32(0x00200000))
    esp32DportUpdate(u32(0x3ff6d0ac), u32(0), u32(0x00200000))

    esp32DportUpdate(u32(0x3ff000c0), commonPeripheralClocks, u32(0))
    esp32DportUpdate(u32(0x3ff000c4), u32(0), commonPeripheralClocks)
    esp32DportUpdate(u32(0x3ff0001c), hardwareCryptoClocks, u32(0))
    esp32DportUpdate(u32(0x3ff00020), u32(0), hardwareCryptoClocks)
    esp32DportUpdate(u32(0x3ff000cc), wifiBluetoothSdioClocks, u32(0))

    // Keep the existing reference-counted API boundary for now; its module-9
    // leaf resolves to the RNG clock bit and will be converted with the rest
    // of peripheral_control_esp32.ab.
    esp32RecoveredPeriphModuleEnable(
        u32(9), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

