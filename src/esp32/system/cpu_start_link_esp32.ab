import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCpuStartBootEntry(): bool {
    if (!internalFunction("esp32RecoveredCallStartCpu1", "call_start_cpu1")) return false
    if (!internalFunction("esp32RecoveredStartupResumeOtherCores", "startup_resume_other_cores")) return false
    if (!internalFunction("esp32RecoveredDoMulticoreSettings", "do_multicore_settings")) return false
    if (!exportFunction("esp32CallStartCpu0", "call_start_cpu0")) return false
    true
}
