import "abla/runtime/self"
import "abla/unsafe/memory"
import "internal_restart_esp32.ab"

val esp32ShutdownHandlersStorage = nativeStaticAllocate(20)
val esp32ShutdownHandlers = u32(esp32ShutdownHandlersStorage)
val esp32ShutdownHandlerCount = u32(5)

@inline
trusted fun esp32ShutdownHandlerAt(index:u32):u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(
        int(esp32ShutdownHandlers + (index << u32(2)))))
)

@inline
trusted fun esp32SetShutdownHandler(index:u32, handler:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(
        int(esp32ShutdownHandlers + (index << u32(2)))), int(handler))

trusted fun esp32RegisterShutdownHandler(handler:u32):u32 {
    var index = u32(0)
    while (index < esp32ShutdownHandlerCount) {
        val registered = esp32ShutdownHandlerAt(index)
        if (registered == handler) return u32(259)
        if (registered == u32(0)) {
            esp32SetShutdownHandler(index, handler)
            return u32(0)
        }
        index = index + u32(1)
    }
    u32(257)
}

trusted fun esp32UnregisterShutdownHandler(handler:u32):u32 {
    var index = u32(0)
    while (index < esp32ShutdownHandlerCount) {
        if (esp32ShutdownHandlerAt(index) == handler) {
            esp32SetShutdownHandler(index, u32(0))
            return u32(0)
        }
        index = index + u32(1)
    }
    u32(259)
}

trusted fun esp32Restart():void {
    var index = esp32ShutdownHandlerCount
    while (index != u32(0)) {
        index = index - u32(1)
        val handler = esp32ShutdownHandlerAt(index)
        if (handler != u32(0)) {
            ablaUnsafeCallI32I32I32I32I32I32I32(int(handler),int(u32(0)),
                int(u32(0)),int(u32(0)),int(u32(0)),int(u32(0)),int(u32(0)))
        }
    }
    esp32RecoveredVTaskSuspendAll(u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32RestartNoOperatingSystem()
    ablaRuntimeTrap()
}

trusted fun esp32RecoveredEspRegisterShutdownHandler(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32RegisterShutdownHandler(a2)

trusted fun esp32RecoveredEspUnregisterShutdownHandler(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32UnregisterShutdownHandler(a2)

trusted fun esp32RecoveredEspRestart(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32Restart(); u32(0) }
