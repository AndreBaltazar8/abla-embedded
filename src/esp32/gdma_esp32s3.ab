import "abla/unsafe/mmio"
import "../atomic.ab"
import "./gdma_control_esp32s3.ab"
import "./gdma_events_esp32s3.ab"
import "./gdma_buffer_esp32s3.ab"
import "./gdma_ring_esp32s3.ab"
import "./gdma_linear_esp32s3.ab"
import "../hal/esp32.ab"
@export("esp32s3GdmaRead")
trusted fun esp32s3GdmaReadHook(address: int): int = mmioLoadU32(address)
@export("esp32s3GdmaWrite")
trusted fun esp32s3GdmaWriteHook(address: int, value: int): void = mmioStoreU32(address, value)
@export("esp32s3GdmaPublish")
trusted fun esp32s3GdmaPublishHook(): void = atomicMemoryFence()
