import "abla/unsafe/mmio"
import "../atomic.ab"
import "./gdma_control_esp32s3.ab"
import "./gdma_events_esp32s3.ab"
import "./gdma_buffer_esp32s3.ab"
import "./gdma_ring_esp32s3.ab"
import "./gdma_linear_esp32s3.ab"
trusted fun esp32s3GdmaRead(address: int): int = mmioLoadU32(address)
trusted fun esp32s3GdmaWrite(address: int, value: int): void = mmioStoreU32(address, value)
trusted fun esp32s3GdmaPublish(): void = atomicMemoryFence()
