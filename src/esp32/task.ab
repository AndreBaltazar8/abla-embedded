import "./freertos/tasks_esp32.ab"

trusted noescape fun vTaskDelay(ticks: u32): void {
    esp32RecoveredVTaskDelay(
        ticks,
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun taskDelay(ticks: int): void {
    vTaskDelay(u32(if (ticks > 0) ticks else 0))
    return
}
