import "./freertos/tasks_esp32.ab"
import "../hal/esp32.ab"

trusted noescape fun esp32TaskDelayTicks(ticks: u32): void {
    esp32RecoveredVTaskDelay(
        ticks,
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

@export("taskDelay")
trusted fun taskDelayHook(ticks: int): void {
    esp32TaskDelayTicks(u32(if (ticks > 0) ticks else 0))
    return
}
