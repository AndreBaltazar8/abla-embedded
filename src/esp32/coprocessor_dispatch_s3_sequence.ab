import "./coprocessor_fault_s3_sequence.ab"
import "../xtensa/critical_lock_sequence.ab"
// Resolver ABI u32(core,cp,context): returns current interrupted task's record,
// or zero if no task owns this execution (ISR/boot/fatal context). Called with
// the scheduler lock held and INTLEVEL15. Must be integer-only, bounded, never
// yield/release the lock/change PS; all task migration/deletion uses this lock.
// Return 1 repaired, 0 unrelated cause, -1 invalid input, -2 lock contention,
// -3 unavailable/invalid task state, -4 violated lock contract (fatal).
@section(".iram1.abla.s3CpDispatch")
trusted fun esp32S3CoprocessorDispatch(frame: NativeBuffer,table: NativeBuffer,lock: NativeBuffer,core: int,resolver: int,context: int): int {
    if (!frame.hasAddressRange(0,192) || !esp32S3CpOwnerRange(frame.addressValue(),192,15)) return -1
    val cause=esp32S3CpOwnerRead(frame.addressValue()+80)
    if (cause != 32 && cause != 35) return 0
    if (core < 0 || core > 1 || esp32S3CpOwnerCore() != core ||
        (esp32S3CpOwnerStatus() & 0x40010) != 0x40000 ||
        !table.hasAddressRange(0,16) || !esp32S3CpOwnerRange(table.addressValue(),16,3) ||
        !lock.hasAddressRange(0,4) || !esp32S3CpOwnerRange(lock.addressValue(),4,3) ||
        resolver < 0x40370000 || resolver >= 0x403E0000 || (resolver & 3) != 0 || context < 0 || context > 0xFFFFFFFF) return -1
    val word=lock.addressValue()
    val tab=table.addressValue()
    val address=frame.addressValue()
    if ((word >= tab && word < tab+16) || (word >= address && word < address+192) ||
        (tab < address+192 && address < tab+16)) return -1
    val guard=xtensaCriticalLockTry(lock)
    if (!guard.valid()) return -2
    // Validate every resident before calling into scheduler lookup: releasing
    // must never overwrite a lock embedded inside a saved register payload.
    var valid=true
    var offset=0
    while (offset < 16) {
        val resident=esp32S3CpOwnerRead(tab+offset)
        if (resident != 0 && (!esp32S3CpOwnerRange(resident,256,15) ||
            (word >= resident && word < resident+256))) valid=false
        offset=offset+4
    }
    var result=-3
    if (valid) {
        val taskRecord=esp32S3CpDispatchResolve(resolver,core,cause-32,context)
        if (esp32S3CpOwnerRange(taskRecord,256,15) && !(word >= taskRecord && word < taskRecord+256)) {
            if (esp32S3CoprocessorFaultOwned(frame,table,nativeBufferAt(taskRecord,256),core)) result=1
        }
    }
    if (!xtensaCriticalLockRelease(lock,guard)) return -4
    result
}
