import "../xtensa/device.ab"
import "../runtime/unsigned_division64.ab"

// The classic ESP32 timer-group counter advances at two ticks per microsecond.
// Triggering UPDATE latches both halves, so the complete 64-bit value can stay
// inside the Abla/LLVM graph instead of crossing the ESP-IDF C ABI.
@inline
trusted fun esp32TimerGroupCounter(): u64 {
    val config = xtensaDeviceLoadU32(u32(1073082480))
    var remaining = (config >> u32(13)) & u32(65535)
    val previous = xtensaDeviceLoadU32(u32(1073082488))
    xtensaDeviceStoreU32(u32(1073082496), u32(1))
    var low = xtensaDeviceLoadU32(u32(1073082488))
    while (low == previous && remaining > u32(0)) {
        low = xtensaDeviceLoadU32(u32(1073082488))
        remaining = remaining - u32(1)
    }

    // An interrupt can perform another latch between the two half reads.
    // Repeat until HIGH and LOW are from the same latched counter value.
    var stableLow = low
    var high = xtensaDeviceLoadU32(u32(1073082492))
    low = xtensaDeviceLoadU32(u32(1073082488))
    while (low != stableLow) {
        stableLow = low
        high = xtensaDeviceLoadU32(u32(1073082492))
        low = xtensaDeviceLoadU32(u32(1073082488))
    }
    (u64(high) << u64(32)) | u64(low)
}

noescape fun esp_timer_get_time(): int =
    int(esp32TimerGroupCounter() >>> u64(1))

// floor(floor(ticks/2)/1000) == floor(ticks/2000). Keep the complete
// timebase without an out-of-graph __udivdi3 compiler-library dependency.
fun esp32MillisecondsFromTimerTicks(ticks: u64): int =
    int(unsignedDivide64(ticks,u64(2000)))
trusted fun esp32Milliseconds(): int = esp32MillisecondsFromTimerTicks(esp32TimerGroupCounter())
