// vTaskDelay(N) can return after only N-1 complete tick periods. At 1kHz,
// add one tick to guarantee the requested minimum; bound chunks to avoid
// overflow and keep the delay representable in the RTOS tick counter.
fun peripheralDelayTicks1Khz(milliseconds: int): int =
    if (milliseconds <= 0) 0 else if (milliseconds >= 1000) 1001 else milliseconds + 1
