import "./adc_session_c5_sequence.ab"
import "./adc_fuse_c5_sequence.ab"
// Factory-calibrated entry, same104B session/ownership contract. Caller has
// loaded/error-checked eFuse shadows. No fuse writes or calibration fallback.
// Return6 means unsupported/unprogrammed calibration: record and hardware
// remain untouched, so no session exists to close in that case.
trusted fun c5AdcSessionOpenFactoryOwned(r: NativeBuffer,channel: int,attenuation: int,source: int,sourceHz: int,exclusive: bool,coldSafe: bool,shadowsReady: bool): int {
    if (!exclusive || !shadowsReady || !c5AdcSessionRange(r) || channel < 0 || channel > 5 || attenuation < 0 || attenuation > 3 || source < 0 || source > 2 || c5AdcDefaultPulseMicros(sourceHz) < 0) return 2
    if (r.loadU32(0) != 0) return 2
    val calibration=esp32c5AdcReadCalibration(channel,attenuation,true)
    if (!calibration.valid()) return 6
    return c5AdcSessionOpenOwned(r,calibration,source,sourceHz,true,coldSafe)
}
