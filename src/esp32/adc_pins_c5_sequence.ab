import "./gpio_c5_sequence.ab"
import "./adc_clock_c5_sequence.ab"
// ADC1 channels0..5 use GPIO1..6. Analog pads use floating HP GPIO mux;
// existing LP routing/holds are rejected, not silently taken over.
// Caller owns former GPIO/LP/ADC users, excludes IRQ/ETM/sleep/globalholds,
// pins clocks and has completed all conversions. OE must be off at entry.
// Snapshot: mux15bits@8,route12@23,open-drain@35,latch@36,pin3@37,
// valid@40. status1ready2invalid3admission4partial5restored6restorefailure.
type C5AdcPad=int
fun C5AdcPad.status(): int = this&255
fun C5AdcPad.pin(): int = (this>>>37)&7
trusted fun c5AdcPadAdmission(pin: int,exclusive: bool): bool {
    if (!exclusive || pin < 1 || pin > 6 || !c5AdcClocksReady() || !c5AdcAllStopped()) return false
    if ((c5GpioRead(0x600960f0)&u32(3)) != u32(1) ||
        (c5GpioRead(0x600960f4)&u32(0x400000)) == u32(0) ||
        ((c5GpioRead(0x600960f4)>>u32(20))&u32(3)) == u32(3) ||
        (c5GpioRead(0x60091df8)&u32(1)) == u32(0)) return false
    val bit=u32(1)<<u32(pin)
    return ((c5GpioRead(0x600b102c)|c5GpioRead(0x600b1028))&bit) == u32(0)
}
trusted fun c5AdcPadOpenOwned(channel: int,exclusive: bool): C5AdcPad {
    if (channel < 0 || channel > 5 || !exclusive) return C5AdcPad(2)
    val pin=channel+1
    if (!c5AdcPadAdmission(pin,true)) return C5AdcPad(3)
    val bit=u32(1)<<u32(pin)
    val route=c5GpioRead(0x60091ad4+pin*4)
    if ((c5GpioRead(0x60091034)&bit) != u32(0) || (route&u32(3072)) != u32(1024)) return C5AdcPad(3)
    val snapshot=(1<<40)|(pin<<37)|
        (int(c5GpioRead(0x60090000+pin*4)&u32(32767))<<8)|
        (int(route&u32(4095))<<23)|
        (int((c5GpioRead(0x600910d4+pin*4)>>u32(2))&u32(1))<<35)|
        (int((c5GpioRead(0x60091004)>>u32(pin))&u32(1))<<36)
    return C5AdcPad(snapshot|(if (esp32C5GpioConfigureOwned(pin,false,false,false,false,0,true) == 1) 1 else 4))
}
trusted fun C5AdcPad.closeOwned(exclusive: bool): C5AdcPad {
    if (!exclusive || this < 0 || (this&~0x1ffffffffff) != 0 || (this&(1<<40)) == 0 || this.status() == 5) return this
    if (this.status() != 1 && this.status() != 4 && this.status() != 6) return this
    val snapshot=this&~255
    val pin=this.pin()
    if (!c5AdcPadAdmission(pin,true)) return C5AdcPad(snapshot|6)
    val bit=u32(1)<<u32(pin)
    c5GpioWrite(0x6009103c,bit)
    if ((c5GpioRead(0x60091034)&bit) != u32(0) || !c5GpioField(0x60091ad4+pin*4,u32(3072),u32(1024))) return C5AdcPad(snapshot|6)
    val high=((snapshot>>>36)&1) != 0
    esp32C5GpioWriteOwned(pin,high)
    if (((c5GpioRead(0x60091004)&bit) != u32(0)) != high ||
        !c5GpioField(0x600910d4+pin*4,u32(4),u32((snapshot>>>35)&1)<<u32(2)) ||
        !c5GpioField(0x60090000+pin*4,u32(29570),u32(snapshot>>>8)&u32(29570)) ||
        !c5GpioField(0x60091ad4+pin*4,u32(4095),u32(snapshot>>>23)&u32(4095))) return C5AdcPad(snapshot|6)
    return C5AdcPad(snapshot|5)
}
