import "./adc1_session_sequence.ab"
import "./sar_power_esp32.ab"
import "./adc1_config_esp32.ab"
import "./adc1_pins_esp32.ab"
import "./adc_fuse_logic.ab"
trusted fun esp32Adc1SessionHardwareMatches(channel: int,width: int,attenuation: int): bool {
    if (((esp32SarPowerRead(12)>>18)&3) != 3 || !esp32Adc1Prepared() ||
        ((esp32Adc1Read(0)>>16)&3) != width-9 || ((esp32Adc1Read(52)>>(channel*2))&3) != attenuation) return false
    val pad=esp32Adc1PadRead(esp32Adc1PadOffset(channel))
    if ((pad&esp32Adc1PadHold(channel)) != 0 || (esp32Adc1ForceHoldRead()&esp32Adc1PadForceHold(channel)) != 0 ||
        (pad&(esp32Adc1PadClear(channel)|esp32Adc1PadMux(channel))) != esp32Adc1PadMux(channel)) return false
    if ((channel == 4 || channel == 5) && (pad&0x80000) != 0) return false
    return (esp32Adc1PadRead(12)&(1<<(esp32Adc1RtcPad(channel)+14))) == 0
}
fun Esp32Adc1Session.millivolts(calibration: Esp32AdcCalibration,reference: int): int =
    if (this.raw() < 0) -1 else calibration.millivolts(1,this.attenuation(),this.width(),this.raw(),reference)
