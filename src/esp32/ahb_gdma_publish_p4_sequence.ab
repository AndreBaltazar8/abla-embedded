import "./sdk/raw_buffer.ab"
// Requires valid built ring, initialized TX data or owned RX destination,
// parked channel, exclusive global cache-sync engine and all owned cache lines
// excluded from both cores/ISRs/prefetch until ownership is handed back.
// Flush/writeback-invalidate payload BEFORE descriptors; DMA may update both.
// Entire strided slots are owned, including padding. Internal SRAM only.
// 1 published (NOT started),2 invalid/unowned,3 payload sync,4 descriptor sync;
// nested cache status in bits8+. Any failure retains ownership; timeout can
// leave global cache engine busy. Never start DMA or free/rewrite on failure.
trusted fun esp32p4AhbGdmaPublishRingOwned(descriptors: int,count: int,buffers: int,
    stride: int,bytes: int,polls: int,exclusive: bool): int {
    if (!exclusive || polls < 1 || polls > 1000000 ||
        !esp32p4AhbGdmaRingLayoutValid(descriptors,count,buffers,stride,bytes)) return 2
    p4AhbPublishFence()
    val payload=p4AhbPublishFlush(nativeBufferAt(buffers,count*stride),count*stride,polls)
    if (payload != 1) return 3 | (payload << 8)
    p4AhbPublishFence()
    val ring=p4AhbPublishFlush(nativeBufferAt(descriptors,count*64),count*64,polls)
    if (ring != 1) return 4 | (ring << 8)
    p4AhbPublishFence()
    return 1
}
