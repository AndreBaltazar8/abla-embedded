import "./coprocessor_transfer_s3_sequence.ab"
import "./coprocessor_windowed_esp32s3.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/native"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
@inline
@export("esp32S3CpTransferCore")
trusted fun esp32S3CpTransferCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3CpTransferStatus")
trusted fun esp32S3CpTransferStatusHook(): int = xtensaGuardStatus()
@inline
@export("esp32S3CpTransferEnabled")
trusted fun esp32S3CpTransferEnabledHook(): int = int(xtensaGuardRead("rsr.cpenable $0","=r,~{memory}"))
@inline
@export("esp32S3CpTransferEnable")
trusted fun esp32S3CpTransferEnableHook(value: int): void { xtensaGuardWrite("wsr.cpenable $0\nrsync","r,~{memory}",u32(value)); return }
@inline
@export("esp32S3CpTransferCall")
trusted fun esp32S3CpTransferCallHook(cp: int,restore: bool,address: int): void {
    val target=if (cp == 0) (if (restore) esp32S3Cp0RestoreWindowedAddress() else esp32S3Cp0SaveWindowedAddress()) else (if (restore) esp32S3Cp3RestoreWindowedAddress() else esp32S3Cp3SaveWindowedAddress())
    callNativeVoidI32(target,address)
    return
}
