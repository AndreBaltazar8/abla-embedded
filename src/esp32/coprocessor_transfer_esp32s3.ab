import "./coprocessor_transfer_s3_sequence.ab"
import "./coprocessor_windowed_esp32s3.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/native"
@inline
trusted fun esp32S3CpTransferCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3CpTransferStatus(): int = xtensaGuardStatus()
@inline
trusted fun esp32S3CpTransferEnabled(): int = int(xtensaGuardRead("rsr.cpenable $0","=a,~{memory}"))
@inline
trusted fun esp32S3CpTransferEnable(value: int): void { xtensaGuardWrite("wsr.cpenable $0\nrsync","a,~{memory}",u32(value)); return }
@inline
trusted fun esp32S3CpTransferCall(cp: int,restore: bool,address: int): void {
    val target=if (cp == 0) (if (restore) esp32S3Cp0RestoreWindowedAddress() else esp32S3Cp0SaveWindowedAddress()) else (if (restore) esp32S3Cp3RestoreWindowedAddress() else esp32S3Cp3SaveWindowedAddress())
    callNativeVoidI32(target,address)
    return
}
