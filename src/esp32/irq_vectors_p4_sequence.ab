import "./clic_vectors_p4_sequence.ab"

// Prepare an unpublished MTVT table. Preserve caller-supplied local trap
// entries (0..15); only external lines16..47 use the shared integer IRQ entry.
// Local entries are real architectural handlers, NOT normal ABI callbacks.
// Caller owns both regions, excludes writers/readers on BOTH cores, and
// guarantees destination is not another core's vector table and is disjoint
// from ALL handler code, stacks and live dispatch state. Pointer checks below
// cannot establish the extent of code. Source remains stable throughout.
// No CSR installation or interrupt enabling here.
// 1prepared,2invalid (no writes),3destination currently installed (no writes).
trusted fun esp32P4IrqPrepareVectorsOwned(table: NativeBuffer,local: NativeBuffer,entry: int): int {
    if (!table.hasAddressRange(0,192) || (table.addressValue()&63) != 0 ||
        !local.hasAddressRange(0,64) || (local.addressValue()&3) != 0 ||
        entry <= 0 || entry > 4294967232 || (entry&63) != 0) return 2
    val dst=table.addressValue()
    val src=local.addressValue()
    if (dst < src+64 && src < dst+192) return 2
    // Reject obvious entry-point aliases; full code ownership is caller-owned.
    if (entry >= dst && entry < dst+192) return 2
    val installed=int(p4ClicReadMtvt())
    if (dst < installed+192 && installed < dst+192) return 3
    var line=0
    while (line < 16) {
        val handler=local.loadU32(line*4)
        if (handler == 0 || (handler&1) != 0 || (handler >= dst && handler < dst+192)) return 2
        line=line+1
    }
    line=0
    while (line < 48) {
        table.storeU32(line*4,if (line < 16) local.loadU32(line*4) else entry)
        line=line+1
    }
    p4ClicVectorFence()
    return 1
}
