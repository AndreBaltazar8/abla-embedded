import "abla/unsafe/mmio"

// ESP32-C6 UART0 is configured by startup. Keep the same SerialPort API as the
// classic ESP32 module while changing only the target register base.
val esp32C6Uart0Base = 1610612736
val esp32C6UartFifo = esp32C6Uart0Base
val esp32C6UartStatus = esp32C6Uart0Base + 28

type SerialPort = int

fun serial(unit: int = 0): SerialPort = SerialPort(unit)

trusted fun SerialPort.writeByte(value: int): void {
    if (this == 0) {
        var full = true
        while (full) {
            val status = mmioLoadU32(esp32C6UartStatus)
            val count = (status >>> 16) & 255
            full = count >= 127
        }
        mmioStoreU32(esp32C6UartFifo, value & 255)
    }
}

trusted fun SerialPort.write(text: string): void {
    var index = 0
    while (index < text.size) {
        this.writeByte(text[index])
        index = index + 1
    }
}

trusted fun SerialPort.line(text: string): void {
    this.write(text)
    this.writeByte(10)
}
