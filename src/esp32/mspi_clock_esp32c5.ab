import "./mspi_clock_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@inline
@export("c5MspiRead")
trusted fun c5MspiReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("c5MspiWrite")
trusted fun c5MspiWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
