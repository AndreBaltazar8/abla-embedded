import "abla/unsafe/memory"
import "./sdk/buffer.ab"
import "./i2s_types.ab"

trusted noescape extern:"c" fun i2s_new_channel(
    config: i64*,
    transmitHandle: i64*,
    receiveHandle: i64*
): i32
trusted noescape extern:"c" fun i2s_del_channel(handle: i64*): i32
trusted noescape extern:"c" fun i2s_channel_init_std_mode(
    handle: i64*,
    config: i64*
): i32
trusted noescape extern:"c" fun i2s_channel_init_pdm_rx_mode(
    handle: i64*,
    config: i64*
): i32
trusted noescape extern:"c" fun i2s_channel_enable(handle: i64*): i32
trusted noescape extern:"c" fun i2s_channel_disable(handle: i64*): i32
trusted noescape extern:"c" fun i2s_channel_read(
    handle: i64*,
    destination: i64*,
    size: u32,
    bytesRead: i64*,
    timeoutMilliseconds: u32
): i32
trusted noescape extern:"c" fun i2s_channel_write(
    handle: i64*,
    source: i64*,
    size: u32,
    bytesWritten: i64*,
    timeoutMilliseconds: u32
): i32

// Channel ownership belongs to the physical ESP32 I2S ports, not to a heap
// wrapper. Keeping the native handles here lets the public device value remain
// the same zero-cost nominal scalar on both legacy Arduino and ESP-IDF 6.
var idf6I2sHandle0 = 0
var idf6I2sHandle1 = 0

fun I2sDevice.handleAddress(): int =
    if (this.portNumber() == 0) idf6I2sHandle0 else idf6I2sHandle1

fun setI2sHandle(port: int, address: int): void {
    if (port == 0) idf6I2sHandle0 = address
    else idf6I2sHandle1 = address
    return
}

trusted fun I2sDevice.install(microphone: bool): bool {
    if (this.handleAddress() != 0) return false

    val channelConfig = nativeStackAllocate(24)
    nativeAddressClear(channelConfig, 24)
    nativeAddressStoreU32(channelConfig, 0, this.portNumber())
    nativeAddressStoreU32(channelConfig, 8, 6)
    nativeAddressStoreU32(channelConfig, 12, 240)

    val handleCell = nativeStackAllocate(8)
    nativeAddressClear(handleCell, 8)
    val allocation = if (microphone) {
        i2s_new_channel(
            nativePointerFromAddress(channelConfig),
            nativeNullPointer(),
            nativePointerFromAddress(handleCell)
        )
    } else {
        i2s_new_channel(
            nativePointerFromAddress(channelConfig),
            nativePointerFromAddress(handleCell),
            nativeNullPointer()
        )
    }
    val handle = nativeAddressLoadU32(handleCell, 0)
    setI2sHandle(this.portNumber(), handle)

    var result = allocation
    if (result == 0 && microphone) {
        val config = nativeStackAllocate(52)
        nativeAddressClear(config, 52)
        nativeAddressStoreU32(config, 0, this.sampleRateValue())
        nativeAddressStoreU32(config, 4, 6)
        nativeAddressStoreU32(config, 8, 256)
        nativeAddressStoreU32(config, 16, 8)
        nativeAddressStoreU32(config, 20, 16)
        // Match the legacy I2S_CHANNEL_FMT_ALL_RIGHT behavior used by the
        // Atom Echo firmware: one mono sample is transmitted in both wire
        // slots. Some mono amplifiers are strapped to only one WS polarity,
        // so selecting the default left slot can initialize successfully yet
        // produce no sound.
        nativeAddressStoreU32(config, 28, 3)
        nativeAddressStoreU32(config, 32, 2)
        nativeAddressStoreU32(
            config, 40, this.pinsValue().wordSelectPin()
        )
        nativeAddressStoreU32(config, 44, this.pinsValue().inputPin())
        result = i2s_channel_init_pdm_rx_mode(
            nativePointerFromAddress(handle),
            nativePointerFromAddress(config)
        )
    }
    if (result == 0 && !microphone) {
        val config = nativeStackAllocate(64)
        nativeAddressClear(config, 64)
        nativeAddressStoreU32(config, 0, this.sampleRateValue())
        nativeAddressStoreU32(config, 4, 6)
        nativeAddressStoreU32(config, 8, 256)
        nativeAddressStoreU32(config, 12, 8)
        nativeAddressStoreU32(config, 16, 16)
        nativeAddressStoreU32(config, 24, 1)
        nativeAddressStoreU32(config, 28, 1)
        nativeAddressStoreU32(config, 32, 16)
        nativeAddressStoreU8(config, 37, 1)
        nativeAddressStoreU8(config, 38, 1)
        nativeAddressStoreU32(config, 40, -1)
        nativeAddressStoreU32(config, 44, this.pinsValue().clockPin())
        nativeAddressStoreU32(
            config, 48, this.pinsValue().wordSelectPin()
        )
        nativeAddressStoreU32(config, 52, this.pinsValue().outputPin())
        nativeAddressStoreU32(config, 56, -1)
        result = i2s_channel_init_std_mode(
            nativePointerFromAddress(handle),
            nativePointerFromAddress(config)
        )
    }
    if (result == 0) {
        result = i2s_channel_enable(nativePointerFromAddress(handle))
    }
    if (result != 0 && handle != 0) {
        i2s_del_channel(nativePointerFromAddress(handle))
        setI2sHandle(this.portNumber(), 0)
    }
    result == 0
}

trusted fun I2sDevice.uninstall(): void {
    val handle = this.handleAddress()
    if (handle != 0) {
        i2s_channel_disable(nativePointerFromAddress(handle))
        i2s_del_channel(nativePointerFromAddress(handle))
        setI2sHandle(this.portNumber(), 0)
    }
    return
}

trusted fun I2sDevice.read(
    buffer: NativeBuffer,
    maximum: int,
    timeoutMilliseconds: int
): int {
    val handle = this.handleAddress()
    if (handle == 0) return -1
    val count = nativeStackAllocate(4)
    nativeAddressStoreU32(count, 0, 0)
    val status = i2s_channel_read(
        nativePointerFromAddress(handle),
        buffer.pointer(),
        maximum,
        nativePointerFromAddress(count),
        timeoutMilliseconds
    )
    if (status == 0) nativeAddressLoadU32(count, 0) else -1
}

trusted fun I2sDevice.write(buffer: NativeBuffer, length: int): int =
    this.writeAddress(buffer.addressValue(), length)

trusted fun I2sDevice.writeAddress(address: int, length: int): int {
    val handle = this.handleAddress()
    if (handle == 0) return -1
    val count = nativeStackAllocate(4)
    nativeAddressStoreU32(count, 0, 0)
    val status = i2s_channel_write(
        nativePointerFromAddress(handle),
        nativePointerFromAddress(address),
        length,
        nativePointerFromAddress(count),
        4294967295
    )
    if (status == 0) nativeAddressLoadU32(count, 0) else -1
}
