// Caller owns and serializes this channel, with clocked, live DW-GDMA group.
// No automatic abort, group reset, event acknowledgement or memory release.
trusted fun esp32P4DwDmaEventsOwned(channel: int): int {
    if (channel < 0 || channel > 3) return -1
    return int(p4DwDmaRead(392+channel*256))
}
// Acknowledge only caller-selected, supported events on an inactive channel.
// 1 issued,2 invalid,3 active/aborting. WO/W1C must never use read-modify-write.
trusted fun esp32P4DwDmaAcknowledgeOwned(channel: int,events: int): int {
    if (channel < 0 || channel > 3 || events < 1 || events > 4294967295 ||
        (u32(events)&u32(134201348)) != u32(0)) return 2
    val bit=u32(1)<<u32(channel)
    if ((p4DwDmaRead(24)&bit) != u32(0) || (p4DwDmaRead(28)&bit) != u32(0)) return 3
    p4DwDmaWrite(408+channel*256,u32(events))
    return 1
}
// Submit a configured DSI channel. Caller has finished cache writeback of ALL
// pixels and descriptor fields, issued the required hardware memory barrier,
// and pinned their lifetime. Configuration is not a substitute for publication.
// 1 start write issued (not proof of acceptance/completion),2 invalid,
// 3 controller unavailable,4 active/aborting,5 pending events,6 wrong config.
// DMA may complete before any enable readback: observe events separately.
trusted fun esp32P4DwDmaDsiStartPreparedOwned(channel: int): int {
    if (channel < 0 || channel > 3) return 2
    if ((p4DwDmaRead(16)&u32(1)) == u32(0) || (p4DwDmaRead(88)&u32(1)) != u32(0)) return 3
    val bit=u32(1)<<u32(channel)
    if ((p4DwDmaRead(24)&bit) != u32(0) || (p4DwDmaRead(28)&bit) != u32(0)) return 4
    val base=256+channel*256
    if (p4DwDmaRead(base+136) != u32(0)) return 5
    val head=p4DwDmaRead(base+40)
    if ((p4DwDmaRead(base+32)&u32(15)) != u32(15) ||
        (p4DwDmaRead(base+36)&u32(2140025247)) != u32(167903233) ||
        p4DwDmaRead(base+44) != u32(0) || (head&u32(1)) == u32(0) ||
        (head&u32(4294967232)) == u32(0) ||
        (p4DwDmaRead(base+128)&u32(4160765947)) != u32(4160765947) ||
        (p4DwDmaRead(base+144)&u32(4160765947)) != u32(0)) return 6
    p4DwDmaWrite(24,u32(257)<<u32(channel))
    return 1
}
// Request ordinary disable, then bound the wait for enable AND abort to clear.
// 1 observed inactive,2 invalid,3 controller unavailable,4 timeout: keep every
// buffer/descriptor/clock/channel lease alive and retry or explicitly recover.
// Inactive does not imply the frame completed successfully: inspect events.
// Caller must also quiesce the DSI bridge before reusing display resources.
trusted fun esp32P4DwDmaStopOwned(channel: int,polls: int): int {
    if (channel < 0 || channel > 3 || polls < 1 || polls > 1000000) return 2
    if ((p4DwDmaRead(16)&u32(1)) == u32(0) || (p4DwDmaRead(88)&u32(1)) != u32(0)) return 3
    val bit=u32(1)<<u32(channel)
    if ((p4DwDmaRead(24)&bit) != u32(0)) p4DwDmaWrite(24,u32(256)<<u32(channel))
    var remaining=polls
    while (remaining > 0) {
        val active=p4DwDmaRead(24)
        val aborting=p4DwDmaRead(28)
        if (((active|aborting)&bit) == u32(0)) return 1
        remaining=remaining-1
    }
    return 4
}
