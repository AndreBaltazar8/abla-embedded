// One authoritative group owner; copies do not create leases. Caller serializes
// group lifecycle and RCC across cores. Close requires ALL channel leases back.
// No adoption/reset of preexisting clocked hardware. Both P4 layouts agree.
type Esp32P4DwDmaController = int
fun Esp32P4DwDmaController.status(): int = this&15
fun Esp32P4DwDmaController.ownsClocks(): bool = (this&16) != 0
fun Esp32P4DwDmaController.quiesced(): bool = (this&32) != 0
// Status0closed,1ready,2invalid,3preexisting,4RCCfailure,5resettimeout,
// 6controller readback failure,7active/aborting,8clockstate inconsistent.
trusted fun p4DwControllerClockField(offset: int,mask: u32,value: u32): bool {
    p4DwClockWrite(offset,(p4DwClockRead(offset)&(u32(4294967295)^mask))|value)
    (p4DwClockRead(offset)&mask) == value
}
trusted fun p4DwControllerWaitReset(polls: int): bool {
    var remaining=polls
    while (remaining > 0) {
        if ((p4DwDmaRead(88)&u32(1)) == u32(0)) return true
        remaining=remaining-1
    }
    return false
}
trusted fun esp32P4DwDmaControllerOpenOwned(polls: int): Esp32P4DwDmaController {
    if (polls < 1 || polls > 1000000) return Esp32P4DwDmaController(2)
    if ((p4DwClockRead(20)&u32(8192)) != u32(0) ||
        (p4DwClockRead(24)&u32(32)) != u32(0) ||
        (p4DwClockRead(192)&u32(2097152)) != u32(0)) return Esp32P4DwDmaController(3)
    // Before MMIO controller initialization no DMA can have been started by us.
    if (!p4DwControllerClockField(20,u32(8192),u32(8192)) ||
        !p4DwControllerClockField(24,u32(32),u32(32)) ||
        !p4DwControllerClockField(192,u32(2097152),u32(2097152)) ||
        !p4DwControllerClockField(192,u32(2097152),u32(0))) return Esp32P4DwDmaController(52)
    p4DwDmaWrite(88,u32(1))
    if (!p4DwControllerWaitReset(polls)) return Esp32P4DwDmaController(21)
    // Global interrupt gate enabled as in IDF; channel propagation remains off
    // until each channel owner installs its handler (DSI uses bridge interrupts).
    p4DwDmaWrite(16,(p4DwDmaRead(16)&u32(4294967292))|u32(3))
    if ((p4DwDmaRead(16)&u32(3)) != u32(3)) return Esp32P4DwDmaController(22)
    return Esp32P4DwDmaController(17)
}
trusted fun Esp32P4DwDmaController.closeOwned(polls: int): Esp32P4DwDmaController {
    val flags=this&48
    if (polls < 1 || polls > 1000000) return Esp32P4DwDmaController(flags|2)
    if (!this.ownsClocks()) return Esp32P4DwDmaController(0)
    var quiesced=this.quiesced()
    if (!quiesced) {
        // Never touch MMIO through partially gated clocks.
        if ((p4DwClockRead(20)&u32(8192)) == u32(0) ||
            (p4DwClockRead(24)&u32(32)) == u32(0)) return Esp32P4DwDmaController(24)
        if (!p4DwControllerWaitReset(polls)) return Esp32P4DwDmaController(21)
        if (((p4DwDmaRead(24)|p4DwDmaRead(28))&u32(15)) != u32(0)) return Esp32P4DwDmaController(23)
        p4DwDmaWrite(16,p4DwDmaRead(16)&u32(4294967292))
        if ((p4DwDmaRead(16)&u32(3)) != u32(0)) return Esp32P4DwDmaController(22)
        quiesced=true
    }
    // Keep quiesced across failed gating, so retry only accesses RCC registers.
    if (!p4DwControllerClockField(192,u32(2097152),u32(0)) ||
        !p4DwControllerClockField(24,u32(32),u32(0)) ||
        !p4DwControllerClockField(20,u32(8192),u32(0))) return Esp32P4DwDmaController(52)
    return Esp32P4DwDmaController(0)
}
