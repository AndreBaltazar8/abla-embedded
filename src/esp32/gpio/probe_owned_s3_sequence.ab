import "./input_s3_sequence.ab"

// Save with esp32S3GpioSnapshotOwned BEFORE preparation, and retain that value
// through all failures until restoreOwned succeeds. This owns digital routing
// only: caller must quiesce RTC/USB/analog/peripheral pad users, release holds,
// prevent sleep, and serialize shared register updates throughout the session.
// Pull follows gpio_set_pull_mode: 0up,1down,2both,3floating.
// 1prepared,2invalid,3notowned,4partial/readback failure (restore required).
trusted fun S3GpioSnapshot.prepareProbeInputOwned(pull: int,exclusive: bool): int =
    if (!this.valid()) 2 else esp32S3GpioPrepareInputOwned(this.pin(),pull,exclusive)

// Read only while the prepared digital routing remains intact. No implicit
// reconfiguration on a lost lease or modified route. -1invalid/notprepared.
trusted fun S3GpioSnapshot.readProbeInputOwned(exclusive: bool): int {
    if (!exclusive || !this.valid()) return -1
    val pin=this.pin()
    val bank=esp32S3GpioBankOffset(pin)
    val bit=1<<(pin&31)
    if ((esp32S3PinStateRead(0x60004020+bank)&bit) != 0 ||
        (esp32S3PinStateRead(0x60004554+pin*4)&4095) != 1280 ||
        (esp32S3PinStateRead(0x60004074+pin*4)&4) != 0 ||
        (esp32S3PinStateRead(esp32S3GpioMuxAddress(pin))&0x7200) != 0x1200) return -1
    return if ((esp32S3PinStateRead(if (pin < 32) 0x6000403c else 0x60004040)&bit) != 0) 1 else 0
}
