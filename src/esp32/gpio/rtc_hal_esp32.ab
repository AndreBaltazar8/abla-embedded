import "../../xtensa/assembly.ab"
import "hal_esp32.ab"
import "rtc_periph_esp32.ab"

// Structured Abla RTC-I/O HAL. Descriptor-driven register selection is kept in
// ordinary Abla so LLVM can fold every field for constant RTC pin numbers.

val esp32RtcIoDevice = u32(0x3ff48400)

@inline
trusted fun esp32RtcIoDescriptorField(rtcio: u32, byteOffset: u32): u32 =
    xtensaDeviceLoadU32(
        esp32Data_rtc_io_desc_605f052479 + rtcio * u32(56) + byteOffset
    )

@inline
trusted fun esp32RtcIoDescriptorRegister(rtcio: u32): u32 =
    esp32RtcIoDescriptorField(rtcio, u32(0))

@inline
trusted fun esp32RtcIoDescriptorUpdate(
    rtcio: u32,
    descriptorMaskOffset: u32,
    enable: bool
): void {
    val mask = esp32RtcIoDescriptorField(rtcio, descriptorMaskOffset)
    if (mask != u32(0)) esp32GpioUpdateRegister(
        esp32RtcIoDescriptorRegister(rtcio),
        mask,
        if (enable) mask else u32(0)
    )
    return
}

@inline
trusted fun esp32RtcIoInput(rtcio: u32, enable: bool): void =
    esp32RtcIoDescriptorUpdate(rtcio, u32(12), enable)

@inline
trusted fun esp32RtcIoOutput(rtcio: u32, enable: bool): void {
    val mask = u32(1) << (rtcio + u32(14))
    xtensaDeviceStoreU32(
        esp32RtcIoDevice + if (enable) u32(16) else u32(20),
        mask
    )
    return
}

@inline
trusted fun esp32RtcIoOutputMode(rtcio: u32, openDrain: bool): void {
    esp32GpioUpdateRegister(
        esp32RtcIoDevice + u32(40) + (rtcio << u32(2)),
        u32(1) << u32(2),
        if (openDrain) u32(1) << u32(2) else u32(0)
    )
    return
}

@inline
trusted fun esp32RtcIoSleepInput(rtcio: u32, enable: bool): void =
    esp32RtcIoDescriptorUpdate(rtcio, u32(28), enable)

@inline
trusted fun esp32RtcIoSleepOutput(rtcio: u32, enable: bool): void =
    esp32RtcIoDescriptorUpdate(rtcio, u32(32), enable)

@inline
trusted fun esp32RtcIoSleepSelection(rtcio: u32, enable: bool): void =
    esp32RtcIoDescriptorUpdate(rtcio, u32(24), enable)

@inline
trusted fun esp32RtcIoPullup(rtcio: u32, enable: bool): void =
    esp32RtcIoDescriptorUpdate(rtcio, u32(16), enable)

@inline
trusted fun esp32RtcIoPulldown(rtcio: u32, enable: bool): void =
    esp32RtcIoDescriptorUpdate(rtcio, u32(20), enable)

@inline
trusted fun esp32RtcIoSelectIomuxFunction(rtcio: u32, function: u32): void {
    val shift = esp32RtcIoDescriptorField(rtcio, u32(8))
    esp32GpioUpdateRegister(
        esp32RtcIoDescriptorRegister(rtcio),
        u32(3) << shift,
        (function & u32(3)) << shift
    )
    return
}

trusted fun esp32RtcIoSetDirection(rtcio: u32, mode: u32): void {
    when (mode) {
        0 -> {
            esp32RtcIoOutputMode(rtcio, false)
            esp32RtcIoOutput(rtcio, false)
            esp32RtcIoInput(rtcio, true)
        }
        1 -> {
            esp32RtcIoOutputMode(rtcio, false)
            esp32RtcIoOutput(rtcio, true)
            esp32RtcIoInput(rtcio, false)
        }
        2 -> {
            esp32RtcIoOutputMode(rtcio, false)
            esp32RtcIoOutput(rtcio, true)
            esp32RtcIoInput(rtcio, true)
        }
        3 -> {
            esp32RtcIoOutputMode(rtcio, false)
            esp32RtcIoOutput(rtcio, false)
            esp32RtcIoInput(rtcio, false)
        }
        4 -> {
            esp32RtcIoOutputMode(rtcio, true)
            esp32RtcIoOutput(rtcio, true)
            esp32RtcIoInput(rtcio, false)
        }
        5 -> {
            esp32RtcIoOutputMode(rtcio, true)
            esp32RtcIoOutput(rtcio, true)
            esp32RtcIoInput(rtcio, true)
        }
        else -> {}
    }
    return
}

trusted fun esp32RtcIoSetSleepDirection(rtcio: u32, mode: u32): void {
    when (mode) {
        0 -> {
            esp32RtcIoSleepInput(rtcio, true)
            esp32RtcIoSleepOutput(rtcio, false)
            esp32RtcIoSleepSelection(rtcio, true)
        }
        1 -> {
            esp32RtcIoSleepOutput(rtcio, true)
            esp32RtcIoSleepInput(rtcio, false)
            esp32RtcIoSleepSelection(rtcio, true)
        }
        2 -> {
            esp32RtcIoSleepInput(rtcio, true)
            esp32RtcIoSleepOutput(rtcio, true)
            esp32RtcIoSleepSelection(rtcio, true)
        }
        3 -> {
            esp32RtcIoSleepInput(rtcio, false)
            esp32RtcIoSleepOutput(rtcio, false)
            esp32RtcIoSleepSelection(rtcio, false)
        }
        else -> {}
    }
    return
}

trusted fun esp32RtcIoIsolate(rtcio: u32): void {
    esp32RtcIoPullup(rtcio, false)
    esp32RtcIoPulldown(rtcio, false)
    esp32RtcIoOutput(rtcio, false)
    esp32RtcIoInput(rtcio, false)
    return
}

trusted fun esp32RtcIoIomuxInput(rtcio: u32, function: u32): void {
    esp32RtcIoInput(rtcio, true)
    esp32RtcIoSelectIomuxFunction(rtcio, function)
    return
}

trusted fun esp32RtcIoIomuxOutput(rtcio: u32, function: u32): void {
    esp32RtcIoSelectIomuxFunction(rtcio, function)
    return
}

trusted fun esp32RecoveredRtcioHalSetDirection(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32, stack4: u32,
    stack5: u32, stack6: u32, stack7: u32, stack8: u32, stack9: u32
): u32 {
    esp32RtcIoSetDirection(a2, a3)
    return a2
}

trusted fun esp32RecoveredRtcioHalSetDirectionInSleep(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32, stack4: u32,
    stack5: u32, stack6: u32, stack7: u32, stack8: u32, stack9: u32
): u32 {
    esp32RtcIoSetSleepDirection(a2, a3)
    return a2
}

trusted fun esp32RecoveredRtcioHalIsolate(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32, stack4: u32,
    stack5: u32, stack6: u32, stack7: u32, stack8: u32, stack9: u32
): u32 {
    esp32RtcIoIsolate(a2)
    return a2
}

trusted fun esp32RecoveredRtcioHalIomuxInput(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32, stack4: u32,
    stack5: u32, stack6: u32, stack7: u32, stack8: u32, stack9: u32
): u32 {
    esp32RtcIoIomuxInput(a2, a3)
    return a2
}

trusted fun esp32RecoveredRtcioHalIomuxOutput(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32, stack4: u32,
    stack5: u32, stack6: u32, stack7: u32, stack8: u32, stack9: u32
): u32 {
    esp32RtcIoIomuxOutput(a2, a3)
    return a2
}
