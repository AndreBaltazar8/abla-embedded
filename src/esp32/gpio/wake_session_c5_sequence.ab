import "./wake_c5_sequence.ab"
import "../power/sleep_record_c5.ab"
// Retained32B: tag,state,first failure,close stage,pin lease,old trigger,
// reserved,plan(pin0..5/high6). Own all digital wake sources/PMU GPIO trigger;
// serialize sleep and register writers, keep HP GPIO powered and pads valid.
// This session does not change pad mux/hold/sleep settings, clear events, or
// enter sleep. The caller must include PMU GPIO bit2 in its entry wake mask.
// Results1armed2invalid3partial4closed5waiting inactive; state6closing.
// Pending/partial retains ownership. Close after recovered clocks/caches or
// before entry; no new arm once cleanup starts. Call Arm again just before
// sleep; final physical sampling cannot eliminate a subsequent external edge.
@section(".iram1.abla.c5GpioSession")
trusted fun c5GpioSessionValid(r: NativeBuffer): bool = r.hasAddressRange(0,32) &&
    (r.addressValue()&3) == 0 && c5SleepRecordRead(r,0) == 0x43354757
@section(".iram1.abla.c5GpioSession")
trusted fun c5GpioSessionTrigger(enabled: bool): bool {
    val old=c5GpioWakeRead(0x600b012c)
    c5GpioWakeWrite(0x600b012c,(old&~4)|(if (enabled) 4 else 0))
    return (c5GpioWakeRead(0x600b012c)&4) == (if (enabled) 4 else 0)
}
@section(".iram1.abla.c5GpioSession")
trusted fun c5GpioSessionFailure(r: NativeBuffer,stage: int): int {
    if (c5SleepRecordRead(r,8) == 0) c5SleepRecordWrite(r,8,stage)
    c5SleepRecordWrite(r,4,3);return 3
}
@section(".iram1.abla.c5GpioSession")
trusted fun c5GpioSessionInactive(r: NativeBuffer): bool {
    val plan=c5SleepRecordRead(r,28)
    val high=(c5GpioWakeRead(0x60091064)&int(u32(1)<<u32(plan&63))) != 0
    return high != ((plan&64) != 0)
}
@section(".iram1.abla.c5GpioSession")
trusted fun esp32C5GpioWakeSessionArmOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !c5GpioSessionValid(r)) return 2
    if (c5SleepRecordRead(r,4) != 1 && c5SleepRecordRead(r,4) != 5) return 2
    if (!c5GpioSessionInactive(r)) {
        if (!c5GpioSessionTrigger(false)) return c5GpioSessionFailure(r,3)
        c5SleepRecordWrite(r,4,5);return 5
    }
    if (!c5GpioSessionTrigger(true)) return c5GpioSessionFailure(r,3)
    if (!c5GpioSessionInactive(r)) {
        if (!c5GpioSessionTrigger(false)) return c5GpioSessionFailure(r,3)
        c5SleepRecordWrite(r,4,5);return 5
    }
    c5SleepRecordWrite(r,4,1);return 1
}
@section(".iram1.abla.c5GpioSession")
trusted fun esp32C5GpioWakeSessionOpenOwned(r: NativeBuffer,pin: int,high: bool,exclusive: bool): int {
    if (!exclusive || pin < 0 || pin > 28 || !r.hasAddressRange(0,32) ||
        (r.addressValue()&3) != 0 || c5SleepRecordRead(r,0) != 0) return 2
    var offset=4
    while (offset < 32) { c5SleepRecordWrite(r,offset,0);offset=offset+4 }
    c5SleepRecordWrite(r,28,pin|(if (high) 64 else 0))
    c5SleepRecordWrite(r,20,c5GpioWakeRead(0x600b012c)&4)
    c5SleepRecordWrite(r,4,3);c5SleepRecordWrite(r,0,0x43354757)
    if (!c5GpioSessionTrigger(false)) return c5GpioSessionFailure(r,1)
    val pad=esp32C5GpioWakeOpenOwned(pin,high,true)
    c5SleepRecordWrite(r,16,pad|0)
    if (pad.status() != 1) return c5GpioSessionFailure(r,2)
    c5SleepRecordWrite(r,4,5)
    return esp32C5GpioWakeSessionArmOwned(r,true)
}
@section(".iram1.abla.c5GpioSession")
trusted fun esp32C5GpioWakeSessionCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !c5GpioSessionValid(r)) return 2
    if (c5SleepRecordRead(r,4) == 4) return 4
    val state=c5SleepRecordRead(r,4)
    if (state != 1 && state != 3 && state != 5 && state != 6) return 2
    c5SleepRecordWrite(r,4,6)
    if (c5SleepRecordRead(r,12) == 0) {
        if (!c5GpioSessionTrigger(false)) return 3
        c5SleepRecordWrite(r,12,1)
    }
    if (c5SleepRecordRead(r,12) == 1) {
        val pad=C5GpioWake(c5SleepRecordRead(r,16))
        if (pad.hasSnapshot()) {
            val closed=pad.closeOwned(true);c5SleepRecordWrite(r,16,closed|0)
            if (closed.status() != 5) return 3
        }
        c5SleepRecordWrite(r,12,2)
    }
    if (c5SleepRecordRead(r,12) != 2) return 2
    if (!c5GpioSessionTrigger(c5SleepRecordRead(r,20) != 0)) return 3
    c5SleepRecordWrite(r,12,3);c5SleepRecordWrite(r,4,4);return 4
}
