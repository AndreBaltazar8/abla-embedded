import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkIoMuxSupportOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredIoMuxSetClockSource", "io_mux_set_clock_source")) return false
    if (!internalFunction("esp32RecoveredIoMuxIsLpIoInUse", "io_mux_is_lp_io_in_use")) return false
    true
}
