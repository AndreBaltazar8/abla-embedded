trusted fun esp32GpioHold(pin: u32, enable: bool): u32 {
    if (!esp32GpioOutputValid(pin)) return esp32GpioNotSupported
    if (esp32GpioRtcValid(pin)) {
        if (enable) return esp32RecoveredRtcGpioHoldEn(
            pin, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
        return esp32RecoveredRtcGpioHoldDis(
            pin, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
    }
    val holdMask = esp32GpioLoadU32(esp32Data_GPIO_HOLD_MASK_49b45cf602 + (pin << u32(2)))
    if (holdMask == u32(0)) return esp32GpioNotSupported
    esp32GpioEnterCritical()
    esp32GpioUpdateRegister(u32(0x3ff48474), holdMask,
        if (enable) holdMask else u32(0))
    esp32GpioExitCritical()
    return esp32GpioOk
}

trusted fun esp32GpioDeepSleepHold(enable: bool): void {
    esp32GpioEnterCritical()
    if (enable) {
        esp32GpioUpdateRegister(u32(0x3ff48088), u32(1) << u32(14), u32(1) << u32(11))
    } else {
        esp32GpioUpdateRegister(u32(0x3ff48088), u32(1) << u32(11), u32(0))
    }
    esp32GpioExitCritical()
    return
}

trusted fun esp32GpioSleepBit(pin: u32, bit: u32, enable: bool, outputOnly: bool): u32 {
    if (!esp32GpioValid(pin) || (enable && outputOnly && !esp32GpioOutputValid(pin)))
        return esp32GpioInvalidArgument
    esp32GpioUpdateIomux(pin, u32(1) << bit,
        if (enable) u32(1) << bit else u32(0))
    return esp32GpioOk
}

trusted fun esp32GpioSleepDirection(pin: u32, mode: u32): u32 {
    if (!esp32GpioValid(pin) || ((mode & u32(2)) != u32(0) && !esp32GpioOutputValid(pin)))
        return esp32GpioInvalidArgument
    esp32GpioSleepBit(pin, u32(4), (mode & u32(1)) != u32(0), false)
    esp32GpioSleepBit(pin, u32(0), (mode & u32(2)) != u32(0), true)
    return esp32GpioOk
}

trusted fun esp32GpioSleepPullMode(pin: u32, pull: u32): u32 {
    if (!esp32GpioValid(pin) || pull > u32(3)) return esp32GpioInvalidArgument
    val pullup = pull == u32(0) || pull == u32(2)
    val pulldown = pull == u32(1) || pull == u32(2)
    esp32GpioSleepBit(pin, u32(3), pullup, false)
    esp32GpioSleepBit(pin, u32(2), pulldown, false)
    return esp32GpioOk
}

trusted fun esp32GpioGetConfiguration(pin: u32, output: u32): u32 {
    if (!esp32GpioValid(pin) || output == u32(0)) return esp32GpioInvalidArgument
    val iomux = xtensaDeviceLoadU32(esp32GpioIoMuxAddress(pin))
    val bit = u32(1) << (pin & u32(31))
    val enable = xtensaDeviceLoadU32(
        esp32GpioDevice + if (pin < u32(32)) u32(0x20) else u32(0x2c))
    val selection = xtensaDeviceLoadU32(esp32GpioOutputSelectionRegister(pin))
    val pinConfiguration = xtensaDeviceLoadU32(esp32GpioPinRegister(pin))
    esp32GpioStoreU32(output, (iomux >>> u32(12)) & u32(7))
    esp32GpioStoreU32(output + u32(4), selection & u32(0x1ff))
    esp32GpioStoreU32(output + u32(8), (iomux >>> u32(10)) & u32(3))
    esp32GpioStoreU8(output + u32(12), (iomux >>> u32(8)) & u32(1))
    esp32GpioStoreU8(output + u32(13), (iomux >>> u32(7)) & u32(1))
    esp32GpioStoreU8(output + u32(14), (iomux >>> u32(9)) & u32(1))
    esp32GpioStoreU8(output + u32(15), if ((enable & bit) != u32(0)) u32(1) else u32(0))
    esp32GpioStoreU8(output + u32(16), if ((selection & (u32(1) << u32(10))) == u32(0)) u32(1) else u32(0))
    esp32GpioStoreU8(output + u32(17), (selection >>> u32(11)) & u32(1))
    esp32GpioStoreU8(output + u32(18), (pinConfiguration >>> u32(2)) & u32(1))
    esp32GpioStoreU8(output + u32(19), (iomux >>> u32(1)) & u32(1))
    return esp32GpioOk
}

trusted fun esp32GpioPrint(
    stream: u32, format: u32, first: u32, second: u32, third: u32, fourth: u32
): void {
    esp32RecoveredFprintf(
        stream, format, first, second, third, fourth,
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp32GpioDumpConfiguration(stream: u32, lowMask: u32, highMask: u32): u32 {
    if (stream == u32(0) || !esp32GpioMaskValid(lowMask, highMask))
        return esp32GpioInvalidArgument
    esp32GpioPrint(stream, u32(nativeCStringAddress("================IO DUMP Start================\n")),
        u32(0), u32(0), u32(0), u32(0))
    val configuration = u32(nativeStackAllocate(20))
    var pin = u32(0)
    while (pin < u32(40)) {
        val selected = if (pin < u32(32))
            ((lowMask >>> pin) & u32(1)) != u32(0)
        else ((highMask >>> (pin - u32(32))) & u32(1)) != u32(0)
        if (selected) {
            esp32GpioGetConfiguration(pin, configuration)
            esp32GpioPrint(stream, u32(nativeCStringAddress("IO[%u] -\n")),
                pin, u32(0), u32(0), u32(0))
            esp32GpioPrint(stream, u32(nativeCStringAddress("  Pullup: %u, Pulldown: %u, DriveCap: %u\n")),
                esp32GpioLoadU8(configuration + u32(12)),
                esp32GpioLoadU8(configuration + u32(13)),
                esp32GpioLoadU32(configuration + u32(8)), u32(0))
            esp32GpioPrint(stream, u32(nativeCStringAddress("  InputEn: %u, OutputEn: %u, OpenDrain: %u\n")),
                esp32GpioLoadU8(configuration + u32(14)),
                esp32GpioLoadU8(configuration + u32(15)),
                esp32GpioLoadU8(configuration + u32(18)), u32(0))
            esp32GpioPrint(stream, u32(nativeCStringAddress("  FuncSel: %u, MatrixOut: %u, SleepSelEn: %u\n\n")),
                esp32GpioLoadU32(configuration),
                esp32GpioLoadU32(configuration + u32(4)),
                esp32GpioLoadU8(configuration + u32(19)), u32(0))
        }
        pin = pin + u32(1)
    }
    esp32GpioPrint(stream, u32(nativeCStringAddress("=================IO DUMP End=================\n")),
        u32(0), u32(0), u32(0), u32(0))
    return esp32GpioOk
}

