    esp32GpioUpdateIomux(pin, u32(3) << u32(10), (strength & u32(3)) << u32(10))
    esp32GpioExitCritical()
    return esp32GpioOk
}

trusted fun esp32GpioGetDrive(pin: u32, output: u32): u32 {
    if (!esp32GpioOutputValid(pin) || output == u32(0))
