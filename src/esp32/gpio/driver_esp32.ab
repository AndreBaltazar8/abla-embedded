// Complete ESP32 GPIO driver in structured Abla. All GPIO policy, register
// access, ISR dispatch, and configuration flow is visible to LLVM. The only
// target-specific operations below are device-memory barriers and CPU identity
// supplied by the reusable Xtensa layer.

val esp32GpioDevice = u32(0x3ff44000)
val esp32GpioOk = u32(0)
val esp32GpioInvalidArgument = u32(258)
val esp32GpioNoMemory = u32(257)
val esp32GpioInvalidState = u32(259)
val esp32GpioNotFound = u32(261)
val esp32GpioNotSupported = u32(262)
val esp32GpioPinFunction = u32(2)
val esp32GpioOutputSignal = u32(256)
val esp32GpioIsrCoreUninitialized = u32(3)

val esp32Data_Labla_recovered_esp32_gpio_driver_data_data_gpio_hal_gpio_hal_65f573d706Storage =
    nativeStaticMutableU32s([int(esp32GpioDevice)])
val esp32Data_Labla_recovered_esp32_gpio_driver_data_data_gpio_hal_gpio_hal_65f573d706 =
    u32(esp32Data_Labla_recovered_esp32_gpio_driver_data_data_gpio_hal_gpio_hal_65f573d706Storage)

val esp32Data_Labla_recovered_esp32_gpio_driver_data_data_gpio_context_gpio_context_8661a02bccStorage =
    nativeStaticMutableU32s([
        int(esp32Data_Labla_recovered_esp32_gpio_driver_data_data_gpio_hal_gpio_hal_65f573d706),
        3007315967, 0, 3, 0, 0, 0, 0
    ])
val esp32Data_Labla_recovered_esp32_gpio_driver_data_data_gpio_context_gpio_context_8661a02bcc =
    u32(esp32Data_Labla_recovered_esp32_gpio_driver_data_data_gpio_context_gpio_context_8661a02bccStorage)

@inline
trusted fun esp32GpioLoadU32(address: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32GpioStoreU32(address: u32, value: u32): void {
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))
    return
}

@inline
trusted fun esp32GpioLoadU8(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32GpioStoreU8(address: u32, value: u32): void {
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))
    return
}

@inline
fun esp32GpioValid(pin: u32): bool =
    pin < u32(40) &&
    pin != u32(24) &&
    !(pin >= u32(28) && pin <= u32(31))

@inline
fun esp32GpioOutputValid(pin: u32): bool =
    esp32GpioValid(pin) && pin < u32(34)

@inline
fun esp32GpioOutputMaskValid(low: u32, high: u32): bool =
    (low & u32(0xf1000000)) == u32(0) && (high & u32(0xfffffffc)) == u32(0)

@inline
fun esp32GpioMaskValid(low: u32, high: u32): bool =
    (low & u32(0xf1000000)) == u32(0) && (high & u32(0xffffff00)) == u32(0)

@inline
fun esp32GpioPinRegister(pin: u32): u32 =
    esp32GpioDevice + u32(0x88) + (pin << u32(2))

@inline
fun esp32GpioOutputSelectionRegister(pin: u32): u32 =
    esp32GpioDevice + u32(0x530) + (pin << u32(2))

@inline
fun esp32GpioContext(): u32 =
    esp32Data_Labla_recovered_esp32_gpio_driver_data_data_gpio_context_gpio_context_8661a02bcc

@inline
fun esp32GpioHalContext(): u32 =
    esp32Data_Labla_recovered_esp32_gpio_driver_data_data_gpio_hal_gpio_hal_65f573d706

@inline
trusted fun esp32GpioEnterCritical(): void {
    esp32RecoveredXPortEnterCriticalTimeout(esp32GpioContext() + u32(4), u32(0xffffffff))
    return
}

@inline
trusted fun esp32GpioExitCritical(): void {
    esp32RecoveredVPortExitCritical(esp32GpioContext() + u32(4))
    return
}

@inline
trusted fun esp32GpioUpdateIomux(pin: u32, clearMask: u32, setMask: u32): void =
    esp32GpioUpdateRegister(esp32GpioIoMuxAddress(pin), clearMask, setMask)

@inline
trusted fun esp32GpioUpdatePin(pin: u32, clearMask: u32, setMask: u32): void =
    esp32GpioUpdateRegister(esp32GpioPinRegister(pin), clearMask, setMask)

@inline
trusted fun esp32GpioRtcValid(pin: u32): bool =
    esp32RecoveredRtcGpioIsValidGpio(
        pin, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    ) != u32(0)

@inline
trusted fun esp32GpioRtcPullup(pin: u32, enable: bool): u32 {
    if (enable) return esp32RecoveredRtcGpioPullupEn(
        pin, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return esp32RecoveredRtcGpioPullupDis(
        pin, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
}

@inline
trusted fun esp32GpioRtcPulldown(pin: u32, enable: bool): u32 {
    if (enable) return esp32RecoveredRtcGpioPulldownEn(
        pin, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return esp32RecoveredRtcGpioPulldownDis(
        pin, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
}

trusted fun esp32GpioPullup(pin: u32, enable: bool): u32 {
    if (!esp32GpioValid(pin) || (enable && !esp32GpioOutputValid(pin)))
        return esp32GpioInvalidArgument
    if (esp32GpioRtcValid(pin)) return esp32GpioRtcPullup(pin, enable)
    esp32GpioEnterCritical()
    esp32GpioUpdateIomux(pin, u32(1) << u32(8),
        if (enable) u32(1) << u32(8) else u32(0))
    esp32GpioExitCritical()
    return esp32GpioOk
}

trusted fun esp32GpioPulldown(pin: u32, enable: bool): u32 {
    if (!esp32GpioValid(pin) || (enable && !esp32GpioOutputValid(pin)))
        return esp32GpioInvalidArgument
    if (esp32GpioRtcValid(pin)) return esp32GpioRtcPulldown(pin, enable)
    esp32GpioEnterCritical()
    esp32GpioUpdateIomux(pin, u32(1) << u32(7),
        if (enable) u32(1) << u32(7) else u32(0))
    esp32GpioExitCritical()
    return esp32GpioOk
}

trusted fun esp32GpioSetInterruptType(pin: u32, interruptType: u32): u32 {
    if (!esp32GpioValid(pin) || interruptType >= u32(6))
        return esp32GpioInvalidArgument
    esp32GpioEnterCritical()
    esp32GpioUpdatePin(pin, u32(7) << u32(7), (interruptType & u32(7)) << u32(7))
    val wordOffset = if (pin < u32(32)) u32(24) else u32(28)
    val bit = u32(1) << (pin & u32(31))
    val address = esp32GpioContext() + wordOffset
    var mask = esp32GpioLoadU32(address)
    if (interruptType >= u32(1) && interruptType <= u32(3)) mask = mask | bit
    else mask = mask & ~bit
    esp32GpioStoreU32(address, mask)
    esp32GpioExitCritical()
    return esp32GpioOk
}

trusted fun esp32GpioInterruptEnableOnCore(pin: u32, core: u32): u32 {
    esp32RecoveredGpioHalIntrEnableOnCore(esp32GpioHalContext(), pin, core)
    return esp32GpioOk
}

trusted fun esp32GpioInterruptEnable(pin: u32): u32 {
    if (!esp32GpioValid(pin)) return esp32GpioInvalidArgument
    esp32GpioEnterCritical()
    var core = esp32GpioLoadU32(esp32GpioContext() + u32(12))
    if (core == esp32GpioIsrCoreUninitialized) {
        core = cpuCoreId()
        esp32GpioStoreU32(esp32GpioContext() + u32(12), core)
    }
    esp32GpioExitCritical()
    return esp32GpioInterruptEnableOnCore(pin, core)
}

trusted fun esp32GpioInterruptDisable(pin: u32): u32 {
    if (!esp32GpioValid(pin)) return esp32GpioInvalidArgument
    esp32RecoveredGpioHalIntrDisable(esp32GpioHalContext(), pin)
    return esp32GpioOk
}

trusted fun esp32GpioInput(pin: u32, enable: bool): u32 {
    if (!esp32GpioValid(pin)) return esp32GpioInvalidArgument
    esp32GpioUpdateIomux(pin, u32(1) << u32(9),
        if (enable) u32(1) << u32(9) else u32(0))
    return esp32GpioOk
}

trusted fun esp32GpioOutput(pin: u32, enable: bool): u32 {
    if (!esp32GpioValid(pin) || (enable && !esp32GpioOutputValid(pin)))
        return esp32GpioInvalidArgument
    val mask = u32(1) << (pin & u32(31))
    if (enable) {
        esp32GpioUpdateRegister(
            esp32GpioOutputSelectionRegister(pin), u32(0x3ff), esp32GpioOutputSignal)
        xtensaDeviceStoreU32(
            esp32GpioDevice + (if (pin < u32(32)) u32(0x24) else u32(0x30)), mask)
    } else {
        xtensaDeviceStoreU32(
            esp32GpioDevice + (if (pin < u32(32)) u32(0x28) else u32(0x34)), mask)
        esp32GpioUpdateRegister(
            esp32GpioOutputSelectionRegister(pin), u32(0xc00), u32(1) << u32(10))
    }
    esp32GpioSelectFunction(pin, esp32GpioPinFunction)
    return esp32GpioOk
}

trusted fun esp32GpioOpenDrain(pin: u32, enable: bool): u32 {
    if (!esp32GpioValid(pin)) return esp32GpioInvalidArgument
    esp32GpioUpdatePin(pin, u32(1) << u32(2),
        if (enable) u32(1) << u32(2) else u32(0))
    return esp32GpioOk
}

trusted fun esp32GpioSetLevel(pin: u32, level: u32): u32 {
    if (!esp32GpioOutputValid(pin)) return esp32GpioInvalidArgument
    val high = pin >= u32(32)
    val offset = if (level != u32(0)) {
        if (high) u32(0x14) else u32(0x08)
    } else {
        if (high) u32(0x18) else u32(0x0c)
    }
    xtensaDeviceStoreU32(esp32GpioDevice + offset, u32(1) << (pin & u32(31)))
    return esp32GpioOk
}

trusted fun esp32GpioGetLevel(pin: u32): u32 {
    val value = xtensaDeviceLoadU32(
        esp32GpioDevice + if (pin < u32(32)) u32(0x3c) else u32(0x40))
    return (value >>> (pin & u32(31))) & u32(1)
}

trusted fun esp32GpioSetPullMode(pin: u32, pull: u32): u32 {
    if (!esp32GpioValid(pin) || pull > u32(3)) return esp32GpioInvalidArgument
    when (pull) {
        0 -> { esp32GpioPulldown(pin, false); return esp32GpioPullup(pin, true) }
        1 -> { esp32GpioPulldown(pin, true); return esp32GpioPullup(pin, false) }
        2 -> { esp32GpioPulldown(pin, true); return esp32GpioPullup(pin, true) }
        else -> { esp32GpioPulldown(pin, false); return esp32GpioPullup(pin, false) }
    }
}

trusted fun esp32GpioSetDirection(pin: u32, mode: u32): u32 {
    if (!esp32GpioValid(pin) || ((mode & u32(2)) != u32(0) && !esp32GpioOutputValid(pin)))
        return esp32GpioInvalidArgument
    esp32GpioInput(pin, (mode & u32(1)) != u32(0))
    esp32GpioOutput(pin, (mode & u32(2)) != u32(0))
    esp32GpioOpenDrain(pin, (mode & u32(4)) != u32(0))
    return esp32GpioOk
}

trusted fun esp32GpioRtcDeinitialize(pin: u32): void {
    if (esp32GpioRtcValid(pin)) esp32RecoveredRtcGpioDeinit(
        pin, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp32GpioConfigure(configuration: u32): u32 {
    if (configuration == u32(0)) return esp32GpioInvalidArgument
    val lowMask = esp32GpioLoadU32(configuration)
    val highMask = esp32GpioLoadU32(configuration + u32(4))
    if ((lowMask | highMask) == u32(0) || !esp32GpioMaskValid(lowMask, highMask))
        return esp32GpioInvalidArgument
    val mode = esp32GpioLoadU32(configuration + u32(8))
    if ((mode & u32(2)) != u32(0) && !esp32GpioOutputMaskValid(lowMask, highMask))
        return esp32GpioInvalidArgument
    val pullup = esp32GpioLoadU32(configuration + u32(12)) != u32(0)
    val pulldown = esp32GpioLoadU32(configuration + u32(16)) != u32(0)
    val interruptType = esp32GpioLoadU32(configuration + u32(20))
    var pin = u32(0)
    while (pin < u32(40)) {
        val selected = if (pin < u32(32))
            ((lowMask >>> pin) & u32(1)) != u32(0)
        else ((highMask >>> (pin - u32(32))) & u32(1)) != u32(0)
        if (selected) {
            esp32GpioRtcDeinitialize(pin)
            esp32GpioInput(pin, (mode & u32(1)) != u32(0))
            esp32GpioOpenDrain(pin, (mode & u32(4)) != u32(0))
            esp32GpioOutput(pin, (mode & u32(2)) != u32(0))
            esp32GpioPullup(pin, pullup)
            esp32GpioPulldown(pin, pulldown)
            esp32GpioSetInterruptType(pin, interruptType)
            if (interruptType != u32(0)) esp32GpioInterruptEnable(pin)
            else esp32GpioInterruptDisable(pin)
            esp32GpioSelectFunction(pin, esp32GpioPinFunction)
        }
        pin = pin + u32(1)
    }
    return esp32GpioOk
}

trusted fun esp32GpioConfigureAnalog(pin: u32): u32 {
    if (!esp32GpioValid(pin)) return esp32GpioInvalidArgument
    esp32GpioInput(pin, false)
    esp32GpioOutput(pin, false)
    esp32GpioPullup(pin, false)
    esp32GpioPulldown(pin, false)
    esp32GpioSelectFunction(pin, esp32GpioPinFunction)
    esp32GpioRtcDeinitialize(pin)
    return esp32GpioOk
}

trusted fun esp32GpioReset(pin: u32): u32 {
    if (!esp32GpioValid(pin)) return esp32GpioInvalidArgument
    esp32GpioInterruptDisable(pin)
    if (esp32GpioOutputValid(pin)) esp32GpioPullup(pin, true)
    esp32GpioPulldown(pin, false)
    esp32GpioInput(pin, false)
    esp32GpioOutput(pin, false)
    esp32GpioRtcDeinitialize(pin)
    esp32GpioSelectFunction(pin, esp32GpioPinFunction)
    esp32RecoveredEspGpioRevoke(
        if (pin < u32(32)) u32(1) << pin else u32(0),
        if (pin >= u32(32)) u32(1) << (pin - u32(32)) else u32(0),
        u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return esp32GpioOk
}

@inline
fun esp32GpioLowestBit(value: u32): u32 {
    var bit = u32(0)
    var remaining = value
    while ((remaining & u32(1)) == u32(0)) {
        remaining = remaining >>> u32(1)
        bit = bit + u32(1)
    }
    return bit
}

@section(".iram1.abla.gpio.isr_loop")
trusted fun esp32GpioIsrLoop(statusValue: u32, firstPin: u32): void {
    var status = statusValue
    while (status != u32(0)) {
        val bit = esp32GpioLowestBit(status)
        status = status & ~(u32(1) << bit)
        val pin = firstPin + bit
        val clearWord = if (pin < u32(32)) u32(24) else u32(28)
        val clearBefore =
            (esp32GpioLoadU32(esp32GpioContext() + clearWord) &
             (u32(1) << (pin & u32(31)))) != u32(0)
        if (clearBefore) esp32GpioClearInterruptStatus(esp32GpioDevice, pin)
        val table = esp32GpioLoadU32(esp32GpioContext() + u32(16))
        val function = esp32GpioLoadU32(table + (pin << u32(3)))
        if (function != u32(0)) {
            val argument = esp32GpioLoadU32(table + (pin << u32(3)) + u32(4))
            ablaUnsafeCallVoidI32(int(function), int(argument))
        }
        if (!clearBefore) esp32GpioClearInterruptStatus(esp32GpioDevice, pin)
    }
    return
}

@section(".iram1.abla.gpio.interrupt_service")
trusted fun esp32GpioInterruptService(argument: u32): void {
    if (esp32GpioLoadU32(esp32GpioContext() + u32(16)) == u32(0)) return
    val core = esp32GpioLoadU32(esp32GpioContext() + u32(12))
    val lowStatus = xtensaDeviceLoadU32(
        esp32GpioDevice + if (core == u32(0)) u32(0x68) else u32(0x60))
    if (lowStatus != u32(0)) esp32GpioIsrLoop(lowStatus, u32(0))
    val highStatus = xtensaDeviceLoadU32(
        esp32GpioDevice + if (core == u32(0)) u32(0x7c) else u32(0x74)) & u32(255)
    if (highStatus != u32(0)) esp32GpioIsrLoop(highStatus, u32(32))
    return
}

trusted fun esp32GpioInterruptRegisterOnCore(parameter: u32): void {
    val result = esp32RecoveredEspIntrAlloc(
        esp32GpioLoadU32(parameter),
        esp32GpioLoadU32(parameter + u32(4)),
        esp32GpioLoadU32(parameter + u32(8)),
        esp32GpioLoadU32(parameter + u32(12)),
        esp32GpioLoadU32(parameter + u32(16)),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    esp32GpioStoreU32(parameter + u32(20), result)
    return
}

trusted fun esp32GpioIsrRegister(
    function: u32, argument: u32, flags: u32, handle: u32
): u32 {
    if (function == u32(0)) return esp32GpioInvalidArgument
    val parameters = u32(nativeStackAllocate(24))
    esp32GpioStoreU32(parameters, u32(22))
    esp32GpioStoreU32(parameters + u32(4), flags)
    esp32GpioStoreU32(parameters + u32(8), function)
    esp32GpioStoreU32(parameters + u32(12), argument)
    esp32GpioStoreU32(parameters + u32(16), handle)
    esp32GpioStoreU32(parameters + u32(20), esp32GpioOk)
    esp32GpioEnterCritical()
    var core = esp32GpioLoadU32(esp32GpioContext() + u32(12))
    if (core == esp32GpioIsrCoreUninitialized) {
        core = cpuCoreId()
        esp32GpioStoreU32(esp32GpioContext() + u32(12), core)
    }
    esp32GpioExitCritical()
    val ipcResult = esp32RecoveredEspIpcCallBlocking(
        core, u32(nativeFunctionAddress(esp32GpioInterruptRegisterOnCore)), parameters,
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (ipcResult != esp32GpioOk || esp32GpioLoadU32(parameters + u32(20)) != esp32GpioOk)
        return esp32GpioNotFound
    return esp32GpioOk
}

trusted fun esp32GpioUninstallIsrService(): u32 {
    esp32GpioEnterCritical()
    val table = esp32GpioLoadU32(esp32GpioContext() + u32(16))
    if (table == u32(0)) {
        esp32GpioExitCritical()
        return esp32GpioOk
    }
    val handle = esp32GpioLoadU32(esp32GpioContext() + u32(20))
    esp32GpioStoreU32(esp32GpioContext() + u32(16), u32(0))
    esp32GpioStoreU32(esp32GpioContext() + u32(20), u32(0))
    esp32GpioStoreU32(esp32GpioContext() + u32(12), esp32GpioIsrCoreUninitialized)
    esp32GpioExitCritical()
    esp32RecoveredEspIntrFree(
        handle, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    esp32LibcFree(table)
    return esp32GpioOk
}

trusted fun esp32GpioInstallIsrService(flags: u32): u32 {
    if (esp32GpioLoadU32(esp32GpioContext() + u32(16)) != u32(0))
        return esp32GpioInvalidState
    val capabilities = if ((flags & u32(1024)) != u32(0)) u32(2048) else u32(4096)
    val table = esp32HeapCapsCallocate(u32(40), u32(8), capabilities)
    if (table == u32(0)) return esp32GpioNoMemory
    esp32GpioEnterCritical()
    if (esp32GpioLoadU32(esp32GpioContext() + u32(16)) != u32(0)) {
        esp32GpioExitCritical()
        esp32LibcFree(table)
        return esp32GpioInvalidState
    }
    esp32GpioStoreU32(esp32GpioContext() + u32(16), table)
    esp32GpioExitCritical()
    val result = esp32GpioIsrRegister(
        u32(nativeFunctionAddress(esp32GpioInterruptService)), u32(0), flags,
        esp32GpioContext() + u32(20))
    if (result != esp32GpioOk) esp32GpioUninstallIsrService()
    return result
}

trusted fun esp32GpioIsrHandlerAdd(pin: u32, function: u32, argument: u32): u32 {
    val table = esp32GpioLoadU32(esp32GpioContext() + u32(16))
    if (table == u32(0)) return esp32GpioInvalidState
    if (!esp32GpioValid(pin)) return esp32GpioInvalidArgument
    esp32GpioEnterCritical()
    esp32GpioInterruptDisable(pin)
    esp32GpioStoreU32(table + (pin << u32(3)), function)
    esp32GpioStoreU32(table + (pin << u32(3)) + u32(4), argument)
    val handle = esp32GpioLoadU32(esp32GpioContext() + u32(20))
    val core = esp32RecoveredEspIntrGetCpu(
        handle, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    esp32GpioInterruptEnableOnCore(pin, core)
    esp32GpioExitCritical()
    return esp32GpioOk
}

trusted fun esp32GpioIsrHandlerRemove(pin: u32): u32 {
    val table = esp32GpioLoadU32(esp32GpioContext() + u32(16))
    if (table == u32(0)) return esp32GpioInvalidState
    if (!esp32GpioValid(pin)) return esp32GpioInvalidArgument
    esp32GpioEnterCritical()
    esp32GpioInterruptDisable(pin)
    esp32GpioStoreU32(table + (pin << u32(3)), u32(0))
    esp32GpioStoreU32(table + (pin << u32(3)) + u32(4), u32(0))
    esp32GpioExitCritical()
    return esp32GpioOk
}

trusted fun esp32GpioWakeup(pin: u32, interruptType: u32, enable: bool): u32 {
    if (!esp32GpioValid(pin)) return esp32GpioInvalidArgument
    if (enable && interruptType != u32(4) && interruptType != u32(5))
        return esp32GpioInvalidArgument
    var result = esp32GpioOk
    if (esp32GpioRtcValid(pin)) {
        result = if (enable) esp32RecoveredRtcGpioWakeupEnable(
            pin, interruptType, u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        ) else esp32RecoveredRtcGpioWakeupDisable(
            pin, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
    }
    esp32GpioEnterCritical()
    if (enable) {
        esp32GpioUpdatePin(pin, u32(7) << u32(7), interruptType << u32(7))
        esp32GpioUpdatePin(pin, u32(1) << u32(10), u32(1) << u32(10))
    } else {
        esp32GpioUpdatePin(pin, u32(1) << u32(10), u32(0))
    }
    esp32GpioExitCritical()
    return result
}

trusted fun esp32GpioSetDrive(pin: u32, strength: u32): u32 {
    if (!esp32GpioOutputValid(pin) || strength >= u32(4))
        return esp32GpioInvalidArgument
    if (esp32GpioRtcValid(pin)) return esp32RecoveredRtcGpioSetDriveCapability(
        pin, strength, u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
