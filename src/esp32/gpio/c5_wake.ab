import "./c5_wake_sequence.ab"
import "abla/unsafe/mmio"
trusted fun c5WakeLoad(address: int): int = mmioLoadU32(address)
trusted fun c5WakeStore(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun esp32C5ConfigureGpio4WakeInput(): bool = esp32C5ConfigureGpio4WakeInputOwned()
trusted fun esp32C5Gpio4WakeLevel(): bool = esp32C5Gpio4WakeLevelOwned()
