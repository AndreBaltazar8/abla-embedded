// Temporary C3 digital GPIO pulldown sample, pins6..21 only (no RTCIO mux).
// Exclusive caller has stopped peripheral/interrupt users of this pad; this
// is not safe on a running UART/flash bus. Clock owner initialized ROM delay.
// Return0low/1high,-1invalid/notexclusive,-2held,-3setup readback mismatch,
// -4restore mismatch (caller retains ownership and repairs before reuse).
// Restore mux, matrix output
// configuration and enable state; never change output latch or other pins.
trusted fun esp32C3GpioPulldownProbeOwned(pin: int,exclusive: bool): int {
    if (!exclusive || pin < 6 || pin > 21) return -1
    val mask=1<<pin
    if ((esp32C3ProbeRead(0x600080D4)&mask) != 0 || (esp32C3ProbeRead(0x6000808C)&0x8000) != 0) return -2
    val mux=0x60009004+pin*4
    val route=0x60004554+pin*4
    val savedMux=esp32C3ProbeRead(mux)
    val savedRoute=esp32C3ProbeRead(route)
    val enabled=(esp32C3ProbeRead(0x60004020)&mask) != 0
    esp32C3ProbeWrite(0x60004028,mask)
    // Select software output enable (disabled), non-inverted. Preserve route.
    esp32C3ProbeWrite(route,(savedRoute & ~0x400)|0x200)
    esp32C3ProbeWrite(mux,(savedMux & ~0x7180)|0x1280)
    val configured=esp32C3ProbeRead(mux) == ((savedMux & ~0x7180)|0x1280) &&
        esp32C3ProbeRead(route) == ((savedRoute & ~0x400)|0x200) &&
        (esp32C3ProbeRead(0x60004020)&mask) == 0
    var sample=-3
    if (configured) {
        esp32C3ProbeDelay()
        sample=if ((esp32C3ProbeRead(0x6000403C)&mask) != 0) 1 else 0
    }
    esp32C3ProbeWrite(mux,savedMux)
    esp32C3ProbeWrite(route,savedRoute)
    esp32C3ProbeWrite(if (enabled) 0x60004024 else 0x60004028,mask)
    if (esp32C3ProbeRead(mux) != savedMux || esp32C3ProbeRead(route) != savedRoute ||
        ((esp32C3ProbeRead(0x60004020)&mask) != 0) != enabled) return -4
    return sample
}
