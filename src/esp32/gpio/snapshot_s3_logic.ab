import "./s3_logic.ab"
// Digital fields: mux8,matrixout12@8,OD20,OE21,latch22,pin6@23,valid29.
// RTC/USB/holds and global input-signal routing require separate ownership.
import "./s3gpiosnapshot_type.ab"
import "../../hal/s3gpiosnapshot.ab"
@export("abla_s3gpiosnapshot_pin")
fun s3GpioSnapshotPinHook(recv: int): int = (S3GpioSnapshot(recv)>>23)&63
@export("abla_s3gpiosnapshot_valid")
fun s3GpioSnapshotValidHook(recv: int): bool = (S3GpioSnapshot(recv)>>>29) == 1 && espChipS3().gpioOutputValid(S3GpioSnapshot(recv).pin())
