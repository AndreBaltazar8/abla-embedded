import "./s3_logic.ab"
// Digital fields: mux8,matrixout12@8,OD20,OE21,latch22,pin6@23,valid29.
// RTC/USB/holds and global input-signal routing require separate ownership.
type S3GpioSnapshot = int
fun S3GpioSnapshot.pin(): int = (this>>23)&63
fun S3GpioSnapshot.valid(): bool = (this>>>29) == 1 && espChipS3().gpioOutputValid(this.pin())
