import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRtcGpioOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredRtcGpioIsValidGpio", "rtc_gpio_is_valid_gpio")) return false
    if (!exportFunction("esp32RecoveredRtcIoNumberGet", "rtc_io_number_get")) return false
    if (!internalFunction("esp32RecoveredRtcGpioInit", "rtc_gpio_init")) return false
    if (!internalFunction("esp32RecoveredRtcGpioSetLevel", "rtc_gpio_set_level")) return false
    if (!internalFunction("esp32RecoveredRtcGpioGetLevel", "rtc_gpio_get_level")) return false
    if (!internalFunction("esp32RecoveredRtcGpioSetDriveCapability", "rtc_gpio_set_drive_capability")) return false
    if (!internalFunction("esp32RecoveredRtcGpioGetDriveCapability", "rtc_gpio_get_drive_capability")) return false
    if (!internalFunction("esp32RecoveredRtcGpioSetDirection", "rtc_gpio_set_direction")) return false
    if (!internalFunction("esp32RecoveredRtcGpioSetDirectionInSleep", "rtc_gpio_set_direction_in_sleep")) return false
    if (!internalFunction("esp32RecoveredRtcGpioPullupEn", "rtc_gpio_pullup_en")) return false
    if (!internalFunction("esp32RecoveredRtcGpioPullupDis", "rtc_gpio_pullup_dis")) return false
    if (!internalFunction("esp32RecoveredRtcGpioPulldownEn", "rtc_gpio_pulldown_en")) return false
    if (!internalFunction("esp32RecoveredRtcGpioPulldownDis", "rtc_gpio_pulldown_dis")) return false
    if (!internalFunction("esp32RecoveredRtcGpioDeinit", "rtc_gpio_deinit")) return false
    if (!internalFunction("esp32RecoveredRtcGpioIomuxFuncSel", "rtc_gpio_iomux_func_sel")) return false
    if (!internalFunction("esp32RecoveredRtcGpioIomuxInput", "rtc_gpio_iomux_input")) return false
    if (!internalFunction("esp32RecoveredRtcGpioIomuxOutput", "rtc_gpio_iomux_output")) return false
    if (!internalFunction("esp32RecoveredRtcGpioHoldEn", "rtc_gpio_hold_en")) return false
    if (!internalFunction("esp32RecoveredRtcGpioHoldDis", "rtc_gpio_hold_dis")) return false
    if (!internalFunction("esp32RecoveredRtcGpioForceHoldEnAll", "rtc_gpio_force_hold_en_all")) return false
    if (!internalFunction("esp32RecoveredRtcGpioForceHoldDisAll", "rtc_gpio_force_hold_dis_all")) return false
    if (!internalFunction("esp32RecoveredRtcGpioIsolate", "rtc_gpio_isolate")) return false
    if (!internalFunction("esp32RecoveredRtcGpioWakeupEnable", "rtc_gpio_wakeup_enable")) return false
    if (!internalFunction("esp32RecoveredRtcGpioWakeupDisable", "rtc_gpio_wakeup_disable")) return false
    true
}
