import "../gpio_hold_p4_sequence.ab"
// Caller owns the pad and has stopped ALL HP/LP peripheral, interrupt and
// analog users. GPIO/IOMUX power and clocks are pinned, PMU global/sleep
// holds released, ROM delay calibrated. Never use on an active memory bus.
// Individual holds are checked; no hold or clock state is changed here.
// 0low/1high,-1invalid/not owned,-2held,-3setup failed,-4restore failed.
// On -4 retain ownership and repair pad state before resuming any user.
trusted fun esp32P4GpioPulldownProbeOwned(layout: int,pin: int,exclusive: bool): int {
    if (!exclusive || (layout != 1 && layout != 3) || pin < 0 || pin > 54) return -1
    if (esp32P4GpioIndividualHoldOwned(layout,pin) != 0) return -2
    val mask=u32(1)<<u32(pin&31)
    val enable=if (pin < 32) 32 else 44
    val mux=4100+pin*4
    val route=1368+pin*4
    val savedMux=p4GpioRead(mux)
    val savedRoute=p4GpioRead(route)
    val savedEnable=p4GpioRead(enable)&mask
    val lp=0x5012B008+pin*4
    val savedLp=if (pin < 16) p4GpioHoldRead(lp) else u32(0)
    val wantedMux=(savedMux & u32(0xFFFF8C7D))|u32(0x1280)
    val wantedRoute=(savedRoute & u32(0xFFFFF7FF))|u32(0x400)
    p4GpioWrite(enable+8,mask)
    var ready=(p4GpioRead(enable)&mask) == u32(0)
    if (ready) {
        p4GpioWrite(route,wantedRoute)
        p4GpioWrite(mux,wantedMux)
        ready=p4GpioRead(route) == wantedRoute && p4GpioRead(mux) == wantedMux
        if (ready && pin < 16) {
            p4GpioHoldWrite(lp,savedLp & u32(0xFFFFFFEF))
            if (p4GpioHoldRead(lp) != (savedLp & u32(0xFFFFFFEF))) ready=false
        }
    }
    var result=-3
    if (ready) {
        p4ProbeDelay()
        result=int((p4GpioRead(if (pin < 32) 60 else 64)&mask)>>u32(pin&31))
    }
    // Restore LP owner first, then HP routing; never change either latch.
    if (pin < 16) p4GpioHoldWrite(lp,savedLp)
    p4GpioWrite(mux,savedMux)
    p4GpioWrite(route,savedRoute)
    p4GpioWrite(if (savedEnable != u32(0)) enable+4 else enable+8,mask)
    var restored=p4GpioRead(mux) == savedMux && p4GpioRead(route) == savedRoute && (p4GpioRead(enable)&mask) == savedEnable
    if (pin < 16 && p4GpioHoldRead(lp) != savedLp) restored=false
    if (!restored) -4 else result
}
