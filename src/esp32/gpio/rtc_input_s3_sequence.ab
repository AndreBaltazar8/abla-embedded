import "./input_s3_sequence.ab"
// ESP-IDF6.0.2 esp32s3 rtc_io_ll.h + rtc_io_reg.h: RTCIO == GPIO0..21,
// OE bits10..31, pad mux bit19, input bit13, pulls27/28, individual hold bitN.
// Caller owns digital+RTC pad/configuration, has consumed wake events, disarmed
// wake/ULP/analog/XTAL32k/USB-OTG users, prevents sleep and pins the LP-IO clock.
// Never enables a shared clock or clears a global hold. USB Serial/JTAG active
// pins19/20 are rejected. Current RTC output must already be safe to disable.
// Stage digital input BEFORE detaching RTC and releasing this pin's hold.
// Keep ownership on failure; no rollback and no wake-status acknowledgement.
// Pull0up1down2both3floating. Status1ready2invalid3prerequisite4digitalsetup
// 5RTCoutputdisable6RTCmux/pulls7holdrelease.
trusted fun esp32S3RtcToDigitalInputOwned(pin: int,pull: int,exclusiveWakeDisarmed: bool): int {
    if (pin < 0 || pin > 21 || pull < 0 || pull > 3) return 2
    if (!exclusiveWakeDisarmed ||
        (esp32S3PinStateRead(0x60008904)&0x80000000) == 0 ||
        (esp32S3PinStateRead(0x60008088)&0x200000) != 0 ||
        (esp32S3PinStateRead(0x60008090)&0x8000) != 0) return 3
    if ((pin == 19 || pin == 20) && (esp32S3PinStateRead(0x60038018)&16384) != 0) return 3
    if (esp32S3GpioPrepareInputOwned(pin,pull,true) != 1) return 4
    val bit=1<<(pin+10)
    esp32S3PinStateWrite(0x60008414,bit)
    if ((esp32S3PinStateRead(0x6000840c)&bit) != 0) return 5
    // Clear RTC mux, input and pulls. Preserve drive/function/sleep fields.
    if (!esp32S3PinStateField(0x60008484+pin*4,0x18082000,0)) return 6
    if (!esp32S3PinStateField(0x600080d8,1<<pin,0)) return 7
    return 1
}
