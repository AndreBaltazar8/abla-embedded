import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkGpioDriverOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredGpioPullupEn", "gpio_pullup_en")) return false
    if (!internalFunction("esp32RecoveredGpioPullupDis", "gpio_pullup_dis")) return false
    if (!internalFunction("esp32RecoveredGpioPulldownEn", "gpio_pulldown_en")) return false
    if (!internalFunction("esp32RecoveredGpioPulldownDis", "gpio_pulldown_dis")) return false
    if (!internalFunction("esp32RecoveredGpioSetIntrType", "gpio_set_intr_type")) return false
    if (!internalFunction("esp32RecoveredGpioIntrEnable", "gpio_intr_enable")) return false
    if (!internalFunction("esp32RecoveredGpioIntrDisable", "gpio_intr_disable")) return false
    if (!internalFunction("esp32RecoveredGpioInputEnable", "gpio_input_enable")) return false
    if (!exportFunction("esp32RecoveredGpioOutputDisable", "gpio_output_disable")) return false
    if (!internalFunction("esp32RecoveredGpioOutputEnable", "gpio_output_enable")) return false
    if (!internalFunction("esp32RecoveredGpioOdDisable", "gpio_od_disable")) return false
    if (!internalFunction("esp32RecoveredGpioOdEnable", "gpio_od_enable")) return false
    if (!internalFunction("esp32RecoveredGpioSetLevel", "gpio_set_level")) return false
    if (!internalFunction("esp32RecoveredGpioGetLevel", "gpio_get_level")) return false
    if (!internalFunction("esp32RecoveredGpioSetPullMode", "gpio_set_pull_mode")) return false
    if (!internalFunction("esp32RecoveredGpioSetDirection", "gpio_set_direction")) return false
    if (!internalFunction("esp32RecoveredGpioConfig", "gpio_config")) return false
    if (!internalFunction("esp32RecoveredGpioConfigAsAnalog", "gpio_config_as_analog")) return false
    if (!internalFunction("esp32RecoveredGpioResetPin", "gpio_reset_pin")) return false
    if (!internalFunction("esp32RecoveredGpioIsrHandlerAdd", "gpio_isr_handler_add")) return false
    if (!internalFunction("esp32RecoveredGpioIsrHandlerRemove", "gpio_isr_handler_remove")) return false
    if (!internalFunction("esp32RecoveredGpioUninstallIsrService", "gpio_uninstall_isr_service")) return false
    if (!internalFunction("esp32RecoveredGpioIsrRegister", "gpio_isr_register")) return false
    if (!internalFunction("esp32RecoveredGpioInstallIsrService", "gpio_install_isr_service")) return false
    if (!internalFunction("esp32RecoveredGpioWakeupEnable", "gpio_wakeup_enable")) return false
    if (!internalFunction("esp32RecoveredGpioWakeupDisable", "gpio_wakeup_disable")) return false
    if (!internalFunction("esp32RecoveredGpioSetDriveCapability", "gpio_set_drive_capability")) return false
    if (!internalFunction("esp32RecoveredGpioGetDriveCapability", "gpio_get_drive_capability")) return false
    if (!internalFunction("esp32RecoveredGpioHoldEn", "gpio_hold_en")) return false
    if (!internalFunction("esp32RecoveredGpioHoldDis", "gpio_hold_dis")) return false
    if (!internalFunction("esp32RecoveredGpioDeepSleepHoldEn", "gpio_deep_sleep_hold_en")) return false
    if (!internalFunction("esp32RecoveredGpioDeepSleepHoldDis", "gpio_deep_sleep_hold_dis")) return false
    if (!exportFunction("esp32RecoveredGpioIomuxInput", "gpio_iomux_input")) return false
    if (!exportFunction("esp32RecoveredGpioIomuxOutput", "gpio_iomux_output")) return false
    if (!exportFunction("esp32RecoveredGpioMatrixInput", "gpio_matrix_input")) return false
    if (!exportFunction("esp32RecoveredGpioMatrixOutput", "gpio_matrix_output")) return false
    if (!exportFunction("esp32RecoveredGpioSleepSetDirection", "gpio_sleep_set_direction")) return false
    if (!exportFunction("esp32RecoveredGpioSleepSetPullMode", "gpio_sleep_set_pull_mode")) return false
    if (!exportFunction("esp32RecoveredGpioSleepSelEn", "gpio_sleep_sel_en")) return false
    if (!exportFunction("esp32RecoveredGpioSleepSelDis", "gpio_sleep_sel_dis")) return false
    if (!internalFunction("esp32RecoveredGpioGetIoConfig", "gpio_get_io_config")) return false
    if (!internalFunction("esp32RecoveredGpioDumpIoConfiguration", "gpio_dump_io_configuration")) return false
    if (!internalFunction("esp32RecoveredGpioFuncSel", "gpio_func_sel")) return false
    true
}
