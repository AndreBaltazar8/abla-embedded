import "./park_s3_sequence.ab"

// Checks the output latch, not the externally loaded pad voltage.
trusted fun esp32S3GpioWriteLevelOwned(number: int, high: bool): bool {
    if (!espChipS3().gpioOutputValid(number)) return false
    val bank=esp32S3GpioBankOffset(number)
    val bit=1<<(number&31)
    esp32S3PinStateWrite((if (high) 0x60004008 else 0x6000400c)+bank,bit)
    return (((esp32S3PinStateRead(0x60004004+bank)&bit) != 0) == high)
}

// Return a shared digital pad to GPIO input, retaining its global input route.
trusted fun esp32S3GpioInputOwned(number: int): bool {
    if (!esp32S3GpioParkOutputOwned(number)) return false
    val pad=0x60004074+number*4
    esp32S3PinStateWrite(pad,esp32S3PinStateRead(pad)&~4)
    if ((esp32S3PinStateRead(pad)&4) != 0) return false
    val mux=esp32S3GpioMuxAddress(number)
    esp32S3PinStateWrite(mux,(esp32S3PinStateRead(mux)&~29184)|4608)
    return (esp32S3PinStateRead(mux)&29184) == 4608
}

// Caller owns the quiescent digital pad and shared configuration. RTC/USB,
// holds and sleep routing must already be released. Failure retains ownership;
// never enable output until every prerequisite has passed readback.
trusted fun esp32S3GpioOutputLevelOwned(number: int, high: bool): bool {
    if (!espChipS3().gpioOutputValid(number)) return false
    if (!esp32S3GpioParkOutputOwned(number)) return false
    val bank=esp32S3GpioBankOffset(number)
    val bit=1<<(number&31)
    if (!esp32S3GpioWriteLevelOwned(number,high)) return false
    val pad=0x60004074+number*4
    esp32S3PinStateWrite(pad,esp32S3PinStateRead(pad)&~4)
    if ((esp32S3PinStateRead(pad)&4) != 0) return false
    val mux=esp32S3GpioMuxAddress(number)
    esp32S3PinStateWrite(mux,(esp32S3PinStateRead(mux)&~29184)|4096)
    if ((esp32S3PinStateRead(mux)&29184) != 4096) return false
    val route=0x60004554+number*4
    esp32S3PinStateWrite(route,(esp32S3PinStateRead(route)&~4095)|1280)
    if ((esp32S3PinStateRead(route)&4095) != 1280) return false
    esp32S3PinStateWrite(0x60004024+bank,bit)
    return (esp32S3PinStateRead(0x60004020+bank)&bit) != 0
}
