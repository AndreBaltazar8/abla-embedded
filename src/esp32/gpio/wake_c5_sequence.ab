import "abla/runtime/scalar"
// ESP-IDF6 C5 gpio_ll.h/gpio_reg.h: digital GPIO0..28 light-sleep wake.
// Does not enable the global PMU GPIO wake trigger or change pad input/mux,
// pulls/holds/power. Caller owns these prerequisites and excludes sleep and
// pin writers; refuses a pin with CPU interrupt routing enabled.
// HP GPIO domain/clocks must remain powered: this is not the separate LP
// peripheral-powerdown/deep-sleep wake path. Caller keeps the pad in digital
// input mode with suitable sleep selection, checks inactive level immediately
// before entry, and enables PMU GPIO wake separately. Pin availability on a
// board is narrower than the chip range (flash/PSRAM pins are not free pins).
// One scalar: status8,pin6@8,old INT_TYPE+WAKE bits4@14,owned18.
// 1armed2invalid3busy4writefailure5closed. Keep partial tokens for cleanup.
type C5GpioWake=int
fun C5GpioWake.status(): int = this&255
fun C5GpioWake.pin(): int = (this>>>8)&63
fun C5GpioWake.hasSnapshot(): bool = (this>>>18) == 1 && this.pin() <= 28
@section(".iram1.abla.c5GpioWake")
trusted fun c5GpioWakeField(pin: int,mask: int,value: int): bool {
    val address=0x600910d4+pin*4
    c5GpioWakeWrite(address,(c5GpioWakeRead(address)&(~mask))|(value&mask))
    return (c5GpioWakeRead(address)&mask) == (value&mask)
}
@section(".iram1.abla.c5GpioWake")
trusted fun c5GpioWakeApply(pin: int,fields: int): bool =
    c5GpioWakeField(pin,0x400,0) && c5GpioWakeField(pin,0x380,fields) && c5GpioWakeField(pin,0x400,fields)
@section(".iram1.abla.c5GpioWake")
trusted fun esp32C5GpioWakeOpenOwned(pin: int,high: bool,exclusive: bool): C5GpioWake {
    if (!exclusive || (pin < 0 || pin > 28)) return C5GpioWake(2)
    val old=c5GpioWakeRead(0x600910d4+pin*4)
    if ((old&0x3e000) != 0) return C5GpioWake(3)
    val token=(1<<18)|(pin<<8)|(((old>>>7)&15)<<14)
    return C5GpioWake(token|(if (c5GpioWakeApply(pin,if (high) 0x680 else 0x600)) 1 else 4))
}
@section(".iram1.abla.c5GpioWake")
trusted fun esp32C5GpioWakeCloseOwned(owner: C5GpioWake,exclusive: bool): C5GpioWake {
    if (!exclusive || !owner.hasSnapshot() || owner.status() == 5) return owner
    val token=owner&(~255)
    if ((c5GpioWakeRead(0x600910d4+owner.pin()*4)&0x3e000) != 0) return C5GpioWake(token|3)
    return C5GpioWake(token|(if (c5GpioWakeApply(owner.pin(),((owner>>>14)&15)<<7)) 5 else 4))
}
@inline
trusted fun C5GpioWake.closeOwned(exclusive: bool): C5GpioWake = esp32C5GpioWakeCloseOwned(this,exclusive)
