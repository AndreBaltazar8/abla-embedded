// Shared LP GPIO clock boundary, not a lock or a per-pin lease. Caller must
// serialize LPPERI/PCR writers and exclude LP_CPU/ULP and all other LP GPIO
// users before disabling. No reset, pad change or ownership acquisition here.
// IDF6 rtc_io_ll.h: parent LPPERI first on enable, last on disable.
// readLimit bounds register polls, not elapsed time. Failure retains partial
// clock state for explicit retry; never silently rolls back another consumer.
trusted fun c5LpGpioClockWait(address: int,mask: int,enabled: bool,readLimit: int): bool {
    var attempt=0
    while (attempt < readLimit) {
        if (((c5LpGpioClockLoad(address)&mask) != 0) == enabled) return true
        attempt=attempt+1
    }
    false
}
trusted fun esp32C5LpGpioEnableClocksOwned(readLimit: int = 64): bool {
    if (readLimit < 1 || readLimit > 65535) return false
    // PCR IOMUX also clocks ETM: require it, do not take ownership of it.
    if ((c5LpGpioClockLoad(0x600960F0)&3) != 1 ||
        (c5LpGpioClockLoad(0x600B2804)&0x08000000) != 0) return false
    val parent=c5LpGpioClockLoad(0x600B2800)
    if ((parent&0x08000000) == 0) c5LpGpioClockStore(0x600B2800,parent|0x08000000)
    if (!c5LpGpioClockWait(0x600B2800,0x08000000,true,readLimit)) return false
    val child=c5LpGpioClockLoad(0x600B47F8)
    if ((child&1) == 0) c5LpGpioClockStore(0x600B47F8,child|1)
    c5LpGpioClockWait(0x600B47F8,1,true,readLimit)
}
trusted fun esp32C5LpGpioDisableClocksOwned(readLimit: int = 64): bool {
    if (readLimit < 1 || readLimit > 65535) return false
    // An already gated parent is sufficient: do not access its child domain.
    if ((c5LpGpioClockLoad(0x600B2800)&0x08000000) == 0) return true
    val child=c5LpGpioClockLoad(0x600B47F8)
    if ((child&1) != 0) c5LpGpioClockStore(0x600B47F8,child&~1)
    if (!c5LpGpioClockWait(0x600B47F8,1,false,readLimit)) return false
    // Fresh RMW preserves unrelated peripheral gates; caller still serializes.
    c5LpGpioClockStore(0x600B2800,c5LpGpioClockLoad(0x600B2800)&~0x08000000)
    c5LpGpioClockWait(0x600B2800,0x08000000,false,readLimit)
}
