import "./lp_clock_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_gpio.ab"
@export("c5LpGpioClockLoad")
trusted fun c5LpGpioClockLoadHook(address: int): int = mmioLoadU32(address)
@export("c5LpGpioClockStore")
trusted fun c5LpGpioClockStoreHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
