// Imported through gpio_esp32s3.ab. Caller owns the pad and destination signal.
// Bidirectional peripheral signals need BOTH input sampling and peripheral
// output-enable routing. Calling routeInputSignal after routeOutputSignal
// would disable the output; this explicit operation keeps both directions.
import "../../hal/esp32_gpio.ab"
import "../../hal/pin.ab"
@export("abla_pin_routeBidirectionalSignal")
trusted fun pinRouteBidirectionalSignalHook(pin: int, inputSignal: int,outputSignal: int): bool {
    if (!Pin(pin).outputCapable() || inputSignal < 0 || inputSignal > 255 || outputSignal < 0 || outputSignal > 511) return false
    if (!esp32S3GpioParkOutputOwned(Pin(pin).number())) return false
    Pin(pin).selectGpioFunction(true)
    Pin(pin).setOpenDrain(false)
    esp32S3GpioUpdate(0x60004154+inputSignal*4,255,128|Pin(pin).number())
    esp32S3GpioUpdate(0x60004554+Pin(pin).number()*4,4095,outputSignal)
    return gpio_set_direction(i32(Pin(pin).number()),i32(3)) == i32(0)
}
@inline
@export("abla_pin_routeOutputSignal")
trusted fun pinRouteOutputSignalHook(pin: int, signal: int, inverted: bool): bool {
    if (!Pin(pin).outputCapable() || signal < 0 || signal > 511) return false
    if (!esp32S3GpioParkOutputOwned(Pin(pin).number())) return false
    Pin(pin).selectGpioFunction(false)
    Pin(pin).setOpenDrain(false)
    // Route before enabling the output latch. Peripheral controls OE; clear
    // stale OE inversion. This backend's direction setter preserves routing.
    esp32S3GpioUpdate(0x60004554 + Pin(pin).number() * 4, 4095,
        signal | (if (inverted) 512 else 0))
    gpio_set_direction(i32(Pin(pin).number()), i32(2)) == i32(0)
}

@inline
@export("abla_pin_routeInputSignal")
trusted fun pinRouteInputSignalHook(pin: int, signal: int, inverted: bool): bool {
    if (!Pin(pin).valid() || signal < 0 || signal > 255) return false
    if (!esp32S3GpioParkOutputOwned(Pin(pin).number())) return false
    Pin(pin).selectGpioFunction(true)
    if (gpio_set_direction(i32(Pin(pin).number()),i32(1)) != i32(0)) return false
    // GPIO matrix input: bit7 selects matrix, bit6 inverts, low6 selects pin.
    esp32S3GpioUpdate(0x60004154 + signal * 4, 255,
        128 | Pin(pin).number() | (if (inverted) 64 else 0))
    true
}
