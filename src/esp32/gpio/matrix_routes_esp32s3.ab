// Imported through gpio_esp32s3.ab. Caller owns the pad and destination signal.
// Bidirectional peripheral signals need BOTH input sampling and peripheral
// output-enable routing. Calling routeInputSignal after routeOutputSignal
// would disable the output; this explicit operation keeps both directions.
trusted fun Pin.routeBidirectionalSignal(inputSignal: int,outputSignal: int): bool {
    if (!this.outputCapable() || inputSignal < 0 || inputSignal > 255 || outputSignal < 0 || outputSignal > 511) return false
    if (!esp32S3GpioParkOutputOwned(this.number())) return false
    this.selectGpioFunction(true)
    this.setOpenDrain(false)
    esp32S3GpioUpdate(0x60004154+inputSignal*4,255,128|this.number())
    esp32S3GpioUpdate(0x60004554+this.number()*4,4095,outputSignal)
    return gpio_set_direction(i32(this.number()),i32(3)) == i32(0)
}
@inline
trusted fun Pin.routeOutputSignal(signal: int, inverted: bool = false): bool {
    if (!this.outputCapable() || signal < 0 || signal > 511) return false
    if (!esp32S3GpioParkOutputOwned(this.number())) return false
    this.selectGpioFunction(false)
    this.setOpenDrain(false)
    // Route before enabling the output latch. Peripheral controls OE; clear
    // stale OE inversion. This backend's direction setter preserves routing.
    esp32S3GpioUpdate(0x60004554 + this.number() * 4, 4095,
        signal | (if (inverted) 512 else 0))
    gpio_set_direction(i32(this.number()), i32(2)) == i32(0)
}

@inline
trusted fun Pin.routeInputSignal(signal: int, inverted: bool = false): bool {
    if (!this.valid() || signal < 0 || signal > 255) return false
    if (!esp32S3GpioParkOutputOwned(this.number())) return false
    this.selectGpioFunction(true)
    if (gpio_set_direction(i32(this.number()),i32(1)) != i32(0)) return false
    // GPIO matrix input: bit7 selects matrix, bit6 inverts, low6 selects pin.
    esp32S3GpioUpdate(0x60004154 + signal * 4, 255,
        128 | this.number() | (if (inverted) 64 else 0))
    true
}
