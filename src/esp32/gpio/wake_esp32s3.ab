import "./wake_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_gpio.ab"
@export("s3GpioWakeRead")
trusted fun s3GpioWakeReadHook(address: int): int = mmioLoadU32(address)
@export("s3GpioWakeWrite")
trusted fun s3GpioWakeWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
