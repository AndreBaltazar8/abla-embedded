import "./probe_esp32_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_gpio.ab"
@export("classicProbeRead")
trusted fun classicProbeReadHook(address: int): int = mmioLoadU32(address)
@export("classicProbeWrite")
trusted fun classicProbeWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
