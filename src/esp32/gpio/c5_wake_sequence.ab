// ESP-IDF6 C5 reg_base.h, gpio_reg.h, io_mux_reg.h, lp_aon_reg.h.
// GPIO4 is ToughC5's PM1 IRQ. Caller owns this pin, serializes shared register
// updates, and has released global sleep/force-hold before calling.
// Reject individual pad hold rather than silently undoing caller retention.
// Does not configure sleep wake triggers, CPU interrupts, or LP clocks.
// Check each write before advancing. False may leave partial input setup;
// retain pin ownership and retry without restarting PMIC/charger setup.
trusted fun esp32C5ConfigureGpio4WakeInputOwned(): bool {
    if ((c5WakeLoad(0x600B102C)&16) != 0) return false
    // Disable digital output before switching its route or returning from LP IO.
    c5WakeStore(0x6009103C,16)
    if ((c5WakeLoad(0x60091034)&16) != 0) return false
    val route=c5WakeLoad(0x60091AE4)
    c5WakeStore(0x60091AE4,(route&~4095)|1280)
    if ((c5WakeLoad(0x60091AE4)&4095) != 1280) return false
    // GPIO function1, input+pullup, no pulldown or sleep-selected pad config.
    val mux=c5WakeLoad(0x60090010)
    c5WakeStore(0x60090010,(mux&~29570)|4864)
    if ((c5WakeLoad(0x60090010)&29570) != 4864) return false
    // GPIO4 == RTCIO4. Return ownership to HP digital GPIO LAST, after the
    // target configuration is input-only. LP clock/pad settings remain owned.
    val lp=c5WakeLoad(0x600B1028)
    c5WakeStore(0x600B1028,lp&~16)
    (c5WakeLoad(0x600B1028)&16) == 0
}
trusted fun esp32C5Gpio4WakeLevelOwned(): bool = (c5WakeLoad(0x60091064)&16) != 0
