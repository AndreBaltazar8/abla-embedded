import "./s3_logic.ab"
// Caller owns quiescent old/new pad users and shared GPIO configuration.
// Disable GPIO OE, then force noninverted software OE BEFORE touching OD or
// the IO_MUX. GPIO enable alone cannot disable a peripheral-controlled OE.
trusted fun esp32S3GpioParkOutputOwned(number: int): bool {
    if (!espChipS3().gpioValid(number)) return false
    val bank=esp32S3GpioBankOffset(number)
    val bit=1<<(number&31)
    esp32S3PinStateWrite(0x60004028+bank,bit)
    if ((esp32S3PinStateRead(0x60004020+bank)&bit) != 0) return false
    val route=0x60004554+number*4
    esp32S3PinStateWrite(route,(esp32S3PinStateRead(route)&~3072)|1024)
    return (esp32S3PinStateRead(route)&3072) == 1024
}
