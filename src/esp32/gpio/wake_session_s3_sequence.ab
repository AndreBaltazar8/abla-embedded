import "./wake_s3_sequence.ab"
import "../sdk/raw_buffer.ab"
// Digital GPIO + global RTC GPIO trigger lease for LIGHT sleep only. GPIO
// trigger is BIT(2) within WAKEUP_ENA[31:15], hence physical bit17 at+0x3c.
// Other wake triggers (timer/EXT0/etc.) are preserved. Caller excludes all
// sleep/trigger/pin writers and owns powered GPIO/input/mux/pull/hold settings.
// Record32B: magic,state,primary,cleanup,padToken,oldTrigger,owned,reserved.
// State1ready3partial4closed. Results1ready2invalid3park4pad5arm8closed9cleanup.
trusted fun s3GpioWakeTriggerSet(enabled: bool): bool {
    val before=s3GpioWakeRead(0x6000803c)
    s3GpioWakeWrite(0x6000803c,(before&(~0x20000))|(if (enabled) 0x20000 else 0))
    return ((s3GpioWakeRead(0x6000803c)&0x20000) != 0) == enabled
}
trusted fun esp32S3GpioWakeSessionOpenOwned(r: NativeBuffer,pin: int,high: bool,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,32) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 || !espChipS3().gpioOutputValid(pin)) return 2
    var offset=4
    while (offset < 32) { r.storeU32(offset,0);offset=offset+4 }
    r.storeU32(0,0x53335747);r.storeU32(4,3)
    r.storeU32(20,(s3GpioWakeRead(0x6000803c)>>>17)&1);r.storeU32(24,1)
    if (!s3GpioWakeTriggerSet(false)) { r.storeU32(8,3);return 3 }
    val pad=esp32S3GpioWakeOpenOwned(pin,high,true);r.storeU32(16,pad|0)
    if (pad.status() != 1) { r.storeU32(8,4);return 4 }
    if (!s3GpioWakeTriggerSet(true)) { r.storeU32(8,5);return 5 }
    r.storeU32(4,1);return 1
}
trusted fun esp32S3GpioWakeSessionCloseOwned(r: NativeBuffer,exclusiveRecovered: bool): int {
    if (!exclusiveRecovered || !r.hasAddressRange(0,32) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x53335747) return 2
    if (r.loadU32(4) == 4) return 8
    if ((r.loadU32(4) != 1 && r.loadU32(4) != 3) || r.loadU32(24) != 1) return 2
    r.storeU32(4,3)
    if (!s3GpioWakeTriggerSet(false)) { r.storeU32(12,3);return 9 }
    var pad=S3GpioWake(r.loadU32(16))
    if (pad.hasSnapshot()) {
        pad=pad.closeOwned(true);r.storeU32(16,pad|0)
        if (pad.status() != 5) { r.storeU32(12,4);return 9 }
    }
    if (!s3GpioWakeTriggerSet(r.loadU32(20) != 0)) { r.storeU32(12,5);return 9 }
    r.storeU32(12,0);r.storeU32(4,4);return 8
}
