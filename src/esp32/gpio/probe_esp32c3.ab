import "./probe_c3_sequence.ab"
import "../peripheral_delay_esp32c3.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_gpio.ab"
import "../../hal/esp32.ab"
@export("esp32C3ProbeRead")
trusted fun esp32C3ProbeReadHook(address: int): int = mmioLoadU32(address)
@export("esp32C3ProbeWrite")
trusted fun esp32C3ProbeWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
@export("esp32C3ProbeDelay")
trusted fun esp32C3ProbeDelayHook(): void { peripheralRomDelay(1); return }
