import "./probe_c3_sequence.ab"
import "../peripheral_delay_esp32c3.ab"
import "abla/unsafe/mmio"
trusted fun esp32C3ProbeRead(address: int): int = mmioLoadU32(address)
trusted fun esp32C3ProbeWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
trusted fun esp32C3ProbeDelay(): void { peripheralRomDelay(1); return }
