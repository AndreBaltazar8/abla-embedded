import "../soc/gpio_capabilities.ab"

// S3 GPIO17/18 reverse the two drive-strength bits (ESP-IDF gpio_ll.h).
// The same involution converts in either direction.
fun esp32S3GpioDriveBits(pin: int, drive: int): int =
    if (pin == 17 || pin == 18) ((drive & 1) << 1) | ((drive & 2) >>> 1)
    else drive & 3

fun esp32S3GpioMuxAddress(pin: int): int =
    if (espChipS3().gpioValid(pin)) 0x60009004 + pin * 4 else 0

fun esp32S3GpioBankOffset(pin: int): int = if (pin < 32) 0 else 12
