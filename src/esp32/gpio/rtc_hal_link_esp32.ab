import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRtcIoHalOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredRtcioHalSetDirection", "rtcio_hal_set_direction")) return false
    if (!internalFunction("esp32RecoveredRtcioHalSetDirectionInSleep", "rtcio_hal_set_direction_in_sleep")) return false
    if (!internalFunction("esp32RecoveredRtcioHalIsolate", "rtcio_hal_isolate")) return false
    if (!internalFunction("esp32RecoveredRtcioHalIomuxInput", "rtcio_hal_iomux_input")) return false
    if (!internalFunction("esp32RecoveredRtcioHalIomuxOutput", "rtcio_hal_iomux_output")) return false
    true
}
