import "./wake_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_gpio.ab"
@section(".iram1.abla.c5GpioWakeRead")
@export("c5GpioWakeRead")
trusted fun c5GpioWakeReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5GpioWakeWrite")
@export("c5GpioWakeWrite")
trusted fun c5GpioWakeWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
