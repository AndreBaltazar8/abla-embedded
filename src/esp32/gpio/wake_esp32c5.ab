import "./wake_c5_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.c5GpioWakeRead")
trusted fun c5GpioWakeRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5GpioWakeWrite")
trusted fun c5GpioWakeWrite(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
