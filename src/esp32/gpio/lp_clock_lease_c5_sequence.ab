import "./lp_clock_c5_sequence.ab"
// Exclusive shared LP GPIO clock lease. PCR IOMUX must remain enabled and
// reset-free; caller excludes every other LP GPIO/ULP user until close.
// Status1ready2invalid3failure4closed; parent8,child9,parent snapshot10,
// child snapshot11. Child register is read only after parent enable succeeds.
type C5LpClockLease=int
fun C5LpClockLease.status(): int = this&255
fun C5LpClockLease.hasSnapshot(): bool = (this&1024) != 0
trusted fun c5LpClockField(address: int,mask: int,enabled: bool): bool {
    val before=c5LpGpioClockLoad(address)
    val next=(before&~mask)|(if (enabled) mask else 0)
    if (next != before) c5LpGpioClockStore(address,next)
    c5LpGpioClockWait(address,mask,enabled,64)
}
trusted fun esp32C5LpClockOpenOwned(exclusive: bool): C5LpClockLease {
    if (!exclusive || (c5LpGpioClockLoad(0x600960f0)&3) != 1 ||
        (c5LpGpioClockLoad(0x600b2804)&0x08000000) != 0) return C5LpClockLease(2)
    var token=1024|(((c5LpGpioClockLoad(0x600b2800)>>>27)&1)<<8)
    if (!c5LpClockField(0x600b2800,0x08000000,true)) return C5LpClockLease(token|3)
    token=token|2048|((c5LpGpioClockLoad(0x600b47f8)&1)<<9)
    C5LpClockLease(token|(if (c5LpClockField(0x600b47f8,1,true)) 1 else 3))
}
trusted fun C5LpClockLease.closeOwned(exclusive: bool): C5LpClockLease {
    if (!exclusive || !this.hasSnapshot() || this.status() == 4) return this
    val token=this&~255
    if ((this&2048) != 0) {
        if (!c5LpClockField(0x600b2800,0x08000000,true) ||
            !c5LpClockField(0x600b47f8,1,(this&512) != 0)) return C5LpClockLease(token|3)
    }
    C5LpClockLease(token|(if (c5LpClockField(0x600b2800,0x08000000,(this&256) != 0)) 4 else 3))
}
