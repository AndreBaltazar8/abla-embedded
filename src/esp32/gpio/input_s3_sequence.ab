import "./snapshot_s3_sequence.ab"
// Owned digital input setup; caller releases RTC/USB/holds and prevents sleep.
// Pull0up,1down,2both,3floating. Status1ready2invalid3notowned4partial.
// No automatic restore: retain pad ownership on failure. Snapshot first when
// the previous configuration needs restoring; fresh startup need not capture.
trusted fun esp32S3GpioPrepareInputOwned(pin: int,pull: int,exclusive: bool): int {
    if (!espChipS3().gpioOutputValid(pin) || pull < 0 || pull > 3) return 2
    if (!exclusive) return 3
    val bank=esp32S3GpioBankOffset(pin)
    val bit=1<<(pin&31)
    // GPIO OE can be bypassed by peripheral OE. Disable the latch, then force
    // non-inverted software OE before switching the pad to GPIO matrix mode.
    esp32S3PinStateWrite(0x60004028+bank,bit)
    if ((esp32S3PinStateRead(0x60004020+bank)&bit) != 0) return 4
    if (!esp32S3PinStateField(0x60004554+pin*4,4095,1280)) return 4
    if (!esp32S3PinStateField(0x60004074+pin*4,4,0)) return 4
    val pulls=(if (pull == 0 || pull == 2) 256 else 0)|
        (if (pull == 1 || pull == 2) 128 else 0)
    // PIN_FUNC_GPIO=1, IE=bit9; preserve drive strength and sleep fields.
    if (!esp32S3PinStateField(esp32S3GpioMuxAddress(pin),0x7380,0x1200|pulls)) return 4
    return 1
}
