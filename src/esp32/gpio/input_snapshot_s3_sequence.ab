// One scalar: route8, signal8, valid bit16. Global input signals have their own
// ownership; owning a pad alone is insufficient. Both old/new consumers must
// be stopped, shared GPIO updates serialized, and the bus clock available.
type S3GpioInputSnapshot=int
fun S3GpioInputSnapshot.valid(): bool = (this>>>16) == 1
fun S3GpioInputSnapshot.signal(): int = (this>>8)&255
trusted fun esp32S3GpioInputCaptureOwned(signal: int,exclusive: bool): S3GpioInputSnapshot {
    if (!exclusive || signal < 0 || signal > 255) return S3GpioInputSnapshot(0)
    return S3GpioInputSnapshot(65536|(signal<<8)|(esp32S3PinStateRead(0x60004154+signal*4)&255))
}
// 1 restored,2 invalid,3 notowned,4 readbackfailure; snapshot retained for retry.
trusted fun S3GpioInputSnapshot.restoreOwned(exclusive: bool): int {
    if (!this.valid()) return 2
    if (!exclusive) return 3
    val address=0x60004154+this.signal()*4
    esp32S3PinStateWrite(address,(esp32S3PinStateRead(address)&~255)|(this&255))
    return if ((esp32S3PinStateRead(address)&255) == (this&255)) 1 else 4
}
