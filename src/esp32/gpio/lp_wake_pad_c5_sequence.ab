// C5 LP GPIO0..7 wake-input lease. Caller pins LP_IO/IOMUX clocks and LP
// power, releases global holds, owns selected pad and serializes shared RMW.
// PMU trigger and EXT1 selection must be parked during open/close.
// No holds, clock changes, sleep requests or status acknowledgments here.
// Status1ready2invalid3held4partialwrite5closed. Snapshot full mux32@8,
// HP output40,LP output41,route42,owned43,pin3@44. Preserve on every failure.
type C5WakePad=int
fun C5WakePad.status(): int = this&255
fun C5WakePad.hasSnapshot(): bool = (this&(1<<43)) != 0
fun C5WakePad.pin(): int = (this>>>44)&7
trusted fun c5WakePadField(address: int,mask: int,value: int): bool {
    val next=(c5WakeLoad(address)&~mask)|(value&mask)
    c5WakeStore(address,next)
    (c5WakeLoad(address)&mask) == (value&mask)
}
trusted fun c5WakePadOutputsOff(pin: int): bool {
    val bit=int(u32(1)<<u32(pin))
    c5WakeStore(0x6009103c,bit)
    if ((c5WakeLoad(0x60091034)&bit) != 0) return false
    c5WakeStore(0x600b4418,bit)
    (c5WakeLoad(0x600b4410)&bit) == 0
}
trusted fun esp32C5WakePadOpenOwned(pin: int,exclusiveClocksAndHolds: bool): C5WakePad {
    if (!exclusiveClocksAndHolds || pin < 0 || pin > 7) return C5WakePad(2)
    val bit=int(u32(1)<<u32(pin))
    if ((c5WakeLoad(0x600b102c)&bit) != 0) return C5WakePad(3)
    val mux=c5WakeLoad(0x600b4000+pin*4)
    val token=(1<<43)|(pin<<44)|(mux<<8)|
        (((c5WakeLoad(0x60091034)>>>pin)&1)<<40)|(((c5WakeLoad(0x600b4410)>>>pin)&1)<<41)|
        (((c5WakeLoad(0x600b1028)>>>pin)&1)<<42)
    // Input-only settings before switching route; both output engines off.
    if (!c5WakePadOutputsOff(pin) || !c5WakePadField(0x600b4000+pin*4,29570,4864) ||
        !c5WakePadField(0x600b1028,bit,bit)) return C5WakePad(token|4)
    C5WakePad(token|1)
}
trusted fun C5WakePad.levelOwned(): int {
    if (!this.hasSnapshot() || this.status() != 1) return -1
    (c5WakeLoad(0x600b441c)>>>this.pin())&1
}
trusted fun C5WakePad.closeOwned(exclusiveClocksAndHolds: bool): C5WakePad {
    if (!exclusiveClocksAndHolds || !this.hasSnapshot() || this.status() == 5) return this
    val token=this&~255;val pin=this.pin();val bit=int(u32(1)<<u32(pin))
    if ((c5WakeLoad(0x600b102c)&bit) != 0) return C5WakePad(token|3)
    if (!c5WakePadOutputsOff(pin) || !c5WakePadField(0x600b4000+pin*4,29570,(this>>>8)&29570) ||
        !c5WakePadField(0x600b1028,bit,if ((this&(1<<42)) != 0) bit else 0)) return C5WakePad(token|4)
    // Restore output enable only after original mux and route are back.
    if ((this&(1<<41)) != 0) c5WakeStore(0x600b4414,bit)
    if ((this&(1<<40)) != 0) c5WakeStore(0x60091038,bit)
    if (((c5WakeLoad(0x600b4410)>>>pin)&1) != ((this>>>41)&1) ||
        ((c5WakeLoad(0x60091034)>>>pin)&1) != ((this>>>40)&1)) return C5WakePad(token|4)
    C5WakePad(token|5)
}
