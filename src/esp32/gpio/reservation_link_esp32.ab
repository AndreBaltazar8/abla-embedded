import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkGpioReservationOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspGpioReserve", "esp_gpio_reserve")) return false
    if (!internalFunction("esp32RecoveredEspGpioRevoke", "esp_gpio_revoke")) return false
    if (!exportFunction("esp32RecoveredEspGpioIsReserved", "esp_gpio_is_reserved")) return false
    true
}
