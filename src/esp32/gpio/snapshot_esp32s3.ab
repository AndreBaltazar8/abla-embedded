import "./snapshot_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_gpio.ab"
@export("esp32S3PinStateRead")
trusted fun esp32S3PinStateReadHook(address: int): int = mmioLoadU32(address)
@export("esp32S3PinStateWrite")
trusted fun esp32S3PinStateWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
