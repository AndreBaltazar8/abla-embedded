import "./snapshot_p4_sequence.ab"
import "../gpio_esp32p4.ab"
import "../../hal/esp32_gpio.ab"
@export("p4PinSnapshotRead")
trusted fun p4PinSnapshotReadHook(address: int): int = mmioLoadU32(address)
@export("p4PinSnapshotWrite")
trusted fun p4PinSnapshotWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
