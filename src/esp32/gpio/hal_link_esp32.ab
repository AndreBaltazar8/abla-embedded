import "abla/build"

// Exact names used by native IDF callers while they remain in the link.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while native callers remain.
compile fun esp32Idf6LinkGpioHalInternals(): bool {
    if (!internalFunction("esp32RecoveredGpioHalIntrEnableOnCore", "gpio_hal_intr_enable_on_core")) return false
    if (!internalFunction("esp32RecoveredGpioHalIntrDisable", "gpio_hal_intr_disable")) return false
    if (!internalFunction("esp32RecoveredGpioHalIomuxIn", "gpio_hal_iomux_in")) return false
    if (!internalFunction("esp32RecoveredGpioHalIomuxOut", "gpio_hal_iomux_out")) return false
    if (!internalFunction("esp32RecoveredGpioHalMatrixIn", "gpio_hal_matrix_in")) return false
    if (!internalFunction("esp32RecoveredGpioHalMatrixOut", "gpio_hal_matrix_out")) return false
    if (!internalFunction("esp32RecoveredGpioHalIsolateInSleep", "gpio_hal_isolate_in_sleep")) return false
    true
}
