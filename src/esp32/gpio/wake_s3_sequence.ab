import "./s3_logic.ab"
import "abla/runtime/scalar"
// Digital GPIO light-sleep wake, including non-RTC GPIO48 (PaperS3 touch IRQ).
// Does not enable the global RTC GPIO wake trigger or change pad input/mux,
// pulls/holds/power. Caller owns these prerequisites and excludes sleep and
// pin writers; refuses a pin with CPU interrupt routing enabled.
// One scalar: status8,pin6@8,old INT_TYPE+WAKE bits4@14,owned18.
// 1armed2invalid3busy4writefailure5closed. Keep partial tokens for cleanup.
type S3GpioWake=int
fun S3GpioWake.status(): int = this&255
fun S3GpioWake.pin(): int = (this>>>8)&63
fun S3GpioWake.hasSnapshot(): bool = (this>>>18) == 1 && espChipS3().gpioOutputValid(this.pin())
trusted fun s3GpioWakeField(pin: int,mask: int,value: int): bool {
    val address=0x60004074+pin*4
    s3GpioWakeWrite(address,(s3GpioWakeRead(address)&(~mask))|(value&mask))
    return (s3GpioWakeRead(address)&mask) == (value&mask)
}
trusted fun s3GpioWakeApply(pin: int,fields: int): bool =
    s3GpioWakeField(pin,0x400,0) && s3GpioWakeField(pin,0x380,fields) && s3GpioWakeField(pin,0x400,fields)
trusted fun esp32S3GpioWakeOpenOwned(pin: int,high: bool,exclusive: bool): S3GpioWake {
    if (!exclusive || !espChipS3().gpioOutputValid(pin)) return S3GpioWake(2)
    val old=s3GpioWakeRead(0x60004074+pin*4)
    if ((old&0x3e000) != 0) return S3GpioWake(3)
    val token=(1<<18)|(pin<<8)|(((old>>>7)&15)<<14)
    return S3GpioWake(token|(if (s3GpioWakeApply(pin,if (high) 0x680 else 0x600)) 1 else 4))
}
trusted fun S3GpioWake.closeOwned(exclusive: bool): S3GpioWake {
    if (!exclusive || !this.hasSnapshot() || this.status() == 5) return this
    val token=this&(~255)
    if ((s3GpioWakeRead(0x60004074+this.pin()*4)&0x3e000) != 0) return S3GpioWake(token|3)
    return S3GpioWake(token|(if (s3GpioWakeApply(this.pin(),((this>>>14)&15)<<7)) 5 else 4))
}
