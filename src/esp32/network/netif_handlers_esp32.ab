// ESP-IDF netif event actions. The event ABI is (netif, event base, event id,
// event data); keeping that shape removes the lifted sixteen-register facade.

@inline
trusted fun esp32NetifHandlerLoadU8(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32NetifHandlerLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32NetifHandlerStoreU32(address:u32,value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))

// The ESP-IDF archive was recovered with PPP enabled, so its generic start
// and stop dispatchers make every Wi-Fi-only image retain the complete PPP
// stack.  Keep those generic implementations available in their own module,
// but give station/AP firmware a typed path which has no reference to PPP.
// LLVM can then remove PPP from a build which never imports or calls it.

@inline
trusted fun esp32NetifStationConfigCheck(netif:u32):u32 =
    esp32Internal_Labla_recovered_Esp32NetifLwip_local_esp_netif_config_sanity_check_d5c7c7bd78(
        netif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

