trusted fun esp32RecoveredEspNetifActionConnected(
    netif:u32,eventBase:u32,eventId:u32,eventData:u32
):u32 {
    esp32RecoveredEspNetifUp(
        netif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    val flags = esp32RecoveredEspNetifGetFlags(
        netif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if ((flags & u32(1)) == u32(0)) return netif

    val dhcpStatusAddress = u32(nativeStackAllocate(4))
    val statusResult = esp32RecoveredEspNetifDhcpcGetStatus(
        netif,dhcpStatusAddress,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (statusResult != u32(0)) return netif

    val dhcpStatus = esp32NetifHandlerLoadU32(dhcpStatusAddress)
    if (dhcpStatus == u32(0)) {
        esp32RecoveredEspNetifDhcpcStart(
            netif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        return netif
    }
    if (dhcpStatus != u32(2)) return netif

    val currentIp = u32(nativeStackAllocate(12))
    val oldIp = u32(nativeStackAllocate(12))
    esp32RecoveredEspNetifGetIpInfo(
        netif,currentIp,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32RecoveredEspNetifGetOldIpInfo(
        netif,oldIp,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (esp32RecoveredEspNetifIsValidStaticIp(
        currentIp,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)) == u32(0)) return netif

    // ip_event_got_ip_t: esp_netif*, ip_info (12 bytes), ip_changed bool.
    val gotIp = u32(nativeStackAllocate(20))
    freestandingSet(gotIp,i32(0),u32(20))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(gotIp)),int(netif))
    freestandingCopy(gotIp + u32(4),currentIp,u32(12))
    if (freestandingCompare(currentIp,oldIp,u32(12)) != 0) {
        ablaUnsafeStoreU8(nativePointerFromAddress(int(gotIp + u32(16))),1)
    }
    esp32RecoveredEspNetifSetOldIpInfo(
        netif,currentIp,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    val ipEventBase = esp32NetifHandlerLoadU32(u32(esp32IpEventObject))
    val gotIpEventId = esp32RecoveredEspNetifGetEventId(
        netif,u32(1),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32RecoveredEspEventPost(
        ipEventBase, gotIpEventId, gotIp, u32(20), u32(0)
    )
}

