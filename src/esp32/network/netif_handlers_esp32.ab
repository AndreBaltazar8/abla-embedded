}

trusted fun esp32NetifStationStartApi(message:u32):u32 {
    val netif = esp32NetifHandlerLoadU32(message + u32(12))
    val configuration = esp32NetifStationConfigCheck(netif)
    if (configuration != u32(0)) return configuration

    val added = esp32NetifStationLwipAdd(netif)
    if (added != u32(0)) return added

    val flags = esp32NetifHandlerLoadU32(netif + u32(84))
    val lwipNetif = esp32NetifHandlerLoadU32(netif + u32(16))
    if ((flags & u32(8)) != u32(0)) {
        esp32NetifStationSetGarp(lwipNetif)
    }
    if ((flags & u32(4)) != u32(0)) {
        esp32NetifStationSetUp(lwipNetif)
    }

    if ((flags & u32(2)) != u32(0)) {
        val status = esp32NetifHandlerLoadU32(netif + u32(64))
        if (status == u32(1)) return u32(20484)
        if (status != u32(0)) return u32(0)
        if (lwipNetif == u32(0) ||
            (esp32NetifHandlerLoadU8(lwipNetif + u32(231)) & u32(1)) ==
                u32(0)) {
            esp32NetifHandlerStoreU32(netif + u32(64),u32(0))
            return u32(0)
        }
        if (esp32NetifStationDhcpServerStart(netif,lwipNetif) != u32(0)) {
            esp32NetifHandlerStoreU32(netif + u32(64),u32(0))
            return u32(20493)
        }
        esp32NetifHandlerStoreU32(netif + u32(64),u32(1))
        esp32NetifStationUpdateDefault(netif,u32(1))
        return u32(0)
    }

    // A running DHCP client becomes the default only after it owns an IP.
    if ((flags & u32(1)) == u32(0) ||
        esp32NetifHandlerLoadU32(netif + u32(60)) == u32(2)) {
        esp32NetifStationUpdateDefault(netif,u32(1))
    }
    return u32(0)
}

trusted fun esp32NetifStationStopApi(message:u32):u32 {
    val netif = esp32NetifHandlerLoadU32(message + u32(12))
    val lwipNetif = esp32NetifHandlerLoadU32(netif + u32(16))
    if (lwipNetif == u32(0)) return u32(20482)
    if ((esp32NetifHandlerLoadU8(lwipNetif + u32(231)) & u32(1)) ==
        u32(0)) {
        esp32NetifStationRemove(netif)
        return u32(20482)
    }

    val flags = esp32NetifHandlerLoadU32(netif + u32(84))
    if ((flags & u32(2)) != u32(0)) {
        val stopped = esp32NetifStationDhcpServerStop(netif,lwipNetif)
        if (stopped != u32(0) ||
            esp32NetifHandlerLoadU32(netif + u32(64)) != u32(2)) {
            esp32NetifHandlerStoreU32(netif + u32(64),u32(0))
        }
    } else if ((flags & u32(1)) != u32(0)) {
        esp32NetifStationDhcpClientStop(lwipNetif)
        esp32NetifHandlerStoreU32(netif + u32(60),u32(0))
        esp32NetifStationResetIp(netif)
    }

    esp32NetifStationSetDown(lwipNetif)
    esp32NetifStationRemove(netif)
    esp32NetifStationUpdateDefault(netif,u32(3))
    return u32(0)
}

// ESP_NETIF_INHERENT_DEFAULT_WIFI_STA has fixed flags: DHCP client, GARP,
// IP-modified events, MLDv6 report. Its start/stop callbacks never need the
// DHCP-server branch used by AP netifs. Keep the generic handlers above for
// AP/custom netifs, while making the default-station call graph client-only.
trusted fun esp32NetifDefaultStationStartApi(message:u32):u32 {
    val netif = esp32NetifHandlerLoadU32(message + u32(12))
    val configuration = esp32NetifStationConfigCheck(netif)
    if (configuration != u32(0)) return configuration

    val added = esp32NetifStationLwipAdd(netif)
    if (added != u32(0)) return added

    val lwipNetif = esp32NetifHandlerLoadU32(netif + u32(16))
    esp32NetifStationSetGarp(lwipNetif)

    // A DHCP client becomes the default route only once it owns an address.
    if (esp32NetifHandlerLoadU32(netif + u32(60)) == u32(2)) {
        esp32NetifStationUpdateDefault(netif,u32(1))
    }
    return u32(0)
}

trusted fun esp32NetifDefaultStationStopApi(message:u32):u32 {
    val netif = esp32NetifHandlerLoadU32(message + u32(12))
    val lwipNetif = esp32NetifHandlerLoadU32(netif + u32(16))
    if (lwipNetif == u32(0)) return u32(20482)
    if ((esp32NetifHandlerLoadU8(lwipNetif + u32(231)) & u32(1)) ==
        u32(0)) {
        esp32NetifStationRemove(netif)
        return u32(20482)
    }

    esp32NetifStationDhcpClientStop(lwipNetif)
    esp32NetifHandlerStoreU32(netif + u32(60),u32(0))
    esp32NetifStationResetIp(netif)
    esp32NetifStationSetDown(lwipNetif)
    esp32NetifStationRemove(netif)
    esp32NetifStationUpdateDefault(netif,u32(3))
    return u32(0)
}

@inline
trusted fun esp32NetifStationIpc(
    callback:u32,netif:u32
):u32 =
    esp32Internal_Labla_recovered_Esp32NetifLwip_local_esp_netif_lwip_ipc_call_ae68b4f619(
        callback,netif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

trusted fun esp32NetifStationStart(netif:u32):u32 =
    esp32NetifStationIpc(
        u32(nativeFunctionAddress(esp32NetifStationStartApi)),netif)

trusted fun esp32NetifStationStop(netif:u32):u32 =
    esp32NetifStationIpc(
        u32(nativeFunctionAddress(esp32NetifStationStopApi)),netif)

trusted fun esp32NetifDefaultStationStart(netif:u32):u32 =
    esp32NetifStationIpc(
        u32(nativeFunctionAddress(esp32NetifDefaultStationStartApi)),netif)

trusted fun esp32NetifDefaultStationStop(netif:u32):u32 =
    esp32NetifStationIpc(
        u32(nativeFunctionAddress(esp32NetifDefaultStationStopApi)),netif)

trusted fun esp32NetifDefaultStationActionStart(
