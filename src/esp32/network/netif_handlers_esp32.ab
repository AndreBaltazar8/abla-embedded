// The got-IP event has already been created by ActionConnected. This handler's
// only semantic effect in IDF is diagnostic logging, so it returns the netif.
trusted fun esp32RecoveredEspNetifActionGotIp(
    netif:u32,eventBase:u32,eventId:u32,eventData:u32
):u32 = netif

