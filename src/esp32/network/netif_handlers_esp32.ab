@inline
trusted fun esp32NetifStationDhcpServerStart(
    netif:u32,lwipNetif:u32
):u32 {
    val dhcpServer = esp32NetifHandlerLoadU32(netif + u32(36))
    val ipInfo = esp32NetifHandlerLoadU32(netif + u32(8))
    esp32RecoveredDhcpsSetNewLeaseCb(
        dhcpServer,
        u32(nativeFunctionAddress(esp32Internal_Labla_recovered_Esp32NetifLwip_local_esp_netif_dhcps_cb_04b436f775)),
        netif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32RecoveredDhcpsSetOptionInfo(
        dhcpServer,u32(1),ipInfo + u32(4),u32(4),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0))
    esp32RecoveredDhcpsStart(
        dhcpServer,lwipNetif,esp32NetifHandlerLoadU32(ipInfo),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0))
}

