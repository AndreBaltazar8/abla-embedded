        netif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

@inline
trusted fun esp32NetifStationSetGarp(lwipNetif:u32):void {
    esp32Internal_Labla_recovered_Esp32NetifLwip_local_netif_set_garp_flag_e2b9c8210f(
        lwipNetif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}

