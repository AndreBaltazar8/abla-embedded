import "../../network/lwip/pbuf_basic_esp32.ab"
import "../../network/lwip/ppp_serial_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32PppInputTcpipAsRamPbuf(
    pppControl: u32,
    input: u32,
    inputLength: u32
): u32 {
    val length = inputLength & u32(65535)
    val pbuf = esp32LwipPbufAllocate(u32(0), length, u32(640))
    if (pbuf == u32(0)) return u32(255)

    esp32LwipPbufTake(pbuf, input, length)
    val networkInterface = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(pppControl + u32(28)))
    ))
    val result = esp32RecoveredTcpipInpkt(
        pbuf,
        networkInterface,
        u32(nativeFunctionAddress(esp32RecoveredPpposInputSys)),
        u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (result != u32(0)) esp32LwipPbufFree(pbuf)
    result
}

trusted fun esp32RecoveredPpposInputTcpipAsRamPbuf(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PppInputTcpipAsRamPbuf(a2, a3, a4)
