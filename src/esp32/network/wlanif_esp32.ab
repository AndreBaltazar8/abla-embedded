import "../../network/lwip/pbuf_basic_esp32.ab"
import "../system/assert_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../network/lwip/etharp_esp32.ab"
import "../../network/lwip/ethernet_ipv6_esp32.ab"

// Structured Abla implementation of the lwIP Wi-Fi netif bridge.
val esp32WlanifDefaultHostnameStorage = nativeStaticBytes("espressif\x00")
val esp32WlanifDefaultHostname = u32(esp32WlanifDefaultHostnameStorage)
val esp32WlanifAssertionStorage = nativeStaticBytes("\x6e\x65\x74\x69\x66\x20\x21\x3d\x20\x4e\x55\x4c\x4c\x00")
val esp32WlanifAssertion = u32(esp32WlanifAssertionStorage)
val esp32WlanifFunctionStorage = nativeStaticBytes("\x77\x6c\x61\x6e\x69\x66\x5f\x69\x6e\x69\x74\x00")
val esp32WlanifFunction = u32(esp32WlanifFunctionStorage)
val esp32WlanifFileStorage = nativeStaticBytes("\x2f\x49\x44\x46\x2f\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x73\x2f\x65\x73\x70\x5f\x6e\x65\x74\x69\x66\x2f\x6c\x77\x69\x70\x2f\x6e\x65\x74\x69\x66\x2f\x77\x6c\x61\x6e\x69\x66\x2e\x63\x00")
val esp32WlanifFile = u32(esp32WlanifFileStorage)

@inline
trusted fun esp32WlanifLoadU8(address:u32):u32 = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))
@inline
trusted fun esp32WlanifLoadU16(address:u32):u32 = u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(address))))
@inline
trusted fun esp32WlanifLoadU32(address:u32):u32 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))
@inline
trusted fun esp32WlanifStoreU8(address:u32,value:u32):void = ablaUnsafeStoreU8(nativePointerFromAddress(int(address)),int(value))
@inline
trusted fun esp32WlanifStoreU16(address:u32,value:u32):void = ablaUnsafeStoreU16(nativePointerFromAddress(int(address)),int(value))
@inline
trusted fun esp32WlanifStoreU32(address:u32,value:u32):void = ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))

trusted fun esp32WlanifLowLevelInitialize(netif:u32):void {
    esp32WlanifStoreU8(netif + u32(230),u32(6))
    esp32WlanifStoreU16(netif + u32(220),u32(1500))
    // BROADCAST | ETHARP | ETHERNET | IGMP | MLD6 for this configuration.
    esp32WlanifStoreU8(netif + u32(231),u32(122))
}

@inline
trusted fun esp32WlanifMapTransmitError(result:u32):u32 {
    if (result == u32(0)) return u32(0)
    if (result == u32(257)) return u32(255)
    if (result == u32(258)) return u32(240)
    if (result == u32(20494)) return u32(254)
    u32(244)
}

trusted fun esp32WlanifLowLevelOutput(netif:u32,packet:u32):u32 {
    val espNetif = esp32WlanifLoadU32(netif + u32(192))
    if (espNetif == u32(0)) return u32(244)

    var transmittedPacket = packet
    if (esp32WlanifLoadU32(packet) != u32(0)) {
        transmittedPacket = esp32LwipPbufAllocate(
            u32(0),esp32WlanifLoadU16(packet + u32(8)),u32(640))
        if (transmittedPacket == u32(0)) return u32(255)
        esp32LwipPbufCopy(transmittedPacket,packet)
    }

    val result = esp32RecoveredEspNetifTransmitWrap(
        espNetif,
        esp32WlanifLoadU32(transmittedPacket + u32(4)),
        esp32WlanifLoadU16(transmittedPacket + u32(10)),
        transmittedPacket,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (transmittedPacket != packet) esp32LwipPbufFree(transmittedPacket)
    esp32WlanifMapTransmitError(result)
}

trusted fun esp32RecoveredWlanifInput(netif:u32,buffer:u32,length:u32,layer2Buffer:u32):u32 {
    val espNetif = esp32WlanifLoadU32(netif + u32(192))
    if (buffer == u32(0) || (esp32WlanifLoadU8(netif + u32(231)) & u32(1)) == u32(0)) {
        if (layer2Buffer != u32(0)) {
            esp32RecoveredEspNetifFreeRxBuffer(
                espNetif,layer2Buffer,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        }
        return u32(0xffffffff)
    }

    val packet = esp32RecoveredEspPbufAllocate(
        espNetif,buffer,length,layer2Buffer,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (packet == u32(0)) {
        esp32RecoveredEspNetifFreeRxBuffer(
            espNetif,layer2Buffer,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        return u32(257)
    }

    val input = esp32WlanifLoadU32(netif + u32(176))
    val result = u32(ablaUnsafeCallI32I32I32(int(input),int(packet),int(netif)))
    if (result != u32(0)) {
        esp32LwipPbufFree(packet)
        return u32(0xffffffff)
    }
    u32(0)
}

trusted fun esp32RecoveredWlanifInit(netif:u32):u32 {
    if (netif == u32(0)) {
        esp32AssertFailed(esp32WlanifAssertion,u32(200),esp32WlanifFunction,esp32WlanifFile)
    }
    val espNetif = esp32WlanifLoadU32(netif + u32(192))
    if (esp32RecoveredEspNetifGetHostname(
        espNetif,netif + u32(216),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)) != u32(0)) {
        esp32WlanifStoreU32(netif + u32(216),esp32WlanifDefaultHostname)
    }
    esp32WlanifStoreU32(netif + u32(180),u32(nativeFunctionAddress(esp32RecoveredEtharpOutput)))
    esp32WlanifStoreU32(netif + u32(188),u32(nativeFunctionAddress(esp32RecoveredEthip6Output)))
    esp32WlanifStoreU32(netif + u32(184),u32(nativeFunctionAddress(esp32WlanifLowLevelOutput)))
    esp32WlanifLowLevelInitialize(netif)
    u32(0)
}

trusted fun esp32RecoveredWlanifInitSta(netif:u32):u32 {
    esp32WlanifStoreU8(netif + u32(232),u32(115))
    esp32WlanifStoreU8(netif + u32(233),u32(116))
    esp32RecoveredWlanifInit(netif)
}

trusted fun esp32RecoveredWlanifInitAp(netif:u32):u32 {
    esp32WlanifStoreU8(netif + u32(232),u32(97))
    esp32WlanifStoreU8(netif + u32(233),u32(112))
    esp32RecoveredWlanifInit(netif)
}

trusted fun esp32RecoveredWlanifInitNan(netif:u32):u32 {
    esp32WlanifStoreU8(netif + u32(232),u32(110))
    esp32WlanifStoreU8(netif + u32(233),u32(97))
    esp32RecoveredWlanifInit(netif)
}
