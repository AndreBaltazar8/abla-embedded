// Abla/LLVM implementation of the complete ESP-IDF lwIP PPP adapter, lifecycle, status events, authentication, transport, and parameters.

trusted fun esp32NetifNewPppHook(netif:u32,configuration:u32):u32 =
    esp32RecoveredEspNetifNewPpp(
        netif,configuration,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

// Importing PPP provides the implementation; calling this function selects
// it for generic esp_netif_new.  Programs which only use Wi-Fi never mention
// the function address, so the constructor and the PPP stack remain prunable.
trusted fun esp32EnableNetifPpp():void {
    esp32ConfigureNetifPppNewHook(
        u32(nativeFunctionAddress(esp32NetifNewPppHook)))
}

