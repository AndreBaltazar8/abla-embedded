// Abla/LLVM implementation of the complete ESP-IDF lwIP network-interface core, lifecycle, DHCP, DNS, IPv4, IPv6, routing, and driver bridge.

// Optional netif families install their constructors explicitly.  A direct
// reference from the common constructor to PPP made every Ethernet/Wi-Fi
// firmware retain PPP even when no point-to-point interface could be created.
// A null hook means that optional family was not selected by the program.
var esp32NetifPppNewHook: u32 = u32(0)

trusted fun esp32ConfigureNetifPppNewHook(callback:u32):void {
    esp32NetifPppNewHook = callback
    return
}

// Canonical immutable lwIP wildcard addresses. Keeping these as Abla constants
// exposes their bytes and all uses to the monolithic LLVM optimization graph.
val esp32LwipIp4AddressAny = u32(nativeStaticBytes(
