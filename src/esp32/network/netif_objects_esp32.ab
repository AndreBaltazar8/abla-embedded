import "../runtime/libc_heap_esp32.ab"
import "../system/assert_esp32.ab"
import "../../runtime/freestanding_integer.ab"
import "abla/unsafe/memory"

// ESP-IDF network-interface registry implemented as an ordinary Abla list.
// Nodes are two words: the esp_netif pointer followed by the next-node pointer.
var esp32NetifListHead = u32(0)
var esp32NetifCount = u32(0)

val esp32NetifRemoveFunctionStorage = nativeStaticBytes(
    "\x65\x73\x70\x5f\x6e\x65\x74\x69\x66\x5f\x72\x65\x6d\x6f\x76\x65\x5f\x66\x72\x6f\x6d\x5f\x6c\x69\x73\x74\x5f\x75\x6e\x73\x61\x66\x65\x00")
val esp32NetifRemoveFunction = u32(esp32NetifRemoveFunctionStorage)
val esp32NetifCounterAssertionStorage = nativeStaticBytes(
    "\x73\x5f\x65\x73\x70\x5f\x6e\x65\x74\x69\x66\x5f\x63\x6f\x75\x6e\x74\x65\x72\x20\x3e\x20\x30\x00")
val esp32NetifCounterAssertion = u32(esp32NetifCounterAssertionStorage)
val esp32NetifObjectsFileStorage = nativeStaticBytes(
    "\x2f\x2f\x49\x44\x46\x2f\x63\x6f\x6d\x70\x6f\x6e\x65\x6e\x74\x73\x2f\x65\x73\x70\x5f\x6e\x65\x74\x69\x66\x2f\x65\x73\x70\x5f\x6e\x65\x74\x69\x66\x5f\x6f\x62\x6a\x65\x63\x74\x73\x00")
val esp32NetifObjectsFile = u32(esp32NetifObjectsFileStorage)

val esp32IpEventNameStorage = nativeStaticBytes("\x49\x50\x5f\x45\x56\x45\x4e\x54\x00")
val esp32IpEventName = u32(esp32IpEventNameStorage)
val esp32Data_Labla_recovered_Esp32NetifObjects_data_rodata_IP_EVENT_IP_EVENT_e20f16ca75Storage =
    nativeStaticU32s([int(esp32IpEventName)])
val esp32Data_Labla_recovered_Esp32NetifObjects_data_rodata_IP_EVENT_IP_EVENT_e20f16ca75 =
    u32(esp32Data_Labla_recovered_Esp32NetifObjects_data_rodata_IP_EVENT_IP_EVENT_e20f16ca75Storage)

@inline
trusted fun esp32NetifNodeLoad(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32NetifNodeStore(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32RecoveredEspNetifAddToListUnsafe(netif:u32):u32 {
    val node = esp32LibcCalloc(u32(1),u32(8))
    if (node == u32(0)) return u32(257)
    esp32NetifNodeStore(node,netif)
    esp32NetifNodeStore(node + u32(4),esp32NetifListHead)
    esp32NetifListHead = node
    esp32NetifCount = esp32NetifCount + u32(1)
    u32(0)
}

trusted fun esp32RecoveredEspNetifRemoveFromListUnsafe(netif:u32):u32 {
    var previous = u32(0)
    var node = esp32NetifListHead
    while (node != u32(0) && esp32NetifNodeLoad(node) != netif) {
        previous = node
        node = esp32NetifNodeLoad(node + u32(4))
    }
    if (node == u32(0)) return u32(261)

    val next = esp32NetifNodeLoad(node + u32(4))
    if (previous == u32(0)) esp32NetifListHead = next
    else esp32NetifNodeStore(previous + u32(4),next)

    if (esp32NetifCount == u32(0)) {
        esp32AssertFailed(
            esp32NetifCounterAssertion,u32(59),esp32NetifRemoveFunction,esp32NetifObjectsFile)
    }
    esp32NetifCount = esp32NetifCount - u32(1)
    esp32LibcFreeValue(node)
    u32(0)
}

trusted fun esp32RecoveredEspNetifGetNrOfIfs():u32 = esp32NetifCount

trusted fun esp32RecoveredEspNetifNextUnsafe(netif:u32):u32 {
    var node = esp32NetifListHead
    if (netif == u32(0)) {
        if (node == u32(0)) return u32(0)
        return esp32NetifNodeLoad(node)
    }
    while (node != u32(0)) {
        if (esp32NetifNodeLoad(node) == netif) {
            node = esp32NetifNodeLoad(node + u32(4))
            if (node == u32(0)) return u32(0)
            return esp32NetifNodeLoad(node)
        }
        node = esp32NetifNodeLoad(node + u32(4))
    }
    u32(0)
}

trusted fun esp32RecoveredEspNetifIsNetifListed(netif:u32):u32 {
    var node = esp32NetifListHead
    while (node != u32(0)) {
        if (esp32NetifNodeLoad(node) == netif) return u32(1)
        node = esp32NetifNodeLoad(node + u32(4))
    }
    u32(0)
}

trusted fun esp32RecoveredEspNetifGetHandleFromIfkeyUnsafe(ifkey:u32):u32 {
    var node = esp32NetifListHead
    while (node != u32(0)) {
        val netif = esp32NetifNodeLoad(node)
        val candidate = esp32RecoveredEspNetifGetIfkey(
            netif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        if (freestandingStringCompare(ifkey,candidate) == 0) return netif
        node = esp32NetifNodeLoad(node + u32(4))
    }
    u32(0)
}
