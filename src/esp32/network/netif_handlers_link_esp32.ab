import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNetifHandlersOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspNetifActionStart", "esp_netif_action_start")) return false
    if (!internalFunction("esp32RecoveredEspNetifActionStop", "esp_netif_action_stop")) return false
    if (!internalFunction("esp32RecoveredEspNetifActionConnected", "esp_netif_action_connected")) return false
    if (!internalFunction("esp32RecoveredEspNetifActionDisconnected", "esp_netif_action_disconnected")) return false
    if (!internalFunction("esp32RecoveredEspNetifActionGotIp", "esp_netif_action_got_ip")) return false
    if (!internalFunction("esp32RecoveredEspNetifActionJoinIp6MulticastGroup", "esp_netif_action_join_ip6_multicast_group")) return false
    if (!internalFunction("esp32RecoveredEspNetifActionLeaveIp6MulticastGroup", "esp_netif_action_leave_ip6_multicast_group")) return false
    if (!internalFunction("esp32RecoveredEspNetifActionAddIp6Address", "esp_netif_action_add_ip6_address")) return false
    if (!internalFunction("esp32RecoveredEspNetifActionRemoveIp6Address", "esp_netif_action_remove_ip6_address")) return false
    true
}
