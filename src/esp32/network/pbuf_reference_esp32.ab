import "../../network/lwip/memory_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32PbufReferenceFree(pbuf: u32): void {
    val networkInterface = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(pbuf + u32(20)))
    ))
    val layer2Buffer = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(pbuf + u32(24)))
    ))
    esp32RecoveredEspNetifFreeRxBuffer(
        networkInterface, layer2Buffer, u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    esp32LwipMemFreeValue(pbuf)
    return
}

trusted fun esp32PbufReferenceAllocate(
    networkInterface: u32,
    buffer: u32,
    length: u32,
    layer2Buffer: u32
): u32 {
    val customPbuf = esp32LwipMemAllocate(u32(28))
    if (customPbuf == u32(0)) return u32(0)
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(customPbuf + u32(16))),
        int(u32(nativeFunctionAddress(esp32PbufReferenceFree)))
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(customPbuf + u32(20))),
        int(networkInterface)
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(customPbuf + u32(24))),
        int(layer2Buffer)
    )
    val pbuf = esp32LwipPbufAllocatedCustom(
        u32(0), length & u32(65535), u32(65),
        customPbuf, buffer, length & u32(65535)
    )
    if (pbuf == u32(0)) esp32LwipMemFreeValue(customPbuf)
    pbuf
}

trusted fun esp32RecoveredEspPbufAllocate(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32PbufReferenceAllocate(a2, a3, a4, a5)
