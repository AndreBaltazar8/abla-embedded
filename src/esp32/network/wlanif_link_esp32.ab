import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWlanifInternals(): bool {
    if (!internalFunction("esp32RecoveredWlanifInput", "wlanif_input")) return false
    if (!internalFunction("esp32RecoveredWlanifInit", "wlanif_init")) return false
    if (!internalFunction("esp32RecoveredWlanifInitSta", "wlanif_init_sta")) return false
    if (!internalFunction("esp32RecoveredWlanifInitAp", "wlanif_init_ap")) return false
    if (!internalFunction("esp32RecoveredWlanifInitNan", "wlanif_init_nan")) return false
    true
}
