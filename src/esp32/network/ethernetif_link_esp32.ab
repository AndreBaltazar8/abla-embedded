import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEthernetifInternals(): bool {
    if (!internalFunction("esp32EthernetInput", "ethernetif_input")) return false
    if (!internalFunction("esp32EthernetInitialize", "ethernetif_init")) return false
    true
}
