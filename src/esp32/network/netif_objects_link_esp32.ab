import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNetifObjectsInternals(): bool {
    if (!internalFunction("esp32RecoveredEspNetifAddToListUnsafe", "esp_netif_add_to_list_unsafe")) return false
    if (!internalFunction("esp32RecoveredEspNetifRemoveFromListUnsafe", "esp_netif_remove_from_list_unsafe")) return false
    if (!internalFunction("esp32RecoveredEspNetifGetNrOfIfs", "esp_netif_get_nr_of_ifs")) return false
    if (!internalFunction("esp32RecoveredEspNetifNextUnsafe", "esp_netif_next_unsafe")) return false
    if (!internalFunction("esp32RecoveredEspNetifIsNetifListed", "esp_netif_is_netif_listed")) return false
    if (!internalFunction("esp32RecoveredEspNetifGetHandleFromIfkeyUnsafe", "esp_netif_get_handle_from_ifkey_unsafe")) return false
    true
}
