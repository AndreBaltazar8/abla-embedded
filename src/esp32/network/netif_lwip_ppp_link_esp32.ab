import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNetifLwipPppInternals(): bool {
    if (!internalFunction("esp32RecoveredEspNetifPppSetAuthInternal", "esp_netif_ppp_set_auth_internal")) return false
    if (!internalFunction("esp32RecoveredEspNetifPppSetDefaultNetif", "esp_netif_ppp_set_default_netif")) return false
    if (!internalFunction("esp32RecoveredEspNetifNewPpp", "esp_netif_new_ppp")) return false
    if (!internalFunction("esp32RecoveredEspNetifStartPpp", "esp_netif_start_ppp")) return false
    if (!internalFunction("esp32RecoveredEspNetifLwipPppInput", "esp_netif_lwip_ppp_input")) return false
    if (!internalFunction("esp32RecoveredEspNetifStopPpp", "esp_netif_stop_ppp")) return false
    if (!internalFunction("esp32RecoveredEspNetifDestroyPpp", "esp_netif_destroy_ppp")) return false
    if (!internalFunction("esp32RecoveredEspNetifPppSetParams", "esp_netif_ppp_set_params")) return false
    if (!internalFunction("esp32RecoveredEspNetifPppGetParams", "esp_netif_ppp_get_params")) return false
    true
}
