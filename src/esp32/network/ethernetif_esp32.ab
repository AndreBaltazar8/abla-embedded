import "../../network/lwip/pbuf_basic_esp32.ab"
import "../system/assert_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../network/lwip/etharp_esp32.ab"
import "../../network/lwip/ethernet_ipv6_esp32.ab"

// Structured Abla implementation of ESP-IDF's lwIP Ethernet interface.
val esp32EthernetErrorMemory = u32(255)
val esp32EthernetErrorInterface = u32(244)
val esp32EthernetEspNoMemory = u32(257)
val esp32EthernetDefaultHostname = u32(nativeStaticBytes("espressi\x00"))
val esp32EthernetAssertFile = u32(nativeStaticBytes(
    "/IDF/components/esp_netif/lwip/netif/ethernetif.c\x00"))
val esp32EthernetAssertFunction = u32(nativeStaticBytes("ethernetif_init\x00"))
val esp32EthernetAssertExpression = u32(nativeStaticBytes("netif != NULL\x00"))

@inline
trusted fun esp32EthernetLoadU8(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32EthernetLoadU16(address:u32):u32 =
    u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32EthernetLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32EthernetStoreU8(address:u32, value:u32):void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32EthernetStoreU16(address:u32, value:u32):void =
    ablaUnsafeStoreU16(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32EthernetStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32EthernetHandle(netif:u32):u32 =
    esp32RecoveredEspNetifGetHandleFromNetifImpl(
        netif,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))

trusted fun esp32EthernetLowLevelInitialize(netif:u32):void {
    esp32EthernetStoreU8(netif + u32(230), u32(6))
    esp32EthernetStoreU16(netif + u32(220), u32(1500))
    // BROADCAST | ETHARP | ETHERNET | IGMP | MLD6.
    esp32EthernetStoreU8(netif + u32(231), u32(122))
}

trusted fun esp32EthernetLowLevelOutput(netif:u32, packet:u32):u32 {
    val handle = esp32EthernetHandle(netif)
    if (handle == u32(0)) return esp32EthernetErrorInterface
    var transmitPacket = packet
    if (esp32EthernetLoadU32(packet) != u32(0)) {
        transmitPacket = esp32LwipPbufAllocate(
            u32(0),esp32EthernetLoadU16(packet + u32(8)),u32(640))
        if (transmitPacket == u32(0)) return esp32EthernetErrorMemory
        esp32LwipPbufCopy(transmitPacket, packet)
    }
    val status = esp32RecoveredEspNetifTransmit(
        handle,esp32EthernetLoadU32(transmitPacket + u32(4)),
        esp32EthernetLoadU16(transmitPacket + u32(10)),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (transmitPacket != packet) esp32LwipPbufFree(transmitPacket)
    if (status == u32(0)) return u32(0)
    if (status == esp32EthernetEspNoMemory) return esp32EthernetErrorMemory
    esp32EthernetErrorInterface
}

trusted fun esp32EthernetInput(
    netif:u32, buffer:u32, length:u32, layer2Buffer:u32
):u32 {
    val handle = esp32EthernetHandle(netif)
    if (buffer == u32(0) || (esp32EthernetLoadU8(netif + u32(231)) & u32(1)) == u32(0)) {
        if (buffer != u32(0)) {
            esp32RecoveredEspNetifFreeRxBuffer(
                handle,buffer,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        }
        return u32(0xffffffff)
    }
    val packet = esp32RecoveredEspPbufAllocate(
        handle,buffer,length,buffer,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (packet == u32(0)) {
        esp32RecoveredEspNetifFreeRxBuffer(
            handle,buffer,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        return esp32EthernetEspNoMemory
    }
    val input = esp32EthernetLoadU32(netif + u32(176))
    if (u32(ablaUnsafeCallI32I32I32(int(input),int(packet),int(netif))) != u32(0)) {
        esp32LwipPbufFree(packet)
        return u32(0xffffffff)
    }
    u32(0)
}

trusted fun esp32EthernetInitialize(netif:u32):u32 {
    if (netif == u32(0)) {
        esp32AssertFailed(esp32EthernetAssertFile,u32(159),
            esp32EthernetAssertFunction,esp32EthernetAssertExpression)
    }
    val handle = esp32EthernetLoadU32(netif + u32(192))
    val hostnameStatus = esp32RecoveredEspNetifGetHostname(
        handle,netif + u32(216),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if (hostnameStatus != u32(0)) {
        esp32EthernetStoreU32(netif + u32(216), esp32EthernetDefaultHostname)
    }
    esp32EthernetStoreU8(netif + u32(232),u32(101))
    esp32EthernetStoreU8(netif + u32(233),u32(110))
    esp32EthernetStoreU32(netif + u32(180),u32(nativeFunctionAddress(esp32RecoveredEtharpOutput)))
    esp32EthernetStoreU32(netif + u32(188),u32(nativeFunctionAddress(esp32RecoveredEthip6Output)))
    esp32EthernetStoreU32(netif + u32(184),u32(nativeFunctionAddress(esp32EthernetLowLevelOutput)))
    esp32EthernetLowLevelInitialize(netif)
    u32(0)
}
