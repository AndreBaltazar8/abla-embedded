import "./peripheral_delay_esp32s3.ab"

// Explicit bare-metal1kHz compatibility profile for M5Unified's tick waits.
// One logical tick is1ms. This busy-waits; it does not emulate RTOS scheduling.
// A platform with another tick duration must supply its own imuDelay provider.
trusted fun imuDelay(ticks: int): void {
    peripheralDelayMilliseconds(ticks)
    return
}
