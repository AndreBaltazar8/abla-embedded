// IDF S3 rtc_cntl_ll tag-memory register protocol. Configuration values are
// hardware block counts (zero encodes the full span), not byte lengths.
// Caller supplies a prepared retained DMA descriptor and owns CPU retention,
// both cache configurations, peers, interrupts and internal stack/code/data.
// Install after CPU retention enable, remove after CPU retention disable.
@inline
fun esp32S3TagFieldsValid(start: int,validSize: int,size: int,limit: int): bool =
    start >= 0 && start <= limit && validSize >= 0 && validSize <= limit && size >= 0 && size <= limit
@inline
trusted fun esp32S3TagUpdate(address: int,mask: int,value: int): void {
    esp32S3TagWrite(address,(esp32S3TagRead(address) & (0xFFFFFFFF ^ mask)) | (value & mask))
    return
}
@section(".iram1.abla.s3TagRetentionEnable")
trusted fun esp32S3TagRetentionEnableOwned(link: int,iEnable: bool,iStart: int,iValid: int,iSize: int,dEnable: bool,dStart: int,dValid: int,dSize: int): bool {
    if (link <= 0 || link > 0xFFFFFFFF || (link & 15) != 0) return false
    if (!esp32S3TagFieldsValid(iStart,iValid,iSize,255) || !esp32S3TagFieldsValid(dStart,dValid,dSize,511)) return false
    val control=esp32S3TagRead(0x60008140)
    // Require armed CPU retention; never overwrite someone else's tags.
    if ((control & 0x0100C000) != 0x01004000) return false
    if ((esp32S3TagRead(0x600260BC) & 0x80000000) != 0 || (esp32S3TagRead(0x600260C0) & 0x80000000) != 0) return false
    esp32S3TagUpdate(0x600260B8,0x07FFFFFF,link)
    esp32S3TagUpdate(0x60008140,0x8000,0x8000)
    if (iEnable) {
        esp32S3TagUpdate(0x600260BC,0x3FC00000,iStart<<22)
        esp32S3TagUpdate(0x600260BC,0x001FE000,iValid<<13)
        esp32S3TagUpdate(0x600260BC,0x00000FF0,iSize<<4)
        esp32S3TagUpdate(0x600260BC,0x80000000,0x80000000)
    }
    if (dEnable) {
        esp32S3TagUpdate(0x600260C0,0x7FC00000,dStart<<22)
        esp32S3TagUpdate(0x600260C0,0x003FE000,dValid<<13)
        esp32S3TagUpdate(0x600260C0,0x00001FF0,dSize<<4)
        esp32S3TagUpdate(0x600260C0,0x80000000,0x80000000)
    }
    true
}
@section(".iram1.abla.s3TagRetentionDisable")
trusted fun esp32S3TagRetentionDisableOwned(iEnable: bool,dEnable: bool): bool {
    val control=esp32S3TagRead(0x60008140)
    if ((control & 0x01008000) != 0x8000) return false
    // Refuse mismatched ownership rather than leaving a stale cache enable.
    if (((esp32S3TagRead(0x600260BC) & 0x80000000) != 0) != iEnable) return false
    if (((esp32S3TagRead(0x600260C0) & 0x80000000) != 0) != dEnable) return false
    esp32S3TagUpdate(0x60008140,0x8000,0)
    if (iEnable) esp32S3TagUpdate(0x600260BC,0x80000000,0)
    if (dEnable) esp32S3TagUpdate(0x600260C0,0x80000000,0)
    true
}
