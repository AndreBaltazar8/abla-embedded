import "./clic_vectors_p4_sequence.ab"
import "./clic_esp32p4.ab"
import "../riscv/memory.ab"
import "../hal/esp32.ab"
trusted noescape extern:"inline-assembly" fun p4ClicCsrRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4ClicCsrWrite(template: string,constraints: string,value: u32): void
@export("p4ClicReadMtvec")
trusted fun p4ClicReadMtvecHook(): u32 = p4ClicCsrRead("csrr $0, mtvec","=r,~{memory}")
@export("p4ClicReadMtvt")
trusted fun p4ClicReadMtvtHook(): u32 = p4ClicCsrRead("csrr $0, 0x307","=r,~{memory}")
@export("p4ClicWriteMtvec")
trusted fun p4ClicWriteMtvecHook(value: u32): void = p4ClicCsrWrite("csrw mtvec, $0","r,~{memory}",value)
@export("p4ClicWriteMtvt")
trusted fun p4ClicWriteMtvtHook(value: u32): void = p4ClicCsrWrite("csrw 0x307, $0","r,~{memory}",value)
@export("p4ClicVectorFence")
trusted fun p4ClicVectorFenceHook(): void = riscvDeviceMemoryFence()
