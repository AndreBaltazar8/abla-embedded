import "./clic_vectors_p4_sequence.ab"
import "./clic_esp32p4.ab"
import "../riscv/memory.ab"
trusted noescape extern:"inline-assembly" fun p4ClicCsrRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun p4ClicCsrWrite(template: string,constraints: string,value: u32): void
trusted fun p4ClicReadMtvec(): u32 = p4ClicCsrRead("csrr $0, mtvec","=r,~{memory}")
trusted fun p4ClicReadMtvt(): u32 = p4ClicCsrRead("csrr $0, 0x307","=r,~{memory}")
trusted fun p4ClicWriteMtvec(value: u32): void = p4ClicCsrWrite("csrw mtvec, $0","r,~{memory}",value)
trusted fun p4ClicWriteMtvt(value: u32): void = p4ClicCsrWrite("csrw 0x307, $0","r,~{memory}",value)
trusted fun p4ClicVectorFence(): void = riscvDeviceMemoryFence()
