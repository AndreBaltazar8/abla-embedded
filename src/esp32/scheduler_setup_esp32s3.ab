import "./scheduler_setup_s3_sequence.ab"
import "./scheduler_run_esp32s3.ab"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
import "abla/unsafe/mmio"
import "./sdk/raw_buffer.ab"
import "../scheduler/ready_queue_sequence.ab"
import "./sdk/nativebuffer_type.ab"
@inline
@export("esp32S3SchedulerSetupCore")
trusted fun esp32S3SchedulerSetupCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3SchedulerSetupEnabled")
trusted fun esp32S3SchedulerSetupEnabledHook(): int = esp32S3IrqStackEnabled()
@inline
@export("esp32S3SchedulerSetupRead")
trusted fun esp32S3SchedulerSetupReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3SchedulerSetupWrite")
trusted fun esp32S3SchedulerSetupWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
@export("esp32S3SchedulerSetupQueueValid")
trusted fun esp32S3SchedulerSetupQueueValidHook(queue: NativeBuffer): bool = readyQueueValid(queue)
