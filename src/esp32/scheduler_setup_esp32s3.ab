import "./scheduler_setup_s3_sequence.ab"
import "./scheduler_run_esp32s3.ab"
@inline
trusted fun esp32S3SchedulerSetupCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3SchedulerSetupEnabled(): int = esp32S3IrqStackEnabled()
@inline
trusted fun esp32S3SchedulerSetupRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3SchedulerSetupWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3SchedulerSetupQueueValid(queue: NativeBuffer): bool = readyQueueValid(queue)
