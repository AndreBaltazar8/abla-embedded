// Publish a52bit SYSTIMER counter load without reset, clock selection or IRQ
// changes. Caller exclusively owns the counter, shared load/configuration and
// all alarm/scheduler users; whole closure/stack retained if flash unavailable.
// Value is raw ticks. Loading a running counter is NOT guaranteed monotonic:
// compensation policy and exclusion of observers belong to the caller.
//1load published2invalid3clock unavailable4shadow mismatch (no publication).
// LOAD is WT and has no completion acknowledgement; never claim readback of
// the shadow value proves the running counter accepted a silently lost strobe.
@section(".iram1.abla.c5TimerLoad")
trusted fun esp32C5TimerLoadOwned(unit: int,ticks: int,exclusive: bool): int {
    if (!exclusive || unit < 0 || unit > 1 || ticks < 0 || ticks > 0xfffffffffffff) return 2
    if ((esp32C5TimerRead(0x6009606c)&u32(7)) != u32(5) || (esp32C5TimerRead(0x60096070)&u32(0x400000)) == u32(0)) return 3
    val high=0x6000a00c+unit*8;val low=high+4
    val upper=u32(ticks>>>32)
    esp32C5TimerWrite(high,(esp32C5TimerRead(high)&u32(0xfff00000))|upper)
    esp32C5TimerWrite(low,u32(ticks))
    if ((esp32C5TimerRead(high)&u32(0xfffff)) != upper || esp32C5TimerRead(low) != u32(ticks)) return 4
    esp32C5TimerWrite(0x6000a05c+unit*4,u32(1))
    1
}
