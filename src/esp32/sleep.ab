import "./power/sleep_modes_esp32.ab"

trusted noescape fun esp_sleep_enable_ext0_wakeup(
    pin: i32,
    level: i32
): i32 = i32(esp32RecoveredEspSleepEnableExt0Wakeup(
    u32(pin), u32(level),
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0)
))

trusted noescape fun esp_sleep_get_wakeup_cause(): i32 =
    i32(esp32RecoveredEspSleepGetWakeupCause(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    ))

trusted noescape fun esp_deep_sleep_start(): void {
    esp32RecoveredEspDeepSleepStart(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun wakeOnLow(pin: int): bool =
    esp_sleep_enable_ext0_wakeup(i32(pin), 0) == 0

trusted fun wakeCause(): int {
    val result: int = esp_sleep_get_wakeup_cause()
    result
}

trusted fun deepSleep(): void {
    esp_deep_sleep_start()
    return
}
