import "./task_frame_s3_sequence.ab"
import "./context_return_esp32s3.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
@section(".iram1.abla.s3TaskEntry")
trusted fun esp32S3TaskEntry(entry: u32,arg: u32,onReturn: u32): void {
    callNativeVoidI32(int(entry),int(arg))
    callNativeVoidI32(int(onReturn),int(arg))
    // Returning from the retirement/fatal handler violates the task contract.
    esp32S3ContextExtraAssembly("rsil a0, 15\n1: j 1b","~{a0},~{memory}")
    return
}
@inline
trusted fun esp32S3TaskFrameWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3TaskFrameEntryAddress(): int = nativeFunctionAddress(esp32S3TaskEntry)
@inline
trusted fun esp32S3TaskFrameReturnAddress(): int = esp32S3ContextReturn1Address()
