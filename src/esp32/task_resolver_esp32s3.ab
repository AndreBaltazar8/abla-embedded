import "./task_resolver_s3_sequence.ab"
import "./irq_stack_esp32s3.ab"
import "abla/unsafe/native"
@inline
trusted fun esp32S3TaskResolverCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3TaskResolverEnabled(): int = esp32S3IrqStackEnabled()
@inline
trusted fun esp32S3TaskResolverConfig(): int = esp32S3IrqConfigAddress()
@inline
trusted fun esp32S3TaskResolverRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3TaskResolverWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3TaskResolverAddress(): int = nativeFunctionAddress(esp32S3TaskResolve)
