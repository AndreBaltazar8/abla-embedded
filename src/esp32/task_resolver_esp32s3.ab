import "./task_resolver_s3_sequence.ab"
import "./irq_stack_esp32s3.ab"
import "abla/unsafe/native"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
import "abla/unsafe/mmio"
@inline
@export("esp32S3TaskResolverCore")
trusted fun esp32S3TaskResolverCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3TaskResolverEnabled")
trusted fun esp32S3TaskResolverEnabledHook(): int = esp32S3IrqStackEnabled()
@inline
@export("esp32S3TaskResolverConfig")
trusted fun esp32S3TaskResolverConfigHook(): int = esp32S3IrqConfigAddress()
@inline
@export("esp32S3TaskResolverRead")
trusted fun esp32S3TaskResolverReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3TaskResolverWrite")
trusted fun esp32S3TaskResolverWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3TaskResolverAddress(): int = nativeFunctionAddress(esp32S3TaskResolve)
