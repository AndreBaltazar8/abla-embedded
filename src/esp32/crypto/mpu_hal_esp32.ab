import "../../xtensa/assembly.ab"

// Abla/LLVM implementation of ESP32 MPU region access permissions.

// Original ABI symbol: mpu_hal_set_region_access.
trusted fun esp32MpuSetRegionAccess(
    regionIndex: u32,
    access: u32
): void {
    val virtualAddress = regionIndex << u32(29)
    if (access == u32(0)) {
        xtensaWriteInstructionTlb(u32(15), virtualAddress)
        xtensaInstructionSynchronize()
        xtensaWriteDataTlb(u32(15), virtualAddress)
        xtensaDataSynchronize()
    } else if (access == u32(1)) {
        xtensaWriteDataTlb(u32(0), virtualAddress)
        xtensaDataSynchronize()
    } else if (access == u32(2)) {
        xtensaWriteInstructionTlb(u32(3), virtualAddress)
        xtensaInstructionSynchronize()
    } else if (access == u32(3)) {
        xtensaWriteDataTlb(u32(2), virtualAddress)
        xtensaDataSynchronize()
    }
    return
}
