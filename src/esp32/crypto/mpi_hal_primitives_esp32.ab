import "../dport_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

val esp32MpiBase = u32(1072701440)
val esp32MpiMBlock = esp32MpiBase
val esp32MpiZBlock = esp32MpiBase + u32(512)
val esp32MpiYBlock = esp32MpiBase + u32(1024)
val esp32MpiXBlock = esp32MpiBase + u32(1536)
val esp32MpiMPrime = esp32MpiBase + u32(2048)
val esp32MpiMode = esp32MpiBase + u32(2060)
val esp32MpiStart = esp32MpiBase + u32(2064)
val esp32MpiInterrupt = esp32MpiBase + u32(2068)
val esp32MpiClean = esp32MpiBase + u32(2072)

@inline
fun esp32MpiParameterBase(parameter: u32): u32 =
    if (parameter == u32(0)) esp32MpiXBlock
    else if (parameter == u32(1)) esp32MpiYBlock
    else if (parameter == u32(2)) esp32MpiZBlock
    else esp32MpiMBlock

@inline
trusted fun esp32MpiLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32MpiStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

fun esp32MpiHalCalcHardwareWords(words: u32): u32 =
    (words + u32(15)) & u32(4294967280)

trusted fun esp32MpiHalEnableHardwareHwOp(): void {
    while (esp32DportReadShared(esp32MpiClean) == u32(0)) { }
}

fun esp32MpiHalDisableHardwareHwOp(): void { return }

trusted fun esp32MpiHalInterruptEnable(enable: u32): void =
    esp32DportWrite(
        esp32MpiInterrupt, if (enable != u32(0)) u32(1) else u32(0)
    )

trusted fun esp32MpiHalClearInterrupt(): void =
    esp32DportWrite(esp32MpiInterrupt, u32(1))

trusted fun esp32MpiHalSetMode(words: u32): void =
    esp32DportWrite(esp32MpiMode, words)

trusted fun esp32MpiHalWriteToMemBlock(
    parameter: u32,
    offset: u32,
    sourceAddress: u32,
    sourceWords: u32,
    hardwareWords: u32
): void {
    val base = esp32MpiParameterBase(parameter) + offset
    val copied = if (sourceWords < hardwareWords)
        sourceWords else hardwareWords
    var word = u32(0)
    while (word < copied) {
        esp32DportWrite(
            base + (word << u32(2)),
            esp32MpiLoadU32(sourceAddress + (word << u32(2)))
        )
        word = word + u32(1)
    }
    while (word < hardwareWords) {
        esp32DportWrite(base + (word << u32(2)), u32(0))
        word = word + u32(1)
    }
}

trusted fun esp32MpiHalWriteAtOffset(
    parameter: u32,
    offset: i32,
    value: u32
): void = esp32DportWrite(
    esp32MpiParameterBase(parameter) + u32(offset), value
)

trusted fun esp32MpiHalWriteMPrime(value: u32): void =
    esp32DportWrite(esp32MpiMPrime, value)

trusted fun esp32MpiHalWriteRinv(value: u32): void =
    esp32DportWrite(esp32MpiZBlock, value)

trusted fun esp32MpiHalStartOp(operation: u32): void {
    esp32MpiHalClearInterrupt()
    // Classic ESP32 exposes one multiplication operation; retaining the
    // indexed form makes invalid callers fail instead of silently selecting a
    // different register.
    if (operation != u32(0)) ablaRuntimeTrap()
    esp32DportWrite(esp32MpiStart, u32(1))
}

trusted fun esp32MpiHalWaitOpComplete(): void {
    while (esp32DportReadShared(esp32MpiInterrupt) == u32(0)) { }
    esp32MpiHalClearInterrupt()
}

trusted fun esp32MpiHalReadResultHwOp(
    outputAddress: u32,
    outputWords: u32,
    resultWords: u32
): void {
    esp32MpiHalWaitOpComplete()
    if (outputWords < resultWords) ablaRuntimeTrap()
    var word = u32(0)
    while (word < resultWords) {
        esp32MpiStoreU32(
            outputAddress + (word << u32(2)),
            esp32DportReadShared(
                esp32MpiZBlock + (word << u32(2))
            )
        )
        word = word + u32(1)
    }
    while (word < outputWords) {
        esp32MpiStoreU32(outputAddress + (word << u32(2)), u32(0))
        word = word + u32(1)
    }
}
