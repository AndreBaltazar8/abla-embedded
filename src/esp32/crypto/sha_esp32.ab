import "../../register.ab"
import "../sdk/buffer.ab"

// Allocation-free SHA-1 and SHA-256 over the classic ESP32 SHA engine.
// The SHA peripheral is shared by both cores, Wi-Fi, TLS, secure boot, and
// other crypto users. Callers must serialize each complete request.
//
// esp32ShaVectorRequest32 layout (all fields are little-endian u32):
//   +0  algorithm (0 = SHA-1, 1 = SHA-256)
//   +4  address of an array of { address, byteLength } u32 pairs
//   +8  vector element count
//   +12 output address (20 bytes for SHA-1, 32 bytes for SHA-256)
//   +16 maximum busy-register polls per hardware operation
//   +20 separate length-array address, or zero for interleaved descriptors
//
// A one-pointer boundary is intentional: NativeBuffer occupies two Xtensa
// argument words, and wide scalar APIs otherwise spill unpredictably beyond
// the six-word register argument window.
val esp32Sha1 = 0
val esp32Sha256 = 1
val esp32ShaVectorDescriptorBytes = 8
val esp32ShaVectorRequestBytes = 24

val esp32ShaBase = 1072705536
val esp32ShaTextAddress = esp32ShaBase
val esp32Sha1StartAddress = esp32ShaBase + 128
val esp32Sha1ContinueAddress = esp32ShaBase + 132
val esp32Sha1LoadAddress = esp32ShaBase + 136
val esp32Sha1BusyAddress = esp32ShaBase + 140
val esp32Sha256BusyAddress = esp32ShaBase + 156
val esp32Sha384BusyAddress = esp32ShaBase + 172
val esp32Sha512BusyAddress = esp32ShaBase + 188
val esp32ShaTypeRegisterStride = 16
val esp32ShaPeripheralMask = 2
val esp32ShaDportPeripheralClockEnableAddress = 1072693276
val esp32ShaDportPeripheralResetEnableAddress = 1072693280
val esp32ShaSecureBootPeripheralMask = 8
val esp32ShaMaximumByteLength = 1152921504606846975

@inline
trusted fun esp32ShaEnableAndReset(): void {
    register32(esp32ShaDportPeripheralClockEnableAddress).setBits(
        esp32ShaPeripheralMask
    )
    val reset = register32(esp32ShaDportPeripheralResetEnableAddress)
    reset.setBits(esp32ShaPeripheralMask)
    reset.clearBits(
        esp32ShaPeripheralMask | esp32ShaSecureBootPeripheralMask
    )
    return
}

@inline
trusted fun esp32ShaBusy(): bool =
    register32(esp32Sha1BusyAddress).read() != 0 ||
    register32(esp32Sha256BusyAddress).read() != 0 ||
    register32(esp32Sha384BusyAddress).read() != 0 ||
    register32(esp32Sha512BusyAddress).read() != 0

trusted fun esp32ShaWaitIdle(maximumPolls: u32): bool {
    var polls = u32(0)
    var busy = esp32ShaBusy()
    while (busy && polls < maximumPolls) {
        polls = polls + u32(1)
        busy = esp32ShaBusy()
    }
    !busy
}

@inline
fun esp32ShaSwapU32(word: u32): u32 =
    ((word & u32(255)) << u32(24)) |
    ((word & u32(65280)) << u32(8)) |
    ((word >>> u32(8)) & u32(65280)) |
    ((word >>> u32(24)) & u32(255))

trusted fun esp32ShaProcessBlock32(
    blockAddress: u32,
    algorithm: int,
    firstBlock: bool,
    maximumPolls: u32
): bool {
    if ((algorithm != esp32Sha1 && algorithm != esp32Sha256) ||
        blockAddress == u32(0) || blockAddress > u32(4294967232) ||
        (blockAddress & u32(3)) != u32(0) || maximumPolls == u32(0) ||
        !esp32ShaWaitIdle(maximumPolls)) return false
    var index = 0
    while (index < 16) {
        val sourceAddress = blockAddress + u32(index * 4)
        register32(esp32ShaTextAddress + index * 4).write(int(
            esp32ShaSwapU32(u32(
                ablaUnsafeVolatileLoadU32(int(sourceAddress))
            ))
        ))
        index = index + 1
    }
    val controlOffset = algorithm * esp32ShaTypeRegisterStride
    val controlAddress = if (firstBlock)
        esp32Sha1StartAddress + controlOffset
    else esp32Sha1ContinueAddress + controlOffset
    register32(controlAddress).write(1)
    esp32ShaWaitIdle(maximumPolls)
}

trusted fun esp32ShaReadDigest32(
    algorithm: int,
    outputAddress: u32,
    maximumPolls: u32
): bool {
    val digestBytes = if (algorithm == esp32Sha1) 20 else 32
    if ((algorithm != esp32Sha1 && algorithm != esp32Sha256) ||
        outputAddress == u32(0) ||
        outputAddress > u32(4294967295 - digestBytes) ||
        maximumPolls == u32(0) ||
        !esp32ShaWaitIdle(maximumPolls)) return false
    register32(
        esp32Sha1LoadAddress + algorithm * esp32ShaTypeRegisterStride
    ).write(1)
    if (!esp32ShaWaitIdle(maximumPolls)) return false
    var offset = 0
    var nonzero = false
    while (offset < digestBytes) {
        val word = register32(esp32ShaTextAddress + offset).read()
        val ordered = esp32ShaSwapU32(u32(word))
        ablaUnsafeVolatileStoreU8(
            int(outputAddress + u32(offset)), int(ordered & u32(255))
        )
        ablaUnsafeVolatileStoreU8(
            int(outputAddress + u32(offset + 1)),
            int((ordered >>> u32(8)) & u32(255))
        )
        ablaUnsafeVolatileStoreU8(
            int(outputAddress + u32(offset + 2)),
            int((ordered >>> u32(16)) & u32(255))
        )
        ablaUnsafeVolatileStoreU8(
            int(outputAddress + u32(offset + 3)),
            int((ordered >>> u32(24)) & u32(255))
        )
        nonzero = nonzero || word != 0
        offset = offset + 4
    }
    nonzero
}

trusted fun esp32ShaClearOutput(outputAddress: u32, length: int): void {
    if (outputAddress == u32(0) || length < 0 ||
        outputAddress > u32(4294967295 - length)) return
    var index = 0
    while (index < length) {
        ablaUnsafeVolatileStoreU8(int(outputAddress + u32(index)), 0)
        index = index + 1
    }
    return
}

trusted fun esp32ShaVectorRequest32(requestAddress: u32): bool {
    if (requestAddress == u32(0) || requestAddress > u32(4294967272) ||
        (requestAddress & u32(3)) != u32(0)) return false
    val algorithm = int(ablaUnsafeVolatileLoadU32(int(requestAddress)))
    val descriptorsAddress = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(4))
    ))
    val descriptorCount = int(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(8))
    ))
    val outputAddress = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(12))
    ))
    val maximumPolls = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(16))
    ))
    val lengthsAddress = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(20))
    ))
    val digestBytes = if (algorithm == esp32Sha1) 20 else 32
    if ((algorithm != esp32Sha1 && algorithm != esp32Sha256) ||
        descriptorCount < 0 || maximumPolls == u32(0) ||
        outputAddress == u32(0) ||
        outputAddress > u32(4294967295 - digestBytes) ||
        (descriptorCount > 0 && (descriptorsAddress == u32(0) ||
            (descriptorsAddress & u32(3)) != u32(0) ||
            (lengthsAddress != u32(0) &&
                (lengthsAddress & u32(3)) != u32(0))))) return false
    val descriptorStride = if (lengthsAddress == u32(0)) 8 else 4
    val descriptorBytes = descriptorCount * descriptorStride
    if (descriptorBytes < 0 || descriptorBytes > 4294967295 ||
        (descriptorCount > 0 &&
            (int(descriptorsAddress) > 4294967295 - descriptorBytes ||
            (lengthsAddress != u32(0) &&
                int(lengthsAddress) > 4294967295 - descriptorCount * 4)))) {
        esp32ShaClearOutput(outputAddress, digestBytes)
        return false
    }

    var totalLength = 0
    var descriptorIndex = 0
    var valid = true
    while (valid && descriptorIndex < descriptorCount) {
        val descriptorAddress = descriptorsAddress +
            u32(descriptorIndex * descriptorStride)
        val dataAddress = u32(ablaUnsafeVolatileLoadU32(
            int(descriptorAddress)
        ))
        val dataLength = int(ablaUnsafeVolatileLoadU32(
            if (lengthsAddress == u32(0))
                int(descriptorAddress + u32(4))
            else int(lengthsAddress + u32(descriptorIndex * 4))
        ))
        valid = dataLength >= 0 &&
            (dataLength == 0 || (dataAddress != u32(0) &&
                int(dataAddress) <= 4294967295 - dataLength)) &&
            totalLength <= esp32ShaMaximumByteLength - dataLength
        if (valid) totalLength = totalLength + dataLength
        descriptorIndex = descriptorIndex + 1
    }
    if (!valid) {
        esp32ShaClearOutput(outputAddress, digestBytes)
        return false
    }

    // Reserve Xtensa's 48-byte outgoing-call area ahead of the aligned block.
    val workspaceAddress = nativeStackAllocate(112)
    val block = nativeBufferAt(workspaceAddress + 48, 64)
    var blockUsed = 0
    var firstBlock = true
    descriptorIndex = 0
    esp32ShaEnableAndReset()
    while (valid && descriptorIndex < descriptorCount) {
        val descriptorAddress = descriptorsAddress +
            u32(descriptorIndex * descriptorStride)
        val dataAddress = u32(ablaUnsafeVolatileLoadU32(
            int(descriptorAddress)
        ))
        val dataLength = int(ablaUnsafeVolatileLoadU32(
            if (lengthsAddress == u32(0))
                int(descriptorAddress + u32(4))
            else int(lengthsAddress + u32(descriptorIndex * 4))
        ))
        var sourceOffset = 0
        while (valid && sourceOffset < dataLength) {
            block.store(
                blockUsed,
                ablaUnsafeVolatileLoadU8(
                    int(dataAddress + u32(sourceOffset))
                )
            )
            blockUsed = blockUsed + 1
            sourceOffset = sourceOffset + 1
            if (blockUsed == 64) {
                valid = esp32ShaProcessBlock32(
                    u32(block.addressValue()), algorithm, firstBlock,
                    maximumPolls
                )
                firstBlock = false
                blockUsed = 0
            }
        }
        descriptorIndex = descriptorIndex + 1
    }

    if (valid) {
        block.store(blockUsed, 128)
        blockUsed = blockUsed + 1
        if (blockUsed > 56) {
            while (blockUsed < 64) {
                block.store(blockUsed, 0)
                blockUsed = blockUsed + 1
            }
            valid = esp32ShaProcessBlock32(
                u32(block.addressValue()), algorithm, firstBlock, maximumPolls
            )
            firstBlock = false
            blockUsed = 0
        }
    }
    while (valid && blockUsed < 56) {
        block.store(blockUsed, 0)
        blockUsed = blockUsed + 1
    }
    if (valid) {
        val bitLength = totalLength * 8
        var lengthIndex = 0
        while (lengthIndex < 8) {
            block.store(
                56 + lengthIndex,
                (bitLength >>> ((7 - lengthIndex) * 8)) & 255
            )
            lengthIndex = lengthIndex + 1
        }
        valid = esp32ShaProcessBlock32(
            u32(block.addressValue()), algorithm, firstBlock, maximumPolls
        ) && esp32ShaReadDigest32(
            algorithm, outputAddress, maximumPolls
        )
    }
    if (!valid) esp32ShaClearOutput(outputAddress, digestBytes)
    valid
}

@inline
trusted fun esp32ShaBufferWithPollLimit(
    algorithm: int,
    data: NativeBuffer,
    digest: NativeBuffer,
    maximumPolls: u32
): bool {
    val descriptor = nativeStackAllocate(esp32ShaVectorDescriptorBytes)
    val request = nativeStackAllocate(esp32ShaVectorRequestBytes)
    ablaUnsafeVolatileStoreU32(descriptor, u32(data.addressValue()))
    ablaUnsafeVolatileStoreU32(descriptor + 4, u32(data.capacity()))
    ablaUnsafeVolatileStoreU32(request, u32(algorithm))
    ablaUnsafeVolatileStoreU32(request + 4, u32(descriptor))
    ablaUnsafeVolatileStoreU32(request + 8, u32(1))
    ablaUnsafeVolatileStoreU32(request + 12, u32(digest.addressValue()))
    ablaUnsafeVolatileStoreU32(request + 16, maximumPolls)
    ablaUnsafeVolatileStoreU32(request + 20, 0)
    esp32ShaVectorRequest32(u32(request))
}

@inline
trusted fun esp32Sha1Buffer(
    data: NativeBuffer,
    digest: NativeBuffer
): bool = if (digest.capacity() < 20) false else esp32ShaBufferWithPollLimit(
    esp32Sha1, data, digest, u32(100000)
)

@inline
trusted fun esp32Sha256Buffer(
    data: NativeBuffer,
    digest: NativeBuffer
): bool = if (digest.capacity() < 32) false else esp32ShaBufferWithPollLimit(
    esp32Sha256, data, digest, u32(100000)
)
