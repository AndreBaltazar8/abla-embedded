import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMpiHalOpaqueCallers(): bool {
    if (!exportFunction("esp32MpiHalCalcHardwareWords", "mpi_hal_calc_hardware_words")) return false
    if (!exportFunction("esp32MpiHalEnableHardwareHwOp", "mpi_hal_enable_hardware_hw_op")) return false
    if (!internalFunction("esp32MpiHalDisableHardwareHwOp", "mpi_hal_disable_hardware_hw_op")) return false
    if (!exportFunction("esp32MpiHalInterruptEnable", "mpi_hal_interrupt_enable")) return false
    if (!exportFunction("esp32MpiHalClearInterrupt", "mpi_hal_clear_interrupt")) return false
    if (!exportFunction("esp32MpiHalSetMode", "mpi_hal_set_mode")) return false
    if (!exportFunction("esp32MpiHalWriteToMemBlock", "mpi_hal_write_to_mem_block")) return false
    if (!exportFunction("esp32MpiHalWriteAtOffset", "mpi_hal_write_at_offset")) return false
    if (!exportFunction("esp32MpiHalWriteMPrime", "mpi_hal_write_m_prime")) return false
    if (!exportFunction("esp32MpiHalWriteRinv", "mpi_hal_write_rinv")) return false
    if (!exportFunction("esp32MpiHalStartOp", "mpi_hal_start_op")) return false
    if (!exportFunction("esp32MpiHalWaitOpComplete", "mpi_hal_wait_op_complete")) return false
    if (!exportFunction("esp32MpiHalReadResultHwOp", "mpi_hal_read_result_hw_op")) return false
    true
}
