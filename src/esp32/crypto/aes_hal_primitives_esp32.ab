import "../../register.ab"
import "../dport_esp32.ab"
import "abla/unsafe/memory"

// ESP-IDF's classic ESP32 AES HAL is register IO plus scalar loops. Keeping
// those operations typed lets LLVM inline the HAL into its actual TLS/Wi-Fi
// callers and discard unused modes.
val esp32AesHalBase = 1072697344
val esp32AesHalStart = esp32AesHalBase
val esp32AesHalIdle = esp32AesHalBase + 4
val esp32AesHalMode = esp32AesHalBase + 8
val esp32AesHalKey = esp32AesHalBase + 16
val esp32AesHalText = esp32AesHalBase + 48

@inline
trusted fun esp32AesHalLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32AesHalStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

// esp_aes_context.key begins at byte two, so it is not word-aligned.
// Match aes_ll_write_key's memcpy instead of asserting alignment to LLVM.
@inline
trusted fun esp32AesHalLoadKeyWord(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))) |
    (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address + u32(1))))) << u32(8)) |
    (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address + u32(2))))) << u32(16)) |
    (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address + u32(3))))) << u32(24))

trusted fun esp32AesHalSetkey(
    keyAddress: u32,
    keyBytes: u32,
    mode: i32
): u32 {
    // The SDK uses 1 for encryption; the hardware uses bit 2 for decryption.
    register32(esp32AesHalMode).write(
        (if (mode == 1) 0 else 4) + int(keyBytes >>> u32(3)) - 2
    )
    val words = keyBytes >>> u32(2)
    var word = u32(0)
    while (word < words) {
        register32(esp32AesHalKey + int(word << u32(2))).write(int(
            esp32AesHalLoadKeyWord(keyAddress + (word << u32(2)))
        ))
        word = word + u32(1)
    }
    keyBytes & u32(255)
}

trusted fun esp32AesHalTransformBlock(
    inputAddress: u32,
    outputAddress: u32
): void {
    var word = u32(0)
    while (word < u32(4)) {
        register32(esp32AesHalText + int(word << u32(2))).write(int(
            esp32AesHalLoadU32(inputAddress + (word << u32(2)))
        ))
        word = word + u32(1)
    }
    register32(esp32AesHalStart).write(1)
    while (esp32DportReadShared(u32(esp32AesHalIdle)) != u32(1)) { }
    word = u32(0)
    while (word < u32(4)) {
        esp32AesHalStoreU32(
            outputAddress + (word << u32(2)),
            esp32DportReadShared(
                u32(esp32AesHalText) + (word << u32(2))
            )
        )
        word = word + u32(1)
    }
}
