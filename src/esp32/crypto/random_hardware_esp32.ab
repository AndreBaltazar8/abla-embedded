import "../../register.ab"
import "../../xtensa/assembly.ab"
import "../rom/system_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

var esp32HardwareRandomLastCycle = u32(0)

@inline
trusted fun esp32HardwareRandomLoad(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32HardwareRandomCpuFrequency(): u32 =
    esp32HardwareRandomLoad(u32(1073611232)) * u32(1000000)

@inline
trusted fun esp32HardwareRandomApbFrequency(): u32 {
    val cpu = esp32HardwareRandomCpuFrequency()
    return if (cpu < u32(80000000)) cpu else u32(80000000)
}

trusted fun esp32HardwareRandomRtcByte(): u32 {
    val control = register32(1072988172)
    if ((u32(control.read()) & u32(1073741824)) == u32(0)) {
        control.setBits(2147483648)
        var remaining = u32(1000)
        while ((u32(control.read()) & u32(1073741824)) == u32(0) &&
            remaining != u32(0)) {
            esp32RomDelayUsValue(u32(1))
            remaining = remaining - u32(1)
        }
    }
    register32(1072988232).setBits(16)
    u32(register32(1072988176).read()) & u32(255)
}

@section(".iram1.0.abla.esp32HardwareRandom")
trusted fun esp32HardwareRandom(): u32 {
    val apb = esp32HardwareRandomApbFrequency()
    val cpu = esp32HardwareRandomCpuFrequency()
    val ratio = if (apb == u32(0)) u32(1) else cpu / apb
    var result = u32(0)
    var cycle = u32(0)
    var byteIndex = u32(0)
    while (byteIndex < u32(4)) {
        while (true) {
            cycle = xtensaReadCycleCount()
            result = result ^ u32(register32(1610830148).read())
            if (cycle - esp32HardwareRandomLastCycle >= ratio << u32(4)) {
                break
            }
        }
        result = result ^ (
            esp32HardwareRandomRtcByte() << (byteIndex << u32(3))
        )
        byteIndex = byteIndex + u32(1)
    }
    esp32HardwareRandomLastCycle = cycle
    result ^ u32(register32(1610830148).read())
}

trusted fun esp32FillHardwareRandom(buffer: u32, lengthValue: u32): void {
    if (buffer == u32(0)) ablaRuntimeTrap()
    var destination = buffer
    var length = lengthValue
    while (length != u32(0)) {
        val word = esp32HardwareRandom()
        val count = if (length < u32(4)) length else u32(4)
        var byteIndex = u32(0)
        while (byteIndex < count) {
            ablaUnsafeStoreU8(
                nativePointerFromAddress(int(destination + byteIndex)),
                int((word >>> (byteIndex << u32(3))) & u32(255))
            )
            byteIndex = byteIndex + u32(1)
        }
        destination = destination + count
        length = length - count
    }
    return
}

trusted fun esp32RecoveredEspRandom(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32HardwareRandom()

trusted fun esp32RecoveredEspFillRandom(
    buffer: u32,
    length: u32,
    a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32FillHardwareRandom(buffer, length)
    buffer
}
