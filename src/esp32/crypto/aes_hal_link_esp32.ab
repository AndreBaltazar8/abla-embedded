import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkAesHalOpaqueCallers(): bool {
    if (!exportFunction("esp32AesHalSetkey", "aes_hal_setkey")) return false
    if (!exportFunction("esp32AesHalTransformBlock", "aes_hal_transform_block")) return false
    true
}
