import "./cbc_esp32.ab"
import "./cmac_gmac_esp32.ab"
import "./hmac_esp32.ab"
import "./pbkdf2_esp32.ab"

// Exact 32-bit hostap/ESP-IDF crypto ABIs. These are ordinary portable export
// names, not foreign declarations: every implementation body is Abla and
// lowers with the Xtensa LLVM backend.
trusted fun esp32WpaShaVectorAdapter(
    algorithm: int,
    count: u32,
    addresses: u32,
    lengths: u32,
    digest: u32
): i32 {
    val workspace = nativeStackAllocate(72)
    val request = nativeBufferAt(workspace + 48, 24)
    request.storeU32(0, algorithm)
    request.storeU32(4, int(addresses))
    request.storeU32(8, int(count))
    request.storeU32(12, int(digest))
    request.storeU32(16, 100000)
    request.storeU32(20, int(lengths))
    if (esp32ShaVectorRequest32(u32(request.addressValue()))) i32(0) else i32(-1)
}

trusted fun esp32WpaSha1Vector(
    count: u32,
    addresses: u32,
    lengths: u32,
    digest: u32
): i32 = esp32WpaShaVectorAdapter(
    esp32Sha1, count, addresses, lengths, digest
)

trusted fun esp32WpaSha256Vector(
    count: u32,
    addresses: u32,
    lengths: u32,
    digest: u32
): i32 = esp32WpaShaVectorAdapter(
    esp32Sha256, count, addresses, lengths, digest
)

@inline
trusted fun esp32WpaHmacVectorAdapter(
    algorithm: int,
    key: u32,
    keyLength: u32,
    count: u32,
    addresses: u32,
    lengths: u32,
    mac: u32
): i32 {
    val workspace = nativeStackAllocate(80)
    val request = nativeBufferAt(workspace + 48, 32)
    request.storeU32(0, algorithm)
    request.storeU32(4, int(key))
    request.storeU32(8, int(keyLength))
    request.storeU32(12, int(addresses))
    request.storeU32(16, int(count))
    request.storeU32(20, int(mac))
    request.storeU32(24, 100000)
    request.storeU32(28, int(lengths))
    if (esp32HmacShaVectorRequest32(u32(request.addressValue()))) i32(0) else i32(-1)
}

trusted fun esp32WpaHmacSha1Vector(
    key: u32,
    keyLength: u32,
    count: u32,
    addresses: u32,
    lengths: u32,
    mac: u32
): i32 = esp32WpaHmacVectorAdapter(
    esp32Sha1, key, keyLength, count, addresses, lengths, mac
)

trusted fun esp32WpaHmacSha256Vector(
    key: u32,
    keyLength: u32,
    count: u32,
    addresses: u32,
    lengths: u32,
    mac: u32
): i32 = esp32WpaHmacVectorAdapter(
    esp32Sha256, key, keyLength, count, addresses, lengths, mac
)

trusted fun esp32WpaPbkdf2Sha1(
    password: u32,
    salt: u32,
    saltLength: u32,
    iterations: i32,
    output: u32,
    outputLength: u32
): i32 {
    if (password == u32(0)) return i32(-1)
    var passwordLength = 0
    while (ablaUnsafeVolatileLoadU8(
        int(password + u32(passwordLength))
    ) != 0) passwordLength = passwordLength + 1
    val workspace = nativeStackAllocate(80)
    val request = nativeBufferAt(workspace + 48, 32)
    request.storeU32(0, int(password))
    request.storeU32(4, passwordLength)
    request.storeU32(8, int(salt))
    request.storeU32(12, int(saltLength))
    request.storeU32(16, int(iterations))
    request.storeU32(20, int(output))
    request.storeU32(24, int(outputLength))
    request.storeU32(28, 100000)
    if (esp32Pbkdf2Sha1Request32(u32(request.addressValue()))) i32(0) else i32(-1)
}

trusted fun esp32WpaAes128CbcAdapter(
    key: u32,
    iv: u32,
    data: u32,
    dataLength: u32,
    decrypt: bool
): i32 {
    val workspace = nativeStackAllocate(72)
    val request = nativeBufferAt(workspace + 48, 24)
    request.storeU32(0, int(key))
    request.storeU32(4, int(iv))
    request.storeU32(8, int(data))
    request.storeU32(12, int(dataLength))
    request.storeU32(16, if (decrypt) 1 else 0)
    request.storeU32(20, 100000)
    if (esp32Aes128CbcRequest32(u32(request.addressValue()))) i32(0) else i32(-1)
}

trusted fun esp32WpaAes128CbcEncrypt(
    key: u32,
    iv: u32,
    data: u32,
    dataLength: u32
): i32 = esp32WpaAes128CbcAdapter(
    key, iv, data, dataLength, false
)

trusted fun esp32WpaAes128CbcDecrypt(
    key: u32,
    iv: u32,
    data: u32,
    dataLength: u32
): i32 = esp32WpaAes128CbcAdapter(
    key, iv, data, dataLength, true
)

trusted fun esp32WpaOmac1Aes128(
    key: u32,
    data: u32,
    dataLength: u32,
    mac: u32
): i32 {
    val workspace = nativeStackAllocate(72)
    val request = nativeBufferAt(workspace + 48, 24)
    request.storeU32(0, int(key))
    request.storeU32(4, 16)
    request.storeU32(8, int(data))
    request.storeU32(12, int(dataLength))
    request.storeU32(16, int(mac))
    request.storeU32(20, 100000)
    if (esp32AesCmacRequest32(u32(request.addressValue()))) i32(0) else i32(-1)
}

trusted fun esp32WpaAesGmac(
    key: u32,
    keyLength: u32,
    iv: u32,
    ivLength: u32,
    aad: u32,
    aadLength: u32,
    tag: u32
): i32 {
    val workspace = nativeStackAllocate(80)
    val request = nativeBufferAt(workspace + 48, 32)
    request.storeU32(0, int(key))
    request.storeU32(4, int(keyLength))
    request.storeU32(8, int(iv))
    request.storeU32(12, int(ivLength))
    request.storeU32(16, int(aad))
    request.storeU32(20, int(aadLength))
    request.storeU32(24, int(tag))
    request.storeU32(28, 100000)
    if (esp32AesGmacRequest32(u32(request.addressValue()))) i32(0) else i32(-1)
}
