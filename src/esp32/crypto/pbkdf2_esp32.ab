import "./hmac_esp32.ab"

// PBKDF2-HMAC-SHA1 request layout: password address/length, salt
// address/length, iterations, output address/length, and max polls (u32).
val esp32Pbkdf2Sha1RequestBytes = 32

trusted fun esp32Pbkdf2Sha1Request32(requestAddress: u32): bool {
    if (requestAddress == u32(0) || requestAddress > u32(4294967264) ||
        (requestAddress & u32(3)) != u32(0)) return false
    val passwordAddress = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress)
    ))
    val passwordLength = ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(4))
    )
    val saltAddress = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(8))
    ))
    val saltLength = ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(12))
    )
    val iterations = ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(16))
    )
    val outputAddress = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(20))
    ))
    val outputLength = ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(24))
    )
    val maximumPolls = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(28))
    ))
    if (passwordLength < 0 || saltLength < 0 || outputLength < 0 ||
        iterations <= 0 || maximumPolls == u32(0) ||
        (passwordLength > 0 && (passwordAddress == u32(0) ||
            int(passwordAddress) > 4294967295 - passwordLength)) ||
        (saltLength > 0 && (saltAddress == u32(0) ||
            int(saltAddress) > 4294967295 - saltLength)) ||
        (outputLength > 0 && (outputAddress == u32(0) ||
            int(outputAddress) > 4294967295 - outputLength))) {
        esp32HmacClear(outputAddress, outputLength)
        return false
    }

    // Outgoing area, U/accumulator, block index, descriptors, HMAC request.
    val workspace = nativeStackAllocate(160)
    val temporary = nativeBufferAt(workspace + 48, 20)
    val accumulator = nativeBufferAt(workspace + 68, 20)
    val countBytes = nativeBufferAt(workspace + 88, 4)
    val descriptors = nativeBufferAt(workspace + 92, 16)
    val hmacRequest = nativeBufferAt(workspace + 108, 32)
    hmacRequest.storeU32(0, esp32Sha1)
    hmacRequest.storeU32(4, int(passwordAddress))
    hmacRequest.storeU32(8, passwordLength)
    hmacRequest.storeU32(12, descriptors.addressValue())
    hmacRequest.storeU32(20, temporary.addressValue())
    hmacRequest.storeU32(24, int(maximumPolls))
    hmacRequest.storeU32(28, 0)
    var produced = 0
    var blockIndex = 1
    var valid = true
    while (valid && produced < outputLength) {
        countBytes.store(0, (blockIndex >>> 24) & 255)
        countBytes.store(1, (blockIndex >>> 16) & 255)
        countBytes.store(2, (blockIndex >>> 8) & 255)
        countBytes.store(3, blockIndex & 255)
        descriptors.storeU32(0, int(saltAddress))
        descriptors.storeU32(4, saltLength)
        descriptors.storeU32(8, countBytes.addressValue())
        descriptors.storeU32(12, 4)
        hmacRequest.storeU32(16, 2)
        valid = esp32HmacShaVectorRequest32(
            u32(hmacRequest.addressValue())
        )
        var byteIndex = 0
        while (byteIndex < 20) {
            accumulator.store(byteIndex, temporary.load(byteIndex))
            byteIndex = byteIndex + 1
        }
        var iteration = 1
        while (valid && iteration < iterations) {
            descriptors.storeU32(0, temporary.addressValue())
            descriptors.storeU32(4, 20)
            hmacRequest.storeU32(16, 1)
            valid = esp32HmacShaVectorRequest32(
                u32(hmacRequest.addressValue())
            )
            byteIndex = 0
            while (byteIndex < 20) {
                accumulator.store(
                    byteIndex,
                    accumulator.load(byteIndex) ^ temporary.load(byteIndex)
                )
                byteIndex = byteIndex + 1
            }
            iteration = iteration + 1
        }
        var copyLength = outputLength - produced
        if (copyLength > 20) copyLength = 20
        byteIndex = 0
        while (valid && byteIndex < copyLength) {
            ablaUnsafeVolatileStoreU8(
                int(outputAddress + u32(produced + byteIndex)),
                accumulator.load(byteIndex)
            )
            byteIndex = byteIndex + 1
        }
        produced = produced + copyLength
        blockIndex = blockIndex + 1
        if (blockIndex == 0 && produced < outputLength) valid = false
    }
    esp32HmacClear(u32(temporary.addressValue()), 40)
    if (!valid) esp32HmacClear(outputAddress, outputLength)
    valid
}
