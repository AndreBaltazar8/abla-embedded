import "../../register.ab"
import "../sdk/buffer.ab"

// Classic ESP32 AES-128 ECB block primitive. The hardware is shared with SHA,
// TLS, Wi-Fi, secure boot, and both cores; callers must serialize the complete
// enable/reset/key/block/read sequence. This layer deliberately adds no hidden
// RTOS lock or foreign ABI.
val esp32AesBase = 1072697344
val esp32AesStartAddress = esp32AesBase
val esp32AesIdleAddress = esp32AesBase + 4
val esp32AesModeAddress = esp32AesBase + 8
val esp32AesKeyAddress = esp32AesBase + 16
val esp32AesTextAddress = esp32AesBase + 48
val esp32DportPeripheralClockEnableAddress = 1072693276
val esp32DportPeripheralResetEnableAddress = 1072693280
val esp32AesPeripheralMask = 1
val esp32SecureBootPeripheralMask = 8
val esp32DigitalSignaturePeripheralMask = 16

@inline
trusted fun esp32AesEnableAndReset(): void {
    register32(esp32DportPeripheralClockEnableAddress).setBits(
        esp32AesPeripheralMask
    )
    val reset = register32(esp32DportPeripheralResetEnableAddress)
    reset.setBits(esp32AesPeripheralMask)
    reset.clearBits(
        esp32AesPeripheralMask | esp32SecureBootPeripheralMask |
            esp32DigitalSignaturePeripheralMask
    )
    return
}

@inline
trusted fun esp32Aes128WriteKey(key: NativeBuffer): bool {
    if (key.capacity() < 16) return false
    register32(esp32AesKeyAddress).write(key.loadU32(0))
    register32(esp32AesKeyAddress + 4).write(key.loadU32(4))
    register32(esp32AesKeyAddress + 8).write(key.loadU32(8))
    register32(esp32AesKeyAddress + 12).write(key.loadU32(12))
    true
}

@inline
trusted fun esp32AesWriteBlock(input: NativeBuffer): bool {
    if (input.capacity() < 16) return false
    register32(esp32AesTextAddress).write(input.loadU32(0))
    register32(esp32AesTextAddress + 4).write(input.loadU32(4))
    register32(esp32AesTextAddress + 8).write(input.loadU32(8))
    register32(esp32AesTextAddress + 12).write(input.loadU32(12))
    true
}

@inline
trusted fun esp32AesReadBlock(output: NativeBuffer): bool {
    if (output.capacity() < 16) return false
    output.storeU32(0, register32(esp32AesTextAddress).read())
    output.storeU32(4, register32(esp32AesTextAddress + 4).read())
    output.storeU32(8, register32(esp32AesTextAddress + 8).read())
    output.storeU32(12, register32(esp32AesTextAddress + 12).read())
    true
}

trusted fun esp32Aes128EncryptBlock(
    key: NativeBuffer,
    input: NativeBuffer,
    output: NativeBuffer,
    maximumPolls: int = 100000
): bool {
    if (maximumPolls <= 0 || key.capacity() < 16 ||
        input.capacity() < 16 || output.capacity() < 16) return false
    esp32Aes128EncryptBlock32(
        u32(key.addressValue()), u32(input.addressValue()),
        u32(output.addressValue()), u32(maximumPolls)
    )
}

@inline
trusted fun esp32Aes128EncryptBlock32(
    keyAddress: u32,
    inputAddress: u32,
    outputAddress: u32,
    maximumPolls: u32
): bool {
    if (keyAddress == u32(0) || inputAddress == u32(0) ||
        outputAddress == u32(0) || maximumPolls == u32(0) ||
        keyAddress > u32(4294967280) ||
        inputAddress > u32(4294967280) ||
        outputAddress > u32(4294967280) ||
        (keyAddress & u32(3)) != u32(0) ||
        (inputAddress & u32(3)) != u32(0) ||
        (outputAddress & u32(3)) != u32(0)) return false
    if (!esp32Aes128Begin32(keyAddress)) return false
    esp32AesEncryptCurrent32(
        inputAddress, outputAddress, maximumPolls
    )
}

// Start a caller-serialized AES-128/192/256 session. Keeping the key loaded
// lets CCM, CCMP, CMAC, and key-wrap code process multiple blocks without
// resetting and rewriting the peripheral for every block.
@inline
trusted fun esp32Aes128Begin32(keyAddress: u32): bool {
    esp32AesBegin32(keyAddress, 16)
}

@inline
trusted fun esp32AesBegin32(keyAddress: u32, keyBytes: int): bool {
    if ((keyBytes != 16 && keyBytes != 24 && keyBytes != 32) ||
        keyAddress == u32(0) ||
        (keyBytes == 16 && keyAddress > u32(4294967280)) ||
        (keyBytes == 24 && keyAddress > u32(4294967272)) ||
        (keyBytes == 32 && keyAddress > u32(4294967264)) ||
        (keyAddress & u32(3)) != u32(0)) return false
    esp32AesEnableAndReset()
    // Match Espressif's aes_hal_setkey ordering: select the key schedule before
    // loading the key words.
    // Encryption modes are zero, one, and two for 128/192/256-bit keys.
    register32(esp32AesModeAddress).write((keyBytes / 8) - 2)
    register32(esp32AesKeyAddress).write(
        ablaUnsafeVolatileLoadU32(int(keyAddress))
    )
    register32(esp32AesKeyAddress + 4).write(
        ablaUnsafeVolatileLoadU32(int(keyAddress + u32(4)))
    )
    register32(esp32AesKeyAddress + 8).write(
        ablaUnsafeVolatileLoadU32(int(keyAddress + u32(8)))
    )
    register32(esp32AesKeyAddress + 12).write(
        ablaUnsafeVolatileLoadU32(int(keyAddress + u32(12)))
    )
    if (keyBytes >= 24) {
        register32(esp32AesKeyAddress + 16).write(
            ablaUnsafeVolatileLoadU32(int(keyAddress + u32(16)))
        )
        register32(esp32AesKeyAddress + 20).write(
            ablaUnsafeVolatileLoadU32(int(keyAddress + u32(20)))
        )
    }
    if (keyBytes == 32) {
        register32(esp32AesKeyAddress + 24).write(
            ablaUnsafeVolatileLoadU32(int(keyAddress + u32(24)))
        )
        register32(esp32AesKeyAddress + 28).write(
            ablaUnsafeVolatileLoadU32(int(keyAddress + u32(28)))
        )
    }
    true
}

@inline
trusted fun esp32AesEncryptCurrent32(
    inputAddress: u32,
    outputAddress: u32,
    maximumPolls: u32
): bool {
    if (inputAddress == u32(0) || outputAddress == u32(0) ||
        maximumPolls == u32(0) || inputAddress > u32(4294967280) ||
        outputAddress > u32(4294967280) ||
        (inputAddress & u32(3)) != u32(0) ||
        (outputAddress & u32(3)) != u32(0)) return false
    register32(esp32AesTextAddress).write(
        ablaUnsafeVolatileLoadU32(int(inputAddress))
    )
    register32(esp32AesTextAddress + 4).write(
        ablaUnsafeVolatileLoadU32(int(inputAddress + u32(4)))
    )
    register32(esp32AesTextAddress + 8).write(
        ablaUnsafeVolatileLoadU32(int(inputAddress + u32(8)))
    )
    register32(esp32AesTextAddress + 12).write(
        ablaUnsafeVolatileLoadU32(int(inputAddress + u32(12)))
    )
    register32(esp32AesStartAddress).write(1)
    var polls = u32(0)
    var idle = register32(esp32AesIdleAddress).read()
    while (idle == 0 && polls < maximumPolls) {
        polls = polls + u32(1)
        idle = register32(esp32AesIdleAddress).read()
    }
    if (idle == 0) return false
    ablaUnsafeVolatileStoreU32(
        int(outputAddress), register32(esp32AesTextAddress).read()
    )
    ablaUnsafeVolatileStoreU32(
        int(outputAddress + u32(4)),
        register32(esp32AesTextAddress + 4).read()
    )
    ablaUnsafeVolatileStoreU32(
        int(outputAddress + u32(8)),
        register32(esp32AesTextAddress + 8).read()
    )
    ablaUnsafeVolatileStoreU32(
        int(outputAddress + u32(12)),
        register32(esp32AesTextAddress + 12).read()
    )
    true
}
