import "../../register.ab"
import "../dport_esp32.ab"
import "sha_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

// Typed classic-ESP32 SHA HAL. The peripheral registers are volatile, but the
// block swap, state sizing, loops, and fault check are ordinary Abla.
@inline
trusted fun esp32ShaHalLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32ShaHalStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
fun esp32ShaHalStateWords(shaType: u32): u32 =
    if (shaType == u32(0)) u32(5)
    else if (shaType == u32(1)) u32(8)
    else if (shaType == u32(2) || shaType == u32(3)) u32(16)
    else u32(0)

fun esp32ShaHalSetMode(shaType: u32): void { return }

trusted fun esp32ShaHalHashBlock(
    shaType: u32,
    dataAddress: u32,
    blockWordLength: u32,
    firstBlock: u32
): void {
    var word = u32(0)
    while (word < blockWordLength) {
        register32(esp32ShaTextAddress + int(word << u32(2))).write(int(
            esp32ShaSwapU32(
                esp32ShaHalLoadU32(dataAddress + (word << u32(2)))
            )
        ))
        word = word + u32(1)
    }
    val control = if (firstBlock != u32(0))
        esp32Sha1StartAddress + int(shaType << u32(4))
    else esp32Sha1ContinueAddress + int(shaType << u32(4))
    register32(control).write(1)
}

trusted fun esp32ShaHalWaitIdle(): void {
    while (esp32DportReadShared(
        u32(esp32Sha1BusyAddress)
    ) != u32(0) || esp32DportReadShared(
        u32(esp32Sha256BusyAddress)
    ) != u32(0) || esp32DportReadShared(
        u32(esp32Sha384BusyAddress)
    ) != u32(0) || esp32DportReadShared(
        u32(esp32Sha512BusyAddress)
    ) != u32(0)) { }
}

trusted fun esp32ShaHalReadDigest(
    shaType: u32,
    outputAddress: u32
): void {
    register32(
        esp32Sha1LoadAddress + int(shaType << u32(4))
    ).write(1)
    esp32ShaHalWaitIdle()
    val words = esp32ShaHalStateWords(shaType)
    var word = u32(0)
    var nonzero = false
    while (word < words) {
        // Classic ESP32 exposes each 64-bit SHA384/512 state word high first;
        // the little-endian software context stores its low word first.
        val sourceWord = if (shaType == u32(2) || shaType == u32(3))
            word ^ u32(1) else word
        val value = esp32DportReadShared(
            u32(esp32ShaTextAddress) + (sourceWord << u32(2))
        )
        esp32ShaHalStoreU32(
            outputAddress + (word << u32(2)), value
        )
        nonzero = nonzero || value != u32(0)
        word = word + u32(1)
    }
    if (!nonzero) ablaRuntimeTrap()
}
