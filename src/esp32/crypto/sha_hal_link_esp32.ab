import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkShaHalOpaqueCallers(): bool {
    if (!exportFunction("esp32ShaHalSetMode", "sha_hal_set_mode")) return false
    if (!exportFunction("esp32ShaHalHashBlock", "sha_hal_hash_block")) return false
    if (!exportFunction("esp32ShaHalWaitIdle", "sha_hal_wait_idle")) return false
    if (!exportFunction("esp32ShaHalReadDigest", "sha_hal_read_digest")) return false
    true
}
