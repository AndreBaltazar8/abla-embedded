import "./aes_esp32.ab"

// In-place AES-128-CBC request: key address, IV address, data address,
// byte length, decrypt flag, and max polls (six u32 fields). Like hostap's
// established API, only complete 16-byte blocks are transformed; a trailing
// partial block is left untouched.
val esp32Aes128CbcRequestBytes = 24

trusted fun esp32Aes128CbcRequest32(requestAddress: u32): bool {
    if (requestAddress == u32(0) || requestAddress > u32(4294967272) ||
        (requestAddress & u32(3)) != u32(0)) return false
    val keyAddress = u32(ablaUnsafeVolatileLoadU32(int(requestAddress)))
    val ivAddress = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(4))
    ))
    val dataAddress = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(8))
    ))
    val dataLength = ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(12))
    )
    val decrypt = ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(16))
    ) != 0
    val maximumPolls = u32(ablaUnsafeVolatileLoadU32(
        int(requestAddress + u32(20))
    ))
    if (keyAddress == u32(0) || keyAddress > u32(4294967280) ||
        ivAddress == u32(0) || ivAddress > u32(4294967280) ||
        dataLength < 0 || maximumPolls == u32(0) ||
        (dataLength > 0 && (dataAddress == u32(0) ||
            int(dataAddress) > 4294967295 - dataLength))) return false

    val workspace = nativeStackAllocate(112)
    val key = nativeBufferAt(workspace + 48, 16)
    val chain = nativeBufferAt(workspace + 64, 16)
    val input = nativeBufferAt(workspace + 80, 16)
    val output = nativeBufferAt(workspace + 96, 16)
    var index = 0
    while (index < 16) {
        key.store(index, ablaUnsafeVolatileLoadU8(
            int(keyAddress + u32(index))
        ))
        chain.store(index, ablaUnsafeVolatileLoadU8(
            int(ivAddress + u32(index))
        ))
        index = index + 1
    }
    var valid = if (decrypt)
        esp32AesDecryptBegin32(u32(key.addressValue()), 16)
    else esp32AesBegin32(u32(key.addressValue()), 16)
    var offset = 0
    while (valid && offset <= dataLength - 16) {
        index = 0
        while (index < 16) {
            val value = ablaUnsafeVolatileLoadU8(
                int(dataAddress + u32(offset + index))
            )
            input.store(index, if (decrypt) value else value ^ chain.load(index))
            index = index + 1
        }
        valid = if (decrypt) esp32AesDecryptCurrent32(
            u32(input.addressValue()), u32(output.addressValue()), maximumPolls
        ) else esp32AesEncryptCurrent32(
            u32(input.addressValue()), u32(output.addressValue()), maximumPolls
        )
        index = 0
        while (valid && index < 16) {
            val value = if (decrypt)
                output.load(index) ^ chain.load(index)
            else output.load(index)
            ablaUnsafeVolatileStoreU8(
                int(dataAddress + u32(offset + index)), value
            )
            chain.store(index, if (decrypt) input.load(index) else value)
            index = index + 1
        }
        offset = offset + 16
    }
    var clearIndex = 0
    while (clearIndex < 64) {
        ablaUnsafeVolatileStoreU8(workspace + 48 + clearIndex, 0)
        clearIndex = clearIndex + 1
    }
    valid
}
