import "./ahb_gdma_rearm_p4_sequence.ab"
import "./ahb_gdma_ring_esp32p4.ab"
import "./cache_writeback_esp32p4.ab"
import "../riscv/memory.ab"
import "../hal/esp32.ab"
import "./sdk/raw_buffer.ab"
import "./cache_writeback_p4_sequence.ab"
import "./sdk/nativebuffer_type.ab"
@export("p4AhbRearmLoad")
trusted fun p4AhbRearmLoadHook(address: int): int = nativeAddressLoadU32(address,0)
@export("p4AhbRearmStore")
trusted fun p4AhbRearmStoreHook(address: int,value: int): void { nativeAddressStoreU32(address,0,value);return }
@export("p4AhbRearmFence")
trusted fun p4AhbRearmFenceHook(): void = riscvDeviceMemoryFence()
@export("p4AhbRearmFlush")
trusted fun p4AhbRearmFlushHook(buffer: NativeBuffer,bytes: int,polls: int): int = esp32P4CacheWritebackInvalidateOwned(buffer,bytes,64,polls)
