import "./ahb_gdma_rearm_p4_sequence.ab"
import "./ahb_gdma_ring_esp32p4.ab"
import "./cache_writeback_esp32p4.ab"
import "../riscv/memory.ab"
trusted fun p4AhbRearmLoad(address: int): int = nativeAddressLoadU32(address,0)
trusted fun p4AhbRearmStore(address: int,value: int): void { nativeAddressStoreU32(address,0,value);return }
trusted fun p4AhbRearmFence(): void = riscvDeviceMemoryFence()
trusted fun p4AhbRearmFlush(buffer: NativeBuffer,bytes: int,polls: int): int = esp32P4CacheWritebackInvalidateOwned(buffer,bytes,64,polls)
