// ESP-IDF S3 Xtensa core-isa.h. Do not use classic ESP32's timer/NMI map.
fun esp32S3InterruptLevel(line: int): int {
    if (line < 0 || line > 31) return -1
    val bit=1<<line
    if ((bit & 0x000637FF) != 0) return 1
    if ((bit & 0x00380000) != 0) return 2
    if ((bit & 0x28C08800) != 0) return 3
    if ((bit & 0x53000000) != 0) return 4
    if ((bit & 0x84010000) != 0) return 5
    7
}
@inline
fun esp32S3InterruptExternalLevel(line: int): bool =
    line >= 0 && line < 32 && ((0x8FBE333F>>>line) & 1) != 0
// Ordinary native dispatcher supports levels1..3, not naked high-level ISR.
fun esp32S3InterruptSupportsNativeHandler(line: int): bool {
    val level=esp32S3InterruptLevel(line)
    level >= 1 && level <= 3
}
