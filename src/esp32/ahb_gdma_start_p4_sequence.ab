// Starts an already built/cache-published SRAM ring. All cache lines remain
// inaccessible to CPU until explicit invalidate/acquire; caller owns channel,
// clock/PMS settings, peripheral and global memory-window configuration.
// Windows are inspected, NEVER widened here (shared by all channels).
// This polling path requires interrupts disabled and no pending events; events
// are preserved, not silently cleared. Owner checking/trigger prepared earlier.
// 1 START issued,2 invalid/unowned,3 busy/reset,4 trigger/owner mismatch,
// 5 IRQ enabled/pending event,6 memory window,7 mode readback,8 link readback.
// START is WT: success is command issued, NOT proof of active/completed DMA.
trusted fun esp32p4AhbGdmaStartRingOwned(channel: int,transmit: bool,port: int,
    descriptors: int,count: int,buffers: int,stride: int,bytes: int,exclusive: bool): int {
    val base=esp32p4AhbGdmaChannelBase(channel,transmit)
    if (!exclusive || base == 0 || port < 0 || port > 2 ||
        !esp32p4AhbGdmaRingLayoutValid(descriptors,count,buffers,stride,bytes)) return 2
    val link=base+16
    val state=p4AhbGdmaRead(link)
    if ((state & (if (transmit) 15 else 30)) != (if (transmit) 8 else 16) ||
        (p4AhbGdmaRead(base)&1) != 0) return 3
    if ((p4AhbGdmaRead(base+4)&4096) == 0 || (p4AhbGdmaRead(base+48)&63) != 3+port) return 4
    val events=0x50085000+channel*16+(if (transmit) 48 else 0)
    if (p4AhbGdmaRead(events) != 0 || p4AhbGdmaRead(events+8) != 0) return 5
    val low=p4AhbGdmaRead(0x500853c4)
    val high=p4AhbGdmaRead(0x500853c8)
    if (low > descriptors || low > buffers || high < descriptors+count*64 || high < buffers+count*stride) return 6
    // Single data/descriptor transfers avoid revision-dependent burst controls.
    // TX needs descriptor writeback and EOF-after-FIFO-pop for ownership pumps.
    if (!p4AhbGdmaField(base,if (transmit) 124 else 60,if (transmit) 12 else 0)) return 7
    val descriptorRegister=0x500853ac+channel*4+(if (transmit) 12 else 0)
    p4AhbGdmaWrite(descriptorRegister,descriptors)
    if (p4AhbGdmaRead(descriptorRegister) != descriptors) return 8
    p4AhbStartFence()
    p4AhbGdmaWrite(link,(p4AhbGdmaRead(link)&(if (transmit) 0xfffffff8 else 0xfffffff1))|(if (transmit) 2 else 4))
    return 1
}
