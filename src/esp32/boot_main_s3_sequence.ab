// Application supplies esp32S3BootApplication() as an ordinary Abla function,
// not another exported/native callback. No application globals may be used
// before memory initialization. Failure returns to the entry shim's halt tail.
@export("abla_boot_main")
@section(".iram1.abla.s3BootMain")
trusted fun esp32S3BootMain(): void {
    if (esp32S3BootMemoryPrepare()) esp32S3BootApplication()
    return
}
