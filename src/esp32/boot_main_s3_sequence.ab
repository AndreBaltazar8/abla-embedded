// Application supplies esp32S3BootApplication() as a hook (src/hal/application.ab):
// @export("esp32S3BootApplication") on an Abla function. No application globals may be used
// before memory initialization. Failure returns to the entry shim's halt tail.
import "../hal/esp32.ab"
import "../hal/application.ab"
@export("abla_boot_main")
@section(".iram1.abla.s3BootMain")
trusted fun esp32S3BootMain(): void {
    if (esp32S3BootMemoryPrepare()) esp32S3BootApplication()
    return
}
