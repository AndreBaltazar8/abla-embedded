import "../register.ab"
import "./interrupt_matrix_esp32_logic.ab"

// Classic ESP32 exposes one DPORT routing register per peripheral source and
// CPU. This is the same operation as ROM intr_matrix_set, expressed as MMIO.
trusted fun Esp32InterruptSource.routeTo(
    cpu: Esp32Cpu,
    interrupt: XtensaInterrupt
): bool {
    if (!this.valid() || !cpu.valid() || !interrupt.valid()) return false
    val address = esp32InterruptMapAddress(cpu, this)
    register32(address).update(
        esp32InterruptMapMask,
        int(interrupt.number()) & esp32InterruptMapMask
    )
    true
}

trusted fun Esp32InterruptSource.unrouteFrom(cpu: Esp32Cpu): bool {
    if (!this.valid() || !cpu.valid()) return false
    register32(esp32InterruptMapAddress(cpu, this)).update(
        esp32InterruptMapMask,
        esp32InvalidCpuInterrupt
    )
    true
}

trusted fun Esp32InterruptSource.routeOn(cpu: Esp32Cpu): XtensaInterrupt {
    if (!this.valid() || !cpu.valid()) return XtensaInterrupt(i32(-1))
    XtensaInterrupt(i32(
        register32(esp32InterruptMapAddress(cpu, this)).read() &
            esp32InterruptMapMask
    ))
}
