import "./clock_state_s3.ab"

// Low-level transition only. Caller has quiesced both cores/interrupts, UARTs,
// radio and analog-bus users, synchronized MSPI for XTAL, and arranged IRAM/
// internal-DRAM execution. rtcBias/digitalBias are calibrated non-240MHz values
// from initialization, NOT guessed voltage settings. Frequency consumers must
// be rebased by the clock owner. The returned pre-transition state is for resume.
@section(".iram1.abla.s3ClockToXtal")
trusted fun esp32S3ClockToXtalOwned(rtcBias: int,digitalBias: int,disablePll: bool): Esp32S3ClockState {
    if (rtcBias < 0 || rtcBias > 31 || digitalBias < 0 || digitalBias > 31) return Esp32S3ClockState(0)
    val sysclk=esp32S3ClockRead(0x600C0060)
    val peripheral=esp32S3ClockRead(0x600C0010)
    val stored=esp32S3ClockRead(0x600080C0)
    val xtal=esp32S3StoredXtalMegahertz(stored)
    val before=esp32S3ClockDecode(sysclk,peripheral,stored)
    if (!before.valid() || xtal == 0) return Esp32S3ClockState(0)
    val leaving240=before.source() == 1 && (peripheral & 3) == 2
    esp32S3ClockRomTicks(xtal)
    // IDF mandates pre-divider reset before selecting XTAL. Target divider1.
    esp32S3ClockUpdate(0x600C0060,1023,0)
    esp32S3ClockUpdate(0x600C0060,1023,0)
    esp32S3ClockUpdate(0x600C0060,3072,0)
    if (leaving240) {
        esp32S3ClockBiasWrite(4,rtcBias)
        esp32S3ClockBiasWrite(6,digitalBias)
        esp32S3ClockRomDelay(40)
    }
    esp32S3ClockUpdate(0x600081FC,0x7E000,0xE000)
    if (disablePll) esp32S3ClockUpdate(0x60008000,0x540,0x540)
    before
}
