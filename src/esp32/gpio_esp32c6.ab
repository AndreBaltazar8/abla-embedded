import "./gpio_pin_c6_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("c6GpioRead")
trusted fun c6GpioReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("c6GpioWrite")
trusted fun c6GpioWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
