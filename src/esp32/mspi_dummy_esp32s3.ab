import "./mspi_dummy_s3_sequence.ab"
import "./mspi_rom_dummy_s3_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.s3RomDummyReadByte")
trusted fun esp32S3RomDummyReadByte(address: int): int = mmioLoadU8(address)
@section(".iram1.abla.s3RomDummyWriteByte")
trusted fun esp32S3RomDummyWriteByte(address: int,value: int): void {
    mmioStoreU8(address,value)
    return
}
@section(".iram1.abla.s3DummyRead")
trusted fun esp32S3MspiDummyRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3DummyUpdate")
trusted fun esp32S3MspiDummyUpdate(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
