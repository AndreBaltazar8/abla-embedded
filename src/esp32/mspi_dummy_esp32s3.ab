import "./mspi_dummy_s3_sequence.ab"
import "./mspi_rom_dummy_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@section(".iram1.abla.s3RomDummyReadByte")
@export("esp32S3RomDummyReadByte")
trusted fun esp32S3RomDummyReadByteHook(address: int): int = mmioLoadU8(address)
@section(".iram1.abla.s3RomDummyWriteByte")
@export("esp32S3RomDummyWriteByte")
trusted fun esp32S3RomDummyWriteByteHook(address: int,value: int): void {
    mmioStoreU8(address,value)
    return
}
@section(".iram1.abla.s3DummyRead")
@export("esp32S3MspiDummyRead")
trusted fun esp32S3MspiDummyReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3DummyUpdate")
@export("esp32S3MspiDummyUpdate")
trusted fun esp32S3MspiDummyUpdateHook(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
