import "./adc_trim_c5_sequence.ab"
// C5 IDF6 defaults: controller divider15+B1/A0, SAR1 divider1 in
// PCR148[15:8] (NOT ADC CTRL), analog sample-cycle2. Source unchanged.
// Requires exclusive stopped ADC/analog buses, powered/trimmed ADC and pads.
// Snapshot: PCRdivider20@8,SAR1divider8@28,onetime6@36,sample3@42,valid45.
// status0closed1ready2invalid3power4busy5sample-read6write/readback.
type C5AdcController=int
fun C5AdcController.status(): int = this&255
fun C5AdcController.ready(): bool = this.status() == 1
trusted fun c5AdcConfigField(mask: u32,value: u32): bool {
    c5AdcWrite(0x20,(c5AdcRead(0x20)&~mask)|value)
    return (c5AdcRead(0x20)&mask) == value
}
trusted fun c5AdcControllerOpenOwned(channel: int,attenuation: int,exclusiveStopped: bool): C5AdcController {
    if (!exclusiveStopped || channel < 0 || channel > 5 || attenuation < 0 || attenuation > 3) return C5AdcController(2)
    if (!c5AdcTrimPowered()) return C5AdcController(3)
    if (!c5AdcAllStopped()) return C5AdcController(4)
    val sample=c5AdcTrimField(2,0,2,-1)
    if (sample < 0 || sample > 7) return C5AdcController(5)
    val snapshot=(1<<45)|(int(c5AdcClockRead(4)&u32(0xfffff))<<8)|
        (int((c5AdcClockRead(0xc0)>>u32(8))&u32(255))<<28)|
        (int((c5AdcRead(0x20)>>u32(23))&u32(63))<<36)|(sample<<42)
    if (!c5AdcClockField(4,u32(0xfffff),u32(0xf040)) ||
        !c5AdcClockField(0xc0,u32(0xff00),u32(0x100)) ||
        !c5AdcTrimSet(2,0,2,2) ||
        !c5AdcConfigField(u32(0x1f800000),u32(attenuation|(channel<<2))<<u32(23))) return C5AdcController(snapshot|6)
    return C5AdcController(snapshot|1)
}
trusted fun C5AdcController.closeOwned(exclusiveStopped: bool): C5AdcController {
    if (!exclusiveStopped || this < 0 || (this&~0x3fffffffffff) != 0 || this.status() > 6 || (this&(1<<45)) == 0) return this
    val snapshot=this&~255
    if (!c5AdcTrimPowered()) return C5AdcController(snapshot|3)
    if (!c5AdcAllStopped()) return C5AdcController(snapshot|4)
    if (!c5AdcConfigField(u32(0x1f800000),u32((snapshot>>>36)&63)<<u32(23)) ||
        !c5AdcTrimSet(2,0,2,(snapshot>>>42)&7) ||
        !c5AdcClockField(0xc0,u32(0xff00),u32((snapshot>>>28)&255)<<u32(8)) ||
        !c5AdcClockField(4,u32(0xfffff),u32(snapshot>>>8)&u32(0xfffff))) return C5AdcController(snapshot|6)
    return C5AdcController(0)
}
// Conservative IDF pulse delay for the default divider. Source Hz must be
// measured/known and pinned by caller; do not infer RC_FAST from its name.
// Keep delay even at high clocks; C5 post-DONE extra delay is zero per LL.
fun c5AdcDefaultPulseMicros(sourceHz: int): int {
    if (sourceHz < 16 || sourceHz > 80000000) return -1
    return int((u32(1000000)/(u32(sourceHz)/u32(16))+u32(1))*u32(3))
}
