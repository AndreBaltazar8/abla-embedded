import "./dw_gdma_controller_p4_sequence.ab"
import "./dw_gdma_dsi_esp32p4.ab"
trusted fun p4DwClockRead(offset: int): u32 = u32(mmioLoadU32(0x500e6000+offset))
trusted fun p4DwClockWrite(offset: int,value: u32): void { mmioStoreU32(0x500e6000+offset,int(value)); return }
trusted fun esp32P4DwDmaControllerOpen(polls: int): Esp32P4DwDmaController = esp32P4DwDmaControllerOpenOwned(polls)
