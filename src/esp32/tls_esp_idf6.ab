import "abla/unsafe/memory"
import "./sdk/buffer.ab"
import "./tls/esp_tls_core_esp32.ab"
import "../network/lwip/sockets_esp32.ab"
import "./clock.ab"
import "./task.ab"

@inline
trusted fun esp32TlsPointerWord(value: i64*): u32 =
    u32(nativePointerAddress(value))

trusted noescape fun esp_tls_init(): i64* =
    nativePointerFromAddress(int(esp32RecoveredEspTlsInit(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )))

trusted noescape fun esp_tls_conn_new_sync(
    host: string,
    hostLength: i32,
    port: i32,
    config: i64*,
    tls: i64*
): i32 = i32(esp32RecoveredEspTlsConnNewSync(
    u32(nativeCStringAddress(host)), u32(hostLength), u32(port),
    esp32TlsPointerWord(config), esp32TlsPointerWord(tls),
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0)
))

trusted noescape fun esp_tls_conn_write(
    tls: i64*, data: i64*, length: u32
): i32 = i32(esp32RecoveredEspTlsConnWrite(
    esp32TlsPointerWord(tls), esp32TlsPointerWord(data), length,
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0)
))

trusted noescape fun esp_tls_conn_read(
    tls: i64*, data: i64*, length: u32
): i32 = i32(esp32RecoveredEspTlsConnRead(
    esp32TlsPointerWord(tls), esp32TlsPointerWord(data), length,
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0)
))

trusted noescape fun esp_tls_get_bytes_avail(tls: i64*): i32 =
    i32(esp32RecoveredEspTlsGetBytesAvail(
        esp32TlsPointerWord(tls),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    ))

trusted noescape fun esp_tls_get_conn_sockfd(
    tls: i64*, descriptor: i64*
): i32 = i32(esp32RecoveredEspTlsGetConnSockfd(
    esp32TlsPointerWord(tls), esp32TlsPointerWord(descriptor),
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0)
))

trusted noescape fun esp_tls_conn_destroy(tls: i64*): i32 =
    i32(esp32RecoveredEspTlsConnDestroy(
        esp32TlsPointerWord(tls),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    ))

trusted noescape fun lwip_setsockopt(
    descriptor: i32,
    level: i32,
    option: i32,
    value: i64*,
    length: u32
): i32 = i32(esp32RecoveredLwipSetsockopt(
    u32(descriptor), u32(level), u32(option),
    esp32TlsPointerWord(value), length,
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0)
))

trusted noescape fun lwip_poll(
    descriptors: i64*, count: u32, timeoutMilliseconds: i32
): i32 = i32(esp32RecoveredLwipPoll(
    esp32TlsPointerWord(descriptors), count, u32(timeoutMilliseconds),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0)
))

// This is application-owned state, not an ESP-TLS or C++ object:
//   0  esp_tls_t pointer
//   4  retained CA certificate pointer
//   8  retained CA certificate byte count
//  12  connected flag
//  16  socket descriptor
type TlsClient = int
val tlsClientStorageBytes = 20
val espTlsClientConfigBytes = 96

trusted fun tlsClientAt(address: int): TlsClient {
    nativeAddressClear(address, tlsClientStorageBytes)
    nativeAddressStoreU32(address, 16, -1)
    TlsClient(address)
}

trusted fun tlsClient(): TlsClient =
    tlsClientAt(nativeStaticAllocate(20))

trusted fun TlsClient.pointer(): i64* =
    nativePointerFromAddress(nativeAddressLoadU32(this, 0))

trusted fun TlsClient.setCertificate(certificate: string): void {
    if (this != 0) {
        nativeAddressStoreU32(this, 4, nativeCStringAddress(certificate))
        nativeAddressStoreU32(this, 8, certificate.size + 1)
    }
    return
}

trusted fun TlsClient.connected(): bool =
    this != 0 && nativeAddressLoadU32(this, 12) != 0

trusted fun TlsClient.markDisconnected(): void {
    if (this != 0) nativeAddressStoreU32(this, 12, 0)
    return
}

trusted fun TlsClient.connect(host: string, port: int): bool {
    if (this == 0) return false
    this.stop()
    val tls = esp_tls_init()
    if (pointerIsNull(tls)) return false

    nativeAddressStoreU32(this, 0, nativePointerAddress(tls))
    val config = nativeStackAllocate(espTlsClientConfigBytes)
    nativeAddressClear(config, espTlsClientConfigBytes)
    nativeAddressStoreU32(config, 4, nativeAddressLoadU32(this, 4))
    nativeAddressStoreU32(config, 8, nativeAddressLoadU32(this, 8))

    if (esp_tls_conn_new_sync(
        host, host.size, port, nativePointerFromAddress(config), tls
    ) != 1) {
        esp_tls_conn_destroy(tls)
        nativeAddressStoreU32(this, 0, 0)
        return false
    }

    val descriptor = nativeStackAllocate(4)
    nativeAddressStoreU32(descriptor, 0, -1)
    if (esp_tls_get_conn_sockfd(
        tls, nativePointerFromAddress(descriptor)
    ) != 0) {
        esp_tls_conn_destroy(tls)
        nativeAddressStoreU32(this, 0, 0)
        return false
    }
    // Synchronous connection setup restores blocking sockets. After the TLS
    // handshake, reads/writes must yield WANT_READ/WANT_WRITE so the facade's
    // deadlines and the application's event loop can actually run.
    if (esp32TlsSetSocketNonblocking(u32(nativeAddressLoadU32(descriptor, 0)),true) != u32(0)) {
        esp_tls_conn_destroy(tls)
        nativeAddressStoreU32(this, 0, 0)
        return false
    }
    nativeAddressStoreU32(this, 16, nativeAddressLoadU32(descriptor, 0))
    nativeAddressStoreU32(this, 12, 1)
    true
}

trusted fun TlsClient.available(): int {
    if (!this.connected()) return 0
    val decrypted = esp_tls_get_bytes_avail(this.pointer())
    if (decrypted > 0) return decrypted

    // pollfd is { int fd; short events; short revents }. A readable TLS
    // record is reported as at least one protocol header so callers enter
    // esp_tls_conn_read(), which performs decryption and reports closure.
    val descriptor = nativeStackAllocate(8)
    nativeAddressClear(descriptor, 8)
    nativeAddressStoreU32(descriptor, 0, nativeAddressLoadU32(this, 16))
    nativeAddressStoreU16(descriptor, 4, 1)
    if (lwip_poll(nativePointerFromAddress(descriptor), u32(1), 0) <= 0) return 0
    val events = nativeAddressLoadU16(descriptor, 6)
    if ((events & 56) != 0) {
        this.markDisconnected()
        return 0
    }
    if ((events & 1) != 0) 9 else 0
}

trusted fun TlsClient.noDelay(enabled: bool): bool {
    if (!this.connected()) return false
    val value = nativeStackAllocate(4)
    nativeAddressStoreU32(value, 0, if (enabled) 1 else 0)
    lwip_setsockopt(
        nativeAddressLoadU32(this, 16), 6, 1,
        nativePointerFromAddress(value), u32(4)
    ) == 0
}

trusted fun TlsClient.write(buffer: NativeBuffer, length: int): int =
    this.writeSlice(buffer, 0, length)

// One nonblocking attempt. Zero means retry the IDENTICAL span later; the
// caller must retain its bytes until a positive result or connection teardown.
// A negative result is terminal. This never sleeps or retries internally.
trusted fun TlsClient.tryWriteSlice(
    buffer: NativeBuffer, offset: int, length: int
): int {
    if (!this.connected() || !buffer.hasAddressRange(offset, length)) return -1
    if (length == 0) return 0
    val result = esp_tls_conn_write(this.pointer(), buffer.pointerAt(offset), length)
    if (u32(result) == esp32TlsWantRead || u32(result) == esp32TlsWantWrite) return 0
    if (result <= 0 || result > length) {
        this.markDisconnected()
        return -1
    }
    result
}

trusted fun TlsClient.writeSlice(
    buffer: NativeBuffer,
    offset: int,
    length: int
): int {
    if (!this.connected() || offset < 0 || length < 0 ||
        offset > buffer.capacity() - length) return 0
    if (length == 0) return 0
    val tls = this.pointer()
    val data = buffer.pointerAt(offset)
    val started = u32(esp_timer_get_time() / 1000)
    var result = esp_tls_conn_write(tls, data, length)
    var retry = result == 0 ||
        u32(result) == esp32TlsWantRead ||
        u32(result) == esp32TlsWantWrite
    while (retry && u32(esp_timer_get_time() / 1000) - started <= u32(30000)) {
        // Match WiFiClientSecure's bounded retry: a nonblocking socket can
        // temporarily exhaust its TCP send window without losing the TLS
        // connection or consuming any of the caller's buffer.
        vTaskDelay(u32(2))
        result = esp_tls_conn_write(tls, data, length)
        retry = result == 0 ||
            u32(result) == esp32TlsWantRead ||
            u32(result) == esp32TlsWantWrite
    }
    if (result < 0 || retry) this.markDisconnected()
    result
}

trusted fun TlsClient.read(buffer: NativeBuffer, length: int): int =
    this.readSlice(buffer, 0, length)

trusted fun TlsClient.readSlice(
    buffer: NativeBuffer,
    offset: int,
    length: int
): int {
    if (!this.connected() || offset < 0 || length < 0 ||
        offset > buffer.capacity() - length) return 0
    if (length == 0) return 0
    val result = esp_tls_conn_read(
        this.pointer(), buffer.pointerAt(offset), length
    )
    // poll() reports encrypted socket bytes, which can be only part of a TLS
    // record. mbedTLS then legitimately asks for more input (or output for a
    // protocol response); neither condition closes the connection or consumes
    // the caller's requested plaintext span.
    if (u32(result) == esp32TlsWantRead ||
        u32(result) == esp32TlsWantWrite) return 0
    if (result <= 0) this.markDisconnected()
    result
}

trusted fun TlsClient.stop(): void {
    if (this != 0) {
        val tls = this.pointer()
        this.markDisconnected()
        nativeAddressStoreU32(this, 16, -1)
        nativeAddressStoreU32(this, 0, 0)
        if (!pointerIsNull(tls)) esp_tls_conn_destroy(tls)
    }
    return
}

trusted fun TlsClient.destroy(): void = this.stop()
