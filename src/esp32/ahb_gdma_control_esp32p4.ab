import "./ahb_gdma_control_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("p4AhbGdmaRead")
trusted fun p4AhbGdmaReadHook(address: int): int = mmioLoadU32(address)
@export("p4AhbGdmaWrite")
trusted fun p4AhbGdmaWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
