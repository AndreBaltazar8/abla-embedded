// ESP-IDF v6.0.2: esp32s3 rtc_io_periph.c, rtc_io_ll.h and
// sleep_modes.c ext0_wakeup_prepare. S3 RTCIO numbers equal GPIO0..21.
fun esp32S3RtcPadAddress(pin: int): int =
    if (pin >= 0 && pin <= 21) 0x60008484 + pin * 4 else 0

fun esp32S3RtcWakeMaskValid(pins: int): bool = pins > 0 && (pins & ~0x3FFFFF) == 0

// S3 supports ANY low or ANY high, not classic ESP32's ALL low.
// Same ownership preconditions as EXT0. holdPads is required when RTC_PERIPH
// will be powered down. Release only these owned holds after waking; this
// does not restore the previous mux or authorize changing shared pins.
trusted fun esp32S3PrepareExt1Owned(pins: int, level: int, holdPads: bool): bool {
    if (!esp32S3RtcWakeMaskValid(pins) || level < 0 || level > 1) return false
    if ((pins & 0x180000) != 0 &&
        (esp32S3RtcWakeRead(0x60038018) & 16384) != 0) return false
    esp32S3RtcWakeUpdate(0x60008904, 0x80000000, 0x80000000)
    var pin=0
    while (pin < 22) {
        if ((pins & (1 << pin)) != 0) {
            esp32S3RtcWakeUpdate(esp32S3RtcPadAddress(pin), 0xE2000, 0x82000)
            if (holdPads) esp32S3RtcWakeUpdate(0x600080D8, 1 << pin, 1 << pin)
        }
        pin=pin+1
    }
    esp32S3RtcWakeUpdate(0x600080E0, 0x400000, 0x400000)
    esp32S3RtcWakeUpdate(0x600080E0, 0x3FFFFF, pins)
    esp32S3RtcWakeUpdate(0x60008064, 0x80000000, level << 31)
    true
}

trusted fun esp32S3ReleaseRtcHoldsOwned(pins: int): bool {
    if (!esp32S3RtcWakeMaskValid(pins)) return false
    esp32S3RtcWakeUpdate(0x600080D8, pins, 0)
    true
}

// Raw latched status; meaningful as a wake cause only after the caller has
// established that EXT1 woke the chip. Reading does not clear the latch.
trusted fun esp32S3Ext1LatchedPins(): int = esp32S3RtcWakeRead(0x600080E4) & 0x3FFFFF

// Only prepares EXT0's input/selector, NOT the sleep trigger or sleep entry.
// Caller serializes RTC configuration and owns the pad; release pad holds,
// output drivers and analog/32-kHz/USB-OTG ownership beforehand. Pulls remain
// caller-controlled. Refuse to disconnect active USB Serial/JTAG implicitly.
trusted fun esp32S3PrepareExt0Owned(pin: int, level: int): bool {
    val pad = esp32S3RtcPadAddress(pin)
    if (pad == 0 || level < 0 || level > 1) return false
    if ((pin == 19 || pin == 20) &&
        (esp32S3RtcWakeRead(0x60038018) & 16384) != 0) return false
    esp32S3RtcWakeUpdate(0x60008904, 0x80000000, 0x80000000)
    esp32S3RtcWakeUpdate(0x600084DC, 0xF8000000, pin << 27)
    esp32S3RtcWakeUpdate(0x60008064, 0x40000000, level << 30)
    // MUX_SEL=RTC, FUN_SEL=0, FUN_IE=1; preserve drive/pull/sleep fields.
    esp32S3RtcWakeUpdate(pad, 0xE2000, 0x82000)
    true
}
