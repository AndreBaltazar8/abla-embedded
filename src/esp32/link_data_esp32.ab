import "abla/unsafe/memory"
import "abla/unsafe/xtensa"

// ESP32 data shared by Abla implementations in this monolithic module. None
// of these objects crosses the ELF boundary, so anonymous internal storage
// lets LLVM discard each object together with its unused subsystem.

val esp32IpEventObject = nativeStaticAllocate(4)
val esp32WifiEventObject = nativeStaticAllocate(4)
val esp32I2sObject = nativeStaticAllocate(24)
val esp32RangeReadBlocks = nativeStaticAllocate(32)
val esp32WriteMassBlocks = nativeStaticAllocate(128)
val esp32RangeWriteBlocks = nativeStaticAllocate(32)
val esp32StartWriteAddresses = nativeStaticAllocate(16)
val esp32InterruptTableStorage = nativeStaticAllocate(512)
val esp32ExceptionTableStorage = nativeStaticAllocate(512)

@inline
trusted fun esp32LinkDataStore(address: int, value: int): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(address), value)

trusted fun esp32LinkDataInitialize(): int {
    esp32LinkDataStore(esp32IpEventObject, nativeCStringAddress("IP_EVENT"))
    esp32LinkDataStore(
        esp32WifiEventObject, nativeCStringAddress("WIFI_EVENT")
    )
    esp32LinkDataStore(esp32I2sObject, int(u32(3007315967)))

    esp32LinkDataStore(esp32RangeReadBlocks + 0, 1073061888)
    esp32LinkDataStore(esp32RangeReadBlocks + 4, 1073061912)
    esp32LinkDataStore(esp32RangeReadBlocks + 8, 1073061944)
    esp32LinkDataStore(esp32RangeReadBlocks + 12, 1073061972)
    esp32LinkDataStore(esp32RangeReadBlocks + 16, 1073061976)
    esp32LinkDataStore(esp32RangeReadBlocks + 20, 1073062004)
    esp32LinkDataStore(esp32RangeReadBlocks + 24, 1073062008)
    esp32LinkDataStore(esp32RangeReadBlocks + 28, 1073062036)

    esp32LinkDataStore(esp32RangeWriteBlocks + 0, esp32WriteMassBlocks)
    esp32LinkDataStore(esp32RangeWriteBlocks + 4, esp32WriteMassBlocks + 24)
    esp32LinkDataStore(esp32RangeWriteBlocks + 8, esp32WriteMassBlocks + 32)
    esp32LinkDataStore(esp32RangeWriteBlocks + 12, esp32WriteMassBlocks + 60)
    esp32LinkDataStore(esp32RangeWriteBlocks + 16, esp32WriteMassBlocks + 64)
    esp32LinkDataStore(esp32RangeWriteBlocks + 20, esp32WriteMassBlocks + 92)
    esp32LinkDataStore(esp32RangeWriteBlocks + 24, esp32WriteMassBlocks + 96)
    esp32LinkDataStore(esp32RangeWriteBlocks + 28, esp32WriteMassBlocks + 124)

    esp32LinkDataStore(esp32StartWriteAddresses + 0, 1073061916)
    esp32LinkDataStore(esp32StartWriteAddresses + 4, 1073062040)
    esp32LinkDataStore(esp32StartWriteAddresses + 8, 1073062072)
    esp32LinkDataStore(esp32StartWriteAddresses + 12, 1073062104)

    esp32ExceptionTableStorage
}

@inline
trusted fun esp32LinkInterruptTablesInitialize(
    unhandledInterrupt: u32,
    unhandledException: u32
): void {
    var index = 0
    while (index < 64) {
        esp32LinkDataStore(
            esp32InterruptTableStorage + index * 8,
            int(unhandledInterrupt)
        )
        esp32LinkDataStore(
            esp32InterruptTableStorage + index * 8 + 4, index
        )
        index = index + 1
    }

    index = 0
    while (index < 128) {
        esp32LinkDataStore(
            esp32ExceptionTableStorage + index * 4,
            int(unhandledException)
        )
        index = index + 1
    }
    return
}

val esp32LinkDataInitialized = esp32LinkDataInitialize()

trusted fun esp32LinkDataDefinitions(): void { return }
