import "abla/runtime/scalar"
// C6 IDF6 clock-tree interpretation: source0 XTAL,1 PLL480,2 RC_FAST;
// root divider times CPU divider, with PLL/4 override for120MHz.
// Caller pins known oscillator rates and excludes clock changes AND all ROM
// delay users. No clock switching, startup or oscillator measurement here.
// Status1configured2unowned3invalidrate4fractionalMHz5clockchanged.
type Esp32C6DelayClock=int
fun Esp32C6DelayClock.status(): int = this&255
fun Esp32C6DelayClock.ready(): bool = this.status() == 1
fun Esp32C6DelayClock.ticksPerMicrosecond(): int = if (this.ready()) (this>>>8)&255 else 0
fun esp32C6CpuRateHz(system: int,cpu: int,xtalHz: int,rcFastHz: int): int {
    val source=(system>>>16)&3
    if (source == 3) return 0
    val root=if (source == 0) xtalHz else if (source == 1) 480000000 else rcFastHz
    val divider=if (source == 1)
        (if ((cpu&0xff00) == 0 && (cpu&65536) != 0) 4 else (((system>>>8)&255)+1)*(((cpu>>>8)&255)+1))
        else ((system&255)+1)*((cpu&255)+1)
    if (root < 1000000 || root > 480000000 || root%divider != 0) return 0
    val hz=root/divider
    return if (hz > 160000000) 0 else hz
}
trusted fun esp32C6DelayClockConfigureOwned(xtalHz: int,rcFastHz: int,exclusiveStableClock: bool): Esp32C6DelayClock {
    if (!exclusiveStableClock) return Esp32C6DelayClock(2)
    val system=c6DelayClockRead(0x60096110)&0x3ffff
    val cpu=c6DelayClockRead(0x60096118)&0x1ffff
    val hz=esp32C6CpuRateHz(system,cpu,xtalHz,rcFastHz)
    if (hz == 0) return Esp32C6DelayClock(3)
    if (hz < 1000000 || hz%1000000 != 0) return Esp32C6DelayClock(4)
    if ((c6DelayClockRead(0x60096110)&0x3ffff) != system || (c6DelayClockRead(0x60096118)&0x1ffff) != cpu) return Esp32C6DelayClock(5)
    c6DelayClockSetRomTicks(hz/1000000)
    if ((c6DelayClockRead(0x60096110)&0x3ffff) != system || (c6DelayClockRead(0x60096118)&0x1ffff) != cpu) return Esp32C6DelayClock(5)
    return Esp32C6DelayClock(1|((hz/1000000)<<8))
}
