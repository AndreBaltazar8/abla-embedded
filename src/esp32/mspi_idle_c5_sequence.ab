import "./mspi_clock_c5_sequence.ab"
// C5 spi_mem_c_reg.h and spi1_mem_reg.h use distinct command layouts.
// SPI0: master/slave FSM bits0..7 and manual USR18.
// SPI1: master/slave FSM bits0..7 and pending command bits17..31.
// A zero master FSM alone does not exclude a newly queued command.
// Read-only bounded polling:1idle2invalid3still busy/unavailable. No command
// writes, cancellation, reset, interrupt acknowledgment, or forced success.
// Controller mask1SPI0,2SPI1,3both. Caller excludes all new cache/DMA/ROM/user
// requests and owns the selected controllers; otherwise an idle sample is not
// a durable guarantee. It also does NOT prove the flash chip's WIP bit cleared.
// Cache-off code/stack/data must be retained. Polls are rounds, not microseconds.
@section(".iram1.abla.c5MspiWaitIdle")
trusted fun esp32C5MspiWaitIdleOwned(controllers: int,polls: int,exclusiveCacheOff: bool): int {
    if (!exclusiveCacheOff || controllers < 1 || controllers > 3 || polls < 1 || polls > 1000000) return 2
    if (!c5MspiReady()) return 3
    var round=0
    while (round < polls) {
        var busy=false
        if ((controllers&1) != 0 && (c5MspiRead(0x60002000)&0x400ff) != 0) busy=true
        if ((controllers&2) != 0 && (c5MspiRead(0x60003000)&0xfffe00ff) != 0) busy=true
        if (!busy) return 1
        round=round+1
    }
    3
}
