import "./rtc_wake_s3_sequence.ab"
import "./rtc_timer_s3_sequence.ab"
import "./power/sleep_domains_s3_sequence.ab"
import "./power/sleep_init_s3_sequence.ab"
import "./power/sleep_timing_s3_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"

// ESP32-S3 ROM rom_i2c_writeReg_Mask=0x40005d6c, block DIG_REG=0x6d,
// host=1, five-bit sleep bias. S3 has no analog I2C root-gating wrapper;
// caller must exclusively own the initialized analog bus, as above.
trusted fun esp32S3SleepBiasWriteOwned(register: int, value: int): void {
    callNativeVoidI32I32I32I32I32I32(0x40005D6C,109,1,register,4,0,value)
    return
}

trusted fun esp32S3RtcWakeRead(address: int): int = mmioLoadU32(address)
trusted fun esp32S3RtcWakeWrite(address: int, value: int): void {
    mmioStoreU32(address,value)
    return
}
trusted fun esp32S3RtcWakeUpdate(address: int, mask: int, value: int): void {
    mmioStoreU32(address, (mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
