import "./mspi_clock_c5_sequence.ab"
import "./mspi_dummy_c5_sequence.ab"
//448B transition: header40,immutable request48@40,pad8,clock48@96,
// timing48@144/192/240 (flash0/flash1/PSRAM),dummy40@288/328/368/408.
// Header tag0,status4,apply stage8,last child12,reverse stage16.
// Request U32 words: coreMHz,flashMHz,psramMHz(0 means absent),SPI1 flag,
// flash0/flash1/PSRAM packed timing(mode3,num2,extra3),
// flash0/flash1/PSRAMread/PSRAMwrite packed dummy(length6,enable1,var1),
// minimum CPU MHz while this profile is used.
// SPI0/1 MUST use identical mode/num: those delay registers are shared.
//1applied2invalid3pending4closed; internal5closing prohibits further apply.
// All child implementations are real; no cache/ROM/PLL/reset/chip commands.
// Caller supplies memory-qualified protocol/timing settings, stable PLL480,
// caches suspended, idle controllers/DMA, retained closure/stack/record and
// exclusive ownership of all shared consumers. Closing restores configuration
// only: caller must also satisfy the original profile's CPU/PSRAM rate bound.
// This is not a tuning search or permission to power down memory or PLL.
// Apply clocks -> protocol dummy -> timing. Close reverses every owned child,
// including partial application; skips unclaimed records, preserves snapshots.
@section(".iram1.abla.c5MspiTransitionContinue")
trusted fun esp32C5MspiTransitionContinueOwned(record: NativeBuffer,exclusiveCacheOff: bool): int {
    if (!exclusiveCacheOff || !record.hasAddressRange(0,448) || (record.addressValue()&3) != 0 || c5SleepRecordRead(record,0) != 0x434d5831) return 2
    if (c5SleepRecordRead(record,4) == 1) return 1
    if (c5SleepRecordRead(record,4) != 3 || c5SleepRecordRead(record,8) > 7) return 2
    val base=record.addressValue();val stage=c5SleepRecordRead(record,8)
    val spi1=c5SleepRecordRead(record,52) != 0;val psram=c5SleepRecordRead(record,48) != 0
    if (stage <= 0) {
        if (true) {
            val child=nativeBufferAt(base+96,48)
            val result=esp32C5MspiClocksOwned(child,c5SleepRecordRead(record,40),c5SleepRecordRead(record,44),c5SleepRecordRead(record,48),spi1,true)
            c5SleepRecordWrite(record,12,result)
            if (result != 1) return 3
        }
        c5SleepRecordWrite(record,8,1)
    }
    if (stage <= 1) {
        if (true) {
            val child=nativeBufferAt(base+288,40)
            val plan=c5SleepRecordRead(record,68)
            val result=esp32C5MspiDummyOwned(child,0,plan&63,(plan&64) != 0,(plan&128) != 0,true)
            c5SleepRecordWrite(record,12,result)
            if (result != 1) return 3
        }
        c5SleepRecordWrite(record,8,2)
    }
    if (stage <= 2) {
        if (spi1) {
            val child=nativeBufferAt(base+328,40)
            val plan=c5SleepRecordRead(record,72)
            val result=esp32C5MspiDummyOwned(child,1,plan&63,(plan&64) != 0,(plan&128) != 0,true)
            c5SleepRecordWrite(record,12,result)
            if (result != 1) return 3
        }
        c5SleepRecordWrite(record,8,3)
    }
    if (stage <= 3) {
        if (psram) {
            val child=nativeBufferAt(base+368,40)
            val plan=c5SleepRecordRead(record,76)
            val result=esp32C5MspiDummyOwned(child,2,plan&63,(plan&64) != 0,(plan&128) != 0,true)
            c5SleepRecordWrite(record,12,result)
            if (result != 1) return 3
        }
        c5SleepRecordWrite(record,8,4)
    }
    if (stage <= 4) {
        if (psram) {
            val child=nativeBufferAt(base+408,40)
            val plan=c5SleepRecordRead(record,80)
            val result=esp32C5MspiDummyOwned(child,3,plan&63,(plan&64) != 0,(plan&128) != 0,true)
            c5SleepRecordWrite(record,12,result)
            if (result != 1) return 3
        }
        c5SleepRecordWrite(record,8,5)
    }
    if (stage <= 5) {
        if (true) {
            val child=nativeBufferAt(base+144,48)
            val plan=c5SleepRecordRead(record,56)
            val result=esp32C5MspiTimingOwned(child,0,plan&7,(plan>>>3)&3,(plan>>>5)&7,true)
            c5SleepRecordWrite(record,12,result)
            if (result != 1) return 3
        }
        c5SleepRecordWrite(record,8,6)
    }
    if (stage <= 6) {
        if (spi1) {
            val child=nativeBufferAt(base+192,48)
            val plan=c5SleepRecordRead(record,60)
            val result=esp32C5MspiTimingOwned(child,1,plan&7,(plan>>>3)&3,(plan>>>5)&7,true)
            c5SleepRecordWrite(record,12,result)
            if (result != 1) return 3
        }
        c5SleepRecordWrite(record,8,7)
    }
    if (stage <= 7) {
        if (psram) {
            val child=nativeBufferAt(base+240,48)
            val plan=c5SleepRecordRead(record,64)
            val result=esp32C5MspiTimingOwned(child,2,plan&7,(plan>>>3)&3,(plan>>>5)&7,true)
            c5SleepRecordWrite(record,12,result)
            if (result != 1) return 3
        }
        c5SleepRecordWrite(record,8,8)
    }
    c5SleepRecordWrite(record,4,1)
    1
}
@section(".iram1.abla.c5MspiTransitionClose")
trusted fun esp32C5MspiTransitionCloseOwned(record: NativeBuffer,exclusiveCacheOff: bool): int {
    if (!exclusiveCacheOff || !record.hasAddressRange(0,448) || (record.addressValue()&3) != 0 || c5SleepRecordRead(record,0) != 0x434d5831) return 2
    if (c5SleepRecordRead(record,4) == 4) return 4
    val state=c5SleepRecordRead(record,4)
    if ((state != 1 && state != 3 && state != 5) || c5SleepRecordRead(record,16) > 7) return 2
    c5SleepRecordWrite(record,4,5)
    val base=record.addressValue();val stage=c5SleepRecordRead(record,16)
    if (stage <= 0) {
        if (c5SleepRecordRead(record,240) != 0) {
            val result=esp32C5MspiTimingCloseOwned(nativeBufferAt(base+240,48),true)
            c5SleepRecordWrite(record,12,result)
            if (result != 4) return 3
        }
        c5SleepRecordWrite(record,16,1)
    }
    if (stage <= 1) {
        if (c5SleepRecordRead(record,192) != 0) {
            val result=esp32C5MspiTimingCloseOwned(nativeBufferAt(base+192,48),true)
            c5SleepRecordWrite(record,12,result)
            if (result != 4) return 3
        }
        c5SleepRecordWrite(record,16,2)
    }
    if (stage <= 2) {
        if (c5SleepRecordRead(record,144) != 0) {
            val result=esp32C5MspiTimingCloseOwned(nativeBufferAt(base+144,48),true)
            c5SleepRecordWrite(record,12,result)
            if (result != 4) return 3
        }
        c5SleepRecordWrite(record,16,3)
    }
    if (stage <= 3) {
        if (c5SleepRecordRead(record,408) != 0) {
            val result=esp32C5MspiDummyCloseOwned(nativeBufferAt(base+408,40),true)
            c5SleepRecordWrite(record,12,result)
            if (result != 4) return 3
        }
        c5SleepRecordWrite(record,16,4)
    }
    if (stage <= 4) {
        if (c5SleepRecordRead(record,368) != 0) {
            val result=esp32C5MspiDummyCloseOwned(nativeBufferAt(base+368,40),true)
            c5SleepRecordWrite(record,12,result)
            if (result != 4) return 3
        }
        c5SleepRecordWrite(record,16,5)
    }
    if (stage <= 5) {
        if (c5SleepRecordRead(record,328) != 0) {
            val result=esp32C5MspiDummyCloseOwned(nativeBufferAt(base+328,40),true)
            c5SleepRecordWrite(record,12,result)
            if (result != 4) return 3
        }
        c5SleepRecordWrite(record,16,6)
    }
    if (stage <= 6) {
        if (c5SleepRecordRead(record,288) != 0) {
            val result=esp32C5MspiDummyCloseOwned(nativeBufferAt(base+288,40),true)
            c5SleepRecordWrite(record,12,result)
            if (result != 4) return 3
        }
        c5SleepRecordWrite(record,16,7)
    }
    if (stage <= 7) {
        if (c5SleepRecordRead(record,96) != 0) {
            val result=esp32C5MspiClocksCloseOwned(nativeBufferAt(base+96,48),true)
            c5SleepRecordWrite(record,12,result)
            if (result != 4) return 3
        }
        c5SleepRecordWrite(record,16,8)
    }
    c5SleepRecordWrite(record,4,4)
    4
}
// Checked recovery boundary for sleep/CPU-clock owners. The clock child saves
// the original PLL480 core divider and PSRAM clock fields before mutation.
// Compare the exact ratio, including fractional MHz: do not round down memory
// frequency. EQ_SYSCLK overrides N; H/L do not affect the cycle frequency.
// Caller supplies the actual stable CPU MHz and still owns the cache-off
// hardware boundary. This validates frequency only, not chip timing/voltage.
@section(".iram1.abla.c5MspiTransitionCloseAtCpu")
trusted fun esp32C5MspiTransitionCloseAtCpuOwned(record: NativeBuffer,cpuMHz: int,exclusiveCacheOff: bool): int {
    if (!exclusiveCacheOff || cpuMHz < 1 || cpuMHz > 240 || !record.hasAddressRange(0,448) ||
        (record.addressValue()&3) != 0 || c5SleepRecordRead(record,0) != 0x434d5831) return 2
    if (c5SleepRecordRead(record,96) != 0) {
        if (c5SleepRecordRead(record,96) != 0x434d5331) return 2
        if ((c5SleepRecordRead(record,120)&2) != 0) {
            val coreField=c5SleepRecordRead(record,124)
            val memoryBits=c5SleepRecordRead(record,136)
            if (coreField > 255) return 2
            val divider=if ((memoryBits&0x80000000) != 0) 1 else (memoryBits&255)+1
            if (cpuMHz*8*(coreField+1)*divider < 480) return 2
        }
    }
    esp32C5MspiTransitionCloseOwned(record,true)
}
@section(".iram1.abla.c5MspiTransitionBegin")
trusted fun esp32C5MspiTransitionBeginOwned(record: NativeBuffer,request: NativeBuffer,exclusiveCacheOff: bool): int {
    if (!exclusiveCacheOff || !record.hasAddressRange(0,448) || !request.hasAddressRange(0,48) ||
        (record.addressValue()&3) != 0 || c5SleepRecordRead(record,0) != 0) return 2
    val base=record.addressValue();val input=request.addressValue()
    if (base < input+48 && input < base+448) return 2
    val core=c5SleepRecordRead(request,0);val flash=c5SleepRecordRead(request,4);val psram=c5SleepRecordRead(request,8)
    if (esp32C5MspiFrequencyBits(core,flash) < 0 || (psram != 0 && esp32C5MspiFrequencyBits(core,psram) < 0) ||
        c5SleepRecordRead(request,12) > 1 || c5SleepRecordRead(request,44) < 1 || c5SleepRecordRead(request,44) > 240) return 2
    if (psram != 0 && c5SleepRecordRead(request,44)*8 < psram) return 2
    var offset=16
    while (offset <= 24) {
        val plan=c5SleepRecordRead(request,offset)
        if (plan > 255 || (plan&7) > 6) return 2
        offset=offset+4
    }
    if (c5SleepRecordRead(request,12) != 0 && (c5SleepRecordRead(request,16)&31) != (c5SleepRecordRead(request,20)&31)) return 2
    if (c5SleepRecordRead(request,28) > 255 || c5SleepRecordRead(request,32) > 255 || c5SleepRecordRead(request,36) > 127 || c5SleepRecordRead(request,40) > 127) return 2
    offset=0
    while (offset < 48) { c5SleepRecordWrite(record,40+offset,c5SleepRecordRead(request,offset));offset=offset+4 }
    c5SleepRecordWrite(record,96,0)
    c5SleepRecordWrite(record,288,0)
    c5SleepRecordWrite(record,328,0)
    c5SleepRecordWrite(record,368,0)
    c5SleepRecordWrite(record,408,0)
    c5SleepRecordWrite(record,144,0)
    c5SleepRecordWrite(record,192,0)
    c5SleepRecordWrite(record,240,0)
    c5SleepRecordWrite(record,8,0);c5SleepRecordWrite(record,12,0);c5SleepRecordWrite(record,16,0)
    c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,0,0x434d5831)
    esp32C5MspiTransitionContinueOwned(record,true)
}
