// ESP32-S3 XEA2 windowed-ABI hardware vectors, matching IDF xtensa_vectors.S.
// Architecture boundary: register-window spill/fill cannot be ordinary Abla
// calls (those calls themselves require functioning register windows).
// Complete six window slots plus MOVSP alloca recovery in the0x50 gap.
// Link this section at VECBASE offset0, aligned1024; remaining exception/
// interrupt vectors at0x180..0x3c0 are NOT provided by this module.
// Private entry address only; no per-vector exports or opaque implementations.
import "abla/unsafe/native"
trusted noescape extern:"inline-assembly" fun esp32S3WindowAssembly(template: string,constraints: string): void
@naked
@noinline
@section(".iram1.abla.s3WindowVectors")
trusted fun esp32S3WindowVectors(): void =
    esp32S3WindowAssembly(".Labla_s3_window_base:\n.org .Labla_s3_window_base+0\n.Labla_s3_overflow4:\ns32e a0, a5, -16\ns32e a1, a5, -12\ns32e a2, a5, -8\ns32e a3, a5, -4\nrfwo\n.org .Labla_s3_window_base+64\n.Labla_s3_underflow4:\nl32e a0, a5, -16\nl32e a1, a5, -12\nl32e a2, a5, -8\nl32e a3, a5, -4\nrfwu\n.org .Labla_s3_window_base+80\n.Labla_s3_alloca:\nrsr.windowbase a0\nrotw -1\nrsr.ps a2\nextui a3, a2, 8, 4\nxor a3, a3, a4\nrsr.excsave1 a4\nslli a3, a3, 8\nxor a2, a2, a3\nwsr.ps a2\nrsync\nbbci a4, 31, .Labla_s3_underflow4\nrotw -1\nbbci a8, 30, .Labla_s3_underflow8\nrotw -1\nj .Labla_s3_underflow12\n.org .Labla_s3_window_base+128\n.Labla_s3_overflow8:\ns32e a0, a9, -16\nl32e a0, a1, -12\ns32e a1, a9, -12\ns32e a2, a9, -8\ns32e a3, a9, -4\ns32e a4, a0, -32\ns32e a5, a0, -28\ns32e a6, a0, -24\ns32e a7, a0, -20\nrfwo\n.org .Labla_s3_window_base+192\n.Labla_s3_underflow8:\nl32e a0, a9, -16\nl32e a1, a9, -12\nl32e a2, a9, -8\nl32e a7, a1, -12\nl32e a3, a9, -4\nl32e a4, a7, -32\nl32e a5, a7, -28\nl32e a6, a7, -24\nl32e a7, a7, -20\nrfwu\n.org .Labla_s3_window_base+256\n.Labla_s3_overflow12:\ns32e a0, a13, -16\nl32e a0, a1, -12\ns32e a1, a13, -12\ns32e a2, a13, -8\ns32e a3, a13, -4\ns32e a4, a0, -48\ns32e a5, a0, -44\ns32e a6, a0, -40\ns32e a7, a0, -36\ns32e a8, a0, -32\ns32e a9, a0, -28\ns32e a10, a0, -24\ns32e a11, a0, -20\nrfwo\n.org .Labla_s3_window_base+320\n.Labla_s3_underflow12:\nl32e a0, a13, -16\nl32e a1, a13, -12\nl32e a2, a13, -8\nl32e a11, a1, -12\nl32e a3, a13, -4\nl32e a4, a11, -48\nl32e a5, a11, -44\nl32e a6, a11, -40\nl32e a7, a11, -36\nl32e a8, a11, -32\nl32e a9, a11, -28\nl32e a10, a11, -24\nl32e a11, a11, -20\nrfwu\n.org .Labla_s3_window_base+384", "~{memory}")
