import "./gpio_p4_sequence.ab"
import "./gpio_hold_p4_sequence.ab"
import "./gpio_clock_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("p4GpioRead")
trusted fun p4GpioReadHook(offset: int): u32 = u32(mmioLoadU32(0x500e0000+offset))
@export("p4GpioWrite")
trusted fun p4GpioWriteHook(offset: int,value: u32): void { mmioStoreU32(0x500e0000+offset,int(value)); return }
@export("p4GpioHoldRead")
trusted fun p4GpioHoldReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("p4GpioHoldWrite")
trusted fun p4GpioHoldWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value)); return }
@export("p4IomuxClockRead")
trusted fun p4IomuxClockReadHook(offset: int): u32 = u32(mmioLoadU32(0x500e6000+offset))
@export("p4IomuxClockWrite")
trusted fun p4IomuxClockWriteHook(offset: int,value: u32): void { mmioStoreU32(0x500e6000+offset,int(value)); return }
trusted fun esp32P4GpioRead(pin: int): int = esp32P4GpioReadOwned(pin)
trusted fun esp32P4GpioWrite(pin: int,high: bool): bool = esp32P4GpioWriteOwned(pin,high)
trusted fun esp32P4GpioConfigure(pin: int,output: bool,high: bool,openDrain: bool,input: bool,pull: int): int = esp32P4GpioConfigureOwned(pin,output,high,openDrain,input,pull)
