import "./gpio_p4_sequence.ab"
import "./gpio_hold_p4_sequence.ab"
import "./gpio_clock_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4GpioRead(offset: int): u32 = u32(mmioLoadU32(0x500e0000+offset))
trusted fun p4GpioWrite(offset: int,value: u32): void { mmioStoreU32(0x500e0000+offset,int(value)); return }
trusted fun p4GpioHoldRead(address: int): u32 = u32(mmioLoadU32(address))
trusted fun p4GpioHoldWrite(address: int,value: u32): void { mmioStoreU32(address,int(value)); return }
trusted fun p4IomuxClockRead(offset: int): u32 = u32(mmioLoadU32(0x500e6000+offset))
trusted fun p4IomuxClockWrite(offset: int,value: u32): void { mmioStoreU32(0x500e6000+offset,int(value)); return }
trusted fun esp32P4GpioRead(pin: int): int = esp32P4GpioReadOwned(pin)
trusted fun esp32P4GpioWrite(pin: int,high: bool): bool = esp32P4GpioWriteOwned(pin,high)
trusted fun esp32P4GpioConfigure(pin: int,output: bool,high: bool,openDrain: bool,input: bool,pull: int): int = esp32P4GpioConfigureOwned(pin,output,high,openDrain,input,pull)
