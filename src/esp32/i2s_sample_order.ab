import "./sdk/buffer.ab"

// ESP32 I2S hardware version 1 transmits the upper 16-bit half-word first in
// standard mono mode. Convert chronological signed-16 PCM to or from that wire
// order by swapping each adjacent sample pair in place.
trusted fun swapEsp32MonoSamplePairs(address: int, length: int): void {
    var offset = 0
    while (offset <= length - 4) {
        val pair = nativeAddressLoadU32(address, offset)
        nativeAddressStoreU32(
            address, offset, (pair >>> 16) | (pair << 16)
        )
        offset = offset + 4
    }
    return
}
