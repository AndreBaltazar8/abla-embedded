import "abla/unsafe/memory"
import "./sdk/buffer.ab"

// Arduino 3.x renamed the concrete TLS client. This file isolates the pinned
// Arduino 3.3.11 C++ ABI while preserving the board-neutral TlsClient API.
trusted noescape extern:"c" fun _ZN19NetworkClientSecureC1Ev(self: i64*): void
trusted noescape extern:"c" fun _ZN19NetworkClientSecureD1Ev(self: i64*): void
trusted noescape extern:"c" fun _ZN19NetworkClientSecure9setCACertEPKc(
    self: i64*,
    certificate: cstring
): void
trusted noescape extern:"c" fun _ZN19NetworkClientSecure7connectEPKct(
    self: i64*,
    host: cstring,
    port: u16
): bool
trusted noescape extern:"c" fun _ZN19NetworkClientSecure5writeEPKhj(
    self: i64*,
    data: i64*,
    length: u32
): u32
trusted noescape extern:"c" fun _ZN19NetworkClientSecure4readEPhj(
    self: i64*,
    data: i64*,
    length: u32
): i32
trusted noescape extern:"c" fun _ZN19NetworkClientSecure9availableEv(
    self: i64*
): i32
trusted noescape extern:"c" fun _ZN19NetworkClientSecure9connectedEv(
    self: i64*
): u8
trusted noescape extern:"c" fun _ZN19NetworkClientSecure4stopEv(self: i64*): void
trusted noescape extern:"c" fun _ZN13NetworkClient10setNoDelayEb(
    self: i64*,
    enabled: bool
): i32

type TlsClient = int
val tlsClientStorageBytes = 100

trusted fun tlsClientAt(address: int): TlsClient {
    _ZN19NetworkClientSecureC1Ev(nativePointerFromAddress(address))
    TlsClient(address)
}

// Convenient single-client storage for small firmware. Projects needing more
// clients can reserve distinct regions and construct each with tlsClientAt.
trusted fun tlsClient(): TlsClient =
    tlsClientAt(nativeStaticAllocate(100))

trusted fun TlsClient.pointer(): i64* = nativePointerFromAddress(this)

trusted fun TlsClient.setCertificate(certificate: string): void {
    if (this != 0) _ZN19NetworkClientSecure9setCACertEPKc(this.pointer(), certificate)
    return
}

trusted fun TlsClient.connect(host: string, port: int): bool =
    this != 0 && _ZN19NetworkClientSecure7connectEPKct(this.pointer(), host, port)

trusted fun TlsClient.connected(): bool =
    this != 0 && _ZN19NetworkClientSecure9connectedEv(this.pointer()) != 0

trusted fun TlsClient.available(): int {
    var result = 0
    if (this != 0) result = _ZN19NetworkClientSecure9availableEv(this.pointer())
    result
}

trusted fun TlsClient.noDelay(enabled: bool): bool =
    this != 0 && _ZN13NetworkClient10setNoDelayEb(
        this.pointer(), enabled
    ) == 0

trusted fun TlsClient.write(buffer: NativeBuffer, length: int): int {
    var result = 0
    if (this != 0) {
        result = _ZN19NetworkClientSecure5writeEPKhj(
            this.pointer(), buffer.pointer(), length
        )
    }
    result
}

trusted fun TlsClient.writeSlice(
    buffer: NativeBuffer,
    offset: int,
    length: int
): int {
    var result = 0
    if (this != 0 && offset >= 0 && length >= 0 &&
        offset <= buffer.capacity() - length) {
        result = _ZN19NetworkClientSecure5writeEPKhj(
            this.pointer(), buffer.pointerAt(offset), length
        )
    }
    result
}

trusted fun TlsClient.read(buffer: NativeBuffer, length: int): int {
    var result = 0
    if (this != 0) {
        result = _ZN19NetworkClientSecure4readEPhj(
            this.pointer(), buffer.pointer(), length
        )
    }
    result
}

trusted fun TlsClient.readSlice(
    buffer: NativeBuffer,
    offset: int,
    length: int
): int {
    var result = 0
    if (this != 0 && offset >= 0 && length >= 0 &&
        offset <= buffer.capacity() - length) {
        result = _ZN19NetworkClientSecure4readEPhj(
            this.pointer(), buffer.pointerAt(offset), length
        )
    }
    result
}

trusted fun TlsClient.stop(): void {
    if (this != 0) _ZN19NetworkClientSecure4stopEv(this.pointer())
    return
}

trusted fun TlsClient.destroy(): void {
    if (this != 0) {
        _ZN19NetworkClientSecure4stopEv(this.pointer())
        _ZN19NetworkClientSecureD1Ev(this.pointer())
    }
    return
}
