import "abla/unsafe/memory"

// Arduino 3.x renamed the concrete TLS client. This file isolates that C++
// ABI while preserving the board-neutral TlsClient API used by applications.
trusted noescape extern:"c" fun _ZN19NetworkClientSecureC1Ev(self: i64*): void
trusted noescape extern:"c" fun _ZN19NetworkClientSecureD1Ev(self: i64*): void
trusted noescape extern:"c" fun _ZN19NetworkClientSecure9setCACertEPKc(
    self: i64*,
    certificate: cstring
): void
trusted noescape extern:"c" fun _ZN19NetworkClientSecure7connectEPKct(
    self: i64*,
    host: cstring,
    port: u16
): bool
trusted noescape extern:"c" fun _ZN19NetworkClientSecure5writeEPKhj(
    self: i64*,
    data: i64*,
    length: u32
): u32
trusted noescape extern:"c" fun _ZN19NetworkClientSecure4readEPhj(
    self: i64*,
    data: i64*,
    length: u32
): i32
trusted noescape extern:"c" fun _ZN19NetworkClientSecure9availableEv(
    self: i64*
): i32
trusted noescape extern:"c" fun _ZN19NetworkClientSecure9connectedEv(
    self: i64*
): u8
trusted noescape extern:"c" fun _ZN19NetworkClientSecure4stopEv(self: i64*): void

resource class TlsClient(val address: i64*, var closed: bool) {
    trusted fun drop(): void {
        if (!closed) {
            _ZN19NetworkClientSecure4stopEv(address)
            _ZN19NetworkClientSecureD1Ev(address)
            ablaUnsafeFree(address)
            closed = true
        }
    }
}

trusted fun tlsClient(): TlsClient {
    val address = ablaUnsafeAllocate(512)
    _ZN19NetworkClientSecureC1Ev(address)
    TlsClient(address, false)
}

trusted fun TlsClient.setCertificate(certificate: string): void {
    if (!this.closed) _ZN19NetworkClientSecure9setCACertEPKc(this.address, certificate)
    return
}

trusted fun TlsClient.connect(host: string, port: int): bool =
    !this.closed && _ZN19NetworkClientSecure7connectEPKct(this.address, host, port)

trusted fun TlsClient.connected(): bool =
    !this.closed && _ZN19NetworkClientSecure9connectedEv(this.address) != 0

trusted fun TlsClient.available(): int {
    var result = 0
    if (!this.closed) result = _ZN19NetworkClientSecure9availableEv(this.address)
    result
}

trusted fun TlsClient.write(buffer: NativeByteBuffer, length: int): int {
    var result = 0
    if (!this.closed) {
        result = _ZN19NetworkClientSecure5writeEPKhj(
            this.address, buffer.address, length
        )
    }
    result
}

trusted fun TlsClient.writeSlice(
    buffer: NativeByteBuffer,
    offset: int,
    length: int
): int {
    var result = 0
    if (!this.closed && offset >= 0 && length >= 0 &&
        offset + length <= buffer.capacity) {
        result = _ZN19NetworkClientSecure5writeEPKhj(
            this.address, buffer.pointerAt(offset), length
        )
    }
    result
}

trusted fun TlsClient.read(var buffer: NativeByteBuffer, length: int): int {
    var result = 0
    if (!this.closed) {
        result = _ZN19NetworkClientSecure4readEPhj(
            this.address, buffer.address, length
        )
    }
    result
}

trusted fun TlsClient.readSlice(
    var buffer: NativeByteBuffer,
    offset: int,
    length: int
): int {
    var result = 0
    if (!this.closed && offset >= 0 && length >= 0 &&
        offset + length <= buffer.capacity) {
        result = _ZN19NetworkClientSecure4readEPhj(
            this.address, buffer.pointerAt(offset), length
        )
    }
    result
}

trusted fun TlsClient.stop(): void {
    if (!this.closed) _ZN19NetworkClientSecure4stopEv(this.address)
    return
}
