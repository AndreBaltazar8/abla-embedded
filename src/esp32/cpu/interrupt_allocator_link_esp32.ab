import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkInterruptAllocatorOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspIntrMarkShared", "esp_intr_mark_shared")) return false
    if (!internalFunction("esp32RecoveredEspIntrReserve", "esp_intr_reserve")) return false
    if (!internalFunction("esp32RecoveredEspIntrPtrInIsrRegion", "esp_intr_ptr_in_isr_region")) return false
    if (!internalFunction("esp32RecoveredEspIntrSetInIram", "esp_intr_set_in_iram")) return false
    if (!internalFunction("esp32RecoveredEspIntrGetIntno", "esp_intr_get_intno")) return false
    if (!exportFunction("esp32RecoveredEspIntrGetCpu", "esp_intr_get_cpu")) return false
    if (!exportFunction("esp32RecoveredEspIntrNoniramDisable", "esp_intr_noniram_disable")) return false
    if (!exportFunction("esp32RecoveredEspIntrNoniramEnable", "esp_intr_noniram_enable")) return false
    if (!internalFunction("esp32RecoveredEtsIsrUnmask", "ets_isr_unmask")) return false
    if (!internalFunction("esp32RecoveredEtsIsrMask", "ets_isr_mask")) return false
    if (!exportFunction("esp32RecoveredEspIntrEnableSource", "esp_intr_enable_source")) return false
    if (!exportFunction("esp32RecoveredEspIntrEnable", "esp_intr_enable")) return false
    if (!exportFunction("esp32RecoveredEspIntrDisableSource", "esp_intr_disable_source")) return false
    if (!exportFunction("esp32RecoveredEspIntrDisable", "esp_intr_disable")) return false
    if (!internalFunction("esp32RecoveredEspIntrAllocIntrstatusBind", "esp_intr_alloc_intrstatus_bind")) return false
    if (!internalFunction("esp32RecoveredEspIntrAllocIntrstatus", "esp_intr_alloc_intrstatus")) return false
    if (!exportFunction("esp32RecoveredEspIntrAlloc", "esp_intr_alloc")) return false
    if (!internalFunction("esp32RecoveredEspIntrAllocBind", "esp_intr_alloc_bind")) return false
    if (!exportFunction("esp32RecoveredEspIntrFree", "esp_intr_free")) return false
    if (!internalFunction("esp32RecoveredEspIntrDump", "esp_intr_dump")) return false
    true
}
