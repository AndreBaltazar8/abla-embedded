import "../../atomic.ab"
import "../../xtensa/assembly.ab"
import "abla/integer"
import "abla/unsafe/mmio"

// ESP32 multicore control is ordinary volatile register manipulation. Only
// operations on Xtensa special registers remain target primitives.

val esp32CpuControlOptionsRegister = 0x3ff48000
val esp32CpuControlStallRegister = 0x3ff480ac

@inline
trusted fun esp32CpuControlRequireValidCore(core: u32): void {
    if (core >= u32(2)) xtensaTrapForever()
}

@inline
trusted fun esp32CpuControlUpdate(
    address: int, clearMask: u32, setMask: u32
): void {
    val current = u32(mmioLoadU32(address))
    mmioStoreU32(address, int((current & ~clearMask) | setMask))
    return
}

@section(".iram1.abla.cpu.stall")
trusted fun esp32RecoveredEspCpuStall(core: u32): void {
    esp32CpuControlRequireValidCore(core)
    val optionMask = if (core == u32(0)) u32(12) else u32(3)
    val optionValue = if (core == u32(0)) u32(8) else u32(2)
    val stallMask = if (core == u32(0))
        u32(0xfc000000) else u32(0x03f00000)
    val stallValue = if (core == u32(0))
        u32(33) << u32(26) else u32(33) << u32(20)
    esp32CpuControlUpdate(
        esp32CpuControlOptionsRegister, optionMask, optionValue
    )
    esp32CpuControlUpdate(
        esp32CpuControlStallRegister, stallMask, stallValue
    )
    return
}

@section(".iram1.abla.cpu.unstall")
trusted fun esp32RecoveredEspCpuUnstall(core: u32): void {
    esp32CpuControlRequireValidCore(core)
    esp32CpuControlUpdate(
        esp32CpuControlOptionsRegister,
        if (core == u32(0)) u32(12) else u32(3), u32(0)
    )
    esp32CpuControlUpdate(
        esp32CpuControlStallRegister,
        if (core == u32(0)) u32(0xfc000000) else u32(0x03f00000),
        u32(0)
    )
    return
}

@section(".iram1.abla.cpu.reset")
trusted fun esp32RecoveredEspCpuReset(core: u32): void {
    esp32CpuControlRequireValidCore(core)
    esp32CpuControlUpdate(
        esp32CpuControlOptionsRegister, u32(0),
        if (core == u32(0)) u32(32) else u32(16)
    )
    return
}

trusted fun esp32RecoveredEspCpuWaitForIntr(): void =
    xtensaWaitForInterrupt()

trusted fun esp32RecoveredEspCpuSetBreakpoint(
    breakpoint: u32,
    address: u32
): u32 {
    if (breakpoint >= u32(2)) return u32(258)
    if (breakpoint == u32(1))
        xtensaWriteInstructionBreakpointAddress1(address)
    else xtensaWriteInstructionBreakpointAddress0(address)
    xtensaWriteInstructionBreakpointEnable(
        xtensaReadInstructionBreakpointEnable() |
            (u32(1) << breakpoint)
    )
    return u32(0)
}

trusted fun esp32RecoveredEspCpuClearBreakpoint(
    breakpoint: u32
): u32 {
    if (breakpoint >= u32(2)) return u32(258)
    xtensaWriteInstructionBreakpointEnable(
        xtensaReadInstructionBreakpointEnable() & ~(u32(1) << breakpoint)
    )
    if (breakpoint == u32(1))
        xtensaWriteInstructionBreakpointAddress1(u32(0))
    else xtensaWriteInstructionBreakpointAddress0(u32(0))
    return u32(0)
}

trusted fun esp32RecoveredEspCpuSetWatchpoint(
    watchpoint: u32,
    address: u32,
    size: u32,
    trigger: u32
): u32 {
    if (watchpoint >= u32(2) || size == u32(0) || size > u32(64))
        return u32(258)
    if ((size & (size - u32(1))) != u32(0) ||
        (address & (size - u32(1))) != u32(0) || trigger > u32(2))
        return u32(258)

    val sizeExponent = u32(31) - size.countLeadingZeros()
    var control = (u32(63) << sizeExponent) & u32(63)
    if (trigger == u32(0) || trigger == u32(2))
        control = control | u32(0x40000000)
    if (trigger == u32(1) || trigger == u32(2))
        control = control | u32(0x80000000)

    if (watchpoint == u32(1)) {
        xtensaWriteDataBreakpointAddress1(address)
        xtensaWriteDataBreakpointControl1(control)
    } else {
        xtensaWriteDataBreakpointAddress0(address)
        xtensaWriteDataBreakpointControl0(control)
    }
    return u32(0)
}

trusted fun esp32RecoveredEspCpuClearWatchpoint(
    watchpoint: u32
): u32 {
    if (watchpoint >= u32(2)) return u32(258)
    if (watchpoint == u32(1)) {
        xtensaWriteDataBreakpointControl1(u32(0))
        xtensaWriteDataBreakpointAddress1(u32(0))
    } else {
        xtensaWriteDataBreakpointControl0(u32(0))
        xtensaWriteDataBreakpointAddress0(u32(0))
    }
    return u32(0)
}

trusted fun esp32RecoveredEspCpuCompareAndSet(
    address: u32,
    expected: u32,
    desired: u32
): u32 = if (atomicU32At(int(address)).compareSetRelaxed(expected, desired))
    u32(1) else u32(0)
