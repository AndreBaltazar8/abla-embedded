import "abla/unsafe/memory"
import "abla/unsafe/native"

// Classic ESP32 interrupt descriptors. Every four-word entry contains the
// level/type shared by both CPUs followed by the per-CPU flags. Keeping this
// as typed data and direct indexing replaces the recovered register machine
// and lets LLVM fold constant interrupt lookups.
val esp32CpuInterruptDescriptorsStorage = nativeStaticU32s([
    1, 0, 2, 2, 1, 0, 0, 0,
    1, 0, 0, 0, 1, 0, 0, 0,
    1, 0, 2, 0, 1, 0, 0, 0,
    1, 2, 2, 2, 1, 2, 1, 1,
    1, 0, 0, 0, 1, 0, 0, 0,
    1, 1, 0, 0, 3, 2, 1, 1,
    1, 0, 0, 0, 1, 0, 0, 0,
    7, 0, 0, 0, 3, 2, 1, 1,
    5, 2, 1, 1, 1, 0, 0, 0,
    1, 0, 0, 0, 2, 0, 0, 0,
    2, 0, 0, 0, 2, 0, 0, 0,
    3, 1, 0, 0, 3, 0, 0, 0,
    4, 0, 2, 2, 4, 0, 2, 2,
    5, 0, 0, 0, 3, 0, 0, 0,
    4, 1, 2, 2, 3, 2, 1, 1,
    4, 1, 0, 0, 5, 0, 0, 0
])
val esp32CpuInterruptDescriptors = u32(esp32CpuInterruptDescriptorsStorage)

@inline
trusted fun esp32CpuInterruptDescriptor(
    core: u32, interrupt: u32, destination: u32
): bool {
    if (core >= u32(2) || interrupt >= u32(32) || destination == u32(0))
        return false
    val entry = esp32CpuInterruptDescriptors + (interrupt << u32(4))
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(destination)),
        int(ablaUnsafeLoadU32(nativePointerFromAddress(int(entry))))
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(destination + u32(4))),
        int(ablaUnsafeLoadU32(nativePointerFromAddress(int(entry + u32(4)))))
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(destination + u32(8))),
        int(ablaUnsafeLoadU32(nativePointerFromAddress(
            int(entry + u32(8) + (core << u32(2)))
        )))
    )
    return true
}

// Compatibility shape for the remaining lifted allocator. It is internal and
// will disappear when that caller is converted to esp32CpuInterruptDescriptor.
trusted fun esp32RecoveredEspCpuIntrGetDesc(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    esp32CpuInterruptDescriptor(a2, a3, a4)
    return a2
}
