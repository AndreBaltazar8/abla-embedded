import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRtcInterruptsOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredRtcIsrRegister", "rtc_isr_register")) return false
    if (!internalFunction("esp32RecoveredRtcIsrDeregister", "rtc_isr_deregister")) return false
    if (!internalFunction("esp32RecoveredRtcIsrNoniramDisable", "rtc_isr_noniram_disable")) return false
    if (!internalFunction("esp32RecoveredRtcIsrNoniramEnable", "rtc_isr_noniram_enable")) return false
    true
}
