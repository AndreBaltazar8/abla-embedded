import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCpuRegionProtectionOpaqueCallers(): bool {
    if (!internalFunction("esp32CpuConfigureRegionProtection", "esp_cpu_configure_region_protection")) return false
    true
}
