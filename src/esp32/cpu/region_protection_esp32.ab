import "../crypto/mpu_hal_esp32.ab"

trusted fun esp32CpuConfigureRegionProtection(): void {
    // Disable access to the null region and the four external address-space
    // regions, then permit data access to the normal low address region.
    esp32MpuSetRegionAccess(u32(0), u32(0))
    var regionIndex = u32(4)
    while (regionIndex <= u32(7)) {
        esp32MpuSetRegionAccess(regionIndex, u32(0))
        regionIndex = regionIndex + u32(1)
    }
    esp32MpuSetRegionAccess(u32(1), u32(1))
    return
}

trusted fun esp32RecoveredEspCpuConfigureRegionProtection(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32CpuConfigureRegionProtection()
    a2
}
