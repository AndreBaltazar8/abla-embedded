import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCpuControlOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspCpuStall", "esp_cpu_stall")) return false
    if (!exportFunction("esp32RecoveredEspCpuUnstall", "esp_cpu_unstall")) return false
    if (!internalFunction("esp32RecoveredEspCpuReset", "esp_cpu_reset")) return false
    if (!exportFunction("esp32RecoveredEspCpuWaitForIntr", "esp_cpu_wait_for_intr")) return false
    if (!exportFunction("esp32RecoveredEspCpuSetBreakpoint", "esp_cpu_set_breakpoint")) return false
    if (!internalFunction("esp32RecoveredEspCpuClearBreakpoint", "esp_cpu_clear_breakpoint")) return false
    if (!exportFunction("esp32RecoveredEspCpuSetWatchpoint", "esp_cpu_set_watchpoint")) return false
    if (!internalFunction("esp32RecoveredEspCpuClearWatchpoint", "esp_cpu_clear_watchpoint")) return false
    if (!exportFunction("esp32RecoveredEspCpuCompareAndSet", "esp_cpu_compare_and_set")) return false
    true
}
