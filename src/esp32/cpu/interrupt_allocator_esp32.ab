@inline
trusted fun esp32InterruptVectorPacked(vector: u32): u32 =
    esp32InterruptAllocatorLoadU32(vector)

@inline
fun esp32InterruptVectorFlags(packed: u32): u32 = packed & u32(65535)

@inline
fun esp32InterruptVectorCpu(packed: u32): u32 =
    (packed >>> u32(16)) & u32(1)

@inline
fun esp32InterruptVectorNumber(packed: u32): u32 =
    (packed >>> u32(17)) & u32(31)

@inline
fun esp32InterruptVectorPack(cpu: u32, interrupt: u32): u32 =
    ((cpu & u32(1)) << u32(16)) |
    ((interrupt & u32(31)) << u32(17))

trusted fun esp32InterruptFindVector(interrupt: u32, cpu: u32): u32 {
