        if ((requestedFlags & u32(256)) == u32(0)) return false
        if (((vectorFlags & u32(2)) != u32(0)) !=
            ((requestedFlags & u32(1024)) != u32(0))) return false
    } else if (esp32RecoveredXtIntHasHandler(interrupt, cpu) != u32(0)) {
        return false
    }
