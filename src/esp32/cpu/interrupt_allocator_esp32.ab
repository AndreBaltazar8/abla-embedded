        val packed = esp32InterruptVectorPacked(current)
        val currentCpu = esp32InterruptVectorCpu(packed)
        val currentNumber = esp32InterruptVectorNumber(packed)
        if (currentCpu > targetCpu ||
            (currentCpu == targetCpu && currentNumber >= targetNumber)) {
            esp32InterruptAllocatorStoreU32(toInsert + u32(12), current)
            if (previous == u32(0)) {
                esp32InterruptAllocatorStoreU32(headAddress, toInsert)
