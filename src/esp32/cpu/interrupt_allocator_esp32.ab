    if ((requestedFlags & (u32(1) << priority)) == u32(0)) return false
    val edgeRequested = (requestedFlags & u32(512)) != u32(0)
    val descriptorType = esp32InterruptDescriptorType(interrupt)
    if ((edgeRequested && descriptorType == u32(0)) ||
        (!edgeRequested && descriptorType == u32(1))) return false

    val vectorFlags = esp32InterruptVectorFlags(packed)
    if ((vectorFlags & u32(1)) != u32(0) ||
        (vectorFlags & u32(8)) != u32(0)) return false
