// Abla/LLVM implementation of the complete ESP32 interrupt vector allocator, shared ISR dispatch, reservation, IRAM classification, enable-disable, cross-core free, and diagnostic surface.

// Interrupts are installed both by the system initializers and by drivers
// after the scheduler starts.  The ordinary heap path takes a FreeRTOS-backed
// heap lock, which is not usable while those initializers are still running.
// Select the lock-free startup implementation only for that lifecycle phase;
// allocations retained past startup remain normal TLSF blocks and can be
// released through the locked path after the scheduler starts.
@inline
trusted fun esp32InterruptAllocatorSchedulerRunning(): bool {
    val core = cpuCoreId()
    return u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(
        esp32Data_port_xSchedulerRunning_2618692451 + (core << u32(2))
    )))) != u32(0)
}

@inline
trusted fun esp32InterruptAllocatorAllocate(
    size: u32,
    capabilities: u32
): u32 {
    val schedulerRunning = esp32InterruptAllocatorSchedulerRunning()
    return if (!schedulerRunning && (capabilities & u32(1)) == u32(0))
        esp32HeapCapsAllocateInterruptStartup(size, capabilities)
    else esp32HeapCapsMallocBase(size, capabilities)
}

@inline
trusted fun esp32InterruptAllocatorFreeValue(memory: u32): u32 {
    if (esp32InterruptAllocatorSchedulerRunning()) {
        esp32HeapCapsFree(memory)
    } else {
        esp32HeapCapsFreeBeforeScheduler(memory)
    }
    return u32(0)
}

