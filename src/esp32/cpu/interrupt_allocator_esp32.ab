    if (previous == u32(0)) {
        esp32InterruptAllocatorStoreU32(headAddress, toInsert)
    } else {
        esp32InterruptAllocatorStoreU32(previous + u32(12), toInsert)
    }
    return
}

trusted fun esp32InterruptGetVector(interrupt: u32, cpu: u32): u32 {
    val existing = esp32InterruptFindVector(interrupt, cpu)
    if (existing != u32(0)) return existing
    if (interrupt >= u32(32) || cpu >= u32(2)) return u32(0)
    // A vector descriptor is permanent in ESP-IDF: free only marks it
    // reusable and never releases it. Indexing a fixed pool by core/vector
    // removes heap use from early interrupt setup and guarantees uniqueness.
    val vector = esp32InterruptVectorPool +
        (((cpu << u32(5)) + interrupt) << u32(4))
    freestandingSet(vector, i32(0), u32(16))
    esp32InterruptAllocatorStoreU32(
        vector, esp32InterruptVectorPack(cpu, interrupt)
    )
    esp32InterruptInsertVector(vector)
    vector
}

