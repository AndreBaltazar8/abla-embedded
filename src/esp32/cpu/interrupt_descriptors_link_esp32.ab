import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCpuInterruptDescriptorsOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspCpuIntrGetDesc", "esp_cpu_intr_get_desc")) return false
    true
}
