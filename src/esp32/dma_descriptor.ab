import "../register.ab"
import "../dma.ab"
import "./dma_descriptor_logic.ab"

// Native 12-byte ESP peripheral-DMA descriptors. The descriptor and buffers
// must live in DMA-capable internal memory for the selected peripheral. These
// methods cannot prove that physical-memory property, so mutation is trusted.
@inline
fun DmaDescriptor.espWord(offset: int): Register32 =
    register32(this.addressValue() + offset)

@inline
trusted fun DmaDescriptor.flags(): int = this.espWord(0).read()

@inline
trusted fun DmaDescriptor.bufferAddress(): int = this.espWord(4).read()

@inline
trusted fun DmaDescriptor.nextDescriptor(): DmaDescriptor =
    dmaDescriptorAt(this.espWord(8).read())

@inline
trusted fun DmaDescriptor.capacity(): int =
    espDmaDescriptorCapacity(this.flags())

@inline
trusted fun DmaDescriptor.length(): int =
    espDmaDescriptorLength(this.flags())

@inline
trusted fun DmaDescriptor.successfulEof(): bool =
    espDmaDescriptorSuccessfulEof(this.flags())

@inline
trusted fun DmaDescriptor.ownedByDma(): bool =
    espDmaDescriptorOwnedByDma(this.flags())

// Buffer and link words are published before the ownership flag. This keeps
// the DMA engine from observing a partially initialized descriptor.
trusted fun DmaDescriptor.initializeRx(
    bufferAddress: int,
    capacity: int,
    next: DmaDescriptor
): bool {
    val packed = espDmaDescriptorPackFlags(capacity, 0, false, true)
    if (this.isNull() || !this.isAligned(4) ||
        !espDmaMemoryAddressValid(bufferAddress, false) ||
        !espDmaMemoryAddressValid(next.addressValue(), true) ||
        packed < 0) return false
    this.espWord(4).write(bufferAddress)
    this.espWord(8).write(next.addressValue())
    this.espWord(0).write(packed)
    true
}

trusted fun DmaDescriptor.initializeTx(
    bufferAddress: int,
    length: int,
    next: DmaDescriptor,
    successfulEof: bool
): bool {
    val packed = espDmaDescriptorPackFlags(
        length, length, successfulEof, true
    )
    if (this.isNull() || !this.isAligned(4) ||
        !espDmaMemoryAddressValid(bufferAddress, false) ||
        !espDmaMemoryAddressValid(next.addressValue(), true) ||
        packed < 0) return false
    this.espWord(4).write(bufferAddress)
    this.espWord(8).write(next.addressValue())
    this.espWord(0).write(packed)
    true
}

// Recycle a completed RX descriptor without changing its buffer or link.
// Ownership is again transferred by the final volatile flags write.
trusted fun DmaDescriptor.recycleRx(): bool {
    if (this.isNull() || !this.isAligned(4)) return false
    val packed = espDmaDescriptorPackFlags(
        this.capacity(), 0, false, true
    )
    if (packed < 0) return false
    this.espWord(0).write(packed)
    true
}

trusted fun DmaDescriptor.claimForCpu(): bool {
    if (this.isNull() || !this.isAligned(4)) return false
    this.espWord(0).clearBits(espDmaDescriptorOwnerMask)
    true
}

trusted fun DmaDescriptor.setNext(next: DmaDescriptor): bool {
    if (this.isNull() || !this.isAligned(4) ||
        !espDmaMemoryAddressValid(next.addressValue(), true)) return false
    this.espWord(8).write(next.addressValue())
    true
}
