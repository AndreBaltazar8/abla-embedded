import "./adc_calibration_p4_logic.ab"
// Read ONLY public calibration shadows: block1 version, block2 trim/ADC1
// reference, block10 ADC2 reference/channel compensation. No key-block reads,
// READ/PROGRAM commands, clock writes or fuse burning. Caller guarantees P4,
// loaded/error-checked shadows and excludes reload/sleep during these reads.
trusted fun p4AdcFuseField(base: int,bit: int,width: int): int {
    if ((base != 0x5c && base != 0x15c) || bit < 0 || width < 1 || width > 10 || bit+width > 256) return -1
    val offset=base+int(u32(bit)>>u32(5))*4
    val low=u32(bit&31)
    var value=p4AdcFuseRead(offset)>>low
    if (int(low)+width > 32) value=value|(p4AdcFuseRead(offset+4)<<(u32(32)-low))
    return int(value&((u32(1)<<u32(width))-u32(1)))
}
trusted fun esp32p4AdcReadCalibration(unit: int,channel: int,attenuation: int,shadowsReady: bool): P4AdcCalibration {
    if (!shadowsReady || channel < 0 || !((unit == 1 && channel < 8) || (unit == 2 && channel < 6)) || attenuation < 0 || attenuation > 3) return P4AdcCalibration(2)
    val version=p4AdcFuseRead(0x4c)&u32(0x1f00)
    if (version == u32(0)) return P4AdcCalibration(3)
    // Block10 read protection affects channel compensation for BOTH ADCs.
    // Do not interpret protected all-zero data as a valid calibration.
    if ((p4AdcFuseRead(0x30)&u32(64)) != u32(0)) return P4AdcCalibration(5)
    val initial=p4AdcFuseField(0x5c,128+(unit-1)*40+attenuation*10,10)
    val reference=p4AdcFuseField(if (unit == 1) 0x5c else 0x15c,(if (unit == 1) 208 else 0)+attenuation*10,10)
    val difference=p4AdcFuseField(0x15c,(if (unit == 1) 40 else 72)+channel*4,4)
    return esp32p4AdcCalibrationFromFields(unit,channel,attenuation,1,initial,reference,difference)
}
