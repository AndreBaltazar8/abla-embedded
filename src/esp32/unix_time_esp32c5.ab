import "../time/unix_clock52.ab"
import "./timer_esp32c5.ab"
// Opt-in freestanding clock, not compatible with a second SDK wall clock.
// Caller serializes all setters/readers AND SYSTIMER0 snapshots, keeps timer
// advancing at a stable supplied rate, and reconfigures after reset/rate change.
// Does not initialize/reset/enable SYSTIMER, own its alarms, or invent its rate.
val c5UnixClockStorage=nativeStaticMutableU32s([0,0,0,0,0,0,0,0])
var c5UnixClockRate=0
var c5UnixClockPolls=0
trusted fun esp32C5ConfigureUnixClock(ticksPerSecond: int,polls: int = 64): bool {
    if (ticksPerSecond < 1 || ticksPerSecond > 4294967295 || polls < 1 || polls > 1000000) return false
    nativeAddressStoreU32(c5UnixClockStorage,0,0)
    c5UnixClockRate=ticksPerSecond; c5UnixClockPolls=polls
    true
}
trusted fun setUnixTimeSeconds(seconds: int): bool {
    if (c5UnixClockRate == 0 || seconds < 0 || seconds > 253402300799) return false
    unixClock52At(nativeBufferAt(c5UnixClockStorage,32)).setAt(seconds,esp32C5TimerTicks(0,c5UnixClockPolls),c5UnixClockRate)
}
trusted fun unixTimeSeconds(): int {
    if (c5UnixClockRate == 0) return -1
    unixClock52At(nativeBufferAt(c5UnixClockStorage,32)).secondsAt(esp32C5TimerTicks(0,c5UnixClockPolls))
}
