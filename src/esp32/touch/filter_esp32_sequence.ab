import "./scan_esp32_sequence.ab"
import "../../input/capacitive_filter.ab"
// Channel must belong to this completed scan. A pending/invalid scan yields
// rejected update without register access, preserving history but not edges.
// Keep controller ownership; copying a token does not acquire a second lease.
trusted fun CapacitiveTouchFilter.updateFrom(scan: Esp32TouchScan,channel: int,threshold: int,below: bool = true): CapacitiveTouchFilter {
    if (threshold < 0 || threshold > 65535) return this.update(-1,threshold,below)
    this.update(scan.readRawOwned(channel),threshold,below)
}
