import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTouchSensHalOpaqueCallers(): bool {
    if (!internalFunction("esp32TouchConfigureController", "touch_hal_config_controller")) return false
    if (!internalFunction("esp32TouchSaveSleepConfiguration", "touch_hal_save_sleep_config")) return false
    if (!exportFunction("esp32TouchPrepareDeepSleep", "touch_hal_prepare_deep_sleep")) return false
    true
}
