// Allocation-free hardware timing, derived from caller-known awake RTC clock
// frequencies. Classic ESP32 touch has no separate module power/clock gate.
// LP dynamic fast clock switches during sleep: these profiles are awake-only.
type Esp32TouchTiming = int
fun Esp32TouchTiming.valid(): bool = this >= (1<<40) && this < (1<<41) && this.chargeTicks() > 0
fun Esp32TouchTiming.waitTicks(): int = this&255
fun Esp32TouchTiming.chargeTicks(): int = (this>>8)&65535
fun Esp32TouchTiming.intervalTicks(): int = (this>>24)&65535
// Exact integer conversion, rounding down to hardware ticks. Wait/charge
// saturate at255/65535 as IDF; an overflowing interval is rejected, not wrapped.
// Inputs bounded before multiplication (largest product <2^57). No float ABI.
fun esp32TouchTimingFromMicroseconds(fastHz: int,slowHz: int,waitUs: int,chargeUs: int,intervalUs: int): Esp32TouchTiming {
    if (fastHz < 1000000 || fastHz > 40000000 || slowHz < 1 || slowHz > 1000000 || waitUs < 0 || waitUs > 2147483647 ||
        chargeUs < 1 || chargeUs > 2147483647 || intervalUs < 0 || intervalUs > 2147483647) return Esp32TouchTiming(0)
    val wait=waitUs*fastHz/1000000
    val charge=chargeUs*fastHz/1000000
    val interval=intervalUs*slowHz/1000000
    if (interval > 65535) return Esp32TouchTiming(0)
    Esp32TouchTiming((1<<40)|(if (wait > 255) 255 else wait)|((if (charge > 65535) 65535 else charge)<<8)|(interval<<24))
}
// M5Unified profile:256us power wait,5ms charge,320us interval. Match pinned
// IDF v6.0.2's whole-MHz conversion of the fast clock; do not
// silently apply this truncation to the general physical-duration API above.
fun esp32TouchTimingM5Classic(fastHz: int,slowHz: int): Esp32TouchTiming {
    if (fastHz < 1000000 || fastHz > 40000000) return Esp32TouchTiming(0)
    esp32TouchTimingFromMicroseconds((fastHz/1000000)*1000000,slowHz,256,5000,320)
}
