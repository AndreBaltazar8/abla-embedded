import "./scan_esp32_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_touch.ab"
@export("touchScanRead")
trusted fun touchScanReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("touchScanWrite")
trusted fun touchScanWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value)); return }
