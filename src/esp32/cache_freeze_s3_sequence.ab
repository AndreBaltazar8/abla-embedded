// S3 cache LL order I then D; ROM WAITI workaround additionally waits for
// CACHE_STATE == 1 after EACH ROM freeze. All code/data/stack must be internal,
// other core and relevant interrupts quiesced, exclusive cache ownership held.
// Does NOT itself acquire those resources. ROM freeze may wait internally;
// idlePolls bounds only the additional erratum wait, not the entire operation.
@section(".iram1.abla.s3CacheIdle")
trusted fun esp32S3CacheIdleOwned(instruction: bool,idlePolls: int): bool {
    var remaining=idlePolls
    while (remaining > 0) {
        val state=esp32S3CacheFreezeRead(0x600C4130)
        if (((state>>>(if (instruction) 0 else 12)) & 4095) == 1) return true
        remaining=remaining-1
    }
    false
}

// 0 invalid; 1 both frozen; 2 already owned/frozen; 3 I-idle timeout;
// 4 D-idle timeout. Failures release only freezes acquired by this operation.
@section(".iram1.abla.s3CacheFreeze")
trusted fun esp32S3CachesFreezeOwned(idlePolls: int): int {
    if (idlePolls <= 0 || idlePolls > 0x7FFFFFFF) return 0
    if ((esp32S3CacheFreezeRead(0x600C4154) & 1) != 0 ||
        (esp32S3CacheFreezeRead(0x600C4150) & 1) != 0) return 2
    esp32S3CacheRomFreeze(true)
    if (!esp32S3CacheIdleOwned(true,idlePolls)) {
        esp32S3CacheRomUnfreeze(true)
        return 3
    }
    esp32S3CacheRomFreeze(false)
    if (!esp32S3CacheIdleOwned(false,idlePolls)) {
        esp32S3CacheRomUnfreeze(true)
        esp32S3CacheRomUnfreeze(false)
        return 4
    }
    1
}

// Only after this owner obtained status1 and has completed timing/register work.
@section(".iram1.abla.s3CacheUnfreeze")
trusted fun esp32S3CachesUnfreezeOwned(): void {
    esp32S3CacheRomUnfreeze(true)
    esp32S3CacheRomUnfreeze(false)
    return
}
