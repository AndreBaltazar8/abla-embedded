// Requires canonical RCC lock. Shared bus enable never pulses reset or
// rewrites group clocks; existing channel configuration is preserved.
trusted fun esp32s3RmtEnableBusClockLocked(): void {
    val clock = esp32s3RmtRead(0x600c0018)
    if ((clock & 512) == 0) esp32s3RmtWrite(0x600c0018, clock | 512)
    val reset = esp32s3RmtRead(0x600c0020)
    if ((reset & 512) != 0) esp32s3RmtWrite(0x600c0020, reset & 0xfffffdff)
    return
}

// Caller owns ALL stopped RMT channels and holds RCC lock; group clock must
// already be inactive. Source1=APB,2=RC_FAST,3=XTAL. Source power/stability is
// caller-owned. Clock = source/(integer+numerator/denominator), no approximation.
// Integer-only mode accepts denominator0; no implicit enable or memory reset.
trusted fun esp32s3RmtConfigureClockLocked(source: int, integer: int,
    numerator: int, denominator: int): bool {
    if (source < 1 || source > 3 || integer < 1 || integer > 256 ||
        numerator < 0 || numerator > 63 || denominator < 0 || denominator > 63 ||
        (numerator != 0 && numerator >= denominator)) return false
    val prior = esp32s3RmtRead(0x600160c0)
    if ((prior & 0x04000000) != 0) return false
    // HAL names DIV_A=numerator and DIV_B=denominator (not vice versa).
    val fields = ((integer - 1) << 4) | (numerator << 12) |
        (denominator << 18) | (source << 24)
    esp32s3RmtWrite(0x600160c0, (prior & 0xfc00000f) | fields)
    true
}
