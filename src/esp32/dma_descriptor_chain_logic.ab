val espDmaDescriptorChainCountMask = 4095
val espDmaDescriptorChainIndexMask = 4095
val espDmaDescriptorChainCountShift = 32
val espDmaDescriptorChainIndexShift = 44

fun espDmaDescriptorChainPack(
    descriptorBase: int,
    descriptorCount: int,
    currentIndex: int
): int {
    if (descriptorBase <= 0 || descriptorBase > 4294967295 ||
        (descriptorBase / 4) * 4 != descriptorBase || descriptorCount <= 0 ||
        descriptorCount > espDmaDescriptorChainCountMask ||
        currentIndex < 0 || currentIndex > descriptorCount) return -1
    descriptorBase |
        (descriptorCount << espDmaDescriptorChainCountShift) |
        (currentIndex << espDmaDescriptorChainIndexShift)
}

@inline
fun espDmaDescriptorChainBase(value: int): int = value & 4294967295

@inline
fun espDmaDescriptorChainCount(value: int): int =
    (value >>> espDmaDescriptorChainCountShift) &
        espDmaDescriptorChainCountMask

@inline
fun espDmaDescriptorChainIndex(value: int): int =
    (value >>> espDmaDescriptorChainIndexShift) &
        espDmaDescriptorChainIndexMask

fun espDmaDescriptorChainLayoutValid(
    descriptorBase: int,
    descriptorCount: int,
    bufferBase: int,
    bufferStride: int,
    bufferCapacity: int
): bool {
    if (espDmaDescriptorChainPack(
        descriptorBase, descriptorCount, 0
    ) < 0 || bufferBase <= 0 || bufferBase > 4294967295 ||
        (bufferBase / 4) * 4 != bufferBase ||
        bufferStride < bufferCapacity ||
        (bufferStride / 4) * 4 != bufferStride || bufferCapacity <= 0 ||
        bufferCapacity > 4095) return false
    val descriptorBytes = (descriptorCount - 1) * 12
    val bufferBytes = (descriptorCount - 1) * bufferStride +
        bufferCapacity - 1
    descriptorBase <= 4294967295 - descriptorBytes &&
        bufferBase <= 4294967295 - bufferBytes
}
