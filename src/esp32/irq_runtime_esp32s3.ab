import "./irq_runtime_s3_sequence.ab"
import "./irq_stack_esp32s3.ab"
import "./interrupt_dispatch_esp32s3.ab"
import "abla/unsafe/native"
// Four32bit C-ABI arguments match the assembly CALL4 boundary exactly.
@section(".iram1.abla.s3IrqRuntimeCallback")
trusted fun esp32S3IrqRuntimeCallback(frame: u32,level: u32,core: u32,record: u32): void {
    esp32S3IrqRuntimeDispatch(int(frame),int(level),int(core),int(record))
    return
}
@inline
trusted fun esp32S3IrqRuntimeAddress(): int = nativeFunctionAddress(esp32S3IrqRuntimeCallback)
@inline
trusted fun esp32S3IrqRuntimeRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3IrqRuntimeWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3IrqRuntimeCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3IrqRuntimeEnabled(): int = esp32S3IrqStackEnabled()
@inline
trusted fun esp32S3IrqRuntimeConfig(): int = esp32S3IrqConfigAddress()
@inline
trusted fun esp32S3IrqRuntimeDrain(table: NativeBuffer,core: int,level: int): int = esp32S3InterruptDispatchOwned(table,core,level)
@inline
trusted fun esp32S3IrqRuntimeFault(callback: int,frame: int,status: int,context: int): void {
    callNativeVoidI32I32I32(callback,frame,status,context)
    return
}
@inline
trusted fun esp32S3IrqRuntimeStackInit(stack: NativeBuffer,core: int,callback: int,context: int): bool = esp32S3IrqStackInitializeOwned(stack,core,callback,context)
@inline
trusted fun esp32S3IrqRuntimeStackRelease(core: int): bool = esp32S3IrqStackReleaseOwned(core)
