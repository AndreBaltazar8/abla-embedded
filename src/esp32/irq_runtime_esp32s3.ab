import "./irq_runtime_s3_sequence.ab"
import "./irq_stack_esp32s3.ab"
import "./interrupt_dispatch_esp32s3.ab"
import "abla/unsafe/native"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
// Four32bit C-ABI arguments match the assembly CALL4 boundary exactly.
@section(".iram1.abla.s3IrqRuntimeCallback")
trusted fun esp32S3IrqRuntimeCallback(frame: u32,level: u32,core: u32,record: u32): void {
    esp32S3IrqRuntimeDispatch(int(frame),int(level),int(core),int(record))
    return
}
@inline
@export("esp32S3IrqRuntimeAddress")
trusted fun esp32S3IrqRuntimeAddressHook(): int = nativeFunctionAddress(esp32S3IrqRuntimeCallback)
@inline
@export("esp32S3IrqRuntimeRead")
trusted fun esp32S3IrqRuntimeReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3IrqRuntimeWrite")
trusted fun esp32S3IrqRuntimeWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
@export("esp32S3IrqRuntimeCore")
trusted fun esp32S3IrqRuntimeCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3IrqRuntimeEnabled")
trusted fun esp32S3IrqRuntimeEnabledHook(): int = esp32S3IrqStackEnabled()
@inline
@export("esp32S3IrqRuntimeConfig")
trusted fun esp32S3IrqRuntimeConfigHook(): int = esp32S3IrqConfigAddress()
@inline
@export("esp32S3IrqRuntimeDrain")
trusted fun esp32S3IrqRuntimeDrainHook(table: NativeBuffer,core: int,level: int): int = esp32S3InterruptDispatchOwned(table,core,level)
@inline
@export("esp32S3IrqRuntimeFault")
trusted fun esp32S3IrqRuntimeFaultHook(callback: int,frame: int,status: int,context: int): void {
    callNativeVoidI32I32I32(callback,frame,status,context)
    return
}
@inline
@export("esp32S3IrqRuntimeStackInit")
trusted fun esp32S3IrqRuntimeStackInitHook(stack: NativeBuffer,core: int,callback: int,context: int): bool = esp32S3IrqStackInitializeOwned(stack,core,callback,context)
@inline
@export("esp32S3IrqRuntimeStackRelease")
trusted fun esp32S3IrqRuntimeStackReleaseHook(core: int): bool = esp32S3IrqStackReleaseOwned(core)
