import "./sdk/raw_buffer.ab"
// Final scheduler commit inside outermost IRQ callback AFTER interrupt draining,
// never from a leaf handler while more callbacks may run. Integer/CP ownership
// and current-task binding must already be transferred under scheduler lock.
// Both task frames/stacks remain live; caller returns immediately after commit.
// Frame152 tags originating IRQ level;156 is a one-shot selected-frame pointer.
// Nested interrupts always return to their original frame. Selection leaves
// ordinary RFE/RFIn return unchanged when unused; task selection uses RFE with
// the selected PC/PS (including clearing EXCM on first-task frames).
@inline
fun esp32S3IrqResumeFrameValid(frame: NativeBuffer): bool = frame.hasAddressRange(0,192) &&
    frame.addressValue() >= 0x3FC88000 && frame.addressValue() <= 0x3FCFFF40 && (frame.addressValue() & 15) == 0
@section(".iram1.abla.s3IrqResumeSelect")
trusted fun esp32S3IrqResumeSelectOwned(interrupted: NativeBuffer,next: NativeBuffer,core: int,level: int): bool {
    if (core < 0 || core > 1 || level < 1 || level > 3 || esp32S3IrqResumeCore() != core ||
        (esp32S3IrqResumeStatus() & 0x4001F) != 0x4000F || !esp32S3IrqResumeFrameValid(interrupted) || !esp32S3IrqResumeFrameValid(next)) return false
    val old=interrupted.addressValue()
    val selected=next.addressValue()
    if (old < selected+192 && selected < old+192) return false
    val cfg=esp32S3IrqResumeConfig()+core*32
    if (esp32S3IrqResumeRead(cfg+4) != 1 || esp32S3IrqResumeRead(old+152) != level ||
        esp32S3IrqResumeRead(old+156) != 0 || esp32S3IrqResumeRead(old+148) != 0 || esp32S3IrqResumeRead(selected+148) != 0) return false
    val low=esp32S3IrqResumeRead(cfg+16)
    val end=esp32S3IrqResumeRead(cfg+20)
    if ((old < end && low < old+192) || (selected < end && low < selected+192)) return false
    val pc=esp32S3IrqResumeRead(selected+4)
    if (pc < 0x40370000 || pc >= 0x403E0000 ||
        (esp32S3IrqResumeRead(selected+8) & 0x40020) != 0x40020 || esp32S3IrqResumeRead(selected+16) != selected+192) return false
    esp32S3IrqResumeWrite(old+156,selected)
    true
}
