import "./mspi_timing_c5_sequence.ab"
// Protocol dummy fields, separate from timing-calibration extra dummy.
// Targets0/1 flash SPI0/1;2/3 PSRAM read/write on SPI0.
// lengthField is the raw six-bit encoding (enabled length is field+1).
// Flash units are serial clocks; PSRAM register documents bits. Conversion
// for the selected bus protocol belongs to its owner, not this register layer.
@inline
fun c5MspiDummyBase(target: int): int = if (target < 2) 0x60002000+int(u32(target)<<u32(12)) else 0x60002000
@inline
fun c5MspiDummyShift(target: int): int = if (target < 2) 0 else if (target == 2) 6 else 22
@inline
fun c5MspiDummyEnableMask(target: int): int = if (target < 2) 0x20000000 else if (target == 2) 16 else 8
//40B lease:tag0,status4,stage8,target12,plan16(length6/enabled bit6/
// flash-variable bit7),saved length20/enable24/variable28,close stage32,res36.
//1applied2invalid3partial4closed; internal5closing blocks reapplication.
// No transaction/cache/reset/timing UPDATE/ROM-state mutation. Caller owns
// both controllers/cache/DMA/ROM command users and keeps everything quiescent,
// with caches off and retained closure/stack/record until full restoration.
// Variable dummy only controls FMEM_VAR_DUMMY; it does not enable DDR or
// program the memory chip's latency register. PSRAM variable mode not owned.
@section(".iram1.abla.c5MspiDummyApply")
trusted fun esp32C5MspiDummyOwned(record: NativeBuffer,target: int,lengthField: int,enabled: bool,variableDummy: bool,exclusiveCacheOff: bool): int {
    if (!exclusiveCacheOff || !record.hasAddressRange(0,40) || (record.addressValue()&3) != 0 ||
        target < 0 || target > 3 || lengthField < 0 || lengthField > 63 || (target >= 2 && variableDummy)) return 2
    val plan=lengthField|(if (enabled) 64 else 0)|(if (variableDummy) 128 else 0)
    val tag=c5SleepRecordRead(record,0)
    if (tag != 0 && tag != 0x434d4431) return 2
    if (tag != 0) {
        if (c5SleepRecordRead(record,12) != target || c5SleepRecordRead(record,16) != plan) return 2
        if (c5SleepRecordRead(record,4) == 1) return 1
        if (c5SleepRecordRead(record,4) != 3 || c5SleepRecordRead(record,8) > 2) return 2
    }
    if (!c5MspiTimingReady()) return if (tag == 0) 2 else 3
    val base=c5MspiDummyBase(target);val shift=c5MspiDummyShift(target)
    val lengthAddress=base+(if (target < 2) 0x1c else 0x40)
    val enableAddress=base+(if (target < 2) 0x18 else 0x40)
    val lengthMask=int(u32(63)<<u32(shift));val enableMask=c5MspiDummyEnableMask(target)
    if (tag == 0) {
        c5SleepRecordWrite(record,12,target);c5SleepRecordWrite(record,16,plan)
        c5SleepRecordWrite(record,20,c5MspiRead(lengthAddress)&lengthMask)
        c5SleepRecordWrite(record,24,c5MspiRead(enableAddress)&enableMask)
        c5SleepRecordWrite(record,28,if (target < 2) c5MspiRead(base+0xd4)&2 else 0)
        c5SleepRecordWrite(record,8,0);c5SleepRecordWrite(record,32,0);c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,0,0x434d4431)
    }
    val stage=c5SleepRecordRead(record,8)
    if (stage <= 0) {
        if (!c5MspiTimingField(lengthAddress,lengthMask,int(u32(lengthField)<<u32(shift)))) return 3
        c5SleepRecordWrite(record,8,1)
    }
    if (stage <= 1) {
        if (!c5MspiTimingField(enableAddress,enableMask,if (enabled) enableMask else 0)) return 3
        c5SleepRecordWrite(record,8,2)
    }
    if (target < 2 && !c5MspiTimingField(base+0xd4,2,if (variableDummy) 2 else 0)) return 3
    c5SleepRecordWrite(record,8,3);c5SleepRecordWrite(record,4,1)
    1
}
@section(".iram1.abla.c5MspiDummyClose")
trusted fun esp32C5MspiDummyCloseOwned(record: NativeBuffer,exclusiveCacheOff: bool): int {
    if (!exclusiveCacheOff || !record.hasAddressRange(0,40) || (record.addressValue()&3) != 0 || c5SleepRecordRead(record,0) != 0x434d4431) return 2
    val state=c5SleepRecordRead(record,4);val target=c5SleepRecordRead(record,12)
    if (state == 4) return 4
    if ((state != 1 && state != 3 && state != 5) || target > 3 || c5SleepRecordRead(record,32) > 2) return 2
    c5SleepRecordWrite(record,4,5)
    if (!c5MspiTimingReady()) return 3
    val base=c5MspiDummyBase(target);val stage=c5SleepRecordRead(record,32)
    if (stage <= 0) {
        if (target < 2 && !c5MspiTimingField(base+0xd4,2,c5SleepRecordRead(record,28))) return 3
        c5SleepRecordWrite(record,32,1)
    }
    if (stage <= 1) {
        if (!c5MspiTimingField(base+(if (target < 2) 0x18 else 0x40),c5MspiDummyEnableMask(target),c5SleepRecordRead(record,24))) return 3
        c5SleepRecordWrite(record,32,2)
    }
    if (!c5MspiTimingField(base+(if (target < 2) 0x1c else 0x40),int(u32(63)<<u32(c5MspiDummyShift(target))),c5SleepRecordRead(record,20))) return 3
    c5SleepRecordWrite(record,32,3);c5SleepRecordWrite(record,4,4)
    4
}
