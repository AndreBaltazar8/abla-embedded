import "./adc2_oneshot_s3_sequence.ab"
import "abla/unsafe/mmio"
trusted fun esp32S3Adc2Read(offset: int): int = mmioLoadU32(0x60008800+offset)
trusted fun esp32S3Adc2Write(offset: int,value: int): void { mmioStoreU32(0x60008800+offset,value); return }
trusted fun esp32S3Adc2ArbiterRead(): int = mmioLoadU32(0x60040038)
