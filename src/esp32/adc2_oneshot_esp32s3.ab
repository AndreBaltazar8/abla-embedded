import "./adc2_oneshot_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("esp32S3Adc2Read")
trusted fun esp32S3Adc2ReadHook(offset: int): int = mmioLoadU32(0x60008800+offset)
@export("esp32S3Adc2Write")
trusted fun esp32S3Adc2WriteHook(offset: int,value: int): void { mmioStoreU32(0x60008800+offset,value); return }
@export("esp32S3Adc2ArbiterRead")
trusted fun esp32S3Adc2ArbiterReadHook(): int = mmioLoadU32(0x60040038)
