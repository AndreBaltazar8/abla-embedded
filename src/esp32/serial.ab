import "abla/unsafe/mmio"

// UART0 is configured by the ESP32 startup code. This implementation writes
// its FIFO directly and therefore does not depend on Arduino's Serial object.
val esp32Uart0Base = 1072955392
val esp32UartFifo = esp32Uart0Base
val esp32UartStatus = esp32Uart0Base + 28

type SerialPort = int

fun serial(unit: int = 0): SerialPort = SerialPort(unit)

trusted fun SerialPort.writeByte(value: int): void {
    if (this == 0) {
        var full = true
        while (full) {
            val status = mmioLoadU32(esp32UartStatus)
            val count = (status / 65536) & 255
            full = count >= 127
        }
        mmioStoreU32(esp32UartFifo, value & 255)
    }
}

trusted fun SerialPort.write(text: string): void {
    var index = 0
    while (index < text.size) {
        this.writeByte(text[index])
        index = index + 1
    }
}

trusted fun SerialPort.line(text: string): void {
    this.write(text)
    this.writeByte(10)
}
