import "./sdk/raw_buffer.ab"
import "./interrupt_capabilities_s3.ab"
// Existing dual-core Xtensa dispatcher layout:32 lines x2 cores x8bytes.
// Caller exclusively owns entry and supplies the actual initialized dispatcher
// table. Run on destination core with this line disabled; no vector creation.
// Save old handler/argument to caller-owned8byte storage before publication.
// No allocation, enabling, source ack, or implicit lifetime management.
@section(".iram1.abla.s3InterruptInstall")
trusted fun esp32S3InterruptInstallOwned(table: NativeBuffer,previous: NativeBuffer,core: int,line: int,handler: int,argument: int): bool {
    if (!table.hasAddressRange(0,512) || !previous.hasAddressRange(0,8) ||
        (table.addressValue() & 3) != 0 || (previous.addressValue() & 3) != 0 ||
        core < 0 || core > 1 || !esp32S3InterruptSupportsNativeHandler(line) ||
        handler <= 0 || handler > 0xFFFFFFFF || argument < 0 || argument > 0xFFFFFFFF) return false
    val base=table.addressValue()
    val save=previous.addressValue()
    if (save < base+512 && base < save+8) return false
    if (esp32S3InterruptInstallCore() != core || ((esp32S3InterruptInstallEnabled()>>>line) & 1) != 0) return false
    val entry=base+line*16+core*8
    val oldHandler=esp32S3InterruptInstallRead(entry)
    val oldArgument=esp32S3InterruptInstallRead(entry+4)
    esp32S3InterruptInstallWrite(save,oldHandler)
    esp32S3InterruptInstallWrite(save+4,oldArgument)
    esp32S3InterruptInstallWrite(entry+4,argument)
    esp32S3InterruptInstallWrite(entry,handler)
    true
}

// Restore only if the disabled current-core entry is still the pair we own.
// Zero in the saved original handler is permitted; it is not a new callback.
trusted fun esp32S3InterruptRestoreOwned(table: NativeBuffer,previous: NativeBuffer,core: int,line: int,handler: int,argument: int): bool {
    if (!table.hasAddressRange(0,512) || !previous.hasAddressRange(0,8) ||
        (table.addressValue() & 3) != 0 || (previous.addressValue() & 3) != 0 ||
        core < 0 || core > 1 || !esp32S3InterruptSupportsNativeHandler(line) ||
        handler <= 0 || handler > 0xFFFFFFFF || argument < 0 || argument > 0xFFFFFFFF) return false
    val base=table.addressValue()
    val save=previous.addressValue()
    if (save < base+512 && base < save+8) return false
    if (esp32S3InterruptInstallCore() != core || ((esp32S3InterruptInstallEnabled()>>>line) & 1) != 0) return false
    val entry=base+line*16+core*8
    if (esp32S3InterruptInstallRead(entry) != handler || esp32S3InterruptInstallRead(entry+4) != argument) return false
    val oldHandler=esp32S3InterruptInstallRead(save)
    val oldArgument=esp32S3InterruptInstallRead(save+4)
    esp32S3InterruptInstallWrite(entry+4,oldArgument)
    esp32S3InterruptInstallWrite(entry,oldHandler)
    true
}
