import "./sdk/raw_buffer.ab"
// Caller-owned local40 bytes: IRQ record0..15, exception policy16..39.
// Shared544 bytes for both cores: lock0, reserved4..15, CP owners16..31,
// IRQ dispatcher32..543. Initialize shared storage before either core setup;
// never zero it during peer setup. Both cores finish setup before task launch.
// Common context is passed to IRQ fault(frame,status,context), exception
// fallback(frame,cause,core,context), resolver(core,cp,context).
// Caller serializes boot and owns disjoint local records, stacks and live task
// data. No allocation, task creation, IRQ enable, reset or flash/cache setup.
// 1 ready;0 invalid;-1 IRQ setup refused;-2 policy refused;-3 activation
// refused;-4 cleanup contract violated (do not release/reuse runtime storage).
// On ordinary failure, registrations are removed, but record contents may be
// initialized and matrix writes are not rolled back. Old VECBASE stays active.
@section(".iram1.abla.s3RuntimePrepare")
trusted fun esp32S3RuntimePrepareOwned(stack: NativeBuffer,local: NativeBuffer,shared: NativeBuffer,core: int,irqFault: int,exceptionFault: int,resolver: int,context: int): int {
    if (core < 0 || core > 1 || esp32S3RuntimePrepareCore() != core || esp32S3RuntimePrepareEnabled() != 0 ||
        !stack.hasAddressRange(0,1024) || (stack.addressValue() & 15) != 0 || (stack.capacity() & 15) != 0 ||
        stack.addressValue() < 0x3FC88000 || stack.addressValue()+stack.capacity() > 0x3FD00000 ||
        !local.hasAddressRange(0,40) || local.addressValue() < 0x3FC88000 || local.addressValue() > 0x3FCFFFD8 || (local.addressValue() & 3) != 0 ||
        !shared.hasAddressRange(0,544) || shared.addressValue() < 0x3FC88000 || shared.addressValue() > 0x3FCFFDE0 || (shared.addressValue() & 3) != 0 ||
        irqFault < 0x40370000 || irqFault >= 0x403E0000 || (irqFault & 3) != 0 ||
        exceptionFault < 0x40370000 || exceptionFault >= 0x403E0000 || (exceptionFault & 3) != 0 ||
        resolver < 0x40370000 || resolver >= 0x403E0000 || (resolver & 3) != 0 || context < 0 || context > 0xFFFFFFFF) return 0
    val a=local.addressValue()
    val b=shared.addressValue()
    val low=stack.addressValue()
    val end=low+stack.capacity()
    if ((a < b+544 && b < a+40) || (a < end && low < a+40) || (b < end && low < b+544)) return 0
    val irq=nativeBufferAt(a,16)
    val policy=nativeBufferAt(a+16,24)
    if (!esp32S3RuntimePrepareIrq(stack,nativeBufferAt(b+32,512),irq,core,irqFault,context)) return -1
    if (!esp32S3RuntimePreparePolicy(policy,nativeBufferAt(b+16,16),nativeBufferAt(b,4),core,exceptionFault,context,resolver)) {
        if (!esp32S3RuntimePrepareIrqRemove(irq,core)) return -4
        return -2
    }
    if (esp32S3RuntimePrepareActivate(core)) return 1
    // Activation publishes VECBASE only on success. Removing callbacks here
    // therefore cannot leave the CPU using this table with revoked handlers.
    if (!esp32S3RuntimePreparePolicyRemove(policy,core)) return -4
    if (!esp32S3RuntimePrepareIrqRemove(irq,core)) return -4
    return -3
}
