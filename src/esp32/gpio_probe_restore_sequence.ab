import "./gpio_probe_logic.ab"

// Caller owns the pad, routing and configuration serialization throughout.
// Disable the temporary output before restoring its latch/pulls/drive. If any
// prerequisite fails, do not re-enable a potentially misconfigured output;
// the immutable snapshot remains available to retry restoration.
trusted fun GpioProbePinState.restore(pin: int): bool {
    if (!gpioProbeStateValid(this)) return false
    if (gpio_set_direction(pin, 0) != 0) return false
    var restored = true
    if (gpio_set_level(pin, if (gpioProbeStateLevel(this)) 1 else 0) != 0) restored = false
    if (gpio_set_pull_mode(pin, gpioProbePullMode(this)) != 0) restored = false
    if (gpio_set_drive_capability(pin, gpioProbeStateDrive(this)) != 0) restored = false
    if (!restored) return false
    return gpio_set_direction(pin, gpioProbeDirection(this)) == 0
}
