// ESP-IDF6.0.2 C5 curve_fitting_coefficients.c / adc_cali_curve_fitting.c.
import "./adc_calibration_c5_logic.ab"
// Exact floor(x*k/d) without 64-bit division. Internal bounded inputs:
// k<d<=1e16; x<8192 (linear) or x<2^25 (quadratic).
fun c5AdcCurveTerm(x: u32,k: int,d: int,highestBit: u32): int {
    var remainder=0
    var quotient=u32(0)
    var bit=highestBit
    while (bit != u32(0)) {
        remainder=remainder+remainder
        quotient=quotient<<u32(1)
        if ((x&bit) != u32(0)) remainder=remainder+k
        if (remainder >= d) { remainder=remainder-d;quotient=quotient+u32(1) }
        if (remainder >= d) { remainder=remainder-d;quotient=quotient+u32(1) }
        bit=bit>>u32(1)
    }
    return int(quotient)
}
fun C5AdcCalibration.millivolts(raw: int): int {
    val adjusted=this.compensatedRaw(raw)
    if (adjusted < 0) return -1
    val attenuation=this.attenuation()
    val slope=(u32(this.referenceMillivolts())<<u32(16))/u32(this.referenceCode())
    // Max first step5264, product fits u32. Preserve both Q16 truncations.
    val first=(u32(adjusted)*slope)>>u32(16)
    if (first == u32(0)) return 0
    val coefficient=if (attenuation == 0) 7368674918527 else if (attenuation == 1) 5325658467636 else if (attenuation == 2) 409244304226 else 3349642363147
    val denominator=if (attenuation < 2) 10000000000000000 else 1000000000000000
    val linear=c5AdcCurveTerm(first,coefficient,denominator,u32(4096))
    // K0 truncates to0 for atten0..2; atten3 is +1,-linear,+quadratic.
    if (attenuation < 3) return int(first)-linear
    val quadratic=c5AdcCurveTerm(first*first,11676836451,10000000000000000,u32(16777216))
    return int(first)-1+linear-quadratic
}
