// S3 cpu_start.c / cpu_utility_ll.h secondary-core hardware release sequence.
// BOOT ONLY: caller owns the other core, known waiting in ROM (not a running
// application), verified dual-core chip, shared RTC/SYSTEM registers, and an
// IRAM entry trampoline that establishes stack/vectors/runtime itself.
// A true return means the entry was published, NOT that CPU1 acknowledged it.
// Caller must provide its own startup handshake before using peer services.
@inline
trusted fun esp32S3AppCpuUpdate(address: int,mask: int,value: int): void {
    esp32S3AppCpuWrite(address,(esp32S3AppCpuRead(address) & (0xFFFFFFFF ^ mask)) | (value & mask))
    return
}
@section(".iram1.abla.s3AppCpuRelease")
trusted fun esp32S3AppCpuReleaseRomOwned(entry: int,coreCount: int): bool {
    if (coreCount != 2 || entry < 0x40370000 || entry >= 0x403E0000 || (entry & 3) != 0 || esp32S3AppCpuCurrentCore() != 0) return false
    // Clear only APPCPU's split RTC stall fields; PROCPU remains untouched.
    esp32S3AppCpuUpdate(0x60008000,3,0)
    esp32S3AppCpuUpdate(0x600080BC,0x03F00000,0)
    // Preserve an already enabled/debugger-started core and its breakpoints.
    // It must still be waiting in ROM as required by this function's contract.
    if ((esp32S3AppCpuRead(0x600C0000) & 2) == 0) {
        esp32S3AppCpuUpdate(0x600C0000,2,2)
        esp32S3AppCpuUpdate(0x600C0000,1,0)
        esp32S3AppCpuUpdate(0x600C0000,4,4)
        esp32S3AppCpuUpdate(0x600C0000,4,0)
    }
    esp32S3AppCpuPublishEntry(entry)
    true
}
