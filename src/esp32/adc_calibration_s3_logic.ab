// IDF v6.0.2 esp32s3 esp_efuse_table.c + esp_efuse_rtc_calib.c.
// Inputs are read-shadow WORDS, not guessed classicESP32 calibration fields.
// BLOCK2 major version must1. Init codes program analog trim; they are NOT
// the digital reading at850mV used by voltage characterization.
import "./adc_curve_s3_logic.ab"
fun esp32S3AdcInitCode(unit: int,attenuation: int,w4: int,w5: int,w6: int): int {
    if ((w4&3) != 1 || unit < 1 || unit > 2 || attenuation < 0 || attenuation > 3) return -1
    var code=if (unit == 1) 1850+((w4>>21)&255) else 2020+((w5>>15)&255)
    if (attenuation == 0) return code
    code=code+(if (unit == 1) 90+((w4>>29)&7)+((w5&7)<<3) else (w5>>23)&63)
    if (attenuation == 1) return code
    code=code+(if (unit == 1) (w5>>3)&63 else ((w5>>29)&7)+((w6&7)<<3))
    if (attenuation == 2) return code
    return code+(if (unit == 1) 70+((w5>>9)&63) else (w6>>3)&63)
}
fun esp32S3AdcReferenceCode(unit: int,attenuation: int,block1word5: int,w4: int,w6: int,w7: int): int {
    if ((w4&3) != 1 || unit < 1 || unit > 2 || attenuation < 0 || attenuation > 3) return -1
    var code=900+((w7>>1)&255)
    if (attenuation < 3) code=code+800+((w6>>25)&127)+((w7&1)<<7)
    if (attenuation < 2) code=code+700+((w6>>17)&255)
    if (attenuation < 1) code=code+800+((w6>>9)&255)
    if (unit == 1) return code
    return code+(if (attenuation == 0) 40-((w7>>9)&255) else if (attenuation == 1) 10-((w7>>17)&127) else if (attenuation == 2) 20-((w7>>24)&127) else 15-((block1word5>>26)&63))
}
// Reference codes generated above lie within852..4260. Q16 slope numerator
// is65536*850. Bounded quotient search avoids external integer division.
fun esp32S3AdcFirstStepSlope(referenceCode: int): int {
    if (referenceCode < 852 || referenceCode > 4260) return -1
    var result=0; var bit=32768
    while (bit > 0) {
        val trial=result+bit
        if (trial*referenceCode <= 55705600) result=trial
        bit=bit/2
    }
    return result
}
// Requires raw acquired with the matching unit/attenuation's analog init code.
// Raw here is native12-bit; no classicESP32 width-rescaling assumptions.
fun esp32S3AdcCalibratedMillivolts(unit: int,attenuation: int,raw: int,referenceCode: int): int {
    if (raw < 0 || raw > 4095) return -1
    val slope=esp32S3AdcFirstStepSlope(referenceCode)
    if (slope < 0) return -1
    val first=raw*slope/65536
    return esp32S3AdcCorrectMillivolts(unit,attenuation,first)
}
