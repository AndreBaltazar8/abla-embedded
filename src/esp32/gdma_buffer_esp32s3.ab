// Single CPU consumer, exclusively owned descriptor chain in internal SRAM.
// Completion polling does not count EOF interrupts (which can coalesce).
// TX requires auto-writeback, enabled by esp32s3GdmaConfigureI2s.
// Returns length, -1 invalid descriptor, -2 still DMA-owned, -3 bad metadata.
trusted fun esp32s3GdmaCompletedBytes(descriptor: int): int {
    if (!esp32s3GdmaDescriptorValid(descriptor)) return -1
    val flags = esp32s3GdmaRead(descriptor)
    if ((flags & 0x80000000) != 0) return -2
    esp32s3GdmaPublish()
    val capacity = flags & 4095
    val length = (flags >>> 12) & 4095
    if (capacity == 0 || length > capacity) return -3
    length
}

// Re-arm only after CPU finishes processing/filling this buffer. Existing
// buffer and next pointers remain immutable. Does not restart a stalled DMA
// channel; the stream owner must handle owner-error/park events explicitly.
trusted fun esp32s3GdmaRearm(descriptor: int, transmit: bool, length: int, eof: bool): bool {
    if (!esp32s3GdmaDescriptorValid(descriptor) || length < 0 || length > 4095 ||
        (transmit && length == 0) || (!transmit && (length != 0 || eof))) return false
    val flags = esp32s3GdmaRead(descriptor)
    if ((flags & 0x80000000) != 0) return false
    val capacity = flags & 4095
    if (capacity == 0 || length > capacity) return false
    val buffer = esp32s3GdmaRead(descriptor + 4)
    if (buffer < 0x3fc88000 || (buffer & 3) != 0 || buffer > 0x3fd00000 - capacity) return false
    val next = esp32s3GdmaRead(descriptor + 8)
    if (next != 0 && !esp32s3GdmaDescriptorValid(next)) return false
    esp32s3GdmaPublish()
    esp32s3GdmaWrite(descriptor, capacity | (length << 12) |
        (if (eof) 0x40000000 else 0) | 0x80000000)
    true
}
