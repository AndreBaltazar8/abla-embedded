import "./rtc_retention_tag_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@inline
@export("esp32S3TagRead")
trusted fun esp32S3TagReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3TagWrite")
trusted fun esp32S3TagWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
