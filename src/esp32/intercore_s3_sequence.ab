// S3 FROM_CPU0..3 sources79..82, SYSTEM+0x30..3c. Own the chosen
// source globally and its destination CPU line before routing; no allocation
// or handler installation implied. Both cores' users must be quiescent.
// Scalar saves both original map fields, source number and valid marker.
import "./interrupt_capabilities_s3.ab"
type Esp32S3IntercoreRoute = int
fun Esp32S3IntercoreRoute.valid(): bool = (this & 4096) != 0 && (this & ~8191) == 0
@section(".iram1.abla.s3IntercoreRoute")
trusted fun esp32S3IntercoreRouteOwned(channel: int,core: int,line: int): Esp32S3IntercoreRoute {
    if (channel < 0 || channel > 3 || core < 0 || core > 1 ||
        !esp32S3InterruptExternalLevel(line)) return Esp32S3IntercoreRoute(0)
    if ((esp32S3IntercoreRead(0x600C0030+channel*4) & 1) != 0) return Esp32S3IntercoreRoute(0)
    val map=0x600C213C+channel*4
    val old0=esp32S3IntercoreRead(map) & 31
    val old1=esp32S3IntercoreRead(map+2048) & 31
    // Timer line16 is the documented matrix disconnected default on S3.
    esp32S3IntercoreUpdate(map,31,16)
    esp32S3IntercoreUpdate(map+2048,31,16)
    esp32S3IntercoreUpdate(map+core*2048,31,line)
    Esp32S3IntercoreRoute(old0 | (old1<<5) | (channel<<10) | 4096)
}
@section(".iram1.abla.s3IntercoreSignal")
trusted fun esp32S3IntercoreSignalOwned(channel: int,asserted: bool): bool {
    if (channel < 0 || channel > 3) return false
    esp32S3IntercoreUpdate(0x600C0030+channel*4,1,if (asserted) 1 else 0)
    true
}
// Stop producers/handler first; refuse to reroute an outstanding notification.
@section(".iram1.abla.s3IntercoreRestore")
trusted fun esp32S3IntercoreRestoreOwned(saved: Esp32S3IntercoreRoute): bool {
    if (!saved.valid()) return false
    val channel=((saved | 0)>>>10) & 3
    if ((esp32S3IntercoreRead(0x600C0030+channel*4) & 1) != 0) return false
    val map=0x600C213C+channel*4
    esp32S3IntercoreUpdate(map,31,16)
    esp32S3IntercoreUpdate(map+2048,31,16)
    esp32S3IntercoreUpdate(map,31,(saved | 0) & 31)
    esp32S3IntercoreUpdate(map+2048,31,((saved | 0)>>>5) & 31)
    true
}
