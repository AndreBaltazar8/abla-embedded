import "./peer_notify_esp32s3.ab"
import "./interrupt_install_esp32s3.ab"
import "abla/unsafe/native"

// Native dispatcher passes its void* argument in one32bit register. Use u32,
// not Abla int (64bit C ABI), for this boundary. No exported handler symbol or
// module globals: the caller owns the8byte retained internal-RAM context.
@section(".iram1.abla.s3PeerHandler")
trusted fun esp32S3PeerHandler(context: u32): void {
    val address=int(context)
    val mailbox=mmioLoadU32(address)
    val channel=mmioLoadU32(address+4)
    esp32S3PeerParkServiceOwned(mailbox,channel)
    return
}

import "./peer_handler_s3_sequence.ab"
@inline
trusted fun esp32S3PeerHandlerRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3PeerHandlerWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3PeerHandlerAddress(): int = nativeFunctionAddress(esp32S3PeerHandler)
