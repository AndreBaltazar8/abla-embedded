import "./coprocessor_dispatch_s3_sequence.ab"
import "./exception_handler_s3_sequence.ab"
// Immutable24-byte record: fallback/context, lock/table, resolver/context.
// Fallback must repair or not return; recursive lock or resolver contract
// violations are fatal. Resolver must exclude ISR/boot execution explicitly.
@section(".iram1.abla.s3CpPolicy")
trusted fun esp32S3CoprocessorPolicy(frame: u32,cause: u32,core: u32,record: u32): void {
    val saved=nativeBufferAt(int(frame),192)
    if (cause == u32(1) && esp32S3CpPolicySyscall(saved)) return
    val address=int(record)
    if ((cause == u32(32) || cause == u32(35)) &&
        esp32S3CoprocessorDispatch(saved,nativeBufferAt(esp32S3CpOwnerRead(address+12),16),
            nativeBufferAt(esp32S3CpOwnerRead(address+8),4),int(core),esp32S3CpOwnerRead(address+16),esp32S3CpOwnerRead(address+20)) == 1) return
    esp32S3CpPolicyFallback(esp32S3CpOwnerRead(address),int(frame),int(cause),int(core),esp32S3CpOwnerRead(address+4))
    return
}
@inline
fun esp32S3CpPolicyOverlap(a: int,size: int,b: int,length: int): bool = a < b+length && b < a+size
@inline
trusted fun esp32S3CpPolicyAvailable(address: int,size: int): bool {
    val cfg=esp32S3ExceptionConfig()
    if (esp32S3CpPolicyOverlap(address,size,cfg,64)) return false
    var core=0
    while (core < 2) {
        val entry=cfg+core*32
        if (esp32S3ExceptionRead(entry) != 0 && address < esp32S3ExceptionRead(entry+20) &&
            esp32S3ExceptionRead(entry+16) < address+size) return false
        if (esp32S3ExceptionRead(entry+24) == esp32S3CoprocessorPolicyAddress() &&
            esp32S3CpPolicyOverlap(address,size,esp32S3ExceptionRead(entry+28),24)) return false
        core=core+1
    }
    true
}
// Serialized BOOT installation before VECBASE activation. Fresh zero owner
// table/unlocked word required; does not erase live state. Caller additionally
// owns disjoint task records, active ordinary stacks and other callback data.
// Local INTENABLE=0 is necessary, not cross-core serialization by itself.
@section(".iram1.abla.s3CpPolicyInstall")
trusted fun esp32S3CoprocessorPolicyInstallOwned(record: NativeBuffer,table: NativeBuffer,lock: NativeBuffer,core: int,fallback: int,context: int,resolver: int,resolverContext: int): bool {
    if (core < 0 || core > 1 || esp32S3ExceptionCore() != core || esp32S3ExceptionEnabled() != 0 ||
        !record.hasAddressRange(0,24) || !esp32S3CpOwnerRange(record.addressValue(),24,3) ||
        !table.hasAddressRange(0,16) || !esp32S3CpOwnerRange(table.addressValue(),16,3) ||
        !lock.hasAddressRange(0,4) || !esp32S3CpOwnerRange(lock.addressValue(),4,3) ||
        fallback < 0x40370000 || fallback >= 0x403E0000 || (fallback & 3) != 0 ||
        resolver < 0x40370000 || resolver >= 0x403E0000 || (resolver & 3) != 0 ||
        context < 0 || context > 0xFFFFFFFF || resolverContext < 0 || resolverContext > 0xFFFFFFFF) return false
    val address=record.addressValue()
    val tab=table.addressValue()
    val word=lock.addressValue()
    if (esp32S3CpPolicyOverlap(address,24,tab,16) || esp32S3CpPolicyOverlap(address,24,word,4) ||
        esp32S3CpPolicyOverlap(tab,16,word,4) || !esp32S3CpPolicyAvailable(address,24) ||
        !esp32S3CpPolicyAvailable(tab,16) || !esp32S3CpPolicyAvailable(word,4)) return false
    val entry=esp32S3ExceptionConfig()+core*32
    if (esp32S3ExceptionRead(entry) == 0 || esp32S3ExceptionRead(entry+4) != 0 || esp32S3ExceptionRead(entry+24) != 0 ||
        esp32S3CpOwnerRead(word) != 0) return false
    var offset=0
    while (offset < 16) { if (esp32S3CpOwnerRead(tab+offset) != 0) return false; offset=offset+4 }
    esp32S3CpOwnerWrite(address,fallback)
    esp32S3CpOwnerWrite(address+4,context)
    esp32S3CpOwnerWrite(address+8,word)
    esp32S3CpOwnerWrite(address+12,tab)
    esp32S3CpOwnerWrite(address+16,resolver)
    esp32S3CpOwnerWrite(address+20,resolverContext)
    // All handler guards were checked before record mutation; caller-held
    // startup ownership keeps them stable through the publication below.
    esp32S3ExceptionHandlerInstallOwned(core,esp32S3CoprocessorPolicyAddress(),address)
}
// Switch away from user vector before removal. Does not free/reinitialize CP
// state or revoke a peer's use of the shared table/lock; release separately.
@section(".iram1.abla.s3CpPolicyRemove")
trusted fun esp32S3CoprocessorPolicyRemoveOwned(record: NativeBuffer,core: int): bool {
    if (!record.hasAddressRange(0,24) || !esp32S3CpOwnerRange(record.addressValue(),24,3)) return false
    esp32S3ExceptionHandlerRemoveOwned(core,esp32S3CoprocessorPolicyAddress(),record.addressValue())
}
