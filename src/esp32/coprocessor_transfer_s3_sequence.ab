import "./sdk/raw_buffer.ab"
// Caller has exclusive ownership of the live CP state and buffer, is pinned
// to this core with INTLEVEL15, EXCM clear, WOE set and working window vectors. Not a scheduler
// lock: debug/NMI must not use these registers. No implicit migration/ownership.
// Temporarily enables only the requested CP, then restores exact CPENABLE.
@noinline
@section(".iram1.abla.s3CoprocessorTransfer")
trusted fun esp32S3CoprocessorTransferOwned(buffer: NativeBuffer,core: int,cp: int,restore: bool): bool {
    if (core < 0 || core > 1 || (cp != 0 && cp != 3)) return false
    val size=if (cp == 0) 72 else 208
    val alignment=if (cp == 0) 3 else 15
    val address=buffer.addressValue()
    if (!buffer.hasAddressRange(0,size) || (address & alignment) != 0 ||
        address < 0x3FC88000 || address+size > 0x3FD00000) return false
    if (esp32S3CpTransferCore() != core || (esp32S3CpTransferStatus() & 0x4001F) != 0x4000F) return false
    val previous=esp32S3CpTransferEnabled()
    esp32S3CpTransferEnable(previous | (1<<cp))
    esp32S3CpTransferCall(cp,restore,address)
    esp32S3CpTransferEnable(previous)
    true
}
