import "./gpio_clock_c6_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("c6GpioClockRead")
trusted fun c6GpioClockReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("c6GpioClockWrite")
trusted fun c6GpioClockWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
