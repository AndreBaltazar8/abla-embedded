import "./context_extra_esp32s3.ab"
// Kernel/double exceptions are fatal, as in IDF xtensa_vectors.S. This default
// policy captures both cores independently then halts (watchdogs remain active).
// No stack, CALL, window spill, callback, allocation, flash access or output.
// EXCSAVE6/7 are scratch on this nonreturning path; their old values are lost.
// Does not suppress NMI/debug exceptions or retain snapshots across reset.
// Record128/core: magic0(last),reason4(1kernel/2double),EPC1=8,PS12,cause16,
// vaddr20,A0..15=24..84,SAR88,loops92/96/100,EXCSAVE1=104,CPENABLE108,
// DEPC112, selected faultPC116/faultPS120, DEBUGCAUSE124. Reasons4..7 are
// high/debug/NMI defaults: selected fields use EPCn/EPSn, not EPC1/live PS.
// Double-fault PC is DEPC; EPC1 describes the interrupted exception.
trusted noescape extern:"inline-assembly" fun esp32S3FatalAddressAssembly(template: string,constraints: string,vector: u32,body: u32): u32
@naked
@noinline
@section(".iram1.abla.s3KernelVector")
trusted fun esp32S3KernelVector(): void =
    esp32S3ContextExtraAssembly(".Labla_s3_kernel_vector:\nwsr.excsave6 a0\nwsr.excsave7 a1\nmovi a1, 1\nj .Labla_s3_fatal_entry\n.org .Labla_s3_kernel_vector+64", "~{memory}")
@naked
@noinline
@section(".iram1.abla.s3DoubleVector")
trusted fun esp32S3DoubleVector(): void =
    esp32S3ContextExtraAssembly(".Labla_s3_double_vector:\nwsr.excsave6 a0\nwsr.excsave7 a1\nmovi a1, 2\nj .Labla_s3_fatal_entry\n.org .Labla_s3_double_vector+64", "~{memory}")
@naked
@noinline
@section(".iram1.abla.s3FatalEntry")
trusted fun esp32S3FatalEntry(): void =
    esp32S3ContextExtraAssembly(".pushsection .dram1.abla.s3FatalRecords,\"aw\",@progbits\n.balign 16\n.Labla_s3_fatal_records:\n.space 256\n.popsection\n.Labla_s3_fatal_entry:\nrsr.prid a0\nextui a0, a0, 13, 1\nslli a0, a0, 7\nadd a0, a0, a1\nmovi a1, .Labla_s3_fatal_records\nadd a0, a0, a1\nextui a1, a0, 0, 3\nsub a0, a0, a1\ns32i a1, a0, 0\ns32i a1, a0, 4\ns32i a2, a0, 32\ns32i a3, a0, 36\ns32i a4, a0, 40\ns32i a5, a0, 44\ns32i a6, a0, 48\ns32i a7, a0, 52\ns32i a8, a0, 56\ns32i a9, a0, 60\ns32i a10, a0, 64\ns32i a11, a0, 68\ns32i a12, a0, 72\ns32i a13, a0, 76\ns32i a14, a0, 80\ns32i a15, a0, 84\nrsr.excsave6 a1\ns32i a1, a0, 24\nrsr.excsave7 a1\ns32i a1, a0, 28\nrsr.epc1 a1\ns32i a1, a0, 8\nrsr.ps a1\ns32i a1, a0, 12\nrsr.exccause a1\ns32i a1, a0, 16\nrsr.excvaddr a1\ns32i a1, a0, 20\nrsr.sar a1\ns32i a1, a0, 88\nrsr.lbeg a1\ns32i a1, a0, 92\nrsr.lend a1\ns32i a1, a0, 96\nrsr.lcount a1\ns32i a1, a0, 100\nrsr.excsave1 a1\ns32i a1, a0, 104\nrsr.cpenable a1\ns32i a1, a0, 108\nrsr.depc a1\ns32i a1, a0, 112\nl32i a1, a0, 4\nbnei a1, 2, .Labla_s3_fatal_not_double\nrsr.depc a1\ns32i a1, a0, 116\nrsr.ps a1\nj .Labla_s3_fatal_selected\n.Labla_s3_fatal_not_double:\nbnei a1, 4, .Labla_s3_fatal_not_4\nrsr.epc4 a1\ns32i a1, a0, 116\nrsr.eps4 a1\nj .Labla_s3_fatal_selected\n.Labla_s3_fatal_not_4:\nbnei a1, 5, .Labla_s3_fatal_not_5\nrsr.epc5 a1\ns32i a1, a0, 116\nrsr.eps5 a1\nj .Labla_s3_fatal_selected\n.Labla_s3_fatal_not_5:\nbnei a1, 6, .Labla_s3_fatal_not_6\nrsr.epc6 a1\ns32i a1, a0, 116\nrsr.eps6 a1\nj .Labla_s3_fatal_selected\n.Labla_s3_fatal_not_6:\nbnei a1, 7, .Labla_s3_fatal_not_7\nrsr.epc7 a1\ns32i a1, a0, 116\nrsr.eps7 a1\nj .Labla_s3_fatal_selected\n.Labla_s3_fatal_not_7:\nrsr.epc1 a1\ns32i a1, a0, 116\nrsr.ps a1\n.Labla_s3_fatal_selected:\ns32i a1, a0, 120\nrsr.debugcause a1\ns32i a1, a0, 124\nrsil a1, 15\nmemw\nmovi a1, 1178686513\ns32i a1, a0, 0\nmemw\n.Labla_s3_fatal_halt:\nj .Labla_s3_fatal_halt", "~{memory}")
@inline
trusted fun esp32S3KernelVectorAddress(): int =
    int(esp32S3FatalAddressAssembly("movi $0, .Labla_s3_kernel_vector", "=r,i,i,~{memory}",u32(nativeFunctionAddress(esp32S3KernelVector)),u32(nativeFunctionAddress(esp32S3FatalEntry))))
