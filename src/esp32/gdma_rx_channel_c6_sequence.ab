import "./gdma_tx_channel_c6_sequence.ab"
// C6 RX channel0..2:70+C0*n,events10*n. LINK stop/start/restart21..23,
// park24; CONF0 ETM5 (not TX6), burst2/3, memory-transfer4.
// Caller owns channel/peripheral trigger, initialized/drained FIFO, pinned
// GDMA clocks/PMS/SRAM and joined IRQ/ETM users. No reset/IRQ clear/start.
// Snapshot conf0@8,owner40,oldperipheral41..46,channel47..48,valid49.
//1ready2invalid3clock4busy5write6restored7restore-failed; retain on failure.
type C6GdmaRxChannel=int
fun C6GdmaRxChannel.status(): int = this&255
fun c6GdmaRxBase(channel: int): int = if (channel < 0 || channel > 2) -1 else 0x70+channel*0xc0
trusted fun c6GdmaRxParked(channel: int): bool {
    val base=c6GdmaRxBase(channel)
    if (base < 0) return false
    val events=channel*16
    return (c6GdmaRead(base)&u32(33)) == u32(0) &&
        (c6GdmaRead(base+16)&u32(0x1e00000)) == u32(0x1000000) &&
        (c6GdmaRead(base+8)&u32(2)) != u32(0) &&
        c6GdmaRead(events) == u32(0) && c6GdmaRead(events+8) == u32(0)
}
// Single-word descriptors/data, peripheral receive (not memory-to-memory).
// I2S0=3; register-listed IDs SPI2=0,UHCI0=2,AES6,SHA7,ADC8,PARLIO9.
trusted fun c6GdmaRxChannelOpenOwned(channel: int,peripheral: int,exclusive: bool): C6GdmaRxChannel {
    val base=c6GdmaRxBase(channel)
    if (!exclusive || base < 0 || (peripheral != 0 && peripheral != 2 && peripheral != 3 && peripheral != 6 && peripheral != 7 && peripheral != 8 && peripheral != 9)) return C6GdmaRxChannel(2)
    if (!c6GdmaClocksReady()) return C6GdmaRxChannel(3)
    if (!c6GdmaRxParked(channel)) return C6GdmaRxChannel(4)
    val token=(1<<49)|(channel<<47)|(int(c6GdmaRead(base))<<8)|
        (int((c6GdmaRead(base+4)>>u32(12))&u32(1))<<40)|(int(c6GdmaRead(base+48)&u32(63))<<41)
    if (!c6GdmaField(base,u32(30),u32(0)) || !c6GdmaField(base+4,u32(4096),u32(4096)) ||
        !c6GdmaField(base+48,u32(63),u32(peripheral))) return C6GdmaRxChannel(token|5)
    return C6GdmaRxChannel(token|1)
}
trusted fun C6GdmaRxChannel.closeOwned(exclusive: bool): C6GdmaRxChannel {
    if (!exclusive || this < 0 || (this&~0x3ffffffffffff) != 0 || (this&(1<<49)) == 0 ||
        (this.status() != 1 && this.status() != 5 && this.status() != 7)) return this
    val token=this&~255;val channel=(token>>>47)&3
    if (!c6GdmaClocksReady() || !c6GdmaRxParked(channel)) return C6GdmaRxChannel(token|7)
    val base=c6GdmaRxBase(channel)
    if (!c6GdmaField(base+48,u32(63),u32((token>>>41)&63)) ||
        !c6GdmaField(base+4,u32(4096),u32((token>>>40)&1)<<u32(12)) ||
        !c6GdmaField(base,u32(30),u32(token>>>8)&u32(30))) return C6GdmaRxChannel(token|7)
    return C6GdmaRxChannel(token|6)
}
