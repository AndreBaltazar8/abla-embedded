import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "../riscv/memory.ab"
import "./gdma_ring_c6_sequence.ab"
import "../hal/esp32.ab"
@export("c6GdmaDescriptorRead")
trusted fun c6GdmaDescriptorReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("c6GdmaDescriptorWrite")
trusted fun c6GdmaDescriptorWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
@export("c6GdmaDescriptorFence")
trusted fun c6GdmaDescriptorFenceHook(): void = riscvDeviceMemoryFence()
