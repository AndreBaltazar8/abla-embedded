import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "../riscv/memory.ab"
import "./gdma_ring_c6_sequence.ab"
trusted fun c6GdmaDescriptorRead(address: int): u32 = u32(mmioLoadU32(address))
trusted fun c6GdmaDescriptorWrite(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
trusted fun c6GdmaDescriptorFence(): void = riscvDeviceMemoryFence()
