import "./gdma_esp32s3.ab"
import "./rcc_esp32s3.ab"
import "./gdma_clock_sequence_esp32s3.ab"

// Initialization is idempotent and leaves shared GDMA powered. Clock gating
// requires ownership of every channel and is deliberately not implicit in
// individual channel teardown. Owner must be a nonzero unique live token.
trusted fun esp32s3GdmaEnableClock(owner: u32): bool {
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    esp32s3GdmaEnableClockLocked()
    esp32s3GdmaPublish()
    esp32S3RccLeave(lock, owner, saved)
}
