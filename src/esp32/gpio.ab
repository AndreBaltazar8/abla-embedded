import "../register.ab"
import "./gpio_esp32_logic.ab"
import "../hal/pin.ab"

// ESP32 GPIO register map. Writes use the atomic W1TS/W1TC registers so two
// cores can operate unrelated pins without a read-modify-write race.
val esp32GpioBase = 1072971776
val esp32GpioOutSet = esp32GpioBase + 8
val esp32GpioOutClear = esp32GpioBase + 12
val esp32GpioOut1Set = esp32GpioBase + 20
val esp32GpioOut1Clear = esp32GpioBase + 24
val esp32GpioEnableSet = esp32GpioBase + 36
val esp32GpioEnableClear = esp32GpioBase + 40
val esp32GpioEnable1Set = esp32GpioBase + 48
val esp32GpioEnable1Clear = esp32GpioBase + 52
val esp32GpioInputRegister = esp32GpioBase + 60
val esp32GpioInput1 = esp32GpioBase + 64
val esp32GpioPinConfigBase = esp32GpioBase + 136
val esp32GpioOutputSelectBase = esp32GpioBase + 1328
val esp32GpioDefaultOutputSignal = 256
val esp32IoMuxBase = 1072992256
val esp32IoMuxInputEnable = 512
val esp32IoMuxPullDown = 128
val esp32IoMuxPullUp = 256
val esp32IoMuxDriveMask = 3072
val esp32IoMuxFunctionMask = 28672
val esp32IoMuxGpioFunction = 8192
val esp32GpioPadOpenDrain = 4
val esp32GpioOutputFunctionMask = 1023
val esp32GpioOutputEnableSelect = 1024
val esp32GpioOutputEnableInvert = 2048


@export("abla_pin_valid")
fun pinValidHook(pin: int): bool = esp32BasicGpioValid(Pin(pin))
@export("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = esp32BasicGpioOutputValid(Pin(pin))
// ESP32 input-only GPIO34..39 have no internal pull resistors.
@export("abla_pin_pullCapable")
fun pinPullCapableHook(pin: int): bool = esp32BasicGpioOutputValid(Pin(pin))

@inline
trusted fun esp32PinMask(number: int): int {
    var mask = 1
    var bit = if (number < 32) number else number - 32
    while (bit > 0) {
        mask = mask * 2
        bit = bit - 1
    }
    mask
}

@inline
trusted fun esp32PinIoMux(number: int): Register32 =
    register32(esp32IoMuxBase + esp32IoMuxOffset(number))

@inline
trusted fun esp32PinConfig(number: int): Register32 =
    register32(esp32GpioPinConfigBase + number * 4)

@inline
trusted fun esp32PinOutputSelect(number: int): Register32 =
    register32(esp32GpioOutputSelectBase + number * 4)

@inline
@export("abla_pin_selectGpioFunction")
trusted fun pinSelectGpioFunctionHook(pin: int, inputEnabled: bool): void {
    val input = if (inputEnabled) esp32IoMuxInputEnable else 0
    esp32PinIoMux(Pin(pin)).update(
        esp32IoMuxFunctionMask | esp32IoMuxInputEnable,
        esp32IoMuxGpioFunction | input
    )
    return
}

@inline
@export("abla_pin_setOpenDrain")
trusted fun pinSetOpenDrainHook(pin: int, enabled: bool): void {
    if (esp32BasicGpioValid(Pin(pin))) {
        if (enabled) esp32PinConfig(Pin(pin)).setBits(esp32GpioPadOpenDrain)
        else esp32PinConfig(Pin(pin)).clearBits(esp32GpioPadOpenDrain)
    }
    return
}

@inline
@export("abla_pin_setPull")
trusted fun pinSetPullHook(pin: int, up: bool, down: bool): void {
    if (esp32BasicGpioValid(Pin(pin))) {
        val value = (if (up) esp32IoMuxPullUp else 0) |
            (if (down) esp32IoMuxPullDown else 0)
        esp32PinIoMux(Pin(pin)).update(
            esp32IoMuxPullUp | esp32IoMuxPullDown,
            value
        )
    }
    return
}

@export("abla_pin_pullUp")
trusted fun pinPullUpHook(pin: int): void = Pin(pin).setPull(true, false)
@export("abla_pin_pullDown")
trusted fun pinPullDownHook(pin: int): void = Pin(pin).setPull(false, true)
@export("abla_pin_floating")
trusted fun pinFloatingHook(pin: int): void = Pin(pin).setPull(false, false)

@inline
@export("abla_pin_setDriveStrength")
trusted fun pinSetDriveStrengthHook(pin: int, strength: int): bool {
    if (!esp32BasicGpioOutputValid(Pin(pin)) || strength < 0 || strength > 3) {
        return false
    }
    esp32PinIoMux(Pin(pin)).update(
        esp32IoMuxDriveMask,
        strength << 10
    )
    true
}

// Route a peripheral output through the classic ESP32 GPIO matrix. The caller
// owns the peripheral signal and must serialize reassignment of this pad.
@inline
@export("abla_pin_routeOutputSignal")
trusted fun pinRouteOutputSignalHook(pin: int, signal: int, inverted: bool): bool {
    if (!esp32BasicGpioOutputValid(Pin(pin)) || signal < 0 || signal > 511) {
        return false
    }
    Pin(pin).selectGpioFunction(false)
    Pin(pin).setOpenDrain(false)
    esp32PinOutputSelect(Pin(pin)).update(
        esp32GpioOutputFunctionMask,
        signal | (if (inverted) 512 else 0)
    )
    true
}

@inline
@export("abla_pin_output")
trusted fun pinOutputHook(pin: int): void {
    if (esp32BasicGpioOutputValid(Pin(pin))) {
        Pin(pin).selectGpioFunction(false)
        Pin(pin).setOpenDrain(false)
        // Disconnect peripheral output and let the GPIO latch drive the pad.
        esp32PinOutputSelect(Pin(pin)).update(
            esp32GpioOutputFunctionMask,
            esp32GpioDefaultOutputSignal
        )
        if (Pin(pin) < 32) {
            mmioStoreU32(esp32GpioEnableSet, esp32PinMask(Pin(pin)))
        } else {
            mmioStoreU32(esp32GpioEnable1Set, esp32PinMask(Pin(pin)))
        }
    }
}

@inline
@export("abla_pin_input")
trusted fun pinInputHook(pin: int): void {
    if (esp32BasicGpioValid(Pin(pin))) {
        Pin(pin).selectGpioFunction(true)
        Pin(pin).setOpenDrain(false)
        // Force output-enable control to the GPIO enable latch before
        // clearing it, matching ESP-IDF's direction transition.
        esp32PinOutputSelect(Pin(pin)).update(
            esp32GpioOutputEnableSelect | esp32GpioOutputEnableInvert,
            esp32GpioOutputEnableSelect
        )
        if (Pin(pin) < 32) {
            mmioStoreU32(esp32GpioEnableClear, esp32PinMask(Pin(pin)))
        } else {
            mmioStoreU32(esp32GpioEnable1Clear, esp32PinMask(Pin(pin)))
        }
    }
}

@inline
@export("abla_pin_openDrainOutput")
trusted fun pinOpenDrainOutputHook(pin: int): void {
    Pin(pin).output()
    Pin(pin).setOpenDrain(true)
    return
}

@inline
@export("abla_pin_write")
trusted fun pinWriteHook(pin: int, level: bool): void {
    if (esp32BasicGpioOutputValid(Pin(pin))) {
        val mask = esp32PinMask(Pin(pin))
        if (Pin(pin) < 32) {
            mmioStoreU32(
                if (level) esp32GpioOutSet else esp32GpioOutClear,
                mask
            )
        } else {
            mmioStoreU32(
                if (level) esp32GpioOut1Set else esp32GpioOut1Clear,
                mask
            )
        }
    }
}

@inline
@export("abla_pin_read")
trusted fun pinReadHook(pin: int): bool {
    var value = 0
    if (esp32BasicGpioValid(Pin(pin))) {
        value = mmioLoadU32(
            if (Pin(pin) < 32) esp32GpioInputRegister else esp32GpioInput1
        )
    }
    esp32BasicGpioValid(Pin(pin)) && (value & esp32PinMask(Pin(pin))) != 0
}
