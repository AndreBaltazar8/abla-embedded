import "abla/unsafe/mmio"

// Classic ESP32 eFuse HAL. Register access is volatile MMIO; all policy and
// decoding is ordinary Abla and stays visible to whole-module optimization.

val esp32EfuseBase = int(0x3ff5a000)
val esp32SysconDateRegister = int(0x3ff6607c)

@inline
trusted fun esp32EfuseRead(offset: int): u32 =
    u32(mmioLoadU32(esp32EfuseBase + offset))

@inline
trusted fun esp32EfuseWrite(offset: int, value: u32): void =
    mmioStoreU32(esp32EfuseBase + offset, int(value))

@inline
trusted fun esp32EfuseUpdate(offset: int, clearMask: u32, setMask: u32): void =
    esp32EfuseWrite(offset, (esp32EfuseRead(offset) & ~clearMask) | setMask)

@section(".iram1.0.abla.esp32EfuseHalGetMajorChipVersion")
trusted fun esp32EfuseHalGetMajorChipVersion(): u32 {
    val revision1 = (esp32EfuseRead(12) >>> u32(15)) & u32(1)
    val revision2 = (esp32EfuseRead(20) >>> u32(20)) & u32(1)
    val revision3 = (u32(mmioLoadU32(esp32SysconDateRegister)) >>> u32(31)) &
        u32(1)
    val encoded = (revision3 << u32(2)) | (revision2 << u32(1)) | revision1
    if (encoded == u32(1)) return u32(1)
    if (encoded == u32(3)) return u32(2)
    if (encoded == u32(7)) return u32(3)
    u32(0)
}

@section(".iram1.1.abla.esp32EfuseHalGetMinorChipVersion")
trusted fun esp32EfuseHalGetMinorChipVersion(): u32 =
    (esp32EfuseRead(20) >>> u32(24)) & u32(3)

trusted fun esp32EfuseHalGetRatedFrequencyMhz(): u32 {
    val configuration = esp32EfuseRead(12)
    val rated = ((configuration >>> u32(13)) & u32(1)) != u32(0)
    val low = ((configuration >>> u32(12)) & u32(1)) != u32(0)
    if (rated && low) u32(160) else u32(240)
}

trusted fun esp32EfuseHalSetTiming(apbFrequencyMhz: u32): void {
    var clockSelect0 = u32(80)
    var clockSelect1 = u32(128)
    var dacClockDivider = u32(100)
    if (apbFrequencyMhz <= u32(26)) {
        clockSelect0 = u32(250)
        clockSelect1 = u32(255)
        dacClockDivider = u32(52)
    } else if (apbFrequencyMhz <= u32(40)) {
        clockSelect0 = u32(160)
        clockSelect1 = u32(255)
        dacClockDivider = u32(80)
    }
    esp32EfuseUpdate(280, u32(255), dacClockDivider)
    esp32EfuseUpdate(248, u32(255), clockSelect0)
    esp32EfuseUpdate(248, u32(0xff00), clockSelect1 << u32(8))
}

@section(".iram1.3.abla.esp32EfuseHalRead")
trusted fun esp32EfuseHalRead(): void {
    esp32EfuseUpdate(252, u32(0xffff), u32(0x5aa5))
    esp32EfuseWrite(260, esp32EfuseRead(260) | u32(1))
    while (esp32EfuseRead(260) != u32(0)) {}
}

trusted fun esp32EfuseClearRange(first: int, last: int): void {
    var offset = first
    while (offset <= last) {
        esp32EfuseWrite(offset, u32(0))
        offset = offset + 4
    }
}

trusted fun esp32EfuseHalClearProgramRegisters(): void {
    esp32EfuseClearRange(28, 52)
    esp32EfuseClearRange(152, 180)
    esp32EfuseClearRange(184, 212)
    esp32EfuseClearRange(216, 244)
}

@section(".iram1.4.abla.esp32EfuseHalProgram")
trusted fun esp32EfuseHalProgram(block: u32): void {
    esp32EfuseUpdate(252, u32(0xffff), u32(0x5a5a))
    esp32EfuseWrite(260, esp32EfuseRead(260) | u32(2))
    while (esp32EfuseRead(260) != u32(0)) {}
    esp32EfuseHalRead()
}

trusted fun esp32EfuseHalIsCodingErrorInBlock(block: u32): bool {
    if (block == u32(0) || block > u32(4)) return false
    if ((esp32EfuseRead(24) & u32(3)) != u32(1)) return false
    val warningMask = u32(15) << ((block - u32(1)) << u32(2))
    (esp32EfuseRead(284) & u32(0xfff) & warningMask) != u32(0)
}

// Register-frame adapters are temporary compatibility edges for neighboring
// lifted sources, not assembly implementations.
trusted fun esp32RecoveredEfuseHalGetMajorChipVersion(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32EfuseHalGetMajorChipVersion()
trusted fun esp32RecoveredEfuseHalGetMinorChipVersion(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32EfuseHalGetMinorChipVersion()
trusted fun esp32RecoveredEfuseHalGetRatedFreqMhz(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32EfuseHalGetRatedFrequencyMhz()
trusted fun esp32RecoveredEfuseHalSetTiming(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32EfuseHalSetTiming(a2); a2 }
trusted fun esp32RecoveredEfuseHalRead(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32EfuseHalRead(); a2 }
trusted fun esp32RecoveredEfuseHalClearProgramRegisters(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32EfuseHalClearProgramRegisters(); a2 }
trusted fun esp32RecoveredEfuseHalProgram(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32EfuseHalProgram(a2); a2 }
trusted fun esp32RecoveredEfuseHalIsCodingErrorInBlock(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=if (esp32EfuseHalIsCodingErrorInBlock(a2)) u32(1) else u32(0)
