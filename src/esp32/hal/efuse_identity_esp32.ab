import "abla/unsafe/mmio"
import "abla/unsafe/memory"

@inline
trusted fun esp32EfuseRegisters(): u32 = u32(1073061888)

// Original ABI symbol: efuse_hal_get_mac. Factory MAC words live at EFUSE
// offsets 4 and 8; only the low halfword of the latter belongs to the address.
trusted fun esp32EfuseGetMac(output: u32): void {
    val efuse = esp32EfuseRegisters()
    val low = u32(mmioLoadU32(int(efuse + u32(4))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(output)), int(low))
    val high = u32(mmioLoadU32(int(efuse + u32(8))))
    ablaUnsafeStoreU16(
        nativePointerFromAddress(int(output + u32(4))), int(high)
    )
}

trusted fun esp32EfuseGetMacValue(output: u32): u32 {
    esp32EfuseGetMac(output)
    output
}

// Original ABI symbol: efuse_hal_get_chip_ver_pkg.
trusted fun esp32EfuseGetChipVersionPackage(): u32 {
    val efuse = esp32EfuseRegisters()
    val packageHigh = (
        u32(mmioLoadU32(int(efuse + u32(12)))) >>> u32(2)
    ) & u32(1)
    val packageLow = (
        u32(mmioLoadU32(int(efuse + u32(12)))) >>> u32(9)
    ) & u32(7)
    (packageHigh << u32(3)) | packageLow
}
