import "efuse_esp32.ab"

@section(".iram1.0.abla.esp32EfuseHalChipRevision")
trusted fun esp32EfuseHalChipRevision(): u32 =
    esp32EfuseHalGetMajorChipVersion() * u32(100) +
        esp32EfuseHalGetMinorChipVersion()

@section(".iram1.5.abla.esp32EfuseHalFlashEncryptionEnabled")
trusted fun esp32EfuseHalFlashEncryptionEnabled(): bool {
    var counter = (esp32EfuseRead(0) >>> u32(20)) & u32(127)
    var odd = false
    while (counter != u32(0)) {
        if ((counter & u32(1)) != u32(0)) odd = !odd
        counter = counter >>> u32(1)
    }
    odd
}

@section(".iram1.2.abla.esp32EfuseHalGetDisableWaferVersionMajor")
trusted fun esp32EfuseHalGetDisableWaferVersionMajor(): bool = false

trusted fun esp32RecoveredEfuseHalChipRevision(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32EfuseHalChipRevision()
trusted fun esp32RecoveredEfuseHalFlashEncryptionEnabled(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=if (esp32EfuseHalFlashEncryptionEnabled()) u32(1) else u32(0)
trusted fun esp32RecoveredEfuseHalGetDisableWaferVersionMajor(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=u32(0)
