import "../dport_esp32.ab"
import "../../runtime/freestanding_integer.ab"
import "abla/unsafe/memory"

// Typed implementation of the classic ESP32 cache HAL. All control flow,
// state, address classification, and DPORT values are optimizer-visible.
var esp32CacheHalProStatus: u32 = u32(0)
var esp32CacheHalAppStatus: u32 = u32(0)

@inline
fun esp32CacheHalSuspendedBits(configuration: u32): u32 {
    val inverted = ~configuration
    return (inverted & u32(7)) |
        ((inverted >>> u32(1)) & u32(8)) |
        ((inverted << u32(1)) & u32(16))
}

@inline
fun esp32CacheHalConfigurationBits(status: u32): u32 =
    (status & u32(7)) |
        ((status << u32(1)) & u32(16)) |
        ((status >>> u32(1)) & u32(8))

// Original ABI symbol: cache_hal_init.
trusted fun esp32CacheHalInit(): void {
    return
}

// Original ABI symbol: cache_hal_suspend.
@section(".iram1.0.abla.esp32CacheHalSuspend")
trusted fun esp32CacheHalSuspend(): void {
    esp32CacheHalProStatus = esp32CacheHalSuspendedBits(
        esp32DportRead(u32(1072693316))
    )
    while (((esp32DportRead(u32(1072694256)) >>> u32(7)) &
        u32(4095)) != u32(1)) {}
    esp32DportWrite(
        u32(1072693312),
        esp32DportRead(u32(1072693312)) & ~u32(8)
    )

    esp32CacheHalAppStatus = esp32CacheHalSuspendedBits(
        esp32DportRead(u32(1072693340))
    )
    while (((esp32DportRead(u32(1072694296)) >>> u32(7)) &
        u32(4095)) != u32(1)) {}
    esp32DportWrite(
        u32(1072693336),
        esp32DportRead(u32(1072693336)) & ~u32(8)
    )
    return
}

// Original ABI symbol: cache_hal_resume.
@section(".iram1.0.abla.esp32CacheHalResume")
trusted fun esp32CacheHalResume(): void {
    esp32DportWrite(
        u32(1072693312),
        esp32DportRead(u32(1072693312)) | u32(8)
    )
    val proMask = esp32CacheHalConfigurationBits(esp32CacheHalProStatus)
    esp32DportWrite(
        u32(1072693316),
        esp32DportRead(u32(1072693316)) & ~proMask
    )

    esp32DportWrite(
        u32(1072693336),
        esp32DportRead(u32(1072693336)) | u32(8)
    )
    val appMask = esp32CacheHalConfigurationBits(esp32CacheHalAppStatus)
    esp32DportWrite(
        u32(1072693340),
        esp32DportRead(u32(1072693340)) & ~appMask
    )
    return
}

// Original ABI symbol: cache_hal_is_cache_enabled.
@section(".iram1.0.abla.esp32CacheHalIsCacheEnabled")
trusted fun esp32CacheHalIsCacheEnabled(): u32 =
    if ((esp32DportRead(u32(1072693312)) & u32(8)) != u32(0) &&
        (esp32DportRead(u32(1072693336)) & u32(8)) != u32(0))
        u32(1) else u32(0)

@inline
fun esp32CacheHalAddressRangeWithin(
    address: u32,
    end: u32,
    first: u32,
    last: u32
): bool = address >= first && end <= last

// Original ABI symbol: cache_hal_vaddr_to_cache_level_id.
trusted fun esp32CacheHalVaddrToCacheLevelId(
    address: u32,
    size: u32,
    cacheLevelAddress: u32,
    cacheIdAddress: u32
): u32 {
    val cacheLevel = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(cacheLevelAddress))
    ))
    val cacheId = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(cacheIdAddress))
    ))
    if (cacheLevel != u32(0) || cacheId != u32(0)) return u32(0)

    val end = address + size - u32(1)
    val mapped = esp32CacheHalAddressRangeWithin(
        address, end, u32(1061158912), u32(1065353215)
    ) || esp32CacheHalAddressRangeWithin(
        address, end, u32(1065353216), u32(1069547519)
    ) || esp32CacheHalAddressRangeWithin(
        address, end, u32(1074593792), u32(1077936127)
    )
    if (!mapped) return u32(0)

    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(cacheLevelAddress)), 1
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(cacheIdAddress)), 0
    )
    return u32(1)
}

// Original ABI symbol: cache_hal_get_cache_line_size.
trusted fun esp32CacheHalGetCacheLineSize(cacheLevel: u32): u32 {
    if (cacheLevel >= u32(2)) freestandingAbort()
    return if (cacheLevel == u32(1)) u32(4) else u32(0)
}

// Original ABI symbol: cache_hal_invalidate_addr. Classic ESP32 has no
// address-granular invalidation primitive and deliberately aborts this API.
trusted fun esp32CacheHalInvalidateAddr(address: u32, size: u32): void =
    freestandingAbort()
