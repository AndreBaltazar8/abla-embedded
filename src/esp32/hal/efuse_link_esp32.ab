import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEfuseHalInternals(): bool {
    if (!internalFunction("esp32EfuseHalGetMajorChipVersion", "efuse_hal_get_major_chip_version")) return false
    if (!internalFunction("esp32EfuseHalGetMinorChipVersion", "efuse_hal_get_minor_chip_version")) return false
    if (!internalFunction("esp32EfuseHalGetRatedFrequencyMhz", "efuse_hal_get_rated_freq_mhz")) return false
    if (!internalFunction("esp32EfuseHalSetTiming", "efuse_hal_set_timing")) return false
    if (!internalFunction("esp32EfuseHalRead", "efuse_hal_read")) return false
    if (!internalFunction("esp32EfuseHalClearProgramRegisters", "efuse_hal_clear_program_registers")) return false
    if (!internalFunction("esp32EfuseHalProgram", "efuse_hal_program")) return false
    if (!internalFunction("esp32EfuseHalIsCodingErrorInBlock", "efuse_hal_is_coding_error_in_block")) return false
    true
}
