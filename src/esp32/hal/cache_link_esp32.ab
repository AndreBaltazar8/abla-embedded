import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkCacheHalInternals(): bool {
    if (!internalFunction("esp32CacheHalInit", "cache_hal_init")) return false
    if (!internalFunction("esp32CacheHalSuspend", "cache_hal_suspend")) return false
    if (!internalFunction("esp32CacheHalResume", "cache_hal_resume")) return false
    if (!internalFunction("esp32CacheHalIsCacheEnabled", "cache_hal_is_cache_enabled")) return false
    if (!internalFunction("esp32CacheHalVaddrToCacheLevelId", "cache_hal_vaddr_to_cache_level_id")) return false
    if (!internalFunction("esp32CacheHalGetCacheLineSize", "cache_hal_get_cache_line_size")) return false
    if (!internalFunction("esp32CacheHalInvalidateAddr", "cache_hal_invalidate_addr")) return false
    true
}
