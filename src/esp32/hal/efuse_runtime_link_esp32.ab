import "abla/build"

compile fun esp32Idf6LinkEfuseHalRuntime(): bool {
    if (!internalFunction("esp32EfuseHalChipRevision", "efuse_hal_chip_revision")) return false
    if (!internalFunction("esp32EfuseHalFlashEncryptionEnabled", "efuse_hal_flash_encryption_enabled")) return false
    if (!internalFunction("esp32EfuseHalGetDisableWaferVersionMajor", "efuse_hal_get_disable_wafer_version_major")) return false
    true
}
