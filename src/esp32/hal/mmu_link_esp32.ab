import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMmuHalInternals(): bool {
    if (!internalFunction("esp32MmuHalCtxInit", "mmu_hal_ctx_init")) return false
    if (!internalFunction("esp32MmuHalUnmapAll", "mmu_hal_unmap_all")) return false
    if (!internalFunction("esp32MmuHalInit", "mmu_hal_init")) return false
    if (!internalFunction("esp32MmuHalPagesToBytes", "mmu_hal_pages_to_bytes")) return false
    if (!internalFunction("esp32MmuHalBytesToPages", "mmu_hal_bytes_to_pages")) return false
    if (!internalFunction("esp32MmuHalPaddrToVaddr", "mmu_hal_paddr_to_vaddr")) return false
    if (!internalFunction("esp32MmuHalCheckValidExtVaddrRegion", "mmu_hal_check_valid_ext_vaddr_region")) return false
    if (!internalFunction("esp32MmuHalMapRegion", "mmu_hal_map_region")) return false
    if (!internalFunction("esp32MmuHalUnmapRegion", "mmu_hal_unmap_region")) return false
    if (!internalFunction("esp32MmuHalVaddrToPaddr", "mmu_hal_vaddr_to_paddr")) return false
    true
}
