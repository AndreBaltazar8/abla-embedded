import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHalUtilsInternals(): bool {
    if (!internalFunction("esp32RecoveredHalUtilsCalcClkDivFracFast", "hal_utils_calc_clk_div_frac_fast")) return false
    if (!internalFunction("esp32RecoveredHalUtilsCalcClkDivFracAccurate", "hal_utils_calc_clk_div_frac_accurate")) return false
    if (!internalFunction("esp32RecoveredHalUtilsCalcClkDivInteger", "hal_utils_calc_clk_div_integer")) return false
    if (!internalFunction("esp32RecoveredHalUtilsFloatToFixedPoint32b", "hal_utils_float_to_fixed_point_32b")) return false
    true
}
