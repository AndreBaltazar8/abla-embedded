import "../dport_esp32.ab"
import "../../xtensa/assembly.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

val esp32MmuProTable = u32(1072758784)
val esp32MmuAppTable = u32(1072766976)
val esp32MmuInvalid = u32(256)
val esp32MmuEntryCount = u32(384)
val esp32MmuPsramEntryBegin = u32(1152)
val esp32MmuPsramEntryEnd = u32(1280)
val esp32MmuPageBytes = u32(65536)
val esp32MmuMaximumPhysicalAddress = u32(16777216)
val esp32MmuData = u32(1)
val esp32MmuInstruction = u32(2)
val esp32MmuFlash = u32(1)
val esp32MmuPsram = u32(2)

var esp32MmuCoreCount = u32(0)

@inline
trusted fun esp32MmuLoadU8(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32MmuStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
fun esp32MmuInRange(value: u32, begin: u32, end: u32): bool =
    value >= begin && value < end

@inline
fun esp32MmuRangeInside(
    begin: u32,
    end: u32,
    rangeBegin: u32,
    rangeEnd: u32
): bool = esp32MmuInRange(begin, rangeBegin, rangeEnd) &&
    esp32MmuInRange(end, rangeBegin, rangeEnd)

@inline
fun esp32MmuValidPhysicalRegion(begin: u32, length: u32): bool =
    begin < esp32MmuMaximumPhysicalAddress &&
    length < esp32MmuMaximumPhysicalAddress &&
    begin + length - u32(1) < esp32MmuMaximumPhysicalAddress

@inline
trusted fun esp32MmuTableAddress(mmuId: u32, entry: u32): u32 {
    if (mmuId == u32(0)) return esp32MmuProTable + (entry << u32(2))
    if (mmuId == u32(1)) return esp32MmuAppTable + (entry << u32(2))
    ablaRuntimeTrap()
    u32(0)
}

@inline
trusted fun esp32MmuWriteEntry(
    mmuId: u32,
    entry: u32,
    value: u32
): void {
    val state = xtensaRaiseInterruptLevel5()
    esp32DportWrite(esp32MmuTableAddress(mmuId, entry), value)
    xtensaRestoreProcessorState(state)
}

@inline
trusted fun esp32MmuReadEntry(mmuId: u32, entry: u32): u32 =
    esp32DportRead(esp32MmuTableAddress(mmuId, entry))

@inline
trusted fun esp32MmuEntryIsValid(entry: u32): bool {
    if (entry >= esp32MmuEntryCount) ablaRuntimeTrap()
    (esp32MmuReadEntry(u32(0), entry) & esp32MmuInvalid) == u32(0)
}

@inline
trusted fun esp32MmuEntryId(vaddr: u32): u32 {
    if (esp32MmuInRange(vaddr, u32(1061158912), u32(1065353216))) {
        return (vaddr & u32(4194303)) >>> u32(16)
    }
    if (esp32MmuInRange(vaddr, u32(1074593792), u32(1077936128))) {
        return u32(64) + ((vaddr & u32(4194303)) >>> u32(16))
    }
    if (esp32MmuInRange(vaddr, u32(1077936128), u32(1082130432))) {
        return u32(128) + ((vaddr & u32(4194303)) >>> u32(16))
    }
    if (esp32MmuInRange(vaddr, u32(1082130432), u32(1086324736))) {
        return u32(192) + ((vaddr & u32(4194303)) >>> u32(16))
    }
    if (esp32MmuInRange(vaddr, u32(1065353216), u32(1069547520))) {
        return esp32MmuPsramEntryBegin +
            ((vaddr & u32(2097151)) >>> u32(15))
    }
    ablaRuntimeTrap()
    u32(0)
}

@inline
trusted fun esp32MmuEntryVirtualBase(entryValue: u32, kind: u32): u32 {
    var entry = entryValue
    if (entry < u32(64)) {
        if (kind != esp32MmuData) return u32(0)
        return u32(1061158912) + (entry << u32(16))
    }
    if (entry < u32(128)) {
        if (kind != esp32MmuInstruction) return u32(0)
        entry = entry - u32(64)
        return u32(1073741824) + (entry << u32(16))
    }
    if (entry < u32(192)) {
        if (kind != esp32MmuInstruction) return u32(0)
        entry = entry - u32(128)
        return u32(1073741824) + (entry << u32(16))
    }
    if (entry < u32(256)) {
        if (kind != esp32MmuInstruction) return u32(0)
        entry = entry - u32(192)
        return u32(1073741824) + (entry << u32(16))
    }
    if (entry >= esp32MmuPsramEntryBegin &&
        entry < esp32MmuPsramEntryEnd) {
        if (kind != esp32MmuData) return u32(0)
        return u32(1065353216) +
            ((entry - esp32MmuPsramEntryBegin) << u32(15))
    }
    ablaRuntimeTrap()
    u32(0)
}

fun esp32MmuHalCtxInit(configAddress: u32): void {
    esp32MmuCoreCount = esp32MmuLoadU8(configAddress)
    return
}

trusted fun esp32MmuHalUnmapAll(): void {
    var core = u32(0)
    while (core < esp32MmuCoreCount) {
        var entry = u32(0)
        while (entry < esp32MmuEntryCount) {
            esp32MmuWriteEntry(core, entry, esp32MmuInvalid)
            entry = entry + u32(1)
        }
        core = core + u32(1)
    }
}

trusted fun esp32MmuHalInit(configAddress: u32): void {
    esp32MmuHalCtxInit(configAddress)
    esp32MmuHalUnmapAll()
}

fun esp32MmuHalPagesToBytes(mmuId: u32, pages: u32): u32 =
    pages << u32(16)

fun esp32MmuHalBytesToPages(mmuId: u32, bytes: u32): u32 =
    bytes >>> u32(16)

@section(".iram1.abla.mmu_hal_check_vaddr")
fun esp32MmuHalCheckValidExtVaddrRegion(
    mmuId: u32,
    begin: u32,
    length: u32,
    kind: u32
): u32 {
    val end = begin + length - u32(1)
    var valid = false
    if ((kind & esp32MmuData) != u32(0)) {
        valid = esp32MmuRangeInside(
            begin, end, u32(1065353216), u32(1069547520)
        ) || esp32MmuRangeInside(
            begin, end, u32(1061158912), u32(1065353216)
        )
    }
    if (!valid && (kind & esp32MmuInstruction) != u32(0)) {
        valid = esp32MmuRangeInside(
            begin, end, u32(1074593792), u32(1077936128)
        ) || esp32MmuRangeInside(
            begin, end, u32(1077936128), u32(1082130432)
        ) || esp32MmuRangeInside(
            begin, end, u32(1082130432), u32(1086324736)
        )
    }
    if (valid) u32(1) else u32(0)
}

@section(".iram1.abla.mmu_hal_map_region")
trusted fun esp32MmuHalMapRegion(
    mmuId: u32,
    target: u32,
    virtualAddressValue: u32,
    physicalAddress: u32,
    length: u32,
    outputLengthAddress: u32
): void {
    if ((virtualAddressValue & u32(65535)) != u32(0) ||
        (physicalAddress & u32(65535)) != u32(0) ||
        !esp32MmuValidPhysicalRegion(physicalAddress, length) ||
        esp32MmuHalCheckValidExtVaddrRegion(
            mmuId, virtualAddressValue, length,
            esp32MmuData | esp32MmuInstruction
        ) == u32(0)) ablaRuntimeTrap()
    var pages = (length + u32(65535)) >>> u32(16)
    esp32MmuStoreU32(outputLengthAddress, pages << u32(16))
    var virtualAddress = virtualAddressValue
    var mapValue = physicalAddress >>>
        (if (target == esp32MmuFlash) u32(16) else u32(15))
    while (pages != u32(0)) {
        esp32MmuWriteEntry(
            mmuId, esp32MmuEntryId(virtualAddress), mapValue
        )
        virtualAddress = virtualAddress + esp32MmuPageBytes
        mapValue = mapValue + u32(1)
        pages = pages - u32(1)
    }
}

@section(".iram1.abla.mmu_hal_unmap_region")
trusted fun esp32MmuHalUnmapRegion(
    mmuId: u32,
    virtualAddressValue: u32,
    length: u32
): void {
    if ((virtualAddressValue & u32(65535)) != u32(0) ||
        esp32MmuHalCheckValidExtVaddrRegion(
            mmuId, virtualAddressValue, length,
            esp32MmuData | esp32MmuInstruction
        ) == u32(0)) ablaRuntimeTrap()
    var pages = (length + u32(65535)) >>> u32(16)
    var virtualAddress = virtualAddressValue
    while (pages != u32(0)) {
        esp32MmuWriteEntry(
            mmuId, esp32MmuEntryId(virtualAddress), esp32MmuInvalid
        )
        virtualAddress = virtualAddress + esp32MmuPageBytes
        pages = pages - u32(1)
    }
}

trusted fun esp32MmuHalVaddrToPaddr(
    mmuId: u32,
    virtualAddress: u32,
    outputPhysicalAddress: u32,
    outputTarget: u32
): u32 {
    if (esp32MmuHalCheckValidExtVaddrRegion(
        mmuId, virtualAddress, u32(1),
        esp32MmuData | esp32MmuInstruction
    ) == u32(0)) ablaRuntimeTrap()
    val entry = esp32MmuEntryId(virtualAddress)
    if (!esp32MmuEntryIsValid(entry)) return u32(0)
    val target = if (entry >= esp32MmuPsramEntryBegin)
        esp32MmuPsram else esp32MmuFlash
    val pageShift = if (target == esp32MmuPsram) u32(15) else u32(16)
    val offsetMask = (u32(1) << pageShift) - u32(1)
    val physicalBase = esp32MmuReadEntry(mmuId, entry) << pageShift
    esp32MmuStoreU32(outputTarget, target)
    esp32MmuStoreU32(
        outputPhysicalAddress,
        physicalBase | (virtualAddress & offsetMask)
    )
    u32(1)
}

trusted fun esp32MmuHalPaddrToVaddr(
    mmuId: u32,
    physicalAddress: u32,
    target: u32,
    kind: u32,
    outputVirtualAddress: u32
): u32 {
    if (!esp32MmuValidPhysicalRegion(
        physicalAddress, u32(1)
    )) ablaRuntimeTrap()
    val pageShift = if (target == esp32MmuFlash) u32(16) else u32(15)
    val mapValue = physicalAddress >>> pageShift
    var entry = if (target == esp32MmuFlash)
        u32(0) else esp32MmuPsramEntryBegin
    val end = if (target == esp32MmuFlash)
        esp32MmuEntryCount else esp32MmuPsramEntryEnd
    var found = false
    while (!found && entry < end) {
        val value = esp32MmuReadEntry(u32(0), entry)
        found = (value & esp32MmuInvalid) == u32(0) &&
            value == mapValue
        if (!found) entry = entry + u32(1)
    }
    if (!found) return u32(0)
    val virtualBase = esp32MmuEntryVirtualBase(entry, kind)
    if (virtualBase == u32(0)) return u32(0)
    esp32MmuStoreU32(
        outputVirtualAddress,
        virtualBase | (physicalAddress & ((u32(1) << pageShift) - u32(1)))
    )
    u32(1)
}
