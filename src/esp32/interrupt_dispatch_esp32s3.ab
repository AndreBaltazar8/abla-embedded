import "./interrupt_dispatch_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
@inline
@export("esp32S3DispatchCore")
trusted fun esp32S3DispatchCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3DispatchEnabled")
trusted fun esp32S3DispatchEnabledHook(): int = int(xtensaGuardRead("rsr.intenable $0","=r,~{memory}"))
@inline
@export("esp32S3DispatchPending")
trusted fun esp32S3DispatchPendingHook(): int = int(xtensaGuardRead("rsr.interrupt $0","=r,~{memory}"))
@inline
@export("esp32S3DispatchClear")
trusted fun esp32S3DispatchClearHook(mask: int): void {
    xtensaGuardWrite("wsr.intclear $0\nrsync","r,~{memory}",u32(mask))
    return
}
@inline
@export("esp32S3DispatchRead")
trusted fun esp32S3DispatchReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3DispatchCall")
trusted fun esp32S3DispatchCallHook(handler: int,argument: int): void {
    callNativeVoidI32(handler,argument)
    return
}
