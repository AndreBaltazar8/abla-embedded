import "./interrupt_dispatch_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
@inline
trusted fun esp32S3DispatchCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3DispatchEnabled(): int = int(xtensaGuardRead("rsr.intenable $0","=r,~{memory}"))
@inline
trusted fun esp32S3DispatchPending(): int = int(xtensaGuardRead("rsr.interrupt $0","=r,~{memory}"))
@inline
trusted fun esp32S3DispatchClear(mask: int): void {
    xtensaGuardWrite("wsr.intclear $0\nrsync","r,~{memory}",u32(mask))
    return
}
@inline
trusted fun esp32S3DispatchRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3DispatchCall(handler: int,argument: int): void {
    callNativeVoidI32(handler,argument)
    return
}
