import "./gpio/probe_esp32s3.ab"
import "./gpio_probe_common.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
import "../hal/esp32_3.ab"

// ESP32-S3 GPIO output latch registers. Reading the latch instead of the pad
// level lets the detector restore even an input pin exactly: its next output
// transition will expose the same value it would have before the probe.
// 1610629124 = GPIO_OUT_REG (0x60004004), and 1610629136 = GPIO_OUT1_REG
// (0x60004010), from ESP-IDF 6's generated ESP32-S3 register map.
trusted fun gpioProbeEsp32S3OutputLevel(pin: int): bool {
    if (!espChipS3().gpioValid(pin)) return false
    val registerAddress = if (pin < 32) 1610629124 else 1610629136
    (mmioLoadU32(registerAddress) & (1 << (pin & 31))) != 0
}

@export("gpioProbeCaptureEsp32S3")
trusted fun gpioProbeCaptureEsp32S3Hook(pin: int): GpioProbePinState =
    gpioProbeCapture(pin, gpioProbeEsp32S3OutputLevel(pin))

// Fast write-one-to-set/clear paths used for the camera's temporary XCLK.
// These helpers deliberately accept only the low GPIO bank used by that probe.
@export("gpioProbeEsp32S3FastLow")
trusted fun gpioProbeEsp32S3FastLowHook(pin: int): bool {
    if (!espChipS3().gpioOutputValid(pin) || pin >= 32) return false
    mmioStoreU32(1610629132, 1 << pin) // GPIO_OUT_W1TC_REG, 0x6000400c
    true
}

@export("gpioProbeEsp32S3FastHigh")
trusted fun gpioProbeEsp32S3FastHighHook(pin: int): bool {
    if (!espChipS3().gpioOutputValid(pin) || pin >= 32) return false
    mmioStoreU32(1610629128, 1 << pin) // GPIO_OUT_W1TS_REG, 0x60004008
    true
}

@export("gpioProbeEsp32S3ClockCycles")
trusted fun gpioProbeEsp32S3ClockCyclesHook(pin: int, cycles: int): void {
    if (!espChipS3().gpioOutputValid(pin) || pin >= 32 || cycles <= 0) return
    val mask = 1 << pin
    var remaining = cycles
    while (remaining > 0) {
        mmioStoreU32(1610629132, mask)
        mmioStoreU32(1610629128, mask)
        remaining = remaining - 1
    }
    return
}
