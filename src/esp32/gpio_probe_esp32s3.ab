import "./gpio_probe_idf6.ab"
import "abla/unsafe/mmio"

// ESP32-S3 GPIO output latch registers. Reading the latch instead of the pad
// level lets the detector restore even an input pin exactly: its next output
// transition will expose the same value it would have before the probe.
// 1610629124 = GPIO_OUT_REG (0x60004004), and 1610629136 = GPIO_OUT1_REG
// (0x60004010), from ESP-IDF 6's generated ESP32-S3 register map.
trusted fun gpioProbeEsp32S3OutputLevel(pin: int): bool {
    if (pin < 0 || pin >= 49) return false
    val registerAddress = if (pin < 32) 1610629124 else 1610629136
    (mmioLoadU32(registerAddress) & (1 << (pin & 31))) != 0
}

trusted fun gpioProbeCaptureEsp32S3(pin: int): GpioProbePinState =
    gpioProbeCapture(pin, gpioProbeEsp32S3OutputLevel(pin))
