import "./irq_config_p4_sequence.ab"
import "./irq_entry_esp32p4.ab"
import "./clic_esp32p4.ab"
import "../riscv/memory.ab"
trusted noescape extern:"inline-assembly" fun p4IrqHartInstruction(template: string,constraints: string): u32
trusted fun p4IrqConfigCurrentCore(): int = int(p4IrqHartInstruction("csrr $0, mhartid","=r,~{memory}"))
trusted fun p4IrqConfigMachineStatus(): u32 = riscvMachineStatus()
trusted fun p4IrqConfigLineEnabled(line: int): bool = (p4ClicReadByte(p4ClicLineAddress(line)+1)&1) != 0
trusted fun p4IrqConfigStorage(core: int): NativeBuffer = nativeBufferAt(esp32P4IrqConfigAddress()+core*16,16)
trusted fun p4IrqConfigFence(): void = riscvDeviceMemoryFence()
