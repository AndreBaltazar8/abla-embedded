import "./irq_config_p4_sequence.ab"
import "./irq_entry_esp32p4.ab"
import "./clic_esp32p4.ab"
import "../riscv/memory.ab"
import "../hal/esp32.ab"
import "../riscv/machine_status.ab"
import "./clic_p4_sequence.ab"
import "./sdk/raw_buffer.ab"
import "../hal/native_buffer.ab"
import "./sdk/nativebuffer_type.ab"
trusted noescape extern:"inline-assembly" fun p4IrqHartInstruction(template: string,constraints: string): u32
@export("p4IrqConfigCurrentCore")
trusted fun p4IrqConfigCurrentCoreHook(): int = int(p4IrqHartInstruction("csrr $0, mhartid","=r,~{memory}"))
@export("p4IrqConfigMachineStatus")
trusted fun p4IrqConfigMachineStatusHook(): u32 = riscvMachineStatus()
@export("p4IrqConfigLineEnabled")
trusted fun p4IrqConfigLineEnabledHook(line: int): bool = (p4ClicReadByte(p4ClicLineAddress(line)+1)&1) != 0
@export("p4IrqConfigStorage")
trusted fun p4IrqConfigStorageHook(core: int): NativeBuffer = nativeBufferAt(esp32P4IrqConfigAddress()+core*16,16)
@export("p4IrqConfigFence")
trusted fun p4IrqConfigFenceHook(): void = riscvDeviceMemoryFence()
