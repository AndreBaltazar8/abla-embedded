import "./ahb_gdma_pump_p4_sequence.ab"
import "./ahb_gdma_acquire_esp32p4.ab"
import "./ahb_gdma_rearm_esp32p4.ab"
trusted fun p4AhbPumpAcquire(channel: int,transmit: bool,descriptors: int,count: int,
    buffers: int,stride: int,bytes: int,index: int,polls: int): int =
    esp32p4AhbGdmaAcquireBlockOwned(channel,transmit,descriptors,count,buffers,stride,bytes,index,true,polls,true) | 0
trusted fun p4AhbPumpRearm(descriptors: int,count: int,buffers: int,stride: int,
    bytes: int,index: int,transmit: bool,polls: int): int =
    esp32p4AhbGdmaRearmBlockOwned(descriptors,count,buffers,stride,bytes,index,transmit,true,polls,true)
// Owner/cache acquisition completed. Volatile accesses retain explicit copy
// order and avoid implicit libc memcpy. Unaligned buffers and tails are safe.
trusted fun p4AhbPumpCopy(destination: int,source: int,bytes: int): void {
    var offset=0
    if (((destination|source)&3) == 0) {
        while (offset+4 <= bytes) {
            mmioStoreU32(destination+offset,mmioLoadU32(source+offset));offset=offset+4
        }
    }
    while (offset < bytes) { mmioStoreU8(destination+offset,mmioLoadU8(source+offset));offset=offset+1 }
    return
}
