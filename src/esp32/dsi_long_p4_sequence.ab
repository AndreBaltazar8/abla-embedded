import "./dsi_short_p4_sequence.ab"
import "./sdk/raw_buffer.ab"
// Generic(0x29) or DCS(0x39) long packet; DCS payload INCLUDES command byte.
// Matches IDF payload-before-header ordering, little-endian padded FIFO words.
// Length1..65535; selected host FIFO capacity can impose a smaller practical
// bound. No automatic packet splitting: that can change panel semantics.
// New statuses7 payload timeout,8 header timeout. payloadStaged() requires
// explicit host recovery before reuse on failure; never silently replay.
trusted fun esp32P4DsiLongWriteOwned(channel: int,dataType: int,payload: NativeBuffer,length: int,polls: int): DsiCommandResult {
    if (channel < 0 || channel > 3 || (dataType != 41 && dataType != 57) || length < 1 || length > 65535 ||
        !payload.hasAddressRange(0,length) || polls < 1 || polls > 1000000) return DsiCommandResult(2)
    if (!esp32P4DsiWaitIdleOwned(polls)) return DsiCommandResult(3)
    val before=esp32P4DsiErrorSnapshotOwned()
    if (before != 0) return DsiCommandResult(before|4)
    var offset=0
    var staged=0
    while (offset < length) {
        var word=u32(0)
        var byte=0
        while (byte < 4 && offset+byte < length) {
            word=word|(u32(payload.load(offset+byte))<<u32(byte*8))
            byte=byte+1
        }
        if (esp32P4DsiWritePayloadOwned(word,polls) != 1) return DsiCommandResult(esp32P4DsiErrorSnapshotOwned()|staged|7)
        staged=32
        offset=offset+byte
    }
    val header=dsiPacketHeader(channel,dataType,length&255,(length>>>8)&255)
    if (esp32P4DsiSubmitHeaderOwned(header,polls) != 1) return DsiCommandResult(esp32P4DsiErrorSnapshotOwned()|32|8)
    val complete=esp32P4DsiWaitIdleOwned(polls)
    val errors=esp32P4DsiErrorSnapshotOwned()
    DsiCommandResult(errors|48|(if (!complete) 5 else if (errors != 0) 6 else 1))
}
