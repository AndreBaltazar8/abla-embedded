import "./clock_resume_c5_sequence.ab"
import "./cpu_clock_esp32c5.ab"
import "./pll_start_esp32c5.ab"
import "./power/pvt_restart_esp32c5.ab"
@section(".iram1.abla.c5ResumePll")
trusted fun c5ClockResumePll(record: NativeBuffer,readLimit: int): int = esp32C5PllStartOwned(record,true,readLimit)
@section(".iram1.abla.c5ResumePvt")
trusted fun c5ClockResumePvt(record: NativeBuffer): int = esp32C5PvtRestartOwned(record,true)
@section(".iram1.abla.c5ResumeRead")
trusted fun c5ClockResumeRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5ResumeWrite")
trusted fun c5ClockResumeWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
@section(".iram1.abla.c5ResumeDelay")
trusted fun c5ClockResumeDelay(us: int): void { callNativeVoidI32(0x4000003c,us);return }
