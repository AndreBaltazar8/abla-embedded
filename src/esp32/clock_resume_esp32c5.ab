import "./clock_resume_c5_sequence.ab"
import "./cpu_clock_esp32c5.ab"
import "./pll_start_esp32c5.ab"
import "./power/pvt_restart_esp32c5.ab"
import "../hal/esp32.ab"
import "./sdk/raw_buffer.ab"
import "./pll_start_c5_sequence.ab"
import "./power/pvt_restart_c5_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "./sdk/nativebuffer_type.ab"
@section(".iram1.abla.c5ResumePll")
@export("c5ClockResumePll")
trusted fun c5ClockResumePllHook(record: NativeBuffer,readLimit: int): int = esp32C5PllStartOwned(record,true,readLimit)
@section(".iram1.abla.c5ResumePvt")
@export("c5ClockResumePvt")
trusted fun c5ClockResumePvtHook(record: NativeBuffer): int = esp32C5PvtRestartOwned(record,true)
@section(".iram1.abla.c5ResumeRead")
@export("c5ClockResumeRead")
trusted fun c5ClockResumeReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5ResumeWrite")
@export("c5ClockResumeWrite")
trusted fun c5ClockResumeWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
@section(".iram1.abla.c5ResumeDelay")
@export("c5ClockResumeDelay")
trusted fun c5ClockResumeDelayHook(us: int): void { callNativeVoidI32(0x4000003c,us);return }
