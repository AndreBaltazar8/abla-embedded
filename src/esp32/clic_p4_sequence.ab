// P4 CLIC current-core window (not an absolute core0 address). Caller executes
// on the owning core and serializes line/global configuration. Global nlbits
// must already be3. We never modify global threshold/vector/privilege state.
// Byte writes isolate IE/attributes/priority from the pending latch: a word
// RMW could replay a pending edge. Lines16..47 are external peripheral lines.
fun p4ClicLineValid(line: int): bool = line >= 16 && line <= 47
fun p4ClicLineAddress(line: int): int = 0x20801000+line*4
// Boot-only current-core setup. Requires MIE disabled AND every local/external
// line disabled before changing global priority partitioning. Does not install
// mtvec/mtvt or change thresholds, pending bits, priorities or enable state.
// 1configured/already configured,3not quiesced,4readback failure.
trusted fun esp32P4ClicInitializeOwned(): int {
    if ((p4ClicMachineStatus()&u32(8)) != u32(0)) return 3
    val before=p4ClicReadConfig()
    if (((before>>>1)&15) == 3) return 1
    var line=0
    while (line < 48) {
        if ((p4ClicReadByte(p4ClicLineAddress(line)+1)&1) != 0) return 3
        line=line+1
    }
    p4ClicWriteConfig((before&4294967265)|6)
    return if (((p4ClicReadConfig()>>>1)&15) == 3) 1 else 4
}
// 1configured,2invalid,3enabled/pending/global configuration mismatch,
// 4readback failure. Configuration never enables or clears pending delivery.
trusted fun esp32P4ClicConfigureOwned(line: int,priority: int,trigger: int,vectored: bool): int {
    if (!p4ClicLineValid(line) || priority < 1 || priority > 7 || (trigger != 0 && trigger != 1 && trigger != 3)) return 2
    val address=p4ClicLineAddress(line)
    if (((p4ClicReadConfig()>>>1)&15) != 3 || (p4ClicReadByte(address+1)&1) != 0 || (p4ClicReadByte(address)&1) != 0) return 3
    val attribute=(p4ClicReadByte(address+2)&248)|(trigger<<1)|(if (vectored) 1 else 0)
    p4ClicWriteByte(address+2,attribute)
    if ((p4ClicReadByte(address+2)&7) != (attribute&7)) return 4
    val control=(p4ClicReadByte(address+3)&31)|(priority<<5)
    p4ClicWriteByte(address+3,control)
    if ((p4ClicReadByte(address+3)&224) != (priority<<5)) return 4
    return 1
}
// Enabling requires the correct trap/vector handler already installed and
// source/CPU ownership established. Disable is not a handler join or pending
// clear. Priority0 is refused on enable; delivery can begin immediately.
trusted fun esp32P4ClicEnableOwned(line: int,enabled: bool): int {
    if (!p4ClicLineValid(line)) return 2
    val address=p4ClicLineAddress(line)
    if (enabled && (((p4ClicReadConfig()>>>1)&15) != 3 || (p4ClicReadByte(address+3)&224) == 0)) return 3
    val before=p4ClicReadByte(address+1)
    val wanted=(before&254)|(if (enabled) 1 else 0)
    if (before != wanted) p4ClicWriteByte(address+1,wanted)
    return if ((p4ClicReadByte(address+1)&1) == (wanted&1)) 1 else 4
}
