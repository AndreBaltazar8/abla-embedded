import "../xtensa/assembly.ab"

// Classic dual-core ESP32 DPORT read workaround, expressed directly in typed
// Xtensa assembly. It masks level-3 interrupts, performs the mandatory APB
// pre-read, restores PS, and therefore replaces the ESP-IDF C helper.

@naked
@section(".iram1.text")
trusted fun esp32DportReadAbi(address: u32): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nrsil a9, 5\nmovi a8, 0x3ff40078\nl32i a8, a8, 0\nl32i a2, a2, 0\nwsr a9, ps\nrsync\nretw.n",
    "~{memory}"
)

// Calls made within Abla use ordinary typed operands. The naked ABI leaf above
// owns a complete foreign-call frame and must not be reused as an internal
// function, because Abla's direct-call convention also carries arity in a2.
@inline
trusted fun esp32DportRead(address: u32): u32 =
    xtensaAssemblyReadU32WithU32(
        "rsil a3, 5\nmovi a4, 0x3ff40078\nl32i a4, a4, 0\nl32i $0, $1, 0\nwsr a3, ps\nrsync",
        "=a,a,~{a3},~{a4},~{memory}",
        address
    )

@inline
trusted fun esp32DportWrite(address: u32, value: u32): void =
    xtensaAssemblyWriteU32U32(
        "memw\ns32i $1, $0, 0\nmemw", "a,a,~{memory}", address, value
    )

@inline
trusted fun esp32DportUpdate(
    address: u32,
    clearMask: u32,
    setMask: u32
): u32 {
    val next = (esp32DportRead(address) & ~clearMask) | setMask
    esp32DportWrite(address, next)
    next
}

trusted fun esp32CurrentCpuFrequencyMegahertz(): int {
    val selection = int(esp32DportRead(u32(1072693308)) & u32(3))
    if (selection == 0) 80 else if (selection == 1) 160 else 240
}
