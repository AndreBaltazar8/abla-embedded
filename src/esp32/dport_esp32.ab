import "../xtensa/assembly.ab"

// Classic dual-core ESP32 DPORT read workaround. The interrupt-level and
// processor-state operations are architecture instructions; both reads are
// optimizer-visible volatile LLVM operations.
@inline
trusted fun esp32DportRead(address: u32): u32 {
    val processorState = xtensaRaiseInterruptLevel5()
    // ESP32 ECO 3.11 requires one APB read before the requested DPORT read.
    // Both accesses remain volatile, while their addresses and result are now
    // visible to LLVM instead of being hidden in one assembly template.
    xtensaDeviceLoadU32(u32(1072955512))
    val result = xtensaDeviceLoadU32(address)
    xtensaRestoreProcessorState(processorState)
    result
}

// Opaque SDK members still call this ABI name repeatedly. A shared typed leaf
// is smaller than inlining the workaround at every legacy call site, remains
// internal to the monolithic module, and disappears when the callers do.
@noinline
@section(".iram1.0.abla.esp32DportReadShared")
trusted fun esp32DportReadShared(address: u32): u32 =
    esp32DportRead(address)

@noinline
@section(".iram1.abla.esp32DportSequenceReadShared")
trusted fun esp32DportSequenceReadShared(address: u32): u32 {
    xtensaDeviceLoadU32(u32(1072955512))
    xtensaDeviceLoadU32(address)
}

@inline
trusted fun esp32DportWrite(address: u32, value: u32): void {
    xtensaDeviceStoreU32(address, value)
}

@inline
trusted fun esp32DportUpdate(
    address: u32,
    clearMask: u32,
    setMask: u32
): u32 {
    val next = (esp32DportRead(address) & ~clearMask) | setMask
    esp32DportWrite(address, next)
    next
}

trusted fun esp32CurrentCpuFrequencyMegahertz(): int {
    val selection = int(esp32DportRead(u32(1072693308)) & u32(3))
    if (selection == 0) 80 else if (selection == 1) 160 else 240
}
