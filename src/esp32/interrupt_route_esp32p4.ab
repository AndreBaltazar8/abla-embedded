import "./interrupt_route_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("p4InterruptRouteRead")
trusted fun p4InterruptRouteReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("p4InterruptRouteWrite")
trusted fun p4InterruptRouteWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value)); return }
