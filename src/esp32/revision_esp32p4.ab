import "./revision_p4.ab"
import "abla/unsafe/mmio"
// Read-only ROM-loaded shadow, identical offset in hw_ver1 and hw_ver3.
// Caller executes on P4 after ROM eFuse loading with APB access available.
// No eFuse commands, programming, reset or clock writes.
trusted fun esp32P4ChipRevision(): int = esp32P4RevisionFromEfuse(u32(mmioLoadU32(0x5012d04c)))
trusted fun esp32P4ChipRegisterLayout(): int = esp32P4RegisterLayout(esp32P4ChipRevision())
