// ESP-IDF v6.0.2 two-point coefficients, using measured/decoded 12-bit ADC
// readings at150mV and850mV. No fuse access or fallback reference assumption.
import "./adc_calibration_logic.ab"
// Bounded nonnegative division for coefficient numerators <=157297647.
// Classic ESP32 lacks hardware integer divide; avoid a linked libc helper.
fun esp32AdcCoefficientDivide(numerator: int,denominator: int): int {
    var quotient=0; var bit=134217728
    while (bit > 0) {
        val trial=quotient+bit
        if (trial*denominator <= numerator) quotient=trial
        bit=bit/2
    }
    return quotient
}
fun esp32AdcTwoPointScale(unit: int,attenuation: int): int {
    if (unit == 1) return if (attenuation == 0) 65504 else if (attenuation == 1) 86975 else if (attenuation == 2) 120389 else 224310
    return if (attenuation == 0) 65467 else if (attenuation == 1) 86861 else if (attenuation == 2) 120416 else 224708
}
fun esp32AdcTwoPointOffset(unit: int,attenuation: int): int {
    if (unit == 1) return if (attenuation == 0) 0 else if (attenuation == 1) 1 else if (attenuation == 2) 27 else 54
    return if (attenuation == 0) 0 else if (attenuation == 1) 9 else if (attenuation == 2) 26 else 66
}
fun esp32AdcTwoPointValid(unit: int,attenuation: int,low: int,high: int): bool =
    unit >= 1 && unit <= 2 && attenuation >= 0 && attenuation <= 3 && low >= 0 && high > low && high <= 4095
// Q16 slope, -1 invalid. Signed intercept is intentionally NOT unsigned:
// legitimate negative offsets must not wrap into enormous voltages.
fun esp32AdcTwoPointSlope(unit: int,attenuation: int,low: int,high: int): int =
    if (!esp32AdcTwoPointValid(unit,attenuation,low,high)) -1 else
    esp32AdcCoefficientDivide(700*esp32AdcTwoPointScale(unit,attenuation)+(high-low)/2,high-low)
// Caller validates points first; negative intercept itself is legitimate.
fun esp32AdcTwoPointIntercept(unit: int,attenuation: int,low: int,high: int): int =
    if (!esp32AdcTwoPointValid(unit,attenuation,low,high)) -1 else
    850-esp32AdcCoefficientDivide(700*high+(high-low)/2,high-low)+esp32AdcTwoPointOffset(unit,attenuation)
// -1 invalid input or negative extrapolated voltage (outside usable range).
// nonlinearVref may be0 only outside attenuation3's nonlinear region; inside,
// require an explicit measured/eFuse995..1205mV reference. This avoids the
// IDF TP calloc-initialized Vref0 being used in nonlinear interpolation.
fun esp32AdcTwoPointMillivolts(unit: int,attenuation: int,width: int,raw: int,low: int,high: int,nonlinearVref: int): int {
    val a=esp32AdcTwoPointSlope(unit,attenuation,low,high)
    if (a < 0 || width < 9 || width > 12 || raw < 0) return -1
    val samples=if (width == 9) 512 else if (width == 10) 1024 else if (width == 11) 2048 else 4096
    if (raw >= samples) return -1
    val adc=raw*(if (width == 9) 8 else if (width == 10) 4 else if (width == 11) 2 else 1)
    val linear=(a*adc+32768)/65536+esp32AdcTwoPointIntercept(unit,attenuation,low,high)
    if (linear < 0) return -1
    if (attenuation == 3 && adc >= 2880 && (nonlinearVref < 995 || nonlinearVref > 1205)) return -1
    return esp32AdcCorrectNonlinear(unit,attenuation,adc,nonlinearVref,linear)
}
