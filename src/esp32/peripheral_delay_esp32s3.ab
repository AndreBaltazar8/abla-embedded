import "./gpio/probe_esp32s3.ab"

trusted fun peripheralDelayMicroseconds(microseconds: int): void {
    var remaining = microseconds
    while (remaining > 0) {
        val chunk = if (remaining > 1000) 1000 else remaining
        esp_rom_delay_us(u32(chunk))
        remaining = remaining - chunk
    }
    return
}

// Bare-metal peripheral settling delay. ROM supplies calibrated microseconds;
// this is a busy wait, not a scheduler yield. Do not call under interrupt masks
// or from an ISR. A scheduled platform should select a yielding provider.
trusted fun peripheralDelayMilliseconds(milliseconds: int): void {
    var remaining = milliseconds
    while (remaining > 0) {
        esp_rom_delay_us(u32(1000))
        remaining = remaining - 1
    }
    return
}
