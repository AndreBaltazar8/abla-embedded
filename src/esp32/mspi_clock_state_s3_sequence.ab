// Exact SPI0 clock state used by sleep's controlSpi1=false path. Both clock
// registers contain N/H/L[23:0] plus bypass[31]; do not lose bypass on restore.
// Reserved bits are never written by restoration. SPI1 command clock untouched.
type Esp32S3MspiClockState = int
@inline
fun Esp32S3MspiClockState.valid(): bool = (this & (1<<52)) != 0
@section(".iram1.abla.s3MspiClockCapture")
trusted fun esp32S3MspiClockCaptureOwned(psram: bool): Esp32S3MspiClockState {
    val core=esp32S3MspiClockRead(0x600030EC) & 3
    val flash=esp32S3MspiClockRead(0x60003014)
    val flashPacked=(flash & 0xFFFFFF) | ((flash>>>7) & 0x1000000)
    var ramPacked=0
    if (psram) {
        val ram=esp32S3MspiClockRead(0x60003050)
        ramPacked=(ram & 0xFFFFFF) | ((ram>>>7) & 0x1000000)
    }
    Esp32S3MspiClockState(core | (flashPacked<<2) | (ramPacked<<27) | (1<<52) | (if (psram) 1<<53 else 0))
}

// All caches frozen and clients quiesced. Restore only after CPU source/PLL
// is compatible with the saved MSPI clocks; restore tuning before unfreezing.
@section(".iram1.abla.s3MspiClockRestore")
trusted fun esp32S3MspiClockRestoreOwned(saved: Esp32S3MspiClockState): bool {
    if (!saved.valid()) return false
    val flash=(saved>>>2) & 0x1FFFFFF
    esp32S3MspiClockUpdate(0x600030EC,3,saved & 3)
    esp32S3MspiClockUpdate(0x60003014,0x80FFFFFF,(flash & 0xFFFFFF) | ((flash & 0x1000000)<<7))
    if ((saved & (1<<53)) != 0) {
        val ram=(saved>>>27) & 0x1FFFFFF
        esp32S3MspiClockUpdate(0x60003050,0x80FFFFFF,(ram & 0xFFFFFF) | ((ram & 0x1000000)<<7))
    }
    true
}
