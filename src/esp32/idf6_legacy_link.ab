import "abla/build"

// Transitional link boundary for mixed Abla/ESP-IDF builds. Ordinary ESP32
// implementations stay internal; importing this module does nothing by itself.
// A firmware that still links opaque ESP-IDF archives must explicitly call this
// compile-time function so only the foreign names those archives require become
// roots. Remove each request together with its final opaque caller.
compile fun esp32Idf6LinkLegacyOpaqueArchives(): bool {
    if (!exportFunction("esp32DportReadAbi", "esp_dport_access_reg_read")) return false
    if (!exportFunction("freestandingCopy", "memcpy")) return false
    if (!exportFunction("freestandingMove", "memmove")) return false
    if (!exportFunction("freestandingSet", "memset")) return false
    if (!exportFunction("freestandingZero", "bzero")) return false
    if (!exportFunction("freestandingCompare", "memcmp")) return false
    if (!exportFunction("freestandingFindByte", "memchr")) return false
    if (!exportFunction("freestandingStringLengthBounded", "strnlen")) return false
    if (!exportFunction("freestandingStringCompare", "strcmp")) return false
    if (!exportFunction("freestandingStringCompareBounded", "strncmp")) return false
    if (!exportFunction("freestandingStringCompareCaseInsensitiveBounded", "strncasecmp")) return false
    if (!exportFunction("freestandingStringCopy", "strcpy")) return false
    if (!exportFunction("freestandingStringCopyBounded", "strncpy")) return false
    if (!exportFunction("freestandingStringCopySized", "strlcpy")) return false
    if (!exportFunction("freestandingStringAppend", "strcat")) return false
    if (!exportFunction("freestandingStringAppendSized", "strlcat")) return false
    if (!exportFunction("freestandingStringFind", "strchr")) return false
    if (!exportFunction("freestandingStringFindLast", "strrchr")) return false
    if (!exportFunction("freestandingStringSpanNotIn", "strcspn")) return false
    if (!exportFunction("freestandingStringFindString", "strstr")) return false
    if (!exportFunction("freestandingUnsignedDivide", "__udivdi3")) return false
    if (!exportFunction("freestandingUnsignedRemainder", "__umoddi3")) return false
    if (!exportFunction("freestandingSignedDivide", "__divdi3")) return false
    if (!exportFunction("freestandingSignedRemainder", "__moddi3")) return false
    if (!exportFunction("freestandingPopulationCount32", "__popcountsi2")) return false
    if (!exportFunction("freestandingByteSwap32", "__bswapsi2")) return false
    if (!exportFunction("freestandingByteSwap64", "__bswapdi2")) return false
    if (!exportFunction("freestandingAbort", "abort")) return false
    if (!exportFunction("esp32WpaSha1Vector", "sha1_vector")) return false
    if (!exportFunction("esp32WpaSha256Vector", "sha256_vector")) return false
    if (!exportFunction("esp32WpaHmacSha1Vector", "hmac_sha1_vector")) return false
    if (!exportFunction("esp32WpaHmacSha256Vector", "hmac_sha256_vector")) return false
    if (!exportFunction("esp32WpaPbkdf2Sha1", "pbkdf2_sha1")) return false
    if (!exportFunction("esp32WpaAes128CbcEncrypt", "aes_128_cbc_encrypt")) return false
    if (!exportFunction("esp32WpaAes128CbcDecrypt", "aes_128_cbc_decrypt")) return false
    if (!exportFunction("esp32WpaOmac1Aes128", "omac1_aes_128")) return false
    if (!exportFunction("esp32VendorCipherMicLength", "ieee80211_get_cipher_mic_len")) return false
    if (!exportFunction("esp32VendorCryptoEncap", "ieee80211_crypto_encap")) return false
    if (!exportFunction("esp32VendorCryptoDecap", "ieee80211_crypto_decap")) return false
    if (!exportFunction("esp32VendorCryptoBipEncrypt", "ieee80211_crypto_bip_encrypt")) return false
    if (!exportFunction("esp32VendorCryptoBipCmacDecrypt", "ieee80211_crypto_aes_128_cmac_decrypt")) return false
    if (!exportFunction("esp32VendorCryptoBipGmacDecrypt", "ieee80211_crypto_gmac_decrypt")) return false
    if (!exportFunction("esp32VendorCcmpEncrypt", "ieee80211_ccmp_encrypt")) return false
    if (!exportFunction("esp32VendorCcmpDecrypt", "ieee80211_ccmp_decrypt")) return false
    if (!exportFunction("esp32VendorCcmpDecryptEspNow", "ieee80211_decrypt_espnow_pkt")) return false
    if (!exportFunction("esp32VendorRfidReceive", "ieee80211_rfid_locp_recv")) return false
    if (!exportFunction("esp32HalCryptoInitialize", "hal_crypto_init")) return false
    if (!exportFunction("esp32HalCryptoManagementReceiveEnabled", "hal_crypto_mgmt_rx_enabled")) return false
    if (!exportFunction("esp32HalCryptoClearKeyEntry", "hal_crypto_clr_key_entry")) return false
    if (!exportFunction("esp32HalCryptoEnable", "hal_crypto_enable")) return false
    if (!exportFunction("esp32HalCryptoDisable", "hal_crypto_disable")) return false
    if (!exportFunction("esp32HalCryptoSetKeyEntry", "hal_crypto_set_key_entry")) return false
    if (!exportFunction("esp32MacRxEndState", "hal_mac_rx_get_end_state")) return false
    if (!exportFunction("esp32MacRxLastDescriptor", "hal_mac_rx_get_last_dscr")) return false
    if (!exportFunction("esp32MacRxDescriptorReloading", "hal_mac_rx_is_dscr_reload")) return false
    if (!exportFunction("esp32MacRxSetDescriptorReload", "hal_mac_rx_set_dscr_reload")) return false
    if (!exportFunction("esp32MacRxEndInformation", "hal_mac_rx_get_end_info")) return false
    if (!exportFunction("esp32WifiGpioDebug", "wifi_gpio_debug")) return false
    if (!exportFunction("esp32PacketDebugDump", "dbg_lmac_statis_dump")) return false
    if (!exportFunction("esp32PacketDebugResetPowerCounters", "dbg_lmac_ps_statis_reset")) return false
    if (!exportFunction("esp32PacketDebugInitialize", "dbg_lmac_init")) return false
    if (!exportFunction("esp32PacketTimerDoProcess", "pp_timer_do_process")) return false
    if (!exportFunction("esp32PacketTimerProcess", "pp_timer_process")) return false
    if (!exportFunction("esp32AmpduStoreSessions", "hal_ba_session_store")) return false
    if (!exportFunction("esp32AmpduRestoreSessions", "hal_ba_session_restore")) return false
    if (!exportFunction("esp32AmpduRestoreSession", "hal_ba_session_restore_by_hw_index")) return false
    if (!exportFunction("esp32EnableStationTsf", "hal_enable_sta_tsf")) return false
    if (!exportFunction("esp32DisableStationTsf", "hal_disable_sta_tsf")) return false
    if (!exportFunction("esp32EnableNanTsf", "hal_enable_nan_tsf")) return false
    if (!exportFunction("esp32DisableNanTsf", "hal_disable_nan_tsf")) return false
    if (!exportFunction("esp32DisableSoftApTsf", "hal_disable_softap_tsf")) return false
    if (!exportFunction("esp32RadioTemperatureSensorRead", "temprature_sens_read")) return false
    if (!exportFunction("esp32PhyChangeChannelWithoutMac", "phy_change_channel_nomac")) return false
    if (!exportFunction("esp32BluetoothCoexistenceHighPriority", "coex_bt_high_prio")) return false
    if (!exportFunction("esp32RateControlSetBasicRate", "RC_SetBasicRate")) return false
    if (!exportFunction("esp32RateControlAckTime", "RC_GetAckTime")) return false
    if (!exportFunction("esp32RateControlCtsTime", "RC_GetCtsTime")) return false
    if (!exportFunction("esp32RateControlBlockAckTime", "RC_GetBlockAckTime")) return false
    if (!exportFunction("esp32SnifferEnable", "hal_sniffer_enable")) return false
    if (!exportFunction("esp32SnifferDisable", "hal_sniffer_disable")) return false
    if (!exportFunction("esp32SnifferSetPromiscuous", "hal_sniffer_rx_set_promis")) return false
    if (!exportFunction("esp32SnifferClearStatistics", "hal_sniffer_rx_clr_statistics")) return false
    if (!exportFunction("esp32Ieee80211GetTrafficIdentifier", "ieee80211_gettid")) return false
    if (!exportFunction("esp32Ieee80211SetShortSlotTime", "ieee80211_set_shortslottime")) return false
    if (!exportFunction("esp32Ieee80211UpdateWmeParameters", "ieee80211_wme_updateparams")) return false
    if (!exportFunction("esp32Ieee80211ConnectBss", "ieee80211_mlme_connect_bss")) return false
    if (!exportFunction("esp32Ieee80211PhyType", "ieee80211_phy_type_get")) return false
    if (!exportFunction("esp32Ieee80211PhyModeShow", "ieee80211_phy_mode_show")) return false
    if (!exportFunction("esp32Ieee80211PhyInitialize", "ieee80211_phy_init")) return false
    if (!internalFunction("esp32Ieee80211BandName", "band2str")) return false
    if (!exportFunction("esp32Ieee80211GetTransmitInfo", "ieee80211_get_tx_info_from_eb")) return false
    if (!exportFunction("esp32Ieee80211FindInformationElement", "ieee80211_find_ie")) return false
    if (!internalFunction("esp32Ieee80211IsRobustManagementFrame", "ieee80211_is_robust_mgmt_frm")) return false
    if (!exportFunction("esp32Ieee80211CreateSoftAp", "wifi_create_softap")) return false
    if (!internalFunction("esp32Ieee80211DestroyStation", "wifi_destroy_sta")) return false
    if (!exportFunction("esp32Ieee80211DestroySoftAp", "wifi_destroy_softap")) return false
    if (!internalFunction("esp32Ieee80211DestroyNan", "wifi_destroy_nan")) return false
    if (!internalFunction("esp32Ieee80211SetMode", "wifi_mode_set")) return false
    if (!internalFunction("esp32Ieee80211Attach", "ieee80211_ifattach")) return false
    if (!internalFunction("esp32Ieee80211Detach", "ieee80211_ifdetach")) return false
    if (!exportFunction("esp32Ieee80211SendActionRegister", "ieee80211_send_action_register")) return false
    if (!exportFunction("esp32Ieee80211SendAction", "ieee80211_send_action")) return false
    if (!exportFunction("esp32Ieee80211ReceiveActionRegister", "ieee80211_recv_action_register")) return false
    if (!exportFunction("esp32Ieee80211ReceiveAction", "ieee80211_recv_action")) return false
    if (!exportFunction("esp32VendorActionGetKey", "get_iav_key")) return false
    if (!exportFunction("esp32WifiLog", "wifi_log")) return false
    if (!exportFunction("esp32WifiDebugDump", "dbg_hmac_statis_dump")) return false
    if (!exportFunction("esp32WifiManagementFrame", "ieee80211_getmgtframe")) return false
    if (!exportFunction("esp32WifiBeaconFrame", "ieee80211_getbcnframe")) return false
    if (!exportFunction("esp32MiscNvsDeinitialize", "misc_nvs_deinit")) return false
    if (!exportFunction("esp32MiscNvsInitialize", "misc_nvs_init")) return false
    if (!internalFunction("esp32MiscNvsRestore", "misc_nvs_restore")) return false
    if (!internalFunction("esp32RecoveredOffchanConstructNormalAction", "offchan_construct_normal_action")) return false
    if (!internalFunction("esp32RecoveredOffchanFlushTxBuf", "offchan_flush_tx_buf")) return false
    if (!exportFunction("esp32RecoveredOffchanInProgress", "offchan_in_progress")) return false
    if (!internalFunction("esp32RecoveredOffchanProgressIsMatched", "offchan_progress_is_matched")) return false
    if (!exportFunction("esp32RecoveredOffchanRecvAction", "offchan_recv_action")) return false
    if (!internalFunction("esp32RecoveredOffchanRocInProgress", "offchan_roc_in_progress")) return false
    if (!exportFunction("esp32RecoveredOffchanSendActionTxStatus", "offchan_send_action_tx_status")) return false
    if (!internalFunction("esp32RecoveredOffchanTxInProgress", "offchan_tx_in_progress")) return false
    if (!internalFunction("esp32RecoveredOffchanTxopEnd", "offchan_txop_end")) return false
    if (!internalFunction("esp32RecoveredOffchanTxopStart", "offchan_txop_start")) return false
    if (!internalFunction("esp32RecoveredRocOpEnd", "roc_op_end")) return false
    if (!internalFunction("esp32RecoveredRocOpStart", "roc_op_start")) return false
    if (!exportFunction("esp32AddVendorInformationElementHeader", "ieee80211_add_ie_vendor_esp_head")) return false
    if (!exportFunction("esp32AddVendorManufacturerElement", "ieee80211_add_ie_vendor_esp_manufacturer")) return false
    if (!exportFunction("esp32AddVendorEspNowElement", "ieee80211_add_ie_vendor_esp_now")) return false
    true
}

// Enable only while opaque interrupt/vector users still require these names.
compile fun esp32Idf6LinkXtensaOpaqueCallers(): bool {
    if (!exportFunction("ownedXtensaUnhandledInterrupt", "xt_unhandled_interrupt")) return false
    if (!exportFunction("ownedXtensaInterruptHasHandler", "xt_int_has_handler")) return false
    if (!exportFunction("ownedXtensaSetInterruptHandler", "xt_set_interrupt_handler")) return false
    if (!exportFunction("ownedXtensaSetExceptionHandler", "xt_set_exception_handler")) return false
    if (!exportFunction("ownedXtensaInterruptsEnable", "xt_ints_on")) return false
    if (!exportFunction("ownedXtensaInterruptsDisable", "xt_ints_off")) return false
    if (!exportFunction("ownedXtensaGetInterruptEnable", "xthal_get_intenable")) return false
    if (!exportFunction("ownedXtensaSetInterruptEnable", "xthal_set_intenable")) return false
    if (!exportFunction("ownedXtensaGetInterruptRead", "xthal_get_intread")) return false
    if (!exportFunction("ownedXtensaGetInterrupt", "xthal_get_interrupt")) return false
    if (!exportFunction("ownedXtensaSetInterrupt", "xthal_set_intset")) return false
    if (!exportFunction("ownedXtensaClearInterrupt", "xthal_set_intclear")) return false
    if (!exportFunction("ownedXtensaSaveExtraNonWindowed", "xthal_save_extra_nw")) return false
    if (!exportFunction("ownedXtensaRestoreExtraNonWindowed", "xthal_restore_extra_nw")) return false
    if (!exportFunction("ownedXtensaWindowSpillNonWindowed", "xthal_window_spill_nw")) return false
    if (!exportFunction("ownedXtensaWindowSpillNonWindowed", "xthal_spill_registers_into_stack_nw")) return false
    if (!exportFunction("ownedXtensaWindowSpill", "xthal_window_spill")) return false
    true
}
