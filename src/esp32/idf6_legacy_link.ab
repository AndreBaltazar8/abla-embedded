import "abla/build"

// lwIP/WiFi use the conventional power-of-two roundup helper. Keeping its
// arithmetic in Abla lets LLVM fold every constant-alignment call.
@inline
trusted fun esp32Roundup2(value: u32, alignment: u32): u32 =
    (value + alignment - u32(1)) & (u32(0) - alignment)

// Transitional link boundary for mixed Abla/ESP-IDF builds. Ordinary ESP32
// implementations stay internal; importing this module does nothing by itself.
// A firmware that still links opaque ESP-IDF archives must explicitly call this
// compile-time function so only the foreign names those archives require become
// roots. Remove each request together with its final opaque caller.
compile fun esp32Idf6LinkLegacyOpaqueArchives(): bool {
    if (!exportFunction("freestandingCopy", "memcpy")) return false
    if (!exportFunction("freestandingMove", "memmove")) return false
    if (!exportFunction("freestandingSet", "memset")) return false
    if (!exportFunction("freestandingZero", "bzero")) return false
    if (!exportFunction("freestandingCompare", "memcmp")) return false
    if (!internalFunction("freestandingFindByte", "memchr")) return false
    if (!internalFunction("freestandingStringLengthBounded", "strnlen")) return false
    if (!exportFunction("freestandingStringLength", "strlen")) return false
    if (!exportFunction("freestandingStringCompare", "strcmp")) return false
    if (!exportFunction("freestandingStringCompareBounded", "strncmp")) return false
    if (!internalFunction("freestandingStringCompareCaseInsensitiveBounded", "strncasecmp")) return false
    if (!internalFunction("freestandingStringCopy", "strcpy")) return false
    if (!exportFunction("freestandingStringCopyBounded", "strncpy")) return false
    if (!exportFunction("freestandingStringCopySized", "strlcpy")) return false
    if (!exportFunction("freestandingStringAppend", "strcat")) return false
    if (!exportFunction("freestandingStringAppendSized", "strlcat")) return false
    if (!internalFunction("freestandingStringFind", "strchr")) return false
    if (!internalFunction("freestandingStringFindLast", "strrchr")) return false
    if (!internalFunction("freestandingStringSpanNotIn", "strcspn")) return false
    if (!internalFunction("esp32Roundup2", "roundup2")) return false
    if (!internalFunction("freestandingStringFindString", "strstr")) return false
    if (!internalFunction("freestandingAsciiLower", "tolower")) return false
    if (!internalFunction("esp32PacketTimerDoProcess", "pp_timer_do_process")) return false
    if (!internalFunction("esp32PacketTimerProcess", "pp_timer_process")) return false
    if (!internalFunction("esp32AmpduStoreSessions", "hal_ba_session_store")) return false
    if (!internalFunction("esp32AmpduRestoreSessions", "hal_ba_session_restore")) return false
    if (!internalFunction("esp32AmpduRestoreSession", "hal_ba_session_restore_by_hw_index")) return false
    if (!internalFunction("esp32RadioTemperatureSensorRead", "temprature_sens_read")) return false
    if (!internalFunction("esp32PhyChangeChannelWithoutMac", "phy_change_channel_nomac")) return false
    if (!internalFunction("esp32RateControlSetBasicRate", "RC_SetBasicRate")) return false
    if (!internalFunction("esp32RateControlAckTime", "RC_GetAckTime")) return false
    if (!internalFunction("esp32RateControlCtsTime", "RC_GetCtsTime")) return false
    if (!internalFunction("esp32RateControlBlockAckTime", "RC_GetBlockAckTime")) return false
    if (!internalFunction("esp32SnifferEnableHardware", "hal_sniffer_enable")) return false
    if (!internalFunction("esp32SnifferDisableHardware", "hal_sniffer_disable")) return false
    if (!internalFunction("esp32SnifferSetPromiscuousHardware", "hal_sniffer_rx_set_promis")) return false
    if (!internalFunction("esp32SnifferClearStatisticsHardware", "hal_sniffer_rx_clr_statistics")) return false
    if (!internalFunction("esp32MiscNvsDeinitialize", "misc_nvs_deinit")) return false
    if (!internalFunction("esp32MiscNvsInitialize", "misc_nvs_init")) return false
    if (!internalFunction("esp32MiscNvsRestore", "misc_nvs_restore")) return false
    if (!internalFunction("esp32RecoveredOffchanConstructNormalAction", "offchan_construct_normal_action")) return false
    if (!internalFunction("esp32RecoveredOffchanFlushTxBuf", "offchan_flush_tx_buf")) return false
    if (!internalFunction("esp32RecoveredOffchanInProgress", "offchan_in_progress")) return false
    if (!internalFunction("esp32RecoveredOffchanProgressIsMatched", "offchan_progress_is_matched")) return false
    if (!internalFunction("esp32RecoveredOffchanRecvAction", "offchan_recv_action")) return false
    if (!internalFunction("esp32RecoveredOffchanRocInProgress", "offchan_roc_in_progress")) return false
    if (!internalFunction("esp32RecoveredOffchanSendActionTxStatus", "offchan_send_action_tx_status")) return false
    if (!internalFunction("esp32RecoveredOffchanTxInProgress", "offchan_tx_in_progress")) return false
    if (!internalFunction("esp32RecoveredOffchanTxopEnd", "offchan_txop_end")) return false
    if (!internalFunction("esp32RecoveredOffchanTxopStart", "offchan_txop_start")) return false
    if (!internalFunction("esp32RecoveredRocOpEnd", "roc_op_end")) return false
    if (!internalFunction("esp32RecoveredRocOpStart", "roc_op_start")) return false
    if (!internalFunction("esp32AddVendorInformationElementHeader", "ieee80211_add_ie_vendor_esp_head")) return false
    if (!internalFunction("esp32AddVendorManufacturerElement", "ieee80211_add_ie_vendor_esp_manufacturer")) return false
    if (!internalFunction("esp32AddVendorEspNowElement", "ieee80211_add_ie_vendor_esp_now")) return false
    true
}

// Enable only while opaque interrupt/vector users still require these names.
compile fun esp32Idf6LinkXtensaOpaqueCallers(): bool {
    if (!exportFunction("ownedXtensaGetInterruptEnable", "xthal_get_intenable")) return false
    if (!exportFunction("ownedXtensaSetInterruptEnable", "xthal_set_intenable")) return false
    if (!exportFunction("ownedXtensaGetInterruptRead", "xthal_get_intread")) return false
    if (!exportFunction("ownedXtensaGetInterrupt", "xthal_get_interrupt")) return false
    if (!exportFunction("ownedXtensaSetInterrupt", "xthal_set_intset")) return false
    true
}
