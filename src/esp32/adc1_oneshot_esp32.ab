import "./adc1_oneshot_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("esp32Adc1Read")
trusted fun esp32Adc1ReadHook(offset: int): int = mmioLoadU32(0x3ff48800+offset)
@export("esp32Adc1Write")
trusted fun esp32Adc1WriteHook(offset: int,value: int): void { mmioStoreU32(0x3ff48800+offset,value); return }
