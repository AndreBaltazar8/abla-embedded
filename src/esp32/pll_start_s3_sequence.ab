// ESP-IDF v6.0.2 S3 rtc_clk_bbpll_configure / clk_tree_ll sequence.
// Caller exclusively owns analog bus, PLL consumers, both cores and interrupts;
// MSPI must already run from a compatible non-PLL clock. Internal code/data/stack.
// Only starts a fully powered-down PLL while CPU runs on the stored XTAL.
// 0 invalid, 1 calibrated, 2 ownership/state refused, 3 calibration timeout.
// Timeout stops calibration and powers PLL down; CPU source never changes.
@section(".iram1.abla.s3PllStart")
trusted fun esp32S3PllStartOwned(pllMHz: int,polls: int): int {
    if ((pllMHz != 320 && pllMHz != 480) || polls <= 0) return 0
    val xtal=esp32S3StoredXtalMegahertz(esp32S3ClockRead(0x600080C0))
    if (xtal != 32 && xtal != 40) return 0
    if ((esp32S3ClockRead(0x600C0060) & 3072) != 0 ||
        (esp32S3ClockRead(0x60008000) & 0x540) != 0x540) return 2
    esp32S3ClockUpdate(0x60008000,0x540,0)
    esp32S3ClockUpdate(0x600C0010,4,if (pllMHz == 480) 4 else 0)
    esp32S3ClockUpdate(0x6000E040,4,0)
    esp32S3ClockUpdate(0x6000E040,8,8)
    val special=xtal == 32 && pllMHz == 480
    esp32S3PllAnalogWrite(4,7,0,if (pllMHz == 480) 0x6B else 0x69)
    esp32S3PllAnalogWrite(2,7,0,(if (special) 64 else 80) | (if (xtal == 32) 1 else 0))
    esp32S3PllAnalogWrite(3,7,0,if (xtal == 32) (if (pllMHz == 480) 26 else 6) else (if (pllMHz == 480) 8 else 4))
    esp32S3PllAnalogWrite(5,2,0,if (special) 1 else 0)
    esp32S3PllAnalogWrite(5,6,4,if (special) 1 else 0)
    esp32S3PllAnalogWrite(6,7,0,if (special) 112 else 115)
    esp32S3PllAnalogWrite(9,1,0,3)
    var left=polls
    var done=false
    while (left > 0 && !done) {
        done=(esp32S3ClockRead(0x6000E040) & 0x1000000) != 0
        left=left-1
    }
    if (done) esp32S3ClockRomDelay(10)
    esp32S3ClockUpdate(0x6000E040,8,0)
    esp32S3ClockUpdate(0x6000E040,4,4)
    if (!done) {
        esp32S3ClockUpdate(0x60008000,0x540,0x540)
        return 3
    }
    1
}
