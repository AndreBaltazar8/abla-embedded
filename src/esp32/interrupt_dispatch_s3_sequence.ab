import "./sdk/raw_buffer.ab"
// Low/medium ISR body, NOT an exception entry. The architecture shell must
// first save context, establish an interrupt stack/windowed ABI and set PS to
// this level with EXCM clear. No scheduler, PM hook or software-priority mode.
// Caller owns an initialized 32-line x 2-core table, including timer callbacks;
// callbacks acknowledge level sources and preserve table lifetime. Unhandled
// interrupts are errors, never silently cleared or disabled.
// Returns 0 after draining this level, -1 invalid arguments, -2 missing handler.
// A persistently asserted source intentionally keeps dispatching, like IDF.
@noinline
@section(".iram1.abla.s3InterruptDispatch")
trusted fun esp32S3InterruptDispatchOwned(table: NativeBuffer,core: int,level: int): int {
    if (!table.hasAddressRange(0,512) || (table.addressValue() & 3) != 0 ||
        core < 0 || core > 1 || level < 1 || level > 3) return -1
    if (esp32S3DispatchCore() != core) return -1
    val mask=if (level == 1) 0x000637FF else if (level == 2) 0x00380000 else 0x28C08800
    while (true) {
        // Re-read both registers after every callback; it may disable a line
        // or another source at this level may become pending meanwhile.
        val enabled=esp32S3DispatchEnabled()
        val pending=esp32S3DispatchPending() & enabled & mask
        if (pending == 0) return 0
        var line=31
        while (((pending>>>line) & 1) == 0) line=line-1
        val entry=table.addressValue()+line*16+core*8
        val handler=esp32S3DispatchRead(entry)
        if (handler == 0) return -2
        val argument=esp32S3DispatchRead(entry+4)
        // Clears software/edge latch before invoking callback. CPU INTCLEAR
        // does not acknowledge the underlying level-sensitive peripheral.
        esp32S3DispatchClear(1<<line)
        esp32S3DispatchCall(handler,argument)
    }
    return 0
}
