import "../led/rmt_rgb_frame.ab"

// Finite RGB strip using caller-owned internal-SRAM descriptors and waveform.
// Caller configures/owns RMT group (stable APB80MHz/div1), memory, stopped
// TXchannel3 and routed pad (signal84), and the parked GDMA channel. No IRQ
// sharing or allocation. GPIO/RCC setup stays explicit, not hidden per frame.
// 10MHz symbols: bit0 400ns/800ns, bit1 800ns/400ns, reset280us.
// Returns the full DMA lifecycle result, not a bool that loses recovery flags.
trusted fun esp32s3RmtWriteRgbDmaOwned(dmaChannel: int, descriptors: int,
    colors: NativeBuffer, count: int, order: int, brightness: int,
    waveform: NativeBuffer, polls: int): int =
    esp32s3RmtWriteRgbTimedDmaOwned(dmaChannel, descriptors, colors, count,
        order, brightness, waveform, polls, 8, u32(0x00088004), u32(0x00048008), 2800)

// Explicit channel divider and encoded symbol timings for other LED profiles.
trusted fun esp32s3RmtWriteRgbTimedDmaOwned(dmaChannel: int, descriptors: int,
    colors: NativeBuffer, count: int, order: int, brightness: int,
    waveform: NativeBuffer, polls: int, divider: int, zero: u32, one: u32,
    resetTicks: int): int {
    val bytes = rmtRgbFrameBytes(count)
    if (dmaChannel < 0 || dmaChannel > 4 || polls < 1 || polls > 1000000 ||
        divider < 1 || divider > 256 ||
        !rmtRgbFrameValid(colors, count, order, brightness, zero, one, resetTicks, waveform) ||
        !esp32s3GdmaLinearTxLayoutValid(descriptors, waveform.addressValue(), bytes)) return 2
    val descriptorBytes = esp32s3GdmaLinearTxCount(bytes) * 12
    if (colors.addressValue() < descriptors + descriptorBytes &&
        descriptors < colors.addressValue() + count * 3) return 2
    // Do not overwrite a DMA-owned waveform even before entering transmit.
    if (!esp32s3GdmaParked(dmaChannel, true)) return 3
    if (!rmtEncodeRgbFrame(colors, count, order, brightness, zero, one, resetTicks, waveform)) return 2
    esp32s3RmtTransmitDmaOwned(dmaChannel, divider, descriptors, waveform, bytes, polls)
}
