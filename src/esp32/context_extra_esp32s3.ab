import "abla/unsafe/native"
// S3 non-coprocessor context, IDF config/tie-asm.h xchal_ncp_store/load.
// CALL0-only architecture leaves: a2 points to 36 bytes, aligned4; a3 scratch,
// all other address registers preserved. No compiler prologue/window rotation.
// Invoke only from context assembly after saving a3, with interrupts masked.
// NOT ordinary Abla-callable functions. The addresses are for that shell only.
// Includes THREADPTR, ACCLO/ACCHI, BR, SCOMPARE1 and M0..M3; does not include
// loop/SAR/general registers or separately owned FPU/SIMD coprocessor context.
trusted noescape extern:"inline-assembly" fun esp32S3ContextExtraAssembly(template: string,constraints: string): void
@naked
@noinline
@section(".iram1.abla.s3ContextExtraSave")
trusted fun esp32S3ContextExtraSave(): void =
    esp32S3ContextExtraAssembly("rur.threadptr a3\ns32i a3, a2, 0\nrsr.acclo a3\ns32i a3, a2, 4\nrsr.acchi a3\ns32i a3, a2, 8\nrsr.br a3\ns32i a3, a2, 12\nrsr.scompare1 a3\ns32i a3, a2, 16\nrsr.m0 a3\ns32i a3, a2, 20\nrsr.m1 a3\ns32i a3, a2, 24\nrsr.m2 a3\ns32i a3, a2, 28\nrsr.m3 a3\ns32i a3, a2, 32\nret", "~{memory}")
@naked
@noinline
@section(".iram1.abla.s3ContextExtraRestore")
trusted fun esp32S3ContextExtraRestore(): void =
    esp32S3ContextExtraAssembly("l32i a3, a2, 0\nwur.threadptr a3\nl32i a3, a2, 4\nwsr.acclo a3\nl32i a3, a2, 8\nwsr.acchi a3\nl32i a3, a2, 12\nwsr.br a3\nl32i a3, a2, 16\nwsr.scompare1 a3\nl32i a3, a2, 20\nwsr.m0 a3\nl32i a3, a2, 24\nwsr.m1 a3\nl32i a3, a2, 28\nwsr.m2 a3\nl32i a3, a2, 32\nwsr.m3 a3\nrsync\nret", "~{memory}")
@inline
trusted fun esp32S3ContextExtraSaveAddress(): int = nativeFunctionAddress(esp32S3ContextExtraSave)
@inline
trusted fun esp32S3ContextExtraRestoreAddress(): int = nativeFunctionAddress(esp32S3ContextExtraRestore)
