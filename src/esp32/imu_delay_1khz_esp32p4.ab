import "./peripheral_delay_esp32p4.ab"
import "../hal/delay.ab"
import "../hal/esp32.ab"
// Explicit bare-metal1kHz compatibility profile: one logical tick is1ms.
// ROM timing must be calibrated; busy wait is not RTOS scheduling.
@export("imuDelay")
trusted fun imuDelayHook(ticks: int): void { peripheralDelayMilliseconds(ticks);return }
