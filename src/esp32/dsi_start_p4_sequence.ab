import "./dsi_pll_p4_sequence.ab"
import "./dsi_host_p4_sequence.ab"
// Digital startup AFTER caller-owned RCC startup, stable source clocks and
// settled analog supply. Exclusive host/bridge; no running display allowed.
// v1 requires the RCC bridge reset already performed by clock startup; only
// v3 has an additional internal reset. Does not reset/power the panel.
// Status13 active hardware (no writes),14 PHY lock/stop timeout,15 bridge
// reset readback failure. Existing host statuses/errors propagate unchanged.
// Bit7 means digital hardware was started and MUST remain caller-owned even
// on failure. No automatic clock/supply release under potentially live DMA.
fun DsiCommandResult.digitalOwned(): bool = (this&128) != 0
trusted fun esp32P4DsiStartDigitalOwned(hwVersion: int,lanes: int,referenceKhz: int,laneKbps: int,channel: int,forceHs: bool,polls: int): DsiCommandResult {
    if ((hwVersion != 1 && hwVersion != 3) || lanes < 1 || lanes > 2 ||
        channel < 0 || channel > 3 || polls < 1 || polls > 1000000) return DsiCommandResult(2)
    val plan=esp32P4DsiChoosePllKbps(referenceKhz,laneKbps)
    if (!plan.valid()) return DsiCommandResult(2)
    val actualRate=int((u32(referenceKhz)*u32(plan.multiplier())+u32(plan.divider()-1))/u32(plan.divider()))
    if (actualRate < 80000 || actualRate > 1500000) return DsiCommandResult(2)
    if ((p4DsiRead(4)&u32(1)) != u32(0) || (p4DsiRead(160)&u32(1)) != u32(0) ||
        (p4DsiBridgeRead(4)&u32(1)) != u32(0)) return DsiCommandResult(13)
    esp32P4DsiPhyStartOwned(lanes)
    if (hwVersion == 3) {
        p4DsiBridgeWrite(4,p4DsiBridgeRead(4)|u32(2))
        p4DsiBridgeWrite(4,p4DsiBridgeRead(4)&u32(4294967293))
        if ((p4DsiBridgeRead(4)&u32(3)) != u32(0)) return DsiCommandResult(128|15)
    }
    esp32P4DsiApplyPllOwned(plan)
    if (!esp32P4DsiPhyWaitReadyOwned(lanes,polls)) return DsiCommandResult(128|14)
    val result=esp32P4DsiConfigureCommandHostOwned(actualRate,channel,forceHs,polls)
    DsiCommandResult((result|0)|128)
}
