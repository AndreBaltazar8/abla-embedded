import "./ledc_c5_sequence.ab"
// Whole LEDC lifetime: caller owns all six channels/four timers and excludes
// IRQ/ETM/reset/PCR writers; source0XTAL/1RC_FAST/2PLL80 already selected/pinned.
// No resets/source switches. Borrow existing gates; memory FORCE_PD must be
// released for gamma RAM. Memory contents are not promised across close.
// Status0closed1ready2invalid3reset/source4APB5ready-timeout6busy7memory8source.
// Bits8APB/9function/10memory track attempted changes, retained on failure.
type C5LedcClockOwner=int
fun C5LedcClockOwner.status(): int = this&255
fun C5LedcClockOwner.ready(): bool = this.status() == 1
trusted fun c5LedcClockField(offset: int,mask: int,value: int): bool {
    c5LedcClockWrite(offset,(c5LedcClockRead(offset)&~mask)|value)
    return (c5LedcClockRead(offset)&mask) == value
}
trusted fun c5LedcAllStopped(): bool {
    if (c5LedcRead(200) != 0) return false
    var channel=0
    while (channel < 6) {
        if ((c5LedcRead(channel*20)&0x8014) != 0 || (c5LedcRead(channel*20+12)&0x80000000) != 0) return false
        channel=channel+1
    }
    var timer=0
    while (timer < 4) {
        val config=c5LedcRead(160+timer*8)
        if ((config&0x4000000) != 0 || (config&0x1800000) == 0) return false
        timer=timer+1
    }
    return true
}
trusted fun c5LedcClockOpenOwned(source: int,exclusiveStopped: bool,polls: int): C5LedcClockOwner {
    if (!exclusiveStopped || source < 0 || source > 2 || polls < 1 || polls > 1000000) return C5LedcClockOwner(2)
    val bus=c5LedcClockRead(0);val functional=c5LedcClockRead(4)
    if ((bus&2) != 0 || ((functional>>>20)&3) != source) return C5LedcClockOwner(3)
    var flags=0
    if ((bus&1) == 0) {
        flags=flags|256
        if (!c5LedcClockField(0,1,1)) return C5LedcClockOwner(flags|4)
    }
    var remaining=polls
    while (remaining > 0 && (c5LedcClockRead(0)&4) == 0) remaining=remaining-1
    if (remaining == 0) return C5LedcClockOwner(flags|5)
    if (!c5LedcAllStopped()) return C5LedcClockOwner(flags|6)
    if ((c5LedcClockRead(8)&4) != 0) {
        flags=flags|1024
        if (!c5LedcClockField(8,4,0)) return C5LedcClockOwner(flags|7)
    }
    if ((functional&0x400000) == 0) {
        flags=flags|512
        if (!c5LedcClockField(4,0x400000,0x400000)) return C5LedcClockOwner(flags|8)
    }
    return C5LedcClockOwner(flags|1)
}
// Stop outputs, settle updates and pause all timers before releasing clocks.
// No automatic cancellation, IRQ clearing, timer pause or memory destruction
// while any child is live. Retry uses replacement ownership flags.
trusted fun C5LedcClockOwner.closeOwned(exclusiveStopped: bool): C5LedcClockOwner {
    if (!exclusiveStopped || this < 0 || (this&~2047) != 0 || this.status() > 8) return this
    var flags=this&1792
    if (flags == 0) return C5LedcClockOwner(0)
    val bus=c5LedcClockRead(0)
    if ((bus&2) != 0) return C5LedcClockOwner(flags|6)
    if ((bus&5) == 5) {
        if (!c5LedcAllStopped()) return C5LedcClockOwner(flags|6)
    } else if ((flags&1536) != 0) return C5LedcClockOwner(flags|6)
    if ((flags&512) != 0) {
        if (!c5LedcClockField(4,0x400000,0)) return C5LedcClockOwner(flags|8)
        flags=flags&~512
    }
    if ((flags&1024) != 0) {
        if (!c5LedcClockField(8,4,4)) return C5LedcClockOwner(flags|7)
        flags=flags&~1024
    }
    if ((flags&256) != 0 && !c5LedcClockField(0,1,0)) return C5LedcClockOwner(flags|4)
    return C5LedcClockOwner(0)
}
