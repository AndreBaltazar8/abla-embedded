// P4 GPIO0..54, both register layouts. Caller owns pad, has stopped its prior
// peripheral function (including LP users), released pad holds, and pinned
// GPIO/HP and LP IOMUX clocks/power. GPIO0..15 also require LP pad ownership.
// Hardware availability does not imply a board pin is free (flash/PSRAM etc.).
trusted fun esp32P4GpioReadOwned(pin: int): int {
    if (pin < 0 || pin > 54) return -1
    return int((p4GpioRead(if (pin < 32) 60 else 64)>>u32(pin&31))&u32(1))
}
trusted fun esp32P4GpioWriteOwned(pin: int,high: bool): bool {
    if (pin < 0 || pin > 54) return false
    p4GpioWrite((if (pin < 32) 8 else 20)+(if (high) 0 else 4),u32(1)<<u32(pin&31))
    return true
}
trusted fun p4GpioField(offset: int,mask: u32,value: u32): bool {
    p4GpioWrite(offset,(p4GpioRead(offset)&(u32(4294967295)^mask))|value)
    return (p4GpioRead(offset)&mask) == value
}
// 1configured,2invalid,3partial readback failure (retain pad ownership).
// Disable output before changing mux/latch, enable last. All W1S/W1C writes
// are exact pin masks; unrelated pins, pull/drive/sleep fields are preserved.
// pull:0none,1up,2down. Input enable is independent of output/open-drain.
trusted fun esp32P4GpioConfigureOwned(pin: int,output: bool,high: bool,openDrain: bool,input: bool,pull: int): int {
    if (pin < 0 || pin > 54 || pull < 0 || pull > 2) return 2
    val bit=u32(1)<<u32(pin&31)
    val enable=if (pin < 32) 32 else 44
    p4GpioWrite(enable+8,bit)
    if ((p4GpioRead(enable)&bit) != u32(0)) return 3
    esp32P4GpioWriteOwned(pin,high)
    if (((p4GpioRead(if (pin < 32) 4 else 16)&bit) != u32(0)) != high) return 3
    if (!p4GpioField(116+pin*4,u32(4),if (openDrain) u32(4) else u32(0)) ||
        !p4GpioField(1368+pin*4,u32(4095),u32(1280))) return 3
    // GPIO function1, clear sleep-selection, configure pulls/input; preserve
    // drive strength, sleep settings and glitch filter.
    val mux=u32(4096)|(if (input) u32(512) else u32(0))|
        (if (pull == 1) u32(256) else if (pull == 2) u32(128) else u32(0))
    if (!p4GpioField(4100+pin*4,u32(29570),mux)) return 3
    // Select HP control only after its output is disabled and its mux/latch
    // are configured. LP_IOMUX.PADn.MUX_SEL=0 hands GPIO0..15 to HP GPIO.
    // Offset is relative to the shared provider's GPIO base 0x500e0000.
    if (pin < 16 && !p4GpioField(0x4b008+pin*4,u32(16),u32(0))) return 3
    if (output) {
        p4GpioWrite(enable+4,bit)
        if ((p4GpioRead(enable)&bit) == u32(0)) return 3
    }
    return 1
}
