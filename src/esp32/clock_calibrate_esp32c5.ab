import "./clock_calibrate_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@inline
@export("c5CalibrationRead")
trusted fun c5CalibrationReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("c5CalibrationWrite")
trusted fun c5CalibrationWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
