// P4 L2 geometry is one-hot, not a binary size field. Reject unsupported
// or conflicting fields instead of inferring a valid mode from a single bit.
// Upper reserved bits are ignored. Reading geometry does NOT prove cache
// enablement, tag initialization, SRAM reservations or memory integrity.
fun p4CacheL2SizeFromRaw(raw: int): int {
    val field=raw&8191
    return if (field == 512) 131072 else if (field == 1024) 262144 else if (field == 2048) 524288 else 0
}
fun p4CacheL2LineFromRaw(raw: int): int {
    val field=raw&63
    return if (field == 8) 64 else if (field == 16) 128 else 0
}
trusted fun p4CacheL2GeometryMatches(line: int): bool {
    if (line != 64 && line != 128) return false
    return p4CacheL2SizeFromRaw(p4CacheGeometryRead(632)) != 0 && p4CacheL2LineFromRaw(p4CacheGeometryRead(636)) == line
}
