// ESP-IDF v6.0.2 gpio_ll_hold_en/dis: verified register layouts1 and3.
// Caller owns the pad AND serializes shared hold-register RMW across cores/LP.
// This controls individual holds only, not PMU force-all or sleep overrides.
// Configure a safe latch/mux before release; release can immediately drive it.
fun p4GpioHoldAddress(layout: int,pin: int): int {
    if ((layout != 1 && layout != 3) || pin < 0 || pin > 54) return 0
    if (layout == 3) return if (pin < 32) 0x501101c4 else 0x501101c8
    return if (pin < 16) 0x5012b04c else if (pin < 48) 0x500e5074 else 0x500e5078
}
fun p4GpioHoldBit(layout: int,pin: int): u32 = u32(1)<<u32(if (layout == 3) pin&31 else if (pin < 16) pin else if (pin < 48) pin-16 else pin-48)
// -1invalid,0individual hold disabled,1enabled. Not effective-pad-state proof.
trusted fun esp32P4GpioIndividualHoldOwned(layout: int,pin: int): int {
    val address=p4GpioHoldAddress(layout,pin)
    if (address == 0) return -1
    return if ((p4GpioHoldRead(address)&p4GpioHoldBit(layout,pin)) != u32(0)) 1 else 0
}
// 1readback confirmed,2invalid/no MMIO,3write/readback failure: retain pad lease.
trusted fun esp32P4GpioSetIndividualHoldOwned(layout: int,pin: int,enabled: bool): int {
    val address=p4GpioHoldAddress(layout,pin)
    if (address == 0) return 2
    val bit=p4GpioHoldBit(layout,pin)
    val before=p4GpioHoldRead(address)
    val wanted=if (enabled) before|bit else before&(u32(4294967295)^bit)
    if (wanted != before) p4GpioHoldWrite(address,wanted)
    return if ((p4GpioHoldRead(address)&bit) == (wanted&bit)) 1 else 3
}
