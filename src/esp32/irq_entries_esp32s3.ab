import "./context_extra_esp32s3.ab"
// IRQ-only entry region: level1/2/3 offsets0/512/1024. Level1 is entered only
// after user exception routing identified EXCCAUSE=4, with original a0 intact.
// Level2/3 hardware entries preserve a0 before any scratch use.
// Requires working window vectors, writable192-byte frame on interrupted stack,
// initialized per-core config and exclusive adequately sized internal ISR stacks.
// Per core32bytes: stackTop0,nesting4,callback8,context12,low16,end20. Initialize before any
// IRQ enables; do not replace config during callbacks. Nested IRQs stay on ISR
// stack; outermost switches to configured top. CALL4 at interrupt-stack root.
// Callback ABI: void(u32 frame,u32 level,u32 core,u32 context), cache-safe.
// CPENABLE is temporarily0: FPU/SIMD use in ISR is not supported by this layer,
// never silently corrupts interrupted coprocessor state. Tasks retain CP state.
// Frame152 stores IRQ level;156 is a zero-initialized one-shot selected frame.
// Only outermost return may select it; shared selected tail at1408 restores
// integer state and selected PS/PC through RFE. Unselected paths retain RFIn.
// Not a scheduler, complete exception table, or bootable runtime.
// Private assembly region/config; LLVM reference operand keeps region alive.
trusted noescape extern:"inline-assembly" fun esp32S3IrqConfigAddressAssembly(template: string,constraints: string,root: u32): u32
