@inline
trusted fun esp32S3IrqEntryAddress(level: int): int {
    if (level < 1 || level > 3) return 0
    nativeFunctionAddress(esp32S3IrqEntries)+(level-1)*512
}
@inline
trusted fun esp32S3IrqConfigAddress(): int =
    int(esp32S3IrqConfigAddressAssembly("movi $0, .Labla_s3_irq_config", "=r,i,~{memory}", u32(nativeFunctionAddress(esp32S3IrqEntries))))
