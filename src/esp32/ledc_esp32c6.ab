import "./ledc_c6_sequence.ab"
import "abla/unsafe/mmio"
import "abla/runtime/scalar"
import "../hal/esp32.ab"
@export("c6LedcRead")
trusted fun c6LedcReadHook(offset: int): int = mmioLoadU32(0x60007000+offset)
@export("c6LedcWrite")
trusted fun c6LedcWriteHook(offset: int,value: int): void { mmioStoreU32(0x60007000+offset,value);return }
