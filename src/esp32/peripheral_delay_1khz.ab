import "./task.ab"
import "./rom/system_esp32.ab"
import "./peripheral_delay_1khz_logic.ab"

// Short calibrated busy waits, independent of scheduler tick rounding.
trusted fun peripheralDelayMicroseconds(microseconds: int): void {
    var remaining = microseconds
    while (remaining > 0) {
        val chunk = if (remaining > 1000) 1000 else remaining
        esp32DelayMicroseconds(u32(chunk))
        remaining = remaining - chunk
    }
    return
}

// Classic firmware profile: CONFIG_FREERTOS_HZ=1000. Other scheduler rates
// must select a provider that converts milliseconds using their tick rate.
trusted fun peripheralDelayMilliseconds(milliseconds: int): void {
    var remaining = milliseconds
    while (remaining > 0) {
        val ticks = peripheralDelayTicks1Khz(remaining)
        taskDelay(ticks)
        remaining = remaining - (ticks - 1)
    }
    return
}
