// Caller holds the canonical gate and owns an initialized active-low GPIO CS.
// Latch readback is not proof of pad voltage or controller quiescence.
trusted fun esp32s3SpiSelectBegin(select: Pin): int =
    if (select.writeLevelOwned(false)) 1 else 12

// Preserve transfer/START/FIFO evidence, report failed deselection in bit24.
// Even failed assertion requires this cleanup attempt. A failure faults the
// gate; explicit controller/pad recovery is required before another transfer.
trusted fun esp32s3SpiSelectEnd(select: Pin, detail: int): int {
    if (select.writeLevelOwned(true)) return detail
    return (if ((detail&255) == 1) (detail&~255)|10 else detail)|(1<<24)
}
