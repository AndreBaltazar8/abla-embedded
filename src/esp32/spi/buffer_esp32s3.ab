import "abla/unsafe/mmio"
import "./buffer_sequence_esp32s3.ab"
import "../../hal/esp32_spi.ab"
@export("esp32s3SpiRead")
trusted fun esp32s3SpiReadHook(address: int): int = mmioLoadU32(address)
@export("esp32s3SpiWrite")
trusted fun esp32s3SpiWriteHook(address: int, value: int): void = mmioStoreU32(address, value)
