import "../../spi/pins.ab"
import "../../spi/quad_pins.ab"
// Fresh exclusive TX master only. Validate ALL quad pads before any writes,
// initialize the common CPU master through its write-only lane0 profile, then
// attach the remaining quad outputs. Reattaching unchanged CLK/IO0 is harmless:
// CS stays inactive and no transfer is started during either routing phase.
// Caller owns stable source/clock, stopped SPI and all released pads/other CS.
// Common initializer status preserved; quad routing failure status8 carries
// (32+quad-route-detail)@8 to distinguish it from single-line routing errors.
trusted fun esp32s3SpiInitializeQuadTransmitOwned(peripheral: int,pins: QuadSpiPins,
    select: Pin,source: int,pre: int,cycles: int,mode: int,owner: u32,polls: int): int {
    if (!esp32s3SpiQuadTransmitPinsValid(peripheral,pins,select)) return 2
    val initialized=esp32s3SpiInitializeTransmitOwned(peripheral,
        spiPins(pins.dataPin(0),-1,pins.clockPin()),select,source,pre,cycles,mode,owner,polls)
    if (initialized != 1) return initialized
    val routed=esp32s3SpiRouteQuadTransmitPinsOwned(peripheral,pins,select)
    if (routed != 1) return 8|((32+routed)<<8)
    return 1
}
