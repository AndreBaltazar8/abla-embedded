import "./pins_c5_sequence.ab"
import "./transfer_c5_sequence.ab"
// Scalar pin owner49bits + clock owner10bits + lifecycle status4bits.
// Status0closed1ready2invalid3clocks4controller5clockConfig6mode7latch
// 8pins9pinClose10clockClose. Copies are not independent owners.
// Caller owns GPIO clocks, fresh pads/global input route and canonical bus
// gate throughout, stable source, every device CS inactive before open.
type Esp32C5SpiMaster=int
fun Esp32C5SpiMaster.status(): int = (this>>>59)&15
fun Esp32C5SpiMaster.pins(): Esp32C5SpiPins = Esp32C5SpiPins(this&((1<<49)-1))
fun Esp32C5SpiMaster.clocks(): Esp32C5SpiClock = Esp32C5SpiClock((this>>>49)&1023)
fun Esp32C5SpiMaster.ready(): bool = this.status() == 1 && this.pins().ready() && this.clocks().ready()
trusted fun esp32C5SpiMasterOpenOwned(pins: SpiPins,cs: int,sourceHz: int,rootDivider: int,
    pre: int,cycles: int,mode: int,polls: int,exclusive: bool): Esp32C5SpiMaster {
    if (!exclusive || !c5SpiPinProfileValid(pins,cs) || sourceHz < 1000000 || sourceHz > 160000000 ||
        rootDivider < 1 || rootDivider > 256 || sourceHz > 80000000*rootDivider ||
        pre < 1 || pre > 16 || cycles < 1 || cycles > 64 || (cycles == 1 && pre != 1) ||
        mode < 0 || mode > 3 || polls < 1 || polls > 1000000) return Esp32C5SpiMaster(2<<59)
    val clocks=esp32C5SpiClockOpenOwned(true,polls)
    val state=clocks<<49
    if (!clocks.ready()) return Esp32C5SpiMaster(state|(3<<59))
    if (!esp32C5SpiCpuIdleOwned() || (c5SpiRead(0x6008103c)&u32(0x60003)) != u32(0)) return Esp32C5SpiMaster(state|(4<<59))
    // Fresh CPU master: remove inherited width/phase/segmented settings.
    // Retain sticky status; no reset or interrupt acknowledgement here.
    if (!c5SpiConfigField(0x60081008,u32(0xffffffff),u32(0)) ||
        !c5SpiConfigField(0x60081010,u32(0xffffffff),u32(0)) ||
        !c5SpiConfigField(0x60081014,u32(0xffffffff),u32(0x10000)) ||
        !c5SpiConfigField(0x60081018,u32(0xffffffff),u32(0x08000000)) ||
        !c5SpiConfigField(0x60081020,u32(0xffffffff),u32(63)) ||
        !c5SpiConfigField(0x60081024,u32(0xffffffff),u32(0)) ||
        !c5SpiConfigField(0x60081028,u32(0xffffffff),u32(0)) ||
        !c5SpiConfigField(0x6008102c,u32(0xffffffff),u32(0)) ||
        !c5SpiConfigField(0x60081030,u32(0xffffffff),u32(0x180000))) return Esp32C5SpiMaster(state|(4<<59))
    if (esp32C5SpiConfigureClockOwned(sourceHz,rootDivider,pre,cycles,if (cycles == 1) 1 else cycles>>>1) != 1) return Esp32C5SpiMaster(state|(5<<59))
    if (esp32C5SpiConfigureModeOwned(mode,false,false) != 1) return Esp32C5SpiMaster(state|(6<<59))
    if (esp32C5SpiLatchOwned(polls) != 1) return Esp32C5SpiMaster(state|(7<<59))
    val routed=esp32C5SpiPinsOpenOwned(pins,cs,true)
    return Esp32C5SpiMaster(state|(routed|0)|((if (routed.ready()) 1 else 8)<<59))
}
trusted fun Esp32C5SpiMaster.closeOwned(exclusiveChildrenStopped: bool): Esp32C5SpiMaster {
    if (!exclusiveChildrenStopped) return this
    var pins=this.pins()
    // No pad attempt on earlier controller/config failures.
    if ((pins&((15<<32)|(1<<36))) != 0) {
        pins=pins.closeOwned(true)
        if (pins.status() != 0) return Esp32C5SpiMaster((this.clocks()<<49)|(pins|0)|(9<<59))
    }
    val clocks=this.clocks().closeOwned(true)
    if (clocks.status() != 0) return Esp32C5SpiMaster((clocks<<49)|(10<<59))
    return Esp32C5SpiMaster(0)
}

