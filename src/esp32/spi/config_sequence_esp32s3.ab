// Caller holds canonical RCC lock. Enable/deassert only; no reset pulse.
trusted fun esp32s3SpiEnableBusClockLocked(peripheral: int): bool {
    if (esp32s3SpiBase(peripheral) == 0) return false
    val mask = if (peripheral == 2) 64 else 65536
    val clock = esp32s3SpiRead(0x600c0018)
    if ((clock & mask) == 0) esp32s3SpiWrite(0x600c0018, clock | mask)
    val reset = esp32s3SpiRead(0x600c0020)
    if ((reset & mask) != 0) esp32s3SpiWrite(0x600c0020, reset & (0xffffffff ^ mask))
    true
}

// Caller owns powered stopped master with inactive CS and no shared ISR.
// Source0=stable XTAL,1=stable PLL80MHz; no PLL/power-tree setup here.
// Exact divisor=pre*cycles, high phase=highTicks cycles; bypass requires1/1/1.
// Hardware fields allow pre1..16, cycles2..64, highTicks1..cycles.
// Stages registers and enables core clock but does NOT latch UPDATE/start.
trusted fun esp32s3SpiConfigureClockOwned(peripheral: int, source: int,
    pre: int, cycles: int, highTicks: int): bool {
    val base = esp32s3SpiBase(peripheral)
    if (base == 0 || source < 0 || source > 1 || pre < 1 || pre > 16 ||
        cycles < 1 || cycles > 64 || highTicks < 1 || highTicks > cycles ||
        (cycles == 1 && pre != 1)) return false
    if (!esp32s3SpiCpuBufferIdle(base) || (esp32s3SpiRead(base + 0xe0) & 0x04000000) != 0) return false
    val gate = esp32s3SpiRead(base + 0xe8) & 0xfffffff8
    val prior = esp32s3SpiRead(base + 0x0c) & 0x7fc00000
    val fields = if (cycles == 1) 0x80000000 else
        ((pre - 1) << 18) | ((cycles - 1) << 12) | ((highTicks - 1) << 6) | (cycles - 1)
    // Stop functional clock before switching source/dividers, preserve others.
    esp32s3SpiWrite(base + 0xe8, gate)
    if (esp32s3SpiRead(base + 0xe8) != gate) return false
    esp32s3SpiWrite(base + 0x0c, prior | fields)
    if (esp32s3SpiRead(base + 0x0c) != (prior | fields)) return false
    esp32s3SpiWrite(base + 0xe8, gate | 3 | (source << 2))
    esp32s3SpiRead(base + 0xe8) == (gate | 3 | (source << 2))
}

// Clock polarity/phase and independent TX/RX bit order, as spi_ll master mode.
// Keeps unrelated timing/line-mode/CS fields. No update/start/pad side effects.
trusted fun esp32s3SpiConfigureModeOwned(peripheral: int, mode: int,
    txLsbFirst: bool, rxLsbFirst: bool): bool {
    val base = esp32s3SpiBase(peripheral)
    if (base == 0 || mode < 0 || mode > 3) return false
    if (!esp32s3SpiCpuBufferIdle(base) || (esp32s3SpiRead(base + 0xe0) & 0x04000000) != 0) return false
    val misc = esp32s3SpiRead(base + 0x20) & 0xdfffffff
    val user = esp32s3SpiRead(base + 0x10) & 0xfffffdff
    val control = esp32s3SpiRead(base + 0x08) & 0xf87fffff
    esp32s3SpiWrite(base + 0x20, misc | (if (mode >= 2) 0x20000000 else 0))
    if ((esp32s3SpiRead(base + 0x20) & 0x20000000) != (if (mode >= 2) 0x20000000 else 0)) return false
    esp32s3SpiWrite(base + 0x10, user | (if (mode == 1 || mode == 2) 512 else 0))
    if ((esp32s3SpiRead(base + 0x10) & 512) != (if (mode == 1 || mode == 2) 512 else 0)) return false
    esp32s3SpiWrite(base + 0x08, control |
        (if (txLsbFirst) 1 << 25 else 0) | (if (rxLsbFirst) 1 << 23 else 0))
    (esp32s3SpiRead(base + 0x08) & 0x07800000) ==
        ((if (txLsbFirst) 1 << 25 else 0) | (if (rxLsbFirst) 1 << 23 else 0))
}
