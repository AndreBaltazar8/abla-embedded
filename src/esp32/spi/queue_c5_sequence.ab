import "./async_buffer_c5_sequence.ab"
// Single-owner cooperative FIFO, not ISR/SMP-safe. 160+48*capacity bytes.
// Header: transaction96,master64@96,gate104,owner108,capacity112,head116,count120,
// fault124,tag128. Entry:token0,TX4,RX8,bytes12,budget16,receive20,state24,
// resultDetail28,resultStatus32,completedBytes36. state1queued2active3complete.
// One configured master/CS profile. Pin all payloads until taken/cancelled.
// Taking an error does not release hardware recovery obligations or context.
fun c5SpiQueueMemoryValid(buffer: NativeBuffer,bytes: int): bool =
    buffer.hasAddressRange(0,bytes) && (buffer.addressValue()&3) == 0 &&
    (buffer.addressValue()+bytes <= 0x60000000 || buffer.addressValue() >= 0x60100000)
fun c5SpiQueueOverlap(a: NativeBuffer,alen: int,b: NativeBuffer,blen: int): bool =
    alen > 0 && blen > 0 && a.addressValue() < b.addressValue()+blen && b.addressValue() < a.addressValue()+alen
trusted fun c5SpiQueueValid(queue: NativeBuffer): bool = c5SpiQueueMemoryValid(queue,160) &&
    queue.loadU32(128) == 0x43535132 && queue.loadU32(112) >= 1 && queue.loadU32(112) <= 64 &&
    c5SpiQueueMemoryValid(queue,160+48*queue.loadU32(112)) && queue.loadU32(116) < queue.loadU32(112) && queue.loadU32(120) <= queue.loadU32(112)
trusted fun c5SpiQueueEntry(queue: NativeBuffer,index: int): NativeBuffer = nativeBufferAt(queue.addressValue()+160+index*48,48)
fun c5SpiQueueIndex(head: int,offset: int,capacity: int): int = int((u32(head)+u32(offset))%u32(capacity))
// Fresh/released storage only. Never reinitialize live or recovery-owned state.
trusted fun esp32C5SpiQueueInitialize(queue: NativeBuffer,capacity: int,master: Esp32C5SpiMaster,
    gate: PeripheralGate,owner: u32,releasedQueue: bool): bool {
    if (!releasedQueue || capacity < 1 || capacity > 64 || !master.ready() || !peripheralOwnerValid(owner) ||
        !c5SpiGateValid(gate) || gate.word().address() > 4294967292 || !c5SpiQueueMemoryValid(queue,160+48*capacity) ||
        !gate.bufferDisjoint(queue,160+48*capacity)) return false
    var offset=0;while (offset < 160+48*capacity) { queue.storeU32(offset,0);offset=offset+4 }
    esp32C5SpiAsyncBufferInitialize(nativeBufferAt(queue.addressValue(),96))
    queue.storeU32(96,master&0xffffffff);queue.storeU32(100,master>>>32)
    queue.storeU32(104,gate.word().address());queue.storeU32(108,int(owner))
    queue.storeU32(112,capacity);queue.storeU32(128,0x43535132);return true
}
// 1accepted2full3invalid4halted. Unique tokens, no cross-request aliases;
// in-place TX/RX within the same request is supported. No hardware writes.
trusted fun esp32C5SpiQueueSubmit(queue: NativeBuffer,token: u32,tx: NativeBuffer,rx: NativeBuffer,
    bytes: int,budget: u32,receive: bool = true): int {
    if (!c5SpiQueueValid(queue) || token == u32(0) || !c5SpiLargeBufferValid(tx,bytes) ||
        (receive && !c5SpiLargeBufferValid(rx,bytes)) || budget == u32(0) || budget > u32(0x7fffffff)) return 3
    if (receive && tx.addressValue() != rx.addressValue() && c5SpiQueueOverlap(tx,bytes,rx,bytes)) return 3
    if (queue.loadU32(124) != 0) return 4
    val capacity=queue.loadU32(112);val count=queue.loadU32(120)
    if (count == capacity) return 2
    val length=160+48*capacity;val gate=peripheralGateAt(queue.loadU32(104))
    if (!gate.bufferDisjoint(tx,bytes) || (receive && !gate.bufferDisjoint(rx,bytes)) ||
        c5SpiQueueOverlap(queue,length,tx,bytes) || (receive && c5SpiQueueOverlap(queue,length,rx,bytes))) return 3
    var index=0
    while (index < count) {
        val entry=c5SpiQueueEntry(queue,c5SpiQueueIndex(queue.loadU32(116),index,capacity))
        val oldBytes=entry.loadU32(12);val oldTx=nativeBufferAt(entry.loadU32(4),oldBytes)
        val oldRx=nativeBufferAt(entry.loadU32(8),oldBytes);val oldReceive=entry.loadU32(20) != 0
        if (entry.loadU32(0) == int(token) || c5SpiQueueOverlap(tx,bytes,oldTx,oldBytes) ||
            (oldReceive && c5SpiQueueOverlap(tx,bytes,oldRx,oldBytes)) ||
            (receive && (c5SpiQueueOverlap(rx,bytes,oldTx,oldBytes) || (oldReceive && c5SpiQueueOverlap(rx,bytes,oldRx,oldBytes))))) return 3
        index=index+1
    }
    val entry=c5SpiQueueEntry(queue,c5SpiQueueIndex(queue.loadU32(116),count,capacity))
    entry.storeU32(0,int(token));entry.storeU32(4,tx.addressValue());entry.storeU32(8,if (receive) rx.addressValue() else 0)
    entry.storeU32(12,bytes);entry.storeU32(16,int(budget));entry.storeU32(20,if (receive) 1 else 0)
    entry.storeU32(24,1);entry.storeU32(28,0);entry.storeU32(32,0);entry.storeU32(36,0)
    queue.storeU32(120,count+1);return 1
}
// 1completion available2pending3invalid4empty5gate busy6halted.
// At most one begin/poll per service. Completed head blocks the next begin.
trusted fun esp32C5SpiQueueService(queue: NativeBuffer,now: u32): int {
    if (!c5SpiQueueValid(queue)) return 3
    if (queue.loadU32(120) == 0) return if (queue.loadU32(124) != 0) 6 else 4
    val entry=c5SpiQueueEntry(queue,queue.loadU32(116))
    if (entry.loadU32(24) == 3) return 1
    if (queue.loadU32(124) != 0) return 6
    val context=nativeBufferAt(queue.addressValue(),96)
    var result=SpiBufferResult(0)
    if (entry.loadU32(24) == 1) {
        val master=Esp32C5SpiMaster(queue.loadU32(96)|(queue.loadU32(100)<<32))
        val bytes=entry.loadU32(12)
        result=master.beginBufferAsync(context,peripheralGateAt(queue.loadU32(104)),u32(queue.loadU32(108)),
            nativeBufferAt(entry.loadU32(4),bytes),nativeBufferAt(entry.loadU32(8),bytes),bytes,now,u32(entry.loadU32(16)),entry.loadU32(20) != 0)
        if (result.status() == 2) return 5
        if (result == SpiBufferResult(0)) { entry.storeU32(24,2);return 2 }
    } else if (entry.loadU32(24) == 2) result=esp32C5SpiAsyncBufferPoll(context,now)
    else return 3
    if (result == SpiBufferResult(0)) return 2
    entry.storeU32(24,3);entry.storeU32(28,result.detail());entry.storeU32(32,result.status());entry.storeU32(36,result.completedBytes())
    if (!result.valid()) queue.storeU32(124,result.status())
    return 1
}
// Output12B {token,status,detail}; optionally16B appends completedBytes.
// Status1 alone authorizes RX consumption. Partial progress is not a device ACK.
// 1taken2empty3invalid4notcomplete. Output cannot alias queue/gate/live payloads.
trusted fun esp32C5SpiQueueTake(queue: NativeBuffer,completion: NativeBuffer,includeCompleted: bool = false): int {
    val completionBytes=if (includeCompleted) 16 else 12
    if (!c5SpiQueueValid(queue) || !c5SpiQueueMemoryValid(completion,completionBytes) ||
        !peripheralGateAt(queue.loadU32(104)).bufferDisjoint(completion,completionBytes) ||
        c5SpiQueueOverlap(queue,160+48*queue.loadU32(112),completion,completionBytes)) return 3
    val count=queue.loadU32(120);val capacity=queue.loadU32(112)
    if (count == 0) return 2
    val entry=c5SpiQueueEntry(queue,queue.loadU32(116))
    if (entry.loadU32(24) != 3) return 4
    var index=0
    while (index < count) {
        val old=c5SpiQueueEntry(queue,c5SpiQueueIndex(queue.loadU32(116),index,capacity));val bytes=old.loadU32(12)
        if (c5SpiQueueOverlap(completion,completionBytes,nativeBufferAt(old.loadU32(4),bytes),bytes) ||
            (old.loadU32(20) != 0 && c5SpiQueueOverlap(completion,completionBytes,nativeBufferAt(old.loadU32(8),bytes),bytes))) return 3
        index=index+1
    }
    completion.storeU32(0,entry.loadU32(0));completion.storeU32(4,entry.loadU32(32));completion.storeU32(8,entry.loadU32(28))
    if (includeCompleted) completion.storeU32(12,entry.loadU32(36))
    entry.storeU32(24,0);queue.storeU32(116,c5SpiQueueIndex(queue.loadU32(116),1,capacity));queue.storeU32(120,count-1);return 1
}
// Only newest, unstarted entry can be cancelled, including after a fault.
// 1cancelled2empty3invalid4not-tail5already-active/completed. No hardware access.
trusted fun esp32C5SpiQueueCancelTail(queue: NativeBuffer,token: u32): int {
    if (!c5SpiQueueValid(queue) || token == u32(0)) return 3
    val count=queue.loadU32(120);if (count == 0) return 2
    val entry=c5SpiQueueEntry(queue,c5SpiQueueIndex(queue.loadU32(116),count-1,queue.loadU32(112)))
    if (entry.loadU32(0) != int(token)) return 4
    if (entry.loadU32(24) != 1) return 5
    entry.storeU32(24,0);queue.storeU32(120,count-1);return 1
}
