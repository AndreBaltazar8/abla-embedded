import "./select_sequence_esp32s3.ab"
import "./buffer_sequence_esp32s3.ab"
// Caller holds the canonical bus gate; initialized CS is inactive, all other
// devices deselected. Shared D/C belongs to a stopped input consumer.
// Detail11 D/C setup,12 CS assertion,13 D/C data transition.
trusted fun esp32s3SpiCommandPinsBegin(select: Pin, dc: Pin): int {
    if (!dc.outputLevelOwned(false)) return 11
    return esp32s3SpiSelectBegin(select)
}

// Already-quiescent cleanup worker; transfer callers use EndQuiescent below.
// Attempt deselection even after partial setup. Do not release shared
// D/C until CS latch is verified high. Bits24/25 report deselect/input cleanup
// failure while retaining the original low24-bit transfer detail. If the
// transfer succeeded, replace status1 with10 so the canonical gate faults.
// Faulted gate requires explicit recovery; no automatic replay/release claim.
trusted fun esp32s3SpiCommandPinsEnd(select: Pin, dc: Pin, shared: bool, detail: int): int {
    val ended=esp32s3SpiSelectEnd(select,detail)
    if ((ended&(1<<24)) != 0 || !shared) return ended
    if (dc.inputOwned()) return ended
    return (if ((ended&255) == 1) (ended&~255)|10 else ended)|(1<<25)
}
// Transfer timeout is not proof the controller stopped. Retain CS/DC when
// UPDATE/START/DMA is active, report pending cleanup and fault the gate.
// Explicit recovery must first quiesce the controller; never truncate a frame
// or release a shared input pad while hardware may still be clocking it.
trusted fun esp32s3SpiCommandPinsEndQuiescent(peripheral: int,select: Pin,dc: Pin,shared: bool,detail: int): int {
    val base=esp32s3SpiBase(peripheral)
    if (base == 0 || !esp32s3SpiCpuBufferIdle(base))
        return (if ((detail&255) == 1) (detail&~255)|10 else detail)|(1<<24)|(if (shared) 1<<25 else 0)
    return esp32s3SpiCommandPinsEnd(select,dc,shared,detail)
}
