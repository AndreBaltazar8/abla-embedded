import "./clock_c5_sequence.ab"
trusted fun c5SpiConfigField(address: int,mask: u32,value: u32): bool {
    c5SpiWrite(address,(c5SpiRead(address)&~mask)|value)
    return (c5SpiRead(address)&mask) == value
}
// Stage exact clock divisors on stopped owned SPI2, all CS inactive.
// Source remains pinned in PCR; sourceHz is the actual caller-known rate.
// rootDivider1..256 precedes CLOCK pre1..16 and cycles2..64, or bypass1/1.
// Unlike stale upstream prose, CLKDIV_PRE is FOUR bits, not13 on C5.
// No UPDATE/start. Failure may leave function clock off: retain ownership and
// retry/reconfigure before transfer. Never enables a failed configuration.
// Status1staged2invalid3admission4gateOff5rootDivider6clockRegister7gateOn.
trusted fun esp32C5SpiConfigureClockOwned(sourceHz: int,rootDivider: int,pre: int,cycles: int,highTicks: int): int {
    if (sourceHz < 1000000 || sourceHz > 160000000 || rootDivider < 1 || rootDivider > 256 ||
        sourceHz > 80000000*rootDivider || pre < 1 || pre > 16 || cycles < 1 || cycles > 64 ||
        highTicks < 1 || highTicks > cycles || (cycles == 1 && pre != 1)) return 2
    if (!esp32C5SpiCpuIdleOwned()) return 3
    val source=(c5SpiRead(0x600960c8)>>u32(20))&u32(3)
    if ((source == u32(3) && sourceHz != 120000000) || (source == u32(1) && sourceHz != 160000000)) return 3
    if (!c5SpiClockField(0x600960c8,u32(1<<22),false)) return 4
    if (!c5SpiConfigField(0x600960c8,u32(0xff000),u32((rootDivider-1)<<12))) return 5
    val clock=if (cycles == 1) u32(0x80000000) else
        u32(((pre-1)<<18)|((cycles-1)<<12)|((highTicks-1)<<6)|(cycles-1))
    if (!c5SpiConfigField(0x6008100c,u32(0x803fffff),clock)) return 6
    if (!c5SpiClockField(0x600960c8,u32(1<<22),true)) return 7
    return 1
}
// Preserve unrelated width/timing/CS fields. Independent TX/RX bit order.
// Status1staged2invalid3admission4polarity5phase6order. No UPDATE/start.
trusted fun esp32C5SpiConfigureModeOwned(mode: int,txLsbFirst: bool,rxLsbFirst: bool): int {
    if (mode < 0 || mode > 3) return 2
    if (!esp32C5SpiCpuIdleOwned()) return 3
    if (!c5SpiConfigField(0x60081020,u32(1<<29),if (mode >= 2) u32(1<<29) else u32(0))) return 4
    if (!c5SpiConfigField(0x60081010,u32(512),if (mode == 1 || mode == 2) u32(512) else u32(0))) return 5
    if (!c5SpiConfigField(0x60081008,u32(0x07800000),
        (if (txLsbFirst) u32(1<<25) else u32(0))|(if (rxLsbFirst) u32(1<<23) else u32(0)))) return 6
    return 1
}
// Synchronize staged registers only, never start data transfer. Timeout leaves
// UPDATE pending; caller must observe/resolve that state before reconfiguring.
// Status1latched2invalid3admission4timeout.
trusted fun esp32C5SpiLatchOwned(polls: int): int {
    if (polls < 1 || polls > 1000000) return 2
    if (!esp32C5SpiCpuIdleOwned() || (c5SpiRead(0x600960c8)&u32(1<<22)) == u32(0)) return 3
    c5SpiWrite(0x60081000,(c5SpiRead(0x60081000)&~u32(0x01800000))|u32(1<<23))
    var left=polls
    while (left > 0) {
        if ((c5SpiRead(0x60081000)&u32(1<<23)) == u32(0)) return 1
        left=left-1
    }
    return 4
}

