// Exclusive fresh CPU-master initialization, not live bus reconfiguration.
// Caller owns stopped GPSPI2/3, all pads and a stable XTAL/PLL80M source.
// On a shared bus, caller must first deactivate every OTHER device's CS;
// this generic initializer only knows the select supplied here.
// Single-line MSB-first, manual active-low CS; no DMA/IRQ sharing or reset
// pulse. Clock speed must suit the external device and GPIO-matrix timing.
// Status1 ready,2 invalid,3 bus clock,4 busy,5 clock setup,6 mode setup,
// 7 UPDATE timeout,8 pin routing (routing detail in bits8..15).
// CS setup failure is routing detail6 and retains pad ownership. Later failures
// leave CS inactive. No failure starts a transfer or releases shared clocks.
trusted fun esp32s3SpiInitializeCpuOwned(peripheral: int, pins: SpiPins,
    select: Pin, source: int, pre: int, cycles: int, mode: int,
    owner: u32, polls: int,transmitOnly: bool): int {
    if (!(if (transmitOnly) esp32s3SpiTransmitPinsValid(peripheral,pins,select) else esp32s3SpiMasterPinsValid(peripheral, pins, select)) || owner == u32(0) ||
        source < 0 || source > 1 || pre < 1 || pre > 16 || cycles < 1 || cycles > 64 ||
        (cycles == 1 && pre != 1) || mode < 0 || mode > 3 || polls < 1 || polls > 1000000) return 2
    if (!select.outputLevelOwned(true)) return 8 | (6 << 8)
    if (!esp32s3SpiEnableBusClock(peripheral, owner)) return 3
    val base = esp32s3SpiBase(peripheral)
    if (!esp32s3SpiCpuBufferIdle(base)) return 4
    // Own all controller state: remove slave/segmented/line-width/DTR modes,
    // disable interrupts, preserve FIFO-error termination for checked results.
    esp32s3SpiWrite(base + 0x34, 0)
    esp32s3SpiWrite(base + 0x38, 0x7ffff)
    esp32s3SpiWrite(base + 0xe0, 0)
    esp32s3SpiWrite(base + 0x08, 0)
    esp32s3SpiWrite(base + 0x10, 0)
    esp32s3SpiWrite(base + 0x14, 0x10000)
    esp32s3SpiWrite(base + 0x18, 0x08000000)
    esp32s3SpiWrite(base + 0x20, 63)
    esp32s3SpiWrite(base + 0x24, 0)
    esp32s3SpiWrite(base + 0x28, 0)
    esp32s3SpiWrite(base + 0x2c, 0)
    esp32s3SpiWrite(base + 0x30, 0x180000)
    if (!esp32s3SpiConfigureClockOwned(peripheral, source, pre, cycles,
        if (cycles == 1) 1 else cycles / 2)) return 5
    if (!esp32s3SpiConfigureModeOwned(peripheral, mode, false, false)) return 6
    esp32s3SpiWrite(base, 0x00800000)
    var attempt = 0
    while (attempt < polls && (esp32s3SpiRead(base) & 0x00800000) != 0) attempt = attempt + 1
    if (attempt == polls) return 7
    // CPOL is latched before attaching the peripheral clock to its pad.
    val routed = if (transmitOnly) esp32s3SpiRouteTransmitPinsOwned(peripheral,pins,select) else esp32s3SpiRouteMasterPinsOwned(peripheral, pins, select)
    if (routed != 1) return 8 | (routed << 8)
    1
}

// Distinct admission: receive-capable callers still require a real MISO pad.
trusted fun esp32s3SpiInitializeMasterOwned(peripheral: int,pins: SpiPins,
    select: Pin,source: int,pre: int,cycles: int,mode: int,owner: u32,polls: int): int =
    esp32s3SpiInitializeCpuOwned(peripheral,pins,select,source,pre,cycles,mode,owner,polls,false)
// TX-only devices use exactly the same checked register initialization, without
// accessing an absent MISO or changing an unrelated input-matrix route.
trusted fun esp32s3SpiInitializeTransmitOwned(peripheral: int,pins: SpiPins,
    select: Pin,source: int,pre: int,cycles: int,mode: int,owner: u32,polls: int): int =
    esp32s3SpiInitializeCpuOwned(peripheral,pins,select,source,pre,cycles,mode,owner,polls,true)
