import "./clock_c61_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_spi.ab"
@export("c61SpiRead")
trusted fun c61SpiReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("c61SpiWrite")
trusted fun c61SpiWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
