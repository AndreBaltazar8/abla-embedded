// Native SIO read routing: SPID input/output share MOSI. This is NOT the
// full-duplex MISO(SPIQ) route. Peripheral output-enable controls turnaround.
// Caller owns stopped GPSPI2/3, pads/matrix routes and stable clocks; preserve
// all resources after any partial failure. No snapshot/automatic rollback.
fun esp32s3SpiSharedPinsValid(peripheral: int,clock: Pin,data: Pin,cs: Pin): bool =
    (peripheral == 2 || peripheral == 3) && clock.outputCapable() && data.outputCapable() && cs.outputCapable() &&
    clock != data && clock != cs && data != cs
//1ready2invalid3clock4data6CS. CS inactive before either route is changed.
trusted fun esp32s3SpiRouteSharedPinsOwned(peripheral: int,clock: Pin,data: Pin,cs: Pin): int {
    if (!esp32s3SpiSharedPinsValid(peripheral,clock,data,cs)) return 2
    if (!cs.outputLevelOwned(true)) return 6
    val signal=if (peripheral == 2) 101 else 66
    if (!clock.routeOutputSignal(signal,false)) return 3
    if (!data.routeBidirectionalSignal(signal+2,signal+2)) return 4
    return 1
}
