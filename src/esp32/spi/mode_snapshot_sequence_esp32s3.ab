import "./buffer_sequence_esp32s3.ab"
// Scalar snapshot: CPOL0,edge1,RX order2..3,TX order4..5,port6..7,valid8.
// Preserve all two-bit order encodings, not just the boolean API subset.
// Caller owns stopped master and inactive CS across capture/change/restore.
trusted fun esp32s3SpiModeCaptureOwned(port: int): int {
    val base=esp32s3SpiBase(port)
    if (base == 0 || !esp32s3SpiCpuBufferIdle(base) ||
        (esp32s3SpiRead(base+0xe0)&0x04000000) != 0 || (esp32s3SpiRead(base+0xe8)&3) != 3) return 0
    return 256|(port<<6)|((esp32s3SpiRead(base+0x20)>>29)&1)|
        (((esp32s3SpiRead(base+0x10)>>9)&1)<<1)|(((esp32s3SpiRead(base+8)>>23)&15)<<2)
}
//1restored2invalid3busy4slave/clock5readback6UPDATEtimeout. No START/reset.
// Preserve unrelated current fields; this is not a FIFO/phase/profile snapshot.
trusted fun esp32s3SpiModeRestoreOwned(saved: int,polls: int): int {
    val port=(saved>>6)&3
    if ((saved>>>8) != 1 || esp32s3SpiBase(port) == 0 || polls < 1 || polls > 1000000) return 2
    val base=esp32s3SpiBase(port)
    if (!esp32s3SpiCpuBufferIdle(base)) return 3
    if ((esp32s3SpiRead(base+0xe0)&0x04000000) != 0 || (esp32s3SpiRead(base+0xe8)&3) != 3) return 4
    val polarity=(saved&1)<<29;val edge=((saved>>1)&1)<<9;val order=((saved>>2)&15)<<23
    esp32s3SpiWrite(base+0x20,(esp32s3SpiRead(base+0x20)&~0x20000000)|polarity)
    if ((esp32s3SpiRead(base+0x20)&0x20000000) != polarity) return 5
    esp32s3SpiWrite(base+0x10,(esp32s3SpiRead(base+0x10)&~512)|edge)
    if ((esp32s3SpiRead(base+0x10)&512) != edge) return 5
    esp32s3SpiWrite(base+8,(esp32s3SpiRead(base+8)&~0x07800000)|order)
    if ((esp32s3SpiRead(base+8)&0x07800000) != order) return 5
    esp32s3SpiWrite(base,0x00800000)
    var attempt=0
    while (attempt < polls) {
        if ((esp32s3SpiRead(base)&0x01800000) == 0) return 1
        attempt=attempt+1
    }
    return 6
}
