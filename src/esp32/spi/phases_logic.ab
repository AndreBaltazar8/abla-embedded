fun spiPhasesValid(command: int,commandBits: int,address: int,addressBits: int,dummy: int,direction: int,bytes: int): bool =
    commandBits >= 0 && commandBits <= 16 && addressBits >= 0 && addressBits <= 32 && dummy >= 0 && dummy <= 256 &&
    command >= 0 && command < (1<<commandBits) && address >= 0 && address < (1<<addressBits) &&
    direction >= 0 && direction <= 2 && bytes >= 0 && bytes <= 64 && (if (direction == 0) bytes == 0 else bytes > 0) &&
    commandBits+addressBits+dummy+bytes > 0

// The phases of one SPI transaction except the address value, packed so a transaction begin stays within the
// 16 arguments a hook may take: bits 0..15 command, 16..20 command bits (0..16), 21..26 address bits (0..32),
// 27..35 dummy cycles (0..256), 36..37 direction (0 none, 1 write, 2 read), bit 38 set by spiPhases.
// Out-of-range fields give SpiPhases(0), which spiPhasesValid then refuses (its marker bit is clear).
type SpiPhases = int
fun spiPhases(command: int,commandBits: int,addressBits: int,dummy: int,direction: int): SpiPhases {
    if (command < 0 || command > 65535 || commandBits < 0 || commandBits > 16 || addressBits < 0 || addressBits > 32 ||
        dummy < 0 || dummy > 256 || direction < 0 || direction > 2) return SpiPhases(0)
    SpiPhases(command | (commandBits<<16) | (addressBits<<21) | (dummy<<27) | (direction<<36) | (1<<38))
}
fun SpiPhases.command(): int = this & 65535
fun SpiPhases.commandBits(): int = (this>>>16) & 31
fun SpiPhases.addressBits(): int = (this>>>21) & 63
fun SpiPhases.dummy(): int = (this>>>27) & 511
fun SpiPhases.direction(): int = (this>>>36) & 3
fun SpiPhases.packed(): bool = (this>>>38) == 1
// spiPhasesValid for packed phases and the address value.
fun SpiPhases.validWith(address: int,bytes: int): bool =
    this.packed() && spiPhasesValid(this.command(),this.commandBits(),address,this.addressBits(),this.dummy(),this.direction(),bytes)
