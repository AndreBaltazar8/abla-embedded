fun spiPhasesValid(command: int,commandBits: int,address: int,addressBits: int,dummy: int,direction: int,bytes: int): bool =
    commandBits >= 0 && commandBits <= 16 && addressBits >= 0 && addressBits <= 32 && dummy >= 0 && dummy <= 256 &&
    command >= 0 && command < (1<<commandBits) && address >= 0 && address < (1<<addressBits) &&
    direction >= 0 && direction <= 2 && bytes >= 0 && bytes <= 64 && (if (direction == 0) bytes == 0 else bytes > 0) &&
    commandBits+addressBits+dummy+bytes > 0
