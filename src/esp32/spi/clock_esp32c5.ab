import "./clock_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_spi.ab"
@export("c5SpiRead")
trusted fun c5SpiReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("c5SpiWrite")
trusted fun c5SpiWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }

