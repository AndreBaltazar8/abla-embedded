import "./clock_c61_sequence.ab"
import "../gpio_c61_sequence.ab"
import "../../spi/pins.ab"
// Fresh, relinquished pads; caller owns stopped SPI2/global input65 route,
// GPIO clocks/former users/holds/RTC/USB and all inactive device selects.
// External CS pullup required when close releases CS to input. No snapshots
// of live prior output users, no controller reset/clock gating.
// Scalar pin lanes5bits CLK/MOSI/MISO/CS; absent MOSI/MISO=31.
// Status8@24:0closed1ready2invalid3admission4CS5CLK6MOSI7MISO8route9close.
// Attempted pad ownership4bits@32, input-route ownershipbit36/saved9bits@40.
type Esp32C61SpiPins=int
fun Esp32C61SpiPins.status(): int = (this>>>24)&255
fun Esp32C61SpiPins.ready(): bool = this.status() == 1
fun Esp32C61SpiPins.pinAt(index: int): int = (this>>>(index*5))&31
fun c61SpiPinProfileValid(pins: SpiPins,cs: int): bool {
    val clock=pins.clockPin();val mosi=pins.mosiPin();val miso=pins.misoPin()
    return clock >= 0 && clock < 30 && cs >= 0 && cs < 30 && clock != cs &&
        mosi >= -1 && mosi < 30 && miso >= -1 && miso < 30 &&
        mosi != clock && mosi != cs && miso != clock && miso != cs &&
        (mosi < 0 || mosi != miso)
}
trusted fun esp32C61SpiPinsOpenOwned(pins: SpiPins,cs: int,exclusive: bool): Esp32C61SpiPins {
    if (!c61SpiPinProfileValid(pins,cs)) return Esp32C61SpiPins(2<<24)
    if (!exclusive || !esp32C61SpiCpuIdleOwned()) return Esp32C61SpiPins(3<<24)
    val clock=pins.clockPin();val mosi=pins.mosiPin();val miso=pins.misoPin()
    var state=clock|((mosi&31)<<5)|((miso&31)<<10)|(cs<<15)
    var mask=u32(0)
    var index=0
    while (index < 4) {
        val number=(state>>>(index*5))&31
        if (number != 31) mask=mask|(u32(1)<<u32(number))
        index=index+1
    }
    if ((c61GpioRead(0x600960c0)&u32(3)) != u32(1) ||
        (c61GpioRead(0x600960c4)&u32(0x400000)) == u32(0) ||
        ((c61GpioRead(0x600960c4)>>u32(20))&u32(3)) == u32(3) ||
        (c61GpioRead(0x60091df8)&u32(1)) == u32(0) ||
        (c61GpioRead(0x60091034)&mask) != u32(0) ||
        (c61GpioRead(0x600b102c)&mask) != u32(0) ||
        (c61GpioRead(0x600b1028)&mask&u32(127)) != u32(0) ||
        ((mask&u32(0x3000)) != u32(0) && (c61GpioRead(0x6000f018)&u32(16384)) != u32(0))) return Esp32C61SpiPins(state|(3<<24))
    state=state|(8<<32)
    if (esp32C61GpioConfigureOwned(cs,true,true,false,false,0,true) != 1) return Esp32C61SpiPins(state|(4<<24))
    state=state|(1<<32)
    val idle=(c61SpiRead(0x60081020)&u32(1<<29)) != u32(0)
    if (esp32C61GpioConfigureOwned(clock,true,idle,false,false,0,true) != 1 ||
        !c61GpioField(0x60091ad4+clock*4,u32(4095),u32(1024|64))) return Esp32C61SpiPins(state|(5<<24))
    if (mosi >= 0) {
        state=state|(2<<32)
        if (esp32C61GpioConfigureOwned(mosi,true,false,false,false,0,true) != 1 ||
            !c61GpioField(0x60091ad4+mosi*4,u32(4095),u32(1024|66))) return Esp32C61SpiPins(state|(6<<24))
    }
    if (miso >= 0) {
        state=state|(4<<32)
        if (esp32C61GpioConfigureOwned(miso,false,true,false,true,0,true) != 1) return Esp32C61SpiPins(state|(7<<24))
        state=state|(1<<36)|(int(c61GpioRead(0x600913d8)&u32(511))<<40)
        if (!c61GpioField(0x600913d8,u32(511),u32(256|miso))) return Esp32C61SpiPins(state|(8<<24))
    }
    return Esp32C61SpiPins(state|(1<<24))
}
trusted fun Esp32C61SpiPins.closeOwned(exclusiveStopped: bool): Esp32C61SpiPins {
    if (!exclusiveStopped || !esp32C61SpiCpuIdleOwned()) return this
    var state=this&~(255<<24)
    if ((state&(8<<32)) != 0) {
        val cs=this.pinAt(3)
        esp32C61GpioWriteOwned(cs,true)
        if ((c61GpioRead(0x60091004)&(u32(1)<<u32(cs))) == u32(0)) return Esp32C61SpiPins(state|(9<<24))
    }
    if ((state&(1<<36)) != 0) {
        if (!c61GpioField(0x600913d8,u32(511),u32((state>>>40)&511))) return Esp32C61SpiPins(state|(9<<24))
        state=state&~(1<<36)
    }
    // Data/input/clock released before CS; only outstanding pads retried.
    var step=0
    while (step < 4) {
        val index=if (step < 3) 2-step else 3
        val owned=1<<(32+index)
        if ((state&owned) != 0) {
            if (esp32C61GpioConfigureOwned(this.pinAt(index),false,true,false,true,0,true) != 1) return Esp32C61SpiPins(state|(9<<24))
            state=state&~owned
        }
        step=step+1
    }
    return Esp32C61SpiPins(0)
}
