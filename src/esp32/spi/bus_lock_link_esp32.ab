import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSpiBusLockOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredSpiBusInitLock", "spi_bus_init_lock")) return false
    if (!internalFunction("esp32RecoveredSpiBusDeinitLock", "spi_bus_deinit_lock")) return false
    if (!exportFunction("esp32RecoveredSpiBusLockRegisterDev", "spi_bus_lock_register_dev")) return false
    if (!exportFunction("esp32RecoveredSpiBusLockUnregisterDev", "spi_bus_lock_unregister_dev")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockSetBgControl", "spi_bus_lock_set_bg_control")) return false
    if (!exportFunction("esp32RecoveredSpiBusLockGetDevId", "spi_bus_lock_get_dev_id")) return false
    if (!exportFunction("esp32RecoveredSpiBusLockTouch", "spi_bus_lock_touch")) return false
    if (!exportFunction("esp32RecoveredSpiBusLockAcquireStart", "spi_bus_lock_acquire_start")) return false
    if (!exportFunction("esp32RecoveredSpiBusLockAcquireEnd", "spi_bus_lock_acquire_end")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockGetAcquiringDev", "spi_bus_lock_get_acquiring_dev")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockBgEntry", "spi_bus_lock_bg_entry")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockBgExit", "spi_bus_lock_bg_exit")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockBgRequest", "spi_bus_lock_bg_request")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockWaitBgDone", "spi_bus_lock_wait_bg_done")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockBgClearReq", "spi_bus_lock_bg_clear_req")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockBgCheckDevAcq", "spi_bus_lock_bg_check_dev_acq")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockBgCheckDevReq", "spi_bus_lock_bg_check_dev_req")) return false
    if (!internalFunction("esp32RecoveredSpiBusLockBgReqExist", "spi_bus_lock_bg_req_exist")) return false
    true
}
