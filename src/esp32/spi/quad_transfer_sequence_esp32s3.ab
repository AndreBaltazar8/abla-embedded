import "./phases_sequence_esp32s3.ab"
// Single-line command/address/dummy followed by four-line TX data. Physical
// SPI2/3 only,0..16 command bits,0..32 address bits,1..64 data bytes.
// Caller owns selected CS and stopped initialized mode/MSB clock, all quad
// routes and source lifetime. No reads, implicit CS, clock or pin reconfiguration.
// Same bounded UPDATE/START/FIFO-error semantics as CPU single-line transfers.
trusted fun esp32s3SpiQuadTransmitOwned(peripheral: int,command: int,commandBits: int,
    address: int,addressBits: int,dummy: int,data: NativeBuffer,bytes: int,polls: int): int {
    if (polls < 1 || polls > 1000000) return 2
    val prepared=esp32s3SpiPhasesPrepareOwned(peripheral,command,commandBits,address,addressBits,dummy,1,data,bytes,4)
    if (prepared != 1) return prepared
    return esp32s3SpiRunCpuOwned(peripheral,NativeBuffer(0),bytes,polls,false)
}
