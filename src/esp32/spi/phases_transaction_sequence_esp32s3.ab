import "../../peripheral_gate.ab"
import "../../spi/transaction_result.ab"
import "../../spi/buffer_gate.ab"
import "./phases_logic.ab"
import "./select_sequence_esp32s3.ab"
// Canonical shared-bus gate, initialized matching clock/pins and inactive
// other CS lines required. Validate before gate/CS; select only on idle host.
// Command-only transactions are real transfers, not empty successes.
// CS deassertion after error is not controller recovery: fault the gate.
trusted fun esp32s3SpiPhasesTransaction(gate: PeripheralGate,owner: u32,peripheral: int,pins: SpiPins,select: Pin,
    command: int,commandBits: int,address: int,addressBits: int,dummy: int,direction: int,data: NativeBuffer,bytes: int,polls: int,
    setupMicroseconds: int = 0,holdMicroseconds: int = 0): SpiTransactionResult {
    if (!spiPhasesValid(command,commandBits,address,addressBits,dummy,direction,bytes) ||
        !esp32s3SpiMasterPinsValid(peripheral,pins,select) || !esp32s3SpiBufferRangeValid(peripheral,data,bytes) ||
        polls < 1 || polls > 1000000 || setupMicroseconds < 0 || setupMicroseconds > 65535 || holdMicroseconds < 0 || holdMicroseconds > 65535 ||
        gate.word().address() <= 0 || gate.word().address() > 4294967292 || !gate.bufferDisjoint(data,bytes)) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    var detail=esp32s3SpiExchangeReady(peripheral)
    if (detail == 1) {
        detail=esp32s3SpiSelectBegin(select)
        if (detail == 1) {
            if (setupMicroseconds > 0) peripheralDelayMicroseconds(setupMicroseconds)
            detail=esp32s3SpiPhasesOwned(peripheral,command,commandBits,address,addressBits,dummy,direction,data,bytes,polls)
        }
        if ((detail&255) == 1 && holdMicroseconds > 0) peripheralDelayMicroseconds(holdMicroseconds)
        detail=esp32s3SpiSelectEnd(select,detail)
    }
    val healthy=(detail&255) == 1
    if (!gate.finish(owner,healthy)) return SpiTransactionResult((5<<32)|detail)
    return SpiTransactionResult(((if (healthy) 1 else 6)<<32)|detail)
}
