import "../sdk/raw_buffer.ab"
trusted fun esp32s3SpiTransmitByteOwned(peripheral: int, value: int, polls: int): int {
    if (value < 0 || value > 255) return 2
    val address = nativeStackAllocate(4)
    ablaUnsafeStoreU8(nativePointerFromAddress(address), value)
    esp32s3SpiTransmitOwned(peripheral, nativeBufferAt(address, 1), 1, polls)
}

// Bounded RGB565 wire-order block, at most64 stack bytes, no framebuffer.
trusted fun esp32s3SpiTransmitColorOwned(peripheral: int, color: u32, pixels: int): int {
    if (pixels < 1 || pixels > 32 || color > u32(65535)) return 2
    val address = nativeStackAllocate(64)
    var index = u32(0)
    while (index < u32(pixels)) {
        ablaUnsafeStoreU8(nativePointerFromAddress(address + int(index << u32(1))), int(color >>> u32(8)))
        ablaUnsafeStoreU8(nativePointerFromAddress(address + int((index << u32(1)) + u32(1))), int(color))
        index = index + u32(1)
    }
    esp32s3SpiTransmitOwned(peripheral, nativeBufferAt(address, pixels * 2), pixels * 2, 100000)
}
