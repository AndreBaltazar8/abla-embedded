import "../../spi/quad_pins.ab"
// Write-only single/quad data bus; no input-matrix routes or implicit reads.
// Caller owns all six pads, released RTC/USB/holds, stopped SPI2/3 and peers.
fun esp32s3SpiQuadTransmitPinsValid(peripheral: int,pins: QuadSpiPins,select: Pin): bool {
    if ((peripheral != 2 && peripheral != 3) || !select.outputCapable() ||
        !Pin(pins.clockPin()).outputCapable() || pins.clockPin() == select.number()) return false
    var lane=0
    while (lane < 4) {
        val number=pins.dataPin(lane)
        if (!Pin(number).outputCapable() || number == pins.clockPin() || number == select.number()) return false
        var previous=0
        while (previous < lane) {
            if (number == pins.dataPin(previous)) return false
            previous=previous+1
        }
        lane=lane+1
    }
    return true
}
// Status1 ready,2 invalid,3 CS,4 CLK,5..8 IO0..3 route failure.
// CS inactive before routing; first error stops and retains pad ownership.
// ESP S3 IO0=D,IO1=Q,IO2=WP,IO3=HD (not sequential signal indices).
trusted fun esp32s3SpiRouteQuadTransmitPinsOwned(peripheral: int,pins: QuadSpiPins,select: Pin): int {
    if (!esp32s3SpiQuadTransmitPinsValid(peripheral,pins,select)) return 2
    if (!select.outputLevelOwned(true)) return 3
    val signal=if (peripheral == 2) 101 else 66
    if (!Pin(pins.clockPin()).routeOutputSignal(signal,false)) return 4
    var lane=0
    while (lane < 4) {
        val offset=if (lane == 0) 2 else if (lane == 1) 1 else if (lane == 2) 4 else 3
        if (!Pin(pins.dataPin(lane)).routeOutputSignal(signal+offset,false)) return 5+lane
        lane=lane+1
    }
    return 1
}
