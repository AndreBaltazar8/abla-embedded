import "./pins_sequence_esp32s3.ab"
import "../gpio/snapshot_s3_sequence.ab"
import "../gpio/input_snapshot_s3_sequence.ab"
import "../sdk/raw_buffer.ab"
// Exclusive32B record: magic/status/input/error, then CLK/MOSI/MISO/CS pad
// snapshots. Caller owns stopped SPI/DMA and both prior/new global input
// consumers, RTC/USB/analog/holds/sleep and GPIO register serialization.
// 0invalid,1ready,2closed,3cleanuprequired. Partial failures retain originals.
trusted fun esp32S3SpiPinSessionValid(r: NativeBuffer): bool = r.hasAddressRange(0,32) &&
    (r.addressValue()&3) == 0 && r.loadU32(0) == 0x53505333
trusted fun esp32S3SpiPinsCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!esp32S3SpiPinSessionValid(r) || !exclusive) return 0
    if (r.loadU32(4) == 2) return 2
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 0
    r.storeU32(4,3)
    val select=S3GpioSnapshot(r.loadU32(28))
    if (!select.valid()) return 0
    // Deassert the session's manual CS even if the last transfer left it low.
    val bank=esp32S3GpioBankOffset(select.pin());val bit=1<<(select.pin()&31)
    esp32S3PinStateWrite(0x60004008+bank,bit)
    if ((esp32S3PinStateRead(0x60004004+bank)&bit) == 0) { r.storeU32(12,17);return 3 }
    if (S3GpioInputSnapshot(r.loadU32(8)).restoreOwned(true) != 1) { r.storeU32(12,16);return 3 }
    // Restore data and clock while CS remains inactive; restore original CS
    // last. A failure never proceeds to potentially reassert the old select.
    var step=0
    while (step < 4) {
        val index=if (step < 3) 2-step else 3
        if (S3GpioSnapshot(r.loadU32(16+index*4)).restoreOwned(true) != 1) { r.storeU32(12,32+index);return 3 }
        step=step+1
    }
    r.storeU32(4,2);r.storeU32(12,0)
    return 2
}
trusted fun esp32S3SpiPinsCaptureOwned(r: NativeBuffer,peripheral: int,pins: SpiPins,select: Pin,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,32) || (r.addressValue()&3) != 0 || !esp32s3SpiMasterPinsValid(peripheral,pins,select)) return 0
    if (r.loadU32(0) != 0 && (!esp32S3SpiPinSessionValid(r) || r.loadU32(4) != 2)) return 0
    // Capture all values before any pad mutation. Valid pins are guaranteed
    // by the full profile check; these snapshots are read-only.
    var index=0
    while (index < 4) {
        val number=if (index == 0) pins.clockPin() else if (index == 1) pins.mosiPin() else if (index == 2) pins.misoPin() else select.number()
        val saved=esp32S3GpioSnapshotOwned(number,true)
        if (!saved.valid()) return 0
        r.storeU32(16+index*4,saved|0);index=index+1
    }
    val input=esp32S3GpioInputCaptureOwned(if (peripheral == 2) 102 else 67,true)
    r.storeU32(8,input|0);r.storeU32(0,0x53505333);r.storeU32(4,3);r.storeU32(12,0)
    return 1
}
trusted fun esp32S3SpiPinsOpenOwned(r: NativeBuffer,peripheral: int,pins: SpiPins,select: Pin,exclusive: bool): int {
    if (esp32S3SpiPinsCaptureOwned(r,peripheral,pins,select,exclusive) != 1) return 0
    val routed=esp32s3SpiRouteMasterPinsOwned(peripheral,pins,select)
    if (routed != 1) { r.storeU32(12,routed);return 3 }
    return esp32S3SpiPinsConfirmReady(r,select)
}
trusted fun esp32S3SpiPinsConfirmReady(r: NativeBuffer,select: Pin): int {
    // Legacy Pin.output is void: verify manual-CS routing/enable/latch before
    // reporting ready. Never infer success merely from the later data routes.
    val cs=select.number();val bank=esp32S3GpioBankOffset(cs);val bit=1<<(cs&31)
    if ((esp32S3PinStateRead(0x60004554+cs*4)&4095) != 1280 ||
        (esp32S3PinStateRead(esp32S3GpioMuxAddress(cs))&0x7000) != 0x1000 ||
        (esp32S3PinStateRead(0x60004074+cs*4)&4) != 0 ||
        (esp32S3PinStateRead(0x60004020+bank)&bit) == 0 ||
        (esp32S3PinStateRead(0x60004004+bank)&bit) == 0) { r.storeU32(12,6);return 3 }
    r.storeU32(4,1)
    return 1
}
