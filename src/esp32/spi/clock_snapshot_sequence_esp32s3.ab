import "./buffer_sequence_esp32s3.ab"
// Read-only snapshot of CLOCK and CLK_GATE for a ready owned GPSPI2/3.
// Retain caller-owned16B until restoration completes: magic,peripheral,
// CLOCK,CLK_GATE. No lease/gate acquisition is implicit. Caller serializes
// all register users and keeps BOTH original and temporary clock sources live.
// Capture output is untouched on invalid/busy/not-enabled admission.
trusted fun esp32s3SpiClockSnapshotOwned(record: NativeBuffer,peripheral: int,exclusive: bool): bool {
    if (!exclusive || !esp32s3SpiMemoryRangeValid(peripheral,record,16) || (record.addressValue()&3) != 0) return false
    val base=esp32s3SpiBase(peripheral)
    if (!esp32s3SpiCpuBufferIdle(base) || (esp32s3SpiRead(base+0xe0)&0x04000000) != 0) return false
    val clock=esp32s3SpiRead(base+0x0c);val gate=esp32s3SpiRead(base+0xe8)
    if ((gate&3) != 3) return false
    record.storeU32(4,peripheral);record.storeU32(8,clock);record.storeU32(12,gate)
    record.storeU32(0,0x53434c4b);return true
}
//1restored2invalid3busy4configuration5readback6UPDATEtimeout. Retry uses the
// same immutable snapshot; never gate clocks while UPDATE/START/DMA is active.
// Keep ownership after EVERY failure. Only restores clock/source/gating, not
// mode/FIFO/command/pad state or fault status. No START, data or CS operations.
trusted fun esp32s3SpiClockRestoreOwned(record: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,16) || (record.addressValue()&3) != 0 ||
        record.loadU32(0) != 0x53434c4b || polls < 1 || polls > 1000000 ||
        !esp32s3SpiMemoryRangeValid(record.loadU32(4),record,16) || (record.loadU32(12)&3) != 3) return 2
    val base=esp32s3SpiBase(record.loadU32(4))
    if (!esp32s3SpiCpuBufferIdle(base)) return 3
    if ((esp32s3SpiRead(base+0xe0)&0x04000000) != 0) return 4
    val disabled=esp32s3SpiRead(base+0xe8)&0xfffffff8
    esp32s3SpiWrite(base+0xe8,disabled)
    if (esp32s3SpiRead(base+0xe8) != disabled) return 5
    esp32s3SpiWrite(base+0x0c,record.loadU32(8))
    if (esp32s3SpiRead(base+0x0c) != record.loadU32(8)) return 5
    esp32s3SpiWrite(base+0xe8,record.loadU32(12))
    if (esp32s3SpiRead(base+0xe8) != record.loadU32(12)) return 5
    // Commit the restored divider fields without launching a transaction.
    esp32s3SpiWrite(base,0x00800000)
    var attempt=0
    while (attempt < polls) {
        if ((esp32s3SpiRead(base)&0x01800000) == 0) return 1
        attempt=attempt+1
    }
    return 6
}
