import "./pin_session_s3_sequence.ab"
// Exclusive40B record: pin-session32 + peripheral32/owner36. Fresh CPU master
// only; owns stopped SPI/DMA, all pads/global MISO consumer and shared RCC.
// Stable XTAL/PLL80MHz, all OTHER device CS inactive. No live reconfiguration.
// Close waits UPDATE/USR idle with DMA disabled before restoring any pad;
// timeout/clock errors retain record/ownership. Shared clocks stay enabled.
// Use transaction APIs only in ready state and retain canonical gate ownership
// through close. This record does not replace the gate or a queue's ownership.
trusted fun esp32S3SpiMasterSessionBeginOwned(r: NativeBuffer,peripheral: int,pins: SpiPins,select: Pin,
    source: int,pre: int,cycles: int,mode: int,owner: u32,polls: int,exclusive: bool): int {
    if (!r.hasAddressRange(0,40) || owner == u32(0) || source < 0 || source > 1 ||
        pre < 1 || pre > 16 || cycles < 1 || cycles > 64 || (cycles == 1 && pre != 1) ||
        mode < 0 || mode > 3 || polls < 1 || polls > 1000000) return 0
    if (esp32S3SpiPinsCaptureOwned(r,peripheral,pins,select,exclusive) != 1) return 0
    r.storeU32(32,peripheral);r.storeU32(36,int(owner))
    val initialized=esp32s3SpiInitializeMasterOwned(peripheral,pins,select,source,pre,cycles,mode,owner,polls)
    r.storeU32(12,initialized)
    if (initialized != 1) return 3
    return esp32S3SpiPinsConfirmReady(r,select)
}
trusted fun esp32S3SpiMasterSessionCloseOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,40) || !esp32S3SpiPinSessionValid(r) || polls < 1 || polls > 1000000) return 0
    if (r.loadU32(4) == 2) return 2
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 0
    val peripheral=r.loadU32(32);val owner=u32(r.loadU32(36))
    if ((peripheral != 2 && peripheral != 3) || owner == u32(0)) return 0
    r.storeU32(4,3)
    // Re-enable/deassert only, never pulse reset; a stalled finite transaction
    // may finish once its clock returns. No unproven stop/reset bypass.
    if (!esp32s3SpiEnableBusClock(peripheral,owner)) { r.storeU32(12,64);return 3 }
    val base=esp32s3SpiBase(peripheral)
    var attempt=0
    while (attempt < polls) {
        if (esp32s3SpiCpuBufferIdle(base)) return esp32S3SpiPinsCloseOwned(r,true)
        attempt=attempt+1
    }
    r.storeU32(12,65)
    return 3
}
