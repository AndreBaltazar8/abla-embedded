import "abla/unsafe/memory"

// ESP32 has three SPI host slots. Host zero is the statically allocated main
// flash bus; the application hosts are installed as they are initialized.
val esp32SpiMainBusStorage = nativeStaticAllocate(104)

trusted fun esp32SpiMainBusInitialize(): int {
    // bus_attr.max_transfer_sz in the SDK's static main-bus descriptor.
    ablaUnsafeStoreU32(
        nativePointerFromAddress(esp32SpiMainBusStorage + 84), 64
    )
    esp32SpiMainBusStorage
}

val esp32SpiMainBus = u32(esp32SpiMainBusInitialize())
var esp32SpiBusOne: u32 = u32(0)
var esp32SpiBusTwo: u32 = u32(0)

trusted fun esp32SpiSetBusContext(host: u32, context: u32): void {
    if (host == u32(1)) esp32SpiBusOne = context
    else if (host == u32(2)) esp32SpiBusTwo = context
}

trusted fun esp32SpiBusContext(host: u32): u32 =
    if (host == u32(0)) esp32SpiMainBus else
        if (host == u32(1)) esp32SpiBusOne else
            if (host == u32(2)) esp32SpiBusTwo else u32(0)

// Original ABI symbol: spi_bus_lock_get_by_id.
trusted fun esp32SpiBusLockGetById(host: u32): u32 {
    val context = esp32SpiBusContext(host)
    if (context == u32(0)) return u32(0)
    u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(context + u32(100)))
    ))
}
