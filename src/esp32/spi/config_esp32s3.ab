import "./buffer_esp32s3.ab"
import "./config_sequence_esp32s3.ab"
import "../rcc_esp32s3.ab"
trusted fun esp32s3SpiEnableBusClock(peripheral: int, owner: u32): bool {
    if (esp32s3SpiBase(peripheral) == 0) return false
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    val enabled = esp32s3SpiEnableBusClockLocked(peripheral)
    atomicMemoryFence()
    val released = esp32S3RccLeave(lock, owner, saved)
    enabled && released
}
