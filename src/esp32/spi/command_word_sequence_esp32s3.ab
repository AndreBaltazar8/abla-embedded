import "../sdk/raw_buffer.ab"
// Internal validated command/pins, caller holds the canonical bus gate.
// Emits the low1..4 bytes of value in wire (most-significant-first) order.
trusted fun esp32s3SpiCommandWordOwned(peripheral: int, select: Pin, dataCommand: Pin,
    command: int, value: u32, bytes: int, sharedDataCommand: bool): int {
    if (bytes < 1 || bytes > 4) return 2
    val address = nativeStackAllocate(4)
    var offset = u32(0)
    while (offset < u32(bytes)) {
        ablaUnsafeStoreU8(nativePointerFromAddress(address + int(offset)),
            int(value >>> ((u32(bytes) - offset - u32(1)) << u32(3))))
        offset = offset + u32(1)
    }
    esp32s3SpiCommandOwned(peripheral, select, dataCommand, command,
        nativeBufferAt(address, bytes), bytes, sharedDataCommand)
}
