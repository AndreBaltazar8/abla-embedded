import "../../spi/pins.ab"

// Transmit-only clients may omit MISO (-1). Keep full-duplex admission strict.
fun esp32s3SpiTransmitPinsValid(peripheral: int,pins: SpiPins,select: Pin): bool {
    if (pins.misoPin() != -1) return esp32s3SpiMasterPinsValid(peripheral,pins,select)
    val clock=Pin(pins.clockPin());val mosi=Pin(pins.mosiPin())
    return (peripheral == 2 || peripheral == 3) && clock.outputCapable() &&
        mosi.outputCapable() && select.outputCapable() && clock != mosi &&
        clock != select && mosi != select
}

// No absent-pad access or input-matrix mutation for write-only peripherals.
trusted fun esp32s3SpiRouteTransmitPinsOwned(peripheral: int,pins: SpiPins,select: Pin): int {
    if (!esp32s3SpiTransmitPinsValid(peripheral,pins,select)) return 2
    if (pins.misoPin() != -1) return esp32s3SpiRouteMasterPinsOwned(peripheral,pins,select)
    if (!select.outputLevelOwned(true)) return 6
    val signal=if (peripheral == 2) 101 else 66
    if (!Pin(pins.clockPin()).routeOutputSignal(signal,false)) return 3
    if (!Pin(pins.mosiPin()).routeOutputSignal(signal+2,false)) return 4
    return 1
}

// Single-line full-duplex profile with manual active-low GPIO chip select.
// All four pads must be distinct and exclusively owned/released from RTC,
// USB and other peripherals. Peripheral must already be stopped/configured.
fun esp32s3SpiMasterPinsValid(peripheral: int, pins: SpiPins, select: Pin): bool {
    val clock = Pin(pins.clockPin()); val mosi = Pin(pins.mosiPin()); val miso = Pin(pins.misoPin())
    (peripheral == 2 || peripheral == 3) && clock.outputCapable() &&
        mosi.outputCapable() && miso.valid() && select.outputCapable() &&
        clock != mosi && clock != miso && clock != select &&
        mosi != miso && mosi != select && miso != select
}

// Status1 ready,2 invalid,3 clock route,4 MOSI route,5 MISO route,6 CS setup.
// CS is checked inactive BEFORE routing clock/data; CS failure retains ownership.
// No transfer, CS assertion, clock setup or ownership inference is hidden.
trusted fun esp32s3SpiRouteMasterPinsOwned(peripheral: int, pins: SpiPins, select: Pin): int {
    if (!esp32s3SpiMasterPinsValid(peripheral, pins, select)) return 2
    if (!select.outputLevelOwned(true)) return 6
    val clockSignal = if (peripheral == 2) 101 else 66
    if (!Pin(pins.clockPin()).routeOutputSignal(clockSignal, false)) return 3
    if (!Pin(pins.mosiPin()).routeOutputSignal(clockSignal + 2, false)) return 4
    if (!Pin(pins.misoPin()).routeInputSignal(clockSignal + 1, false)) return 5
    1
}
