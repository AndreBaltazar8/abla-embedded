import "../sdk/raw_buffer.ab"

// Physical GPSPI numbers2/3, NOT IDF host enum values1/2. Never accesses the
// flash/PSRAM controllers SPI0/1. Caller owns a powered, stopped controller
// with DMA disabled and the full low64-byte CPU buffer selected.
fun esp32s3SpiBase(peripheral: int): int =
    if (peripheral == 2 || peripheral == 3) 0x60024000 + (peripheral - 2) * 4096 else 0

fun esp32s3SpiBufferRangeValid(peripheral: int, buffer: NativeBuffer, bytes: int): bool =
    bytes <= 64 && esp32s3SpiMemoryRangeValid(peripheral, buffer, bytes)

fun esp32s3SpiMemoryRangeValid(peripheral: int, buffer: NativeBuffer, bytes: int): bool {
    if (esp32s3SpiBase(peripheral) == 0 || bytes < 0 ||
        !buffer.hasAddressRange(0, bytes)) return false
    // RAM must not alias either controller's registers during the copy.
    bytes == 0 || buffer.addressValue() >= 0x60026000 ||
        buffer.addressValue() + bytes <= 0x60024000
}

trusted fun esp32s3SpiCpuBufferIdle(base: int): bool =
    (esp32s3SpiRead(base) & 0x01800000) == 0 &&
        (esp32s3SpiRead(base + 0x30) & 0x18000000) == 0

// Exact byte bounds, including unaligned buffers and1..3-byte final words.
// High unused bytes of the final TX word become zero; no libc/overread.
// Does not configure timing/length, reset FIFOs, assert CS, or start transfer.
trusted fun esp32s3SpiWriteBufferOwned(peripheral: int, source: NativeBuffer, bytes: int): bool {
    if (!esp32s3SpiBufferRangeValid(peripheral, source, bytes)) return false
    if (bytes == 0) return true
    val base = esp32s3SpiBase(peripheral)
    if (!esp32s3SpiCpuBufferIdle(base)) return false
    var offset = 0
    while (offset < bytes) {
        var word = 0
        var lane = 0
        while (lane < 4 && offset + lane < bytes) {
            word = word | (source.load(offset + lane) << (lane * 8))
            lane = lane + 1
        }
        esp32s3SpiWrite(base + 0x98 + offset, word)
        offset = offset + 4
    }
    true
}

// Only call after independently verifying transaction completion. A stopped
// command alone is not proof a previous transaction actually succeeded.
trusted fun esp32s3SpiReadBufferOwned(peripheral: int, destination: NativeBuffer, bytes: int): bool {
    if (!esp32s3SpiBufferRangeValid(peripheral, destination, bytes)) return false
    if (bytes == 0) return true
    val base = esp32s3SpiBase(peripheral)
    if (!esp32s3SpiCpuBufferIdle(base)) return false
    var offset = 0
    while (offset < bytes) {
        val word = esp32s3SpiRead(base + 0x98 + offset)
        var lane = 0
        while (lane < 4 && offset + lane < bytes) {
            destination.store(offset + lane, word >>> (lane * 8))
            lane = lane + 1
        }
        offset = offset + 4
    }
    true
}
