import "./irq_vectors_p4_sequence.ab"
import "./clic_vectors_esp32p4.ab"
import "./irq_entry_esp32p4.ab"

// Uses the real context-saving/MRET entry, not an ordinary function address.
// Publication is separate: configure the dispatcher, then explicitly install
// vectors with expected old CSRs. Keep all interrupt sources disabled until
// their callbacks, routing and acknowledgements are ready.
trusted fun esp32P4IrqPrepareTableOwned(table: NativeBuffer,local: NativeBuffer): int =
    esp32P4IrqPrepareVectorsOwned(table,local,esp32P4IrqEntryAddress())
