import "./lp_p4_sequence.ab"
import "abla/unsafe/mmio"
// LP_WDT base50116000; eFuse repeat-data1 delay bits16..17, both revisions.
trusted fun p4LpWatchdogRead(offset: int): int = mmioLoadU32(0x50116000+offset)
trusted fun p4LpWatchdogWrite(offset: int,value: int): void { mmioStoreU32(0x50116000+offset,value); return }
trusted fun p4LpWatchdogDelay(): int = (mmioLoadU32(0x5012d034)>>>16)&3
