import "./lp_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_watchdog.ab"
// LP_WDT base50116000; eFuse repeat-data1 delay bits16..17, both revisions.
@export("p4LpWatchdogRead")
trusted fun p4LpWatchdogReadHook(offset: int): int = mmioLoadU32(0x50116000+offset)
@export("p4LpWatchdogWrite")
trusted fun p4LpWatchdogWriteHook(offset: int,value: int): void { mmioStoreU32(0x50116000+offset,value); return }
@export("p4LpWatchdogDelay")
trusted fun p4LpWatchdogDelayHook(): int = (mmioLoadU32(0x5012d034)>>>16)&3
