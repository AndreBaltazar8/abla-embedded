import "./sar_power_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("esp32SarPowerRead")
trusted fun esp32SarPowerReadHook(offset: int): int = mmioLoadU32(0x3ff48800+offset)
@export("esp32SarPowerWrite")
trusted fun esp32SarPowerWriteHook(offset: int,value: int): void { mmioStoreU32(0x3ff48800+offset,value); return }
