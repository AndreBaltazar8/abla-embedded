import "./adc_calibration_c5_logic.ab"
// Read-only block2 public calibration shadows. No key blocks, writes, fuse
// burning or reload. Caller guarantees C5, loaded/error-checked shadows and
// excludes reload/sleep. Block2 has no RD_DIS bit (only blocks4..10 do).
trusted fun c5AdcFuseField(bit: int,width: int): int {
    if (bit < 145 || width < 1 || width > 10 || bit+width > 249) return -1
    val offset=0x5c+int(u32(bit)>>u32(5))*4
    val low=u32(bit&31)
    var value=c5AdcFuseRead(offset)>>low
    if (int(low)+width > 32) value=value|(c5AdcFuseRead(offset+4)<<(u32(32)-low))
    return int(value&((u32(1)<<u32(width))-u32(1)))
}
trusted fun esp32c5AdcReadCalibration(channel: int,attenuation: int,shadowsReady: bool): C5AdcCalibration {
    if (!shadowsReady || channel < 0 || channel > 5 || attenuation < 0 || attenuation > 3) return C5AdcCalibration(2)
    val versionWord=c5AdcFuseRead(0x4c)
    val major=int((versionWord>>u32(11))&u32(3))
    val minor=int((versionWord>>u32(8))&u32(7))
    if (major != 0 || minor == 0) return C5AdcCalibration(3)
    return esp32c5AdcCalibrationFromFields(channel,attenuation,minor,c5AdcFuseField(145+attenuation*10,10),c5AdcFuseField(185+attenuation*10,10),c5AdcFuseField(225+channel*4,4))
}
