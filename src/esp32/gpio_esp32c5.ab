import "./gpio_pin_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("c5GpioRead")
trusted fun c5GpioReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("c5GpioWrite")
trusted fun c5GpioWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }

