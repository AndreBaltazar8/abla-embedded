import "./adc_fuse_s3_sequence.ab"
// ESP-IDF S3 adc_ll_set_calibration_param: SAR block0x69/host1;
// ADC1 high/low registers1/0, ADC2 registers4/3. High field is low4bits.
// Caller exclusively owns analog bus and selected ADC, pins bus/SAR power,
// stops conversions/DMA/ULP/arbiter clients and excludes sleep/reconfiguration.
// No conversion may resume after partial failure until trim is fully verified.
// 1verified2invalid3highreadback4lowreadback5finalreadback. No reset/rollback.
trusted fun esp32S3AdcApplyTrimOwned(calibration: Esp32S3AdcCalibration): int {
    if (!calibration.valid()) return 2
    val high=if (calibration.unit() == 1) 1 else 4
    val low=high-1
    val code=calibration.initCode()
    val before=esp32S3SarAnalogRead(high)
    val desired=(before&240)|((code>>8)&15)
    esp32S3SarAnalogWrite(high,desired)
    if (esp32S3SarAnalogRead(high) != desired) return 3
    esp32S3SarAnalogWrite(low,code&255)
    if (esp32S3SarAnalogRead(low) != (code&255)) return 4
    // Recheck both bytes together; upper-nibble neighbors must be unchanged.
    if (esp32S3SarAnalogRead(high) != desired || esp32S3SarAnalogRead(low) != (code&255)) return 5
    return 1
}
