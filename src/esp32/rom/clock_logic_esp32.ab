// Pure integer portions shared by the classic ESP32 ROM XTAL and SPI-flash
// clock implementations. Keeping these target-independent makes their exact
// register encodings directly testable and exposes all arithmetic to LLVM.

@inline
fun esp32RomStoredXtalFrequency(stored: u32): u32 {
    val low = stored & u32(0xffff)
    val high = stored >>> u32(16)
    if (low == high && low != u32(0) && low != u32(0xffff)) {
        return low << u32(12)
    }
    return u32(0)
}

fun esp32RomDetectedXtalFrequency(
    rtcCalibrationCounter: u32,
    efuseEightMhzCalibration: u32
): u32 {
    val counterScale = (rtcCalibrationCounter >>> u32(7)) * u32(15625)
    val calibrated = counterScale * (efuseEightMhzCalibration & u32(255))
    val reciprocalProduct = u64(calibrated) * u64(0xcccccccd)
    val detected = u32(reciprocalProduct >>> u64(37))
    return if (detected == u32(0)) u32(26000000) else detected
}

@inline
fun esp32RomSpiflashClockRegisterAddress(spi: u32): u32 =
    (u32(0x3ff43) - (spi & u32(255))) << u32(12)

@inline
fun esp32RomSpiflashClockRegisterValue(frequencyDivider: u32): u32 {
    val divider = frequencyDivider & u32(255)
    if (divider < u32(2)) return u32(0x80000000)
    val cycleLength = divider - u32(1)
    val highLength = (divider >>> u32(1)) - u32(1)
    return (cycleLength << u32(12)) | cycleLength |
        (highLength << u32(6))
}
