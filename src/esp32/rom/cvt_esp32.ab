import "../../runtime/freestanding_integer.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32RomCvtLoadByte(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32RomCvtStoreByte(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

// Ordinary Abla implementation of the classic ROM cvt helper. The value is
// supplied as its two ABI words, followed by base, minimum width, digit table,
// and output buffer. It returns the number of digits excluding the terminator.
trusted fun esp32RomCvt(
    valueLow: u32,
    valueHigh: u32,
    base: u32,
    minimumWidth: u32,
    digits: u32,
    output: u32
): u32 {
    if (base < u32(2) || digits == u32(0) || output == u32(0)) {
        return u32(0)
    }
    val divisor = u64(base)
    var value = u64(valueLow) | (u64(valueHigh) << u64(32))
    var count = u32(0)
    var cursor = output
    while (true) {
        val remainder = freestandingUnsignedRemainder(value, divisor)
        esp32RomCvtStoreByte(cursor, esp32RomCvtLoadByte(
            digits + u32(remainder)
        ))
        cursor = cursor + u32(1)
        count = count + u32(1)
        value = freestandingUnsignedDivide(value, divisor)
        if (value == u64(0)) break
    }
    while (i32(count) < i32(minimumWidth)) {
        esp32RomCvtStoreByte(cursor, u32(48))
        cursor = cursor + u32(1)
        count = count + u32(1)
    }
    esp32RomCvtStoreByte(cursor, u32(0))
    var left = output
    var right = cursor - u32(1)
    while (left < right) {
        val first = esp32RomCvtLoadByte(left)
        val last = esp32RomCvtLoadByte(right)
        esp32RomCvtStoreByte(left, last)
        esp32RomCvtStoreByte(right, first)
        left = left + u32(1)
        right = right - u32(1)
    }
    count
}
