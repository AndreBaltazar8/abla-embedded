import "../../register.ab"
import "../../xtensa/assembly.ab"
import "../../xtensa/cpu.ab"
import "abla/unsafe/memory"
import "abla/unsafe/mmio"
import "abla/unsafe/native"

// Abla/LLVM implementation of ESP32 ROM output-channel installation, output
// multiplexing, CPU tick-rate synchronization, delays, startup control, and
// interrupt routing.

// Original ABI symbol: esp_rom_output_to_channels.
@section(".iram1.0.abla.esp32RomOutputToChannels")
trusted fun esp32RomOutputToChannels(character: u32): void {
    val byte = int(character & u32(255))
    val first = ablaUnsafeVolatileLoadU32(1073405972)
    if (first != 0) callNativeVoidI32(first, byte)
    val second = ablaUnsafeVolatileLoadU32(1073405968)
    if (second != 0) callNativeVoidI32(second, byte)
    return
}

// Original ABI symbol: esp_rom_install_channel_putc. The two fixed stores are
// also the complete classic-ROM implementations of ets_install_putc1/2.
@section(".iram1.abla.esp32RomInstallChannelPutc")
trusted fun esp32RomInstallChannelPutc(channel: u32, callback: u32): void {
    if (channel == u32(1)) {
        ablaUnsafeVolatileStoreU32(1073405972, int(callback))
    } else if (channel == u32(2)) {
        ablaUnsafeVolatileStoreU32(1073405968, int(callback))
    }
    return
}

@section(".iram1.abla.esp32RomInstallDefaultOutput")
trusted fun esp32RomInstallDefaultOutput(): void {
    val callback = nativeFunctionAddress(esp32RomOutputPutc)
    ablaUnsafeVolatileStoreU32(1073405972, callback)
    return
}

@inline
trusted fun esp32RomProTicksAddress(): u32 =
    u32(1073611232)

@inline
trusted fun esp32RomAppTicksAddress(): u32 =
    u32(1073627376)

@inline
trusted fun esp32RomCurrentTicksAddress(): u32 {
    val core = cpuCoreId()
    if (core == u32(0))
        esp32RomProTicksAddress() else esp32RomAppTicksAddress()
}

@inline
trusted fun esp32RomLoadWord(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32RomStoreWord(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

// Original ABI symbol: esp_rom_set_cpu_ticks_per_us.
@section(".iram1.0.abla.esp32RomSetCpuTicksPerUs")
trusted fun esp32RomSetCpuTicksPerUs(ticksPerMicrosecond: u32): void {
    esp32RomStoreWord(esp32RomProTicksAddress(), ticksPerMicrosecond)
    esp32RomStoreWord(esp32RomAppTicksAddress(), ticksPerMicrosecond)
}

// Original ABI symbols: ets_update_cpu_frequency_rom and
// ets_update_cpu_frequency. ROM's operation updates the current CPU only.
@section(".iram1.0.abla.esp32RomUpdateCpuFrequency")
trusted fun esp32RomUpdateCpuFrequency(ticksPerMicrosecond: u32): void =
    esp32RomStoreWord(esp32RomCurrentTicksAddress(), ticksPerMicrosecond)

@section(".iram1.abla.esp32EtsUpdateCpuFrequency")
trusted fun esp32EtsUpdateCpuFrequency(ticksPerMicrosecond: u32): void =
    esp32RomUpdateCpuFrequency(ticksPerMicrosecond)

// Original ABI symbol: esp_rom_get_cpu_ticks_per_us.
@section(".iram1.0.abla.esp32RomGetCpuTicksPerUs")
trusted fun esp32RomGetCpuTicksPerUs(): u32 =
    esp32RomLoadWord(esp32RomCurrentTicksAddress())

// Wraparound subtraction is intentional: CCOUNT and the product both use
// modulo-2^32 arithmetic, matching the ROM contract exactly.
@noinline
@section(".iram1.0.abla.esp32DelayMicroseconds")
trusted fun esp32DelayMicroseconds(microseconds: u32): void {
    val start = xtensaReadCycleCount()
    val cycles = microseconds * esp32RomGetCpuTicksPerUs()
    while (xtensaReadCycleCount() - start < cycles) {}
}

// Original ABI symbols: esp_rom_delay_us and ets_delay_us.
@section(".iram1.0.abla.esp32RomDelayUs")
trusted fun esp32RomDelayUs(microseconds: u32): void =
    esp32DelayMicroseconds(microseconds)

@section(".iram1.0.abla.esp32EtsDelayUs")
trusted fun esp32EtsDelayUs(microseconds: u32): void =
    esp32DelayMicroseconds(microseconds)

trusted fun esp32RomDelayUsValue(microseconds: u32): u32 {
    esp32RomDelayUs(microseconds)
    u32(0)
}

trusted fun esp32EtsDelayUsValue(microseconds: u32): u32 {
    esp32EtsDelayUs(microseconds)
    u32(0)
}

// Original ABI symbol: esp_rom_route_intr_matrix (ROM intr_matrix_set).
@section(".iram1.0.abla.esp32RomRouteInterruptMatrix")
@inline
trusted fun esp32RomRouteInterruptMatrix(
    cpu: u32,
    source: u32,
    interrupt: u32
): void {
    val base = if (cpu == u32(0)) 1072693508 else 1072693784
    register32(base + int(source << u32(2))).write(int(interrupt))
}

@inline
trusted fun esp32RomRouteInterruptMatrixValue(
    cpu: u32,
    source: u32,
    interrupt: u32
): u32 {
    esp32RomRouteInterruptMatrix(cpu, source, interrupt)
    u32(0)
}

// Original ABI symbol: ets_set_appcpu_boot_addr.
@section(".iram1.0.abla.esp32RomSetAppCpuBootAddress")
trusted fun esp32RomSetAppCpuBootAddress(address: u32): void =
    register32(1072693304).write(int(address))

trusted fun esp32RomSetAppCpuBootAddressValue(address: u32): u32 {
    esp32RomSetAppCpuBootAddress(address)
    u32(0)
}
