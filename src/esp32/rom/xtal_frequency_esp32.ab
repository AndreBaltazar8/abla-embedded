import "../../xtensa/assembly.ab"
import "./clock_logic_esp32.ab"

// Classic ESP32 ROM XTAL detection, expressed as normal integer data flow.
// The duplicated RTC_STORE4 halves cache a valid frequency in 4 KiHz units.
// Original ABI symbol: ets_get_detected_xtal_freq. Keep this in IRAM because
// deep-sleep wake code calls it while flash/cache availability is restricted.
@section(".iram1.0.abla.esp32RomGetDetectedXtalFrequency")
trusted fun esp32RomGetDetectedXtalFrequency(): u32 {
    val storedAddress = u32(0x3ff480b4)
    val stored = xtensaDeviceLoadU32(storedAddress)
    val cached = esp32RomStoredXtalFrequency(stored)
    if (cached != u32(0)) return cached

    val counter = xtensaDeviceLoadU32(u32(0x3ff5f06c))
    val efuseCalibration = xtensaDeviceLoadU32(u32(0x3ff5a010))
    val detected = esp32RomDetectedXtalFrequency(counter, efuseCalibration)
    val encoded = detected >>> u32(12)
    xtensaDeviceStoreU32(storedAddress, encoded | (encoded << u32(16)))
    return detected
}
