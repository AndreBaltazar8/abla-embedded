import "abla/unsafe/memory"

// Source-level replacement for the classic ESP ROM MD5 ABI. The context is
// exactly MD5Context: four state words, two bit-count words, then 64 bytes of
// buffered input. All message operations remain visible to LLVM.

@inline
trusted fun esp32RomMd5LoadU32(address: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32RomMd5StoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32RomMd5LoadU8(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32RomMd5StoreU8(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32RomMd5Copy(destination: u32, source: u32, length: u32): void {
    var index = u32(0)
    while (index < length) {
        esp32RomMd5StoreU8(destination + index,
            esp32RomMd5LoadU8(source + index))
        index = index + u32(1)
    }
}

trusted fun esp32RomMd5Zero(destination: u32, length: u32): void {
    var index = u32(0)
    while (index < length) {
        esp32RomMd5StoreU8(destination + index, u32(0))
        index = index + u32(1)
    }
}

val esp32RomMd5RoundConstants = nativeStaticU32s([
    int(u32(0xd76aa478)), int(u32(0xe8c7b756)), int(u32(0x242070db)), int(u32(0xc1bdceee)),
    int(u32(0xf57c0faf)), int(u32(0x4787c62a)), int(u32(0xa8304613)), int(u32(0xfd469501)),
    int(u32(0x698098d8)), int(u32(0x8b44f7af)), int(u32(0xffff5bb1)), int(u32(0x895cd7be)),
    int(u32(0x6b901122)), int(u32(0xfd987193)), int(u32(0xa679438e)), int(u32(0x49b40821)),
    int(u32(0xf61e2562)), int(u32(0xc040b340)), int(u32(0x265e5a51)), int(u32(0xe9b6c7aa)),
    int(u32(0xd62f105d)), int(u32(0x02441453)), int(u32(0xd8a1e681)), int(u32(0xe7d3fbc8)),
    int(u32(0x21e1cde6)), int(u32(0xc33707d6)), int(u32(0xf4d50d87)), int(u32(0x455a14ed)),
    int(u32(0xa9e3e905)), int(u32(0xfcefa3f8)), int(u32(0x676f02d9)), int(u32(0x8d2a4c8a)),
    int(u32(0xfffa3942)), int(u32(0x8771f681)), int(u32(0x6d9d6122)), int(u32(0xfde5380c)),
    int(u32(0xa4beea44)), int(u32(0x4bdecfa9)), int(u32(0xf6bb4b60)), int(u32(0xbebfbc70)),
    int(u32(0x289b7ec6)), int(u32(0xeaa127fa)), int(u32(0xd4ef3085)), int(u32(0x04881d05)),
    int(u32(0xd9d4d039)), int(u32(0xe6db99e5)), int(u32(0x1fa27cf8)), int(u32(0xc4ac5665)),
    int(u32(0xf4292244)), int(u32(0x432aff97)), int(u32(0xab9423a7)), int(u32(0xfc93a039)),
    int(u32(0x655b59c3)), int(u32(0x8f0ccc92)), int(u32(0xffeff47d)), int(u32(0x85845dd1)),
    int(u32(0x6fa87e4f)), int(u32(0xfe2ce6e0)), int(u32(0xa3014314)), int(u32(0x4e0811a1)),
    int(u32(0xf7537e82)), int(u32(0xbd3af235)), int(u32(0x2ad7d2bb)), int(u32(0xeb86d391))
])

val esp32RomMd5RoundShifts = nativeStaticU32s([
    7, 12, 17, 22,
    5, 9, 14, 20,
    4, 11, 16, 23,
    6, 10, 15, 21
])

@inline
trusted fun esp32RomMd5LoadTableU32(table: int, index: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(
        table + int(index * u32(4))
    )))

@inline
fun esp32RomMd5Rotate(value: u32, shift: u32): u32 =
    (value << shift) | (value >>> (u32(32) - shift))

trusted fun esp32RomMd5Transform(context: u32): void {
    var a = esp32RomMd5LoadU32(context)
    var b = esp32RomMd5LoadU32(context + u32(4))
    var c = esp32RomMd5LoadU32(context + u32(8))
    var d = esp32RomMd5LoadU32(context + u32(12))
    val originalA = a
    val originalB = b
    val originalC = c
    val originalD = d

    var round = u32(0)
    while (round < u32(64)) {
        var mixed = u32(0)
        var inputIndex = u32(0)
        val phase = round >>> u32(4)
        if (phase == u32(0)) {
            mixed = d ^ (b & (c ^ d))
            inputIndex = round
        } else if (phase == u32(1)) {
            mixed = c ^ (d & (b ^ c))
            inputIndex = (u32(5) * round + u32(1)) & u32(15)
        } else if (phase == u32(2)) {
            mixed = b ^ c ^ d
            inputIndex = (u32(3) * round + u32(5)) & u32(15)
        } else {
            mixed = c ^ (b | ~d)
            inputIndex = (u32(7) * round) & u32(15)
        }

        val constant = esp32RomMd5LoadTableU32(
            esp32RomMd5RoundConstants, round
        )
        val shiftIndex = phase * u32(4) + (round & u32(3))
        val shift = esp32RomMd5LoadTableU32(
            esp32RomMd5RoundShifts, shiftIndex
        )
        val input = esp32RomMd5LoadU32(
            context + u32(24) + inputIndex * u32(4)
        )
        val next = b + esp32RomMd5Rotate(a + mixed + constant + input, shift)
        a = d
        d = c
        c = b
        b = next
        round = round + u32(1)
    }

    esp32RomMd5StoreU32(context, originalA + a)
    esp32RomMd5StoreU32(context + u32(4), originalB + b)
    esp32RomMd5StoreU32(context + u32(8), originalC + c)
    esp32RomMd5StoreU32(context + u32(12), originalD + d)
}

trusted fun esp32RomMd5Init(context: u32): void {
    esp32RomMd5StoreU32(context, u32(0x67452301))
    esp32RomMd5StoreU32(context + u32(4), u32(0xefcdab89))
    esp32RomMd5StoreU32(context + u32(8), u32(0x98badcfe))
    esp32RomMd5StoreU32(context + u32(12), u32(0x10325476))
    esp32RomMd5StoreU32(context + u32(16), u32(0))
    esp32RomMd5StoreU32(context + u32(20), u32(0))
}

trusted fun esp32RomMd5Update(
    context: u32, input: u32, inputLength: u32
): void {
    val previousLow = esp32RomMd5LoadU32(context + u32(16))
    val nextLow = previousLow + (inputLength << u32(3))
    esp32RomMd5StoreU32(context + u32(16), nextLow)
    var high = esp32RomMd5LoadU32(context + u32(20)) +
        (inputLength >>> u32(29))
    if (nextLow < previousLow) high = high + u32(1)
    esp32RomMd5StoreU32(context + u32(20), high)

    var source = input
    var remaining = inputLength
    val buffered = (previousLow >>> u32(3)) & u32(63)
    if (buffered != u32(0)) {
        val needed = u32(64) - buffered
        if (remaining < needed) {
            esp32RomMd5Copy(context + u32(24) + buffered, source, remaining)
            return
        }
        esp32RomMd5Copy(context + u32(24) + buffered, source, needed)
        esp32RomMd5Transform(context)
        source = source + needed
        remaining = remaining - needed
    }
    while (remaining >= u32(64)) {
        esp32RomMd5Copy(context + u32(24), source, u32(64))
        esp32RomMd5Transform(context)
        source = source + u32(64)
        remaining = remaining - u32(64)
    }
    esp32RomMd5Copy(context + u32(24), source, remaining)
}

trusted fun esp32RomMd5Final(digest: u32, context: u32): void {
    val buffered = (esp32RomMd5LoadU32(context + u32(16)) >>> u32(3)) &
        u32(63)
    var padding = u32(63) - buffered
    val paddingStart = context + u32(24) + buffered
    esp32RomMd5StoreU8(paddingStart, u32(128))
    if (padding < u32(8)) {
        esp32RomMd5Zero(paddingStart + u32(1), padding)
        esp32RomMd5Transform(context)
        esp32RomMd5Zero(context + u32(24), u32(56))
    } else {
        padding = padding - u32(8)
        esp32RomMd5Zero(paddingStart + u32(1), padding)
    }
    esp32RomMd5StoreU32(context + u32(80),
        esp32RomMd5LoadU32(context + u32(16)))
    esp32RomMd5StoreU32(context + u32(84),
        esp32RomMd5LoadU32(context + u32(20)))
    esp32RomMd5Transform(context)
    esp32RomMd5Copy(digest, context, u32(16))
    esp32RomMd5Zero(context, u32(88))
}
