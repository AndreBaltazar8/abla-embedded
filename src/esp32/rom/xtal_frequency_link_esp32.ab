import "abla/build"

compile fun esp32Idf6LinkRomXtalFrequencyInternals(): bool {
    // Temporary ABI root for native deep-sleep code. This returns to internal
    // linkage once that remaining caller is part of the Abla LLVM graph.
    exportFunction(
        "esp32RomGetDetectedXtalFrequency",
        "ets_get_detected_xtal_freq"
    )
}
