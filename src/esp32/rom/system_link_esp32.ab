import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRomSystemInternals(): bool {
    if (!internalFunction("esp32RomOutputToChannels", "esp_rom_output_to_channels")) return false
    if (!internalFunction("esp32RomInstallChannelPutc", "esp_rom_install_channel_putc")) return false
    if (!internalFunction("esp32RomSetCpuTicksPerUs", "esp_rom_set_cpu_ticks_per_us")) return false
    if (!internalFunction("esp32RomUpdateCpuFrequency", "ets_update_cpu_frequency_rom")) return false
    if (!internalFunction("esp32EtsUpdateCpuFrequency", "ets_update_cpu_frequency")) return false
    if (!internalFunction("esp32RomGetCpuTicksPerUs", "esp_rom_get_cpu_ticks_per_us")) return false
    if (!internalFunction("esp32RomDelayUs", "esp_rom_delay_us")) return false
    if (!internalFunction("esp32EtsDelayUs", "ets_delay_us")) return false
    if (!internalFunction("esp32RomRouteInterruptMatrix", "esp_rom_route_intr_matrix")) return false
    if (!internalFunction("esp32RomSetAppCpuBootAddress", "ets_set_appcpu_boot_addr")) return false
    true
}
