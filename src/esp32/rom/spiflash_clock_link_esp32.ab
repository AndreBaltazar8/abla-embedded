import "abla/build"

compile fun esp32Idf6LinkRomSpiflashClockInternals(): bool {
    // The current monolithic image has no caller outside abla_app.o; retain
    // the ABI spelling for recovered in-module references without rooting it.
    internalFunction(
        "esp32RomSpiflashConfigureClock",
        "esp_rom_spiflash_config_clk"
    )
}
