import "../../xtensa/assembly.ab"
import "./clock_logic_esp32.ab"
import "abla/unsafe/memory"

val esp32RomSpi0CommandAddress = u32(0x3ff42000)
val esp32RomSpi1CommandAddress = u32(0x3ff43000)

@inline
trusted fun esp32RomSpiflashWaitCommandIdle(address: u32): void {
    var command = xtensaDeviceLoadU32(address)
    while ((command & u32(7)) != u32(0)) {
        command = xtensaDeviceLoadU32(address)
    }
}

// Exact SPI_user_command_read register transaction used by the classic ROM
// when a nonzero extra dummy length prevents its fast read-status command.
trusted fun esp32RomSpiflashUserCommandRead(command: u32): u32 {
    val user = u32(0x3ff4201c)
    val user1 = u32(0x3ff42020)
    val user2 = u32(0x3ff42024)
    val misoLength = u32(0x3ff4202c)
    val data0 = u32(0x3ff42080)
    val saved0 = xtensaDeviceLoadU32(u32(0x3ff42008))
    val saved1 = xtensaDeviceLoadU32(user)
    val saved2 = xtensaDeviceLoadU32(user1)
    val saved3 = xtensaDeviceLoadU32(user2)

    xtensaDeviceStoreU32(u32(0x3ff42008), u32(0))
    xtensaDeviceStoreU32(misoLength, u32(7))
    val dummyConfiguration = xtensaDeviceLoadU32(u32(0x3ffae290))
    val extraDummy = (dummyConfiguration >>> u32(8)) & u32(255)
    if (extraDummy == u32(0)) {
        xtensaDeviceStoreU32(user, u32(0x90000000))
    } else {
        xtensaDeviceStoreU32(user, u32(0xb0000000))
        xtensaDeviceStoreU32(user1, extraDummy - u32(1))
    }
    xtensaDeviceStoreU32(user2, (command & u32(255)) | u32(0x70000000))
    xtensaDeviceStoreU32(data0, u32(0))
    xtensaDeviceStoreU32(esp32RomSpi0CommandAddress, u32(0x00040000))
    var runningCommand = xtensaDeviceLoadU32(esp32RomSpi0CommandAddress)
    while (runningCommand != u32(0)) {
        runningCommand = xtensaDeviceLoadU32(esp32RomSpi0CommandAddress)
    }
    val result = xtensaDeviceLoadU32(data0) & u32(255)

    xtensaDeviceStoreU32(u32(0x3ff42008), saved0)
    xtensaDeviceStoreU32(user, saved1)
    xtensaDeviceStoreU32(user1, saved2)
    xtensaDeviceStoreU32(user2, saved3)
    return result
}

trusted fun esp32RomSpiflashReadUserCommand(
    output: u32,
    command: u32
): u32 {
    val value = esp32RomSpiflashUserCommandRead(command)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(output)), int(value))
    u32(0)
}

// Exact Wait_SPI_Idle behavior required before changing either flash/cache
// SPI clock. It waits both command engines and, in the ordinary mode, repeats
// the ROM read-status command until the chip's configured WIP bit clears.
trusted fun esp32RomSpiflashWaitIdle(): void {
    esp32RomSpiflashWaitCommandIdle(u32(0x3ff420f8))
    esp32RomSpiflashWaitCommandIdle(u32(0x3ff430f8))
    val dummyConfiguration = xtensaDeviceLoadU32(u32(0x3ffae290))
    val extraDummy = (dummyConfiguration >>> u32(8)) & u32(255)
    if (extraDummy != u32(0)) {
        esp32RomSpiflashUserCommandRead(u32(5))
        return
    }
    val statusMask = xtensaDeviceLoadU32(u32(0x3ffae284))
    var status = u32(1)
    while ((status & u32(1)) != u32(0)) {
        xtensaDeviceStoreU32(u32(0x3ff42010), u32(0))
        xtensaDeviceStoreU32(esp32RomSpi0CommandAddress, u32(0x08000000))
        var runningCommand = xtensaDeviceLoadU32(esp32RomSpi0CommandAddress)
        while (runningCommand != u32(0)) {
            runningCommand = xtensaDeviceLoadU32(esp32RomSpi0CommandAddress)
        }
        status = xtensaDeviceLoadU32(u32(0x3ff42010)) & statusMask
    }
}

trusted fun esp32RomSpiflashWaitIdleValue(): u32 {
    esp32RomSpiflashWaitIdle()
    u32(0)
}

// Original ABI symbol: esp_rom_spiflash_config_clk / SPIClkConfig.
@section(".iram1.0.abla.esp32RomSpiflashConfigureClock")
trusted fun esp32RomSpiflashConfigureClock(
    frequencyDivider: u32,
    spi: u32
): i32 {
    esp32RomSpiflashWaitIdle()
    val base = esp32RomSpiflashClockRegisterAddress(spi)
    val clock = esp32RomSpiflashClockRegisterValue(frequencyDivider)
    xtensaDeviceStoreU32(base + u32(24), clock)
    return i32(0)
}
