import "../../register.ab"
import "abla/unsafe/memory"

// Small classic-ESP32 ROM services whose behavior is completely described by
// scalar arithmetic and memory/register access.

// Original ABI symbol: esp_rom_software_reset_system.
@section(".iram1.abla.esp32RomSoftwareResetSystem")
trusted fun esp32RomSoftwareResetSystem(): void {
    register32(1072988160).setBits(2147483648)
    return
}

trusted fun esp32RomSoftwareResetSystemValue(): u32 {
    esp32RomSoftwareResetSystem()
    u32(0)
}

// Original ABI symbol: esp_rom_software_reset_cpu.
@section(".iram1.0.abla.esp32RomSoftwareResetCpu")
trusted fun esp32RomSoftwareResetCpu(cpu: u32): void {
    register32(1072988160).setBits(
        if (cpu == u32(0)) 32 else 16
    )
    return
}

trusted fun esp32RomSoftwareResetCpuValue(cpu: u32): u32 {
    esp32RomSoftwareResetCpu(cpu)
    u32(0)
}

// Original ABI symbol: esp_rom_get_reset_reason.
@section(".iram1.0.abla.esp32RomGetResetReason")
trusted fun esp32RomGetResetReason(cpu: u32): u32 = u32(
    (register32(1072988212).read() >>> int(cpu * u32(6))) & 63
)

// Original ABI symbol: esp_rom_output_set_as_console.
@section(".iram1.0.abla.esp32RomOutputSetAsConsole")
trusted fun esp32RomOutputSetAsConsole(uart: u32): void =
    ablaUnsafeStoreU8(
        nativePointerFromAddress(1073611189), int(uart & u32(255))
    )

trusted fun esp32RomOutputSetAsConsoleValue(uart: u32): u32 {
    esp32RomOutputSetAsConsole(uart)
    u32(0)
}

// Original ABI symbol: esp_rom_install_uart_printf.
@section(".iram1.0.abla.esp32RomInstallUartPrintf")
trusted fun esp32RomInstallUartPrintf(): void =
    esp32RomInstallDefaultOutput()

trusted fun esp32RomInstallUartPrintfValue(): u32 {
    esp32RomInstallUartPrintf()
    u32(0)
}

@inline
trusted fun esp32RomByte(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
)

// Original ABI symbol: esp_rom_crc32_le. This table-free form is intentionally
// compact; LLVM can unroll it only when a call site proves a constant length.
trusted fun esp32RomCrc32Le(
    initial: u32,
    data: u32,
    length: u32
): u32 {
    var crc = initial ^ u32(4294967295)
    var index = u32(0)
    while (index < length) {
        crc = crc ^ esp32RomByte(data + index)
        var bit = u32(0)
        while (bit < u32(8)) {
            val low = crc & u32(1)
            crc = crc >>> u32(1)
            if (low != u32(0)) crc = crc ^ u32(3988292384)
            bit = bit + u32(1)
        }
        index = index + u32(1)
    }
    crc ^ u32(4294967295)
}

// Original ABI symbol: esp_rom_efuse_mac_address_crc8 (ROM esp_crc8).
trusted fun esp32RomEfuseMacAddressCrc8(data: u32, length: u32): u32 {
    var crc = u32(0)
    var index = u32(0)
    while (index < length) {
        crc = crc ^ esp32RomByte(data + index)
        var bit = u32(0)
        while (bit < u32(8)) {
            val low = crc & u32(1)
            crc = crc >>> u32(1)
            if (low != u32(0)) crc = crc ^ u32(140)
            bit = bit + u32(1)
        }
        index = index + u32(1)
    }
    crc & u32(255)
}

@inline
fun esp32EfuseFlashPin(raw: u32): u32 =
    if (raw > u32(29)) raw + u32(2) else raw

// Original ABI symbol: esp_rom_efuse_get_flash_gpio_info.
trusted fun esp32RomEfuseGetFlashGpioInfo(): u32 {
    val raw = u32(register32(1073061908).read()) & u32(1048575)
    if (raw == u32(0) || raw == u32(1048575)) return u32(0)
    val clock = esp32EfuseFlashPin(raw & u32(31))
    val data0 = esp32EfuseFlashPin((raw >>> u32(5)) & u32(31))
    val data1 = esp32EfuseFlashPin((raw >>> u32(10)) & u32(31))
    val data2 = esp32EfuseFlashPin((raw >>> u32(15)) & u32(255))
    val data3 = esp32EfuseFlashPin(
        (u32(register32(1073061900).read()) >>> u32(4)) & u32(31)
    )
    if (clock == data0 || clock == data1 || clock == data2 ||
        data0 == data1 || data0 == data2) return u32(0)
    clock | (data0 << u32(6)) | (data1 << u32(12)) |
        (data2 << u32(18)) | (data3 << u32(24))
}
