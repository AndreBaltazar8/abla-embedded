import "abla/build"

compile fun esp32Idf6LinkRomMd5Internals(): bool {
    // These are temporary external roots because IDF objects outside the
    // monolithic Abla module still call the ROM ABI. Once those callers are
    // typed Abla too, ordinary internal linkage can prune unused MD5 paths.
    if (!exportFunction("esp32RomMd5Init", "esp_rom_md5_init")) return false
    if (!exportFunction("esp32RomMd5Update", "esp_rom_md5_update")) return false
    if (!exportFunction("esp32RomMd5Final", "esp_rom_md5_final")) return false
    true
}
