import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRomSerialOutputInternals(): bool {
    if (!internalFunction("esp32RomOutputTxWaitIdle", "esp_rom_output_tx_wait_idle")) return false
    if (!internalFunction("esp32RomOutputPutc", "esp_rom_output_putc")) return false
    true
}
