import "abla/build"

compile fun esp32Idf6LinkRomRegisterI2cInternals(): bool {
    if (!internalFunction("esp32RomRegisterI2cRead", "esp_rom_regi2c_read")) return false
    if (!internalFunction("esp32RomRegisterI2cReadMask", "esp_rom_regi2c_read_mask")) return false
    if (!internalFunction("esp32RomRegisterI2cWrite", "esp_rom_regi2c_write")) return false
    if (!internalFunction("esp32RomRegisterI2cWriteMask", "esp_rom_regi2c_write_mask")) return false
    true
}
