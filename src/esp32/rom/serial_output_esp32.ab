import "../../xtensa/assembly.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"

// Classic ESP32 UART ROM services expressed as typed Abla. Register reads and
// writes remain volatile LLVM operations; LLVM can optimize all surrounding
// selection, masking, newline handling, and polling control flow.

@inline
fun esp32RomUartBase(serial: u32): u32 =
    if (serial == u32(0)) u32(1072955392) else
        if (serial == u32(1)) u32(1073020928) else
        u32(1073143808)

// Original ABI symbol: esp_rom_output_tx_wait_idle.
@section(".iram1.2.abla.esp32RomOutputTxWaitIdle")
trusted fun esp32RomOutputTxWaitIdle(serial: u32): void {
    val statusAddress = esp32RomUartBase(serial & u32(255)) + u32(28)
    var status = xtensaDeviceLoadU32(statusAddress)
    // A malformed/stale UART state field must never deadlock clock switching,
    // restart, or fsync. The FIFO count is authoritative for queued bytes; the
    // bounded state wait still gives the final shifter ample time to drain.
    var remaining = u32(65536)
    while (
        (((status >>> u32(16)) & u32(255)) != u32(0) ||
            ((status >>> u32(24)) & u32(15)) != u32(0)) &&
        remaining != u32(0)
    ) {
        status = xtensaDeviceLoadU32(statusAddress)
        remaining = remaining - u32(1)
    }
    return
}

trusted fun esp32RomOutputTxWaitIdleValue(serial: u32): u32 {
    esp32RomOutputTxWaitIdle(serial)
    u32(0)
}

// ROM uart_tx_one_char uses UartDev.uart_no as a 64 KiB UART selector and
// waits for space in the transmit FIFO before writing the byte.
@inline
trusted fun esp32RomOutputTxOneChar(character: u32): void {
    val serial = u32(ablaUnsafeVolatileLoadU8(1073611189)) & u32(255)
    val base = u32(1072955392) + (serial << u32(16))
    var status = xtensaDeviceLoadU32(base + u32(28))
    var remaining = u32(65536)
    while ((status & u32(8388608)) != u32(0) && remaining != u32(0)) {
        status = xtensaDeviceLoadU32(base + u32(28))
        remaining = remaining - u32(1)
    }
    ablaUnsafeVolatileStoreU32(int(base), int(character & u32(255)))
    return
}

trusted fun esp32RomOutputTxOneCharValue(character: u32): u32 {
    esp32RomOutputTxOneChar(character)
    u32(0)
}

// Original ABI symbols: uart_rx_one_char and esp_rom_output_rx_one_char.
// UartDev.buff_uart_no is the ROM-selected receive console.  The classic
// ESP32 UART blocks are 64 KiB apart for the UARTs supported by this ROM API.
@inline
trusted fun esp32RomOutputRxOneChar(destination: u32): u32 {
    val serial = u32(ablaUnsafeVolatileLoadU8(1073611188)) & u32(255)
    val base = u32(1072955392) + (serial << u32(16))
    val receiveCount = xtensaDeviceLoadU32(base + u32(28)) & u32(255)
    if (receiveCount == u32(0)) return u32(1)

    val byte = xtensaDeviceLoadU32(base) & u32(255)
    ablaUnsafeVolatileStoreU8(int(destination), int(byte))
    u32(0)
}

// Original ABI symbol: esp_rom_output_putc (ROM ets_write_char_uart).
@section(".iram1.abla.esp32RomOutputPutc")
trusted fun esp32RomOutputPutc(character: u32): void {
    val byte = character & u32(255)
    if (byte == u32(10)) {
        esp32RomOutputTxOneChar(u32(13))
        esp32RomOutputTxOneChar(byte)
    } else if (byte != u32(13)) {
        esp32RomOutputTxOneChar(byte)
    }
    return
}

// Small freestanding alternative to routing fixed startup text through the
// recovered printf/vfprintf stack. This is also useful while the scheduler,
// heap, and logging locks are not initialized yet.
trusted fun esp32RomOutputCString(address: u32): void {
    var cursor = address
    var byte = u32(ablaUnsafeVolatileLoadU8(int(cursor)))
    while (byte != u32(0)) {
        esp32RomOutputPutc(byte)
        cursor = cursor + u32(1)
        byte = u32(ablaUnsafeVolatileLoadU8(int(cursor)))
    }
    return
}

trusted fun esp32RomOutputHexU32(value: u32): void {
    var shift = u32(28)
    while (true) {
        val digit = (value >>> shift) & u32(15)
        esp32RomOutputPutc(
            if (digit < u32(10)) u32(48) + digit else u32(87) + digit
        )
        if (shift == u32(0)) return
        shift = shift - u32(4)
    }
}
