import "../../xtensa/assembly.ab"

// Classic ESP32 RTC fast-memory CRC engine.  This is the complete ROM
// operation expressed as volatile MMIO so LLVM sees the surrounding control
// flow without embedding or calling the mask-ROM implementation.

val esp32RtcMemoryCrcControl = u32(1072988416)
val esp32RtcMemoryCrcResult = u32(1072988420)
val esp32RtcMemoryCrcStore = u32(1072988348)

@inline
trusted fun esp32RtcFastMemoryCrc(): u32 {
    var control = xtensaDeviceLoadU32(esp32RtcMemoryCrcControl)
    control = control & u32(4293919231)
    xtensaDeviceStoreU32(esp32RtcMemoryCrcControl, control)

    control = xtensaDeviceLoadU32(esp32RtcMemoryCrcControl)
    control = (control & u32(2148532223)) | u32(2146435072)
    xtensaDeviceStoreU32(esp32RtcMemoryCrcControl, control)

    control = xtensaDeviceLoadU32(esp32RtcMemoryCrcControl) | u32(256)
    xtensaDeviceStoreU32(esp32RtcMemoryCrcControl, control)
    while ((xtensaDeviceLoadU32(esp32RtcMemoryCrcControl) & u32(2147483648)) == u32(0)) {}

    control = xtensaDeviceLoadU32(esp32RtcMemoryCrcControl) & u32(4294967039)
    xtensaDeviceStoreU32(esp32RtcMemoryCrcControl, control)
    xtensaDeviceLoadU32(esp32RtcMemoryCrcResult)
}

// Original ABI symbol: set_rtc_memory_crc.
trusted fun esp32SetRtcFastMemoryCrc(): void {
    xtensaDeviceStoreU32(esp32RtcMemoryCrcStore, esp32RtcFastMemoryCrc())
}

trusted fun esp32SetRtcFastMemoryCrcValue(): u32 {
    esp32SetRtcFastMemoryCrc()
    u32(0)
}
