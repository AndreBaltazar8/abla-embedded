import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRomSpiflashInternals(): bool {
    if (!internalFunction("esp32RomSpiflashReadStatus", "esp_rom_spiflash_read_status")) return false
    if (!internalFunction("esp32RomSpiflashWaitIdleForChip", "esp_rom_spiflash_wait_idle")) return false
    if (!internalFunction("esp32RomSpiflashReadStatusHigh", "esp_rom_spiflash_read_statushigh")) return false
    if (!internalFunction("esp32RomSpiflashWriteStatus", "esp_rom_spiflash_write_status")) return false
    if (!internalFunction("esp32RomSpiflashClearBp", "esp_rom_spiflash_clear_bp")) return false
    if (!internalFunction("esp32RomSpiflashLock", "esp_rom_spiflash_lock")) return false
    if (!internalFunction("esp32RomSpiflashConfigReadMode", "esp_rom_spiflash_config_readmode")) return false
    if (!internalFunction("esp32RomSpiflashEraseChip", "esp_rom_spiflash_erase_chip")) return false
    if (!internalFunction("esp32RomSpiflashEraseBlock", "esp_rom_spiflash_erase_block")) return false
    if (!internalFunction("esp32RomSpiflashEraseSector", "esp_rom_spiflash_erase_sector")) return false
    if (!internalFunction("esp32RomSpiflashWrite", "esp_rom_spiflash_write")) return false
    if (!internalFunction("esp32RomSpiflashWriteEncrypted", "esp_rom_spiflash_write_encrypted")) return false
    if (!internalFunction("esp32RomSpiflashRead", "esp_rom_spiflash_read")) return false
    if (!internalFunction("esp32RomSpiflashEraseArea", "esp_rom_spiflash_erase_area")) return false
    if (!internalFunction("esp32RomSpiflashWriteDisable", "esp_rom_spiflash_write_disable")) return false
    if (!internalFunction("esp32RomSpiflashUnlock", "esp_rom_spiflash_unlock")) return false
    if (!internalFunction("esp32RomSpiflashSetBp", "esp_rom_spiflash_set_bp")) return false
    true
}
