import "abla/build"

// Exact names still used by opaque startup/cache callers. They remain internal
// aliases in the single LLVM module and disappear when those callers do.
compile fun esp32Idf6LinkRomCacheControlInternals(): bool {
    if (!internalFunction("esp32RomCacheFlush", "Cache_Flush_rom")) return false
    if (!internalFunction("esp32RomCacheReadEnable", "Cache_Read_Enable_rom")) return false
    if (!internalFunction("esp32RomCacheReadDisable", "Cache_Read_Disable_rom")) return false
    if (!internalFunction("esp32RomMmuInit", "mmu_init")) return false
    true
}
