import "../../register.ab"

// Classic ESP32 GPIO-matrix operations. These used to preserve recovered ROM
// instruction streams. They are register writes, so express their semantics in
// ordinary typed Abla and leave address/value optimization visible to LLVM.
val esp32GpioMatrixInputBase = 1072972080
val esp32GpioMatrixOutputBase = 1072973104
val esp32GpioOutputEnableLowSet = 1072971812
val esp32GpioOutputEnableHighSet = 1072971824

@inline
fun esp32BooleanBit(value: u32, shift: u32): u32 =
    if (value == u32(0)) u32(0) else u32(1) << shift

// Original ABI symbol: esp_rom_gpio_connect_in_signal
@section(".iram1.0.abla.esp32RomGpioConnectInSignal")
trusted fun esp32RomGpioConnectInSignal(
    gpio: u32,
    signal: u32,
    inverted: u32
): void {
    // GPIO 0x34 is the matrix's constant-one input. Every real GPIO input also
    // sets SIG_IN_SEL so the matrix, rather than the direct IOMUX path, is used.
    var value = gpio
    value = value | esp32BooleanBit(inverted, u32(6))
    if (gpio != u32(52)) value = value | u32(128)
    register32(
        esp32GpioMatrixInputBase + int(signal << u32(2))
    ).write(int(value))
}

// Original ABI symbol: esp_rom_gpio_connect_out_signal
@section(".iram1.0.abla.esp32RomGpioConnectOutSignal")
trusted fun esp32RomGpioConnectOutSignal(
    gpio: u32,
    signal: u32,
    outputInverted: u32,
    outputEnableInverted: u32
): void {
    val value = signal |
        esp32BooleanBit(outputInverted, u32(9)) |
        esp32BooleanBit(outputEnableInverted, u32(11))
    register32(
        esp32GpioMatrixOutputBase + int(gpio << u32(2))
    ).write(int(value))
    val setAddress = if (gpio < u32(32))
        esp32GpioOutputEnableLowSet else esp32GpioOutputEnableHighSet
    register32(setAddress).write(int(u32(1) << (gpio & u32(31))))
}

trusted fun esp32RomGpioConnectInSignalValue(
    gpio: u32,
    signal: u32,
    inverted: u32
): u32 {
    esp32RomGpioConnectInSignal(gpio, signal, inverted)
    u32(0)
}

trusted fun esp32RomGpioConnectOutSignalValue(
    gpio: u32,
    signal: u32,
    outputInverted: u32,
    outputEnableInverted: u32
): u32 {
    esp32RomGpioConnectOutSignal(
        gpio, signal, outputInverted, outputEnableInverted
    )
    u32(0)
}
