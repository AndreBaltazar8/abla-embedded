import "abla/build"

compile fun esp32Idf6LinkRomBasicSystemInternals(): bool {
    if (!internalFunction("esp32RomSoftwareResetSystem", "esp_rom_software_reset_system")) return false
    if (!internalFunction("esp32RomSoftwareResetCpu", "esp_rom_software_reset_cpu")) return false
    if (!internalFunction("esp32RomGetResetReason", "esp_rom_get_reset_reason")) return false
    if (!internalFunction("esp32RomOutputSetAsConsole", "esp_rom_output_set_as_console")) return false
    if (!internalFunction("esp32RomInstallUartPrintf", "esp_rom_install_uart_printf")) return false
    if (!internalFunction("esp32RomCrc32Le", "esp_rom_crc32_le")) return false
    if (!internalFunction("esp32RomEfuseMacAddressCrc8", "esp_rom_efuse_mac_address_crc8")) return false
    if (!internalFunction("esp32RomEfuseGetFlashGpioInfo", "esp_rom_efuse_get_flash_gpio_info")) return false
    true
}
