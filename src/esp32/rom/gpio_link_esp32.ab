import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRomGpioInternals(): bool {
    if (!internalFunction("esp32RomGpioConnectInSignal", "esp_rom_gpio_connect_in_signal")) return false
    if (!internalFunction("esp32RomGpioConnectOutSignal", "esp_rom_gpio_connect_out_signal")) return false
    true
}
