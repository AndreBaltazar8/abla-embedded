import "../../xtensa/assembly.ab"
import "abla/unsafe/memory"

// Typed ESP32 SPI-flash status and protection path. The controller transaction
// and all policy are ordinary Abla/LLVM IR. Only addresses supplied by the
// linker use the target subparser.

@inline
trusted fun esp32RomSpiflashChipAddress(): u32 =
    u32(1073406576)

@inline
trusted fun esp32RomSpiflashDummyAddress(): u32 =
    u32(1073406608)

@inline
trusted fun esp32RomSpiflashLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32RomSpiflashStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

// Original ABI symbol: esp_rom_spiflash_config_param. The ROM routine only
// replaces the six words of the global esp_rom_spiflash_chip_t descriptor.
trusted fun esp32RomSpiflashConfigParam(
    deviceId: u32,
    chipSize: u32,
    blockSize: u32,
    sectorSize: u32,
    pageSize: u32,
    statusMask: u32
): u32 {
    val chip = esp32RomSpiflashChipAddress()
    esp32RomSpiflashStoreU32(chip, deviceId)
    esp32RomSpiflashStoreU32(chip + u32(4), chipSize)
    esp32RomSpiflashStoreU32(chip + u32(8), blockSize)
    esp32RomSpiflashStoreU32(chip + u32(12), sectorSize)
    esp32RomSpiflashStoreU32(chip + u32(16), pageSize)
    esp32RomSpiflashStoreU32(chip + u32(20), statusMask)
    u32(0)
}

@inline
trusted fun esp32RomSpiflashLoadU8(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32RomSpiflashCommand(command: u32): void {
    xtensaDeviceStoreU32(u32(0x3ff42000), command)
    var active = xtensaDeviceLoadU32(u32(0x3ff42000))
    while (active != u32(0)) {
        active = xtensaDeviceLoadU32(u32(0x3ff42000))
    }
}

@inline
trusted fun esp32RomSpiflashStatusMask(chip: u32): u32 =
    esp32RomSpiflashLoadU32(chip + u32(20))

@inline
trusted fun esp32RomSpiflashIsIssi(chip: u32): bool =
    ((esp32RomSpiflashLoadU32(chip) >>> u32(16)) & u32(255)) == u32(0x9d)

// Implements esp_rom_spiflash_read_status without materializing a temporary
// C-style output pointer, so callers can keep the value in SSA form.
@section(".iram1.abla.esp32RomSpiflashReadStatusValue")
trusted fun esp32RomSpiflashReadStatusValue(chip: u32): u32 {
    var status = u32(1)
    val extraDummy = esp32RomSpiflashLoadU8(
        esp32RomSpiflashDummyAddress() + u32(1)
    )
    if (extraDummy == u32(0)) {
        while ((status & u32(1)) != u32(0)) {
            xtensaDeviceStoreU32(u32(0x3ff42010), u32(0))
            esp32RomSpiflashCommand(u32(0x08000000))
            status = xtensaDeviceLoadU32(u32(0x3ff42010)) &
                esp32RomSpiflashStatusMask(chip)
        }
    } else {
        while ((status & u32(1)) != u32(0)) {
            status = esp32RomSpiflashUserCommandRead(u32(5))
        }
    }
    status
}

@section(".iram1.abla.esp32RomSpiflashReadStatus")
trusted fun esp32RomSpiflashReadStatus(
    chip: u32,
    output: u32
): i32 {
    esp32RomSpiflashStoreU32(output, esp32RomSpiflashReadStatusValue(chip))
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashWaitIdleForChip")
trusted fun esp32RomSpiflashWaitIdleForChip(chip: u32): i32 {
    esp32RomSpiflashWaitCommandIdle(u32(0x3ff420f8))
    esp32RomSpiflashWaitCommandIdle(u32(0x3ff430f8))
    esp32RomSpiflashReadStatusValue(chip)
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashReadStatusHighValue")
trusted fun esp32RomSpiflashReadStatusHighValue(chip: u32): u32 {
    esp32RomSpiflashWaitIdleForChip(chip)
    esp32RomSpiflashUserCommandRead(u32(0x35)) << u32(8)
}

@section(".iram1.abla.esp32RomSpiflashReadStatusHigh")
trusted fun esp32RomSpiflashReadStatusHigh(
    chip: u32,
    output: u32
): i32 {
    esp32RomSpiflashStoreU32(
        output,
        esp32RomSpiflashReadStatusHighValue(chip)
    )
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashWriteStatus")
trusted fun esp32RomSpiflashWriteStatus(chip: u32, status: u32): i32 {
    esp32RomSpiflashWaitIdleForChip(chip)
    xtensaDeviceStoreU32(u32(0x3ff42010), status)
    esp32RomSpiflashCommand(u32(0x04000000))
    esp32RomSpiflashWaitIdleForChip(chip)
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashEnableWrite")
trusted fun esp32RomSpiflashEnableWrite(chip: u32): i32 {
    esp32RomSpiflashWaitIdleForChip(chip)
    esp32RomSpiflashCommand(u32(0x40000000))
    var status = u32(0)
    while ((status & u32(2)) == u32(0)) {
        status = esp32RomSpiflashReadStatusValue(chip)
    }
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashClearBp")
trusted fun esp32RomSpiflashClearBp(): i32 {
    val chip = esp32RomSpiflashChipAddress()
    esp32RomSpiflashWaitIdleForChip(chip)

    var status = u32(0)
    var replacement = u32(0)
    if (esp32RomSpiflashIsIssi(chip)) {
        status = esp32RomSpiflashReadStatusValue(chip)
        replacement = status & u32(0xffffff43)
        if (replacement == status) return i32(0)
        val control = xtensaDeviceLoadU32(u32(0x3ff42008))
        xtensaDeviceStoreU32(u32(0x3ff42008), control & u32(0xffbfffff))
    } else {
        status = esp32RomSpiflashReadStatusHighValue(chip)
        replacement = status & u32(0x200)
        val control = xtensaDeviceLoadU32(u32(0x3ff42008))
        xtensaDeviceStoreU32(u32(0x3ff42008), control | u32(0x00400000))
    }

    esp32RomSpiflashWaitIdleForChip(chip)
    esp32RomSpiflashCommand(u32(0x40000000))
    esp32RomSpiflashWaitIdleForChip(chip)
    val result = esp32RomSpiflashWriteStatus(chip, replacement)
    esp32RomSpiflashWaitIdleForChip(chip)
    esp32RomSpiflashCommand(u32(0x20000000))
    result
}

@section(".iram1.abla.esp32RomSpiflashUnlock")
trusted fun esp32RomSpiflashUnlock(): i32 =
    esp32RomSpiflashClearBp()

@section(".iram1.abla.esp32RomSpiflashLock")
trusted fun esp32RomSpiflashLock(): i32 {
    val chip = esp32RomSpiflashChipAddress()
    val status = esp32RomSpiflashReadStatusHighValue(chip)
    val control = xtensaDeviceLoadU32(u32(0x3ff42008))
    xtensaDeviceStoreU32(u32(0x3ff42008), control | u32(0x00400000))
    if (esp32RomSpiflashEnableWrite(chip) != i32(0)) return i32(1)
    if (esp32RomSpiflashWriteStatus(chip, status | u32(28)) != i32(0)) {
        return i32(1)
    }
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashSetBp")
trusted fun esp32RomSpiflashSetBp(): i32 =
    esp32RomSpiflashLock()

@section(".iram1.abla.esp32RomSpiflashWriteDisable")
trusted fun esp32RomSpiflashWriteDisable(): i32 {
    esp32RomSpiflashCommand(u32(0x20000000))
    i32(0)
}

@inline
trusted fun esp32RomSpiflashConfigureWriteRegisters(): void {
    val user = xtensaDeviceLoadU32(u32(0x3ff4201c))
    xtensaDeviceStoreU32(u32(0x3ff4201c), user & u32(0xdfffffff))
    val user1 = xtensaDeviceLoadU32(u32(0x3ff42020))
    xtensaDeviceStoreU32(
        u32(0x3ff42020),
        (user1 & u32(0x03ffffff)) | u32(0x5c000000)
    )
}

@section(".iram1.abla.esp32RomSpiflashEraseChipInternal")
trusted fun esp32RomSpiflashEraseChipInternal(chip: u32): i32 {
    esp32RomSpiflashWaitIdleForChip(chip)
    esp32RomSpiflashCommand(u32(0x00400000))
    esp32RomSpiflashWaitIdleForChip(chip)
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashEraseBlockInternal")
trusted fun esp32RomSpiflashEraseBlockInternal(
    chip: u32,
    flashOffset: u32
): i32 {
    esp32RomSpiflashWaitIdleForChip(chip)
    xtensaDeviceStoreU32(u32(0x3ff42004), flashOffset & u32(0x00ffffff))
    esp32RomSpiflashCommand(u32(0x00800000))
    esp32RomSpiflashWaitIdleForChip(chip)
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashEraseSectorInternal")
trusted fun esp32RomSpiflashEraseSectorInternal(
    chip: u32,
    flashOffset: u32
): i32 {
    if ((flashOffset & u32(0x0fff)) != u32(0)) return i32(1)
    esp32RomSpiflashWaitIdleForChip(chip)
    xtensaDeviceStoreU32(u32(0x3ff42004), flashOffset & u32(0x00ffffff))
    esp32RomSpiflashCommand(u32(0x01000000))
    esp32RomSpiflashWaitIdleForChip(chip)
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashEraseChip")
trusted fun esp32RomSpiflashEraseChip(): i32 {
    val chip = esp32RomSpiflashChipAddress()
    if (esp32RomSpiflashEnableWrite(chip) != i32(0)) return i32(1)
    if (esp32RomSpiflashEraseChipInternal(chip) != i32(0)) return i32(1)
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashEraseBlock")
trusted fun esp32RomSpiflashEraseBlock(block: u32): i32 {
    esp32RomSpiflashConfigureWriteRegisters()
    val chip = esp32RomSpiflashChipAddress()
    val chipSize = esp32RomSpiflashLoadU32(chip + u32(4))
    val blockSize = esp32RomSpiflashLoadU32(chip + u32(8))
    if (block >= chipSize / blockSize) return i32(1)
    if (esp32RomSpiflashEnableWrite(chip) != i32(0)) return i32(1)
    if (esp32RomSpiflashEraseBlockInternal(chip, block * blockSize) != i32(0)) {
        return i32(1)
    }
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashEraseSector")
trusted fun esp32RomSpiflashEraseSector(sector: u32): i32 {
    esp32RomSpiflashConfigureWriteRegisters()
    val chip = esp32RomSpiflashChipAddress()
    val chipSize = esp32RomSpiflashLoadU32(chip + u32(4))
    val sectorSize = esp32RomSpiflashLoadU32(chip + u32(12))
    if (sector >= chipSize / sectorSize) return i32(1)
    if (esp32RomSpiflashEnableWrite(chip) != i32(0)) return i32(1)
    if (esp32RomSpiflashEraseSectorInternal(
        chip,
        sector * sectorSize
    ) != i32(0)) return i32(1)
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashProgramPage")
trusted fun esp32RomSpiflashProgramPage(
    chip: u32,
    destination: u32,
    source: u32,
    length: u32
): i32 {
    if ((length & u32(3)) != u32(0)) return i32(1)
    val pageSize = esp32RomSpiflashLoadU32(chip + u32(16))
    val pageOffset = destination - (destination / pageSize) * pageSize
    if (pageSize < pageOffset + length) return i32(1)
    esp32RomSpiflashWaitIdleForChip(chip)

    var flashOffset = destination
    var inputOffset = source
    var bytesRemaining = length
    while (bytesRemaining != u32(0)) {
        if (esp32RomSpiflashEnableWrite(chip) != i32(0)) return i32(1)
        val byteCount = if (bytesRemaining >= u32(32)) u32(32) else bytesRemaining
        xtensaDeviceStoreU32(
            u32(0x3ff42004),
            (flashOffset & u32(0x00ffffff)) | (byteCount << u32(24))
        )
        val wordCount = (byteCount + u32(3)) >>> u32(2)
        var word = u32(0)
        while (word < wordCount) {
            xtensaDeviceStoreU32(
                u32(0x3ff42080) + word * u32(4),
                esp32RomSpiflashLoadU32(inputOffset + word * u32(4))
            )
            word = word + u32(1)
        }
        esp32RomSpiflashCommand(u32(0x02000000))
        esp32RomSpiflashWaitIdleForChip(chip)
        flashOffset = flashOffset + byteCount
        inputOffset = inputOffset + byteCount
        bytesRemaining = bytesRemaining - byteCount
    }
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashWrite")
trusted fun esp32RomSpiflashWrite(
    destination: u32,
    source: u32,
    signedLength: i32
): i32 {
    esp32RomSpiflashConfigureWriteRegisters()
    val length = u32(signedLength)
    val chip = esp32RomSpiflashChipAddress()
    val chipSize = esp32RomSpiflashLoadU32(chip + u32(4))
    if (destination + length > chipSize) return i32(1)

    val pageSize = esp32RomSpiflashLoadU32(chip + u32(16))
    var written = u32(0)
    val pageOffset = destination - (destination / pageSize) * pageSize
    val first = pageSize - pageOffset
    val firstAmount = if (length < first) length else first
    if (esp32RomSpiflashProgramPage(
        chip,
        destination,
        source,
        firstAmount
    ) != i32(0)) return i32(1)
    written = firstAmount

    while (length - written >= pageSize) {
        if (esp32RomSpiflashProgramPage(
            chip,
            destination + written,
            source + written,
            pageSize
        ) != i32(0)) return i32(1)
        written = written + pageSize
    }
    if (esp32RomSpiflashProgramPage(
        chip,
        destination + written,
        source + written,
        length - written
    ) != i32(0)) return i32(1)
    i32(0)
}

@inline
trusted fun esp32RomSpiflashReplaceLowByte(value: u32, byte: u32): u32 =
    (value & u32(0xffffff00)) | (byte & u32(255))

@section(".iram1.abla.esp32RomSpiflashReadData")
trusted fun esp32RomSpiflashReadData(
    chip: u32,
    source: u32,
    destination: u32,
    signedLength: i32
): i32 {
    val length = u32(signedLength)
    if (source + length > esp32RomSpiflashLoadU32(chip + u32(4))) {
        return i32(1)
    }
    esp32RomSpiflashWaitIdleForChip(chip)
    var flashAddress = source
    var output = destination
    var remaining = length
    while (remaining != u32(0)) {
        val amount = if (remaining >= u32(64)) u32(64) else remaining
        xtensaDeviceStoreU32(u32(0x3ff4202c), u32(0x1ff))
        xtensaDeviceStoreU32(u32(0x3ff42004), flashAddress << u32(8))
        esp32RomSpiflashCommand(u32(0x00040000))
        val words = (amount + u32(3)) >>> u32(2)
        var word = u32(0)
        while (word < words) {
            esp32RomSpiflashStoreU32(
                output + word * u32(4),
                xtensaDeviceLoadU32(u32(0x3ff42080) + word * u32(4))
            )
            word = word + u32(1)
        }
        flashAddress = flashAddress + amount
        output = output + amount
        remaining = remaining - amount
    }
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashRead")
trusted fun esp32RomSpiflashRead(
    source: u32,
    destination: u32,
    length: i32
): i32 {
    val control = xtensaDeviceLoadU32(u32(0x3ff42008))
    val dummy = esp32RomSpiflashLoadU8(
        esp32RomSpiflashDummyAddress() + u32(1)
    )
    var user = xtensaDeviceLoadU32(u32(0x3ff4201c)) & u32(0xf7ffffff)
    var user1 = xtensaDeviceLoadU32(u32(0x3ff42020))
    var user2 = xtensaDeviceLoadU32(u32(0x3ff42024))

    if ((control & u32(0x01002000)) == u32(0x01002000)) {
        user = user | u32(0x70000000)
        user1 = esp32RomSpiflashReplaceLowByte(
            (user1 & u32(0x03ffffff)) | u32(0x7c000000),
            dummy + u32(3)
        )
        user2 = u32(0x700000eb)
    } else if ((control & u32(0x00002000)) != u32(0)) {
        user = user | u32(0x50000000)
        if ((control & u32(0x00800000)) != u32(0)) {
            user1 = (user1 & u32(0x03ffffff)) | u32(0x6c000000)
            if (dummy == u32(0)) {
                user = user & u32(0xdfffffff)
                user2 = u32(0x700000bb)
            } else {
                user = user | u32(0x20000000)
                user1 = esp32RomSpiflashReplaceLowByte(user1, dummy - u32(1))
                user2 = (user2 & u32(0xffff0000)) | u32(0xbb)
            }
        } else {
            user = user | u32(0x20000000)
            user1 = esp32RomSpiflashReplaceLowByte(
                (user1 & u32(0x03ffffff)) | u32(0x5c000000),
                dummy + u32(7)
            )
            user2 = if ((control & u32(0x00100000)) != u32(0))
                u32(0x7000006b) else
                if ((control & u32(0x00004000)) != u32(0))
                    u32(0x7000003b) else u32(0x7000000b)
        }
    } else {
        if (dummy == u32(0)) {
            user = user & u32(0xdfffffff)
        } else {
            user = user | u32(0x20000000)
            user1 = esp32RomSpiflashReplaceLowByte(user1, dummy - u32(1))
        }
        user = user | u32(0x50000000)
        user1 = (user1 & u32(0x03ffffff)) | u32(0x5c000000)
        user2 = u32(0x70000003)
    }
    xtensaDeviceStoreU32(u32(0x3ff4201c), user)
    xtensaDeviceStoreU32(u32(0x3ff42020), user1)
    xtensaDeviceStoreU32(u32(0x3ff42024), user2)
    if (esp32RomSpiflashReadData(
        esp32RomSpiflashChipAddress(),
        source,
        destination,
        length
    ) != i32(0)) return i32(1)
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashCacheReadMode")
trusted fun esp32RomSpiflashCacheReadMode(modeBits: u32): void {
    val dummy = esp32RomSpiflashLoadU8(esp32RomSpiflashDummyAddress())
    var user = xtensaDeviceLoadU32(u32(0x3ff4301c)) & u32(0xf7ffffff)
    var user1 = xtensaDeviceLoadU32(u32(0x3ff43020))
    var user2 = xtensaDeviceLoadU32(u32(0x3ff43024))
    if ((modeBits & u32(0x01002000)) == u32(0x01002000)) {
        user = user | u32(0x70000000)
        user1 = esp32RomSpiflashReplaceLowByte(
            (user1 & u32(0x03ffffff)) | u32(0x7c000000),
            dummy + u32(3)
        )
        user2 = (user2 & u32(0xffff0000)) | u32(0xeb)
    } else if ((modeBits & u32(0x00002000)) != u32(0)) {
        user = user | u32(0x70000000)
        if ((modeBits & u32(0x00100000)) != u32(0)) {
            user1 = esp32RomSpiflashReplaceLowByte(
                (user1 & u32(0x03ffffff)) | u32(0x5c000000), dummy + u32(7)
            )
            user2 = (user2 & u32(0xffff0000)) | u32(0x6b)
        } else if ((modeBits & u32(0x00800000)) != u32(0)) {
            user1 = esp32RomSpiflashReplaceLowByte(
                (user1 & u32(0x03ffffff)) | u32(0x6c000000), dummy + u32(1)
            )
            user2 = (user2 & u32(0xffff0000)) | u32(0xbb)
        } else if ((modeBits & u32(0x00004000)) != u32(0)) {
            user1 = esp32RomSpiflashReplaceLowByte(user1, dummy + u32(7))
            user2 = (user2 & u32(0xffff0000)) | u32(0x3b)
        } else {
            user1 = esp32RomSpiflashReplaceLowByte(user1, dummy + u32(7))
            user2 = (user2 & u32(0xffff0000)) | u32(0x0b)
        }
    } else {
        if (dummy == u32(0)) {
            user = user & u32(0xdfffffff)
        } else {
            user = user | u32(0x20000000)
            user1 = esp32RomSpiflashReplaceLowByte(user1, dummy - u32(1))
        }
        user = user | u32(0x50000000)
        user1 = (user1 & u32(0x03ffffff)) | u32(0x5c000000)
        user2 = (user2 & u32(0xffff0000)) | u32(3)
    }
    xtensaDeviceStoreU32(u32(0x3ff4301c), user)
    xtensaDeviceStoreU32(u32(0x3ff43020), user1)
    xtensaDeviceStoreU32(u32(0x3ff43024), user2)
}

@section(".iram1.abla.esp32RomSpiflashConfigReadMode")
trusted fun esp32RomSpiflashConfigReadMode(mode: i32): i32 {
    esp32RomSpiflashWaitCommandIdle(u32(0x3ff420f8))
    esp32RomSpiflashWaitCommandIdle(u32(0x3ff430f8))
    val modeMask = u32(0x01906000)
    var modeBits = u32(0)
    if (mode == i32(0)) modeBits = u32(0x01002000)
    else if (mode == i32(1)) modeBits = u32(0x00102000)
    else if (mode == i32(2)) modeBits = u32(0x00802000)
    else if (mode == i32(3)) modeBits = u32(0x00006000)
    else if (mode == i32(4)) modeBits = u32(0x00002000)
    val flashControl = xtensaDeviceLoadU32(u32(0x3ff42008))
    val cacheControl = xtensaDeviceLoadU32(u32(0x3ff43008))
    xtensaDeviceStoreU32(u32(0x3ff42008), (flashControl & ~modeMask) | modeBits)
    xtensaDeviceStoreU32(u32(0x3ff43008), (cacheControl & ~modeMask) | modeBits)
    esp32RomSpiflashCacheReadMode(modeBits)
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashEraseArea")
trusted fun esp32RomSpiflashEraseArea(start: u32, length: u32): i32 {
    esp32RomSpiflashConfigReadMode(i32(5))
    val chip = esp32RomSpiflashChipAddress()
    val chipSize = esp32RomSpiflashLoadU32(chip + u32(4))
    val blockSize = esp32RomSpiflashLoadU32(chip + u32(8))
    val sectorSize = esp32RomSpiflashLoadU32(chip + u32(12))
    if (start + length > chipSize) return i32(1)
    val startRemainder = start - (start / sectorSize) * sectorSize
    if (startRemainder != u32(0)) return i32(1)
    if (esp32RomSpiflashClearBp() != i32(0)) return i32(1)
    var sector = start / sectorSize
    val sectorsPerBlock = blockSize / sectorSize
    val lengthRemainder = length - (length / sectorSize) * sectorSize
    var sectors = length / sectorSize
    if (lengthRemainder != u32(0)) sectors = sectors + u32(1)
    val sectorInBlock = sector - (sector / sectorsPerBlock) * sectorsPerBlock
    var head = sectorsPerBlock - sectorInBlock
    if (head > sectors) head = sectors
    sectors = sectors - head
    while (head != u32(0)) {
        if (esp32RomSpiflashEraseSector(sector) != i32(0)) return i32(1)
        sector = sector + u32(1)
        head = head - u32(1)
    }
    while (sectors > sectorsPerBlock) {
        if (esp32RomSpiflashEraseBlock(sector / sectorsPerBlock) != i32(0)) {
            return i32(1)
        }
        sector = sector + sectorsPerBlock
        sectors = sectors - sectorsPerBlock
    }
    while (sectors != u32(0)) {
        if (esp32RomSpiflashEraseSector(sector) != i32(0)) return i32(1)
        sector = sector + u32(1)
        sectors = sectors - u32(1)
    }
    i32(0)
}

@section(".iram1.abla.esp32RomSpiflashEncryptedEnable")
trusted fun esp32RomSpiflashEncryptedEnable(): void {
    val control = xtensaDeviceLoadU32(u32(0x3ff000c8))
    xtensaDeviceStoreU32(u32(0x3ff000c8), control | u32(0x101))
}

trusted fun esp32RomSpiflashEncryptedEnableValue(): u32 {
    esp32RomSpiflashEncryptedEnable()
    u32(0)
}

@section(".iram1.abla.esp32RomSpiflashPrepareEncryptedData")
trusted fun esp32RomSpiflashPrepareEncryptedData(
    flashOffset: u32,
    source: u32
): i32 {
    if ((flashOffset & u32(31)) != u32(0)) return i32(1)
    xtensaDeviceStoreU32(u32(0x3ff5b024), flashOffset)
    var word = u32(0)
    while (word < u32(8)) {
        xtensaDeviceStoreU32(
            u32(0x3ff5b000) + word * u32(4),
            esp32RomSpiflashLoadU32(source + word * u32(4))
        )
        word = word + u32(1)
    }
    xtensaDeviceStoreU32(u32(0x3ff5b020), u32(1))
    while ((xtensaDeviceLoadU32(u32(0x3ff5b028)) & u32(1)) == u32(0)) {}
    i32(0)
}

trusted fun esp32RomSpiflashPrepareEncryptedDataValue(
    flashOffset: u32,
    source: u32
): u32 = u32(esp32RomSpiflashPrepareEncryptedData(flashOffset, source))

@section(".iram1.abla.esp32RomSpiflashEncryptedDisable")
trusted fun esp32RomSpiflashEncryptedDisable(): void {
    val control = xtensaDeviceLoadU32(u32(0x3ff000c8))
    xtensaDeviceStoreU32(u32(0x3ff000c8), control & u32(0xfffffefe))
}

trusted fun esp32RomSpiflashEncryptedDisableValue(): u32 {
    esp32RomSpiflashEncryptedDisable()
    u32(0)
}

@section(".iram1.abla.esp32RomSpiflashWriteEncrypted")
trusted fun esp32RomSpiflashWriteEncrypted(
    flashOffset: u32,
    source: u32,
    length: u32
): i32 {
    if (((flashOffset | length) & u32(31)) != u32(0)) return i32(1)
    esp32RomSpiflashEncryptedEnable()
    var result = i32(0)
    var block = u32(0)
    val blocks = length >>> u32(5)
    while (block < blocks && result == i32(0)) {
        val offset = block << u32(5)
        result = esp32RomSpiflashPrepareEncryptedData(
            flashOffset + offset,
            source + offset
        )
        if (result == i32(0)) {
            result = esp32RomSpiflashWrite(flashOffset + offset, source, i32(32))
        }
        block = block + u32(1)
    }
    esp32RomSpiflashEncryptedDisable()
    result
}
