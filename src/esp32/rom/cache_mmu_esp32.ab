import "../hal/mmu_primitives_esp32.ab"

@inline
fun esp32CacheFlashVirtualAddressValid(address: u32): bool =
    (address >= u32(0x3f400000) && address < u32(0x3f800000)) ||
    (address >= u32(0x400d0000) && address < u32(0x40400000))

// Original ROM ABI symbol: cache_flash_mmu_set_rom. Everything after the
// volatile page-table store is normal Abla and therefore visible to LLVM.
trusted fun esp32CacheFlashMmuSet(
    cpu: u32,
    process: u32,
    virtualAddress: u32,
    physicalAddress: u32,
    pageSizeKilobytes: u32,
    pages: u32
): u32 {
    if ((virtualAddress & u32(0xffff)) != u32(0) ||
        (physicalAddress & u32(0xffff)) != u32(0)) return u32(1)
    if (process > u32(7)) return u32(2)
    if (pageSizeKilobytes != u32(64)) return u32(3)
    if (!esp32CacheFlashVirtualAddressValid(virtualAddress)) return u32(5)
    if (cpu > u32(1)) return u32(4)
    val firstEntry = esp32MmuEntryId(virtualAddress)
    val firstPhysicalPage = physicalAddress >>> u32(16)
    if (firstEntry + pages > esp32MmuEntryCount ||
        firstPhysicalPage + pages > u32(256)) return u32(4)
    var page = u32(0)
    while (page < pages) {
        esp32MmuWriteEntry(
            cpu,
            firstEntry + page,
            firstPhysicalPage + page
        )
        page = page + u32(1)
    }
    u32(0)
}

// The ESP32 target implementation is intentionally empty in the compiled IDF
// object; retain its source-level hook without materializing an ABI symbol.
trusted fun esp32BootloaderAnalogClockGlitchResetConfig(
    enabled: u32,
    reset: u32
): u32 = u32(0)
