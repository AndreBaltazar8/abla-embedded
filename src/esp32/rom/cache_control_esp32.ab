import "../../xtensa/assembly.ab"
import "abla/unsafe/memory"

// Exact classic-ESP32 ROM cache/MMU semantics expressed as typed Abla. The
// control flow and register values remain visible to LLVM; only volatile MMIO
// accesses retain target ordering semantics.
val esp32ProCacheControl = u32(1072693312)
val esp32AppCacheControl = u32(1072693336)
val esp32CacheClockControl = u32(1072967760)
val esp32SpiExt2Status = u32(1072967928)
val esp32ProMmuTable = u32(1072758784)
val esp32AppMmuTable = u32(1072766976)

@inline
fun esp32CacheControlAddress(cpu: u32): u32 =
    if (cpu == u32(0)) esp32ProCacheControl else esp32AppCacheControl

@inline
fun esp32OtherCacheControlAddress(cpu: u32): u32 =
    if (cpu == u32(0)) esp32AppCacheControl else esp32ProCacheControl

// Original ABI symbol: Cache_Flush_rom.
@section(".iram1.0.abla.esp32RomCacheFlush")
trusted fun esp32RomCacheFlush(cpu: u32): void {
    val control = esp32CacheControlAddress(cpu)
    val disabled = xtensaDeviceLoadU32(control) & ~u32(16)
    xtensaDeviceStoreU32(control, disabled)
    val started = xtensaDeviceLoadU32(control) | u32(16)
    xtensaDeviceStoreU32(control, started)
    var status = xtensaDeviceLoadU32(control)
    while ((status & u32(32)) == u32(0)) {
        status = xtensaDeviceLoadU32(control)
    }
    val finished = xtensaDeviceLoadU32(control) & ~u32(16)
    xtensaDeviceStoreU32(control, finished)
}

@section(".iram1.0.abla.esp32RomCacheFlushValue")
trusted fun esp32RomCacheFlushValue(cpu: u32): u32 {
    esp32RomCacheFlush(cpu)
    u32(0)
}

// Original ABI symbol: Cache_Read_Enable_rom.
@section(".iram1.0.abla.esp32RomCacheReadEnable")
trusted fun esp32RomCacheReadEnable(cpu: u32): void {
    val clock = xtensaDeviceLoadU32(esp32CacheClockControl) | u32(1)
    xtensaDeviceStoreU32(esp32CacheClockControl, clock)
    val control = esp32CacheControlAddress(cpu)
    val enabled = xtensaDeviceLoadU32(control) | u32(8)
    xtensaDeviceStoreU32(control, enabled)
}

@section(".iram1.0.abla.esp32RomCacheReadEnableValue")
trusted fun esp32RomCacheReadEnableValue(cpu: u32): u32 {
    esp32RomCacheReadEnable(cpu)
    u32(0)
}

// Original ABI symbol: Cache_Read_Disable_rom.
@section(".iram1.0.abla.esp32RomCacheReadDisable")
trusted fun esp32RomCacheReadDisable(cpu: u32): void {
    val control = esp32CacheControlAddress(cpu)
    val disabled = xtensaDeviceLoadU32(control) & ~u32(8)
    xtensaDeviceStoreU32(control, disabled)
    val otherControl = esp32OtherCacheControlAddress(cpu)
    val other = xtensaDeviceLoadU32(otherControl)
    if ((other & u32(8)) == u32(0)) {
        var busy = xtensaDeviceLoadU32(esp32SpiExt2Status)
        while (busy != u32(0)) {
            busy = xtensaDeviceLoadU32(esp32SpiExt2Status)
        }
        val clock = xtensaDeviceLoadU32(esp32CacheClockControl) & ~u32(1)
        xtensaDeviceStoreU32(esp32CacheClockControl, clock)
    }
}

@section(".iram1.0.abla.esp32RomCacheReadDisableValue")
trusted fun esp32RomCacheReadDisableValue(cpu: u32): u32 {
    esp32RomCacheReadDisable(cpu)
    u32(0)
}

// Original ABI symbol: mmu_init. ROM clears the complete 8 KiB per-core MMU
// table. Ordinary stores intentionally expose the fill loop to LLVM so it can
// select the smallest target implementation in the monolithic module.
@section(".iram1.0.abla.esp32RomMmuInit")
trusted fun esp32RomMmuInit(cpu: u32): void {
    val base = if (cpu == u32(0)) esp32ProMmuTable else esp32AppMmuTable
    var entry = u32(0)
    while (entry < u32(2048)) {
        ablaUnsafeStoreU32(
            nativePointerFromAddress(int(base + (entry << u32(2)))), 0
        )
        entry = entry + u32(1)
    }
}
