import "../../xtensa/assembly.ab"

// Classic ESP32 internal analog-I2C ROM protocol. The host selects one of the
// command registers at 0x6000e000; bit 25 is the hardware busy flag.

@inline
fun esp32RomRegisterI2cCommandAddress(host: u32): u32 =
    u32(1610670080) + ((host & u32(255)) << u32(2))

// Original ABI symbol: esp_rom_regi2c_read (ROM rom_chip_i2c_readReg).
@section(".iram1.0.abla.esp32RomRegisterI2cRead")
trusted fun esp32RomRegisterI2cRead(
    block: u32,
    host: u32,
    register: u32
): u32 {
    val address = esp32RomRegisterI2cCommandAddress(host)
    val command = ((register & u32(255)) << u32(8)) |
        (block & u32(255))
    xtensaDeviceStoreU32(address, command)
    var result = xtensaDeviceLoadU32(address)
    while ((result & u32(33554432)) != u32(0)) {
        result = xtensaDeviceLoadU32(address)
    }
    return (result >>> u32(16)) & u32(255)
}

// Original ABI symbol: esp_rom_regi2c_write.
@section(".iram1.0.abla.esp32RomRegisterI2cWrite")
trusted fun esp32RomRegisterI2cWrite(
    block: u32,
    host: u32,
    register: u32,
    data: u32
): void {
    val address = esp32RomRegisterI2cCommandAddress(host)
    val command = u32(16777216) |
        ((data & u32(255)) << u32(16)) |
        ((register & u32(255)) << u32(8)) |
        (block & u32(255))
    xtensaDeviceStoreU32(address, command)
    var result = xtensaDeviceLoadU32(address)
    while ((result & u32(33554432)) != u32(0)) {
        result = xtensaDeviceLoadU32(address)
    }
    return
}

// Original ABI symbol: esp_rom_regi2c_read_mask.
@section(".iram1.0.abla.esp32RomRegisterI2cReadMask")
trusted fun esp32RomRegisterI2cReadMask(
    block: u32,
    host: u32,
    register: u32,
    mostSignificantBit: u32,
    leastSignificantBit: u32
): u32 {
    val width = mostSignificantBit - leastSignificantBit + u32(1)
    val mask = (u32(1) << width) - u32(1)
    return (esp32RomRegisterI2cRead(block, host, register) >>>
        leastSignificantBit) & mask
}

// Original ABI symbol: esp_rom_regi2c_write_mask.
@section(".iram1.0.abla.esp32RomRegisterI2cWriteMask")
trusted fun esp32RomRegisterI2cWriteMask(
    block: u32,
    host: u32,
    register: u32,
    mostSignificantBit: u32,
    leastSignificantBit: u32,
    data: u32
): void {
    val width = mostSignificantBit - leastSignificantBit + u32(1)
    val fieldMask = ((u32(1) << width) - u32(1)) << leastSignificantBit
    val previous = esp32RomRegisterI2cRead(block, host, register)
    val updated = (previous & ~fieldMask) |
        ((data << leastSignificantBit) & fieldMask)
    esp32RomRegisterI2cWrite(block, host, register, updated & u32(255))
}
