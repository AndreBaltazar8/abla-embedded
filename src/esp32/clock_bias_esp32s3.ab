import "./clock_bias_s3.ab"
import "abla/unsafe/mmio"
// Read-only efuse shadow registers; never programs efuses. Call during init
// with efuse shadows ready, then retain the scalar for IRAM clock transitions.
trusted fun esp32S3ClockBiasRead(): Esp32S3ClockBias = esp32S3ClockBiasDecode(
    mmioLoadU32(0x6000706C) & 3,(mmioLoadU32(0x60007050)>>>24) & 7,
    mmioLoadU32(0x60007054),mmioLoadU32(0x60007058))
