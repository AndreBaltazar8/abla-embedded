import "abla/unsafe/memory"

// This is the intentionally isolated Arduino C++ ABI adapter. The application
// never handles a C++ object or mangled symbol. The storage is oversized for
// the ESP32 Arduino 2.0.x WiFiClientSecure object and constructed in place.
trusted noescape extern:"c" fun _ZN16WiFiClientSecureC1Ev(self: i64*): void
trusted noescape extern:"c" fun _ZN16WiFiClientSecureD1Ev(self: i64*): void
trusted noescape extern:"c" fun _ZN16WiFiClientSecure9setCACertEPKc(
    self: i64*,
    certificate: cstring
): void
trusted noescape extern:"c" fun _ZN16WiFiClientSecure7connectEPKct(
    self: i64*,
    host: cstring,
    port: u16
): bool
trusted noescape extern:"c" fun _ZN16WiFiClientSecure5writeEPKhj(
    self: i64*,
    data: i64*,
    length: u32
): u32
trusted noescape extern:"c" fun _ZN16WiFiClientSecure4readEPhj(
    self: i64*,
    data: i64*,
    length: u32
): i32
trusted noescape extern:"c" fun _ZN16WiFiClientSecure9availableEv(
    self: i64*
): i32
trusted noescape extern:"c" fun _ZN16WiFiClientSecure9connectedEv(
    self: i64*
): u8
trusted noescape extern:"c" fun _ZN16WiFiClientSecure4stopEv(self: i64*): void

resource class TlsClient(val address: i64*, var closed: bool) {
    trusted fun drop(): void {
        if (!closed) {
            _ZN16WiFiClientSecure4stopEv(address)
            _ZN16WiFiClientSecureD1Ev(address)
            ablaUnsafeFree(address)
            closed = true
        }
    }
}

trusted fun tlsClient(): TlsClient {
    val address = ablaUnsafeAllocate(512)
    _ZN16WiFiClientSecureC1Ev(address)
    TlsClient(address, false)
}

trusted fun TlsClient.setCertificate(certificate: string): void {
    if (!this.closed) _ZN16WiFiClientSecure9setCACertEPKc(this.address, certificate)
    return
}

trusted fun TlsClient.connect(host: string, port: int): bool =
    !this.closed && _ZN16WiFiClientSecure7connectEPKct(this.address, host, port)

trusted fun TlsClient.connected(): bool =
    !this.closed && _ZN16WiFiClientSecure9connectedEv(this.address) != 0

trusted fun TlsClient.available(): int {
    var result = 0
    if (!this.closed) {
        val available: int = _ZN16WiFiClientSecure9availableEv(this.address)
        result = available
    }
    result
}

trusted fun TlsClient.write(buffer: NativeByteBuffer, length: int): int {
    var result = 0
    if (!this.closed) {
        val written: int = _ZN16WiFiClientSecure5writeEPKhj(
            this.address, buffer.address, length
        )
        result = written
    }
    result
}

trusted fun TlsClient.writeSlice(
    buffer: NativeByteBuffer,
    offset: int,
    length: int
): int {
    var result = 0
    if (!this.closed && offset >= 0 && length >= 0 &&
        offset + length <= buffer.capacity) {
        val written: int = _ZN16WiFiClientSecure5writeEPKhj(
            this.address, buffer.pointerAt(offset), length
        )
        result = written
    }
    result
}

trusted fun TlsClient.read(var buffer: NativeByteBuffer, length: int): int {
    var result = 0
    if (!this.closed) {
        val read: int = _ZN16WiFiClientSecure4readEPhj(
            this.address, buffer.address, length
        )
        result = read
    }
    result
}

trusted fun TlsClient.readSlice(
    var buffer: NativeByteBuffer,
    offset: int,
    length: int
): int {
    var result = 0
    if (!this.closed && offset >= 0 && length >= 0 &&
        offset + length <= buffer.capacity) {
        val read: int = _ZN16WiFiClientSecure4readEPhj(
            this.address, buffer.pointerAt(offset), length
        )
        result = read
    }
    result
}

trusted fun TlsClient.stop(): void {
    if (!this.closed) _ZN16WiFiClientSecure4stopEv(this.address)
    return
}
