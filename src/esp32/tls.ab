import "abla/unsafe/memory"
import "./sdk/buffer.ab"

// This is the intentionally isolated Arduino C++ ABI adapter. The application
// never handles a C++ object or mangled symbol. The storage size matches the
// pinned ESP32 Arduino 2.0.16 WiFiClientSecure ABI and is constructed in place.
trusted noescape extern:"c" fun _ZN16WiFiClientSecureC1Ev(self: i64*): void
trusted noescape extern:"c" fun _ZN16WiFiClientSecureD1Ev(self: i64*): void
trusted noescape extern:"c" fun _ZN16WiFiClientSecure9setCACertEPKc(
    self: i64*,
    certificate: cstring
): void
trusted noescape extern:"c" fun _ZN16WiFiClientSecure7connectEPKct(
    self: i64*,
    host: cstring,
    port: u16
): bool
trusted noescape extern:"c" fun _ZN16WiFiClientSecure5writeEPKhj(
    self: i64*,
    data: i64*,
    length: u32
): u32
trusted noescape extern:"c" fun _ZN16WiFiClientSecure4readEPhj(
    self: i64*,
    data: i64*,
    length: u32
): i32
trusted noescape extern:"c" fun _ZN16WiFiClientSecure9availableEv(
    self: i64*
): i32
trusted noescape extern:"c" fun _ZN16WiFiClientSecure9connectedEv(
    self: i64*
): u8
trusted noescape extern:"c" fun _ZN16WiFiClientSecure4stopEv(self: i64*): void

type TlsClient = int
val tlsClientStorageBytes = 96

trusted fun tlsClientAt(address: int): TlsClient {
    _ZN16WiFiClientSecureC1Ev(nativePointerFromAddress(address))
    TlsClient(address)
}

// Convenient single-client storage for small firmware. Projects needing more
// clients can reserve distinct regions and construct each with tlsClientAt.
trusted fun tlsClient(): TlsClient =
    tlsClientAt(nativeStaticAllocate(96))

trusted fun TlsClient.pointer(): i64* = nativePointerFromAddress(this)

trusted fun TlsClient.setCertificate(certificate: string): void {
    if (this != 0) _ZN16WiFiClientSecure9setCACertEPKc(this.pointer(), certificate)
    return
}

trusted fun TlsClient.connect(host: string, port: int): bool =
    this != 0 && _ZN16WiFiClientSecure7connectEPKct(this.pointer(), host, port)

trusted fun TlsClient.connected(): bool =
    this != 0 && _ZN16WiFiClientSecure9connectedEv(this.pointer()) != 0

trusted fun TlsClient.available(): int {
    var result = 0
    if (this != 0) {
        val available: int = _ZN16WiFiClientSecure9availableEv(this.pointer())
        result = available
    }
    result
}

trusted fun TlsClient.write(buffer: NativeBuffer, length: int): int {
    var result = 0
    if (this != 0) {
        val written: int = _ZN16WiFiClientSecure5writeEPKhj(
            this.pointer(), buffer.pointer(), length
        )
        result = written
    }
    result
}

trusted fun TlsClient.writeSlice(
    buffer: NativeBuffer,
    offset: int,
    length: int
): int {
    var result = 0
    if (this != 0 && offset >= 0 && length >= 0 &&
        offset + length <= buffer.capacity()) {
        val written: int = _ZN16WiFiClientSecure5writeEPKhj(
            this.pointer(), buffer.pointerAt(offset), length
        )
        result = written
    }
    result
}

trusted fun TlsClient.read(buffer: NativeBuffer, length: int): int {
    var result = 0
    if (this != 0) {
        val read: int = _ZN16WiFiClientSecure4readEPhj(
            this.pointer(), buffer.pointer(), length
        )
        result = read
    }
    result
}

trusted fun TlsClient.readSlice(
    buffer: NativeBuffer,
    offset: int,
    length: int
): int {
    var result = 0
    if (this != 0 && offset >= 0 && length >= 0 &&
        offset + length <= buffer.capacity()) {
        val read: int = _ZN16WiFiClientSecure4readEPhj(
            this.pointer(), buffer.pointerAt(offset), length
        )
        result = read
    }
    result
}

trusted fun TlsClient.stop(): void {
    if (this != 0) _ZN16WiFiClientSecure4stopEv(this.pointer())
    return
}

trusted fun TlsClient.destroy(): void {
    if (this != 0) {
        _ZN16WiFiClientSecure4stopEv(this.pointer())
        _ZN16WiFiClientSecureD1Ev(this.pointer())
    }
    return
}
