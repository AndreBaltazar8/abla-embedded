import "./clock_state_s3.ab"

// rtc_clk_cpu_freq_to_pll_mhz sequencing. Caller owns clocks/analog/cache/UART
// coordination and has enabled/calibrated the PLL already; this function does
// NOT start it or infer voltage calibration. Four biases come from chip init.
// Reject powered-down PLL and impossible 320PLL/240CPU before writes.
// Clock owner must update APB consumers to80MHz after success.
@section(".iram1.abla.s3ClockToReadyPll")
trusted fun esp32S3ClockToReadyPllOwned(mhz: int,rtc240: int,dig240: int,rtcLow: int,digLow: int): Esp32S3ClockState {
    if ((mhz != 80 && mhz != 160 && mhz != 240) || rtc240 < 0 || rtc240 > 31 ||
        dig240 < 0 || dig240 > 31 || rtcLow < 0 || rtcLow > 31 || digLow < 0 || digLow > 31) return Esp32S3ClockState(0)
    val sys=esp32S3ClockRead(0x600C0060)
    val peripheral=esp32S3ClockRead(0x600C0010)
    val stored=esp32S3ClockRead(0x600080C0)
    val before=esp32S3ClockDecode(sys,peripheral,stored)
    if (!before.valid() || (mhz == 240 && (peripheral & 4) == 0) ||
        (esp32S3ClockRead(0x60008000) & 0x540) != 0) return Esp32S3ClockState(0)
    val currentHz=before.hertz()
    val targetHz=mhz*1000000
    val period=if (mhz == 80) 0 else if (mhz == 160) 1 else 2
    val slave=if (mhz == 80) 3 else if (mhz == 160) 1 else 0
    if (targetHz > currentHz) {
        if (mhz == 240) {
            esp32S3ClockBiasWrite(4,rtc240)
            esp32S3ClockBiasWrite(6,dig240)
            esp32S3ClockRomDelay(40)
        }
        esp32S3ClockUpdate(0x600081FC,0x7E000,slave<<13)
    }
    esp32S3ClockUpdate(0x600C0010,3,period)
    esp32S3ClockUpdate(0x600C0060,1023,0)
    esp32S3ClockUpdate(0x600C0060,3072,1024)
    esp32S3ClockRomTicks(mhz)
    if (targetHz < currentHz) {
        if (currentHz == 240000000) {
            esp32S3ClockBiasWrite(4,rtcLow)
            esp32S3ClockBiasWrite(6,digLow)
            esp32S3ClockRomDelay(40)
        }
        esp32S3ClockUpdate(0x600081FC,0x7E000,slave<<13)
    }
    before
}
