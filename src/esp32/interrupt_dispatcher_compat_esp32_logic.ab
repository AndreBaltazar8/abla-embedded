import "./interrupt_matrix_esp32_logic.ab"

val esp32XtensaExceptionCount = i32(64)
// One bit per classic ESP32 CPU interrupt whose level is at or below EXCM 3.
val esp32XtensaNativeHandlerMask = u32(687824895)

@inline
fun esp32InterruptDispatcherIndex(number: i32, core: u32): u32 =
    u32(number) * u32(esp32XtensaCoreCount) + core

@inline
fun esp32ExceptionDispatcherIndex(number: i32, core: u32): u32 =
    u32(number) * u32(esp32XtensaCoreCount) + core

@inline
fun esp32DispatcherSupportsInterruptNumber(number: i32): bool {
    if (number < i32(0) || number >= xtensaInterruptCount) return false
    ((esp32XtensaNativeHandlerMask >>> u32(number)) & u32(1)) != u32(0)
}

@inline
fun esp32DispatcherSupportsExceptionNumber(number: i32): bool =
    number >= i32(0) && number < esp32XtensaExceptionCount
