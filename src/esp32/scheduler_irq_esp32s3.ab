import "./scheduler_irq_s3_sequence.ab"
import "./irq_runtime_esp32s3.ab"
@section(".iram1.abla.s3SchedulerIrqCallback")
trusted fun esp32S3SchedulerIrqCallback(frame: u32,level: u32,core: u32,record: u32): void {
    esp32S3SchedulerIrqDispatch(int(frame),int(level),int(core),int(record)); return
}
@inline
trusted fun esp32S3SchedulerIrqAddress(): int = nativeFunctionAddress(esp32S3SchedulerIrqCallback)
@inline
trusted fun esp32S3SchedulerIrqRuntimeAddress(): int = esp32S3IrqRuntimeAddress()
@inline
trusted fun esp32S3SchedulerIrqCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3SchedulerIrqEnabled(): int = esp32S3IrqStackEnabled()
@inline
trusted fun esp32S3SchedulerIrqConfig(): int = esp32S3IrqConfigAddress()
@inline
trusted fun esp32S3SchedulerIrqRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3SchedulerIrqWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
trusted fun esp32S3SchedulerIrqMask(): void { xtensaGuardMaskLocal(); return }
@inline
trusted fun esp32S3SchedulerIrqDrain(frame: int,level: int,core: int,record: int): void {
    esp32S3IrqRuntimeDispatch(frame,level,core,record); return
}
@inline
trusted fun esp32S3SchedulerIrqCall(callback: int,frame: int,level: int,core: int,context: int): void {
    callNativeVoidI32I32I32I32(callback,frame,level,core,context); return
}
