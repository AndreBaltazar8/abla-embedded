import "./scheduler_irq_s3_sequence.ab"
import "./irq_runtime_esp32s3.ab"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
import "abla/unsafe/native"
import "abla/unsafe/mmio"
import "./irq_runtime_s3_sequence.ab"
@section(".iram1.abla.s3SchedulerIrqCallback")
trusted fun esp32S3SchedulerIrqCallback(frame: u32,level: u32,core: u32,record: u32): void {
    esp32S3SchedulerIrqDispatch(int(frame),int(level),int(core),int(record)); return
}
@inline
@export("esp32S3SchedulerIrqAddress")
trusted fun esp32S3SchedulerIrqAddressHook(): int = nativeFunctionAddress(esp32S3SchedulerIrqCallback)
@inline
@export("esp32S3SchedulerIrqRuntimeAddress")
trusted fun esp32S3SchedulerIrqRuntimeAddressHook(): int = esp32S3IrqRuntimeAddress()
@inline
@export("esp32S3SchedulerIrqCore")
trusted fun esp32S3SchedulerIrqCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3SchedulerIrqEnabled")
trusted fun esp32S3SchedulerIrqEnabledHook(): int = esp32S3IrqStackEnabled()
@inline
@export("esp32S3SchedulerIrqConfig")
trusted fun esp32S3SchedulerIrqConfigHook(): int = esp32S3IrqConfigAddress()
@inline
@export("esp32S3SchedulerIrqRead")
trusted fun esp32S3SchedulerIrqReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3SchedulerIrqWrite")
trusted fun esp32S3SchedulerIrqWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
@inline
@export("esp32S3SchedulerIrqMask")
trusted fun esp32S3SchedulerIrqMaskHook(): void { xtensaGuardMaskLocal(); return }
@inline
@export("esp32S3SchedulerIrqDrain")
trusted fun esp32S3SchedulerIrqDrainHook(frame: int,level: int,core: int,record: int): void {
    esp32S3IrqRuntimeDispatch(frame,level,core,record); return
}
@inline
@export("esp32S3SchedulerIrqCall")
trusted fun esp32S3SchedulerIrqCallHook(callback: int,frame: int,level: int,core: int,context: int): void {
    callNativeVoidI32I32I32I32(callback,frame,level,core,context); return
}
