import "../time/unix_clock52.ab"
import "./timer/system_p4_sequence.ab"
// Opt-in wall clock: no SDK clock, allocation, timer enable/reset or timezone.
// Caller serializes access and snapshots, pins the timer source/rate, excludes
// counter reloads, and reconfigures after reset or clock-stopping sleep.
val p4UnixClockStorage=nativeStaticMutableU32s([0,0,0,0,0,0,0,0])
var p4UnixClockRate=0
var p4UnixClockPolls=0
var p4UnixClockUnit=0
trusted fun esp32P4ConfigureUnixClock(ticksPerSecond: int,polls: int = 64,unit: int = 0): bool {
    if (ticksPerSecond < 1 || ticksPerSecond > 4294967295 || polls < 1 || polls > 1000000 || unit < 0 || unit > 1) return false
    nativeAddressStoreU32(p4UnixClockStorage,0,0)
    p4UnixClockRate=ticksPerSecond;p4UnixClockPolls=polls;p4UnixClockUnit=unit
    true
}
trusted fun setUnixTimeSeconds(seconds: int): bool {
    if (p4UnixClockRate == 0 || seconds < 0 || seconds > 253402300799) return false
    unixClock52At(nativeBufferAt(p4UnixClockStorage,32)).setAt(seconds,
        p4SystemCounter(p4UnixClockUnit).tryTicks(p4UnixClockPolls),p4UnixClockRate)
}
trusted fun unixTimeSeconds(): int {
    if (p4UnixClockRate == 0) return -1
    unixClock52At(nativeBufferAt(p4UnixClockStorage,32)).secondsAt(
        p4SystemCounter(p4UnixClockUnit).tryTicks(p4UnixClockPolls))
}
