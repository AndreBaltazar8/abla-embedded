import "../../xtensa/assembly.ab"
import "../../wifi/ccmp_logic.ab"
import "abla/unsafe/memory"

// Exact classic-ESP32 legacy cipher descriptor/header boundaries. These
// symbols are retained by the generic cipher table even when an application
// selects WPA2/CCMP.

val esp32VendorLegacyTransmitLowOffset = 152
val esp32VendorLegacyTransmitHighOffset = 156
val esp32VendorLegacyDescriptorOffset = 160

@inline
trusted fun esp32VendorLegacyLoadU8(address: int): int =
    ablaUnsafeVolatileLoadU8(address)

@inline
trusted fun esp32VendorLegacyLoadU16(address: int): int =
    ablaUnsafeVolatileLoadU16(address)

@inline
trusted fun esp32VendorLegacyLoadU32(address: int): int =
    ablaUnsafeVolatileLoadU32(address)

@inline
trusted fun esp32VendorLegacyStoreU8(address: int, value: int): void =
    ablaUnsafeVolatileStoreU8(address, value & 255)

@inline
trusted fun esp32VendorLegacyStoreU16(address: int, value: int): void =
    ablaUnsafeVolatileStoreU16(address, u16(value))

@inline
trusted fun esp32VendorLegacyStoreU32(address: int, value: int): void =
    ablaUnsafeVolatileStoreU32(address, u32(value))

@inline
trusted fun esp32VendorLegacyMbufStorage(mbuf: u32): u32 =
    if (mbuf == u32(0)) u32(0)
    else u32(esp32VendorLegacyLoadU32(int(mbuf) + 4))

@inline
trusted fun esp32VendorLegacyMbufFrame(mbuf: u32): u32 {
    val storage = esp32VendorLegacyMbufStorage(mbuf)
    if (storage == u32(0)) u32(0)
    else u32(esp32VendorLegacyLoadU32(int(storage) + 4))
}

@inline
trusted fun esp32VendorLegacySetFrame(mbuf: u32, frame: u32): void {
    val storage = esp32VendorLegacyMbufStorage(mbuf)
    if (storage != u32(0)) {
        esp32VendorLegacyStoreU32(int(storage) + 4, int(frame))
    }
    return
}

@inline
trusted fun esp32VendorLegacyBodyLength(mbuf: u32): int =
    esp32VendorLegacyLoadU16(int(mbuf) + 22)

@inline
trusted fun esp32VendorLegacyNextTransmitLow(key: u32): int {
    val lowAddress = int(key) + esp32VendorLegacyTransmitLowOffset
    val highAddress = int(key) + esp32VendorLegacyTransmitHighOffset
    val previous = esp32VendorLegacyLoadU32(lowAddress)
    val low = (previous + 1) & 4294967295
    var high = esp32VendorLegacyLoadU32(highAddress)
    if (low == 0) high = (high + 1) & 4294967295
    esp32VendorLegacyStoreU32(lowAddress, low)
    esp32VendorLegacyStoreU32(highAddress, high)
    low
}

@export("wep_encap")
trusted fun esp32VendorWepEncap(
    key: u32,
    mbuf: u32,
    keyIdentifier: u32
): i32 {
    xtensaAssemblyVoid(
        ".pushsection .data.wep,\"aw\",@progbits\n.global wep\n.type wep,@object\n.balign 4\nwep:\n.long 1\n.long 4\n.long 4\n.long 0\n.long wep_encap\n.long wep_decap\n.size wep,24\n.popsection",
        "~{memory}"
    )
    if (key == u32(0) || mbuf == u32(0)) return i32(0)
    val frame = esp32VendorLegacyMbufFrame(mbuf)
    if (frame == u32(0) || frame < u32(4)) return i32(0)
    val shifted = frame - u32(4)
    esp32VendorLegacySetFrame(mbuf, shifted)
    esp32VendorLegacyStoreU16(
        int(mbuf) + 22, esp32VendorLegacyBodyLength(mbuf) + 4
    )
    val packetLow = esp32VendorLegacyNextTransmitLow(key)
    esp32VendorLegacyStoreU8(int(shifted), packetLow)
    esp32VendorLegacyStoreU8(int(shifted) + 1, packetLow >>> 8)
    esp32VendorLegacyStoreU8(int(shifted) + 2, packetLow >>> 16)
    esp32VendorLegacyStoreU8(
        int(shifted) + 3, int(keyIdentifier) & 255
    )
    i32(1)
}

@export("wep_decap")
trusted fun esp32VendorWepDecap(
    key: u32,
    mbuf: u32,
    headerLength: i32
): i32 {
    if (key == u32(0) || mbuf == u32(0) || headerLength < 0) return i32(0)
    val frame = esp32VendorLegacyMbufFrame(mbuf)
    val descriptor = esp32VendorLegacyLoadU32(
        int(key) + esp32VendorLegacyDescriptorOffset
    )
    if (frame == u32(0) || descriptor == 0) return i32(0)
    val cipherHeader = esp32VendorLegacyLoadU32(descriptor + 4)
    val cipherTrailer = esp32VendorLegacyLoadU32(descriptor + 8)
    esp32VendorLegacySetFrame(
        mbuf, frame + u32(int(headerLength) + cipherHeader)
    )
    esp32VendorLegacyStoreU16(
        int(mbuf) + 22,
        esp32VendorLegacyBodyLength(mbuf) - cipherHeader - cipherTrailer
    )
    i32(1)
}

@inline
trusted fun esp32VendorTkipGlobalIcAddress(): u32 = xtensaAssemblyReadU32(
    "l32r $0, .Labla_tkip_g_ic_address",
    "=a"
)

@inline
trusted fun esp32VendorTkipSoftwareEnabled(): bool =
    (esp32VendorLegacyLoadU32(
        int(esp32VendorTkipGlobalIcAddress()) + 28
    ) & 67108864) == 0

@inline
trusted fun esp32VendorTkipReceivedPacketNumber(
    frame: u32,
    headerLength: int
): WifiCcmpPacketNumber {
    val address = int(frame) + headerLength
    val low = esp32VendorLegacyLoadU8(address + 2) |
        (esp32VendorLegacyLoadU8(address) << 8) |
        (esp32VendorLegacyLoadU8(address + 4) << 16) |
        (esp32VendorLegacyLoadU8(address + 5) << 24)
    val high = esp32VendorLegacyLoadU8(address + 6) |
        (esp32VendorLegacyLoadU8(address + 7) << 8)
    wifiCcmpPacketNumberFromHalves(low & 4294967295, high)
}

@export("tkip_encap")
trusted fun esp32VendorTkipEncap(
    key: u32,
    mbuf: u32,
    keyIdentifier: u32
): i32 {
    xtensaAssemblyVoid(
        ".literal .Labla_tkip_g_ic_address, g_ic\n.pushsection .data.tkip,\"aw\",@progbits\n.global tkip\n.type tkip,@object\n.balign 4\ntkip:\n.long 2\n.long 8\n.long 12\n.long 8\n.long tkip_encap\n.long tkip_decap\n.size tkip,24\n.popsection",
        "~{memory}"
    )
    if (!esp32VendorTkipSoftwareEnabled()) return i32(1)
    if (key == u32(0) || mbuf == u32(0)) return i32(0)
    val frame = esp32VendorLegacyMbufFrame(mbuf)
    if (frame == u32(0) || frame < u32(8)) return i32(0)
    val shifted = frame - u32(8)
    esp32VendorLegacySetFrame(mbuf, shifted)
    esp32VendorLegacyStoreU16(
        int(mbuf) + 22, esp32VendorLegacyBodyLength(mbuf) + 8
    )
    val low = esp32VendorLegacyLoadU32(
        int(key) + esp32VendorLegacyTransmitLowOffset
    )
    val high = esp32VendorLegacyLoadU32(
        int(key) + esp32VendorLegacyTransmitHighOffset
    )
    val address = int(shifted)
    val tsc1 = (low >>> 8) & 255
    esp32VendorLegacyStoreU8(address, tsc1)
    esp32VendorLegacyStoreU8(address + 1, (tsc1 & 127) | 32)
    esp32VendorLegacyStoreU8(address + 2, low)
    esp32VendorLegacyStoreU8(
        address + 3, (int(keyIdentifier) & 255) | 32
    )
    esp32VendorLegacyStoreU8(address + 4, low >>> 16)
    esp32VendorLegacyStoreU8(address + 5, low >>> 24)
    esp32VendorLegacyStoreU8(address + 6, high)
    esp32VendorLegacyStoreU8(address + 7, high >>> 8)
    esp32VendorLegacyNextTransmitLow(key)
    i32(1)
}

@export("tkip_decap")
trusted fun esp32VendorTkipDecap(
    key: u32,
    mbuf: u32,
    headerLength: i32
): i32 {
    if (key == u32(0) || mbuf == u32(0) || headerLength < 0 ||
        !esp32VendorTkipSoftwareEnabled()) return i32(0)
    val frame = esp32VendorLegacyMbufFrame(mbuf)
    val frameLength = esp32VendorLegacyLoadU16(int(mbuf) + 20) +
        esp32VendorLegacyBodyLength(mbuf)
    if (frame == u32(0) || frameLength < int(headerLength) + 8 ||
        (esp32VendorLegacyLoadU8(
            int(frame) + int(headerLength) + 3
        ) & 32) == 0) return i32(0)
    val trafficIdentifier = wifiCcmpTrafficIdentifier(
        nativeBufferAt(int(frame), frameLength), frameLength
    )
    if (!wifiCcmpTrafficIdentifierValid(trafficIdentifier)) return i32(0)
    val replayAddress = int(key) + 8 + trafficIdentifier * 8
    val previous = wifiCcmpPacketNumberFromHalves(
        esp32VendorLegacyLoadU32(replayAddress),
        esp32VendorLegacyLoadU32(replayAddress + 4)
    )
    val packetNumber = esp32VendorTkipReceivedPacketNumber(
        frame, int(headerLength)
    )
    if (!packetNumber.freshAfter(previous)) return i32(0)
    val value = packetNumber.rawValue()
    esp32VendorLegacyStoreU32(replayAddress, value & 4294967295)
    esp32VendorLegacyStoreU32(replayAddress + 4, value >>> 32)
    val descriptor = esp32VendorLegacyLoadU32(
        int(key) + esp32VendorLegacyDescriptorOffset
    )
    if (descriptor == 0) return i32(0)
    val cipherHeader = esp32VendorLegacyLoadU32(descriptor + 4)
    val cipherTrailer = esp32VendorLegacyLoadU32(descriptor + 8)
    esp32VendorLegacySetFrame(
        mbuf, frame + u32(int(headerLength) + cipherHeader)
    )
    esp32VendorLegacyStoreU16(
        int(mbuf) + 22,
        esp32VendorLegacyBodyLength(mbuf) - cipherHeader - cipherTrailer
    )
    i32(1)
}
