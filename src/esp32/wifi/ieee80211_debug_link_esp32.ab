import "abla/build"

// Complete ieee80211_debug.o ABI. Only the variadic Wi-Fi logger remains a
// foreign root while other opaque ESP archives call it; counters and dumps
// are internal and prunable.
compile fun esp32Idf6LinkIeee80211DebugOpaqueCallers(): bool {
    if (!internalFunction("esp32WifiDebugDumpReceiveTransmit", "dbg_hmac_rxtx_statis_dump")) return false
    if (!internalFunction("esp32WifiDebugDump", "dbg_hmac_statis_dump")) return false
    if (!internalFunction("esp32WifiLogValue", "wifi_log")) return false
    true
}
