import "abla/build"

// ieee80211_ets.o consists only of these two frame-allocation leaves. The
// management-frame name remains visible solely for the two opaque NAN/mesh
// callers; beacon allocation is internal to the Abla program.
compile fun esp32Idf6LinkIeee80211FrameInternals(): bool {
    if (!internalFunction("esp32WifiManagementFrame", "ieee80211_getmgtframe")) return false
    if (!internalFunction("esp32WifiBeaconFrame", "ieee80211_getbcnframe")) return false
    true
}
