import "../../xtensa/assembly.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Exact classic-ESP32 ieee80211_rfid.o compatibility surface. This is a
// callback slot in the vendor interface record; no radio algorithm or hidden
// runtime is involved.

val esp32VendorRfidCallbackOffset = 452

@inline
trusted fun esp32VendorRfidGlobalIcAddress(): u32 = xtensaAssemblyReadU32(
    "l32r $0, .Labla_rfid_g_ic_address",
    "=a"
)

@inline
trusted fun esp32VendorRfidNvsPointerAddress(): u32 = xtensaAssemblyReadU32(
    "l32r $0, .Labla_rfid_nvs_address",
    "=a"
)

@inline
trusted fun esp32VendorRfidCallback(): u32 =
    ablaUnsafeVolatileLoadU32(
        int(esp32VendorRfidGlobalIcAddress()) +
            esp32VendorRfidCallbackOffset
    )

@inline
trusted fun esp32VendorRfidSetCallback(callback: u32): void {
    ablaUnsafeVolatileStoreU32(
        int(esp32VendorRfidGlobalIcAddress()) +
            esp32VendorRfidCallbackOffset,
        callback
    )
    return
}

@export("ieee80211_rfid_locp_recv_open")
trusted fun esp32VendorRfidOpen(): i32 {
    val nvs = ablaUnsafeVolatileLoadU32(
        int(esp32VendorRfidNvsPointerAddress())
    )
    if (nvs == u32(0)) return i32(-1)
    val mode = ablaUnsafeVolatileLoadU8(int(nvs))
    if (mode >= 5 || mode == 2 || mode == 3) i32(0) else i32(-1)
}

@export("ieee80211_rfid_locp_recv_close")
fun esp32VendorRfidClose(): void {
    return
}

@export("ieee80211_rfid_locp_recv_reset")
trusted fun esp32VendorRfidReset(): void {
    // The required reset entry owns the shared literal anchors. Optional Abla
    // helpers can then be pruned without leaving the receive path unresolved.
    xtensaAssemblyVoid(
        ".literal .Labla_rfid_g_ic_address, g_ic\n.literal .Labla_rfid_nvs_address, g_wifi_nvs",
        "~{memory}"
    )
    esp32VendorRfidSetCallback(u32(0))
    return
}

@export("ieee80211_rfid_locp_recv")
trusted fun esp32VendorRfidReceive(
    frame: u32,
    metadata: u32,
    length: u32
): void {
    if (frame == u32(0) ||
        (ablaUnsafeVolatileLoadU8(int(frame) + 4) & 1) == 0) return
    val callback = esp32VendorRfidCallback()
    if (callback != u32(0)) {
        callNativeI32Pointer3(
            int(callback),
            nativePointerFromAddress(int(frame)),
            nativePointerFromAddress(int(metadata)),
            nativePointerFromAddress(int(length))
        )
    }
    return
}

@export("register_ieee80211_rfid_locp_recv_cb")
trusted fun esp32VendorRfidRegister(callback: u32): i32 {
    if (callback == u32(0)) return i32(-1)
    esp32VendorRfidSetCallback(callback)
    i32(0)
}

@export("unregister_ieee80211_rfid_locp_recv_cb")
trusted fun esp32VendorRfidUnregister(): void {
    esp32VendorRfidSetCallback(u32(0))
    return
}
