import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshIoInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMeshIoSemSignal", "esp_mesh_io_sem_signal")) return false
    if (!internalFunction("esp32RecoveredEspMeshIoSemWait", "esp_mesh_io_sem_wait")) return false
    if (!internalFunction("esp32RecoveredEspMeshStopParentReconnection", "esp_mesh_stop_parent_reconnection")) return false
    if (!internalFunction("esp32RecoveredMeshCsaSetBssid", "mesh_csa_set_bssid")) return false
    if (!internalFunction("esp32RecoveredMeshLookForNetwork", "mesh_look_for_network")) return false
    if (!internalFunction("esp32RecoveredMeshNwkIoProcess", "mesh_nwk_io_process")) return false
    if (!internalFunction("esp32RecoveredMeshSetIoProcess", "mesh_set_io_process")) return false
    if (!internalFunction("esp32RecoveredMeshSetRouter", "mesh_set_router")) return false
    if (!internalFunction("esp32RecoveredMeshSetSelfOrganized", "mesh_set_self_organized")) return false
    if (!internalFunction("esp32RecoveredMeshSetType", "mesh_set_type")) return false
    if (!internalFunction("esp32RecoveredMeshSwitchChannel", "mesh_switch_channel")) return false
    true
}
