trusted fun esp32MeshFindConflictRoot(mac:u32, roots:u32):u32 {
    var index = u32(0)
    var address = roots + u32(2)
    while (index != u32(10)) {
        val metadata = roots + (index - (index << u32(3)))
        val flags = esp32MeshParentLoadU8(metadata + u32(1))
        if ((flags & u32(4)) != u32(0) && freestandingCompare(address,mac,u32(6)) == 0) {
            esp32MeshParentStoreU8(metadata + u32(1), flags & u32(0xfffffffb))
            esp32MeshParentStoreU8(roots, esp32MeshParentLoadU8(roots) - u32(1))
            xtensaMemoryBarrier()
            return index
        }
        index = index + u32(1)
        address = address + u32(7)
    }
    u32(0xffffffff)
}

