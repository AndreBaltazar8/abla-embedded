        int(logFunction),1,
        int(esp32Data_Labla_recovered_mesh_parent_data_rodata_esp_mesh_is_switch_parent_str1_1_d7daff146f),
        int(esp32Data_Labla_recovered_mesh_parent_data_rodata_esp_mesh_clear_parent_part_0_str1_1_3554d104eb),
        int(timestamp),
        int(esp32Data_Labla_recovered_mesh_parent_data_rodata_esp_mesh_is_switch_parent_str1_1_d7daff146f),
        int(esp32Data_Labla_recovered_mesh_parent_data_rodata_route_announce_timeout_process_str1_1_236a01ab90))
