import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshWifiInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMeshPushToRxQueue", "esp_mesh_push_to_rx_queue")) return false
    if (!internalFunction("esp32RecoveredEspMeshRxTaskDeinit", "esp_mesh_rx_task_deinit")) return false
    if (!internalFunction("esp32RecoveredEspMeshRxTaskInit", "esp_mesh_rx_task_init")) return false
    if (!internalFunction("esp32RecoveredEspMeshWifiRecvCb", "esp_mesh_wifi_recv_cb")) return false
    if (!internalFunction("esp32RecoveredMeshRxTaskDeinit", "mesh_rx_task_deinit")) return false
    if (!internalFunction("esp32RecoveredMeshRxTaskMain", "mesh_rx_task_main")) return false
    if (!internalFunction("esp32RecoveredMeshTopoGetTtl", "mesh_topo_get_ttl")) return false
    true
}
