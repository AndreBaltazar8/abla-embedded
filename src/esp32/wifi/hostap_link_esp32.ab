import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHostApOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredIeee80211HostapdBeaconTxcb", "ieee80211_hostapd_beacon_txcb")) return false
    if (!internalFunction("esp32RecoveredHostapHandleTimer", "hostap_handle_timer")) return false
    if (!internalFunction("esp32RecoveredIeee80211HostapdPsTxcb", "ieee80211_hostapd_ps_txcb")) return false
    if (!internalFunction("esp32RecoveredCipherTypeMapPublicToInternal", "cipher_type_map_public_to_internal")) return false
    if (!exportFunction("esp32RecoveredIeee80211HostapSendBeaconProcess", "ieee80211_hostap_send_beacon_process")) return false
    if (!internalFunction("esp32RecoveredHostapDeletePtk", "hostap_delete_ptk")) return false
    if (!internalFunction("esp32RecoveredIeee80211HostapAttach", "ieee80211_hostap_attach")) return false
    if (!internalFunction("esp32RecoveredHostapDeliverData", "hostap_deliver_data")) return false
    if (!internalFunction("esp32RecoveredHostapHandleTimerProcess", "hostap_handle_timer_process")) return false
    if (!exportFunction("esp32RecoveredIeee80211HostapdDataTxcb", "ieee80211_hostapd_data_txcb")) return false
    if (!internalFunction("esp32RecoveredWifiApRegRxcb", "wifi_ap_reg_rxcb")) return false
    if (!internalFunction("esp32RecoveredApRxCb", "ap_rx_cb")) return false
    if (!internalFunction("esp32RecoveredHostapAuthOpen", "hostap_auth_open")) return false
    if (!internalFunction("esp32RecoveredHostapRecvCtl", "hostap_recv_ctl")) return false
    if (!internalFunction("esp32RecoveredWifiSoftapStart", "wifi_softap_start")) return false
    if (!internalFunction("esp32RecoveredWifiSoftapStop", "wifi_softap_stop")) return false
    if (!internalFunction("esp32RecoveredWifiSoftapCurMaxApBssNum", "wifi_softap_cur_max_ap_bss_num")) return false
    if (!internalFunction("esp32RecoveredApSaQueryTimeoutProcess", "ap_sa_query_timeout_process")) return false
    if (!internalFunction("esp32RecoveredApTrySaQueryProcess", "ap_try_sa_query_process")) return false
    if (!internalFunction("esp32RecoveredHostapRecvMgmt", "hostap_recv_mgmt")) return false
    if (!internalFunction("esp32RecoveredHostapInput", "hostap_input")) return false
    true
}
