import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkStationOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredIeee80211ParseObssScanParam", "ieee80211_parse_obss_scan_param")) return false
    if (!internalFunction("esp32RecoveredIeee80211ParseWmeparams", "ieee80211_parse_wmeparams")) return false
    if (!internalFunction("esp32RecoveredIeee80211SetBssMaxIdlePeriod", "ieee80211_set_bss_max_idle_period")) return false
    if (!exportFunction("esp32RecoveredIeee80211StaNewState", "ieee80211_sta_new_state")) return false
    if (!internalFunction("esp32RecoveredIeee80211WmeStandardAcToEspAc", "ieee80211_wme_standard_ac_to_esp_ac")) return false
    if (!internalFunction("esp32RecoveredResetCsThres", "reset_cs_thres")) return false
    if (!internalFunction("esp32RecoveredSendWakeNullTimeout", "send_wake_null_timeout")) return false
    if (!internalFunction("esp32RecoveredSendWakeNullTimeoutProcess", "send_wake_null_timeout_process")) return false
    if (!internalFunction("esp32RecoveredStaAuthFt", "sta_auth_ft")) return false
    if (!internalFunction("esp32RecoveredStaAuthOpen", "sta_auth_open")) return false
    if (!internalFunction("esp32RecoveredStaAuthSae", "sta_auth_sae")) return false
    if (!internalFunction("esp32RecoveredStaAuthShared", "sta_auth_shared")) return false
    if (!internalFunction("esp32RecoveredStaBipCheck", "sta_bip_check")) return false
    if (!internalFunction("esp32RecoveredStaEapolTxdoneCb", "sta_eapol_txdone_cb")) return false
    if (!internalFunction("esp32RecoveredStaGetOweData", "sta_get_owe_data")) return false
    if (!internalFunction("esp32RecoveredStaInput", "sta_input")) return false
    if (!internalFunction("esp32RecoveredStaIs11rEnabled", "sta_is_11r_enabled")) return false
    if (!internalFunction("esp32RecoveredStaIsBssMaxIdleEnabled", "sta_is_bss_max_idle_enabled")) return false
    if (!internalFunction("esp32RecoveredStaIsWifiEntEnabled", "sta_is_wifi_ent_enabled")) return false
    if (!internalFunction("esp32RecoveredStaIsWpa3Enabled", "sta_is_wpa3_enabled")) return false
    if (!internalFunction("esp32RecoveredStaMichaelMicFailure", "sta_michael_mic_failure")) return false
    if (!internalFunction("esp32RecoveredStaRecvAssoc", "sta_recv_assoc")) return false
    if (!internalFunction("esp32RecoveredStaRecvCtl", "sta_recv_ctl")) return false
    if (!internalFunction("esp32RecoveredStaRecvMgmt", "sta_recv_mgmt")) return false
    if (!internalFunction("esp32RecoveredStaRetryAssoc", "sta_retry_assoc")) return false
    if (!internalFunction("esp32RecoveredStaRxCb", "sta_rx_cb")) return false
    if (!internalFunction("esp32RecoveredStaRxCsa", "sta_rx_csa")) return false
    if (!internalFunction("esp32RecoveredStaRxEapol", "sta_rx_eapol")) return false
    if (!internalFunction("esp32RecoveredStaSaQueryProcessTimeout", "sta_sa_query_process_timeout")) return false
    if (!internalFunction("esp32RecoveredStaSupportAutoModeConnectPassiveChannelHiddenAp", "sta_support_auto_mode_connect_passive_channel_hidden_ap")) return false
    if (!internalFunction("esp32RecoveredStaTrySaQueryProcess", "sta_try_sa_query_process")) return false
    if (!internalFunction("esp32RecoveredStaUpdatePowerOffResetFlag", "sta_update_power_off_reset_flag")) return false
    if (!internalFunction("esp32RecoveredUpdateCsThres", "update_cs_thres")) return false
    if (!exportFunction("esp32RecoveredWifiStaRegEapolTxdoneCb", "wifi_sta_reg_eapol_txdone_cb")) return false
    if (!internalFunction("esp32RecoveredWifiStaRegRxcb", "wifi_sta_reg_rxcb")) return false
    if (!internalFunction("esp32RecoveredWifiStationStart", "wifi_station_start")) return false
    if (!internalFunction("esp32RecoveredWifiStationStop", "wifi_station_stop")) return false
    true
}
