import "../../xtensa/assembly.ab"
import "abla/unsafe/memory"

// Live station subset of the off-channel controller. The 28-byte record keeps
// the exact packet-engine layout; scan/ROC orchestration stays internal until
// its remaining channel-manager callers are ported.

@naked
trusted fun esp32WifiOffChannelInProgress(): u32 = xtensaAssemblyReadU32(
    ".pushsection .bss.g_offchan_packet_lifetime,\"aw\",@nobits\n.global g_offchan_packet_lifetime\n.type g_offchan_packet_lifetime,@object\n.size g_offchan_packet_lifetime,4\ng_offchan_packet_lifetime:\n.space 4\n.popsection\n.pushsection .bss.g_offchan_ctx,\"aw\",@nobits\n.global g_offchan_ctx\n.type g_offchan_ctx,@object\n.size g_offchan_ctx,28\ng_offchan_ctx:\n.space 28\n.popsection\nentry a1, 32\nmovi a2, g_offchan_ctx\nmovi.n a8, 0\nl16ui a9, a2, 0\nmovi.n a2, 1\nmoveqz a2, a8, a9\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32WifiOffChannelReceiveAction(
    interfaceAddress: u32,
    frameAddress: u32,
    frameLength: u32,
    signal: u32
): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nmovi a8, g_offchan_ctx\nmov.n a10, a2\nmov.n a11, a3\nmov.n a12, a4\nextui a13, a5, 0, 8\nl32i.n a9, a8, 4\nmovi.n a2, -1\nbeqz.n a9, .Labla_offchan_receive_return\ncallx8 a9\nmov.n a2, a10\n.Labla_offchan_receive_return:\nretw.n",
    "~{memory}"
)

@naked
trusted fun esp32WifiOffChannelTransmitStatus(
    succeeded: u32,
    status: u32
): void = xtensaAssemblyVoid(
    "entry a1, 48\nmovi a8, g_offchan_ctx\nextui a2, a2, 0, 8\nextui a3, a3, 0, 8\nl8ui a9, a8, 0\nbeqz.n a9, .Labla_offchan_status_return\nmovi.n a10, 0\nmovi.n a9, 1\nmoveqz a9, a10, a2\ns32i.n a9, a1, 0\nmovi.n a12, 16\nmov.n a11, a1\nmovi.n a10, 19\nl32i.n a9, a8, 4\ns32i.n a9, a1, 4\nl8ui a9, a8, 12\nl8ui a8, a8, 2\ns32i.n a3, a1, 8\ns8i a9, a1, 12\ns8i a8, a1, 13\nmemw\nmemw\ncall8 wifi_event_post\n.Labla_offchan_status_return:\nretw.n",
    "~{memory}"
)

fun esp32WifiOffChannelTransmitInProgress(): bool = false
fun esp32WifiRemainOnChannelInProgress(): bool = false

trusted fun esp32WifiOffChannelMatches(channelContext: u32): i32 {
    val cell = xtensaAssemblyReadU32("movi $0, g_chm", "=a")
    val manager = u32(ablaUnsafeVolatileLoadU32(int(cell)))
    if (manager != u32(0) &&
        u32(ablaUnsafeVolatileLoadU32(int(manager) + 28)) == channelContext) {
        i32(1)
    } else i32(0)
}
