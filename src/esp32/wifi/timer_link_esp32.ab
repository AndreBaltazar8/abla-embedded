import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkTimerOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredIeee80211RegisterHostapTimer", "ieee80211_register_hostap_timer")) return false
    if (!internalFunction("esp32RecoveredIeee80211TimerDoProcess", "ieee80211_timer_do_process")) return false
    if (!exportFunction("esp32RecoveredIeee80211TimerProcess", "ieee80211_timer_process")) return false
    true
}
