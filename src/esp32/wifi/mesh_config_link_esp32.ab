import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshConfigInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMeshNvsDeinit", "esp_mesh_nvs_deinit")) return false
    if (!internalFunction("esp32RecoveredEspMeshNvsInit", "esp_mesh_nvs_init")) return false
    if (!internalFunction("esp32RecoveredEspMeshNvsOperate", "esp_mesh_nvs_operate")) return false
    if (!internalFunction("esp32RecoveredEspMeshNvsSetAssoc", "esp_mesh_nvs_set_assoc")) return false
    if (!internalFunction("esp32RecoveredEspMeshNvsSetLayer", "esp_mesh_nvs_set_layer")) return false
    if (!internalFunction("esp32RecoveredNvsOp2str", "nvs_op2str")) return false
    true
}
