import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkHtOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredIeee80211HtAttach", "ieee80211_ht_attach")) return false
    if (!internalFunction("esp32RecoveredAmpduFreeRxBaIndex", "ampdu_free_rx_ba_index")) return false
    if (!internalFunction("esp32RecoveredAmpduAllocRxBaIndex", "ampdu_alloc_rx_ba_index")) return false
    if (!internalFunction("esp32RecoveredIeee80211HtDeattach", "ieee80211_ht_deattach")) return false
    if (!internalFunction("esp32RecoveredIeee80211CalTxPps", "ieee80211_cal_tx_pps")) return false
    if (!internalFunction("esp32RecoveredIeee80211AmpduEnable", "ieee80211_ampdu_enable")) return false
    if (!internalFunction("esp32RecoveredAddbaTimeoutProcess", "addba_timeout_process")) return false
    if (!internalFunction("esp32RecoveredIeee80211AmpduRequest", "ieee80211_ampdu_request")) return false
    if (!internalFunction("esp32RecoveredIeee80211AmpduStop", "ieee80211_ampdu_stop")) return false
    if (!internalFunction("esp32RecoveredAmpduDispatch", "ampdu_dispatch")) return false
    if (!internalFunction("esp32RecoveredAmpduDispatchMovement", "ampdu_dispatch_movement")) return false
    if (!internalFunction("esp32RecoveredAmpduDispatchAsManyAsPossible", "ampdu_dispatch_as_many_as_possible")) return false
    if (!internalFunction("esp32RecoveredAmpduDispatchAll", "ampdu_dispatch_all")) return false
    if (!internalFunction("esp32RecoveredAmpduDispatchUpto", "ampdu_dispatch_upto")) return false
    if (!internalFunction("esp32RecoveredIeee80211AmpduStartAgeTimer", "ieee80211_ampdu_start_age_timer")) return false
    if (!internalFunction("esp32RecoveredIeee80211AmpduAgeAll", "ieee80211_ampdu_age_all")) return false
    if (!internalFunction("esp32RecoveredAmpduProcessMulticastAddressQosFrame", "ampdu_process_multicast_address_qos_frame")) return false
    if (!exportFunction("esp32RecoveredIeee80211AmpduReorder", "ieee80211_ampdu_reorder")) return false
    if (!internalFunction("esp32RecoveredIeee80211ProcessBarInfo", "ieee80211_process_bar_info")) return false
    if (!internalFunction("esp32RecoveredIeee80211RecvBar", "ieee80211_recv_bar")) return false
    if (!exportFunction("esp32RecoveredIeee80211HtNodeCleanup", "ieee80211_ht_node_cleanup")) return false
    if (!exportFunction("esp32RecoveredIeee80211HtNodeInit", "ieee80211_ht_node_init")) return false
    if (!internalFunction("esp32RecoveredIeee80211ParseHtcap", "ieee80211_parse_htcap")) return false
    if (!internalFunction("esp32RecoveredIeee80211HasHt40Bss", "ieee80211_has_ht40_bss")) return false
    if (!exportFunction("esp32RecoveredIeee80211UpdateChannel", "ieee80211_update_channel")) return false
    if (!exportFunction("esp32RecoveredIeee80211HtUpdatehtcap", "ieee80211_ht_updatehtcap")) return false
    if (!exportFunction("esp32RecoveredIeee80211HtUpdateparams", "ieee80211_ht_updateparams")) return false
    if (!exportFunction("esp32RecoveredIeee80211SetupHtrates", "ieee80211_setup_htrates")) return false
    if (!internalFunction("esp32RecoveredIeee80211SetupBasicHtrates", "ieee80211_setup_basic_htrates")) return false
    if (!exportFunction("esp32RecoveredIeee80211AddHtcap", "ieee80211_add_htcap")) return false
    if (!internalFunction("esp32RecoveredIeee80211AddHtcapVendor", "ieee80211_add_htcap_vendor")) return false
    if (!internalFunction("esp32RecoveredIeee80211AddHtinfoBody", "ieee80211_add_htinfo_body")) return false
    if (!internalFunction("esp32RecoveredIeee80211AddHtinfo", "ieee80211_add_htinfo")) return false
    if (!internalFunction("esp32RecoveredIeee80211AddHtinfoVendor", "ieee80211_add_htinfo_vendor")) return false
    if (!internalFunction("esp32RecoveredHtActionOutput", "ht_action_output")) return false
    if (!internalFunction("esp32RecoveredIeee80211Decap1", "ieee80211_decap1")) return false
    if (!internalFunction("esp32RecoveredIeee80211DecapAmsdu", "ieee80211_decap_amsdu")) return false
    if (!exportFunction("esp32RecoveredHostapHtOperationUpdate", "hostap_ht_operation_update")) return false
    true
}
