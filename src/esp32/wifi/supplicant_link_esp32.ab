import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkSupplicantOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspWifiAuthDoneInternal", "esp_wifi_auth_done_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiDeauthenticateInternal", "esp_wifi_deauthenticate_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiEnableSaePkOnlyModeInternal", "esp_wifi_enable_sae_pk_only_mode_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiGetConfigSaePweH2eInternal", "esp_wifi_get_config_sae_pwe_h2e_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiGetMacaddrInternal", "esp_wifi_get_macaddr_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiGetSppAttrubuteInternal", "esp_wifi_get_spp_attrubute_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiGetStaKeyInternal", "esp_wifi_get_sta_key_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiGetUserInitFlagInternal", "esp_wifi_get_user_init_flag_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiRegisterEapolTxdonecbInternal", "esp_wifi_register_eapol_txdonecb_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiRegisterMgmtFrameInternal", "esp_wifi_register_mgmt_frame_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiRegisterWpaCbInternal", "esp_wifi_register_wpa_cb_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiSetAppieInternal", "esp_wifi_set_appie_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiSetIgtkInternal", "esp_wifi_set_igtk_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiSetStaKeyInternal", "esp_wifi_set_sta_key_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaConnectInternal", "esp_wifi_sta_connect_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaDisableOweTransInternal", "esp_wifi_sta_disable_owe_trans_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaDisableSaePkInternal", "esp_wifi_sta_disable_sae_pk_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaDisableWpa2AuthmodeInternal", "esp_wifi_sta_disable_wpa2_authmode_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaGetApInfoProfPmkInternal", "esp_wifi_sta_get_ap_info_prof_pmk_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaGetGroupCipherInternal", "esp_wifi_sta_get_group_cipher_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaGetIe", "esp_wifi_sta_get_ie")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaGetMgmtGroupCipher", "esp_wifi_sta_get_mgmt_group_cipher")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaGetPairwiseCipherInternal", "esp_wifi_sta_get_pairwise_cipher_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaGetProfAuthmodeInternal", "esp_wifi_sta_get_prof_authmode_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaGetProfPasswordInternal", "esp_wifi_sta_get_prof_password_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaGetProfSsidInternal", "esp_wifi_sta_get_prof_ssid_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaGetResetNvsPmkInternal", "esp_wifi_sta_get_reset_nvs_pmk_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaIsApNotifyCompletedRsneInternal", "esp_wifi_sta_is_ap_notify_completed_rsne_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaPmfEnabled", "esp_wifi_sta_pmf_enabled")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaProfIsRsnInternal", "esp_wifi_sta_prof_is_rsn_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaProfIsWapiInternal", "esp_wifi_sta_prof_is_wapi_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaProfIsWpaInternal", "esp_wifi_sta_prof_is_wpa_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaSetResetNvsPmkInternal", "esp_wifi_sta_set_reset_nvs_pmk_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiStaUpdateApInfoInternal", "esp_wifi_sta_update_ap_info_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiUnregisterWpaCbInternal", "esp_wifi_unregister_wpa_cb_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiUnsetAppieInternal", "esp_wifi_unset_appie_internal")) return false
    if (!exportFunction("esp32RecoveredEspWifiUseSuppPmkCache", "esp_wifi_use_supp_pmk_cache")) return false
    if (!internalFunction("esp32RecoveredIeee80211GetKey", "ieee80211_get_key")) return false
    if (!internalFunction("esp32RecoveredIeee80211GetSpp", "ieee80211_get_spp")) return false
    if (!internalFunction("esp32RecoveredIeee80211SetKey", "ieee80211_set_key")) return false
    if (!internalFunction("esp32RecoveredIeee80211SetStaGtkIndex", "ieee80211_set_sta_gtk_index")) return false
    if (!exportFunction("esp32RecoveredIeee80211StaIsConnected", "ieee80211_sta_is_connected")) return false
    if (!internalFunction("esp32RecoveredIeee80211wGetActiveIgtkKeyId", "ieee80211w_get_active_igtk_key_id")) return false
    if (!internalFunction("esp32RecoveredIeee80211wGetIgtkFromKeyidx", "ieee80211w_get_igtk_from_keyidx")) return false
    if (!internalFunction("esp32RecoveredPpInstallKey", "ppInstallKey")) return false
    if (!internalFunction("esp32RecoveredWifiInitKey", "wifi_init_key")) return false
    if (!exportFunction("esp32RecoveredWifiSetRxPolicy", "wifi_set_rx_policy")) return false
    if (!internalFunction("esp32RecoveredWifiStaConnectInternalProcess", "wifi_sta_connect_internal_process")) return false
    if (!internalFunction("esp32RecoveredWifiStaGetProfPassword", "wifi_sta_get_prof_password")) return false
    true
}
