import "abla/unsafe/memory"
import "abla/unsafe/native"
import "ieee80211_debug_esp32.ab"

@inline
trusted fun esp32WifiLogArgument(arguments:u32,index:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(arguments + index * u32(4)))))

trusted fun esp32WifiLogProfileAdapter(arguments:u32):u32 {
    esp32WifiLog(
        esp32WifiLogArgument(arguments,u32(0)),
        esp32WifiLogArgument(arguments,u32(1)),
        esp32WifiLogArgument(arguments,u32(2)),
        esp32WifiLogArgument(arguments,u32(3)),
        esp32WifiLogArgument(arguments,u32(4)),
        esp32WifiLogArgument(arguments,u32(5)),
        esp32WifiLogArgument(arguments,u32(6)),
        esp32WifiLogArgument(arguments,u32(7)),
        esp32WifiLogArgument(arguments,u32(8)),
        esp32WifiLogArgument(arguments,u32(9)),
        esp32WifiLogArgument(arguments,u32(10)),
        esp32WifiLogArgument(arguments,u32(11)),
        esp32WifiLogArgument(arguments,u32(12)),
        esp32WifiLogArgument(arguments,u32(13)),
        esp32WifiLogArgument(arguments,u32(14)),
        esp32WifiLogArgument(arguments,u32(15))
    )
    u32(0)
}

trusted fun esp32EnableWifiLogging():void {
    esp32ConfigureWifiLogHook(u32(nativeFunctionAddress(esp32WifiLogProfileAdapter)))
    return
}
