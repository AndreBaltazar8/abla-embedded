import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshCommonInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMeshApEnqueue", "esp_mesh_ap_enqueue")) return false
    if (!internalFunction("esp32RecoveredEspMeshApListClear", "esp_mesh_ap_list_clear")) return false
    if (!internalFunction("esp32RecoveredEspMeshApListClearExpire", "esp_mesh_ap_list_clear_expire")) return false
    if (!internalFunction("esp32RecoveredEspMeshApListClearInvalid", "esp_mesh_ap_list_clear_invalid")) return false
    if (!internalFunction("esp32RecoveredEspMeshApListFind", "esp_mesh_ap_list_find")) return false
    if (!internalFunction("esp32RecoveredEspMeshApListFindExpire", "esp_mesh_ap_list_find_expire")) return false
    if (!internalFunction("esp32RecoveredEspMeshApListFindInvalid", "esp_mesh_ap_list_find_invalid")) return false
    if (!internalFunction("esp32RecoveredEspMeshApListUpdateInvalid", "esp_mesh_ap_list_update_invalid")) return false
    true
}
