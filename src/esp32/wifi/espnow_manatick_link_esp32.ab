import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkEspNowManatickInternals(): bool {
    if (!internalFunction("esp32RecoveredMtAddPeer", "mt_add_peer")) return false
    if (!internalFunction("esp32RecoveredMtDeinit", "mt_deinit")) return false
    if (!internalFunction("esp32RecoveredMtDelPeer", "mt_del_peer")) return false
    if (!internalFunction("esp32RecoveredMtFetchPeer", "mt_fetch_peer")) return false
    if (!internalFunction("esp32RecoveredMtGetPeer", "mt_get_peer")) return false
    if (!internalFunction("esp32RecoveredMtGetPeerInfo", "mt_get_peer_info")) return false
    if (!internalFunction("esp32RecoveredMtGetPeerNum", "mt_get_peer_num")) return false
    if (!internalFunction("esp32RecoveredMtGetUserOui", "mt_get_user_oui")) return false
    if (!internalFunction("esp32RecoveredMtGetVersion", "mt_get_version")) return false
    if (!internalFunction("esp32RecoveredMtInit", "mt_init")) return false
    if (!internalFunction("esp32RecoveredMtIsPeerExist", "mt_is_peer_exist")) return false
    if (!internalFunction("esp32RecoveredMtModPeer", "mt_mod_peer")) return false
    if (!internalFunction("esp32RecoveredMtRegisterRecvCb", "mt_register_recv_cb")) return false
    if (!internalFunction("esp32RecoveredMtRegisterSendCb", "mt_register_send_cb")) return false
    if (!internalFunction("esp32RecoveredMtSend", "mt_send")) return false
    if (!internalFunction("esp32RecoveredMtSetPeerRateConfig", "mt_set_peer_rate_config")) return false
    if (!internalFunction("esp32RecoveredMtSetPmk", "mt_set_pmk")) return false
    if (!internalFunction("esp32RecoveredMtSetUserOui", "mt_set_user_oui")) return false
    if (!internalFunction("esp32RecoveredMtSetWakeWindow", "mt_set_wake_window")) return false
    if (!internalFunction("esp32RecoveredMtUnregisterRecvCb", "mt_unregister_recv_cb")) return false
    if (!internalFunction("esp32RecoveredMtUnregisterSendCb", "mt_unregister_send_cb")) return false
    true
}
