import "abla/runtime/scalar"

// Fail-closed placeholder for a recovered switch whose code-address table has
// not been lowered to Abla control flow yet (see tools/check-recovered-bug-classes,
// class 8). The original `jx` jumped into the middle of the function; the
// committed structured form no longer contains those targets, so running the
// table would execute unrelated code. Trap instead of mis-dispatching.
trusted fun esp32UnloweredSwitchTrap(): u32 {
    ablaRuntimeTrap()
    u32(0)
}
