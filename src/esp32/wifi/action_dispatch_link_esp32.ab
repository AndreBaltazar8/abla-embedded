import "abla/build"

// Complete ieee80211_action.o ABI. Both invalid-category handlers and every
// send/receive callback table live in the Abla unit; no opaque caller remains.
compile fun esp32Idf6LinkActionDispatchInternals(): bool {
    if (!internalFunction("esp32Ieee80211ReceiveAction", "ieee80211_recv_action")) return false
    if (!internalFunction("esp32Ieee80211ReceiveActionRegister", "ieee80211_recv_action_register")) return false
    if (!internalFunction("esp32Ieee80211ReceiveActionUnregister", "ieee80211_recv_action_unregister")) return false
    if (!internalFunction("esp32Ieee80211SendAction", "ieee80211_send_action")) return false
    if (!internalFunction("esp32Ieee80211SendActionRegister", "ieee80211_send_action_register")) return false
    if (!internalFunction("esp32Ieee80211SendActionUnregister", "ieee80211_send_action_unregister")) return false
    true
}
