import "../../wifi/ieee80211_protocol_logic.ab"
import "../../xtensa/assembly.ab"

// Complete classic-ESP32 ieee80211_proto.o compatibility surface. Protocol
// decisions are ordinary Abla; this file owns only the exact vendor record
// offsets and callback ABI still supplied by the neighboring radio objects.

@inline
trusted fun esp32Ieee80211TxManagementCallbackAddress(): u32 =
    xtensaAssemblyReadU32("movi $0, ieee80211_tx_mgt_cb", "=a")

@inline
trusted fun esp32Ieee80211ImproveContentionAddress(): u32 =
    xtensaAssemblyReadU32(
        "movi $0, g_wifi_improve_contention_ability", "=a"
    )

@inline
trusted fun esp32Ieee80211GlobalInterfaceAddress(): u32 =
    xtensaAssemblyReadU32("movi $0, g_ic", "=a")

@inline
trusted fun esp32Ieee80211ConnectMessageAddress(): u32 =
    xtensaAssemblyReadU32(
        "movi $0, .Labla_ieee80211_connect_message", "=a"
    )

@inline
trusted fun esp32Ieee80211LoadU8(address: int): int =
    int(xtensaAssemblyReadU32WithU32(
        "l8ui $0, $1, 0", "=a,a", u32(address)
    ))

@inline
trusted fun esp32Ieee80211LoadU16(address: int): int =
    int(xtensaAssemblyReadU32WithU32(
        "l16ui $0, $1, 0", "=a,a", u32(address)
    ))

@inline
trusted fun esp32Ieee80211LoadU32(address: int): int =
    int(xtensaAssemblyReadU32WithU32(
        "l32i $0, $1, 0", "=a,a", u32(address)
    ))

@inline
trusted fun esp32Ieee80211StoreU8(address: int, value: int): void =
    xtensaAssemblyWriteU32U32(
        "s8i $1, $0, 0", "a,a,~{memory}", u32(address), u32(value)
    )

@inline
trusted fun esp32Ieee80211StoreU16(address: int, value: int): void =
    xtensaAssemblyWriteU32U32(
        "s16i $1, $0, 0", "a,a,~{memory}", u32(address), u32(value)
    )

@inline
trusted fun esp32Ieee80211StoreU32(address: int, value: int): void =
    xtensaAssemblyWriteU32U32(
        "s32i $1, $0, 0", "a,a,~{memory}", u32(address), u32(value)
    )

@inline
trusted fun esp32Ieee80211SetAccessCategory(
    category: u32,
    arbitrationSpacing: u32,
    minimumWindow: u32,
    maximumWindow: u32,
    transmitOpportunity: u32
): void {
    xtensaAssemblyCallVoid5(
        "call8 ic_set_ac_param",
        "{a10},{a11},{a12},{a13},{a14},~{a8},~{a9},~{a15},~{memory}",
        category,
        arbitrationSpacing,
        minimumWindow,
        maximumWindow,
        transmitOpportunity
    )
    return
}

@export("ieee80211_proto_attach")
trusted fun esp32Ieee80211ProtocolAttach(interfaceAddress: u32): void {
    // The one-byte public setting is part of this archive member's ABI. A
    // target-assembly data definition lets the vendor API write it without
    // compiler machinery specific to ESP32 globals.
    xtensaAssemblyVoid(
        ".pushsection .bss.g_wifi_improve_contention_ability,\"aw\",@nobits\n.global g_wifi_improve_contention_ability\n.type g_wifi_improve_contention_ability,@object\n.size g_wifi_improve_contention_ability,1\ng_wifi_improve_contention_ability:\n.space 1\n.popsection\n.pushsection .rodata.abla_ieee80211_connect_message,\"a\",@progbits\n.Labla_ieee80211_connect_message:\n.asciz \"connect_bss: auth=%d, reconnect=%d\"\n.popsection",
        "~{memory}"
    )
    val interfacePointer = int(interfaceAddress)
    esp32Ieee80211StoreU32(interfacePointer + 12, 1)
    esp32Ieee80211StoreU32(
        interfacePointer + 28,
        esp32Ieee80211LoadU32(interfacePointer + 28) | 262144
    )
    xtensaAssemblyCallVoid3(
        "call8 ic_register_tx_cb",
        "{a10},{a11},{a12},~{a8},~{a9},~{a13},~{a14},~{a15},~{memory}",
        esp32Ieee80211TxManagementCallbackAddress(),
        u32(2),
        u32(0)
    )
    return
}

@export("ieee80211_gettid")
trusted fun esp32Ieee80211GetTrafficIdentifier(frameAddress: u32): i32 {
    val kind = ieee80211TrafficIdentifierKind(
        int(xtensaAssemblyReadU32WithU32(
            "l8ui $0, $1, 0", "=a,a", frameAddress
        ))
    )
    if (kind >= 0) return i32(kind)
    val offset = ieee80211QosOffset(
        int(xtensaAssemblyReadU32WithU32(
            "l8ui $0, $1, 1", "=a,a", frameAddress
        ))
    )
    val qos = if (offset == 30) xtensaAssemblyReadU32WithU32(
        "l8ui $0, $1, 30", "=a,a", frameAddress
    ) else xtensaAssemblyReadU32WithU32(
        "l8ui $0, $1, 24", "=a,a", frameAddress
    )
    i32(int(qos) & 15)
}

@export("ieee80211_set_shortslottime")
trusted fun esp32Ieee80211SetShortSlotTime(
    interfaceAddress: u32,
    enabled: i32
): void {
    val address = int(interfaceAddress) + 28
    esp32Ieee80211StoreU32(
        address,
        ieee80211ShortSlotCapabilities(
            esp32Ieee80211LoadU32(address), enabled != i32(0)
        )
    )
    return
}

trusted fun esp32Ieee80211ErpRatePresent(
    rateSetAddress: u32,
    count: u32,
    required: int
): bool {
    var rateIndex = u32(0)
    while (rateIndex < count) {
        val rate = esp32Ieee80211LoadU8(int(
            rateSetAddress + u32(1) + rateIndex
        )) & 127
        if (required == rate) return true
        if (required < rate) return false
        rateIndex = rateIndex + u32(1)
    }
    false
}

@export("ieee80211_iserp_rateset")
trusted fun esp32Ieee80211IsErpRateSet(rateSetAddress: u32): i32 {
    val count = u32(esp32Ieee80211LoadU8(int(rateSetAddress)))
    if (count < u32(ieee80211ErpRateCount)) return i32(0)
    if (!esp32Ieee80211ErpRatePresent(rateSetAddress, count, 2)) return i32(0)
    if (!esp32Ieee80211ErpRatePresent(rateSetAddress, count, 4)) return i32(0)
    if (!esp32Ieee80211ErpRatePresent(rateSetAddress, count, 11)) return i32(0)
    if (!esp32Ieee80211ErpRatePresent(rateSetAddress, count, 22)) return i32(0)
    if (!esp32Ieee80211ErpRatePresent(rateSetAddress, count, 12)) return i32(0)
    if (!esp32Ieee80211ErpRatePresent(rateSetAddress, count, 24)) return i32(0)
    if (!esp32Ieee80211ErpRatePresent(rateSetAddress, count, 48)) return i32(0)
    i32(1)
}

@export("ieee80211_wme_initparams")
fun esp32Ieee80211InitializeWmeParameters(interfaceAddress: u32): void {
    return
}

@export("ieee80211_wme_updateparams")
trusted fun esp32Ieee80211UpdateWmeParameters(
    interfaceAddress: u32,
    parametersAddress: u32
): void {
    var category = u32(0)
    val categoryCount = xtensaAssemblyReadU32("movi $0, 4", "=a")
    var parameter = parametersAddress + u32(3)
    while (category < categoryCount) {
        val spacing = esp32Ieee80211LoadU8(int(parameter))
        val minimum = esp32Ieee80211LoadU8(int(parameter + u32(1)))
        val maximum = esp32Ieee80211LoadU8(int(parameter + u32(2)))
        if (ieee80211ContentionParameterValid(spacing, minimum, maximum)) {
            esp32Ieee80211SetAccessCategory(
                category,
                u32(spacing),
                u32(minimum),
                u32(maximum),
                u32(esp32Ieee80211LoadU8(int(parameter + u32(3))))
            )
        }
        category = category + u32(1)
        parameter = parameter + u32(7)
    }
    val improveAddress = int(esp32Ieee80211ImproveContentionAddress())
    if (esp32Ieee80211LoadU8(improveAddress) != 0) {
        esp32Ieee80211SetAccessCategory(
            u32(2), u32(2), u32(2), u32(3), u32(1504)
        )
    }
    return
}

@export("ieee80211_mlme_connect_bss")
trusted fun esp32Ieee80211ConnectBss(
    bssAddress: u32,
    authenticationValue: u32,
    reconnectValue: u32
): void {
    val authentication = int(authenticationValue) & 255
    val reconnect = int(reconnectValue) & 255
    val globalInterface = esp32Ieee80211GlobalInterfaceAddress()
    val station = xtensaAssemblyReadU32WithU32(
        "l32i $0, $1, 16", "=a,a", globalInterface
    )
    xtensaAssemblyWriteU32U32(
        "s32i $1, $0, 228", "a,a,~{memory}", station, bssAddress
    )
    val peerLow = xtensaAssemblyReadU32WithU32(
        "l32i $0, $1, 4", "=a,a", bssAddress
    )
    xtensaAssemblyWriteU32U32(
        "s32i $1, $0, 156", "a,a,~{memory}", station, peerLow
    )
    val peerHigh = xtensaAssemblyReadU32WithU32(
        "l16ui $0, $1, 8", "=a,a", bssAddress
    )
    xtensaAssemblyWriteU32U32(
        "s16i $1, $0, 160", "a,a,~{memory}", station, peerHigh
    )
    xtensaAssemblyCallVoid6(
        "call8 wifi_log",
        "{a10},{a11},{a12},{a13},{a14},{a15},~{a8},~{a9},~{memory}",
        u32(1),
        u32(4),
        u32(4),
        esp32Ieee80211ConnectMessageAddress(),
        u32(reconnect),
        u32(authentication)
    )
    xtensaAssemblyCallVoid3(
        "call8 ieee80211_sta_new_state",
        "{a10},{a11},{a12},~{a8},~{a9},~{a13},~{a14},~{a15},~{memory}",
        globalInterface,
        u32(ieee80211ConnectState(reconnect)),
        u32(ieee80211ConnectArgument(authentication, reconnect))
    )
    return
}
