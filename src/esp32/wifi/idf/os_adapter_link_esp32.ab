import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWifiOsAdapterInternals(): bool {
    if (!internalFunction("esp32RecoveredWifiMalloc", "wifi_malloc")) return false
    if (!internalFunction("esp32RecoveredWifiRealloc", "wifi_realloc")) return false
    if (!internalFunction("esp32RecoveredWifiCalloc", "wifi_calloc")) return false
    if (!internalFunction("esp32RecoveredWifiCreateQueue", "wifi_create_queue")) return false
    if (!internalFunction("esp32RecoveredWifiDeleteQueue", "wifi_delete_queue")) return false
    true
}
