import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWifiInitInternals(): bool {
    if (!internalFunction("esp32RecoveredEspWifiDeinit", "esp_wifi_deinit")) return false
    if (!internalFunction("esp32RecoveredEspWifiInit", "esp_wifi_init")) return false
    if (!internalFunction("esp32RecoveredEspWifiConnect", "esp_wifi_connect")) return false
    if (!internalFunction("esp32RecoveredEspWifiDisconnect", "esp_wifi_disconnect")) return false
    if (!internalFunction("esp32RecoveredIeee80211FtmAttach", "ieee80211_ftm_attach")) return false
    if (!internalFunction("esp32RecoveredFtmInitiatorCleanup", "ftm_initiator_cleanup")) return false
    if (!internalFunction("esp32RecoveredWifiNanSetConfigLocal", "wifi_nan_set_config_local")) return false
    if (!internalFunction("esp32RecoveredNanNdpRespTimeoutProcess", "nan_ndp_resp_timeout_process")) return false
    true
}
