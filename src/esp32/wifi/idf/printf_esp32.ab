import "abla/unsafe/memory"

// Wi-Fi variadic logging adapters. The wide entry ABI is retained because the
// vendor-facing symbols are variadic; formatting and trimming are ordinary Abla.
val esp32WifiPrintfFormatStorage = nativeStaticBytes("\x49\x20\x28\x25\x6c\x75\x29\x20\x25\x73\x3a\x20\x25\x73\x0a\x00")
val esp32WifiPrintfFormat = u32(esp32WifiPrintfFormatStorage)
val esp32WifiPrintfPpTagStorage = nativeStaticBytes("\x00\x00\x00")
val esp32WifiPrintfPpTag = u32(esp32WifiPrintfPpTagStorage)
val esp32WifiPrintfSmartConfigTagStorage = nativeStaticBytes("\x73\x6d\x61\x72\x74\x63\x6f\x6e\x66\x69\x67\x00")
val esp32WifiPrintfSmartConfigTag = u32(esp32WifiPrintfSmartConfigTagStorage)
val esp32WifiPrintfCoreTagStorage = nativeStaticBytes("\x63\x6f\x72\x65\x00")
val esp32WifiPrintfCoreTag = u32(esp32WifiPrintfCoreTagStorage)
val esp32WifiPrintfNet80211TagStorage = nativeStaticBytes("\x6e\x65\x74\x38\x30\x32\x31\x31\x00")
val esp32WifiPrintfNet80211Tag = u32(esp32WifiPrintfNet80211TagStorage)
val esp32WifiPrintfTargetTagStorage = nativeStaticBytes("\x74\x61\x72\x67\x00")
val esp32WifiPrintfTargetTag = u32(esp32WifiPrintfTargetTagStorage)
val esp32WifiPrintfWapiTagStorage = nativeStaticBytes("\x77\x61\x70\x69\x00")
val esp32WifiPrintfWapiTag = u32(esp32WifiPrintfWapiTagStorage)
val esp32WifiPrintfMeshTagStorage = nativeStaticBytes("\x6d\x65\x73\x68\x00")
val esp32WifiPrintfMeshTag = u32(esp32WifiPrintfMeshTagStorage)

trusted fun esp32WifiPrintfFormatted(tag:u32,format:u32,overflowArguments:u32,registerArguments:u32,registerOffset:u32):u32 {
    // These legacy callbacks carry vendor diagnostics only. Release builds
    // leave application status/error output enabled and erase this formatter.
    u32(0)
}

trusted fun esp32WifiPrintfDispatch(
    tag:u32,format:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    val arguments = u32(nativeStackAllocate(88))
    val registerArguments = arguments + u32(16)
    val overflowArguments = arguments + u32(48)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments)),int(overflowArguments))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(4))),int(registerArguments))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(8))),4)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(20))),int(a3))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(24))),int(a4))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(28))),int(a5))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(32))),int(a6))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(36))),int(a7))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(48))),int(s0))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(52))),int(s1))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(56))),int(s2))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(60))),int(s3))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(64))),int(s4))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(68))),int(s5))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(72))),int(s6))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(76))),int(s7))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(80))),int(s8))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(arguments + u32(84))),int(s9))
    esp32WifiPrintfFormatted(tag,format,overflowArguments,registerArguments,u32(4))
}

trusted fun esp32RecoveredPpPrintf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32WifiPrintfDispatch(esp32WifiPrintfPpTag,a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
trusted fun esp32RecoveredScPrintf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32WifiPrintfDispatch(esp32WifiPrintfSmartConfigTag,a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
trusted fun esp32RecoveredCorePrintf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32WifiPrintfDispatch(esp32WifiPrintfCoreTag,a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
trusted fun esp32RecoveredNet80211Printf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32WifiPrintfDispatch(esp32WifiPrintfNet80211Tag,a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
trusted fun esp32RecoveredTargetPrintf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32WifiPrintfDispatch(esp32WifiPrintfTargetTag,a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
trusted fun esp32RecoveredWapiPrintf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32WifiPrintfDispatch(esp32WifiPrintfWapiTag,a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
trusted fun esp32RecoveredMeshPrintf(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 = esp32WifiPrintfDispatch(esp32WifiPrintfMeshTag,a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
