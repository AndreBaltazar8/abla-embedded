import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWifiMeshEventInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMeshSendEventInternal", "esp_mesh_send_event_internal")) return false
    true
}
