import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWifiNetifDriverInternals(): bool {
    if (!internalFunction("esp32RecoveredEspWifiDestroyIfDriver", "esp_wifi_destroy_if_driver")) return false
    if (!internalFunction("esp32RecoveredEspWifiCreateIfDriver", "esp_wifi_create_if_driver")) return false
    if (!internalFunction("esp32RecoveredEspWifiGetIfMac", "esp_wifi_get_if_mac")) return false
    if (!internalFunction("esp32RecoveredEspWifiIsIfReadyWhenStarted", "esp_wifi_is_if_ready_when_started")) return false
    if (!internalFunction("esp32RecoveredEspWifiRegisterIfRxcb", "esp_wifi_register_if_rxcb")) return false
    true
}
