import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWifiPrintfInternals(): bool {
    if (!internalFunction("esp32RecoveredPpPrintf", "pp_printf")) return false
    if (!internalFunction("esp32RecoveredScPrintf", "sc_printf")) return false
    if (!internalFunction("esp32RecoveredCorePrintf", "core_printf")) return false
    if (!internalFunction("esp32RecoveredNet80211Printf", "net80211_printf")) return false
    if (!internalFunction("esp32RecoveredTargetPrintf", "target_printf")) return false
    if (!internalFunction("esp32RecoveredWapiPrintf", "wapi_printf")) return false
    if (!internalFunction("esp32RecoveredMeshPrintf", "mesh_printf")) return false
    true
}
