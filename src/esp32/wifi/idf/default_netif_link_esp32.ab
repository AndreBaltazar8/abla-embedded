import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkWifiDefaultNetifInternals(): bool {
    if (!internalFunction("esp32RecoveredEspWifiSetDefaultWifiStaHandlers", "esp_wifi_set_default_wifi_sta_handlers")) return false
    if (!internalFunction("esp32RecoveredEspWifiSetDefaultWifiApHandlers", "esp_wifi_set_default_wifi_ap_handlers")) return false
    if (!internalFunction("esp32RecoveredEspWifiSetDefaultWifiNanHandlers", "esp_wifi_set_default_wifi_nan_handlers")) return false
    if (!internalFunction("esp32RecoveredEspWifiClearDefaultWifiDriverAndHandlers", "esp_wifi_clear_default_wifi_driver_and_handlers")) return false
    if (!internalFunction("esp32RecoveredEspNetifAttachWifiStation", "esp_netif_attach_wifi_station")) return false
    if (!internalFunction("esp32RecoveredEspNetifCreateDefaultWifiSta", "esp_netif_create_default_wifi_sta")) return false
    if (!internalFunction("esp32RecoveredEspNetifDestroyDefaultWifi", "esp_netif_destroy_default_wifi")) return false
    if (!internalFunction("esp32RecoveredEspNetifCreateWifi", "esp_netif_create_wifi")) return false
    true
}
