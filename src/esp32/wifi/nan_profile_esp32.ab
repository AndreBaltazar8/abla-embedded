trusted fun esp32EnableNanProfile():void {
    esp32ConfigureNanProfile(
        u32(nativeFunctionAddress(esp32NanProfileDestroy)),
        u32(nativeFunctionAddress(esp32NanProfileStop)),
        u32(nativeFunctionAddress(esp32NanProfilePostTx)),
        u32(nativeFunctionAddress(esp32NanProfileSearchNode)),
        u32(nativeFunctionAddress(esp32NanProfilePacketValid)),
        u32(nativeFunctionAddress(esp32NanProfileRxData)),
        u32(nativeFunctionAddress(esp32NanProfileRegisterRx)),
        u32(nativeFunctionAddress(esp32NanProfileClusterId))
    )
    esp32ConfigureWifiTimerCallback(u32(25), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_warmup_timeout_84c40f064c)))
    esp32ConfigureWifiTimerCallback(u32(26), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_scan_timeout_6b867ce064)))
    esp32ConfigureWifiTimerCallback(u32(27), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_dw_start_db40102acb)))
    esp32ConfigureWifiTimerCallback(u32(28), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_dw_end_d40f9e60d8)))
    esp32ConfigureWifiTimerCallback(u32(29), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_send_disc_bcn_06c9d223be)))
    esp32ConfigureWifiTimerCallback(u32(30), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_send_sync_bcn_da39334347)))
    esp32ConfigureWifiTimerCallback(u32(31), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_send_action_d2bfc877b2)))
    esp32ConfigureWifiTimerCallback(u32(32), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_faw_start_dcb048e34b)))
    esp32ConfigureWifiTimerCallback(u32(33), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_faw_end_fc8c2b6150)))
    esp32ConfigureWifiTimerCallback(u32(34), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_ndc_start_abc9a5551a)))
    esp32ConfigureWifiTimerCallback(u32(35), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_ndp_setup_timeout_e84fb687a5)))
    esp32ConfigureWifiTimerCallback(u32(36), u32(nativeFunctionAddress(esp32Internal_Labla_recovered_timer_local_text_ieee80211_nan_ndp_inactive_timeout_0670763ec1)))
    return
}
