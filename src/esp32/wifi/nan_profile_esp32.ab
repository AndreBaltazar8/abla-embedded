// Narrow ABI adapters keep the optional dispatch table independent from the
// mechanically recovered sixteen-register function signatures.
trusted fun esp32NanProfileDestroy(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32
):u32 = esp32RecoveredWifiDestroyNan(
    a2,a3,a4,a5,a6,a7,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0))

