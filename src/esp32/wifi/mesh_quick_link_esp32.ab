import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshQuickInternals(): bool {
    if (!internalFunction("esp32RecoveredIeee80211MeshQuickDeinit", "ieee80211_mesh_quick_deinit")) return false
    if (!internalFunction("esp32RecoveredIeee80211MeshQuickInit", "ieee80211_mesh_quick_init")) return false
    if (!internalFunction("esp32RecoveredIeee80211PublicActionRecvMeshAwake", "ieee80211_public_action_recv_mesh_awake")) return false
    if (!internalFunction("esp32RecoveredIeee80211PublicActionSendMeshAwake", "ieee80211_public_action_send_mesh_awake")) return false
    if (!internalFunction("esp32RecoveredIeee80211VndMeshFullyAssociated", "ieee80211_vnd_mesh_fully_associated")) return false
    if (!internalFunction("esp32RecoveredIeee80211VndMeshUpdateBeacon", "ieee80211_vnd_mesh_update_beacon")) return false
    if (!internalFunction("esp32RecoveredIsEspMeshAssoc", "is_esp_mesh_assoc")) return false
    true
}
