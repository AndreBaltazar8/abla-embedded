import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshUtilitiesInternals(): bool {
    if (!internalFunction("esp32RecoveredDiscnxReasonId2str", "discnx_reason_id2str")) return false
    if (!internalFunction("esp32RecoveredDutytype2str", "dutytype2str")) return false
    if (!internalFunction("esp32RecoveredEspMeshCreateContext", "esp_mesh_create_context")) return false
    if (!internalFunction("esp32RecoveredEspMeshCreateMbox", "esp_mesh_create_mbox")) return false
    if (!internalFunction("esp32RecoveredEspMeshFreeContext", "esp_mesh_free_context")) return false
    if (!internalFunction("esp32RecoveredEspMeshFreeMbox", "esp_mesh_free_mbox")) return false
    if (!internalFunction("esp32RecoveredIoCfg2str", "io_cfg2str")) return false
    if (!internalFunction("esp32RecoveredMeshCreateTask", "mesh_create_task")) return false
    if (!internalFunction("esp32RecoveredMeshFree", "mesh_free")) return false
    if (!internalFunction("esp32RecoveredMeshIeType2str", "mesh_ie_type2str")) return false
    if (!internalFunction("esp32RecoveredMeshMalloc", "mesh_malloc")) return false
    if (!internalFunction("esp32RecoveredMeshMutexLock", "mesh_mutex_lock")) return false
    if (!internalFunction("esp32RecoveredMeshMutexUnlock", "mesh_mutex_unlock")) return false
    if (!internalFunction("esp32RecoveredNwkEventId2str", "nwk_event_id2str")) return false
    if (!internalFunction("esp32RecoveredOptType2str", "opt_type2str")) return false
    if (!internalFunction("esp32RecoveredReconnectType2str", "reconnect_type2str")) return false
    if (!internalFunction("esp32RecoveredScanStatus2str", "scan_status2str")) return false
    if (!internalFunction("esp32RecoveredTxMsgId2str", "tx_msg_id2str")) return false
    if (!internalFunction("esp32RecoveredTxStateId2str", "tx_state_id2str")) return false
    if (!internalFunction("esp32RecoveredTxWifiErr2str", "tx_wifi_err2str")) return false
    if (!internalFunction("esp32RecoveredTxqOpr2str", "txq_opr2str")) return false
    if (!internalFunction("esp32RecoveredVoteDone2str", "vote_done2str")) return false
    if (!internalFunction("esp32RecoveredVoteStart2str", "vote_start2str")) return false
    if (!internalFunction("esp32RecoveredWifiEventId2str", "wifi_event_id2str")) return false
    true
}
