    if (!internalFunction("esp32RecoveredIeee80211OutputProcess", "ieee80211_output_process")) return false
    if (!internalFunction("esp32RecoveredIeee80211EncapAmsdu", "ieee80211_encap_amsdu")) return false
    if (!internalFunction("esp32RecoveredIeee80211OutputInit", "ieee80211_output_init")) return false
