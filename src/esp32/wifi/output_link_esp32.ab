import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkOutputOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredIeee80211AddTieParam", "ieee80211_add_tie_param")) return false
    if (!internalFunction("esp32RecoveredEspWifiInternalTxIsStop", "esp_wifi_internal_tx_is_stop")) return false
