    if (!internalFunction("esp32RecoveredEspMeshPrintRouteTable", "esp_mesh_print_route_table")) return false
    if (!internalFunction("esp32RecoveredEspMeshProcessRedundantSubchildren", "esp_mesh_process_redundant_subchildren")) return false
