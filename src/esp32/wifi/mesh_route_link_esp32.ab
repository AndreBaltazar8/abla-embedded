    if (!internalFunction("esp32RecoveredEspMeshIeUpdateCapacity", "esp_mesh_ie_update_capacity")) return false
    if (!internalFunction("esp32RecoveredEspMeshLookupRoute", "esp_mesh_lookup_route")) return false
    if (!internalFunction("esp32RecoveredEspMeshLookupSubRoute", "esp_mesh_lookup_sub_route")) return false
    if (!internalFunction("esp32RecoveredEspMeshMatchSelf", "esp_mesh_match_self")) return false
    if (!internalFunction("esp32RecoveredEspMeshMonitorNonassociatedChildren", "esp_mesh_monitor_nonassociated_children")) return false
    if (!internalFunction("esp32RecoveredEspMeshNwkRedundantRoute", "esp_mesh_nwk_redundant_route")) return false
