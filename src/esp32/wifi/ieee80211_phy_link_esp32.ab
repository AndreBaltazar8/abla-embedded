import "abla/build"

// Complete ieee80211_phy.o ABI. All rate-table, mode, initialization, and
// teardown paths are Abla-internal and independently prunable.
compile fun esp32Idf6LinkIeee80211PhyInternals(): bool {
    if (!internalFunction("esp32Ieee80211PhyDeinitialize", "ieee80211_phy_deinit")) return false
    if (!internalFunction("esp32Ieee80211PhyInitialize", "ieee80211_phy_init")) return false
    if (!internalFunction("esp32Ieee80211PhyModeShow", "ieee80211_phy_mode_show")) return false
    if (!internalFunction("esp32Ieee80211PhyType", "ieee80211_phy_type_get")) return false
    if (!internalFunction("esp32Ieee80211SetUserSupportedRates", "ieee80211_set_user_sup_rate")) return false
    if (!internalFunction("esp32Ieee80211SetupRateTable", "ieee80211_setup_ratetable")) return false
    if (!internalFunction("esp32Ieee80211PhyModeName", "phymode2str")) return false
    true
}
