import "abla/build"

// Complete ieee80211_crypto_ccmp.o ABI. ESP-NOW still reads the public ccmp
// descriptor data, but every executable entry point is Abla-internal.
compile fun esp32Idf6LinkCryptoCcmpDispatchInternals(): bool {
    if (!internalFunction("esp32VendorCcmpDecap", "ccmp_decap")) return false
    if (!internalFunction("esp32VendorCcmpEncap", "ccmp_encap")) return false
    if (!internalFunction("esp32VendorCcmpDecrypt", "ieee80211_ccmp_decrypt")) return false
    if (!internalFunction("esp32VendorCcmpEncrypt", "ieee80211_ccmp_encrypt")) return false
    if (!internalFunction("esp32VendorCcmpDecryptEspNow", "ieee80211_decrypt_espnow_pkt")) return false
    true
}
