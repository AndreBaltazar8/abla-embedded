import "abla/unsafe/memory"
import "abla/unsafe/native"
import "api_esp32.ab"
import "misc_nvs_esp32.ab"

// Structured Abla implementation of the classic ESP32 mesh timer dispatcher.
// The vendor object encoded this as a virtual Xtensa register machine and an
// indirect function table. Direct dispatch exposes every path to LLVM/DCE.

val esp32MeshTimerFunctionNameStorage = nativeStaticBytes(
    "\x6d\x65\x73\x68\x5f\x74\x69\x6d\x65\x72\x5f\x64\x6f\x5f\x70\x72\x6f\x63\x65\x73\x00")
val esp32MeshTimerFunctionName = u32(esp32MeshTimerFunctionNameStorage)

@inline
trusted fun esp32MeshTimerLoadU8(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

// The timer argument remains in the callback ABI because the mesh scheduler
// invokes these through a raw address. The timeout routines do not consume it.
trusted fun esp32MeshTimerRouteAnnounce(arguments:u32):u32 {
    esp32RecoveredRouteAnnounceTimeoutProcess(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    arguments
}

trusted fun esp32MeshTimerMieMonitor(arguments:u32):u32 {
    esp32RecoveredMeshIeMonitorTimeoutProcess(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    arguments
}

trusted fun esp32MeshTimerBeaconChange(arguments:u32):u32 {
    esp32RecoveredMeshBcnChangeTimeoutProcess(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    arguments
}

trusted fun esp32MeshTimerRootConnect(arguments:u32):u32 {
    esp32RecoveredMeshRootConnectTimeoutProcess(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    arguments
}

trusted fun esp32MeshTimerCandidateMonitor(arguments:u32):u32 {
    esp32RecoveredMeshCandidateMonitorTimeoutProcess(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    arguments
}

trusted fun esp32MeshTimerRouteTableChange(arguments:u32):u32 {
    esp32RecoveredMeshRtChangeTimeoutProcess(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    arguments
}

trusted fun esp32MeshTimerPowerSaveControl(arguments:u32):u32 {
    esp32RecoveredMeshPsControlTimeoutProcess(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    arguments
}

trusted fun esp32MeshTimerDoProcess(arguments:u32):u32 {
    if (arguments == u32(0)) return u32(0x4008)

    // Byte zero of the allocation is the stable libmesh timer-kind ABI.
    when (esp32MeshTimerLoadU8(arguments)) {
        2 -> esp32MeshTimerRouteAnnounce(arguments)
        3 -> esp32MeshTimerMieMonitor(arguments)
        4 -> esp32MeshTimerBeaconChange(arguments)
        5 -> esp32MeshTimerRootConnect(arguments)
        6 -> esp32MeshTimerCandidateMonitor(arguments)
        7 -> esp32MeshTimerRouteTableChange(arguments)
        8 -> esp32MeshTimerPowerSaveControl(arguments)
        else -> u32(0)
    }

    esp32RecoveredMeshFree(
        arguments,esp32MeshTimerFunctionName,u32(116),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    u32(0)
}
