import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkConnectionOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredCnxStaConnectLedTimerCb", "cnx_sta_connect_led_timer_cb")) return false
    if (!internalFunction("esp32RecoveredCnxConnectNextApTimeout", "cnx_connect_next_ap_timeout")) return false
    if (!internalFunction("esp32RecoveredCnxHandshakeTimeout", "cnx_handshake_timeout")) return false
    if (!internalFunction("esp32RecoveredCnxCsaFn", "cnx_csa_fn")) return false
    if (!internalFunction("esp32RecoveredIeee80211CnxAttach", "ieee80211_cnx_attach")) return false
    if (!internalFunction("esp32RecoveredCnxStartConnectWithoutScan", "_cnx_start_connect_without_scan")) return false
    if (!internalFunction("esp32RecoveredCnxCanDoObssScan", "cnx_can_do_obss_scan")) return false
    if (!internalFunction("esp32RecoveredCnxObssScanDoneCb", "cnx_obss_scan_done_cb")) return false
    if (!internalFunction("esp32RecoveredCnxObssScan", "cnx_obss_scan")) return false
    if (!internalFunction("esp32RecoveredCnxObssScanTimeout", "cnx_obss_scan_timeout")) return false
    if (!internalFunction("esp32RecoveredCnxStaScanCmd", "cnx_sta_scan_cmd")) return false
    if (!internalFunction("esp32RecoveredCnxConnectNextAp", "cnx_connect_next_ap")) return false
    if (!internalFunction("esp32RecoveredCnxAuthTimeout", "cnx_auth_timeout")) return false
    if (!internalFunction("esp32RecoveredCnxAuthTimeoutProcess", "cnx_auth_timeout_process")) return false
    if (!internalFunction("esp32RecoveredCnxAssocTimeout", "cnx_assoc_timeout")) return false
    if (!internalFunction("esp32RecoveredCnxAssocTimeoutProcess", "cnx_assoc_timeout_process")) return false
    if (!internalFunction("esp32RecoveredCnxHandshakeTimeoutProcess", "cnx_handshake_timeout_process")) return false
    if (!exportFunction("esp32RecoveredWlIsApNoLr", "wl_is_ap_no_lr")) return false
    if (!internalFunction("esp32RecoveredWlClearApNoLr", "wl_clear_ap_no_lr")) return false
    if (!internalFunction("esp32RecoveredCnxSoftapCsa", "cnx_softap_csa")) return false
    if (!internalFunction("esp32RecoveredCnxCsaFnProcess", "cnx_csa_fn_process")) return false
    if (!internalFunction("esp32RecoveredCnxValidateOweBss", "cnx_validate_owe_bss")) return false
    if (!internalFunction("esp32RecoveredCnxBssInit", "cnx_bss_init")) return false
    if (!internalFunction("esp32RecoveredCnxCheckBssidInBlacklist", "cnx_check_bssid_in_blacklist")) return false
    if (!internalFunction("esp32RecoveredCnxRemoveFromBlacklist", "cnx_remove_from_blacklist")) return false
    if (!internalFunction("esp32RecoveredCnxAddToBlacklist", "cnx_add_to_blacklist")) return false
    if (!internalFunction("esp32RecoveredCnxClearBlacklist", "cnx_clear_blacklist")) return false
    if (!internalFunction("esp32RecoveredCnxRcSearch", "cnx_rc_search")) return false
    if (!internalFunction("esp32RecoveredCnxDoHandoffInternal", "cnx_do_handoff_internal")) return false
    if (!internalFunction("esp32RecoveredCnxAddRc", "cnx_add_rc")) return false
    if (!internalFunction("esp32RecoveredCnxRemoveAllRc", "cnx_remove_all_rc")) return false
    if (!internalFunction("esp32RecoveredCnxRemoveRc", "cnx_remove_rc")) return false
    if (!internalFunction("esp32RecoveredCnxBssAlloc", "cnx_bss_alloc")) return false
    if (!internalFunction("esp32RecoveredCnxRemoveRcExcept", "cnx_remove_rc_except")) return false
    if (!internalFunction("esp32RecoveredCnxConnectNextApTimeoutProcess", "cnx_connect_next_ap_timeout_process")) return false
    if (!internalFunction("esp32RecoveredCnxStartHandoffCb", "cnx_start_handoff_cb")) return false
    if (!internalFunction("esp32RecoveredCnxStaConnectCmd", "cnx_sta_connect_cmd")) return false
    if (!exportFunction("esp32RecoveredCnxRcUpdateRssi", "cnx_rc_update_rssi")) return false
    if (!internalFunction("esp32RecoveredCnxRcUpdateStateMetric", "cnx_rc_update_state_metric")) return false
    if (!internalFunction("esp32RecoveredCnxRcUpdateAge", "cnx_rc_update_age")) return false
    if (!internalFunction("esp32RecoveredCnxUpdateBss", "cnx_update_bss")) return false
    if (!internalFunction("esp32RecoveredEspMeshGetTsfTime", "esp_mesh_get_tsf_time")) return false
    if (!internalFunction("esp32RecoveredSendApProbe", "send_ap_probe")) return false
    if (!internalFunction("esp32RecoveredMgdProbeSendTimeoutProcess", "mgd_probe_send_timeout_process")) return false
    if (!internalFunction("esp32RecoveredCnxNodeAlloc", "cnx_node_alloc")) return false
    if (!exportFunction("esp32RecoveredCnxNodeSearch", "cnx_node_search")) return false
    if (!internalFunction("esp32RecoveredCnxNodeIsExisting", "cnx_node_is_existing")) return false
    if (!internalFunction("esp32RecoveredCnxIsAnyNodeConnecting", "cnx_is_any_node_connecting")) return false
    if (!internalFunction("esp32RecoveredWifiSoftapStaconnectedEventPolicy", "wifi_softap_staconnected_event_policy")) return false
    if (!internalFunction("esp32RecoveredWifiSoftapToomanyDeny", "wifi_softap_toomany_deny")) return false
    if (!internalFunction("esp32RecoveredCnxStaPm", "cnx_sta_pm")) return false
    if (!internalFunction("esp32RecoveredCnxUpdateBssMore", "cnx_update_bss_more")) return false
    if (!internalFunction("esp32RecoveredCnxBeaconTimeoutProcess", "cnx_beacon_timeout_process")) return false
    if (!internalFunction("esp32RecoveredIcSetSta", "ic_set_sta")) return false
    if (!internalFunction("esp32RecoveredCnxStaLeave", "cnx_sta_leave")) return false
    if (!internalFunction("esp32RecoveredCnxStaAssociated", "cnx_sta_associated")) return false
    if (!internalFunction("esp32RecoveredCnxNodeJoin", "cnx_node_join")) return false
    if (!internalFunction("esp32RecoveredCnxStartObssScan", "cnx_start_obss_scan")) return false
    if (!internalFunction("esp32RecoveredCnxStopObssScan", "cnx_stop_obss_scan")) return false
    if (!internalFunction("esp32RecoveredCnxAuthDone", "cnx_auth_done")) return false
    if (!exportFunction("esp32RecoveredStaResetBeaconTimeout", "sta_reset_beacon_timeout")) return false
    if (!internalFunction("esp32RecoveredStaGetBeaconTimeout", "sta_get_beacon_timeout")) return false
    true
}
