import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../../xtensa/assembly.ab"
import "../shared_storage_esp32.ab"
val esp32Data_g_log_mod_b202b325f8Storage = nativeStaticAllocate(24)
val esp32Data_g_log_mod_b202b325f8 = u32(esp32Data_g_log_mod_b202b325f8Storage)

val esp32Data_g_log_level_49f0c81436Storage = nativeStaticAllocate(4)
val esp32Data_g_log_level_49f0c81436 = u32(esp32Data_g_log_level_49f0c81436Storage)

val esp32Data_g_misc_nvs_8391388f5eStorage = nativeStaticAllocate(4)
val esp32Data_g_misc_nvs_8391388f5e = u32(esp32Data_g_misc_nvs_8391388f5eStorage)


// The Wi-Fi core's small persistent-state record. Its three shared data cells
// retain their vendor ABI names while the init flag and all implementation
// functions remain ordinary Abla state and can be pruned.

val esp32MiscNvsRecordBytes = 60
val esp32MiscNvsStateOffset = 8
val esp32MiscNvsHandleOffset = 56
var esp32MiscNvsInitialized = false

@inline
trusted fun esp32MiscNvsCellAddress(): u32 = esp32Data_g_misc_nvs_8391388f5e

@inline
trusted fun esp32WifiOsiCellAddress(): u32 = esp32Data_g_osi_funcs_p_7cce4a7228

@inline
trusted fun esp32WifiMenuConfigurationAddress(): u32 =
    esp32Data_g_wifi_menuconfig_c8372af18b

@inline
trusted fun esp32MiscLoadU32(address: int): u32 =
    u32(ablaUnsafeVolatileLoadU32(address))

@inline
trusted fun esp32MiscStoreU32(address: int, value: u32): void =
    ablaUnsafeVolatileStoreU32(address, value)

@inline
trusted fun esp32WifiOsiFunction(offset: int): int {
    val table = esp32MiscLoadU32(int(esp32WifiOsiCellAddress()))
    if (table == u32(0)) 0
    else int(esp32MiscLoadU32(int(table) + offset))
}

trusted fun esp32MiscNvsWarning(messageAddress: u32, detail: int): void {
    esp32WifiLogValue(u32(1), u32(256), u32(2), messageAddress, u32(detail), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    return
}

trusted fun esp32MiscNvsClear(address: int): void {
    var offset = 0
    while (offset < esp32MiscNvsRecordBytes) {
        esp32MiscStoreU32(address + offset, u32(0))
        offset = offset + 4
    }
    return
}

trusted fun esp32MiscNvsLoad(restoring: bool): int {
    val cell = int(esp32MiscNvsCellAddress())
    var record = int(esp32MiscLoadU32(cell))
    if (!restoring) {
        val allocate = esp32WifiOsiFunction(348)
        if (allocate == 0) return 257
        record = callNativeI32Pointer(
            allocate, nativePointerFromAddress(esp32MiscNvsRecordBytes)
        )
        esp32MiscStoreU32(cell, u32(record))
        if (record == 0) {
            esp32MiscNvsWarning(
                u32(nativeCStringAddress("misc nvs f\n")), 0
            )
            return 257
        }
        esp32MiscNvsClear(record)
        val menu = int(esp32WifiMenuConfigurationAddress())
        if (esp32MiscLoadU32(menu + 36) != u32(0)) {
            val open = esp32WifiOsiFunction(300)
            if (open == 0) return 257
            val status = callNativeI32PointerI32Pointer(
                open,
                nativePointerFromAddress(nativeCStringAddress("misc")),
                1,
                nativePointerFromAddress(record + esp32MiscNvsHandleOffset)
            )
            if (status != 0) {
                esp32MiscNvsWarning(
                    u32(nativeCStringAddress(
                        "wifi osi_nvs_open fail ret=%d\n"
                    )),
                    status
                )
                return status
            }
        }
    }
    if (record == 0) return 257
    esp32MiscStoreU32(record + esp32MiscNvsStateOffset, u32(0))
    0
}

trusted fun esp32MiscNvsDeinitialize(): void {
    val cell = int(esp32MiscNvsCellAddress())
    val record = int(esp32MiscLoadU32(cell))
    if (record != 0) {
        val menu = int(esp32WifiMenuConfigurationAddress())
        val handleAddress = record + esp32MiscNvsHandleOffset
        val handle = int(esp32MiscLoadU32(handleAddress))
        if (esp32MiscLoadU32(menu + 36) != u32(0) && handle != 0) {
            val close = esp32WifiOsiFunction(304)
            if (close != 0) {
                callNativeVoidPointer(
                    close, nativePointerFromAddress(handle)
                )
            }
            esp32MiscStoreU32(handleAddress, u32(0))
        }
        val release = esp32WifiOsiFunction(176)
        if (release != 0) {
            callNativeVoidPointer(
                release, nativePointerFromAddress(record)
            )
        }
    }
    esp32MiscStoreU32(cell, u32(0))
    esp32MiscNvsInitialized = false
    return
}

trusted fun esp32MiscNvsInitialize(): i32 {
    // Static data is emitted by Abla above.
    if (esp32MiscNvsInitialized) return i32(0)
    esp32MiscNvsInitialized = true
    val status = esp32MiscNvsLoad(false)
    if (status != 0) esp32MiscNvsDeinitialize()
    i32(status)
}

trusted fun esp32MiscNvsRestore(): i32 = i32(esp32MiscNvsLoad(true))
