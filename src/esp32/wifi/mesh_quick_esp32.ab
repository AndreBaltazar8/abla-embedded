import "../../xtensa/assembly.ab"

// Shared state used by ESP-MESH's net80211 quick path. The vendor object only
// owns this storage; the mesh component fills esp_mesh_quick_funcs at runtime.
// Defining it with the same data ABI keeps the implementation in Abla and lets
// the linker avoid extracting ieee80211_mesh_quick.o merely for a BSS symbol.
@inline
trusted fun esp32ProvideMeshQuickSharedState(): void {
    xtensaAssemblyVoid(
        ".pushsection .bss.esp_mesh_quick_funcs,\"aw\",@nobits\n.balign 4\n.global esp_mesh_quick_funcs\n.type esp_mesh_quick_funcs,@object\n.size esp_mesh_quick_funcs,176\nesp_mesh_quick_funcs:\n.space 176\n.popsection\n.pushsection .bss.esp_mesh_ps_duty,\"aw\",@nobits\n.global esp_mesh_ps_duty\n.type esp_mesh_ps_duty,@object\n.size esp_mesh_ps_duty,27\nesp_mesh_ps_duty:\n.space 27\n.popsection\n.pushsection .bss.g_mesh_topology,\"aw\",@nobits\n.balign 4\n.global g_mesh_topology\n.type g_mesh_topology,@object\n.size g_mesh_topology,4\ng_mesh_topology:\n.space 4\n.popsection\n.pushsection .bss.esp_mesh_appie,\"aw\",@nobits\n.balign 4\n.global esp_mesh_appie\n.type esp_mesh_appie,@object\n.size esp_mesh_appie,4\nesp_mesh_appie:\n.space 4\n.popsection\n.pushsection .data.g_mesh_self_organized,\"aw\",@progbits\n.global g_mesh_self_organized\n.type g_mesh_self_organized,@object\n.size g_mesh_self_organized,1\ng_mesh_self_organized:\n.byte 1\n.popsection\n.pushsection .bss.g_mesh_is_root,\"aw\",@nobits\n.global g_mesh_is_root\n.type g_mesh_is_root,@object\n.size g_mesh_is_root,1\ng_mesh_is_root:\n.space 1\n.popsection\n.pushsection .bss.g_mesh_init_ps_type,\"aw\",@nobits\n.balign 4\n.global g_mesh_init_ps_type\n.type g_mesh_init_ps_type,@object\n.size g_mesh_init_ps_type,4\ng_mesh_init_ps_type:\n.space 4\n.popsection\n.pushsection .bss.g_mesh_is_started,\"aw\",@nobits\n.global g_mesh_is_started\n.type g_mesh_is_started,@object\n.size g_mesh_is_started,1\ng_mesh_is_started:\n.space 1\n.popsection",
        "~{memory}"
    )
    // Recognize the two ESP-MESH association IEs. Keeping this ABI function
    // in its own garbage-collectable assembly section avoids turning the
    // internal Abla provider into an exported LLVM definition.
    xtensaAssemblyVoid(
        ".pushsection .text.is_esp_mesh_assoc,\"ax\",@progbits\n.balign 4\n.global is_esp_mesh_assoc\n.type is_esp_mesh_assoc,@function\nis_esp_mesh_assoc:\nentry a1, 32\nmov.n a3, a2\nl8ui a8, a3, 1\nmovi a9, 69\nbne a8, a9, .Labla_mesh_assoc_false\nl8ui a8, a3, 2\nmovi a9, 0x18\nbne a8, a9, .Labla_mesh_assoc_false\nl8ui a8, a3, 3\nmovi a9, 0xfe\nbne a8, a9, .Labla_mesh_assoc_false\nl8ui a8, a3, 4\nmovi a9, 0x34\nbne a8, a9, .Labla_mesh_assoc_false\nmovi a8, g_mesh_topology\nl32i a8, a8, 0\nbeqi a8, 1, .Labla_mesh_assoc_root\nmovi a8, 1\nj .Labla_mesh_assoc_kind\n.Labla_mesh_assoc_root:\nmovi a8, 13\n.Labla_mesh_assoc_kind:\nl8ui a9, a3, 5\nbne a8, a9, .Labla_mesh_assoc_false\nmovi a8, g_mesh_init_ps_type\nl32i a8, a8, 0\nbeqz a8, .Labla_mesh_assoc_ps_one\nmovi a8, 2\nj .Labla_mesh_assoc_ps\n.Labla_mesh_assoc_ps_one:\nmovi a8, 1\n.Labla_mesh_assoc_ps:\nl8ui a9, a3, 6\nsrli a9, a9, 1\nbne a8, a9, .Labla_mesh_assoc_false\nmovi a2, 1\nretw.n\n.Labla_mesh_assoc_false:\nmovi a2, 0\nretw.n\n.size is_esp_mesh_assoc, .-is_esp_mesh_assoc\n.popsection",
        "~{memory}"
    )
    return
}
