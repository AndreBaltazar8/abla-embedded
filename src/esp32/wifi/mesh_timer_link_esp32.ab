import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshTimerInternals(): bool {
    if (!internalFunction("esp32MeshTimerBeaconChange", "mesh_timer_bcn_change")) return false
    if (!internalFunction("esp32MeshTimerCandidateMonitor", "mesh_timer_candidate_monitor")) return false
    if (!internalFunction("esp32MeshTimerDoProcess", "mesh_timer_do_process")) return false
    if (!internalFunction("esp32MeshTimerMieMonitor", "mesh_timer_mie_monitor")) return false
    if (!internalFunction("esp32MeshTimerPowerSaveControl", "mesh_timer_ps_control")) return false
    if (!internalFunction("esp32MeshTimerRootConnect", "mesh_timer_root_connect")) return false
    if (!internalFunction("esp32MeshTimerRouteAnnounce", "mesh_timer_route_announce")) return false
    if (!internalFunction("esp32MeshTimerRouteTableChange", "mesh_timer_rt_change")) return false
    true
}
