import "abla/build"

// Exact names used by recovered assembly and the remaining vendor objects.
// Ordinary Abla-to-Abla edges below are local. Only twelve names retain ELF
// visibility for proven NAN, mesh, ESP-NOW, packet-engine, and supplicant
// callers; each can become local when its last opaque caller is reconstructed.
compile fun esp32Idf6LinkChannelManagerOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredChmMhz2num", "chm_mhz2num")) return false
    if (!internalFunction("esp32RecoveredChmDeinit", "chm_deinit")) return false
    if (!exportFunction("esp32RecoveredChmReleaseLock", "chm_release_lock")) return false
    if (!internalFunction("esp32RecoveredChmEndOp", "chm_end_op")) return false
    if (!internalFunction("esp32RecoveredChmEndOpTimeoutProcess", "chm_end_op_timeout_process")) return false
    if (!internalFunction("esp32RecoveredChmCancelOp", "chm_cancel_op")) return false
    if (!exportFunction("esp32RecoveredChmAcquireLock", "chm_acquire_lock")) return false
    if (!exportFunction("esp32RecoveredChmGetCurrentChannel", "chm_get_current_channel")) return false
    if (!exportFunction("esp32RecoveredChmCheckChannelIsValid", "chm_check_channel_is_valid")) return false
    if (!internalFunction("esp32RecoveredChmGetSndChanMode", "chm_get_snd_chan_mode")) return false
    if (!internalFunction("esp32RecoveredChmSetSndChan", "chm_set_snd_chan")) return false
    if (!exportFunction("esp32RecoveredChmIsAtHomeChannel", "chm_is_at_home_channel")) return false
    if (!exportFunction("esp32RecoveredChmGetCurrentBand", "chm_get_current_band")) return false
    if (!exportFunction("esp32RecoveredChmGetBandFromChan", "chm_get_band_from_chan")) return false
    if (!exportFunction("esp32RecoveredChmGetHomeChannel", "chm_get_home_channel")) return false
    if (!exportFunction("esp32RecoveredChmSetHomeChannel", "chm_set_home_channel")) return false
    if (!internalFunction("esp32RecoveredChmGetChannelIndex", "chm_get_channel_index")) return false
    if (!internalFunction("esp32RecoveredChmGetChanInfo", "chm_get_chan_info")) return false
    if (!exportFunction("esp32RecoveredChmSetCurrentChannel", "chm_set_current_channel")) return false
    if (!internalFunction("esp32RecoveredChmInit", "chm_init")) return false
    if (!exportFunction("esp32RecoveredChmStartOp", "chm_start_op")) return false
    if (!exportFunction("esp32RecoveredChmReturnHomeChannel", "chm_return_home_channel")) return false
    true
}
