import "abla/build"

// Complete ieee80211_crypto.o executable surface. The wpa_crypto_funcs table
// remains data-visible to opaque mesh/ESP-NOW users; all nine functions are
// internal and independently prunable.
compile fun esp32Idf6LinkCryptoDispatchInternals(): bool {
    if (!internalFunction("esp32VendorCryptoBipCmacDecrypt", "ieee80211_crypto_aes_128_cmac_decrypt")) return false
    if (!internalFunction("esp32VendorCryptoAttach", "ieee80211_crypto_attach")) return false
    if (!internalFunction("esp32VendorCryptoAvailable", "ieee80211_crypto_available")) return false
    if (!internalFunction("esp32VendorCryptoBipEncrypt", "ieee80211_crypto_bip_encrypt")) return false
    if (!internalFunction("esp32VendorCryptoDecap", "ieee80211_crypto_decap")) return false
    if (!internalFunction("esp32VendorCryptoEncap", "ieee80211_crypto_encap")) return false
    if (!internalFunction("esp32VendorCryptoBipGmacDecrypt", "ieee80211_crypto_gmac_decrypt")) return false
    if (!internalFunction("esp32VendorCryptoSetKey", "ieee80211_crypto_setkey")) return false
    if (!internalFunction("esp32VendorCipherMicLength", "ieee80211_get_cipher_mic_len")) return false
    true
}
