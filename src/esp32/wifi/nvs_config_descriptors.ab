trusted fun esp32WifiNvsInitDescriptorTail(keyBase: u32, valueBase: u32): u32 {
    var index = 0
    while (index < 85) {
        val packed = u32(nativeAddressLoadU32(esp32WifiNvsDescriptorWords, index * 16))
        val minimum = u32(nativeAddressLoadU32(esp32WifiNvsDescriptorWords, index * 16 + 4))
        val limits = u32(nativeAddressLoadU32(esp32WifiNvsDescriptorWords, index * 16 + 8))
        val initial = u32(nativeAddressLoadU32(esp32WifiNvsDescriptorWords, index * 16 + 12))
        xtensaMemoryBarrier()
        val result = esp32RecoveredWifiNvsCfgItemInit(
            keyBase + (packed & u32(1023)), (packed >>> u32(10)) & u32(127),
            (packed >>> u32(17)) & u32(7), (packed >>> u32(20)) & u32(1023),
            minimum, limits & u32(65535), initial, valueBase + (limits >>> u32(16)),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        if (result != u32(0)) return result
        index = index + 1
    }
    u32(0)
}
