import "../../xtensa/assembly.ab"

// Complete classic-ESP32 ieee80211_debug.o compatibility surface. These two
// routines are architecture ABI adapters: the naked bodies preserve C varargs,
// Xtensa's register-window va_list, and the vendor counter record byte-for-byte.
// Portable level and mask decisions live in wifi/ieee80211_debug_logic.ab.

@naked
@export("wifi_log")
trusted fun esp32WifiLog(
    ignoredFirst: u32,
    ignoredSecond: u32,
    level: u32,
    formatAddress: u32
): void = xtensaAssemblyVoid(
    ".pushsection .rodata.abla_wifi_debug,\"a\",@progbits\n.Labla_wifi_log_levels:\n.asciz \"NEWIDV\"\n.Labla_wifi_log_tag:\n.asciz \"wifi\"\n.Labla_wifi_log_header:\n.asciz \"%c (%d) %s:\"\n.Labla_wifi_log_empty:\n.asciz \"\"\n.Labla_wifi_log_newline:\n.asciz \"\\n\"\n.Labla_wifi_log_string:\n.asciz \"%s\"\n.popsection\nentry a1, 112\ns32i a6, a1, 64\ns32i a7, a1, 68\nmovi a3, g_osi_funcs_p\nmemw\nl32i a2, a3, 0\nbeqz a2, .Labla_wifi_log_return\nl32i a6, a2, 340\nbeqz a6, .Labla_wifi_log_return\nmovi a8, g_log_level\nl32i a8, a8, 0\nbltu a8, a4, .Labla_wifi_log_return\nmovi a9, .Labla_wifi_log_levels\nadd a8, a9, a4\nl8ui a7, a8, 0\nl32i a10, a2, 344\nl32i a6, a2, 336\nmemw\ncallx8 a10\nmov.n a14, a10\nmov.n a13, a7\nmov.n a10, a4\nmovi a2, .Labla_wifi_log_tag\nmov.n a11, a2\nmovi a12, .Labla_wifi_log_header\nmov.n a15, a2\nmovi a8, .Labla_wifi_log_empty\ns32i a8, a1, 0\nmemw\ncallx8 a6\naddi a13, a1, 80\naddi a14, a1, 48\nmovi.n a15, 16\nl32i a8, a3, 0\nmov.n a10, a4\nmov.n a11, a2\nmov.n a12, a5\nl32i a8, a8, 340\ns32i a13, a1, 16\ns32i a14, a1, 20\ns32i a15, a1, 24\nmemw\ncallx8 a8\nl32i a3, a3, 0\nmov.n a10, a4\nmov.n a11, a2\nmovi a12, .Labla_wifi_log_string\nmovi a13, .Labla_wifi_log_newline\nl32i a3, a3, 336\nmemw\ncallx8 a3\n.Labla_wifi_log_return:\nretw.n",
    "~{memory}"
)

@naked
@export("dbg_hmac_rxtx_statis_dump")
trusted fun esp32WifiDebugDumpReceiveTransmit(): void = xtensaAssemblyVoid(
    ".pushsection .bss.g_hmac_cnt,\"aw\",@nobits\n.global g_hmac_cnt\n.type g_hmac_cnt,@object\n.size g_hmac_cnt,64\ng_hmac_cnt:\n.space 64\n.popsection\n.pushsection .rodata.abla_hmac_debug,\"a\",@progbits\n.Labla_hmac_empty:\n.asciz \"\"\n.Labla_hmac_rx:\n.asciz \" HMAC RX:\"\n.Labla_hmac_rx_header:\n.asciz \" %-3s %-8s %-8s %-6s %-6s %-5s\"\n.Labla_hmac_rx_values:\n.asciz \" %-3s %-8u %-8u %-6u %-6u %-5u\"\n.Labla_hmac_tx:\n.asciz \" HMAC TX:\"\n.Labla_hmac_tx_header:\n.asciz \" %-8s %-8s %-6s %-6s %-6s %-6s %-7s %-5s %-5s\"\n.Labla_hmac_tx_values:\n.asciz \" %-8u %-8u %-6u %-6u %-6u %-7u %-5u\"\n.Labla_hmac_all:\n.asciz \"all\"\n.Labla_hmac_ifx:\n.asciz \"ifx\"\n.Labla_hmac_beacon_probe:\n.asciz \"bcn/probe\"\n.Labla_hmac_mgmt:\n.asciz \"mgmt\"\n.Labla_hmac_ctl:\n.asciz \"ctl\"\n.Labla_hmac_data:\n.asciz \"data\"\n.Labla_hmac_sta:\n.asciz \"sta\"\n.Labla_hmac_ap:\n.asciz \"ap\"\n.Labla_hmac_auth:\n.asciz \"auth\"\n.Labla_hmac_amsdu:\n.asciz \"amsdu\"\n.Labla_hmac_action:\n.asciz \"action\"\n.Labla_hmac_deauth:\n.asciz \"deauth\"\n.Labla_hmac_assoc:\n.asciz \"assoc\"\n.Labla_hmac_ap_tx:\n.asciz \"ap_tx\"\n.Labla_hmac_sta_tx:\n.asciz \"sta_tx\"\n.Labla_hmac_oos:\n.asciz \"oos\"\n.Labla_hmac_reorder:\n.asciz \"reorder\"\n.Labla_hmac_ps_uc1:\n.asciz \"ps_uc1\"\n.Labla_hmac_psq_uc:\n.asciz \"psq_uc\"\n.Labla_hmac_psq_mc:\n.asciz \"psq_mc\"\n.Labla_hmac_psq_tx:\n.asciz \"psq_tx\"\n.popsection\nentry a1, 64\nmovi a3, 1\nslli a3, a3, 19\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_empty\ncall8 wifi_log\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_rx\ncall8 wifi_log\nmovi a8, .Labla_hmac_beacon_probe\ns32i a8, a1, 12\nmovi a8, .Labla_hmac_mgmt\ns32i a8, a1, 8\nmovi a8, .Labla_hmac_ctl\ns32i a8, a1, 4\nmovi a8, .Labla_hmac_data\ns32i a8, a1, 0\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_rx_header\nmovi a14, .Labla_hmac_ifx\nmovi a15, .Labla_hmac_all\nmemw\ncall8 wifi_log\nmovi a2, g_hmac_cnt\nl16ui a8, a2, 12\ns32i a8, a1, 12\nl16ui a8, a2, 10\ns32i a8, a1, 8\nl16ui a8, a2, 8\ns32i a8, a1, 4\nl32i a8, a2, 4\ns32i a8, a1, 0\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_rx_values\nmovi a14, .Labla_hmac_sta\nl32i a15, a2, 0\nmemw\ncall8 wifi_log\nl16ui a8, a2, 32\ns32i a8, a1, 12\nl16ui a8, a2, 30\ns32i a8, a1, 8\nl16ui a8, a2, 28\ns32i a8, a1, 4\nl32i a8, a2, 24\ns32i a8, a1, 0\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_rx_values\nmovi a14, .Labla_hmac_ap\nl32i a15, a2, 20\nmemw\ncall8 wifi_log\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_empty\ncall8 wifi_log\nmovi a8, .Labla_hmac_amsdu\ns32i a8, a1, 12\nmovi a8, .Labla_hmac_action\ns32i a8, a1, 8\nmovi a8, .Labla_hmac_deauth\ns32i a8, a1, 4\nmovi a8, .Labla_hmac_assoc\ns32i a8, a1, 0\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_rx_header\nmovi a14, .Labla_hmac_ifx\nmovi a15, .Labla_hmac_auth\nmemw\ncall8 wifi_log\nl16ui a8, a2, 18\ns32i a8, a1, 12\nl8ui a8, a2, 17\ns32i a8, a1, 8\nl8ui a8, a2, 16\ns32i a8, a1, 4\nl8ui a8, a2, 14\ns32i a8, a1, 0\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_rx_values\nmovi a14, .Labla_hmac_sta\nl8ui a15, a2, 15\nmemw\ncall8 wifi_log\nl16ui a8, a2, 38\ns32i a8, a1, 12\nl8ui a8, a2, 37\ns32i a8, a1, 8\nl8ui a8, a2, 36\ns32i a8, a1, 4\nl8ui a8, a2, 35\ns32i a8, a1, 0\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_rx_values\nmovi a14, .Labla_hmac_ap\nl8ui a15, a2, 34\nmemw\ncall8 wifi_log\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_empty\ncall8 wifi_log\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_tx\ncall8 wifi_log\nmovi a8, .Labla_hmac_amsdu\ns32i a8, a1, 24\nmovi a8, .Labla_hmac_oos\ns32i a8, a1, 20\nmovi a8, .Labla_hmac_reorder\ns32i a8, a1, 16\nmovi a8, .Labla_hmac_ps_uc1\ns32i a8, a1, 12\nmovi a8, .Labla_hmac_psq_uc\ns32i a8, a1, 8\nmovi a8, .Labla_hmac_psq_mc\ns32i a8, a1, 4\nmovi a8, .Labla_hmac_psq_tx\ns32i a8, a1, 0\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_tx_header\nmovi a14, .Labla_hmac_sta_tx\nmovi a15, .Labla_hmac_ap_tx\nmemw\ncall8 wifi_log\nl16ui a8, a2, 60\ns32i a8, a1, 24\nl16ui a8, a2, 56\ns32i a8, a1, 20\nl16ui a8, a2, 54\ns32i a8, a1, 16\nl16ui a8, a2, 58\ns32i a8, a1, 12\nl16ui a8, a2, 52\ns32i a8, a1, 8\nl16ui a8, a2, 50\ns32i a8, a1, 4\nl16ui a8, a2, 48\ns32i a8, a1, 0\nmovi.n a10, 1\nmov.n a11, a3\nmovi.n a12, 3\nmovi a13, .Labla_hmac_tx_values\nl32i a14, a2, 44\nl32i a15, a2, 40\nmemw\ncall8 wifi_log\nretw.n",
    "~{memory}"
)

@naked
@export("dbg_hmac_statis_dump")
trusted fun esp32WifiDebugDump(mask: u32): void = xtensaAssemblyVoid(
    "entry a1, 32\nbbci a2, 1, .Labla_hmac_dump_return\ncall8 dbg_hmac_rxtx_statis_dump\n.Labla_hmac_dump_return:\nretw.n",
    "~{memory}"
)
