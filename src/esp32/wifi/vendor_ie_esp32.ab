import "../../runtime/freestanding_memory.ab"
import "../../xtensa/assembly.ab"

// Espressif vendor information-element construction. Only the generic header
// and manufacturer element are referenced by station firmware; ESP-NOW,
// mesh, pairing, and frequency-announcement builders remain internal.

@inline
trusted fun esp32VendorOuiAddress(): u32 = xtensaAssemblyReadU32(
    "movi $0, g_espnow_user_oui", "=a"
)

@inline
trusted fun esp32VendorIeByte(address: u32, value: int): void =
    freestandingStoreByte(address, value)

trusted fun esp32VendorIePrefix(
    destination: u32,
    length: int,
    kind: int,
    version: int
): u32 {
    val oui = esp32VendorOuiAddress()
    esp32VendorIeByte(destination, 221)
    esp32VendorIeByte(destination + u32(1), length)
    esp32VendorIeByte(destination + u32(2), freestandingLoadByte(oui))
    esp32VendorIeByte(
        destination + u32(3), freestandingLoadByte(oui + u32(1))
    )
    esp32VendorIeByte(
        destination + u32(4), freestandingLoadByte(oui + u32(2))
    )
    esp32VendorIeByte(destination + u32(5), kind)
    esp32VendorIeByte(destination + u32(6), version)
    destination + u32(7)
}

@export("ieee80211_add_ie_vendor_esp_head")
trusted fun esp32AddVendorInformationElementHeader(
    destination: u32,
    kind: u32,
    version: u32,
    length: u32
): u32 = esp32VendorIePrefix(
    destination, int(length) & 255, int(kind) & 255, int(version) & 255
)

@export("ieee80211_add_ie_vendor_esp_manufacturer")
trusted fun esp32AddVendorManufacturerElement(
    destination: u32,
    manufacturerOui: u32,
    payload: u32,
    payloadLength: u32
): u32 {
    val length = int(payloadLength) & 255
    val body = esp32VendorIePrefix(destination, length + 8, 221, 1)
    esp32VendorIeByte(body, freestandingLoadByte(manufacturerOui))
    esp32VendorIeByte(
        body + u32(1), freestandingLoadByte(manufacturerOui + u32(1))
    )
    esp32VendorIeByte(
        body + u32(2), freestandingLoadByte(manufacturerOui + u32(2))
    )
    if (length != 0 && payload != u32(0)) {
        val ignored = freestandingCopy(
            body + u32(3), payload, u32(length)
        )
    }
    body + u32(3 + length)
}

@export("ieee80211_add_ie_vendor_esp_now")
trusted fun esp32AddVendorEspNowElement(
    destination: u32,
    payload: u32,
    payloadLength: int
): u32 {
    var remaining = payloadLength
    var source = payload
    var output = destination
    while (remaining > 0) {
        val fragment = if (remaining > 250) 250 else remaining
        val more = if (fragment < remaining) 16 else 0
        val body = esp32VendorIePrefix(
            output, fragment + 5, 4, more | 2
        )
        val ignored = freestandingCopy(body, source, u32(fragment))
        output = body + u32(fragment)
        source = source + u32(fragment)
        remaining = remaining - fragment
    }
    output
}
