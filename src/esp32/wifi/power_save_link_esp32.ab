import "abla/build"

// Every caller of these six exact names is already in the same Abla LLVM unit,
// so none is exported. Only roots reached by the mixed firmware are selected;
// the fallback-only queue helpers below remain prunable.
compile fun esp32Idf6LinkPowerSaveInternals(): bool {
    if (!internalFunction("esp32RecoveredIeee80211PsqInit", "ieee80211_psq_init")) return false
    if (!internalFunction("esp32RecoveredIeee80211GpsqInit", "ieee80211_gpsq_init")) return false
    if (!internalFunction("esp32RecoveredPwrsaveFlushq", "pwrsave_flushq")) return false
    if (!internalFunction("esp32RecoveredIeee80211NodePwrsave", "ieee80211_node_pwrsave")) return false
    if (!internalFunction("esp32RecoveredIeee80211PwrsaveNodeCleanup", "ieee80211_pwrsave_node_cleanup")) return false
    if (!internalFunction("esp32RecoveredIeee80211PwrsaveTxcb", "ieee80211_pwrsave_txcb")) return false
    true
}

// The removed object also supplied these weak fallbacks. ESP-IDF currently
// overrides all three with strong definitions, so the mixed build deliberately
// leaves them unselected. A fully-Abla stack can opt into the complete member
// without making any of them externally visible.
compile fun esp32LinkPowerSaveWeakFallbacks(): bool {
    if (!internalFunction("esp32RecoveredIeee80211PsqCleanup", "ieee80211_psq_cleanup")) return false
    if (!internalFunction("esp32RecoveredIeee80211PsqFindMaxBss", "ieee80211_psq_find_max_bss")) return false
    if (!internalFunction("esp32RecoveredIeee80211PsqTakeHead", "ieee80211_psq_take_head")) return false
    if (!internalFunction("esp32RecoveredIeee80211PsqTakeTail", "ieee80211_psq_take_tail")) return false
    if (!internalFunction("esp32RecoveredIeee80211PsqDropOnePkt", "ieee80211_psq_drop_one_pkt")) return false
    if (!internalFunction("esp32RecoveredIeee80211PsqSendOnePkt", "ieee80211_psq_send_one_pkt")) return false
    if (!internalFunction("esp32RecoveredIeee80211PsqIsBuffPkt", "ieee80211_psq_is_buff_pkt")) return false
    if (!internalFunction("esp32RecoveredIeee80211SetTim", "ieee80211_set_tim")) return false
    if (!internalFunction("esp32RecoveredIeee80211Pwrsave", "ieee80211_pwrsave")) return false
    if (!internalFunction("esp32RecoveredIeee80211IsBufferableMmpdu", "ieee80211_is_bufferable_mmpdu")) return false
    true
}
