// Classic ESP32 net80211 PHY policy, replacing ieee80211_phy.o. The RF/BB
// mechanism remains below this layer; this module owns the rate table exposed
// to net80211, PHY-mode selection, LR policy, and per-interface LoRa policy.
//
// Only the three entry points still called by opaque net80211 members have a
// linker name. Deinitialization and every helper are ordinary internal Abla.

val esp32Ieee80211PhyInvalidArgument = i32(257)

@inline
trusted fun esp32Ieee80211PhyLoadU8(address: u32): int =
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address))) & 255

@inline
trusted fun esp32Ieee80211PhyLoadU32(address: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32Ieee80211PhyStoreU8(
    address: u32,
    value: int
): void {
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), value & 255)
    return
}

@inline
trusted fun esp32Ieee80211PhyStoreU32(
    address: u32,
    value: u32
): void {
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))
    return
}

@inline
trusted fun esp32Ieee80211PhyCoreAddress(): u32 =
    esp32Data_g_ic_8b88278667

@inline
trusted fun esp32Ieee80211PhyNvsCellAddress(): u32 =
    esp32Data_g_wifi_nvs_4c5e512ac1

@noinline
trusted fun esp32ProvideIeee80211PhyStrings(): void {
    // Static data is emitted by Abla above.
    return
}

trusted fun esp32Ieee80211PhyStringAddress(label: int): u32 {
    esp32ProvideIeee80211PhyStrings()
    if (label == 0) return esp32Data_Labla_phy_auto_e0c53791a5
    if (label == 1) return esp32Data_Labla_phy_11b_1eace14e72
    if (label == 2) return esp32Data_Labla_phy_11bg_503eaf7450
    if (label == 3) return esp32Data_Labla_phy_11bgn_f5e5689895
    if (label == 4) return esp32Data_Labla_phy_lr_f7e9f0aaf8
    if (label == 5) return esp32Data_Labla_phy_11ax_fefffba67d
    esp32Data_Labla_phy_unknown_60e02a094a
}

trusted fun esp32Ieee80211PhyModeName(mode: int): u32 {
    if (mode >= 0 && mode <= 5) return esp32Ieee80211PhyStringAddress(mode)
    esp32Ieee80211PhyStringAddress(6)
}

trusted fun esp32Ieee80211PhyCopyString(
    destination: u32,
    source: u32
): void {
    if (destination == u32(0) || source == u32(0)) return
    var offset = 0
    var byte = esp32Ieee80211PhyLoadU8(source)
    while (byte != 0) {
        esp32Ieee80211PhyStoreU8(destination + u32(offset), byte)
        offset = offset + 1
        byte = esp32Ieee80211PhyLoadU8(source + u32(offset))
    }
    esp32Ieee80211PhyStoreU8(destination + u32(offset), 0)
    return
}

@inline
trusted fun esp32Ieee80211PhyCallVoid1(
    symbol: u32,
    argument: u32
): void {
    ablaUnsafeCallVoidI32(int(symbol), int(argument))
    return
}

@inline
trusted fun esp32Ieee80211PhyLoraFunction(enable: bool): u32 =
    if (enable) u32(nativeFunctionAddress(esp32RecoveredEspWifiVndLoraEnable)) else u32(nativeFunctionAddress(esp32RecoveredEspWifiVndLoraDisable))

trusted fun esp32Ieee80211PhySetLora(
    interfaceIndex: int,
    enabled: bool
): void {
    esp32Ieee80211PhyCallVoid1(
        esp32Ieee80211PhyLoraFunction(enabled),
        u32(interfaceIndex)
    )
    return
}

trusted fun esp32Ieee80211PhyDeinitialize(): i32 {
    esp32Ieee80211PhySetLora(0, false)
    esp32Ieee80211PhySetLora(1, false)
    i32(0)
}

// Values at byte 14 of each 16-byte hardware-rate entry. This compact list
// removes the former 212-byte temporary allocation and copy while preserving
// the exact net80211-visible rate order.
@inline
trusted fun esp32Ieee80211RateCode(index: u32): int {
    esp32ProvideIeee80211PhyStrings()
    val rates = esp32Data_Labla_phy_rate_codes_23d560fc55
    esp32Ieee80211PhyLoadU8(rates + index)
}

trusted fun esp32Ieee80211SetupRateTable(
    interfaceAddress: u32,
    band: int,
    mode: int
): i32 {
    if (interfaceAddress == u32(0)) return esp32Ieee80211PhyInvalidArgument

    esp32Ieee80211PhyStoreU8(interfaceAddress + u32(426), 2)
    esp32Ieee80211PhyStoreU8(interfaceAddress + u32(427), 32)
    esp32Ieee80211PhyStoreU8(interfaceAddress + u32(428), 33)
    if (mode == 4) {
        esp32Ieee80211PhyStoreU8(interfaceAddress + u32(425), 1)
    }

    var enabledRates = if (mode == 1) 15
        else if (band == 2) 4080
        else 4095
    val userRates = int(esp32Ieee80211PhyLoadU32(
        interfaceAddress + u32(436)
    ))
    if (userRates != 0) enabledRates = enabledRates & userRates

    esp32Ieee80211PhyStoreU8(interfaceAddress + u32(361), 0)
    var rateIndex = u32(0)
    var outputIndex = u32(0)
    var remainingRates = u32(enabledRates)
    while (remainingRates != u32(0)) {
        if ((remainingRates & u32(1)) != u32(0)) {
            esp32Ieee80211PhyStoreU8(
                interfaceAddress + u32(362) + outputIndex,
                esp32Ieee80211RateCode(rateIndex)
            )
            outputIndex = outputIndex + u32(1)
            esp32Ieee80211PhyStoreU8(
                interfaceAddress + u32(361), int(outputIndex)
            )
        }
        remainingRates = remainingRates >>> u32(1)
        rateIndex = rateIndex + u32(1)
    }

    val core = esp32Ieee80211PhyCoreAddress()
    if (esp32Ieee80211PhyLoadU32(core + u32(20)) == interfaceAddress) {
        esp32Ieee80211PhyStoreU8(core + u32(542), 1)
    }
    i32(0)
}

trusted fun esp32Ieee80211PhyType(interfaceAddress: u32): i32 {
    val mode = esp32Ieee80211PhyLoadU8(interfaceAddress + u32(50))
    if (mode == 4) return i32(6)
    if (mode != 3) return if (mode == 1) i32(0) else i32(1)

    val channelWidth = esp32Ieee80211PhyLoadU8(
        interfaceAddress + u32(172)
    )
    val channel = esp32Ieee80211PhyLoadU8(
        interfaceAddress + u32(171)
    )
    val narrowChannel =
        (channelWidth == 1 && ((channel - 1) & 255) <= 8) ||
        (channelWidth == 2 && ((channel - 5) & 255) <= 8)
    val enhanced = (esp32Ieee80211PhyLoadU32(
        interfaceAddress + u32(12)
    ) & u32(32768)) != u32(0)
    if (narrowChannel) {
        return if (enhanced) i32(5) else i32(4)
    }
    if (enhanced) i32(3) else i32(2)
}

trusted fun esp32Ieee80211PhyModeShow(
    interfaceAddress: u32,
    output: u32
): void {
    esp32ProvideIeee80211PhyStrings()
    val mode = esp32Ieee80211PhyLoadU8(interfaceAddress + u32(50))
    val lowRate = esp32Ieee80211PhyLoadU8(
        interfaceAddress + u32(650)
    ) != 0
    var source = u32(0)
    if (mode == 1) {
        source = if (lowRate) esp32Data_Labla_phy_lrb_25ee11a98e else esp32Data_Labla_phy_b_3c39552658
    } else if (mode == 2) {
        source = if (lowRate) esp32Data_Labla_phy_lrbg_d8654e02c3 else esp32Data_Labla_phy_bg_f689116950
    } else if (mode == 3) {
        source = if (lowRate) esp32Data_Labla_phy_lrbgn_bbe67fc79a else esp32Data_Labla_phy_bgn_a8967283ff
    } else if (mode == 4) {
        source = esp32Data_Labla_phy_bgn_a8967283ff
    }
    if (source != u32(0)) esp32Ieee80211PhyCopyString(output, source)
    return
}

trusted fun esp32Ieee80211PhyInterfaceIndex(
    interfaceAddress: u32
): int {
    val core = esp32Ieee80211PhyCoreAddress()
    if (esp32Ieee80211PhyLoadU32(core + u32(16)) == interfaceAddress) return 0
    if (esp32Ieee80211PhyLoadU32(core + u32(20)) == interfaceAddress) return 1
    2
}

trusted fun esp32Ieee80211PhyTraceMode(
    interfaceIndex: int,
    mode: int
): void {
    esp32InterfaceUpdatePhysicalMode(u32(interfaceIndex), u32(mode))
    return
}

trusted fun esp32Ieee80211PhySetLowRate(enabled: bool): void {
    if (enabled) {
        esp32RecoveredWDevEnableLowRate(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    } else {
        esp32RecoveredWDevDisableLowRate(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    }
    return
}

trusted fun esp32Ieee80211PhyInitialize(
    interfaceAddress: u32,
    bandValue: u32,
    modeValue: u32
): i32 {
    if (interfaceAddress == u32(0)) return esp32Ieee80211PhyInvalidArgument
    val band = int(bandValue) & 255
    val mode = int(modeValue)
    val interfaceIndex = esp32Ieee80211PhyInterfaceIndex(interfaceAddress)
    val status = esp32Ieee80211SetupRateTable(interfaceAddress, band, mode)
    if (status != i32(0)) return status

    esp32Ieee80211PhyTraceMode(
        interfaceIndex,
        if (mode == 4) 6 else 0
    )
    val flags = esp32Ieee80211PhyLoadU32(interfaceAddress + u32(164))
    esp32Ieee80211PhyStoreU32(
        interfaceAddress + u32(164),
        if (mode == 2 || mode == 3) flags | u32(8192)
        else flags & u32(4294959103)
    )

    if (band == 1) {
        val nvs = esp32Ieee80211PhyLoadU32(
            esp32Ieee80211PhyNvsCellAddress()
        )
        if (nvs != u32(0)) {
            val lowRate =
                esp32Ieee80211PhyLoadU8(nvs + u32(1141)) != 0 ||
                esp32Ieee80211PhyLoadU8(nvs + u32(1297)) != 0
            esp32Ieee80211PhySetLowRate(lowRate)

            if (interfaceIndex == 0) {
                esp32Ieee80211PhySetLora(
                    0, esp32Ieee80211PhyLoadU8(nvs + u32(1141)) != 0
                )
            } else if (interfaceIndex == 1) {
                esp32Ieee80211PhySetLora(
                    1, esp32Ieee80211PhyLoadU8(nvs + u32(1297)) != 0
                )
            }
        }
    }
    i32(0)
}

trusted fun esp32Ieee80211SetUserSupportedRates(
    interfaceAddress: u32,
    rateMask: u32
): bool {
    if ((rateMask & u32(4095)) == u32(0)) return false
    esp32Ieee80211PhyStoreU32(interfaceAddress + u32(436), rateMask)
    val band = esp32RecoveredChmGetCurrentBand(u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    val mode = esp32Ieee80211PhyLoadU8(interfaceAddress + u32(360))
    esp32Ieee80211SetupRateTable(interfaceAddress, int(band) & 255, mode) == i32(0)
}
