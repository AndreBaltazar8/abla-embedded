import "abla/build"

// Complete ieee80211_rfid.o ABI; all callback lifecycle and receive paths are
// owned by the Abla unit and no foreign caller remains.
compile fun esp32Idf6LinkRfidInternals(): bool {
    if (!internalFunction("esp32VendorRfidReceive", "ieee80211_rfid_locp_recv")) return false
    if (!internalFunction("esp32VendorRfidClose", "ieee80211_rfid_locp_recv_close")) return false
    if (!internalFunction("esp32VendorRfidOpen", "ieee80211_rfid_locp_recv_open")) return false
    if (!internalFunction("esp32VendorRfidReset", "ieee80211_rfid_locp_recv_reset")) return false
    if (!internalFunction("esp32VendorRfidRegister", "register_ieee80211_rfid_locp_recv_cb")) return false
    if (!internalFunction("esp32VendorRfidUnregister", "unregister_ieee80211_rfid_locp_recv_cb")) return false
    true
}
