import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNanServiceDiscoveryInternals(): bool {
    if (!internalFunction("esp32RecoveredCleanupPeerList", "cleanup_peer_list")) return false
    if (!internalFunction("esp32RecoveredNanAllWildcardFilter", "nan_all_wildcard_filter")) return false
    if (!internalFunction("esp32RecoveredNanCancelService", "nan_cancel_service")) return false
    if (!internalFunction("esp32RecoveredNanComputeServiceHash", "nan_compute_service_hash")) return false
    if (!internalFunction("esp32RecoveredNanConstructFollowupSdf", "nan_construct_followup_sdf")) return false
    if (!internalFunction("esp32RecoveredNanConstructPublishSdf", "nan_construct_publish_sdf")) return false
    if (!internalFunction("esp32RecoveredNanConstructSdea", "nan_construct_sdea")) return false
    if (!internalFunction("esp32RecoveredNanConstructSubscribeSdf", "nan_construct_subscribe_sdf")) return false
    if (!internalFunction("esp32RecoveredNanGetPeerSvcRecord", "nan_get_peer_svc_record")) return false
    if (!internalFunction("esp32RecoveredNanGetServiceById", "nan_get_service_by_id")) return false
    if (!internalFunction("esp32RecoveredNanGetServiceByIndex", "nan_get_service_by_index")) return false
    if (!internalFunction("esp32RecoveredNanGetServiceIdx", "nan_get_service_idx")) return false
    if (!internalFunction("esp32RecoveredNanInsertPeerSvcRecord", "nan_insert_peer_svc_record")) return false
    if (!internalFunction("esp32RecoveredNanMatchFilters", "nan_match_filters")) return false
    if (!internalFunction("esp32RecoveredNanRxSdf", "nan_rx_sdf")) return false
    if (!internalFunction("esp32RecoveredNanSdParseAvailability", "nan_sd_parse_availability")) return false
    if (!internalFunction("esp32RecoveredNanSdParseDevCaps", "nan_sd_parse_dev_caps")) return false
    if (!internalFunction("esp32RecoveredNanSdParseSda", "nan_sd_parse_sda")) return false
    if (!internalFunction("esp32RecoveredNanSdParseSdea", "nan_sd_parse_sdea")) return false
    if (!internalFunction("esp32RecoveredNanSdReceiveCtrl", "nan_sd_receive_ctrl")) return false
    if (!internalFunction("esp32RecoveredNanSdfTxcb", "nan_sdf_txcb")) return false
    if (!internalFunction("esp32RecoveredNanSendFollowupMsg", "nan_send_followup_msg")) return false
    if (!internalFunction("esp32RecoveredNanSendSolicitedPublish", "nan_send_solicited_publish")) return false
    if (!internalFunction("esp32RecoveredNanSendStaticSdfs", "nan_send_static_sdfs")) return false
    if (!internalFunction("esp32RecoveredNanServiceTypeDiff", "nan_service_type_diff")) return false
    if (!internalFunction("esp32RecoveredNanServicesDeinit", "nan_services_deinit")) return false
    if (!internalFunction("esp32RecoveredNanServicesInit", "nan_services_init")) return false
    if (!internalFunction("esp32RecoveredNanStartPublishService", "nan_start_publish_service")) return false
    if (!internalFunction("esp32RecoveredNanStartSubscribeService", "nan_start_subscribe_service")) return false
    if (!internalFunction("esp32RecoveredNanStaticSdfsPresent", "nan_static_sdfs_present")) return false
    if (!internalFunction("esp32RecoveredNanTolower", "nan_tolower")) return false
    if (!internalFunction("esp32RecoveredNanUpdateStaticSdfs", "nan_update_static_sdfs")) return false
    true
}
