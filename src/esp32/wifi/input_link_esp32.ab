import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkInputOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredIeee80211DeliverData", "ieee80211_deliver_data")) return false
    if (!exportFunction("esp32RecoveredIeee80211Decap", "ieee80211_decap")) return false
    if (!internalFunction("esp32RecoveredIeee80211IsSupportRate", "ieee80211_is_support_rate")) return false
    if (!internalFunction("esp32RecoveredIeee80211Is11bRate", "ieee80211_is_11b_rate")) return false
    if (!exportFunction("esp32RecoveredIeee80211SetupRates", "ieee80211_setup_rates")) return false
    if (!internalFunction("esp32RecoveredIeee80211SetMaxRate", "ieee80211_set_max_rate")) return false
    if (!internalFunction("esp32RecoveredIeee80211IsLrOnly", "ieee80211_is_lr_only")) return false
    if (!exportFunction("esp32RecoveredIeee80211SetupPhyMode", "ieee80211_setup_phy_mode")) return false
    if (!internalFunction("esp32RecoveredIeee80211SetupLrRates", "ieee80211_setup_lr_rates")) return false
    if (!internalFunction("esp32RecoveredIeee80211AllocChallenge", "ieee80211_alloc_challenge")) return false
    if (!internalFunction("esp32RecoveredIeee80211ParseBeacon", "ieee80211_parse_beacon")) return false
    if (!internalFunction("esp32RecoveredIeee80211ParseWpa", "ieee80211_parse_wpa")) return false
    if (!internalFunction("esp32RecoveredIeee80211RsnCipherPriority", "ieee80211_rsn_cipher_priority")) return false
    if (!internalFunction("esp32RecoveredIeee80211BetterRsnPairwiseCipher", "ieee80211_better_rsn_pairwise_cipher")) return false
    if (!internalFunction("esp32RecoveredIeee80211AmsduNegotiate", "ieee80211_amsdu_negotiate")) return false
    if (!internalFunction("esp32RecoveredIeee80211ParseRsn", "ieee80211_parse_rsn")) return false
    if (!internalFunction("esp32RecoveredIeee80211IsHtCipher", "ieee80211_is_ht_cipher")) return false
    if (!internalFunction("esp32RecoveredIeee80211ParseWapi", "ieee80211_parse_wapi")) return false
    if (!internalFunction("esp32RecoveredIeee80211ParseAction", "ieee80211_parse_action")) return false
    if (!internalFunction("esp32RecoveredIeee80211SetupRateset", "ieee80211_setup_rateset")) return false
    true
}
