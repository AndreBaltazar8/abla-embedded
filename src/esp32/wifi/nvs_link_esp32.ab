import "abla/build"

// Internal linkage is the default. Only commit, set, and the listen-interval
// getter retain visibility for proven supplicant/PM callers. The state
// pointer is emitted globally by the implementation while foreign users remain.
compile fun esp32Idf6LinkNvsOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredWifiNvsCfgItemInit", "wifi_nvs_cfg_item_init")) return false
    if (!internalFunction("esp32RecoveredWifiNvsCfgInit", "wifi_nvs_cfg_init")) return false
    if (!internalFunction("esp32RecoveredWifiNvsGet", "wifi_nvs_get")) return false
    if (!exportFunction("esp32RecoveredWifiNvsCommit", "wifi_nvs_commit")) return false
    if (!exportFunction("esp32RecoveredWifiNvsSet", "wifi_nvs_set")) return false
    if (!internalFunction("esp32RecoveredIeee80211Adjust2ndChan", "ieee80211_adjust_2nd_chan")) return false
    if (!internalFunction("esp32RecoveredWifiNvsCompareCfgDiff", "wifi_nvs_compare_cfg_diff")) return false
    if (!internalFunction("esp32RecoveredWifiSetDefaultSsid", "wifi_set_default_ssid")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidateApSsid", "wifi_nvs_validate_ap_ssid")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidateApPassword", "wifi_nvs_validate_ap_password")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidateStaPassword", "wifi_nvs_validate_sta_password")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidateStaSaeIdentifier", "wifi_nvs_validate_sta_sae_identifier")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidateCountry", "wifi_nvs_validate_country")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidateApChan", "wifi_nvs_validate_ap_chan")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidateApNum", "wifi_nvs_validate_ap_num")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidateStaListenInterval", "wifi_nvs_validate_sta_listen_interval")) return false
    if (!exportFunction("esp32RecoveredWifiNvsGetStaListenInterval", "wifi_nvs_get_sta_listen_interval")) return false
    if (!internalFunction("esp32RecoveredWifiNvsResetCurrentApInfo", "wifi_nvs_reset_current_ap_info")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidateLrInfo", "wifi_nvs_validate_lr_info")) return false
    if (!internalFunction("esp32RecoveredWifiNvsDeinit", "wifi_nvs_deinit")) return false
    if (!internalFunction("esp32RecoveredWifiNvsInit", "wifi_nvs_init")) return false
    true
}

// The old linker discarded these seven sections in this firmware. Their full
// implementations remain available without forcing them into every image.
compile fun esp32LinkNvsDormantApis(): bool {
    if (!internalFunction("esp32RecoveredWifiNvsStaRestore", "wifi_nvs_sta_restore")) return false
    if (!internalFunction("esp32RecoveredWifiNvsApRestore", "wifi_nvs_ap_restore")) return false
    if (!internalFunction("esp32RecoveredIeee80211NvsSetDefaultSsid", "ieee80211_nvs_set_default_ssid")) return false
    if (!internalFunction("esp32RecoveredWifiNvsValidatePhymode", "wifi_nvs_validate_phymode")) return false
    if (!internalFunction("esp32RecoveredWifiNvsSetStaListenInterval", "wifi_nvs_set_sta_listen_interval")) return false
    if (!internalFunction("esp32RecoveredWifiNvsGetLowRateEnable", "wifi_nvs_get_low_rate_enable")) return false
    if (!internalFunction("esp32RecoveredWifiNvsRestore", "wifi_nvs_restore")) return false
    true
}
