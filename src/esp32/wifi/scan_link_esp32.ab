import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32LinkScanInternals(): bool {
    if (!internalFunction("esp32RecoveredIeee80211ScanDeattach", "ieee80211_scan_deattach")) return false
    if (!internalFunction("esp32RecoveredScanGetApnum", "scan_get_apnum")) return false
    if (!internalFunction("esp32RecoveredScanSetCurrentScanTimes", "scan_set_current_scan_times")) return false
    if (!internalFunction("esp32RecoveredScanResetDefaultAppParams", "scan_reset_default_app_params")) return false
    if (!internalFunction("esp32RecoveredIeee80211ScanAttach", "ieee80211_scan_attach")) return false
    if (!internalFunction("esp32RecoveredScanSetDefaultParams", "scan_set_default_params")) return false
    if (!internalFunction("esp32RecoveredWifiStaSetScanDefaultParams", "wifi_sta_set_scan_default_params")) return false
    if (!internalFunction("esp32RecoveredScanPmOffchan", "scan_pm_offchan")) return false
    if (!internalFunction("esp32RecoveredScanStartHandler", "scan_start_handler")) return false
    if (!internalFunction("esp32RecoveredScanStart", "scan_start")) return false
    if (!internalFunction("esp32RecoveredScanPmChannelOpCb", "scan_pm_channel_op_cb")) return false
    if (!internalFunction("esp32RecoveredScanFlushAllTxBuf", "scan_flush_all_tx_buf")) return false
    if (!internalFunction("esp32RecoveredScanCancel", "scan_cancel")) return false
    if (!internalFunction("esp32RecoveredScanAddBssid", "scan_add_bssid")) return false
    if (!internalFunction("esp32RecoveredScanRemoveBssid", "scan_remove_bssid")) return false
    if (!internalFunction("esp32RecoveredScanSetActDuration", "scan_set_act_duration")) return false
    if (!internalFunction("esp32RecoveredScanSetPasDuration", "scan_set_pas_duration")) return false
    if (!internalFunction("esp32RecoveredScanSetHomeChanDwellTime", "scan_set_home_chan_dwell_time")) return false
    if (!internalFunction("esp32RecoveredScanAddProbeSsid", "scan_add_probe_ssid")) return false
    if (!internalFunction("esp32RecoveredScanRemoveProbeSsid", "scan_remove_probe_ssid")) return false
    if (!internalFunction("esp32RecoveredScanPreferChan", "scan_prefer_chan")) return false
    if (!internalFunction("esp32RecoveredScanUpdateScanHistory", "scan_update_scan_history")) return false
    if (!internalFunction("esp32RecoveredScanBuildChanList", "scan_build_chan_list")) return false
    if (!internalFunction("esp32RecoveredScanEnterOperChannelHandler", "scan_enter_oper_channel_handler")) return false
    if (!internalFunction("esp32RecoveredScanEnterOperChannelProcess", "scan_enter_oper_channel_process")) return false
    if (!internalFunction("esp32RecoveredScanBitmapToChannelList", "scan_bitmap_to_channel_list")) return false
    if (!internalFunction("esp32RecoveredScanSetDesChan", "scan_set_desChan")) return false
    if (!internalFunction("esp32RecoveredScanGetType", "scan_get_type")) return false
    if (!internalFunction("esp32RecoveredCannelScanConnectState", "cannel_scan_connect_state")) return false
    if (!internalFunction("esp32RecoveredScanConnectState", "scan_connect_state")) return false
    if (!internalFunction("esp32RecoveredScanCheckHidden", "scan_check_hidden")) return false
    if (!internalFunction("esp32RecoveredScanResetCipherAndAkm", "scan_reset_cipher_and_akm")) return false
    if (!internalFunction("esp32RecoveredCnxGetAuthtypeStrength", "cnx_get_authtype_strength")) return false
    if (!internalFunction("esp32RecoveredScanProfileCheck", "scan_profile_check")) return false
    if (!internalFunction("esp32RecoveredFreeBssInfo", "free_bss_info")) return false
    if (!internalFunction("esp32RecoveredClearBssQueue", "clear_bss_queue")) return false
    if (!internalFunction("esp32RecoveredScanInterChannelTimeoutProcess", "scan_inter_channel_timeout_process")) return false
    if (!internalFunction("esp32RecoveredCheckBssQueue", "check_bss_queue")) return false
    if (!internalFunction("esp32RecoveredScanSetScanId", "scan_set_scan_id")) return false
    if (!internalFunction("esp32RecoveredScanGetScanId", "scan_get_scan_id")) return false
    if (!internalFunction("esp32RecoveredScanParseHt2040Coex", "scan_parse_ht2040_coex")) return false
    if (!internalFunction("esp32RecoveredScanFillWpsScanIe", "scan_fill_wps_scan_ie")) return false
    if (!internalFunction("esp32RecoveredScanGetOweChannelInfo", "scan_get_owe_channel_info")) return false
    if (!internalFunction("esp32RecoveredScanValidateOweScenarios", "scan_validate_owe_scenarios")) return false
    if (!internalFunction("esp32RecoveredScanParseBeacon", "scan_parse_beacon")) return false
    true
}
