import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNanCommonOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredNanActionFramesQueued", "nan_action_frames_queued")) return false
    if (!internalFunction("esp32RecoveredNanAllocAction", "nan_alloc_action")) return false
    if (!internalFunction("esp32RecoveredNanAllocBeacon", "nan_alloc_beacon")) return false
    if (!internalFunction("esp32RecoveredNanAllocSdf", "nan_alloc_sdf")) return false
    if (!internalFunction("esp32RecoveredNanCallActionTxdoneCb", "nan_call_action_txdone_cb")) return false
    if (!internalFunction("esp32RecoveredNanCallNdpConfirmCb", "nan_call_ndp_confirm_cb")) return false
    if (!internalFunction("esp32RecoveredNanCallNdpIndicationCb", "nan_call_ndp_indication_cb")) return false
    if (!internalFunction("esp32RecoveredNanCallNdpTerminatedCb", "nan_call_ndp_terminated_cb")) return false
    if (!internalFunction("esp32RecoveredNanCallReceiveCb", "nan_call_receive_cb")) return false
    if (!internalFunction("esp32RecoveredNanCallRepliedCb", "nan_call_replied_cb")) return false
    if (!internalFunction("esp32RecoveredNanCallServiceMatchCb", "nan_call_service_match_cb")) return false
    if (!internalFunction("esp32RecoveredNanDiscDisableRx", "nan_disc_disable_rx")) return false
    if (!internalFunction("esp32RecoveredNanDiscEnableRx", "nan_disc_enable_rx")) return false
    if (!internalFunction("esp32RecoveredNanFlushActionQ", "nan_flush_action_q")) return false
    if (!internalFunction("esp32RecoveredNanGetClustId", "nan_get_clust_id")) return false
    if (!internalFunction("esp32RecoveredNanGetRandomByte", "nan_get_random_byte")) return false
    if (!internalFunction("esp32RecoveredNanGetRandomWord", "nan_get_random_word")) return false
    if (!internalFunction("esp32RecoveredNanGetTsf", "nan_get_tsf")) return false
    if (!internalFunction("esp32RecoveredNanInput", "nan_input")) return false
    if (!internalFunction("esp32RecoveredNanIsInDw", "nan_is_in_dw")) return false
    if (!internalFunction("esp32RecoveredNanMgmtTxcb", "nan_mgmt_txcb")) return false
    if (!internalFunction("esp32RecoveredNanPostEvent", "nan_post_event")) return false
    if (!internalFunction("esp32RecoveredNanRegisterCallbacks", "nan_register_callbacks")) return false
    if (!internalFunction("esp32RecoveredNanRxCb", "nan_rx_cb")) return false
    if (!internalFunction("esp32RecoveredNanSetConfigLocal", "nan_set_config_local")) return false
    if (!internalFunction("esp32RecoveredNanSetTrc", "nan_set_trc")) return false
    if (!internalFunction("esp32RecoveredNanSetUpdateSdfPending", "nan_set_update_sdf_pending")) return false
    if (!internalFunction("esp32RecoveredNanStart", "nan_start")) return false
    if (!internalFunction("esp32RecoveredNanStop", "nan_stop")) return false
    if (!internalFunction("esp32RecoveredNanTransmitAction", "nan_transmit_action")) return false
    if (!internalFunction("esp32RecoveredNanTransmitBcn", "nan_transmit_bcn")) return false
    if (!internalFunction("esp32RecoveredNanTxActionFrame", "nan_tx_action_frame")) return false
    if (!internalFunction("esp32RecoveredNanTxQueuedActionFrames", "nan_tx_queued_action_frames")) return false
    if (!internalFunction("esp32RecoveredNanUpdateTsf", "nan_update_tsf")) return false
    if (!internalFunction("esp32RecoveredWifiNanRegRxcb", "wifi_nan_reg_rxcb")) return false
    true
}
