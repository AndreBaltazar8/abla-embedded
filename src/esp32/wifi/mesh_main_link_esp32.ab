import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshMainInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMeshDeliveryToDS", "esp_mesh_delivery_toDS")) return false
    if (!internalFunction("esp32RecoveredEspMeshDeliveryToSelf", "esp_mesh_delivery_toSelf")) return false
    if (!internalFunction("esp32RecoveredEspMeshForwardPacket", "esp_mesh_forward_packet")) return false
    if (!internalFunction("esp32RecoveredEspMeshGetOptlen", "esp_mesh_get_optlen")) return false
    if (!internalFunction("esp32RecoveredEspMeshMcastCoverNode", "esp_mesh_mcast_cover_node")) return false
    if (!internalFunction("esp32RecoveredEspMeshProcessBcast", "esp_mesh_process_bcast")) return false
    if (!internalFunction("esp32RecoveredEspMeshProcessMcast", "esp_mesh_process_mcast")) return false
    if (!internalFunction("esp32RecoveredEspMeshProcessOptions", "esp_mesh_process_options")) return false
    if (!internalFunction("esp32RecoveredEspMeshProcessUcast", "esp_mesh_process_ucast")) return false
    if (!internalFunction("esp32RecoveredMeshProcessMcastCoverNode", "mesh_process_mcast_cover_node")) return false
    if (!internalFunction("esp32RecoveredMeshProcessMgmtAnnounce", "mesh_process_mgmt_announce")) return false
    if (!internalFunction("esp32RecoveredMeshProcessMgmtRootSwitch", "mesh_process_mgmt_root_switch")) return false
    if (!internalFunction("esp32RecoveredMeshProcessMgmtRootWaive", "mesh_process_mgmt_root_waive")) return false
    if (!internalFunction("esp32RecoveredMeshProcessMgmtRoutingTable", "mesh_process_mgmt_routing_table")) return false
    if (!internalFunction("esp32RecoveredMeshRemoveMyselfFromForwarding", "mesh_remove_myself_from_forwarding")) return false
    if (!internalFunction("esp32RecoveredOptype2str", "optype2str")) return false
    true
}
