import "abla/unsafe/native"
import "../radio/wifi_device_esp32.ab"

// Optional Neighbor Awareness Networking operations. Generic Wi-Fi RX/TX and
// lifecycle code calls these slots, while a NAN-capable application installs
// the complete implementation through nan_profile_esp32.ab. Zero is the
// disabled profile and deliberately has no static edge to NAN code.
var esp32NanDestroyHook: u32 = u32(0)
var esp32NanStopHook: u32 = u32(0)
var esp32NanDpPostTxHook: u32 = u32(0)
var esp32NanDpSearchNodeHook: u32 = u32(0)
var esp32NanPacketValidHook: u32 = u32(0)
var esp32NanRxDataHook: u32 = u32(0)
var esp32NanRegisterRxHook: u32 = u32(0)
var esp32NanClusterIdHook: u32 = u32(0)

trusted fun esp32ConfigureNanProfile(
    destroy:u32,
    stop:u32,
    postTx:u32,
    searchNode:u32,
    packetValid:u32,
    rxData:u32,
    registerRx:u32,
    clusterId:u32
):void {
    esp32NanDestroyHook = destroy
    esp32NanStopHook = stop
    esp32NanDpPostTxHook = postTx
    esp32NanDpSearchNodeHook = searchNode
    esp32NanPacketValidHook = packetValid
    esp32NanRxDataHook = rxData
    esp32NanRegisterRxHook = registerRx
    esp32NanClusterIdHook = clusterId
    return
}

@inline
trusted fun esp32NanOptionalCall6(
    callback:u32,a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32
):u32 {
    if (callback == u32(0)) return u32(0)
    u32(ablaUnsafeCallI32I32I32I32I32I32I32(
        int(callback),int(a2),int(a3),int(a4),int(a5),int(a6),int(a7)
    ))
}

trusted fun esp32OptionalWifiDestroyNan(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
):u32 = esp32NanOptionalCall6(
    esp32NanDestroyHook,a2,a3,a4,a5,a6,a7)

trusted fun esp32OptionalNanStop(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
):u32 = esp32NanOptionalCall6(
    esp32NanStopHook,a2,a3,a4,a5,a6,a7)

trusted fun esp32OptionalNanDpPostTx(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
):u32 = esp32NanOptionalCall6(
    esp32NanDpPostTxHook,a2,a3,a4,a5,a6,a7)

trusted fun esp32OptionalNanDpSearchNode(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
):u32 = esp32NanOptionalCall6(
    esp32NanDpSearchNodeHook,a2,a3,a4,a5,a6,a7)

trusted fun esp32OptionalNanPacketValid(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
):u32 {
    // The base WDEV predicate accepts ordinary interfaces. Only NAN packets
    // require an installed slot callback; an absent NAN profile must not
    // discard normal station/AP transmissions before the MAC queue commit.
    if (esp32NanPacketValidHook == u32(0)) {
        return esp32RecoveredWDevIsNANPktInValidSlot(
            a2,a3,a4,a5,a6,a7,stack0,stack1,stack2,stack3,stack4,
            stack5,stack6,stack7,stack8,stack9
        )
    }
    return esp32NanOptionalCall6(
        esp32NanPacketValidHook,a2,a3,a4,a5,a6,a7
    )
}

trusted fun esp32OptionalNanRxData(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    stack0:u32,stack1:u32,stack2:u32,stack3:u32,stack4:u32,
    stack5:u32,stack6:u32,stack7:u32,stack8:u32,stack9:u32
