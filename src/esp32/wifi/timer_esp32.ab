// Install a callback into the shared IEEE 802.11 timer dispatch table. Optional
// profiles call this at startup; disabled profiles leave their slots empty, so
// their callback graph remains unreachable in a monolithic build.
trusted fun esp32ConfigureWifiTimerCallback(timerId:u32, callback:u32):bool {
