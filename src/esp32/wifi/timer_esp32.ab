    var remaining = u32(35)
    while (remaining != u32(0)) {
        if (u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(entry)))) == timerId) {
            ablaUnsafeStoreU32(nativePointerFromAddress(int(entry + u32(4))), int(callback))
            return true
        }
        entry = entry + u32(8)
        remaining = remaining - u32(1)
    }
    false
}
