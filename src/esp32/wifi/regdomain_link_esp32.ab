import "abla/build"

// Internal linkage is the default. The four exported names below each have a
// proven caller in a remaining supplicant or ESP-NOW object; they can become
// local as those members move into this LLVM unit. The max/min channel helpers
// became local when the channel manager joined this unit.
compile fun esp32Idf6LinkRegdomainOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredIeee80211RegdomainGetCountry", "ieee80211_regdomain_get_country")) return false
    if (!internalFunction("esp32RecoveredIeee80211UpdatePhyCountry", "ieee80211_update_phy_country")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainUpdate", "ieee80211_regdomain_update")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainUpdateInScan", "ieee80211_regdomain_update_in_scan")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainUpdateInConnect", "ieee80211_regdomain_update_in_connect")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainMaxChan", "ieee80211_regdomain_max_chan")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainApMaxChan", "ieee80211_regdomain_ap_max_chan")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainMinChan", "ieee80211_regdomain_min_chan")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainApMinChan", "ieee80211_regdomain_ap_min_chan")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainChanNum", "ieee80211_regdomain_chan_num")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainPolicy", "ieee80211_regdomain_policy")) return false
    if (!exportFunction("esp32RecoveredIeee80211RegdomainChanInRange", "ieee80211_regdomain_chan_in_range")) return false
    if (!exportFunction("esp32RecoveredIeee80211RegdomainCheckChannel", "ieee80211_regdomain_check_channel")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainCheckApChannel", "ieee80211_regdomain_check_ap_channel")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainIsActiveScan", "ieee80211_regdomain_is_active_scan")) return false
    if (!exportFunction("esp32RecoveredIeee80211GetRegdomain", "ieee80211_get_regdomain")) return false
    if (!exportFunction("esp32RecoveredGetChannelMaxBandwidth", "get_channel_max_bandwidth")) return false
    if (!internalFunction("esp32RecoveredIeee80211Is40mhzValidBw", "ieee80211_is_40mhz_valid_bw")) return false
    if (!internalFunction("esp32RecoveredIeee80211RegdomainGetCountryInfo", "ieee80211_regdomain_get_country_info")) return false
    true
}

// Complete but currently unreachable entry points. Opt in only when a program
// needs these APIs; leaving this selector unused makes both bodies disappear.
compile fun esp32LinkRegdomainStandaloneApis(): bool {
    if (!internalFunction("esp32RecoveredIeee80211RegdomainMaxTxPower", "ieee80211_regdomain_max_tx_power")) return false
    if (!internalFunction("esp32RecoveredIeee80211AddCountryie", "ieee80211_add_countryie")) return false
    true
}
