import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRecoveredIeee80211CoreOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredBand2str", "band2str")) return false
    if (!internalFunction("esp32RecoveredIeee80211FindElem", "ieee80211_find_elem")) return false
    if (!internalFunction("esp32RecoveredIeee80211FindElemMatch", "ieee80211_find_elem_match")) return false
    if (!internalFunction("esp32RecoveredIeee80211FindExtElem", "ieee80211_find_ext_elem")) return false
    if (!internalFunction("esp32RecoveredIeee80211FindExtIe", "ieee80211_find_ext_ie")) return false
    if (!internalFunction("esp32RecoveredIeee80211FindIe", "ieee80211_find_ie")) return false
    if (!internalFunction("esp32RecoveredIeee80211FindIeMatch", "ieee80211_find_ie_match")) return false
    if (!internalFunction("esp32RecoveredIeee80211FreedomDeinit", "ieee80211_freedom_deinit")) return false
    if (!internalFunction("esp32RecoveredIeee80211FreedomInit", "ieee80211_freedom_init")) return false
    if (!internalFunction("esp32RecoveredIeee80211FreedomInsideCb", "ieee80211_freedom_inside_cb")) return false
    if (!internalFunction("esp32RecoveredIeee80211GetTxInfoFromEb", "ieee80211_get_tx_info_from_eb")) return false
    if (!internalFunction("esp32RecoveredIeee80211Ifattach", "ieee80211_ifattach")) return false
    if (!internalFunction("esp32RecoveredIeee80211Ifdetach", "ieee80211_ifdetach")) return false
    if (!internalFunction("esp32RecoveredIeee80211IsRobustMgmtFrm", "ieee80211_is_robust_mgmt_frm")) return false
    if (!internalFunction("esp32RecoveredIeee80211RateRefInit", "ieee80211_rate_ref_init")) return false
    if (!internalFunction("esp32RecoveredIeee80211SetupPmf", "ieee80211_setup_pmf")) return false
    if (!internalFunction("esp32RecoveredIeee80211UserIeInit", "ieee80211_user_ie_init")) return false
    if (!internalFunction("esp32RecoveredWifiCreateNan", "wifi_create_nan")) return false
    if (!internalFunction("esp32RecoveredWifiCreateSoftap", "wifi_create_softap")) return false
    if (!internalFunction("esp32RecoveredWifiCreateSta", "wifi_create_sta")) return false
    if (!internalFunction("esp32RecoveredWifiDestroyNan", "wifi_destroy_nan")) return false
    if (!internalFunction("esp32RecoveredWifiDestroySoftap", "wifi_destroy_softap")) return false
    if (!internalFunction("esp32RecoveredWifiDestroySta", "wifi_destroy_sta")) return false
    if (!internalFunction("esp32RecoveredWifiGetRandMacaddr", "wifi_get_rand_macaddr")) return false
    if (!internalFunction("esp32RecoveredWifiGetRandMacaddrKeepOui", "wifi_get_rand_macaddr_keep_oui")) return false
    if (!internalFunction("esp32RecoveredWifiModeSet", "wifi_mode_set")) return false
    if (!internalFunction("esp32RecoveredWifiRecycleRxPkt", "wifi_recycle_rx_pkt")) return false
    true
}
