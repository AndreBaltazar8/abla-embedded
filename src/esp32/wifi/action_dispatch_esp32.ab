import "../../xtensa/assembly.ab"

// IEEE 802.11 management-action callback dispatch for the classic ESP32. Each
// category table lives in its own local section: an application that never
// selects a category can discard both its storage and all callback paths. Only
// the four ESP Wi-Fi ABI entry points below are public symbols.

@naked
@noinline
@export("ieee80211_send_action_register")
trusted fun esp32Ieee80211SendActionRegister(
    category: u32,
    action: u32,
    callback: u32
): u32 = xtensaAssemblyReadU32(
    ".pushsection .text.abla_send_action_invalid,\"ax\",@progbits
.balign 4
.type .Labla_send_action_invalid,@function
.Labla_send_action_invalid:
entry a1, 32
movi.n a2, -1
retw.n
.size .Labla_send_action_invalid, .-.Labla_send_action_invalid
.popsection
.pushsection .text.abla_recv_action_invalid,\"ax\",@progbits
.balign 4
.type .Labla_recv_action_invalid,@function
.Labla_recv_action_invalid:
entry a1, 32
movi.n a2, -1
retw.n
.size .Labla_recv_action_invalid, .-.Labla_recv_action_invalid
.popsection
.pushsection .rodata.abla_action_dispatch,\"a\",@progbits
.Labla_action_source:
.asciz \"ieee80211_action.c\"
.Labla_action_null_format:
.asciz \"%s %d\\n\"
.popsection
.pushsection .data.abla_ba_send_action,\"aw\",@progbits
.balign 4
.Labla_ba_send_action:
.rept 3
.long .Labla_send_action_invalid
.endr
.popsection
.pushsection .data.abla_ht_send_action,\"aw\",@progbits
.balign 4
.Labla_ht_send_action:
.long .Labla_send_action_invalid
.popsection
.pushsection .data.abla_vendor_send_action,\"aw\",@progbits
.balign 4
.Labla_vendor_send_action:
.long .Labla_send_action_invalid
.popsection
.pushsection .data.abla_sa_query_send_action,\"aw\",@progbits
.balign 4
.Labla_sa_query_send_action:
.rept 2
.long .Labla_send_action_invalid
.endr
.popsection
.pushsection .data.abla_ba_recv_action,\"aw\",@progbits
.balign 4
.Labla_ba_recv_action:
.rept 3
.long .Labla_recv_action_invalid
.endr
.popsection
.pushsection .data.abla_ht_recv_action,\"aw\",@progbits
.balign 4
.Labla_ht_recv_action:
.long .Labla_recv_action_invalid
.popsection
.pushsection .data.abla_vendor_recv_action,\"aw\",@progbits
.balign 4
.Labla_vendor_recv_action:
.long .Labla_recv_action_invalid
.popsection
.pushsection .data.abla_sa_query_recv_action,\"aw\",@progbits
.balign 4
.Labla_sa_query_recv_action:
.rept 2
.long .Labla_recv_action_invalid
.endr
.popsection
.pushsection .data.abla_public_recv_action,\"aw\",@progbits
.balign 4
.Labla_public_recv_action:
.rept 34
.long .Labla_recv_action_invalid
.endr
.popsection
entry a1, 32
beqi a2, 8, .Labla_send_register_sa
movi.n a8, 8
blt a8, a2, .Labla_send_register_above_eight
beqi a2, 3, .Labla_send_register_ba
beqi a2, 7, .Labla_send_register_ht
j .Labla_send_register_invalid
.Labla_send_register_above_eight:
movi a8, 127
bne a2, a8, .Labla_send_register_invalid
bnez a3, .Labla_send_register_invalid
movi a2, .Labla_vendor_send_action
j .Labla_send_register_store_single
.Labla_send_register_ba:
bgeui a3, 3, .Labla_send_register_invalid
movi a2, .Labla_ba_send_action
j .Labla_send_register_store_indexed
.Labla_send_register_ht:
bnez a3, .Labla_send_register_invalid
movi a2, .Labla_ht_send_action
.Labla_send_register_store_single:
s32i.n a4, a2, 0
movi.n a2, 0
memw
retw.n
.Labla_send_register_sa:
bgeui a3, 2, .Labla_send_register_invalid
movi a2, .Labla_sa_query_send_action
.Labla_send_register_store_indexed:
addx4 a3, a3, a2
s32i.n a4, a3, 0
movi.n a2, 0
memw
retw.n
.Labla_send_register_invalid:
movi.n a2, -1
retw.n",
    "~{memory}"
)

trusted fun esp32Ieee80211SendActionUnregister(
    category: u32,
    action: u32
): u32 = xtensaAssemblyReadU32WithU32U32(
    "mov.n a10, $1
mov.n a11, $2
movi a12, .Labla_send_action_invalid
call8 ieee80211_send_action_register
mov.n $0, a10",
    "=&a,a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
    category,
    action
)

@naked
@noinline
@export("ieee80211_send_action")
trusted fun esp32Ieee80211SendAction(
    interfaceAddress: u32,
    category: u32,
    action: u32,
    argumentAddress: u32
): u32 = xtensaAssemblyReadU32(
    "entry a1, 32
mov.n a10, a2
mov.n a11, a3
mov.n a12, a4
mov.n a13, a5
beqz a10, .Labla_send_action_null
beqi a3, 8, .Labla_send_action_sa
movi.n a8, 8
blt a8, a3, .Labla_send_action_above_eight
beqi a3, 3, .Labla_send_action_ba
beqi a3, 7, .Labla_send_action_ht
j .Labla_send_action_invalid_category
.Labla_send_action_above_eight:
movi a8, 127
bne a3, a8, .Labla_send_action_invalid_category
bnez a4, .Labla_send_action_invalid_category
movi a2, .Labla_vendor_send_action
j .Labla_send_action_load
.Labla_send_action_ba:
bgeui a4, 3, .Labla_send_action_invalid_category
movi a2, .Labla_ba_send_action
j .Labla_send_action_load_indexed
.Labla_send_action_ht:
bnez a4, .Labla_send_action_invalid_category
movi a2, .Labla_ht_send_action
j .Labla_send_action_load
.Labla_send_action_sa:
bgeui a4, 2, .Labla_send_action_invalid_category
movi a2, .Labla_sa_query_send_action
.Labla_send_action_load_indexed:
addx4 a2, a12, a2
.Labla_send_action_load:
l32i.n a8, a2, 0
callx8 a8
mov.n a2, a10
retw.n
.Labla_send_action_invalid_category:
movi a8, .Labla_send_action_invalid
callx8 a8
mov.n a2, a10
retw.n
.Labla_send_action_null:
movi.n a2, 1
retw.n",
    "~{memory}"
)

@naked
@noinline
@export("ieee80211_recv_action_register")
trusted fun esp32Ieee80211ReceiveActionRegister(
    category: u32,
    action: u32,
    callback: u32
): u32 = xtensaAssemblyReadU32(
    "entry a1, 32
beqi a2, 7, .Labla_recv_register_ht
bgei a2, 8, .Labla_recv_register_at_least_eight
beqi a2, 3, .Labla_recv_register_ba
beqi a2, 4, .Labla_recv_register_public
j .Labla_recv_register_invalid
.Labla_recv_register_at_least_eight:
beqi a2, 8, .Labla_recv_register_sa
movi a8, 127
bne a2, a8, .Labla_recv_register_invalid
bnez a3, .Labla_recv_register_invalid
movi a2, .Labla_vendor_recv_action
j .Labla_recv_register_store_single
.Labla_recv_register_ba:
bgeui a3, 3, .Labla_recv_register_invalid
movi a2, .Labla_ba_recv_action
j .Labla_recv_register_store_indexed
.Labla_recv_register_ht:
bnez a3, .Labla_recv_register_invalid
movi a2, .Labla_ht_recv_action
.Labla_recv_register_store_single:
s32i.n a4, a2, 0
movi.n a2, 0
memw
retw.n
.Labla_recv_register_sa:
bgeui a3, 2, .Labla_recv_register_invalid
movi a2, .Labla_sa_query_recv_action
j .Labla_recv_register_store_indexed
.Labla_recv_register_public:
movi.n a8, 33
bltu a8, a3, .Labla_recv_register_invalid
movi a2, .Labla_public_recv_action
.Labla_recv_register_store_indexed:
addx4 a3, a3, a2
s32i.n a4, a3, 0
movi.n a2, 0
memw
retw.n
.Labla_recv_register_invalid:
movi.n a2, -1
retw.n",
    "~{memory}"
)

// Cross the temporary archive ABI by name when internal Abla code installs a
// callback. Calling the exported naked declaration as a normal Abla function
// would retain a second copy of its label-bearing assembly body.
@inline
trusted fun esp32Ieee80211ReceiveActionRegisterAbi(
    category: u32,
    action: u32,
    callback: u32
): u32 = xtensaAssemblyReadU32WithU32U32U32(
    "mov.n a10, $1
mov.n a11, $2
mov.n a12, $3
call8 ieee80211_recv_action_register
mov.n $0, a10",
    "=&a,a,a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
    category,
    action,
    callback
)

trusted fun esp32Ieee80211ReceiveActionUnregister(
    category: u32,
    action: u32
): u32 = xtensaAssemblyReadU32WithU32U32(
    "mov.n a10, $1
mov.n a11, $2
movi a12, .Labla_recv_action_invalid
call8 ieee80211_recv_action_register
mov.n $0, a10",
    "=&a,a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
    category,
    action
)

@naked
@noinline
@export("ieee80211_recv_action")
trusted fun esp32Ieee80211ReceiveAction(
    interfaceAddress: u32,
    peerAddress: u32,
    frameAddress: u32,
    metadataAddress: u32
): u32 = xtensaAssemblyReadU32(
    "entry a1, 32
mov.n a10, a2
mov.n a11, a3
mov.n a12, a4
mov.n a13, a5
bnez a2, .Labla_recv_action_dispatch
movi.n a10, 1
movi a11, 2048
movi.n a12, 1
movi a13, .Labla_action_null_format
movi a14, .Labla_action_source
movi a15, 437
call8 wifi_log
.Labla_recv_action_null_loop:
j .Labla_recv_action_null_loop
.Labla_recv_action_dispatch:
l8ui a8, a4, 0
beqi a8, 7, .Labla_recv_action_ht
bgeui a8, 8, .Labla_recv_action_at_least_eight
beqi a8, 3, .Labla_recv_action_ba
beqi a8, 4, .Labla_recv_action_public
j .Labla_recv_action_invalid_category
.Labla_recv_action_at_least_eight:
beqi a8, 8, .Labla_recv_action_sa
movi a2, 127
bne a8, a2, .Labla_recv_action_invalid_category
l8ui a2, a4, 1
bnez a2, .Labla_recv_action_invalid_category
movi a2, .Labla_vendor_recv_action
j .Labla_recv_action_load
.Labla_recv_action_ba:
l8ui a8, a4, 1
bgeui a8, 3, .Labla_recv_action_invalid_category
movi a2, .Labla_ba_recv_action
j .Labla_recv_action_load_indexed
.Labla_recv_action_ht:
l8ui a8, a4, 1
bnez a8, .Labla_recv_action_invalid_category
movi a2, .Labla_ht_recv_action
j .Labla_recv_action_load
.Labla_recv_action_sa:
l8ui a8, a4, 1
bgeui a8, 2, .Labla_recv_action_invalid_category
movi a2, .Labla_sa_query_recv_action
j .Labla_recv_action_load_indexed
.Labla_recv_action_public:
l8ui a8, a4, 1
movi.n a2, 33
bltu a2, a8, .Labla_recv_action_invalid_category
movi a2, .Labla_public_recv_action
.Labla_recv_action_load_indexed:
addx4 a8, a8, a2
l32i.n a8, a8, 0
j .Labla_recv_action_call
.Labla_recv_action_load:
l32i.n a8, a2, 0
j .Labla_recv_action_call
.Labla_recv_action_invalid_category:
movi a8, .Labla_recv_action_invalid
.Labla_recv_action_call:
callx8 a8
mov.n a2, a10
retw.n",
    "~{memory}"
)
