import "abla/build"

// The implementation is ordinary Abla. Keep only the five names still called
// by the opaque ESP-NOW archive visible at the ELF boundary.
compile fun esp32Idf6LinkActionVendorOpaqueCallers(): bool {
    if (!internalFunction("esp32VendorActionGetKey", "get_iav_key")) return false
    if (!exportFunction("esp32VendorActionRegisterGetKeyCallback", "register_ieee80211_action_vendor_get_key_cb")) return false
    if (!exportFunction("esp32VendorActionUnregisterGetKeyCallback", "unregister_ieee80211_action_vendor_get_key_cb")) return false
    if (!internalFunction("esp32VendorActionAddEspHeader", "ieee80211_add_action_vendor_spec_esp")) return false
    if (!internalFunction("esp32VendorActionAllocate", "ieee80211_alloc_action_vendor_spec")) return false
    if (!internalFunction("esp32VendorActionConstruct", "ieee80211_construct_action_vendor_spec")) return false
    if (!exportFunction("esp32VendorActionSend", "ieee80211_send_action_vendor_spec")) return false
    if (!internalFunction("esp32VendorActionReceiveEspNow", "ieee80211_recv_action_vendor_esp_now")) return false
    if (!internalFunction("esp32VendorActionReceive", "ieee80211_recv_action_vendor_spec")) return false
    if (!internalFunction("esp32VendorActionAttach", "ieee80211_action_vendor_spec_attach")) return false
    if (!exportFunction("esp32VendorActionRegisterCallback", "register_ieee80211_action_vendor_spec_cb")) return false
    if (!exportFunction("esp32VendorActionUnregisterCallback", "unregister_ieee80211_action_vendor_spec_cb")) return false
    true
}
