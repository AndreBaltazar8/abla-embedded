    if (!internalFunction("esp32RecoveredEspWifiEbTxStatusSuccessInternal", "esp_wifi_eb_tx_status_success_internal")) return false
    if (!internalFunction("esp32RecoveredEspWifiInternalGetMacClockTime", "esp_wifi_internal_get_mac_clock_time")) return false
    if (!internalFunction("esp32RecoveredEspWifiRegister80211TxCb", "esp_wifi_register_80211_tx_cb")) return false
    true
}
