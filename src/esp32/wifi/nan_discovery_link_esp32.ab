import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNanDiscoveryInternals(): bool {
    if (!internalFunction("esp32RecoveredNanAmEventHdlr", "nan_am_event_hdlr")) return false
    if (!internalFunction("esp32RecoveredNanDwEndProcess", "nan_dw_end_process")) return false
    if (!internalFunction("esp32RecoveredNanDwStartProcess", "nan_dw_start_process")) return false
    if (!internalFunction("esp32RecoveredNanFawEndProcess", "nan_faw_end_process")) return false
    if (!internalFunction("esp32RecoveredNanFawStartProcess", "nan_faw_start_process")) return false
    if (!internalFunction("esp32RecoveredNanFillDynamicAttr", "nan_fill_dynamic_attr")) return false
    if (!internalFunction("esp32RecoveredNanInTransitEventHdlr", "nan_in_transit_event_hdlr")) return false
    if (!internalFunction("esp32RecoveredNanMasterEventHdlr", "nan_master_event_hdlr")) return false
    if (!internalFunction("esp32RecoveredNanNdcStartProcess", "nan_ndc_start_process")) return false
    if (!internalFunction("esp32RecoveredNanNmnsEventHdlr", "nan_nmns_event_hdlr")) return false
    if (!internalFunction("esp32RecoveredNanNmsEventHdlr", "nan_nms_event_hdlr")) return false
    if (!internalFunction("esp32RecoveredNanScanEventHdlr", "nan_scan_event_hdlr")) return false
    if (!internalFunction("esp32RecoveredNanScanTimeoutProcess", "nan_scan_timeout_process")) return false
    if (!internalFunction("esp32RecoveredNanScheduleDiscBcn", "nan_schedule_disc_bcn")) return false
    if (!internalFunction("esp32RecoveredNanSendActionProcess", "nan_send_action_process")) return false
    if (!internalFunction("esp32RecoveredNanSendDiscBcnProcess", "nan_send_disc_bcn_process")) return false
    if (!internalFunction("esp32RecoveredNanSendStartedEvent", "nan_send_started_event")) return false
    if (!internalFunction("esp32RecoveredNanSendSyncBcnProcess", "nan_send_sync_bcn_process")) return false
    if (!internalFunction("esp32RecoveredNanSmDeinit", "nan_sm_deinit")) return false
    if (!internalFunction("esp32RecoveredNanSmHandleEvent", "nan_sm_handle_event")) return false
    if (!internalFunction("esp32RecoveredNanSmHandleEventInternal", "nan_sm_handle_event_internal")) return false
    if (!internalFunction("esp32RecoveredNanSmInit", "nan_sm_init")) return false
    if (!internalFunction("esp32RecoveredNanSmStart", "nan_sm_start")) return false
    if (!internalFunction("esp32RecoveredNanSmStop", "nan_sm_stop")) return false
    if (!internalFunction("esp32RecoveredNanWarmupTimeoutProcess", "nan_warmup_timeout_process")) return false
    true
}
