import "abla/unsafe/memory"
import "abla/unsafe/native"

// Mesh is an optional ESP-IDF component. Keep the always-present Wi-Fi ioctl
// dispatcher independent from the much larger mesh implementation: importing
// mesh installs these internal handlers, while non-mesh firmware retains only
// the tiny unavailable path and LLVM can prune the complete mesh graph.
val esp32OptionalMeshOperationsStorage = nativeStaticAllocate(52)
val esp32OptionalMeshOperations = u32(esp32OptionalMeshOperationsStorage)

val esp32OptionalMeshQuickGet = u32(0)
val esp32OptionalMeshQuickSet = u32(1)
val esp32OptionalMeshRootsGet = u32(2)
val esp32OptionalMeshRootsSet = u32(3)
val esp32OptionalMeshSetIeCryptoConfig = u32(4)
val esp32OptionalMeshSetParentMonitorConfig = u32(5)
val esp32OptionalMeshGetParentMonitorConfig = u32(6)
val esp32OptionalMeshSetParentCandidate = u32(7)
val esp32OptionalMeshClearParentCandidate = u32(8)
val esp32OptionalMeshGetParentCandidate = u32(9)
val esp32OptionalMeshSetRssiThreshold = u32(10)
val esp32OptionalMeshGetRssiThreshold = u32(11)
val esp32OptionalMeshInitAssocIe = u32(12)

@inline
trusted fun esp32InstallOptionalMeshOperation(
    operation: u32, implementation: u32
): bool {
    if (operation >= u32(13)) return false
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(
            esp32OptionalMeshOperations + (operation << u32(2))
        )),
        int(implementation)
    )
    return true
}

@inline
trusted fun esp32CallOptionalMeshOperation(
    operation: u32,
    unavailable: u32,
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32
): u32 {
    if (operation >= u32(13)) return unavailable
    val implementation = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(
            esp32OptionalMeshOperations + (operation << u32(2))
        ))
    ))
    if (implementation == u32(0)) return unavailable
    return u32(ablaUnsafeCallI32I32I32I32I32I32I32(
        int(implementation), int(a2), int(a3), int(a4), int(a5), int(a6),
        int(a7)
    ))
}

trusted fun esp32OptionalIeee80211VndMeshQuickGet(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 =
    esp32CallOptionalMeshOperation(esp32OptionalMeshQuickGet,u32(258),a2,a3,a4,a5,a6,a7)

trusted fun esp32OptionalIeee80211VndMeshQuickSet(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 =
    esp32CallOptionalMeshOperation(esp32OptionalMeshQuickSet,u32(258),a2,a3,a4,a5,a6,a7)

