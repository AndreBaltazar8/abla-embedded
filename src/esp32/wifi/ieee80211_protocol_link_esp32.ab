import "abla/build"

// Complete ieee80211_proto.o ABI. Only gettid remains temporarily visible to
// the still-opaque CCMP member; all other protocol operations are internal.
compile fun esp32Idf6LinkIeee80211ProtocolOpaqueCallers(): bool {
    if (!internalFunction("esp32Ieee80211GetTrafficIdentifier", "ieee80211_gettid")) return false
    if (!internalFunction("esp32Ieee80211IsErpRateSet", "ieee80211_iserp_rateset")) return false
    if (!internalFunction("esp32Ieee80211ConnectBss", "ieee80211_mlme_connect_bss")) return false
    if (!internalFunction("esp32Ieee80211ProtocolAttach", "ieee80211_proto_attach")) return false
    if (!internalFunction("esp32Ieee80211SetShortSlotTime", "ieee80211_set_shortslottime")) return false
    if (!internalFunction("esp32Ieee80211InitializeWmeParameters", "ieee80211_wme_initparams")) return false
    if (!internalFunction("esp32Ieee80211UpdateWmeParameters", "ieee80211_wme_updateparams")) return false
    true
}
