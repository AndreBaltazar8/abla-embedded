import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshNetworkInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMeshChannelEnableJp", "esp_mesh_channel_enable_jp")) return false
    if (!internalFunction("esp32RecoveredEspMeshScanDoneGetChannel", "esp_mesh_scan_done_get_channel")) return false
    if (!internalFunction("esp32RecoveredMeshNwkProcessAllowSwitch", "mesh_nwk_process_allow_switch")) return false
    if (!internalFunction("esp32RecoveredMeshNwkProcessLookForNetwork", "mesh_nwk_process_look_for_network")) return false
    if (!internalFunction("esp32RecoveredMeshNwkProcessReselect", "mesh_nwk_process_reselect")) return false
    true
}
