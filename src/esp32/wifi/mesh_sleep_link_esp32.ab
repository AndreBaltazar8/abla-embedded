import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkMeshSleepInternals(): bool {
    if (!internalFunction("esp32RecoveredEspMeshIsStartPmNow", "esp_mesh_is_start_pm_now")) return false
    if (!internalFunction("esp32RecoveredEspMeshPmGoToSleep", "esp_mesh_pm_go_to_sleep")) return false
    if (!internalFunction("esp32RecoveredEspMeshPmGoToWake", "esp_mesh_pm_go_to_wake")) return false
    if (!internalFunction("esp32RecoveredEspMeshPmRxBeaconProcess", "esp_mesh_pm_rx_beacon_process")) return false
    if (!internalFunction("esp32RecoveredEspMeshPmTbttTimeoutProcess", "esp_mesh_pm_tbtt_timeout_process")) return false
    if (!internalFunction("esp32RecoveredEspMeshPmTxDataProcess", "esp_mesh_pm_tx_data_process")) return false
    if (!internalFunction("esp32RecoveredEspMeshPmTxNullProcess", "esp_mesh_pm_tx_null_process")) return false
    if (!internalFunction("esp32RecoveredMeshPmSetNull", "mesh_pm_set_null")) return false
    if (!internalFunction("esp32RecoveredMeshPmTbttStart", "mesh_pm_tbtt_start")) return false
    true
}
