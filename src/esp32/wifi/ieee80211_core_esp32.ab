import "../../xtensa/assembly.ab"
import "../../wifi/ieee80211_logic.ab"
import "./ieee80211_phy_esp32.ab"
import "../radio/interface_control_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Classic ESP32 net80211 core, replacing the complete ieee80211.o archive
// member. Only functions still entered by another archive member carry an
// exact linker name. Every helper and callback below is ordinary internal Abla
// code, so LLVM can inline and discard it with its owning path.

val esp32Ieee80211InterfaceBytes = 592
val esp32Ieee80211ReceiveBufferBytes = 968
val esp32Ieee80211AllocationFailure = i32(257)

@inline
trusted fun esp32Ieee80211CoreAddress(): u32 =
    xtensaAssemblyReadU32("movi $0, g_ic", "=a")

@inline
trusted fun esp32Ieee80211OsiCellAddress(): u32 =
    xtensaAssemblyReadU32("movi $0, g_osi_funcs_p", "=a")

@inline
trusted fun esp32Ieee80211NvsCellAddress(): u32 =
    xtensaAssemblyReadU32("movi $0, g_wifi_nvs", "=a")

@inline
trusted fun esp32Ieee80211GlobalLockCellAddress(): u32 =
    xtensaAssemblyReadU32("movi $0, g_wifi_global_lock", "=a")

@inline
trusted fun esp32Ieee80211CoreLoadU8(address: u32): int =
    ablaUnsafeVolatileLoadU8(int(address)) & 255

@inline
trusted fun esp32Ieee80211CoreLoadU16(address: u32): int =
    ablaUnsafeVolatileLoadU16(int(address)) & 65535

@inline
trusted fun esp32Ieee80211CoreLoadU32(address: u32): u32 =
    ablaUnsafeVolatileLoadU32(int(address))

@inline
trusted fun esp32Ieee80211CoreStoreU8(address: u32, value: int): void {
    ablaUnsafeVolatileStoreU8(int(address), value & 255)
    return
}

@inline
trusted fun esp32Ieee80211CoreStoreU16(address: u32, value: int): void {
    ablaUnsafeVolatileStoreU16(int(address), value & 65535)
    return
}

@inline
trusted fun esp32Ieee80211CoreStoreU32(address: u32, value: u32): void {
    ablaUnsafeVolatileStoreU32(int(address), value)
    return
}

trusted fun esp32Ieee80211Clear(address: u32, count: int): void {
    var offset = 0
    while (offset < count) {
        esp32Ieee80211CoreStoreU8(address + u32(offset), 0)
        offset = offset + 1
    }
    return
}

trusted fun esp32Ieee80211Copy(
    destination: u32,
    source: u32,
    count: int
): void {
    var offset = 0
    while (offset < count) {
        esp32Ieee80211CoreStoreU8(
            destination + u32(offset),
            esp32Ieee80211CoreLoadU8(source + u32(offset))
        )
        offset = offset + 1
    }
    return
}

trusted fun esp32Ieee80211Equal(
    first: u32,
    second: u32,
    count: int
): bool {
    var offset = 0
    while (offset < count) {
        if (esp32Ieee80211CoreLoadU8(first + u32(offset)) !=
            esp32Ieee80211CoreLoadU8(second + u32(offset))) return false
        offset = offset + 1
    }
    true
}

@inline
trusted fun esp32Ieee80211OsiFunction(offset: u32): u32 {
    val table = esp32Ieee80211CoreLoadU32(
        esp32Ieee80211OsiCellAddress()
    )
    if (table == u32(0)) u32(0)
    else esp32Ieee80211CoreLoadU32(table + offset)
}

trusted fun esp32Ieee80211Allocate(count: int): u32 {
    val allocate = esp32Ieee80211OsiFunction(u32(376))
    if (allocate == u32(0)) return u32(0)
    u32(callNativeI32Pointer(
        int(allocate), nativePointerFromAddress(count)
    ))
}

trusted fun esp32Ieee80211Release(address: u32): void {
    if (address == u32(0)) return
    val release = esp32Ieee80211OsiFunction(u32(176))
    if (release != u32(0)) {
        callNativeVoidPointer(
            int(release), nativePointerFromAddress(int(address))
        )
    }
    return
}

trusted fun esp32Ieee80211GlobalLock(acquire: bool): void {
    val operation = esp32Ieee80211OsiFunction(
        if (acquire) u32(84) else u32(88)
    )
    if (operation == u32(0)) return
    val lock = esp32Ieee80211CoreLoadU32(
        esp32Ieee80211GlobalLockCellAddress()
    )
    val ignored = callNativeI32Pointer(
        int(operation), nativePointerFromAddress(int(lock))
    )
    return
}

// Shared objects from ieee80211.o. This provider emits definitions at assembly
// time; calling it has no runtime data-initialization cost.
@noinline
trusted fun esp32ProvideIeee80211CoreData(): void {
    xtensaAssemblyVoid(
        ".pushsection .bss.g_ic,\"aw\",@nobits\n.balign 4\n.global g_ic\n.type g_ic,@object\ng_ic:\n.space 712\n.size g_ic,712\n.popsection\n.pushsection .rodata.ieee80211_ethbroadcast,\"a\",@progbits\n.global ieee80211_ethbroadcast\n.type ieee80211_ethbroadcast,@object\nieee80211_ethbroadcast:\n.byte 255,255,255,255,255,255\n.size ieee80211_ethbroadcast,6\n.popsection\n.pushsection .rodata.abla_ieee80211_core,\"a\",@progbits\n.Labla_band_2g:\n.asciz \"2G\"\n.Labla_band_5g:\n.asciz \"5G\"\n.Labla_band_unknown:\n.asciz \"unknown\"\n.Labla_broadcast_mac:\n.byte 255,255,255,255,255,255,0\n.popsection",
        "~{memory}"
    )
    return
}

trusted fun esp32Ieee80211BandName(band: u32): u32 {
    esp32ProvideIeee80211CoreData()
    if (band == u32(1)) {
        return xtensaAssemblyReadU32("movi $0, .Labla_band_2g", "=a")
    }
    if (band == u32(2)) {
        return xtensaAssemblyReadU32("movi $0, .Labla_band_5g", "=a")
    }
    xtensaAssemblyReadU32("movi $0, .Labla_band_unknown", "=a")
}

trusted fun esp32Ieee80211RateReferenceInitialize(): void {
    val core = esp32Ieee80211CoreAddress()
    esp32Ieee80211CoreStoreU8(core + u32(469), 1)
    esp32Ieee80211CoreStoreU8(core + u32(470), 0)
    esp32Ieee80211CoreStoreU8(core + u32(472), 0)
    return
}

trusted fun esp32Ieee80211GetTransmitInfo(
    buffer: u32,
    output: u32
): void {
    val descriptor = esp32Ieee80211CoreLoadU32(buffer + u32(44))
    val packet = esp32Ieee80211CoreLoadU32(buffer + u32(4))
    var payload = esp32Ieee80211CoreLoadU32(packet + u32(4))
    esp32Ieee80211CoreStoreU32(
        output + u32(8),
        (esp32Ieee80211CoreLoadU32(descriptor + u32(16)) >>> u32(18)) &
            u32(3)
    )
    esp32Ieee80211CoreStoreU8(
        output + u32(16),
        esp32Ieee80211CoreLoadU16(buffer + u32(22)) - 4
    )
    esp32Ieee80211CoreStoreU32(output + u32(20), u32(
        esp32Ieee80211CoreLoadU8(descriptor + u32(12))
    ))
    esp32Ieee80211CoreStoreU32(output + u32(12), payload)
    esp32Ieee80211CoreStoreU32(
        output + u32(24),
        if (esp32Ieee80211CoreLoadU8(descriptor + u32(19)) == 1)
            u32(0) else u32(1)
    )
    if ((esp32Ieee80211CoreLoadU32(descriptor) & u32(262144)) != u32(0)) {
        payload = payload + u32(4)
    }
    esp32Ieee80211CoreStoreU32(output, payload + u32(4))
    esp32Ieee80211CoreStoreU32(output + u32(4), payload + u32(10))
    return
}

trusted fun esp32Ieee80211FreedomTransmit(buffer: u32): void {
    val callback = esp32Ieee80211CoreLoadU32(
        esp32Ieee80211CoreAddress() + u32(448)
    )
    if (callback == u32(0)) return
    val information = u32(nativeStackAllocate(28))
    esp32Ieee80211Clear(information, 28)
    esp32Ieee80211GetTransmitInfo(buffer, information)
    callNativeVoidPointer(
        int(callback), nativePointerFromAddress(int(information))
    )
    return
}

trusted fun esp32Ieee80211FreedomInitialize(): void {
    esp32Ieee80211CoreStoreU32(
        esp32Ieee80211CoreAddress() + u32(448), u32(0)
    )
    val ignored = esp32InterfaceRegisterTransmitCallback(
        u32(nativeFunctionAddress(esp32Ieee80211FreedomTransmit)),
        u32(8),
        u32(0)
    )
    return
}

trusted fun esp32Ieee80211FreedomDeinitialize(): void {
    esp32Ieee80211CoreStoreU32(
        esp32Ieee80211CoreAddress() + u32(448), u32(0)
    )
    xtensaAssemblyCallVoid1(
        "call8 pp_unregister_tx_cb",
        "{a10},~{a8},~{a9},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
        u32(8)
    )
    return
}

trusted fun esp32Ieee80211UserInformationElementInitialize(): void {
    val core = esp32Ieee80211CoreAddress()
    var offset = 136
    while (offset < 208) {
        esp32Ieee80211CoreStoreU32(core + u32(offset), u32(0))
        offset = offset + 4
    }
    esp32Ieee80211Clear(core + u32(160), 40)
    esp32Ieee80211CoreStoreU32(core + u32(704), u32(0))
    esp32Ieee80211CoreStoreU32(core + u32(708), u32(0))
    return
}

trusted fun esp32Ieee80211FindElementMatch(
    identifier: int,
    first: u32,
    length: int,
    match: u32,
    matchLength: int,
    matchOffset: int
): u32 {
    val end = first + u32(length)
    var element = first
    while (int(end - element) >= 2) {
        val elementLength = esp32Ieee80211CoreLoadU8(element + u32(1))
        if (elementLength + 1 >= int(end - element)) return u32(0)
        if (esp32Ieee80211CoreLoadU8(element) == (identifier & 255) &&
            elementLength >= matchOffset + matchLength &&
            (matchLength == 0 || esp32Ieee80211Equal(
                element + u32(2 + matchOffset), match, matchLength
            ))) return element
        element = element + u32(elementLength + 2)
    }
    u32(0)
}

trusted fun esp32Ieee80211FindElement(
    identifier: int,
    first: u32,
    length: int
): u32 = esp32Ieee80211FindElementMatch(
    identifier, first, length, u32(0), 0, 0
)

trusted fun esp32Ieee80211FindInformationElement(
    identifier: u32,
    first: u32,
    length: u32
): u32 = esp32Ieee80211FindElement(
    int(identifier & u32(255)), first, int(length)
)

trusted fun esp32Ieee80211FindExtendedElement(
    identifier: int,
    first: u32,
    length: int
): u32 {
    val expected = u32(nativeStackAllocate(1))
    esp32Ieee80211CoreStoreU8(expected, identifier)
    esp32Ieee80211FindElementMatch(
        255, first, length, expected, 1, 0
    )
}

fun esp32Ieee80211IsRobustManagementFrame(
    frameSubtype: u32,
    categoryValue: u32
): i32 = if (wifiIsRobustManagementFrame(
    u8(frameSubtype & u32(255)),
    u8(categoryValue & u32(255))
)) i32(1) else i32(0)

@inline
trusted fun esp32Ieee80211SendActionAbi(
    interfaceAddress: u32,
    category: u32,
    action: u32,
    argument: u32
): u32 = xtensaAssemblyReadU32WithU32U32U32U32(
        "mov.n a10, $1\nmov.n a11, $2\nmov.n a12, $3\nmov.n a13, $4\nmovi a8, ieee80211_send_action\ncallx8 a8\nmov.n $0, a10",
    "=&a,a,a,a,a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}",
    interfaceAddress, category, action, argument
)

trusted fun esp32Ieee80211ReceiveSaQueryRequest(
    interfaceAddress: u32,
    ignoredPeer: u32,
    frame: u32,
    ignoredMetadata: u32
): u32 {
    if (esp32Ieee80211CoreLoadU8(interfaceAddress + u32(763)) == 0 ||
        (esp32Ieee80211CoreLoadU32(interfaceAddress + u32(12)) & u32(1)) ==
            u32(0)) return u32(0xffffffff)
    esp32Ieee80211SendActionAbi(
        interfaceAddress, u32(8), u32(1), frame + u32(2)
    )
}

trusted fun esp32Ieee80211SendSaQuery(
    interfaceAddress: u32,
    action: u32,
    transactionAddress: u32
): u32 {
    if (esp32Ieee80211CoreLoadU8(interfaceAddress + u32(763)) == 0 ||
        (esp32Ieee80211CoreLoadU32(interfaceAddress + u32(12)) & u32(1)) ==
            u32(0)) return u32(0xffffffff)
    val frameCell = u32(nativeStackAllocate(4))
    val getFrame = xtensaAssemblyReadU32(
        "movi $0, ieee80211_get_robustmgtframe", "=a"
    )
    val buffer = u32(callNativeI32Pointer4(
        int(getFrame),
        nativePointerFromAddress(int(frameCell)),
        nativePointerFromAddress(24),
        nativePointerFromAddress(4),
        nativePointerFromAddress(int(interfaceAddress))
    ))
    if (buffer == u32(0)) return u32(1)
    val frame = esp32Ieee80211CoreLoadU32(frameCell)
    val descriptor = esp32Ieee80211CoreLoadU32(buffer + u32(44))
    esp32Ieee80211CoreStoreU32(
        descriptor,
        esp32Ieee80211CoreLoadU32(descriptor) | u32(1)
    )
    esp32Ieee80211CoreStoreU8(frame, 8)
    esp32Ieee80211CoreStoreU8(frame + u32(1), int(action))
    esp32Ieee80211CoreStoreU16(
        frame + u32(2), esp32Ieee80211CoreLoadU16(transactionAddress)
    )
    esp32Ieee80211CoreStoreU16(buffer + u32(20), 24)
    esp32Ieee80211CoreStoreU16(buffer + u32(22), 4)
    val setDescriptor = xtensaAssemblyReadU32(
        "movi $0, ieee80211_set_tx_desc", "=a"
    )
    val ignored = callNativeI32Pointer5(
        int(setDescriptor),
        nativePointerFromAddress(int(interfaceAddress)),
        nativePointerFromAddress(int(buffer)),
        nativePointerFromAddress(7),
        nativePointerFromAddress(0),
        nativePointerFromAddress(0)
    )
    val output = xtensaAssemblyReadU32(
        "movi $0, ieee80211_mgmt_output", "=a"
    )
    u32(callNativeI32Pointer3(
        int(output),
        nativePointerFromAddress(int(interfaceAddress)),
        nativePointerFromAddress(int(buffer)),
        nativePointerFromAddress(208)
    ))
}

trusted fun esp32Ieee80211SendSaQueryRequest(
    interfaceAddress: u32,
    ignoredCategory: u32,
    ignoredAction: u32,
    transactionAddress: u32
): u32 = esp32Ieee80211SendSaQuery(
    interfaceAddress, u32(0), transactionAddress
)

trusted fun esp32Ieee80211SendSaQueryResponse(
    interfaceAddress: u32,
    ignoredCategory: u32,
    ignoredAction: u32,
    transactionAddress: u32
): u32 = esp32Ieee80211SendSaQuery(
    interfaceAddress, u32(1), transactionAddress
)

trusted fun esp32Ieee80211ReceiveSaQueryResponse(
    interfaceAddress: u32,
    ignoredPeer: u32,
    frame: u32,
    ignoredMetadata: u32
): u32 {
    if (esp32Ieee80211CoreLoadU8(interfaceAddress + u32(763)) == 0 ||
        (esp32Ieee80211CoreLoadU32(interfaceAddress + u32(12)) & u32(1)) ==
            u32(0)) return u32(0xffffffff)
    if (esp32Ieee80211CoreLoadU8(interfaceAddress + u32(764)) == 0) {
        return u32(0)
    }
    val transaction = esp32Ieee80211CoreLoadU16(frame + u32(2))
    val first = esp32Ieee80211CoreLoadU16(interfaceAddress + u32(766))
    val limit = esp32Ieee80211CoreLoadU32(interfaceAddress + u32(768))
    if (transaction > first || u32(transaction) + limit <= u32(first)) {
        return u32(0)
    }
    esp32Ieee80211CoreStoreU8(interfaceAddress + u32(764), 0)
    esp32Ieee80211CoreStoreU32(interfaceAddress + u32(764), u32(0))
    esp32Ieee80211CoreStoreU32(interfaceAddress + u32(768), u32(0))
    return u32(0)
}

trusted fun esp32Ieee80211SetupProtectedManagementFrames(): void {
    val receiveRequest = u32(nativeFunctionAddress(
        esp32Ieee80211ReceiveSaQueryRequest
    ))
    val receiveResponse = u32(nativeFunctionAddress(
        esp32Ieee80211ReceiveSaQueryResponse
    ))
    val sendRequest = u32(nativeFunctionAddress(
        esp32Ieee80211SendSaQueryRequest
    ))
    val sendResponse = u32(nativeFunctionAddress(
        esp32Ieee80211SendSaQueryResponse
    ))
    xtensaAssemblyCallVoid3(
        "call8 ieee80211_recv_action_register",
        "{a10},{a11},{a12},~{a8},~{a9},~{a13},~{a14},~{a15},~{memory}",
        u32(8), u32(0), receiveRequest
    )
    xtensaAssemblyCallVoid3(
        "call8 ieee80211_recv_action_register",
        "{a10},{a11},{a12},~{a8},~{a9},~{a13},~{a14},~{a15},~{memory}",
        u32(8), u32(1), receiveResponse
    )
    xtensaAssemblyCallVoid3(
        "call8 ieee80211_send_action_register",
        "{a10},{a11},{a12},~{a8},~{a9},~{a13},~{a14},~{a15},~{memory}",
        u32(8), u32(0), sendRequest
    )
    xtensaAssemblyCallVoid3(
        "call8 ieee80211_send_action_register",
        "{a10},{a11},{a12},~{a8},~{a9},~{a13},~{a14},~{a15},~{memory}",
        u32(8), u32(1), sendResponse
    )
    return
}

trusted fun esp32Ieee80211AttachHighThroughput(
    interfaceAddress: u32
): void {
    val function = xtensaAssemblyReadU32(
        "movi $0, ieee80211_ht_attach", "=a"
    )
    callNativeVoidPointer(
        int(function), nativePointerFromAddress(int(interfaceAddress))
    )
    return
}

trusted fun esp32Ieee80211DetachHighThroughput(
    interfaceAddress: u32
): void {
    val function = xtensaAssemblyReadU32(
        "movi $0, ieee80211_ht_deattach", "=a"
    )
    callNativeVoidPointer(
        int(function), nativePointerFromAddress(int(interfaceAddress))
    )
    return
}

trusted fun esp32Ieee80211CurrentBand(): u32 = xtensaAssemblyReadU32(
    "movi a8, chm_get_current_band\ncallx8 a8\nmov.n $0, a10",
    "=a,~{a8},~{a9},~{a10},~{a11},~{a12},~{a13},~{a14},~{a15},~{memory}"
)

trusted fun esp32Ieee80211RegisterReceive(
    callback: u32,
    interfaceIndex: u32
): void {
    val ignored = esp32InterfaceRegisterReceiveCallback(
        callback, interfaceIndex
    )
    return
}

trusted fun esp32Ieee80211SetInterface(
    interfaceIndex: u32,
    interfaceAddress: u32
): void {
    val ignored = esp32InterfaceSetPacketInterface(
        interfaceIndex, interfaceAddress
    )
    return
}

trusted fun esp32Ieee80211CreateInterface(
    interfaceIndex: int
): i32 {
    val core = esp32Ieee80211CoreAddress()
    val slotOffset = if (interfaceIndex == 0) 16 else
        if (interfaceIndex == 1) 20 else 672
    val existing = esp32Ieee80211CoreLoadU32(core + u32(slotOffset))
    if (existing != u32(0)) {
        esp32Ieee80211SetInterface(u32(interfaceIndex), existing)
        return i32(0)
    }
    val interfaceAddress = esp32Ieee80211Allocate(
        esp32Ieee80211InterfaceBytes
    )
    if (interfaceAddress == u32(0)) return esp32Ieee80211AllocationFailure
    esp32Ieee80211CoreStoreU32(
        core + u32(slotOffset), interfaceAddress
    )
    esp32Ieee80211CoreStoreU32(
        interfaceAddress + u32(332), u32(interfaceIndex)
    )
    if (interfaceIndex == 0) {
        esp32Ieee80211CoreStoreU32(interfaceAddress + u32(152), u32(0))
    }
    val nvs = esp32Ieee80211CoreLoadU32(esp32Ieee80211NvsCellAddress())
    var configuredMode = 3
    var calibration = 0
    if (nvs != u32(0)) {
        if (interfaceIndex == 0) {
            configuredMode = esp32Ieee80211CoreLoadU8(nvs + u32(156))
            calibration = esp32Ieee80211CoreLoadU16(nvs + u32(1146))
            esp32Ieee80211CoreStoreU8(core + u32(682),
                esp32Ieee80211CoreLoadU8(nvs + u32(157)))
        } else if (interfaceIndex == 1) {
            configuredMode = esp32Ieee80211CoreLoadU8(nvs + u32(1018))
            calibration = esp32Ieee80211CoreLoadU16(nvs + u32(1302))
            esp32Ieee80211CoreStoreU8(core + u32(678),
                esp32Ieee80211CoreLoadU8(nvs + u32(1019)))
        }
    }
    if (interfaceIndex != 2) {
        esp32Ieee80211CoreStoreU8(
            core + u32(if (interfaceIndex == 0) 688 else 686),
            configuredMode
        )
    }
    esp32Ieee80211CoreStoreU8(
        interfaceAddress + u32(360), configuredMode
    )
    esp32Ieee80211CoreStoreU16(
        interfaceAddress + u32(570), calibration
    )
    val receiveBuffer = esp32Ieee80211Allocate(
        esp32Ieee80211ReceiveBufferBytes
    )
    val receiveBufferOffset = if (interfaceIndex == 0) 232 else 236
    esp32Ieee80211CoreStoreU32(
        interfaceAddress + u32(receiveBufferOffset), receiveBuffer
    )
    if (receiveBuffer == u32(0)) {
        esp32Ieee80211Release(interfaceAddress)
        esp32Ieee80211CoreStoreU32(core + u32(slotOffset), u32(0))
        return esp32Ieee80211AllocationFailure
    }
    val broadcast = xtensaAssemblyReadU32(
        "movi $0, .Labla_broadcast_mac", "=a"
    )
    esp32Ieee80211Copy(receiveBuffer + u32(4), broadcast, 6)
    esp32Ieee80211CoreStoreU32(receiveBuffer, interfaceAddress)
    val band = if (interfaceIndex == 2) u32(1)
        else esp32Ieee80211CurrentBand()
    val phyMode = if (interfaceIndex == 2) 3 else
        esp32Ieee80211CoreLoadU8(core + u32(
            if (interfaceIndex == 0)
                (if (band == u32(1)) 688 else 689)
            else (if (band == u32(1)) 686 else 687)
        ))
    val ignoredStatus = esp32Ieee80211PhyInitialize(
        interfaceAddress, band, u32(phyMode)
    )
    if (phyMode == 3) {
        esp32Ieee80211AttachHighThroughput(interfaceAddress)
    }
    if (interfaceIndex == 0) {
        val stationCallback = xtensaAssemblyReadU32(
            "movi $0, sta_rx_cb", "=a"
        )
        esp32Ieee80211RegisterReceive(stationCallback, u32(0))
        val michael = xtensaAssemblyReadU32(
            "movi $0, sta_michael_mic_failure", "=a"
        )
        val ignoredMichael =
            esp32InterfaceRegisterMichaelFailureCallback(michael)
        esp32Ieee80211SetupProtectedManagementFrames()
    } else if (interfaceIndex == 1) {
        esp32Ieee80211RegisterReceive(
            xtensaAssemblyReadU32("movi $0, ap_rx_cb", "=a"),
            u32(1)
        )
        esp32Ieee80211SetupProtectedManagementFrames()
    } else {
        esp32Ieee80211RegisterReceive(
            xtensaAssemblyReadU32("movi $0, nan_rx_cb", "=a"),
            u32(2)
        )
    }
    esp32Ieee80211SetInterface(
        u32(interfaceIndex), interfaceAddress
    )
    i32(0)
}

trusted fun esp32Ieee80211CreateStation(): i32 =
    esp32Ieee80211CreateInterface(0)

trusted fun esp32Ieee80211CreateSoftAp(): i32 =
    esp32Ieee80211CreateInterface(1)

trusted fun esp32Ieee80211CreateNan(): i32 =
    esp32Ieee80211CreateInterface(2)

trusted fun esp32Ieee80211DestroyInterface(interfaceIndex: int): void {
    val core = esp32Ieee80211CoreAddress()
    val slotOffset = if (interfaceIndex == 0) 16 else
        if (interfaceIndex == 1) 20 else 672
    val interfaceAddress = esp32Ieee80211CoreLoadU32(
        core + u32(slotOffset)
    )
    if (interfaceAddress != u32(0)) {
        if (interfaceIndex != 2 &&
            esp32Ieee80211CoreLoadU8(interfaceAddress + u32(360)) == 3) {
            esp32Ieee80211DetachHighThroughput(interfaceAddress)
        }
        esp32Ieee80211GlobalLock(true)
        esp32Ieee80211CoreStoreU32(core + u32(slotOffset), u32(0))
        esp32Ieee80211GlobalLock(false)
        val receiveBufferOffset = if (interfaceIndex == 0) 232 else
