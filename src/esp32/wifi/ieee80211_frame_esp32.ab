import "../../xtensa/assembly.ab"

// Emergency-buffer frame allocation used by the classic ESP32 MAC. The
// arithmetic and buffer layout are Abla-owned; only ic_ebuf_alloc remains a
// temporary call into the packet engine until that allocator is ported.

@naked
@export("ieee80211_getmgtframe")
trusted fun esp32WifiManagementFrame(
    outputAddress: u32,
    headerBytes: u32,
    payloadBytes: u32
): u32 = xtensaAssemblyReadU32(
    "entry a1, 32\nadd.n a10, a3, a4\naddi a10, a10, 3\nmovi a8, -4\nand a10, a10, a8\nmovi.n a11, 4\nmovi a8, 256\nbltu a8, a10, .Labla_mgt_allocate\nmovi.n a8, 64\nmovi.n a11, 2\nbltu a8, a10, .Labla_mgt_allocate\nmovi.n a11, 3\n.Labla_mgt_allocate:\nmov.n a12, a10\nmovi.n a10, 0\ncall8 ic_ebuf_alloc\nbeqz.n a10, .Labla_mgt_return\nl32i.n a8, a10, 4\nl32i.n a8, a8, 4\nadd.n a8, a8, a3\ns32i.n a8, a2, 0\ns16i a4, a10, 22\nmemw\n.Labla_mgt_return:\nmov.n a2, a10\nmemw\nretw.n",
    "~{memory}"
)

// This is deliberately internal in station firmware. It remains available to
// an Abla SoftAP module without forcing beacon strings or code into M5Echo.
@naked
@export("ieee80211_getbcnframe")
trusted fun esp32WifiBeaconFrame(
    outputAddress: u32,
    headerBytes: u32,
    payloadBytes: u32
): u32 = xtensaAssemblyReadU32(
    ".pushsection .rodata.abla_wifi_beacon,\"aMS\",@progbits,1\n.Labla_beacon_init:\n.asciz \"Init max length of beacon: %d/%d\"\n.Labla_beacon_alloc_fail:\n.asciz \"alloc eb len=%d type=%d fail\\n\"\n.popsection\nentry a1, 32\nmov.n a5, a2\nmovi a2, g_beacon_idx\nl8ui a8, a2, 0\nmovi a2, g_beacon_eb\naddx4 a8, a8, a2\nl32i.n a2, a8, 0\nbnez.n a2, .Labla_beacon_ready\nmovi.n a11, 1\nmov.n a10, a11\nmovi a6, g_wifi_menuconfig\nmovi.n a12, 3\nl32i.n a14, a6, 56\nmovi a6, 752\nmax a7, a14, a6\nmov.n a15, a7\nmovi a13, .Labla_beacon_init\ncall8 wifi_log\nmov.n a10, a2\nmov.n a12, a7\nmovi.n a11, 4\ncall8 ic_ebuf_alloc\nmov.n a2, a10\nbeqz.n a10, .Labla_beacon_failed\n.Labla_beacon_ready:\nl32i.n a6, a2, 4\nl32i.n a8, a6, 4\nadd.n a8, a8, a3\ns32i.n a8, a5, 0\ns16i a4, a2, 22\nmemw\nmemw\nj .Labla_beacon_return\n.Labla_beacon_failed:\nmovi a13, .Labla_beacon_alloc_fail\nmovi.n a15, 4\nmov.n a14, a6\nmovi.n a12, 2\nmovi.n a11, 64\nmovi.n a10, 1\ncall8 wifi_log\n.Labla_beacon_return:\nretw.n",
    "~{memory}"
)
