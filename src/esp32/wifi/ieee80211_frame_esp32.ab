import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "hostap_esp32.ab"
import "ioctl_recovered_esp32.ab"

@inline
trusted fun esp32WifiFrameLoadU32(address:u32):u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32WifiFrameStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32WifiFramePayload(packet:u32, headerBytes:u32):u32 =
    esp32WifiFrameLoadU32(esp32WifiFrameLoadU32(packet + u32(4)) + u32(4)) +
        headerBytes

@inline
trusted fun esp32WifiFinishFrame(
    packet:u32, outputAddress:u32, headerBytes:u32, payloadBytes:u32
):u32 {
    esp32WifiFrameStoreU32(outputAddress,
        esp32WifiFramePayload(packet, headerBytes))
    ablaUnsafeStoreU16(nativePointerFromAddress(int(packet + u32(22))),
        int(payloadBytes))
    packet
}

trusted fun esp32WifiManagementFrame(
    outputAddress:u32, headerBytes:u32, payloadBytes:u32
):u32 {
    val allocationBytes = (headerBytes + payloadBytes + u32(3)) & u32(0xfffffffc)
    val packetType = if (allocationBytes > u32(256)) u32(4)
        else if (allocationBytes > u32(64)) u32(2) else u32(3)
    val packet = esp32InterfacePacketBufferAllocate(
        u32(0), packetType, allocationBytes)
    if (packet == u32(0)) return u32(0)
    esp32WifiFinishFrame(packet, outputAddress, headerBytes, payloadBytes)
}

// SoftAP-only path. Station firmware can prune this function, its strings and
// the beacon allocation state as one unreachable graph.
trusted fun esp32WifiBeaconFrame(
    outputAddress:u32, headerBytes:u32, payloadBytes:u32
):u32 {
    val beaconIndex = u32(ablaUnsafeLoadU8(nativePointerFromAddress(
        int(esp32Data_g_beacon_idx_a8bf1e7652))))
    var packet = esp32WifiFrameLoadU32(
        esp32Data_g_beacon_eb_c869f5bb9a + (beaconIndex << u32(2)))
    if (packet == u32(0)) {
        val configured = esp32WifiFrameLoadU32(
            esp32Data_g_wifi_menuconfig_c8372af18b + u32(56))
        val allocationBytes = if (configured > u32(752)) configured else u32(752)
        esp32WifiLogValue(u32(1),u32(1),u32(3),
            u32(nativeCStringAddress("Init max length of beacon: %d/%d")),
            configured,allocationBytes,
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        packet = esp32InterfacePacketBufferAllocate(
            u32(0), u32(4), allocationBytes)
        if (packet == u32(0)) {
            esp32WifiLogValue(u32(1),u32(64),u32(2),
                u32(nativeCStringAddress("alloc eb len=%d type=%d fail\n")),
                allocationBytes,u32(4),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
            return u32(0)
        }
    }
    esp32WifiFinishFrame(packet, outputAddress, headerBytes, payloadBytes)
}
