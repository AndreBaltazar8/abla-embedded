// Caller holds shared PCR/SYSTIMER configuration ownership and exclusively
// owns selected counter. Preserve other counter, alarms, ETM, values and IRQs.
// No reset pulse, counter load, source selection or implied tick frequency.
// Failed readback leaves partial configuration for explicit retry.
trusted fun esp32C5TimerConfigureLocked(unit: int,enabled: bool,stallCore0: bool,stallCore1: bool,polls: int = 64): bool {
    if (unit < 0 || unit > 1 || polls < 1 || polls > 1000000) return false
    val pcr=esp32C5TimerRead(0x6009606C)
    esp32C5TimerWrite(0x6009606C,(pcr|u32(1))&~u32(2))
    var attempt=0
    while (attempt < polls) {
        if ((esp32C5TimerRead(0x6009606C)&u32(7)) == u32(5)) break
        attempt=attempt+1
    }
    if (attempt == polls) return false
    // Shared functional clock remains enabled even when stopping one unit.
    val clock=esp32C5TimerRead(0x60096070)
    esp32C5TimerWrite(0x60096070,clock|u32(0x400000))
    if ((esp32C5TimerRead(0x60096070)&u32(0x400000)) == u32(0)) return false
    val work=u32(1)<<u32(30-unit)
    val stall0=u32(1)<<u32(28-unit*2)
    val stall1=stall0>>u32(1)
    val mask=work|stall0|stall1|u32(0x80000000)
    val value=u32(0x80000000)|(if (enabled) work else u32(0))|
        (if (stallCore0) stall0 else u32(0))|(if (stallCore1) stall1 else u32(0))
    esp32C5TimerWrite(0x6000A000,(esp32C5TimerRead(0x6000A000)&~mask)|value)
    (esp32C5TimerRead(0x6000A000)&mask) == value
}
