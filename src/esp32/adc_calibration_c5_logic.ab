// ESP-IDF6.0.2 esp32c5 esp_efuse_rtc_calib.c. ADC1 only, GPIO1..6.
// Packed scalar, no allocation. This decodes references, NOT curve correction.
type C5AdcCalibration=int
fun C5AdcCalibration.valid(): bool = (this&(1<<34)) != 0
fun C5AdcCalibration.error(): int = if (this.valid()) 0 else this&255
fun C5AdcCalibration.initCode(): int = if (this.valid()) this&4095 else -1
fun C5AdcCalibration.referenceCode(): int = if (this.valid()) (this>>>12)&4095 else -1
fun C5AdcCalibration.attenuation(): int = if (this.valid()) (this>>>28)&3 else -1
fun C5AdcCalibration.channel(): int = if (this.valid()) (this>>>30)&7 else -1
fun C5AdcCalibration.compensation(): int {
    if (!this.valid()) return 0
    val encoded=(this>>>24)&15
    return (if ((encoded&8) != 0) -(encoded&7) else encoded&7)*(4-this.attenuation())
}
fun c5AdcChannelForPin(pin: int): int = if (pin >= 1 && pin <= 6) pin-1 else -1
fun C5AdcCalibration.referenceMillivolts(): int {
    if (!this.valid()) return -1
    val attenuation=this.attenuation()
    return if (attenuation == 0) 600 else if (attenuation == 1) 800 else if (attenuation == 2) 1200 else 2300
}
// version = HAL block major*100+minor. Reject unknown future major versions.
// Errors:2input,3unsupported/unprogrammed version,4field range.
fun esp32c5AdcCalibrationFromFields(channel: int,attenuation: int,version: int,initial: int,reference: int,difference: int): C5AdcCalibration {
    if (channel < 0 || channel > 5 || attenuation < 0 || attenuation > 3) return C5AdcCalibration(2)
    if (version < 1 || version >= 100) return C5AdcCalibration(3)
    if (initial < 0 || initial > 1023 || reference < 0 || reference > 1023 || difference < 0 || difference > 15) return C5AdcCalibration(4)
    val signedReference=if ((reference&512) != 0) -(reference&511) else reference&511
    val code=(if (attenuation < 2) 2250 else 2300)+signedReference
    return C5AdcCalibration((1<<34)|(initial+1600)|(code<<12)|(difference<<24)|(attenuation<<28)|(channel<<30))
}
fun C5AdcCalibration.compensatedRaw(raw: int): int {
    if (!this.valid() || raw < 0 || raw > 4095) return -1
    val adjusted=raw-this.compensation()
    return if (adjusted < 0) 0 else if (adjusted > 4095) 4095 else adjusted
}
