import "./core_local_init_s3_sequence.ab"
import "./interrupt_matrix_init_esp32s3.ab"
import "abla/unsafe/native"
import "../hal/esp32.ab"
// Noncoherent shared internal RAM uses RCW transactions. Reset ATOMCTL0x28
// traps S32C1I on bypass mappings; set all three memory classes to RCW(0x15)
// on each core before publishing vectors/runtime and using scheduler locks.
@inline
@export("esp32S3CoreInitializeAtomics")
trusted fun esp32S3CoreInitializeAtomicsHook(): void {
    xtensaGuardWrite("wsr.atomctl $0\nrsync","r,~{memory}",u32(0x15)); return
}
@inline
@export("esp32S3CoreSetVectorBase")
trusted fun esp32S3CoreSetVectorBaseHook(address: int): void {
    xtensaGuardWrite("wsr.vecbase $0\nrsync","r,~{memory}",u32(address))
    return
}
@inline
@export("esp32S3CoreClearBootEntry")
trusted fun esp32S3CoreClearBootEntryHook(): void { callNativeVoidI32(0x40000720,0); return }
@inline
@export("esp32S3CoreDebugWrite")
trusted fun esp32S3CoreDebugWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
