import "./peripheral_delay_rom_sequence.ab"
import "abla/unsafe/native"
// ESP-IDF6 esp32c5.rom.ld + esp32c5.rom.eco3.ld: ets_delay_us=0x4000003c.
// Hardware ROM boundary, no linked implementation. Requires boot to have
// initialized ROM ticks-per-us for the actual CPU clock; recalibrate after
// clock changes. A scheduled platform should use a yielding delay provider.
trusted fun peripheralRomDelay(microseconds: int): void {
    callNativeVoidI32(1073741884,microseconds)
    return
}
