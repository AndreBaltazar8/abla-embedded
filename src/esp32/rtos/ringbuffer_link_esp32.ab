import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRingbufferInternals(): bool {
    if (!internalFunction("esp32RecoveredXRingbufferCreate", "xRingbufferCreate")) return false
    if (!internalFunction("esp32RecoveredXRingbufferCreateNoSplit", "xRingbufferCreateNoSplit")) return false
    if (!internalFunction("esp32RecoveredXRingbufferCreateStatic", "xRingbufferCreateStatic")) return false
    if (!internalFunction("esp32RecoveredXRingbufferSendAcquire", "xRingbufferSendAcquire")) return false
    if (!internalFunction("esp32RecoveredXRingbufferSendComplete", "xRingbufferSendComplete")) return false
    if (!internalFunction("esp32RecoveredXRingbufferSend", "xRingbufferSend")) return false
    if (!internalFunction("esp32RecoveredXRingbufferSendFromISR", "xRingbufferSendFromISR")) return false
    if (!internalFunction("esp32RecoveredXRingbufferReceive", "xRingbufferReceive")) return false
    if (!internalFunction("esp32RecoveredXRingbufferReceiveFromISR", "xRingbufferReceiveFromISR")) return false
    if (!internalFunction("esp32RecoveredXRingbufferReceiveSplit", "xRingbufferReceiveSplit")) return false
    if (!internalFunction("esp32RecoveredXRingbufferReceiveSplitFromISR", "xRingbufferReceiveSplitFromISR")) return false
    if (!internalFunction("esp32RecoveredXRingbufferReceiveUpTo", "xRingbufferReceiveUpTo")) return false
    if (!internalFunction("esp32RecoveredXRingbufferReceiveUpToFromISR", "xRingbufferReceiveUpToFromISR")) return false
    if (!internalFunction("esp32RecoveredVRingbufferReturnItem", "vRingbufferReturnItem")) return false
    if (!internalFunction("esp32RecoveredVRingbufferReturnItemFromISR", "vRingbufferReturnItemFromISR")) return false
    if (!internalFunction("esp32RecoveredVRingbufferReset", "vRingbufferReset")) return false
    if (!internalFunction("esp32RecoveredVRingbufferDelete", "vRingbufferDelete")) return false
    if (!internalFunction("esp32RecoveredXRingbufferGetMaxItemSize", "xRingbufferGetMaxItemSize")) return false
    if (!internalFunction("esp32RecoveredXRingbufferGetCurFreeSize", "xRingbufferGetCurFreeSize")) return false
    if (!internalFunction("esp32RecoveredXRingbufferAddToQueueSetRead", "xRingbufferAddToQueueSetRead")) return false
    if (!internalFunction("esp32RecoveredXRingbufferRemoveFromQueueSetRead", "xRingbufferRemoveFromQueueSetRead")) return false
    if (!internalFunction("esp32RecoveredVRingbufferGetInfo", "vRingbufferGetInfo")) return false
    if (!internalFunction("esp32RecoveredXRingbufferPrintInfo", "xRingbufferPrintInfo")) return false
    if (!internalFunction("esp32RecoveredXRingbufferGetStaticBuffer", "xRingbufferGetStaticBuffer")) return false
    if (!internalFunction("esp32RecoveredXRingbufferCreateWithCaps", "xRingbufferCreateWithCaps")) return false
    if (!internalFunction("esp32RecoveredVRingbufferDeleteWithCaps", "vRingbufferDeleteWithCaps")) return false
    true
}
