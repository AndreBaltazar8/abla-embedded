// C5 RTC alarm control. Caller owns the selected comparator, raw interrupt,
// interrupt enable and all HP/LP consumers. Never reset the counter or touch
// overflow/other comparator state. Whole closure/stack retained for cache-off.
// RAW is an observation, not an acknowledgement. -1 invalid ownership/index.
@section(".iram1.abla.c5RtcAlarmRaw")
trusted fun esp32C5RtcAlarmPendingOwned(timer: int,exclusive: bool): int {
    if (!exclusive || timer < 0 || timer > 1) return -1
    (c5RtcTimerRead(if (timer == 0) 0x28 else 0x38)>>>31)&1
}
// IRQ enable is not a substitute for PMU wake-source selection.
@section(".iram1.abla.c5RtcAlarmIrq")
trusted fun esp32C5RtcAlarmInterruptOwned(timer: int,enabled: bool,exclusive: bool): bool {
    if (!exclusive || timer < 0 || timer > 1) return false
    val offset=if (timer == 0) 0x30 else 0x40
    val bit=if (enabled) 0x80000000 else 0
    c5RtcTimerWrite(offset,(c5RtcTimerRead(offset)&0x7fffffff)|bit)
    (c5RtcTimerRead(offset)&0x80000000) == bit
}
// LP_TIMER TAR_EN documentation defines writing0 as disable (same LL
// set_target_enable(false) operation). It is WT: no readable enable-state
// acknowledgement exists. Preserve target and reserved bits, clear only
// this alarm's pending status AFTER disable, and verify raw cause cleared.
// Snapshot pending before cancelling if wake-cause information is needed.
// Does not change IRQ enable or PMU mask; caller restores those separately.
@section(".iram1.abla.c5RtcAlarmCancel")
trusted fun esp32C5RtcAlarmCancelOwned(timer: int,exclusive: bool): bool {
    if (!exclusive || timer < 0 || timer > 1) return false
    val high=timer*8+4
    c5RtcTimerWrite(high,c5RtcTimerRead(high)&0x7fffffff)
    c5RtcTimerWrite(if (timer == 0) 0x34 else 0x44,0x80000000)
    esp32C5RtcAlarmPendingOwned(timer,true) == 0
}
