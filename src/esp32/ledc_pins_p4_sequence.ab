import "./gpio_p4_sequence.ab"
// Caller owns the pad, GPIO/IOMUX clock lease and LEDC channel/clock lease;
// excludes PMU forced holds, sleep, other cores, IRQ and ETM reconfiguration.
// No board availability claim: GPIO0..54 includes reserved board pins.
// A prepared GPIO-low pad is handed to an idle-low PWM signal, or back again.
// Inversion is supported, with channel idle level chosen to remain physically
// LOW. Configure GPIO via esp32P4GpioConfigureOwned before attaching.
// 1 routed, 2 invalid, 3 held/not ready, 4 channel busy/not low, 5 readback.
fun p4LedcPinRouteValue(channel: int,inverted: bool): int =
    if (channel < 0 || channel > 7) -1 else 1024+126+channel+(if (inverted) 512 else 0)
trusted fun p4LedcPinReadyLow(pin: int): bool {
    val bit=u32(1)<<u32(pin&31)
    return (p4GpioRead(if (pin < 32) 32 else 44)&bit) != u32(0) &&
        (p4GpioRead(if (pin < 32) 4 else 16)&bit) == u32(0) &&
        (p4GpioRead(116+pin*4)&u32(4)) == u32(0) &&
        (p4GpioRead(4100+pin*4)&u32(0x7002)) == u32(0x1000)
}
trusted fun p4LedcPinChannelLow(channel: int,inverted: bool): bool =
    (p4LedcRead(channel*20)&0x801c) == (if (inverted) 8 else 0) &&
    (p4LedcRead(channel*20+12)&0x80000000) == 0
trusted fun p4LedcPinAttachLowOwned(layout: int,pin: int,channel: int,inverted: bool): int {
    val route=p4LedcPinRouteValue(channel,inverted)
    if ((layout != 1 && layout != 3) || pin < 0 || pin > 54 || route < 0) return 2
    if (esp32P4GpioIndividualHoldOwned(layout,pin) != 0 || !p4LedcPinReadyLow(pin) ||
        (p4GpioRead(1368+pin*4)&u32(4095)) != u32(1280)) return 3
    if (!p4LedcPinChannelLow(channel,inverted)) return 4
    return if (p4GpioField(1368+pin*4,u32(4095),u32(route))) 1 else 5
}
trusted fun p4LedcPinDetachLowOwned(layout: int,pin: int,channel: int,inverted: bool): int {
    val route=p4LedcPinRouteValue(channel,inverted)
    if ((layout != 1 && layout != 3) || pin < 0 || pin > 54 || route < 0) return 2
    if (esp32P4GpioIndividualHoldOwned(layout,pin) != 0 || !p4LedcPinReadyLow(pin) ||
        (p4GpioRead(1368+pin*4)&u32(4095)) != u32(route)) return 3
    if (!p4LedcPinChannelLow(channel,inverted)) return 4
    return if (p4GpioField(1368+pin*4,u32(4095),u32(1280))) 1 else 5
}
