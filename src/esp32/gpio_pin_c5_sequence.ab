import "./gpio_c5_sequence.ab"
import "../hal/pin.ab"
// Same nominal scalar Pin API as other backends. Validity describes silicon,
// not board reservations or ownership. All accesses require owned, clocked
// pads; configuration refuses RTC/USB/held pads rather than taking them over.
@exportLocal("abla_pin_valid")
fun pinValidHook(pin: int): bool = esp32C5GpioNumberValid(Pin(pin))
@exportLocal("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin).valid()
@exportLocal("abla_pin_pullCapable")
fun pinPullCapableHook(pin: int): bool = Pin(pin).valid()
@exportLocal("abla_pin_read")
trusted fun pinReadHook(pin: int): bool = esp32C5GpioReadOwned(Pin(pin)) == 1
@exportLocal("abla_pin_readLevelOwned")
trusted fun pinReadLevelOwnedHook(pin: int): int = esp32C5GpioReadOwned(Pin(pin))
@exportLocal("abla_pin_write")
trusted fun pinWriteHook(pin: int, high: bool): void { esp32C5GpioWriteOwned(Pin(pin),high);return }
@exportLocal("abla_pin_writeLevelOwned")
trusted fun pinWriteLevelOwnedHook(pin: int, high: bool): bool = esp32C5GpioWriteOwned(Pin(pin),high)
@exportLocal("abla_pin_outputLevelOwned")
trusted fun pinOutputLevelOwnedHook(pin: int, high: bool): bool =
    esp32C5GpioConfigureOwned(Pin(pin),true,high,false,false,0,true) == 1
@exportLocal("abla_pin_inputOwned")
trusted fun pinInputOwnedHook(pin: int): bool = esp32C5GpioConfigureOwned(Pin(pin),false,true,false,true,0,true) == 1
@exportLocal("abla_pin_inputPullOwned")
trusted fun pinInputPullOwnedHook(pin: int, pull: int): bool = esp32C5GpioConfigureOwned(Pin(pin),false,true,false,true,pull,true) == 1

