var esp32WifiStationStarted = false

@inline
trusted fun esp32WifiPointerWord(value: i64*): u32 =
    u32(nativePointerAddress(value))

trusted noescape fun esp_event_loop_create_default(): i32 =
    i32(esp32RecoveredEspEventLoopCreateDefault())

trusted noescape fun esp_netif_create_default_wifi_sta(): i64* =
    nativePointerFromAddress(int(esp32RecoveredEspNetifCreateDefaultWifiSta(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )))

trusted noescape fun esp_wifi_init(config: i64*): i32 =
    i32(esp32RecoveredEspWifiInit(
        esp32WifiPointerWord(config),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    ))

trusted noescape fun esp_wifi_set_storage(storage: i32): i32 =
    i32(esp32RecoveredEspWifiSetStorage(
        u32(storage),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
