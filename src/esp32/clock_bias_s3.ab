// IDF6 S3 rtc_set_stored_dbias. Sign-magnitude efuse fields, NOT two's complement.
// Four five-bit settings; bit20 distinguishes efuse calibration from IDF defaults.
import "../runtime/unsigned_division64.ab"
type Esp32S3ClockBias = int
fun Esp32S3ClockBias.rtc240(): int = this & 31
fun Esp32S3ClockBias.digital240(): int = (this>>>5) & 31
fun Esp32S3ClockBias.rtcLow(): int = (this>>>10) & 31
fun Esp32S3ClockBias.digitalLow(): int = (this>>>15) & 31
fun Esp32S3ClockBias.calibrated(): bool = (this & (1<<20)) != 0
fun esp32S3BiasSigned(raw: int,sign: int): int = if ((raw & sign) != 0) -(raw & (sign-1)) else raw & (sign-1)
fun esp32S3BiasThreshold(base: int,slope: int,threshold: int): int {
    // Slopes are strictly positive for all decoded efuse values. Explicit
    // restoring division avoids LLVM loop-count lowering to external libgcc.
    val delta=threshold-(base-5*slope)
    if (delta <= 0) return 15
    val steps=int(unsignedDivide64(u64(delta+slope-1),u64(slope)))
    if (steps >= 16) 31 else 15+steps
}
fun esp32S3ClockBiasDecode(major: int,minor: int,word4: int,word5: int): Esp32S3ClockBias {
    val hvt=(word5>>>11) & 31
    if (!((major <= 1 && minor == 1) || major > 1 || (major == 1 && minor >= 2)) || hvt == 0)
        return Esp32S3ClockBias(28 | (28<<5) | (27<<10) | (27<<15))
    val kr=198+esp32S3BiasSigned((word4>>>13) & 127,64)
    val kd=211+esp32S3BiasSigned((word4>>>20) & 127,64)
    val vr=10181+20*esp32S3BiasSigned(((word4>>>27) & 31) | ((word5 & 7)<<5),128)
    val vd=10841+20*esp32S3BiasSigned((word5>>>3) & 255,128)
    val limit=esp32S3BiasThreshold(vd,kd,13000)
    val high=if (hvt+3 < limit) hvt+3 else limit
    val low=if (hvt+2 < limit) hvt+2 else limit
    val rtcHigh=esp32S3BiasThreshold(vr,kr,vd+kd*(high-20)-250)
    val rtcLow=esp32S3BiasThreshold(vr,kr,vd+kd*(low-20)-250)
    Esp32S3ClockBias(rtcHigh | (high<<5) | (rtcLow<<10) | (low<<15) | (1<<20))
}
