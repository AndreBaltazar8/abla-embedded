// IDF6 P4 register headers select hw_ver3 at minimum revision300; earlier
// supported revisions use hw_ver1. Revision encoding is major*100+minor.
// Unknown/future revisions must be audited, not silently assigned a layout.
fun esp32P4RegisterLayout(revision: int): int =
    if (revision < 0 || revision > 399) 0 else if (revision >= 300) 3 else 1

// Both register layouts: RD_MAC_SYS_2 low4=minor, bits4..5=major low,
// bit23=major high. The disable-major-check fuse does NOT change identity.
// Match IDF efuse_hal_chip_revision: full major*100+minor, including unknown
// future revisions; layout selection above deliberately rejects those.
fun esp32P4RevisionFromEfuse(word: u32): int =
    (((int(word)>>>4)&3)|(((int(word)>>>23)&1)<<2))*100+(int(word)&15)
