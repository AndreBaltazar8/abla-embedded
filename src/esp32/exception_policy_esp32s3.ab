import "./syscall_frame_s3.ab"
import "./exception_handler_esp32s3.ab"
import "abla/unsafe/native"
// Registered exception adapter. Caller-owned8byte record holds fallback
// callback/context. Fallback ABI void(u32 frame,u32 cause,u32 core,u32 context).
// Handles syscall0/unsupported numbers; all other causes retain the explicit
// application repair/fatal policy, including unfinished lazy CP ownership.
@section(".iram1.abla.s3ExceptionPolicy")
trusted fun esp32S3ExceptionPolicy(frame: u32,cause: u32,core: u32,record: u32): void {
    if (cause == u32(1) && esp32S3SyscallFrameOwned(nativeBufferAt(int(frame),192))) return
    val fallback=mmioLoadU32(int(record))
    val context=mmioLoadU32(int(record)+4)
    callNativeVoidI32I32I32I32(fallback,int(frame),int(cause),int(core),context)
    return
}
@inline
trusted fun esp32S3ExceptionPolicyAddress(): int = nativeFunctionAddress(esp32S3ExceptionPolicy)

// Caller owns record, disjoint from all live stacks, dispatcher tables and IRQ
// config. Initialize it before installing; failed install leaves it initialized.
// No record reuse/release until handler removed AND switched away from vector.
@section(".iram1.abla.s3ExceptionPolicyInstall")
trusted fun esp32S3ExceptionPolicyInstallOwned(record: NativeBuffer,core: int,fallback: int,context: int): bool {
    if (!record.hasAddressRange(0,8) || (record.addressValue() & 3) != 0 ||
        record.addressValue() < 0x3FC88000 || record.addressValue()+8 > 0x3FD00000 ||
        core < 0 || core > 1 || fallback < 0x40370000 || fallback >= 0x403E0000 ||
        (fallback & 3) != 0 || context < 0 || context > 0xFFFFFFFF) return false
    if (esp32S3ExceptionCore() != core || esp32S3ExceptionEnabled() != 0) return false
    val cfg=esp32S3ExceptionConfig()
    val address=record.addressValue()
    if (address < cfg+64 && cfg < address+8) return false
    var other=0
    while (other < 2) {
        val entry=cfg+other*32
        if (mmioLoadU32(entry) != 0 && address < mmioLoadU32(entry+20) && mmioLoadU32(entry+16) < address+8) return false
        other=other+1
    }
    val entryAddress=cfg+core*32
    if (mmioLoadU32(entryAddress) == 0 || mmioLoadU32(entryAddress+4) != 0 || mmioLoadU32(entryAddress+24) != 0) return false
    mmioStoreU32(address,fallback)
    mmioStoreU32(address+4,context)
    esp32S3ExceptionHandlerInstallOwned(core,esp32S3ExceptionPolicyAddress(),address)
}
@inline
trusted fun esp32S3ExceptionPolicyRemoveOwned(record: NativeBuffer,core: int): bool {
    if (!record.hasAddressRange(0,8)) return false
    esp32S3ExceptionHandlerRemoveOwned(core,esp32S3ExceptionPolicyAddress(),record.addressValue())
}
