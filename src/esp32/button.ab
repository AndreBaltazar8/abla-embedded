import "./gpio.ab"
import "./clock.ab"
import "../input/button.ab"

// Pin, active polarity, and the complete debounced state occupy one scalar.
// The source uses bits 22-30, which ButtonState deliberately leaves unused.
// Board profiles still expose raw Pin values; asButton() is the explicit
// conversion into a self-updating input value.
type GpioButton = int

fun gpioButton(input: Pin, activeLow: bool = true): GpioButton =
    GpioButton(
        buttonState(false, 0) |
        ((input.number() & 255) << 22) |
        (if (activeLow) 1 << 30 else 0)
    )

fun Pin.asButton(activeLow: bool = true): GpioButton =
    gpioButton(this, activeLow)

fun GpioButton.pin(): Pin = pin((this >>> 22) & 255)
fun GpioButton.activeLow(): bool = (this & (1 << 30)) != 0
fun GpioButton.state(): ButtonState = ButtonState(this | 0)

fun GpioButton.withState(state: ButtonState): GpioButton = GpioButton(
    state | ((this.pin().number() & 255) << 22) |
        (if (this.activeLow()) 1 << 30 else 0)
)

trusted fun GpioButton.initialize(): void = this.pin().input()

trusted fun GpioButton.readPressed(): bool {
    val high = this.pin().read()
    if (this.activeLow()) !high else high
}

fun GpioButton.isPressed(): bool = this.state().isPressed()
fun GpioButton.isReleased(): bool = this.state().isReleased()
fun GpioButton.rawPressed(): bool = this.state().rawPressed()
fun GpioButton.isHolding(): bool = this.state().isHolding()
fun GpioButton.wasDecideClickCount(): bool =
    this.state().wasDecideClickCount()
fun GpioButton.wasPressed(): bool = this.state().wasPressed()
fun GpioButton.wasReleased(): bool = this.state().wasReleased()
fun GpioButton.wasClicked(): bool = this.state().wasClicked()
fun GpioButton.wasHold(): bool = this.state().wasHold()
fun GpioButton.wasSingleClicked(): bool = this.state().wasSingleClicked()
fun GpioButton.wasDoubleClicked(): bool = this.state().wasDoubleClicked()
fun GpioButton.getClickCount(): int = this.state().getClickCount()
fun GpioButton.durationMilliseconds(): int =
    this.state().durationMilliseconds()
fun GpioButton.pressedFor(milliseconds: int): bool =
    this.state().pressedFor(milliseconds)
fun GpioButton.releasedFor(milliseconds: int): bool =
    this.state().releasedFor(milliseconds)

fun GpioButton.updateWith(
    pressed: bool,
    nowMilliseconds: int,
    debounceMilliseconds: int = 10,
    holdMilliseconds: int = 500,
    clickDecisionMilliseconds: int = 250
): GpioButton = this.withState(this.state().update(
    pressed, nowMilliseconds, debounceMilliseconds, holdMilliseconds,
    clickDecisionMilliseconds
))

trusted fun GpioButton.update(
    debounceMilliseconds: int = 10,
    holdMilliseconds: int = 500,
    clickDecisionMilliseconds: int = 250
): GpioButton = this.updateWith(
    this.readPressed(), esp_timer_get_time() / 1000,
    debounceMilliseconds, holdMilliseconds, clickDecisionMilliseconds
)

trusted fun ButtonState.updateFrom(
    source: GpioButton,
    debounceMilliseconds: int = 10,
    holdMilliseconds: int = 500,
    clickDecisionMilliseconds: int = 250
): ButtonState = this.update(
    source.readPressed(), esp_timer_get_time() / 1000,
    debounceMilliseconds, holdMilliseconds, clickDecisionMilliseconds
)
