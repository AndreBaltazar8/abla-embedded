import "./gpio.ab"
import "../input/button.ab"
import "../arduino/time.ab"

// A statically dispatched GPIO button source. Pin and active polarity occupy
// one scalar; board profiles provide the correct configuration once.
type GpioButton = int

fun gpioButton(input: Pin, activeLow: bool = true): GpioButton =
    GpioButton((input.number() & 255) | (if (activeLow) 256 else 0))

fun Pin.asButton(activeLow: bool = true): GpioButton =
    gpioButton(this, activeLow)

fun GpioButton.pin(): Pin = pin(this & 255)
fun GpioButton.activeLow(): bool = (this & 256) != 0

trusted fun GpioButton.initialize(): void = this.pin().input()

trusted fun GpioButton.isPressed(): bool {
    val high = this.pin().read()
    if (this.activeLow()) !high else high
}

trusted fun ButtonState.updateFrom(
    source: GpioButton,
    debounceMilliseconds: int = 10,
    holdMilliseconds: int = 500,
    clickDecisionMilliseconds: int = 250
): ButtonState = this.update(
    source.isPressed(), esp_timer_get_time() / 1000,
    debounceMilliseconds, holdMilliseconds, clickDecisionMilliseconds
)
