// Internal SRAM only. Check the COMPLETE descriptor and strided payload spans
// before writing anything. Descriptor storage must not overlap any payload.
fun esp32s3GdmaRingLayoutValid(descriptors: int, count: int, buffers: int,
    stride: int, capacity: int): bool {
    if (count < 1 || count > 4095 || capacity < 1 || capacity > 4095 ||
        stride < capacity || stride > 0x78000 || (stride & 3) != 0 ||
        descriptors < 0x3fc88000 || descriptors > 0x3fcffff4 ||
        buffers < 0x3fc88000 || buffers >= 0x3fd00000 ||
        (descriptors & 3) != 0 || (buffers & 3) != 0) return false
    val descriptorEnd = descriptors + count * 12
    val bufferEnd = buffers + (count - 1) * stride + capacity
    if (descriptorEnd > 0x3fd00000 || bufferEnd > 0x3fd00000) return false
    descriptorEnd <= buffers || bufferEnd <= descriptors
}

// Caller owns all storage and a stopped/parked DMA direction. TX payload must
// already be initialized: every descriptor sends capacity bytes and raises
// EOF. RX starts with length0. Last descriptor links back to the first.
// This creates the ring but does not start it or allocate/refill its buffers.
trusted fun esp32s3GdmaInitializeRingOwned(descriptors: int, count: int,
    buffers: int, stride: int, capacity: int, transmit: bool): bool {
    if (!esp32s3GdmaRingLayoutValid(descriptors, count, buffers, stride, capacity)) return false
    val flags = capacity | 0x80000000 | (if (transmit) (capacity << 12) | 0x40000000 else 0)
    var index = 0
    while (index < count) {
        val descriptor = descriptors + index * 12
        esp32s3GdmaWrite(descriptor + 4, buffers + index * stride)
        esp32s3GdmaWrite(descriptor + 8, if (index + 1 == count) descriptors else descriptor + 12)
        esp32s3GdmaWrite(descriptor, flags)
        index = index + 1
    }
    // No DMA observes the ring until its subsequent start; publish all stores.
    esp32s3GdmaPublish()
    true
}
