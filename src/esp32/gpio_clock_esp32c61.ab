import "./gpio_clock_c61_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("c61GpioClockRead")
trusted fun c61GpioClockReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("c61GpioClockWrite")
trusted fun c61GpioClockWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
