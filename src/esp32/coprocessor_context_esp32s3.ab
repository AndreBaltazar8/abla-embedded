import "./context_extra_esp32s3.ab"
// Architecture-only CALL0 leaves: a2 points to caller-owned save memory;
// a3 scratch, other address registers preserved. Not ordinary Abla-callable.
// CPENABLE bit0/3 must be enabled before using its save/restore instructions.
// CP0:72bytes aligned4 (F0..15,FCR,FSR). CP3:208bytes aligned16 (18 user
// registers, padding72..79 untouched, Q0..7 at80..207). Pointer a2 preserved.
// LLVM MC lacks legacy ST.QR/LD.QR mnemonics. Their exact3-byte encodings
// below were independently verified with Espressif GNU as; these are hardware
// instructions, not linked object code. EE.VST/VLD postincrement differs.
// No ownership switch, allocation or automatic enabling; caller serializes
// register ownership and prevents interrupts/migration while these run.
@naked
@noinline
@section(".iram1.abla.s3Cp0Save")
trusted fun esp32S3Cp0Save(): void =
    esp32S3ContextExtraAssembly("ssi f0, a2, 0\nssi f1, a2, 4\nssi f2, a2, 8\nssi f3, a2, 12\nssi f4, a2, 16\nssi f5, a2, 20\nssi f6, a2, 24\nssi f7, a2, 28\nssi f8, a2, 32\nssi f9, a2, 36\nssi f10, a2, 40\nssi f11, a2, 44\nssi f12, a2, 48\nssi f13, a2, 52\nssi f14, a2, 56\nssi f15, a2, 60\nrur.fcr a3\ns32i a3, a2, 64\nrur.fsr a3\ns32i a3, a2, 68\nret", "~{memory}")
@inline
trusted fun esp32S3Cp0SaveAddress(): int = nativeFunctionAddress(esp32S3Cp0Save)
@naked
@noinline
@section(".iram1.abla.s3Cp0Restore")
trusted fun esp32S3Cp0Restore(): void =
    esp32S3ContextExtraAssembly("lsi f0, a2, 0\nlsi f1, a2, 4\nlsi f2, a2, 8\nlsi f3, a2, 12\nlsi f4, a2, 16\nlsi f5, a2, 20\nlsi f6, a2, 24\nlsi f7, a2, 28\nlsi f8, a2, 32\nlsi f9, a2, 36\nlsi f10, a2, 40\nlsi f11, a2, 44\nlsi f12, a2, 48\nlsi f13, a2, 52\nlsi f14, a2, 56\nlsi f15, a2, 60\nl32i a3, a2, 64\nwur.fcr a3\nl32i a3, a2, 68\nwur.fsr a3\nrsync\nret", "~{memory}")
@inline
trusted fun esp32S3Cp0RestoreAddress(): int = nativeFunctionAddress(esp32S3Cp0Restore)
@naked
@noinline
@section(".iram1.abla.s3Cp3Save")
trusted fun esp32S3Cp3Save(): void =
    esp32S3ContextExtraAssembly("rur a3, 0\ns32i a3, a2, 0\nrur a3, 1\ns32i a3, a2, 4\nrur a3, 2\ns32i a3, a2, 8\nrur a3, 3\ns32i a3, a2, 12\nrur a3, 4\ns32i a3, a2, 16\nrur a3, 5\ns32i a3, a2, 20\nrur a3, 6\ns32i a3, a2, 24\nrur a3, 7\ns32i a3, a2, 28\nrur a3, 8\ns32i a3, a2, 32\nrur a3, 9\ns32i a3, a2, 36\nrur a3, 10\ns32i a3, a2, 40\nrur a3, 11\ns32i a3, a2, 44\nrur a3, 13\ns32i a3, a2, 48\nrur a3, 14\ns32i a3, a2, 52\nrur a3, 15\ns32i a3, a2, 56\nrur a3, 16\ns32i a3, a2, 60\nrur a3, 17\ns32i a3, a2, 64\nrur a3, 18\ns32i a3, a2, 68\n.byte 0x24, 0x65, 0xcd # st.qr q0, a2, 80\n.byte 0x24, 0xe6, 0xcd # st.qr q1, a2, 96\n.byte 0x24, 0x67, 0xdd # st.qr q2, a2, 112\naddmi a2, a2, 256\naddi a2, a2, -128\n.byte 0x24, 0xe0, 0xdd # st.qr q3, a2, 0\n.byte 0x24, 0x61, 0xed # st.qr q4, a2, 16\n.byte 0x24, 0xe2, 0xed # st.qr q5, a2, 32\n.byte 0x24, 0x63, 0xfd # st.qr q6, a2, 48\n.byte 0x24, 0xe4, 0xfd # st.qr q7, a2, 64\naddi a2, a2, -128\nret", "~{memory}")
@inline
trusted fun esp32S3Cp3SaveAddress(): int = nativeFunctionAddress(esp32S3Cp3Save)
@naked
@noinline
@section(".iram1.abla.s3Cp3Restore")
trusted fun esp32S3Cp3Restore(): void =
    esp32S3ContextExtraAssembly("l32i a3, a2, 0\nwur a3, 0\nl32i a3, a2, 4\nwur a3, 1\nl32i a3, a2, 8\nwur a3, 2\nl32i a3, a2, 12\nwur a3, 3\nl32i a3, a2, 16\nwur a3, 4\nl32i a3, a2, 20\nwur a3, 5\nl32i a3, a2, 24\nwur a3, 6\nl32i a3, a2, 28\nwur a3, 7\nl32i a3, a2, 32\nwur a3, 8\nl32i a3, a2, 36\nwur a3, 9\nl32i a3, a2, 40\nwur a3, 10\nl32i a3, a2, 44\nwur a3, 11\nl32i a3, a2, 48\nwur a3, 13\nl32i a3, a2, 52\nwur a3, 14\nl32i a3, a2, 56\nwur a3, 15\nl32i a3, a2, 60\nwur a3, 16\nl32i a3, a2, 64\nwur a3, 17\nl32i a3, a2, 68\nwur a3, 18\n.byte 0x24, 0x25, 0xcd # ld.qr q0, a2, 80\n.byte 0x24, 0xa6, 0xcd # ld.qr q1, a2, 96\n.byte 0x24, 0x27, 0xdd # ld.qr q2, a2, 112\naddmi a2, a2, 256\naddi a2, a2, -128\n.byte 0x24, 0xa0, 0xdd # ld.qr q3, a2, 0\n.byte 0x24, 0x21, 0xed # ld.qr q4, a2, 16\n.byte 0x24, 0xa2, 0xed # ld.qr q5, a2, 32\n.byte 0x24, 0x23, 0xfd # ld.qr q6, a2, 48\n.byte 0x24, 0xa4, 0xfd # ld.qr q7, a2, 64\naddi a2, a2, -128\nrsync\nret", "~{memory}")
@inline
trusted fun esp32S3Cp3RestoreAddress(): int = nativeFunctionAddress(esp32S3Cp3Restore)
