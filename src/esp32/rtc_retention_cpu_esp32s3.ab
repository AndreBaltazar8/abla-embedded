import "./rtc_retention_cpu_s3_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../hal/esp32.ab"
@inline
@export("esp32S3RetentionRead")
trusted fun esp32S3RetentionReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3RetentionWrite")
trusted fun esp32S3RetentionWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
@inline
@export("esp32S3RetentionCacheOperation")
trusted fun esp32S3RetentionCacheOperationHook(operation: int): void {
    // ESP32-S3 ROM cache primitives, exact void(void) ABI.
    callNativeVoid0(if (operation == 0) 0x400016F8 else if (operation == 1) 0x400016D4 else 0x400016E0)
    return
}
