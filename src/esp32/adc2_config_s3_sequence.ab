import "./adc2_oneshot_s3_sequence.ab"
// S3 adc_oneshot_hal_setup/adc_ll.h: divider1, non-inverted12bit,
// attenuation, PWDET CCT4, RTC software start/pad control.
// Caller owns/quiesces ADC2 including PWDET configuration while this runs,
// excludes ULP/DMA/sleep and pins power/clocks/pad. Arbiter must already permit
// RTC; normal arbitration requires APB>=8MHz. Does not change its priorities.
// Leaves selected attenuation and CCT4 configured; not a temporary override
// of an unrelated WiFi driver's configuration. No shared reset/power writes.
// Low8:1configured2invalid3foreign/controller4pending5readback; high8stage.
// Retain ownership after partial failure; finalstage1029 needs checked setup
// retry before detach if the software force bits did not latch.
trusted fun esp32S3Adc2Field(offset: int,mask: int,value: int): bool {
    esp32S3Adc2Write(offset,(esp32S3Adc2Read(offset)&(4294967295^mask))|value)
    return (esp32S3Adc2Read(offset)&mask) == value
}
trusted fun esp32S3Adc2ConfigureOwned(channel: int,attenuation: int): int {
    if (channel < 0 || channel > 9 || attenuation < 0 || attenuation > 3) return 2
    val arbiter=esp32S3Adc2ArbiterRead()
    if (((arbiter&32) != 0 && (arbiter&60) != 40) || (esp32S3Adc2Read(52)&0x80000000) != 0) return 3
    val before=esp32S3Adc2Read(48)
    val pads=before&0x7ff80000
    if (pads != 0 && pads != ((1<<channel)<<19)) return 3
    if ((before&0x30000) == 0x20000) return 4
    // ADC2 IRQ/invert bits differ from ADC1. Preserve arbiter-stable wait,
    // sample count and gate fields; interrupt generation disabled for polling.
    if (!esp32S3Adc2Field(36,0x600000ff,1)) return 261
    if (!esp32S3Adc2Field(56,3<<(channel*2),attenuation<<(channel*2))) return 517
    if (!esp32S3Adc2Field(52,0x70000000,0x40000000)) return 773
    esp32S3Adc2Write(48,0x80040000)
    if ((esp32S3Adc2Read(48)&0xfffe0000) != 0x80040000) return 1029
    return 1
}
