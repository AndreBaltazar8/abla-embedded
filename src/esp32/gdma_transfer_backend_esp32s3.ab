import "./gdma_esp32s3.ab"
import "./gdma_transfer_esp32s3.ab"
import "./gdma_pump_esp32s3.ab"

// Shared DMA memory uses explicit volatile accesses. Aligned whole words are
// copied directly; unaligned CPU slices and remaining bytes stay byte-safe.
// No libc memcpy or allocation is introduced into the monolithic image.
trusted fun esp32s3GdmaCopyBytes(destination: int, source: int, count: int): void {
    var offset = 0
    if (((destination | source) & 3) == 0) {
        while (offset + 4 <= count) {
            mmioStoreU32(destination + offset, mmioLoadU32(source + offset))
            offset = offset + 4
        }
    }
    while (offset < count) {
        mmioStoreU8(destination + offset, mmioLoadU8(source + offset))
        offset = offset + 1
    }
    return
}
