import "./coprocessor_dispatch_esp32s3.ab"
import "./coprocessor_policy_s3_sequence.ab"
import "./exception_handler_esp32s3.ab"
import "./syscall_frame_s3.ab"
@inline
trusted fun esp32S3CpPolicySyscall(frame: NativeBuffer): bool = esp32S3SyscallFrameOwned(frame)
@inline
trusted fun esp32S3CpPolicyFallback(callback: int,frame: int,cause: int,core: int,context: int): void {
    callNativeVoidI32I32I32I32(callback,frame,cause,core,context); return
}
@inline
trusted fun esp32S3CoprocessorPolicyAddress(): int = nativeFunctionAddress(esp32S3CoprocessorPolicy)
