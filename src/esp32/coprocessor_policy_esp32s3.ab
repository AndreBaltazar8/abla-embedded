import "./coprocessor_dispatch_esp32s3.ab"
import "./coprocessor_policy_s3_sequence.ab"
import "./exception_handler_esp32s3.ab"
import "./syscall_frame_s3.ab"
import "../hal/esp32.ab"
import "./sdk/raw_buffer.ab"
import "abla/unsafe/native"
import "./sdk/nativebuffer_type.ab"
@inline
@export("esp32S3CpPolicySyscall")
trusted fun esp32S3CpPolicySyscallHook(frame: NativeBuffer): bool = esp32S3SyscallFrameOwned(frame)
@inline
@export("esp32S3CpPolicyFallback")
trusted fun esp32S3CpPolicyFallbackHook(callback: int,frame: int,cause: int,core: int,context: int): void {
    callNativeVoidI32I32I32I32(callback,frame,cause,core,context); return
}
@inline
@export("esp32S3CoprocessorPolicyAddress")
trusted fun esp32S3CoprocessorPolicyAddressHook(): int = nativeFunctionAddress(esp32S3CoprocessorPolicy)
