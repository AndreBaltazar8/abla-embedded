import "./adc_trim_s3_sequence.ab"
import "./adc_fuse_esp32s3.ab"
import "abla/unsafe/native"
// S3 hardware ROM boundary, same SAR bus used by analog sleep controls.
// ROM routines busy-wait internally: software polls cannot bound a hung bus.
// Caller needs an independent watchdog/recovery policy; no bounded-time claim.
trusted fun esp32S3SarAnalogRead(register: int): int =
    callNativeU32I32I32I32(0x40005d48,105,1,register)&255
trusted fun esp32S3SarAnalogWrite(register: int,value: int): void {
    callNativeVoidI32I32I32I32I32I32(0x40005d6c,105,1,register,7,0,value)
    return
}
