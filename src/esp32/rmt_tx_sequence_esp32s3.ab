// Low-level channel primitives. Caller exclusively owns a STOPPED TX channel
// and its48-word SRAM block; group clock, memory power/access and pad routing
// must already be configured. These functions do not allocate or infer idle.
fun esp32s3RmtTxCommandMask(): int = 0x01800087
// Only RMT TXchannel3 has DMA. Caller owns a stopped channel; enabling
// this route does not start either DMA or RMT. DMA frames can exceed the
// 48-word hardware block, so DMA mode also owns memory wrap (bit4). This is
// not continuous/loop playback (bit3); the frame's zero word still ends TX.
trusted fun esp32s3RmtSetTxDmaOwned(channel: int, enabled: bool): bool {
    if (channel != 3) return false
    val address = 0x6001602c
    val config = esp32s3RmtRead(address) &
        (0xffffffff ^ (esp32s3RmtTxCommandMask() | 0x02000010))
    esp32s3RmtWrite(address, config | (if (enabled) 0x02000010 else 0))
    esp32s3RmtWrite(address, config | 0x01000000 | (if (enabled) 0x02000010 else 0))
    true
}
trusted fun esp32s3RmtConfigureSingleBlockTxOwned(channel: int, divider: int): bool {
    if (channel < 0 || channel > 3 || divider < 1 || divider > 256) return false
    val address = 0x60016020 + channel * 4
    // Stop/loop/wrap/carrier disabled, idle output enabled low, one block.
    // Channel3 alone has DMA access; leave other channels' reserved bit25.
    val mask = esp32s3RmtTxCommandMask() | 0x002ffff8 |
        (if (channel == 3) 0x02000000 else 0)
    val config = (esp32s3RmtRead(address) & (0xffffffff ^ mask)) |
        ((divider & 255) << 8) | 0x00010040
    esp32s3RmtWrite(address, config)
    // SDK reset-pointer order: read pointer high/low, APB pointer high/low.
    esp32s3RmtWrite(address, config | 2)
    esp32s3RmtWrite(address, config)
    esp32s3RmtWrite(address, config | 4)
    esp32s3RmtWrite(address, config)
    esp32s3RmtWrite(address, config | 0x01000000)
    true
}

// START requires a populated/terminated SRAM block. STOP only requests an
// asynchronous stop, not permission to reclaim storage or gate the clock.
trusted fun esp32s3RmtTxRequestOwned(channel: int, start: bool): bool {
    if (channel < 0 || channel > 3) return false
    val address = 0x60016020 + channel * 4
    val config = esp32s3RmtRead(address) & (0xffffffff ^ esp32s3RmtTxCommandMask())
    esp32s3RmtPublish()
    if (start) {
        esp32s3RmtWrite(address, config | 0x01000000)
        esp32s3RmtWrite(address, config | 0x01000001)
    } else {
        esp32s3RmtWrite(address, config | 128)
        esp32s3RmtWrite(address, config | 0x01000080)
    }
    true
}

// Normalized events: bit0 done,bit1 error,bit2 threshold,bit3 loop-end.
// Reading does not acknowledge. Invalid channel returns-1.
trusted fun esp32s3RmtTxEvents(channel: int): int {
    if (channel < 0 || channel > 3) return -1
    val raw = esp32s3RmtRead(0x60016070) >>> channel
    (raw & 1) | ((raw >>> 3) & 2) | ((raw >>> 6) & 4) | ((raw >>> 9) & 8)
}
trusted fun esp32s3RmtTxAcknowledge(channel: int, events: int): bool {
    if (channel < 0 || channel > 3 || events < 0 || events > 15) return false
    val mask = (events & 1) | ((events & 2) << 3) |
        ((events & 4) << 6) | ((events & 8) << 9)
    if (mask != 0) esp32s3RmtWrite(0x6001607c, mask << channel)
    true
}
