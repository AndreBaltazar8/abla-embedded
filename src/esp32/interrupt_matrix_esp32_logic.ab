import "../xtensa/cpu_logic.ab"

val esp32InterruptMatrixBase = 1072693248
val esp32ProInterruptMapOffset = 260
val esp32AppInterruptMapOffset = 536
val esp32InterruptSourceCount = 69
val esp32InterruptMapMask = 31
val esp32InvalidCpuInterrupt = 6
val esp32XtensaCoreCount = 2
val esp32XtensaMaximumDispatchLevel = 3

type Esp32Cpu = int
type Esp32InterruptSource = int

@inline
fun esp32Cpu(number: int): Esp32Cpu = Esp32Cpu(number)
@inline
fun Esp32Cpu.valid(): bool = this >= 0 && this < 2
@inline
fun Esp32Cpu.number(): int = this

fun esp32InterruptSource(number: int): Esp32InterruptSource =
    Esp32InterruptSource(number)
fun Esp32InterruptSource.valid(): bool =
    this >= 0 && this < esp32InterruptSourceCount
fun Esp32InterruptSource.number(): int = this

fun esp32WifiMacInterruptSource(): Esp32InterruptSource =
    Esp32InterruptSource(0)

@inline
fun esp32WifiMacInterrupt(): XtensaInterrupt = xtensaInterrupt(0)

@inline
fun esp32XtensaInterruptLevel(interrupt: XtensaInterrupt): int {
    if (!interrupt.valid()) return -1
    val number = int(interrupt.number())
    if (number <= 10 || number == 12 ||
        (number >= 16 && number <= 18)) return 1
    if (number >= 19 && number <= 21) return 2
    if (number == 11 || number == 14 || number == 22 || number == 23 ||
        number == 27 || number == 29) return 3
    if (number == 24 || number == 25 || number == 28 || number == 30) return 4
    if (number == 15 || number == 26 || number == 31) return 5
    if (number == 13) return 7
    -1
}

@inline
fun esp32XtensaInterruptSupportsNativeHandler(
    interrupt: XtensaInterrupt
): bool {
    val level = esp32XtensaInterruptLevel(interrupt)
    level >= 0 && level <= esp32XtensaMaximumDispatchLevel
}

fun esp32InterruptMapAddress(
    cpu: Esp32Cpu,
    source: Esp32InterruptSource
): int {
    if (!cpu.valid() || !source.valid()) return -1
    esp32InterruptMatrixBase +
        (if (cpu.number() == 0) esp32ProInterruptMapOffset
         else esp32AppInterruptMapOffset) + source.number() * 4
}
