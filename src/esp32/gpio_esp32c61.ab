import "./gpio_pin_c61_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("c61GpioRead")
trusted fun c61GpioReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("c61GpioWrite")
trusted fun c61GpioWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
