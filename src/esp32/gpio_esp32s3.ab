import "./gpio/probe_esp32s3.ab"
import "./gpio/matrix_routes_esp32s3.ab"
import "./gpio/park_s3_sequence.ab"
import "./gpio/output_s3_sequence.ab"
import "./gpio/snapshot_esp32s3.ab"

// Select this module instead of gpio.ab on S3. Pin stays a nominal integer;
// method names match classic ESP32, but no classic register map is imported.
// Callers own the pad and must release RTC/USB/peripheral ownership first.
type Pin = int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this
fun Pin.valid(): bool = espChipS3().gpioValid(this)
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this)
fun Pin.pullCapable(): bool = espChipS3().gpioValid(this)

@inline
trusted fun Pin.selectGpioFunction(inputEnabled: bool): void {
    val address = esp32S3GpioMuxAddress(this)
    if (address != 0) esp32S3GpioUpdate(address, 29184,
        4096 | (if (inputEnabled) 512 else 0))
    return
}

@inline
trusted fun Pin.setOpenDrain(enabled: bool): void {
    if (espChipS3().gpioValid(this)) {
        esp32S3GpioUpdate(0x60004074 + this * 4, 4, if (enabled) 4 else 0)
    }
    return
}

@inline
trusted fun Pin.setPull(up: bool, down: bool): void {
    if (espChipS3().gpioValid(this)) {
        val mode = if (up && down) 2 else if (up) 0 else if (down) 1 else 3
        gpio_set_pull_mode(i32(this.number()), i32(mode))
    }
    return
}

trusted fun Pin.pullUp(): void = this.setPull(true, false)
trusted fun Pin.pullDown(): void = this.setPull(false, true)
trusted fun Pin.floating(): void = this.setPull(false, false)

// Checked push-pull output setup with initial latch established before enable.
trusted fun Pin.outputLevelOwned(high: bool): bool =
    esp32S3GpioOutputLevelOwned(this.number(), high)
trusted fun Pin.writeLevelOwned(high: bool): bool =
    esp32S3GpioWriteLevelOwned(this.number(), high)
trusted fun Pin.inputOwned(): bool = esp32S3GpioInputOwned(this.number())

trusted fun Pin.setDriveStrength(strength: int): bool {
    if (!espChipS3().gpioOutputValid(this) || strength < 0 || strength > 3) return false
    gpio_set_drive_capability(i32(this.number()), i32(strength)) == i32(0)
}

@inline
trusted fun Pin.output(): void {
    if (espChipS3().gpioOutputValid(this)) {
        if (!esp32S3GpioParkOutputOwned(this.number())) return
        this.selectGpioFunction(false)
        // GPIO latch selects data (256) and output enable (bit10).
        esp32S3GpioUpdate(0x60004554 + this * 4, 4095, 1280)
        gpio_set_direction(i32(this.number()), i32(2))
    }
    return
}

@inline
trusted fun Pin.input(): void {
    if (espChipS3().gpioValid(this)) {
        if (!esp32S3GpioParkOutputOwned(this.number())) return
        gpio_set_direction(i32(this.number()), i32(1))
        esp32S3GpioUpdate(0x60004554 + this * 4, 3072, 1024)
        this.selectGpioFunction(true)
    }
    return
}

@inline
trusted fun Pin.openDrainOutput(): void {
    if (espChipS3().gpioOutputValid(this)) {
        if (!esp32S3GpioParkOutputOwned(this.number())) return
        // Establish open drain before enabling output, avoiding push-pull high.
        this.setOpenDrain(true)
        this.selectGpioFunction(false)
        esp32S3GpioUpdate(0x60004554 + this * 4, 4095, 1280)
        gpio_set_direction(i32(this.number()), i32(6))
    }
    return
}

@inline
trusted fun Pin.write(level: bool): void {
    if (espChipS3().gpioOutputValid(this)) gpio_set_level(i32(this.number()), if (level) u32(1) else u32(0))
    return
}

@inline
trusted fun Pin.read(): bool =
    espChipS3().gpioValid(this) && gpio_get_level(i32(this.number())) != i32(0)

// Invalid GPIO is an error, not a low input sample. Caller owns pad/clocks.
trusted fun Pin.readLevelOwned(): int =
    if (!this.valid()) -1 else int(gpio_get_level(i32(this.number())))
