import "./gpio/probe_esp32s3.ab"
import "./gpio/matrix_routes_esp32s3.ab"
import "./gpio/park_s3_sequence.ab"
import "./gpio/output_s3_sequence.ab"
import "./gpio/snapshot_esp32s3.ab"
import "../hal/esp32_gpio.ab"
import "../hal/pin.ab"
import "./soc/gpio_capabilities.ab"
import "./gpio/s3_logic.ab"

// Select this module instead of gpio.ab on S3. Pin stays a nominal integer;
// method names match classic ESP32, but no classic register map is imported.
// Callers own the pad and must release RTC/USB/peripheral ownership first.
@exportLocal("abla_pin_valid")
fun pinValidHook(pin: int): bool = espChipS3().gpioValid(Pin(pin))
@exportLocal("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = espChipS3().gpioOutputValid(Pin(pin))
@exportLocal("abla_pin_pullCapable")
fun pinPullCapableHook(pin: int): bool = espChipS3().gpioValid(Pin(pin))

@inline
@exportLocal("abla_pin_selectGpioFunction")
trusted fun pinSelectGpioFunctionHook(pin: int, inputEnabled: bool): void {
    val address = esp32S3GpioMuxAddress(Pin(pin))
    if (address != 0) esp32S3GpioUpdate(address, 29184,
        4096 | (if (inputEnabled) 512 else 0))
    return
}

@inline
@exportLocal("abla_pin_setOpenDrain")
trusted fun pinSetOpenDrainHook(pin: int, enabled: bool): void {
    if (espChipS3().gpioValid(Pin(pin))) {
        esp32S3GpioUpdate(0x60004074 + Pin(pin) * 4, 4, if (enabled) 4 else 0)
    }
    return
}

@inline
@exportLocal("abla_pin_setPull")
trusted fun pinSetPullHook(pin: int, up: bool, down: bool): void {
    if (espChipS3().gpioValid(Pin(pin))) {
        val mode = if (up && down) 2 else if (up) 0 else if (down) 1 else 3
        gpio_set_pull_mode(i32(Pin(pin).number()), i32(mode))
    }
    return
}

@exportLocal("abla_pin_pullUp")
trusted fun pinPullUpHook(pin: int): void = Pin(pin).setPull(true, false)
@exportLocal("abla_pin_pullDown")
trusted fun pinPullDownHook(pin: int): void = Pin(pin).setPull(false, true)
@exportLocal("abla_pin_floating")
trusted fun pinFloatingHook(pin: int): void = Pin(pin).setPull(false, false)

// Checked push-pull output setup with initial latch established before enable.
@exportLocal("abla_pin_outputLevelOwned")
trusted fun pinOutputLevelOwnedHook(pin: int, high: bool): bool =
    esp32S3GpioOutputLevelOwned(Pin(pin).number(), high)
@exportLocal("abla_pin_writeLevelOwned")
trusted fun pinWriteLevelOwnedHook(pin: int, high: bool): bool =
    esp32S3GpioWriteLevelOwned(Pin(pin).number(), high)
@exportLocal("abla_pin_inputOwned")
trusted fun pinInputOwnedHook(pin: int): bool = esp32S3GpioInputOwned(Pin(pin).number())

@exportLocal("abla_pin_setDriveStrength")
trusted fun pinSetDriveStrengthHook(pin: int, strength: int): bool {
    if (!espChipS3().gpioOutputValid(Pin(pin)) || strength < 0 || strength > 3) return false
    gpio_set_drive_capability(i32(Pin(pin).number()), i32(strength)) == i32(0)
}

@inline
@exportLocal("abla_pin_output")
trusted fun pinOutputHook(pin: int): void {
    if (espChipS3().gpioOutputValid(Pin(pin))) {
        if (!esp32S3GpioParkOutputOwned(Pin(pin).number())) return
        Pin(pin).selectGpioFunction(false)
        // GPIO latch selects data (256) and output enable (bit10).
        esp32S3GpioUpdate(0x60004554 + Pin(pin) * 4, 4095, 1280)
        gpio_set_direction(i32(Pin(pin).number()), i32(2))
    }
    return
}

@inline
@exportLocal("abla_pin_input")
trusted fun pinInputHook(pin: int): void {
    if (espChipS3().gpioValid(Pin(pin))) {
        if (!esp32S3GpioParkOutputOwned(Pin(pin).number())) return
        gpio_set_direction(i32(Pin(pin).number()), i32(1))
        esp32S3GpioUpdate(0x60004554 + Pin(pin) * 4, 3072, 1024)
        Pin(pin).selectGpioFunction(true)
    }
    return
}

@inline
@exportLocal("abla_pin_openDrainOutput")
trusted fun pinOpenDrainOutputHook(pin: int): void {
    if (espChipS3().gpioOutputValid(Pin(pin))) {
        if (!esp32S3GpioParkOutputOwned(Pin(pin).number())) return
        // Establish open drain before enabling output, avoiding push-pull high.
        Pin(pin).setOpenDrain(true)
        Pin(pin).selectGpioFunction(false)
        esp32S3GpioUpdate(0x60004554 + Pin(pin) * 4, 4095, 1280)
        gpio_set_direction(i32(Pin(pin).number()), i32(6))
    }
    return
}

@inline
@exportLocal("abla_pin_write")
trusted fun pinWriteHook(pin: int, level: bool): void {
    if (espChipS3().gpioOutputValid(Pin(pin))) gpio_set_level(i32(Pin(pin).number()), if (level) u32(1) else u32(0))
    return
}

@inline
@exportLocal("abla_pin_read")
trusted fun pinReadHook(pin: int): bool =
    espChipS3().gpioValid(Pin(pin)) && gpio_get_level(i32(Pin(pin).number())) != i32(0)

// Invalid GPIO is an error, not a low input sample. Caller owns pad/clocks.
@exportLocal("abla_pin_readLevelOwned")
trusted fun pinReadLevelOwnedHook(pin: int): int =
    if (!Pin(pin).valid()) -1 else int(gpio_get_level(i32(Pin(pin).number())))
