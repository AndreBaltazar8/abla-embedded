// ESP-IDF v6.0.2 hal/esp32s3/sar_ctrl_ll.h shared SAR supply.
// Caller serializes shared SENS RMW across cores. Exclusive permission means
// no ADC/PWDET/temperature/ULP/DMA/sleep user can acquire this supply during
// the whole lease. Otherwise only borrow an upstream pinned force-on lease.
// Not a driver reference counter. Does not change PHY PWDET routing.
type Esp32S3AdcPower = int
fun Esp32S3AdcPower.bits(): int = this
fun Esp32S3AdcPower.status(): int = this&255
fun Esp32S3AdcPower.powered(): bool = this.status() == 1
// 0closed1on2invalidmode3exclusive-required4readback5busy6state-lost.
// bits8clock,9..10originalmode,11owned,12borrowed. On means verified fields,
// NOT measured voltage or analog settling. Retain failed open/close tokens.
trusted fun esp32S3AdcPowerField(address: int,mask: int,value: int): bool {
    val before=esp32S3SarRead(address)
    val desired=(before&(4294967295^mask))|value
    if (desired != before) esp32S3SarWrite(address,desired)
    return (esp32S3SarRead(address)&mask) == value
}
trusted fun esp32S3AdcPowerOpenOwned(exclusive: bool): Esp32S3AdcPower {
    val clock=(esp32S3SarRead(0x60008904)>>30)&1
    val mode=(esp32S3SarRead(0x6000883c)>>29)&3
    if (mode == 1) return Esp32S3AdcPower(2)
    if (clock == 1 && mode == 3) return Esp32S3AdcPower(4097)
    if (!exclusive) return Esp32S3AdcPower(3)
    val token=(clock<<8)|(mode<<9)|2048
    // IDF orders clock then force mode. Never pulse the shared reset.
    if (!esp32S3AdcPowerField(0x60008904,0x40000000,0x40000000) ||
        !esp32S3AdcPowerField(0x6000883c,0x60000000,0x60000000)) return Esp32S3AdcPower(token|4)
    return Esp32S3AdcPower(token|1)
}
trusted fun Esp32S3AdcPower.closeOwned(): Esp32S3AdcPower {
    val flags=this&0x1f00
    val mode=(esp32S3SarRead(0x6000883c)>>29)&3
    if ((flags&4096) != 0) {
        if (mode != 3 || (esp32S3SarRead(0x60008904)&0x40000000) == 0) return Esp32S3AdcPower(flags|6)
        return Esp32S3AdcPower(0)
    }
    if ((flags&2048) == 0) return Esp32S3AdcPower(0)
    val original=(flags>>9)&3
    if (mode != 3 && mode != original) return Esp32S3AdcPower(flags|6)
    // Call after releasing every dependent acquisition. Visible RTC guards
    // supplement caller exclusion of DMA/PWDET/temperature, not prove it.
    if ((esp32S3SarRead(0x60008840)&0x3fc00000) != 0 ||
        (esp32S3SarRead(0x6000880c)&0x30000) == 0x20000 ||
        (esp32S3SarRead(0x60008830)&0x30000) == 0x20000) return Esp32S3AdcPower(flags|5)
    if (!esp32S3AdcPowerField(0x60008904,0x40000000,((flags>>8)&1)<<30) ||
        !esp32S3AdcPowerField(0x6000883c,0x60000000,original<<29)) return Esp32S3AdcPower(flags|4)
    return Esp32S3AdcPower(0)
}
