import "./ahb_gdma_channel_c5_sequence.ab"
// Raw event snapshot: status8,raw8@8,TX16,channel2@17,valid19.
// Read status1snapshot2invalid3clock4IRQ-owned5unknown event bits.
// C5 includes AHB response errors at RX7/TX6, beyond LL legacy masks.
// Caller owns selected direction/ISR and serializes snapshot/ack. Events are
// sticky bits, not counters: repeated same-bit occurrences may coalesce.
type C5AhbGdmaEvents=int
fun C5AhbGdmaEvents.status(): int = this&255
fun C5AhbGdmaEvents.raw(): int = (this>>>8)&255
fun C5AhbGdmaEvents.errors(): int = this.raw()&(if ((this&(1<<16)) != 0) 0x74 else 0xfc)
fun C5AhbGdmaEvents.descriptorDone(): bool = (this.raw()&1) != 0
fun C5AhbGdmaEvents.eof(): bool = (this.raw()&2) != 0
fun C5AhbGdmaEvents.txTotalEof(): bool = (this&(1<<16)) != 0 && (this.raw()&8) != 0
trusted fun c5AhbGdmaEventsReadOwned(channel: int,tx: bool,exclusive: bool): C5AhbGdmaEvents {
    if (!exclusive || channel < 0 || channel > 2) return C5AhbGdmaEvents(2)
    if (!c5AhbGdmaChannelClocks()) return C5AhbGdmaEvents(3)
    val at=c5AhbGdmaEventBase(channel,tx)
    if (c5AhbGdmaRead(at+8) != u32(0)) return C5AhbGdmaEvents(4)
    val raw=c5AhbGdmaRead(at)
    if ((raw&~u32(if (tx) 127 else 255)) != u32(0)) return C5AhbGdmaEvents(5)
    return C5AhbGdmaEvents((1<<19)|(channel<<17)|(if (tx) 1<<16 else 0)|(int(raw)<<8)|1)
}
// Acknowledge only explicitly handled bits present in this snapshot.
// Returns1cleared2invalid3clock4IRQ-owned6still-set (new or uncleared event).
// Exactly one W1C write; never RMW or auto-retry. No completion is inferred
// from clearing: park/FIFO/descriptor/cache ownership must be joined separately.
trusted fun C5AhbGdmaEvents.acknowledgeOwned(handled: int,exclusive: bool): int {
    if (!exclusive || this < 0 || (this&~0xfffff) != 0 || (this&(1<<19)) == 0 || this.status() != 1 ||
        handled < 0 || (handled&~this.raw()) != 0) return 2
    val tx=(this&(1<<16)) != 0
    val channel=(this>>>17)&3
    if (channel > 2 || (this.raw()&~(if (tx) 127 else 255)) != 0) return 2
    if (!c5AhbGdmaChannelClocks()) return 3
    val at=c5AhbGdmaEventBase(channel,tx)
    if (c5AhbGdmaRead(at+8) != u32(0)) return 4
    if (handled == 0) return 1
    c5AhbGdmaWrite(at+12,u32(handled))
    return if ((c5AhbGdmaRead(at)&u32(handled)) == u32(0)) 1 else 6
}
