import "./dma_finite_c5_sequence.ab"
// Explicit abort: phase7aborting8aborted; original error8/events12 retained.
// Returns1quiesced2invalid4recovery failure5pending8FIFO needs drain/discard.
// Does not pretend the transfer completed, acquire unread data, change owner
// bits or release configuration/pads/clocks. Caller must inspect saved error.
// discard permits destructive DMA FIFO reset ONLY after I2S stop/DMA PARK
// and recorded event acknowledgement. It does not bypass a stop timeout.
// Shutdown reserved word20 tracks reset:0none1deassert recovery2reset done.
trusted fun c5I2sDmaFiniteAbortOwned(r: NativeBuffer,polls: int,exclusive: bool,discard: bool): int {
    if (!c5I2sDmaFiniteStorage(r) || r.loadU32(0) != 0x43354946) return 2
    return c5I2sDmaAbortLayoutOwned(r,polls,exclusive,discard)
}
// Shared140B ownership layout for finite and circular sessions. Keeping one
// shutdown implementation preserves UPDATE/STOP/reset recovery ordering.
trusted fun c5I2sDmaAbortLayoutOwned(r: NativeBuffer,polls: int,exclusive: bool,discard: bool): int {
    if (!exclusive || !c5I2sDmaFiniteStorage(r) || (r.loadU32(0) != 0x43354946 && r.loadU32(0) != 0x43354954) || polls < 1 || polls > 1000000 || r.loadU32(4) < 1 || r.loadU32(4) > 8) return 2
    if (r.loadU32(4) == 8) return 1
    r.storeU32(4,7)
    val start=nativeBufferAt(r.addressValue()+16,72)
    // Startup admission can fail before any resource/descriptor mutation.
    if (start.loadU32(0) == 0) { r.storeU32(4,8);return 1 }
    val shutdown=nativeBufferAt(r.addressValue()+116,24)
    val channel=start.loadU32(12);val tx=start.loadU32(16) != 0
    if (shutdown.loadU32(0) == 0x43354951 && shutdown.loadU32(20) == 1) {
        val released=c5AhbGdmaResetOwned(channel,tx,true,false,true)
        if (released != 1) { shutdown.storeU32(12,0x70000|released);return 4 }
        shutdown.storeU32(20,2)
    }
    val stopped=c5I2sDmaStopOwned(start,shutdown,polls,true)
    if (stopped != 1 && stopped != 8) return stopped
    if (stopped == 8 && !discard) return 8
    val events=c5AhbGdmaEventsReadOwned(channel,tx,true)
    if (events.status() != 1) { shutdown.storeU32(12,0x50000|events.status());return 4 }
    r.storeU32(12,r.loadU32(12)|events.raw())
    val ack=events.acknowledgeOwned(events.raw(),true)
    if (ack != 1) { shutdown.storeU32(12,0x60000|ack);return if (ack == 6) 5 else 4 }
    if (stopped == 8) {
        if (shutdown.loadU32(20) == 2) return 8
        val reset=c5AhbGdmaResetOwned(channel,tx,true,true,false)
        if (reset == 5) shutdown.storeU32(20,1)
        if (reset != 1) { shutdown.storeU32(12,0x70000|reset);return 4 }
        shutdown.storeU32(20,2)
        if ((c5AhbGdmaRead(c5AhbGdmaChannelBase(channel,tx)+8)&u32(2)) == u32(0)) return 8
    }
    r.storeU32(4,8);return 1
}
