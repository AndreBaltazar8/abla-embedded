import "./dma_start_c6_sequence.ab"
import "../gdma_buffer_c6_sequence.ab"
// 28B retained completion record:tag0,state4,bound start8,cursor12,
// acquired byte count16,observed DMA events20,last acquire status24.
// Finite chains only; circular streaming requires consume/rearm ownership.
// Returns1all buffers acquired2invalid3latched error5pending. A success proves
// CPU buffer ownership, NOT that I2S has drained or that sound was played.
// No automatic stop/ack/rearm/free; use ordered shutdown and handle events.
// Caller keeps the start record/layout immutable, excludes descriptor writers,
// and does not rearm or restart this chain while tracking completion.
fun c6I2sDmaCompletionStorage(q: NativeBuffer): bool = q.hasAddressRange(0,28) && (q.addressValue()&3) == 0 && (q.addressValue()+28 <= 0x60000000 || q.addressValue() >= 0x60100000)
trusted fun c6I2sDmaCompletionPollOwned(r: NativeBuffer,q: NativeBuffer,budget: int,exclusive: bool): int {
    if (!exclusive || budget < 1 || budget > 1024 || !c6I2sDmaStartStorage(r) || r.loadU32(0) != 0x43364944 || r.loadU32(16) > 1 ||
        (r.loadU32(4) != 1 && r.loadU32(4) != 6 && r.loadU32(4) != 7) || r.loadU32(40) != 0 || !c6I2sDmaCompletionStorage(q)) return 2
    val count=r.loadU32(24);val descriptors=r.loadU32(20);val buffers=r.loadU32(28);val stride=r.loadU32(32);val bytes=r.loadU32(36)
    if (!c6GdmaRingValid(descriptors,count,buffers,stride,bytes)) return 2
    val address=q.addressValue()
    if ((address < r.addressValue()+72 && r.addressValue() < address+28) ||
        (address < descriptors+count*12 && descriptors < address+28) ||
        (address < buffers+(count-1)*stride+bytes && buffers < address+28)) return 2
    if (q.loadU32(0) == 0) {
        q.storeU32(0,0x43364943);q.storeU32(4,5);q.storeU32(8,r.addressValue());q.storeU32(12,0);q.storeU32(16,0);q.storeU32(20,0);q.storeU32(24,0)
    } else if (q.loadU32(0) != 0x43364943 || q.loadU32(8) != r.addressValue()) return 2
    if (q.loadU32(4) == 1) return 1
    if (q.loadU32(4) == 3) return 3
    if (q.loadU32(4) != 5 || q.loadU32(12) > count) return 2
    var remaining=budget
    while (remaining > 0 && q.loadU32(12) < count) {
        val acquired=c6GdmaAcquireOwned(r.loadU32(12),r.loadU32(16) != 0,descriptors,count,buffers,stride,bytes,q.loadU32(12),false,true)
        q.storeU32(20,q.loadU32(20)|acquired.events());q.storeU32(24,acquired.status())
        if (acquired.status() == 5) return 5
        if (acquired.status() != 1) { q.storeU32(4,3);return 3 }
        q.storeU32(16,q.loadU32(16)+acquired.bytes());q.storeU32(12,q.loadU32(12)+1)
        remaining=remaining-1
    }
    if (q.loadU32(12) == count) { q.storeU32(4,1);return 1 }
    return 5
}
