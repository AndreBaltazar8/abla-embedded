import "./clock_session_c6_sequence.ab"
import "./dma_config_c6_sequence.ab"
import "./pin_session_c6_sequence.ab"
import "../gdma_clock_c6_sequence.ab"
//172B retained:tag0,state4,primary8,cleanup12,packedpins16,mode20,
// clock32@24,DMAclock56,config64@60,pins48@124. State1pending2ready4partial
// 5closing6closed. Returns1ready2invalid4partial5pending6closed.
// Whole I2S/GDMA/codec/ETM/IRQ/pads exclusive lifetime. Root source already
// selected/stable, GPIO clocks pinned, FIFOs/controller initialized. No reset,
// discard or transfer start. Close only after transfer stop/event handling.
// TX master stereo only. BCLK=WS=-1 omits clock pads for data-only speakers;
// source3 requires an external MCLK input. No sample-rate/codec setup implied.
fun c6AudioSetupStorage(r: NativeBuffer): bool = r.hasAddressRange(0,172) && (r.addressValue()&3) == 0 && (r.addressValue()+172 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun c6AudioSetupWaitOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6AudioSetupStorage(r) || r.loadU32(0) != 0x43364155 || r.loadU32(4) != 1 || polls < 1 || polls > 1000000) return 2
    val config=nativeBufferAt(r.addressValue()+60,64)
    if (config.loadU32(4) == 5) {
        val result=c6I2sDmaConfigWaitOwned(config,polls,true)
        if (result == 5) return 5
        if (result != 1) { r.storeU32(8,0x30000|result);r.storeU32(4,4);return 4 }
    }
    if (config.loadU32(4) != 1) return 4
    r.storeU32(4,4)
    val pins=r.loadU32(16);val mode=r.loadU32(20)
    val result=c6I2sPinSessionOpenOwned(nativeBufferAt(r.addressValue()+124,48),(mode&1) != 0,(mode&4) != 0,if ((pins&31) == 31) -1 else pins&31,if (((pins>>>5)&31) == 31) -1 else (pins>>>5)&31,(pins>>>10)&31,if (((pins>>>15)&31) == 31) -1 else (pins>>>15)&31,(mode&2) != 0,true)
    if (result != 1) { r.storeU32(8,0x40000|result);return 4 }
    r.storeU32(4,2);return 1
}
trusted fun c6AudioSetupOpenOwned(r: NativeBuffer,channel: int,source: int,integer: int,numerator: int,denominator: int,bclkDivider: int,bclk: int,ws: int,data: int,mclk: int,dataBits: int,slotBits: int,wsWidth: int,shift: bool,polls: int,exclusive: bool): int {
    if (!exclusive || !c6AudioSetupStorage(r) || r.loadU32(0) != 0 || channel < 0 || channel > 2 || source < 0 || source > 3 || integer < 2 || integer > 255 || denominator < 1 || denominator > 511 || numerator < 0 || numerator >= denominator || bclkDivider < 1 || bclkDivider > 64 || polls < 1 || polls > 1000000 ||
        c6I2sStereoFrameWord(dataBits,slotBits,wsWidth,shift) < 0 ||
        (!esp32C6GpioNumberValid(bclk) && bclk != -1) || (!esp32C6GpioNumberValid(ws) && ws != -1) || ((bclk < 0) != (ws < 0)) || !esp32C6GpioNumberValid(data) || mclk < -1 || mclk > 30 || (source == 3 && mclk < 0) ||
        (bclk >= 0 && bclk == ws) || bclk == data || ws == data || (mclk >= 0 && (mclk == bclk || mclk == ws || mclk == data))) return 2
    var at=0
    while (at < 172) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x43364155);r.storeU32(4,4)
    r.storeU32(16,(bclk&31)|((ws&31)<<5)|(data<<10)|((mclk&31)<<15));r.storeU32(20,1|(if (source == 3) 2 else 0))
    val clock=c6I2sClockSessionOpenOwned(nativeBufferAt(r.addressValue()+24,32),true,source,integer,numerator,denominator,bclkDivider,true)
    if (clock != 1) { r.storeU32(8,0x10000|clock);return 4 }
    val dma=c6GdmaClockOpenOwned(true);r.storeU32(56,dma|0)
    if (dma.status() != 1) { r.storeU32(8,0x20000|dma.status());return 4 }
    val config=c6I2sDmaConfigOpenOwned(nativeBufferAt(r.addressValue()+60,64),channel,dataBits,slotBits,wsWidth,shift,polls,true)
    if (config != 1 && config != 5) { r.storeU32(8,0x30000|config);return 4 }
    r.storeU32(4,1)
    if (config == 5) return 5
    return c6AudioSetupWaitOwned(r,polls,true)
}
trusted fun c6AudioSetupCloseOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6AudioSetupStorage(r) || r.loadU32(0) != 0x43364155 || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 6) return 6
    r.storeU32(4,5)
    // Reject active DMA before touching pins or format.
    val config=nativeBufferAt(r.addressValue()+60,64)
    val token=config.loadU32(12)|(config.loadU32(16)<<32)
    if (config.loadU32(4) != 6 && (token&(1<<49)) != 0 && (!c6GdmaClocksReady() || !c6GdmaTxParked((token>>>47)&3))) { r.storeU32(12,0x30003);return 4 }
    val pins=nativeBufferAt(r.addressValue()+124,48)
    if (pins.loadU32(0) != 0) {
        val result=c6I2sPinSessionCloseOwned(pins,true)
        if (result != 6) { r.storeU32(12,0x40000|result);return 4 }
    }
    if (config.loadU32(0) != 0) {
        val result=c6I2sDmaConfigCloseOwned(config,polls,true)
        if (result != 6) { r.storeU32(12,0x30000|result);return if (result == 5) 5 else 4 }
    }
    var dma=C6GdmaClock(r.loadU32(56))
    if ((dma&1024) != 0) {
        dma=dma.closeOwned(true);r.storeU32(56,dma|0)
        if (dma.status() != 7) { r.storeU32(12,0x20000|dma.status());return 4 }
    }
    val clock=nativeBufferAt(r.addressValue()+24,32)
    if (clock.loadU32(0) != 0) {
        val result=c6I2sClockSessionCloseOwned(clock,true)
        if (result != 6) { r.storeU32(12,0x10000|result);return 4 }
    }
    r.storeU32(4,6);r.storeU32(12,0);return 6
}
