import "./clock_c5_sequence.ab"
// Reversible C5 I2S source mux selection, not PLL/X­TAL power management.
//0XTAL1PLL2402PLL1603externalMCLK. Caller pins the selected root frequency,
// owns both directions/GDMA/ETM/IRQ/MCLK users and keeps codec pads safe.
// Selected direction gate MUST be off; setup borrows this lease's bus gate.
// Close only AFTER audio/setup closure has disabled the direction gate.
// Scalar:status8,oldsource2@8,TX10,ownedbus11,valid12,sourcewriteattempt13.
//1selected2invalid3reset4buswrite5readytimeout6busy7sourcewrite8restored.
type C5I2sSource=int
fun C5I2sSource.status(): int = this&255
trusted fun c5I2sSourceOpenOwned(tx: bool,source: int,polls: int,exclusive: bool): C5I2sSource {
    if (!exclusive || source < 0 || source > 3 || polls < 1 || polls > 1000000) return C5I2sSource(2)
    val bus=c5I2sClockRead(0);val at=if (tx) 4 else 12
    val before=c5I2sClockRead(at)
    if ((bus&u32(2)) != u32(0)) return C5I2sSource(3)
    if ((before&u32(0x400000)) != u32(0)) return C5I2sSource(6)
    var token=4096|(int((before>>u32(20))&u32(3))<<8)|(if (tx) 1024 else 0)
    if ((bus&u32(1)) == u32(0)) {
        token=token|2048
        if (!c5I2sClockField(0,u32(1),u32(1))) return C5I2sSource(token|4)
    }
    var left=polls
    while (left > 0 && (c5I2sClockRead(0)&u32(12)) != u32(12)) left=left-1
    if (left == 0) return C5I2sSource(token|5)
    if (!c5I2sStopped()) return C5I2sSource(token|6)
    if (int((before>>u32(20))&u32(3)) != source) {
        token=token|8192
        if (!c5I2sClockField(at,u32(0x300000),u32(source)<<u32(20))) return C5I2sSource(token|7)
    }
    return C5I2sSource(token|1)
}
trusted fun C5I2sSource.closeOwned(exclusive: bool): C5I2sSource {
    if (!exclusive || this < 0 || (this&~16383) != 0 || (this&4096) == 0 || this.status() == 8) return this
    var token=this&~255
    val bus=c5I2sClockRead(0);val at=if ((this&1024) != 0) 4 else 12
    if ((bus&u32(2)) != u32(0) || (c5I2sClockRead(at)&u32(0x400000)) != u32(0)) return C5I2sSource(token|6)
    if ((token&8192) != 0) {
        if ((bus&u32(13)) != u32(13) || !c5I2sStopped()) return C5I2sSource(token|6)
        if (!c5I2sClockField(at,u32(0x300000),u32((token>>>8)&3)<<u32(20))) return C5I2sSource(token|7)
        token=token&~8192
    }
    if ((token&2048) != 0) {
        if ((bus&u32(13)) == u32(13) && !c5I2sStopped()) return C5I2sSource(token|6)
        if (!c5I2sClockField(0,u32(1),u32(0))) return C5I2sSource(token|4)
        token=token&~2048
    }
    return C5I2sSource(token|8)
}
