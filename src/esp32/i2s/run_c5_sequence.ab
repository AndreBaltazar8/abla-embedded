import "./update_c5_sequence.ab"
// Caller owns both directions, stable clocks, configured pads/codec and DMA.
// FIFO initialization and DMA descriptor publication must precede start.
// Start consumes a completed configuration-update snapshot, with no second
// UPDATE publication. Do not mutate configuration between update and start.
// Returns 1 started/stopped, 2 invalid, 3 clock, 4 busy/config changed,
// 5 write failed, 6 TX drain pending. RX has no hardware idle indication:
// cleared START is not proof that DMA has stopped; join DMA separately.
trusted fun c5I2sStartUpdatedOwned(update: C5I2sUpdate,exclusive: bool): int {
    if (!exclusive || update < 0 || (update&~0xffffffff03ff) != 0 || (update&512) == 0 || !update.complete()) return 2
    val tx=(update&256) != 0
    if (!c5I2sUpdateClocks(tx)) return 3
    if (!c5I2sStopped() || !update.waitOwned(1,true).complete()) return 4
    val at=if (tx) 0x24 else 0x20
    val expected=u32(update>>>16)
    c5I2sWrite(at,expected|u32(4))
    return if (c5I2sRead(at) == (expected|u32(4))) 1 else 5
}
// Idempotent stop requests never reset or discard the FIFO. TX waits for
// TX_IDLE; callers retain all resources on timeout or failed readback.
trusted fun c5I2sStopOwned(port: int,tx: bool,polls: int,exclusive: bool): int {
    if (!exclusive || port != 0 || polls < 1 || polls > 1000000) return 2
    if (!c5I2sUpdateClocks(tx)) return 3
    val at=if (tx) 0x24 else 0x20
    val before=c5I2sRead(at)
    if ((before&u32(0x103)) != u32(0)) return 4
    val stopped=before&~u32(4)
    if (before != stopped) c5I2sWrite(at,stopped)
    if (c5I2sRead(at) != stopped) return 5
    if (!tx) return 1
    var left=polls
    while (left > 0) {
        if ((c5I2sRead(0x6c)&u32(1)) != u32(0)) return 1
        left=left-1
    }
    return 6
}
