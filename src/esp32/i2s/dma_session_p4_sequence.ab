import "../sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Retained64B aligned cache-line-owned record, outside all DMA storage.
// magic0,state4,channel8,TX12,port16,desc20,count24,payload28,stride32,
// bytes36,cursor40,cachePolls44,lastResult48/52,mayDMA56,mayI2S60.
// State1 attached,2 running,3 recovery required,4 engines stopped/cache idle.
// Caller owns both I2S directions/clocks/pads/codec, selected DMA+cache engine.
// Attach requires configured I2S/pins/codec and prepared, published circular ring.
// It does not initialize hardware or establish those preconditions by itself.
trusted fun esp32p4I2sDmaSessionValid(r: NativeBuffer): bool =
    r.hasAddressRange(0,64) && (r.addressValue()&63) == 0 && r.loadU32(0) == 0x50345331
trusted fun esp32p4I2sDmaSessionAttachOwned(r: NativeBuffer,channel: int,transmit: bool,
    port: int,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,exclusive: bool): int {
    if (!exclusive || channel < 0 || channel > 2 || port < 0 || port > 2 || polls < 1 || polls > 1000000 ||
        !r.hasAddressRange(0,64) || (r.addressValue()&63) != 0 || count < 2 || (bytes & 3) != 0 ||
        !esp32p4AhbGdmaRingLayoutValid(descriptors,count,buffers,stride,bytes)) return 0
    val a=r.addressValue()
    if ((a < descriptors+count*64 && a+64 > descriptors) || (a < buffers+count*stride && a+64 > buffers)) return 0
    if (r.loadU32(0) != 0 && (!esp32p4I2sDmaSessionValid(r) || r.loadU32(4) != 4)) return 0
    r.storeU32(0,0x50345331);r.storeU32(4,1);r.storeU32(8,channel);r.storeU32(12,if (transmit) 1 else 0)
    r.storeU32(16,port);r.storeU32(20,descriptors);r.storeU32(24,count);r.storeU32(28,buffers)
    r.storeU32(32,stride);r.storeU32(36,bytes);r.storeU32(40,0);r.storeU32(44,polls)
    r.storeU32(48,0);r.storeU32(52,0);r.storeU32(56,0);r.storeU32(60,0)
    return 1
}
trusted fun esp32p4I2sDmaSessionStartOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !esp32p4I2sDmaSessionValid(r) || r.loadU32(4) != 1) return 0
    r.storeU32(4,3);r.storeU32(56,1)
    val dma=p4I2sSessionDmaStart(r)
    r.storeU32(48,1 | (dma << 8));r.storeU32(52,0)
    if (dma != 1) return 3
    r.storeU32(60,1)
    val i2s=p4I2sSessionI2sStart(r)
    r.storeU32(48,2 | (i2s << 8))
    if (i2s != 1) return 3
    r.storeU32(4,2)
    return 2
}
// Returns session state. Full pump report remains at48/52. Busy or invalid
// CPU argument does not consume a block; all actual acquire/rearm failures
// make state3 sticky. The same block cannot be accidentally copied twice.
trusted fun esp32p4I2sDmaSessionPumpOwned(r: NativeBuffer,cpu: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !esp32p4I2sDmaSessionValid(r) || r.loadU32(4) != 2) return 0
    val bytes=r.loadU32(36)
    if (!cpu.hasAddressRange(0,bytes) || (cpu.addressValue() < r.addressValue()+64 && cpu.addressValue()+bytes > r.addressValue())) return 0
    val result=p4I2sSessionPump(r,cpu)
    r.storeU32(48,result & 0xffffffff);r.storeU32(52,(result >>> 32)&0xffffffff)
    val status=result & 255
    if (status == 1) {
        val next=r.loadU32(40)+1
        r.storeU32(40,if (next == r.loadU32(24)) 0 else next)
    } else if (status != 2 && status != 3) { r.storeU32(4,3);return 3 }
    return 2
}
// Stop I2S then park DMA, then verify cache engine idle. Retry retains exact
// unfinished flags, original failure report and all resources. Clock/pad/codec
// ownership is NOT released, codec is NOT muted; board lifecycle must handle it.
// Tab5 codec shutdown needs live clocks BEFORE this call. Status4 only permits
// controlled rebuild/recovery of owned DMA storage, not a final-audio guarantee.
trusted fun esp32p4I2sDmaSessionStopOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !esp32p4I2sDmaSessionValid(r) || r.loadU32(4) < 1 || r.loadU32(4) > 4) return 0
    if (r.loadU32(4) == 4) return 4
    r.storeU32(4,3)
    if (r.loadU32(60) != 0) {
        if (p4I2sSessionI2sStop(r) != 1) return 3
        r.storeU32(60,0)
    }
    if (r.loadU32(56) != 0) {
        if (p4I2sSessionDmaStop(r) != 1) return 3
        r.storeU32(56,0)
    }
    if (!p4I2sSessionCacheIdle()) return 3
    p4I2sSessionStoppedFence()
    r.storeU32(4,4)
    return 4
}
