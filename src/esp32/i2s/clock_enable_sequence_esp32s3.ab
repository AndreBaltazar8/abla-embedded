// Caller holds the canonical RCC lock and owns the I2S port. No reset pulse
// or implicit clock disable: preserve an already configured peripheral.
trusted fun esp32s3I2sEnableClockLocked(port: int): bool {
    if (port < 0 || port > 1) return false
    val mask = if (port == 0) 16 else 2097152
    esp32s3I2sClockField(0x600c0018, mask, mask)
    esp32s3I2sClockField(0x600c0020, mask, 0)
    esp32s3I2sClockField(0x6000f034 + port * 0x1e000, 1 << 29, 1 << 29)
    true
}

// Source/divider must already be configured and stable. Caller owns BOTH
// stopped directions because the external MCLK source is shared. This only
// selects its direction and enables that clock, not I2S/DMA data movement.
trusted fun esp32s3I2sActivateClock(port: int, transmit: bool): bool {
    if (port < 0 || port > 1) return false
    val base = 0x6000f000 + port * 0x1e000
    if (((esp32s3I2sClockRead(base + 32) | esp32s3I2sClockRead(base + 36)) & 260) != 0) return false
    esp32s3I2sClockField(base + 48, 1 << 29, if (transmit) 0 else 1 << 29)
    esp32s3I2sClockField(base + (if (transmit) 52 else 48), 1 << 26, 1 << 26)
    true
}
