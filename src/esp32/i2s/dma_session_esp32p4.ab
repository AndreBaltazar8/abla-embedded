import "./dma_session_p4_sequence.ab"
import "./transfer_esp32p4.ab"
import "../ahb_gdma_start_esp32p4.ab"
import "../ahb_gdma_pump_esp32p4.ab"
trusted fun p4I2sSessionDmaStart(r: NativeBuffer): int = esp32p4AhbGdmaStartRingOwned(r.loadU32(8),r.loadU32(12) != 0,r.loadU32(16),r.loadU32(20),r.loadU32(24),r.loadU32(28),r.loadU32(32),r.loadU32(36),true)
trusted fun p4I2sSessionI2sStart(r: NativeBuffer): int = esp32p4I2sStartDirectionOwned(r.loadU32(16),r.loadU32(12) != 0,r.loadU32(44),true)
trusted fun p4I2sSessionI2sStop(r: NativeBuffer): int = esp32p4I2sStopDirectionOwned(r.loadU32(16),r.loadU32(12) != 0,true)
trusted fun p4I2sSessionDmaStop(r: NativeBuffer): int = esp32p4AhbGdmaStopOwned(r.loadU32(8),r.loadU32(12) != 0,r.loadU32(44),true)
trusted fun p4I2sSessionCacheIdle(): bool = (p4CacheSyncRead(152)&u32(15)) == u32(0)
trusted fun p4I2sSessionStoppedFence(): void = riscvDeviceMemoryFence()
trusted fun p4I2sSessionPump(r: NativeBuffer,cpu: NativeBuffer): int = esp32p4AhbGdmaPumpBlockOwned(r.loadU32(8),r.loadU32(12) != 0,r.loadU32(20),r.loadU32(24),r.loadU32(28),r.loadU32(32),r.loadU32(36),r.loadU32(40),cpu,r.loadU32(44),true)|0
