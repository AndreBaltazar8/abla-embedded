// Native master PDM RX preparation, I2S0. Caller owns BOTH stopped I2S0
// directions, parked RX GDMA channel, all active pads/global inputs and
// internal DMA storage; holds the chosen XTAL/PLL source at sourceHz.
// No duplex/slave assumption, allocation, reset of peers, or implicit START.
// On failure retain ownership; clocks/configuration may already be changed.
// Status1 prepared,2 invalid,3 GDMA clock,4 I2S clock,5 DMA busy,6 RX reset,
// 7 clock selection,8 fraction,9 PDM mode,10 EOF size,11 clock activation,
// 12 pins (routing detail above bit8),13 descriptor initialization.
type Esp32S3PdmDmaPreparation=int
fun Esp32S3PdmDmaPreparation.status(): int = this&255
fun Esp32S3PdmDmaPreparation.valid(): bool = this.status() == 1
fun Esp32S3PdmDmaPreparation.sampleRate(): int = if (this.valid()) this>>>8 else 0
trusted fun esp32s3PreparePdmReceiveDma(pins: PdmPins,slots: int,pcm: bool,downsample128: bool,
    invertClock: bool,rate: int,source: int,sourceHz: int,bitDivider: int,channel: int,
    descriptors: int,count: int,buffers: int,blockBytes: int,owner: u32): Esp32S3PdmDmaPreparation {
    if (source < 0 || source > 2 || channel < 0 || channel > 4 || owner == u32(0) || count < 2 ||
        (blockBytes&3) != 0 || !esp32s3PdmPinsValid(0,pins,slots,false) ||
        !esp32s3GdmaRingLayoutValid(descriptors,count,buffers,blockBytes,blockBytes)) return Esp32S3PdmDmaPreparation(2)
    var bits=slots;var channels=0
    while (bits != 0) { channels=channels+(bits&1);bits=bits>>>1 }
    if (u32(blockBytes)%u32(channels*2) != u32(0)) return Esp32S3PdmDmaPreparation(2)
    val clock=esp32s3PdmReceiveClock(sourceHz,rate,slots,pcm,downsample128,bitDivider)
    if (!clock.valid()) return Esp32S3PdmDmaPreparation(2)
    val divider=esp32s3I2sChooseDivider(sourceHz,clock.masterClockHz())
    if (!divider.valid()) return Esp32S3PdmDmaPreparation(2)
    if (!esp32s3GdmaEnableClock(owner)) return Esp32S3PdmDmaPreparation(3)
    if (!esp32s3I2sEnableClock(0,owner)) return Esp32S3PdmDmaPreparation(4)
    if (!esp32s3GdmaParked(channel,false)) return Esp32S3PdmDmaPreparation(5)
    if (!esp32s3I2sResetDirection(0,false)) return Esp32S3PdmDmaPreparation(6)
    if (!esp32s3I2sSelectClock(0,false,source,clock.bitClockDivider())) return Esp32S3PdmDmaPreparation(7)
    if (!esp32s3I2sSetDivider(0,false,divider.integer(),divider.numerator(),divider.denominator())) return Esp32S3PdmDmaPreparation(8)
    if (!esp32s3I2sSetPdmReceiveMode(0,slots,pcm,downsample128,false)) return Esp32S3PdmDmaPreparation(9)
    if (!esp32s3I2sSetReceiveBlockBytes(0,blockBytes)) return Esp32S3PdmDmaPreparation(10)
    if (!esp32s3I2sActivateClock(0,false)) return Esp32S3PdmDmaPreparation(11)
    val routed=esp32s3PdmRoutePinsOwned(0,pins,slots,false,invertClock)
    if (routed != 1) return Esp32S3PdmDmaPreparation(12|(routed<<8))
    if (!esp32s3GdmaInitializeRingOwned(descriptors,count,buffers,blockBytes,blockBytes,false)) return Esp32S3PdmDmaPreparation(13)
    val denominator=u32(clock.bitClockDivider()*(if (pcm) (if (downsample128) 128 else 64) else 2))
    val actual=(u32(divider.frequency(sourceHz))+denominator/u32(2))/denominator
    return Esp32S3PdmDmaPreparation(1|(int(actual)<<8))
}
