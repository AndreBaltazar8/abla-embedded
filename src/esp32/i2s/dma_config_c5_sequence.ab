import "./standard_session_c5_sequence.ab"
import "./rx_eof_c5_sequence.ab"
import "../ahb_gdma_channel_c5_sequence.ab"
// 68B retained RAM:tag0,state4,primary8,DMAlease64@12,RXEOF20,standard44@24.
// States1ready4partial5pending6closed7closing; returns1ready2invalid3admission
// 4partial5pending6closed. Closing cannot be resumed as startup.
// Own stopped I2S/codec/GDMA/ETM/IRQ and pinned clocks/pads. DMA controller
// and FIFOs must be initialized. Uses single-word bursts, owner checking,
// TX auto writeback and EOF-after-pop; byte count is one DMA buffer.
// Transfer/event handling must finish before close; it never resets/discards.
fun c5I2sDmaConfigStorage(r: NativeBuffer): bool = r.hasAddressRange(0,68) && (r.addressValue()&3) == 0 && (r.addressValue()+68 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun c5I2sDmaConfigSave(r: NativeBuffer,dma: C5AhbGdmaChannel): void { r.storeU32(12,dma|0);r.storeU32(16,dma>>>32);return }
trusted fun c5I2sDmaConfigOpenOwned(r: NativeBuffer,channel: int,tx: bool,dataBits: int,slotBits: int,wsWidth: int,shift: bool,slots: int,flags: int,bytes: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c5I2sDmaConfigStorage(r) || r.loadU32(0) != 0 || channel < 0 || channel > 2 || bytes < 4 || bytes > 4092 || (bytes&3) != 0 ||
        polls < 1 || polls > 1000000 || c5I2sFrameWidthWord(dataBits,slotBits,wsWidth) < 0 || c5I2sStandardConfigWord(tx,slots,flags) < 0) return 2
    if (!c5I2sUpdateClocks(tx) || !c5I2sStopped() || !c5AhbGdmaChannelClocks() || !c5AhbGdmaChannelParked(channel,tx)) return 3
    var at=0
    while (at < 68) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x4335494f);r.storeU32(4,4)
    val dma=c5AhbGdmaChannelOpenOwned(channel,tx,3,4,if (tx) 6 else 0,true)
    c5I2sDmaConfigSave(r,dma)
    if (dma.status() != 1) { r.storeU32(8,0x10000|dma.status());return 4 }
    if (!tx) {
        val eof=c5I2sRxEofOpenOwned(0,bytes,true)
        r.storeU32(20,eof|0)
        if (eof.status() != 1) { r.storeU32(8,0x20000|eof.status());return 4 }
    }
    val result=c5I2sStandardOpenOwned(nativeBufferAt(r.addressValue()+24,44),0,tx,dataBits,slotBits,wsWidth,shift,slots,flags,polls,true)
    if (result == 4) { r.storeU32(4,5);return 5 }
    if (result != 1) { r.storeU32(8,0x30000|result);return 4 }
    r.storeU32(4,1);return 1
}
trusted fun c5I2sDmaConfigWaitOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c5I2sDmaConfigStorage(r) || r.loadU32(0) != 0x4335494f || r.loadU32(4) != 5 || r.loadU32(28) == 4) return 2
    val result=c5I2sStandardWaitOwned(nativeBufferAt(r.addressValue()+24,44),polls,true)
    if (result == 4) return 5
    if (result != 1) { r.storeU32(8,0x30000|result);r.storeU32(4,4);return 4 }
    r.storeU32(4,1);return 1
}
trusted fun c5I2sDmaConfigCloseOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c5I2sDmaConfigStorage(r) || r.loadU32(0) != 0x4335494f || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 6) return 6
    r.storeU32(4,7)
    var dma=C5AhbGdmaChannel(r.loadU32(12)|(r.loadU32(16)<<32))
    // Do not restore I2S or trigger routing while DMA can still use either.
    if ((dma&(1<<50)) != 0 && (!c5AhbGdmaChannelClocks() || !c5AhbGdmaChannelParked((dma>>>47)&3,(dma&(1<<49)) != 0))) return 3
    val standard=nativeBufferAt(r.addressValue()+24,44)
    if (standard.loadU32(0) != 0) {
        val result=c5I2sStandardCloseOwned(standard,polls,true)
        if (result != 5) return if (result == 4) 5 else 4
    }
    var eof=C5I2sRxEof(r.loadU32(20))
    if ((eof&(1<<24)) != 0) {
        eof=eof.closeOwned(true);r.storeU32(20,eof|0)
        if (eof.status() != 6) return 4
    }
    if ((dma&(1<<50)) != 0) {
        dma=dma.closeOwned(true);c5I2sDmaConfigSave(r,dma)
        if (dma.status() != 6) return 4
    }
    r.storeU32(4,6);return 6
}
