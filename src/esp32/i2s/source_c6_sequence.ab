import "./clock_c6_sequence.ab"
// Retained source-mux lease, NOT a PLL/XTAL oscillator initializer. Caller pins
// old and requested roots and owns both I2S directions/GDMA/MCLK consumers.
// Source0XTAL/1PLL240/2PLL160/3external. Switch only with function gate OFF,
// both directions stopped. Borrows unchanged source even if its gate is ON.
// Scalar:status8,ownedAPB8,oldsource2@9,newsource2@11,valid13,TX14,
// outstanding-source-restore15. Restore after child clock leases close.
// Status1ready2invalid3reset4APBwrite5busy6sourcewrite7closed8closefail9changed.
type C6I2sSource=int
fun C6I2sSource.status(): int = this&255
trusted fun c6I2sSourceOpenOwned(tx: bool,source: int,exclusivePinnedRoots: bool): C6I2sSource {
    if (!exclusivePinnedRoots || source < 0 || source > 3) return C6I2sSource(2)
    val bus=c6I2sClockRead(0)
    if ((bus&u32(2)) != u32(0)) return C6I2sSource(3)
    val at=if (tx) 4 else 12
    val clock=c6I2sClockRead(at);val old=int((clock>>u32(20))&u32(3))
    if (old != source && (clock&u32(0x400000)) != u32(0)) return C6I2sSource(5)
    var token=8192|(old<<9)|(source<<11)|(if (tx) 16384 else 0)
    if ((bus&u32(1)) == u32(0)) {
        token=token|256
        if (!c6I2sClockField(0,u32(1),u32(1))) return C6I2sSource(token|4)
    }
    if (!c6I2sStopped()) return C6I2sSource(token|5)
    if (old != source) {
        token=token|32768
        if (!c6I2sClockField(at,u32(0x300000),u32(source)<<u32(20))) return C6I2sSource(token|6)
    }
    return C6I2sSource(token|1)
}
trusted fun C6I2sSource.closeOwned(exclusiveChildrenClosed: bool): C6I2sSource {
    if (!exclusiveChildrenClosed || this < 0 || (this&~65535) != 0 || (this&8192) == 0 || this.status() < 1 || this.status() > 9) return this
    var token=this&~255
    if ((token&33024) == 0) return C6I2sSource(7)
    val bus=c6I2sClockRead(0)
    if ((bus&u32(2)) != u32(0)) return C6I2sSource(token|8)
    if ((bus&u32(1)) == u32(0)) {
        if (this.status() == 4 && (token&32768) == 0) return C6I2sSource(7)
        return C6I2sSource(token|8)
    }
    if (!c6I2sStopped()) return C6I2sSource(token|8)
    if ((token&32768) != 0) {
        val at=if ((token&16384) != 0) 4 else 12
        val clock=c6I2sClockRead(at);val current=int((clock>>u32(20))&u32(3))
        val original=(token>>>9)&3;val requested=(token>>>11)&3
        if ((clock&u32(0x400000)) != u32(0)) return C6I2sSource(token|8)
        // Readback may already equal old after a dropped opening/restoring write.
        if (current != original && current != requested) return C6I2sSource(token|9)
        if (!c6I2sClockField(at,u32(0x300000),u32(original)<<u32(20))) return C6I2sSource(token|8)
        token=token&~32768
    }
    if ((token&256) != 0 && !c6I2sClockField(0,u32(1),u32(0))) return C6I2sSource(token|8)
    return C6I2sSource(7)
}
