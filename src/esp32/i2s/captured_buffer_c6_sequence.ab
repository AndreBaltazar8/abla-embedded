import "./dma_completion_c6_sequence.ab"
// Checked view of one descriptor's actual received length (not its capacity).
// Requires complete finite acquisition AND stopped/parked transfer, then checks
// metadata/events again before exposing SRAM. Zero-length captures return an
// addressed zero-capacity buffer, invalid/error returns NativeBuffer(0).
// Caller retains all memory/exclusive IRQ+DMA ownership, forbids rearm/restart
// until all views/consumers have joined. No ack/reset/free or payload mutation.
trusted fun c6I2sCapturedBufferOwned(r: NativeBuffer,q: NativeBuffer,index: int,exclusive: bool): NativeBuffer {
    if (!exclusive || !c6I2sDmaStartStorage(r) || !c6I2sDmaCompletionStorage(q) || r.loadU32(0) != 0x43364944 || r.loadU32(16) != 0 ||
        r.loadU32(4) != 7 || r.loadU32(40) != 0 || q.loadU32(0) != 0x43364943 || q.loadU32(4) != 1 || q.loadU32(8) != r.addressValue() ||
        q.loadU32(12) != r.loadU32(24) || index < 0 || index >= r.loadU32(24)) return NativeBuffer(0)
    val desc=r.loadU32(20);val count=r.loadU32(24);val buffers=r.loadU32(28);val stride=r.loadU32(32);val bytes=r.loadU32(36);val address=q.addressValue()
    if (!c6GdmaRingValid(desc,count,buffers,stride,bytes) || (address < r.addressValue()+72 && r.addressValue() < address+28) ||
        (address < desc+count*12 && desc < address+28) || (address < buffers+(count-1)*stride+bytes && buffers < address+28)) return NativeBuffer(0)
    val channel=r.loadU32(12)
    if (!c6I2sUpdateClocks(false) || !c6I2sStopped() || !c6GdmaClocksReady() || channel > 2 ||
        (c6GdmaRead(0x80+channel*192)&u32(0x1e00000)) != u32(0x1000000) || (c6GdmaRead(0x78+channel*192)&u32(2)) == u32(0)) return NativeBuffer(0)
    val acquired=c6GdmaAcquireOwned(channel,false,desc,count,buffers,stride,bytes,index,false,true)
    if (acquired.status() != 1) return NativeBuffer(0)
    return nativeBufferAt(buffers+index*stride,acquired.bytes())
}
