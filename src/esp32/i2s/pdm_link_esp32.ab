import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkI2sPdmOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredI2sChannelInitPdmTxMode", "i2s_channel_init_pdm_tx_mode")) return false
    if (!internalFunction("esp32RecoveredI2sChannelReconfigPdmTxClock", "i2s_channel_reconfig_pdm_tx_clock")) return false
    if (!internalFunction("esp32RecoveredI2sChannelReconfigPdmTxSlot", "i2s_channel_reconfig_pdm_tx_slot")) return false
    if (!internalFunction("esp32RecoveredI2sChannelReconfigPdmTxGpio", "i2s_channel_reconfig_pdm_tx_gpio")) return false
    if (!internalFunction("esp32I2sInitializePdmReceiveMode", "i2s_channel_init_pdm_rx_mode")) return false
    if (!internalFunction("esp32RecoveredI2sChannelReconfigPdmRxClock", "i2s_channel_reconfig_pdm_rx_clock")) return false
    if (!internalFunction("esp32RecoveredI2sChannelReconfigPdmRxSlot", "i2s_channel_reconfig_pdm_rx_slot")) return false
    if (!internalFunction("esp32RecoveredI2sChannelReconfigPdmRxGpio", "i2s_channel_reconfig_pdm_rx_gpio")) return false
    true
}
