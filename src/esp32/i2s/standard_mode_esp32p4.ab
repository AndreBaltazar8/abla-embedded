import "./standard_mode_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2s.ab"
@export("p4I2sModeRead")
trusted fun p4I2sModeReadHook(address: int): int = mmioLoadU32(address)
@export("p4I2sModeWrite")
trusted fun p4I2sModeWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
