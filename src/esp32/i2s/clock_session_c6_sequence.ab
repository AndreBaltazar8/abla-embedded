import "./divider_owner_c6_sequence.ab"
import "./clock_route_c6_sequence.ab"
import "../sdk/raw_buffer.ab"
// 32B retained RAM:tag0,state4,primary8,clock12,divider64@16,route24,cleanup28.
// Sources preselected/pinned by caller; shared MCLK/codec/pads/GDMA/ETM/IRQs
// relinquished, both directions stopped. Acquire selected direction's clock,
// divider then BCLK/MCLK route; restore reverse before owned gates go off.
// No PLL/source/reset/update/start. State1ready4partial5closing6closed.
// Returns1ready2invalid4partial6closed; nested primary and cleanup preserved.
fun c6I2sClockSessionStorage(r: NativeBuffer): bool = r.hasAddressRange(0,32) && (r.addressValue()&3) == 0 && (r.addressValue()+32 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun c6I2sClockSessionDividerSave(r: NativeBuffer,divider: C6I2sDividerOwner): void { r.storeU32(16,divider|0);r.storeU32(20,divider>>>32);return }
trusted fun c6I2sClockSessionOpenOwned(r: NativeBuffer,tx: bool,source: int,integer: int,numerator: int,denominator: int,bclk: int,exclusive: bool): int {
    if (!exclusive || !c6I2sClockSessionStorage(r) || r.loadU32(0) != 0 || source < 0 || source > 3 || integer < 2 || integer > 255 || numerator < 0 || denominator < 1 || denominator > 511 || numerator >= denominator || bclk < 1 || bclk > 64) return 2
    var at=0
    while (at < 32) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x4336494b);r.storeU32(4,4)
    val clock=c6I2sClockOpenOwned(0,if (tx) 1 else 2,source,source,true)
    r.storeU32(12,clock|0)
    if (!clock.ready()) { r.storeU32(8,0x10000|clock.status());return 4 }
    val divider=c6I2sDividerOpenOwned(0,tx,integer,numerator,denominator,true)
    c6I2sClockSessionDividerSave(r,divider)
    if (divider.status() != 1) { r.storeU32(8,0x20000|divider.status());return 4 }
    val route=c6I2sClockRouteOpenOwned(0,tx,bclk,true)
    r.storeU32(24,route|0)
    if (!route.ready()) { r.storeU32(8,0x30000|route.status());return 4 }
    r.storeU32(4,1);return 1
}
trusted fun c6I2sClockSessionCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !c6I2sClockSessionStorage(r) || r.loadU32(0) != 0x4336494b) return 2
    if (r.loadU32(4) == 6) return 6
    if (r.loadU32(4) != 1 && r.loadU32(4) != 4 && r.loadU32(4) != 5) return 2
    r.storeU32(4,5)
    // Do not restore child dividers/routes against a changed source.
    if (!c6I2sSourcesMatch(r.loadU32(12))) { r.storeU32(28,0x10005);return 4 }
    var route=C6I2sClockRoute(r.loadU32(24))
    if ((route&65536) != 0) {
        route=route.closeOwned(true);r.storeU32(24,route|0)
        if (route.status() != 0) { r.storeU32(28,0x30000|route.status());return 4 }
    }
    var divider=C6I2sDividerOwner(r.loadU32(16)|(r.loadU32(20)<<32))
    if ((divider&(1<<45)) != 0 && divider.status() != 15) {
        divider=divider.closeOwned(true);c6I2sClockSessionDividerSave(r,divider)
        if (divider.status() != 15) { r.storeU32(28,0x20000|divider.status());return 4 }
    }
    var clock=C6I2sClock(r.loadU32(12))
    if ((clock&1792) != 0 || clock.ready()) {
        clock=clock.closeOwned(true);r.storeU32(12,clock|0)
        if (clock.status() != 0) { r.storeU32(28,0x10000|clock.status());return 4 }
    }
    r.storeU32(4,6);r.storeU32(28,0);return 6
}
