import "./stereo_microphone_dma_p4_sequence.ab"
import "./standard_config_esp32p4.ab"
import "./transfer_esp32p4.ab"
import "./pins_esp32p4.ab"
import "../ahb_gdma_control_esp32p4.ab"
import "../ahb_gdma_publish_esp32p4.ab"
import "../../hal/esp32_i2s.ab"
import "../../hal/esp32_i2s_2.ab"
import "../ahb_gdma_control_p4_sequence.ab"
import "./clock_control_p4_sequence.ab"
import "abla/unsafe/mmio"
import "./transfer_p4_sequence.ab"
import "./pins_p4_sequence.ab"
import "../ahb_gdma_ring_p4_sequence.ab"
import "../ahb_gdma_publish_p4_sequence.ab"
@export("p4StereoMicParked")
trusted fun p4StereoMicParkedHook(channel: int): int = esp32p4AhbGdmaParkedOwned(channel,false,true)
@export("p4StereoMicBus")
trusted fun p4StereoMicBusHook(): int = esp32p4I2sEnableBusOwned(0,true)
@export("p4StereoMicI2sStopped")
trusted fun p4StereoMicI2sStoppedHook(): bool = ((mmioLoadU32(0x500c6020)|mmioLoadU32(0x500c6024))&263) == 0
@export("p4StereoMicReset")
trusted fun p4StereoMicResetHook(): int = esp32p4I2sResetDirectionOwned(0,false,true)
@export("p4StereoMicDmaPrepare")
trusted fun p4StereoMicDmaPrepareHook(channel: int): int = esp32p4AhbGdmaPrepareI2sOwned(channel,false,0,true)
@export("p4StereoMicFormat")
trusted fun p4StereoMicFormatHook(revision: int): int = esp32p4I2sConfigureStandardOwned(0,false,0,revision,6,49,96,8,16,16,16,true,3,16,true)
@export("p4StereoMicEof")
trusted fun p4StereoMicEofHook(bytes: int): int = esp32p4I2sSetReceiveBlockBytesOwned(0,bytes,true)
@export("p4StereoMicPins")
trusted fun p4StereoMicPinsHook(mclk: int,bclk: int,ws: int,data: int): int = esp32p4I2sRoutePinsOwned(0,false,mclk,bclk,ws,data,0,true)
@export("p4StereoMicRing")
trusted fun p4StereoMicRingHook(descriptors: int,count: int,payload: int,stride: int,bytes: int): bool = esp32p4AhbGdmaBuildRingOwned(descriptors,count,payload,stride,bytes,false,true,true)
@export("p4StereoMicPublish")
trusted fun p4StereoMicPublishHook(descriptors: int,count: int,payload: int,stride: int,bytes: int,polls: int): int = esp32p4AhbGdmaPublishRingOwned(descriptors,count,payload,stride,bytes,polls,true)
