import "./stereo_microphone_dma_p4_sequence.ab"
import "./standard_config_esp32p4.ab"
import "./transfer_esp32p4.ab"
import "./pins_esp32p4.ab"
import "../ahb_gdma_control_esp32p4.ab"
import "../ahb_gdma_publish_esp32p4.ab"
trusted fun p4StereoMicParked(channel: int): int = esp32p4AhbGdmaParkedOwned(channel,false,true)
trusted fun p4StereoMicBus(): int = esp32p4I2sEnableBusOwned(0,true)
trusted fun p4StereoMicI2sStopped(): bool = ((mmioLoadU32(0x500c6020)|mmioLoadU32(0x500c6024))&263) == 0
trusted fun p4StereoMicReset(): int = esp32p4I2sResetDirectionOwned(0,false,true)
trusted fun p4StereoMicDmaPrepare(channel: int): int = esp32p4AhbGdmaPrepareI2sOwned(channel,false,0,true)
trusted fun p4StereoMicFormat(revision: int): int = esp32p4I2sConfigureStandardOwned(0,false,0,revision,6,49,96,8,16,16,16,true,3,16,true)
trusted fun p4StereoMicEof(bytes: int): int = esp32p4I2sSetReceiveBlockBytesOwned(0,bytes,true)
trusted fun p4StereoMicPins(mclk: int,bclk: int,ws: int,data: int): int = esp32p4I2sRoutePinsOwned(0,false,mclk,bclk,ws,data,0,true)
trusted fun p4StereoMicRing(descriptors: int,count: int,payload: int,stride: int,bytes: int): bool = esp32p4AhbGdmaBuildRingOwned(descriptors,count,payload,stride,bytes,false,true,true)
trusted fun p4StereoMicPublish(descriptors: int,count: int,payload: int,stride: int,bytes: int,polls: int): int = esp32p4AhbGdmaPublishRingOwned(descriptors,count,payload,stride,bytes,polls,true)
