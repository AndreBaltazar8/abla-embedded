import "./dma_start_c5_sequence.ab"
import "../ahb_gdma_control_c5_sequence.ab"
// Separate24B retained shutdown record:tag0,phase4,DMAstop8,error12,
// bound start-record address16,reserved20. Own same hardware/memory lifetime.
// Start-record state6closing7descriptor-FSM-stopped withdraws resume permission.
// Returns1I2S-stopped+DMA-parked,2invalid,4failure,5pending,8DMA-FIFO-not-empty.
// No reset/discard/IRQ ack/free/config restoration. Even result1 requires
// event handling and descriptor acquisition before resource release.
// Pending UPDATE is joined without advancing startup. STOP is issued once;
// subsequent calls wait. Primary startup error is never overwritten.
fun c5I2sDmaStopStorage(q: NativeBuffer): bool = q.hasAddressRange(0,24) && (q.addressValue()&3) == 0 && (q.addressValue()+24 <= 0x60000000 || q.addressValue() >= 0x60100000)
trusted fun c5I2sDmaStopOwned(r: NativeBuffer,q: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c5I2sDmaStartStorage(r) || r.loadU32(0) != 0x43354944 || !c5I2sDmaStopStorage(q) || polls < 1 || polls > 1000000 ||
        (q.addressValue() < r.addressValue()+72 && r.addressValue() < q.addressValue()+24)) return 2
    val address=q.addressValue()
    if ((address < r.loadU32(20)+r.loadU32(24)*12 && r.loadU32(20) < address+24) ||
        (address < r.loadU32(28)+(r.loadU32(24)-1)*r.loadU32(32)+r.loadU32(36) && r.loadU32(28) < address+24)) return 2
    if (q.loadU32(0) == 0) {
        if (r.loadU32(4) != 1 && r.loadU32(4) != 4 && r.loadU32(4) != 5) return 2
        q.storeU32(0,0x43354951);q.storeU32(4,1);q.storeU32(8,0);q.storeU32(12,0);q.storeU32(16,r.addressValue());q.storeU32(20,0)
        r.storeU32(4,6)
    } else if (q.loadU32(0) != 0x43354951 || q.loadU32(16) != r.addressValue() || (r.loadU32(4) != 6 && r.loadU32(4) != 7)) return 2
    if (q.loadU32(4) == 1) {
        val saved=C5I2sUpdate(r.loadU32(44)|(r.loadU32(48)<<32))
        if (r.loadU32(52) < 2 && (saved&512) != 0) {
            val update=saved.waitOwned(polls,true)
            r.storeU32(44,update|0);r.storeU32(48,update>>>32)
            if (!update.complete()) { q.storeU32(12,0x10000|update.status());return if (update.status() == 5) 5 else 4 }
        }
        q.storeU32(4,2)
    }
    val tx=r.loadU32(16) != 0
    if (q.loadU32(4) == 2) {
        val stopped=c5I2sStopOwned(0,tx,polls,true)
        if (stopped != 1) { q.storeU32(12,0x20000|stopped);return if (stopped == 6) 5 else 4 }
        q.storeU32(4,3)
    }
    if (q.loadU32(4) == 3 || q.loadU32(4) == 4) {
        val channel=r.loadU32(12)
        val saved=C5AhbGdmaStop(q.loadU32(8))
        val stopped=if ((saved&2048) != 0) saved.waitOwned(polls,true) else c5AhbGdmaStopBeginOwned(channel,tx,polls,true)
        q.storeU32(8,stopped|0)
        if (stopped.status() != 1) { q.storeU32(12,0x30000|stopped.status());return if (stopped.status() == 5) 5 else 4 }
        q.storeU32(4,4);r.storeU32(4,7)
        if ((c5AhbGdmaRead(c5AhbGdmaChannelBase(channel,tx)+8)&u32(2)) == u32(0)) { q.storeU32(12,0x40008);return 8 }
        q.storeU32(12,0);return 1
    }
    return 2
}
