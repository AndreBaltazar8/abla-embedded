import "./clock_c5_sequence.ab"
// C5 BCLK divisor1..64 encodedminus1 atRX20/TX24[26:21]. Shared MCLK
// binding is PCR80bit23:0TX/1RX (opposite of some other chip layouts).
// Own both directions/GDMA/ETM/IRQs and all codec/MCLK consumers; keep pads
// safe while clock binding changes. No implicit config UPDATE/start/reset.
// status0closed1ready2invalid3clock4busy5write/readback. Snapshot bits8..13
// oldBCLK,14direction(TX1),15oldMCLK,16valid; retained through failed setup.
type C5I2sClockRoute=int
fun C5I2sClockRoute.status(): int = this&255
fun C5I2sClockRoute.ready(): bool = this.status() == 1
trusted fun c5I2sBclkField(transmit: bool,value: int): bool {
    val offset=if (transmit) 0x24 else 0x20
    val before=c5I2sRead(offset)
    val mask=u32(0x7e00000)
    val desired=(before&~mask)|(u32(value)<<u32(21))
    if (before != desired) c5I2sWrite(offset,desired)
    return (c5I2sRead(offset)&mask) == (u32(value)<<u32(21))
}
trusted fun c5I2sClockRouteOpenOwned(port: int,transmit: bool,bclkDivider: int,exclusive: bool): C5I2sClockRoute {
    if (!exclusive || port != 0 || bclkDivider < 1 || bclkDivider > 64) return C5I2sClockRoute(2)
    if ((c5I2sClockRead(0)&u32(15)) != u32(13) || (c5I2sClockRead(if (transmit) 4 else 12)&u32(0x400000)) == u32(0)) return C5I2sClockRoute(3)
    if (!c5I2sStopped()) return C5I2sClockRoute(4)
    val token=65536|(int((c5I2sRead(if (transmit) 0x24 else 0x20)>>u32(21))&u32(63))<<8)|
        (if (transmit) 16384 else 0)|(int((c5I2sClockRead(12)>>u32(23))&u32(1))<<15)
    if (!c5I2sBclkField(transmit,bclkDivider-1) ||
        !c5I2sClockField(12,u32(0x800000),if (transmit) u32(0) else u32(0x800000))) return C5I2sClockRoute(token|5)
    return C5I2sClockRoute(token|1)
}
trusted fun C5I2sClockRoute.closeOwned(exclusive: bool): C5I2sClockRoute {
    if (!exclusive || this < 0 || (this&~0x1ffff) != 0 || (this&65536) == 0 || this.status() > 5) return this
    val token=this&~255
    if ((c5I2sClockRead(0)&u32(15)) != u32(13)) return C5I2sClockRoute(token|3)
    if (!c5I2sStopped()) return C5I2sClockRoute(token|4)
    if (!c5I2sClockField(12,u32(0x800000),u32((token>>>15)&1)<<u32(23)) ||
        !c5I2sBclkField((token&16384) != 0,(token>>>8)&63)) return C5I2sClockRoute(token|5)
    return C5I2sClockRoute(0)
}
