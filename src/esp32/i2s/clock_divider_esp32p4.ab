import "./clock_divider_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2s.ab"
@export("p4I2sDividerRead")
trusted fun p4I2sDividerReadHook(address: int): int = mmioLoadU32(address)
@export("p4I2sDividerWrite")
trusted fun p4I2sDividerWriteHook(address: int, value: int): void {
    mmioStoreU32(address,value)
    return
}
