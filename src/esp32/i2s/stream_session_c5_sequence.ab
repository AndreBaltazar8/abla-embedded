import "./dma_stream_c5_sequence.ab"
import "./dma_abort_c5_sequence.ab"
//140B:tag0,phase4,primary8,events12,start72@16,cursor28@88,shutdown24@116.
// Phases1UPDATE-pending2streaming6error7stopping8stopped. Own all referenced
// SRAM, clocks/configuration/pins for session lifetime; initialize TX payloads
// before begin. Configuration release is separate, only after stop returns1.
trusted fun c5I2sStreamSessionBeginOwned(r: NativeBuffer,channel: int,tx: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c5I2sDmaFiniteStorage(r) || r.loadU32(0) != 0 || channel < 0 || channel > 2 || polls < 1 || polls > 1000000 || !c5AhbGdmaRingValid(descriptors,count,buffers,stride,bytes)) return 2
    val address=r.addressValue()
    if ((address < descriptors+count*12 && descriptors < address+140) || (address < buffers+(count-1)*stride+bytes && buffers < address+140)) return 2
    var at=0
    while (at < 140) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x43354954);r.storeU32(28,channel);r.storeU32(32,if (tx) 1 else 0)
    val result=c5I2sDmaStartBeginOwned(nativeBufferAt(address+16,72),channel,tx,descriptors,count,buffers,stride,bytes,true,polls,true)
    if (result != 1 && result != 5) return c5I2sDmaFiniteFail(r,0x10000|result)
    r.storeU32(4,if (result == 1) 2 else 1)
    return if (result == 1) 1 else 5
}
//1block held (index100,bytes104),2invalid,4latched error,5pending. UPDATE
// completion advances startup exactly once; no new START after stop begins.
trusted fun c5I2sStreamSessionPollOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c5I2sDmaFiniteStorage(r) || r.loadU32(0) != 0x43354954 || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 6) return 4
    val start=nativeBufferAt(r.addressValue()+16,72)
    if (r.loadU32(4) == 1) {
        val result=c5I2sDmaStartAdvanceOwned(start,polls,true)
        if (result == 5) return 5
        if (result != 1) return c5I2sDmaFiniteFail(r,0x10000|result)
        r.storeU32(4,2)
    }
    if (r.loadU32(4) != 2) return 2
    val cursor=nativeBufferAt(r.addressValue()+88,28)
    val result=c5I2sDmaStreamPollOwned(start,cursor,true)
    r.storeU32(12,r.loadU32(12)|cursor.loadU32(20))
    if (result == 3) return c5I2sDmaFiniteFail(r,0x20000|cursor.loadU32(24))
    return result
}
// Caller has consumed RX or replaced TX bytes.1published,2invalid,4error.
trusted fun c5I2sStreamSessionRearmOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !c5I2sDmaFiniteStorage(r) || r.loadU32(0) != 0x43354954) return 2
    if (r.loadU32(4) == 6) return 4
    if (r.loadU32(4) != 2) return 2
    val cursor=nativeBufferAt(r.addressValue()+88,28)
    val result=c5I2sDmaStreamRearmOwned(nativeBufferAt(r.addressValue()+16,72),cursor,true)
    r.storeU32(12,r.loadU32(12)|cursor.loadU32(20))
    if (result == 3) return c5I2sDmaFiniteFail(r,0x30000|cursor.loadU32(24))
    return result
}
//1quiesced,2invalid,4recovery error,5pending,8FIFO requires drain/discard.
// Saves DMA events before ack, preserves primary error. Never rearms buffers
// or claims playback success. discard only permits explicit parked FIFO reset.
trusted fun c5I2sStreamSessionStopOwned(r: NativeBuffer,polls: int,exclusive: bool,discard: bool): int {
    if (!c5I2sDmaFiniteStorage(r) || r.loadU32(0) != 0x43354954) return 2
    return c5I2sDmaAbortLayoutOwned(r,polls,exclusive,discard)
}
