import "./pins_p4_sequence.ab"
import "../gpio_esp32p4.ab"
import "../../hal/esp32_i2s.ab"
import "../../hal/esp32.ab"
@export("p4I2sPinConfigure")
trusted fun p4I2sPinConfigureHook(pin: int,input: bool): int = esp32P4GpioConfigureOwned(pin,false,false,false,input,0)
@export("p4I2sPinRead")
trusted fun p4I2sPinReadHook(offset: int): u32 = p4GpioRead(offset)
@export("p4I2sPinWrite")
trusted fun p4I2sPinWriteHook(offset: int,value: u32): void { p4GpioWrite(offset,value);return }
@export("p4I2sPinField")
trusted fun p4I2sPinFieldHook(offset: int,mask: u32,value: u32): bool = p4GpioField(offset,mask,value)
