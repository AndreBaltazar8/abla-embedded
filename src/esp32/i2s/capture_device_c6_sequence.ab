import "./platform_c6_sequence.ab"
import "./capture_cancel_c6_sequence.ab"
//452B retained:header16,platform40@16,capture364@56,cancel32@420.
// States1active2captured3failed4closing5closed6cancelling7cancelled.
// Whole controller/GPIO/DMA/IRQ/ETM and codec ownership, physical roots
// already running and pinned by caller. Initial discard explicit/mandatory.
// No allocation, board assumptions, oscillator startup or codec initialization.
// Single-buffer capture hardware EOF stop, multi-buffer timely poll required.
// Optional circular mode uses capture_device_stream helpers with a separate
// cursor32B and explicit cancellation; finite APIs retain their defaults.
fun c6CaptureDeviceStorage(r: NativeBuffer): bool = r.hasAddressRange(0,452) && (r.addressValue()&3) == 0 && (r.addressValue()+452 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun c6CaptureDeviceValid(r: NativeBuffer): bool = c6CaptureDeviceStorage(r) && r.loadU32(0) == 0x43364350
trusted fun c6CaptureDevicePollOwned(r: NativeBuffer,budget: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c6CaptureDeviceValid(r) || budget < 1 || budget > 1024 || polls < 1 || polls > 1000000) return 2
    val state=r.loadU32(4)
    if (state == 5) return 6
    if (state == 7) return 8
    if (state == 3) return 3
    if (state == 2) return 4
    if (state != 1) return 2
    val child=nativeBufferAt(r.addressValue()+56,364)
    val result=c6CapturePollOwned(child,budget,polls,true)
    if (result == 3) { r.storeU32(4,3);r.storeU32(8,0x20000|child.loadU32(8)) }
    else if (result == 4) r.storeU32(4,2)
    r.storeU32(12,child.loadU32(12));return result
}
trusted fun c6CaptureDeviceOpenOwned(r: NativeBuffer,channel: int,source: int,rootHz: int,rateHz: int,maxPpm: int,bclk: int,ws: int,data: int,mclk: int,dataBits: int,slotBits: int,wsWidth: int,shift: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,discard: bool,exclusivePinnedRoots: bool,circular: bool=false): int {
    if (circular && count < 2) return 2
    if (!exclusivePinnedRoots || !discard || !c6CaptureDeviceStorage(r) || r.loadU32(0) != 0 || channel < 0 || channel > 2 || source < 0 || source > 3 || polls < 1 || polls > 1000000 || !c6GdmaRingValid(descriptors,count,buffers,stride,bytes)) return 2
    if (c6I2sStereoFrameWord(dataBits,slotBits,wsWidth,shift) < 0 || maxPpm < 0 || maxPpm > 10000) return 2
    if (!esp32C6GpioNumberValid(bclk) || !esp32C6GpioNumberValid(ws) || !esp32C6GpioNumberValid(data) || mclk < -1 || mclk > 30 ||
        bclk == ws || bclk == data || ws == data || (mclk >= 0 && (mclk == bclk || mclk == ws || mclk == data)) || (source == 3 && mclk < 0) ||
        (u32(bytes)%u32(dataBits/4)) != u32(0)) return 2
    if ((source == 1 && rootHz != 240000000) || (source == 2 && rootHz != 160000000) || !c6I2sRatePlan(rootHz,rateHz,slotBits*2,0).withinPpm(rootHz,rateHz,slotBits*2,maxPpm)) return 2
    val address=r.addressValue()
    if ((address < descriptors+count*12 && descriptors < address+452) || (address < buffers+(count-1)*stride+bytes && buffers < address+452)) return 2
    var at=0
    while (at < 452) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x43364350);r.storeU32(4,3)
    val platform=c6AudioPlatformOpenOwned(nativeBufferAt(address+16,40),channel,source,true,true,false)
    if (platform != 1) { r.storeU32(8,0x10000|platform);return 3 }
    val result=c6CaptureOpenOwned(nativeBufferAt(address+56,364),channel,source,rootHz,rateHz,0,maxPpm,bclk,ws,data,mclk,dataBits,slotBits,wsWidth,shift,descriptors,count,buffers,stride,bytes,polls,true,circular)
    if (result != 1 && result != 5) { r.storeU32(8,0x20000|result);return 3 }
    r.storeU32(4,1);return result
}
trusted fun c6CaptureDeviceCloseOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6CaptureDeviceValid(r) || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 5 || r.loadU32(4) == 7) return 6
    if (r.loadU32(4) != 2 && r.loadU32(4) != 3 && r.loadU32(4) != 4) return 2
    val child=nativeBufferAt(r.addressValue()+56,364)
    if (child.loadU32(0) != 0) {
        val result=c6CaptureCloseOwned(child,polls,true)
        if (result == 2) return 2
        r.storeU32(4,4)
        if (result != 6) { r.storeU32(12,0x20000|result);return result }
    }
    r.storeU32(4,4)
    val result=c6AudioPlatformCloseOwned(nativeBufferAt(r.addressValue()+16,40),true)
    if (result != 6) { r.storeU32(12,0x10000|result);return 7 }
    r.storeU32(12,0);r.storeU32(4,5);return 6
}
trusted fun c6CaptureDeviceCancelOwned(r: NativeBuffer,budget: int,polls: int,handledErrors: int,discard: bool,exclusive: bool,handledI2sErrors: int=0): int {
    if (!exclusive || !c6CaptureDeviceValid(r) || budget < 1 || budget > 1024 || polls < 1 || polls > 1000000 || handledErrors < 0 || (handledErrors&~0x7c) != 0 || (handledI2sErrors != 0 && handledI2sErrors != 4)) return 2
    if (r.loadU32(4) == 5) return 6
    if (r.loadU32(4) == 7) return 8
    r.storeU32(4,6)
    val child=nativeBufferAt(r.addressValue()+56,364)
    if (child.loadU32(0) != 0) {
        val result=c6CaptureCancelOwned(child,nativeBufferAt(r.addressValue()+420,32),budget,polls,handledErrors,discard,true,handledI2sErrors)
        if (result != 8 && result != 6) { r.storeU32(12,0x20000|result);return result }
    }
    val result=c6AudioPlatformCloseOwned(nativeBufferAt(r.addressValue()+16,40),true)
    if (result != 6) { r.storeU32(12,0x10000|result);return 7 }
    r.storeU32(12,0);r.storeU32(4,7);return 8
}
trusted fun c6CaptureDeviceRetryStopOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6CaptureDeviceValid(r) || r.loadU32(4) != 6) return 2
    return c6CaptureCancelRetryStopOwned(nativeBufferAt(r.addressValue()+56,364),nativeBufferAt(r.addressValue()+420,32),polls,true)
}

trusted fun c6CaptureDeviceBufferOwned(r: NativeBuffer,index: int,exclusive: bool): NativeBuffer {
    if (!exclusive || !c6CaptureDeviceValid(r) || r.loadU32(4) != 2) return NativeBuffer(0)
    return c6CaptureBufferOwned(nativeBufferAt(r.addressValue()+56,364),index,true)
}
