import "abla/runtime/scalar"
// P4 HP_SYS_CLKRST layouts, IDF6 hw_ver1/hw_ver3. Fields N/X/Y/Z/YN1.
// Registers are shared across ports and other peripherals: caller holds RCC
// exclusion AND owns both stopped I2S directions and their clock consumers.
fun p4I2sDividerField(route: int, field: int): int {
    if (route == 0) {
        if (field == 0) return 72 | (0 << 8)
        if (field == 1) return 72 | (8 << 8)
        if (field == 2) return 72 | (17 << 8)
        if (field == 3) return 76 | (0 << 8)
        if (field == 4) return 76 | (9 << 8)
    }
    if (route == 1) {
        if (field == 0) return 76 | (13 << 8)
        if (field == 1) return 76 | (21 << 8)
        if (field == 2) return 80 | (0 << 8)
        if (field == 3) return 80 | (9 << 8)
        if (field == 4) return 80 | (18 << 8)
    }
    if (route == 2) {
        if (field == 0) return 80 | (23 << 8)
        if (field == 1) return 84 | (0 << 8)
        if (field == 2) return 84 | (9 << 8)
        if (field == 3) return 84 | (18 << 8)
        if (field == 4) return 84 | (27 << 8)
    }
    if (route == 3) {
        if (field == 0) return 88 | (0 << 8)
        if (field == 1) return 88 | (8 << 8)
        if (field == 2) return 88 | (17 << 8)
        if (field == 3) return 92 | (0 << 8)
        if (field == 4) return 92 | (9 << 8)
    }
    if (route == 4) {
        if (field == 0) return 92 | (14 << 8)
        if (field == 1) return 92 | (22 << 8)
        if (field == 2) return 96 | (0 << 8)
        if (field == 3) return 96 | (9 << 8)
        if (field == 4) return 96 | (18 << 8)
    }
    if (route == 5) {
        if (field == 0) return 96 | (22 << 8)
        if (field == 1) return 100 | (0 << 8)
        if (field == 2) return 100 | (9 << 8)
        if (field == 3) return 100 | (18 << 8)
        if (field == 4) return 100 | (27 << 8)
    }
    return -1
}
trusted fun p4I2sDividerWriteField(route: int, field: int, value: int): bool {
    val packed=p4I2sDividerField(route,field)
    val address=0x500e6000+(packed & 255)
    val shift=packed >>> 8
    val mask=int(u32(if (field == 0) 255 else if (field == 4) 1 else 511) << u32(shift))
    val bits=int(u32(value) << u32(shift))
    p4I2sDividerWrite(address,(p4I2sDividerRead(address) & (0xffffffff ^ mask)) | bits)
    return (p4I2sDividerRead(address) & mask) == bits
}
// Fraction N+numerator/denominator. Clock/source already enabled/stable.
// No MCLK binding, BCLK setup, start, update, reset, or implicit rollback.
// 1 success, 2 invalid/unowned, 3 active/reset/update, 4..13 failed write.
// Failure can leave partial coefficients: keep consumers stopped and retain
// ownership until a complete retry or explicit restoration succeeds.
trusted fun esp32p4I2sSetDividerOwned(port: int, transmit: bool, integer: int,
    numerator: int, denominator: int, exclusive: bool): int {
    if (!exclusive || port < 0 || port > 2 || integer < 2 || integer > 255 ||
        denominator < 1 || denominator > 511 || numerator < 0 || numerator >= denominator) return 2
    val base=0x500c6000+port*4096
    if (((p4I2sDividerRead(base+32) | p4I2sDividerRead(base+36)) & 263) != 0) return 3
    var x=0;var y=0;var z=0;var yn1=0
    if (numerator != 0) {
        yn1=if (numerator*2 > denominator) 1 else 0
        z=if (yn1 == 1) denominator-numerator else numerator
        x=int(u32(denominator)/u32(z))-1
        y=int(u32(denominator)%u32(z))
    }
    val route=port*2+(if (transmit) 1 else 0)
    // Preserve every individual write and its order: double-division erratum.
    if (!p4I2sDividerWriteField(route,0,2)) return 4
    if (!p4I2sDividerWriteField(route,4,0)) return 5
    if (!p4I2sDividerWriteField(route,2,1)) return 6
    if (!p4I2sDividerWriteField(route,3,0)) return 7
    if (!p4I2sDividerWriteField(route,1,0)) return 8
    if (!p4I2sDividerWriteField(route,4,yn1)) return 9
    if (!p4I2sDividerWriteField(route,3,z)) return 10
    if (!p4I2sDividerWriteField(route,2,y)) return 11
    if (!p4I2sDividerWriteField(route,1,x)) return 12
    if (!p4I2sDividerWriteField(route,0,integer)) return 13
    return 1
}
