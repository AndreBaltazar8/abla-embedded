import "./reset_c5_sequence.ab"
import "../ahb_gdma_control_c5_sequence.ab"
// Explicit destructive pre-start initialization, matching IDF channel_start:
// direction reset -> GDMA reset -> I2S FIFO reset. Fresh UPDATE/START follows
// separately. Caller owns both I2S directions and selected DMA channel, has
// handled old events and accepts buffered data loss. No descriptor mutation.
// Scalar:status8,channel2@8,TX10,stage2@11,valid13.1submitted2invalid3clock
// 4busy/events5readback failure6reset released (NOT initialized).
type C5I2sBootstrap=int
fun C5I2sBootstrap.status(): int = this&255
fun C5I2sBootstrap.stage(): int = (this>>>11)&3
trusted fun c5I2sBootstrapOwned(channel: int,tx: bool,exclusive: bool,discard: bool): C5I2sBootstrap {
    if (!exclusive || !discard || channel < 0 || channel > 2) return C5I2sBootstrap(2)
    if (!c5I2sUpdateClocks(tx) || !c5AhbGdmaChannelClocks()) return C5I2sBootstrap(3)
    val base=c5AhbGdmaChannelBase(channel,tx)
    if (!c5I2sStopped() || !c5AhbGdmaControlAdmitted(channel,tx) ||
        c5AhbGdmaRead(c5AhbGdmaEventBase(channel,tx)) != u32(0) ||
        (c5AhbGdmaRead(base+16)&u32(if (tx) 15 else 30)) != u32(if (tx) 8 else 16)) return C5I2sBootstrap(4)
    val token=8192|(channel<<8)|(if (tx) 1024 else 0)
    val direction=c5I2sResetOwned(0,tx,1,true,true)
    if (direction != 1) return C5I2sBootstrap(token|2048|direction)
    val dma=c5AhbGdmaResetOwned(channel,tx,true,true,false)
    if (dma != 1) return C5I2sBootstrap(token|4096|dma)
    val fifo=c5I2sResetOwned(0,tx,2,true,true)
    return C5I2sBootstrap(token|6144|fifo)
}
// Recover a failed deassertion without replaying any reset pulse. Retain the
// exclusive stopped lifetime; success only removes reset, never certifies
// bootstrap. Explicitly call begin again if initialization must be retried.
trusted fun C5I2sBootstrap.releaseOwned(exclusive: bool): C5I2sBootstrap {
    if (!exclusive || this < 0 || (this&~16383) != 0 || (this&8192) == 0 || ((this>>>8)&3) > 2 || this.stage() == 0) return this
    if (this.status() == 1 || this.status() == 6) return this
    val result=if (this.stage() == 2) c5AhbGdmaResetOwned((this>>>8)&3,(this&1024) != 0,true,false,true)
        else c5I2sResetReleaseOwned(0,(this&1024) != 0,true)
    return C5I2sBootstrap((this&~255)|(if (result == 1) 6 else result))
}
