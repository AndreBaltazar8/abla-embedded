import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkI2sPlatformCallers(): bool {
    if (!internalFunction("esp32RecoveredI2sPlatformAcquireOccupation", "i2s_platform_acquire_occupation")) return false
    if (!internalFunction("esp32RecoveredI2sPlatformReleaseOccupation", "i2s_platform_release_occupation")) return false
    if (!internalFunction("esp32RecoveredI2sPlatformGetDmaBufferOffset", "i2s_platform_get_dma_buffer_offset")) return false
    true
}
