import "abla/unsafe/mmio"
import "./clock_c6_sequence.ab"
import "../../hal/esp32_i2s.ab"
@export("c6I2sClockRead")
trusted fun c6I2sClockReadHook(offset: int): u32 = u32(mmioLoadU32(0x6009606c+offset))
@export("c6I2sClockWrite")
trusted fun c6I2sClockWriteHook(offset: int,value: u32): void { mmioStoreU32(0x6009606c+offset,int(value));return }
@export("c6I2sRead")
trusted fun c6I2sReadHook(offset: int): u32 = u32(mmioLoadU32(0x6000c000+offset))
@export("c6I2sWrite")
trusted fun c6I2sWriteHook(offset: int,value: u32): void { mmioStoreU32(0x6000c000+offset,int(value));return }
