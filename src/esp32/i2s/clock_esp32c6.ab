import "abla/unsafe/mmio"
import "./clock_c6_sequence.ab"
trusted fun c6I2sClockRead(offset: int): u32 = u32(mmioLoadU32(0x6009606c+offset))
trusted fun c6I2sClockWrite(offset: int,value: u32): void { mmioStoreU32(0x6009606c+offset,int(value));return }
trusted fun c6I2sRead(offset: int): u32 = u32(mmioLoadU32(0x6000c000+offset))
trusted fun c6I2sWrite(offset: int,value: u32): void { mmioStoreU32(0x6000c000+offset,int(value));return }
