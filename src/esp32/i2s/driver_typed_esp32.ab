trusted fun esp32I2sCleanupEmptyController(controller: u32): void {
    if (controller == u32(0) ||
        esp32I2sLoadU32(controller, u32(16)) != u32(0) ||
        esp32I2sLoadU32(controller, u32(20)) != u32(0)) return

    var id = u32(0)
    while (id < u32(2)) {
        val cell = u32(esp32I2sObject) + u32(8) + id * u32(4)
        if (esp32I2sLoadU32(cell) == controller) {
            esp32I2sDestroyControllerCell(cell)
            return
        }
        id = id + u32(1)
    }
    return
}

trusted fun esp32I2sNewChannel(
    configuration: u32,
    transmitHandle: u32,
    receiveHandle: u32
): u32 {
    if (configuration == u32(0) ||
        (transmitHandle == u32(0) && receiveHandle == u32(0))) {
        return u32(258)
    }

    val requestedId = esp32I2sLoadU32(configuration, u32(0))
    if (requestedId != u32(4294967295) && requestedId >= u32(2)) {
        return u32(258)
    }
    val descriptorCount = esp32I2sLoadU32(configuration, u32(8))
    if (descriptorCount < u32(2)) return u32(258)
    val interruptPriority = esp32I2sLoadU32(configuration, u32(20))
    if (interruptPriority >= u32(8)) return u32(258)
    if (esp32I2sLoadU8(configuration, u32(18)) != u32(0)) {
        return u32(262)
    }

