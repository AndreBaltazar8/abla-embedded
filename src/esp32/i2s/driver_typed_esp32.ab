    var available = false

    if (requestedId == u32(4294967295)) {
        var id = u32(0)
        while (id < u32(2) && !available) {
            controller = esp32I2sAcquireController(id)
            if (controller != u32(0)) {
                available = esp32I2sTakeAvailableChannel(
                    controller, searchMask
                )
            }
            id = id + u32(1)
        }
    } else {
        controller = esp32I2sAcquireController(requestedId)
        if (controller != u32(0)) {
            available = esp32I2sTakeAvailableChannel(
                controller, searchMask
            )
        }
    }
    if (controller == u32(0) || !available) return u32(261)

    var result = u32(0)
    if (transmitHandle != u32(0)) {
        result = esp32I2sRegisterChannel(
            controller, u32(2), descriptorCount
        )
        if (result == u32(0)) {
            val channel = esp32I2sLoadU32(controller, u32(16))
            esp32I2sStoreU32(
                channel, u32(8),
                esp32I2sLoadU32(configuration, u32(4))
            )
            val autoPort =
                if (requestedId == u32(4294967295)) u32(1) else u32(0)
            esp32I2sStoreU8(
                channel, u32(64),
                (esp32I2sLoadU8(channel, u32(64)) & u32(4294967294)) |
                    autoPort
            )
            val flags = if (interruptPriority == u32(0)) u32(14)
                else u32(1) << interruptPriority
            esp32I2sStoreU32(channel, u32(56), flags)
            esp32I2sStoreU8(
                channel, u32(32),
                esp32I2sLoadU8(configuration, u32(16))
            )
            esp32I2sStoreU8(
                channel, u32(33),
                esp32I2sLoadU8(configuration, u32(17))
            )
            esp32I2sStoreU32(channel, u32(20), descriptorCount)
            esp32I2sStoreU32(
                channel, u32(24),
                esp32I2sLoadU32(configuration, u32(12))
            )
            esp32I2sStoreU32(
                channel, u32(140),
                u32(nativeFunctionAddress(
                    esp32I2sTransmitChannelStart
                ))
            )
            esp32I2sStoreU32(
                channel, u32(144),
                u32(nativeFunctionAddress(
                    esp32I2sTransmitChannelStop
                ))
            )
            esp32I2sStoreU32(transmitHandle, u32(0), channel)
        }
    }

    if (result == u32(0) && receiveHandle != u32(0)) {
        result = esp32I2sRegisterChannel(
            controller, u32(1), descriptorCount
        )
        if (result == u32(0)) {
            val channel = esp32I2sLoadU32(controller, u32(20))
            esp32I2sStoreU32(
                channel, u32(8),
                esp32I2sLoadU32(configuration, u32(4))
            )
            val autoPort =
                if (requestedId == u32(4294967295)) u32(1) else u32(0)
            esp32I2sStoreU8(
                channel, u32(64),
                (esp32I2sLoadU8(channel, u32(64)) & u32(4294967294)) |
                    autoPort
            )
            val flags = if (interruptPriority == u32(0)) u32(14)
                else u32(1) << interruptPriority
            esp32I2sStoreU32(channel, u32(56), flags)
            esp32I2sStoreU32(channel, u32(20), descriptorCount)
            esp32I2sStoreU32(
                channel, u32(24),
                esp32I2sLoadU32(configuration, u32(12))
            )
            esp32I2sStoreU32(
                channel, u32(140),
                u32(nativeFunctionAddress(
                    esp32I2sReceiveChannelStart
                ))
            )
            esp32I2sStoreU32(
                channel, u32(144),
                u32(nativeFunctionAddress(
                    esp32I2sReceiveChannelStop
