import "common_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/mmio"
import "abla/unsafe/native"

// Typed ESP32 I2S driver core reconstructed from ESP-IDF 6's i2s_common.c.
// The controller and channel layouts remain ABI-compatible with the rest of
// the source-owned driver, while ordinary Abla control flow replaces the
// recovered register-machine dispatchers.

@inline
trusted fun esp32I2sLoadU32(address: u32, offset: u32 = u32(0)): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address + offset))))

@inline
trusted fun esp32I2sLoadU8(address: u32, offset: u32 = u32(0)): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address + offset))))

@inline
trusted fun esp32I2sStoreU32(
    address: u32,
    offset: u32,
    value: u32
): void = ablaUnsafeStoreU32(
    nativePointerFromAddress(int(address + offset)), int(value)
)

@inline
trusted fun esp32I2sStoreU8(
    address: u32,
    offset: u32,
    value: u32
): void = ablaUnsafeStoreU8(
    nativePointerFromAddress(int(address + offset)), int(value)
)

@inline
trusted fun esp32I2sRegisterLoadU32(device: u32, offset: u32): u32 =
    u32(ablaUnsafeVolatileLoadU32(int(device + offset)))

@inline
trusted fun esp32I2sRegisterStoreU32(device: u32, offset: u32, value: u32): void =
    ablaUnsafeVolatileStoreU32(int(device + offset), int(value))

// Only I2S register addresses use these primitives; descriptors and PCM stay RAM.
@inline
trusted fun esp32I2sUpdateRegister(
    address: u32,
    mask: u32,
    value: u32
): void {
    xtensaMemoryBarrier()
    esp32I2sRegisterStoreU32(
        address, u32(0),
        (esp32I2sRegisterLoadU32(address, u32(0)) & (mask ^ u32(4294967295))) |
            (value & mask)
    )
    xtensaMemoryBarrier()
}

// ESP32 I2S hardware instances from soc/i2s_reg.h. The HAL context is a
// single device pointer, so it remains an unboxed four-byte Abla value.
trusted fun esp32I2sHalInitialize(hal: u32, port: u32): void {
    val device = if (port == u32(0)) u32(1073016832)
        else if (port == u32(1)) u32(1073139712)
        else u32(0)
    esp32I2sStoreU32(hal, u32(0), device)
}

// Abla implementation of hal_utils_calc_clk_div_frac_accurate specialized to
// the classic ESP32 I2S divider: N is 1..255 and A/B are 6-bit values.
trusted fun esp32I2sHalCalculateMclkDivision(
    sourceClock: u32,
    masterClock: u32,
    division: u32
): void {
    if (masterClock == u32(0)) {
        esp32I2sStoreU32(division, u32(0), u32(0))
        esp32I2sStoreU32(division, u32(4), u32(0))
        esp32I2sStoreU32(division, u32(8), u32(0))
        return
    }

    var integerPart = sourceClock / masterClock
    val frequencyError = sourceClock % masterClock
    var denominator = u32(2)
    var numerator = u32(0)
    if (frequencyError != u32(0)) {
        val carryThreshold = masterClock -
            (masterClock / u32(63)) * u32(2)
        if (frequencyError < carryThreshold) {
            var candidate = u32(2)
            var minimumError = u64(18446744073709551615)
            while (minimumError != u64(0) && candidate < u32(64)) {
                val roundedProduct = u64(candidate) * u64(frequencyError) +
                    u64(masterClock / u32(2))
                val candidateNumerator = esp32UnsignedDivide64Low(
                    u32(roundedProduct),
                    u32(roundedProduct >>> u64(32)),
                    masterClock,
                    u32(0)
                )
                val expectedProduct = u64(masterClock) *
                    u64(candidateNumerator)
                val actualProduct = u64(frequencyError) * u64(candidate)
                val error = if (expectedProduct > actualProduct)
                    expectedProduct - actualProduct
                else actualProduct - expectedProduct
                if (error < minimumError) {
                    denominator = candidate
                    numerator = candidateNumerator
                    minimumError = error
                }
                candidate = candidate + u32(1)
            }
        } else {
            integerPart = integerPart + u32(1)
        }
    }

    if (integerPart == u32(0) || integerPart >= u32(256)) {
        integerPart = u32(0)
        denominator = u32(0)
        numerator = u32(0)
    }
    esp32I2sStoreU32(division, u32(0), integerPart)
    esp32I2sStoreU32(division, u32(4), denominator)
    esp32I2sStoreU32(division, u32(8), numerator)
}

trusted fun esp32I2sHalSetClock(
    hal: u32,
    clockInformation: u32,
    source: u32,
    returnedDivision: u32,
    receive: bool
): void {
    val device = esp32I2sLoadU32(hal)
    val apll = if (source == u32(12)) u32(2097152) else u32(0)
    esp32I2sUpdateRegister(device + u32(172), u32(2097152), apll)
    if (clockInformation == u32(0)) return

    val localDivision = u32(nativeStackAllocate(12))
    val division = if (returnedDivision != u32(0)) returnedDivision
        else localDivision
    freestandingSet(division, 0, u32(12))
    esp32I2sHalCalculateMclkDivision(
        esp32I2sLoadU32(clockInformation, u32(0)),
        esp32I2sLoadU32(clockInformation, u32(4)),
        division
    )

    val integerPart = esp32I2sLoadU32(division, u32(0)) & u32(255)
    val denominator = esp32I2sLoadU32(division, u32(4)) & u32(63)
    val numerator = esp32I2sLoadU32(division, u32(8)) & u32(63)
    esp32I2sUpdateRegister(
        device + u32(172), u32(1048575),
        // CLKM_DIV_B (numerator) is bits 8..13; DIV_A (denominator) 14..19.
        integerPart | (numerator << u32(8)) | (denominator << u32(14))
    )

    val bitClockDivision = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(int(clockInformation + u32(14)))
    )) & u32(63)
    val bitClockMask = if (receive) u32(4032) else u32(63)
    val bitClockValue = if (receive) bitClockDivision << u32(6)
        else bitClockDivision
    esp32I2sUpdateRegister(
        device + u32(176), bitClockMask, bitClockValue
    )
}

trusted fun esp32I2sHalSetTransmitClock(
    hal: u32,
    clockInformation: u32,
    source: u32,
    returnedDivision: u32
): void = esp32I2sHalSetClock(
    hal, clockInformation, source, returnedDivision, false
)

trusted fun esp32I2sHalSetReceiveClock(
    hal: u32,
    clockInformation: u32,
    source: u32,
    returnedDivision: u32
): void = esp32I2sHalSetClock(
    hal, clockInformation, source, returnedDivision, true
)

trusted fun esp32I2sHalReset(device: u32, receive: bool): void {
    val reset = if (receive) u32(2) else u32(1)
    val dmaReset = if (receive) u32(1) else u32(2)
    esp32I2sUpdateRegister(device + u32(8), reset, reset)
    esp32I2sUpdateRegister(device + u32(8), reset, u32(0))
    esp32I2sUpdateRegister(device + u32(96), dmaReset, dmaReset)
    esp32I2sUpdateRegister(device + u32(96), dmaReset, u32(0))
}

trusted fun esp32I2sHalConfigureSampleWidth(
    device: u32,
    slotWidth: u32,
    dataWidth: u32,
    receive: bool
): void {
    val fifoMask = if (receive) u32(458752) else u32(57344)
    val fifoShift = if (receive) u32(16) else u32(13)
    val fifoMode = if (slotWidth > u32(16)) u32(2) else u32(0)
    esp32I2sUpdateRegister(
        device + u32(32), fifoMask, fifoMode << fifoShift
    )
    val sampleMask = if (receive) u32(16515072) else u32(258048)
    val sampleShift = if (receive) u32(18) else u32(12)
    esp32I2sUpdateRegister(
        device + u32(176), sampleMask,
        (dataWidth & u32(63)) << sampleShift
    )
}

trusted fun esp32I2sHalSelectTransmitSlot(
    device: u32,
    slotMask: u32,
    mono: bool
): void {
    var mode = u32(0)
    if (mono) {
        if (slotMask == u32(1)) mode = u32(3)
        else if (slotMask == u32(2)) mode = u32(4)
        else if (slotMask == u32(3)) mode = u32(1)
    } else {
        if (slotMask == u32(1)) mode = u32(1)
        else if (slotMask == u32(2)) mode = u32(2)
    }
    esp32I2sUpdateRegister(device + u32(44), u32(7), mode)
}

trusted fun esp32I2sHalSelectReceiveSlot(
    device: u32,
    slotMask: u32,
    msbRight: bool
): void {
    var mode = u32(0)
    if (slotMask == u32(1)) mode = if (msbRight) u32(1) else u32(2)
    else if (slotMask == u32(2)) {
        mode = if (msbRight) u32(2) else u32(1)
    }
    esp32I2sUpdateRegister(device + u32(44), u32(24), mode << u32(3))
}

trusted fun esp32I2sHalSetStandardTransmitSlot(
    hal: u32,
    slave: bool,
    slot: u32
): void {
    val device = esp32I2sLoadU32(hal)
    val dataWidth = esp32I2sLoadU32(slot, u32(0))
    val configuredSlotWidth = esp32I2sLoadU32(slot, u32(4))
    val slotWidth = if (configuredSlotWidth > dataWidth)
        configuredSlotWidth else dataWidth
    val mono = esp32I2sLoadU32(slot, u32(8)) == u32(1)
    esp32I2sHalReset(device, false)
    esp32I2sUpdateRegister(
        device + u32(8), u32(64), if (slave) u32(64) else u32(0)
    )
    esp32I2sHalConfigureSampleWidth(
        device, slotWidth, dataWidth, false
    )
    esp32I2sUpdateRegister(
        device + u32(8), u32(1024),
        (esp32I2sLoadU8(slot, u32(21)) & u32(1)) << u32(10)
    )
    esp32I2sUpdateRegister(
        device + u32(8), u32(4096),
        if (esp32I2sLoadU32(slot, u32(16)) == u32(1))
            u32(4096) else u32(0)
    )
    val fifoMode = (if (dataWidth > u32(16)) u32(2) else u32(0)) +
        (if (mono) u32(1) else u32(0))
    esp32I2sUpdateRegister(
        device + u32(32), u32(57344), fifoMode << u32(13)
    )
    esp32I2sHalSelectTransmitSlot(
        device, esp32I2sLoadU32(slot, u32(12)), mono
    )
    esp32I2sUpdateRegister(
        device + u32(8), u32(65536),
        (esp32I2sLoadU8(slot, u32(22)) & u32(1)) << u32(16)
    )
    esp32I2sUpdateRegister(
        device + u32(8), u32(256),
        (esp32I2sLoadU8(slot, u32(20)) & u32(1)) << u32(8)
    )
    esp32I2sUpdateRegister(
        device + u32(32), u32(524288), u32(524288)
    )
}

trusted fun esp32I2sHalSetStandardReceiveSlot(
    hal: u32,
    slave: bool,
    slot: u32
): void {
    val device = esp32I2sLoadU32(hal)
    val dataWidth = esp32I2sLoadU32(slot, u32(0))
    val configuredSlotWidth = esp32I2sLoadU32(slot, u32(4))
    val slotWidth = if (configuredSlotWidth > dataWidth)
        configuredSlotWidth else dataWidth
    val mono = esp32I2sLoadU32(slot, u32(8)) == u32(1)
    esp32I2sHalReset(device, true)
    esp32I2sUpdateRegister(
        device + u32(8), u32(128), if (slave) u32(128) else u32(0)
    )
    esp32I2sHalConfigureSampleWidth(
        device, slotWidth, dataWidth, true
    )
    val fifoMode = (if (dataWidth > u32(16)) u32(2) else u32(0)) +
        (if (mono) u32(1) else u32(0))
    esp32I2sUpdateRegister(
        device + u32(32), u32(458752), fifoMode << u32(16)
    )
    esp32I2sUpdateRegister(
        device + u32(8), u32(2048),
        (esp32I2sLoadU8(slot, u32(21)) & u32(1)) << u32(11)
    )
    esp32I2sUpdateRegister(
        device + u32(8), u32(8192),
        if (esp32I2sLoadU32(slot, u32(16)) == u32(1))
            u32(8192) else u32(0)
    )
    val msbRight = esp32I2sLoadU8(slot, u32(22)) != u32(0)
    esp32I2sHalSelectReceiveSlot(
        device, esp32I2sLoadU32(slot, u32(12)), msbRight
    )
    esp32I2sUpdateRegister(
        device + u32(8), u32(131072),
        (esp32I2sLoadU8(slot, u32(22)) & u32(1)) << u32(17)
    )
    esp32I2sUpdateRegister(
        device + u32(8), u32(512),
        (esp32I2sLoadU8(slot, u32(20)) & u32(1)) << u32(9)
    )
    esp32I2sUpdateRegister(
        device + u32(32), u32(1048576), u32(1048576)
    )
}

trusted fun esp32I2sHalSetPdmReceiveSlot(
    hal: u32,
    slave: bool,
    slot: u32
): void {
    val device = esp32I2sLoadU32(hal)
    val dataWidth = esp32I2sLoadU32(slot, u32(0))
    val configuredSlotWidth = esp32I2sLoadU32(slot, u32(4))
    val slotWidth = if (configuredSlotWidth > dataWidth)
        configuredSlotWidth else dataWidth
    val mono = esp32I2sLoadU32(slot, u32(8)) == u32(1)
    esp32I2sHalReset(device, true)
    esp32I2sUpdateRegister(
        device + u32(8), u32(128), if (slave) u32(128) else u32(0)
    )
    esp32I2sHalConfigureSampleWidth(
        device, slotWidth, dataWidth, true
    )
    val fifoMode = (if (dataWidth > u32(16)) u32(2) else u32(0)) +
        (if (mono) u32(1) else u32(0))
    esp32I2sUpdateRegister(
        device + u32(32), u32(458752), fifoMode << u32(16)
    )
    var receiveMode = u32(0)
    val slotMask = esp32I2sLoadU32(slot, u32(12))
    if (slotMask == u32(1)) receiveMode = u32(1)
    else if (slotMask == u32(2)) receiveMode = u32(2)
    esp32I2sUpdateRegister(
        device + u32(44), u32(24), receiveMode << u32(3)
    )
    esp32I2sUpdateRegister(
        device + u32(32), u32(1048576), u32(1048576)
    )
    esp32I2sUpdateRegister(device + u32(8), u32(131584), u32(0))
}

trusted fun esp32I2sTransmitChannelStart(handle: u32): void {
    val controller = esp32I2sLoadU32(handle, u32(0))
    val device = esp32I2sLoadU32(controller, u32(4))
    esp32I2sUpdateRegister(device + u32(8), u32(1), u32(1))
    esp32I2sUpdateRegister(device + u32(8), u32(1), u32(0))
    esp32I2sUpdateRegister(device + u32(96), u32(2), u32(2))
    esp32I2sUpdateRegister(device + u32(96), u32(2), u32(0))
    esp32I2sUpdateRegister(device + u32(96), u32(2), u32(2))
    esp32I2sUpdateRegister(device + u32(96), u32(2), u32(0))
    esp32I2sUpdateRegister(device + u32(8), u32(4), u32(4))
    esp32I2sUpdateRegister(device + u32(8), u32(4), u32(0))
    esp32RecoveredEspIntrEnable(
        esp32I2sLoadU32(handle, u32(16)),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    esp32I2sUpdateRegister(device + u32(20), u32(4096), u32(4096))
    esp32I2sUpdateRegister(device + u32(32), u32(4096), u32(4096))
    val firstDescriptor = esp32I2sLoadU32(
        esp32I2sLoadU32(handle, u32(44)), u32(0)
    )
    esp32I2sUpdateRegister(
        device + u32(48), u32(1073741823),
        (firstDescriptor & u32(1048575)) | u32(536870912)
    )
    if ((esp32I2sLoadU8(handle, u32(64)) & u32(2)) == u32(0)) {
        esp32I2sUpdateRegister(device + u32(8), u32(16), u32(16))
    }
}

trusted fun esp32I2sReceiveChannelStart(handle: u32): void {
    val controller = esp32I2sLoadU32(handle, u32(0))
    val device = esp32I2sLoadU32(controller, u32(4))
    esp32I2sUpdateRegister(device + u32(8), u32(2), u32(2))
    esp32I2sUpdateRegister(device + u32(8), u32(2), u32(0))
    esp32I2sUpdateRegister(device + u32(96), u32(1), u32(1))
    esp32I2sUpdateRegister(device + u32(96), u32(1), u32(0))
    esp32I2sUpdateRegister(device + u32(96), u32(1), u32(1))
    esp32I2sUpdateRegister(device + u32(96), u32(1), u32(0))
    esp32I2sUpdateRegister(device + u32(8), u32(8), u32(8))
    esp32I2sUpdateRegister(device + u32(8), u32(8), u32(0))
    esp32RecoveredEspIntrEnable(
        esp32I2sLoadU32(handle, u32(16)),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    esp32I2sUpdateRegister(device + u32(20), u32(512), u32(512))
    esp32I2sUpdateRegister(device + u32(32), u32(4096), u32(4096))
    val firstDescriptor = esp32I2sLoadU32(
        esp32I2sLoadU32(handle, u32(44)), u32(0)
    )
    esp32I2sUpdateRegister(
        device + u32(52), u32(1073741823),
        (firstDescriptor & u32(1048575)) | u32(536870912)
    )
    if ((esp32I2sLoadU8(handle, u32(64)) & u32(2)) == u32(0)) {
        esp32I2sUpdateRegister(device + u32(8), u32(32), u32(32))
    }
}

trusted fun esp32I2sTransmitChannelStop(handle: u32): void {
    val controller = esp32I2sLoadU32(handle, u32(0))
    val device = esp32I2sLoadU32(controller, u32(4))
    if ((esp32I2sLoadU8(handle, u32(64)) & u32(4)) == u32(0)) {
        esp32I2sUpdateRegister(device + u32(8), u32(16), u32(0))
    }
    esp32I2sUpdateRegister(device + u32(48), u32(268435456), u32(268435456))
    esp32I2sUpdateRegister(device + u32(20), u32(4096), u32(0))
    esp32I2sUpdateRegister(device + u32(32), u32(4096), u32(0))
    esp32RecoveredEspIntrDisable(
        esp32I2sLoadU32(handle, u32(16)),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp32I2sReceiveChannelStop(handle: u32): void {
    val controller = esp32I2sLoadU32(handle, u32(0))
    val device = esp32I2sLoadU32(controller, u32(4))
    if ((esp32I2sLoadU8(handle, u32(64)) & u32(4)) == u32(0)) {
        esp32I2sUpdateRegister(device + u32(8), u32(32), u32(0))
    }
    esp32I2sUpdateRegister(device + u32(52), u32(268435456), u32(268435456))
    esp32I2sUpdateRegister(device + u32(20), u32(512), u32(0))
    esp32I2sUpdateRegister(device + u32(32), u32(4096), u32(0))
    esp32RecoveredEspIntrDisable(
        esp32I2sLoadU32(handle, u32(16)),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp32I2sPlatformSetBusClock(
    id: u32,
    enabled: bool
): void {
    val bit = if (id == u32(0)) u32(16) else u32(2097152)
    val clockEnable = u32(1072693440)
    val current = esp32DportRead(clockEnable)
    xtensaMemoryBarrier()
    esp32I2sStoreU32(
        clockEnable, u32(0),
        if (enabled) current | bit else current & (bit ^ u32(4294967295))
    )
    xtensaMemoryBarrier()
}

trusted fun esp32I2sPlatformReset(id: u32): void {
    val bit = if (id == u32(0)) u32(16) else u32(2097152)
    val reset = u32(1072693444)
    var current = esp32DportRead(reset)
    xtensaMemoryBarrier()
    esp32I2sStoreU32(reset, u32(0), current | bit)
    xtensaMemoryBarrier()
    current = esp32DportRead(reset)
    esp32I2sStoreU32(
        reset, u32(0), current & (bit ^ u32(4294967295))
    )
    xtensaMemoryBarrier()
}

trusted fun esp32I2sPlatformAcquire(
    id: u32,
    componentName: u32
): u32 {
    if (id >= u32(2)) return u32(258)
    esp32RecoveredXPortEnterCriticalTimeout(
        esp32I2sObject, u32(4294967295)
    )
    val controllerOffset = u32(8) + id * u32(4)
    val componentOffset = u32(16) + id * u32(4)
    if (esp32I2sLoadU32(esp32I2sObject, controllerOffset) != u32(0) ||
        esp32I2sLoadU32(esp32I2sObject, componentOffset) != u32(0)) {
        esp32RecoveredVPortExitCriticalValue(esp32I2sObject)
        return u32(261)
    }
    esp32I2sStoreU32(esp32I2sObject, componentOffset, componentName)

    esp32RecoveredPeriphRccEnter(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    esp32I2sPlatformSetBusClock(id, true)
    esp32I2sPlatformReset(id)
    val device = if (id == u32(0)) u32(1073016832)
        else u32(1073139712)
    esp32I2sUpdateRegister(
        device + u32(172), u32(1048576), u32(1048576)
    )
    esp32I2sRegisterStoreU32(device, u32(168), u32(0))
    esp32RecoveredPeriphRccExit(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    esp32RecoveredVPortExitCriticalValue(esp32I2sObject)
    return u32(0)
}

trusted fun esp32I2sPlatformRelease(id: u32): u32 {
    if (id >= u32(2)) return u32(258)
    esp32RecoveredXPortEnterCriticalTimeout(
        esp32I2sObject, u32(4294967295)
    )
    val controllerOffset = u32(8) + id * u32(4)
    if (esp32I2sLoadU32(esp32I2sObject, controllerOffset) != u32(0)) {
        esp32RecoveredVPortExitCriticalValue(esp32I2sObject)
        return u32(259)
    }
    esp32I2sStoreU32(
        esp32I2sObject, u32(16) + id * u32(4), u32(0)
