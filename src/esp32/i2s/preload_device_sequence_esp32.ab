// Caller owns the port and must serialize prepare/preload/start/uninstall.
// Kept separate so the actual lifecycle can be exercised without hardware.
trusted fun I2sDevice.install(microphone: bool, dmaDescriptors: int = 6): bool {
    if (!this.prepare(microphone, dmaDescriptors)) return false
    if (this.start()) return true
    this.uninstall()
    false
}

trusted fun I2sDevice.start(): bool {
    val handle = this.handleAddress()
    handle != 0 && esp32I2sStartPrepared(handle)
}

// Complete sample pairs only: independently swapped odd-sample chunks would
// change chronological order at chunk boundaries on ESP32 HW-v1 mono output.
// Returns the exact accepted prefix (possibly zero when the ring is full).
// Does not start DMA. A successful short preload is not a transfer failure.
trusted fun I2sDevice.preload(buffer: NativeBuffer, length: int): int {
    if (length < 0 || (length & 3) != 0 ||
        !buffer.hasAddressRange(0, length)) return -1
    val handle = this.handleAddress()
    if (handle == 0) return -1
    if (length == 0) return 0
    val address = buffer.addressValue()
    swapEsp32MonoSamplePairs(address, length)
    val loaded = esp32I2sPreloadPrepared(handle, address, length)
    swapEsp32MonoSamplePairs(address, length)
    loaded
}
