import "abla/runtime/scalar"
// DATA/WS/BCLK/MCLK index0..3. Both P4 register layouts, three HP I2S ports.
fun esp32p4I2sPinSignal(port: int, transmit: bool, index: int): int {
    if (port < 0 || port > 2 || index < 0 || index > 3) return -1
    val base=25+port*6
    if (index == 0) return base+3
    if (index == 1) return base+(if (transmit) 2 else 5)
    if (index == 2) return base+(if (transmit) 0 else 4)
    return base+1
}
// Flags: slave BCLK/WS inputs, external MCLK input, BCLK/WS/MCLK inversion.
// Absent MCLK=-1 only without external clock. Pins are hardware GPIO numbers,
// not an assertion that a board's memory/strapping/USB pins are available.
fun esp32p4I2sPinsValid(port: int,mclk: int,bclk: int,ws: int,data: int,flags: int): bool {
    if (port < 0 || port > 2 || flags < 0 || flags > 31 ||
        mclk < -1 || mclk > 54 || bclk < 0 || bclk > 54 || ws < 0 || ws > 54 ||
        data < 0 || data > 54 || (mclk == -1 && (flags & 2) != 0)) return false
    return bclk != ws && bclk != data && ws != data &&
        (mclk == -1 || (mclk != bclk && mclk != ws && mclk != data))
}
