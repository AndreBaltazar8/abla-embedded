import "./standard_session_c6_sequence.ab"
import "../gdma_tx_channel_c6_sequence.ab"
// TX-only 64B retained record: tag0,state4,primary8,channel64@12,standard44@20.
// States1ready4partial5pending6closed7closing. Returns1ready2invalid3admission
// 4partial5pending6closed. Caller owns stopped I2S, codec, GDMA, IRQ and ETM;
// clocks and initialized FIFOs remain pinned. No reset, discard, start or ack.
fun c6I2sDmaConfigStorage(r: NativeBuffer): bool = r.hasAddressRange(0,64) && (r.addressValue()&3) == 0 && (r.addressValue()+64 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun c6I2sDmaConfigSave(r: NativeBuffer,dma: C6GdmaTxChannel): void { r.storeU32(12,dma|0);r.storeU32(16,dma>>>32);return }
trusted fun c6I2sDmaConfigOpenOwned(r: NativeBuffer,channel: int,dataBits: int,slotBits: int,wsWidth: int,shift: bool,polls: int,exclusive: bool): int {
    if (!exclusive || !c6I2sDmaConfigStorage(r) || r.loadU32(0) != 0 || channel < 0 || channel > 2 || polls < 1 || polls > 1000000 || c6I2sStereoFrameWord(dataBits,slotBits,wsWidth,shift) < 0) return 2
    if (!c6I2sUpdateClocks(true) || !c6I2sStopped() || !c6GdmaClocksReady() || !c6GdmaTxParked(channel)) return 3
    var at=0
    while (at < 64) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x4336494f);r.storeU32(4,4)
    val dma=c6GdmaTxChannelOpenOwned(channel,3,true)
    c6I2sDmaConfigSave(r,dma)
    if (dma.status() != 1) { r.storeU32(8,0x10000|dma.status());return 4 }
    val result=c6I2sStandardOpenOwned(nativeBufferAt(r.addressValue()+20,44),dataBits,slotBits,wsWidth,shift,polls,true)
    if (result == 4) { r.storeU32(4,5);return 5 }
    if (result != 1) { r.storeU32(8,0x20000|result);return 4 }
    r.storeU32(4,1);return 1
}
trusted fun c6I2sDmaConfigWaitOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6I2sDmaConfigStorage(r) || r.loadU32(0) != 0x4336494f || r.loadU32(4) != 5 || polls < 1 || polls > 1000000) return 2
    val result=c6I2sStandardWaitOwned(nativeBufferAt(r.addressValue()+20,44),polls,true)
    if (result == 4) return 5
    if (result != 1) { r.storeU32(8,0x20000|result);r.storeU32(4,4);return 4 }
    r.storeU32(4,1);return 1
}
trusted fun c6I2sDmaConfigCloseOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6I2sDmaConfigStorage(r) || r.loadU32(0) != 0x4336494f || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 6) return 6
    r.storeU32(4,7)
    var dma=C6GdmaTxChannel(r.loadU32(12)|(r.loadU32(16)<<32))
    // Joining DMA/events precedes any format restoration, even on partial open.
    if ((dma&(1<<49)) != 0 && (!c6GdmaClocksReady() || !c6GdmaTxParked((dma>>>47)&3))) return 3
    val standard=nativeBufferAt(r.addressValue()+20,44)
    if (standard.loadU32(0) != 0) {
        val result=c6I2sStandardCloseOwned(standard,polls,true)
        if (result != 5) return if (result == 4) 5 else 4
    }
    if ((dma&(1<<49)) != 0 && dma.status() != 6) {
        dma=dma.closeOwned(true);c6I2sDmaConfigSave(r,dma)
        if (dma.status() != 6) return 4
    }
    r.storeU32(4,6);return 6
}
