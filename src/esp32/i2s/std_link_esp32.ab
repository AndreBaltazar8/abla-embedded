import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkI2sStdOpaqueCallers(): bool {
    if (!internalFunction("esp32I2sInitializeStandardMode", "i2s_channel_init_std_mode")) return false
    if (!internalFunction("esp32RecoveredI2sChannelReconfigStdClock", "i2s_channel_reconfig_std_clock")) return false
    if (!internalFunction("esp32RecoveredI2sChannelReconfigStdSlot", "i2s_channel_reconfig_std_slot")) return false
    if (!internalFunction("esp32RecoveredI2sChannelReconfigStdGpio", "i2s_channel_reconfig_std_gpio")) return false
    true
}
