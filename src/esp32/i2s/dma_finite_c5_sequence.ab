import "./dma_completion_c5_sequence.ab"
import "./dma_stop_c5_sequence.ab"
// 140B retained RAM:tag0,phase4,error8,events12,start72@16,
// completion28@88,shutdown24@116. Phase1update2transfer3stop4events5done6error.
// Caller prepares format/pins/clocks/DMA/RXEOF/FIFOs and owns all resources.
// Returns1finished2invalid4error5pending8FIFO-not-empty. No configuration
// release, automatic reset/discard, or claim of physically audible playback.
// Error retains subrecords for explicit recovery using lower-level stop API.
// Acknowledges only successful-transfer events, after shutdown; errors remain
// latched in hardware and record. Callers may inspect completion bytes at104.
fun c5I2sDmaFiniteStorage(r: NativeBuffer): bool = r.hasAddressRange(0,140) && (r.addressValue()&3) == 0 && (r.addressValue()+140 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun c5I2sDmaFiniteFail(r: NativeBuffer,code: int): int { r.storeU32(8,code);r.storeU32(4,6);return 4 }
trusted fun c5I2sDmaFinitePollOwned(r: NativeBuffer,budget: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c5I2sDmaFiniteStorage(r) || r.loadU32(0) != 0x43354946 || budget < 1 || budget > 1024 || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 5) return 1
    if (r.loadU32(4) == 6) return 4
    val start=nativeBufferAt(r.addressValue()+16,72)
    if (r.loadU32(4) == 1) {
        val result=c5I2sDmaStartAdvanceOwned(start,polls,true)
        if (result == 5) return 5
        if (result != 1) return c5I2sDmaFiniteFail(r,0x10000|result)
        r.storeU32(4,2)
    }
    if (r.loadU32(4) == 2) {
        val completion=nativeBufferAt(r.addressValue()+88,28)
        val result=c5I2sDmaCompletionPollOwned(start,completion,budget,true)
        r.storeU32(12,r.loadU32(12)|completion.loadU32(20))
        if (result == 5) return 5
        if (result != 1) return c5I2sDmaFiniteFail(r,0x20000|completion.loadU32(24))
        r.storeU32(4,3)
    }
    if (r.loadU32(4) == 3) {
        val result=c5I2sDmaStopOwned(start,nativeBufferAt(r.addressValue()+116,24),polls,true)
        if (result == 5 || result == 8) return result
        if (result != 1) return c5I2sDmaFiniteFail(r,0x30000|result)
        r.storeU32(4,4)
    }
    if (r.loadU32(4) == 4) {
        val events=c5AhbGdmaEventsReadOwned(start.loadU32(12),start.loadU32(16) != 0,true)
        if (events.status() != 1) return c5I2sDmaFiniteFail(r,0x40000|events.status())
        r.storeU32(12,r.loadU32(12)|events.raw())
        if (events.errors() != 0) return c5I2sDmaFiniteFail(r,0x50000|events.errors())
        val ack=events.acknowledgeOwned(events.raw(),true)
        if (ack == 6) return 5
        if (ack != 1) return c5I2sDmaFiniteFail(r,0x60000|ack)
        r.storeU32(4,5);return 1
    }
    return 2
}
trusted fun c5I2sDmaFiniteBeginOwned(r: NativeBuffer,channel: int,tx: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c5I2sDmaFiniteStorage(r) || r.loadU32(0) != 0 || !c5AhbGdmaRingValid(descriptors,count,buffers,stride,bytes) || channel < 0 || channel > 2 || polls < 1 || polls > 1000000) return 2
    val address=r.addressValue()
    if ((address < descriptors+count*12 && descriptors < address+140) || (address < buffers+(count-1)*stride+bytes && buffers < address+140)) return 2
    var at=0
    while (at < 140) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x43354946)
    // Retain pair identity even if hardware admission rejects startup. Leave
    // the start tag unset: identity alone does not claim any hardware work.
    r.storeU32(28,channel);r.storeU32(32,if (tx) 1 else 0)
    val result=c5I2sDmaStartBeginOwned(nativeBufferAt(address+16,72),channel,tx,descriptors,count,buffers,stride,bytes,false,polls,true)
    if (result != 1 && result != 5) return c5I2sDmaFiniteFail(r,0x10000|result)
    r.storeU32(4,if (result == 1) 2 else 1)
    return 5
}
