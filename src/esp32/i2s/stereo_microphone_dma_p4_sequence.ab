import "./pins_p4_logic.ab"
// Shared RX0 standard Philips stereo16,24kHz,256fsMCLK. Board adapters
// supply distinct owned GPIOs; no board-specific codec or rail operations.
// Stable40MHz XTAL/(6+49/96)=6.144MHz; divide8 for768kHz BCLK.
// Caller owns initialized DMA controller, parked RX channel, both stopped
// I2S0 directions, shared clock/pad routes, holds, ring and cache engine.
// Shared speaker must be stopped; this does NOT implement simultaneous duplex.
// Codec setup/start and retained cleanup belong to the session layer.
// Low8:1ready2invalid3park4bus5busy6reset7DMA8format9EOF10pins11ring12cache.
trusted fun esp32p4PrepareStereoMicrophone24kDmaOwned(channel: int,descriptors: int,count: int,
    payload: int,stride: int,bytes: int,revision: int,polls: int,mclk: int,bclk: int,ws: int,data: int,exclusive: bool): int {
    if (!exclusive || !esp32p4I2sPinsValid(0,mclk,bclk,ws,data,0) || mclk < 0 || channel < 0 || channel > 2 || revision < 0 || polls < 1 || polls > 1000000 ||
        count < 2 || (bytes&3) != 0 || !esp32p4AhbGdmaRingLayoutValid(descriptors,count,payload,stride,bytes)) return 2
    if (p4StereoMicParked(channel) != 1) return 3
    val bus=p4StereoMicBus()
    if (bus != 1) return 4|(bus << 8)
    if (!p4StereoMicI2sStopped()) return 5
    val reset=p4StereoMicReset()
    if (reset != 1) return 6|(reset << 8)
    val dma=p4StereoMicDmaPrepare(channel)
    if (dma != 1) return 7|(dma << 8)
    val format=p4StereoMicFormat(revision)
    if (format != 1) return 8|(format << 8)
    val eof=p4StereoMicEof(bytes)
    if (eof != 1) return 9|(eof << 8)
    val pins=p4StereoMicPins(mclk,bclk,ws,data)
    if (pins != 1) return 10|(pins << 8)
    if (!p4StereoMicRing(descriptors,count,payload,stride,bytes)) return 11
    val published=p4StereoMicPublish(descriptors,count,payload,stride,bytes,polls)
    if (published != 1) return 12|(published << 8)
    return 1
}
