// Controller primitives; caller owns direction AND its parked DMA channel
// before resetting. Clearing I2S START alone does not reclaim DMA buffers.
trusted fun esp32s3I2sResetDirection(port: int, transmit: bool): bool {
    if (port < 0 || port > 1) return false
    val config = 0x6000f000 + port * 0x1e000 + (if (transmit) 36 else 32)
    if ((esp32s3I2sClockRead(config) & 260) != 0) return false
    esp32s3I2sClockField(config, 1, 1)
    esp32s3I2sClockField(config, 1, 0)
    esp32s3I2sClockField(config, 2, 2)
    esp32s3I2sClockField(config, 2, 0)
    true
}

// Match IDF i2s_common.c: RX EOF is programmed with DMA buffer BYTE size,
// despite the generated register header's inconsistent sample-count text.
trusted fun esp32s3I2sSetReceiveBlockBytes(port: int, bytes: int): bool {
    if (port < 0 || port > 1 || bytes < 1 || bytes > 4095) return false
    val base = 0x6000f000 + port * 0x1e000
    if ((esp32s3I2sClockRead(base + 32) & 260) != 0) return false
    esp32s3I2sClockField(base + 100, 4095, bytes)
    true
}

// DMA must be prepared before starting. A failed latch never sets START.
trusted fun esp32s3I2sStartDirection(port: int, transmit: bool, pollLimit: int): bool {
    if (!esp32s3I2sLatchConfiguration(port, transmit, pollLimit)) return false
    esp32s3I2sClockField(0x6000f000 + port * 0x1e000 + (if (transmit) 36 else 32), 4, 4)
    true
}

// Stop request only; coordinate GDMA stop/park before reset or buffer reuse.
trusted fun esp32s3I2sStopDirection(port: int, transmit: bool): bool {
    if (port < 0 || port > 1) return false
    esp32s3I2sClockField(0x6000f000 + port * 0x1e000 + (if (transmit) 36 else 32), 4, 0)
    true
}
