// Clock plan: low7 bits BCLK divisor, remaining bits requested MCLK Hz.
// PCM BCLK=rate*64 or*128; raw PDM BCLK=rate*2, as in IDF. All active
// channels count toward the divider minimum (128*channels/downsample factor).
// Source is supplied/stable, NOT powered here; use the existing fractional
// clock chooser to realize MCLK and report its actual frequency.
type Esp32S3PdmReceiveClock=int
fun Esp32S3PdmReceiveClock.valid(): bool = this != 0
fun Esp32S3PdmReceiveClock.bitClockDivider(): int = this&127
fun Esp32S3PdmReceiveClock.masterClockHz(): int = this>>>7
fun esp32s3PdmReceiveClock(sourceHz: int,rate: int,slots: int,pcm: bool,downsample128: bool,requestedDivider: int): Esp32S3PdmReceiveClock {
    if (sourceHz < 1 || sourceHz > 1000000000 || rate < 1 || rate > 10000000 || slots < 1 || slots > 255 || requestedDivider < 1 || requestedDivider > 64) return Esp32S3PdmReceiveClock(0)
    var bits=slots;var channels=0
    while (bits != 0) { channels=channels+(bits&1);bits=bits>>>1 }
    val factor=if (downsample128) 128 else 64
    val limit=if (downsample128) channels else channels*2
    var divider=if (requestedDivider < 8) 8 else requestedDivider
    if (divider < limit) divider=limit
    val mclk=rate*(if (pcm) factor else 2)*divider
    if (sourceHz*100 <= mclk*199 || sourceHz >= mclk*256) return Esp32S3PdmReceiveClock(0)
    return Esp32S3PdmReceiveClock((mclk<<7)|divider)
}
