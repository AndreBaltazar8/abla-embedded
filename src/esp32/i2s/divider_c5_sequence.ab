import "./clock_c5_sequence.ab"
// C5 PCR78/80 N[19:12],7c/84 Z[8:0],Y[17:9],X[26:18],YN1[27].
// Preserve the exact ten-write LL double-division workaround, including
// unchanged fields. No source/BCLK/MCLK binding, update/start or reset.
trusted fun c5I2sDividerField(transmit: bool,field: int,value: int): bool {
    val base=if (transmit) 4 else 12
    val shift=if (field == 0) 12 else if (field == 1) 18 else if (field == 2) 9 else if (field == 3) 0 else 27
    val mask=u32(if (field == 0) 255 else if (field == 4) 1 else 511)<<u32(shift)
    val offset=base+(if (field == 0) 0 else 4)
    val bits=u32(value)<<u32(shift)
    c5I2sClockWrite(offset,(c5I2sClockRead(offset)&~mask)|bits)
    return (c5I2sClockRead(offset)&mask) == bits
}
// Both directions, GDMA/ETM/IRQ and all clock/codec consumers exclusively
// stopped; selected direction's source/clock enabled/stable. Fraction N+B/A.
// Errors2invalid3clocks4busy5..14write failure. A failure can leave partial
// coefficients: keep ownership/consumers stopped until full retry/restoration.
trusted fun c5I2sSetDividerOwned(port: int,transmit: bool,integer: int,numerator: int,denominator: int,exclusive: bool): int {
    if (!exclusive || port != 0 || integer < 2 || integer > 255 || denominator < 1 || denominator > 511 || numerator < 0 || numerator >= denominator) return 2
    if ((c5I2sClockRead(0)&u32(15)) != u32(13) || (c5I2sClockRead(if (transmit) 4 else 12)&u32(0x400000)) == u32(0)) return 3
    if (!c5I2sStopped()) return 4
    var x=0;var y=0;var z=0;var yn1=0
    if (numerator != 0) {
        yn1=if (numerator*2 > denominator) 1 else 0
        z=if (yn1 == 1) denominator-numerator else numerator
        x=int(u32(denominator)/u32(z))-1;y=int(u32(denominator)%u32(z))
    }
    return c5I2sProgramDivider(transmit,integer,x,y,z,yn1)
}
// Shared exact encoded sequence, also used to restore captured coefficients.
trusted fun c5I2sProgramDivider(transmit: bool,integer: int,x: int,y: int,z: int,yn1: int): int {
    if (!c5I2sDividerField(transmit,0,2)) return 5
    if (!c5I2sDividerField(transmit,4,0)) return 6
    if (!c5I2sDividerField(transmit,2,1)) return 7
    if (!c5I2sDividerField(transmit,3,0)) return 8
    if (!c5I2sDividerField(transmit,1,0)) return 9
    if (!c5I2sDividerField(transmit,4,yn1)) return 10
    if (!c5I2sDividerField(transmit,3,z)) return 11
    if (!c5I2sDividerField(transmit,2,y)) return 12
    if (!c5I2sDividerField(transmit,1,x)) return 13
    if (!c5I2sDividerField(transmit,0,integer)) return 14
    return 1
}
