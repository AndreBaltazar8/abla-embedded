import "./clock_control_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2s.ab"
@export("p4I2sControlRead")
trusted fun p4I2sControlReadHook(address: int): int = mmioLoadU32(address)
@export("p4I2sControlWrite")
trusted fun p4I2sControlWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
