import "./divider_c6_sequence.ab"
// Retained scalar snapshot:N8@8,fraction28@16,TX44,valid45.
// Same exclusive stopped-consumer contract as divider primitive; clocks must
// remain pinned through cleanup. Restore raw original fields (even reset
// defaults), using the exact ten-write hardware workaround, not two bulk RMWs.
// status1ready2invalid3clock4busy5..14write failure15restored.
type C6I2sDividerOwner=int
fun C6I2sDividerOwner.status(): int = this&255
trusted fun c6I2sDividerOpenOwned(port: int,tx: bool,integer: int,numerator: int,denominator: int,exclusive: bool): C6I2sDividerOwner {
    if (!exclusive || port != 0 || integer < 2 || integer > 255 || denominator < 1 || denominator > 511 || numerator < 0 || numerator >= denominator) return C6I2sDividerOwner(2)
    if ((c6I2sClockRead(0)&u32(3)) != u32(1) || (c6I2sClockRead(if (tx) 4 else 12)&u32(0x400000)) == u32(0)) return C6I2sDividerOwner(3)
    if (!c6I2sStopped()) return C6I2sDividerOwner(4)
    val base=if (tx) 4 else 12
    val token=(1<<45)|(if (tx) 1<<44 else 0)|(int((c6I2sClockRead(base)>>u32(12))&u32(255))<<8)|
        (int(c6I2sClockRead(base+4)&u32(0xfffffff))<<16)
    return C6I2sDividerOwner(token|c6I2sSetDividerOwned(0,tx,integer,numerator,denominator,true))
}
trusted fun C6I2sDividerOwner.closeOwned(exclusive: bool): C6I2sDividerOwner {
    if (!exclusive || this < 0 || (this&~0x3fffffffffff) != 0 || (this&(1<<45)) == 0 || this.status() < 1 || this.status() >= 15) return this
    val token=this&~255
    val tx=(token&(1<<44)) != 0
    if ((c6I2sClockRead(0)&u32(3)) != u32(1) || (c6I2sClockRead(if (tx) 4 else 12)&u32(0x400000)) == u32(0)) return C6I2sDividerOwner(token|3)
    if (!c6I2sStopped()) return C6I2sDividerOwner(token|4)
    val fraction=(token>>>16)&0xfffffff
    val result=c6I2sProgramDivider(tx,(token>>>8)&255,(fraction>>>18)&511,(fraction>>>9)&511,fraction&511,(fraction>>>27)&1)
    return C6I2sDividerOwner(token|(if (result == 1) 15 else result))
}
