import "./clock_c5_sequence.ab"
// C5 LL update: set CONFbit8, hardware clears after latching configuration.
// Own both stopped directions/IRQs/ETM/DMA, keep all clocks/config writers
// excluded. Snapshot CONF at16, directionTXbit8, leasebit9. No reset/start.
// status1complete2invalid3clock4busy5pending6config-changed. Timeout retains
// token; wait never republishes UPDATE. Fast hardware completion is legal;
// as in LL, a cleared bit assumes the MMIO write reached functioning hardware.
type C5I2sUpdate=int
fun C5I2sUpdate.status(): int = this&255
fun C5I2sUpdate.complete(): bool = this.status() == 1
trusted fun c5I2sUpdateClocks(transmit: bool): bool =
    (c5I2sClockRead(0)&u32(15)) == u32(13) && (c5I2sClockRead(if (transmit) 4 else 12)&u32(0x400000)) != u32(0)
trusted fun C5I2sUpdate.waitOwned(polls: int,exclusive: bool): C5I2sUpdate {
    if (!exclusive || polls < 1 || polls > 1000000 || this < 0 || (this&~0xffffffff03ff) != 0 || (this&512) == 0) return this
    val token=this&~255
    val transmit=(token&256) != 0
    if (!c5I2sUpdateClocks(transmit)) return C5I2sUpdate(token|3)
    val conf=if (transmit) 0x24 else 0x20
    val expected=u32(token>>>16)
    var left=polls
    while (left > 0) {
        val current=c5I2sRead(conf)
        if ((current&~u32(256)) != expected || c5I2sRead(0x14) != u32(0) ||
            (c5I2sRead(if (transmit) 0x20 else 0x24)&u32(0x107)) != u32(0)) return C5I2sUpdate(token|6)
        if ((current&u32(256)) == u32(0)) return C5I2sUpdate(token|1)
        left=left-1
    }
    return C5I2sUpdate(token|5)
}
trusted fun c5I2sUpdateBeginOwned(port: int,transmit: bool,polls: int,exclusive: bool): C5I2sUpdate {
    if (!exclusive || port != 0 || polls < 1 || polls > 1000000) return C5I2sUpdate(2)
    if (!c5I2sUpdateClocks(transmit)) return C5I2sUpdate(3)
    if (!c5I2sStopped()) return C5I2sUpdate(4)
    val conf=if (transmit) 0x24 else 0x20
    val before=c5I2sRead(conf)
    val token=C5I2sUpdate((int(before)<<16)|512|(if (transmit) 256 else 0)|5)
    c5I2sWrite(conf,before|u32(256))
    return token.waitOwned(polls,true)
}
