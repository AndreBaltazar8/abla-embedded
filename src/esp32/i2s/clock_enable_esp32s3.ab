import "./clock_esp32s3.ab"
import "./clock_enable_sequence_esp32s3.ab"
import "../rcc_esp32s3.ab"

// Bounded nonrecursive lock: false means caller must retry later or handle
// failure. Owner token must be nonzero/unique across overlapping RCC users.
trusted fun esp32s3I2sEnableClock(port: int, owner: u32): bool {
    if (port < 0 || port > 1) return false
    val lock = esp32S3RccSharedLock()
    val saved = esp32S3RccTryEnter(lock, owner)
    if (saved < 0) return false
    val enabled = esp32s3I2sEnableClockLocked(port)
    atomicMemoryFence()
    val released = esp32S3RccLeave(lock, owner, saved)
    enabled && released
}
