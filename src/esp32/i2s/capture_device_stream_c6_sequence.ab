import "./capture_device_c6_sequence.ab"
import "./capture_stream_c6_sequence.ab"
// Open existing452B device with circular=true, retain separate zeroed32B cursor.
// Exclusive lifetime includes ALL readers; join readers before release/cancel.
// Device cancellation restores setup and platform, never treats cancel as EOF.
trusted fun c6CaptureDeviceStreamLayout(r: NativeBuffer,q: NativeBuffer): bool =
    c6CaptureDeviceValid(r) && c6I2sRxStreamStorage(q) &&
    !(q.addressValue() < r.addressValue()+452 && r.addressValue() < q.addressValue()+32) &&
    c6CaptureStreamLayout(nativeBufferAt(r.addressValue()+56,364),q)
trusted fun c6CaptureDeviceStreamSync(r: NativeBuffer): void {
    val child=nativeBufferAt(r.addressValue()+56,364)
    if (child.loadU32(4) == 7) { r.storeU32(4,3);r.storeU32(8,0x20000|child.loadU32(8)) }
    r.storeU32(12,child.loadU32(12));return
}
trusted fun c6CaptureDeviceStreamPollOwned(r: NativeBuffer,q: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6CaptureDeviceStreamLayout(r,q) || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 3) return 3
    if (r.loadU32(4) != 1) return 2
    val result=c6CaptureStreamPollOwned(nativeBufferAt(r.addressValue()+56,364),q,polls,true)
    c6CaptureDeviceStreamSync(r);return result
}
trusted fun c6CaptureDeviceStreamBufferOwned(r: NativeBuffer,q: NativeBuffer,exclusive: bool): NativeBuffer {
    if (!exclusive || !c6CaptureDeviceStreamLayout(r,q) || r.loadU32(4) != 1) return NativeBuffer(0)
    val view=c6CaptureStreamBufferOwned(nativeBufferAt(r.addressValue()+56,364),q,true)
    c6CaptureDeviceStreamSync(r);return view
}
trusted fun c6CaptureDeviceStreamReleaseOwned(r: NativeBuffer,q: NativeBuffer,consumersJoined: bool,exclusive: bool): int {
    if (!exclusive || !consumersJoined || !c6CaptureDeviceStreamLayout(r,q) || r.loadU32(4) != 1) return 2
    val result=c6CaptureStreamReleaseOwned(nativeBufferAt(r.addressValue()+56,364),q,true,true)
    c6CaptureDeviceStreamSync(r);return result
}
