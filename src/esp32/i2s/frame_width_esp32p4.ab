import "./frame_width_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2s.ab"
@export("p4I2sFrameRead")
trusted fun p4I2sFrameReadHook(address: int): int = mmioLoadU32(address)
@export("p4I2sFrameWrite")
trusted fun p4I2sFrameWriteHook(address: int, value: int): void {
    mmioStoreU32(address, value)
    return
}
