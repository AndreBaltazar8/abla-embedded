import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkI2sCommonOpaqueCallers(): bool {
    if (!internalFunction("esp32I2sChangePort", "i2s_channel_change_port")) return false
    if (!internalFunction("esp32RecoveredI2sChannelRegisterEventCallback", "i2s_channel_register_event_callback")) return false
    if (!internalFunction("esp32I2sBufferSize", "i2s_get_buf_size")) return false
    if (!internalFunction("esp32I2sFreeDmaDescriptors", "i2s_free_dma_desc")) return false
    if (!internalFunction("esp32I2sAllocateDmaDescriptors", "i2s_alloc_dma_desc")) return false
    if (!internalFunction("esp32I2sSourceClockFrequency", "i2s_get_source_clk_freq")) return false
    if (!internalFunction("esp32I2sInitializeDmaInterrupt", "i2s_init_dma_intr")) return false
    if (!internalFunction("esp32I2sReserveOutputGpio", "i2s_output_gpio_reserve")) return false
    if (!internalFunction("esp32I2sRevokeOutputGpios", "i2s_output_gpio_revoke")) return false
    if (!internalFunction("esp32I2sConfigureGpioSignal", "i2s_gpio_check_and_set")) return false
    if (!internalFunction("esp32I2sConfigureGpioLoopback", "i2s_gpio_loopback_set")) return false
    if (!internalFunction("esp32I2sConfigureMasterClock", "i2s_check_set_mclk")) return false
    if (!internalFunction("esp32I2sDeleteChannel", "i2s_del_channel")) return false
    if (!internalFunction("esp32I2sNewChannel", "i2s_new_channel")) return false
    if (!internalFunction("esp32RecoveredI2sChannelGetInfo", "i2s_channel_get_info")) return false
    if (!internalFunction("esp32I2sEnableChannel", "i2s_channel_enable")) return false
    if (!internalFunction("esp32I2sDisableChannel", "i2s_channel_disable")) return false
    if (!internalFunction("esp32RecoveredI2sChannelPreloadData", "i2s_channel_preload_data")) return false
    if (!internalFunction("esp32I2sWrite", "i2s_channel_write")) return false
    if (!internalFunction("esp32I2sRead", "i2s_channel_read")) return false
    if (!internalFunction("esp32RecoveredI2sChannelTuneRate", "i2s_channel_tune_rate")) return false
    true
}
