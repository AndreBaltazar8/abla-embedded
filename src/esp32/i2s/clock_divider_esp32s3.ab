// S3 fractional divider N + numerator/denominator. Return -1 for values
// outside the supported canonical fraction range; zero encodes integer-only.
fun esp32s3I2sFractionWord(numerator: int, denominator: int): int {
    if (denominator < 1 || denominator > 511 || numerator < 0 || numerator >= denominator) return -1
    if (numerator == 0) return 0
    val inverted = numerator * 2 > denominator
    val z = if (inverted) denominator - numerator else numerator
    val x = denominator / z - 1
    val y = denominator % z
    (if (inverted) 1 << 27 else 0) | (x << 18) | (y << 9) | z
}

// Caller owns/quiesces both directions (their external MCLK is shared), has
// enabled the peripheral clock and selected its source. No pad routing,
// clock-source assumption, channel start or configuration latch is implicit.
// Preserve Espressif's ordered workaround for the double-division erratum:
// switch N to 2, reset YN1/Y/Z/X separately, set YN1/Z/Y/X, then target N.
trusted fun esp32s3I2sSetDivider(port: int, transmit: bool,
    integer: int, numerator: int, denominator: int): bool {
    val word = esp32s3I2sFractionWord(numerator, denominator)
    if (port < 0 || port > 1 || integer < 2 || integer > 255 || word < 0) return false
    val config = 0x6000f000 + port * 0x1e000 + (if (transmit) 52 else 48)
    val fraction = config + 8
    esp32s3I2sClockField(config, 255, 2)
    esp32s3I2sClockField(fraction, 1 << 27, 0)
    esp32s3I2sClockField(fraction, 511 << 9, 1 << 9)
    esp32s3I2sClockField(fraction, 511, 0)
    esp32s3I2sClockField(fraction, 511 << 18, 0)
    esp32s3I2sClockField(fraction, 1 << 27, word & (1 << 27))
    esp32s3I2sClockField(fraction, 511, word & 511)
    esp32s3I2sClockField(fraction, 511 << 9, word & (511 << 9))
    esp32s3I2sClockField(fraction, 511 << 18, word & (511 << 18))
    esp32s3I2sClockField(config, 255, integer)
    true
}
