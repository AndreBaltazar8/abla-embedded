// C5 I2S0 only. PCR74 bus/reset/RXready/TXready,78 TXclock,80 RXclock.
// Caller owns both directions/GDMA/ETM/IRQs/MCLK consumers, keeps root clocks
// and peripheral domain stable, stopped/settled users and safe codec/pads.
// Sources0XTAL/1PLL240/2PLL160/3externalMCLK already selected/pinned.
// No reset/source/divider/MCLK-route changes. This is not audio configuration.
// status0closed1ready2invalid3reset/source4bus5ready-timeout6busy7TX8RX.
// Attempted ownership bits8bus9TX10RX; retain token on every partialfailure.
type C5I2sClock=int
fun C5I2sClock.status(): int = this&255
fun C5I2sClock.ready(): bool = this.status() == 1
trusted fun c5I2sClockField(offset: int,mask: u32,value: u32): bool {
    val old=c5I2sClockRead(offset)
    if ((old&mask) != value) c5I2sClockWrite(offset,(old&~mask)|value)
    return (c5I2sClockRead(offset)&mask) == value
}
trusted fun c5I2sStopped(): bool = c5I2sRead(0x14) == u32(0) &&
    ((c5I2sRead(0x20)|c5I2sRead(0x24))&u32(0x107)) == u32(0) &&
    (c5I2sRead(0x6c)&u32(1)) != u32(0)
trusted fun c5I2sClockOpenOwned(port: int,directions: int,txSource: int,rxSource: int,polls: int,exclusive: bool): C5I2sClock {
    if (!exclusive || port != 0 || directions < 1 || directions > 3 || txSource < 0 || txSource > 3 || rxSource < 0 || rxSource > 3 || polls < 1 || polls > 1000000) return C5I2sClock(2)
    val bus=c5I2sClockRead(0)
    val tx=c5I2sClockRead(4);val rx=c5I2sClockRead(12)
    if ((bus&u32(2)) != u32(0) || ((directions&1) != 0 && int((tx>>u32(20))&u32(3)) != txSource) ||
        ((directions&2) != 0 && int((rx>>u32(20))&u32(3)) != rxSource)) return C5I2sClock(3)
    var token=0
    if ((bus&u32(1)) == u32(0)) {
        token=256
        if (!c5I2sClockField(0,u32(1),u32(1))) return C5I2sClock(token|4)
    }
    var left=polls
    while (left > 0 && (c5I2sClockRead(0)&u32(12)) != u32(12)) left=left-1
    if (left == 0) return C5I2sClock(token|5)
    if (!c5I2sStopped()) return C5I2sClock(token|6)
    if ((directions&1) != 0 && (tx&u32(0x400000)) == u32(0)) {
        token=token|512
        if (!c5I2sClockField(4,u32(0x400000),u32(0x400000))) return C5I2sClock(token|7)
    }
    if ((directions&2) != 0 && (rx&u32(0x400000)) == u32(0)) {
        token=token|1024
        if (!c5I2sClockField(12,u32(0x400000),u32(0x400000))) return C5I2sClock(token|8)
    }
    return C5I2sClock(token|1)
}
trusted fun C5I2sClock.closeOwned(exclusive: bool): C5I2sClock {
    if (!exclusive || this < 0 || (this&~2047) != 0 || this.status() > 8 || this.status() == 0) return this
    var token=this&1792
    val bus=c5I2sClockRead(0)
    if ((bus&u32(2)) != u32(0)) return C5I2sClock(token|6)
    if ((bus&u32(13)) == u32(13)) {
        if (!c5I2sStopped()) return C5I2sClock(token|6)
    } else if ((token&1536) != 0 || this.ready()) return C5I2sClock(token|6)
    if ((token&1024) != 0) {
        if (!c5I2sClockField(12,u32(0x400000),u32(0))) return C5I2sClock(token|8)
        token=token&~1024
    }
    if ((token&512) != 0) {
        if (!c5I2sClockField(4,u32(0x400000),u32(0))) return C5I2sClock(token|7)
        token=token&~512
    }
    if ((token&256) != 0 && !c5I2sClockField(0,u32(1),u32(0))) return C5I2sClock(token|4)
    return C5I2sClock(0)
}
