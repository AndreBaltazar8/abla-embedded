// Owned, already clocked/configured/pin-routed I2S+GDMA direction. The caller
// reserves both resources and keeps the entire descriptor chain/payload live.
// No allocator, ISR registration or automatic ownership transfer is implied.
// Stop statuses:1 stopped+DMA parked,2 invalid,3 I2S stop failure,
// 4 GDMA stop failure,5 park timeout. Only1 permits reclaiming DMA storage.
trusted fun esp32s3I2sStopStream(port: int, transmit: bool, channel: int, polls: int): int {
    if (port < 0 || port > 1 || channel < 0 || channel > 4 || polls < 1 || polls > 1000000) return 2
    val i2sStopped = esp32s3I2sStopDirection(port, transmit)
    val dmaStopped = esp32s3GdmaRequestStop(channel, transmit)
    var parked = false
    var attempt = 0
    while (!parked && attempt < polls) {
        parked = esp32s3GdmaParked(channel, transmit)
        attempt = attempt + 1
    }
    if (!i2sStopped) return 3
    if (!dmaStopped) return 4
    if (!parked) return 5
    // Pair descriptor/payload observations with DMA completion before caller
    // reads data or returns storage. Internal SRAM only; no cache maintenance.
    esp32s3GdmaPublish()
    1
}

// Start statuses (low8):1 started,2 invalid,3 DMA busy,4 I2S reset failure,
// 5 DMA configuration failure,6 stale-event clear failure,7 DMA start failure,
// 8 I2S start/latch failure. For8, bits8..15 hold StopStream's cleanup status.
// A failed cleanup retains all DMA storage/ownership; never free it blindly.
trusted fun esp32s3I2sStartStream(port: int, transmit: bool, channel: int,
    descriptor: int, polls: int): int {
    if (port < 0 || port > 1 || channel < 0 || channel > 4 || polls < 1 || polls > 1000000 ||
        !esp32s3GdmaDescriptorValid(descriptor)) return 2
    if (!esp32s3GdmaParked(channel, transmit)) return 3
    if (!esp32s3I2sResetDirection(port, transmit)) return 4
    if (!esp32s3GdmaConfigureI2s(channel, transmit, port, descriptor)) return 5
    if (!esp32s3GdmaAcknowledge(channel, transmit, esp32s3GdmaEventMask(transmit))) return 6
    if (!esp32s3GdmaStart(channel, transmit)) return 7
    if (!esp32s3I2sStartDirection(port, transmit, polls)) {
        val cleanup = esp32s3I2sStopStream(port, transmit, channel, polls)
        return 8 | (cleanup << 8)
    }
    1
}
