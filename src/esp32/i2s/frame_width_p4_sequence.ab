// IDF6 P4 hw_ver1 and hw_ver3 agree. Standard two-slot frames only.
// P4 CONF1 differs from S3; MSB shift lives in CONF, not CONF1.
fun esp32p4I2sFrameWidthWord(dataBits: int, slotBits: int, wsWidth: int): int {
    if ((dataBits != 8 && dataBits != 16 && dataBits != 24 && dataBits != 32) ||
        slotBits < dataBits || slotBits > 32 || wsWidth < 1 || wsWidth > slotBits * 2) return -1
    (wsWidth - 1) | ((dataBits - 1) << 14) | ((slotBits - 1) << 19) | ((slotBits - 1) << 27)
}

// Own both directions, their clock configuration, and all register writers.
// Peripheral clock must already be enabled. No start/update/reset or rollback.
// 1 configured, 2 invalid/unowned, 3 running/updating/reset, 4 width readback,
// 5 shift readback. On 4/5 keep ownership: configuration may be partial.
trusted fun esp32p4I2sSetFrameWidthsOwned(port: int, transmit: bool, dataBits: int,
    slotBits: int, wsWidth: int, philipsShift: bool, exclusive: bool): int {
    val word = esp32p4I2sFrameWidthWord(dataBits, slotBits, wsWidth)
    if (!exclusive || port < 0 || port > 2 || word < 0) return 2
    val base = 0x500c6000 + port * 4096
    if (((p4I2sFrameRead(base + 32) | p4I2sFrameRead(base + 36)) & 263) != 0) return 3
    val conf = base + (if (transmit) 36 else 32)
    val frame = conf + 8
    // Preserve reserved CONF1 bits 9..13; all other fields are widths.
    val mask = 0xffffc1ff
    p4I2sFrameWrite(frame, (p4I2sFrameRead(frame) & (0xffffffff ^ mask)) | word)
    if ((p4I2sFrameRead(frame) & mask) != word) return 4
    val shift = if (philipsShift) 8192 else 0
    p4I2sFrameWrite(conf, (p4I2sFrameRead(conf) & 0xffffdfff) | shift)
    if ((p4I2sFrameRead(conf) & 8192) != shift) return 5
    return 1
}
