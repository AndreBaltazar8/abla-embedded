import "./buzzer_stream_c6_sequence.ab"
import "./stream_drain_c6_sequence.ab"
// Render one final full block, copy it into the CPU-owned tail and hand it to
// graceful drain. Sources shorter than a block use the mixer's silence fill.
// Drain must be fresh zeroed64B, retained and disjoint from all source/workspaces.
// Returns5pending (including DMA-owned),2invalid,3failure. Once drain is bound,
// only call c6I2sStreamDrainPollOwned; do not refill or render again. Staging is
// retained until the drain completes, then release producer with consumerJoined.
// This intentionally does not close platform/config or discard on failure.
trusted fun c6BuzzerStreamEndBeginOwned(r: NativeBuffer,q: NativeBuffer,d: NativeBuffer,producer: NativeBuffer,sources: PcmSourceQueues,configuredRate: int,accumulator: NativeBuffer,scratch: NativeBuffer,mono: NativeBuffer,staging: NativeBuffer,volume: PcmVolume,exclusive: bool): int {
    if (!exclusive || !c6I2sStreamLayout(r,q) || !c6I2sStreamDrainLayout(r,q,d) || d.loadU32(0) != 0) return 2
    val bytes=r.loadU32(36);val frames=bytes>>>2
    if (!sources.valid() || !sources.disjointFrom(d,64) || pcmMixSpansOverlap(d,64,producer,24) ||
        pcmMixSpansOverlap(d,64,accumulator,frames*8) || pcmMixSpansOverlap(d,64,scratch,frames*4) ||
        pcmMixSpansOverlap(d,64,mono,frames*2) || pcmMixSpansOverlap(d,64,staging,bytes)) return 2
    val prepared=c6BuzzerStreamPrepareOwned(r,q,producer,sources,configuredRate,accumulator,scratch,mono,staging,volume,true)
    if (prepared != 1) return prepared
    return c6I2sStreamDrainBeginOwned(r,q,d,true,true)
}
