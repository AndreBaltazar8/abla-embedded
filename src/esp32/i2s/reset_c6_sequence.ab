import "./update_c6_sequence.ab"
// Explicit destructive initialization, never ordinary stop/cleanup. Caller
// owns both directions, has joined GDMA/ETM/IRQ users and accepts FIFO loss.
// selection: 1 direction reset, 2 FIFO reset, 3 direction then FIFO.
// Returns 1 sequence submitted, 2 invalid, 3 clock, 4 busy, 5 readback failure.
// Reset bits are WT: a high readback is not required. Like the vendor LL,
// submission assumes functioning MMIO; readback cannot prove a pulse arrived.
// Publish a fresh configuration UPDATE after reset, before starting.
trusted fun c6I2sResetOwned(port: int,tx: bool,selection: int,exclusive: bool,discard: bool): int {
    if (!exclusive || !discard || port != 0 || selection < 1 || selection > 3) return 2
    if (!c6I2sUpdateClocks(tx)) return 3
    if (!c6I2sStopped()) return 4
    val at=if (tx) 0x24 else 0x20
    var bit=u32(1)
    while (bit <= u32(2)) {
        if ((u32(selection)&bit) != u32(0)) {
            val before=c6I2sRead(at)
            c6I2sWrite(at,before|bit)
            // Always lower even when assertion is already self-cleared.
            c6I2sWrite(at,c6I2sRead(at)&~bit)
            if (c6I2sRead(at) != before) return 5
        }
        bit=bit<<u32(1)
    }
    return 1
}
// Recovery for a failed deassertion; no new pulse and no START/UPDATE.
// This releases reset only, not proof of a successful initialization.
trusted fun c6I2sResetReleaseOwned(port: int,tx: bool,exclusive: bool): int {
    if (!exclusive || port != 0) return 2
    if (!c6I2sUpdateClocks(tx)) return 3
    val at=if (tx) 0x24 else 0x20
    val before=c6I2sRead(at)
    if ((before&u32(0x104)) != u32(0) || (c6I2sRead(if (tx) 0x20 else 0x24)&u32(0x107)) != u32(0) || c6I2sRead(0x14) != u32(0)) return 4
    val released=before&~u32(3)
    if (released != before) c6I2sWrite(at,released)
    return if (c6I2sRead(at) == released) 1 else 5
}
