import "abla/unsafe/mmio"
import "./clock_divider_esp32s3.ab"
import "./clock_choice_esp32s3.ab"
import "./clock_control_esp32s3.ab"
import "./frame_width_esp32s3.ab"
import "./standard_mode_esp32s3.ab"
import "./transfer_control_esp32s3.ab"
trusted fun esp32s3I2sClockRead(address: int): int = mmioLoadU32(address)
trusted fun esp32s3I2sClockField(address: int, mask: int, value: int): void =
    mmioStoreU32(address, (mmioLoadU32(address) & (0xffffffff ^ mask)) | value)

// Same ownership/clock/latch prerequisites as SetDivider. Returns the chosen
// coefficients (and rounded actual frequency), never silently claims an exact
// requested rate when the hardware can only approximate it.
trusted fun esp32s3I2sSetFrequency(port: int, transmit: bool, sourceHz: int,
    requestedHz: int): Esp32S3I2sDivider {
    if (port < 0 || port > 1) return Esp32S3I2sDivider(0)
    val divider = esp32s3I2sChooseDivider(sourceHz, requestedHz)
    if (!divider.valid()) return divider
    if (!esp32s3I2sSetDivider(port, transmit, divider.integer(),
        divider.numerator(), divider.denominator())) return Esp32S3I2sDivider(0)
    divider
}
