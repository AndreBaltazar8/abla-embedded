// Scalar divider, no heap/runtime dependencies: N:8, b:9, a:9 bits.
// Zero is invalid. Construct through esp32s3I2sChooseDivider.
type Esp32S3I2sDivider = int
fun Esp32S3I2sDivider.valid(): bool = this != 0
fun Esp32S3I2sDivider.integer(): int = this & 255
fun Esp32S3I2sDivider.numerator(): int = (this >>> 8) & 511
fun Esp32S3I2sDivider.denominator(): int = (this >>> 17) & 511
fun Esp32S3I2sDivider.frequency(sourceHz: int): int {
    if (!this.valid() || sourceHz < 1 || sourceHz > 4294967295) return 0
    val divisor = this.integer() * this.denominator() + this.numerator()
    // Quotient/remainder decomposition keeps both divisions native u32.
    // remainder*denominator is <130816*511, safely below 2^32.
    val quotient = int(u32(sourceHz) / u32(divisor))
    val remainder = int(u32(sourceHz) % u32(divisor))
    quotient * this.denominator() + int(u32(remainder * this.denominator() + divisor / 2) / u32(divisor))
}

// Search the hardware's bounded fraction space using exact integer error
// comparisons in Hz, not rounded divider error. For each denominator only
// the two divisors bracketing the requested frequency can be optimal.
// Ascending denominators give simpler fractions precedence on exact ties.
fun esp32s3I2sChooseDivider(sourceHz: int, requestedHz: int): Esp32S3I2sDivider {
    if (sourceHz < 1 || sourceHz > 4294967295 || requestedHz < 1 ||
        requestedHz > 4294967295 || sourceHz < requestedHz * 2 ||
        sourceHz >= requestedHz * 256) return Esp32S3I2sDivider(0)
    var best = 0
    var bestError = 0
    var bestDivisor = 1
    val integerStep = int(u32(sourceHz) / u32(requestedHz))
    val remainderStep = int(u32(sourceHz) % u32(requestedHz))
    var lower = integerStep
    var remainder = remainderStep
    var denominator = 1
    while (denominator <= 511) {
        val scaled = sourceHz * denominator
        var side = 0
        while (side < 2) {
            var divisor = lower + side
            if (divisor < 2 * denominator) divisor = 2 * denominator
            if (divisor >= 256 * denominator) divisor = 256 * denominator - 1
            val difference = scaled - requestedHz * divisor
            val error = if (difference < 0) -difference else difference
            // Inputs are bounded u32 and the desired ratio is [2,256).
            // Candidate errors <2*requestedHz; cross-products fit signed64.
            if (best == 0 || error * bestDivisor < bestError * divisor) {
                best = int(u32(divisor) / u32(denominator)) | (int(u32(divisor) % u32(denominator)) << 8) | (denominator << 17)
                bestError = error
                bestDivisor = divisor
            }
            side = side + 1
        }
        if (bestError == 0) return Esp32S3I2sDivider(best)
        denominator = denominator + 1
        // Advance floor(sourceHz*a/requestedHz) without wide division.
        lower = lower + integerStep
        remainder = remainder + remainderStep
        if (remainder >= requestedHz) {
            remainder = remainder - requestedHz
            lower = lower + 1
        }
    }
    Esp32S3I2sDivider(best)
}
