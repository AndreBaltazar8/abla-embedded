import "./standard_session_c6_sequence.ab"
import "./rx_eof_c6_sequence.ab"
import "../gdma_rx_channel_c6_sequence.ab"
// RX-only72B:tag0,state4,primary8,channel64@12,EOFtoken20,reserved24,
// standard44@28. EOF length is published with format UPDATE and restored
// BEFORE the reverse UPDATE; never modify it while UPDATE is pending.
// States1ready4partial5pending6closed7closing. Returns1ready2invalid3admission
// 4partial5pending6closed. Caller owns stopped I2S, codec, GDMA, IRQ and ETM;
// clocks and initialized FIFOs remain pinned. No reset, discard, start or ack.
// As with the underlying C6 UPDATE primitive, completion assumes delivery of
// MMIO writes: a lost self-clearing UPDATE cannot be distinguished from an
// immediately completed one. Register readback does not prove live latch state.
fun c6I2sRxDmaConfigStorage(r: NativeBuffer): bool = r.hasAddressRange(0,72) && (r.addressValue()&3) == 0 && (r.addressValue()+72 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun c6I2sRxDmaConfigSave(r: NativeBuffer,dma: C6GdmaRxChannel): void { r.storeU32(12,dma|0);r.storeU32(16,dma>>>32);return }
trusted fun c6I2sRxDmaConfigOpenOwned(r: NativeBuffer,channel: int,bytes: int,dataBits: int,slotBits: int,wsWidth: int,shift: bool,polls: int,exclusive: bool,slave: bool=false,stopMode: int=0): int {
    if (!exclusive || !c6I2sRxDmaConfigStorage(r) || r.loadU32(0) != 0 || channel < 0 || channel > 2 || bytes < 1 || bytes > 4095 || stopMode < 0 || stopMode > 2 || polls < 1 || polls > 1000000 || c6I2sStereoFrameWord(dataBits,slotBits,wsWidth,shift) < 0) return 2
    if (!c6I2sUpdateClocks(false) || !c6I2sStopped() || !c6GdmaClocksReady() || !c6GdmaRxParked(channel)) return 3
    var at=0
    while (at < 72) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x4336524f);r.storeU32(4,4)
    val dma=c6GdmaRxChannelOpenOwned(channel,3,true)
    c6I2sRxDmaConfigSave(r,dma)
    if (dma.status() != 1) { r.storeU32(8,0x10000|dma.status());return 4 }
    val eof=c6I2sRxEofOpenOwned(0,bytes,true)
    r.storeU32(20,eof|0)
    if (eof.status() != 1) { r.storeU32(8,0x30000|eof.status());return 4 }
    val result=c6I2sStandardOpenOwned(nativeBufferAt(r.addressValue()+28,44),dataBits,slotBits,wsWidth,shift,polls,true,false,slave,stopMode)
    if (result == 4) { r.storeU32(4,5);return 5 }
    if (result != 1) { r.storeU32(8,0x20000|result);return 4 }
    r.storeU32(4,1);return 1
}
trusted fun c6I2sRxDmaConfigWaitOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6I2sRxDmaConfigStorage(r) || r.loadU32(0) != 0x4336524f || r.loadU32(4) != 5 || polls < 1 || polls > 1000000) return 2
    val result=c6I2sStandardWaitOwned(nativeBufferAt(r.addressValue()+28,44),polls,true)
    if (result == 4) return 5
    if (result != 1) { r.storeU32(8,0x20000|result);r.storeU32(4,4);return 4 }
    r.storeU32(4,1);return 1
}
trusted fun c6I2sRxDmaConfigCloseOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6I2sRxDmaConfigStorage(r) || r.loadU32(0) != 0x4336524f || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 6) return 6
    r.storeU32(4,7)
    var dma=C6GdmaRxChannel(r.loadU32(12)|(r.loadU32(16)<<32))
    // Joining DMA/events precedes any format restoration, even on partial open.
    if ((dma&(1<<49)) != 0 && (!c6GdmaClocksReady() || !c6GdmaRxParked((dma>>>47)&3))) return 3
    val standard=nativeBufferAt(r.addressValue()+28,44)
    if (standard.loadU32(0) != 0 && standard.loadU32(40) == 1) {
        val joined=c6I2sStandardWaitOwned(standard,polls,true)
        if (joined != 1) return if (joined == 4) 5 else 4
    }
    var eof=C6I2sRxEof(r.loadU32(20))
    if ((eof&(1<<20)) != 0 && eof.status() != 6) {
        eof=eof.closeOwned(true);r.storeU32(20,eof|0)
        if (eof.status() != 6) return 4
    }
    if (standard.loadU32(0) != 0) {
        val result=c6I2sStandardCloseOwned(standard,polls,true)
        if (result != 5) return if (result == 4) 5 else 4
    }
    if ((dma&(1<<49)) != 0 && dma.status() != 6) {
        dma=dma.closeOwned(true);c6I2sRxDmaConfigSave(r,dma)
        if (dma.status() != 6) return 4
    }
    r.storeU32(4,6);return 6
}
