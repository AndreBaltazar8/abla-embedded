import "./audio_setup_c6_sequence.ab"
import "./rate_plan_c6.ab"
// Plan before writes. rootHz must describe the caller-pinned selected source.
// No source switch, resampling or implicit codec configuration. Caller must
// choose fixedBclk when an external codec constrains the MCLK ratio.
trusted fun c6AudioSetupAtRateOwned(r: NativeBuffer,channel: int,source: int,rootHz: int,rateHz: int,fixedBclk: int,maxPpm: int,bclk: int,ws: int,data: int,mclk: int,dataBits: int,slotBits: int,wsWidth: int,shift: bool,polls: int,exclusive: bool): int {
    if (!exclusive || slotBits < 8 || slotBits > 32 || maxPpm < 0 || maxPpm > 10000) return 2
    val plan=c6I2sRatePlan(rootHz,rateHz,slotBits*2,fixedBclk)
    if (!plan.withinPpm(rootHz,rateHz,slotBits*2,maxPpm)) return 2
    return c6AudioSetupOpenOwned(r,channel,source,plan.integer(),plan.numerator(),plan.denominator(),plan.bclk(),bclk,ws,data,mclk,dataBits,slotBits,wsWidth,shift,polls,exclusive)
}
