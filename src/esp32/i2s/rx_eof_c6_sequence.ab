import "./update_c6_sequence.ab"
// IDF6 C6 LL547-550 and driver i2s_common.c553 pass DMA buffer BYTES
// directly to RXEOF_NUM[11:0], unlike the C5's wider16-bit field.
// Do not divide by four as classic ESP32 does. Generated register prose
// describes sample bits, but the executable C6 driver uses bytes unchanged.
// Caller owns stopped I2S/GDMA/ETM, pinned clocks and RX buffer lifetime.
// Snapshot old12bits@8,valid20. Status1ready2invalid3clock4busy5write6restored.
// Does not reset/start/update; publish configuration before starting RX.
type C6I2sRxEof=int
fun C6I2sRxEof.status(): int = this&255
trusted fun c6I2sRxEofField(value: u32): bool {
    val before=c6I2sRead(0x64)
    if ((before&u32(4095)) != value) c6I2sWrite(0x64,(before&~u32(4095))|value)
    return (c6I2sRead(0x64)&u32(4095)) == value
}
trusted fun c6I2sRxEofOpenOwned(port: int,bytes: int,exclusive: bool): C6I2sRxEof {
    if (!exclusive || port != 0 || bytes < 1 || bytes > 4095) return C6I2sRxEof(2)
    if (!c6I2sUpdateClocks(false)) return C6I2sRxEof(3)
    if (!c6I2sStopped()) return C6I2sRxEof(4)
    val token=(1<<20)|(int(c6I2sRead(0x64)&u32(4095))<<8)
    return C6I2sRxEof(token|(if (c6I2sRxEofField(u32(bytes))) 1 else 5))
}
trusted fun C6I2sRxEof.closeOwned(exclusive: bool): C6I2sRxEof {
    if (!exclusive || this < 0 || (this&~0x1fffff) != 0 || (this&(1<<20)) == 0 || (this.status() != 1 && this.status() != 3 && this.status() != 4 && this.status() != 5)) return this
    val token=this&~255
    if (!c6I2sUpdateClocks(false)) return C6I2sRxEof(token|3)
    if (!c6I2sStopped()) return C6I2sRxEof(token|4)
    return C6I2sRxEof(token|(if (c6I2sRxEofField(u32((token>>>8)&4095))) 6 else 5))
}
