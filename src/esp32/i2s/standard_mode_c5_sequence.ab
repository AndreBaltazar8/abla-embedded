import "./clock_c5_sequence.ab"
// Standard two-slot API flags: mono0,slave1,WS-high-first2,LSB-first3,
// left-align4,big-endian5. Slots1left,2right,3both. C5 LL/HAL v6.0.2.
fun c5I2sStandardConfigWord(transmit: bool,slots: int,flags: int): int {
    if (slots < 1 || slots > 3 || flags < 0 || flags > 63) return -1
    val mono=(flags&1) != 0
    return 0x80000|((flags&2)<<2)|((flags&4)<<15)|((flags&8)<<15)|((flags&16)<<11)|((flags&32)<<2)|
        (if (transmit) (if (mono && slots == 3) 96 else 0) else (if (mono) 576 else 0))
}
fun c5I2sStandardSlotWord(transmit: bool,slots: int,flags: int): int {
    if (slots < 1 || slots > 3 || flags < 0 || flags > 63) return -1
    val mono=(flags&1) != 0
    return 65536|(if (transmit && mono && slots == 3) 1 else slots)|
        (if (transmit && !mono && slots != 3) 0x100000 else 0)
}
trusted fun c5I2sModeField(offset: int,mask: u32,value: u32): bool {
    val old=c5I2sRead(offset)
    if ((old&mask) != value) c5I2sWrite(offset,(old&~mask)|value)
    return (c5I2sRead(offset)&mask) == value
}
// Caller owns both stopped directions/DMA/ETM/IRQs/codec clock consumers.
// Clock/widths/Philips shift/PCM companding/FIFO/pins separate; no reset or
// UPDATE/start here. Failure retains partial config: caller must retry/restore.
// C5 RX enable_std only switches PDM/TDM bits; unlike P4 no extra RX converter
// register is touched. TX additionally disables PCM2PDM bit25 at0x40.
// Returns1configured2invalid3clock4busy5CONF6slots7converterreadbackfailure.
trusted fun c5I2sSetStandardModeOwned(port: int,transmit: bool,slots: int,flags: int,exclusive: bool): int {
    val word=c5I2sStandardConfigWord(transmit,slots,flags)
    if (!exclusive || port != 0 || word < 0) return 2
    if ((c5I2sClockRead(0)&u32(15)) != u32(13)) return 3
    if (!c5I2sStopped()) return 4
    val mask=u32(0x1e80c8)|(if (transmit) u32(32) else u32(512))
    if (!c5I2sModeField(if (transmit) 0x24 else 0x20,mask,u32(word))) return 5
    if (!c5I2sModeField(if (transmit) 0x54 else 0x50,if (transmit) u32(0x1fffff) else u32(0xfffff),u32(c5I2sStandardSlotWord(transmit,slots,flags)))) return 6
    if (transmit && !c5I2sModeField(0x40,u32(0x2000000),u32(0))) return 7
    return 1
}
