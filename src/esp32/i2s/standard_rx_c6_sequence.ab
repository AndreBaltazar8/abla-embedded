import "./standard_tx_c6_sequence.ab"
// C6 RX CONF20,CONF1@28,TDM50. RX has STOP_MODE13..14, mono5,
// first-valid9 and no TX channel-equal/skip-mask or PCM2PDM register.
// Both stereo slots, MSB-first, little-endian, left-aligned, PCM bypass.
// stopMode0 explicit stop,1 RX successful EOF,2 FIFO full. Caller chooses
// this consistently with finite/circular DMA and owns both stopped directions,
// joined DMA/IRQ/ETM, codec and stable APB/RX clock for the entire operation.
// No clocks/reset/UPDATE/start/EOF-length configuration. Partial writes retained.
//1configured2invalid3clock4busy5CONF6frame7slots readback failure.
trusted fun c6I2sConfigureStereoRxOwned(dataBits: int,slotBits: int,wsWidth: int,philips: bool,exclusive: bool,slave: bool=false,stopMode: int=0): int {
    val frame=c6I2sStereoFrameWord(dataBits,slotBits,wsWidth,philips)
    if (!exclusive || frame < 0 || stopMode < 0 || stopMode > 2) return 2
    if ((c6I2sClockRead(0)&u32(3)) != u32(1) || (c6I2sClockRead(12)&u32(0x400000)) == u32(0)) return 3
    if (c6I2sRead(0x14) != u32(0) || ((c6I2sRead(0x20)|c6I2sRead(0x24))&u32(0x107)) != u32(0) ||
        (c6I2sRead(0x24)&u32(0x8000000)) != u32(0) || (c6I2sRead(0x6c)&u32(1)) == u32(0)) return 4
    if (!c6I2sTxField(0x20,u32(0x1ffea8),u32(0x89000)|(u32(stopMode)<<u32(13))|(if (slave) u32(8) else u32(0)))) return 5
    if (!c6I2sTxField(0x28,u32(0x3fffe07f),u32(frame))) return 6
    if (!c6I2sTxField(0x50,u32(0xfffff),u32(0x10003))) return 7
    return 1
}
