import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkI2sHalOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredI2sHalCalcMclkPreciseDivision", "i2s_hal_calc_mclk_precise_division")) return false
    if (!internalFunction("esp32RecoveredI2sHalInit", "i2s_hal_init")) return false
    if (!internalFunction("esp32RecoveredI2sHalSetTxClock", "i2s_hal_set_tx_clock")) return false
    if (!internalFunction("esp32RecoveredI2sHalSetRxClock", "_i2s_hal_set_rx_clock")) return false
    if (!internalFunction("esp32RecoveredI2sHalStdSetTxSlot", "i2s_hal_std_set_tx_slot")) return false
    if (!internalFunction("esp32RecoveredI2sHalStdSetRxSlot", "i2s_hal_std_set_rx_slot")) return false
    if (!internalFunction("esp32RecoveredI2sHalStdEnableTxChannel", "i2s_hal_std_enable_tx_channel")) return false
    if (!internalFunction("esp32RecoveredI2sHalStdEnableRxChannel", "i2s_hal_std_enable_rx_channel")) return false
    if (!internalFunction("esp32RecoveredI2sHalPdmSetTxSlot", "i2s_hal_pdm_set_tx_slot")) return false
    if (!internalFunction("esp32RecoveredI2sHalPdmEnableTxChannel", "i2s_hal_pdm_enable_tx_channel")) return false
    if (!internalFunction("esp32RecoveredI2sHalPdmSetRxSlot", "i2s_hal_pdm_set_rx_slot")) return false
    if (!internalFunction("esp32RecoveredI2sHalPdmEnableRxChannel", "i2s_hal_pdm_enable_rx_channel")) return false
    true
}
