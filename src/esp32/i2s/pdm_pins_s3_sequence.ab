import "../../audio/pdm_pins.ab"
fun esp32s3PdmInputSignal(line: int): int = if (line == 0) 25 else if (line >= 1 && line <= 3) 50+line else -1
fun esp32s3PdmPinsValid(port: int,pins: PdmPins,slots: int,slave: bool): bool {
    if (port != 0 || !pins.valid() || slots < 1 || slots > 255) return false
    val clock=Pin(pins.clockPin())
    if (!(if (slave) clock.valid() else clock.outputCapable())) return false
    var line=0
    while (line < 4) {
        if ((slots&(3<<(line*2))) != 0) {
            val number=pins.dataPin(line)
            if (!Pin(number).valid() || number == clock.number()) return false
            var previous=0
            while (previous < line) {
                if ((slots&(3<<(previous*2))) != 0 && pins.dataPin(previous) == number) return false
                previous=previous+1
            }
        }
        line=line+1
    }
    return true
}
// Own stopped I2S0 RX/GDMA, old/new global-input consumers and all active pads,
// released from RTC/USB/holds/sleep. Only active data lines are touched; clock
// is routed LAST using RX WS signal27 (not BCLK26). No duplex loopback/MCLK
// rebinding or pin snapshot implied; retain ownership after partial failure.
// Status1 routed,2 invalid,3..6 corresponding data-line failure,7 clock failure.
trusted fun esp32s3PdmRoutePinsOwned(port: int,pins: PdmPins,slots: int,slave: bool,invertClock: bool): int {
    if (!esp32s3PdmPinsValid(port,pins,slots,slave)) return 2
    var line=0
    while (line < 4) {
        if ((slots&(3<<(line*2))) != 0 && !Pin(pins.dataPin(line)).routeInputSignal(esp32s3PdmInputSignal(line),false)) return 3+line
        line=line+1
    }
    val clock=Pin(pins.clockPin())
    val ready=if (slave) clock.routeInputSignal(27,invertClock) else clock.routeOutputSignal(27,invertClock)
    return if (ready) 1 else 7
}
