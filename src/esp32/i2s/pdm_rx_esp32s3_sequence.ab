// ESP32-S3 PDM RX, I2S0 only. Based on pinned ESP-IDF i2s_hal_pdm_set_rx_slot
// and esp32s3 i2s_ll.h. Slots0..7 represent rising/falling edges on four data
// lines; the mask directly selects channels, rather than enabling RX_MONO.
// Caller owns reset/quiescent RX and parked DMA; clocks, pins, EOF size and
// final configuration latch are separate. No hidden reset/start/allocation.
trusted fun esp32s3I2sSetPdmReceiveMode(port: int,slots: int,pcm: bool,downsample128: bool,slave: bool): bool {
    if (port != 0 || slots < 1 || slots > 255) return false
    val config=0x6000f020
    if ((esp32s3I2sClockRead(config)&260) != 0) return false
    val mask=(15<<19)|512|32|8
    val word=(1<<20)|(if (pcm) 1<<21 else 0)|(if (downsample128) 1<<22 else 0)|(if (slave) 8 else 0)
    // Set16-bit data/slot and half-sample widths, preserving BCLK divider.
    val widthMask=(31<<13)|(63<<18)|(31<<24)
    val width=(15<<13)|(15<<18)|(15<<24)
    esp32s3I2sClockField(0x6000f028,widthMask,width)
    if ((esp32s3I2sClockRead(0x6000f028)&widthMask) != width) return false
    esp32s3I2sClockField(0x6000f050,65535,slots)
    if ((esp32s3I2sClockRead(0x6000f050)&65535) != slots) return false
    esp32s3I2sClockField(config,mask,word)
    return (esp32s3I2sClockRead(config)&mask) == word
}

import "./pdm_clock_s3.ab"
