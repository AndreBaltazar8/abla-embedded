import "abla/runtime/scalar"
// C6 I2S0 only. PCR6c bus/reset,70 TXclock,78 RXclock; NO ready bits.
// Source mapping follows IDF6 C6 i2s_ll.h (register prose is stale).
// Caller owns both directions/GDMA/ETM/IRQs/MCLK consumers, keeps root clocks
// and peripheral domain stable, stopped/settled users and safe codec/pads.
// Sources0XTAL/1PLL240/2PLL160/3externalMCLK already selected/pinned.
// No reset/source/divider/MCLK-route changes. This is not audio configuration.
// status0closed1ready2invalid3reset/source4bus5sourcechanged6busy7TX8RX.
// Attempted ownership bits8bus9TX10RX; source snapshots11..14,directions15..16; retain token on every partialfailure.
type C6I2sClock=int
fun C6I2sClock.status(): int = this&255
fun C6I2sClock.ready(): bool = this.status() == 1
trusted fun c6I2sClockField(offset: int,mask: u32,value: u32): bool {
    val old=c6I2sClockRead(offset)
    if ((old&mask) != value) c6I2sClockWrite(offset,(old&~mask)|value)
    return (c6I2sClockRead(offset)&mask) == value
}
trusted fun c6I2sStopped(): bool = c6I2sRead(0x14) == u32(0) &&
    ((c6I2sRead(0x20)|c6I2sRead(0x24))&u32(0x107)) == u32(0) &&
    (c6I2sRead(0x6c)&u32(1)) != u32(0)
trusted fun c6I2sClockOpenOwned(port: int,directions: int,txSource: int,rxSource: int,exclusive: bool): C6I2sClock {
    if (!exclusive || port != 0 || directions < 1 || directions > 3 || txSource < 0 || txSource > 3 || rxSource < 0 || rxSource > 3) return C6I2sClock(2)
    val bus=c6I2sClockRead(0)
    val tx=c6I2sClockRead(4);val rx=c6I2sClockRead(12)
    if ((bus&u32(2)) != u32(0) || ((directions&1) != 0 && int((tx>>u32(20))&u32(3)) != txSource) ||
        ((directions&2) != 0 && int((rx>>u32(20))&u32(3)) != rxSource)) return C6I2sClock(3)
    var token=(txSource<<11)|(rxSource<<13)|(directions<<15)
    if ((bus&u32(1)) == u32(0)) {
        token=token|256
        if (!c6I2sClockField(0,u32(1),u32(1))) return C6I2sClock(token|4)
    }
    if (!c6I2sStopped()) return C6I2sClock(token|6)
    if ((directions&1) != 0 && (tx&u32(0x400000)) == u32(0)) {
        token=token|512
        if (!c6I2sClockField(4,u32(0x400000),u32(0x400000))) return C6I2sClock(token|7)
    }
    if ((directions&2) != 0 && (rx&u32(0x400000)) == u32(0)) {
        token=token|1024
        if (!c6I2sClockField(12,u32(0x400000),u32(0x400000))) return C6I2sClock(token|8)
    }
    if (!c6I2sSourcesMatch(token)) return C6I2sClock(token|5)
    return C6I2sClock(token|1)
}
trusted fun C6I2sClock.closeOwned(exclusive: bool): C6I2sClock {
    if (!exclusive || this < 0 || (this&~131071) != 0 || this.status() > 8 || this.status() == 0) return this
    var token=this&130816
    if ((token&1792) == 0) return C6I2sClock(0)
    if (!c6I2sSourcesMatch(token)) return C6I2sClock(token|5)
    val bus=c6I2sClockRead(0)
    if ((bus&u32(2)) != u32(0)) return C6I2sClock(token|6)
    if ((bus&u32(1)) == u32(1)) {
        if (!c6I2sStopped()) return C6I2sClock(token|6)
    } else if ((token&1536) != 0 || this.ready()) return C6I2sClock(token|6)
    if ((token&1024) != 0) {
        if (!c6I2sClockField(12,u32(0x400000),u32(0))) return C6I2sClock(token|8)
        token=token&~1024
    }
    if ((token&512) != 0) {
        if (!c6I2sClockField(4,u32(0x400000),u32(0))) return C6I2sClock(token|7)
        token=token&~512
    }
    if ((token&256) != 0 && !c6I2sClockField(0,u32(1),u32(0))) return C6I2sClock(token|4)
    return C6I2sClock(0)
}

trusted fun c6I2sSourcesMatch(token: int): bool =
    (((token>>>15)&1) == 0 || int((c6I2sClockRead(4)>>u32(20))&u32(3)) == ((token>>>11)&3)) &&
    (((token>>>16)&1) == 0 || int((c6I2sClockRead(12)>>u32(20))&u32(3)) == ((token>>>13)&3))
