import "abla/runtime/scalar"
// Standard two-slot flags match S3 API: mono, slave, WS-high-first,
// LSB-first, left-align, big-endian (bits0..5). Slots1 left,2 right,3 both.
// P4 RX mono is CONF6, not S3 CONF5. RX conversion has a separate enable.
fun esp32p4I2sStandardConfigWord(transmit: bool, slots: int, flags: int): int {
    if (slots < 1 || slots > 3 || flags < 0 || flags > 63) return -1
    val mono=(flags & 1) != 0
    0x80000 | ((flags & 2) << 2) | ((flags & 4) << 15) |
        ((flags & 8) << 15) | ((flags & 16) << 11) | ((flags & 32) << 2) |
        (if (transmit) (if (mono && slots == 3) 96 else 0) else (if (mono) 576 else 0))
}
fun esp32p4I2sStandardSlotWord(transmit: bool, slots: int, flags: int): int {
    if (slots < 1 || slots > 3 || flags < 0 || flags > 63) return -1
    val mono=(flags & 1) != 0
    65536 | (if (transmit && mono && slots == 3) 1 else slots) |
        (if (transmit && !mono && slots != 3) 0x100000 else 0)
}
// Own clocked port and both stopped directions/DMA. Reset/FIFO/PCM format,
// widths/Philips shift, clocks and pins are separate; latch only after all setup.
// 1 configured, 2 invalid/unowned, 3 bus off, 4 active/reset/update,
// 5 CONF readback, 6 slots readback, 7 converter-disable readback.
// Partial failure retains ownership; no implicit reset or rollback.
trusted fun esp32p4I2sSetStandardModeOwned(port: int, transmit: bool, slots: int,
    flags: int, exclusive: bool): int {
    val word=esp32p4I2sStandardConfigWord(transmit,slots,flags)
    if (!exclusive || port < 0 || port > 2 || word < 0) return 2
    if ((p4I2sModeRead(0x500e601c) & int(u32(1) << u32(14+port))) == 0) return 3
    val base=0x500c6000+port*4096
    if (((p4I2sModeRead(base+32) | p4I2sModeRead(base+36)) & 263) != 0) return 4
    val conf=base+(if (transmit) 36 else 32)
    val mask=0x1e80c8 | (if (transmit) 32 else 512)
    if (!p4I2sModeField(conf,mask,word)) return 5
    if (!p4I2sModeField(base+(if (transmit) 84 else 80),
        if (transmit) 0x1fffff else 0xfffff,
        esp32p4I2sStandardSlotWord(transmit,slots,flags))) return 6
    if (!p4I2sModeField(base+(if (transmit) 64 else 72),
        if (transmit) 0x2000000 else 0x80000,0)) return 7
    return 1
}
trusted fun p4I2sModeField(address: int, mask: int, value: int): bool {
    p4I2sModeWrite(address,(p4I2sModeRead(address) & (0xffffffff ^ mask)) | value)
    return (p4I2sModeRead(address) & mask) == value
}
