import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "./clock_c5_sequence.ab"
trusted fun c5I2sClockRead(offset: int): u32 = u32(mmioLoadU32(0x60096074+offset))
trusted fun c5I2sClockWrite(offset: int,value: u32): void { mmioStoreU32(0x60096074+offset,int(value));return }
trusted fun c5I2sRead(offset: int): u32 = u32(mmioLoadU32(0x6000c000+offset))
trusted fun c5I2sWrite(offset: int,value: u32): void { mmioStoreU32(0x6000c000+offset,int(value));return }
