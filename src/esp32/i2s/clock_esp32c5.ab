import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "./clock_c5_sequence.ab"
import "../../hal/esp32_i2s.ab"
@export("c5I2sClockRead")
trusted fun c5I2sClockReadHook(offset: int): u32 = u32(mmioLoadU32(0x60096074+offset))
@export("c5I2sClockWrite")
trusted fun c5I2sClockWriteHook(offset: int,value: u32): void { mmioStoreU32(0x60096074+offset,int(value));return }
@export("c5I2sRead")
trusted fun c5I2sReadHook(offset: int): u32 = u32(mmioLoadU32(0x6000c000+offset))
@export("c5I2sWrite")
trusted fun c5I2sWriteHook(offset: int,value: u32): void { mmioStoreU32(0x6000c000+offset,int(value));return }
