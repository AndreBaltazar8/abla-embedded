// Standard two-slot mode flags: bit0 mono,1 slave,2 WS-high-first,
// 3 LSB-first,4 left-align,5 big-endian. Slot mask:1 left,2 right,3 both.
// TX mono+both duplicates one sample; RX mono uses the first valid slot.
// These are internal register-profile helpers, not opaque runtime objects.
fun esp32s3I2sStandardConfigWord(transmit: bool, slots: int, flags: int): int {
    if (slots < 1 || slots > 3 || flags < 0 || flags > 63) return -1
    val mono = (flags & 1) != 0
    val copy = mono && slots == 3
    (1 << 19) | ((flags & 2) << 2) | ((flags & 4) << 15) |
        ((flags & 8) << 15) | ((flags & 16) << 11) | ((flags & 32) << 2) |
        (if (transmit) (if (copy) 96 else 0) else (if (mono) 544 else 0))
}
fun esp32s3I2sStandardSlotWord(transmit: bool, slots: int, flags: int): int {
    if (slots < 1 || slots > 3 || flags < 0 || flags > 63) return -1
    val mono = (flags & 1) != 0
    65536 | (if (transmit && mono && slots == 3) 1 else slots) |
        (if (transmit && !mono && slots != 3) 1 << 20 else 0)
}

// Caller owns/quiesces this direction and its DMA. Widths/clocks/pads and
// reset/FIFO lifecycle are separate; latch only after ALL setup succeeds.
trusted fun esp32s3I2sSetStandardMode(port: int, transmit: bool, slots: int, flags: int): bool {
    val word = esp32s3I2sStandardConfigWord(transmit, slots, flags)
    if (port < 0 || port > 1 || word < 0) return false
    val base = 0x6000f000 + port * 0x1e000
    val config = base + (if (transmit) 36 else 32)
    if ((esp32s3I2sClockRead(config) & 260) != 0) return false
    val commonMask = (1 << 20) | (1 << 19) | (1 << 18) | (1 << 17) | (1 << 15) | 128 | 32 | 8
    val mask = commonMask | (if (transmit) 64 else (1 << 21) | 512)
    esp32s3I2sClockField(config, mask, word)
    esp32s3I2sClockField(base + (if (transmit) 84 else 80),
        if (transmit) 0x1fffff else 0xfffff,
        esp32s3I2sStandardSlotWord(transmit, slots, flags))
    // TX PDM conversion has a separate enable; RX was cleared in config.
    if (transmit) esp32s3I2sClockField(base + 64, 1 << 25, 0)
    true
}
