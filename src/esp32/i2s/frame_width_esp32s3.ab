// Standard two-slot frame widths. Does not select active channels, mono
// duplication, master/slave, endian or WS polarity. No implicit start/latch.
// Both directions share clocks; caller owns/quiesces the port before setup.
fun esp32s3I2sFrameWidthWord(dataBits: int, slotBits: int, wsWidth: int, philipsShift: bool): int {
    if ((dataBits != 8 && dataBits != 16 && dataBits != 24 && dataBits != 32) ||
        slotBits < dataBits || slotBits > 32 || wsWidth < 1 || wsWidth > slotBits * 2) return -1
    (wsWidth - 1) | ((dataBits - 1) << 13) | ((slotBits - 1) << 18) |
        ((slotBits - 1) << 24) | (if (philipsShift) 1 << 29 else 0)
}

trusted fun esp32s3I2sSetFrameWidths(port: int, transmit: bool, dataBits: int,
    slotBits: int, wsWidth: int, philipsShift: bool): bool {
    val word = esp32s3I2sFrameWidthWord(dataBits, slotBits, wsWidth, philipsShift)
    if (port < 0 || port > 1 || word < 0) return false
    val base = 0x6000f000 + port * 0x1e000
    if (((esp32s3I2sClockRead(base + 32) | esp32s3I2sClockRead(base + 36)) & 260) != 0) return false
    // Preserve BCLK divisor and reserved/BCK_NO_DLY bits.
    esp32s3I2sClockField(base + (if (transmit) 44 else 40), 0x3fffe07f, word)
    true
}
