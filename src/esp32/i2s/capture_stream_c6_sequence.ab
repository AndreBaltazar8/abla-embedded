import "./capture_cancel_c6_sequence.ab"
import "./stream_rx_c6_sequence.ab"
// Uses existing364B capture session opened with circular=true and separate32B
// RX cursor. Caller retains exclusive buffers/codec/clocks and services before
// DMA laps the ring. No hidden acknowledgement, reset, or automatic restart.
// Return1CPU-owned block,5pending,3latched failure,2invalid. To stop, join all
// readers then use c6CaptureCancelOwned; cancellation is not a final capture.
trusted fun c6CaptureStreamLayout(r: NativeBuffer,q: NativeBuffer): bool =
    c6CaptureValid(r) && r.loadU32(260) == 1 && c6I2sRxStreamStorage(q) &&
    !(q.addressValue() < r.addressValue()+364 && r.addressValue() < q.addressValue()+32) &&
    !(q.addressValue() < r.loadU32(16)+r.loadU32(20)*12 && r.loadU32(16) < q.addressValue()+32) &&
    !(q.addressValue() < r.loadU32(24)+(r.loadU32(20)-1)*r.loadU32(28)+r.loadU32(32) && r.loadU32(24) < q.addressValue()+32)
// Check even when cursor already owns a block: acquire's cached ownership is
// not evidence that the peripheral remained healthy since the last call.
// No acknowledgement here; cancellation retains and handles raw events.
trusted fun c6CaptureStreamHealthy(r: NativeBuffer): bool {
    if (!c6I2sUpdateClocks(false) || c6I2sRead(0x14) != u32(0) || (c6I2sRead(0xc)&u32(4)) != u32(0)) {
        c6CaptureFail(r,0x50001);return false
    }
    if ((c6I2sRead(0x20)&u32(0x107)) != u32(4)) {
        c6CaptureFail(r,0x50003);return false
    }
    val events=c6GdmaEventsReadOwned(r.loadU32(36),false,true)
    if (events.status() != 1 || events.errors() != 0) {
        c6CaptureFail(r,0x50002);return false
    }
    return true
}
trusted fun c6CaptureStreamPollOwned(r: NativeBuffer,q: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6CaptureStreamLayout(r,q) || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 7) return 3
    val ready=c6CapturePollOwned(r,1,polls,true)
    if (ready == 5) return 5
    if (ready != 1) return if (ready == 3) 3 else 2
    if (!c6CaptureStreamHealthy(r)) return 3
    val acquired=c6I2sRxStreamAcquireOwned(nativeBufferAt(r.addressValue()+220,72),q,true)
    if (acquired == 3) return c6CaptureFail(r,0x50002)
    if (!c6CaptureStreamHealthy(r)) return 3
    return acquired
}
trusted fun c6CaptureStreamBufferOwned(r: NativeBuffer,q: NativeBuffer,exclusive: bool): NativeBuffer {
    if (!exclusive || !c6CaptureStreamLayout(r,q) || r.loadU32(4) != 3) return NativeBuffer(0)
    if (!c6CaptureStreamHealthy(r)) return NativeBuffer(0)
    return c6I2sRxStreamReadableBuffer(nativeBufferAt(r.addressValue()+220,72),q)
}
trusted fun c6CaptureStreamReleaseOwned(r: NativeBuffer,q: NativeBuffer,consumersJoined: bool,exclusive: bool): int {
    if (!exclusive || !consumersJoined || !c6CaptureStreamLayout(r,q) || r.loadU32(4) != 3) return 2
    if (!c6CaptureStreamHealthy(r)) return 3
    val result=c6I2sRxStreamReleaseOwned(nativeBufferAt(r.addressValue()+220,72),q,true,true)
    if (result == 3) return c6CaptureFail(r,0x50002)
    return result
}
