@inline
trusted fun esp32I2sPlatformUpdateDport(address: u32, clearMask: u32, setMask: u32): void {
    val value = (esp32DportRead(address) & ~clearMask) | setMask
    xtensaMemoryBarrier()
    ablaUnsafeVolatileStoreU32(int(address), int(value))
    return
}

@inline
trusted fun esp32I2sPlatformDevice(controllerId: u32): u32 =
    if (controllerId == u32(0)) u32(0x3ff4f000) else u32(0x3ff6d000)

