import "./clock_c6_sequence.ab"
// C6 BCLK divisor1..64 encodedminus1 atRX28/TX2c[12:7]. Shared MCLK
// binding is PCR78bit23:0TX/1RX (IDF6 C6 LL; register prose has reversed labels).
// Own both directions/GDMA/ETM/IRQs and all codec/MCLK consumers; keep pads
// safe while clock binding changes. No implicit config UPDATE/start/reset.
// status0closed1ready2invalid3clock4busy5write/readback. Snapshot bits8..13
// oldBCLK,14direction(TX1),15oldMCLK,16valid; retained through failed setup.
type C6I2sClockRoute=int
fun C6I2sClockRoute.status(): int = this&255
fun C6I2sClockRoute.ready(): bool = this.status() == 1
trusted fun c6I2sBclkField(transmit: bool,value: int): bool {
    val offset=if (transmit) 0x2c else 0x28
    val before=c6I2sRead(offset)
    val mask=u32(0x1f80)
    val desired=(before&~mask)|(u32(value)<<u32(7))
    if (before != desired) c6I2sWrite(offset,desired)
    return (c6I2sRead(offset)&mask) == (u32(value)<<u32(7))
}
trusted fun c6I2sClockRouteOpenOwned(port: int,transmit: bool,bclkDivider: int,exclusive: bool): C6I2sClockRoute {
    if (!exclusive || port != 0 || bclkDivider < 1 || bclkDivider > 64) return C6I2sClockRoute(2)
    if ((c6I2sClockRead(0)&u32(3)) != u32(1) || (c6I2sClockRead(if (transmit) 4 else 12)&u32(0x400000)) == u32(0)) return C6I2sClockRoute(3)
    if (!c6I2sStopped()) return C6I2sClockRoute(4)
    val token=65536|(int((c6I2sRead(if (transmit) 0x2c else 0x28)>>u32(7))&u32(63))<<8)|
        (if (transmit) 16384 else 0)|(int((c6I2sClockRead(12)>>u32(23))&u32(1))<<15)
    if (!c6I2sBclkField(transmit,bclkDivider-1) ||
        !c6I2sClockField(12,u32(0x800000),if (transmit) u32(0) else u32(0x800000))) return C6I2sClockRoute(token|5)
    return C6I2sClockRoute(token|1)
}
trusted fun C6I2sClockRoute.closeOwned(exclusive: bool): C6I2sClockRoute {
    if (!exclusive || this < 0 || (this&~0x1ffff) != 0 || (this&65536) == 0 || this.status() > 5) return this
    val token=this&~255
    if ((c6I2sClockRead(0)&u32(3)) != u32(1)) return C6I2sClockRoute(token|3)
    if (!c6I2sStopped()) return C6I2sClockRoute(token|4)
    if (!c6I2sClockField(12,u32(0x800000),u32((token>>>15)&1)<<u32(23)) ||
        !c6I2sBclkField((token&16384) != 0,(token>>>8)&63)) return C6I2sClockRoute(token|5)
    return C6I2sClockRoute(0)
}
