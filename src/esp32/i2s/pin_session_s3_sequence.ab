import "./pin_routes_esp32s3.ab"
import "../gpio/snapshot_s3_sequence.ab"
import "../gpio/input_snapshot_s3_sequence.ab"
import "../sdk/raw_buffer.ab"
// Exclusive48B record: magic/status/count/error, four pad snapshots, four
// optional global input snapshots. Slot order DATA/WS/BCLK/MCLK. No clock or
// DMA startup: caller owns stopped I2S/DMA and all old/new pad/input consumers,
// RTC/USB/analog/holds/sleep and shared GPIO updates. Not shared-clock duplex.
// 0invalid,1ready,2closed,3cleanup required. Retain through partial failures.
trusted fun esp32S3I2sPinSessionValid(r: NativeBuffer): bool =
    r.hasAddressRange(0,48) && (r.addressValue()&3) == 0 && r.loadU32(0) == 0x49325333 &&
    (r.loadU32(8) == 3 || r.loadU32(8) == 4)
trusted fun esp32S3I2sPinsCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !esp32S3I2sPinSessionValid(r)) return 0
    if (r.loadU32(4) == 2) return 2
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3) return 0
    val count=r.loadU32(8)
    var index=0
    while (index < count) {
        val saved=S3GpioSnapshot(r.loadU32(16+index*4))
        val input=S3GpioInputSnapshot(r.loadU32(32+index*4))
        if (!saved.valid() || (input != S3GpioInputSnapshot(0) && !input.valid())) return 0
        index=index+1
    }
    r.storeU32(4,3)
    index=0
    while (index < count) {
        val input=S3GpioInputSnapshot(r.loadU32(32+index*4))
        if (input != S3GpioInputSnapshot(0) && input.restoreOwned(true) != 1) { r.storeU32(12,16+index);return 3 }
        index=index+1
    }
    index=0
    while (index < count) {
        if (S3GpioSnapshot(r.loadU32(16+index*4)).restoreOwned(true) != 1) { r.storeU32(12,32+index);return 3 }
        index=index+1
    }
    r.storeU32(12,0);r.storeU32(4,2)
    return 2
}
trusted fun esp32S3I2sPinsCaptureOwned(r: NativeBuffer,port: int,transmit: bool,mclk: Pin,bclk: Pin,ws: Pin,data: Pin,flags: int,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,48) || (r.addressValue()&3) != 0 || !esp32s3I2sPinsValid(port,transmit,mclk,bclk,ws,data,flags)) return 0
    if (r.loadU32(0) != 0 && (!esp32S3I2sPinSessionValid(r) || r.loadU32(4) != 2)) return 0
    val count=if (mclk.number() == -1) 3 else 4
    var index=0
    while (index < count) {
        val number=if (index == 0) data.number() else if (index == 1) ws.number() else if (index == 2) bclk.number() else mclk.number()
        val saved=esp32S3GpioSnapshotOwned(number,true)
        if (!saved.valid()) return 0
        r.storeU32(16+index*4,saved|0)
        val input=if (index == 0) !transmit else if (index == 3) (flags&2) != 0 else (flags&1) != 0
        r.storeU32(32+index*4,if (input) esp32S3GpioInputCaptureOwned(esp32s3I2sPinSignal(port,transmit,index),true)|0 else 0)
        index=index+1
    }
    if (count == 3) { r.storeU32(28,0);r.storeU32(44,0) }
    r.storeU32(0,0x49325333);r.storeU32(4,3);r.storeU32(8,count);r.storeU32(12,0)
    return 1
}
trusted fun esp32S3I2sPinsOpenOwned(r: NativeBuffer,port: int,transmit: bool,mclk: Pin,bclk: Pin,ws: Pin,data: Pin,flags: int,exclusive: bool): int {
    if (esp32S3I2sPinsCaptureOwned(r,port,transmit,mclk,bclk,ws,data,flags,exclusive) != 1) return 0
    if (!esp32s3I2sRoutePins(port,transmit,mclk,bclk,ws,data,flags)) { r.storeU32(12,1);return 3 }
    r.storeU32(4,1)
    return 1
}
