trusted fun esp32I2sCalculatePdmTransmitClock(
    handle: u32,
    clockConfiguration: u32,
    clockInformation: u32
): u32 {
    val rate = esp32I2sLoadU32(clockConfiguration, u32(0))
    var bitClockDivision = esp32I2sLoadU32(clockConfiguration, u32(20))
    if (bitClockDivision < u32(8)) bitClockDivision = u32(8)
    val raw = (esp32I2sLoadU8(handle, u32(64)) & u32(8)) != u32(0)
    var oversampleRatio = u32(0)
    var bitClock = u32(0)
    if (raw) {
        bitClock = rate * u32(2)
    } else {
        val denominator = esp32I2sLoadU32(clockConfiguration, u32(16))
        if (denominator == u32(0)) return u32(258)
        oversampleRatio = esp32I2sLoadU32(clockConfiguration, u32(12)) / denominator
        bitClock = rate * u32(64) * oversampleRatio
    }
    val masterClock = bitClock * bitClockDivision
    if (masterClock == u32(0)) return u32(258)
    val sourceClock = esp32I2sSourceClockFrequency(
        esp32I2sLoadU32(clockConfiguration, u32(4)), masterClock
    )
    val masterClockDivision = sourceClock / masterClock
    if (u64(sourceClock) * u64(100) <= u64(masterClock) * u64(199) ||
        masterClockDivision >= u32(256)) return u32(258)

    esp32I2sStoreU32(clockInformation, u32(0), sourceClock)
    esp32I2sStoreU32(clockInformation, u32(4), masterClock)
    esp32I2sStoreU32(clockInformation, u32(8), bitClock)
    ablaUnsafeStoreU16(nativePointerFromAddress(int(clockInformation + u32(12))), int(masterClockDivision))
    ablaUnsafeStoreU16(nativePointerFromAddress(int(clockInformation + u32(14))), int(bitClockDivision))

    if (!raw) {
        val controller = esp32I2sLoadU32(handle, u32(0))
        val device = esp32I2sLoadU32(controller, u32(4))
        esp32I2sUpdateRegister(device + u32(184), u32(0x000fffff),
            ((esp32I2sLoadU32(clockConfiguration, u32(12)) & u32(1023)) << u32(10)) |
            (esp32I2sLoadU32(clockConfiguration, u32(16)) & u32(1023)))
        esp32I2sUpdateRegister(device + u32(180), u32(0x000000f0), (oversampleRatio & u32(15)) << u32(4))
    }
    return u32(0)
}

trusted fun esp32I2sConfigurePdmTransmitClock(
    handle: u32,
    clockConfiguration: u32
): u32 {
    if (esp32I2sLoadU32(clockConfiguration, u32(16)) > u32(480)) return u32(258)
    val clockInformation = u32(nativeStackAllocate(16))
    val calculation = esp32I2sCalculatePdmTransmitClock(handle, clockConfiguration, clockInformation)
    if (calculation != u32(0)) return calculation
    val source = esp32I2sLoadU32(clockConfiguration, u32(4))
    var result = esp32RecoveredEspClkTreeEnableSrc(source, u32(1), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
    if (result != u32(0)) return result

    val division = u32(nativeStackAllocate(12))
    freestandingSet(division, 0, u32(12))
    val controller = esp32I2sLoadU32(handle, u32(0))
    esp32RecoveredXPortEnterCriticalTimeout(esp32I2sObject, u32(4294967295))
    esp32I2sHalSetTransmitClock(controller + u32(4), clockInformation, source, division)
    esp32RecoveredVPortExitCriticalValue(esp32I2sObject)

    val integerPart = esp32I2sLoadU32(division, u32(0))
    val denominator = esp32I2sLoadU32(division, u32(4))
    val numerator = esp32I2sLoadU32(division, u32(8))
    val totalDivision = u64(integerPart) * u64(denominator) + u64(numerator)
    if (totalDivision == u64(0) || denominator == u32(0)) {
        esp32RecoveredEspClkTreeEnableSrc(source, u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0), u32(0))
        return u32(258)
    }

    val modeInformation = esp32I2sLoadU32(handle, u32(60))
    freestandingCopy(modeInformation, clockConfiguration, u32(24))
    val sourceClock = esp32I2sLoadU32(clockInformation, u32(0))
    val scaledSource = u64(sourceClock) * u64(denominator)
    val originClock = esp32UnsignedDivide64Low(
        u32(scaledSource), u32(scaledSource >>> u64(32)),
        u32(totalDivision), u32(totalDivision >>> u64(32))
    )
    esp32I2sStoreU32(handle, u32(76), source)
    esp32I2sStoreU32(handle, u32(80), sourceClock)
    esp32I2sStoreU32(handle, u32(84), originClock)
    esp32I2sStoreU32(handle, u32(88), originClock)
    esp32I2sStoreU32(handle, u32(92), esp32I2sLoadU32(clockInformation, u32(8)))
    return u32(0)
}

trusted fun esp32I2sConfigurePdmTransmitSlot(
    handle: u32,
    slotConfiguration: u32
): u32 {
    val raw = esp32I2sLoadU32(slotConfiguration, u32(16)) == u32(1)
    esp32I2sStoreU8(handle, u32(64),
        (esp32I2sLoadU8(handle, u32(64)) & u32(247)) | (if (raw) u32(8) else u32(0)))
    esp32I2sStoreU32(handle, u32(72), u32(2))
    esp32I2sStoreU32(handle, u32(68),
        if (esp32I2sLoadU32(slotConfiguration, u32(8)) == u32(1)) u32(1) else u32(2))
    val bufferSize = esp32I2sBufferSize(handle,
        esp32I2sLoadU32(slotConfiguration, u32(0)), esp32I2sLoadU32(handle, u32(24)))
    if (bufferSize == u32(0)) return u32(258)
    if (esp32I2sLoadU32(handle, u32(28)) != bufferSize) {
        var result = esp32I2sFreeDmaDescriptors(handle)
        if (result != u32(0)) return result
        result = esp32I2sAllocateDmaDescriptors(handle, bufferSize)
        if (result != u32(0)) return result
    }
    val controller = esp32I2sLoadU32(handle, u32(0))
    val device = esp32I2sLoadU32(controller, u32(4))
    esp32I2sUpdateRegister(device + u32(8), u32(262144),
        (esp32I2sLoadU8(controller, u32(12)) & u32(1)) << u32(18))
    val modeInformation = esp32I2sLoadU32(handle, u32(60))
    freestandingCopy(modeInformation + u32(24), slotConfiguration, u32(40))
    val dataWidth = esp32I2sLoadU32(modeInformation, u32(24))
    if (esp32I2sLoadU32(modeInformation, u32(28)) < dataWidth) {
        esp32I2sStoreU32(modeInformation, u32(28), dataWidth)
    }
    esp32RecoveredXPortEnterCriticalTimeout(esp32I2sObject, u32(4294967295))
    esp32I2sHalConfigurePdmTransmitSlot(controller + u32(4),
        esp32I2sLoadU32(handle, u32(8)) == u32(1), modeInformation + u32(24))
    esp32RecoveredVPortExitCriticalValue(esp32I2sObject)
    return u32(0)
}

trusted fun esp32I2sConfigurePdmTransmitGpio(
    handle: u32,
    gpioConfiguration: u32
): u32 {
    val clockPin = esp32I2sLoadU32(gpioConfiguration, u32(0))
    val outputPin = esp32I2sLoadU32(gpioConfiguration, u32(4))
    if (clockPin != u32(4294967295) && !esp32GpioValid(int(clockPin))) return u32(258)
    if (outputPin != u32(4294967295) && !esp32GpioValid(int(outputPin))) return u32(258)
    val controller = esp32I2sLoadU32(handle, u32(0))
    val signals = esp32I2sPeripheralSignals(esp32I2sLoadU32(controller, u32(0)))
    esp32I2sConfigureGpioSignal(handle, outputPin, esp32I2sLoadU8(signals, u32(10)), u32(0), u32(0))
    val slave = esp32I2sLoadU32(handle, u32(8)) == u32(1)
    val clockSignal = if (slave) {
        if (esp32I2sLoadU8(controller, u32(12)) == u32(0)) esp32I2sLoadU8(signals, u32(2))
        else esp32I2sLoadU8(signals, u32(3))
    } else esp32I2sLoadU8(signals, u32(6))
    esp32I2sConfigureGpioSignal(handle, clockPin, clockSignal,
        if (slave) u32(1) else u32(0), esp32I2sLoadU32(gpioConfiguration, u32(8)) & u32(1))
    freestandingCopy(esp32I2sLoadU32(handle, u32(60)) + u32(64), gpioConfiguration, u32(12))
    return u32(0)
}

trusted fun esp32I2sInitializePdmTransmitMode(handle: u32, configuration: u32): u32 {
    if (handle == u32(0) || configuration == u32(0)) return u32(258)
    if (esp32I2sLoadU32(handle, u32(12)) != u32(2)) return u32(258)
    val controller = esp32I2sLoadU32(handle, u32(0))
    if (controller == u32(0) || esp32I2sLoadU32(controller, u32(0)) != u32(0)) return u32(258)
    esp32I2sTakeMutex(handle)
    if (esp32I2sLoadU32(handle, u32(52)) != u32(0)) {
        esp32I2sGiveMutex(handle)
        return u32(259)
    }
    esp32I2sStoreU32(handle, u32(4), u32(1))
    val previous = esp32I2sLoadU32(handle, u32(60))
    if (previous != u32(0)) esp32LibcFreeValue(previous)
    val modeInformation = esp32LibcCalloc(u32(1), u32(76))
    esp32I2sStoreU32(handle, u32(60), modeInformation)
    var result = if (modeInformation == u32(0)) u32(257) else u32(0)
    if (result == u32(0)) result = esp32I2sConfigurePdmTransmitSlot(handle, configuration + u32(24))
    if (result == u32(0)) result = esp32I2sConfigurePdmTransmitGpio(handle, configuration + u32(64))
    if (result == u32(0)) result = esp32I2sConfigurePdmTransmitClock(handle, configuration)
    if (result == u32(0)) result = esp32I2sInitializeDmaInterrupt(handle)
    if (result == u32(0)) {
        val device = esp32I2sLoadU32(controller, u32(4))
        esp32I2sRegisterStoreU32(device, u32(168), u32(0))
        esp32I2sUpdateRegister(device + u32(180), u32(5),
            u32(1) | ((if (esp32I2sLoadU32(configuration + u32(24), u32(16)) == u32(0)) u32(1) else u32(0)) << u32(2)))
        esp32I2sStoreU32(handle, u32(52), u32(1))
    }
    esp32I2sGiveMutex(handle)
    return result
}

trusted fun esp32I2sPdmReconfigurationReady(handle: u32, direction: u32): u32 {
