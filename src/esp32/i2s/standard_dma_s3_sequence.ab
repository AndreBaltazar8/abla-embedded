// Caller owns BOTH stopped directions, parked GDMA, pads/global inputs,
// stable PLL160MHz and internal DMA ring. Philips16-bit slots, 256fs MCLK.
// slots1 left/2 right/3 stereo. Mono frames still clock two16-bit slots.
// duplicateMono=true is TX+slots3 only: one DMA sample duplicated to both
// wire slots, matching M5Unified mono speaker mode (not stereo DMA layout).
// Never starts I2S/DMA or changes codec power. On failure retain ownership.
// Status1 prepared,2 invalid,3..14 first failed setup stage; rate above bit8.
type Esp32S3StandardDmaPreparation=int
fun Esp32S3StandardDmaPreparation.status(): int = this&255
fun Esp32S3StandardDmaPreparation.valid(): bool = this.status() == 1
fun Esp32S3StandardDmaPreparation.sampleRate(): int = if (this.valid()) this>>>8 else 0

trusted fun esp32s3PrepareStandard16Dma(port: int, transmit: bool, mclk: Pin, bclk: Pin, ws: Pin, data: Pin,
    slots: int, sampleHz: int, channel: int,
    descriptors: int, count: int, buffers: int, blockBytes: int, owner: u32, duplicateMono: bool = false): Esp32S3StandardDmaPreparation {
    if (!esp32s3I2sPinsValid(port,transmit,mclk,bclk,ws,data,0) || slots < 1 || slots > 3 || sampleHz < 8000 || sampleHz > 96000 || channel < 0 || channel > 4 ||
        (duplicateMono && (!transmit || slots != 3)) || owner == u32(0) || count < 2 || (blockBytes & 3) != 0 ||
        !esp32s3GdmaRingLayoutValid(descriptors, count, buffers, blockBytes, blockBytes)) return Esp32S3StandardDmaPreparation(2)
    val divider = esp32s3I2sChooseDivider(160000000, sampleHz * 256)
    if (!divider.valid()) return Esp32S3StandardDmaPreparation(2)
    if (!esp32s3GdmaEnableClock(owner)) return Esp32S3StandardDmaPreparation(3)
    if (!esp32s3I2sEnableClock(port, owner)) return Esp32S3StandardDmaPreparation(4)
    if (!esp32s3GdmaParked(channel, transmit)) return Esp32S3StandardDmaPreparation(5)
    if (!esp32s3I2sResetDirection(port, transmit)) return Esp32S3StandardDmaPreparation(6)
    if (!esp32s3I2sSelectClock(port, transmit, 2, 8)) return Esp32S3StandardDmaPreparation(7)
    if (!esp32s3I2sSetDivider(port, transmit, divider.integer(), divider.numerator(), divider.denominator())) return Esp32S3StandardDmaPreparation(8)
    if (!esp32s3I2sSetFrameWidths(port, transmit, 16, 16, 16, true)) return Esp32S3StandardDmaPreparation(9)
    if (!esp32s3I2sSetStandardMode(port, transmit, slots, if (slots == 3 && !duplicateMono) 0 else 1)) return Esp32S3StandardDmaPreparation(10)
    if (!transmit && !esp32s3I2sSetReceiveBlockBytes(port, blockBytes)) return Esp32S3StandardDmaPreparation(11)
    if (!esp32s3I2sActivateClock(port, transmit)) return Esp32S3StandardDmaPreparation(12)
    if (!esp32s3I2sRoutePins(port, transmit, mclk, bclk, ws, data, 0)) return Esp32S3StandardDmaPreparation(13)
    if (!esp32s3GdmaInitializeRingOwned(descriptors, count, buffers, blockBytes, blockBytes, transmit)) return Esp32S3StandardDmaPreparation(14)
    val actualSampleHz = (divider.frequency(160000000) + 128) / 256
    Esp32S3StandardDmaPreparation(1 | (actualSampleHz << 8))
}
