import "./transfer_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../../hal/esp32_i2s.ab"
@export("p4I2sTransferRead")
trusted fun p4I2sTransferReadHook(address: int): int = mmioLoadU32(address)
@export("p4I2sTransferWrite")
trusted fun p4I2sTransferWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
