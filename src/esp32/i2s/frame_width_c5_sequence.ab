import "./clock_c5_sequence.ab"
// C5 two-slot standard frames. CONF1: WS8:0, data18:14, half26:19,
// slot31:27. CONF bit13 is Philips one-bit shift. No format/update/start.
fun c5I2sFrameWidthWord(dataBits: int,slotBits: int,wsWidth: int): int {
    if ((dataBits != 8 && dataBits != 16 && dataBits != 24 && dataBits != 32) || slotBits < dataBits || slotBits > 32 || wsWidth < 1 || wsWidth > slotBits*2) return -1
    return (wsWidth-1)|((dataBits-1)<<14)|((slotBits-1)<<19)|((slotBits-1)<<27)
}
// Whole I2S/clock/codec ownership as clock owner. Snapshot oldCONF1@8,
// oldshift40,TX41,valid42. status0closed1ready2invalid3clock4busy5write.
type C5I2sFrame=int
fun C5I2sFrame.status(): int = this&255
fun C5I2sFrame.ready(): bool = this.status() == 1
trusted fun c5I2sFrameField(offset: int,mask: u32,value: u32): bool {
    val old=c5I2sRead(offset)
    if ((old&mask) != value) c5I2sWrite(offset,(old&~mask)|value)
    return (c5I2sRead(offset)&mask) == value
}
trusted fun c5I2sFrameOpenOwned(port: int,transmit: bool,dataBits: int,slotBits: int,wsWidth: int,philipsShift: bool,exclusive: bool): C5I2sFrame {
    val word=c5I2sFrameWidthWord(dataBits,slotBits,wsWidth)
    if (!exclusive || port != 0 || word < 0) return C5I2sFrame(2)
    if ((c5I2sClockRead(0)&u32(15)) != u32(13)) return C5I2sFrame(3)
    if (!c5I2sStopped()) return C5I2sFrame(4)
    val conf=if (transmit) 0x24 else 0x20
    val snapshot=(1<<42)|(if (transmit) 1<<41 else 0)|(int(c5I2sRead(conf+8))<<8)|
        (int((c5I2sRead(conf)>>u32(13))&u32(1))<<40)
    if (!c5I2sFrameField(conf+8,u32(0xffffc1ff),u32(word)) ||
        !c5I2sFrameField(conf,u32(8192),if (philipsShift) u32(8192) else u32(0))) return C5I2sFrame(snapshot|5)
    return C5I2sFrame(snapshot|1)
}
trusted fun C5I2sFrame.closeOwned(exclusive: bool): C5I2sFrame {
    if (!exclusive || this < 0 || (this&~0x7ffffffffff) != 0 || (this&(1<<42)) == 0 || this.status() > 5) return this
    val token=this&~255
    if ((c5I2sClockRead(0)&u32(15)) != u32(13)) return C5I2sFrame(token|3)
    if (!c5I2sStopped()) return C5I2sFrame(token|4)
    val conf=if ((token&(1<<41)) != 0) 0x24 else 0x20
    if (!c5I2sFrameField(conf,u32(8192),u32((token>>>40)&1)<<u32(13)) ||
        !c5I2sFrameField(conf+8,u32(0xffffc1ff),u32(token>>>8)&u32(0xffffc1ff))) return C5I2sFrame(token|5)
    return C5I2sFrame(0)
}
