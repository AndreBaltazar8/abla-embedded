import "driver_typed_esp32.ab"
import "../gpio_esp32_logic.ab"

// Typed standard/PDM channel initialization reconstructed from ESP-IDF 6.
// Mode-specific register programming remains in the reusable Abla helpers;
// this file replaces the large error-state dispatchers that orchestrated them.

trusted fun esp32I2sTakeMutex(handle: u32): void {
    esp32RecoveredXQueueSemaphoreTake(
        esp32I2sLoadU32(handle, u32(96)), u32(4294967295),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp32I2sGiveMutex(handle: u32): void {
    val mutex = esp32I2sLoadU32(handle, u32(96))
    esp32RecoveredXQueueGenericSend(
        mutex,
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp32I2sInitializeDmaInterrupt(handle: u32): u32 {
    val controller = esp32I2sLoadU32(handle, u32(0))
    val id = esp32I2sLoadU32(controller, u32(0))
    if (id >= u32(2)) return u32(258)
    val signals = esp32I2sPeripheralSignals(id)
    val device = esp32I2sLoadU32(controller, u32(4))
    val transmit = esp32I2sLoadU32(handle, u32(12)) == u32(2)
    val callback = if (transmit) u32(nativeFunctionAddress(
        esp32I2sDmaTxInterrupt
    )) else u32(nativeFunctionAddress(
        esp32I2sDmaRxInterrupt
    ))
    val result = esp32RecoveredEspIntrAllocIntrstatus(
        esp32I2sLoadU8(signals, u32(12)),
        u32(2304) | esp32I2sLoadU32(handle, u32(56)),
        device + u32(16),
        if (transmit) u32(4096) else u32(512),
        callback,
        handle,
        handle + u32(16),
        u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (result == u32(0)) esp32I2sRegisterStoreU32(
        device, u32(32), esp32I2sRegisterLoadU32(device, u32(32)) | u32(4096)
    )
    return result
}

@inline
trusted fun esp32I2sPeripheralSignals(controllerId: u32): u32 =
    esp32Data_i2s_periph_signal_6bafb23bf0 + controllerId * u32(13)

trusted fun esp32I2sNormalizeStandardSlot(
    destination: u32,
    source: u32
): void {
    freestandingCopy(destination, source, u32(24))
    val dataWidth = esp32I2sLoadU32(destination, u32(0))
    val configuredSlotWidth = esp32I2sLoadU32(destination, u32(4))
    if (configuredSlotWidth < dataWidth) {
        esp32I2sStoreU32(destination, u32(4), dataWidth)
    }
    return
}

trusted fun esp32I2sTryStandardDuplex(
    handle: u32,
    configuration: u32
): u32 {
    val controller = esp32I2sLoadU32(handle, u32(0))
    val direction = esp32I2sLoadU32(handle, u32(12))
    val other = if (direction == u32(1))
        esp32I2sLoadU32(controller, u32(16))
    else esp32I2sLoadU32(controller, u32(20))
    if (other == u32(0) || esp32I2sLoadU32(other, u32(52)) == u32(0)) {
        return u32(0)
    }

    if (esp32I2sLoadU8(controller, u32(12)) == u32(0)) {
        val normalized = u32(nativeStackAllocate(64))
        freestandingCopy(normalized, configuration, u32(64))
        val dataWidth = esp32I2sLoadU32(normalized, u32(16))
        if (esp32I2sLoadU32(normalized, u32(20)) < dataWidth) {
            esp32I2sStoreU32(normalized, u32(20), dataWidth)
        }
        val otherConfiguration = esp32I2sLoadU32(other, u32(60))
        if (otherConfiguration != u32(0) &&
            freestandingCompare(
                otherConfiguration, normalized, u32(64)
            ) == 0) {
            esp32I2sStoreU8(controller, u32(12), u32(1))
        } else {
            var moved = false
            if ((esp32I2sLoadU8(handle, u32(64)) & u32(1)) != u32(0)) {
                var id = u32(0)
                while (id < u32(2) && !moved) {
                    if (id != esp32I2sLoadU32(controller, u32(0))) {
                        moved = esp32I2sChangePort(handle, id) == u32(0)
                    }
                    id = id + u32(1)
                }
            }
            if (!moved) return u32(258)
        }
    }

    if (esp32I2sLoadU8(controller, u32(12)) != u32(0) &&
        esp32I2sLoadU32(handle, u32(8)) == u32(0) &&
        esp32I2sLoadU32(other, u32(8)) == u32(0)) {
        esp32I2sStoreU32(handle, u32(8), u32(1))
        esp32I2sStoreU8(
            handle, u32(64), esp32I2sLoadU8(handle, u32(64)) | u32(32)
        )
    }
    return u32(0)
}

trusted fun esp32I2sConfigureStandardSlot(
    handle: u32,
    slotConfiguration: u32
): u32 {
    val normalized = u32(nativeStackAllocate(24))
    esp32I2sNormalizeStandardSlot(normalized, slotConfiguration)
    esp32I2sStoreU32(handle, u32(72), u32(2))
    esp32I2sStoreU32(
        handle, u32(68),
        if (esp32I2sLoadU32(normalized, u32(8)) == u32(1))
            u32(1) else u32(2)
    )

    val bufferSize = esp32I2sBufferSize(
        handle, esp32I2sLoadU32(normalized, u32(0)),
        esp32I2sLoadU32(handle, u32(24))
    )
    if (bufferSize == u32(0)) return u32(258)
    if (esp32I2sLoadU32(handle, u32(28)) != bufferSize) {
        var result = esp32I2sFreeDmaDescriptors(handle)
        if (result != u32(0)) return result
        result = esp32I2sAllocateDmaDescriptors(handle, bufferSize)
        if (result != u32(0)) return result
    }

    val controller = esp32I2sLoadU32(handle, u32(0))
    val device = esp32I2sLoadU32(controller, u32(4))
    val duplexMask = u32(262144)
    val shared = esp32I2sLoadU8(controller, u32(12)) != u32(0)
    esp32I2sRegisterStoreU32(
        device, u32(8),
        if (shared) esp32I2sRegisterLoadU32(device, u32(8)) | duplexMask
        else esp32I2sRegisterLoadU32(device, u32(8)) & u32(4294705151)
    )

    val isSlave = if (esp32I2sLoadU32(handle, u32(8)) == u32(1))
        u32(1) else u32(0)
    esp32RecoveredXPortEnterCriticalTimeout(
        esp32I2sObject, u32(4294967295)
    )
    if (esp32I2sLoadU32(handle, u32(12)) == u32(2)) {
        esp32I2sHalSetStandardTransmitSlot(
            controller + u32(4), isSlave != u32(0), normalized
        )
    } else {
        esp32I2sHalSetStandardReceiveSlot(
            controller + u32(4), isSlave != u32(0), normalized
        )
    }
    esp32RecoveredVPortExitCriticalValue(esp32I2sObject)
    freestandingCopy(
        esp32I2sLoadU32(handle, u32(60)) + u32(16),
        slotConfiguration,
        u32(24)
    )
    return u32(0)
}

trusted fun esp32I2sCalculateStandardClock(
    handle: u32,
    clockConfiguration: u32,
    clockInformation: u32
): u32 {
    val rate = esp32I2sLoadU32(clockConfiguration, u32(0))
    val modeInformation = esp32I2sLoadU32(handle, u32(60))
    val dataWidth = esp32I2sLoadU32(modeInformation, u32(16))
    var slotWidth = esp32I2sLoadU32(modeInformation, u32(20))
    if (slotWidth < dataWidth) slotWidth = dataWidth
    esp32I2sStoreU32(modeInformation, u32(20), slotWidth)

    val bclk = rate * esp32I2sLoadU32(handle, u32(72)) * slotWidth
    var bclkDiv = esp32I2sLoadU32(clockConfiguration, u32(12))
    var mclk = u32(0)
    if (esp32I2sLoadU32(handle, u32(8)) == u32(0) ||
        (esp32I2sLoadU8(handle, u32(64)) & u32(32)) != u32(0)) {
        mclk = rate * esp32I2sLoadU32(clockConfiguration, u32(8))
        if (bclk == u32(0)) return u32(258)
        bclkDiv = mclk / bclk
    } else {
        if (bclkDiv < u32(8)) bclkDiv = u32(8)
        mclk = bclk * bclkDiv
    }
    if (mclk == u32(0)) return u32(258)

    val sourceClock = esp32I2sSourceClockFrequency(
        esp32I2sLoadU32(clockConfiguration, u32(4)), mclk
    )
    val mclkDiv = sourceClock / mclk
    if (u64(sourceClock) * u64(100) <= u64(mclk) * u64(199) ||
        mclkDiv > u32(255)) return u32(258)

    esp32I2sStoreU32(clockInformation, u32(0), sourceClock)
    esp32I2sStoreU32(clockInformation, u32(4), mclk)
    esp32I2sStoreU32(clockInformation, u32(8), bclk)
    ablaUnsafeStoreU16(
        nativePointerFromAddress(int(clockInformation + u32(12))),
        int(mclkDiv)
    )
    ablaUnsafeStoreU16(
        nativePointerFromAddress(int(clockInformation + u32(14))),
        int(bclkDiv)
    )
    return u32(0)
}

trusted fun esp32I2sConfigureStandardClock(
    handle: u32,
    clockConfiguration: u32
): u32 {
    val modeInformation = esp32I2sLoadU32(handle, u32(60))
    val realSlotWidth = if (
        esp32I2sLoadU32(modeInformation, u32(20)) <
            esp32I2sLoadU32(modeInformation, u32(16))
    ) esp32I2sLoadU32(modeInformation, u32(16))
    else esp32I2sLoadU32(modeInformation, u32(20))
    if (realSlotWidth == u32(24) &&
        esp32I2sLoadU32(clockConfiguration, u32(8)) % u32(3) != u32(0)) {
        return u32(258)
    }

    val clockInformation = u32(nativeStackAllocate(16))
    val result = esp32I2sCalculateStandardClock(
        handle, clockConfiguration, clockInformation
    )
    if (result != u32(0)) return result
    val source = esp32I2sLoadU32(clockConfiguration, u32(4))
    val enableResult = esp32RecoveredEspClkTreeEnableSrc(
        source, u32(1),
        u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (enableResult != u32(0)) return enableResult

    val division = u32(nativeStackAllocate(12))
    freestandingSet(division, 0, u32(12))
    esp32RecoveredXPortEnterCriticalTimeout(
        esp32I2sObject, u32(4294967295)
    )
    val controller = esp32I2sLoadU32(handle, u32(0))
    if (esp32I2sLoadU32(handle, u32(12)) == u32(2)) {
        esp32I2sHalSetTransmitClock(
            controller + u32(4), clockInformation, source, division
        )
    } else {
        esp32I2sHalSetReceiveClock(
            controller + u32(4), clockInformation, source, division
        )
    }
    esp32RecoveredVPortExitCriticalValue(esp32I2sObject)

    val integerPart = esp32I2sLoadU32(division, u32(0))
    val denominator = esp32I2sLoadU32(division, u32(4))
    val numerator = esp32I2sLoadU32(division, u32(8))
    val totalDivision = u64(integerPart) * u64(denominator) +
        u64(numerator)
    if (totalDivision == u64(0) || denominator == u32(0)) {
        esp32RecoveredEspClkTreeEnableSrc(
            source, u32(0),
            u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        return u32(258)
    }

    freestandingCopy(modeInformation, clockConfiguration, u32(16))
    val sourceClock = esp32I2sLoadU32(clockInformation, u32(0))
    val scaledSource = u64(sourceClock) * u64(denominator)
    val originMclk = esp32UnsignedDivide64Low(
        u32(scaledSource), u32(scaledSource >>> u64(32)),
        u32(totalDivision), u32(totalDivision >>> u64(32))
    )
    esp32I2sStoreU32(handle, u32(76), source)
    esp32I2sStoreU32(handle, u32(80), sourceClock)
    esp32I2sStoreU32(handle, u32(84), originMclk)
    esp32I2sStoreU32(handle, u32(88), originMclk)
    esp32I2sStoreU32(
        handle, u32(92), esp32I2sLoadU32(clockInformation, u32(8))
    )
    return u32(0)
}

trusted fun esp32I2sConfigureStandardGpio(
    handle: u32,
    gpioConfiguration: u32
): u32 {
    val bclk = esp32I2sLoadU32(gpioConfiguration, u32(4))
    val wordSelect = esp32I2sLoadU32(gpioConfiguration, u32(8))
    if (bclk != u32(4294967295) && !esp32GpioValid(int(bclk))) {
        return u32(258)
    }
    if (wordSelect != u32(4294967295) &&
        !esp32GpioValid(int(wordSelect))) return u32(258)

    val controller = esp32I2sLoadU32(handle, u32(0))
    val controllerId = esp32I2sLoadU32(controller, u32(0))
    val signals = esp32I2sPeripheralSignals(controllerId)
    val dataOut = esp32I2sLoadU32(gpioConfiguration, u32(12))
    val dataIn = esp32I2sLoadU32(gpioConfiguration, u32(16))
    if (dataOut != u32(4294967295) && dataOut == dataIn) {
        esp32I2sConfigureGpioLoopback(
            handle, dataOut, esp32I2sLoadU8(signals, u32(10)),
            esp32I2sLoadU8(signals, u32(11))
        )
    } else if (esp32I2sLoadU32(handle, u32(12)) == u32(2)) {
        esp32I2sConfigureGpioSignal(
            handle, dataOut, esp32I2sLoadU8(signals, u32(10)),
            u32(0), u32(0)
        )
    } else {
        esp32I2sConfigureGpioSignal(
            handle, dataIn, esp32I2sLoadU8(signals, u32(11)),
            u32(1), u32(0)
        )
    }

    val modeInformation = esp32I2sLoadU32(handle, u32(60))
    val invertFlags = esp32I2sLoadU32(gpioConfiguration, u32(20))
    val mclkResult = esp32I2sConfigureMasterClock(
        handle, controllerId,
        esp32I2sLoadU32(gpioConfiguration, u32(0)),
        esp32I2sLoadU32(modeInformation, u32(4)),
        invertFlags & u32(1)
    )
    if (mclkResult != u32(0)) return mclkResult

    val isSlave = esp32I2sLoadU32(handle, u32(8)) == u32(1)
    val transmit = esp32I2sLoadU32(handle, u32(12)) == u32(2)
    // i2s_signal_conn_t stores master BCK/WS at 2..5 and slave BCK/WS
    // at 6..9. Each pair is TX then RX; WS must not use the BCK pair.
    val wsSignal = if (isSlave) {
        if (transmit) esp32I2sLoadU8(signals, u32(8))
        else esp32I2sLoadU8(signals, u32(9))
    } else {
        if (transmit) esp32I2sLoadU8(signals, u32(4))
        else esp32I2sLoadU8(signals, u32(5))
    }
    val bclkSignal = if (isSlave) {
        if (transmit) esp32I2sLoadU8(signals, u32(6))
        else esp32I2sLoadU8(signals, u32(7))
    } else {
        if (transmit) esp32I2sLoadU8(signals, u32(2))
        else esp32I2sLoadU8(signals, u32(3))
    }
    val input = if (isSlave) u32(1) else u32(0)
    esp32I2sConfigureGpioSignal(
        handle, wordSelect, wsSignal, input,
        (invertFlags >>> u32(2)) & u32(1)
    )
    esp32I2sConfigureGpioSignal(
        handle, bclk, bclkSignal, input,
        (invertFlags >>> u32(1)) & u32(1)
    )
    freestandingCopy(
        modeInformation + u32(40), gpioConfiguration, u32(24)
    )
    return u32(0)
}

trusted fun esp32I2sInitializeStandardMode(
    handle: u32,
    configuration: u32
): u32 {
    if (handle == u32(0) || configuration == u32(0)) return u32(258)

    esp32I2sTakeMutex(handle)
    esp32I2sStoreU32(handle, u32(4), u32(0))

    val previous = esp32I2sLoadU32(handle, u32(60))
    if (previous != u32(0)) esp32LibcFreeValue(previous)
    val modeInformation = esp32LibcCalloc(u32(1), u32(64))
    esp32I2sStoreU32(handle, u32(60), modeInformation)

    var result = u32(0)
    if (modeInformation == u32(0)) result = u32(257)
    if (result == u32(0) &&
        esp32I2sLoadU32(handle, u32(52)) != u32(0)) {
        result = u32(259)
    }
    if (result == u32(0)) result =
        esp32I2sTryStandardDuplex(handle, configuration)
    if (result == u32(0)) result = esp32I2sConfigureStandardSlot(
        handle, configuration + u32(16)
    )
    if (result == u32(0)) result = esp32I2sConfigureStandardClock(
        handle, configuration
    )
    if (result == u32(0)) result = esp32I2sConfigureStandardGpio(
        handle, configuration + u32(40)
    )
    if (result == u32(0)) result = esp32I2sInitializeDmaInterrupt(handle)

    if (result == u32(0)) esp32I2sStoreU32(
        handle, u32(52), u32(1)
    )
    esp32I2sGiveMutex(handle)
    return result
}

trusted fun esp32I2sConfigurePdmReceiveSlot(
    handle: u32,
    slotConfiguration: u32
): u32 {
    val raw = esp32I2sLoadU32(slotConfiguration, u32(16)) == u32(1)
    esp32I2sStoreU8(
        handle, u32(64),
        (esp32I2sLoadU8(handle, u32(64)) & u32(247)) |
            (if (raw) u32(8) else u32(0))
    )
    esp32I2sStoreU32(handle, u32(72), u32(2))
    esp32I2sStoreU32(
        handle, u32(68),
        if (esp32I2sLoadU32(slotConfiguration, u32(8)) == u32(1))
            u32(1) else u32(2)
    )

    val bufferSize = esp32I2sBufferSize(
        handle, esp32I2sLoadU32(slotConfiguration, u32(0)),
        esp32I2sLoadU32(handle, u32(24))
    )
    if (bufferSize == u32(0)) return u32(258)
    if (esp32I2sLoadU32(handle, u32(28)) != bufferSize) {
        var result = esp32I2sFreeDmaDescriptors(handle)
        if (result != u32(0)) return result
        result = esp32I2sAllocateDmaDescriptors(handle, bufferSize)
        if (result != u32(0)) return result
    }

    val controller = esp32I2sLoadU32(handle, u32(0))
    val device = esp32I2sLoadU32(controller, u32(4))
    esp32I2sRegisterStoreU32(
        device, u32(8),
        (esp32I2sRegisterLoadU32(device, u32(8)) & u32(4294705151)) |
            ((esp32I2sLoadU8(controller, u32(12)) & u32(1)) << u32(18))
    )

    val modeInformation = esp32I2sLoadU32(handle, u32(60))
    freestandingCopy(
        modeInformation + u32(20), slotConfiguration, u32(20)
    )
    val dataWidth = esp32I2sLoadU32(modeInformation, u32(20))
    if (esp32I2sLoadU32(modeInformation, u32(24)) < dataWidth) {
        esp32I2sStoreU32(modeInformation, u32(24), dataWidth)
    }

    val slave = esp32I2sLoadU32(handle, u32(8)) == u32(1) ||
        esp32I2sLoadU8(controller, u32(12)) != u32(0)
    esp32RecoveredXPortEnterCriticalTimeout(
        esp32I2sObject, u32(4294967295)
    )
    esp32I2sHalSetPdmReceiveSlot(
        controller + u32(4), slave, modeInformation + u32(20)
    )
    esp32RecoveredVPortExitCriticalValue(esp32I2sObject)
    return u32(0)
}

trusted fun esp32I2sConfigurePdmReceiveGpio(
    handle: u32,
    gpioConfiguration: u32
): u32 {
    val clock = esp32I2sLoadU32(gpioConfiguration, u32(0))
    val dataIn = esp32I2sLoadU32(gpioConfiguration, u32(4))
    if (clock != u32(4294967295) && !esp32GpioValid(int(clock))) {
        return u32(258)
    }
    if (dataIn != u32(4294967295) && !esp32GpioValid(int(dataIn))) {
        return u32(258)
    }

    val controller = esp32I2sLoadU32(handle, u32(0))
    val controllerId = esp32I2sLoadU32(controller, u32(0))
    val signals = esp32I2sPeripheralSignals(controllerId)
    esp32I2sConfigureGpioSignal(
        handle, dataIn, esp32I2sLoadU8(signals, u32(11)),
        u32(1), u32(0)
    )

    val roleIsSlave = esp32I2sLoadU32(handle, u32(8)) == u32(1)
    val clockSignal = if (roleIsSlave) {
        esp32I2sLoadU8(signals, u32(9))
    } else if (esp32I2sLoadU8(controller, u32(12)) == u32(0)) {
        esp32I2sLoadU8(signals, u32(5))
    } else esp32I2sLoadU8(signals, u32(4))
    esp32I2sConfigureGpioSignal(
        handle, clock, clockSignal,
        if (roleIsSlave) u32(1) else u32(0),
        esp32I2sLoadU32(gpioConfiguration, u32(8)) & u32(1)
    )
    freestandingCopy(
        esp32I2sLoadU32(handle, u32(60)) + u32(40),
        gpioConfiguration,
        u32(12)
    )
    return u32(0)
}

trusted fun esp32I2sCalculatePdmReceiveClock(
    handle: u32,
    clockConfiguration: u32,
    clockInformation: u32
): u32 {
    val modeInformation = esp32I2sLoadU32(handle, u32(60))
    val slotCount = u32(freestandingPopulationCount32(
        esp32I2sLoadU32(modeInformation, u32(32))
    ))
    val rate = esp32I2sLoadU32(clockConfiguration, u32(0))
    val downsampleFactor = if (
        esp32I2sLoadU32(clockConfiguration, u32(12)) == u32(1)
    ) u32(128) else u32(64)
    val raw = (esp32I2sLoadU8(handle, u32(64)) & u32(8)) != u32(0)
    val bclk = if (raw) rate * u32(2) else rate * downsampleFactor
    if (bclk == u32(0) || downsampleFactor == u32(0)) return u32(258)

    val limit = (u32(128) * slotCount + downsampleFactor - u32(1)) /
        downsampleFactor
    var bclkDivision = esp32I2sLoadU32(clockConfiguration, u32(16))
    if (bclkDivision < limit) bclkDivision = limit
    if (bclkDivision < u32(8)) bclkDivision = u32(8)
    val mclk = bclk * bclkDivision
    if (mclk == u32(0)) return u32(258)

    val sourceClock = esp32I2sSourceClockFrequency(
        esp32I2sLoadU32(clockConfiguration, u32(4)), mclk
    )
    val mclkDivision = sourceClock / mclk
    if (u64(sourceClock) * u64(100) <= u64(mclk) * u64(199) ||
        mclkDivision > u32(255)) return u32(258)

    esp32I2sStoreU32(clockInformation, u32(0), sourceClock)
    esp32I2sStoreU32(clockInformation, u32(4), mclk)
    esp32I2sStoreU32(clockInformation, u32(8), bclk)
    ablaUnsafeStoreU16(
        nativePointerFromAddress(int(clockInformation + u32(12))),
        int(mclkDivision)
    )
    ablaUnsafeStoreU16(
