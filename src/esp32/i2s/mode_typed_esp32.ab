        handle, configuration + u32(20)
    )
    if (result == u32(0)) result = esp32I2sConfigurePdmReceiveGpio(
        handle, configuration + u32(40)
    )
    if (result == u32(0)) result = esp32I2sConfigurePdmReceiveClock(
        handle, configuration
    )
    if (result == u32(0)) result = esp32I2sInitializeDmaInterrupt(handle)

    if (result == u32(0)) {
        val device = esp32I2sLoadU32(controller, u32(4))
        val pcm = if (esp32I2sLoadU32(
            configuration, u32(36)
        ) == u32(0)) u32(1) else u32(0)
        esp32I2sRegisterStoreU32(device, u32(168), u32(0))
        val mode = (esp32I2sRegisterLoadU32(device, u32(180)) | u32(2)) &
            u32(4294967287)
