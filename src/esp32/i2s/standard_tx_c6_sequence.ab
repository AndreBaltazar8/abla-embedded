import "abla/runtime/scalar"
// IDF6 C6: CONF1 WS0..6,BCLK7..12,data13..17,half18..23,
// slot24..28,Philips shift29. NOT the C5 layout. Preserve BCLK divider.
fun c6I2sStereoFrameWord(dataBits: int,slotBits: int,wsWidth: int,philips: bool): int {
    if ((dataBits != 8 && dataBits != 16 && dataBits != 24 && dataBits != 32) ||
        slotBits < dataBits || slotBits > 32 || wsWidth < 1 || wsWidth > slotBits*2) return -1
    return (wsWidth-1)|((dataBits-1)<<13)|((slotBits-1)<<18)|((slotBits-1)<<24)|(if (philips) 1<<29 else 0)
}
trusted fun c6I2sTxField(offset: int,mask: u32,value: u32): bool {
    val old=c6I2sRead(offset)
    if ((old&mask) != value) c6I2sWrite(offset,(old&~mask)|value)
    return (c6I2sRead(offset)&mask) == value
}
// Caller owns BOTH stopped I2S directions, quiesced DMA/IRQ/ETM and codec
// consumers, pinned APB+TX source clocks. No clock acquisition, reset, FIFO
// clearing, UPDATE or start here. Partial failure retains modified configuration.
// Two-slot master, MSB-first, LE, left-aligned, linear PCM bypass, FIFO-empty
// BCLK/WS stop. Both channels enabled with no mono duplication or slot skipping.
//1configured2invalid3clock4busy5CONF6width7slots8converter readback failure.
trusted fun c6I2sConfigureStereoTxOwned(dataBits: int,slotBits: int,wsWidth: int,philips: bool,exclusive: bool): int {
    val frame=c6I2sStereoFrameWord(dataBits,slotBits,wsWidth,philips)
    if (!exclusive || frame < 0) return 2
    // C6 PCR6c has no C5 RX/TX-ready bits.
    if ((c6I2sClockRead(0)&u32(3)) != u32(1) ||
        (c6I2sClockRead(4)&u32(0x400000)) == u32(0)) return 3
    if (c6I2sRead(0x14) != u32(0) ||
        ((c6I2sRead(0x20)|c6I2sRead(0x24))&u32(0x107)) != u32(0) ||
        (c6I2sRead(0x6c)&u32(1)) == u32(0)) return 4
    if (!c6I2sTxField(0x24,u32(0x1fbce8),u32(0x8b000))) return 5
    if (!c6I2sTxField(0x2c,u32(0x3fffe07f),u32(frame))) return 6
    if (!c6I2sTxField(0x54,u32(0x1fffff),u32(0x10003))) return 7
    if (!c6I2sTxField(0x40,u32(0x2000000),u32(0))) return 8
    return 1
}
