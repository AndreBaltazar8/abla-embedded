// Clock source selector:0 XTAL,1 PLL240M,2 PLL160M,3 external.
// Caller establishes and holds that source at the frequency passed to
// SetFrequency; this function does not power/configure PLLs or infer XTAL Hz.
// Own/quiesce both directions before changing their shared MCLK domain.
trusted fun esp32s3I2sSelectClock(port: int, transmit: bool, source: int, bitClockDivider: int): bool {
    if (port < 0 || port > 1 || source < 0 || source > 3 || bitClockDivider < 1 || bitClockDivider > 64) return false
    val base = 0x6000f000 + port * 0x1e000
    if (((esp32s3I2sClockRead(base + 32) | esp32s3I2sClockRead(base + 36)) & 260) != 0) return false
    val offset = if (transmit) 4 else 0
    esp32s3I2sClockField(base + 48 + offset, 3 << 27, source << 27)
    esp32s3I2sClockField(base + 40 + offset, 63 << 7, (bitClockDivider - 1) << 7)
    true
}

// Configuration latch is self-clearing. A failed bounded poll is a real
// failure: do not start DMA/I2S or recycle resources as if setup succeeded.
// pollLimit counts MMIO reads, not time. Clock must already be running.
trusted fun esp32s3I2sLatchConfiguration(port: int, transmit: bool, pollLimit: int): bool {
    if (port < 0 || port > 1 || pollLimit < 1 || pollLimit > 1000000) return false
    val config = 0x6000f000 + port * 0x1e000 + (if (transmit) 36 else 32)
    if ((esp32s3I2sClockRead(config) & 260) != 0) return false
    esp32s3I2sClockField(config, 256, 256)
    var polls = 0
    while (polls < pollLimit) {
        if ((esp32s3I2sClockRead(config) & 256) == 0) return true
        polls = polls + 1
    }
    false
}
