import "./pins_p4_logic.ab"
// Internal one-pad step. GPIO setup disables output first, clears sleep mux,
// sets push-pull/no-pull and optional input. Output routed before enable.
// Status1 done,2 GPIO config failure,3 matrix readback,4 output enable readback.
trusted fun p4I2sRoutePad(pin: int,signal: int,input: bool,invert: bool): int {
    if (p4I2sPinConfigure(pin,input) != 1) return 2
    if (input) {
        if (!p4I2sPinField(344+signal*4,u32(255),u32(pin | 128 | (if (invert) 64 else 0)))) return 3
    } else {
        if (!p4I2sPinField(1368+pin*4,u32(4095),u32(signal | 1024 | (if (invert) 512 else 0)))) return 3
        val enable=if (pin < 32) 32 else 44
        val bit=u32(1)<<u32(pin&31)
        p4I2sPinWrite(enable+4,bit)
        if ((p4I2sPinRead(enable)&bit) == u32(0)) return 4
    }
    return 1
}
// Caller owns pads AND previous/new input routes; both I2S directions/DMA and
// previous HP/LP/analog users stopped. Holds released, GPIO/IOMUX power and
// clocks pinned. No loopback/duplex, clock enable, hold release or rollback.
// Low byte1 done,2 invalid/unowned,3 DATA,4 WS,5 BCLK,6 MCLK failure;
// nested pad status in bits8+. Retain all pad/route ownership on any failure.
trusted fun esp32p4I2sRoutePinsOwned(port: int,transmit: bool,mclk: int,bclk: int,
    ws: int,data: int,flags: int,exclusive: bool): int {
    if (!exclusive || !esp32p4I2sPinsValid(port,mclk,bclk,ws,data,flags)) return 2
    val d=p4I2sRoutePad(data,esp32p4I2sPinSignal(port,transmit,0),!transmit,false)
    if (d != 1) return 3 | (d << 8)
    val w=p4I2sRoutePad(ws,esp32p4I2sPinSignal(port,transmit,1),(flags & 1) != 0,(flags & 8) != 0)
    if (w != 1) return 4 | (w << 8)
    val b=p4I2sRoutePad(bclk,esp32p4I2sPinSignal(port,transmit,2),(flags & 1) != 0,(flags & 4) != 0)
    if (b != 1) return 5 | (b << 8)
    if (mclk != -1) {
        val m=p4I2sRoutePad(mclk,esp32p4I2sPinSignal(port,transmit,3),(flags & 2) != 0,(flags & 16) != 0)
        if (m != 1) return 6 | (m << 8)
    }
    return 1
}
