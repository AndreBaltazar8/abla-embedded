import "./audio_rx_setup_c6_sequence.ab"
import "./rate_plan_c6.ab"
import "./captured_buffer_c6_sequence.ab"
import "./capture_finish_c6_sequence.ab"
//364B aligned record:header40,setup180@40,start72@220,finish72@292.
// States1setup2start3capturing4captured5closing6closed7failed; cancellation
// extension owns8cancelling9cancelled. Returns
//1started2invalid3failed4captured5pending6closed7blocked. No reset/discard.
// Caller owns initialized RX/GDMA, pinned source+GPIO clocks, codec/pads,
// all buffers and IRQ/ETM. Circular mode requires >=2 buffers, returns1 while
// running, and MUST use the stream cursor plus explicit cancellation to stop.
// start.circular@260 retains the requested mode even before start publication.
// One finite descriptor uses hardware EOF stop; longer
// chains need timely polling to stop before trailing data overruns the FIFO.
// Failure is retained; close only after successful capture or pre-start failure.
// Explicit cancellation is separate, not a successful capture or silent reset.
fun c6CaptureStorage(r: NativeBuffer): bool = r.hasAddressRange(0,364) && (r.addressValue()&3) == 0 && (r.addressValue()+364 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun c6CaptureValid(r: NativeBuffer): bool = c6CaptureStorage(r) && r.loadU32(0) == 0x43364353
trusted fun c6CaptureFail(r: NativeBuffer,detail: int): int { r.storeU32(8,detail);r.storeU32(4,7);return 3 }
trusted fun c6CapturePollOwned(r: NativeBuffer,budget: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c6CaptureValid(r) || budget < 1 || budget > 1024 || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 6) return 6
    if (r.loadU32(4) == 9) return 8
    if (r.loadU32(4) == 7) return 3
    if (r.loadU32(4) == 4) return 4
    if (r.loadU32(4) == 1) {
        val result=c6AudioRxSetupWaitOwned(nativeBufferAt(r.addressValue()+40,180),polls,true)
        if (result == 5) return 5
        if (result != 1) return c6CaptureFail(r,0x10000|result)
        r.storeU32(4,2)
    }
    val start=nativeBufferAt(r.addressValue()+220,72)
    if (r.loadU32(4) == 2) {
        val result=if (start.loadU32(0) == 0) c6I2sDmaStartBeginOwned(start,r.loadU32(36),r.loadU32(16),r.loadU32(20),r.loadU32(24),r.loadU32(28),r.loadU32(32),start.loadU32(40) == 1,polls,true,false)
            else c6I2sDmaStartAdvanceOwned(start,polls,true)
        if (result == 5) return 5
        if (result != 1) return c6CaptureFail(r,0x20000|result)
        r.storeU32(4,3);return 1
    }
    if (r.loadU32(4) == 3) {
        if (start.loadU32(40) == 1) return 1
        val result=c6CaptureFinishOwned(start,nativeBufferAt(r.addressValue()+292,72),budget,polls,true)
        if (result == 5) return 5
        if (result == 4) { r.storeU32(12,0x30004);return 7 }
        if (result != 1) return c6CaptureFail(r,0x30000|result)
        r.storeU32(4,4);r.storeU32(12,0);return 4
    }
    return 2
}
trusted fun c6CaptureOpenOwned(r: NativeBuffer,channel: int,source: int,rootHz: int,rateHz: int,fixedBclk: int,maxPpm: int,bclk: int,ws: int,data: int,mclk: int,dataBits: int,slotBits: int,wsWidth: int,shift: bool,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,exclusive: bool,circular: bool=false): int {
    if (circular && count < 2) return 2
    if (!exclusive || !c6CaptureStorage(r) || r.loadU32(0) != 0 || channel < 0 || channel > 2 || polls < 1 || polls > 1000000 || !c6GdmaRingValid(descriptors,count,buffers,stride,bytes) || c6I2sStereoFrameWord(dataBits,slotBits,wsWidth,shift) < 0) return 2
    if ((u32(bytes)%u32(dataBits/4)) != u32(0)) return 2
    if (maxPpm < 0 || maxPpm > 10000) return 2
    val plan=c6I2sRatePlan(rootHz,rateHz,slotBits*2,fixedBclk)
    if (!plan.withinPpm(rootHz,rateHz,slotBits*2,maxPpm)) return 2
    val address=r.addressValue()
    if ((address < descriptors+count*12 && descriptors < address+364) || (address < buffers+(count-1)*stride+bytes && buffers < address+364)) return 2
    var at=0
    while (at < 364) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x43364353);r.storeU32(4,7)
    r.storeU32(260,if (circular) 1 else 0)
    r.storeU32(16,descriptors);r.storeU32(20,count);r.storeU32(24,buffers);r.storeU32(28,stride);r.storeU32(32,bytes);r.storeU32(36,channel)
    val result=c6AudioRxSetupOpenOwned(nativeBufferAt(address+40,180),channel,bytes,source,plan.integer(),plan.numerator(),plan.denominator(),plan.bclk(),bclk,ws,data,mclk,dataBits,slotBits,wsWidth,shift,polls,true,false,if (count == 1) 1 else 0)
    if (result != 1 && result != 5) return c6CaptureFail(r,0x10000|result)
    r.storeU32(4,if (result == 5) 1 else 2)
    if (result == 5) return 5
    return c6CapturePollOwned(r,1,polls,true)
}
// Close is deliberately NOT cancellation. First poll to drained; failures
// before a start record exists may close immediately. An active/failed transfer
// requires explicit stop/error handling; retain record and payload meanwhile.
trusted fun c6CaptureCloseOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6CaptureValid(r) || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 6) return 6
    if (r.loadU32(4) == 9) return 6
    if (r.loadU32(4) != 4 && r.loadU32(4) != 5 && !(r.loadU32(4) == 7 && r.loadU32(220) == 0)) return 2
    r.storeU32(4,5)
    val setup=nativeBufferAt(r.addressValue()+40,180)
    if (setup.loadU32(0) != 0) {
        val result=c6AudioRxSetupCloseOwned(setup,polls,true)
        if (result == 5) return 5
        if (result != 6) { r.storeU32(12,0x40000|result);return 7 }
    }
    r.storeU32(12,0);r.storeU32(4,6);return 6
}

// Read views before close while clocks and acquisition evidence are retained.
// All consumers must join before close or any descriptor/payload reuse.
trusted fun c6CaptureBufferOwned(r: NativeBuffer,index: int,exclusive: bool): NativeBuffer {
    if (!exclusive || !c6CaptureValid(r) || r.loadU32(4) != 4) return NativeBuffer(0)
    return c6I2sCapturedBufferOwned(nativeBufferAt(r.addressValue()+220,72),nativeBufferAt(r.addressValue()+300,28),index,true)
}
