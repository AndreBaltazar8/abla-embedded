import "./buzzer_stream_c6_sequence.ab"
// Retained56B startup:tag0,state4,primary8,prefilled12,descriptors16,count20,
// buffers24,stride28,bytes32,channel36,bound start40,producer44,sources64@48.
// States1prefill2UPDATE pending3started4failed. Caller supplies already prepared
// clocks/pins/format/DMA (platform+audio setup), stable exclusive hardware and
// fresh zeroed start72 plus initialized empty producer24. No heap/reset/ack.
// All ring payloads are rendered/copied before descriptor publication/START.
// Returns1started2invalid3failed5pending. A failed start never retries START.
// Source cursors are committed per copied block; do not restart on failure.
fun c6BuzzerStartStorage(q: NativeBuffer): bool = q.hasAddressRange(0,56) && (q.addressValue()&3) == 0 && (q.addressValue()+56 <= 0x60000000 || q.addressValue() >= 0x60100000)
trusted fun c6BuzzerStartSpanSafe(q: NativeBuffer,r: NativeBuffer,span: NativeBuffer,bytes: int): bool =
    span.hasAddressRange(0,bytes) && !pcmMixSpansOverlap(span,bytes,q,56) && !pcmMixSpansOverlap(span,bytes,r,72) &&
    !pcmMixSpansOverlap(span,bytes,nativeBufferAt(q.loadU32(16),q.loadU32(20)*12),q.loadU32(20)*12) &&
    !pcmMixSpansOverlap(span,bytes,nativeBufferAt(q.loadU32(24),(q.loadU32(20)-1)*q.loadU32(28)+q.loadU32(32)),(q.loadU32(20)-1)*q.loadU32(28)+q.loadU32(32))
trusted fun c6BuzzerStartAdvanceOwned(q: NativeBuffer,r: NativeBuffer,producer: NativeBuffer,sources: PcmSourceQueues,accumulator: NativeBuffer,scratch: NativeBuffer,mono: NativeBuffer,staging: NativeBuffer,volume: PcmVolume,budget: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c6BuzzerStartStorage(q) || q.loadU32(0) != 0x43364253 || !c6I2sDmaStartStorage(r) || q.loadU32(40) != r.addressValue() || q.loadU32(44) != producer.addressValue() ||
        (q.loadU32(48)|(q.loadU32(52)<<32)) != (sources|0) || budget < 1 || budget > 1024 || polls < 1 || polls > 1000000) return 2
    if (q.loadU32(4) == 3) return 1
    if (q.loadU32(4) == 4) return 3
    if (q.loadU32(4) != 1 && q.loadU32(4) != 2) return 2
    if (q.loadU32(4) == 1) {
        val bytes=q.loadU32(32);val frames=bytes>>>2
        if (r.loadU32(0) != 0 || !buzzerSourceBlockValid(producer) || !volume.valid() || !sources.valid() ||
            !c6BuzzerStartSpanSafe(q,r,producer,24) || !c6BuzzerStartSpanSafe(q,r,accumulator,frames*8) || !c6BuzzerStartSpanSafe(q,r,scratch,frames*4) || !c6BuzzerStartSpanSafe(q,r,mono,frames*2) || !c6BuzzerStartSpanSafe(q,r,staging,bytes) ||
            !sources.disjointFrom(q,56) || !sources.disjointFrom(r,72) || !sources.disjointFrom(nativeBufferAt(q.loadU32(16),q.loadU32(20)*12),q.loadU32(20)*12) ||
            !sources.disjointFrom(nativeBufferAt(q.loadU32(24),(q.loadU32(20)-1)*q.loadU32(28)+bytes),(q.loadU32(20)-1)*q.loadU32(28)+bytes)) return 2
        if (!c6I2sUpdateClocks(true) || !c6I2sStopped() || !c6GdmaClocksReady() || !c6GdmaTxParked(q.loadU32(36))) return 2
        if ((c6I2sRead(0x24)&u32(0x1fbce8)) != u32(0x8b000) || (c6I2sRead(0x2c)&u32(0x3fffe07f)) != u32(c6I2sStereoFrameWord(16,16,16,false)) || (c6I2sRead(0x54)&u32(0x1fffff)) != u32(0x10003)) return 2
        var left=budget
        while (left > 0 && q.loadU32(12) < q.loadU32(20)) {
            if (producer.loadU32(4) != 2) {
                val prepared=buzzerSourceBlockPrepareOwned(producer,sources,frames,accumulator,scratch,mono,staging,volume,true)
                if (prepared == 2) return 2
                if (prepared != 1) { q.storeU32(4,4);q.storeU32(8,0x10000|prepared);return 3 }
            }
            if (producer.loadU32(12) != frames || producer.loadU32(16) != staging.addressValue() || producer.loadU32(20) != bytes) return 2
            val destination=nativeBufferAt(q.loadU32(24)+q.loadU32(12)*q.loadU32(28),bytes)
            var at=0
            while (at < bytes) { destination.storeU32(at,staging.loadU32(at));at=at+4 }
            if (!buzzerSourceBlockReleaseOwned(producer,true,true)) { q.storeU32(4,4);q.storeU32(8,0x10003);return 3 }
            q.storeU32(12,q.loadU32(12)+1);left=left-1
        }
        if (q.loadU32(12) < q.loadU32(20)) return 5
        q.storeU32(4,2)
        val result=c6I2sDmaStartBeginOwned(r,q.loadU32(36),q.loadU32(16),q.loadU32(20),q.loadU32(24),q.loadU32(28),bytes,true,polls,true)
        if (result == 5) return 5
        if (result != 1) { q.storeU32(4,4);q.storeU32(8,0x20000|result);return 3 }
        q.storeU32(4,3);return 1
    }
    val result=c6I2sDmaStartAdvanceOwned(r,polls,true)
    if (result == 5) return 5
    if (result != 1) { q.storeU32(4,4);q.storeU32(8,0x20000|result);return 3 }
    q.storeU32(4,3);return 1
}
trusted fun c6BuzzerStartBeginOwned(q: NativeBuffer,r: NativeBuffer,producer: NativeBuffer,sources: PcmSourceQueues,configuredRate: int,channel: int,descriptors: int,count: int,buffers: int,stride: int,bytes: int,exclusive: bool): int {
    if (!exclusive || !c6BuzzerStartStorage(q) || q.loadU32(0) != 0 || !c6I2sDmaStartStorage(r) || r.loadU32(0) != 0 || channel < 0 || channel > 2 || count < 2 || !c6GdmaRingValid(descriptors,count,buffers,stride,bytes) || !buzzerSourceBlockValid(producer) || producer.loadU32(4) != 1 || !sources.valid() || sources.queue(0).storage().loadU32(4) != configuredRate) return 2
    if (pcmMixSpansOverlap(q,56,r,72) || !sources.disjointFrom(q,56) || !sources.disjointFrom(r,72) || !sources.disjointFrom(producer,24) || pcmMixSpansOverlap(q,56,producer,24) || pcmMixSpansOverlap(r,72,producer,24) ||
        pcmMixSpansOverlap(q,56,nativeBufferAt(descriptors,count*12),count*12) || pcmMixSpansOverlap(q,56,nativeBufferAt(buffers,(count-1)*stride+bytes),(count-1)*stride+bytes) ||
        pcmMixSpansOverlap(r,72,nativeBufferAt(descriptors,count*12),count*12) || pcmMixSpansOverlap(r,72,nativeBufferAt(buffers,(count-1)*stride+bytes),(count-1)*stride+bytes)) return 2
    q.storeU32(0,0x43364253);q.storeU32(4,1);q.storeU32(8,0);q.storeU32(12,0);q.storeU32(16,descriptors);q.storeU32(20,count)
    q.storeU32(24,buffers);q.storeU32(28,stride);q.storeU32(32,bytes);q.storeU32(36,channel);q.storeU32(40,r.addressValue());q.storeU32(44,producer.addressValue());q.storeU32(48,sources|0);q.storeU32(52,sources>>>32);return 5
}
