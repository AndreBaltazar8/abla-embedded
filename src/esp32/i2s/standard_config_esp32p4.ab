import "./clock_control_esp32p4.ab"
import "./clock_divider_esp32p4.ab"
import "./frame_width_esp32p4.ab"
import "./standard_mode_esp32p4.ab"
// Caller owns initialized/clocked port, both stopped directions/DMA, RCC,
// pads and all clock consumers. No reset, pin routing, latch or start.
// Source stable; actual silicon revision required for PLL160M selection.
// All arguments checked before any write. Low byte1 success,2 preflight,
// 3 clock,4 divider,5 frame,6 mode; nested status in bits8+. Partial failure
// retains ownership. Reconfigure/reset completely before enabling consumers.
trusted fun esp32p4I2sConfigureStandardOwned(port: int, transmit: bool, source: int,
    revision: int, integer: int, numerator: int, denominator: int, bclkDivider: int,
    dataBits: int, slotBits: int, wsWidth: int, philipsShift: bool,
    slots: int, flags: int, exclusive: bool): int {
    if (!exclusive || port < 0 || port > 2 || source < 0 || source > 3 || revision < 0 ||
        (source == 3 && revision < 300) || integer < 2 || integer > 255 ||
        denominator < 1 || denominator > 511 || numerator < 0 || numerator >= denominator ||
        bclkDivider < 1 || bclkDivider > 64 ||
        esp32p4I2sFrameWidthWord(dataBits,slotBits,wsWidth) < 0 ||
        esp32p4I2sStandardConfigWord(transmit,slots,flags) < 0) return 2
    val clock=esp32p4I2sConfigureClockOwned(port,transmit,source,revision,bclkDivider,true)
    if (clock != 1) return 3 | (clock << 8)
    val divider=esp32p4I2sSetDividerOwned(port,transmit,integer,numerator,denominator,true)
    if (divider != 1) return 4 | (divider << 8)
    val frame=esp32p4I2sSetFrameWidthsOwned(port,transmit,dataBits,slotBits,wsWidth,philipsShift,true)
    if (frame != 1) return 5 | (frame << 8)
    val mode=esp32p4I2sSetStandardModeOwned(port,transmit,slots,flags,true)
    if (mode != 1) return 6 | (mode << 8)
    return 1
}
