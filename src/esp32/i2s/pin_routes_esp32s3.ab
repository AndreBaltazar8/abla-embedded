// flags: bit0 slave BCLK/WS inputs, bit1 external MCLK input,
// bit2 BCLK inversion, bit3 WS inversion, bit4 MCLK inversion.
// MCLK=-1 is permitted only when no external clock input is requested.
// Caller owns/releases RTC/USB/flash/board-pad functions and stops I2S/DMA
// before routing. This is one direction, not shared-clock duplex loopback.
// Shared DATA/WS/BCLK/MCLK signal mapping for routing and input ownership.
fun esp32s3I2sPinSignal(port: int,transmit: bool,index: int): int {
    if (index == 0) return if (port == 0) 25 else 30
    if (index == 1) return if (port == 0) (if (transmit) 24 else 27) else (if (transmit) 29 else 32)
    if (index == 2) return if (port == 0) (if (transmit) 22 else 26) else (if (transmit) 28 else 31)
    return if (port == 0) 23 else 21
}
fun esp32s3I2sPinsValid(port: int, transmit: bool, mclk: Pin, bclk: Pin,
    ws: Pin, data: Pin, flags: int): bool {
    if (port < 0 || port > 1 || flags < 0 || flags > 31) return false
    val slave = (flags & 1) != 0
    val external = (flags & 2) != 0
    if (!(if (slave) bclk.valid() && ws.valid() else bclk.outputCapable() && ws.outputCapable())) return false
    if (!(if (transmit) data.outputCapable() else data.valid())) return false
    if (mclk.number() == -1) { if (external) return false }
    else if (!(if (external) mclk.valid() else mclk.outputCapable())) return false
    val b = bclk.number()
    val w = ws.number()
    val d = data.number()
    val m = mclk.number()
    b != w && b != d && w != d && (m == -1 || (m != b && m != w && m != d))
}

trusted fun esp32s3I2sRoutePins(port: int, transmit: bool, mclk: Pin,
    bclk: Pin, ws: Pin, data: Pin, flags: int): bool {
    if (!esp32s3I2sPinsValid(port, transmit, mclk, bclk, ws, data, flags)) return false
    val slave = (flags & 1) != 0
    val dataSignal = esp32s3I2sPinSignal(port,transmit,0)
    val bclkSignal = esp32s3I2sPinSignal(port,transmit,2)
    val wsSignal = esp32s3I2sPinSignal(port,transmit,1)
    val mclkSignal = esp32s3I2sPinSignal(port,transmit,3)
    val dataReady = if (transmit) data.routeOutputSignal(dataSignal) else data.routeInputSignal(dataSignal)
    if (!dataReady) return false
    val wsReady = if (slave) ws.routeInputSignal(wsSignal, (flags & 8) != 0) else ws.routeOutputSignal(wsSignal, (flags & 8) != 0)
    if (!wsReady) return false
    val bclkReady = if (slave) bclk.routeInputSignal(bclkSignal, (flags & 4) != 0) else bclk.routeOutputSignal(bclkSignal, (flags & 4) != 0)
    if (!bclkReady) return false
    if (mclk.number() == -1) return true
    if ((flags & 2) != 0) mclk.routeInputSignal(mclkSignal, (flags & 16) != 0)
    else mclk.routeOutputSignal(mclkSignal, (flags & 16) != 0)
}
