import "driver_typed_esp32.ab"
// ABI-compatible Abla implementation of the ESP32 I2S HAL.

trusted fun esp32I2sHalConfigurePdmTransmitSlot(
    hal: u32,
    slave: bool,
    slot: u32
): void {
    val device = esp32I2sLoadU32(hal)
    val dataWidth = esp32I2sLoadU32(slot, u32(0))
    val configuredWidth = esp32I2sLoadU32(slot, u32(4))
    val slotWidth = if (configuredWidth > dataWidth) configuredWidth else dataWidth
    val mono = esp32I2sLoadU32(slot, u32(8)) == u32(1)
    esp32I2sHalReset(device, false)
    esp32I2sUpdateRegister(device + u32(8), u32(64), if (slave) u32(64) else u32(0))
    esp32I2sUpdateRegister(device + u32(8), u32(1024), u32(0))

    if (esp32I2sLoadU32(slot, u32(16)) == u32(0)) {
        esp32I2sUpdateRegister(device + u32(180), u32(0x0000ff00), (if (esp32I2sLoadU32(slot, u32(20)) != u32(0)) u32(1) else u32(0)) << u32(8))
        esp32I2sUpdateRegister(device + u32(180), u32(0x00030000), (esp32I2sLoadU32(slot, u32(28)) & u32(3)) << u32(16))
        esp32I2sUpdateRegister(device + u32(180), u32(0x000c0000), (esp32I2sLoadU32(slot, u32(32)) & u32(3)) << u32(18))
        esp32I2sUpdateRegister(device + u32(180), u32(0x00300000), (esp32I2sLoadU32(slot, u32(36)) & u32(3)) << u32(20))
        esp32I2sUpdateRegister(device + u32(180), u32(0x00c00000), (esp32I2sLoadU32(slot, u32(24)) & u32(3)) << u32(22))
    }

    esp32I2sUpdateRegister(device + u32(32), u32(0x00080000), u32(0x00080000))
    esp32I2sHalConfigureSampleWidth(device, slotWidth, dataWidth, false)
    val fifoMode = (if (slotWidth > u32(16)) u32(2) else u32(0)) + (if (mono) u32(1) else u32(0))
    esp32I2sUpdateRegister(device + u32(32), u32(0x0000e000), fifoMode << u32(13))
    esp32I2sHalSelectTransmitSlot(device, esp32I2sLoadU32(slot, u32(12)) & u32(3), mono)
    esp32I2sUpdateRegister(device + u32(8), u32(0x00010100), u32(0))
    return
}

