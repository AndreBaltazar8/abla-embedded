import "./update_c5_sequence.ab"
// IDF6 C5 LL and driver pass DMA buffer BYTES directly to RXEOF_NUM[15:0].
// Do not divide by four as classic ESP32 does. Generated register prose
// describes sample bits, but the executable C5 driver uses bytes unchanged.
// Caller owns stopped I2S/GDMA/ETM, pinned clocks and RX buffer lifetime.
// Snapshot old16bits@8,valid24. Status1ready2invalid3clock4busy5write6restored.
// Does not reset/start/update; publish configuration before starting RX.
type C5I2sRxEof=int
fun C5I2sRxEof.status(): int = this&255
trusted fun c5I2sRxEofField(value: u32): bool {
    val before=c5I2sRead(0x64)
    if ((before&u32(65535)) != value) c5I2sWrite(0x64,(before&~u32(65535))|value)
    return (c5I2sRead(0x64)&u32(65535)) == value
}
trusted fun c5I2sRxEofOpenOwned(port: int,bytes: int,exclusive: bool): C5I2sRxEof {
    if (!exclusive || port != 0 || bytes < 1 || bytes > 65535) return C5I2sRxEof(2)
    if (!c5I2sUpdateClocks(false)) return C5I2sRxEof(3)
    if (!c5I2sStopped()) return C5I2sRxEof(4)
    val token=(1<<24)|(int(c5I2sRead(0x64)&u32(65535))<<8)
    return C5I2sRxEof(token|(if (c5I2sRxEofField(u32(bytes))) 1 else 5))
}
trusted fun C5I2sRxEof.closeOwned(exclusive: bool): C5I2sRxEof {
    if (!exclusive || this < 0 || (this&~0x1ffffff) != 0 || (this&(1<<24)) == 0 || (this.status() != 1 && this.status() != 3 && this.status() != 4 && this.status() != 5)) return this
    val token=this&~255
    if (!c5I2sUpdateClocks(false)) return C5I2sRxEof(token|3)
    if (!c5I2sStopped()) return C5I2sRxEof(token|4)
    return C5I2sRxEof(token|(if (c5I2sRxEofField(u32((token>>>8)&65535))) 6 else 5))
}
