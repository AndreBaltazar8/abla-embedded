import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLogLockInternals(): bool {
    if (!internalFunction("esp32RecoveredEspLogImplLock", "esp_log_impl_lock")) return false
    if (!internalFunction("esp32RecoveredEspLogImplLockTimeout", "esp_log_impl_lock_timeout")) return false
    if (!internalFunction("esp32RecoveredEspLogImplUnlock", "esp_log_impl_unlock")) return false
    true
}
