import "../rom/cvt_esp32.ab"
import "abla/unsafe/memory"

val esp32LogDecimalDigitsStorage = nativeStaticBytes(
    "\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x00"
)
val esp32LogDecimalDigits = u32(esp32LogDecimalDigitsStorage)

val esp32LogHexadecimalDigitsStorage = nativeStaticBytes(
    "\x30\x31\x32\x33\x34\x35\x36\x37" +
    "\x38\x39\x61\x62\x63\x64\x65\x66\x00"
)
val esp32LogHexadecimalDigits = u32(esp32LogHexadecimalDigitsStorage)

// The public value is a u64; Abla lowers that value to the native Xtensa ABI
// pair while keeping the conversion loop visible to LLVM.
trusted fun esp32LogUtilConvert(
    value: u64,
    radix: i32,
    pad: i32,
    digits: u32,
    buffer: u32
): i32 = i32(esp32RomCvt(
    u32(value),
    u32(value >> u64(32)),
    u32(radix),
    u32(pad),
    digits,
    buffer
))

trusted fun esp32LogUtilConvertHexadecimal(
    value: u64,
    pad: i32,
    buffer: u32
): i32 = esp32LogUtilConvert(
    value, i32(16), pad, esp32LogHexadecimalDigits, buffer
)

trusted fun esp32LogUtilConvertDecimal(
    value: u64,
    pad: i32,
    buffer: u32
): i32 = esp32LogUtilConvert(
    value, i32(10), pad, esp32LogDecimalDigits, buffer
)
