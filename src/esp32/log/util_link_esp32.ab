import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLogUtilInternals(): bool {
    if (!internalFunction("esp32LogUtilConvert", "esp_log_util_cvt")) return false
    if (!internalFunction("esp32LogUtilConvertHexadecimal", "esp_log_util_cvt_hex")) return false
    if (!internalFunction("esp32LogUtilConvertDecimal", "esp_log_util_cvt_dec")) return false
    true
}
