import "../../runtime/freestanding_memory.ab"
import "../../atomic.ab"
import "../rom/printf_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// ESP-IDF's default log sink only needs the integer/string formatting subset
// already implemented by the classic-ESP32 ROM-compatible formatter. Keeping
// this separate from the complete picolibc vprintf implementation lets LLVM
// discard floating-point, positional-argument, FILE-lock, and locale support
// when an application does not call those facilities itself.
trusted fun esp32CompactLogVprintf(
    format:u32,va0:u32,va1:u32,va2:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32RomPrintfFormat(format, va0, va1, va2)

val esp32Data_esp_log_vprint_func_b37048cb3fStorage = nativeStaticMutableU32s([
    // esp_log passes the Xtensa va_list triple (overflow area, register-save
    // area, next offset). esp32CompactLogVprintf accepts that representation
    // directly, so the normal firmware does not retain picolibc's much larger
    // FILE, locale, positional-argument, and floating-point formatter. A user
    // can still install a full formatter through esp_log_set_vprintf.
    int(u32(nativeFunctionAddress(esp32CompactLogVprintf)))
])
val esp32Data_esp_log_vprint_func_b37048cb3f =
    u32(esp32Data_esp_log_vprint_func_b37048cb3fStorage)

trusted fun esp32LogSetVprintf(replacement:u32):u32 {
    val slot = atomicU32At(int(esp32Data_esp_log_vprint_func_b37048cb3f))
    var observed = slot.compareExchangeRelaxed(u32(0), u32(0))
    while (true) {
        val nextObserved = slot.compareExchange(observed, replacement)
        if (nextObserved == observed) return observed
        observed = nextObserved
    }
    u32(0)
}

trusted fun esp32LogWriteVa(
    config:u32,tag:u32,format:u32,va0:u32,va1:u32,va2:u32
):void {
    esp32RecoveredEspLogVa(config,tag,format,va0,va1,va2,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    return
}

trusted fun esp32LogWrite(
    config:u32,tag:u32,format:u32,arg0:u32,arg1:u32,arg2:u32
):void {
    val frame = u32(nativeStackAllocate(80))
    freestandingSet(frame, i32(0), u32(12))
    val registerArgs = frame + u32(16)
    val overflowArgs = frame + u32(48)
    val overflowBase = overflowArgs - u32(32)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame)), int(overflowBase))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame + u32(4))), int(registerArgs))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame + u32(8))), int(u32(12)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame + u32(28))), int(arg0))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame + u32(32))), int(arg1))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(frame + u32(36))), int(arg2))
    esp32LogWriteVa(config, tag, format, overflowBase, registerArgs, u32(12))
}

trusted fun esp32RecoveredEspLogSetVprintf(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32LogSetVprintf(a2)

trusted fun esp32RecoveredEspLogWritev(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32LogWriteVa(a2,a3,a4,a5,a6,a7); a2 }

trusted fun esp32RecoveredEspLogWrite(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32LogWrite(a2,a3,a4,a5,a6,a7); a2 }
