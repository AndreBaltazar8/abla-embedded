import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLogBinaryHeapCacheInternals(): bool {
    if (!internalFunction("esp32RecoveredEspLogCacheSetLevel", "esp_log_cache_set_level")) return false
    if (!internalFunction("esp32RecoveredEspLogCacheGetLevel", "esp_log_cache_get_level")) return false
    if (!internalFunction("esp32RecoveredEspLogCacheClean", "esp_log_cache_clean")) return false
    if (!internalFunction("esp32RecoveredEspLogCacheAdd", "esp_log_cache_add")) return false
    true
}
