import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLogCoreInternals(): bool {
    if (!internalFunction("esp32LogVa", "esp_log_va")) return false
    if (!internalFunction("esp32Log", "esp_log")) return false
    true
}
