import "../freertos/port_esp32.ab"
import "../freertos/tasks_esp32.ab"
import "../../xtensa/assembly.ab"
import "abla/unsafe/native"

// Process-local log policy. This is ordinary module state instead of an
// externally rooted BSS symbol, so it disappears when logging is not retained.
var esp32LogCacheEnabledCallback: u32 = u32(0)

// Original ABI symbol: esp_log_util_set_cache_enabled_cb.
trusted fun esp32LogSetCacheEnabledCallback(callback: u32): u32 {
    esp32LogCacheEnabledCallback = callback
    u32(0)
}

@inline
trusted fun esp32LogSchedulerState(): u32 =
    esp32RecoveredXTaskGetSchedulerState(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )

// Original ABI symbol: esp_log_util_is_constrained. An indirect call remains
// only because the cache predicate is deliberately installed at run time.
trusted fun esp32LogIsConstrained(): u32 {
    if (esp32RecoveredXPortInIsrContext() != u32(0)) return u32(1)
    val cacheEnabled = esp32LogCacheEnabledCallback
    if (cacheEnabled != u32(0)) {
        val enabled = u32(ablaUnsafeCallI32I32I32I32I32I32I32(int(cacheEnabled), int(u32(0)), int(u32(0)), int(u32(0)), int(u32(0)), int(u32(0)), int(u32(0))))
        if (enabled == u32(0)) return u32(1)
    }
    if (esp32LogSchedulerState() != u32(2)) return u32(1)
    u32(0)
}
