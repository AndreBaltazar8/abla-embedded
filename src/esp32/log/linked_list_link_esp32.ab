import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLogLinkedListInternals(): bool {
    if (!internalFunction("esp32LogLinkedListSetLevel", "esp_log_linked_list_set_level")) return false
    if (!internalFunction("esp32LogLinkedListGetLevel", "esp_log_linked_list_get_level")) return false
    if (!internalFunction("esp32LogLinkedListClean", "esp_log_linked_list_clean")) return false
    true
}
