import "abla/unsafe/memory"
import "abla/unsafe/native"
import "level_esp32.ab"
import "lock_esp32.ab"
import "linked_list_esp32.ab"

@inline
trusted fun esp32LogTagLoadU8(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32LogTagLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32LogTagStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32LogTagIsWildcard(tag:u32):bool =
    esp32LogTagLoadU8(tag) == u32(42) &&
    esp32LogTagLoadU8(tag + u32(1)) == u32(0)

trusted fun esp32LogTagSetLevel(tag:u32, level:u32):void {
    if (tag == u32(0)) return

    esp32LogLock()
    if (esp32LogTagIsWildcard(tag)) {
        esp32LogSetDefaultLevel(level)
        esp32LogLinkedListClean()
        esp32RecoveredEspLogCacheClean(
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
        )
    } else {
        val updated = esp32LogLinkedListSetLevel(tag,level)
        if (updated != u32(0)) {
            esp32RecoveredEspLogCacheSetLevel(
                tag,level,u32(0),u32(0),u32(0),u32(0),
                u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
            )
        }
    }
    esp32LogUnlock()
}

trusted fun esp32LogTagGetLevel(tag:u32, useTimeout:bool):u32 {
    val defaultLevel = esp32LogDefaultLevel()
    if (tag == u32(0)) return defaultLevel

    if (useTimeout) {
        if (esp32LogLockTimeout(u32(10)) == u32(0)) return u32(0)
    } else esp32LogLock()

    val levelAddress = u32(nativeStackAllocate(4))
    esp32LogTagStoreU32(levelAddress, defaultLevel)
    val cacheHit = esp32RecoveredEspLogCacheGetLevel(
        tag,levelAddress,u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    if (cacheHit == u32(0)) {
        esp32LogLinkedListGetLevel(tag,levelAddress)
        esp32RecoveredEspLogCacheAdd(
            tag,esp32LogTagLoadU32(levelAddress),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
        )
    }
    esp32LogUnlock()
    esp32LogTagLoadU32(levelAddress)
}

trusted fun esp32LogLevelSet(tag:u32, level:u32):void =
    esp32LogTagSetLevel(tag,level)

trusted fun esp32LogLevelGetTimeout(tag:u32):u32 =
    esp32LogTagGetLevel(tag,true)

trusted fun esp32LogLevelGet(tag:u32):u32 =
    esp32LogTagGetLevel(tag,false)

// Temporary adapters for the remaining lifted Wi-Fi/log callers.
trusted fun esp32RecoveredEspLogLevelSet(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    esp32LogLevelSet(a2,a3)
    a2
}

trusted fun esp32RecoveredEspLogLevelGetTimeout(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32LogLevelGetTimeout(a2)

trusted fun esp32RecoveredEspLogLevelGet(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32LogLevelGet(a2)
