import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLogTagLevelInternals(): bool {
    if (!internalFunction("esp32LogLevelSet", "esp_log_level_set")) return false
    if (!internalFunction("esp32LogLevelGetTimeout", "esp_log_level_get_timeout")) return false
    if (!internalFunction("esp32LogLevelGet", "esp_log_level_get")) return false
    true
}
