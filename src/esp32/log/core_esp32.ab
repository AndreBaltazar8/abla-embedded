import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"
import "write_esp32.ab"

@inline
trusted fun esp32LogStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32LogVprintFunction():u32 = u32(ablaUnsafeLoadU32(
    nativePointerFromAddress(int(esp32Data_esp_log_vprint_func_b37048cb3f))))

trusted fun esp32LogVa(
    config:u32,tag:u32,format:u32,va0:u32,va1:u32,va2:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    val level = config & u32(7)
    // Release firmware keeps failures, while debug/warning/informational
    // traffic is compiled away. Application-visible serial status is separate.
    if (level != u32(1)) return config
    val loggable = esp32RecoveredEspLogIsTagLoggable(level,tag,u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0))
    if (loggable != u32(0)) {
        ablaUnsafeCallI32I32I32I32I32I32I32(int(esp32LogVprintFunction()),
            int(format),int(va0),int(va1),int(va2),int(u32(0)),int(u32(0)))
    }
    config
}

trusted fun esp32Log(
    config:u32,tag:u32,format:u32,arg0:u32,arg1:u32,arg2:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 {
    val level = config & u32(7)
    if (level != u32(1)) return config
    val loggable = esp32RecoveredEspLogIsTagLoggable(level,tag,u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0))
    if (loggable == u32(0)) return config

    val frame = u32(nativeStackAllocate(112))
    val registerArgs = frame + u32(32)
    val overflowArgs = frame + u32(64)
    // Xtensa va_arg starts the overflow area at va_stk + 32.
    val overflowBase = overflowArgs - u32(32)
    esp32LogStoreU32(frame, overflowBase)
    esp32LogStoreU32(frame + u32(4), registerArgs)
    esp32LogStoreU32(frame + u32(8), u32(12))
    esp32LogStoreU32(frame + u32(12), overflowBase)
    esp32LogStoreU32(frame + u32(16), registerArgs)
    esp32LogStoreU32(frame + u32(20), u32(12))
    esp32LogStoreU32(frame + u32(44), arg0)
    esp32LogStoreU32(frame + u32(48), arg1)
    esp32LogStoreU32(frame + u32(52), arg2)
    esp32LogStoreU32(overflowArgs, s0)
    esp32LogStoreU32(overflowArgs + u32(4), s1)
    esp32LogStoreU32(overflowArgs + u32(8), s2)
    esp32LogStoreU32(overflowArgs + u32(12), s3)
    esp32LogStoreU32(overflowArgs + u32(16), s4)
    esp32LogStoreU32(overflowArgs + u32(20), s5)
    esp32LogStoreU32(overflowArgs + u32(24), s6)
    esp32LogStoreU32(overflowArgs + u32(28), s7)
    esp32LogStoreU32(overflowArgs + u32(32), s8)
    esp32LogStoreU32(overflowArgs + u32(36), s9)
    ablaUnsafeCallI32I32I32I32I32I32I32(int(esp32LogVprintFunction()),
        int(format),int(overflowBase),int(registerArgs),int(u32(12)),
        int(u32(0)),int(u32(0)))
    config
}

trusted fun esp32RecoveredEspLogVa(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32LogVa(a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)

trusted fun esp32RecoveredEspLog(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32Log(a2,a3,a4,a5,a6,a7,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9)
