import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLogWriteInternals(): bool {
    if (!internalFunction("esp32LogSetVprintf", "esp_log_set_vprintf")) return false
    if (!internalFunction("esp32LogWriteVa", "esp_log_writev")) return false
    if (!internalFunction("esp32LogWrite", "esp_log_write")) return false
    true
}
