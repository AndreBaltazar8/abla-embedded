import "../runtime/libc_heap_esp32.ab"
import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Node layout: next:u32, level:u8, zero-terminated tag bytes.
val esp32LogTagListHeadStorage = nativeStaticAllocate(4)
val esp32LogTagListHead = u32(esp32LogTagListHeadStorage)

@inline
trusted fun esp32LogListLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32LogListStoreU32(address:u32, value:u32):void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32LogLinkedListUpdate(tag:u32, level:u32):bool {
    var node = esp32LogListLoadU32(esp32LogTagListHead)
    while (node != u32(0)) {
        if (freestandingStringCompare(node + u32(5), tag) == i32(0)) {
            ablaUnsafeStoreU8(
                nativePointerFromAddress(int(node + u32(4))), int(level)
            )
            return true
        }
        node = esp32LogListLoadU32(node)
    }
    false
}

trusted fun esp32LogLinkedListInsert(tag:u32, level:u32):bool {
    val tagBytes = u32(freestandingStringLength(tag)) + u32(1)
    val node = esp32LibcMalloc(u32(5) + tagBytes)
    if (node == u32(0)) return false

    esp32LogListStoreU32(node, esp32LogListLoadU32(esp32LogTagListHead))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(node + u32(4))), int(level))
    freestandingCopy(node + u32(5), tag, tagBytes)
    esp32LogListStoreU32(esp32LogTagListHead, node)
    true
}

trusted fun esp32LogLinkedListSetLevel(tag:u32, level:u32):u32 =
    if (esp32LogLinkedListUpdate(tag,level) ||
        esp32LogLinkedListInsert(tag,level)) u32(1) else u32(0)

trusted fun esp32LogLinkedListGetLevel(tag:u32, levelOut:u32):u32 {
    var node = esp32LogListLoadU32(esp32LogTagListHead)
    while (node != u32(0)) {
        if (freestandingStringCompare(tag, node + u32(5)) == i32(0)) {
            val level = u32(ablaUnsafeLoadU8(
                nativePointerFromAddress(int(node + u32(4)))
            ))
            esp32LogListStoreU32(levelOut, level)
            return u32(1)
        }
        node = esp32LogListLoadU32(node)
    }
    u32(0)
}

trusted fun esp32LogLinkedListClean():void {
    var node = esp32LogListLoadU32(esp32LogTagListHead)
    while (node != u32(0)) {
        val next = esp32LogListLoadU32(node)
        esp32LibcFree(node)
        node = next
    }
    esp32LogListStoreU32(esp32LogTagListHead, u32(0))
}
