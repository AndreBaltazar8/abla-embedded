import "../runtime/libc_locks_esp32.ab"
import "abla/unsafe/memory"

// ESP logging uses one lazily-created normal mutex. The implementation is
// shared with libc locks so its initialization race and ISR policy stay in one
// structured Abla path.
val esp32LogMutexStorage = nativeStaticAllocate(4)
val esp32LogMutex = u32(esp32LogMutexStorage)

trusted fun esp32LogLock(): void {
    esp32LibcLockAcquireGeneric(
        esp32LogMutex,
        esp32LibcLockWaitForever,
        esp32LibcLockNormalMutex
    )
    return
}

trusted fun esp32LogLockTimeout(ticks: u32): u32 {
    if (esp32LibcLockSchedulerState() ==
        esp32LibcLockSchedulerNotStarted) return u32(1)
    return if (esp32LibcLockAcquireGeneric(
        esp32LogMutex,
        ticks,
        esp32LibcLockNormalMutex
    ) == u32(0)) u32(1) else u32(0)
}

trusted fun esp32LogUnlock(): void {
    if (esp32LibcLockSchedulerState() ==
        esp32LibcLockSchedulerNotStarted) return
    esp32LibcLockReleaseGeneric(
        esp32LogMutex,
        esp32LibcLockNormalMutex
    )
}

trusted fun esp32RecoveredEspLogImplLock(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32LogLock()
    return a2
}

trusted fun esp32RecoveredEspLogImplLockTimeout(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32LogLockTimeout(u32(10))

trusted fun esp32RecoveredEspLogImplUnlock(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 {
    esp32LogUnlock()
    return a2
}
