import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLogTimestampInternals(): bool {
    if (!internalFunction("esp32RecoveredEspLogEarlyTimestamp", "esp_log_early_timestamp")) return false
    if (!internalFunction("esp32RecoveredEspLogTimestamp", "esp_log_timestamp")) return false
    true
}
