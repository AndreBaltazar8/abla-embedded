import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLogLevelInternals(): bool {
    if (!internalFunction("esp32RecoveredEspLogSetDefaultLevel", "esp_log_set_default_level")) return false
    if (!internalFunction("esp32RecoveredEspLogIsTagLoggable", "esp_log_is_tag_loggable")) return false
    true
}
