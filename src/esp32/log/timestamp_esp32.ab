import "../freertos/port_esp32.ab"
import "../freertos/tasks_esp32.ab"
import "../../xtensa/assembly.ab"
import "../../xtensa/cpu.ab"
import "abla/unsafe/memory"

// Milliseconds captured when the scheduler first becomes usable. This is a
// real module-level Abla variable, not a reconstructed anonymous BSS cell.
var esp32LogTimestampBase = u32(0)

@inline
trusted fun esp32LogSchedulerStateValue(): u32 =
    esp32RecoveredXTaskGetSchedulerState(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )

trusted fun esp32LogEarlyTimestamp(): u32 {
    // ESP32 ROM exposes the PRO CPU frequency in MHz at g_ticks_per_us_pro.
    val ticksPerMicrosecond = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(u32(1073611232)))
    ))
    if (ticksPerMicrosecond == u32(0)) return u32(0)
    return xtensaReadCycleCount() / (ticksPerMicrosecond * u32(1000))
}

trusted fun esp32LogTimestamp(): u32 {
    if (esp32LogSchedulerStateValue() == u32(1)) {
        return esp32LogEarlyTimestamp()
    }
    if (esp32LogTimestampBase == u32(0) && cpuCoreId() == u32(0)) {
        esp32LogTimestampBase = esp32LogEarlyTimestamp()
    }

    // This firmware config uses a 1000 Hz FreeRTOS tick, so one tick is one
    // millisecond. Keeping this multiplication absent matches the configured C
    // code and gives LLVM the smallest possible path.
    val ticks = if (esp32RecoveredXPortInIsrContext() != u32(0))
        esp32RecoveredXTaskGetTickCountFromISR(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0)
        )
    else esp32RecoveredXTaskGetTickCount(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return esp32LogTimestampBase + ticks
}

trusted fun esp32RecoveredEspLogEarlyTimestamp(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32LogEarlyTimestamp()

trusted fun esp32RecoveredEspLogTimestamp(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32LogTimestamp()
