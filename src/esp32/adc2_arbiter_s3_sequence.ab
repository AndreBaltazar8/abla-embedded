// S3 ADC2 arbitration, IDF adc_ll.h + apb_saradc_reg.h.
// Caller owns RCC/register RMW serialization, pins APB SAR clock/reset state.
// Exclusive means ALL ADC2 RTC/DMA/WiFi/PWDET/ULP clients quiescent during
// transitions; forced RTC additionally requires their exclusion for lifetime.
// Borrowing pins upstream policy for lifetime. Never force RTC over live WiFi.
// mode0 fixed WiFi2>RTC1>digital0 (APB>=8MHz); mode1 RTC shield (slow APB).
// No clock change or ownership acquisition is hidden inside these primitives.
type Esp32S3Adc2Arbiter = int
fun Esp32S3Adc2Arbiter.bits(): int = this
fun Esp32S3Adc2Arbiter.status(): int = this&255
fun Esp32S3Adc2Arbiter.ready(): bool = this.status() == 1
// Original bits12:2 in token18:8, owned19,borrow20,mode21.
// 0closed1ready2invalid3exclusive-required4readback5RTC-busy6state-lost.
fun esp32S3Adc2ArbiterProfile(mode: int): int = if (mode == 0) 0x1910 else 0x1928
trusted fun esp32S3Adc2ArbiterField(value: int): bool {
    val before=esp32S3Adc2ArbiterRead()
    if ((before&0x1ffc) != value) esp32S3Adc2ArbiterWrite((before&0xffffe003)|value)
    return (esp32S3Adc2ArbiterRead()&0x1ffc) == value
}
trusted fun esp32S3Adc2ArbiterOpenOwned(mode: int,exclusive: bool,apbHertz: int): Esp32S3Adc2Arbiter {
    if (mode < 0 || mode > 1 || apbHertz < 1 || apbHertz > 80000000 || (mode == 0 && apbHertz < 8000000)) return Esp32S3Adc2Arbiter(2)
    val before=esp32S3Adc2ArbiterRead()&0x1ffc
    val flags=mode<<21
    if (before == esp32S3Adc2ArbiterProfile(mode)) return Esp32S3Adc2Arbiter(flags|(1<<20)|1)
    if (!exclusive) return Esp32S3Adc2Arbiter(3)
    if ((esp32S3Adc2Read(48)&0x7ffa0000) != 0) return Esp32S3Adc2Arbiter(5)
    val token=flags|((before>>2)<<8)|(1<<19)
    return Esp32S3Adc2Arbiter(token|(if (esp32S3Adc2ArbiterField(esp32S3Adc2ArbiterProfile(mode))) 1 else 4))
}
// Only after RTC channel release and quiescing other controllers. RTC guards
// cannot prove that WiFi/DMA stopped; caller must fulfill exclusivity contract.
trusted fun Esp32S3Adc2Arbiter.closeOwned(): Esp32S3Adc2Arbiter {
    val flags=this&0x3fff00
    if ((flags&0x180000) == 0) return Esp32S3Adc2Arbiter(0)
    val current=esp32S3Adc2ArbiterRead()&0x1ffc
    val desired=esp32S3Adc2ArbiterProfile((flags>>21)&1)
    if ((flags&(1<<20)) != 0) return if (current == desired) Esp32S3Adc2Arbiter(0) else Esp32S3Adc2Arbiter(flags|6)
    val original=((flags>>8)&2047)<<2
    if (current != desired && current != original) return Esp32S3Adc2Arbiter(flags|6)
    if ((esp32S3Adc2Read(48)&0x7ffa0000) != 0) return Esp32S3Adc2Arbiter(flags|5)
    return if (esp32S3Adc2ArbiterField(original)) Esp32S3Adc2Arbiter(0) else Esp32S3Adc2Arbiter(flags|4)
}
