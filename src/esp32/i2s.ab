import "abla/unsafe/memory"
import "./sdk/buffer.ab"
import "./i2s_types.ab"

trusted noescape extern:"c" fun i2s_driver_install(
    port: i32,
    config: i64*,
    queueSize: i32,
    queue: i64*
): i32
trusted noescape extern:"c" fun i2s_driver_uninstall(port: i32): i32
trusted noescape extern:"c" fun i2s_set_pin(port: i32, pins: i64*): i32
trusted noescape extern:"c" fun i2s_set_clk(
    port: i32,
    rate: u32,
    bits: u32,
    channels: i32
): i32
trusted noescape extern:"c" fun i2s_zero_dma_buffer(port: i32): i32
trusted noescape extern:"c" fun i2s_read(
    port: i32,
    destination: i64*,
    size: u32,
    bytesRead: i64*,
    ticks: u32
): i32
trusted noescape extern:"c" fun i2s_write(
    port: i32,
    source: i64*,
    size: u32,
    bytesWritten: i64*,
    ticks: u32
): i32

trusted fun I2sDevice.install(microphone: bool): bool {
    val config = nativeStackAllocate(48)
    val mode = if (microphone) 73 else 5
    nativeAddressStoreU32(config, 0, mode)
    nativeAddressStoreU32(config, 4, this.sampleRateValue())
    nativeAddressStoreU32(config, 8, 16)
    nativeAddressStoreU32(config, 12, 1)
    nativeAddressStoreU32(config, 16, 1)
    nativeAddressStoreU32(config, 20, 2)
    nativeAddressStoreU32(config, 24, 6)
    nativeAddressStoreU32(config, 28, 256)
    nativeAddressStoreU32(config, 32, if (microphone) 0 else 256)
    nativeAddressStoreU32(config, 36, 0)
    nativeAddressStoreU32(config, 40, 256)
    nativeAddressStoreU32(config, 44, 16)

    var result = i2s_driver_install(
        this.portNumber(),
        nativePointerFromAddress(config),
        0,
        nativeNullPointer()
    )

    if (result == 0) {
        val pinConfig = nativeStackAllocate(20)
        nativeAddressStoreU32(pinConfig, 0, -1)
        nativeAddressStoreU32(pinConfig, 4, this.pinsValue().clockPin())
        nativeAddressStoreU32(pinConfig, 8, this.pinsValue().wordSelectPin())
        nativeAddressStoreU32(pinConfig, 12, this.pinsValue().outputPin())
        nativeAddressStoreU32(pinConfig, 16, this.pinsValue().inputPin())
        result = i2s_set_pin(
            this.portNumber(),
            nativePointerFromAddress(pinConfig)
        )
    }
    if (result == 0) {
        result = i2s_set_clk(
            this.portNumber(),
            this.sampleRateValue(),
            16,
            1
        )
    }
    if (result == 0) i2s_zero_dma_buffer(this.portNumber())
    if (result != 0) i2s_driver_uninstall(this.portNumber())
    result == 0
}

trusted fun I2sDevice.uninstall(): void {
    i2s_driver_uninstall(this.portNumber())
    return
}

trusted fun I2sDevice.read(
    buffer: NativeBuffer,
    maximum: int,
    timeoutTicks: int
): int {
    val count = nativeStackAllocate(4)
    nativeAddressStoreU32(count, 0, 0)
    val status = i2s_read(
        this.portNumber(),
        buffer.pointer(),
        maximum,
        nativePointerFromAddress(count),
        timeoutTicks
    )
    if (status == 0) nativeAddressLoadU32(count, 0) else -1
}

trusted fun I2sDevice.write(buffer: NativeBuffer, length: int): int {
    this.writeAddress(buffer.addressValue(), length)
}

trusted fun I2sDevice.writeAddress(address: int, length: int): int {
    val count = nativeStackAllocate(4)
    nativeAddressStoreU32(count, 0, 0)
    val status = i2s_write(
        this.portNumber(),
        nativePointerFromAddress(address),
        length,
        nativePointerFromAddress(count),
        4294967295
    )
    if (status == 0) nativeAddressLoadU32(count, 0) else -1
}
