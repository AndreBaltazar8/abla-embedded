import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkClockTreeCommonOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspClkTreeRcFastD256GetFreqHz", "esp_clk_tree_rc_fast_d256_get_freq_hz")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeXtal32kGetFreqHz", "esp_clk_tree_xtal32k_get_freq_hz")) return false
    if (!exportFunction("esp32RecoveredEspClkTreeLpSlowGetFreqHz", "esp_clk_tree_lp_slow_get_freq_hz")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeRcFastGetFreqHz", "esp_clk_tree_rc_fast_get_freq_hz")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeLpFastGetFreqHz", "esp_clk_tree_lp_fast_get_freq_hz")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeApllAcquire", "esp_clk_tree_apll_acquire")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeApllRelease", "esp_clk_tree_apll_release")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeApllFreqSet", "esp_clk_tree_apll_freq_set")) return false
    true
}
