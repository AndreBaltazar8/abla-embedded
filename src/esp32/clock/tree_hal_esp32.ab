import "../dport_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/mmio"
// Abla/LLVM implementation of ESP32 clock-tree frequency queries and clock-output routing.

// Original ABI symbol: clk_hal_lp_slow_get_freq_hz
@inline
trusted fun esp32ClockHalRead(address: u32): u32 {
    xtensaMemoryBarrier()
    return u32(ablaUnsafeVolatileLoadU32(int(address)))
}

trusted fun esp32ClockHalAhbFrequency(): u32 {
    val source = (esp32ClockHalRead(u32(0x3ff48070)) >>> u32(27)) & u32(3)
    if (source == u32(1)) return u32(80000000)
    val cpuFrequency = esp32RecoveredClkHalCpuGetFreqHz(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (source == u32(3)) return cpuFrequency >>> u32(1)
    return cpuFrequency
}




trusted fun esp32RecoveredClkHalLpSlowGetFreqHz(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    val source = (esp32ClockHalRead(u32(0x3ff48070)) >>> u32(30)) & u32(3)
    when (source) {
        0 -> return u32(150000)
        1 -> return u32(32768)
        2 -> return u32(33203)
        else -> return u32(0)
    }
}

// Original ABI symbol: clk_hal_xtal_get_freq_mhz
trusted fun esp32RecoveredClkHalXtalGetFreqMhz(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    val stored = esp32ClockHalRead(u32(0x3ff480b0))
    val low = stored & u32(65535)
    val high = (stored >>> u32(16)) & u32(65535)
    if (low != high || stored == u32(0) || stored == u32(4294967295)) {
        return u32(0)
    }
    return low & u32(65534)
}

// Original ABI symbol: clk_hal_apll_get_freq_hz
@inline
trusted fun esp32ClockHalReadApllBits(
    register: u32,
    highBit: u32,
    lowBit: u32
): u32 = esp32RecoveredRegi2cCtrlReadRegMask(
    u32(109), u32(3), register, highBit, lowBit, u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0)
)

trusted fun esp32RecoveredClkHalApllGetFreqHz(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    val xtalFrequency = u64(esp32RecoveredClkHalXtalGetFreqMhz(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )) * u64(1000000)
    val outputDivider = esp32ClockHalReadApllBits(u32(4), u32(4), u32(0))
    val sdm0 = esp32ClockHalReadApllBits(u32(9), u32(7), u32(0))
    val sdm1 = esp32ClockHalReadApllBits(u32(8), u32(7), u32(0))
    val sdm2 = esp32ClockHalReadApllBits(u32(7), u32(5), u32(0))
    val numerator = (
        (u32(4) + sdm2) << u32(16) |
        sdm1 << u32(8) |
        sdm0
    )
    val denominator = (outputDivider + u32(2)) << u32(17)
    return u32((xtalFrequency * u64(numerator)) / u64(denominator))
}

// Original ABI symbol: clk_hal_soc_root_get_freq_mhz
trusted fun esp32RecoveredClkHalSocRootGetFreqMhz(
    source: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    when (source) {
        0 -> return esp32RecoveredClkHalXtalGetFreqMhz(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        1 -> {
            val selection = esp32DportRead(u32(0x3ff0007c)) & u32(3)
            if (selection < u32(2)) return u32(320)
            if (selection == u32(2)) return u32(480)
            return u32(0)
        }
        2 -> return u32(8)
        3 -> return esp32RecoveredClkHalApllGetFreqHz(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
        ) / u32(1000000)
        else -> return u32(0)
    }
}

// Original ABI symbol: clk_hal_cpu_get_freq_hz
trusted fun esp32RecoveredClkHalCpuGetFreqHz(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    val source = (esp32ClockHalRead(u32(0x3ff48070)) >>> u32(27)) & u32(3)
    if (source == u32(1)) {
        val selection = esp32DportRead(u32(0x3ff0007c)) & u32(3)
        val frequencyMhz = when (selection) {
            0 -> u32(80)
            1 -> u32(160)
            2 -> u32(240)
            else -> u32(0)
        }
        return frequencyMhz * u32(1000000)
    }
    if (source == u32(3)) {
        val selection = esp32DportRead(u32(0x3ff0007c)) & u32(3)
        val divider = when (selection) {
            0 -> u32(4)
            1 -> u32(2)
            else -> u32(0)
        }
        if (divider == u32(0)) return u32(0)
        return esp32RecoveredClkHalApllGetFreqHz(
            u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
        ) / divider
    }

    val rootFrequencyMhz = esp32RecoveredClkHalSocRootGetFreqMhz(
        source, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    val divider = (esp32ClockHalRead(u32(0x3ff66000)) & u32(1023)) + u32(1)
    return rootFrequencyMhz * u32(1000000) / divider
}

// Original ABI symbol: clk_hal_apb_get_freq_hz
trusted fun esp32RecoveredClkHalApbGetFreqHz(
    a2: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 = esp32ClockHalAhbFrequency()

// Original ABI symbol: clk_hal_clock_output_setup
trusted fun esp32ClockHalBindOutput(signal: u32, channel: u32): void {
    if (channel > u32(2)) return
    val shift = channel * u32(4)
    val mask = u32(15) << shift
    val address = u32(0x3ff49000)
    val current = esp32ClockHalRead(address)
    val updated = (current & ~mask) | ((signal & u32(15)) << shift)
    xtensaMemoryBarrier()
    ablaUnsafeVolatileStoreU32(int(address), int(updated))
    return
}

trusted fun esp32RecoveredClkHalClockOutputSetup(
    signal: u32,
    channel: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    esp32ClockHalBindOutput(signal, channel)
    return signal
}

// Original ABI symbol: clk_hal_clock_output_teardown
trusted fun esp32RecoveredClkHalClockOutputTeardown(
    channel: u32,
    a3: u32,
    a4: u32,
    a5: u32,
    a6: u32,
    a7: u32,
    stack0: u32,
    stack1: u32,
    stack2: u32,
    stack3: u32,
    stack4: u32,
    stack5: u32,
    stack6: u32,
    stack7: u32,
    stack8: u32,
    stack9: u32
): u32 {
    esp32ClockHalBindOutput(u32(0), channel)
    return channel
}
