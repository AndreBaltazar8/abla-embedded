import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkClockTreeHalOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredClkHalLpSlowGetFreqHz", "clk_hal_lp_slow_get_freq_hz")) return false
    if (!exportFunction("esp32RecoveredClkHalXtalGetFreqMhz", "clk_hal_xtal_get_freq_mhz")) return false
    if (!exportFunction("esp32RecoveredClkHalApllGetFreqHz", "clk_hal_apll_get_freq_hz")) return false
    if (!internalFunction("esp32RecoveredClkHalSocRootGetFreqMhz", "clk_hal_soc_root_get_freq_mhz")) return false
    if (!exportFunction("esp32RecoveredClkHalCpuGetFreqHz", "clk_hal_cpu_get_freq_hz")) return false
    if (!exportFunction("esp32RecoveredClkHalApbGetFreqHz", "clk_hal_apb_get_freq_hz")) return false
    if (!internalFunction("esp32RecoveredClkHalClockOutputSetup", "clk_hal_clock_output_setup")) return false
    if (!internalFunction("esp32RecoveredClkHalClockOutputTeardown", "clk_hal_clock_output_teardown")) return false
    true
}
