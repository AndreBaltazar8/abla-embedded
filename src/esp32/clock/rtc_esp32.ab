// Configure GPIO32/GPIO33 for the RTC 32 kHz clock and enable its oscillator.
// mode: 0 = crystal, 1 = external clock, 2 = crystal bootstrap.
trusted fun esp32RtcClock32kConfigure(mode: u32): void {
    val padRegister = u32(0x3ff4848c)
    var dac = u32(1)
    var dbias = u32(0)
    if (mode == u32(1)) {
        dac = u32(2)
        dbias = u32(1)
    } else if (mode == u32(2)) {
        dac = u32(3)
    } else if (mode != u32(0)) {
        ablaRuntimeTrap()
    }

    // Disable pulls/input, select RTC mux, configure DRES=3, DAC and DBIAS.
    esp32RtcUpdateRegister(padRegister, u32(0x18c00820), u32(0x00060000))
    esp32RtcUpdateRegister(padRegister, u32(0x00300000), dac << u32(20))
    esp32RtcUpdateRegister(padRegister, u32(0x00000000), u32(0x00000018))
    esp32RtcUpdateRegister(padRegister, u32(0x00000006), dbias << u32(1))
    esp32RtcUpdateRegister(padRegister, u32(0x00000000), u32(0x00080000))
    return
}

