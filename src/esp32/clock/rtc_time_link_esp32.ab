import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRtcTimeOpaqueCallers(): bool {
    if (!internalFunction("esp32RtcClockCalibrationRatio", "rtc_clk_cal_ratio")) return false
    if (!exportFunction("esp32RtcClockCalibrate", "rtc_clk_cal")) return false
    if (!exportFunction("esp32RtcMicrosecondsToSlowTicks", "rtc_time_us_to_slowclk")) return false
    if (!exportFunction("esp32RtcSlowTicksToMicroseconds", "rtc_time_slowclk_to_us")) return false
    if (!exportFunction("esp32RtcTimeGet", "rtc_time_get")) return false
    if (!internalFunction("esp32RtcWaitForSlowClockCycle", "rtc_clk_wait_for_slow_cycle")) return false
    if (!internalFunction("esp32RtcClockFrequencyFromCalibration", "rtc_clk_freq_cal")) return false
    if (!internalFunction("esp32RtcClockFrequencyFromCalibration", "rtc_clk_freq_to_period")) return false
    true
}
