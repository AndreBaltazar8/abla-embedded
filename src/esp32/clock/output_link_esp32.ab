import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkClockOutputOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspClockOutputStart", "esp_clock_output_start")) return false
    if (!internalFunction("esp32RecoveredEspClockOutputStop", "esp_clock_output_stop")) return false
    true
}
