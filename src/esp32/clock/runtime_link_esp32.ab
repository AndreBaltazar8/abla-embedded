import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkClockRuntimeOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspClkCpuFreq", "esp_clk_cpu_freq")) return false
    if (!exportFunction("esp32RecoveredEspClkApbFreq", "esp_clk_apb_freq")) return false
    if (!internalFunction("esp32RecoveredEspClkXtalFreq", "esp_clk_xtal_freq")) return false
    if (!exportFunction("esp32RecoveredEspClkSlowclkCalGet", "esp_clk_slowclk_cal_get")) return false
    if (!exportFunction("esp32RtcTimeMicroseconds", "esp_rtc_get_time_us")) return false
    if (!exportFunction("esp32RecoveredEspClkSlowclkCalSet", "esp_clk_slowclk_cal_set")) return false
    if (!internalFunction("esp32ClockRtcTime", "esp_clk_rtc_time")) return false
    if (!exportFunction("esp32RecoveredEspClkPrivateLock", "esp_clk_private_lock")) return false
    if (!exportFunction("esp32RecoveredEspClkPrivateUnlock", "esp_clk_private_unlock")) return false
    true
}
