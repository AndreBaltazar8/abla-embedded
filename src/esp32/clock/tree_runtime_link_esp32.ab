import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkClockTreeRuntimeOpaqueCallers(): bool {
    if (!internalFunction("esp32RecoveredEspClkTreeSrcGetFreqHz", "esp_clk_tree_src_get_freq_hz")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeSrcSetFreqHz", "esp_clk_tree_src_set_freq_hz")) return false
    if (!exportFunction("esp32RecoveredEspClkTreeInitialize", "esp_clk_tree_initialize")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeIsPowerOn", "esp_clk_tree_is_power_on")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeEnablePower", "esp_clk_tree_enable_power")) return false
    if (!internalFunction("esp32RecoveredEspClkTreeEnableSrc", "esp_clk_tree_enable_src")) return false
    true
}
