import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkRtcClockOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredRtcClk32kEnable", "rtc_clk_32k_enable")) return false
    if (!exportFunction("esp32RecoveredRtcClk32kEnableExternal", "rtc_clk_32k_enable_external")) return false
    if (!exportFunction("esp32RecoveredRtcClk32kDisableExternal", "rtc_clk_32k_disable_external")) return false
    if (!internalFunction("esp32RecoveredRtcClk32kBootstrap", "rtc_clk_32k_bootstrap")) return false
    if (!internalFunction("esp32RecoveredRtcClk32kEnabled", "rtc_clk_32k_enabled")) return false
    if (!exportFunction("esp32RecoveredRtcClk8mEnable", "rtc_clk_8m_enable")) return false
    if (!internalFunction("esp32RecoveredRtcClk8mEnabled", "rtc_clk_8m_enabled")) return false
    if (!exportFunction("esp32RecoveredRtcClk8md256Enabled", "rtc_clk_8md256_enabled")) return false
    if (!internalFunction("esp32RecoveredRtcClkApllEnable", "rtc_clk_apll_enable")) return false
    if (!internalFunction("esp32RecoveredRtcClkApllCoeffSet", "rtc_clk_apll_coeff_set")) return false
    if (!exportFunction("esp32RecoveredRtcClkSlowSrcSet", "rtc_clk_slow_src_set")) return false
    if (!exportFunction("esp32RecoveredRtcClkSlowSrcGet", "rtc_clk_slow_src_get")) return false
    if (!exportFunction("esp32RecoveredRtcClkSlowFreqGetHz", "rtc_clk_slow_freq_get_hz")) return false
    if (!exportFunction("esp32RecoveredRtcClkFastSrcSet", "rtc_clk_fast_src_set")) return false
    if (!internalFunction("esp32RecoveredRtcClkFastSrcGet", "rtc_clk_fast_src_get")) return false
    if (!internalFunction("esp32RecoveredRtcClkGetLactCompensationDelay", "rtc_clk_get_lact_compensation_delay")) return false
    if (!exportFunction("esp32RecoveredRtcClkXtalFreqGet", "rtc_clk_xtal_freq_get")) return false
    if (!internalFunction("esp32RecoveredRtcClkApllCoeffCalc", "rtc_clk_apll_coeff_calc")) return false
    if (!exportFunction("esp32RecoveredRtcClkCpuFreqMhzToConfig", "rtc_clk_cpu_freq_mhz_to_config")) return false
    if (!exportFunction("esp32RecoveredRtcClkCpuFreqGetConfig", "rtc_clk_cpu_freq_get_config")) return false
    if (!internalFunction("esp32RecoveredRtcClkXtalFreqUpdate", "rtc_clk_xtal_freq_update")) return false
    if (!internalFunction("esp32RecoveredRtcClkApbFreqUpdate", "rtc_clk_apb_freq_update")) return false
    if (!internalFunction("esp32RecoveredRtcClkCpuFreqToXtal", "rtc_clk_cpu_freq_to_xtal")) return false
    if (!exportFunction("esp32RecoveredRtcClkCpuSetToDefaultConfig", "rtc_clk_cpu_set_to_default_config")) return false
    if (!internalFunction("esp32RecoveredRtcClkCpuFreqSetXtal", "rtc_clk_cpu_freq_set_xtal")) return false
    if (!exportFunction("esp32RecoveredRtcClkCpuFreqSetXtalForSleep", "rtc_clk_cpu_freq_set_xtal_for_sleep")) return false
    if (!exportFunction("esp32RecoveredRtcClkCpuFreqSetConfig", "rtc_clk_cpu_freq_set_config")) return false
    if (!internalFunction("esp32RecoveredRtcClkCpuFreqSetConfigFast", "rtc_clk_cpu_freq_set_config_fast")) return false
    if (!internalFunction("esp32RecoveredRtcClkApbFreqGet", "rtc_clk_apb_freq_get")) return false
    if (!internalFunction("esp32RecoveredRtcDigClk8mEnable", "rtc_dig_clk8m_enable")) return false
    if (!internalFunction("esp32RecoveredRtcDigClk8mDisable", "rtc_dig_clk8m_disable")) return false
    if (!internalFunction("esp32RecoveredRtcDig8mEnabled", "rtc_dig_8m_enabled")) return false
    if (!exportFunction("esp32RecoveredRtcGetXtal", "rtc_get_xtal")) return false
    true
}
