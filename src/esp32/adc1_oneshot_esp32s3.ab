import "./adc1_oneshot_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("esp32S3Adc1Read")
trusted fun esp32S3Adc1ReadHook(offset: int): int = mmioLoadU32(0x60008800+offset)
@export("esp32S3Adc1Write")
trusted fun esp32S3Adc1WriteHook(offset: int,value: int): void { mmioStoreU32(0x60008800+offset,value); return }
