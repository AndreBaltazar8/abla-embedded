import "abla/unsafe/memory"
import "./clock.ab"
import "./task.ab"
import "./netif_idf6.ab"
import "../network/lwip/sntp_esp32.ab"

trusted noescape fun esp_sntp_enabled(): bool =
    esp32RecoveredEspSntpEnabled(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    ) != u32(0)

trusted noescape fun esp_sntp_stop(): void {
    esp32RecoveredEspSntpStop(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted noescape fun esp_sntp_setoperatingmode(mode: u8): void {
    esp32RecoveredEspSntpSetoperatingmode(
        u32(mode),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp_sntp_setservername(index: u8, server: string): void {
    esp32RecoveredEspSntpSetservername(
        u32(index), u32(nativeCStringAddress(server)),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0)
    )
    return
}

trusted noescape fun esp_sntp_init(): void {
    esp32RecoveredEspSntpInit(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

// ESP-IDF's default tick rate is 1 kHz for the supported firmware targets.
// Projects selecting another rate should provide their own board time module.
@inline
fun millis(): u32 = u32(esp_timer_get_time() / 1000)

@inline
trusted fun delay(milliseconds: u32): void {
    vTaskDelay(milliseconds)
    return
}

// Start UTC wall-clock synchronization without Arduino's configTime wrapper.
// The first server is retained by lwIP for subsequent DNS lookup. The second
// argument is a fallback for builds whose first value is empty; SDK builds with
// multiple SNTP slots can expose an indexed API without changing this contract.
trusted fun startNetworkTime(first: string, second: string): void {
    esp_netif_init()
    if (esp_sntp_enabled()) esp_sntp_stop()
    esp_sntp_setoperatingmode(u8(0))
    esp_sntp_setservername(u8(0), if (first.size > 0) first else second)
    esp_sntp_init()
    return
}
