import "../time/unix_clock52.ab"
import "./timer_esp32s3.ab"
// Opt-in freestanding clock, not compatible with a second SDK wall clock.
// Caller serializes all setters/readers AND SYSTIMER0 snapshots, keeps timer
// advancing at a stable supplied rate, and reconfigures after reset/rate change.
// Does not initialize/reset/enable SYSTIMER, own its alarms, or invent its rate.
val s3UnixClockStorage=nativeStaticMutableU32s([0,0,0,0,0,0,0,0])
var s3UnixClockRate=0
var s3UnixClockPolls=0
trusted fun esp32S3ConfigureUnixClock(ticksPerSecond: int,polls: int = 64): bool {
    if (ticksPerSecond < 1 || ticksPerSecond > 4294967295 || polls < 1 || polls > 1000000) return false
    nativeAddressStoreU32(s3UnixClockStorage,0,0)
    s3UnixClockRate=ticksPerSecond; s3UnixClockPolls=polls
    true
}
trusted fun setUnixTimeSeconds(seconds: int): bool {
    if (s3UnixClockRate == 0 || seconds < 0 || seconds > 253402300799) return false
    unixClock52At(nativeBufferAt(s3UnixClockStorage,32)).setAt(seconds,esp32S3TimerTicks(0,s3UnixClockPolls),s3UnixClockRate)
}
trusted fun unixTimeSeconds(): int {
    if (s3UnixClockRate == 0) return -1
    unixClock52At(nativeBufferAt(s3UnixClockStorage,32)).secondsAt(esp32S3TimerTicks(0,s3UnixClockPolls))
}
