import "./boot_entry_esp32s3.ab"
import "./boot_main_s3_sequence.ab"
import "./startup_memory_esp32s3.ab"
// Linker boundaries, never SDK calls. RTC may use equal/zero bounds when
// unused. Boot stack must be reserved separately from all BSS/data sections.
@inline
trusted fun esp32S3BootMemoryPrepare(): bool {
    if (esp32S3BootVectorAddress() != int(xtensaGuardRead("rsr.vecbase $0","=a,~{memory}"))) return false
    val low=int(xtensaGuardRead("movi $0, __abla_bss_low","=a,~{memory}"))
    val end=int(xtensaGuardRead("movi $0, __abla_bss_top","=a,~{memory}"))
    val rtcLow=int(xtensaGuardRead("movi $0, __abla_rtc_bss_low","=a,~{memory}"))
    val rtcEnd=int(xtensaGuardRead("movi $0, __abla_rtc_bss_top","=a,~{memory}"))
    val stackLow=int(xtensaGuardRead("movi $0, __abla_boot_stack_low","=a,~{memory}"))
    val stackEnd=int(xtensaGuardRead("movi $0, __abla_boot_stack_top","=a,~{memory}"))
    if (end < low || rtcEnd < rtcLow || stackEnd < stackLow) return false
    esp32S3StartupMemoryInitializeOwned(nativeBufferAt(low,end-low),nativeBufferAt(rtcLow,rtcEnd-rtcLow),nativeBufferAt(stackLow,stackEnd-stackLow))
}
