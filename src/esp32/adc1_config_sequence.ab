import "./adc1_oneshot_sequence.ab"
// Owned, quiescent ADC1/Hall/LNA configuration. Caller has stopped/excluded
// ULP, Hall/LNA and DMA users, owns selected analog pad, and holds the shared
// SAR power/clock lease with settling complete. Shared SAR power also serves
// WiFi PWDET: never seize/gate it from this ADC1 configuration function.
// No implicit acquisition, reset, rollback or restoration on failure.
// Low8:1configured2invalid3digitalcontroller4busy5readback; high8 failedstage.
trusted fun esp32Adc1Field(offset: int,mask: int,value: int): bool {
    esp32Adc1Write(offset,(esp32Adc1Read(offset)&(4294967295^mask))|value)
    return (esp32Adc1Read(offset)&mask) == value
}
trusted fun esp32Adc1ConfigureOwned(channel: int,width: int,attenuation: int,polls: int): int {
    if (channel < 0 || channel > 7 || width < 9 || width > 12 || attenuation < 0 || attenuation > 3 || polls < 1 || polls > 1000000) return 2
    if ((esp32Adc1Read(0)&0x8000000) != 0) return 3
    if ((esp32Adc1Read(84)&0x30000) == 0x20000) return 4
    var remaining=polls
    while ((esp32Adc1Read(60)&0x3fc00000) != 0) {
        remaining=remaining-1
        if (remaining == 0) return 4
    }
    // Disable Hall power without touching phase/neighbor RTCIO settings.
    esp32Adc1HallWrite(esp32Adc1HallRead()&0x7fffffff)
    if ((esp32Adc1HallRead()&0x80000000) != 0) return 261
    if (!esp32Adc1Field(12,0x3ffff,0x20001)) return 517
    if (!esp32Adc1Field(16,0xfff0,0)) return 773
    if (!esp32Adc1Field(8,0xffffffff,0x10001)) return 1029
    // IDF RTC clock divider1, inverted raw output, matching width fields.
    if (!esp32Adc1Field(0,0x180300ff,0x10000001|((width-9)<<16))) return 1285
    if (!esp32Adc1Field(44,3,width-9)) return 1541
    val shift=channel*2
    if (!esp32Adc1Field(52,3<<shift,attenuation<<shift)) return 1797
    if (!esp32Adc1Field(88,0x0c000000,0x0c000000)) return 2053
    // No START yet. Clear any previous completed channel; oneshot selects it.
    esp32Adc1Write(84,0x80040000)
    if ((esp32Adc1Read(84)&0xfffe0000) != 0x80040000) return 2309
    return 1
}
