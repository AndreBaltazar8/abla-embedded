import "./mspi_clock_c5_sequence.ab"
// Read-only DIG-498 admission for a CPU transition while MSPI stays on PLL480.
// psramAfterMHz=0 explicitly declares NO live PSRAM, not unchanged frequency.
// Both existing and proposed PSRAM speeds must tolerate both CPU endpoints:
// this covers preparation, abort, and wake CPU restoration before MSPI close.
// Compare exact divider ratios, never rounded integer memory frequencies.
// Exclusive stable clock/controller ownership is required; no gate/reset,
// source selection, cache command, calibration, or chip voltage is changed.
@section(".iram1.abla.c5MspiCpuChangeSafe")
trusted fun esp32C5MspiCpuChangeSafeOwned(cpuBeforeMHz: int,cpuAfterMHz: int,psramAfterMHz: int,exclusive: bool): bool {
    if (!exclusive || cpuBeforeMHz < 1 || cpuBeforeMHz > 240 || cpuAfterMHz < 1 || cpuAfterMHz > 240 ||
        psramAfterMHz < 0 || psramAfterMHz > 480) return false
    if (!c5MspiReady()) return false
    if (psramAfterMHz == 0) return true
    val coreDivider=(c5MspiRead(0x6009601c)&255)+1
    val bits=c5MspiRead(0x60002050)
    val memoryDivider=if ((bits&0x80000000) != 0) 1 else (bits&255)+1
    val minimum=if (cpuBeforeMHz < cpuAfterMHz) cpuBeforeMHz else cpuAfterMHz
    minimum*8*coreDivider*memoryDivider >= 480 && minimum*8 >= psramAfterMHz
}
