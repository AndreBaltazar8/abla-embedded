import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNvsPlatformInternals(): bool {
    if (!internalFunction("esp32NvsLockConstruct", "_ZN3nvs4LockC1Ev")) return false
    if (!internalFunction("esp32NvsLockDestruct", "_ZN3nvs4LockD1Ev")) return false
    if (!internalFunction("esp32NvsLockInitialize", "_ZN3nvs4Lock4initEv")) return false
    if (!internalFunction("esp32NvsLockUninitialize", "_ZN3nvs4Lock6uninitEv")) return false
    if (!internalFunction("esp32NvsLockConstruct", "_ZN3nvs4LockC2Ev")) return false
    if (!internalFunction("esp32NvsLockDestruct", "_ZN3nvs4LockD2Ev")) return false
    true
}
