// NVS uses one lazily initialized process-wide lock. C++'s tiny RAII wrapper
// becomes direct Abla functions; `instance` is retained only for ABI shape.
val esp32Data_ZN3nvs4Lock10mSemaphoreE_e8d74764f3Storage = nativeStaticAllocate(4)
val esp32Data_ZN3nvs4Lock10mSemaphoreE_e8d74764f3 =
    u32(esp32Data_ZN3nvs4Lock10mSemaphoreE_e8d74764f3Storage)

trusted fun esp32NvsLockConstruct(instance:u32):void {
    esp32LibcLockAcquireGeneric(
        esp32Data_ZN3nvs4Lock10mSemaphoreE_e8d74764f3,
        esp32LibcLockWaitForever,
        esp32LibcLockNormalMutex
    )
    return
}

trusted fun esp32NvsLockDestruct(instance:u32):void {
    esp32LibcLockReleaseGeneric(
        esp32Data_ZN3nvs4Lock10mSemaphoreE_e8d74764f3,
        esp32LibcLockNormalMutex
    )
}

trusted fun esp32NvsLockInitialize():u32 = u32(0)

trusted fun esp32NvsLockUninitialize():void {
    val semaphore = u32(ablaUnsafeLoadU32(nativePointerFromAddress(
        int(esp32Data_ZN3nvs4Lock10mSemaphoreE_e8d74764f3)
    )))
    if (semaphore != u32(0)) {
        esp32LibcLockClose(esp32Data_ZN3nvs4Lock10mSemaphoreE_e8d74764f3)
    }
}

