import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNvsTypesInternals(): bool {
    if (!internalFunction("esp32NvsItemCalculateCrc32", "_ZNK3nvs4Item14calculateCrc32Ev")) return false
    if (!internalFunction("esp32NvsItemCalculateCrc32WithoutValue", "_ZNK3nvs4Item26calculateCrc32WithoutValueEv")) return false
    if (!internalFunction("esp32NvsCalculateCrc32", "_ZN3nvs4Item14calculateCrc32EPKhjPm")) return false
    if (!internalFunction("esp32NvsItemCheckHeaderConsistency", "_ZNK3nvs4Item22checkHeaderConsistencyEh")) return false
    true
}
