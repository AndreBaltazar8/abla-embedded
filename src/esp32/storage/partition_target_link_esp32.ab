import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkPartitionTargetOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredEspPartitionWrite", "esp_partition_write")) return false
    if (!exportFunction("esp32RecoveredEspPartitionReadRaw", "esp_partition_read_raw")) return false
    if (!exportFunction("esp32RecoveredEspPartitionWriteRaw", "esp_partition_write_raw")) return false
    if (!exportFunction("esp32RecoveredEspPartitionEraseRange", "esp_partition_erase_range")) return false
    if (!internalFunction("esp32RecoveredEspPartitionMmap", "esp_partition_mmap")) return false
    if (!internalFunction("esp32RecoveredEspPartitionMunmap", "esp_partition_munmap")) return false
    if (!exportFunction("esp32RecoveredEspPartitionRead", "esp_partition_read")) return false
    if (!internalFunction("esp32RecoveredEspPartitionGetSha256", "esp_partition_get_sha256")) return false
    if (!internalFunction("esp32RecoveredEspPartitionCheckIdentity", "esp_partition_check_identity")) return false
    if (!internalFunction("esp32RecoveredEspPartitionIsFlashRegionWritable", "esp_partition_is_flash_region_writable")) return false
    if (!internalFunction("esp32RecoveredEspPartitionMainFlashRegionSafe", "esp_partition_main_flash_region_safe")) return false
    if (!internalFunction("esp32RecoveredEspPartitionGetMainFlashSectorSize", "esp_partition_get_main_flash_sector_size")) return false
    true
}
