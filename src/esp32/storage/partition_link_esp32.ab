import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNvsPartitionInternals(): bool {
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartitionD1Ev", "_ZN3nvs12NVSPartitionD1Ev")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartition18getPartitionNameEv", "_ZN3nvs12NVSPartition18get_partition_nameEv")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartition11getAddressEv", "_ZN3nvs12NVSPartition11get_addressEv")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartition8getSizeEv", "_ZN3nvs12NVSPartition8get_sizeEv")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartition12getReadonlyEv", "_ZN3nvs12NVSPartition12get_readonlyEv")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartitionD0Ev", "_ZN3nvs12NVSPartitionD0Ev")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartition8readRawEjPvj", "_ZN3nvs12NVSPartition8read_rawEjPvj")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartition4readEjPvj", "_ZN3nvs12NVSPartition4readEjPvj")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartition9writeRawEjPKvj", "_ZN3nvs12NVSPartition9write_rawEjPKvj")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartition5writeEjPKvj", "_ZN3nvs12NVSPartition5writeEjPKvj")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartition11eraseRangeEjj", "_ZN3nvs12NVSPartition11erase_rangeEjj")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartitionC1EPK15espPartitionT", "_ZN3nvs12NVSPartitionC1EPK15esp_partition_t")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartitionD2Ev", "_ZN3nvs12NVSPartitionD2Ev")) return false
    if (!internalFunction("esp32RecoveredZN3nvs12NVSPartitionC2EPK15espPartitionT", "_ZN3nvs12NVSPartitionC2EPK15esp_partition_t")) return false
    true
}
