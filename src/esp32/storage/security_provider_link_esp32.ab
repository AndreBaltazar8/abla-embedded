import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNvsSecurityProviderInternals(): bool {
    if (!internalFunction("esp32NvsSecurityProviderDeregister", "nvs_sec_provider_deregister")) return false
    if (!internalFunction("esp32NvsSecurityProviderIncludeImplementation", "nvs_sec_provider_include_impl")) return false
    true
}
