@inline
trusted fun esp32NvsLookupLoadU32(address:u32):u32=u32(ablaUnsafeLoadU32(
    nativePointerFromAddress(int(address))))

@inline
trusted fun esp32NvsLookupStoreU32(address:u32,value:u32):void=
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)),int(value))

@inline
trusted fun esp32NvsPartitionByLabel(label:u32):u32=
    esp32RecoveredEspPartitionFindFirst(u32(1), u32(2), label)

trusted fun esp32NvsLookupPartition(label:u32,output:u32):u32 {
    val partition=esp32NvsPartitionByLabel(label)
    if(partition==u32(0)) return u32(261)
    if(u32(ablaUnsafeLoadU8(nativePointerFromAddress(
        int(partition+u32(41)))))!=u32(0)) return u32(4377)
    val instance=esp32LibcMalloc(u32(16))
    if(instance==u32(0)) return u32(257)
    esp32RecoveredZN3nvs12NVSPartitionC1EPK15espPartitionT(
        instance,partition,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    esp32NvsLookupStoreU32(output,instance)
    u32(0)
}

trusted fun esp32NvsDestroyEncryptedPartition(instance:u32):void {
    val vtable=esp32NvsLookupLoadU32(instance)
    val destructor=esp32NvsLookupLoadU32(vtable+u32(4))
    val ignored=u32(ablaUnsafeCallI32I32I32I32I32I32I32(
        int(destructor),int(instance),0,0,0,0,0))
}

trusted fun esp32NvsLookupEncryptedPartition(
    label:u32,configuration:u32,output:u32
):u32 {
    val partition=esp32NvsPartitionByLabel(label)
    if(partition==u32(0)) return u32(261)
    if(u32(ablaUnsafeLoadU8(nativePointerFromAddress(
        int(partition+u32(41)))))!=u32(0)) return u32(4377)
    val instance=esp32LibcMalloc(u32(152))
    if(instance==u32(0)) return u32(257)
    esp32RecoveredZN3nvs21NVSEncryptedPartitionC1EPK15espPartitionT(
        instance,partition,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    val result=esp32RecoveredZN3nvs21NVSEncryptedPartition4initEP13nvsSecCfgT(
        instance,configuration,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if(result!=u32(0)) {
        esp32NvsDestroyEncryptedPartition(instance)
        return result
    }
    esp32NvsLookupStoreU32(output,instance)
    u32(0)
}

trusted fun esp32RecoveredZN3nvs16partitionLookup20lookupNvsPartitionEPKcPPNS9PartitionE(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32NvsLookupPartition(a2,a3)
trusted fun esp32RecoveredZN3nvs16partitionLookup30lookupNvsEncryptedPartitionEPKcP13nvsSecCfgTPPNS9PartitionE(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32NvsLookupEncryptedPartition(a2,a3,a4)
