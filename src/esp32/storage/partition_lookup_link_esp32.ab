import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkNvsPartitionLookupInternals(): bool {
    if (!internalFunction("esp32NvsLookupPartition", "_ZN3nvs16partition_lookup20lookup_nvs_partitionEPKcPPNS_9PartitionE")) return false
    if (!internalFunction("esp32NvsLookupEncryptedPartition", "_ZN3nvs16partition_lookup30lookup_nvs_encrypted_partitionEPKcP13nvs_sec_cfg_tPPNS_9PartitionE")) return false
    true
}
