import "partition_lookup_core_esp32.ab"
import "partition_target_esp32.ab"
import "../flash/mmap_esp32.ab"
import "../runtime/libc_heap_esp32.ab"
import "../../xtensa/assembly.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "../flash/spi_init_esp32.ab"

// Compact, typed implementations of the final partition operations. The
// component primitives below are also Abla-owned; keeping these calls ordinary
// lets LLVM inline the complete path and discard unused partition features.

@inline
trusted fun esp32PartitionLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32PartitionLoadU8(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32PartitionStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32PartitionFind(type: u32, subtype: u32, label: u32): u32 =
    esp32RecoveredEspPartitionFind(type, subtype, label)

@inline
trusted fun esp32PartitionGet(iterator: u32): u32 =
    esp32RecoveredEspPartitionGet(iterator)

@inline
trusted fun esp32PartitionNext(iterator: u32): u32 =
    esp32RecoveredEspPartitionNext(iterator)

@inline
trusted fun esp32PartitionRelease(iterator: u32): void {
    esp32RecoveredEspPartitionIteratorRelease(iterator)
    return
}

// Original ABI symbol: esp_partition_verify.
trusted fun esp32PartitionVerify(partition: u32): u32 {
    if (partition == u32(0)) return u32(0)
    val label = if (esp32PartitionLoadU8(partition + u32(24)) != u32(0))
        partition + u32(24) else u32(0)
    var iterator = esp32PartitionFind(
        esp32PartitionLoadU32(partition + u32(4)),
        esp32PartitionLoadU32(partition + u32(8)),
        label
    )
    while (iterator != u32(0)) {
        val candidate = esp32PartitionGet(iterator)
        if (esp32PartitionLoadU32(candidate) ==
                esp32PartitionLoadU32(partition) &&
            esp32PartitionLoadU32(candidate + u32(12)) ==
                esp32PartitionLoadU32(partition + u32(12)) &&
            esp32PartitionLoadU32(candidate + u32(16)) ==
                esp32PartitionLoadU32(partition + u32(16)) &&
            esp32PartitionLoadU8(candidate + u32(41)) ==
                esp32PartitionLoadU8(partition + u32(41))) {
            esp32PartitionRelease(iterator)
            return candidate
        }
        iterator = esp32PartitionNext(iterator)
    }
    u32(0)
}

@inline
trusted fun esp32PartitionEraseRange(
    partition: u32,
    offset: u32,
    size: u32
): u32 = esp32RecoveredEspPartitionEraseRange(
    partition, offset, size, u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0)
)

@inline
trusted fun esp32PartitionRead(
    partition: u32,
    offset: u32,
    output: u32,
    size: u32
): u32 = esp32RecoveredEspPartitionRead(
    partition, offset, output, size, u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0)
)

@inline
trusted fun esp32PartitionWrite(
    partition: u32,
    offset: u32,
    source: u32,
    size: u32
): u32 = esp32RecoveredEspPartitionWrite(
    partition, offset, source, size, u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0)
)

@inline
trusted fun esp32PartitionMmap(
    partition: u32,
    offset: u32,
    size: u32,
    output: u32,
    handle: u32
): u32 = esp32RecoveredEspPartitionMmap(
    partition, offset, size, u32(0), output, handle,
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0)
)

@inline
trusted fun esp32PartitionMunmap(handle: u32): void {
    esp32RecoveredEspPartitionMunmap(
        handle, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

@inline
trusted fun esp32PartitionMmapFreePages(): u32 =
    esp32RecoveredSpiFlashMmapGetFreePages(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )

trusted fun esp32PartitionCopyMapped(
    destination: u32,
    destinationOffset: u32,
    source: u32,
    sourceOffset: u32,
    size: u32
): u32 {
    val outputs = u32(nativeStackAllocate(8))
    var remaining = size
    var sourceCursor = sourceOffset
    var destinationCursor = destinationOffset
    var freePages = esp32PartitionMmapFreePages()
    var attempts = u32(0)
    while (remaining != u32(0)) {
        val capacity = freePages << u32(16)
        val chunk = if (remaining < capacity) remaining else capacity
        esp32PartitionStoreU32(outputs, u32(0))
        val result = esp32PartitionMmap(
            source, sourceCursor, chunk, outputs, outputs + u32(4)
        )
        if (result == u32(0)) {
            attempts = u32(0)
            val writeResult = esp32PartitionWrite(
                destination,
                destinationCursor,
                esp32PartitionLoadU32(outputs),
                chunk
            )
            esp32PartitionMunmap(esp32PartitionLoadU32(outputs + u32(4)))
            if (writeResult != u32(0)) return writeResult
            sourceCursor = sourceCursor + chunk
            destinationCursor = destinationCursor + chunk
            remaining = remaining - chunk
        } else {
            freePages = esp32PartitionMmapFreePages()
            attempts = attempts + u32(1)
            if (attempts >= u32(3)) return result
        }
    }
    u32(0)
}

trusted fun esp32PartitionCopyBuffered(
    destination: u32,
    destinationOffset: u32,
    source: u32,
    sourceOffset: u32,
    size: u32
): u32 {
    var remaining = size
    var sourceCursor = sourceOffset
    var destinationCursor = destinationOffset
    while (remaining != u32(0)) {
        val chunk = if (remaining < u32(4096)) remaining else u32(4096)
        val buffer = esp32LibcMalloc(chunk)
        if (buffer == u32(0)) return u32(0x101)
        val readResult = esp32PartitionRead(source, sourceCursor, buffer, chunk)
        if (readResult != u32(0)) {
            esp32LibcFreeValue(buffer)
            return readResult
        }
        val writeResult = esp32PartitionWrite(
            destination, destinationCursor, buffer, chunk
        )
        esp32LibcFreeValue(buffer)
        if (writeResult != u32(0)) return writeResult
        sourceCursor = sourceCursor + chunk
        destinationCursor = destinationCursor + chunk
        remaining = remaining - chunk
    }
    u32(0)
}

// Original ABI symbol: esp_partition_copy.
trusted fun esp32PartitionCopy(
    destination: u32,
    destinationOffset: u32,
    source: u32,
    sourceOffset: u32,
    requestedSize: u32
): u32 {
    if (source == u32(0) || destination == u32(0) || source == destination) {
        return u32(0x102)
    }
    val sourceSize = esp32PartitionLoadU32(source + u32(16))
    val destinationSize = esp32PartitionLoadU32(destination + u32(16))
    if (sourceOffset > sourceSize || destinationOffset > destinationSize) {
        return u32(0x104)
    }
    val defaultChipAddress = esp32Data_esp_flash_default_chip_926a48fe83
    if (esp32PartitionLoadU32(source) !=
        esp32PartitionLoadU32(defaultChipAddress)) return u32(0x106)

    val size = if (requestedSize == u32(0xffffffff))
        sourceSize - sourceOffset else requestedSize
    val eraseSize = if (requestedSize == u32(0xffffffff))
        destinationSize - destinationOffset else requestedSize
    val sourceEnd = sourceOffset + size
    val destinationEnd = destinationOffset + size
    if (sourceEnd < sourceOffset || sourceEnd > sourceSize ||
        destinationEnd < destinationOffset || destinationEnd > destinationSize) {
        return u32(0x104)
    }
    val alignedEraseSize = (eraseSize + u32(4095)) & u32(0xfffff000)
    val eraseResult = esp32PartitionEraseRange(
        destination, destinationOffset, alignedEraseSize
    )
    if (eraseResult != u32(0)) return eraseResult
    if (esp32PartitionLoadU8(source + u32(41)) != u32(0)) {
        return esp32PartitionCopyMapped(
            destination, destinationOffset, source, sourceOffset, size
        )
    }
    esp32PartitionCopyBuffered(
        destination, destinationOffset, source, sourceOffset, size
    )
}
