import "../runtime/libc_heap_esp32.ab"
import "api_esp32.ab"
import "abla/unsafe/memory"

trusted fun esp32NvsSecurityProviderDeregister(handle: u32): u32 {
    if (handle == u32(0)) return u32(258)
    val schemeData = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(handle + u32(4)))))
    if (schemeData != u32(0)) esp32LibcFreeValue(schemeData)
    esp32LibcFreeValue(handle)
    esp32RecoveredNvsFlashDeregisterSecurityScheme(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    u32(0)
}

trusted fun esp32NvsSecurityProviderIncludeImplementation(): void {}

trusted fun esp32RecoveredNvsSecProviderDeregister(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32NvsSecurityProviderDeregister(a2)
trusted fun esp32RecoveredNvsSecProviderIncludeImpl(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=a2
