import "../rom/basic_system_esp32.ab"
import "abla/unsafe/memory"

// Structured Abla implementation of the NVS Item primitives from nvs_types.cpp.
// Item is the on-flash 32-byte representation; keeping these as pointer-based
// operations avoids introducing a boxed host representation.

@inline
trusted fun esp32NvsItemLoadU8(address:u32):u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32NvsItemLoadU16(address:u32):u32 =
    u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32NvsItemLoadU32(address:u32):u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

trusted fun esp32NvsItemCalculateCrc32(item:u32):u32 {
    var crc = esp32RomCrc32Le(u32(0xffffffff), item, u32(4))
    crc = esp32RomCrc32Le(crc, item + u32(8), u32(16))
    esp32RomCrc32Le(crc, item + u32(24), u32(8))
}

trusted fun esp32NvsItemCalculateCrc32WithoutValue(item:u32):u32 {
    var crc = esp32RomCrc32Le(u32(0xffffffff), item, u32(1))
    crc = esp32RomCrc32Le(crc, item + u32(8), u32(16))
    esp32RomCrc32Le(crc, item + u32(3), u32(1))
}

trusted fun esp32NvsCalculateCrc32(data:u32, size:u32, initialCrc:u32):u32 {
    val initial = if (initialCrc == u32(0)) u32(0xffffffff)
        else esp32NvsItemLoadU32(initialCrc)
    esp32RomCrc32Le(initial, data, size)
}

@inline
fun esp32NvsIsScalarItemType(datatype:u32):bool =
    datatype == u32(1) || datatype == u32(2) ||
    datatype == u32(4) || datatype == u32(8) ||
    datatype == u32(17) || datatype == u32(18) ||
    datatype == u32(20) || datatype == u32(24)

@inline
fun esp32NvsIsVariableItemType(datatype:u32):bool =
    datatype == u32(33) || datatype == u32(65) || datatype == u32(66)

trusted fun esp32NvsItemCheckHeaderConsistency(item:u32, entryIndex:u32):u32 {
    if (esp32NvsItemLoadU32(item + u32(4)) != esp32NvsItemCalculateCrc32(item)) {
        return u32(0)
    }

    val datatype = esp32NvsItemLoadU8(item + u32(1))
    val span = esp32NvsItemLoadU8(item + u32(2))
    val chunkIndex = esp32NvsItemLoadU8(item + u32(3))

    if (esp32NvsIsScalarItemType(datatype)) {
        return if (span == u32(1)) u32(1) else u32(0)
    }

    // ItemType::BLOB_IDX.
    if (datatype == u32(72)) {
        if (span != u32(1) || chunkIndex != u32(255)) return u32(0)
        return if (esp32NvsItemLoadU32(item + u32(24)) <= u32(508000))
            u32(1) else u32(0)
    }

    if (!esp32NvsIsVariableItemType(datatype)) return u32(0)
    // ItemType::BLOB_DATA reserves 0xff as the wildcard used by lookups.
    if (datatype == u32(66) && chunkIndex == u32(255)) return u32(0)

    val pageIndex = entryIndex & u32(255)
    val dataSize = esp32NvsItemLoadU16(item + u32(24))
    val maximumDataSize = ((u32(125) - pageIndex) << u32(5)) & u32(0xffff)
    if (dataSize > maximumDataSize) return u32(0)

    val maximumSpan = (u32(126) - pageIndex) & u32(255)
    if (span > maximumSpan) return u32(0)
    val requiredSpan = (((dataSize + u32(31)) >>> u32(5)) + u32(1)) & u32(255)
    if (span != requiredSpan) return u32(0)
    u32(1)
}

// Temporary source-level ABI adapters for lifted callers that have not yet
// been converted. They remain internal and disappear once those callers do.
trusted fun esp32RecoveredZNK3nvs4Item14calculateCrc32Ev(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 =
    esp32NvsItemCalculateCrc32(a2)

trusted fun esp32RecoveredZNK3nvs4Item26calculateCrc32WithoutValueEv(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 =
    esp32NvsItemCalculateCrc32WithoutValue(a2)

trusted fun esp32RecoveredZN3nvs4Item14calculateCrc32EPKhjPm(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 =
    esp32NvsCalculateCrc32(a2, a3, a4)

trusted fun esp32RecoveredZNK3nvs4Item22checkHeaderConsistencyEh(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 =
    esp32NvsItemCheckHeaderConsistency(a2, a3)
