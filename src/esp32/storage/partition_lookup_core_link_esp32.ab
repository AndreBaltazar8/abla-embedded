import "abla/build"

compile fun esp32Idf6LinkPartitionLookupCore(): bool {
    if (!internalFunction("esp32RecoveredEspPartitionFind", "esp_partition_find")) return false
    if (!internalFunction("esp32RecoveredEspPartitionFindErr", "esp_partition_find_err")) return false
    if (!internalFunction("esp32RecoveredEspPartitionFindFirst", "esp_partition_find_first")) return false
    if (!internalFunction("esp32RecoveredEspPartitionFindFirstErr", "esp_partition_find_first_err")) return false
    if (!internalFunction("esp32RecoveredEspPartitionGet", "esp_partition_get")) return false
    if (!internalFunction("esp32RecoveredEspPartitionIteratorRelease", "esp_partition_iterator_release")) return false
    if (!internalFunction("esp32RecoveredEspPartitionNext", "esp_partition_next")) return false
    true
}
