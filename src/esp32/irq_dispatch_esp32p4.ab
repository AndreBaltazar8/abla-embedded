import "./irq_dispatch_p4_sequence.ab"
import "./irq_config_esp32p4.ab"
trusted fun p4DispatchCore(): int = p4IrqConfigCurrentCore()
trusted fun p4DispatchMasked(): bool = (riscvMachineStatus()&u32(8)) == u32(0)
trusted fun p4DispatchLineEnabled(line: int): bool = p4IrqConfigLineEnabled(line)
trusted fun p4DispatchFence(): void = riscvDeviceMemoryFence()
trusted fun p4DispatchCall(handler: int,frame: int,line: int,core: int,context: int): void = callNativeVoidI32I32I32I32(handler,frame,line,core,context)
// Production callback passed to the raw IRQ entry. Failure disables this CPU
// line to avoid an unhandled interrupt storm; fault remains in the table.
trusted fun esp32P4IrqDispatchEntry(frame: u32,line: u32,core: u32,context: u32): void {
    val table=p4IrqDispatchAt(nativeBufferAt(int(context),272))
    val result=table.dispatchOwned(nativeBufferAt(int(frame),144),int(line),int(core))
    if (result != 1 && int(core) == p4DispatchCore()) esp32P4ClicEnableOwned(int(line),false)
    return
}
trusted fun P4IrqDispatch.publishOwned(): int {
    if (!this.valid()) return 2
    return esp32P4IrqConfigureOwned(this.buffer().loadU32(4),nativeFunctionAddress(esp32P4IrqDispatchEntry),this.buffer().addressValue())
}
