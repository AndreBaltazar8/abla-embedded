import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "../riscv/memory.ab"
import "./ahb_gdma_ring_c5_sequence.ab"
trusted fun c5AhbGdmaDescriptorRead(address: int): u32 = u32(mmioLoadU32(address))
trusted fun c5AhbGdmaDescriptorWrite(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
trusted fun c5AhbGdmaDescriptorFence(): void = riscvDeviceMemoryFence()
