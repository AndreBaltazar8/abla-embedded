import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "../riscv/memory.ab"
import "./ahb_gdma_ring_c5_sequence.ab"
import "../hal/esp32.ab"
@export("c5AhbGdmaDescriptorRead")
trusted fun c5AhbGdmaDescriptorReadHook(address: int): u32 = u32(mmioLoadU32(address))
@export("c5AhbGdmaDescriptorWrite")
trusted fun c5AhbGdmaDescriptorWriteHook(address: int,value: u32): void { mmioStoreU32(address,int(value));return }
@export("c5AhbGdmaDescriptorFence")
trusted fun c5AhbGdmaDescriptorFenceHook(): void = riscvDeviceMemoryFence()
