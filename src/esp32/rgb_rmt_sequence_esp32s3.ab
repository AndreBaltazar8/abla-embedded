import "../led/types.ab"
import "../led/rmt_strip_logic.ab"
import "../led/rmt_encode.ab"

// 10MHz ticks, GRB order,24 bits plus280us reset-low symbol. Caller owns
// writable104-byte staging; three scratch bytes follow the100-byte waveform.
trusted fun esp32s3RmtRgbFrame(color: RgbColor, staging: NativeBuffer): bool {
    if (!staging.hasAddressRange(0, 104)) return false
    val bytes = nativeBufferAt(staging.addressValue() + 100, 3)
    bytes.store(0, color.green()); bytes.store(1, color.red()); bytes.store(2, color.blue())
    if (!rmtEncodeBytes(bytes, 3, nativeBufferAt(staging.addressValue(), 96),
        u32(rmtLedSymbol(4, 8)), u32(rmtLedSymbol(8, 4)), true)) return false
    staging.storeU32(96, rmtLedResetSymbol(2800))
}

// Caller owns stopped TX channel/block, pad and staging. Group must already
// use stable80MHz APB with divider1, active clock and powered nonFIFO memory.
// Pad must be released from RTC/USB/other peripherals. The280us low reset is
// clocked out before DONE, not approximated by host delay or a busy loop.
// Low status2 invalid,9 route failure; otherwise transmit result unchanged.
trusted fun esp32s3RmtWriteRgbOwned(output: Pin, channel: int, color: RgbColor,
    staging: NativeBuffer, polls: int): int {
    if (!output.outputCapable() || channel < 0 || channel > 3 || polls < 1 ||
        polls > 1000000 || !staging.hasAddressRange(0, 104) ||
        (staging.addressValue() < 0x60016e00 && staging.addressValue() + 104 > 0x60016800)) return 2
    if (!esp32s3RmtRgbFrame(color, staging)) return 2
    // Establish idle-low before attaching the peripheral to the pad.
    if (!esp32s3RmtConfigureSingleBlockTxOwned(channel, 8)) return 3
    if (!output.routeOutputSignal(81 + channel, false)) return 9
    esp32s3RmtTransmitPreparedFrameOwned(channel, staging, 25, polls)
}
