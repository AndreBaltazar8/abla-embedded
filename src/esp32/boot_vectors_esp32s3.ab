// Root both private functions through an ordinary main-side address check;
// naked bodies intentionally permit no operand-evaluation code.
@inline
trusted fun esp32S3BootVectorAddress(): int = int(esp32S3BootVectorAddressAssembly("movi $0, .Labla_s3_boot_vectors", "=r,i,i,~{memory}", u32(nativeFunctionAddress(esp32S3BootVectors)), u32(nativeFunctionAddress(esp32S3WindowVectors))))
// Early, BSS-independent vectors. Direct jumps preserve all window registers
// and reuse the runtime spill/fill implementation. MOVSP uses the same alloca
// path as the runtime user vector; all other exceptions halt without a stack,
// callbacks, allocation or MMIO. Runtime later installs its complete policy.
// Link this section aligned1024 in internal memory, within J range of windows.
