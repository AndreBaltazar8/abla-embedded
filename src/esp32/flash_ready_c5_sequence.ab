import "./flash_status_c5_sequence.ab"
//120B retained session:tag0,state4,phase8,SR1|SR2<<8 at12,immutable SUSmask16,
// completed busy samples20, actual SR1 child48@24 and SR2 child48@72.
//1ready2invalid3pending4suspended.1/4 are terminal snapshots, no owned register
// changes remain. Caller retains chip/controller ownership until acting on the
// result; no automatic RESUME, reset, erase cancellation, or WEL/status writes.
// Requires caller-qualified command05 WIP bit0 and command35 SUS mask1..255.
// IDF uses80 for supported Winbond suspend chips,84 for supported GD chips;
// these are NOT universal manufacturer-wide guarantees. Identify the chip.
// At most one busy SR1 sample or one SR1/SR2 pair per call, with each hardware
// command bounded by polls. Restore each child fully before starting the next.
@section(".iram1.abla.c5FlashReady")
trusted fun esp32C5FlashReadyOwned(record: NativeBuffer,suspendMask: int,polls: int,exclusiveQualifiedChip: bool): int {
    if (!exclusiveQualifiedChip || !record.hasAddressRange(0,120) || (record.addressValue()&3) != 0 ||
        suspendMask < 1 || suspendMask > 255 || polls < 1 || polls > 1000000) return 2
    val tag=c5SleepRecordRead(record,0)
    if (tag != 0 && tag != 0x43465231) return 2
    if (tag == 0) {
        c5SleepRecordWrite(record,16,suspendMask);c5SleepRecordWrite(record,20,0)
        c5SleepRecordWrite(record,8,0);c5SleepRecordWrite(record,12,0)
        c5SleepRecordWrite(record,24,0);c5SleepRecordWrite(record,72,0)
        c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,0,0x43465231)
    } else {
        if (c5SleepRecordRead(record,16) != suspendMask) return 2
        if (c5SleepRecordRead(record,4) == 1) return 1
        if (c5SleepRecordRead(record,4) == 4) return 4
        if (c5SleepRecordRead(record,4) != 3 || c5SleepRecordRead(record,8) > 1) return 2
    }
    val base=record.addressValue()
    if (c5SleepRecordRead(record,8) == 0) {
        val result=esp32C5FlashStatusReadOwned(nativeBufferAt(base+24,48),polls,true,5)
        if (result != 1) return result
        val sr1=c5SleepRecordRead(record,36)
        c5SleepRecordWrite(record,12,sr1)
        if ((sr1&1) != 0) {
            // This child is fully restored; only now may a fresh sample start.
            c5SleepRecordWrite(record,24,0)
            val samples=c5SleepRecordRead(record,20)
            if (samples < 0xffffffff) c5SleepRecordWrite(record,20,samples+1)
            return 3
        }
        c5SleepRecordWrite(record,8,1)
    }
    val result=esp32C5FlashStatusReadOwned(nativeBufferAt(base+72,48),polls,true,0x35)
    if (result != 1) return result
    val sr2=c5SleepRecordRead(record,84)
    c5SleepRecordWrite(record,12,c5SleepRecordRead(record,12)|(sr2<<8))
    val state=if ((sr2&suspendMask) != 0) 4 else 1
    c5SleepRecordWrite(record,8,2);c5SleepRecordWrite(record,4,state)
    state
}
