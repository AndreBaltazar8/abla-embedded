import "./cpu_clock_c5_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
@section(".iram1.abla.c5CpuClockRead")
trusted fun c5CpuClockRead(offset: int): int = mmioLoadU32(0x60096000+offset)
@section(".iram1.abla.c5CpuClockWrite")
trusted fun c5CpuClockWrite(offset: int,value: int): void { mmioStoreU32(0x60096000+offset,value);return }
// Hardware ROM ets_update_cpu_frequency, C5 ROM linker map.
@section(".iram1.abla.c5CpuClockTicks")
trusted fun c5CpuClockTicks(mhz: int): void { callNativeVoidI32(0x40000044,mhz);return }
