import "./cpu_clock_c5_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../hal/esp32.ab"
@section(".iram1.abla.c5CpuClockRead")
@export("c5CpuClockRead")
trusted fun c5CpuClockReadHook(offset: int): int = mmioLoadU32(0x60096000+offset)
@section(".iram1.abla.c5CpuClockWrite")
@export("c5CpuClockWrite")
trusted fun c5CpuClockWriteHook(offset: int,value: int): void { mmioStoreU32(0x60096000+offset,value);return }
// Hardware ROM ets_update_cpu_frequency, C5 ROM linker map.
@section(".iram1.abla.c5CpuClockTicks")
@export("c5CpuClockTicks")
trusted fun c5CpuClockTicksHook(mhz: int): void { callNativeVoidI32(0x40000044,mhz);return }
