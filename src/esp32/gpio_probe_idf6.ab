import "./gpio_probe_logic.ab"
import "./gpio/driver_esp32.ab"
import "./rom/system_esp32.ab"
import "./sdk/buffer.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32GpioProbeRecoveredCall(
    operation: int,
    pin: i32,
    value: u32
): i32 {
    val pinWord = u32(pin)
    val result = when (operation) {
        0 -> esp32RecoveredGpioSetDirection(
            pinWord, value, u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        1 -> esp32RecoveredGpioSetPullMode(
            pinWord, value, u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        2 -> esp32RecoveredGpioSetDriveCapability(
            pinWord, value, u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        3 -> esp32RecoveredGpioSetLevel(
            pinWord, value, u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
        else -> esp32RecoveredGpioGetLevel(
            pinWord, u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    }
    i32(result)
}

@inline
trusted noescape fun gpio_get_io_config(
    pin: i32,
    configuration: i64*
): i32 = i32(esp32RecoveredGpioGetIoConfig(
    u32(pin), u32(nativePointerAddress(configuration)),
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0)
))

@inline
trusted noescape fun gpio_set_direction(pin: i32, mode: i32): i32 =
    esp32GpioProbeRecoveredCall(0, pin, u32(mode))

@inline
trusted noescape fun gpio_set_pull_mode(pin: i32, mode: i32): i32 =
    esp32GpioProbeRecoveredCall(1, pin, u32(mode))

@inline
trusted noescape fun gpio_set_drive_capability(
    pin: i32,
    drive: i32
): i32 = esp32GpioProbeRecoveredCall(2, pin, u32(drive))

@inline
trusted noescape fun gpio_set_level(pin: i32, level: u32): i32 =
    esp32GpioProbeRecoveredCall(3, pin, level)

@inline
trusted noescape fun gpio_get_level(pin: i32): i32 =
    esp32GpioProbeRecoveredCall(4, pin, u32(0))

@inline
trusted noescape fun esp_rom_delay_us(microseconds: u32): void =
    esp32RomDelayUs(microseconds)

import "./gpio_probe_common.ab"
