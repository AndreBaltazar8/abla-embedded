// One aligned atomic word in retained internal RAM, initialized0 BEFORE
// releasing CPU1. One boot only; never reuse after timeout or while CPU1 lives.
//0idle,1requested,2CPU1 initialized/waiting,3primary permits shared-memory use,
//4CPU1 running,5CPU1 initialization failed. Every CAS is acquire/release.
// Readiness must be published only AFTER vectors, stack, protection and local
// runtime initialization, not merely after core_local_init or ROM publication.
@inline
fun esp32S3StartupMailboxValid(address: int): bool = address > 0 && address <= 0xFFFFFFFC && (address & 3) == 0
@section(".iram1.abla.s3StartupStatus")
trusted fun esp32S3StartupStatusOwned(address: int): int {
    if (!esp32S3StartupMailboxValid(address)) return -1
    val state=esp32S3StartupCas(address,0,0)
    if (state < 0 || state > 5) return -1
    state
}
// Call once before publishing ROM entry. Already-requested is not success:
// callers must not start/reset the other CPU twice after an observation timeout.
@section(".iram1.abla.s3StartupRequest")
trusted fun esp32S3StartupRequestOwned(address: int): bool {
    if (!esp32S3StartupMailboxValid(address) || esp32S3StartupCore() != 0) return false
    esp32S3StartupCas(address,0,1) == 0
}
@section(".iram1.abla.s3StartupInitialized")
trusted fun esp32S3StartupInitializedOwned(address: int,success: bool): bool {
    if (!esp32S3StartupMailboxValid(address) || esp32S3StartupCore() != 1) return false
    esp32S3StartupCas(address,1,if (success) 2 else 5) == 1
}
// Primary calls after its own shared startup/flash setup is complete.
@section(".iram1.abla.s3StartupRelease")
trusted fun esp32S3StartupReleaseOwned(address: int): bool {
    if (!esp32S3StartupMailboxValid(address) || esp32S3StartupCore() != 0) return false
    esp32S3StartupCas(address,2,3) == 2
}
// CPU1 may leave the internal-memory startup wait ONLY on success here.
@section(".iram1.abla.s3StartupRunning")
trusted fun esp32S3StartupRunningOwned(address: int): bool {
    if (!esp32S3StartupMailboxValid(address) || esp32S3StartupCore() != 1) return false
    esp32S3StartupCas(address,3,4) == 3
}
