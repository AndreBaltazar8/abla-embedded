// IDF6.0.2 P4 interrupt_core0/1 register layouts. Source0..127 contiguous;
// layout3 adds133..135.128..132 are status/control registers, NOT routes.
// Each core has independent source mapping; bits6+ include security flags.
// Caller owns source+CPU line, disables source/CPU delivery, joins handlers,
// and serializes matrix RMW across cores. No CPU/CLIC enabling is done here.
fun p4InterruptRouteAddress(layout: int,core: int,source: int): int {
    if ((layout != 1 && layout != 3) || core < 0 || core > 1 || source < 0 ||
        !(source <= 127 || (layout == 3 && source >= 133 && source <= 135))) return 0
    return 0x500d6000+core*2048+source*4
}
// External CLIC lines16..47,0disconnect. Local/software/timer lines1..15
// intentionally excluded from this peripheral routing API.
fun p4InterruptRouteTargetValid(target: int): bool = target == 0 || (target >= 16 && target <= 47)
trusted fun esp32P4InterruptRouteReadOwned(layout: int,core: int,source: int): int {
    val address=p4InterruptRouteAddress(layout,core,source)
    if (address == 0) return -1
    return int(p4InterruptRouteRead(address)&u32(63))
}
// 1verified,2invalid/no MMIO,3unexpected existing mapping/no write,
// 4readback failure (retain source/line lease). expected is checked under the
// caller's lock, not a CAS primitive. Preserve all non-routing/security bits.
trusted fun esp32P4InterruptRouteOwned(layout: int,core: int,source: int,expected: int,target: int): int {
    val address=p4InterruptRouteAddress(layout,core,source)
    if (address == 0 || !p4InterruptRouteTargetValid(expected) || !p4InterruptRouteTargetValid(target)) return 2
    val before=p4InterruptRouteRead(address)
    if ((before&u32(63)) != u32(expected)) return 3
    if (expected == target) return 1
    p4InterruptRouteWrite(address,(before&u32(4294967232))|u32(target))
    return if ((p4InterruptRouteRead(address)&u32(63)) == u32(target)) 1 else 4
}
