import "./peer_binding_s3_sequence.ab"
// Bind only to the actual Abla IRQ runtime (direct or scheduler-adapted).
// Both cores' configuration must remain serialized during this check/setup.
// This verifies installed storage/dispatcher identity, NOT scheduler locks,
// vector-base installation, DMA idleness or worst-case interrupt stack depth.
fun s3PeerRuntimeRange(address: int,size: int): bool = size > 0 && address >= 0x3FC88000 && address+size <= 0x3FD00000 && (address&3) == 0
fun s3PeerRuntimeStorageClear(r: NativeBuffer,mailbox: NativeBuffer,address: int,size: int): bool =
    !s3PeerBindingOverlap(r.addressValue(),64,address,size) && !s3PeerBindingOverlap(mailbox.addressValue(),4,address,size)
trusted fun esp32S3PeerRuntimeReadyOwned(r: NativeBuffer,table: NativeBuffer,mailbox: NativeBuffer): bool {
    if (!s3PeerBindingBuffers(r,table,mailbox) || !s3PeerRuntimeRange(r.addressValue(),64) ||
        !s3PeerRuntimeRange(table.addressValue(),512) || !s3PeerRuntimeRange(mailbox.addressValue(),4)) return false
    val core=esp32S3InterruptInstallCore()
    if (core < 0 || core > 1) return false
    val cfg=esp32S3PeerRuntimeConfig()
    if (!s3PeerRuntimeRange(cfg,64) || !s3PeerRuntimeStorageClear(r,mailbox,cfg,64) ||
        s3PeerBindingOverlap(table.addressValue(),512,cfg,64)) return false
    var index=0
    while (index < 2) {
        val entry=cfg+index*32
        val stackPointer=esp32S3PeerRuntimeRead(entry)
        if (stackPointer == 0) { if (index == core) return false }
        else {
            if (esp32S3PeerRuntimeRead(entry+4) != 0 || esp32S3PeerRuntimeRead(entry+24) != 0) return false
            val low=esp32S3PeerRuntimeRead(entry+16);val end=esp32S3PeerRuntimeRead(entry+20)
            if (end-low < 1024 || ((low|end)&15) != 0 || !s3PeerRuntimeRange(low,end-low) || stackPointer != end-48 ||
                !s3PeerRuntimeStorageClear(r,mailbox,low,end-low) || s3PeerBindingOverlap(table.addressValue(),512,low,end-low)) return false
            val callback=esp32S3PeerRuntimeRead(entry+8)
            var runtime=esp32S3PeerRuntimeRead(entry+12)
            if (callback == esp32S3PeerRuntimeSchedulerAddress()) {
                if (!s3PeerRuntimeRange(runtime,12) || !s3PeerRuntimeStorageClear(r,mailbox,runtime,12) ||
                    s3PeerBindingOverlap(table.addressValue(),512,runtime,12)) return false
                runtime=esp32S3PeerRuntimeRead(runtime)
            } else if (callback != esp32S3PeerRuntimeDirectAddress()) return false
            if (!s3PeerRuntimeRange(runtime,16) || !s3PeerRuntimeStorageClear(r,mailbox,runtime,16) ||
                s3PeerBindingOverlap(table.addressValue(),512,runtime,16)) return false
            val dispatcher=esp32S3PeerRuntimeRead(runtime)
            if (!s3PeerRuntimeRange(dispatcher,512) || !s3PeerRuntimeStorageClear(r,mailbox,dispatcher,512)) return false
            if (index == core && dispatcher != table.addressValue()) return false
            // Shared table is supported, partial overlap with another table is
            // not: installing one callback must not overwrite its neighbor.
            if (dispatcher != table.addressValue() && s3PeerBindingOverlap(table.addressValue(),512,dispatcher,512)) return false
        }
        index=index+1
    }
    return true
}
trusted fun esp32S3PeerBindingOpenRuntimeOwned(r: NativeBuffer,table: NativeBuffer,mailbox: NativeBuffer,channel: int,line: int,exclusiveStopped: bool): int {
    if (!exclusiveStopped || !esp32S3PeerRuntimeReadyOwned(r,table,mailbox)) return 3
    return esp32S3PeerBindingOpenOwned(r,table,mailbox,channel,line,true)
}
