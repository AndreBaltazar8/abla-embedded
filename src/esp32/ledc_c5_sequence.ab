// ESP-IDF v6.0.2 C5 LEDC LL/register definitions (four 20-bit timers).
// Low-level timer operations: caller exclusively owns the timer AND every
// channel selecting it, pins the shared source/APB clocks, and excludes reset,
// interrupts and ETM tasks. This module does not acquire clocks or route GPIO.
// Status: 1 success, 2 invalid, 3 live timer, 4 readback failure, 5 update busy.
// Failures retain ownership; configuration remains paused, never forced live.
fun c5LedcTimerOffset(timer: int): int = if (timer < 0 || timer > 3) -1 else 160+timer*8
fun c5LedcTimerParameters(resolution: int,divider: int): int =
    if (resolution < 1 || resolution > 20 || divider < 256 || divider > 262143) -1 else resolution|(divider<<5)

// Nearest Q10.8 divider, no floating point or runtime division helper.
// Source frequency must be established by the caller, not inferred from CPU.
// Invalid/unattainable requests return -1, never silently clamp the divider.
fun c5LedcDividerForHz(sourceHz: int,hz: int,resolution: int): int {
    if (sourceHz < 1 || sourceHz > 80000000 || hz < 1 || hz > sourceHz || resolution < 1 || resolution > 20) return -1
    var precision=1; var bits=0
    while (bits < resolution) { precision=precision*2; bits=bits+1 }
    val denominator=hz*precision
    if (denominator > sourceHz) return -1
    val numerator=sourceHz*256
    var divisor=0; var bit=131072
    while (bit > 0) {
        val candidate=divisor+bit
        if (denominator*candidate <= numerator) divisor=candidate
        bit=bit/2
    }
    if ((numerator-denominator*divisor)*2 >= denominator) divisor=divisor+1
    return if (divisor < 256 || divisor > 262143) -1 else divisor
}
trusted fun c5LedcTimerConfigurePausedOwned(timer: int,resolution: int,divider: int): int {
    val offset=c5LedcTimerOffset(timer); val parameters=c5LedcTimerParameters(resolution,divider)
    if (offset < 0 || parameters < 0) return 2
    val before=c5LedcRead(offset)
    if ((before&0x4000000) != 0) return 5
    if ((before&0x1800000) == 0) return 3
    // Keep reserved bits, hold pause, release reset, then explicitly publish.
    val value=(before&0xfa000000)|0x800000|parameters
    c5LedcWrite(offset,value)
    if ((c5LedcRead(offset)&0x1ffffff) != (value&0x1ffffff)) return 4
    c5LedcWrite(offset,value|0x4000000)
    // PARA_UP is self-clearing: do not mistake a pending update for failure or
    // claim that register readback proves the asynchronous update completed.
    return 1
}
trusted fun c5LedcTimerPauseOwned(timer: int): int {
    val offset=c5LedcTimerOffset(timer)
    if (offset < 0) return 2
    val before=c5LedcRead(offset)
    c5LedcWrite(offset,(before&0xfbffffff)|0x800000)
    return if ((c5LedcRead(offset)&0x800000) != 0) 1 else 4
}
trusted fun c5LedcTimerResumeOwned(timer: int): int {
    val offset=c5LedcTimerOffset(timer)
    if (offset < 0) return 2
    val before=c5LedcRead(offset)
    if ((before&0x4000000) != 0) return 5
    if ((before&0x1000000) != 0 || c5LedcTimerParameters(before&31,(before>>5)&262143) < 0) return 2
    c5LedcWrite(offset,before&0xff7fffff)
    return if ((c5LedcRead(offset)&0x1800000) == 0) 1 else 4
}
