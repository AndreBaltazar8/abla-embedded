import "./adc_power_c5_sequence.ab"
// Shared SAR/PWDET/TSENS front end, IDF6 C5 sar_periph_ctrl/regi2c_ctrl LL.
// Caller owns modem/PHY/LP/TSENS/PMU/analog masters, stable FE80/APB and analog
// master clocks, no sleep/reset/interrupt users. All ADC work has settled.
// Cold initialization resets SAR/TSENS analog configuration: explicit consent
// certifies there is NO live configuration to preserve. Do this BEFORE trim.
// FE_APB/FE80 gates remain enabled after close, matching C5 modem_clock_hal
// which intentionally only enables common FE clocks. No symmetric gate-off.
// status0closed1ready2authority3clocks/busy4cold-required5write.
// oldPMU2@8,oldPWDET2@10,oldroute@12,valid13,attemptPMU14/PWDET15/route16.
type C5AdcFrontend=int
fun C5AdcFrontend.status(): int = this&255
fun C5AdcFrontend.ready(): bool = this.status() == 1
trusted fun c5AdcFrontendIdle(): bool = c5AdcClocksReady() && c5AdcAllStopped() &&
    (c5AdcFrontendRead(12)&u32(4)) != u32(0) &&
    ((c5AdcFrontendRead(16)|c5AdcFrontendRead(20))&u32(0x2000000)) == u32(0)
trusted fun c5AdcFrontendField(offset: int,mask: u32,value: u32): bool {
    val old=c5AdcFrontendRead(offset)
    if ((old&mask) != value) c5AdcFrontendWrite(offset,(old&~mask)|value)
    return (c5AdcFrontendRead(offset)&mask) == value
}
trusted fun c5AdcFrontendOpenOwned(exclusiveStopped: bool,coldInitializationSafe: bool): C5AdcFrontend {
    if (!exclusiveStopped) return C5AdcFrontend(2)
    if (!c5AdcFrontendIdle()) return C5AdcFrontend(3)
    val pmu=int((c5AdcFrontendRead(4)>>u32(26))&u32(3))
    if (pmu != 3 && !coldInitializationSafe) return C5AdcFrontend(4)
    var token=(1<<13)|(pmu<<8)|(int((c5AdcFrontendRead(8)>>u32(23))&u32(3))<<10)|
        (int((c5AdcRead(0)>>u32(29))&u32(1))<<12)
    if (!c5AdcFrontendField(0,u32(0x8000),u32(0x8000)) || !c5AdcFrontendField(0,u32(0x2000),u32(0x2000))) return C5AdcFrontend(token|5)
    if (pmu != 3) {
        token=token|(1<<14)
        if (!c5AdcFrontendField(4,u32(0x4000000),u32(0)) ||
            !c5AdcFrontendField(4,u32(0x8000000),u32(0x8000000)) ||
            !c5AdcFrontendField(4,u32(0x4000000),u32(0x4000000))) return C5AdcFrontend(token|5)
    }
    token=token|(1<<15)
    if (!c5AdcFrontendField(8,u32(0x1000000),u32(0x1000000)) ||
        !c5AdcFrontendField(8,u32(0x800000),u32(0x800000))) return C5AdcFrontend(token|5)
    token=token|(1<<16)
    if (!c5AdcPowerField(u32(0x20000000),u32(0x20000000))) return C5AdcFrontend(token|5)
    return C5AdcFrontend(token|1)
}
// Close after restoring all ADC children and joining both analog masters.
// No previous analog register contents promised after a qualified cold reset.
trusted fun C5AdcFrontend.closeOwned(exclusiveStopped: bool): C5AdcFrontend {
    if (!exclusiveStopped || this < 0 || (this&~0x1ffff) != 0 || (this&8192) == 0 || this.status() > 5) return this
    var token=this&~255
    if (!c5AdcFrontendIdle()) return C5AdcFrontend(token|3)
    if ((token&65536) != 0) {
        if (!c5AdcPowerField(u32(0x20000000),u32((token>>>12)&1)<<u32(29))) return C5AdcFrontend(token|5)
        token=token&~65536
    }
    if ((token&32768) != 0) {
        if (!c5AdcFrontendField(8,u32(0x1800000),u32((token>>>10)&3)<<u32(23))) return C5AdcFrontend(token|5)
        token=token&~32768
    }
    if ((token&16384) != 0) {
        if (!c5AdcFrontendField(4,u32(0xc000000),u32((token>>>8)&3)<<u32(26))) return C5AdcFrontend(token|5)
    }
    return C5AdcFrontend(0)
}
