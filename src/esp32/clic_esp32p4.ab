import "./clic_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../riscv/machine_status.ab"
import "../hal/esp32.ab"
@export("p4ClicMachineStatus")
trusted fun p4ClicMachineStatusHook(): u32 = riscvMachineStatus()
@export("p4ClicWriteConfig")
trusted fun p4ClicWriteConfigHook(value: int): void { mmioStoreU32(0x20800000,value); return }
@export("p4ClicReadConfig")
trusted fun p4ClicReadConfigHook(): int = mmioLoadU32(0x20800000)
@export("p4ClicReadByte")
trusted fun p4ClicReadByteHook(address: int): int = mmioLoadU8(address)
@export("p4ClicWriteByte")
trusted fun p4ClicWriteByteHook(address: int,value: int): void { mmioStoreU8(address,value); return }
