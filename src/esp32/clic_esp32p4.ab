import "./clic_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../riscv/machine_status.ab"
trusted fun p4ClicMachineStatus(): u32 = riscvMachineStatus()
trusted fun p4ClicWriteConfig(value: int): void { mmioStoreU32(0x20800000,value); return }
trusted fun p4ClicReadConfig(): int = mmioLoadU32(0x20800000)
trusted fun p4ClicReadByte(address: int): int = mmioLoadU8(address)
trusted fun p4ClicWriteByte(address: int,value: int): void { mmioStoreU8(address,value); return }
