import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkXtensaInterruptAssemblyInternals(): bool {
    if (!internalFunction("esp32RecoveredXtIntsOn", "xt_ints_on")) return false
    if (!internalFunction("esp32RecoveredXtIntsOff", "xt_ints_off")) return false
    true
}
