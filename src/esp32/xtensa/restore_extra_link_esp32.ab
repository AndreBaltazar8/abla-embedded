import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkXtensaRestoreExtraOpaqueCallers(): bool {
    if (!exportFunction("esp32RecoveredXthalRestoreExtraNw", "xthal_restore_extra_nw")) return false
    true
}
