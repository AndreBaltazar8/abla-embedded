import "../../xtensa/assembly.ab"

// XEA2 implementation of the Xtensa OS run-time interrupt-level helper.
// The architecture-specific PS access is parsed by the Xtensa package; the
// ABI function itself is ordinary typed Abla in the monolithic LLVM module.
//
// Original ABI symbol: _xtos_set_intlevel
@noinline
@section(".iram1.0.abla.esp32XtensaSetInterruptLevel")
trusted fun esp32XtensaSetInterruptLevel(value: u32): u32 =
    xtensaSetInterruptLevel(value)
