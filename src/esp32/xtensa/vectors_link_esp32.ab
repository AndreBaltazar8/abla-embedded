import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkXtensaVectorsInternals(): bool {
    if (!internalFunction(
        "esp32XtHandleExceptionBody",
        "abla_esp32_xt_handle_exception_body"
    )) return false
    if (!internalFunction(
        "esp32XtHandleException",
        "abla_esp32_xt_handle_exc"
    )) return false
    if (!internalFunction(
        "esp32XtAllocaException",
        "abla_esp32_xt_alloca_exc"
    )) return false
    if (!internalFunction("esp32XtUserException", "abla_esp32_xt_user_exc")) return false
    if (!internalFunction("esp32XtSyscallException", "abla_esp32_xt_syscall_exc")) return false
    if (!internalFunction("esp32XtCoprocessorException", "abla_esp32_xt_coproc_exc")) return false
    if (!internalFunction("esp32XtLowInterrupt1", "abla_esp32_xt_lowint1")) return false
    if (!internalFunction("esp32XtMediumInterrupt2", "abla_esp32_xt_medint2")) return false
    if (!internalFunction("esp32XtMediumInterrupt3", "abla_esp32_xt_medint3")) return false
    if (!internalFunction("esp32RecoveredXtDebugexception", "xt_debugexception")) return false
    if (!requiredInternalFunction("esp32DebugExceptionVector", "_DebugExceptionVector")) return false
    if (!requiredInternalFunction("esp32KernelExceptionVector", "_KernelExceptionVector")) return false
    if (!internalFunction("esp32XtKernelException", "abla_esp32_xt_kernel_exc")) return false
    if (!requiredInternalFunction("esp32DoubleExceptionVector", "_DoubleExceptionVector")) return false
    if (!requiredInternalFunction("esp32RecoveredUserExceptionVector", "_UserExceptionVector")) return false
    if (!internalFunction("esp32RecoveredXtUserExit", "_xt_user_exit")) return false
    if (!requiredInternalFunction("esp32RecoveredLevel2Vector", "_Level2Vector")) return false
    if (!internalFunction("esp32RecoveredXtMedint2Exit", "_xt_medint2_exit")) return false
    if (!requiredInternalFunction("esp32RecoveredLevel3Vector", "_Level3Vector")) return false
    if (!internalFunction("esp32RecoveredXtMedint3Exit", "_xt_medint3_exit")) return false
    if (!requiredInternalFunction("esp32RecoveredLevel4Vector", "_Level4Vector")) return false
    if (!requiredInternalFunction("esp32RecoveredLevel5Vector", "_Level5Vector")) return false
    if (!internalFunction("esp32RecoveredXtHighint5", "xt_highint5")) return false
    if (!requiredInternalFunction("esp32RecoveredNMIExceptionVector", "_NMIExceptionVector")) return false
    if (!internalFunction("esp32RecoveredXtNmi", "xt_nmi")) return false
    if (!requiredInternalFunction("esp32WindowOverflow4", "_WindowOverflow4")) return false
    if (!requiredInternalFunction("esp32WindowUnderflow4", "_WindowUnderflow4")) return false
    if (!requiredInternalFunction("esp32WindowOverflow8", "_WindowOverflow8")) return false
    if (!requiredInternalFunction("esp32WindowUnderflow8", "_WindowUnderflow8")) return false
    if (!requiredInternalFunction("esp32WindowOverflow12", "_WindowOverflow12")) return false
    if (!requiredInternalFunction("esp32WindowUnderflow12", "_WindowUnderflow12")) return false
    if (!requiredInternalFunction("esp32RecoveredInvalidPcPlaceholder", "_invalid_pc_placeholder")) return false
    if (!internalFunction("esp32RecoveredXtDebugexceptionAlias", "_xt_debugexception")) return false
    if (!internalFunction("esp32RecoveredXtHighint4Alias", "_xt_highint4")) return false
    if (!internalFunction("esp32RecoveredXtHighint5Alias", "_xt_highint5")) return false
    if (!internalFunction("esp32RecoveredXtNmiAlias", "_xt_nmi")) return false
    true
}
