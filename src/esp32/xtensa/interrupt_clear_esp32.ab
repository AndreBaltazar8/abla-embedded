import "../../xtensa/assembly.ab"

// Abla/LLVM reconstruction of Xtensa HAL int_asm--set_intclear.o. The CPU
// register operation is parsed by the Xtensa target package; its argument and
// return path remain ordinary typed Abla.

// Original ABI symbol: xthal_set_intclear
@section(".iram1.abla.xtensa.set_intclear")
@inline
trusted fun esp32RecoveredXthalSetIntclear(mask: u32): void =
    xtensaWritePendingInterruptClear(mask)
