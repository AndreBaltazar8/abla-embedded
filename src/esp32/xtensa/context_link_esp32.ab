import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkXtensaContextInternals(): bool {
    if (!internalFunction("esp32RecoveredXtContextSave", "_xt_context_save")) return false
    if (!internalFunction("esp32RecoveredXtContextRestore", "_xt_context_restore")) return false
    if (!internalFunction("esp32RecoveredXtCoprocInit", "_xt_coproc_init")) return false
    if (!internalFunction("esp32RecoveredXtCoprocRelease", "_xt_coproc_release")) return false
    // These two leaves are named only by target-subparser output emitted after
    // ordinary source reachability has closed. Keep them local, but retain
    // their bodies for the backend-introduced CALL0 relocations.
    if (!requiredInternalFunction("esp32RecoveredXtCoprocSavecs", "_xt_coproc_savecs")) return false
    if (!requiredInternalFunction("esp32RecoveredXtCoprocRestorecs", "_xt_coproc_restorecs")) return false
    true
}
