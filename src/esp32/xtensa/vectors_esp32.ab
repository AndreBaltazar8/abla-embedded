// Change the current core's coprocessor owner under the shared lock and return
// the prior save-area pointer. This is ordinary atomic and memory policy; only
// the surrounding exception frame and physical coprocessor-register transfer
// belong in the Xtensa boundary.
@section(".iram1.abla.xtensa.swap_coprocessor_owner")
trusted fun esp32XtSwapCoprocessorOwner(
    coprocessor: u32,
    newOwner: u32
): u32 {
    val core = cpuCoreId()
    val ownerAddress =
        esp32Data_xt_coproc_owner_sa_d3e3a5058a +
        (core << u32(2)) +
        (coprocessor << u32(2))
    val lockAddress = esp32Data_xt_coproc_owner_sa_lock_64fc2f38a3
    val lock = atomicU32At(int(lockAddress))
    val processorId = xtensaReadProcessorId()
    while (lock.compareExchange(u32(0), processorId) != u32(0)) {}

    val oldOwner = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(ownerAddress))
    ))
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(ownerAddress)),
        int(newOwner)
    )
    atomicMemoryFence()
    ablaUnsafeStoreU32(nativePointerFromAddress(int(lockAddress)), 0)
    oldOwner
}

@section(".iram1.abla.xtensa.prepare_old_coprocessor")
trusted fun esp32XtPrepareOldCoprocessor(
    maskInfo: u32,
    owner: u32
): u32 {
    if (owner == u32(0)) return u32(0)
    val mask = maskInfo & u32(65535)
    val enabled = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(int(owner))
    ))
    if ((enabled & mask) == u32(0)) return u32(0)

    ablaUnsafeStoreU16(
        nativePointerFromAddress(int(owner)),
        int(enabled ^ mask)
    )
    val storedAddress = owner + u32(2)
    val stored = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(int(storedAddress))
    ))
    ablaUnsafeStoreU16(
        nativePointerFromAddress(int(storedAddress)),
        int(stored | mask)
    )

    val coprocessor = (maskInfo >> u32(16)) & u32(31)
    val offset = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(
        esp32Data_xt_coproc_sa_offset_f77132bfd1 +
        (coprocessor << u32(2))
    ))))
    val saveArea = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(owner + u32(8)))
    ))
    saveArea + offset
}

// Low word: complete coprocessor-state address to restore, or zero.
// High word: callee-saved coprocessor mask to restore when no full image is
// present. Returning both keeps the naked boundary free of policy branches.
@section(".iram1.abla.xtensa.prepare_new_coprocessor")
trusted fun esp32XtPrepareNewCoprocessor(
    maskInfo: u32,
    owner: u32
): u64 {
    if (owner == u32(0)) return u64(0)
    val mask = maskInfo & u32(65535)
    val storedAddress = owner + u32(2)
    val stored = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(int(storedAddress))
    ))
    if ((stored & mask) != u32(0)) {
        ablaUnsafeStoreU16(
            nativePointerFromAddress(int(storedAddress)),
            int(stored ^ mask)
        )
        val coprocessor = (maskInfo >> u32(16)) & u32(31)
        val offset = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(
            esp32Data_xt_coproc_sa_offset_f77132bfd1 +
            (coprocessor << u32(2))
        ))))
        val saveArea = u32(ablaUnsafeLoadU32(
            nativePointerFromAddress(int(owner + u32(8)))
        ))
        return u64(saveArea + offset)
    }

    val calleeSaved = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(int(owner + u32(4)))
    )) & mask
    u64(calleeSaved) << u64(32)
}

@section(".iram1.abla.xtensa.handle_exception_body")
trusted fun esp32XtHandleExceptionBody(
    frameAddress: u32,
    cause: u32
): void {
    val core = cpuCoreId()
    val table = u32(esp32ExceptionTableStorage)
    val slot = table + (((cause << u32(1)) + core) << u32(2))
    val handler = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(slot))
    ))
    u32(ablaUnsafeCallI32I32(int(handler), int(frameAddress)))
    return
}

