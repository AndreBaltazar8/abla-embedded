import "../../xtensa/assembly.ab"

// Abla-owned interrupt-mask updates. Only XSR/WSR/RSYNC remain target
// instructions; LLVM can now reason about the mask arithmetic and values.

// Original ABI symbol: xt_ints_on
@inline
trusted fun esp32RecoveredXtIntsOn(mask: u32): u32 {
    val previous = xtensaExchangeInterruptEnableRegister(u32(0))
    // XSR/WSR updates of INTENABLE are not immediately visible to the
    // interrupt arbiter.  ESP-IDF's xt_ints_on sequence places RSYNC after
    // both operations; without the final synchronization a core can enter
    // its first task before its CCOMPARE interrupt is actually enabled.
    xtensaInstructionSynchronize()
    xtensaWriteInterruptEnableRegister(previous | mask)
    xtensaInstructionSynchronize()
    previous
}

// Original ABI symbol: xt_ints_off
@inline
trusted fun esp32RecoveredXtIntsOff(mask: u32): u32 {
    val previous = xtensaExchangeInterruptEnableRegister(u32(0))
    xtensaInstructionSynchronize()
    xtensaWriteInterruptEnableRegister(previous & ~mask)
    xtensaInstructionSynchronize()
    previous
}
