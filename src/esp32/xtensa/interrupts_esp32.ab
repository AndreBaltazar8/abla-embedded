    val slot = table + (index << u32(3))
    val previous = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(slot))
    ))
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(slot)),
        int(if (handler == u32(0)) unhandled else handler)
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(slot + u32(4))),
        int(if (handler == u32(0)) index else argument)
