// Reconstructed ESP-IDF Xtensa xtensa_context member for ESP32.

// Windowed-ABI interrupt entry must spill live windows even before the task
// scheduler starts; interrupt handlers themselves use those windows.
val esp32XtensaWindowSpillRequiredStorage = nativeInternalSectionBytes(
    "\x01\x00\x00\x00\x01\x00\x00\x00",
    "abla_xtensa_window_spill_required",
    ".rodata.abla.xtensa.window_spill_required",
    4
)

trusted fun esp32XtensaContextStorageInitialize(): void {
    if (u32(ablaUnsafeLoadU32(nativePointerFromAddress(
        int(esp32XtensaWindowSpillRequiredStorage)
    ))) != u32(1)) freestandingAbortValue()
}

// Original ABI symbol: _xt_context_save
@naked
@section(".iram1.abla.xtensa.context_save")
trusted fun esp32RecoveredXtContextSave(): void =
    $xtensa contextSave {xthal_save_extra_nw,abla_xtensa_window_spill_required}

// Original ABI symbol: _xt_context_restore
@naked
@section(".iram1.abla.xtensa.context_restore")
trusted fun esp32RecoveredXtContextRestore(): void =
    $xtensa contextRestore {xthal_restore_extra_nw}

// Original ABI symbol: _xt_coproc_init
trusted fun esp32RecoveredXtCoprocInit(): void {
    val address = esp32Data_xt_coproc_owner_sa_d3e3a5058a
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(address)),
        0
    )
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(address + u32(4))),
        0
    )
    return
}

// Original ABI symbol: _xt_coproc_release
trusted fun esp32RecoveredXtCoprocRelease(
    owner: u32,
    coprocessor: u32
): void {
    val ownerAddress =
        esp32Data_xt_coproc_owner_sa_d3e3a5058a +
        (coprocessor << u32(2))
    val lockAddress =
        esp32Data_xt_coproc_owner_sa_lock_64fc2f38a3
    val processorState = xtensaRaiseInterruptLevel3()
    val processorId = xtensaReadProcessorId()
    while (xtensaAtomicCompareExchangeU32(
        lockAddress, u32(0), processorId
    ) != u32(0)) {}
    if (u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(ownerAddress))
    )) == owner) {
        ablaUnsafeStoreU32(
            nativePointerFromAddress(int(ownerAddress)),
            0
        )
    }
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(lockAddress)),
        0
    )
    xtensaRestoreProcessorState(processorState)
    return
}

// Original ABI symbol: _xt_coproc_savecs
@naked
trusted fun esp32RecoveredXtCoprocSavecs(): void =
    $xtensa call0CoprocessorSave {
        _frxt_task_coproc_state,
        _xt_coproc_sa_offset
    }

// Original ABI symbol: _xt_coproc_restorecs
@naked
trusted fun esp32RecoveredXtCoprocRestorecs(): void =
    $xtensa call0CoprocessorRestore {
