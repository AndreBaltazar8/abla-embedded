import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkXtensaWindowSpillOpaqueCallers(): bool {
    // The public spill wrapper owns the only remaining reference to its call0
    // leaf now that FreeRTOS portasm.S has been replaced.
    if (!internalFunction("ownedXtensaWindowSpillNonWindowed", "xthal_window_spill_nw")) return false
    if (!exportFunction("ownedXtensaWindowSpill", "xthal_window_spill")) return false
    true
}
