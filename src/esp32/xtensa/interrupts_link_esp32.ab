import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkXtensaInterruptsInternals(): bool {
    if (!internalFunction("esp32RecoveredXtUnhandledInterrupt", "xt_unhandled_interrupt")) return false
    if (!internalFunction("esp32RecoveredXtSetExceptionHandler", "xt_set_exception_handler")) return false
    if (!internalFunction("esp32RecoveredXtIntHasHandler", "xt_int_has_handler")) return false
    if (!internalFunction("esp32RecoveredXtSetInterruptHandler", "xt_set_interrupt_handler")) return false
    true
}
