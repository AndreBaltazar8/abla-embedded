// DW-GDMA channel layout verified against IDF hw_ver1/hw_ver3.
// Caller holds an exclusive channel lease and serialization; controller clock,
// reset and enable lifetime are owned separately. Never reset a shared group.
// Descriptor address must be canonical DMA-visible memory, NOT its CPU-only
// uncached alias. Cache synchronization is required before later channel start.
trusted fun p4DwDmaField(offset: int,mask: u32,value: u32): bool {
    p4DwDmaWrite(offset,(p4DwDmaRead(offset)&(u32(4294967295)^mask))|value)
    (p4DwDmaRead(offset)&mask) == value
}
// 1 configured (NOT started),2 invalid,3 controller unavailable,4 active,
// 5 pending events (preserved),6 partial/readback failure: retain channel lease.
trusted fun esp32P4DwDmaDsiConfigureOwned(channel: int,descriptorAddress: int): int {
    if (channel < 0 || channel > 3 || descriptorAddress < 64 ||
        descriptorAddress > 4294967232 || (descriptorAddress&63) != 0) return 2
    if ((p4DwDmaRead(16)&u32(1)) == u32(0) || (p4DwDmaRead(88)&u32(1)) != u32(0)) return 3
    val bit=u32(1)<<u32(channel)
    if ((p4DwDmaRead(24)&bit) != u32(0) || (p4DwDmaRead(28)&bit) != u32(0)) return 4
    val base=256+channel*256
    if (p4DwDmaRead(base+136) != u32(0)) return 5
    // Pollable events, no CPU interrupt routing. Do not discard pending faults.
    if (!p4DwDmaField(base+144,u32(4160765947),u32(0)) ||
        !p4DwDmaField(base+32,u32(15),u32(15)) ||
        // M2P/DMA flow, HW handshake, DSI=0, priority1, outstanding5/2.
        !p4DwDmaField(base+36,u32(2140025247),u32(167903233))) return 6
    var offset=112
    while (offset <= 124) {
        p4DwDmaWrite(base+offset,u32(0))
        if (p4DwDmaRead(base+offset) != u32(0)) return 6
        offset=offset+4
    }
    if (!p4DwDmaField(base+128,u32(4160765947),u32(4160765947))) return 6
    p4DwDmaWrite(base+44,u32(0))
    if (p4DwDmaRead(base+44) != u32(0)) return 6
    if (!p4DwDmaField(base+40,u32(4294967233),u32(descriptorAddress)|u32(1))) return 6
    return 1
}
