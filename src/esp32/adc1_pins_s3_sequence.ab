import "./adc_pins_s3_sequence.ab"
import "../hal/esp32.ab"
// ADC1 GPIO1..10. Board pin availability remains caller-owned.
fun esp32S3Adc1Pin(channel: int): int = if (channel < 0 || channel > 9) -1 else channel+1
@export("esp32S3Adc1PadConfigureOwned")
trusted fun esp32S3Adc1PadConfigureOwnedHook(channel: int): int = esp32S3AdcPadConfigureOwned(esp32S3Adc1Pin(channel))
