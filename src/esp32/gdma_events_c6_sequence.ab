import "./gdma_clock_c6_sequence.ab"
import "./gdma_tx_channel_c6_sequence.ab"
// Raw event snapshot: status8,raw8@8,TX16,channel2@17,valid19.
// Read status1snapshot2invalid3clock4IRQ-owned5unknown event bits.
// C6 RX has7 event bits, TX6; no C5 AHB-response-error bits.
// Caller owns selected direction/ISR and serializes snapshot/ack. Events are
// sticky bits, not counters: repeated same-bit occurrences may coalesce.
type C6GdmaEvents=int
fun C6GdmaEvents.status(): int = this&255
fun C6GdmaEvents.raw(): int = (this>>>8)&255
fun C6GdmaEvents.errors(): int = this.raw()&(if ((this&(1<<16)) != 0) 0x34 else 0x7c)
fun C6GdmaEvents.descriptorDone(): bool = (this.raw()&1) != 0
fun C6GdmaEvents.eof(): bool = (this.raw()&2) != 0
fun C6GdmaEvents.txTotalEof(): bool = (this&(1<<16)) != 0 && (this.raw()&8) != 0
trusted fun c6GdmaEventsReadOwned(channel: int,tx: bool,exclusive: bool): C6GdmaEvents {
    if (!exclusive || channel < 0 || channel > 2) return C6GdmaEvents(2)
    if (!c6GdmaClocksReady()) return C6GdmaEvents(3)
    val at=c6GdmaEventBase(channel,tx)
    if (c6GdmaRead(at+8) != u32(0)) return C6GdmaEvents(4)
    val raw=c6GdmaRead(at)
    if ((raw&~u32(if (tx) 63 else 127)) != u32(0)) return C6GdmaEvents(5)
    return C6GdmaEvents((1<<19)|(channel<<17)|(if (tx) 1<<16 else 0)|(int(raw)<<8)|1)
}
// Acknowledge only explicitly handled bits present in this snapshot.
// Returns1cleared2invalid3clock4IRQ-owned6still-set (new or uncleared event).
// Exactly one W1C write; never RMW or auto-retry. No completion is inferred
// from clearing: park/FIFO/descriptor/cache ownership must be joined separately.
trusted fun C6GdmaEvents.acknowledgeOwned(handled: int,exclusive: bool): int {
    if (!exclusive || this < 0 || (this&~0xfffff) != 0 || (this&(1<<19)) == 0 || this.status() != 1 ||
        handled < 0 || (handled&~this.raw()) != 0) return 2
    val tx=(this&(1<<16)) != 0
    val channel=(this>>>17)&3
    if (channel > 2 || (this.raw()&~(if (tx) 63 else 127)) != 0) return 2
    if (!c6GdmaClocksReady()) return 3
    val at=c6GdmaEventBase(channel,tx)
    if (c6GdmaRead(at+8) != u32(0)) return 4
    if (handled == 0) return 1
    c6GdmaWrite(at+12,u32(handled))
    return if ((c6GdmaRead(at)&u32(handled)) == u32(0)) 1 else 6
}
