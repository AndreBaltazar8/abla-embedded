// Flush ALL DATA caches before changing shared SRAM/cache configuration.
// Requires valid inherited tags/mappings and accessible backing memory; do
// this BEFORE shutting down mapped ports/clocks or changing MMU entries.
// Caller excludes other CPUs/IRQ/DMA/demand accesses and suspends autoload;
// all code/constants/stack remain in owned internal SRAM outside new cache.
// No instruction-cache invalidation. Internal stack use can dirty L1 again:
// this is not a promise that ALL caches stay empty after returning.
// L1 DATA first, L2 second, TWO writeback-invalidates each per IDF P4 patch.
// Global sync engine remains owned on timeout; no reset or forced completion.
// low8:1done2invalid3syncbusy4workerbusy5setup6timeout. High bits identify
// offending worker offset (status4) or command stage1..4 (status5/6).
trusted fun p4CacheFlushAllDataOwned(polls: int): int {
    if (polls < 1 || polls > 1000000) return 2
    if ((p4CacheGeometryRead(152)&15) != 0) return 3
    val busy=p4CacheColdBusyOffset()
    if (busy != 0) return 4|(busy<<8)
    p4CacheColdFence()
    var level=0
    while (level < 2) {
        val map=if (level == 0) 16 else 32
        val stage=level*2+1
        p4CacheColdWrite(156,map); p4CacheColdWrite(160,0); p4CacheColdWrite(164,0)
        if ((p4CacheGeometryRead(156)&63) != map || p4CacheGeometryRead(160) != 0 || (p4CacheGeometryRead(164)&0x0fffffff) != 0) return 5|(stage<<8)
        var pass=0
        while (pass < 2) {
            p4CacheColdWrite(152,8)
            var remaining=polls; var done=false
            while (remaining > 0 && !done) { done=(p4CacheGeometryRead(152)&31) == 16; remaining=remaining-1 }
            if (!done) return 6|((stage+pass)<<8)
            pass=pass+1
        }
        p4CacheColdFence()
        level=level+1
    }
    return 1
}
