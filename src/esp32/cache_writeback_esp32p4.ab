import "./cache_writeback_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4CacheSyncRead(offset: int): u32 = u32(mmioLoadU32(0x3ff10000+offset))
trusted fun p4CacheSyncWrite(offset: int,value: u32): void { mmioStoreU32(0x3ff10000+offset,int(value)); return }
trusted fun esp32P4CacheWriteback(buffer: NativeBuffer,bytes: int,l2Line: int,polls: int): int = esp32P4CacheWritebackOwned(buffer,bytes,l2Line,polls)
