import "./core_local_init_s3_sequence.ab"
// Activate this runtime's complete default table only after local callback/
// stack installation. Caller serializes startup/config across cores and keeps
// the old vectors + current stack valid through preparation. No IRQ enable.
@section(".iram1.abla.s3VectorActivate")
trusted fun esp32S3VectorsActivateOwned(core: int): bool {
    if (core < 0 || core > 1 || esp32S3MatrixInitCore() != core || esp32S3MatrixInitEnabled() != 0 ||
        (esp32S3VectorStatus() & 0x40010) != 0x40000) return false
    val base=esp32S3VectorsAddress()
    if (base == 0) return false
    val entry=esp32S3VectorConfig()+core*32
    val low=esp32S3VectorRead(entry+16)
    val end=esp32S3VectorRead(entry+20)
    val handler=esp32S3VectorRead(entry+8)
    val exception=esp32S3VectorRead(entry+24)
    if (low < 0x3FC88000 || end > 0x3FD00000 || end-low < 1024 || ((low | end) & 15) != 0 ||
        esp32S3VectorRead(entry) != end-48 || esp32S3VectorRead(entry+4) != 0 ||
        handler < 0x40370000 || handler >= 0x403E0000 || (handler & 3) != 0 ||
        exception < 0x40370000 || exception >= 0x403E0000 || (exception & 3) != 0) return false
    esp32S3CoreLocalInitOwned(core,base)
}
