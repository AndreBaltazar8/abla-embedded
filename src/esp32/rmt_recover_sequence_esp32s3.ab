// Recover caller-owned RMT TX3/GDMA after timeout/error. Keep both peripheral
// bus clocks powered and configuration ownership throughout. STOP returns RMT
// to idle (ESP32-S3 TRM37.3.4.1); observe its R/W/SC command consumed, then
// require GDMA PARK before disabling the DMA route and reclaiming buffers.
// Does not gate clocks, reset other channels, acknowledge error evidence, or
// restore pads. 1quiesced,2invalid,3RMTclockunavailable,4requestfailed,
// 5timeout (retain ownership),6route-disable failed (retain ownership).
trusted fun esp32s3RmtRecoverDmaOwned(channel: int,polls: int): int {
    if (channel < 0 || channel > 4 || polls < 1 || polls > 1000000) return 2
    if ((esp32s3RmtRead(0x600c0018)&512) == 0 ||
        (esp32s3RmtRead(0x600c0020)&512) != 0 ||
        (esp32s3RmtRead(0x600160c0)&0x04000000) == 0) return 3
    // Attempt both stops even if one request fails.
    val rmt=esp32s3RmtTxRequestOwned(3,false)
    val dma=esp32s3GdmaRequestStop(channel,true)
    if (!rmt || !dma) return 4
    var attempt=0
    while (attempt < polls) {
        val consumed=(esp32s3RmtRead(0x6001602c)&128) == 0
        val parked=esp32s3GdmaParked(channel,true)
        if (consumed && parked) {
            esp32s3GdmaPublish()
            if (!esp32s3RmtSetTxDmaOwned(3,false) ||
                (esp32s3RmtRead(0x6001602c)&0x02000010) != 0) return 6
            return 1
        }
        attempt=attempt+1
    }
    return 5
}
