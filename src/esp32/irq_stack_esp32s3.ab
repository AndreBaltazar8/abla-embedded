import "./irq_entries_esp32s3.ab"
import "./irq_stack_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
@inline
@export("esp32S3IrqStackCore")
trusted fun esp32S3IrqStackCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3IrqStackEnabled")
trusted fun esp32S3IrqStackEnabledHook(): int = int(xtensaGuardRead("rsr.intenable $0","=r,~{memory}"))
@inline
@export("esp32S3IrqStackRead")
trusted fun esp32S3IrqStackReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3IrqStackWrite")
trusted fun esp32S3IrqStackWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
