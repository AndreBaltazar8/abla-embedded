import "./irq_entries_esp32s3.ab"
import "./irq_stack_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
@inline
trusted fun esp32S3IrqStackCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3IrqStackEnabled(): int = int(xtensaGuardRead("rsr.intenable $0","=a,~{memory}"))
@inline
trusted fun esp32S3IrqStackRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3IrqStackWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
