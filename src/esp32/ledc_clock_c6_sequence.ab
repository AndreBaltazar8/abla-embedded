import "./ledc_c6_sequence.ab"
// C6 PCR34/38: APB bit0/reset1; function bit22/source20..21.
// Source1PLL80,2FOSC,3XTAL;0invalid. Unlike C5 there is no APB-ready
// bit or separate memory power control. Never reset or switch clock sources.
// Caller owns all channels/timers, excludes IRQ/ETM/PCR writers and pins the
// selected source. Bits8APB/9function retain attempted changes on failure.
// Status0closed1ready2invalid3reset/source4APB6busy7sourcechanged8function.
type C6LedcClockOwner=int
fun C6LedcClockOwner.status(): int = this&255
fun C6LedcClockOwner.ready(): bool = this.status() == 1
trusted fun c6LedcClockField(offset: int,mask: int,value: int): bool {
    c6LedcClockWrite(offset,(c6LedcClockRead(offset)&~mask)|value)
    return (c6LedcClockRead(offset)&mask) == value
}
trusted fun c6LedcAllStopped(): bool {
    if (c6LedcRead(200) != 0) return false
    var channel=0
    while (channel < 6) {
        if ((c6LedcRead(channel*20)&0x8014) != 0 || (c6LedcRead(channel*20+12)&0x80000000) != 0) return false
        channel=channel+1
    }
    var timer=0
    while (timer < 4) {
        val config=c6LedcRead(160+timer*8)
        if ((config&0x4000000) != 0 || (config&0x1800000) == 0) return false
        timer=timer+1
    }
    return true
}
trusted fun c6LedcClockOpenOwned(source: int,exclusiveStopped: bool): C6LedcClockOwner {
    if (!exclusiveStopped || source < 1 || source > 3) return C6LedcClockOwner(2)
    val bus=c6LedcClockRead(0);val function=c6LedcClockRead(4)
    if ((bus&2) != 0 || ((function>>>20)&3) != source) return C6LedcClockOwner(3)
    var state=source<<10
    if ((bus&1) == 0) {
        state=state|256
        if (!c6LedcClockField(0,1,1)) return C6LedcClockOwner(state|4)
    }
    if (!c6LedcAllStopped()) return C6LedcClockOwner(state|6)
    if ((function&0x400000) == 0) {
        state=state|512
        if (!c6LedcClockField(4,0x400000,0x400000)) return C6LedcClockOwner(state|8)
    }
    if (((c6LedcClockRead(4)>>>20)&3) != source) return C6LedcClockOwner(state|7)
    return C6LedcClockOwner(state|1)
}
// Stop outputs and pause timers before close; no implicit cancellation.
// Return value replaces owner on BOTH success and failure.
trusted fun C6LedcClockOwner.closeOwned(exclusiveStopped: bool): C6LedcClockOwner {
    if (!exclusiveStopped || this < 0 || (this&~4095) != 0 || this.status() > 8) return this
    var state=this&3840
    if ((state&768) == 0) return C6LedcClockOwner(0)
    val bus=c6LedcClockRead(0)
    if ((bus&2) != 0) return C6LedcClockOwner(state|6)
    if (((c6LedcClockRead(4)>>>20)&3) != (state>>>10)) return C6LedcClockOwner(state|7)
    if ((bus&1) != 0) {
        if (!c6LedcAllStopped()) return C6LedcClockOwner(state|6)
    } else if ((state&512) != 0) return C6LedcClockOwner(state|6)
    if ((state&512) != 0) {
        if (!c6LedcClockField(4,0x400000,0)) return C6LedcClockOwner(state|8)
        state=state&~512
    }
    if ((state&256) != 0 && !c6LedcClockField(0,1,0)) return C6LedcClockOwner(state|4)
    return C6LedcClockOwner(0)
}
