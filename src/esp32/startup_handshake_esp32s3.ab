import "./startup_handshake_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "../atomic.ab"
@inline
trusted fun esp32S3StartupCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3StartupCas(address: int,expected: int,value: int): int = int(atomicU32At(address).compareExchange(u32(expected),u32(value)))
