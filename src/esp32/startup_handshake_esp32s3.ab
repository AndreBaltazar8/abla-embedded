import "./startup_handshake_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "../atomic.ab"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
@inline
@export("esp32S3StartupCore")
trusted fun esp32S3StartupCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3StartupCas")
trusted fun esp32S3StartupCasHook(address: int,expected: int,value: int): int = int(atomicU32At(address).compareExchange(u32(expected),u32(value)))
