import "./sdk/raw_buffer.ab"
// Boot-time per-core ISR stack registration; no allocation, implicit enabling
// or live replacement. Caller owns stack memory (including code/data aliases),
// callback lifetime and enough capacity for its maximum call depth/nesting.
// At least1024 bytes is a guard, NOT a worst-case stack-use guarantee.
// Table is the private64byte IRQ entry config, not arbitrary user memory.
@section(".iram1.abla.s3IrqStackInit")
trusted fun esp32S3IrqStackInitializeOwned(stack: NativeBuffer,core: int,callback: int,context: int): bool {
    if (core < 0 || core > 1 || !stack.hasAddressRange(0,1024) ||
        (stack.addressValue() & 15) != 0 || (stack.capacity() & 15) != 0 ||
        stack.addressValue() < 0x3FC88000 || stack.addressValue()+stack.capacity() > 0x3FD00000 ||
        callback < 0x40370000 || callback >= 0x403E0000 || (callback & 3) != 0 ||
        context < 0 || context > 0xFFFFFFFF) return false
    if (esp32S3IrqStackCore() != core || esp32S3IrqStackEnabled() != 0) return false
    val table=esp32S3IrqConfigAddress()
    val low=stack.addressValue()
    val end=low+stack.capacity()
    if (low < table+64 && table < end) return false
    val entry=table+core*32
    val peer=table+(core ^ 1)*32
    if (esp32S3IrqStackRead(entry) != 0 || esp32S3IrqStackRead(entry+4) != 0) return false
    if (esp32S3IrqStackRead(peer) != 0 && low < esp32S3IrqStackRead(peer+20) && esp32S3IrqStackRead(peer+16) < end) return false
    esp32S3IrqStackWrite(entry+8,callback)
    esp32S3IrqStackWrite(entry+12,context)
    esp32S3IrqStackWrite(entry+16,low)
    esp32S3IrqStackWrite(entry+20,end)
    // Publish last. Both cores must serialize configuration during startup;
    // local interrupt masking alone is not cross-core mutual exclusion.
    esp32S3IrqStackWrite(entry,end-48)
    true
}
@section(".iram1.abla.s3IrqStackRelease")
trusted fun esp32S3IrqStackReleaseOwned(core: int): bool {
    if (core < 0 || core > 1 || esp32S3IrqStackCore() != core || esp32S3IrqStackEnabled() != 0) return false
    val entry=esp32S3IrqConfigAddress()+core*32
    if (esp32S3IrqStackRead(entry) == 0 || esp32S3IrqStackRead(entry+4) != 0 ||
        esp32S3IrqStackRead(entry+24) != 0) return false
    esp32S3IrqStackWrite(entry,0)
    esp32S3IrqStackWrite(entry+8,0)
    esp32S3IrqStackWrite(entry+12,0)
    esp32S3IrqStackWrite(entry+16,0)
    esp32S3IrqStackWrite(entry+20,0)
    true
}
