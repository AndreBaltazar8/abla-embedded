import "../register.ab"
import "./gpio.ab"

// Minimal synchronous WS2812/SK6812 transmitter for the classic ESP32 RMT.
// It owns channel zero for the duration of set(), uses one 64-word hardware
// memory block, and returns only after TX completion. No SDK object, task,
// allocation, interrupt handler, or C ABI is involved.
val esp32RmtBase = 1073045504
val esp32RmtMemory = 1073047552
val esp32RmtChannel0Config0 = esp32RmtBase + 32
val esp32RmtChannel0Config1 = esp32RmtBase + 36
val esp32RmtInterruptRaw = esp32RmtBase + 160
val esp32RmtInterruptClear = esp32RmtBase + 172
val esp32RmtApbConfig = esp32RmtBase + 240
val esp32DportPeripheralClockEnable = 1072693440
val esp32RmtClockEnable = 512
val esp32RmtSignalOut0 = 87
val esp32RmtClockDivider = 8
val esp32RmtMemoryBlocks = 1
val esp32RmtClockEnabled = 2147483648
val esp32RmtReferenceAlwaysOn = 131072
val esp32RmtIdleOutputEnabled = 524288
val esp32RmtMemoryReadReset = 8
val esp32RmtApbMemoryReset = 16
val esp32RmtTxStart = 1
val esp32RmtChannel0TxDone = 1
val esp32RmtApbMemoryNonFifo = 1
val esp32RmtRgbMaximumPolls = 200000

type RgbLed = int

@inline
fun rgbLed(pin: int): RgbLed = RgbLed(pin)

@inline
fun esp32RmtRgbSymbol(one: bool): int {
    val highTicks = if (one) 8 else 4
    val lowTicks = if (one) 4 else 8
    highTicks | 32768 | (lowTicks << 16)
}

@inline
trusted fun esp32RmtRgbEnableClock(): void {
    // This RMW is intentionally local to the classic ESP32 target. Board
    // startup must serialize shared DPORT clock ownership across both cores.
    register32(esp32DportPeripheralClockEnable).setBits(
        esp32RmtClockEnable
    )
    return
}

trusted fun RgbLed.set(red: int, green: int, blue: int): void {
    val output = pin(this)
    output.write(false)
    output.output()
    if (!output.routeOutputSignal(esp32RmtSignalOut0)) return

    esp32RmtRgbEnableClock()
    register32(esp32RmtApbConfig).setBits(esp32RmtApbMemoryNonFifo)
    register32(esp32RmtChannel0Config0).write(
        esp32RmtClockEnabled |
            (esp32RmtMemoryBlocks << 24) |
            esp32RmtClockDivider
    )
    val idleConfig = esp32RmtReferenceAlwaysOn |
        esp32RmtIdleOutputEnabled
    register32(esp32RmtChannel0Config1).write(
        idleConfig | esp32RmtMemoryReadReset | esp32RmtApbMemoryReset
    )
    register32(esp32RmtChannel0Config1).write(idleConfig)

    // The wire order matches the built-in Atom RGB LED: G7..G0, R7..R0,
    // B7..B0. Each RMT tick is 100 ns at APB 80 MHz / divider 8.
    val color = ((green & 255) << 16) |
        ((red & 255) << 8) | (blue & 255)
    var bit = 23
    while (bit >= 0) {
        register32(esp32RmtMemory + (23 - bit) * 4).write(
            esp32RmtRgbSymbol((color & (1 << bit)) != 0)
        )
        bit = bit - 1
    }
    // A zero-duration entry terminates the transfer. Idle output remains low
    // for the reset interval after TX completion.
    register32(esp32RmtMemory + 96).write(0)
    register32(esp32RmtInterruptClear).write(esp32RmtChannel0TxDone)
    register32(esp32RmtChannel0Config1).setBits(esp32RmtTxStart)

    var polls = 0
    while (polls < esp32RmtRgbMaximumPolls &&
        (register32(esp32RmtInterruptRaw).read() &
            esp32RmtChannel0TxDone) == 0) {
        polls = polls + 1
    }
    register32(esp32RmtInterruptClear).write(esp32RmtChannel0TxDone)
    return
}

@inline
trusted fun RgbLed.off(): void = this.set(0, 0, 0)
