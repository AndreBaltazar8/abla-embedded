// S3 flash and PSRAM each have nine input-delay lanes (D0..7 and strobe).
// Snapshot preserves per-lane differences, not just a guessed uniform setting.
type Esp32S3MspiDin = int
fun Esp32S3MspiDin.valid(): bool = (this & (1<<45)) != 0

// Cache frozen, other core/interrupts quiesced, internal-memory execution and
// exclusive MSPI ownership required for every operation. This only handles
// DIN delay, not clock changes, dummy cycles, or cache freezing itself.
@section(".iram1.abla.s3MspiDinCapture")
trusted fun esp32S3MspiDinCaptureOwned(psram: bool): Esp32S3MspiDin {
    val base=if (psram) 0x600030C0 else 0x600030AC
    val modes=esp32S3MspiDinRead(base) & 0x7FFFFFF
    val cycles=esp32S3MspiDinRead(base+4) & 0x3FFFF
    Esp32S3MspiDin(modes | (cycles<<27) | (1<<45))
}

@section(".iram1.abla.s3MspiDinRestore")
trusted fun esp32S3MspiDinRestoreOwned(snapshot: Esp32S3MspiDin,psram: bool): bool {
    if (!snapshot.valid()) return false
    val base=if (psram) 0x600030C0 else 0x600030AC
    esp32S3MspiDinUpdate(base,0x7FFFFFF,snapshot & 0x7FFFFFF)
    esp32S3MspiDinUpdate(base+4,0x3FFFF,(snapshot>>>27) & 0x3FFFF)
    true
}

@inline
trusted fun Esp32S3MspiDin.restoreOwned(psram: bool): bool = esp32S3MspiDinRestoreOwned(this,psram)

@section(".iram1.abla.s3MspiDinSet")
trusted fun esp32S3MspiDinSetOwned(psram: bool,mode: int,cycles: int): bool {
    if (mode < 0 || mode > 7 || cycles < 0 || cycles > 3) return false
    // Nine contiguous fields: three bits/mode and two bits/cycle count.
    val modes=mode*0x1249249
    val counts=cycles*0x15555
    Esp32S3MspiDin(modes | (counts<<27) | (1<<45)).restoreOwned(psram)
}
