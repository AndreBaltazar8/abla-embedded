import "./mspi_idle_c5_sequence.ab"
// Read SPI flash SR1(05), qualified SR2(35), or JEDEC ID(9f), following memspi_host_read_status_hs/read_id_hs
// USER-command strategy (not the dedicated RDSR shortcut at high frequencies).
// Caller has qualified single-command SDR chip mode and current SPI1 timing/
// clock for this command, CS0 flash selected/CS1 disabled, caches suspended,
// all SPI0/1/DMA/ROM users excluded, retained closure/record/stack. Not QPI/OPI,
// not a vendor-independent SUS decoder, and no chip latency/voltage changes.
//48B:tag0,state4,stage8,raw byte/24bit FIFO value12, saved CTRL16/USER20/USER2 24/
// MISO_DLEN28/W0 32.1complete2invalid3pending. Consume byte only on1.
// Pending preserves ownership. Retry same record until controller completion
// and exact reverse field restoration; never abandon or reuse a live record.
// Immutable command at36. No program/erase/write-enable/status-write commands.
@section(".iram1.abla.c5FlashStatus")
trusted fun c5FlashReadCommandOwned(record: NativeBuffer,polls: int,exclusiveQualifiedSdr: bool,command: int): int {
    if (!exclusiveQualifiedSdr || !record.hasAddressRange(0,48) || (record.addressValue()&3) != 0 || polls < 1 || polls > 1000000 || (command != 5 && command != 0x35 && command != 0x9f)) return 2
    val tag=c5SleepRecordRead(record,0)
    if (tag != 0 && tag != 0x43535231) return 2
    if (tag != 0) {
        if (c5SleepRecordRead(record,36) != command) return 2
        if (c5SleepRecordRead(record,4) == 1) return 1
        if (c5SleepRecordRead(record,4) != 3 || c5SleepRecordRead(record,8) > 9) return 2
        if (!c5MspiReady()) return 3
    } else {
        if (esp32C5MspiWaitIdleOwned(3,polls,true) != 1) return 3
        if ((c5MspiRead(0x60003034)&3) != 2 || (c5MspiRead(0x600030d4)&1) != 0) return 2
        c5SleepRecordWrite(record,16,c5MspiRead(0x60003008)&0x2320)
        c5SleepRecordWrite(record,20,c5MspiRead(0x60003018)&0xf900f000)
        c5SleepRecordWrite(record,24,c5MspiRead(0x60003020)&0xf000ffff)
        c5SleepRecordWrite(record,28,c5MspiRead(0x60003028)&1023)
        c5SleepRecordWrite(record,32,c5MspiRead(0x60003058))
        c5SleepRecordWrite(record,12,0);c5SleepRecordWrite(record,8,0)
        c5SleepRecordWrite(record,36,command)
        c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,0,0x43535231)
    }
    val stage=c5SleepRecordRead(record,8)
    if (stage <= 0) {
        // Disable command quad/oct, octal input and fast-read mode. With
        // FASTRD clear, retained read-dual/quad/DIO/QIO fields are inactive.
        if (!c5MspiField(0x60003008,0x2320,0)) return 3
        c5SleepRecordWrite(record,8,1)
    }
    if (stage <= 1) {
        if (!c5MspiField(0x60003020,0xf000ffff,0x70000000|command)) return 3
        c5SleepRecordWrite(record,8,2)
    }
    if (stage <= 2) {
        if (!c5MspiField(0x60003028,1023,if (command == 0x9f) 23 else 7)) return 3
        c5SleepRecordWrite(record,8,3)
    }
    if (stage <= 3) {
        if (!c5MspiField(0x60003018,0xf900f000,0x90000000)) return 3
        c5SleepRecordWrite(record,8,4)
    }
    if (stage <= 4) {
        // Direct command publication, NEVER RMW a command register. The
        // hardware strobe has no separate acceptance acknowledgment and may
        // finish before the first poll. Never replay it on a pending retry.
        c5MspiWrite(0x60003000,0x40000)
        c5SleepRecordWrite(record,8,5)
    }
    if (stage <= 5) {
        if (esp32C5MspiWaitIdleOwned(3,polls,true) != 1) return 3
        c5SleepRecordWrite(record,12,c5MspiRead(0x60003058)&(if (command == 0x9f) 0xffffff else 255))
        c5SleepRecordWrite(record,8,6)
    }
    if (stage <= 6) {
        if (!c5MspiField(0x60003058,0xffffffff,c5SleepRecordRead(record,32))) return 3
        c5SleepRecordWrite(record,8,7)
    }
    if (stage <= 7) {
        if (!c5MspiField(0x60003018,0xf900f000,c5SleepRecordRead(record,20))) return 3
        c5SleepRecordWrite(record,8,8)
    }
    if (stage <= 8) {
        if (!c5MspiField(0x60003028,1023,c5SleepRecordRead(record,28))) return 3
        c5SleepRecordWrite(record,8,9)
    }
    if (!c5MspiField(0x60003020,0xf000ffff,c5SleepRecordRead(record,24))) return 3
    if (!c5MspiField(0x60003008,0x2320,c5SleepRecordRead(record,16))) return 3
    c5SleepRecordWrite(record,8,10);c5SleepRecordWrite(record,4,1)
    1
}
@section(".iram1.abla.c5FlashStatusRead")
trusted fun esp32C5FlashStatusReadOwned(record: NativeBuffer,polls: int,exclusiveQualifiedSdr: bool,command: int = 5): int {
    if (command != 5 && command != 0x35) return 2
    c5FlashReadCommandOwned(record,polls,exclusiveQualifiedSdr,command)
}
