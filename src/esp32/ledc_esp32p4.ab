import "./ledc_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("p4LedcRead")
trusted fun p4LedcReadHook(offset: int): int = mmioLoadU32(0x500d3000+offset)
@export("p4LedcWrite")
trusted fun p4LedcWriteHook(offset: int,value: int): void { mmioStoreU32(0x500d3000+offset,value); return }
