import "./sdk/buffer.ab"
import "./storage/api_esp32.ab"
import "./nvs_modes.ab"
import "abla/unsafe/memory"

@inline
trusted fun esp32NvsPointerWord(value: i64*): u32 =
    u32(nativePointerAddress(value))

trusted noescape fun nvs_flash_init(): i32 =
    i32(esp32RecoveredNvsFlashInit(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    ))

trusted noescape fun nvs_open(
    namespaceName: i64*,
    openMode: i32,
    outputHandle: i64*
): i32 = i32(esp32RecoveredNvsOpen(
    esp32NvsPointerWord(namespaceName), u32(openMode),
    esp32NvsPointerWord(outputHandle),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0)
))

trusted noescape fun nvs_set_i32(
    handle: i32,
    key: i64*,
    value: i32
): i32 = i32(esp32RecoveredNvsSetI32(
    u32(handle), esp32NvsPointerWord(key), u32(value),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0)
))

trusted noescape fun nvs_get_i32(
    handle: i32,
    key: i64*,
    outputValue: i64*
): i32 = i32(esp32RecoveredNvsGetI32(
    u32(handle), esp32NvsPointerWord(key),
    esp32NvsPointerWord(outputValue),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0), u32(0), u32(0),
    u32(0), u32(0), u32(0)
))

trusted noescape fun nvs_commit(handle: i32): i32 =
    i32(esp32RecoveredNvsCommit(
        u32(handle),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    ))

trusted noescape fun nvs_close(handle: i32): void {
    esp32RecoveredNvsClose(
        u32(handle),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

type NvsNamespace = int
type NvsI32Result = int

fun NvsNamespace.valid(): bool = this != 0
fun NvsNamespace.handle(): int = this

fun NvsI32Result.valid(): bool = (this & 4294967296) != 0

fun NvsI32Result.value(): int {
    val bits = this & 4294967295
    if (bits < 2147483648) bits else bits - 4294967296
}

fun nvsI32Result(value: int): NvsI32Result = NvsI32Result(
    (value & 4294967295) | 4294967296
)

fun invalidNvsI32Result(): NvsI32Result = NvsI32Result(0)

trusted fun nvsInitialize(): bool = nvs_flash_init() == 0

trusted fun nvsOpen(
    namespaceName: string,
    readWrite: bool = false
): NvsNamespace {
    val outputAddress = nativeStackAllocate(4)
    val output = nativeBufferAt(outputAddress, 4)
    output.storeU32(0, 0)
    val status = nvs_open(
        nativePointerFromAddress(nativeCStringAddress(namespaceName)),
        i32(if (readWrite) nvsReadWrite else nvsReadOnly),
        output.pointer()
    )
    if (status == 0) NvsNamespace(output.loadU32(0))
    else NvsNamespace(0)
}

trusted fun NvsNamespace.setI32(key: string, value: int): bool =
    this.valid() && nvs_set_i32(
        i32(this.handle()),
        nativePointerFromAddress(nativeCStringAddress(key)),
        i32(value)
    ) == 0

trusted fun NvsNamespace.getI32(key: string): NvsI32Result {
    if (!this.valid()) return invalidNvsI32Result()
    val outputAddress = nativeStackAllocate(4)
    val output = nativeBufferAt(outputAddress, 4)
    output.storeU32(0, 0)
    val status = nvs_get_i32(
        i32(this.handle()),
        nativePointerFromAddress(nativeCStringAddress(key)),
        output.pointer()
    )
    if (status == 0) nvsI32Result(output.loadU32(0))
    else invalidNvsI32Result()
}

trusted fun NvsNamespace.commit(): bool =
    this.valid() && nvs_commit(i32(this.handle())) == 0

trusted fun NvsNamespace.close(): void {
    if (this.valid()) nvs_close(i32(this.handle()))
    return
}
