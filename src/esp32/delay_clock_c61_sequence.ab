import "abla/runtime/scalar"
// IDF6 rtc_clk_cpu_freq_get_config: root XTAL/RC_FAST/PLL160 divided by
// PCR.cpu_freq_conf.cpu_div_num+1. Caller supplies measured/pinned oscillator
// rates: this is timing configuration, NOT oscillator measurement/startup.
// Caller excludes clock changes and concurrent ROM-delay users throughout.
// Status1configured2unowned3invalidsource/rate4fractionalMHz5clockchanged.
// A clock-change failure after the ROM write must be resolved before delays.
type Esp32C61DelayClock=int
fun Esp32C61DelayClock.status(): int = this&255
fun Esp32C61DelayClock.ready(): bool = this.status() == 1
fun Esp32C61DelayClock.ticksPerMicrosecond(): int = if (this.ready()) (this>>>8)&255 else 0
fun esp32C61CpuRateHz(source: int,divider: int,xtalHz: int,rcFastHz: int): int {
    if (source < 0 || source > 2 || divider < 1 || divider > 256) return 0
    val root=if (source == 0) xtalHz else if (source == 1) rcFastHz else 160000000
    if (root < 1000000 || root > 160000000 || root%divider != 0) return 0
    return root/divider
}
trusted fun esp32C61DelayClockConfigureOwned(xtalHz: int,rcFastHz: int,exclusiveStableClock: bool): Esp32C61DelayClock {
    if (!exclusiveStableClock) return Esp32C61DelayClock(2)
    val source=(c61DelayClockRead(0x600960e8)>>>16)&3
    val divider=(c61DelayClockRead(0x600960f0)&255)+1
    val hz=esp32C61CpuRateHz(source,divider,xtalHz,rcFastHz)
    if (hz == 0) return Esp32C61DelayClock(3)
    if (hz < 1000000 || hz%1000000 != 0) return Esp32C61DelayClock(4)
    if (((c61DelayClockRead(0x600960e8)>>>16)&3) != source ||
        (c61DelayClockRead(0x600960f0)&255)+1 != divider) return Esp32C61DelayClock(5)
    c61DelayClockSetRomTicks(hz/1000000)
    if (((c61DelayClockRead(0x600960e8)>>>16)&3) != source ||
        (c61DelayClockRead(0x600960f0)&255)+1 != divider) return Esp32C61DelayClock(5)
    return Esp32C61DelayClock(1|((hz/1000000)<<8))
}
