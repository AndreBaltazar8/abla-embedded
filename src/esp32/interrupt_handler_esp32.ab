import "../xtensa/cpu.ab"
import "./interrupt_matrix_esp32_logic.ab"

// Installs on the executing core. `cpu` must name that same core; cross-core
// table writes are deliberately rejected because they do not synchronize the
// remote INTENABLE register or an in-flight remote dispatcher.
@inline
trusted fun Esp32Cpu.install(
    interrupt: XtensaInterrupt,
    handler: XtensaInterruptHandler
): bool {
    if (!this.valid() || this.number() != int(cpuCoreId()) ||
        !esp32XtensaInterruptSupportsNativeHandler(interrupt)) return false
    xtensaInterruptTable().install(
        interrupt, this.number(), esp32XtensaCoreCount, handler
    )
}

// The normal current-core form reads PRID exactly once. Keeping the executing
// core implicit avoids constructing a value only to prove it equals PRID.
@inline
trusted fun XtensaInterrupt.install(
    handler: XtensaInterruptHandler
): bool {
    if (!esp32XtensaInterruptSupportsNativeHandler(this)) return false
    val core = int(cpuCoreId())
    if (core < 0 || core >= esp32XtensaCoreCount) return false
    val table = xtensaInterruptTable()
    table.installUnchecked(
        this,
        table.rawAddress() + u32(
            (int(this.number()) * esp32XtensaCoreCount + core) * 8
        ),
        handler
    )
    true
}
