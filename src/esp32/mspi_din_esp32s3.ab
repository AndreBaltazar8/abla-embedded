import "./mspi_din_s3_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.s3MspiDinRead")
trusted fun esp32S3MspiDinRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3MspiDinUpdate")
trusted fun esp32S3MspiDinUpdate(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
