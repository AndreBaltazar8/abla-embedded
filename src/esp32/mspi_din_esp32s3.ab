import "./mspi_din_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@section(".iram1.abla.s3MspiDinRead")
@export("esp32S3MspiDinRead")
trusted fun esp32S3MspiDinReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3MspiDinUpdate")
@export("esp32S3MspiDinUpdate")
trusted fun esp32S3MspiDinUpdateHook(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
