import "./dsi_short_p4_sequence.ab"
// IDF6 command-host timing defaults. Caller owns a powered, PLL-locked host
// and has stopped video/bridge traffic. This is explicit mode configuration,
// not a live video-to-command transition or peripheral/analog initialization.
// laneKbps is the actual lane rate rounded UP to kbit/s for safe division.
// Bounded preflight; no changes if queues are not clean or errors are pending.
trusted fun esp32P4DsiConfigureCommandHostOwned(laneKbps: int,channel: int,forceHs: bool,polls: int): DsiCommandResult {
    if (laneKbps < 80000 || laneKbps > 1500000 || channel < 0 || channel > 3 ||
        polls < 1 || polls > 1000000) return DsiCommandResult(2)
    if (!esp32P4DsiWaitIdleOwned(polls)) return DsiCommandResult(3)
    if ((p4DsiRead(116)&u32(16)) == u32(0)) return DsiCommandResult(9)
    val errors=esp32P4DsiErrorSnapshotOwned()
    if (errors != 0) return DsiCommandResult(errors|4)
    // Escape divisor must be >=2. Ceiling, unlike upstream roundf, keeps
    // escape <=18MHz even at low/fractional rates. Timeout nearest10MHz.
    var escape=int((u32(laneKbps)+u32(143999))/u32(144000))
    if (escape < 2) escape=2
    val timeout=int((u32(laneKbps)+u32(40000))/u32(80000))
    p4DsiWrite(52,p4DsiRead(52)|u32(1))
    p4DsiWrite(148,(p4DsiRead(148)&u32(4294967292))|u32(if (forceHs) 1 else 3))
    p4DsiWrite(156,(p4DsiRead(156)&u32(4227922944))|u32((50<<16)|104))
    p4DsiWrite(152,(p4DsiRead(152)&u32(4227922944))|u32((46<<16)|128))
    // HS EoTp on, LP EoTp off, ECC/CRC and read BTA on. Preserve RX EoTp.
    p4DsiWrite(44,(p4DsiRead(44)&u32(4294967263))|u32(29))
    p4DsiWrite(8,(p4DsiRead(8)&u32(4294901760))|u32((timeout<<8)|escape))
    // Match IDF timeout-count policy; software transactions remain bounded.
    p4DsiWrite(120,u32(0))
    var offset=124
    while (offset <= 140) {
        p4DsiWrite(offset,p4DsiRead(offset)&u32(4294901760))
        offset=offset+4
    }
    p4DsiWrite(244,(p4DsiRead(244)&u32(4294934528))|u32(6000))
    p4DsiWrite(164,(p4DsiRead(164)&u32(4294902015))|u32(16128))
    p4DsiWrite(48,(p4DsiRead(48)&u32(4294967292))|u32(channel))
    // All generic/DCS reads+writes and max-return commands in LP. No TE
    // request or write ACK request; read responses still use BTA above.
    p4DsiWrite(104,(p4DsiRead(104)&u32(4294967292))|u32(17792768))
    DsiCommandResult(1)
}
