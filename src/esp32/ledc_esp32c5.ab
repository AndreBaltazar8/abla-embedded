import "./ledc_c5_sequence.ab"
import "abla/unsafe/mmio"
import "abla/runtime/scalar"
import "../hal/esp32.ab"
@export("c5LedcRead")
trusted fun c5LedcReadHook(offset: int): int = mmioLoadU32(0x60007000+offset)
@export("c5LedcWrite")
trusted fun c5LedcWriteHook(offset: int,value: int): void { mmioStoreU32(0x60007000+offset,value);return }
