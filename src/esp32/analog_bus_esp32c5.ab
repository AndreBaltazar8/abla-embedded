import "./analog_bus_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@section(".iram1.abla.c5AnalogRead")
@export("c5AnalogRead")
trusted fun c5AnalogReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5AnalogWrite")
@export("c5AnalogWrite")
trusted fun c5AnalogWriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
