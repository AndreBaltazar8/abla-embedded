import "./analog_bus_c5_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.c5AnalogRead")
trusted fun c5AnalogRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.c5AnalogWrite")
trusted fun c5AnalogWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
