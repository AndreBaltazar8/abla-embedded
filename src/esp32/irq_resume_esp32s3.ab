import "./irq_resume_s3_sequence.ab"
import "./irq_stack_esp32s3.ab"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
import "abla/unsafe/mmio"
@inline
@export("esp32S3IrqResumeCore")
trusted fun esp32S3IrqResumeCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3IrqResumeStatus")
trusted fun esp32S3IrqResumeStatusHook(): int = xtensaGuardStatus()
@inline
@export("esp32S3IrqResumeConfig")
trusted fun esp32S3IrqResumeConfigHook(): int = esp32S3IrqConfigAddress()
@inline
@export("esp32S3IrqResumeRead")
trusted fun esp32S3IrqResumeReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3IrqResumeWrite")
trusted fun esp32S3IrqResumeWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
