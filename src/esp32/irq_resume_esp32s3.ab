import "./irq_resume_s3_sequence.ab"
import "./irq_stack_esp32s3.ab"
@inline
trusted fun esp32S3IrqResumeCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3IrqResumeStatus(): int = xtensaGuardStatus()
@inline
trusted fun esp32S3IrqResumeConfig(): int = esp32S3IrqConfigAddress()
@inline
trusted fun esp32S3IrqResumeRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3IrqResumeWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
