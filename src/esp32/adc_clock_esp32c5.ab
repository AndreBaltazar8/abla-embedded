import "./adc_clock_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/mmio"
trusted fun c5AdcClockRead(offset: int): u32 = u32(mmioLoadU32(0x60096088+offset))
trusted fun c5AdcClockWrite(offset: int,value: u32): void { mmioStoreU32(0x60096088+offset,int(value));return }
trusted fun c5AdcRead(offset: int): u32 = u32(mmioLoadU32(0x6000e000+offset))
trusted fun c5AdcWrite(offset: int,value: u32): void { mmioStoreU32(0x6000e000+offset,int(value));return }
