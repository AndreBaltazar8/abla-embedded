import "./adc_clock_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("c5AdcClockRead")
trusted fun c5AdcClockReadHook(offset: int): u32 = u32(mmioLoadU32(0x60096088+offset))
@export("c5AdcClockWrite")
trusted fun c5AdcClockWriteHook(offset: int,value: u32): void { mmioStoreU32(0x60096088+offset,int(value));return }
@export("c5AdcRead")
trusted fun c5AdcReadHook(offset: int): u32 = u32(mmioLoadU32(0x6000e000+offset))
@export("c5AdcWrite")
trusted fun c5AdcWriteHook(offset: int,value: u32): void { mmioStoreU32(0x6000e000+offset,int(value));return }
