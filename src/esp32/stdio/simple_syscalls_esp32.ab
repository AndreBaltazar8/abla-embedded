import "simple_esp32.ab"
import "../rom/serial_output_esp32.ab"
import "../vfs/calls_esp32.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

val esp32ConsoleBadFileDescriptor = u32(9)
val esp32ConsoleTryAgain = u32(11)
val esp32ConsoleError = u32(0xffffffff)

@inline
trusted fun esp32ConsoleSetErrno(value: u32): void {
    val errnoAddress = u32(nativeInternalSectionThreadLocalAllocate(
        4, "errno", ".tdata.errno", 4
    ))
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(errnoAddress)), int(value)
    )
    return
}

@inline
trusted fun esp32ConsolePutCharacter(character: u32): void {
    esp32RecoveredEspSystemConsolePutChar(
        character, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    return
}

trusted fun esp32WriteConsole(
    reentrantState: u32,
    descriptor: u32,
    buffer: u32,
    length: u32
): u32 {
    if (descriptor != u32(1) && descriptor != u32(2)) {
        esp32ConsoleSetErrno(esp32ConsoleBadFileDescriptor)
        return esp32ConsoleError
    }
    var index = u32(0)
    while (index < length) {
        val character = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(buffer + index))
        ))
        if (character == u32(10)) esp32ConsolePutCharacter(u32(13))
        esp32ConsolePutCharacter(character)
        index = index + u32(1)
    }
    return length
}

trusted fun esp32ReadConsole(
    reentrantState: u32,
    descriptor: u32,
    buffer: u32,
    length: u32
): u32 {
    if (descriptor != u32(0)) {
        esp32ConsoleSetErrno(esp32ConsoleBadFileDescriptor)
        return esp32ConsoleError
    }
    var count = u32(0)
    while (count < length) {
        val destination = buffer + count
        if (esp32RomOutputRxOneChar(destination) != u32(0)) break
        val character = u32(ablaUnsafeLoadU8(
            nativePointerFromAddress(int(destination))
        ))
        if (character == u32(13)) ablaUnsafeStoreU8(
            nativePointerFromAddress(int(destination)), 10
        )
        count = count + u32(1)
    }
    if (count == u32(0)) {
        esp32ConsoleSetErrno(esp32ConsoleTryAgain)
        return esp32ConsoleError
    }
    return count
}

trusted fun esp32RecoveredWriteRConsole(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32, stack4: u32,
    stack5: u32, stack6: u32, stack7: u32, stack8: u32, stack9: u32
): u32 = esp32WriteConsole(a2, a3, a4, a5)

trusted fun esp32RecoveredReadRConsole(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32, stack4: u32,
    stack5: u32, stack6: u32, stack7: u32, stack8: u32, stack9: u32
): u32 = esp32ReadConsole(a2, a3, a4, a5)

trusted fun esp32RecoveredFstatRConsole(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32, stack4: u32,
    stack5: u32, stack6: u32, stack7: u32, stack8: u32, stack9: u32
): u32 = esp32VfsFstat(a2, a3, a4)

trusted fun esp32RecoveredFsyncConsole(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32, stack4: u32,
    stack5: u32, stack6: u32, stack7: u32, stack8: u32, stack9: u32
): u32 = esp32RecoveredFsync(
    a2, a3, a4, a5, a6, a7,
    stack0, stack1, stack2, stack3, stack4,
    stack5, stack6, stack7, stack8, stack9
)
