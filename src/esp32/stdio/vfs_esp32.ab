// Original ABI symbol: esp_stdio_register
trusted fun esp32RecoveredEspStdioRegister(): i32 {
    esp32StdioStoreU32(
        esp32StdioPrimaryVfsAddress(),
        esp32UartVfsGetVfs()
    )
    return esp32StdioRegisterConsole()
}

trusted fun esp32StdioInitVfsConsole(): i32 {
    esp32StdioStoreU32(
        esp32StdioPrimaryVfsAddress(),
        esp32UartVfsGetVfs()
    )
    return i32(esp32VfsRegisterStaticKnownPath(
        esp32StdioConsolePathAddress(),
        u32(12),
        esp32StdioOpsAddress(),
        u32(10),
        u32(0),
        true
    ))
}

// Original ABI symbol: esp_vfs_include_console_register
trusted fun esp32RecoveredEspVfsIncludeConsoleRegister(): void {
    // ESP-IDF names this symbol with -u so the console startup descriptor is
    // linked even though no ordinary code calls the hook. Taking the internal
    // descriptor address gives Abla's section graph that exact edge; LLVM can
    // then erase the unused address operation from the emitted hook.
    esp32StdioStartupDescriptorAddress()
    return
}

