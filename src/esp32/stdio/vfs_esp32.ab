// Original ABI symbol: console_close
trusted fun esp32RecoveredConsoleClose(context: u32, descriptor: i32): i32 {
    val countAddress = esp32StdioOpenCountAddress()
    val count = esp32StdioLoadU32(countAddress)
    if (count == u32(0)) {
        esp32StdioSetErrno(u32(9))
        return i32(-1)
    }
    val remaining = count - u32(1)
    esp32StdioStoreU32(countAddress, remaining)
    if (remaining == u32(0)) {
        ablaUnsafeCallI32I32(
            int(esp32StdioCloseAddress()),
            int(esp32StdioLoadU32(esp32StdioConsoleAddress()))
        )
    }
    return i32(0)
}

