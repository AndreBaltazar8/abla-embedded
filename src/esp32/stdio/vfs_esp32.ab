// Original ABI symbol: console_start_select
trusted fun esp32RecoveredConsoleStartSelect(
    descriptorCount: i32,
    readDescriptors: u32,
    writeDescriptors: u32,
    exceptDescriptors: u32,
    selectSemaphoreWord0: u32,
    selectSemaphoreWord1: u32,
    endSelectArguments: u32
): i32 {
    val vfs = esp32StdioLoadU32(esp32StdioPrimaryVfsAddress())
    val select = esp32StdioLoadU32(vfs + u32(48))
    val callback = esp32StdioLoadU32(select)
    if (callback == u32(0)) return i32(0x106)
    return i32(ablaUnsafeCallI32I32I32I32I32I32I32I32(
        int(callback),
        int(descriptorCount),
        int(readDescriptors),
        int(writeDescriptors),
        int(exceptDescriptors),
        int(selectSemaphoreWord0),
        int(selectSemaphoreWord1),
        int(endSelectArguments)
    ))
}

// Original ABI symbol: console_end_select
trusted fun esp32RecoveredConsoleEndSelect(arguments: u32): i32 {
    val vfs = esp32StdioLoadU32(esp32StdioPrimaryVfsAddress())
    val select = esp32StdioLoadU32(vfs + u32(48))
    val callback = esp32StdioLoadU32(select + u32(20))
    if (callback == u32(0)) return i32(0x106)
    return i32(ablaUnsafeCallI32I32(int(callback), int(arguments)))
}

// Original ABI symbol: console_open
trusted fun esp32RecoveredConsoleOpen(
    context: u32,
    path: u32,
    flags: i32,
    mode: i32
): i32 {
    val countAddress = esp32StdioOpenCountAddress()
    val count = esp32StdioLoadU32(countAddress)
    if (count != u32(0)) {
        esp32StdioStoreU32(countAddress, count + u32(1))
        return i32(0)
    }
    val descriptor = ablaUnsafeCallI32I32I32I32(
        int(esp32StdioOpenAddress()),
        int(esp32StdioUartPathAddress()),
        int(flags),
        int(mode)
    )
    esp32StdioStoreU32(esp32StdioConsoleAddress(), u32(descriptor))
    esp32StdioStoreU32(countAddress, u32(1))
    return i32(0)
}

