import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkStdioVfsInternals(): bool {
    if (!internalFunction("esp32RecoveredConsoleStartSelect", "console_start_select")) return false
    if (!internalFunction("esp32RecoveredConsoleEndSelect", "console_end_select")) return false
    if (!internalFunction("esp32RecoveredConsoleOpen", "console_open")) return false
    if (!internalFunction("esp32RecoveredConsoleWrite", "console_write")) return false
    if (!internalFunction("esp32RecoveredConsoleFstat", "console_fstat")) return false
    if (!internalFunction("esp32RecoveredConsoleClose", "console_close")) return false
    if (!internalFunction("esp32RecoveredConsoleRead", "console_read")) return false
    if (!internalFunction("esp32RecoveredConsoleFcntl", "console_fcntl")) return false
    if (!internalFunction("esp32RecoveredConsoleFsync", "console_fsync")) return false
    if (!internalFunction("esp32RecoveredConsoleAccess", "console_access")) return false
    if (!internalFunction("esp32RecoveredEspStdioRegister", "esp_stdio_register")) return false
    if (!internalFunction("esp32StdioInitVfsConsole", "esp32_stdio_init_vfs_console")) return false
    // ESP-IDF forces this one linker hook with -u. It is the sole foreign root;
    // all console operations reached through its startup/table data stay local.
    if (!exportFunction("esp32RecoveredEspVfsIncludeConsoleRegister", "esp_vfs_include_console_register")) return false
    true
}
