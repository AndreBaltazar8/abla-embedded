import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkStdioSimpleSyscallsInternals(): bool {
    if (!internalFunction("esp32WriteConsole", "_write_r_console")) return false
    if (!internalFunction("esp32ReadConsole", "_read_r_console")) return false
    if (!internalFunction("esp32RecoveredFstatRConsole", "_fstat_r_console")) return false
    if (!internalFunction("esp32RecoveredFsyncConsole", "_fsync_console")) return false
    true
}
