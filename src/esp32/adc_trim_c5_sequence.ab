// C5 adc_ll.h/regi2c_saradc.h, block0x69: initial0/1, DREF2[6:4],
// calibration ground8[1]. No ADC2/TSENS/glitch-detector fields modified.
import "./adc_power_c5_sequence.ab"
import "./adc_calibration_c5_logic.ab"
// Exclusive lifetime also owns both analog masters/selector and pins their
// clock/power, excludes PHY/LP/RNG/interrupt analog users. Field writes are
// followed by independent device reads. Bus may wait for submitted commands.
// Ready is trim setup only, not settled/sampling-ready ADC configuration.
// status0closed1ready2invalid3power4busy5snapshot-read6write/readback.
// bits8..19old initial,20..22DREF,23ground,24snapshot-valid.
type C5AdcTrimOwner=int
fun C5AdcTrimOwner.status(): int = this&255
fun C5AdcTrimOwner.ready(): bool = this.status() == 1
trusted fun c5AdcTrimPowered(): bool = c5AdcClocksReady() && (c5AdcRead(0)&u32(0x18000040)) == u32(0x18000040)
trusted fun c5AdcTrimSet(reg: int,low: int,high: int,value: int): bool =
    c5AdcTrimField(reg,low,high,value) == value && c5AdcTrimField(reg,low,high,-1) == value
trusted fun c5AdcTrimOpenOwned(calibration: C5AdcCalibration,exclusiveStopped: bool): C5AdcTrimOwner {
    if (!exclusiveStopped || !calibration.valid()) return C5AdcTrimOwner(2)
    if (!c5AdcTrimPowered()) return C5AdcTrimOwner(3)
    if (!c5AdcAllStopped()) return C5AdcTrimOwner(4)
    val low=c5AdcTrimField(0,0,7,-1)
    val high=c5AdcTrimField(1,0,3,-1)
    val dref=c5AdcTrimField(2,4,6,-1)
    val ground=c5AdcTrimField(8,1,1,-1)
    if (low < 0 || low > 255 || high < 0 || high > 15 || dref < 0 || dref > 7 || ground < 0 || ground > 1) return C5AdcTrimOwner(5)
    val snapshot=(1<<24)|(low<<8)|(high<<16)|(dref<<20)|(ground<<23)
    val initial=calibration.initCode()
    if (!c5AdcTrimSet(2,4,6,1) || !c5AdcTrimSet(8,1,1,0) ||
        !c5AdcTrimSet(1,0,3,initial>>>8) || !c5AdcTrimSet(0,0,7,initial&255)) return C5AdcTrimOwner(snapshot|6)
    return C5AdcTrimOwner(snapshot|1)
}
trusted fun C5AdcTrimOwner.closeOwned(exclusiveStopped: bool): C5AdcTrimOwner {
    if (!exclusiveStopped || this < 0 || (this&~0x1ffffff) != 0 || this.status() > 6 || (this&(1<<24)) == 0) return this
    val snapshot=this&0x1ffff00
    if (!c5AdcTrimPowered()) return C5AdcTrimOwner(snapshot|3)
    if (!c5AdcAllStopped()) return C5AdcTrimOwner(snapshot|4)
    if (!c5AdcTrimSet(1,0,3,(snapshot>>>16)&15) || !c5AdcTrimSet(0,0,7,(snapshot>>>8)&255) ||
        !c5AdcTrimSet(8,1,1,(snapshot>>>23)&1) || !c5AdcTrimSet(2,4,6,(snapshot>>>20)&7)) return C5AdcTrimOwner(snapshot|6)
    return C5AdcTrimOwner(0)
}
