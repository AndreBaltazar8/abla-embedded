import "./exception_handler_s3_sequence.ab"
import "./irq_stack_esp32s3.ab"
@inline
trusted fun esp32S3ExceptionCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3ExceptionEnabled(): int = esp32S3IrqStackEnabled()
@inline
trusted fun esp32S3ExceptionConfig(): int = esp32S3IrqConfigAddress()
@inline
trusted fun esp32S3ExceptionRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3ExceptionWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
