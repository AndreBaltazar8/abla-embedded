import "./exception_handler_s3_sequence.ab"
import "./irq_stack_esp32s3.ab"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
import "abla/unsafe/mmio"
@inline
@export("esp32S3ExceptionCore")
trusted fun esp32S3ExceptionCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3ExceptionEnabled")
trusted fun esp32S3ExceptionEnabledHook(): int = esp32S3IrqStackEnabled()
@inline
@export("esp32S3ExceptionConfig")
trusted fun esp32S3ExceptionConfigHook(): int = esp32S3IrqConfigAddress()
@inline
@export("esp32S3ExceptionRead")
trusted fun esp32S3ExceptionReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3ExceptionWrite")
trusted fun esp32S3ExceptionWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
