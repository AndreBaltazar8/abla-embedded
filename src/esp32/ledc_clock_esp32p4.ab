import "./ledc_clock_p4_sequence.ab"
import "./ledc_esp32p4.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("p4LedcClockRead")
trusted fun p4LedcClockReadHook(offset: int): int = mmioLoadU32(0x500e6000+offset)
@export("p4LedcClockWrite")
trusted fun p4LedcClockWriteHook(offset: int,value: int): void { mmioStoreU32(0x500e6000+offset,value); return }
