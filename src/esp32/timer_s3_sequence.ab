// Caller keeps SYSTIMER clocked/configured and serializes snapshot requests.
// Raw 52-bit ticks, not microseconds: no clock-frequency assumption or timer
// reset/load/enable is hidden. Negative: -1 invalid, -2 latch timeout,
// -3 unstable snapshot. Each polling/retry phase is independently bounded.
trusted fun esp32S3TimerTicks(unit: int = 0, polls: int = 100000): int {
    if (unit < 0 || unit > 1 || polls < 1 || polls > 1000000) return -1
    val operation = 0x60023004 + unit * 4
    esp32S3TimerWrite(operation,esp32S3TimerRead(operation) | u32(0x40000000))
    var attempt = u32(0)
    while (attempt < u32(polls)) {
        if ((esp32S3TimerRead(operation) & u32(0x20000000)) != u32(0)) break
        attempt = attempt + u32(1)
    }
    if (attempt == u32(polls)) return -2
    val highAddress = 0x60023040 + unit * 8
    val lowAddress = highAddress + 4
    var low = esp32S3TimerRead(lowAddress)
    attempt = u32(0)
    while (attempt < u32(polls)) {
        val high = esp32S3TimerRead(highAddress) & u32(0xfffff)
        val next = esp32S3TimerRead(lowAddress)
        if (low == next) return (int(high) << 32) | int(low)
        low = next
        attempt = attempt + u32(1)
    }
    -3
}
