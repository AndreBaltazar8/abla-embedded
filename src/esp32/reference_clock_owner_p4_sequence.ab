import "./reference_clock_p4_sequence.ab"
// One authoritative scalar per output for ALL participating consumers.
// Always assign acquire/release results under the same cross-core RCC lock;
// copying this value does not create an independent ownership authority.
// Output gate lifetime only: underlying PLL power/frequency remains pinned
// by the boot/platform clock manager, not inferred from an enabled gate.
type Esp32P4ReferenceClockOwner = int
fun esp32P4ReferenceClockOwner(mhz: int): Esp32P4ReferenceClockOwner {
    if (esp32P4ReferenceClockField(mhz) < 0) return Esp32P4ReferenceClockOwner(0)
    Esp32P4ReferenceClockOwner((mhz<<24)|262144)
}
fun Esp32P4ReferenceClockOwner.valid(): bool = (this&262144) != 0
fun Esp32P4ReferenceClockOwner.references(): int = this&65535
fun Esp32P4ReferenceClockOwner.mhz(): int = (this>>>24)&255
// 0 idle,1 acquired/released with references remaining,2 overflow,
// 3 failed enable (no usable reference, cleanup needed),4 failed disable
// (last reference retained). No failed operation fabricates an acquisition.
fun Esp32P4ReferenceClockOwner.status(): int = (this>>>19)&7
fun Esp32P4ReferenceClockOwner.borrowed(): bool = (this&65536) != 0
fun Esp32P4ReferenceClockOwner.cleanupRequired(): bool = this.status() == 3 || this.status() == 4

trusted fun Esp32P4ReferenceClockOwner.acquireOwned(): Esp32P4ReferenceClockOwner {
    if (!this.valid() || this.cleanupRequired()) return this
    val base=(this|0)&4278517760
    val count=this.references()
    if (count == 65535) return Esp32P4ReferenceClockOwner(base|65535|(2<<19))
    if (count != 0) return Esp32P4ReferenceClockOwner(base|(count+1)|(1<<19))
    val initial=esp32P4ReferenceClockReadOwned(this.mhz())
    if (initial == 1) return Esp32P4ReferenceClockOwner(base|65536|1|(1<<19))
    if (esp32P4ReferenceClockSetOwned(this.mhz(),true) != 1)
        return Esp32P4ReferenceClockOwner(base|(3<<19))
    Esp32P4ReferenceClockOwner(base|1|(1<<19))
}

trusted fun Esp32P4ReferenceClockOwner.releaseOwned(): Esp32P4ReferenceClockOwner {
    if (!this.valid()) return this
    val base=(this|0)&4278517760
    val count=this.references()
    if (count > 1) return Esp32P4ReferenceClockOwner(base|(count-1)|(1<<19))
    if (count == 0 && this.status() != 3) return this
    if (!this.borrowed() && esp32P4ReferenceClockSetOwned(this.mhz(),false) != 1)
        return Esp32P4ReferenceClockOwner(base|count|((if (count == 0) 3 else 4)<<19))
    // A pre-existing enabled output stays enabled after the last release.
    Esp32P4ReferenceClockOwner(((this|0)&4278190080)|262144)
}
