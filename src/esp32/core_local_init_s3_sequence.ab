// Interrupt/debug portion of S3 call_start_cpu1, reusable for either core.
// Requires a REAL populated vector table and existing valid internal stack;
// this is not a vector implementation or a complete runtime bootstrap.
// Caller owns local CPU/matrix/debug state, interrupts disabled. Region/cache
// protection and exception handlers must be initialized before publishing ready.
@section(".iram1.abla.s3CoreLocalInit")
trusted fun esp32S3CoreLocalInitOwned(core: int,vectorBase: int): bool {
    if (core < 0 || core > 1 || esp32S3MatrixInitCore() != core || esp32S3MatrixInitEnabled() != 0) return false
    // Reserve the complete0x400-byte fixed vector region in internal IRAM.
    if (vectorBase < 0x40370000 || vectorBase > 0x403DFC00 || (vectorBase & 1023) != 0) return false
    // Keep the previous valid vectors active until fallible preparation is
    // complete. A refused matrix initialization must not publish new VECBASE.
    if (!esp32S3InterruptMatrixInitOwned(core)) return false
    if (core == 1) esp32S3CoreClearBootEntry()
    esp32S3CoreDebugWrite(if (core == 0) 0x600CE048 else 0x600CE0D8,1)
    esp32S3CoreDebugWrite(if (core == 0) 0x600CE04C else 0x600CE0DC,1)
    esp32S3CoreInitializeAtomics()
    esp32S3CoreSetVectorBase(vectorBase)
    true
}
