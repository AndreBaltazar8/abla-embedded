import "./dsi_pll_p4_logic.ab"
import "./dsi_phy_p4_sequence.ab"
// Caller owns powered/clocked PHY test interface, with traffic stopped.
// Return is the selected rational rate M*referenceKhz/N, NOT lock proof.
trusted fun esp32P4DsiConfigurePllOwned(referenceKhz: int,mbps: int): DsiPhyPll {
    val plan=esp32P4DsiChoosePll(referenceKhz,mbps)
    esp32P4DsiApplyPllOwned(plan)
}
trusted fun esp32P4DsiConfigurePllKbpsOwned(referenceKhz: int,kbps: int): DsiPhyPll {
    esp32P4DsiApplyPllOwned(esp32P4DsiChoosePllKbps(referenceKhz,kbps))
}
// Internal composition helper; plan must come from the checked selector.
trusted fun esp32P4DsiApplyPllOwned(plan: DsiPhyPll): DsiPhyPll {
    if (!plan.valid()) return plan
    esp32P4DsiPhyWriteRegisterOwned(68,plan.hsRange() << 1)
    esp32P4DsiPhyWriteRegisterOwned(25,48)
    esp32P4DsiPhyWriteRegisterOwned(23,plan.divider()-1)
    esp32P4DsiPhyWriteRegisterOwned(24,(plan.multiplier()-1)&31)
    esp32P4DsiPhyWriteRegisterOwned(24,128|(((plan.multiplier()-1)>>>5)&15))
    plan
}
