import "./peripheral_delay_rom_sequence.ab"
import "abla/unsafe/native"
// Pinned IDF6 C61 ROM and eco4 agree. Caller has calibrated ROM CPU ticks/us
// to the actual pinned CPU frequency. delay_clock_esp32c61.ab provides checked
// ROM tick configuration from the current source/divider and caller-known
// oscillator rates. This delay does not switch/calibrate clocks.
trusted fun peripheralRomDelay(microseconds: int): void {
    callNativeVoidI32(0x4000003c,microseconds);return
}
