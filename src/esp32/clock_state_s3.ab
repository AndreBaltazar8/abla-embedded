import "../runtime/unsigned_division64.ab"

// Register-level clock snapshot, not proof that a PLL is locked. CPU source
// encodings match SYSTEM_SOC_CLK_SEL (XTAL0/PLL1/RC2). No C layout/export.
type Esp32S3ClockState = int
fun Esp32S3ClockState.valid(): bool = (this & (1<<40)) != 0
fun Esp32S3ClockState.source(): int = this & 3
fun Esp32S3ClockState.sourceMegahertz(): int = (this>>>2) & 65535
fun Esp32S3ClockState.divider(): int = (this>>>18) & 2047
fun Esp32S3ClockState.hertz(): int {
    if (!this.valid() || this.divider() == 0) return 0
    int(unsignedDivide64(u64(this.sourceMegahertz()*1000000),u64(this.divider())))
}

// ROM log-disable is bit0 in BOTH mirrored halves, not the high bit.
// Preserve malformed metadata as an error rather than assuming 40MHz.
@inline
fun esp32S3StoredXtalMegahertz(stored: int): int {
    val word=stored & 0xFFFFFFFF
    if (word == 0 || word == 0xFFFFFFFF || (word & 65535) != (word>>>16)) return 0
    word & 65534
}

@section(".iram1.abla.s3ClockDecode")
fun esp32S3ClockDecode(sysclk: int,cpuPeripheral: int,storedXtal: int): Esp32S3ClockState {
    val source=(sysclk>>>10) & 3
    var frequency=0
    var divider=1
    if (source == 0) {
        frequency=esp32S3StoredXtalMegahertz(storedXtal)
        if (frequency == 0) return Esp32S3ClockState(0)
        divider=(sysclk & 1023)+1
    } else if (source == 1) {
        val pll480=(cpuPeripheral & 4) != 0
        frequency=if (pll480) 480 else 320
        val cpu=cpuPeripheral & 3
        if (cpu == 0) divider=if (pll480) 6 else 4
        else if (cpu == 1) divider=if (pll480) 3 else 2
        else if (cpu == 2 && pll480) divider=2
        else return Esp32S3ClockState(0)
    } else if (source == 2) {
        // rtc_clk_cpu_freq_get_config's RC_FAST estimate, not calibration.
        frequency=20
    } else return Esp32S3ClockState(0)
    Esp32S3ClockState(source | (frequency<<2) | (divider<<18) | (1<<40))
}
