import "./flash_jedec_c5.ab"
import "./flash_ready_c5_sequence.ab"
//240B:tag0,state4,phase8,observed JEDEC12,selected mask16,busy samples20,
// pre-ID SR1 child48@24,ID child48@72,actual readiness120@120.
//1ready2invalid3pending4suspended5unsupported/no ID response.1/4/5 are terminal
// snapshots with all borrowed registers restored. No fallback for unknown ID.
// Read SR1 until WIP clears BEFORE RDID: many chips reject RDID while busy.
// Then select an exact supported-ID policy, and verify SR1/SR2 using it. Never
// issue SR2 before identification/selection. All transport, timing, cache-off,
// retention/exclusion/SDR-chip-mode prerequisites of the child readers apply.
// A selected ID qualifies the SUS layout, not board timing or chip voltage.
@section(".iram1.abla.c5FlashIdentifiedReady")
trusted fun esp32C5FlashIdentifiedReadyOwned(record: NativeBuffer,polls: int,exclusiveQualifiedSdr: bool): int {
    if (!exclusiveQualifiedSdr || !record.hasAddressRange(0,240) || (record.addressValue()&3) != 0 || polls < 1 || polls > 1000000) return 2
    val tag=c5SleepRecordRead(record,0)
    if (tag != 0 && tag != 0x43495231) return 2
    if (tag == 0) {
        c5SleepRecordWrite(record,8,0);c5SleepRecordWrite(record,12,-1);c5SleepRecordWrite(record,16,0);c5SleepRecordWrite(record,20,0)
        c5SleepRecordWrite(record,24,0);c5SleepRecordWrite(record,72,0);c5SleepRecordWrite(record,120,0)
        c5SleepRecordWrite(record,4,3);c5SleepRecordWrite(record,0,0x43495231)
    } else {
        if (c5SleepRecordRead(record,4) == 1) return 1
        if (c5SleepRecordRead(record,4) == 4) return 4
        if (c5SleepRecordRead(record,4) == 5) return 5
        if (c5SleepRecordRead(record,4) != 3 || c5SleepRecordRead(record,8) > 2) return 2
    }
    val base=record.addressValue()
    if (c5SleepRecordRead(record,8) == 0) {
        val result=esp32C5FlashStatusReadOwned(nativeBufferAt(base+24,48),polls,true)
        if (result != 1) return result
        if ((c5SleepRecordRead(record,36)&1) != 0) {
            c5SleepRecordWrite(record,24,0)
            val samples=c5SleepRecordRead(record,20)
            if (samples < 0xffffffff) c5SleepRecordWrite(record,20,samples+1)
            return 3
        }
        c5SleepRecordWrite(record,8,1)
    }
    if (c5SleepRecordRead(record,8) == 1) {
        val child=nativeBufferAt(base+72,48)
        val result=esp32C5FlashJedecReadOwned(child,polls,true)
        if (result != 1) return result
        val id=esp32C5FlashJedecId(child)
        val mask=esp32C5FlashSuspendMaskForJedec(id)
        c5SleepRecordWrite(record,12,id)
        if (mask < 1) { c5SleepRecordWrite(record,4,5);return 5 }
        c5SleepRecordWrite(record,16,mask);c5SleepRecordWrite(record,8,2)
    }
    val result=esp32C5FlashReadyOwned(nativeBufferAt(base+120,120),c5SleepRecordRead(record,16),polls,true)
    if (result == 1 || result == 4) c5SleepRecordWrite(record,4,result)
    result
}
