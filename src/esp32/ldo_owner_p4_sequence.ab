import "./ldo_pmu_p4_sequence.ab"
// Exclusive rail lease, not a shared reference count. Assign every returned
// state. Start refusal never gives permission to shut down an existing rail.
// Status0closed,1configured,2invalid,3preexisting/refused,4readback failure.
// Bit17 owns attempted setup; channel4..7, verified revision8..16.
type Esp32P4LdoOwner = int
fun Esp32P4LdoOwner.status(): int = this&15
fun Esp32P4LdoOwner.channel(): int = (this>>>4)&15
fun Esp32P4LdoOwner.revision(): int = (this>>>8)&511
fun Esp32P4LdoOwner.ownsRail(): bool = (this&131072) != 0
fun Esp32P4LdoOwner.ready(): bool = this.status() == 1 && this.ownsRail()
trusted fun esp32P4LdoOpenOwned(channel: int,millivolts: int,revision: int): Esp32P4LdoOwner {
    if (channel < 1 || channel > 4 || revision < 0 || revision > 399) return Esp32P4LdoOwner(2)
    val result=esp32P4LdoStartOwned(channel,millivolts,revision)
    return Esp32P4LdoOwner(result|(channel<<4)|(revision<<8)|(if (result == 1 || result == 4) 131072 else 0))
}
// All consumers must be shut down first, PMU RMW serialized. No analog settle
// claim follows digital readback; callers still observe required settling.
trusted fun Esp32P4LdoOwner.closeOwned(): Esp32P4LdoOwner {
    if (!this.ownsRail()) return this
    if (this < 0 || (this>>>18) != 0 || this.channel() < 1 || this.channel() > 4 || this.revision() > 399 ||
        (this.status() != 1 && this.status() != 4)) return this
    val result=esp32P4LdoStopOwned(this.channel(),this.revision())
    if (result != 1) return Esp32P4LdoOwner((this&(-16))|result)
    return Esp32P4LdoOwner(0)
}
