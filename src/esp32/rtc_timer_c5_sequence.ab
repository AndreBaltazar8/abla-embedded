// C5 RTC timer LL: 48-bit LP slow-clock ticks, NOT microseconds. Caller
// exclusively owns snapshot buffers/update selection against HP/LP/REGDMA
// writers, including automatic snapshot triggers, throughout each read.
// Snapshot WT publication is synchronous as in upstream LL; no invented busy
// or valid bit. Does not enable/reset timers or select/calibrate the clock.
@section(".iram1.abla.c5RtcTicks")
trusted fun esp32C5RtcTicksOwned(buffer: int,exclusive: bool): int {
    if (!exclusive || buffer < 0 || buffer > 1) return -1
    val update=c5RtcTimerRead(0x10)
    c5RtcTimerWrite(0x10,(update&~0x8000000)|0x8000000)
    val low=c5RtcTimerRead(0x14+buffer*8)&0xFFFFFFFF
    val high=c5RtcTimerRead(0x18+buffer*8)&65535
    (high<<32)|low
}
// Exact modulo-48 elapsed ticks, valid only for an interval shorter than one
// counter wrap. Clock reset/reconfiguration is not an elapsed-time interval.
@section(".iram1.abla.c5RtcElapsed")
fun esp32C5RtcElapsedTicks(before: int,after: int): int {
    if (before < 0 || before > 0xFFFFFFFFFFFF || after < 0 || after > 0xFFFFFFFFFFFF) return -1
    (after-before)&0xFFFFFFFFFFFF
}
// Own an inactive comparator and its interrupt; existing status is cleared
// irreversibly. Caller chooses a future target and supplies PMU wake routing.
// This is not sleep entry and does not promise a past target will wake now.
// 1armed,2invalid,3target-write failure (never armed by this call).
@section(".iram1.abla.c5RtcAlarm")
trusted fun esp32C5RtcAlarmOwned(timer: int,target: int,exclusiveInactive: bool): int {
    if (!exclusiveInactive || timer < 0 || timer > 1 || target < 0 || target > 0xFFFFFFFFFFFF) return 2
    c5RtcTimerWrite(if (timer == 0) 0x34 else 0x44,0x80000000)
    val high=timer*8+4;val low=timer*8
    // Do not replay the WT enable bit while programming the high field.
    val preserved=c5RtcTimerRead(high)&0x7fff0000
    val value=preserved|((target>>>32)&65535)
    c5RtcTimerWrite(high,value)
    c5RtcTimerWrite(low,target&0xFFFFFFFF)
    if ((c5RtcTimerRead(high)&65535) != ((target>>>32)&65535) || (c5RtcTimerRead(low)&0xFFFFFFFF) != (target&0xFFFFFFFF)) return 3
    c5RtcTimerWrite(high,value|0x80000000)
    1
}
