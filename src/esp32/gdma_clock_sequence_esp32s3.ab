// Run only while holding the canonical S3 RCC lock. Enable the shared bus
// clock and release reset, preserving every other peripheral's bits. Never
// pulse reset: another GDMA channel may already be transferring.
trusted fun esp32s3GdmaEnableClockLocked(): void {
    val clock = esp32s3GdmaRead(0x600c001c)
    if ((clock & 64) == 0) esp32s3GdmaWrite(0x600c001c, clock | 64)
    val reset = esp32s3GdmaRead(0x600c0024)
    if ((reset & 64) != 0) esp32s3GdmaWrite(0x600c0024, reset & 0xffffffbf)
    return
}
