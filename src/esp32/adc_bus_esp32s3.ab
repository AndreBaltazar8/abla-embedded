import "./adc_bus_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@export("esp32S3AdcBusRead")
trusted fun esp32S3AdcBusReadHook(address: int): int = mmioLoadU32(address)
@export("esp32S3AdcBusWrite")
trusted fun esp32S3AdcBusWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
