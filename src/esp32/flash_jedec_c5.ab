import "./flash_status_c5_sequence.ab"
// Same retained48B read-command record/ownership as SR1/SR2. No ID shortcut
// or ROM helper; actual USER command9f reads24 bits with checked restoration.
@section(".iram1.abla.c5FlashJedecRead")
trusted fun esp32C5FlashJedecReadOwned(record: NativeBuffer,polls: int,exclusiveQualifiedSdr: bool): int =
    c5FlashReadCommandOwned(record,polls,exclusiveQualifiedSdr,0x9f)
// Conventional manufacturer/type/capacity order, e.g. EF4017. Preserve the
// raw FIFO value in the record so repeated reads cannot byte-swap it twice.
// -1 means not a completed ID read, or no response (all zero/all one).
@section(".iram1.abla.c5FlashJedecId")
trusted fun esp32C5FlashJedecId(record: NativeBuffer): int {
    if (!record.hasAddressRange(0,48) || c5SleepRecordRead(record,0) != 0x43535231 ||
        c5SleepRecordRead(record,4) != 1 || c5SleepRecordRead(record,36) != 0x9f) return -1
    val raw=c5SleepRecordRead(record,12)
    if (raw == 0 || raw >= 0xffffff) return -1
    ((raw&255)<<16)|(raw&0xff00)|((raw>>>16)&255)
}
// Exact IDF6.0.2 suspend-capability whitelist, not manufacturer heuristics.
// This selects SR2 SUS bits only; it does not qualify board timing, chip mode,
// resume delays, supply voltage or arbitrary same-vendor parts. -1 unknown.
@section(".iram1.abla.c5FlashSuspendMask")
fun esp32C5FlashSuspendMaskForJedec(id: int): int {
    if (id == 0xef4017) return 0x80
    if (id == 0xc84016 || id == 0xc84017 || id == 0xc84018 || id == 0xc84319) return 0x84
    return -1
}
