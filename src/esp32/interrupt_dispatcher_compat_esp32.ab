import "abla/unsafe/memory"
import "abla/unsafe/xtensa"
import "../xtensa/cpu.ab"
import "../xtensa/dispatcher_owned.ab"
import "./interrupt_dispatcher_compat_esp32_logic.ab"

@inline
trusted fun esp32DispatcherLoad(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32DispatcherLoadU8(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32DispatcherStore(address: u32, value: u32): void =
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(address)), int(value)
    )

@inline
trusted fun esp32InterruptDispatcherEntry(index: u32): u32 =
    nativeXtensaInterruptTableAddress() + index * u32(8)

@inline
trusted fun esp32ExceptionDispatcherEntry(index: u32): u32 =
    nativeXtensaExceptionTableAddress() + index * u32(4)

// The vendor default only logs and returns, which can immediately retrigger a
// level interrupt. The Abla-owned fallback instead masks the unexpected CPU
// line before returning. The exact ABI name is retained for native consumers.
@export("xt_unhandled_interrupt")
trusted fun ownedXtensaUnhandledInterrupt(index: u32): void {
    val previous = nativeXtensaInterruptsDisable(
        u32(1) << (index / u32(esp32XtensaCoreCount))
    )
    return
}

@export("xt_int_has_handler")
trusted fun ownedXtensaInterruptHasHandler(
    number: i32,
    cpu: i32
): bool {
    val index = esp32InterruptDispatcherIndex(number, u32(cpu))
    esp32DispatcherLoad(esp32InterruptDispatcherEntry(index)) !=
        nativeXtensaUnhandledInterruptAddress()
}

@export("xt_set_interrupt_handler")
trusted fun ownedXtensaSetInterruptHandler(
    number: i32,
    handler: u32,
    argument: u32
): u32 {
    if (number < i32(0) || number >= xtensaInterruptCount) return u32(0)
    val level = esp32DispatcherLoadU8(
        nativeXtensaInterruptLevelTableAddress() + u32(number)
    )
    if (i32(level) > i32(esp32XtensaMaximumDispatchLevel)) return u32(0)
    val core = cpuCoreId()
    val index = esp32InterruptDispatcherIndex(number, core)
    val entry = esp32InterruptDispatcherEntry(index)
    val entryPointer = nativePointerFromAddress(int(entry))
    val defaultHandler = nativeXtensaUnhandledInterruptAddress()
    val old = u32(ablaUnsafeLoadU32(entryPointer))
    val result = if (old == defaultHandler) u32(0) else old
    if (handler != u32(0)) {
        ablaUnsafeStoreU32(entryPointer, int(handler))
        ablaUnsafeStoreU32(
            ablaUnsafePointerOffset(entryPointer, 4), int(argument)
        )
    } else {
        ablaUnsafeStoreU32(entryPointer, int(defaultHandler))
        ablaUnsafeStoreU32(
            ablaUnsafePointerOffset(entryPointer, 4), int(index)
        )
    }
    result
}

@export("xt_set_exception_handler")
trusted fun ownedXtensaSetExceptionHandler(
    number: i32,
    handler: u32
): u32 {
    if (!esp32DispatcherSupportsExceptionNumber(number)) return u32(0)
    val core = cpuCoreId()
    val entry = esp32ExceptionDispatcherEntry(
        esp32ExceptionDispatcherIndex(number, core)
    )
    val defaultHandler = nativeXtensaUnhandledExceptionAddress()
    val old = esp32DispatcherLoad(entry)
    esp32DispatcherStore(
        entry,
        if (handler == u32(0)) defaultHandler else handler
    )
    if (old == defaultHandler) u32(0) else old
}
