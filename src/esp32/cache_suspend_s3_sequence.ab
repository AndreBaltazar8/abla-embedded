// Cache freeze (MSPI timing) and cache suspend (sleep) are distinct operations.
// Preserve both ROM autoload-state words exactly; all64bits/zero are valid.
// Caller owns caches, parks other core, masks interrupts and supplies retained
// internal code/data/stack. No nesting or copied-token restoration permitted.
type Esp32S3CacheSuspendState = int
@section(".iram1.abla.s3CacheSuspendIdle")
trusted fun esp32S3CacheSuspendWaitIdle(instruction: bool): void {
    // ROM WAITI erratum workaround; do not return while cache is still active.
    while (((esp32S3CacheSuspendRead(0x600C4130)>>>(if (instruction) 0 else 12)) & 4095) != 1) {}
    return
}
@section(".iram1.abla.s3CachesSuspend")
trusted fun esp32S3CachesSuspendOwned(): Esp32S3CacheSuspendState {
    val instruction=esp32S3CacheRomSuspend(true) & 0xFFFFFFFF
    esp32S3CacheSuspendWaitIdle(true)
    val data=esp32S3CacheRomSuspend(false) & 0xFFFFFFFF
    esp32S3CacheSuspendWaitIdle(false)
    Esp32S3CacheSuspendState(instruction | (data<<32))
}
@section(".iram1.abla.s3CachesResume")
trusted fun esp32S3CachesResumeOwned(saved: Esp32S3CacheSuspendState): void {
    esp32S3CacheRomResume(true,(saved | 0) & 0xFFFFFFFF)
    esp32S3CacheRomResume(false,((saved | 0)>>>32) & 0xFFFFFFFF)
    return
}
