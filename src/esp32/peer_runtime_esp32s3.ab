import "./peer_runtime_s3_sequence.ab"
import "./peer_binding_esp32s3.ab"
import "./scheduler_irq_esp32s3.ab"
import "../hal/esp32.ab"
import "abla/unsafe/mmio"
@inline
@export("esp32S3PeerRuntimeConfig")
trusted fun esp32S3PeerRuntimeConfigHook(): int = esp32S3IrqConfigAddress()
@inline
@export("esp32S3PeerRuntimeRead")
trusted fun esp32S3PeerRuntimeReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3PeerRuntimeDirectAddress")
trusted fun esp32S3PeerRuntimeDirectAddressHook(): int = esp32S3IrqRuntimeAddress()
@inline
@export("esp32S3PeerRuntimeSchedulerAddress")
trusted fun esp32S3PeerRuntimeSchedulerAddressHook(): int = esp32S3SchedulerIrqAddress()
