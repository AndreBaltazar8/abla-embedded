import "./peer_runtime_s3_sequence.ab"
import "./peer_binding_esp32s3.ab"
import "./scheduler_irq_esp32s3.ab"
@inline
trusted fun esp32S3PeerRuntimeConfig(): int = esp32S3IrqConfigAddress()
@inline
trusted fun esp32S3PeerRuntimeRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3PeerRuntimeDirectAddress(): int = esp32S3IrqRuntimeAddress()
@inline
trusted fun esp32S3PeerRuntimeSchedulerAddress(): int = esp32S3SchedulerIrqAddress()
