import "./cache_freeze_s3_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
@section(".iram1.abla.s3CacheFreezeRead")
trusted fun esp32S3CacheFreezeRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3CacheRomFreeze")
trusted fun esp32S3CacheRomFreeze(instruction: bool): void {
    // CACHE_FREEZE_ACK_BUSY=0; never ACK_ERROR during clock/timing transitions.
    callNativeVoidI32(if (instruction) 0x400018E4 else 0x400018FC,0)
    return
}
@section(".iram1.abla.s3CacheRomUnfreeze")
trusted fun esp32S3CacheRomUnfreeze(instruction: bool): void {
    callNativeVoid0(if (instruction) 0x400018F0 else 0x40001908)
    return
}
