import "abla/unsafe/memory"
import "./runtime/libc_syscalls_esp32.ab"

// ESP-IDF 6's picolibc configuration uses a 64-bit time_t on Xtensa. Read the
// reconstructed gettimeofday result in Abla so both return words remain typed
// and no C ABI alias is needed.
trusted noescape fun time(destination: i64*): int {
    val value = nativeStackAllocate(16)
    nativeAddressClear(value, 16)
    val status = i32(esp32RecoveredGettimeofday(
        u32(value), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0)
    ))
    if (status < 0) return -1
    val low = nativeAddressLoadU32(value, 0)
    val high = nativeAddressLoadU32(value, 4)
    if (!pointerIsNull(destination)) {
        val output = nativePointerAddress(destination)
        nativeAddressStoreU32(output, 0, low)
        nativeAddressStoreU32(output, 4, high)
    }
    int(u64(low) | (u64(high) << u64(32)))
}

@inline
trusted fun unixTimeSeconds(): int = time(nativeNullPointer())
