import "./dsi_clock_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4DsiClockRead(offset: int): u32 = u32(mmioLoadU32(0x500E6000+offset))
trusted fun p4DsiClockWrite(offset: int,value: u32): void { mmioStoreU32(0x500E6000+offset,int(value)); return }
trusted fun esp32P4DsiClockStart(hwVersion: int,cfgSource: int,refSource: int,referenceDiv: int): int =
    esp32P4DsiClockStartOwned(hwVersion,cfgSource,refSource,referenceDiv)
trusted fun esp32P4DsiClockStop(): void { esp32P4DsiClockStopOwned(); return }
