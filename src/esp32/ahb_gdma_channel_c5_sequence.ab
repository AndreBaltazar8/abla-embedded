import "./ahb_gdma_clock_c5_sequence.ab"
// Own selected direction and peripheral trigger, no competing DMA consumer.
// Controller already initialized, roots/windows/PMS pinned, channel reset and
// FIFO drained by caller. No reset/IRQ clear/descriptor publication here.
// Flags: bit0 descriptor burst, TX bit1 auto writeback, bit2 EOF after FIFO pop.
// RX rejects TX flags. Owner checking always enabled, loop/M2M disabled.
// Snapshot CONF0@8,owner40,old peripheral6@41,channel2@47,TX49,valid50.
// status1ready2invalid3clock4busy5write6restored7restore failure.
type C5AhbGdmaChannel=int
fun C5AhbGdmaChannel.status(): int = this&255
fun c5AhbGdmaBurstMode(bytes: int): int = if (bytes == 4) 0 else if (bytes == 16) 1 else if (bytes == 32) 2 else if (bytes == 64) 3 else -1
fun c5AhbGdmaPeripheralValid(peripheral: int): bool = peripheral == 1 || peripheral == 2 || peripheral == 3 || peripheral == 6 || peripheral == 7 || peripheral == 8 || peripheral == 9
trusted fun c5AhbGdmaChannelClocks(): bool = (c5AhbGdmaBusRead()&u32(3)) == u32(1) && (c5AhbGdmaRead(0x64)&u32(9)) == u32(8)
trusted fun c5AhbGdmaChannelParked(channel: int,tx: bool): bool {
    val base=c5AhbGdmaChannelBase(channel,tx)
    if (base < 0) return false
    val events=c5AhbGdmaEventBase(channel,tx)
    return (c5AhbGdmaRead(base)&u32(if (tx) 65 else 33)) == u32(0) &&
        (c5AhbGdmaRead(base+16)&u32(if (tx) 15 else 30)) == u32(if (tx) 8 else 16) &&
        (c5AhbGdmaRead(base+8)&u32(2)) != u32(0) &&
        c5AhbGdmaRead(events) == u32(0) && c5AhbGdmaRead(events+8) == u32(0)
}
trusted fun c5AhbGdmaField(at: int,mask: u32,value: u32): bool {
    val before=c5AhbGdmaRead(at)
    if ((before&mask) != value) c5AhbGdmaWrite(at,(before&~mask)|value)
    return (c5AhbGdmaRead(at)&mask) == value
}
trusted fun c5AhbGdmaChannelOpenOwned(channel: int,tx: bool,peripheral: int,burstBytes: int,flags: int,exclusive: bool): C5AhbGdmaChannel {
    val mode=c5AhbGdmaBurstMode(burstBytes)
    if (!exclusive || channel < 0 || channel > 2 || !c5AhbGdmaPeripheralValid(peripheral) || mode < 0 || flags < 0 || flags > (if (tx) 7 else 1)) return C5AhbGdmaChannel(2)
    if (!c5AhbGdmaChannelClocks()) return C5AhbGdmaChannel(3)
    if (!c5AhbGdmaChannelParked(channel,tx)) return C5AhbGdmaChannel(4)
    val base=c5AhbGdmaChannelBase(channel,tx)
    val token=(1<<50)|(if (tx) 1<<49 else 0)|(channel<<47)|(int(c5AhbGdmaRead(base))<<8)|
        (int((c5AhbGdmaRead(base+4)>>u32(12))&u32(1))<<40)|(int(c5AhbGdmaRead(base+48)&u32(63))<<41)
    val mask=u32(if (tx) 0x31e else 0xd6)
    val value=u32(if (tx) (mode<<8)|((flags&1)<<4)|((flags&2)<<1)|((flags&4)<<1) else (mode<<6)|((flags&1)<<2))
    if (!c5AhbGdmaField(base,mask,value) || !c5AhbGdmaField(base+4,u32(4096),u32(4096)) ||
        !c5AhbGdmaField(base+48,u32(63),u32(peripheral))) return C5AhbGdmaChannel(token|5)
    return C5AhbGdmaChannel(token|1)
}
trusted fun C5AhbGdmaChannel.closeOwned(exclusive: bool): C5AhbGdmaChannel {
    if (!exclusive || this < 0 || (this&~0x7ffffffffffff) != 0 || (this&(1<<50)) == 0 || (this.status() != 1 && this.status() != 5 && this.status() != 7)) return this
    val token=this&~255
    val channel=(token>>>47)&3;val tx=(token&(1<<49)) != 0
    if (!c5AhbGdmaChannelClocks() || !c5AhbGdmaChannelParked(channel,tx)) return C5AhbGdmaChannel(token|7)
    val base=c5AhbGdmaChannelBase(channel,tx)
    val mask=u32(if (tx) 0x31e else 0xd6)
    if (!c5AhbGdmaField(base+48,u32(63),u32((token>>>41)&63)) ||
        !c5AhbGdmaField(base+4,u32(4096),u32((token>>>40)&1)<<u32(12)) ||
        !c5AhbGdmaField(base,mask,u32(token>>>8)&mask)) return C5AhbGdmaChannel(token|7)
    return C5AhbGdmaChannel(token|6)
}
