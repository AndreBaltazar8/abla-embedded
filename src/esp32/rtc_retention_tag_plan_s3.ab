// Geometry from ROM Cache_Get_Mode, not logical heap/cache partition sizes.
// In particular the logical16KB D-cache uses a32KB hardware mode.
type Esp32S3TagPlan = int
@inline
fun Esp32S3TagPlan.valid(): bool {
    if ((this & (1<<29)) == 0 || (this & ~0x1FFFFFFFFFF) != 0) return false
    val data=this.dataCache()
    val size=this.sizeBlocks()
    // Zero encodes the full hardware counter span (256 I / 512 D).
    if (size != 0 && size != 128 && !(data && size == 256)) return false
    val span=if (size == 0) (if (data) 512 else 256) else size
    val count=this.validBlocks()
    if (this.start() >= span || count >= (if (data) 512 else 256) || count > span) return false
    if (!this.enabled() && (count != 0 || this.logical16K())) return false
    if (this.enabled() && count == 0 && size != 0) return false
    if (this.logical16K() && (!data || count != size)) return false
    // Four 96-bit tag entries per allocation group. Do not trust the packed
    // allocation independently of the actual hardware transfer count.
    val blocks=((if (count != 0) count else span)+3) & -4
    ((this>>>30) & 1023) == blocks
}
@inline
fun Esp32S3TagPlan.start(): int = this & 511
@inline
fun Esp32S3TagPlan.validBlocks(): int = (this>>>9) & 511
@inline
fun Esp32S3TagPlan.sizeBlocks(): int = (this>>>18) & 511
@inline
fun Esp32S3TagPlan.enabled(): bool = (this & (1<<27)) != 0
@inline
fun Esp32S3TagPlan.dataCache(): bool = (this & (1<<28)) != 0
@inline
fun Esp32S3TagPlan.logical16K(): bool = (this & (1<<40)) != 0
@inline
fun Esp32S3TagPlan.bufferBytes(): int = ((this>>>30) & 1023)*12

// Mirrors sleep_cpu.c cache_tagmem_retention_setup, with checked geometry
// and widened segment alignment. No allocation or runtime division helpers.
@section(".iram1.abla.s3TagPlan")
fun esp32S3TagPlan(data: bool,cacheBytes: int,ways: int,lineBytes: int,segmentAddress: int,segmentBytes: int,logical16K: bool): Esp32S3TagPlan {
    if (ways != 4 && ways != 8) return Esp32S3TagPlan(0)
    if (lineBytes != 16 && lineBytes != 32 && lineBytes != 64) return Esp32S3TagPlan(0)
    if (data) {
        if (cacheBytes != 32768 && cacheBytes != 65536) return Esp32S3TagPlan(0)
        if ((cacheBytes == 65536 && lineBytes == 16) || (logical16K && cacheBytes != 32768)) return Esp32S3TagPlan(0)
    } else {
        if (cacheBytes != 16384 && cacheBytes != 32768) return Esp32S3TagPlan(0)
        if (logical16K || lineBytes == 64 || (cacheBytes == 32768 && lineBytes == 16)) return Esp32S3TagPlan(0)
    }
    if (segmentAddress < 0 || segmentAddress > 0xFFFFFFFF || segmentBytes < 0 || segmentBytes > 0x100000000-segmentAddress) return Esp32S3TagPlan(0)
    val wayShift=if (ways == 4) 2 else 3
    val lineShift=if (lineBytes == 16) 4 else if (lineBytes == 32) 5 else 6
    val sets=cacheBytes>>>(wayShift+lineShift)
    val groups=ways>>>2
    val index=(segmentAddress>>>lineShift) & (sets-1)
    val limit=if (data) 511 else 255
    val size=(sets*groups) & limit
    val aligned=(segmentBytes+lineBytes-1) & (0-lineBytes)
    var valid=size
    if (!(data && logical16K) && aligned < (cacheBytes>>>wayShift)) valid=(aligned>>>lineShift)*groups
    val enabled=aligned != 0 || (data && logical16K)
    val blocks=((if (valid != 0) valid else sets*groups)+3) & -4
    Esp32S3TagPlan(index | (valid<<9) | (size<<18) | ((if (enabled) 1 else 0)<<27) | ((if (data) 1 else 0)<<28) | (1<<29) | (blocks<<30) | ((if (logical16K) 1 else 0)<<40))
}
