import "./cache_suspend_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@inline
@export("esp32S3CacheSuspendRead")
trusted fun esp32S3CacheSuspendReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3CacheRomSuspend")
trusted fun esp32S3CacheRomSuspendHook(instruction: bool): int =
    callNativeU32Zero(if (instruction) 0x4000189C else 0x400018B4)
@inline
@export("esp32S3CacheRomResume")
trusted fun esp32S3CacheRomResumeHook(instruction: bool,state: int): void {
    callNativeVoidI32(if (instruction) 0x400018A8 else 0x400018C0,state)
    return
}
