import "./cache_suspend_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/unsafe/mmio"
@inline
trusted fun esp32S3CacheSuspendRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3CacheRomSuspend(instruction: bool): int =
    callNativeU32Zero(if (instruction) 0x4000189C else 0x400018B4)
@inline
trusted fun esp32S3CacheRomResume(instruction: bool,state: int): void {
    callNativeVoidI32(if (instruction) 0x400018A8 else 0x400018C0,state)
    return
}
