import "abla/unsafe/native"
// Single-core internal-RAM application entry. Boot environment must provide
// M-mode, usable selected SRAM, no other writer to application memory, and
// (if used) calibrated ROM routines. No PSRAM/cache/PLL/WDT policy here.
// Secondary cores park BEFORE touching the primary stack/BSS. Application
// implements the assembly call boundary abla_p4_application_main():void.
// Installs an aligned CLIC-mode synchronous-fault vector before GP/SP/BSS.
// MIE stays off; this does NOT install MTVT/NMI handling or enable interrupts.
// Early faults park without ROM calls, stack access or watchdog suppression.
// Private32B record: magic0(P4TR committed last),hart4,cause8,pc12,tval16,
// status20,sp24,ra28. This is fault evidence, not a resumable register frame.
trusted noescape extern:"inline-assembly" fun p4InternalEntryAsm(template: string,constraints: string): void
trusted noescape extern:"inline-assembly" fun p4InternalEntryAddressAsm(template: string,constraints: string,root: u32): u32
trusted fun esp32P4EarlyFaultRecordAddress(): int = int(p4InternalEntryAddressAsm(
    ".option push\n.option norelax\nla $0, abla_p4_early_fault_record\n.option pop",
    "=r,i,~{memory}",u32(nativeFunctionAddress(p4InternalApplicationEntry))))
@export("abla_p4_application_entry")
@naked
@section(".iram1.abla.p4ApplicationEntry")
trusted fun p4InternalApplicationEntry(): void = p4InternalEntryAsm(
    ".option push\n.option norelax\n.option norvc\ncsrci mstatus, 8\ncsrr t0, mhartid\nbnez t0, 3f\nla t0, abla_p4_early_fault_entry\nori t0, t0, 3\ncsrw mtvec, t0\ncsrr t1, mtvec\nbne t0, t1, 3f\nla gp, __abla_gp\nla sp, __abla_stack_top\nla t0, __abla_bss_start\nla t1, __abla_bss_end\n1:\nbgeu t0, t1, 2f\nsw zero, 0(t0)\naddi t0, t0, 4\nj 1b\n2:\ncall abla_p4_application_main\n3:\ncsrci mstatus, 8\nwfi\nj 3b\n.balign 64\n.local abla_p4_early_fault_entry\nabla_p4_early_fault_entry:\ncsrci mstatus, 8\nla t0, abla_p4_early_fault_record\nsw zero, 0(t0)\ncsrr t1, mhartid\nsw t1, 4(t0)\ncsrr t1, mcause\nsw t1, 8(t0)\ncsrr t1, mepc\nsw t1, 12(t0)\ncsrr t1, mtval\nsw t1, 16(t0)\ncsrr t1, mstatus\nsw t1, 20(t0)\nsw sp, 24(t0)\nsw ra, 28(t0)\nfence rw, rw\nli t1, 0x50345452\nsw t1, 0(t0)\nfence rw, rw\n4:\nwfi\nj 4b\n.option pop\n.pushsection .dram1.abla.p4EarlyFault,\"aw\",@progbits\n.balign 4\n.local abla_p4_early_fault_record\nabla_p4_early_fault_record:\n.zero 32\n.popsection",
    "~{memory}")
