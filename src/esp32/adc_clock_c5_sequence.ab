// ESP-IDF6.0.2 C5 adc_ll.h and PCR/APB_SARADC register definitions.
// Caller owns the entire ADC/TSENS register complex, excludes IRQ/ETM/DMA,
// PHY/LP users, sleep/reset/PCR writers, and has stopped all prior work.
// Source0XTAL/1RC_FAST/2PLL80 is already selected, stable and pinned.
// Does NOT configure clock rate, analog power, trim, pads or start sampling.
// status0closed1ready2invalid3reset/source4bus-write5busy6function-write.
// flags256bus/512function retain attempted ownership across failed writes.
type C5AdcClockOwner=int
fun C5AdcClockOwner.status(): int = this&255
fun C5AdcClockOwner.ready(): bool = this.status() == 1
trusted fun c5AdcClockField(offset: int,mask: u32,value: u32): bool {
    c5AdcClockWrite(offset,(c5AdcClockRead(offset)&~mask)|value)
    return (c5AdcClockRead(offset)&mask) == value
}
// Necessary register checks, not proof that analog/LP/TSENS work has settled.
// CTRL bit29 selects PWDET as the shared SAR power-control source; upstream
// enables it at SAR initialization. It is NOT a conversion/busy indicator.
trusted fun c5AdcAllStopped(): bool =
    (c5AdcRead(0)&u32(0x00800002)) == u32(0) &&
    (c5AdcRead(4)&u32(0x1000000)) == u32(0) &&
    (c5AdcRead(0x20)&u32(0xe0000000)) == u32(0) &&
    (c5AdcRead(0x3c)&u32(0xc8000000)) == u32(0) &&
    c5AdcRead(0x40) == u32(0) &&
    (c5AdcRead(0x50)&u32(0xc0000000)) == u32(0)
trusted fun c5AdcClocksReady(): bool =
    (c5AdcClockRead(0)&u32(14)) == u32(4) &&
    (c5AdcClockRead(4)&u32(0x400000)) != u32(0) &&
    ((c5AdcClockRead(4)>>u32(20))&u32(3)) != u32(3)
trusted fun c5AdcClockOpenOwned(source: int,exclusiveStopped: bool): C5AdcClockOwner {
    if (!exclusiveStopped || source < 0 || source > 2) return C5AdcClockOwner(2)
    val bus=c5AdcClockRead(0)
    val functional=c5AdcClockRead(4)
    if ((bus&u32(10)) != u32(0) || int((functional>>u32(20))&u32(3)) != source) return C5AdcClockOwner(3)
    var flags=0
    if ((bus&u32(4)) == u32(0)) {
        flags=256
        if (!c5AdcClockField(0,u32(4),u32(4))) return C5AdcClockOwner(flags|4)
    }
    if (!c5AdcAllStopped()) return C5AdcClockOwner(flags|5)
    if ((functional&u32(0x400000)) == u32(0)) {
        flags=flags|512
        if (!c5AdcClockField(4,u32(0x400000),u32(0x400000))) return C5AdcClockOwner(flags|6)
    }
    return C5AdcClockOwner(flags|1)
}
// Stop/settle all children before close. No reset, event clear or cancellation.
trusted fun C5AdcClockOwner.closeOwned(exclusiveStopped: bool): C5AdcClockOwner {
    if (!exclusiveStopped || this < 0 || (this&~1023) != 0 || this.status() > 6 || this.status() == 0) return this
    var flags=this&768
    val bus=c5AdcClockRead(0)
    if ((bus&u32(10)) != u32(0)) return C5AdcClockOwner(flags|5)
    if ((bus&u32(4)) != u32(0)) {
        if (!c5AdcAllStopped()) return C5AdcClockOwner(flags|5)
    } else if ((flags&512) != 0 || this.ready()) return C5AdcClockOwner(flags|5)
    if ((flags&512) != 0) {
        if (!c5AdcClockField(4,u32(0x400000),u32(0))) return C5AdcClockOwner(flags|6)
        flags=flags&~512
    }
    if ((flags&256) != 0 && !c5AdcClockField(0,u32(4),u32(0))) return C5AdcClockOwner(flags|4)
    return C5AdcClockOwner(0)
}
