// ESP32-S3 RTC ADC1, based on ESP-IDF v6.0.2 adc_ll.h/sens_reg.h.
// Caller owns ADC1/pad and pins prepared power, trim, attenuation, clock and
// settling; excludes ULP/DMA/reconfiguration for the entire transaction.
// This primitive does not acquire those resources. No ADC2/arbiter accesses.
// Status low8:1success2invalid3foreign/config4busy5readback6pending7badraw.
// Start bit8 means writes attempted. Retain ownership after partial failure;
// finish/release may be retried, never restart a pending conversion.
trusted fun esp32S3Adc1Prepared(): bool {
    // S3 DATA_INVERT_DEFAULT is zero; classic ESP32's default is one.
    return (esp32S3Adc1Read(0)&0x10000000) == 0 &&
        (esp32S3Adc1Read(16)&0x80000000) == 0 &&
        (esp32S3Adc1Read(12)&0x80040000) == 0x80040000
}
trusted fun esp32S3Adc1StartOwned(channel: int,polls: int): int {
    if (channel < 0 || channel > 9 || polls < 1 || polls > 1000000) return 2
    if (!esp32S3Adc1Prepared()) return 3
    val before=esp32S3Adc1Read(12)
    val pads=(1<<channel)<<19
    if ((before&0x7ff80000) != 0 && (before&0x7ff80000) != pads) return 3
    if ((before&0x30000) == 0x20000) return 4
    var remaining=polls
    while ((esp32S3Adc1Read(64)&0x3fc00000) != 0) {
        remaining=remaining-1
        if (remaining == 0) return 4
    }
    val selected=0x80040000|pads
    esp32S3Adc1Write(12,selected)
    if ((esp32S3Adc1Read(12)&0xfffe0000) != selected) return 261
    esp32S3Adc1Write(12,selected|0x20000)
    return if ((esp32S3Adc1Read(12)&0xfffe0000) == (selected|0x20000)) 257 else 261
}
trusted fun esp32S3Adc1FinishOwned(channel: int,polls: int): int {
    if (channel < 0 || channel > 9 || polls < 1 || polls > 1000000) return 2
    if (!esp32S3Adc1Prepared()) return 3
    val selected=0x80060000|((1<<channel)<<19)
    var remaining=polls
    while (remaining > 0) {
        val sample=esp32S3Adc1Read(12)
        if ((sample&0xfffe0000) != selected) return 3
        if ((sample&0x10000) != 0 && (esp32S3Adc1Read(64)&0x3fc00000) == 0) {
            val raw=sample&65535
            return if (raw > 4095) 7 else (raw<<8)|1
        }
        remaining=remaining-1
    }
    return 6
}
// Join before detaching; no cancellation, power gating or digital pad restore.
trusted fun esp32S3Adc1ReleaseOwned(channel: int,polls: int): int {
    if (channel < 0 || channel > 9 || polls < 1 || polls > 1000000) return 2
    val selected=(1<<channel)<<19
    var remaining=polls
    while (remaining > 0) {
        if ((esp32S3Adc1Read(16)&0x80000000) != 0) return 3
        val sample=esp32S3Adc1Read(12)
        val pads=sample&0x7ff80000
        if ((sample&0x80040000) != 0x80040000 || (pads != 0 && pads != selected)) return 3
        if ((sample&0x30000) != 0x20000 && (esp32S3Adc1Read(64)&0x3fc00000) == 0) {
            esp32S3Adc1Write(12,0x80040000)
            return if ((esp32S3Adc1Read(12)&0xfffe0000) == 0x80040000) 1 else 5
        }
        remaining=remaining-1
    }
    return 6
}
