import "./uart/serial_c5_sequence.ab"
import "abla/unsafe/mmio"
import "abla/runtime/scalar"
import "../hal/esp32.ab"
// C5 HP UART0/1 only, IDF reg_base.h/soc.h. No LP/USB console alias.
@export("c5SerialRead")
trusted fun c5SerialReadHook(unit: int,offset: int): int = mmioLoadU32(0x60000000+unit*4096+offset)
@export("c5SerialWriteFifo")
trusted fun c5SerialWriteFifoHook(unit: int,value: int): void { mmioStoreU32(0x60000000+unit*4096,value);return }
