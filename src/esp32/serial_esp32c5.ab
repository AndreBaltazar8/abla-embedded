import "./uart/serial_c5_sequence.ab"
import "abla/unsafe/mmio"
import "abla/runtime/scalar"
// C5 HP UART0/1 only, IDF reg_base.h/soc.h. No LP/USB console alias.
trusted fun c5SerialRead(unit: int,offset: int): int = mmioLoadU32(0x60000000+unit*4096+offset)
trusted fun c5SerialWriteFifo(unit: int,value: int): void { mmioStoreU32(0x60000000+unit*4096,value);return }
