// Descriptor layout shared by the classic ESP32 peripheral DMA engines.
// A descriptor is three consecutive 32-bit words: flags, buffer, and next.
val espDmaDescriptorBytes = 12
val espDmaDescriptorSizeMask = 4095
val espDmaDescriptorLengthMask = 16773120
val espDmaDescriptorSuccessfulEofMask = 1073741824
val espDmaDescriptorOwnerMask = 2147483648

@inline
fun espDmaMemoryAddressValid(address: int, allowNull: bool): bool =
    address >= (if (allowNull) 0 else 1) && address <= 4294967295

fun espDmaDescriptorPackFlags(
    capacity: int,
    length: int,
    successfulEof: bool,
    ownedByDma: bool
): int {
    if (capacity < 0 || capacity > 4095 ||
        length < 0 || length > 4095) return -1
    capacity | (length << 12) |
        (if (successfulEof) espDmaDescriptorSuccessfulEofMask else 0) |
        (if (ownedByDma) espDmaDescriptorOwnerMask else 0)
}

@inline
fun espDmaDescriptorCapacity(flags: int): int =
    flags & espDmaDescriptorSizeMask

@inline
fun espDmaDescriptorLength(flags: int): int =
    (flags & espDmaDescriptorLengthMask) >>> 12

@inline
fun espDmaDescriptorSuccessfulEof(flags: int): bool =
    (flags & espDmaDescriptorSuccessfulEofMask) != 0

@inline
fun espDmaDescriptorOwnedByDma(flags: int): bool =
    (flags & espDmaDescriptorOwnerMask) != 0
