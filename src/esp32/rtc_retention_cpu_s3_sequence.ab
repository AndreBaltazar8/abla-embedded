import "./sdk/raw_buffer.ab"
// CPU-only half of IDF rtc_cntl_hal retention. Caller owns RTC/SYSCON,
// initialized retained internal DMA storage, quiescent peers and caches.
// dcacheRetained means a separately configured tag retention transaction;
// it is mandatory with the S3 16KB D-cache configuration. No tag allocation
// or tag enabling is implied here. Execute with internal code/data/stack.
@inline
trusted fun esp32S3RetentionUpdate(address: int,mask: int,value: int): void {
    esp32S3RetentionWrite(address,(esp32S3RetentionRead(address) & (0xFFFFFFFF ^ mask)) | (value & mask))
    return
}
@section(".iram1.abla.s3CpuRetentionEnable")
trusted fun esp32S3CpuRetentionEnableOwned(storage: NativeBuffer,dcacheRetained: bool,dcache16K: bool): bool {
    if (!storage.hasAddressRange(0,8800) || (storage.addressValue() & 15) != 0) return false
    if (dcache16K && !dcacheRetained) return false
    if ((esp32S3RetentionRead(0x60008140) & 0x01000000) != 0) return false
    val base=storage.addressValue()
    // Refresh configuration overwritten by the previous retention transfer.
    esp32S3RetentionWrite(base+16,0)
    esp32S3RetentionWrite(base+20,0)
    esp32S3RetentionWrite(base+24,0)
    esp32S3RetentionWrite(base+28,0xFFFE0000)
    // Hardware stores the low27 address bits, not a shifted descriptor index.
    esp32S3RetentionUpdate(0x600260B4,0x07FFFFFF,base)
    esp32S3RetentionUpdate(0x60008140,0xFE000000,127<<25)
    esp32S3RetentionUpdate(0x60008140,0x00F00000,15<<20)
    esp32S3RetentionUpdate(0x60008140,0x000E0000,7<<17)
    esp32S3RetentionUpdate(0x60008074,1024,1024)
    esp32S3RetentionUpdate(0x60008140,0x4000,0x4000)
    esp32S3RetentionUpdate(0x60008140,0x01000000,0x01000000)
    if (!dcacheRetained) esp32S3RetentionCacheOperation(0)
    true
}
// Call after wake with the SAME tag configuration as enable. Invalidation
// precedes disabling retention, matching the ROM/HAL wake protocol. Caller
// must not touch dirty external RAM between writeback and this invalidation.
@section(".iram1.abla.s3CpuRetentionDisable")
trusted fun esp32S3CpuRetentionDisableOwned(icacheRetained: bool,dcacheRetained: bool): bool {
    if ((esp32S3RetentionRead(0x60008140) & 0x01000000) == 0) return false
    if (!icacheRetained) esp32S3RetentionCacheOperation(1)
    if (!dcacheRetained) esp32S3RetentionCacheOperation(2)
    esp32S3RetentionUpdate(0x60008140,0x01000000,0)
    // Shared 20MHz clock and target selection intentionally remain intact.
    true
}
