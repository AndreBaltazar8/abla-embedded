import "./ahb_gdma_channel_c5_sequence.ab"
// Own direction/trigger/ISR/ETM, stop peripheral requests first and pin clocks.
// STOP token status8,channel2@8,TX10,lease11. 1parked2invalid3clock
// 4reset/ETM/IRQ-owned5pending. PARK joins only the descriptor FSM, not FIFO,
// peripheral completion, cache visibility or descriptor ownership.
type C5AhbGdmaStop=int
fun C5AhbGdmaStop.status(): int = this&255
trusted fun c5AhbGdmaControlAdmitted(channel: int,tx: bool): bool {
    val base=c5AhbGdmaChannelBase(channel,tx)
    return (c5AhbGdmaRead(base)&u32(if (tx) 65 else 33)) == u32(0) && c5AhbGdmaRead(c5AhbGdmaEventBase(channel,tx)+8) == u32(0)
}
trusted fun C5AhbGdmaStop.waitOwned(polls: int,exclusive: bool): C5AhbGdmaStop {
    if (!exclusive || polls < 1 || polls > 1000000 || this < 0 || (this&~4095) != 0 || (this&2048) == 0 || ((this>>>8)&3) > 2) return this
    val token=this&~255
    val channel=(token>>>8)&3;val tx=(token&1024) != 0
    if (!c5AhbGdmaChannelClocks()) return C5AhbGdmaStop(token|3)
    if (!c5AhbGdmaControlAdmitted(channel,tx)) return C5AhbGdmaStop(token|4)
    val at=c5AhbGdmaChannelBase(channel,tx)+16
    var remaining=polls
    while (remaining > 0) {
        if ((c5AhbGdmaRead(at)&u32(if (tx) 15 else 30)) == u32(if (tx) 8 else 16)) return C5AhbGdmaStop(token|1)
        remaining=remaining-1
    }
    return C5AhbGdmaStop(token|5)
}
trusted fun c5AhbGdmaStopBeginOwned(channel: int,tx: bool,polls: int,exclusive: bool): C5AhbGdmaStop {
    if (!exclusive || channel < 0 || channel > 2 || polls < 1 || polls > 1000000) return C5AhbGdmaStop(2)
    if (!c5AhbGdmaChannelClocks()) return C5AhbGdmaStop(3)
    if (!c5AhbGdmaControlAdmitted(channel,tx)) return C5AhbGdmaStop(4)
    val token=C5AhbGdmaStop(2048|(channel<<8)|(if (tx) 1024 else 0)|5)
    val at=c5AhbGdmaChannelBase(channel,tx)+16
    val link=c5AhbGdmaRead(at)
    if ((link&u32(if (tx) 15 else 30)) != u32(if (tx) 8 else 16)) {
        // Do not replay observed START/RESTART. Preserve RX AUTO_RET.
        c5AhbGdmaWrite(at,(link&~u32(if (tx) 7 else 14))|u32(if (tx) 1 else 2))
    }
    return token.waitOwned(polls,true)
}
// Destructive FIFO/FSM initialization only after PARK and event handling.
// Explicit discard authorization. releaseOnly lowers a previously stuck reset
// without another pulse; it does NOT assert that initialization succeeded.
// Returns1submitted/released2invalid3clock4busy/events5readback failure.
trusted fun c5AhbGdmaResetOwned(channel: int,tx: bool,exclusive: bool,discard: bool,releaseOnly: bool): int {
    if (!exclusive || channel < 0 || channel > 2 || (!releaseOnly && !discard)) return 2
    if (!c5AhbGdmaChannelClocks()) return 3
    val base=c5AhbGdmaChannelBase(channel,tx)
    val before=c5AhbGdmaRead(base)
    val events=c5AhbGdmaEventBase(channel,tx)
    if ((before&u32(if (tx) 64 else 32)) != u32(0) || c5AhbGdmaRead(events+8) != u32(0) ||
        (!releaseOnly && ((before&u32(1)) != u32(0) || c5AhbGdmaRead(events) != u32(0) ||
        (c5AhbGdmaRead(base+16)&u32(if (tx) 15 else 30)) != u32(if (tx) 8 else 16)))) return 4
    // Caller retains the same exclusive stopped lifetime for releaseOnly.
    // WT reset may self-clear, so high readback is not a completion proof.
    if (!releaseOnly) c5AhbGdmaWrite(base,before|u32(1))
    c5AhbGdmaWrite(base,c5AhbGdmaRead(base)&~u32(1))
    return if (c5AhbGdmaRead(base) == (before&~u32(1))) 1 else 5
}
