import "./sdk/raw_buffer.ab"

// Bounded single-block transmission. Caller owns a stopped TX channel and
// its SRAM, configured active group clock, powered nonFIFO memory and routed
// output pad. Include protocol reset/latch timing in source symbols.
// Status1 completion,2 arguments,3 configuration,4 load,5 clear,6 start,
// 7 hardware error,8 timeout. Bits8..11 retain events; bit12 stop requested,
// bit13 stop request failed. Errors NEVER authorize storage/clock reclamation.
// A poll budget is register reads, not elapsed microseconds. No IRQs or heap.
trusted fun esp32s3RmtTransmitFrameOwned(channel: int, divider: int,
    source: NativeBuffer, symbols: int, polls: int): int {
    if (channel < 0 || channel > 3 || divider < 1 || divider > 256 ||
        symbols < 1 || symbols > 47 || polls < 1 || polls > 1000000 ||
        !source.hasAddressRange(0, symbols * 4)) return 2
    if (!esp32s3RmtConfigureSingleBlockTxOwned(channel, divider)) return 3
    esp32s3RmtTransmitPreparedFrameOwned(channel, source, symbols, polls)
}

// Internal continuation: caller already validated channel/polls and configured
// the stopped single-block channel. Allows pad routing between configuration
// and START without repeating pointer resets or MMIO configuration writes.
trusted fun esp32s3RmtTransmitPreparedFrameOwned(channel: int,
    source: NativeBuffer, symbols: int, polls: int): int {
    if (!esp32s3RmtLoadFrameOwned(channel, source, symbols)) return 4
    if (!esp32s3RmtTxAcknowledge(channel, 15)) return 5
    if (!esp32s3RmtTxRequestOwned(channel, true)) return 6
    var attempt = 0
    var events = 0
    var status = 8
    while (attempt < polls) {
        events = esp32s3RmtTxEvents(channel)
        // Error wins over simultaneous done. Do not erase error evidence.
        if (events < 0 || (events & 2) != 0) { status = 7; break }
        if ((events & 1) != 0) {
            if (!esp32s3RmtTxAcknowledge(channel, events)) return 5 | (events << 8)
            esp32s3RmtPublish()
            return 1 | (events << 8)
        }
        attempt = attempt + 1
    }
    val stopped = esp32s3RmtTxRequestOwned(channel, false)
    status | ((events & 15) << 8) | (if (stopped) 4096 else 8192)
}
