import "./clic_p4_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
// P4 vectors_clic.S: MTVEC exception/non-vectored entry64-byte aligned,
// MTVT64-byte-aligned table of48 HANDLER POINTERS (not jump instructions).
// Caller provides real trap entries preserving architectural context/mret,
// published code/table memory and stable lifetime. No normal Abla function
// may be substituted for a trap entry. This installs addresses, not handlers.
// M-mode,current core only; caller excludes NMI/debug vector writers too.
// 1installed,2invalid,3not quiesced,4unexpected prior CSR,5MTVT readback,
// 6MTVEC readback. On5/6 retain BOTH old and new tables/entry code for recovery.
trusted fun esp32P4ClicInstallVectorsOwned(entry: int,table: NativeBuffer,expectedMtvec: u32,expectedMtvt: u32): int {
    if (entry <= 0 || entry > 4294967232 || (entry&63) != 0 || !table.hasAddressRange(0,192) ||
        (table.addressValue()&63) != 0) return 2
    if ((p4ClicMachineStatus()&u32(8)) != u32(0) || ((p4ClicReadConfig()>>>1)&15) != 3) return 3
    var line=0
    while (line < 48) {
        if ((p4ClicReadByte(p4ClicLineAddress(line)+1)&1) != 0) return 3
        val handler=table.loadU32(line*4)
        if (handler == 0 || (handler&1) != 0) return 2
        line=line+1
    }
    if (p4ClicReadMtvec() != expectedMtvec || p4ClicReadMtvt() != expectedMtvt) return 4
    p4ClicVectorFence()
    p4ClicWriteMtvt(u32(table.addressValue()))
    if (p4ClicReadMtvt() != u32(table.addressValue())) return 5
    p4ClicWriteMtvec(u32(entry)|u32(3))
    if (p4ClicReadMtvec() != (u32(entry)|u32(3))) return 6
    return 1
}
