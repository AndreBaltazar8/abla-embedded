import "./adc_pins_s3_sequence.ab"
import "../hal/esp32.ab"
// ADC2 GPIO11..20; AirQ battery GPIO14 is channel3.
fun esp32S3Adc2Pin(channel: int): int = if (channel < 0 || channel > 9) -1 else channel+11
@export("esp32S3Adc2PadConfigureOwned")
trusted fun esp32S3Adc2PadConfigureOwnedHook(channel: int): int = esp32S3AdcPadConfigureOwned(esp32S3Adc2Pin(channel))
