// Classic ESP32 ADC1 channel mapping/RTC pad fields from IDF v6.0.2.
// Caller owns the physical pad and excludes ADC/ULP/touch/clock/sleep changes.
// Disables output before muxing; never releases holds or disables XTAL32K.
// Remains analog/high-impedance after conversion: no automatic old-output
// restoration. Hardware pin support is not proof that a board pin is free.
fun esp32Adc1Pin(channel: int): int = if (channel < 0 || channel > 7) -1 else if (channel < 4) 36+channel else 28+channel
fun esp32Adc1RtcPad(channel: int): int = if (channel < 4) channel else if (channel == 4) 9 else if (channel == 5) 8 else channel-2
fun esp32Adc1PadOffset(channel: int): int = if (channel < 4) 124 else if (channel < 6) 140 else 128
fun esp32Adc1PadHold(channel: int): int = if (channel < 4) 1<<(31-channel) else if (channel == 4) 1<<24 else if (channel == 5) 1<<29 else 1<<(37-channel)
fun esp32Adc1PadForceHold(channel: int): int = if (channel < 4) 1<<(4+channel) else if (channel < 6) 1<<(12+channel) else 1<<(channel-6)
fun esp32Adc1PadMux(channel: int): int = if (channel < 4) 1<<(27-channel) else if (channel == 4) 1<<17 else if (channel == 5) 1<<18 else 1<<(35-channel)
fun esp32Adc1PadClear(channel: int): int =
    if (channel < 4) (3<<(22-channel*5))|(1<<(21-channel*5))|(1<<(19-channel*5)) else
    if (channel == 4) (3<<9)|(1<<8)|(1<<5)|(3<<22) else
    if (channel == 5) (3<<15)|(1<<14)|(1<<11)|(3<<27) else
    if (channel == 6) (3<<26)|(1<<25)|(1<<23) else (3<<21)|(1<<20)|(1<<18)
// 1configured2invalid3held4crystalactive5write/readback. Partial failure retains
// the pad lease; no ADC start/power operation is performed by this routine.
trusted fun esp32Adc1PadConfigureOwned(channel: int): int {
    val pin=esp32Adc1Pin(channel)
    if (pin < 0) return 2
    val offset=esp32Adc1PadOffset(channel)
    val before=esp32Adc1PadRead(offset)
    if ((before&esp32Adc1PadHold(channel)) != 0 || (esp32Adc1ForceHoldRead()&esp32Adc1PadForceHold(channel)) != 0) return 3
    if ((channel == 4 || channel == 5) && (before&0x80000) != 0) return 4
    if (pin == 32 || pin == 33) {
        esp32Adc1DigitalDisable(1<<(pin-32))
        if ((esp32Adc1DigitalEnableRead()&(1<<(pin-32))) != 0) return 5
    }
    val enable=1<<(esp32Adc1RtcPad(channel)+14)
    esp32Adc1PadWrite(20,enable)
    if ((esp32Adc1PadRead(12)&enable) != 0) return 5
    val mask=esp32Adc1PadClear(channel)|esp32Adc1PadMux(channel)
    esp32Adc1PadWrite(offset,(before&(4294967295^mask))|esp32Adc1PadMux(channel))
    return if ((esp32Adc1PadRead(offset)&mask) == esp32Adc1PadMux(channel)) 1 else 5
}
