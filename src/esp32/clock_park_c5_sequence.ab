import "./cpu_clock_c5_sequence.ab"
import "./sdk/raw_buffer.ab"
import "abla/unsafe/mmio"
//48B retained record: tag,status,stage,originalCPUplan,PVTpolicy,childResult,
// private PVT24@24.1parked2invalid3partial. Caller owns CPU/PVT/clock consumers,
// quiesces UART/DMA/interrupts and guarantees stable XTAL/retained code+stack.
// Captures original plan ONCE, before any shadow write. Retry same record;
// never recapture partially changed clock shadows as the original clock.
// PLL/reference clocks intentionally remain enabled: their shared ownership
// must be released separately only when no remaining consumers need them.
// No pretend rollback after PVT park; wake requires its full restart sequence.
@section(".iram1.abla.c5ParkRecordRead")
trusted fun c5ParkRecordRead(base: int,offset: int): int = mmioLoadU32(base+offset)
@section(".iram1.abla.c5ParkRecordWrite")
trusted fun c5ParkRecordWrite(base: int,offset: int,value: int): void { mmioStoreU32(base+offset,value);return }
@section(".iram1.abla.c5ClockPark")
trusted fun esp32C5ClockParkOwned(record: NativeBuffer,usePvt: bool,exclusive: bool): int {
    if (!exclusive || !record.hasAddressRange(0,48) || (record.addressValue()&3) != 0) return 2
    val base=record.addressValue();val policy=if (usePvt) 1 else 0
    val tag=c5ParkRecordRead(base,0)
    if (tag == 0) {
        val original=esp32C5CpuClockCaptureOwned(true)
        if (!c5CpuClockValid(original)) return 2
        if (usePvt && !c5ClockParkPvtActive()) return 2
        c5ParkRecordWrite(base,12,original|0);c5ParkRecordWrite(base,16,policy)
        c5ParkRecordWrite(base,8,0);c5ParkRecordWrite(base,20,0);c5ParkRecordWrite(base,24,0)
        c5ParkRecordWrite(base,4,3);c5ParkRecordWrite(base,0,0x43504b31)
    } else {
        if (tag != 0x43504b31 || c5ParkRecordRead(base,16) != policy) return 2
        if (c5ParkRecordRead(base,4) == 1) return 1
        if (c5ParkRecordRead(base,4) != 3 || c5ParkRecordRead(base,8) > 1) return 2
    }
    if (c5ParkRecordRead(base,8) == 0) {
        val original=c5ParkRecordRead(base,12)
        val result=esp32C5CpuClockApplyOwned(C5CpuClock(original&0x1fc0000),true)
        c5ParkRecordWrite(base,20,result)
        if (result != 1) return 3
        c5ParkRecordWrite(base,8,1)
    }
    if (usePvt) {
        val result=c5ClockParkPvt(nativeBufferAt(base+24,24))
        c5ParkRecordWrite(base,20,result)
        if (result != 1) return 3
    }
    c5ParkRecordWrite(base,4,1)
    1
}
