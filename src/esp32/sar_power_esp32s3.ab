import "./sar_power_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@inline
@export("esp32S3SarRead")
trusted fun esp32S3SarReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3SarWrite")
trusted fun esp32S3SarWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
