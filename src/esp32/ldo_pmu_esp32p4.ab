import "./ldo_efuse_esp32p4.ab"
import "./ldo_pmu_p4_sequence.ab"
import "./ldo_owner_p4_sequence.ab"
import "abla/unsafe/mmio"
trusted fun p4LdoPmuRead(offset: int): u32 = u32(mmioLoadU32(0x50115000+offset))
trusted fun p4LdoPmuWrite(offset: int,value: u32): void { mmioStoreU32(0x50115000+offset,int(value)); return }
trusted fun esp32P4LdoStart(channel: int,millivolts: int,revision: int): int = esp32P4LdoStartOwned(channel,millivolts,revision)
trusted fun esp32P4LdoStop(channel: int,revision: int): int = esp32P4LdoStopOwned(channel,revision)
