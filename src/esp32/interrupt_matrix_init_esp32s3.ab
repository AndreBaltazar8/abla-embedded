import "./interrupt_matrix_init_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
@inline
trusted fun esp32S3MatrixInitCore(): int = xtensaGuardCore()
@inline
trusted fun esp32S3MatrixInitEnabled(): int = int(xtensaGuardRead("rsr.intenable $0","=a,~{memory}"))
@inline
trusted fun esp32S3MatrixInitRead(address: int): int = mmioLoadU32(address)
@inline
trusted fun esp32S3MatrixInitWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
