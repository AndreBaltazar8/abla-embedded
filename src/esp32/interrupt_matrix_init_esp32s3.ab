import "./interrupt_matrix_init_s3_sequence.ab"
import "../xtensa/interrupt_guard.ab"
import "abla/unsafe/mmio"
import "../hal/xtensa.ab"
import "../hal/esp32.ab"
@inline
@export("esp32S3MatrixInitCore")
trusted fun esp32S3MatrixInitCoreHook(): int = xtensaGuardCore()
@inline
@export("esp32S3MatrixInitEnabled")
trusted fun esp32S3MatrixInitEnabledHook(): int = int(xtensaGuardRead("rsr.intenable $0","=r,~{memory}"))
@inline
@export("esp32S3MatrixInitRead")
trusted fun esp32S3MatrixInitReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3MatrixInitWrite")
trusted fun esp32S3MatrixInitWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
