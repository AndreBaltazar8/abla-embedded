import "./sdk/raw_buffer.ab"
import "abla/unsafe/mmio"
// Called only after the S3 exception entry saved context and spilled windows.
// Syscall0 requests that spill; other syscall numbers return -1 in saved A2.
// Adjust the saved hardware-loop state, not the handler's live loop registers.
// False means not a syscall/invalid frame; no memory changes on that path.
@section(".iram1.abla.s3SyscallFrame")
trusted fun esp32S3SyscallFrameOwned(frame: NativeBuffer): bool {
    if (!frame.hasAddressRange(0,192) || (frame.addressValue() & 15) != 0) return false
    val address=frame.addressValue()
    if (mmioLoadU32(address+80) != 1) return false
    val next=(mmioLoadU32(address+4)+3) & 0xFFFFFFFF
    val count=mmioLoadU32(address+96)
    var resume=next
    if (next == mmioLoadU32(address+92) && count != 0) {
        resume=mmioLoadU32(address+88)
        mmioStoreU32(address+96,count-1)
    }
    if (mmioLoadU32(address+20) != 0) mmioStoreU32(address+20,0xFFFFFFFF)
    mmioStoreU32(address+4,resume)
    true
}
