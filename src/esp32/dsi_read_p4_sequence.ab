import "./dsi_short_p4_sequence.ab"
import "./sdk/raw_buffer.ab"
// Status9 stale RX,10 incompatible configuration,11 receive timeout,
// 12 excess response words. Bit6 records max-return-size command enqueue;
// bit4 records the actual read enqueue. Partial destination is invalid unless
// hostComplete(). Expected length comes from the panel command's protocol:
// the payload FIFO does not expose the valid byte count of a partial word.
// Caller enabled command mode+BTA+matching RX channel; no hidden video switch.
trusted fun esp32P4DsiDcsReadOwned(channel: int,command: int,destination: NativeBuffer,length: int,polls: int): DsiCommandResult {
    if (channel < 0 || channel > 3 || command < 0 || command > 255 || length < 1 || length > 65535 ||
        !destination.hasAddressRange(0,length) || polls < 1 || polls > 1000000) return DsiCommandResult(2)
    if ((p4DsiRead(52)&u32(1)) == u32(0) || (p4DsiRead(44)&u32(4)) == u32(0) ||
        (p4DsiRead(48)&u32(3)) != u32(channel)) return DsiCommandResult(10)
    if (!esp32P4DsiWaitIdleOwned(polls)) return DsiCommandResult(3)
    if ((p4DsiRead(116)&u32(16)) == u32(0)) return DsiCommandResult(9)
    val before=esp32P4DsiErrorSnapshotOwned()
    if (before != 0) return DsiCommandResult(before|4)
    if (esp32P4DsiSubmitHeaderOwned(dsiPacketHeader(channel,55,length&255,length>>>8),polls) != 1) return DsiCommandResult(3)
    if (!esp32P4DsiWaitIdleOwned(polls)) return DsiCommandResult(esp32P4DsiErrorSnapshotOwned()|64|5)
    if (esp32P4DsiSubmitHeaderOwned(dsiPacketHeader(channel,6,command,0),polls) != 1) return DsiCommandResult(64|8)
    if (!esp32P4DsiWaitIdleOwned(polls)) return DsiCommandResult(esp32P4DsiErrorSnapshotOwned()|80|5)
    var offset=0
    while (offset < length) {
        val received=esp32P4DsiReadPayloadOwned(polls)
        if ((received&(1<<32)) == 0) return DsiCommandResult(esp32P4DsiErrorSnapshotOwned()|80|11)
        val word=u32(received&4294967295)
        var byte=0
        while (byte < 4 && offset < length) {
            destination.store(offset,int((word>>u32(byte*8))&u32(255)))
            offset=offset+1; byte=byte+1
        }
    }
    val extra=(p4DsiRead(116)&u32(16)) == u32(0)
    val errors=esp32P4DsiErrorSnapshotOwned()
    DsiCommandResult(errors|80|(if (extra) 12 else if (errors != 0) 6 else 1))
}
