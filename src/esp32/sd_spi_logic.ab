fun sdSpiCommandCrc(command: int): int =
    if (command == 0) 149 else if (command == 8) 135 else 1

fun sdSpiBlockArgument(highCapacity: bool, block: int): int =
    if (highCapacity) block else block * 512

fun sdSpiR1Available(value: int): bool = value >= 0 && (value & 128) == 0
fun sdSpiReadToken(value: int): bool = value == 254
fun sdSpiWriteAccepted(value: int): bool = (value & 31) == 5
