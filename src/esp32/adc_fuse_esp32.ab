import "./adc_fuse_logic.ab"
import "abla/unsafe/mmio"
// Caller guarantees classic ESP32, loaded stable eFuse shadows and register
// access. Reads only three words; does not issue READ/PGM commands or touch keys.
trusted fun esp32AdcReadCalibration(): Esp32AdcCalibration = esp32AdcCalibrationFromWords(
    mmioLoadU32(0x3ff5a00c),mmioLoadU32(0x3ff5a010),mmioLoadU32(0x3ff5a084))
