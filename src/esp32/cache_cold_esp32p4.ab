import "./cache_cold_p4_sequence.ab"
import "./cache_geometry_esp32p4.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
trusted noescape extern:"inline-assembly" fun p4CacheColdAsm(template: string,constraints: string): void
@export("p4CacheColdFence")
trusted fun p4CacheColdFenceHook(): void = p4CacheColdAsm("fence iorw, iorw","~{memory}")
@export("p4CacheColdWrite")
trusted fun p4CacheColdWriteHook(offset: int,value: int): void { mmioStoreU32(0x3ff10000+offset,value); return }
