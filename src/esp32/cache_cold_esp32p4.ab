import "./cache_cold_p4_sequence.ab"
import "./cache_geometry_esp32p4.ab"
import "abla/unsafe/mmio"
trusted noescape extern:"inline-assembly" fun p4CacheColdAsm(template: string,constraints: string): void
trusted fun p4CacheColdFence(): void = p4CacheColdAsm("fence iorw, iorw","~{memory}")
trusted fun p4CacheColdWrite(offset: int,value: int): void { mmioStoreU32(0x3ff10000+offset,value); return }
