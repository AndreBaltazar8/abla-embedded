import "./sdk/raw_buffer.ab"
// Caller exclusively owns this core's CCOMPARE0 (CPU line6, level1 on S3).
// Timer record16: periodCycles0,schedulerContext4,core8,lastDeadline12.
// Initialized by caller before registration; period1024..0x3fffffff cycles.
// This is a coalescing scheduling quantum, NOT a wall clock or elapsed OS tick
// counter. CPU frequency changes alter quantum duration; sleep/CCOUNT reset
// requires explicit rearm. No CCOUNT write, matrix route, or IRQ enable here.
// Record/context stay disjoint and internal; local IRQ masking or callback
// context excludes concurrent timer reprogramming. Debug/NMI excluded.
@section(".iram1.abla.s3SchedulerTick")
trusted fun esp32S3SchedulerTickOwned(record: NativeBuffer): bool {
    if (!record.hasAddressRange(0,16) || (record.addressValue() & 3) != 0 ||
        record.addressValue() < 0x3FC88000 || record.addressValue() > 0x3FCFFFF0) return false
    val base=record.addressValue()
    val period=esp32S3SchedulerTickRead(base)
    val context=esp32S3SchedulerTickRead(base+4)
    if (period < 1024 || period > 0x3FFFFFFF || esp32S3SchedulerTickRead(base+8) != esp32S3SchedulerTickCore() ||
        context < 0x3FC88000 || context > 0x3FCFFFD4 || (context & 3) != 0 ||
        (base < context+44 && context < base+16) || esp32S3SchedulerTickRead(context+40) != esp32S3SchedulerTickCore()) return false
    // Writing CCOMPARE acknowledges its interrupt. Recheck after programming:
    // if delayed past the deadline, retry rather than wait a full32-bit wrap.
    var deadline=0
    var armed=false
    while (!armed) {
        deadline=(esp32S3SchedulerTickCount()+period) & 0xFFFFFFFF
        esp32S3SchedulerTickCompare(deadline)
        val remaining=(deadline-esp32S3SchedulerTickCount()) & 0xFFFFFFFF
        armed=remaining > 0 && remaining < 0x80000000
    }
    esp32S3SchedulerTickWrite(base+12,deadline)
    esp32S3SchedulerTickRequest(nativeBufferAt(context,44))
}
