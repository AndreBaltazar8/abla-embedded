import "./rtc_retention_tag_plan_s3.ab"
import "./sdk/raw_buffer.ab"
@inline
fun esp32S3TagBufferBytes(instruction: Esp32S3TagPlan,data: Esp32S3TagPlan): int {
    if (!instruction.valid() || instruction.dataCache() || !data.valid() || !data.dataCache()) return 0
    instruction.bufferBytes()+data.bufferBytes()+16
}
// Caller-owned retained internal DMA memory. Retention stopped/unpublished.
// Tag blocks pack96bits each, grouped4 to align the128bit RTC DMA bus.
@section(".iram1.abla.s3TagRetentionBuffer")
trusted fun esp32S3TagBufferInitOwned(storage: NativeBuffer,instruction: Esp32S3TagPlan,data: Esp32S3TagPlan): bool {
    val size=esp32S3TagBufferBytes(instruction,data)
    if (size < 32 || size > 65536 || !storage.hasAddressRange(0,size) || (storage.addressValue() & 15) != 0) return false
    val base=storage.addressValue()
    var offset=0
    while (offset < size) {
        esp32S3TagBufferWrite(base+offset,0)
        offset=offset+4
    }
    esp32S3TagBufferWrite(base+4,base+16)
    val blocks=(size-16)>>>4
    esp32S3TagBufferWrite(base,0xC0000000 | blocks | (blocks<<12))
    true
}
