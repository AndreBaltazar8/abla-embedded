import "./dsi_fifo_esp32p4.ab"
import "./dsi_phy_p4_sequence.ab"
trusted fun esp32P4DsiPhyWriteRegister(address: int,value: int): bool =
    esp32P4DsiPhyWriteRegisterOwned(address,value)
trusted fun esp32P4DsiPhyStart(lanes: int): bool = esp32P4DsiPhyStartOwned(lanes)
trusted fun esp32P4DsiPhyWaitReady(lanes: int,polls: int): bool = esp32P4DsiPhyWaitReadyOwned(lanes,polls)
trusted fun esp32P4DsiPhyStop(): void { esp32P4DsiPhyStopOwned(); return }
