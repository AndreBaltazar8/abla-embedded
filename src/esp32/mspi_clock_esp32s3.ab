import "./mspi_clock_s3_sequence.ab"
import "./mspi_clock_state_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/esp32.ab"
@section(".iram1.abla.s3MspiClockRead")
@export("esp32S3MspiClockRead")
trusted fun esp32S3MspiClockReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3MspiClockUpdate")
@export("esp32S3MspiClockUpdate")
trusted fun esp32S3MspiClockUpdateHook(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
@section(".iram1.abla.s3MspiClockWrite")
@export("esp32S3MspiClockWrite")
trusted fun esp32S3MspiClockWriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
