import "./mspi_clock_s3_sequence.ab"
import "./mspi_clock_state_s3_sequence.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.s3MspiClockRead")
trusted fun esp32S3MspiClockRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3MspiClockUpdate")
trusted fun esp32S3MspiClockUpdate(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
@section(".iram1.abla.s3MspiClockWrite")
trusted fun esp32S3MspiClockWrite(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
