import "./mspi_transition_s3_sequence.ab"
import "./mspi_clock_esp32s3.ab"
import "./mspi_din_esp32s3.ab"
import "./mspi_dummy_esp32s3.ab"
import "./cache_freeze_esp32s3.ab"
import "abla/unsafe/mmio"
@section(".iram1.abla.s3MspiStateRead")
trusted fun esp32S3MspiStateRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3MspiStateWrite")
trusted fun esp32S3MspiStateWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
@section(".iram1.abla.s3MspiStateLoad64")
trusted fun esp32S3MspiStateLoad64(address: int): int {
    val low=mmioLoadU32(address)
    low | (mmioLoadU32(address+4)<<32)
}
@section(".iram1.abla.s3MspiStateStore64")
trusted fun esp32S3MspiStateStore64(address: int,value: int): void {
    mmioStoreU32(address,value & 0xFFFFFFFF)
    mmioStoreU32(address+4,value>>>32)
    return
}
