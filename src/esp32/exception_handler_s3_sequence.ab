// Per-core user exception callback lives in reserved IRQ config words24/28.
// Boot-time serialized installation, after IRQ stack registration and before
// VECBASE/user-vector activation. No live replacement or implicit IRQ enable.
// ABI void(u32 frame,u32 cause,u32 core,u32 context). Handler must repair the
// saved frame/hardware or not return; integer-only unless explicitly managing
// coprocessor ownership. Returning without repair retries the faulting PC.
@section(".iram1.abla.s3ExceptionInstall")
trusted fun esp32S3ExceptionHandlerInstallOwned(core: int,callback: int,context: int): bool {
    if (core < 0 || core > 1 || callback < 0x40370000 || callback >= 0x403E0000 ||
        (callback & 3) != 0 || context < 0 || context > 0xFFFFFFFF) return false
    if (esp32S3ExceptionCore() != core || esp32S3ExceptionEnabled() != 0) return false
    val entry=esp32S3ExceptionConfig()+core*32
    if (esp32S3ExceptionRead(entry) == 0 || esp32S3ExceptionRead(entry+4) != 0 ||
        esp32S3ExceptionRead(entry+24) != 0) return false
    esp32S3ExceptionWrite(entry+28,context)
    esp32S3ExceptionWrite(entry+24,callback)
    true
}
// Caller must switch away from this user vector before revoking its handler.
@section(".iram1.abla.s3ExceptionRemove")
trusted fun esp32S3ExceptionHandlerRemoveOwned(core: int,callback: int,context: int): bool {
    if (core < 0 || core > 1 || callback == 0 || esp32S3ExceptionCore() != core || esp32S3ExceptionEnabled() != 0) return false
    val entry=esp32S3ExceptionConfig()+core*32
    if (esp32S3ExceptionRead(entry+4) != 0 || esp32S3ExceptionRead(entry+24) != callback || esp32S3ExceptionRead(entry+28) != context) return false
    esp32S3ExceptionWrite(entry+24,0)
    esp32S3ExceptionWrite(entry+28,0)
    true
}
