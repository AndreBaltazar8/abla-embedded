import "./clock_xtal_s3_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
@section(".iram1.abla.s3ClockRead")
trusted fun esp32S3ClockRead(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3ClockUpdate")
trusted fun esp32S3ClockUpdate(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
@section(".iram1.abla.s3ClockTicks")
trusted fun esp32S3ClockRomTicks(mhz: int): void {
    callNativeVoidI32(0x40001A4C,mhz)
    return
}
@section(".iram1.abla.s3ClockDelay")
trusted fun esp32S3ClockRomDelay(microseconds: int): void {
    callNativeVoidI32(0x40000600,microseconds)
    return
}
@section(".iram1.abla.s3ClockBias")
trusted fun esp32S3ClockBiasWrite(register: int,value: int): void {
    callNativeVoidI32I32I32I32I32I32(0x40005D6C,109,1,register,4,0,value)
    return
}
