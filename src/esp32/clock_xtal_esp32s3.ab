import "./clock_xtal_s3_sequence.ab"
import "abla/unsafe/mmio"
import "abla/unsafe/native"
import "../hal/esp32.ab"
@section(".iram1.abla.s3ClockRead")
@export("esp32S3ClockRead")
trusted fun esp32S3ClockReadHook(address: int): int = mmioLoadU32(address)
@section(".iram1.abla.s3ClockUpdate")
@export("esp32S3ClockUpdate")
trusted fun esp32S3ClockUpdateHook(address: int,mask: int,value: int): void {
    mmioStoreU32(address,(mmioLoadU32(address) & ~mask) | (value & mask))
    return
}
@section(".iram1.abla.s3ClockTicks")
@export("esp32S3ClockRomTicks")
trusted fun esp32S3ClockRomTicksHook(mhz: int): void {
    callNativeVoidI32(0x40001A4C,mhz)
    return
}
@section(".iram1.abla.s3ClockDelay")
@export("esp32S3ClockRomDelay")
trusted fun esp32S3ClockRomDelayHook(microseconds: int): void {
    callNativeVoidI32(0x40000600,microseconds)
    return
}
@section(".iram1.abla.s3ClockBias")
@export("esp32S3ClockBiasWrite")
trusted fun esp32S3ClockBiasWriteHook(register: int,value: int): void {
    callNativeVoidI32I32I32I32I32I32(0x40005D6C,109,1,register,4,0,value)
    return
}
