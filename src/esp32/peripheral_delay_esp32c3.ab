import "./peripheral_delay_rom_sequence.ab"
import "abla/unsafe/native"
// ESP-IDF6 C3 ROM ets_delay_us=40000050. Requires initialized ROM ticks/us
// for the actual CPU clock. No linked implementation or scheduler yield.
trusted fun peripheralRomDelay(microseconds: int): void {
    callNativeVoidI32(0x40000050,microseconds)
    return
}
