import "./fat_volume_create_auto_growing.ab"
// One gate across alias selection, up to two parent-cluster extensions, child
// allocation/dot initialization and final publication. Fixed roots cannot grow.
//3780B workspace plus8B per existing parent cluster. Failures quarantine the
// mount and can leak reservations; no automatic retries or rollback.
trusted fun FatVolume.createDirectoryGrowing(owner: u32,parent: int,name: NativeBuffer,units: int,startAlias: int,
    trials: int,budget: int,modified: RtcDateTime,plan: NativeBuffer,workspace: NativeBuffer): FatFileCreate =
    this.createLongAutoGrowing(owner,parent,name,units,startAlias,trials,budget,modified,plan,workspace,true)
