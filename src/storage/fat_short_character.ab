fun fatShortAsciiCharacter(value: int): bool = value >= 33 && value <= 126 &&
    value != 34 && value != 42 && value != 43 && value != 44 && value != 46 && value != 47 &&
    value != 58 && value != 59 && value != 60 && value != 61 && value != 62 && value != 63 &&
    value != 91 && value != 92 && value != 93 && value != 124
