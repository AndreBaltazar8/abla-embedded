import "./fat_volume.ab"
import "./fat_file_create.ab"
trusted fun FatVolume.createShort(owner: u32,parent: int,name: NativeBuffer,length: int,budget: int,
    modified: RtcDateTime,workspace: NativeBuffer): FatFileCreate {
    val s=this.storage()
    if (fatBuffersOverlap(s,32,workspace,2624) || fatBuffersOverlap(s,32,name,length)) return FatFileCreate(2)
    val admitted=this.begin(owner)
    if (admitted != 0) return FatFileCreate(admitted)
    val result=fatFileCreateShortOwned(nativeBufferAt(s.loadU32(16),28),nativeBufferAt(s.loadU32(20),512),s.loadU32(24),s.loadU32(28),
        parent,name,length,budget,modified,workspace)
    if (result.status() == 4 || result.status() == 8) s.storeU32(12,3)
    if (!peripheralGateAt(s.addressValue()).finish(owner,true)) return FatFileCreate(14)
    return result
}
