import "../esp32/sdk/raw_buffer.ab"
// Caller-owned bitmap for one serialized, immutable-volume integrity scan.
//16B header:magic0,clusterCount4,claimedCount8,firstDuplicate12; then one bit
// per data cluster. FAT cluster2 maps to bit0. No heap or disk mutation.
// This accounts ownership only: the scanner must walk EVERY directory and
// chain, validate FAT values and finally classify unclaimed allocations.
type FatClusterOwnership=int
fun fatClusterOwnershipBytes(clusters: int): int =
    if (clusters < 1 || clusters > 0x0fffffee) 0 else 16+(clusters+7)/8
fun fatClusterOwnershipAt(buffer: NativeBuffer): FatClusterOwnership = FatClusterOwnership(buffer|0)
fun FatClusterOwnership.storage(): NativeBuffer = NativeBuffer(this|0)
trusted fun FatClusterOwnership.valid(): bool {
    val r=this.storage()
    if (!r.hasAddressRange(0,16) || r.loadU32(0) != 0x46434f57) return false
    val bytes=fatClusterOwnershipBytes(r.loadU32(4))
    return bytes != 0 && r.hasAddressRange(0,bytes) && r.loadU32(8) <= r.loadU32(4)
}
trusted fun FatClusterOwnership.initialize(clusters: int): bool {
    val bytes=fatClusterOwnershipBytes(clusters);val r=this.storage()
    if (bytes == 0 || !r.hasAddressRange(0,bytes)) return false
    r.storeU32(0,0)
    var at=16
    while (at < bytes) { r.store(at,0);at=at+1 }
    r.storeU32(4,clusters);r.storeU32(8,0);r.storeU32(12,0);r.storeU32(0,0x46434f57)
    return true
}
//1first owner,2invalid,3duplicate (cross-link or cycle). Duplicate evidence
// is sticky, with no second count. Never reinitialize to hide a scan failure.
trusted fun FatClusterOwnership.claim(cluster: int): int {
    if (!this.valid()) return 2
    val r=this.storage()
    if (cluster < 2 || cluster-2 >= r.loadU32(4)) return 2
    val index=cluster-2;val at=16+index/8
    val mask=int(u32(1)<<u32(index&7));val previous=r.load(at)
    if ((previous&mask) != 0) {
        if (r.loadU32(12) == 0) r.storeU32(12,cluster)
        return 3
    }
    r.store(at,previous|mask);r.storeU32(8,r.loadU32(8)+1);return 1
}
//0unclaimed,1claimed,2invalid. Unclaimed is an orphan only when the FAT
// entry represents allocated data, after a complete successful tree walk.
trusted fun FatClusterOwnership.lookup(cluster: int): int {
    if (!this.valid()) return 2
    val r=this.storage()
    if (cluster < 2 || cluster-2 >= r.loadU32(4)) return 2
    val index=cluster-2
    return if ((r.load(16+index/8)&int(u32(1)<<u32(index&7))) != 0) 1 else 0
}
