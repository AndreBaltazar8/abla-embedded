import "./fat_file_open_path.ab"
import "../text/utf8.ab"
// Strict UTF8, <=16384bytes/4096UTF16units, caller conversion storage plus
//2092B workspace. No replacement characters or allocation. Keep path immutable
// and conversion/work buffers exclusively owned throughout this call.
// First admission protects mount-owned memory during conversion; normal path
// open then reacquires and validates the same generation. No filesystem lookup
// occurs in between; resolution and handle publication still share one gate.
trusted fun fatFileOpenPathUtf8(s: NativeBuffer,owner: u32,path: NativeBuffer,bytes: int,
    converted: NativeBuffer,budget: int,work: NativeBuffer): FatFile {
    if (!s.hasAddressRange(0,80) || (s.addressValue()&7) != 0 || s.loadU32(0) != 0x46464831 ||
        bytes < 1 || bytes > 16384 || budget < 1 || budget > 1000000 || !work.hasAddressRange(0,2092)) return FatFile(2)
    val units=utf8Utf16Units(path,bytes)
    if (units < 1 || units > 4096 || !converted.hasAddressRange(0,units*2) ||
        fatBuffersOverlap(converted,units*2,path,bytes) || fatBuffersOverlap(converted,units*2,s,80) ||
        fatBuffersOverlap(converted,units*2,work,2092) || fatBuffersOverlap(path,bytes,s,80) ||
        fatBuffersOverlap(path,bytes,work,2092) || fatBuffersOverlap(s,80,work,2092)) return FatFile(2)
    val volume=FatVolume(s.loadU32(16)|(s.loadU32(20)<<32));val v=volume.storage()
    if (fatBuffersOverlap(converted,units*2,v,32) || fatBuffersOverlap(path,bytes,v,32) ||
        fatBuffersOverlap(work,2092,v,32)) return FatFile(2)
    val admitted=volume.begin(owner)
    if (admitted != 0) return FatFile(admitted)
    var status=2
    if (s.loadU32(8) != 0) status=12
    else if (s.loadU32(4) >= 16777215) status=13
    else if (!fatBuffersOverlap(converted,units*2,nativeBufferAt(v.loadU32(16),28),28) &&
        !fatBuffersOverlap(converted,units*2,nativeBufferAt(v.loadU32(20),512),512)) {
        if (utf8ToUtf16(path,bytes,converted) == units) status=1
    }
    if (!peripheralGateAt(v.addressValue()).finish(owner,true)) return FatFile(14)
    return if (status == 1) fatFileOpenPathUtf16(s,owner,converted,units,budget,work) else FatFile(status)
}
