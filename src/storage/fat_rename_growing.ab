import "./fat_file_rename.ab"
// Caller provides8B per existing destination cluster. Expand cluster-backed
// directories by up to2 clusters; fixed roots stay bounded. No source-chain
// allocation/free; no crashatomicity, overwrite or case-only rename promise.
trusted fun FatVolume.renameFileGrowing(owner: u32,parent: int,ordinal: int,index: int,expected: NativeBuffer,
    destination: int,name: NativeBuffer,units: int,start: int,trials: int,budget: int,plan: NativeBuffer,work: NativeBuffer): FatRename =
    this.renameFile(owner,parent,ordinal,index,expected,destination,name,units,start,trials,budget,work,false,plan)
trusted fun FatVolume.renameDirectoryGrowing(owner: u32,parent: int,ordinal: int,index: int,expected: NativeBuffer,
    destination: int,name: NativeBuffer,units: int,start: int,trials: int,budget: int,plan: NativeBuffer,work: NativeBuffer): FatRename =
    this.renameFile(owner,parent,ordinal,index,expected,destination,name,units,start,trials,budget,work,true,plan)
