import "./fat_path_utf16.ab"
import "./fat_file_read.ab"
// Resolve a UTF16LE path and read one <=512-byte chunk, stopping at the
// current sector boundary. Return positive bytes,0EOF,-1input,
// -100-lookupStatus or -200-readStatus. Short success is not EOF.
// Each component and final read has its own budget (<=33*budget total).
// Immutable volume/path, exclusive2067-byte workspace and disjoint output.
// Destination stays unchanged on errors/EOF; no filesystem writes.
trusted fun fatReadPathUtf16Owned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,path: NativeBuffer,units: int,offset: int,length: int,budget: int,destination: NativeBuffer,workspace: NativeBuffer): int {
    if (units < 1 || units > 4096 || offset < 0 || offset > 0xFFFFFFFF || length < 1 || length > 512 ||
        !path.hasAddressRange(0,units*2) || !destination.hasAddressRange(0,length) || !workspace.hasAddressRange(0,2067) ||
        fatBuffersOverlap(destination,length,path,units*2) || fatBuffersOverlap(destination,length,workspace,2067) ||
        fatBuffersOverlap(destination,length,reader,28) || fatBuffersOverlap(destination,length,boot,512)) return -1
    val file=fatLookupPathUtf16Owned(reader,boot,first,sectors,path,units,budget,workspace)
    if (!file.isFile()) return -100-file.status()
    val read=fatFileReadAtOwned(reader,boot,first,sectors,file,offset,length,budget,destination,workspace)
    if (read.status() == 2) return 0
    if (read.status() != 1) return -200-read.status()
    read.bytesRead()
}
