import "./fat_path_read_utf16.ab"
import "../text/utf8.ab"
// Same byte-count/errors as UTF16 path read. Caller supplies an additional
// UTF16 buffer (2*utf8Utf16Units bytes); <=4096 units/16384 input bytes.
// All validation/conversion precedes I/O. No replacement characters, hidden
// allocations or normalization. Output destination unchanged on failure.
trusted fun fatReadPathUtf8Owned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,path: NativeBuffer,bytes: int,utf16: NativeBuffer,offset: int,length: int,budget: int,destination: NativeBuffer,workspace: NativeBuffer): int {
    if (bytes < 1 || bytes > 16384 || length < 1 || length > 512 || offset < 0 || offset > 0xFFFFFFFF ||
        budget < 1 || budget > 1000000 || !destination.hasAddressRange(0,length) || !workspace.hasAddressRange(0,2067)) return -1
    val units=utf8Utf16Units(path,bytes)
    if (units < 1 || units > 4096 || !utf16.hasAddressRange(0,units*2) ||
        fatBuffersOverlap(utf16,units*2,reader,28) || fatBuffersOverlap(utf16,units*2,boot,512) ||
        fatBuffersOverlap(utf16,units*2,workspace,2067) || fatBuffersOverlap(utf16,units*2,destination,length) ||
        fatBuffersOverlap(path,bytes,workspace,2067) || fatBuffersOverlap(path,bytes,destination,length)) return -1
    if (utf8ToUtf16(path,bytes,utf16) != units) return -1
    fatReadPathUtf16Owned(reader,boot,first,sectors,utf16,units,offset,length,budget,destination,workspace)
}
