import "./fat_long_name.ab"
// Creation-specific component checks, separate from decoding historical names.
// UTF16 length1..255, valid surrogate pairs, no path separators/control chars,
// trailing space/dot or dot/dotdot. No Unicode normalization or OEM conversion.
trusted fun fatLongNameCreateValid(name: NativeBuffer,units: int): bool {
    if (!fatLongNameUtf16Valid(name,units)) return false
    val last=name.loadU16((units-1)*2)
    if (last == 32 || last == 46) return false
    var index=0
    while (index < units) {
        val value=name.loadU16(index*2)
        if (value < 32 || value == 34 || value == 42 || value == 47 || value == 58 ||
            value == 60 || value == 62 || value == 63 || value == 92 || value == 124) return false
        index=index+1
    }
    return true
}
fun fatLongNameSpansOverlap(a: NativeBuffer,aBytes: int,b: NativeBuffer,bBytes: int): bool =
    a.addressValue() < b.addressValue()+bBytes && b.addressValue() < a.addressValue()+aBytes
// Encode1..20 LFN entries in on-disk DESCENDING ordinal order, preceding a
// short entry. Returns entry count, or0 with output unchanged on invalid input.
// alias is the exact stored11-byte alias (including05 escape if applicable).
// Caller validates alias spelling and collisions before publication. No I/O,
// alias generation, short-entry publication, hidden allocation or export.
trusted fun fatLongNameEncodeEntries(name: NativeBuffer,units: int,alias: NativeBuffer,output: NativeBuffer): int {
    if (!fatLongNameCreateValid(name,units) || !alias.hasAddressRange(0,11) || alias.load(0) == 0 ||
        alias.load(0) == 229 || alias.load(0) == 32) return 0
    val count=int((u32(units)+u32(12))/u32(13))
    if (!output.hasAddressRange(0,count*32) || fatLongNameSpansOverlap(output,count*32,name,units*2) ||
        fatLongNameSpansOverlap(output,count*32,alias,11)) return 0
    var checksum=0;var index=0
    while (index < 11) { checksum=(((checksum&1)<<7)+(checksum>>1)+alias.load(index))&255;index=index+1 }
    var slot=0
    while (slot < count) {
        val ordinal=count-slot;val entry=nativeBufferAt(output.addressValue()+slot*32,32)
        index=0
        while (index < 32) { entry.store(index,0);index=index+1 }
        entry.store(0,ordinal|(if (slot == 0) 64 else 0));entry.store(11,15);entry.store(13,checksum)
        index=0
        while (index < 13) {
            val position=(ordinal-1)*13+index
            val unit=if (position < units) name.loadU16(position*2) else if (position == units) 0 else 65535
            entry.storeU16(fatLongNameUnitOffset(index),unit);index=index+1
        }
        slot=slot+1
    }
    return count
}
