import "./fat_volume.ab"
import "./fat_free_scan.ab"
// Complete active-FAT count under one volume gate. No FSInfo trust or writes.
// Workspace1028 bytes; read budget bounds work. A partial scan returns only
// status5, never misleading partial capacity. Retrying starts a fresh scan.
// Status1success,3input,4IO,5budget,12busy,13stale,14fault.
// Packed free28@8, usable28@36. Multiply counts by cluster bytes from the
// same mounted geometry; this counts allocation, not file payload bytes.
type FatSpace=int
fun FatSpace.status(): int = this&255
fun FatSpace.freeClusters(): int = (this>>>8)&0xfffffff
fun FatSpace.totalClusters(): int = (this>>>36)&0xfffffff
trusted fun FatVolume.space(owner: u32,readBudget: int,workspace: NativeBuffer): FatSpace {
    val s=this.storage()
    if (!workspace.hasAddressRange(0,1028) || fatBuffersOverlap(s,32,workspace,1028)) return FatSpace(3)
    val admitted=this.begin(owner)
    if (admitted != 0) return FatSpace(admitted)
    val reader=nativeBufferAt(s.loadU32(16),28);val boot=nativeBufferAt(s.loadU32(20),512)
    var result=FatSpace(3)
    if (!fatBuffersOverlap(workspace,1028,reader,28) && !fatBuffersOverlap(workspace,1028,boot,512)) {
        val geometry=fatBootValidate(boot,s.loadU32(24),s.loadU32(28))
        if (geometry.valid()) {
            val total=geometry.usableClusters()
            val count=nativeBufferAt(workspace.addressValue()+1024,4)
            val scanned=fatCountFreeOwned(reader,boot,s.loadU32(24),s.loadU32(28),2,total,readBudget,
                nativeBufferAt(workspace.addressValue(),1024),count)
            result=if (scanned.status() == 2) FatSpace(1|(count.loadU32(0)<<8)|(total<<36)) else FatSpace(scanned.status())
        }
    }
    if (result.status() == 4) s.storeU32(12,3)
    if (!peripheralGateAt(s.addressValue()).finish(owner,true)) return FatSpace(14)
    return result
}
