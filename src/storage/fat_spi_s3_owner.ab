import "./fat_spi_s3.ab"
import "../sd/master_owner_s3_sequence.ab"
// Borrowed owner must stay live; closing/reopening revokes this generation.
// Same28B reader ABI, separate tag and owner pointer in previously reserved24.
trusted fun S3SdMasterOwner.bindFatReaderOwned(reader: NativeBuffer,owner: u32,scratch: NativeBuffer,polls: int = 250): bool {
    if (this.status() != 1 || fatBuffersOverlap(this.buffer(),136,reader,28) ||
        fatBuffersOverlap(this.buffer(),136,scratch,2)) return false
    if (!fatSpiS3ReaderInitialize(reader,this.session(),owner,scratch,polls)) return false
    reader.storeU32(20,0x53465334);reader.storeU32(24,this.buffer().addressValue())
    return true
}
