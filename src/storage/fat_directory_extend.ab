import "./fat_file_create.ab"
import "./fat_chain_plan.ab"
import "./fat_allocate.ab"
// Same transaction owns collision scan, optional one-cluster directory growth,
// and final insertion. Never extend fixed FAT12/16 root. New directory storage
// is zeroed BEFORE linking into the old tail; directory contents are preserved.
// plan8B/existingcluster,workspace2624B; separate caller-owned buffers.
// Extends FatFileCreate:16chain/plan17allocation18link19post-growth insertion.
// Failure candidate cluster28@8 and underlying detail8@44. Mutating failures may leak reservations or
// leave partial FAT mirrors; no rollback/retry and no power-loss atomicity.
trusted fun fatFileCreateShortGrowingOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,
    parent: int,name: NativeBuffer,length: int,budget: int,modified: RtcDateTime,plan: NativeBuffer,
    workspace: NativeBuffer): FatFileCreate {
    if (length < 1 || length > 12 || !plan.hasAddressRange(0,plan.capacity()) || plan.capacity() < 8 || plan.capacity() > 8000000 ||
        fatBuffersOverlap(plan,plan.capacity(),workspace,2624) || fatBuffersOverlap(plan,plan.capacity(),name,length) ||
        fatBuffersOverlap(plan,plan.capacity(),reader,28) || fatBuffersOverlap(plan,plan.capacity(),boot,512)) return FatFileCreate(2)
    val created=fatFileCreateShortOwned(reader,boot,first,sectors,parent,name,length,budget,modified,workspace)
    if (created.status() != 7) return created
    val geometry=fatBootValidate(boot,first,sectors)
    if (parent == 0 && geometry.fatBits() != 32) return created
    val head=if (parent == 0) fatBootU32(boot,44) else parent
    val chain=fatPlanChainOwned(reader,boot,first,sectors,head,budget,plan,nativeBufferAt(workspace.addressValue(),1024))
    if (chain.status() != 1 || chain.count() == 0) return FatFileCreate(16|(chain.status()<<44))
    val tail=plan.loadU32((chain.count()-1)*8);val expected=plan.loadU32((chain.count()-1)*8+4)
    val lastSector=fatClusterFirstSector(boot,first,sectors,tail)+geometry.sectorsPerCluster()-1
    val last=nativeBufferAt(workspace.addressValue(),512)
    if (!fatStorageReadOwned(reader,lastSector,last)) return FatFileCreate(4)
    // A dangling LFN at chain end cannot safely attach to a new short entry.
    if (last.load(480) != 229 && last.load(491) == 15) return FatFileCreate(5)
    val allocation=fatAllocateClusterOwned(reader,boot,first,sectors,2,budget,budget,nativeBufferAt(workspace.addressValue(),2048))
    if (allocation.status() != 1) return FatFileCreate(17|(allocation.cluster()<<8)|(allocation.status()<<44))
    val linked=fatWriteLinkOwned(reader,boot,first,sectors,tail,expected,allocation.cluster(),nativeBufferAt(workspace.addressValue(),2048))
    if (linked.status() != 1) return FatFileCreate(18|(allocation.cluster()<<8)|(linked.status()<<44))
    val inserted=fatFileCreateShortOwned(reader,boot,first,sectors,parent,name,length,budget,modified,workspace)
    return if (inserted.status() == 1) inserted else FatFileCreate(19|(allocation.cluster()<<8)|(inserted.status()<<44))
}
