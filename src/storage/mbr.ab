import "./fat_boot.ab"
// MBR primary entry layout from FatFs ff.c PTE_* definitions.
// Read-only512-byte sector0; cardSectors comes from verified device capacity.
// No CHS addressing, EBR-chain or GPT interpretation. Protective/hybrid GPT
// is rejected even when another entry claims FAT. No implicit formatting.
type MbrPartition = int
fun MbrPartition.sectors(): int = (this>>>32)&4294967295
fun MbrPartition.valid(): bool = this.sectors() != 0
fun MbrPartition.firstSector(): int = if (this.valid()) this&4294967295 else -1
fun mbrFatType(kind: int): bool = kind == 1 || kind == 4 || kind == 6 || kind == 11 || kind == 12 || kind == 14
// 1valid2buffer/capacity3signature4GPT5entry/bounds6overlap.
// Check all four primary extents before selecting any one, including unknown
// nonempty types. Empty entries require zero boot/start/length; CHS ignored.
trusted fun mbrValidate(sector: NativeBuffer,cardSectors: int): int {
    if (!sector.hasAddressRange(0,512) || cardSectors < 1 || cardSectors > 4294967296) return 2
    if (fatBootU16(sector,510) != 0xaa55) return 3
    var index=0
    while (index < 4) {
        val offset=446+index*16
        val kind=sector.load(offset+4)
        if (kind == 238) return 4
        val boot=sector.load(offset)
        val first=fatBootU32(sector,offset+8)
        val count=fatBootU32(sector,offset+12)
        if (kind == 0) {
            if (boot != 0 || first != 0 || count != 0) return 5
        } else {
            if ((boot != 0 && boot != 128) || first == 0 || count == 0 || first >= cardSectors || count > cardSectors-first) return 5
            var other=0
            while (other < index) {
                val previous=446+other*16
                if (sector.load(previous+4) != 0) {
                    val start=fatBootU32(sector,previous+8)
                    val length=fatBootU32(sector,previous+12)
                    if (first < start+length && start < first+count) return 6
                }
                other=other+1
            }
        }
        index=index+1
    }
    return 1
}
// Explicit primary slot0..3. Partition type is only a filter: caller MUST
// read/validate BPB against these bounds before following FAT/directory data.
trusted fun mbrFatPartition(sector: NativeBuffer,cardSectors: int,index: int): MbrPartition {
    if (index < 0 || index > 3 || mbrValidate(sector,cardSectors) != 1) return MbrPartition(0)
    val offset=446+index*16
    if (!mbrFatType(sector.load(offset+4))) return MbrPartition(0)
    return MbrPartition(fatBootU32(sector,offset+8)|(fatBootU32(sector,offset+12)<<32))
}
