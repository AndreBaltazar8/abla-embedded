import "./fat_read_sequence.ab"
import "./fat_cluster_ownership.ab"
// Read-only scan component: claim every cluster of one complete chain in the
// SAME bitmap used for all files/directories. Caller holds a volume-wide gate
// and immutable geometry/media. Any failure invalidates the scan; partial
// claims remain as evidence, not a resumable cursor. No repair or disk writes.
type FatOwnedChain=int
//1complete2input3IO4corruptlink5duplicate(cross-link/cycle)6read-budget.
// Payload:count for1,original link status for4,duplicate cluster for5.
fun FatOwnedChain.status(): int = this&255
fun FatOwnedChain.detail(): int = (this>>>8)&0xfffffff
fun FatOwnedChain.reads(): int = if (this.status() == 1) (this>>>36)&0xfffff else 0
trusted fun fatClaimChainOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,head: int,budget: int,scratch: NativeBuffer,ownership: FatClusterOwnership): FatOwnedChain {
    val geometry=fatBootValidate(boot,first,sectors)
    if (!geometry.valid() || !ownership.valid() || ownership.storage().loadU32(4) != geometry.usableClusters() ||
        budget < 1 || budget > 1000000 || fatClusterFirstSector(boot,first,sectors,head) < 0 ||
        !reader.hasAddressRange(0,28) || !scratch.hasAddressRange(0,1024)) return FatOwnedChain(2)
    val map=ownership.storage();val bytes=fatClusterOwnershipBytes(geometry.usableClusters())
    if (fatBuffersOverlap(map,bytes,reader,28) || fatBuffersOverlap(map,bytes,boot,512) || fatBuffersOverlap(map,bytes,scratch,1024) ||
        fatBuffersOverlap(scratch,1024,reader,28) || fatBuffersOverlap(scratch,1024,boot,512)) return FatOwnedChain(2)
    if (map.loadU32(12) != 0) return FatOwnedChain(5|(map.loadU32(12)<<8))
    var cluster=head;var remaining=budget;var count=0
    while (remaining > 0) {
        val location=fatLinkLocate(boot,first,sectors,cluster)
        val cost=if (location.needsSecondSector()) 2 else 1
        if (remaining < cost) return FatOwnedChain(6)
        val claimed=ownership.claim(cluster)
        if (claimed == 3) return FatOwnedChain(5|(cluster<<8))
        if (claimed != 1) return FatOwnedChain(2)
        remaining=remaining-cost
        val link=fatReadLinkOwned(reader,boot,first,sectors,cluster,scratch)
        count=count+1
        if (link.status() == 8) return FatOwnedChain(3)
        if (link.status() == 2) return FatOwnedChain(1|(count<<8)|((budget-remaining)<<36))
        if (link.status() != 1) return FatOwnedChain(4|(link.status()<<8))
        cluster=link.nextCluster()
    }
    return FatOwnedChain(6)
}
