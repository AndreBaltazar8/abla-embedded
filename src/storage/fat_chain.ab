import "./fat_read_sequence.ab"
// Read-only complete chain validation, bounded by caller I/O budget and the
// volume cluster count. Constant-space Brent cycle detection; no allocation.
// Caller pins immutable medium/BPB/reader and exclusive1024-byte scratch for
// this whole operation. A successful result is not valid after media mutation.
type FatChainResult = int
// 1valid2invalidinput3IO4corruptlink5cycle6budgetexhausted.
// On corruptlink, original FatLink status is in bits8..15.
fun FatChainResult.status(): int = this&255
fun FatChainResult.clusterCount(): int = if (this.status() == 1) (this>>8)&0xfffffff else -1
fun FatChainResult.linkError(): int = if (this.status() == 4) (this>>8)&255 else 0
trusted fun fatChainValidateOwned(reader: NativeBuffer,boot: NativeBuffer,firstSector: int,sectors: int,startCluster: int,readBudget: int,scratch: NativeBuffer): FatChainResult {
    val geometry=fatBootValidate(boot,firstSector,sectors)
    if (!geometry.valid() || readBudget < 1 || readBudget > 1000000 || fatClusterFirstSector(boot,firstSector,sectors,startCluster) < 0 ||
        !reader.hasAddressRange(0,28) || !scratch.hasAddressRange(0,1024) || fatBuffersOverlap(scratch,1024,boot,512) || fatBuffersOverlap(scratch,1024,reader,28)) return FatChainResult(2)
    var current=startCluster
    var anchor=startCluster
    var power=1
    var distance=0
    var count=0
    var remaining=readBudget
    while (remaining > 0) {
        // FAT12 straddle costs two sector reads, not one logical link read.
        val location=fatLinkLocate(boot,firstSector,sectors,current)
        val cost=if (location.needsSecondSector()) 2 else 1
        if (remaining < cost) return FatChainResult(6)
        remaining=remaining-cost
        val link=fatReadLinkOwned(reader,boot,firstSector,sectors,current,scratch)
        count=count+1
        if (link.status() == 8) return FatChainResult(3)
        if (link.status() == 2) return FatChainResult((count<<8)|1)
        if (link.status() != 1) return FatChainResult((link.status()<<8)|4)
        val next=link.nextCluster()
        distance=distance+1
        if (next == anchor || count >= geometry.clusters()) return FatChainResult(5)
        if (distance == power) { anchor=next; power=power*2; distance=0 }
        current=next
    }
    return FatChainResult(6)
}
