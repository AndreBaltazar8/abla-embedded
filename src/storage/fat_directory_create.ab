import "./fat_volume_create_auto.ab"
// Automatic VFAT alias + initialized directory,3780B workspace. Existing
// parent capacity only; full parent returns7 before allocation. Child is
// zeroed with dot/parent entries before its name is published. No rollback.
trusted fun FatVolume.createDirectory(owner: u32,parent: int,name: NativeBuffer,units: int,startAlias: int,
    trials: int,budget: int,modified: RtcDateTime,workspace: NativeBuffer): FatFileCreate =
    this.createLongAuto(owner,parent,name,units,startAlias,trials,budget,modified,workspace,true)
