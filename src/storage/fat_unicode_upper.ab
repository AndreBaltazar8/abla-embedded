val fatUnicodeUpper2=nativeStaticBytes("\x7d\x1d\x01\x00\x63\x2c\x00\x1e\x96\x01\xa0\x1e\x5a\x01\x00\x1f\x08\x06\x10\x1f\x06\x06\x20\x1f\x08\x06\x30\x1f\x08\x06\x40\x1f\x06\x06\x51\x1f\x07\x00\x59\x1f\x52\x1f\x5b\x1f\x54\x1f\x5d\x1f\x56\x1f\x5f\x1f\x60\x1f\x08\x06\x70\x1f\x0e\x00\xba\x1f\xbb\x1f\xc8\x1f\xc9\x1f\xca\x1f\xcb\x1f\xda\x1f\xdb\x1f\xf8\x1f\xf9\x1f\xea\x1f\xeb\x1f\xfa\x1f\xfb\x1f\x80\x1f\x08\x06\x90\x1f\x08\x06\xa0\x1f\x08\x06\xb0\x1f\x04\x00\xb8\x1f\xb9\x1f\xb2\x1f\xbc\x1f\xcc\x1f\x01\x00\xc3\x1f\xd0\x1f\x02\x06\xe0\x1f\x02\x06\xe5\x1f\x01\x00\xec\x1f\xf3\x1f\x01\x00\xfc\x1f\x4e\x21\x01\x00\x32\x21\x70\x21\x10\x02\x84\x21\x01\x00\x83\x21\xd0\x24\x1a\x05\x30\x2c\x2f\x04\x60\x2c\x02\x01\x67\x2c\x06\x01\x75\x2c\x02\x01\x80\x2c\x64\x01\x00\x2d\x26\x08\x41\xff\x1a\x03\x00\x00")
trusted fun fatUnicodeUpper(value: int): int {
    if (value < 0 || value > 0x10FFFF) return -1
    if (value >= 65536) return value
    val table=if (value < 4096) nativeBufferAt(fatUnicodeUpper1,498) else nativeBufferAt(fatUnicodeUpper2,188)
    var offset=0
    while (offset+2 <= table.capacity()) {
        val base=table.loadU16(offset); offset=offset+2
        if (base == 0 || value < base) return value
        val descriptor=table.loadU16(offset); offset=offset+2
        val count=descriptor&255; val command=descriptor>>>8
        if (value < base+count) {
            if (command == 0) return table.loadU16(offset+(value-base)*2)
            if (command == 1) return value-((value-base)&1)
            if (command == 2) return value-16
            if (command == 3) return value-32
            if (command == 4) return value-48
            if (command == 5) return value-26
            if (command == 6) return value+8
            if (command == 7) return value-80
            if (command == 8) return value-0x1C60
            return value
        }
        if (command == 0) offset=offset+count*2
    }
    value
}
