import "./fat_directory_read.ab"
// One bounded read-at chunk, ending at the current sector boundary. Caller
// repeats using bytesRead; short success is not EOF. Workspace1536 holds FAT
// scratch1024 plus a sector512; destination is untouched on any error.
// Same immutable volume and ownership contract as directory reads. Random
// seeks walk from the file head; this does not validate the unseen suffix.
type FatFileRead = int
// 1success(bytes above bit8),2EOF,3input,4IO,5corrupt/truncated,6cycle,7budget.
fun FatFileRead.status(): int = this&255
fun FatFileRead.bytesRead(): int = if (this.status() == 1) (this>>8)&1023 else 0
trusted fun fatFileReadAtOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,file: FatDirectoryEntry,offset: int,length: int,budget: int,destination: NativeBuffer,workspace: NativeBuffer): FatFileRead {
    val geometry=fatBootValidate(boot,first,sectors)
    if (!geometry.valid() || !file.isFile() || offset < 0 || offset > file.byteSize() || length < 1 || length > 512 || budget < 1 || budget > 1000000 ||
        !reader.hasAddressRange(0,28) || !destination.hasAddressRange(0,length) || !workspace.hasAddressRange(0,1536) ||
        fatBuffersOverlap(workspace,1536,boot,512) || fatBuffersOverlap(workspace,1536,reader,28) ||
        fatBuffersOverlap(destination,length,workspace,1536) || fatBuffersOverlap(destination,length,reader,28) || fatBuffersOverlap(destination,length,boot,512) ||
        file.byteSize() > geometry.clusters()*geometry.sectorsPerCluster()*512) return FatFileRead(3)
    if (file.byteSize() > 0 && fatClusterFirstSector(boot,first,sectors,file.firstCluster()) < 0) return FatFileRead(3)
    if (offset == file.byteSize()) return FatFileRead(2)
    val scratch=nativeBufferAt(workspace.addressValue(),1024)
    val sector=nativeBufferAt(workspace.addressValue()+1024,512)
    val read=fatDirectoryReadOwned(reader,boot,first,sectors,file.firstCluster(),offset>>9,budget,sector,scratch)
    if (read.status() != 1) return FatFileRead(if (read.status() == 2) 5 else read.status())
    val within=offset&511
    var count=length
    if (count > 512-within) count=512-within
    if (count > file.byteSize()-offset) count=file.byteSize()-offset
    var index=0
    while (index < count) { destination.store(index,sector.load(within+index)); index=index+1 }
    return FatFileRead((count<<8)|1)
}
