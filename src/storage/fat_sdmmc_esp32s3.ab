import "./fat_sdmmc.ab"
import "../sd/mmc_read_esp32s3.ab"
import "../esp32/timer_esp32s3.ab"
// Caller owns continuously running 16MHz SYSTIMER unit0 and serializes latch
// requests. No timer setup/reset is hidden. Exact wrapping milliseconds from
// 52-bit ticks, using only u32 divisions (no opaque compiler/libc helpers).
trusted fun fatSdMmcNowMilliseconds(): int = fatSdMmcMillisecondsFromTicks(esp32S3TimerTicks(0,16))
