import "./fat_boot.ab"
// On-disk 32-byte short entry layout, FatFs ff.c DIR_* definitions.
// LFN/volume/deleted/end entries are explicitly distinct; not regular files.
// Caller retains immutable sector while reading names/attributes separately.
type FatDirectoryEntry = int
// cluster28,size32,status4. Sign bit may be set: use unsigned status shift.
// 1file2directory3end4deleted5long-name6volume-label7invalid8parent-root.
fun FatDirectoryEntry.status(): int = (this>>>60)&15
fun FatDirectoryEntry.isFile(): bool = this.status() == 1
fun FatDirectoryEntry.isDirectory(): bool = this.status() == 2 || this.status() == 8
fun FatDirectoryEntry.firstCluster(): int = if (this.isFile() || this.isDirectory()) this&0xfffffff else -1
fun FatDirectoryEntry.byteSize(): int = if (this.isFile()) (this>>>28)&4294967295 else -1
trusted fun fatDirectoryDecode(sector: NativeBuffer,index: int,fatBits: int,clusters: int): FatDirectoryEntry {
    if (!sector.hasAddressRange(0,512) || index < 0 || index > 15 || (fatBits != 12 && fatBits != 16 && fatBits != 32) || clusters < 1 || clusters > 0xffffff5) return FatDirectoryEntry(7<<60)
    val offset=index*32
    val first=sector.load(offset)
    if (first == 0) return FatDirectoryEntry(3<<60)
    if (first == 229) return FatDirectoryEntry(4<<60)
    val attributes=sector.load(offset+11)
    if (attributes == 15) return FatDirectoryEntry(5<<60)
    if ((attributes&192) != 0 || (attributes&24) == 24) return FatDirectoryEntry(7<<60)
    if ((attributes&8) != 0) return FatDirectoryEntry(6<<60)
    val cluster=fatBootU16(sector,offset+26)|(if (fatBits == 32) (fatBootU16(sector,offset+20)&4095)<<16 else 0)
    val size=fatBootU32(sector,offset+28)
    val directory=(attributes&16) != 0
    if (directory && size != 0) return FatDirectoryEntry(7<<60)
    if (cluster == 0) {
        // Only the special '..' directory may designate the root via zero.
        if (directory) {
            if (first != 46 || sector.load(offset+1) != 46) return FatDirectoryEntry(7<<60)
            var position=2
            while (position < 11) { if (sector.load(offset+position) != 32) return FatDirectoryEntry(7<<60); position=position+1 }
            return FatDirectoryEntry(8<<60)
        }
        return if (size == 0) FatDirectoryEntry(1<<60) else FatDirectoryEntry(7<<60)
    }
    val reserved=if (fatBits == 12) 0xff0 else if (fatBits == 16) 0xfff0 else 0xffffff0
    if (cluster < 2 || cluster >= clusters+2 || cluster >= reserved) return FatDirectoryEntry(7<<60)
    return FatDirectoryEntry(cluster|(size<<28)|((if (directory) 2 else 1)<<60))
}
// Raw short-name byte0 handles the FAT escaped0xE5 convention. Not Unicode
// decoding: OEM codepage conversion and long-name assembly are separate.
trusted fun fatShortNameByte(sector: NativeBuffer,index: int,position: int): int {
    if (!sector.hasAddressRange(0,512) || index < 0 || index > 15 || position < 0 || position > 10) return -1
    val value=sector.load(index*32+position)
    return if (position == 0 && value == 5) 229 else value
}
