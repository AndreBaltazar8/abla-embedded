import "./fat_long_alias.ab"
import "./fat_file_create.ab"
type FatAliasChoice=int
//1available2input3nameexists4IO5corrupt6lookupbudget7trialbudget/exhausted.
// length4@8,chosen/continuation sequence20@12. Output unchanged on failure.
fun FatAliasChoice.status(): int = this&255
fun FatAliasChoice.length(): int = (this>>8)&15
fun FatAliasChoice.sequence(): int = (this>>12)&0xfffff
trusted fun fatSelectLongAliasOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,parent: int,
    name: NativeBuffer,units: int,start: int,trials: int,budget: int,output: NativeBuffer,workspace: NativeBuffer,excludedEntry: int = -1): FatAliasChoice {
    if (!fatLongNameCreateValid(name,units) || start < 1 || start > 999999 || trials < 1 || trials > 1000 || budget < 1 || budget > 1000000 ||
        !output.hasAddressRange(0,12) || !workspace.hasAddressRange(0,2104) ||
        fatBuffersOverlap(workspace,2104,name,units*2) || fatBuffersOverlap(workspace,2104,reader,28) ||
        fatBuffersOverlap(workspace,2104,boot,512) || fatBuffersOverlap(workspace,2104,output,12) ||
        fatBuffersOverlap(output,12,name,units*2) || fatBuffersOverlap(output,12,reader,28) || fatBuffersOverlap(output,12,boot,512)) return FatAliasChoice(2)
    val sector=nativeBufferAt(workspace.addressValue(),512);val scratch=nativeBufferAt(workspace.addressValue()+512,1024)
    val assembly=nativeBufferAt(workspace.addressValue()+1536,520);val alias=nativeBufferAt(workspace.addressValue()+2056,11)
    val wide=nativeBufferAt(workspace.addressValue()+2068,24);val candidate=nativeBufferAt(workspace.addressValue()+2092,12)
    val short=if (fatShortNameEncodeUtf16(name,units,alias)) alias else NativeBuffer(0)
    val existing=fatLookupNameOwned(reader,boot,first,sectors,parent,name,units,true,assembly,budget,sector,scratch,short,true,NativeBuffer(0),excludedEntry)
    if (existing.isFile() || existing.isDirectory()) return FatAliasChoice(3)
    if (existing.status() != 9) return FatAliasChoice(if (existing.status() == 11) 4 else if (existing.status() == 14) 6 else 5)
    var sequence=start;var attempted=0
    while (attempted < trials && sequence <= 999999) {
        val length=fatLongAliasCandidate(name,units,sequence,candidate)
        if (length == 0 || !fatShortNameEncode(candidate,length,alias)) return FatAliasChoice(2)
        var i=0
        while (i < length) { wide.storeU16(i*2,candidate.load(i));i=i+1 }
        val found=fatLookupNameOwned(reader,boot,first,sectors,parent,wide,length,true,assembly,budget,sector,scratch,alias,true,NativeBuffer(0),excludedEntry)
        if (found.status() == 9) {
            i=0
            while (i < length) { output.store(i,candidate.load(i));i=i+1 }
            return FatAliasChoice(1|(length<<8)|(sequence<<12))
        }
        if (!found.isFile() && !found.isDirectory()) return FatAliasChoice(if (found.status() == 11) 4 else if (found.status() == 14) 6 else 5)
        sequence=sequence+1;attempted=attempted+1
    }
    return FatAliasChoice(7|(sequence<<12))
}
