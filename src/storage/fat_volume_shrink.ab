import "./fat_volume.ab"
import "./fat_file_shrink.ab"
trusted fun FatVolume.shrink(owner: u32,parent: int,ordinal: int,entry: int,expected: NativeBuffer,
    newSize: int,budget: int,modified: RtcDateTime,plan: NativeBuffer,workspace: NativeBuffer): FatFileShrink {
    val s=this.storage()
    if (fatBuffersOverlap(s,32,workspace,2560) || fatBuffersOverlap(s,32,plan,plan.capacity()) ||
        fatBuffersOverlap(s,32,expected,32)) return FatFileShrink(2)
    val admitted=this.begin(owner)
    if (admitted != 0) return FatFileShrink(admitted)
    val result=fatFileShrinkOwned(nativeBufferAt(s.loadU32(16),28),nativeBufferAt(s.loadU32(20),512),s.loadU32(24),s.loadU32(28),
        parent,ordinal,entry,expected,newSize,budget,modified,plan,workspace)
    if (result.status() >= 4 && result.status() <= 10) s.storeU32(12,3)
    if (!peripheralGateAt(s.addressValue()).finish(owner,true)) return FatFileShrink(14|(result.freedClusters()<<8))
    return result
}
