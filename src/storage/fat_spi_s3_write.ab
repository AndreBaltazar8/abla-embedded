import "./fat_spi_s3.ab"
import "./fat_file_overwrite.ab"
// Opt-in write hook. Retain mounted owner generation and exclusive filesystem
// ownership across traversal/read/modify/write, not merely each SPI call.
// False is conservatively uncertain; native session revokes transport failures.
trusted fun fatStorageWriteOwned(reader: NativeBuffer,sector: int,source: NativeBuffer): bool =
    fatSpiS3TransferOwned(reader,sector,source,true)
