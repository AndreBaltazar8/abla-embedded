import "./fat_volume.ab"
import "./fat_file_create_long.ab"
trusted fun FatVolume.createLong(owner: u32,parent: int,name: NativeBuffer,units: int,alias: NativeBuffer,aliasLength: int,
    budget: int,modified: RtcDateTime,workspace: NativeBuffer): FatFileCreate {
    val s=this.storage()
    if (fatBuffersOverlap(s,32,workspace,3768) || fatBuffersOverlap(s,32,name,units*2) ||
        fatBuffersOverlap(s,32,alias,aliasLength)) return FatFileCreate(2)
    val admitted=this.begin(owner)
    if (admitted != 0) return FatFileCreate(admitted)
    val result=fatFileCreateLongOwned(nativeBufferAt(s.loadU32(16),28),nativeBufferAt(s.loadU32(20),512),s.loadU32(24),s.loadU32(28),
        parent,name,units,alias,aliasLength,budget,modified,workspace)
    if (result.status() == 4 || result.status() == 8) s.storeU32(12,3)
    if (!peripheralGateAt(s.addressValue()).finish(owner,true)) return FatFileCreate(14)
    return result
}
