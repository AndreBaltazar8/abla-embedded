import "./mbr.ab"
import "./fat_read_sequence.ab"
// Read-only volume admission. Explicit partition=-1 means superfloppy;
// 0..3 means primary MBR slot. No automatic fallback from damaged MBR/GPT.
// Result packs firstLBA32/availableSectors32. Failed results have size0 and
// status2input3IO4partition5BPB. Success leaves verified BPB in boot buffer.
// The descriptor, gate, boot and scratch remain caller-owned/disjoint; caller
// serializes media lifetime and prevents filesystem writers while mounted.
type FatMountResult = int
fun FatMountResult.sectors(): int = (this>>>32)&4294967295
fun FatMountResult.valid(): bool = this.sectors() != 0
fun FatMountResult.status(): int = if (this.valid()) 1 else this&255
fun FatMountResult.firstSector(): int = if (this.valid()) this&4294967295 else -1
trusted fun fatMountReadOwned(reader: NativeBuffer,cardSectors: int,partition: int,boot: NativeBuffer,scratch: NativeBuffer): FatMountResult {
    if (partition < -1 || partition > 3 || cardSectors < 1 || cardSectors > 4294967296 ||
        !reader.hasAddressRange(0,28) || !boot.hasAddressRange(0,512) || !scratch.hasAddressRange(0,512) ||
        fatBuffersOverlap(boot,512,reader,28) || fatBuffersOverlap(scratch,512,reader,28) || fatBuffersOverlap(boot,512,scratch,512)) return FatMountResult(2)
    val sector0=nativeBufferAt(scratch.addressValue(),512)
    if (!fatStorageReadOwned(reader,0,sector0)) return FatMountResult(3)
    var first=0
    var length=cardSectors
    if (partition == -1) {
        var index=0
        while (index < 512) { boot.store(index,sector0.load(index)); index=index+1 }
    } else {
        val selected=mbrFatPartition(sector0,cardSectors,partition)
        if (!selected.valid()) return FatMountResult(4)
        first=selected.firstSector(); length=selected.sectors()
        if (!fatStorageReadOwned(reader,first,nativeBufferAt(boot.addressValue(),512))) return FatMountResult(3)
    }
    if (!fatBootValidate(boot,first,length).valid()) return FatMountResult(5)
    // Use the actual FAT volume extent, not partition slack. FAT BPB total
    // is <=2^32-1 even on a card containing exactly2^32 sectors.
    return FatMountResult(first|(fatBootTotalSectors(boot)<<32))
}
