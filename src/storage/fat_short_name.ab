import "./fat_read_sequence.ab"
import "./fat_short_character.ab"
// Strict ASCII 8.3 spelling -> uppercase, space-padded FAT name. No lossy
// truncation, generated aliases or OEM conversion. Dot/dotdot are supported.
// Input/output disjoint. Failure leaves destination unchanged.
trusted fun fatShortNameEncode(input: NativeBuffer,length: int,output: NativeBuffer): bool {
    fatShortNameEncodeUnits(input,length,output,false)
}
trusted fun fatShortNameEncodeUtf16(input: NativeBuffer,units: int,output: NativeBuffer): bool = fatShortNameEncodeUnits(input,units,output,true)
trusted fun fatShortInputUnit(input: NativeBuffer,index: int,wide: bool): int = if (wide) input.loadU16(index*2) else input.load(index)
trusted fun fatShortNameEncodeUnits(input: NativeBuffer,length: int,output: NativeBuffer,wide: bool): bool {
    val bytes=if (wide) length*2 else length
    if (length < 1 || length > 12 || !input.hasAddressRange(0,bytes) || !output.hasAddressRange(0,11) || fatBuffersOverlap(input,bytes,output,11)) return false
    val dot=(length == 1 && fatShortInputUnit(input,0,wide) == 46) || (length == 2 && fatShortInputUnit(input,0,wide) == 46 && fatShortInputUnit(input,1,wide) == 46)
    var base=0
    var extension=0
    var separator=false
    var i=0
    if (!dot) {
        while (i < length) {
            val value=fatShortInputUnit(input,i,wide)
            if (value == 46) {
                if (separator || base == 0 || i == length-1) return false
                separator=true
            } else {
                if (!fatShortAsciiCharacter(value)) return false
                if (separator) extension=extension+1 else base=base+1
                if (base > 8 || extension > 3) return false
            }
            i=i+1
        }
    }
    i=0
    while (i < 11) { output.store(i,32); i=i+1 }
    var position=0
    i=0
    while (i < length) {
        val value=fatShortInputUnit(input,i,wide)
        if (!dot && value == 46) position=8
        else { output.store(position,if (value >= 97 && value <= 122) value-32 else value); position=position+1 }
        i=i+1
    }
    return true
}
