import "./fat_papermono.ab"
import "../m5stack/papermono_sd_owner_esp32s3.ab"
import "../esp32/timer_esp32s3.ab"
trusted fun fatSdMmcNowMilliseconds(): int = fatSdMmcMillisecondsFromTicks(esp32S3TimerTicks(0,16))
trusted fun paperMonoFatDestinationSafe(owner: PaperMonoSdOwner,destination: NativeBuffer): bool =
    sdMmcReadDisjoint(owner.buffer().loadU32(20),72,destination.addressValue(),512) &&
    esp32S3I2cFacadeBufferSafe(destination,512,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)
trusted fun paperMonoFatStorageSafe(owner: PaperMonoSdOwner,reader: NativeBuffer,session: NativeBuffer,descriptor: NativeBuffer,bounce: NativeBuffer): bool {
    val control=owner.buffer().loadU32(20)
    if (control <= 0 || control > 4294967224) return false
    var index=0
    while (index < 5) {
        if (index != 1) {
            val address=fatSdMmcRegionAddress(reader,owner.card(),session,descriptor,bounce,index)
            val bytes=fatSdMmcRegionSize(index)
            if (!sdMmcReadDisjoint(control,72,address,bytes) ||
                !esp32S3I2cFacadeBufferSafe(nativeBufferAt(address,bytes),bytes,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return false
        }
        index=index+1
    }
    return true
}
trusted fun fatStorageReadOwned(reader: NativeBuffer,sector: int,destination: NativeBuffer): bool = paperMonoFatReadOwned(reader,sector,destination)
