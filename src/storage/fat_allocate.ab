import "./fat_free_scan.ab"
import "./fat_link_write.ab"
import "./fat_fsinfo.ab"
// Reserve one standalone EOC cluster, then zero every data sector before
// returning success. Caller holds exclusive volume gate THROUGH publication
// into a file chain/directory. Success alone creates an unreferenced cluster.
// Do not retry failures blindly: writes may be partial, reservation may leak.
type FatAllocation=int
//1reserved+zeroed2full3input4readIO5scanbudget6hintfailure7FATfailure8zerofailure.
// Candidate/continuation28@8,detail8@36. Failure candidate is not usable data.
fun FatAllocation.status(): int = this&255
fun FatAllocation.cluster(): int = (this>>8)&0xfffffff
fun FatAllocation.detail(): int = (this>>36)&255
trusted fun fatAllocateClusterOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,
    start: int,maxCandidates: int,readBudget: int,workspace: NativeBuffer): FatAllocation {
    if (!workspace.hasAddressRange(0,2048) || fatBuffersOverlap(workspace,2048,reader,28) ||
        fatBuffersOverlap(workspace,2048,boot,512)) return FatAllocation(3)
    val found=fatFindFreeOwned(reader,boot,first,sectors,start,maxCandidates,readBudget,nativeBufferAt(workspace.addressValue(),1024))
    if (found.status() != 1) return FatAllocation(found.status()|(found.cluster()<<8))
    val cluster=found.cluster();val geometry=fatBootValidate(boot,first,sectors)
    val hints=fatInvalidateFreeHintsOwned(reader,boot,first,sectors,nativeBufferAt(workspace.addressValue(),1024))
    if (hints != 1) return FatAllocation(6|(cluster<<8)|(hints<<36))
    val eoc=if (geometry.fatBits() == 12) 4095 else if (geometry.fatBits() == 16) 65535 else 268435455
    val reserved=fatWriteLinkOwned(reader,boot,first,sectors,cluster,0,eoc,workspace)
    if (reserved.status() != 1) return FatAllocation(7|(cluster<<8)|(reserved.status()<<36))
    val zero=nativeBufferAt(workspace.addressValue(),512);var offset=0
    while (offset < 512) { zero.store(offset,0);offset=offset+1 }
    val data=fatClusterFirstSector(boot,first,sectors,cluster);var sector=0
    while (sector < geometry.sectorsPerCluster()) {
        if (!fatStorageWriteOwned(reader,data+sector,zero)) return FatAllocation(8|(cluster<<8)|(sector<<36))
        sector=sector+1
    }
    return FatAllocation(1|(cluster<<8))
}
