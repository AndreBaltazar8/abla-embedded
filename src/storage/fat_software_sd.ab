import "./fat_read_sequence.ab"
import "../sd/software_block.ab"
// Reader descriptor: LE gateAddress32@0,owner32@4; pin bytes clock/MOSI/MISO/CS
// @8..11; SoftwareSdInitResult32@12; half-periodus32@16; capacity64@20.
// Caller supplies immutable28bytes from initialized card/CSD and canonical
// gate; owns pad/card lifetime and prevents other filesystem writers.
// Select platform GPIO and peripheral-delay imports in the application.
// Descriptor/gate/BPB/scratch storage must remain owned and nonoverlapping.
// Checked construction performs no hardware access. Card state/capacity must
// come from initialization and validated CSD on these same powered pads.
// On rejection descriptor bytes remain unchanged; never publish on failure.
trusted fun fatReaderStore32(reader: NativeBuffer,offset: int,value: int): void {
    reader.store(offset,value&255); reader.store(offset+1,(value>>8)&255)
    reader.store(offset+2,(value>>16)&255); reader.store(offset+3,(value>>24)&255)
    return
}
trusted fun fatSoftwareSdReaderInitialize(reader: NativeBuffer,gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,miso: Pin,chipSelect: Pin,card: SoftwareSdInitResult,capacity: int,halfPeriodMicroseconds: int = 2): bool {
    val gateAddress=gate.word().address()
    if (gateAddress > 4294967295 || !gate.bufferDisjoint(reader,28) || !peripheralOwnerValid(owner) ||
        !card.valid() || (card&~196609) != 0 || (card.highCapacity() && !card.version2()) ||
        capacity < 1 || capacity > 4294967296 || !sdSpiBlockAddressValid(card.highCapacity(),capacity-1) ||
        clock.number() > 255 || mosi.number() < 0 || mosi.number() > 255 || miso.number() < 0 || miso.number() > 255 || chipSelect.number() > 255 ||
        !softwareSpiConfigurationValid(clock,mosi,miso,0,halfPeriodMicroseconds) || !softwareSpiSelectionValid(clock,mosi,miso,chipSelect,0,0)) return false
    fatReaderStore32(reader,0,gateAddress)
    fatReaderStore32(reader,4,int(owner))
    reader.store(8,clock.number()); reader.store(9,mosi.number()); reader.store(10,miso.number()); reader.store(11,chipSelect.number())
    fatReaderStore32(reader,12,1|(if (card.highCapacity()) 65536 else 0)|(if (card.version2()) 131072 else 0))
    fatReaderStore32(reader,16,halfPeriodMicroseconds)
    fatReaderStore32(reader,20,capacity&4294967295)
    fatReaderStore32(reader,24,capacity>>32)
    return true
}
trusted fun fatStorageReadOwned(reader: NativeBuffer,sector: int,destination: NativeBuffer): bool {
    if (!reader.hasAddressRange(0,28) || !destination.hasAddressRange(0,512) || fatBuffersOverlap(reader,28,destination,512)) return false
    val high=fatBootU32(reader,24)
    val low=fatBootU32(reader,20)
    if (high > 1 || (high == 1 && low != 0)) return false
    val capacity=low|(high<<32)
    if (sector < 0 || sector >= capacity) return false
    val gate=peripheralGateAt(fatBootU32(reader,0))
    if (!gate.bufferDisjoint(reader,28)) return false
    return softwareSdReadBlock(gate,u32(fatBootU32(reader,4)),Pin(reader.load(8)),Pin(reader.load(9)),Pin(reader.load(10)),Pin(reader.load(11)),
        SoftwareSdInitResult(fatBootU32(reader,12)),sector,destination,fatBootU32(reader,16)).valid()
}
