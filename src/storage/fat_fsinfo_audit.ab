import "./fat_read_sequence.ab"
// Read-only configured FAT32 FSInfo/backup validation under one immutable
// volume lifetime. Unknown FFFFFFFF hints are valid. A next-free hint is a
// search starting point, NOT a promise that the hinted cluster is free.
// expectedFree=-1 checks bounds only; otherwise compare known counts against
// a complete free-count scan performed under the SAME volume gate.
type FatFsInfoAudit=int
//1valid2input/layout3IO4signature5hint-range6stale-known-count7absent8notFAT32.
// Failed copy0primary/1backup at8; physical reads16..17 on success.
fun FatFsInfoAudit.status(): int = this&255
fun FatFsInfoAudit.copy(): int = (this>>>8)&1
fun FatFsInfoAudit.reads(): int = if (this.status() == 1) (this>>>16)&3 else 0
trusted fun fatAuditFsInfoOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,expectedFree: int,scratch: NativeBuffer): FatFsInfoAudit {
    val geometry=fatBootValidate(boot,first,sectors)
    if (!geometry.valid() || expectedFree < -1 || expectedFree > geometry.usableClusters() || !reader.hasAddressRange(0,28) || !scratch.hasAddressRange(0,512) ||
        fatBuffersOverlap(scratch,512,reader,28) || fatBuffersOverlap(scratch,512,boot,512)) return FatFsInfoAudit(2)
    if (geometry.fatBits() != 32) return FatFsInfoAudit(8)
    val info=fatBootU16(boot,48);val backup=fatBootU16(boot,50);val reserved=fatBootU16(boot,14)
    if (info == 65535) return FatFsInfoAudit(7)
    val copies=if (backup == 0 || backup == 65535) 1 else 2
    if (info == 0 || info >= reserved || (copies == 2 && (backup >= reserved || backup == info || backup+info >= reserved))) return FatFsInfoAudit(2)
    var copy=0
    while (copy < copies) {
        if (!fatStorageReadOwned(reader,first+info+(if (copy == 0) 0 else backup),scratch)) return FatFsInfoAudit(3|(copy<<8))
        if (fatBootU32(scratch,0) != 0x41615252 || fatBootU32(scratch,484) != 0x61417272 || fatBootU32(scratch,508) != 0xaa550000) return FatFsInfoAudit(4|(copy<<8))
        val free=fatBootU32(scratch,488);val next=fatBootU32(scratch,492)
        if ((free != 0xffffffff && free > geometry.usableClusters()) ||
            (next != 0xffffffff && (next < 2 || next >= geometry.usableClusters()+2))) return FatFsInfoAudit(5|(copy<<8))
        if (expectedFree >= 0 && free != 0xffffffff && free != expectedFree) return FatFsInfoAudit(6|(copy<<8))
        copy=copy+1
    }
    return FatFsInfoAudit(1|(copies<<16))
}
