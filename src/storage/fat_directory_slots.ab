import "./fat_directory_read.ab"
// Find1..21 consecutive free entries (up to20LFN+one short entry). No writes,
// allocation or reservation. Caller keeps volume exclusively owned from
// collision checking through this scan and publication. Plan not a live lease.
// After the first end marker, uninterpreted trailing bytes are free. Writer
// MUST preserve a following end marker before publishing a set that consumes
// the old one. A run can span sectors/clusters, never the end of a fixed root.
type FatDirectorySlots=int
//1found2full3input4IO5corrupt6budget. Index4@8,ordinal32@12,consumesEnd@44.
fun FatDirectorySlots.status(): int = this&255
fun FatDirectorySlots.entryIndex(): int = (this>>8)&15
fun FatDirectorySlots.ordinal(): int = (this>>12)&0xffffffff
fun FatDirectorySlots.consumesEnd(): bool = (this&(1<<44)) != 0
trusted fun fatFindDirectorySlotsOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,
    parent: int,needed: int,budget: int,sector: NativeBuffer,scratch: NativeBuffer): FatDirectorySlots {
    val geometry=fatBootValidate(boot,first,sectors)
    if (!geometry.valid() || needed < 1 || needed > 21 || budget < 1 || budget > 1000000) return FatDirectorySlots(3)
    val fixed=parent == 0 && geometry.fatBits() != 32
    var ordinal=0;var remaining=budget;var previousLong=false;var afterEnd=false
    var run=0;var startOrdinal=0;var startIndex=0;var usesEnd=false
    while (remaining > 0) {
        var steps=ordinal;var divisor=geometry.sectorsPerCluster()
        while (divisor > 1) { steps=steps>>1;divisor=divisor>>1 }
        val cost=if (fixed) 1 else steps*2+1
        if (remaining < cost) return FatDirectorySlots(6)
        remaining=remaining-cost
        val read=fatDirectoryReadOwned(reader,boot,first,sectors,parent,ordinal,cost,sector,scratch)
        if (read.status() == 2) return FatDirectorySlots(2)
        if (read.status() != 1) return FatDirectorySlots(if (read.status() == 4) 4 else if (read.status() == 3) 3 else 5)
        var index=0
        while (index < 16) {
            val entry=if (afterEnd) FatDirectoryEntry(3<<60) else fatDirectoryDecode(sector,index,geometry.fatBits(),geometry.clusters())
            if (entry.status() == 7) return FatDirectorySlots(5)
            if (entry.status() == 3) {
                if (previousLong) return FatDirectorySlots(5)
                afterEnd=true
            }
            if ((afterEnd || entry.status() == 4) && !previousLong) {
                if (run == 0) { startOrdinal=ordinal;startIndex=index;usesEnd=false }
                run=run+1;usesEnd=usesEnd || afterEnd
                if (run == needed) return FatDirectorySlots(1|(startIndex<<8)|(startOrdinal<<12)|(if (usesEnd) 1<<44 else 0))
            } else run=0
            previousLong=!afterEnd && entry.status() == 5
            index=index+1
        }
        ordinal=ordinal+1
    }
    return FatDirectorySlots(6)
}
