import "./fat_link.ab"
// Owned immutable reader context/BPB, exclusive writable1024-byte scratch.
// The storage hook reads exactly512bytes and returns false on any transport,
// CRC or ownership failure. The medium must not change during traversal.
fun fatBuffersOverlap(a: NativeBuffer,aSize: int,b: NativeBuffer,bSize: int): bool =
    a.addressValue() < b.addressValue()+bSize && b.addressValue() < a.addressValue()+aSize
trusted fun fatReadLinkOwned(reader: NativeBuffer,boot: NativeBuffer,firstSector: int,sectors: int,cluster: int,scratch: NativeBuffer): FatLink {
    if (!reader.hasAddressRange(0,28) || !boot.hasAddressRange(0,512) || !scratch.hasAddressRange(0,1024) ||
        fatBuffersOverlap(scratch,1024,boot,512) || fatBuffersOverlap(scratch,1024,reader,28)) return FatLink(7)
    val geometry=fatBootValidate(boot,firstSector,sectors)
    val location=fatLinkLocate(boot,firstSector,sectors,cluster)
    if (!location.valid()) return FatLink(7)
    val a=nativeBufferAt(scratch.addressValue(),512)
    val b=nativeBufferAt(scratch.addressValue()+512,512)
    if (!fatStorageReadOwned(reader,location.sector(),a)) return FatLink(8)
    if (location.needsSecondSector() && !fatStorageReadOwned(reader,location.sector()+1,b)) return FatLink(8)
    return fatLinkDecode(location,geometry.clusters(),a,b)
}
