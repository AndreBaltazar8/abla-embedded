import "./fat_read_sequence.ab"
// Raw entry helpers preserve adjacent FAT12 nibbles and FAT32 high bits.
// The caller supplies sectors belonging to location; no media I/O here.
trusted fun fatLinkRaw(location: FatLinkLocation,first: NativeBuffer,second: NativeBuffer): int {
    if (!location.valid() || !first.hasAddressRange(0,512)) return -1
    val kind=(location>>41)&3;val offset=location.offset()
    if (kind == 1) {
        if (location.needsSecondSector() && !second.hasAddressRange(0,512)) return -1
        val high=if (location.needsSecondSector()) second.load(0) else first.load(offset+1)
        val word=first.load(offset)|(high<<8)
        return if ((location&(1<<43)) != 0) word>>4 else word&4095
    }
    if (kind == 2 && (offset&1) == 0) return fatBootU16(first,offset)
    if (kind == 3 && (offset&3) == 0) return fatBootU32(first,offset)&0xfffffff
    return -1
}
trusted fun fatLinkPatch(location: FatLinkLocation,value: int,first: NativeBuffer,second: NativeBuffer): bool {
    val kind=(location>>41)&3;val offset=location.offset()
    val limit=if (kind == 1) 4095 else if (kind == 2) 65535 else 268435455
    if (value < 0 || value > limit || fatLinkRaw(location,first,second) < 0 ||
        (location.needsSecondSector() && fatBuffersOverlap(first,512,second,512))) return false
    if (kind == 1) {
        val high=if (location.needsSecondSector()) second.load(0) else first.load(offset+1)
        val old=first.load(offset)|(high<<8)
        val word=if ((location&(1<<43)) != 0) (old&15)|(value<<4) else (old&61440)|value
        first.store(offset,word&255)
        if (location.needsSecondSector()) second.store(0,word>>8) else first.store(offset+1,word>>8)
    } else if (kind == 2) first.storeU16(offset,value)
    else first.storeU32(offset,(fatBootU32(first,offset)&0xf0000000)|value)
    return true
}
