import "./fat_file_create_long.ab"
import "./fat_chain_plan.ab"
import "./fat_allocate.ab"
// At most two new clusters cover all21 VFAT slots, even with512B clusters.
// Snapshot the existing chain once; subsequent tails are our own reservations.
// Keep ownership across allocation, zeroing, linkage and final publication.
// Status16plan17allocation18link19post-growth insertion, candidate28@8/detail8@44.
trusted fun fatFileCreateLongGrowingOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,
    parent: int,name: NativeBuffer,units: int,alias: NativeBuffer,aliasLength: int,budget: int,
    modified: RtcDateTime,plan: NativeBuffer,workspace: NativeBuffer,makeDirectory: bool = false,sourceEntry: NativeBuffer = NativeBuffer(0),excludedEntry: int = -1): FatFileCreate {
    if (units < 1 || units > 255 || aliasLength < 1 || aliasLength > 12 ||
        !plan.hasAddressRange(0,plan.capacity()) || plan.capacity() < 8 || plan.capacity() > 8000000 ||
        fatBuffersOverlap(plan,plan.capacity(),workspace,3768) || fatBuffersOverlap(plan,plan.capacity(),name,units*2) ||
        fatBuffersOverlap(plan,plan.capacity(),alias,aliasLength) || fatBuffersOverlap(plan,plan.capacity(),reader,28) ||
        fatBuffersOverlap(plan,plan.capacity(),boot,512) || ((sourceEntry|0) != 0 && fatBuffersOverlap(plan,plan.capacity(),sourceEntry,32))) return FatFileCreate(2)
    val created=fatFileCreateLongOwned(reader,boot,first,sectors,parent,name,units,alias,aliasLength,budget,modified,workspace,makeDirectory,sourceEntry,excludedEntry)
    if (created.status() != 7) return created
    val geometry=fatBootValidate(boot,first,sectors)
    if (parent == 0 && geometry.fatBits() != 32) return created
    val head=if (parent == 0) fatBootU32(boot,44) else parent
    val chain=fatPlanChainOwned(reader,boot,first,sectors,head,budget,plan,nativeBufferAt(workspace.addressValue(),1024))
    if (chain.status() != 1 || chain.count() == 0) return FatFileCreate(16|(chain.status()<<44))
    var tail=plan.loadU32((chain.count()-1)*8);var expected=plan.loadU32((chain.count()-1)*8+4)
    val last=nativeBufferAt(workspace.addressValue(),512)
    if (!fatStorageReadOwned(reader,fatClusterFirstSector(boot,first,sectors,tail)+geometry.sectorsPerCluster()-1,last)) return FatFileCreate(4)
    if (last.load(480) != 229 && last.load(491) == 15) return FatFileCreate(5)
    var added=0
    while (added < 2) {
        val allocation=fatAllocateClusterOwned(reader,boot,first,sectors,2,budget,budget,nativeBufferAt(workspace.addressValue(),2048))
        if (allocation.status() != 1) return FatFileCreate(17|(allocation.cluster()<<8)|(allocation.status()<<44))
        val linked=fatWriteLinkOwned(reader,boot,first,sectors,tail,expected,allocation.cluster(),nativeBufferAt(workspace.addressValue(),2048))
        if (linked.status() != 1) return FatFileCreate(18|(allocation.cluster()<<8)|(linked.status()<<44))
        val inserted=fatFileCreateLongOwned(reader,boot,first,sectors,parent,name,units,alias,aliasLength,budget,modified,workspace,makeDirectory,sourceEntry,excludedEntry)
        if (inserted.status() == 1) return inserted
        if (inserted.status() != 7 || added == 1) return FatFileCreate(19|(allocation.cluster()<<8)|(inserted.status()<<44))
        tail=u32(allocation.cluster());expected=u32(if (geometry.fatBits() == 12) 0xfff else if (geometry.fatBits() == 16) 0xffff else 0xfffffff)
        added=added+1
    }
    return FatFileCreate(19)
}
