import "./fat_sdmmc_core.ab"
import "../m5stack/papermono_sd_owner_sequence.ab"
// Same28B reader layout, except word0 is PaperMono owner address and unique
// tag24. No temporary descriptor/heap; the card view is resolved for each read.
trusted fun paperMonoFatRegions(owner: PaperMonoSdOwner,reader: NativeBuffer,session: NativeBuffer,
    descriptor: NativeBuffer,bounce: NativeBuffer): bool {
    if (owner.status() < 0) return false
    var index=0
    while (index < 5) {
        if (index != 1 && !sdMmcReadDisjoint(owner.buffer().addressValue(),432,
            fatSdMmcRegionAddress(reader,owner.card(),session,descriptor,bounce,index),fatSdMmcRegionSize(index))) return false
        index=index+1
    }
    return paperMonoFatStorageSafe(owner,reader,session,descriptor,bounce)
}
trusted fun paperMonoFatReaderInitialize(reader: NativeBuffer,owner: PaperMonoSdOwner,session: NativeBuffer,
    descriptor: NativeBuffer,bounce: NativeBuffer,timeoutMs: int,polls: int,exclusive: bool): bool {
    if (!exclusive || owner.card() == 0 || !paperMonoFatRegions(owner,reader,session,descriptor,bounce) ||
        !fatSdMmcReaderInitialize(reader,owner.card(),session,descriptor,bounce,timeoutMs,polls,true)) return false
    reader.storeU32(0,owner.buffer().addressValue());reader.storeU32(24,0x504d4631);return true
}
trusted fun paperMonoFatReadOwned(reader: NativeBuffer,sector: int,destination: NativeBuffer): bool {
    if (!fatSdMmcReaderValid(reader,0x504d4631)) return false
    val owner=paperMonoSdOwnerAt(nativeBufferAt(reader.loadU32(0),432))
    if (owner.card() == 0 || !sdMmcReadDisjoint(owner.buffer().addressValue(),432,destination.addressValue(),512) ||
        !paperMonoFatDestinationSafe(owner,destination)) return false
    if (!paperMonoFatRegions(owner,reader,nativeBufferAt(reader.loadU32(4),52),
        nativeBufferAt(reader.loadU32(8),16),nativeBufferAt(reader.loadU32(12),512))) return false
    return fatSdMmcReadCardOwned(reader,owner.card(),sector,destination,0x504d4631)
}
// Drain must remain available even after owner leaves ready state. It never
// starts another transfer or republishes a usable reader after an error.
trusted fun paperMonoFatDrainOwned(reader: NativeBuffer): int = fatSdMmcDrainOwned(reader,0x504d4631)
