import "./fat_long_name_encode.ab"
import "./fat_short_character.ab"
// Deterministic portable ASCII alias, not a claim to duplicate Windows/FatFs
// alias heuristics. Sanitized uppercase stem +~1..999999 +last extension3.
// Strip dots/spaces from stem, map non-short characters and each non-BMP pair
// to underscore; fallback underscore when empty. Original LFN remains intact.
// Returns ASCII spelling length<=12,0invalid with output unchanged.
trusted fun fatLongAliasCandidate(name: NativeBuffer,units: int,sequence: int,output: NativeBuffer): int {
    if (!fatLongNameCreateValid(name,units) || sequence < 1 || sequence > 999999 || !output.hasAddressRange(0,12) ||
        fatLongNameSpansOverlap(name,units*2,output,12)) return 0
    var digits=1;var quotient=u32(sequence)
    while (quotient >= u32(10)) { quotient=quotient/u32(10);digits=digits+1 }
    var dot=-1;var index=0
    while (index < units) { if (name.loadU16(index*2) == 46 && index > 0) dot=index;index=index+1 }
    val stemEnd=if (dot < 0) units else dot
    var length=0;index=0
    while (index < stemEnd && length < 7-digits) {
        val unit=name.loadU16(index*2)
        if (unit != 32 && unit != 46) {
            val letter=if (unit >= 97 && unit <= 122) unit-32 else unit
            output.store(length,if (fatShortAsciiCharacter(letter)) letter else 95);length=length+1
        }
        if (unit >= 55296 && unit <= 56319) index=index+1
        index=index+1
    }
    if (length == 0) { output.store(0,95);length=1 }
    output.store(length,126);length=length+1
    quotient=u32(sequence);var digit=digits
    while (digit > 0) { digit=digit-1;output.store(length+digit,int(quotient%u32(10))+48);quotient=quotient/u32(10) }
    length=length+digits
    if (dot >= 0) {
        var extension=0;index=dot+1
        while (index < units && extension < 3) {
            val unit=name.loadU16(index*2)
            if (unit != 32 && unit != 46) {
                if (extension == 0) { output.store(length,46);length=length+1 }
                val letter=if (unit >= 97 && unit <= 122) unit-32 else unit
                output.store(length,if (fatShortAsciiCharacter(letter)) letter else 95)
                length=length+1;extension=extension+1
            }
            if (unit >= 55296 && unit <= 56319) index=index+1
            index=index+1
        }
    }
    return length
}
