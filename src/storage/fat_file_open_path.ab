import "./fat_file_handle.ab"
// Root-relative UTF16 path up to4096units/32components,2092B workspace.
// Same handle statuses and lifetime as fatFileOpen. Entire traversal and
// snapshot publication hold one volume gate; no gap between lookup/open.
trusted fun fatFileOpenPathUtf16(storage: NativeBuffer,owner: u32,path: NativeBuffer,units: int,
    budget: int,workspace: NativeBuffer): FatFile = fatFileOpen(storage,owner,0,path,units,budget,workspace,true)
