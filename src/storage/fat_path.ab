import "./fat_lookup.ab"
import "./fat_short_name.ab"
// Root-relative ASCII 8.3 path (optional leading slash), max255bytes and
// 32components; repeated '/' allowed, trailing '/' requires directory.
// '.' is identity, '..' uses the on-disk parent entry (root stays root).
// budget is physical reads PER component, total bounded by32*budget. No LFN,
// Unicode/codepage folding, symlinks or process current-directory state.
// Scratch1536 and name11 are disjoint writable buffers, others immutable.
// FatDirectoryEntry statuses as lookup;15 means intermediate/not-directory.
trusted fun fatLookupPathOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,path: NativeBuffer,length: int,budget: int,name: NativeBuffer,workspace: NativeBuffer): FatDirectoryEntry {
    if (length < 1 || length > 255 || budget < 1 || budget > 1000000 || !path.hasAddressRange(0,length) ||
        !name.hasAddressRange(0,11) || !workspace.hasAddressRange(0,1536) || !reader.hasAddressRange(0,28) ||
        !fatBootValidate(boot,first,sectors).valid() || fatBuffersOverlap(workspace,1536,path,length) ||
        fatBuffersOverlap(workspace,1536,name,11) || fatBuffersOverlap(workspace,1536,boot,512) || fatBuffersOverlap(workspace,1536,reader,28) ||
        fatBuffersOverlap(name,11,path,length) || fatBuffersOverlap(name,11,boot,512) || fatBuffersOverlap(name,11,reader,28)) return FatDirectoryEntry(10<<60)
    val sector=nativeBufferAt(workspace.addressValue()+1024,512)
    val scratch=nativeBufferAt(workspace.addressValue(),1024)
    var entry=FatDirectoryEntry(8<<60)
    var position=0
    var components=0
    while (position < length) {
        if (path.load(position) == 47) {
            if (!entry.isDirectory()) return FatDirectoryEntry(15<<60)
            position=position+1
        } else {
            if (!entry.isDirectory()) return FatDirectoryEntry(15<<60)
            val start=position
            while (position < length && path.load(position) != 47) position=position+1
            components=components+1
            if (components > 32 || !fatShortNameEncode(nativeBufferAt(path.addressValue()+start,position-start),position-start,name)) return FatDirectoryEntry(10<<60)
            val identity=name.load(0) == 46 && name.load(1) == 32
            val rootParent=entry.firstCluster() == 0 && name.load(0) == 46 && name.load(1) == 46
            if (!identity && !rootParent) {
                entry=fatLookupShortOwned(reader,boot,first,sectors,entry.firstCluster(),name,budget,sector,scratch)
                if (!entry.isDirectory() && !entry.isFile()) return entry
            }
        }
    }
    return entry
}
