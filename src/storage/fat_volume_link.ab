import "./fat_volume.ab"
import "./fat_link_write.ab"
// Allocation building block, not a complete allocation/directory transaction.
// Status12busy13stale14fault extend FatLinkWrite statuses. Failed IO faults
// the mount; completed-sector count never means failed sectors are unchanged.
trusted fun FatVolume.replaceLink(owner: u32,cluster: int,expected: int,replacement: int,workspace: NativeBuffer): FatLinkWrite {
    val s=this.storage()
    if (fatBuffersOverlap(s,32,workspace,2048)) return FatLinkWrite(2)
    val admitted=this.begin(owner)
    if (admitted != 0) return FatLinkWrite(admitted)
    val result=fatWriteLinkOwned(nativeBufferAt(s.loadU32(16),28),nativeBufferAt(s.loadU32(20),512),
        s.loadU32(24),s.loadU32(28),cluster,expected,replacement,workspace)
    if (result.status() == 3 || result.status() == 5) s.storeU32(12,3)
    if (!peripheralGateAt(s.addressValue()).finish(owner,true)) return FatLinkWrite(14|(result.completedSectors()<<8))
    return result
}
