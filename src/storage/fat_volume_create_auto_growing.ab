import "./fat_volume.ab"
import "./fat_alias_select.ab"
import "./fat_directory_extend_long.ab"
// Automatic alias selection and up to two-cluster directory expansion under
// one gate.3780B workspace and separate8B/existingcluster chain plan.
trusted fun FatVolume.createLongAutoGrowing(owner: u32,parent: int,name: NativeBuffer,units: int,startAlias: int,
    trials: int,budget: int,modified: RtcDateTime,plan: NativeBuffer,workspace: NativeBuffer,makeDirectory: bool = false): FatFileCreate {
    val s=this.storage()
    if (!workspace.hasAddressRange(0,3780) || !fatLongNameCreateValid(name,units) ||
        !plan.hasAddressRange(0,plan.capacity()) || plan.capacity() < 8 || plan.capacity() > 8000000 ||
        fatBuffersOverlap(s,32,workspace,3780) || fatBuffersOverlap(s,32,name,units*2) ||
        fatBuffersOverlap(s,32,plan,plan.capacity()) || fatBuffersOverlap(plan,plan.capacity(),workspace,3780) ||
        fatBuffersOverlap(plan,plan.capacity(),name,units*2) || fatBuffersOverlap(workspace,3780,name,units*2)) return FatFileCreate(2)
    val admitted=this.begin(owner)
    if (admitted != 0) return FatFileCreate(admitted)
    val reader=nativeBufferAt(s.loadU32(16),28);val boot=nativeBufferAt(s.loadU32(20),512)
    var result=FatFileCreate(2)
    if (!fatBuffersOverlap(workspace,3780,reader,28) && !fatBuffersOverlap(workspace,3780,boot,512) &&
        !fatBuffersOverlap(plan,plan.capacity(),reader,28) && !fatBuffersOverlap(plan,plan.capacity(),boot,512)) {
        val alias=nativeBufferAt(workspace.addressValue()+3768,12)
        val selected=fatSelectLongAliasOwned(reader,boot,s.loadU32(24),s.loadU32(28),parent,name,units,startAlias,trials,budget,
            alias,nativeBufferAt(workspace.addressValue(),2104))
        result=if (selected.status() == 1) fatFileCreateLongGrowingOwned(reader,boot,s.loadU32(24),s.loadU32(28),parent,name,units,
            alias,selected.length(),budget,modified,plan,nativeBufferAt(workspace.addressValue(),3768),makeDirectory)
            else FatFileCreate(if (selected.status() == 7) 20 else selected.status())
    }
    if (result.status() == 4 || result.status() == 8 || result.status() == 21 || (result.status() >= 16 && result.status() <= 19)) s.storeU32(12,3)
    if (!peripheralGateAt(s.addressValue()).finish(owner,true)) return FatFileCreate(14)
    return result
}
