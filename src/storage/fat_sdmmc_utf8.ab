import "./fat_sdmmc.ab"
import "./fat_path_read_utf8.ab"
// Exclude every transport-owned region, not just the reader descriptor.
// In particular conversion/assembly must not overwrite a live DMA bounce,
// card state or read-session record before the first storage read.
trusted fun fatSdMmcBorrowedBufferValid(reader: NativeBuffer,buffer: NativeBuffer,bytes: int): bool {
    if (!fatSdMmcReaderValid(reader) || !buffer.hasAddressRange(0,bytes)) return false
    val card=nativeBufferAt(reader.loadU32(0),80)
    val session=nativeBufferAt(reader.loadU32(4),52)
    val descriptor=nativeBufferAt(reader.loadU32(8),16)
    val bounce=nativeBufferAt(reader.loadU32(12),512)
    var index=0
    while (index < 5) {
        val address=fatSdMmcRegionAddress(reader,card,session,descriptor,bounce,index)
        val size=fatSdMmcRegionSize(index)
        if (!nativeBufferAt(address,size).hasAddressRange(0,size) || !sdMmcReadDisjoint(buffer.addressValue(),bytes,address,size)) return false
        index=index+1
    }
    true
}
// Mounted, initialized native-S3 SDMMC reader; card/host/pads remain owned.
// Same result/budget semantics as fatReadPathUtf8Owned. No implicit drain,
// restart or close: after I/O failure inspect the transport lifecycle and
// explicitly drain pending DMA before releasing or recovering its storage.
trusted fun fatSdMmcReadPathUtf8Owned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,path: NativeBuffer,bytes: int,utf16: NativeBuffer,offset: int,length: int,budget: int,destination: NativeBuffer,workspace: NativeBuffer): int {
    if (bytes < 1 || bytes > 16384 || length < 1 || length > 512 ||
        !fatSdMmcBorrowedBufferValid(reader,boot,512) || !fatSdMmcBorrowedBufferValid(reader,path,bytes) ||
        !fatSdMmcBorrowedBufferValid(reader,utf16,utf16.capacity()) ||
        !fatSdMmcBorrowedBufferValid(reader,destination,length) || !fatSdMmcBorrowedBufferValid(reader,workspace,2067)) return -1
    val session=nativeBufferAt(reader.loadU32(4),52)
    if (session.loadU32(48) != 0) return -1
    fatReadPathUtf8Owned(reader,boot,first,sectors,path,bytes,utf16,offset,length,budget,destination,workspace)
}
