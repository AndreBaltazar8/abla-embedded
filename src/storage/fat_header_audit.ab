import "./fat_read_sequence.ab"
// Read-only reserved entries of the active FAT, under an immutable volume
// gate. Microsoft FAT specification: FAT[0] contains BPB_Media with remaining
// bits set; FAT[1] has all bits set except optional clean/error flags.
// FAT32's upper four bits are ignored. No writes or repair; inactive copies
// are deliberately outside this check (use the separate mirror audit).
type FatHeaderAudit=int
//1valid2input3IO4media/header0 corruption5header1 corruption.
// On success: bit8 flags supported, bit9 clean, bit10 no hard error.
fun FatHeaderAudit.status(): int = this&255
fun FatHeaderAudit.hasFlags(): bool = this.status() == 1 && (this&256) != 0
fun FatHeaderAudit.clean(): bool = this.hasFlags() && (this&512) != 0
fun FatHeaderAudit.noHardError(): bool = this.hasFlags() && (this&1024) != 0
trusted fun fatAuditHeaderOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,scratch: NativeBuffer): FatHeaderAudit {
    val geometry=fatBootValidate(boot,first,sectors)
    if (!geometry.valid() || !reader.hasAddressRange(0,28) || !scratch.hasAddressRange(0,512) ||
        fatBuffersOverlap(scratch,512,reader,28) || fatBuffersOverlap(scratch,512,boot,512)) return FatHeaderAudit(2)
    val media=boot.load(21)
    if (media != 0xf0 && media < 0xf8) return FatHeaderAudit(4)
    val bits=geometry.fatBits()
    val active=if (bits == 32 && (fatBootU16(boot,40)&128) != 0) fatBootU16(boot,40)&15 else 0
    if (!fatStorageReadOwned(reader,first+fatBootU16(boot,14)+active*fatBootFatSectors(boot),scratch)) return FatHeaderAudit(3)
    val mask=if (bits == 12) 0xfff else if (bits == 16) 0xffff else 0xfffffff
    val entry0=(if (bits == 32) fatBootU32(scratch,0) else fatBootU16(scratch,0))&mask
    if (entry0 != ((mask&0xfffff00)|media)) return FatHeaderAudit(4)
    val entry1=if (bits == 12) fatBootU16(scratch,1)>>>4 else if (bits == 16) fatBootU16(scratch,2) else fatBootU32(scratch,4)&mask
    val flags=if (bits == 12) 0 else if (bits == 16) 0xc000 else 0xc000000
    if ((entry1|flags) != mask) return FatHeaderAudit(5)
    if (bits == 12) return FatHeaderAudit(1)
    val clean=if (bits == 16) 0x8000 else 0x8000000
    val noError=clean>>>1
    return FatHeaderAudit(1|256|(if ((entry1&clean) != 0) 512 else 0)|(if ((entry1&noError) != 0) 1024 else 0))
}
