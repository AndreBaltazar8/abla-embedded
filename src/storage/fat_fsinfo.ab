import "./fat_read_sequence.ab"
// Allocation changes invalidate advisory counts BEFORE modifying FAT entries.
// Retain unrelated FSInfo bytes, update primary and configured backup. Bounds
// and all signatures are checked before any write; no guessing sector1/7.
// Explicit FFFF means absent; malformed configured layouts fail closed.
// Status1complete2input/layout3readIO4signature5write-uncertain.
trusted fun fatInvalidateFreeHintsOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,
    workspace: NativeBuffer): int {
    val geometry=fatBootValidate(boot,first,sectors)
    if (!geometry.valid() || !reader.hasAddressRange(0,28) || !workspace.hasAddressRange(0,1024) ||
        fatBuffersOverlap(workspace,1024,reader,28) || fatBuffersOverlap(workspace,1024,boot,512)) return 2
    if (geometry.fatBits() != 32) return 1
    val info=fatBootU16(boot,48);val backup=fatBootU16(boot,50);val reserved=fatBootU16(boot,14)
    if (info == 65535) return 1
    val copies=if (backup == 0 || backup == 65535) 1 else 2
    if (info == 0 || info >= reserved || (copies == 2 &&
        (backup >= reserved || backup == info || backup+info >= reserved))) return 2
    var copy=0
    while (copy < copies) {
        val data=nativeBufferAt(workspace.addressValue()+copy*512,512)
        if (!fatStorageReadOwned(reader,first+info+(if (copy == 0) 0 else backup),data)) return 3
        if (fatBootU32(data,0) != 0x41615252 || fatBootU32(data,484) != 0x61417272 ||
            fatBootU32(data,508) != 0xaa550000) return 4
        data.storeU32(488,0xffffffff);data.storeU32(492,0xffffffff)
        copy=copy+1
    }
    copy=0
    while (copy < copies) {
        if (!fatStorageWriteOwned(reader,first+info+(if (copy == 0) 0 else backup),
            nativeBufferAt(workspace.addressValue()+copy*512,512))) return 5
        copy=copy+1
    }
    return 1
}
