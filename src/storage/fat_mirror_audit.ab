import "./fat_read_sequence.ab"
// Read-only comparison through the last usable cluster, including reserved
// entries0/1 but excluding the unusable reserved-number tail of the data area.
// Ignore FAT32 upper reserved nibbles and unused allocation-table padding;
// for odd FAT12 entry counts the last byte's high nibble is padding too.
// Hold one immutable volume gate for the whole operation. No repair.
type FatMirrorAudit=int
//1matched (or single FAT),2input3IO4mismatch5budget6mirroring disabled.
// First differing byte offset at8..39. Successful physical reads at40..59.
//6 deliberately does not claim that the inactive copy is identical.
fun FatMirrorAudit.status(): int = this&255
fun FatMirrorAudit.offset(): int = (this>>>8)&0xffffffff
fun FatMirrorAudit.reads(): int = if (this.status() == 1) (this>>>40)&0xfffff else 0
trusted fun fatAuditMirrorsOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,budget: int,scratch: NativeBuffer): FatMirrorAudit {
    val geometry=fatBootValidate(boot,first,sectors)
    if (!geometry.valid() || budget < 1 || budget > 1000000 || !reader.hasAddressRange(0,28) || !scratch.hasAddressRange(0,1024) ||
        fatBuffersOverlap(scratch,1024,reader,28) || fatBuffersOverlap(scratch,1024,boot,512)) return FatMirrorAudit(2)
    if (boot.load(16) == 1) return FatMirrorAudit(1)
    if (geometry.fatBits() == 32 && (fatBootU16(boot,40)&128) != 0) return FatMirrorAudit(6)
    val entries=geometry.usableClusters()+2
    val bytes=if (geometry.fatBits() == 12) entries+entries/2+(entries&1) else entries*(if (geometry.fatBits() == 16) 2 else 4)
    val start=first+fatBootU16(boot,14);val length=fatBootFatSectors(boot)
    val a=nativeBufferAt(scratch.addressValue(),512);val b=nativeBufferAt(scratch.addressValue()+512,512)
    var part=0;var remaining=budget
    while (part*512 < bytes) {
        if (remaining < 2) return FatMirrorAudit(5)
        remaining=remaining-2
        if (!fatStorageReadOwned(reader,start+part,a) || !fatStorageReadOwned(reader,start+length+part,b)) return FatMirrorAudit(3)
        var at=0
        while (at < 512 && part*512+at < bytes) {
            val offset=part*512+at
            val mask=if ((geometry.fatBits() == 32 && (offset&3) == 3) ||
                (geometry.fatBits() == 12 && (entries&1) != 0 && offset == bytes-1)) 15 else 255
            if ((a.load(at)&mask) != (b.load(at)&mask)) return FatMirrorAudit(4|(offset<<8))
            at=at+1
        }
        part=part+1
    }
    return FatMirrorAudit(1|((budget-remaining)<<40))
}
