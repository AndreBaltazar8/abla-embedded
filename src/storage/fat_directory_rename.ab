import "./fat_file_rename.ab"
// Rename/move a directory, retaining its cluster chain and all children.
//5864B workspace, existing destination capacity. Reject roots, descendants,
// cyclic/malformed ancestry and name collisions. Same-parent case changes
// use the shared checked rename path. No replacement or crash-atomic
// guarantee. Uncertain publication/dot/unlink faults mount.
trusted fun FatVolume.renameDirectory(owner: u32,parent: int,ordinal: int,index: int,expected: NativeBuffer,
    destination: int,name: NativeBuffer,units: int,start: int,trials: int,budget: int,work: NativeBuffer): FatRename =
    this.renameFile(owner,parent,ordinal,index,expected,destination,name,units,start,trials,budget,work,true)
