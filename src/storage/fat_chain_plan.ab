import "./fat_link_patch.ab"
// Snapshot complete chain into caller-owned8B entries(cluster32,rawlink32).
// Keep volume exclusively owned from planning through mutation. No allocation
// or writes to media. Reject cycles/truncation/budget/capacity before mutation.
type FatChainPlan=int
//1complete2input3IO4chain5budget6capacity; count20@8.
fun FatChainPlan.status(): int = this&255
fun FatChainPlan.count(): int = (this>>8)&0xfffff
trusted fun fatPlanChainOwned(reader: NativeBuffer,boot: NativeBuffer,first: int,sectors: int,head: int,
    budget: int,plan: NativeBuffer,scratch: NativeBuffer): FatChainPlan {
    val geometry=fatBootValidate(boot,first,sectors)
    if (!geometry.valid() || budget < 1 || budget > 1000000 || !reader.hasAddressRange(0,28) ||
        !plan.hasAddressRange(0,plan.capacity()) || plan.capacity() < 8 || plan.capacity() > 8000000 ||
        !scratch.hasAddressRange(0,1024) || fatBuffersOverlap(plan,plan.capacity(),reader,28) ||
        fatBuffersOverlap(plan,plan.capacity(),boot,512) || fatBuffersOverlap(plan,plan.capacity(),scratch,1024) ||
        fatBuffersOverlap(scratch,1024,reader,28) || fatBuffersOverlap(scratch,1024,boot,512)) return FatChainPlan(2)
    var cluster=head;var count=0;var remaining=budget
    var anchor=head;var distance=0;var power=1
    while (cluster != 0) {
        val location=fatLinkLocate(boot,first,sectors,cluster)
        if (!location.valid() || count >= geometry.clusters()) return FatChainPlan(4)
        if (count >= plan.capacity()/8) return FatChainPlan(6)
        val cost=if (location.needsSecondSector()) 2 else 1
        if (remaining < cost) return FatChainPlan(5)
        remaining=remaining-cost
        val link=fatReadLinkOwned(reader,boot,first,sectors,cluster,scratch)
        if (link.status() == 8) return FatChainPlan(3)
        if (link.status() != 1 && link.status() != 2) return FatChainPlan(4)
        plan.storeU32(count*8,cluster)
        plan.storeU32(count*8+4,fatLinkRaw(location,nativeBufferAt(scratch.addressValue(),512),nativeBufferAt(scratch.addressValue()+512,512)))
        count=count+1
        if (link.status() == 2) return FatChainPlan(1|(count<<8))
        cluster=link.nextCluster();distance=distance+1
        if (cluster == anchor) return FatChainPlan(4)
        if (distance == power) { anchor=cluster;power=power*2;distance=0 }
    }
    return FatChainPlan(1)
}
