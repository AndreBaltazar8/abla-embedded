import "../esp32/sdk/raw_buffer.ab"
// Read-only FAT12/16/32 boot geometry for 512-byte SD sectors.
// Validation follows FatFs ff.c mount_volume in IDF6, including its practical
// <=0xFF5/<=0xFFF5 cluster-type boundaries (different from normative cutoffs).
// Buffer must remain immutable and readable; this parses bytes, not a mount.
// No exFAT/GPT, allocation, filesystem writes or trust in the FAT type label.
type FatBootGeometry = int
// bits0..27 cluster count,28..30 sectors/cluster log2,31..32 type1/2/3.
fun FatBootGeometry.valid(): bool = ((this>>31)&3) != 0
fun FatBootGeometry.clusters(): int = if (this.valid()) this&0xfffffff else 0
// FatFs type cutoffs can include a short tail of reserved cluster numbers.
// Geometry still describes the data area; allocation scans must exclude IDs
// at/above FF0/FFF0/0FFFFFF0, leaving cluster2 as the first usable ID.
fun FatBootGeometry.usableClusters(): int {
    if (!this.valid()) return 0
    val limit=if (this.fatBits() == 12) 4078 else if (this.fatBits() == 16) 65518 else 268435438
    return if (this.clusters() < limit) this.clusters() else limit
}
fun FatBootGeometry.fatBits(): int = if (!this.valid()) 0 else if (((this>>31)&3) == 1) 12 else if (((this>>31)&3) == 2) 16 else 32
fun FatBootGeometry.sectorsPerCluster(): int = if (this.valid()) 1<<((this>>28)&7) else 0
trusted fun fatBootU16(boot: NativeBuffer,offset: int): int = boot.load(offset)|(boot.load(offset+1)<<8)
trusted fun fatBootU32(boot: NativeBuffer,offset: int): int = fatBootU16(boot,offset)|(fatBootU16(boot,offset+2)<<16)
trusted fun fatBootTotalSectors(boot: NativeBuffer): int = if (fatBootU16(boot,19) != 0) fatBootU16(boot,19) else fatBootU32(boot,32)
trusted fun fatBootFatSectors(boot: NativeBuffer): int = if (fatBootU16(boot,22) != 0) fatBootU16(boot,22) else fatBootU32(boot,36)
trusted fun fatBootDataOffset(boot: NativeBuffer): int = fatBootU16(boot,14)+boot.load(16)*fatBootFatSectors(boot)+(fatBootU16(boot,17)>>4)
// firstSector and availableSectors are validated partition/card bounds, not
// inferred from untrusted BPB hidden-sectors. Invalid geometry is scalar zero.
trusted fun fatBootValidate(boot: NativeBuffer,firstSector: int,availableSectors: int): FatBootGeometry {
    if (!boot.hasAddressRange(0,512) || firstSector < 0 || firstSector > 4294967295 || availableSectors < 1 || availableSectors > 4294967296-firstSector) return FatBootGeometry(0)
    if (fatBootU16(boot,510) != 0xaa55 || fatBootU16(boot,11) != 512) return FatBootGeometry(0)
    val size=boot.load(13)
    val fats=boot.load(16)
    val reserved=fatBootU16(boot,14)
    val roots=fatBootU16(boot,17)
    if (size == 0 || size > 128 || (size&(size-1)) != 0 || (fats != 1 && fats != 2) || reserved == 0 || (roots&15) != 0) return FatBootGeometry(0)
    val total=fatBootTotalSectors(boot)
    val fatSize=fatBootFatSectors(boot)
    val overhead=fatBootDataOffset(boot)
    if (total > availableSectors || total <= overhead || fatSize == 0) return FatBootGeometry(0)
    var clusters=total-overhead
    var divisor=size
    var shift=0
    while (divisor > 1) { clusters=clusters>>1; divisor=divisor>>1; shift=shift+1 }
    if (clusters < 1 || clusters > 0x0ffffff5) return FatBootGeometry(0)
    val kind=if (clusters <= 0xff5) 1 else if (clusters <= 0xfff5) 2 else 3
    val entries=clusters+2
    val required=if (kind == 1) (entries*3+1)>>1 else if (kind == 2) entries*2 else entries*4
    if (fatSize*512 < required) return FatBootGeometry(0)
    if (kind == 3) {
        val root=fatBootU32(boot,44)
        val flags=fatBootU16(boot,40)
        if (roots != 0 || fatBootU16(boot,22) != 0 || fatBootU16(boot,42) != 0 || root < 2 || root >= entries || root >= 0x0ffffff0) return FatBootGeometry(0)
        if ((flags&128) != 0 && (flags&15) >= fats) return FatBootGeometry(0)
    } else if (roots == 0 || fatBootU16(boot,22) == 0) return FatBootGeometry(0)
    return FatBootGeometry(clusters|(shift<<28)|(kind<<31))
}
// Validated cluster address, never beyond the declared partition. -1 rejects
// free/reserved/bad/EOC IDs; these are not physical data cluster addresses.
trusted fun fatClusterFirstSector(boot: NativeBuffer,firstSector: int,availableSectors: int,cluster: int): int {
    val geometry=fatBootValidate(boot,firstSector,availableSectors)
    if (!geometry.valid() || cluster < 2 || cluster >= geometry.clusters()+2) return -1
    val limit=if (geometry.fatBits() == 12) 0xff0 else if (geometry.fatBits() == 16) 0xfff0 else 0x0ffffff0
    if (cluster >= limit) return -1
    return firstSector+fatBootDataOffset(boot)+(cluster-2)*geometry.sectorsPerCluster()
}
