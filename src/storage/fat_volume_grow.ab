import "./fat_volume.ab"
import "./fat_file_grow.ab"
trusted fun FatVolume.grow(owner: u32,parent: int,ordinal: int,entry: int,expected: NativeBuffer,
    newSize: int,budget: int,modified: RtcDateTime,workspace: NativeBuffer): FatFileGrow {
    val s=this.storage()
    if (fatBuffersOverlap(s,32,workspace,2560) || fatBuffersOverlap(s,32,expected,32)) return FatFileGrow(2)
    val admitted=this.begin(owner)
    if (admitted != 0) return FatFileGrow(admitted)
    val result=fatFileGrowOwned(nativeBufferAt(s.loadU32(16),28),nativeBufferAt(s.loadU32(20),512),s.loadU32(24),s.loadU32(28),
        parent,ordinal,entry,expected,newSize,budget,modified,workspace)
    // Conservative quarantine, including failures after old-tail zeroing.
    if (result.status() >= 4 && result.status() <= 10) s.storeU32(12,3)
    if (!peripheralGateAt(s.addressValue()).finish(owner,true)) return FatFileGrow(14)
    return result
}
