import "./fat_remove_plan.ab"
import "./fat_long_name_encode.ab"
import "./fat_unicode_upper.ab"
import "./fat_short_name.ab"
// ASCII8.3 case flags independently represent all-upper/all-lower base and
// extension. Mixed case returns21 to request LFN promotion after verifying
// canonical alias equality. Preserve unrelated metadata, including reserved flags.
trusted fun fatRenameShortCaseOwned(reader: NativeBuffer,planned: FatRemovalPlan,staged: NativeBuffer,
    expected: NativeBuffer,name: NativeBuffer,units: int,scratch: NativeBuffer): int {
    val alias=nativeBufferAt(scratch.addressValue(),11)
    if (!fatShortNameEncodeUtf16(name,units,alias)) return 0
    var i=0;while (i < 11) { if (alias.load(i) != expected.load(i)) return 0;i=i+1 }
    var lower=0;var upper=0;var mask=8;i=0
    while (i < units) {
        val ch=name.loadU16(i*2)
        if (ch == 46) mask=16
        else if (ch >= 97 && ch <= 122) lower=lower|mask
        else if (ch >= 65 && ch <= 90) upper=upper|mask
        i=i+1
    }
    if ((lower&upper) != 0) return 21
    val flags=(expected.load(12)&~24)|lower
    if (flags == expected.load(12)) return 1
    staged.store(planned.lastSlot()*32+12,flags)
    val part=planned.lastSlot()>>4
    if (!fatStorageWriteOwned(reader,staged.loadU32(1536+part*4),nativeBufferAt(staged.addressValue()+part*512,512))) return 15
    return 1
}
// Internal checked-rename step: buffers and ownership supplied by rename.
//0not a supported case change,1done,15uncertain write,21short-name LFN promotion. Exact spelling is
// a no-op. Case equivalence uses the same pinned Unicode mapping as lookup.
// Existing LFNs preserve SFN/checksum/metadata; short names update only case flags.
// Partial failures may leave mixed old/new casing, so caller faults the mount.
trusted fun fatRenameLongCaseOwned(reader: NativeBuffer,planned: FatRemovalPlan,staged: NativeBuffer,
    expected: NativeBuffer,name: NativeBuffer,units: int,scratch: NativeBuffer): int {
    val count=planned.lastSlot()-planned.firstSlot()
    if (count == 0) return fatRenameShortCaseOwned(reader,planned,staged,expected,name,units,scratch)
    val assembled=nativeBufferAt(scratch.addressValue()+1024,520)
    var state=FatLongName(0);var slot=planned.firstSlot()
    while (slot < planned.lastSlot()) {
        state=state.consume(nativeBufferAt(staged.addressValue()+slot*32,32),assembled);slot=slot+1
    }
    if (!state.matches(expected,assembled) || state.length() != units) return 0
    var same=true;var i=0
    while (i < units) {
        val old=assembled.loadU16(i*2);val next=name.loadU16(i*2)
        if (fatUnicodeUpper(old) != fatUnicodeUpper(next)) return 0
        if (old != next) same=false
        i=i+1
    }
    if (same) return 1
    val encoded=nativeBufferAt(scratch.addressValue(),640)
    if (fatLongNameEncodeEntries(name,units,nativeBufferAt(expected.addressValue(),11),encoded) != count) return 0
    i=0;while (i < count*32) { staged.store(planned.firstSlot()*32+i,encoded.load(i));i=i+1 }
    var part=(planned.lastSlot()-1)>>4
    while (part >= (planned.firstSlot()>>4)) {
        if (!fatStorageWriteOwned(reader,staged.loadU32(1536+part*4),nativeBufferAt(staged.addressValue()+part*512,512))) return 15
        part=part-1
    }
    return 1
}
