import "./fat_sdmmc_core.ab"
import "../hal/storage.ab"
@export("fatStorageReadOwned")
trusted fun fatStorageReadOwnedHook(reader: NativeBuffer,sector: int,destination: NativeBuffer): bool {
    if (!fatSdMmcReaderValid(reader)) return false
    return fatSdMmcReadCardOwned(reader,nativeBufferAt(reader.loadU32(0),80),sector,destination)
}
