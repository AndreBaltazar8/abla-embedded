import "./touch_controller.ab"
import "../esp32/sdk/raw_buffer.ab"

// A caller-owned frame stores up to five packed controller TouchPoint values,
// little-endian, eight bytes each. Byte access also permits unaligned frames.
trusted fun controllerFramePoint(points: NativeBuffer,index: int): TouchPoint {
    var low=u32(0)
    var high=u32(0)
    var byte=0
    while (byte < 4) {
        val shift=u32(byte*8)
        low=low | (u32(points.load(index*8+byte)) << shift)
        high=high | (u32(points.load(index*8+byte+4)) << shift)
        byte=byte+1
    }
    TouchPoint(int(low)|(int(high)<<32))
}

// Caller serializes the tracker and frame for this whole operation. Returns
// visible detail count, or -1 for an invalid frame/overlap. A failed hardware
// read must not be passed as an empty frame: only a real empty frame releases
// missing contacts. The existing <=4ms tracker throttling remains unchanged.
trusted fun TouchTracker.updateControllerFrame(
    points: NativeBuffer,count: int,nowMilliseconds: int
): int {
    if (this <= 0 || this > 4294967296-touchTrackerBytes ||
        count < 0 || count > touchMaximumPoints ||
        !points.hasAddressRange(0,count*8)) return -1
    if (count != 0 && points.addressValue() < this+touchTrackerBytes &&
        this < points.addressValue()+count*8) return -1
    var seen=0
    var index=0
    while (index < count) {
        val point=controllerFramePoint(points,index)
        if (!point.valid() || point.id() >= touchMaximumPoints || point.event() == 3 ||
            point.x() > 32767 || point.y() > 32767) return -1
        val bit=int(u32(1) << u32(point.id()))
        if ((seen & bit) != 0) return -1
        seen=seen | bit
        index=index+1
    }
    if (!this.startUpdate(nowMilliseconds)) return this.getCount()
    index=0
    while (index < count) {
        val point=controllerFramePoint(points,index)
        if (point.event() != 1) this.updatePoint(point.gesturePoint())
        index=index+1
    }
    this.finishUpdate()
}
