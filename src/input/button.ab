// A complete debounced button state in one 64-bit scalar. Updating is pure:
// applications keep the returned value wherever their state already lives.
// This avoids a heap object, hidden registry, or one global slot per button.
type ButtonState = int

// Twenty-two modulo-millisecond bits give a 69.9 minute update interval.
// Firmware buttons are polled continuously; reserving the otherwise-unused
// bits 22-30 lets a platform button add its pin and polarity without growing
// beyond one machine word.
val buttonTimeMask = 4194303
val buttonDurationMask = 32767
val buttonRawDurationMask = 127
val buttonClickCountMask = 7
val buttonStableMask = 72057594037927936
val buttonRawMask = 144115188075855872
val buttonModeMask = 288230376151711744
val buttonPressedEventMask = 576460752303423488
val buttonReleasedEventMask = 1152921504606846976
val buttonClickedEventMask = 2305843009213693952
val buttonHoldEventMask = 4611686018427387904

fun buttonLimit(value: int, maximum: int): int =
    if (value > maximum) maximum else value

fun packButtonState(
    time: int,
    duration: int,
    rawDuration: int,
    clickCount: int,
    stable: bool,
    raw: bool,
    mode: bool,
    pressedEvent: bool,
    releasedEvent: bool,
    clickedEvent: bool,
    holdEvent: bool
): ButtonState = ButtonState(
    (time & buttonTimeMask) |
    ((duration & buttonDurationMask) << 31) |
    ((rawDuration & buttonRawDurationMask) << 46) |
    ((clickCount & buttonClickCountMask) << 53) |
    (if (stable) buttonStableMask else 0) |
    (if (raw) buttonRawMask else 0) |
    (if (mode) buttonModeMask else 0) |
    (if (pressedEvent) buttonPressedEventMask else 0) |
    (if (releasedEvent) buttonReleasedEventMask else 0) |
    (if (clickedEvent) buttonClickedEventMask else 0) |
    (if (holdEvent) buttonHoldEventMask else 0)
)

fun buttonState(pressed: bool = false, nowMilliseconds: int = 0): ButtonState =
    packButtonState(
        nowMilliseconds, 0, 0, 0, pressed, pressed, false,
        false, false, false, false
    )

fun ButtonState.lastUpdateMilliseconds(): int = this & buttonTimeMask
fun ButtonState.durationMilliseconds(): int = (this >>> 31) & buttonDurationMask
fun ButtonState.rawDurationMilliseconds(): int =
    (this >>> 46) & buttonRawDurationMask
fun ButtonState.getClickCount(): int = (this >>> 53) & buttonClickCountMask
fun ButtonState.isPressed(): bool = (this & buttonStableMask) != 0
fun ButtonState.isReleased(): bool = !this.isPressed()
fun ButtonState.rawPressed(): bool = (this & buttonRawMask) != 0
fun ButtonState.isHolding(): bool =
    this.isPressed() && (this & buttonModeMask) != 0
fun ButtonState.wasDecideClickCount(): bool =
    this.isReleased() && (this & buttonModeMask) != 0
fun ButtonState.wasPressed(): bool = (this & buttonPressedEventMask) != 0
fun ButtonState.wasReleased(): bool = (this & buttonReleasedEventMask) != 0
fun ButtonState.wasClicked(): bool = (this & buttonClickedEventMask) != 0
fun ButtonState.wasHold(): bool = (this & buttonHoldEventMask) != 0
fun ButtonState.wasSingleClicked(): bool =
    this.wasDecideClickCount() && this.getClickCount() == 1
fun ButtonState.wasDoubleClicked(): bool =
    this.wasDecideClickCount() && this.getClickCount() == 2
fun ButtonState.pressedFor(milliseconds: int): bool =
    this.isPressed() && this.durationMilliseconds() >= milliseconds
fun ButtonState.releasedFor(milliseconds: int): bool =
    this.isReleased() && this.durationMilliseconds() >= milliseconds

fun buttonElapsed(now: int, previous: int): int {
    val currentTime = now & buttonTimeMask
    if (currentTime >= previous) currentTime - previous
    else buttonTimeMask + 1 - previous + currentTime
}

fun ButtonState.update(
    pressed: bool,
    nowMilliseconds: int,
    debounceMilliseconds: int = 10,
    holdMilliseconds: int = 500,
    clickDecisionMilliseconds: int = 250
): ButtonState {
    val now = nowMilliseconds & buttonTimeMask
    val elapsed = buttonElapsed(now, this.lastUpdateMilliseconds())
    var stable = this.isPressed()
    var raw = this.rawPressed()
    var mode = (this & buttonModeMask) != 0
    var duration = buttonLimit(
        this.durationMilliseconds() + elapsed, buttonDurationMask
    )
    var rawDuration = this.rawDurationMilliseconds()
    var clicks = this.getClickCount()
    var pressedEvent = false
    var releasedEvent = false
    var clickedEvent = false
    var holdEvent = false

    // A decided click count is visible for exactly one update.
    if (!stable && mode) {
        mode = false
        clicks = 0
    }

    if (pressed == raw) {
        rawDuration = buttonLimit(
            rawDuration + elapsed, buttonRawDurationMask
        )
    } else {
        raw = pressed
        rawDuration = 0
    }

    if (raw != stable && rawDuration >= debounceMilliseconds) {
        stable = raw
        duration = 0
        mode = false
        if (stable) pressedEvent = true
        else {
            releasedEvent = true
            if (this.isHolding()) clicks = 0
            else {
                clicks = buttonLimit(clicks + 1, buttonClickCountMask)
                clickedEvent = true
            }
        }
    }

    if (stable && !mode && duration >= holdMilliseconds) {
        mode = true
        clicks = 0
        holdEvent = true
    }
    if (!stable && !raw && !mode && clicks > 0 &&
        duration >= clickDecisionMilliseconds) mode = true

    packButtonState(
        now, duration, rawDuration, clicks, stable, raw, mode,
        pressedEvent, releasedEvent, clickedEvent, holdEvent
    )
}
