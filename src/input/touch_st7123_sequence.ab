import "./touch10.ab"
import "../touch/st7123_sequence.ab"
import "../touch/transform.ab"
// Caller owns initialized controller,344B tracker,72B snapshot and80B frame.
// All storage disjoint, validated before I/O. Returns accepted report count,
// -1 arguments/read, -2 no coordinates, -4 malformed geometry, -5 throttle.
trusted fun TouchTracker10.updateSt7123Owned(handle: int,snapshot: NativeBuffer,frame: NativeBuffer,
    now: int,width: int,height: int,rotation: int): int {
    if (!this.valid() || handle <= 0 || handle > 4294967295 ||
        !snapshot.hasAddressRange(0,72) || !frame.hasAddressRange(0,80) ||
        width < 1 || width > 32768 || height < 1 || height > 32768 || rotation < 0 || rotation > 7) return -1
    val a=snapshot.addressValue()
    val b=frame.addressValue()
    if ((a < b+80 && b < a+72) || (a < this+344 && this < a+72) || (b < this+344 && this < b+80)) return -1
    if (touchElapsedMilliseconds(now,this.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) {
        this.advanceWithoutReport(now)
        return -5
    }
    val count=st7123ReadOwned(handle,snapshot)
    if (count == -2) { this.advanceWithoutReport(now); return -2 }
    if (count < 0) return count
    var index=0
    while (index < count) {
        val point=st7123Point(snapshot,index).forLcdRotation(width,height,rotation)
        if (!point.valid()) return -4
        val low=u32(point&4294967295)
        val high=u32(point>>>32)
        var byte=0
        while (byte < 4) {
            val shift=u32(byte*8)
            frame.store(index*8+byte,int((low>>>shift)&u32(255)))
            frame.store(index*8+byte+4,int((high>>>shift)&u32(255)))
            byte=byte+1
        }
        index=index+1
    }
    val result=this.updateControllerFrame(frame,count,now)
    if (result < 0) return if (result == -2) -5 else -4
    count
}
