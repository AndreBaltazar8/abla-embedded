import "./touch_cst816s_sequence.ab"
import "../touch/cst816s_session.ab"
trusted fun Cst816sSession.pollTracker(tracker: TouchTracker,snapshot: NativeBuffer,
    now: int,width: int,height: int,rotation: int = 0): Cst816sSession =
    this.pollTrackerOwned(tracker,snapshot,now,width,height,rotation)
