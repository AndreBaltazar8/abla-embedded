// Default ESP-IDF touch-v1 software IIR: keep the separate truncations.
// This is NOT (previous+sample)/2: odd values differ, and the sum can overflow.
// A zero previous output bootstraps directly from the next sample, even after
// earlier scans. Input and output use the full unsigned32-bit domain.
fun capacitiveIirHalf(previous: u32,sample: u32): u32 =
    if (previous == u32(0)) sample else previous-(previous>>u32(1))+(sample>>u32(1))

// Raw ESP32 measurements fit16 bits; filter history and threshold transitions
// therefore fit one32-bit scalar. Fresh state0 matches IDF's zero history and
// initially inactive channel. Caller schedules updates (default IDF10ms) only
// on completed scans; this API never starts a timer or polls hardware.
type CapacitiveTouchFilter = int
fun CapacitiveTouchFilter.value(): int = this&65535
fun CapacitiveTouchFilter.active(): bool = (this&65536) != 0
fun CapacitiveTouchFilter.justActivated(): bool = (this&131072) != 0
fun CapacitiveTouchFilter.justDeactivated(): bool = (this&262144) != 0
fun CapacitiveTouchFilter.accepted(): bool = (this&524288) != 0
// Invalid input preserves history/active state but clears acceptance and edge
// flags, so a failed measurement cannot create or replay an input event.
// Below uses < threshold. Above uses >= threshold, including exact equality.
fun CapacitiveTouchFilter.update(sample: int,threshold: int,below: bool = true): CapacitiveTouchFilter {
    if (this < 0 || this > 1048575 || sample < 0 || sample > 65535 || threshold < 0 || threshold > 65535) return CapacitiveTouchFilter(this&131071)
    val filtered=int(capacitiveIirHalf(u32(this.value()),u32(sample)))
    val active=if (below) filtered < threshold else filtered >= threshold
    val changed=active != this.active()
    CapacitiveTouchFilter(filtered|524288|(if (active) 65536 else 0)|
        (if (changed && active) 131072 else 0)|(if (changed && !active) 262144 else 0))
}
