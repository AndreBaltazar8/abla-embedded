import "./touch_controller.ab"
import "../touch/cst816s_session_sequence.ab"
import "../touch/transform.ab"
// Caller owns session, tracker and disjoint six-byte scratch throughout.
// Return updated session; only fresh() means a report reached the tracker.
// A transport/init failure preserves contacts and does not synthesize release.
trusted fun Cst816sSession.pollTrackerOwned(tracker: TouchTracker,snapshot: NativeBuffer,
    now: int,width: int,height: int,rotation: int): Cst816sSession {
    if (this.handle() == 0 || this.status() == 6) return this
    val base=this&~(7<<33)
    if (tracker <= 0 || tracker > 4294967296-touchTrackerBytes ||
        !snapshot.hasAddressRange(0,6) || width < 1 || width > 32768 ||
        height < 1 || height > 32768 || rotation < 0 || rotation > 7)
        return Cst816sSession(base|(3<<33))
    val address=snapshot.addressValue()
    if (address < tracker+touchTrackerBytes && tracker < address+6) return Cst816sSession(base|(3<<33))
    if (touchElapsedMilliseconds(now,tracker.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) {
        tracker.advanceWithoutReport(now)
        return Cst816sSession(base|(5<<33))
    }
    val next=this.pollOwned(snapshot,now)
    if (!next.fresh()) {
        if (next.status() == 5) tracker.advanceWithoutReport(now)
        return next
    }
    val point=if (next.reportCount() == 1) cst816sPoint(snapshot).forLcdRotation(width,height,rotation) else TouchPoint(0)
    if (next.reportCount() == 1 && !point.valid()) return Cst816sSession((next&~(7<<33))|(4<<33))
    if (!tracker.startUpdate(now)) return Cst816sSession((next&~(7<<33))|(5<<33))
    if (next.reportCount() == 1) tracker.updatePoint(point.gesturePoint())
    tracker.finishUpdate()
    next
}
