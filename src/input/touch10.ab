import "./touch_frame.ab"
// Separate344B arena: ten unchanged32B TouchDetails then six32bit fields.
// Existing TouchTracker stays184B; callers with five contacts pay no increase.
type TouchTracker10 = int
val touchTracker10Bytes=344
trusted fun touchTracker10At(buffer: NativeBuffer,hold: int = 500,flick: int = 8): TouchTracker10 {
    if (!buffer.hasAddressRange(0,344) || (buffer.addressValue()&3) != 0) return TouchTracker10(0)
    val address=buffer.addressValue()
    ablaUnsafeSetMemory(nativePointerFromAddress(address),0,344)
    touchStore32(address,336,touchThreshold(hold))
    touchStore32(address,340,touchThreshold(flick))
    TouchTracker10(address)
}
fun TouchTracker10.valid(): bool = this > 0 && this <= 4294967296-344 && (this&3) == 0
trusted fun TouchTracker10.detail(id: int): TouchDetail = TouchDetail(this+(if (id >= 0 && id < 10) id else 0)*32)
trusted fun TouchTracker10.getCount(): int = touchLoad32(this | 0,320)
trusted fun TouchTracker10.lastMilliseconds(): int = touchLoad32(this | 0,324)
trusted fun TouchTracker10.updatedMask(): int = touchLoad32(this | 0,332)
trusted fun TouchTracker10.advanceWithoutReport(now: int): int {
    if (!this.valid()) return -1
    touchStore32(this | 0,328,now)
    var visible=0
    var id=0
    while (id < 10) {
        if (this.detail(id).advance(now,touchLoad32(this | 0,336))) visible=visible+1
        id=id+1
    }
    touchStore32(this | 0,320,visible)
    visible
}
// Packed controller points, up to80B; preserve sparse IDs0..9, reject
// duplicate/malformed reports atomically. Returns visible count or -1 invalid,
// -2 throttled. Failed hardware reads must never be supplied as count0.
trusted fun TouchTracker10.updateControllerFrame(points: NativeBuffer,count: int,now: int): int {
    if (!this.valid() || count < 0 || count > 10 || !points.hasAddressRange(0,count*8)) return -1
    val address=points.addressValue()
    if (count > 0 && address < this+344 && this < address+count*8) return -1
    var seen=u32(0)
    var index=0
    while (index < count) {
        val point=controllerFramePoint(points,index)
        if (!point.valid() || point.id() >= 10 || point.event() == 3 || point.x() > 32767 || point.y() > 32767) return -1
        val bit=u32(1)<<u32(point.id())
        if ((seen&bit) != u32(0)) return -1
        seen=seen|bit
        index=index+1
    }
    if (touchElapsedMilliseconds(now,this.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) {
        this.advanceWithoutReport(now)
        return -2
    }
    touchStore32(this | 0,324,now); touchStore32(this | 0,328,now)
    val hold=touchLoad32(this | 0,336)
    val flick=touchLoad32(this | 0,340)
    var active=u32(0)
    index=0
    while (index < count) {
        val point=controllerFramePoint(points,index)
        if (point.event() != 1) {
            active=active|(u32(1)<<u32(point.id()))
            this.detail(point.id()).update(now,true,gesturePoint(point.x(),point.y(),point.size(),point.id()),hold,flick)
        }
        index=index+1
    }
    var visible=0
    var id=0
    while (id < 10) {
        if ((active&(u32(1)<<u32(id))) != u32(0)) visible=visible+1
        else if (this.detail(id).update(now,false,GesturePoint(0),hold,flick)) visible=visible+1
        id=id+1
    }
    touchStore32(this | 0,332,int(active)); touchStore32(this | 0,320,visible)
    visible
}
