import "./touch_frame.ab"
import "../touch/ft5x06_snapshot.ab"
import "../touch/transform.ab"

// Consume only a successfully acquired/acknowledged report. The caller owns
// tracker, snapshot and frame throughout. Invalid reports never alter tracker.
// Returns visible count, -1 invalid storage/geometry, -4 malformed report.
trusted fun TouchTracker.updateFt5x06Snapshot(
    snapshot: NativeBuffer,frame: NativeBuffer,count: int,
    nowMilliseconds: int,width: int,height: int,rotation: int
): int {
    if (this <= 0 || this > 4294967296-touchTrackerBytes ||
        width < 1 || width > 32768 || height < 1 || height > 32768 ||
        rotation < 0 || rotation > 7 || !snapshot.hasAddressRange(0,29) ||
        !frame.hasAddressRange(0,40)) return -1
    val a=snapshot.addressValue()
    val b=frame.addressValue()
    if ((a < b+40 && b < a+29) ||
        (a < this+touchTrackerBytes && this < a+29) ||
        (b < this+touchTrackerBytes && this < b+40)) return -1
    if (count < 0 || count > touchMaximumPoints) return -4
    var index=0
    while (index < count) {
        val point=ft5x06SnapshotPoint(snapshot,count,index).forLcdRotation(width,height,rotation)
        var byte=0
        while (byte < 8) {
            frame.store(index*8+byte,(point >>> (byte*8)) & 255)
            byte=byte+1
        }
        index=index+1
    }
    val result=this.updateControllerFrame(frame,count,nowMilliseconds)
    if (result < 0) -4 else result
}
