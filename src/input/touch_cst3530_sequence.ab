import "./touch_controller.ab"
import "../touch/cst3530_sequence.ab"
import "../touch/transform.ab"
// Caller owns initialized controller, tracker and disjoint154B snapshot.
// Returns accepted report count0..5; -1 arguments/read, -2 ack failure,
// -4 geometry/malformed contact, -5 throttled (no new report).
// Validate ALL transformed contacts before mutating tracker. No frame buffer
// or allocation: decode twice from the owned stable snapshot.
trusted fun TouchTracker.updateCst3530Owned(handle: int,snapshot: NativeBuffer,
    now: int,width: int,height: int,rotation: int): int {
    if (handle <= 0 || handle > 4294967295 || this <= 0 || this > 4294967296-touchTrackerBytes ||
        !snapshot.hasAddressRange(0,154) || width < 1 || width > 32768 || height < 1 || height > 32768 ||
        rotation < 0 || rotation > 7) return -1
    val address=snapshot.addressValue()
    if (address < this+touchTrackerBytes && this < address+154) return -1
    if (touchElapsedMilliseconds(now,this.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) {
        this.advanceWithoutReport(now)
        return -5
    }
    val count=cst3530ReadOwned(handle,snapshot)
    if (count < 0) return count
    var index=0
    while (index < count) {
        if (!cst3530Point(snapshot,count,index).forLcdRotation(width,height,rotation).valid()) return -4
        index=index+1
    }
    if (!this.startUpdate(now)) return -5
    index=0
    while (index < count) {
        this.updatePoint(cst3530Point(snapshot,count,index).forLcdRotation(width,height,rotation).gesturePoint())
        index=index+1
    }
    this.finishUpdate()
    count
}
