import "./touch_frame.ab"
import "../touch/gt911_snapshot.ab"
import "../touch/transform.ab"

// Caller owns initialized I2C/controller and disjoint tracker/40B/40B storage.
// Returns visible count, -1 invalid arguments, -2 I/O or acknowledgment error,
// -4 malformed report. Not-ready advances gesture time without releasing any
// contact or advancing the last actual-report timestamp. Only an acknowledged
// empty report releases contacts; I/O failures leave tracker state untouched.
trusted fun TouchTracker.updateGt911(
    touch: Gt911,snapshot: NativeBuffer,frame: NativeBuffer,
    nowMilliseconds: int,width: int,height: int,rotation: int
): int {
    if (!touch.valid() || this <= 0 || this > 4294967296-touchTrackerBytes ||
        width < 1 || width > 32768 || height < 1 || height > 32768 ||
        rotation < 0 || rotation > 7 || !snapshot.hasAddressRange(0,40) ||
        !frame.hasAddressRange(0,40)) return -1
    val a=snapshot.addressValue()
    val b=frame.addressValue()
    if ((a < b+40 && b < a+40) ||
        (a < this+touchTrackerBytes && this < a+40) ||
        (b < this+touchTrackerBytes && this < b+40)) return -1
    if (touchElapsedMilliseconds(nowMilliseconds,this.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) {
        return this.advanceWithoutReport(nowMilliseconds)
    }
    val count=touch.readFrame(snapshot)
    if (count == -2) return this.advanceWithoutReport(nowMilliseconds)
    if (count == -1) return -2
    if (count < 0 || count > touchMaximumPoints) return -4
    var index=0
    while (index < count) {
        val point=gt911FramePoint(snapshot,count,index).forLcdRotation(width,height,rotation)
        var byte=0
        while (byte < 8) {
            frame.store(index*8+byte,(point >>> (byte*8)) & 255)
            byte=byte+1
        }
        index=index+1
    }
    val result=this.updateControllerFrame(frame,count,nowMilliseconds)
    if (result < 0) -4 else result
}
