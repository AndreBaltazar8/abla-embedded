import "./touch_cst3530_sequence.ab"
import "../touch/cst3530_device.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../esp32/sdk/nativebuffer_type.ab"
trusted fun TouchTracker.updateCst3530(touch: Cst3530,snapshot: NativeBuffer,
    now: int,width: int,height: int,rotation: int = 0): int =
    this.updateCst3530Owned(touch | 0,snapshot,now,width,height,rotation)
