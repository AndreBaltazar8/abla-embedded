import "./touch.ab"
import "../touch/point.ab"

// Convert an already transformed controller point into the tracker's signed
// coordinate representation. Controller release/reserved events are omitted;
// finishUpdate generates release transitions for contacts absent this frame.
// The current tracker addresses IDs0..4 directly; do not alias larger IDs.
fun TouchPoint.gesturePoint(): GesturePoint {
    if (!this.valid() || this.x() > 32767 || this.y() > 32767 ||
        this.id() >= touchMaximumPoints || (this.event() != 0 && this.event() != 2))
        return GesturePoint(0)
    gesturePoint(this.x(),this.y(),this.size(),this.id())
}
