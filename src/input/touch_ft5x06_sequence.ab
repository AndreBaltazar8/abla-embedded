import "./touch_ft5x06_frame.ab"

// Poll an initialized controller using disjoint29B snapshot/40B frame scratch.
// Caller owns I2C, tracker and buffers throughout; dimensions/rotation must
// match the current display. No IRQ-high-to-empty conversion: read failure
// preserves contacts. Returns count, -1 invalid, -2 I/O, -3 unstable, -4 frame.
trusted fun TouchTracker.updateFt5x06(
    touch: Ft5x06,snapshot: NativeBuffer,frame: NativeBuffer,
    nowMilliseconds: int,width: int,height: int,rotation: int
): int {
    if (!touch.valid() || this <= 0 || this > 4294967296-touchTrackerBytes ||
        width < 1 || width > 32768 || height < 1 || height > 32768 ||
        rotation < 0 || rotation > 7 || !snapshot.hasAddressRange(0,29) ||
        !frame.hasAddressRange(0,40)) return -1
    val a=snapshot.addressValue()
    val b=frame.addressValue()
    if ((a < b+40 && b < a+29) ||
        (a < this+touchTrackerBytes && this < a+29) ||
        (b < this+touchTrackerBytes && this < b+40)) return -1
    if (touchElapsedMilliseconds(nowMilliseconds,this.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) {
        this.startUpdate(nowMilliseconds)
        return this.getCount()
    }
    val count=touch.readStable(snapshot)
    if (count < 0) return if (count == -2) -3 else -2
    if (count > touchMaximumPoints) return -4
    this.updateFt5x06Snapshot(snapshot,frame,count,nowMilliseconds,width,height,rotation)
}
