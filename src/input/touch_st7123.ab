import "./touch_st7123_sequence.ab"
import "../touch/st7123_device.ab"
trusted fun TouchTracker10.updateSt7123(touch: St7123,snapshot: NativeBuffer,frame: NativeBuffer,
    now: int,width: int,height: int,rotation: int = 0): int =
    this.updateSt7123Owned(touch | 0,snapshot,frame,now,width,height,rotation)
