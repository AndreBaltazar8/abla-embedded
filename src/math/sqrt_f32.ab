import "abla/float"

// IEEE binary32 square root, round-to-nearest ties-to-even. Integer mantissa
// arithmetic avoids a target libm dependency and keeps subnormals exact.
fun sqrtF32Bits(bits: u32): u32 {
    val raw=int(bits)
    val magnitude=raw & 2147483647
    if (magnitude == 0) return bits
    if (magnitude > 2139095040) return u32(raw | 4194304)
    if ((raw & 2147483648) != 0) return u32(2143289344)
    if (magnitude == 2139095040) return bits
    var exponent=((raw>>>23)&255)-127
    var mantissa=raw & 8388607
    if (exponent == -127) {
        exponent=-126
        while (mantissa < 8388608) { mantissa=mantissa<<1; exponent=exponent-1 }
    } else mantissa=mantissa | 8388608
    val radicand=mantissa << (23+(exponent & 1))
    var remaining=radicand
    var root=0
    var bit=1<<46
    while (bit > remaining) bit=bit>>>2
    while (bit != 0) {
        if (remaining >= root+bit) {
            remaining=remaining-root-bit
            root=(root>>>1)+bit
        } else root=root>>>1
        bit=bit>>>2
    }
    // Midpoint squared is root^2+root+1/4; integer radicands cannot tie.
    if (remaining > root) root=root+1
    var outputExponent=(exponent>>1)+127
    if (root == 16777216) { root=root>>>1; outputExponent=outputExponent+1 }
    u32((outputExponent<<23)|(root & 8388607))
}
fun sqrtF32(value: f32): f32 = f32FromBits(sqrtF32Bits(f32ToBits(value)))
