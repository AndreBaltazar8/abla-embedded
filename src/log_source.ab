import "./log_buffers.ab"
import "abla/runtime/scalar"
// Upstream M5_LOG prefix: [%6u][L][basename:line] function(): .
// Bounded preformatted message, no varargs/printf/libc or trailing NUL.
// Explicit byte lengths; metadata rejects NUL (C source names cannot contain
// it), message can contain any byte. Slash and backslash both delimit paths.
fun logDecimalDigits(value: int): int {
    var n=u32(value);var digits=1
    while (n >= u32(10)) { n=n/u32(10);digits=digits+1 }
    return digits
}
trusted fun logWriteDecimal(output: NativeBuffer,offset: int,value: int,digits: int): void {
    var n=u32(value);var position=offset+digits-1
    while (position >= offset) { output.store(position,48+int(n%u32(10)));n=n/u32(10);position=position-1 }
    return
}
// -1 invalid/insufficient/alias, output unchanged; otherwise exact bytecount.
trusted fun logSourceFormat(level: int,milliseconds: int,path: NativeBuffer,pathBytes: int,line: int,functionName: NativeBuffer,functionBytes: int,message: NativeBuffer,messageBytes: int,output: NativeBuffer): int {
    if (level < 1 || level > 5 || milliseconds < 0 || milliseconds > 4294967295 || line < 0 || line > 4294967295 ||
        pathBytes < 0 || pathBytes > 65536 || functionBytes < 0 || functionBytes > 65536 || messageBytes < 0 || messageBytes > 1048576 ||
        !path.hasAddressRange(0,pathBytes) || !functionName.hasAddressRange(0,functionBytes) || !message.hasAddressRange(0,messageBytes)) return -1
    var base=0;var index=0
    while (index < pathBytes) {
        val byte=path.load(index)
        if (byte == 0) return -1
        if (byte == 47 || byte == 92) base=index+1
        index=index+1
    }
    index=0
    while (index < functionBytes) { if (functionName.load(index) == 0) return -1;index=index+1 }
    val digits=logDecimalDigits(milliseconds);val timeWidth=if (digits < 6) 6 else digits
    val lineDigits=logDecimalDigits(line)
    val total=timeWidth+lineDigits+(pathBytes-base)+functionBytes+messageBytes+13
    if (!output.hasAddressRange(0,total) ||
        (pathBytes > 0 && logBuffersOverlap(path,pathBytes,output,total)) ||
        (functionBytes > 0 && logBuffersOverlap(functionName,functionBytes,output,total)) ||
        (messageBytes > 0 && logBuffersOverlap(message,messageBytes,output,total))) return -1
    output.store(0,91);index=1
    while (index <= timeWidth-digits) { output.store(index,32);index=index+1 }
    logWriteDecimal(output,index,milliseconds,digits);index=1+timeWidth
    output.store(index,93);output.store(index+1,91)
    output.store(index+2,if (level == 1) 69 else if (level == 2) 87 else if (level == 3) 73 else if (level == 4) 68 else 86)
    output.store(index+3,93);output.store(index+4,91);index=index+5
    var source=base
    while (source < pathBytes) { output.store(index,path.load(source));source=source+1;index=index+1 }
    output.store(index,58);index=index+1
    logWriteDecimal(output,index,line,lineDigits);index=index+lineDigits
    output.store(index,93);output.store(index+1,32);index=index+2
    source=0
    while (source < functionBytes) { output.store(index,functionName.load(source));source=source+1;index=index+1 }
    output.store(index,40);output.store(index+1,41);output.store(index+2,58);output.store(index+3,32);index=index+4
    source=0
    while (source < messageBytes) { output.store(index,message.load(source));source=source+1;index=index+1 }
    return index
}
