// SerialPort methods as hooks (docs/hook-mocking-design.md): the definer is the chip's serial sequence
// src/esp32/uart/serial_s3_sequence.ab (the shared S3 SerialPort type; C5 and P4 keep their own types); host tests export their own.
import "../esp32/uart/serialport_type.ab"
noescape extern:"c" fun abla_serialport_tryWriteByte(recv: int, value: int, polls: int): bool
trusted fun SerialPort.tryWriteByte(value: int, polls: int = 100000): bool = abla_serialport_tryWriteByte(int(this), value, polls)
