// Hooks of esp32_uart: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun c5SerialBusRead(unit: int): int
noescape extern:"c" fun c5SerialBusWrite(unit: int,value: int): void
noescape extern:"c" fun c5SerialClockRead(unit: int): int
noescape extern:"c" fun c5SerialClockWrite(unit: int,value: int): void
noescape extern:"c" fun c5SerialConfigWrite(unit: int,offset: int,value: int): void
noescape extern:"c" fun p4UartLocalClockRead(unit: int): int
noescape extern:"c" fun p4UartLocalClockWrite(unit: int,value: int): void
noescape extern:"c" fun p4UartPinConfigure(pin: int,input: bool): int
noescape extern:"c" fun p4UartPinField(offset: int,mask: int,value: int): bool
noescape extern:"c" fun p4UartPinRead(offset: int): u32
noescape extern:"c" fun p4UartPinWrite(offset: int,value: u32): void
noescape extern:"c" fun p4UartRccRead(offset: int): int
noescape extern:"c" fun p4UartRccWrite(offset: int,value: int): void
