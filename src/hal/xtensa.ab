// Hooks of xtensa: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun xtensaCriticalLockCas(address: int,expected: int,replacement: int): int
noescape extern:"c" fun xtensaGuardCore(): int
noescape extern:"c" fun xtensaGuardMaskLocal(): int
noescape extern:"c" fun xtensaGuardRestoreLevel(level: int): void
noescape extern:"c" fun xtensaGuardStatus(): int
noescape extern:"c" fun xtensaPeerParkCas(address: int,expected: int,replacement: int): int
trusted noescape extern:"c" fun xtensaMemoryBarrier(): void
