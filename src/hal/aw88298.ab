import "../audio/aw88298_type.ab"
import "../i2c/device.ab"
import "./i2cdevice.ab"
// The Aw88298 operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_aw88298_close(recv: int): bool
noescape extern:"c" fun abla_aw88298_configureI2s16(recv: int, sampleRate: int): bool
noescape extern:"c" fun abla_aw88298_device(recv: int): I2cDevice
noescape extern:"c" fun abla_aw88298_disableI2s(recv: int): bool
noescape extern:"c" fun abla_aw88298_valid(recv: int): bool
trusted fun Aw88298.close(): bool = abla_aw88298_close(int(this))
trusted fun Aw88298.configureI2s16(sampleRate: int): bool = abla_aw88298_configureI2s16(int(this), sampleRate)
fun Aw88298.device(): I2cDevice = abla_aw88298_device(int(this))
trusted fun Aw88298.disableI2s(): bool = abla_aw88298_disableI2s(int(this))
fun Aw88298.valid(): bool = abla_aw88298_valid(int(this))
