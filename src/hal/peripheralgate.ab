export import "../peripheralgate_type.ab"
export import "../atomic_methods.ab"
// The operations below are wrappers over hooks the program supplies (the driver module exports each under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_peripheralgate_word(recv: int): AtomicU32
fun PeripheralGate.word(): AtomicU32 = abla_peripheralgate_word(int(this))
