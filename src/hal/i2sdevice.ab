export import "../esp32/i2s_types.ab"
// The operations below are wrappers over hooks the program supplies (the driver module exports each under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_i2sdevice_prepare(recv: int, microphone: bool, dmaDescriptors: int): bool
noescape extern:"c" fun abla_i2sdevice_handleAddress(recv: int): int
noescape extern:"c" fun abla_i2sdevice_uninstall(recv: int): void
trusted fun I2sDevice.prepare(microphone: bool, dmaDescriptors: int = 6): bool = abla_i2sdevice_prepare(int(this), microphone, dmaDescriptors)
fun I2sDevice.handleAddress(): int = abla_i2sdevice_handleAddress(int(this))
trusted fun I2sDevice.uninstall(): void = abla_i2sdevice_uninstall(int(this))
