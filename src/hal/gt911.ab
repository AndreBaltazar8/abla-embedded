import "../touch/gt911_type.ab"
// The Gt911 operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_gt911_begin(recv: int): bool
noescape extern:"c" fun abla_gt911_close(recv: int): bool
noescape extern:"c" fun abla_gt911_device(recv: int): I2cDevice
noescape extern:"c" fun abla_gt911_discardPending(recv: int): bool
noescape extern:"c" fun abla_gt911_refreshConfiguration(recv: int): bool
noescape extern:"c" fun abla_gt911_refreshPeriodMillisecondsChecked(recv: int): I2cByteResult
noescape extern:"c" fun abla_gt911_setMaximumContacts(recv: int, count: int): bool
noescape extern:"c" fun abla_gt911_sleepCommand(recv: int): bool
noescape extern:"c" fun abla_gt911_updateConfiguration(recv: int, maximumContacts: int): bool
noescape extern:"c" fun abla_gt911_valid(recv: int): bool
trusted fun Gt911.begin(): bool = abla_gt911_begin(int(this))
trusted fun Gt911.close(): bool = abla_gt911_close(int(this))
fun Gt911.device(): I2cDevice = abla_gt911_device(int(this))
trusted fun Gt911.discardPending(): bool = abla_gt911_discardPending(int(this))
trusted fun Gt911.refreshConfiguration(): bool = abla_gt911_refreshConfiguration(int(this))
trusted fun Gt911.refreshPeriodMillisecondsChecked(): I2cByteResult = abla_gt911_refreshPeriodMillisecondsChecked(int(this))
trusted fun Gt911.setMaximumContacts(count: int): bool = abla_gt911_setMaximumContacts(int(this), count)
trusted fun Gt911.sleepCommand(): bool = abla_gt911_sleepCommand(int(this))
trusted fun Gt911.updateConfiguration(maximumContacts: int): bool = abla_gt911_updateConfiguration(int(this), maximumContacts)
fun Gt911.valid(): bool = abla_gt911_valid(int(this))
