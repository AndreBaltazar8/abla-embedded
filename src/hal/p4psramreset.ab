export import "../esp32/psram/p4psramreset_type.ab"
// The P4PsramReset operations: each is a wrapper over a hook the program supplies (the P4 PSRAM sequence modules export them under their C names with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_p4psramreset_releaseOwned(recv: int): P4PsramReset
noescape extern:"c" fun abla_p4psramreset_status(recv: int): int
trusted fun P4PsramReset.releaseOwned(): P4PsramReset = abla_p4psramreset_releaseOwned(int(this))
fun P4PsramReset.status(): int = abla_p4psramreset_status(int(this))
