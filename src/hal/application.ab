// Functions the application supplies and the library calls (decision #1278 and #157): each is a hook, so the library
// module that calls it imports this file and the application defines it under the same C name, for example
//   @export("logOutputOwned")
//   trusted fun logOutputOwnedHook(target: int,level: int,color: bool,text: NativeBuffer,length: int,suffix: int): bool { ... }
// A program that reaches a caller without defining its hook fails to link (an undefined symbol), never silently.
import "../esp32/sdk/nativebuffer_type.ab"
import "../cooperative_timers_type.ab"
// After boot memory preparation on the ESP32-S3 (src/esp32/boot_main_s3_sequence.ab).
noescape extern:"c" fun esp32S3BootApplication(): void
// A due cooperative timer (src/cooperative_timers.ab): its owner, slot id and token.
noescape extern:"c" fun cooperativeTimerDispatchOwned(owner: CooperativeTimers,id: int,token: u32): void
// One log line for one target (src/log_policy.ab); true when the target took it.
noescape extern:"c" fun logOutputOwned(target: int,level: int,color: bool,text: NativeBuffer,length: int,suffix: int): bool
// A finished log console frame (src/display/log_console_session.ab).
noescape extern:"c" fun displayLogPublishOwned(token: int,frame: NativeBuffer,width: int,height: int,stride: int,littleEndian: bool): int
