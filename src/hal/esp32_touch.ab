// Hooks of esp32_touch: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun touchScanRead(address: int): u32
noescape extern:"c" fun touchScanWrite(address: int,value: u32): void
