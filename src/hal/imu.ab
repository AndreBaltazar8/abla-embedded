// Hooks of imu: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun imuOffsetStorageCommit(handle: int): bool
noescape extern:"c" fun imuOffsetStorageWrite(handle: int,index: int,value: int): bool
trusted noescape extern:"c" fun imuOffsetStorageRead(handle: int,index: int,scratch: NativeBuffer,offset: int): bool
