export import "../esp32/psram/p4psramclockowner_type.ab"
import "../esp32/psram/p4psramreset_type.ab"
// The P4PsramClockOwner operations: each is a wrapper over a hook the program supplies (the P4 PSRAM sequence modules export them under their C names with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_p4psramclockowner_closeOwned(recv: int, polls: int): P4PsramClockOwner
noescape extern:"c" fun abla_p4psramclockowner_prepareApControllerOwned(recv: int, mappedDivider: int, commandDivider: int, drive: int, polls: int): int
noescape extern:"c" fun abla_p4psramclockowner_ready(recv: int): bool
noescape extern:"c" fun abla_p4psramclockowner_resetControllerOwned(recv: int, polls: int): P4PsramReset
noescape extern:"c" fun abla_p4psramclockowner_resumeOwned(recv: int): P4PsramClockOwner
noescape extern:"c" fun abla_p4psramclockowner_status(recv: int): int
trusted fun P4PsramClockOwner.closeOwned(polls: int): P4PsramClockOwner = abla_p4psramclockowner_closeOwned(int(this), polls)
trusted fun P4PsramClockOwner.prepareApControllerOwned(mappedDivider: int, commandDivider: int, drive: int, polls: int): int = abla_p4psramclockowner_prepareApControllerOwned(int(this), mappedDivider, commandDivider, drive, polls)
fun P4PsramClockOwner.ready(): bool = abla_p4psramclockowner_ready(int(this))
trusted fun P4PsramClockOwner.resetControllerOwned(polls: int): P4PsramReset = abla_p4psramclockowner_resetControllerOwned(int(this), polls)
trusted fun P4PsramClockOwner.resumeOwned(): P4PsramClockOwner = abla_p4psramclockowner_resumeOwned(int(this))
fun P4PsramClockOwner.status(): int = abla_p4psramclockowner_status(int(this))
