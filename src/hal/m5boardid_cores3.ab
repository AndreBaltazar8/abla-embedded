export import "../m5stack/m5boardid_type.ab"
export import "../peripheralgate_type.ab"
import "../spi/spitransactionresult_type.ab"
import "../display/spilcd_type.ab"
// The operations below are wrappers over hooks the program supplies (the driver module exports each under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_m5boardid_displaySharedDataCommand(recv: int): bool
noescape extern:"c" fun abla_m5boardid_spiDisplay(recv: int): SpiLcd
noescape extern:"c" fun abla_m5boardid_prepareCoreS3SdSpi(recv: int, gate: PeripheralGate, owner: u32): SpiTransactionResult
noescape extern:"c" fun abla_m5boardid_configureCoreS3SpiPins(recv: int, gate: PeripheralGate, owner: u32): SpiTransactionResult
noescape extern:"c" fun abla_m5boardid_clearCoreS3SoftwareDisplay(recv: int, gate: PeripheralGate, owner: u32, halfPeriodMicroseconds: int): SpiTransactionResult
noescape extern:"c" fun abla_m5boardid_beginCoreS3SoftwareDisplay(recv: int, gate: PeripheralGate, owner: u32, panel: int, halfPeriodMicroseconds: int): SpiTransactionResult
noescape extern:"c" fun abla_m5boardid_beginCoreS3SpiDisplay(recv: int, gate: PeripheralGate, owner: u32, panel: int): SpiTransactionResult
noescape extern:"c" fun abla_m5boardid_clearCoreS3SpiDisplay(recv: int, gate: PeripheralGate, owner: u32): SpiTransactionResult
noescape extern:"c" fun abla_m5boardid_configureCoreS3HardwareSpi(recv: int, gate: PeripheralGate, owner: u32): SpiTransactionResult
fun M5BoardId.displaySharedDataCommand(): bool = abla_m5boardid_displaySharedDataCommand(int(this))
fun M5BoardId.spiDisplay(): SpiLcd = abla_m5boardid_spiDisplay(int(this))
trusted fun M5BoardId.prepareCoreS3SdSpi(gate: PeripheralGate, owner: u32): SpiTransactionResult = abla_m5boardid_prepareCoreS3SdSpi(int(this), gate, owner)
trusted fun M5BoardId.configureCoreS3SpiPins(gate: PeripheralGate, owner: u32): SpiTransactionResult = abla_m5boardid_configureCoreS3SpiPins(int(this), gate, owner)
trusted fun M5BoardId.clearCoreS3SoftwareDisplay(gate: PeripheralGate, owner: u32,
    halfPeriodMicroseconds: int = 1): SpiTransactionResult = abla_m5boardid_clearCoreS3SoftwareDisplay(int(this), gate, owner, halfPeriodMicroseconds)
trusted fun M5BoardId.beginCoreS3SoftwareDisplay(gate: PeripheralGate, owner: u32,
    panel: int, halfPeriodMicroseconds: int = 1): SpiTransactionResult = abla_m5boardid_beginCoreS3SoftwareDisplay(int(this), gate, owner, panel, halfPeriodMicroseconds)
trusted fun M5BoardId.beginCoreS3SpiDisplay(gate: PeripheralGate, owner: u32,
    panel: int): SpiTransactionResult = abla_m5boardid_beginCoreS3SpiDisplay(int(this), gate, owner, panel)
trusted fun M5BoardId.clearCoreS3SpiDisplay(gate: PeripheralGate, owner: u32): SpiTransactionResult = abla_m5boardid_clearCoreS3SpiDisplay(int(this), gate, owner)
trusted fun M5BoardId.configureCoreS3HardwareSpi(gate: PeripheralGate, owner: u32): SpiTransactionResult = abla_m5boardid_configureCoreS3HardwareSpi(int(this), gate, owner)
