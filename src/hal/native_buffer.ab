import "../esp32/sdk/nativebuffer_type.ab"
// Hooks of native_buffer: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun nativeBufferAt(address: int, capacity: int): NativeBuffer
