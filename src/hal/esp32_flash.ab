// Hooks of esp32_flash: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun p4FlashSpeedFence(): void
noescape extern:"c" fun p4FlashSpeedRccRead(offset: int): int
noescape extern:"c" fun p4FlashSpeedRead(offset: int): int
noescape extern:"c" fun p4FlashSpeedWrite(offset: int,value: int): void
