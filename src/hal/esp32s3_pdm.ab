// Hooks of the S3 PDM microphone path: declared here, supplied by the program: the PDM sequence modules (or a host test's mock) export each under its C name with @export (docs/hook-mocking-design.md).
import "../audio/pdm_pins.ab"
import "../esp32/sdk/nativebuffer_type.ab"
noescape extern:"c" fun esp32s3PdmPinsValidHook(port: int, pins: PdmPins, slots: int, slave: bool): bool
noescape extern:"c" fun esp32s3PdmRoutePinsOwnedHook(port: int, pins: PdmPins, slots: int, slave: bool, invertClock: bool): int
noescape extern:"c" fun esp32s3PdmPinsCaptureOwnedHook(r: NativeBuffer, pins: PdmPins, slots: int, slave: bool, exclusive: bool): int
fun esp32s3PdmPinsValid(port: int, pins: PdmPins, slots: int, slave: bool): bool =
    esp32s3PdmPinsValidHook(port, pins, slots, slave)
trusted fun esp32s3PdmRoutePinsOwned(port: int, pins: PdmPins, slots: int, slave: bool, invertClock: bool): int =
    esp32s3PdmRoutePinsOwnedHook(port, pins, slots, slave, invertClock)
trusted fun esp32s3PdmPinsCaptureOwned(r: NativeBuffer, pins: PdmPins, slots: int, slave: bool, exclusive: bool): int =
    esp32s3PdmPinsCaptureOwnedHook(r, pins, slots, slave, exclusive)
