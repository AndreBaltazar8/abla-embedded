export import "../esp32/esp32s3adc2arbiter_type.ab"
// The Esp32S3Adc2Arbiter operations: each is a wrapper over a hook the program supplies (src/esp32/adc2_arbiter_s3_sequence.ab exports it under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_esp32s3adc2arbiter_bits(recv: int): int
noescape extern:"c" fun abla_esp32s3adc2arbiter_status(recv: int): int
noescape extern:"c" fun abla_esp32s3adc2arbiter_ready(recv: int): bool
noescape extern:"c" fun abla_esp32s3adc2arbiter_closeOwned(recv: int): Esp32S3Adc2Arbiter
fun Esp32S3Adc2Arbiter.bits(): int = abla_esp32s3adc2arbiter_bits(int(this))
fun Esp32S3Adc2Arbiter.status(): int = abla_esp32s3adc2arbiter_status(int(this))
fun Esp32S3Adc2Arbiter.ready(): bool = abla_esp32s3adc2arbiter_ready(int(this))
trusted fun Esp32S3Adc2Arbiter.closeOwned(): Esp32S3Adc2Arbiter = abla_esp32s3adc2arbiter_closeOwned(int(this))
