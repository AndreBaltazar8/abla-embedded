import "../audio/es8388_type.ab"
// The Es8388 operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_es8388_close(recv: int): bool
noescape extern:"c" fun abla_es8388_configureStereoDac128Owned(recv: int, exclusive: bool): int
noescape extern:"c" fun abla_es8388_configureStereoDacSlaveOwned(recv: int, exclusive: bool): int
noescape extern:"c" fun abla_es8388_device(recv: int): I2cDevice
noescape extern:"c" fun abla_es8388_speakerPowerDownOwned(recv: int, exclusive: bool): int
noescape extern:"c" fun abla_es8388_valid(recv: int): bool
trusted fun Es8388.close(): bool = abla_es8388_close(int(this))
trusted fun Es8388.configureStereoDac128Owned(exclusive: bool): int = abla_es8388_configureStereoDac128Owned(int(this), exclusive)
trusted fun Es8388.configureStereoDacSlaveOwned(exclusive: bool): int = abla_es8388_configureStereoDacSlaveOwned(int(this), exclusive)
fun Es8388.device(): I2cDevice = abla_es8388_device(int(this))
trusted fun Es8388.speakerPowerDownOwned(exclusive: bool): int = abla_es8388_speakerPowerDownOwned(int(this), exclusive)
fun Es8388.valid(): bool = abla_es8388_valid(int(this))
