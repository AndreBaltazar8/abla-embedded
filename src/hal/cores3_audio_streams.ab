export import "../m5stack/cores3_audio_stream_types.ab"
import "../audio/aw88298_type.ab"
import "../io_expander/aw9523_type.ab"
import "../audio/es7210_type.ab"
// CoreS3 audio DMA preparation and speaker/microphone stream control: each is a wrapper over a hook the program supplies (the driver sequence module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun coreS3PrepareAudioDmaHook(transmit: bool,sampleHz: int,channel: int,descriptors: int,count: int,buffers: int,blockBytes: int,owner: int): int
noescape extern:"c" fun cores3StartSpeakerStreamHook(amplifier: int,expander: int,sampleRate: int,channel: int,descriptors: int,polls: int): int
noescape extern:"c" fun cores3StopSpeakerStreamHook(amplifier: int,expander: int,channel: int,polls: int): int
noescape extern:"c" fun cores3StartMicrophoneStreamHook(microphone: int,channel: int,descriptors: int,polls: int): int
noescape extern:"c" fun cores3StopMicrophoneStreamHook(microphone: int,channel: int,polls: int): int
trusted fun coreS3PrepareAudioDma(transmit: bool,sampleHz: int,channel: int,descriptors: int,count: int,buffers: int,blockBytes: int,owner: u32): CoreS3AudioDmaPreparation =
    CoreS3AudioDmaPreparation(coreS3PrepareAudioDmaHook(transmit,sampleHz,channel,descriptors,count,buffers,blockBytes,int(owner)))
trusted fun cores3StartSpeakerStream(amplifier: Aw88298,expander: Aw9523,sampleRate: int,channel: int,descriptors: int,polls: int): CoreS3SpeakerStreamResult =
    CoreS3SpeakerStreamResult(cores3StartSpeakerStreamHook(int(amplifier),int(expander),sampleRate,channel,descriptors,polls))
trusted fun cores3StopSpeakerStream(amplifier: Aw88298,expander: Aw9523,channel: int,polls: int): CoreS3SpeakerStreamResult =
    CoreS3SpeakerStreamResult(cores3StopSpeakerStreamHook(int(amplifier),int(expander),channel,polls))
trusted fun cores3StartMicrophoneStream(microphone: Es7210,channel: int,descriptors: int,polls: int): CoreS3MicrophoneStreamResult =
    CoreS3MicrophoneStreamResult(cores3StartMicrophoneStreamHook(int(microphone),channel,descriptors,polls))
trusted fun cores3StopMicrophoneStream(microphone: Es7210,channel: int,polls: int): CoreS3MicrophoneStreamResult =
    CoreS3MicrophoneStreamResult(cores3StopMicrophoneStreamHook(int(microphone),channel,polls))
