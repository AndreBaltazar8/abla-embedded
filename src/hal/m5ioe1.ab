import "../io_expander/m5ioe1_type.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../m5stack/m5boardid_type.ab"
import "../m5stack/vibration_sequence.ab"
import "../esp32/sdk/nativebuffer_type.ab"
import "../i2c/device.ab"
import "./i2cdevice.ab"
import "../i2c/results.ab"
// The M5Ioe1 operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_m5ioe1_begin(recv: int): bool
noescape extern:"c" fun abla_m5ioe1_close(recv: int): bool
noescape extern:"c" fun abla_m5ioe1_device(recv: int): I2cDevice
noescape extern:"c" fun abla_m5ioe1_digitalReadChecked(recv: int, pin: int): I2cByteResult
noescape extern:"c" fun abla_m5ioe1_digitalRead(recv: int, pin: int): bool
noescape extern:"c" fun abla_m5ioe1_disableInterrupt(recv: int): bool
noescape extern:"c" fun abla_m5ioe1_enableInterrupt(recv: int): bool
noescape extern:"c" fun abla_m5ioe1_getWriteValueChecked(recv: int, pin: int): I2cByteResult
noescape extern:"c" fun abla_m5ioe1_getWriteValue(recv: int, pin: int): bool
noescape extern:"c" fun abla_m5ioe1_preparePaperMonoCharger(recv: int): bool
noescape extern:"c" fun abla_m5ioe1_resetInterrupt(recv: int): bool
noescape extern:"c" fun abla_m5ioe1_setChainCaptainBacklightOwned(recv: int, brightness: int): bool
noescape extern:"c" fun abla_m5ioe1_setInterruptMask(recv: int, enabledPins: int): bool
noescape extern:"c" fun abla_m5ioe1_setPullMode(recv: int, pin: int, mode: int): bool
noescape extern:"c" fun abla_m5ioe1_setPwmFrequency(recv: int, frequency: int): bool
noescape extern:"c" fun abla_m5ioe1_setPwmFrequencyWithBuffer(recv: int, frequency: int,data: NativeBuffer): bool
noescape extern:"c" fun abla_m5ioe1_setVibration(recv: int, board: M5BoardId,level: int): M5VibrationResult
noescape extern:"c" fun abla_m5ioe1_valid(recv: int): bool
trusted fun M5Ioe1.begin(): bool = abla_m5ioe1_begin(int(this))
trusted fun M5Ioe1.close(): bool = abla_m5ioe1_close(int(this))
fun M5Ioe1.device(): I2cDevice = abla_m5ioe1_device(int(this))
trusted fun M5Ioe1.digitalRead(pin: int): bool = abla_m5ioe1_digitalRead(int(this), pin)
trusted fun M5Ioe1.digitalReadChecked(pin: int): I2cByteResult = abla_m5ioe1_digitalReadChecked(int(this), pin)
trusted fun M5Ioe1.disableInterrupt(): bool = abla_m5ioe1_disableInterrupt(int(this))
trusted fun M5Ioe1.enableInterrupt(): bool = abla_m5ioe1_enableInterrupt(int(this))
trusted fun M5Ioe1.getWriteValue(pin: int): bool = abla_m5ioe1_getWriteValue(int(this), pin)
trusted fun M5Ioe1.getWriteValueChecked(pin: int): I2cByteResult = abla_m5ioe1_getWriteValueChecked(int(this), pin)
trusted fun M5Ioe1.preparePaperMonoCharger(): bool = abla_m5ioe1_preparePaperMonoCharger(int(this))
trusted fun M5Ioe1.resetInterrupt(): bool = abla_m5ioe1_resetInterrupt(int(this))
trusted fun M5Ioe1.setChainCaptainBacklightOwned(brightness: int): bool = abla_m5ioe1_setChainCaptainBacklightOwned(int(this), brightness)
trusted fun M5Ioe1.setInterruptMask(enabledPins: int): bool = abla_m5ioe1_setInterruptMask(int(this), enabledPins)
trusted fun M5Ioe1.setPullMode(pin: int, mode: int): bool = abla_m5ioe1_setPullMode(int(this), pin, mode)
trusted fun M5Ioe1.setPwmFrequency(frequency: int): bool = abla_m5ioe1_setPwmFrequency(int(this), frequency)
trusted fun M5Ioe1.setPwmFrequencyWithBuffer(frequency: int,data: NativeBuffer): bool = abla_m5ioe1_setPwmFrequencyWithBuffer(int(this), frequency, data)
trusted fun M5Ioe1.setVibration(board: M5BoardId,level: int): M5VibrationResult = abla_m5ioe1_setVibration(int(this), board, level)
fun M5Ioe1.valid(): bool = abla_m5ioe1_valid(int(this))
