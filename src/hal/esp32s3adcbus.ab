export import "../esp32/esp32s3adcbus_type.ab"
// The Esp32S3AdcBus operations: each is a wrapper over a hook the program supplies (src/esp32/adc_bus_s3_sequence.ab exports it under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_esp32s3adcbus_bits(recv: int): int
noescape extern:"c" fun abla_esp32s3adcbus_status(recv: int): int
noescape extern:"c" fun abla_esp32s3adcbus_ready(recv: int): bool
noescape extern:"c" fun abla_esp32s3adcbus_closeOwned(recv: int): Esp32S3AdcBus
fun Esp32S3AdcBus.bits(): int = abla_esp32s3adcbus_bits(int(this))
fun Esp32S3AdcBus.status(): int = abla_esp32s3adcbus_status(int(this))
fun Esp32S3AdcBus.ready(): bool = abla_esp32s3adcbus_ready(int(this))
trusted fun Esp32S3AdcBus.closeOwned(): Esp32S3AdcBus = abla_esp32s3adcbus_closeOwned(int(this))
