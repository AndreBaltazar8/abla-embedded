// The native AtomS3 panel operations as hooks (docs/hook-mocking-design.md): the definers are src/m5stack/atom_s3_panel_native_sequence.ab
// and atom_s3_panel_draw_sequence.ab, which the platform layer imports; host tests export their own.
import "../m5stack/atom_s3_panel_logic.ab"
import "../peripheralgate_type.ab"
import "../display/color.ab"
import "../spi/spitransactionresult_type.ab"
import "../esp32/sdk/nativebuffer_type.ab"
noescape extern:"c" fun abla_atoms3panel_beginNativeChecked(recv: int, gate: PeripheralGate, owner: u32, port: int, rotation: int): SpiTransactionResult
noescape extern:"c" fun abla_atoms3panel_fillNativeChecked(recv: int, gate: PeripheralGate, owner: u32, port: int, rotation: int, x: int, y: int, width: int, height: int, color: Rgb565): SpiTransactionResult
noescape extern:"c" fun abla_atoms3panel_blitNativeChecked(recv: int, gate: PeripheralGate, owner: u32, port: int, rotation: int, x: int, y: int, source: NativeBuffer, width: int, height: int, stride: int, littleEndian: bool, staging: NativeBuffer): SpiTransactionResult
trusted fun AtomS3Panel.beginNativeChecked(gate: PeripheralGate, owner: u32, port: int, rotation: int): SpiTransactionResult = abla_atoms3panel_beginNativeChecked(int(this), gate, owner, port, rotation)
trusted fun AtomS3Panel.fillNativeChecked(gate: PeripheralGate, owner: u32, port: int, rotation: int, x: int, y: int, width: int, height: int, color: Rgb565): SpiTransactionResult = abla_atoms3panel_fillNativeChecked(int(this), gate, owner, port, rotation, x, y, width, height, color)
trusted fun AtomS3Panel.blitNativeChecked(gate: PeripheralGate, owner: u32, port: int, rotation: int, x: int, y: int, source: NativeBuffer, width: int, height: int, stride: int, littleEndian: bool = false, staging: NativeBuffer = NativeBuffer(0)): SpiTransactionResult = abla_atoms3panel_blitNativeChecked(int(this), gate, owner, port, rotation, x, y, source, width, height, stride, littleEndian, staging)
