import "../audio/es7210_type.ab"
// The Es7210 operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_es7210_close(recv: int): bool
noescape extern:"c" fun abla_es7210_configureMic1234(recv: int): bool
noescape extern:"c" fun abla_es7210_configureMic12Profile(recv: int, secondMicGain: bool,allInputs: bool): bool
noescape extern:"c" fun abla_es7210_configureMic1(recv: int): bool
noescape extern:"c" fun abla_es7210_configureStereoMic12(recv: int): bool
noescape extern:"c" fun abla_es7210_device(recv: int): I2cDevice
noescape extern:"c" fun abla_es7210_reset(recv: int): bool
noescape extern:"c" fun abla_es7210_valid(recv: int): bool
trusted fun Es7210.close(): bool = abla_es7210_close(int(this))
trusted fun Es7210.configureMic1(): bool = abla_es7210_configureMic1(int(this))
trusted fun Es7210.configureMic1234(): bool = abla_es7210_configureMic1234(int(this))
trusted fun Es7210.configureMic12Profile(secondMicGain: bool,allInputs: bool=false): bool = abla_es7210_configureMic12Profile(int(this), secondMicGain, allInputs)
trusted fun Es7210.configureStereoMic12(): bool = abla_es7210_configureStereoMic12(int(this))
fun Es7210.device(): I2cDevice = abla_es7210_device(int(this))
trusted fun Es7210.reset(): bool = abla_es7210_reset(int(this))
fun Es7210.valid(): bool = abla_es7210_valid(int(this))
