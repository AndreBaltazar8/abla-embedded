// Hooks of esp32_timer: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun p4SystemTimerClockRead(offset: int): int
noescape extern:"c" fun p4SystemTimerClockWrite(offset: int,value: int): void
noescape extern:"c" fun p4SystemTimerRead(offset: int): int
noescape extern:"c" fun p4SystemTimerWrite(offset: int,value: int): void
