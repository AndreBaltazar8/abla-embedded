// Hooks of esp32_watchdog: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun p4LpWatchdogDelay(): int
noescape extern:"c" fun p4LpWatchdogRead(offset: int): int
noescape extern:"c" fun p4LpWatchdogWrite(offset: int,value: int): void
