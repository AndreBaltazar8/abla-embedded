import "../esp32/spidevice_type.ab"
import "../esp32/sdk/nativebuffer_type.ab"
// Generic ESP-IDF transaction flag. The caller must acquire the bus before a
// transaction which keeps chip select active for a following transaction.
val spiKeepChipSelect = 256
// The operations below are wrappers over hooks the program supplies (the driver module exports each under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_spidevice_acquire(recv: int): bool
noescape extern:"c" fun abla_spidevice_release(recv: int): void
noescape extern:"c" fun abla_spidevice_writeWithFlags(recv: int, transmit: NativeBuffer, length: int, flags: int): bool
trusted fun SpiDevice.acquire(): bool = abla_spidevice_acquire(int(this))
trusted fun SpiDevice.release(): void = abla_spidevice_release(int(this))
trusted fun SpiDevice.writeWithFlags(
    transmit: NativeBuffer,
    length: int,
    flags: int
): bool = abla_spidevice_writeWithFlags(int(this), transmit, length, flags)
