export import "../esp32/esp32sarpower_type.ab"
// The Esp32SarPower operations: each is a wrapper over a hook the program supplies (src/esp32/sar_power_sequence.ab exports it under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_esp32sarpower_bits(recv: int): int
noescape extern:"c" fun abla_esp32sarpower_status(recv: int): int
noescape extern:"c" fun abla_esp32sarpower_powered(recv: int): bool
noescape extern:"c" fun abla_esp32sarpower_closeOwned(recv: int): Esp32SarPower
fun Esp32SarPower.bits(): int = abla_esp32sarpower_bits(int(this))
fun Esp32SarPower.status(): int = abla_esp32sarpower_status(int(this))
fun Esp32SarPower.powered(): bool = abla_esp32sarpower_powered(int(this))
trusted fun Esp32SarPower.closeOwned(): Esp32SarPower = abla_esp32sarpower_closeOwned(int(this))
