export import "../esp32/esp32s3adcpower_type.ab"
// The Esp32S3AdcPower operations: each is a wrapper over a hook the program supplies (src/esp32/adc_power_s3_sequence.ab exports it under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_esp32s3adcpower_bits(recv: int): int
noescape extern:"c" fun abla_esp32s3adcpower_status(recv: int): int
noescape extern:"c" fun abla_esp32s3adcpower_powered(recv: int): bool
noescape extern:"c" fun abla_esp32s3adcpower_closeOwned(recv: int): Esp32S3AdcPower
fun Esp32S3AdcPower.bits(): int = abla_esp32s3adcpower_bits(int(this))
fun Esp32S3AdcPower.status(): int = abla_esp32s3adcpower_status(int(this))
fun Esp32S3AdcPower.powered(): bool = abla_esp32s3adcpower_powered(int(this))
trusted fun Esp32S3AdcPower.closeOwned(): Esp32S3AdcPower = abla_esp32s3adcpower_closeOwned(int(this))
