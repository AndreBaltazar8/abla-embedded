import "abla/unsafe/memory/raw"
export import "../display/spilcd_type.ab"
import "../display/lcd_logic.ab"
export import "../esp32/spidevice_type.ab"
import "../esp32/sdk/nativebuffer_type.ab"
import "./pin.ab"
import "../peripheralgate_type.ab"
import "../spi/spitransactionresult_type.ab"
// The operations below are wrappers over hooks the program supplies (the driver module exports each under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_spilcd_valid(recv: int): bool
noescape extern:"c" fun abla_spilcd_device(recv: int): SpiDevice
noescape extern:"c" fun abla_spilcd_dataCommandPin(recv: int): Pin
noescape extern:"c" fun abla_spilcd_reset(recv: int): void
noescape extern:"c" fun abla_spilcd_setBacklight(recv: int, enabled: bool): void
noescape extern:"c" fun abla_spilcd_setWindowSelected(recv: int, view: LcdView, x: int, y: int, width: int, height: int): bool
noescape extern:"c" fun abla_spilcd_runCommandProgram(recv: int, program: int, size: int): bool
noescape extern:"c" fun abla_spilcd_beginRgb565(recv: int, gate: PeripheralGate, owner: u32, geometry: LcdGeometry, rotation: int, program: NativeBuffer, extraProgram: NativeBuffer, inverted: bool, bgrOrder: bool): SpiTransactionResult
noescape extern:"c" fun abla_spilcd_writeCommand(recv: int, command: int, data: NativeBuffer, length: int): bool
noescape extern:"c" fun abla_spilcd_writeCommandSelected(recv: int, command: int, data: NativeBuffer, length: int, keepSelectedAfter: bool): bool
trusted fun SpiLcd.beginRgb565(gate: PeripheralGate, owner: u32, geometry: LcdGeometry,
    rotation: int, program: NativeBuffer, extraProgram: NativeBuffer,
    inverted: bool = false, bgrOrder: bool = true): SpiTransactionResult = abla_spilcd_beginRgb565(int(this), gate, owner, geometry, rotation, program, extraProgram, inverted, bgrOrder)
fun SpiLcd.valid(): bool = abla_spilcd_valid(int(this))
fun SpiLcd.device(): SpiDevice = abla_spilcd_device(int(this))
fun SpiLcd.dataCommandPin(): Pin = abla_spilcd_dataCommandPin(int(this))
trusted fun SpiLcd.reset(): void = abla_spilcd_reset(int(this))
trusted fun SpiLcd.setBacklight(enabled: bool): void = abla_spilcd_setBacklight(int(this), enabled)
trusted fun SpiLcd.setWindowSelected(
    view: LcdView,
    x: int,
    y: int,
    width: int,
    height: int
): bool = abla_spilcd_setWindowSelected(int(this), view, x, y, width, height)
// The program crosses the hook as its address and size (a hook takes scalars).
trusted fun SpiLcd.runCommandProgram(program: string): bool = abla_spilcd_runCommandProgram(int(this), ablaUnsafeStringAddress(program), program.size)
trusted fun SpiLcd.writeCommand(
    command: int,
    data: NativeBuffer,
    length: int
): bool = abla_spilcd_writeCommand(int(this), command, data, length)
trusted fun SpiLcd.writeCommandSelected(
    command: int,
    data: NativeBuffer,
    length: int,
    keepSelectedAfter: bool = false
): bool = abla_spilcd_writeCommandSelected(int(this), command, data, length, keepSelectedAfter)
