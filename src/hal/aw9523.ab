import "../io_expander/aw9523_type.ab"
// The Aw9523 operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_aw9523_begin(recv: int): bool
noescape extern:"c" fun abla_aw9523_close(recv: int): bool
noescape extern:"c" fun abla_aw9523_configureControl(recv: int, port0PushPull: bool, currentScale: int): bool
noescape extern:"c" fun abla_aw9523_device(recv: int): I2cDevice
noescape extern:"c" fun abla_aw9523_digitalReadChecked(recv: int, pin: int): I2cByteResult
noescape extern:"c" fun abla_aw9523_readPortsChecked(recv: int): I2cWordResult
noescape extern:"c" fun abla_aw9523_setDirection(recv: int, pin: int, output: bool): bool
noescape extern:"c" fun abla_aw9523_setGpioMode(recv: int, pin: int, gpio: bool): bool
noescape extern:"c" fun abla_aw9523_setInterruptEnabled(recv: int, pin: int, enabled: bool): bool
noescape extern:"c" fun abla_aw9523_setLedCurrent(recv: int, pin: int, level: int): bool
noescape extern:"c" fun abla_aw9523_softwareReset(recv: int): bool
noescape extern:"c" fun abla_aw9523_valid(recv: int): bool
trusted fun Aw9523.begin(): bool = abla_aw9523_begin(int(this))
trusted fun Aw9523.close(): bool = abla_aw9523_close(int(this))
trusted fun Aw9523.configureControl(port0PushPull: bool, currentScale: int): bool = abla_aw9523_configureControl(int(this), port0PushPull, currentScale)
fun Aw9523.device(): I2cDevice = abla_aw9523_device(int(this))
trusted fun Aw9523.digitalReadChecked(pin: int): I2cByteResult = abla_aw9523_digitalReadChecked(int(this), pin)
trusted fun Aw9523.readPortsChecked(): I2cWordResult = abla_aw9523_readPortsChecked(int(this))
trusted fun Aw9523.setDirection(pin: int, output: bool): bool = abla_aw9523_setDirection(int(this), pin, output)
trusted fun Aw9523.setGpioMode(pin: int, gpio: bool): bool = abla_aw9523_setGpioMode(int(this), pin, gpio)
trusted fun Aw9523.setInterruptEnabled(pin: int, enabled: bool): bool = abla_aw9523_setInterruptEnabled(int(this), pin, enabled)
trusted fun Aw9523.setLedCurrent(pin: int, level: int): bool = abla_aw9523_setLedCurrent(int(this), pin, level)
trusted fun Aw9523.softwareReset(): bool = abla_aw9523_softwareReset(int(this))
fun Aw9523.valid(): bool = abla_aw9523_valid(int(this))
