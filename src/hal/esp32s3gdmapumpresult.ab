import "../esp32/esp32s3gdmapumpresult_type.ab"
// The Esp32S3GdmaPumpResult operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_esp32s3gdmapumpresult_events(recv: int): int
noescape extern:"c" fun abla_esp32s3gdmapumpresult_nextIndex(recv: int): int
noescape extern:"c" fun abla_esp32s3gdmapumpresult_status(recv: int): int
noescape extern:"c" fun abla_esp32s3gdmapumpresult_transferredBytes(recv: int): int
fun Esp32S3GdmaPumpResult.events(): int = abla_esp32s3gdmapumpresult_events(int(this))
fun Esp32S3GdmaPumpResult.nextIndex(): int = abla_esp32s3gdmapumpresult_nextIndex(int(this))
fun Esp32S3GdmaPumpResult.status(): int = abla_esp32s3gdmapumpresult_status(int(this))
fun Esp32S3GdmaPumpResult.transferredBytes(): int = abla_esp32s3gdmapumpresult_transferredBytes(int(this))
