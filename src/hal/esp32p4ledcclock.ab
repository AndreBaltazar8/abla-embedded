export import "../esp32/esp32p4ledcclock_type.ab"
// The Esp32P4LedcClock operations: each is a wrapper over a hook the program supplies (src/esp32/ledc_clock_p4_sequence.ab exports it under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_esp32p4ledcclock_bits(recv: int): int
noescape extern:"c" fun abla_esp32p4ledcclock_status(recv: int): int
noescape extern:"c" fun abla_esp32p4ledcclock_closeOwned(recv: int): Esp32P4LedcClock
fun Esp32P4LedcClock.bits(): int = abla_esp32p4ledcclock_bits(int(this))
fun Esp32P4LedcClock.status(): int = abla_esp32p4ledcclock_status(int(this))
trusted fun Esp32P4LedcClock.closeOwned(): Esp32P4LedcClock = abla_esp32p4ledcclock_closeOwned(int(this))
