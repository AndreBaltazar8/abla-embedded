export import "../m5stack/m5boardid_type.ab"
import "../audio/es8311_type.ab"
import "../power/m5pm1_type.ab"
import "../io_expander/m5ioe1_type.ab"
// The ES8311 board-audio operations of M5BoardId: each is a wrapper over a hook the program supplies (the board sequence module exports it under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_m5boardid_es8311SpeakerOwned(recv: int, codec: Es8311, power: M5Pm1, io: M5Ioe1, enabled: bool, exclusive: bool): int
noescape extern:"c" fun abla_m5boardid_es8311MicrophoneOwned(recv: int, codec: Es8311, expander: M5Ioe1, enabled: bool, exclusive: bool): int
noescape extern:"c" fun abla_m5boardid_ioe1Es8311SpeakerOwned(recv: int, codec: Es8311, io: M5Ioe1, enabled: bool, exclusive: bool): int
trusted fun M5BoardId.es8311SpeakerOwned(codec: Es8311, power: M5Pm1, io: M5Ioe1, enabled: bool, exclusive: bool): int = abla_m5boardid_es8311SpeakerOwned(int(this), codec, power, io, enabled, exclusive)
trusted fun M5BoardId.es8311MicrophoneOwned(codec: Es8311, expander: M5Ioe1, enabled: bool, exclusive: bool): int = abla_m5boardid_es8311MicrophoneOwned(int(this), codec, expander, enabled, exclusive)
trusted fun M5BoardId.ioe1Es8311SpeakerOwned(codec: Es8311, io: M5Ioe1, enabled: bool, exclusive: bool): int = abla_m5boardid_ioe1Es8311SpeakerOwned(int(this), codec, io, enabled, exclusive)
