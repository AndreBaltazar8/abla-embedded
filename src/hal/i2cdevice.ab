import "../i2c/device.ab"
import "../i2c/results.ab"
// The I2cDevice operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_i2cdevice_readRegister16BigEndianChecked(recv: int, register: int): I2cWordResult
noescape extern:"c" fun abla_i2cdevice_readRegister16LittleEndianChecked(recv: int, register: int): I2cWordResult
noescape extern:"c" fun abla_i2cdevice_readRegister24BigEndianChecked(recv: int, register: int): I2cDwordResult
noescape extern:"c" fun abla_i2cdevice_readRegister24LittleEndianChecked(recv: int, register: int): I2cDwordResult
noescape extern:"c" fun abla_i2cdevice_readRegister32BigEndianChecked(recv: int, register: int): I2cDwordResult
noescape extern:"c" fun abla_i2cdevice_readRegister32LittleEndianChecked(recv: int, register: int): I2cDwordResult
noescape extern:"c" fun abla_i2cdevice_updateRegister8(recv: int, register: int, mask: int, value: int): bool
noescape extern:"c" fun abla_i2cdevice_writeRegister16BigEndian(recv: int, register: int, value: int): bool
noescape extern:"c" fun abla_i2cdevice_writeRegister16LittleEndian(recv: int, register: int, value: int): bool
noescape extern:"c" fun abla_i2cdevice_writeRegister24BigEndian(recv: int, register: int,value: int): bool
noescape extern:"c" fun abla_i2cdevice_writeRegister24LittleEndian(recv: int, register: int,value: int): bool
noescape extern:"c" fun abla_i2cdevice_writeRegister32BigEndian(recv: int, register: int,value: int): bool
noescape extern:"c" fun abla_i2cdevice_writeRegister32LittleEndian(recv: int, register: int,value: int): bool
trusted fun I2cDevice.readRegister16BigEndianChecked(register: int): I2cWordResult = abla_i2cdevice_readRegister16BigEndianChecked(int(this), register)
trusted fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult = abla_i2cdevice_readRegister16LittleEndianChecked(int(this), register)
trusted fun I2cDevice.readRegister24BigEndianChecked(register: int): I2cDwordResult = abla_i2cdevice_readRegister24BigEndianChecked(int(this), register)
trusted fun I2cDevice.readRegister24LittleEndianChecked(register: int): I2cDwordResult = abla_i2cdevice_readRegister24LittleEndianChecked(int(this), register)
trusted fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult = abla_i2cdevice_readRegister32BigEndianChecked(int(this), register)
trusted fun I2cDevice.readRegister32LittleEndianChecked(register: int): I2cDwordResult = abla_i2cdevice_readRegister32LittleEndianChecked(int(this), register)
trusted fun I2cDevice.updateRegister8(register: int, mask: int, value: int): bool = abla_i2cdevice_updateRegister8(int(this), register, mask, value)
trusted fun I2cDevice.writeRegister16BigEndian(register: int, value: int): bool = abla_i2cdevice_writeRegister16BigEndian(int(this), register, value)
trusted fun I2cDevice.writeRegister16LittleEndian(register: int, value: int): bool = abla_i2cdevice_writeRegister16LittleEndian(int(this), register, value)
trusted fun I2cDevice.writeRegister24BigEndian(register: int,value: int): bool = abla_i2cdevice_writeRegister24BigEndian(int(this), register, value)
trusted fun I2cDevice.writeRegister24LittleEndian(register: int,value: int): bool = abla_i2cdevice_writeRegister24LittleEndian(int(this), register, value)
trusted fun I2cDevice.writeRegister32BigEndian(register: int,value: int): bool = abla_i2cdevice_writeRegister32BigEndian(int(this), register, value)
trusted fun I2cDevice.writeRegister32LittleEndian(register: int,value: int): bool = abla_i2cdevice_writeRegister32LittleEndian(int(this), register, value)
