// Hooks of esp32_tls: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
trusted noescape extern:"c" fun esp32TlsReadChunk(tls: u32,destination: u32,length: u32): u32
trusted noescape extern:"c" fun esp32TlsReadError(tls: u32,result: u32): void
trusted noescape extern:"c" fun esp32TlsSocketFlags(descriptor: u32,command: u32,value: u32): u32
trusted noescape extern:"c" fun esp32TlsSocketModeError(descriptor: u32,setting: bool): void
trusted noescape extern:"c" fun esp32TlsWriteChunk(tls: u32,source: u32,length: u32): u32
trusted noescape extern:"c" fun esp32TlsWriteError(tls: u32,result: u32): void
