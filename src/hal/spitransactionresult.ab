import "../spi/spitransactionresult_type.ab"
// The SpiTransactionResult operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_spitransactionresult_status(recv: int): int
noescape extern:"c" fun abla_spitransactionresult_valid(recv: int): bool
noescape extern:"c" fun abla_spitransactionresult_value(recv: int): u32
fun SpiTransactionResult.status(): int = abla_spitransactionresult_status(int(this))
fun SpiTransactionResult.valid(): bool = abla_spitransactionresult_valid(int(this))
fun SpiTransactionResult.value(): u32 = abla_spitransactionresult_value(int(this))
