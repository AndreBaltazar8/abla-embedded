// Esp32S3SleepUarts.resumeOwned as a hook on the S3 wake path (docs/hook-mocking-design.md). It runs from IRAM while
// the cache may be off: the wrapper is @inline and the definer (src/esp32/power/sleep_uarts_s3_sequence.ab) is @inline
// and placed in .iram1 itself, so the wake path never calls into flash. Host tests export their own.
import "../esp32/power/esp32s3sleepuarts_type.ab"
noescape extern:"c" fun abla_esp32s3sleepuarts_resumeOwned(recv: int): Esp32S3SleepUarts
@inline
trusted fun Esp32S3SleepUarts.resumeOwned(): Esp32S3SleepUarts = abla_esp32s3sleepuarts_resumeOwned(int(this))
