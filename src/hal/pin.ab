// The pin number type every driver and test shares (a GPIO number), and its operations: each is a wrapper over a hook the program
// supplies (a platform module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
type Pin = int
fun Pin.number(): int = this
noescape extern:"c" fun abla_pin_floating(pin: int): void
noescape extern:"c" fun abla_pin_inputOwned(pin: int): bool
noescape extern:"c" fun abla_pin_input(pin: int): void
noescape extern:"c" fun abla_pin_inputPullOwned(pin: int, pull: int): bool
noescape extern:"c" fun abla_pin_openDrainOutput(pin: int): void
noescape extern:"c" fun abla_pin_outputCapable(pin: int): bool
noescape extern:"c" fun abla_pin_outputLevelOwned(pin: int, high: bool): bool
noescape extern:"c" fun abla_pin_output(pin: int): void
noescape extern:"c" fun abla_pin_pullCapable(pin: int): bool
noescape extern:"c" fun abla_pin_pullDown(pin: int): void
noescape extern:"c" fun abla_pin_pullUp(pin: int): void
noescape extern:"c" fun abla_pin_readLevelOwned(pin: int): int
noescape extern:"c" fun abla_pin_read(pin: int): bool
noescape extern:"c" fun abla_pin_routeBidirectionalSignal(pin: int, inputSignal: int,outputSignal: int): bool
noescape extern:"c" fun abla_pin_routeInputSignal(pin: int, signal: int, inverted: bool): bool
noescape extern:"c" fun abla_pin_routeOutputSignal(pin: int, signal: int, inverted: bool): bool
noescape extern:"c" fun abla_pin_selectGpioFunction(pin: int, inputEnabled: bool): void
noescape extern:"c" fun abla_pin_setDriveStrength(pin: int, strength: int): bool
noescape extern:"c" fun abla_pin_setOpenDrain(pin: int, enabled: bool): void
noescape extern:"c" fun abla_pin_setPull(pin: int, up: bool, down: bool): void
noescape extern:"c" fun abla_pin_valid(pin: int): bool
noescape extern:"c" fun abla_pin_writeLevelOwned(pin: int, high: bool): bool
noescape extern:"c" fun abla_pin_write(pin: int, level: bool): void
trusted fun Pin.floating(): void { abla_pin_floating(int(this)) }
trusted fun Pin.input(): void { abla_pin_input(int(this)) }
trusted fun Pin.inputOwned(): bool = abla_pin_inputOwned(int(this))
trusted fun Pin.inputPullOwned(pull: int): bool = abla_pin_inputPullOwned(int(this), pull)
trusted fun Pin.openDrainOutput(): void { abla_pin_openDrainOutput(int(this)) }
trusted fun Pin.output(): void { abla_pin_output(int(this)) }
fun Pin.outputCapable(): bool = abla_pin_outputCapable(int(this))
trusted fun Pin.outputLevelOwned(high: bool): bool = abla_pin_outputLevelOwned(int(this), high)
fun Pin.pullCapable(): bool = abla_pin_pullCapable(int(this))
trusted fun Pin.pullDown(): void { abla_pin_pullDown(int(this)) }
trusted fun Pin.pullUp(): void { abla_pin_pullUp(int(this)) }
trusted fun Pin.read(): bool = abla_pin_read(int(this))
trusted fun Pin.readLevelOwned(): int = abla_pin_readLevelOwned(int(this))
trusted fun Pin.routeBidirectionalSignal(inputSignal: int,outputSignal: int): bool = abla_pin_routeBidirectionalSignal(int(this), inputSignal, outputSignal)
trusted fun Pin.routeInputSignal(signal: int, inverted: bool = false): bool = abla_pin_routeInputSignal(int(this), signal, inverted)
trusted fun Pin.routeOutputSignal(signal: int, inverted: bool = false): bool = abla_pin_routeOutputSignal(int(this), signal, inverted)
trusted fun Pin.selectGpioFunction(inputEnabled: bool): void { abla_pin_selectGpioFunction(int(this), inputEnabled) }
trusted fun Pin.setDriveStrength(strength: int): bool = abla_pin_setDriveStrength(int(this), strength)
trusted fun Pin.setOpenDrain(enabled: bool): void { abla_pin_setOpenDrain(int(this), enabled) }
trusted fun Pin.setPull(up: bool, down: bool): void { abla_pin_setPull(int(this), up, down) }
fun Pin.valid(): bool = abla_pin_valid(int(this))
trusted fun Pin.write(level: bool): void { abla_pin_write(int(this), level) }
trusted fun Pin.writeLevelOwned(high: bool): bool = abla_pin_writeLevelOwned(int(this), high)
