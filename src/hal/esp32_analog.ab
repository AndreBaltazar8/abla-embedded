// Hooks of esp32_analog: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun p4AnalogRead(offset: int): int
noescape extern:"c" fun p4AnalogWrite(offset: int,value: int): void
