export import "../esp32/psram/p4mpllowner_type.ab"
// The P4MpllOwner operations: each is a wrapper over a hook the program supplies (the P4 PSRAM sequence modules export them under their C names with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_p4mpllowner_closeOwned(recv: int, polls: int): P4MpllOwner
noescape extern:"c" fun abla_p4mpllowner_ready(recv: int): bool
noescape extern:"c" fun abla_p4mpllowner_status(recv: int): int
trusted fun P4MpllOwner.closeOwned(polls: int): P4MpllOwner = abla_p4mpllowner_closeOwned(int(this), polls)
fun P4MpllOwner.ready(): bool = abla_p4mpllowner_ready(int(this))
fun P4MpllOwner.status(): int = abla_p4mpllowner_status(int(this))
