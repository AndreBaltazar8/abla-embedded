// GpioProbePinState.restore as a hook (docs/hook-mocking-design.md): the definer is src/esp32/gpio_probe_restore_sequence.ab,
// which the platform layer (src/m5stack/detect_esp32s3.ab) imports; host tests export their own.
import "../esp32/gpio_probe_logic.ab"
noescape extern:"c" fun abla_gpioprobepinstate_restore(recv: int, pin: int): bool
trusted fun GpioProbePinState.restore(pin: int): bool = abla_gpioprobepinstate_restore(int(this), pin)
