import "../touch/ft5x06_type.ab"
// The Ft5x06 operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_ft5x06_begin(recv: int): bool
noescape extern:"c" fun abla_ft5x06_close(recv: int): bool
noescape extern:"c" fun abla_ft5x06_device(recv: int): I2cDevice
noescape extern:"c" fun abla_ft5x06_monitorMode(recv: int): bool
noescape extern:"c" fun abla_ft5x06_pollingMode(recv: int): bool
noescape extern:"c" fun abla_ft5x06_readSnapshot(recv: int, destination: NativeBuffer): int
noescape extern:"c" fun abla_ft5x06_sleep(recv: int): bool
noescape extern:"c" fun abla_ft5x06_valid(recv: int): bool
trusted fun Ft5x06.begin(): bool = abla_ft5x06_begin(int(this))
trusted fun Ft5x06.close(): bool = abla_ft5x06_close(int(this))
fun Ft5x06.device(): I2cDevice = abla_ft5x06_device(int(this))
trusted fun Ft5x06.monitorMode(): bool = abla_ft5x06_monitorMode(int(this))
trusted fun Ft5x06.pollingMode(): bool = abla_ft5x06_pollingMode(int(this))
trusted fun Ft5x06.readSnapshot(destination: NativeBuffer): int = abla_ft5x06_readSnapshot(int(this), destination)
trusted fun Ft5x06.sleep(): bool = abla_ft5x06_sleep(int(this))
fun Ft5x06.valid(): bool = abla_ft5x06_valid(int(this))
