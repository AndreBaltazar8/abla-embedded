export import "../esp32/psram/p4psramidentity_type.ab"
// The P4PsramIdentity operations: each is a wrapper over a hook the program supplies (the P4 PSRAM sequence modules export them under their C names with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_p4psramidentity_matchesProfile(recv: int, mhz: int, hex16: bool): bool
noescape extern:"c" fun abla_p4psramidentity_mode(recv: int, index: int): int
noescape extern:"c" fun abla_p4psramidentity_physicalBytes(recv: int): int
noescape extern:"c" fun abla_p4psramidentity_status(recv: int): int
fun P4PsramIdentity.matchesProfile(mhz: int, hex16: bool): bool = abla_p4psramidentity_matchesProfile(int(this), mhz, hex16)
fun P4PsramIdentity.mode(index: int): int = abla_p4psramidentity_mode(int(this), index)
fun P4PsramIdentity.physicalBytes(): int = abla_p4psramidentity_physicalBytes(int(this))
fun P4PsramIdentity.status(): int = abla_p4psramidentity_status(int(this))
