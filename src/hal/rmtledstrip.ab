import "../led/rmt_strip_state.ab"
import "../esp32/sdk/nativebuffer_type.ab"
// The RmtLedStrip DMA display operation: a wrapper over a hook the program supplies (the S3 DMA sequence module exports it under its C name with @exportLocal, or a host test's mock does; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_rmtledstrip_displayDmaOwned(recv: int, dmaChannel: int, descriptors: int, waveform: NativeBuffer, polls: int): int
trusted fun RmtLedStrip.displayDmaOwned(dmaChannel: int, descriptors: int, waveform: NativeBuffer, polls: int): int = abla_rmtledstrip_displayDmaOwned(int(this), dmaChannel, descriptors, waveform, polls)
