// Hooks for the ESP32-P4 ADC session adapters (docs/hook-mocking-design.md): the definers are in
// src/esp32/adc_session_esp32p4.ab, and host tests export their own.
import "../esp32/adc_calibration_p4_logic.ab"
import "../esp32/sdk/nativebuffer_type.ab"
noescape extern:"c" fun p4AdcSessionResourceOpen(stage: int,r: NativeBuffer,c: P4AdcCalibration,layout: int,polls: int): int
noescape extern:"c" fun p4AdcSessionMatches(c: P4AdcCalibration): bool
noescape extern:"c" fun p4AdcSessionStart(c: P4AdcCalibration): int
noescape extern:"c" fun p4AdcSessionFinish(c: P4AdcCalibration,polls: int): int
noescape extern:"c" fun p4AdcSessionRelease(c: P4AdcCalibration,polls: int): int
