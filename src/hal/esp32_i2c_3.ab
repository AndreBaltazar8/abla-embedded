// Hooks of esp32_i2c_3: declared here, supplied by the program: a platform module (or a host test's mock) exports each under its C name with
// @export, and the compiler checks the signature against this declaration (docs/hook-mocking-design.md).
noescape extern:"c" fun c5I2cSetupTiming(timing: Esp32C5I2cTiming): bool
noescape extern:"c" fun c5LpI2cSetupTiming(timing: Esp32C5LpI2cTiming): bool
