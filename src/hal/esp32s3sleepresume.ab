import "../esp32/power/esp32s3sleepresume_type.ab"
// The Esp32S3SleepResume operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_esp32s3sleepresume_apbHertz(recv: int): int
noescape extern:"c" fun abla_esp32s3sleepresume_complete(recv: int): bool
noescape extern:"c" fun abla_esp32s3sleepresume_detail(recv: int): int
noescape extern:"c" fun abla_esp32s3sleepresume_phase(recv: int): int
noescape extern:"c" fun abla_esp32s3sleepresume_status(recv: int): int
noescape extern:"c" fun abla_esp32s3sleepresume_valid(recv: int): bool
fun Esp32S3SleepResume.apbHertz(): int = abla_esp32s3sleepresume_apbHertz(int(this))
fun Esp32S3SleepResume.complete(): bool = abla_esp32s3sleepresume_complete(int(this))
fun Esp32S3SleepResume.detail(): int = abla_esp32s3sleepresume_detail(int(this))
fun Esp32S3SleepResume.phase(): int = abla_esp32s3sleepresume_phase(int(this))
fun Esp32S3SleepResume.status(): int = abla_esp32s3sleepresume_status(int(this))
fun Esp32S3SleepResume.valid(): bool = abla_esp32s3sleepresume_valid(int(this))
