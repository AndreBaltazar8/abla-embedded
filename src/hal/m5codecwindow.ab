// Hooks for the codec record and playback windows (docs/hook-mocking-design.md). The definers are in
// src/m5stack/codec_record_window_sequence.ab, es8311_channels_window_sequence.ab, codec_record_window_p4_sequence.ab
// and codec_channels_window_p4_sequence.ab; host tests export their own.
import "../m5stack/codec_window_result_types.ab"
import "../esp32/sdk/nativebuffer_type.ab"
import "../audio/pcm_channels.ab"
import "../audio/pcm_tone.ab"
import "../audio/pcm_source_queues.ab"
noescape extern:"c" fun m5CodecRecordWindowOwned(r: NativeBuffer,output: NativeBuffer,blocks: int,maxIdle: int,exclusive: bool): M5CodecRecordWindowResult
noescape extern:"c" fun m5P4RecordWindowOwned(r: NativeBuffer,output: NativeBuffer,blocks: int,maxIdle: int,exclusive: bool,tab5: bool): M5P4RecordWindowResult
noescape extern:"c" fun m5Es8311PlaybackChannelsWindowOwnedHook(r: NativeBuffer, bank: PcmChannels, blocks: int, accumulator: NativeBuffer, scratch: NativeBuffer, staging: NativeBuffer, maxIdle: int, masterGainQ15: int, exclusive: bool, tone: PcmTone, queues: PcmSourceQueues): M5Es8311PlaybackWindowResult
noescape extern:"c" fun m5P4PlaybackChannelsWindowOwnedHook(r: NativeBuffer, bank: PcmChannels, blocks: int, accumulator: NativeBuffer, scratch: NativeBuffer, staging: NativeBuffer, maxIdle: int, masterGainQ15: int, exclusive: bool, tab5: bool, tone: PcmTone, queues: PcmSourceQueues): M5P4PlaybackWindowResult
trusted fun m5Es8311PlaybackChannelsWindowOwned(r: NativeBuffer, bank: PcmChannels, blocks: int, accumulator: NativeBuffer, scratch: NativeBuffer, staging: NativeBuffer, maxIdle: int, masterGainQ15: int, exclusive: bool, tone: PcmTone=PcmTone(0), queues: PcmSourceQueues=PcmSourceQueues(0)): M5Es8311PlaybackWindowResult =
    m5Es8311PlaybackChannelsWindowOwnedHook(r, bank, blocks, accumulator, scratch, staging, maxIdle, masterGainQ15, exclusive, tone, queues)
trusted fun m5P4PlaybackChannelsWindowOwned(r: NativeBuffer, bank: PcmChannels, blocks: int, accumulator: NativeBuffer, scratch: NativeBuffer, staging: NativeBuffer, maxIdle: int, masterGainQ15: int, exclusive: bool, tab5: bool, tone: PcmTone=PcmTone(0), queues: PcmSourceQueues=PcmSourceQueues(0)): M5P4PlaybackWindowResult =
    m5P4PlaybackChannelsWindowOwnedHook(r, bank, blocks, accumulator, scratch, staging, maxIdle, masterGainQ15, exclusive, tab5, tone, queues)
