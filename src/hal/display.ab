// One LCD program command on a C5 master: the hook takes the data as address and size; a caller passes the buffer.
trusted fun c5LcdProgramCommand(master: int,dc: int,command: int,data: NativeBuffer,bytes: int,polls: int): SpiBufferResult =
    SpiBufferResult(c5LcdProgramCommandHook(master,dc,command,data.addressValue(),bytes,polls))
