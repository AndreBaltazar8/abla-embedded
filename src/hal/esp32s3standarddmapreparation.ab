import "../esp32/i2s/esp32s3standarddmapreparation_type.ab"
// The Esp32S3StandardDmaPreparation operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_esp32s3standarddmapreparation_sampleRate(recv: int): int
noescape extern:"c" fun abla_esp32s3standarddmapreparation_status(recv: int): int
noescape extern:"c" fun abla_esp32s3standarddmapreparation_valid(recv: int): bool
fun Esp32S3StandardDmaPreparation.sampleRate(): int = abla_esp32s3standarddmapreparation_sampleRate(int(this))
fun Esp32S3StandardDmaPreparation.status(): int = abla_esp32s3standarddmapreparation_status(int(this))
fun Esp32S3StandardDmaPreparation.valid(): bool = abla_esp32s3standarddmapreparation_valid(int(this))
