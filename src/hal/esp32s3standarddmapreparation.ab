import "../esp32/i2s/esp32s3standarddmapreparation_type.ab"
import "./pin.ab"
// The Esp32S3StandardDmaPreparation operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun esp32s3PrepareStandard16DmaHook(port: int, transmit: bool, mclk: int, bclk: int, ws: int, data: int, slots: int, sampleHz: int, channel: int, descriptors: int, count: int, buffers: int, blockBytes: int, owner: int, duplicateMono: bool): int
noescape extern:"c" fun abla_esp32s3standarddmapreparation_sampleRate(recv: int): int
noescape extern:"c" fun abla_esp32s3standarddmapreparation_status(recv: int): int
noescape extern:"c" fun abla_esp32s3standarddmapreparation_valid(recv: int): bool
fun Esp32S3StandardDmaPreparation.sampleRate(): int = abla_esp32s3standarddmapreparation_sampleRate(int(this))
fun Esp32S3StandardDmaPreparation.status(): int = abla_esp32s3standarddmapreparation_status(int(this))
fun Esp32S3StandardDmaPreparation.valid(): bool = abla_esp32s3standarddmapreparation_valid(int(this))
// Prepare one standard 16-bit I2S + GDMA direction; the hook takes pins and owner as plain integers (the driver module, or a host test, exports it).
trusted fun esp32s3PrepareStandard16Dma(port: int, transmit: bool, mclk: Pin, bclk: Pin, ws: Pin, data: Pin,
    slots: int, sampleHz: int, channel: int,
    descriptors: int, count: int, buffers: int, blockBytes: int, owner: u32, duplicateMono: bool = false): Esp32S3StandardDmaPreparation =
    Esp32S3StandardDmaPreparation(esp32s3PrepareStandard16DmaHook(port, transmit, int(mclk), int(bclk), int(ws), int(data), slots, sampleHz, channel, descriptors, count, buffers, blockBytes, int(owner), duplicateMono))
