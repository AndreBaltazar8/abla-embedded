import "../esp32/gpio/s3gpiosnapshot_type.ab"
// The S3GpioSnapshot operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_s3gpiosnapshot_pin(recv: int): int
noescape extern:"c" fun abla_s3gpiosnapshot_prepareProbeInputOwned(recv: int, pull: int,exclusive: bool): int
noescape extern:"c" fun abla_s3gpiosnapshot_readProbeInputOwned(recv: int, exclusive: bool): int
noescape extern:"c" fun abla_s3gpiosnapshot_valid(recv: int): bool
noescape extern:"c" fun abla_s3gpiosnapshot_restoreOwned(recv: int, quiescentOwners: bool): int
fun S3GpioSnapshot.pin(): int = abla_s3gpiosnapshot_pin(int(this))
trusted fun S3GpioSnapshot.prepareProbeInputOwned(pull: int,exclusive: bool): int = abla_s3gpiosnapshot_prepareProbeInputOwned(int(this), pull, exclusive)
trusted fun S3GpioSnapshot.readProbeInputOwned(exclusive: bool): int = abla_s3gpiosnapshot_readProbeInputOwned(int(this), exclusive)
fun S3GpioSnapshot.valid(): bool = abla_s3gpiosnapshot_valid(int(this))
trusted fun S3GpioSnapshot.restoreOwned(quiescentOwners: bool): int = abla_s3gpiosnapshot_restoreOwned(int(this), quiescentOwners)
