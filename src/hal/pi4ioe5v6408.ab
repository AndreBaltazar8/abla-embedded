// The Pi4Ioe5v6408 operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_pi4ioe5v6408_begin(recv: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_close(recv: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_device(recv: int): I2cDevice
noescape extern:"c" fun abla_pi4ioe5v6408_digitalReadChecked(recv: int, pin: int): I2cByteResult
noescape extern:"c" fun abla_pi4ioe5v6408_digitalRead(recv: int, pin: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_disableInterrupt(recv: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_enableInterrupt(recv: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_getWriteValueChecked(recv: int, pin: int): I2cByteResult
noescape extern:"c" fun abla_pi4ioe5v6408_getWriteValue(recv: int, pin: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_prepareNessoDisplayOwned(recv: int, exclusiveCsInactive: bool): int
noescape extern:"c" fun abla_pi4ioe5v6408_resetInterrupt(recv: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_setDirection(recv: int, pin: int, output: bool): bool
noescape extern:"c" fun abla_pi4ioe5v6408_setInterruptMask(recv: int, enabledPins: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_setNessoBacklightOwned(recv: int, brightness: int,exclusive: bool): bool
noescape extern:"c" fun abla_pi4ioe5v6408_setPullMode(recv: int, pin: int, mode: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_valid(recv: int): bool
noescape extern:"c" fun abla_pi4ioe5v6408_digitalWrite(recv: int, pin: int, level: bool): bool
trusted fun Pi4Ioe5v6408.begin(): bool = abla_pi4ioe5v6408_begin(int(this))
trusted fun Pi4Ioe5v6408.close(): bool = abla_pi4ioe5v6408_close(int(this))
fun Pi4Ioe5v6408.device(): I2cDevice = abla_pi4ioe5v6408_device(int(this))
trusted fun Pi4Ioe5v6408.digitalRead(pin: int): bool = abla_pi4ioe5v6408_digitalRead(int(this), pin)
trusted fun Pi4Ioe5v6408.digitalReadChecked(pin: int): I2cByteResult = abla_pi4ioe5v6408_digitalReadChecked(int(this), pin)
trusted fun Pi4Ioe5v6408.disableInterrupt(): bool = abla_pi4ioe5v6408_disableInterrupt(int(this))
trusted fun Pi4Ioe5v6408.enableInterrupt(): bool = abla_pi4ioe5v6408_enableInterrupt(int(this))
trusted fun Pi4Ioe5v6408.getWriteValue(pin: int): bool = abla_pi4ioe5v6408_getWriteValue(int(this), pin)
trusted fun Pi4Ioe5v6408.getWriteValueChecked(pin: int): I2cByteResult = abla_pi4ioe5v6408_getWriteValueChecked(int(this), pin)
trusted fun Pi4Ioe5v6408.prepareNessoDisplayOwned(exclusiveCsInactive: bool): int = abla_pi4ioe5v6408_prepareNessoDisplayOwned(int(this), exclusiveCsInactive)
trusted fun Pi4Ioe5v6408.resetInterrupt(): bool = abla_pi4ioe5v6408_resetInterrupt(int(this))
trusted fun Pi4Ioe5v6408.setDirection(pin: int, output: bool): bool = abla_pi4ioe5v6408_setDirection(int(this), pin, output)
trusted fun Pi4Ioe5v6408.setInterruptMask(enabledPins: int): bool = abla_pi4ioe5v6408_setInterruptMask(int(this), enabledPins)
trusted fun Pi4Ioe5v6408.setNessoBacklightOwned(brightness: int,exclusive: bool): bool = abla_pi4ioe5v6408_setNessoBacklightOwned(int(this), brightness, exclusive)
trusted fun Pi4Ioe5v6408.setPullMode(pin: int, mode: int): bool = abla_pi4ioe5v6408_setPullMode(int(this), pin, mode)
fun Pi4Ioe5v6408.valid(): bool = abla_pi4ioe5v6408_valid(int(this))
trusted fun Pi4Ioe5v6408.digitalWrite(pin: int, level: bool): bool = abla_pi4ioe5v6408_digitalWrite(int(this), pin, level)
