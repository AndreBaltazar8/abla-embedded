import "../audio/es8311_type.ab"
// The Es8311 operations: each is a wrapper over a hook the program supplies (the driver module, or a host test's mock, exports it under the C name with @export; docs/hook-mocking-design.md).
noescape extern:"c" fun abla_es8311_close(recv: int): bool
noescape extern:"c" fun abla_es8311_configureSpeakerMclk25624kOwned(recv: int, exclusive: bool): int
noescape extern:"c" fun abla_es8311_device(recv: int): I2cDevice
noescape extern:"c" fun abla_es8311_microphoneBclkOwned(recv: int, enabled: bool, exclusive: bool, adcVolume: int): int
noescape extern:"c" fun abla_es8311_valid(recv: int): bool
trusted fun Es8311.close(): bool = abla_es8311_close(int(this))
trusted fun Es8311.configureSpeakerMclk25624kOwned(exclusive: bool): int = abla_es8311_configureSpeakerMclk25624kOwned(int(this), exclusive)
fun Es8311.device(): I2cDevice = abla_es8311_device(int(this))
trusted fun Es8311.microphoneBclkOwned(enabled: bool, exclusive: bool, adcVolume: int = 255): int = abla_es8311_microphoneBclkOwned(int(this), enabled, exclusive, adcVolume)
fun Es8311.valid(): bool = abla_es8311_valid(int(this))
