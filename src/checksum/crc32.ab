import "abla/unsafe/mmio"

val crc32IeeePolynomial: u32 = u32(3988292384)
val crc32IeeeInitial: u32 = u32(4294967295)

@inline
fun crc32IeeeUpdateByte(crc: u32, byte: u8): u32 {
    var value = crc ^ u32(byte)
    value = (value >> u32(1)) ^ (crc32IeeePolynomial &
        (u32(0) - (value & u32(1))))
    value = (value >> u32(1)) ^ (crc32IeeePolynomial &
        (u32(0) - (value & u32(1))))
    value = (value >> u32(1)) ^ (crc32IeeePolynomial &
        (u32(0) - (value & u32(1))))
    value = (value >> u32(1)) ^ (crc32IeeePolynomial &
        (u32(0) - (value & u32(1))))
    value = (value >> u32(1)) ^ (crc32IeeePolynomial &
        (u32(0) - (value & u32(1))))
    value = (value >> u32(1)) ^ (crc32IeeePolynomial &
        (u32(0) - (value & u32(1))))
    value = (value >> u32(1)) ^ (crc32IeeePolynomial &
        (u32(0) - (value & u32(1))))
    (value >> u32(1)) ^ (crc32IeeePolynomial &
        (u32(0) - (value & u32(1))))
}

@inline
fun crc32IeeeFinalize(crc: u32): u32 = ~crc

// Allocation-free reflected CRC-32/ISO-HDLC over an existing native byte
// range. IEEE 802.11, Ethernet, gzip, and ZIP use this polynomial and bit
// convention. The caller owns the range and must keep it readable throughout.
@inline
trusted fun crc32IeeeNative(address: u32, length: u32): u32 {
    var crc = crc32IeeeInitial
    var current = address
    var remaining = length
    while (remaining != u32(0)) {
        val byte = u8(ablaUnsafeVolatileLoadU8(i64(current)))
        crc = crc32IeeeUpdateByte(crc, byte)
        current = current + u32(1)
        remaining = remaining - u32(1)
    }
    crc32IeeeFinalize(crc)
}
