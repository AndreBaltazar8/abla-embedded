import "../esp32/sdk/raw_buffer.ab"

// M5GFX command/count/arguments[/delay] encoding, exactFF,FF terminator.
// Caller supplies immutable bytes for validation and the entire execution.
trusted fun lcdCommandBufferValid(program: NativeBuffer, length: int): bool {
    if (!program.hasAddressRange(0, length) || length < 2) return false
    var index = 0
    while (index + 1 < length) {
        val command = program.load(index)
        val encoded = program.load(index + 1)
        index = index + 2
        if (command == 255 && encoded == 255) return index == length
        index = index + (encoded & 127)
        if (index > length) return false
        if ((encoded & 128) != 0) {
            if (index >= length) return false
            index = index + 1
        }
    }
    false
}
