import "./spi_lcd.ab"
import "./spi_mipi_esp32s3.ab"
import "./spi_blit_esp32s3.ab"
import "./spi_fill_esp32s3.ab"
import "./spi_control_esp32s3.ab"

@inline
trusted fun spiLcdSetSleep(gate: PeripheralGate, owner: u32, peripheral: int,
    pins: SpiPins, select: Pin, dc: Pin, sleeping: bool, settle: int, shared: bool): SpiTransactionResult =
    esp32s3LcdSetSleep(gate,owner,peripheral,pins,select,dc,sleeping,settle,shared)
@inline
trusted fun spiLcdSetIdle(gate: PeripheralGate, owner: u32, peripheral: int,
    pins: SpiPins, select: Pin, dc: Pin, idle: bool, shared: bool): SpiTransactionResult =
    esp32s3LcdSetIdle(gate,owner,peripheral,pins,select,dc,idle,shared)

@inline
trusted fun spiLcdSetRotation(gate: PeripheralGate, owner: u32, peripheral: int,
    pins: SpiPins, select: Pin, dc: Pin, geometry: LcdGeometry, rotation: int,
    bgr: bool, shared: bool): SpiTransactionResult =
    esp32s3LcdSetRotation(gate,owner,peripheral,pins,select,dc,geometry,rotation,bgr,shared)
@inline
trusted fun spiLcdSetInverted(gate: PeripheralGate, owner: u32, peripheral: int,
    pins: SpiPins, select: Pin, dc: Pin, inverted: bool, shared: bool): SpiTransactionResult =
    esp32s3LcdSetInverted(gate,owner,peripheral,pins,select,dc,inverted,shared)

@inline
trusted fun spiLcdFillRect(gate: PeripheralGate, owner: u32, peripheral: int,
    pins: SpiPins, select: Pin, dc: Pin, view: LcdView, x: int, y: int,
    width: int, height: int, color: Rgb565, shared: bool): SpiTransactionResult =
    esp32s3LcdFillRect(gate,owner,peripheral,pins,select,dc,view,x,y,width,height,color,shared)

@inline
fun spiLcdPinsValid(peripheral: int, pins: SpiPins, select: Pin, dc: Pin, shared: bool): bool =
    esp32s3SpiCommandPinsValid(peripheral, pins, select, dc, shared)
@inline
trusted fun spiLcdBeginRgb565(gate: PeripheralGate, owner: u32, peripheral: int,
    pins: SpiPins, select: Pin, dc: Pin, geometry: LcdGeometry, rotation: int,
    program: NativeBuffer, extra: NativeBuffer, inverted: bool, bgr: bool, shared: bool): SpiTransactionResult =
    esp32s3LcdBeginRgb565(gate, owner, peripheral, pins, select, dc, geometry, rotation,
        program, extra, inverted, bgr, shared)
@inline
trusted fun spiLcdBlitRgb565(gate: PeripheralGate, owner: u32, peripheral: int,
    pins: SpiPins, select: Pin, dc: Pin, view: LcdView, x: int, y: int,
    source: NativeBuffer, width: int, height: int, stride: int, little: bool,
    staging: NativeBuffer, shared: bool): SpiTransactionResult =
    esp32s3LcdBlitRgb565(gate, owner, peripheral, pins, select, dc, view, x, y,
        source, width, height, stride, little, staging, shared)
