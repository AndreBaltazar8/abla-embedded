import "./i80_clock_s3_sequence.ab"
import "../esp32/rcc_esp32s3.ab"
import "abla/unsafe/mmio"
trusted fun esp32S3I80ClockRead(address: int): int = mmioLoadU32(address)
trusted fun esp32S3I80ClockWrite(address: int,value: int): void { mmioStoreU32(address,value);return }
// Unique nonzero RCC owner token. False leaves any already enabled domain
// enabled; retry while retaining peripheral ownership. Never wait for DMA
// or external hardware while this short shared lock is held.
trusted fun esp32S3LcdDmaEnableClock(owner: u32): bool {
    val lock=esp32S3RccSharedLock()
    val saved=esp32S3RccTryEnter(lock,owner)
    if (saved < 0) return false
    val enabled=esp32S3LcdDmaEnableClockLocked()
    atomicMemoryFence()
    val released=esp32S3RccLeave(lock,owner,saved)
    return enabled && released
}
