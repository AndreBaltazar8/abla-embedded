import "./dsi_frame_rearm_p4_sequence.ab"
import "./dsi_frame_publish_esp32p4.ab"
import "../esp32/dsi_start_esp32p4.ab"
trusted fun p4DsiAcknowledgeFrameChannel(channel: int,events: int): int = esp32P4DwDmaAcknowledgeOwned(channel,events)
trusted fun esp32P4DsiFrameRearmImmutable(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): int = esp32P4DsiFrameRearmImmutableOwned(channel,descriptor,frame,bytes,line,polls)
