import "./text_console.ab"
import "./epd_canvas.ab"
// Classic byte-font console on the EPD packed4 canvas. Colors are direct
// levels0..15; high nibble is even x. Same CR/LF/deferred-wrap semantics as
// RGB565 console. Complete6x8 scaled cells only; margins remain unchanged.
// Pure RAM: caller submits dirty region and pumps display separately.
trusted fun TextCursor.writeGray4Owned(buffer: NativeBuffer,width: int,height: int,text: NativeBuffer,length: int,foreground: int,background: int,scale: int = 1): TextCursor {
    if (!this.valid() || !epdCanvasDimensions(width,height) || scale < 1 || scale > 8 || width < 6*scale || height < 8*scale ||
        !buffer.hasAddressRange(0,epdCanvasSize(width,height)) || length < 0 || length > 65536 || !text.hasAddressRange(0,length) ||
        foreground < 0 || foreground > 15 || background < 0 || background > 15 ||
        (length > 0 && !epdWaveformDisjoint(buffer,epdCanvasSize(width,height),text,length))) return TextCursor(0)
    val columns=int(u32(width)/u32(6*scale));val rows=int(u32(height)/u32(8*scale))
    var column=this.column();var row=this.row()
    if (column > columns || row >= rows) return TextCursor(0)
    val stride=(width+1)/2
    var index=0
    while (index < length) {
        val character=text.load(index)
        if (character == 13) column=0
        else if (character == 10) { column=0;row=row+1 }
        else if (character >= 32) {
            if (column == columns) { column=0;row=row+1 }
            if (row == rows) {
                textScrollGray4Owned(buffer,stride,columns*3*scale,rows*8*scale,8*scale,background)
                row=rows-1
            }
            var gy=0
            while (gy < 8*scale) {
                var gx=0
                while (gx < 6*scale) {
                    val bits=classicFontColumn(character,int(u32(gx)/u32(scale)))
                    val ink=(u32(bits)&(u32(1)<<u32(u32(gy)/u32(scale)))) != u32(0)
                    val color=if (ink) foreground else background
                    val px=column*6*scale+gx;val py=row*8*scale+gy
                    val offset=py*stride+px/2;val shift=if ((px&1) == 0) 4 else 0
                    buffer.store(offset,(buffer.load(offset)&(255^(15<<shift)))|(color<<shift))
                    gx=gx+1
                }
                gy=gy+1
            }
            column=column+1
        }
        if (row == rows) {
            textScrollGray4Owned(buffer,stride,columns*3*scale,rows*8*scale,8*scale,background)
            row=rows-1
        }
        index=index+1
    }
    return textCursor(column,row)
}
// Internal prevalidated region. Complete cell widths are even, so copying
// whole packed bytes never touches a neighboring margin nibble.
trusted fun textScrollGray4Owned(buffer: NativeBuffer,stride: int,rowBytes: int,height: int,lineHeight: int,background: int): void {
    var row=0
    while (row < height) {
        var byte=0
        while (byte < rowBytes) {
            val value=if (row+lineHeight < height) buffer.load((row+lineHeight)*stride+byte) else background*17
            buffer.store(row*stride+byte,value);byte=byte+1
        }
        row=row+1
    }
    return
}
