import "./co5300_sequence_esp32s3.ab"
import "./command_buffer.ab"
// Validate the immutable program before I/O and retain the canonical gate
// through every command and delay. CS is released between commands/delays.
trusted fun esp32s3Co5300RunProgram(gate: PeripheralGate,owner: u32,peripheral: int,
    pins: QuadSpiPins,select: Pin,program: NativeBuffer): SpiTransactionResult {
    val bytes=program.capacity()
    if (!esp32s3SpiQuadTransmitPinsValid(peripheral,pins,select) ||
        !esp32s3SpiMemoryRangeValid(peripheral,program,bytes) || !gate.bufferDisjoint(program,bytes) ||
        !lcdCommandBufferValid(program,bytes) || gate.word().address() <= 0 || gate.word().address() > 4294967292)
        return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    var offset=0
    var detail=1
    while (offset+1 < bytes) {
        val command=program.load(offset)
        val encoded=program.load(offset+1)
        if (command == 255 && encoded == 255) break
        val count=encoded&127
        offset=offset+2
        detail=esp32s3Co5300TransferOwned(peripheral,select,command,
            nativeBufferAt(program.addressValue()+offset,count),count,false)
        if ((detail&255) != 1) break
        offset=offset+count
        if ((encoded&128) != 0) {
            val wait=program.load(offset);offset=offset+1
            if (wait != 0) peripheralDelayMilliseconds(if (wait == 255) 500 else wait)
        }
    }
    val healthy=(detail&255) == 1
    if (!gate.finish(owner,healthy)) return SpiTransactionResult((5<<32)|detail)
    return SpiTransactionResult(((if (healthy) 1 else 6)<<32)|detail)
}
