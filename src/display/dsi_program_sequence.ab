import "../esp32/dsi_short_p4_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
// Length-prefixed command+parameters, terminated by a single zero byte.
// Prevalidate the WHOLE buffer before any command, including its terminator.
trusted fun dsiProgramValid(program: NativeBuffer): bool {
    val size=program.capacity()
    if (size < 1 || size > 65535 || !program.hasAddressRange(0,size)) return false
    var offset=0
    while (offset < size) {
        val length=program.load(offset)
        if (length == 0) return offset == size-1
        if (length >= size-offset) return false
        offset=offset+length+1
    }
    false
}
// Exclusive initialized command host/panel; no blind replay after failures.
trusted fun dsiRunProgramOwned(channel: int,program: NativeBuffer,polls: int): DsiCommandResult {
    if (channel < 0 || channel > 3 || polls < 1 || polls > 1000000 || !dsiProgramValid(program)) return DsiCommandResult(2)
    var offset=0
    while (program.load(offset) != 0) {
        val length=program.load(offset)
        val result=dsiProgramWrite(channel,nativeBufferAt(program.addressValue()+offset+1,length),length,polls)
        if (!result.hostComplete()) return result
        offset=offset+length+1
    }
    DsiCommandResult(1)
}
