import "abla/runtime/scalar"
import "../esp32/sdk/raw_buffer.ab"
// Waveform data and transition semantics adapted from M5GFX/LovyanGFX
// src/lgfx/v1/platforms/esp32/Panel_EPD.cpp, author lovyan03.
// See epd_waveform.LICENSE for the upstream notice.
// Packed two-bit actions for 16 gray levels. Modes: eraser0,quality1,text2,fast3,fastest4.
val epdWaveformRows=nativeStaticU32s([
    1609214634,
    1431656442,
    4294967295,
    0,
    1432982869,
    2863311530,
    2863311530,
    1431655765,
    1431655765,
    1431721301,
    3579418021,
    2845464917,
    2779424437,
    2863311531,
    2863311531,
    2863311701,
    2868204885,
    3579139415,
    3942645759,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    0,
    1789569706,
    1789569706,
    1789569706,
    1785375402,
    1785375146,
    2673825129,
    2639779197,
    2506447485,
    3848886967,
    2863311509,
    2863310165,
    3218429269,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
    4294967295,
