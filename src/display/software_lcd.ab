import "./software_mipi.ab"
import "./software_blit.ab"

// Four byte-sized pin numbers plus validity/shared-D/C bits; no allocation or hidden
// bus ownership. Board code retains the canonical gate, power/reset/backlight
// controls and initialized view. Pins outside 0..255 are rejected, not masked.
// Shared D/C is input while idle and driven only inside owned transactions.
type SoftwareLcd = int

@inline
fun softwareLcd(clock: Pin, mosi: Pin, chipSelect: Pin, dataCommand: Pin,
    sharedDataCommand: bool = false): SoftwareLcd {
    if (clock.number() < 0 || clock.number() > 255 || mosi.number() < 0 || mosi.number() > 255 ||
        chipSelect.number() < 0 || chipSelect.number() > 255 || dataCommand.number() < 0 || dataCommand.number() > 255 ||
        !softwareSpiCommandPinsValid(clock, mosi, chipSelect, dataCommand, 0, 0)) return SoftwareLcd(0)
    SoftwareLcd((1 << 32) | clock.number() | (mosi.number() << 8) |
        (chipSelect.number() << 16) | (dataCommand.number() << 24) |
        (if (sharedDataCommand) 1 << 33 else 0))
}

@inline
fun SoftwareLcd.clockPin(): Pin = Pin(this & 255)
@inline
fun SoftwareLcd.mosiPin(): Pin = Pin((this >>> 8) & 255)
@inline
fun SoftwareLcd.chipSelectPin(): Pin = Pin((this >>> 16) & 255)
@inline
fun SoftwareLcd.dataCommandPin(): Pin = Pin((this >>> 24) & 255)
@inline
fun SoftwareLcd.sharedDataCommand(): bool = (this & (1 << 33)) != 0
@inline
fun SoftwareLcd.valid(): bool = (this >>> 34) == 0 && (this & (1 << 32)) != 0 &&
    softwareSpiCommandPinsValid(this.clockPin(), this.mosiPin(), this.chipSelectPin(), this.dataCommandPin(), 0, 0)

// Caller must own these pads and keep every other device's CS inactive. This
// does not reserve pins or initialize panel power/reset. Latches are written
// before enabling outputs, CS first, while the canonical bus gate is held.
trusted fun SoftwareLcd.configurePins(gate: PeripheralGate, owner: u32): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    this.chipSelectPin().write(true)
    this.chipSelectPin().output()
    this.dataCommandPin().write(true)
    if (this.sharedDataCommand()) this.dataCommandPin().input()
    else this.dataCommandPin().output()
    this.clockPin().write(false)
    this.clockPin().output()
    this.mosiPin().write(false)
    this.mosiPin().output()
    if (!gate.finish(owner, true)) return SpiTransactionResult(5 << 32)
    SpiTransactionResult(1 << 32)
}

@inline
trusted fun SoftwareLcd.beginRgb565(gate: PeripheralGate, owner: u32,
    geometry: LcdGeometry, rotation: int, program: NativeBuffer, extraProgram: NativeBuffer,
    inverted: bool = false, bgrOrder: bool = true, halfPeriodMicroseconds: int = 1): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    softwareLcdBeginRgb565(gate, owner, this.clockPin(), this.mosiPin(), this.chipSelectPin(), this.dataCommandPin(),
        geometry, rotation, program, extraProgram, inverted, bgrOrder, halfPeriodMicroseconds, this.sharedDataCommand())
}

@inline
trusted fun SoftwareLcd.fillRect(gate: PeripheralGate, owner: u32, view: LcdView,
    x: int, y: int, width: int, height: int, color: Rgb565, halfPeriodMicroseconds: int = 1): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    softwareLcdFillRect(gate, owner, this.clockPin(), this.mosiPin(), this.chipSelectPin(), this.dataCommandPin(),
        view, x, y, width, height, color, halfPeriodMicroseconds, this.sharedDataCommand())
}

@inline
trusted fun SoftwareLcd.blitRgb565(gate: PeripheralGate, owner: u32, view: LcdView,
    x: int, y: int, source: NativeBuffer, width: int, height: int, stride: int,
    littleEndian: bool = false, halfPeriodMicroseconds: int = 1): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    softwareLcdBlitRgb565(gate, owner, this.clockPin(), this.mosiPin(), this.chipSelectPin(), this.dataCommandPin(),
        view, x, y, source, width, height, stride, littleEndian, halfPeriodMicroseconds, this.sharedDataCommand())
}
