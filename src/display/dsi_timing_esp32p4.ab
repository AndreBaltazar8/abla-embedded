import "./dsi_timing_p4_sequence.ab"
import "../esp32/dsi_start_esp32p4.ab"
trusted fun esp32P4DsiSetTimings(hsync: int,hback: int,width: int,hfront: int,vsync: int,vback: int,height: int,vfront: int,laneKbps: int,expectedDpiKhz: int,actualDpiKhz: int,polls: int): DsiCommandResult =
    esp32P4DsiSetTimingsOwned(hsync,hback,width,hfront,vsync,vback,height,vfront,laneKbps,expectedDpiKhz,actualDpiKhz,polls)
