import "./glyph_rgb565.ab"
// Cell coordinates plus pending-wrap column; invalid scalar0. No global
// cursor or heap. Retain returned cursor across writes using same geometry.
type TextCursor = int
fun textCursor(column: int = 0,row: int = 0): TextCursor = if (column < 0 || column > 65535 || row < 0 || row > 65535) TextCursor(0) else TextCursor((1<<32)|(row<<16)|column)
fun TextCursor.valid(): bool = (this>>>32) == 1
fun TextCursor.column(): int = this&65535
fun TextCursor.row(): int = (this>>16)&65535
// Internal: prevalidated surface, lineHeight<=height. Copies top-down because
// source rows lie above destination addresses; padding is never read/written.
trusted fun textScrollRgb565Owned(buffer: NativeBuffer,width: int,height: int,stride: int,lineHeight: int,background: int,littleEndian: bool): void {
    var row=0
    while (row < height) {
        var byte=0
        while (byte < width*2) {
            val value=if (row+lineHeight < height) buffer.load((row+lineHeight)*stride+byte) else
                if (((byte&1) == 0) == littleEndian) background&255 else background>>8
            buffer.store(row*stride+byte,value)
            byte=byte+1
        }
        row=row+1
    }
    return
}
// Fixed classic-font console in RGB565 RAM. CR returns to column0; LF starts
// a new row; other controls<32 are ignored. Bytes32..255 are font indices,
// not UTF8. Automatic wrap is deferred until the next printable byte. Scroll
// by one cell row at bottom. Complete cells only; right/bottom margins and
// stride padding are untouched. Opaque cells, scale1..8, max65536 inputbytes.
// Entire surface and immutable text must be owned/disjoint during operation.
// Invalid input returns invalid cursor without modifying the framebuffer.
trusted fun TextCursor.writeRgb565Owned(buffer: NativeBuffer,width: int,height: int,stride: int,text: NativeBuffer,length: int,foreground: int,background: int,scale: int = 1,littleEndian: bool = false): TextCursor {
    if (!this.valid() || !lcdRgb565SourceValid(buffer,width,height,stride) || scale < 1 || scale > 8 || width < 6*scale || height < 8*scale ||
        length < 0 || length > 65536 || !text.hasAddressRange(0,length) || foreground < 0 || foreground > 65535 || background < 0 || background > 65535) return TextCursor(0)
    val span=(height-1)*stride+width*2
    if (length > 0 && text.addressValue() < buffer.addressValue()+span && buffer.addressValue() < text.addressValue()+length) return TextCursor(0)
    val columns=int(u32(width)/u32(6*scale))
    val rows=int(u32(height)/u32(8*scale))
    var column=this.column()
    var row=this.row()
    if (column > columns || row >= rows) return TextCursor(0)
    var index=0
    while (index < length) {
        val character=text.load(index)
        if (character == 13) column=0
        else if (character == 10) { column=0; row=row+1 }
        else if (character >= 32) {
            if (column == columns) { column=0; row=row+1 }
            if (row == rows) {
                textScrollRgb565Owned(buffer,columns*6*scale,rows*8*scale,stride,8*scale,background,littleEndian)
                row=rows-1
            }
            drawClassicGlyphRgb565(buffer,width,height,stride,column*6*scale,row*8*scale,character,foreground,background,scale,false,littleEndian)
            column=column+1
        }
        if (row == rows) {
            textScrollRgb565Owned(buffer,columns*6*scale,rows*8*scale,stride,8*scale,background,littleEndian)
            row=rows-1
        }
        index=index+1
    }
    return textCursor(column,row)
}
