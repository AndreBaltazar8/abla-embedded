import "./spi_program_c5_sequence.ab"
import "../esp32/spi/command_data_esp32c5.ab"
import "../esp32/peripheral_delay_esp32c5.ab"
trusted fun c5LcdProgramAdmission(value: int,dc: int): bool {
    val master=Esp32C5SpiMaster(value)
    return master.ready() && dc >= 0 && dc < 29 && dc != master.pins().pinAt(0) &&
        dc != master.pins().pinAt(1) && dc != master.pins().pinAt(2) && dc != master.pins().pinAt(3) &&
        c5SpiMasterDataReady(master,false) && c5SpiManualSelectReady(dc)
}
trusted fun c5LcdProgramCommand(master: int,dc: int,command: int,data: NativeBuffer,bytes: int,polls: int): SpiBufferResult =
    c5SpiCommandDataOwned(Esp32C5SpiMaster(master),dc,command,data,bytes,polls)
