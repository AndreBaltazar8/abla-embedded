import "../esp32/sdk/raw_buffer.ab"

// P4 DSI uses DW-GDMA, NOT the distinct AXI-DMA descriptor format.
// Layout/transfer fields: ESP-IDF dw_gdma_ll.h and esp_lcd_panel_dpi.c.
// Caller owns an INACTIVE 64-byte aligned descriptor and DMA-readable frame.
// Addresses must be DMA-visible, with no physical alias between the regions.
// This checks numeric spans only, not accessibility or cached/uncached aliases.
// No cache synchronization, channel start or ownership handoff happens here:
// synchronize descriptor AND pixels before making the list visible to DMA.
// The framebuffer and descriptor must remain alive until DMA is stopped.
// Return false without writes on invalid input. No truncated final 64-bit item.
trusted fun esp32P4DsiFrameDescriptorPrepareOwned(descriptor: NativeBuffer,frame: NativeBuffer,bytes: int): bool {
    if (bytes < 8 || bytes > 33554432 || (bytes&7) != 0 ||
        !descriptor.hasAddressRange(0,64) || !frame.hasAddressRange(0,bytes)) return false
    val address=descriptor.addressValue()
    val source=frame.addressValue()
    if ((address&63) != 0 || (source&7) != 0 ||
        (address < source+bytes && source < address+64)) return false
    // Clear all high addresses, reserved words, status writebacks and markers.
    var offset=0
    while (offset < 64) { descriptor.storeU32(offset,0); offset=offset+4 }
    descriptor.storeU32(0,source)
    descriptor.storeU32(8,1343246336) // DSI bridge FIFO 0x50105000
    descriptor.storeU32(16,int((u32(bytes)>>u32(3))-u32(1)))
    // Terminal next address is zero, but LMS=1 still selects memory master.
    descriptor.storeU32(24,1)
    // memory -> fixed peripheral; 64-bit items; source512/destination256 bursts.
    descriptor.storeU32(32,1|64|(3<<8)|(3<<11)|(8<<14)|(7<<18))
    // Explicit ARLEN/AWLEN=16; last+valid; no block interrupt/status writeback.
    // Valid is stored last, but this is NOT a cache or release barrier.
    descriptor.storeU32(36,64|(16<<7)|32768|(16<<16)|1073741824|2147483648)
    return true
}
