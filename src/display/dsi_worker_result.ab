// Low48 = complete DMA rearm report; bits48..49 coalesced bridge events;
// bits56..59 worker status:0service report,1invalid,2admission,3mailbox fault,
// 4resume failure,5gate misuse. Status0 does NOT imply DMA service succeeded;
// inspect service() low8 for the actual rearm outcome.
type P4DsiWorkerResult = int
fun P4DsiWorkerResult.status(): int = (this>>>56)&15
fun P4DsiWorkerResult.service(): int = this&281474976710655
fun P4DsiWorkerResult.events(): int = (this>>>48)&3
fun p4DsiWorkerResult(status: int,service: int,events: int): P4DsiWorkerResult =
    P4DsiWorkerResult((status<<56)|(service&281474976710655)|((events&3)<<48))
