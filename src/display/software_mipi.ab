import "./software_program.ab"
import "./software_rgb565.ab"

// Panel power/reset and pin configuration are board-owned prerequisites.
// Both programs are fully validated before GPIO. Pass an empty buffer for no
// extra program. Keep their bytes immutable throughout the operation.
// Backlight may be enabled by the board only after successful completion.
// On success use geometry.view(rotation, bgrOrder) for subsequent drawing.
// Shared D/C starts as input and is released after every CS window, including
// initialization commands and pauses. Every bus user must share this gate.
trusted fun softwareLcdBeginRgb565(gate: PeripheralGate, owner: u32,
    clock: Pin, mosi: Pin, chipSelect: Pin, dataCommand: Pin,
    geometry: LcdGeometry, rotation: int, program: NativeBuffer,
    extraProgram: NativeBuffer, inverted: bool = false, bgrOrder: bool = true,
    halfPeriodMicroseconds: int = 1, sharedDataCommand: bool = false): SpiTransactionResult {
    if (!geometry.valid() || rotation < 0 || rotation > 7 ||
        !softwareSpiCommandPinsValid(clock, mosi, chipSelect, dataCommand, 0, halfPeriodMicroseconds) ||
        !gate.bufferDisjoint(program, program.capacity()) || !gate.bufferDisjoint(extraProgram, extraProgram.capacity()) ||
        !lcdCommandBufferValid(program, program.capacity()) ||
        (extraProgram.capacity() != 0 && !lcdCommandBufferValid(extraProgram, extraProgram.capacity()))) {
        return SpiTransactionResult(3 << 32)
    }
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    var completed = softwareLcdRunProgramOwned(clock, mosi, chipSelect, dataCommand,
        program, program.capacity(), halfPeriodMicroseconds, sharedDataCommand)
    if (completed && extraProgram.capacity() != 0) {
        completed = softwareLcdRunProgramOwned(clock, mosi, chipSelect, dataCommand,
            extraProgram, extraProgram.capacity(), halfPeriodMicroseconds, sharedDataCommand)
    }
    if (completed) {
        val view = geometry.view(rotation, bgrOrder)
        clock.write(false)
        softwareLcdCommandWordOwned(clock, mosi, chipSelect, dataCommand,
            u32(58), u32(85), 8, halfPeriodMicroseconds, sharedDataCommand)
        softwareLcdCommandWordOwned(clock, mosi, chipSelect, dataCommand,
            u32(54), u32(view.madctl()), 8, halfPeriodMicroseconds, sharedDataCommand)
        completed = softwareLcdCommandOwned(clock, mosi, chipSelect, dataCommand,
            if (inverted) 33 else 32, nativeBufferAt(0, 0), 0, halfPeriodMicroseconds, sharedDataCommand)
    }
    if (!gate.finish(owner, completed)) return SpiTransactionResult(5 << 32)
    SpiTransactionResult((if (completed) 1 else 6) << 32)
}
