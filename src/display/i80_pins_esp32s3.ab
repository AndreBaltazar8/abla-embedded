import "./i80_pins_s3_sequence.ab"
import "../esp32/gpio_esp32s3.ab"
import "../hal/esp32_gpio.ab"
import "../hal/display.ab"
import "../hal/display_3.ab"
import "../hal/esp32_gpio_3.ab"
@export("s3I80PinValid")
trusted fun s3I80PinValidHook(number: int): bool = espChipS3().gpioOutputValid(number)
@export("s3I80PinCapture")
trusted fun s3I80PinCaptureHook(number: int): S3GpioSnapshot = esp32S3GpioSnapshotOwned(number,true)
@export("s3I80PinPark")
trusted fun s3I80PinParkHook(number: int): bool = esp32S3GpioParkOutputOwned(number)
@export("s3I80PinRestore")
trusted fun s3I80PinRestoreHook(saved: S3GpioSnapshot): int = saved.restoreOwned(true)
@export("s3I80PinRoute")
trusted fun s3I80PinRouteHook(number: int,signal: int,inverted: bool): bool {
    if (!Pin(number).routeOutputSignal(signal,inverted)) return false
    val bank=esp32S3GpioBankOffset(number)
    return (esp32S3PinStateRead(0x60004020+bank)&(1<<(number&31))) != 0 &&
        (esp32S3PinStateRead(0x60004074+number*4)&4) == 0 &&
        (esp32S3PinStateRead(esp32S3GpioMuxAddress(number))&0x7200) == 0x1000 &&
        (esp32S3PinStateRead(0x60004554+number*4)&4095) == (signal|(if (inverted) 512 else 0))
}
