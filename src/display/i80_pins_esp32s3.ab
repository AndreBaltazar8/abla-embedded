import "./i80_pins_s3_sequence.ab"
import "../esp32/gpio_esp32s3.ab"
trusted fun s3I80PinValid(number: int): bool = espChipS3().gpioOutputValid(number)
trusted fun s3I80PinCapture(number: int): S3GpioSnapshot = esp32S3GpioSnapshotOwned(number,true)
trusted fun s3I80PinPark(number: int): bool = esp32S3GpioParkOutputOwned(number)
trusted fun s3I80PinRestore(saved: S3GpioSnapshot): int = saved.restoreOwned(true)
trusted fun s3I80PinRoute(number: int,signal: int,inverted: bool): bool {
    if (!Pin(number).routeOutputSignal(signal,inverted)) return false
    val bank=esp32S3GpioBankOffset(number)
    return (esp32S3PinStateRead(0x60004020+bank)&(1<<(number&31))) != 0 &&
        (esp32S3PinStateRead(0x60004074+number*4)&4) == 0 &&
        (esp32S3PinStateRead(esp32S3GpioMuxAddress(number))&0x7200) == 0x1000 &&
        (esp32S3PinStateRead(0x60004554+number*4)&4095) == (signal|(if (inverted) 512 else 0))
}
