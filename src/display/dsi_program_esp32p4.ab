import "./dsi_program_sequence.ab"
import "../esp32/dsi_long_esp32p4.ab"
import "../esp32/dsi_short_esp32p4.ab"
trusted fun dsiProgramWrite(channel: int,payload: NativeBuffer,length: int,polls: int): DsiCommandResult {
    if (length <= 2) return esp32P4DsiDcsShort(channel,payload.load(0),if (length == 1) -1 else payload.load(1),polls)
    esp32P4DsiLongWrite(channel,57,payload,length,polls)
}
trusted fun esp32P4DsiRunProgram(channel: int,program: NativeBuffer,polls: int): DsiCommandResult = dsiRunProgramOwned(channel,program,polls)
