import "./it8951_image.ab"
// Controller power commands only, not board rail/pin ownership. Serialize
// against image loads and other users. A failed/unfinished load must first be
// repaired or reset; idle LUTs alone do not prove the load parser is closed.
// Sleep requires an external hardware reset and full initialization to wake,
// matching M5GFX; SYS_RUN is only the standby-resume path.
// Stage7idle8command. Preserve caller ownership on any failure, including a
// write that may have reached hardware despite a reported transport error.
trusted fun it8951EnterLowPower(context: int,sleep: bool,scratch: NativeBuffer,
    polls: int,attempts: int,exclusive: bool): It8951ImageResult {
    if (!exclusive || !it8951Admission(context,polls) || !scratch.hasAddressRange(0,2) ||
        attempts < 1 || attempts > 3000) return It8951ImageResult(2)
    val idle=it8951WaitDisplayIdle(context,scratch,polls,attempts)
    if (idle != 1) return It8951ImageResult(idle|1792)
    val command=it8951Command(context,if (sleep) 3 else 2,NativeBuffer(0),0,polls)
    It8951ImageResult(command.status()|2048)
}
trusted fun it8951ResumeStandby(context: int,polls: int,exclusive: bool): It8951ImageResult {
    if (!exclusive) return It8951ImageResult(2)
    val command=it8951Command(context,1,NativeBuffer(0),0,polls)
    It8951ImageResult(command.status()|2048)
}
