import "./it8951_session.ab"
// Raw16-bit VCOM calibration protocol from M5GFX Panel_IT8951. This is NOT
// brightness. Only use a replacement established for the actual panel; the
// transport cannot validate its electrical suitability. Never called by init.
// No persistent-programming command is issued, matching upstream setVCOM.
type It8951VcomRead = int
fun It8951VcomRead.status(): int = this&255
fun It8951VcomRead.valid(): bool = this >= 1 && (this>>>24) == 0 && this.status() == 1
fun It8951VcomRead.value(): int = if (this.valid()) (this>>>8)&65535 else -1
trusted fun it8951ReadVcomRaw(context: int,scratch: NativeBuffer,polls: int): It8951VcomRead {
    if (!scratch.hasAddressRange(0,2)) return It8951VcomRead(2)
    val command=it8951Command(context,57,NativeBuffer(0),0,polls)
    if (!command.success()) return It8951VcomRead(command.status())
    val selector=it8951WriteWord(context,0,polls)
    if (!selector.success()) return It8951VcomRead(selector.status())
    it8951TransportDelay(context,1000)
    val read=it8951ReadWords(context,scratch,1,polls)
    if (!read.success()) return It8951VcomRead(read.status())
    It8951VcomRead(1|(scratch.loadU16(0)<<8))
}
type It8951VcomChange = int
fun It8951VcomChange.status(): int = this&255
fun It8951VcomChange.success(): bool = this == 1 || this == 257
// True only for a confirmed write. False on failure DOES NOT prove no change.
fun It8951VcomChange.changed(): bool = this == 257
// Serialized read/compare/write, not a hardware atomic operation. Status6
// means expected-current mismatch, no write attempted. Equal old/new is a
// read-only success; failed reads never become a guessed old value.
trusted fun it8951SetVcomRawIf(context: int,expected: int,replacement: int,
    scratch: NativeBuffer,polls: int): It8951VcomChange {
    if (expected < 0 || expected > 65535 || replacement < 0 || replacement > 65535) return It8951VcomChange(2)
    val before=it8951ReadVcomRaw(context,scratch,polls)
    if (!before.valid()) return It8951VcomChange(before.status())
    if (before.value() != expected) return It8951VcomChange(6)
    if (before.value() == replacement) return It8951VcomChange(1)
    val command=it8951Command(context,57,NativeBuffer(0),0,polls)
    if (!command.success()) return It8951VcomChange(command.status())
    val selector=it8951WriteWord(context,1,polls)
    if (!selector.success()) return It8951VcomChange(selector.status())
    val written=it8951WriteWord(context,replacement,polls)
    It8951VcomChange(if (written.success()) 257 else written.status())
}
trusted fun It8951Session.readVcomRawOwned(scratch: NativeBuffer,polls: int,exclusive: bool): It8951VcomRead {
    if (!exclusive || this.state() != 1 || !this.disjoint(scratch,2)) return It8951VcomRead(2)
    val result=it8951ReadVcomRaw(this.context(),scratch,polls)
    if (result.status() != 2) {
        this.remember(result|0)
        if (!result.valid()) this.buffer().storeU32(4,2)
    }
    result
}
trusted fun It8951Session.setVcomRawIfOwned(expected: int,replacement: int,scratch: NativeBuffer,
    polls: int,exclusive: bool): It8951VcomChange {
    if (!exclusive || this.state() != 1 || !this.disjoint(scratch,2)) return It8951VcomChange(2)
    val result=it8951SetVcomRawIf(this.context(),expected,replacement,scratch,polls)
    if (result.status() != 2) {
        this.remember(result|0)
        if (!result.success() && result.status() != 6) this.buffer().storeU32(4,2)
    }
    result
}
