import "./it8951_image.ab"
// IT8951 has no pixel-read command: M5GFX uses MEM_BST_RD_T(address,count),
// MEM_BST_RD_S, then dummy-prefixed word reads. No implicit reset or refresh.
// Destination contains little-endian host u16s, exactly like upstream's swapped
// read_words buffer. These are RAW controller memory, not expanded RGB pixels.
// Caller owns an idle initialized controller and knows the requested RAM range;
// a32-bit address-span check cannot prove installed controller RAM capacity.
// Fault after starting the burst retains caller ownership for explicit recovery.
// Stage9configure10start11read, completed WORDS only in the read phase.
trusted fun it8951ReadMemoryWords(context: int,address: int,destination: NativeBuffer,count: int,
    scratch: NativeBuffer,polls: int): It8951ImageResult {
    if (!it8951Admission(context,polls) || address < 0 || address > 4294967295 || (address&3) != 0 ||
        count < 1 || count > 65535 || address > 4294967296-count*2 ||
        !destination.hasAddressRange(0,count*2) || !scratch.hasAddressRange(0,8) ||
        (destination.addressValue() < scratch.addressValue()+8 && scratch.addressValue() < destination.addressValue()+count*2))
        return It8951ImageResult(2)
    scratch.storeU16(0,address&65535);scratch.storeU16(2,address>>>16)
    scratch.storeU16(4,count);scratch.storeU16(6,0)
    val configure=it8951Command(context,18,scratch,4,polls)
    if (!configure.success()) return It8951ImageResult(configure.status()|2304)
    val start=it8951Command(context,19,NativeBuffer(0),0,polls)
    if (!start.success()) return It8951ImageResult(start.status()|2560)
    val read=it8951ReadWords(context,destination,count,polls)
    It8951ImageResult(read.status()|2816|(read.completed()<<16))
}
