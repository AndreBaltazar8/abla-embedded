import "./epd_canvas.ab"
// Rotate/mirror a complete packed4bpp logical image into a physical image for
// it8951Load4(rotation0). Matches IT8951's inverse hardware rotation plus the
// upstream software mirror step, using the shared eight-orientation mapping.
// Width/height are physical dimensions; odd rotations swap source dimensions.
// Use it8951ConvertRgbForRotationOwned before rotating RGB input: mirrored
// orientations need mirrored Bayer Y as well. Padding remains caller-owned.
// Two disjoint caller buffers, no allocation, bus access or hidden state.
trusted fun it8951Rotate4Owned(source: NativeBuffer,sourceStride: int,destination: NativeBuffer,
    destinationStride: int,width: int,height: int,rotation: int,exclusive: bool): bool {
    if (!exclusive || !epdCanvasDimensions(width,height) || rotation < 0 || rotation > 7) return false
    val logicalWidth=if ((rotation&1) == 0) width else height
    val logicalHeight=if ((rotation&1) == 0) height else width
    if (sourceStride < (logicalWidth+1)/2 || sourceStride > 2147483647 ||
        destinationStride < (width+1)/2 || destinationStride > 2147483647) return false
    val sourceBytes=(logicalHeight-1)*sourceStride+(logicalWidth+1)/2
    val destinationBytes=(height-1)*destinationStride+(width+1)/2
    if (!source.hasAddressRange(0,sourceBytes) || !destination.hasAddressRange(0,destinationBytes) ||
        (source.addressValue() < destination.addressValue()+destinationBytes &&
            destination.addressValue() < source.addressValue()+sourceBytes)) return false
    var y=0
    while (y < logicalHeight) {
        var x=0
        while (x < logicalWidth) {
            val packed=source.load(y*sourceStride+x/2)
            val value=if ((x&1) == 0) packed>>>4 else packed&15
            val position=epdCanvasPosition(width,height,x,y,rotation)
            val px=position&65535;val py=position>>>16
            val target=py*destinationStride+px/2
            val before=destination.load(target)
            destination.store(target,if ((px&1) == 0) (before&15)|(value<<4) else (before&240)|value)
            x=x+1
        }
        y=y+1
    }
    true
}
