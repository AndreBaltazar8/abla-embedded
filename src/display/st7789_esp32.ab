import "./mipi_rgb565_esp32.ab"
import "./mipi_commands.ab"
import "./lcd_logic.ab"
import "./mipi_rgb565_sequence_esp32.ab"

trusted fun SpiLcd.beginSt7789(
    geometry: LcdGeometry,
    rotation: int = 0,
    inverted: bool = false,
    bgrOrder: bool = true
): LcdView = this.beginMipiRgb565(
    geometry, rotation, st7789InitCommands, "", inverted, bgrOrder
)
