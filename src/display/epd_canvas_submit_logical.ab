import "./epd_canvas.ab"
// Queue a clipped LOGICAL rectangle after drawing. Orthogonal rotations map
// its opposite corners to the physical bounding rectangle. Underlying submit
// expands to pixel pairs using the neighboring canvas pixel, and validates all
// affected waveform records before changing any. No hardware writes or draw.
// Caller serializes canvas/state with frame pumping; buffers stay disjoint.
trusted fun epdCanvasSubmitLogicalOwned(canvas: NativeBuffer,state: NativeBuffer,width: int,height: int,x: int,y: int,w: int,h: int,rotation: int,mode: int,exclusive: bool): bool {
    if (!exclusive || !epdCanvasDimensions(width,height) || (width&15) != 0 || rotation < 0 || rotation > 7 || mode < 1 || mode > 4 ||
        x < -2147483648 || x > 2147483647 || y < -2147483648 || y > 2147483647 ||
        w < 0 || w > 65535 || h < 0 || h > 65535 ||
        !canvas.hasAddressRange(0,width*height/2) || !state.hasAddressRange(0,width*height*2) ||
        !epdWaveformDisjoint(canvas,width*height/2,state,width*height*2)) return false
    if (w == 0 || h == 0) return true
    val logicalWidth=if ((rotation&1) == 0) width else height
    val logicalHeight=if ((rotation&1) == 0) height else width
    val left=if (x < 0) 0 else x
    val top=if (y < 0) 0 else y
    val right=if (x+w > logicalWidth) logicalWidth else x+w
    val bottom=if (y+h > logicalHeight) logicalHeight else y+h
    if (right <= left || bottom <= top) return true
    val first=epdCanvasPosition(width,height,left,top,rotation)
    val last=epdCanvasPosition(width,height,right-1,bottom-1,rotation)
    val ax=first&65535;val ay=first>>>16;val bx=last&65535;val by=last>>>16
    val px=if (ax < bx) ax else bx;val py=if (ay < by) ay else by
    val pw=(if (ax > bx) ax else bx)-px+1
    val ph=(if (ay > by) ay else by)-py+1
    return epdCanvasSubmitOwned(canvas,state,width,height,px,py,pw,ph,mode,true)
}
