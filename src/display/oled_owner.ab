import "./oled_i2c.ab"
// Exclusive caller-owned32B: magic/status/device/original-open-error,
// profile64/last-publication32/reserved. Select an oledOwnerBufferSafe backend
// adapter. Bus/reset/power remain borrowed; close this owner before the bus.
// Never copy ownership or reinitialize live storage. No allocation of buffers.
type OledOwner=int
fun oledOwnerAt(storage: NativeBuffer): OledOwner =
    if (storage.hasAddressRange(0,32) && (storage.addressValue()&3) == 0 && oledOwnerBufferSafe(storage,32)) OledOwner(storage|0) else OledOwner(0)
fun OledOwner.buffer(): NativeBuffer = NativeBuffer(this|0)
trusted fun OledOwner.valid(): bool = oledOwnerAt(this.buffer()) != 0 && this.buffer().loadU32(0) == 0x4f4c4431
trusted fun OledOwner.status(): int = if (this.valid()) this.buffer().loadU32(4) else -1
trusted fun OledOwner.device(): I2cDevice = I2cDevice(if (this.valid()) this.buffer().loadU32(8) else 0)
trusted fun OledOwner.profile(): OledProfile = OledProfile(if (this.valid()) this.buffer().loadU32(16)|(this.buffer().loadU32(20)<<32) else 0)
trusted fun OledOwner.openFailure(): int = if (this.valid()) this.buffer().loadU32(12) else -1
trusted fun OledOwner.lastPublication(): int = if (this.valid()) this.buffer().loadU32(24) else 0
trusted fun OledOwner.ready(): bool = this.status() == 1 && this.device().valid() && this.profile().valid()
trusted fun OledOwner.initializeFresh(): bool {
    if (oledOwnerAt(this.buffer()) == 0) return false
    var offset=4;while (offset < 32) { this.buffer().storeU32(offset,0);offset=offset+4 }
    this.buffer().storeU32(0,0x4f4c4431);return true
}
fun OledOwner.disjoint(buffer: NativeBuffer,length: int): bool =
    oledOwnerBufferSafe(buffer,length) && (buffer.addressValue()+length <= this.buffer().addressValue() ||
        buffer.addressValue() >= this.buffer().addressValue()+32)
//0closed1ready2admission3allocation4initialization5sleep6release.
// Failed initialization deliberately retains the device for explicit close;
// acknowledged initialization bytes may already have altered the display.
trusted fun OledOwner.openOwned(bus: I2cBus,profile: OledProfile,scratch: NativeBuffer,exclusive: bool,address: int = 60): int {
    if (!exclusive || this.status() != 0 || (this.device()|0) != 0 || !bus.valid() || !profile.valid() ||
        address < 1 || address > 127 || !this.disjoint(scratch,28)) return 2
    this.buffer().storeU32(12,0);this.buffer().storeU32(24,0)
    this.buffer().storeU32(16,profile&0xffffffff);this.buffer().storeU32(20,profile>>>32)
    val device=bus.device(address,400000)
    this.buffer().storeU32(8,device|0)
    val status=if (!device.valid()) 3 else if (!device.oledInitialize(profile,scratch)) 4 else 1
    this.buffer().storeU32(4,status);this.buffer().storeU32(12,if (status == 1) 0 else status)
    return status
}
trusted fun OledOwner.displayOwned(frame: NativeBuffer,scratch: NativeBuffer,exclusive: bool): int {
    return this.displayRegionOwned(frame,scratch,0,0,this.profile().width(),this.profile().height(),exclusive)
}
trusted fun OledOwner.displayRegionOwned(frame: NativeBuffer,scratch: NativeBuffer,x: int,y: int,w: int,h: int,exclusive: bool): int {
    if (!exclusive || !this.ready()) return 2
    val profile=this.profile();val work=if (profile.width()+1 < 7) 7 else profile.width()+1
    if (!this.disjoint(frame,monoPageSize(profile.width(),profile.height())) || !this.disjoint(scratch,work)) return 2
    val result=this.device().oledDisplayRegion(profile,frame,scratch,x,y,w,h)
    this.buffer().storeU32(24,result);return result
}
trusted fun OledOwner.closeOwned(scratch: NativeBuffer,exclusive: bool): bool {
    if (!exclusive || !this.valid() || !this.disjoint(scratch,2)) return false
    if ((this.device()|0) != 0) {
        if (!this.device().oledSetSleep(true,scratch)) { this.buffer().storeU32(4,5);return false }
        if (!this.device().close()) { this.buffer().storeU32(4,6);return false }
    }
    this.buffer().storeU32(8,0);this.buffer().storeU32(4,0);return true
}
