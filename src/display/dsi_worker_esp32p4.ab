import "./dsi_worker_p4_sequence.ab"
import "./dsi_mailbox_esp32p4.ab"
import "./dsi_frame_rearm_esp32p4.ab"
import "../riscv/machine_status.ab"
import "../hal/display.ab"
import "../esp32/sdk/raw_buffer.ab"
import "./dsi_frame_rearm_p4_sequence.ab"
import "../esp32/sdk/nativebuffer_type.ab"
@export("p4DsiWorkerMask")
trusted fun p4DsiWorkerMaskHook(): u32 = riscvMachineInterruptSaveDisable()
@export("p4DsiWorkerRestore")
trusted fun p4DsiWorkerRestoreHook(saved: u32): void = riscvMachineInterruptRestore(saved)
@export("p4DsiWorkerRearm")
trusted fun p4DsiWorkerRearmHook(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): int =
    esp32P4DsiFrameRearmImmutableOwned(channel,descriptor,frame,bytes,line,polls)
