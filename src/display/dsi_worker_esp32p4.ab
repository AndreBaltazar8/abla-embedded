import "./dsi_worker_p4_sequence.ab"
import "./dsi_mailbox_esp32p4.ab"
import "./dsi_frame_rearm_esp32p4.ab"
import "../riscv/machine_status.ab"
trusted fun p4DsiWorkerMask(): u32 = riscvMachineInterruptSaveDisable()
trusted fun p4DsiWorkerRestore(saved: u32): void = riscvMachineInterruptRestore(saved)
trusted fun p4DsiWorkerRearm(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): int =
    esp32P4DsiFrameRearmImmutableOwned(channel,descriptor,frame,bytes,line,polls)
