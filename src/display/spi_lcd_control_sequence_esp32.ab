// Caller owns the initialized panel and serializes its display lifecycle.
// Bus ownership spans controller settling, but no backlight/rail state or
// application draw/touch geometry is changed implicitly.
trusted fun SpiLcd.controlRegister(
    command: int, value: int, bytes: int, settleMilliseconds: int
): bool {
    if (!this.valid() || command < 0 || command > 255 ||
        bytes < 0 || bytes > 1 || value < 0 || value > 255 ||
        settleMilliseconds < 0 || settleMilliseconds > 5000) return false
    val data = nativeBufferAt(nativeStackAllocate(1),1)
    data.store(0,value)
    if (!this.device().acquire()) return false
    val written = this.writeCommandSelected(command,data,bytes)
    if (written && settleMilliseconds != 0) taskDelay(settleMilliseconds)
    this.device().release()
    written
}

// Publish geometry.view(rotation,bgr) to drawing/touch only after success.
trusted fun SpiLcd.setRotation(
    geometry: LcdGeometry, rotation: int, bgr: bool = true
): bool {
    if (!geometry.valid() || rotation < 0 || rotation > 7) return false
    this.controlRegister(54,geometry.view(rotation,bgr).madctl(),1,0)
}

trusted fun SpiLcd.setInverted(inverted: bool): bool =
    this.controlRegister(if (inverted) 33 else 32,0,0,0)

trusted fun SpiLcd.setSleep(sleeping: bool, settleMilliseconds: int): bool =
    this.controlRegister(if (sleeping) 16 else 17,0,0,settleMilliseconds)

trusted fun SpiLcd.setIdle(idle: bool): bool =
    this.controlRegister(if (idle) 57 else 56,0,0,0)
