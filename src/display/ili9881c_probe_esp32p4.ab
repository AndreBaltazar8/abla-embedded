import "./ili9881c_probe_sequence.ab"
import "../esp32/dsi_long_esp32p4.ab"
import "../esp32/dsi_read_esp32p4.ab"
trusted fun ili9881cDsiWrite(channel: int,payload: NativeBuffer,polls: int): DsiCommandResult =
    esp32P4DsiLongWrite(channel,57,payload,4,polls)
trusted fun ili9881cDsiRead(channel: int,command: int,reply: NativeBuffer,polls: int): DsiCommandResult =
    esp32P4DsiDcsRead(channel,command,reply,1,polls)
trusted fun ili9881cProbeEsp32P4(channel: int,scratch: NativeBuffer,polls: int): Ili9881cProbe =
    ili9881cProbeOwned(channel,scratch,polls)
