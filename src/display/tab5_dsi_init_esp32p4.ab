import "./tab5_dsi_init_sequence.ab"
import "./dsi_program_esp32p4.ab"
import "../esp32/peripheral_delay_esp32p4.ab"
trusted fun dsiPanelDelayMilliseconds(milliseconds: int): void { peripheralDelayMilliseconds(milliseconds); return }
trusted fun tab5DsiInitMadctl(channel: int,polls: int): DsiCommandResult = esp32P4DsiDcsShort(channel,54,0,polls)
trusted fun tab5DsiInitColmod(channel: int,polls: int): DsiCommandResult = esp32P4DsiDcsShort(channel,58,85,polls)
trusted fun tab5DsiInitEsp32P4(panel: int,channel: int,polls: int): DsiCommandResult = tab5DsiInitOwned(panel,channel,polls)
