import "./tab5_dsi_init_sequence.ab"
import "./dsi_program_esp32p4.ab"
import "../esp32/peripheral_delay_esp32p4.ab"
import "../hal/delay.ab"
import "../hal/display.ab"
import "../hal/display_3.ab"
@export("dsiPanelDelayMilliseconds")
trusted fun dsiPanelDelayMillisecondsHook(milliseconds: int): void { peripheralDelayMilliseconds(milliseconds); return }
@export("tab5DsiInitMadctl")
trusted fun tab5DsiInitMadctlHook(channel: int,polls: int): DsiCommandResult = esp32P4DsiDcsShort(channel,54,0,polls)
@export("tab5DsiInitColmod")
trusted fun tab5DsiInitColmodHook(channel: int,polls: int): DsiCommandResult = esp32P4DsiDcsShort(channel,58,85,polls)
trusted fun tab5DsiInitEsp32P4(panel: int,channel: int,polls: int): DsiCommandResult = tab5DsiInitOwned(panel,channel,polls)
