import "./text_console.ab"
// M5Unified display log palette in RGB332, expanded to RGB565. Styling is
// per-call; caller's normal foreground/background are never changed.
fun displayLogColor565(level: int): int {
    val rgb=if (level == 1) 0xe0 else if (level == 2) 0xfc else if (level == 3) 0x18 else if (level == 4) 0x1f else if (level == 5) 0x92 else 255
    val r=(rgb>>5)&7
    val g=(rgb>>2)&7
    val b=rgb&3
    return (((r<<2)|(r>>1))<<11)|(((g<<3)|g)<<5)|((b<<3)|(b<<1)|(b>>1))
}
// Render message plus built-in suffix as a single console update. Pure RAM;
// caller flushes/publishes framebuffer separately and retains returnedcursor
// on a transfer error to avoid appending the same message twice on retry.
trusted fun TextCursor.logRgb565Owned(buffer: NativeBuffer,width: int,height: int,stride: int,text: NativeBuffer,length: int,level: int,color: bool,foreground: int,background: int,suffix: int,scale: int = 1,littleEndian: bool = false): TextCursor {
    if (level < 0 || level > 5 || suffix < 0 || suffix > 2 || foreground < 0 || foreground > 65535) return TextCursor(0)
    val ink=if (color && level != 0) displayLogColor565(level) else foreground
    val cursor=this.writeRgb565Owned(buffer,width,height,stride,text,length,ink,background,scale,littleEndian)
    if (!cursor.valid() || suffix == 0) return cursor
    // CRLF and LF have identical console cursor semantics; one LF suffices.
    return cursor.writeRgb565Owned(buffer,width,height,stride,nativeBufferAt(nativeStaticBytes("\n"),1),1,ink,background,scale,littleEndian)
}
