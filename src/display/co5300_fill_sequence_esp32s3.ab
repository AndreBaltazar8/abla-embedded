import "./co5300_sequence_esp32s3.ab"
import "./color.ab"
// Direct GRAM fill: inclusive bounds, even column start/even width required
// by CO5300. Reject unsupported windows before any I/O instead of writing to
// an old window. Arbitrary odd pixels require a caller-owned shadow framebuffer.
// Caller supplies resolved GRAM coordinates and owns the current orientation.
trusted fun esp32s3Co5300Fill(gate: PeripheralGate,owner: u32,peripheral: int,
    pins: QuadSpiPins,select: Pin,x: int,y: int,width: int,height: int,color: Rgb565): SpiTransactionResult {
    if (!esp32s3SpiQuadTransmitPinsValid(peripheral,pins,select) || x < 0 || y < 0 ||
        width < 1 || height < 1 || x > 65535 || y > 65535 || width > 65536-x || height > 65536-y ||
        (x&1) != 0 || (width&1) != 0 || gate.word().address() <= 0 || gate.word().address() > 4294967292)
        return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    val bytes=nativeBufferAt(nativeStackAllocate(64),64)
    // CASET and RASET payloads are big endian, independent of host byte order.
    bytes.store(0,x>>>8);bytes.store(1,x);bytes.store(2,(x+width-1)>>>8);bytes.store(3,x+width-1)
    var detail=esp32s3Co5300TransferOwned(peripheral,select,42,bytes,4,false)
    if ((detail&255) == 1) {
        bytes.store(0,y>>>8);bytes.store(1,y);bytes.store(2,(y+height-1)>>>8);bytes.store(3,y+height-1)
        detail=esp32s3Co5300TransferOwned(peripheral,select,43,bytes,4,false)
    }
    if ((detail&255) == 1) {
        var i=0
        while (i < 64) { bytes.store(i,(color&65535)>>>8);bytes.store(i+1,color&255);i=i+2 }
        detail=esp32s3SpiExchangeReady(peripheral)
        if (detail == 1) {
            detail=esp32s3SpiSelectBegin(select)
            var remaining=width*height
            var first=true
            while (remaining > 0 && (detail&255) == 1) {
                val count=if (remaining < 32) remaining else 32
                detail=esp32s3SpiQuadTransmitOwned(peripheral,if (first) 50 else 0,if (first) 8 else 0,
                    if (first) 0x2c00 else 0,if (first) 24 else 0,0,bytes,count*2,100000)
                first=false;remaining=remaining-count
            }
            detail=esp32s3SpiSelectEnd(select,detail)
        }
    }
    val healthy=(detail&255) == 1
    if (!gate.finish(owner,healthy)) return SpiTransactionResult((5<<32)|detail)
    return SpiTransactionResult(((if (healthy) 1 else 6)<<32)|detail)
}
