import "./it8951_protocol.ab"
// GET_DEV_INFO:20 little-endian host words after the transport's wire decode.
// Width,height,image-address low/high, eight firmware and eight LUT words.
// This value describes reported geometry, NOT ownership or successful startup.
type It8951DeviceInfo = int
fun It8951DeviceInfo.width(): int = this & 65535
fun It8951DeviceInfo.height(): int = (this>>>16)&65535
fun It8951DeviceInfo.imageAddress(): int = this>>>32
fun It8951DeviceInfo.valid(): bool = this.width() > 0 && this.height() > 0 &&
    this.imageAddress() > 0 && this.imageAddress() < 4294967295 &&
    this.imageAddress() <= 4294967296-this.width()*this.height()
// Address-span check uses the controller's byte-per-pixel image layout. It
// does not prove installed RAM capacity or that a selected panel matches it.
trusted fun it8951DeviceInfo(response: NativeBuffer): It8951DeviceInfo {
    if (!response.hasAddressRange(0,40)) return It8951DeviceInfo(0)
    val info=It8951DeviceInfo(response.loadU16(0)|(response.loadU16(2)<<16)|
        (response.loadU16(4)<<32)|(response.loadU16(6)<<48))
    if (info.valid()) info else It8951DeviceInfo(0)
}
trusted fun it8951ReadDeviceInfo(context: int,response: NativeBuffer,polls: int): It8951Transfer {
    if (!response.hasAddressRange(0,40)) return It8951Transfer(2)
    val command=it8951Command(context,770,NativeBuffer(0),0,polls)
    if (!command.success()) return command
    it8951TransportDelay(context,1000)
    it8951ReadWords(context,response,20,polls)
}
type It8951Initialization = int
fun It8951Initialization.status(): int = this&255
fun It8951Initialization.stage(): int = (this>>>8)&255
fun It8951Initialization.success(): bool = this == 1
// Caller owns an already powered, reset and configured transport exclusively.
// NO reset/VCOM/refresh command or arbitrary fallback image address is applied.
// Failure may leave a partially configured controller; preserve ownership and
// repair/reset explicitly before using it. Do not use scratch as fresh info
// unless this returned success. The response stays intact after its read.
// status1success2admission3busy4transport5CS6invalid-info; stage1read-info,
// 2validate-info,3RUN,4packed-write,5image-high,6image-low.
trusted fun it8951Initialize(context: int,response: NativeBuffer,polls: int): It8951Initialization {
    if (!it8951Admission(context,polls) || !response.hasAddressRange(0,40)) return It8951Initialization(2)
    val read=it8951ReadDeviceInfo(context,response,polls)
    if (!read.success()) return It8951Initialization(read.status()|256)
    val info=it8951DeviceInfo(response)
    if (!info.valid()) return It8951Initialization(6|512)
    val run=it8951Command(context,1,NativeBuffer(0),0,polls)
    if (!run.success()) return It8951Initialization(run.status()|768)
    val packed=it8951WriteRegister(context,4,1,polls)
    if (!packed.success()) return It8951Initialization(packed.status()|1024)
    val high=it8951WriteRegister(context,522,info.imageAddress()>>>16,polls)
    if (!high.success()) return It8951Initialization(high.status()|1280)
    val low=it8951WriteRegister(context,520,info.imageAddress()&65535,polls)
    if (!low.success()) return It8951Initialization(low.status()|1536)
    It8951Initialization(1)
}
