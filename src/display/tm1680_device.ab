import "./tm1680.ab"
// Borrowed device on selected I2C backend, normally address0x72. Caller owns
// handle/bus/rail and serializes calls; buffers are owned RAM, disjoint from
// transport/owner storage. No read probe: this chip does not support reads.
type Tm1680=int
fun tm1680FromDevice(device: I2cDevice): Tm1680 = Tm1680(device|0)
fun Tm1680.device(): I2cDevice = I2cDevice(this|0)
trusted fun Tm1680.display(frame: NativeBuffer,scratch: NativeBuffer,invert: bool = false): bool =
    this.device().valid() && tm1680PackFrame(frame,scratch,invert) && this.device().write(scratch,33)
// Clear framebuffer before sending anything. Default brightness duty2/16.
// Failure is returned immediately; do not infer display state or replay.
trusted fun Tm1680.begin(frame: NativeBuffer,scratch: NativeBuffer): bool {
    if (!this.device().valid() || !tm1680BuffersValid(frame,scratch)) return false
    var at=0
    while (at < 32) { frame.store(at,0);at=at+1 }
    scratch.store(0,128);scratch.store(1,164);scratch.store(2,152)
    scratch.store(3,129);scratch.store(4,177);scratch.store(5,131)
    if (!this.device().write(scratch,6)) return false
    return this.display(frame,scratch)
}
trusted fun Tm1680.setBrightness(brightness: int,scratch: NativeBuffer): bool {
    if (!this.device().valid() || brightness < 0 || brightness > 255 || !scratch.hasAddressRange(0,2)) return false
    scratch.store(0,if (brightness == 0) 130 else 176|(brightness>>>4));scratch.store(1,131)
    return this.device().write(scratch,if (brightness == 0) 1 else 2)
}
trusted fun Tm1680.setSleep(sleep: bool,scratch: NativeBuffer): bool {
    if (!this.device().valid() || !scratch.hasAddressRange(0,2)) return false
    scratch.store(0,if (sleep) 130 else 129);scratch.store(1,if (sleep) 128 else 131)
    return this.device().write(scratch,2)
}
