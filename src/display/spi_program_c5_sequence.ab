import "./command_buffer.ab"
import "../spi/buffer_gate.ab"
import "../spi/buffer_result.ab"
// Immutable encoded program admitted in full before I/O. One gate held over
// all commands AND delays; CS released between commands. No partial replay.
// Result status matches SpiBufferResult; completedBytes is the encoded prefix
// completed, including delays, NOT pixel bytes. Last command detail retained.
trusted fun esp32C5LcdRunProgram(master: int,gate: PeripheralGate,owner: u32,dc: int,
    program: NativeBuffer,length: int,polls: int): SpiBufferResult {
    if (length < 2 || length > 65535 || polls < 1 || polls > 1000000 ||
        !program.hasAddressRange(0,length) ||
        !(program.addressValue()+length <= 0x60000000 || program.addressValue() >= 0x60100000) ||
        !gate.word().valid() || (gate.word().address() >= 0x60000000 && gate.word().address() < 0x60100000) ||
        !gate.bufferDisjoint(program,length) || !lcdCommandBufferValid(program,length)) return SpiBufferResult(3<<56)
    val admitted=gate.tryBegin(owner)
    if (admitted != 0) return SpiBufferResult((if (admitted == 1) 2 else if (admitted == 2) 4 else 3)<<56)
    var offset=0;var detail=13;var healthy=c5LcdProgramAdmission(master,dc)
    while (healthy && offset+1 < length) {
        val command=program.load(offset);val encoded=program.load(offset+1)
        if (command == 255 && encoded == 255) { offset=offset+2;break }
        val count=encoded&127
        val result=c5LcdProgramCommand(master,dc,command,nativeBufferAt(program.addressValue()+offset+2,count),count,polls)
        detail=result.detail();healthy=result.valid()
        if (healthy) {
            offset=offset+2+count
            if ((encoded&128) != 0) {
                val wait=program.load(offset);offset=offset+1
                if (wait != 0) peripheralDelayMilliseconds(if (wait == 255) 500 else wait)
            }
        }
    }
    val status=if (!gate.finish(owner,healthy)) 5 else if (healthy) 1 else 6
    return SpiBufferResult((status<<56)|(offset<<32)|detail)
}
