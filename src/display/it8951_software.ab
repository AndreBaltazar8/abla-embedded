import "./it8951_protocol.ab"
import "../spi/software_bits.ab"
// Five pin bytes, then16-bit half-period in microseconds. No ownership token.
// Caller configures free pins, mode0 idle clock, CS high, ready input, clocks
// and calibrated timing before use. Keep all pins exclusively owned through
// command/read pairs. Software SPI is <=500kHz here, not a throughput promise.
type It8951Software = int
fun it8951Software(clock: Pin,mosi: Pin,miso: Pin,select: Pin,ready: Pin,halfPeriod: int=1): It8951Software {
    if (halfPeriod < 1 || halfPeriod > 65535 || !clock.outputCapable() ||
        !mosi.outputCapable() || !miso.valid() || !select.outputCapable() || !ready.valid() ||
        clock.number() > 255 || mosi.number() > 255 || miso.number() > 255 || select.number() > 255 || ready.number() > 255 ||
        clock == mosi || clock == miso || clock == select || clock == ready ||
        mosi == miso || mosi == select || mosi == ready || miso == select || miso == ready || select == ready) return It8951Software(0)
    It8951Software(clock.number()|(mosi.number()<<8)|(miso.number()<<16)|(select.number()<<24)|(ready.number()<<32)|(halfPeriod<<40))
}
fun It8951Software.signal(index: int): Pin = pin(if (index < 0 || index > 4) -1 else (this>>>(index*8))&255)
fun It8951Software.valid(): bool = this > 0 && (this>>>56) == 0 &&
    it8951Software(this.signal(0),this.signal(1),this.signal(2),this.signal(3),this.signal(4),(this>>>40)&65535) == this
fun it8951TransportValid(context: int): bool = It8951Software(context).valid()
trusted fun it8951TransportSelect(context: int,selected: bool): bool {
    if (!it8951TransportValid(context)) return false
    It8951Software(context).signal(3).write(!selected);return true
}
trusted fun it8951TransportReady(context: int): int =
    if (!it8951TransportValid(context)) -1 else if (It8951Software(context).signal(4).read()) 1 else 0
trusted fun it8951TransportExchange(context: int,word: int): int {
    if (!it8951TransportValid(context) || word < 0 || word > 65535) return -1
    val bus=It8951Software(context)
    val result=softwareSpiExchangeWord(bus.signal(0),bus.signal(1),bus.signal(2),u32(word),16,0,(bus>>>40)&65535)
    if (result.valid()) int(result.value()) else -1
}
trusted fun it8951TransportDelay(context: int,microseconds: int): void {
    peripheralDelayMicroseconds(microseconds);return
}
