import "./spi_program_c5_sequence.ab"
import "./lcd_logic.ab"
// Strict nonempty logical rectangle; drawing callers clip before using this.
// Only window registers are changed: RAMWR/pixel stream is a separate phase.
// Keep display-level ownership between this call and subsequent operations.
// Compound draws must retain their bus gate and use the owned helper below.
fun c5LcdWindowValid(view: LcdView,x: int,y: int,width: int,height: int): bool =
    (view>>u64(48)) == u64(0) && view.width() > 0 && view.height() > 0 &&
    x >= 0 && y >= 0 && x < view.width() && y < view.height() &&
    width > 0 && height > 0 && width <= view.width()-x && height <= view.height()-y
trusted fun c5LcdWindowProgram(view: LcdView,x: int,y: int,width: int,height: int,program: NativeBuffer): bool {
    if (!c5LcdWindowValid(view,x,y,width,height) || !program.hasAddressRange(0,14)) return false
    val column=view.columnStart()+x;val row=view.rowStart()+y
    program.store(0,42);program.store(1,4)
    program.store(2,column>>>8);program.store(3,column&255)
    program.store(4,(column+width-1)>>>8);program.store(5,(column+width-1)&255)
    program.store(6,43);program.store(7,4)
    program.store(8,row>>>8);program.store(9,row&255)
    program.store(10,(row+height-1)>>>8);program.store(11,(row+height-1)&255)
    program.store(12,255);program.store(13,255);return true
}
trusted fun esp32C5LcdSetWindow(master: int,gate: PeripheralGate,owner: u32,dc: int,
    view: LcdView,x: int,y: int,width: int,height: int,polls: int): SpiBufferResult {
    val program=nativeBufferAt(nativeStackAllocate(14),14)
    if (!c5LcdWindowProgram(view,x,y,width,height,program)) return SpiBufferResult(3<<56)
    return esp32C5LcdRunProgram(master,gate,owner,dc,program,14,polls)
}
// Internal compound-draw helper: gate held, view/rectangle/storage validated,
// master/DC admitted, program immutable. Failure must fault the parent gate.
// CompletedBytes here counts encoded window prefix, not pixels.
trusted fun c5LcdWindowOwned(master: int,dc: int,program: NativeBuffer,polls: int): SpiBufferResult {
    var result=c5LcdProgramCommand(master,dc,42,nativeBufferAt(program.addressValue()+2,4),4,polls)
    if (!result.valid()) return SpiBufferResult((6<<56)|result.detail())
    result=c5LcdProgramCommand(master,dc,43,nativeBufferAt(program.addressValue()+8,4),4,polls)
    return SpiBufferResult(((if (result.valid()) 1 else 6)<<56)|((if (result.valid()) 12 else 6)<<32)|result.detail())
}
