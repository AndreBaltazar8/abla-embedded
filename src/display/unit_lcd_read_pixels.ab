import "./unit_lcd.ab"
// RGB332/RGB565/RGB888 wire-format readback into explicit destination stride.
// Read one row per repeated-START transaction (<=720 bytes), so full RGB888
// frames do not exceed a transport's16-bit read length. No allocation, cached
// window or retry of a failed read. Keep exclusive access throughout.
// Low8:1complete2input3queueIO4budget5window6read; completed rows@8.
// On6 the next row may contain a prefix: only completed rows are valid.
// Padding is untouched, bytes follow device byte-swap mode. No32-bit read
// command exists in this protocol; alpha reconstruction is not fabricated.
trusted fun I2cDevice.unitLcdReadPixels(x: int,y: int,w: int,h: int,rotation: int,destination: NativeBuffer,stride: int,pixelBytes: int,scratch: NativeBuffer,pollsPerRow: int): int {
    if (!this.valid() || pixelBytes < 1 || pixelBytes > 3 || !unitLcdRectangleValid(x,y,w,h,rotation) || stride < w*pixelBytes || stride > 2147483647 || pollsPerRow < 1 || pollsPerRow > 255 || !scratch.hasAddressRange(0,6)) return 2
    val rowBytes=w*pixelBytes;val bytes=(h-1)*stride+rowBytes
    if (!destination.hasAddressRange(0,bytes) || (destination.addressValue() < scratch.addressValue()+6 && scratch.addressValue() < destination.addressValue()+bytes)) return 2
    var row=0
    while (row < h) {
        val admission=this.unitLcdWaitCapacity(scratch,pollsPerRow,255)
        if (admission != 1) return admission|(row<<8)
        scratch.store(0,42);scratch.store(1,x);scratch.store(2,x+w-1)
        scratch.store(3,43);scratch.store(4,y+row);scratch.store(5,y+row)
        if (!this.write(scratch,6)) return 5|(row<<8)
        scratch.store(0,128|pixelBytes)
        if (!this.writeRead(scratch,1,nativeBufferAt(destination.addressValue()+row*stride,rowBytes),rowBytes)) return 6|(row<<8)
        row=row+1
    }
    return 1|(h<<8)
}
