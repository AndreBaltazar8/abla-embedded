import "./software_program_checked.ab"
import "./lcd_logic.ab"
// Power/reset and checked pad setup are caller prerequisites. Validate both
// immutable programs before any GPIO. Hold one gate across programs and final
// pixel-format/orientation/inversion commands; every failure propagates and
// faults the gate. Only enable backlight after success. No device ACK implied.
trusted fun softwareLcdBeginRgb565Checked(gate: PeripheralGate,owner: u32,
    clock: Pin,mosi: Pin,chipSelect: Pin,dataCommand: Pin,
    geometry: LcdGeometry,rotation: int,program: NativeBuffer,extraProgram: NativeBuffer,
    inverted: bool = false,bgrOrder: bool = true,halfPeriodMicroseconds: int = 1,
    sharedDataCommand: bool = false): SpiTransactionResult {
    if (!geometry.valid() || rotation < 0 || rotation > 7 ||
        !softwareSpiCommandPinsValid(clock,mosi,chipSelect,dataCommand,0,halfPeriodMicroseconds) ||
        !gate.bufferDisjoint(program,program.capacity()) || !gate.bufferDisjoint(extraProgram,extraProgram.capacity()) ||
        !lcdCommandBufferValid(program,program.capacity()) ||
        (extraProgram.capacity() != 0 && !lcdCommandBufferValid(extraProgram,extraProgram.capacity()))) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    var result=softwareLcdRunProgramCheckedOwned(clock,mosi,chipSelect,dataCommand,program,program.capacity(),halfPeriodMicroseconds,sharedDataCommand)
    if (result.valid() && extraProgram.capacity() != 0)
        result=softwareLcdRunProgramCheckedOwned(clock,mosi,chipSelect,dataCommand,extraProgram,extraProgram.capacity(),halfPeriodMicroseconds,sharedDataCommand)
    val packet=nativeBufferAt(nativeStackAllocate(1),1)
    if (result.valid()) {
        packet.store(0,85)
        result=softwareLcdCommandCheckedOwned(clock,mosi,chipSelect,dataCommand,58,packet,1,halfPeriodMicroseconds,sharedDataCommand)
    }
    if (result.valid()) {
        packet.store(0,geometry.view(rotation,bgrOrder).madctl())
        result=softwareLcdCommandCheckedOwned(clock,mosi,chipSelect,dataCommand,54,packet,1,halfPeriodMicroseconds,sharedDataCommand)
    }
    if (result.valid()) result=softwareLcdCommandCheckedOwned(clock,mosi,chipSelect,dataCommand,if (inverted) 33 else 32,NativeBuffer(0),0,halfPeriodMicroseconds,sharedDataCommand)
    if (!gate.finish(owner,result.valid())) return SpiTransactionResult((5<<32)|(result&0xffffffff))
    return result
}
