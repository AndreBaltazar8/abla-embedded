import "./rgb565_canvas.ab"
// Borrowed caller-owned32B record: magic,width,height,canvasAddress,capacity,
// stride,dirtyRect64. Initialize fresh zero storage, then serialize every draw
// and flush. No automatic allocation, orientation changes, or record copying.
fun rgb565DirtyDisjoint(record: NativeBuffer,canvas: NativeBuffer): bool =
    record.addressValue()+32 <= canvas.addressValue() || canvas.addressValue()+canvas.capacity() <= record.addressValue()
trusted fun rgb565DirtyRect(record: NativeBuffer): DisplayRect =
    DisplayRect(record.loadU32(24)|(record.loadU32(28)<<32))
trusted fun rgb565DirtySet(record: NativeBuffer,rectangle: DisplayRect): void {
    record.storeU32(24,rectangle&4294967295);record.storeU32(28,rectangle>>>32);return
}
trusted fun rgb565DirtyValid(record: NativeBuffer,canvas: NativeBuffer): bool {
    if (!record.hasAddressRange(0,32) || record.loadU32(0) != 0x52473544 ||
        record.loadU32(12) != canvas.addressValue() || record.loadU32(16) != canvas.capacity() ||
        !rgb565DirtyDisjoint(record,canvas)) return false
    val width=record.loadU32(4);val height=record.loadU32(8)
    if (width < 1 || height < 1 || !lcdRgb565SourceValid(canvas,width,height,record.loadU32(20))) return false
    val rectangle=rgb565DirtyRect(record)
    return rectangle == DisplayRect(0) || (!rectangle.empty() && rectangle.x()+rectangle.width() <= width && rectangle.y()+rectangle.height() <= height)
}
// Initial contents must be fully initialized by caller. Start fully dirty,
// establishing panel synchronization with the first successful whole flush.
trusted fun rgb565DirtyOpenOwned(record: NativeBuffer,canvas: NativeBuffer,width: int,height: int,stride: int,exclusive: bool): bool {
    if (!exclusive || !record.hasAddressRange(0,32) || width < 1 || height < 1 || stride > 2147483647 ||
        !lcdRgb565SourceValid(canvas,width,height,stride) || !rgb565DirtyDisjoint(record,canvas)) return false
    var i=0
    while (i < 32) { if (record.load(i) != 0) return false;i=i+1 }
    record.storeU32(0,0x52473544);record.storeU32(4,width);record.storeU32(8,height)
    record.storeU32(12,canvas.addressValue());record.storeU32(16,canvas.capacity());record.storeU32(20,stride)
    rgb565DirtySet(record,displayRect(0,0,width,height));return true
}
trusted fun rgb565DirtyFillOwned(record: NativeBuffer,canvas: NativeBuffer,x: int,y: int,w: int,h: int,color: Rgb565,exclusive: bool): bool {
    if (!exclusive || !rgb565DirtyValid(record,canvas)) return false
    val width=record.loadU32(4);val height=record.loadU32(8)
    if (!rgb565CanvasFillOwned(canvas,width,height,record.loadU32(20),x,y,w,h,color,true)) return false
    val added=clipDisplayRect(x,y,w,h,width,height)
    if (added.empty()) return true
    val old=rgb565DirtyRect(record)
    if (old.empty()) { rgb565DirtySet(record,added);return true }
    val left=if (old.x() < added.x()) old.x() else added.x()
    val top=if (old.y() < added.y()) old.y() else added.y()
    val right=if (old.x()+old.width() > added.x()+added.width()) old.x()+old.width() else added.x()+added.width()
    val bottom=if (old.y()+old.height() > added.y()+added.height()) old.y()+old.height() else added.y()+added.height()
    rgb565DirtySet(record,displayRect(left,top,right-left,bottom-top));return true
}
