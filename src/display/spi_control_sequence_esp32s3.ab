import "./lcd_logic.ab"
import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"

// Initialized, exclusively configured bus/panel required. One register write
// under the canonical bus gate; backend releases CS and shared D/C on failure.
// Internal helper: only fixed MIPI commands are supplied by the public methods.
trusted fun esp32s3LcdControl(gate: PeripheralGate, owner: u32,
    peripheral: int, pins: SpiPins, select: Pin, dc: Pin,
    command: int, value: u32, bytes: int, shared: bool, settleMilliseconds: int = 0): SpiTransactionResult {
    if (settleMilliseconds < 0 || settleMilliseconds > 5000 ||
        !esp32s3SpiCommandPinsValid(peripheral,pins,select,dc,shared))
        return SpiTransactionResult(3 << 32)
    val address = gate.word().address()
    if (address <= 0 || address > 4294967292) return SpiTransactionResult(3 << 32)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    val detail = if (bytes == 0) esp32s3SpiCommandOwned(peripheral,select,dc,command,nativeBufferAt(0,0),0,shared)
        else esp32s3SpiCommandWordOwned(peripheral,select,dc,command,value,bytes,shared)
    val healthy = (detail & 255) == 1
    if (healthy && settleMilliseconds != 0) peripheralDelayMilliseconds(settleMilliseconds)
    if (!gate.finish(owner,healthy)) return SpiTransactionResult((5 << 32) | detail)
    SpiTransactionResult(((if (healthy) 1 else 6) << 32) | detail)
}

// Publish geometry.view(rotation,bgr) to subsequent draw/touch users ONLY
// after success, while retaining application-level display serialization.
trusted fun esp32s3LcdSetRotation(gate: PeripheralGate, owner: u32,
    peripheral: int, pins: SpiPins, select: Pin, dc: Pin,
    geometry: LcdGeometry, rotation: int, bgr: bool, shared: bool): SpiTransactionResult {
    if (!geometry.valid() || rotation < 0 || rotation > 7) return SpiTransactionResult(3 << 32)
    esp32s3LcdControl(gate,owner,peripheral,pins,select,dc,
        54,u32(geometry.view(rotation,bgr).madctl()),1,shared)
}

trusted fun esp32s3LcdSetInverted(gate: PeripheralGate, owner: u32,
    peripheral: int, pins: SpiPins, select: Pin, dc: Pin,
    inverted: bool, shared: bool): SpiTransactionResult =
    esp32s3LcdControl(gate,owner,peripheral,pins,select,dc,
        if (inverted) 33 else 32,u32(0),0,shared)

// MIPI sleep command only: no backlight/rail/framebuffer state is hidden.
// Caller chooses its controller-required settling delay and serializes the
// whole display lifecycle. Gate remains owned through the successful delay.
trusted fun esp32s3LcdSetSleep(gate: PeripheralGate, owner: u32,
    peripheral: int, pins: SpiPins, select: Pin, dc: Pin,
    sleeping: bool, settleMilliseconds: int, shared: bool): SpiTransactionResult =
    esp32s3LcdControl(gate,owner,peripheral,pins,select,dc,
        if (sleeping) 16 else 17,u32(0),0,shared,settleMilliseconds)

// Panel idle/color-reduction mode, not system sleep or power-rail control.
trusted fun esp32s3LcdSetIdle(gate: PeripheralGate, owner: u32,
    peripheral: int, pins: SpiPins, select: Pin, dc: Pin,
    idle: bool, shared: bool): SpiTransactionResult =
    esp32s3LcdControl(gate,owner,peripheral,pins,select,dc,
        if (idle) 57 else 56,u32(0),0,shared)
