import "./software_program_checked.ab"
import "./lcd_logic.ab"
import "./color.ab"
// Internal: gate held, validated view/clipped nonempty rectangle and pins.
trusted fun softwareLcdWindowCheckedOwned(clock: Pin,mosi: Pin,chipSelect: Pin,dataCommand: Pin,
    column: int,row: int,width: int,height: int,halfPeriod: int,shared: bool,resetRowWindow: bool = false): SpiTransactionResult {
    val packet=nativeBufferAt(nativeStackAllocate(4),4)
    if (resetRowWindow) {
        packet.storeU32(0,0xffffffff)
        val reset=softwareLcdCommandCheckedOwned(clock,mosi,chipSelect,dataCommand,43,packet,4,halfPeriod,shared)
        if (!reset.valid()) return reset
    }
    packet.store(0,column>>>8);packet.store(1,column&255)
    packet.store(2,(column+width-1)>>>8);packet.store(3,(column+width-1)&255)
    val result=softwareLcdCommandCheckedOwned(clock,mosi,chipSelect,dataCommand,42,packet,4,halfPeriod,shared)
    if (!result.valid()) return result
    packet.store(0,row>>>8);packet.store(1,row&255)
    packet.store(2,(row+height-1)>>>8);packet.store(3,(row+height-1)&255)
    return softwareLcdCommandCheckedOwned(clock,mosi,chipSelect,dataCommand,43,packet,4,halfPeriod,shared)
}
// Start RAMWR with continuous CS for all following pixels. Setup failure may
// have partially changed D/C; always attempt input restoration in that case.
trusted fun softwareLcdPixelsBeginCheckedOwned(clock: Pin,mosi: Pin,chipSelect: Pin,dataCommand: Pin,
    halfPeriod: int,shared: bool): SpiTransactionResult {
    clock.write(false)
    if (shared) {
        if (!dataCommand.outputLevelOwned(false)) {
            val restored=dataCommand.inputOwned()
            return SpiTransactionResult((6<<32)|1|(if (restored) 0 else 4))
        }
    } else dataCommand.write(false)
    chipSelect.write(false)
    val ignored=softwareSpiExchangeWordOwned(clock,mosi,Pin(-1),u32(44),8,0,halfPeriod)
    dataCommand.write(true)
    return SpiTransactionResult(1<<32)
}
trusted fun softwareLcdPixelsEndCheckedOwned(chipSelect: Pin,dataCommand: Pin,shared: bool): SpiTransactionResult {
    chipSelect.write(true)
    if (shared && !dataCommand.inputOwned()) return SpiTransactionResult((6<<32)|4)
    return SpiTransactionResult(1<<32)
}
// Configured RGB565 panel/view, checked pins and canonical gate required.
// No framebuffer: generate pixels directly; all window/pixel commands share
// one gate. Empty clipped rectangles emit nothing. Failures fault the gate.
trusted fun softwareLcdFillRectChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,
    chipSelect: Pin,dataCommand: Pin,view: LcdView,x: int,y: int,width: int,height: int,
    color: Rgb565,halfPeriodMicroseconds: int = 1,sharedDataCommand: bool = false,resetRowWindow: bool = false): SpiTransactionResult {
    if (!softwareSpiCommandPinsValid(clock,mosi,chipSelect,dataCommand,0,halfPeriodMicroseconds) ||
        !view.valid()) return SpiTransactionResult(3<<32)
    val rect=clipDisplayRect(x,y,width,height,view.width(),view.height())
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    var result=SpiTransactionResult(1<<32)
    if (!rect.empty()) {
        result=softwareLcdWindowCheckedOwned(clock,mosi,chipSelect,dataCommand,view.columnStart()+rect.x(),view.rowStart()+rect.y(),rect.width(),rect.height(),halfPeriodMicroseconds,sharedDataCommand,resetRowWindow)
        if (result.valid()) result=softwareLcdPixelsBeginCheckedOwned(clock,mosi,chipSelect,dataCommand,halfPeriodMicroseconds,sharedDataCommand)
        if (result.valid()) {
            var remaining=rect.width()*rect.height()
            while (remaining > 0) {
                val ignored=softwareSpiExchangeWordOwned(clock,mosi,Pin(-1),u32(color.value()),16,0,halfPeriodMicroseconds)
                remaining=remaining-1
            }
            result=softwareLcdPixelsEndCheckedOwned(chipSelect,dataCommand,sharedDataCommand)
        }
    }
    if (!gate.finish(owner,result.valid())) return SpiTransactionResult((5<<32)|(result&0xffffffff))
    return result
}
