import "./dsi_video_p4_sequence.ab"
import "../esp32/dsi_start_esp32p4.ab"
import "../esp32/dw_gdma_dsi_esp32p4.ab"
trusted fun esp32P4DsiVideoBridgePrepare(): int = esp32P4DsiVideoBridgePrepareOwned()
trusted fun esp32P4DsiVideoStart(channel: int): int = esp32P4DsiVideoStartOwned(channel)
trusted fun esp32P4DsiVideoDisableOutput(): int = esp32P4DsiVideoDisableOutputOwned()
trusted fun esp32P4DsiVideoEvents(hwVersion: int): int = esp32P4DsiVideoEventsOwned(hwVersion)
trusted fun esp32P4DsiVideoAcknowledge(hwVersion: int,events: int): int = esp32P4DsiVideoAcknowledgeOwned(hwVersion,events)
