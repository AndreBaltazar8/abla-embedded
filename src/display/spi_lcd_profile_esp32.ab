// A display transport is the 32-bit ESP-IDF SPI handle plus three signed-byte
// GPIOs and one backlight-polarity bit. It is a single allocation-free scalar.
type SpiLcd = int

fun spiLcdPinValue(number: int): int = number & 255
fun spiLcdPin(value: int): Pin = pin(
    if ((value & 255) == 255) -1 else value & 255
)

fun spiLcd(
    device: SpiDevice,
    dataCommandPin: int,
    resetPin: int = -1,
    backlightPin: int = -1,
    backlightActiveLow: bool = false
): SpiLcd {
    if ((device >>> 32) != 0 || !device.valid() ||
        !spiLcdPinProfileValid(dataCommandPin,resetPin,backlightPin)) return SpiLcd(0)
    SpiLcd(
    (device & 4294967295) |
        (spiLcdPinValue(dataCommandPin) << 32) |
        (spiLcdPinValue(resetPin) << 40) |
        (spiLcdPinValue(backlightPin) << 48) |
        (if (backlightActiveLow) 1 << 56 else 0)
    )
}

fun SpiLcd.device(): SpiDevice = SpiDevice(this & 4294967295)
fun SpiLcd.dataCommandPin(): Pin = spiLcdPin(this >>> 32)
fun SpiLcd.resetPin(): Pin = spiLcdPin(this >>> 40)
fun SpiLcd.backlightPin(): Pin = spiLcdPin(this >>> 48)
fun SpiLcd.backlightActiveLow(): bool = (this & (1 << 56)) != 0
fun SpiLcd.valid(): bool = (this >>> 57) == 0 && this.device().valid() &&
    spiLcdPinProfileValid(this.dataCommandPin().number(),this.resetPin().number(),this.backlightPin().number())

fun spiLcdPinProfileValid(dc: int, reset: int, backlight: int): bool =
    pin(dc).outputCapable() && (reset == -1 || pin(reset).outputCapable()) &&
    (backlight == -1 || pin(backlight).outputCapable()) &&
    dc != reset && dc != backlight && (reset == -1 || reset != backlight)
