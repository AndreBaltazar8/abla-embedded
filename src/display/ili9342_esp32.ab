import "./mipi_rgb565_esp32.ab"
import "./mipi_commands.ab"

trusted fun SpiLcd.beginIli9342(
    geometry: LcdGeometry,
    rotation: int = 0,
    inverted: bool = false,
    bgrOrder: bool = true,
    extendedE: bool = false
): LcdView = this.beginMipiRgb565(
    geometry, rotation, ili9342InitCommands,
    if (extendedE) ili9342EInitCommands else "", inverted, bgrOrder
)
