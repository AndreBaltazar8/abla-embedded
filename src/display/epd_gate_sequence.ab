import "abla/runtime/scalar"
// Gate timing follows M5GFX/LovyanGFX Bus_EPD.cpp (powerControl,
// beginTransaction, endTransaction and notify_line_done). Not an i80 driver or
// panel waveform renderer. Five prepared, exclusively owned push-pull outputs;
// LCD DMA completion must be established by the transport before lineComplete.
// Pin indices0..4: power,SPV,CKV,OE,LE. Five6-bit pins + validbit30.
type EpdGatePins=int
fun epdGatePins(power: int,spv: int,ckv: int,oe: int,le: int): EpdGatePins {
    if (power < 0 || power > 63 || spv < 0 || spv > 63 || ckv < 0 || ckv > 63 || oe < 0 || oe > 63 || le < 0 || le > 63 ||
        power == spv || power == ckv || power == oe || power == le || spv == ckv || spv == oe || spv == le || ckv == oe || ckv == le || oe == le) return EpdGatePins(0)
    return EpdGatePins(power|(spv<<6)|(ckv<<12)|(oe<<18)|(le<<24)|(1<<30))
}
fun EpdGatePins.pin(index: int): int = if (index >= 0 && index < 5) (this>>>(index*6))&63 else -1
fun EpdGatePins.valid(): bool = (this&(1<<30)) != 0 && (this&(~0x7FFFFFFF)) == 0 &&
    (epdGatePins(this.pin(0),this.pin(1),this.pin(2),this.pin(3),this.pin(4))|0) == this
trusted fun EpdGatePins.prepared(): bool {
    if (!this.valid()) return false
    var index=0
    while (index < 5) {
        if (!epdGateOutputPrepared(this.pin(index))) return false
        index=index+1
    }
    return true
}
// 1complete,2invalid/unprepared,3notexclusive/idle,4write/readbackfailure.
// Failure retains pad/rail ownership. Power-off may be retried from any partial
// power transition; no automatic restoration of a potentially energized rail.
trusted fun EpdGatePins.powerOwned(on: bool,idleExclusive: bool): int {
    if (!idleExclusive) return 3
    if (!this.prepared()) return 2
    if (on) {
        if (!epdGateWrite(this.pin(3),true)) return 4
        epdGateDelayUs(100)
        if (!epdGateWrite(this.pin(0),true)) return 4
        epdGateDelayUs(100)
        if (!epdGateWrite(this.pin(1),true)) return 4
        epdGateDelayUs(1000)
    } else {
        epdGateDelayUs(1000)
        if (!epdGateWrite(this.pin(0),false)) return 4
        epdGateDelayUs(10)
        if (!epdGateWrite(this.pin(3),false)) return 4
        epdGateDelayUs(100)
        if (!epdGateWrite(this.pin(1),false)) return 4
    }
    return 1
}
trusted fun EpdGatePins.beginFrameOwned(poweredIdleExclusive: bool): int {
    if (!poweredIdleExclusive) return 3
    if (!this.prepared()) return 2
    if (!epdGateWrite(this.pin(1),false)) return 4
    epdGateDelayUs(1)
    if (!epdGateWrite(this.pin(2),false)) return 4
    epdGateDelayUs(3)
    if (!epdGateWrite(this.pin(2),true)) return 4
    epdGateDelayUs(1)
    if (!epdGateWrite(this.pin(1),true)) return 4
    var count=0
    while (count < 3) {
        epdGateDelayUs(3)
        if (!epdGateWrite(this.pin(2),false)) return 4
        epdGateDelayUs(3)
        if (!epdGateWrite(this.pin(2),true)) return 4
        count=count+1
    }
    return 1
}
// action0 prepares a line (transport submits AFTER success); action1 latches
// a completed line; action2 ends frame. Never call1 on just GDMA memory EOF:
// the LCD transport itself must have finished shifting the full scanline.
trusted fun EpdGatePins.lineOwned(action: int,transportIdleExclusive: bool): int {
    if (!transportIdleExclusive) return 3
    if (action < 0 || action > 2 || !this.prepared()) return 2
    if (action == 1) {
        if (!epdGateWrite(this.pin(2),false) || !epdGateWrite(this.pin(4),true)) return 4
    } else {
        if (!epdGateWrite(this.pin(4),false) || !epdGateWrite(this.pin(2),true)) return 4
    }
    return 1
}
