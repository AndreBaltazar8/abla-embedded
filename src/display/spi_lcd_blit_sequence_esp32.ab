// Initialized RGB565 panel and exclusive caller-owned source required. Big
// endian pixels are sent directly; little endian uses64 disjoint caller bytes.
// The bus remains owned through the whole clipped image; failures are not
// retried and never reported as a complete frame.
trusted fun SpiLcd.blitRgb565(
    view: LcdView, x: int, y: int, source: NativeBuffer,
    width: int, height: int, stride: int,
    littleEndian: bool = false, staging: NativeBuffer = NativeBuffer(0)
): bool {
    if (!this.valid() || !view.valid() ||
        !lcdRgb565SourceValid(source,width,height,stride)) return false
    val rectangle = clipDisplayRect(x,y,width,height,view.width(),view.height())
    if (rectangle.empty()) return true
    val span = (height-1)*stride+width*2
    if (littleEndian && (!staging.hasAddressRange(0,64) ||
        (staging.addressValue() < source.addressValue()+span &&
            source.addressValue() < staging.addressValue()+64))) return false
    if (!this.device().acquire()) return false
    var valid = this.setWindowSelected(view,rectangle.x(),rectangle.y(),
        rectangle.width(),rectangle.height())
    if (valid) valid = this.writeCommandSelected(44,nativeBufferAt(0,0),0,true)
    val sourceX = rectangle.x()-x
    val sourceY = rectangle.y()-y
    var row = 0
    while (valid && row < rectangle.height()) {
        val rowOffset = (sourceY+row)*stride+sourceX*2
        val rowBytes = rectangle.width()*2
        var sent = 0
        while (valid && sent < rowBytes) {
            val count = if (rowBytes-sent < 64) rowBytes-sent else 64
            var chunk = nativeBufferAt(source.addressValue()+rowOffset+sent,count)
            if (littleEndian) {
                var byte = 0
                while (byte < count) {
                    staging.store(byte,chunk.load(byte+1))
                    staging.store(byte+1,chunk.load(byte))
                    byte = byte+2
                }
                chunk = nativeBufferAt(staging.addressValue(),count)
            }
            valid = this.device().writeWithFlags(chunk,count,
                if (row+1 < rectangle.height() || sent+count < rowBytes)
                    spiKeepChipSelect else 0)
            sent = sent+count
        }
        row = row+1
    }
    this.device().release()
    valid
}
