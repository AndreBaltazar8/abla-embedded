// RGB565 is the native two-byte pixel format used by the common MIPI LCD
// controllers. The nominal type is still one register and introduces no
// runtime wrapper or allocation.
type Rgb565 = int

@inline
fun rgb565(red: int, green: int, blue: int): Rgb565 = Rgb565(
    ((red & 248) << 8) | ((green & 252) << 3) | ((blue & 248) >>> 3)
)

@inline
fun Rgb565.value(): int = this & 65535

@inline
fun Rgb565.red5(): int = (this >>> 11) & 31

@inline
fun Rgb565.green6(): int = (this >>> 5) & 63

@inline
fun Rgb565.blue5(): int = this & 31

val rgb565Black = Rgb565(0)
val rgb565White = Rgb565(65535)
val rgb565Red = Rgb565(63488)
val rgb565Green = Rgb565(2016)
val rgb565Blue = Rgb565(31)
