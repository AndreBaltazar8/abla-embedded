// Exact round-half-up(count*numerator/denominator), bounded for display
// clocks. Shift/add quotient+remainder avoids overflowing a 32-bit product
// and avoids linking a 64-bit division/multiplication runtime on RV32.
fun dsiTimingScale(count: int,numerator: int,denominator: int): int {
    if (count < 0 || count > 4095 || numerator < 1 || numerator > 1500000 || denominator < 1000 || denominator > 1280000) return -1
    var quotient=u32(0)
    var remainder=u32(0)
    var bit=u32(2048)
    val divisor=u32(denominator)
    while (bit != u32(0)) {
        quotient=quotient*u32(2)
        remainder=remainder*u32(2)
        if ((u32(count)&bit) != u32(0)) remainder=remainder+u32(numerator)
        quotient=quotient+remainder/divisor
        remainder=remainder%divisor
        bit=bit>>u32(1)
    }
    int(quotient+(if (remainder*u32(2) >= divisor) u32(1) else u32(0)))
}
type DsiHorizontalTiming = int
fun DsiHorizontalTiming.valid(): bool = (this&(1<<51)) != 0
fun DsiHorizontalTiming.hostSync(): int = this&4095
fun DsiHorizontalTiming.hostBack(): int = (this>>>12)&4095
fun DsiHorizontalTiming.hostTotal(): int = (this>>>24)&32767
fun DsiHorizontalTiming.bridgeTotal(): int = (this>>>39)&4095
// Mirrors IDF host_hline rounding and actual/expected DPI compensation.
// Negative/zero compensated front porch and overflowing fields are rejected,
// rather than unsigned-wrap/truncation. Host timings use lane BYTE cycles.
fun dsiHorizontalTiming(sync: int,back: int,width: int,front: int,laneKbps: int,expectedDpiKhz: int,actualDpiKhz: int): DsiHorizontalTiming {
    if (sync < 1 || sync > 4095 || back < 0 || back > 4095 || width < 1 || width > 4095 || front < 1 || front > 4095 ||
        laneKbps < 80000 || laneKbps > 1500000 || expectedDpiKhz < 1000 || expectedDpiKhz > 160000 ||
        actualDpiKhz < 1000 || actualDpiKhz > 240000) return DsiHorizontalTiming(0)
    val total=sync+back+width+front
    if (total > 4095) return DsiHorizontalTiming(0)
    val hsync=dsiTimingScale(sync,laneKbps,expectedDpiKhz*8)
    val hback=dsiTimingScale(back,laneKbps,expectedDpiKhz*8)
    val htotal=dsiTimingScale(total,laneKbps,expectedDpiKhz*8)
    val bridge=dsiTimingScale(total,actualDpiKhz,expectedDpiKhz)
    if (hsync < 1 || hsync > 4095 || hback > 4095 || htotal > 32767 ||
        bridge <= sync+back+width || bridge > 4095) return DsiHorizontalTiming(0)
    DsiHorizontalTiming((1<<51)|hsync|(hback<<12)|(htotal<<24)|(bridge<<39))
}
