import "./epd_canvas_clip.ab"
// Caller-owned40B record: magic,width,height,canvasAddress,mode,x,y,right,
// bottom,reserved. mode0 means empty. Coordinates are PHYSICAL half-open.
// Accumulates a bounding box, so gaps between draws may also be refreshed.
// One waveform mode per batch; submit before changing mode. No allocation,
// automatic physical refresh, or concurrent drawing/frame pumping.
fun epdCanvasDirtyValid(r: NativeBuffer,canvas: NativeBuffer): bool {
    if (!r.hasAddressRange(0,40) || r.loadU32(0) != 0x45504444 || r.loadU32(12) != canvas.addressValue() || r.loadU32(36) != 0) return false
    val width=r.loadU32(4);val height=r.loadU32(8);val mode=r.loadU32(16)
    if (!epdCanvasDimensions(width,height) || (width&15) != 0 || mode > 4 || !canvas.hasAddressRange(0,width*height/2) ||
        !epdWaveformDisjoint(r,40,canvas,width*height/2)) return false
    if (mode == 0) return (r.loadU32(20)|r.loadU32(24)|r.loadU32(28)|r.loadU32(32)) == 0
    return r.loadU32(20) < r.loadU32(28) && r.loadU32(28) <= width && r.loadU32(24) < r.loadU32(32) && r.loadU32(32) <= height
}
// Fresh zero-initialized owner only; never silently discards pending work.
trusted fun epdCanvasDirtyOpenOwned(r: NativeBuffer,canvas: NativeBuffer,width: int,height: int,exclusive: bool): bool {
    if (!exclusive || !r.hasAddressRange(0,40) || !epdCanvasDimensions(width,height) || (width&15) != 0 ||
        !canvas.hasAddressRange(0,width*height/2) || !epdWaveformDisjoint(r,40,canvas,width*height/2)) return false
    var offset=0
    while (offset < 40) { if (r.loadU32(offset) != 0) return false;offset=offset+4 }
    r.storeU32(0,0x45504444);r.storeU32(4,width);r.storeU32(8,height);r.storeU32(12,canvas.addressValue())
    return true
}
trusted fun epdCanvasDirtyDrawOwned(r: NativeBuffer,canvas: NativeBuffer,x: int,y: int,w: int,h: int,rotation: int,source: NativeBuffer,stride: int,fill: int,mode: int,exclusive: bool): bool {
    if (!exclusive || !epdCanvasDirtyValid(r,canvas) || rotation < 0 || rotation > 7 || mode < 1 || mode > 4 ||
        x < -2147483648 || x > 2147483647 || y < -2147483648 || y > 2147483647 ||
        w < 0 || w > 65535 || h < 0 || h > 65535) return false
    if (fill == -1 && w != 0 && h != 0) {
        if (stride < w || stride > 2147483647) return false
        val bytes=(h-1)*stride+w
        if (!source.hasAddressRange(0,bytes) || !epdWaveformDisjoint(r,40,source,bytes)) return false
    }
    val width=r.loadU32(4);val height=r.loadU32(8)
    val lw=if ((rotation&1) == 0) width else height;val lh=if ((rotation&1) == 0) height else width
    val left=if (x < 0) 0 else x;val top=if (y < 0) 0 else y
    val right=if (x+w > lw) lw else x+w;val bottom=if (y+h > lh) lh else y+h
    val changed=w != 0 && h != 0 && right > left && bottom > top
    if (changed && r.loadU32(16) != 0 && r.loadU32(16) != mode) return false
    if (!epdCanvasDrawClippedOwned(canvas,width,height,x,y,w,h,rotation,source,stride,fill,mode,true)) return false
    if (!changed) return true
    val a=epdCanvasPosition(width,height,left,top,rotation);val b=epdCanvasPosition(width,height,right-1,bottom-1,rotation)
    val ax=a&65535;val ay=a>>>16;val bx=b&65535;val by=b>>>16
    var px=if (ax < bx) ax else bx;var py=if (ay < by) ay else by
    var endX=(if (ax > bx) ax else bx)+1;var endY=(if (ay > by) ay else by)+1
    if (r.loadU32(16) != 0) {
        if (r.loadU32(20) < px) px=r.loadU32(20)
        if (r.loadU32(24) < py) py=r.loadU32(24)
        if (r.loadU32(28) > endX) endX=r.loadU32(28)
        if (r.loadU32(32) > endY) endY=r.loadU32(32)
    }
    r.storeU32(16,mode);r.storeU32(20,px);r.storeU32(24,py);r.storeU32(28,endX);r.storeU32(32,endY)
    return true
}
// Clear pending bounds only after complete waveform submission. Failure leaves
// the owner and waveform untouched; canvas still contains all previous draws.
trusted fun epdCanvasDirtySubmitOwned(r: NativeBuffer,canvas: NativeBuffer,state: NativeBuffer,exclusive: bool): bool {
    if (!exclusive || !epdCanvasDirtyValid(r,canvas)) return false
    val width=r.loadU32(4);val height=r.loadU32(8)
    if (!state.hasAddressRange(0,width*height*2) || !epdWaveformDisjoint(r,40,state,width*height*2) ||
        !epdWaveformDisjoint(canvas,width*height/2,state,width*height*2)) return false
    if (r.loadU32(16) == 0) return true
    if (!epdCanvasSubmitOwned(canvas,state,width,height,r.loadU32(20),r.loadU32(24),r.loadU32(28)-r.loadU32(20),r.loadU32(32)-r.loadU32(24),r.loadU32(16),true)) return false
    var offset=16
    while (offset <= 32) { r.storeU32(offset,0);offset=offset+4 }
    return true
}
