import "./software_program_checked.ab"
import "./lcd_logic.ab"
// Initialized panel/pads and caller-serialized display state required. Fixed
// MIPI controls, one canonical gate through command and successful settling.
trusted fun softwareLcdControlChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,
    select: Pin,dc: Pin,command: int,value: int,bytes: int,settleMilliseconds: int,
    halfPeriod: int,shared: bool): SpiTransactionResult {
    if (command < 0 || command > 255 || value < 0 || value > 255 || bytes < 0 || bytes > 1 ||
        settleMilliseconds < 0 || settleMilliseconds > 5000 ||
        !softwareSpiCommandPinsValid(clock,mosi,select,dc,0,halfPeriod)) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    val data=nativeBufferAt(nativeStackAllocate(1),1);data.store(0,value)
    val result=softwareLcdCommandCheckedOwned(clock,mosi,select,dc,command,data,bytes,halfPeriod,shared)
    if (result.valid() && settleMilliseconds != 0) peripheralDelayMilliseconds(settleMilliseconds)
    if (!gate.finish(owner,result.valid())) return SpiTransactionResult((5<<32)|(result&0xffffffff))
    return result
}
trusted fun softwareLcdSetRotationChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,select: Pin,dc: Pin,
    geometry: LcdGeometry,rotation: int,bgr: bool,halfPeriod: int = 1,shared: bool = false): SpiTransactionResult {
    if (!geometry.valid() || rotation < 0 || rotation > 7) return SpiTransactionResult(3<<32)
    return softwareLcdControlChecked(gate,owner,clock,mosi,select,dc,54,geometry.view(rotation,bgr).madctl(),1,0,halfPeriod,shared)
}
trusted fun softwareLcdSetInvertedChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,select: Pin,dc: Pin,
    inverted: bool,halfPeriod: int = 1,shared: bool = false): SpiTransactionResult =
    softwareLcdControlChecked(gate,owner,clock,mosi,select,dc,if (inverted) 33 else 32,0,0,0,halfPeriod,shared)
// No implicit backlight/rail state. Caller supplies panel-required settling.
trusted fun softwareLcdSetSleepChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,select: Pin,dc: Pin,
    sleeping: bool,settleMilliseconds: int,halfPeriod: int = 1,shared: bool = false): SpiTransactionResult =
    softwareLcdControlChecked(gate,owner,clock,mosi,select,dc,if (sleeping) 16 else 17,0,0,settleMilliseconds,halfPeriod,shared)
trusted fun softwareLcdSetIdleChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,select: Pin,dc: Pin,
    idle: bool,halfPeriod: int = 1,shared: bool = false): SpiTransactionResult =
    softwareLcdControlChecked(gate,owner,clock,mosi,select,dc,if (idle) 57 else 56,0,0,0,halfPeriod,shared)
