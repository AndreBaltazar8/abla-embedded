import "./dsi_frame_publish_p4_sequence.ab"
import "./dsi_frame_descriptor_p4.ab"
import "../esp32/cache_writeback_esp32p4.ab"
import "../esp32/dw_gdma_dsi_esp32p4.ab"
import "../riscv/memory.ab"
import "../hal/display.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../esp32/cache_writeback_p4_sequence.ab"
import "../esp32/dw_gdma_dsi_p4_sequence.ab"
import "../esp32/dw_gdma_channel_p4_sequence.ab"
import "../esp32/sdk/nativebuffer_type.ab"
@export("p4DsiPublicationFence")
trusted fun p4DsiPublicationFenceHook(): void = riscvDeviceMemoryFence()
@export("p4DsiPrepareFrame")
trusted fun p4DsiPrepareFrameHook(descriptor: NativeBuffer,frame: NativeBuffer,bytes: int): bool = esp32P4DsiFrameDescriptorPrepareOwned(descriptor,frame,bytes)
@export("p4DsiWritebackFrame")
trusted fun p4DsiWritebackFrameHook(buffer: NativeBuffer,bytes: int,line: int,polls: int): int = esp32P4CacheWritebackOwned(buffer,bytes,line,polls)
@export("p4DsiConfigureFrameChannel")
trusted fun p4DsiConfigureFrameChannelHook(channel: int,address: int): int = esp32P4DwDmaDsiConfigureOwned(channel,address)
@export("p4DsiStartFrameChannel")
trusted fun p4DsiStartFrameChannelHook(channel: int): int = esp32P4DwDmaDsiStartPreparedOwned(channel)
trusted fun esp32P4DsiFramePublish(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): int = esp32P4DsiFramePublishOwned(channel,descriptor,frame,bytes,line,polls)
