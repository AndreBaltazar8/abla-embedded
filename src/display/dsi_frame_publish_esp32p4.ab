import "./dsi_frame_publish_p4_sequence.ab"
import "./dsi_frame_descriptor_p4.ab"
import "../esp32/cache_writeback_esp32p4.ab"
import "../esp32/dw_gdma_dsi_esp32p4.ab"
import "../riscv/memory.ab"
trusted fun p4DsiPublicationFence(): void = riscvDeviceMemoryFence()
trusted fun p4DsiPrepareFrame(descriptor: NativeBuffer,frame: NativeBuffer,bytes: int): bool = esp32P4DsiFrameDescriptorPrepareOwned(descriptor,frame,bytes)
trusted fun p4DsiWritebackFrame(buffer: NativeBuffer,bytes: int,line: int,polls: int): int = esp32P4CacheWritebackOwned(buffer,bytes,line,polls)
trusted fun p4DsiConfigureFrameChannel(channel: int,address: int): int = esp32P4DwDmaDsiConfigureOwned(channel,address)
trusted fun p4DsiStartFrameChannel(channel: int): int = esp32P4DwDmaDsiStartPreparedOwned(channel)
trusted fun esp32P4DsiFramePublish(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): int = esp32P4DsiFramePublishOwned(channel,descriptor,frame,bytes,line,polls)
