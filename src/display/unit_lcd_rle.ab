import "../esp32/sdk/raw_buffer.ab"
// UnitLCD RLE wire format: count1..255 + one pixel, or0,count3..255 +
// literal pixels. Pixel bytes are opaque (RGB332/565/888/ARGB or alpha).
// Independent encoder; no copying of upstream's run-boundary state machine.
trusted fun unitLcdRleEqual(source: NativeBuffer,a: int,b: int,bytes: int): bool {
    var at=0;while (at < bytes) { if (source.load(a*bytes+at) != source.load(b*bytes+at)) return false;at=at+1 }
    return true
}
trusted fun unitLcdRlePass(source: NativeBuffer,pixels: int,bytes: int,destination: NativeBuffer,emit: bool): int {
    var pixel=0;var output=0
    while (pixel < pixels) {
        var run=1
        while (run < 255 && pixel+run < pixels && unitLcdRleEqual(source,pixel,pixel+run,bytes)) run=run+1
        if (run > 1) {
            if (emit) {
                destination.store(output,run)
                var at=0;while (at < bytes) { destination.store(output+1+at,source.load(pixel*bytes+at));at=at+1 }
            }
            output=output+1+bytes;pixel=pixel+run
        } else {
            var count=1
            while (count < 255 && pixel+count < pixels &&
                !(pixel+count+1 < pixels && unitLcdRleEqual(source,pixel+count,pixel+count+1,bytes))) count=count+1
            if (count < 3) {
                var item=0
                while (item < count) {
                    if (emit) {
                        destination.store(output,1)
                        var at=0;while (at < bytes) { destination.store(output+1+at,source.load((pixel+item)*bytes+at));at=at+1 }
                    }
                    output=output+1+bytes;item=item+1
                }
            } else {
                if (emit) {
                    destination.store(output,0);destination.store(output+1,count)
                    var at=0;while (at < count*bytes) { destination.store(output+2+at,source.load(pixel*bytes+at));at=at+1 }
                }
                output=output+2+count*bytes
            }
            pixel=pixel+count
        }
    }
    return output
}
trusted fun unitLcdRleSize(source: NativeBuffer,pixels: int,bytes: int): int =
    if (pixels < 1 || pixels > 65535 || bytes < 1 || bytes > 4 || !source.hasAddressRange(0,pixels*bytes)) 0
    else unitLcdRlePass(source,pixels,bytes,NativeBuffer(0),false)
// Source must stay immutable through both passes.0 rejects input/alias/space
// without modifying destination; success returns exact bytes written.
trusted fun unitLcdRleEncode(source: NativeBuffer,pixels: int,bytes: int,destination: NativeBuffer): int {
    val size=unitLcdRleSize(source,pixels,bytes)
    if (size == 0 || !destination.hasAddressRange(0,size) ||
        (source.addressValue() < destination.addressValue()+size && destination.addressValue() < source.addressValue()+pixels*bytes)) return 0
    return unitLcdRlePass(source,pixels,bytes,destination,true)
}
