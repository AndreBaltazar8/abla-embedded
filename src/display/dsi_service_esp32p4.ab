import "./dsi_service_p4_sequence.ab"
import "./dsi_frame_rearm_esp32p4.ab"
import "./dsi_shutdown_esp32p4.ab"
trusted fun p4DsiServiceCacheIdle(): bool = (p4CacheSyncRead(152)&u32(15)) == u32(0)
trusted fun p4DsiServiceRearm(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): int = esp32P4DsiFrameRearmImmutableOwned(channel,descriptor,frame,bytes,line,polls)
trusted fun p4DsiServiceShutdownVideo(channel: int,polls: int): int = esp32P4DsiVideoShutdownOwned(channel,polls)
