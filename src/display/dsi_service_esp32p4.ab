import "./dsi_service_p4_sequence.ab"
import "./dsi_frame_rearm_esp32p4.ab"
import "./dsi_shutdown_esp32p4.ab"
import "../hal/display.ab"
import "../hal/esp32.ab"
import "../hal/display_2.ab"
@export("p4DsiServiceCacheIdle")
trusted fun p4DsiServiceCacheIdleHook(): bool = (p4CacheSyncRead(152)&u32(15)) == u32(0)
@export("p4DsiServiceRearm")
trusted fun p4DsiServiceRearmHook(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): int = esp32P4DsiFrameRearmImmutableOwned(channel,descriptor,frame,bytes,line,polls)
@export("p4DsiServiceShutdownVideo")
trusted fun p4DsiServiceShutdownVideoHook(channel: int,polls: int): int = esp32P4DsiVideoShutdownOwned(channel,polls)
