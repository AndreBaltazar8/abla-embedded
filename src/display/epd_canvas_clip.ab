import "./epd_canvas.ab"
// Logical clipping for grayscale8 images and solid fills, in all8 rotations.
// Source describes the ORIGINAL w*h rectangle; clipping advances its origin
// without changing stride. Validate the full source and reject canvas alias
// before mutation, including empty/offscreen draws. Empty draws succeed.
// Signed32 origins and <=65535 extents keep additions bounded in Abla int.
// Does not queue waveform state; callers retain draw/submit/pump ownership.
trusted fun epdCanvasDrawClippedOwned(canvas: NativeBuffer,width: int,height: int,x: int,y: int,w: int,h: int,rotation: int,source: NativeBuffer,stride: int,fill: int,mode: int,exclusive: bool): bool {
    if (!exclusive || !epdCanvasDimensions(width,height) || rotation < 0 || rotation > 7 || mode < 1 || mode > 4 ||
        x < -2147483648 || x > 2147483647 || y < -2147483648 || y > 2147483647 ||
        w < 0 || w > 65535 || h < 0 || h > 65535 || fill < -1 || fill > 255 ||
        !canvas.hasAddressRange(0,epdCanvasSize(width,height))) return false
    if (fill == -1) {
        if (stride < w || stride > 2147483647) return false
        if (w != 0 && h != 0) {
            val sourceBytes=(h-1)*stride+w
            if (!source.hasAddressRange(0,sourceBytes) || !epdWaveformDisjoint(canvas,epdCanvasSize(width,height),source,sourceBytes)) return false
        }
    }
    if (w == 0 || h == 0) return true
    val logicalWidth=if ((rotation&1) == 0) width else height
    val logicalHeight=if ((rotation&1) == 0) height else width
    val left=if (x < 0) 0 else x
    val top=if (y < 0) 0 else y
    val right=if (x+w > logicalWidth) logicalWidth else x+w
    val bottom=if (y+h > logicalHeight) logicalHeight else y+h
    if (right <= left || bottom <= top) return true
    if (fill != -1) return epdCanvasDrawOwned(canvas,width,height,left,top,right-left,bottom-top,rotation,source,stride,fill,mode,true)
    val offset=(top-y)*stride+left-x
    val cropped=nativeBufferAt(source.addressValue()+offset,(bottom-top-1)*stride+right-left)
    return epdCanvasDrawOwned(canvas,width,height,left,top,right-left,bottom-top,rotation,cropped,stride,-1,mode,true)
}
