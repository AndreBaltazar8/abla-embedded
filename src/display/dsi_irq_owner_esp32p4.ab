import "./dsi_irq_owner_p4_sequence.ab"
import "./dsi_mailbox_esp32p4.ab"
import "../esp32/interrupt_route_esp32p4.ab"
import "../hal/display.ab"
import "../hal/esp32.ab"
import "../hal/display_3.ab"
// Both P4 layouts: bridge matrix register offset0x158 => source86.
@export("p4DsiIrqRouteRead")
trusted fun p4DsiIrqRouteReadHook(layout: int,core: int): int = esp32P4InterruptRouteReadOwned(layout,core,86)
@export("p4DsiIrqRoute")
trusted fun p4DsiIrqRouteHook(layout: int,core: int,expected: int,target: int): int = esp32P4InterruptRouteOwned(layout,core,86,expected,target)
@export("p4DsiIrqLineEnabled")
trusted fun p4DsiIrqLineEnabledHook(line: int): bool = p4DispatchLineEnabled(line)
@export("p4DsiIrqSourceEnabled")
trusted fun p4DsiIrqSourceEnabledHook(layout: int): int = int(p4DsiBridgeRead(80))&esp32P4DsiEventMask(layout)
@export("p4DsiIrqBind")
trusted fun p4DsiIrqBindHook(box: P4DsiMailbox,table: P4IrqDispatch,remove: bool): int = box.bindOwned(table,remove)
@export("p4DsiIrqConfigure")
trusted fun p4DsiIrqConfigureHook(line: int,priority: int): int = esp32P4ClicConfigureOwned(line,priority,0,true)
@export("p4DsiIrqEnableLine")
trusted fun p4DsiIrqEnableLineHook(line: int,enabled: bool): int = esp32P4ClicEnableOwned(line,enabled)
