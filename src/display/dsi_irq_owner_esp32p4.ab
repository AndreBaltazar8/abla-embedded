import "./dsi_irq_owner_p4_sequence.ab"
import "./dsi_mailbox_esp32p4.ab"
import "../esp32/interrupt_route_esp32p4.ab"
// Both P4 layouts: bridge matrix register offset0x158 => source86.
trusted fun p4DsiIrqRouteRead(layout: int,core: int): int = esp32P4InterruptRouteReadOwned(layout,core,86)
trusted fun p4DsiIrqRoute(layout: int,core: int,expected: int,target: int): int = esp32P4InterruptRouteOwned(layout,core,86,expected,target)
trusted fun p4DsiIrqLineEnabled(line: int): bool = p4DispatchLineEnabled(line)
trusted fun p4DsiIrqSourceEnabled(layout: int): int = int(p4DsiBridgeRead(80))&esp32P4DsiEventMask(layout)
trusted fun p4DsiIrqBind(box: P4DsiMailbox,table: P4IrqDispatch,remove: bool): int = box.bindOwned(table,remove)
trusted fun p4DsiIrqConfigure(line: int,priority: int): int = esp32P4ClicConfigureOwned(line,priority,0,true)
trusted fun p4DsiIrqEnableLine(line: int,enabled: bool): int = esp32P4ClicEnableOwned(line,enabled)
