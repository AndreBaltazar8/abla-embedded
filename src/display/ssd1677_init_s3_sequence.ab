import "./ssd1677_activation_s3_sequence.ab"
// GDEQ0426T82/SSD1677 800x480 init, pinned M5GFX. Awake/powered panel,
// physical reset already completed, BUSY input/pullup and SPI initialized.
// Software reset CANNOT wake deep sleep; that requires the board reset pin.
// This establishes even RAM face, analog power off, NO valid optical history.
// Clearing controller RAM is not a visible screen refresh.
trusted fun esp32s3Ssd1677InitializeOwned(peripheral: int,select: Pin,dc: Pin,busy: Pin,polls: int): int {
    var result=ssd1677WaitReadyOwned(busy,polls)
    if (result != 1) return result
    result=esp32s3SpiCommandOwned(peripheral,select,dc,0x12,NativeBuffer(0),0,false)
    if ((result&255) != 1) return result
    peripheralDelayMilliseconds(10)
    result=ssd1677WaitReadyOwned(busy,polls)
    if (result != 1) return result
    result=esp32s3SpiCommandWordOwned(peripheral,select,dc,0x18,u32(128),1,false)
    if ((result&255) != 1) return result
    val booster=nativeBufferAt(nativeStaticBytes("\xae\xc7\xc3\xc0\x40"),5)
    result=esp32s3SpiCommandOwned(peripheral,select,dc,0x0c,booster,5,false)
    if ((result&255) != 1) return result
    result=esp32s3SpiCommandWordOwned(peripheral,select,dc,0x01,u32(0xdf0102),3,false)
    if ((result&255) != 1) return result
    result=esp32s3SpiCommandWordOwned(peripheral,select,dc,0x3c,u32(1),1,false)
    if ((result&255) != 1) return result
    result=esp32s3Ssd1677WindowOwned(peripheral,select,dc,800,480)
    if ((result&255) != 1) return result
    result=ssd1677WaitReadyOwned(busy,polls)
    if (result != 1) return result
    result=esp32s3SpiCommandWordOwned(peripheral,select,dc,0x46,u32(247),1,false)
    if ((result&255) != 1) return result
    result=ssd1677WaitReadyOwned(busy,polls)
    if (result != 1) return result
    result=esp32s3SpiCommandWordOwned(peripheral,select,dc,0x47,u32(247),1,false)
    if ((result&255) != 1) return result
    return ssd1677WaitReadyOwned(busy,polls)
}
trusted fun esp32s3Ssd1677Initialize(gate: PeripheralGate,owner: u32,peripheral: int,pins: SpiPins,
    select: Pin,dc: Pin,busy: Pin,polls: int,exclusiveAwake: bool): SpiTransactionResult {
    if (!exclusiveAwake || polls < 1 || polls > 10000 || !busy.valid() || busy == select || busy == dc ||
        busy.number() == pins.clockPin() || busy.number() == pins.mosiPin() || busy.number() == pins.misoPin() ||
        !esp32s3SpiCommandPinsValid(peripheral,pins,select,dc,false) ||
        gate.word().address() <= 0 || gate.word().address() > 4294967292) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    val result=esp32s3Ssd1677InitializeOwned(peripheral,select,dc,busy,polls)
    val healthy=(result&255) == 1
    if (!gate.finish(owner,healthy)) return SpiTransactionResult((5<<32)|result)
    return SpiTransactionResult(((if (healthy) 1 else 6)<<32)|result)
}
