import "./gc9a01_program.ab"
import "./software_mipi_checked.ab"
import "./software_blit_checked.ab"
// Dedicated240x240 GC9A01 RGB565. Caller supplies powered/reset panel,
// configured pads and canonical SPI gate; backlight only after successful init.
// The checked SPI transport never appends NOP (this controller malfunctions).
// Drawing rotation must match the last successful initialization; these
// stateless helpers do not change MADCTL or own reset/power/backlight state.
trusted fun gc9a01BeginChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,cs: Pin,dc: Pin,
    rotation: int = 0,inverted: bool = false,bgrOrder: bool = true,halfPeriod: int = 1): SpiTransactionResult =
    softwareLcdBeginRgb565Checked(gate,owner,clock,mosi,cs,dc,lcdGeometry(240,240),rotation,
        gc9a01InitProgram(),NativeBuffer(0),inverted,bgrOrder,halfPeriod)
trusted fun gc9a01FillRectChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,cs: Pin,dc: Pin,
    rotation: int,x: int,y: int,width: int,height: int,color: Rgb565,halfPeriod: int = 1): SpiTransactionResult {
    if (rotation < 0 || rotation > 7) return SpiTransactionResult(3<<32)
    return softwareLcdFillRectChecked(gate,owner,clock,mosi,cs,dc,lcdGeometry(240,240).view(rotation),
        x,y,width,height,color,halfPeriod,false,(rotation&1) != 0)
}
trusted fun gc9a01BlitChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,cs: Pin,dc: Pin,
    rotation: int,x: int,y: int,source: NativeBuffer,width: int,height: int,stride: int,
    littleEndian: bool = false,halfPeriod: int = 1): SpiTransactionResult {
    if (rotation < 0 || rotation > 7) return SpiTransactionResult(3<<32)
    return softwareLcdBlitRgb565Checked(gate,owner,clock,mosi,cs,dc,lcdGeometry(240,240).view(rotation),
        x,y,source,width,height,stride,littleEndian,halfPeriod,false,(rotation&1) != 0)
}
