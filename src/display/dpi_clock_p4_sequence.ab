import "./dpi_clock_p4_logic.ab"
// Caller holds RCC critical section, owns inactive DPI/bridge and borrows
// stable/pinned source. No source PLL changes or implicit video stop.
// 1 verified,2 invalid,3 no APB access,4 active/refused,5 readback failure
// (clock may be enabled; caller retains ownership until checked shutdown).
trusted fun esp32P4DpiClockStartOwned(plan: DpiClockPlan): int {
    if (!plan.valid() || plan.divider() < 1 || plan.divider() > 256) return 2
    if ((p4DsiClockRead(24)&u32(4096)) == u32(0)) return 3
    val old=p4DsiClockRead(60)
    if ((old&u32(128)) != u32(0) || (p4DsiBridgeRead(4)&u32(1)) != u32(0)) return 4
    val fields=(u32(plan.source())<<u32(5))|(u32(plan.divider()-1)<<u32(8))
    p4DsiClockWrite(60,(old&u32(4294901919))|fields)
    if ((p4DsiClockRead(60)&u32(65504)) != fields) return 5
    p4DsiClockWrite(60,p4DsiClockRead(60)|u32(128))
    if ((p4DsiClockRead(60)&u32(65504)) != (fields|u32(128))) return 5
    return 1
}
trusted fun esp32P4DpiClockStopOwned(): int {
    val old=p4DsiClockRead(60)
    if ((old&u32(128)) == u32(0)) return 1
    if ((p4DsiClockRead(24)&u32(4096)) == u32(0)) return 3
    if ((p4DsiBridgeRead(4)&u32(1)) != u32(0)) return 4
    p4DsiClockWrite(60,old&u32(4294967167))
    if ((p4DsiClockRead(60)&u32(128)) != u32(0)) return 5
    return 1
}
