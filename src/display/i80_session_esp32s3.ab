import "./i80_session_s3_sequence.ab"
import "./i80_clock_esp32s3.ab"
import "./i80_transfer_esp32s3.ab"
import "./i80_pins_esp32s3.ab"
import "../hal/display.ab"
@export("s3I80SessionDmaStorage")
trusted fun s3I80SessionDmaStorageHook(descriptors: int,payload: int,bytes: int): bool = esp32s3GdmaLinearTxLayoutValid(descriptors,payload,bytes)
@export("s3I80SessionClock")
trusted fun s3I80SessionClockHook(owner: int): bool = esp32S3LcdDmaEnableClock(u32(owner))
@export("s3I80SessionReady")
trusted fun s3I80SessionReadyHook(channel: int): bool = s3I80Idle() && esp32s3GdmaParked(channel,true)
@export("s3I80SessionConfigure")
trusted fun s3I80SessionConfigureHook(width: int,group: int,pixel: int): int = esp32S3LcdI80ConfigureOwned(width,group,pixel,false,false,true)
@export("s3I80SessionPinsOpen")
trusted fun s3I80SessionPinsOpenHook(r: NativeBuffer,cfg: NativeBuffer,width: int): int = esp32S3I80PinsOpenOwned(r,cfg,width,0,true)
@export("s3I80SessionPinsClose")
trusted fun s3I80SessionPinsCloseHook(r: NativeBuffer): int = esp32S3I80PinsCloseOwned(r,true)
@export("s3I80SessionPhases")
trusted fun s3I80SessionPhasesHook(): int = esp32S3LcdI80PhasesOwned(0,0,1,0,true,true)
@export("s3I80SessionChain")
trusted fun s3I80SessionChainHook(descriptors: int,payload: int,bytes: int): int = esp32s3GdmaInitializeTxChainOwned(descriptors,payload,bytes)
@export("s3I80SessionStart")
trusted fun s3I80SessionStartHook(channel: int,descriptor: int,polls: int): int = esp32S3LcdI80StartOwned(channel,descriptor,polls,true)
@export("s3I80SessionPoll")
trusted fun s3I80SessionPollHook(channel: int,terminal: int): int = esp32S3LcdI80PollOwned(channel,terminal,true)
@export("s3I80SessionAbort")
trusted fun s3I80SessionAbortHook(channel: int,polls: int): int = esp32S3LcdI80AbortOwned(channel,polls,true)
