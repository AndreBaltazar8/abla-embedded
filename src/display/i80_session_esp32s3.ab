import "./i80_session_s3_sequence.ab"
import "./i80_clock_esp32s3.ab"
import "./i80_transfer_esp32s3.ab"
import "./i80_pins_esp32s3.ab"
trusted fun s3I80SessionDmaStorage(descriptors: int,payload: int,bytes: int): bool = esp32s3GdmaLinearTxLayoutValid(descriptors,payload,bytes)
trusted fun s3I80SessionClock(owner: int): bool = esp32S3LcdDmaEnableClock(u32(owner))
trusted fun s3I80SessionReady(channel: int): bool = s3I80Idle() && esp32s3GdmaParked(channel,true)
trusted fun s3I80SessionConfigure(width: int,group: int,pixel: int): int = esp32S3LcdI80ConfigureOwned(width,group,pixel,false,false,true)
trusted fun s3I80SessionPinsOpen(r: NativeBuffer,cfg: NativeBuffer,width: int): int = esp32S3I80PinsOpenOwned(r,cfg,width,0,true)
trusted fun s3I80SessionPinsClose(r: NativeBuffer): int = esp32S3I80PinsCloseOwned(r,true)
trusted fun s3I80SessionPhases(): int = esp32S3LcdI80PhasesOwned(0,0,1,0,true,true)
trusted fun s3I80SessionChain(descriptors: int,payload: int,bytes: int): int = esp32s3GdmaInitializeTxChainOwned(descriptors,payload,bytes)
trusted fun s3I80SessionStart(channel: int,descriptor: int,polls: int): int = esp32S3LcdI80StartOwned(channel,descriptor,polls,true)
trusted fun s3I80SessionPoll(channel: int,terminal: int): int = esp32S3LcdI80PollOwned(channel,terminal,true)
trusted fun s3I80SessionAbort(channel: int,polls: int): int = esp32S3LcdI80AbortOwned(channel,polls,true)
