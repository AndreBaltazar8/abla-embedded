trusted fun SpiLcd.writeCommandSelected(
    command: int,
    data: NativeBuffer,
    length: int,
    keepSelectedAfter: bool = false
): bool {
    if (!this.valid() || command < 0 || command > 255 || !data.hasAddressRange(0,length)) return false
    val commandBuffer = nativeBufferAt(nativeStackAllocate(1), 1)
    commandBuffer.store(0, command)
    this.dataCommandPin().write(false)
    val commandFlags = if (length > 0 || keepSelectedAfter) {
        spiKeepChipSelect
    } else 0
    if (!this.device().writeWithFlags(commandBuffer, 1, commandFlags)) {
        this.dataCommandPin().write(true)
        return false
    }
    this.dataCommandPin().write(true)
    length == 0 || this.device().writeWithFlags(
        data, length, if (keepSelectedAfter) spiKeepChipSelect else 0
    )
}

trusted fun SpiLcd.writeCommand(
    command: int,
    data: NativeBuffer,
    length: int
): bool {
    if (!this.valid() || command < 0 || command > 255 ||
        !data.hasAddressRange(0,length) || !this.device().acquire()) return false
    val written = this.writeCommandSelected(command, data, length)
    this.device().release()
    written
}

trusted fun SpiLcd.runCommandProgram(program: string): bool {
    if (!this.valid() || !lcdCommandProgramValid(program) ||
        !this.device().acquire()) return false
    val arguments = nativeBufferAt(nativeStackAllocate(127), 127)
    var index = 0
    var valid = true
    var complete = false
    while (valid && !complete) {
        val command = program[index]
        val encodedCount = program[index + 1]
        index = index + 2
        if (command == 255 && encodedCount == 255) complete = true
        else {
            val count = encodedCount & 127
            var argument = 0
            while (argument < count) {
                arguments.store(argument, program[index + argument])
                argument = argument + 1
            }
            index = index + count
            valid = this.writeCommandSelected(command, arguments, count)
            if (valid && (encodedCount & 128) != 0) {
                val encodedDelay = program[index]
                index = index + 1
                taskDelay(if (encodedDelay == 255) 500 else encodedDelay)
            }
        }
    }
    this.device().release()
    valid && complete
}
