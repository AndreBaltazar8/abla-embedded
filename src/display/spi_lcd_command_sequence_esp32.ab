export import "../hal/spilcd.ab"
import "./spilcd_type.ab"
import "abla/unsafe/memory/raw"
import "./lcd_logic.ab"
import "../hal/esp32.ab"
import "../hal/native_buffer.ab"
import "../esp32/sdk/nativebuffer_type.ab"
import "../hal/spidevice.ab"
import "../esp32/sdk/raw_buffer.ab"

@exportLocal("abla_spilcd_writeCommandSelected")
trusted fun spiLcdWriteCommandSelectedHook(recv: int, command: int, data: NativeBuffer, length: int, keepSelectedAfter: bool): bool {
    val self = SpiLcd(recv)
    if (!self.valid() || command < 0 || command > 255 || !data.hasAddressRange(0,length)) return false
    val commandBuffer = nativeBufferAt(nativeStackAllocate(1), 1)
    commandBuffer.store(0, command)
    self.dataCommandPin().write(false)
    val commandFlags = if (length > 0 || keepSelectedAfter) {
        spiKeepChipSelect
    } else 0
    if (!self.device().writeWithFlags(commandBuffer, 1, commandFlags)) {
        self.dataCommandPin().write(true)
        return false
    }
    self.dataCommandPin().write(true)
    length == 0 || self.device().writeWithFlags(
        data, length, if (keepSelectedAfter) spiKeepChipSelect else 0
    )
}


@exportLocal("abla_spilcd_writeCommand")
trusted fun spiLcdWriteCommandHook(recv: int, command: int, data: NativeBuffer, length: int): bool {
    val self = SpiLcd(recv)
    if (!self.valid() || command < 0 || command > 255 ||
        !data.hasAddressRange(0,length) || !self.device().acquire()) return false
    val written = self.writeCommandSelected(command, data, length)
    self.device().release()
    written
}


@exportLocal("abla_spilcd_runCommandProgram")
trusted fun spiLcdRunCommandProgramHook(recv: int, program: int, size: int): bool {
    val self = SpiLcd(recv)
    if (!self.valid() || !lcdCommandProgramValidAt(program, size) ||
        !self.device().acquire()) return false
    val arguments = nativeBufferAt(nativeStackAllocate(127), 127)
    var index = 0
    var valid = true
    var complete = false
    while (valid && !complete) {
        val command = lcdProgramByte(program, index)
        val encodedCount = lcdProgramByte(program, index + 1)
        index = index + 2
        if (command == 255 && encodedCount == 255) complete = true
        else {
            val count = encodedCount & 127
            var argument = 0
            while (argument < count) {
                arguments.store(argument, lcdProgramByte(program, index + argument))
                argument = argument + 1
            }
            index = index + count
            valid = self.writeCommandSelected(command, arguments, count)
            if (valid && (encodedCount & 128) != 0) {
                val encodedDelay = lcdProgramByte(program, index)
                index = index + 1
                taskDelay(if (encodedDelay == 255) 500 else encodedDelay)
            }
        }
    }
    self.device().release()
    valid && complete
}

