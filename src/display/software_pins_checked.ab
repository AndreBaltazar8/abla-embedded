import "../spi/software_command.ab"
// Four distinct, caller-owned pads and stable clocks. CS must already be
// safe/inactive for the attached panel; other SPI users are quiesced. Configure
// CS first, then D/C, mode0 clock and MOSI. Every GPIO setup is checked.
// Returns the number of fully configured pads; a failed pad may be partially
// modified. Shared D/C remains input. No power/reset/panel initialization.
trusted fun softwareLcdConfigurePinsCheckedOwned(clock: Pin,mosi: Pin,chipSelect: Pin,dataCommand: Pin,sharedDataCommand: bool): int {
    if (!chipSelect.outputLevelOwned(true)) return 0
    if (sharedDataCommand) { if (!dataCommand.inputOwned()) return 1 }
    else if (!dataCommand.outputLevelOwned(true)) return 1
    if (!clock.outputLevelOwned(false)) return 2
    if (!mosi.outputLevelOwned(false)) return 3
    return 4
}
// SPI status contract; detail=completed pads0..4. Setup failure latches gate
// fault: retain pad ownership and use explicit recovery, never clear by hand.
trusted fun softwareLcdConfigurePinsChecked(gate: PeripheralGate,owner: u32,
    clock: Pin,mosi: Pin,chipSelect: Pin,dataCommand: Pin,sharedDataCommand: bool,exclusive: bool): SpiTransactionResult {
    if (!exclusive || !softwareSpiCommandPinsValid(clock,mosi,chipSelect,dataCommand,0,0)) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    val completed=softwareLcdConfigurePinsCheckedOwned(clock,mosi,chipSelect,dataCommand,sharedDataCommand)
    if (!gate.finish(owner,completed == 4)) return SpiTransactionResult((5<<32)|completed)
    return SpiTransactionResult(((if (completed == 4) 1 else 6)<<32)|completed)
}
// Only recover THIS failed configuration after all bus users are quiesced.
// Reconfigure all four pads; retry preserves fault until all checks succeed.
trusted fun softwareLcdRecoverPinsChecked(gate: PeripheralGate,owner: u32,
    clock: Pin,mosi: Pin,chipSelect: Pin,dataCommand: Pin,sharedDataCommand: bool,exclusive: bool): bool {
    if (!exclusive || !softwareSpiCommandPinsValid(clock,mosi,chipSelect,dataCommand,0,0) || !gate.tryBeginRecovery(owner)) return false
    val healthy=softwareLcdConfigurePinsCheckedOwned(clock,mosi,chipSelect,dataCommand,sharedDataCommand) == 4
    val released=gate.finishRecovery(owner,healthy)
    return healthy && released
}
