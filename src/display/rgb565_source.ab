import "../esp32/sdk/raw_buffer.ab"

// Validate before multiplying: dimensions and span must fit the caller's
// buffer. Padding after the last row is not required. Zero-sized images are
// valid no-ops; negative sizes/stride are errors, not clipped successes.
fun lcdRgb565SourceValid(source: NativeBuffer, width: int, height: int, stride: int): bool {
    if (width < 0 || height < 0 || width > 65535 || height > 65535 || stride < 0) return false
    if (width == 0 || height == 0) return true
    val rowBytes = width * 2
    if (stride < rowBytes || rowBytes > source.capacity()) return false
    // Capacity is31-bit. A multirow image cannot fit if even one stride
    // exceeds remaining bytes; after that guard division is safely32-bit.
    // Single-row images may legitimately have an arbitrarily large stride.
    if (height > 1) {
        val remaining=source.capacity()-rowBytes
        if (stride > remaining || height-1 > int(u32(remaining)/u32(stride))) return false
    }
    source.hasAddressRange(0, (height - 1) * stride + rowBytes)
}
