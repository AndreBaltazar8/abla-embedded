import "./tab5_dsi_programs.ab"
import "./dsi_program_sequence.ab"
// Caller confirmed the panel variant and completed board power/reset/settle.
// Command-mode init only; video framebuffer/bridge initialization is separate.
trusted fun tab5DsiInitOwned(panel: int,channel: int,polls: int): DsiCommandResult {
    val count=tab5DsiInitListCount(panel)
    if (count == 0 || channel < 0 || channel > 3 || polls < 1 || polls > 1000000) return DsiCommandResult(2)
    var list=0
    while (list < count) {
        if (!dsiProgramValid(tab5DsiInitProgram(panel,list))) return DsiCommandResult(2)
        list=list+1
    }
    list=0
    while (list < count) {
        val result=dsiRunProgramOwned(channel,tab5DsiInitProgram(panel,list),polls)
        if (!result.hostComplete()) return result
        val delay=tab5DsiInitDelay(panel,list)
        if (delay != 0) dsiPanelDelayMilliseconds(delay)
        list=list+1
    }
    // Tab5 configuration: rgb_order=true, RGB565, command-mode initialization.
    val madctl=tab5DsiInitMadctl(channel,polls)
    if (!madctl.hostComplete()) return madctl
    tab5DsiInitColmod(channel,polls)
}
