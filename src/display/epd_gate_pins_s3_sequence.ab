import "./epd_gate_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../esp32/gpio/snapshot_s3_logic.ab"
// Record40:magic,state,cursor,packedPins,snapshots5@16,reserved36.
// States1ready,2closed,3parking,4restoring. Results0invalid,1ready,2closed,
// 3cleanup needed. Caller owns pads/shared GPIO RMW, releases RTC/USB/holds,
// quiesces old pad consumers and guarantees the old configuration is rail-OFF.
// Configure PWR low FIRST, then SPV/CKV/OE/LE low, latch before output-enable.
// No setup step can intentionally energize the panel. Partial setup retains
// every captured snapshot and must be closed, not treated as an absent owner.
trusted fun epdGatePinsOpenOwned(r: NativeBuffer,pins: EpdGatePins,offExclusive: bool): int {
    if (!offExclusive || !pins.valid() || !r.hasAddressRange(0,40) || (r.addressValue()&3) != 0 ||
        (r.loadU32(0) != 0 && (r.loadU32(0) != 0x45504750 || r.loadU32(4) != 2))) return 0
    var index=0
    while (index < 5) {
        if (!epdGatePinValid(pins.pin(index))) return 0
        index=index+1
    }
    index=0
    while (index < 5) {
        val saved=epdGatePinCapture(pins.pin(index))
        if (!saved.valid() || saved.pin() != pins.pin(index)) return 0
        r.storeU32(16+index*4,saved|0);index=index+1
    }
    r.storeU32(0,0x45504750);r.storeU32(4,3);r.storeU32(8,0);r.storeU32(12,pins|0);r.storeU32(36,0)
    index=0
    while (index < 5) {
        if (!epdGatePinPrepareLow(pins.pin(index))) return 3
        index=index+1
    }
    r.storeU32(4,1);return 1
}
// After successful use, caller proves LCD/DMA stopped and rails actually OFF
// (not just a requested shutdown). On partial-open failure the initial OFF
// proof still holds. Keep all pads owned through both cleanup phases.
trusted fun epdGatePinsCloseOwned(r: NativeBuffer,offIdleExclusive: bool): int {
    if (!offIdleExclusive || !r.hasAddressRange(0,40) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x45504750) return 0
    if (r.loadU32(4) == 2) return 2
    if (r.loadU32(4) != 1 && r.loadU32(4) != 3 && r.loadU32(4) != 4) return 0
    if (r.loadU32(8) > 5 || !EpdGatePins(r.loadU32(12)).valid()) return 0
    var index=0
    while (index < 5) {
        val saved=S3GpioSnapshot(r.loadU32(16+index*4))
        if (!saved.valid() || saved.pin() != EpdGatePins(r.loadU32(12)).pin(index)) return 0
        index=index+1
    }
    if (r.loadU32(4) == 1) { r.storeU32(4,3);r.storeU32(8,0) }
    if (r.loadU32(4) == 3) {
        index=r.loadU32(8)
        while (index < 5) {
            if (!epdGatePinPark(S3GpioSnapshot(r.loadU32(16+index*4)).pin())) return 3
            index=index+1;r.storeU32(8,index)
        }
        r.storeU32(4,4);r.storeU32(8,0)
    }
    index=r.loadU32(8)
    while (index < 5) {
        if (epdGatePinRestore(S3GpioSnapshot(r.loadU32(16+index*4))) != 1) return 3
        index=index+1;r.storeU32(8,index)
    }
    r.storeU32(4,2);return 2
}
