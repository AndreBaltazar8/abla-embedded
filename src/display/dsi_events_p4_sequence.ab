// IDF6 mipi_dsi_brg_ll: underrun bit0 on both layouts; VSYNC bit1 ONLY
// hw_ver3. Bridge events are separate from DW-GDMA completion/status.
// Caller owns the clocked bridge interrupt registers, with same-core IRQs
// masked and no competing core access. Never clear DMA completion here: the
// deferred immutable-frame rearm path needs that evidence.
fun esp32P4DsiEventMask(layout: int): int = if (layout == 1) 1 else if (layout == 3) 3 else 0

// 1updated,2invalid,3unexpected existing enable,4readback failure.
// No pending acknowledgement: events latched during deferred processing must
// cause a new interrupt after explicit re-enable. Caller first installs the
// handler and routes the level source. Disabling does not join its callback.
trusted fun esp32P4DsiEventsEnableOwned(layout: int,expected: int,enabled: int): int {
    val mask=esp32P4DsiEventMask(layout)
    if (mask == 0 || expected < 0 || enabled < 0 ||
        (expected&mask) != expected || (enabled&mask) != enabled) return 2
    val prior=p4DsiBridgeRead(80)
    if ((int(prior)&mask) != expected) return 3
    p4DsiBridgeWrite(80,(prior&(u32(4294967295)^u32(mask)))|u32(enabled))
    if ((int(p4DsiBridgeRead(80))&mask) != enabled) return 4
    return 1
}

// Bounded ISR top half: snapshot -> mask bridge events -> readback -> clear
// ONLY captured status. No allocation/cache work/restart/spin/callback calls.
// Low8:1captured,2invalid,4mask-write failure (nothing acknowledged).
// Bits8..9 captured events, bits16..17 previously enabled events.
// Caller retains the report before returning and schedules deferred service.
// Events coalesce (not frame counts). An underrun is a real fault, not success;
// worker must preserve/report it rather than automatically resume rendering.
trusted fun esp32P4DsiEventsCaptureOwned(layout: int): int {
    val mask=esp32P4DsiEventMask(layout)
    if (mask == 0) return 2
    val prior=p4DsiBridgeRead(80)
    val events=p4DsiBridgeRead(92)&u32(mask)
    val report=(int(events)<<8)|((int(prior)&mask)<<16)
    p4DsiBridgeWrite(80,prior&(u32(4294967295)^u32(mask)))
    if ((int(p4DsiBridgeRead(80))&mask) != 0) return report|4
    if (events != u32(0)) p4DsiBridgeWrite(84,events)
    return report|1
}
