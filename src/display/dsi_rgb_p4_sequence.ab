import "./dsi_timing_p4_sequence.ab"
// RGB packet + bridge color setup. Does NOT enable video/bridge/DMA.
// v1 shares input/output format; v3 has separate RGB conversion fields.
// Pixel bits16=RGB565,24=RGB888. YUV belongs to a separate conversion path.
// Caller owns command-mode host/disabled bridge and has quiesced transfers.
trusted fun esp32P4DsiConfigureRgbOwned(hwVersion: int,width: int,inputBits: int,outputBits: int,channel: int,allowLp: bool,frameAck: bool,polls: int): DsiCommandResult {
    if ((hwVersion != 1 && hwVersion != 3) || width < 1 || width > 4095 ||
        (inputBits != 16 && inputBits != 24) || (outputBits != 16 && outputBits != 24) ||
        (hwVersion == 1 && inputBits != outputBits) || channel < 0 || channel > 3 ||
        polls < 1 || polls > 1000000) return DsiCommandResult(2)
    if ((p4DsiRead(52)&u32(1)) == u32(0) || (p4DsiBridgeRead(4)&u32(1)) != u32(0) ||
        (frameAck && (p4DsiRead(44)&u32(4)) == u32(0))) return DsiCommandResult(10)
    if (!esp32P4DsiWaitIdleOwned(polls)) return DsiCommandResult(3)
    if ((p4DsiRead(116)&u32(16)) == u32(0)) return DsiCommandResult(9)
    val errors=esp32P4DsiErrorSnapshotOwned()
    if (errors != 0) return DsiCommandResult(errors|4)
    val video=u32(2|(if (allowLp) 48896 else 0)|(if (frameAck) 16384 else 0))
    if (!dsiHostTimingWrite(12,u32(3),u32(channel)) ||
        !dsiHostTimingWrite(16,u32(271),u32(if (outputBits == 16) 0 else 5)) ||
        !dsiHostTimingWrite(20,u32(31),u32(0)) ||
        !dsiHostTimingWrite(56,u32(130819),video) ||
        !dsiHostTimingWrite(60,u32(16383),u32(width)) ||
        !dsiHostTimingWrite(64,u32(8191),u32(0)) ||
        !dsiHostTimingWrite(68,u32(8191),u32(0))) return DsiCommandResult(6)
    val mask=u32(if (hwVersion == 1) 127 else 2047)
    val color=u32((if (inputBits == 16) 2 else 0)|(if (hwVersion == 3 && outputBits == 16) 256 else 0))
    p4DsiBridgeWrite(24,(p4DsiBridgeRead(24)&(u32(4294967295)^mask))|color)
    if ((p4DsiBridgeRead(24)&mask) != color) return DsiCommandResult(6)
    DsiCommandResult(1)
}
