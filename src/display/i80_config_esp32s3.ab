import "./i80_config_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/display.ab"
@inline
@export("esp32S3I80Read")
trusted fun esp32S3I80ReadHook(address: int): int = mmioLoadU32(address)
@inline
@export("esp32S3I80Write")
trusted fun esp32S3I80WriteHook(address: int,value: int): void { mmioStoreU32(address,value);return }
