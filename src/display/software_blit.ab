import "./software_rgb565.ab"
import "./rgb565_source.ab"


// Source pixels are RGB565, big-endian by default, with explicit byte stride.
// Reads caller-owned immutable bytes directly; no framebuffer/scratch copy.
// Panel/view/pin prerequisites match softwareLcdFillRect. Clipping advances
// source coordinates, never rescales. Entire window and pixels share one gate.
trusted fun softwareLcdBlitRgb565(gate: PeripheralGate, owner: u32, clock: Pin, mosi: Pin,
    chipSelect: Pin, dataCommand: Pin, view: LcdView, x: int, y: int,
    source: NativeBuffer, width: int, height: int, stride: int,
    littleEndian: bool = false, halfPeriodMicroseconds: int = 1,
    sharedDataCommand: bool = false): SpiTransactionResult {
    if (!softwareSpiCommandPinsValid(clock, mosi, chipSelect, dataCommand, 0, halfPeriodMicroseconds) ||
        !view.valid() || !lcdRgb565SourceValid(source, width, height, stride)) {
        return SpiTransactionResult(3 << 32)
    }
    val rectangle = clipDisplayRect(x, y, width, height, view.width(), view.height())
    val span = if (width == 0 || height == 0) 0 else (height - 1) * stride + width * 2
    if (!gate.bufferDisjoint(source, span)) return SpiTransactionResult(3 << 32)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    if (!rectangle.empty()) {
        val column = view.columnStart() + rectangle.x()
        val row = view.rowStart() + rectangle.y()
        clock.write(false)
        softwareLcdCommandWordOwned(clock, mosi, chipSelect, dataCommand, u32(42),
            (u32(column) << u32(16)) | u32(column + rectangle.width() - 1), 32, halfPeriodMicroseconds, sharedDataCommand)
        softwareLcdCommandWordOwned(clock, mosi, chipSelect, dataCommand, u32(43),
            (u32(row) << u32(16)) | u32(row + rectangle.height() - 1), 32, halfPeriodMicroseconds, sharedDataCommand)
        dataCommand.write(false)
        if (sharedDataCommand) dataCommand.output()
        chipSelect.write(false)
        val command = softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(44), 8, 0, halfPeriodMicroseconds)
        dataCommand.write(true)
        val sourceX = rectangle.x() - x
        val sourceY = rectangle.y() - y
        var line = 0
        while (line < rectangle.height()) {
            var offset = (sourceY + line) * stride + sourceX * 2
            var pixel = 0
            while (pixel < rectangle.width()) {
                val first = source.load(offset)
                val second = source.load(offset + 1)
                val value = if (littleEndian) (second << 8) | first else (first << 8) | second
                val sent = softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(value), 16, 0, halfPeriodMicroseconds)
                offset = offset + 2
                pixel = pixel + 1
            }
            line = line + 1
        }
        chipSelect.write(true)
        if (sharedDataCommand) dataCommand.input()
    }
    if (!gate.finish(owner, true)) return SpiTransactionResult(5 << 32)
    SpiTransactionResult(1 << 32)
}
