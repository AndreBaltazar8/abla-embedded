import "./it8951_session.ab"
import "./it8951_readback.ab"
// Read a4-byte-aligned part of the reported byte-per-pixel image buffer only.
// No bytes outside that image are inferred safe. Partial scratch is not a
// successfully acquired image; any transport failure fault-latches the session.
trusted fun It8951Session.readImageWordsOwned(offset: int,destination: NativeBuffer,count: int,
    scratch: NativeBuffer,polls: int,exclusive: bool): It8951ImageResult {
    if (!exclusive || this.state() != 1 || !this.info().valid() || offset < 0 ||
        count < 1 || count > 65535 || !this.disjoint(destination,count*2) || !this.disjoint(scratch,8)) return It8951ImageResult(2)
    val bytes=this.info().width()*this.info().height()
    if (offset > bytes || count*2 > bytes-offset) return It8951ImageResult(2)
    val result=it8951ReadMemoryWords(this.context(),this.info().imageAddress()+offset,destination,count,scratch,polls)
    if (result.status() != 2) {
        this.remember(result|0)
        if (!result.success()) this.buffer().storeU32(4,2)
    }
    result
}
