import "./dsi_mailbox_p4_sequence.ab"
import "./dsi_events_esp32p4.ab"
import "../esp32/irq_dispatch_esp32p4.ab"
trusted fun p4DsiMailboxCore(): int = p4DispatchCore()
trusted fun p4DsiMailboxMasked(): bool = p4DispatchMasked()
// Integer-only dispatcher callback; source masked until worker resumes it.
// CPU line also disabled on invalid state/hardware failure/sticky underrun.
trusted fun esp32P4DsiMailboxEntry(frame: u32,line: u32,core: u32,context: u32): void {
    val box=p4DsiMailboxAt(nativeBufferAt(int(context),28))
    val result=box.captureOwned(int(line),int(core))
    if (result != 1 || (box.valid() && box.buffer().loadU32(24) != 0)) esp32P4ClicEnableOwned(int(line),false)
    return
}
// Caller owns clocked source, line disabled, MIEoff. Route/CLIC level mode and
// vector installation are separate; no partial implicit enable on registration.
trusted fun P4DsiMailbox.bindOwned(table: P4IrqDispatch,remove: bool): int {
    if (!this.owned() || !table.valid() || table.buffer().loadU32(4) != this.buffer().loadU32(4)) return 2
    val b=this.buffer().addressValue()
    val t=table.buffer().addressValue()
    if (b < t+272 && t < b+28) return 2
    val line=this.buffer().loadU32(12)
    val callback=nativeFunctionAddress(esp32P4DsiMailboxEntry)
    if (remove && table.buffer().loadU32(20+(line-16)*8) != b) return 3
    return table.setOwned(line,if (remove) callback else 0,if (remove) 0 else callback,if (remove) 0 else b)
}
