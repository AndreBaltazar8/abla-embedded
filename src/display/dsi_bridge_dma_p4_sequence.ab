// IDF6 bridge defaults for DMA-controlled flow, verified hw_ver1/ver3.
// Caller owns clocked, disabled bridge AND a stopped DMA channel. No address,
// descriptor, cache maintenance, bridge enable or DMA start is done here.
trusted fun dsiBridgeDmaField(offset: int,mask: u32,value: u32): bool {
    p4DsiBridgeWrite(offset,(p4DsiBridgeRead(offset)&(u32(4294967295)^mask))|value)
    (p4DsiBridgeRead(offset)&mask) == value
}
// 1 configuration written/readback,2 invalid,3 active,4 partial/readbackfail.
// Final counter-reload is a write-trigger: issued once, never tested as a
// persistent bit and never replayed by an ordinary read-modify-write.
trusted fun esp32P4DsiBridgeDmaConfigureOwned(width: int,height: int,inputBits: int,blocks: int): int {
    if (width < 1 || width > 4095 || height < 1 || height > 4095 ||
        (inputBits != 16 && inputBits != 24) || blocks < 1 || blocks > 15) return 2
    val bits=u32(width)*u32(height)*u32(inputBits)
    val words=(bits+u32(63))>>u32(6)
    if (words > u32(4194303)) return 2
    if ((p4DsiBridgeRead(4)&u32(1)) != u32(0) || (p4DsiBridgeRead(64)&u32(1)) != u32(0)) return 3
    val raw=(p4DsiBridgeRead(12)&u32(2139095040))|words|
        (if ((bits&u32(63)) != u32(0)) u32(4194304) else u32(0))
    p4DsiBridgeWrite(12,raw)
    if ((p4DsiBridgeRead(12)&u32(8388607)) != (raw&u32(8388607))) return 4
    if (!dsiBridgeDmaField(64,u32(65520),u32(width)<<u32(4)) ||
        !dsiBridgeDmaField(136,u32(241),u32(blocks)<<u32(4)) ||
        !dsiBridgeDmaField(108,u32(268435456),if (blocks > 1) u32(268435456) else u32(0)) ||
        !dsiBridgeDmaField(8,u32(4095),u32(256)) ||
        !dsiBridgeDmaField(140,u32(2047),u32(768))) return 4
    p4DsiBridgeWrite(12,raw|u32(2147483648))
    return 1
}
