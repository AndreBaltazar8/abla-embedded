import "./software_rgb565_checked.ab"
import "./rgb565_source.ab"
// Borrow immutable RGB565 bytes with explicit stride/endian. Full source and
// gate disjointness are checked before GPIO, even when clipping hides pixels.
// Read directly, no framebuffer copy. Keep one gate for window+continuous-CS
// pixels. Failure faults gate and preserves shared-D/C cleanup detail.
trusted fun softwareLcdBlitRgb565Checked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,
    chipSelect: Pin,dataCommand: Pin,view: LcdView,x: int,y: int,source: NativeBuffer,
    width: int,height: int,stride: int,littleEndian: bool = false,
    halfPeriodMicroseconds: int = 1,sharedDataCommand: bool = false,resetRowWindow: bool = false): SpiTransactionResult {
    if (!softwareSpiCommandPinsValid(clock,mosi,chipSelect,dataCommand,0,halfPeriodMicroseconds) ||
        !view.valid() || !lcdRgb565SourceValid(source,width,height,stride)) return SpiTransactionResult(3<<32)
    val rect=clipDisplayRect(x,y,width,height,view.width(),view.height())
    val span=if (width == 0 || height == 0) 0 else (height-1)*stride+width*2
    if (!gate.bufferDisjoint(source,span)) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    var result=SpiTransactionResult(1<<32)
    if (!rect.empty()) {
        result=softwareLcdWindowCheckedOwned(clock,mosi,chipSelect,dataCommand,view.columnStart()+rect.x(),view.rowStart()+rect.y(),rect.width(),rect.height(),halfPeriodMicroseconds,sharedDataCommand,resetRowWindow)
        if (result.valid()) result=softwareLcdPixelsBeginCheckedOwned(clock,mosi,chipSelect,dataCommand,halfPeriodMicroseconds,sharedDataCommand)
        if (result.valid()) {
            val sourceX=rect.x()-x;val sourceY=rect.y()-y
            var line=0
            while (line < rect.height()) {
                var offset=(sourceY+line)*stride+sourceX*2
                var pixel=0
                while (pixel < rect.width()) {
                    val first=source.load(offset);val second=source.load(offset+1)
                    val value=if (littleEndian) (second<<8)|first else (first<<8)|second
                    val ignored=softwareSpiExchangeWordOwned(clock,mosi,Pin(-1),u32(value),16,0,halfPeriodMicroseconds)
                    offset=offset+2;pixel=pixel+1
                }
                line=line+1
            }
            result=softwareLcdPixelsEndCheckedOwned(chipSelect,dataCommand,sharedDataCommand)
        }
    }
    if (!gate.finish(owner,result.valid())) return SpiTransactionResult((5<<32)|(result&0xffffffff))
    return result
}
