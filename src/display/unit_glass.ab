import "./mono_page_canvas.ab"
import "../i2c/results.ab"
// Original UnitGLASS MCU protocol, NOT SSD1306/GLASS2. Based on pinned
// M5GFX Panel_M5UnitGLASS; notice in epd_waveform.LICENSE. Borrowed device,
// exclusive bus/command/scratch lifetime. Caller supplies calibrated delay.
// All calls complete the unit's processing wait, including uncertain writes;
// no hidden retries, buzzer state, hardware-reset assumptions or heap buffers.
trusted fun I2cDevice.glassReadByte(key: int,scratch: NativeBuffer): I2cByteResult {
    if (!this.valid() || key < -1 || key > 1 || !scratch.hasAddressRange(0,1)) return I2cByteResult(0)
    scratch.store(0,if (key < 0) 254 else 208+key)
    val sent=this.write(scratch,1)
    // MCU needs a STOP before the read, and key selection needs512us.
    if (key >= 0) glassDelayMicroseconds(512)
    val read=sent && this.read(scratch,1)
    val result=if (read) I2cByteResult(256|scratch.load(0)) else I2cByteResult(0)
    glassDelayMicroseconds(1000)
    return result
}
trusted fun I2cDevice.glassSetSleep(sleep: bool,scratch: NativeBuffer): bool = this.glassFlag(112,sleep,scratch)
trusted fun I2cDevice.glassSetInvert(invert: bool,scratch: NativeBuffer): bool = this.glassFlag(160,invert,scratch)
trusted fun I2cDevice.glassBuzzerEnable(enable: bool,scratch: NativeBuffer): bool = this.glassFlag(195,enable,scratch)
trusted fun I2cDevice.glassFlag(command: int,flag: bool,scratch: NativeBuffer): bool {
    if (!this.valid() || (command != 112 && command != 160 && command != 195) || !scratch.hasAddressRange(0,2)) return false
    scratch.store(0,command);scratch.store(1,if (flag) 1 else 0)
    val result=this.write(scratch,2);glassDelayMicroseconds(1000);return result
}
trusted fun I2cDevice.glassBuzzer(frequency: int,duty: int,enable: bool,scratch: NativeBuffer): bool {
    if (!this.valid() || frequency < 0 || frequency > 65535 || duty < 0 || duty > 255 || !scratch.hasAddressRange(0,5)) return false
    scratch.store(0,192);scratch.storeU16(1,frequency);scratch.store(3,duty);scratch.store(4,if (enable) 1 else 0)
    val result=this.write(scratch,5);glassDelayMicroseconds(1000);return result
}
// Physical preclipped rectangle in complete128x64 page framebuffer; page Y
// expansion retains neighboring pixel bits. Each staged picture byte has its
// own transaction. Publish SHOW only after every page draw was acknowledged.
// low8:1complete2input3picturebyte4draw5show; completed page draws at8.
// Failures can have hardware effects: preserve framebuffer and retry explicitly.
trusted fun I2cDevice.glassDisplayRegion(frame: NativeBuffer,scratch: NativeBuffer,x: int,y: int,w: int,h: int): int {
    if (!this.valid() || x < 0 || y < 0 || x >= 128 || y >= 64 || w < 1 || h < 1 || w > 128-x || h > 64-y ||
        !frame.hasAddressRange(0,1024) || !scratch.hasAddressRange(0,6) ||
        (frame.addressValue() < scratch.addressValue()+6 && scratch.addressValue() < frame.addressValue()+1024)) return 2
    val first=y>>>3;val end=(y+h-1)>>>3
    var page=first
    while (page <= end) {
        var column=0
        while (column < w) {
            scratch.store(0,144);scratch.storeU16(1,column);scratch.store(3,frame.load(page*128+x+column))
            if (!this.write(scratch,4)) { glassDelayMicroseconds(1000);return 3|((page-first)<<8) }
            column=column+1
        }
        scratch.store(0,176);scratch.store(1,x);scratch.store(2,page*8)
        scratch.store(3,w);scratch.store(4,8);scratch.store(5,1)
        val drawn=this.write(scratch,6)
        glassDelayMicroseconds(w*32)
        if (!drawn) return 4|((page-first)<<8)
        page=page+1
    }
    scratch.store(0,16);scratch.store(1,1)
    val shown=this.write(scratch,2);glassDelayMicroseconds(5000)
    return (if (shown) 1 else 5)|((end-first+1)<<8)
}
