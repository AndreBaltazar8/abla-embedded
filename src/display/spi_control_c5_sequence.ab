import "./spi_program_c5_sequence.ab"
import "./lcd_logic.ab"
// Owned initialized MIPI panel. Publish the requested view only after success;
// failure retains partial hardware state. No hidden backlight/rail policy.
trusted fun esp32C5LcdConfigureRgb565(master: int,gate: PeripheralGate,owner: u32,dc: int,
    geometry: LcdGeometry,rotation: int,bgr: bool,inverted: bool,polls: int): SpiBufferResult {
    if (!geometry.valid() || rotation < 0 || rotation > 7) return SpiBufferResult(3<<56)
    val program=nativeBufferAt(nativeStackAllocate(10),10)
    program.store(0,58);program.store(1,1);program.store(2,85)
    program.store(3,54);program.store(4,1);program.store(5,geometry.view(rotation,bgr).madctl())
    program.store(6,if (inverted) 33 else 32);program.store(7,0)
    program.store(8,255);program.store(9,255)
    return esp32C5LcdRunProgram(master,gate,owner,dc,program,10,polls)
}
// Generic fixed no-argument MIPI control; accepts only display on/off,
// idle on/off, inversion, sleep in/out. Delay0..254ms or500ms encoded exactly.
trusted fun esp32C5LcdControl(master: int,gate: PeripheralGate,owner: u32,dc: int,
    command: int,settleMilliseconds: int,polls: int): SpiBufferResult {
    if ((command != 16 && command != 17 && command != 32 && command != 33 &&
        command != 40 && command != 41 && command != 56 && command != 57) ||
        settleMilliseconds < 0 || (settleMilliseconds > 254 && settleMilliseconds != 500)) return SpiBufferResult(3<<56)
    val program=nativeBufferAt(nativeStackAllocate(5),5)
    program.store(0,command);program.store(1,128)
    program.store(2,if (settleMilliseconds == 500) 255 else settleMilliseconds)
    program.store(3,255);program.store(4,255)
    return esp32C5LcdRunProgram(master,gate,owner,dc,program,5,polls)
}
