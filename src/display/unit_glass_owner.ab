import "./unit_glass.ab"
// Scalar owned device32/status8/original-open-error8/firmware-result9.
// No heap or copied ownership. Assign returned close result back to the owner.
// Bus/reset/power remain borrowed; serialize all calls and close before bus.
// Backend supplies unitGlassBufferSafe to exclude private provider storage.
type UnitGlassOwner=int
fun UnitGlassOwner.device(): I2cDevice = I2cDevice(this&0xffffffff)
fun UnitGlassOwner.status(): int = (this>>>32)&255
fun UnitGlassOwner.openFailure(): int = (this>>>40)&255
fun UnitGlassOwner.firmware(): I2cByteResult = I2cByteResult((this>>>48)&511)
fun UnitGlassOwner.ready(): bool = this.status() == 1 && this.device().valid() && this.firmware().valid()
fun glassOwnerPack(handle: int,status: int,original: int,firmware: I2cByteResult): UnitGlassOwner =
    UnitGlassOwner((handle&0xffffffff)|(status<<32)|(original<<40)|((firmware&511)<<48))
//0closed1ready2admission3allocation4firmware5buzzer-off6sleep7release8invert.
// Every failed post-allocation step retains the device for explicit cleanup.
trusted fun unitGlassOpenOwned(bus: I2cBus,scratch: NativeBuffer,exclusive: bool,address: int = 61): UnitGlassOwner {
    if (!exclusive || !bus.valid() || address < 1 || address > 127 || !unitGlassBufferSafe(scratch,2)) return glassOwnerPack(0,2,2,I2cByteResult(0))
    val device=bus.device(address,400000)
    if (!device.valid()) return glassOwnerPack(0,3,3,I2cByteResult(0))
    val firmware=device.glassReadByte(-1,scratch)
    var status=if (firmware.valid()) 1 else 4
    if (status == 1 && !device.glassBuzzerEnable(false,scratch)) status=5
    if (status == 1 && !device.glassSetInvert(false,scratch)) status=8
    if (status == 1 && !device.glassSetSleep(false,scratch)) status=6
    return glassOwnerPack(device|0,status,if (status == 1) 0 else status,firmware)
}
trusted fun UnitGlassOwner.readKeyOwned(key: int,scratch: NativeBuffer,exclusive: bool): I2cByteResult =
    if (!exclusive || !this.ready() || key < 0 || key > 1 || !unitGlassBufferSafe(scratch,1)) I2cByteResult(0)
    else this.device().glassReadByte(key,scratch)
trusted fun UnitGlassOwner.setBuzzerOwned(frequency: int,duty: int,enabled: bool,scratch: NativeBuffer,exclusive: bool): bool =
    exclusive && this.ready() && unitGlassBufferSafe(scratch,5) && this.device().glassBuzzer(frequency,duty,enabled,scratch)
trusted fun UnitGlassOwner.displayOwned(frame: NativeBuffer,scratch: NativeBuffer,x: int,y: int,w: int,h: int,exclusive: bool): int =
    if (!exclusive || !this.ready() || !unitGlassBufferSafe(frame,1024) || !unitGlassBufferSafe(scratch,6)) 2
    else this.device().glassDisplayRegion(frame,scratch,x,y,w,h)
// Silence first, then sleep, then release. On failure retain the same device,
// original error and firmware. Do not silently orphan a potentially sounding
// unit when communication fails. False admission leaves this scalar unchanged.
trusted fun UnitGlassOwner.closeOwned(scratch: NativeBuffer,exclusive: bool): UnitGlassOwner {
    if (!exclusive || !unitGlassBufferSafe(scratch,2)) return this
    val device=this.device()
    if ((device|0) == 0) return glassOwnerPack(0,0,this.openFailure(),this.firmware())
    val status=if (!device.glassBuzzerEnable(false,scratch)) 5 else if (!device.glassSetSleep(true,scratch)) 6 else if (!device.close()) 7 else 0
    return glassOwnerPack(if (status == 0) 0 else device|0,status,this.openFailure(),this.firmware())
}
