import "../spi/software_shared_command.ab"

@inline
trusted fun softwareLcdCommandOwned(clock: Pin, mosi: Pin, chipSelect: Pin, dataCommand: Pin,
    command: int, data: NativeBuffer, length: int, halfPeriodMicroseconds: int,
    sharedDataCommand: bool): bool =
    if (sharedDataCommand) softwareSpiSharedCommandOwned(clock, mosi, chipSelect, dataCommand,
        command, data, length, 0, halfPeriodMicroseconds)
    else softwareSpiCommandOwned(clock, mosi, chipSelect, dataCommand,
        command, data, length, 0, halfPeriodMicroseconds)
