import "./rgb565_source.ab"
import "./lcd_logic.ab"
import "./color.ab"
// Caller-owned RGB565 shadow image, big-endian wire bytes, arbitrary row
// padding. No hidden allocation/display I/O. Initialize the ENTIRE image before
// a widened flush: adjacent pixels are preserved from this shadow, not guessed.
// Caller serializes mutation and flush; source and ownership are not copied.
trusted fun rgb565CanvasFillOwned(canvas: NativeBuffer,width: int,height: int,stride: int,
    x: int,y: int,w: int,h: int,color: Rgb565,exclusive: bool): bool {
    if (!exclusive || width < 1 || height < 1 || !lcdRgb565SourceValid(canvas,width,height,stride) ||
        x < -2147483648 || x > 2147483647 || y < -2147483648 || y > 2147483647 ||
        w < 0 || w > 65535 || h < 0 || h > 65535) return false
    val rectangle=clipDisplayRect(x,y,w,h,width,height)
    var row=0
    while (row < rectangle.height()) {
        var col=0
        while (col < rectangle.width()) {
            val offset=(rectangle.y()+row)*stride+(rectangle.x()+col)*2
            canvas.store(offset,(color&65535)>>>8);canvas.store(offset+1,color&255)
            col=col+1
        }
        row=row+1
    }
    return true
}
// Widen clipped dirty bounds to even x/y and even width/height, following the
// AMOLED shadow flush. Even-sized canvas required; no loss at right/bottom.
// Empty result means empty/invalid request, never permission to clear pixels.
fun rgb565CanvasAlignedRegion(width: int,height: int,x: int,y: int,w: int,h: int): DisplayRect {
    if (width < 2 || width > 65534 || height < 2 || height > 65534 ||
        (width&1) != 0 || (height&1) != 0 || w < 0 || w > 65535 || h < 0 || h > 65535 ||
        x < -2147483648 || x > 2147483647 || y < -2147483648 || y > 2147483647) return DisplayRect(0)
    val clipped=clipDisplayRect(x,y,w,h,width,height)
    if (clipped.empty()) return DisplayRect(0)
    val left=clipped.x()&~1;val top=clipped.y()&~1
    val right=(clipped.x()+clipped.width()+1)&~1
    val bottom=(clipped.y()+clipped.height()+1)&~1
    return displayRect(left,top,right-left,bottom-top)
}
