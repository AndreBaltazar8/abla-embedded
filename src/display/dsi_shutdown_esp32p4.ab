import "./dsi_shutdown_p4_sequence.ab"
import "./dsi_video_esp32p4.ab"
import "./dpi_clock_esp32p4.ab"
trusted fun p4DsiShutdownDma(channel: int,polls: int): int = esp32P4DwDmaStopOwned(channel,polls)
trusted fun p4DsiShutdownPixelClock(): int = esp32P4DpiClockStopOwned()
trusted fun esp32P4DsiVideoShutdown(channel: int,polls: int): int = esp32P4DsiVideoShutdownOwned(channel,polls)
