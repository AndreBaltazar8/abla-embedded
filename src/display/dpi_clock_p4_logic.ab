// DPI source selectors:0 XTAL,1 PLL240M,2 PLL160M,3 APLL.
// Source frequency is supplied by the platform clock owner (stable/pinned).
type DpiClockPlan = int
fun DpiClockPlan.valid(): bool = (this&512) != 0
fun DpiClockPlan.divider(): int = this&511
fun DpiClockPlan.source(): int = (this>>>10)&3
fun DpiClockPlan.sourceKhz(): int = (this>>>32)&4294967295
// Prefer the rational sourceKhz/divider for timing computations; these
// explicitly rounded views must not be mistaken for measured frequency.
fun DpiClockPlan.floorKhz(): int = if (this.valid()) int(u32(this.sourceKhz())/u32(this.divider())) else 0
fun DpiClockPlan.ceilKhz(): int = if (this.valid()) int((u32(this.sourceKhz())+u32(this.divider()-1))/u32(this.divider())) else 0
fun esp32P4DpiClockPlan(source: int,sourceKhz: int,expectedKhz: int): DpiClockPlan {
    if (source < 0 || source > 3 || sourceKhz < 1000 || sourceKhz > 1000000 || expectedKhz < 1000 || expectedKhz > 160000 ||
        (source == 1 && sourceKhz != 240000) || (source == 2 && sourceKhz != 160000)) return DpiClockPlan(0)
    // IDF nearest-integer divider, not nearest achievable output frequency.
    val divider=int((u32(sourceKhz)+u32(expectedKhz)/u32(2))/u32(expectedKhz))
    if (divider < 1 || divider > 256 || sourceKhz > 240000*divider) return DpiClockPlan(0)
    DpiClockPlan(512|divider|(source<<10)|(sourceKhz<<32))
}
