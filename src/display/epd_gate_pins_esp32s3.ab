import "./epd_gate_pins_s3_sequence.ab"
import "./epd_scanout_esp32s3.ab"
trusted fun epdGatePinValid(number: int): bool = espChipS3().gpioOutputValid(number)
trusted fun epdGatePinCapture(number: int): S3GpioSnapshot = esp32S3GpioSnapshotOwned(number,true)
trusted fun epdGatePinPrepareLow(number: int): bool = Pin(number).outputLevelOwned(false) && epdGateOutputPrepared(number)
trusted fun epdGatePinPark(number: int): bool = esp32S3GpioParkOutputOwned(number)
trusted fun epdGatePinRestore(saved: S3GpioSnapshot): int = saved.restoreOwned(true)
// Stronger close boundary for the integrated display: actual scanout close must
// have completed both transport teardown and power-off before gate restoration.
trusted fun epdGatePinsCloseAfterScanoutOwned(r: NativeBuffer,s: NativeBuffer,t: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,40) || !epdScanoutValid(s,t) || s.loadU32(4) != 7 ||
        t.loadU32(4) != 5 || r.loadU32(12) != s.loadU32(12) ||
        !epdWaveformDisjoint(r,40,s,32) || !epdWaveformDisjoint(r,40,t,160)) return 0
    return epdGatePinsCloseOwned(r,true)
}
