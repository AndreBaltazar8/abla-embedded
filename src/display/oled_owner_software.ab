import "./oled_owner.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../i2c/software_provider.ab"
import "../esp32/sdk/nativebuffer_type.ab"
// Import with a selected software-I2C provider. Protect provider bookkeeping
// against both scratch writes and accidental frame-data disclosure.
fun oledOwnerBufferSafe(buffer: NativeBuffer,length: int): bool = softwareI2cProviderBufferSafe(buffer,length)
