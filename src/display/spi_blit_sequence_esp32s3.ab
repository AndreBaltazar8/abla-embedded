import "./rgb565_source.ab"
import "./lcd_logic.ab"
import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
import "../spi/buffer_gate.ab"
import "../esp32/spi/command_pins_sequence_esp32s3.ab"

// Caller owns initialized RGB565 panel/view/SPI. All other CS inactive.
// Big-endian pixels use direct row views; little-endian pixels require64
// caller-owned staging bytes disjoint from the complete source and gate.
// CS remains low through RAMWR and all pixel chunks; clock gaps are allowed.
// No framebuffer allocation, automatic retry, or partial-frame success.
trusted fun esp32s3LcdBlitRgb565(gate: PeripheralGate, owner: u32,
    peripheral: int, pins: SpiPins, select: Pin, dataCommand: Pin, view: LcdView,
    x: int, y: int, source: NativeBuffer, width: int, height: int, stride: int,
    littleEndian: bool = false, staging: NativeBuffer = NativeBuffer(0),
    sharedDataCommand: bool = false,resetRowWindow: bool = false): SpiTransactionResult {
    if (!esp32s3SpiCommandPinsValid(peripheral, pins, select, dataCommand, sharedDataCommand) ||
        !view.valid() || !lcdRgb565SourceValid(source, width, height, stride))
        return SpiTransactionResult(3 << 32)
    val span = if (width == 0 || height == 0) 0 else (height - 1) * stride + width * 2
    if (!esp32s3SpiMemoryRangeValid(peripheral, source, span) || !gate.bufferDisjoint(source, span))
        return SpiTransactionResult(3 << 32)
    val rectangle = clipDisplayRect(x, y, width, height, view.width(), view.height())
    if (littleEndian && !rectangle.empty()) {
        if (!esp32s3SpiMemoryRangeValid(peripheral, staging, 64) || !gate.bufferDisjoint(staging, 64) ||
            (staging.addressValue() < source.addressValue() + span &&
                source.addressValue() < staging.addressValue() + 64)) return SpiTransactionResult(3 << 32)
    }
    val gateAddress = gate.word().address()
    if (gateAddress <= 0 || gateAddress > 4294967292) return SpiTransactionResult(3 << 32)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    var detail = 1
    if (!rectangle.empty()) {
        val column = view.columnStart() + rectangle.x()
        val row = view.rowStart() + rectangle.y()
        if (resetRowWindow) detail=esp32s3SpiCommandWordOwned(peripheral,select,dataCommand,43,u32(0xffffffff),4,sharedDataCommand)
        if ((detail&255) == 1) detail = esp32s3SpiCommandWordOwned(peripheral, select, dataCommand, 42,
            (u32(column) << u32(16)) | u32(column + rectangle.width() - 1), 4, sharedDataCommand)
        if ((detail & 255) == 1) detail = esp32s3SpiCommandWordOwned(peripheral, select, dataCommand, 43,
            (u32(row) << u32(16)) | u32(row + rectangle.height() - 1), 4, sharedDataCommand)
        if ((detail & 255) == 1) {
            detail=esp32s3SpiCommandPinsBegin(select,dataCommand)
            if (detail == 1) detail = esp32s3SpiTransmitByteOwned(peripheral, 44, 100000)
            if ((detail & 255) == 1) {
                if (!dataCommand.writeLevelOwned(true)) detail=(detail&~255)|13
                val sourceX = rectangle.x() - x
                val sourceY = rectangle.y() - y
                var line = 0
                while (line < rectangle.height() && (detail & 255) == 1) {
                    val rowOffset = (sourceY + line) * stride + sourceX * 2
                    var sent = 0
                    val rowBytes = rectangle.width() * 2
                    while (sent < rowBytes && (detail & 255) == 1) {
                        val count = if (rowBytes - sent < 64) rowBytes - sent else 64
                        var chunk = nativeBufferAt(source.addressValue() + rowOffset + sent, count)
                        if (littleEndian) {
                            var byte = 0
                            while (byte < count) {
                                staging.store(byte, chunk.load(byte + 1))
                                staging.store(byte + 1, chunk.load(byte))
                                byte = byte + 2
                            }
                            chunk = nativeBufferAt(staging.addressValue(), count)
                        }
                        detail = esp32s3SpiTransmitOwned(peripheral, chunk, count, 100000)
                        sent = sent + count
                    }
                    line = line + 1
                }
            }
            detail=esp32s3SpiCommandPinsEndQuiescent(peripheral,select,dataCommand,sharedDataCommand,detail)
        }
    }
    val healthy = (detail & 255) == 1
    if (!gate.finish(owner, healthy)) return SpiTransactionResult((5 << 32) | detail)
    SpiTransactionResult(((if (healthy) 1 else 6) << 32) | detail)
}
