import "./ssd1677_frame.ab"
// Caller-exclusive64B record, initialized drawing96000B/history96000B owned
// separately. No heap/copies of live ownership. Header magic,status,canvas64,
// history64,flags,x,y,w,h,lastResult64,lastWireMode,boardStartupResult64.
// Status1usable2faulted3deep-sleep. Flags1knownface,2oddface,4analogOn,8historyValid,16invert.
type Ssd1677Session=int
fun Ssd1677Session.buffer(): NativeBuffer = NativeBuffer(this|0)
trusted fun Ssd1677Session.canvas(): NativeBuffer = NativeBuffer(this.buffer().loadU32(8)|(this.buffer().loadU32(12)<<32))
trusted fun Ssd1677Session.history(): NativeBuffer = NativeBuffer(this.buffer().loadU32(16)|(this.buffer().loadU32(20)<<32))
fun ssd1677SessionStorageSafe(r: NativeBuffer,canvas: NativeBuffer,history: NativeBuffer): bool =
    r.hasAddressRange(0,64) && (r.addressValue()&3) == 0 && canvas.hasAddressRange(0,96000) && history.hasAddressRange(0,96000) &&
    ssd1677FrameDisjoint(r,64,canvas,96000) && ssd1677FrameDisjoint(r,64,history,96000) && ssd1677FrameDisjoint(canvas,96000,history,96000)
trusted fun Ssd1677Session.valid(): bool {
    val r=this.buffer()
    return r.hasAddressRange(0,64) && (r.addressValue()&3) == 0 && r.loadU32(0) == 0x53313637 &&
        ssd1677SessionStorageSafe(r,this.canvas(),this.history())
}
// Fresh zero record. Before refreshing, panel must be awake/physically reset. Setting
// initialized=false requests software init during first refresh; never wakes
// a deep-sleep panel. New ownership always starts with UNKNOWN optical history.
trusted fun ssd1677SessionOpenOwned(r: NativeBuffer,canvas: NativeBuffer,history: NativeBuffer,
    initialized: bool,exclusive: bool): Ssd1677Session {
    if (!exclusive || !ssd1677SessionStorageSafe(r,canvas,history) || r.loadU32(0) != 0) return Ssd1677Session(0)
    var offset=4
    while (offset < 64) { r.storeU32(offset,0);offset=offset+4 }
    r.storeU32(0,0x53313637);r.storeU32(4,1)
    r.storeU32(8,canvas&4294967295);r.storeU32(12,canvas>>>32)
    r.storeU32(16,history&4294967295);r.storeU32(20,history>>>32)
    r.storeU32(24,if (initialized) 1 else 0);r.storeU32(36,800);r.storeU32(40,480)
    return Ssd1677Session(r|0)
}
// Physical dirty rectangle; union before refresh. Drawing can continue while
// faulted under caller exclusivity, retaining all edits until explicit recovery.
trusted fun Ssd1677Session.dirtyValid(): bool {
    if (!this.valid()) return false
    val r=this.buffer()
    return (r.loadU32(36) == 0 && r.loadU32(40) == 0) ||
        ssd1677DirtyValid(800,480,r.loadU32(28),r.loadU32(32),r.loadU32(36),r.loadU32(40))
}
trusted fun Ssd1677Session.markDirtyOwned(x: int,y: int,w: int,h: int,exclusive: bool): bool {
    if (!exclusive || !this.dirtyValid() || !ssd1677DirtyValid(800,480,x,y,w,h)) return false
    val r=this.buffer()
    if (r.loadU32(36) == 0) { r.storeU32(28,x);r.storeU32(32,y);r.storeU32(36,w);r.storeU32(40,h);return true }
    val left=if (x < r.loadU32(28)) x else r.loadU32(28)
    val top=if (y < r.loadU32(32)) y else r.loadU32(32)
    val right=if (x+w > r.loadU32(28)+r.loadU32(36)) x+w else r.loadU32(28)+r.loadU32(36)
    val bottom=if (y+h > r.loadU32(32)+r.loadU32(40)) y+h else r.loadU32(32)+r.loadU32(40)
    r.storeU32(28,left);r.storeU32(32,top);r.storeU32(36,right-left);r.storeU32(40,bottom-top);return true
}
// Logical drawing/readback is unchanged. No hardware I/O until refresh.
// An inversion change invalidates the optical baseline, not the controller
// face; the next differential request must become a full absolute refresh.
trusted fun Ssd1677Session.setInvertOwned(invert: bool,exclusive: bool): bool {
    if (!exclusive || !this.valid()) return false
    val r=this.buffer();val flags=r.loadU32(24)
    if (flags > 31 || r.loadU32(4) < 1 || r.loadU32(4) > 3) return false
    if (((flags&16) != 0) == invert) return true
    r.storeU32(24,(flags&7)|(if (invert) 16 else 0))
    r.storeU32(28,0);r.storeU32(32,0);r.storeU32(36,800);r.storeU32(40,480)
    return true
}
// Only AFTER caller completed hardware reset and SPI/gate recovery. This
// changes bookkeeping, not hardware. Next refresh software-inits/full-baselines.
trusted fun Ssd1677Session.invalidateAfterResetOwned(exclusiveResetComplete: bool): bool {
    if (!exclusiveResetComplete || !this.valid()) return false
    val r=this.buffer();r.storeU32(4,1);r.storeU32(24,r.loadU32(24)&16)
    r.storeU32(28,0);r.storeU32(32,0);r.storeU32(36,800);r.storeU32(40,480);return true
}
