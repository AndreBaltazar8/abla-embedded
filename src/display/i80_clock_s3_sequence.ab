import "abla/runtime/scalar"
// Canonical RCC lock held; LCD and selected GDMA channel exclusively owned.
// LCD_CAM bit8 and GDMA bit6 share EN1/RST1. Only enable/release reset, never
// pulse a shared reset or gate a domain on per-device teardown. Camera and
// other GDMA users retain their register state. This does not power PLL160M.
trusted fun esp32S3LcdDmaEnableClockLocked(): bool {
    val clock=esp32S3I80ClockRead(0x600C001C)
    esp32S3I80ClockWrite(0x600C001C,clock|320)
    if ((esp32S3I80ClockRead(0x600C001C)&320) != 320) return false
    val reset=esp32S3I80ClockRead(0x600C0024)
    esp32S3I80ClockWrite(0x600C0024,reset&(~320))
    return (esp32S3I80ClockRead(0x600C0024)&320) == 0
}
