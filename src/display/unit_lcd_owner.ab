import "./unit_lcd.ab"
// Owned device32/status8/original-open-error8/firmware9/rotation3/swap1/detail3.
// Bus remains borrowed. Serialize access, assign returned owners, and close
// before the bus. No reset or implicit recovery of uncertain device commands.
type UnitLcdOwner=int
fun UnitLcdOwner.device(): I2cDevice = I2cDevice(this&0xffffffff)
fun UnitLcdOwner.status(): int = (this>>>32)&255
fun UnitLcdOwner.openFailure(): int = (this>>>40)&255
fun UnitLcdOwner.firmware(): I2cByteResult = I2cByteResult((this>>>48)&511)
fun UnitLcdOwner.rotation(): int = (this>>>57)&7
fun UnitLcdOwner.byteSwap(): bool = ((this>>>60)&1) != 0
fun UnitLcdOwner.detail(): int = (this>>>61)&7
fun UnitLcdOwner.ready(): bool = this.status() == 1 && this.device().valid() && this.firmware().valid()
fun lcdOwnerPack(handle: int,status: int,original: int,firmware: I2cByteResult,rotation: int,swap: bool,detail: int): UnitLcdOwner =
    UnitLcdOwner((handle&0xffffffff)|(status<<32)|(original<<40)|((firmware&511)<<48)|((rotation&7)<<57)|((if (swap) 1 else 0)<<60)|((detail&7)<<61))
//0closed1ready2admission3allocation4identity5power6sleep7swap8rotation
//9invert10brightness11release. detail preserves protocol status3/4/5.
// Successful initialization establishes every tracked mode explicitly, with
// brightness last. Partial failures retain the handle for caller cleanup.
trusted fun unitLcdOpenOwned(bus: I2cBus,scratch: NativeBuffer,exclusive: bool,rotation: int = 0,swap: bool = false,brightness: int = 128,polls: int = 16,address: int = 62): UnitLcdOwner {
    if (!exclusive || !bus.valid() || address < 1 || address > 127 || rotation < 0 || rotation > 7 || brightness < 0 || brightness > 255 || polls < 1 || polls > 255 || !unitLcdBufferSafe(scratch,5)) return lcdOwnerPack(0,2,2,I2cByteResult(0),0,false,2)
    val device=bus.device(address,100000)
    if (!device.valid()) return lcdOwnerPack(0,3,3,I2cByteResult(0),rotation,swap,0)
    val firmware=device.unitLcdIdentify(scratch)
    var status=if (firmware.valid()) 1 else 4;var detail=0
    var step=5
    while (status == 1 && step <= 10) {
        val command=if (step == 5) 56 else if (step == 6) 57 else if (step == 7) 58 else if (step == 8) 54 else 34
        val value=if (step == 5) 1 else if (step == 6) 0 else if (step == 7) (if (swap) 1 else 0) else if (step == 8) rotation else brightness
        val result=if (step == 9) device.unitLcdInvert(false,scratch,polls) else device.unitLcdControl(command,value,scratch,polls)
        if (result != 1) { status=step;detail=result }
        step=step+1
    }
    return lcdOwnerPack(device|0,status,if (status == 1) 0 else status,firmware,rotation,swap,detail)
}
// Sleep then drain pending commands before releasing the device. A failed
// observation/write/release retains the same handle and original open error.
trusted fun UnitLcdOwner.closeOwned(scratch: NativeBuffer,exclusive: bool,polls: int = 16): UnitLcdOwner {
    if (!exclusive || polls < 1 || polls > 255 || !unitLcdBufferSafe(scratch,2)) return this
    val device=this.device()
    if ((device|0) == 0) return lcdOwnerPack(0,0,this.openFailure(),this.firmware(),this.rotation(),this.byteSwap(),0)
    var result=device.unitLcdControl(57,1,scratch,polls)
    if (result == 1) result=device.unitLcdWaitCapacity(scratch,polls,255)
    val status=if (result != 1) 6 else if (!device.close()) 11 else 0
    return lcdOwnerPack(if (status == 0) 0 else device|0,status,this.openFailure(),this.firmware(),this.rotation(),this.byteSwap(),if (result == 1) 0 else result)
}
trusted fun UnitLcdOwner.fill16Owned(x: int,y: int,w: int,h: int,color: int,scratch: NativeBuffer,exclusive: bool,polls: int = 16): int =
    if (!exclusive || !this.ready() || !unitLcdBufferSafe(scratch,7)) 2 else this.device().unitLcdFill16(x,y,w,h,this.rotation(),color,scratch,polls)
