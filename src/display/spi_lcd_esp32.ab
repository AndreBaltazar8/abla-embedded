import "./color.ab"
import "./spi_lcd_profile_esp32.ab"
import "./spi_lcd_command_sequence_esp32.ab"
import "./spi_lcd_control_sequence_esp32.ab"
import "./spi_lcd_fill_sequence_esp32.ab"
import "./spi_lcd_blit_sequence_esp32.ab"
import "./rgb565_source.ab"
import "./lcd_logic.ab"
import "../esp32/gpio.ab"
import "../esp32/spi_idf6.ab"
import "../esp32/task.ab"
import "../esp32/sdk/raw_buffer.ab"


trusted fun SpiBus.lcd(
    chipSelectPin: int,
    dataCommandPin: int,
    resetPin: int = -1,
    backlightPin: int = -1,
    frequency: int = 40000000,
    backlightActiveLow: bool = false
): SpiLcd {
    if (!spiLcdPinProfileValid(dataCommandPin,resetPin,backlightPin) ||
        (chipSelectPin != -1 && (!pin(chipSelectPin).outputCapable() ||
            chipSelectPin == dataCommandPin || chipSelectPin == resetPin || chipSelectPin == backlightPin))) return SpiLcd(0)
    val device = this.device(chipSelectPin, frequency, 0, true)
    val result = spiLcd(
        device, dataCommandPin, resetPin, backlightPin,
        backlightActiveLow
    )
    if (!result.valid()) {
        if (device.valid()) device.close()
        return spiLcd(SpiDevice(0), -1)
    }
    result.dataCommandPin().write(true)
    result.dataCommandPin().output()
    if (result.resetPin().number() >= 0) {
        result.resetPin().write(true)
        result.resetPin().output()
    }
    if (result.backlightPin().number() >= 0) {
        result.setBacklight(false)
        result.backlightPin().output()
    }
    result
}

trusted fun SpiLcd.close(): bool = this.valid() && this.device().close()

trusted fun SpiLcd.setBacklight(enabled: bool): void {
    val output = this.backlightPin()
    if (output.number() >= 0) {
        output.write(if (this.backlightActiveLow()) !enabled else enabled)
    }
    return
}

trusted fun SpiLcd.reset(): void {
    val output = this.resetPin()
    if (output.number() >= 0) {
        output.write(false)
        taskDelay(8)
        output.write(true)
        taskDelay(64)
    }
    return
}


trusted fun SpiLcd.setWindowSelected(
    view: LcdView,
    x: int,
    y: int,
    width: int,
    height: int
): bool {
    val columnStart = x + view.columnStart()
    val rowStart = y + view.rowStart()
    val columnEnd = columnStart + width - 1
    val rowEnd = rowStart + height - 1
    val address = nativeBufferAt(nativeStackAllocate(4), 4)
    address.store(0, columnStart >>> 8)
    address.store(1, columnStart)
    address.store(2, columnEnd >>> 8)
    address.store(3, columnEnd)
    if (!this.writeCommandSelected(42, address, 4)) return false
    address.store(0, rowStart >>> 8)
    address.store(1, rowStart)
    address.store(2, rowEnd >>> 8)
    address.store(3, rowEnd)
    this.writeCommandSelected(43, address, 4)
}
