// Caller owns clocked/configured host+bridge and serializes video lifecycle.
// Panel commands, DPI clock/timings/RGB and bridge DMA flow must be configured.
// All failures retain ownership; no silent event clear or forced success.
// Status1issued/readback,2invalid,3wrongstate,4pendingfault,5partialwritefailure,
// 6DMA not armed. These are register-level results, NOT physical frame proof.
trusted fun p4DsiVideoBridgeField(offset: int,mask: u32,value: u32): bool {
    p4DsiBridgeWrite(offset,(p4DsiBridgeRead(offset)&(u32(4294967295)^mask))|value)
    (p4DsiBridgeRead(offset)&mask) == value
}
// Enable the FIFO/bridge before publishing the first framebuffer to DMA.
trusted fun esp32P4DsiVideoBridgePrepareOwned(): int {
    if ((p4DsiRead(52)&u32(1)) == u32(0) || (p4DsiBridgeRead(64)&u32(1)) != u32(0) ||
        (p4DsiBridgeRead(4)&u32(1)) != u32(0)) return 3
    if ((p4DsiBridgeRead(88)&u32(1)) != u32(0)) return 4
    if (!p4DsiVideoBridgeField(4,u32(1),u32(1))) return 5
    p4DsiBridgeWrite(68,u32(1)) // configuration latch: WT, never readback
    return 1
}
// After frame publication, enable host video then DPI output, as in IDF.
// Event routing is independent: caller installs/enables bridge IRQ or polls raw.
trusted fun esp32P4DsiVideoStartOwned(dmaChannel: int): int {
    if (dmaChannel < 0 || dmaChannel > 3) return 2
    if ((p4DsiBridgeRead(4)&u32(1)) == u32(0) || (p4DsiBridgeRead(64)&u32(1)) != u32(0) ||
        (p4DsiRead(52)&u32(1)) == u32(0)) return 3
    val events=p4DwDmaRead(392+dmaChannel*256)
    // Completion and source/destination transaction notifications are benign.
    // All other events, including aborted/disabled/suspended, require handling.
    if ((events&u32(4294967268)) != u32(0) || (p4DsiBridgeRead(88)&u32(1)) != u32(0)) return 4
    val bit=u32(1)<<u32(dmaChannel)
    if ((p4DwDmaRead(28)&bit) != u32(0) ||
        ((p4DwDmaRead(24)&bit) == u32(0) && (events&u32(2)) == u32(0))) return 6
    p4DsiWrite(52,p4DsiRead(52)&u32(4294967294))
    if ((p4DsiRead(52)&u32(1)) != u32(0)) return 5
    if (!p4DsiVideoBridgeField(64,u32(1),u32(1))) return 5
    p4DsiBridgeWrite(68,u32(1))
    return 1
}
// Request output disable and latch it. This does NOT prove a frame boundary or
// FIFO drain; stop DMA and complete board-level shutdown before freeing memory.
trusted fun esp32P4DsiVideoDisableOutputOwned(): int {
    if ((p4DsiBridgeRead(4)&u32(1)) == u32(0)) return 3
    if (!p4DsiVideoBridgeField(64,u32(1),u32(0))) return 5
    p4DsiBridgeWrite(68,u32(1))
    return 1
}
// Raw status is observable without routing an interrupt to the CPU.
// hwVersion1 has underrun only; hwVersion3 also has real VSYNC.
trusted fun esp32P4DsiVideoEventsOwned(hwVersion: int): int {
    if (hwVersion != 1 && hwVersion != 3) return -1
    return int(p4DsiBridgeRead(88)&(if (hwVersion == 3) u32(3) else u32(1)))
}
trusted fun esp32P4DsiVideoAcknowledgeOwned(hwVersion: int,events: int): int {
    if ((hwVersion != 1 && hwVersion != 3) || events < 1 || events > (if (hwVersion == 3) 3 else 1)) return 2
    p4DsiBridgeWrite(84,u32(events))
    return 1
}
