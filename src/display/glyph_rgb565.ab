import "./classic_font.ab"
import "./rgb565_source.ab"
// Draw one6x8 classic-font cell into caller-owned RGB565 RAM, clipped to
// width/height with explicit byte stride and byte order. Scale1..8, optional
// transparent background; no display I/O or allocation. Invalid inputs never
// modify pixels. This is a raster primitive, not a Unicode/layout engine.
trusted fun drawClassicGlyphRgb565(buffer: NativeBuffer,width: int,height: int,stride: int,x: int,y: int,character: int,foreground: int,background: int,scale: int = 1,transparent: bool = false,littleEndian: bool = false): bool {
    if (!lcdRgb565SourceValid(buffer,width,height,stride) || character < 0 || character > 255 || scale < 1 || scale > 8 ||
        x < -65535 || x > 65535 || y < -65535 || y > 65535 || foreground < 0 || foreground > 65535 || background < 0 || background > 65535) return false
    var row=0
    while (row < 8*scale) {
        val destY=y+row
        if (destY >= 0 && destY < height) {
            var column=0
            while (column < 6*scale) {
                val destX=x+column
                if (destX >= 0 && destX < width) {
                    // u32 quotient/shift avoids external 64-bit helpers.
                    val bits=classicFontColumn(character,int(u32(column)/u32(scale)))
                    val ink=(u32(bits)&(u32(1)<<u32(u32(row)/u32(scale)))) != u32(0)
                    if (ink || !transparent) {
                        val color=if (ink) foreground else background
                        val offset=destY*stride+destX*2
                        buffer.store(offset,if (littleEndian) color&255 else color>>8)
                        buffer.store(offset+1,if (littleEndian) color>>8 else color&255)
                    }
                }
                column=column+1
            }
        }
        row=row+1
    }
    return true
}
