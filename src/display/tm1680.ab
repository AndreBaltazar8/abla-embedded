import "../esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// 16x16 monochrome page framebuffer: byte=(y/8)*16+x, bit=y%8.
// TM1680 sends address0 then32 row-major bytes, each with swapped nibbles.
// Transport mapping follows M5GFX Panel_TM1680; no command/data prefix.
fun tm1680BuffersValid(frame: NativeBuffer,scratch: NativeBuffer): bool =
    frame.hasAddressRange(0,32) && scratch.hasAddressRange(0,33) &&
    (frame.addressValue()+32 <= scratch.addressValue() || scratch.addressValue()+33 <= frame.addressValue())
trusted fun tm1680SetPixel(frame: NativeBuffer,x: int,y: int,on: bool,rotation: int = 0): bool {
    if (!frame.hasAddressRange(0,32) || x < 0 || x >= 16 || y < 0 || y >= 16 || rotation < 0 || rotation > 3) return false
    val px=if (rotation == 0) x else if (rotation == 1) 15-y else if (rotation == 2) 15-x else y
    val py=if (rotation == 0) y else if (rotation == 1) x else if (rotation == 2) 15-y else 15-x
    val index=(py>>>3)*16+px
    val bit=int(u32(1)<<u32(py&7))
    frame.store(index,if (on) frame.load(index)|bit else frame.load(index)&(255^bit))
}
trusted fun tm1680PackFrame(frame: NativeBuffer,scratch: NativeBuffer,invert: bool = false): bool {
    if (!tm1680BuffersValid(frame,scratch)) return false
    scratch.store(0,0)
    var y=0
    while (y < 16) {
        var half=0
        while (half < 2) {
            var value=u32(0);var bit=0
            while (bit < 8) {
                if ((u32(frame.load((y>>>3)*16+half*8+bit))&(u32(1)<<u32(y&7))) != u32(0))
                    value=value|(u32(1)<<u32(if (bit < 4) bit+4 else bit-4))
                bit=bit+1
            }
            scratch.store(1+y*2+half,int(value)^(if (invert) 255 else 0));half=half+1
        }
        y=y+1
    }
    return true
}
