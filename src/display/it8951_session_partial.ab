import "./it8951_session.ab"
// Physical preclipped partial updates. First initialize the whole controller
// image with loadFullOwned: tiny refreshes can include adjacent stored pixels.
// Keep that complete-image guarantee across successful partial writes only.
// No queue or overlapping refresh; the ready session must own the idle image.
trusted fun It8951Session.loadRectOwned(x: int,y: int,w: int,h: int,pixels: NativeBuffer,
    stride: int,scratch: NativeBuffer,polls: int,attempts: int,exclusive: bool): It8951ImageResult {
    if (!exclusive || this.state() != 1 || this.buffer().loadU32(32) != 1 ||
        !it8951RectangleValid(this.info(),x,y,w,h) || stride < (w+1)/2 || stride > 2147483647 ||
        !this.disjoint(scratch,14) || !this.disjoint(pixels,(h-1)*stride+(w+1)/2)) return It8951ImageResult(2)
    val result=it8951Load4(this.context(),this.info(),pixels,stride,x,y,w,h,scratch,polls,attempts)
    if (result.status() != 2) {
        this.remember(result|0)
        if (!result.success()) { this.buffer().storeU32(32,0);this.buffer().storeU32(4,2) }
    }
    result
}
trusted fun It8951Session.refreshRectOwned(x: int,y: int,w: int,h: int,mode: int,
    scratch: NativeBuffer,polls: int,attempts: int,exclusive: bool): It8951ImageResult {
    if (!exclusive || this.state() != 1 || this.buffer().loadU32(32) != 1 || !this.disjoint(scratch,14)) return It8951ImageResult(2)
    val result=it8951Refresh(this.context(),this.info(),x,y,w,h,mode,scratch,polls,attempts)
    if (result.status() != 2) {
        this.remember(result|0)
        this.buffer().storeU32(4,if (result.success()) 3 else 2)
    }
    result
}
