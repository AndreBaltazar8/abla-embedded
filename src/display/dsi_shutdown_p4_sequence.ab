// Caller has stopped/joined every rearm task/ISR and owns the entire video
// lifecycle and channel. Host/bridge APB and DMA controller remain clocked.
// Keep DPI consuming while ordinary DMA disable drains any in-flight work;
// only after observed DMA inactivity disable DPI, bridge and its pixel clock.
// No group reset/abort, event clear, memory free or shared source-clock release.
// Low8:1quiesced,2invalid,3DMAstop,4DPIwrite,5bridgewrite,6hostwrite,7clock.
// Sub-result bits8..14. Bit15 records confirmed DMA inactivity; the caller
// retains ownership on failures and may retry while APB/controllers stay live.
trusted fun esp32P4DsiVideoShutdownOwned(channel: int,polls: int): int {
    if (channel < 0 || channel > 3 || polls < 1 || polls > 1000000) return 2
    val stopped=p4DsiShutdownDma(channel,polls)
    if (stopped != 1) return 3|(stopped<<8)
    // These are requested register states; a clean frame boundary is not
    // promised. DMA no longer accesses framebuffer/descriptor memory.
    if ((p4DsiBridgeRead(64)&u32(1)) != u32(0)) {
        p4DsiBridgeWrite(64,p4DsiBridgeRead(64)&u32(4294967294))
        if ((p4DsiBridgeRead(64)&u32(1)) != u32(0)) return 32772
        p4DsiBridgeWrite(68,u32(1))
    }
    if ((p4DsiBridgeRead(4)&u32(1)) != u32(0)) {
        p4DsiBridgeWrite(4,p4DsiBridgeRead(4)&u32(4294967294))
        if ((p4DsiBridgeRead(4)&u32(1)) != u32(0)) return 32773
    }
    if ((p4DsiRead(52)&u32(1)) == u32(0)) {
        p4DsiWrite(52,p4DsiRead(52)|u32(1))
        if ((p4DsiRead(52)&u32(1)) == u32(0)) return 32774
    }
    val clock=p4DsiShutdownPixelClock()
    if (clock != 1) return 32775|(clock<<8)
    return 32769
}
