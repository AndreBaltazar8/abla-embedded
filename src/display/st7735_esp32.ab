import "./mipi_rgb565_esp32.ab"
import "./mipi_commands.ab"

trusted fun SpiLcd.beginSt7735S(
    geometry: LcdGeometry,
    rotation: int = 0,
    inverted: bool = false,
    bgrOrder: bool = true
): LcdView = this.beginMipiRgb565(
    geometry, rotation, st7735SInitCommands, "", inverted, bgrOrder
)
