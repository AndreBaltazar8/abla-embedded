import "./color.ab"
import "./lcd_logic.ab"
import "../spi/software_command.ab"

// Internal: validated pins with bus ownership held; mode0, MSB-first.
trusted fun softwareLcdCommandWordOwned(clock: Pin, mosi: Pin, chipSelect: Pin, dataCommand: Pin,
    command: u32, data: u32, bits: int, halfPeriodMicroseconds: int,
    sharedDataCommand: bool = false): void {
    dataCommand.write(false)
    if (sharedDataCommand) dataCommand.output()
    chipSelect.write(false)
    val ignoredCommand = softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), command, 8, 0, halfPeriodMicroseconds)
    dataCommand.write(true)
    val ignoredData = softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), data, bits, 0, halfPeriodMicroseconds)
    chipSelect.write(true)
    if (sharedDataCommand) dataCommand.input()
    return
}

// Common MIPI RGB565 panel primitive. Panel must already be configured for
// 16-bit pixels and this view's orientation. Pins configured/CSinactive and
// canonical bus gate required. Entire window+pixel sequence is noninterleaved.
// Pixels are generated directly: no framebuffer, scratch pixel buffer or heap.
// Shared D/C starts as input and is returned to input after each CS window.
trusted fun softwareLcdFillRect(gate: PeripheralGate, owner: u32, clock: Pin, mosi: Pin,
    chipSelect: Pin, dataCommand: Pin, view: LcdView, x: int, y: int, width: int, height: int,
    color: Rgb565, halfPeriodMicroseconds: int = 1, sharedDataCommand: bool = false): SpiTransactionResult {
    if (!softwareSpiCommandPinsValid(clock, mosi, chipSelect, dataCommand, 0, halfPeriodMicroseconds) ||
        !view.valid()) return SpiTransactionResult(3 << 32)
    val rectangle = clipDisplayRect(x, y, width, height, view.width(), view.height())
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    if (!rectangle.empty()) {
        val column = view.columnStart() + rectangle.x()
        val row = view.rowStart() + rectangle.y()
        clock.write(false)
        softwareLcdCommandWordOwned(clock, mosi, chipSelect, dataCommand, u32(42),
            (u32(column) << u32(16)) | u32(column + rectangle.width() - 1), 32, halfPeriodMicroseconds, sharedDataCommand)
        softwareLcdCommandWordOwned(clock, mosi, chipSelect, dataCommand, u32(43),
            (u32(row) << u32(16)) | u32(row + rectangle.height() - 1), 32, halfPeriodMicroseconds, sharedDataCommand)
        dataCommand.write(false)
        if (sharedDataCommand) dataCommand.output()
        chipSelect.write(false)
        val ignored = softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(44), 8, 0, halfPeriodMicroseconds)
        dataCommand.write(true)
        var remaining = rectangle.width() * rectangle.height()
        while (remaining > 0) {
            val sample = softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(color.value()), 16, 0, halfPeriodMicroseconds)
            remaining = remaining - 1
        }
        chipSelect.write(true)
        if (sharedDataCommand) dataCommand.input()
    }
    if (!gate.finish(owner, true)) return SpiTransactionResult(5 << 32)
    SpiTransactionResult(1 << 32)
}
