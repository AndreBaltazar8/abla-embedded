import "./gc9a01_session.ab"
// Sleep commands match upstream Panel_LCD. GC9A01A datasheet sections6.2.3/4
// require120ms between opposite sleep commands (and5ms before other commands).
// https://cdn-learn.adafruit.com/assets/assets/000/135/078/original/GC9A01A.pdf
// Conservatively hold the canonical gate for120ms after either transition.
// State4asleep5transition; no drawing/rotation/read until wake completes.
// Rails, reset and backlight remain caller-owned; sleep is not power removal.
trusted fun Gc9a01Session.setSleepOwned(sleep: bool,exclusive: bool): SpiTransactionResult {
    if (!exclusive || (this.state() != 1 && this.state() != 4)) return SpiTransactionResult(3<<32)
    val admitted=this.gate().tryBegin(this.owner())
    if (admitted != 0) return SpiTransactionResult((if (admitted == 1) 2 else if (admitted == 2) 4 else 3)<<32)
    val target=if (sleep) 4 else 1
    var result=SpiTransactionResult(1<<32)
    if (this.state() != target) {
        this.buffer().storeU32(4,5)
        val sent=softwareLcdCommandCheckedOwned(this.pin(16),this.pin(20),this.pin(24),this.pin(28),
            if (sleep) 16 else 17,NativeBuffer(0),0,this.buffer().loadU32(40),false)
        // Confirm inactive CS before the settling delay and state publication.
        val released=this.pin(24).writeLevelOwned(true)
        result=if (!sent.valid()) sent else SpiTransactionResult((if (released) 1 else 6)<<32)
        if (result.valid()) peripheralDelayMilliseconds(120)
    }
    if (!this.gate().finish(this.owner(),result.valid())) result=SpiTransactionResult(5<<32)
    this.buffer().storeU32(4,if (result.valid()) target else 2)
    return this.remember(result,false)
}
// Internal controller-mode publication; never sends a sleep/reset/RAM command.
// Keep output/idle flags in reserved word56; rotation/BGR/inversion in36.
trusted fun Gc9a01Session.modeCommandOwned(command: int,exclusive: bool): SpiTransactionResult {
    if (!exclusive || this.state() != 1 || (command != 32 && command != 33 && command != 40 && command != 41 && command != 56 && command != 57))
        return SpiTransactionResult(3<<32)
    val result=softwareSpiCommand(this.gate(),this.owner(),this.pin(16),this.pin(20),this.pin(24),this.pin(28),
        command,NativeBuffer(0),0,0,this.buffer().loadU32(40))
    if (result.valid()) {
        val r=this.buffer()
        if (command == 32 || command == 33) r.storeU32(36,(r.loadU32(36)&~16)|(if (command == 33) 16 else 0))
        else if (command == 40 || command == 41) r.storeU32(56,(r.loadU32(56)&~2)|(if (command == 40) 2 else 0))
        else r.storeU32(56,(r.loadU32(56)&~1)|(if (command == 57) 1 else 0))
    }
    return this.remember(result,false)
}
trusted fun Gc9a01Session.setPowerSaveOwned(enabled: bool,exclusive: bool): SpiTransactionResult = this.modeCommandOwned(if (enabled) 57 else 56,exclusive)
trusted fun Gc9a01Session.setDisplayEnabledOwned(enabled: bool,exclusive: bool): SpiTransactionResult = this.modeCommandOwned(if (enabled) 41 else 40,exclusive)
trusted fun Gc9a01Session.setInvertedOwned(enabled: bool,exclusive: bool): SpiTransactionResult = this.modeCommandOwned(if (enabled) 33 else 32,exclusive)
