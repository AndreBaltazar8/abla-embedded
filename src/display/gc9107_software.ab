import "./software_mipi_checked.ab"
import "./software_blit_checked.ab"
import "./gc9107_program.ab"
// GC9107 address memory128x160. Visible crop/offset is panel-specific;
// validate exact memory dimensions so rotations cannot silently mis-map it.
fun gc9107GeometryValid(geometry: LcdGeometry): bool = geometry.valid() && geometry.memoryWidth() == 128 && geometry.memoryHeight() == 160
trusted fun gc9107BeginChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,cs: Pin,dc: Pin,
    geometry: LcdGeometry,rotation: int,inverted: bool = false,bgrOrder: bool = true,halfPeriod: int = 1): SpiTransactionResult {
    if (!gc9107GeometryValid(geometry)) return SpiTransactionResult(3<<32)
    return softwareLcdBeginRgb565Checked(gate,owner,clock,mosi,cs,dc,geometry,rotation,gc9107InitProgram(),NativeBuffer(0),inverted,bgrOrder,halfPeriod)
}
// Caller owns powered/reset/configured panel and matching initialized rotation.
// Odd rotations share GC9xxx RASET-reset workaround. No pixel readback implied.
trusted fun gc9107FillRectChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,cs: Pin,dc: Pin,
    geometry: LcdGeometry,rotation: int,x: int,y: int,width: int,height: int,color: Rgb565,halfPeriod: int = 1): SpiTransactionResult {
    if (!gc9107GeometryValid(geometry) || rotation < 0 || rotation > 7) return SpiTransactionResult(3<<32)
    return softwareLcdFillRectChecked(gate,owner,clock,mosi,cs,dc,geometry.view(rotation),x,y,width,height,color,halfPeriod,false,(rotation&1) != 0)
}
trusted fun gc9107BlitChecked(gate: PeripheralGate,owner: u32,clock: Pin,mosi: Pin,cs: Pin,dc: Pin,
    geometry: LcdGeometry,rotation: int,x: int,y: int,source: NativeBuffer,width: int,height: int,stride: int,
    littleEndian: bool = false,halfPeriod: int = 1): SpiTransactionResult {
    if (!gc9107GeometryValid(geometry) || rotation < 0 || rotation > 7) return SpiTransactionResult(3<<32)
    return softwareLcdBlitRgb565Checked(gate,owner,clock,mosi,cs,dc,geometry.view(rotation),x,y,source,width,height,stride,littleEndian,halfPeriod,false,(rotation&1) != 0)
}
