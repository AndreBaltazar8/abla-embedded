import "./epd_gate_sequence.ab"
import "../esp32/gpio_esp32s3.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
trusted fun epdGateOutputPrepared(number: int): bool {
    if (!espChipS3().gpioOutputValid(number)) return false
    val bank=esp32S3GpioBankOffset(number)
    return (esp32S3PinStateRead(0x60004020+bank)&(1<<(number&31))) != 0 &&
        (esp32S3PinStateRead(0x60004554+number*4)&4095) == 1280 &&
        (esp32S3PinStateRead(0x60004074+number*4)&4) == 0 &&
        (esp32S3PinStateRead(esp32S3GpioMuxAddress(number))&0x7000) == 0x1000
}
trusted fun epdGateWrite(number: int,high: bool): bool = esp32S3GpioWriteLevelOwned(number,high)
trusted fun epdGateDelayUs(us: int): void { peripheralDelayMicroseconds(us);return }
