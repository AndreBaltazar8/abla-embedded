import "./dsi_timing_logic.ab"
import "../esp32/dsi_short_p4_sequence.ab"
trusted fun dsiHostTimingWrite(offset: int,mask: u32,value: u32): bool {
    p4DsiWrite(offset,(p4DsiRead(offset)&(u32(4294967295)^mask))|value)
    (p4DsiRead(offset)&mask) == value
}
trusted fun dsiBridgeTimingWrite(offset: int,value: u32): bool {
    val mask=u32(268374015)
    p4DsiBridgeWrite(offset,(p4DsiBridgeRead(offset)&(u32(4294967295)^mask))|value)
    (p4DsiBridgeRead(offset)&mask) == value
}
// Caller owns clocked host/bridge in command mode, video and DMA stopped.
// Validate both axes before I/O; preserve unrelated/reserved register fields.
// Status6 here means timing-register readback mismatch: partial configuration
// remains and MUST NOT be used to start video. No rollback or hidden reset.
trusted fun esp32P4DsiSetTimingsOwned(hsync: int,hback: int,width: int,hfront: int,vsync: int,vback: int,height: int,vfront: int,laneKbps: int,expectedDpiKhz: int,actualDpiKhz: int,polls: int): DsiCommandResult {
    val horizontal=dsiHorizontalTiming(hsync,hback,width,hfront,laneKbps,expectedDpiKhz,actualDpiKhz)
    if (!horizontal.valid() || vsync < 1 || vsync > 1023 || vback < 0 || vback > 1023 ||
        height < 1 || height > 4095 || vfront < 1 || vfront > 1023 ||
        vsync+vback+height+vfront > 4095 || polls < 1 || polls > 1000000) return DsiCommandResult(2)
    if ((p4DsiRead(52)&u32(1)) == u32(0) || (p4DsiBridgeRead(4)&u32(1)) != u32(0)) return DsiCommandResult(10)
    if (!esp32P4DsiWaitIdleOwned(polls)) return DsiCommandResult(3)
    if ((p4DsiRead(116)&u32(16)) == u32(0)) return DsiCommandResult(9)
    val errors=esp32P4DsiErrorSnapshotOwned()
    if (errors != 0) return DsiCommandResult(errors|4)
    if (!dsiHostTimingWrite(72,u32(4095),u32(horizontal.hostSync())) ||
        !dsiHostTimingWrite(76,u32(4095),u32(horizontal.hostBack())) ||
        !dsiHostTimingWrite(80,u32(32767),u32(horizontal.hostTotal())) ||
        !dsiHostTimingWrite(84,u32(1023),u32(vsync)) ||
        !dsiHostTimingWrite(88,u32(1023),u32(vback)) ||
        !dsiHostTimingWrite(92,u32(1023),u32(vfront)) ||
        !dsiHostTimingWrite(96,u32(16383),u32(height)) ||
        !dsiBridgeTimingWrite(56,(u32(width)<<u32(16))|u32(horizontal.bridgeTotal())) ||
        !dsiBridgeTimingWrite(60,(u32(hsync)<<u32(16))|u32(hback)) ||
        !dsiBridgeTimingWrite(48,(u32(height)<<u32(16))|u32(vsync+vback+height+vfront)) ||
        !dsiBridgeTimingWrite(52,(u32(vsync)<<u32(16))|u32(vback))) return DsiCommandResult(6)
    DsiCommandResult(1)
}
