import "../spi/pins.ab"
import "./lcd_logic.ab"
import "./color.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"

// Six byte lanes plus validity/shared-D/C bits: no heap wrapper, retained
// gate, framebuffer or hidden initialization. Import one matching backend.
type SpiLcd = int

@inline
trusted fun SpiLcd.setSleep(gate: PeripheralGate, owner: u32, sleeping: bool,
    settleMilliseconds: int): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    spiLcdSetSleep(gate,owner,this.peripheral(),this.pins(),this.chipSelectPin(),
        this.dataCommandPin(),sleeping,settleMilliseconds,this.sharedDataCommand())
}
@inline
trusted fun SpiLcd.setIdle(gate: PeripheralGate, owner: u32, idle: bool): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    spiLcdSetIdle(gate,owner,this.peripheral(),this.pins(),this.chipSelectPin(),
        this.dataCommandPin(),idle,this.sharedDataCommand())
}

// Caller updates its matching draw/touch view only after successful rotation.
@inline
trusted fun SpiLcd.setRotation(gate: PeripheralGate, owner: u32,
    geometry: LcdGeometry, rotation: int, bgrOrder: bool = true): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    spiLcdSetRotation(gate,owner,this.peripheral(),this.pins(),this.chipSelectPin(),
        this.dataCommandPin(),geometry,rotation,bgrOrder,this.sharedDataCommand())
}
@inline
trusted fun SpiLcd.setInverted(gate: PeripheralGate, owner: u32, inverted: bool): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    spiLcdSetInverted(gate,owner,this.peripheral(),this.pins(),this.chipSelectPin(),
        this.dataCommandPin(),inverted,this.sharedDataCommand())
}

@inline
trusted fun SpiLcd.fillRect(gate: PeripheralGate, owner: u32, view: LcdView,
    x: int, y: int, width: int, height: int, color: Rgb565): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    spiLcdFillRect(gate,owner,this.peripheral(),this.pins(),this.chipSelectPin(),
        this.dataCommandPin(),view,x,y,width,height,color,this.sharedDataCommand())
}
@inline
fun spiLcd(peripheral: int, pins: SpiPins, select: Pin, dataCommand: Pin,
    sharedDataCommand: bool = false): SpiLcd {
    if ((pins >>> 24) != 0 || peripheral < 0 || peripheral > 255 ||
        select.number() < 0 || select.number() > 255 || dataCommand.number() < 0 || dataCommand.number() > 255 ||
        !spiLcdPinsValid(peripheral, pins, select, dataCommand, sharedDataCommand)) return SpiLcd(0)
    SpiLcd(pins | (select.number() << 24) | (dataCommand.number() << 32) |
        (peripheral << 40) | (1 << 48) | (if (sharedDataCommand) 1 << 49 else 0))
}
@inline
fun SpiLcd.pins(): SpiPins = SpiPins(this & 16777215)
@inline
fun SpiLcd.chipSelectPin(): Pin = Pin((this >>> 24) & 255)
@inline
fun SpiLcd.dataCommandPin(): Pin = Pin((this >>> 32) & 255)
@inline
fun SpiLcd.peripheral(): int = (this >>> 40) & 255
@inline
fun SpiLcd.sharedDataCommand(): bool = (this & (1 << 49)) != 0
@inline
fun SpiLcd.valid(): bool = (this >>> 50) == 0 && (this & (1 << 48)) != 0 &&
    spiLcdPinsValid(this.peripheral(), this.pins(), this.chipSelectPin(), this.dataCommandPin(), this.sharedDataCommand())

@inline
trusted fun SpiLcd.beginRgb565(gate: PeripheralGate, owner: u32, geometry: LcdGeometry,
    rotation: int, program: NativeBuffer, extraProgram: NativeBuffer,
    inverted: bool = false, bgrOrder: bool = true): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    spiLcdBeginRgb565(gate, owner, this.peripheral(), this.pins(), this.chipSelectPin(),
        this.dataCommandPin(), geometry, rotation, program, extraProgram, inverted, bgrOrder, this.sharedDataCommand())
}
@inline
trusted fun SpiLcd.blitRgb565(gate: PeripheralGate, owner: u32, view: LcdView,
    x: int, y: int, source: NativeBuffer, width: int, height: int, stride: int,
    littleEndian: bool = false, staging: NativeBuffer = NativeBuffer(0)): SpiTransactionResult {
    if (!this.valid()) return SpiTransactionResult(3 << 32)
    spiLcdBlitRgb565(gate, owner, this.peripheral(), this.pins(), this.chipSelectPin(),
        this.dataCommandPin(), view, x, y, source, width, height, stride, littleEndian, staging, this.sharedDataCommand())
}
