import "./spi_lcd_esp32.ab"

// Shared initialization path for byte-command MIPI LCD controllers. Controller
// modules supply only their compact command programs; geometry and pixel I/O
// remain the same allocation-free scalar API.
trusted fun SpiLcd.beginMipiRgb565(
    geometry: LcdGeometry,
    rotation: int,
    commands: string,
    extraCommands: string = "",
    inverted: bool = false,
    bgrOrder: bool = true
): LcdView {
    if (!this.valid() || !geometry.valid()) return LcdView(0)
    this.reset()
    if (!this.runCommandProgram(commands)) return LcdView(0)
    if (extraCommands.size > 0 &&
        !this.runCommandProgram(extraCommands)) return LcdView(0)

    val one = nativeBufferAt(nativeStackAllocate(1), 1)
    one.store(0, 85)
    if (!this.writeCommand(58, one, 1)) return LcdView(0)
    val view = geometry.view(rotation, bgrOrder)
    one.store(0, view.madctl())
    if (!this.writeCommand(54, one, 1)) return LcdView(0)
    val empty = nativeBufferAt(0, 0)
    if (!this.writeCommand(if (inverted) 33 else 32, empty, 0)) {
        return LcdView(0)
    }
    this.setBacklight(true)
    view
}
