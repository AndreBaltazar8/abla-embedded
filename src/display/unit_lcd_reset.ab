import "./unit_lcd.ab"
// Reset invalidates every configured mode/window/color. Use only before
// initialization, never behind a live UnitLcdOwner. Device/bus stay borrowed.
type UnitLcdResetResult=int
fun UnitLcdResetResult.status(): int = this&255
fun UnitLcdResetResult.attempts(): int = (this>>>8)&255
fun UnitLcdResetResult.firmware(): I2cByteResult = I2cByteResult((this>>>16)&511)
//1reset+newidentity verified2admission3oldidentity4queue5resetIO6NOPIO
//7newidentity exhausted. No pre-reset identity is returned as fresh evidence.
// Explicit exclusive access, at most8 identity observations. Delay provider
// must handle300ms/32ms outside ISR/interrupt-masked contexts. A failed reset
// write may have committed: always allow300ms settling before returning.
trusted fun I2cDevice.unitLcdReset(scratch: NativeBuffer,exclusive: bool,polls: int = 16,attempts: int = 8): UnitLcdResetResult {
    if (!exclusive || !this.valid() || !scratch.hasAddressRange(0,5) || polls < 1 || polls > 255 || attempts < 1 || attempts > 8) return UnitLcdResetResult(2)
    if (!this.unitLcdIdentify(scratch).valid()) return UnitLcdResetResult(3)
    if (this.unitLcdWaitCapacity(scratch,polls,255) != 1) return UnitLcdResetResult(4)
    scratch.store(0,255);scratch.store(1,119);scratch.store(2,137);scratch.store(3,255)
    val resetWritten=this.write(scratch,4)
    unitLcdDelayMicroseconds(300000)
    if (!resetWritten) return UnitLcdResetResult(5)
    var attempt=0
    while (attempt < attempts) {
        attempt=attempt+1
        scratch.store(0,0);scratch.store(1,0)
        val nopWritten=this.write(scratch,2)
        unitLcdDelayMicroseconds(32000)
        if (!nopWritten) return UnitLcdResetResult(6|(attempt<<8))
        val firmware=this.unitLcdIdentify(scratch)
        if (firmware.valid()) return UnitLcdResetResult(1|(attempt<<8)|((firmware&511)<<16))
    }
    return UnitLcdResetResult(7|(attempts<<8))
}
