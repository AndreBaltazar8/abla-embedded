import "./dsi_rgb_p4_sequence.ab"
import "../esp32/dsi_start_esp32p4.ab"
trusted fun esp32P4DsiConfigureRgb(hwVersion: int,width: int,inputBits: int,outputBits: int,channel: int,allowLp: bool,frameAck: bool,polls: int): DsiCommandResult =
    esp32P4DsiConfigureRgbOwned(hwVersion,width,inputBits,outputBits,channel,allowLp,frameAck,polls)
