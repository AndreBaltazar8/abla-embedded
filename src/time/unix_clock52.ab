import "../esp32/sdk/raw_buffer.ab"
// Caller-owned32B, serialized; no heap, lock, timezone or hidden clock source.
// Hardware must provide an advancing52-bit tick count at a stable stated rate.
// Read at least once per half counter period; re-anchor after timer reset,
// frequency change or sleep that stops the counter. Not a retained sleep clock.
type UnixClock52 = int
fun unixClock52At(storage: NativeBuffer): UnixClock52 = UnixClock52(if (storage.hasAddressRange(0,32) &&
    (storage.addressValue()&3) == 0) storage | 0 else 0)
fun UnixClock52.buffer(): NativeBuffer = NativeBuffer(this | 0)
trusted fun UnixClock52.setAt(seconds: int,ticks: int,ticksPerSecond: int): bool {
    val buffer=this.buffer()
    if (!buffer.hasAddressRange(0,32) || (buffer.addressValue()&3) != 0 ||
        seconds < 0 || seconds > 253402300799 || ticks < 0 || ticks > 4503599627370495 ||
        ticksPerSecond < 1 || ticksPerSecond > 4294967295) return false
    buffer.storeU32(0,0)
    buffer.storeU32(4,ticksPerSecond)
    buffer.storeU32(8,seconds&0xFFFFFFFF); buffer.storeU32(12,seconds>>>32)
    buffer.storeU32(16,ticks&0xFFFFFFFF); buffer.storeU32(20,ticks>>>32)
    buffer.storeU32(24,0); buffer.storeU32(28,0)
    buffer.storeU32(0,0x554E4958)
}
// Negative means invalid/unset/reset/ambiguous elapsed interval or overflow.
// Fractional ticks are carried across reads; no cumulative truncation drift.
trusted fun UnixClock52.secondsAt(ticks: int): int {
    val buffer=this.buffer()
    if (!buffer.hasAddressRange(0,32) || (buffer.addressValue()&3) != 0 ||
        buffer.loadU32(0) != 0x554E4958 || ticks < 0 || ticks > 4503599627370495) return -1
    val rate=buffer.loadU32(4)
    val seconds=buffer.loadU32(8)|(buffer.loadU32(12)<<32)
    val before=buffer.loadU32(16)|(buffer.loadU32(20)<<32)
    val fraction=buffer.loadU32(24)
    if (rate == 0 || seconds < 0 || seconds > 253402300799 || before < 0 || before > 4503599627370495 || fraction >= rate) return -1
    val elapsed=(ticks-before)&4503599627370495
    if (elapsed >= 2251799813685248) return -1
    //52-bit restoring division, fixed shifts only: RV32 needs no libgcc ABI.
    var bits=elapsed+fraction
    var quotient=0
    var remainder=0
    var remaining=52
    while (remaining > 0) {
        remainder=(remainder<<1)|((bits>>>51)&1)
        bits=(bits<<1)&4503599627370495
        quotient=quotient<<1
        if (remainder >= rate) { remainder=remainder-rate; quotient=quotient|1 }
        remaining=remaining-1
    }
    if (quotient > 253402300799-seconds) return -1
    val result=seconds+quotient
    buffer.storeU32(8,result&0xFFFFFFFF); buffer.storeU32(12,result>>>32)
    buffer.storeU32(16,ticks&0xFFFFFFFF); buffer.storeU32(20,ticks>>>32)
    buffer.storeU32(24,remainder)
    result
}
