import "./tab5_detected_panel_sequence.ab"
import "./tab5_dsi_owner_esp32p4.ab"
import "../esp32/revision_esp32p4.ab"
// Runtime revision/layout selection, before any analog/RCC writes. Clock
// source frequencies remain caller-owned; they are not guessed from revision.
trusted fun Tab5DsiOwner.openDetectedPanelOnChipOwned(reference: NativeBuffer,probe: int,scratch: NativeBuffer,
    cfg: int,ref: int,div: int,khz: int,vc: int,polls: int,settleUs: int): int {
    val revision=esp32P4ChipRevision()
    return this.openDetectedPanelOwned(reference,probe,scratch,esp32P4RegisterLayout(revision),revision,cfg,ref,div,khz,vc,polls,settleUs)
}
