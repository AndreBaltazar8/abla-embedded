import "../touch/transform.ab"
// CST raw0..233 endpoints map to visible0..467, then the common M5GFX touch
// rotation. Integer rational scaling avoids float allocation/rounding drift.
// GRAM column offset6 is NOT a touch coordinate offset. Reject malformed
// out-of-range reports rather than clamping a false edge contact.
fun TouchPoint.forStopWatchDisplay(rotation: int): TouchPoint {
    if (!this.inside(234,234)) return TouchPoint(0)
    return this.scaled(234,234,468,468).forLcdRotation(468,468,rotation)
}
