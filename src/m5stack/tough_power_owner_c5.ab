import "./tough_power_owner_sequence.ab"
import "./tough_boot_c5.ab"
import "./expander_owner.ab"
import "./pmic_open.ab"
trusted fun toughOwnerConfigure(owner: M5Expanders,pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): M5ToughBoot =
    owner.configureToughPower(pmic,presence,now)
trusted fun toughOwnerFinishWake(value: M5ToughBoot): M5ToughBoot = value.finishC5WakeInput()
trusted fun M5ToughPowerOwner.begin(bus: I2cBus,now: int): int = this.beginOwned(bus | 0,now)
