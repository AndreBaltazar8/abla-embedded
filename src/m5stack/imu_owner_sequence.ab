import "./imu_owner_types.ab"
import "./magnetometer_probe_sequence.ab"
trusted fun M5ImuOwner.openOwned(bus: int): int {
    if (this.status() != 0 || this.primary().handle() != 0 ||
        this.magnetometers().status() != 0 || this.magnetometers().handle(1) != 0 ||
        this.magnetometers().handle(2) != 0) return -1
    val primary = m5ImuOwnerProbePrimary(bus)
    this.buffer().storeU32(8,primary & 0xFFFFFFFF)
    this.buffer().storeU32(12,primary>>>32)
    if (!primary.ready()) {
        // A malformed status1 result is not readiness. Keep any handle for
        // closeOwned; report invalid probe data, never apparent success.
        val status=if (primary.status() == 1) 6 else primary.status()
        this.buffer().storeU32(4,status)
        return status
    }
    val mag = this.magnetometers().probeOwned(bus)
    val status = if (mag == 1 || mag == 2) 1 else mag
    this.buffer().storeU32(4,status)
    status
}
// Always attempt both groups. Clear only successfully released ownership so a
// failed close is retryable; never close the caller's I2C bus.
trusted fun M5ImuOwner.closeOwned(): bool {
    if (!this.valid()) return false
    val mag = this.magnetometers().releaseAll()
    val handle = this.primary().handle()
    val primary = handle == 0 || m5ImuOwnerReleasePrimary(handle)
    if (primary) { this.buffer().storeU32(8,0); this.buffer().storeU32(12,0) }
    this.buffer().storeU32(4,if (mag && primary) 0 else 4)
    mag && primary
}
