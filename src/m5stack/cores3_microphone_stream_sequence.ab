// Start after successful coreS3PrepareAudioDma(false,...). Caller owns codec,
// I2S1, channel, pads and storage until a verified stop. No handles are freed.
// Status1 success,2 invalid,3 DMA busy,4 codec setup failed,5 stream start
// failed,6 stop/codec-reset failed. DMA status occupies16bits at8; codec
// status/cleanup flags occupy10bits at24. Never hide failed cleanup.
type CoreS3MicrophoneStreamResult = int
fun CoreS3MicrophoneStreamResult.status(): int = this & 255
fun CoreS3MicrophoneStreamResult.valid(): bool = this.status() == 1
fun CoreS3MicrophoneStreamResult.dmaStatus(): int = (this >>> 8) & 65535
fun CoreS3MicrophoneStreamResult.codecStatus(): int = (this >>> 24) & 1023

trusted fun cores3StartMicrophoneStream(microphone: Es7210, channel: int,
    descriptors: int, polls: int): CoreS3MicrophoneStreamResult {
    if (!microphone.valid() || channel < 0 || channel > 4 || polls < 1 || polls > 1000000 ||
        !esp32s3GdmaDescriptorValid(descriptors)) return CoreS3MicrophoneStreamResult(2)
    if (!esp32s3GdmaParked(channel, false)) return CoreS3MicrophoneStreamResult(3)
    val codec = cores3MicrophoneEnable(microphone)
    if (!codec.valid()) {
        val detail = codec.status() | (if (codec.cleanupAttempted()) 256 else 0) | (if (codec.cleanupFailed()) 512 else 0)
        return CoreS3MicrophoneStreamResult(4 | (detail << 24))
    }
    val started = esp32s3I2sStartStream(1, false, channel, descriptors, polls)
    if (started != 1) {
        // StartStream already stops DMA if its I2S latch/start failed.
        // Always reset the codec too; preserve that separate failure result.
        val disabled = cores3MicrophoneDisable(microphone)
        return CoreS3MicrophoneStreamResult(5 | (started << 8) | (disabled.status() << 24))
    }
    CoreS3MicrophoneStreamResult(1 | (1 << 8) | (1 << 24))
}

trusted fun cores3StopMicrophoneStream(microphone: Es7210, channel: int,
    polls: int): CoreS3MicrophoneStreamResult {
    if (!microphone.valid() || channel < 0 || channel > 4 || polls < 1 || polls > 1000000)
        return CoreS3MicrophoneStreamResult(2)
    val stopped = esp32s3I2sStopStream(1, false, channel, polls)
    val codec = cores3MicrophoneDisable(microphone)
    CoreS3MicrophoneStreamResult((if (stopped == 1 && codec.valid()) 1 else 6) |
        (stopped << 8) | (codec.status() << 24))
}
