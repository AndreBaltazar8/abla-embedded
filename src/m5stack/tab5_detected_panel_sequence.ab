import "./tab5_dsi_owner_sequence.ab"
// Connect known touch evidence to host lane selection and full panel init.
// Caller has completed board power/reset and touch readiness, owns fresh host
// state and scratch, and pins all source clocks. No guessed panel/lane profile.
// 1panel ready,2preflight,3host startup failed,4panel init failed. Full stage
// result remains in owner.lastresult; partial rail/reference/host leases survive.
// closeOwned is required after3/4; this does not start video or allocate memory.
trusted fun Tab5DsiOwner.openDetectedPanelOwned(reference: NativeBuffer,probe: int,scratch: NativeBuffer,
    layout: int,revision: int,cfg: int,ref: int,div: int,khz: int,vc: int,polls: int,settleUs: int): int {
    if (!this.valid() || this.buffer().loadU32(4) != 0 ||
        !reference.hasAddressRange(0,4) || !scratch.hasAddressRange(0,32) ||
        !tab5DsiOwnerScratchSafe(scratch)) return 2
    val s=scratch.addressValue(); val o=this.buffer().addressValue(); val r=reference.addressValue()
    if ((s < o+40 && o < s+32) || (s < r+4 && r < s+32)) return 2
    val lane=tab5DsiOwnerProbeLane(probe)
    if (lane == 0) return 2
    val host=this.openOwned(reference,layout,revision,cfg,ref,div,khz,lane,vc,polls,settleUs)
    if (host != 1) return if (host == 2) 2 else 3
    val panel=this.initializePanelOwned(probe,scratch,polls)
    return if ((panel&15) == 1) 1 else 4
}
