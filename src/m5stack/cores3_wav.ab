import "./cores3_playback.ab"

// Finite8..96k WAV playback through existing960-byte staging, not a full decoded
// copy. Same powered/stopped/exclusive hardware prerequisites as playbackBlocks.
// Accepts PCM8/16mono/stereo at source rate, subject to the0.1% clock bound.
// Result bytes count completed decoded PCM bytes, excluding final silence pad.
trusted fun cores3PlaybackWav(amplifier: Aw88298,expander: Aw9523,channel: int,
    descriptors: int,buffers: int,wav: PcmWav,staging: NativeBuffer,
    owner: u32,idlePollsPerBlock: int): CoreS3PlaybackResult {
    val frames=wav.frames()
    if (frames < 1 || frames > 982800 || wav.sampleRate() < 8000 || wav.sampleRate() > 96000) return CoreS3PlaybackResult(2)
    cores3PlaybackBlocks(amplifier,expander,channel,descriptors,buffers,
        wav.samples(),int((u32(frames)+u32(239))/u32(240)),staging,owner,idlePollsPerBlock,wav)
}
