import "../io_expander/m5ioe1_device.ab"
import "../power/m5pm1_device.ab"
// Pinned M5GFX StopWatch power/reset sequence (M5Stack, MIT).
// Requires ready PM1/IOE, OLED CS39 inactive, stopped OLED/touch/audio users,
// AUDIO_EN and PA already off, exclusive mux/rail/charger ownership and delays.
// IO1 mux,IO4 touch reset,IO5 OLED reset,IO8 rail; IO3 AUDIO_EN latch preserved.
// Reset is shared: never invoke while an independent touch client is live.
// No panel commands, touch probing, CPU sleep, automatic rollback or retries.
// Low8:1complete3admission4I/O failure; completed writes in bits8..15.
trusted fun stopWatchDisplayPowerOwned(power: M5Pm1,io: M5Ioe1,exclusiveCsInactive: bool): int {
    if (!exclusiveCsInactive || (power|0) <= 0 || (power|0) > 4294967295 ||
        (io|0) <= 0 || (io|0) > 4294967295) return 3
    if (!power.setPowerConfiguration(0x17,true)) return 4
    val device=io.device()
    if (!device.writeRegister8(0x23,0)) return 4|(1<<8)
    if (!device.updateRegister8(0x13,0x9d,0)) return 4|(2<<8)
    if (!device.updateRegister8(0x03,0x9d,0x9d)) return 4|(3<<8)
    if (!device.updateRegister8(0x05,0x99,0x99)) return 4|(4<<8)
    peripheralDelayMilliseconds(10)
    if (!device.updateRegister8(0x05,0x18,0)) return 4|(5<<8)
    peripheralDelayMilliseconds(8)
    if (!device.updateRegister8(0x05,0x18,0x18)) return 4|(6<<8)
    peripheralDelayMilliseconds(2)
    // IO10 is bit9, NOT bit10: push-pull output, amplifier disabled.
    if (!io.setHighImpedance(9,false)) return 4|(7<<8)
    if (!io.setDirection(9,true)) return 4|(8<<8)
    if (!io.digitalWrite(9,false)) return 4|(9<<8)
    return 1|(10<<8)
}
