import "../esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// PaperS3 GT911 INT -> GPIO48, active low. Borrow initialized touch handle
// and40B scratch, exclusive against other touch readers. Run BEFORE clocks,
// buses and interrupts are quiesced. No reset, pin driving or implicit setup.
// Result bit0 valid,bit1 released,bit2 any successful communication,attempts@3.
// A held finger is not a bus failure. Pending/no-ready is a successful read;
// transport/malformed/ack errors are not. Repeat rounds in a scheduled caller;
// three consecutive rounds without communication may end its wait, as upstream.
type PaperS3WakeRelease=int
fun PaperS3WakeRelease.valid(): bool = (this&1) != 0
fun PaperS3WakeRelease.released(): bool = (this&2) != 0
fun PaperS3WakeRelease.communicated(): bool = (this&4) != 0
fun PaperS3WakeRelease.attempts(): int = this>>>3
trusted fun paperS3ReleaseWakePinOwned(touch: int,scratch: NativeBuffer,exclusive: bool): PaperS3WakeRelease {
    if (!exclusive || touch <= 0 || touch > 4294967295 || !scratch.hasAddressRange(0,40)) return PaperS3WakeRelease(0)
    var attempts=0
    var communicated=false
    while (attempts < 8) {
        if (paperS3WakePinReleased()) return PaperS3WakeRelease(7|(attempts<<3))
        val count=paperS3WakeConsume(touch,scratch)
        if ((count >= 0 && count <= 5) || count == -2) communicated=true
        paperS3WakeDelayMilliseconds(5)
        attempts=attempts+1
    }
    return PaperS3WakeRelease(1|(if (paperS3WakePinReleased()) 2 else 0)|(if (communicated) 4 else 0)|(attempts<<3))
}
// Repeat immediately before entering the sleep pipeline, after any delay or
// timer configuration that could permit a new interrupt. False is observable:
// upstream light sleep may still enter and immediately wake/reject; don't lie.
trusted fun paperS3WakePinFinalReleasedOwned(): bool = paperS3WakePinReleased()
