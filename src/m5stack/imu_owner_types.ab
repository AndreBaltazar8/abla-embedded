import "./imu_probe_types.ab"
import "./magnetometer_types.ab"

// Caller-owned 36 bytes: magic, status, primary result64, magnetometers20.
// Status: 0 closed, 1 ready, 2 no primary, 3 allocation failure, 4 cleanup
// failure, 5 explicit prepared scan blocked by bus fault. Failed opens retain
// every live handle until close succeeds. Status6 rejects malformed ready data.
// Fresh storage only for initialize; serialize access and never copy ownership.
type M5ImuOwner = int
fun m5ImuOwnerAt(storage: NativeBuffer): M5ImuOwner =
    if (!storage.hasAddressRange(0,36) || (storage.addressValue() & 3) != 0) M5ImuOwner(0)
    else M5ImuOwner(storage | 0)
fun M5ImuOwner.buffer(): NativeBuffer = NativeBuffer(this | 0)
fun M5ImuOwner.magnetometers(): M5Magnetometers =
    m5MagnetometersAt(nativeBufferAt(this.buffer().addressValue()+16,20))
trusted fun M5ImuOwner.valid(): bool = this.buffer().hasAddressRange(0,36) &&
    (this.buffer().addressValue() & 3) == 0 && this.buffer().loadU32(0) == 0x494D5532 &&
    this.magnetometers().valid()
trusted fun M5ImuOwner.initialize(): bool {
    if (!this.buffer().hasAddressRange(0,36) || (this.buffer().addressValue() & 3) != 0) return false
    this.buffer().storeU32(4,0); this.buffer().storeU32(8,0); this.buffer().storeU32(12,0)
    this.magnetometers().initialize()
    this.buffer().storeU32(0,0x494D5532)
}
trusted fun M5ImuOwner.status(): int = if (this.valid()) this.buffer().loadU32(4) else -1
trusted fun M5ImuOwner.primary(): M5ImuProbeResult = if (!this.valid()) M5ImuProbeResult(0) else
    M5ImuProbeResult(this.buffer().loadU32(8) | (this.buffer().loadU32(12)<<32))
