import "./nesso_devices_sequence.ab"
import "./nesso_touch_c6_bindings.ab"
import "./nesso_imu_c6_bindings.ab"
trusted fun nessoDevicesStorageSafe(storage: NativeBuffer): bool = softwareI2cProviderBufferSafe(storage,112)
fun nessoDevicesPower(storage: NativeBuffer): NessoPower = nessoPowerAt(nativeBufferAt(storage.addressValue()+16,40))
fun nessoDevicesDisplay(storage: NativeBuffer): NessoDisplay = nessoDisplayAt(nativeBufferAt(storage.addressValue()+56,40))
trusted fun nessoDevicesTouch(storage: NativeBuffer): TouchControllerOpen = TouchControllerOpen(storage.loadU32(96)|(storage.loadU32(100)<<32))
trusted fun nessoDevicesImu(storage: NativeBuffer): M5ImuProbeResult = M5ImuProbeResult(storage.loadU32(104)|(storage.loadU32(108)<<32))
trusted fun nessoDevicesSave(storage: NativeBuffer,offset: int,value: int): void {
    storage.storeU32(offset,value&0xffffffff);storage.storeU32(offset+4,value>>>32);return
}
trusted fun nessoDevicesInitializeChildren(storage: NativeBuffer): bool =
    nessoDevicesPower(storage).initialize() && nessoDevicesDisplay(storage).initialize()
trusted fun nessoDevicesAdmission(storage: NativeBuffer,bus: int,gate: PeripheralGate,owner: u32): bool =
    nessoTouchBusCurrent(bus) && nessoDisplayGateSafe(storage,gate,owner) && gate.bufferDisjoint(storage,112)
trusted fun nessoDevicesOpenChild(storage: NativeBuffer,child: int,bus: int,gate: PeripheralGate,owner: u32): bool {
    if (child == 0) return nessoDevicesPower(storage).openOwned(bus,true) == 1
    if (child == 1) return nessoDevicesDisplay(storage).openOwned(bus,gate,owner,0,true,true) == 1
    if (child == 2) {
        val touch=nessoDevicesDisplay(storage).openTouchOwned(bus,true);nessoDevicesSave(storage,96,touch|0);return touch.ready()
    }
    val imu=nessoDevicesPower(storage).openImuOwned(bus,true);nessoDevicesSave(storage,104,imu|0);return imu.ready()
}
trusted fun nessoDevicesCloseChild(storage: NativeBuffer,child: int): bool {
    if (child == 3) {
        val previous=nessoDevicesImu(storage)
        val next=if (previous.handle() == 0) M5ImuProbeResult(0) else nessoImuCloseOwned(previous,true)
        nessoDevicesSave(storage,104,next|0);return next == 0
    }
    if (child == 2) {
        val next=nessoDevicesTouch(storage).closeOwned();nessoDevicesSave(storage,96,next|0);return next == 0
    }
    if (child == 1) return nessoDevicesDisplay(storage).closeOwned(true)
    return nessoDevicesPower(storage).closeOwned(true)
}
// Borrow only while the aggregate is ready. No independent child teardown.
trusted fun NessoDevices.power(): NessoPower = if (this.ready()) nessoDevicesPower(this.buffer()) else NessoPower(0)
trusted fun NessoDevices.display(): NessoDisplay = if (this.ready()) nessoDevicesDisplay(this.buffer()) else NessoDisplay(0)
trusted fun NessoDevices.touch(): TouchControllerOpen = if (this.ready()) nessoDevicesTouch(this.buffer()) else TouchControllerOpen(0)
trusted fun NessoDevices.imu(): M5ImuProbeResult = if (this.ready()) nessoDevicesImu(this.buffer()) else M5ImuProbeResult(0)
