import "../display/oled_i2c.ab"
// Pinned M5GFX unit geometry. MiniOLED uses SSD1315's SSD1306 protocol.
// Profiles describe physical page memory; apply desired logical rotation
// through mono_page_canvas. No claim of detection or bus/pad ownership.
val m5UnitOledProfile=oledProfile(2,64,128,32)
val m5UnitMiniOledProfile=oledProfile(1,72,40,28)
