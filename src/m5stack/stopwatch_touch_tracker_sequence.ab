import "./stopwatch_touch_poll.ab"
import "../input/touch_controller.ab"
// Assign returned session. Only fresh() authorizes a new report; failed reads
// and malformed coordinates preserve the tracker instead of releasing a touch.
// The board projection scales raw234 to display468 BEFORE rotation/gestures.
trusted fun Cst816sSession.pollStopWatchTrackerOwned(control: int,tracker: TouchTracker,
    snapshot: NativeBuffer,now: int,rotation: int,exclusive: bool): Cst816sSession {
    if (this.handle() == 0 || this.status() == 6) return this
    val base=this&~(7<<33)
    if (!exclusive || tracker <= 0 || tracker > 4294967296-touchTrackerBytes ||
        !snapshot.hasAddressRange(0,6) || rotation < 0 || rotation > 7) return Cst816sSession(base|(3<<33))
    val address=snapshot.addressValue()
    if ((address < tracker+touchTrackerBytes && tracker < address+6) ||
        !stopWatchTouchTrackerAdmission(control,this.handle(),tracker,snapshot)) return Cst816sSession(base|(3<<33))
    if (touchElapsedMilliseconds(now,tracker.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) {
        tracker.advanceWithoutReport(now)
        return Cst816sSession(base|(5<<33))
    }
    val next=this.pollStopWatchOwned(snapshot,now)
    if (!next.fresh()) {
        if (next.status() == 5) tracker.advanceWithoutReport(now)
        return next
    }
    val point=if (next.reportCount() == 1) next.stopWatchDisplayPoint(snapshot,rotation).gesturePoint() else GesturePoint(0)
    if (next.reportCount() == 1 && !point.valid()) return Cst816sSession((next&~(7<<33))|(4<<33))
    if (!tracker.startUpdate(now)) return Cst816sSession((next&~(7<<33))|(5<<33))
    if (next.reportCount() == 1) tracker.updatePoint(point)
    tracker.finishUpdate()
    return next
}
