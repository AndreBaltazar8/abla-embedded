import "./expander_owner.ab"
import "./tab_power_sequence.ab"
import "../power/ina226_device.ab"
trusted fun tabPowerWrite(handle: int,register: int,value: int): bool = I2cDevice(handle).writeRegister8(register,value)
trusted fun tabPowerExtDrive(handle: int): bool = Pi4Ioe5v6408(handle).setHighImpedance(3,false)
trusted fun tabPowerExtDirection(handle: int): bool = Pi4Ioe5v6408(handle).setDirection(3,true)
trusted fun tabPowerExtLatch(handle: int): bool = Pi4Ioe5v6408(handle).digitalWrite(3,true)
// Explicit whole-board setup, not peripheral resume: resets control latches
// for display/touch/camera, antenna, WLAN, charger, and external supplies.
trusted fun M5Expanders.configureTabPower(): M5TabPowerSetup {
    if (!this.ready()) return M5TabPowerSetup(3)
    this.board().configureTabPowerOwned(this.device(0) | 0,this.device(1) | 0)
}
// Call after successful expander setup. Keep the returned calibrated scalar;
// failure clears its calibration, and the caller still owns the device handle.
// 5mOhm shunt, 2A expected current,16 averages,1100us conversions,continuous.
trusted fun M5Expanders.configureTabCurrentMonitor(monitor: Ina226): Ina226 {
    val invalid=Ina226(monitor & 4294967295)
    if (!this.ready() || (this.board() != m5BoardTab5 && this.board() != m5BoardTab5X) || !monitor.begin()) return invalid
    monitor.configure(5000,2000,ina226Sampling16,ina226Conversion1100Microseconds,
        ina226Conversion1100Microseconds,ina226ModeShuntAndBusContinuous)
}
