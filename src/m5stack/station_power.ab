import "./station_power_sequence.ab"
import "./axp_power.ab"
trusted fun stationPowerGpio(handle: int,pinNumber: int,enabled: bool): bool = Axp192(handle).setGpio(pinNumber,enabled)
trusted fun stationPowerMain(handle: int,enabled: bool): bool = Axp192(handle).setExtenEnabled(enabled)
trusted fun stationPowerUsb(enabled: bool): bool {
    // Caller has configured Station GPIO12 as an output. MMIO latch writes
    // have no bus acknowledgement; success is issuance, not measured voltage.
    Pin(12).write(enabled)
    true
}
trusted fun M5BoardId.setStationPower(power: M5AxpPower,ports: int,enabled: bool): M5StationPowerResult {
    if (!power.valid()) return M5StationPowerResult(3)
    this.setStationPowerOwned(power.device() | 0,power.identity(),ports,enabled)
}
