import "./chaincaptain_display_startup_esp32s3.ab"
import "./chaincaptain_display_sleep_sequence.ab"
// ST7789 SLPIN/SLPOUT. Retain the gate through130ms settling, matching the
// board initialization's conservative SLPOUT interval in both directions.
// No rail cycling, reset, framebuffer clear, or SPI reinitialization on wake.
trusted fun chainDisplaySleepPanel(gate: PeripheralGate,owner: u32,sleeping: bool): SpiTransactionResult =
    chainCaptainSpiDisplay().setSleep(gate,owner,sleeping,130)
trusted fun M5Pm1Control.setChainDisplaySleepOwned(gate: PeripheralGate,owner: u32,
    sleeping: bool,brightness: int,exclusive: bool): ChainCaptainDisplaySleep =
    chainCaptainDisplaySleepOwned(this|0,gate,owner,sleeping,brightness,exclusive)
