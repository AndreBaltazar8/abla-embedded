import "./power_profile.ab"
// M5Unified Power_Class.cpp: AirQ GPIO14 = ADC2 channel3, divider2:1.
// Caller supplies settled board/divider power, owns ADC2/PWDET/pad and obeys
// session power/bus/arbiter contracts. No rail/charge/hold GPIO changes.
trusted fun M5BoardId.openBatteryAdc2S3Owned(calibration: Esp32S3AdcCalibration,exclusivePower: bool,exclusiveBus: bool,exclusiveArbiter: bool,arbiterMode: int,apbHertz: int): Esp32S3Adc2Session {
    if (this != m5BoardAirQ || !calibration.valid() || calibration.unit() != 2 || calibration.attenuation() != 3) return Esp32S3Adc2Session(2)
    return esp32S3Adc2SessionOpenOwned(3,calibration,exclusivePower,exclusiveBus,exclusiveArbiter,arbiterMode,apbHertz)
}
fun Esp32S3Adc2Session.batteryMillivoltsAdc2S3(board: M5BoardId,calibration: Esp32S3AdcCalibration): int {
    if (board != m5BoardAirQ || this.channel() != 3 || this.attenuation() != 3) return -1
    val mv=this.millivolts(calibration)
    return if (mv < 0) -1 else board.batteryMillivoltsFromAdc(mv)
}
