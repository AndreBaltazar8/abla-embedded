import "./buzzer_c6_sequence.ab"
//112B caller record: tag0,state4,deadline8,start result12,cleanup result16,
// reserved20, exclusive PWM session88@24. Child must not be independently used.
// Cooperative timer, NOT an interrupt deadline: caller must poll, including
// during other work. Pin, clocks and calibrated delay remain leased until5.
//1playing2invalid3start-failed4closing5closed6pending. A negative/failed start
// never becomes playing through polling; explicit stop releases retained work.
fun c6ToneStorage(r: NativeBuffer): bool = r.hasAddressRange(0,112) &&
    (r.addressValue()&3) == 0 && (r.addressValue()+112 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun M5BoardId.startC6ToneOwned(r: NativeBuffer,source: int,sourceHz: int,
    hz: int,timer: int,channel: int,now: int,duration: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c6ToneStorage(r) || r.loadU32(0) != 0 ||
        (this != m5BoardArduinoNessoN1 && this != m5BoardUnitC6L) ||
        now < 0 || now > 0xffffffff || duration < 1 || duration > 0x7fffffff ||
        source < 1 || source > 3 || timer < 0 || timer > 3 || channel < 0 || channel > 5 ||
        polls < 1 || polls > 1000000 || c6LedcDividerForHz(sourceHz,hz,8) < 0) return 2
    var at=0
    while (at < 112) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x4336544e);r.storeU32(4,3)
    r.storeU32(8,int(u32(now)+u32(duration)))
    val result=this.openC6BuzzerOwned(nativeBufferAt(r.addressValue()+24,88),source,sourceHz,hz,timer,channel,polls,true)
    r.storeU32(12,result)
    if (result != 1) return 3
    r.storeU32(4,1);return 1
}
// Stop can be early. Success means the PWM lease was released, not that a
// previously borrowed pad now has a particular external bias. Never replay
// an unacknowledged publication or reset the peripheral to force completion.
trusted fun c6ToneStopOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6ToneStorage(r) || r.loadU32(0) != 0x4336544e || polls < 1 || polls > 1000000) return 2
    val state=r.loadU32(4)
    if (state == 5) return 5
    if (state != 1 && state != 3 && state != 4) return 2
    r.storeU32(4,4)
    val child=nativeBufferAt(r.addressValue()+24,88)
    val result=if (child.loadU32(0) == 0) 5 else c6PwmSessionCloseOwned(child,polls,true)
    r.storeU32(16,result)
    if (result != 5) return 4
    r.storeU32(4,5);return 5
}
// Sample now at least once per 2^31ms. Duration is measured from supplied now,
// including setup time; unsigned subtraction supports millis() wraparound.
trusted fun c6TonePollOwned(r: NativeBuffer,now: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c6ToneStorage(r) || r.loadU32(0) != 0x4336544e ||
        now < 0 || now > 0xffffffff || polls < 1 || polls > 1000000) return 2
    val state=r.loadU32(4)
    if (state == 5 || state == 3) return state
    if (state == 4) return c6ToneStopOwned(r,polls,true)
    if (state != 1) return 2
    if (((u32(now)-u32(r.loadU32(8)))&u32(0x80000000)) != u32(0)) return 6
    return c6ToneStopOwned(r,polls,true)
}
