import "./power_profile.ab"
import "../esp32/adc1_session_esp32.ab"
// Classic ESP32 boards only, not S3/P4/C5 mappings. Caller must power the
// board-specific battery divider and satisfy ADC session/pad/SAR ownership.
// This does not configure charging, board power GPIOs, or enable WiFi sharing.
fun M5BoardId.batteryAdcChannelEsp32(): int =
    if (this == m5BoardTimerCam || this == m5BoardStickCPlus2) 2 else
    if (this == m5BoardStackCoreInk || this == m5BoardPaper) 7 else -1
trusted fun M5BoardId.openBatteryAdcEsp32Owned(exclusivePower: bool,polls: int): Esp32Adc1Session =
    esp32Adc1SessionOpenOwned(this.batteryAdcChannelEsp32(),12,3,exclusivePower,polls)
// Snapshot result only; no new conversion/MMIO. Reject samples from the wrong
// channel or attenuation. Missing/failed calibration stays -1, distinct from0V.
fun Esp32Adc1Session.batteryMillivoltsEsp32(board: M5BoardId,calibration: Esp32AdcCalibration,reference: int): int {
    if (board.batteryAdcChannelEsp32() < 0 || this.channel() != board.batteryAdcChannelEsp32() || this.width() != 12 || this.attenuation() != 3) return -1
    val mv=this.millivolts(calibration,reference)
    return if (mv < 0) -1 else board.batteryMillivoltsFromAdc(mv)
}
