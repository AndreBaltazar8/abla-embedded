import "../display/lcd_logic.ab"
// M5GFX offset_rotation3; mirrored flag is preserved, not modulo8 addition.
fun toughDisplayRotation(rotation: int): int =
    if (rotation < 0 || rotation > 7) -1 else ((rotation+3)&3)|(rotation&4)
fun toughDisplayView(rotation: int): LcdView =
    if (rotation < 0 || rotation > 7) LcdView(u64(0)) else lcdGeometry(320,240).view(toughDisplayRotation(rotation),true)
