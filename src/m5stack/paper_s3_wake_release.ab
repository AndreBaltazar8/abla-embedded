import "./paper_s3_wake_release_sequence.ab"
import "../touch/gt911_device.ab"
import "../esp32/i2c_esp32s3.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
import "../hal/delay.ab"
import "../hal/m5stack.ab"
import "../hal/gt911.ab"
import "../esp32/gpio/probe_esp32s3.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../touch/gt911_type.ab"
import "../esp32/sdk/nativebuffer_type.ab"
@export("paperS3WakePinReleased")
trusted fun paperS3WakePinReleasedHook(): bool = gpio_get_level(i32(48)) != i32(0)
@export("paperS3WakeConsume")
trusted fun paperS3WakeConsumeHook(handle: int,scratch: NativeBuffer): int = Gt911(handle).readFrame(scratch)
@export("paperS3WakeDelayMilliseconds")
trusted fun paperS3WakeDelayMillisecondsHook(milliseconds: int): void = peripheralDelayMilliseconds(milliseconds)
