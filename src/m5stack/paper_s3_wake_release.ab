import "./paper_s3_wake_release_sequence.ab"
import "../touch/gt911_device.ab"
import "../esp32/i2c_esp32s3.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
trusted fun paperS3WakePinReleased(): bool = gpio_get_level(i32(48)) != i32(0)
trusted fun paperS3WakeConsume(handle: int,scratch: NativeBuffer): int = Gt911(handle).readFrame(scratch)
trusted fun paperS3WakeDelayMilliseconds(milliseconds: int): void = peripheralDelayMilliseconds(milliseconds)
