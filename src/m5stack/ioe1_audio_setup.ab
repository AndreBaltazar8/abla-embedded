import "./board_id.ab"
import "../io_expander/m5ioe1_device.ab"

// M5Unified M5Unified.cpp startup sequences, M5Stack (MIT).
// Boot-only: own the initialized IOE and all audio consumers, stopped DMA,
// codec and shared rails. This configures outputs LOW; it does not start audio.
// GPIO labels are one-based: StopWatch G3/G10 -> bits2/9, Chain G5 -> bit4.
// Preserve upstream order; direction changes may expose the previous latch.
// Do not call on live shared rails. Partial writes stay applied on failure.
// Low8:1complete,2unsupportedboard,3invalidownership/handle,4I/O failure.
// Bits8..15: completed register updates. No automatic rollback or retry.
trusted fun M5BoardId.prepareIoeAudioOwned(io: M5Ioe1,exclusive: bool): int {
    if (this != m5BoardStopWatch && this != m5BoardChainCaptain) return 2
    if (!exclusive || (io|0) <= 0 || (io|0) > 4294967295) return 3
    if (this == m5BoardChainCaptain) {
        if (!io.setHighImpedance(4,false)) return 4
        if (!io.setDirection(4,true)) return 4|(1<<8)
        if (!io.digitalWrite(4,false)) return 4|(2<<8)
        return 1|(3<<8)
    }
    if (!io.setHighImpedance(2,false)) return 4
    if (!io.setHighImpedance(9,false)) return 4|(1<<8)
    if (!io.setDirection(2,true)) return 4|(2<<8)
    if (!io.setDirection(9,true)) return 4|(3<<8)
    if (!io.digitalWrite(2,false)) return 4|(4<<8)
    if (!io.digitalWrite(9,false)) return 4|(5<<8)
    return 1|(6<<8)
}
