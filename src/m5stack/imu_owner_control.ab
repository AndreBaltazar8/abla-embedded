import "./imu_owner_types.ab"
import "./imu_control.ab"
// Serialize against acquisition, FIFO jobs and lifecycle changes. These do
// not release devices or stop a background task. A sleep write failure may
// still have reached hardware; caller must resolve it before resuming capture.
// Only MPU-family drivers implement sleep/polarity in M5Unified; companion
// magnetometers, BMI270 and SH200Q have no upstream sleep implementation.
// Preserve status3 unsupported instead of claiming the entire group slept.
trusted fun M5ImuOwner.sleepOwned(exclusive: bool): M5ImuControlResult {
    if (!exclusive || this.status() != 1 || !this.primary().ready()) return M5ImuControlResult(2)
    return this.primary().sleep()
}
trusted fun M5ImuOwner.setInterruptActiveHighOwned(activeHigh: bool,exclusive: bool): M5ImuControlResult {
    if (!exclusive || this.status() != 1 || !this.primary().ready()) return M5ImuControlResult(2)
    return this.primary().setInterruptActiveHigh(activeHigh)
}
