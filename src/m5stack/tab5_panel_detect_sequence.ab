import "./tab5_touch_probe_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
// Upstream Tab5 discovery allows up to60 attempts spaced10ms while ST touch
// leaves reset. Never retry ownership/transport faults or guess unknown ST FW.
// Bus and ST probe handle remain borrowed; caller owns the full scan interval.
trusted fun M5BoardId.waitTab5TouchOwned(bus: int,stHandle: int,attempts: int = 60): M5Tab5TouchProbe {
    if (attempts < 1 || attempts > 60) return M5Tab5TouchProbe(0)
    var remaining=attempts
    var result=M5Tab5TouchProbe(0)
    while (remaining > 0) {
        result=this.probeTab5TouchOwned(bus,stHandle)
        if (result.known() || result.status() == 0 || result.status() == 6) return result
        remaining=remaining-1
        if (remaining > 0) tab5PanelDetectDelay(10)
    }
    return result
}
// ST7121 requires900Mbps; ST7123 and GT/ILI candidate1040Mbps. Select lane
// speed BEFORE configuring DSI. Unknown/failed touch detection yields no plan.
fun M5Tab5TouchProbe.tab5LaneKbps(): int =
    if (this.status() == 1 && this.firmware() == 1) 900000 else
    if ((this.status() == 2 && this.firmware() == 3) || this.status() == 3) 1040000 else 0
// Low8panel:0unselected,1ILI9881C,2ST7121,3ST7123.
// Next8status:1selected,2invalid evidence,3ILI mismatch,4DSI transport failure.
// Bits16+retain complete ILI probe result (ID+failed step), if issued.
type Tab5PanelDetection = int
fun Tab5PanelDetection.panel(): int = this&255
fun Tab5PanelDetection.status(): int = (this>>>8)&255
fun Tab5PanelDetection.iliResult(): int = this>>>16
fun Tab5PanelDetection.selected(): bool = this.status() == 1 && this.panel() >= 1 && this.panel() <= 3
// Caller owns powered/settled panel, command-mode DSI already configured at
// probe.tab5LaneKbps(), and16 scratch bytes. ST selection uses touch FW only:
// do not send ILI page commands to ST, whose variants need different lane rates.
trusted fun M5Tab5TouchProbe.identifyTab5PanelOwned(channel: int,scratch: NativeBuffer,polls: int): Tab5PanelDetection {
    if (this.tab5LaneKbps() == 0 || channel < 0 || channel > 3 || polls < 1 || polls > 1000000 ||
        !scratch.hasAddressRange(0,16)) return Tab5PanelDetection(2<<8)
    if (this.status() == 1) return Tab5PanelDetection(2|(1<<8))
    if (this.status() == 2) return Tab5PanelDetection(3|(1<<8))
    val ili=tab5PanelDetectIli(channel,scratch,polls)
    val status=ili&255
    if (status == 1) return Tab5PanelDetection(1|(1<<8)|(ili<<16))
    return Tab5PanelDetection((if (status == 2) 3<<8 else if (status == 3) 4<<8 else 2<<8)|(ili<<16))
}
