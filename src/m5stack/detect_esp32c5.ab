import "./detect_c5_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/m5stack.ab"
// Read-only eFuse mirror, never the programming controller. C5 ONLY:
// DR_REG_EFUSE_BASE600B4800 + RD_MAC_SYS2 offset4C.
@inline
@export("m5C5ReadIdentity")
trusted fun m5C5ReadIdentityHook(): u32 = u32(mmioLoadU32(0x600B484C))
