// M5Unified Tab5/Tab5X speaker callback (MIT, M5Stack). Own whole ES8388,
// initialized PI4IOE1 GPIO1 output and sharedregisters. Controlbus/codec clocks
// must be live. Unlike ES8311 sessions, disable BEFORE stopping MCLK/BCLK:
// amplifieroff -> mute/soft-ramp -> DACpowerdown -> CHIPpowerdown.
// Success means callback complete, not stream stopped or analog silence proof.
// Low8:1complete,2invalid,3codecsetup,4ampwrite,5ampreadback,6codecshutdown;
// codec failure detail above8. Any failure retains clock/pad/codec ownership.
trusted fun tab5SpeakerOwned(codec: Es8388,expander: Pi4Ioe5v6408,enabled: bool,exclusive: bool): int {
    if (!exclusive || !codec.valid() || !expander.valid()) return 2
    if (enabled) {
        val result=codec.configureStereoDacSlaveOwned(true)
        if (result != 1) return 3|(result<<8)
    }
    if (!expander.digitalWrite(1,enabled)) return 4
    val latch=expander.getWriteValueChecked(1)
    if (!latch.valid() || (latch.value() != 0) != enabled) return 5
    if (!enabled) {
        val result=codec.speakerPowerDownOwned(true)
        if (result != 1) return 6|(result<<8)
    }
    return 1
}
