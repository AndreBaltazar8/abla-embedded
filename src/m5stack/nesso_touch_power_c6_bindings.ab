import "./nesso_touch_c6_bindings.ab"
import "../touch/ft5x06_power_c6_bindings.ab"
// Explicit shared-IRQ lease, NOT ordinary exclusive controller access:
// quiesce every GPIO3/system-interrupt consumer before sleep/wake. Wake leaves
// input pull-up, does not restore prior GPIO configuration or mask any IRQ.
// Board external pullups may affect the physical pulse: validate on hardware.
// Assign every returned owner; asleep/uncertain owners cannot be polled.
trusted fun nessoTouchPowerAdmitted(bus: int,touch: TouchControllerOpen,sharedIrqQuiesced: bool): bool {
    if (!sharedIrqQuiesced || !nessoTouchBusCurrent(bus) || touch.kind() != 1 || touch.handle() == 0 ||
        !softwareI2cProviderEnter()) return false
    val descriptor=softwareI2cProviderPool().resolve(touch.handle())
    val matches=softwareI2cProviderOwner().matchesDevice(descriptor) && ((descriptor>>>46)&127) == 56
    val released=softwareI2cProviderLeave()
    return matches && released
}
trusted fun nessoTouchSleepOwned(bus: int,touch: TouchControllerOpen,sharedIrqQuiesced: bool): TouchControllerOpen =
    if (nessoTouchPowerAdmitted(bus,touch,sharedIrqQuiesced)) touch.sleepFt5x06CheckedOwned(true) else touch
trusted fun nessoTouchWakeOwned(bus: int,touch: TouchControllerOpen,sharedIrqQuiesced: bool): TouchControllerOpen =
    if (nessoTouchPowerAdmitted(bus,touch,sharedIrqQuiesced)) touch.wakeFt5x06CheckedOwned(3,true) else touch
