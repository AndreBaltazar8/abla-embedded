import "./corematrix_control_sequence.ab"
import "./expander_open.ab"
import "./pmic_open.ab"
import "./corematrix_power.ab"
// M5Stack UIFlow patch2023-Add-CoreMatrix-PWM-speaker-support.patch:
// https://github.com/m5stack/uiflow-micropython/blob/master/m5stack/patches/2023-Add-CoreMatrix-PWM-speaker-support.patch
// physical GPIO2 gates buzzer power, GPIO11 uses PWM3. Abla pin/channel
// indices are zero-based:1,10,2. No PM1 pins or ESP GPIOs are changed.
// Caller owns IOE PWM and these two routes exclusively. Frequency is shared
// by all four channels; this setup deliberately does not change it.
// Status1ready+silent2admission4I/O; bits8..15 completed setup operations.
trusted fun M5CoreMatrixControl.configureBuzzerOwned(exclusive: bool): M5CoreMatrixPowerSetup {
    if (!exclusive || !this.ready()) return M5CoreMatrixPowerSetup(2)
    val ioe=M5Ioe1(this.expanders().device(0)|0)
    // First clear the power latch, then stop PWM before enabling either route.
    // Abort on uncertainty; caller must invoke silenceBuzzerOwned to clean up.
    if (!ioe.digitalWrite(1,false)) return M5CoreMatrixPowerSetup(4)
    if (!ioe.setPwmDuty12(2,0,false,false)) return M5CoreMatrixPowerSetup(4|(1<<8))
    if (!ioe.setHighImpedance(1,false)) return M5CoreMatrixPowerSetup(4|(2<<8))
    if (!ioe.setDirection(1,true)) return M5CoreMatrixPowerSetup(4|(3<<8))
    if (!ioe.setHighImpedance(10,false)) return M5CoreMatrixPowerSetup(4|(4<<8))
    if (!ioe.setDirection(10,true)) return M5CoreMatrixPowerSetup(4|(5<<8))
    return M5CoreMatrixPowerSetup(1|(6<<8))
}
// Always attempt BOTH independent silence paths, even if one write fails.
// Status1both acknowledged,4uncertain,2admission; bit8poweroff,bit9PWMoff.
// Does not release ownership or turn off unrelated board rails.
trusted fun M5CoreMatrixControl.silenceBuzzerOwned(exclusive: bool): int {
    if (!exclusive || !this.ready()) return 2
    val ioe=M5Ioe1(this.expanders().device(0)|0)
    val power=ioe.digitalWrite(1,false)
    val pwm=ioe.setPwmDuty12(2,0,false,false)
    return (if (power && pwm) 1 else 4)|(if (power) 256 else 0)|(if (pwm) 512 else 0)
}
