import "./imu_owner_update_sequence.ab"
import "../imu/snapshot_calibration.ab"

// Preserve both device statuses and a separate calibration result. Calibration
// result is the ongoing enabled/fresh mask (excluding first-sample seeding),
// or -1 on error. Initialized mask occupies bits17..19.
type M5ImuCalibratedUpdate = int
fun M5ImuCalibratedUpdate.acquisition(): M5ImuUpdateResult = M5ImuUpdateResult(this & 131071)
fun M5ImuCalibratedUpdate.calibrationStatus(): int =
    if (!this.acquisition().valid()) -1 else (((this>>>24)&255)^128)-128
fun M5ImuCalibratedUpdate.initializedMask(): int =
    if (!this.acquisition().valid()) -1 else (this>>>17)&7
// Start initialized at0 for automatic first-sample seeding; retain the returned
// mask only when acquisition is valid and calibrationStatus >=0. Default7
// preserves callers that already seeded their filters explicitly.
trusted fun M5ImuOwner.updateCalibratedOwned(snapshot: ImuSnapshot,scratch: NativeBuffer,
    micros: int,calibration: ImuCalibration,offsets: ImuOffsets,initialized: int=7): M5ImuCalibratedUpdate {
    if (initialized < 0 || initialized > 7 || !calibration.acceptsSnapshot(snapshot,offsets) || !this.valid()) return M5ImuCalibratedUpdate(0)
    val count=if (this.primary().kind() == m5ImuBmi270) 20 else 14
    if (!scratch.hasAddressRange(0,count)) return M5ImuCalibratedUpdate(0)
    val state=calibration.buffer().addressValue()
    val correction=offsets.buffer().addressValue()
    val owner=this.buffer().addressValue()
    val work=scratch.addressValue()
    if ((state < owner+36 && owner < state+120) ||
        (correction < owner+36 && owner < correction+36) ||
        (state < work+count && work < state+120) ||
        (correction < work+count && work < correction+36)) return M5ImuCalibratedUpdate(0)
    val result=this.updateOwned(snapshot,scratch,micros)
    if (!result.valid()) return M5ImuCalibratedUpdate(0)
    // A failed primary must not suppress fresh external data, or vice versa.
    val seeded=calibration.seedSnapshot(snapshot,offsets,result.fresh(),initialized)
    if (seeded < 0) return M5ImuCalibratedUpdate((result | 0)|(initialized<<17)|(255<<24))
    // Newly seeded samples have already calibrated once; do not update twice.
    val calibrated=calibration.updateSnapshot(snapshot,offsets,result.fresh() & initialized)
    M5ImuCalibratedUpdate((result | 0)|(seeded<<17)|((calibrated & 255)<<24))
}
