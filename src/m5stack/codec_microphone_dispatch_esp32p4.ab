import "./corep4x_microphone_session_esp32p4.ab"
import "./tab5_microphone_session_esp32p4.ab"
// Board wrapper passes a constant selector; validate the matching magic so
// a session can never accidentally invoke the other board's cleanup policy.
trusted fun m5P4MicrophoneSessionValid(r: NativeBuffer,tab5: bool): bool =
    if (tab5) tab5MicrophoneSessionValid(r) else coreP4xMicrophoneSessionValid(r)
trusted fun m5P4MicrophonePumpOwned(r: NativeBuffer,raw: NativeBuffer,tab5: bool): int =
    if (tab5) tab5MicrophonePumpOwned(r,raw,true) else coreP4xMicrophonePumpOwned(r,raw,true)
trusted fun m5P4MicrophoneStopOwned(r: NativeBuffer,tab5: bool): int =
    if (tab5) tab5MicrophoneStopOwned(r,true) else coreP4xMicrophoneStopOwned(r,true)
