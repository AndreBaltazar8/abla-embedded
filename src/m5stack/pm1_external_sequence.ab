import "./board_id.ab"
import "../i2c/results.ab"
// Borrowed devices; caller serializes the complete board power operation.
// Status:1complete,2unsupported board,3invalid handle,4invalid mask,
// 5PM1 write failure,6latch read failure,7boost write failure.
// Bits8..15 are acknowledged port writes, not a rollback guarantee.
type M5ExternalPowerResult = int
fun M5ExternalPowerResult.status(): int = this & 255
fun M5ExternalPowerResult.valid(): bool = this.status() == 1
fun M5ExternalPowerResult.appliedPorts(): int = (this>>>8)&255
trusted fun M5BoardId.setPm1ExternalOwned(pm1: int,ioe: int,ports: int,enabled: bool): M5ExternalPowerResult {
    val chain=this == m5BoardChainCaptain
    val direct=this == m5BoardToughC5 || this == m5BoardStickS3 ||
        this == m5BoardStopWatch || this == m5BoardPaperColor
    val stamp=this == m5BoardStampS3Bat
    if (!chain && !direct && !stamp) return M5ExternalPowerResult(2)
    if (pm1 <= 0 || pm1 > 4294967295 || (chain && (ioe <= 0 || ioe > 4294967295))) return M5ExternalPowerResult(3)
    if (ports < 0 || (ports & ~(if (chain) 7 else 1)) != 0) return M5ExternalPowerResult(4)
    if (ports == 0) return M5ExternalPowerResult(1)
    if (!chain) {
        val ok=if (stamp) pm1ExternalSetPin(pm1,1,enabled) else pm1ExternalSetRail(pm1,enabled)
        return M5ExternalPowerResult(if (ok) 257 else 5)
    }
    var applied=0
    if ((ports & 1) != 0) {
        if (!pm1ExternalSetPin(pm1,0,enabled)) return M5ExternalPowerResult(5)
        applied=1
    }
    // PB1/PB2 share PM1 G3. Changing either changes both.
    if ((ports & 6) != 0) {
        if (!pm1ExternalSetPin(pm1,3,enabled)) return M5ExternalPowerResult(5|(applied<<8))
        applied=applied|6
    }
    // Read the output latch, NOT sampled GPIO input. A failed read must not
    // be interpreted as all ports off and shut down the shared boost.
    val latch=pm1ExternalLatch(pm1)
    if (!latch.valid()) return M5ExternalPowerResult(6|(applied<<8))
    if (!pm1ExternalBoost(ioe,(latch.value() & 9) != 0)) return M5ExternalPowerResult(7|(applied<<8))
    M5ExternalPowerResult(1|(applied<<8))
}
