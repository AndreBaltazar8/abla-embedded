import "./corematrix_tone_owner.ab"
// Preserve the active frequency/deadline. Power gate stays off while duty is
// changed; a failed step latches status5 until explicit cleanup. Volume0 stops
// and releases ownership instead of retaining a silent timer/PWM lease.
trusted fun M5CoreMatrixTone.setVolumeOwned(volume: int,exclusiveSharedPwm: bool): int {
    if (!exclusiveSharedPwm || !this.valid() || volume < 0 || volume > 255) return 2
    if (volume == 0) return if (this.closeOwned(true)) 0 else 6
    if (this.status() != 1 || !this.control().ready() || !this.control().toneRetained()) return 2
    val chip=M5Ioe1(this.control().expanders().device(0)|0)
    var failure=0
    if (!chip.digitalWrite(1,false)) failure=1
    else if (!chip.setPwmDuty12(2,(volume*2048+127)/255,false,true)) failure=2
    else if (!chip.digitalWrite(1,true)) failure=3
    if (failure != 0) {
        this.buffer().storeU32(48,256|failure);this.buffer().storeU32(4,5);return 5
    }
    return 1
}
//7busy without replacement. Validate the entire request and parent binding
// before disturbing an existing tone. Replacement cannot begin until old
// power/PWM/frequency cleanup succeeds. No queue or PCM support is implied.
trusted fun M5CoreMatrixTone.playOwned(control: M5CoreMatrixControl,frequency: int,volume: int,now: int,duration: int,stopCurrent: bool,exclusiveSharedPwm: bool): int {
    if (!exclusiveSharedPwm || !this.valid() || !control.ready() || frequency < 1 || frequency > 65535 || volume < 0 || volume > 255 || now < 0 || now > 0xffffffff || duration < 1 || duration > 0x7fffffff ||
        (this.buffer().addressValue() < control.buffer().addressValue()+64 && control.buffer().addressValue() < this.buffer().addressValue()+56) || (this.status() != 0 && this.control() != control)) return 2
    if (volume == 0) return if (this.closeOwned(true)) 0 else 6
    if (this.status() != 0) {
        if (!stopCurrent) return 7
        if (!this.closeOwned(true)) return 6
    }
    return this.startOwned(control,frequency,volume,now,duration,true)
}
