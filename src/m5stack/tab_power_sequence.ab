import "./board_id.ab"
// Status1complete,2unsupported,3invalidhandle,4registerwritefailure,
// 5EXTdriverfailure,6EXTdirectionfailure,7EXTlatchfailure.
// Highbyte acknowledgedsteps. Partial boardwide state is not rolled back.
type M5TabPowerSetup = int
fun M5TabPowerSetup.status(): int = this & 255
fun M5TabPowerSetup.appliedSteps(): int = (this>>>8)&255
fun M5TabPowerSetup.valid(): bool = this.status() == 1
fun tabPowerRegister(step: int): int =
    if (step%5 == 0) 5 else if (step%5 == 1) 3 else if (step%5 == 2) 7 else if (step%5 == 3) 13 else 11
fun tabPowerValue(step: int): int =
    if (step == 0) 112 else if (step == 1) 115 else if (step == 2) 8 else if (step < 5) 4 else
    if (step == 5) 129 else if (step == 6) 177 else if (step == 7) 6 else 8
trusted fun M5BoardId.configureTabPowerOwned(ioe0: int,ioe1: int): M5TabPowerSetup {
    if (this != m5BoardTab5 && this != m5BoardTab5X) return M5TabPowerSetup(2)
    if (ioe0 <= 0 || ioe0 > 4294967295 || ioe1 <= 0 || ioe1 > 4294967295 || ioe0 == ioe1) return M5TabPowerSetup(3)
    var step=0
    while (step < 10) {
        if (!tabPowerWrite(if (step < 5) ioe0 else ioe1,tabPowerRegister(step),tabPowerValue(step))) return M5TabPowerSetup(4|(step<<8))
        step=step+1
    }
    if (this == m5BoardTab5X) {
        if (!tabPowerExtDrive(ioe0)) return M5TabPowerSetup(5|(10<<8))
        if (!tabPowerExtDirection(ioe0)) return M5TabPowerSetup(6|(11<<8))
        if (!tabPowerExtLatch(ioe0)) return M5TabPowerSetup(7|(12<<8))
        step=13
    }
    M5TabPowerSetup(1|(step<<8))
}
