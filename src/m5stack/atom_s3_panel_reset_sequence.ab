import "./board_id.ab"
// M5GFX _pin_reset: HIGH1ms, optional LOW2ms,HIGH10ms. Caller exclusively
// owns reset pad, powered panel, inactive CS and stopped bus across all delays.
// Explicit reset invalidates any prior controller configuration/frame contents.
//1complete2admission3initialHIGH4LOW5finalHIGH. Failed writes may have reached
// the pin: retain ownership, never proceed with probing after failure.
trusted fun M5BoardId.resetAtomPanelOwned(pulse: bool,exclusiveCsInactive: bool): int {
    if (!exclusiveCsInactive || (this != m5BoardAtomS3 && this != m5BoardAtomS3R)) return 2
    val reset=Pin(if (this == m5BoardAtomS3) 34 else 48)
    if (!reset.outputLevelOwned(true)) return 3
    peripheralDelayMilliseconds(1)
    if (!pulse) return 1
    if (!reset.writeLevelOwned(false)) return 4
    peripheralDelayMilliseconds(2)
    if (!reset.writeLevelOwned(true)) return 5
    peripheralDelayMilliseconds(10)
    return 1
}
// Recovery releases reset and waits10ms; does NOT replay a reset pulse or claim
// the previous display state survived. Caller still needs full initialization.
trusted fun M5BoardId.releaseAtomPanelResetOwned(exclusiveCsInactive: bool): bool {
    if (!exclusiveCsInactive || (this != m5BoardAtomS3 && this != m5BoardAtomS3R)) return false
    if (!Pin(if (this == m5BoardAtomS3) 34 else 48).outputLevelOwned(true)) return false
    peripheralDelayMilliseconds(10)
    return true
}
