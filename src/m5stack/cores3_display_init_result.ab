// Import through cores3_display_init.ab with the selected I2C/GPIO backend.
// Result status:1 complete,2 invalid,3 PMIC,4 expander,5 pins,6 SD transport,
// 7 reset,8 revision detection,9 panel commands,10 clear,11 backlight,12 hardware SPI. Detail preserves
// SPI status or signed detection result. Cleanup:0 not attempted,1 off,2 failed.
type CoreS3DisplayInitResult = int
fun CoreS3DisplayInitResult.status(): int = this & 255
fun CoreS3DisplayInitResult.valid(): bool = this.status() == 1
fun CoreS3DisplayInitResult.detail(): int {
    val value = (this >>> 8) & 255
    if (value >= 128) value - 256 else value
}
fun CoreS3DisplayInitResult.cleanup(): int = (this >>> 16) & 3
fun CoreS3DisplayInitResult.panel(): int = (this >>> 24) & 3

trusted fun cores3DisplayInitFailure(power: Axp2101, stage: int, detail: int): CoreS3DisplayInitResult {
    // Do not guess how to roll back shared power rails. Only attempt darkness,
    // and report if the I2C failure also prevents this best-effort cleanup.
    val cleanup = if (cores3DisplaySetBrightness(power, 0)) 1 else 2
    CoreS3DisplayInitResult(stage | ((detail & 255) << 8) | (cleanup << 16))
}
