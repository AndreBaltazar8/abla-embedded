import "./board_id.ab"

// M5Unified microphone callbacks (MIT, M5Stack): StickS3, StopWatch,
// Chain Captain, Cardputer ADV, Atom Voice S3R. Caller owns stopped capture, whole codec, initialized IOE1
// output configuration, shared audio rail and matching clocks. Codec handle
// must already use the board's control bus (StickS3/StopWatch SDA47/SCL48,
// Atom Voice S3R SDA45/SCL0; its IMU cannot share those pads concurrently).
// No temporary bus stealing/reconfiguration: other users remain caller-owned.
// S3 adapter uses calibrated ROM delay; do not call with interrupts masked.
// Result low8:1 complete,2 invalid,3 rail write,4 rail readback,5 codec failure;
// codec result in bits8+. A failed enable may leave rail/codec active: retain
// ownership and disable after capture is stopped. Disable leaves shared rail
// enabled, matching upstream; it does not close either I2C device handle.
trusted fun M5BoardId.es8311MicrophoneOwned(codec: Es8311,expander: M5Ioe1,
    enabled: bool,exclusive: bool): int {
    if (!exclusive || !codec.valid() ||
        (this != m5BoardStickS3 && this != m5BoardStopWatch && this != m5BoardChainCaptain &&
         this != m5BoardCardputerADV && this != m5BoardAtomVoiceS3R)) return 2
    val rail = this == m5BoardStopWatch || this == m5BoardChainCaptain
    if (enabled && rail && !expander.valid()) return 2
    if (enabled && rail) {
        val pin = if (this == m5BoardStopWatch) 2 else 4
        if (!expander.digitalWrite(pin,true)) return 3
        val latch = expander.getWriteValueChecked(pin)
        if (!latch.valid() || latch.value() == 0) return 4
        peripheralDelayMilliseconds(5)
    }
    val result = codec.microphoneBclkOwned(enabled,true,if (this == m5BoardCardputerADV) 191 else 255)
    if (result != 1) return 5 | (result << 8)
    return 1
}
