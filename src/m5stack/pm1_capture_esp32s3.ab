import "./pm1_audio_esp32s3.ab"
import "./es8311_capture_esp32s3.ab"
// Borrow codec/control until the existing capture close returns4. Fresh132B
// record, parked DMA, stopped TX+RX, prepared pads and stable clocks required.
// Close leaves the shared audio rail enabled; explicit speaker disable can
// remove it AFTER all rail users stop. This does not allocate/close the codec.
trusted fun M5Pm1Control.beginAudioCaptureOwned(record: NativeBuffer,hz: int,channel: int,
    desc: int,count: int,payload: int,bytes: int,owner: u32,codec: Es8311,exclusive: bool): int {
    if (!exclusive || !pm1BoardAudioAdmission(this|0) || !pm1BoardAudioCodecMatches(this|0,codec) ||
        !pm1AudioStreamStorageSafe(record,132,desc,count,payload,bytes,this.buffer(),
            esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return 0
    return this.board().beginEs8311CaptureOwned(record,hz,channel,desc,count,payload,bytes,owner,
        codec,pm1BoardAudioExpander(this|0),true)
}
