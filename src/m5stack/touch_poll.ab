import "./touch_poll_sequence.ab"
import "../touch/ft5x06_device.ab"
import "../touch/gt911_device.ab"
import "../touch/chsc6540_irq.ab"
// Original M5Tough IRQ39 must already be configured as an input by board setup.
trusted fun m5TouchPollRead(kind: int,handle: int,snapshot: NativeBuffer,board: M5BoardId): int =
    if (kind == 1) Ft5x06(handle).readStable(snapshot) else if (kind == 2) Gt911(handle).readFrame(snapshot) else
    if (board == m5BoardTough) Chsc6540(handle).readWithInterrupt(pin(39),snapshot) else Chsc6540(handle).readStable(snapshot)
trusted fun M5BoardId.pollFt5x06Buttons(touch: Ft5x06,tracker: TouchTracker,snapshot: NativeBuffer,
    raw: NativeBuffer,now: int,previous: int,ratio: int): M5TouchButtons =
    this.pollTouchButtonsOwned(1,touch | 0,tracker,snapshot,raw,now,previous,ratio)
trusted fun M5BoardId.pollGt911Buttons(touch: Gt911,tracker: TouchTracker,snapshot: NativeBuffer,
    raw: NativeBuffer,now: int,previous: int,ratio: int): M5TouchButtons =
    this.pollTouchButtonsOwned(2,touch | 0,tracker,snapshot,raw,now,previous,ratio)
