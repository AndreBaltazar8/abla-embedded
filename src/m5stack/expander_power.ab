import "./expander_power_sequence.ab"
import "../io_expander/m5ioe1_device.ab"
import "../io_expander/pi4ioe5v6408_device.ab"
trusted fun expanderPowerPull(handle: int,pin: int,enabled: bool): bool =
    Pi4Ioe5v6408(handle).setPullMode(pin,if (enabled) pullUp else pullDown)
trusted fun expanderPowerDrive(handle: int,pin: int,m5: bool): bool =
    if (m5) M5Ioe1(handle).setHighImpedance(pin,false) else Pi4Ioe5v6408(handle).setHighImpedance(pin,false)
trusted fun expanderPowerDirection(handle: int,pin: int,m5: bool): bool =
    if (m5) M5Ioe1(handle).setDirection(pin,true) else Pi4Ioe5v6408(handle).setDirection(pin,true)
trusted fun expanderPowerLatch(handle: int,pin: int,m5: bool,enabled: bool): bool =
    if (m5) M5Ioe1(handle).digitalWrite(pin,enabled) else Pi4Ioe5v6408(handle).digitalWrite(pin,enabled)
// Borrowed board IOE0/IOE1, already initialized. Tab/Nesso use PI4 devices
// at0x43/0x44; CoreP4X/CoreMatrix use M5IOE1. Caller serializes the sequence.
trusted fun M5BoardId.setExpanderPower(ioe0: I2cDevice,ioe1: I2cDevice,ports: int,enabled: bool): M5ExpanderPowerResult =
    this.setExpanderPowerOwned(ioe0 | 0,ioe1 | 0,ports,enabled)
