import "./tab5_backlight_p4_sequence.ab"
import "../esp32/gpio_esp32p4.ab"
trusted fun p4Tab5BacklightGpioReady(): bool = (p4GpioRead(32)&u32(1<<22)) != u32(0) &&
    (p4GpioRead(204)&u32(4)) == u32(0) && (p4GpioRead(1456)&u32(4095)) == u32(1280) &&
    (p4GpioRead(4188)&u32(0x7002)) == u32(0x1000)
trusted fun p4Tab5BacklightLatch(): bool = (p4GpioRead(4)&u32(1<<22)) != u32(0)
