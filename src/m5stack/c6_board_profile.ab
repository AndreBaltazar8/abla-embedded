import "./i2c_pin_map.ab"
import "./speaker_profile.ab"
import "./touch_profile.ab"
// Static configuration only; constructors never probe, allocate or initialize.
// Existing peripheral owners retain all hardware startup/cleanup requirements.
type M5NessoN1 = int
fun m5NessoN1(): M5NessoN1 = M5NessoN1(23)
fun M5NessoN1.boardId(): M5BoardId = m5BoardArduinoNessoN1
fun M5NessoN1.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5NessoN1.speakerProfile(): M5SpeakerProfile = this.boardId().speakerProfile()
fun M5NessoN1.touchProfile(): M5TouchProfile = this.boardId().touchProfile()
type M5UnitC6L = int
fun m5UnitC6L(): M5UnitC6L = M5UnitC6L(25)
fun M5UnitC6L.boardId(): M5BoardId = m5BoardUnitC6L
fun M5UnitC6L.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
