import "./board_id.ab"
// Cold-start built-in defaults from M5Unified::_begin_audio and Speaker_Class
// (MIT, M5Stack). No attached accessories, AtomDisplay overrides, bus changes,
// power or playback implied. Availability is not driver/physical validation.
// Scalar: 4pins6bits encoded+1, mode2,port1,stereo1,gain8,rate17,zeroLevel8.
type M5SpeakerProfile=int
val m5SpeakerI2s=1
val m5SpeakerDac=2
val m5SpeakerBuzzer=3
fun m5SpeakerProfile(mode: int,data: int,ws: int = -1,bclk: int = -1,mclk: int = -1,
    port: int = 1,stereo: bool = false,gain: int = 16,hz: int = 48000,zeroLevel: int = 0): M5SpeakerProfile {
    if (mode < 1 || mode > 3 || data < 0 || data > 62 || ws < -1 || ws > 62 ||
        bclk < -1 || bclk > 62 || mclk < -1 || mclk > 62 || port < 0 || port > 1 ||
        gain < 0 || gain > 255 || hz < 1 || hz > 131071 || zeroLevel < 0 || zeroLevel > 255) return M5SpeakerProfile(0)
    return M5SpeakerProfile((data+1)|((ws+1)<<6)|((bclk+1)<<12)|((mclk+1)<<18)|(mode<<24)|
        (port<<26)|((if (stereo) 1 else 0)<<27)|(gain<<28)|(hz<<36)|(zeroLevel<<53))
}
// Availability requires a canonical constructor-valid scalar, not just mode.
fun M5SpeakerProfile.available(): bool = (this>>>61) == 0 && this.transport() != 0 && this.dataPin() >= 0 && this.sampleRate() > 0
fun M5SpeakerProfile.transport(): int = (this>>>24)&3
fun M5SpeakerProfile.dataPin(): int = (this&63)-1
fun M5SpeakerProfile.wordSelectPin(): int = ((this>>>6)&63)-1
fun M5SpeakerProfile.bitClockPin(): int = ((this>>>12)&63)-1
fun M5SpeakerProfile.masterClockPin(): int = ((this>>>18)&63)-1
fun M5SpeakerProfile.port(): int = (this>>>26)&1
fun M5SpeakerProfile.stereo(): bool = ((this>>>27)&1) != 0
fun M5SpeakerProfile.gain(): int = (this>>>28)&255
fun M5SpeakerProfile.sampleRate(): int = (this>>>36)&131071
fun M5SpeakerProfile.dacZeroLevel(): int = (this>>>53)&255
fun M5BoardId.speakerProfile(): M5SpeakerProfile {
    if (this == m5BoardCoreP4X) return m5SpeakerProfile(1,3,4,6,2,0,false,4,24000)
    if (this == m5BoardTab5 || this == m5BoardTab5X) return m5SpeakerProfile(1,26,29,27,30,0,false,4)
    if (this == m5BoardStackCoreS3 || this == m5BoardStackCoreS3SE || this == m5BoardStackChan) return m5SpeakerProfile(1,13,33,34,-1,1,false,4)
    if (this == m5BoardStickS3) return m5SpeakerProfile(1,14,15,17,18,0,true,1,22050)
    if (this == m5BoardPaperColor) return m5SpeakerProfile(1,38,41,40,42,0,true,1,44100)
    if (this == m5BoardStopWatch) return m5SpeakerProfile(1,21,15,17,18,0,true,4,44100)
    if (this == m5BoardChainCaptain) return m5SpeakerProfile(1,42,41,38,40,0,true,1,44100)
    if (this == m5BoardCardputer || this == m5BoardCardputerADV) return m5SpeakerProfile(1,42,43,41)
    if (this == m5BoardAtomVoiceS3R) return m5SpeakerProfile(1,48,3,17,-1,1,false,1)
    if (this == m5BoardAtomVoice) return m5SpeakerProfile(1,22,33,19,-1,1,false,12)
    if (this == m5BoardStackCore2 || this == m5BoardTough) return m5SpeakerProfile(1,2,0,12,-1,1,false,if (this == m5BoardTough) 24 else 16)
    if (this == m5BoardStack) return m5SpeakerProfile(2,25,-1,-1,-1,0,false,8,96000)
    if (this == m5BoardUnitC6L || this == m5BoardArduinoNessoN1) return m5SpeakerProfile(3,11,-1,-1,-1,0,false,48)
    if (this == m5BoardCapsule || this == m5BoardStackCoreInk || this == m5BoardStickCPlus || this == m5BoardStickCPlus2) return m5SpeakerProfile(3,2,-1,-1,-1,1,false,48)
    if (this == m5BoardDial || this == m5BoardDinMeter) return m5SpeakerProfile(3,3,-1,-1,-1,1,false,48)
    if (this == m5BoardAirQ) return m5SpeakerProfile(3,9,-1,-1,-1,1,false,48)
    if (this == m5BoardVAMeter) return m5SpeakerProfile(3,14,-1,-1,-1,1,false,48)
    if (this == m5BoardPaperS3) return m5SpeakerProfile(3,21,-1,-1,-1,1,false,48)
    if (this == m5BoardPaperMono) return m5SpeakerProfile(3,42,-1,-1,-1,1,false,48)
    if (this == m5BoardStampPLC) return m5SpeakerProfile(3,44,-1,-1,-1,1,false,48)
    return M5SpeakerProfile(0)
}
fun M5BoardId.speakerNeedsEnableSequence(): bool =
    this == m5BoardCoreP4X || this == m5BoardTab5 || this == m5BoardTab5X ||
    this == m5BoardStackCoreS3 || this == m5BoardStackCoreS3SE || this == m5BoardStackChan ||
    this == m5BoardStickS3 || this == m5BoardPaperColor || this == m5BoardStopWatch ||
    this == m5BoardChainCaptain || this == m5BoardCardputerADV || this == m5BoardAtomVoiceS3R ||
    this == m5BoardStackCore2 || this == m5BoardTough
