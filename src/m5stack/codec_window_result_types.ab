// Results of the codec record and playback windows (ES8311 boards, PaperColor, CoreP4X and Tab5).
// Low 8 bits are the status; the high 32 bits are committed bytes (record) or queued source blocks (playback).
// The window sequences document each status value.
type M5CodecRecordWindowResult=int
fun M5CodecRecordWindowResult.status(): int = this&255
fun M5CodecRecordWindowResult.bytes(): int = this>>>32
type M5Es8311PlaybackWindowResult=int
fun M5Es8311PlaybackWindowResult.status(): int = this&255
fun M5Es8311PlaybackWindowResult.queuedBlocks(): int = this>>>32
type M5P4RecordWindowResult=int
fun M5P4RecordWindowResult.status(): int = this&255
fun M5P4RecordWindowResult.bytes(): int = this >>> 32
type M5P4PlaybackWindowResult=int
fun M5P4PlaybackWindowResult.status(): int = this&255
fun M5P4PlaybackWindowResult.queuedBlocks(): int = this>>>32
