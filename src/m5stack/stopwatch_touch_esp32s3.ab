import "./pm1_control_esp32s3.ab"
import "../esp32/gpio/snapshot_esp32s3.ab"
import "../esp32/gpio/input_s3_sequence.ab"
import "../touch/cst816s_session.ab"
import "./stopwatch_touch_sequence.ab"
import "./stopwatch_touch_logic.ab"
import "./stopwatch_touch_poll.ab"
trusted fun stopWatchTouchAdmission(control: int): bool =
    M5Pm1Control(control).ready() && M5Pm1Control(control).board() == m5BoardStopWatch
trusted fun stopWatchTouchPrepareIrq(): bool = esp32S3GpioPrepareInputOwned(13,0,true) == 1
trusted fun stopWatchTouchAllocate(control: int): int =
    I2cBus(M5Pm1Control(control).bus()).device(21,400000)|0
// Shared PM1 bus is borrowed, including its full33-bit generation key.
// Join this session before closing board control/bus or resetting OLED+touch.
trusted fun M5Pm1Control.openStopWatchTouchOwned(exclusive: bool): Cst816sSession =
    stopWatchTouchOpenOwned(this|0,exclusive)
