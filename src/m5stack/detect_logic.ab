import "./board_id.ab"

// Pure board-detection decisions, separated from pin and I2C probes. Firmware
// that selects a board statically never imports this module. Hardware-specific
// detectors collect the observations and call these functions; host tests can
// cover every branch without touching a board.

fun m5DetectEsp32Package(
    current: M5BoardId,
    packageVersion: int,
    gpio2High: bool = false,
    gpio34High: bool = false,
    atomLiteOrVoice: bool = false,
    atomVoicePattern: bool = false
): M5BoardId {
    if (current != m5BoardUnknown) return current
    if (packageVersion == 0) return m5BoardTimerCam
    if (packageVersion == 6) return m5BoardAtomPsram
    if (packageVersion != 5) return m5BoardUnknown
    if (!gpio2High) return m5BoardStampPico
    if (!gpio34High) return m5BoardAtomU
    if (!atomLiteOrVoice) return m5BoardAtomMatrix
    if (atomVoicePattern) m5BoardAtomVoice else m5BoardAtomLite
}

// QFN56 ESP32-S3 observation bits match M5Unified's read order:
// bit 0 GPIO8, bit 1 GPIO10, bit 2 GPIO4, bit 3 GPIO12, bit 4 GPIO38 while
// pulled up, bit 5 GPIO38 after it is floated. PowerHub is the final I2C
// fallback and is only considered while the GPIO signature is unknown.
fun m5DetectEsp32S3Qfn56(
    current: M5BoardId,
    observations: int,
    powerHubPresent: bool = false
): M5BoardId {
    if (current != m5BoardUnknown) return current
    if ((observations & 3) == 2 && (observations >>> 3) == 6) {
        return m5BoardCapsule
    }
    val signature = observations & 15
    if (signature == 2 || signature == 6 || signature == 10 ||
        signature == 14) return m5BoardStampS3
    if (signature == 4 || signature == 5 || signature == 7) {
        return m5BoardAtomS3Lite
    }
    if (signature == 8 || signature == 9 || signature == 11) {
        return m5BoardAtomS3U
    }
    if (powerHubPresent) m5BoardPowerHub else m5BoardUnknown
}

// LGA56/PICO ESP32-S3 detection deliberately checks the internal bus first.
// This keeps the Atom Voice GPIO48 speaker output untouched and stops a user
// device on the camera breakout from stealing board identity.
fun m5DetectEsp32S3Pico(
    current: M5BoardId,
    bmi270Present: bool,
    voiceCodecPresent: bool,
    stampBatteryControllerPresent: bool,
    cameraPresent: bool = false
): M5BoardId {
    var board = current
    if (board == m5BoardUnknown) {
        board = if (bmi270Present) m5BoardAtomS3RExt
            else if (voiceCodecPresent) m5BoardAtomVoiceS3R
            else if (stampBatteryControllerPresent) m5BoardStampS3Bat
            else m5BoardStampS3Mini
    }
    if (board == m5BoardAtomS3RExt && cameraPresent) {
        board = m5BoardAtomS3RCam
    }
    board
}

fun m5DetectEsp32C3(
    current: M5BoardId,
    gpio20LowWithPullDown: bool
): M5BoardId =
    if (current != m5BoardUnknown) current
    else if (gpio20LowWithPullDown) m5BoardStampC3U
    else m5BoardUnknown

fun m5DetectEsp32C6(
    current: M5BoardId,
    packageVersion: int,
    embeddedFlashCapacityCode: int
): M5BoardId =
    if (current != m5BoardUnknown) current
    else if (packageVersion != 1) m5BoardUnknown
    else if (embeddedFlashCapacityCode == 2) m5BoardStampC6
    else m5BoardNanoC6

fun m5DetectEsp32C5(
    current: M5BoardId,
    embeddedFlashCapacityCode: int,
    embeddedPsramCapacityCode: int
): M5BoardId =
    if (current != m5BoardUnknown) current
    else if (embeddedFlashCapacityCode == 1 &&
        embeddedPsramCapacityCode == 0) m5BoardStampC5
    else m5BoardUnknown

fun m5DetectEsp32H2(current: M5BoardId): M5BoardId =
    if (current == m5BoardUnknown) m5BoardNanoH2 else current

fun m5DetectEsp32P4(
    current: M5BoardId,
    gpio32High: bool,
    gpio0High: bool,
    revision: int
): M5BoardId {
    if (current != m5BoardUnknown) return current
    val newer = revision >= 300
    if (gpio32High) return if (newer) m5BoardTab5X else m5BoardTab5
    if (gpio0High) return m5BoardUnitPoEP4
    if (newer) m5BoardStampP4X else m5BoardStampP4
}
