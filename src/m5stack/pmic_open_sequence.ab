import "./power_profile.ab"
import "./pmic_types.ab"
trusted fun M5BoardId.openPmicOwned(bus: int): M5PmicOpen {
    val kind=this.powerKind() | 0
    if (kind < 2 || kind > 6) return M5PmicOpen(2<<40)
    if (!m5PmicBusValid(bus)) return M5PmicOpen(3<<40)
    val address=if (kind == 2 || kind == 3) 52 else if (kind == 4) 117 else if (kind == 5) 110 else 73
    val handle=m5PmicAllocate(bus,address,if (kind == 5) 100000 else 400000)
    if (handle == 0) return M5PmicOpen(4<<40)
    val detected=m5PmicBegin(handle,kind)
    if (detected != 0) return M5PmicOpen(handle|(detected<<32)|(1<<40))
    if (m5PmicClose(handle)) return M5PmicOpen(5<<40)
    M5PmicOpen(handle|(kind<<32)|(6<<40))
}
trusted fun M5PmicOpen.releaseOwned(): M5PmicOpen {
    if (!this.ownsDevice()) return this
    if (m5PmicClose(this.deviceHandle())) return M5PmicOpen(7<<40)
    M5PmicOpen(this.deviceHandle()|(this.kind()<<32)|(6<<40))
}
