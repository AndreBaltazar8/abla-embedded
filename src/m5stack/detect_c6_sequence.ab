import "./detect_logic.ab"
import "../esp32/soc/identity_c6_logic.ab"
// C6 read-only eFuse mirrors. Keep board selection/display detection intact;
// only QFN32 needs the second identity word. Unknown QFN40 is not NanoC6.
val esp32C6EfuseMacSpiSys4 = 1611335764
trusted fun m5DetectCurrentEsp32C6(current: M5BoardId = m5BoardUnknown): M5BoardId {
    if (current != m5BoardUnknown) return current
    val packageVersion=esp32C6PackageFromEfuse(m5C6ReadIdentity(0x600b0850))
    if (packageVersion != 1) return m5BoardUnknown
    val capacity=int(m5C6ReadIdentity(esp32C6EfuseMacSpiSys4)&u32(7))
    return m5DetectEsp32C6(current,packageVersion,capacity)
}
