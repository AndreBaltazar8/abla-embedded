import "./atom_gc9107_map.ab"
// Validated AtomS3/R panel selection from a successfully obtained RDDID value.
// This is classification, NOT a GPIO probe or hardware-presence guarantee.
// Canonical scalar: board8 + variant8 (1ST7735S,2GC9107); unknown stays0.
type AtomS3Panel=int
fun atomS3PanelFromId(board: M5BoardId,id: int): AtomS3Panel {
    if ((board != m5BoardAtomS3 && board != m5BoardAtomS3R) || id < 0 || id > 0xffffffff) return AtomS3Panel(0)
    val variant=if ((id&65535) == 0x7683 || (id&65535) == 0x897c) 1 else if ((id&0xffffff) == 0x079100) 2 else 0
    return if (variant == 0) AtomS3Panel(0) else AtomS3Panel((board|0)|(variant<<8))
}
fun AtomS3Panel.valid(): bool = this > 0 && (this>>>16) == 0 &&
    ((this&255) == (m5BoardAtomS3|0) || (this&255) == (m5BoardAtomS3R|0)) && ((this>>8) == 1 || (this>>8) == 2)
fun AtomS3Panel.gc9107(): bool = this.valid() && (this>>8) == 2
fun AtomS3Panel.pins(): M5SpiDisplayPins =
    (if (this.valid()) M5BoardId(this&255) else m5BoardUnknown).gc9107DisplayPins()
fun AtomS3Panel.geometry(): LcdGeometry = if (!this.valid()) LcdGeometry(u64(0)) else
    if (this.gc9107()) atomGc9107Geometry() else lcdGeometry(128,128,2,1,132,132)
// Upstream offset_rotation2 on ST7735,0 onGC9107. Mirrorbit retained.
fun AtomS3Panel.internalRotation(rotation: int): int =
    if (!this.valid() || rotation < 0 || rotation > 7) -1 else if (this.gc9107()) rotation else ((rotation+2)&3)|(rotation&4)
fun AtomS3Panel.view(rotation: int): LcdView =
    if (this.internalRotation(rotation) < 0) LcdView(u64(0)) else this.geometry().view(this.internalRotation(rotation))
