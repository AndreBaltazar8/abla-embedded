import "./touch_profile.ab"
import "./tab5_touch_probe_sequence.ab"
// Selection requires evidence, never a guessed default for Tab5. The GT ACK
// branch additionally needs caller-confirmed ILI9881C display identity.
fun M5BoardId.touchProfileFromProbe(probe: M5Tab5TouchProbe,gtPanelVerified: bool = false): M5TouchProfile {
    if (this != m5BoardTab5 && this != m5BoardTab5X) return M5TouchProfile(0)
    if ((probe.status() == 1 && probe.firmware() == 1) || (probe.status() == 2 && probe.firmware() == 3))
        return m5TouchProfile(6,85,23,31,32,1,720,1280)
    if (probe.status() == 3 && gtPanelVerified) return m5TouchProfile(2,20,23,31,32,1,720,1280)
    M5TouchProfile(0)
}
