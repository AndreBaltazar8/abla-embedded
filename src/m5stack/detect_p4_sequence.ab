import "./detect_logic.ab"
import "../esp32/soc/identity_p4_logic.ab"
// Known-M5-board detection, not arbitrary P4 board identification. Caller owns
// GPIO32/0, has configured GPIO input pulldowns and allowed them to settle,
// with holds released and clocks pinned. Does not change any pad or clock.
// Explicit selection always wins and performs no hardware access.
trusted fun m5DetectCurrentEsp32P4Prepared(current: M5BoardId,inputsPreparedExclusive: bool): M5BoardId {
    if (current != m5BoardUnknown) return current
    if (!inputsPreparedExclusive) return m5BoardUnknown
    val pin32=m5P4DetectReadPin(32)
    if (pin32 < 0 || pin32 > 1) return m5BoardUnknown
    if (pin32 == 1) return m5DetectEsp32P4(current,true,false,esp32P4RevisionFromEfuse(m5P4ReadIdentity()))
    val pin0=m5P4DetectReadPin(0)
    if (pin0 < 0 || pin0 > 1) return m5BoardUnknown
    if (pin0 == 1) return m5BoardUnitPoEP4
    m5DetectEsp32P4(current,false,false,esp32P4RevisionFromEfuse(m5P4ReadIdentity()))
}
