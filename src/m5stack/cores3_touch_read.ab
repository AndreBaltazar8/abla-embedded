// Backend-independent sequencing, imported through cores3_touch.ab. Caller
// serializes setup/reads against every consumer of the shared AW9523 IRQ.
trusted fun cores3ConfigureTouchInterrupt(): bool {
    if (!Pin(21).valid() || !Pin(21).pullCapable()) return false
    Pin(21).input()
    Pin(21).pullUp()
    true
}

// GPIO21 active-low via AW9523 P1_2/INTN. Caller owns initialized I2C devices
// and a29B snapshot, and configures the IRQ input first. Only decode positive counts.
// 0=no contact; -1 invalid/transport; -2 unstable; -3 acknowledge failed.
trusted fun cores3ReadTouch(touch: Ft5x06, expander: Aw9523, snapshot: NativeBuffer): int {
    if (!touch.valid() || !expander.valid() || !Pin(21).valid() || !snapshot.hasAddressRange(0, 29)) return -1
    if (Pin(21).read()) return 0
    val count = touch.readStable(snapshot)
    // Never clear IRQ on transport/unstable failure or turn failure into zero.
    if (count == 0 && !expander.readPortsChecked().valid()) return -3
    count
}
