import "./expander_profile.ab"
import "./expander_open_types.ab"
trusted fun M5BoardId.openExpanderOwned(bus: int,index: int): M5ExpanderOpen {
    val profile=this.expanderProfile(index)
    if (profile == 0) return M5ExpanderOpen(2<<40)
    if (!m5ExpanderBusValid(bus)) return M5ExpanderOpen(3<<40)
    val kind=profile>>>8
    val handle=m5ExpanderAllocate(bus,profile&255,if (kind == 1) 400000 else 100000)
    if (handle == 0) return M5ExpanderOpen(4<<40)
    val owned=handle|(kind<<32)
    if (m5ExpanderBegin(handle,kind)) return M5ExpanderOpen(owned|(1<<40))
    if (m5ExpanderClose(handle)) return M5ExpanderOpen(5<<40)
    M5ExpanderOpen(owned|(6<<40))
}
trusted fun M5ExpanderOpen.releaseOwned(): M5ExpanderOpen {
    if (!this.ownsDevice()) return this
    if (m5ExpanderClose(this.deviceHandle())) return M5ExpanderOpen(7<<40)
    M5ExpanderOpen(this.deviceHandle()|(this.kind()<<32)|(6<<40))
}
