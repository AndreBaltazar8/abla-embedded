import "./pm1_control_sequence.ab"
import "./imu_owner_types.ab"
// Optional76B parent record (existing72B callers unchanged), fresh36B child.
// Both buffers and borrowed bus remain exclusively owned through cleanup.
// The adapter validates all76 parent bytes against provider-private storage.
trusted fun M5Pm1Control.openRetainedImuPreparedOwned(imu: M5ImuOwner,exclusive: bool): int {
    if (!exclusive || !this.ready() || this.imuRetained() ||
        !this.buffer().hasAddressRange(0,76) || !pm1ImuParentStorageSafe(this.buffer()) ||
        !pm1BoardImuAdmission(this|0,imu)) return -1
    val child=imu.buffer().addressValue();val parent=this.buffer().addressValue()
    if (child < parent+76 && parent < child+36) return -1
    // Bind before probing, including absent/failed discovery and cleanup.
    this.buffer().storeU32(72,child)
    this.buffer().storeU32(64,this.buffer().loadU32(64)|256)
    return pm1BoardImuProbe(imu,this.bus())
}
trusted fun M5Pm1Control.closeRetainedImuOwned(imu: M5ImuOwner,exclusive: bool): bool {
    if (!exclusive || !this.valid() || !this.imuRetained() ||
        !this.buffer().hasAddressRange(0,76) || !pm1ImuParentStorageSafe(this.buffer()) ||
        !imu.buffer().hasAddressRange(0,36) || this.buffer().loadU32(72) != imu.buffer().addressValue()) return false
    // Never dereference a mismatched borrowed child; failed release retains it.
    if (!pm1BoardImuClose(imu)) return false
    this.buffer().storeU32(72,0)
    this.buffer().storeU32(64,this.buffer().loadU32(64)&~256)
    return true
}
