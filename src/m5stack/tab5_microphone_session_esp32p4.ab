import "./tab5_microphone_session_sequence.ab"
import "../esp32/i2c_software_esp32p4.ab"
import "./tab5_microphone_dma_esp32p4.ab"
import "./tab5_microphone_esp32p4.ab"
import "../esp32/i2s/dma_session_esp32p4.ab"
import "../esp32/i2s/pin_session_esp32p4.ab"
import "../hal/esp32_i2s.ab"
import "../hal/m5stack.ab"
import "../hal/esp32_i2s_2.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../esp32/i2s/pin_session_p4_sequence.ab"
import "../esp32/sdk/nativebuffer_type.ab"
@export("p4Tab5MicParked")
trusted fun p4Tab5MicParkedHook(channel: int): int = p4StereoMicParked(channel)
@export("p4Tab5MicI2sStopped")
trusted fun p4Tab5MicI2sStoppedHook(): bool = p4StereoMicI2sStopped()
@export("p4Tab5MicSessionPinsCapture")
trusted fun p4Tab5MicSessionPinsCaptureHook(r: NativeBuffer,revision: int): int =
    esp32p4I2sPinsCaptureOwned(r,0,false,30,27,29,28,0,if (revision >= 300) 3 else 1,true)
@export("p4Tab5MicSessionPinsClose")
trusted fun p4Tab5MicSessionPinsCloseHook(r: NativeBuffer): int = esp32p4I2sPinsCloseOwned(r,true)
