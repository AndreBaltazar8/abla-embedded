import "./tab5_microphone_session_sequence.ab"
import "../esp32/i2c_software_esp32p4.ab"
import "./tab5_microphone_dma_esp32p4.ab"
import "./tab5_microphone_esp32p4.ab"
import "../esp32/i2s/dma_session_esp32p4.ab"
import "../esp32/i2s/pin_session_esp32p4.ab"
trusted fun p4Tab5MicParked(channel: int): int = p4StereoMicParked(channel)
trusted fun p4Tab5MicI2sStopped(): bool = p4StereoMicI2sStopped()
trusted fun p4Tab5MicSessionPinsCapture(r: NativeBuffer,revision: int): int =
    esp32p4I2sPinsCaptureOwned(r,0,false,30,27,29,28,0,if (revision >= 300) 3 else 1,true)
trusted fun p4Tab5MicSessionPinsClose(r: NativeBuffer): int = esp32p4I2sPinsCloseOwned(r,true)
