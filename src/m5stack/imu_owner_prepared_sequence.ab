import "./imu_owner_types.ab"
import "./imu_probe_prepared_sequence.ab"
trusted fun M5ImuOwner.openPreparedOwned(bus: int): int {
    if (this.status() != 0 || this.primary().handle() != 0 || this.magnetometers().status() != 0 ||
        this.magnetometers().handle(1) != 0 || this.magnetometers().handle(2) != 0) return -1
    val primary=m5ImuProbePreparedOwned(bus)
    this.buffer().storeU32(8,primary&0xFFFFFFFF); this.buffer().storeU32(12,primary>>>32)
    if (!primary.ready()) {
        val status=if (primary.status() == 1) 6 else primary.status()
        this.buffer().storeU32(4,status)
        return status
    }
    val mag=this.magnetometers().probePreparedOwned(bus)
    val status=if (mag == 1 || mag == 2) 1 else mag
    this.buffer().storeU32(4,status)
    status
}
