import "./i2c_pin_map.ab"
// The board table is SCL,SDA; bus constructors take SDA,SCL. Nesso's
// internal/Qwiic bus is SDA10/SCL8 (Arduino pins_arduino.h and M5GFX).
fun nessoI2cPinsMatch(sda: int,scl: int): bool {
    val pins=m5BoardArduinoNessoN1.i2cPins()
    return sda == pins.internalData() && scl == pins.internalClock()
}
