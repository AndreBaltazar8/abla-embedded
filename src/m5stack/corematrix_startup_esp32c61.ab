import "./corematrix_startup_sequence.ab"
import "./corematrix_control_esp32c61.ab"
import "./corematrix_irq_esp32c61.ab"
import "./corematrix_power.ab"
import "./pm1_presence.ab"
trusted fun coreMatrixStartupAdmission(owner: int,presence: Pm1BatteryPresence): bool {
    val control=M5CoreMatrixControl(owner)
    if (!control.ready() || !softwareI2cProviderBufferSafe(presence.buffer(),32)) return false
    val start=presence.buffer().addressValue()
    val record=control.buffer().addressValue()
    return start+32 <= record || start >= record+64
}
trusted fun coreMatrixStartupInputs(owner: int): int = M5CoreMatrixControl(owner).pmic().configureCoreMatrixPm1Inputs()|0
trusted fun coreMatrixStartupIrq(): int = m5BoardCoreMatrix.configureCoreMatrixIrqInputOwned(true)
trusted fun coreMatrixStartupChargeSense(owner: int): bool =
    M5Ioe1(M5CoreMatrixControl(owner).expanders().device(0)|0).setDirection(7,false)
trusted fun coreMatrixStartupPresence(owner: int,presence: Pm1BatteryPresence,now: int): int {
    val control=M5CoreMatrixControl(owner)
    return presence.updateBoard(m5BoardCoreMatrix,control.pmic().pm1(),M5Ioe1(control.expanders().device(0)|0),now)
}
trusted fun coreMatrixStartupSd(owner: int): int = M5CoreMatrixControl(owner).expanders().configureCoreMatrixSdPower()|0
// Requires live control owner, fresh independent presence state, owned GPIO2,
// disarmed wake/LP users and pinned LP IO clock in addition to session clocks.
// Ready covers these power phases, not display/audio/IMU/SD protocol startup.
trusted fun M5CoreMatrixControl.configurePowerOwned(presence: Pm1BatteryPresence,now: int,exclusiveWakeDisarmed: bool): M5CoreMatrixStartup =
    m5CoreMatrixStartupOwned(this|0,presence,now,exclusiveWakeDisarmed)
