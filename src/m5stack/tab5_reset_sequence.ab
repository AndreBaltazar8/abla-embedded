import "../i2c/software_lines.ab"
import "../i2c/results.ab"
import "../esp32/sdk/raw_buffer.ab"
// Tab5 PI4@0x43: LCD reset bit4, touch reset bit5. GPIO23 high selects GT911
// address0x14; release to input after reset. M5GFX holds low10ms, settles100ms.
// Caller owns stopped display/touch, GPIO23, reset pins, prepared I2C and scratch.
// Board supplies already configured: this is NOT whole-board power setup.
// Preserve every unrelated expander bit. No rollback after a partial reset;
// retain resources, diagnose the failed stage and restart reset explicitly.
// Low8:1complete,2invalid,3preflightread,4GPIOselect,5assert,6direction,
// 7driver,8release,9GPIOinput. Failed register-stage includes register inbits8+.
trusted fun tab5DisplayTouchResetOwned(bus: SoftwareI2cLines,scratch: NativeBuffer): int {
    if (!bus.valid() || bus.sda() != 31 || bus.scl() != 32 || !scratch.hasAddressRange(0,1)) return 2
    val latch=tab5ResetRead(bus,5,scratch)
    if (!latch.valid()) return 3|(5<<8)
    val direction=tab5ResetRead(bus,3,scratch)
    if (!direction.valid()) return 3|(3<<8)
    val impedance=tab5ResetRead(bus,7,scratch)
    if (!impedance.valid()) return 3|(7<<8)
    if (!tab5ResetSelectAddress(true)) return 4
    val asserted=latch.value()&207
    if (!tab5ResetWrite(bus,5,asserted,scratch)) return 5|(5<<8)
    val checkedLow=tab5ResetRead(bus,5,scratch)
    if (!checkedLow.valid() || checkedLow.value() != asserted) return 5|(5<<8)
    val outputs=direction.value()|48
    if (!tab5ResetWrite(bus,3,outputs,scratch)) return 6|(3<<8)
    val checkedDirection=tab5ResetRead(bus,3,scratch)
    if (!checkedDirection.valid() || checkedDirection.value() != outputs) return 6|(3<<8)
    val driven=impedance.value()&207
    if (!tab5ResetWrite(bus,7,driven,scratch)) return 7|(7<<8)
    val checkedDriver=tab5ResetRead(bus,7,scratch)
    if (!checkedDriver.valid() || checkedDriver.value() != driven) return 7|(7<<8)
    tab5ResetDelay(10)
    val released=latch.value()|48
    if (!tab5ResetWrite(bus,5,released,scratch)) return 8|(5<<8)
    val checkedHigh=tab5ResetRead(bus,5,scratch)
    if (!checkedHigh.valid() || checkedHigh.value() != released) return 8|(5<<8)
    if (!tab5ResetSelectAddress(false)) return 9
    tab5ResetDelay(100)
    return 1
}
