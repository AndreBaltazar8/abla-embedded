import "./i2c_pin_map.ab"
import "./speaker_profile.ab"
import "./microphone_profile.ab"
import "./touch_profile.ab"
import "./rtc_profile.ab"
// Static configuration only; constructors never probe, allocate or initialize.
// Existing peripheral owners retain all hardware startup/cleanup requirements.
// Tab5 touch requires panel/probe evidence: use boardId().touchProfileFromProbe
// with the separately imported tab5_touch_profile module; no guessed default.
type M5CoreP4X = int
fun m5CoreP4X(): M5CoreP4X = M5CoreP4X(31)
fun M5CoreP4X.boardId(): M5BoardId = m5BoardCoreP4X
fun M5CoreP4X.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5CoreP4X.speakerProfile(): M5SpeakerProfile = this.boardId().speakerProfile()
fun M5CoreP4X.microphoneProfile(): M5MicrophoneProfile = this.boardId().microphoneProfile()
fun M5CoreP4X.touchProfile(): M5TouchProfile = this.boardId().touchProfile()
fun M5CoreP4X.rtcKind(): M5RtcKind = this.boardId().rtcKind()
type M5Tab5 = int
fun m5Tab5(): M5Tab5 = M5Tab5(22)
fun M5Tab5.boardId(): M5BoardId = m5BoardTab5
fun M5Tab5.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5Tab5.speakerProfile(): M5SpeakerProfile = this.boardId().speakerProfile()
fun M5Tab5.microphoneProfile(): M5MicrophoneProfile = this.boardId().microphoneProfile()
fun M5Tab5.rtcKind(): M5RtcKind = this.boardId().rtcKind()
type M5Tab5X = int
fun m5Tab5X(): M5Tab5X = M5Tab5X(35)
fun M5Tab5X.boardId(): M5BoardId = m5BoardTab5X
fun M5Tab5X.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5Tab5X.speakerProfile(): M5SpeakerProfile = this.boardId().speakerProfile()
fun M5Tab5X.microphoneProfile(): M5MicrophoneProfile = this.boardId().microphoneProfile()
fun M5Tab5X.rtcKind(): M5RtcKind = this.boardId().rtcKind()
