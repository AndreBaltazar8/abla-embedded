import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
// Caller owns the complete board display lifecycle, live PM1 control, stable
// PLL80M/ROM timing, quiesced SPI2, all display pads with RTC/holds released,
// IOE/PWM users and canonical SPI gate. No concurrent display or bus client.
// Stage0 unused;1ready2admission3CS4backlight-off5power/reset6SPI7panel8clear9brightness.
// Underlying result (including SPI status/data) occupies48bits@8.
// Bit56 means the one attempted emergency backlight-off write ALSO failed.
// Failure retains all clock/pad/device ownership; no reset/retry/rail rollback.
type ChainCaptainDisplayStartup=int
fun ChainCaptainDisplayStartup.status(): int = this&255
fun ChainCaptainDisplayStartup.valid(): bool = this.status() == 1
fun ChainCaptainDisplayStartup.detail(): int = (this>>>8)&281474976710655
fun ChainCaptainDisplayStartup.backlightOffFailed(): bool = (this&(1<<56)) != 0
trusted fun chainCaptainDisplayStartupFailure(control: int,stage: int,detail: int,blank: bool): ChainCaptainDisplayStartup {
    val failed=blank && !chainDisplayBlank(control)
    return ChainCaptainDisplayStartup(stage|((detail&281474976710655)<<8)|(if (failed) 1<<56 else 0))
}
trusted fun chainCaptainDisplayStartupOwned(control: int,gate: PeripheralGate,owner: u32,
    reset: bool,rotation: int,brightness: int,exclusive: bool): ChainCaptainDisplayStartup {
    if (!exclusive || rotation < 0 || rotation > 7 || brightness < 0 || brightness > 255 ||
        !peripheralOwnerValid(owner) || !chainDisplayAdmission(control,gate)) return ChainCaptainDisplayStartup(2)
    if (!chainDisplaySelectInactive()) return ChainCaptainDisplayStartup(3)
    val off=chainDisplayPrepareOff(control)
    if ((off&255) != 1) return chainCaptainDisplayStartupFailure(control,4,off,true)
    val power=chainDisplayPower(control,reset)
    if ((power&255) != 1) return chainCaptainDisplayStartupFailure(control,5,power,false)
    val spi=chainDisplaySpi(gate,owner)
    if (!spi.valid()) return chainCaptainDisplayStartupFailure(control,6,spi|0,false)
    val panel=chainDisplayPanel(gate,owner,rotation)
    if (!panel.valid()) return chainCaptainDisplayStartupFailure(control,7,panel|0,false)
    val clear=chainDisplayClear(gate,owner,rotation)
    if (!clear.valid()) return chainCaptainDisplayStartupFailure(control,8,clear|0,false)
    if (!chainDisplayBrightness(control,brightness)) return chainCaptainDisplayStartupFailure(control,9,0,true)
    return ChainCaptainDisplayStartup(1)
}
