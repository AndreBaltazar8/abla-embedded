import "../esp32/i2s/stereo_microphone_dma_p4_sequence.ab"
// CoreP4X RX0 DATA5/WS4/BCLK6/MCLK2. Shared fixed24kHz stereo DMA setup.
trusted fun coreP4xPrepareMicrophoneDmaOwned(channel: int,descriptors: int,count: int,
    payload: int,stride: int,bytes: int,revision: int,polls: int,exclusive: bool): int =
    esp32p4PrepareStereoMicrophone24kDmaOwned(channel,descriptors,count,payload,stride,bytes,revision,polls,2,6,4,5,exclusive)
