import "./board_id.ab"
// Status1 complete,2 unsupported board/chip,3 invalid handle,4 invalid mask,
// 5 PMIC GPIO failure,6 USB GPIO failure,7 main EXTEN failure.
// Bits8..23 acknowledge completed ports; a failed write may still reach hardware.
type M5StationPowerResult = int
fun M5StationPowerResult.status(): int = this & 255
fun M5StationPowerResult.appliedPorts(): int = (this>>>8)&65535
fun M5StationPowerResult.valid(): bool = this.status() == 1
trusted fun M5BoardId.setStationPowerOwned(power: int,identity: int,ports: int,enabled: bool): M5StationPowerResult {
    if (this != m5BoardStation || identity != 3) return M5StationPowerResult(2)
    if (ports < 0 || (ports & ~32831) != 0) return M5StationPowerResult(4)
    if ((ports & 32799) != 0 && (power <= 0 || power > 4294967295)) return M5StationPowerResult(3)
    var applied=0
    var pin=0
    while (pin < 5) {
        val bit=1<<pin
        if ((ports & bit) != 0) {
            if (!stationPowerGpio(power,pin,enabled)) return M5StationPowerResult(5|(applied<<8))
            applied=applied|bit
        }
        pin=pin+1
    }
    if ((ports & 32) != 0) {
        if (!stationPowerUsb(enabled)) return M5StationPowerResult(6|(applied<<8))
        applied=applied|32
    }
    if ((ports & 32768) != 0) {
        if (!stationPowerMain(power,enabled)) return M5StationPowerResult(7|(applied<<8))
        applied=applied|32768
    }
    M5StationPowerResult(1|(applied<<8))
}
