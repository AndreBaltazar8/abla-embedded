import "./pm1_presence.ab"
import "./pm1_battery_sequence.ab"
@inline
trusted fun pm1PresenceWriteCharge(handle: int,enabled: bool): bool = M5Pm1(handle).setBatteryCharge(enabled)
trusted fun Pm1BatteryPresence.readBattery(board: M5BoardId,pm1: M5Pm1,ioe: M5Ioe1,now: int): Pm1BatteryReading =
    this.readBatteryOwned(board,pm1 | 0,ioe | 0,now)
trusted fun Pm1BatteryPresence.setCharging(board: M5BoardId,pm1: M5Pm1,enabled: bool,now: int): bool =
    this.setChargingOwned(board,pm1 | 0,enabled,now)
