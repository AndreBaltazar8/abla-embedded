import "./expander_owner_view.ab"
import "./expander_open_sequence.ab"
trusted fun M5Expanders.initialize(): bool {
    if (!this.buffer().hasAddressRange(0,32) || (this.buffer().addressValue() & 3) != 0) return false
    var offset=4
    while (offset < 32) { this.buffer().storeU32(offset,0); offset=offset+4 }
    this.buffer().storeU32(0,0x494F4532)
}
trusted fun M5Expanders.storeSlot(index: int,value: M5ExpanderOpen): void {
    if (!this.valid() || index < 0 || index > 1) return
    val offset=16+index*8
    this.buffer().storeU32(offset,value & 4294967295)
    this.buffer().storeU32(offset+4,value>>>32)
    return
}
trusted fun M5Expanders.openOwned(bus: int,board: M5BoardId): int {
    if (this.status() != 0 || this.slot(0).deviceHandle() != 0 || this.slot(1).deviceHandle() != 0) return -1
    this.buffer().storeU32(8,board | 0)
    this.buffer().storeU32(12,0)
    val first=board.openExpanderOwned(bus,0)
    this.storeSlot(0,first)
    var failure=if (first.ready()) 0 else first.status()
    if (failure == 0 && board.expanderProfile(1) != 0) {
        val second=board.openExpanderOwned(bus,1)
        this.storeSlot(1,second)
        if (!second.ready()) {
            failure=second.status()
            // Second open already tried its own cleanup. Release the first
            // once, retaining either failed close for the caller's retry.
            this.storeSlot(0,first.releaseOwned())
        }
    }
    this.buffer().storeU32(12,failure)
    val status=if (failure == 0) 1 else if (this.slot(0).ownsDevice() || this.slot(1).ownsDevice()) 6 else failure
    this.buffer().storeU32(4,status)
    status
}
trusted fun M5Expanders.closeOwned(): bool {
    if (!this.valid()) return false
    // Attempt both even if one close fails. Successfully released slots are
    // never retried; the bus and all other devices remain caller-owned.
    this.storeSlot(1,this.slot(1).releaseOwned())
    this.storeSlot(0,this.slot(0).releaseOwned())
    val success=!this.slot(0).ownsDevice() && !this.slot(1).ownsDevice()
    this.buffer().storeU32(4,if (success) 0 else 6)
    success
}
