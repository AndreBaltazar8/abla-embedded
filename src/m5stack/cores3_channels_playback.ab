import "./cores3_playback.ab"

// Bounded playback window:1..4095 blocks of240 stereo frames, then drain and
// shut down DMA/amplifier. Works with finite queues or endless sources.
// Preserves channel cursors after the window; tail silence never consumes them.
// On failure cursors describe rendered/queued data, NOT audible completion;
// result.bytes reports DMA-completed bytes. No implicit rewind after failure.
// Caller owns powered/stopped/exclusive hardware, bank and disjoint workspaces.
trusted fun cores3PlaybackChannels(amplifier: Aw88298,expander: Aw9523,channel: int,
    descriptors: int,buffers: int,bank: PcmChannels,blocks: int,staging: NativeBuffer,
    accumulator: NativeBuffer,scratch: NativeBuffer,owner: u32,idlePollsPerBlock: int,
    masterGainQ15: int=32768): CoreS3PlaybackResult =
    cores3PlaybackBlocks(amplifier,expander,channel,descriptors,buffers,bank.storage(),blocks,
        staging,owner,idlePollsPerBlock,PcmWav(0),PcmWavMix(0),accumulator,scratch,masterGainQ15,0,bank)
