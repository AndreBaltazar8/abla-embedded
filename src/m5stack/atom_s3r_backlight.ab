import "./board_id.ab"
// M5GFX Light_M5StackAtomS3R sequence, controller address0x30. Internal
// I2C uses SDA45/SCL0; caller supplies that live owned bus. No GPIO/PWM fallback
// on this board and no claim that AtomS3's GPIO16 backlight uses this chip.
trusted fun M5BoardId.openAtomS3RBacklight(bus: I2cBus): I2cDevice =
    if (this == m5BoardAtomS3R && bus.valid()) bus.device(48,400000) else I2cDevice(0)
// Caller owns this controller (not just the bus transaction) across all writes
// and the1ms delay. Device must be the handle opened above. Status low8:
//1complete3invalid4I/O; successful write count in bits8+. NACK may mean the
// last write committed: retain ownership/partial-state evidence on failure.
// No blind retry or forced success. Initialization affects controller settings.
trusted fun atomS3RBacklightBeginOwned(device: I2cDevice,brightness: int,exclusive: bool): int {
    if (!exclusive || !device.valid() || brightness < 0 || brightness > 255) return 3
    if (!device.writeRegister8(0,64)) return 4
    peripheralDelayMilliseconds(1)
    if (!device.writeRegister8(8,1)) return 4|(1<<8)
    if (!device.writeRegister8(0x70,0)) return 4|(2<<8)
    if (!device.writeRegister8(0x0e,brightness)) return 4|(3<<8)
    return 1|(4<<8)
}
// Initialized exclusively retained controller only. Linear0..255 curve exactly
// as upstream; brightness0 blanks without releasing power/controller ownership.
trusted fun atomS3RBacklightSetOwned(device: I2cDevice,brightness: int,exclusive: bool): int {
    if (!exclusive || !device.valid() || brightness < 0 || brightness > 255) return 3
    return if (device.writeRegister8(0x0e,brightness)) 1 else 4
}
