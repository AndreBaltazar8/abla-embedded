import "../power/pm1_battery_presence.ab"
import "abla/runtime/scalar"
// Checked orchestration of Power.begin phases. Transport/driver owners stay
// live on failure. The caller serializes the full sequence and retains pad
// ownership even after a failed handoff; no rollback or IRQ acknowledgement.
// Status1complete2admission3PM1inputs4ESPirq5chargeSense6SDpower.
// Detail16bits@8 stores lower operation result. Presence+1 in bits24..25:
// 0unknown,1absent,2present. Unknown is a valid nonblocking observation.
type M5CoreMatrixStartup=int
fun M5CoreMatrixStartup.status(): int = this&255
fun M5CoreMatrixStartup.valid(): bool = this.status() == 1
fun M5CoreMatrixStartup.detail(): int = (this>>>8)&65535
fun M5CoreMatrixStartup.presence(): int = ((this>>>24)&3)-1
trusted fun m5CoreMatrixStartupOwned(owner: int,presence: Pm1BatteryPresence,now: int,exclusiveWakeDisarmed: bool): M5CoreMatrixStartup {
    if (!exclusiveWakeDisarmed || now < 0 || now > 4294967295 ||
        !presence.valid() || !coreMatrixStartupAdmission(owner,presence)) return M5CoreMatrixStartup(2)
    val inputs=coreMatrixStartupInputs(owner)
    if ((inputs&255) != 1) return M5CoreMatrixStartup(3|((inputs&65535)<<8))
    val irq=coreMatrixStartupIrq()
    if (irq != 1) return M5CoreMatrixStartup(4|((irq&65535)<<8))
    if (!coreMatrixStartupChargeSense(owner)) return M5CoreMatrixStartup(5)
    val observed=coreMatrixStartupPresence(owner,presence,now)
    val battery=(observed+1)<<24
    val sd=coreMatrixStartupSd(owner)
    if ((sd&255) != 1) return M5CoreMatrixStartup(battery|6|((sd&65535)<<8))
    return M5CoreMatrixStartup(battery|1)
}
