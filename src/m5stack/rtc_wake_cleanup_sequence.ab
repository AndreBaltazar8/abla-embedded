import "./rtc_profile.ab"
// Completed bits0..2: RTC,PMIC wake source,PMIC IRQ status. Required bits4..6;
// bit8 marks an accepted operation. Preserve partial results for retry/reporting.
type M5RtcCleanupResult = int
fun M5RtcCleanupResult.valid(): bool = (this>>>8) == 1 &&
    (this & 136) == 0 && (((this>>>4) & 7) == 1 || ((this>>>4) & 7) == 7) &&
    ((this & 7) & ~((this>>>4) & 7)) == 0
fun M5RtcCleanupResult.completed(): int = this & 7
fun M5RtcCleanupResult.required(): int = (this>>>4) & 7
fun M5RtcCleanupResult.success(): bool = this.valid() && this.completed() == this.required()
fun M5BoardId.rtcNeedsPmicCleanup(): bool = this == m5BoardPaperMono || this == m5BoardToughC5
// Caller has selected the board's actual M5PM1, not a global/default PMIC.
// Validate before mutation. Try every required cleanup even if an earlier I2C
// operation fails, matching upstream ordering while preserving failure details.
trusted fun m5RtcCleanupOwned(board: M5BoardId,rtc: int,pmic: int,disable: bool): M5RtcCleanupResult {
    val needsPmic=board.rtcNeedsPmicCleanup()
    if (!m5RtcCleanupRtcValid(rtc) || (needsPmic && !m5RtcCleanupPmicValid(pmic))) return M5RtcCleanupResult(0)
    m5RtcFinishCleanup(board,m5RtcCleanupRtc(rtc,disable),pmic)
}
// Shared post-operation cleanup: never clear the newly configured RTC timer.
// Caller already validated handles before changing hardware.
trusted fun m5RtcFinishCleanup(board: M5BoardId,rtcSucceeded: bool,pmic: int): M5RtcCleanupResult {
    val needsPmic=board.rtcNeedsPmicCleanup()
    var done=if (rtcSucceeded) 1 else 0
    if (needsPmic) {
        if (m5RtcCleanupWake(pmic)) done=done | 2
        if (m5RtcCleanupPmicIrq(pmic)) done=done | 4
    }
    M5RtcCleanupResult(256 | ((if (needsPmic) 7 else 1)<<4) | done)
}
