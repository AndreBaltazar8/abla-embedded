import "../display/ssd1677_session.ab"
import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
// Fresh64B session record, fully initialized96000B drawing buffer and separate
// history storage. Own PM1PWM/GPIO3 plus stopped display/touch/SD and all pads.
// Low8:1ready2admission3light-off4panel-startup5session6refresh7light-on;
// original detailed failure above8. Session remains published on any I/O error.
// Final light-on failure preserves successfully refreshed session/history.
trusted fun paperMonoDisplayStartupOwned(control: int,r: NativeBuffer,canvas: NativeBuffer,history: NativeBuffer,
    gate: PeripheralGate,owner: u32,mode: int,brightness: int,polls: int,exclusive: bool): int {
    if (!exclusive || owner == u32(0) || mode < 1 || mode > 4 || brightness < 0 || brightness > 255 ||
        polls < 1 || polls > 10000 || !ssd1677SessionStorageSafe(r,canvas,history) || r.loadU32(0) != 0 ||
        !paperMonoDisplayStorageAdmission(control,r,canvas,history,gate)) return 2
    val session=ssd1677SessionOpenOwned(r,canvas,history,false,true)
    if (session == 0) return 5
    // Pending startup cannot be refreshed externally. Keep it faulted until
    // physical reset/controller initialization has actually completed.
    r.storeU32(4,2)
    var result=1
    val dark=paperMonoDisplayFrontlight(control,0,true)
    if (dark != 1) result=3|(dark<<8)
    if (result == 1) {
        val panel=paperMonoDisplayPanelStartup(control,gate,owner,polls)
        if (panel != 1) result=4|(panel<<8)
        else { r.storeU32(4,1);r.storeU32(24,1) }
    }
    if (result == 1) {
        val refreshed=paperMonoDisplayRefresh(session,gate,owner,mode,polls)
        if (!refreshed.valid()) {
            result=6|((refreshed|0)<<8)
            r.storeU32(4,2);r.storeU32(24,0)
        }
    }
    if (result == 1) {
        val lit=paperMonoDisplayFrontlight(control,brightness,false)
        if (lit != 1) result=7|(lit<<8)
    }
    r.storeU32(56,result&4294967295);r.storeU32(60,result>>>32)
    return result
}
