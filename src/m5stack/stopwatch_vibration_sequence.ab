import "./vibration_sequence.ab"
// Ready board ownership includes startup's disabled motor and shared PWM
// frequency2000Hz. Other IOE PWM users must coordinate the shared frequency.
// Status7 frequency read failed,8 frequency changed; no enable writes follow.
// Off deliberately skips the frequency read, so a changed/shared domain does
// not prevent an explicit stop. Failures retain caller motor ownership.
trusted fun stopWatchVibrationOwned(control: int,level: int,exclusive: bool): M5VibrationResult {
    if (!exclusive || level < 0 || level > 255) return M5VibrationResult(3)
    val handle=stopWatchVibrationHandle(control)
    if (!m5VibrationHandleValid(handle)) return M5VibrationResult(3)
    if (level != 0) {
        val frequency=stopWatchVibrationFrequency(handle)
        if (frequency < 0) return M5VibrationResult(7)
        if (frequency != 2000) return M5VibrationResult(8)
    }
    return m5BoardStopWatch.setExpanderVibrationOwned(handle,level)
}
