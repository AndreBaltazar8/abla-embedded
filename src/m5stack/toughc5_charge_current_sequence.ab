import "./board_id.ab"
// Lowbyte status:1success,2unsupportedboard,3invalidhandle,4unachievablelimit,
// 5pullfailure,6latchfailure,7driverfailure,8directionfailure. Highbits selected
// milliamps only on success. Failure can leave partial pinconfiguration.
type M5ChargeCurrentResult = int
fun M5ChargeCurrentResult.status(): int = this & 255
fun M5ChargeCurrentResult.valid(): bool = this.status() == 1
fun M5ChargeCurrentResult.milliamps(): int = if (this.valid()) this>>>8 else 0
trusted fun M5BoardId.setToughChargeCurrentOwned(ioe: int,maxMilliamps: int): M5ChargeCurrentResult {
    if (this != m5BoardToughC5) return M5ChargeCurrentResult(2)
    if (ioe <= 0 || ioe > 4294967295) return M5ChargeCurrentResult(3)
    // Do not silently exceed a requested maximum below the minimum setting.
    if (maxMilliamps < 180) return M5ChargeCurrentResult(4)
    val low=maxMilliamps < 830
    if (!toughChargePullNone(ioe)) return M5ChargeCurrentResult(5)
    if (!toughChargeLatch(ioe,low)) return M5ChargeCurrentResult(6)
    if (!toughChargePushPull(ioe)) return M5ChargeCurrentResult(7)
    if (!toughChargeOutput(ioe)) return M5ChargeCurrentResult(8)
    M5ChargeCurrentResult(1|((if (low) 180 else 830)<<8))
}
