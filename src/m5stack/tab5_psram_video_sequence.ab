import "../esp32/sdk/raw_buffer.ab"
// Borrow a verified PSRAM range for polling/service-gated video. NO IRQ
// installation here; if callers attach sources they must detach/join them
// before returning memory. Caller excludes concurrent owner/frame mutation.
// PSRAM phase8 means lent to video: generic memory close/verify refuse it.
// While lent, memory word20 stores the borrowing DSI owner address, not error.
// Never bypass these leases via raw AXI/MMU/clock APIs.
trusted fun Tab5DsiOwner.startPsramVideoOwned(memory: NativeBuffer,channel: int,descriptor: NativeBuffer,polls: int): int {
    if (!p4PsramMemoryStorage(memory) || memory.loadU32(0) != 0x50344d45 || memory.loadU32(4) != 4 ||
        !this.panelReady() || !this.videoBufferSafe(memory,88) || channel < 0 || channel > 3 || polls < 1 || polls > 1000000) return 2
    val address=memory.loadU32(8); val bytes=memory.loadU32(12); val line=memory.loadU32(16)
    if (address < 0x48000000 || address >= 0x4c000000 || (address&65535) != 0 || bytes < 1843200 ||
        bytes > 0x4c000000-address || (bytes&65535) != 0 || (line != 64 && line != 128)) return 2
    val frame=nativeBufferAt(address,1843200)
    val d=descriptor.addressValue(); val m=memory.addressValue()
    if (!this.videoBufferSafe(descriptor,64) || !this.videoBufferSafe(frame,1843200) || !tab5OwnedVideoBuffersValid(descriptor,frame,line) ||
        (d < m+88 && m < d+64)) return 2
    memory.storeU32(20,this.buffer().addressValue()); memory.storeU32(4,8)
    val result=this.startVideoOwned(channel,descriptor,frame,line,polls)
    // Invalid before transition did not acquire video resources. All other
    // failures keep the loan until checked stop confirms DMA is drained.
    if (result == 2 && this.panelReady()) { memory.storeU32(4,4); memory.storeU32(20,0) }
    return result
}
trusted fun Tab5DsiOwner.stopPsramVideoOwned(memory: NativeBuffer,gate: int,polls: int): int {
    if (!p4PsramMemoryStorage(memory) || memory.loadU32(0) != 0x50344d45 || memory.loadU32(4) != 8 ||
        memory.loadU32(20) != this.buffer().addressValue() || !this.videoBufferSafe(memory,88) ||
        gate <= 0 || gate > 4294967292 || (gate&3) != 0 || (gate < memory.addressValue()+88 && memory.addressValue() < gate+4)) return 2
    val stopped=this.stopVideoOwned(gate,polls)
    if ((stopped&255) == 1 && (stopped&32768) != 0) {
        // Verification remains evidence for the same mapping; caller may
        // now mutate or close it after excluding any remaining consumers.
        memory.storeU32(4,4); memory.storeU32(20,0)
    }
    return stopped
}
