import "./board_id.ab"
// M5IOE1 enum labels are one-based: gpio5=bit4, gpio2=bit1.
// PI4 pin numbers below are already zero-based and must not be decremented.
// Lowbyte status1complete,2unsupported,3invalidhandle,4invalidmask,
// 5pullfailure,6driverfailure,7directionfailure,8latchfailure.
// Bits8..23 acknowledged ports; failed operations may leave partial state.
type M5ExpanderPowerResult = int
fun M5ExpanderPowerResult.status(): int = this & 255
fun M5ExpanderPowerResult.appliedPorts(): int = (this>>>8)&65535
fun M5ExpanderPowerResult.valid(): bool = this.status() == 1
// mode1 M5IOE output,2 PI4 pull+latch,3 PI4 output,4 PI4 latch only.
trusted fun expanderPowerApply(handle: int,pin: int,mode: int,enabled: bool): int {
    if (mode == 2) {
        if (!expanderPowerPull(handle,pin,enabled)) return 5
    } else if (mode != 4) {
        if (!expanderPowerDrive(handle,pin,mode == 1)) return 6
        if (!expanderPowerDirection(handle,pin,mode == 1)) return 7
    }
    if (!expanderPowerLatch(handle,pin,mode == 1,enabled)) return 8
    1
}
trusted fun M5BoardId.setExpanderPowerOwned(ioe0: int,ioe1: int,ports: int,enabled: bool): M5ExpanderPowerResult {
    val tab=this == m5BoardTab5 || this == m5BoardTab5X
    val core=this == m5BoardCoreP4X || this == m5BoardCoreMatrix
    val nesso=this == m5BoardArduinoNessoN1
    if (!tab && !core && !nesso) return M5ExpanderPowerResult(2)
    val allowed=if (this == m5BoardTab5X) 289 else if (this == m5BoardTab5 || this == m5BoardCoreP4X) 33 else 1
    if (ports < 0 || (ports & ~allowed) != 0) return M5ExpanderPowerResult(4)
    val needs1=(nesso && ports != 0) || (tab && (ports & 32) != 0)
    val needs0=!nesso && (if (tab) (ports & 257) != 0 else ports != 0)
    if ((needs0 && (ioe0 <= 0 || ioe0 > 4294967295)) || (needs1 && (ioe1 <= 0 || ioe1 > 4294967295))) return M5ExpanderPowerResult(3)
    var completed=0
    if ((ports & 1) != 0) {
        val status=expanderPowerApply(if (nesso) ioe1 else ioe0,if (core) 4 else 2,
            if (core) 1 else if (nesso) 4 else 2,enabled)
        if (status != 1) return M5ExpanderPowerResult(status)
        completed=1
    }
    if ((ports & 256) != 0) {
        val status=expanderPowerApply(ioe0,3,3,enabled)
        if (status != 1) return M5ExpanderPowerResult(status|(completed<<8))
        completed=completed|256
    }
    if ((ports & 32) != 0) {
        val status=expanderPowerApply(if (tab) ioe1 else ioe0,if (tab) 3 else 1,if (tab) 2 else 1,enabled)
        if (status != 1) return M5ExpanderPowerResult(status|(completed<<8))
        completed=completed|32
    }
    M5ExpanderPowerResult(1|(completed<<8))
}
