import "./nesso_touch_c6_bindings.ab"
import "../input/touch_frame.ab"
// Caller serializes display, touch, tracker and29B snapshot for the entire
// call. Tracker coordinates follow the current confirmed display rotation;
// reset the tracker before changing rotation during an active gesture.
// Return0..5 fresh contacts, -1 invalid/read failure, -2 unstable,
// -3 throttled/no report, -4 malformed coordinates/IDs. Negative returns
// leave the tracker unchanged: only a successful empty report releases.
trusted fun NessoDisplay.pollTouchTrackerOwned(bus: int,touch: TouchControllerOpen,tracker: TouchTracker,
    snapshot: NativeBuffer,now: int,exclusive: bool): int {
    if (!exclusive || !this.ready() || !touch.ready() || touch.kind() != 1 || !nessoTouchBusCurrent(bus) ||
        tracker <= 0 || tracker > 4294967296-touchTrackerBytes || !snapshot.hasAddressRange(0,29)) return -1
    val trackerStorage=nativeBufferAt(tracker|0,touchTrackerBytes)
    val a=snapshot.addressValue();val parent=this.buffer().addressValue()
    if ((a < tracker+touchTrackerBytes && tracker < a+29) ||
        (parent < tracker+touchTrackerBytes && tracker < parent+40) ||
        !softwareI2cProviderBufferSafe(trackerStorage,touchTrackerBytes) ||
        !this.gate().bufferDisjoint(trackerStorage,touchTrackerBytes)) return -1
    if (touchElapsedMilliseconds(now,tracker.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) return -3
    val count=this.readTouchOwned(bus,touch,snapshot,true)
    if (count < 0) return count
    val points=nativeBufferAt(nativeStackAllocate(40),40)
    var index=0
    while (index < count) {
        val point=nessoTouchPoint(snapshot,count,index,this.rotation())
        if (!point.valid()) return -4
        points.storeU32(index*8,point&0xffffffff);points.storeU32(index*8+4,point>>>32)
        index=index+1
    }
    if (tracker.updateControllerFrame(points,count,now) < 0) return -4
    return count
}
