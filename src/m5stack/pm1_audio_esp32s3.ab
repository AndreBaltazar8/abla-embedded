import "./pm1_control_esp32s3.ab"
import "./ioe1_es8311_speaker_esp32s3.ab"
import "./es8311_microphone_esp32s3.ab"
import "./pm1_audio_sequence.ab"
import "./pm1_audio_storage_s3_logic.ab"
trusted fun pm1BoardAudioAdmission(control: int): bool {
    val c=M5Pm1Control(control)
    return c.ready() && (c.board() == m5BoardStopWatch || c.board() == m5BoardChainCaptain)
}
trusted fun pm1BoardAudioBus(control: int): int = M5Pm1Control(control).bus()
trusted fun pm1BoardAudioBoard(control: int): M5BoardId = M5Pm1Control(control).board()
trusted fun pm1BoardAudioExpander(control: int): M5Ioe1 = M5Ioe1(M5Pm1Control(control).expanders().device(0)|0)
trusted fun pm1BoardAudioAllocate(bus: int): Es8311 = es8311(I2cBus(bus),24,100000)
// Caller serializes device-pool/control lifecycle, as for board ownership.
trusted fun pm1BoardAudioCodecMatches(control: int,codec: Es8311): bool {
    val descriptor=esp32S3I2cDevicePool().resolve(codec|0)
    return pm1AudioCodecDescriptorMatches(descriptor,pm1BoardAudioBus(control))
}
trusted fun M5Pm1Control.openAudioCodecOwned(exclusive: bool): Es8311 = pm1BoardAudioOpenOwned(this|0,exclusive)
trusted fun M5Pm1Control.speakerOwned(codec: Es8311,enabled: bool,exclusive: bool): int = pm1BoardSpeakerOwned(this|0,codec,enabled,exclusive)
trusted fun M5Pm1Control.microphoneOwned(codec: Es8311,enabled: bool,exclusive: bool): int = pm1BoardMicrophoneOwned(this|0,codec,enabled,exclusive)
