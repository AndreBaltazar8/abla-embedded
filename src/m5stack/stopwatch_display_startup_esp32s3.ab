import "./stopwatch_display_esp32s3.ab"
import "./stopwatch_spi_esp32s3.ab"
import "./stopwatch_draw_esp32s3.ab"
import "./stopwatch_display_startup_sequence.ab"
import "../esp32/gpio/snapshot_esp32s3.ab"
import "../esp32/gpio/input_s3_sequence.ab"
import "../hal/m5stack.ab"
import "../hal/m5stack_3.ab"
import "../hal/spitransactionresult.ab"
// Upstream OLED TE38 input-pullup. Pad must be released from holds/other
// routes. This does not install an IRQ or claim a tear-free refresh deadline.
@export("stopWatchDisplayPrepareTe")
trusted fun stopWatchDisplayPrepareTeHook(): int = esp32S3GpioPrepareInputOwned(38,0,true)
@export("stopWatchDisplayAdmission")
trusted fun stopWatchDisplayAdmissionHook(control: int,gate: PeripheralGate): bool {
    val c=M5Pm1Control(control)
    val address=gate.word().address()
    if (!c.ready() || c.board() != m5BoardStopWatch || !gate.word().valid() ||
        address <= 0 || address > 4294967292 || !gate.bufferDisjoint(c.buffer(),72) ||
        !esp32S3I2cFacadeBufferSafe(nativeBufferAt(address,4),4,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return false
    return nativeAddressLoadU32(address,0) == 0
}
@export("stopWatchDisplayPower")
trusted fun stopWatchDisplayPowerHook(control: int): int = M5Pm1Control(control).prepareStopWatchDisplayOwned(true)
@export("stopWatchDisplaySpi")
trusted fun stopWatchDisplaySpiHook(gate: PeripheralGate,owner: u32): SpiTransactionResult = stopWatchSpiInitializeOwned(gate,owner,true)
@export("stopWatchDisplayPanel")
trusted fun stopWatchDisplayPanelHook(gate: PeripheralGate,owner: u32): SpiTransactionResult = stopWatchPanelBeginOwned(gate,owner)
@export("stopWatchDisplayRotation")
trusted fun stopWatchDisplayRotationHook(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult = stopWatchPanelRotationOwned(gate,owner,rotation)
@export("stopWatchDisplayClear")
trusted fun stopWatchDisplayClearHook(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult = stopWatchPanelClearOwned(gate,owner,rotation)
@export("stopWatchDisplayBrightness")
trusted fun stopWatchDisplayBrightnessHook(gate: PeripheralGate,owner: u32,brightness: int): SpiTransactionResult = stopWatchPanelBrightnessOwned(gate,owner,brightness)
trusted fun M5Pm1Control.initializeStopWatchDisplayOwned(gate: PeripheralGate,owner: u32,
    rotation: int,brightness: int,exclusive: bool): StopWatchDisplayStartup =
    stopWatchDisplayStartupOwned(this|0,gate,owner,rotation,brightness,exclusive)
