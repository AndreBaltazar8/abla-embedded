import "./stopwatch_display_esp32s3.ab"
import "./stopwatch_spi_esp32s3.ab"
import "./stopwatch_draw_esp32s3.ab"
import "./stopwatch_display_startup_sequence.ab"
import "../esp32/gpio/snapshot_esp32s3.ab"
import "../esp32/gpio/input_s3_sequence.ab"
// Upstream OLED TE38 input-pullup. Pad must be released from holds/other
// routes. This does not install an IRQ or claim a tear-free refresh deadline.
trusted fun stopWatchDisplayPrepareTe(): int = esp32S3GpioPrepareInputOwned(38,0,true)
trusted fun stopWatchDisplayAdmission(control: int,gate: PeripheralGate): bool {
    val c=M5Pm1Control(control)
    val address=gate.word().address()
    if (!c.ready() || c.board() != m5BoardStopWatch || !gate.word().valid() ||
        address <= 0 || address > 4294967292 || !gate.bufferDisjoint(c.buffer(),72) ||
        !esp32S3I2cFacadeBufferSafe(nativeBufferAt(address,4),4,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return false
    return nativeAddressLoadU32(address,0) == 0
}
trusted fun stopWatchDisplayPower(control: int): int = M5Pm1Control(control).prepareStopWatchDisplayOwned(true)
trusted fun stopWatchDisplaySpi(gate: PeripheralGate,owner: u32): SpiTransactionResult = stopWatchSpiInitializeOwned(gate,owner,true)
trusted fun stopWatchDisplayPanel(gate: PeripheralGate,owner: u32): SpiTransactionResult = stopWatchPanelBeginOwned(gate,owner)
trusted fun stopWatchDisplayRotation(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult = stopWatchPanelRotationOwned(gate,owner,rotation)
trusted fun stopWatchDisplayClear(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult = stopWatchPanelClearOwned(gate,owner,rotation)
trusted fun stopWatchDisplayBrightness(gate: PeripheralGate,owner: u32,brightness: int): SpiTransactionResult = stopWatchPanelBrightnessOwned(gate,owner,brightness)
trusted fun M5Pm1Control.initializeStopWatchDisplayOwned(gate: PeripheralGate,owner: u32,
    rotation: int,brightness: int,exclusive: bool): StopWatchDisplayStartup =
    stopWatchDisplayStartupOwned(this|0,gate,owner,rotation,brightness,exclusive)
