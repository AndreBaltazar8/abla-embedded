import "./core_s3_profile.ab"
import "./pin_map_shared.ab"
// Import with the selected S3 Pin backend (native facade provided separately).
// Maps only: shared display/audio/SD pins are not acquired or reconfigured.
// Connector labels do not imply that simultaneous peripheral use is safe.
fun M5CoreS3.portA(): M5PortPins = this.boardId().portA()
fun M5CoreS3.portB(): M5PortPins = this.boardId().portB()
fun M5CoreS3.portC(): M5PortPins = this.boardId().portC()
fun M5CoreS3.portD(): M5PortPins = this.boardId().portD()
fun M5CoreS3.portE(): M5PortPins = this.boardId().portE()
fun M5CoreS3.sdPins(): M5SdPinMap = this.boardId().sdPins()
fun M5CoreS3.mBusPin(position: int): Pin = this.boardId().mBusPin(position)
fun M5CoreS3.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5CoreS3.internalI2cData(): Pin = pin(this.i2cPins().internalData())
fun M5CoreS3.externalI2cClock(): Pin = pin(this.i2cPins().externalClock())
fun M5CoreS3.externalI2cData(): Pin = pin(this.i2cPins().externalData())
fun M5CoreS3SE.portA(): M5PortPins = this.boardId().portA()
fun M5CoreS3SE.portB(): M5PortPins = this.boardId().portB()
fun M5CoreS3SE.portC(): M5PortPins = this.boardId().portC()
fun M5CoreS3SE.portD(): M5PortPins = this.boardId().portD()
fun M5CoreS3SE.portE(): M5PortPins = this.boardId().portE()
fun M5CoreS3SE.sdPins(): M5SdPinMap = this.boardId().sdPins()
fun M5CoreS3SE.mBusPin(position: int): Pin = this.boardId().mBusPin(position)
fun M5CoreS3SE.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5CoreS3SE.internalI2cData(): Pin = pin(this.i2cPins().internalData())
fun M5CoreS3SE.externalI2cClock(): Pin = pin(this.i2cPins().externalClock())
fun M5CoreS3SE.externalI2cData(): Pin = pin(this.i2cPins().externalData())
