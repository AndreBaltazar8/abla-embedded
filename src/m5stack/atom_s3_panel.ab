import "./atom_gc9107.ab"
import "../display/mipi_programs.ab"
import "./atom_s3_panel_logic.ab"
// Caller owns powered/reset/configured pads and uses this same selection and
// rotation for every operation. Unknown IDs never fall back to a guessed LCD.
trusted fun AtomS3Panel.beginChecked(gate: PeripheralGate,owner: u32,rotation: int,halfPeriod: int = 1): SpiTransactionResult {
    val selected=this.internalRotation(rotation)
    if (selected < 0) return SpiTransactionResult(3<<32)
    val pins=this.pins()
    return softwareLcdBeginRgb565Checked(gate,owner,Pin(pins.clock()),Pin(pins.mosi()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),
        this.geometry(),selected,if (this.gc9107()) gc9107InitProgram() else st7735SInitProgram(),NativeBuffer(0),!this.gc9107(),true,halfPeriod)
}
trusted fun AtomS3Panel.fillRectChecked(gate: PeripheralGate,owner: u32,rotation: int,x: int,y: int,w: int,h: int,color: Rgb565,halfPeriod: int = 1): SpiTransactionResult {
    val view=this.view(rotation)
    if (!view.valid()) return SpiTransactionResult(3<<32)
    val pins=this.pins()
    return softwareLcdFillRectChecked(gate,owner,Pin(pins.clock()),Pin(pins.mosi()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),
        view,x,y,w,h,color,halfPeriod,false,this.gc9107() && (rotation&1) != 0)
}
trusted fun AtomS3Panel.blitChecked(gate: PeripheralGate,owner: u32,rotation: int,x: int,y: int,data: NativeBuffer,w: int,h: int,stride: int,
    littleEndian: bool = false,halfPeriod: int = 1): SpiTransactionResult {
    val view=this.view(rotation)
    if (!view.valid()) return SpiTransactionResult(3<<32)
    val pins=this.pins()
    return softwareLcdBlitRgb565Checked(gate,owner,Pin(pins.clock()),Pin(pins.mosi()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),
        view,x,y,data,w,h,stride,littleEndian,halfPeriod,false,this.gc9107() && (rotation&1) != 0)
}
