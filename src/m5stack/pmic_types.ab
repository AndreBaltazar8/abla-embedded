// Owned handle low32, detectedkind bits32..35, status40..47.
// Kind2 is confirmedAXP192 (not the profile's undecidedAXP candidate),3AXP2101,
// 4IP5306,5M5PM1,6AW32001. Status1ready,2unsupported,3invalidbus,
// 4allocationfailed,5beginfailed/released,6releasefailed/retained,7closed.
type M5PmicOpen = int
fun M5PmicOpen.status(): int = (this>>>40)&255
fun M5PmicOpen.kind(): int = (this>>>32)&15
fun M5PmicOpen.deviceHandle(): int = this & 4294967295
fun M5PmicOpen.ownsDevice(): bool = this.deviceHandle() != 0 && this.kind() >= 2 && this.kind() <= 6 &&
    (this>>>48) == 0 && ((this>>>36)&15) == 0 && (this.status() == 1 || this.status() == 6)
fun M5PmicOpen.ready(): bool = this.status() == 1 && this.ownsDevice()
