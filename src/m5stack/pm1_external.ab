import "./pm1_external_sequence.ab"
import "../power/m5pm1_device.ab"
import "../io_expander/m5ioe1_device.ab"
trusted fun pm1ExternalSetPin(handle: int,pin: int,enabled: bool): bool = M5Pm1(handle).setGpioOutput(pin,enabled)
trusted fun pm1ExternalSetRail(handle: int,enabled: bool): bool = M5Pm1(handle).setExtOutput(enabled)
trusted fun pm1ExternalLatch(handle: int): I2cByteResult = M5Pm1(handle).gpioOutputLatchBitsChecked()
trusted fun pm1ExternalBoost(handle: int,enabled: bool): bool = M5Ioe1(handle).digitalWrite(3,enabled)
// PA is the single external rail on non-Chain PM1 boards. Unsupported masks
// are rejected rather than silently ignored. No allocation or pin setup.
trusted fun M5BoardId.setPm1External(pm1: M5Pm1,ioe: M5Ioe1,ports: int,enabled: bool): M5ExternalPowerResult =
    this.setPm1ExternalOwned(pm1 | 0,ioe | 0,ports,enabled)
