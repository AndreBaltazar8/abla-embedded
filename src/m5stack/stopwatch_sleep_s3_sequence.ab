import "../display/co5300_program_sequence_esp32s3.ab"
// Display-only sleep/wake on initialized, powered panel and owned quad bus.
// Keep rails, GRAM, shadow/dirty state and rotation intact. Not CPU deep sleep.
// One gate covers both commands and wake settling. Sleep blanks then SLPIN;
// wake sends SLPOUT, waits150ms after actual completion, then restores explicit
// brightness. Caller serializes lifecycle with drawing/touch/board reset.
// Preserve all failure details: no retry on a faulted gate, no forced success.
trusted fun stopWatchPanelSleepOwned(gate: PeripheralGate,owner: u32,sleeping: bool,
    brightness: int,exclusive: bool): SpiTransactionResult {
    if (!exclusive || brightness < 0 || brightness > 255) return SpiTransactionResult(3<<32)
    val program=nativeBufferAt(nativeStackAllocate(8),8)
    if (sleeping) {
        program.store(0,81);program.store(1,1);program.store(2,0)
        program.store(3,16);program.store(4,0);program.store(5,255);program.store(6,255)
    } else {
        program.store(0,17);program.store(1,128);program.store(2,150)
        program.store(3,81);program.store(4,1);program.store(5,brightness)
        program.store(6,255);program.store(7,255)
    }
    return esp32s3Co5300RunProgram(gate,owner,2,quadSpiPins(40,41,42,46,45),Pin(39),
        nativeBufferAt(program.addressValue(),if (sleeping) 7 else 8))
}
