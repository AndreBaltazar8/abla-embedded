import "./board_id.ab"
import "../i2c/results.ab"
// Import the GPIO backend for the actual board. Pin remains a scalar.
fun M5BoardId.externalPowerEnablePin(): Pin = Pin(if (this == m5BoardPaper) 5 else -1)
fun M5BoardId.usbPowerEnablePin(): Pin = Pin(if (this == m5BoardStation) 12 else -1)
// Explicit preparation owns Paper GPIO5. Set the requested latch BEFORE
// enabling output, then enable input sampling for upstream gpio_in readback.
// Does not touch Paper's separate GPIO2 power-hold or any other supply.
trusted fun M5BoardId.preparePaperExternalOutput(enabled: bool): bool {
    if (this != m5BoardPaper) return false
    val p=this.externalPowerEnablePin()
    p.write(enabled)
    p.output()
    p.selectGpioFunction(true)
    true
}
// Caller has prepared the pin; success means the MMIO write was issued,
// not that external voltage or load current was physically verified.
trusted fun M5BoardId.setPaperExternalOutput(enabled: bool): bool {
    if (this != m5BoardPaper) return false
    this.externalPowerEnablePin().write(enabled)
    true
}
trusted fun M5BoardId.paperExternalOutputChecked(): I2cByteResult {
    if (this != m5BoardPaper) return I2cByteResult(0)
    I2cByteResult(256|(if (this.externalPowerEnablePin().read()) 1 else 0))
}
