import "./pmic_types.ab"
import "../power/charging_checked.ab"
// Explicit knownfalse vs unknown/failure. Lowbit boolean, status at8:
// 1known2invalid/notexclusive3board-specific/unsupported4I/O failure.
// No allocation, IRQ acknowledgement, rail change or charge configuration.
type M5PowerStateRead=int
fun M5PowerStateRead.status(): int = this>>>8
fun M5PowerStateRead.valid(): bool = this.status() == 1 && (this&255) <= 1
fun M5PowerStateRead.value(): bool = this.valid() && (this&1) != 0
trusted fun M5PmicOpen.readChargingOwned(exclusive: bool): M5PowerStateRead {
    if (!exclusive || !this.ready()) return M5PowerStateRead(2<<8)
    val kind=this.kind()
    if (kind == 5) return M5PowerStateRead(3<<8)
    val chargeKind=PowerChargeKind(if (kind < 5) kind-1 else 4)
    val result=I2cDevice(this.deviceHandle()).readChargingChecked(chargeKind)
    return if (result.valid()) M5PowerStateRead((1<<8)|result.value()) else M5PowerStateRead(4<<8)
}
// Presence bit exists on AXP192/2101. Other boards need their own monitor or
// GPIO/presence-cache policy; absence of a chip register is not battery absent.
trusted fun M5PmicOpen.readBatteryPresenceOwned(exclusive: bool): M5PowerStateRead {
    if (!exclusive || !this.ready()) return M5PowerStateRead(2<<8)
    if (this.kind() != 2 && this.kind() != 3) return M5PowerStateRead(3<<8)
    val result=I2cDevice(this.deviceHandle()).readBatteryPresentChecked(PowerChargeKind(this.kind()-1))
    return if (result.valid()) M5PowerStateRead((1<<8)|result.value()) else M5PowerStateRead(4<<8)
}
