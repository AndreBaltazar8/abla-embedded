import "./tab5_video_p4_sequence.ab"
import "./tab5_dsi_timing_esp32p4.ab"
import "../display/dpi_clock_esp32p4.ab"
import "../display/dsi_rgb_esp32p4.ab"
import "../display/dsi_bridge_dma_esp32p4.ab"
import "../display/dsi_frame_publish_esp32p4.ab"
import "../display/dsi_video_esp32p4.ab"
trusted fun p4Tab5VideoClock(plan: DpiClockPlan): int = esp32P4DpiClockStartOwned(plan)
trusted fun p4Tab5VideoTiming(panel: int,lane: int,dpi: int,polls: int): int = tab5DsiSetTimingsOwned(panel,lane,dpi,polls)|0
trusted fun p4Tab5VideoRgb(hw: int,vc: int,polls: int): int = esp32P4DsiConfigureRgbOwned(hw,720,16,16,vc,true,false,polls)|0
trusted fun p4Tab5VideoDmaConfig(): int = esp32P4DsiBridgeDmaConfigureOwned(720,1280,16,1)
trusted fun p4Tab5VideoBridge(): int = esp32P4DsiVideoBridgePrepareOwned()
trusted fun p4Tab5VideoPublish(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): int = esp32P4DsiFramePublishOwned(channel,descriptor,frame,1843200,line,polls)
trusted fun p4Tab5VideoStart(channel: int): int = esp32P4DsiVideoStartOwned(channel)
trusted fun tab5VideoOpen(panel: int,hwVersion: int,laneKbps: int,vc: int,dmaChannel: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): Tab5VideoStart = tab5VideoOpenOwned(panel,hwVersion,laneKbps,vc,dmaChannel,descriptor,frame,line,polls)
