import "./tab5_video_p4_sequence.ab"
import "./tab5_dsi_timing_esp32p4.ab"
import "../display/dpi_clock_esp32p4.ab"
import "../display/dsi_rgb_esp32p4.ab"
import "../display/dsi_bridge_dma_esp32p4.ab"
import "../display/dsi_frame_publish_esp32p4.ab"
import "../display/dsi_video_esp32p4.ab"
import "../hal/m5stack.ab"
import "../hal/m5stack_3.ab"
import "../display/dpi_clock_p4_logic.ab"
import "../display/dpi_clock_p4_sequence.ab"
import "./tab5_dsi_timing_sequence.ab"
import "../display/dsi_rgb_p4_sequence.ab"
import "../display/dsi_bridge_dma_p4_sequence.ab"
import "../display/dsi_video_p4_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../display/dsi_frame_publish_p4_sequence.ab"
import "../esp32/sdk/nativebuffer_type.ab"
@export("p4Tab5VideoClock")
trusted fun p4Tab5VideoClockHook(plan: DpiClockPlan): int = esp32P4DpiClockStartOwned(plan)
@export("p4Tab5VideoTiming")
trusted fun p4Tab5VideoTimingHook(panel: int,lane: int,dpi: int,polls: int): int = tab5DsiSetTimingsOwned(panel,lane,dpi,polls)|0
@export("p4Tab5VideoRgb")
trusted fun p4Tab5VideoRgbHook(hw: int,vc: int,polls: int): int = esp32P4DsiConfigureRgbOwned(hw,720,16,16,vc,true,false,polls)|0
@export("p4Tab5VideoDmaConfig")
trusted fun p4Tab5VideoDmaConfigHook(): int = esp32P4DsiBridgeDmaConfigureOwned(720,1280,16,1)
@export("p4Tab5VideoBridge")
trusted fun p4Tab5VideoBridgeHook(): int = esp32P4DsiVideoBridgePrepareOwned()
@export("p4Tab5VideoPublish")
trusted fun p4Tab5VideoPublishHook(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): int = esp32P4DsiFramePublishOwned(channel,descriptor,frame,1843200,line,polls)
@export("p4Tab5VideoStart")
trusted fun p4Tab5VideoStartHook(channel: int): int = esp32P4DsiVideoStartOwned(channel)
trusted fun tab5VideoOpen(panel: int,hwVersion: int,laneKbps: int,vc: int,dmaChannel: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): Tab5VideoStart = tab5VideoOpenOwned(panel,hwVersion,laneKbps,vc,dmaChannel,descriptor,frame,line,polls)
