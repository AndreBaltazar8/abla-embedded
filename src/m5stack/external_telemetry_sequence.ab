import "./board_id.ab"
import "../power/measurement.ab"
import "../i2c/results.ab"
// Checked integer units. Missing hardware/unsupported port/read failure is
// invalid, never a fabricated0. Multiple supported ports use upstream's
// first-match priority; negative/unknown masks are rejected before I/O.
fun M5BoardId.pm1ExternalTelemetrySource(ports: int): int {
    if (ports <= 0) return 0
    if (this == m5BoardChainCaptain) {
        if ((ports & ~7) != 0) return 0
        return if ((ports & 1) != 0) 1 else 2
    }
    if ((this == m5BoardStampS3Bat || this == m5BoardStopWatch || this == m5BoardStickS3) && ports == 1) return 2
    0
}
trusted fun M5BoardId.pm1ExternalMillivoltsCheckedOwned(handle: int,ports: int): PowerMeasurement {
    val source=this.pm1ExternalTelemetrySource(ports)
    if (source == 0 || handle <= 0 || handle > 4294967295) return PowerMeasurement(0)
    val raw=externalTelemetryPm1Read(handle,source)
    if (!raw.valid()) return PowerMeasurement(0)
    val mv=raw.value()
    powerMeasurement(mv+(if (this == m5BoardChainCaptain && mv >= 2000) 530 else 0))
}
fun M5BoardId.plcExternalTelemetrySupported(ports: int): bool =
    this == m5BoardStampPLC && ports > 0 && (ports & ~192) == 0
// INA226 bus voltage is unsigned1.25mV/count; truncate only after scaling.
fun m5PlcBusMillivolts(raw: I2cWordResult): PowerMeasurement =
    if (raw.valid()) powerMeasurement(raw.value()*5/4) else PowerMeasurement(0)
