import "./display_map.ab"
import "../display/gc9107_software.ab"
import "./atom_gc9107_map.ab"
// Borrowed configured pins/reset/power/backlight. No automatic pin takeover;
// AtomS3R backlight is not a GPIO and must use its own board driver.
trusted fun M5BoardId.beginGc9107DisplayChecked(gate: PeripheralGate,owner: u32,rotation: int,halfPeriod: int = 1): SpiTransactionResult {
    val pins=this.gc9107DisplayPins()
    if (!pins.available()) return SpiTransactionResult(3<<32)
    return gc9107BeginChecked(gate,owner,Pin(pins.clock()),Pin(pins.mosi()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),
        atomGc9107Geometry(),rotation,false,true,halfPeriod)
}
