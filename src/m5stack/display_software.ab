import "./display_map.ab"
import "../display/software_lcd.ab"

// Pure descriptor construction: does not configure pads, power, reset, or SD.
// Import alongside the selected GPIO and peripheral-delay backend. Keep every
// other SPI device deselected and use one shared bus gate for all clients.
@inline
fun M5BoardId.softwareDisplay(): SoftwareLcd {
    val pins = this.displaySpiPins()
    if (!pins.available()) return SoftwareLcd(0)
    softwareLcd(Pin(pins.clock()), Pin(pins.mosi()), Pin(pins.chipSelect()),
        Pin(pins.dataCommand()), this.displaySharedDataCommand())
}
