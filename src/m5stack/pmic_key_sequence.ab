import "./pmic_types.ab"
// Normalized event flags0..2 (click/hold/double), original observed bits8..15,
// status16..17:0unsupported/notready,1readfailed,2ackfailed,3consumed.
// Failed acknowledgement is NOT a new event: the IRQ may be observed again.
type M5PowerKeyRead = int
fun M5PowerKeyRead.status(): int = (this>>>16)&3
fun M5PowerKeyRead.valid(): bool = this.status() == 3
fun M5PowerKeyRead.observed(): int = (this>>>8)&255
fun M5PowerKeyRead.clicked(): bool = this.valid() && (this&1) != 0
fun M5PowerKeyRead.held(): bool = this.valid() && (this&2) != 0
fun M5PowerKeyRead.doubleClicked(): bool = this.valid() && (this&4) != 0
// M5Unified maps AXP code2 to click and other nonzero AXP codes to hold.
// PM1 code is always click when short/double IRQ present; retain double detail.
fun M5PowerKeyRead.compatibilityCode(): int = if (this.held()) 1 else if (this.clicked()) 2 else 0
trusted fun M5PmicOpen.readKeyOwned(): M5PowerKeyRead {
    if (!this.ready()) return M5PowerKeyRead(0)
    val kind=this.kind()
    if (kind == 2 || kind == 3) {
        val event=m5PmicKeyAxp(this.deviceHandle(),kind)
        val raw=event&255
        val status=(event>>>8)&3
        val flags=if (raw == 2) 1 else if (raw != 0) 2 else 0
        return M5PowerKeyRead((status<<16)|(raw<<8)|flags)
    }
    if (kind == 5) {
        val event=m5PmicKeyPm1(this.deviceHandle())
        val raw=event&5
        val status=if ((event&256) != 0) 3 else if (raw != 0) 2 else 1
        return M5PowerKeyRead((status<<16)|(raw<<8)|(if (raw != 0) 1 else 0)|(if ((raw&4) != 0) 4 else 0))
    }
    M5PowerKeyRead(0)
}
