import "./pmic_open_sequence.ab"
import "./axp_power.ab"
import "../power/ip5306_device.ab"
import "../power/m5pm1_device.ab"
import "../power/aw32001_device.ab"
trusted fun m5PmicBusValid(bus: int): bool = I2cBus(bus).valid()
trusted fun m5PmicAllocate(bus: int,address: int,hz: int): int = I2cBus(bus).device(address,hz) | 0
trusted fun m5PmicBegin(handle: int,kind: int): int {
    if (kind == 2 || kind == 3) {
        val identity=I2cDevice(handle).readRegister8Checked(3)
        if (!identity.valid()) return 0
        if (identity.value() == 74) return 3
        if (kind == 2 && identity.value() == 3) return 2
        return 0
    }
    val success=if (kind == 4) Ip5306(handle).begin() else if (kind == 5) M5Pm1(handle).begin() else Aw32001(handle).begin()
    if (success) kind else 0
}
trusted fun m5PmicClose(handle: int): bool = I2cDevice(handle).close()
// Bus stays caller-owned. Driver begin has its documented effects: IP5306
// reg6 sequence, PM1 IRQ config, AW32001 watchdogdisable; AXP onlyidentity.
// Ready means driver begun, NOT complete boardrail/ADC/charger configuration.
trusted fun M5BoardId.openPmic(bus: I2cBus): M5PmicOpen = this.openPmicOwned(bus | 0)
trusted fun M5PmicOpen.release(): M5PmicOpen = this.releaseOwned()
fun M5PmicOpen.device(): I2cDevice = I2cDevice(if (this.ready()) this.deviceHandle() else 0)
// Borrowed views; never independently close a view and thenrelease itsowner.
fun M5PmicOpen.axpPower(): M5AxpPower =
    if (!this.ready() || (this.kind() != 2 && this.kind() != 3)) M5AxpPower(0) else
    M5AxpPower(this.deviceHandle()|((if (this.kind() == 2) 3 else 74)<<32)|(5<<40))
fun M5PmicOpen.pm1(): M5Pm1 = M5Pm1(if (this.ready() && this.kind() == 5) this.deviceHandle() else 0)
fun M5PmicOpen.ip5306(): Ip5306 = Ip5306(if (this.ready() && this.kind() == 4) this.deviceHandle() else 0)
fun M5PmicOpen.aw32001(): Aw32001 = Aw32001(if (this.ready() && this.kind() == 6) this.deviceHandle() else 0)
