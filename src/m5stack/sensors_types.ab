import "./rtc_open_types.ab"
import "./imu_owner_types.ab"
// Serialized caller-owned72B: header32, embedded IMU owner36, padding4.
// Fresh storage only for initialize. Buses remain caller-owned and must outlive
// all borrowed device views. A failed cleanup retains ownership for close().
type M5Sensors = int
type M5SensorsBegin = int
fun m5SensorsAt(storage: NativeBuffer): M5Sensors = M5Sensors(if (storage.hasAddressRange(0,72) &&
    (storage.addressValue()&3) == 0) storage | 0 else 0)
fun M5Sensors.buffer(): NativeBuffer = NativeBuffer(this | 0)
fun M5Sensors.imu(): M5ImuOwner = m5ImuOwnerAt(nativeBufferAt(this.buffer().addressValue()+32,36))
trusted fun M5Sensors.valid(): bool = this.buffer().hasAddressRange(0,72) &&
    (this.buffer().addressValue()&3) == 0 && this.buffer().loadU32(0) == 0x53454E53 && this.imu().valid()
trusted fun M5Sensors.initialize(): bool {
    if (!this.buffer().hasAddressRange(0,72) || (this.buffer().addressValue()&3) != 0) return false
    var offset=0
    while (offset < 72) { this.buffer().storeU32(offset,0); offset=offset+4 }
    if (!this.imu().initialize()) return false
    this.buffer().storeU32(0,0x53454E53)
}
trusted fun M5Sensors.rtcResult(): M5RtcOpenResult = M5RtcOpenResult(if (this.valid())
    this.buffer().loadU32(8)|(this.buffer().loadU32(12)<<32) else 0)
trusted fun M5Sensors.storeRtc(value: M5RtcOpenResult): void {
    this.buffer().storeU32(8,value&0xFFFFFFFF); this.buffer().storeU32(12,value>>>32)
    return
}
// Result bits: ready RTC/IMU, external RTC/IMU, clock/IRQ success,
// retained RTC/IMU cleanup, clock/IRQ failure. Bit10 marks accepted begin.
fun M5SensorsBegin.valid(): bool = (this&1024) != 0
fun M5SensorsBegin.rtcReady(): bool = this.valid() && (this&1) != 0
fun M5SensorsBegin.imuReady(): bool = this.valid() && (this&2) != 0
fun M5SensorsBegin.portAUsed(): bool = this.valid() && (this&12) != 0
fun M5SensorsBegin.cleanupPending(): bool = this.valid() && (this&192) != 0
fun M5SensorsBegin.clockSynchronized(): bool = this.valid() && (this&16) != 0
fun M5SensorsBegin.irqDisabled(): bool = this.valid() && (this&32) != 0
trusted fun M5Sensors.result(): M5SensorsBegin = M5SensorsBegin(if (this.valid()) this.buffer().loadU32(16) else 0)
trusted fun M5Sensors.imuBoard(): M5BoardId = M5BoardId(if (this.result().imuReady() &&
    (this.result()&8) == 0) this.buffer().loadU32(24) else 0)
