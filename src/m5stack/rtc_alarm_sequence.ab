import "./rtc_wake_cleanup_sequence.ab"
import "../rtc/alarm_result.ab"
type M5RtcAlarmResult = int
fun M5RtcAlarmResult.alarm(): RtcAlarmResult = RtcAlarmResult(this>>>16)
fun M5RtcAlarmResult.cleanup(): M5RtcCleanupResult = M5RtcCleanupResult(this & 65535)
fun M5RtcAlarmResult.success(): bool = this.alarm().valid() && this.cleanup().success()
trusted fun m5RtcBoardAlarmOwned(board: M5BoardId,rtc: int,pmic: int,minute: int,hour: int,day: int,weekday: int): M5RtcAlarmResult {
    if (!m5RtcCleanupRtcValid(rtc) || (board.rtcNeedsPmicCleanup() && !m5RtcCleanupPmicValid(pmic)))
        return M5RtcAlarmResult(2<<16)
    val alarm=m5RtcConfigureAlarm(rtc,minute,hour,day,weekday)
    val cleanup=m5RtcFinishCleanup(board,alarm.valid(),pmic)
    M5RtcAlarmResult((alarm<<16) | cleanup)
}
