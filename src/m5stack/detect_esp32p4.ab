import "./detect_p4_sequence.ab"
import "../esp32/gpio_esp32p4.ab"
import "abla/unsafe/mmio"
import "../hal/m5stack.ab"
import "../esp32/gpio_p4_sequence.ab"
// P4 layouts 1/3: LP peripheral base50120000 + eFuse D000 + SYS2 4C.
// Read-only mirror access, never eFuse programming.
@export("m5P4ReadIdentity")
trusted fun m5P4ReadIdentityHook(): u32 = u32(mmioLoadU32(0x5012D04C))
@export("m5P4DetectReadPin")
trusted fun m5P4DetectReadPinHook(pin: int): int = esp32P4GpioReadOwned(pin)
