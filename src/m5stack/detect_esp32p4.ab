import "./detect_p4_sequence.ab"
import "../esp32/gpio_esp32p4.ab"
import "abla/unsafe/mmio"
// P4 layouts 1/3: LP peripheral base50120000 + eFuse D000 + SYS2 4C.
// Read-only mirror access, never eFuse programming.
trusted fun m5P4ReadIdentity(): u32 = u32(mmioLoadU32(0x5012D04C))
trusted fun m5P4DetectReadPin(pin: int): int = esp32P4GpioReadOwned(pin)
