import "./magnetometer_probe_sequence.ab"
import "../imu/ak8963_device.ab"
import "../imu/bmm150_device.ab"
import "./magnetometer_update.ab"
@inline
trusted fun m5MagnetometerAllocate(bus: int,address: int): int =
    if (I2cBus(bus).valid()) I2cBus(bus).device(address,400000) & 0xFFFFFFFF else 0
@inline
trusted fun m5MagnetometerBegin(handle: int,kind: int): int =
    if (kind == 1) Bmm150(handle).begin() else Ak8963(handle).begin()
@inline
trusted fun m5MagnetometerRelease(handle: int): bool = I2cDevice(handle).close()
trusted fun M5Magnetometers.probe(bus: I2cBus): int = this.probeOwned(bus | 0)
