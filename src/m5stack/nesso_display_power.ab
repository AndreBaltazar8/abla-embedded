import "../io_expander/pi4ioe5v6408_device.ab"
// M5GFX Nesso E1 startup (PI4IOE at0x44). Caller owns this whole expander,
// stopped LCD/EXT power/system LED users and inactive LCD CS. This configures
// directions, disables EXT power/backlight, pulses LCD reset via the output
// latch and leaves LCD reset released/system LED off. No guessed delay/PWM.
// Do NOT use as a resume operation. No rollback of partially applied writes.
// Result low8:1complete3invalid/admission4I/O; completed writes at8.
trusted fun Pi4Ioe5v6408.prepareNessoDisplayOwned(exclusiveCsInactive: bool): int {
    if (!exclusiveCsInactive || (this|0) <= 0 || (this|0) > 4294967295) return 3
    val device=this.device()
    if (!device.writeRegister8(3,199)) return 4
    if (!device.writeRegister8(7,24)) return 4|(1<<8)
    if (!device.writeRegister8(5,0)) return 4|(2<<8)
    if (!device.writeRegister8(13,128)) return 4|(3<<8)
    if (!device.writeRegister8(11,255)) return 4|(4<<8)
    if (!device.writeRegister8(5,130)) return 4|(5<<8)
    return 1|(6<<8)
}
// Existing configured E1 only. Hardware on/off: every1..255 value enables.
// Preserve EXT power, system-off, LCD reset and active-low LED latch bits.
trusted fun Pi4Ioe5v6408.setNessoBacklightOwned(brightness: int,exclusive: bool): bool =
    exclusive && (this|0) > 0 && (this|0) <= 4294967295 && brightness >= 0 && brightness <= 255 &&
    this.device().updateRegister8(5,64,if (brightness == 0) 0 else 64)
