import "./sensors_types.ab"
import "./imu_owner_update_sequence.ab"
import "./imu_measurement.ab"
// Validate against the ENTIRE aggregate, not only its embedded36B IMU owner.
// This protects RTC ownership/header fields from scratch or snapshot writes.
trusted fun M5Sensors.updateImuOwned(snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): M5ImuUpdateResult {
    if (!this.result().imuReady() || !snapshot.valid()) return M5ImuUpdateResult(0)
    val count=if (this.imu().primary().kind() == m5ImuBmi270) 20 else 14
    if (!scratch.hasAddressRange(0,count)) return M5ImuUpdateResult(0)
    val owner=this.buffer().addressValue()
    val data=snapshot.buffer().addressValue()
    val work=scratch.addressValue()
    if ((owner < data+44 && data < owner+72) || (owner < work+count && work < owner+72)) return M5ImuUpdateResult(0)
    this.imu().updateOwned(snapshot,scratch,micros)
}
// Read only; use update.fresh() to distinguish retained samples from new data.
// External IMU uses unknown/default board mapping, regardless of host board.
trusted fun M5Sensors.measureImuAxis(snapshot: ImuSnapshot,offsets: ImuOffsets,sensor: int,axis: int,
    userOrder: ImuAxisOrder): ImuFixedSample =
    if (this.result().imuReady()) this.imu().measureAxis(snapshot,offsets,this.imuBoard(),sensor,axis,userOrder)
    else ImuFixedSample(0)
