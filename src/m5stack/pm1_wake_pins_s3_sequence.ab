import "./board_id.ab"
import "../esp32/gpio/rtc_input_s3_sequence.ab"
import "../esp32/gpio/output_s3_sequence.ab"
// After checked PM1/IOE power startup. Own GPIO1/4/5/21(Chain),1/2/3(Paper),
// or1/2(Watch), plus shared RTC/GPIO configuration. Consume wake events first,
// disarm wake/ULP/analog/XTAL32k users, prevent sleep, keep LP-IO clock enabled.
// Paper IRQ GPIO1 is floating: PM1 startup provides push-pull IRQ HIGH.
// Preserve every unrelated pad/hold. Failures retain caller pad ownership;
// no rollback or silent retry. Does not enable EXT0/EXT1 or configure codecs.
// Low8:1complete2unsupported3notowned4handofffailure5amplifierfailure.
// Completed handoffs bits8..15; underlying handoff status bits16..23.
trusted fun M5BoardId.configurePm1WakePinsOwned(exclusiveWakeDisarmed: bool): int {
    if (this != m5BoardChainCaptain && this != m5BoardPaperMono && this != m5BoardStopWatch) return 2
    if (!exclusiveWakeDisarmed) return 3
    val count=if (this == m5BoardChainCaptain) 4 else if (this == m5BoardPaperMono) 3 else 2
    var index=0
    while (index < count) {
        val pin=if (this == m5BoardChainCaptain) (if (index == 0) 1 else if (index == 3) 21 else index+3) else index+1
        val result=esp32S3RtcToDigitalInputOwned(pin,3,true)
        if (result != 1) return 4|(index<<8)|(result<<16)
        index=index+1
    }
    if (this == m5BoardChainCaptain && !esp32S3GpioOutputLevelOwned(21,false)) return 5|(4<<8)
    return 1|(count<<8)
}
