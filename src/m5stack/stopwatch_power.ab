import "./expander_owner.ab"
import "./pmic_types.ab"
import "../power/m5pm1_device.ab"
// M5Unified StopWatch startup, M5Stack (MIT). Caller exclusively owns the
// initialized PM1/IOE and stopped motor. No retries/rollback on partial writes.
// PM1 GPIO2 is input. PWM1/channel0 must be disabled before IO9/bit8 output.
// Unlike unchecked upstream frequency write, a failed frequency update also
// stops before enabling the output. Does not initialize display or audio.
// Low8:1complete,2wrongboard,3notready/ownership,4I/O failure.
// Bits8..15: completed high-level operations, not individual I2C bytes.
trusted fun M5Expanders.configureStopWatchPower(pmic: M5PmicOpen,exclusive: bool): int {
    if (!exclusive || !this.ready() || !pmic.ready() || pmic.kind() != 5) return 3
    if (this.board() != m5BoardStopWatch) return 2
    val power=M5Pm1(pmic.deviceHandle())
    val io=M5Ioe1(this.device(0)|0)
    if (!power.setGpioFunction(2,m5Pm1GpioFunctionGpio)) return 4
    if (!power.setGpioMode(2,m5Pm1GpioInput)) return 4|(1<<8)
    if (!io.setPwmDuty12(0,0,false,false)) return 4|(2<<8)
    if (!io.setPwmFrequency(2000)) return 4|(3<<8)
    if (!io.setHighImpedance(8,false)) return 4|(4<<8)
    if (!io.setDirection(8,true)) return 4|(5<<8)
    return 1|(6<<8)
}
