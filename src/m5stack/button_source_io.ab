import "./button_map.ab"
import "../esp32/i2c_idf6.ab"
import "../io_expander/pi4ioe5v6408.ab"
import "../power/m5pm1.ab"

// Bit zero is the logical pressed level and bit one marks a successful read.
// A bus failure therefore never aliases an active-low press.
type M5ButtonRead = int

fun m5ButtonRead(valid: bool, pressed: bool = false): M5ButtonRead =
    M5ButtonRead((if (pressed) 1 else 0) | (if (valid) 2 else 0))

fun M5ButtonRead.valid(): bool = (this & 2) != 0
fun M5ButtonRead.pressed(): bool = this.valid() && (this & 1) != 0

fun M5ButtonSource.decodeLevel(high: bool): M5ButtonRead =
    m5ButtonRead(true, if (this.activeLow()) !high else high)

trusted fun M5ButtonSource.readGpio(): M5ButtonRead {
    if (!this.isGpio() || this.pin().number() < 0) return m5ButtonRead(false)
    this.decodeLevel(this.pin().read())
}

trusted fun M5ButtonSource.readPi4(
    expander: Pi4Ioe5v6408
): M5ButtonRead {
    if (this.kind() != m5ButtonSourcePi4Ioe5v6408 || !expander.valid()) {
        return m5ButtonRead(false)
    }
    val bits = expander.device().readRegister8Checked(this.register())
    if (!bits.valid()) return m5ButtonRead(false)
    this.decodeLevel((bits.value() & this.mask()) != 0)
}

trusted fun M5ButtonSource.readM5Pm1(power: M5Pm1): M5ButtonRead {
    if (this.kind() != m5ButtonSourceM5Pm1 || !power.valid()) {
        return m5ButtonRead(false)
    }
    val bits = power.gpioInputBits()
    if (!bits.valid()) return m5ButtonRead(false)
    this.decodeLevel((bits.value() & this.mask()) != 0)
}

trusted fun M5ButtonSource.readDevice(device: I2cDevice): M5ButtonRead {
    if (this.kind() != m5ButtonSourcePowerHub || !device.valid()) {
        return m5ButtonRead(false)
    }
    val bits = device.readRegister8Checked(this.register())
    if (!bits.valid()) return m5ButtonRead(false)
    this.decodeLevel((bits.value() & this.mask()) != 0)
}

fun M5ButtonSource.readTouch(pressed: bool): M5ButtonRead =
    if (this.kind() == m5ButtonSourceTouch) m5ButtonRead(true, pressed)
    else m5ButtonRead(false)
