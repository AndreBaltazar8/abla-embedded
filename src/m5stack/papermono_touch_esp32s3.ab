import "./pm1_control_esp32s3.ab"
import "../esp32/gpio/input_s3_sequence.ab"
import "../touch/controller_open.ab"
import "./papermono_touch_logic.ab"
import "./papermono_touch_sequence.ab"
trusted fun paperMonoTouchAdmission(control: int): bool = M5Pm1Control(control).ready() && M5Pm1Control(control).board() == m5BoardPaperMono
trusted fun paperMonoTouchPrepareIrq(): bool = esp32S3GpioPrepareInputOwned(4,0,true) == 1
trusted fun paperMonoTouchBus(control: int): int = M5Pm1Control(control).bus()
trusted fun paperMonoTouchHandleAdmission(control: int,handle: int): bool {
    if (!paperMonoTouchAdmission(control)) return false
    val descriptor=esp32S3I2cDevicePool().resolve(handle)
    return esp32S3I2cDeviceKeyMatchesBus(descriptor,M5Pm1Control(control).bus()) &&
        esp32S3I2cDeviceKeyAddress(descriptor) == 56 && esp32S3I2cDeviceKeyFrequency(descriptor) == 400000
}
trusted fun paperMonoTouchReadAdmission(control: int,handle: int,snapshot: NativeBuffer): bool {
    if (!paperMonoTouchHandleAdmission(control,handle) || !esp32S3I2cFacadeBufferSafe(snapshot,29,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return false
    val c=M5Pm1Control(control);val a=snapshot.addressValue();val b=c.buffer().addressValue()
    if (a < b+72 && b < a+29) return false
    return true
}
trusted fun paperMonoTouchReadStable(handle: int,snapshot: NativeBuffer): int = Ft5x06(handle).readStable(snapshot)
// Caller joins/closes owned touch before closing board/bus or sharedtouchreset.
trusted fun M5Pm1Control.openPaperMonoTouchOwned(exclusive: bool): TouchControllerOpen = paperMonoTouchOpenOwned(this|0,exclusive)
trusted fun M5Pm1Control.readPaperMonoTouchOwned(touch: TouchControllerOpen,snapshot: NativeBuffer,exclusive: bool): int =
    paperMonoTouchReadOwned(this|0,touch,snapshot,exclusive)
