// Select actual C5 I2C/delay providers alongside this board adapter.
// CPU-startup, global hold release and peripheral ownership remain prerequisites.
import "./tough_boot.ab"
import "./tough_wake_sequence.ab"
import "../esp32/gpio/c5_wake.ab"
trusted fun M5ToughBoot.finishC5WakeInput(): M5ToughBoot = this.finishC5WakeInputOwned()
trusted fun M5Expanders.configureToughPower(pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): M5ToughBoot =
    this.configureToughPeripherals(pmic,presence,now).finishC5WakeInput()
