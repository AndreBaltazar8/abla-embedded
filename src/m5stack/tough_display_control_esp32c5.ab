import "./tough_display_view.ab"
import "../display/spi_control_c5_sequence.ab"
import "../display/spi_program_esp32c5.ab"
// Known initialized/powered ToughC5 panel and owned GPIO26 D/C. Brightness
// stays caller-owned; caller assigns toughDisplayView(rotation) only on success.
trusted fun toughDisplayConfigureOwned(master: Esp32C5SpiMaster,gate: PeripheralGate,owner: u32,rotation: int): SpiBufferResult =
    esp32C5LcdConfigureRgb565(master|0,gate,owner,26,lcdGeometry(320,240),toughDisplayRotation(rotation),true,true,1000)
