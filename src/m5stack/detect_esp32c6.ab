import "abla/unsafe/mmio"
import "./detect_logic.ab"

// ESP-IDF exposes the package code as a stable, allocation-free C ABI. The
// flash-capacity field is read directly from the ESP32-C6 read-only eFuse
// mirror, matching M5Unified without linking its C++ detector.
trusted noescape extern:"c" fun esp_efuse_get_pkg_ver(): u32

val esp32C6EfuseMacSpiSys4 = 1611335764

trusted fun m5DetectCurrentEsp32C6(
    current: M5BoardId = m5BoardUnknown
): M5BoardId {
    if (current != m5BoardUnknown) return current
    val packageVersion = esp_efuse_get_pkg_ver()
    val flashCapacity = mmioLoadU32(esp32C6EfuseMacSpiSys4) & 7
    m5DetectEsp32C6(current, packageVersion, flashCapacity)
}
