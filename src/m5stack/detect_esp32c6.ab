import "abla/unsafe/mmio"
import "./detect_c6_sequence.ab"
import "../hal/m5stack.ab"

// Both identity fields come from the read-only eFuse mirrors. No SDK calls
// or fuse programming: IDF esp32c6 efuse_reg.h SYS3[26:24], SYS4[2:0].

@inline
@export("m5C6ReadIdentity")
trusted fun m5C6ReadIdentityHook(address: int): u32 = u32(mmioLoadU32(address))
