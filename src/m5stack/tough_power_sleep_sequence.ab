import "./tough_power_owner_view.ab"
import "./toughc5_sleep_handoff_sequence.ab"
//56B scratch: existing board handoff32 plus owner address32,PMIC36/40,
// boot result44/48,touch52. All caller storage stays disjoint from the live
//96B power owner, which remains serialized and must outlive the sleep cycle.
// Caller still owns pad/SDR/domain/quiescence policy; no implicit power close.
trusted fun toughPowerSleepAdmitted(owner: M5ToughPowerOwner,record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,scratch: NativeBuffer,slowCycles: int,fastCycles: int,exclusive: bool): bool {
    if (!exclusive || owner.status() != 1 || owner.toneRetained() || !owner.bootResult().powerReady() ||
        !owner.pmic().ready() || owner.pmic().kind() != 5 || !scratch.hasAddressRange(0,56) ||
        !toughC5SleepHandoffAdmitted(record,request,context,scratch,owner.bootResult(),slowCycles,fastCycles,true)) return false
    val address=owner.buffer().addressValue();val base=record.addressValue();val input=request.addressValue()
    val memory=context.addressValue();val temporary=scratch.addressValue()
    return !(address < base+1024 && base < address+96) && !(address < input+68 && input < address+96) &&
        !(address < memory+772 && memory < address+96) && !(address < temporary+56 && temporary < address+96) &&
        !(temporary < base+1024 && base < temporary+56) && !(temporary < input+68 && input < temporary+56) &&
        !(temporary < memory+772 && memory < temporary+56)
}
trusted fun M5ToughPowerOwner.sleepPreflightOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,scratch: NativeBuffer,touch: int,slowCycles: int,fastCycles: int,exclusiveDevices: bool): int {
    if (touch <= 0 || touch > 4294967295 || !toughPowerSleepAdmitted(this,record,request,context,scratch,slowCycles,fastCycles,exclusiveDevices)) return 2
    scratch.storeU32(32,0)
    val result=toughC5SleepPreflightOwned(record,request,context,scratch,this.bootResult(),this.pmic(),touch,slowCycles,fastCycles,true)
    if (result == 9) {
        val pmic=this.pmic();val boot=this.bootResult()
        scratch.storeU32(36,pmic&0xffffffff);scratch.storeU32(40,pmic>>>32)
        scratch.storeU32(44,boot&0xffffffff);scratch.storeU32(48,boot>>>32);scratch.storeU32(52,touch)
        scratch.storeU32(32,this.buffer().addressValue())
    }
    return result
}
trusted fun M5ToughPowerOwner.sleepBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,scratch: NativeBuffer,slowCycles: int,fastCycles: int,exclusiveSleep: bool): int {
    if (!toughPowerSleepAdmitted(this,record,request,context,scratch,slowCycles,fastCycles,exclusiveSleep) ||
        scratch.loadU32(32) != this.buffer().addressValue()) return 2
    val pmic=this.pmic();val boot=this.bootResult()
    if (scratch.loadU32(36) != (pmic&0xffffffff) || scratch.loadU32(40) != pmic>>>32 ||
        scratch.loadU32(44) != (boot&0xffffffff) || scratch.loadU32(48) != boot>>>32) return 2
    scratch.storeU32(32,0)
    return toughC5SleepBeginOwned(record,request,context,scratch,boot,slowCycles,fastCycles,true)
}
