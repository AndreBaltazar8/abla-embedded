import "../sd/selected_s3_sequence.ab"
import "./pin_map_shared.ab"
// Explicit S3 SPI boards only. PaperMono's native4-bit SDMMC and non-S3
// pin tables must not silently select this driver. Peripheral2/3 is explicit:
// no assumption a board's display has released its pins or shared controller.
fun M5BoardId.sdSpiS3Link(peripheral: int): SdSpiS3Link {
    val board=this.pinMapIdentity()
    if (board != m5BoardStackCoreS3 && board != m5BoardStackCoreS3SE && board != m5BoardStackChan &&
        board != m5BoardCapsule && board != m5BoardCardputer && board != m5BoardCardputerADV &&
        board != m5BoardPaperS3 && board != m5BoardPaperDIY && board != m5BoardStampPLC && board != m5BoardPaperColor)
        return SdSpiS3Link(0)
    val pins=board.sdPins()
    return sdSpiS3Link(peripheral,spiPins(pins.spiMosi().number(),pins.spiMiso().number(),pins.spiClock().number()),pins.spiChipSelect())
}
