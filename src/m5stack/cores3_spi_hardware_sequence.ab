// Exclusive fresh board startup only, AFTER both-CS/SD GPIO preparation.
// Caller keeps PLL80M stable. Configure GPSPI2 at40MHz/mode0 for display TX;
// SD callers must select their own safe clock profile while owning the gate.
trusted fun M5BoardId.configureCoreS3HardwareSpi(gate: PeripheralGate, owner: u32): SpiTransactionResult {
    if (!this.displaySharedDataCommand()) return SpiTransactionResult(3 << 32)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    // Check both display and SD selects before touching clocks or data pads.
    // Detail9/10 identify display/SD GPIO setup failure; pads remain owned.
    var detail=1
    if (!Pin(3).outputLevelOwned(true)) detail=9
    else if (!Pin(4).outputLevelOwned(true)) detail=10
    if (detail == 1) detail = esp32s3SpiInitializeMasterOwned(2,spiPins(37,35,36),Pin(3),1,1,2,0,owner,100000)
    // No bus clocks/rails are rolled back on failure: quarantine the gate.
    if (!gate.finish(owner,detail == 1)) return SpiTransactionResult((5 << 32) | detail)
    SpiTransactionResult(((if (detail == 1) 1 else 6) << 32) | detail)
}
