import "./nesso_i2c_profile.ab"
import "../esp32/i2c_software_esp32c6.ab"
import "./expander_open.ab"
import "./nesso_display_owner_sequence.ab"
import "./nesso_display_power.ab"
trusted fun nessoDisplayOwnerBusCurrent(bus: int): bool = I2cBus(bus).current() &&
    nessoI2cPinsMatch(softwareI2cProviderOwner().lines().sda(),softwareI2cProviderOwner().lines().scl())
trusted fun nessoDisplayOwnerPrepare(handle: int): int = Pi4Ioe5v6408(handle).prepareNessoDisplayOwned(true)
trusted fun nessoDisplayOwnerBacklight(handle: int,brightness: int): bool = Pi4Ioe5v6408(handle).setNessoBacklightOwned(brightness,true)
