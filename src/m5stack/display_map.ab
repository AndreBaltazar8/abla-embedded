import "./board_id.ab"
import "../display/lcd_logic.ab"

val m5DisplayControllerNone = 0
val m5DisplayControllerSt7789 = 1

// Seven signed-byte pins in one scalar: MOSI, MISO, clock, chip select,
// data/command, reset and GPIO backlight. A PMIC-controlled backlight is -1.
type M5SpiDisplayPins = int

fun m5DisplayPinValue(number: int): int = number & 255
fun m5DisplayPin(value: int): int =
    if ((value & 255) == 255) -1 else value & 255

fun m5SpiDisplayPins(
    mosi: int,
    miso: int,
    clock: int,
    chipSelect: int,
    dataCommand: int,
    reset: int,
    backlight: int = -1
): M5SpiDisplayPins = M5SpiDisplayPins(
    m5DisplayPinValue(mosi) | (m5DisplayPinValue(miso) << 8) |
        (m5DisplayPinValue(clock) << 16) |
        (m5DisplayPinValue(chipSelect) << 24) |
        (m5DisplayPinValue(dataCommand) << 32) |
        (m5DisplayPinValue(reset) << 40) |
        (m5DisplayPinValue(backlight) << 48)
)

fun M5SpiDisplayPins.mosi(): int = m5DisplayPin(this)
fun M5SpiDisplayPins.miso(): int = m5DisplayPin(this >>> 8)
fun M5SpiDisplayPins.clock(): int = m5DisplayPin(this >>> 16)
fun M5SpiDisplayPins.chipSelect(): int = m5DisplayPin(this >>> 24)
fun M5SpiDisplayPins.dataCommand(): int = m5DisplayPin(this >>> 32)
fun M5SpiDisplayPins.reset(): int = m5DisplayPin(this >>> 40)
fun M5SpiDisplayPins.backlight(): int = m5DisplayPin(this >>> 48)
fun M5SpiDisplayPins.available(): bool = this.clock() >= 0

fun M5BoardId.displayController(): int {
    val board = this.pinMapIdentity()
    if (board == m5BoardStickCPlus || board == m5BoardStickCPlus2 ||
        board == m5BoardStation) return m5DisplayControllerSt7789
    m5DisplayControllerNone
}

fun M5BoardId.displaySpiPins(): M5SpiDisplayPins {
    val board = this.pinMapIdentity()
    if (board == m5BoardStickCPlus) {
        return m5SpiDisplayPins(15, 14, 13, 5, 23, 18)
    }
    if (board == m5BoardStickCPlus2) {
        return m5SpiDisplayPins(15, -1, 13, 5, 14, 12, 27)
    }
    if (board == m5BoardStation) {
        return m5SpiDisplayPins(23, -1, 18, 5, 19, 15)
    }
    m5SpiDisplayPins(-1, -1, -1, -1, -1, -1)
}

fun M5BoardId.displayGeometry(): LcdGeometry =
    if (this.displayController() == m5DisplayControllerSt7789) {
        // Prepacked form avoids rebuilding a fixed board property at runtime.
        LcdGeometry(360551895984750727)
    } else lcdGeometry(0, 0)

fun M5BoardId.displayRotation(): int =
    if (this.pinMapIdentity() == m5BoardStation) 1 else 0

fun M5BoardId.displayInverted(): bool =
    this.displayController() == m5DisplayControllerSt7789

fun M5BoardId.displaySpiHost(): int =
    if (this.displayController() != m5DisplayControllerNone) 1 else -1

fun M5BoardId.displayFrequency(): int =
    if (this.displayController() != m5DisplayControllerNone) 40000000 else 0
