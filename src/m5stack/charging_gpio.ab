import "./board_id.ab"
// Lowest-level board mapping: the status signal remains a Pin, not a button
// or power controller. PaperS3's CHG_STAT is GPIO4, active low (M5Unified).
// Other boards require their PMIC/expander/current-sense implementation.
fun M5BoardId.chargingStatusPin(): Pin = Pin(if (this == m5BoardPaperS3) 4 else -1)
// Own the pad (including RTC/peripheral/hold release) through preparation and
// sampling. Backend must report failed input configuration, never sample a
// stale/output pin and interpret it as charging. Does not change power rails.
// -1 unsupported/missing ownership, -2 input setup failed, 0notcharging,1charging.
// A single status sample, not battery-presence/full-charge detection.
trusted fun M5BoardId.readGpioChargingOwned(exclusive: bool): int {
    val p=this.chargingStatusPin()
    if (!exclusive || p.number() < 0) return -1
    if (!m5ChargingInputOwned(p.number())) return -2
    return if (p.read()) 0 else 1
}
