import "./papermono_display_esp32s3.ab"
import "./papermono_spi_esp32s3.ab"
import "../display/ssd1677_init_esp32s3.ab"
import "../esp32/gpio/input_s3_sequence.ab"
import "./papermono_panel_startup_sequence.ab"
trusted fun paperMonoPanelAdmission(control: int,gate: PeripheralGate): bool {
    val c=M5Pm1Control(control);val address=gate.word().address()
    if (!c.ready() || c.board() != m5BoardPaperMono || !gate.word().valid() ||
        address <= 0 || address > 4294967292 || !gate.bufferDisjoint(c.buffer(),72) ||
        !esp32S3I2cFacadeBufferSafe(nativeBufferAt(address,4),4,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return false
    return nativeAddressLoadU32(address,0) == 0
}
trusted fun paperMonoPanelPower(control: int): int = M5Pm1Control(control).preparePaperMonoDisplayOwned(true)
trusted fun paperMonoPanelSpi(gate: PeripheralGate,owner: u32): SpiTransactionResult = paperMonoSpiInitializeOwned(gate,owner,true)
trusted fun paperMonoPanelBusy(): int = esp32S3GpioPrepareInputOwned(18,0,true)
trusted fun paperMonoPanelInitialize(gate: PeripheralGate,owner: u32,polls: int): SpiTransactionResult =
    esp32s3Ssd1677Initialize(gate,owner,2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),polls,true)
// Caller owns stopped EPD/touch/SD and GPIO14..18 released from RTC/holds.
// No PSRAM requirement: caller later provides initialized drawing/history buffers.
trusted fun M5Pm1Control.preparePaperMonoPanelOwned(gate: PeripheralGate,owner: u32,polls: int,exclusive: bool): int =
    paperMonoPanelStartupOwned(this|0,gate,owner,polls,exclusive)
