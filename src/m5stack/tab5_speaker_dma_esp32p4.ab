import "./tab5_speaker_dma_sequence.ab"
import "../esp32/i2s/standard_config_esp32p4.ab"
import "../esp32/i2s/transfer_esp32p4.ab"
import "../esp32/i2s/pins_esp32p4.ab"
import "../esp32/ahb_gdma_control_esp32p4.ab"
import "../esp32/ahb_gdma_publish_esp32p4.ab"
import "../hal/m5stack.ab"
import "../hal/m5stack_2.ab"
@export("p4Tab5SpeakerParked")
trusted fun p4Tab5SpeakerParkedHook(channel: int): int = esp32p4AhbGdmaParkedOwned(channel,true,true)
@export("p4Tab5SpeakerBus")
trusted fun p4Tab5SpeakerBusHook(): int = esp32p4I2sEnableBusOwned(0,true)
@export("p4Tab5SpeakerI2sStopped")
trusted fun p4Tab5SpeakerI2sStoppedHook(): bool = ((mmioLoadU32(0x500c6020)|mmioLoadU32(0x500c6024))&263) == 0
@export("p4Tab5SpeakerReset")
trusted fun p4Tab5SpeakerResetHook(): int = esp32p4I2sResetDirectionOwned(0,true,true)
@export("p4Tab5SpeakerDmaPrepare")
trusted fun p4Tab5SpeakerDmaPrepareHook(channel: int): int = esp32p4AhbGdmaPrepareI2sOwned(channel,true,0,true)
@export("p4Tab5SpeakerFormat")
trusted fun p4Tab5SpeakerFormatHook(revision: int): int = esp32p4I2sConfigureStandardOwned(0,true,0,revision,6,49,96,8,16,16,16,true,3,1,true)
@export("p4Tab5SpeakerPins")
trusted fun p4Tab5SpeakerPinsHook(): int = esp32p4I2sRoutePinsOwned(0,true,30,27,29,26,0,true)
@export("p4Tab5SpeakerRing")
trusted fun p4Tab5SpeakerRingHook(descriptors: int,count: int,payload: int,stride: int,bytes: int): bool = esp32p4AhbGdmaBuildRingOwned(descriptors,count,payload,stride,bytes,true,true,true)
@export("p4Tab5SpeakerPublish")
trusted fun p4Tab5SpeakerPublishHook(descriptors: int,count: int,payload: int,stride: int,bytes: int,polls: int): int = esp32p4AhbGdmaPublishRingOwned(descriptors,count,payload,stride,bytes,polls,true)
