import "./sensors_types.ab"
// Mirrors M5Unified _begin_rtc_imu ordering. Bus initialization is explicit:
// supply already-open buses, or0 for unavailable/disabled. Options bits:
// 1 internal RTC,2 external RTC,4 internal IMU,8 external IMU,
// 16 disable RTC IRQ,32 synchronize UTC system clock. No implicit bus reset.
trusted fun M5Sensors.beginOwned(internalBus: int,externalBus: int,board: M5BoardId,options: int): M5SensorsBegin {
    if (!this.valid() || this.buffer().loadU32(4) != 0 || options < 0 || options > 63) return M5SensorsBegin(0)
    this.buffer().storeU32(4,1); this.buffer().storeU32(24,board | 0)
    var result=1024
    var rtc=M5RtcOpenResult(0)
    if ((options&1) != 0 && m5SensorsBusValid(internalBus)) rtc=m5SensorsRtcOpen(internalBus,board)
    // Never overwrite an unreleased failed-open handle during fallback.
    if (!rtc.ready() && rtc.handle() == 0 && (options&2) != 0 && m5SensorsBusValid(externalBus)) {
        rtc=m5SensorsRtcOpen(externalBus,m5BoardUnknown)
        if (rtc.ready()) result=result|4
    }
    this.storeRtc(rtc)
    if (rtc.ready()) {
        result=result|1
        if ((options&32) != 0) result=result|(if (m5SensorsRtcSync(rtc.handle())) 16 else 256)
        if ((options&16) != 0) result=result|(if (m5SensorsRtcDisableIrq(rtc.handle())) 32 else 512)
    } else if (rtc.handle() != 0) result=result|64
    var imuReady=false
    var imuClean=true
    if ((options&4) != 0 && m5SensorsBusValid(internalBus)) {
        imuReady=m5SensorsImuOpen(this.imu(),internalBus) == 1
        if (!imuReady) imuClean=m5SensorsImuClose(this.imu())
    }
    if (!imuReady && imuClean && (options&8) != 0 && m5SensorsBusValid(externalBus)) {
        imuReady=m5SensorsImuOpen(this.imu(),externalBus) == 1
        if (imuReady) result=result|8 else imuClean=m5SensorsImuClose(this.imu())
    }
    if (imuReady) result=result|2
    if (!imuClean) result=result|128
    this.buffer().storeU32(16,result)
    M5SensorsBegin(result)
}
// Attempt both independent releases. No bus close or hardware power rollback.
// begin result is historical; borrowed device views expire on close attempt.
trusted fun M5Sensors.closeOwned(): bool {
    if (!this.valid()) return false
    val rtc=this.rtcResult()
    val rtcClosed=rtc.handle() == 0 || m5SensorsRtcClose(rtc.handle())
    if (rtcClosed) this.storeRtc(M5RtcOpenResult(0))
    val imuClosed=m5SensorsImuClose(this.imu())
    this.buffer().storeU32(4,if (rtcClosed && imuClosed) 2 else 3)
    this.buffer().storeU32(16,0)
    rtcClosed && imuClosed
}
