import "./tab5_dsi_owner_sequence.ab"
import "../esp32/ldo_pmu_esp32p4.ab"
import "../esp32/reference_clock_owner_esp32p4.ab"
import "../esp32/dsi_bus_esp32p4.ab"
import "../esp32/peripheral_delay_esp32p4.ab"
import "./tab5_panel_start_esp32p4.ab"
trusted fun tab5DsiOwnerScratchSafe(scratch: NativeBuffer): bool = p4SoftwareProviderBufferSafe(scratch,32)
fun tab5DsiOwnerProbeLane(probe: int): int = M5Tab5TouchProbe(probe).tab5LaneKbps()
trusted fun tab5DsiOwnerPanelStart(probe: int,vc: int,scratch: NativeBuffer,polls: int): int = M5Tab5TouchProbe(probe).startTab5PanelOwned(vc,scratch,polls)|0
// This composition acquires PLL20M/25M config output. RC_FAST has no such
// lease and must use the lower-level clock APIs instead. On layout3 caller
// separately pins the configured reference source and supplies measured khz.
trusted fun tab5DsiOwnerPreflight(reference: int,layout: int,revision: int,cfg: int,ref: int,div: int,khz: int,lane: int,vc: int,polls: int): bool {
    val owner=Esp32P4ReferenceClockOwner(reference)
    if (!owner.valid() || owner.cleanupRequired() || owner.references() == 65535 ||
        (cfg != 0 && cfg != 2) || owner.mhz() != (if (cfg == 0) 20 else 25) ||
        (layout != 1 && layout != 3) || revision < 0 || revision > 399 ||
        ref < 0 || div < 1 || div > 256 || vc < 0 || vc > 3 || polls < 1 || polls > 1000000 ||
        (lane != 900000 && lane != 1040000)) return false
    if (layout == 1 && (ref != cfg || div != 1 || khz != owner.mhz()*1000)) return false
    if (layout == 3 && ref > 4) return false
    return esp32P4DsiChoosePllKbps(khz,lane).valid()
}
trusted fun tab5DsiOwnerRailOpen(revision: int): int = esp32P4LdoOpenOwned(3,2500,revision)|0
trusted fun tab5DsiOwnerRailClose(value: int): int = if (!Esp32P4LdoOwner(value).ownsRail()) 0 else Esp32P4LdoOwner(value).closeOwned()|0
trusted fun tab5DsiOwnerSettle(us: int): void = peripheralRomDelay(us)
trusted fun tab5DsiOwnerReferenceAcquire(value: int): int {
    val before=Esp32P4ReferenceClockOwner(value)
    val after=before.acquireOwned()
    val success= !after.cleanupRequired() && after.references() == before.references()+1
    return (after|0)|(if (success || after.status() == 3) 1<<32 else 0)|(if (success) 1<<33 else 0)
}
trusted fun tab5DsiOwnerReferenceRelease(value: int): int {
    val before=Esp32P4ReferenceClockOwner(value)
    val after=before.releaseOwned()
    val complete= !after.cleanupRequired() && (after.references() == before.references()-1 || (before.status() == 3 && after.references() == 0))
    return (after|0)|(if (complete) 1<<32 else 0)
}
trusted fun tab5DsiOwnerHostOpen(layout: int,cfg: int,ref: int,div: int,khz: int,lane: int,vc: int,polls: int): int =
    esp32P4DsiOpenOwned(layout,2,cfg,ref,div,khz,lane,vc,false,polls)|0
trusted fun tab5DsiOwnerHostClose(value: int,polls: int): int =
    if (!Esp32P4DsiBus(value).ownsClocks() && !Esp32P4DsiBus(value).ownsDigital()) 0 else Esp32P4DsiBus(value).closeOwned(polls)|0
