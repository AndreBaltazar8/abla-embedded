import "../display/co5300_esp32s3.ab"
import "../display/co5300_program_sequence_esp32s3.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
import "./stopwatch_panel_program.ab"
// Already powered/reset panel, initialized owned quad SPI2 and inactiveCS39.
// Dark initialized rotation0/RGB565 panel only, NOT cleared or visible yet.
trusted fun stopWatchPanelBeginOwned(gate: PeripheralGate,owner: u32): SpiTransactionResult =
    esp32s3Co5300RunProgram(gate,owner,2,quadSpiPins(40,41,42,46,45),Pin(39),stopWatchPanelInitProgram())
// Single-byte control with caller-level panel serialization. Publish new
// drawing/touch rotation only after the rotation transaction succeeds.
trusted fun stopWatchPanelControlOwned(gate: PeripheralGate,owner: u32,command: int,value: int): SpiTransactionResult {
    if (value < 0 || value > 255) return SpiTransactionResult(3<<32)
    val data=nativeBufferAt(nativeStackAllocate(1),1)
    data.store(0,value)
    return esp32s3Co5300Transfer(gate,owner,2,quadSpiPins(40,41,42,46,45),Pin(39),command,data,1,false)
}
trusted fun stopWatchPanelRotationOwned(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult =
    stopWatchPanelControlOwned(gate,owner,54,stopWatchPanelMadctl(rotation))
trusted fun stopWatchPanelBrightnessOwned(gate: PeripheralGate,owner: u32,brightness: int): SpiTransactionResult =
    stopWatchPanelControlOwned(gate,owner,81,brightness)
