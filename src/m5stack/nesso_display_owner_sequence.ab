import "./expander_open_sequence.ab"
// Retained E1 power/reset/backlight ownership, NOT the SPI panel owner. Caller
// keeps C6 bus/clocks alive, all other E1 users stopped and LCD CS inactive for
// startup/close. Scalar copies are not independent leases. No hardware rollback.
// Low48 expander owner, status8@48, needs-backlight-off bit56, setupwrites3@57.
// Status0closed1ready2admission3openfailed4setupfailed5backlightclose6release.
type NessoDisplayPower=int
fun NessoDisplayPower.status(): int = (this>>>48)&255
fun NessoDisplayPower.expander(): M5ExpanderOpen = M5ExpanderOpen(this&0xffffffffffff)
fun NessoDisplayPower.ownsDevice(): bool = this.expander().ownsDevice()
fun NessoDisplayPower.ready(): bool = this.status() == 1 && this.expander().ready()
fun NessoDisplayPower.setupWrites(): int = (this>>>57)&7
trusted fun nessoDisplayPowerOpenOwned(bus: int,exclusiveCsInactive: bool): NessoDisplayPower {
    if (!exclusiveCsInactive || !nessoDisplayOwnerBusCurrent(bus)) return NessoDisplayPower(2<<48)
    val ioe=m5BoardArduinoNessoN1.openExpanderOwned(bus,1)
    if (!ioe.ready()) return NessoDisplayPower((ioe|0)|(3<<48))
    val result=nessoDisplayOwnerPrepare(ioe.deviceHandle())
    return NessoDisplayPower((ioe|0)|((if ((result&255) == 1) 1 else 4)<<48)|(1<<56)|(((result>>>8)&7)<<57))
}
// No setup replay or implicit reset; nonzero brightness is simply on.
trusted fun NessoDisplayPower.setBacklightOwned(brightness: int,exclusive: bool): bool =
    exclusive && this.ready() && brightness >= 0 && brightness <= 255 &&
    nessoDisplayOwnerBacklight(this.expander().deviceHandle(),brightness)
// Return value MUST replace caller's owner, even on failure. A confirmed
// backlight-off is not repeated when only handle release needs retry. Closing
// does not switch EXT power, tear down SPI pads or gate clocks; caller owns them.
trusted fun NessoDisplayPower.closeOwned(exclusiveCsInactive: bool): NessoDisplayPower {
    if (!exclusiveCsInactive) return this
    if (!this.ownsDevice()) return NessoDisplayPower(0)
    var state=this&~(255<<48)
    if ((state&(1<<56)) != 0) {
        if (!nessoDisplayOwnerBacklight(this.expander().deviceHandle(),0)) return NessoDisplayPower(state|(5<<48))
        state=state&~(1<<56)
    }
    val released=this.expander().releaseOwned()
    if (released.ownsDevice()) return NessoDisplayPower((state&~0xffffffffffff)|(released|0)|(6<<48))
    return NessoDisplayPower(0)
}
