import "../esp32/sdk/raw_buffer.ab"
// Shared192B session and cache-line-owned P4 ring storage exclusion.
// Caller first validates the session and complete ring layout.
trusted fun coreP4xMicrophoneStorageDisjoint(r: NativeBuffer,b: NativeBuffer,bytes: int): bool {
    if (!b.hasAddressRange(0,bytes)) return false
    val a=b.addressValue();val count=r.loadU32(24)
    val desc=r.loadU32(20);val payload=r.loadU32(28);val stride=r.loadU32(32)
    return bytes == 0 || !((a < r.addressValue()+192 && r.addressValue() < a+bytes) ||
        (a < desc+count*64 && desc < a+bytes) || (a < payload+count*stride && payload < a+bytes))
}
