import "./i2c_pin_map.ab"
import "./speaker_profile.ab"
import "./microphone_profile.ab"
import "./touch_profile.ab"
import "./rtc_profile.ab"
import "./power_profile.ab"
// Explicit static classic-ESP32 selection only. No discovery/startup or
// ownership. RTC kind is a driver policy, not proof of installed hardware.
// Core2/Tough/Stick PMIC identity must still be probed by the power owner.

type M5Stack = int
fun m5Stack(): M5Stack = M5Stack(1)
fun M5Stack.boardId(): M5BoardId = m5BoardStack
fun M5Stack.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5Stack.speakerProfile(): M5SpeakerProfile = this.boardId().speakerProfile()
fun M5Stack.microphoneProfile(): M5MicrophoneProfile = this.boardId().microphoneProfile()
fun M5Stack.touchProfile(): M5TouchProfile = this.boardId().touchProfile()
fun M5Stack.rtcKind(): M5RtcKind = this.boardId().rtcKind()
fun M5Stack.powerKind(): M5PowerKind = this.boardId().powerKind()

