import "./sensors_begin_sequence.ab"
import "./rtc_open.ab"
import "./rtc_clock.ab"
import "./imu_owner.ab"
// Select one common I2C provider and a real setUnixTimeSeconds backend.
trusted fun m5SensorsBusValid(bus: int): bool = I2cBus(bus).valid()
trusted fun m5SensorsRtcOpen(bus: int,board: M5BoardId): M5RtcOpenResult = m5RtcOpen(I2cBus(bus),board)
trusted fun m5SensorsRtcSync(handle: int): bool = M5Rtc(handle).setSystemTimeFromRtc()
trusted fun m5SensorsRtcDisableIrq(handle: int): bool = M5Rtc(handle).disableInterrupts()
trusted fun m5SensorsRtcClose(handle: int): bool = M5Rtc(handle).close()
trusted fun m5SensorsImuOpen(owner: M5ImuOwner,bus: int): int = owner.open(I2cBus(bus))
trusted fun m5SensorsImuClose(owner: M5ImuOwner): bool = owner.close()
trusted fun M5Sensors.begin(internalBus: I2cBus,externalBus: I2cBus,board: M5BoardId,options: int = 63): M5SensorsBegin =
    this.beginOwned(internalBus | 0,externalBus | 0,board,options)
trusted fun M5Sensors.close(): bool = this.closeOwned()
// Borrow only while owner remains open and rtcReady is true.
trusted fun M5Sensors.rtc(): M5Rtc = M5Rtc(if (this.result().rtcReady()) this.rtcResult().handle() else 0)
