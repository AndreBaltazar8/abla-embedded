import "../esp32/rtc_external_wake_s3_sequence.ab"
// Validate record ownership before stopping the timer. Partial preparation
// may own fewer sources than requested; a ready record must own them all.
@inline
trusted fun m5RtcWakeCancellationOwned(record: NativeBuffer): bool {
    if (!record.hasAddressRange(0,176) || (record.addressValue() & 3) != 0) return false
    if (esp32S3ExternalWakeReleasedOwned(record)) return true
    val base=record.addressValue()
    if (esp32S3RtcWakeRead(base) != 0x45585453) return false
    val owned=esp32S3RtcWakeRead(base+4)
    val requested=esp32S3RtcWakeRead(base+8)
    val ready=esp32S3RtcWakeRead(base+12)
    owned >= 0 && owned <= 3 && requested >= 0 && requested <= 3 &&
        (owned & ~requested) == 0 && (ready == 0 || (ready == 1 && owned == requested))
}
@inline
trusted fun m5RtcWakeCancellationRestore(record: NativeBuffer): bool =
    esp32S3ExternalWakeReleasedOwned(record) || esp32S3ExternalWakeRestoreOwned(record)
