import "./ft5x06_power_s3_logic.ab"
import "../esp32/i2c_esp32s3.ab"
import "../touch/ft5x06_power_esp32s3.ab"
// Borrowed bus and owned touch must remain exclusively held for the entire
// call. Caller prepares board rails/reset and releases IRQ RTC/holds first.
// No hidden board reset, bus opening, rail change, or architecture detection.
trusted fun M5BoardId.ft5x06S3PowerAdmission(bus: I2cBus,touch: TouchControllerOpen): bool {
    if (!this.ft5x06S3PowerSupported() || touch.kind() != 1 || touch.handle() == 0 || !bus.valid()) return false
    val state=esp32S3I2cState(esp32S3I2cBusKeyPort(bus))
    return this.ft5x06S3PowerMatches(bus,esp32S3I2cDevicePool().resolve(touch.handle()),
        nativeAddressLoadU32(state,8),nativeAddressLoadU32(state,4),
        nativeAddressLoadU32(state,12),nativeAddressLoadU32(state,16))
}
// Assign returned owner: 5 asleep, 6 uncertain (retained for retry/close).
trusted fun M5BoardId.sleepFt5x06TouchOwned(bus: I2cBus,touch: TouchControllerOpen,exclusive: bool): TouchControllerOpen {
    if (!exclusive || !this.ft5x06S3PowerAdmission(bus,touch)) return touch
    return touch.sleepFt5x06CheckedOwned(true)
}
trusted fun M5BoardId.wakeFt5x06TouchOwned(bus: I2cBus,touch: TouchControllerOpen,exclusive: bool): TouchControllerOpen {
    if (!exclusive || !this.ft5x06S3PowerAdmission(bus,touch)) return touch
    return touch.wakeFt5x06CheckedOwned(this.touchProfile().interruptNumber(),true)
}
