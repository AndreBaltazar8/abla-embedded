import "../display/ssd1677_session.ab"
import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
// Ready retained PM1 control/rails/bus, initializedSPI/BUSYpad. Caller owns
// stopped display and has recovered any previously faulted SPI gate first.
// Hold one SPI gate across CSinactive -> physicalreset -> controllerinit.
// Failure retains sessionfault/unknownhistory; no automatic second attempt.
trusted fun paperMonoWakeOwned(control: int,session: Ssd1677Session,gate: PeripheralGate,owner: u32,
    polls: int,exclusive: bool): SpiTransactionResult {
    if (!exclusive || owner == u32(0) || polls < 1 || polls > 10000 || !session.valid() ||
        (session.buffer().loadU32(4) != 2 && session.buffer().loadU32(4) != 3) ||
        !paperMonoWakeAdmission(control,session,gate)) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    var detail=1
    if (!paperMonoWakeSelect()) detail=12
    if (detail == 1) {
        val reset=paperMonoWakeReset(control)
        if (reset != 1) detail=16|(reset<<8)
    }
    if (detail == 1) detail=paperMonoWakeInitializeOwned(polls)
    val healthy=(detail&255) == 1
    val released=gate.finish(owner,healthy)
    val result=SpiTransactionResult(((if (!released) 5 else if (healthy) 1 else 6)<<32)|detail)
    val r=session.buffer()
    r.storeU32(44,result&4294967295);r.storeU32(48,result>>>32)
    r.storeU32(4,if (healthy && released) 1 else 2);r.storeU32(24,(r.loadU32(24)&16)|(if (healthy && released) 1 else 0))
    r.storeU32(28,0);r.storeU32(32,0);r.storeU32(36,800);r.storeU32(40,480)
    return result
}
