import "./tab5_video_shutdown_sequence.ab"
import "./tab5_owned_video_esp32p4.ab"
import "../display/dsi_irq_owner_esp32p4.ab"
import "../riscv/machine_status.ab"
import "../hal/m5stack.ab"
@export("tab5OwnedShutdownMask")
trusted fun tab5OwnedShutdownMaskHook(): u32 = riscvMachineInterruptSaveDisable()
@export("tab5OwnedShutdownRestore")
trusted fun tab5OwnedShutdownRestoreHook(saved: u32): void = riscvMachineInterruptRestore(saved)
@export("tab5OwnedShutdownIrq")
trusted fun tab5OwnedShutdownIrqHook(mailbox: NativeBuffer,table: NativeBuffer,lease: int): int =
    esp32P4DsiIrqCloseOwned(p4DsiMailboxAt(mailbox),p4IrqDispatchAt(table),lease)
