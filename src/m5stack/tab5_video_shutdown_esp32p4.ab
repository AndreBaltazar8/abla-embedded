import "./tab5_video_shutdown_sequence.ab"
import "./tab5_owned_video_esp32p4.ab"
import "../display/dsi_irq_owner_esp32p4.ab"
import "../riscv/machine_status.ab"
trusted fun tab5OwnedShutdownMask(): u32 = riscvMachineInterruptSaveDisable()
trusted fun tab5OwnedShutdownRestore(saved: u32): void = riscvMachineInterruptRestore(saved)
trusted fun tab5OwnedShutdownIrq(mailbox: NativeBuffer,table: NativeBuffer,lease: int): int =
    esp32P4DsiIrqCloseOwned(p4DsiMailboxAt(mailbox),p4IrqDispatchAt(table),lease)
