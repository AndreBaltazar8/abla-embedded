import "./i2c_pin_map.ab"
import "./speaker_profile.ab"
import "./microphone_profile.ab"
import "./touch_profile.ab"
import "./rtc_profile.ab"
import "./power_profile.ab"
// Static S3 board selection only: no probe, GPIO/I2C setup or ownership.
// Missing shared profiles remain invalid; rtcKind is a driver selection,
// not evidence of an installed RTC. Board-specific startup remains explicit.

type M5Cardputer = int
fun m5Cardputer(): M5Cardputer = M5Cardputer(14)
fun M5Cardputer.boardId(): M5BoardId = m5BoardCardputer
fun M5Cardputer.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5Cardputer.speakerProfile(): M5SpeakerProfile = this.boardId().speakerProfile()
fun M5Cardputer.microphoneProfile(): M5MicrophoneProfile = this.boardId().microphoneProfile()
fun M5Cardputer.touchProfile(): M5TouchProfile = this.boardId().touchProfile()
fun M5Cardputer.rtcKind(): M5RtcKind = this.boardId().rtcKind()
fun M5Cardputer.powerKind(): M5PowerKind = this.boardId().powerKind()

