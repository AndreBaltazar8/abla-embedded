import "./button_frame.ab"
import "../input/button.ab"
// One64-bit scalar: ButtonState plus sample-valid bit22 (unused by the plain
// ButtonState). Not a GpioButton: board GPIO methods remain bare Pins.
// Unknown intervals do not accrue hold/debounce/click-decision time. A fresh
// valid sample reanchors time; a changed level must debounce again afterward.
type M5Button = int
fun m5Button(pressed: bool = false,nowMilliseconds: int = 0): M5Button =
    M5Button(buttonState(pressed,nowMilliseconds) | 0)
fun M5Button.state(): ButtonState = ButtonState(this & ~4194304)
fun M5Button.sampleValid(): bool = (this&4194304) != 0
fun M5Button.updateFrom(sample: M5ButtonRead,nowMilliseconds: int,debounceMilliseconds: int = 10,
    holdMilliseconds: int = 500,clickDecisionMilliseconds: int = 250): M5Button {
    val previous=this.state()
    var base=previous
    if (!sample.valid() || !this.sampleValid()) {
        base=packButtonState(nowMilliseconds,previous.durationMilliseconds(),0,
            if (previous.wasDecideClickCount()) 0 else previous.getClickCount(),
            previous.isPressed(),previous.isPressed(),previous.isHolding(),false,false,false,false)
    }
    if (!sample.valid()) return M5Button(base | 0)
    M5Button(base.update(sample.pressed(),nowMilliseconds,debounceMilliseconds,
        holdMilliseconds,clickDecisionMilliseconds) | 4194304)
}
fun M5Button.updateFrame(frame: M5ButtonFrame,index: int,nowMilliseconds: int,debounceMilliseconds: int = 10,
    holdMilliseconds: int = 500,clickDecisionMilliseconds: int = 250): M5Button =
    this.updateFrom(frame.read(index),nowMilliseconds,debounceMilliseconds,holdMilliseconds,clickDecisionMilliseconds)
