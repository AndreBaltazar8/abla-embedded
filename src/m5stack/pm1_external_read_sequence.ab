import "./board_id.ab"
import "../i2c/results.ab"
// Checked enabled-port mask: PA1, PB1/PB2 share6. Latches only, not measured
// voltage. Caller serializes power changes across both devices: two reads
// cannot promise an atomic hardware snapshot without that ownership.
trusted fun M5BoardId.pm1ExternalPortsCheckedOwned(pm1: int,ioe: int): I2cByteResult {
    val chain=this == m5BoardChainCaptain
    val stamp=this == m5BoardStampS3Bat
    val direct=this == m5BoardToughC5 || this == m5BoardStickS3 || this == m5BoardStopWatch || this == m5BoardPaperColor
    if ((!chain && !stamp && !direct) || pm1 <= 0 || pm1 > 4294967295 ||
        (chain && (ioe <= 0 || ioe > 4294967295))) return I2cByteResult(0)
    if (direct) return pm1ExternalReadRail(pm1)
    if (chain) {
        val boost=pm1ExternalReadBoost(ioe)
        if (!boost.valid()) return I2cByteResult(0)
        if (boost.value() == 0) return I2cByteResult(256)
    }
    val latch=pm1ExternalReadLatch(pm1)
    if (!latch.valid()) return I2cByteResult(0)
    val bits=latch.value()
    val ports=if (stamp) (if ((bits & 2) != 0) 1 else 0)
        else (if ((bits & 1) != 0) 1 else 0) | (if ((bits & 8) != 0) 6 else 0)
    I2cByteResult(256|ports)
}
