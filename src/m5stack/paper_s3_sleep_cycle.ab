import "./paper_s3_sleep_cycle_sequence.ab"
import "./paper_s3_sleep_prepare.ab"
import "./paper_s3_sleep_run.ab"
import "./paper_s3_wake_wait.ab"
import "../esp32/gpio/probe_owned_esp32s3.ab"
import "../esp32/i2c/sleep_esp32s3.ab"
trusted fun paperS3CyclePadCapture(): S3GpioSnapshot = esp32S3GpioSnapshotOwned(48,true)
trusted fun paperS3CyclePadPrepare(pad: S3GpioSnapshot): int = pad.prepareProbeInputOwned(0,true)
trusted fun paperS3CyclePadRestore(pad: S3GpioSnapshot): int = pad.restoreOwned(true)
// Resolve a live400k GT911 device on the board bus while holding its normal
// gate. Do not silently accept a device from a different controller or wiring.
trusted fun paperS3CycleTouchBus(touch: int): int {
    val state=esp32S3I2cState1;val gate=peripheralGateAt(state)
    if (gate.tryBegin(u32(1)) != 0) return 0
    val descriptor=esp32S3I2cDevicePool().resolve(touch)
    var bus=0
    if (esp32S3I2cDeviceKeyValid(descriptor) && esp32S3I2cDeviceKeyPort(descriptor) == 1 &&
        (esp32S3I2cDeviceKeyAddress(descriptor) == 20 || esp32S3I2cDeviceKeyAddress(descriptor) == 93) &&
        esp32S3I2cDeviceKeyFrequency(descriptor) == 400000 && nativeAddressLoadU32(state,12) == 41 && nativeAddressLoadU32(state,16) == 42) {
        val key=esp32S3I2cBusKey(1,esp32S3I2cDeviceKeyGeneration(descriptor))
        if (esp32S3I2cBusKeyOpen(state,key)) bus=key
    }
    return if (gate.finish(u32(1),true)) bus else 0
}
