import "./corematrix_matrix_sequence.ab"
import "../display/mono_page_canvas.ab"
// Buffered operations only. Explicit display() publishes the completed frame.
// Rectangles clip to the rotated16x16 canvas; malformed inputs make no changes.
trusted fun M5CoreMatrixMatrix.fillRect(x: int,y: int,width: int,height: int,on: bool,rotation: int = 0): bool =
    this.ready() && monoPageDrawClippedOwned(this.frame(),16,16,x,y,width,height,rotation,NativeBuffer(0),0,if (on) 1 else 0,-1,true)
trusted fun M5CoreMatrixMatrix.drawBitmap(x: int,y: int,width: int,height: int,source: NativeBuffer,stride: int,rotation: int = 0,transparent: int = -1): bool =
    this.ready() && monoPageDrawClippedOwned(this.frame(),16,16,x,y,width,height,rotation,source,stride,-1,transparent,true)
