import "./imu_startup_sequence.ab"
import "./imu_owner_update.ab"
trusted fun M5ImuOwner.updateStartup(snapshot: ImuSnapshot,scratch: NativeBuffer,
    micros: int,calibration: ImuCalibration,offsets: ImuOffsets,initialized: int): M5ImuCalibratedUpdate =
    this.updateStartupOwned(snapshot,scratch,micros,calibration,offsets,initialized)
