import "./atom_s3_panel_reset_sequence.ab"
import "../esp32/spi/buffer_sequence_esp32s3.ab"
import "../peripheral_gate.ab"
// Caller owns stopped initialized controller, all pads/old consumers/RCC,
// stable PLL80MHz, powered panel and other CS inactive. No shared live users.
// Configure TX-only40MHz/mode0 on existing port, establish DC, reset panel.
// No START. Gate remains faulted after preparation failure; no hidden recovery.
trusted fun atomS3RDisplayPrepareOwned(gate: PeripheralGate,owner: u32,port: int,polls: int): int {
    if (esp32s3SpiBase(port) == 0 || polls < 1 || polls > 1000000) return 2
    val admitted=gate.tryBegin(owner)
    if (admitted != 0) return 2|(admitted<<8)
    var result=3
    // Check before initializer's CS writes; timeout does not authorize GPIO.
    if (esp32s3SpiCpuBufferIdle(esp32s3SpiBase(port))) {
        val initialized=esp32s3SpiInitializeTransmitOwned(port,spiPins(21,-1,15),Pin(14),1,1,2,0,owner,polls)
        result=4|(initialized<<8)
        if (initialized == 1) {
            result=5
            if (Pin(42).outputLevelOwned(true)) {
                val reset=m5BoardAtomS3R.resetAtomPanelOwned(true,true)
                result=if (reset == 1) 1 else 6|(reset<<8)
            }
        }
    }
    if (!gate.finish(owner,result == 1)) return 7
    return result
}
