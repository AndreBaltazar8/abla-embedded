import "./button_map_shared.ab"
import "./button_frame.ab"
import "../i2c/results.ab"
// Handles are borrowed, configured and caller-owned. No allocation, setup,
// cleanup, bus recovery or PMIC event consumption occurs during a level poll.
// Shared expander input registers are sampled once, including on read failure.
trusted fun M5BoardId.pollButtonLevelsOwned(pi4: int,pm1: int,powerHub: int): M5ButtonFrame {
    var frame=m5ButtonFrame()
    var cachedKind=0
    var cachedKey=-1
    var cached=I2cByteResult(0)
    var index=0
    while (index < 5) {
        val source=if (index == 0) this.buttonASource() else if (index == 1) this.buttonBSource()
            else if (index == 2) this.buttonCSource() else if (index == 3) this.buttonExtSource() else this.buttonPowerSource()
        val kind=source.kind()
        var sample=m5ButtonRead(false)
        if (kind == m5ButtonSourceGpio) sample=m5PollButtonGpio(source.index(),source.activeLow())
        else if (kind == m5ButtonSourcePi4Ioe5v6408 || kind == m5ButtonSourceM5Pm1 || kind == m5ButtonSourcePowerHub) {
            val key=(source.address()<<8)|source.register()
            if (cachedKind != kind || cachedKey != key) {
                val handle=if (kind == m5ButtonSourcePi4Ioe5v6408) pi4 else if (kind == m5ButtonSourceM5Pm1) pm1 else powerHub
                cached=m5PollButtonRegister(kind,handle,source.address(),source.register())
                cachedKind=kind; cachedKey=key
            }
            if (cached.valid()) {
                val high=(cached.value()&source.mask()) != 0
                sample=m5ButtonRead(true,if (source.activeLow()) !high else high)
            }
        }
        frame=frame.withRead(index,sample)
        index=index+1
    }
    frame
}
