import "./rtc_device.ab"
import "./rtc_open_sequence.ab"
@inline
trusted fun m5RtcOpenAllocate(bus: int,board: M5BoardId): int = m5Rtc(I2cBus(bus),board) | 0
@inline
trusted fun m5RtcOpenBegin(rtc: int): bool = M5Rtc(rtc).begin()
@inline
trusted fun m5RtcOpenClose(rtc: int): bool = M5Rtc(rtc).close()
// Bus must already be initialized and remains caller-owned. No hidden global
// RTC slot: success transfers this device handle to the caller, who closes it.
// PowerHub begin only establishes driver readiness (upstream behavior), not
// physical detection. An actual read must still succeed before trusting data.
trusted fun m5RtcOpen(bus: I2cBus,board: M5BoardId): M5RtcOpenResult = m5RtcOpenOwned(bus | 0,board)
fun M5RtcOpenResult.rtc(): M5Rtc = M5Rtc(this.handle())
