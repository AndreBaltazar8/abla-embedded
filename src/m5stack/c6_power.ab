import "./expander_owner.ab"
import "./pmic_open.ab"
import "./c6_power_sequence.ab"
import "../power/bq27220_device.ab"
trusted fun c6PowerWrite(handle: int,register: int,value: int): bool = I2cDevice(handle).writeRegister8(register,value)
trusted fun c6PowerChargeEnable(handle: int): bool = Aw32001(handle).setBatteryCharge(true)
trusted fun c6PowerChargeCurrent(handle: int): bool = Aw32001(handle).setChargeCurrent(100)
trusted fun c6PowerChargeVoltage(handle: int): bool = Aw32001(handle).setChargeVoltage(4200)
trusted fun c6PowerGaugeBegin(handle: int): bool = Bq27220(handle).begin()
// Explicit board-wide initialization, not a resume/readback operation.
// Owns PI4IOE0 configuration, including radio/reset pins and interrupt mask.
// Nesso requires a begun AW32001 and borrowed BQ27220; gauge begin performs
// reset/unseal/full-access and delays. No rollback after partially applied I/O.
// UnitC6L has no AW32001 requirement and ignores the unused charger/gauge.
trusted fun M5Expanders.configureC6Power(charger: M5PmicOpen,gauge: Bq27220): M5C6PowerInit {
    if (!this.ready()) return M5C6PowerInit(3)
    if (this.board() == m5BoardArduinoNessoN1 && (!charger.ready() || charger.kind() != 6)) return M5C6PowerInit(3)
    this.board().configureC6PowerOwned(this.device(0) | 0,charger.deviceHandle(),gauge | 0)
}
