import "./corematrix_sd_sequence.ab"
import "./corematrix_control_sequence.ab"
import "./expander_open.ab"
import "./pmic_open.ab"
import "./corematrix_power.ab"
trusted fun coreMatrixSdControlAdmission(control: int,storage: NativeBuffer,session: NativeBuffer,
    gate: PeripheralGate,scratch: NativeBuffer,response: NativeBuffer): bool {
    val board=M5CoreMatrixControl(control)
    if (!board.ready() || board.sdRetained() || !gate.bufferDisjoint(board.buffer(),64)) return false
    return c61SdSessionDisjoint(board.buffer(),storage,40) && c61SdSessionDisjoint(board.buffer(),session,64) &&
        c61SdSessionDisjoint(board.buffer(),scratch,2) && c61SdSessionDisjoint(board.buffer(),response,16) &&
        softwareI2cProviderBufferSafe(storage,40) && softwareI2cProviderBufferSafe(session,64) &&
        softwareI2cProviderBufferSafe(scratch,2) && softwareI2cProviderBufferSafe(response,16) &&
        softwareI2cProviderBufferSafe(nativeBufferAt(gate.word().address(),4),4)
}
trusted fun coreMatrixSdPower(control: int): int = M5CoreMatrixControl(control).expanders().configureCoreMatrixSdPower()|0
trusted fun coreMatrixSdRetain(control: int): bool = M5CoreMatrixControl(control).retainSd()
trusted fun coreMatrixSdRelease(control: int): void = M5CoreMatrixControl(control).releaseSd()
