// M5Unified::_begin_audio cold-start defaults, Copyright(c)2021 M5Stack, MIT.
// See THIRD_PARTY_NOTICES.md. No detection, power callback or driver startup.
// Built-in microphone only: external Atomic Echo/SPK accessories can override
// these pins upstream and require separate explicit accessory configuration.
import "./board_id.ab"
import "../audio/pdm_pins.ab"
val m5MicrophoneNone=0
val m5MicrophonePdm=1
val m5MicrophoneI2s=2
val m5MicrophoneAdc=3
// Four6-bit pins(encoded+1),transport2,port1,channel2,gain8,oversampling4,Hz17.
// One scalar; channel0 right,1 left,2 stereo. These are defaults, not a policy
// to overwrite user configuration or proof a board/attached microphone exists.
type M5MicrophoneProfile=int
fun m5MicrophoneProfile(mode: int,data: int,ws: int,bclk: int = -1,mclk: int = -1,
    port: int = 0,channel: int = 0,gain: int = 16,oversampling: int = 1,hz: int = 16000): M5MicrophoneProfile {
    if (mode < 1 || mode > 3 || data < 0 || data > 62 || ws < -1 || ws > 62 || bclk < -1 || bclk > 62 || mclk < -1 || mclk > 62 ||
        port < 0 || port > 1 || channel < 0 || channel > 2 || gain < 0 || gain > 255 || oversampling < 1 || oversampling > 8 || hz < 1 || hz > 131071) return M5MicrophoneProfile(0)
    return M5MicrophoneProfile((data+1)|((ws+1)<<6)|((bclk+1)<<12)|((mclk+1)<<18)|
        (mode<<24)|(port<<26)|(channel<<27)|(gain<<29)|(oversampling<<37)|(hz<<41))
}
fun M5MicrophoneProfile.transport(): int = (this>>>24)&3
fun M5MicrophoneProfile.available(): bool = (this>>>58) == 0 && this.transport() != 0 && this.dataPin() >= 0 &&
    this.channel() <= 2 && this.oversampling() >= 1 && this.oversampling() <= 8 && this.sampleRate() > 0
fun M5MicrophoneProfile.dataPin(): int = (this&63)-1
fun M5MicrophoneProfile.wordSelectPin(): int = ((this>>>6)&63)-1
fun M5MicrophoneProfile.bitClockPin(): int = ((this>>>12)&63)-1
fun M5MicrophoneProfile.masterClockPin(): int = ((this>>>18)&63)-1
fun M5MicrophoneProfile.port(): int = (this>>>26)&1
fun M5MicrophoneProfile.channel(): int = (this>>>27)&3
fun M5MicrophoneProfile.gain(): int = (this>>>29)&255
fun M5MicrophoneProfile.oversampling(): int = (this>>>37)&15
fun M5MicrophoneProfile.sampleRate(): int = (this>>>41)&131071
fun M5MicrophoneProfile.pdmPins(): PdmPins = if (this.available() && this.transport() == m5MicrophonePdm) pdmPins(this.wordSelectPin(),this.dataPin()) else PdmPins(0)
fun M5MicrophoneProfile.pdmSlotMask(): int = if (!this.available() || this.transport() != m5MicrophonePdm) 0 else if (this.channel() == 2) 3 else if (this.channel() == 1) 1 else 2

fun M5BoardId.microphoneProfile(): M5MicrophoneProfile {
    if (this == m5BoardCoreP4X) return m5MicrophoneProfile(2,5,4,6,2,0,2,2,1,24000)
    if (this == m5BoardTab5 || this == m5BoardTab5X) return m5MicrophoneProfile(2,28,29,27,30,0,2,2)
    if (this == m5BoardStackCoreS3 || this == m5BoardStackCoreS3SE || this == m5BoardStackChan) return m5MicrophoneProfile(2,14,33,34,0,1,2,2)
    if (this == m5BoardStickS3 || this == m5BoardStopWatch) return m5MicrophoneProfile(2,16,15,17,18,1)
    if (this == m5BoardPaperColor) return m5MicrophoneProfile(2,39,41,40,42,1,1)
    if (this == m5BoardChainCaptain) return m5MicrophoneProfile(2,39,41,38,40,1)
    if (this == m5BoardCardputerADV) return m5MicrophoneProfile(2,46,43,41)
    if (this == m5BoardAtomVoiceS3R) return m5MicrophoneProfile(2,4,3,17,11,1,2,1)
    if (this == m5BoardPaperMono) return m5MicrophoneProfile(1,46,45)
    if (this == m5BoardAtomS3U) return m5MicrophoneProfile(1,38,39)
    if (this == m5BoardCardputer) return m5MicrophoneProfile(1,46,43)
    if (this == m5BoardCapsule) return m5MicrophoneProfile(1,41,40)
    if (this == m5BoardStickC || this == m5BoardStickCPlus || this == m5BoardStickCPlus2 || this == m5BoardTough || this == m5BoardStackCore2) return m5MicrophoneProfile(1,34,0)
    if (this == m5BoardAtomU) return m5MicrophoneProfile(1,19,5)
    if (this == m5BoardAtomVoice) return m5MicrophoneProfile(1,23,33)
    // M5Stack Basic's configured microphone is on the optional M5GO bottom.
    if (this == m5BoardStack) return m5MicrophoneProfile(3,34,-1,-1,-1,0,0,16,4)
    return M5MicrophoneProfile(0)
}
// True means upstream requires additional codec/PMIC/rail sequencing. False
// does not prove external power or pin ownership; it only describes callback.
fun M5BoardId.microphoneNeedsEnableSequence(): bool =
    this == m5BoardCoreP4X || this == m5BoardTab5 || this == m5BoardTab5X ||
    this == m5BoardStackCoreS3 || this == m5BoardStackCoreS3SE || this == m5BoardStackChan ||
    this == m5BoardStickS3 || this == m5BoardStopWatch || this == m5BoardPaperColor ||
    this == m5BoardPaperMono || this == m5BoardChainCaptain || this == m5BoardCardputerADV ||
    this == m5BoardStickC || this == m5BoardStickCPlus || this == m5BoardAtomVoiceS3R
