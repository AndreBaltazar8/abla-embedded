import "./i2c_pin_map.ab"
import "./rtc_profile.ab"
import "./power_profile.ab"
// Static configuration, not initialized hardware or an ownership token.
// Grove and the internal devices share one physical I2C bus on CoreMatrix.
type M5CoreMatrix = int
fun m5CoreMatrix(): M5CoreMatrix = M5CoreMatrix(152)
fun M5CoreMatrix.boardId(): M5BoardId = m5BoardCoreMatrix
fun M5CoreMatrix.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5CoreMatrix.rtcKind(): M5RtcKind = this.boardId().rtcKind()
fun M5CoreMatrix.powerKind(): M5PowerKind = this.boardId().powerKind()
