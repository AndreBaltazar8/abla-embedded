// Exclusive board-wide initialization, not a live audio resume operation.
// Caller has settled board power/I2C and stopped both I2S/GDMA directions.
// Rails stay on after failure; never silently roll back shared PMIC settings.
// Status1 ready,2 invalid,3 expander configuration,4 PMIC configuration,
// 5 codec quieting. Fields preserve both quieting results independently.
type CoreS3AudioPowerResult = int
fun CoreS3AudioPowerResult.status(): int = this & 255
fun CoreS3AudioPowerResult.valid(): bool = this.status() == 1
fun CoreS3AudioPowerResult.speakerStatus(): int = (this >>> 8) & 2047
fun CoreS3AudioPowerResult.microphoneStatus(): int = (this >>> 19) & 1023

trusted fun cores3InitializeAudioPower(power: Axp2101, expander: Aw9523,
    amplifier: Aw88298, microphone: Es7210): CoreS3AudioPowerResult {
    if (!power.valid() || !expander.valid() || !amplifier.valid() ||
        !microphone.valid()) return CoreS3AudioPowerResult(2)
    var status = 1
    if (!cores3ConfigureExpander(expander, false)) status = 3
    else if (!cores3ConfigurePmic(power)) status = 4
    // Expander initialization sets the speaker enable latch. Always quiet
    // both codecs, including after partial board configuration failure.
    val speaker = cores3SpeakerDisable(amplifier, expander)
    val mic = cores3MicrophoneDisable(microphone)
    if (status == 1 && (!speaker.valid() || !mic.valid())) status = 5
    CoreS3AudioPowerResult(status | ((speaker & 2047) << 8) |
        ((mic & 1023) << 19))
}
