import "./papermono_sdmmc_esp32s3.ab"
import "./papermono_sdmmc_close_sequence.ab"
import "../sd/mmc_shutdown_esp32s3.ab"
trusted fun paperMonoSdMmcCloseBegin(context: NativeBuffer): int = sdMmcStartupCloseBeginOwned(context,true)
trusted fun paperMonoSdMmcClosePoll(context: NativeBuffer): int = sdMmcStartupClosePollOwned(context)
trusted fun paperMonoSdMmcRestore(snapshot: NativeBuffer): int = sdMmcPinsRestoreOwned(snapshot,true)
