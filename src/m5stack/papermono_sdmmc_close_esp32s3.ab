import "./papermono_sdmmc_esp32s3.ab"
import "./papermono_sdmmc_close_sequence.ab"
import "../sd/mmc_shutdown_esp32s3.ab"
import "../hal/m5stack.ab"
@export("paperMonoSdMmcCloseBegin")
trusted fun paperMonoSdMmcCloseBeginHook(context: NativeBuffer): int = sdMmcStartupCloseBeginOwned(context,true)
@export("paperMonoSdMmcClosePoll")
trusted fun paperMonoSdMmcClosePollHook(context: NativeBuffer): int = sdMmcStartupClosePollOwned(context)
@export("paperMonoSdMmcRestore")
trusted fun paperMonoSdMmcRestoreHook(snapshot: NativeBuffer): int = sdMmcPinsRestoreOwned(snapshot,true)
