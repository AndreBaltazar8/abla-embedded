import "./touch_profile.ab"
import "../touch/cst816s_session.ab"
import "../touch/cst3530_owner.ab"
// Board power/reset/IRQ and matching bus are caller-prepared, not configured
// here. CST816S allocates a pending session; CST3530 initializes immediately.
trusted fun M5BoardId.openCst816sTouch(bus: I2cBus): Cst816sSession {
    val profile=this.touchProfile()
    if (!profile.valid() || profile.kind() != 4) return Cst816sSession(0)
    openCst816sSession(bus,profile.address(),profile.frequency())
}
trusted fun M5BoardId.openCst3530Touch(bus: I2cBus): Cst3530Owner {
    val profile=this.touchProfile()
    if (!profile.valid() || profile.kind() != 5) return Cst3530Owner(0)
    openCst3530(bus,profile.address(),profile.frequency())
}
