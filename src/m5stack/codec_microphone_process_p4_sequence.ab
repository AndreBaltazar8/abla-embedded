import "../audio/microphone_process.ab"
import "./corep4x_audio_storage.ab"
// Low8:1processed2preflight3busy4DMAfailure5malformedframe6DSPfailure.
// High32 output sample count. Full DMA report remains in session48/52.
type M5P4MicrophoneBlockResult=int
fun M5P4MicrophoneBlockResult.status(): int = this&255
fun M5P4MicrophoneBlockResult.samples(): int = this >>> 32
// DSP40B initialized inputStereo=true,adc=false,swap=false. Hardware24kHz /
// oversampling is output rate; default board gain2, optional filter. Reserve
// worst-case full-block output BEFORE pumping, but process only actual bytes.
// Ring cache-line padding/strided gaps also remain DMA-owned. Session, DSP,
// raw and output must be disjoint. No reconfiguration or synthetic samples.
trusted fun m5P4MicrophoneProcessBlockOwned(r: NativeBuffer,state: NativeBuffer,
    raw: NativeBuffer,output: NativeBuffer,stereo: bool,bits16: bool,exclusive: bool,tab5: bool): M5P4MicrophoneBlockResult {
    if (!exclusive || !m5P4MicrophoneSessionValid(r,tab5) || r.loadU32(68) != 2 ||
        r.loadU32(12) != 0 || !state.hasAddressRange(0,40) ||
        (state.loadU32(4)&7340032) != 1048576) return M5P4MicrophoneBlockResult(2)
    val bytes=r.loadU32(36)
    if (bytes < 4 || (bytes&3) != 0 ||
        !esp32p4AhbGdmaRingLayoutValid(r.loadU32(20),r.loadU32(24),r.loadU32(28),r.loadU32(32),bytes)) return M5P4MicrophoneBlockResult(2)
    val maximum=microphoneProcessRequiredSamples(state,raw,bytes/4,output,stereo,bits16)
    if (maximum < 0 || !coreP4xMicrophoneStorageDisjoint(r,state,40) ||
        !coreP4xMicrophoneStorageDisjoint(r,raw,bytes) ||
        !coreP4xMicrophoneStorageDisjoint(r,output,maximum*(if (bits16) 2 else 1))) return M5P4MicrophoneBlockResult(2)
    val pumped=m5P4MicrophonePumpOwned(r,raw,tab5)
    if (pumped != 2) return M5P4MicrophoneBlockResult(4)
    val report=r.loadU32(48)
    if ((report&255) == 3) return M5P4MicrophoneBlockResult(3)
    if ((report&255) != 1) return M5P4MicrophoneBlockResult(4)
    val actual=(report >>> 16)&4095
    if (actual < 4 || actual > bytes || (actual&3) != 0) {
        r.storeU32(68,3);return M5P4MicrophoneBlockResult(5)
    }
    val samples=microphoneProcessRequiredSamples(state,raw,actual/4,output,stereo,bits16)
    val written=microphoneProcess(state,raw,actual/4,output,stereo,bits16)
    if (samples < 0 || written != samples) { r.storeU32(68,3);return M5P4MicrophoneBlockResult(6) }
    return M5P4MicrophoneBlockResult(1|(written << 32))
}
