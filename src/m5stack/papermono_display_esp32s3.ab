import "./pm1_control_esp32s3.ab"
import "./papermono_display_power.ab"
import "../esp32/gpio_esp32s3.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
// Power/reset only, NOT a ready panel. This resets the touch controller too.
// Caller releases CS16 RTC/holds/peripheral routing and quiesces SD/touch/EPD.
// PM1 control open must already have consumed desired wake evidence.
trusted fun M5Pm1Control.preparePaperMonoDisplayOwned(exclusive: bool): int {
    if (!exclusive || !this.ready() || this.board() != m5BoardPaperMono) return 3
    if (!Pin(16).outputLevelOwned(true)) return 5
    return paperMonoDisplayPowerOwned(M5Ioe1(this.expanders().device(0)|0),true)
}
