import "../io_expander/m5ioe1_device.ab"
// IOE GPIO11 is bit10. Preload LOW before output mode so a stale HIGH latch
// cannot briefly connect the charger. Caller owns the shared IOE registers.
// On failure keep ownership: earlier writes may already have taken effect.
trusted fun M5Ioe1.preparePaperMonoCharger(): bool =
    this.digitalWrite(10,false) && this.setHighImpedance(10,false) && this.setDirection(10,true)
