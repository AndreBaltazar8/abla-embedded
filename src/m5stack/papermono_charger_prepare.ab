import "../io_expander/m5ioe1_device.ab"
import "../hal/m5ioe1.ab"
import "../io_expander/m5ioe1_type.ab"
// IOE GPIO11 is bit10. Preload LOW before output mode so a stale HIGH latch
// cannot briefly connect the charger. Caller owns the shared IOE registers.
// On failure keep ownership: earlier writes may already have taken effect.
@exportLocal("abla_m5ioe1_preparePaperMonoCharger")
trusted fun m5Ioe1PreparePaperMonoChargerHook(recv: int): bool =
    M5Ioe1(recv).digitalWrite(10,false) && M5Ioe1(recv).setHighImpedance(10,false) && M5Ioe1(recv).setDirection(10,true)
