import "./pm1_control_esp32s3.ab"
import "./chaincaptain_display_power.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
// Checked rail/reset/backlight only. This does NOT initialize the ST7789/SPI,
// allocate a framebuffer or prove the panel is present.
trusted fun M5Pm1Control.prepareChainDisplayOwned(reset: bool,brightness: int,exclusiveCsInactivePwm: bool): int {
    if (!this.ready() || this.board() != m5BoardChainCaptain || !exclusiveCsInactivePwm ||
        chainCaptainBacklightDuty(brightness) < 0) return 3
    val io=M5Ioe1(this.expanders().device(0)|0)
    val power=chainCaptainDisplayPowerOwned(io,reset,true)
    if ((power&255) != 1) return power
    val backlight=chainCaptainBacklightPrepareOwned(io,brightness,true)
    if ((backlight&255) != 1) return backlight|(1<<16)
    return 1
}
