import "./display_software.ab"
import "../spi/software_sd_mode.ab"

// CoreS3/SE onboard SPI: LCD CS3, SD CS4; GPIO35 is SD MISO/LCD D/C.
// Board initialization must be serialized through its entire lifecycle, not
// just individual transactions. Do not let clients draw before SD preparation.
// Caller owns the pads and has initialized board power; no hidden rail changes.
trusted fun M5BoardId.configureCoreS3SpiPins(gate: PeripheralGate, owner: u32): SpiTransactionResult {
    if (!this.displaySharedDataCommand() || !this.softwareDisplay().valid() ||
        !Pin(4).outputCapable()) return SpiTransactionResult(3 << 32)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3) << 32)
    // Set BOTH inactive latches before enabling either select output. Release
    // shared MISO before enabling clock/MOSI; their latches precede output too.
    Pin(3).write(true)
    Pin(4).write(true)
    Pin(3).output()
    Pin(4).output()
    Pin(35).input()
    Pin(36).write(false)
    Pin(37).write(true)
    Pin(36).output()
    Pin(37).output()
    if (!gate.finish(owner, true)) return SpiTransactionResult(5 << 32)
    SpiTransactionResult(1 << 32)
}

// Call after configureCoreS3SpiPins, before any display command. Preserves
// low-level response bytes/reset flag; success is not SD presence/readiness.
trusted fun M5BoardId.prepareCoreS3SdSpi(gate: PeripheralGate, owner: u32): SpiTransactionResult {
    if (!this.displaySharedDataCommand()) return SpiTransactionResult(3 << 32)
    softwareSdPrepareSpi(gate, owner, Pin(36), Pin(37), Pin(35), Pin(4), 2)
}
