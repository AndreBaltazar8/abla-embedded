import "./rtc_profile.ab"
// Caller-buffer variants use 7 bytes for full date/time, 4 for date, 3 for time.
// The buffer is borrowed only for this synchronous call and never retained.

trusted fun M5Rtc.dateTimeWithBuffer(bytes: NativeBuffer): RtcDateTime {
    if (!this.valid()) return RtcDateTime(0)
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).dateTimeWithBuffer(bytes)
    if (this.kind() == m5RtcPowerHub) return PowerHubRtc(this.handle()).dateTimeWithBuffer(bytes)
    Pcf8563(this.handle()).dateTimeWithBuffer(bytes)
}

trusted fun M5Rtc.dateWithBuffer(bytes: NativeBuffer): RtcDate {
    if (!this.valid()) return RtcDate(0)
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).dateWithBuffer(bytes)
    if (this.kind() == m5RtcPowerHub) return PowerHubRtc(this.handle()).dateWithBuffer(bytes)
    Pcf8563(this.handle()).dateWithBuffer(bytes)
}

trusted fun M5Rtc.timeWithBuffer(bytes: NativeBuffer): RtcTime {
    if (!this.valid()) return RtcTime(0)
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).timeWithBuffer(bytes)
    if (this.kind() == m5RtcPowerHub) return PowerHubRtc(this.handle()).timeWithBuffer(bytes)
    Pcf8563(this.handle()).timeWithBuffer(bytes)
}

trusted fun M5Rtc.setDateTimeWithBuffer(value: RtcDateTime,bytes: NativeBuffer): bool {
    if (!this.valid()) return false
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).setDateTimeWithBuffer(value,bytes)
    if (this.kind() == m5RtcPowerHub) return PowerHubRtc(this.handle()).setDateTimeWithBuffer(value,bytes)
    Pcf8563(this.handle()).setDateTimeWithBuffer(value,bytes)
}

trusted fun M5Rtc.setDateWithBuffer(value: RtcDate,bytes: NativeBuffer): bool {
    if (!this.valid()) return false
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).setDateWithBuffer(value,bytes)
    if (this.kind() == m5RtcPowerHub) return PowerHubRtc(this.handle()).setDateWithBuffer(value,bytes)
    Pcf8563(this.handle()).setDateWithBuffer(value,bytes)
}

trusted fun M5Rtc.setTimeWithBuffer(value: RtcTime,bytes: NativeBuffer): bool {
    if (!this.valid()) return false
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).setTimeWithBuffer(value,bytes)
    if (this.kind() == m5RtcPowerHub) return PowerHubRtc(this.handle()).setTimeWithBuffer(value,bytes)
    Pcf8563(this.handle()).setTimeWithBuffer(value,bytes)
}
import "../rtc/pcf8563_device.ab"
import "../rtc/rx8130_device.ab"
import "../rtc/powerhub_device.ab"
// Scalar tagged handle, no allocation/vtable beyond the chosen I2C backend's
// device slot. Import with an I2cBus backend. Bus ownership stays with caller;
// close releases only this device. Construction does not initialize hardware.
type M5Rtc = int
trusted fun m5Rtc(bus: I2cBus,board: M5BoardId): M5Rtc {
    val kind=board.rtcKind()
    val handle=if (kind == m5RtcRx8130) rx8130(bus) & 0xFFFFFFFF
        else if (kind == m5RtcPowerHub) powerHubRtc(bus) & 0xFFFFFFFF else pcf8563(bus) & 0xFFFFFFFF
    if (handle == 0) M5Rtc(0) else M5Rtc(handle | (kind<<32))
}
fun M5Rtc.valid(): bool = (this & 0xFFFFFFFF) != 0 && (this>>>32) >= 1 && (this>>>32) <= 3
fun M5Rtc.kind(): M5RtcKind = M5RtcKind(this>>>32)
fun M5Rtc.handle(): int = this & 0xFFFFFFFF
fun M5Rtc.supportsWeekdayAlarm(): bool = this.valid() && this.kind() != m5RtcPowerHub
trusted fun M5Rtc.setAlarmInterruptChecked(minute: int=-1,hour: int=-1,day: int=-1,weekday: int=-1): RtcAlarmResult =
    this.setAlarmInterruptWithBuffer(nativeBufferAt(nativeStackAllocate(4),4),minute,hour,day,weekday)
trusted fun M5Rtc.setAlarmInterruptWithBuffer(bytes: NativeBuffer,minute: int=-1,hour: int=-1,day: int=-1,weekday: int=-1): RtcAlarmResult {
    if (!this.valid()) return RtcAlarmResult(2)
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).setAlarmInterruptWithBuffer(bytes,minute,hour,day,weekday)
    if (this.kind() == m5RtcPowerHub) {
        if (weekday < -1 || weekday > 6) return RtcAlarmResult(2)
        if (weekday >= 0) return RtcAlarmResult(6)
        return PowerHubRtc(this.handle()).setAlarmInterruptWithBuffer(bytes,minute,hour,day)
    }
    Pcf8563(this.handle()).setAlarmInterruptWithBuffer(bytes,minute,hour,day,weekday)
}
// PowerHub exposes alarms, but no countdown timer in its upstream protocol.
fun M5Rtc.supportsTimerInterrupt(): bool = this.valid() && this.kind() != m5RtcPowerHub
trusted fun M5Rtc.setTimerInterruptChecked(milliseconds: int): RtcTimerResult {
    if (!this.valid()) return RtcTimerResult(2)
    if (!this.supportsTimerInterrupt()) return RtcTimerResult(6)
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).setTimerInterruptChecked(milliseconds)
    Pcf8563(this.handle()).setTimerInterruptChecked(milliseconds)
}
trusted fun M5Rtc.setTimerInterruptWithBuffers(milliseconds: int,preset: NativeBuffer,verify: NativeBuffer): RtcTimerResult {
    if (!this.valid()) return RtcTimerResult(2)
    if (!this.supportsTimerInterrupt()) return RtcTimerResult(6)
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).setTimerInterruptWithBuffers(milliseconds,preset,verify)
    Pcf8563(this.handle()).setTimerInterruptChecked(milliseconds)
}
trusted fun M5Rtc.lowVoltageChecked(): I2cByteResult {
    if (!this.valid()) return I2cByteResult(0)
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).lowVoltageChecked()
    if (this.kind() == m5RtcPowerHub) return PowerHubRtc(this.handle()).lowVoltageChecked()
    Pcf8563(this.handle()).lowVoltageChecked()
}
trusted fun M5Rtc.lowVoltage(): bool {
    val result=this.lowVoltageChecked()
    result.valid() && result.value() != 0
}
// PowerHub's upstream RTC driver has no interrupt-status implementation.
// Explicit capability + invalid result, never a successful "not pending".
fun M5Rtc.supportsInterruptStatus(): bool = this.valid() && this.kind() != m5RtcPowerHub
trusted fun M5Rtc.interruptPendingChecked(): I2cByteResult {
    if (!this.supportsInterruptStatus()) return I2cByteResult(0)
    if (this.kind() == m5RtcRx8130) return Rx8130(this.handle()).interruptPendingChecked()
    Pcf8563(this.handle()).interruptPendingChecked()
}
trusted fun M5Rtc.clearInterrupt(): bool {
    if (!this.valid()) return false
