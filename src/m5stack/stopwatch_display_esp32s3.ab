import "./pm1_control_esp32s3.ab"
import "./stopwatch_display_power.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
// Only power and shared OLED/touch reset; not a ready display or touch device.
// Caller owns all mentioned pads/rails and stopped SPI/audio/touch consumers.
// GPIO39 must already be released from pad holds and other peripheral routes.
trusted fun M5Pm1Control.prepareStopWatchDisplayOwned(exclusive: bool): int {
    if (!exclusive || !this.ready() || this.board() != m5BoardStopWatch) return 3
    if (!Pin(39).outputLevelOwned(true)) return 5
    return stopWatchDisplayPowerOwned(M5Pm1(this.pmic().deviceHandle()),
        M5Ioe1(this.expanders().device(0)|0),true)
}
