import "./board_id.ab"
// 1 success, 2 unsupported board/chip, 3 invalid handle/level,
// 4 high-impedance configuration failed, 5 direction failed, 6 output failed.
// Failure can leave earlier writes applied. No implicit retry or rollback;
// the caller retains ownership and must explicitly disable/recover the motor.
type M5VibrationResult = int
fun M5VibrationResult.status(): int = this | 0
fun M5VibrationResult.ok(): bool = this == 1
fun m5VibrationHandleValid(handle: int): bool = handle > 0 && handle <= 4294967295
trusted fun M5BoardId.setAxpVibrationOwned(handle: int,identity: int,level: int): M5VibrationResult {
    if (this != m5BoardStackCore2 || (identity != 3 && identity != 74)) return M5VibrationResult(2)
    if (!m5VibrationHandleValid(handle) || level < 0 || level > 255) return M5VibrationResult(3)
    val millivolts=if (level == 0) 0 else 480+level*12
    M5VibrationResult(if (m5VibrationVoltage(handle,identity,millivolts)) 1 else 6)
}
trusted fun M5BoardId.setExpanderVibrationOwned(handle: int,level: int): M5VibrationResult {
    if (this != m5BoardStopWatch) return M5VibrationResult(2)
    if (!m5VibrationHandleValid(handle) || level < 0 || level > 255) return M5VibrationResult(3)
    if (level != 0) {
        // Upstream IO9 is zero-based pin8; PWM1 is zero-based channel0.
        if (!m5VibrationHighImpedance(handle,8,false)) return M5VibrationResult(4)
        if (!m5VibrationDirection(handle,8,true)) return M5VibrationResult(5)
    }
    M5VibrationResult(if (m5VibrationPwm(handle,0,level*4095/255,level != 0)) 1 else 6)
}
