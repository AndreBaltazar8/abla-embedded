// Tab5/Tab5X control bus GPIO31/32. Caller exclusively owns the selected
// software-I2C provider, both pads and RCC serialization for this lifecycle.
// Source clocks/ROM delay calibrated, pads not globally held, prior peripheral
// users stopped. Individual holds must already be released safely by caller.
// No implicit board reset, power-table write or hold release.
// Packed bus epoch0..23, clock owner24..33, status40..47, partial bus48.
type Tab5ControlBus = int
fun Tab5ControlBus.status(): int = (this>>>40)&255
fun Tab5ControlBus.busHandle(): int = this&16777215
fun Tab5ControlBus.clockOwner(): int = (this>>>24)&1023
fun Tab5ControlBus.partialBus(): bool = (this&(1<<48)) != 0
fun Tab5ControlBus.ready(): bool = this.status() == 1 && this.busHandle() != 0
// 0closed,1ready,2invalid,3provider occupied,4clock,5pad held,
// 6bus setup,7bus teardown,8clock teardown. Failures retain ownership.
trusted fun tab5ControlBusOpenOwned(layout: int): Tab5ControlBus {
    if (layout != 1 && layout != 3) return Tab5ControlBus(2<<40)
    if (!tab5ControlProviderFree()) return Tab5ControlBus(3<<40)
    val clock=tab5ControlClockOpen(layout)
    val base=clock<<24
    if ((clock&255) != 1) return Tab5ControlBus(base|(4<<40))
    if (tab5ControlHold(layout,31) != 0 || tab5ControlHold(layout,32) != 0) return Tab5ControlBus(base|(5<<40))
    val bus=tab5ControlBusOpen()
    if (bus == 0) return Tab5ControlBus(base|(6<<40)|(if (tab5ControlBusPartial()) 1<<48 else 0))
    return Tab5ControlBus(base|bus|(1<<40))
}
// All child expander/touch/sensor owners and users must be closed/joined first.
// Never gate clocks after bus teardown failure; repeated close retries only
// remaining resources. Does not undo board power configuration.
trusted fun Tab5ControlBus.closeOwned(): Tab5ControlBus {
    if (this < 0 || (this>>>49) != 0 || this.status() > 8) return this
    val clock=this.clockOwner()
    if (this.busHandle() != 0) {
        if (!tab5ControlBusClose(this.busHandle())) return Tab5ControlBus((this&((1<<34)-1))|(7<<40))
    } else if (this.partialBus()) {
        if (!tab5ControlBusAbort()) return Tab5ControlBus((clock<<24)|(7<<40)|(1<<48))
    }
    val remaining=tab5ControlClockClose(clock)
    if (remaining != 0) return Tab5ControlBus((remaining<<24)|(8<<40))
    return Tab5ControlBus(0)
}
