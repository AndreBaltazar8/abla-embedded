import "./atom_s3_panel.ab"
import "../spi/software_register_read.ab"
// One explicit RDDID transaction on caller-owned powered/reset/configured
// AtomS3/R pads. Returns raw ID on success; classify with atomS3PanelFromId.
// Deselect+eight idle clocks, command04, one dummy bit, four received bytes.
// halfPeriod is a MINIMUM software edge delay, not a guaranteed bus rate.
// In particular this does not claim the upstream8MHz hardware first probe.
trusted fun M5BoardId.readAtomPanelIdChecked(gate: PeripheralGate,owner: u32,halfPeriod: int = 1): SpiTransactionResult {
    val pins=this.gc9107DisplayPins()
    if (!pins.available()) return SpiTransactionResult(3<<32)
    return softwareSpiReadRegister32Shared(gate,owner,Pin(pins.clock()),Pin(pins.mosi()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),4,1,halfPeriod,true)
}
