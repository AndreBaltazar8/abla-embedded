// M5Unified Tab5/Tab5X callback: ES7210 MIC1/2 stereo, MIC3/4 powered down.
// Caller owns initialized codec/control bus and matching live clocks. No rail
// or DMA ownership is implied. 1complete2invalid3codec; retain on failure.
trusted fun tab5MicrophoneOwned(codec: Es7210,enabled: bool,exclusive: bool): int {
    if (!exclusive || !codec.valid()) return 2
    return if (if (enabled) codec.configureStereoMic12() else codec.reset()) 1 else 3
}
