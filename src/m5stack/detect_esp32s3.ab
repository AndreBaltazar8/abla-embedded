import "./detect_logic.ab"
import "./detect_s3_sequence.ab"
import "./detect_s3_observations_sequence.ab"
import "../esp32/gpio_probe_esp32s3.ab"
import "../esp32/gpio/snapshot_esp32s3.ab"

import "../esp32/soc/identity_esp32s3.ab"

trusted fun m5DetectCurrentEsp32S3Owned(record: NativeBuffer,current: M5BoardId,exclusive: bool): int {
    // Preserve explicit board selection and denied ownership without MMIO.
    val package=if (current == m5BoardUnknown && exclusive) esp32S3PackageVersion() else -1
    return m5S3OwnedDetectBegin(record,current,package,exclusive)
}


// Legacy prepared-pad entry: caller must already own/configure GPIO mux and
// matrix routing. Prefer the Owned entry above when original routing must be
// restored and cleanup failures retained for retry.
trusted fun m5DetectCurrentEsp32S3(
    current: M5BoardId = m5BoardUnknown
): M5BoardId {
    if (current != m5BoardUnknown) return current
    val packageVersion = esp32S3PackageVersion()
    if (packageVersion == 0) return m5DetectEsp32S3Qfn56Hardware()
    if (packageVersion == 1) return m5DetectEsp32S3PicoHardware()
    m5BoardUnknown
}
