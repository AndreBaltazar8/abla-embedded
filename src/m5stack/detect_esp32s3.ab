import "./detect_logic.ab"
import "../esp32/gpio_probe_esp32s3.ab"

trusted noescape extern:"c" fun esp_efuse_get_pkg_ver(): u32

trusted fun m5ProbeI2cEsp32S3(
    sda: int,
    scl: int,
    firstAddress: int,
    secondAddress: int = -1
): int {
    val sdaState = gpioProbeCaptureEsp32S3(sda)
    val sclState = gpioProbeCaptureEsp32S3(scl)
    if (!gpioProbeStateValid(sdaState) || !gpioProbeStateValid(sclState)) {
        return 0
    }
    var observations = 0
    if (gpioProbeI2cAddress(sda, scl, firstAddress)) {
        observations = observations | 1
    }
    if (secondAddress >= 0 && gpioProbeI2cAddress(
            sda, scl, secondAddress
        )) observations = observations | 2
    // Also recover the bus after a partially completed failed transaction.
    gpioProbeI2cStop(sda, scl)
    sdaState.restore(sda)
    sclState.restore(scl)
    observations
}

trusted fun m5DetectEsp32S3Qfn56Hardware(): M5BoardId {
    val state4 = gpioProbeCaptureEsp32S3(4)
    val state8 = gpioProbeCaptureEsp32S3(8)
    val state10 = gpioProbeCaptureEsp32S3(10)
    val state12 = gpioProbeCaptureEsp32S3(12)
    val state38 = gpioProbeCaptureEsp32S3(38)
    val captured = gpioProbeStateValid(state4) &&
        gpioProbeStateValid(state8) && gpioProbeStateValid(state10) &&
        gpioProbeStateValid(state12) && gpioProbeStateValid(state38)
    var observations = 0
    if (captured && gpioProbeInput(4, 1) && gpioProbeInput(12, 1) &&
        gpioProbeInput(38, 1) && gpioProbeInput(8, 1) &&
        gpioProbeInput(10, 1) && gpioProbeInput(4, 0) &&
        gpioProbeInput(12, 0) && gpioProbeInput(38, 0)) {
        if (gpioProbeRead(8)) observations = observations | 1
        if (gpioProbeRead(10)) observations = observations | 2
        if (gpioProbeRead(4)) observations = observations | 4
        if (gpioProbeRead(12)) observations = observations | 8
        if (gpioProbeRead(38)) observations = observations | 16
        gpioProbeInput(38, 3)
        gpioProbeDelayMicroseconds(1000)
        if (gpioProbeRead(38)) observations = observations | 32
    }
    if (gpioProbeStateValid(state4)) state4.restore(4)
    if (gpioProbeStateValid(state8)) state8.restore(8)
    if (gpioProbeStateValid(state10)) state10.restore(10)
    if (gpioProbeStateValid(state12)) state12.restore(12)
    if (gpioProbeStateValid(state38)) state38.restore(38)
    if (!captured) return m5BoardUnknown

    var board = m5DetectEsp32S3Qfn56(m5BoardUnknown, observations)
    if (board == m5BoardCapsule) {
        val sdaState = gpioProbeCaptureEsp32S3(13)
        val sclState = gpioProbeCaptureEsp32S3(15)
        if (gpioProbeStateValid(sdaState) && gpioProbeStateValid(sclState)) {
            gpioProbeI2cStop(13, 15)
            sdaState.restore(13)
            sclState.restore(15)
        }
    }
    if (board == m5BoardUnknown) {
        gpioProbeDelayMicroseconds(50000)
        val powerHub = m5ProbeI2cEsp32S3(45, 48, 80) != 0
        board = m5DetectEsp32S3Qfn56(
            m5BoardUnknown, observations, powerHub
        )
    }
    board
}

trusted fun m5DetectEsp32S3PicoHardware(): M5BoardId {
    // Onboard devices need one power-stabilization wait, not one per address.
    gpioProbeDelayMicroseconds(50000)
    val internal = m5ProbeI2cEsp32S3(45, 0, 104, 105)
    val bmi270Present = internal != 0
    var voiceCodecPresent = false
    var stampBatteryControllerPresent = false
    if (!bmi270Present) {
        voiceCodecPresent = m5ProbeI2cEsp32S3(45, 0, 24) != 0
    }
    if (!bmi270Present && !voiceCodecPresent) {
        stampBatteryControllerPresent =
            m5ProbeI2cEsp32S3(48, 47, 110) != 0
    }
    m5DetectEsp32S3Pico(
        m5BoardUnknown, bmi270Present, voiceCodecPresent,
        stampBatteryControllerPresent
    )
}

trusted fun m5DetectCurrentEsp32S3(
    current: M5BoardId = m5BoardUnknown
): M5BoardId {
    if (current != m5BoardUnknown) return current
    val packageVersion = esp_efuse_get_pkg_ver()
    if (packageVersion == 0) return m5DetectEsp32S3Qfn56Hardware()
    if (packageVersion == 1) return m5DetectEsp32S3PicoHardware()
    m5BoardUnknown
}
