import "./pm1_control_sequence.ab"
import "./rtc_open_sequence.ab"
// Opt-in retained RX8130 child for the three PM1 S3 boards. Existing independent
// RTC APIs remain unchanged. Offset20 retains the underlying32-bit device;
// these boards all use RX8130, so close additionally checks the exact kind tag.
// Caller serializes the full parent/child lifecycle and retains the borrowed bus.
trusted fun M5Pm1Control.openRetainedRtcOwned(exclusive: bool,wakeEventsConsumed: bool): M5RtcOpenResult {
    if (!exclusive || !wakeEventsConsumed || !this.ready() || this.rtcRetained() ||
        (this.board() != m5BoardStopWatch && this.board() != m5BoardPaperMono && this.board() != m5BoardChainCaptain)) return M5RtcOpenResult(6<<40)
    val result=m5RtcOpenOwned(this.bus(),this.board())
    if (result.handle() != 0) this.buffer().storeU32(20,result.handle()&0xffffffff)
    return result
}
// Pass result.handle(), not the entire status-tagged result. Failed release
// retains the exact child; a different/stale/tag-mismatched handle does no I/O.
// RTC countdown/alarms are caller policy: close only releases the device slot.
trusted fun M5Pm1Control.closeRetainedRtcOwned(rtc: int,exclusive: bool): bool {
    if (!exclusive || !this.valid() || !this.rtcRetained() || rtc != ((m5RtcRx8130<<32)|this.buffer().loadU32(20))) return false
    if (!m5RtcOpenClose(rtc)) return false
    this.buffer().storeU32(20,0);return true
}
