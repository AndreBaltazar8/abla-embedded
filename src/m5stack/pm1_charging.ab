import "./pm1_presence.ab"
import "./pm1_charging_sequence.ab"
@inline
trusted fun pm1ChargingReadGpio(handle: int,pin: int): I2cByteResult {
    if (!m5Pm1GpioValid(pin)) return I2cByteResult(0)
    val bits=M5Pm1(handle).gpioInputBits()
    if (!bits.valid()) I2cByteResult(0) else I2cByteResult(256 | (if ((bits.value() & (1<<pin)) != 0) 1 else 0))
}
trusted fun M5BoardId.pm1ChargingChecked(pm1: M5Pm1,ioe: M5Ioe1,presence: Pm1BatteryPresence,now: int): I2cByteResult =
    this.pm1ChargingCheckedOwned(pm1 | 0,ioe | 0,presence,now)
