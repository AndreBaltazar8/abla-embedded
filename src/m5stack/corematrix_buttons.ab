import "./corematrix_control_sequence.ab"
import "../power/m5pm1_device.ab"
import "./button_frame.ab"
// KEY1/2/3 are PM1 GPIO0/1/2, active low. One coherent input-register read,
// no ESP GPIO sampling, PMIC IRQ acknowledgement, allocation or state reset.
// Caller serializes against setup/close and configures power inputs first.
// Failed/unadmitted polls have no valid channels. Feed through M5Button's
// updateFrom API to preserve state and suspend timing during unknown samples.
trusted fun M5CoreMatrixControl.pollButtonLevelsOwned(exclusive: bool): M5ButtonFrame {
    if (!exclusive || !this.ready()) return m5ButtonFrame()
    val levels=M5Pm1(this.pmic().deviceHandle()).gpioInputBits()
    if (!levels.valid()) return m5ButtonFrame()
    return M5ButtonFrame(u32(224|((~levels.value())&7)))
}
