import "../display/lcd_logic.ab"
import "../display/mipi_programs.ab"
import "../spi/pins.ab"
// M5GFX ChainCaptain:240x240 viewport in240x320 ST7789 GRAM, offset rotation2.
// SPI2 MOSI16/clock15/CS45/DC46, no MISO/shared DC; upstream write clock40MHz.
fun chainCaptainDisplayGeometry(): LcdGeometry = lcdGeometry(240,240,0,0,240,320)
fun chainCaptainPanelRotation(rotation: int): int =
    if (rotation < 0 || rotation > 7) -1 else ((rotation+2)&3)|(rotation&4)
fun chainCaptainDisplayView(rotation: int): LcdView =
    if (rotation < 0 || rotation > 7) LcdView(u64(0)) else chainCaptainDisplayGeometry().view(chainCaptainPanelRotation(rotation),true)
// Command phase only: exclusive initialized mode0/MSB SPI2 at<=40MHz,
// inactive CS, completed rail/reset setup and backlight OFF are prerequisites.
// Preserve gate/failure details; do not enable backlight until a successful clear.
trusted fun chainCaptainPanelBeginOwned(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult {
    if (rotation < 0 || rotation > 7) return SpiTransactionResult(3<<32)
    return esp32s3LcdBeginRgb565(gate,owner,2,spiPins(16,-1,15),Pin(45),Pin(46),
        chainCaptainDisplayGeometry(),chainCaptainPanelRotation(rotation),
        st7789InitProgram(),nativeBufferAt(0,0),true,true,false)
}
