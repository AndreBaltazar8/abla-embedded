import "./pm1_audio_esp32s3.ab"
import "./es8311_playback_esp32s3.ab"
// Borrow codec/control until playback close returns4; retain them on3.
// Fresh136B record and initialized PCM ring. Same stopped/exclusive contracts
// as capture; ChainCaptain PA21 must already be released from RTC/holds.
trusted fun M5Pm1Control.beginAudioPlaybackOwned(record: NativeBuffer,hz: int,channel: int,
    desc: int,count: int,payload: int,bytes: int,owner: u32,codec: Es8311,exclusive: bool): int {
    if (!exclusive || !pm1BoardAudioAdmission(this|0) || !pm1BoardAudioCodecMatches(this|0,codec) ||
        !pm1AudioStreamStorageSafe(record,136,desc,count,payload,bytes,this.buffer(),
            esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return 0
    return this.board().beginEs8311PlaybackOwned(record,hz,channel,desc,count,payload,bytes,owner,
        codec,M5Pm1(0),pm1BoardAudioExpander(this|0),true)
}
