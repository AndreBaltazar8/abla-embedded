// Status1 peripheral-ready,2 peripheral-ready with GPIO-only buzzer,
// 3 invalid ownership/state,4 unsupportedboard,5 failed phase.
// Stage bits8..15: 1buzzer,2inputs,3presence sample,4rails.
// Detail bits16..31 retain the failed phase result; presence bits32..33:
// 0 unknown/not sampled,1 absent,2 present. Bit34 records degraded buzzer.
type M5ToughBoot = int
fun M5ToughBoot.status(): int = this & 255
fun M5ToughBoot.stage(): int = (this>>>8)&255
fun M5ToughBoot.detail(): int = (this>>>16)&65535
fun M5ToughBoot.batteryPresence(): int = ((this>>>32)&3)-1
fun M5ToughBoot.buzzerDegraded(): bool = (this & (1<<34)) != 0
fun M5ToughBoot.peripheralsReady(): bool = this.status() == 1 || this.status() == 2
// Final C5 wake-input stage5; status6 means held pad or failed setup readback,
// retryable under pin ownership without PMIC reinitialization.
fun M5ToughBoot.powerReady(): bool = this.peripheralsReady() && this.stage() == 5
