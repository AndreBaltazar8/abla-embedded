import "./button_state.ab"
import "./power_button_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
// Caller-owned64B: magic/frame/time/touch cache, five scalar buttons, PMIC state.
// No allocator, hidden registry, bus ownership or concurrent mutation support.
type M5Inputs = int
fun m5InputsAt(storage: NativeBuffer): M5Inputs = M5Inputs(if (storage.hasAddressRange(0,64) &&
    (storage.addressValue()&3) == 0) storage | 0 else 0)
fun M5Inputs.buffer(): NativeBuffer = NativeBuffer(this | 0)
trusted fun M5Inputs.valid(): bool = this.buffer().hasAddressRange(0,64) &&
    (this.buffer().addressValue()&3) == 0 && this.buffer().loadU32(0) == 0x494E5054
trusted fun M5Inputs.loadState(offset: int): int = this.buffer().loadU32(offset)|(this.buffer().loadU32(offset+4)<<32)
trusted fun M5Inputs.storeState(offset: int,value: int): void {
    this.buffer().storeU32(offset,value&0xFFFFFFFF); this.buffer().storeU32(offset+4,value>>>32)
    return
}
// Initialize fresh storage only; do not discard live event state accidentally.
trusted fun M5Inputs.initialize(now: int = 0): bool {
    if (!this.buffer().hasAddressRange(0,64) || (this.buffer().addressValue()&3) != 0) return false
    var offset=0
    while (offset < 64) { this.buffer().storeU32(offset,0); offset=offset+4 }
    var index=0
    while (index < 5) { this.storeState(16+index*8,m5Button(false,now) | 0); index=index+1 }
    this.storeState(56,m5PowerButton(now) | 0)
    this.buffer().storeU32(8,now&0xFFFFFFFF)
    this.buffer().storeU32(0,0x494E5054)
}
trusted fun M5Inputs.button(index: int): M5Button = M5Button(if (!this.valid() || index < 0 || index > 4) 0 else this.loadState(16+index*8))
trusted fun M5Inputs.powerKey(): M5PowerButton = M5PowerButton(if (this.valid()) this.loadState(56) else 0)
trusted fun M5Inputs.frame(): M5ButtonFrame = M5ButtonFrame(if (this.valid()) u32(this.buffer().loadU32(4)) else u32(0))
// Apply validated touch/physical levels first; destructive PMIC read last.
// Missing samples pause their individual debouncers and clear stale events.
trusted fun M5Inputs.updateOwned(frame: M5ButtonFrame,pmic: M5PmicOpen,usePmic: bool,now: int): bool {
    if (!this.valid()) return false
    var index=0
    while (index < 5) {
        val value=this.button(index).updateFrame(frame,index,now)
        this.storeState(16+index*8,value | 0)
        index=index+1
    }
    val power=if (usePmic) this.powerKey().pollOwned(pmic,now) else m5PowerButton(now)
    this.storeState(56,power | 0)
    this.buffer().storeU32(4,int(frame | u32(0)))
    this.buffer().storeU32(8,now&0xFFFFFFFF)
    this.buffer().storeU32(12,0)
    true
}
