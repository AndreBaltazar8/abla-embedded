import "./corep4x_speaker_session_esp32p4.ab"
import "./tab5_speaker_session_esp32p4.ab"
// Constant board selectors at wrapper calls allow unused code to be pruned.
// Never infer board from pins alone: validate the corresponding session magic.
trusted fun m5P4SpeakerSessionValid(r: NativeBuffer,tab5: bool): bool =
    if (tab5) tab5SpeakerSessionValid(r) else coreP4xSpeakerSessionValid(r)
trusted fun m5P4SpeakerPumpOwned(r: NativeBuffer,staging: NativeBuffer,tab5: bool): int =
    if (tab5) tab5SpeakerPumpOwned(r,staging,true) else coreP4xSpeakerPumpOwned(r,staging,true)
trusted fun m5P4SpeakerStopOwned(r: NativeBuffer,tab5: bool): int =
    if (tab5) tab5SpeakerStopOwned(r,true) else coreP4xSpeakerStopOwned(r,true)
