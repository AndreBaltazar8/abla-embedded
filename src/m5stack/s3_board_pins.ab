fun M5StampPLC.rgbLedPin(): Pin = this.boardId().rgbLedPin()
fun M5StampPLC.powerHoldPin(): Pin = this.boardId().powerHoldPin()
fun M5StampPLC.buttonASource(): M5ButtonSource = this.boardId().buttonASource()
fun M5StampPLC.buttonBSource(): M5ButtonSource = this.boardId().buttonBSource()
fun M5StampPLC.buttonCSource(): M5ButtonSource = this.boardId().buttonCSource()
fun M5StampPLC.buttonExtSource(): M5ButtonSource = this.boardId().buttonExtSource()
fun M5StampPLC.buttonPowerSource(): M5ButtonSource = this.boardId().buttonPowerSource()
fun M5StampPLC.mBusPin(position: int): Pin = this.boardId().mBusPin(position)
fun M5StampPLC.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5StampPLC.internalI2cData(): Pin = pin(this.i2cPins().internalData())
fun M5StampPLC.externalI2cClock(): Pin = pin(this.i2cPins().externalClock())
fun M5StampPLC.externalI2cData(): Pin = pin(this.i2cPins().externalData())
