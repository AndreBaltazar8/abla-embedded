import "../power/m5pm1_device.ab"
// M5GFX Light_M5PaperMono (M5Stack, MIT): PM1GPIO3 specialPWM, notIOE.
// Whole PM1PWM frequency domain and GPIO3 caller-owned; no shared PWM user
// may race setup. No automatic control-bus setup, rail change or retries.
fun paperMonoFrontlightDuty(level: int): int = if (level < 0 || level > 255) -1 else (level*level)>>4
// Existing initializedPWM: explicit0 disables only high control byte as
// upstream, preserving low duty byte; nonzero writes duty+enable in a single
// I2C transaction. Failure can partially apply; no atomic/readback guarantee.
// 1complete2admission6brightness-write failure.
trusted fun paperMonoFrontlightOwned(power: M5Pm1,level: int,exclusive: bool): int {
    val duty=paperMonoFrontlightDuty(level)
    if (!exclusive || (power|0) <= 0 || (power|0) > 4294967295 || duty < 0) return 2
    val success=if (level == 0) power.device().writeRegister8(0x31,0) else power.setPwmDuty12(0,duty,false,true)
    return if (success) 1 else 6
}
// 3drive,4function,5frequency failure; no brightness write after partialsetup.
trusted fun paperMonoFrontlightInitializeOwned(power: M5Pm1,level: int,exclusive: bool): int {
    if (!exclusive || (power|0) <= 0 || (power|0) > 4294967295 || paperMonoFrontlightDuty(level) < 0) return 2
    if (!power.setGpioDrive(3,m5Pm1GpioPushPull)) return 3
    if (!power.setGpioFunction(3,m5Pm1GpioFunctionSpecial)) return 4
    if (!power.setPwmFrequency(5000)) return 5
    return paperMonoFrontlightOwned(power,level,true)
}
