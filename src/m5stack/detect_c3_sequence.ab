import "./detect_logic.ab"
import "../esp32/gpio/probe_c3_sequence.ab"
// Low under pulldown identifies StampC3U. High remains ambiguous: a C3U
// attachment can imitate StampC3's external pullup. Never guess StampC3.
// Compatibility view loses failure detail. New ownership-aware callers should
// use CheckedOwned; Unknown from this wrapper is not proof of restored pads.
trusted fun m5DetectCurrentEsp32C3Owned(current: M5BoardId,gpio20QuiescedExclusive: bool): M5BoardId {
    val result=m5DetectCurrentEsp32C3CheckedOwned(current,gpio20QuiescedExclusive)
    return if (result < 0) m5BoardUnknown else M5BoardId(result)
}
// Checked API keeps unknown0 distinct from admission/setup/restore failures.
// On-4 retain ownership: identification is unusable until pad state is repaired.
trusted fun m5DetectCurrentEsp32C3CheckedOwned(current: M5BoardId,gpio20QuiescedExclusive: bool): int {
    if (current != m5BoardUnknown) return current
    val sample=esp32C3GpioPulldownProbeOwned(20,gpio20QuiescedExclusive)
    if (sample < 0) return sample
    if (sample == 0) m5BoardStampC3U else m5BoardUnknown
}
