import "./atom_s3_panel_logic.ab"
import "../hal/atoms3panel.ab"
import "../display/mipi_programs.ab"
import "../display/gc9107_program.ab"
import "../display/spi_mipi_sequence_esp32s3.ab"
import "../hal/spitransactionresult.ab"
import "../peripheralgate_type.ab"
import "../spi/spitransactionresult_type.ab"
import "../spi/pins.ab"
import "../hal/pin.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../esp32/sdk/nativebuffer_type.ab"
// Caller retains powered/reset panel and initialized mode0/MSB hardware SPI,
// routed CLK/MOSI, inactive CS and output DC. No backlight enable on failure.
// Uses the same selected geometry, rotation offset, programs and inversion as
// the software facade. No guessed controller or fabricated readback support.
@exportLocal("abla_atoms3panel_beginNativeChecked")
trusted fun atomS3PanelBeginNativeCheckedHook(recv: int, gate: PeripheralGate, owner: u32, port: int, rotation: int): SpiTransactionResult {
    val selected=AtomS3Panel(recv).internalRotation(rotation)
    if (selected < 0) return SpiTransactionResult(3<<32)
    val pins=AtomS3Panel(recv).pins()
    return esp32s3LcdBeginRgb565(gate,owner,port,spiPins(pins.mosi(),-1,pins.clock()),
        Pin(pins.chipSelect()),Pin(pins.dataCommand()),AtomS3Panel(recv).geometry(),selected,
        if (AtomS3Panel(recv).gc9107()) gc9107InitProgram() else st7735SInitProgram(),NativeBuffer(0),!AtomS3Panel(recv).gc9107(),true,false)
}
