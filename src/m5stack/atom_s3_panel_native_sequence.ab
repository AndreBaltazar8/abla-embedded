import "./atom_s3_panel_logic.ab"
import "../display/mipi_programs.ab"
import "../display/gc9107_program.ab"
import "../display/spi_mipi_sequence_esp32s3.ab"
// Caller retains powered/reset panel and initialized mode0/MSB hardware SPI,
// routed CLK/MOSI, inactive CS and output DC. No backlight enable on failure.
// Uses the same selected geometry, rotation offset, programs and inversion as
// the software facade. No guessed controller or fabricated readback support.
trusted fun AtomS3Panel.beginNativeChecked(gate: PeripheralGate,owner: u32,port: int,rotation: int): SpiTransactionResult {
    val selected=this.internalRotation(rotation)
    if (selected < 0) return SpiTransactionResult(3<<32)
    val pins=this.pins()
    return esp32s3LcdBeginRgb565(gate,owner,port,spiPins(pins.mosi(),-1,pins.clock()),
        Pin(pins.chipSelect()),Pin(pins.dataCommand()),this.geometry(),selected,
        if (this.gc9107()) gc9107InitProgram() else st7735SInitProgram(),NativeBuffer(0),!this.gc9107(),true,false)
}
