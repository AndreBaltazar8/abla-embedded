import "./button_frame.ab"
import "./touch_button_frame.ab"
// Invalid touch reports contribute no sample; never synthesize a release.
// A/B/C can also have physical sources (M5Paper). Upstream ORs those presses
// with touch; an empty touch report must not erase a held physical button.
fun M5ButtonFrame.withTouch(touch: M5TouchButtons): M5ButtonFrame =
    if (touch.valid()) this.withTouchLevels(touch.controlled(),
        touch.pressed()|(this.pressedMask()&touch.controlled())) else this
