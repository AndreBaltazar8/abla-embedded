import "./tab5_reset_sequence.ab"
import "../i2c/software_registers.ab"
import "../esp32/i2c/software_lines_esp32p4.ab"
trusted fun tab5ResetRead(bus: SoftwareI2cLines,register: int,scratch: NativeBuffer): I2cByteResult = bus.readRegister8Checked(67,register,scratch)
trusted fun tab5ResetWrite(bus: SoftwareI2cLines,register: int,value: int,scratch: NativeBuffer): bool = bus.writeRegister8(67,register,value,scratch)
trusted fun tab5ResetSelectAddress(driveHigh: bool): bool = esp32P4GpioConfigureOwned(23,driveHigh,true,false,!driveHigh,0) == 1
trusted fun tab5ResetDelay(ms: int): void {
    var remaining=ms
    while (remaining > 0) { peripheralRomDelay(1000); remaining=remaining-1 }
    return
}
trusted fun tab5DisplayTouchReset(bus: SoftwareI2cLines,scratch: NativeBuffer): int = tab5DisplayTouchResetOwned(bus,scratch)
