import "./tab5_reset_sequence.ab"
import "../i2c/software_registers.ab"
import "../esp32/i2c/software_lines_esp32p4.ab"
import "../hal/m5stack.ab"
import "../hal/esp32.ab"
import "../hal/m5stack_2.ab"
import "../hal/m5stack_3.ab"
import "../i2c/software_lines.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../i2c/results.ab"
import "../esp32/sdk/nativebuffer_type.ab"
@export("tab5ResetRead")
trusted fun tab5ResetReadHook(bus: SoftwareI2cLines,register: int,scratch: NativeBuffer): I2cByteResult = bus.readRegister8Checked(67,register,scratch)
@export("tab5ResetWrite")
trusted fun tab5ResetWriteHook(bus: SoftwareI2cLines,register: int,value: int,scratch: NativeBuffer): bool = bus.writeRegister8(67,register,value,scratch)
@export("tab5ResetSelectAddress")
trusted fun tab5ResetSelectAddressHook(driveHigh: bool): bool = esp32P4GpioConfigureOwned(23,driveHigh,true,false,!driveHigh,0) == 1
@export("tab5ResetDelay")
trusted fun tab5ResetDelayHook(ms: int): void {
    var remaining=ms
    while (remaining > 0) { peripheralRomDelay(1000); remaining=remaining-1 }
    return
}
trusted fun tab5DisplayTouchReset(bus: SoftwareI2cLines,scratch: NativeBuffer): int = tab5DisplayTouchResetOwned(bus,scratch)
