import "../esp32/sdk/raw_buffer.ab"
// M5GFX Panel_StopWatch init: SLPOUT150ms, SPI interface,TE mode/line466,
// display control, inversion off,MADCTL0,brightness,DISPON. Deliberately use
// brightness0 rather than upstream0xa0 so startup can clear before lighting.
// Explicit RGB565 follows the board program; no dependence on power-on format.
trusted fun stopWatchPanelInitProgram(): NativeBuffer =
    nativeBufferAt(nativeStaticBytes("\x11\x80\x96\xc4\x01\x80\x35\x01\x80\x44\x02\x01\xd2\x53\x01\x20\x20\x00\x36\x01\x00\x51\x01\x00\x29\x00\x3a\x01\x55\xff\xff"),31)
// CO5300 mirrored rotations use bit1, unlike the generic LCD MADCTL mapping.
fun stopWatchPanelMadctl(rotation: int): int =
    if (rotation < 0 || rotation > 7) -1 else if (rotation == 0) 0 else if (rotation == 1) 0x60
    else if (rotation == 2) 0xc0 else if (rotation == 3) 0xa0 else if (rotation == 4) 0xc2
    else if (rotation == 5) 0x62 else if (rotation == 6) 2 else 0xa2
// Upstream swaps offsets on odd rotation but does not mirror them in GRAM.
fun stopWatchPanelColumnStart(rotation: int): int = if (rotation < 0 || rotation > 7) -1 else if ((rotation&1) == 0) 6 else 0
fun stopWatchPanelRowStart(rotation: int): int = if (rotation < 0 || rotation > 7) -1 else if ((rotation&1) == 0) 0 else 6
