import "./rtc_profile.ab"
// Concrete low-active CPU wake wire, not merely an installed RTC driver.
// Low6 pin, bits6..7 route(1direct RTC,2PM1 aggregated),bit8 present.
// Based on Power_Class's RTC interrupt selection and ToughC5 PM1 routing.
// Missing means no supported CPU-wire mapping here; it does not mean that
// an RTC cannot restart the board through a PMIC or an external circuit.
type M5RtcWakeProfile=int
fun M5BoardId.rtcWakeProfile(): M5RtcWakeProfile {
    if (this == m5BoardPaperColor) return M5RtcWakeProfile(256|64|7)
    if (this == m5BoardStampPLC) return M5RtcWakeProfile(256|64|14)
    if (this == m5BoardStackCoreInk) return M5RtcWakeProfile(256|64|19)
    if (this == m5BoardStickC || this == m5BoardStickCPlus) return M5RtcWakeProfile(256|64|35)
    if (this == m5BoardPaperMono) return M5RtcWakeProfile(256|128|1)
    if (this == m5BoardToughC5) return M5RtcWakeProfile(256|128|4)
    M5RtcWakeProfile(0)
}
fun M5RtcWakeProfile.valid(): bool = (this>>>8) == 1 && ((this>>>6)&3) >= 1 && ((this>>>6)&3) <= 2
fun M5RtcWakeProfile.pinNumber(): int = if (this.valid()) this & 63 else -1
fun M5RtcWakeProfile.throughPmic(): bool = this.valid() && ((this>>>6)&3) == 2
// The board wake owner must keep the RTC/IRQ supply alive and configure the
// target's actual EXT0/EXT1/light-sleep GPIO capability. Pin35 on classic ESP32
// is not transferable to S3. No automatic pin mode, pull or power changes.
fun M5RtcWakeProfile.activeLow(): bool = this.valid()
