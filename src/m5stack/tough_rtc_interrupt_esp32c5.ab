import "./tough_rtc_interrupt_sequence.ab"
import "./tough_rtc_esp32c5.ab"
import "./rtc_timer.ab"
import "./rtc_alarm.ab"
import "../hal/m5stack.ab"
@export("toughRtcBusOwnsRx8130")
trusted fun toughRtcBusOwnsRx8130Hook(bus: int,rtc: int): bool =
    esp32C5I2cState().deviceMatchesOwned(esp32C5I2cDevicePool(),u32(1),bus,rtc,50)
