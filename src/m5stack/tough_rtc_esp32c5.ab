import "./tough_rtc_open_sequence.ab"
import "./rtc_open.ab"
import "../esp32/i2c_esp32c5.ab"
import "../hal/m5stack.ab"
import "../esp32/i2c/devices_c5_sequence.ab"
@export("toughRtcBusOwnsPmic")
trusted fun toughRtcBusOwnsPmicHook(bus: int,pmic: int): bool =
    esp32C5I2cState().deviceMatchesOwned(esp32C5I2cDevicePool(),u32(1),bus,pmic,110)
