import "./cores3_speaker_stream.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
import "./cores3_playback_sequence.ab"

// Internal bounded block loader. The playback entry validates ranges/alignment.
trusted fun coreS3LoadPlaybackBlock(destination: int, source: NativeBuffer,
    index: int, sourceBlocks: int): void {
    if (index < sourceBlocks) esp32s3GdmaCopyBytes(destination, source.addressValue() + index * 960, 960)
    else {
        var offset = 0
        while (offset < 960) {
            mmioStoreU32(destination + offset, 0)
            offset = offset + 4
        }
    }
    return
}
