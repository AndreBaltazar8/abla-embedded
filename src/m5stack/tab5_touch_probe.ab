import "./tab5_touch_probe_sequence.ab"
import "../touch/st7123_device.ab"
trusted fun tab5TouchPrepare(bus: int): int = I2cBus(bus).prepareProbeStatus()
trusted fun tab5TouchFirmware(handle: int): I2cByteResult = St7123(handle).device().readRegisterAddress16ByteChecked(0)
trusted fun tab5TouchGtAck(bus: int): bool = I2cBus(bus).probe(20)
trusted fun M5BoardId.probeTab5Touch(bus: I2cBus,st: St7123): M5Tab5TouchProbe = this.probeTab5TouchOwned(bus | 0,st | 0)
