import "../io_expander/m5ioe1_device.ab"
// EPD RST=IOE GPIO5/index4, separate from touch RST=index5. Initialized
// push-pull output, retained rail, CS16 inactive, exclusive IOE/panel required.
// No touch reset or shared-rail toggle. Checked latch is not voltage proof.
// 1complete2admission3LOWwrite4LOWread5HIGHwrite6HIGHread.
trusted fun paperMonoPanelResetOwned(io: M5Ioe1,exclusiveCsInactive: bool): int {
    if (!exclusiveCsInactive || (io|0) <= 0 || (io|0) > 4294967295) return 2
    if (!io.digitalWrite(4,false)) return 3
    val low=io.getWriteValueChecked(4)
    if (!low.valid() || low.value() != 0) return 4
    peripheralDelayMilliseconds(10)
    if (!io.digitalWrite(4,true)) return 5
    val high=io.getWriteValueChecked(4)
    if (!high.valid() || high.value() == 0) return 6
    peripheralDelayMilliseconds(10)
    return 1
}
