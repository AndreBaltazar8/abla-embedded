import "./imu_probe_types.ab"
//1success,2invalid handle,3unsupported by selected driver,4I/O failure.
type M5ImuControlResult = int
fun M5ImuControlResult.success(): bool = this == 1
// M5Unified provides these controls only through its MPU-family driver.
fun M5ImuProbeResult.supportsSleep(): bool = this.ready() && this.kind() <= m5ImuMpu9250
fun M5ImuProbeResult.supportsInterruptPolarity(): bool = this.supportsSleep()
trusted fun M5ImuProbeResult.sleep(): M5ImuControlResult {
    if (!this.ready()) return M5ImuControlResult(2)
    if (!this.supportsSleep()) return M5ImuControlResult(3)
    M5ImuControlResult(if (I2cDevice(this.handle()).writeRegister8(107,64)) 1 else 4)
}
trusted fun M5ImuProbeResult.setInterruptActiveHigh(activeHigh: bool): M5ImuControlResult {
    if (!this.ready()) return M5ImuControlResult(2)
    if (!this.supportsInterruptPolarity()) return M5ImuControlResult(3)
    M5ImuControlResult(if (I2cDevice(this.handle()).updateRegister8(55,128,if (activeHigh) 0 else 128)) 1 else 4)
}
// Does not put hardware to sleep or close its bus. On success caller discards
// all scalar copies; backend generation checks reject stale device accesses.
// Release-failure probe results also retain their device for this cleanup path.
trusted fun M5ImuProbeResult.closeDevice(): bool {
    if (this.handle() == 0 || (!this.ready() && this.status() != 4)) return false
    I2cDevice(this.handle()).close()
}
