import "./nesso_display_sequence.ab"
// Phase5 is asleep: drawing rejected, E1 retained, desired brightness saved
// in config bits16..23. Nesso brightness is binary, not PWM. Copies of the
// child owner are borrowed; never close/use it independently of this state.
trusted fun NessoDisplay.sleeping(): bool = this.phase() == 5
trusted fun NessoDisplay.brightness(): int = if (this.valid()) (this.buffer().loadU32(24)>>>16)&255 else 0
trusted fun NessoDisplay.saveBrightness(value: int): void {
    this.buffer().storeU32(24,(this.buffer().loadU32(24)&~0xff0000)|(value<<16));return
}
trusted fun NessoDisplay.setBrightnessOwned(value: int,exclusive: bool): bool {
    val phase=this.phase()
    if (!exclusive || value < 0 || value > 255 || (phase != 1 && phase != 5)) return false
    if (phase == 5) { this.saveBrightness(value);return true }
    this.buffer().storeU32(4,3)
    if (!this.powerOwner().setBacklightOwned(value,true)) { this.fail(11);return false }
    this.saveBrightness(value);this.buffer().storeU32(4,1);return true
}
// Sleep: backlight off before SLPIN. Wake: SLPOUT and controller-required
// delay before backlight restore. No reset, clear or orientation replay.
// Caller chooses settle interval; neither display nor transport infers a
// datasheet timing requirement. Failures retain ownership, never mark ready.
trusted fun NessoDisplay.setSleepingOwned(sleeping: bool,settleMilliseconds: int,exclusive: bool): bool {
    val phase=this.phase()
    if (!exclusive || settleMilliseconds < 0 || settleMilliseconds > 5000 || (phase != 1 && phase != 5)) return false
    if (sleeping == (phase == 5)) return true
    this.buffer().storeU32(4,3)
    if (sleeping && !this.powerOwner().setBacklightOwned(0,true)) { this.fail(11);return false }
    val result=nessoDisplaySetPanelSleep(this.gate(),this.owner(),sleeping,settleMilliseconds);this.saveSpi(result)
    if (result>>>32 != 1) { this.fail(12);return false }
    if (!sleeping && !this.powerOwner().setBacklightOwned(this.brightness(),true)) { this.fail(11);return false }
    this.buffer().storeU32(4,if (sleeping) 5 else 1);return true
}
