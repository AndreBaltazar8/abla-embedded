// M5Unified microphone callback, Copyright(c)2021 M5Stack, MIT; see notices.
// Own initialized PM1/IOE1 devices and IOE GPIO12 (zero-based bit11), no concurrent shared-register
// users. Enable BOOST before powering mic; disable never removes shared BOOST.
// Caller stops capture before disable. Failure retains ownership and may leave
// partial configuration; no automatic shared-rail rollback or forced success.
// Status1 ready,2 invalid,3 BOOST write,4 BOOST readback,5 push-pull config,
// 6 direction,7 power-latch write,8 power-latch readback. Latch != rail voltage.
trusted fun paperMonoMicrophonePowerOwned(power: M5Pm1,expander: M5Ioe1,enabled: bool,exclusive: bool): int {
    if (!exclusive || !expander.valid() || (enabled && !power.valid())) return 2
    if (enabled) {
        if (!power.setExtOutput(true)) return 3
        val boost=power.extOutputChecked()
        if (!boost.valid() || boost.value() == 0) return 4
    }
    if (!expander.setHighImpedance(11,false)) return 5
    if (!expander.setDirection(11,true)) return 6
    if (!expander.digitalWrite(11,enabled)) return 7
    val latch=expander.getWriteValueChecked(11)
    if (!latch.valid() || (latch.value() != 0) != enabled) return 8
    return 1
}
