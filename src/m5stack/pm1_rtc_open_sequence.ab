import "./rtc_open_sequence.ab"
// RX8130 begin changes control/interrupt configuration. Consume desired wake
// events FIRST; do not silently erase evidence when opening the board RTC.
// Caller owns the new RTC device independently; join/close it before closing
// borrowed PM1 board control/bus. Failed cleanup retains tagged RTC ownership.
// Status6 means rejected board/ownership/event admission, no device allocated.
trusted fun pm1BoardRtcOpenOwned(control: int,exclusive: bool,wakeEventsConsumed: bool): M5RtcOpenResult {
    if (!exclusive || !wakeEventsConsumed || !pm1BoardRtcAdmission(control)) return M5RtcOpenResult(6<<40)
    return m5RtcOpenOwned(pm1BoardRtcBus(control),pm1BoardRtcBoard(control))
}
