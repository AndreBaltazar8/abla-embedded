import "./cores3_display_init_result.ab"

// Same exclusive board-lifecycle and caller-owned handles as software init.
// Additionally requires stopped GPSPI2 and a stable PLL80M source. Stage12
// identifies hardware-SPI setup failure. Other stage numbers remain stable.
// Brightness is applied only after panel commands AND full black clear.
trusted fun M5BoardId.initializeCoreS3HardwareDisplay(power: Axp2101, expander: Aw9523,
    touch: Ft5x06, gate: PeripheralGate, owner: u32,
    requestExternal5v: bool, brightness: int): CoreS3DisplayInitResult {
    if (!this.displaySharedDataCommand() || !power.valid() || !expander.valid() || !touch.valid() ||
        !gate.word().valid() || !peripheralOwnerValid(owner) || brightness < 0 || brightness > 255) return CoreS3DisplayInitResult(2)
    peripheralDelayMilliseconds(5)
    if (!cores3ConfigurePmic(power)) return cores3DisplayInitFailure(power,3,0)
    if (!cores3ConfigureExpander(expander,requestExternal5v)) return cores3DisplayInitFailure(power,4,0)
    val pins = this.configureCoreS3SpiPins(gate,owner)
    if (!pins.valid()) return cores3DisplayInitFailure(power,5,pins.status())
    val sd = this.prepareCoreS3SdSpi(gate,owner)
    if (!sd.valid()) return cores3DisplayInitFailure(power,6,sd.status())
    val bus = this.configureCoreS3HardwareSpi(gate,owner)
    if (!bus.valid()) return cores3DisplayInitFailure(power,12,bus.status())
    if (!cores3DisplayReset(expander)) return cores3DisplayInitFailure(power,7,0)
    val panel = cores3DetectPanel(touch)
    if (panel != cores3PanelIli9342C && panel != cores3PanelIli9342E) return cores3DisplayInitFailure(power,8,panel)
    val display = this.beginCoreS3SpiDisplay(gate,owner,panel)
    if (!display.valid()) return cores3DisplayInitFailure(power,9,display.status())
    val clear = this.clearCoreS3SpiDisplay(gate,owner)
    if (!clear.valid()) return cores3DisplayInitFailure(power,10,clear.status())
    if (!cores3DisplaySetBrightness(power,brightness)) return cores3DisplayInitFailure(power,11,0)
    CoreS3DisplayInitResult(1 | (panel << 24))
}
