import "./vibration_sequence.ab"
import "./axp_power.ab"
import "../io_expander/m5ioe1_device.ab"
// Borrowed identity-checked PMIC or initialized expander, never closed here.
// The caller owns the motor rail/pin and must not share it with another user.
trusted fun M5AxpPower.setVibration(board: M5BoardId,level: int): M5VibrationResult {
    if (!this.valid()) return M5VibrationResult(3)
    board.setAxpVibrationOwned(this.device() | 0,this.identity(),level)
}
trusted fun M5Ioe1.setVibration(board: M5BoardId,level: int): M5VibrationResult =
    board.setExpanderVibrationOwned(this | 0,level)
@inline
trusted fun m5VibrationVoltage(handle: int,identity: int,millivolts: int): bool =
    if (identity == 3) Axp192(handle).setLdo3(millivolts) else Axp2101(handle).setDldo1(millivolts)
@inline
trusted fun m5VibrationHighImpedance(handle: int,pin: int,enabled: bool): bool = M5Ioe1(handle).setHighImpedance(pin,enabled)
@inline
trusted fun m5VibrationDirection(handle: int,pin: int,output: bool): bool = M5Ioe1(handle).setDirection(pin,output)
@inline
trusted fun m5VibrationPwm(handle: int,channel: int,duty: int,enabled: bool): bool = M5Ioe1(handle).setPwmDuty12(channel,duty,false,enabled)
