import "./vibration_sequence.ab"
import "./axp_power.ab"
import "../io_expander/m5ioe1_device.ab"
import "../hal/m5stack.ab"
import "../hal/m5ioe1.ab"
import "./m5boardid_type.ab"
import "../io_expander/m5ioe1_type.ab"
import "../power/axp192_device.ab"
import "../power/axp2101_type.ab"
import "../power/axp2101_device.ab"
// Borrowed identity-checked PMIC or initialized expander, never closed here.
// The caller owns the motor rail/pin and must not share it with another user.
trusted fun M5AxpPower.setVibration(board: M5BoardId,level: int): M5VibrationResult {
    if (!this.valid()) return M5VibrationResult(3)
    board.setAxpVibrationOwned(this.device() | 0,this.identity(),level)
}
@exportLocal("abla_m5ioe1_setVibration")
trusted fun m5Ioe1SetVibrationHook(recv: int, board: M5BoardId,level: int): M5VibrationResult =
    board.setExpanderVibrationOwned(M5Ioe1(recv) | 0,level)
@inline
@export("m5VibrationVoltage")
trusted fun m5VibrationVoltageHook(handle: int,identity: int,millivolts: int): bool =
    if (identity == 3) Axp192(handle).setLdo3(millivolts) else Axp2101(handle).setDldo1(millivolts)
@inline
@export("m5VibrationHighImpedance")
trusted fun m5VibrationHighImpedanceHook(handle: int,pin: int,enabled: bool): bool = M5Ioe1(handle).setHighImpedance(pin,enabled)
@inline
@export("m5VibrationDirection")
trusted fun m5VibrationDirectionHook(handle: int,pin: int,output: bool): bool = M5Ioe1(handle).setDirection(pin,output)
@inline
@export("m5VibrationPwm")
trusted fun m5VibrationPwmHook(handle: int,channel: int,duty: int,enabled: bool): bool = M5Ioe1(handle).setPwmDuty12(channel,duty,false,enabled)
