import "./expander_open_types.ab"
import "./expander_profile.ab"
import "../esp32/sdk/raw_buffer.ab"
// Caller-owned32bytes: magic,status,board,opening failure, two ownedresults.
// status0closed,1allready,2..6 same failure categories as openExpander.
// Never copy ownership. initialize is for fresh storage only; close before reuse.
type M5Expanders = int
fun m5ExpandersAt(storage: NativeBuffer): M5Expanders =
    if (storage.hasAddressRange(0,32) && (storage.addressValue() & 3) == 0) M5Expanders(storage | 0) else M5Expanders(0)
fun M5Expanders.buffer(): NativeBuffer = NativeBuffer(this | 0)
trusted fun M5Expanders.valid(): bool = this.buffer().hasAddressRange(0,32) &&
    (this.buffer().addressValue() & 3) == 0 && this.buffer().loadU32(0) == 0x494F4532
trusted fun M5Expanders.status(): int = if (this.valid()) this.buffer().loadU32(4) else -1
trusted fun M5Expanders.openFailure(): int = if (this.valid()) this.buffer().loadU32(12) else -1
trusted fun M5Expanders.board(): M5BoardId = M5BoardId(if (this.valid()) this.buffer().loadU32(8) else 0)
trusted fun M5Expanders.ready(): bool {
    if (this.status() != 1) return false
    val board=this.board()
    val first=board.expanderProfile(0)
    if (first == 0 || !this.slot(0).ready() || this.slot(0).kind() != (first>>>8)) return false
    val second=board.expanderProfile(1)
    if (second == 0) return this.slot(1).deviceHandle() == 0
    this.slot(1).ready() && this.slot(1).kind() == (second>>>8) &&
        this.slot(0).deviceHandle() != this.slot(1).deviceHandle()
}
trusted fun M5Expanders.slot(index: int): M5ExpanderOpen {
    if (!this.valid() || index < 0 || index > 1) return M5ExpanderOpen(0)
    val offset=16+index*8
    M5ExpanderOpen(this.buffer().loadU32(offset)|(this.buffer().loadU32(offset+4)<<32))
}
