import "../i2c/results.ab"
// Status1 success,2 source-read failure,3 enable failure,4 timeout,5 operation
// failure,6 invalid arguments. Bit8 cleanup failure, bit16 observed charging.
// Caller exclusively owns the enabled interface through the entire operation.
type PaperMonoChargeResult = int
fun PaperMonoChargeResult.status(): int = this & 255
fun PaperMonoChargeResult.cleanupFailed(): bool = (this & 256) != 0
fun PaperMonoChargeResult.valid(): bool = this.status() == 1 && !this.cleanupFailed()
fun PaperMonoChargeResult.charging(): bool = this.valid() && (this & 65536) != 0
// mode0 reads charging; mode1 disables charging; mode2 enables charging.
trusted fun paperMonoChargerOwned(pm1: int,ioe: int,bus: int,charger: int,mode: int): PaperMonoChargeResult {
    if (pm1 <= 0 || ioe <= 0 || charger <= 0 || pm1 > 4294967295 || ioe > 4294967295 ||
        charger > 4294967295 || mode < 0 || mode > 2) return PaperMonoChargeResult(6)
    if (mode == 0) {
        val sources=paperMonoChargerSource(pm1)
        if (!sources.valid()) return PaperMonoChargeResult(2)
        if ((sources.value() & 3) == 0) return PaperMonoChargeResult(1)
    }
    var status=3
    var charging=false
    if (paperMonoChargerEnable(ioe,true)) {
        paperMonoChargerDelay(2)
        var probes=0
        var ready=false
        while (probes < 64 && !ready) { ready=paperMonoChargerProbe(bus); probes=probes+1 }
        status=4
        if (ready) {
            status=5
            if (mode == 0) {
                val value=paperMonoChargerRead(charger)
                if (value.valid()) { status=1; charging=(value.value() & 128) != 0 }
            } else if (paperMonoChargerWrite(charger,mode == 2)) status=1
        }
    }
    // Even a failed enable write may have reached hardware. Always attempt off.
    val closed=paperMonoChargerEnable(ioe,false)
    PaperMonoChargeResult(status|(if (closed) 0 else 256)|(if (charging) 65536 else 0))
}
