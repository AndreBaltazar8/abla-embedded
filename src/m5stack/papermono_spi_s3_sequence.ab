import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
import "../spi/pins.ab"
// M5GFX PaperMono SPI2: MOSI14/CLK15/CS16/DC17, mode0/MSB/40MHz.
// Owned stopped controller/pads, released RTC/holds, stablePLL80M required.
// TX-only; no MISO lease or PSRAM assumption. BUSY18 is a separate input.
// Canonical SPI2 gate quarantines partial initialization. Detail9CS/10DC,
// otherwise shared initializer status; never sends a panel command.
trusted fun paperMonoSpiInitializeOwned(gate: PeripheralGate,owner: u32,exclusive: bool): SpiTransactionResult {
    if (!exclusive) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    var detail=1
    if (!Pin(16).outputLevelOwned(true)) detail=9
    else if (!Pin(17).outputLevelOwned(true)) detail=10
    if (detail == 1) detail=esp32s3SpiInitializeTransmitOwned(2,spiPins(14,-1,15),Pin(16),1,1,2,0,owner,100000)
    if (!gate.finish(owner,detail == 1)) return SpiTransactionResult((5<<32)|detail)
    return SpiTransactionResult(((if (detail == 1) 1 else 6)<<32)|detail)
}
