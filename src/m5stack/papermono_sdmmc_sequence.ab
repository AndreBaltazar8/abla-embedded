import "../sd/mmc_pins_s3_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
// PaperMono native SDMMC CLK13/CMD12/D0..3=11/10/9/8 (not SPI).
fun paperMonoSdMmcPins(): SdMmcPins = sdMmcPins(13,12,11,10,9,8)
fun paperMonoSdMmcStorageSafe(buffer: NativeBuffer,bytes: int): bool = buffer.hasAddressRange(0,bytes) &&
    (buffer.addressValue()+bytes <= 0x60000000 || buffer.addressValue() >= 0x60100000)
// Begin existing128B asynchronous startup after capturing64B pad ownership.
// 2pending,3admission,4rail-read failure,5rail not enabled,6capture,7route,
// 8startup rejected. Native startup polling/close then snapshot restore remain
// explicit. On failure retain buffers and pad ownership; never reset a rail.
trusted fun paperMonoSdMmcBeginOwned(control: int,context: NativeBuffer,snapshot: NativeBuffer,
    slot: int,pll160: bool,nowMs: u32,budgetMs: int,exclusivePrepared: bool): int {
    if (!exclusivePrepared || slot < 0 || slot > 1 || budgetMs < 1 || budgetMs > 60000 ||
        !paperMonoSdMmcStorageSafe(context,128) || !paperMonoSdMmcStorageSafe(snapshot,64) ||
        (context.addressValue()&3) != 0 || (snapshot.addressValue()&3) != 0 ||
        (context.addressValue() < snapshot.addressValue()+64 && snapshot.addressValue() < context.addressValue()+128) ||
        context.loadU32(0) != 0 || snapshot.loadU32(0) != 0 ||
        !paperMonoSdMmcAdmission(control,context,snapshot) || !paperMonoSdMmcHostStopped()) return 3
    val power=paperMonoSdMmcPowerReady(control)
    if (power != 1) return if (power == 2) 4 else 5
    if (paperMonoSdMmcCapture(paperMonoSdMmcPins(),slot,snapshot) != 1) return 6
    val routed=paperMonoSdMmcRoute(paperMonoSdMmcPins(),slot)
    if (routed != 1) { snapshot.storeU32(56,routed);return 7 }
    return if (paperMonoSdMmcStart(context,slot,pll160,nowMs,budgetMs) == 2) 2 else 8
}
