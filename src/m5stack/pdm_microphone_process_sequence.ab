import "../audio/microphone_process.ab"
type M5PdmMicrophoneBlockResult=int
fun M5PdmMicrophoneBlockResult.status(): int = this&255
fun M5PdmMicrophoneBlockResult.samples(): int = this>>>32
// Full DMA events/bytes/cursor remain in the native child at48/52.
// Low8 result:1processed2preflight3busy4..8DMAfault9processingfault;
// output sample count high32. No data replay or fake samples on empty/busy DMA.
trusted fun m5PdmMicrophoneBufferDisjoint(r: NativeBuffer,buffer: NativeBuffer,bytes: int): bool {
    if (!buffer.hasAddressRange(0,bytes)) return false
    val address=buffer.addressValue();val count=r.loadU32(16)
    val desc=r.loadU32(12);val payload=r.loadU32(20);val block=r.loadU32(24)
    return bytes == 0 || !((address < r.addressValue()+152 && r.addressValue() < address+bytes) ||
        (address < desc+count*12 && desc < address+bytes) ||
        (address < payload+count*block && payload < address+bytes))
}
// Running board session152 + initialized DSP40 + one raw DMA block + output.
// Board PDM selects ONE hardware channel, so DMA pairs are successive mono
// samples: initialize DSP inputStereo=false/adc=false/swap=false. Output may
// be mono or duplicated stereo, unsigned8 or signed16. Supply profile gain
// unless overridden. Hardware rate/oversampling is the actual output rate;
// prepare the appropriate hardware rate before start, never change it here.
trusted fun m5PdmMicrophoneProcessBlockOwned(r: NativeBuffer,state: NativeBuffer,
    raw: NativeBuffer,output: NativeBuffer,stereo: bool,bits16: bool,polls: int,exclusive: bool): M5PdmMicrophoneBlockResult {
    if (!exclusive || m5PdmMicrophoneSessionStatus(r) != 2 || !M5BoardId(r.loadU32(72)).hasNativeS3PdmMicrophone() ||
        polls < 1 || polls > 1000000 || !state.hasAddressRange(0,40) || (state.loadU32(4)&7340032) != 0) return M5PdmMicrophoneBlockResult(2)
    val bytes=r.loadU32(24)
    if (bytes < 4 || (bytes&3) != 0 || !esp32s3GdmaRingLayoutValid(r.loadU32(12),r.loadU32(16),r.loadU32(20),bytes,bytes)) return M5PdmMicrophoneBlockResult(2)
    val samples=microphoneProcessRequiredSamples(state,raw,bytes/4,output,stereo,bits16)
    if (samples < 0 || !m5PdmMicrophoneBufferDisjoint(r,state,40) || !m5PdmMicrophoneBufferDisjoint(r,raw,bytes) ||
        !m5PdmMicrophoneBufferDisjoint(r,output,samples*(if (bits16) 2 else 1))) return M5PdmMicrophoneBlockResult(2)
    val pumped=m5PdmMicrophoneReadOwned(r,raw,polls,true)
    if (pumped.status() != 1) return M5PdmMicrophoneBlockResult(pumped.status())
    val written=microphoneProcess(state,raw,bytes/4,output,stereo,bits16)
    if (written != samples) { r.storeU32(4,3);r.storeU32(68,3);return M5PdmMicrophoneBlockResult(9) }
    return M5PdmMicrophoneBlockResult(1|(written<<32))
}
