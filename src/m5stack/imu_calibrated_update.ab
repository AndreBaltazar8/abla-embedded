import "./imu_owner_update.ab"
import "./imu_calibrated_update_sequence.ab"
trusted fun M5ImuOwner.updateCalibrated(snapshot: ImuSnapshot,scratch: NativeBuffer,
    micros: int,calibration: ImuCalibration,offsets: ImuOffsets,initialized: int=7): M5ImuCalibratedUpdate =
    this.updateCalibratedOwned(snapshot,scratch,micros,calibration,offsets,initialized)
