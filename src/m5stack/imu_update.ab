import "./imu_probe_types.ab"
import "../imu/bmi270_snapshot.ab"
import "../imu/frame_snapshot.ab"
// The probe result owns the device until closed. Borrow it for acquisition;
// initialization/configuration must not race this call. Does not reprobe.
trusted fun M5ImuProbeResult.updateSnapshot(snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int {
    if (!this.ready()) return -1
    val device=I2cDevice(this.handle())
    if (this.kind() == m5ImuBmi270) return snapshot.updateBmi270(device,scratch,micros,this.capabilities())
    if (this.kind() == m5ImuSh200q) return snapshot.updateSh200q(device,scratch,micros)
    snapshot.updateMpu6886(device,scratch,micros)
}
