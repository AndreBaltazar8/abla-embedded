import "./detect_classic_sequence.ab"
import "../esp32/touch/timing.ab"
// Same hardware/storage/ownership contract as the raw-tick detector. Explicit
// board selection still wins without probing, even when timing is unavailable.
trusted fun m5ClassicDetectBeginWithTimingOwned(r: NativeBuffer,current: M5BoardId,timing: Esp32TouchTiming,exclusive: bool): int {
    if (current == m5BoardUnknown && !timing.valid()) return 0
    m5ClassicDetectBeginOwned(r,current,timing.waitTicks(),timing.chargeTicks(),timing.intervalTicks(),exclusive)
}
