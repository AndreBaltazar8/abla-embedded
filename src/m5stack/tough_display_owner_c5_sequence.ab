import "./tough_power_owner_view.ab"
import "./expander_owner_view.ab"
import "./tough_display_sleep_c5_sequence.ab"
// Borrow the initialized ToughC5 power owner. Caller keeps it and its devices
// alive until display quiesce and touch close; no implicit parent ownership.
trusted fun M5ToughPowerOwner.displayIoOwned(bus: int): int {
    if (this.status() != 1 || !this.bootResult().powerReady() ||
        !this.pmic().ready() || this.pmic().kind() != 5) return 0
    val expanders=m5ExpandersAt(nativeBufferAt(this.buffer().addressValue()+32,32))
    if (!expanders.ready() || expanders.board() != m5BoardToughC5 || expanders.slot(0).kind() != 2 ||
        !toughDisplayStartupDeviceMatches(bus,this.pmic().deviceHandle(),110) ||
        !toughDisplayStartupDeviceMatches(bus,expanders.slot(0).deviceHandle(),79)) return 0
    return expanders.slot(0).deviceHandle()
}
fun toughDisplayParentDisjoint(parent: M5ToughPowerOwner,session: NativeBuffer): bool =
    toughDisplaySessionStorage(session) && (session.addressValue()+72 <= parent.buffer().addressValue() ||
        parent.buffer().addressValue()+96 <= session.addressValue())
// Run BEFORE opening touch: startup resets the touch controller too. Caller
// confirms previous touch handles are closed and wanted events consumed.
trusted fun M5ToughPowerOwner.beginDisplayOwned(session: NativeBuffer,master: Esp32C5SpiMaster,
    bus: int,gate: PeripheralGate,owner: u32,rotation: int,brightness: int,
    exclusiveQuiesced: bool,touchClosedEventsConsumed: bool): int {
    if (!exclusiveQuiesced || !touchClosedEventsConsumed || !toughDisplayParentDisjoint(this,session) ||
        !gate.bufferDisjoint(this.buffer(),96)) return 2
    val io=this.displayIoOwned(bus)
    if (io == 0) return 2
    return toughDisplaySessionBeginOwned(session,master|0,bus,this.pmic().deviceHandle(),io,gate,owner,
        rotation,brightness,true)
}
// Revalidate current parent device bindings before panel state changes.
// Closing/reopening a parent does not authorize use of an old display child.
trusted fun M5ToughPowerOwner.displaySessionMatches(session: NativeBuffer): bool {
    if (!toughDisplayParentDisjoint(this,session) || session.loadU32(0) != 0x54445353) return false
    val gate=peripheralGateAt(session.loadU32(32))
    if (!gate.bufferDisjoint(this.buffer(),96)) return false
    val io=this.displayIoOwned(toughDisplaySessionWord64(session,16))
    return io != 0 && io == session.loadU32(28) && this.pmic().deviceHandle() == session.loadU32(24)
}
trusted fun M5ToughPowerOwner.sleepDisplayOwned(session: NativeBuffer,sleep: bool,brightness: int,
    exclusiveQuiesced: bool): SpiBufferResult {
    if (!exclusiveQuiesced || !this.displaySessionMatches(session)) return SpiBufferResult(3<<56)
    return toughDisplaySessionSleepOwned(session,sleep,brightness,true)
}
