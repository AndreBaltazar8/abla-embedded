import "./expander_owner_sequence.ab"
import "./pmic_types.ab"
import "../power/pm1_battery_presence.ab"
import "./tough_boot_types.ab"
// Boot-only, borrowed handles, no allocation/close/rollback. Requires fresh,
// separately initialized presence state. Consume wake reasons BEFORE calling:
// the input phase clears PM1 wake/IRQ status. One nonblocking presence sample
// matches upstream startup; unknown remains unknown, never forced present.
// After success caller still configures CPU GPIO4 digital input/pullup.
trusted fun M5Expanders.configureToughPeripheralsOwned(pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): M5ToughBoot {
    if (!this.ready() || !pmic.ready() || pmic.kind() != 5 || !presence.valid()) return M5ToughBoot(3)
    if (this.board() != m5BoardToughC5) return M5ToughBoot(4)
    val ownerAddress=this.buffer().addressValue()
    val presenceAddress=presence.buffer().addressValue()
    if (ownerAddress < presenceAddress+32 && presenceAddress < ownerAddress+32) return M5ToughBoot(3)
    val buzzer=toughBootBuzzer(pmic)
    val buzzerStatus=buzzer&255
    if (buzzerStatus != 1 && buzzerStatus != 2) return M5ToughBoot(5|(1<<8)|((buzzer&65535)<<16))
    var flags=if (buzzerStatus == 2) 1<<34 else 0
    val inputs=toughBootInputs(this,pmic)
    if ((inputs&255) != 1) return M5ToughBoot(5|(2<<8)|((inputs&65535)<<16)|flags)
    val verdict=toughBootPresence(this,pmic,presence,now)
    if (verdict < -1 || verdict > 1) return M5ToughBoot(5|(3<<8)|flags)
    flags=flags|((verdict+1)<<32)
    val rails=toughBootRails(this,pmic)
    if ((rails&255) != 1) return M5ToughBoot(5|(4<<8)|((rails&65535)<<16)|flags)
    M5ToughBoot((if (buzzerStatus == 2) 2 else 1)|(4<<8)|flags)
}
