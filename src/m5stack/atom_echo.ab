import "../esp32/gpio.ab"
import "../esp32/rgb.ab"
import "../esp32/i2s_types.ab"
import "../esp32/sleep.ab"
import "abla/unsafe/mmio"

// Static M5Stack Atom Echo board profile. M5Unified calls this hardware
// board_M5AtomVoice. Selecting it explicitly avoids runtime board probing and
// leaves each built-in peripheral as the same direct scalar used elsewhere.
type M5AtomEcho = int

@inline
fun m5AtomEcho(): M5AtomEcho = M5AtomEcho(1)

@inline
fun M5AtomEcho.buttonA(): Pin = pin(39)

@inline
fun M5AtomEcho.rgbLed(): RgbLed = rgbLed(27)

@inline
fun M5AtomEcho.audio(sampleRate: int): I2sDevice =
    i2s(0, i2sPins(19, 33, 22, 23), sampleRate)

// Grove Port A: SCL is GPIO32 and SDA is GPIO26 on the original Atom family.
@inline
fun M5AtomEcho.portAClock(): Pin = pin(32)

@inline
fun M5AtomEcho.portAData(): Pin = pin(26)

@inline
trusted fun M5AtomEcho.initialize(): void {
    // M5Unified applies this Atom-family workaround because the onboard CH552
    // can otherwise bias GPIO0 above 3.3 V and reduce Wi-Fi sensitivity.
    // This is the constant-pin specialization of Pin.output/write. Keeping it
    // here avoids linking the dynamic pin-mask path for one startup operation.
    gpio_set_direction(0, 2)
    mmioStoreU32(esp32GpioOutputSelectBase, esp32GpioOutputSignal)
    mmioStoreU32(esp32GpioEnableSet, 1)
    mmioStoreU32(esp32GpioOutSet, 1)
    this.buttonA().input()
    this.rgbLed().off()
    return
}

@inline
trusted fun M5AtomEcho.wakeOnButton(): bool = wakeOnLow(39)
