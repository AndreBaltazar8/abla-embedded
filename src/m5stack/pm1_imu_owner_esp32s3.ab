@export("pm1ImuParentStorageSafe")
fun pm1ImuParentStorageSafeHook(storage: NativeBuffer): bool =
    esp32S3I2cFacadeBufferSafe(storage,76,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)
@export("pm1BoardImuClose")
trusted fun pm1BoardImuCloseHook(imu: M5ImuOwner): bool = imu.close()
