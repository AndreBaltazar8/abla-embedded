import "./nesso_power_sequence.ab"
import "./c6_gauge.ab"
import "./battery_current_owned.ab"
import "./pmic_charge.ab"
import "./pmic_status.ab"
import "./button_frame.ab"
// All views remain borrowed from the retained power owner. Single-owner
// serialization includes startup, every poll/control and close. No rebind,
// allocation, implicit recovery, gauge reset or IRQ acknowledgement here.
trusted fun NessoPower.pollButtonLevelsOwned(exclusive: bool): M5ButtonFrame {
    if (!exclusive || !this.ready()) return m5ButtonFrame()
    // BTN1/BTN2 share PI4IOE0 input register0x0f, active low. One coherent read.
    val sample=I2cDevice(this.expanderOwner().deviceHandle()).readRegister8Checked(15)
    return if (sample.valid()) M5ButtonFrame(u32(96|((~sample.value())&3))) else m5ButtonFrame()
}
trusted fun NessoPower.readBatteryMillivoltsOwned(exclusive: bool): M5VoltageRead =
    if (!exclusive || !this.ready()) M5VoltageRead(2<<16)
    else m5BoardArduinoNessoN1.readBatteryMillivoltsOwned(Bq27220(this.gaugeHandle()),true)
trusted fun NessoPower.readBatteryLevelOwned(exclusive: bool): M5BatteryLevelRead =
    if (!exclusive || !this.ready()) M5BatteryLevelRead(2<<8)
    else m5BoardArduinoNessoN1.readBatteryLevelOwned(Bq27220(this.gaugeHandle()),true)
trusted fun NessoPower.readBatteryMilliampsOwned(exclusive: bool): PowerMeasurement =
    if (!exclusive || !this.ready()) PowerMeasurement(0) else Bq27220(this.gaugeHandle()).readBatteryMilliampsOwned(m5BoardArduinoNessoN1,true)
trusted fun NessoPower.readChargingOwned(exclusive: bool): M5PowerStateRead =
    if (!exclusive || !this.ready()) M5PowerStateRead(2<<8) else this.chargerOwner().readChargingOwned(true)
trusted fun NessoPower.setBatteryChargeOwned(enabled: bool,exclusive: bool): M5ChargeControlResult =
    if (!exclusive || !this.ready()) M5ChargeControlResult(2) else this.chargerOwner().setBatteryChargeOwned(enabled,true)
trusted fun NessoPower.setChargeCurrentOwned(maxMilliamps: int,exclusive: bool): M5ChargeControlResult =
    if (!exclusive || !this.ready()) M5ChargeControlResult(2) else this.chargerOwner().setChargeCurrentOwned(maxMilliamps,true)
trusted fun NessoPower.setChargeVoltageOwned(maxMillivolts: int,exclusive: bool): M5ChargeControlResult =
    if (!exclusive || !this.ready()) M5ChargeControlResult(2) else this.chargerOwner().setChargeVoltageOwned(maxMillivolts,true)
