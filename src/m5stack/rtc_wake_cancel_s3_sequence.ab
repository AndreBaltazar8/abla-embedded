import "./rtc_timer_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
// 1 cancelled,2 invalid ownership/input,3 timer/IRQ cleanup failed,
// 4 pad restore failed. Upperbits preserve board-timer result for status3.
type M5RtcWakeCancel=int
fun M5RtcWakeCancel.status(): int = this & 255
fun M5RtcWakeCancel.detail(): M5RtcTimerResult = M5RtcTimerResult(this>>>8)
fun M5RtcWakeCancel.complete(): bool = this == 1
// BEFORE ESP clock/retention preparation only: all peripheral clocks are
// still normal. If ESP preparation began, use the retained finish path.
// Own this RTC timer and the initialized wake record; keep supplies powered.
// Failure preserves retryable state, not permission to release other users.
trusted fun m5RtcWakeCancelS3Owned(board: M5BoardId,rtc: int,pmic: int,wake: NativeBuffer,clocksUnchangedExclusive: bool): M5RtcWakeCancel {
    if (!clocksUnchangedExclusive || (board != m5BoardPaperColor && board != m5BoardPaperMono && board != m5BoardStampPLC) ||
        !wake.hasAddressRange(0,176) || (wake.addressValue() & 3) != 0 ||
        !m5RtcCleanupRtcValid(rtc) || !m5RtcTimerSupported(rtc) ||
        (board.rtcNeedsPmicCleanup() && !m5RtcCleanupPmicValid(pmic)) || !m5RtcWakeCancellationOwned(wake)) return M5RtcWakeCancel(2)
    val stopped=m5RtcBoardTimerOwned(board,rtc,pmic,0)
    if (!stopped.success()) return M5RtcWakeCancel(3 | ((stopped | 0)<<8))
    if (!m5RtcWakeCancellationRestore(wake)) return M5RtcWakeCancel(4)
    M5RtcWakeCancel(1)
}
