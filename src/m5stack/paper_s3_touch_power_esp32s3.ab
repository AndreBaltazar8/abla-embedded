import "./paper_s3_touch_session.ab"
import "./paper_s3_touch_power_sequence.ab"
import "../touch/gt911_power_esp32s3.ab"
trusted fun paperS3TouchPowerAdmission(r: NativeBuffer): bool {
    if (!esp32S3I2cFacadeBufferSafe(r,48,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return false
    val generation=r.loadU32(16)
    val address=r.loadU32(40)
    if (generation < 1 || generation > 2147483647 || (address != 20 && address != 93)) return false
    val descriptor=esp32S3I2cDevicePool().resolve(r.loadU32(20))
    val state=esp32S3I2cState1
    val pad=S3GpioSnapshot(r.loadU32(24))
    return pad.valid() && pad.pin() == 48 &&
        nativeAddressLoadU32(state,8) == 1 && nativeAddressLoadU32(state,4) == generation &&
        nativeAddressLoadU32(state,12) == 41 && nativeAddressLoadU32(state,16) == 42 &&
        esp32S3I2cDeviceKeyMatchesBus(descriptor,(generation<<2)|2) &&
        esp32S3I2cDeviceKeyAddress(descriptor) == address && esp32S3I2cDeviceKeyFrequency(descriptor) == 400000
}
