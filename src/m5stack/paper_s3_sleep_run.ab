import "./paper_s3_sleep_run_sequence.ab"
import "../esp32/power/sleep_gpio_record_esp32s3.ab"
import "../hal/esp32_gpio.ab"
import "../hal/m5stack.ab"
// GPIO_IN1 bit16 is GPIO48. No GPIO or bus configuration during entry.
@export("paperS3SleepFinalPinReleased")
trusted fun paperS3SleepFinalPinReleasedHook(): bool = (s3GpioWakeRead(0x60004040)&0x10000) != 0
