import "./pmic_types.ab"
import "../power/axp192_device.ab"
import "../power/axp2101_device.ab"
import "../power/m5pm1_device.ab"
// Low16 millivolts,status above16:1known2invalid/notexclusive3unsupported
// 4I/O failure or invalid ADC sample. Known zero does not hide failed reads.
// PM1 battery presence needs board-level policy, not raw PMIC dispatch.
type M5VoltageRead=int
fun M5VoltageRead.status(): int = this>>>16
fun M5VoltageRead.valid(): bool = this.status() == 1
fun M5VoltageRead.millivolts(): int = this&65535
// Read-only ADC sample, not presence detection or battery percentage. The
// caller must have established ADC configuration during board setup. PM1 uses
// its retained board battery session; unsupported chips do not perform I/O.
trusted fun M5PmicOpen.readBatteryMillivoltsOwned(exclusive: bool): M5VoltageRead {
    if (!exclusive || !this.ready()) return M5VoltageRead(2<<16)
    if (this.kind() != 2 && this.kind() != 3) return M5VoltageRead(3<<16)
    val handle=this.deviceHandle()
    val value=if (this.kind() == 2) Axp192(handle).batteryMillivoltsChecked()
        else Axp2101(handle).batteryMillivoltsChecked()
    return if (value.valid()) M5VoltageRead((1<<16)|value.value()) else M5VoltageRead(4<<16)
}
trusted fun M5PmicOpen.readVbusMillivoltsOwned(exclusive: bool): M5VoltageRead {
    if (!exclusive || !this.ready()) return M5VoltageRead(2<<16)
    if (this.kind() != 2 && this.kind() != 3 && this.kind() != 5) return M5VoltageRead(3<<16)
    val handle=this.deviceHandle()
    val value=if (this.kind() == 2) Axp192(handle).vbusMillivoltsChecked()
        else if (this.kind() == 3) Axp2101(handle).vbusMillivoltsChecked()
        else M5Pm1(handle).vbusMillivoltsChecked()
    return if (value.valid()) M5VoltageRead((1<<16)|value.value()) else M5VoltageRead(4<<16)
}
