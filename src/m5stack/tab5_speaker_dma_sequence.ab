// Tab5/Tab5X: TX I2S0 DATA26/WS29/BCLK27/MCLK30, mono duplicated on both16bit slots,
// 24kHz,256fsMCLK. Stable XTAL40MHz / (6+49/96) = 6.144MHz exactly.
// Controller already initialized, caller owns both I2S0 directions/clocks,
// selected parked DMA, pads/prior routes/holds, whole ring and cache engine.
// Codec/amplifier OFF, all TX payload initialized. No controller-wide reset,
// codec activation or stream start here. No resource release on failure.
// Low8:1prepared2invalid3DMApark4I2Sbus5I2Sbusy6I2Sreset7DMAprepare
// 8format9pins10ring11cache. Lower-stage detail in bits8+.
trusted fun tab5PrepareSpeakerDmaOwned(channel: int,descriptors: int,count: int,
    payload: int,stride: int,bytes: int,revision: int,polls: int,exclusive: bool): int {
    if (!exclusive || channel < 0 || channel > 2 || revision < 0 || polls < 1 || polls > 1000000 ||
        count < 2 || (bytes & 3) != 0 || !esp32p4AhbGdmaRingLayoutValid(descriptors,count,payload,stride,bytes)) return 2
    if (p4Tab5SpeakerParked(channel) != 1) return 3
    val bus=p4Tab5SpeakerBus()
    if (bus != 1) return 4 | (bus << 8)
    if (!p4Tab5SpeakerI2sStopped()) return 5
    val reset=p4Tab5SpeakerReset()
    if (reset != 1) return 6 | (reset << 8)
    val dma=p4Tab5SpeakerDmaPrepare(channel)
    if (dma != 1) return 7 | (dma << 8)
    val format=p4Tab5SpeakerFormat(revision)
    if (format != 1) return 8 | (format << 8)
    val pins=p4Tab5SpeakerPins()
    if (pins != 1) return 9 | (pins << 8)
    if (!p4Tab5SpeakerRing(descriptors,count,payload,stride,bytes)) return 10
    val published=p4Tab5SpeakerPublish(descriptors,count,payload,stride,bytes,polls)
    if (published != 1) return 11 | (published << 8)
    return 1
}
