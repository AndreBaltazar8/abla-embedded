import "../esp32/gpio/lease_esp32.ab"
import "../display/it8951_software_esp32.ab"
import "../spi/software_sd_mode.ab"
import "./paper_display_owner_sequence.ab"
// Order safes both CS lines and holds reset before touching shared SPI pins.
fun paperDisplayPin(index: int): int = if (index == 0) 15 else if (index == 1) 4 else if (index == 2) 23
    else if (index == 3) 14 else if (index == 4) 12 else if (index == 5) 13 else if (index == 6) 27 else -1
trusted fun paperDisplayPinOpen(record: NativeBuffer,index: int): int =
    esp32GpioLeaseOpenOwned(record,paperDisplayPin(index),index < 5,index == 0 || index == 1 || index == 4,0,true)
trusted fun paperDisplayPinClose(record: NativeBuffer): int = esp32GpioLeaseCloseOwned(record,true)
trusted fun paperDisplayPrepareSdHeld(): void {
    softwareSdPrepareSpiHeld(pin(14),pin(12),pin(13),pin(4),2);return
}
trusted fun paperDisplayResetCycle(): bool {
    classicProbeWrite(0x3FF4400c,1<<23)
    if ((classicProbeRead(0x3FF44004)&(1<<23)) != 0) return false
    peripheralDelayMicroseconds(8000)
    classicProbeWrite(0x3FF44008,1<<23)
    if ((classicProbeRead(0x3FF44004)&(1<<23)) == 0) return false
    peripheralDelayMicroseconds(64000);return true
}
fun paperDisplayTransport(): int = it8951Software(pin(14),pin(12),pin(13),pin(15),pin(27),1)|0
