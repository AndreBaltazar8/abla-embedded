import "./tough_power_owner_view.ab"
import "./rtc_open_types.ab"
import "./rtc_timer_sequence.ab"
import "./rtc_alarm_sequence.ab"
// Borrow live ready RX8130 and PM1 devices on the same ready C5 HP bus.
// Caller serializes power/RTC/bus lifetimes and consumes desired wake evidence
// before mutation. No implicit sleep, handle close, or PM1 mask changes.
trusted fun toughRtcInterruptAdmitted(owner: M5ToughPowerOwner,rtc: M5RtcOpenResult,bus: int,exclusive: bool): bool {
    if (!exclusive || owner.status() != 1 || !owner.bootResult().powerReady() ||
        !owner.pmic().ready() || owner.pmic().kind() != 5 || !rtc.ready() ||
        (rtc.handle()>>>32) != 2 || (rtc.handle()&0xffffffff) == 0) return false
    return toughRtcBusOwnsPmic(bus,owner.pmic().deviceHandle()) && toughRtcBusOwnsRx8130(bus,rtc.handle()&0xffffffff)
}
// Driver duration/quantization and stop semantics remain intact. The returned
// timer result stays visible even if subsequent PM1 cleanup fails.
trusted fun M5ToughPowerOwner.setRtcTimerOwned(rtc: M5RtcOpenResult,bus: int,milliseconds: int,exclusive: bool): M5RtcTimerResult {
    if (!toughRtcInterruptAdmitted(this,rtc,bus,exclusive)) return M5RtcTimerResult(2<<16)
    return m5RtcBoardTimerOwned(m5BoardToughC5,rtc.handle(),this.pmic().deviceHandle(),milliseconds)
}
trusted fun M5ToughPowerOwner.setRtcAlarmOwned(rtc: M5RtcOpenResult,bus: int,minute: int,hour: int,day: int,weekday: int,exclusive: bool): M5RtcAlarmResult {
    // RX8130 has a shared day/weekday comparator. Reject impossible requests
    // before clearing any PM1 evidence, not after the RTC driver rejects them.
    if (minute < -1 || minute > 59 || hour < -1 || hour > 23 || day < -1 || day > 31 || day == 0 ||
        weekday < -1 || weekday > 6 || (day >= 0 && weekday >= 0) ||
        !toughRtcInterruptAdmitted(this,rtc,bus,exclusive)) return M5RtcAlarmResult(2<<16)
    return m5RtcBoardAlarmOwned(m5BoardToughC5,rtc.handle(),this.pmic().deviceHandle(),minute,hour,day,weekday)
}
trusted fun M5ToughPowerOwner.clearRtcInterruptOwned(rtc: M5RtcOpenResult,bus: int,disable: bool,exclusive: bool): M5RtcCleanupResult {
    if (!toughRtcInterruptAdmitted(this,rtc,bus,exclusive)) return M5RtcCleanupResult(0)
    return m5RtcCleanupOwned(m5BoardToughC5,rtc.handle(),this.pmic().deviceHandle(),disable)
}
