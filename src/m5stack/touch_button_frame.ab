import "./touch_buttons.ab"
import "../input/touch_frame.ab"
// Invalid0 is not a released frame. Valid bit8, controlled A/B/C mask4..6,
// pressed mask0..2. Failed hardware reads must not be passed as empty frames.
type M5TouchButtons = int
fun M5TouchButtons.valid(): bool = (this&256) != 0
// No new report, not a transport failure. Only an owning poller with a saved
// accepted sample may reuse levels; this marker itself is not a valid frame.
fun M5TouchButtons.unchanged(): bool = this == 512
fun M5TouchButtons.controlled(): int = (this>>>4)&7
fun M5TouchButtons.pressed(): int = this&7
// Caller holds tracker/frame ownership and supplies raw points from the SAME
// accepted report used to update tracker (possibly with transformed positions).
// Timestamp+ID mask checks reject skipped/throttled or incomplete reports.
trusted fun M5BoardId.touchButtonsFromFrame(tracker: TouchTracker,raw: NativeBuffer,count: int,
    reportMilliseconds: int,previousPressed: int,ratio: int): M5TouchButtons {
    if (tracker <= 0 || tracker > 4294967296-touchTrackerBytes || count < 0 || count > 5 ||
        !raw.hasAddressRange(0,count*8) || ratio < 0 || ratio > 255 ||
        previousPressed < 0 || previousPressed > 7) return M5TouchButtons(0)
    if (count > 0 && raw.addressValue() < tracker+touchTrackerBytes && tracker < raw.addressValue()+count*8) return M5TouchButtons(0)
    if (tracker.lastMilliseconds() != (reportMilliseconds&4294967295) ||
        tracker.frameMilliseconds() != (reportMilliseconds&4294967295)) return M5TouchButtons(0)
    var seen=u32(0)
    var active=u32(0)
    var index=0
    while (index < count) {
        val point=controllerFramePoint(raw,index)
        if (!point.valid() || point.id() >= 5 || point.event() == 3) return M5TouchButtons(0)
        val bit=u32(1)<<u32(point.id())
        if ((seen&bit) != u32(0)) return M5TouchButtons(0)
        seen=seen|bit
        if (point.event() != 1) active=active|bit
        val state=tracker.detail(point.id()).state() | 0
        if (state < 0 || state > 15 || ((state&1) != 0) != (point.event() != 1)) return M5TouchButtons(0)
        index=index+1
    }
    if (active != u32(tracker.updatedMask())) return M5TouchButtons(0)
    var pressed=0
    index=count
    while (index > 0) {
        index=index-1
        val point=controllerFramePoint(raw,index)
        pressed=this.accumulateTouchButtons(previousPressed,pressed,point.x(),point.y(),tracker.detail(point.id()).state() | 0,ratio)
    }
    M5TouchButtons(256|(this.touchButtonRawMask()<<4)|pressed)
}
