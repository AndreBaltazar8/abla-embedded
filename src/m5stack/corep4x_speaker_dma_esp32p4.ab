import "./corep4x_speaker_dma_sequence.ab"
import "../esp32/i2s/standard_config_esp32p4.ab"
import "../esp32/i2s/transfer_esp32p4.ab"
import "../esp32/i2s/pins_esp32p4.ab"
import "../esp32/ahb_gdma_control_esp32p4.ab"
import "../esp32/ahb_gdma_publish_esp32p4.ab"
trusted fun p4CoreSpeakerParked(channel: int): int = esp32p4AhbGdmaParkedOwned(channel,true,true)
trusted fun p4CoreSpeakerBus(): int = esp32p4I2sEnableBusOwned(0,true)
trusted fun p4CoreSpeakerI2sStopped(): bool = ((mmioLoadU32(0x500c6020)|mmioLoadU32(0x500c6024))&263) == 0
trusted fun p4CoreSpeakerReset(): int = esp32p4I2sResetDirectionOwned(0,true,true)
trusted fun p4CoreSpeakerDmaPrepare(channel: int): int = esp32p4AhbGdmaPrepareI2sOwned(channel,true,0,true)
trusted fun p4CoreSpeakerFormat(revision: int): int = esp32p4I2sConfigureStandardOwned(0,true,0,revision,6,49,96,8,16,16,16,true,3,1,true)
trusted fun p4CoreSpeakerPins(): int = esp32p4I2sRoutePinsOwned(0,true,2,6,4,3,0,true)
trusted fun p4CoreSpeakerRing(descriptors: int,count: int,payload: int,stride: int,bytes: int): bool = esp32p4AhbGdmaBuildRingOwned(descriptors,count,payload,stride,bytes,true,true,true)
trusted fun p4CoreSpeakerPublish(descriptors: int,count: int,payload: int,stride: int,bytes: int,polls: int): int = esp32p4AhbGdmaPublishRingOwned(descriptors,count,payload,stride,bytes,polls,true)
