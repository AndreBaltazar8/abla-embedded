import "./corep4x_speaker_dma_sequence.ab"
import "../esp32/i2s/standard_config_esp32p4.ab"
import "../esp32/i2s/transfer_esp32p4.ab"
import "../esp32/i2s/pins_esp32p4.ab"
import "../esp32/ahb_gdma_control_esp32p4.ab"
import "../esp32/ahb_gdma_publish_esp32p4.ab"
import "../hal/m5stack.ab"
import "../hal/m5stack_2.ab"
import "../esp32/ahb_gdma_control_p4_sequence.ab"
import "../esp32/i2s/clock_control_p4_sequence.ab"
import "abla/unsafe/mmio"
import "../esp32/i2s/transfer_p4_sequence.ab"
import "../esp32/i2s/pins_p4_sequence.ab"
import "../esp32/ahb_gdma_ring_p4_sequence.ab"
import "../esp32/ahb_gdma_publish_p4_sequence.ab"
@export("p4CoreSpeakerParked")
trusted fun p4CoreSpeakerParkedHook(channel: int): int = esp32p4AhbGdmaParkedOwned(channel,true,true)
@export("p4CoreSpeakerBus")
trusted fun p4CoreSpeakerBusHook(): int = esp32p4I2sEnableBusOwned(0,true)
@export("p4CoreSpeakerI2sStopped")
trusted fun p4CoreSpeakerI2sStoppedHook(): bool = ((mmioLoadU32(0x500c6020)|mmioLoadU32(0x500c6024))&263) == 0
@export("p4CoreSpeakerReset")
trusted fun p4CoreSpeakerResetHook(): int = esp32p4I2sResetDirectionOwned(0,true,true)
@export("p4CoreSpeakerDmaPrepare")
trusted fun p4CoreSpeakerDmaPrepareHook(channel: int): int = esp32p4AhbGdmaPrepareI2sOwned(channel,true,0,true)
@export("p4CoreSpeakerFormat")
trusted fun p4CoreSpeakerFormatHook(revision: int): int = esp32p4I2sConfigureStandardOwned(0,true,0,revision,6,49,96,8,16,16,16,true,3,1,true)
@export("p4CoreSpeakerPins")
trusted fun p4CoreSpeakerPinsHook(): int = esp32p4I2sRoutePinsOwned(0,true,2,6,4,3,0,true)
@export("p4CoreSpeakerRing")
trusted fun p4CoreSpeakerRingHook(descriptors: int,count: int,payload: int,stride: int,bytes: int): bool = esp32p4AhbGdmaBuildRingOwned(descriptors,count,payload,stride,bytes,true,true,true)
@export("p4CoreSpeakerPublish")
trusted fun p4CoreSpeakerPublishHook(descriptors: int,count: int,payload: int,stride: int,bytes: int,polls: int): int = esp32p4AhbGdmaPublishRingOwned(descriptors,count,payload,stride,bytes,polls,true)
