import "./rtc_wake_cleanup_sequence.ab"
import "../rtc/timer_result.ab"
// Low16: cleanup result; high48: exact driver timer result including duration.
// This fits all supported timer durations without allocation or out-parameters.
type M5RtcTimerResult = int
fun M5RtcTimerResult.timer(): RtcTimerResult = RtcTimerResult(this>>>16)
fun M5RtcTimerResult.cleanup(): M5RtcCleanupResult = M5RtcCleanupResult(this & 65535)
fun M5RtcTimerResult.success(): bool = this.timer().valid() && this.cleanup().success()
trusted fun m5RtcBoardTimerOwned(board: M5BoardId,rtc: int,pmic: int,milliseconds: int): M5RtcTimerResult {
    if (!m5RtcCleanupRtcValid(rtc) || (board.rtcNeedsPmicCleanup() && !m5RtcCleanupPmicValid(pmic)))
        return M5RtcTimerResult(2<<16)
    if (!m5RtcTimerSupported(rtc)) return M5RtcTimerResult(6<<16)
    val timer=m5RtcConfigureTimer(rtc,milliseconds)
    val cleanup=m5RtcFinishCleanup(board,timer.valid(),pmic)
    M5RtcTimerResult((timer<<16) | cleanup)
}
