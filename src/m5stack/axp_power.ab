import "./power_profile.ab"
import "../power/axp192_device.ab"
import "../power/axp2101_device.ab"

// Borrowed I2C handle low32, chip identity next8, status next3. Caller owns
// the device lifetime/bus configuration. Binding reads identity register3
// once; never allocates, closes, configures rails or changes charge settings.
// Status1 unsupported board,2 invalid handle,3 read failure,4 wrong identity,
// 5 success. No guessed fallback after communication failure.
type M5AxpPower = int
fun M5AxpPower.status(): int = (this >>> 40) & 7
fun M5AxpPower.valid(): bool = this.status() == 5 && (this>>>43) == 0 &&
    (this & 4294967295) != 0 && (this.identity() == 3 || this.identity() == 74)
fun M5AxpPower.identity(): int = (this >>> 32) & 255
fun M5AxpPower.device(): I2cDevice = I2cDevice(this & 4294967295)
trusted fun M5BoardId.bindAxpPower(device: I2cDevice): M5AxpPower {
    val kind=this.powerKind()
    if (kind != m5PowerAxp192Or2101 && kind != m5PowerAxp2101) return M5AxpPower(1 << 40)
    val handle=device & 4294967295
    if (handle == 0 || (device & ~4294967295) != 0) return M5AxpPower(2 << 40)
    val identity=device.readRegister8Checked(3)
    if (!identity.valid()) return M5AxpPower(3 << 40)
    val id=identity.value()
    val accepted=id == 74 || (id == 3 && kind == m5PowerAxp192Or2101)
    M5AxpPower(handle | (id << 32) | ((if (accepted) 5 else 4) << 40))
}
trusted fun M5AxpPower.batteryMillivoltsChecked(): I2cWordResult {
    if (!this.valid()) return I2cWordResult(0)
    if (this.identity() == 3) return Axp192(this & 4294967295).batteryMillivoltsChecked()
    if (this.identity() == 74) return Axp2101(this & 4294967295).batteryMillivoltsChecked()
    I2cWordResult(0)
}
trusted fun M5AxpPower.chargingChecked(): I2cByteResult {
    if (!this.valid()) return I2cByteResult(0)
    if (this.identity() == 3) return this.device().readChargingChecked(powerChargeAxp192)
    if (this.identity() == 74) return this.device().readChargingChecked(powerChargeAxp2101)
    I2cByteResult(0)
}
trusted fun M5AxpPower.batteryPresentChecked(): I2cByteResult {
    if (!this.valid()) return I2cByteResult(0)
    this.device().readBatteryPresentChecked(if (this.identity() == 3) powerChargeAxp192 else powerChargeAxp2101)
}
// Use Power_Class's AXP192 voltage estimate, not the distinct legacy
// AXP192 driver's discharge-adjusted batteryLevel algorithm.
trusted fun M5AxpPower.batteryLevelChecked(): I2cByteResult {
    if (!this.valid()) return I2cByteResult(0)
    if (this.identity() == 3) return axp192PowerBatteryLevel(Axp192(this & 4294967295).read12(120))
    Axp2101(this & 4294967295).batteryLevelChecked()
}
trusted fun M5AxpPower.powerKeyPressChecked(): PowerKeyEvent {
    if (!this.valid()) return PowerKeyEvent(256)
    if (this.identity() == 3) return Axp192(this & 4294967295).powerKeyPressChecked()
    if (this.identity() == 74) return Axp2101(this & 4294967295).powerKeyPressChecked()
    PowerKeyEvent(256)
}
// Borrowed, identity-checked chip; preserve the underlying driver's discrete
// settings and minimum/maximum clamping. These are register requests, not
// guarantees that the measured charge current equals a requested value.
trusted fun M5AxpPower.setBatteryCharge(enabled: bool): bool {
    if (!this.valid()) return false
    if (this.identity() == 3) Axp192(this.device() | 0).setBatteryCharge(enabled)
    else Axp2101(this.device() | 0).setBatteryCharge(enabled)
}
trusted fun M5AxpPower.setChargeCurrent(maxMilliamps: int): bool {
    if (!this.valid() || maxMilliamps < 0) return false
    if (this.identity() == 3) Axp192(this.device() | 0).setChargeCurrent(maxMilliamps)
    else Axp2101(this.device() | 0).setChargeCurrent(maxMilliamps)
}
trusted fun M5AxpPower.setChargeVoltage(maxMillivolts: int): bool {
    if (!this.valid() || maxMillivolts < 0) return false
    if (this.identity() == 3) Axp192(this.device() | 0).setChargeVoltage(maxMillivolts)
    else Axp2101(this.device() | 0).setChargeVoltage(maxMillivolts)
}
