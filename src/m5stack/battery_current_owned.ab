import "./battery_current.ab"
import "../power/bq27220_device.ab"
import "../power/powerhub_telemetry.ab"
// Borrow configured sensors; never open, reset, calibrate, or close them.
// Positive means charging. Unsupported board/sensor pairs and failed reads
// stay invalid, distinct from a measured zero. Readings are not snapshots.
trusted fun M5AxpPower.readBatteryMilliampsOwned(board: M5BoardId,monitor: Ina3221,exclusive: bool): PowerMeasurement =
    if (!exclusive) PowerMeasurement(0) else board.axpBatteryMilliampsChecked(this,monitor)
trusted fun Ina226.readBatteryMilliampsOwned(board: M5BoardId,exclusive: bool): PowerMeasurement =
    if (!exclusive) PowerMeasurement(0) else board.tabBatteryMilliampsChecked(this)
trusted fun Bq27220.readBatteryMilliampsOwned(board: M5BoardId,exclusive: bool): PowerMeasurement =
    if (!exclusive || board != m5BoardArduinoNessoN1) PowerMeasurement(0) else this.currentMilliampsChecked()
trusted fun PowerHubPower.readBatteryMilliampsOwned(board: M5BoardId,exclusive: bool): PowerMeasurement =
    if (!exclusive || board != m5BoardPowerHub) PowerMeasurement(0) else this.batteryMilliampsChecked()
