import "./pmic_types.ab"
import "../power/axp192_device.ab"
import "../power/axp2101_device.ab"
import "../power/ip5306_device.ab"
import "../power/aw32001_device.ab"
// Shared charge controls on the detected/owned PMIC, without rebinding or
// allocating.1applied2invalid/notexclusive3board-specific/unsupported4I/O.
// Success acknowledges a register request, not measured current or voltage.
// Preserve each chip's discrete rounding/clamping (zero current is NOT off).
type M5ChargeControlResult=int
fun M5ChargeControlResult.applied(): bool = this == 1
fun M5PmicOpen.supportsDirectChargeControl(): bool = this.ready() && this.kind() != 5
// PM1 deliberately excluded: board GPIO current selectors and presence-cache
// updates must go through board-specific APIs, not the chip's stub setters.
trusted fun M5PmicOpen.setBatteryChargeOwned(enabled: bool,exclusive: bool): M5ChargeControlResult {
    if (!exclusive || !this.ready()) return M5ChargeControlResult(2)
    if (!this.supportsDirectChargeControl()) return M5ChargeControlResult(3)
    val handle=this.deviceHandle()
    val result=if (this.kind() == 2) Axp192(handle).setBatteryCharge(enabled)
        else if (this.kind() == 3) Axp2101(handle).setBatteryCharge(enabled)
        else if (this.kind() == 4) Ip5306(handle).setBatteryCharge(enabled)
        else Aw32001(handle).setBatteryCharge(enabled)
    return M5ChargeControlResult(if (result) 1 else 4)
}
trusted fun M5PmicOpen.setChargeCurrentOwned(maxMilliamps: int,exclusive: bool): M5ChargeControlResult {
    if (!exclusive || !this.ready() || maxMilliamps < 0 || maxMilliamps > 65535) return M5ChargeControlResult(2)
    if (!this.supportsDirectChargeControl()) return M5ChargeControlResult(3)
    val handle=this.deviceHandle()
    val result=if (this.kind() == 2) Axp192(handle).setChargeCurrent(maxMilliamps)
        else if (this.kind() == 3) Axp2101(handle).setChargeCurrent(maxMilliamps)
        else if (this.kind() == 4) Ip5306(handle).setChargeCurrent(maxMilliamps)
        else Aw32001(handle).setChargeCurrent(maxMilliamps)
    return M5ChargeControlResult(if (result) 1 else 4)
}
trusted fun M5PmicOpen.setChargeVoltageOwned(maxMillivolts: int,exclusive: bool): M5ChargeControlResult {
    if (!exclusive || !this.ready() || maxMillivolts < 0 || maxMillivolts > 65535) return M5ChargeControlResult(2)
    if (!this.supportsDirectChargeControl()) return M5ChargeControlResult(3)
    val handle=this.deviceHandle()
    val result=if (this.kind() == 2) Axp192(handle).setChargeVoltage(maxMillivolts)
        else if (this.kind() == 3) Axp2101(handle).setChargeVoltage(maxMillivolts)
        else if (this.kind() == 4) Ip5306(handle).setChargeVoltage(maxMillivolts)
        else Aw32001(handle).setChargeVoltage(maxMillivolts)
    return M5ChargeControlResult(if (result) 1 else 4)
}
