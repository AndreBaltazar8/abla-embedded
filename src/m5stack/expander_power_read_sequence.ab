import "./board_id.ab"
import "../i2c/results.ab"
// Read one port's output latch, matching setExpanderPower's mapping.
// PA1, USB32, Tab5X external bus256. Not an input sample or voltage proof.
// Reject aggregate masks: these are independent reads, not an atomic snapshot.
trusted fun M5BoardId.expanderPowerEnabledCheckedOwned(ioe0: int,ioe1: int,port: int): I2cByteResult {
    val tab=this == m5BoardTab5 || this == m5BoardTab5X
    val core=this == m5BoardCoreP4X || this == m5BoardCoreMatrix
    val nesso=this == m5BoardArduinoNessoN1
    if (!tab && !core && !nesso) return I2cByteResult(0)
    if (port != 1 && !(port == 32 && (tab || this == m5BoardCoreP4X)) &&
        !(port == 256 && this == m5BoardTab5X)) return I2cByteResult(0)
    val handle=if (nesso || (tab && port == 32)) ioe1 else ioe0
    if (handle <= 0 || handle > 4294967295) return I2cByteResult(0)
    val pin=if (port == 256) 3 else if (port == 32) (if (tab) 3 else 1) else if (core) 4 else 2
    expanderPowerReadLatch(handle,pin,core)
}
