import "./imu_probe_types.ab"
import "../imu/temperature.ab"
// Checked die temperature, not ambient temperature. Integer millidegrees
// express the selected upstream calibration, not sensor accuracy. No bus IO.
fun M5ImuKind.temperature(sample: ImuSample): ImuTemperature =
    if (this == m5ImuBmi270) bmi270Temperature(sample) else
    if (this == m5ImuSh200q) sh200qTemperature(sample) else
    if (this == m5ImuMpu6886 || this == m5ImuMpu6050 || this == m5ImuMpu9250) mpu6886Temperature(sample) else ImuTemperature(0)
