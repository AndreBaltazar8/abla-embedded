import "./cores3_display_control.ab"

// Board-wide AW9523 configuration from M5GFX's CoreS3 initialization. Do not
// call on a live board with active peripheral users. No whole-chip reset.
// requestExternal5v=true explicitly enables BOOST_EN and BUS_EN; false
// preserves their existing state (it does NOT promise an externally off rail).
// Unlike upstream, no inferred enable from sampled SPI pull-up levels.
trusted fun cores3ConfigureExpander(expander: Aw9523, requestExternal5v: bool): bool {
    if (!expander.begin()) return false
    val device = expander.device()
    val port1 = if (requestExternal5v) 131 else 3
    val port0 = if (requestExternal5v) 7 else 5
    // Latch boost before BUS_EN if requested, then configure GPIO mode and
    // drive before directions. Unrelated output latch bits are preserved.
    device.updateRegister8(3, port1, port1) &&
        device.updateRegister8(2, port0, port0) &&
        expander.configureControl(true, 0) &&
        device.writeRegister8(18, 255) && device.writeRegister8(19, 255) &&
        device.writeRegister8(4, 24) && device.writeRegister8(5, 12)
}

// CoreS3/SE board PMIC policy from M5Unified Power_Class::begin. Caller owns
// the AXP2101 handle and serializes the complete board initialization lifecycle.
// This changes board-wide audio/camera/SD supplies and PMU/key/ADC settings;
// it is not a per-display resume operation. AW9523/boost setup is separate.
trusted fun cores3ConfigurePmic(power: Axp2101): bool {
    if (!power.begin() || !cores3DisplaySetBrightness(power, 0)) return false
    val device = power.device()
    // Program ALDO voltages before enabling their rails: speaker 1.8V,
    // microphone/camera/SD 3.3V. Match upstream BLDO enable policy without
    // changing its voltage registers. No implicit chip reset or power cycle.
    if (!device.writeRegister8(146, 13) || !device.writeRegister8(147, 28) ||
        !device.writeRegister8(148, 28) || !device.writeRegister8(149, 28) ||
        !device.writeRegister8(39, 0) || !device.writeRegister8(105, 17) ||
        !device.writeRegister8(16, 48) || !device.writeRegister8(48, 15)) return false
    // Unlike upstream's BF whole-register write, keep DLDO1/backlight off
    // until panel initialization succeeds; preserve the unrelated bit6.
    device.updateRegister8(144, 63, 63)
}
