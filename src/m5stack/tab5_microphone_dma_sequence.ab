import "../esp32/i2s/stereo_microphone_dma_p4_sequence.ab"
// Tab5/Tab5X RX0 DATA28/WS29/BCLK27/MCLK30, fixed24kHz stereo.
trusted fun tab5PrepareMicrophoneDmaOwned(channel: int,descriptors: int,count: int,
    payload: int,stride: int,bytes: int,revision: int,polls: int,exclusive: bool): int =
    esp32p4PrepareStereoMicrophone24kDmaOwned(channel,descriptors,count,payload,stride,bytes,revision,polls,30,27,29,28,exclusive)
