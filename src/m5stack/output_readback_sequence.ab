import "./board_id.ab"
import "../i2c/results.ab"
fun m5OutputHandleValid(handle: int): bool = handle > 0 && handle <= 4294967295
fun m5OutputBit(value: I2cByteResult,mask: int): I2cByteResult =
    if (!value.valid()) I2cByteResult(0) else I2cByteResult(256|(if ((value.value() & mask) != 0) 1 else 0))
// power is the borrowed PM1 (or PowerHub) device; expander is AW9523 on
// CoreS3, IOE0 on CoreP4X/CoreMatrix/ChainCaptain/Tab, IOE1 on Nesso.
// USB query takes IOE1 for Tab, IOE0 for CoreP4X. Unused handles may be zero.
// Reads control latches, not a guarantee of measured voltage at the connector.
// Unsupported boards and failed reads are invalid, never valid "off".
trusted fun M5BoardId.externalOutputCheckedOwned(power: int,expander: int): I2cByteResult {
    if (this == m5BoardTab5 || this == m5BoardTab5X || this == m5BoardArduinoNessoN1) {
        if (!m5OutputHandleValid(expander)) return I2cByteResult(0)
        return m5OutputBit(m5OutputReadByte(expander,5),if (this == m5BoardTab5X) 8 else 4)
    }
    if (this == m5BoardStackCoreS3 || this == m5BoardStackCoreS3SE || this == m5BoardStackChan) {
        if (!m5OutputHandleValid(expander)) return I2cByteResult(0)
        return m5OutputBit(m5OutputReadByte(expander,2),2)
    }
    if (this == m5BoardCoreP4X || this == m5BoardCoreMatrix) {
        if (!m5OutputHandleValid(expander)) return I2cByteResult(0)
        return m5OutputBit(m5OutputReadByte(expander,5),16)
    }
    if (this == m5BoardPowerHub) {
        if (!m5OutputHandleValid(power)) return I2cByteResult(0)
        val ports=m5OutputReadDword(power,1)
        if (!ports.valid()) return I2cByteResult(0)
        return I2cByteResult(256|(if (ports.value() != 0) 1 else 0))
    }
    val direct=this == m5BoardStickS3 || this == m5BoardStopWatch ||
        this == m5BoardPaperColor || this == m5BoardToughC5
    if (direct || this == m5BoardStampS3Bat) {
        if (!m5OutputHandleValid(power)) return I2cByteResult(0)
        return m5OutputBit(m5OutputReadByte(power,if (direct) 6 else 17),if (direct) 8 else 2)
    }
    if (this == m5BoardChainCaptain) {
        if (!m5OutputHandleValid(power) || !m5OutputHandleValid(expander)) return I2cByteResult(0)
        val boost=m5OutputBit(m5OutputReadByte(expander,5),8)
        if (!boost.valid() || boost.value() == 0) return boost
        return m5OutputBit(m5OutputReadByte(power,17),9)
    }
    I2cByteResult(0)
}
trusted fun M5BoardId.usbOutputCheckedOwned(expander: int): I2cByteResult {
    if (!m5OutputHandleValid(expander)) return I2cByteResult(0)
    // Tab USB readback complements its implemented IOE1G3 setter.
    if (this == m5BoardTab5 || this == m5BoardTab5X) return m5OutputBit(m5OutputReadByte(expander,5),8)
    if (this == m5BoardStackCoreS3 || this == m5BoardStackCoreS3SE || this == m5BoardStackChan)
        return m5OutputBit(m5OutputReadByte(expander,2),32)
    if (this == m5BoardCoreP4X) return m5OutputBit(m5OutputReadByte(expander,5),2)
    I2cByteResult(0)
}
