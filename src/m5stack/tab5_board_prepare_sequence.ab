import "./board_id.ab"
import "../esp32/sdk/raw_buffer.ab"
import "./tab5_board_prepare_result.ab"
// Explicit cold-board preparation, not resume. Caller owns a ready control bus,
// fresh initialized expander owner, GPIO23 and every affected board peripheral.
// Keep this entire operation exclusive: power tables affect WLAN, charger,
// camera/display/touch resets, antenna and external supply controls.
// Result low8:1power/reset complete,2invalid,3expander owner not fresh,
// 4expander discovery failure,5power setup failure,6reset failure.
// High bits preserve complete underlying stage result, including applied steps.
// No automatic rollback/close: caller expander owner retains partial handles;
// power/reset changes may persist even when no handles remain. Diagnose before
// retrying, close expanders before closing bus, retain GPIO23 until made safe.
// Does not claim display initialization, touch identification or video startup.
trusted fun tab5BoardPrepareOwned(board: M5BoardId,bus: int,expanders: int,scratch: NativeBuffer): Tab5BoardPrepare {
    if ((board != m5BoardTab5 && board != m5BoardTab5X) || !scratch.hasAddressRange(0,1) ||
        !tab5BoardPrepareValid(bus,expanders,scratch)) return Tab5BoardPrepare(2)
    if (!tab5BoardPrepareFresh(expanders)) return Tab5BoardPrepare(3)
    val opened=tab5BoardPrepareExpanders(bus,expanders,board)
    if (opened != 1) return Tab5BoardPrepare(4|((opened&4294967295)<<8))
    val power=tab5BoardPreparePower(expanders)
    if ((power&255) != 1) return Tab5BoardPrepare(5|((power&4294967295)<<8))
    val reset=tab5BoardPrepareReset(bus,scratch)
    if (reset != 1) return Tab5BoardPrepare(6|((reset&4294967295)<<8))
    return Tab5BoardPrepare(1)
}
