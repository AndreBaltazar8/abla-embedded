import "./tough_display_session_c5_sequence.ab"
// Explicit cache-on panel policy, NOT automatically coupled to MCU sleep.
// M5GFX Panel_LCD::setSleep emits10/11. Retain panel rail/reset/config/GRAM;
// blank PWM before sleep, restore requested brightness only after wake.
// Conservative120ms settle in both directions (ILI9342 initialization uses
//120ms after SLPOUT). Hold SPI gate throughout command and settling delay.
// All display/touch/PWM users stopped, clocks held, no draws while asleep.
// No retry from uncertain7: explicit quiesce then caller-directed recovery.
// SPI result preserves transport detail; detail4 means uncertain PWM write.
trusted fun toughDisplaySessionSleepOwned(session: NativeBuffer,sleep: bool,brightness: int,
    exclusiveQuiesced: bool): SpiBufferResult {
    if (!exclusiveQuiesced || brightness < 0 || brightness > 255 ||
        !toughDisplaySessionStorage(session) || session.loadU32(0) != 0x54445353 ||
        session.loadU32(4) != (if (sleep) 1 else 6)) return SpiBufferResult(3<<56)
    val master=Esp32C5SpiMaster(toughDisplaySessionWord64(session,8))
    val bus=toughDisplaySessionWord64(session,16)
    val gate=peripheralGateAt(session.loadU32(32));val owner=u32(session.loadU32(36))
    if (!master.ready() || master.pins().pinAt(3) != 25 || !peripheralOwnerValid(owner) ||
        !c5SpiGateValid(gate) || !gate.bufferDisjoint(session,72) ||
        !toughDisplayStartupDeviceMatches(bus,session.loadU32(28),79) ||
        !c5SpiMasterDataReady(master,true) || !c5SpiManualSelectReady(26) ||
        (c5SpiRead(0x6008103c)&u32(0x60003)) != u32(0) ||
        gate.word().compareExchange(u32(0),u32(0)) != u32(0)) return SpiBufferResult(3<<56)
    session.storeU32(4,7)
    val io=M5Ioe1(session.loadU32(28))
    if (sleep && toughBacklightSetOwned(io,0,true) != 1) return SpiBufferResult((6<<56)|4)
    val result=esp32C5LcdControl(master|0,gate,owner,26,if (sleep) 16 else 17,120,1000)
    if (!result.valid()) return result
    if (!sleep && toughBacklightSetOwned(io,brightness,true) != 1) return SpiBufferResult((6<<56)|4)
    session.storeU32(4,if (sleep) 6 else 1)
    return result
}
