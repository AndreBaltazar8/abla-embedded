import "./expander_owner.ab"
// These are I2C operations for a serialized task/service context, not direct
// CPU ISR callbacks. They do not configure or attach the CPU interrupt pin.
trusted fun M5Expanders.setInterruptMask(index: int,enabledPins: int): bool {
    if (!this.ready()) return false
    val slot=this.slot(index)
    if (!slot.ready()) return false
    if (slot.kind() == 1) Pi4Ioe5v6408(slot.deviceHandle()).setInterruptMask(enabledPins)
    else M5Ioe1(slot.deviceHandle()).setInterruptMask(enabledPins)
}
trusted fun M5Expanders.setInterruptsEnabled(index: int,enabled: bool): bool {
    if (!this.ready()) return false
    val slot=this.slot(index)
    if (!slot.ready()) return false
    this.setInterruptMask(index,if (!enabled) 0 else if (slot.kind() == 1) 255 else 16383)
}
// Explicitly clears pending interrupt state: PI4 reads status13h (read-clear),
// M5IOE writes zero to11h/12h. Read required input state before discarding IRQs.
trusted fun M5Expanders.resetInterrupt(index: int): bool {
    if (!this.ready()) return false
    val slot=this.slot(index)
    if (!slot.ready()) return false
    if (slot.kind() == 1) Pi4Ioe5v6408(slot.deviceHandle()).resetInterrupt()
    else M5Ioe1(slot.deviceHandle()).resetInterrupt()
}
