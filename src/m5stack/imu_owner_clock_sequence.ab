import "./imu_owner_types.ab"
// Result status1complete2invalid4one-or-more failed. Masks primary1/BMM2/AK4.
// Each owned device is attempted once, even when another fails. No rollback:
// successful rates stay applied; caller can retry explicitly. Serialize owner
// lifecycle and all sensor acquisition around the complete group operation.
type M5ImuClockResult=int
fun M5ImuClockResult.status(): int = this&255
fun M5ImuClockResult.attempted(): int = (this>>>8)&7
fun M5ImuClockResult.updated(): int = (this>>>12)&7
fun M5ImuClockResult.failed(): int = this.attempted()&~this.updated()
fun M5ImuClockResult.complete(): bool = this.status() == 1
trusted fun M5ImuOwner.setClockOwned(frequency: int,exclusive: bool): M5ImuClockResult {
    if (!exclusive || this.status() != 1 || !this.primary().ready() ||
        frequency < 1000 || frequency > 400000) return M5ImuClockResult(2)
    val mag=this.magnetometers();val kind=mag.selected()
    // Ready probe owns at most one external magnetometer. Failed probe cleanup
    // records must not reconfigure leaked or uninitialized handles.
    if ((mag.status() == 2 && (mag.handle(1) != 0 || mag.handle(2) != 0)) ||
        (mag.status() == 1 && (kind < 1 || kind > 2 || mag.handle(kind) == 0 ||
            mag.handle(3-kind) != 0 || mag.handle(kind) == this.primary().handle())) ||
        (mag.status() != 1 && mag.status() != 2)) return M5ImuClockResult(2)
    var attempted=1
    var updated=if (m5ImuClockSetDevice(this.primary().handle(),frequency)) 1 else 0
    if (mag.status() == 1) {
        val bit=1<<kind
        attempted=attempted|bit
        if (m5ImuClockSetDevice(mag.handle(kind),frequency)) updated=updated|bit
    }
    return M5ImuClockResult((if (updated == attempted) 1 else 4)|(attempted<<8)|(updated<<12))
}
