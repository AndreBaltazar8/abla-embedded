import "./board_id.ab"
type M5RtcKind = int
val m5RtcPcf8563 = M5RtcKind(1)
val m5RtcRx8130 = M5RtcKind(2)
val m5RtcPowerHub = M5RtcKind(3)
// M5Unified RTC_Class::begin selection, not a claim that a board physically
// contains an RTC. Default PCF8563 can be external; begin() must still succeed.
fun M5BoardId.rtcKind(): M5RtcKind {
    if (this == m5BoardPowerHub) return m5RtcPowerHub
    if (this == m5BoardCoreP4X || this == m5BoardTab5 || this == m5BoardTab5X || this == m5BoardToughC5 ||
        this == m5BoardStopWatch || this == m5BoardStampPLC || this == m5BoardPaperColor ||
        this == m5BoardPaperMono || this == m5BoardChainCaptain) return m5RtcRx8130
    m5RtcPcf8563
}
