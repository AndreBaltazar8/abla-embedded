import "./nesso_imu_c6_bindings.ab"
import "../imu/temperature.ab"
// Same caller-owned power/bus/IMU lifetime as acquisition. Two stack bytes,
// no persistent scratch alias, no reset/reprobe or inferred ambient reading.
trusted fun NessoPower.readImuTemperatureOwned(bus: int,imu: M5ImuProbeResult,exclusive: bool): ImuTemperature {
    if (!exclusive || !this.ready() || this.buffer().loadU32(8) != bus || !I2cBus(bus).current() ||
        !nessoI2cPinsMatch(softwareI2cProviderOwner().lines().sda(),softwareI2cProviderOwner().lines().scl()) ||
        !imu.ready() || imu.kind() != m5ImuBmi270 || imu.address() != 104 || !softwareI2cProviderEnter()) return ImuTemperature(0)
    val descriptor=softwareI2cProviderPool().resolve(imu.handle())
    val matches=softwareI2cProviderOwner().matchesDevice(descriptor) && ((descriptor>>>46)&127) == 104
    val released=softwareI2cProviderLeave()
    if (!matches || !released) return ImuTemperature(0)
    return bmi270Temperature(Bmi270(imu.handle()).readTemperatureRaw())
}
