import "../touch/transform.ab"
// The FT5x06 already reports portrait panel pixels 0..479/0..799, the same axes
// as display rotation 0 (checked by tapping a PaperMono's corners, 2026-10-30:
// M5GFX's calibration through the native 800x480 rotation put taps a quarter
// turn away). Other rotations turn from there, as the display's do.
fun TouchPoint.forPaperMonoDisplay(rotation: int): TouchPoint {
    if (!this.inside(480,800) || rotation < 0 || rotation > 7) return TouchPoint(0)
    return this.forLcdRotation(480,800,rotation)
}
