import "../touch/transform.ab"
// Pinned M5GFX calibration:raw0..479/0..799 ->native0..799/0..479,
// then panel offsetrotation3 +requestedrotation (touch offsetrotation0).
// Rational endpoint mapping avoids float dependencies; not bit-for-bit float
// affine rounding parity. Physical orientation still needs board validation.
fun TouchPoint.forPaperMonoDisplay(rotation: int): TouchPoint {
    if (!this.inside(480,800) || rotation < 0 || rotation > 7) return TouchPoint(0)
    return this.scaled(480,800,800,480).forLcdRotation(800,480,((rotation+3)&3)|(rotation&4))
}
