import "../hal/cores3_audio_streams.ab"
import "../esp32/i2s/standard_dma_s3_sequence.ab"
import "../hal/pin.ab"
import "../hal/esp32s3standarddmapreparation.ab"
// Backwards-compatible board profile over the shared standard-I2S primitive.
trusted fun coreS3PrepareAudioDmaDirect(transmit: bool,sampleHz: int,channel: int,
    descriptors: int,count: int,buffers: int,blockBytes: int,owner: u32): CoreS3AudioDmaPreparation =
    CoreS3AudioDmaPreparation(esp32s3PrepareStandard16Dma(1,transmit,pin(0),pin(34),pin(33),pin(if (transmit) 13 else 14),
        3,sampleHz,channel,descriptors,count,buffers,blockBytes,owner)|0)
@export("coreS3PrepareAudioDmaHook")
trusted fun coreS3PrepareAudioDmaHookImpl(transmit: bool,sampleHz: int,channel: int,descriptors: int,count: int,buffers: int,blockBytes: int,owner: int): int =
    int(coreS3PrepareAudioDmaDirect(transmit,sampleHz,channel,descriptors,count,buffers,blockBytes,u32(owner)))
