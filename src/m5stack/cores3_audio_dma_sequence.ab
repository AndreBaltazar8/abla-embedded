import "../esp32/i2s/standard_dma_s3_sequence.ab"
// Backwards-compatible board profile over the shared standard-I2S primitive.
type CoreS3AudioDmaPreparation = int
fun CoreS3AudioDmaPreparation.status(): int = this & 255
fun CoreS3AudioDmaPreparation.valid(): bool = this.status() == 1
fun CoreS3AudioDmaPreparation.sampleRate(): int = if (this.valid()) this >>> 8 else 0
trusted fun coreS3PrepareAudioDma(transmit: bool,sampleHz: int,channel: int,
    descriptors: int,count: int,buffers: int,blockBytes: int,owner: u32): CoreS3AudioDmaPreparation =
    CoreS3AudioDmaPreparation(esp32s3PrepareStandard16Dma(1,transmit,pin(0),pin(34),pin(33),pin(if (transmit) 13 else 14),
        3,sampleHz,channel,descriptors,count,buffers,blockBytes,owner)|0)
