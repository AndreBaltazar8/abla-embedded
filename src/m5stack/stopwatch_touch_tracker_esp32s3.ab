import "./stopwatch_touch_esp32s3.ab"
import "./stopwatch_touch_tracker_sequence.ab"
trusted fun stopWatchTouchTrackerAdmission(control: int,handle: int,tracker: TouchTracker,snapshot: NativeBuffer): bool {
    if (!stopWatchTouchAdmission(control)) return false
    val c=M5Pm1Control(control)
    val bus=c.bus()
    val descriptor=esp32S3I2cDevicePool().resolve(handle)
    if (!esp32S3I2cDeviceKeyMatchesBus(descriptor,bus) ||
        esp32S3I2cDeviceKeyAddress(descriptor) != 21 || esp32S3I2cDeviceKeyFrequency(descriptor) != 400000) return false
    val state=esp32S3I2cState1
    if (esp32S3I2cBusKeyPort(bus) != 1 || nativeAddressLoadU32(state,8) != 1 ||
        nativeAddressLoadU32(state,4) != esp32S3I2cBusKeyGeneration(bus) ||
        nativeAddressLoadU32(state,12) != 47 || nativeAddressLoadU32(state,16) != 48) return false
    val address=c.buffer().addressValue()
    return esp32S3I2cFacadeBufferSafe(nativeBufferAt(tracker|0,touchTrackerBytes),touchTrackerBytes,
        esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        esp32S3I2cFacadeBufferSafe(snapshot,6,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        (tracker+touchTrackerBytes <= address || tracker >= address+72) &&
        (snapshot.addressValue()+6 <= address || snapshot.addressValue() >= address+72)
}
// Borrowed PM1 bus, owned CST session, initialized tracker and disjoint6B
// scratch. Caller serializes all of them through the full poll/update.
trusted fun M5Pm1Control.updateStopWatchTouchOwned(session: Cst816sSession,tracker: TouchTracker,
    snapshot: NativeBuffer,now: int,rotation: int,exclusive: bool): Cst816sSession =
    session.pollStopWatchTrackerOwned(this|0,tracker,snapshot,now,rotation,exclusive)
