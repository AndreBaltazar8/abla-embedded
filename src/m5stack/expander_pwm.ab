import "./expander_owner.ab"
// M5IOE1 has four PWM channels and one shared frequency. PI4 has no PWM.
// Channel numbers are hardware PWM channels, not arbitrary GPIO numbers;
// caller is responsible for board routing and other users of the frequency.
trusted fun M5Expanders.pwmDevice(index: int): M5Ioe1 {
    if (!this.ready()) return M5Ioe1(0)
    val slot=this.slot(index)
    M5Ioe1(if (slot.ready() && slot.kind() == 2) slot.deviceHandle() else 0)
}
trusted fun M5Expanders.setPwmFrequency(index: int,frequency: int): bool = this.pwmDevice(index).setPwmFrequency(frequency)
trusted fun M5Expanders.setPwmDuty12(index: int,channel: int,duty: int,inverted: bool = false,enabled: bool = true): bool =
    this.pwmDevice(index).setPwmDuty12(channel,duty,inverted,enabled)
trusted fun M5Expanders.setPwmDutyPercent(index: int,channel: int,duty: int,inverted: bool = false,enabled: bool = true): bool =
    this.pwmDevice(index).setPwmDutyPercent(channel,duty,inverted,enabled)
// Caller-supplied scratch must not overlap the ownership record.
trusted fun M5Expanders.pwmScratchValid(data: NativeBuffer): bool = this.valid() && data.hasAddressRange(0,2) &&
    (data.addressValue()+2 <= this.buffer().addressValue() || data.addressValue() >= this.buffer().addressValue()+32)
trusted fun M5Expanders.setPwmFrequencyWithBuffer(index: int,frequency: int,data: NativeBuffer): bool =
    this.pwmScratchValid(data) && this.pwmDevice(index).setPwmFrequencyWithBuffer(frequency,data)
trusted fun M5Expanders.setPwmDuty12WithBuffer(index: int,channel: int,duty: int,data: NativeBuffer,
    inverted: bool = false,enabled: bool = true): bool =
    this.pwmScratchValid(data) && this.pwmDevice(index).setPwmDuty12WithBuffer(channel,duty,data,inverted,enabled)
