import "./pmic_types.ab"
import "../power/axp192_device.ab"
import "../power/axp2101_device.ab"
import "../power/ip5306_device.ab"
import "../power/battery_level.ab"
// Low8 percentage, status above8:1known2invalid/notexclusive3unsupported
// 4I/O or invalid gauge sample. This is not universally a fuel-gauge reading:
// AXP192 uses the upstream Power_Class voltage estimate, IP5306 four steps,
// AXP2101 its gauge register. No presence inference, calibration or rail writes.
// PM1/other boards require their separate presence, sensor and cell-count policy.
type M5BatteryLevelRead=int
fun M5BatteryLevelRead.status(): int = this>>>8
fun M5BatteryLevelRead.valid(): bool = this.status() == 1 && (this&255) <= 100
fun M5BatteryLevelRead.percent(): int = this&255
trusted fun M5PmicOpen.readBatteryLevelOwned(exclusive: bool): M5BatteryLevelRead {
    if (!exclusive || !this.ready()) return M5BatteryLevelRead(2<<8)
    if (this.kind() < 2 || this.kind() > 4) return M5BatteryLevelRead(3<<8)
    val handle=this.deviceHandle()
    val result=if (this.kind() == 2) axp192PowerBatteryLevel(Axp192(handle).read12(120))
        else if (this.kind() == 3) Axp2101(handle).batteryLevelChecked()
        else Ip5306(handle).batteryLevelChecked()
    return if (result.valid()) M5BatteryLevelRead((1<<8)|result.value()) else M5BatteryLevelRead(4<<8)
}
