import "./tab5_board_prepare_sequence.ab"
import "./tab5_control_bus_esp32p4.ab"
import "./tab_power.ab"
import "./tab5_reset_provider_esp32p4.ab"
trusted fun tab5BoardPrepareValid(bus: int,expanders: int,scratch: NativeBuffer): bool {
    val group=M5Expanders(expanders)
    if (!I2cBus(bus).current() || !group.valid() || !p4SoftwareProviderBufferSafe(group.buffer(),32) ||
        !p4SoftwareProviderBufferSafe(scratch,1)) return false
    val start=group.buffer().addressValue()
    val lines=p4SoftwareProviderOwner().lines()
    if (lines.sda() != 31 || lines.scl() != 32 || p4SoftwareProviderPrepare() != 1) return false
    return scratch.addressValue() < start || scratch.addressValue() >= start+32
}
trusted fun tab5BoardPrepareFresh(expanders: int): bool = M5Expanders(expanders).status() == 0 &&
    M5Expanders(expanders).slot(0).deviceHandle() == 0 && M5Expanders(expanders).slot(1).deviceHandle() == 0
trusted fun tab5BoardPrepareExpanders(bus: int,expanders: int,board: M5BoardId): int = M5Expanders(expanders).open(I2cBus(bus),board)
trusted fun tab5BoardPreparePower(expanders: int): int = M5Expanders(expanders).configureTabPower()|0
trusted fun tab5BoardPrepareReset(bus: int,scratch: NativeBuffer): int = I2cBus(bus).resetTab5DisplayTouchOwned(scratch)
trusted fun Tab5ControlBus.prepareBoardOwned(board: M5BoardId,expanders: M5Expanders,scratch: NativeBuffer): Tab5BoardPrepare =
    if (this.ready()) tab5BoardPrepareOwned(board,this.busHandle(),expanders|0,scratch) else Tab5BoardPrepare(2)
