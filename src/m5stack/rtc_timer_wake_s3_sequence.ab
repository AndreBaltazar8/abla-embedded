import "./rtc_wake_profile.ab"
import "./rtc_timer_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
// 1 ready,2 unsupported CPU/board route,3 invalid timer/cleanup/record/owner,
// 4 IRQ already low,5 native admission refused,6 native prepare failed/undone,
// 7 native cleanup needs retry. Failure does NOT disarm the running RTC timer.
// Timer result must belong to this board's actual RTC and current operation;
// the scalar is evidence, not an ownership token. Caller keeps RTC/PM1 rails
// powered, configures input sampling, owns RTCIO/pads and a fresh176-byte wake
// record, and serializes all related clients. No hidden timer reconfiguration.
trusted fun M5BoardId.prepareS3RtcTimerWakeOwned(record: NativeBuffer,timer: M5RtcTimerResult,exclusive: bool): int {
    if (this != m5BoardPaperColor && this != m5BoardPaperMono && this != m5BoardStampPLC) return 2
    if (!exclusive || !record.hasAddressRange(0,176) || (record.addressValue() & 3) != 0 ||
        !timer.success() || timer.timer().milliseconds() <= 0 ||
        timer.cleanup().required() != (if (this.rtcNeedsPmicCleanup()) 7 else 1)) return 3
    if (record.loadU32(0) != 0) return 3
    val pin=this.rtcWakeProfile().pinNumber()
    if (!m5RtcTimerWakeLineHigh(pin)) return 4
    // EXT0 low, RTC peripheral domain retained; no other wake pads touched.
    val result=m5RtcTimerWakePrepare(record,pin)
    if (result == 1) 1 else if (result == 0) 5 else if (result == 2) 6 else 7
}
