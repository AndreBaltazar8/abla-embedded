import "./detect_classic_sequence.ab"
import "./detect_classic_timed_sequence.ab"
import "./atom_signature_esp32.ab"
import "../esp32/touch/session_esp32.ab"
import "abla/unsafe/mmio"
// Classic ESP32 read-only eFuse block0 word3, package extension bit2.
trusted fun m5ClassicReadPackage(): int {
    val word=mmioLoadU32(0x3FF5A00C)
    return ((word>>9)&7)|(((word>>2)&1)<<3)
}
