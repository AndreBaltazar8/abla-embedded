import "./tab5_pwm_p4_sequence.ab"
import "../esp32/ledc_clock_esp32p4.ab"
import "../esp32/ledc_channel_esp32p4.ab"
import "../esp32/ledc_pins_esp32p4.ab"
trusted fun p4Tab5PwmClockLive(): bool = (p4LedcClockRead(32)&1) != 0 &&
    (p4LedcClockRead(156)&7) == 4 && (p4LedcClockRead(196)&0x20000000) == 0
trusted fun p4Tab5PwmPadIsGpioLow(layout: int): bool = esp32P4GpioIndividualHoldOwned(layout,22) == 0 &&
    p4LedcPinReadyLow(22) && (p4GpioRead(1456)&u32(4095)) == u32(1280)
trusted fun p4Tab5PwmPadIsRouted(layout: int): bool = esp32P4GpioIndividualHoldOwned(layout,22) == 0 &&
    p4LedcPinReadyLow(22) && (p4GpioRead(1456)&u32(4095)) == u32(1157)
