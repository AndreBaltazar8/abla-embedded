import "./tough_touch_sequence.ab"
import "../touch/controller_open.ab"
import "../esp32/i2c_esp32c5.ab"
trusted fun toughTouchBusOwnsPmic(bus: int,pmic: int): bool =
    esp32C5I2cState().deviceMatchesOwned(esp32C5I2cDevicePool(),u32(1),bus,pmic,110)
trusted fun toughTouchBusOwnsController(bus: int,touch: int): bool =
    esp32C5I2cState().deviceMatchesOwned(esp32C5I2cDevicePool(),u32(1),bus,touch,46)
