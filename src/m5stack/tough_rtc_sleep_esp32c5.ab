import "./tough_rtc_sleep_sequence.ab"
import "./tough_power_sleep_c5.ab"
import "./tough_rtc_timer_session_esp32c5.ab"
import "../hal/m5stack.ab"
import "../esp32/i2c_esp32c5.ab"
import "../esp32/i2c/devices_c5_sequence.ab"
@export("toughRtcSleepBusOwnsTouch")
trusted fun toughRtcSleepBusOwnsTouchHook(bus: int,touch: int): bool =
    esp32C5I2cState().deviceMatchesOwned(esp32C5I2cDevicePool(),u32(1),bus,touch,46)
