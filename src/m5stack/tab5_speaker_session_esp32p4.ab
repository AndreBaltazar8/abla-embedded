import "./tab5_speaker_session_sequence.ab"
import "../esp32/i2c_software_esp32p4.ab"
import "./tab5_speaker_dma_esp32p4.ab"
import "./tab5_speaker_esp32p4.ab"
import "../esp32/i2s/dma_session_esp32p4.ab"
import "../esp32/i2s/pin_session_esp32p4.ab"
trusted fun p4Tab5SessionPinsCapture(r: NativeBuffer,revision: int): int =
    esp32p4I2sPinsCaptureOwned(r,0,true,30,27,29,26,0,if (revision >= 300) 3 else 1,true)
trusted fun p4Tab5SessionPinsClose(r: NativeBuffer): int = esp32p4I2sPinsCloseOwned(r,true)
