import "./tough_display_startup_components_c5_sequence.ab"
import "./tough_display_startup_admission_c5_sequence.ab"
import "../display/spi_program_esp32c5.ab"
import "../esp32/i2c_esp32c5.ab"
trusted fun toughDisplayStartupDeviceMatches(bus: int,device: int,address: int): bool =
    esp32C5I2cState().deviceMatchesOwned(esp32C5I2cDevicePool(),u32(1),bus,device,address)
