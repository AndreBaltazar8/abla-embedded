import "./toughc5_charge_current_sequence.ab"
import "../io_expander/m5ioe1_device.ab"
@inline
trusted fun toughChargePullNone(handle: int): bool = M5Ioe1(handle).setPullMode(0,pullNone)
@inline
trusted fun toughChargeLatch(handle: int,lowCurrent: bool): bool = M5Ioe1(handle).digitalWrite(0,lowCurrent)
@inline
trusted fun toughChargePushPull(handle: int): bool = M5Ioe1(handle).setHighImpedance(0,false)
@inline
trusted fun toughChargeOutput(handle: int): bool = M5Ioe1(handle).setDirection(0,true)
trusted fun M5BoardId.setToughChargeCurrent(ioe: M5Ioe1,maxMilliamps: int): M5ChargeCurrentResult =
    this.setToughChargeCurrentOwned(ioe | 0,maxMilliamps)
