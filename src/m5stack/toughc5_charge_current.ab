import "./toughc5_charge_current_sequence.ab"
import "../io_expander/m5ioe1_device.ab"
import "../hal/m5stack.ab"
@inline
@export("toughChargePullNone")
trusted fun toughChargePullNoneHook(handle: int): bool = M5Ioe1(handle).setPullMode(0,pullNone)
@inline
@export("toughChargeLatch")
trusted fun toughChargeLatchHook(handle: int,lowCurrent: bool): bool = M5Ioe1(handle).digitalWrite(0,lowCurrent)
@inline
@export("toughChargePushPull")
trusted fun toughChargePushPullHook(handle: int): bool = M5Ioe1(handle).setHighImpedance(0,false)
@inline
@export("toughChargeOutput")
trusted fun toughChargeOutputHook(handle: int): bool = M5Ioe1(handle).setDirection(0,true)
trusted fun M5BoardId.setToughChargeCurrent(ioe: M5Ioe1,maxMilliamps: int): M5ChargeCurrentResult =
    this.setToughChargeCurrentOwned(ioe | 0,maxMilliamps)
