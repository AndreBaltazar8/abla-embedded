import "./i2c_pin_map.ab"
import "./touch_profile.ab"
import "./rtc_profile.ab"
// Static configuration only; constructors never probe, allocate or initialize.
// Existing peripheral owners retain all hardware startup/cleanup requirements.
// ToughC5 buzzer is PM1-controlled, not an I2S speaker. Use the existing
// boardId().configureToughBuzzer adapter with a separately acquired PM1 owner.
type M5ToughC5 = int
fun m5ToughC5(): M5ToughC5 = M5ToughC5(33)
fun M5ToughC5.boardId(): M5BoardId = m5BoardToughC5
fun M5ToughC5.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5ToughC5.touchProfile(): M5TouchProfile = this.boardId().touchProfile()
fun M5ToughC5.rtcKind(): M5RtcKind = this.boardId().rtcKind()
