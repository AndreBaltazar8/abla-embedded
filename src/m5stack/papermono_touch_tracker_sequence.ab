import "./papermono_touch_sequence.ab"
import "./papermono_touch_logic.ab"
import "../input/touch_frame.ab"
// Shared tracker semantics, PaperMono-specific affine/rotation mapping.
// Scratch29B snapshot/40B frame and184B tracker must be disjoint. Reports
// failing acquisition/validation preserve tracker state, never imply release.
// Result count (includesrelease detail),-1admission,-2IO,-3unstable,-4frame.
trusted fun TouchTracker.updatePaperMonoOwned(control: int,touch: TouchControllerOpen,snapshot: NativeBuffer,
    frame: NativeBuffer,nowMilliseconds: int,rotation: int,exclusive: bool): int {
    if (!exclusive || !touch.ready() || touch.kind() != 1 || this <= 0 || this > 4294967296-touchTrackerBytes ||
        rotation < 0 || rotation > 7 || !snapshot.hasAddressRange(0,29) || !frame.hasAddressRange(0,40)) return -1
    val a=snapshot.addressValue();val b=frame.addressValue()
    if ((a < b+40 && b < a+29) || (a < this+touchTrackerBytes && this < a+29) ||
        (b < this+touchTrackerBytes && this < b+40) ||
        !paperMonoTouchReadAdmission(control,touch.handle(),snapshot) ||
        !paperMonoTouchTrackerStorageAdmission(control,this,frame)) return -1
    if (touchElapsedMilliseconds(nowMilliseconds,this.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) {
        this.startUpdate(nowMilliseconds)
        return this.getCount()
    }
    val count=paperMonoTouchReadOwned(control,touch,snapshot,true)
    if (count < 0) return if (count == -1) -2 else if (count == -2) -3 else if (count == -3) -1 else -4
    if (count > touchMaximumPoints) return -4
    var index=0
    while (index < count) {
        val point=ft5x06SnapshotPoint(snapshot,count,index).forPaperMonoDisplay(rotation)
        if (!point.valid()) return -4
        var byte=0
        while (byte < 8) { frame.store(index*8+byte,(point >>> (byte*8))&255);byte=byte+1 }
        index=index+1
    }
    val result=this.updateControllerFrame(frame,count,nowMilliseconds)
    return if (result < 0) -4 else result
}
