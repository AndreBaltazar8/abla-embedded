import "./tough_power_owner_view.ab"
import "../touch/controller_open_sequence.ab"
import "../touch/chsc6540_sequence.ab"
// Cache-on operations. Borrow the configured HP bus and live power owner.
// Opening sends the controller initialization command: consume wanted touch
// events first. The returned controller is independently owned; retain failed
// cleanup handles and close before releasing the bus/power owner.
trusted fun toughTouchPowerAdmitted(owner: M5ToughPowerOwner,bus: int,exclusive: bool): bool =
    exclusive && owner.status() == 1 && owner.bootResult().powerReady() &&
    owner.pmic().ready() && owner.pmic().kind() == 5 &&
    toughTouchBusOwnsPmic(bus,owner.pmic().deviceHandle())
trusted fun M5ToughPowerOwner.openTouchOwned(bus: int,exclusive: bool,eventsConsumed: bool): TouchControllerOpen {
    if (!eventsConsumed || !toughTouchPowerAdmitted(this,bus,exclusive)) return TouchControllerOpen(0)
    return touchControllerOpenOwned(bus,3,46,400000)
}
// Returns 0..2 contacts, -1 unavailable/read failure, -3 malformed report.
// Negative is NOT a released touch. Raw CHSC coordinates; no guessed IRQ pad.
trusted fun M5ToughPowerOwner.readTouchOwned(bus: int,touch: TouchControllerOpen,snapshot: NativeBuffer,previous: NativeBuffer,exclusive: bool): int {
    if (!touch.ready() || touch.kind() != 3 || !snapshot.hasAddressRange(0,11) ||
        !previous.hasAddressRange(0,11)) return -1
    val a=snapshot.addressValue();val b=previous.addressValue();val parent=this.buffer().addressValue()
    if ((a < b+11 && b < a+11) || (a < parent+96 && parent < a+11) ||
        (b < parent+96 && parent < b+11) || !toughTouchPowerAdmitted(this,bus,exclusive) ||
        !toughTouchBusOwnsController(bus,touch.handle())) return -1
    return chsc6540ReadStableOwned(touch.handle(),snapshot,previous)
}
