import "./board_id.ab"
import "../esp32/gpio.ab"

// A button source is one scalar: kind, pin/bit index, I2C address/register,
// mask, and polarity. GPIO-backed board methods still return the lowest-level
// Pin directly; this value describes non-GPIO sources without pretending they
// are pins or allocating a polymorphic button object.
type M5ButtonSource = int

val m5ButtonSourceNone = 0
val m5ButtonSourceGpio = 1
val m5ButtonSourceTouch = 2
val m5ButtonSourcePi4Ioe5v6408 = 3
val m5ButtonSourcePowerHub = 4
val m5ButtonSourceM5Pm1 = 5
val m5ButtonSourcePmicKey = 6

fun m5ButtonSource(
    kind: int,
    index: int = 0,
    address: int = 0,
    register: int = 0,
    mask: int = 0,
    activeLow: bool = true
): M5ButtonSource = M5ButtonSource(
    (kind & 255) | ((index & 255) << 8) |
        ((address & 255) << 16) | ((register & 255) << 24) |
        ((mask & 255) << 32) | (if (activeLow) 1 << 40 else 0)
)

fun m5GpioButtonSource(number: int): M5ButtonSource =
    if (number < 0) m5ButtonSource(m5ButtonSourceNone)
    else m5ButtonSource(m5ButtonSourceGpio, number)

fun m5TouchButtonSource(index: int): M5ButtonSource =
    m5ButtonSource(m5ButtonSourceTouch, index, 0, 0, 1 << index, false)

fun m5Pi4ButtonSource(bit: int): M5ButtonSource =
    m5ButtonSource(m5ButtonSourcePi4Ioe5v6408, bit, 67, 15, 1 << bit)

fun m5PowerHubButtonSource(bit: int): M5ButtonSource =
    m5ButtonSource(m5ButtonSourcePowerHub, bit, 80, 160, 1 << bit)

fun m5Pm1ButtonSource(gpio: int): M5ButtonSource =
    m5ButtonSource(m5ButtonSourceM5Pm1, gpio, 110, 18, 1 << gpio)

fun m5PmicKeyButtonSource(): M5ButtonSource =
    m5ButtonSource(m5ButtonSourcePmicKey)

fun M5ButtonSource.kind(): int = this & 255
fun M5ButtonSource.index(): int = (this >>> 8) & 255
fun M5ButtonSource.address(): int = (this >>> 16) & 255
fun M5ButtonSource.register(): int = (this >>> 24) & 255
fun M5ButtonSource.mask(): int = (this >>> 32) & 255
fun M5ButtonSource.activeLow(): bool = (this & (1 << 40)) != 0
fun M5ButtonSource.valid(): bool = this.kind() != m5ButtonSourceNone
fun M5ButtonSource.isGpio(): bool = this.kind() == m5ButtonSourceGpio
fun M5ButtonSource.pin(): Pin =
    pin(if (this.isGpio()) this.index() else -1)

// Five signed byte pins in one scalar: A, B, C, EXT, and PWR. A missing or
// non-GPIO source is encoded as 0xff and decodes to Pin(-1).
type M5ButtonPinMap = int

fun m5ButtonPinValue(number: int): int = number & 255
fun m5ButtonPin(value: int): Pin = pin(if ((value & 255) == 255) -1 else value & 255)

fun m5ButtonPinMap(
    a: int = -1,
    b: int = -1,
    c: int = -1,
    ext: int = -1,
    power: int = -1
): M5ButtonPinMap = M5ButtonPinMap(
    m5ButtonPinValue(a) | (m5ButtonPinValue(b) << 8) |
        (m5ButtonPinValue(c) << 16) | (m5ButtonPinValue(ext) << 24) |
        (m5ButtonPinValue(power) << 32)
)

fun M5ButtonPinMap.buttonA(): Pin = m5ButtonPin(this)
fun M5ButtonPinMap.buttonB(): Pin = m5ButtonPin(this >>> 8)
fun M5ButtonPinMap.buttonC(): Pin = m5ButtonPin(this >>> 16)
fun M5ButtonPinMap.buttonExt(): Pin = m5ButtonPin(this >>> 24)
fun M5ButtonPinMap.buttonPower(): Pin = m5ButtonPin(this >>> 32)

fun M5BoardId.buttonPins(): M5ButtonPinMap {
    val board = this.pinMapIdentity()
    if (board == m5BoardStack) return m5ButtonPinMap(39, 38, 37)
    if (board == m5BoardStackCoreInk) {
        return m5ButtonPinMap(37, 38, 39, 5, 27)
    }
    if (board == m5BoardPaper || board == m5BoardStation) {
        return m5ButtonPinMap(37, 38, 39)
    }
    if (board == m5BoardAtomLite || board == m5BoardAtomMatrix ||
        board == m5BoardAtomVoice || board == m5BoardAtomPsram ||
        board == m5BoardAtomU || board == m5BoardStampPico) {
        return m5ButtonPinMap(39)
    }
    if (board == m5BoardStickC || board == m5BoardStickCPlus) {
        return m5ButtonPinMap(37, 39)
    }
    if (board == m5BoardStickCPlus2) return m5ButtonPinMap(37, 39, -1, -1, 35)

    if (board == m5BoardAirQ) return m5ButtonPinMap(0, 8)
    if (board == m5BoardVAMeter) return m5ButtonPinMap(2, 0)
    if (board == m5BoardStampS3 || board == m5BoardCardputer ||
        board == m5BoardCardputerADV) return m5ButtonPinMap(0)
    if (board == m5BoardAtomS3 || board == m5BoardAtomS3Lite ||
        board == m5BoardAtomS3U || board == m5BoardAtomS3R ||
        board == m5BoardAtomVoiceS3R) return m5ButtonPinMap(41)
    if (board == m5BoardCapsule || board == m5BoardDial ||
        board == m5BoardDinMeter) return m5ButtonPinMap(42, 0)
    if (board == m5BoardPowerHub) return m5ButtonPinMap(11)
    if (board == m5BoardDualKey) return m5ButtonPinMap(17, 0)
    if (board == m5BoardStickS3) return m5ButtonPinMap(11, 12)
    if (board == m5BoardPaperDIY) return m5ButtonPinMap(4, 3)
    if (board == m5BoardPaperColor) return m5ButtonPinMap(10, 9, 1)
    if (board == m5BoardChainCaptain) return m5ButtonPinMap(1, 4, 5)
    if (board == m5BoardPaperMono) return m5ButtonPinMap(2, 3)
    if (board == m5BoardStopWatch) return m5ButtonPinMap(2, 1)

    if (board == m5BoardStampC3) return m5ButtonPinMap(3)
    if (board == m5BoardStampC3U) return m5ButtonPinMap(9)
    if (board == m5BoardNanoC6 || board == m5BoardNanoH2) {
        return m5ButtonPinMap(9)
    }
    if (board == m5BoardUnitPoEP4) return m5ButtonPinMap(45)
    m5ButtonPinMap()
}

fun M5BoardId.hasTouchButtons(): bool {
    val board = this.pinMapIdentity()
    board == m5BoardStackCore2 || board == m5BoardTough ||
        board == m5BoardToughC5 || board == m5BoardStackCoreS3 ||
        board == m5BoardStackCoreS3SE || board == m5BoardStackChan ||
        board == m5BoardPaper || board == m5BoardPaperS3 ||
        board == m5BoardTab5
}

fun M5BoardId.hasPmicPowerButton(): bool {
    val board = this.pinMapIdentity()
    board == m5BoardStackCore2 || board == m5BoardTough ||
        board == m5BoardStation || board == m5BoardStickC ||
        board == m5BoardStickCPlus || board == m5BoardStackCoreS3 ||
        board == m5BoardStackCoreS3SE || board == m5BoardStackChan ||
        board == m5BoardStickS3 || board == m5BoardStopWatch ||
        board == m5BoardStampS3Bat || board == m5BoardPaperDIY ||
        board == m5BoardPaperColor || board == m5BoardChainCaptain ||
        board == m5BoardPaperMono || board == m5BoardCoreMatrix ||
        board == m5BoardToughC5 || board == m5BoardCoreP4X
}

fun M5BoardId.buttonASource(): M5ButtonSource {
    val gpio = this.buttonPins().buttonA().number()
    if (gpio >= 0) return m5GpioButtonSource(gpio)
    val board = this.pinMapIdentity()
    if (board == m5BoardStampPLC) return m5Pi4ButtonSource(2)
    if (board == m5BoardUnitC6L || board == m5BoardArduinoNessoN1) {
        return m5Pi4ButtonSource(0)
    }
    if (board == m5BoardCoreMatrix) return m5Pm1ButtonSource(0)
    if (this.hasTouchButtons()) return m5TouchButtonSource(0)
    m5ButtonSource(m5ButtonSourceNone)
}

fun M5BoardId.buttonBSource(): M5ButtonSource {
    val gpio = this.buttonPins().buttonB().number()
    if (gpio >= 0) return m5GpioButtonSource(gpio)
    val board = this.pinMapIdentity()
    if (board == m5BoardStampPLC || board == m5BoardArduinoNessoN1) {
        return m5Pi4ButtonSource(1)
    }
    if (board == m5BoardPowerHub) return m5PowerHubButtonSource(0)
    if (board == m5BoardCoreMatrix) return m5Pm1ButtonSource(1)
    if (this.hasTouchButtons()) return m5TouchButtonSource(1)
    m5ButtonSource(m5ButtonSourceNone)
}

fun M5BoardId.buttonCSource(): M5ButtonSource {
    val gpio = this.buttonPins().buttonC().number()
    if (gpio >= 0) return m5GpioButtonSource(gpio)
    val board = this.pinMapIdentity()
    if (board == m5BoardStampPLC) return m5Pi4ButtonSource(0)
    if (board == m5BoardCoreMatrix) return m5Pm1ButtonSource(2)
    if (this.hasTouchButtons()) return m5TouchButtonSource(2)
    m5ButtonSource(m5ButtonSourceNone)
}

fun M5BoardId.buttonExtSource(): M5ButtonSource =
    m5GpioButtonSource(this.buttonPins().buttonExt().number())

fun M5BoardId.buttonPowerSource(): M5ButtonSource {
    val gpio = this.buttonPins().buttonPower().number()
    if (gpio >= 0) return m5GpioButtonSource(gpio)
    if (this.hasPmicPowerButton()) return m5PmicKeyButtonSource()
    m5ButtonSource(m5ButtonSourceNone)
}

// Lowest-level board accessors. Non-GPIO button sources return Pin(-1) and
// remain discoverable through the corresponding ...Source method.
fun M5BoardId.buttonA(): Pin = this.buttonASource().pin()
fun M5BoardId.buttonB(): Pin = this.buttonBSource().pin()
fun M5BoardId.buttonC(): Pin = this.buttonCSource().pin()
fun M5BoardId.buttonExt(): Pin = this.buttonExtSource().pin()
fun M5BoardId.buttonPower(): Pin = this.buttonPowerSource().pin()
