import "./tab5_owned_video_sequence.ab"
import "../service_gate.ab"
trusted fun Tab5DsiOwner.videoIrqRecordsSafe(mailbox: NativeBuffer,table: NativeBuffer,irqLease: NativeBuffer,gate: int): bool {
    if (!this.valid() || gate <= 0 || gate > 4294967292 || (gate&3) != 0 ||
        !this.videoBufferSafe(mailbox,28) || (mailbox.addressValue()&3) != 0 ||
        !this.videoBufferSafe(table,272) || (table.addressValue()&3) != 0 ||
        !this.videoBufferSafe(irqLease,4) || (irqLease.addressValue()&3) != 0 ||
        !this.videoBufferSafe(nativeBufferAt(gate,4),4)) return false
    val m=mailbox.addressValue(); val t=table.addressValue(); val l=irqLease.addressValue()
    return !((m < t+272 && t < m+28) || (m < l+4 && l < m+28) ||
        (m < gate+4 && gate < m+28) || (t < l+4 && l < t+272) ||
        (t < gate+4 && gate < t+272) || (l < gate+4 && gate < l+4))
}
// Aggregate teardown: close worker admission/join -> mask+detach IRQ -> stop
// video/DMA. Never access gated bridge registers through a remaining handler.
// irqLease is the authoritative4B open/close report, updated after every attempt.
// Caller owns all lifetimes, excludes parallel teardown/owner mutation, pins
// owning core and holds cache serialization for hardware stop. Descriptor/frame
// must also be disjoint from ALL records below and retained until successful stop.
// Returns normal video shutdown report; low8=10worker not joined (detail at8),
// 14IRQ cleanup blocked (full remaining lease at16),2invalid. Gate stays closed.
trusted fun Tab5DsiOwner.stopVideoAndIrqOwned(mailbox: NativeBuffer,table: NativeBuffer,irqLease: NativeBuffer,gate: int,polls: int): int {
    if (!this.videoIrqRecordsSafe(mailbox,table,irqLease,gate) ||
        this.buffer().loadU32(4) < 7 || this.buffer().loadU32(4) > 9 || polls < 1 || polls > 1000000) return 2
    val lease=irqLease.loadU32(0)
    if (lease > 4095) return 2
    val joined=serviceGateAt(gate).requestStop(polls)
    if (joined != 1) return 10|(joined<<8)
    if ((lease&3840) != 0) {
        // No admitted worker remains. Same-core MIEoff joins the nonnested ISR;
        // do not retain this mask across cache waits or hardware shutdown.
        val saved=tab5OwnedShutdownMask()
        val remaining=tab5OwnedShutdownIrq(mailbox,table,lease)
        irqLease.storeU32(0,remaining)
        tab5OwnedShutdownRestore(saved)
        if (remaining != 1) return 14|(remaining<<16)
    }
    return this.stopVideoOwned(gate,polls)
}
