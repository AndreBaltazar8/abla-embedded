import "./inputs_sequence.ab"
import "./button_poll.ab"
import "./button_touch_frame.ab"
import "./power_button.ab"
// Borrow already-configured, board-matching handles. Caller serializes polling
// and touch-frame acquisition. No bus recovery, pin reconfiguration or IRQ
// consumption for boards whose power button is not a PMIC event source.
trusted fun M5Inputs.poll(board: M5BoardId,pi4: Pi4Ioe5v6408,pmic: M5PmicOpen,powerHub: I2cDevice,
    touch: M5TouchButtons,now: int): bool {
    if (!this.valid()) return false
    val pm1=M5Pm1(if (pmic.ready() && pmic.kind() == 5) pmic.deviceHandle() else 0)
    val frame=board.pollButtonLevels(pi4,pm1,powerHub).withTouch(touch)
    this.updateOwned(frame,pmic,board.buttonPowerSource().kind() == m5ButtonSourcePmicKey,now)
}
