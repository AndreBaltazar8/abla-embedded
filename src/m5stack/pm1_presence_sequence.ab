import "./board_id.ab"
import "../power/pm1_battery_presence.ab"
// Borrowed PM1 and IOE handles. Neither probing nor changing power rails.
trusted fun Pm1BatteryPresence.updateBoardOwned(board: M5BoardId,pm1: int,ioe: int,now: int): int {
    if (!this.valid() || (board != m5BoardToughC5 && board != m5BoardCoreMatrix) ||
        pm1 <= 0 || pm1 > 4294967295 || ioe <= 0 || ioe > 4294967295) return -1
    val enabled=pm1PresenceReadEnabled(pm1)
    if (enabled.valid() && enabled.value() == 0) {
        return this.observe(enabled,I2cByteResult(0),false,pm1PresenceReadVoltage(pm1),now)
    }
    val pin=pm1PresenceReadChargeStat(ioe,if (board == m5BoardToughC5) 2 else 7)
    var down=false
    if (pin.valid() && pin.value() == 0 && board == m5BoardToughC5) {
        val source=pm1PresenceReadSource(pm1)
        down=source.valid() && (source.value() & 4) == 0
    }
    // Live charging bypasses voltage heuristics, including an empty/low ADC.
    if (pin.valid() && pin.value() == 0 && !down) {
        return this.observe(enabled,pin,down,I2cWordResult(0),now)
    }
    this.observe(enabled,pin,down,pm1PresenceReadVoltage(pm1),now)
}
