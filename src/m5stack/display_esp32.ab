import "./display_map.ab"
import "../display/st7789_esp32.ab"
import "../display/st7735_esp32.ab"
import "../display/ili9342_esp32.ab"

trusted fun M5BoardId.openDisplayBus(): SpiBus {
    val pins = this.displaySpiPins()
    if (!pins.available() || this.displaySpiHost() < 1) return SpiBus(0)
    spiMaster(
        this.displaySpiHost(),
        spiPins(pins.mosi(), pins.miso(), pins.clock())
    )
}

trusted fun M5BoardId.openSpiDisplay(bus: SpiBus): SpiLcd {
    val pins = this.displaySpiPins()
    if (!bus.valid() || !pins.available()) {
        return spiLcd(SpiDevice(0), -1)
    }
    bus.lcd(
        pins.chipSelect(), pins.dataCommand(), pins.reset(),
        pins.backlight(), this.displayFrequency()
    )
}

trusted fun M5BoardId.beginDisplay(display: SpiLcd): LcdView {
    if (this.displayController() == m5DisplayControllerSt7735S) {
        return display.beginSt7735S(
            this.displayGeometry(), this.displayRotation(),
            this.displayInverted()
        )
    }
    if (this.displayController() == m5DisplayControllerSt7789) {
        return display.beginSt7789(
            this.displayGeometry(), this.displayRotation(),
            this.displayInverted()
        )
    }
    if (this.displayController() == m5DisplayControllerIli9342) {
        var inverted = this.displayInverted()
        // Original M5Stack routes its panel variant strap through LCD reset.
        // Reproduce M5GFX's output-low/input-pulldown/read/output sequence.
        if (this.pinMapIdentity() == m5BoardStack &&
            display.resetPin().number() >= 0) {
            val reset = display.resetPin()
            reset.output()
            reset.write(false)
            reset.input()
            reset.pullDown()
            reset.write(true)
            inverted = reset.read()
            reset.output()
        }
        return display.beginIli9342(
            this.displayGeometry(), this.displayRotation(), inverted
        )
    }
    LcdView(0)
}
