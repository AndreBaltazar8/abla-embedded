import "./expander_owner.ab"
import "./expander_power.ab"
import "./tab_charge.ab"
import "./output_readback.ab"
import "./expander_controls_sequence.ab"
trusted fun M5Expanders.setExternalOutput(ports: int,enabled: bool): M5ExpanderPowerResult = this.setExternalOutputOwned(ports,enabled)
trusted fun M5Expanders.setChargeCurrent(milliamps: int): M5TabChargeResult = this.setChargeCurrentOwned(milliamps)
trusted fun M5Expanders.setBatteryCharge(enabled: bool): M5TabChargeResult = this.setBatteryChargeOwned(enabled)
trusted fun M5Expanders.externalOutputChecked(power: I2cDevice = I2cDevice(0)): I2cByteResult = this.externalOutputCheckedOwned(power | 0)
trusted fun M5Expanders.usbOutputChecked(): I2cByteResult = this.usbOutputCheckedOwned()
