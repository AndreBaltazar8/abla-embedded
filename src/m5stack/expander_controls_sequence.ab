import "./expander_owner_sequence.ab"
import "./expander_power_sequence.ab"
import "./tab_charge_sequence.ab"
import "./output_readback_sequence.ab"
// The owner remembers the board and selects its expander index. Failed or
// partially opened groups never reach any control/read hook.
trusted fun M5Expanders.setExternalOutputOwned(ports: int,enabled: bool): M5ExpanderPowerResult {
    if (!this.ready()) return M5ExpanderPowerResult(3)
    this.board().setExpanderPowerOwned(this.slot(0).deviceHandle(),this.slot(1).deviceHandle(),ports,enabled)
}
trusted fun M5Expanders.setChargeCurrentOwned(milliamps: int): M5TabChargeResult {
    if (!this.ready()) return M5TabChargeResult(3)
    this.board().setTabChargeCurrentOwned(this.slot(1).deviceHandle(),milliamps)
}
trusted fun M5Expanders.setBatteryChargeOwned(enabled: bool): M5TabChargeResult {
    if (!this.ready()) return M5TabChargeResult(3)
    this.board().setTabBatteryChargeOwned(this.slot(1).deviceHandle(),enabled)
}
trusted fun M5Expanders.externalOutputCheckedOwned(power: int = 0): I2cByteResult {
    if (!this.ready()) return I2cByteResult(0)
    val index=if (this.board() == m5BoardArduinoNessoN1) 1 else 0
    this.board().externalOutputCheckedOwned(power,this.slot(index).deviceHandle())
}
trusted fun M5Expanders.usbOutputCheckedOwned(): I2cByteResult {
    if (!this.ready()) return I2cByteResult(0)
    val index=if (this.board() == m5BoardTab5 || this.board() == m5BoardTab5X) 1 else 0
    this.board().usbOutputCheckedOwned(this.slot(index).deviceHandle())
}
