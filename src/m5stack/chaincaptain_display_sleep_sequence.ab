import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
// Powered, initialized display only; this does not enter CPU sleep or remove
// rails. Caller serializes the complete lifecycle and keeps SPI/IOE clocks and
// pads owned. Never draw between SLPIN and successful SLPOUT completion.
// Brightness is explicit: no hidden heap-backed display object/state cache.
// Status1 complete,2 admission,3 blank,4 panel,5 restore brightness.
// Panel result occupies48bits@8; bit56 reports failed emergency blanking.
// Any failure retains ownership and possibly partial hardware effects.
type ChainCaptainDisplaySleep=int
fun ChainCaptainDisplaySleep.status(): int = this&255
fun ChainCaptainDisplaySleep.valid(): bool = this.status() == 1
fun ChainCaptainDisplaySleep.detail(): int = (this>>>8)&281474976710655
fun ChainCaptainDisplaySleep.backlightOffFailed(): bool = (this&(1<<56)) != 0
trusted fun chainCaptainDisplaySleepOwned(control: int,gate: PeripheralGate,owner: u32,
    sleeping: bool,brightness: int,exclusive: bool): ChainCaptainDisplaySleep {
    if (!exclusive || brightness < 0 || brightness > 255 || !peripheralOwnerValid(owner) ||
        !chainDisplayAdmission(control,gate)) return ChainCaptainDisplaySleep(2)
    // Blank first in both directions. A failed wake must not expose an unsettled
    // panel; a failed blank must not be followed by additional panel mutations.
    if (!chainDisplayBlank(control)) {
        val failed=!chainDisplayBlank(control)
        return ChainCaptainDisplaySleep(3|(if (failed) 1<<56 else 0))
    }
    val panel=chainDisplaySleepPanel(gate,owner,sleeping)
    if (!panel.valid()) return ChainCaptainDisplaySleep(4|((panel&281474976710655)<<8))
    if (!sleeping && !chainDisplayBrightness(control,brightness)) {
        val failed=!chainDisplayBlank(control)
        return ChainCaptainDisplaySleep(5|(if (failed) 1<<56 else 0))
    }
    return ChainCaptainDisplaySleep(1)
}
