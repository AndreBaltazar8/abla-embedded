import "./pm1_control_esp32s3.ab"
import "./rtc_open.ab"
import "./pm1_rtc_open_sequence.ab"
import "../hal/m5stack.ab"
import "../hal/m5stack_3.ab"
@export("pm1BoardRtcAdmission")
trusted fun pm1BoardRtcAdmissionHook(control: int): bool {
    val c=M5Pm1Control(control)
    return c.ready() && (c.board() == m5BoardStopWatch || c.board() == m5BoardPaperMono || c.board() == m5BoardChainCaptain)
}
@export("pm1BoardRtcBus")
trusted fun pm1BoardRtcBusHook(control: int): int = M5Pm1Control(control).bus()
@export("pm1BoardRtcBoard")
trusted fun pm1BoardRtcBoardHook(control: int): M5BoardId = M5Pm1Control(control).board()
trusted fun M5Pm1Control.openRtcOwned(exclusive: bool,wakeEventsConsumed: bool): M5RtcOpenResult =
    pm1BoardRtcOpenOwned(this|0,exclusive,wakeEventsConsumed)
