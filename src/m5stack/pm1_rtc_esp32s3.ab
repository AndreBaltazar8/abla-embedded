import "./pm1_control_esp32s3.ab"
import "./rtc_open.ab"
import "./pm1_rtc_open_sequence.ab"
trusted fun pm1BoardRtcAdmission(control: int): bool {
    val c=M5Pm1Control(control)
    return c.ready() && (c.board() == m5BoardStopWatch || c.board() == m5BoardPaperMono || c.board() == m5BoardChainCaptain)
}
trusted fun pm1BoardRtcBus(control: int): int = M5Pm1Control(control).bus()
trusted fun pm1BoardRtcBoard(control: int): M5BoardId = M5Pm1Control(control).board()
trusted fun M5Pm1Control.openRtcOwned(exclusive: bool,wakeEventsConsumed: bool): M5RtcOpenResult =
    pm1BoardRtcOpenOwned(this|0,exclusive,wakeEventsConsumed)
