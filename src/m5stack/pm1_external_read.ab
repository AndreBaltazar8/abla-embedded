import "./pm1_external_read_sequence.ab"
import "../power/m5pm1_device.ab"
import "../io_expander/m5ioe1_device.ab"
@inline
trusted fun pm1ExternalReadRail(handle: int): I2cByteResult = M5Pm1(handle).extOutputChecked()
@inline
trusted fun pm1ExternalReadLatch(handle: int): I2cByteResult = M5Pm1(handle).gpioOutputLatchBitsChecked()
@inline
trusted fun pm1ExternalReadBoost(handle: int): I2cByteResult = M5Ioe1(handle).getWriteValueChecked(3)
trusted fun M5BoardId.pm1ExternalPortsChecked(pm1: M5Pm1,ioe: M5Ioe1): I2cByteResult =
    this.pm1ExternalPortsCheckedOwned(pm1 | 0,ioe | 0)
