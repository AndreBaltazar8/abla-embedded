import "./tough_c5_profile.ab"
import "./pin_map_shared.ab"
// Maps only, with platform-selected Pin. No pad/clock/bus ownership is implied.
// Shared connector/peripheral pins must be serialized by their actual owners.
fun M5ToughC5.portA(): M5PortPins = this.boardId().portA()
fun M5ToughC5.portB(): M5PortPins = this.boardId().portB()
fun M5ToughC5.portC(): M5PortPins = this.boardId().portC()
fun M5ToughC5.sdPins(): M5SdPinMap = this.boardId().sdPins()
fun M5ToughC5.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5ToughC5.internalI2cData(): Pin = pin(this.i2cPins().internalData())
fun M5ToughC5.externalI2cClock(): Pin = pin(this.i2cPins().externalClock())
fun M5ToughC5.externalI2cData(): Pin = pin(this.i2cPins().externalData())
