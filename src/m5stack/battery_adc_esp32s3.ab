import "./power_profile.ab"
import "../esp32/adc1_session_esp32s3.ab"
// M5Unified Power_Class.cpp S3 battery paths: PaperS3 GPIO3, Capsule GPIO6,
// DinMeter/Cardputer/CardputerADV GPIO10, all ADC1 and 2:1 battery dividers.
// AirQ uses ADC2 GPIO14: import battery_adc2_esp32s3.ab for its owned path.
// Never substitute an ADC1 pin with the same channel.
fun M5BoardId.batteryAdc1ChannelS3(): int =
    if (this == m5BoardPaperS3) 2 else if (this == m5BoardCapsule) 5 else
    if (this == m5BoardDinMeter || this == m5BoardCardputer || this == m5BoardCardputerADV) 9 else -1
// Caller powers the board/divider and satisfies all ADC1 session contracts.
// No charging/hold/rail/output toggles or nominal calibration fallback.
trusted fun M5BoardId.openBatteryAdcS3Owned(calibration: Esp32S3AdcCalibration,exclusivePower: bool,exclusiveBus: bool,polls: int): Esp32S3Adc1Session {
    if (this.batteryAdc1ChannelS3() < 0 || !calibration.valid() || calibration.unit() != 1 || calibration.attenuation() != 3) return Esp32S3Adc1Session(2)
    return esp32S3Adc1SessionOpenOwned(this.batteryAdc1ChannelS3(),calibration,exclusivePower,exclusiveBus,polls)
}
fun Esp32S3Adc1Session.batteryMillivoltsS3(board: M5BoardId,calibration: Esp32S3AdcCalibration): int {
    if (board.batteryAdc1ChannelS3() < 0 || this.channel() != board.batteryAdc1ChannelS3() || this.attenuation() != 3) return -1
    val mv=this.millivolts(calibration)
    return if (mv < 0) -1 else board.batteryMillivoltsFromAdc(mv)
}
