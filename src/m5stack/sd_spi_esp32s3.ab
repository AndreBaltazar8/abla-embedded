import "../sd/master_owner_esp32s3.ab"
import "./sd_spi_s3_profile.ab"
// Caller prepared board-specific rails, observed settling and released pads
// from RTC/holds/other peripherals. No board-wide power/reset is hidden here.
trusted fun M5BoardId.openSdSpiOwned(storage: S3SdMasterOwner,peripheral: int,gate: PeripheralGate,
    owner: u32,scratch: NativeBuffer,response: NativeBuffer,polls: int,poweredExclusive: bool): int =
    storage.openOwned(this.sdSpiS3Link(peripheral),gate,owner,scratch,response,polls,poweredExclusive)
