import "./pm1_control_esp32s3.ab"
import "./imu_owner_prepared.ab"
import "./pm1_imu_open_sequence.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
// Fresh initialized36B owner, disjoint from boardcontrol and I2C bookkeeping.
// Full bus generation key retained; owner closes only devices, never this bus.
trusted fun pm1BoardImuAdmission(control: int,imu: M5ImuOwner): bool {
    val c=M5Pm1Control(control)
    if (!c.ready() || (c.board() != m5BoardStopWatch && c.board() != m5BoardPaperMono && c.board() != m5BoardChainCaptain)) return false
    val storage=imu.buffer()
    if (!esp32S3I2cFacadeBufferSafe(storage,36,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) ||
        (storage.addressValue() < c.buffer().addressValue()+72 && c.buffer().addressValue() < storage.addressValue()+36)) return false
    return imu.status() == 0 && imu.primary().handle() == 0 && imu.magnetometers().status() == 0 &&
        imu.magnetometers().handle(1) == 0 && imu.magnetometers().handle(2) == 0
}
trusted fun pm1BoardImuBus(control: int): int = M5Pm1Control(control).bus()
trusted fun pm1BoardImuProbe(imu: M5ImuOwner,bus: int): int = imu.openPrepared(I2cBus(bus))
trusted fun M5Pm1Control.openImuPreparedOwned(imu: M5ImuOwner,exclusive: bool): int =
    pm1BoardImuOpenPreparedOwned(this|0,imu,exclusive)
