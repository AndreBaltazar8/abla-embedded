import "./pmic_types.ab"
// 1 cutoff/auto-off request acknowledged,2 wake supply retained,
// 3 owner not ready,4 unsupported PMIC,5 I2C failure. Not physical power proof.
type M5PmicShutdownResult=int
fun M5PmicShutdownResult.status(): int = this | 0
fun M5PmicShutdownResult.requestAcknowledged(): bool = this == 1
fun M5PmicShutdownResult.wakeSupplyRetained(): bool = this == 2
// Explicit supply policy from the board's wake owner. A timed RTC/PM1 wake
// requiring the live rail must select preserveForWake; no wake pin is guessed.
// Caller already quiesced consumers. Ownership stays live after this request;
// do not close/reconfigure the bus until its shutdown/wake operation finishes.
trusted fun M5PmicOpen.preparePowerOffOwned(preserveForWake: bool): M5PmicShutdownResult {
    if (!this.ready()) return M5PmicShutdownResult(3)
    val kind=this.kind()
    if (kind < 2 || kind > 5) return M5PmicShutdownResult(4)
    if (preserveForWake && kind != 4) return M5PmicShutdownResult(2)
    if (!m5PmicShutdownWrite(this.deviceHandle(),kind,preserveForWake)) return M5PmicShutdownResult(5)
    M5PmicShutdownResult(if (preserveForWake) 2 else 1)
}
