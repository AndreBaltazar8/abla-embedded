import "./atom_s3r_display_session_sequence.ab"
import "../display/color.ab"
// Caller serializes the session record; configuration is bound at successful
// begin, never supplied afresh per draw. No drawing on fault/blanked sessions.
trusted fun atomS3RDisplayDrawReady(r: NativeBuffer): bool = atomS3RDisplayRecordRange(r) &&
    r.loadU32(0) == 0x41534433 && r.loadU32(4) == 2 && AtomS3Panel(r.loadU32(8)).valid() &&
    (r.loadU32(8)&255) == 18 && r.loadU32(28) <= 7
trusted fun atomS3RDisplayRememberDraw(r: NativeBuffer,result: SpiTransactionResult): SpiTransactionResult {
    // Busy/invalid admission did not change panel state. Hardware/ownership
    // faults block further drawing; explicit blank remains available.
    r.storeU32(36,(result.status()<<29)|(result&0x1fffffff))
    if (result.status() >= 4) r.storeU32(4,3)
    return result
}
trusted fun atomS3RDisplayFillOwned(r: NativeBuffer,x: int,y: int,width: int,height: int,color: Rgb565,exclusive: bool): SpiTransactionResult {
    if (!exclusive || !atomS3RDisplayDrawReady(r)) return SpiTransactionResult(3<<32)
    val result=AtomS3Panel(r.loadU32(8)).fillNativeChecked(peripheralGateAt(r.loadU32(16)),u32(r.loadU32(20)),r.loadU32(24),r.loadU32(28),x,y,width,height,color)
    return atomS3RDisplayRememberDraw(r,result)
}
trusted fun atomS3RDisplayBlitOwned(r: NativeBuffer,x: int,y: int,source: NativeBuffer,width: int,height: int,stride: int,
    littleEndian: bool,staging: NativeBuffer,exclusive: bool): SpiTransactionResult {
    if (!exclusive || !atomS3RDisplayDrawReady(r)) return SpiTransactionResult(3<<32)
    // The complete source/staging regions cannot alias the mutable session,
    // including writes of the last-result/fault fields after the transaction.
    if (!source.hasAddressRange(0,source.capacity()) ||
        (source.capacity() > 0 && source.addressValue() < r.addressValue()+40 && r.addressValue() < source.addressValue()+source.capacity()) ||
        (littleEndian && (!staging.hasAddressRange(0,64) || (staging.addressValue() < r.addressValue()+40 && r.addressValue() < staging.addressValue()+64)))) return SpiTransactionResult(3<<32)
    val result=AtomS3Panel(r.loadU32(8)).blitNativeChecked(peripheralGateAt(r.loadU32(16)),u32(r.loadU32(20)),r.loadU32(24),r.loadU32(28),
        x,y,source,width,height,stride,littleEndian,staging)
    return atomS3RDisplayRememberDraw(r,result)
}
