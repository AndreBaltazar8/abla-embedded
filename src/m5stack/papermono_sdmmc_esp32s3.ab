import "./pm1_control_esp32s3.ab"
import "./papermono_sdmmc_sequence.ab"
import "./papermono_sd_power.ab"
import "../sd/mmc_pin_snapshot_esp32s3.ab"
import "../sd/mmc_startup_esp32s3.ab"
trusted fun paperMonoSdMmcAdmission(control: int,context: NativeBuffer,snapshot: NativeBuffer): bool {
    val c=M5Pm1Control(control)
    if (!c.ready() || c.board() != m5BoardPaperMono) return false
    val address=c.buffer().addressValue()
    return esp32S3I2cFacadeBufferSafe(context,128,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        esp32S3I2cFacadeBufferSafe(snapshot,64,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        (context.addressValue()+128 <= address || context.addressValue() >= address+72) &&
        (snapshot.addressValue()+64 <= address || snapshot.addressValue() >= address+72)
}
trusted fun paperMonoSdMmcPowerReady(control: int): int {
    val c=M5Pm1Control(control);val handle=c.expanders().device(0)|0
    val descriptor=esp32S3I2cDevicePool().resolve(handle)
    if (!esp32S3I2cDeviceKeyMatchesBus(descriptor,c.bus()) || esp32S3I2cDeviceKeyAddress(descriptor) != 79 ||
        esp32S3I2cDeviceKeyFrequency(descriptor) != 100000) return 2
    val device=I2cDevice(handle)
    // IO14 zero-based13: push-pull high output. Readback is configuration,
    // not measured voltage: caller also owns settled supply/external pulls.
    return paperMonoSdRailReady(device)
}
trusted fun paperMonoSdMmcHostStopped(): bool {
    // Never access a gated/reset peripheral just to inspect its idle state.
    if ((sdMmcS3SystemRead(0x600c001c)&128) == 0 || (sdMmcS3SystemRead(0x600c0024)&128) != 0) return true
    return (sdMmcS3Read(16)&65535) == 0 && (sdMmcS3Read(44)&0x80000000) == 0 &&
        (sdMmcS3Read(0)&0x02000037) == 0 && (sdMmcS3Read(128)&0x83) == 0 &&
        (sdMmcS3Read(140)&0x1e000) == 0 && (sdMmcS3Read(72)&0x3ffe06f0) == 0
}
trusted fun paperMonoSdMmcCapture(pins: SdMmcPins,slot: int,snapshot: NativeBuffer): int =
    sdMmcPinsCaptureOwned(pins,slot,snapshot,true)
trusted fun paperMonoSdMmcRoute(pins: SdMmcPins,slot: int): int = pins.routeOwned(slot,true,true)
trusted fun paperMonoSdMmcStart(context: NativeBuffer,slot: int,pll: bool,now: u32,budget: int): int =
    sdMmcStartupBeginOwned(context,slot,pll,now,budget,true)
// Retain control, buffers, pad/source/host ownership through asynchronous
// polling and close. Width negotiation still uses the checked SCR/width APIs;
// four wired data pads do not imply the card has switched from1-bit mode.
trusted fun M5Pm1Control.beginPaperMonoSdMmcOwned(context: NativeBuffer,snapshot: NativeBuffer,slot: int,
    pll160: bool,nowMs: u32,budgetMs: int,exclusivePrepared: bool): int =
    paperMonoSdMmcBeginOwned(this|0,context,snapshot,slot,pll160,nowMs,budgetMs,exclusivePrepared)
