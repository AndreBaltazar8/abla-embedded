import "./cores3_playback.ab"

// Finite up-to-eight-voice playback without a decoded clip copy. Explicit
// outputRate enables linear conversion;0 retains same-rate source playback.
// All voice sources/metadata and the table remain immutable until return.
// Caller provides disjoint1920-byte accumulator and960-byte scratch/staging.
// Same powered/stopped/exclusive hardware prerequisites as playbackBlocks.
trusted fun cores3PlaybackMix(amplifier: Aw88298,expander: Aw9523,channel: int,
    descriptors: int,buffers: int,mix: PcmWavMix,staging: NativeBuffer,
    accumulator: NativeBuffer,scratch: NativeBuffer,owner: u32,idlePollsPerBlock: int,
    masterGainQ15: int=32768,outputRate: int=0): CoreS3PlaybackResult {
    val frames=mix.frames(outputRate)
    if (frames < 1 || frames > 982800) return CoreS3PlaybackResult(2)
    cores3PlaybackBlocks(amplifier,expander,channel,descriptors,buffers,
        mix.storage(),int((u32(frames)+u32(239))/u32(240)),staging,owner,idlePollsPerBlock,
        PcmWav(0),mix,accumulator,scratch,masterGainQ15,outputRate)
}
