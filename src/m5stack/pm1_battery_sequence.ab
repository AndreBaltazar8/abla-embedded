import "./pm1_presence_sequence.ab"

// Status0 invalid/unsupported,1 unresolvedpresence,2 absent,3 voltagereadfailed,
// 4 checkedmillivolts. Unlike a plain integer, 0V cannot mask failed I/O.
type Pm1BatteryReading = int
fun Pm1BatteryReading.status(): int = this>>>16
fun Pm1BatteryReading.millivolts(): int = this & 65535
fun Pm1BatteryReading.valid(): bool = this.status() == 4
fun pm1PresenceBoardSupported(board: M5BoardId): bool = board == m5BoardToughC5 || board == m5BoardCoreMatrix
trusted fun Pm1BatteryPresence.readBatteryOwned(board: M5BoardId,pm1: int,ioe: int,now: int): Pm1BatteryReading {
    if (!this.valid() || !pm1PresenceBoardSupported(board) || pm1 <= 0 || pm1 > 4294967295 || ioe <= 0 || ioe > 4294967295) return Pm1BatteryReading(0)
    val present=this.updateBoardOwned(board,pm1,ioe,now)
    if (present < 0) return Pm1BatteryReading(1<<16)
    if (present == 0) return Pm1BatteryReading(2<<16)
    val voltage=pm1PresenceReadVoltage(pm1)
    if (!voltage.valid()) Pm1BatteryReading(3<<16) else Pm1BatteryReading((4<<16)|voltage.value())
}
trusted fun Pm1BatteryPresence.setChargingOwned(board: M5BoardId,pm1: int,enabled: bool,now: int): bool {
    if (!this.valid() || !pm1PresenceBoardSupported(board) || pm1 <= 0 || pm1 > 4294967295) return false
    if (!pm1PresenceWriteCharge(pm1,enabled)) return false
    if (!enabled) this.chargingDisabledAt(now)
    true
}
