import "../display/spi_lcd_esp32s3.ab"
import "./chaincaptain_panel_s3_sequence.ab"
// Borrowed zero-allocation descriptor for common fill/blit/rotation/sleep APIs.
// A descriptor's validity is not evidence of initialized hardware.
fun chainCaptainSpiDisplay(): SpiLcd =
    spiLcd(2,spiPins(16,-1,15),Pin(45),Pin(46),false)
trusted fun chainCaptainPanelClearOwned(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult {
    if (rotation < 0 || rotation > 7) return SpiTransactionResult(3<<32)
    return chainCaptainSpiDisplay().fillRect(gate,owner,chainCaptainDisplayView(rotation),0,0,240,240,rgb565Black)
}
