import "./imu_owner_types.ab"
import "../imu/snapshot.ab"

// Two signed acquisition results, not a forced-success aggregate. A transport
// failure on one device does not discard fresh data from the other device.
type M5ImuUpdateResult = int
fun m5ImuUpdateResult(primary: int,magnetic: int): M5ImuUpdateResult =
    M5ImuUpdateResult(65536 | (primary & 255) | ((magnetic & 255)<<8))
fun M5ImuUpdateResult.valid(): bool = (this>>>16) == 1
fun M5ImuUpdateResult.primaryStatus(): int =
    if (!this.valid()) -1 else ((this & 255)^128)-128
fun M5ImuUpdateResult.magneticStatus(): int =
    if (!this.valid()) -1 else (((this>>>8)&255)^128)-128
fun M5ImuUpdateResult.fresh(): int =
    (if (this.primaryStatus() > 0) this.primaryStatus() & 7 else 0) |
    (if (this.magneticStatus() > 0) this.magneticStatus() & 4 else 0)
fun M5ImuUpdateResult.failed(): bool =
    this.primaryStatus() < 0 || this.magneticStatus() < 0

// One scratch buffer reused serially. All ranges are checked before either
// device performs I/O. External magnetometer overwrites only when fresh.
trusted fun M5ImuOwner.updateOwned(snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): M5ImuUpdateResult {
    if (this.status() != 1 || !this.primary().ready() || !snapshot.valid()) return M5ImuUpdateResult(0)
    val count=if (this.primary().kind() == m5ImuBmi270) 20 else 14
    if (!scratch.hasAddressRange(0,count)) return M5ImuUpdateResult(0)
    val owner=this.buffer().addressValue()
    val data=snapshot.buffer().addressValue()
    val work=scratch.addressValue()
    if ((owner < data+44 && data < owner+36) ||
        (owner < work+count && work < owner+36) ||
        (data < work+count && work < data+44)) return M5ImuUpdateResult(0)
    val mag=this.magnetometers()
    if (mag.status() != 1 && mag.status() != 2) return M5ImuUpdateResult(0)
    val kind=mag.selected()
    if (mag.status() == 1 && (kind < 1 || kind > 2 || mag.handle(kind) == 0)) return M5ImuUpdateResult(0)
    val primary=m5ImuOwnerReadPrimary(this.primary(),snapshot,scratch,micros)
    val magnetic=if (mag.status() == 1) m5ImuOwnerReadMagnetic(mag,snapshot,scratch,micros) else 0
    m5ImuUpdateResult(primary,magnetic)
}
