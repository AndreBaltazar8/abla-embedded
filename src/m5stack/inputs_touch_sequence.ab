import "./inputs_sequence.ab"
import "./touch_poll_sequence.ab"
// Acquisition and input state share caller ownership for the complete poll.
// Protect the full input record before any controller access, not only the
// individual button slots. Tracker coordinates must remain unrotated.
// Controller, board and ratio stay fixed until reinitializing this owner;
// offset12 caches only accepted touch levels, never merged physical levels.
trusted fun M5Inputs.pollWithTouchOwned(board: M5BoardId,kind: int,handle: int,
    tracker: TouchTracker,snapshot: NativeBuffer,raw: NativeBuffer,ratio: int,
    pi4: int,pmic: M5PmicOpen,powerHub: int,now: int): bool {
    if (!this.valid() || tracker <= 0 || tracker > 4294967296-touchTrackerBytes ||
        !snapshot.hasAddressRange(0,40) || !raw.hasAddressRange(0,40) ||
        (kind < 1 || kind > 3) || handle <= 0 || handle > 4294967295 ||
        ratio < 0 || ratio > 255 || board.touchButtonRawMask() == 0) return false
    val owner=this.buffer().addressValue()
    val a=snapshot.addressValue()
    val b=raw.addressValue()
    if ((a < owner+64 && owner < a+40) || (b < owner+64 && owner < b+40) ||
        (tracker < owner+64 && owner < tracker+touchTrackerBytes) ||
        (a < b+40 && b < a+40) || (a < tracker+touchTrackerBytes && tracker < a+40) ||
        (b < tracker+touchTrackerBytes && tracker < b+40)) return false
    var previous=0
    var index=0
    while (index < 3) {
        if (this.button(index).state().isPressed()) previous=previous|int(u32(1)<<u32(index))
        index=index+1
    }
    val acquired=board.pollTouchButtonsOwned(kind,handle,tracker,snapshot,raw,now,previous,ratio)
    val touch=if (acquired.unchanged()) M5TouchButtons(this.buffer().loadU32(12)) else acquired
    // A failed touch sample still allows other GPIO/PMIC inputs to advance.
    val result=m5InputsPollAccepted(this,board,pi4,pmic,powerHub,touch,now)
    this.buffer().storeU32(12,if (result && touch.valid()) touch | 0 else 0)
    result
}
