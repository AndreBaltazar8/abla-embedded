import "./pm1_control_esp32s3.ab"
import "./papermono_frontlight.ab"
trusted fun M5Pm1Control.preparePaperMonoFrontlightOwned(level: int,exclusive: bool): int {
    if (!exclusive || !this.ready() || this.board() != m5BoardPaperMono) return 2
    return paperMonoFrontlightInitializeOwned(M5Pm1(this.pmic().deviceHandle()),level,true)
}
trusted fun M5Pm1Control.paperMonoFrontlightOwned(level: int,exclusive: bool): int {
    if (!exclusive || !this.ready() || this.board() != m5BoardPaperMono) return 2
    return paperMonoFrontlightOwned(M5Pm1(this.pmic().deviceHandle()),level,true)
}
