import "../touch/controller_open_sequence.ab"
// Touch rails/shared reset must already be complete. IRQ4inputpullup is
// prepared before allocating FT5x06 at0x38/400kHz on the borrowed33-bit bus.
// Zero means admission/IRQ failure; generic open retains failed-close handles.
trusted fun paperMonoTouchOpenOwned(control: int,exclusive: bool): TouchControllerOpen {
    if (!exclusive || !paperMonoTouchAdmission(control) || !paperMonoTouchPrepareIrq()) return TouchControllerOpen(0)
    return touchControllerOpenOwned(paperMonoTouchBus(control),1,56,400000)
}
// Stable29B snapshot:0..5contacts,-1transport,-2unstable,-3admission,
// -4malformed coordinates. Decode ONLY nonnegative results from this capture.
trusted fun paperMonoTouchReadOwned(control: int,touch: TouchControllerOpen,snapshot: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !touch.ready() || touch.kind() != 1 || !paperMonoTouchReadAdmission(control,touch.handle(),snapshot)) return -3
    val count=paperMonoTouchReadStable(touch.handle(),snapshot)
    if (count < 0) return count
    var index=0
    while (index < count) {
        if (!ft5x06SnapshotPoint(snapshot,count,index).inside(480,800)) return -4
        index=index+1
    }
    return count
}
