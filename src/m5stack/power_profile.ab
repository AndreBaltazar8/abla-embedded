import "./board_id.ab"

// Discovery policy, not detected hardware or automatic power initialization.
// Unknown means this profile has no supported mapping, not "no battery".
type M5PowerKind = int
val m5PowerUnknown=M5PowerKind(0)
val m5PowerAdc=M5PowerKind(1)
val m5PowerAxp192Or2101=M5PowerKind(2)
val m5PowerAxp2101=M5PowerKind(3)
val m5PowerIp5306=M5PowerKind(4)
val m5PowerM5Pm1=M5PowerKind(5)
val m5PowerAw32001=M5PowerKind(6)

// Based on M5Unified Power_Class::begin. Classic AXP192 candidates require
// identity discrimination between AXP192 and AXP2101; a board ID cannot choose.
fun M5BoardId.powerKind(): M5PowerKind {
    if (this == m5BoardStack) return m5PowerIp5306
    if (this == m5BoardStackCore2 || this == m5BoardTough || this == m5BoardStation ||
        this == m5BoardStickC || this == m5BoardStickCPlus) return m5PowerAxp192Or2101
    if (this == m5BoardStackCoreS3 || this == m5BoardStackCoreS3SE || this == m5BoardStackChan) return m5PowerAxp2101
    if (this == m5BoardCoreP4X || this == m5BoardCoreMatrix || this == m5BoardToughC5 ||
        this == m5BoardStickS3 || this == m5BoardStopWatch || this == m5BoardStampS3Bat ||
        this == m5BoardPaperDIY || this == m5BoardPaperColor || this == m5BoardChainCaptain ||
        this == m5BoardPaperMono) return m5PowerM5Pm1
    if (this == m5BoardArduinoNessoN1) return m5PowerAw32001
    if (this.batteryAdcPin() >= 0) return m5PowerAdc
    m5PowerUnknown
}

fun M5BoardId.batteryAdcPin(): int {
    if (this == m5BoardPaperS3) return 3
    if (this == m5BoardCapsule) return 6
    if (this == m5BoardAirQ) return 14
    if (this == m5BoardDinMeter || this == m5BoardCardputer || this == m5BoardCardputerADV) return 10
    if (this == m5BoardTimerCam || this == m5BoardStickCPlus2) return 38
    if (this == m5BoardStackCoreInk || this == m5BoardPaper) return 35
    return -1
}
fun M5BoardId.batteryAdcUnit(): int =
    if (this == m5BoardAirQ) 2 else if (this.batteryAdcPin() >= 0) 1 else 0

// Scale an already-calibrated ADC millivolt reading through the board divider.
// Not an ADC acquisition/calibration API. Exact rational factors avoid float
// support; truncates fractional mV. -1 distinguishes unsupported/invalid.
fun M5BoardId.batteryMillivoltsFromAdc(adcMillivolts: int): int {
    if (adcMillivolts < 0 || adcMillivolts > 65535 || this.batteryAdcPin() < 0) return -1
    if (this == m5BoardTimerCam) return adcMillivolts*1513/1000
    if (this == m5BoardStackCoreInk) return adcMillivolts*251/51
    adcMillivolts*2
}
