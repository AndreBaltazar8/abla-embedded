import "./codec_record_replay_p4_sequence.ab"
// Typed board adapter; common pipeline owns buffering/DSP/RX-to-TX handoff.
trusted fun tab5RecordReplayOwned(r: NativeBuffer,channel: int,desc: int,count: int,
    payload: int,stride: int,bytes: int,revision: int,polls: int,mic: Es7210,speaker: Es8388,
    io: Pi4Ioe5v6408,recorded: NativeBuffer,work: NativeBuffer,blocks: int,maxIdle: int,exclusive: bool): int =
    m5P4RecordReplayOwned(r,channel,desc,count,payload,stride,bytes,revision,polls,mic|0,speaker|0,io|0,recorded,work,blocks,maxIdle,exclusive,true)
