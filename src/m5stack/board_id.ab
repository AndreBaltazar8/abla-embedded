val m5BoardFrameBuffer = M5BoardId(512)

fun M5BoardId.isBuiltInDisplay(): bool = this >= 1 && this <= 35
fun M5BoardId.isNonDisplay(): bool = this >= 128 && this <= 156
fun M5BoardId.isExternalDisplay(): bool = this >= 192 && this <= 201

// Deprecated upstream spellings intentionally collapse to canonical IDs.
fun m5BoardAtomEcho(): M5BoardId = m5BoardAtomVoice
fun m5BoardAtomEchoS3R(): M5BoardId = m5BoardAtomVoiceS3R
