// Canonical values from m5stack-board-id as consumed by M5GFX 0.2.28.
// IDs are stable protocol values; aliases such as Atom Echo use the canonical
// Atom Voice value rather than creating a second identity.
type M5BoardId = int

val m5BoardUnknown = M5BoardId(0)
val m5BoardStack = M5BoardId(1)
val m5BoardStackCore2 = M5BoardId(2)
val m5BoardStickC = M5BoardId(3)
val m5BoardStickCPlus = M5BoardId(4)
val m5BoardStickCPlus2 = M5BoardId(5)
val m5BoardStackCoreInk = M5BoardId(6)
val m5BoardPaper = M5BoardId(7)
val m5BoardTough = M5BoardId(8)
val m5BoardStation = M5BoardId(9)
val m5BoardStackCoreS3 = M5BoardId(10)
val m5BoardAtomS3 = M5BoardId(11)
val m5BoardDial = M5BoardId(12)
val m5BoardDinMeter = M5BoardId(13)
val m5BoardCardputer = M5BoardId(14)
val m5BoardAirQ = M5BoardId(15)
val m5BoardVAMeter = M5BoardId(16)
val m5BoardStackCoreS3SE = M5BoardId(17)
val m5BoardAtomS3R = M5BoardId(18)
val m5BoardPaperS3 = M5BoardId(19)
val m5BoardCoreMP135 = M5BoardId(20)
val m5BoardStampPLC = M5BoardId(21)
val m5BoardTab5 = M5BoardId(22)
val m5BoardArduinoNessoN1 = M5BoardId(23)
val m5BoardCardputerADV = M5BoardId(24)
val m5BoardUnitC6L = M5BoardId(25)
val m5BoardStickS3 = M5BoardId(26)
val m5BoardStackChan = M5BoardId(27)
val m5BoardPaperColor = M5BoardId(28)
val m5BoardPaperMono = M5BoardId(29)
val m5BoardStopWatch = M5BoardId(30)
