val m5BoardChainCaptain = M5BoardId(32)
val m5BoardToughC5 = M5BoardId(33)
val m5BoardPaperDIY = M5BoardId(34)
val m5BoardTab5X = M5BoardId(35)

val m5BoardAtomLite = M5BoardId(128)
val m5BoardAtomPsram = M5BoardId(129)
val m5BoardAtomU = M5BoardId(130)
val m5BoardCamera = M5BoardId(131)
val m5BoardTimerCam = M5BoardId(132)
val m5BoardStampPico = M5BoardId(133)
val m5BoardStampC3 = M5BoardId(134)
val m5BoardStampC3U = M5BoardId(135)
val m5BoardStampS3 = M5BoardId(136)
