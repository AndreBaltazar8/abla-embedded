val m5BoardAtomS3U = M5BoardId(138)
val m5BoardCapsule = M5BoardId(139)
val m5BoardNanoC6 = M5BoardId(140)
val m5BoardAtomMatrix = M5BoardId(141)
val m5BoardAtomVoice = M5BoardId(142)
val m5BoardAtomS3RExt = M5BoardId(143)
val m5BoardAtomS3RCam = M5BoardId(144)
val m5BoardAtomVoiceS3R = M5BoardId(145)
val m5BoardPowerHub = M5BoardId(146)
val m5BoardDualKey = M5BoardId(147)
val m5BoardUnitPoEP4 = M5BoardId(148)
val m5BoardStampS3Bat = M5BoardId(149)
val m5BoardStampP4 = M5BoardId(150)
val m5BoardNanoH2 = M5BoardId(151)
val m5BoardCoreMatrix = M5BoardId(152)
