import "./pm1_control_esp32s3.ab"
import "./pm1_wake_pins_s3_sequence.ab"
import "../esp32/gpio/snapshot_esp32s3.ab"
// Control readiness means power setup succeeded, not CPU pad readiness.
// Caller must retain this result independently and quiesce all users on failure.
trusted fun M5Pm1Control.configureWakePinsOwned(exclusiveWakeDisarmed: bool): int =
    if (!this.ready()) 3 else this.board().configurePm1WakePinsOwned(exclusiveWakeDisarmed)
