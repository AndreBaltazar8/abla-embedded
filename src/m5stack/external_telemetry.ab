import "./external_telemetry_sequence.ab"
import "../power/m5pm1_device.ab"
import "../power/ina226_device.ab"
// Borrowed devices, already initialized for this board. No writes or device
// lifetime changes. INA226 current requires its caller's calibrated scalar.
@inline
trusted fun externalTelemetryPm1Read(handle: int,source: int): I2cWordResult =
    if (source == 1) M5Pm1(handle).vbusVoltageRaw() else M5Pm1(handle).output5VVoltageRaw()
trusted fun M5Pm1.externalMillivoltsChecked(board: M5BoardId,ports: int): PowerMeasurement =
    board.pm1ExternalMillivoltsCheckedOwned(this | 0,ports)
// PM1's upstream current path returns a voltage on three boards; no current
// sensor is provided by that protocol. Never label millivolts as milliamps.
fun M5Pm1.externalMilliampsChecked(board: M5BoardId,ports: int): PowerMeasurement = PowerMeasurement(0)
trusted fun Ina226.externalMillivoltsChecked(board: M5BoardId,ports: int): PowerMeasurement {
    if (!board.plcExternalTelemetrySupported(ports)) return PowerMeasurement(0)
    m5PlcBusMillivolts(this.busVoltageRaw())
}
trusted fun Ina226.externalMilliampsChecked(board: M5BoardId,ports: int): PowerMeasurement {
    if (!board.plcExternalTelemetrySupported(ports)) return PowerMeasurement(0)
    this.currentMilliampsChecked()
}
