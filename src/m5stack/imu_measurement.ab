import "./imu_owner_types.ab"
import "../imu/snapshot.ab"
import "../imu/oriented_measurement.ab"

// Default driver conversion factors, not a live register query. Changing a
// device's full-scale registers requires the caller to use its new scale.
// Units are g, degrees/second and milligauss, matching M5Unified.
type M5ImuScale = int
fun M5ImuScale.numerator(): int = this & 0xFFFFFFFF
fun M5ImuScale.denominator(): int = this>>>32
fun M5ImuScale.valid(): bool = this.numerator() > 0 && this.denominator() > 0
fun M5ImuScale.value(): f64 = if (!this.valid()) 0.0 else
    f64FromInt(this.numerator()) / f64FromInt(this.denominator())
trusted fun M5ImuOwner.hasSensor(sensor: int): bool {
    if (this.status() != 1 || !this.primary().ready() || sensor < 0 || sensor > 2) return false
    if (sensor < 2) return true
    val mag=this.magnetometers()
    val kind=mag.selected()
    ((this.primary().capabilities() & 4) != 0) ||
        (kind >= 1 && kind <= 2 && mag.handle(kind) != 0)
}
trusted fun M5ImuOwner.defaultScale(sensor: int): M5ImuScale =
    if (!this.hasSensor(sensor)) M5ImuScale(0) else
    if (sensor == 0) M5ImuScale((32768<<32)|8) else
    if (sensor == 1) M5ImuScale((32768<<32)|2000) else M5ImuScale((32760<<32)|49120)
// Physical-axis offsets are applied before the board mapping and optional user
// mapping. Invalid/unavailable channels stay distinguishable from a true zero.
trusted fun M5ImuOwner.measureAxis(snapshot: ImuSnapshot,offsets: ImuOffsets,
    board: M5BoardId,sensor: int,axis: int,userOrder: ImuAxisOrder): ImuFixedSample {
    if (!this.hasSensor(sensor)) return ImuFixedSample(0)
    val primary=this.primary()
    val order=board.imuAxisOrder(primary.kind(),sensor,primary.address(),
        M5MagnetometerKind(this.magnetometers().selected())).then(userOrder)
    order.correctedAxis(snapshot.axes(sensor),offsets,sensor,axis)
}
