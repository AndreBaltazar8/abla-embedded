// Import through cores3_speaker.ab with the selected I2C backend. Caller owns
// both handles and serializes the entire lifecycle against other board users.
// CoreS3/SE board power and AW9523 P0_2 GPIO/output configuration must already
// be established. No device resets, rail changes or I2S DMA setup are implied.
// Status:1 success,2 invalid,3 enable-pin write,4 amplifier setup,5 disable.
// Bits8/9/10: cleanup attempted / amplifier disable failed / enable clear failed.
type CoreS3SpeakerResult = int
fun CoreS3SpeakerResult.status(): int = this & 255
fun CoreS3SpeakerResult.valid(): bool = this.status() == 1
fun CoreS3SpeakerResult.cleanupAttempted(): bool = (this & 256) != 0
fun CoreS3SpeakerResult.amplifierDisableFailed(): bool = (this & 512) != 0
fun CoreS3SpeakerResult.enableClearFailed(): bool = (this & 1024) != 0

trusted fun cores3SpeakerCleanup(amplifier: Aw88298, expander: Aw9523, status: int): CoreS3SpeakerResult {
    // Always attempt both actions. In particular an I2C failure disabling the
    // amp must not short-circuit deassertion of the board enable signal.
    val disabled = amplifier.disableI2s()
    val cleared = expander.digitalWrite(2, false)
    val resultStatus = if (status == 1 && (!disabled || !cleared)) 5 else status
    CoreS3SpeakerResult(resultStatus | 256 | (if (disabled) 0 else 512) | (if (cleared) 0 else 1024))
}

trusted fun cores3SpeakerEnable(amplifier: Aw88298, expander: Aw9523, sampleRate: int): CoreS3SpeakerResult {
    if (!amplifier.valid() || !expander.valid() || aw88298RateIndex(sampleRate) < 0) return CoreS3SpeakerResult(2)
    if (!expander.digitalWrite(2, true)) return cores3SpeakerCleanup(amplifier, expander, 3)
    if (!amplifier.configureI2s16(sampleRate)) return cores3SpeakerCleanup(amplifier, expander, 4)
    CoreS3SpeakerResult(1)
}

trusted fun cores3SpeakerDisable(amplifier: Aw88298, expander: Aw9523): CoreS3SpeakerResult {
    if (!amplifier.valid() || !expander.valid()) return CoreS3SpeakerResult(2)
    cores3SpeakerCleanup(amplifier, expander, 1)
}
