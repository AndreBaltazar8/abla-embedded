import "./papermono_sdmmc_sequence.ab"
// Bounded one-step close:1closed2pending3invalid/notquiescent4hostbusy,
// 5clockfailure6padrestorefailure. Retry with retained buffers; never reset,
// detach a pending transfer, turn off the rail or discard failed snapshots.
// Finish startup polling before closing status2. All SCR/width/DMA/filesystem
// users must be joined, not merely the initialization state machine.
trusted fun paperMonoSdMmcCloseOwned(context: NativeBuffer,snapshot: NativeBuffer,quiescentExclusive: bool): int {
    if (!quiescentExclusive || !paperMonoSdMmcStorageSafe(context,128) || !paperMonoSdMmcStorageSafe(snapshot,64) ||
        (context.addressValue()&3) != 0 || (snapshot.addressValue()&3) != 0 ||
        (context.addressValue() < snapshot.addressValue()+64 && snapshot.addressValue() < context.addressValue()+128)) return 3
    val tag=context.loadU32(0)
    val state=if (tag == 0) 0 else if ((tag&0xffffff00) == 0x53445300) tag&255 else -1
    val saved=snapshot.loadU32(0)
    if (state != 0 && state != 1 && state != 4 && state != 5 && state != 6 && state != 7 && state != 8) return 3
    // Untouched capture failure: neither host startup nor routing began.
    if (state == 0 && saved == 0) return 1
    if ((saved != 0x53445001 && saved != 0x53445002) || snapshot.load(4) > 1 || snapshot.load(5) != 6 ||
        (state != 0 && context.load(5) != snapshot.load(4))) return 3
    var index=0
    while (index < 6) {
        val pin=snapshot.loadU32(8+index*4)
        if ((pin>>>29) != 1 || ((pin>>>23)&63) != 13-index ||
            (index < 5 && snapshot.loadU32(32+index*4) > 255)) return 3
        index=index+1
    }
    if (saved == 0x53445002) return if (state == 0 || state == 7) 1 else 3
    if (state != 0 && state != 7) {
        val result=if (state == 6) paperMonoSdMmcClosePoll(context) else paperMonoSdMmcCloseBegin(context)
        if (result != 1) return result
    }
    // Includes a failed route before startup, and closed host resources whose
    // shared root clock may have been restored to its previous enabled state.
    if (!paperMonoSdMmcHostStopped()) return 4
    return if (paperMonoSdMmcRestore(snapshot) == 1) 1 else 6
}
