import "./pmic_types.ab"
import "../power/axp192_device.ab"
import "../power/axp2101_device.ab"
// ADC setup and device lifetime belong to caller. Read-only, no fallback to
// another chip and no implicit ADC enable. Unsupported PMICs perform no I/O.
trusted fun M5PmicOpen.readInternalTemperatureMilliCelsiusOwned(exclusive: bool): PowerMeasurement {
    if (!exclusive || !this.ready()) return PowerMeasurement(0)
    if (this.kind() == 2) return Axp192(this.deviceHandle()).internalTemperatureMilliCelsiusChecked()
    if (this.kind() == 3) return Axp2101(this.deviceHandle()).internalTemperatureMilliCelsiusChecked()
    return PowerMeasurement(0)
}
