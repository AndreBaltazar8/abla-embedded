import "./magnetometer_types.ab"
trusted fun M5Magnetometers.releaseKind(kind: int): bool {
    val handle=this.handle(kind)
    if (handle == 0) return true
    if (!m5MagnetometerRelease(handle)) return false
    this.buffer().storeU32(kind*4,0)
}
trusted fun M5Magnetometers.releaseAll(): bool {
    if (!this.valid()) return false
    val bmm=this.releaseKind(1)
    val ak=this.releaseKind(2)
    this.buffer().storeU32(12,0)
    this.buffer().storeU32(16,if (bmm && ak) 0 else 4)
    bmm && ak
}
// Fresh record only: initialize does NOT release an existing live record.
trusted fun M5Magnetometers.probeOwned(bus: int): int {
    if (!this.valid() || this.status() != 0 || this.handle(1) != 0 || this.handle(2) != 0) return -1
    var kind=1
    while (kind <= 2) {
        val handle=m5MagnetometerAllocate(bus,if (kind == 1) 16 else 12)
        if (handle == 0) { this.buffer().storeU32(16,3); return 3 }
        this.buffer().storeU32(kind*4,handle)
        if (m5MagnetometerBegin(handle,kind) == 4) {
            this.buffer().storeU32(12,kind)
        } else if (!this.releaseKind(kind)) {
            this.buffer().storeU32(16,4); return 4
        }
        kind=kind+1
    }
    if (this.handle(2) != 0 && !this.releaseKind(1)) {
        this.buffer().storeU32(16,4); return 4
    }
    val status=if (this.handle(1) != 0 || this.handle(2) != 0) 1 else 2
    this.buffer().storeU32(16,status)
    status
}
