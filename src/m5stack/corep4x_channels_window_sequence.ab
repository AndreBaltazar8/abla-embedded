import "./codec_channels_window_p4_sequence.ab"
type CoreP4xPlaybackWindowResult=int
fun CoreP4xPlaybackWindowResult.status(): int = this&255
fun CoreP4xPlaybackWindowResult.queuedBlocks(): int = this >>> 32
trusted fun coreP4xPlaybackChannelsWindowOwned(r: NativeBuffer,bank: PcmChannels,blocks: int,
    accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,maxIdle: int,gain: int,exclusive: bool,tone: PcmTone=PcmTone(0)): CoreP4xPlaybackWindowResult =
    CoreP4xPlaybackWindowResult(m5P4PlaybackChannelsWindowOwned(r,bank,blocks,accumulator,scratch,staging,maxIdle,gain,exclusive,false,tone)|0)
trusted fun coreP4xPlaybackSourceQueuesWindowOwned(r: NativeBuffer,queues: PcmSourceQueues,blocks: int,
    accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,maxIdle: int,gain: int,exclusive: bool): CoreP4xPlaybackWindowResult =
    CoreP4xPlaybackWindowResult(m5P4PlaybackChannelsWindowOwned(r,PcmChannels(0),blocks,accumulator,scratch,staging,maxIdle,gain,exclusive,false,PcmTone(0),queues)|0)
