import "./board_id.ab"
import "../io_expander/m5ioe1_device.ab"
// Upstream CoreMatrix setChargeCurrent selector, NOT a programmable maximum
// or measured current. Requests>=650 select IOE0 bit2 (upstream gpio3) output-low; smaller
// requests select input with no pulls. Zero does NOT disable charging.
// The lower circuit rate is not inferred here. Caller owns IOE bit2 and holds
// serialization across this entire multi-transaction sequence. PM1 charging
// enable/board electrical safety remain independent operations.
// Status1complete2unsupported3invalidhandle4invalidrequest5pullfailure
// 6latchfailure7driverfailure8directionfailure. No rollback on failure.
// Bit8 reports high-rate selection only after all transfers succeeded.
type M5CoreMatrixChargeSelection = int
fun M5CoreMatrixChargeSelection.status(): int = this&255
fun M5CoreMatrixChargeSelection.valid(): bool = this.status() == 1
fun M5CoreMatrixChargeSelection.highRateSelected(): bool = this.valid() && (this&256) != 0
trusted fun M5BoardId.setCoreMatrixChargeCurrentOwned(ioe: M5Ioe1,requestedMilliamps: int): M5CoreMatrixChargeSelection {
    if (this != m5BoardCoreMatrix) return M5CoreMatrixChargeSelection(2)
    if ((ioe|0) <= 0 || (ioe|0) > 4294967295) return M5CoreMatrixChargeSelection(3)
    if (requestedMilliamps < 0 || requestedMilliamps > 65535) return M5CoreMatrixChargeSelection(4)
    if (!ioe.setPullMode(2,pullNone)) return M5CoreMatrixChargeSelection(5)
    val high=requestedMilliamps >= 650
    if (high) {
        // Latch before push-pull/output selection; never drive this pin high.
        if (!ioe.digitalWrite(2,false)) return M5CoreMatrixChargeSelection(6)
        if (!ioe.setHighImpedance(2,false)) return M5CoreMatrixChargeSelection(7)
    }
    if (!ioe.setDirection(2,high)) return M5CoreMatrixChargeSelection(8)
    return M5CoreMatrixChargeSelection(1|(if (high) 256 else 0))
}
