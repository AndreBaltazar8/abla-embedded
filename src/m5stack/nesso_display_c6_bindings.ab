import "./nesso_display_sequence.ab"
import "../display/software_pins_checked.ab"
import "../display/software_mipi_checked.ab"
import "../display/software_blit_checked.ab"
import "../display/mipi_programs.ab"
import "./display_map.ab"
import "./nesso_display_controls_sequence.ab"
import "../display/software_control_checked.ab"
import "./nesso_display_orientation_sequence.ab"
trusted fun nessoDisplaySetPanelRotation(gate: PeripheralGate,owner: u32,rotation: int,bgr: bool): int =
    softwareLcdSetRotationChecked(gate,owner,Pin(20),Pin(21),Pin(17),Pin(16),m5BoardArduinoNessoN1.displayGeometry(),rotation,bgr,1,false)|0
trusted fun nessoDisplaySetPanelInverted(gate: PeripheralGate,owner: u32,inverted: bool): int =
    softwareLcdSetInvertedChecked(gate,owner,Pin(20),Pin(21),Pin(17),Pin(16),inverted,1,false)|0
trusted fun nessoDisplaySetPanelIdle(gate: PeripheralGate,owner: u32,idle: bool): int =
    softwareLcdSetIdleChecked(gate,owner,Pin(20),Pin(21),Pin(17),Pin(16),idle,1,false)|0
// Snapshot for drawing/touch mapping only while initialized and awake.
trusted fun NessoDisplay.view(): LcdView = if (this.ready())
    m5BoardArduinoNessoN1.displayGeometry().view(this.rotation(),this.bgrOrder()) else LcdView(0)
trusted fun nessoDisplaySetPanelSleep(gate: PeripheralGate,owner: u32,sleeping: bool,settleMilliseconds: int): int =
    softwareLcdSetSleepChecked(gate,owner,Pin(20),Pin(21),Pin(17),Pin(16),sleeping,settleMilliseconds,1,false)|0
trusted fun nessoDisplayStorageSafe(storage: NativeBuffer): bool = softwareI2cProviderBufferSafe(storage,40)
trusted fun nessoDisplayGateSafe(storage: NativeBuffer,gate: PeripheralGate,owner: u32): bool =
    gate.word().valid() && peripheralOwnerValid(owner) && gate.bufferDisjoint(storage,40) &&
    softwareI2cProviderBufferSafe(nativeBufferAt(gate|0,4),4) && gate.word().compareExchange(u32(0),u32(0)) == u32(0)
trusted fun nessoDisplayPreparePins(gate: PeripheralGate,owner: u32): int =
    softwareLcdConfigurePinsChecked(gate,owner,Pin(20),Pin(21),Pin(17),Pin(16),false,true)|0
trusted fun nessoDisplayInitializePanel(gate: PeripheralGate,owner: u32,rotation: int,bgr: bool): int =
    softwareLcdBeginRgb565Checked(gate,owner,Pin(20),Pin(21),Pin(17),Pin(16),m5BoardArduinoNessoN1.displayGeometry(),
        rotation,st7789InitProgram(),NativeBuffer(0),true,bgr,1,false)|0
trusted fun nessoDisplayClearPanel(gate: PeripheralGate,owner: u32,rotation: int,bgr: bool): int {
    val view=m5BoardArduinoNessoN1.displayGeometry().view(rotation,bgr)
    return softwareLcdFillRectChecked(gate,owner,Pin(20),Pin(21),Pin(17),Pin(16),view,0,0,view.width(),view.height(),Rgb565(0),1,false)|0
}
trusted fun nessoDisplayParkPins(gate: PeripheralGate,owner: u32): bool {
    if (gate.word().compareExchange(u32(0),u32(0)) == u32(0x80000000))
        return softwareLcdRecoverPinsChecked(gate,owner,Pin(20),Pin(21),Pin(17),Pin(16),false,true)
    return softwareLcdConfigurePinsChecked(gate,owner,Pin(20),Pin(21),Pin(17),Pin(16),false,true).valid()
}
trusted fun NessoDisplay.fillRectOwned(x: int,y: int,width: int,height: int,color: Rgb565,exclusive: bool): SpiTransactionResult {
    if (!exclusive || !this.ready()) return SpiTransactionResult(3<<32)
    this.buffer().storeU32(4,3)
    val result=softwareLcdFillRectChecked(this.gate(),this.owner(),Pin(20),Pin(21),Pin(17),Pin(16),
        m5BoardArduinoNessoN1.displayGeometry().view(this.rotation(),this.bgrOrder()),x,y,width,height,color,1,false)
    this.saveSpi(result|0);this.buffer().storeU32(4,1)
    if (result.status() == 5 || result.status() == 6) this.fail(10)
    return result
}
trusted fun NessoDisplay.blitOwned(x: int,y: int,source: NativeBuffer,width: int,height: int,stride: int,littleEndian: bool,exclusive: bool): SpiTransactionResult {
    if (!exclusive || !this.ready() || !source.hasAddressRange(0,source.capacity()) ||
        (source.capacity() != 0 && source.addressValue() < this.buffer().addressValue()+40 &&
        this.buffer().addressValue() < source.addressValue()+source.capacity())) return SpiTransactionResult(3<<32)
    this.buffer().storeU32(4,3)
    val result=softwareLcdBlitRgb565Checked(this.gate(),this.owner(),Pin(20),Pin(21),Pin(17),Pin(16),
        m5BoardArduinoNessoN1.displayGeometry().view(this.rotation(),this.bgrOrder()),x,y,source,width,height,stride,littleEndian,1,false)
    this.saveSpi(result|0);this.buffer().storeU32(4,1)
    if (result.status() == 5 || result.status() == 6) this.fail(10)
    return result
}
