import "./tab5_owned_video_sequence.ab"
import "./tab5_dsi_owner_esp32p4.ab"
import "../display/dsi_service_esp32p4.ab"
import "../display/dsi_worker_esp32p4.ab"
trusted fun tab5OwnedVideoBuffersValid(descriptor: NativeBuffer,frame: NativeBuffer,line: int): bool {
    val desc=descriptor.addressValue()
    val pixels=frame.addressValue()
    val span=esp32P4CacheWritebackSpan(frame,1843200,line)
    return desc >= 1341128704 && desc <= 1341915072 && esp32P4CacheWritebackSpan(descriptor,64,line) == 64 && span != 0 &&
        (desc+64 <= pixels || pixels+span <= desc)
}
trusted fun tab5OwnedVideoStart(panel: int,layout: int,vc: int,channel: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): int =
    Tab5PanelStart(panel).openVideoOwned(layout,vc,channel,descriptor,frame,line,polls)|0
trusted fun tab5OwnedVideoStop(gate: int,channel: int,polls: int): int = esp32P4DsiServiceShutdown(serviceGateAt(gate),channel,polls)
trusted fun tab5OwnedVideoPoll(mailbox: NativeBuffer,gate: int,token: u32,channel: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): P4DsiWorkerResult =
    esp32P4DsiWorkerPollOwned(p4DsiMailboxAt(mailbox),serviceGateAt(gate),token,channel,descriptor,frame,1843200,line,polls)
