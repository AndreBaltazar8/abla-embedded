import "./codec_channels_window_p4_sequence.ab"
type Tab5PlaybackWindowResult=int
fun Tab5PlaybackWindowResult.status(): int = this&255
fun Tab5PlaybackWindowResult.queuedBlocks(): int = this >>> 32
trusted fun tab5PlaybackChannelsWindowOwned(r: NativeBuffer,bank: PcmChannels,blocks: int,
    accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,maxIdle: int,gain: int,exclusive: bool,tone: PcmTone=PcmTone(0)): Tab5PlaybackWindowResult =
    Tab5PlaybackWindowResult(m5P4PlaybackChannelsWindowOwned(r,bank,blocks,accumulator,scratch,staging,maxIdle,gain,exclusive,true,tone)|0)
trusted fun tab5PlaybackSourceQueuesWindowOwned(r: NativeBuffer,queues: PcmSourceQueues,blocks: int,
    accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,maxIdle: int,gain: int,exclusive: bool): Tab5PlaybackWindowResult =
    Tab5PlaybackWindowResult(m5P4PlaybackChannelsWindowOwned(r,PcmChannels(0),blocks,accumulator,scratch,staging,maxIdle,gain,exclusive,true,PcmTone(0),queues)|0)
