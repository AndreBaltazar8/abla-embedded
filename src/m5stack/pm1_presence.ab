import "./pm1_presence_sequence.ab"
import "../power/m5pm1_device.ab"
import "../io_expander/m5ioe1_device.ab"
import "../hal/m5stack_3.ab"
@inline
@export("pm1PresenceReadEnabled")
trusted fun pm1PresenceReadEnabledHook(handle: int): I2cByteResult = M5Pm1(handle).batteryChargeResult()
@inline
@export("pm1PresenceReadSource")
trusted fun pm1PresenceReadSourceHook(handle: int): I2cByteResult = M5Pm1(handle).powerSourceResult()
@inline
@export("pm1PresenceReadVoltage")
trusted fun pm1PresenceReadVoltageHook(handle: int): I2cWordResult = M5Pm1(handle).batteryVoltageRaw()
@inline
@export("pm1PresenceReadChargeStat")
trusted fun pm1PresenceReadChargeStatHook(handle: int,pin: int): I2cByteResult = M5Ioe1(handle).digitalReadChecked(pin)
trusted fun Pm1BatteryPresence.updateBoard(board: M5BoardId,pm1: M5Pm1,ioe: M5Ioe1,now: int): int =
    this.updateBoardOwned(board,pm1 | 0,ioe | 0,now)
