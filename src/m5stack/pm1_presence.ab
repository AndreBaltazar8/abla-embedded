import "./pm1_presence_sequence.ab"
import "../power/m5pm1_device.ab"
import "../io_expander/m5ioe1_device.ab"
@inline
trusted fun pm1PresenceReadEnabled(handle: int): I2cByteResult = M5Pm1(handle).batteryChargeResult()
@inline
trusted fun pm1PresenceReadSource(handle: int): I2cByteResult = M5Pm1(handle).powerSourceResult()
@inline
trusted fun pm1PresenceReadVoltage(handle: int): I2cWordResult = M5Pm1(handle).batteryVoltageRaw()
@inline
trusted fun pm1PresenceReadChargeStat(handle: int,pin: int): I2cByteResult = M5Ioe1(handle).digitalReadChecked(pin)
trusted fun Pm1BatteryPresence.updateBoard(board: M5BoardId,pm1: M5Pm1,ioe: M5Ioe1,now: int): int =
    this.updateBoardOwned(board,pm1 | 0,ioe | 0,now)
