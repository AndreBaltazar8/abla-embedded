import "./imu_owner_update_sequence.ab"
import "./imu_update.ab"
import "./magnetometer_update.ab"
@inline
trusted fun m5ImuOwnerReadPrimary(primary: M5ImuProbeResult,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int =
    primary.updateSnapshot(snapshot,scratch,micros)
@inline
trusted fun m5ImuOwnerReadMagnetic(mag: M5Magnetometers,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int =
    mag.updateSnapshot(snapshot,scratch,micros)
trusted fun M5ImuOwner.updateSnapshot(snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): M5ImuUpdateResult =
    this.updateOwned(snapshot,scratch,micros)
