import "./imu_owner_update_sequence.ab"
import "./imu_update.ab"
import "./magnetometer_update.ab"
import "../hal/m5stack_3.ab"
@inline
@export("m5ImuOwnerReadPrimary")
trusted fun m5ImuOwnerReadPrimaryHook(primary: M5ImuProbeResult,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int =
    primary.updateSnapshot(snapshot,scratch,micros)
@inline
@export("m5ImuOwnerReadMagnetic")
trusted fun m5ImuOwnerReadMagneticHook(mag: M5Magnetometers,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int =
    mag.updateSnapshot(snapshot,scratch,micros)
trusted fun M5ImuOwner.updateSnapshot(snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): M5ImuUpdateResult =
    this.updateOwned(snapshot,scratch,micros)
