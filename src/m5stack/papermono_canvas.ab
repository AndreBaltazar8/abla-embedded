import "../display/ssd1677_canvas.ab"
// Physical800x480 panel; rotation0 logical480x800, upstream offset rotation3.
// Exactly96000 caller-owned bytes (two48000B drawing planes). Initialize all
// pixels before first refresh; immutable while transport consumes them.
fun paperMonoCanvasRotation(rotation: int): int =
    if (rotation < 0 || rotation > 7) -1 else ((rotation+3)&3)|(rotation&4)
trusted fun paperMonoCanvasDrawOwned(canvas: NativeBuffer,x: int,y: int,w: int,h: int,rotation: int,
    source: NativeBuffer,stride: int,fill: int,exclusive: bool): bool =
    ssd1677CanvasDrawOwned(canvas,800,480,x,y,w,h,paperMonoCanvasRotation(rotation),source,stride,fill,exclusive)
trusted fun paperMonoCanvasRead(canvas: NativeBuffer,x: int,y: int,rotation: int): int =
    ssd1677CanvasRead(canvas,800,480,x,y,paperMonoCanvasRotation(rotation))
