import "../io_expander/m5ioe1_device.ab"
// M5GFX ChainCaptain display power/reset and Light_M5ChainCaptain (M5Stack,MIT).
// Caller owns stopped panel/touch/audio users of the IOE, deasserted LCD CS,
// initialized control bus and calibrated delay. No rollback on partial writes.
// IO12/bit11 supplies LCD; IO1/bit0 resets it. Delays are10ms LOW,20ms HIGH.
// Low8:1complete3invalid/admission4I/O failure; completed writes bits8..15.
trusted fun chainCaptainDisplayPowerOwned(io: M5Ioe1,reset: bool,exclusiveCsInactive: bool): int {
    if (!exclusiveCsInactive || (io|0) <= 0 || (io|0) > 4294967295) return 3
    if (!io.setHighImpedance(11,false)) return 4
    if (!io.setDirection(11,true)) return 4|(1<<8)
    if (!io.digitalWrite(11,true)) return 4|(2<<8)
    if (!io.setHighImpedance(0,false)) return 4|(3<<8)
    if (!io.setDirection(0,true)) return 4|(4<<8)
    if (reset) {
        if (!io.digitalWrite(0,false)) return 4|(5<<8)
        peripheralDelayMilliseconds(10)
    }
    val steps=if (reset) 6 else 5
    if (!io.digitalWrite(0,true)) return 4|(steps<<8)
    peripheralDelayMilliseconds(20)
    return 1|((steps+1)<<8)
}
// Upstream rounded quadratic brightness curve, endpoints0/4095.
fun chainCaptainBacklightDuty(brightness: int): int =
    if (brightness < 0 || brightness > 255) -1 else (brightness*brightness*4095+32512)/65025
// IO11/bit10 is PWM_CH3/channel2, duty at0x1f/0x20. Zero brightness keeps
// PWM enabled with zero duty, as upstream. Own shared PWM-frequency users.
trusted fun M5Ioe1.setChainCaptainBacklightOwned(brightness: int): bool {
    val duty=chainCaptainBacklightDuty(brightness)
    return (this|0) > 0 && (this|0) <= 4294967295 && duty >= 0 && this.setPwmDuty12(2,duty,false,true)
}
trusted fun chainCaptainBacklightPrepareOwned(io: M5Ioe1,brightness: int,exclusivePwm: bool): int {
    if (!exclusivePwm || (io|0) <= 0 || (io|0) > 4294967295 || chainCaptainBacklightDuty(brightness) < 0) return 3
    if (!io.device().writeRegister8(35,0)) return 4
    if (!io.setHighImpedance(10,false)) return 4|(1<<8)
    if (!io.setDirection(10,true)) return 4|(2<<8)
    if (!io.setPwmFrequency(1000)) return 4|(3<<8)
    if (!io.setChainCaptainBacklightOwned(brightness)) return 4|(4<<8)
    return 1|(5<<8)
}
