val cores3PanelUnknown = 0
val cores3PanelIli9342C = 1
val cores3PanelIli9342E = 2
val cores3PanelTransportFailure = -1
val cores3PanelInvalidDevice = -2

fun cores3PanelIdentity(firmware: int, vendor: int): int =
    if (vendor != 17) cores3PanelUnknown
    else if (firmware == 16) cores3PanelIli9342C
    else if (firmware == 18) cores3PanelIli9342E else cores3PanelUnknown
