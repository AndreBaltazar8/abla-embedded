import "./expander_owner.ab"
import "./pmic_types.ab"
import "../power/m5pm1_device.ab"
// Status1 complete phase,2 unsupportedboard,3 notready,4 I/O failure.
// Bits8..15 acknowledged high-level operations in this phase; no rollback.
type M5ToughPowerSetup = int
fun M5ToughPowerSetup.status(): int = this & 255
fun M5ToughPowerSetup.appliedSteps(): int = (this>>>8)&255
fun M5ToughPowerSetup.valid(): bool = this.status() == 1
// Boot-only phases after PM1/expander begin and configureToughBuzzer safety check.
// Inputs explicitly discards pending PM1 wake/IRQ status: consume wake reasons
// first if needed. After inputs, update battery presence before rails. Rails
// normalizes CHG_PROG released, CHG_STAT input, SD supply, charger/DC/DC/LDO/LED,
// IRQ output and RTC nIRQ input. Finish with CPU GPIO4 digital input/pullup.
// Phase success does not establish CPU/policy initialization or physical rails.
// M5IOE charger gpio1/gpio3 means bit0/bit2; PM1 GPIO numbers are zero-based.
trusted fun M5Expanders.configureToughPowerInputs(pmic: M5PmicOpen): M5ToughPowerSetup {
    if (!this.ready() || !pmic.ready() || pmic.kind() != 5) return M5ToughPowerSetup(3)
    if (this.board() != m5BoardToughC5) return M5ToughPowerSetup(2)
    val pm1=M5Pm1(pmic.deviceHandle())
    val ioe=M5Ioe1(this.device(0) | 0)
    if (!pm1.clearWakeSource()) return M5ToughPowerSetup(4|(0<<8))
    if (!pm1.clearGpioIrqStatus()) return M5ToughPowerSetup(4|(1<<8))
    if (!pm1.clearSystemIrqStatus()) return M5ToughPowerSetup(4|(2<<8))
    if (!pm1.clearButtonIrqStatus()) return M5ToughPowerSetup(4|(3<<8))
    if (!pm1.setGpioIrqMask(22)) return M5ToughPowerSetup(4|(4<<8))
    if (!pm1.setGpioFunction(0,m5Pm1GpioFunctionGpio)) return M5ToughPowerSetup(4|(5<<8))
    if (!pm1.setGpioMode(0,m5Pm1GpioInput)) return M5ToughPowerSetup(4|(6<<8))
    M5ToughPowerSetup(1|(7<<8))
}
trusted fun M5Expanders.configureToughPowerRails(pmic: M5PmicOpen): M5ToughPowerSetup {
    if (!this.ready() || !pmic.ready() || pmic.kind() != 5) return M5ToughPowerSetup(3)
    if (this.board() != m5BoardToughC5) return M5ToughPowerSetup(2)
    val pm1=M5Pm1(pmic.deviceHandle())
    val ioe=M5Ioe1(this.device(0) | 0)
    if (!ioe.setDirection(0,false)) return M5ToughPowerSetup(4|(0<<8))
    if (!ioe.setHighImpedance(0,true)) return M5ToughPowerSetup(4|(1<<8))
    if (!ioe.setPullMode(0,pullNone)) return M5ToughPowerSetup(4|(2<<8))
    if (!ioe.setDirection(2,false)) return M5ToughPowerSetup(4|(3<<8))
    if (!ioe.setHighImpedance(6,false)) return M5ToughPowerSetup(4|(4<<8))
    if (!ioe.setDirection(6,true)) return M5ToughPowerSetup(4|(5<<8))
    if (!ioe.digitalWrite(6,true)) return M5ToughPowerSetup(4|(6<<8))
    if (!pm1.setBatteryCharge(true)) return M5ToughPowerSetup(4|(7<<8))
    if (!pm1.setDcdcOutput(true)) return M5ToughPowerSetup(4|(8<<8))
    if (!pm1.setLdoOutput(true)) return M5ToughPowerSetup(4|(9<<8))
    if (!pm1.setLedEnableLevel(true)) return M5ToughPowerSetup(4|(10<<8))
    if (!pm1.setGpioMode(1,m5Pm1GpioOutput)) return M5ToughPowerSetup(4|(11<<8))
    if (!pm1.setGpioDrive(1,m5Pm1GpioPushPull)) return M5ToughPowerSetup(4|(12<<8))
    if (!pm1.setGpioPull(1,m5Pm1GpioPullUp)) return M5ToughPowerSetup(4|(13<<8))
    if (!pm1.setGpioOutput(1,true)) return M5ToughPowerSetup(4|(14<<8))
    if (!pm1.setGpioFunction(1,m5Pm1GpioFunctionIrq)) return M5ToughPowerSetup(4|(15<<8))
    if (!pm1.setGpioFunction(3,m5Pm1GpioFunctionGpio)) return M5ToughPowerSetup(4|(16<<8))
    if (!pm1.setGpioMode(3,m5Pm1GpioInput)) return M5ToughPowerSetup(4|(17<<8))
    M5ToughPowerSetup(1|(18<<8))
}
