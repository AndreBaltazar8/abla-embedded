import "./board_id.ab"
// Status1complete,2unsupported,3invalidhandle,4expanderwritefailure,
// 5chargeenablefailure,6currentfailure,7voltagefailure,8gaugebeginfailure.
// Highbyte counts acknowledged steps. Initialization is not transactional.
type M5C6PowerInit = int
fun M5C6PowerInit.status(): int = this & 255
fun M5C6PowerInit.appliedSteps(): int = (this>>>8)&255
fun M5C6PowerInit.valid(): bool = this.status() == 1
fun c6PowerRegister(step: int): int =
    if (step == 0) 3 else if (step == 1) 5 else if (step == 2) 7 else
    if (step == 3) 13 else if (step == 4) 11 else if (step == 5) 9 else 17
fun c6PowerValue(step: int): int =
    if (step == 0) 224 else if (step == 1) 128 else if (step == 2) 28 else
    if (step == 3 || step == 4) 195 else if (step == 5) 3 else 252
trusted fun M5BoardId.configureC6PowerOwned(ioe0: int,charger: int,gauge: int): M5C6PowerInit {
    val nesso=this == m5BoardArduinoNessoN1
    if (!nesso && this != m5BoardUnitC6L) return M5C6PowerInit(2)
    if (ioe0 <= 0 || ioe0 > 4294967295 || (nesso && (charger <= 0 || charger > 4294967295 || gauge <= 0 || gauge > 4294967295))) return M5C6PowerInit(3)
    var step=0
    while (step < 7) {
        if (!c6PowerWrite(ioe0,c6PowerRegister(step),c6PowerValue(step))) return M5C6PowerInit(4|(step<<8))
        step=step+1
    }
    if (!nesso) return M5C6PowerInit(1|(7<<8))
    if (!c6PowerChargeEnable(charger)) return M5C6PowerInit(5|(7<<8))
    if (!c6PowerChargeCurrent(charger)) return M5C6PowerInit(6|(8<<8))
    if (!c6PowerChargeVoltage(charger)) return M5C6PowerInit(7|(9<<8))
    if (!c6PowerGaugeBegin(gauge)) return M5C6PowerInit(8|(10<<8))
    M5C6PowerInit(1|(11<<8))
}
