// Owned device low32, kind bits32..33, status40..47. Status1 ready,
// 2unsupportedboard/index,3invalidbus,4allocationfailed,5beginfailed/released,
// 6releasefailed (handle retained),7closed. Scalar result is not copy-safe
// ownership: caller must discard aliases after successful release.
type M5ExpanderOpen = int
fun M5ExpanderOpen.status(): int = (this>>>40)&255
fun M5ExpanderOpen.kind(): int = (this>>>32)&3
fun M5ExpanderOpen.deviceHandle(): int = this & 4294967295
fun M5ExpanderOpen.ownsDevice(): bool = this.deviceHandle() != 0 &&
    (this.kind() == 1 || this.kind() == 2) && (this>>>48) == 0 && ((this>>>34)&63) == 0 &&
    (this.status() == 1 || this.status() == 6)
fun M5ExpanderOpen.ready(): bool = this.status() == 1 && this.ownsDevice()
