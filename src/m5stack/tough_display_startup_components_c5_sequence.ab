import "./tough_display_startup_sequence.ab"
import "./tough_display_power.ab"
import "./tough_backlight.ab"
import "../display/spi_control_c5_sequence.ab"
import "../display/spi_fill_c5_sequence.ab"
import "../display/mipi_programs.ab"
trusted fun toughDisplayStartupStep(stage: int,value: int,pmic: int,io: int,gate: PeripheralGate,owner: u32,rotation: int,brightness: int): int {
    val master=Esp32C5SpiMaster(value)
    if (stage == 1) return toughBacklightBeginOwned(M5Ioe1(io),0,true)
    if (stage == 2) return toughDisplayPowerResetOwned(M5Pm1(pmic),M5Ioe1(io),true)
    if (stage == 3) return esp32C5GpioConfigureOwned(26,true,true,false,false,0,true)
    if (stage == 4) return esp32C5LcdRunProgram(value,gate,owner,26,ili9342InitProgram(),72,1000)|0
    if (stage == 5) return esp32C5LcdConfigureRgb565(value,gate,owner,26,lcdGeometry(320,240),toughDisplayRotation(rotation),true,true,1000)|0
    if (stage == 6) {
        val view=toughDisplayView(rotation)
        return esp32C5LcdFillRect(master,gate,owner,26,view,0,0,view.width(),view.height(),Rgb565(0),1000)|0
    }
    if (stage == 7) return toughBacklightSetOwned(M5Ioe1(io),brightness,true)
    return 2
}
