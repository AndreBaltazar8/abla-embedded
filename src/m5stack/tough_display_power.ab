import "../io_expander/m5ioe1_device.ab"
import "../power/m5pm1_device.ab"
// Confirmed ToughC5 only, not a board probe. Both device owners must be ready,
// exclusive and on the board bus; LCD CS inactive, backlight blanked, all LCD
// and touch consumers stopped. This resets BOTH devices and discards events.
// Matches upstream M5GFX reset wiring/delays; no repeat of PM1 boot policy.
// Status1 complete,3 admission,4 I/O failure; completed writes at bits8..15.
// Failure retains partial rail/reset state: no hidden rollback or retry.
trusted fun toughDisplayPowerResetOwned(power: M5Pm1,io: M5Ioe1,exclusiveQuiesced: bool): int {
    if (!exclusiveQuiesced || (power|0) <= 0 || (power|0) > 0xffffffff ||
        (io|0) <= 0 || (io|0) > 0xffffffff) return 3
    val device=io.device()
    // Latches HIGH before push-pull/output: LCD reset has no board pull-up.
    if (!device.updateRegister8(5,24,24)) return 4
    if (!device.updateRegister8(19,24,0)) return 4|(1<<8)
    if (!device.updateRegister8(3,24,24)) return 4|(2<<8)
    if (!power.setLdoOutput(true)) return 4|(3<<8)
    peripheralDelayMilliseconds(10)
    if (!device.updateRegister8(5,8,0)) return 4|(4<<8)
    peripheralDelayMilliseconds(2)
    if (!device.updateRegister8(5,8,8)) return 4|(5<<8)
    peripheralDelayMilliseconds(10)
    // PM1 GPIO2 is touch reset; do not confuse it with IOE PIN4 LCD reset.
    if (!power.setGpioOutput(2,true)) return 4|(6<<8)
    if (!power.setGpioFunction(2,m5Pm1GpioFunctionGpio)) return 4|(7<<8)
    if (!power.setGpioMode(2,m5Pm1GpioOutput)) return 4|(8<<8)
    if (!power.setGpioDrive(2,m5Pm1GpioPushPull)) return 4|(9<<8)
    if (!power.setGpioOutput(2,false)) return 4|(10<<8)
    peripheralDelayMilliseconds(2)
    if (!power.setGpioOutput(2,true)) return 4|(11<<8)
    peripheralDelayMilliseconds(10)
    return 1|(12<<8)
}
