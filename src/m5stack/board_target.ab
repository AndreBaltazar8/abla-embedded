import "./board_id.ab"
// Host-SoC classification from M5Unified target branches. These are local
// framework tags, NOT ROM chip IDs or board IDs. No MMIO/probing/imported driver.
type M5BoardTarget=int
val m5TargetUnknown=M5BoardTarget(0)
val m5TargetEsp32=M5BoardTarget(1)
val m5TargetEsp32S3=M5BoardTarget(2)
val m5TargetEsp32C3=M5BoardTarget(3)
val m5TargetEsp32C6=M5BoardTarget(4)
val m5TargetEsp32C5=M5BoardTarget(5)
val m5TargetEsp32P4=M5BoardTarget(6)
val m5TargetEsp32H2=M5BoardTarget(7)
val m5TargetEsp32C61=M5BoardTarget(8)
fun M5BoardId.target(): M5BoardTarget {
    if ((this >= m5BoardStack && this <= m5BoardStation) || (this >= m5BoardAtomLite && this <= m5BoardStampPico) || this == m5BoardAtomMatrix || this == m5BoardAtomVoice) return m5TargetEsp32
    if (this == m5BoardStampC3 || this == m5BoardStampC3U) return m5TargetEsp32C3
    if (this == m5BoardArduinoNessoN1 || this == m5BoardUnitC6L || this == m5BoardNanoC6 || this == m5BoardStampC6) return m5TargetEsp32C6
    if (this == m5BoardToughC5 || this == m5BoardStampC5) return m5TargetEsp32C5
    if (this == m5BoardTab5 || this == m5BoardTab5X || this == m5BoardCoreP4X || this == m5BoardUnitPoEP4 || this == m5BoardStampP4 || this == m5BoardStampP4X) return m5TargetEsp32P4
    if (this == m5BoardNanoH2) return m5TargetEsp32H2
    if (this == m5BoardCoreMatrix) return m5TargetEsp32C61
    if ((this >= m5BoardStackCoreS3 && this <= m5BoardPaperS3) || this == m5BoardStampPLC || this == m5BoardCardputerADV ||
        (this >= m5BoardStickS3 && this <= m5BoardStopWatch) || this == m5BoardChainCaptain || this == m5BoardPaperDIY ||
        (this >= m5BoardStampS3 && this <= m5BoardCapsule) || (this >= m5BoardAtomS3RExt && this <= m5BoardDualKey) || this == m5BoardStampS3Bat || this == m5BoardStampS3Mini) return m5TargetEsp32S3
    // CoreMP135 is not an ESP host. External displays and framebuffer IDs
    // describe peripherals, not the CPU running this firmware. Fail closed.
    return m5TargetUnknown
}
fun M5BoardId.matchesTarget(target: M5BoardTarget): bool = target != m5TargetUnknown && this.target() == target
// Only an unknown observation uses fallback. An explicit/detected wrong-target
// board must not be silently replaced, even when fallback would be compatible.
fun m5SelectBoardForTarget(observed: M5BoardId,fallback: M5BoardId,target: M5BoardTarget): M5BoardId {
    val candidate=if (observed == m5BoardUnknown) fallback else observed
    return if (candidate.matchesTarget(target)) candidate else m5BoardUnknown
}
