// Requires prepared, initialized TX ring and exclusive codec/expander/I2S1/
// GDMA/pad ownership. Amplifier must be disabled on entry. Use preparation's
// actual sample rate. No allocation, pin/rail setup or handle release occurs.
// status1 success,2 invalid,3 busy,4 amplifier setup failed,5 DMA start failed,
// 6 shutdown failed. DMA status16bits at8, amplifier status/flags11bits at24.
type CoreS3SpeakerStreamResult = int
fun CoreS3SpeakerStreamResult.status(): int = this & 255
fun CoreS3SpeakerStreamResult.valid(): bool = this.status() == 1
fun CoreS3SpeakerStreamResult.dmaStatus(): int = (this >>> 8) & 65535
fun CoreS3SpeakerStreamResult.amplifierStatus(): int = (this >>> 24) & 2047
fun coreS3SpeakerResultDetail(result: CoreS3SpeakerResult): int =
    result.status() | (if (result.cleanupAttempted()) 256 else 0) |
    (if (result.amplifierDisableFailed()) 512 else 0) | (if (result.enableClearFailed()) 1024 else 0)

trusted fun cores3StartSpeakerStream(amplifier: Aw88298, expander: Aw9523,
    sampleRate: int, channel: int, descriptors: int, polls: int): CoreS3SpeakerStreamResult {
    if (!amplifier.valid() || !expander.valid() || aw88298RateIndex(sampleRate) < 0 ||
        channel < 0 || channel > 4 || polls < 1 || polls > 1000000 ||
        !esp32s3GdmaDescriptorValid(descriptors)) return CoreS3SpeakerStreamResult(2)
    if (!esp32s3GdmaParked(channel, true)) return CoreS3SpeakerStreamResult(3)
    val started = esp32s3I2sStartStream(1, true, channel, descriptors, polls)
    if (started != 1) return CoreS3SpeakerStreamResult(5 | (started << 8))
    val enabled = cores3SpeakerEnable(amplifier, expander, sampleRate)
    if (!enabled.valid()) {
        // Enable already attempted both amplifier/pin cleanup. Still stop DMA
        // even when either I2C cleanup failed; retain ALL outcomes for caller.
        val stopped = esp32s3I2sStopStream(1, true, channel, polls)
        return CoreS3SpeakerStreamResult(4 | (stopped << 8) | (coreS3SpeakerResultDetail(enabled) << 24))
    }
    CoreS3SpeakerStreamResult(1 | (1 << 8) | (1 << 24))
}

trusted fun cores3StopSpeakerStream(amplifier: Aw88298, expander: Aw9523,
    channel: int, polls: int): CoreS3SpeakerStreamResult {
    if (!amplifier.valid() || !expander.valid() || channel < 0 || channel > 4 || polls < 1 || polls > 1000000)
        return CoreS3SpeakerStreamResult(2)
    val disabled = cores3SpeakerDisable(amplifier, expander)
    val stopped = esp32s3I2sStopStream(1, true, channel, polls)
    CoreS3SpeakerStreamResult((if (disabled.valid() && stopped == 1) 1 else 6) |
        (stopped << 8) | (coreS3SpeakerResultDetail(disabled) << 24))
}
