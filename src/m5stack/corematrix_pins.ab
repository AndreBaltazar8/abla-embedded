import "./corematrix_profile.ab"
import "./pin_map_shared.ab"
import "./button_map_shared.ab"
// Select a platform Pin implementation before importing. Accessors never
// configure hardware. PM1 buttons remain non-GPIO sources, with Pin(-1).
fun M5CoreMatrix.portA(): M5PortPins = this.boardId().portA()
fun M5CoreMatrix.portB(): M5PortPins = this.boardId().portB()
fun M5CoreMatrix.portC(): M5PortPins = this.boardId().portC()
fun M5CoreMatrix.portD(): M5PortPins = this.boardId().portD()
fun M5CoreMatrix.portE(): M5PortPins = this.boardId().portE()
fun M5CoreMatrix.sdPins(): M5SdPinMap = this.boardId().sdPins()
fun M5CoreMatrix.buttonA(): Pin = this.boardId().buttonA()
fun M5CoreMatrix.buttonASource(): M5ButtonSource = this.boardId().buttonASource()
fun M5CoreMatrix.buttonB(): Pin = this.boardId().buttonB()
fun M5CoreMatrix.buttonBSource(): M5ButtonSource = this.boardId().buttonBSource()
fun M5CoreMatrix.buttonC(): Pin = this.boardId().buttonC()
fun M5CoreMatrix.buttonCSource(): M5ButtonSource = this.boardId().buttonCSource()
fun M5CoreMatrix.buttonExt(): Pin = this.boardId().buttonExt()
fun M5CoreMatrix.buttonExtSource(): M5ButtonSource = this.boardId().buttonExtSource()
fun M5CoreMatrix.buttonPower(): Pin = this.boardId().buttonPower()
fun M5CoreMatrix.buttonPowerSource(): M5ButtonSource = this.boardId().buttonPowerSource()
fun M5CoreMatrix.rgbLedPin(): Pin = this.boardId().rgbLedPin()
fun M5CoreMatrix.powerHoldPin(): Pin = this.boardId().powerHoldPin()
fun M5CoreMatrix.mBusPin(position: int): Pin = this.boardId().mBusPin(position)
fun M5CoreMatrix.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5CoreMatrix.internalI2cData(): Pin = pin(this.i2cPins().internalData())
fun M5CoreMatrix.externalI2cClock(): Pin = pin(this.i2cPins().externalClock())
fun M5CoreMatrix.externalI2cData(): Pin = pin(this.i2cPins().externalData())
