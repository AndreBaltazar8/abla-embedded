import "./control_bus_hardware_p4_sequence.ab"
import "../esp32/i2c_hardware_esp32p4.ab"
trusted fun m5P4HardwareProviderFree(): bool = p4HardwareLoad(20) == 0
trusted fun m5P4HardwareClockOpen(layout: int): int = esp32P4IomuxClockOpenOwned(layout)|0
trusted fun m5P4HardwareClockClose(clock: int): int = Esp32P4IomuxClockOwner(clock).closeOwned()|0
trusted fun m5P4HardwareSessionOpen(r: NativeBuffer,port: int,sda: int,scl: int,layout: int,sourceHz: u32): int =
    esp32p4I2cSessionOpenOwned(r,port,0,sourceHz,u32(100000),sda,scl,7,false,layout,true)
trusted fun m5P4HardwareSessionClose(r: NativeBuffer): int = esp32p4I2cSessionCloseOwned(r,true)
trusted fun m5P4HardwareBind(r: NativeBuffer,sourceHz: u32,cpuHz: u32): int = i2cHardwareBindOwned(nativeBufferAt(r.addressValue()+24,72),sourceHz,cpuHz,r)|0
trusted fun m5P4HardwareBusClose(bus: int): bool = I2cBus(bus).close()
trusted fun m5P4HardwareControlDeviceBus(r: NativeBuffer): I2cBus = I2cBus(m5P4HardwareControlBus(r))
