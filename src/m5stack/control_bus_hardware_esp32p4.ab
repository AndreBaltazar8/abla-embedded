import "./control_bus_hardware_p4_sequence.ab"
import "../esp32/i2c_hardware_esp32p4.ab"
import "../hal/m5stack.ab"
import "../i2c/device.ab"
import "../hal/m5stack_2.ab"
import "../esp32/gpio_clock_p4_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../esp32/i2c/session_p4_sequence.ab"
import "../hal/native_buffer.ab"
import "../esp32/sdk/nativebuffer_type.ab"
@export("m5P4HardwareProviderFree")
trusted fun m5P4HardwareProviderFreeHook(): bool = p4HardwareLoad(20) == 0
@export("m5P4HardwareClockOpen")
trusted fun m5P4HardwareClockOpenHook(layout: int): int = esp32P4IomuxClockOpenOwned(layout)|0
@export("m5P4HardwareClockClose")
trusted fun m5P4HardwareClockCloseHook(clock: int): int = Esp32P4IomuxClockOwner(clock).closeOwned()|0
@export("m5P4HardwareSessionOpen")
trusted fun m5P4HardwareSessionOpenHook(r: NativeBuffer,port: int,sda: int,scl: int,layout: int,sourceHz: u32): int =
    esp32p4I2cSessionOpenOwned(r,port,0,sourceHz,u32(100000),sda,scl,7,false,layout,true)
@export("m5P4HardwareSessionClose")
trusted fun m5P4HardwareSessionCloseHook(r: NativeBuffer): int = esp32p4I2cSessionCloseOwned(r,true)
@export("m5P4HardwareBind")
trusted fun m5P4HardwareBindHook(r: NativeBuffer,sourceHz: u32,cpuHz: u32): int = i2cHardwareBindOwned(nativeBufferAt(r.addressValue()+24,72),sourceHz,cpuHz,r)|0
@export("m5P4HardwareBusClose")
trusted fun m5P4HardwareBusCloseHook(bus: int): bool = I2cBus(bus).close()
trusted fun m5P4HardwareControlDeviceBus(r: NativeBuffer): I2cBus = I2cBus(m5P4HardwareControlBus(r))
