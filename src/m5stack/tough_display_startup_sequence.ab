import "./tough_display_view.ab"
import "../spi/buffer_gate.ab"
// Fresh confirmed ToughC5, pre-opened owned SPI master7/8/9/CS25, stable
// PLL160 source, ready PM1/IOE on HP bus. All display/touch/PWM users stopped;
// reset consumes touch events. Caller owns DC26 and accepts shared PWM1kHz.
// Borrowed children stay caller-owned; no allocation, hidden close or retry.
//32B record: tag0,status4,stage8,reserved12,full child result64@16,view64@24.
// Stage1blank2power/reset3DC4panelprogram5RGB5656clear7brightness8ready.
// Status1ready2invalid(return only)3partial; keep ALL children on any failure.
// View published only after brightness succeeds. Failed brightness is uncertain,
// not proof of darkness. Re-entering never repeats reset; explicit recovery
// and a fresh lifecycle are caller responsibilities.
trusted fun toughDisplayStartupOwned(record: NativeBuffer,master: int,bus: int,pmic: int,io: int,
    gate: PeripheralGate,owner: u32,rotation: int,brightness: int,exclusiveQuiesced: bool): int {
    if (!exclusiveQuiesced || rotation < 0 || rotation > 7 || brightness < 0 || brightness > 255 ||
        !record.hasAddressRange(0,32) || (record.addressValue()&3) != 0 ||
        !(record.addressValue()+32 <= 0x60000000 || record.addressValue() >= 0x60100000) ||
        !gate.word().valid() || !gate.bufferDisjoint(record,32) || !peripheralOwnerValid(owner) ||
        record.loadU32(0) != 0 || !toughDisplayStartupAdmission(master,bus,pmic,io,gate)) return 2
    record.storeU32(0,0x54445331);record.storeU32(4,3);record.storeU32(8,0);record.storeU32(12,0)
    record.storeU32(16,0);record.storeU32(20,0);record.storeU32(24,0);record.storeU32(28,0)
    var stage=1
    while (stage <= 7) {
        record.storeU32(8,stage)
        val child=toughDisplayStartupStep(stage,master,pmic,io,gate,owner,rotation,brightness)
        record.storeU32(16,child&0xffffffff);record.storeU32(20,child>>>32)
        // Raw I2C/DC results have status low8; SPI program/draw status is56.
        val success=if (stage >= 4 && stage <= 6) ((child>>>56)&7) == 1 && (child>>>59) == 0 else (child&255) == 1
        if (!success) return 3
        stage=stage+1
    }
    val view=toughDisplayView(rotation)
    record.storeU32(24,int(view&u64(0xffffffff)));record.storeU32(28,int(view>>u64(32)))
    record.storeU32(8,8);record.storeU32(4,1);return 1
}
