import "./display_spi_esp32s3.ab"
import "./cores3_display_spi_sequence.ab"

// After successful panel setup, before enabling the backlight. Bounded stack
// color blocks only; no full-frame allocation or assumed contents of GRAM.
trusted fun M5BoardId.clearCoreS3SpiDisplay(gate: PeripheralGate, owner: u32): SpiTransactionResult {
    if (!this.displaySharedDataCommand()) return SpiTransactionResult(3 << 32)
    val view = this.displayGeometry().view(this.displayRotation())
    this.spiDisplay().fillRect(gate,owner,view,0,0,view.width(),view.height(),rgb565Black)
}
