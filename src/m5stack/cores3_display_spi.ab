export import "../hal/m5boardid_cores3.ab"
import "./display_spi_esp32s3.ab"
import "./cores3_display_spi_sequence.ab"
import "../hal/spitransactionresult.ab"
import "../peripheralgate_type.ab"
import "../spi/spitransactionresult_type.ab"
import "../display/color.ab"
import "./display_map.ab"

// After successful panel setup, before enabling the backlight. Bounded stack
// color blocks only; no full-frame allocation or assumed contents of GRAM.
@exportLocal("abla_m5boardid_clearCoreS3SpiDisplay")
trusted fun m5BoardIdClearCoreS3SpiDisplayHook(recv: int, gate: PeripheralGate, owner: u32): SpiTransactionResult {
    val self = M5BoardId(recv)
    if (!self.displaySharedDataCommand()) return SpiTransactionResult(3 << 32)
    val view = self.displayGeometry().view(self.displayRotation())
    self.spiDisplay().fillRect(gate,owner,view,0,0,view.width(),view.height(),rgb565Black)
}

