// Runtime detection is intentionally opt-in. Import this file only when one
// firmware image must run on multiple M5Stack boards. Static board profiles do
// not import it and therefore retain no detector code or probe state.
import "./detect_logic.ab"

// Hardware adapters remain target-specific so a detector for another SoC can
// never be selected accidentally. Import detect_esp32s3.ab or
// detect_esp32c6.ab alongside this surface when runtime detection is required.
