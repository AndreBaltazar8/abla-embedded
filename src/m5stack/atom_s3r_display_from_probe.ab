import "./atom_s3r_display_session_sequence.ab"
// Consume a successful closed108B AtomS3R probe context. Caller retains its
// hardware ownership continuously; no intervening reset/reconfiguration by
// other clients. Original port/gate/token/ID cannot be replaced by arguments.
// Probe state6 means consumed, even when startup fails: no blind replay.
// Destination40B remains the cleanup obligation holder on admitted failure.
trusted fun atomS3RDisplayFromProbeOwned(r: NativeBuffer,probe: NativeBuffer,device: I2cDevice,
    rotation: int,brightness: int,polls: int,exclusive: bool): int {
    if (!exclusive || !atomS3RDisplayRecordRange(r) || !probe.hasAddressRange(0,108) || (probe.addressValue()&3) != 0 ||
        !(probe.addressValue()+108 <= 0x60000000 || probe.addressValue() >= 0x60100000) ||
        (r.addressValue() < probe.addressValue()+108 && probe.addressValue() < r.addressValue()+40) ||
        probe.loadU32(0) != 0x41535033 || probe.loadU32(4) != 2 || probe.loadU32(8) != 18 || probe.loadU32(28) != 1 ||
        probe.loadU32(36) != 3 || probe.loadU32(44) != 2 || probe.loadU32(104) != 2 ||
        (probe.loadU32(96) != 0 && probe.loadU32(96) != 3)) return 2
    val gate=peripheralGateAt(probe.loadU32(16))
    if (!gate.bufferDisjoint(probe,108)) return 2
    val panel=atomS3PanelFromId(m5BoardAtomS3R,probe.loadU32(24))
    if (!panel.valid()) return 2
    val wasFresh=r.loadU32(0) == 0
    if (!wasFresh) return 2
    probe.storeU32(4,6)
    val result=atomS3RDisplaySessionBeginOwned(r,panel,device,gate,u32(probe.loadU32(20)),probe.loadU32(12),rotation,brightness,true,true,polls)
    // Admission failure leaves both contexts reusable and touches no hardware.
    if (result == 2 && r.loadU32(0) == 0) probe.storeU32(4,2)
    return result
}
