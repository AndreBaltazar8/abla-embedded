@export("m5P4ReplayHandlesValid")
trusted fun m5P4ReplayHandlesValidHook(mic: int,speaker: int,io: int,tab5: bool): bool =
    Es7210(mic).valid() && (if (tab5) Es8388(speaker).valid() && Pi4Ioe5v6408(io).valid()
        else Es8311(speaker).valid() && M5Ioe1(io).valid())
