import "./detect_logic.ab"
import "./detect_s3_owned_state.ab"
import "./detect_s3_observations_sequence.ab"
import "../esp32/gpio_probe_logic.ab"
trusted fun m5ProbeI2cEsp32S3(
    sda: int,
    scl: int,
    firstAddress: int,
    secondAddress: int = -1,
    owned: NativeBuffer = NativeBuffer(0)
): int {
    val sdaState = m5S3OwnedCapture(owned,sda)
    val sclState = m5S3OwnedCapture(owned,scl)
    if (!gpioProbeStateValid(sdaState) || !gpioProbeStateValid(sclState)) {
        return -1
    }
    var observations = 0
    var okay = gpioProbeI2cStop(sda,scl)
    if (okay) {
        val first = gpioProbeI2cAddressChecked(sda, scl, firstAddress)
        if (first < 0) okay = false
        else if (first > 0) observations = observations | 1
    }
    if (okay && secondAddress >= 0) {
        val second = gpioProbeI2cAddressChecked(sda, scl, secondAddress)
        if (second < 0) okay = false
        else if (second > 0) observations = observations | 2
    }
    // Also recover the bus after a partially completed failed transaction.
    if (!gpioProbeI2cStop(sda, scl)) okay=false
    if (!sdaState.restore(sda)) okay=false
    if (!sclState.restore(scl)) okay=false
    if (okay) observations else -2
}

trusted fun m5DetectEsp32S3Qfn56Hardware(owned: NativeBuffer = NativeBuffer(0)): M5BoardId {
    val state4 = m5S3OwnedCapture(owned,4)
    val state8 = m5S3OwnedCapture(owned,8)
    val state10 = m5S3OwnedCapture(owned,10)
    val state12 = m5S3OwnedCapture(owned,12)
    val state38 = m5S3OwnedCapture(owned,38)
    val captured = gpioProbeStateValid(state4) &&
        gpioProbeStateValid(state8) && gpioProbeStateValid(state10) &&
        gpioProbeStateValid(state12) && gpioProbeStateValid(state38)
    if (!captured) return m5BoardUnknown
    var observations = -1
    if (captured && gpioProbeInput(4, 1) && gpioProbeInput(12, 1) &&
        gpioProbeInput(38, 1) && gpioProbeInput(8, 1) &&
        gpioProbeInput(10, 1) && gpioProbeInput(4, 0) &&
        gpioProbeInput(12, 0) && gpioProbeInput(38, 0)) {
        observations = m5DetectS3ReadSignature()
    }
    var restored=true
    if (!state4.restore(4)) restored=false
    if (!state8.restore(8)) restored=false
    if (!state10.restore(10)) restored=false
    if (!state12.restore(12)) restored=false
    if (!state38.restore(38)) restored=false
    if (!restored || observations < 0) return m5BoardUnknown

    var board = m5DetectEsp32S3Qfn56(m5BoardUnknown, observations)
    if (board == m5BoardCapsule) {
        val sdaState = m5S3OwnedCapture(owned,13)
        val sclState = m5S3OwnedCapture(owned,15)
        if (!gpioProbeStateValid(sdaState) || !gpioProbeStateValid(sclState)) return m5BoardUnknown
        var okay=gpioProbeI2cStop(13,15)
        if (!sdaState.restore(13)) okay=false
        if (!sclState.restore(15)) okay=false
        if (!okay) return m5BoardUnknown
    }
    if (board == m5BoardUnknown) {
        gpioProbeDelayMicroseconds(50000)
        val probed=m5ProbeI2cEsp32S3(45,48,80,-1,owned)
        if (probed < 0) return m5BoardUnknown
        val powerHub = probed > 0
        board = m5DetectEsp32S3Qfn56(
            m5BoardUnknown, observations, powerHub
        )
    }
    board
}

trusted fun m5DetectEsp32S3PicoHardware(owned: NativeBuffer = NativeBuffer(0)): M5BoardId {
    // Onboard devices need one power-stabilization wait, not one per address.
    gpioProbeDelayMicroseconds(50000)
    val internal = m5ProbeI2cEsp32S3(45, 0, 104, 105,owned)
    if (internal < 0) return m5BoardUnknown
    val bmi270Present = internal > 0
    var voiceCodecPresent = false
    var stampBatteryControllerPresent = false
    if (!bmi270Present) {
        val probed=m5ProbeI2cEsp32S3(45,0,24,-1,owned)
        if (probed < 0) return m5BoardUnknown
        voiceCodecPresent = probed > 0
    }
    if (!bmi270Present && !voiceCodecPresent) {
        val probed=m5ProbeI2cEsp32S3(48,47,110,-1,owned)
        if (probed < 0) return m5BoardUnknown
        stampBatteryControllerPresent = probed > 0
    }
    var board = m5DetectEsp32S3Pico(
        m5BoardUnknown, bmi270Present, voiceCodecPresent,
        stampBatteryControllerPresent
    )
    if (board == m5BoardAtomS3RExt) {
        val camera=m5ProbeEsp32S3CameraChecked(owned)
        if (camera < 0) return m5BoardUnknown
        if (camera == 1) board = m5BoardAtomS3RCam
    }
    board
}

// The AtomS3R camera needs XCLK before it will acknowledge. This mirrors
// M5Unified's two-address GPIO transaction, but captures and restores GPIO18
// too so detection leaves all four pins exactly as it found them.
trusted fun m5ProbeEsp32S3Camera(): bool = m5ProbeEsp32S3CameraChecked() == 1
// Checked0absent/1present/-1failed, so a failed probe cannot imply Ext board.
trusted fun m5ProbeEsp32S3CameraChecked(owned: NativeBuffer = NativeBuffer(0)): int {
    val sclState = m5S3OwnedCapture(owned,9)
    val sdaState = m5S3OwnedCapture(owned,12)
    val powerState = m5S3OwnedCapture(owned,18)
    val clockState = m5S3OwnedCapture(owned,21)
    val captured = gpioProbeStateValid(sclState) &&
        gpioProbeStateValid(sdaState) && gpioProbeStateValid(powerState) &&
        gpioProbeStateValid(clockState)
    var detected = false
    if (!captured) return -1
    var okay=true
    if (captured) {
        val configured = gpio_set_level(18, 0) == 0 &&
            gpio_set_direction(18, 2) == 0 &&
            gpio_set_level(9, 0) == 0 &&
            gpio_set_direction(9, 2) == 0 &&
            gpio_set_level(12, 0) == 0 &&
            gpio_set_direction(12, 2) == 0 &&
            gpio_set_level(21, 0) == 0 &&
            gpio_set_direction(21, 2) == 0 &&
            gpioProbeEsp32S3FastHigh(9) &&
            gpioProbeEsp32S3FastHigh(21) &&
            gpioProbeEsp32S3FastHigh(12)
        if (configured) {
            gpioProbeEsp32S3ClockCycles(21, 1769472)
            val ov3660Nack = m5ProbeEsp32S3CameraAddressChecked(60)
            val gc0308Nack = if (ov3660Nack >= 0) m5ProbeEsp32S3CameraAddressChecked(33) else -1
            // Exactly one expected address acknowledging is M5Unified's
            // established camera-module signature.
            okay=ov3660Nack >= 0 && gc0308Nack >= 0
            detected = okay && ov3660Nack != gc0308Nack
        } else okay=false
    }
    if (!sclState.restore(9)) okay=false
    if (!sdaState.restore(12)) okay=false
    if (!powerState.restore(18)) okay=false
    if (!clockState.restore(21)) okay=false
    if (!okay) return -1
    return if (detected) 1 else 0
}

trusted fun m5ProbeEsp32S3CameraAddress(address: int): bool = m5ProbeEsp32S3CameraAddressChecked(address) != 0
trusted fun m5ProbeEsp32S3CameraAddressChecked(address: int): int {
    if (address < 0 || address > 127) return -1
    var shiftedAddress = address << 1
    if (!gpioProbeEsp32S3FastLow(12)) return -1
    var nack = true
    var cycle = 0
    while (cycle < 20) {
        var half = 0
        while (half < 2) {
            gpioProbeEsp32S3ClockCycles(21, 8)
            val okay=if ((cycle & 1) != 0) gpioProbeEsp32S3FastHigh(9) else gpioProbeEsp32S3FastLow(9)
            if (!okay) return -1
            half = half + 1
        }
        if ((cycle & 1) != 0) {
            if (cycle == 17) nack = gpioProbeRead(12)
        } else {
            if ((shiftedAddress & 128) != 0) {
                if (!gpioProbeEsp32S3FastHigh(12)) return -1
            } else if (!gpioProbeEsp32S3FastLow(12)) return -1
            shiftedAddress = shiftedAddress << 1
            if (cycle >= 16) {
                if (gpio_set_direction(12, if (cycle == 16) 1 else 2) != 0) return -1
            }
        }
        cycle = cycle + 1
    }
    if (!gpioProbeEsp32S3FastHigh(12)) return -1
    return if (nack) 1 else 0
}

// Explicit package avoids reading identity registers in the reusable sequence.
// Fresh zeroed record, or a prior fully closed record. Failed cleanup cannot
// be overwritten by a new detection. current board selection performs no MMIO.
trusted fun m5S3OwnedDetectBegin(r: NativeBuffer,current: M5BoardId,package: int,exclusive: bool): int {
    if (!r.hasAddressRange(0,88) || (r.addressValue()&3) != 0) return 0
    if (r.loadU32(0) != 0 && (!m5S3OwnedDetectValid(r) || (r.loadU32(4) != 2 && r.loadU32(4) != 4))) return 0
    if (current == m5BoardUnknown && !exclusive) return 0
    var offset=4
    while (offset < 88) { r.storeU32(offset,0); offset=offset+4 }
    r.storeU32(0,0x4D533331); r.storeU32(4,3)
    val board=if (current != m5BoardUnknown) current else if (package == 0) m5DetectEsp32S3Qfn56Hardware(r)
        else if (package == 1) m5DetectEsp32S3PicoHardware(r) else m5BoardUnknown
    r.storeU32(20,board|0)
    // Unknown includes failed inner transactions/restores, never publish it as
    // evidence of successful board identification.
    r.storeU32(24,if (board != m5BoardUnknown) 1 else 0)
    return m5S3OwnedDetectCleanup(r,true)
}
