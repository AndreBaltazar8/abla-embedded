import "./imu_owner.ab"
import "./imu_probe_prepared_sequence.ab"
// Provider must implement explicit prepareProbeStatus. Select this operation
// only with exclusive single-master ownership; ordinary open is unchanged.
trusted fun m5ProbePrepare(bus: int): int = I2cBus(bus).prepareProbeStatus()
import "./imu_owner_prepared_sequence.ab"
trusted fun M5ImuOwner.openPrepared(bus: I2cBus): int = this.openPreparedOwned(bus|0)
