import "./paper_s3_wake_release_sequence.ab"
// Allocation-free scheduled outer wait. One scalar: state3,failures2@3,
// reserved3,last release result8@8,touch handle32@16. No device ownership.
// States1new,2pending,3released,4communication-limit. Terminal states are NOT
// permission to assume the pin is high: state4 preserves the actual failure.
// Caller schedules retryDelayMilliseconds AFTER each pending update returns,
// not from its start; each update performs at most one eight-attempt round.
// Before quiescing clocks/I2C, run a final paperS3ReleaseWakePinOwned round
// even after terminal state. The prepared sleep runner rechecks GPIO via MMIO.
type PaperS3WakeWait=int
fun paperS3WakeWait(touch: int): PaperS3WakeWait = PaperS3WakeWait(if (touch > 0 && touch <= 4294967295) (touch<<16)|1 else 0)
fun PaperS3WakeWait.status(): int = this&7
fun PaperS3WakeWait.failures(): int = (this>>>3)&3
fun PaperS3WakeWait.touch(): int = (this>>>16)&4294967295
fun PaperS3WakeWait.lastRelease(): PaperS3WakeRelease = PaperS3WakeRelease((this>>>8)&255)
fun PaperS3WakeWait.valid(): bool {
    if ((this&(~0xffffffffff1f)) != 0 || this.touch() == 0) return false
    val state=this.status();val last=this.lastRelease()
    if (state == 1) return this.failures() == 0 && (last|0) == 0
    if (!last.valid() || last.attempts() > 8) return false
    if (state == 2) return !last.released() && this.failures() < 3
    if (state == 3) return last.released() && this.failures() == 0
    return state == 4 && !last.released() && !last.communicated() && this.failures() == 3
}
fun PaperS3WakeWait.retryDelayMilliseconds(): int = if (this.valid() && this.status() == 2) 10 else 0
trusted fun PaperS3WakeWait.updateOwned(scratch: NativeBuffer,exclusive: bool): PaperS3WakeWait {
    // Invalid input returns0 without consuming a report. Keep the previous
    // software token if retrying after a caller argument/ownership mistake.
    if (!this.valid() || !exclusive || !scratch.hasAddressRange(0,40)) return PaperS3WakeWait(0)
    if (this.status() == 3 || this.status() == 4) return this
    val last=paperS3ReleaseWakePinOwned(this.touch(),scratch,true)
    if (!last.valid()) return PaperS3WakeWait(0)
    val failures=if (last.released() || last.communicated()) 0 else this.failures()+1
    val state=if (last.released()) 3 else if (failures == 3) 4 else 2
    return PaperS3WakeWait((this.touch()<<16)|((last|0)<<8)|(failures<<3)|state)
}
