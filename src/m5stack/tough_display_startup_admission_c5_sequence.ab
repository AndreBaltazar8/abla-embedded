import "../esp32/spi/transaction_c5_sequence.ab"
trusted fun toughDisplayStartupAdmission(value: int,bus: int,pmic: int,io: int,gate: PeripheralGate): bool {
    val master=Esp32C5SpiMaster(value)
    // Avoid PMIC/reset side effects if existing GPIO clocks or SPI error
    // evidence already make this startup impossible. Never clear errors here.
    if ((c5GpioRead(0x600960f0)&u32(3)) != u32(1) ||
        (c5GpioRead(0x600960f4)&u32(0x400000)) == u32(0) ||
        ((c5GpioRead(0x600960f4)>>u32(20))&u32(3)) == u32(3) ||
        (c5GpioRead(0x60091df8)&u32(1)) == u32(0)) return false
    if (!master.ready() || master.pins().pinAt(0) != 9 || master.pins().pinAt(1) != 7 ||
        master.pins().pinAt(2) != 8 || master.pins().pinAt(3) != 25 ||
        !c5SpiGateValid(gate) || gate.word().compareExchange(u32(0),u32(0)) != u32(0) || !c5SpiMasterDataReady(master,true)) return false
    if ((c5SpiRead(0x6008103c)&u32(0x60003)) != u32(0)) return false
    // Exact intended 40MHz mode0/MSB configuration: PLL160 / root2 / cycles2.
    if ((c5SpiRead(0x600960c8)&u32(0x7ff000)) != u32(0x501000) ||
        (c5SpiRead(0x6008100c)&u32(0x803fffff)) != u32(0x1001) ||
        (c5SpiRead(0x60081020)&u32(1<<29)) != u32(0) ||
        (c5SpiRead(0x60081010)&u32(512)) != u32(0) ||
        (c5SpiRead(0x60081008)&u32(0x07800000)) != u32(0)) return false
    // GPIO26 fresh/released and HP-owned before any PMIC or PWM change.
    if ((c5GpioRead(0x60091034)&u32(1<<26)) != u32(0) ||
        (c5GpioRead(0x600b102c)&u32(1<<26)) != u32(0)) return false
    return toughDisplayStartupDeviceMatches(bus,pmic,110) && toughDisplayStartupDeviceMatches(bus,io,79)
}
