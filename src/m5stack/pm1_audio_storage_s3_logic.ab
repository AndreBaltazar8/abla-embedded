import "../esp32/i2c/facade_buffer_s3_logic.ab"
import "../esp32/i2c/device_s3_logic.ab"
// Descriptor is a resolved live slot, not the public32-bit codec handle.
fun pm1AudioCodecDescriptorMatches(descriptor: int,bus: int): bool =
    esp32S3I2cDeviceKeyMatchesBus(descriptor,bus) &&
    esp32S3I2cDeviceKeyAddress(descriptor) == 24 && esp32S3I2cDeviceKeyFrequency(descriptor) == 100000
// Protect borrowed control and provider bookkeeping from session writes/DMA.
// This checks address spans only; DMA-accessibility/layout is checked by the
// existing stream constructor. Caller owns every extent and its lifetime.
fun pm1AudioBufferSafe(buffer: NativeBuffer,length: int,control: NativeBuffer,state0: int,state1: int,pool: int): bool {
    if (!control.hasAddressRange(0,72) ||
        !esp32S3I2cFacadeBufferSafe(buffer,length,state0,state1,pool)) return false
    return length == 0 || buffer.addressValue()+length <= control.addressValue() ||
        buffer.addressValue() >= control.addressValue()+72
}
fun pm1AudioStreamStorageSafe(record: NativeBuffer,recordBytes: int,desc: int,count: int,
    payload: int,bytes: int,control: NativeBuffer,state0: int,state1: int,pool: int): bool {
    if ((recordBytes != 132 && recordBytes != 136) || count < 2 || count > 178956970 ||
        bytes < 4 || bytes > 4092 || (bytes&3) != 0 || count*bytes > 2147483647 ||
        desc <= 0 || desc > 4294967295 || payload <= 0 || payload > 4294967295) return false
    return pm1AudioBufferSafe(record,recordBytes,control,state0,state1,pool) &&
        pm1AudioBufferSafe(nativeBufferAt(desc,count*12),count*12,control,state0,state1,pool) &&
        pm1AudioBufferSafe(nativeBufferAt(payload,count*bytes),count*bytes,control,state0,state1,pool)
}
