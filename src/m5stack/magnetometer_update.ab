import "./magnetometer_types.ab"
import "../imu/magnetometer_snapshot.ab"
trusted fun M5Magnetometers.updateSnapshot(snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int {
    val kind=this.selected()
    if (kind < 1 || kind > 2 || this.handle(kind) == 0) return -1
    if (!this.disjoint(snapshot.buffer(),44) || !this.disjoint(scratch,if (kind == 1) 6 else 8)) return -1
    if (kind == 1) snapshot.updateBmm150(I2cDevice(this.handle(kind)),scratch,micros)
    else snapshot.updateAk8963(I2cDevice(this.handle(kind)),scratch,micros)
}
