import "./tough_display_owner_c5_sequence.ab"
import "./tough_touch_sequence.ab"
import "./tough_touch_display_view.ab"
// Interactive display read; unlike raw readTouchOwned, asleep/uncertain or
// quiesced display sessions are rejected. Touch remains independently owned.
// Failure returns negative, never a synthetic release. Snapshot content is
// usable only with the successful returned count; coordinates remain raw.
trusted fun M5ToughPowerOwner.readDisplayTouchOwned(session: NativeBuffer,touch: TouchControllerOpen,
    snapshot: NativeBuffer,previous: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !this.displaySessionMatches(session) || session.loadU32(4) != 1 ||
        !snapshot.hasAddressRange(0,11) || !previous.hasAddressRange(0,11)) return -1
    val a=snapshot.addressValue();val b=previous.addressValue();val child=session.addressValue()
    val gate=peripheralGateAt(session.loadU32(32))
    if (!(a+11 <= 0x60000000 || a >= 0x60100000) || !(b+11 <= 0x60000000 || b >= 0x60100000) ||
        (a < child+72 && child < a+11) || (b < child+72 && child < b+11) ||
        !gate.bufferDisjoint(snapshot,11) || !gate.bufferDisjoint(previous,11)) return -1
    return this.readTouchOwned(toughDisplaySessionWord64(session,16),touch,snapshot,previous,true)
}
trusted fun toughDisplayTouchSnapshotPoint(session: NativeBuffer,snapshot: NativeBuffer,count: int,index: int): TouchPoint {
    val view=toughDisplaySessionView(session)
    if (view.width() == 0 || !snapshot.hasAddressRange(0,11) ||
        !(snapshot.addressValue()+11 <= 0x60000000 || snapshot.addressValue() >= 0x60100000)) return TouchPoint(0)
    return toughDisplayTouchPoint(chsc6540Point(snapshot,count,index),view)
}
