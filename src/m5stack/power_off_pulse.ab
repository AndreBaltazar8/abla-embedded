import "./power_off_pulse_sequence.ab"
import "../io_expander/pi4ioe5v6408_device.ab"
import "./pin_map_shared.ab"
@inline
trusted fun m5PowerOffPulseWrite(handle: int,pin: int,high: bool): bool {
    if (handle != 0) return Pi4Ioe5v6408(handle).digitalWrite(pin,high)
    Pin(pin).write(high)
    true
}
// Caller selects the actual board's GPIO backend and has already configured
// its power-hold pin as output (including releasing any RTC/pad holds).
// GPIO success means issued MMIO, not acknowledgement from the power circuit.
trusted fun M5BoardId.beginPowerHoldOffPulse(context: NativeBuffer,now: u32,releasedExclusive: bool): int {
    val hold=this.powerHoldPin()
    if (!hold.valid()) return 3
    m5PowerOffPulseBeginOwned(context,0,hold.number(),now,releasedExclusive)
}
// Pin must already be initialized as the board power-off output. No sleep,
// wake-source changes, device closing or fallback rail switching here.
