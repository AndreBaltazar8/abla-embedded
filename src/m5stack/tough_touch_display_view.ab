import "./tough_display_view.ab"
import "../touch/transform.ab"
// Upstream ToughC5 raw range320x240, touch offset_rotation0. Panel's internal
// rotation includes offset3. Resolve only an exact supported panel view,
// rejecting arbitrary dimensions/offsets rather than guessing calibration.
fun toughDisplayTouchPoint(point: TouchPoint,view: LcdView): TouchPoint {
    var rotation=0
    while (rotation < 8) {
        val candidate=toughDisplayView(rotation)
        if (int(candidate&u64(0xffffffff)) == int(view&u64(0xffffffff)) &&
            int(candidate>>u64(32)) == int(view>>u64(32))) return point.forLcdRotation(320,240,toughDisplayRotation(rotation))
        rotation=rotation+1
    }
    return TouchPoint(0)
}
