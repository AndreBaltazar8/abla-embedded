import "./touch_profile.ab"
import "../esp32/i2c/device_s3_logic.ab"
// Explicit silicon admission: Nesso also uses FT5x06 but is C6, Core2 is
// classic ESP32. A controller match alone never authorizes S3 pad registers.
fun M5BoardId.ft5x06S3PowerSupported(): bool = this == m5BoardStackCoreS3 ||
    this == m5BoardStackCoreS3SE || this == m5BoardDial || this == m5BoardPaperMono
fun M5BoardId.ft5x06S3PowerMatches(bus: int,descriptor: int,phase: int,
    generation: int,sda: int,scl: int): bool {
    val profile=this.touchProfile()
    return this.ft5x06S3PowerSupported() && phase == 1 &&
        esp32S3I2cDeviceKeyMatchesBus(descriptor,bus) &&
        esp32S3I2cBusKeyPort(bus) == profile.port() &&
        esp32S3I2cBusKeyGeneration(bus) == generation &&
        sda == profile.sdaNumber() && scl == profile.sclNumber() &&
        esp32S3I2cDeviceKeyAddress(descriptor) == profile.address() &&
        esp32S3I2cDeviceKeyFrequency(descriptor) == profile.frequency()
}
