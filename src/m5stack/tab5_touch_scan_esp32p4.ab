import "./tab5_touch_scan_sequence.ab"
import "./tab5_panel_detect_esp32p4.ab"
trusted fun tab5TouchScanBusCurrent(bus: int): bool = bus > 0 && bus <= 16777215 && I2cBus(bus).current()
// ST helper defaults400kHz, but Tab5 readiness/software provider uses100kHz.
trusted fun tab5TouchScanOpen(bus: int): int = st7123(I2cBus(bus),85,100000)|0
trusted fun tab5TouchScanClose(handle: int): bool = St7123(handle).close()
trusted fun tab5TouchScanWait(board: M5BoardId,bus: int,handle: int,attempts: int): M5Tab5TouchProbe =
    board.waitTab5TouchOwned(bus,handle,attempts)
