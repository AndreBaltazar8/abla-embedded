import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
// Fresh exclusive stopped board: power/reset -> SPI -> BUSY input -> panel.
// Shared touch/SD users quiescent. Low8:1controllerready2admission3power4SPI
// 5BUSYpad6panel; detailed operation result above8. Retain ownership onfailure.
// Controller ready is NOT refreshed glass; history is unknown, RAMface even.
trusted fun paperMonoPanelStartupOwned(control: int,gate: PeripheralGate,owner: u32,polls: int,exclusive: bool): int {
    if (!exclusive || owner == u32(0) || polls < 1 || polls > 10000 || !paperMonoPanelAdmission(control,gate)) return 2
    val power=paperMonoPanelPower(control)
    if ((power&255) != 1) return 3|(power<<8)
    val spi=paperMonoPanelSpi(gate,owner)
    if (!spi.valid()) return 4|((spi|0)<<8)
    val busy=paperMonoPanelBusy()
    if (busy != 1) return 5|(busy<<8)
    val panel=paperMonoPanelInitialize(gate,owner,polls)
    if (!panel.valid()) return 6|((panel|0)<<8)
    return 1
}
