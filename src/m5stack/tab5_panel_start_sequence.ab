import "./tab5_panel_detect_sequence.ab"
import "../esp32/dsi_short_p4_sequence.ab"
// Identification + command initialization on a caller-owned ready DSI host.
// No video/DMA is enabled here. Preserve power/host ownership on any failure;
// queued packets or a partially initialized panel require explicit recovery.
// Scratch32bytes: first16 probe workspace/last probe transport,
// 16..23 full Tab5PanelDetection,24..31 last initialization transport.
// Caller provides storage not overlapping any live owner/provider records.
// Low4status:1initialized,2invalid,3identification failed,4command failure.
// Bits4..7panel,8..59 complete DsiCommandResult when initialization ran.
type Tab5PanelStart = int
fun Tab5PanelStart.status(): int = this&15
fun Tab5PanelStart.panel(): int = (this>>>4)&15
fun Tab5PanelStart.transport(): DsiCommandResult = DsiCommandResult(this>>>8)
fun Tab5PanelStart.ready(): bool = this.status() == 1 && this.panel() >= 1 && this.panel() <= 3 && this.transport().hostComplete()
fun Tab5PanelStart.laneKbps(): int = if (!this.ready()) 0 else if (this.panel() == 2) 900000 else 1040000
trusted fun M5Tab5TouchProbe.startTab5PanelOwned(channel: int,scratch: NativeBuffer,polls: int): Tab5PanelStart {
    if (this.tab5LaneKbps() == 0 || channel < 0 || channel > 3 || polls < 1 || polls > 1000000 ||
        !scratch.hasAddressRange(0,32)) return Tab5PanelStart(2)
    // Clear output records only after full preflight; no stale success report.
    scratch.storeU32(16,0); scratch.storeU32(20,0)
    scratch.storeU32(24,0); scratch.storeU32(28,0)
    val detected=this.identifyTab5PanelOwned(channel,nativeBufferAt(scratch.addressValue(),16),polls)
    scratch.storeU32(16,detected&4294967295); scratch.storeU32(20,detected>>>32)
    if (!detected.selected()) return Tab5PanelStart(3)
    val result=tab5PanelStartCommands(detected.panel(),channel,polls)
    scratch.storeU32(24,result&4294967295); scratch.storeU32(28,result>>>32)
    return Tab5PanelStart((if (result.hostComplete()) 1 else 4)|(detected.panel()<<4)|(result<<8))
}
