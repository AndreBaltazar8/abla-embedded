import "./toughc5_wake_release_sequence.ab"
import "./toughc5_wake_clear.ab"
import "../esp32/gpio/c5_wake.ab"
import "../esp32/peripheral_delay_esp32c5.ab"
import "../hal/delay.ab"
import "../hal/m5stack.ab"
@export("toughC5WakePinReleased")
trusted fun toughC5WakePinReleasedHook(): bool = esp32C5Gpio4WakeLevelOwned()
@export("toughC5WakeClear")
trusted fun toughC5WakeClearHook(pmic: int,touch: int,scratch: NativeBuffer): int = toughC5ShutdownClearSources(pmic,touch,scratch)
@export("toughC5WakeDelayMilliseconds")
trusted fun toughC5WakeDelayMillisecondsHook(milliseconds: int): void = peripheralDelayMilliseconds(milliseconds)
