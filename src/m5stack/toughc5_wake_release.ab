import "./toughc5_wake_release_sequence.ab"
import "./toughc5_wake_clear.ab"
import "../esp32/gpio/c5_wake.ab"
import "../esp32/peripheral_delay_esp32c5.ab"
trusted fun toughC5WakePinReleased(): bool = esp32C5Gpio4WakeLevelOwned()
trusted fun toughC5WakeClear(pmic: int,touch: int,scratch: NativeBuffer): int = toughC5ShutdownClearSources(pmic,touch,scratch)
trusted fun toughC5WakeDelayMilliseconds(milliseconds: int): void = peripheralDelayMilliseconds(milliseconds)
