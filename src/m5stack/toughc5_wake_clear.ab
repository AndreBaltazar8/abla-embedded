import "../power/m5pm1_device.ab"
import "../touch/chsc6540_device.ab"
// Discard the originating touch report before PM1 WAKE_SRC and every IRQ
// register. RTC configuration remains unchanged; sustained sources may stay
// asserted. 0 invalid; bit8 PM1 operation accepted, bits0..3 acknowledged
// PM1 writes, bit9 complete touch capture. None of these proves IRQ is HIGH.
// All buffers/handles admitted before I/O. Scratch22B borrowed, not retained.
trusted fun toughC5ShutdownClearSources(pmic: int,touch: int,scratch: NativeBuffer): int {
    if (pmic <= 0 || pmic > 4294967295 || touch <= 0 || touch > 4294967295 || !scratch.hasAddressRange(0,22)) return 0
    val captured=chsc6540ReadStableOwned(touch,nativeBufferAt(scratch.addressValue(),11),nativeBufferAt(scratch.addressValue()+11,11))
    val cleared=M5Pm1(pmic).clearWakeInterruptChecked()
    cleared|(if (captured >= 0) 512 else 0)
}
