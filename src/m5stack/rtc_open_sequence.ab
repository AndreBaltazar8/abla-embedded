import "./rtc_open_types.ab"
trusted fun m5RtcOpenOwned(bus: int,board: M5BoardId): M5RtcOpenResult {
    val rtc=m5RtcOpenAllocate(bus,board)
    if (rtc == 0) return M5RtcOpenResult(2<<40)
    if (m5RtcOpenBegin(rtc)) return M5RtcOpenResult((1<<40)|rtc)
    if (m5RtcOpenClose(rtc)) return M5RtcOpenResult(3<<40)
    M5RtcOpenResult((4<<40)|rtc)
}
