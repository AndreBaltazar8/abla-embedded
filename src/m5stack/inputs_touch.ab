import "./inputs_touch_sequence.ab"
import "./inputs.ab"
import "./touch_poll.ab"
trusted fun M5Inputs.pollWithChsc6540(board: M5BoardId,touch: Chsc6540,
    tracker: TouchTracker,snapshot: NativeBuffer,raw: NativeBuffer,ratio: int,
    pi4: Pi4Ioe5v6408,pmic: M5PmicOpen,powerHub: I2cDevice,now: int): bool =
    this.pollWithTouchOwned(board,3,touch | 0,tracker,snapshot,raw,ratio,pi4 | 0,pmic,powerHub | 0,now)
trusted fun m5InputsPollAccepted(owner: M5Inputs,board: M5BoardId,pi4: int,pmic: M5PmicOpen,
    powerHub: int,touch: M5TouchButtons,now: int): bool =
    owner.poll(board,Pi4Ioe5v6408(pi4),pmic,I2cDevice(powerHub),touch,now)
trusted fun M5Inputs.pollWithFt5x06(board: M5BoardId,touch: Ft5x06,
    tracker: TouchTracker,snapshot: NativeBuffer,raw: NativeBuffer,ratio: int,
    pi4: Pi4Ioe5v6408,pmic: M5PmicOpen,powerHub: I2cDevice,now: int): bool =
    this.pollWithTouchOwned(board,1,touch | 0,tracker,snapshot,raw,ratio,pi4 | 0,pmic,powerHub | 0,now)
trusted fun M5Inputs.pollWithGt911(board: M5BoardId,touch: Gt911,
    tracker: TouchTracker,snapshot: NativeBuffer,raw: NativeBuffer,ratio: int,
    pi4: Pi4Ioe5v6408,pmic: M5PmicOpen,powerHub: I2cDevice,now: int): bool =
    this.pollWithTouchOwned(board,2,touch | 0,tracker,snapshot,raw,ratio,pi4 | 0,pmic,powerHub | 0,now)
