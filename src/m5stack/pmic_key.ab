import "./pmic_key_sequence.ab"
import "../power/axp192_device.ab"
import "../power/axp2101_device.ab"
import "../power/m5pm1_device.ab"
trusted fun m5PmicKeyAxp(handle: int,kind: int): int =
    if (kind == 2) Axp192(handle).powerKeyPressChecked() | 0 else Axp2101(handle).powerKeyPressChecked() | 0
trusted fun m5PmicKeyPm1(handle: int): int = M5Pm1(handle).readPowerKeyEvent() | 0
// Destructive read-and-acknowledge. Caller serializes IRQ consumption and
// provides polling cadence; do not feed these events to a level debouncer.
trusted fun M5PmicOpen.readKey(): M5PowerKeyRead = this.readKeyOwned()
