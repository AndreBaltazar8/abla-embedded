import "./board_id.ab"
import "../power/m5pm1_device.ab"
// Upstream StampS3Bat selector: PM1G3 low for requests>=650, high otherwise.
// This preserves the selector contract; it does not promise an arbitrary
// current limit below the hardware's lower setting. Caller owns PM1 setup.
trusted fun M5BoardId.setStampChargeCurrent(power: M5Pm1,maxMilliamps: int): bool {
    if (this != m5BoardStampS3Bat || (power | 0) <= 0 || (power | 0) > 4294967295 ||
        maxMilliamps < 0 || maxMilliamps > 65535) return false
    power.setGpioOutput(3,maxMilliamps < 650)
}
