// M5Unified PaperColor built-in microphone callback (MIT, M5Stack).
// Own GPIO45 including its mux/hold/RTC state, the whole codec, stable clocks
// and stopped capture. Enable the codec rail even for reset/disable, matching
// upstream; do not remove this shared rail or close the device on failure.
// Input uses MIC1/left slot with stereo codec framing. Not accessory support.
// 1 complete,2 invalid/unowned,3 pad preparation/readback,4 codec transaction.
trusted fun paperColorMicrophoneOwned(codec: Es7210,enabled: bool,exclusive: bool): int {
    if (!exclusive || !codec.valid()) return 2
    if (!Pin(45).outputLevelOwned(true)) return 3
    peripheralDelayMilliseconds(50)
    val ready=if (enabled) codec.configureMic1() else codec.reset()
    return if (ready) 1 else 4
}
