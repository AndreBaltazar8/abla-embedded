import "./rtc_wake_cleanup_sequence.ab"
import "./rtc_device.ab"
import "../power/m5pm1_device.ab"
import "../hal/m5stack.ab"
import "../hal/m5pm1.ab"
@inline
@export("m5RtcCleanupRtcValid")
fun m5RtcCleanupRtcValidHook(rtc: int): bool = M5Rtc(rtc).valid()
@inline
@export("m5RtcCleanupPmicValid")
fun m5RtcCleanupPmicValidHook(pmic: int): bool = M5Pm1(pmic).valid()
@inline
@export("m5RtcCleanupRtc")
trusted fun m5RtcCleanupRtcHook(rtc: int,disable: bool): bool =
    if (disable) M5Rtc(rtc).disableInterrupts() else M5Rtc(rtc).clearInterrupt()
@inline
@export("m5RtcCleanupWake")
trusted fun m5RtcCleanupWakeHook(pmic: int): bool = M5Pm1(pmic).clearWakeSource()
@inline
@export("m5RtcCleanupPmicIrq")
trusted fun m5RtcCleanupPmicIrqHook(pmic: int): bool = M5Pm1(pmic).clearIrqStatus()
trusted fun M5Rtc.clearBoardInterrupt(board: M5BoardId,pmic: M5Pm1): M5RtcCleanupResult =
    m5RtcCleanupOwned(board,this | 0,pmic | 0,false)
trusted fun M5Rtc.disableBoardInterrupts(board: M5BoardId,pmic: M5Pm1): M5RtcCleanupResult =
    m5RtcCleanupOwned(board,this | 0,pmic | 0,true)
