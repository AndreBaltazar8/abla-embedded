import "./rtc_wake_cleanup_sequence.ab"
import "./rtc_device.ab"
import "../power/m5pm1_device.ab"
@inline
fun m5RtcCleanupRtcValid(rtc: int): bool = M5Rtc(rtc).valid()
@inline
fun m5RtcCleanupPmicValid(pmic: int): bool = M5Pm1(pmic).valid()
@inline
trusted fun m5RtcCleanupRtc(rtc: int,disable: bool): bool =
    if (disable) M5Rtc(rtc).disableInterrupts() else M5Rtc(rtc).clearInterrupt()
@inline
trusted fun m5RtcCleanupWake(pmic: int): bool = M5Pm1(pmic).clearWakeSource()
@inline
trusted fun m5RtcCleanupPmicIrq(pmic: int): bool = M5Pm1(pmic).clearIrqStatus()
trusted fun M5Rtc.clearBoardInterrupt(board: M5BoardId,pmic: M5Pm1): M5RtcCleanupResult =
    m5RtcCleanupOwned(board,this | 0,pmic | 0,false)
trusted fun M5Rtc.disableBoardInterrupts(board: M5BoardId,pmic: M5Pm1): M5RtcCleanupResult =
    m5RtcCleanupOwned(board,this | 0,pmic | 0,true)
