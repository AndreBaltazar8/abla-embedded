// Result words of the CoreS3 audio DMA preparation and the speaker/microphone streams (src/hal/cores3_audio_streams.ab wraps the calls).
type CoreS3AudioDmaPreparation = int
fun CoreS3AudioDmaPreparation.status(): int = this & 255
fun CoreS3AudioDmaPreparation.valid(): bool = this.status() == 1
fun CoreS3AudioDmaPreparation.sampleRate(): int = if (this.valid()) this >>> 8 else 0
type CoreS3SpeakerStreamResult = int
fun CoreS3SpeakerStreamResult.status(): int = this & 255
fun CoreS3SpeakerStreamResult.valid(): bool = this.status() == 1
fun CoreS3SpeakerStreamResult.dmaStatus(): int = (this >>> 8) & 65535
fun CoreS3SpeakerStreamResult.amplifierStatus(): int = (this >>> 24) & 2047
type CoreS3MicrophoneStreamResult = int
fun CoreS3MicrophoneStreamResult.status(): int = this & 255
fun CoreS3MicrophoneStreamResult.valid(): bool = this.status() == 1
fun CoreS3MicrophoneStreamResult.dmaStatus(): int = (this >>> 8) & 65535
fun CoreS3MicrophoneStreamResult.codecStatus(): int = (this >>> 24) & 1023
