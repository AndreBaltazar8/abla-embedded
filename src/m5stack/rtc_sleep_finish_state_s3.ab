import "../esp32/power/sleep_retained_record_s3_sequence.ab"
@inline
trusted fun m5RtcSleepCpuRestored(record: NativeBuffer): bool {
    if (!record.hasAddressRange(0,128) || (record.addressValue() & 3) != 0) return false
    val base=record.addressValue()
    if (esp32S3MspiStateRead(base) != 0 || (esp32S3MspiStateRead(base+4)&255) != 6) return false
    val progress=Esp32S3SleepResume(esp32S3MspiStateLoad64(base+40))
    progress.valid() && progress.complete()
}
@inline
trusted fun m5RtcSleepResume(record: NativeBuffer,polls: int): Esp32S3SleepResume = esp32S3SleepRetainedRecordResumeOwned(record,polls)
