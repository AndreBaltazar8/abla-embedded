import "./board_id.ab"
import "./pmic_voltage.ab"
import "./pmic_battery_level.ab"
import "../power/bq27220_device.ab"
// Borrow an already-bound BQ27220 on Nesso N1. No reset/unseal/full-access,
// charger changes or expander setup during telemetry. Caller owns bus/device
// exclusively for each operation; readings are independent, not a snapshot.
trusted fun M5BoardId.readBatteryMillivoltsOwned(gauge: Bq27220,exclusive: bool): M5VoltageRead {
    if (!exclusive || !gauge.valid()) return M5VoltageRead(2<<16)
    if (this != m5BoardArduinoNessoN1) return M5VoltageRead(3<<16)
    val result=gauge.batteryMillivoltsChecked()
    return if (result.valid()) M5VoltageRead((1<<16)|result.value()) else M5VoltageRead(4<<16)
}
// Match Power_Class's voltage estimate, NOT the gauge's state-of-charge
// register. Invalid reads do not become a plausible zero-percent battery.
trusted fun M5BoardId.readBatteryLevelOwned(gauge: Bq27220,exclusive: bool): M5BatteryLevelRead {
    val voltage=this.readBatteryMillivoltsOwned(gauge,exclusive)
    if (!voltage.valid()) return M5BatteryLevelRead(voltage.status()<<8)
    val level=batteryLevelFromMillivolts(I2cWordResult(65536|voltage.millivolts()))
    return M5BatteryLevelRead((1<<8)|level.value())
}
