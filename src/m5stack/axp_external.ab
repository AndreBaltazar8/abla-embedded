import "./axp_power.ab"
import "./axp_external_sequence.ab"
import "../hal/m5stack.ab"
import "../i2c/device.ab"
import "../hal/m5stack_3.ab"
import "../power/axp2101_type.ab"
import "../power/axp192_device.ab"
import "../power/axp2101_device.ab"
import "../i2c/results.ab"
import "../hal/i2cdevice.ab"
@export("axpExternalReadByte")
trusted fun axpExternalReadByteHook(handle: int,register: int): I2cByteResult = I2cDevice(handle).readRegister8Checked(register)
@export("axpExternalReadWord")
trusted fun axpExternalReadWordHook(handle: int,register: int): I2cWordResult = I2cDevice(handle).readRegister16BigEndianChecked(register)
@export("axpExternalBatteryBurst")
trusted fun axpExternalBatteryBurstHook(handle: int): I2cDwordResult = I2cDevice(handle).readRegister32BigEndianChecked(120)
@export("axpExternalBldo2")
trusted fun axpExternalBldo2Hook(handle: int,enabled: bool): bool = Axp2101(handle).setBldo2(if (enabled) 3300 else 0)
@export("axpExternalGpio0")
trusted fun axpExternalGpio0Hook(handle: int,enabled: bool): bool = I2cDevice(handle).writeRegister8(144,if (enabled) 2 else 7)
@export("axpExternalExten")
trusted fun axpExternalExtenHook(handle: int,enabled: bool): bool = Axp192(handle).setExtenEnabled(enabled)
// Bind identity first using board.bindAxpPower. Monitor is INA3221 device0;
// only AXP2101 Core2/Tough enable needs it. Caller serializes supply changes.
trusted fun M5BoardId.setAxpExternal(power: M5AxpPower,monitor: I2cDevice,enabled: bool): M5AxpExternalResult {
    if (!power.valid()) return M5AxpExternalResult(3)
    this.setAxpExternalOwned(power.device() | 0,power.identity(),monitor | 0,enabled)
}
trusted fun M5BoardId.axpExternalOutputChecked(power: M5AxpPower): I2cByteResult {
    if (!power.valid()) return I2cByteResult(0)
    this.axpExternalOutputCheckedOwned(power.device() | 0,power.identity())
}
