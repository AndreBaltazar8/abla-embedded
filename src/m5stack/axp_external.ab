import "./axp_power.ab"
import "./axp_external_sequence.ab"
trusted fun axpExternalReadByte(handle: int,register: int): I2cByteResult = I2cDevice(handle).readRegister8Checked(register)
trusted fun axpExternalReadWord(handle: int,register: int): I2cWordResult = I2cDevice(handle).readRegister16BigEndianChecked(register)
trusted fun axpExternalBatteryBurst(handle: int): I2cDwordResult = I2cDevice(handle).readRegister32BigEndianChecked(120)
trusted fun axpExternalBldo2(handle: int,enabled: bool): bool = Axp2101(handle).setBldo2(if (enabled) 3300 else 0)
trusted fun axpExternalGpio0(handle: int,enabled: bool): bool = I2cDevice(handle).writeRegister8(144,if (enabled) 2 else 7)
trusted fun axpExternalExten(handle: int,enabled: bool): bool = Axp192(handle).setExtenEnabled(enabled)
// Bind identity first using board.bindAxpPower. Monitor is INA3221 device0;
// only AXP2101 Core2/Tough enable needs it. Caller serializes supply changes.
trusted fun M5BoardId.setAxpExternal(power: M5AxpPower,monitor: I2cDevice,enabled: bool): M5AxpExternalResult {
    if (!power.valid()) return M5AxpExternalResult(3)
    this.setAxpExternalOwned(power.device() | 0,power.identity(),monitor | 0,enabled)
}
trusted fun M5BoardId.axpExternalOutputChecked(power: M5AxpPower): I2cByteResult {
    if (!power.valid()) return I2cByteResult(0)
    this.axpExternalOutputCheckedOwned(power.device() | 0,power.identity())
}
