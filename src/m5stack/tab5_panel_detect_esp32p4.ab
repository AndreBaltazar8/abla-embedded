import "./tab5_panel_detect_sequence.ab"
import "./tab5_touch_probe.ab"
import "../display/ili9881c_probe_esp32p4.ab"
import "../esp32/i2c_software_esp32p4.ab"
import "../esp32/peripheral_delay_esp32p4.ab"
import "../hal/m5stack.ab"
import "../hal/esp32.ab"
@export("tab5PanelDetectDelay")
trusted fun tab5PanelDetectDelayHook(ms: int): void {
    var remaining=ms
    while (remaining > 0) { peripheralRomDelay(1000); remaining=remaining-1 }
    return
}
@export("tab5PanelDetectIli")
trusted fun tab5PanelDetectIliHook(channel: int,scratch: NativeBuffer,polls: int): int = ili9881cProbeEsp32P4(channel,scratch,polls)|0
