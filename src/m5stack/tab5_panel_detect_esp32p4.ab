import "./tab5_panel_detect_sequence.ab"
import "./tab5_touch_probe.ab"
import "../display/ili9881c_probe_esp32p4.ab"
import "../esp32/i2c_software_esp32p4.ab"
import "../esp32/peripheral_delay_esp32p4.ab"
trusted fun tab5PanelDetectDelay(ms: int): void {
    var remaining=ms
    while (remaining > 0) { peripheralRomDelay(1000); remaining=remaining-1 }
    return
}
trusted fun tab5PanelDetectIli(channel: int,scratch: NativeBuffer,polls: int): int = ili9881cProbeEsp32P4(channel,scratch,polls)|0
