import "../esp32/sdk/raw_buffer.ab"
import "../esp32/rtc_retention_tag_plan_s3.ab"
import "../esp32/clock_bias_s3.ab"
import "../esp32/power/sleep_policy_esp32s3.ab"
import "../runtime/rtc_time48.ab"
import "abla/runtime/scalar"
// Validate the same policy/timing/retention restrictions as the actual entry
// and preparation primitives BEFORE GPIO ownership. Period is measured Q19,
// never guessed; caller supplies real cache geometry and retained segments.
fun paperS3SleepConfigValuesValid(i: Esp32S3TagPlan,d: Esp32S3TagPlan,bias: Esp32S3ClockBias,ports: int,options: int,ramKind: int,protocol: int,baseline: int,polls: int,flags: int,period: int,duration: int,reject: int): bool {
    if (!i.valid() || i.dataCache() || !d.valid() || !d.dataCache() ||
        ((bias|0)&(~0x1fffff)) != 0 || ports < 0 || ports > 7 || options < 0 || options > 7 ||
        d.logical16K() != ((options&2) != 0) || ((options&2) != 0 && !d.enabled()) ||
        (ramKind != -1 && ramKind != 2 && ramKind != 3) || protocol < 0 || baseline < 0 ||
        protocol > 63 || baseline > 63 || protocol+baseline > 63 ||
        ((options&1) != 0 && (protocol != 0 || baseline != 0)) || polls <= 0 || polls > 0x7fffffff ||
        !esp32S3SleepPolicy(flags).valid() || (flags&(1|32|512)) != 0 ||
        ((options&4) != 0) != ((flags&0x20000) != 0) || reject < 0 || reject > 0x3ffff || duration < 0) return false
    val xtal=rtc48TicksForMicroseconds(250,period)
    if (xtal < 0 || xtal > 1023) return false
    return duration == 0 || rtc48TicksForMicroseconds(duration,period) > 0
}
fun paperS3ConfigLoad64(config: NativeBuffer,offset: int): int = config.loadU32(offset)|(config.loadU32(offset+4)<<32)
trusted fun paperS3SleepConfigValid(config: NativeBuffer): bool {
    if (!config.hasAddressRange(0,72) || (config.addressValue()&3) != 0 || config.loadU32(68) != 0) return false
    return paperS3SleepConfigValuesValid(Esp32S3TagPlan(paperS3ConfigLoad64(config,0)),Esp32S3TagPlan(paperS3ConfigLoad64(config,8)),Esp32S3ClockBias(paperS3ConfigLoad64(config,16)),
        config.loadU32(24),config.loadU32(28),int(i32(config.loadU32(32))),config.loadU32(36),config.loadU32(40),config.loadU32(44),
        config.loadU32(48),config.loadU32(52),paperS3ConfigLoad64(config,56),config.loadU32(64))
}
// All-or-nothing encoding: no output writes on invalid inputs. Zero duration
// means GPIO-only for this lifecycle, not M5's public zero-duration no-op.
trusted fun paperS3SleepConfigEncode(out: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan,bias: Esp32S3ClockBias,ports: int,options: int,ramKind: int,protocol: int,baseline: int,polls: int,flags: int,period: int,duration: int,reject: int): bool {
    if (!out.hasAddressRange(0,72) || (out.addressValue()&3) != 0 || !paperS3SleepConfigValuesValid(i,d,bias,ports,options,ramKind,protocol,baseline,polls,flags,period,duration,reject)) return false
    out.storeU32(0,i|0);out.storeU32(4,(i|0)>>>32);out.storeU32(8,d|0);out.storeU32(12,(d|0)>>>32)
    out.storeU32(16,bias|0);out.storeU32(20,(bias|0)>>>32);out.storeU32(24,ports);out.storeU32(28,options)
    out.storeU32(32,ramKind);out.storeU32(36,protocol);out.storeU32(40,baseline);out.storeU32(44,polls)
    out.storeU32(48,flags);out.storeU32(52,period);out.storeU32(56,duration);out.storeU32(60,duration>>>32);out.storeU32(64,reject);out.storeU32(68,0)
    return true
}
