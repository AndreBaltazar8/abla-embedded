import "./detect_logic.ab"
import "../esp32/soc/identity_c5_logic.ab"
// Preserve explicit selection (including display-based detection). StampC5
// is identified only by FLASH_CAP1 + PSRAM_CAP0. Others remain unknown;
// eFuse geometry alone does not identify a ToughC5/display board.
trusted fun m5DetectCurrentEsp32C5(current: M5BoardId = m5BoardUnknown): M5BoardId {
    if (current != m5BoardUnknown) return current
    val sys2=m5C5ReadIdentity()
    m5DetectEsp32C5(current,esp32C5FlashCapacityFromEfuse(sys2),esp32C5PsramCapacityFromEfuse(sys2))
}
