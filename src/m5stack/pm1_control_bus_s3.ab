import "../esp32/i2c/device_s3_logic.ab"
import "../esp32/sdk/raw_buffer.ab"
import "./i2c_pin_map.ab"
// Read-only admission under caller-owned bus lifecycle. Native transport still
// acquires its canonical gate for each operation; this is not a lock lease.
trusted fun pm1ControlS3BusReady(bus: int,board: M5BoardId,state0: int,state1: int): bool {
    if (!esp32S3I2cBusKeyValid(bus) || (board != m5BoardChainCaptain &&
        board != m5BoardPaperMono && board != m5BoardStopWatch)) return false
    val address=if (esp32S3I2cBusKeyPort(bus) == 0) state0 else state1
    val state=nativeBufferAt(address,36)
    if (!state.hasAddressRange(0,36) || (address&3) != 0) return false
    val pins=board.i2cPins()
    return state.loadU32(0) == 0 && state.loadU32(8) == 1 &&
        state.loadU32(4) == esp32S3I2cBusKeyGeneration(bus) &&
        state.loadU32(12) == pins.internalData() && state.loadU32(16) == pins.internalClock()
}
