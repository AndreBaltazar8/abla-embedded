import "./tab5_board_session_sequence.ab"
import "./tab5_board_prepare_esp32p4.ab"
import "./tab5_touch_scan_esp32p4.ab"
import "./tab5_detected_panel_esp32p4.ab"
trusted fun tab5SessionPanelOpen(owner: NativeBuffer,reference: NativeBuffer,probe: int,scratch: NativeBuffer,layout: int,
    cfg: int,ref: int,div: int,khz: int,vc: int,polls: int,settleUs: int): int {
    val revision=esp32P4ChipRevision()
    if (layout == 0 || esp32P4RegisterLayout(revision) != layout) return 2
    return tab5DsiOwnerAt(owner).openDetectedPanelOwned(reference,probe,scratch,layout,revision,cfg,ref,div,khz,vc,polls,settleUs)
}
trusted fun Tab5BoardSession.openOnChipOwned(board: M5BoardId,expanders: NativeBuffer,scratch: NativeBuffer,attempts: int = 60): int =
    this.openOwned(board,esp32P4ChipRegisterLayout(),expanders,scratch,attempts)
trusted fun tab5SessionPanelClose(owner: NativeBuffer,polls: int): int = tab5DsiOwnerAt(owner).closeOwned(polls)
trusted fun tab5SessionStorageSafe(session: NativeBuffer,expanders: NativeBuffer,scratch: NativeBuffer): bool =
    p4SoftwareProviderBufferSafe(session,40) && p4SoftwareProviderBufferSafe(expanders,32) &&
    p4SoftwareProviderBufferSafe(scratch,32) && m5ExpandersAt(expanders).valid() &&
    tab5BoardPrepareFresh(m5ExpandersAt(expanders)|0)
trusted fun tab5SessionBusOpen(layout: int): int = tab5ControlBusOpenOwned(layout)|0
trusted fun tab5SessionPrepare(bus: int,board: M5BoardId,expanders: NativeBuffer,scratch: NativeBuffer): int =
    Tab5ControlBus(bus).prepareBoardOwned(board,m5ExpandersAt(expanders),scratch)|0
trusted fun tab5SessionScan(prepared: int,board: M5BoardId,bus: int,attempts: int): int =
    Tab5BoardPrepare(prepared).scanTouchOwned(board,Tab5ControlBus(bus).busHandle(),attempts)|0
trusted fun tab5SessionScanClose(scan: int): int = Tab5TouchScan(scan).closeOwned()|0
trusted fun tab5SessionExpandersClose(expanders: NativeBuffer): bool = m5ExpandersAt(expanders).close()
trusted fun tab5SessionBusClose(bus: int): int = Tab5ControlBus(bus).closeOwned()|0
