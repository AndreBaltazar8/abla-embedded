import "../esp32/sdk/nativebuffer_type.ab"
@export("tab5SessionPanelOpen")
trusted fun tab5SessionPanelOpenHook(owner: NativeBuffer,reference: NativeBuffer,probe: int,scratch: NativeBuffer,layout: int,
    cfg: int,ref: int,div: int,khz: int,vc: int,polls: int,settleUs: int): int {
    val revision=esp32P4ChipRevision()
    if (layout == 0 || esp32P4RegisterLayout(revision) != layout) return 2
    return tab5DsiOwnerAt(owner).openDetectedPanelOwned(reference,probe,scratch,layout,revision,cfg,ref,div,khz,vc,polls,settleUs)
}
trusted fun Tab5BoardSession.openOnChipOwned(board: M5BoardId,expanders: NativeBuffer,scratch: NativeBuffer,attempts: int = 60): int =
    this.openOwned(board,esp32P4ChipRegisterLayout(),expanders,scratch,attempts)
@export("tab5SessionPanelClose")
trusted fun tab5SessionPanelCloseHook(owner: NativeBuffer,polls: int): int = tab5DsiOwnerAt(owner).closeOwned(polls)
@export("tab5SessionStorageSafe")
trusted fun tab5SessionStorageSafeHook(session: NativeBuffer,expanders: NativeBuffer,scratch: NativeBuffer): bool =
    p4SoftwareProviderBufferSafe(session,40) && p4SoftwareProviderBufferSafe(expanders,32) &&
    p4SoftwareProviderBufferSafe(scratch,32) && m5ExpandersAt(expanders).valid() &&
    tab5BoardPrepareFresh(m5ExpandersAt(expanders)|0)
@export("tab5SessionBusOpen")
trusted fun tab5SessionBusOpenHook(layout: int): int = tab5ControlBusOpenOwned(layout)|0
@export("tab5SessionPrepare")
trusted fun tab5SessionPrepareHook(bus: int,board: M5BoardId,expanders: NativeBuffer,scratch: NativeBuffer): int =
    Tab5ControlBus(bus).prepareBoardOwned(board,m5ExpandersAt(expanders),scratch)|0
@export("tab5SessionScan")
trusted fun tab5SessionScanHook(prepared: int,board: M5BoardId,bus: int,attempts: int): int =
    Tab5BoardPrepare(prepared).scanTouchOwned(board,Tab5ControlBus(bus).busHandle(),attempts)|0
@export("tab5SessionScanClose")
trusted fun tab5SessionScanCloseHook(scan: int): int = Tab5TouchScan(scan).closeOwned()|0
@export("tab5SessionExpandersClose")
trusted fun tab5SessionExpandersCloseHook(expanders: NativeBuffer): bool = m5ExpandersAt(expanders).close()
@export("tab5SessionBusClose")
trusted fun tab5SessionBusCloseHook(bus: int): int = Tab5ControlBus(bus).closeOwned()|0
