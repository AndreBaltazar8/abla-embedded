import "./output_readback_sequence.ab"
trusted fun m5OutputReadByte(handle: int,register: int): I2cByteResult = I2cDevice(handle).readRegister8Checked(register)
trusted fun m5OutputReadDword(handle: int,register: int): I2cDwordResult = I2cDevice(handle).readRegister32LittleEndianChecked(register)
trusted fun M5BoardId.externalOutputChecked(power: I2cDevice,expander: I2cDevice): I2cByteResult =
    this.externalOutputCheckedOwned(power | 0,expander | 0)
trusted fun M5BoardId.usbOutputChecked(expander: I2cDevice): I2cByteResult = this.usbOutputCheckedOwned(expander | 0)
