import "./output_readback_sequence.ab"
import "../i2c/device.ab"
import "../hal/m5stack_3.ab"
@export("m5OutputReadByte")
trusted fun m5OutputReadByteHook(handle: int,register: int): I2cByteResult = I2cDevice(handle).readRegister8Checked(register)
@export("m5OutputReadDword")
trusted fun m5OutputReadDwordHook(handle: int,register: int): I2cDwordResult = I2cDevice(handle).readRegister32LittleEndianChecked(register)
trusted fun M5BoardId.externalOutputChecked(power: I2cDevice,expander: I2cDevice): I2cByteResult =
    this.externalOutputCheckedOwned(power | 0,expander | 0)
trusted fun M5BoardId.usbOutputChecked(expander: I2cDevice): I2cByteResult = this.usbOutputCheckedOwned(expander | 0)
