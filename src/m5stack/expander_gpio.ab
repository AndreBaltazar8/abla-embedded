import "./expander_owner.ab"
import "../i2c/results.ab"
// Common GPIO subset only. PI4 high-impedance and M5IOE open-drain are NOT
// equivalent; their chip-specific drive controls remain on the raw drivers.
trusted fun M5Expanders.gpioSlot(index: int,pin: int): M5ExpanderOpen {
    if (!this.ready() || pin < 0) return M5ExpanderOpen(0)
    val slot=this.slot(index)
    if (!slot.ready() || pin >= (if (slot.kind() == 1) 8 else 14)) return M5ExpanderOpen(0)
    slot
}
trusted fun M5Expanders.digitalWrite(index: int,pin: int,enabled: bool): bool {
    val slot=this.gpioSlot(index,pin)
    if (!slot.ready()) return false
    if (slot.kind() == 1) Pi4Ioe5v6408(slot.deviceHandle()).digitalWrite(pin,enabled)
    else M5Ioe1(slot.deviceHandle()).digitalWrite(pin,enabled)
}
trusted fun M5Expanders.setDirection(index: int,pin: int,output: bool): bool {
    val slot=this.gpioSlot(index,pin)
    if (!slot.ready()) return false
    if (slot.kind() == 1) Pi4Ioe5v6408(slot.deviceHandle()).setDirection(pin,output)
    else M5Ioe1(slot.deviceHandle()).setDirection(pin,output)
}
trusted fun M5Expanders.setPullMode(index: int,pin: int,mode: int): bool {
    val slot=this.gpioSlot(index,pin)
    if (!slot.ready() || !validPullMode(mode)) return false
    if (slot.kind() == 1) Pi4Ioe5v6408(slot.deviceHandle()).setPullMode(pin,mode)
    else M5Ioe1(slot.deviceHandle()).setPullMode(pin,mode)
}
trusted fun M5Expanders.digitalReadChecked(index: int,pin: int): I2cByteResult {
    val slot=this.gpioSlot(index,pin)
    if (!slot.ready()) return I2cByteResult(0)
    if (slot.kind() == 1) Pi4Ioe5v6408(slot.deviceHandle()).digitalReadChecked(pin)
    else M5Ioe1(slot.deviceHandle()).digitalReadChecked(pin)
}
trusted fun M5Expanders.outputLatchChecked(index: int,pin: int): I2cByteResult {
    val slot=this.gpioSlot(index,pin)
    if (!slot.ready()) return I2cByteResult(0)
    if (slot.kind() == 1) Pi4Ioe5v6408(slot.deviceHandle()).getWriteValueChecked(pin)
    else M5Ioe1(slot.deviceHandle()).getWriteValueChecked(pin)
}
