import "./detect_logic.ab"
import "../esp32/soc/identity_p4_logic.ab"
import "../esp32/gpio/probe_p4_sequence.ab"
// Negative return is the probe's error, not a board identifier. In particular
// -4 requires retaining pad ownership and repairing state. 0 is unknown.
// Same exclusive/quiesced/global-hold/clock preconditions as the probe.
trusted fun m5DetectCurrentEsp32P4Owned(current: M5BoardId,layout: int,exclusive: bool): int {
    if (current != m5BoardUnknown) return current | 0
    val pin32=esp32P4GpioPulldownProbeOwned(layout,32,exclusive)
    if (pin32 < 0) return pin32
    if (pin32 == 1) return m5DetectEsp32P4(current,true,false,esp32P4RevisionFromEfuse(m5P4ReadIdentity())) | 0
    val pin0=esp32P4GpioPulldownProbeOwned(layout,0,exclusive)
    if (pin0 < 0) return pin0
    if (pin0 == 1) return m5BoardUnitPoEP4 | 0
    m5DetectEsp32P4(current,false,false,esp32P4RevisionFromEfuse(m5P4ReadIdentity())) | 0
}
