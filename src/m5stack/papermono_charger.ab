import "./papermono_charger_sequence.ab"
import "./papermono_charger_prepare.ab"
import "../power/m5pm1_device.ab"
import "../io_expander/m5ioe1_device.ab"
@inline
trusted fun paperMonoChargerSource(handle: int): I2cByteResult = M5Pm1(handle).powerSourceResult()
@inline
trusted fun paperMonoChargerEnable(handle: int,enabled: bool): bool = M5Ioe1(handle).digitalWrite(10,enabled)
@inline
trusted fun paperMonoChargerDelay(milliseconds: int): void = peripheralDelayMilliseconds(milliseconds)
@inline
trusted fun paperMonoChargerProbe(bus: int): bool = I2cBus(bus).probe(117)
@inline
trusted fun paperMonoChargerRead(handle: int): I2cByteResult = I2cDevice(handle).readRegister8Checked(199)
@inline
trusted fun paperMonoChargerWrite(handle: int,enabled: bool): bool = I2cDevice(handle).updateRegister8(1,1,if (enabled) 1 else 0)
// Caller supplies PaperMono's initialized100kHz bus and device117 handle.
trusted fun paperMonoCharger(pm1: M5Pm1,ioe: M5Ioe1,bus: I2cBus,charger: I2cDevice,mode: int): PaperMonoChargeResult =
    if (!bus.valid()) PaperMonoChargeResult(6) else paperMonoChargerOwned(pm1 | 0,ioe | 0,bus | 0,charger | 0,mode)
