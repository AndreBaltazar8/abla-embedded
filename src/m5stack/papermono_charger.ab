import "./papermono_charger_sequence.ab"
import "./papermono_charger_prepare.ab"
import "../power/m5pm1_device.ab"
import "../io_expander/m5ioe1_device.ab"
import "../hal/delay.ab"
import "../hal/m5stack.ab"
import "../i2c/device.ab"
import "../hal/m5stack_3.ab"
import "../hal/m5ioe1.ab"
import "../hal/m5pm1.ab"
@inline
@export("paperMonoChargerSource")
trusted fun paperMonoChargerSourceHook(handle: int): I2cByteResult = M5Pm1(handle).powerSourceResult()
@inline
@export("paperMonoChargerEnable")
trusted fun paperMonoChargerEnableHook(handle: int,enabled: bool): bool = M5Ioe1(handle).digitalWrite(10,enabled)
@inline
@export("paperMonoChargerDelay")
trusted fun paperMonoChargerDelayHook(milliseconds: int): void = peripheralDelayMilliseconds(milliseconds)
@inline
@export("paperMonoChargerProbe")
trusted fun paperMonoChargerProbeHook(bus: int): bool = I2cBus(bus).probe(117)
@inline
@export("paperMonoChargerRead")
trusted fun paperMonoChargerReadHook(handle: int): I2cByteResult = I2cDevice(handle).readRegister8Checked(199)
@inline
@export("paperMonoChargerWrite")
trusted fun paperMonoChargerWriteHook(handle: int,enabled: bool): bool = I2cDevice(handle).updateRegister8(1,1,if (enabled) 1 else 0)
// Caller supplies PaperMono's initialized100kHz bus and device117 handle.
trusted fun paperMonoCharger(pm1: M5Pm1,ioe: M5Ioe1,bus: I2cBus,charger: I2cDevice,mode: int): PaperMonoChargeResult =
    if (!bus.valid()) PaperMonoChargeResult(6) else paperMonoChargerOwned(pm1 | 0,ioe | 0,bus | 0,charger | 0,mode)
