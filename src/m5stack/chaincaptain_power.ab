import "./expander_owner.ab"
import "./pmic_types.ab"
import "../power/m5pm1_device.ab"

// M5Unified Power_Class.cpp ChainCaptain startup (M5Stack, MIT).
// Boot-only, after both device groups have opened. Caller owns PM1/IOE
// registers and quiesced Grove/Chain loads; this disables their supplies.
// PM1 numbering is zero-based; IOE G3/G4 mean bits2/3.
// Preserve upstream ordering, including direction before latch writes.
// No rollback: an error can leave a partially configured/powered rail.
// Low8:1complete,2wrongboard,3notready/notexclusive,4I/O failure.
// Bits8..15 count completed high-level operations (pull-none has two writes).
trusted fun M5Expanders.configureChainCaptainPower(pmic: M5PmicOpen,exclusive: bool): int {
    if (!exclusive || !this.ready() || !pmic.ready() || pmic.kind() != 5) return 3
    if (this.board() != m5BoardChainCaptain) return 2
    val power=M5Pm1(pmic.deviceHandle())
    val io=M5Ioe1(this.device(0)|0)
    if (!power.setGpioFunction(0,m5Pm1GpioFunctionGpio)) return 4
    if (!power.setGpioMode(0,m5Pm1GpioOutput)) return 4|(1<<8)
    if (!power.setGpioDrive(0,m5Pm1GpioPushPull)) return 4|(2<<8)
    if (!power.setGpioOutput(0,false)) return 4|(3<<8)
    if (!power.setGpioFunction(3,m5Pm1GpioFunctionGpio)) return 4|(4<<8)
    if (!power.setGpioMode(3,m5Pm1GpioOutput)) return 4|(5<<8)
    if (!power.setGpioDrive(3,m5Pm1GpioPushPull)) return 4|(6<<8)
    if (!power.setGpioOutput(3,false)) return 4|(7<<8)
    if (!io.setDirection(2,false)) return 4|(8<<8)
    if (!io.setPullMode(2,pullNone)) return 4|(9<<8)
    if (!io.setHighImpedance(3,false)) return 4|(10<<8)
    if (!io.setDirection(3,true)) return 4|(11<<8)
    if (!io.digitalWrite(3,false)) return 4|(12<<8)
    return 1|(13<<8)
}
