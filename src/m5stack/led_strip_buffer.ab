import "./led_profile.ab"
import "../led/rmt_strip_pixels.ab"
// Construct caller-owned strip state only. SDK-free; caller selects/prepares
// the real transport separately. Non-strip boards are rejected without writes.
trusted fun M5BoardId.ledStripAt(storage: NativeBuffer): RmtLedStrip {
    val profile=this.ledProfile()
    if (profile.backend() != m5LedBackendRmt) return RmtLedStrip(0)
    return rmtLedStripAt(storage,profile.dataPinNumber(),profile.count())
}
