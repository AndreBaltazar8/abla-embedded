import "./pmic_shutdown_sequence.ab"
import "../power/axp192_device.ab"
import "../power/axp2101_device.ab"
import "../power/ip5306_device.ab"
import "../power/m5pm1_device.ab"
@inline
trusted fun m5PmicShutdownWrite(handle: int,kind: int,preserve: bool): bool {
    if (kind == 2) return Axp192(handle).powerOff()
    if (kind == 3) return Axp2101(handle).powerOff()
    if (kind == 4) return Ip5306(handle).setPowerBoostKeepOn(preserve)
    if (kind == 5) return M5Pm1(handle).powerOff()
    false
}
trusted fun M5PmicOpen.preparePowerOff(preserveForWake: bool): M5PmicShutdownResult = this.preparePowerOffOwned(preserveForWake)
