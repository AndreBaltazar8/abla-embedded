import "./tab5_display_close_sequence.ab"
// Optional final teardown for a display holding ONE shared-reference lease
// and an exclusive LDO lease. Buffers point at the authoritative32bit owners,
// not copies. Caller holds RCC+PMU serialization, guarantees these same owners
// throughout retries, and keeps the records disjoint/alive. Only use after all
// rail consumers are stopped. This does not power off PLLs or board supplies.
// Record word36: bit0 reference returned,bit1 rail returned. initialize resets
// both on a NEW display lifetime. Never reuse the record while references live.
// 1released,2invalid/alias,3display not closed,4reference blocked,5rail blocked.
trusted fun Tab5DisplayClose.releaseSuppliesOwned(reference: NativeBuffer,rail: NativeBuffer): int {
    if (!this.valid() || !reference.hasAddressRange(0,4) || !rail.hasAddressRange(0,4) ||
        (reference.addressValue()&3) != 0 || (rail.addressValue()&3) != 0) return 2
    val start=this.buffer().addressValue()
    val ref=reference.addressValue()
    val ldo=rail.addressValue()
    if ((ref < start+40 && ref+4 > start) || (ldo < start+40 && ldo+4 > start) || ref == ldo) return 2
    if (this.buffer().loadU32(4) != 0 || this.loadWide(16) != 0 || this.loadWide(24) != 0) return 3
    var done=this.buffer().loadU32(36)
    if (done > 3) return 2
    if ((done&1) == 0) {
        val result=tab5SupplyReferenceRelease(reference.loadU32(0))
        reference.storeU32(0,result&4294967295)
        if ((result>>>32) != 1) return 4
        done=done|1; this.buffer().storeU32(36,done)
    }
    if ((done&2) == 0) {
        val result=tab5SupplyRailRelease(rail.loadU32(0))
        rail.storeU32(0,result&4294967295)
        if ((result>>>32) != 1) return 5
        done=done|2; this.buffer().storeU32(36,done)
    }
    return 1
}
