import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
import "../spi/pins.ab"
// Fresh exclusive GPSPI2 startup, mode0/MSB, PLL80M divided by2 ->40MHz.
// Caller owns stable PLL80M and stopped controller, CS45/DC46/CLK15/MOSI16
// with RTC/USB/holds released; other device CS lines already inactive.
// No MISO lease, reads, shared-clock shutdown or automatic rollback.
// Gate quarantines partial initialization. GPIO failures detail9CS/10DC,
// otherwise detail is the shared initializer's precise stage.
trusted fun chainCaptainSpiInitializeOwned(gate: PeripheralGate,owner: u32,exclusive: bool): SpiTransactionResult {
    if (!exclusive) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    var detail=1
    if (!Pin(45).outputLevelOwned(true)) detail=9
    else if (!Pin(46).outputLevelOwned(true)) detail=10
    if (detail == 1) detail=esp32s3SpiInitializeTransmitOwned(2,spiPins(16,-1,15),Pin(45),1,1,2,0,owner,100000)
    if (!gate.finish(owner,detail == 1)) return SpiTransactionResult((5<<32)|detail)
    return SpiTransactionResult(((if (detail == 1) 1 else 6)<<32)|detail)
}
