import "./rtc_timer_wake_s3_sequence.ab"
import "./rtc_wake_cancel_s3_sequence.ab"
// Caller-owned 24-byte report: final status0, wake admission4, exact timer
// result8..15, cancellation result16..23 (little-endian). No allocation.
// Return1 ready,2 invalid/no mutation,3 setup failed and fully cancelled,
// 4 setup failed and cancellation needs retry. Ready is not sleep entry.
// Require an explicitly initialized/released wake record, normal clocks,
// configured GPIO input sampling, powered RTC/PM1 and exclusive timer/pads.
// Keep both records and supplies until cancellation or sleep finish completes.
trusted fun m5RtcWakeBeginS3Owned(board: M5BoardId,rtc: int,pmic: int,wake: NativeBuffer,report: NativeBuffer,milliseconds: int,clocksUnchangedExclusive: bool): int {
    if (!clocksUnchangedExclusive || milliseconds <= 0 ||
        (board != m5BoardPaperColor && board != m5BoardPaperMono && board != m5BoardStampPLC) ||
        !wake.hasAddressRange(0,176) || (wake.addressValue() & 3) != 0 ||
        !report.hasAddressRange(0,24) ||
        (wake.addressValue() < report.addressValue()+24 && report.addressValue() < wake.addressValue()+176) ||
        !m5RtcCleanupRtcValid(rtc) || !m5RtcTimerSupported(rtc) ||
        (board.rtcNeedsPmicCleanup() && !m5RtcCleanupPmicValid(pmic)) ||
        !m5RtcWakeBeginReleased(wake)) return 2
    report.storeU32(0,0); report.storeU32(4,0)
    report.storeU32(16,0); report.storeU32(20,0)
    val timer=m5RtcBoardTimerOwned(board,rtc,pmic,milliseconds)
    report.storeU32(8,timer | 0); report.storeU32(12,(timer | 0)>>>32)
    if (timer.success()) {
        val admission=board.prepareS3RtcTimerWakeOwned(wake,timer,true)
        report.storeU32(4,admission)
        if (admission == 1) { report.storeU32(0,1); return 1 }
    }
    // A failed I2C operation may still have armed the countdown. Always stop
    // it through checked cleanup; retain the original failure in the report.
    val cancel=m5RtcWakeCancelS3Owned(board,rtc,pmic,wake,true)
    report.storeU32(16,cancel | 0); report.storeU32(20,(cancel | 0)>>>32)
    val status=if (cancel.complete()) 3 else 4
    report.storeU32(0,status)
    status
}
