import "./imu_control.ab"
// Opt-in with an I2C provider implementing setFrequency. This changes only the
// primary sensor, not independent magnetometers. Caller chooses a rate within
// the sensor/board electrical limits; <=400kHz common IMU fast-mode ceiling.
trusted fun M5ImuProbeResult.setClock(frequency: int): M5ImuControlResult {
    if (!this.ready() || frequency < 1000 || frequency > 400000) return M5ImuControlResult(2)
    return M5ImuControlResult(if (I2cDevice(this.handle()).setFrequency(frequency)) 1 else 4)
}
