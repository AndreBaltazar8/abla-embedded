import "./stopwatch_panel_esp32s3.ab"
import "../display/co5300_fill_sequence_esp32s3.ab"
// Direct aligned rectangle in the468x468 viewport; no silent clipping or
// widening into neighboring pixels. Requested rotation must match the panel.
trusted fun stopWatchPanelFillAlignedOwned(gate: PeripheralGate,owner: u32,rotation: int,
    x: int,y: int,width: int,height: int,color: Rgb565): SpiTransactionResult {
    if (rotation < 0 || rotation > 7 || x < 0 || y < 0 || width < 1 || height < 1 ||
        x >= 468 || y >= 468 || width > 468-x || height > 468-y) return SpiTransactionResult(3<<32)
    return esp32s3Co5300Fill(gate,owner,2,quadSpiPins(40,41,42,46,45),Pin(39),
        x+stopWatchPanelColumnStart(rotation),y+stopWatchPanelRowStart(rotation),width,height,color)
}
trusted fun stopWatchPanelClearOwned(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult =
    stopWatchPanelFillAlignedOwned(gate,owner,rotation,0,0,468,468,rgb565Black)
