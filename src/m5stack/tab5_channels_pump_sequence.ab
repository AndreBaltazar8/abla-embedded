import "./codec_channels_pump_p4_sequence.ab"
type Tab5ChannelsPump=int
fun Tab5ChannelsPump.status(): int = this&255
fun Tab5ChannelsPump.pending(): bool = (this&256) != 0
fun Tab5ChannelsPump.index(): int = (this >>> 9)&4095
trusted fun tab5PumpChannelsOwned(state: Tab5ChannelsPump,r: NativeBuffer,bank: PcmChannels,
    accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,gain: int,exclusive: bool,tone: PcmTone=PcmTone(0)): Tab5ChannelsPump =
    Tab5ChannelsPump(m5P4PumpChannelsOwned(M5P4ChannelsPump(state|0),r,bank,accumulator,scratch,staging,gain,exclusive,true,tone)|0)
trusted fun tab5PumpSourceQueuesOwned(state: Tab5ChannelsPump,r: NativeBuffer,queues: PcmSourceQueues,
    accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,gain: int,exclusive: bool): Tab5ChannelsPump =
    Tab5ChannelsPump(m5P4PumpChannelsOwned(M5P4ChannelsPump(state|0),r,PcmChannels(0),accumulator,scratch,staging,gain,exclusive,true,PcmTone(0),queues)|0)
