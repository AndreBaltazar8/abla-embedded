// Pads have already been captured and configured by the caller. Same command
// order/bit packing as M5GFX gpio::command: shift left for every read.
// -1 means floating GPIO38 failed; caller must still restore captured pads.
trusted fun m5DetectS3ReadSignature(): int {
    var bits=if (gpioProbeRead(8)) 1 else 0
    bits=(bits<<1)|(if (gpioProbeRead(10)) 1 else 0)
    bits=(bits<<1)|(if (gpioProbeRead(4)) 1 else 0)
    bits=(bits<<1)|(if (gpioProbeRead(12)) 1 else 0)
    bits=(bits<<1)|(if (gpioProbeRead(38)) 1 else 0)
    if (!gpioProbeInput(38,3)) return -1
    gpioProbeDelayMicroseconds(1000)
    return (bits<<1)|(if (gpioProbeRead(38)) 1 else 0)
}
