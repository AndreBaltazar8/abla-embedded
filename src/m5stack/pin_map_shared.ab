import "./board_id.ab"
import "./i2c_pin_map.ab"
// Import with the selected platform Pin implementation.

// Two physical connector pins in one scalar. Missing pins use the same 0xff
// representation as M5Unified's tables and decode to Pin(-1).
type M5PortPins = int

fun m5PortPins(first: int, second: int): M5PortPins = M5PortPins(
    m5EncodePin(first) | (m5EncodePin(second) << 8)
)

fun M5PortPins.pin1(): Pin = pin(m5DecodePin(this & 255))
fun M5PortPins.pin2(): Pin = pin(m5DecodePin((this >>> 8) & 255))
fun M5PortPins.available(): bool = this.pin1().number() >= 0 && this.pin2().number() >= 0 && this.pin1().number() != this.pin2().number()

// SDMMC and SDSPI share the same six physical entries in M5Unified:
// clock, command/MOSI, D0/MISO, D1, D2, and D3/chip-select.
type M5SdPinMap = int

fun m5SdPinMap(
    clock: int,
    command: int,
    data0: int,
    data1: int,
    data2: int,
    data3: int
): M5SdPinMap = M5SdPinMap(
    m5EncodePin(clock) | (m5EncodePin(command) << 8) |
        (m5EncodePin(data0) << 16) | (m5EncodePin(data1) << 24) |
        (m5EncodePin(data2) << 32) | (m5EncodePin(data3) << 40)
)

fun M5SdPinMap.clock(): Pin = pin(m5DecodePin(this & 255))
fun M5SdPinMap.command(): Pin = pin(m5DecodePin((this >>> 8) & 255))
fun M5SdPinMap.data0(): Pin = pin(m5DecodePin((this >>> 16) & 255))
fun M5SdPinMap.data1(): Pin = pin(m5DecodePin((this >>> 24) & 255))
fun M5SdPinMap.data2(): Pin = pin(m5DecodePin((this >>> 32) & 255))
fun M5SdPinMap.data3(): Pin = pin(m5DecodePin((this >>> 40) & 255))
// Availability is descriptor completeness, not target pin/electrical approval.
// A one-bit SDMMC map can omit D1/D2/D3; SPI additionally needs chip select.
fun M5SdPinMap.available(): bool = this.clock().number() >= 0 && this.command().number() >= 0 && this.data0().number() >= 0 &&
    this.clock().number() != this.command().number() && this.clock().number() != this.data0().number() && this.command().number() != this.data0().number()
fun M5SdPinMap.usesSdmmcFourBit(): bool = this.available() && this.data1().number() >= 0 && this.data2().number() >= 0 && this.data3().number() >= 0 && this.distinctDataPins()
fun M5SdPinMap.entryNumber(index: int): int = if (index == 0) this.clock().number() else if (index == 1) this.command().number() else if (index == 2) this.data0().number() else if (index == 3) this.data1().number() else if (index == 4) this.data2().number() else if (index == 5) this.data3().number() else -1
fun M5SdPinMap.distinctDataPins(): bool {
    var first=0
    while (first < 6) {
        val a=this.entryNumber(first)
        var second=first+1
        while (second < 6) { if (a == this.entryNumber(second)) return false;second=second+1 }
        first=first+1
    }
    return true
}
fun M5SdPinMap.spiClock(): Pin = this.clock()
fun M5SdPinMap.spiMosi(): Pin = this.command()
fun M5SdPinMap.spiMiso(): Pin = this.data0()
fun M5SdPinMap.spiChipSelect(): Pin = this.data3()

fun M5BoardId.portA(): M5PortPins {
    val pins = this.pinMapIdentity().i2cPins()
    m5PortPins(pins.externalClock(), pins.externalData())
}

fun M5BoardId.portB(): M5PortPins {
    val board = this.pinMapIdentity()
    if (board == m5BoardStackCoreS3 || board == m5BoardStackCoreS3SE ||
        board == m5BoardStackChan) return m5PortPins(8, 9)
    if (board == m5BoardDial || board == m5BoardDinMeter) {
        return m5PortPins(1, 2)
    }
    if (board == m5BoardChainCaptain) return m5PortPins(17, 18)
    if (board == m5BoardUnitC6L || board == m5BoardArduinoNessoN1) {
        return m5PortPins(4, 5)
    }
    if (board == m5BoardTab5) return m5PortPins(17, 52)
    if (board == m5BoardToughC5) return m5PortPins(1, 6)
    if (board == m5BoardStack || board == m5BoardStackCore2 ||
        board == m5BoardTough) return m5PortPins(36, 26)
    if (board == m5BoardPaper) return m5PortPins(33, 26)
    if (board == m5BoardStation) return m5PortPins(35, 25)
    m5PortPins(-1, -1)
}

fun M5BoardId.portC(): M5PortPins {
    val board = this.pinMapIdentity()
    if (board == m5BoardStackCoreS3 || board == m5BoardStackCoreS3SE ||
        board == m5BoardStackChan) return m5PortPins(18, 17)
    if (board == m5BoardPowerHub) return m5PortPins(1, 2)
    if (board == m5BoardUnitC6L || board == m5BoardArduinoNessoN1) {
        return m5PortPins(4, 5)
    }
    if (board == m5BoardTab5) return m5PortPins(7, 6)
    if (board == m5BoardToughC5) return m5PortPins(12, 11)
    if (board == m5BoardStack) return m5PortPins(16, 17)
    if (board == m5BoardStackCore2 || board == m5BoardTough ||
        board == m5BoardStation) return m5PortPins(13, 14)
    if (board == m5BoardPaper) return m5PortPins(19, 18)
    m5PortPins(-1, -1)
}

fun M5BoardId.portD(): M5PortPins {
    val board = this.pinMapIdentity()
    if (board == m5BoardStackCoreS3 || board == m5BoardStackCoreS3SE ||
        board == m5BoardStackChan) return m5PortPins(14, 10)
    if (board == m5BoardStack || board == m5BoardStackCore2) {
        return m5PortPins(34, 35)
    }
    if (board == m5BoardStation) return m5PortPins(36, 26)
    m5PortPins(-1, -1)
}

fun M5BoardId.portE(): M5PortPins {
    val board = this.pinMapIdentity()
    if (board == m5BoardStackCoreS3 || board == m5BoardStackCoreS3SE ||
        board == m5BoardStackChan) return m5PortPins(18, 17)
    if (board == m5BoardStack) return m5PortPins(5, 13)
    if (board == m5BoardStackCore2) return m5PortPins(27, 19)
    if (board == m5BoardStation) return m5PortPins(16, 17)
    m5PortPins(-1, -1)
}

fun M5BoardId.sdPins(): M5SdPinMap {
    val board = this.pinMapIdentity()
    if (board == m5BoardStackCoreS3 || board == m5BoardStackCoreS3SE ||
        board == m5BoardStackChan) return m5SdPinMap(36, 37, 35, -1, -1, 4)
    if (board == m5BoardCapsule) return m5SdPinMap(14, 12, 39, -1, -1, 11)
    if (board == m5BoardCardputer || board == m5BoardCardputerADV) {
        return m5SdPinMap(40, 14, 39, -1, -1, 12)
    }
    if (board == m5BoardPaperS3 || board == m5BoardPaperDIY) {
        return m5SdPinMap(39, 38, 40, -1, -1, 47)
    }
    if (board == m5BoardStampPLC) return m5SdPinMap(7, 8, 9, -1, -1, 10)
    if (board == m5BoardPaperColor) return m5SdPinMap(15, 13, 14, -1, -1, 47)
    if (board == m5BoardPaperMono) return m5SdPinMap(13, 12, 11, 10, 9, 8)
    if (board == m5BoardCoreMatrix) return m5SdPinMap(25, 27, 26, -1, -1, 28)
    if (board == m5BoardCoreP4X) return m5SdPinMap(10, 7, 8, -1, -1, 50)
    if (board == m5BoardTab5) return m5SdPinMap(43, 44, 39, 40, 41, 42)
    if (board == m5BoardToughC5) return m5SdPinMap(9, 7, 8, -1, -1, 10)
    if (board == m5BoardStack) return m5SdPinMap(18, 23, 19, -1, -1, 4)
    if (board == m5BoardStackCore2 || board == m5BoardTough) {
        return m5SdPinMap(18, 23, 38, -1, -1, 4)
    }
    if (board == m5BoardPaper) return m5SdPinMap(14, 12, 13, -1, -1, 4)
    m5SdPinMap(-1, -1, -1, -1, -1, -1)
}

fun M5BoardId.rgbLedPin(): Pin {
    val board = this.pinMapIdentity()
    if (board == m5BoardAtomS3U || board == m5BoardAtomS3Lite) return pin(35)
    if (board == m5BoardStampS3 || board == m5BoardStampPLC ||
        board == m5BoardAirQ || board == m5BoardDial ||
        board == m5BoardDinMeter || board == m5BoardCapsule ||
        board == m5BoardCardputer || board == m5BoardCardputerADV ||
        board == m5BoardPaperColor) return pin(21)
    if (board == m5BoardStampC3 || board == m5BoardStampC3U ||
        board == m5BoardUnitC6L) return pin(2)
    if (board == m5BoardNanoC6) return pin(20)
    if (board == m5BoardNanoH2) return pin(11)
    if (board == m5BoardStack) return pin(15)
    if (board == m5BoardStackCore2) return pin(25)
    if (board == m5BoardStation) return pin(4)
    if (board == m5BoardAtomLite || board == m5BoardAtomMatrix ||
        board == m5BoardAtomVoice || board == m5BoardAtomU ||
        board == m5BoardAtomPsram || board == m5BoardStampPico) return pin(27)
    pin(-1)
}

fun M5BoardId.powerHoldPin(): Pin {
    val board = this.pinMapIdentity()
    if (board == m5BoardDial || board == m5BoardCapsule ||
        board == m5BoardAirQ || board == m5BoardDinMeter) return pin(46)
    if (board == m5BoardPaperS3) return pin(44)
    if (board == m5BoardStickCPlus2) return pin(4)
    if (board == m5BoardPaper) return pin(2)
    if (board == m5BoardStackCoreInk) return pin(12)
    if (board == m5BoardTimerCam) return pin(33)
    pin(-1)
}

// Packed four-pin words avoid string-runtime allocation/indexing. Positions
// are physical1..30;0xff denotes NC/power, never a GPIO. Scalar-only lookup.
fun m5MbusCoreP4xWord(index: int): u32 =
    if (index == 0) u32(0x14ff11ff) else
    if (index == 1) u32(0x1507ffff) else
    if (index == 2) u32(0xff0a1608) else
    if (index == 3) u32(0x0e0f2526) else
    if (index == 4) u32(0x1012090b) else
    if (index == 5) u32(0x17220c27) else
    if (index == 6) u32(0xffff13ff) else
    u32(0xffffffff)
fun m5MbusTab5Word(index: int): u32 =
    if (index == 0) u32(0x11ff10ff) else
    if (index == 1) u32(0x2d12ffff) else
    if (index == 2) u32(0xff053413) else
    if (index == 3) u32(0x06072526) else
    if (index == 4) u32(0x0403201f) else
    if (index == 5) u32(0x232f3002) else
    if (index == 6) u32(0xffff33ff) else
    u32(0xffffffff)
fun m5MbusCoreS3Word(index: int): u32 =
    if (index == 0) u32(0x08ff0aff) else
    if (index == 1) u32(0x0525ffff) else
    if (index == 2) u32(0xff240923) else
    if (index == 3) u32(0x11122b2c) else
    if (index == 4) u32(0x01020b0c) else
    if (index == 5) u32(0x000d0706) else
    if (index == 6) u32(0xffff0eff) else
    u32(0xffffffff)
fun m5MbusCoreMatrixWord(index: int): u32 =
    if (index == 0) u32(0x04ff03ff) else
    if (index == 1) u32(0x051bffff) else
    if (index == 2) u32(0xff19061a) else
    if (index == 3) u32(0x08070b0a) else
    if (index == 4) u32(0x01000100) else
    if (index == 5) u32(0x09181617) else
    if (index == 6) u32(0xffff1dff) else
    u32(0xffffffff)
fun m5MbusCoreWord(index: int): u32 =
    if (index == 0) u32(0x24ff23ff) else
    if (index == 1) u32(0x1917ffff) else
    if (index == 2) u32(0xff121a13) else
    if (index == 3) u32(0x11100103) else
    if (index == 4) u32(0x05021615) else
    if (index == 5) u32(0x000f0d0c) else
    if (index == 6) u32(0xffff22ff) else
    u32(0xffffffff)
fun m5MbusCore2Word(index: int): u32 =
    if (index == 0) u32(0x24ff23ff) else
    if (index == 1) u32(0x1917ffff) else
    if (index == 2) u32(0xff121a26) else
    if (index == 3) u32(0x0e0d0103) else
    if (index == 4) u32(0x21201615) else
    if (index == 5) u32(0x0002131b) else
    if (index == 6) u32(0xffff22ff) else
    u32(0xffffffff)
fun M5BoardId.mBusPin(position: int): Pin {
    if (position < 1 || position > 30) return pin(-1)
    val board=this.pinMapIdentity();val index=(position-1)>>>2
    val word=if (board == m5BoardCoreP4X) m5MbusCoreP4xWord(index)
        else if (board == m5BoardTab5) m5MbusTab5Word(index)
        else if (board == m5BoardStackCoreS3 || board == m5BoardStackCoreS3SE || board == m5BoardStackChan) m5MbusCoreS3Word(index)
        else if (board == m5BoardCoreMatrix) m5MbusCoreMatrixWord(index)
        else if (board == m5BoardStack) m5MbusCoreWord(index)
        else if (board == m5BoardStackCore2 || board == m5BoardTough) m5MbusCore2Word(index)
        else u32(0xffffffff)
    return pin(m5DecodePin(int((word>>u32(((position-1)&3)*8))&u32(255))))
}
