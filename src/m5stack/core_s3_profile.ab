import "./i2c_pin_map.ab"
import "./speaker_profile.ab"
import "./microphone_profile.ab"
import "./touch_profile.ab"
import "./rtc_profile.ab"
// Static board identity, not an initialized device or ownership token. No
// probes, peripheral clocks or allocations. Drivers consume these existing
// profiles with their explicit startup/cleanup requirements unchanged.
// Built-in buttons are touch/PMIC-backed, so no fictitious GPIO buttonA here.
type M5CoreS3 = int
type M5CoreS3SE = int
fun m5CoreS3(): M5CoreS3 = M5CoreS3(10)
fun m5CoreS3SE(): M5CoreS3SE = M5CoreS3SE(17)
fun M5CoreS3.boardId(): M5BoardId = m5BoardStackCoreS3
fun M5CoreS3SE.boardId(): M5BoardId = m5BoardStackCoreS3SE
fun M5CoreS3.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5CoreS3SE.i2cPins(): M5I2cPinMap = this.boardId().i2cPins()
fun M5CoreS3.speakerProfile(): M5SpeakerProfile = this.boardId().speakerProfile()
fun M5CoreS3SE.speakerProfile(): M5SpeakerProfile = this.boardId().speakerProfile()
fun M5CoreS3.microphoneProfile(): M5MicrophoneProfile = this.boardId().microphoneProfile()
fun M5CoreS3SE.microphoneProfile(): M5MicrophoneProfile = this.boardId().microphoneProfile()
fun M5CoreS3.touchProfile(): M5TouchProfile = this.boardId().touchProfile()
fun M5CoreS3SE.touchProfile(): M5TouchProfile = this.boardId().touchProfile()
fun M5CoreS3.rtcKind(): M5RtcKind = this.boardId().rtcKind()
fun M5CoreS3SE.rtcKind(): M5RtcKind = this.boardId().rtcKind()
