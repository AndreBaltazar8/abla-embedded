import "./paper_s3_touch_session_sequence.ab"
import "../touch/gt911_power_sequence.ab"
// Same retained48-byte owner; no second controller owner or bus allocation.
// Returns1 transition complete,2 rejected/no IO,6 uncertain/retain ownership.
trusted fun paperS3TouchSessionPowerOwned(r: NativeBuffer,wake: bool,normalExclusive: bool): int {
    if (!normalExclusive || !r.hasAddressRange(0,48) || (r.addressValue()&3) != 0 ||
        r.loadU32(0) != 0x50335453 || r.loadU32(20) == 0 || r.loadU32(28) != 1) return 2
    val state=r.loadU32(4)
    if ((wake && state != 5 && state != 6) || (!wake && state != 2) ||
        !paperS3TouchPowerAdmission(r)) return 2
    val owner=TouchControllerOpen(((if (state == 2) 1 else state)<<40)|(2<<32)|r.loadU32(20))
    val result=if (wake) owner.wakeGt911CheckedOwned(48,true) else owner.sleepGt911CheckedOwned(48,true)
    r.storeU32(4,if (result.status() == 1) 2 else result.status())
    return if (result.status() == 6) 6 else 1
}
