import "./c6_board_profile.ab"
import "./pin_map_shared.ab"
// Maps only, with platform-selected Pin. No pad/clock/bus ownership is implied.
// Shared connector/peripheral pins must be serialized by their actual owners.
fun M5NessoN1.portA(): M5PortPins = this.boardId().portA()
fun M5NessoN1.portB(): M5PortPins = this.boardId().portB()
fun M5NessoN1.portC(): M5PortPins = this.boardId().portC()
fun M5NessoN1.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5NessoN1.internalI2cData(): Pin = pin(this.i2cPins().internalData())
fun M5NessoN1.externalI2cClock(): Pin = pin(this.i2cPins().externalClock())
fun M5NessoN1.externalI2cData(): Pin = pin(this.i2cPins().externalData())
fun M5UnitC6L.portB(): M5PortPins = this.boardId().portB()
fun M5UnitC6L.portC(): M5PortPins = this.boardId().portC()
fun M5UnitC6L.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5UnitC6L.internalI2cData(): Pin = pin(this.i2cPins().internalData())
