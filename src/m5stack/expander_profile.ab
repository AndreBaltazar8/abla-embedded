import "./board_id.ab"
// Lowbyte I2C address; nextbyte1 PI4IOE5V6408 or2 M5IOE1.
// A board/index profile is not proof that a physical device responded.
fun M5BoardId.expanderProfile(index: int): int {
    if (index < 0 || index > 1) return 0
    if (this == m5BoardTab5 || this == m5BoardTab5X || this == m5BoardArduinoNessoN1) return 256|(67+index)
    if (index != 0) return 0
    if (this == m5BoardUnitC6L || this == m5BoardStampPLC) return 256|67
    if (this == m5BoardCoreP4X || this == m5BoardChainCaptain || this == m5BoardPaperMono ||
        this == m5BoardStopWatch || this == m5BoardToughC5 || this == m5BoardCoreMatrix) return 512|79
    0
}
