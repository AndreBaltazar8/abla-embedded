import "../touch/ft5x06_device.ab"
import "../touch/transform.ab"
import "../io_expander/aw9523_device.ab"
import "./cores3_touch_read.ab"

// Default logical rotation1 + panel offset3 = raw LCD rotation0. Pass the
// same raw rotation used in LcdGeometry.view for subsequent drawing.
trusted fun cores3TouchPoint(snapshot: NativeBuffer, count: int, index: int,
    rotation: int = 0): TouchPoint =
    ft5x06SnapshotPoint(snapshot, count, index).forLcdRotation(320, 240, rotation)
