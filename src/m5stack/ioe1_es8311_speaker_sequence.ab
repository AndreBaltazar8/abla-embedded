import "./board_id.ab"
// M5Unified StopWatch/ChainCaptain speaker callbacks (MIT, M5Stack).
// Caller owns stopped capture/playback, initialized IOE1 outputs, wholecodec,
// shared audio rail, ChainGPIO21 mux/RTC/holds, control bus and stable clocks.
// Do not call under interrupt masks: enable waits10ms for the audio rail.
// Disable removes the shared audio rail, so ALL other rail users must stop.
// Failure retains ownership; retry disable before freeing buffers/handles.
// Low8:1complete,2invalid,3railwrite,4railreadback,5codec,6ampwrite,
// 7ampreadback; codec detail above8. Latch readback is not voltage proof.
trusted fun M5BoardId.ioe1Es8311SpeakerOwned(codec: Es8311,io: M5Ioe1,enabled: bool,exclusive: bool): int {
    if (!exclusive || !io.valid() || (enabled && !codec.valid()) ||
        (this != m5BoardStopWatch && this != m5BoardChainCaptain)) return 2
    val rail=if (this == m5BoardStopWatch) 2 else 4
    if (enabled) {
        if (!io.digitalWrite(rail,true)) return 3
        val high=io.getWriteValueChecked(rail)
        if (!high.valid() || high.value() == 0) return 4
        peripheralDelayMilliseconds(10)
        val configured=codec.configureSpeakerBclkOwned(true,239)
        if (configured != 1) return 5|(configured<<8)
    }
    if (this == m5BoardStopWatch) {
        if (!io.digitalWrite(9,enabled)) return 6
        val high=io.getWriteValueChecked(9)
        if (!high.valid() || (high.value() != 0) != enabled) return 7
    } else if (!Pin(21).outputLevelOwned(enabled)) return 6
    if (!enabled) {
        if (!io.digitalWrite(rail,false)) return 3
        val high=io.getWriteValueChecked(rail)
        if (!high.valid() || high.value() != 0) return 4
    }
    return 1
}
