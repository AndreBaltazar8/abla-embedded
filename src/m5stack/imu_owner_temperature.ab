import "./imu_owner_types.ab"
import "./imu_temperature.ab"
// Borrow the ready primary handle; no reprobe, allocation or close. Caller
// excludes bus jobs/acquisition and owner shutdown for the entire operation.
// Reject scratch overlapping ANY owner metadata before an I2C read can write.
trusted fun M5ImuOwner.readTemperatureOwnedWithBuffer(scratch: NativeBuffer,exclusive: bool): ImuTemperature {
    if (!exclusive || this.status() != 1 || !this.primary().ready() || !scratch.hasAddressRange(0,2)) return ImuTemperature(0)
    val owner=this.buffer().addressValue();val work=scratch.addressValue()
    if (owner < work+2 && work < owner+36) return ImuTemperature(0)
    return this.primary().readTemperatureCheckedWithBuffer(scratch)
}
trusted fun M5ImuOwner.readTemperatureOwned(exclusive: bool): ImuTemperature =
    this.readTemperatureOwnedWithBuffer(nativeBufferAt(nativeStackAllocate(2),2),exclusive)
