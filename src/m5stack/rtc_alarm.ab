import "./rtc_wake_cleanup.ab"
import "./rtc_alarm_sequence.ab"
@inline
trusted fun m5RtcConfigureAlarm(rtc: int,minute: int,hour: int,day: int,weekday: int): RtcAlarmResult =
    M5Rtc(rtc).setAlarmInterruptChecked(minute,hour,day,weekday)
trusted fun M5Rtc.setBoardAlarmInterrupt(board: M5BoardId,pmic: M5Pm1,minute: int=-1,hour: int=-1,day: int=-1,weekday: int=-1): M5RtcAlarmResult =
    m5RtcBoardAlarmOwned(board,this | 0,pmic | 0,minute,hour,day,weekday)
