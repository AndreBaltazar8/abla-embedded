import "./imu_owner_types.ab"
// Explicit prepared probing on the board's borrowed bus. Caller has initialized
// a fresh IMU owner and exclusively quiesced every other bus client. Preparation
// may restore the bus between absent candidates; never choose this implicitly
// while another client owns a transaction. No reset/reinitialize of live owners.
// -1 admission, otherwise preserve the owner/probe status and every live handle.
trusted fun pm1BoardImuOpenPreparedOwned(control: int,imu: M5ImuOwner,exclusive: bool): int {
    if (!exclusive || !pm1BoardImuAdmission(control,imu)) return -1
    return pm1BoardImuProbe(imu,pm1BoardImuBus(control))
}
