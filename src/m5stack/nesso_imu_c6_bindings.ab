import "./nesso_power_sequence.ab"
import "./nesso_i2c_profile.ab"
import "./imu_probe.ab"
import "./imu_update.ab"
// Explicit BMI270 at0x68; no MPU/other-address probing on this known board.
// Caller serializes power/IMU/bus. Returned IMU is independently owned: close
// it BEFORE power or shared-session teardown. IRQ3 is not reconfigured.
trusted fun NessoPower.openImuOwned(bus: int,exclusive: bool): M5ImuProbeResult {
    if (!exclusive || !this.ready() || this.buffer().loadU32(8) != bus || !I2cBus(bus).current() ||
        !nessoI2cPinsMatch(softwareI2cProviderOwner().lines().sda(),softwareI2cProviderOwner().lines().scl())) return M5ImuProbeResult(0)
    return m5ImuProbeCandidateOwned(bus,1)
}
// Retain failed close results. Does not sleep/reset the hardware or close bus.
trusted fun nessoImuCloseOwned(imu: M5ImuProbeResult,exclusive: bool): M5ImuProbeResult {
    if (!exclusive || imu.address() != 104 || (imu.ready() && imu.kind() != m5ImuBmi270) ||
        (!imu.ready() && imu.status() != 4)) return imu
    if (imu.handle() == 0) return M5ImuProbeResult(0)
    if (!softwareI2cProviderEnter()) return M5ImuProbeResult((4<<48)|(104<<35)|imu.handle())
    val descriptor=softwareI2cProviderPool().resolve(imu.handle())
    val matches=softwareI2cProviderOwner().matchesDevice(descriptor) && ((descriptor>>>46)&127) == 104
    val released=softwareI2cProviderLeave()
    if (!matches || !released) return imu
    if (I2cDevice(imu.handle()).close()) return M5ImuProbeResult(0)
    return M5ImuProbeResult((4<<48)|(104<<35)|imu.handle())
}
trusted fun NessoPower.readImuOwned(bus: int,imu: M5ImuProbeResult,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int,exclusive: bool): int {
    if (!exclusive || !this.ready() || this.buffer().loadU32(8) != bus || !I2cBus(bus).current() ||
        !nessoI2cPinsMatch(softwareI2cProviderOwner().lines().sda(),softwareI2cProviderOwner().lines().scl()) ||
        !imu.ready() || imu.kind() != m5ImuBmi270 || imu.address() != 104 || !snapshot.valid() || !scratch.hasAddressRange(0,20) ||
        !softwareI2cProviderBufferSafe(snapshot.buffer(),44) || !softwareI2cProviderBufferSafe(scratch,20)) return -1
    val parent=this.buffer().addressValue();val data=snapshot.buffer().addressValue();val work=scratch.addressValue()
    if ((parent < data+44 && data < parent+40) || (parent < work+20 && work < parent+40)) return -1
    if (!softwareI2cProviderEnter()) return -1
    val descriptor=softwareI2cProviderPool().resolve(imu.handle())
    val matches=softwareI2cProviderOwner().matchesDevice(descriptor) && ((descriptor>>>46)&127) == 104
    val released=softwareI2cProviderLeave()
    if (!matches || !released) return -1
    return imu.updateSnapshot(snapshot,scratch,micros)
}
