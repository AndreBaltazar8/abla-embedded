import "./pin_map_shared.ab"
// M5Unified::_setup_led choices. Profile is one16-bit scalar, not an allocated
// driver: backend3, count5, pin8. PM1 pin refers to PMIC GPIO, not ESP GPIO.
// No board detection, bus creation, power switching or hidden initialization.
val m5LedBackendNone=0
val m5LedBackendRmt=1
val m5LedBackendPm1=2
val m5LedBackendPaperMono=3
val m5LedBackendPowerHub=4
type M5LedProfile=int
fun M5LedProfile.backend(): int = this&7
fun M5LedProfile.count(): int = (this>>3)&31
fun M5LedProfile.dataPinNumber(): int = m5DecodePin((this>>8)&255)
fun M5LedProfile.available(): bool = this.backend() != 0 && this.count() != 0
fun m5LedProfile(backend: int,count: int,pinNumber: int): M5LedProfile {
    if (backend < 1 || backend > 4 || count < 1 || count > 31 || pinNumber < -1 || pinNumber > 254) return M5LedProfile(0)
    return M5LedProfile(backend|(count<<3)|((pinNumber&255)<<8))
}
fun M5BoardId.ledProfile(): M5LedProfile {
    val board=this.pinMapIdentity()
    if (board == m5BoardPowerHub) return m5LedProfile(m5LedBackendPowerHub,8,-1)
    if (board == m5BoardStampS3Bat) return m5LedProfile(m5LedBackendPm1,1,0)
    if (board == m5BoardPaperMono) return m5LedProfile(m5LedBackendPaperMono,1,-1)
    val number=board.rgbLedPin().number()
    if (number < 0) return M5LedProfile(0)
    val count=if (board == m5BoardAtomMatrix) 25 else if (board == m5BoardPaperColor) 2 else 1
    return m5LedProfile(m5LedBackendRmt,count,number)
}
