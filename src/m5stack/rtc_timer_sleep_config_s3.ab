import "../esp32/sdk/raw_buffer.ab"
import "../esp32/rtc_retention_tag_plan_s3.ab"
import "../esp32/clock_bias_s3.ab"
import "../esp32/rtc_timer_s3_sequence.ab"
import "../esp32/power/sleep_policy_esp32s3.ab"
// Pure configuration validation shared by the builder and hardware admission.
fun m5RtcSleepConfigValuesValid(bias: Esp32S3ClockBias,i: Esp32S3TagPlan,d: Esp32S3TagPlan,ports: int,options: int,ram: int,protocol: int,baseline: int,polls: int,flags: int,period: int,reject: int,milliseconds: int): bool {
    if (!i.valid() || i.dataCache() || !d.valid() || !d.dataCache() || options < 0 || options > 7 ||
        d.logical16K() != ((options&2)!=0) || ((options&2)!=0 && !d.enabled()) ||
        ((bias | 0) & ~0x1FFFFF) != 0 || ports < 0 || ports > 7 ||
        (ram != -1 && ram != 2 && ram != 3) || protocol < 0 || protocol > 63 || baseline < 0 || baseline > 63 || protocol+baseline > 63 ||
        ((options&1)!=0 && (protocol != 0 || baseline != 0)) || polls <= 0 || polls > 0x7FFFFFFF ||
        (flags & (1|2|32|512)) != 0 || !esp32S3SleepPolicy(flags).valid() ||
        reject < 0 || reject > 0x3FFFF || ((options&4)!=0) != ((flags&0x20000)!=0) ||
        milliseconds <= 0 || milliseconds > 0xFFFFFFFF) return false
    val ticks=esp32S3RtcTicksForMicroseconds(250,period)
    ticks >= 0 && ticks <= 1023
}
trusted fun m5RtcCycleWord64(config: NativeBuffer,offset: int): int = config.loadU32(offset) | (config.loadU32(offset+4)<<32)
trusted fun m5RtcCycleRam(config: NativeBuffer): int = if (config.loadU32(32) == 0xFFFFFFFF) -1 else config.loadU32(32)
trusted fun m5RtcSleepConfigValid(c: NativeBuffer): bool = c.hasAddressRange(0,64) &&
    m5RtcSleepConfigValuesValid(Esp32S3ClockBias(m5RtcCycleWord64(c,0)),Esp32S3TagPlan(m5RtcCycleWord64(c,8)),Esp32S3TagPlan(m5RtcCycleWord64(c,16)),c.loadU32(24),c.loadU32(28),m5RtcCycleRam(c),c.loadU32(36),c.loadU32(40),c.loadU32(44),c.loadU32(48),c.loadU32(52),c.loadU32(56),c.loadU32(60))
// Writes only exclusively borrowed config RAM; invalid inputs leave it intact.
// Bias and period are measured/initialized values supplied by the clock owner,
// tag plans come from actual cache geometry. No guessed board calibration.
trusted fun m5RtcSleepConfigWrite(config: NativeBuffer,bias: Esp32S3ClockBias,i: Esp32S3TagPlan,d: Esp32S3TagPlan,ports: int,flashOctal: bool,ram: int,protocol: int,baseline: int,polls: int,small: bool,monitor: bool,flags: int,period: int,reject: int,milliseconds: int): bool {
    val options=(if (flashOctal) 1 else 0) | (if (small) 2 else 0) | (if (monitor) 4 else 0)
    if (!config.hasAddressRange(0,64) || !m5RtcSleepConfigValuesValid(bias,i,d,ports,options,ram,protocol,baseline,polls,flags,period,reject,milliseconds)) return false
    config.storeU32(0,bias | 0); config.storeU32(4,(bias | 0)>>>32)
    config.storeU32(8,i | 0); config.storeU32(12,(i | 0)>>>32)
    config.storeU32(16,d | 0); config.storeU32(20,(d | 0)>>>32)
    config.storeU32(24,ports); config.storeU32(28,options); config.storeU32(32,ram)
    config.storeU32(36,protocol); config.storeU32(40,baseline); config.storeU32(44,polls)
    config.storeU32(48,flags); config.storeU32(52,period); config.storeU32(56,reject); config.storeU32(60,milliseconds)
    true
}
