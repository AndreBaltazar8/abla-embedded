import "./board_id.ab"
// Built-in M5Unified speaker callbacks (MIT, M5Stack). Caller owns stopped
// TX/RX, whole codec, initialized PM1/IOE1 outputs, affected pads and ALL
// shared audio rail users. Bus routing/clocks/pad holds are caller-owned.
// AtomVoiceS3R controlbus SDA45/SCL0 conflicts with its IMU; quiesce it first.
// 1 callback complete,2 invalid,3powerwrite,4powerreadback,5codec failure
// (codec detail above8),6amplifierwrite/readback. IOE1boards delegate their
// precise status schema. Failure may leave hardware active: retain ownership.
// IMPORTANT: Cardputer ADV disable is an upstream no-op, NOT proof of silence
// or codec shutdown. Stop/park TX separately before any disable callback.
// PaperColor disable removes sharedcodec rail; microphone must also be stopped.
trusted fun M5BoardId.es8311SpeakerOwned(codec: Es8311,power: M5Pm1,io: M5Ioe1,
    enabled: bool,exclusive: bool): int {
    if (!exclusive || (enabled && !codec.valid())) return 2
    if (this == m5BoardStopWatch || this == m5BoardChainCaptain)
        return this.ioe1Es8311SpeakerOwned(codec,io,enabled,true)
    if (this != m5BoardStickS3 && this != m5BoardPaperColor &&
        this != m5BoardCardputerADV && this != m5BoardAtomVoiceS3R) return 2
    if (this == m5BoardStickS3) {
        if (!power.valid()) return 2
        if (!power.setGpioOutput(3,enabled)) return 3
        val latch=power.gpioOutputLatchBitsChecked()
        if (!latch.valid() || ((latch.value()&8) != 0) != enabled) return 4
    }
    if (this == m5BoardPaperColor) {
        // Enable rail then amplifier, matching upstream. Disable amplifier
        // before sharedrail for safe shutdown; neither step is silently ignored.
        if (enabled) {
            if (!Pin(45).outputLevelOwned(true)) return 3
            if (!Pin(46).outputLevelOwned(true)) return 6
        } else {
            if (!Pin(46).outputLevelOwned(false)) return 6
            if (!Pin(45).outputLevelOwned(false)) return 3
        }
    }
    if (enabled) {
        val volume=if (this == m5BoardPaperColor) 207 else if (this == m5BoardAtomVoiceS3R) 255 else 191
        val configured=codec.configureSpeakerBclkOwned(true,volume)
        if (configured != 1) return 5|(configured<<8)
    }
    if (this == m5BoardAtomVoiceS3R && !Pin(18).outputLevelOwned(enabled)) return 6
    return 1
}
