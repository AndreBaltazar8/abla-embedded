import "./expander_power_read_sequence.ab"
import "../io_expander/m5ioe1_device.ab"
import "../io_expander/pi4ioe5v6408_device.ab"
@inline
trusted fun expanderPowerReadLatch(handle: int,pin: int,m5: bool): I2cByteResult =
    if (m5) M5Ioe1(handle).getWriteValueChecked(pin) else Pi4Ioe5v6408(handle).getWriteValueChecked(pin)
// Borrowed initialized expanders. Unused handles need not be allocated.
trusted fun M5BoardId.expanderPowerEnabledChecked(ioe0: I2cDevice,ioe1: I2cDevice,port: int): I2cByteResult =
    this.expanderPowerEnabledCheckedOwned(ioe0 | 0,ioe1 | 0,port)
