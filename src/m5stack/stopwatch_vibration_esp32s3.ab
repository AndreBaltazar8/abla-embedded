import "./pm1_control_esp32s3.ab"
import "./vibration.ab"
import "./stopwatch_vibration_sequence.ab"
trusted fun stopWatchVibrationHandle(control: int): int {
    val c=M5Pm1Control(control)
    if (!c.ready() || c.board() != m5BoardStopWatch) return 0
    val handle=c.expanders().device(0)|0
    val descriptor=esp32S3I2cDevicePool().resolve(handle)
    return if (esp32S3I2cDeviceKeyMatchesBus(descriptor,c.bus()) &&
        esp32S3I2cDeviceKeyAddress(descriptor) == 79 && esp32S3I2cDeviceKeyFrequency(descriptor) == 100000) handle else 0
}
trusted fun stopWatchVibrationFrequency(handle: int): int {
    val result=M5Ioe1(handle).device().readRegister16LittleEndianChecked(37)
    return if (result.valid()) result.value() else -1
}
// Caller owns the motor and shared IOE PWM frequency for the whole call;
// does not close the borrowed board, alter frequency or reset other channels.
trusted fun M5Pm1Control.setStopWatchVibrationOwned(level: int,exclusive: bool): M5VibrationResult =
    stopWatchVibrationOwned(this|0,level,exclusive)
