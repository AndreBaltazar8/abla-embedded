import "./codec_channels_pump_p4_sequence.ab"
type CoreP4xChannelsPump=int
fun CoreP4xChannelsPump.status(): int = this&255
fun CoreP4xChannelsPump.pending(): bool = (this&256) != 0
fun CoreP4xChannelsPump.index(): int = (this >>> 9)&4095
trusted fun coreP4xPumpChannelsOwned(state: CoreP4xChannelsPump,r: NativeBuffer,bank: PcmChannels,
    accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,gain: int,exclusive: bool,tone: PcmTone=PcmTone(0)): CoreP4xChannelsPump =
    CoreP4xChannelsPump(m5P4PumpChannelsOwned(M5P4ChannelsPump(state|0),r,bank,accumulator,scratch,staging,gain,exclusive,false,tone)|0)
trusted fun coreP4xPumpSourceQueuesOwned(state: CoreP4xChannelsPump,r: NativeBuffer,queues: PcmSourceQueues,
    accumulator: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,gain: int,exclusive: bool): CoreP4xChannelsPump =
    CoreP4xChannelsPump(m5P4PumpChannelsOwned(M5P4ChannelsPump(state|0),r,PcmChannels(0),accumulator,scratch,staging,gain,exclusive,false,PcmTone(0),queues)|0)
