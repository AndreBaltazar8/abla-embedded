import "./tough_power_owner_view.ab"
import "./toughc5_tone.ab"
// Managed child blocks parent software close and sleep admission until
// silence/frequency restoration succeeds. Caller keeps the exact parent and
// child immutable and alive; no raw tone/PWM edits beside this managed API.
fun toughToneParentDisjoint(parent: M5ToughPowerOwner,r: NativeBuffer): bool = toughToneStorage(r) &&
    (r.addressValue()+32 <= parent.buffer().addressValue() || parent.buffer().addressValue()+96 <= r.addressValue())
trusted fun M5ToughPowerOwner.beginToneOwned(r: NativeBuffer,frequency: int,duty: int,now: int,duration: int,exclusiveSharedPwm: bool): int {
    if (!exclusiveSharedPwm || this.status() != 1 || this.toneRetained() || !this.bootResult().powerReady() || this.bootResult().buzzerDegraded() ||
        !this.pmic().ready() || this.pmic().kind() != 5 || !toughToneParentDisjoint(this,r) || r.loadU32(0) != 0) return 2
    this.buffer().storeU32(24,r.addressValue())
    // Successful nondegraded boot proves PWM-off and normalized GPIO4.
    val result=toughToneStartOwned(r,this.pmic(),M5ToughBuzzerSetup(769),frequency,duty,now,duration,true)
    if (result == 2) this.buffer().storeU32(24,0)
    return result
}
trusted fun M5ToughPowerOwner.toneMatches(r: NativeBuffer): bool = this.status() == 1 && toughToneParentDisjoint(this,r) &&
    r.loadU32(0) == 0x544f4e45 && this.pmic().ready() && this.pmic().kind() == 5 && this.pmic().deviceHandle() == r.loadU32(8) &&
    (this.buffer().loadU32(24) == r.addressValue() || (this.buffer().loadU32(24) == 0 && r.loadU32(4) == 6))
trusted fun M5ToughPowerOwner.pollToneOwned(r: NativeBuffer,now: int,exclusiveSharedPwm: bool): int {
    if (!exclusiveSharedPwm || !this.toneMatches(r)) return 2
    val result=toughTonePollOwned(r,now,true)
    if (result == 6) this.buffer().storeU32(24,0)
    return result
}
trusted fun M5ToughPowerOwner.stopToneOwned(r: NativeBuffer,exclusiveSharedPwm: bool): int {
    if (!exclusiveSharedPwm || !this.toneMatches(r)) return 2
    val result=toughToneStopOwned(r,true)
    if (result == 6) this.buffer().storeU32(24,0)
    return result
}
