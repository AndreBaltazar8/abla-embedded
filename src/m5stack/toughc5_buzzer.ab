import "./board_id.ab"
import "./pmic_types.ab"
import "../power/m5pm1_device.ab"

// Status1 PWM-ready and off,2 degraded GPIO-low fallback,3 unconfirmed safety,
// 4 invalid PMIC,5 unsupported board. Bit8 PWM-off acknowledged; bit9 all pin
// normalization writes acknowledged. Degraded is NOT successful PWM setup.
type M5ToughBuzzerSetup = int
fun M5ToughBuzzerSetup.status(): int = this & 255
fun M5ToughBuzzerSetup.valid(): bool = this.status() == 1
fun M5ToughBuzzerSetup.silentConfigured(): bool = this.status() == 1 || this.status() == 2
fun M5ToughBuzzerSetup.pwmStopped(): bool = (this & 256) != 0
fun M5ToughBuzzerSetup.pinsNormalized(): bool = (this & 512) != 0

// Explicit boot setup: PM1 persists across ESP resets. Import alongside a
// peripheralDelayMilliseconds backend. Retry failed PWM stop/fallback at 10ms,
// at most three attempts each. Never select PWM until stop AND normalization
// succeeded. Unlike upstream, failed normalization cannot masquerade as success.
// Attempt GPIO fallback even after pin/PWM-selection failure. All four pin
// writes are attempted to maximize cleanup, but none of their errors is hidden.
trusted fun M5BoardId.configureToughBuzzer(pmic: M5PmicOpen): M5ToughBuzzerSetup {
    if (this != m5BoardToughC5) return M5ToughBuzzerSetup(5)
    if (!pmic.ready() || pmic.kind() != 5) return M5ToughBuzzerSetup(4)
    val pm1=M5Pm1(pmic.deviceHandle())
    var stopped=false
    var attempt=0
    while (attempt < 3 && !stopped) {
        stopped=pm1.setPwmDuty12(1,0,false,false)
        attempt=attempt+1
        if (!stopped && attempt < 3) peripheralDelayMilliseconds(10)
    }
    val drive=pm1.setGpioDrive(4,m5Pm1GpioPushPull)
    val pull=pm1.setGpioPull(4,m5Pm1GpioPullNone)
    val latch=pm1.setGpioOutput(4,false)
    val mode=pm1.setGpioMode(4,m5Pm1GpioOutput)
    val normalized=drive && pull && latch && mode
    val flags=(if (stopped) 256 else 0)|(if (normalized) 512 else 0)
    if (stopped && normalized && pm1.setGpioFunction(4,m5Pm1GpioFunctionSpecial))
        return M5ToughBuzzerSetup(1|flags)
    var fallback=false
    attempt=0
    while (attempt < 3 && !fallback) {
        fallback=pm1.setGpioFunction(4,m5Pm1GpioFunctionGpio)
        attempt=attempt+1
        if (!fallback && attempt < 3) peripheralDelayMilliseconds(10)
    }
    M5ToughBuzzerSetup((if (fallback && normalized) 2 else 3)|flags)
}
