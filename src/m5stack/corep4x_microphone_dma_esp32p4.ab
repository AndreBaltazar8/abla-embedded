import "./corep4x_microphone_dma_sequence.ab"
import "../esp32/i2s/stereo_microphone_dma_esp32p4.ab"
import "../hal/esp32_i2s.ab"
import "../hal/m5stack.ab"
@export("p4CoreMicParked")
trusted fun p4CoreMicParkedHook(channel: int): int = p4StereoMicParked(channel)
@export("p4CoreMicI2sStopped")
trusted fun p4CoreMicI2sStoppedHook(): bool = p4StereoMicI2sStopped()
