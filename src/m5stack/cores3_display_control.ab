import "../io_expander/aw9523_device.ab"
import "../power/axp2101_device.ab"

// CoreS3/CoreS3SE LCD-only controls, matching M5GFX's panel/light wiring.
// Import with the selected I2C backend and peripheral delay provider. Caller
// owns device handles and serializes board initialization against other users.
// Power rails must already be initialized; these helpers never reset the AW9523.
trusted fun cores3DisplayReset(expander: Aw9523): bool {
    // Latch low before enabling the output. Only P1_1 (linear pin 9) changes.
    if (!expander.digitalWrite(9, false) ||
        !expander.setGpioMode(9, true) || !expander.setDirection(9, true)) return false
    peripheralDelayMilliseconds(8)
    if (!expander.digitalWrite(9, true)) return false
    peripheralDelayMilliseconds(64)
    true
}

fun cores3DisplayBrightnessCode(brightness: int): int =
    if (brightness < 0 || brightness > 255) -1
    else if (brightness == 0) 0 else (brightness + 641) >> 5

trusted fun cores3DisplaySetBrightness(power: Axp2101, brightness: int): bool {
    val code = cores3DisplayBrightnessCode(brightness)
    if (!power.valid() || code < 0) return false
    val device = power.device()
    // Program voltage before enabling, so a previously disabled rail cannot
    // briefly use an old setting. Disable before clearing voltage on shutdown.
    // On transport failure report false; never claim atomic multi-write rollback.
    if (code == 0) return device.updateRegister8(144, 128, 0) &&
        device.writeRegister8(153, 0)
    device.writeRegister8(153, code) && device.updateRegister8(144, 128, 128)
}
