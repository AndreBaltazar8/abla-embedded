// Bit zero is the logical pressed level and bit one marks a successful read.
// A bus failure therefore never aliases an active-low press.
type M5ButtonRead = int

fun m5ButtonRead(valid: bool, pressed: bool = false): M5ButtonRead =
    M5ButtonRead((if (pressed) 1 else 0) | (if (valid) 2 else 0))

fun M5ButtonRead.valid(): bool = (this & 2) != 0
fun M5ButtonRead.pressed(): bool = this.valid() && (this & 1) != 0
