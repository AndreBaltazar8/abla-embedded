import "./speaker_profile.ab"
// Preparation only, not running/powered playback. Own BOTH stopped I2S
// directions and old/new pad/input users; stable PLL160M, parked TX GDMA and
// initialized internal PCM ring. No volume scaling here: caller/mixer applies
// profile gain. Mono DMA is one signed16 sample/frame, stereo is L,R pairs.
// Both modes transmit two wire slots. Caller retains resources on failure.
trusted fun M5BoardId.prepareEs8311PlaybackOwned(hz: int,channel: int,desc: int,count: int,
    payload: int,bytes: int,owner: u32,exclusive: bool): Esp32S3StandardDmaPreparation {
    if (!exclusive || (this != m5BoardStickS3 && this != m5BoardStopWatch && this != m5BoardChainCaptain &&
        this != m5BoardPaperColor && this != m5BoardCardputerADV && this != m5BoardAtomVoiceS3R)) return Esp32S3StandardDmaPreparation(2)
    val profile=this.speakerProfile()
    return esp32s3PrepareStandard16Dma(profile.port(),true,pin(profile.masterClockPin()),pin(profile.bitClockPin()),
        pin(profile.wordSelectPin()),pin(profile.dataPin()),3,hz,channel,desc,count,payload,bytes,owner,!profile.stereo())
}
