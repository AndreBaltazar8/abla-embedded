import "./speaker_profile.ab"
import "../esp32/pwm_session_c6_sequence.ab"
// Continuous square-wave tone, not Speaker_Class PCM synthesis or volume/gain.
// Caller provides fresh 88B session storage and the full PWM exclusive lease,
// qualified GPIO11, pinned GPIO/source clocks and calibrated CPU delay timing.
// Stop with c6PwmSessionCloseOwned, retaining storage/clocks until status5.
// Start failures retain the attempted session exactly as the generic driver.
trusted fun M5BoardId.openC6BuzzerOwned(record: NativeBuffer,source: int,sourceHz: int,
    hz: int,timer: int,channel: int,polls: int,exclusive: bool): int {
    if (this != m5BoardArduinoNessoN1 && this != m5BoardUnitC6L) return 2
    val profile=this.speakerProfile()
    if (profile.transport() != m5SpeakerBuzzer || profile.dataPin() != 11) return 2
    return c6PwmSessionOpenOwned(record,source,sourceHz,hz,8,timer,channel,
        profile.dataPin(),128,polls,exclusive)
}
