import "./cores3_output_sequence.ab"
import "../power/axp2101_device.ab"
import "../hal/m5stack.ab"
import "../i2c/device.ab"
import "../hal/m5stack_3.ab"
import "../power/axp2101_type.ab"
import "../i2c/results.ab"
import "../hal/i2cdevice.ab"
@export("cores3OutputStatus")
trusted fun cores3OutputStatusHook(handle: int): I2cByteResult = I2cDevice(handle).readRegister8Checked(0)
@export("cores3OutputTs")
trusted fun cores3OutputTsHook(handle: int): I2cWordResult = Axp2101(handle).read14(54)
@export("cores3OutputLatches")
trusted fun cores3OutputLatchesHook(handle: int): I2cWordResult = I2cDevice(handle).readRegister16LittleEndianChecked(2)
@export("cores3OutputWrite")
trusted fun cores3OutputWriteHook(handle: int,value: int): bool = I2cDevice(handle).writeRegister16LittleEndian(2,value)
// Borrowed, initialized AW9523/AXP2101 devices. Caller serializes the complete
// read-modify-write operation. Does not allocate, reset or change directions.
trusted fun M5BoardId.setCoreS3Output(expander: I2cDevice,pmic: Axp2101,usb: bool,enabled: bool): CoreS3OutputResult =
    this.setCoreS3OutputOwned(expander | 0,pmic | 0,usb,enabled)
