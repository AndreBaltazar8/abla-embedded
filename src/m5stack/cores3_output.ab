import "./cores3_output_sequence.ab"
import "../power/axp2101_device.ab"
trusted fun cores3OutputStatus(handle: int): I2cByteResult = I2cDevice(handle).readRegister8Checked(0)
trusted fun cores3OutputTs(handle: int): I2cWordResult = Axp2101(handle).read14(54)
trusted fun cores3OutputLatches(handle: int): I2cWordResult = I2cDevice(handle).readRegister16LittleEndianChecked(2)
trusted fun cores3OutputWrite(handle: int,value: int): bool = I2cDevice(handle).writeRegister16LittleEndian(2,value)
// Borrowed, initialized AW9523/AXP2101 devices. Caller serializes the complete
// read-modify-write operation. Does not allocate, reset or change directions.
trusted fun M5BoardId.setCoreS3Output(expander: I2cDevice,pmic: Axp2101,usb: bool,enabled: bool): CoreS3OutputResult =
    this.setCoreS3OutputOwned(expander | 0,pmic | 0,usb,enabled)
