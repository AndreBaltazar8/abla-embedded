import "./tab5_reset_sequence.ab"
import "../esp32/i2c/software_provider_p4.ab"
// Caller owns GPIO23 (safe mux/latch, holds released), stopped display/touch,
// powered board and scratch. Provider admission spans ALL register RMWs and
// delays; other transfers/close/allocation fail busy rather than interleave.
// Reset statuses1..9 as low-level sequence;10admission busy,11preparation fault.
// Any partial reset requires explicit recovery and explicit new reset attempt.
// Report status7 is a lifecycle-reset fault sentinel, not a wire byte count.
trusted fun I2cBus.resetTab5DisplayTouchOwned(scratch: NativeBuffer): int {
    if (!this.valid() || !p4SoftwareProviderBufferSafe(scratch,1)) return 2
    if (!p4SoftwareProviderEnter()) return 10
    var result=2
    if (this.current()) {
        val lines=p4SoftwareProviderOwner().lines()
        if (lines.sda() == 31 && lines.scl() == 32) {
            result=11
            if (p4SoftwareProviderPrepare() == 1) {
                result=tab5DisplayTouchResetOwned(lines,scratch)
                p4SoftwareProviderStore(16,if (result == 1) 0 else 7)
                p4SoftwareProviderStore(20,0)
            }
        }
    }
    if (!p4SoftwareProviderLeave()) return 10
    return result
}
