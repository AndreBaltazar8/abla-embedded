import "./papermono_touch_esp32s3.ab"
import "./ft5x06_power_esp32s3.ab"
trusted fun M5Pm1Control.sleepPaperMonoTouchOwned(touch: TouchControllerOpen,exclusive: bool): TouchControllerOpen {
    if (!exclusive || touch.kind() != 1 || !paperMonoTouchHandleAdmission(this|0,touch.handle())) return touch
    return m5BoardPaperMono.sleepFt5x06TouchOwned(I2cBus(this.bus()),touch,true)
}
trusted fun M5Pm1Control.wakePaperMonoTouchOwned(touch: TouchControllerOpen,exclusive: bool): TouchControllerOpen {
    if (!exclusive || touch.kind() != 1 || !paperMonoTouchHandleAdmission(this|0,touch.handle())) return touch
    return m5BoardPaperMono.wakeFt5x06TouchOwned(I2cBus(this.bus()),touch,true)
}
