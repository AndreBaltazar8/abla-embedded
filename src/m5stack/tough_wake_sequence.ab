import "./tough_boot_types.ab"
import "../esp32/gpio/c5_wake_sequence.ab"
// Invoke only on ESP32C5 after peripheral initialization, with GPIO4 owned and
// global sleep/force hold released. Preserve failure details, presence and
// buzzer degradation. Held-pad or partial setup can be retried after resolving
// the cause, WITHOUT clearing wake events or restarting charger/buzzer setup.
trusted fun M5ToughBoot.finishC5WakeInputOwned(): M5ToughBoot {
    val peripheralStage=this.peripheralsReady() && this.stage() == 4
    val retry=this.status() == 6 && this.stage() == 5
    if (!peripheralStage && !retry) return this
    val flags=(this | 0)&~4294967295
    if (!esp32C5ConfigureGpio4WakeInputOwned()) return M5ToughBoot(flags|6|(5<<8))
    M5ToughBoot(flags|(if (this.buzzerDegraded()) 2 else 1)|(5<<8))
}
