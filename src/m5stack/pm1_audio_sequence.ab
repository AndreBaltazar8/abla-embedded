import "./ioe1_es8311_speaker_sequence.ab"
import "./es8311_microphone_sequence.ab"
// Borrow control/bus; the returned codec is independently owned. Allocation
// does not power/configure hardware. Close after stopping both I2S directions
// and disabling the amplifier, before closing control. Never duplicate owners.
trusted fun pm1BoardAudioOpenOwned(control: int,exclusive: bool): Es8311 {
    if (!exclusive || !pm1BoardAudioAdmission(control)) return Es8311(0)
    return pm1BoardAudioAllocate(pm1BoardAudioBus(control))
}
// Whole codec/rail, stopped TX AND RX, stable clocks and prepared PA pad.
// No implicit concurrent full duplex: the two profiles reset shared registers.
// Status8 is board/codec admission failure, with no hardware writes.
trusted fun pm1BoardSpeakerOwned(control: int,codec: Es8311,enabled: bool,exclusive: bool): int {
    if (!exclusive || !pm1BoardAudioAdmission(control) ||
        (enabled && !pm1BoardAudioCodecMatches(control,codec))) return 8
    return pm1BoardAudioBoard(control).ioe1Es8311SpeakerOwned(codec,pm1BoardAudioExpander(control),enabled,true)
}
trusted fun pm1BoardMicrophoneOwned(control: int,codec: Es8311,enabled: bool,exclusive: bool): int {
    if (!exclusive || !pm1BoardAudioAdmission(control) || !pm1BoardAudioCodecMatches(control,codec)) return 8
    return pm1BoardAudioBoard(control).es8311MicrophoneOwned(codec,pm1BoardAudioExpander(control),enabled,true)
}
