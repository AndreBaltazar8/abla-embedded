import "./display_map.ab"
import "./cores3_panel_logic.ab"
import "../display/mipi_programs.ab"

// Complete command phase only: board power, reset, detected panel revision,
// initialized hardware SPI and inactive other CS lines are prerequisites.
// Unknown revisions are rejected, never guessed. The E-specific program is
// additional to the ordinary ILI9342 initialization, not a replacement.
// Keep the backlight off until this succeeds; no automatic power/reset here.
trusted fun M5BoardId.beginCoreS3SpiDisplay(gate: PeripheralGate, owner: u32,
    panel: int): SpiTransactionResult {
    if (!this.displaySharedDataCommand() ||
        (panel != cores3PanelIli9342C && panel != cores3PanelIli9342E)) return SpiTransactionResult(3 << 32)
    val extra = if (panel == cores3PanelIli9342E) ili9342EInitProgram() else nativeBufferAt(0,0)
    this.spiDisplay().beginRgb565(gate, owner, this.displayGeometry(), this.displayRotation(),
        ili9342InitProgram(), extra, true, true)
}
