import "./expander_owner.ab"
import "./pmic_types.ab"
import "../power/m5pm1_device.ab"

// Status1 complete phase,2 unsupportedboard,3 notready,4 I/O failure.
// Bits8..15 acknowledge operations within this phase, not whole-board readiness.
type M5CoreMatrixPowerSetup = int
fun M5CoreMatrixPowerSetup.status(): int = this & 255
fun M5CoreMatrixPowerSetup.appliedSteps(): int = (this>>>8)&255
fun M5CoreMatrixPowerSetup.valid(): bool = this.status() == 1

// Configure peripherals after PM1 and expander begin. Establishes boost,
// KEY1/2/3 inputs, BMI270 INT1 input, and PM1 IRQ output high before selecting
// IRQ function. No IRQ status clearing: pending wake events remain available.
// Caller must then restore ESP GPIO2 to digital input/pullup after RTC wake
// and update battery presence; those CPU/policy operations are not I2C setup.
// No rollback: an I/O failure leaves acknowledged operations applied.
trusted fun M5Expanders.configureCoreMatrixPowerInputs(pmic: M5PmicOpen): M5CoreMatrixPowerSetup {
    if (!this.ready() || !pmic.ready() || pmic.kind() != 5) return M5CoreMatrixPowerSetup(3)
    if (this.board() != m5BoardCoreMatrix) return M5CoreMatrixPowerSetup(2)
    val inputs=pmic.configureCoreMatrixPm1Inputs()
    if (!inputs.valid()) return inputs
    if (!M5Ioe1(this.device(0) | 0).setDirection(7,false)) return M5CoreMatrixPowerSetup(4|(14<<8))
    return M5CoreMatrixPowerSetup(1|(15<<8))
}
// Separate PM1 phase allows the native ESP IRQ pad handoff before CHG_STAT,
// matching upstream Power.begin ordering. No PM1 interrupt acknowledgement.
trusted fun M5PmicOpen.configureCoreMatrixPm1Inputs(): M5CoreMatrixPowerSetup {
    if (!this.ready() || this.kind() != 5) return M5CoreMatrixPowerSetup(3)
    val pmic=this
    val pm1=M5Pm1(pmic.deviceHandle())
    if (!pm1.setExtOutput(true)) return M5CoreMatrixPowerSetup(4)
    var pin=0
    while (pin < 3) {
        if (!pm1.setGpioFunction(pin,m5Pm1GpioFunctionGpio)) return M5CoreMatrixPowerSetup(4|((1+pin)<<8))
        pin=pin+1
    }
    pin=0
    while (pin < 3) {
        if (!pm1.setGpioMode(pin,m5Pm1GpioInput)) return M5CoreMatrixPowerSetup(4|((4+pin)<<8))
        pin=pin+1
    }
    if (!pm1.setGpioFunction(4,m5Pm1GpioFunctionGpio)) return M5CoreMatrixPowerSetup(4|(7<<8))
    if (!pm1.setGpioMode(4,m5Pm1GpioInput)) return M5CoreMatrixPowerSetup(4|(8<<8))
    if (!pm1.setGpioMode(3,m5Pm1GpioOutput)) return M5CoreMatrixPowerSetup(4|(9<<8))
    if (!pm1.setGpioDrive(3,m5Pm1GpioPushPull)) return M5CoreMatrixPowerSetup(4|(10<<8))
    if (!pm1.setGpioPull(3,m5Pm1GpioPullUp)) return M5CoreMatrixPowerSetup(4|(11<<8))
    if (!pm1.setGpioOutput(3,true)) return M5CoreMatrixPowerSetup(4|(12<<8))
    if (!pm1.setGpioFunction(3,m5Pm1GpioFunctionIrq)) return M5CoreMatrixPowerSetup(4|(13<<8))
    M5CoreMatrixPowerSetup(1|(14<<8))
}

// Final upstream phase, after input setup and battery presence sampling.
// TF rail is IOE0 bit0 (upstream gpio1). Caller checks each phase result before proceeding.
trusted fun M5Expanders.configureCoreMatrixSdPower(): M5CoreMatrixPowerSetup {
    if (!this.ready()) return M5CoreMatrixPowerSetup(3)
    if (this.board() != m5BoardCoreMatrix) return M5CoreMatrixPowerSetup(2)
    val ioe=M5Ioe1(this.device(0) | 0)
    if (!ioe.setHighImpedance(0,false)) return M5CoreMatrixPowerSetup(4)
    if (!ioe.setDirection(0,true)) return M5CoreMatrixPowerSetup(4|(1<<8))
    if (!ioe.digitalWrite(0,true)) return M5CoreMatrixPowerSetup(4|(2<<8))
    M5CoreMatrixPowerSetup(1|(3<<8))
}
// Matrix rail: IOE0 G3 (upstream labels this physical PIN4/LEDS_EN).
// Caller waits20ms after success before touching TM1680 at0x72.
trusted fun M5Expanders.configureCoreMatrixMatrixPower(): M5CoreMatrixPowerSetup {
    if (!this.ready()) return M5CoreMatrixPowerSetup(3)
    if (this.board() != m5BoardCoreMatrix) return M5CoreMatrixPowerSetup(2)
    val ioe=M5Ioe1(this.device(0)|0)
    if (!ioe.setHighImpedance(3,false)) return M5CoreMatrixPowerSetup(4)
    if (!ioe.setDirection(3,true)) return M5CoreMatrixPowerSetup(4|(1<<8))
    if (!ioe.digitalWrite(3,true)) return M5CoreMatrixPowerSetup(4|(2<<8))
    return M5CoreMatrixPowerSetup(1|(3<<8))
}
