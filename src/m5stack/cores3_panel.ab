import "../touch/ft5x06_device.ab"
import "./cores3_panel_logic.ab"

// M5GFX CoreS3 touch firmware identifies the fitted ILI9342 revision.
// Keep unknown identity distinct from transport failure; neither selects C.
// Board owns the FT5x06 at 0x38, opened at 100kHz for version detection.
// Run only during serialized initialization after touch power/reset settling:
// entering work mode changes controller state. No ownership/close is hidden.
trusted fun cores3ReadPanelIdentity(touch: Ft5x06): int {
    if (!touch.valid()) return cores3PanelInvalidDevice
    val device = touch.device()
    if (!device.writeRegister8(0, 0)) return cores3PanelTransportFailure
    val firmware = device.readRegister8Checked(166)
    if (!firmware.valid()) return cores3PanelTransportFailure
    val vendor = device.readRegister8Checked(168)
    if (!vendor.valid()) return cores3PanelTransportFailure
    // Upstream CIPHER(0xA3) is diagnostic only; it is not an identity condition.
    cores3PanelIdentity(firmware.value(), vendor.value())
}

// Same five-attempt bound as upstream. Delay only between attempts; propagate
// the last failure/unknown result instead of upstream's implicit C fallback.
trusted fun cores3DetectPanel(touch: Ft5x06): int {
    if (!touch.valid()) return cores3PanelInvalidDevice
    var attempt = 0
    var result = cores3PanelUnknown
    while (attempt < 5) {
        result = cores3ReadPanelIdentity(touch)
        if (result == cores3PanelIli9342C || result == cores3PanelIli9342E) return result
        attempt = attempt + 1
        if (attempt < 5) peripheralDelayMilliseconds(20)
    }
    result
}
