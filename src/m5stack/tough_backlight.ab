import "../io_expander/m5ioe1_device.ab"
// M5GFX ToughC5: PIN10 (zero-based9), PWM4 (zero-based3), 1kHz.
// Exact gamma2 curve; minimum nonzero setting remains visible.
fun toughBacklightDuty(brightness: int): int {
    if (brightness < 0 || brightness > 255) return -1
    val duty=int((u32(brightness)*u32(brightness)*u32(4095)+u32(32512))/u32(65025))
    return if (brightness != 0 && duty == 0) 1 else duty
}
// All other expander PWM users must accept 1kHz and remain quiesced during
// initialization. The frequency is SHARED, not a private backlight setting.
// Caller holds a live board IOE device and exclusive PIN10/PWM4 ownership.
// Blank before changing pad drive; output latch/other pins are preserved.
// Status1complete3admission4I/O failure; completed writes at bits8..15.
// Failures retain partial state, including uncertain brightness after NACK.
trusted fun toughBacklightBeginOwned(io: M5Ioe1,brightness: int,exclusiveSharedPwm: bool): int {
    val duty=toughBacklightDuty(brightness)
    if (!exclusiveSharedPwm || (io|0) <= 0 || (io|0) > 0xffffffff || duty < 0) return 3
    if (!io.setPwmDuty12(3,0)) return 4
    if (!io.setPwmFrequency(1000)) return 4|(1<<8)
    if (!io.setHighImpedance(9,false)) return 4|(2<<8)
    if (!io.setDirection(9,true)) return 4|(3<<8)
    if (!io.setPwmDuty12(3,duty)) return 4|(4<<8)
    return 1|(5<<8)
}
// Initialized PIN10/PWM4 only. Does not retune other PWM channels.
trusted fun toughBacklightSetOwned(io: M5Ioe1,brightness: int,exclusive: bool): int {
    val duty=toughBacklightDuty(brightness)
    if (!exclusive || (io|0) <= 0 || (io|0) > 0xffffffff || duty < 0) return 3
    return if (io.setPwmDuty12(3,duty)) 1 else 4
}
