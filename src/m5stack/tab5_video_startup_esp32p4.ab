import "./tab5_video_startup_sequence.ab"
import "./tab5_video_shutdown_esp32p4.ab"
trusted fun tab5OwnedStartupMasked(): bool = p4DispatchMasked()
trusted fun tab5OwnedStartupPrepare(mailbox: NativeBuffer,table: NativeBuffer,layout: int,line: int,priority: int): int {
    val dispatch=p4IrqDispatchAt(table)
    val core=p4DispatchCore()
    if (!dispatch.valid() || !p4DispatchMasked() || core != table.loadU32(4) ||
        esp32P4DsiEventMask(layout) == 0 || line < 16 || line > 47 || priority < 1 || priority > 7) return 2
    if (table.loadU32(8) != 0 || table.loadU32(16+(line-16)*8) != 0 ||
        ((p4ClicReadConfig()>>>1)&15) != 3 || p4DispatchLineEnabled(line) ||
        (p4ClicReadByte(p4ClicLineAddress(line))&1) != 0 || p4DsiIrqSourceEnabled(layout) != 0 ||
        p4DsiIrqRouteRead(layout,core) != 0 || p4DsiIrqRouteRead(layout,1-core) != 0) return 3
    return if (p4DsiMailboxAt(mailbox).initialize(core,layout,line)) 1 else 2
}
trusted fun tab5OwnedStartupIrq(mailbox: NativeBuffer,table: NativeBuffer,priority: int): int =
    esp32P4DsiIrqOpenOwned(p4DsiMailboxAt(mailbox),p4IrqDispatchAt(table),priority)
