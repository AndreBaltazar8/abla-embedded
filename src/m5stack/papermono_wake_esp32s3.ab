import "./pm1_control_esp32s3.ab"
import "./papermono_panel_reset.ab"
import "../display/ssd1677_init_esp32s3.ab"
import "./papermono_wake_sequence.ab"
trusted fun paperMonoWakeBufferSafe(buffer: NativeBuffer,length: int,control: NativeBuffer): bool =
    esp32S3I2cFacadeBufferSafe(buffer,length,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
    ssd1677FrameDisjoint(buffer,length,control,72)
trusted fun paperMonoWakeAdmission(control: int,session: Ssd1677Session,gate: PeripheralGate): bool {
    val c=M5Pm1Control(control);val address=gate.word().address()
    return c.ready() && c.board() == m5BoardPaperMono && address > 0 && address <= 4294967292 && gate.word().valid() &&
        paperMonoWakeBufferSafe(nativeBufferAt(address,4),4,c.buffer()) &&
        paperMonoWakeBufferSafe(session.buffer(),64,c.buffer()) &&
        paperMonoWakeBufferSafe(session.canvas(),96000,c.buffer()) &&
        paperMonoWakeBufferSafe(session.history(),96000,c.buffer()) &&
        gate.bufferDisjoint(session.buffer(),64) && gate.bufferDisjoint(session.canvas(),96000) && gate.bufferDisjoint(session.history(),96000)
}
trusted fun paperMonoWakeSelect(): bool = Pin(16).outputLevelOwned(true)
trusted fun paperMonoWakeReset(control: int): int = paperMonoPanelResetOwned(M5Ioe1(M5Pm1Control(control).expanders().device(0)|0),true)
trusted fun paperMonoWakeInitializeOwned(polls: int): int = esp32s3Ssd1677InitializeOwned(2,Pin(16),Pin(17),Pin(18),polls)
trusted fun M5Pm1Control.wakePaperMonoPanelOwned(session: Ssd1677Session,gate: PeripheralGate,owner: u32,polls: int,exclusive: bool): SpiTransactionResult =
    paperMonoWakeOwned(this|0,session,gate,owner,polls,exclusive)
