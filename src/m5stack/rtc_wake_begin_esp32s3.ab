import "./rtc_wake_begin_s3_sequence.ab"
import "./rtc_timer_wake_esp32s3.ab"
import "./rtc_wake_cancel_esp32s3.ab"
@inline
trusted fun m5RtcWakeBeginReleased(record: NativeBuffer): bool = esp32S3ExternalWakeReleasedOwned(record)
trusted fun M5Rtc.beginBoardTimerWakeS3Owned(board: M5BoardId,pmic: M5Pm1,wake: NativeBuffer,report: NativeBuffer,milliseconds: int,clocksUnchangedExclusive: bool): int =
    m5RtcWakeBeginS3Owned(board,this | 0,pmic | 0,wake,report,milliseconds,clocksUnchangedExclusive)
