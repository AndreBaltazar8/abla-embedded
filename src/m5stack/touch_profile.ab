import "./board_id.ab"
// Verified M5GFX.cpp controller wiring, not autodetection or permission to
// configure shared pads. Zero means not mapped here, NOT no touch hardware.
// One scalar: kind3/address7/IRQ6/SDA6/SCL6/port1/width12/height12/rotation3.
// GPIO fields store number+1. Width/height are RAW controller extents.
// Kinds1 FT5x06,2 GT911,3 CHSC6540,4 CST816S,5 CST3530,6 ST7123.
type M5TouchProfile = int
fun m5TouchProfile(kind: int,address: int,irq: int,sda: int,scl: int,port: int,width: int,height: int,rotation: int = 0): M5TouchProfile {
    if (kind < 1 || kind > 6 || address < 8 || address > 119 || irq < -1 || irq > 62 ||
        sda < 0 || sda > 62 || scl < 0 || scl > 62 || sda == scl || port < 0 || port > 1 ||
        width < 1 || width > 4095 || height < 1 || height > 4095 || rotation < 0 || rotation > 7)
        return M5TouchProfile(0)
    M5TouchProfile(kind|(address<<3)|((irq+1)<<10)|((sda+1)<<16)|((scl+1)<<22)|(port<<28)|(width<<29)|(height<<41)|(rotation<<53))
}
fun M5TouchProfile.kind(): int = this&7
fun M5TouchProfile.valid(): bool = (this>>>56) == 0 && this.kind() >= 1 && this.kind() <= 6 &&
    this.address() >= 8 && this.address() <= 119 && this.sdaNumber() >= 0 && this.sclNumber() >= 0 &&
    this.sdaNumber() != this.sclNumber() && this.rawWidth() > 0 && this.rawHeight() > 0
fun M5TouchProfile.address(): int = (this>>>3)&127
fun M5TouchProfile.interruptNumber(): int = ((this>>>10)&63)-1
fun M5TouchProfile.sdaNumber(): int = ((this>>>16)&63)-1
fun M5TouchProfile.sclNumber(): int = ((this>>>22)&63)-1
fun M5TouchProfile.port(): int = (this>>>28)&1
fun M5TouchProfile.rawWidth(): int = (this>>>29)&4095
fun M5TouchProfile.rawHeight(): int = (this>>>41)&4095
fun M5TouchProfile.rotationOffset(): int = (this>>>53)&7
fun M5TouchProfile.frequency(): int = if (this.valid()) 400000 else 0
fun M5BoardId.touchProfile(): M5TouchProfile {
    if (this == m5BoardStackCore2) return m5TouchProfile(1,56,39,21,22,1,320,280)
    if (this == m5BoardTough) return m5TouchProfile(3,46,39,21,22,1,320,240)
    // C5 wiring uses CHSC6540 without a GPIO IRQ; upstream defaults to HP I2C0.
    // A separately configured LP provider may use the same pads explicitly.
    if (this == m5BoardToughC5) return m5TouchProfile(3,46,-1,2,3,0,320,240)
    if (this == m5BoardStopWatch) return m5TouchProfile(4,21,13,47,48,1,234,234)
    if (this == m5BoardCoreP4X) return m5TouchProfile(5,88,1,11,9,1,480,480,2)
    if (this == m5BoardStackCoreS3 || this == m5BoardStackCoreS3SE)
        return m5TouchProfile(1,56,21,12,11,1,320,240)
    // Paper uses upstream's normal (non _M5EPD_H_) bus1 and default0x14.
    // A device strapped to0x5d needs an explicit address choice, not a scan.
    if (this == m5BoardPaper) return m5TouchProfile(2,20,36,21,22,1,540,960,1)
    if (this == m5BoardPaperS3) return m5TouchProfile(2,20,48,41,42,1,540,960,1)
    if (this == m5BoardPaperMono) return m5TouchProfile(1,56,4,47,48,1,480,800)
    if (this == m5BoardDial) return m5TouchProfile(1,56,14,11,12,1,240,240)
    if (this == m5BoardArduinoNessoN1) return m5TouchProfile(1,56,3,10,8,0,135,240)
    M5TouchProfile(0)
}
