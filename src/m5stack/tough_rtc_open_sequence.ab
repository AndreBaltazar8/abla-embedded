import "./tough_power_owner_view.ab"
import "./rtc_open_sequence.ab"
// RX8130 begin changes control/IRQ configuration. The caller must consume
// wanted wake events first, keep power/bus owner live, and own RTC consumers.
// Status6 rejects admission without allocation or I/O. The opened RTC is
// independently owned; close it before the borrowed power owner/bus.
trusted fun M5ToughPowerOwner.openRtcOwned(bus: int,exclusive: bool,wakeEventsConsumed: bool): M5RtcOpenResult {
    if (!exclusive || !wakeEventsConsumed || this.status() != 1 || !this.bootResult().powerReady() ||
        !this.pmic().ready() || this.pmic().kind() != 5 || !toughRtcBusOwnsPmic(bus,this.pmic().deviceHandle())) return M5RtcOpenResult(6<<40)
    return m5RtcOpenOwned(bus,m5BoardToughC5)
}
