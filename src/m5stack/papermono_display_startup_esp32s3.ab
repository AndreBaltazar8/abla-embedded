import "./papermono_panel_startup_esp32s3.ab"
import "./papermono_frontlight_esp32s3.ab"
import "../display/ssd1677_session_esp32s3.ab"
import "./papermono_display_startup_sequence.ab"
trusted fun paperMonoDisplayStorageAdmission(control: int,r: NativeBuffer,canvas: NativeBuffer,history: NativeBuffer,gate: PeripheralGate): bool {
    if (!paperMonoPanelAdmission(control,gate)) return false
    val c=M5Pm1Control(control)
    return esp32S3I2cFacadeBufferSafe(r,64,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        esp32S3I2cFacadeBufferSafe(canvas,96000,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        esp32S3I2cFacadeBufferSafe(history,96000,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        ssd1677FrameDisjoint(r,64,c.buffer(),72) && ssd1677FrameDisjoint(canvas,96000,c.buffer(),72) &&
        ssd1677FrameDisjoint(history,96000,c.buffer(),72) && gate.bufferDisjoint(r,64) &&
        gate.bufferDisjoint(canvas,96000) && gate.bufferDisjoint(history,96000) &&
        esp32s3SpiMemoryRangeValid(2,canvas,96000) && esp32s3SpiMemoryRangeValid(2,history,96000)
}
trusted fun paperMonoDisplayFrontlight(control: int,level: int,initialize: bool): int =
    if (initialize) M5Pm1Control(control).preparePaperMonoFrontlightOwned(level,true)
    else M5Pm1Control(control).paperMonoFrontlightOwned(level,true)
trusted fun paperMonoDisplayPanelStartup(control: int,gate: PeripheralGate,owner: u32,polls: int): int =
    M5Pm1Control(control).preparePaperMonoPanelOwned(gate,owner,polls,true)
trusted fun paperMonoDisplayRefresh(session: Ssd1677Session,gate: PeripheralGate,owner: u32,mode: int,polls: int): SpiTransactionResult =
    session.refreshOwned(gate,owner,2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),mode,polls,true)
trusted fun M5Pm1Control.initializePaperMonoDisplayOwned(record: NativeBuffer,canvas: NativeBuffer,history: NativeBuffer,
    gate: PeripheralGate,owner: u32,mode: int,brightness: int,polls: int,exclusive: bool): int =
    paperMonoDisplayStartupOwned(this|0,record,canvas,history,gate,owner,mode,brightness,polls,exclusive)
