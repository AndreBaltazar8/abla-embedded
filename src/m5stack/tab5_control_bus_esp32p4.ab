import "./tab5_control_bus_sequence.ab"
import "../esp32/i2c_software_esp32p4.ab"
// Caller-exclusive lifecycle, not a replacement for the provider's transaction
// admission. No other thread may open/reconfigure/close the provider during it.
trusted fun tab5ControlProviderFree(): bool = p4SoftwareProviderLoad(24) == 0
trusted fun tab5ControlClockOpen(layout: int): int = esp32P4IomuxClockOpenOwned(layout)|0
trusted fun tab5ControlClockClose(clock: int): int = Esp32P4IomuxClockOwner(clock).closeOwned()|0
trusted fun tab5ControlHold(layout: int,pin: int): int = esp32P4GpioIndividualHoldOwned(layout,pin)
trusted fun tab5ControlBusOpen(): int = i2cSoftwareMaster(31,32,5,2000)|0
trusted fun tab5ControlBusPartial(): bool = p4SoftwareProviderLoad(24) == 2 && p4SoftwareProviderLoad(28) == 0
trusted fun tab5ControlBusClose(bus: int): bool = I2cBus(bus).close()
trusted fun tab5ControlBusAbort(): bool = esp32P4SoftwareI2cAbortSetup()
fun Tab5ControlBus.bus(): I2cBus = I2cBus(if (this.ready()) this.busHandle() else 0)
