import "./tab5_control_bus_sequence.ab"
import "../esp32/i2c_software_esp32p4.ab"
import "../hal/m5stack.ab"
import "../hal/esp32.ab"
import "../i2c/device.ab"
import "../hal/m5stack_2.ab"
// Caller-exclusive lifecycle, not a replacement for the provider's transaction
// admission. No other thread may open/reconfigure/close the provider during it.
@export("tab5ControlProviderFree")
trusted fun tab5ControlProviderFreeHook(): bool = p4SoftwareProviderLoad(24) == 0
@export("tab5ControlClockOpen")
trusted fun tab5ControlClockOpenHook(layout: int): int = esp32P4IomuxClockOpenOwned(layout)|0
@export("tab5ControlClockClose")
trusted fun tab5ControlClockCloseHook(clock: int): int = Esp32P4IomuxClockOwner(clock).closeOwned()|0
@export("tab5ControlHold")
trusted fun tab5ControlHoldHook(layout: int,pin: int): int = esp32P4GpioIndividualHoldOwned(layout,pin)
@export("tab5ControlBusOpen")
trusted fun tab5ControlBusOpenHook(): int = i2cSoftwareMaster(31,32,5,2000)|0
@export("tab5ControlBusPartial")
trusted fun tab5ControlBusPartialHook(): bool = p4SoftwareProviderLoad(24) == 2 && p4SoftwareProviderLoad(28) == 0
@export("tab5ControlBusClose")
trusted fun tab5ControlBusCloseHook(bus: int): bool = I2cBus(bus).close()
@export("tab5ControlBusAbort")
trusted fun tab5ControlBusAbortHook(): bool = esp32P4SoftwareI2cAbortSetup()
fun Tab5ControlBus.bus(): I2cBus = I2cBus(if (this.ready()) this.busHandle() else 0)
