import "./stopwatch_touch_logic.ab"
import "../touch/cst816s_session_sequence.ab"
// Assign the returned session before reading the report. Preserve CST init,
// throttle and cleanup semantics; out-of-range StopWatch coordinates are a
// malformed report, NOT an empty report and NOT a clamped edge contact.
trusted fun Cst816sSession.pollStopWatchOwned(snapshot: NativeBuffer,now: int): Cst816sSession {
    val next=this.pollOwned(snapshot,now)
    if (next.status() == 1 && !cst816sPoint(snapshot).inside(234,234))
        return Cst816sSession((next&~(7<<33))|(4<<33))
    return next
}
// Snapshot belongs to this session's most recent poll; caller serializes it.
// Only a fresh contact authorizes projection. Use reportCount()==0 for release;
// invalid point alone must never be interpreted as a release event.
trusted fun Cst816sSession.stopWatchDisplayPoint(snapshot: NativeBuffer,rotation: int): TouchPoint =
    if (this.handle() == 0 || !this.initialized() || this.status() != 1) TouchPoint(0)
    else cst816sPoint(snapshot).forStopWatchDisplay(rotation)
