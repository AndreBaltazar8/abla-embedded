import "./expander_open_sequence.ab"
import "../io_expander/pi4ioe5v6408_device.ab"
import "../io_expander/m5ioe1_device.ab"
trusted fun m5ExpanderBusValid(bus: int): bool = I2cBus(bus).valid()
trusted fun m5ExpanderAllocate(bus: int,address: int,frequency: int): int = I2cBus(bus).device(address,frequency) | 0
trusted fun m5ExpanderBegin(handle: int,kind: int): bool =
    if (kind == 1) Pi4Ioe5v6408(handle).begin() else M5Ioe1(handle).begin()
trusted fun m5ExpanderClose(handle: int): bool = I2cDevice(handle).close()
// Caller owns initialized bus. Opens one slot; successful begin transfers
// device ownership to the result. PI4 begin reads ID; M5IOE begin also writes
// I2C config23h=0. No output, rail, direction, or whole-chip reset operations.
trusted fun M5BoardId.openExpander(bus: I2cBus,index: int = 0): M5ExpanderOpen = this.openExpanderOwned(bus | 0,index)
fun M5ExpanderOpen.device(): I2cDevice = I2cDevice(if (this.ready()) this.deviceHandle() else 0)
trusted fun M5ExpanderOpen.release(): M5ExpanderOpen = this.releaseOwned()
