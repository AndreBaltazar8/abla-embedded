import "./papermono_sd_owner_sequence.ab"
import "./papermono_sdmmc_close_esp32s3.ab"
import "../sd/mmc_negotiate_esp32s3.ab"
import "../sd/mmc_transfer_clock_esp32s3.ab"
trusted fun paperMonoSdOwnerAdmission(control: int,storage: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer): bool {
    val c=M5Pm1Control(control)
    if (!c.ready() || c.board() != m5BoardPaperMono || !sdMmcDmaRegionsValid(descriptor,payload,8) ||
        !sdMmcNegotiationSeparate(storage,432,descriptor,16) || !sdMmcNegotiationSeparate(storage,432,payload,8)) return false
    val address=c.buffer().addressValue()
    return esp32S3I2cFacadeBufferSafe(storage,432,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        esp32S3I2cFacadeBufferSafe(descriptor,16,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        esp32S3I2cFacadeBufferSafe(payload,8,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        (storage.addressValue()+432 <= address || storage.addressValue() >= address+72) &&
        (descriptor.addressValue()+16 <= address || descriptor.addressValue() >= address+72) &&
        (payload.addressValue()+8 <= address || payload.addressValue() >= address+72)
}
trusted fun paperMonoSdOwnerBegin(control: int,startup: NativeBuffer,pads: NativeBuffer,slot: int,pll: bool,now: u32,budget: int): int =
    paperMonoSdMmcBeginOwned(control,startup,pads,slot,pll,now,budget,true)
trusted fun paperMonoSdOwnerStartupPoll(startup: NativeBuffer,now: u32,us: u32): int = sdMmcStartupPollOwned(startup,now,us)
trusted fun paperMonoSdOwnerNegotiateBegin(context: NativeBuffer,startup: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer,
    width: int,now: u32,budget: int): int = sdMmcNegotiationBeginOwned(context,sdMmcStartupCard(startup),descriptor,payload,width,now,budget,true)
trusted fun paperMonoSdOwnerNegotiatePoll(context: NativeBuffer,now: u32): int = sdMmcNegotiationPollOwned(context,now)
trusted fun paperMonoSdOwnerClockBegin(context: NativeBuffer,startup: NativeBuffer,now: u32,budget: int): int =
    sdMmcTransferClockBeginOwned(context,sdMmcStartupCard(startup),startup.load(6) != 0,25000000,600,now,budget,true)
trusted fun paperMonoSdOwnerClockPoll(context: NativeBuffer,now: u32,us: u32): int =
    sdMmcTransferClockPollOwned(context,now,us)
trusted fun paperMonoSdOwnerReady(startup: NativeBuffer,context: NativeBuffer,clock: NativeBuffer): bool =
    sdMmcStartupStatus(startup) == 1 && sdMmcNegotiationStatus(context) == 1 &&
    sdMmcTransferClockStatus(clock) == 1 && sdMmcCardBlockCount(sdMmcStartupCard(startup)) > 0
trusted fun paperMonoSdOwnerClose(startup: NativeBuffer,pads: NativeBuffer): int = paperMonoSdMmcCloseOwned(startup,pads,true)
