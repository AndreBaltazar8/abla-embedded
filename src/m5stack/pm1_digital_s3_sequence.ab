import "./board_id.ab"
import "../esp32/gpio/input_s3_sequence.ab"
import "../esp32/gpio/output_s3_sequence.ab"
// M5Unified startup pinMode/gpio_lo sequences (M5Stack, MIT).
// Caller owns ALL selected pads; prior peripheral/RTC/USB users are stopped,
// RTC mux/holds released, sleep prevented. No implicit RTC wake disarming.
// Configures floating button inputs and ChainCaptain GPIO21 amplifier OFF.
// No snapshots/rollback: failed phases retain pad ownership and partial effects.
// Low8:1complete2unsupported3notowned4inputfailure5amplifierfailure.
// Completed pins in bits8..15. This is not a codec or full-board startup.
trusted fun M5BoardId.configurePm1DigitalOwned(exclusiveDigitalReleased: bool): int {
    if (this != m5BoardChainCaptain && this != m5BoardPaperMono && this != m5BoardStopWatch) return 2
    if (!exclusiveDigitalReleased) return 3
    val count=if (this == m5BoardChainCaptain) 3 else 2
    var index=0
    while (index < count) {
        val pin=if (this == m5BoardChainCaptain) (if (index == 0) 1 else index+3)
            else if (this == m5BoardPaperMono) index+2 else index+1
        if (esp32S3GpioPrepareInputOwned(pin,3,true) != 1) return 4|(index<<8)
        index=index+1
    }
    if (this == m5BoardChainCaptain && !esp32S3GpioOutputLevelOwned(21,false)) return 5|(3<<8)
    return 1|((if (this == m5BoardChainCaptain) 4 else 2)<<8)
}
