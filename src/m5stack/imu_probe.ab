import "./imu_probe_sequence.ab"
import "../imu/mpu6886_device.ab"
import "../imu/bmi270_device.ab"
import "../imu/sh200q_device.ab"
@inline
trusted fun m5ImuProbeAllocate(bus: int,address: int): int =
    if (I2cBus(bus).valid()) I2cBus(bus).device(address,400000) & 0xFFFFFFFF else 0
@inline
trusted fun m5ImuProbeBegin(handle: int,candidate: int): int =
    if (candidate == 0) Mpu6886(handle).begin() else if (candidate == 3) Sh200q(handle).begin() else Bmi270(handle).begin()
@inline
trusted fun m5ImuProbeMpuKind(handle: int): M5ImuKind {
    val identity=I2cDevice(handle).readRegister8Checked(117)
    if (!identity.valid()) return M5ImuKind(0)
    val value=identity.value()
    if (value == 104) m5ImuMpu6050 else if (value == 25) m5ImuMpu6886 else if (value == 113) m5ImuMpu9250 else M5ImuKind(0)
}
@inline
trusted fun m5ImuProbeRelease(handle: int): bool = I2cDevice(handle).close()
// Caller provides initialized bus and imuDelay provider. Probe order follows
// M5Unified: MPU, BMI at68 then69, SH200Q. External magnetometers are separate.
trusted fun m5ImuProbe(bus: I2cBus): M5ImuProbeResult = m5ImuProbeOwned(bus | 0)
