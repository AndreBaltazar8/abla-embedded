import "./tab5_panel_start_sequence.ab"
import "./tab5_panel_detect_esp32p4.ab"
import "../display/tab5_dsi_init_esp32p4.ab"
import "./tab5_video_esp32p4.ab"
trusted fun tab5PanelStartCommands(panel: int,channel: int,polls: int): DsiCommandResult = tab5DsiInitEsp32P4(panel,channel,polls)
// Borrow initialized panel and ready DSI/DMA owners; caller retains the
// returned video ownership even on failure. No service may run until startup
// succeeds. Descriptor/frame leases and cache/RCC serialization stay external.
trusted fun Tab5PanelStart.openVideoOwned(hwVersion: int,channel: int,dmaChannel: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): Tab5VideoStart =
    if (!this.ready()) Tab5VideoStart(2) else
    tab5VideoOpenOwned(this.panel(),hwVersion,this.laneKbps(),channel,dmaChannel,descriptor,frame,line,polls)
