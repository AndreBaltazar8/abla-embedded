import "./rtc_sleep_finish_s3_sequence.ab"
import "./rtc_wake_profile.ab"
// Consume a prepared+retention-armed cycle and always finish after entry.
// Caller already completed board RTC wake begin, clock preparation and
// retention arm; owns powered RTC/PM1, all records/DMA buffers, and quiescence.
// Complete closure, stack and report must remain in retained internal memory
// until finish completes. No automatic scheduler/radio/peer suspension.
// 16-byte report: signed entry result0, run status4, exact finish result8..15.
// Return1 woke+restored,2 invalid/no mutation,3 rejected/refused+restored,
// 4 restoration incomplete. For2 ownership is unchanged: explicitly finish
// or correct the input; for4 retry finish, NEVER run/enter again.
// Report must additionally be disjoint from CPU/tag retention buffers and
// active stack, which remain owned by the caller and are not passed here.
@section(".iram1.abla.s3BoardRtcSleepRun")
@noinline
trusted fun m5RtcSleepRunPreparedS3Owned(board: M5BoardId,rtc: int,pmic: int,sleep: NativeBuffer,wake: NativeBuffer,report: NativeBuffer,flags: int,period: int,reject: int,polls: int,quiescedExclusive: bool): int {
    if (!quiescedExclusive ||
        (board != m5BoardPaperColor && board != m5BoardPaperMono && board != m5BoardStampPLC) ||
        !esp32S3SleepWakeRecordsDisjoint(sleep,wake) || !report.hasAddressRange(0,16) ||
        (report.addressValue() < sleep.addressValue()+128 && sleep.addressValue() < report.addressValue()+16) ||
        (report.addressValue() < wake.addressValue()+176 && wake.addressValue() < report.addressValue()+16) ||
        polls <= 0 || polls > 0x7FFFFFFF || !m5RtcCleanupRtcValid(rtc) || !m5RtcTimerSupported(rtc) ||
        (board.rtcNeedsPmicCleanup() && !m5RtcCleanupPmicValid(pmic))) return 2
    if (sleep.loadU32(0) != 0x53504C50 || sleep.loadU32(4) != 9 || sleep.loadU32(104) != 1 ||
        wake.loadU32(0) != 0x45585453 || wake.loadU32(4) != 1 || wake.loadU32(8) != 1 || wake.loadU32(12) != 1 ||
        wake.loadU32(16) != 0x45585430 || wake.loadU32(20) != board.rtcWakeProfile().pinNumber() || wake.loadU32(24) != 0) return 2
    report.storeU32(4,0)
    val entry=esp32S3SleepExternalEnterOwned(sleep,wake,flags,period,reject)
    report.storeU32(0,entry)
    val finished=m5RtcSleepFinishS3Owned(board,rtc,pmic,sleep,wake,polls)
    report.storeU32(8,finished | 0); report.storeU32(12,(finished | 0)>>>32)
    val status=if (!finished.complete()) 4 else if (entry == 0) 1 else 3
    report.storeU32(4,status)
    status
}
