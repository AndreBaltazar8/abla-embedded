import "../touch/cst816s_session_sequence.ab"
// Caller completed shared OLED/touch reset and owns IRQ13 released from RTC,
// other pad functions/holds. No repeated reset or treating pulse IRQ as contact.
// Returns an owned PENDING CST session, not a promise the chip responded.
// Caller retains session until close succeeds, polling to finish initialization.
// Failure before allocation leaves no device to close; pad changes remain owned.
trusted fun stopWatchTouchOpenOwned(control: int,exclusive: bool): Cst816sSession {
    if (!exclusive || !stopWatchTouchAdmission(control)) return Cst816sSession(0)
    if (!stopWatchTouchPrepareIrq()) return Cst816sSession(0)
    return cst816sSessionOwned(stopWatchTouchAllocate(control))
}
