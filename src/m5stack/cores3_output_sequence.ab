import "./board_id.ab"
import "../i2c/results.ab"
import "../power/axp2101_logic.ab"
// Status1 success,2 unsupported board,3 invalid argument,4 safety read failure,
// 5 safety veto,6 expander read failure,7 write failure (may be partial).
type CoreS3OutputResult = int
fun CoreS3OutputResult.status(): int = this | 0
fun CoreS3OutputResult.valid(): bool = this == 1
trusted fun M5BoardId.setCoreS3OutputOwned(expander: int,pmic: int,usb: bool,enabled: bool): CoreS3OutputResult {
    if (this != m5BoardStackCoreS3 && this != m5BoardStackCoreS3SE && this != m5BoardStackChan) return CoreS3OutputResult(2)
    if (expander <= 0 || expander > 4294967295 || (!usb && enabled && (pmic <= 0 || pmic > 4294967295))) return CoreS3OutputResult(3)
    // Only external BUS enable uses the upstream battery/TS/VBUS veto.
    // Failed reads are explicit failures, never substituted with false/zero.
    if (!usb && enabled) {
        val battery=cores3OutputStatus(pmic)
        if (!battery.valid()) return CoreS3OutputResult(4)
        if ((battery.value() & 8) == 0) {
            val ts=cores3OutputTs(pmic)
            if (!ts.valid()) return CoreS3OutputResult(4)
            if (ts.value() > 4000 && axp2101AdcValid(ts.value())) {
                val vbus=cores3OutputStatus(pmic)
                if (!vbus.valid()) return CoreS3OutputResult(4)
                if ((vbus.value() & 32) != 0) return CoreS3OutputResult(5)
            }
        }
    }
    val ports=cores3OutputLatches(expander)
    if (!ports.valid()) return CoreS3OutputResult(6)
    val mask=if (usb) 32 else 2
    val p0=if (enabled) (ports.value() & 255)|mask else (ports.value() & 255)&~mask
    var p1=((ports.value()>>>8)&255)|128
    // Match the actual upstream BUS-only condition, not its commented-out
    // BUS|USB alternative. Unrelated latch bits survive the burst write.
    if (!enabled && (p0 & 2) == 0) p1=p1 & ~128
    if (!cores3OutputWrite(expander,p0|(p1<<8))) return CoreS3OutputResult(7)
    CoreS3OutputResult(1)
}
