import "../hal/native_buffer.ab"
@export("chainDisplayAdmission")
trusted fun chainDisplayAdmissionHook(control: int,gate: PeripheralGate): bool {
    val c=M5Pm1Control(control)
    val address=gate.word().address()
    if (!c.ready() || c.board() != m5BoardChainCaptain || !gate.word().valid() ||
        address <= 0 || address > 4294967292 || !gate.bufferDisjoint(c.buffer(),72) ||
        !esp32S3I2cFacadeBufferSafe(nativeBufferAt(address,4),4,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return false
    // Caller excludes other bus users for the entire multi-phase lifecycle.
    return nativeAddressLoadU32(address,0) == 0
}
@export("chainDisplaySelectInactive")
trusted fun chainDisplaySelectInactiveHook(): bool = Pin(45).outputLevelOwned(true)
@export("chainDisplayPrepareOff")
trusted fun chainDisplayPrepareOffHook(control: int): int =
    chainCaptainBacklightPrepareOwned(M5Ioe1(M5Pm1Control(control).expanders().device(0)|0),0,true)
@export("chainDisplayPower")
trusted fun chainDisplayPowerHook(control: int,reset: bool): int =
    chainCaptainDisplayPowerOwned(M5Ioe1(M5Pm1Control(control).expanders().device(0)|0),reset,true)
@export("chainDisplaySpi")
trusted fun chainDisplaySpiHook(gate: PeripheralGate,owner: u32): SpiTransactionResult = chainCaptainSpiInitializeOwned(gate,owner,true)
@export("chainDisplayPanel")
trusted fun chainDisplayPanelHook(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult = chainCaptainPanelBeginOwned(gate,owner,rotation)
@export("chainDisplayClear")
trusted fun chainDisplayClearHook(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult = chainCaptainPanelClearOwned(gate,owner,rotation)
@export("chainDisplayBrightness")
trusted fun chainDisplayBrightnessHook(control: int,brightness: int): bool =
    M5Ioe1(M5Pm1Control(control).expanders().device(0)|0).setChainCaptainBacklightOwned(brightness)
@export("chainDisplayBlank")
trusted fun chainDisplayBlankHook(control: int): bool = chainDisplayBrightness(control,0)
trusted fun M5Pm1Control.initializeChainDisplayOwned(gate: PeripheralGate,owner: u32,reset: bool,
    rotation: int,brightness: int,exclusive: bool): ChainCaptainDisplayStartup =
    chainCaptainDisplayStartupOwned(this|0,gate,owner,reset,rotation,brightness,exclusive)
