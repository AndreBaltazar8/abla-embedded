import "./chaincaptain_display_startup_sequence.ab"
import "./chaincaptain_display_esp32s3.ab"
import "./chaincaptain_spi_esp32s3.ab"
import "./chaincaptain_panel_esp32s3.ab"
import "../spi/buffer_gate.ab"
trusted fun chainDisplayAdmission(control: int,gate: PeripheralGate): bool {
    val c=M5Pm1Control(control)
    val address=gate.word().address()
    if (!c.ready() || c.board() != m5BoardChainCaptain || !gate.word().valid() ||
        address <= 0 || address > 4294967292 || !gate.bufferDisjoint(c.buffer(),72) ||
        !esp32S3I2cFacadeBufferSafe(nativeBufferAt(address,4),4,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)) return false
    // Caller excludes other bus users for the entire multi-phase lifecycle.
    return nativeAddressLoadU32(address,0) == 0
}
trusted fun chainDisplaySelectInactive(): bool = Pin(45).outputLevelOwned(true)
trusted fun chainDisplayPrepareOff(control: int): int =
    chainCaptainBacklightPrepareOwned(M5Ioe1(M5Pm1Control(control).expanders().device(0)|0),0,true)
trusted fun chainDisplayPower(control: int,reset: bool): int =
    chainCaptainDisplayPowerOwned(M5Ioe1(M5Pm1Control(control).expanders().device(0)|0),reset,true)
trusted fun chainDisplaySpi(gate: PeripheralGate,owner: u32): SpiTransactionResult = chainCaptainSpiInitializeOwned(gate,owner,true)
trusted fun chainDisplayPanel(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult = chainCaptainPanelBeginOwned(gate,owner,rotation)
trusted fun chainDisplayClear(gate: PeripheralGate,owner: u32,rotation: int): SpiTransactionResult = chainCaptainPanelClearOwned(gate,owner,rotation)
trusted fun chainDisplayBrightness(control: int,brightness: int): bool =
    M5Ioe1(M5Pm1Control(control).expanders().device(0)|0).setChainCaptainBacklightOwned(brightness)
trusted fun chainDisplayBlank(control: int): bool = chainDisplayBrightness(control,0)
trusted fun M5Pm1Control.initializeChainDisplayOwned(gate: PeripheralGate,owner: u32,reset: bool,
    rotation: int,brightness: int,exclusive: bool): ChainCaptainDisplayStartup =
    chainCaptainDisplayStartupOwned(this|0,gate,owner,reset,rotation,brightness,exclusive)
