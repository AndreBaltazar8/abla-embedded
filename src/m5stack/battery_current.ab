import "./axp_power.ab"
import "../power/ina3221_device.ab"
import "../power/ina226_device.ab"
// Actual bound chip selects the classic-board source. CoreS3's AXP2101 has
// no equivalent current sensor here: report unavailable, not a fabricated0.
trusted fun M5BoardId.axpBatteryMilliampsChecked(power: M5AxpPower,monitor: Ina3221): PowerMeasurement {
    if (!power.valid() || this.powerKind() != m5PowerAxp192Or2101) return PowerMeasurement(0)
    if (power.identity() == 3) return Axp192(power.device() | 0).batteryMilliampsChecked()
    monitor.currentMilliampsChecked(0)
}
// Tab's shunt is reversed: positive board current means charge. The monitor
// must already carry successful calibration; this never reconfigures it.
trusted fun M5BoardId.tabBatteryMilliampsChecked(monitor: Ina226): PowerMeasurement {
    if (this != m5BoardTab5 && this != m5BoardTab5X) return PowerMeasurement(0)
    val value=monitor.currentMilliampsChecked()
    if (value.valid()) powerMeasurement(-value.value()) else PowerMeasurement(0)
}
