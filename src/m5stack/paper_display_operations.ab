import "./paper_display_owner_sequence.ab"
// Parent-aware operations protect ALL retained metadata, including the shared
// gate, not only the child session. All physical-bus clients must obey that gate.
// Serialization still belongs to the caller; this is not a second nested lock.
trusted fun M5PaperDisplayOwner.bufferSafe(buffer: NativeBuffer,count: int): bool =
    paperDisplayDisjoint(this.buffer(),312,buffer,count) && this.controller().disjoint(buffer,count) &&
    this.gate().bufferDisjoint(buffer,count)
trusted fun M5PaperDisplayOwner.loadFullOwned(pixels: NativeBuffer,stride: int,scratch: NativeBuffer,
    polls: int,attempts: int,exclusive: bool): It8951ImageResult {
    if (!exclusive || this.state() != 1 || !this.held() || this.controller().state() != 1 ||
        !this.controller().info().valid() || stride < (this.controller().info().width()+1)/2 || stride > 2147483647 ||
        !this.bufferSafe(scratch,14)) return It8951ImageResult(2)
    val bytes=(this.controller().info().height()-1)*stride+(this.controller().info().width()+1)/2
    if (!this.bufferSafe(pixels,bytes)) return It8951ImageResult(2)
    this.controller().loadFullOwned(pixels,stride,scratch,polls,attempts,true)
}
trusted fun M5PaperDisplayOwner.refreshFullOwned(mode: int,scratch: NativeBuffer,polls: int,
    attempts: int,exclusive: bool): It8951ImageResult {
    if (!exclusive || this.state() != 1 || !this.held() || !this.bufferSafe(scratch,14)) return It8951ImageResult(2)
    this.controller().refreshFullOwned(mode,scratch,polls,attempts,true)
}
trusted fun M5PaperDisplayOwner.waitDisplayOwned(scratch: NativeBuffer,polls: int,attempts: int,exclusive: bool): int {
    if (!exclusive || this.state() != 1 || !this.held() || !this.bufferSafe(scratch,2)) return 2
    this.controller().waitOwned(scratch,polls,attempts,true)
}
// Wait for display completion, acknowledge standby, detach child, then restore
// pins and release the canonical gate. Retry after a pin-restore failure.
// Fault/sleep never bypass required reset recovery. A partial pin-only open can
// also be unwound here if the controller was never attached.
trusted fun M5PaperDisplayOwner.shutdownOwned(scratch: NativeBuffer,polls: int,attempts: int,exclusive: bool): bool {
    if (!exclusive || this.state() < 1 || this.state() > 4 || !this.held() ||
        polls < 1 || polls > 1000000 || attempts < 1 || attempts > 3000 || !this.bufferSafe(scratch,2)) return false
    val child=this.controller()
    if (child.state() == 1 || child.state() == 3) {
        if (!child.lowPowerOwned(false,scratch,polls,attempts,true).success()) return false
    }
    if (child.state() == 4 && !child.detachStandbyOwned(true)) return false
    if (child.state() != 0) return false
    this.closeOwned(true)
}
