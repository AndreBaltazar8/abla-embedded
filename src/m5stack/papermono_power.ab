import "./expander_owner.ab"
import "./pmic_types.ab"
import "../power/m5pm1_device.ab"
import "./papermono_charger_prepare.ab"

// M5Unified PaperMono Power.begin register setup, M5Stack (MIT).
// Caller owns initialized PM1/IOE and all affected rails and IRQ consumers.
// Consume any wanted wake/IRQ events BEFORE calling: startup clears them.
// Does not configure ESP GPIO1 input or establish CPU wake policy.
// SD supply is IOE G14 (bit13), charger isolation is G11 (bit10).
// Charger latch is preloaded LOW before output mode (glitch-safe shared helper).
// Other operations preserve upstream order. Failed calls retain partial writes;
// do not close/release devices until the caller has handled the failed phase.
// Low8:1complete,2wrongboard,3notready/ownership/events not consumed,4I/O error.
// Bits8..15 completed high-level operations; final charger operation has3 writes.
trusted fun M5Expanders.configurePaperMonoPower(pmic: M5PmicOpen,exclusive: bool,wakeEventsConsumed: bool): int {
    if (!exclusive || !wakeEventsConsumed || !this.ready() || !pmic.ready() || pmic.kind() != 5) return 3
    if (this.board() != m5BoardPaperMono) return 2
    val power=M5Pm1(pmic.deviceHandle())
    val io=M5Ioe1(this.device(0)|0)
    if (!power.clearWakeSource()) return 4
    if (!power.clearGpioIrqStatus()) return 4|(1<<8)
    if (!power.clearSystemIrqStatus()) return 4|(2<<8)
    if (!power.clearButtonIrqStatus()) return 4|(3<<8)
    if (!power.setGpioIrqMask(30)) return 4|(4<<8)
    if (!power.setGpioFunction(0,m5Pm1GpioFunctionGpio)) return 4|(5<<8)
    if (!power.setGpioMode(0,m5Pm1GpioInput)) return 4|(6<<8)
    if (!power.setGpioMode(1,m5Pm1GpioOutput)) return 4|(7<<8)
    if (!power.setGpioDrive(1,m5Pm1GpioPushPull)) return 4|(8<<8)
    if (!power.setGpioPull(1,m5Pm1GpioPullUp)) return 4|(9<<8)
    if (!power.setGpioOutput(1,true)) return 4|(10<<8)
    if (!power.setGpioFunction(1,m5Pm1GpioFunctionIrq)) return 4|(11<<8)
    if (!io.setHighImpedance(13,false)) return 4|(12<<8)
    if (!io.setDirection(13,true)) return 4|(13<<8)
    if (!io.digitalWrite(13,true)) return 4|(14<<8)
    if (!io.preparePaperMonoCharger()) return 4|(15<<8)
    return 1|(16<<8)
}
