import "./rtc_timer_wake_s3_sequence.ab"
import "./rtc_timer.ab"
import "../esp32/gpio_esp32s3.ab"
import "../esp32/rtc_external_wake_esp32s3.ab"
@inline
trusted fun m5RtcTimerWakeLineHigh(pin: int): bool = Pin(pin).read()
@inline
trusted fun m5RtcTimerWakePrepare(record: NativeBuffer,pin: int): int = esp32S3ExternalWakePrepareOwned(record,pin,0,0,0,false)
trusted fun M5BoardId.prepareS3RtcTimerWake(record: NativeBuffer,timer: M5RtcTimerResult,exclusive: bool): int = this.prepareS3RtcTimerWakeOwned(record,timer,exclusive)
// Keep this wake record alive through the sleep cycle; restore it with the
// existing external-wake cleanup AFTER retained sleep resume completes.
// At session start, call esp32S3ExternalWakeInitializeOwned(record,true) on a
// fresh zero-header/exclusively released record. If timer setup or IRQ-high
// admission fails before wake preparation, normal cancellation can then see
// that no wake pads were ever acquired, rather than guessing from zero memory.
