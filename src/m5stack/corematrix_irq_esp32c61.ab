import "./board_id.ab"
import "../esp32/rtc_pad_esp32c61.ab"
// PM1 IRQ is GPIO2, active low. Does not acknowledge/clear PM1 wake events.
// Caller holds this pad lease beyond the I2C session, so must release/join IRQ
// users before closing any shared GPIO clock owner.
trusted fun M5BoardId.configureCoreMatrixIrqInputOwned(exclusiveWakeDisarmed: bool): int =
    if (this == m5BoardCoreMatrix) esp32C61RtcPadInputOwned(2,1,exclusiveWakeDisarmed) else 2
