import "../io_expander/m5ioe1_device.ab"
// Pinned M5GFX PaperMono startup (M5Stack, MIT). Own stopped EPD/touch/SD
// and shared IOE registers/rails; CS16 inactive before changing power/reset.
// IO3 EPD power, IO5 EPD reset, IO6 touch reset, IO13 touch/IO14 SD power.
// Preserve upstream register masks, including IO11 drive (high-bank bit2).
// No PSRAM setup, panel command, refresh, touch probe, rollback or retry.
// Result low8:1complete3admission4I/O; completed writes in bits8..15.
trusted fun paperMonoDisplayPowerOwned(io: M5Ioe1,exclusiveCsInactive: bool): int {
    if (!exclusiveCsInactive || (io|0) <= 0 || (io|0) > 4294967295) return 3
    val device=io.device()
    if (!device.updateRegister8(0x03,0x34,0x34)) return 4
    if (!device.updateRegister8(0x04,0x30,0x30)) return 4|(1<<8)
    if (!device.updateRegister8(0x05,0x04,0x04)) return 4|(2<<8)
    if (!device.updateRegister8(0x06,0x30,0x30)) return 4|(3<<8)
    if (!device.updateRegister8(0x13,0x34,0)) return 4|(4<<8)
    if (!device.updateRegister8(0x14,0x34,0)) return 4|(5<<8)
    if (!device.updateRegister8(0x05,0x30,0)) return 4|(6<<8)
    peripheralDelayMilliseconds(8)
    if (!device.updateRegister8(0x05,0x30,0x30)) return 4|(7<<8)
    peripheralDelayMilliseconds(2)
    return 1|(8<<8)
}
