import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
import "../spi/quad_pins.ab"
fun stopWatchDisplaySpiPins(): QuadSpiPins = quadSpiPins(40,41,42,46,45)
// Pinned M5GFX StopWatch GPSPI2, mode0/MSB, PLL80M undivided (80MHz).
// Caller owns stable PLL80M, stopped controller, CS39 and all quad pads,
// released pad holds/other functions, and inactive other device selects.
// Does not reset/power the OLED or touch; failures quarantine the SPI gate.
trusted fun stopWatchSpiInitializeOwned(gate: PeripheralGate,owner: u32,exclusive: bool): SpiTransactionResult {
    val address=gate.word().address()
    if (!exclusive || address <= 0 || address > 4294967292) return SpiTransactionResult(3<<32)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SpiTransactionResult((if (admission == 1) 2 else if (admission == 2) 4 else 3)<<32)
    val detail=esp32s3SpiInitializeQuadTransmitOwned(2,stopWatchDisplaySpiPins(),Pin(39),1,1,1,0,owner,100000)
    if (!gate.finish(owner,detail == 1)) return SpiTransactionResult((5<<32)|detail)
    return SpiTransactionResult(((if (detail == 1) 1 else 6)<<32)|detail)
}
