import "./display_map.ab"
import "../display/spi_lcd_esp32s3.ab"

// Pure board descriptor, not detection/power/reset/bus initialization. The
// current S3 hardware display map covers CoreS3/SE only; other identities
// return invalid instead of interpreting a classic-ESP32 pin map on S3.
@inline
fun M5BoardId.spiDisplay(): SpiLcd {
    if (!this.displaySharedDataCommand()) return SpiLcd(0)
    val pins = this.displaySpiPins()
    spiLcd(2, spiPins(pins.mosi(), pins.miso(), pins.clock()),
        Pin(pins.chipSelect()), Pin(pins.dataCommand()), true)
}
