import "./tough_boot_sequence.ab"
import "./toughc5_buzzer.ab"
import "./toughc5_power.ab"
import "./pm1_presence.ab"
import "../hal/m5stack_3.ab"
import "../hal/m5ioe1.ab"
import "../hal/m5pm1.ab"
@export("toughBootBuzzer")
trusted fun toughBootBuzzerHook(pmic: M5PmicOpen): int = m5BoardToughC5.configureToughBuzzer(pmic) | 0
@export("toughBootInputs")
trusted fun toughBootInputsHook(owner: M5Expanders,pmic: M5PmicOpen): int = owner.configureToughPowerInputs(pmic) | 0
@export("toughBootRails")
trusted fun toughBootRailsHook(owner: M5Expanders,pmic: M5PmicOpen): int = owner.configureToughPowerRails(pmic) | 0
@export("toughBootPresence")
trusted fun toughBootPresenceHook(owner: M5Expanders,pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): int =
    presence.updateBoard(m5BoardToughC5,M5Pm1(pmic.deviceHandle()),M5Ioe1(owner.device(0) | 0),now)
trusted fun M5Expanders.configureToughPeripherals(pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): M5ToughBoot =
    this.configureToughPeripheralsOwned(pmic,presence,now)
