import "./tough_boot_sequence.ab"
import "./toughc5_buzzer.ab"
import "./toughc5_power.ab"
import "./pm1_presence.ab"
trusted fun toughBootBuzzer(pmic: M5PmicOpen): int = m5BoardToughC5.configureToughBuzzer(pmic) | 0
trusted fun toughBootInputs(owner: M5Expanders,pmic: M5PmicOpen): int = owner.configureToughPowerInputs(pmic) | 0
trusted fun toughBootRails(owner: M5Expanders,pmic: M5PmicOpen): int = owner.configureToughPowerRails(pmic) | 0
trusted fun toughBootPresence(owner: M5Expanders,pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): int =
    presence.updateBoard(m5BoardToughC5,M5Pm1(pmic.deviceHandle()),M5Ioe1(owner.device(0) | 0),now)
trusted fun M5Expanders.configureToughPeripherals(pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): M5ToughBoot =
    this.configureToughPeripheralsOwned(pmic,presence,now)
