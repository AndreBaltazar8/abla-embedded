import "./rtc_device.ab"
import "./rtc_clock_sequence.ab"
// Import with a backend implementing setUnixTimeSeconds (classic ESP32:
// esp32/unix_time_set_idf6.ab). This module owns no clock and changes no timezone.
// Backend range limits still apply (classic ESP32 cannot roundtrip pre-1970
// system time). Failure is returned; the RTC register value is left untouched.
trusted fun M5Rtc.setSystemTimeFromRtc(): bool = m5RtcSynchronizeClock(this.dateTime())
trusted fun M5Rtc.unixSeconds(): int = this.dateTime().unixSeconds()
trusted fun M5Rtc.setUnixSeconds(seconds: int): bool {
    val value=rtcDateTimeFromUnixSeconds(seconds)
    value.valid() && this.setDateTime(value)
}
