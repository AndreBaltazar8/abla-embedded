import "./atom_s3_panel_logic.ab"
import "../display/spi_fill_sequence_esp32s3.ab"
import "../display/spi_blit_sequence_esp32s3.ab"
// The supplied rotation must match successful initialization. GC9107 odd
// rotations require resetting RASET before every window (same as software).
trusted fun AtomS3Panel.fillNativeChecked(gate: PeripheralGate,owner: u32,port: int,rotation: int,
    x: int,y: int,width: int,height: int,color: Rgb565): SpiTransactionResult {
    val view=this.view(rotation)
    if (!view.valid()) return SpiTransactionResult(3<<32)
    val pins=this.pins()
    return esp32s3LcdFillRect(gate,owner,port,spiPins(pins.mosi(),-1,pins.clock()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),
        view,x,y,width,height,color,false,this.gc9107() && (rotation&1) != 0)
}
trusted fun AtomS3Panel.blitNativeChecked(gate: PeripheralGate,owner: u32,port: int,rotation: int,
    x: int,y: int,source: NativeBuffer,width: int,height: int,stride: int,littleEndian: bool = false,staging: NativeBuffer = NativeBuffer(0)): SpiTransactionResult {
    val view=this.view(rotation)
    if (!view.valid()) return SpiTransactionResult(3<<32)
    val pins=this.pins()
    return esp32s3LcdBlitRgb565(gate,owner,port,spiPins(pins.mosi(),-1,pins.clock()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),
        view,x,y,source,width,height,stride,littleEndian,staging,false,this.gc9107() && (rotation&1) != 0)
}
