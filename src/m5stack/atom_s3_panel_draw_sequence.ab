import "./atom_s3_panel_logic.ab"
import "../hal/atoms3panel.ab"
import "../display/spi_fill_sequence_esp32s3.ab"
import "../display/spi_blit_sequence_esp32s3.ab"
import "../hal/spitransactionresult.ab"
import "../peripheralgate_type.ab"
import "../display/color.ab"
import "../spi/spitransactionresult_type.ab"
import "../spi/pins.ab"
import "../hal/pin.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../esp32/sdk/nativebuffer_type.ab"
// The supplied rotation must match successful initialization. GC9107 odd
// rotations require resetting RASET before every window (same as software).
@exportLocal("abla_atoms3panel_fillNativeChecked")
trusted fun atomS3PanelFillNativeCheckedHook(recv: int, gate: PeripheralGate, owner: u32, port: int, rotation: int, x: int, y: int, width: int, height: int, color: Rgb565): SpiTransactionResult {
    val view=AtomS3Panel(recv).view(rotation)
    if (!view.valid()) return SpiTransactionResult(3<<32)
    val pins=AtomS3Panel(recv).pins()
    return esp32s3LcdFillRect(gate,owner,port,spiPins(pins.mosi(),-1,pins.clock()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),
        view,x,y,width,height,color,false,AtomS3Panel(recv).gc9107() && (rotation&1) != 0)
}
@exportLocal("abla_atoms3panel_blitNativeChecked")
trusted fun atomS3PanelBlitNativeCheckedHook(recv: int, gate: PeripheralGate, owner: u32, port: int, rotation: int, x: int, y: int, source: NativeBuffer, width: int, height: int, stride: int, littleEndian: bool, staging: NativeBuffer): SpiTransactionResult {
    val view=AtomS3Panel(recv).view(rotation)
    if (!view.valid()) return SpiTransactionResult(3<<32)
    val pins=AtomS3Panel(recv).pins()
    return esp32s3LcdBlitRgb565(gate,owner,port,spiPins(pins.mosi(),-1,pins.clock()),Pin(pins.chipSelect()),Pin(pins.dataCommand()),
        view,x,y,source,width,height,stride,littleEndian,staging,false,AtomS3Panel(recv).gc9107() && (rotation&1) != 0)
}
