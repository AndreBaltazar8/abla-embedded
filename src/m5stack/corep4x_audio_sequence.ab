// M5Unified CoreP4X callbacks (MIT, M5Stack). Caller owns initialized IOE1,
// codec handles, live matching clocks and affected shared registers. No DMA
// start/stop implied. Keep GPIO1 shared mic/speaker power ON after disable.
// M5IOE labels GPIO1/GPIO3 are numeric bit0/bit2, not bit1/bit3.
// Low8:1ready2invalid3railpushpull4raildirection5railwrite6railreadback
// 7amppushpull8ampdirection9ampwrite10ampreadback11codec (detail above8).
trusted fun coreP4xAudioPowerOwned(io: M5Ioe1,exclusive: bool): int {
    if (!exclusive || !io.valid()) return 2
    if (!io.setHighImpedance(0,false)) return 3
    if (!io.setDirection(0,true)) return 4
    if (!io.digitalWrite(0,true)) return 5
    val latch=io.getWriteValueChecked(0)
    if (!latch.valid() || latch.value() == 0) return 6
    peripheralDelayMilliseconds(20)
    return 1
}
trusted fun coreP4xMicrophoneOwned(codec: Es7210,io: M5Ioe1,enabled: bool,exclusive: bool): int {
    if (!exclusive || !codec.valid() || (enabled && !io.valid())) return 2
    if (enabled) {
        val power=coreP4xAudioPowerOwned(io,true)
        if (power != 1) return power
    }
    val ready=if (enabled) codec.configureMic1234() else codec.reset()
    return if (ready) 1 else 11
}
trusted fun coreP4xSpeakerOwned(codec: Es8311,io: M5Ioe1,enabled: bool,exclusive: bool): int {
    if (!exclusive || !io.valid() || (enabled && !codec.valid())) return 2
    if (enabled) {
        val power=coreP4xAudioPowerOwned(io,true)
        if (power != 1) return power
    }
    if (!io.setHighImpedance(2,false)) return 7
    if (!io.setDirection(2,true)) return 8
    if (!io.digitalWrite(2,enabled)) return 9
    val latch=io.getWriteValueChecked(2)
    if (!latch.valid() || (latch.value() != 0) != enabled) return 10
    if (enabled) {
        val ready=codec.configureSpeakerMclk25624kOwned(true)
        if (ready != 1) return 11|(ready<<8)
    }
    return 1
}
