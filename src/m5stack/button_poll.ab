import "./button_poll_sequence.ab"
import "./button_source_io_shared.ab"
trusted fun m5PollButtonGpio(number: int,activeLow: bool): M5ButtonRead {
    val input=pin(number)
    if (!input.valid()) return m5ButtonRead(false)
    val high=input.read()
    m5ButtonRead(true,if (activeLow) !high else high)
}
trusted fun m5PollButtonRegister(kind: int,handle: int,address: int,register: int): I2cByteResult {
    if (kind == m5ButtonSourcePi4Ioe5v6408 && Pi4Ioe5v6408(handle).valid())
        return Pi4Ioe5v6408(handle).device().readRegister8Checked(register)
    if (kind == m5ButtonSourceM5Pm1 && M5Pm1(handle).valid()) return M5Pm1(handle).gpioInputBits()
    if (kind == m5ButtonSourcePowerHub && I2cDevice(handle).valid()) return I2cDevice(handle).readRegister8Checked(register)
    I2cByteResult(0)
}
// Supply handles matching the board's source addresses; no ownership transfer.
trusted fun M5BoardId.pollButtonLevels(pi4: Pi4Ioe5v6408,pm1: M5Pm1,powerHub: I2cDevice): M5ButtonFrame =
    this.pollButtonLevelsOwned(pi4 | 0,pm1 | 0,powerHub | 0)
