import "./rtc_profile.ab"
// Low40: owned tagged RTC handle. High bits:1 ready,2 allocation failed,
// 3 initialization failed and released,4 initialization AND release failed.
// Prepared startup also uses5 for bus preparation failure (no handle).
// PM1 board-controlled startup uses6 for admission failure (no handle).
// A failed release preserves the handle so the caller can retry cleanup.
type M5RtcOpenResult = int
fun M5RtcOpenResult.status(): int = this>>>40
fun M5RtcOpenResult.handle(): int = this & 1099511627775
fun M5RtcOpenResult.ready(): bool = this.status() == 1 && this.handle() != 0
