import "./rtc_timer_sequence.ab"
import "../esp32/sdk/raw_buffer.ab"
// Status1 all restored,2 sleep restore incomplete,3 RTC timer cleanup failed,
// 4 wake-pad restore failed,5 invalid input. Upper bits preserve underlying
// sleep-resume or board-timer result for statuses2/3 respectively.
type M5RtcSleepFinish=int
fun M5RtcSleepFinish.status(): int = this & 255
fun M5RtcSleepFinish.detail(): int = this>>>8
fun M5RtcSleepFinish.complete(): bool = this == 1
// Caller exclusively owns this board RTC TIMER (not other RTC users), both
// records and peer/interrupt/peripheral quiescence. After entry/rejection or
// cancellation, finish in this order: retained CPU/clock/cache restoration,
// RTC countdown stop + boardIRQ cleanup, then native wake-pad restoration.
// Only complete permits releasing quiescence. Failures preserve records;
// retry uses their actual completion state, never re-enters sleep. Repeated
// timer stop is intentional if pad restoration failed. No RTC alarm reset.
@section(".iram1.abla.s3BoardRtcSleepFinish")
@noinline
trusted fun m5RtcSleepFinishS3Owned(board: M5BoardId,rtc: int,pmic: int,sleep: NativeBuffer,wake: NativeBuffer,polls: int): M5RtcSleepFinish {
    if ((board != m5BoardPaperColor && board != m5BoardPaperMono && board != m5BoardStampPLC) ||
        polls <= 0 || polls > 0x7FFFFFFF || !esp32S3SleepWakeRecordsDisjoint(sleep,wake) ||
        !m5RtcCleanupRtcValid(rtc) || !m5RtcTimerSupported(rtc) ||
        (board.rtcNeedsPmicCleanup() && !m5RtcCleanupPmicValid(pmic))) return M5RtcSleepFinish(5)
    if (!m5RtcSleepCpuRestored(sleep)) {
        val result=m5RtcSleepResume(sleep,polls)
        if (!result.complete()) return M5RtcSleepFinish(2 | ((result | 0)<<8))
        if (!m5RtcSleepCpuRestored(sleep)) return M5RtcSleepFinish(5)
    }
    val stopped=m5RtcBoardTimerOwned(board,rtc,pmic,0)
    if (!stopped.success()) return M5RtcSleepFinish(3 | ((stopped | 0)<<8))
    if (!esp32S3SleepExternalWakeCleanupOwned(sleep,wake)) return M5RtcSleepFinish(4)
    M5RtcSleepFinish(1)
}
