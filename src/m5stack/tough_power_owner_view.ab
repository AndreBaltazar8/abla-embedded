import "./tough_boot_types.ab"
import "./pmic_types.ab"
import "../esp32/sdk/raw_buffer.ab"
// Read-only borrowed view; does not import board initialization or device I/O.
type M5ToughPowerOwner = int
fun m5ToughPowerOwnerAt(buffer: NativeBuffer): M5ToughPowerOwner =
    M5ToughPowerOwner(if (buffer.hasAddressRange(0,96) && (buffer.addressValue()&3) == 0) buffer | 0 else 0)
fun M5ToughPowerOwner.buffer(): NativeBuffer = NativeBuffer(this | 0)
trusted fun M5ToughPowerOwner.valid(): bool = this.buffer().hasAddressRange(0,96) &&
    (this.buffer().addressValue()&3) == 0 && this.buffer().loadU32(0) == 0x54435057
// 0fresh,1ready,2invalid,3PMIC-open failed,4expander-open failed,
// 5power phase failed,6cleanup retained,7closed. Failures retain owned handles.
trusted fun M5ToughPowerOwner.status(): int = if (this.valid()) this.buffer().loadU32(4) else 2
// Header word24 retains a managed buzzer child until acknowledged cleanup.
trusted fun M5ToughPowerOwner.toneRetained(): bool = this.valid() && this.buffer().loadU32(24) != 0
trusted fun M5ToughPowerOwner.pmic(): M5PmicOpen = M5PmicOpen(if (this.valid())
    this.buffer().loadU32(8)|(this.buffer().loadU32(12)<<32) else 0)
trusted fun M5ToughPowerOwner.bootResult(): M5ToughBoot = M5ToughBoot(if (this.valid())
    this.buffer().loadU32(16)|(this.buffer().loadU32(20)<<32) else 3)
