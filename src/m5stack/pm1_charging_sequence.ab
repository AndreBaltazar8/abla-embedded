import "./pm1_presence_sequence.ab"
// Route high nibble:1 PM1GPIO,2 IOE0GPIO,4 presence-gated IOE0GPIO.
// Low nibble pin. All these charger status lines are active low.
// M5IOE labels gpio3/gpio6/gpio8 mean bit2/bit5/bit7; PM1 GPIOs are zero-based.
fun M5BoardId.pm1ChargingRoute(): int {
    if (this == m5BoardStickS3) return 16
    if (this == m5BoardPaperDIY) return 19
    if (this == m5BoardStopWatch || this == m5BoardStampS3Bat) return 18
    if (this == m5BoardChainCaptain) return 34
    if (this == m5BoardCoreP4X) return 37
    if (this == m5BoardToughC5) return 66
    if (this == m5BoardCoreMatrix) return 71
    return -1
}
trusted fun M5BoardId.pm1ChargingCheckedOwned(pm1: int,ioe: int,presence: Pm1BatteryPresence,now: int): I2cByteResult {
    val route=this.pm1ChargingRoute()
    if (route < 0) return I2cByteResult(0)
    val source=route>>>4
    if (source == 1 && (pm1 <= 0 || pm1 > 4294967295)) return I2cByteResult(0)
    if (source != 1 && (ioe <= 0 || ioe > 4294967295)) return I2cByteResult(0)
    if (source == 4) {
        val present=presence.updateBoardOwned(this,pm1,ioe,now)
        if (present < 0) return I2cByteResult(0)
        if (present == 0) return I2cByteResult(256)
    }
    val level=if (source == 1) pm1ChargingReadGpio(pm1,route&15) else pm1PresenceReadChargeStat(ioe,route&15)
    if (!level.valid()) I2cByteResult(0) else I2cByteResult(256 | (if (level.value() == 0) 1 else 0))
}
