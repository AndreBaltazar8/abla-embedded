import "../peripheral_gate.ab"
import "../spi/transaction_result.ab"
// Fresh startup only, not live reconfiguration. Exclusive ownership covers
// PM1/charger/IOE/mux, shared OLED+touch reset, quiesced audio, display GPIO,
// powered stopped SPI and stable PLL80M. Phase gates do not replace this lease.
// Status1ready2admission3power4SPI5panel6rotation7clear8brightness9TEinput.
// Underlying48-bit result@8; all failures retain partially configured resources.
// On failed final brightness, visibility is uncertain: the SPI gate is faulted,
// so never issue an unchecked emergency write or pretend the OLED stayed dark.
type StopWatchDisplayStartup=int
fun StopWatchDisplayStartup.status(): int = this&255
fun StopWatchDisplayStartup.valid(): bool = this.status() == 1
fun StopWatchDisplayStartup.detail(): int = (this>>>8)&281474976710655
trusted fun stopWatchDisplayStartupOwned(control: int,gate: PeripheralGate,owner: u32,
    rotation: int,brightness: int,exclusive: bool): StopWatchDisplayStartup {
    if (!exclusive || rotation < 0 || rotation > 7 || brightness < 0 || brightness > 255 ||
        !peripheralOwnerValid(owner) || !stopWatchDisplayAdmission(control,gate)) return StopWatchDisplayStartup(2)
    val power=stopWatchDisplayPower(control)
    if ((power&255) != 1) return StopWatchDisplayStartup(3|((power&281474976710655)<<8))
    val spi=stopWatchDisplaySpi(gate,owner)
    if (!spi.valid()) return StopWatchDisplayStartup(4|((spi&281474976710655)<<8))
    val te=stopWatchDisplayPrepareTe()
    if (te != 1) return StopWatchDisplayStartup(9|((te&281474976710655)<<8))
    val panel=stopWatchDisplayPanel(gate,owner)
    if (!panel.valid()) return StopWatchDisplayStartup(5|((panel&281474976710655)<<8))
    val oriented=stopWatchDisplayRotation(gate,owner,rotation)
    if (!oriented.valid()) return StopWatchDisplayStartup(6|((oriented&281474976710655)<<8))
    val cleared=stopWatchDisplayClear(gate,owner,rotation)
    if (!cleared.valid()) return StopWatchDisplayStartup(7|((cleared&281474976710655)<<8))
    val lit=stopWatchDisplayBrightness(gate,owner,brightness)
    if (!lit.valid()) return StopWatchDisplayStartup(8|((lit&281474976710655)<<8))
    return StopWatchDisplayStartup(1)
}
