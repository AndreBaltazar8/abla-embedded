import "./stopwatch_panel_program.ab"
import "../display/co5300_blit_sequence_esp32s3.ab"
import "../display/rgb565_canvas.ab"
// Caller-owned complete468x468 shadow, initialized to the panel's contents
// before incremental drawing. Keep orientation fixed for the batch. Entire
// shadow/dirty rectangle must be retained on failed flush for explicit recovery.
// Widen odd dirty edges and send existing adjacent pixels, never guessed colors.
trusted fun stopWatchCanvasFlushOwned(gate: PeripheralGate,owner: u32,rotation: int,
    canvas: NativeBuffer,stride: int,x: int,y: int,w: int,h: int,exclusive: bool): SpiTransactionResult {
    if (!exclusive || rotation < 0 || rotation > 7 || !lcdRgb565SourceValid(canvas,468,468,stride) ||
        x < -2147483648 || x > 2147483647 || y < -2147483648 || y > 2147483647 ||
        w < 0 || w > 65535 || h < 0 || h > 65535) return SpiTransactionResult(3<<32)
    val rectangle=rgb565CanvasAlignedRegion(468,468,x,y,w,h)
    if (rectangle.empty()) return SpiTransactionResult(1<<32)
    val span=467*stride+936
    if (!gate.bufferDisjoint(canvas,span)) return SpiTransactionResult(3<<32)
    val offset=rectangle.y()*stride+rectangle.x()*2
    return esp32s3Co5300Blit(gate,owner,2,quadSpiPins(40,41,42,46,45),Pin(39),
        rectangle.x()+stopWatchPanelColumnStart(rotation),rectangle.y()+stopWatchPanelRowStart(rotation),
        rectangle.width(),rectangle.height(),nativeBufferAt(canvas.addressValue()+offset,canvas.capacity()-offset),stride)
}
