import "../i2c/results.ab"
//1configured on,2I/O failure,3configuration off/wrong. No rail mutation.
trusted fun paperMonoSdRailReady(device: I2cDevice): int {
    val drive=device.readRegister8Checked(20)
    if (!drive.valid()) return 2
    val direction=device.readRegister8Checked(4)
    if (!direction.valid()) return 2
    val output=device.readRegister8Checked(6)
    if (!output.valid()) return 2
    return if ((drive.value()&32) == 0 && (direction.value()&32) != 0 && (output.value()&32) != 0) 1 else 3
}
