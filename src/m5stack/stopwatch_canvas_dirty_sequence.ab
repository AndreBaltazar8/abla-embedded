import "../display/rgb565_canvas_dirty.ab"
import "../peripheral_gate.ab"
import "../spi/buffer_gate.ab"
import "../spi/transaction_result.ab"
// Entire operation is caller-exclusive, including drawing and record access.
// Failed/partial flush keeps exact pending bounds. Do not reset a faulted bus
// implicitly; explicit recovery is required before retry. Orientation must stay
// fixed for this shadow; after changing it create/resynchronize the full image.
trusted fun stopWatchCanvasDirtyFlushOwned(record: NativeBuffer,canvas: NativeBuffer,
    gate: PeripheralGate,owner: u32,rotation: int,exclusive: bool): SpiTransactionResult {
    if (!exclusive || !rgb565DirtyValid(record,canvas) || record.loadU32(4) != 468 || record.loadU32(8) != 468 ||
        !gate.bufferDisjoint(record,32) || rotation < 0 || rotation > 7) return SpiTransactionResult(3<<32)
    val dirty=rgb565DirtyRect(record)
    val result=stopWatchCanvasFlushOwned(gate,owner,rotation,canvas,record.loadU32(20),dirty.x(),dirty.y(),dirty.width(),dirty.height(),true)
    if (result.valid()) rgb565DirtySet(record,DisplayRect(0))
    return result
}
