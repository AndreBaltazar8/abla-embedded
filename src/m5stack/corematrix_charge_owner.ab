import "./corematrix_control_sequence.ab"
import "./expander_owner.ab"
import "./corematrix_charge.ab"
// Uses the owner's actual IOE0 handle, never a caller-supplied expander.
// Caller serializes the complete operation, owns IOE0 G3, and excludes close
// and other charge/power users. Selection does not enable/disable charging.
// No rollback: a failed write may have reached the device. Preserve the exact
// stage error and keep the live owner available for explicit recovery/close.
// Additional statuses9not-ready10exclusive-ownership-not-confirmed.
trusted fun M5CoreMatrixControl.setChargeCurrentOwned(requestedMilliamps: int,exclusive: bool): M5CoreMatrixChargeSelection {
    if (!exclusive) return M5CoreMatrixChargeSelection(10)
    if (!this.ready()) return M5CoreMatrixChargeSelection(9)
    return m5BoardCoreMatrix.setCoreMatrixChargeCurrentOwned(M5Ioe1(this.expanders().device(0)|0),requestedMilliamps)
}
