import "../display/dsi_timing_p4_sequence.ab"
// Detected panel ids match tab5_dsi_programs:1 ILI9881C,2 ST7121,3 ST7123.
// Keep ST7123 vback+vsync==10 and vfront220: upstream documents touch failure
// with a shortened front porch. No variant fallback if identity is unknown.
trusted fun tab5DsiSetTimingsOwned(panel: int,laneKbps: int,actualDpiKhz: int,polls: int): DsiCommandResult {
    if (panel == 1) return esp32P4DsiSetTimingsOwned(40,140,720,40,4,20,1280,20,laneKbps,80000,actualDpiKhz,polls)
    if (panel == 2) return esp32P4DsiSetTimingsOwned(2,40,720,40,20,24,1280,200,laneKbps,70000,actualDpiKhz,polls)
    if (panel == 3) return esp32P4DsiSetTimingsOwned(2,40,720,40,2,8,1280,220,laneKbps,80000,actualDpiKhz,polls)
    DsiCommandResult(2)
}
