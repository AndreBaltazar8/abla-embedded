import "./paper_display_operations.ab"
import "../display/it8951_session_partial.ab"
trusted fun M5PaperDisplayOwner.loadRectOwned(x: int,y: int,w: int,h: int,pixels: NativeBuffer,
    stride: int,scratch: NativeBuffer,polls: int,attempts: int,exclusive: bool): It8951ImageResult {
    if (!exclusive || this.state() != 1 || !this.held() ||
        !it8951RectangleValid(this.controller().info(),x,y,w,h) || stride < (w+1)/2 || stride > 2147483647 ||
        !this.bufferSafe(scratch,14) || !this.bufferSafe(pixels,(h-1)*stride+(w+1)/2)) return It8951ImageResult(2)
    this.controller().loadRectOwned(x,y,w,h,pixels,stride,scratch,polls,attempts,true)
}
trusted fun M5PaperDisplayOwner.refreshRectOwned(x: int,y: int,w: int,h: int,mode: int,
    scratch: NativeBuffer,polls: int,attempts: int,exclusive: bool): It8951ImageResult {
    if (!exclusive || this.state() != 1 || !this.held() || !this.bufferSafe(scratch,14)) return It8951ImageResult(2)
    this.controller().refreshRectOwned(x,y,w,h,mode,scratch,polls,attempts,true)
}
