import "./speaker_profile.ab"
import "../audio/buzzer_i2s16.ab"
import "../esp32/i2s/platform_c6_sequence.ab"
import "../esp32/i2s/playback_cancel_c6_sequence.ab"
// 436B retained:tag0,state4,primary8,cleanup12,platform40@16,
// playback348@56,cancel32@404. Board states1active2drained3failed4closing
// 5closed6cancelling7cancelled. Status meanings match the playback API.
// Prepared payload from encodePcm16Stereo16, four bytes per mono sample.
// Caller owns record/descriptors/payload and all GPIO/I2S/GDMA/ETM/IRQ users;
// pins physical GPIO source and selected audio root, authorizes initial FIFO
// discard. This manages gates, source mux, resets, GPIO11 route and transfer.
// No allocation/oscillator startup. Nesso and UnitC6L only; not Atom Echo.
fun c6BuzzerPcmStorage(r: NativeBuffer): bool = r.hasAddressRange(0,436) && (r.addressValue()&3) == 0 && (r.addressValue()+436 <= 0x60000000 || r.addressValue() >= 0x60100000)
trusted fun c6BuzzerPcmValid(r: NativeBuffer): bool = c6BuzzerPcmStorage(r) && r.loadU32(0) == 0x43364250
trusted fun c6BuzzerPcmPollOwned(r: NativeBuffer,budget: int,polls: int,exclusive: bool): int {
    if (!exclusive || !c6BuzzerPcmValid(r) || budget < 1 || budget > 1024 || polls < 1 || polls > 1000000) return 2
    val state=r.loadU32(4)
    if (state == 5) return 6
    if (state == 7) return 8
    if (state == 3) return 3
    if (state == 2) return 4
    if (state != 1) return 2
    val child=nativeBufferAt(r.addressValue()+56,348)
    val result=c6PlaybackPollOwned(child,budget,polls,true)
    if (result == 3) { r.storeU32(4,3);r.storeU32(8,0x20000|child.loadU32(8)) }
    else if (result == 4) r.storeU32(4,2)
    r.storeU32(12,child.loadU32(12));return result
}
trusted fun M5BoardId.openC6BuzzerPcmOwned(r: NativeBuffer,channel: int,source: int,rootHz: int,rateHz: int,maxPpm: int,descriptors: int,count: int,buffers: int,stride: int,bytes: int,polls: int,discard: bool,exclusivePinnedRoots: bool): int {
    if (!exclusivePinnedRoots || !discard || !c6BuzzerPcmStorage(r) || r.loadU32(0) != 0 || (this != m5BoardArduinoNessoN1 && this != m5BoardUnitC6L) || channel < 0 || channel > 2 || source < 0 || source > 2 || polls < 1 || polls > 1000000 || !c6GdmaRingValid(descriptors,count,buffers,stride,bytes)) return 2
    if ((source == 1 && rootHz != 240000000) || (source == 2 && rootHz != 160000000) || !c6I2sRatePlan(rootHz,rateHz,32,0).withinPpm(rootHz,rateHz,32,maxPpm)) return 2
    val profile=this.speakerProfile()
    if (profile.transport() != m5SpeakerBuzzer || profile.dataPin() != 11) return 2
    val address=r.addressValue()
    if ((address < descriptors+count*12 && descriptors < address+436) || (address < buffers+(count-1)*stride+bytes && buffers < address+436)) return 2
    var at=0
    while (at < 436) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x43364250);r.storeU32(4,3)
    val platform=c6AudioPlatformOpenOwned(nativeBufferAt(address+16,40),channel,source,true,true)
    if (platform != 1) { r.storeU32(8,0x10000|platform);return 3 }
    val result=c6PlaybackOpenOwned(nativeBufferAt(address+56,348),channel,source,rootHz,rateHz,0,maxPpm,-1,-1,profile.dataPin(),-1,16,16,16,false,descriptors,count,buffers,stride,bytes,polls,true)
    if (result != 1 && result != 5) { r.storeU32(8,0x20000|result);return 3 }
    r.storeU32(4,1);return result
}
trusted fun c6BuzzerPcmCloseOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6BuzzerPcmValid(r) || polls < 1 || polls > 1000000) return 2
    if (r.loadU32(4) == 5 || r.loadU32(4) == 7) return 6
    if (r.loadU32(4) != 2 && r.loadU32(4) != 3 && r.loadU32(4) != 4) return 2
    val child=nativeBufferAt(r.addressValue()+56,348)
    if (child.loadU32(0) != 0) {
        val result=c6PlaybackCloseOwned(child,polls,true)
        if (result == 2) return 2
        r.storeU32(4,4)
        if (result != 6) { r.storeU32(12,0x20000|result);return result }
    }
    r.storeU32(4,4)
    val result=c6AudioPlatformCloseOwned(nativeBufferAt(r.addressValue()+16,40),true)
    if (result != 6) { r.storeU32(12,0x10000|result);return 7 }
    r.storeU32(12,0);r.storeU32(4,5);return 6
}
trusted fun c6BuzzerPcmCancelOwned(r: NativeBuffer,budget: int,polls: int,handledErrors: int,discard: bool,exclusive: bool): int {
    if (!exclusive || !c6BuzzerPcmValid(r) || budget < 1 || budget > 1024 || polls < 1 || polls > 1000000 || handledErrors < 0 || (handledErrors&~0x34) != 0) return 2
    if (r.loadU32(4) == 5) return 6
    if (r.loadU32(4) == 7) return 8
    r.storeU32(4,6)
    val child=nativeBufferAt(r.addressValue()+56,348)
    if (child.loadU32(0) != 0) {
        val result=c6PlaybackCancelOwned(child,nativeBufferAt(r.addressValue()+404,32),budget,polls,handledErrors,discard,true)
        if (result != 8 && result != 6) { r.storeU32(12,0x20000|result);return result }
    }
    val result=c6AudioPlatformCloseOwned(nativeBufferAt(r.addressValue()+16,40),true)
    if (result != 6) { r.storeU32(12,0x10000|result);return 7 }
    r.storeU32(12,0);r.storeU32(4,7);return 8
}
trusted fun c6BuzzerPcmRetryStopOwned(r: NativeBuffer,polls: int,exclusive: bool): int {
    if (!exclusive || !c6BuzzerPcmValid(r) || r.loadU32(4) != 6) return 2
    return c6PlaybackCancelRetryStopOwned(nativeBufferAt(r.addressValue()+56,348),nativeBufferAt(r.addressValue()+404,32),polls,true)
}
