import "./board_id.ab"
// Status1 complete,2unsupportedboard,3invalidhandle,4unsupportedcurrent,
// 5charge-enable write failure,6quick-charge write failure.
// Bits8..15 acknowledged expander pins. No rollback or atomicity claim:
// a failed second write can leave the first change in place.
type M5TabChargeResult = int
fun M5TabChargeResult.status(): int = this & 255
fun M5TabChargeResult.appliedPins(): int = (this>>>8)&255
fun M5TabChargeResult.valid(): bool = this.status() == 1
fun M5BoardId.hasTabCharger(): bool = this == m5BoardTab5 || this == m5BoardTab5X
trusted fun M5BoardId.setTabChargeCurrentOwned(ioe1: int,milliamps: int): M5TabChargeResult {
    if (!this.hasTabCharger()) return M5TabChargeResult(2)
    if (ioe1 <= 0 || ioe1 > 4294967295) return M5TabChargeResult(3)
    // Only these discrete policies are supported upstream; do not silently
    // round an arbitrary maximum upwards or claim success for a no-op.
    if (milliamps != 0 && milliamps != 500 && milliamps != 1000) return M5TabChargeResult(4)
    if (!tabChargeLatch(ioe1,7,milliamps != 0)) return M5TabChargeResult(5)
    if (!tabChargeLatch(ioe1,5,milliamps != 1000)) return M5TabChargeResult(6|(128<<8))
    M5TabChargeResult(1|(160<<8))
}
// Enable-only operation preserves the quick-charge selection, as upstream.
trusted fun M5BoardId.setTabBatteryChargeOwned(ioe1: int,enabled: bool): M5TabChargeResult {
    if (!this.hasTabCharger()) return M5TabChargeResult(2)
    if (ioe1 <= 0 || ioe1 > 4294967295) return M5TabChargeResult(3)
    M5TabChargeResult(if (tabChargeLatch(ioe1,7,enabled)) 1|(128<<8) else 5)
}
