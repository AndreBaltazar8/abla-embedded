import "../esp32/sdk/raw_buffer.ab"
// Caller-owned20B: magic0, BMMhandle4, AKhandle8, selectedkind12,status16.
// Status0empty,1ready,2none,3allocationfailure,4releasefailure,
// 5 explicit prepared scan blocked by bus fault.
// Keep both handles visible when cleanup fails. Caller serializes all access.
type M5Magnetometers = int
fun m5MagnetometersAt(storage: NativeBuffer): M5Magnetometers =
    if (!storage.hasAddressRange(0,20) || (storage.addressValue() & 3) != 0) M5Magnetometers(0) else M5Magnetometers(storage | 0)
fun M5Magnetometers.buffer(): NativeBuffer = NativeBuffer(this | 0)
trusted fun M5Magnetometers.initialize(): bool {
    val bytes=this.buffer()
    if (!bytes.hasAddressRange(0,20) || (bytes.addressValue() & 3) != 0) return false
    bytes.storeU32(4,0); bytes.storeU32(8,0); bytes.storeU32(12,0); bytes.storeU32(16,0)
    bytes.storeU32(0,0x4D414731)
}
trusted fun M5Magnetometers.valid(): bool = this.buffer().hasAddressRange(0,20) &&
    (this.buffer().addressValue() & 3) == 0 && this.buffer().loadU32(0) == 0x4D414731
trusted fun M5Magnetometers.status(): int = if (this.valid()) this.buffer().loadU32(16) else -1
trusted fun M5Magnetometers.handle(kind: int): int = if (!this.valid() || kind < 1 || kind > 2) 0 else this.buffer().loadU32(kind*4)
trusted fun M5Magnetometers.selected(): int = if (this.status() == 1) this.buffer().loadU32(12) else 0
trusted fun M5Magnetometers.disjoint(storage: NativeBuffer,count: int): bool = this.valid() &&
    count > 0 && storage.hasAddressRange(0,count) &&
    (storage.addressValue()+count <= this.buffer().addressValue() || this.buffer().addressValue()+20 <= storage.addressValue())
