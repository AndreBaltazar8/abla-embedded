import "./nesso_display_controls_sequence.ab"
// Config bit9: logical inversion relative to the Nesso panel's inverted
// wiring; bit10: panel idle/color-reduction mode. Neither means MCU sleep.
trusted fun NessoDisplay.inverted(): bool = this.valid() && (this.buffer().loadU32(24)&512) != 0
trusted fun NessoDisplay.idle(): bool = this.valid() && (this.buffer().loadU32(24)&1024) != 0
// Publish only after transport success. Failed commands may have reached the
// controller, so preserve last confirmed configuration and require cleanup.
trusted fun NessoDisplay.commitPanelControl(result: int,mask: int,value: int): bool {
    this.saveSpi(result)
    if (result>>>32 != 1) { this.fail(13);return false }
    this.buffer().storeU32(24,(this.buffer().loadU32(24)&~mask)|value)
    this.buffer().storeU32(4,1);return true
}
trusted fun NessoDisplay.setRotationOwned(rotation: int,bgrOrder: bool,exclusive: bool): bool {
    if (!exclusive || !this.ready() || rotation < 0 || rotation > 7) return false
    this.buffer().storeU32(4,3)
    val result=nessoDisplaySetPanelRotation(this.gate(),this.owner(),rotation,bgrOrder)
    return this.commitPanelControl(result,263,rotation|(if (bgrOrder) 256 else 0))
}
trusted fun NessoDisplay.setInvertedOwned(inverted: bool,exclusive: bool): bool {
    if (!exclusive || !this.ready()) return false
    this.buffer().storeU32(4,3)
    // M5GFX logical inversion XOR board inversion (Nesso default=true).
    val result=nessoDisplaySetPanelInverted(this.gate(),this.owner(),!inverted)
    return this.commitPanelControl(result,512,if (inverted) 512 else 0)
}
trusted fun NessoDisplay.setIdleOwned(idle: bool,exclusive: bool): bool {
    if (!exclusive || !this.ready()) return false
    this.buffer().storeU32(4,3)
    val result=nessoDisplaySetPanelIdle(this.gate(),this.owner(),idle)
    return this.commitPanelControl(result,1024,if (idle) 1024 else 0)
}
