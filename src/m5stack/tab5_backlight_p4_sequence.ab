// Tab5 GPIO22 is active-high (M5GFX non-inverted PWM). Digital off/full-on
// bring-up only, not dimming/PWM. Caller owns pin22, stopped any prior LEDC
// output, pins IOMUX/GPIO clocks and excludes sleep/PMU force holds.
// Refuses individual holds, never releases another owner's held pad.
trusted fun tab5BacklightConfigureOffOwned(layout: int): int {
    if (layout != 1 && layout != 3) return 2
    if (esp32P4GpioIndividualHoldOwned(layout,22) != 0) return 3
    // Pulldown also keeps dark during output-disable/mux transition.
    return esp32P4GpioConfigureOwned(22,true,false,false,false,2)
}
// 1latch verified2invalid3hold/configuration4write/readback. Not optical proof.
trusted fun tab5BacklightSetOwned(layout: int,on: bool): int {
    if (layout != 1 && layout != 3) return 2
    if (esp32P4GpioIndividualHoldOwned(layout,22) != 0 || !p4Tab5BacklightGpioReady()) return 3
    if (!esp32P4GpioWriteOwned(22,on) || p4Tab5BacklightLatch() != on) return 4
    return 1
}
