import "./button_read.ab"
// One scalar frame for A/B/C/EXT/PWR: pressed bits0..4, valid bits5..9.
// Build fresh each poll. Missing/failed sources remain unknown, not released.
// PMIC click/hold events are not levels and must use their event path instead.
type M5ButtonFrame = u32
fun m5ButtonFrame(): M5ButtonFrame = M5ButtonFrame(u32(0))
fun M5ButtonFrame.validMask(): int = int((this>>u32(5))&u32(31))
fun M5ButtonFrame.pressedMask(): int = int(this&u32(31)) & this.validMask()
fun M5ButtonFrame.read(index: int): M5ButtonRead {
    if (index < 0 || index > 4) return m5ButtonRead(false)
    val bit=u32(1)<<u32(index)
    m5ButtonRead((u32(this.validMask())&bit) != u32(0),(u32(this.pressedMask())&bit) != u32(0))
}
fun M5ButtonFrame.withRead(index: int,value: M5ButtonRead): M5ButtonFrame {
    if (index < 0 || index > 4) return this
    val bit=u32(1)<<u32(index)
    val cleared=this&~(bit|(bit<<u32(5)))
    M5ButtonFrame(cleared|(if (value.valid()) bit<<u32(5) else u32(0))|
        (if (value.pressed()) bit else u32(0)))
}
// Overlay already-validated touch A/B/C levels; controlled may include only
// those three buttons. Caller does not call this for a failed/stale touch frame.
// Physical EXT/PWR and uncontrolled channels remain untouched.
fun M5ButtonFrame.withTouchLevels(controlled: int,pressed: int): M5ButtonFrame {
    if (controlled < 0 || controlled > 7 || pressed < 0 || pressed > 7 || (pressed&~controlled) != 0) return this
    val mask=u32(controlled)
    M5ButtonFrame((this&~mask)|u32(pressed)|(mask<<u32(5)))
}
