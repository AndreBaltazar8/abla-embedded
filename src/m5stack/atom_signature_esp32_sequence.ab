import "../esp32/gpio/probe_esp32_sequence.ab"
// Charge-decay signature only, not stand-alone board identification. Run
// AFTER package/GPIO2/34/capacitive checks establish Atom Lite/Echo family.
// Caller owns quiesced GPIO22/19/33 including I2S/RTC/crystal users, clocks,
// global-hold/sleep exclusion, shared-register serialization and ROM timing.
// Exclusive128B RAM, zero magic initially. Header32 + three GPIO snapshots.
// Returns1sampled/restored,2invalid,3probe failed/restored,4restore incomplete.
// Result getter accepts only successful/restored records. Never discard4.
fun m5AtomSignaturePin(index: int): int = if (index == 0) 22 else if (index == 1) 19 else 33
trusted fun m5AtomSignatureRecord(r: NativeBuffer,index: int): NativeBuffer = nativeBufferAt(r.addressValue()+32+index*32,32)
trusted fun m5AtomSignatureCloseOwned(r: NativeBuffer): int {
    if (!r.hasAddressRange(0,128) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x41534731) return 2
    var index=2
    var okay=true
    while (index >= 0) {
        val child=m5AtomSignatureRecord(r,index)
        if (child.loadU32(0) != 0 && esp32GpioProbeCloseOwned(child,true) != 1) okay=false
        index=index-1
    }
    r.storeU32(4,if (okay) 5 else 4)
    return if (okay) 1 else 4
}
trusted fun m5AtomSignatureValue(r: NativeBuffer): int {
    if (!r.hasAddressRange(0,128) || r.loadU32(0) != 0x41534731 || r.loadU32(4) != 5 || r.loadU32(12) != 1) return -1
    return r.loadU32(8)
}
trusted fun m5AtomSignatureProbeOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !r.hasAddressRange(0,128) || (r.addressValue()&3) != 0) return 2
    if (r.loadU32(0) != 0 && (r.loadU32(0) != 0x41534731 || r.loadU32(4) != 5)) return 2
    var offset=4
    while (offset < 128) { r.storeU32(offset,0); offset=offset+4 }
    r.storeU32(0,0x41534731); r.storeU32(4,4)
    var okay=true
    var index=0
    while (index < 3 && okay) {
        if (esp32GpioProbeOpenOwned(m5AtomSignatureRecord(r,index),m5AtomSignaturePin(index),2,true) != 1) okay=false
        index=index+1
    }
    var observations=0
    var phase=0
    while (phase < 2 && okay) {
        index=2
        while (index >= 0 && okay) {
            if (esp32GpioProbePullOwned(m5AtomSignatureRecord(r,index),if (phase == 0) 1 else 0) != 1) okay=false
            index=index-1
        }
        if (phase == 1 && okay) m5AtomSignatureDelayMilliseconds(1)
        index=2
        while (index >= 0 && okay) {
            val sample=esp32GpioProbeReadOwned(m5AtomSignatureRecord(r,index))
            if (sample < 0 || sample > 1) okay=false
            else observations=(observations<<1)|sample
            index=index-1
        }
        phase=phase+1
    }
    r.storeU32(8,observations); r.storeU32(12,if (okay) 1 else 0)
    if (m5AtomSignatureCloseOwned(r) != 1) return 4
    return if (okay) 1 else 3
}
