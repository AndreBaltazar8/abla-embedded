import "./expander_open.ab"
import "./expander_owner_sequence.ab"
trusted fun M5Expanders.open(bus: I2cBus,board: M5BoardId): int = this.openOwned(bus | 0,board)
trusted fun M5Expanders.close(): bool = this.closeOwned()
// Borrowed views only while the complete requested group is ready.
trusted fun M5Expanders.device(index: int): I2cDevice =
    I2cDevice(if (this.ready()) this.slot(index).deviceHandle() else 0)
