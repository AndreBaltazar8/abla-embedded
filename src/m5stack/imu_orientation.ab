import "./board_id.ab"
import "../imu/axis_order.ab"
type M5ImuKind = int
val m5ImuMpu6050=M5ImuKind(1)
val m5ImuMpu6886=M5ImuKind(2)
val m5ImuMpu9250=M5ImuKind(3)
val m5ImuBmi270=M5ImuKind(4)
val m5ImuSh200q=M5ImuKind(5)
type M5MagnetometerKind = int
val m5MagnetometerNone=M5MagnetometerKind(0)
val m5MagnetometerBmm150=M5MagnetometerKind(1)
val m5MagnetometerAk8963=M5MagnetometerKind(2)
// Sensor index0 accel,1 gyro,2 magnetometer. Inputs describe devices actually
// detected, not sensors inferred from a board name. BMI address matters.
fun M5BoardId.imuAxisOrder(kind: M5ImuKind,sensor: int,address: int=104,
    magnetometer: M5MagnetometerKind=m5MagnetometerNone): ImuAxisOrder {
    if (kind < 1 || kind > 5 || sensor < 0 || sensor > 2 || address < 0 || address > 127 ||
        magnetometer < 0 || magnetometer > 2) return ImuAxisOrder(0)
    var order=imuAxisOrder(0,2,4)
    if (sensor < 2) {
        if (this == m5BoardAtomMatrix && kind != m5ImuSh200q) order=imuAxisOrder(1,2,5)
        if (kind == m5ImuBmi270) {
            if (this == m5BoardCoreP4X) order=imuAxisOrder(0,2,5)
            if (this == m5BoardAtomS3R || this == m5BoardAtomS3RCam || this == m5BoardAtomS3RExt ||
                this == m5BoardCoreMatrix) order=imuAxisOrder(2,1,4)
            if (this == m5BoardChainCaptain) order=imuAxisOrder(3,1,5)
        }
    } else {
        if (kind == m5ImuBmi270) {
            if ((this == m5BoardStackCoreS3 || this == m5BoardStackChan) && address == 105) order=imuAxisOrder(0,3,5)
            if (this == m5BoardAtomS3R || this == m5BoardAtomS3RCam || this == m5BoardAtomS3RExt) order=imuAxisOrder(1,2,5)
        }
        if (magnetometer == m5MagnetometerBmm150 && this == m5BoardStack) order=imuAxisOrder(1,2,5)
        if (magnetometer == m5MagnetometerAk8963 && kind == m5ImuMpu9250) order=imuAxisOrder(2,0,5)
    }
    order
}
