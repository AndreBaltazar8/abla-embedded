import "./pm1_control_sequence.ab"
import "../esp32/i2c_esp32s3.ab"
import "./expander_open.ab"
import "./pmic_open.ab"
import "./pm1_control_setup.ab"
import "./pm1_control_bus_s3.ab"
fun pm1ControlStorageSafe(storage: NativeBuffer): bool =
    esp32S3I2cFacadeBufferSafe(storage,72,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage)
// Caller serializes the bus lifecycle; no lock-free promise if closed elsewhere.
trusted fun pm1ControlBusReady(bus: int,board: M5BoardId): bool =
    pm1ControlS3BusReady(bus,board,esp32S3I2cState0,esp32S3I2cState1)
