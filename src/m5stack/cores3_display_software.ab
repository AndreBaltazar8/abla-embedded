export import "../hal/m5boardid_cores3.ab"
import "./display_software.ab"
import "./cores3_panel_logic.ab"
import "../display/mipi_programs.ab"
import "../hal/spitransactionresult.ab"
import "../peripheralgate_type.ab"
import "../spi/spitransactionresult_type.ab"
import "../display/color.ab"
import "../esp32/sdk/raw_buffer.ab"
import "./display_map.ab"
import "../hal/native_buffer.ab"

// Use only after successful panel initialization. Streams black pixels directly
// to GRAM without a framebuffer allocation; holds the shared gate throughout.
@exportLocal("abla_m5boardid_clearCoreS3SoftwareDisplay")
trusted fun m5BoardIdClearCoreS3SoftwareDisplayHook(recv: int, gate: PeripheralGate, owner: u32, halfPeriodMicroseconds: int): SpiTransactionResult {
    val self = M5BoardId(recv)
    if (!self.displaySharedDataCommand()) return SpiTransactionResult(3 << 32)
    val view = self.displayGeometry().view(self.displayRotation())
    self.softwareDisplay().fillRect(gate, owner, view, 0, 0,
        view.width(), view.height(), rgb565Black, halfPeriodMicroseconds)
}


// Complete panel command phase only. Caller must initialize board power/SD,
// configure pins, reset LCD, and detect the revision first. All SPI clients
// share this gate. Backlight remains off until this operation succeeds.
// C/E detection failures are rejected before GPIO; no guessed fallback.
@exportLocal("abla_m5boardid_beginCoreS3SoftwareDisplay")
trusted fun m5BoardIdBeginCoreS3SoftwareDisplayHook(recv: int, gate: PeripheralGate, owner: u32, panel: int, halfPeriodMicroseconds: int): SpiTransactionResult {
    val self = M5BoardId(recv)
    if (!self.displaySharedDataCommand() ||
        (panel != cores3PanelIli9342C && panel != cores3PanelIli9342E)) return SpiTransactionResult(3 << 32)
    // M5GFX applies the E-specific commands after the ordinary ILI9342 init.
    val extra = if (panel == cores3PanelIli9342E) ili9342EInitProgram() else nativeBufferAt(0, 0)
    self.softwareDisplay().beginRgb565(gate, owner, self.displayGeometry(),
        self.displayRotation(), ili9342InitProgram(), extra, true, true, halfPeriodMicroseconds)
}

