import "./display_software.ab"
import "./cores3_panel_logic.ab"
import "../display/mipi_programs.ab"

// Use only after successful panel initialization. Streams black pixels directly
// to GRAM without a framebuffer allocation; holds the shared gate throughout.
trusted fun M5BoardId.clearCoreS3SoftwareDisplay(gate: PeripheralGate, owner: u32,
    halfPeriodMicroseconds: int = 1): SpiTransactionResult {
    if (!this.displaySharedDataCommand()) return SpiTransactionResult(3 << 32)
    val view = this.displayGeometry().view(this.displayRotation())
    this.softwareDisplay().fillRect(gate, owner, view, 0, 0,
        view.width(), view.height(), rgb565Black, halfPeriodMicroseconds)
}

// Complete panel command phase only. Caller must initialize board power/SD,
// configure pins, reset LCD, and detect the revision first. All SPI clients
// share this gate. Backlight remains off until this operation succeeds.
// C/E detection failures are rejected before GPIO; no guessed fallback.
trusted fun M5BoardId.beginCoreS3SoftwareDisplay(gate: PeripheralGate, owner: u32,
    panel: int, halfPeriodMicroseconds: int = 1): SpiTransactionResult {
    if (!this.displaySharedDataCommand() ||
        (panel != cores3PanelIli9342C && panel != cores3PanelIli9342E)) return SpiTransactionResult(3 << 32)
    // M5GFX applies the E-specific commands after the ordinary ILI9342 init.
    val extra = if (panel == cores3PanelIli9342E) ili9342EInitProgram() else nativeBufferAt(0, 0)
    this.softwareDisplay().beginRgb565(gate, owner, this.displayGeometry(),
        this.displayRotation(), ili9342InitProgram(), extra, true, true, halfPeriodMicroseconds)
}
