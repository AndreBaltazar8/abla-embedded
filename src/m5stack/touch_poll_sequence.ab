import "./touch_button_frame.ab"
import "../touch/ft5x06_snapshot.ab"
import "../touch/gt911_snapshot.ab"
import "../touch/chsc6540_snapshot.ab"

// Borrow an initialized controller (1 FT5x06, 2 GT911, 3 CHSC6540), a RAW-coordinate
// tracker and disjoint 40-byte buffers. No reset/recovery or handle ownership.
// Invalid results mean unavailable, never an empty/released report. Throttled
// polls do not consume controller reports or reuse an old frame as fresh.
trusted fun M5BoardId.pollTouchButtonsOwned(kind: int,handle: int,tracker: TouchTracker,
    snapshot: NativeBuffer,raw: NativeBuffer,now: int,previous: int,ratio: int): M5TouchButtons {
    if ((kind < 1 || kind > 3) || handle <= 0 || handle > 4294967295 ||
        this.touchButtonRawMask() == 0 || previous < 0 || previous > 7 || ratio < 0 || ratio > 255 ||
        tracker <= 0 || tracker > 4294967296-touchTrackerBytes ||
        !snapshot.hasAddressRange(0,40) || !raw.hasAddressRange(0,40)) return M5TouchButtons(0)
    val a=snapshot.addressValue()
    val b=raw.addressValue()
    if ((a < b+40 && b < a+40) || (a < tracker+touchTrackerBytes && tracker < a+40) ||
        (b < tracker+touchTrackerBytes && tracker < b+40)) return M5TouchButtons(0)
    if (touchElapsedMilliseconds(now,tracker.lastMilliseconds()) <= touchMinimumUpdateMilliseconds) {
        tracker.advanceWithoutReport(now)
        return M5TouchButtons(512)
    }
    val count=m5TouchPollRead(kind,handle,snapshot,this)
    if (kind == 2 && count == -2) {
        tracker.advanceWithoutReport(now)
        return M5TouchButtons(512)
    }
    if (count < 0 || count > 5) return M5TouchButtons(0)
    var index=0
    while (index < count) {
        val point=if (kind == 1) ft5x06SnapshotPoint(snapshot,count,index) else if (kind == 2) gt911FramePoint(snapshot,count,index) else chsc6540Point(snapshot,count,index)
        val low=u32(point & 4294967295)
        val high=u32(point >>> 32)
        var byte=0
        while (byte < 4) {
            val shift=u32(byte*8)
            raw.store(index*8+byte,int((low>>>shift)&u32(255)))
            raw.store(index*8+byte+4,int((high>>>shift)&u32(255)))
            byte=byte+1
        }
        index=index+1
    }
    if (tracker.updateControllerFrame(raw,count,now) < 0) return M5TouchButtons(0)
    this.touchButtonsFromFrame(tracker,raw,count,now,previous,ratio)
}
