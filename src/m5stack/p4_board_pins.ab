import "./p4_board_profile.ab"
import "./pin_map_shared.ab"
// Maps only, with platform-selected Pin. No pad/clock/bus ownership is implied.
// Shared connector/peripheral pins must be serialized by their actual owners.
fun M5CoreP4X.portA(): M5PortPins = this.boardId().portA()
fun M5CoreP4X.sdPins(): M5SdPinMap = this.boardId().sdPins()
fun M5CoreP4X.mBusPin(position: int): Pin = this.boardId().mBusPin(position)
fun M5CoreP4X.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5CoreP4X.internalI2cData(): Pin = pin(this.i2cPins().internalData())
fun M5CoreP4X.externalI2cClock(): Pin = pin(this.i2cPins().externalClock())
fun M5CoreP4X.externalI2cData(): Pin = pin(this.i2cPins().externalData())
fun M5Tab5.portA(): M5PortPins = this.boardId().portA()
fun M5Tab5.portB(): M5PortPins = this.boardId().portB()
fun M5Tab5.portC(): M5PortPins = this.boardId().portC()
fun M5Tab5.sdPins(): M5SdPinMap = this.boardId().sdPins()
fun M5Tab5.mBusPin(position: int): Pin = this.boardId().mBusPin(position)
fun M5Tab5.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5Tab5.internalI2cData(): Pin = pin(this.i2cPins().internalData())
fun M5Tab5.externalI2cClock(): Pin = pin(this.i2cPins().externalClock())
fun M5Tab5.externalI2cData(): Pin = pin(this.i2cPins().externalData())
fun M5Tab5X.portA(): M5PortPins = this.boardId().portA()
fun M5Tab5X.portB(): M5PortPins = this.boardId().portB()
fun M5Tab5X.portC(): M5PortPins = this.boardId().portC()
fun M5Tab5X.sdPins(): M5SdPinMap = this.boardId().sdPins()
fun M5Tab5X.mBusPin(position: int): Pin = this.boardId().mBusPin(position)
fun M5Tab5X.internalI2cClock(): Pin = pin(this.i2cPins().internalClock())
fun M5Tab5X.internalI2cData(): Pin = pin(this.i2cPins().internalData())
fun M5Tab5X.externalI2cClock(): Pin = pin(this.i2cPins().externalClock())
fun M5Tab5X.externalI2cData(): Pin = pin(this.i2cPins().externalData())
