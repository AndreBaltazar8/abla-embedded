import "./tab5_supply_close_sequence.ab"
import "./tab5_display_close_esp32p4.ab"
import "../esp32/reference_clock_owner_esp32p4.ab"
import "../esp32/ldo_pmu_esp32p4.ab"
trusted fun tab5SupplyReferenceRelease(value: int): int {
    val owner=Esp32P4ReferenceClockOwner(value)
    // Requires an acquired reference, not merely a valid idle clock record.
    if (!owner.valid() || owner.references() < 1 || esp32P4ReferenceClockField(owner.mhz()) < 0) return value
    val after=owner.releaseOwned()
    val completed= !after.cleanupRequired() && after.references() == owner.references()-1
    return (after|0)|(if (completed) 1<<32 else 0)
}
trusted fun tab5SupplyRailRelease(value: int): int {
    val owner=Esp32P4LdoOwner(value)
    if (value == 0) return 1<<32
    if (!owner.ownsRail()) return value
    val after=owner.closeOwned()
    return (after|0)|(if (after == 0) 1<<32 else 0)
}
