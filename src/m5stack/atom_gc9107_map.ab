import "./display_map.ab"
// Explicit GC9107 variant ONLY. AtomS3/R also ship ST7735 batches: board ID
// alone does not select the controller. Caller must identify the actual panel.
// Upstream marks these128x128 crop panels unreadable. No readback facade.
fun M5BoardId.gc9107DisplayPins(): M5SpiDisplayPins =
    if (this == m5BoardAtomS3) m5SpiDisplayPins(21,-1,17,15,33,34,16)
    else if (this == m5BoardAtomS3R) m5SpiDisplayPins(21,-1,15,14,42,48,-1)
    else m5SpiDisplayPins(-1,-1,-1,-1,-1,-1,-1)
fun atomGc9107Geometry(): LcdGeometry = lcdGeometry(128,128,0,32,128,160)
