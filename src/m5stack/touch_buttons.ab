import "./board_id.ab"
// Raw, unrotated controller coordinates, matching M5Unified::update.
// Feed contacts in reverse detail order. previousPressed is the existing A/B/C
// state; accumulated starts0 each frame. Touch state uses pressed bit0/moving8.
// The caller updates Button values after collecting the whole frame.
fun M5BoardId.touchButtonPanelHeight(): int {
    val board=this.pinMapIdentity()
    if (board == m5BoardStackCore2 || board == m5BoardTough || board == m5BoardToughC5 ||
        board == m5BoardStackCoreS3 || board == m5BoardStackCoreS3SE || board == m5BoardStackChan) return 240
    if (board == m5BoardPaper || board == m5BoardPaperS3) return 960
    if (board == m5BoardTab5) return 1280
    0
}
fun M5BoardId.touchButtonHeightByRatio(ratio: int): int =
    if (ratio >= 0 && ratio <= 255) int(u32(this.touchButtonPanelHeight())*u32(ratio)/u32(255)) else -1
fun M5BoardId.touchButtonRawMask(): int = if (this.touchButtonPanelHeight() != 0) 7 else 0
fun M5BoardId.accumulateTouchButtons(previousPressed: int,accumulated: int,rawX: int,rawY: int,state: int,ratio: int): int {
    val height=this.touchButtonPanelHeight()
    val band=this.touchButtonHeightByRatio(ratio)
    val width=if (height == 240) 320 else if (height == 960) 540 else 720
    val result=accumulated&7
    if (height == 0 || band < 0 || rawX < 0 || rawX >= width || rawY < height-band ||
        (state&1) == 0 || state < 0 || state > 15) return result
    // Keep held buttons while sliding. A moving contact alone cannot start
    // pressing a button, but may add one when another contact already did.
    val held=result|(previousPressed&7)
    if (held == 0 && (state&8) != 0) return 0
    val multiplier=if (height == 240) 614 else if (height == 960) 364 else 273
    val index=(u32(rawX)*u32(multiplier))>>u32(16)
    held|int(u32(1)<<index)
}
