import "../display/i80_pins_esp32s3.ab"
// Only LCD-driven pins. PWR46/OE45/SPV17/CKV18/LE15 stay GPIO-controlled;
// in particular PWR is NOT routed to the upstream API's dummy DC signal.
fun paperS3EpdTransportPin(index: int): int {
    if (index == 0) return 6
    if (index == 1) return 14
    if (index == 2) return 7
    if (index == 3) return 12
    if (index == 4) return 9
    if (index == 5) return 11
    if (index == 6) return 8
    if (index == 7) return 10
    if (index == 16) return 16
    if (index == 17) return 13
    return -1
}
trusted fun paperS3EpdTransportConfig(config: NativeBuffer): bool {
    if (!config.hasAddressRange(0,76) || (config.addressValue()&3) != 0) return false
    var index=0
    while (index < 19) { config.storeU32(index*4,paperS3EpdTransportPin(index));index=index+1 }
    return true
}
