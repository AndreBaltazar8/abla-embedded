import "./corematrix_control_sequence.ab"
import "./imu_owner_prepared.ab"
// Board control retains one IMU child at offset56 until closeImuOwned succeeds,
// including unsuccessful discovery. Exclusive means the complete scan is serialized
// against every other bus client. No implicit reset of an existing owner.
// -1 rejects admission, otherwise preserve discovery/cleanup status exactly.
trusted fun M5CoreMatrixControl.openImuPreparedOwned(imu: M5ImuOwner,exclusive: bool): int {
    if (!exclusive || !this.ready() || this.imuRetained()) return -1
    val storage=imu.buffer()
    if (!softwareI2cProviderBufferSafe(storage,36) ||
        (storage.addressValue() < this.buffer().addressValue()+64 && this.buffer().addressValue() < storage.addressValue()+36)) return -1
    if (imu.status() != 0 || imu.primary().handle() != 0 || imu.magnetometers().status() != 0 ||
        imu.magnetometers().handle(1) != 0 || imu.magnetometers().handle(2) != 0) return -1
    this.buffer().storeU32(56,storage.addressValue())
    return imu.openPrepared(this.session().bus())
}
// No borrowed-pointer dereference until it matches the retained child. Caller
// keeps that original36B storage alive and unmodified until successful release.
// If cleanup is interrupted, retain both binding and all failed device handles.
trusted fun M5CoreMatrixControl.closeImuOwned(imu: M5ImuOwner,exclusive: bool): bool {
    if (!exclusive || !this.valid() || !this.imuRetained() ||
        !imu.buffer().hasAddressRange(0,36) || this.buffer().loadU32(56) != imu.buffer().addressValue()) return false
    if (!imu.close()) return false
    this.buffer().storeU32(56,0)
    return true
}
