import "./corep4x_speaker_session_sequence.ab"
import "../esp32/i2c_software_esp32p4.ab"
import "./corep4x_speaker_dma_esp32p4.ab"
import "./corep4x_audio_esp32p4.ab"
import "../esp32/i2s/dma_session_esp32p4.ab"
import "../esp32/i2s/pin_session_esp32p4.ab"
import "../hal/m5stack.ab"
import "../esp32/sdk/raw_buffer.ab"
import "../esp32/i2s/pin_session_p4_sequence.ab"
import "../esp32/sdk/nativebuffer_type.ab"
@export("p4CoreSessionPinsCapture")
trusted fun p4CoreSessionPinsCaptureHook(r: NativeBuffer,revision: int): int =
    esp32p4I2sPinsCaptureOwned(r,0,true,2,6,4,3,0,if (revision >= 300) 3 else 1,true)
@export("p4CoreSessionPinsClose")
trusted fun p4CoreSessionPinsCloseHook(r: NativeBuffer): int = esp32p4I2sPinsCloseOwned(r,true)
