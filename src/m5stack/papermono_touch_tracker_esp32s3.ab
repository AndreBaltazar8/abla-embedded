import "./papermono_touch_esp32s3.ab"
import "./papermono_touch_tracker_sequence.ab"
trusted fun paperMonoTouchTrackerStorageAdmission(control: int,tracker: TouchTracker,frame: NativeBuffer): bool {
    val c=M5Pm1Control(control);val address=c.buffer().addressValue()
    return esp32S3I2cFacadeBufferSafe(nativeBufferAt(tracker|0,touchTrackerBytes),touchTrackerBytes,
        esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        esp32S3I2cFacadeBufferSafe(frame,40,esp32S3I2cState0,esp32S3I2cState1,esp32S3I2cDeviceStorage) &&
        (tracker+touchTrackerBytes <= address || tracker >= address+72) &&
        (frame.addressValue()+40 <= address || frame.addressValue() >= address+72)
}
trusted fun M5Pm1Control.updatePaperMonoTouchOwned(tracker: TouchTracker,touch: TouchControllerOpen,snapshot: NativeBuffer,
    frame: NativeBuffer,nowMilliseconds: int,rotation: int,exclusive: bool): int =
    tracker.updatePaperMonoOwned(this|0,touch,snapshot,frame,nowMilliseconds,rotation,exclusive)
