import "./imu_owner_sequence.ab"
import "./imu_probe.ab"
import "./magnetometer_probe.ab"
@inline
trusted fun m5ImuOwnerProbePrimary(bus: int): M5ImuProbeResult = m5ImuProbeOwned(bus)
@inline
trusted fun m5ImuOwnerReleasePrimary(handle: int): bool = I2cDevice(handle).close()
trusted fun M5ImuOwner.open(bus: I2cBus): int = this.openOwned(bus | 0)
trusted fun M5ImuOwner.close(): bool = this.closeOwned()
