import "./imu_owner_sequence.ab"
import "./imu_probe.ab"
import "./magnetometer_probe.ab"
import "../hal/m5stack.ab"
import "../i2c/device.ab"
import "../hal/m5stack_3.ab"
import "./imu_probe_types.ab"
import "./imu_probe_sequence.ab"
import "../hal/i2cdevice.ab"
@inline
@export("m5ImuOwnerProbePrimary")
trusted fun m5ImuOwnerProbePrimaryHook(bus: int): M5ImuProbeResult = m5ImuProbeOwned(bus)
@inline
@export("m5ImuOwnerReleasePrimary")
trusted fun m5ImuOwnerReleasePrimaryHook(handle: int): bool = I2cDevice(handle).close()
trusted fun M5ImuOwner.open(bus: I2cBus): int = this.openOwned(bus | 0)
trusted fun M5ImuOwner.close(): bool = this.closeOwned()
