import "./chaincaptain_power.ab"
import "./papermono_power.ab"
import "./stopwatch_power.ab"
import "./ioe1_audio_setup.ab"
// Shared checked driver composition; transport admission belongs to the facade.
trusted fun pm1ControlPower(expanders: M5Expanders,pmic: M5PmicOpen,consumed: bool): int =
    if (expanders.board() == m5BoardChainCaptain) expanders.configureChainCaptainPower(pmic,true)
    else if (expanders.board() == m5BoardStopWatch) expanders.configureStopWatchPower(pmic,true)
    else expanders.configurePaperMonoPower(pmic,true,consumed)
trusted fun pm1ControlAudio(expanders: M5Expanders): int =
    expanders.board().prepareIoeAudioOwned(M5Ioe1(expanders.device(0)|0),true)
