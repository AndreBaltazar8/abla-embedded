import "./rtc_timer_sleep_s3_sequence.ab"
import "./rtc_timer_sleep_config_s3.ab"
import "./rtc_wake_begin_esp32s3.ab"
import "./rtc_sleep_run_esp32s3.ab"
import "../esp32/power/sleep_prepare_retained_esp32s3.ab"
trusted fun m5RtcCycleValidate(board: M5BoardId,rtc: int,pmic: int,cpu: NativeBuffer,tags: NativeBuffer,c: NativeBuffer): int {
    if ((board != m5BoardPaperColor && board != m5BoardPaperMono && board != m5BoardStampPLC) ||
        !m5RtcCleanupRtcValid(rtc) || !m5RtcTimerSupported(rtc) ||
        (board.rtcNeedsPmicCleanup() && !m5RtcCleanupPmicValid(pmic)) || !m5RtcSleepConfigValid(c)) return 0
    val i=Esp32S3TagPlan(m5RtcCycleWord64(c,8)); val d=Esp32S3TagPlan(m5RtcCycleWord64(c,16))
    if (!esp32S3RetentionBuffersValid(cpu,tags,i,d)) return 0
    esp32S3TagBufferBytes(i,d)
}
trusted fun m5RtcCycleWakeInit(wake: NativeBuffer): bool = esp32S3ExternalWakeInitializeOwned(wake,true)
trusted fun m5RtcCycleRetentionInit(cpu: NativeBuffer,tags: NativeBuffer,c: NativeBuffer): bool =
    esp32S3RetentionInitOwned(cpu,tags,Esp32S3TagPlan(m5RtcCycleWord64(c,8)),Esp32S3TagPlan(m5RtcCycleWord64(c,16)))
trusted fun m5RtcCycleBegin(board: M5BoardId,rtc: int,pmic: int,wake: NativeBuffer,report: NativeBuffer,c: NativeBuffer): int =
    m5RtcWakeBeginS3Owned(board,rtc,pmic,wake,report,c.loadU32(60),true)
trusted fun m5RtcCyclePrepare(sleep: NativeBuffer,cpu: NativeBuffer,tags: NativeBuffer,c: NativeBuffer,report: NativeBuffer): int =
    esp32S3SleepPrepareRetainedOwned(sleep,cpu,tags,Esp32S3TagPlan(m5RtcCycleWord64(c,8)),Esp32S3TagPlan(m5RtcCycleWord64(c,16)),Esp32S3ClockBias(m5RtcCycleWord64(c,0)),c.loadU32(24),(c.loadU32(28)&1)!=0,m5RtcCycleRam(c),c.loadU32(36),c.loadU32(40),c.loadU32(44),(c.loadU32(28)&2)!=0,(c.loadU32(28)&4)!=0,report)
trusted fun m5RtcCycleCancel(board: M5BoardId,rtc: int,pmic: int,wake: NativeBuffer): int = m5RtcWakeCancelS3Owned(board,rtc,pmic,wake,true) | 0
trusted fun m5RtcCycleFinish(board: M5BoardId,rtc: int,pmic: int,sleep: NativeBuffer,wake: NativeBuffer,c: NativeBuffer): int =
    m5RtcSleepFinishS3Owned(board,rtc,pmic,sleep,wake,c.loadU32(44)) | 0
trusted fun m5RtcCycleRun(board: M5BoardId,rtc: int,pmic: int,sleep: NativeBuffer,wake: NativeBuffer,report: NativeBuffer,c: NativeBuffer): int =
    m5RtcSleepRunPreparedS3Owned(board,rtc,pmic,sleep,wake,report,c.loadU32(48),c.loadU32(52),c.loadU32(56),c.loadU32(44),true)
