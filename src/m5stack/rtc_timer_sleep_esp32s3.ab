@export("m5RtcCycleValidate")
trusted fun m5RtcCycleValidateHook(board: M5BoardId,rtc: int,pmic: int,cpu: NativeBuffer,tags: NativeBuffer,c: NativeBuffer): int {
    if ((board != m5BoardPaperColor && board != m5BoardPaperMono && board != m5BoardStampPLC) ||
        !m5RtcCleanupRtcValid(rtc) || !m5RtcTimerSupported(rtc) ||
        (board.rtcNeedsPmicCleanup() && !m5RtcCleanupPmicValid(pmic)) || !m5RtcSleepConfigValid(c)) return 0
    val i=Esp32S3TagPlan(m5RtcCycleWord64(c,8)); val d=Esp32S3TagPlan(m5RtcCycleWord64(c,16))
    if (!esp32S3RetentionBuffersValid(cpu,tags,i,d)) return 0
    esp32S3TagBufferBytes(i,d)
}
@export("m5RtcCycleWakeInit")
trusted fun m5RtcCycleWakeInitHook(wake: NativeBuffer): bool = esp32S3ExternalWakeInitializeOwned(wake,true)
@export("m5RtcCycleRetentionInit")
trusted fun m5RtcCycleRetentionInitHook(cpu: NativeBuffer,tags: NativeBuffer,c: NativeBuffer): bool =
    esp32S3RetentionInitOwned(cpu,tags,Esp32S3TagPlan(m5RtcCycleWord64(c,8)),Esp32S3TagPlan(m5RtcCycleWord64(c,16)))
@export("m5RtcCycleBegin")
trusted fun m5RtcCycleBeginHook(board: M5BoardId,rtc: int,pmic: int,wake: NativeBuffer,report: NativeBuffer,c: NativeBuffer): int =
    m5RtcWakeBeginS3Owned(board,rtc,pmic,wake,report,c.loadU32(60),true)
@export("m5RtcCyclePrepare")
trusted fun m5RtcCyclePrepareHook(sleep: NativeBuffer,cpu: NativeBuffer,tags: NativeBuffer,c: NativeBuffer,report: NativeBuffer): int =
    esp32S3SleepPrepareRetainedOwned(sleep,cpu,tags,Esp32S3TagPlan(m5RtcCycleWord64(c,8)),Esp32S3TagPlan(m5RtcCycleWord64(c,16)),Esp32S3ClockBias(m5RtcCycleWord64(c,0)),c.loadU32(24),(c.loadU32(28)&1)!=0,m5RtcCycleRam(c),c.loadU32(36),c.loadU32(40),c.loadU32(44),(c.loadU32(28)&2)!=0,(c.loadU32(28)&4)!=0,report)
@export("m5RtcCycleCancel")
trusted fun m5RtcCycleCancelHook(board: M5BoardId,rtc: int,pmic: int,wake: NativeBuffer): int = m5RtcWakeCancelS3Owned(board,rtc,pmic,wake,true) | 0
@export("m5RtcCycleFinish")
trusted fun m5RtcCycleFinishHook(board: M5BoardId,rtc: int,pmic: int,sleep: NativeBuffer,wake: NativeBuffer,c: NativeBuffer): int =
    m5RtcSleepFinishS3Owned(board,rtc,pmic,sleep,wake,c.loadU32(44)) | 0
@export("m5RtcCycleRun")
trusted fun m5RtcCycleRunHook(board: M5BoardId,rtc: int,pmic: int,sleep: NativeBuffer,wake: NativeBuffer,report: NativeBuffer,c: NativeBuffer): int =
    m5RtcSleepRunPreparedS3Owned(board,rtc,pmic,sleep,wake,report,c.loadU32(48),c.loadU32(52),c.loadU32(56),c.loadU32(44),true)
