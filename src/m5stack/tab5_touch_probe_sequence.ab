import "./board_id.ab"
import "../i2c/results.ab"
// Result0 invalid,1 ST7121 panel/firmware1,2 ST7123 panel/firmware3,
// 3 GT911 candidate (ACK only; panel identity still needs DSI verification),
// 4 responding ST with unknown version,5 undetected/transport failure,
// 6 bus preparation blocked. High byte retains observed ST firmware.
type M5Tab5TouchProbe = int
fun M5Tab5TouchProbe.status(): int = this&255
fun M5Tab5TouchProbe.firmware(): int = (this>>>8)&255
fun M5Tab5TouchProbe.known(): bool = this.status() >= 1 && this.status() <= 3
// One bounded attempt; caller may retry after10ms during controller startup.
// Bus and ST0x55/100kHz handle are borrowed, already configured. Prepared
// probing requires exclusive single-master ownership, as other scan APIs do.
// Unknown-but-responsive ST must NOT fall through to a GT probe.
trusted fun M5BoardId.probeTab5TouchOwned(bus: int,stHandle: int): M5Tab5TouchProbe {
    if ((this != m5BoardTab5 && this != m5BoardTab5X) || bus <= 0 || bus > 4294967295 ||
        stHandle <= 0 || stHandle > 4294967295) return M5Tab5TouchProbe(0)
    if (tab5TouchPrepare(bus) != 1) return M5Tab5TouchProbe(6)
    val version=tab5TouchFirmware(stHandle)
    if (version.valid()) {
        val status=if (version.value() == 1) 1 else if (version.value() == 3) 2 else 4
        return M5Tab5TouchProbe(status|(version.value()<<8))
    }
    // Restore only an allowed NACK-faulted controller before another address;
    // busy/ownership/arbitration/timeout faults are not silently cleared.
    if (tab5TouchPrepare(bus) != 1) return M5Tab5TouchProbe(6)
    val gt=tab5TouchGtAck(bus)
    if (tab5TouchPrepare(bus) != 1) return M5Tab5TouchProbe(6)
    M5Tab5TouchProbe(if (gt) 3 else 5)
}
