import "./imu_calibrated_update_sequence.ab"
import "../imu/calibration_startup.ab"

// After prepareStartup, start initialized at0, then pass each successful
// result.initializedMask(). Failed reads keep pending sensors enabled; seeded
// channels are disabled independently so late magnetometer data cannot cause
// repeated calibration of already-ready motion channels.
trusted fun M5ImuOwner.updateStartupOwned(snapshot: ImuSnapshot,scratch: NativeBuffer,
    micros: int,calibration: ImuCalibration,offsets: ImuOffsets,initialized: int): M5ImuCalibratedUpdate {
    val result=this.updateCalibratedOwned(snapshot,scratch,micros,calibration,offsets,initialized)
    if (result.acquisition().valid() && result.calibrationStatus() >= 0) {
        calibration.finishStartupSamples(result.initializedMask())
    }
    result
}
trusted fun M5ImuOwner.startupComplete(initialized: int): bool {
    if (this.status() != 1 || !this.primary().ready() || initialized < 0 || initialized > 7) return false
    val mag=this.magnetometers()
    if (mag.status() != 1 && mag.status() != 2) return false
    var expected=this.primary().capabilities()
    if (mag.status() == 1) {
        val kind=mag.selected()
        if (kind < 1 || kind > 2 || mag.handle(kind) == 0) return false
        expected=expected|4
    }
    (initialized & expected) == expected
}
