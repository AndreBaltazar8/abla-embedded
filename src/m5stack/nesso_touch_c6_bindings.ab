import "./nesso_display_c6_bindings.ab"
import "./nesso_i2c_profile.ab"
import "../touch/controller_open.ab"
import "../touch/transform.ab"
// The display and controller are separate retained owners over one borrowed
// session. Close touch before that session; display close does not close it.
// GPIO3 is a shared system IRQ: polling never drives or reconfigures it.
// Caller has completed board power/reset and quiesced all display/touch users.
trusted fun nessoTouchBusCurrent(bus: int): bool = I2cBus(bus).current() &&
    nessoI2cPinsMatch(softwareI2cProviderOwner().lines().sda(),softwareI2cProviderOwner().lines().scl())
trusted fun NessoDisplay.openTouchOwned(bus: int,exclusive: bool): TouchControllerOpen {
    if (!exclusive || !this.ready() || !nessoTouchBusCurrent(bus)) return TouchControllerOpen(0)
    return touchControllerOpenOwned(bus,1,56,400000)
}
// 0..5 contacts, -1 invalid/transport failure, -2 unstable capture. Failure
// is never a released frame. Decode only a successful returned snapshot.
trusted fun NessoDisplay.readTouchOwned(bus: int,touch: TouchControllerOpen,snapshot: NativeBuffer,exclusive: bool): int {
    if (!exclusive || !this.ready() || !touch.ready() || touch.kind() != 1 ||
        !nessoTouchBusCurrent(bus) || !snapshot.hasAddressRange(0,29) ||
        !softwareI2cProviderBufferSafe(snapshot,29) || !this.gate().bufferDisjoint(snapshot,29)) return -1
    val a=snapshot.addressValue();val parent=this.buffer().addressValue()
    if (a < parent+40 && parent < a+29) return -1
    if (!softwareI2cProviderEnter()) return -1
    val descriptor=softwareI2cProviderPool().resolve(touch.handle())
    val matches=softwareI2cProviderOwner().matchesDevice(descriptor) && ((descriptor>>>46)&127) == 56
    val released=softwareI2cProviderLeave()
    if (!matches || !released) return -1
    return touch.ft5x06View().readStable(snapshot)
}
// Retain the rotation snapshot alongside the report; a later display rotation
// must not reinterpret an older frame. No clamping into a false edge contact.
trusted fun nessoTouchPoint(snapshot: NativeBuffer,count: int,index: int,rotation: int): TouchPoint =
    ft5x06SnapshotPoint(snapshot,count,index).forLcdRotation(135,240,rotation)
