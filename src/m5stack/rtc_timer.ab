import "./rtc_wake_cleanup.ab"
import "./rtc_timer_sequence.ab"
@inline
fun m5RtcTimerSupported(rtc: int): bool = M5Rtc(rtc).supportsTimerInterrupt()
@inline
trusted fun m5RtcConfigureTimer(rtc: int,milliseconds: int): RtcTimerResult =
    M5Rtc(rtc).setTimerInterruptChecked(milliseconds)
// The two statuses stay separate: PMIC failure must not conceal an armed timer.
trusted fun M5Rtc.setBoardTimerInterrupt(board: M5BoardId,pmic: M5Pm1,milliseconds: int): M5RtcTimerResult =
    m5RtcBoardTimerOwned(board,this | 0,pmic | 0,milliseconds)
