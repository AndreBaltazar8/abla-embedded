import "./tab5_board_prepare_result.ab"
import "./tab5_touch_probe_sequence.ab"
// Temporary ST0x55 probe-handle owner. status low8, full16bit probe at8,
// remaining32bit device handle at32. No guessed model on unknown firmware.
// 1known+handle released,2invalid,3allocation,4close blocked (retain handle),
// 5unknown/transport failure+handle released. Never discard a failed close.
type Tab5TouchScan = int
fun Tab5TouchScan.status(): int = this&255
fun Tab5TouchScan.probe(): M5Tab5TouchProbe = M5Tab5TouchProbe((this>>>8)&65535)
fun Tab5TouchScan.handle(): int = (this>>>32)&4294967295
fun Tab5TouchScan.ready(): bool = this.status() == 1 && this.handle() == 0 && this.probe().known()
trusted fun Tab5TouchScan.closeOwned(): Tab5TouchScan {
    val handle=this.handle()
    if (handle == 0) return this
    if (!tab5TouchScanClose(handle)) return Tab5TouchScan((this&(-256))|4)
    return Tab5TouchScan(((this.probe()|0)<<8)|(if (this.probe().known()) 1 else 5))
}
// Caller retains the prepared board/reset state, current bus and exclusive scan
// interval; source clocks/delays calibrated. Never reset/recover a failed bus.
// Allocates only a provider device slot, not a heap object. Always attempts to
// release it after the bounded readiness scan, including unknown/fault outcomes.
trusted fun Tab5BoardPrepare.scanTouchOwned(board: M5BoardId,bus: int,attempts: int = 60): Tab5TouchScan {
    if (!this.ready() || (board != m5BoardTab5 && board != m5BoardTab5X) ||
        attempts < 1 || attempts > 60 || !tab5TouchScanBusCurrent(bus)) return Tab5TouchScan(2)
    val handle=tab5TouchScanOpen(bus)
    if (handle <= 0 || handle > 4294967295) return Tab5TouchScan(3)
    val probe=tab5TouchScanWait(board,bus,handle,attempts)
    return Tab5TouchScan((handle<<32)|(((probe|0)&65535)<<8)|4).closeOwned()
}
