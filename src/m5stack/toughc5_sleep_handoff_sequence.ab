import "./tough_boot_types.ab"
import "./toughc5_wake_release_sequence.ab"
import "../esp32/power/sleep_measured_gpio_memory_c5.ab"
// Two-phase board handoff. Preflight uses live I2C/cache-on; caller then
// quiesces buses/interrupt users and qualifies SDR/MSPI/voltage/clocks before
// Begin. Keep pin/PMIC/touch ownership across both phases. Never call
// Preflight/Begin again after measured ownership is claimed; use framework
// Continue, then retained AfterCalibration/Recheck for cache-off retries.
// Scratch32: touch22, padding2,release result@24,one-shot ready tag@28.
// Separate from wrapper1024/request68/context772. Preflight9ready,7source
// asserted,8no clear communication,2invalid. Begin forwards lifecycle1..6
// or7reasserted; it performs no I2C/delay and checks physical GPIO4 again.
trusted fun toughC5SleepHandoffAdmitted(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,scratch: NativeBuffer,boot: M5ToughBoot,slowCycles: int,fastCycles: int,exclusive: bool): bool {
    if (!boot.powerReady() || !scratch.hasAddressRange(0,32) || (scratch.addressValue()&3) != 0 ||
        !c5SleepMeasuredGpioMemoryAdmitted(record,request,context,4,slowCycles,fastCycles,exclusive)) return false
    val address=scratch.addressValue();val base=record.addressValue();val input=request.addressValue();val memory=context.addressValue()
    return !(address < base+1024 && base < address+32) && !(address < input+68 && input < address+32) &&
        !(address < memory+772 && memory < address+32)
}
trusted fun toughC5SleepPreflightOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,scratch: NativeBuffer,boot: M5ToughBoot,pmic: M5PmicOpen,touch: int,slowCycles: int,fastCycles: int,exclusiveDevices: bool): int {
    if (!pmic.ready() || pmic.kind() != 5 || touch <= 0 || touch > 4294967295 ||
        !toughC5SleepHandoffAdmitted(record,request,context,scratch,boot,slowCycles,fastCycles,exclusiveDevices)) return 2
    scratch.storeU32(28,0)
    val release=toughC5ReleaseWakePinOwned(pmic,touch,nativeBufferAt(scratch.addressValue(),22),true)
    scratch.storeU32(24,release|0)
    if (!release.valid()) return 2
    if (!release.released()) return if (release.communicated()) 7 else 8
    scratch.storeU32(28,0x54434831);return 9
}
trusted fun toughC5SleepBeginOwned(record: NativeBuffer,request: NativeBuffer,context: NativeBuffer,scratch: NativeBuffer,boot: M5ToughBoot,slowCycles: int,fastCycles: int,exclusiveSleep: bool): int {
    if (!toughC5SleepHandoffAdmitted(record,request,context,scratch,boot,slowCycles,fastCycles,exclusiveSleep) ||
        scratch.loadU32(28) != 0x54434831) return 2
    val release=ToughC5WakeRelease(scratch.loadU32(24))
    if (!release.valid() || !release.released()) return 2
    if (!toughC5WakePinFinalReleasedOwned(true)) { scratch.storeU32(28,0);return 7 }
    scratch.storeU32(28,0)
    return esp32C5SleepMeasuredGpioMemoryBeginOwned(record,request,context,4,false,slowCycles,fastCycles,true)
}
