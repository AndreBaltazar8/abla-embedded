import "./shutdown_request_sequence.ab"
import "./pmic_shutdown.ab"
import "./power_off_pulse.ab"
import "../power/powerhub_shutdown.ab"
@inline
fun m5ShutdownHoldPin(board: M5BoardId): int = board.powerHoldPin().number()
@inline
trusted fun m5ShutdownHubRequest(handle: int,bytes: NativeBuffer): int = PowerHubPower(handle).requestPowerOffWithBuffer(bytes) | 0
// Use only with the GPIO/I2C backend for this physical board. The wake/sleep
// owner decides fallback after requests finish; PowerHub requires light sleep.
trusted fun M5BoardId.beginShutdownRequest(record: NativeBuffer,pmic: M5PmicOpen,ioe1: I2cDevice,hub: PowerHubPower,now: u32,quiescedExclusive: bool): int =
    this.beginShutdownRequestOwned(record,pmic,ioe1 | 0,hub | 0,now,quiescedExclusive)
