import "./nesso_i2c_profile.ab"
import "../esp32/i2c_software_esp32c6.ab"
import "./nesso_power_sequence.ab"
import "./c6_power.ab"
import "./c6_gauge.ab"
import "../hal/m5stack.ab"
import "../i2c/device.ab"
@export("nessoPowerStorageSafe")
trusted fun nessoPowerStorageSafeHook(storage: NativeBuffer): bool = softwareI2cProviderBufferSafe(storage,40)
@export("nessoPowerBusCurrent")
trusted fun nessoPowerBusCurrentHook(bus: int): bool = I2cBus(bus).current() &&
    nessoI2cPinsMatch(softwareI2cProviderOwner().lines().sda(),softwareI2cProviderOwner().lines().scl())
@export("nessoPowerGaugeAllocate")
trusted fun nessoPowerGaugeAllocateHook(bus: int): int = I2cBus(bus).device(85,100000)|0
@export("nessoPowerGaugeClose")
trusted fun nessoPowerGaugeCloseHook(handle: int): bool = I2cDevice(handle).close()
// Borrowed gauge only while this whole owner is ready; do not close it.
trusted fun NessoPower.gauge(): Bq27220 = Bq27220(this.gaugeHandle())
