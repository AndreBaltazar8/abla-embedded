import "./nesso_i2c_profile.ab"
import "../esp32/i2c_software_esp32c6.ab"
import "./nesso_power_sequence.ab"
import "./c6_power.ab"
import "./c6_gauge.ab"
trusted fun nessoPowerStorageSafe(storage: NativeBuffer): bool = softwareI2cProviderBufferSafe(storage,40)
trusted fun nessoPowerBusCurrent(bus: int): bool = I2cBus(bus).current() &&
    nessoI2cPinsMatch(softwareI2cProviderOwner().lines().sda(),softwareI2cProviderOwner().lines().scl())
trusted fun nessoPowerGaugeAllocate(bus: int): int = I2cBus(bus).device(85,100000)|0
trusted fun nessoPowerGaugeClose(handle: int): bool = I2cDevice(handle).close()
// Borrowed gauge only while this whole owner is ready; do not close it.
trusted fun NessoPower.gauge(): Bq27220 = Bq27220(this.gaugeHandle())
