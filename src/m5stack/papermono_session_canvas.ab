import "../display/ssd1677_session.ab"
import "./papermono_canvas.ab"
// Own session and both image buffers, no concurrent refresh. Coordinates use
// PaperMono rotation0 portrait480x800. The canvas rejects all invalid/source
// aliases before mutation; this additionally protects session/history storage.
// Dirty X expands to bytes as in M5GFX, retaining neighboring drawing pixels.
trusted fun Ssd1677Session.drawPaperMonoOwned(x: int,y: int,w: int,h: int,rotation: int,
    source: NativeBuffer,stride: int,fill: int,exclusive: bool): bool {
    if (!exclusive || !this.dirtyValid()) return false
    if (fill == -1 && w > 0 && h > 0) {
        if (w > 65535 || h > 65535 || stride < w || stride > 2147483647) return false
        val span=(h-1)*stride+w
        if (!source.hasAddressRange(0,span) || !ssd1677FrameDisjoint(source,span,this.buffer(),64) ||
            !ssd1677FrameDisjoint(source,span,this.history(),96000)) return false
    }
    if (!paperMonoCanvasDrawOwned(this.canvas(),x,y,w,h,rotation,source,stride,fill,true)) return false
    val internal=paperMonoCanvasRotation(rotation)
    val width=if ((internal&1) == 0) 800 else 480
    val height=if ((internal&1) == 0) 480 else 800
    val left=if (x < 0) 0 else x;val top=if (y < 0) 0 else y
    val right=if (x+w > width) width else x+w
    val bottom=if (y+h > height) height else y+h
    if (left >= right || top >= bottom) return true
    val first=ssd1677CanvasPosition(800,480,left,top,internal)
    val last=ssd1677CanvasPosition(800,480,right-1,bottom-1,internal)
    val firstX=first&65535;val firstY=first>>>16
    val lastX=last&65535;val lastY=last>>>16
    val px=(if (firstX < lastX) firstX else lastX)&~7
    val py=if (firstY < lastY) firstY else lastY
    val endX=(if (firstX > lastX) firstX else lastX)|7
    val endY=if (firstY > lastY) firstY else lastY
    return this.markDirtyOwned(px,py,endX-px+1,endY-py+1,true)
}
trusted fun Ssd1677Session.readPaperMono(x: int,y: int,rotation: int): int =
    if (this.valid()) paperMonoCanvasRead(this.canvas(),x,y,rotation) else -1
