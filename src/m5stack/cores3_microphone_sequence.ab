// Import through cores3_microphone.ab. Caller owns the codec, supplies stable
// matching MCLK/I2S and serializes its lifecycle; this does not start capture.
// Status:1 complete,2 invalid,3 setup failed,4 disable/reset failed.
// Bits8/9 indicate cleanup reset attempted/failed. Reset is not rail power-off.
type CoreS3MicrophoneResult = int
fun CoreS3MicrophoneResult.status(): int = this & 255
fun CoreS3MicrophoneResult.valid(): bool = this.status() == 1
fun CoreS3MicrophoneResult.cleanupAttempted(): bool = (this & 256) != 0
fun CoreS3MicrophoneResult.cleanupFailed(): bool = (this & 512) != 0

trusted fun cores3MicrophoneEnable(microphone: Es7210): CoreS3MicrophoneResult {
    if (!microphone.valid()) return CoreS3MicrophoneResult(2)
    if (microphone.configureStereoMic12()) return CoreS3MicrophoneResult(1)
    val reset = microphone.reset()
    CoreS3MicrophoneResult(3 | 256 | (if (reset) 0 else 512))
}

trusted fun cores3MicrophoneDisable(microphone: Es7210): CoreS3MicrophoneResult {
    if (!microphone.valid()) return CoreS3MicrophoneResult(2)
    if (microphone.reset()) CoreS3MicrophoneResult(1) else CoreS3MicrophoneResult(4)
}
