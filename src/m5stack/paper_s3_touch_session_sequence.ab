import "../esp32/gpio/snapshot_s3_logic.ab"
import "../esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
// Own initially CLOSED I2C1 on SDA41/SCL42 and exclusively owned powered IRQ48.
// Bus close leaves41/42 floating; no reset pin/address scan. Address20 or93
// must match the strap. Normal clocks, powered GT911, holds released, no ISR.
// Record48: magic,state,primary,cleanup,busGeneration,touch,pad,padOwned,xtal,cpu,address,refresh.
// I2C1 is implicit: full bus key is (generation<<2)|2, potentially33bits.
// Results1ready2invalid3failed-clean4closed5cleanup-pending. State1opening,
// 2ready3closing4closed5asleep6power-uncertain. Retain record and retry close
// on every partial failure. Power states never expose a polling handle.
trusted fun paperS3TouchSessionCloseOwned(r: NativeBuffer,normalExclusive: bool): int {
    if (!normalExclusive || !r.hasAddressRange(0,48) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0x50335453) return 2
    if (r.loadU32(4) == 4) return if (r.loadU32(8) == 0) 4 else 3
    if (r.loadU32(4) < 1 || r.loadU32(4) > 6) return 2
    r.storeU32(4,3)
    if (r.loadU32(20) != 0) {
        if (!paperS3TouchRelease(r.loadU32(20))) { r.storeU32(12,1);return 5 }
        r.storeU32(20,0)
    }
    val generation=r.loadU32(16)
    if (!paperS3TouchBusClose(if (generation == 0) 0 else (generation<<2)|2)) { r.storeU32(12,2);return 5 }
    r.storeU32(16,0)
    if (r.loadU32(28) == 1) {
        if (paperS3TouchPadRestore(S3GpioSnapshot(r.loadU32(24))) != 1) { r.storeU32(12,3);return 5 }
        r.storeU32(28,2)
    }
    r.storeU32(12,0);r.storeU32(4,4)
    return if (r.loadU32(8) == 0) 4 else 3
}
trusted fun paperS3TouchSessionOpenOwned(r: NativeBuffer,xtal: int,cpu: int,address: int,normalExclusive: bool): int {
    if (!normalExclusive || !r.hasAddressRange(0,48) || (r.addressValue()&3) != 0 || r.loadU32(0) != 0 ||
        (address != 20 && address != 93) || !paperS3TouchClocksValid(xtal,cpu) || !paperS3TouchBusUnused()) return 2
    val pad=paperS3TouchPadCapture()
    if (!pad.valid() || pad.pin() != 48) return 2
    var offset=4
    while (offset < 48) { r.storeU32(offset,0);offset=offset+4 }
    r.storeU32(0,0x50335453);r.storeU32(4,1);r.storeU32(24,pad|0);r.storeU32(28,1)
    r.storeU32(32,xtal);r.storeU32(36,cpu);r.storeU32(40,address)
    val bus=paperS3TouchBusOpen(xtal,cpu);r.storeU32(16,bus>>>2)
    var failure=1
    if (bus != 0) {
        val touch=paperS3TouchAllocate(bus,address);r.storeU32(20,touch);failure=2
        if (touch != 0) {
            failure=3
            if (paperS3TouchDiscard(touch)) {
                failure=4
                if (paperS3TouchWake(pad)) {
                    failure=5
                    val refresh=paperS3TouchRefresh(touch)
                    if (refresh >= 5 && refresh <= 20) { r.storeU32(44,refresh);r.storeU32(4,2);return 1 }
                }
            }
        }
    }
    r.storeU32(8,failure)
    return paperS3TouchSessionCloseOwned(r,true)
}
fun paperS3TouchSessionHandle(r: NativeBuffer): int =
    if (r.hasAddressRange(0,48) && r.loadU32(0) == 0x50335453 && r.loadU32(4) == 2) r.loadU32(20) else 0
