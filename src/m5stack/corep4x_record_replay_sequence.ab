import "./codec_record_replay_p4_sequence.ab"
// Typed board adapter; common pipeline owns buffering/DSP/RX-to-TX handoff.
trusted fun coreP4xRecordReplayOwned(r: NativeBuffer,channel: int,desc: int,count: int,
    payload: int,stride: int,bytes: int,revision: int,polls: int,mic: Es7210,speaker: Es8311,
    io: M5Ioe1,recorded: NativeBuffer,work: NativeBuffer,blocks: int,maxIdle: int,exclusive: bool): int =
    m5P4RecordReplayOwned(r,channel,desc,count,payload,stride,bytes,revision,polls,mic|0,speaker|0,io|0,recorded,work,blocks,maxIdle,exclusive,false)
