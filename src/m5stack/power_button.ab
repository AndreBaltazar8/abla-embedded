import "./power_button_sequence.ab"
import "./pmic_key.ab"
import "../hal/m5stack_3.ab"
@export("m5PowerButtonRead")
trusted fun m5PowerButtonReadHook(pmic: M5PmicOpen): M5PowerKeyRead = pmic.readKey()
trusted fun M5PowerButton.poll(pmic: M5PmicOpen,now: int,holdMilliseconds: int = 500): M5PowerButton =
    this.pollOwned(pmic,now,holdMilliseconds)
