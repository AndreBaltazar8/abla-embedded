import "./tab5_video_shutdown_sequence.ab"
fun tab5VideoSpansOverlap(a: int,n: int,b: int,m: int): bool = a < b+m && b < a+n
// Fresh zeroed mailbox/lease/gate, initialized dispatcher and installed vectors.
// Caller exclusively owns both-core source86, unshared CPU line, DMA/cache and
// all records; pins core and excludes worker polling until return. MIE must be
// enabled at entry: video/cache work is never performed under our IRQ mask.
// 1ready,2invalid/not fresh,3IRQ preflight(detail at8),4video failure (full
// report retained in owner),5IRQ failure (full authoritative report in irqLease).
// After4/5 admission is closed: use stopVideoAndIrqOwned before host cleanup.
trusted fun Tab5DsiOwner.startVideoAndIrqOwned(mailbox: NativeBuffer,table: NativeBuffer,irqLease: NativeBuffer,gate: int,
    channel: int,irqLine: int,priority: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): int {
    if (!this.panelReady() || !this.videoIrqRecordsSafe(mailbox,table,irqLease,gate) ||
        channel < 0 || channel > 3 || irqLine < 16 || irqLine > 47 || priority < 1 || priority > 7 ||
        polls < 1 || polls > 1000000 || tab5OwnedStartupMasked() ||
        !this.videoBufferSafe(descriptor,64) || !this.videoBufferSafe(frame,1843200) ||
        !tab5OwnedVideoBuffersValid(descriptor,frame,line) || irqLease.loadU32(0) != 0 ||
        serviceGateAt(gate).word().compareExchange(u32(0),u32(0)) != u32(0)) return 2
    val d=descriptor.addressValue(); val f=frame.addressValue()
    if (tab5VideoSpansOverlap(d,64,mailbox.addressValue(),28) || tab5VideoSpansOverlap(f,1843200,mailbox.addressValue(),28) ||
        tab5VideoSpansOverlap(d,64,table.addressValue(),272) || tab5VideoSpansOverlap(f,1843200,table.addressValue(),272) ||
        tab5VideoSpansOverlap(d,64,irqLease.addressValue(),4) || tab5VideoSpansOverlap(f,1843200,irqLease.addressValue(),4) ||
        tab5VideoSpansOverlap(d,64,gate,4) || tab5VideoSpansOverlap(f,1843200,gate,4)) return 2
    var offset=0
    while (offset < 28) { if (mailbox.loadU32(offset) != 0) return 2; offset=offset+4 }
    val saved=tab5OwnedShutdownMask()
    val prepared=tab5OwnedStartupPrepare(mailbox,table,(this.buffer().loadU32(36)>>>4)&3,irqLine,priority)
    tab5OwnedShutdownRestore(saved)
    if (prepared != 1) return 3|(prepared<<8)
    val video=this.startVideoOwned(channel,descriptor,frame,line,polls)
    if ((video&15) != 1) { serviceGateAt(gate).requestStop(1); return 4 }
    val irqSaved=tab5OwnedShutdownMask()
    val irq=tab5OwnedStartupIrq(mailbox,table,priority)
    irqLease.storeU32(0,irq)
    if ((irq&255) != 1) serviceGateAt(gate).requestStop(1)
    tab5OwnedShutdownRestore(irqSaved)
    return if ((irq&255) == 1) 1 else 5
}
