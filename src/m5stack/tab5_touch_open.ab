import "./tab5_touch_profile.ab"
import "./tab5_touch_probe.ab"
import "../touch/controller_open.ab"
// Probe handle remains caller-owned. Caller selects the normal bus and
// finishes reset/power sequencing before handing it to this device owner.
trusted fun M5BoardId.openTab5Touch(bus: I2cBus,probe: M5Tab5TouchProbe,gtPanelVerified: bool = false): TouchControllerOpen {
    val profile=this.touchProfileFromProbe(probe,gtPanelVerified)
    if (!profile.valid()) return TouchControllerOpen(0)
    touchControllerOpenOwned(bus | 0,profile.kind(),profile.address(),profile.frequency())
}
