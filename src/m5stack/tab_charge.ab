import "./tab_charge_sequence.ab"
import "../io_expander/pi4ioe5v6408_device.ab"
trusted fun tabChargeLatch(handle: int,pin: int,enabled: bool): bool = Pi4Ioe5v6408(handle).digitalWrite(pin,enabled)
// Caller owns the initialized PI4 IOE1 at0x44 and serializes both writes.
// These are requested charger settings, not measured current guarantees.
trusted fun M5BoardId.setTabChargeCurrent(ioe1: Pi4Ioe5v6408,milliamps: int): M5TabChargeResult =
    this.setTabChargeCurrentOwned(ioe1 | 0,milliamps)
trusted fun M5BoardId.setTabBatteryCharge(ioe1: Pi4Ioe5v6408,enabled: bool): M5TabChargeResult =
    this.setTabBatteryChargeOwned(ioe1 | 0,enabled)
