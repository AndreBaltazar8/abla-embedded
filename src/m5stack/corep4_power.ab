import "./expander_owner.ab"
import "./pmic_types.ab"
// Status1complete,2unsupportedboard,3notready,4rail-driverfailure,
// 5rail-directionfailure,6rail-latchfailure,7charger-inputfailure,8pullfailure.
// Highbyte acknowledged high-level steps; no rollback after partialwrites.
type M5CoreP4PowerSetup = int
fun M5CoreP4PowerSetup.status(): int = this & 255
fun M5CoreP4PowerSetup.appliedSteps(): int = (this>>>8)&255
fun M5CoreP4PowerSetup.valid(): bool = this.status() == 1
// Explicit board-wide setup after successful PM1+expander opens. IOE0G12
// enables shared MBUS/TF/sensor3V3; G6 is active-low charger status. Preserve
// upstream order and unrelated register bits. Does not begin PM1 a second time.
// Upstream M5IOE enum gpio12/gpio6 resolves to zero-based bit11/bit5.
trusted fun M5Expanders.configureCoreP4Power(pmic: M5PmicOpen): M5CoreP4PowerSetup {
    if (!this.ready() || !pmic.ready() || pmic.kind() != 5) return M5CoreP4PowerSetup(3)
    if (this.board() != m5BoardCoreP4X) return M5CoreP4PowerSetup(2)
    val ioe=M5Ioe1(this.device(0) | 0)
    if (!ioe.setHighImpedance(11,false)) return M5CoreP4PowerSetup(4)
    if (!ioe.setDirection(11,true)) return M5CoreP4PowerSetup(5|(1<<8))
    if (!ioe.digitalWrite(11,true)) return M5CoreP4PowerSetup(6|(2<<8))
    if (!ioe.setDirection(5,false)) return M5CoreP4PowerSetup(7|(3<<8))
    if (!ioe.setPullMode(5,pullUp)) return M5CoreP4PowerSetup(8|(4<<8))
    M5CoreP4PowerSetup(1|(5<<8))
}
