import "./paper_s3_touch_session_sequence.ab"
import "../esp32/i2c_esp32s3.ab"
import "../touch/gt911_device.ab"
import "../esp32/gpio/probe_owned_esp32s3.ab"
import "../esp32/gpio/output_s3_sequence.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
import "../hal/delay.ab"
import "../hal/m5stack.ab"
import "../hal/m5stack_2.ab"
import "../hal/esp32_gpio_3.ab"
import "../hal/m5stack_3.ab"
import "../hal/gt911.ab"
import "../hal/s3gpiosnapshot.ab"
@export("paperS3TouchClocksValid")
trusted fun paperS3TouchClocksValidHook(xtal: int,cpu: int): bool = xtal > 0 && xtal <= 0xffffffff && cpu > 0 && cpu <= 0xffffffff &&
    esp32S3I2cTiming(u32(xtal),u32(100000)).valid() && esp32S3I2cTiming(u32(xtal),u32(400000)).valid()
@export("paperS3TouchBusUnused")
trusted fun paperS3TouchBusUnusedHook(): bool = nativeAddressLoadU32(esp32S3I2cState1,8) == 0 && nativeAddressLoadU32(esp32S3I2cState1,0) == 0
@export("paperS3TouchBusOpen")
trusted fun paperS3TouchBusOpenHook(xtal: int,cpu: int): int = i2cMaster(1,41,42,u32(xtal),u32(cpu))|0
@export("paperS3TouchAllocate")
trusted fun paperS3TouchAllocateHook(bus: int,address: int): int = gt911(I2cBus(bus),address,400000)|0
@export("paperS3TouchDiscard")
trusted fun paperS3TouchDiscardHook(touch: int): bool = Gt911(touch).discardPending()
@export("paperS3TouchRefresh")
trusted fun paperS3TouchRefreshHook(touch: int): int {
    val result=Gt911(touch).refreshPeriodMillisecondsChecked()
    return if (result.valid()) result.value() else -1
}
@export("paperS3TouchRelease")
trusted fun paperS3TouchReleaseHook(touch: int): bool = esp32S3I2cDevicePool().resolve(touch) == 0 || Gt911(touch).close()
@export("paperS3TouchBusClose")
trusted fun paperS3TouchBusCloseHook(handle: int): bool {
    val state=esp32S3I2cState1
    val phase=nativeAddressLoadU32(state,8)
    if (phase == 2) return i2cAbortSetup(1)
    if (phase == 1) {
        if (nativeAddressLoadU32(state,12) != 41 || nativeAddressLoadU32(state,16) != 42) return false
        val key=if (handle != 0) handle else esp32S3I2cBusKey(1,nativeAddressLoadU32(state,4))
        return I2cBus(key).close()
    }
    if (phase != 0) return false
    // A failed gate publication may outlive successful resource release.
    val gate=peripheralGateAt(state)
    val admission=gate.tryBegin(u32(1))
    if (admission == 0) return gate.finish(u32(1),true)
    if (admission != 2 || !gate.tryBeginRecovery(u32(1))) return false
    return gate.finishRecovery(u32(1),true)
}
@export("paperS3TouchPadCapture")
trusted fun paperS3TouchPadCaptureHook(): S3GpioSnapshot = esp32S3GpioSnapshotOwned(48,true)
@export("paperS3TouchPadRestore")
trusted fun paperS3TouchPadRestoreHook(pad: S3GpioSnapshot): int = pad.restoreOwned(true)
@export("paperS3TouchWake")
trusted fun paperS3TouchWakeHook(pad: S3GpioSnapshot): bool {
    if (!esp32S3GpioOutputLevelOwned(48,false)) return false
    peripheralDelayMilliseconds(58)
    if (!esp32S3GpioWriteLevelOwned(48,true)) return false
    peripheralDelayMilliseconds(2)
    return pad.prepareProbeInputOwned(0,true) == 1
}
