import "./paper_s3_touch_session_sequence.ab"
import "../esp32/i2c_esp32s3.ab"
import "../touch/gt911_device.ab"
import "../esp32/gpio/probe_owned_esp32s3.ab"
import "../esp32/gpio/output_s3_sequence.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
trusted fun paperS3TouchClocksValid(xtal: int,cpu: int): bool = xtal > 0 && xtal <= 0xffffffff && cpu > 0 && cpu <= 0xffffffff &&
    esp32S3I2cTiming(u32(xtal),u32(100000)).valid() && esp32S3I2cTiming(u32(xtal),u32(400000)).valid()
trusted fun paperS3TouchBusUnused(): bool = nativeAddressLoadU32(esp32S3I2cState1,8) == 0 && nativeAddressLoadU32(esp32S3I2cState1,0) == 0
trusted fun paperS3TouchBusOpen(xtal: int,cpu: int): int = i2cMaster(1,41,42,u32(xtal),u32(cpu))|0
trusted fun paperS3TouchAllocate(bus: int,address: int): int = gt911(I2cBus(bus),address,400000)|0
trusted fun paperS3TouchDiscard(touch: int): bool = Gt911(touch).discardPending()
trusted fun paperS3TouchRefresh(touch: int): int {
    val result=Gt911(touch).refreshPeriodMillisecondsChecked()
    return if (result.valid()) result.value() else -1
}
trusted fun paperS3TouchRelease(touch: int): bool = esp32S3I2cDevicePool().resolve(touch) == 0 || Gt911(touch).close()
trusted fun paperS3TouchBusClose(handle: int): bool {
    val state=esp32S3I2cState1
    val phase=nativeAddressLoadU32(state,8)
    if (phase == 2) return i2cAbortSetup(1)
    if (phase == 1) {
        if (nativeAddressLoadU32(state,12) != 41 || nativeAddressLoadU32(state,16) != 42) return false
        val key=if (handle != 0) handle else esp32S3I2cBusKey(1,nativeAddressLoadU32(state,4))
        return I2cBus(key).close()
    }
    if (phase != 0) return false
    // A failed gate publication may outlive successful resource release.
    val gate=peripheralGateAt(state)
    val admission=gate.tryBegin(u32(1))
    if (admission == 0) return gate.finish(u32(1),true)
    if (admission != 2 || !gate.tryBeginRecovery(u32(1))) return false
    return gate.finishRecovery(u32(1),true)
}
trusted fun paperS3TouchPadCapture(): S3GpioSnapshot = esp32S3GpioSnapshotOwned(48,true)
trusted fun paperS3TouchPadRestore(pad: S3GpioSnapshot): int = pad.restoreOwned(true)
trusted fun paperS3TouchWake(pad: S3GpioSnapshot): bool {
    if (!esp32S3GpioOutputLevelOwned(48,false)) return false
    peripheralDelayMilliseconds(58)
    if (!esp32S3GpioWriteLevelOwned(48,true)) return false
    peripheralDelayMilliseconds(2)
    return pad.prepareProbeInputOwned(0,true) == 1
}
