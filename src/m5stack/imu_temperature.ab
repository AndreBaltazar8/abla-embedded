import "./imu_probe_types.ab"
import "./imu_temperature_logic.ab"
import "../esp32/sdk/raw_buffer.ab"
// Conversion constants match M5Unified's selected driver (including its
// shared MPU-family constants). Apply only after checking sample.valid().
fun M5ImuKind.temperatureScale(): f64 =
    if (this == m5ImuBmi270) 1.0/512.0 else if (this == m5ImuSh200q) 1.0/333.87 else 1.0/326.8
fun M5ImuKind.temperatureOffset(): f64 =
    if (this == m5ImuBmi270) 23.0 else if (this == m5ImuSh200q) 21.0 else 25.0
trusted fun M5ImuProbeResult.readTemperatureWithBuffer(scratch: NativeBuffer): ImuSample {
    if (!this.ready() || !scratch.hasAddressRange(0,2)) return invalidImuSample()
    val kind=this.kind()
    val register=if (kind == m5ImuBmi270) 34 else if (kind == m5ImuSh200q) 12 else 65
    if (!I2cDevice(this.handle()).readRegister(register,scratch,2)) return invalidImuSample()
    val little=kind == m5ImuBmi270 || kind == m5ImuSh200q
    imuSample(if (little) scratch.load(0)|(scratch.load(1)<<8) else (scratch.load(0)<<8)|scratch.load(1))
}
trusted fun M5ImuProbeResult.readTemperatureRaw(): ImuSample =
    this.readTemperatureWithBuffer(nativeBufferAt(nativeStackAllocate(2),2))
trusted fun M5ImuProbeResult.readTemperatureCheckedWithBuffer(scratch: NativeBuffer): ImuTemperature =
    this.kind().temperature(this.readTemperatureWithBuffer(scratch))
trusted fun M5ImuProbeResult.readTemperatureChecked(): ImuTemperature =
    this.readTemperatureCheckedWithBuffer(nativeBufferAt(nativeStackAllocate(2),2))
