import "./imu_orientation.ab"
// Scalar owned result: device32, kind3, address7, capabilities3, status at48.
// Status1 ready,2 no working candidate,3 allocation failed,4 release failed,
// 5 explicit prepared scan could not make the bus ready for another candidate.
type M5ImuProbeResult = int
fun M5ImuProbeResult.status(): int = this>>>48
fun M5ImuProbeResult.handle(): int = this & 0xFFFFFFFF
fun M5ImuProbeResult.kind(): M5ImuKind = M5ImuKind((this>>>32)&7)
fun M5ImuProbeResult.address(): int = (this>>>35)&127
fun M5ImuProbeResult.capabilities(): int = (this>>>42)&7
fun M5ImuProbeResult.ready(): bool = this.status() == 1 && this.handle() != 0 &&
    ((this>>>45)&7) == 0 && this.kind() >= 1 && this.kind() <= 5 &&
    (this.capabilities() == 3 || (this.kind() == m5ImuBmi270 && this.capabilities() == 7)) &&
    (if (this.kind() == m5ImuSh200q) this.address() == 108 else
        this.address() == 104 || (this.kind() == m5ImuBmi270 && this.address() == 105))
