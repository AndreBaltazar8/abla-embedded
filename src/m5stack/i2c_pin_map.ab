import "./board_id.ab"

// Four signed 8-bit pin values in one scalar: internal SCL/SDA followed by
// external SCL/SDA. 255 represents hardware not present.
type M5I2cPinMap = int

fun m5I2cPinMap(
    internalClock: int,
    internalData: int,
    externalClock: int,
    externalData: int
): M5I2cPinMap = M5I2cPinMap(
    (internalClock & 255) | ((internalData & 255) << 8) |
        ((externalClock & 255) << 16) | ((externalData & 255) << 24)
)

fun m5DecodePin(value: int): int = if (value == 255) -1 else value
fun M5I2cPinMap.internalClock(): int = m5DecodePin(this & 255)
fun M5I2cPinMap.internalData(): int = m5DecodePin((this >>> 8) & 255)
fun M5I2cPinMap.externalClock(): int = m5DecodePin((this >>> 16) & 255)
fun M5I2cPinMap.externalData(): int = m5DecodePin((this >>> 24) & 255)
fun M5I2cPinMap.hasInternal(): bool = this.internalClock() >= 0
fun M5I2cPinMap.hasExternal(): bool = this.externalClock() >= 0

fun M5BoardId.i2cPins(): M5I2cPinMap {
    // ESP32-S3 families.
    if (this == m5BoardStackCoreS3 || this == m5BoardStackCoreS3SE ||
        this == m5BoardStackChan) return m5I2cPinMap(11, 12, 1, 2)
    if (this == m5BoardStickS3) return m5I2cPinMap(48, 47, 10, 9)
    if (this == m5BoardStampS3) return m5I2cPinMap(-1, -1, 15, 13)
    if (this == m5BoardCapsule) return m5I2cPinMap(10, 8, 15, 13)
    if (this == m5BoardDial || this == m5BoardDinMeter ||
        this == m5BoardAirQ) return m5I2cPinMap(12, 11, 15, 13)
    if (this == m5BoardCardputer) return m5I2cPinMap(-1, -1, 1, 2)
    if (this == m5BoardCardputerADV) return m5I2cPinMap(9, 8, 1, 2)
    if (this == m5BoardVAMeter) return m5I2cPinMap(6, 5, 9, 8)
    if (this == m5BoardAtomS3R || this == m5BoardAtomS3RExt ||
        this == m5BoardAtomVoiceS3R || this == m5BoardAtomS3RCam) {
        return m5I2cPinMap(0, 45, 1, 2)
    }
    if (this == m5BoardPaperS3) return m5I2cPinMap(42, 41, 1, 2)
    if (this == m5BoardPaperDIY) return m5I2cPinMap(42, 41, 42, 41)
    if (this == m5BoardStampPLC) return m5I2cPinMap(15, 13, 1, 2)
    if (this == m5BoardPowerHub) return m5I2cPinMap(48, 45, 16, 15)
    if (this == m5BoardStampS3Bat) return m5I2cPinMap(47, 48, -1, -1)
    if (this == m5BoardPaperColor) return m5I2cPinMap(2, 3, 5, 4)
    if (this == m5BoardChainCaptain) return m5I2cPinMap(2, 3, 6, 7)
    if (this == m5BoardPaperMono) return m5I2cPinMap(48, 47, -1, -1)
    if (this == m5BoardStopWatch) return m5I2cPinMap(48, 47, 11, 10)
    if (this == m5BoardAtomS3 || this == m5BoardAtomS3Lite ||
        this == m5BoardAtomS3U) return m5I2cPinMap(39, 38, 1, 2)

    // ESP32-C3/C6/C61/H2/P4/C5 families.
    if (this == m5BoardStampC3 || this == m5BoardStampC3U) {
        return m5I2cPinMap(-1, -1, 0, 1)
    }
    if (this == m5BoardUnitC6L) return m5I2cPinMap(8, 10, -1, -1)
    if (this == m5BoardArduinoNessoN1) return m5I2cPinMap(8, 10, 8, 10)
    if (this == m5BoardNanoC6) return m5I2cPinMap(-1, -1, 1, 2)
    if (this == m5BoardCoreMatrix) return m5I2cPinMap(1, 0, 1, 0)
    if (this == m5BoardNanoH2) return m5I2cPinMap(-1, -1, 1, 2)
    if (this == m5BoardCoreP4X) return m5I2cPinMap(9, 11, 16, 18)
    if (this == m5BoardTab5) return m5I2cPinMap(32, 31, 54, 53)
    if (this == m5BoardUnitPoEP4) return m5I2cPinMap(1, 0, 54, 53)
    if (this == m5BoardToughC5) return m5I2cPinMap(3, 2, 3, 2)

    // Original ESP32 families.
    if (this == m5BoardStack) return m5I2cPinMap(22, 21, 22, 21)
    if (this == m5BoardPaper) return m5I2cPinMap(22, 21, 32, 25)
    if (this == m5BoardTimerCam) return m5I2cPinMap(14, 12, 13, 4)
    if (this == m5BoardAtomLite || this == m5BoardAtomMatrix ||
        this == m5BoardAtomVoice || this == m5BoardAtomU ||
        this == m5BoardAtomPsram) return m5I2cPinMap(21, 25, 32, 26)
    if (this == m5BoardStackCore2 || this == m5BoardTough ||
        this == m5BoardStickC || this == m5BoardStickCPlus ||
        this == m5BoardStickCPlus2 || this == m5BoardStackCoreInk ||
        this == m5BoardStation || this == m5BoardStampPico ||
        this == m5BoardCamera) return m5I2cPinMap(22, 21, 33, 32)
    m5I2cPinMap(-1, -1, -1, -1)
}
