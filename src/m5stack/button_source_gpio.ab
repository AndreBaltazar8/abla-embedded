import "./button_map_shared.ab"
import "../esp32/button_shared.ab"
// Explicit source-to-state conversion; no pin setup or read. Preserve source
// polarity rather than silently applying Pin.asButton's active-low default.
// Non-GPIO/malformed sources retain the invalid255 pin sentinel. The selected
// GPIO backend decides whether a valid numeric source pin exists on this SoC.
fun M5ButtonSource.asButton(): GpioButton =
    if (this.isGpio()) gpioButton(this.pin(),this.activeLow()) else gpioButton(pin(-1))
