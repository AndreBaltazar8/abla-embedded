import "./touch_profile.ab"
import "../touch/controller_open.ab"
// The borrowed bus must already match profile wiring and be exclusively
// configured. Caller prepares board power/reset/IRQ; this only owns a device.
// Overrides permit explicit GT911 strap choice without hidden address probes.
// CST controllers use touch_open_cst.ab for their distinct lifecycle states.
trusted fun M5BoardId.openTouch(bus: I2cBus,address: int = -1): TouchControllerOpen {
    val profile=this.touchProfile()
    if (!profile.valid() || profile.kind() > 3) return TouchControllerOpen(0)
    touchControllerOpenOwned(bus | 0,profile.kind(),if (address == -1) profile.address() else address,profile.frequency())
}
