import "./pmic_key_sequence.ab"
// Allocation-free PMIC event state, NOT a physical pressed/released state.
// u32 poll timestamp, saturating17bit click age,8bit click count,2bit event,
// PM1 double detail and2bit last read status. Caller serializes destructive reads.
type M5PowerButton = int
fun m5PowerButton(now: int = 0): M5PowerButton = M5PowerButton(now&4294967295)
fun M5PowerButton.lastPoll(): int = this&4294967295
fun M5PowerButton.clickAge(): int = (this>>>32)&131071
fun M5PowerButton.clickCount(): int = (this>>>49)&255
fun M5PowerButton.event(): int = (this>>>57)&3
fun M5PowerButton.readStatus(): int = (this>>>60)&3
fun M5PowerButton.wasClicked(): bool = this.event() == 1
fun M5PowerButton.wasHold(): bool = this.event() == 2
fun M5PowerButton.wasDecideClickCount(): bool = this.event() == 3
fun M5PowerButton.hardwareDoubleClick(): bool = this.wasClicked() && (this&(1<<59)) != 0
// M5Unified minimum4ms; pending one-shot event forces the next poll even when
// sooner, clearing it. Decision uses STRICT > hold interval and a prior quiet
// event; slow polling immediately after a click discards ambiguous click counts.
trusted fun M5PowerButton.pollOwned(pmic: M5PmicOpen,now: int,holdMilliseconds: int = 500,minimumMilliseconds: int = 4): M5PowerButton {
    if (holdMilliseconds < 0 || holdMilliseconds > 65535 || minimumMilliseconds < 1 || minimumMilliseconds > 65535) return this
    val elapsed=(now-this.lastPoll())&4294967295
    if (elapsed < minimumMilliseconds && this.event() == 0) return this
    val sample=m5PowerButtonRead(pmic)
    var age=this.clickAge()+elapsed
    if (age > 131071) age=131071
    var count=if (this.wasDecideClickCount()) 0 else this.clickCount()
    var event=0
    if (sample.valid()) {
        if (sample.held()) event=2
        else if (sample.clicked()) {
            event=1; age=0
            count=(count+1)&255
        } else if (age > holdMilliseconds && count > 0) {
            if (this.event() == 0) event=3 else count=0
        }
    }
    M5PowerButton((now&4294967295)|(age<<32)|(count<<49)|(event<<57)|
        (if (sample.doubleClicked()) 1<<59 else 0)|(sample.status()<<60))
}
