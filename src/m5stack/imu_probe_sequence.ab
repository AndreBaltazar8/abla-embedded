import "./imu_probe_types.ab"
// On4 the handle remains available for cleanup; never continue and leak it.
trusted fun m5ImuProbeOwned(bus: int): M5ImuProbeResult {
    var candidate=0
    while (candidate < 4) {
        val result=m5ImuProbeCandidateOwned(bus,candidate)
        if (result.status() != 2) return result
        candidate=candidate+1
    }
    M5ImuProbeResult(2<<48)
}
// Single candidate permits an explicit caller-selected bus preparation policy.
// Missing candidate is fully released; allocation/cleanup failures terminate.
trusted fun m5ImuProbeCandidateOwned(bus: int,candidate: int): M5ImuProbeResult {
    if (candidate < 0 || candidate > 3) return M5ImuProbeResult(0)
    val address=if (candidate < 2) 104 else if (candidate == 2) 105 else 108
    val handle=m5ImuProbeAllocate(bus,address)
    if (handle == 0) return M5ImuProbeResult((3<<48)|(address<<35))
    val caps=m5ImuProbeBegin(handle,candidate)
    var kind=if (candidate == 3) m5ImuSh200q else m5ImuBmi270
    if (candidate == 0) kind=if (caps == 3 || caps == 7) m5ImuProbeMpuKind(handle) else M5ImuKind(0)
    if ((caps == 3 || caps == 7) && kind >= 1 && kind <= 5 && (candidate != 0 || kind <= 3)) {
        val result=M5ImuProbeResult((1<<48)|(caps<<42)|(address<<35)|(kind<<32)|handle)
        if (result.ready()) return result
    }
    if (!m5ImuProbeRelease(handle)) return M5ImuProbeResult((4<<48)|(address<<35)|handle)
    M5ImuProbeResult(2<<48)
}
