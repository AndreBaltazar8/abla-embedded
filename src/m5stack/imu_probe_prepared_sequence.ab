import "./imu_probe_sequence.ab"
import "./magnetometer_probe_sequence.ab"
// Opt-in exclusive single-master scans. Preparation does not replay a failed
// transfer; only the next candidate is attempted. Status5 = bus not prepared.
trusted fun m5ImuProbePreparedOwned(bus: int): M5ImuProbeResult {
    var candidate=0
    while (candidate < 4) {
        if (m5ProbePrepare(bus) != 1) return M5ImuProbeResult(5<<48)
        val result=m5ImuProbeCandidateOwned(bus,candidate)
        if (result.status() != 2) return result
        candidate=candidate+1
    }
    // Leave bus usable after the last absent candidate too.
    M5ImuProbeResult((if (m5ProbePrepare(bus) == 1) 2 else 5)<<48)
}
trusted fun M5Magnetometers.probePreparedOwned(bus: int): int {
    if (!this.valid() || this.status() != 0 || this.handle(1) != 0 || this.handle(2) != 0) return -1
    var kind=1
    while (kind <= 2) {
        if (m5ProbePrepare(bus) != 1) { this.buffer().storeU32(16,5); return 5 }
        val handle=m5MagnetometerAllocate(bus,if (kind == 1) 16 else 12)
        if (handle == 0) { this.buffer().storeU32(16,3); return 3 }
        this.buffer().storeU32(kind*4,handle)
        if (m5MagnetometerBegin(handle,kind) == 4) this.buffer().storeU32(12,kind)
        else if (!this.releaseKind(kind)) { this.buffer().storeU32(16,4); return 4 }
        kind=kind+1
    }
    if (m5ProbePrepare(bus) != 1) { this.buffer().storeU32(16,5); return 5 }
    if (this.handle(2) != 0 && !this.releaseKind(1)) { this.buffer().storeU32(16,4); return 4 }
    val status=if (this.handle(1) != 0 || this.handle(2) != 0) 1 else 2
    this.buffer().storeU32(16,status)
    status
}
