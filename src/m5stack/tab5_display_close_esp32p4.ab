import "./tab5_display_close_sequence.ab"
import "../display/dsi_service_esp32p4.ab"
import "../esp32/dsi_bus_esp32p4.ab"
import "../esp32/dw_gdma_controller_esp32p4.ab"
import "../hal/m5stack.ab"
@export("tab5CloseService")
trusted fun tab5CloseServiceHook(gate: int,channel: int,polls: int): int = esp32P4DsiServiceShutdown(serviceGateAt(gate),channel,polls)
@export("tab5CloseDsi")
trusted fun tab5CloseDsiHook(owner: int,polls: int): int = Esp32P4DsiBus(owner).closeOwned(polls)|0
@export("tab5CloseDma")
trusted fun tab5CloseDmaHook(owner: int,polls: int): int = Esp32P4DwDmaController(owner).closeOwned(polls)|0
