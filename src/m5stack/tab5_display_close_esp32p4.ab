import "./tab5_display_close_sequence.ab"
import "../display/dsi_service_esp32p4.ab"
import "../esp32/dsi_bus_esp32p4.ab"
import "../esp32/dw_gdma_controller_esp32p4.ab"
trusted fun tab5CloseService(gate: int,channel: int,polls: int): int = esp32P4DsiServiceShutdown(serviceGateAt(gate),channel,polls)
trusted fun tab5CloseDsi(owner: int,polls: int): int = Esp32P4DsiBus(owner).closeOwned(polls)|0
trusted fun tab5CloseDma(owner: int,polls: int): int = Esp32P4DwDmaController(owner).closeOwned(polls)|0
