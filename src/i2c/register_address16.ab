import "./results.ab"
import "../esp32/sdk/raw_buffer.ab"

// 16-bit register ADDRESS, MSB first; distinct from16-bit register VALUES.
// Backend supplies write/writeRead. No heap, payload copy or exported ABI.
trusted fun I2cDevice.readRegisterAddress16(register: int, destination: NativeBuffer,
    length: int, timeoutMilliseconds: int = 1000): bool {
    if (register < 0 || register > 65535 || !destination.hasAddressRange(0, length)) return false
    val address = nativeStackAllocate(2)
    nativeAddressStoreU8(address, 0, register >>> 8)
    nativeAddressStoreU8(address, 1, register & 255)
    this.writeRead(nativeBufferAt(address, 2), 2, destination, length, timeoutMilliseconds)
}

trusted fun I2cDevice.readRegisterAddress16ByteChecked(register: int,
    timeoutMilliseconds: int = 1000): I2cByteResult {
    val cell = nativeBufferAt(nativeStackAllocate(1), 1)
    if (!this.readRegisterAddress16(register, cell, 1, timeoutMilliseconds)) return I2cByteResult(0)
    I2cByteResult(256 | cell.load(0))
}

trusted fun I2cDevice.writeRegisterAddress16Byte(register: int, value: int,
    timeoutMilliseconds: int = 1000): bool {
    if (register < 0 || register > 65535 || value < 0 || value > 255) return false
    val address = nativeStackAllocate(3)
    nativeAddressStoreU8(address, 0, register >>> 8)
    nativeAddressStoreU8(address, 1, register & 255)
    nativeAddressStoreU8(address, 2, value)
    this.write(nativeBufferAt(address, 3), 3, timeoutMilliseconds)
}
