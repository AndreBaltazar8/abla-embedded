import "./software_transfer.ab"
import "./results.ab"
// Caller-supplied scratch avoids heap allocation and retains target-independent
// native tests. These operations require the same bus serialization as transfer.
// RMW holds the caller's bus/device lock across BOTH transactions. No retry.
trusted fun SoftwareI2cLines.readRegister8Checked(address: int,register: int,scratch: NativeBuffer): I2cByteResult {
    if (register < 0 || register > 255 || !scratch.hasAddressRange(0,1)) return I2cByteResult(0)
    val result=this.transfer(address,NativeBuffer(0),0,scratch,1,register)
    if (!result.complete()) return I2cByteResult(0)
    return I2cByteResult(256|scratch.load(0))
}
trusted fun SoftwareI2cLines.writeRegister8(address: int,register: int,value: int,scratch: NativeBuffer): bool {
    // Validate everything BEFORE modifying caller scratch or touching the bus.
    if (!this.valid() || address < 1 || address > 127 || register < 0 || register > 255 ||
        value < 0 || value > 255 || !scratch.hasAddressRange(0,1)) return false
    scratch.store(0,value)
    return this.transfer(address,scratch,1,NativeBuffer(0),0,register).complete()
}
trusted fun SoftwareI2cLines.updateRegister8(address: int,register: int,mask: int,value: int,scratch: NativeBuffer): bool {
    if (mask < 0 || mask > 255 || value < 0 || value > 255) return false
    val current=this.readRegister8Checked(address,register,scratch)
    if (!current.valid()) return false
    return this.writeRegister8(address,register,(current.value()&(255-mask))|(value&mask),scratch)
}
