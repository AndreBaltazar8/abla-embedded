// Portable register results: payload plus one success bit, with no heap box.
// Zero payload remains distinguishable from a failed transaction.
type I2cByteResult = int
type I2cWordResult = int
type I2cDwordResult = int

fun I2cByteResult.valid(): bool = (this & 256) != 0
fun I2cByteResult.value(): int = this & 255
fun I2cWordResult.valid(): bool = (this & 65536) != 0
fun I2cWordResult.value(): int = this & 65535
fun I2cWordResult.signedValue(): int {
    val value = this.value()
    if (value < 32768) value else value - 65536
}
fun I2cDwordResult.valid(): bool = (this & 4294967296) != 0
fun I2cDwordResult.value(): int = this & 4294967295
