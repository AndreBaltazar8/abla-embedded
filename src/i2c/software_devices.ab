import "./device_slots.ab"
import "./software_transfer.ab"
// Caller owns one ready physical software bus and one persistent device pool,
// serializing EVERY lifecycle/transaction call. Pool locks alone do not own
// the wire. Preserve generations across reopen; release handles before pads.
trusted fun softwareI2cDevicePoolBytes(pool: I2cDeviceSlots): int {
    if (!pool.valid() || pool.address() > 4294967288) return 0
    val bytes=i2cDeviceSlotsBytes(nativeAddressLoadU32(pool.address(),4))
    return if (bytes == 0 || pool.address() > 4294967296-bytes) 0 else bytes
}
fun softwareI2cDeviceBufferSafe(pool: I2cDeviceSlots,poolBytes: int,buffer: NativeBuffer,length: int): bool =
    buffer.hasAddressRange(0,length) && (length == 0 || buffer.addressValue()+length <= pool.address() || buffer.addressValue() >= pool.address()+poolBytes)
fun SoftwareI2cLines.matchesDevice(descriptor: int): bool {
    val mask=65535|(1048575<<26)
    val lines=SoftwareI2cLines(descriptor&70368744177663)
    return this.valid() && lines.valid() && (descriptor>>>53) == 0 && ((descriptor>>>46)&127) > 0 &&
        (descriptor&mask) == ((this|0)&mask)
}
// Requested frequency is a ceiling; this software engine tops100kHz.
trusted fun SoftwareI2cLines.deviceOwned(pool: I2cDeviceSlots,address: int,frequency: int): int {
    if (!this.valid() || softwareI2cDevicePoolBytes(pool) == 0 || address < 1 || address > 127 || frequency < 1000 || frequency > 400000) return 0
    val requested=int((u32(500000)+u32(frequency)-u32(1))/u32(frequency))
    val lines=softwareI2cLines(this.sda(),this.scl(),if (requested < 5) 5 else requested,(this>>>26)&1048575)
    return pool.allocate((lines|0)|(address<<46))
}
trusted fun SoftwareI2cLines.transferDeviceOwned(pool: I2cDeviceSlots,handle: int,tx: NativeBuffer,written: int,rx: NativeBuffer,read: int,prefix: int = -1): SoftwareI2cTransfer {
    val bytes=softwareI2cDevicePoolBytes(pool)
    if (bytes == 0 || !i2cDeviceSlotHandleValid(handle) || !softwareI2cDeviceBufferSafe(pool,bytes,tx,written) ||
        !softwareI2cDeviceBufferSafe(pool,bytes,rx,read)) return SoftwareI2cTransfer(2)
    val descriptor=pool.resolve(handle)
    if (!this.matchesDevice(descriptor)) return SoftwareI2cTransfer(2)
    return SoftwareI2cLines(descriptor&70368744177663).transfer((descriptor>>>46)&127,tx,written,rx,read,prefix)
}
trusted fun SoftwareI2cLines.closeDeviceOwned(pool: I2cDeviceSlots,handle: int): bool =
    softwareI2cDevicePoolBytes(pool) != 0 && this.matchesDevice(pool.resolve(handle)) && pool.release(handle)
trusted fun SoftwareI2cLines.setDeviceFrequencyOwned(pool: I2cDeviceSlots,handle: int,frequency: int): bool {
    if (softwareI2cDevicePoolBytes(pool) == 0 || frequency < 1000 || frequency > 400000) return false
    val before=pool.resolve(handle)
    if (!this.matchesDevice(before)) return false
    val half=int((u32(500000)+u32(frequency)-u32(1))/u32(frequency))
    val lines=softwareI2cLines(this.sda(),this.scl(),if (half < 5) 5 else half,(this>>>26)&1048575)
    return pool.replace(handle,before,(lines|0)|(before&(127<<46)))
}
trusted fun SoftwareI2cLines.revokeDevicesOwned(pool: I2cDeviceSlots): bool {
    val mask=65535|(1048575<<26)
    return this.valid() && softwareI2cDevicePoolBytes(pool) != 0 && pool.releaseMatching(mask,(this|0)&mask) >= 0
}
