// The register operations of an I2C device as the shared register helpers see them. A program's manifest
// remaps this module to the backend (or fake) it uses: [imports] "<path>/src/i2c/registers.ab" = "<path to the
// module that declares I2cDevice>". The target must declare everything here with the same types
// (E_IMPORT_REMAP_MISMATCH otherwise), so these declarations are the contract. The bodies are never linked.
import "../esp32/sdk/raw_buffer.ab"
import "./results.ab"
type I2cDevice = int
trusted fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool = false
