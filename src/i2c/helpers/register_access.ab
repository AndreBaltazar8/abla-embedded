import "../results.ab"
import "../device.ab"
import "../../esp32/sdk/raw_buffer.ab"
import "abla/unsafe/memory/raw"
import "../../hal/native_buffer.ab"
import "../../hal/i2cdevice.ab"

// The program's backend supplies I2cDevice.readRegister/writeRegister and byte access, through ../registers.ab (remapped).
// These helpers preserve the same scalar results and wire byte order on all
// backends. updateRegister8 is two transactions, not an atomic bus operation.
@exportLocal("abla_i2cdevice_readRegister16BigEndianChecked")
trusted fun i2cDeviceReadRegister16BigEndianCheckedHook(recv: int, register: int): I2cWordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(2), 2)
    if (!I2cDevice(recv).readRegister(register, bytes, 2)) return I2cWordResult(0)
    I2cWordResult(65536 | (bytes.load(0) << 8) | bytes.load(1))
}

@exportLocal("abla_i2cdevice_writeRegister16BigEndian")
trusted fun i2cDeviceWriteRegister16BigEndianHook(recv: int, register: int, value: int): bool {
    val bytes = nativeBufferAt(nativeStackAllocate(2), 2)
    bytes.store(0, value >>> 8)
    bytes.store(1, value)
    I2cDevice(recv).writeRegister(register, bytes, 2)
}

@exportLocal("abla_i2cdevice_readRegister16LittleEndianChecked")
trusted fun i2cDeviceReadRegister16LittleEndianCheckedHook(recv: int, register: int): I2cWordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(2), 2)
    if (!I2cDevice(recv).readRegister(register, bytes, 2)) return I2cWordResult(0)
    I2cWordResult(65536 | bytes.load(0) | (bytes.load(1) << 8))
}

@exportLocal("abla_i2cdevice_writeRegister16LittleEndian")
trusted fun i2cDeviceWriteRegister16LittleEndianHook(recv: int, register: int, value: int): bool {
    val bytes = nativeBufferAt(nativeStackAllocate(2), 2)
    bytes.store(0, value)
    bytes.store(1, value >>> 8)
    I2cDevice(recv).writeRegister(register, bytes, 2)
}

@exportLocal("abla_i2cdevice_readRegister24BigEndianChecked")
trusted fun i2cDeviceReadRegister24BigEndianCheckedHook(recv: int, register: int): I2cDwordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(3), 3)
    if (!I2cDevice(recv).readRegister(register, bytes, 3)) return I2cDwordResult(0)
    I2cDwordResult(4294967296 | (bytes.load(0) << 16) | (bytes.load(1) << 8) | bytes.load(2))
}

@exportLocal("abla_i2cdevice_readRegister32BigEndianChecked")
trusted fun i2cDeviceReadRegister32BigEndianCheckedHook(recv: int, register: int): I2cDwordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(4), 4)
    if (!I2cDevice(recv).readRegister(register, bytes, 4)) return I2cDwordResult(0)
    I2cDwordResult(4294967296 | (bytes.load(0) << 24) | (bytes.load(1) << 16) |
        (bytes.load(2) << 8) | bytes.load(3))
}

@exportLocal("abla_i2cdevice_readRegister32LittleEndianChecked")
trusted fun i2cDeviceReadRegister32LittleEndianCheckedHook(recv: int, register: int): I2cDwordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(4), 4)
    if (!I2cDevice(recv).readRegister(register, bytes, 4)) return I2cDwordResult(0)
    I2cDwordResult(4294967296 | bytes.load(0) | (bytes.load(1) << 8) |
        (bytes.load(2) << 16) | (bytes.load(3) << 24))
}

@exportLocal("abla_i2cdevice_updateRegister8")
trusted fun i2cDeviceUpdateRegister8Hook(recv: int, register: int, mask: int, value: int): bool {
    val current = I2cDevice(recv).readRegister8Checked(register)
    if (!current.valid()) return false
    val selected = mask & 255
    I2cDevice(recv).writeRegister8(register, (current.value() & (255 - selected)) | (value & selected))
}

@exportLocal("abla_i2cdevice_readRegister24LittleEndianChecked")
trusted fun i2cDeviceReadRegister24LittleEndianCheckedHook(recv: int, register: int): I2cDwordResult {
    val bytes=nativeBufferAt(nativeStackAllocate(3),3)
    if (!I2cDevice(recv).readRegister(register,bytes,3)) return I2cDwordResult(0)
    return I2cDwordResult(4294967296|bytes.load(0)|(bytes.load(1)<<8)|(bytes.load(2)<<16))
}
// Like the16-bit writers, transmit the low payload bits (including signed
// two's-complement values). One transaction; failure may leave a written
// prefix, so these helpers never retry or claim rollback.
@exportLocal("abla_i2cdevice_writeRegister24BigEndian")
trusted fun i2cDeviceWriteRegister24BigEndianHook(recv: int, register: int,value: int): bool {
    val bytes=nativeBufferAt(nativeStackAllocate(3),3)
    bytes.store(0,value>>>16);bytes.store(1,value>>>8);bytes.store(2,value)
    return I2cDevice(recv).writeRegister(register,bytes,3)
}
@exportLocal("abla_i2cdevice_writeRegister24LittleEndian")
trusted fun i2cDeviceWriteRegister24LittleEndianHook(recv: int, register: int,value: int): bool {
    val bytes=nativeBufferAt(nativeStackAllocate(3),3)
    bytes.store(0,value);bytes.store(1,value>>>8);bytes.store(2,value>>>16)
    return I2cDevice(recv).writeRegister(register,bytes,3)
}
@exportLocal("abla_i2cdevice_writeRegister32BigEndian")
trusted fun i2cDeviceWriteRegister32BigEndianHook(recv: int, register: int,value: int): bool {
    val bytes=nativeBufferAt(nativeStackAllocate(4),4)
    bytes.store(0,value>>>24);bytes.store(1,value>>>16);bytes.store(2,value>>>8);bytes.store(3,value)
    return I2cDevice(recv).writeRegister(register,bytes,4)
}
@exportLocal("abla_i2cdevice_writeRegister32LittleEndian")
trusted fun i2cDeviceWriteRegister32LittleEndianHook(recv: int, register: int,value: int): bool {
    val bytes=nativeBufferAt(nativeStackAllocate(4),4)
    bytes.store(0,value);bytes.store(1,value>>>8);bytes.store(2,value>>>16);bytes.store(3,value>>>24)
    return I2cDevice(recv).writeRegister(register,bytes,4)
}
