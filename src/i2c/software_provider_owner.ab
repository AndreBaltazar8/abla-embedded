import "./software_devices.ab"
// Common provider view of the retained scalar pad lease. Platform adapters
// perform open/close/recovery; no function pointers, allocation or virtual ABI.
type SoftwareI2cProviderOwner=int
fun SoftwareI2cProviderOwner.lines(): SoftwareI2cLines = SoftwareI2cLines(this&70368744177663)
fun SoftwareI2cProviderOwner.status(): int = (this>>>48)&255
fun SoftwareI2cProviderOwner.ownsSda(): bool = (this&(1<<56)) != 0
fun SoftwareI2cProviderOwner.ownsScl(): bool = (this&(1<<57)) != 0
fun SoftwareI2cProviderOwner.ready(): bool = this.status() == 1 && this.ownsSda() && this.ownsScl()
fun SoftwareI2cProviderOwner.matchesDevice(descriptor: int): bool = this.lines().matchesDevice(descriptor)
trusted fun SoftwareI2cProviderOwner.deviceOwned(pool: I2cDeviceSlots,address: int,frequency: int): int =
    if (this.ready()) this.lines().deviceOwned(pool,address,frequency) else 0
trusted fun SoftwareI2cProviderOwner.closeDeviceOwned(pool: I2cDeviceSlots,handle: int): bool = this.lines().closeDeviceOwned(pool,handle)
trusted fun SoftwareI2cProviderOwner.closeWithDevicesOwned(pool: I2cDeviceSlots): SoftwareI2cProviderOwner = softwareI2cProviderCloseDevices(this,pool)
trusted fun SoftwareI2cProviderOwner.recoverOwned(clearStuck: bool): SoftwareI2cProviderOwner = softwareI2cProviderRecoverOwner(this,clearStuck)
