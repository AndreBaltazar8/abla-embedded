import "./results.ab"
import "../esp32/sdk/raw_buffer.ab"

// Backend supplies I2cDevice.readRegister/writeRegister and byte access.
// These helpers preserve the same scalar results and wire byte order on all
// backends. updateRegister8 is two transactions, not an atomic bus operation.
trusted fun I2cDevice.readRegister16BigEndianChecked(register: int): I2cWordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(2), 2)
    if (!this.readRegister(register, bytes, 2)) return I2cWordResult(0)
    I2cWordResult(65536 | (bytes.load(0) << 8) | bytes.load(1))
}

trusted fun I2cDevice.writeRegister16BigEndian(register: int, value: int): bool {
    val bytes = nativeBufferAt(nativeStackAllocate(2), 2)
    bytes.store(0, value >>> 8)
    bytes.store(1, value)
    this.writeRegister(register, bytes, 2)
}

trusted fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(2), 2)
    if (!this.readRegister(register, bytes, 2)) return I2cWordResult(0)
    I2cWordResult(65536 | bytes.load(0) | (bytes.load(1) << 8))
}

trusted fun I2cDevice.writeRegister16LittleEndian(register: int, value: int): bool {
    val bytes = nativeBufferAt(nativeStackAllocate(2), 2)
    bytes.store(0, value)
    bytes.store(1, value >>> 8)
    this.writeRegister(register, bytes, 2)
}

trusted fun I2cDevice.readRegister24BigEndianChecked(register: int): I2cDwordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(3), 3)
    if (!this.readRegister(register, bytes, 3)) return I2cDwordResult(0)
    I2cDwordResult(4294967296 | (bytes.load(0) << 16) | (bytes.load(1) << 8) | bytes.load(2))
}

trusted fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(4), 4)
    if (!this.readRegister(register, bytes, 4)) return I2cDwordResult(0)
    I2cDwordResult(4294967296 | (bytes.load(0) << 24) | (bytes.load(1) << 16) |
        (bytes.load(2) << 8) | bytes.load(3))
}

trusted fun I2cDevice.readRegister32LittleEndianChecked(register: int): I2cDwordResult {
    val bytes = nativeBufferAt(nativeStackAllocate(4), 4)
    if (!this.readRegister(register, bytes, 4)) return I2cDwordResult(0)
    I2cDwordResult(4294967296 | bytes.load(0) | (bytes.load(1) << 8) |
        (bytes.load(2) << 16) | (bytes.load(3) << 24))
}

trusted fun I2cDevice.updateRegister8(register: int, mask: int, value: int): bool {
    val current = this.readRegister8Checked(register)
    if (!current.valid()) return false
    val selected = mask & 255
    this.writeRegister8(register, (current.value() & (255 - selected)) | (value & selected))
}

trusted fun I2cDevice.readRegister24LittleEndianChecked(register: int): I2cDwordResult {
    val bytes=nativeBufferAt(nativeStackAllocate(3),3)
    if (!this.readRegister(register,bytes,3)) return I2cDwordResult(0)
    return I2cDwordResult(4294967296|bytes.load(0)|(bytes.load(1)<<8)|(bytes.load(2)<<16))
}
// Like the16-bit writers, transmit the low payload bits (including signed
// two's-complement values). One transaction; failure may leave a written
// prefix, so these helpers never retry or claim rollback.
trusted fun I2cDevice.writeRegister24BigEndian(register: int,value: int): bool {
    val bytes=nativeBufferAt(nativeStackAllocate(3),3)
    bytes.store(0,value>>>16);bytes.store(1,value>>>8);bytes.store(2,value)
    return this.writeRegister(register,bytes,3)
}
trusted fun I2cDevice.writeRegister24LittleEndian(register: int,value: int): bool {
    val bytes=nativeBufferAt(nativeStackAllocate(3),3)
    bytes.store(0,value);bytes.store(1,value>>>8);bytes.store(2,value>>>16)
    return this.writeRegister(register,bytes,3)
}
trusted fun I2cDevice.writeRegister32BigEndian(register: int,value: int): bool {
    val bytes=nativeBufferAt(nativeStackAllocate(4),4)
    bytes.store(0,value>>>24);bytes.store(1,value>>>16);bytes.store(2,value>>>8);bytes.store(3,value)
    return this.writeRegister(register,bytes,4)
}
trusted fun I2cDevice.writeRegister32LittleEndian(register: int,value: int): bool {
    val bytes=nativeBufferAt(nativeStackAllocate(4),4)
    bytes.store(0,value);bytes.store(1,value>>>8);bytes.store(2,value>>>16);bytes.store(3,value>>>24)
    return this.writeRegister(register,bytes,4)
}
