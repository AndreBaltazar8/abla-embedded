import "./esp32/sdk/raw_buffer.ab"
// Three targets:0serial1display2callback. Levels0raw1error2warn3info4debug5verbose.
// Scalar policy: each target has level3+color1; enabled bits12..14;
// suffix2 per target at15..20 (0none1LF2CRLF). No strings/heap/printf ABI.
type LogPolicy = int
fun logPolicy(): LogPolicy = LogPolicy(0xddd|(1<<12)|(1<<15)|(1<<17)|(2<<19))
fun LogPolicy.valid(): bool = this >= 0 && (this>>>21) == 0 && (this&7) <= 5 && ((this>>4)&7) <= 5 && ((this>>8)&7) <= 5 && ((this>>15)&3) <= 2 && ((this>>17)&3) <= 2 && ((this>>19)&3) <= 2
fun LogPolicy.level(target: int): int = if (target < 0 || target > 2) -1 else (this>>(target*4))&7
fun LogPolicy.color(target: int): bool = target >= 0 && target < 3 && ((this>>(target*4+3))&1) != 0
fun LogPolicy.enabled(target: int): bool = target >= 0 && target < 3 && ((this>>(target+12))&1) != 0
fun LogPolicy.suffix(target: int): int = if (target < 0 || target > 2) -1 else (this>>(15+target*2))&3
fun LogPolicy.configure(target: int,level: int,color: bool,enabled: bool,suffix: int): LogPolicy {
    if (!this.valid() || target < 0 || target > 2 || level < 0 || level > 5 || suffix < 0 || suffix > 2) return this
    val shift=target*4
    val mask=(15<<shift)|(1<<(target+12))|(3<<(15+target*2))
    return LogPolicy((this&~mask)|((level|(if (color) 8 else 0))<<shift)|((if (enabled) 1 else 0)<<(target+12))|(suffix<<(15+target*2)))
}
fun LogPolicy.targets(level: int): int {
    if (!this.valid() || level < 0 || level > 5) return 0
    var target=0
    var mask=0
    while (target < 3) {
        if (this.enabled(target) && this.level(target) >= level) mask=mask|(1<<target)
        target=target+1
    }
    return mask
}
type LogWriteResult = int
fun LogWriteResult.valid(): bool = this >= 0 && this <= 63 && (this.completed()&~this.attempted()) == 0
fun LogWriteResult.attempted(): int = this&7
fun LogWriteResult.completed(): int = (this>>3)&7
fun LogWriteResult.succeeded(): bool = this.valid() && this.attempted() == this.completed()
// Preformatted bounded bytes, including embedded NUL. Sink hook performs
// output/color/suffix as one owned transaction and reports success; failed
// sinks do not suppress independent sinks. Caller pins text until return.
// Raw print uses level0 and appendSuffix=false, bypassing threshold but not
// disabled targets. No recursive logging within the output hook.
trusted fun LogPolicy.writeOwned(level: int,text: NativeBuffer,length: int,appendSuffix: bool = true): LogWriteResult {
    if (!this.valid() || level < 0 || level > 5 || length < 0 || !text.hasAddressRange(0,length)) return LogWriteResult(128)
    val targets=this.targets(level)
    var completed=0
    var target=0
    while (target < 3) {
        if ((targets&(1<<target)) != 0 && logOutputOwned(target,level,level != 0 && this.color(target),text,length,if (appendSuffix) this.suffix(target) else 0)) completed=completed|(1<<target)
        target=target+1
    }
    return LogWriteResult(targets|(completed<<3))
}
