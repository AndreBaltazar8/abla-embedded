import "./owned_s3_sequence.ab"
import "../esp32/spi/config_sequence_esp32s3.ab"
// Standard-speed SPI SD: PLL80 /4 =20MHz, no CMD6/voltage/high-speed change.
// Both session/bus locks held, initialized SD card deselected, CPU idle/no DMA.
// UPDATE is latched by the next transaction. Readback rejects ignored writes.
trusted fun sdSpiS3TransferClockOwned(link: SdSpiS3Link): bool {
    if (!link.readyWithSelect(true) || !link.clockReady(80000000,400000)) return false
    if (!esp32s3SpiConfigureClockOwned(link.peripheral(),1,1,4,2)) return false
    val base=esp32s3SpiBase(link.peripheral())
    return (esp32s3SpiRead(base+12)&0x803fffff) == ((3<<12)|(1<<6)|3) &&
        (esp32s3SpiRead(base+0xe8)&7) == 7 && link.clockReady(80000000,20000000) && link.readyWithSelect(true)
}
