// Transport-independent SD SPI framing. CRC7 polynomial x^7+x^3+1;
// CRC16 polynomial x^16+x^12+x^5+1, initial state zero, MSB first.
fun sdSpiCrc7Byte(crc: int, value: int): int {
    var state = (crc & 127) << 1
    var data = value & 255
    var bit = 0
    while (bit < 8) {
        val feedback = (state ^ data) & 128
        state = (state << 1) & 255
        if (feedback != 0) state = state ^ 18
        data = (data << 1) & 255
        bit = bit + 1
    }
    state >>> 1
}

fun sdSpiCommandFrameCrc(command: int, argument: int): int {
    var crc = sdSpiCrc7Byte(0, 64 | (command & 63))
    crc = sdSpiCrc7Byte(crc, argument >>> 24)
    crc = sdSpiCrc7Byte(crc, argument >>> 16)
    crc = sdSpiCrc7Byte(crc, argument >>> 8)
    crc = sdSpiCrc7Byte(crc, argument)
    (crc << 1) | 1
}

fun sdSpiCrc16Byte(crc: int, value: int): int {
    var state = (crc & 65535) ^ ((value & 255) << 8)
    var bit = 0
    while (bit < 8) {
        val feedback = state & 32768
        state = (state << 1) & 65535
        if (feedback != 0) state = state ^ 4129
        bit = bit + 1
    }
    state
}

fun sdSpiBlockAddressValid(highCapacity: bool, block: int): bool =
    block >= 0 && block <= (if (highCapacity) 4294967295 else 8388607)

fun sdSpiBlockArgument(highCapacity: bool, block: int): int =
    if (highCapacity) block else block * 512

fun sdSpiR1Available(value: int): bool = value >= 0 && value < 128
fun sdSpiReadToken(value: int): bool = value == 254
fun sdSpiWriteAccepted(value: int): bool =
    value >= 0 && value <= 255 && (value & 31) == 5
