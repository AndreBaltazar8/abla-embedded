import "./block_c61_sequence.ab"
import "./selected_register.ab"
trusted fun Esp32C61SpiMaster.readSdRegister(gate: PeripheralGate,owner: u32,sourceHz: int,
    state: SdSpiInitResult,command: int,scratch: NativeBuffer,destination: NativeBuffer,polls: int = 250): SdSpiReadResult {
    if (!this.ready() || !state.valid() || (command != 9 && command != 10) || !c61SpiGateValid(gate) ||
        !c61SpiBufferValid(scratch,2) || !c61SpiBufferValid(destination,16) || !sdSpiReadStorageValid(scratch,destination,16) ||
        !gate.bufferDisjoint(scratch,2) || !gate.bufferDisjoint(destination,16) ||
        sourceHz < 1000000 || sourceHz > 160000000 || polls < 1 || polls > 1000000) return SdSpiReadResult(2)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SdSpiReadResult(if (admission == 1) 11 else if (admission == 2) 12 else 2)
    var result=14
    if (c61SpiMasterDataReady(this,true) && c61SdClockReady(sourceHz,25000000)) {
        result=if (!c61SpiSelectLevel(this.pins().pinAt(3),false)) 15 else
            sdSpiReadRegisterSelected(this|0,command,scratch,destination,polls)|0
        result=c61SdFinishBlockSelected(this,scratch,result)
    }
    if (!gate.finish(owner,(result&255) == 1)) result=(result&~255)|13
    return SdSpiReadResult(result)
}
