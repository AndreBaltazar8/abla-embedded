import "./owned_s3_sequence.ab"
import "./selected_register.ab"
trusted fun SdSpiS3Link.readSdRegister(gate: PeripheralGate,owner: u32,sourceHz: int,
    state: SdSpiInitResult,command: int,scratch: NativeBuffer,destination: NativeBuffer,polls: int = 250): SdSpiReadResult {
    if (!state.valid() || (command != 9 && command != 10) ||
        !s3SdOwnedStorageReady(this,gate,scratch,destination,16,polls,sourceHz)) return SdSpiReadResult(2)
    val admission=gate.tryBegin(owner)
    if (admission != 0) return SdSpiReadResult(if (admission == 1) 11 else if (admission == 2) 12 else 2)
    var result=14
    if (this.readyWithSelect(true) && this.clockReady(sourceHz,25000000)) {
        result=if (!s3SdSelectLevel(this.select(),false)) 15 else
            sdSpiReadRegisterSelected(this|0,command,scratch,destination,polls)|0
        val cleanup=this.finishSdSelected(scratch)
        if (cleanup != 0) result=(if ((result&255) == 1) (result&~255)|cleanup else result)|(1<<31)
    }
    if (!gate.finish(owner,(result&255) == 1)) result=(result&~255)|13
    return SdSpiReadResult(result)
}
