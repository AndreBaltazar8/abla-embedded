// CSD bits127..32 as three unsigned32 words (high first). Caller checks
// transport integrity; this validates the supported SD capacity fields.
// Zero means unsupported/invalid; valid block counts include2^32 sectors.
fun sdCsdCapacityFields(high: int,middle: int,low: int): int {
    if (high < 0 || high > 4294967295 || middle < 0 || middle > 4294967295 || low < 0 || low > 4294967295) return 0
    val version=high>>>30
    val length=(middle>>>16)&15
    if (version == 1 && length == 9) return ((((middle&63)<<16)|(low>>>16))+1)<<10
    if (version != 0 || length < 9 || length > 11) return 0
    val size=((middle&1023)<<2)|(low>>>30)
    // Legacy result <=2^23; bounded32-bit shift needs no target runtime helper.
    return int(u32(size+1)<<u32(((low>>>15)&7)+2+length-9))
}
