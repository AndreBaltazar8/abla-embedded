import "./mmc_command_esp32s3.ab"
import "./mmc_bus_s3_sequence.ab"
import "../hal/sd.ab"
@export("sdMmcS3SystemRead")
trusted fun sdMmcS3SystemReadHook(address: int): int = mmioLoadU32(address)
@export("sdMmcS3SystemWrite")
trusted fun sdMmcS3SystemWriteHook(address: int,value: int): void { mmioStoreU32(address,value); return }
