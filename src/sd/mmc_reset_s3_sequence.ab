import "./mmc_command_s3_sequence.ab"
// Destructive HOST-state reset, not card reset. Caller owns BOTH slots and
// has explicitly abandoned any pending commands/transfers, stopped DMA and
// interrupt consumers, and retained all DMA buffers until completion.
// Peripheral/host clocks must be running. No RCC reset, pad/power changes,
// interrupt acknowledgement, or automatic reinitialization is performed.
type SdMmcReset = int
//1host reset complete2pending3needs quiescence4invalid caller preconditions.
// Host completion does not mean DAT0/card is ready or filesystem is intact.
trusted fun sdMmcResetStartOwned(exclusive: bool,clocksReady: bool): SdMmcReset {
    if (!exclusive || !clocksReady) return SdMmcReset(4)
    val control=sdMmcS3Read(0)
    // CTRL interrupt/DMA/internalDMA enable and BMOD IDMAC enable must be off.
    if ((control&0x02000030) != 0 || (sdMmcS3Read(128)&128) != 0 || (control&7) != 0) return SdMmcReset(3)
    sdMmcS3Write(0,control|7)
    return SdMmcReset(2)
}
// One bounded poll; never reassert resets while waiting. A caller timeout
// retains ownership and does not convert pending into safe-to-free success.
trusted fun SdMmcReset.pollOwned(): SdMmcReset {
    if (this != 2) return SdMmcReset(4)
    val control=sdMmcS3Read(0)
    if ((control&0x02000030) != 0 || (sdMmcS3Read(128)&128) != 0) return SdMmcReset(3)
    if ((control&7) != 0 || (sdMmcS3Read(44)&0x80000000) != 0 || (sdMmcS3Read(72)&0x4f0) != 0) return SdMmcReset(2)
    return SdMmcReset(1)
}
fun SdMmcReset.status(): int = this|0
