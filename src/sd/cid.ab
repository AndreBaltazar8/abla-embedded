import "./registers.ab"
// SD CID wire bytes, NOT MMC CID or host-endian R2 words. Transport remains
// caller-owned. Each accessor checks register CRC/end bit before publishing.
// -1 means invalid/unavailable, distinct from any unsigned field value.
// Product is five raw bytes; no string allocation or guessed text encoding.
trusted fun sdCidManufacturer(cid: NativeBuffer): int = if (sdRegisterValid(cid)) cid.load(0) else -1
trusted fun sdCidOem(cid: NativeBuffer): int = if (sdRegisterValid(cid)) (cid.load(1)<<8)|cid.load(2) else -1
trusted fun sdCidProductByte(cid: NativeBuffer,index: int): int =
    if (index >= 0 && index < 5 && sdRegisterValid(cid)) cid.load(3+index) else -1
// Raw revision byte, major in high nibble and minor in low nibble.
trusted fun sdCidRevision(cid: NativeBuffer): int = if (sdRegisterValid(cid)) cid.load(8) else -1
trusted fun sdCidSerial(cid: NativeBuffer): int =
    if (sdRegisterValid(cid)) (cid.load(9)<<24)|(cid.load(10)<<16)|(cid.load(11)<<8)|cid.load(12) else -1
// MDT is12 bits: eight-bit year offset from2000 and month1..12.
// Reserved upper byte13 bits do not belong to the date field.
trusted fun sdCidManufacturingYear(cid: NativeBuffer): int =
    if (sdRegisterValid(cid) && (cid.load(14)&15) >= 1 && (cid.load(14)&15) <= 12) 2000+((cid.load(13)&15)<<4)+(cid.load(14)>>>4) else -1
trusted fun sdCidManufacturingMonth(cid: NativeBuffer): int =
    if (sdRegisterValid(cid) && (cid.load(14)&15) >= 1 && (cid.load(14)&15) <= 12) cid.load(14)&15 else -1
