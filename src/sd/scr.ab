// First four SCR wire bytes packed little-endian, plus a validity bit32.
// Structure0 fields from SD Physical Layer SCR: byte0 structure/spec,
// byte1 erase-state/bus widths, byte2 extended versions, byte3 CMD support.
// This decodes capabilities, not transfer integrity; transport must check CRC.
type SdScr = int
fun sdScrDecode(firstWord: u32): SdScr =
    if ((firstWord&u32(0xf0)) != u32(0) || (firstWord&u32(0x100)) == u32(0)) SdScr(0) else SdScr((1<<32)|int(firstWord))
fun SdScr.valid(): bool = (this>>>32) == 1 && (this&0xf0) == 0 && (this&0x100) != 0
fun SdScr.specVersion(): int = if (this.valid()) this&15 else -1
fun SdScr.busWidths(): int = if (this.valid()) (this>>8)&15 else 0
fun SdScr.supportsFourBit(): bool = (this.busWidths()&4) != 0
fun SdScr.erasedHigh(): bool = this.valid() && (this&0x8000) != 0
fun SdScr.commandSupport(): int = if (this.valid()) (this>>24)&3 else 0
