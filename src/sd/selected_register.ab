import "./selected_read.ab"
import "./selected_write.ab"
import "./registers.ab"
// Read result additionally uses8busyTimeout and9embeddedRegisterCRC.
// CRC16 protects transport; the register's separate CRC7/end bit is checked too.
trusted fun sdSpiReadRegisterSelected(context: int,command: int,scratch: NativeBuffer,
    destination: NativeBuffer,polls: int = 250): SdSpiReadResult {
    if ((command != 9 && command != 10) || !sdSpiReadStorageValid(scratch,destination,16) ||
        polls < 1 || polls > 1000000 || !sdSpiSelectedAdmission(context,scratch,destination,16)) return SdSpiReadResult(2)
    val ready=sdSpiWriteWaitReadySelected(context,scratch,polls)
    if (ready != 1) return SdSpiReadResult(if ((ready&255) == 5) 8 else ready)
    val response=sdSpiCommandSelected(context,command,0,scratch,NativeBuffer(0),0)
    if (response.status() == 4) return SdSpiReadResult(4|(response.transportDetail()<<32))
    if (!response.valid() || response.r1() != 0) return SdSpiReadResult(3|(response.r1()<<8))
    val result=sdSpiReadPayloadSelected(context,scratch,destination,16,polls)
    if (result.valid() && !sdRegisterValid(destination)) return SdSpiReadResult(9|(16<<16))
    return result
}
