import "./mmc_card_s3_sequence.ab"
// Read-only views of a ready native-SD card record. Exclusive record lifetime
// remains caller-owned; no host IO or allocation. Hardware validated CMD2 R2
// CRC during initialization. Do not reinterpret response words as SPI bytes,
// or manufacture a CRC byte to make unchecked data appear wire-validated.
// -1 means unavailable. These are SD fields, not MMC CID layout.
trusted fun sdMmcCardManufacturer(card: NativeBuffer): int = if (sdMmcCardStatus(card) == 1) card.load(47) else -1
trusted fun sdMmcCardOem(card: NativeBuffer): int = if (sdMmcCardStatus(card) == 1) (card.load(46)<<8)|card.load(45) else -1
trusted fun sdMmcCardProductByte(card: NativeBuffer,index: int): int =
    if (index >= 0 && index < 5 && sdMmcCardStatus(card) == 1) card.load(44-index) else -1
trusted fun sdMmcCardRevision(card: NativeBuffer): int = if (sdMmcCardStatus(card) == 1) card.load(39) else -1
trusted fun sdMmcCardSerial(card: NativeBuffer): int =
    if (sdMmcCardStatus(card) == 1) (card.load(38)<<24)|(card.load(37)<<16)|(card.load(36)<<8)|card.load(35) else -1
trusted fun sdMmcCardManufacturingYear(card: NativeBuffer): int =
    if (sdMmcCardStatus(card) == 1 && (card.load(33)&15) >= 1 && (card.load(33)&15) <= 12) 2000+((card.load(34)&15)<<4)+(card.load(33)>>>4) else -1
trusted fun sdMmcCardManufacturingMonth(card: NativeBuffer): int =
    if (sdMmcCardStatus(card) == 1 && (card.load(33)&15) >= 1 && (card.load(33)&15) <= 12) card.load(33)&15 else -1
