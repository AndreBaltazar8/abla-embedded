import "./mmc_read_s3_sequence.ab"
import "./scr.ab"
// CMD55(RCA) -> ACMD51 -> exact8-byte DMA read using the common transfer
// engine. Caller owns context64/card80/descriptor16/payload8, all disjoint;
// exclusive configured host and released DMA storage throughout lifetime.
// Same statuses/cleanup ownership as read, no fabricated capability defaults.
trusted fun sdMmcScrBeginOwned(context: NativeBuffer,card: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer,now: u32,budgetMs: int,releasedExclusive: bool): int {
    if (!releasedExclusive || !context.hasAddressRange(0,64) || sdMmcCardStatus(card) != 1 || card.load(5) > 1 ||
        card.loadU32(28) < 1 || card.loadU32(28) > 65535 || budgetMs < 1 || budgetMs > 60000 || !sdMmcDmaRegionsValid(descriptor,payload,8) ||
        !sdMmcReadDisjoint(context.addressValue(),64,card.addressValue(),80) || !sdMmcReadDisjoint(context.addressValue(),64,descriptor.addressValue(),16) ||
        !sdMmcReadDisjoint(context.addressValue(),64,payload.addressValue(),8) || !sdMmcReadDisjoint(card.addressValue(),80,descriptor.addressValue(),16) ||
        !sdMmcReadDisjoint(card.addressValue(),80,payload.addressValue(),8)) return 3
    var index=0
    while (index < 64) { context.store(index,0); index=index+1 }
    context.storeU32(0,0x53445202); context.store(4,5); context.store(5,card.load(5))
    context.storeU32(8,descriptor.addressValue()); context.storeU32(12,payload.addressValue())
    context.storeU32(16,int(now)); context.storeU32(20,budgetMs); context.storeU32(40,2)
    val command=sdMmcCommandStartOwned(card.load(5),55,u32(card.loadU32(28)<<16),1)
    context.storeU32(44,command|0)
    if (command.status() != 2) return sdMmcReadEnd(context,if (command.status() == 4) 8 else 4)
    return 2
}
trusted fun sdMmcScrPollOwned(context: NativeBuffer,now: u32): int {
    if (!context.hasAddressRange(0,64) || context.loadU32(40) != 2) return 3
    val status=sdMmcReadStatus(context)
    if (status != 2) return status
    if (context.load(4) != 5) return sdMmcTransferPollOwned(context,now)
    if (int(now-u32(context.loadU32(16))) >= context.loadU32(20)) return sdMmcReadEnd(context,6)
    val response=nativeBufferAt(context.addressValue()+48,16)
    val command=SdMmcCommand(context.loadU32(44)).pollOwned(response)
    context.storeU32(44,command|0)
    if (command.status() == 2) return 2
    if (command.status() != 1) return sdMmcReadEnd(context,4)
    val r1=response.loadU32(0)
    if (!sdMmcCardR1Valid(r1) || (r1&32) == 0) return sdMmcReadEnd(context,5)
    if (sdMmcDmaPrepareOwned(nativeBufferAt(context.loadU32(8),16),nativeBufferAt(context.loadU32(12),8),8,true) != 1) return sdMmcReadEnd(context,3)
    context.store(4,1)
    return 2
}
trusted fun sdMmcScrResultOwned(context: NativeBuffer): SdScr {
    if (!context.hasAddressRange(0,64) || context.loadU32(40) != 2 || sdMmcReadStatus(context) != 1 || !sdMmcDmaS3Range(context.loadU32(12),8)) return SdScr(0)
    return sdScrDecode(u32(sdMmcDmaS3Read(context.loadU32(12))))
}
