import "./mmc_command_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/sd.ab"
@export("sdMmcS3Read")
trusted fun sdMmcS3ReadHook(offset: int): int = mmioLoadU32(0x60028000+offset)
@export("sdMmcS3Write")
trusted fun sdMmcS3WriteHook(offset: int,value: int): void {
    mmioStoreU32(0x60028000+offset,value)
    return
}
