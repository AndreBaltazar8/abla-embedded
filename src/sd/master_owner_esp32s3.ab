import "./master_owner_s3_sequence.ab"
import "./session_esp32s3.ab"
import "../esp32/spi/master_session_esp32s3.ab"
import "./transfer_clock_s3_sequence.ab"
trusted fun s3SdOwnerMasterBegin(storage: NativeBuffer,link: SdSpiS3Link,owner: u32,polls: int): int =
    esp32S3SpiMasterSessionBeginOwned(storage,link.peripheral(),link.pins(),link.select(),1,4,50,0,owner,polls,true)
trusted fun s3SdOwnerMasterTransferClock(link: SdSpiS3Link): bool = sdSpiS3TransferClockOwned(link)
trusted fun s3SdOwnerMasterClose(storage: NativeBuffer,polls: int): int {
    // Capture can fail before any pad/config mutation or valid master record.
    if (storage.loadU32(0) == 0) return 2
    return esp32S3SpiMasterSessionCloseOwned(storage,polls,true)
}
