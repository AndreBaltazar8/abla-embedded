import "./selected_s3_sequence.ab"
import "../esp32/spi/pins_esp32s3.ab"
import "../esp32/spi/transfer_esp32s3.ab"
import "../esp32/peripheral_delay_esp32s3.ab"
fun s3SdMuxAddress(number: int): int = esp32S3GpioMuxAddress(number)
trusted fun sdSpiSelectedDelay(microseconds: int): void = peripheralDelayMicroseconds(microseconds)
// Selected-phase operations only. Caller provides <=400kHz/74+ idle clocks
// before initialization; <=25MHz after it, normal mode0/MSB-first, stable power.
// Caller owns gate, CS assertion/deassertion and post-CS release clocks for
// the entire protocol. Initialization result belongs to that same card lifetime.
