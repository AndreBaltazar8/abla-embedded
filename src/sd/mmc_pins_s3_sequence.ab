// 1/4-bit SD pin profile: CLK,CMD,D0,D1,D2,D3 in six6-bit fields;
// width4bit36,valid37. In1-bit mode unusedD1..3 must be -1.
// Caller owns released RTC/USB/hold/peripheral pads and destination signals,
// has excluded flash/PSRAM pins for the actual package, and disabled cardclock.
// These ownership facts cannot be inferred from GPIO numbers alone.
type SdMmcPins = int
fun sdMmcPins(clock: int,command: int,d0: int,d1: int = -1,d2: int = -1,d3: int = -1): SdMmcPins {
    if (clock < 0 || clock > 48 || command < 0 || command > 48 || d0 < 0 || d0 > 48 || d1 < -1 || d1 > 48 || d2 < -1 || d2 > 48 || d3 < -1 || d3 > 48) return SdMmcPins(0)
    val wide=d1 >= 0 && d2 >= 0 && d3 >= 0
    if (!wide && (d1 != -1 || d2 != -1 || d3 != -1)) return SdMmcPins(0)
    return SdMmcPins((1<<37)|(if (wide) 1<<36 else 0)|clock|(command<<6)|(d0<<12)|((d1&63)<<18)|((d2&63)<<24)|((d3&63)<<30))
}
fun SdMmcPins.width(): int = if ((this&(1<<36)) != 0) 4 else 1
fun SdMmcPins.pin(index: int): int = if (index == 0) this&63 else if (index == 1) (this>>6)&63 else if (index == 2) (this>>12)&63 else if (index == 3) (this>>18)&63 else if (index == 4) (this>>24)&63 else if (index == 5) (this>>30)&63 else -1
fun SdMmcPins.valid(): bool {
    if ((this>>>37) != 1) return false
    val count=this.width()+2
    var index=0
    while (index < count) {
        if (!Pin(this.pin(index)).outputCapable()) return false
        var previous=0
        while (previous < index) { if (this.pin(previous) == this.pin(index)) return false; previous=previous+1 }
        index=index+1
    }
    return this.width() == 4 || (this.pin(3) == 63 && this.pin(4) == 63 && this.pin(5) == 63)
}
//1routed2invalid/precondition,3+index routefailed,16+index drivefailed.
// Full validation before pad mutation; failure can leave partial routing.
// Caller retains ownership to retry or explicitly detach. External pullups
// are required by the card interface; this does not pretend internal pulls
// replace them. Clock floating; CMD/DAT weak pullups supplemental only.
trusted fun SdMmcPins.routeOwned(slot: int,padsReleased: bool,clockStopped: bool): int {
    if (slot < 0 || slot > 1 || !padsReleased || !clockStopped || !this.valid()) return 2
    var index=0
    while (index < this.width()+2) {
        val pin=Pin(this.pin(index))
        pin.setPull(index != 0,false)
        if (!pin.setDriveStrength(3)) return 16+index
        val signal=if (index == 0) 172+slot else if (index == 1) 178+slot else (if (slot == 0) 180 else 213)+index-2
        val routed=if (index == 0) pin.routeOutputSignal(signal,false) else pin.routeBidirectionalSignal(signal,signal)
        if (!routed) return 3+index
        index=index+1
    }
    return 1
}
