import "./register_c61_sequence.ab"
// Canonical caller-owned64B storage: lock0, magic4, generation8, state12,
// master16, bus gate24, initialization32, sourceHz40, last result48, sector count56.
// Handle: address32 + generation24. Copies share one owner; generations never
// wrap. Storage must remain live and must NEVER be reinitialized/recycled while
// stale handles exist. Explicit invalidation is required before removal/reset,
// rail changes or master reconfiguration; no electrical card detect is implied.
type Esp32C61SdSession=int
fun Esp32C61SdSession.storage(): NativeBuffer = nativeBufferAt(this&4294967295,64)
fun c61SdSessionSpan(storage: NativeBuffer): bool =
    c61SpiBufferValid(storage,64) && (storage.addressValue()&3) == 0
fun c61SdSessionDisjoint(storage: NativeBuffer,buffer: NativeBuffer,bytes: int): bool =
    buffer.hasAddressRange(0,bytes) && (buffer.addressValue()+bytes <= storage.addressValue() ||
        storage.addressValue()+64 <= buffer.addressValue())
trusted fun c61SdSessionLoad64(storage: NativeBuffer,offset: int): int =
    storage.loadU32(offset)|(storage.loadU32(offset+4)<<32)
trusted fun c61SdSessionStore64(storage: NativeBuffer,offset: int,value: int): void {
    storage.storeU32(offset,value);storage.storeU32(offset+4,value>>>32);return
}
// Fresh, unpublished storage only. This does not close a previous owner.
trusted fun esp32C61SdSessionInitializeFresh(storage: NativeBuffer): bool {
    if (!c61SdSessionSpan(storage)) return false
    var offset=0
    while (offset < 64) { storage.storeU32(offset,0);offset=offset+4 }
    storage.storeU32(4,0x53444331);return true
}
trusted fun c61SdSessionStorageValid(storage: NativeBuffer): bool =
    c61SdSessionSpan(storage) && storage.loadU32(4) == 0x53444331
trusted fun c61SdSessionCurrentLocked(session: Esp32C61SdSession): bool {
    val storage=session.storage();val generation=(session>>>32)&16777215
    return generation != 0 && storage.loadU32(8) == generation && storage.loadU32(12) == 1
}
// Exclusive opening/reopening under session lock, then physical bus lock.
// Returns zero on failure; last result at48 is readable under exclusive access.
// A failed bus operation requires explicit physical-bus recovery before reopen.
// response is16B, reused for R7/OCR then validated CSD. No extra allocation.
// Last result17 means unsupported capacity or CSD/addressing-mode mismatch.
trusted fun esp32C61SdSessionOpen(storage: NativeBuffer,master: Esp32C61SpiMaster,gate: PeripheralGate,
    owner: u32,sourceHz: int,scratch: NativeBuffer,response: NativeBuffer,polls: int = 1000): Esp32C61SdSession {
    if (!c61SdSessionStorageValid(storage) || !c61SpiGateValid(gate) || !gate.bufferDisjoint(storage,64) ||
        !c61SpiBufferValid(response,16) || !gate.bufferDisjoint(response,16) ||
        !sdSpiReadStorageValid(scratch,response,16) ||
        !c61SdSessionDisjoint(storage,scratch,2) || !c61SdSessionDisjoint(storage,response,16)) return Esp32C61SdSession(0)
    val lock=peripheralGateAt(storage.addressValue())
    if (lock.tryBegin(owner) != 0) return Esp32C61SdSession(0)
    val generation=storage.loadU32(8)
    if (storage.loadU32(12) == 1 || generation >= 16777215) {
        lock.finish(owner,true);return Esp32C61SdSession(0)
    }
    storage.storeU32(8,generation+1);storage.storeU32(12,2)
    c61SdSessionStore64(storage,16,master|0);c61SdSessionStore64(storage,24,gate|0)
    storage.storeU32(40,sourceHz);c61SdSessionStore64(storage,56,0)
    val result=master.initializeSd(gate,owner,sourceHz,scratch,response,polls)
    c61SdSessionStore64(storage,32,result|0);c61SdSessionStore64(storage,48,result|0)
    var count=0
    if (result.valid()) {
        val register=master.readSdRegister(gate,owner,sourceHz,result,9,scratch,response,polls)
        if (register.valid()) {
            count=sdCsdBlockCount(response)
            if ((response.load(0)>>>6) != (if (result.highCapacity()) 1 else 0)) count=0
            if (count == 0) c61SdSessionStore64(storage,48,17)
        } else c61SdSessionStore64(storage,48,register|0)
    }
    c61SdSessionStore64(storage,56,count)
    storage.storeU32(12,if (count != 0) 1 else 3)
    if (!lock.finish(owner,true)) return Esp32C61SdSession(0)
    return if (count != 0) Esp32C61SdSession(storage.addressValue()|((generation+1)<<32)) else Esp32C61SdSession(0)
}
// Zero means stale/busy/invalid; a valid card always has at least one sector.
trusted fun Esp32C61SdSession.blockCount(owner: u32): int {
    val storage=this.storage()
    if (!c61SdSessionStorageValid(storage)) return 0
    val lock=peripheralGateAt(storage.addressValue())
    if (lock.tryBegin(owner) != 0) return 0
    val count=if (c61SdSessionCurrentLocked(this)) c61SdSessionLoad64(storage,56) else 0
    if (!lock.finish(owner,true)) return 0
    return count
}
// Revokes every copy of this generation. Does not release pads, reset a busy
// controller or power down the card. Caller handles that lifecycle separately.
trusted fun Esp32C61SdSession.invalidate(owner: u32): bool {
    val storage=this.storage()
    if (!c61SdSessionStorageValid(storage)) return false
    val lock=peripheralGateAt(storage.addressValue())
    if (lock.tryBegin(owner) != 0) return false
    val current=c61SdSessionCurrentLocked(this)
    if (current) storage.storeU32(12,0)
    val released=lock.finish(owner,true)
    return current && released
}
trusted fun Esp32C61SdSession.transferBlock(owner: u32,block: int,scratch: NativeBuffer,
    payload: NativeBuffer,write: bool,polls: int = 250,registerCommand: int = 0): int {
    val storage=this.storage()
    if ((registerCommand != 0 && registerCommand != 9 && registerCommand != 10) || (write && registerCommand != 0) ||
        !c61SdSessionStorageValid(storage) || !c61SdSessionDisjoint(storage,scratch,2) ||
        !c61SdSessionDisjoint(storage,payload,if (registerCommand == 0) 512 else 16)) return 2
    val lock=peripheralGateAt(storage.addressValue())
    val admission=lock.tryBegin(owner)
    if (admission != 0) return if (admission == 1) 11 else if (admission == 2) 12 else 2
    var result=2
    if (c61SdSessionCurrentLocked(this) &&
        (registerCommand != 0 || sdCardContainsBlocks(c61SdSessionLoad64(storage,56),block,1))) {
        val master=Esp32C61SpiMaster(c61SdSessionLoad64(storage,16))
        val gate=PeripheralGate(c61SdSessionLoad64(storage,24))
        val state=SdSpiInitResult(c61SdSessionLoad64(storage,32))
        val sourceHz=storage.loadU32(40)
        result=if (registerCommand != 0) master.readSdRegister(gate,owner,sourceHz,state,registerCommand,scratch,payload,polls)|0
            else if (write) master.writeSdBlock(gate,owner,sourceHz,state,block,scratch,payload,polls)|0
            else master.readSdBlock(gate,owner,sourceHz,state,block,scratch,payload,polls)|0
        c61SdSessionStore64(storage,48,result)
        // Invalid arguments and bus contention did not touch the card. Every
        // other failure revokes this generation until explicit reopen.
        val status=result&255
        if (status != 1 && status != 2 && status != 11) storage.storeU32(12,3)
    }
    if (!lock.finish(owner,true)) return (result&~255)|13
    return result
}
trusted fun Esp32C61SdSession.readBlock(owner: u32,block: int,scratch: NativeBuffer,
    destination: NativeBuffer,polls: int = 250): SdSpiReadResult =
    SdSpiReadResult(this.transferBlock(owner,block,scratch,destination,false,polls))
trusted fun Esp32C61SdSession.writeBlock(owner: u32,block: int,scratch: NativeBuffer,
    source: NativeBuffer,polls: int = 250): SdSpiWriteResult =
    SdSpiWriteResult(this.transferBlock(owner,block,scratch,source,true,polls))
trusted fun Esp32C61SdSession.readRegister(owner: u32,command: int,scratch: NativeBuffer,
    destination: NativeBuffer,polls: int = 250): SdSpiReadResult =
    if (command != 9 && command != 10) SdSpiReadResult(2)
    else SdSpiReadResult(this.transferBlock(owner,0,scratch,destination,false,polls,command))
