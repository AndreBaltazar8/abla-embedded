import "../esp32/sdk/raw_buffer.ab"
// S3 SDMMC command-only primitive, from IDF sdmmc_hw_cmd_t/LL registers.
// Caller exclusively owns configured host clocks/pads/slot/timeouts/interrupt
// consumption for the WHOLE pending lifetime; no overlapping DMA/data command.
// No setup, data transfer, card initialization or recovery is implied here.
// response0none1shortCRC2longCRC3shortNoCRC4shortCRC+DAT0busy.
// Only known non-data SD commands admitted; APP_CMD context remains caller's.
type SdMmcCommand = int
// 1complete2pending3invalid4hostbusy5hardwareerror. Kindbits9..11, donebit8;
// raw command error bits16..31. Error needs explicit host quiescence/recovery.
fun SdMmcCommand.status(): int = this&255
fun SdMmcCommand.events(): int = (this>>16)&65535
fun sdMmcCommandIndexValid(index: int): bool = index == 0 || index == 2 || index == 3 || index == 7 || index == 8 || index == 9 || index == 10 || index == 13 || index == 16 || index == 41 || index == 55
fun sdMmcCommandWord(slot: int,index: int,response: int,initialClocks: bool): int {
    if (slot < 0 || slot > 1 || !sdMmcCommandIndexValid(index) || response < 0 || response > 4) return -1
    return 0xa0002000|(slot<<16)|index|(if (initialClocks) 32768 else 0)|(if (response != 0) 64 else 0)|
        (if (response == 2) 128 else 0)|(if (response == 1 || response == 2 || response == 4) 256 else 0)
}
trusted fun sdMmcCommandStartOwned(slot: int,index: int,argument: u32,response: int,initialClocks: bool = false): SdMmcCommand {
    val command=sdMmcCommandWord(slot,index,response,initialClocks)
    if (command < 0) return SdMmcCommand(3)
    if ((sdMmcS3Read(44)&0x80000000) != 0 || (sdMmcS3Read(72)&0x6f0) != 0) return SdMmcCommand(4)
    // Clear only command events; preserve unrelated card-detect/SDIO/data IRQs.
    sdMmcS3Write(68,0x1546)
    if ((sdMmcS3Read(68)&0x1546) != 0) return SdMmcCommand(4)
    sdMmcS3Write(40,int(argument))
    if (sdMmcS3Read(40) != int(argument)) return SdMmcCommand(5)
    sdMmcS3Write(44,command)
    return SdMmcCommand((response<<9)|2)
}
// One nonblocking poll. Keep returned state; pending is NOT timeout/success.
// Caller must bound walltime externally and retain ownership on timeout until
// explicit recovery. Destination16bytes remains untouched until completion;
// returns raw RESP0..3 words in controller order, not normalized CID/CSD bytes.
trusted fun SdMmcCommand.pollOwned(destination: NativeBuffer): SdMmcCommand {
    if (this.status() != 2 || (this>>>12) != 0 || ((this>>9)&7) > 4 || !destination.hasAddressRange(0,16)) return SdMmcCommand(3)
    val events=sdMmcS3Read(68)&0x1546
    if ((events&0x1542) != 0) {
        sdMmcS3Write(68,events)
        return SdMmcCommand((events<<16)|5)
    }
    var state=this|0
    if ((events&4) != 0) { state=state|256; sdMmcS3Write(68,4) }
    if ((state&256) == 0 || (sdMmcS3Read(44)&0x80000000) != 0) return SdMmcCommand(state)
    val response=(state>>9)&7
    if (response == 4 && (sdMmcS3Read(72)&0x600) != 0) return SdMmcCommand(state)
    var index=0
    while (index < 4) {
        val value=if (response == 0 || (response != 2 && index != 0)) 0 else sdMmcS3Read(48+index*4)
        destination.storeU32(index*4,value)
        index=index+1
    }
    return SdMmcCommand((state&~255)|1)
}
