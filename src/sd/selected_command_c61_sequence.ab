import "./selected_command.ab"
import "../esp32/spi/transaction_c61_sequence.ab"
// Caller holds canonical gate, mode0/MSB-first clock <=400kHz during card
// initialization, CS low, both pads present and card power settled. scratch
// must be disjoint from gate/owner storage (caller lifetime contract).
trusted fun sdSpiSelectedAdmission(context: int,scratch: NativeBuffer,trailing: NativeBuffer,bytes: int): bool {
    val master=Esp32C61SpiMaster(context)
    if (!master.ready() || !c61SpiBufferValid(scratch,2) ||
        (bytes != 0 && (bytes < 0 || !trailing.hasAddressRange(0,bytes) ||
            (trailing.addressValue() < 0x60100000 && trailing.addressValue()+bytes > 0x60000000))) ||
        !esp32C61SpiCpuIdleOwned()) return false
    val cs=master.pins().pinAt(3)
    return c61SpiManualSelectReady(cs) &&
        (c61GpioRead(0x60091004)&(u32(1)<<u32(cs))) == u32(0) &&
        c61SpiDataPadReady(master.pins().pinAt(0),64,false) &&
        c61SpiDataPadReady(master.pins().pinAt(1),66,false) && c61SpiDataPadReady(master.pins().pinAt(2),65,true) &&
        (c61SpiRead(0x60081020)&u32(1<<29)) == u32(0) &&
        (c61SpiRead(0x60081010)&u32(512)) == u32(0) &&
        (c61SpiRead(0x60081008)&u32(0x07800000)) == u32(0)
}
trusted fun sdSpiSelectedExchange(context: int,value: int,scratch: NativeBuffer): int {
    scratch.store(0,value)
    val result=esp32C61SpiTransferOwned(nativeBufferAt(scratch.addressValue(),1),
        nativeBufferAt(scratch.addressValue()+1,1),1,1000,true)
    return if (result == 257) (1<<32)|scratch.load(1) else result
}
