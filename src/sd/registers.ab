import "./spi_protocol.ab"
import "./csd_capacity.ab"
import "../esp32/sdk/raw_buffer.ab"

// Registers are 16 wire-order bytes, not target-endian u32 arrays.
trusted fun sdRegisterValid(register: NativeBuffer): bool {
    if (!register.hasAddressRange(0, 16)) return false
    var crc = 0
    var index = 0
    while (index < 15) {
        crc = sdSpiCrc7Byte(crc, register.load(index))
        index = index + 1
    }
    register.load(15) == ((crc << 1) | 1)
}

// Number of 512-byte sectors, including the full 2^32-sector SDXC boundary.
// Zero rejects corrupt/unsupported CSDs. SDUC/CSD v3 is not silently truncated.
trusted fun sdCsdBlockCount(csd: NativeBuffer): int {
    if (!sdRegisterValid(csd)) return 0
    val high=(csd.load(0)<<24)|(csd.load(1)<<16)|(csd.load(2)<<8)|csd.load(3)
    val middle=(csd.load(4)<<24)|(csd.load(5)<<16)|(csd.load(6)<<8)|csd.load(7)
    val low=(csd.load(8)<<24)|(csd.load(9)<<16)|(csd.load(10)<<8)|csd.load(11)
    return sdCsdCapacityFields(high,middle,low)
}

fun sdCardContainsBlocks(blockCount: int, first: int, count: int): bool =
    blockCount > 0 && blockCount <= 4294967296 && first >= 0 && count >= 0 &&
    first <= blockCount && count <= blockCount - first
