import "./mmc_command_s3_sequence.ab"
// Configure shared host clock only after BOTH card clocks were disabled by
// completed CIU clock updates. Caller owns gated-on peripheral and pins,
// source lifetime and all command/DMA activity; no RCC/PLL ownership implied.
// PLL160 must actually be stable if selected; XTAL otherwise. Divisor2..16.
// Return1written,2invalid,3busy,4readbackfailure. After1 caller MUST wait at
// least10us for propagation before card clock updates (IDF sd_host_set_clk_div).
// Failure is not rollback; retain ownership and inspect/recover explicitly.
trusted fun sdMmcHostClockConfigureOwned(divisor: int,pll160: bool,sourceReady: bool): int {
    if (!sourceReady || divisor < 2 || divisor > 16) return 2
    if ((sdMmcS3Read(16)&65535) != 0 || (sdMmcS3Read(44)&0x80000000) != 0 || (sdMmcS3Read(72)&0x6f0) != 0 ||
        (sdMmcS3Read(0)&0x02000027) != 0) return 3
    val high=(divisor>>1)-1
    val low=divisor-1
    // phase_dout=90deg; din/core=0; preserve reserved bits21,22,24..31.
    val desired=(sdMmcS3Read(2048)&~0x009fffff)|1|(high<<9)|(low<<13)|(low<<17)|(if (pll160) 1<<23 else 0)
    sdMmcS3Write(2048,desired)
    return if (sdMmcS3Read(2048) == desired) 1 else 4
}

// Identification-mode transport profile after controller/FIFO/DMA reset and
// before enabling card clocks: 1-bit SDR, 255-clock response timeout, explicit
// data timeout. Caller owns BOTH slots (TMOUT is shared), the running host
// clock, pads and interrupt consumers. This does not negotiate the card bus
// width or turn off live CIU clocks. No implicit PLL/RCC/power/pad operation.
// cardHz is the planned clock rounded UP to whole Hz, not a rounded-down
// display value; use plan.actualHzCeiling() so timeout rounding never shortens.
// 1configured2invalid3busy4readbackfailure; partial writes are not rollback.
trusted fun sdMmcHostIdentificationConfigureOwned(slot: int,cardHz: int,dataTimeoutMs: int,exclusive: bool): int {
    if (!exclusive || slot < 0 || slot > 1 || cardHz < 1 || cardHz > 400000 || dataTimeoutMs < 1 || dataTimeoutMs > 1000) return 2
    if ((sdMmcS3Read(16)&65535) != 0 || (sdMmcS3Read(44)&0x80000000) != 0 ||
        (sdMmcS3Read(72)&0x3ffe06f0) != 0 || (sdMmcS3Read(0)&0x02000037) != 0 ||
        (sdMmcS3Read(128)&0x83) != 0 || (sdMmcS3Read(140)&0x1e000) != 0) return 3
    // Bounds above keep the product <=400M, so no 64-bit division helper.
    val cycles=int((u32(cardHz)*u32(dataTimeoutMs)+u32(999))/u32(1000))
    val timeout=(cycles<<8)|255
    val bit=1<<slot
    val width=sdMmcS3Read(24)&~(bit|(bit<<16))
    val uhs=sdMmcS3Read(116)&~(bit<<16)
    val ddr=sdMmcS3Read(268)&~bit
    sdMmcS3Write(20,timeout)
    if (sdMmcS3Read(20) != timeout) return 4
    sdMmcS3Write(24,width)
    if (sdMmcS3Read(24) != width) return 4
    sdMmcS3Write(116,uhs)
    if (sdMmcS3Read(116) != uhs) return 4
    sdMmcS3Write(268,ddr)
    if (sdMmcS3Read(268) != ddr) return 4
    return 1
}
