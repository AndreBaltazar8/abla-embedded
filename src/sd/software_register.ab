import "./software_block.ab"
import "./registers.ab"

// Read CSD (9) or CID (10), preserving one CS/gate interval through CRC16.
// Also verify the register's embedded CRC7/end bit before reporting success.
trusted fun softwareSdReadRegister(gate: PeripheralGate, owner: u32,
    clock: Pin, mosi: Pin, miso: Pin, chipSelect: Pin,
    cardState: SoftwareSdInitResult, command: int, destination: NativeBuffer,
    halfPeriodMicroseconds: int = 2): SoftwareSdBlockResult {
    if (!cardState.valid() || (command != 9 && command != 10) ||
        !gate.bufferDisjoint(destination, 16) || mosi.number() < 0 || miso.number() < 0 ||
        !softwareSpiConfigurationValid(clock, mosi, miso, 0, halfPeriodMicroseconds) ||
        !softwareSpiSelectionValid(clock, mosi, miso, chipSelect, 0, 0)) return SoftwareSdBlockResult(3)
    val admission = gate.tryBegin(owner)
    if (admission != 0) return SoftwareSdBlockResult(if (admission == 1) 2 else if (admission == 2) 4 else 3)
    clock.write(false)
    chipSelect.write(false)
    var result = SoftwareSdBlockResult(11)
    if (softwareSdWaitReadySelected(clock, mosi, miso, halfPeriodMicroseconds)) {
        result = SoftwareSdBlockResult(6)
        if (softwareSdCommandSelected(clock, mosi, miso, command, 0, nativeBufferAt(0, 0), 0, halfPeriodMicroseconds) == 0) {
            result = softwareSdReadPayloadSelected(clock, mosi, miso, destination, 16, halfPeriodMicroseconds)
            if (result.valid() && !sdRegisterValid(destination)) result = SoftwareSdBlockResult(9)
        }
    }
    chipSelect.write(true)
    softwareSpiExchangeWordOwned(clock, mosi, Pin(-1), u32(255), 8, 0, halfPeriodMicroseconds)
    if (!gate.finish(owner, true)) return SoftwareSdBlockResult(5)
    result
}
