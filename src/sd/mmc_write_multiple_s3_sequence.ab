import "./mmc_read_multiple_s3_sequence.ab"
// Explicit destructive CMD25 sector write, not a FAT transaction. Context72,
// immutable payload and descriptor chain remain caller-owned/pinned until
// terminal DMA cleanup; errors may mean partially modified media. No retries,
// rollback, pre-erase, or write permission inferred from an initialized card.
// Same addressing/span/disjointness checks as multi-read, plus CSD protection.
// RX cannot satisfy TX; auto CMD12 and CMD13 READY/TRAN are mandatory.
trusted fun sdMmcWriteMultipleBeginOwned(context: NativeBuffer,card: NativeBuffer,descriptors: NativeBuffer,payload: NativeBuffer,sector: int,sectors: int,now: u32,budgetMs: int,releasedExclusive: bool,allowWrite: bool): int {
    if (!allowWrite || !releasedExclusive || sdMmcCardStatus(card) != 1) return 3
    if ((card.loadU32(48)&0x3000) != 0) return 10
    val begun=sdMmcReadMultipleBeginOwned(context,card,descriptors,payload,sector,sectors,now,budgetMs,true)
    if (begun != 2) return begun
    context.storeU32(40,4)
    return 2
}
trusted fun sdMmcWriteMultiplePollOwned(context: NativeBuffer,now: u32): int {
    if (!context.hasAddressRange(0,72) || context.loadU32(40) != 4) return 3
    return sdMmcMultipleTransferPollOwned(context,now)
}
