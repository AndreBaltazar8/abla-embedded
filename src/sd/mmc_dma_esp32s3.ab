import "./mmc_dma_s3_sequence.ab"
import "abla/unsafe/mmio"
import "../hal/sd.ab"
@export("sdMmcDmaS3Read")
trusted fun sdMmcDmaS3ReadHook(address: int): int = mmioLoadU32(address)
@export("sdMmcDmaS3Write")
trusted fun sdMmcDmaS3WriteHook(address: int,value: int): void {
    mmioStoreU32(address,value)
    return
}
