import "./mmc_negotiate_sequence.ab"
import "./mmc_scr_esp32s3.ab"
import "./mmc_width_esp32s3.ab"
import "../hal/sd.ab"
import "../hal/sd_3.ab"
@export("sdMmcNegotiationAdmission")
trusted fun sdMmcNegotiationAdmissionHook(card: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer): bool =
    sdMmcCardStatus(card) == 1 && sdMmcCardBlockCount(card) > 0 && card.load(5) <= 1 &&
    card.loadU32(28) >= 1 && card.loadU32(28) <= 65535 && sdMmcDmaRegionsValid(descriptor,payload,8)
@export("sdMmcNegotiationScrBegin")
trusted fun sdMmcNegotiationScrBeginHook(context: NativeBuffer,card: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer,now: u32,budget: int): int =
    sdMmcScrBeginOwned(context,card,descriptor,payload,now,budget,true)
@export("sdMmcNegotiationScrPoll")
trusted fun sdMmcNegotiationScrPollHook(context: NativeBuffer,now: u32): int = sdMmcScrPollOwned(context,now)
@export("sdMmcNegotiationScrResult")
trusted fun sdMmcNegotiationScrResultHook(context: NativeBuffer): SdScr = sdMmcScrResultOwned(context)
@export("sdMmcNegotiationWidthBegin")
trusted fun sdMmcNegotiationWidthBeginHook(context: NativeBuffer,card: NativeBuffer,scr: SdScr,width: int,now: u32,budget: int): int =
    sdMmcWidthBeginOwned(context,card,scr,width,now,budget,true)
@export("sdMmcNegotiationWidthPoll")
trusted fun sdMmcNegotiationWidthPollHook(context: NativeBuffer,now: u32): int = sdMmcWidthPollOwned(context,now)
