import "./mmc_negotiate_sequence.ab"
import "./mmc_scr_esp32s3.ab"
import "./mmc_width_esp32s3.ab"
trusted fun sdMmcNegotiationAdmission(card: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer): bool =
    sdMmcCardStatus(card) == 1 && sdMmcCardBlockCount(card) > 0 && card.load(5) <= 1 &&
    card.loadU32(28) >= 1 && card.loadU32(28) <= 65535 && sdMmcDmaRegionsValid(descriptor,payload,8)
trusted fun sdMmcNegotiationScrBegin(context: NativeBuffer,card: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer,now: u32,budget: int): int =
    sdMmcScrBeginOwned(context,card,descriptor,payload,now,budget,true)
trusted fun sdMmcNegotiationScrPoll(context: NativeBuffer,now: u32): int = sdMmcScrPollOwned(context,now)
trusted fun sdMmcNegotiationScrResult(context: NativeBuffer): SdScr = sdMmcScrResultOwned(context)
trusted fun sdMmcNegotiationWidthBegin(context: NativeBuffer,card: NativeBuffer,scr: SdScr,width: int,now: u32,budget: int): int =
    sdMmcWidthBeginOwned(context,card,scr,width,now,budget,true)
trusted fun sdMmcNegotiationWidthPoll(context: NativeBuffer,now: u32): int = sdMmcWidthPollOwned(context,now)
