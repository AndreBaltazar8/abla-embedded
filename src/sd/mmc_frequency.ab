// S3 divider search: host2..16, card0bypass or1..255 divide-by2N.
// Chooses fastest representable clock NOT above the requested ceiling;
// ties prefer larger host divisor. Integer arithmetic, no rounded overspeed.
type SdMmcFrequency = int
// host5/card8/sourceHz28/valid41. Caller keeps chosen source stable.
fun SdMmcFrequency.valid(): bool = (this>>>41) == 1 && this.hostDivider() >= 2 && this.hostDivider() <= 16 && this.sourceHz() > 0 && this.sourceHz() <= 160000000
fun SdMmcFrequency.hostDivider(): int = this&31
fun SdMmcFrequency.cardDivider(): int = (this>>5)&255
fun SdMmcFrequency.sourceHz(): int = (this>>13)&0xfffffff
fun SdMmcFrequency.divisor(): int = this.hostDivider()*(if (this.cardDivider() == 0) 1 else this.cardDivider()*2)
fun SdMmcFrequency.actualHz(): int = if (this.valid()) int(u32(this.sourceHz())/u32(this.divisor())) else 0
// Timeout provisioning needs the ceiling; actualHz() remains display-floor.
fun SdMmcFrequency.actualHzCeiling(): int = if (this.valid()) int(u32(this.sourceHz()-1)/u32(this.divisor()))+1 else 0
fun sdMmcFrequency(sourceHz: int,maximumHz: int): SdMmcFrequency {
    if (sourceHz < 1 || sourceHz > 160000000 || maximumHz < 1 || maximumHz > 50000000) return SdMmcFrequency(0)
    var best=0
    var bestHost=0
    var bestCard=0
    var host=2
    while (host <= 16) {
        var card=0
        var divisor=host
        if (sourceHz > maximumHz*host) {
            val denominator=maximumHz*host*2
            card=int(u32(sourceHz-1)/u32(denominator))+1
            divisor=host*card*2
        }
        if (card <= 255 && (best == 0 || divisor <= best)) { best=divisor; bestHost=host; bestCard=card }
        host=host+1
    }
    if (best == 0) return SdMmcFrequency(0)
    return SdMmcFrequency((1<<41)|(sourceHz<<13)|(bestCard<<5)|bestHost)
}
