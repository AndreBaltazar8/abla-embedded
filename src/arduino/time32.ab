import "./time.ab"
import "abla/unsafe/memory"

// Arduino-ESP32 2.x enables newlib's long time_t configuration. On Xtensa,
// long is 32 bits, so the native return lane must be i32.
trusted noescape extern:"c" fun time(destination: i64*): i32

@inline
trusted fun unixTimeSeconds(): int {
    val seconds: i32 = time(nativeNullPointer())
    seconds
}
