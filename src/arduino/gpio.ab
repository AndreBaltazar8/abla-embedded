noescape extern:"c" fun pinMode(pin: u8, mode: u8): void
noescape extern:"c" fun digitalRead(pin: u8): i32
noescape extern:"c" fun digitalWrite(pin: u8, level: u8): void
noescape extern:"c" fun neopixelWrite(
    pin: u8,
    red: u8,
    green: u8,
    blue: u8
): void

val input: u8 = 1
val output: u8 = 3
val low: u8 = 0
val high: u8 = 1

fun pinIsHigh(pin: u8): bool = digitalRead(pin) != 0
