// Arduino core C ABI. These functions are implemented by the selected board
// support package; application behavior remains Abla source.
import "abla/unsafe/memory"

noescape extern:"c" fun millis(): u32
noescape extern:"c" fun delay(milliseconds: u32): void
noescape extern:"c" fun esp_timer_get_time(): int
trusted noescape extern:"c" fun configTime(
    offset: i32,
    daylight: i32,
    first: cstring,
    second: cstring,
    third: cstring
): void
trusted noescape extern:"c" fun time(destination: i64*): int

@inline
trusted fun unixTimeSeconds(): int = time(nativeNullPointer())

@inline
trusted fun startNetworkTime(
    first: string,
    second: string
): void {
    configTime(0, 0, first, second, "")
    return
}
