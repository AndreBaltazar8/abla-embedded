// Board-neutral, zero-storage identity for a DMA descriptor owned by the
// caller. Target drivers define the descriptor layout; this scalar only keeps
// its native address distinct from ordinary integers at API boundaries.
type DmaDescriptor = int

@inline
fun dmaDescriptorAt(address: int): DmaDescriptor =
    DmaDescriptor(address)

@inline
fun DmaDescriptor.addressValue(): int = this

@inline
fun DmaDescriptor.isNull(): bool = this.addressValue() == 0

@inline
fun DmaDescriptor.isAligned(alignment: int): bool {
    if (alignment <= 0) return false
    val address = this.addressValue()
    (address / alignment) * alignment == address
}
