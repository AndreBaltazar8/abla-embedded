// LLVM memory fences alone may lower to fence rw,rw, excluding device I/O.
// DMA publication orders CPU reads/writes AND device input/output explicitly.
trusted noescape extern:"inline-assembly" fun riscvMemoryAssembly(template: string,constraints: string): void
trusted fun riscvDeviceMemoryFence(): void = riscvMemoryAssembly("fence iorw, iorw","~{memory}")
