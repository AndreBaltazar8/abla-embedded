// Machine-mode hardware boundary. Reading status does not change interrupt
// delivery; caller controls execution mode and any required exclusion.
trusted noescape extern:"inline-assembly" fun riscvMachineStatusInstruction(template: string,constraints: string): u32
trusted fun riscvMachineStatus(): u32 = riscvMachineStatusInstruction("csrr $0, mstatus","=r,~{memory}")

// Lexically scoped same-core M-mode critical section. Restore ONLY MIE,
// never stale privilege/extension/previous-interrupt fields from mstatus.
// Do not transfer the saved value across tasks/cores or restore out of order.
trusted noescape extern:"inline-assembly" fun riscvMachineInterruptInstruction(template: string,constraints: string): void
trusted fun riscvMachineInterruptSaveDisable(): u32 = riscvMachineStatusInstruction("csrrci $0, mstatus, 8","=r,~{memory}")
trusted fun riscvMachineInterruptRestore(saved: u32): void {
    if ((saved&u32(8)) != u32(0)) riscvMachineInterruptInstruction("csrsi mstatus, 8","~{memory}")
    return
}
