import "./types.ab"
import "../runtime/unsigned_division64.ab"

// Proleptic Gregorian UTC, years0..65535, with no timezone/DST or leap-second
// interpretation. Hardware register validity remains deliberately separate.
// This sentinel lies outside every supported calendar timestamp.
val rtcInvalidUnixSeconds = -9223372036854775807

fun rtcLeapYear(year: int): bool =
    year >= 0 && year <= 65535 && u32(year) % u32(4) == u32(0) &&
        (u32(year) % u32(100) != u32(0) || u32(year) % u32(400) == u32(0))

fun rtcMonthDays(year: int,month: int): int {
    if (year < 0 || year > 65535 || month < 1 || month > 12) return 0
    if (month == 2) return if (rtcLeapYear(year)) 29 else 28
    if (month == 4 || month == 6 || month == 9 || month == 11) return 30
    31
}

// Includes leap year0. Internal callers bound year to0..65536.
fun rtcDaysBeforeYear(year: int): int {
    if (year < 0 || year > 65536) return -1
    val y=u32(year)
    int(u32(365)*y+(y+u32(3))/u32(4)-(y+u32(99))/u32(100)+(y+u32(399))/u32(400))
}

fun RtcDateTime.calendarValid(): bool =
    this.valid() && this.day() <= rtcMonthDays(this.year(),this.month())

fun RtcDate.calendarValid(): bool =
    this.valid() && this.day() <= rtcMonthDays(this.year(),this.month())

// Date-only construction computes Sunday=0 weekday without a timestamp,
// signed division, libc, or intermediate heap object. Explicit weekday
// constructors remain available for raw register values and driver decoding.
fun rtcCalendarDate(year: int,month: int,day: int): RtcDate {
    val length=rtcMonthDays(year,month)
    if (length == 0 || day < 1 || day > length) return RtcDate(0)
    var absoluteDay=rtcDaysBeforeYear(year)+day-1
    var preceding=1
    while (preceding < month) {
        absoluteDay=absoluteDay+rtcMonthDays(year,preceding)
        preceding=preceding+1
    }
    // Gregorian year0 starts on Saturday. Bounded day count fits u32.
    rtcDate(year,month,day,int((u32(absoluteDay)+u32(6))%u32(7)))
}

fun rtcCalendarDateTime(year: int,month: int,day: int,hour: int,minute: int,second: int): RtcDateTime {
    val date=rtcCalendarDate(year,month,day)
    if (!date.valid()) return RtcDateTime(0)
    rtcDateTime(year,month,day,date.weekday(),hour,minute,second)
}

fun RtcDateTime.unixSeconds(): int {
    if (!this.calendarValid()) return rtcInvalidUnixSeconds
    var days=rtcDaysBeforeYear(this.year())-rtcDaysBeforeYear(1970)+this.day()-1
    var month=1
    while (month < this.month()) {
        days=days+rtcMonthDays(this.year(),month)
        month=month+1
    }
    days*86400+this.hour()*3600+this.minute()*60+this.second()
}

fun rtcDateTimeFromUnixSeconds(seconds: int): RtcDateTime {
    val epoch=rtcDaysBeforeYear(1970)
    if (seconds < -epoch*86400 ||
        seconds >= (rtcDaysBeforeYear(65536)-epoch)*86400) return RtcDateTime(0)
    // Only the seconds quotient requires64bits. Use the existing pure-Abla
    // divider directly; bounded day/year/time fields use native32bit maths.
    val magnitude=u64(if (seconds < 0) -seconds else seconds)
    val quotient=int(unsignedDivide64(magnitude,u64(86400)))
    var days=i32(if (seconds < 0) -quotient else quotient)
    var remainder=i32(seconds-int(days)*86400)
    if (remainder < i32(0)) { days=days-i32(1); remainder=remainder+i32(86400) }
    val weekday=int(((days+i32(4))%i32(7)+i32(7))%i32(7))
    val absoluteDay=int(days)+epoch
    var low=0
    var high=65536
    while (low+1 < high) {
        val middle=(low+high) >>> 1
        if (rtcDaysBeforeYear(middle) <= absoluteDay) low=middle
        else high=middle
    }
    var day=absoluteDay-rtcDaysBeforeYear(low)
    var month=1
    while (day >= rtcMonthDays(low,month)) {
        day=day-rtcMonthDays(low,month)
        month=month+1
    }
    rtcDateTime(low,month,day+1,weekday,int(remainder/i32(3600)),
        int((remainder/i32(60))%i32(60)),int(remainder%i32(60)))
}
