import "./types.ab"

fun powerHubWeekdayValue(weekday: int): int {
    if (weekday == 0) return 1
    if (weekday == 1) return 2
    if (weekday == 2) return 4
    if (weekday == 3) return 8
    if (weekday == 4) return 10
    if (weekday == 5) return 20
    if (weekday == 6) return 40
    0
}

fun powerHubWeekday(value: int): int {
    var weekday = -1
    var candidate = 0
    while (candidate < 7) {
        if (powerHubWeekdayValue(candidate) == value) weekday = candidate
        candidate = candidate + 1
    }
    weekday
}

fun powerHubDecodeDateTime(
    second: int,
    minute: int,
    hour: int,
    day: int,
    month: int,
    year: int,
    weekdayValue: int
): RtcDateTime = rtcDateTime(
    (year & 127) + 2000,
    month & 15,
    day & 31,
    powerHubWeekday(weekdayValue),
    hour & 31,
    minute & 63,
    second & 63
)
