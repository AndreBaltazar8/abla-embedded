import "./types.ab"

fun bcdDecode(value: int): int = ((value >>> 4) & 15) * 10 + (value & 15)

fun bcdEncode(value: int): int = (value / 10) * 16 + value - (value / 10) * 10

fun bcdValid(value: int): bool =
    value >= 0 && value <= 255 && (value & 15) < 10 &&
        ((value >>> 4) & 15) < 10

fun pcf8563DecodeDateTime(
    second: int,
    minute: int,
    hour: int,
    day: int,
    weekday: int,
    monthAndCentury: int,
    year: int
): RtcDateTime {
    val secondBcd = second & 127
    val minuteBcd = minute & 127
    val hourBcd = hour & 63
    val dayBcd = day & 63
    val monthBcd = monthAndCentury & 31
    if (!bcdValid(secondBcd) || !bcdValid(minuteBcd) ||
        !bcdValid(hourBcd) || !bcdValid(dayBcd) ||
        !bcdValid(monthBcd) || !bcdValid(year)) return RtcDateTime(0)
    rtcDateTime(
        bcdDecode(year) + if ((monthAndCentury & 128) != 0) 1900 else 2000,
        bcdDecode(monthBcd), bcdDecode(dayBcd), weekday & 7,
        bcdDecode(hourBcd), bcdDecode(minuteBcd), bcdDecode(secondBcd)
    )
}

// Timer plan encoding: low 8 bits count, bits 8-15 control-register value,
// upper bits hold the actual rounded duration in milliseconds.
fun pcf8563TimerPlan(milliseconds: int): int {
    var seconds = (milliseconds + 500) / 1000
    if (seconds <= 0) return 3 << 8
    var divisor = 1
    var control = 130
    if (seconds < 270) {
        if (seconds > 255) seconds = 255
    } else {
        divisor = 60
        seconds = (seconds + 30) / 60
        if (seconds > 255) seconds = 255
        control = 131
    }
    (seconds * divisor * 1000 << 16) | (control << 8) | seconds
}

fun pcf8563TimerCount(plan: int): int = plan & 255
fun pcf8563TimerControl(plan: int): int = (plan >>> 8) & 255
fun pcf8563TimerMilliseconds(plan: int): int = plan >>> 16
