import "../esp32/i2c_idf6.ab"
import "../esp32/sdk/buffer.ab"
import "./types.ab"
import "./powerhub_logic.ab"
import "abla/unsafe/memory"

type PowerHubRtc = int

trusted fun powerHubRtc(bus: I2cBus): PowerHubRtc = PowerHubRtc(
    if (bus.valid()) bus.device(80, 400000) & 4294967295 else 0
)

fun PowerHubRtc.valid(): bool = this != 0
fun PowerHubRtc.device(): I2cDevice = I2cDevice(this & 4294967295)
trusted fun PowerHubRtc.begin(): bool = this.valid()
trusted fun PowerHubRtc.close(): bool =
    this.valid() && this.device().close()

trusted fun PowerHubRtc.lowVoltage(): bool =
    this.valid() && (this.device().readRegister8(2) & 128) != 0

trusted fun PowerHubRtc.dateTime(): RtcDateTime {
    if (!this.valid()) return RtcDateTime(0)
    val bytes = nativeBufferAt(nativeStackAllocate(7), 7)
    if (!this.device().readRegister(192, bytes, 7)) return RtcDateTime(0)
    powerHubDecodeDateTime(
        bytes.load(0), bytes.load(1), bytes.load(2), bytes.load(3),
        bytes.load(4), bytes.load(5), bytes.load(6)
    )
}

trusted fun PowerHubRtc.setDateTime(value: RtcDateTime): bool {
    if (!this.valid() || !value.valid() || value.year() < 2000 ||
        value.year() > 2127) return false
    val bytes = nativeBufferAt(nativeStackAllocate(7), 7)
    bytes.store(0, value.second() & 63)
    bytes.store(1, value.minute() & 63)
    bytes.store(2, value.hour() & 31)
    bytes.store(3, value.day() & 31)
    bytes.store(4, value.month() & 15)
    bytes.store(5, (value.year() - 2000) & 127)
    bytes.store(6, powerHubWeekdayValue(value.weekday()))
    this.device().writeRegister(192, bytes, 7)
}

trusted fun PowerHubRtc.setAlarmInterrupt(
    minute: int = -1,
    hour: int = -1,
    day: int = -1
): bool {
    if (!this.valid() || minute < -1 || minute > 59 || hour < -1 ||
        hour > 23 || day < -1 || day > 31) return false
    val enabled = minute >= 0 || hour >= 0 || day >= 0
    val bytes = nativeBufferAt(nativeStackAllocate(3), 3)
    bytes.store(0, if (minute < 0) 0 else minute & 63)
    bytes.store(1, if (hour < 0) 0 else hour & 31)
    bytes.store(2, if (day < 0) 0 else day & 31)
    this.device().writeRegister(208, bytes, 3) &&
        this.device().updateRegister8(176, 1, if (enabled) 1 else 0) &&
        this.device().updateRegister8(211, 1, if (enabled) 1 else 0)
}

trusted fun PowerHubRtc.clearInterrupt(): bool {
    if (!this.valid()) return false
    val bytes = nativeBufferAt(nativeStackAllocate(4), 4)
    nativeAddressClear(bytes.addressValue(), 4)
    this.device().writeRegister(208, bytes, 4)
}

trusted fun PowerHubRtc.disableInterrupts(): bool =
    this.valid() && this.device().updateRegister8(211, 1, 0)

// M5Unified 0.2.21 does not implement these PowerHub operations either.
fun PowerHubRtc.setTimerInterrupt(milliseconds: int): int = 0
fun PowerHubRtc.interruptPending(): bool = false
