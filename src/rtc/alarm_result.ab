// 1 configured/disabled,2 invalid,3 initial read failed,4 setup failed with
// interrupt disabled,5 setup failed and cleanup could not confirm disabled,
// 6 unsupported requested capability (no I/O).
type RtcAlarmResult = int
fun RtcAlarmResult.status(): int = this & 255
fun RtcAlarmResult.valid(): bool = this.status() == 1
