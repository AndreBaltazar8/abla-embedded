// A complete RTC date/time fits in one 64-bit Abla integer. The nominal type
// retains semantic checking without a heap object or hidden pointer.
type RtcDateTime = int

fun rtcDateTime(
    year: int,
    month: int,
    day: int,
    weekday: int,
    hour: int,
    minute: int,
    second: int
): RtcDateTime {
    val valid = year >= 0 && year <= 65535 && month >= 1 && month <= 12 &&
        day >= 1 && day <= 31 && weekday >= 0 && weekday <= 6 &&
        hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59 &&
        second >= 0 && second <= 59
    if (!valid) return RtcDateTime(0)
    RtcDateTime(
        second | (minute << 6) | (hour << 12) | (day << 17) |
        (month << 22) | (weekday << 26) | (year << 29) | (1 << 45)
    )
}

fun RtcDateTime.valid(): bool = (this & (1 << 45)) != 0
fun RtcDateTime.second(): int = this & 63
fun RtcDateTime.minute(): int = (this >>> 6) & 63
fun RtcDateTime.hour(): int = (this >>> 12) & 31
fun RtcDateTime.day(): int = (this >>> 17) & 31
fun RtcDateTime.month(): int = (this >>> 22) & 15
fun RtcDateTime.weekday(): int = (this >>> 26) & 7
fun RtcDateTime.year(): int = (this >>> 29) & 65535
