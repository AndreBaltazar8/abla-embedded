// A complete RTC date/time fits in one 64-bit Abla integer. The nominal type
// retains semantic checking without a heap object or hidden pointer.
type RtcDateTime = int

fun rtcDateTime(
    year: int,
    month: int,
    day: int,
    weekday: int,
    hour: int,
    minute: int,
    second: int
): RtcDateTime {
    val valid = year >= 0 && year <= 65535 && month >= 1 && month <= 12 &&
        day >= 1 && day <= 31 && weekday >= 0 && weekday <= 6 &&
        hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59 &&
        second >= 0 && second <= 59
    if (!valid) return RtcDateTime(0)
    RtcDateTime(
        second | (minute << 6) | (hour << 12) | (day << 17) |
        (month << 22) | (weekday << 26) | (year << 29) | (1 << 45)
    )
}

// Validate canonical packed values too: nominal casts/received storage must
// not bypass the constructor checks before a driver writes hardware registers.
// Match register-field validity, not Gregorian calendar normalization.
fun RtcDateTime.valid(): bool = (this >>> 45) == 1 &&
    this.second() <= 59 && this.minute() <= 59 && this.hour() <= 23 &&
    this.day() >= 1 && this.day() <= 31 && this.month() >= 1 &&
    this.month() <= 12 && this.weekday() <= 6
fun RtcDateTime.second(): int = this & 63
fun RtcDateTime.minute(): int = (this >>> 6) & 63
fun RtcDateTime.hour(): int = (this >>> 12) & 31
fun RtcDateTime.day(): int = (this >>> 17) & 31
fun RtcDateTime.month(): int = (this >>> 22) & 15
fun RtcDateTime.weekday(): int = (this >>> 26) & 7
fun RtcDateTime.year(): int = (this >>> 29) & 65535

type RtcTime = int
fun rtcTime(hour: int,minute: int,second: int): RtcTime =
    if (hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59) RtcTime(0)
    else RtcTime(second | (minute<<6) | (hour<<12) | (1<<17))
fun RtcTime.second(): int = this & 63
fun RtcTime.minute(): int = (this>>>6) & 63
fun RtcTime.hour(): int = (this>>>12) & 31
fun RtcTime.valid(): bool = (this>>>17) == 1 && this.second() <= 59 && this.minute() <= 59 && this.hour() <= 23

type RtcDate = int
fun rtcDate(year: int,month: int,day: int,weekday: int): RtcDate =
    if (year < 0 || year > 65535 || month < 1 || month > 12 || day < 1 || day > 31 || weekday < 0 || weekday > 6) RtcDate(0)
    else RtcDate(day | (month<<5) | (weekday<<9) | (year<<12) | (1<<28))
fun RtcDate.day(): int = this & 31
fun RtcDate.month(): int = (this>>>5) & 15
fun RtcDate.weekday(): int = (this>>>9) & 7
fun RtcDate.year(): int = (this>>>12) & 65535
fun RtcDate.valid(): bool = (this>>>28) == 1 && this.day() >= 1 && this.month() >= 1 && this.month() <= 12 && this.weekday() <= 6
fun RtcDateTime.date(): RtcDate = if (this.valid()) rtcDate(this.year(),this.month(),this.day(),this.weekday()) else RtcDate(0)
fun RtcDateTime.time(): RtcTime = if (this.valid()) rtcTime(this.hour(),this.minute(),this.second()) else RtcTime(0)
