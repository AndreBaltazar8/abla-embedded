import "../esp32/i2c_idf6.ab"
import "../esp32/sdk/buffer.ab"
import "./types.ab"
import "./pcf8563_logic.ab"
import "abla/unsafe/memory"

type Pcf8563 = int

trusted fun pcf8563(bus: I2cBus): Pcf8563 =
    Pcf8563(
        if (bus.valid()) bus.device(81, 400000) & 4294967295 else 0
    )

fun Pcf8563.valid(): bool = this != 0
fun Pcf8563.device(): I2cDevice = I2cDevice(this & 4294967295)

trusted fun Pcf8563.begin(): bool {
    if (!this.valid()) return false
    this.device().writeRegister8(0, 0)
    this.device().writeRegister8(0, 0) &&
        this.device().writeRegister8(14, 3)
}

trusted fun Pcf8563.close(): bool =
    this.valid() && this.device().close()

trusted fun Pcf8563.lowVoltage(): bool =
    this.valid() && (this.device().readRegister8(2) & 128) != 0

trusted fun Pcf8563.dateTime(): RtcDateTime {
    if (!this.valid()) return RtcDateTime(0)
    val address = nativeStackAllocate(7)
    val bytes = nativeBufferAt(address, 7)
    if (!this.device().readRegister(2, bytes, 7)) return RtcDateTime(0)
    pcf8563DecodeDateTime(
        bytes.load(0), bytes.load(1), bytes.load(2), bytes.load(3),
        bytes.load(4), bytes.load(5), bytes.load(6)
    )
}

trusted fun Pcf8563.setDateTime(value: RtcDateTime): bool {
    if (!this.valid() || !value.valid() || value.year() < 1900 ||
        value.year() > 2099) return false
    val address = nativeStackAllocate(7)
    val bytes = nativeBufferAt(address, 7)
    bytes.store(0, bcdEncode(value.second()))
    bytes.store(1, bcdEncode(value.minute()))
    bytes.store(2, bcdEncode(value.hour()))
    bytes.store(3, bcdEncode(value.day()))
    bytes.store(4, value.weekday())
    bytes.store(
        5, bcdEncode(value.month()) + if (value.year() < 2000) 128 else 0
    )
    bytes.store(6, bcdEncode(value.year() - (value.year() / 100) * 100))
    this.device().writeRegister(2, bytes, 7)
}

trusted fun Pcf8563.setTimerInterrupt(milliseconds: int): int {
    if (!this.valid()) return 0
    val current = this.device().readRegister8(1) & 243
    val plan = pcf8563TimerPlan(milliseconds)
    if (milliseconds <= 0) {
        this.device().writeRegister8(1, current & 254)
        this.device().writeRegister8(14, 3)
        return 0
    }
    val configured = this.device().writeRegister8(
        14, pcf8563TimerControl(plan)
    ) && this.device().writeRegister8(15, pcf8563TimerCount(plan)) &&
        this.device().writeRegister8(1, (current | 1) & 127)
    if (configured) pcf8563TimerMilliseconds(plan) else 0
}

trusted fun Pcf8563.setAlarmInterrupt(
    minute: int = -1,
    hour: int = -1,
    day: int = -1,
    weekday: int = -1
): bool {
    if (!this.valid() || minute > 59 || hour > 23 || day > 31 ||
        weekday > 6 || minute < -1 || hour < -1 || day < -1 ||
        weekday < -1) return false
    val address = nativeStackAllocate(4)
    val bytes = nativeBufferAt(address, 4)
    bytes.store(0, if (minute < 0) 128 else bcdEncode(minute) & 127)
    bytes.store(1, if (hour < 0) 128 else bcdEncode(hour) & 63)
    bytes.store(2, if (day < 0) 128 else bcdEncode(day) & 63)
    bytes.store(3, if (weekday < 0) 128 else weekday & 7)
    if (!this.device().writeRegister(9, bytes, 4)) return false
    val enabled = minute >= 0 || hour >= 0 || day >= 0 || weekday >= 0
    val current = this.device().readRegister8(1)
    this.device().writeRegister8(
        1, if (enabled) current | 2 else current & 253
    )
}

trusted fun Pcf8563.interruptPending(): bool =
    this.valid() && (this.device().readRegister8(1) & 12) != 0

trusted fun Pcf8563.clearInterrupt(): bool {
    if (!this.valid()) return false
    val current = this.device().readRegister8(1)
    this.device().writeRegister8(1, current & 243)
}

trusted fun Pcf8563.disableInterrupts(): bool {
    if (!this.valid()) return false
    val address = nativeStackAllocate(4)
    val bytes = nativeBufferAt(address, 4)
    bytes.store(0, 128)
    bytes.store(1, 128)
    bytes.store(2, 128)
    bytes.store(3, 128)
    this.device().writeRegister(9, bytes, 4) &&
        this.device().writeRegister8(14, 0) &&
        this.device().writeRegister8(1, 0)
}
