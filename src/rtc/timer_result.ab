// Status1 configured/stopped,2 invalid,3 control read failed,4 setup failed
// with successful stop,5 setup failed AND stop failed,6 unsupported capability.
// Duration in upper bits.
type RtcTimerResult = int
fun RtcTimerResult.status(): int = this & 255
fun RtcTimerResult.valid(): bool = this.status() == 1
fun RtcTimerResult.milliseconds(): int = this >>> 8
