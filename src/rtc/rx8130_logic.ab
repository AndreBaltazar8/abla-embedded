import "./types.ab"
import "./pcf8563_logic.ab"

fun rx8130Weekday(mask: int): int {
    if (mask <= 0 || (mask & (mask - 1)) != 0 || mask > 64) return -1
    var day = 0
    var value = mask
    while (value > 1) {
        value = value >>> 1
        day = day + 1
    }
    day
}

fun rx8130DecodeDateTime(
    second: int,
    minute: int,
    hour: int,
    weekdayMask: int,
    day: int,
    month: int,
    year: int
): RtcDateTime {
    val secondBcd = second & 127
    val minuteBcd = minute & 127
    val hourBcd = hour & 63
    val dayBcd = day & 63
    val monthBcd = month & 31
    val weekday = rx8130Weekday(weekdayMask)
    if (!bcdValid(secondBcd) || !bcdValid(minuteBcd) ||
        !bcdValid(hourBcd) || !bcdValid(dayBcd) ||
        !bcdValid(monthBcd) || !bcdValid(year) || weekday < 0) {
        return RtcDateTime(0)
    }
    rtcDateTime(
        2000 + bcdDecode(year), bcdDecode(monthBcd), bcdDecode(dayBcd),
        weekday, bcdDecode(hourBcd), bcdDecode(minuteBcd),
        bcdDecode(secondBcd)
    )
}

// Plan: count bits 0-15, clock selector bits 16-23, actual milliseconds
// bits 24-55, and bit 56 marks an enabled timer.
fun rx8130TimerCandidate(
    milliseconds: int,
    multiplier: int,
    divisor: int,
    maximumMilliseconds: int,
    maximumCount: int,
    selector: int,
    overflowed: bool,
    last: bool
): int {
    if (milliseconds > maximumMilliseconds) return 0
    val numerator = milliseconds * divisor
    var count = numerator / multiplier
    var error = numerator - count * multiplier
    val roundUp = if (overflowed) error != 0 else error * 2 >= multiplier
    if (roundUp) {
        count = count + 1
        error = multiplier - error
    }
    if (count > maximumCount) {
        count = maximumCount
        error = numerator - count * multiplier
    }
    if (!last && (count < 16 || (error << 8) > numerator)) return 0
    var actual = (count * multiplier + divisor / 2) / divisor
    if (actual <= 0) actual = 1
    (1 << 56) | (actual << 24) | (selector << 16) | count
}

fun rx8130TimerPlan(milliseconds: int): int {
    if (milliseconds <= 0) return 0
    var overflowed = false
    var plan = rx8130TimerCandidate(
        milliseconds, 1000, 64, 1023984, 65535, 1, false, false
    )
    if (plan != 0) return plan
    if (milliseconds > 1023984) overflowed = true
    plan = rx8130TimerCandidate(
        milliseconds, 1000, 1, 65535000, 65535, 2,
        overflowed, false
    )
    if (plan != 0) return plan
    if (milliseconds > 65535000) overflowed = true
    plan = rx8130TimerCandidate(
        milliseconds, 60000, 1, 3932100000, 65535, 3,
        overflowed, false
    )
    if (plan != 0) return plan
    if (milliseconds > 3932100000) overflowed = true
    plan = rx8130TimerCandidate(
        milliseconds, 3600000, 1, 4294967295, 1193, 4,
        overflowed, false
    )
    if (plan != 0) return plan
    rx8130TimerCandidate(
        milliseconds, 1000, 4096, 15999, 65535, 0, true, true
    )
}

fun rx8130TimerEnabled(plan: int): bool = (plan & (1 << 56)) != 0
fun rx8130TimerCount(plan: int): int = plan & 65535
fun rx8130TimerSelector(plan: int): int = (plan >>> 16) & 255
fun rx8130TimerMilliseconds(plan: int): int = (plan >>> 24) & 4294967295
