import "abla/unsafe/mmio"

// Board-neutral, zero-storage views over volatile memory-mapped registers.
// Platform modules own the addresses and expose safe peripheral operations;
// application code should normally use those peripheral APIs instead.
type Register8 = int
type Register16 = int
type Register32 = int
type Register64 = int

@inline
fun register8(address: int): Register8 = Register8(address)
@inline
fun register16(address: int): Register16 = Register16(address)
@inline
fun register32(address: int): Register32 = Register32(address)
@inline
fun register64(address: int): Register64 = Register64(address)

fun Register8.address(): int = this
fun Register16.address(): int = this
fun Register32.address(): int = this
fun Register64.address(): int = this

@inline
trusted fun Register8.read(): int = mmioLoadU8(this)
@inline
trusted fun Register16.read(): int = mmioLoadU16(this)
@inline
trusted fun Register32.read(): int = mmioLoadU32(this)
@inline
trusted fun Register64.read(): int = mmioLoadU64(this)

@inline
trusted fun Register8.write(value: int): void = mmioStoreU8(this, value)
@inline
trusted fun Register16.write(value: int): void = mmioStoreU16(this, value)
@inline
trusted fun Register32.write(value: int): void = mmioStoreU32(this, value)
@inline
trusted fun Register64.write(value: int): void = mmioStoreU64(this, value)

// Read-modify-write is for ordinary configuration registers. Peripheral
// status, write-one, shared, and concurrently mutated registers need their
// target-specific atomic operation instead.
@inline
trusted fun Register32.update(clearMask: int, setMask: int): int {
    val next = (this.read() & ~clearMask) | setMask
    this.write(next)
    next
}

@inline
trusted fun Register32.setBits(mask: int): int = this.update(0, mask)
@inline
trusted fun Register32.clearBits(mask: int): int = this.update(mask, 0)

fun registerFieldMask(width: int, shift: int): int {
    if (width <= 0 || width > 32 || shift < 0 || shift + width > 32) return 0
    val low = if (width == 32) 4294967295 else (1 << width) - 1
    low << shift
}

fun registerField(value: int, width: int, shift: int): int {
    val mask = registerFieldMask(width, shift)
    if (mask == 0) 0 else (value & mask) >>> shift
}

trusted fun Register32.writeField(
    value: int,
    width: int,
    shift: int
): int {
    val mask = registerFieldMask(width, shift)
    if (mask == 0) return this.read()
    this.update(mask, (value << shift) & mask)
}
