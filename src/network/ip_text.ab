import "abla/unsafe/memory"

// Allocation-free IPv4 text parsing shared by embedded targets. This mirrors
// lwIP's accepted C-number forms: decimal, leading-zero octal, 0x hexadecimal,
// and the historical one-, two-, three-, or four-component address layouts.

@inline
trusted fun embeddedIpTextByte(address: u32): int =
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address))) & 255

@inline
fun embeddedIpAsciiDigit(byte: int): bool = byte >= 48 && byte <= 57

@inline
fun embeddedIpAsciiHexDigit(byte: int): bool =
    embeddedIpAsciiDigit(byte) || (byte >= 65 && byte <= 70) ||
        (byte >= 97 && byte <= 102)

@inline
fun embeddedIpAsciiSpace(byte: int): bool =
    byte == 32 || (byte >= 9 && byte <= 13)

@inline
fun embeddedIpHexValue(byte: int): int {
    if (byte <= 57) return byte - 48
    if (byte <= 70) return byte - 55
    return byte - 87
}

@inline
trusted fun embeddedIpStoreNetworkU32(address: u32, value: u32): void {
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value >> u32(24)))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address + u32(1))), int(value >> u32(16)))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address + u32(2))), int(value >> u32(8)))
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address + u32(3))), int(value))
    return
}

@noinline
trusted fun embeddedIp4AddressFromText(input: u32, output: u32): i32 {
    var cursor = input
    var byte = embeddedIpTextByte(cursor)
    var part0 = u32(0)
    var part1 = u32(0)
    var part2 = u32(0)
    var storedParts = 0
    var value = u32(0)

    while (true) {
        if (!embeddedIpAsciiDigit(byte)) return 0

        var base = 10
        value = u32(0)
        if (byte == 48) {
            cursor = cursor + u32(1)
            byte = embeddedIpTextByte(cursor)
            if (byte == 120 || byte == 88) {
                base = 16
                cursor = cursor + u32(1)
                byte = embeddedIpTextByte(cursor)
            } else base = 8
        }

        while (true) {
            if (embeddedIpAsciiDigit(byte)) {
                val digit = byte - 48
                if (base == 8 && digit >= 8) break
                value = value * u32(base) + u32(digit)
            } else if (base == 16 && embeddedIpAsciiHexDigit(byte)) {
                value = (value << u32(4)) | u32(embeddedIpHexValue(byte))
            } else break
            cursor = cursor + u32(1)
            byte = embeddedIpTextByte(cursor)
        }

        if (byte != 46) break
        if (storedParts >= 3) return 0
        if (storedParts == 0) part0 = value
        else if (storedParts == 1) part1 = value
        else part2 = value
        storedParts = storedParts + 1
        cursor = cursor + u32(1)
        byte = embeddedIpTextByte(cursor)
    }

    if (byte != 0 && !embeddedIpAsciiSpace(byte)) return 0

    if (storedParts == 1) {
        if (part0 > u32(255) || value > u32(16777215)) return 0
        value = value | (part0 << u32(24))
    } else if (storedParts == 2) {
        if (part0 > u32(255) || part1 > u32(255) || value > u32(65535)) return 0
        value = value | (part0 << u32(24)) | (part1 << u32(16))
    } else if (storedParts == 3) {
        if (part0 > u32(255) || part1 > u32(255) ||
            part2 > u32(255) || value > u32(255)) return 0
        value = value | (part0 << u32(24)) | (part1 << u32(16)) |
            (part2 << u32(8))
    }

    if (output != u32(0)) embeddedIpStoreNetworkU32(output, value)
    return 1
}

trusted fun embeddedIp4AddressValueFromText(input: u32): u32 {
    val output = nativeStackAllocate(4)
    if (embeddedIp4AddressFromText(input, u32(output)) == 0) return u32(4294967295)
    return ablaUnsafeLoadU32(nativePointerFromAddress(output))
}

// Allocation-free dotted-decimal formatting shared by every target. Keeping
// the digit generation in typed Abla lets LLVM fold the divisions and inline
// this into higher-level address-family dispatchers when profitable.
trusted fun embeddedIp4AddressToText(
    address: u32,
    output: u32,
    outputLength: i32
): u32 {
    var index = i32(0)
    var octet = 0
    while (octet < 4) {
        if (octet != 0) {
            index = embeddedIpAppendTextByte(
                output, index, outputLength, u32(46)
            )
            if (index < 0) return u32(0)
        }
        index = embeddedIpAppendDecimalByte(
            output, index, outputLength,
            u32(embeddedIpTextByte(address + u32(octet)))
        )
        if (index < 0) return u32(0)
        octet = octet + 1
    }
    if (index >= outputLength) return u32(0)
    embeddedIpTextStoreByte(output + u32(index), u32(0))
    return output
}

val embeddedIp4StaticTextBuffer = nativeStaticAllocate(16)

trusted fun embeddedIp4AddressToStaticText(address: u32): u32 =
    embeddedIp4AddressToText(
        address, u32(embeddedIp4StaticTextBuffer), i32(16)
    )

@inline
trusted fun embeddedIpTextStoreByte(address: u32, value: u32): void {
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))
    return
}

@inline
trusted fun embeddedIpStoreNetworkU16(address: u32, value: u32): void {
    embeddedIpTextStoreByte(address, value >> u32(8))
    embeddedIpTextStoreByte(address + u32(1), value)
    return
}

@inline
trusted fun embeddedIpTemporaryLoadU32(address: int, index: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(
        address + int(index << u32(2))
    )))

@inline
trusted fun embeddedIpTemporaryStoreU32(
    address: int,
    index: u32,
    value: u32
): void {
    ablaUnsafeStoreU32(nativePointerFromAddress(
        address + int(index << u32(2))
    ), int(value))
    return
}

// Allocation-free IPv6 parser matching the configured lwIP parser, including
// zero compression, its historical overflow behavior, mapped IPv4 addresses,
// and optional `%zone` syntax. Platform wrappers may resolve the zone name
// after this function has produced the address bytes.
trusted fun embeddedIp6AddressFromText(input: u32, output: u32): i32 {
    var zeroBlocks = u32(8)
    var scan = input
    var byte = embeddedIpTextByte(scan)
    var checkIpv4Mapped = false
    while (byte != 0) {
        if (byte == 58) zeroBlocks = zeroBlocks - u32(1)
        else if (byte == 46) {
            if (zeroBlocks != u32(5) && zeroBlocks != u32(2)) return 0
            checkIpv4Mapped = true
            zeroBlocks = zeroBlocks - u32(1)
            byte = 0
        } else if (!embeddedIpAsciiHexDigit(byte)) byte = 0
        if (byte != 0) {
            scan = scan + u32(1)
            byte = embeddedIpTextByte(scan)
        }
    }

    val words = nativeStackAllocate(16)
    embeddedIpTemporaryStoreU32(words, u32(0), u32(0))
    embeddedIpTemporaryStoreU32(words, u32(1), u32(0))
    embeddedIpTemporaryStoreU32(words, u32(2), u32(0))
    embeddedIpTemporaryStoreU32(words, u32(3), u32(0))

    var cursor = input
    var addressIndex = u32(0)
    var blockIndex = u32(0)
    var blockValue = u32(0)
    var mapped = false
    byte = embeddedIpTextByte(cursor)
    while (byte != 0 && !mapped) {
        if (byte == 58) {
            if ((blockIndex & u32(1)) != u32(0)) {
                embeddedIpTemporaryStoreU32(
                    words, addressIndex,
                    embeddedIpTemporaryLoadU32(words, addressIndex) | blockValue
                )
                addressIndex = addressIndex + u32(1)
            } else embeddedIpTemporaryStoreU32(
                words, addressIndex, blockValue << u32(16)
            )
            blockIndex = blockIndex + u32(1)

            if (checkIpv4Mapped && blockIndex == u32(6)) {
                val ip4Output = if (output == u32(0)) u32(0)
                    else output + u32(12)
                if (embeddedIp4AddressFromText(
                    cursor + u32(1), ip4Output
                ) != 0) {
                    if (output != u32(0)) embeddedIpTemporaryStoreU32(
                        words, u32(3),
                        (u32(embeddedIpTextByte(ip4Output)) << u32(24)) |
                            (u32(embeddedIpTextByte(ip4Output + u32(1))) << u32(16)) |
                            (u32(embeddedIpTextByte(ip4Output + u32(2))) << u32(8)) |
                            u32(embeddedIpTextByte(ip4Output + u32(3)))
                    )
                    blockIndex = blockIndex + u32(1)
                    mapped = true
                }
            }

            if (!mapped) {
                blockValue = u32(0)
                if (blockIndex > u32(7)) return 0
                if (embeddedIpTextByte(cursor + u32(1)) == 58) {
                    if (embeddedIpTextByte(cursor + u32(2)) == 58) return 0
                    cursor = cursor + u32(1)
                    while (zeroBlocks > u32(0)) {
                        zeroBlocks = zeroBlocks - u32(1)
                        if ((blockIndex & u32(1)) != u32(0)) {
                            addressIndex = addressIndex + u32(1)
                        }
                        else embeddedIpTemporaryStoreU32(
                            words, addressIndex, u32(0)
                        )
                        blockIndex = blockIndex + u32(1)
                        if (blockIndex > u32(7)) return 0
                    }
                }
            }
        } else if (embeddedIpAsciiHexDigit(byte)) {
            blockValue = (blockValue << u32(4)) | u32(embeddedIpHexValue(byte))
        } else byte = 0

        if (byte != 0 && !mapped) {
            cursor = cursor + u32(1)
            byte = embeddedIpTextByte(cursor)
        }
    }

    if (!mapped) {
        if ((blockIndex & u32(1)) != u32(0)) embeddedIpTemporaryStoreU32(
            words, addressIndex,
            embeddedIpTemporaryLoadU32(words, addressIndex) | blockValue
        )
        else embeddedIpTemporaryStoreU32(
            words, addressIndex, blockValue << u32(16)
        )
    }

    if (output != u32(0)) {
        var wordIndex = u32(0)
        while (wordIndex < u32(4)) {
            embeddedIpStoreNetworkU32(
                output + (wordIndex << u32(2)),
                embeddedIpTemporaryLoadU32(words, wordIndex)
            )
            wordIndex = wordIndex + u32(1)
        }
        embeddedIpTextStoreByte(output + u32(16), u32(0))
    }
    if (blockIndex != u32(7)) return 0
    return 1
}

@inline
trusted fun embeddedIp6AddressBlock(address: u32, index: int): u32 =
    (u32(embeddedIpTextByte(address + u32(index * 2))) << u32(8)) |
        u32(embeddedIpTextByte(address + u32(index * 2 + 1)))

@inline
trusted fun embeddedIpAppendTextByte(
    output: u32,
    index: i32,
    limit: i32,
    value: u32
): i32 {
    if (index >= limit) return -1
    embeddedIpTextStoreByte(output + u32(index), value)
    return index + i32(1)
}

trusted fun embeddedIpAppendDecimalByte(
    output: u32,
    index: i32,
    limit: i32,
    value: u32
): i32 {
    var next = index
    if (value >= u32(100)) {
        next = embeddedIpAppendTextByte(
            output, next, limit, u32(48) + value / u32(100)
        )
        if (next < 0) return -1
        next = embeddedIpAppendTextByte(
            output, next, limit, u32(48) +
                (value / u32(10) - (value / u32(100)) * u32(10))
        )
        if (next < 0) return -1
    } else if (value >= u32(10)) {
        next = embeddedIpAppendTextByte(
            output, next, limit, u32(48) + value / u32(10)
        )
        if (next < 0) return -1
    }
    return embeddedIpAppendTextByte(
        output, next, limit, u32(48) +
            (value - (value / u32(10)) * u32(10))
    )
}

// Canonical lwIP-style formatting. This intentionally chooses the first run
// of two or more zero blocks, matching the library behavior exactly.
trusted fun embeddedIp6AddressToText(
    address: u32,
    output: u32,
    outputLength: i32
): u32 {
    var mapped = true
    var mappedIndex = 0
    while (mappedIndex < 10) {
        if (embeddedIpTextByte(address + u32(mappedIndex)) != 0) mapped = false
        mappedIndex = mappedIndex + 1
    }
    if (embeddedIpTextByte(address + u32(10)) != 255 ||
        embeddedIpTextByte(address + u32(11)) != 255) mapped = false

    if (mapped) {
        if (outputLength < 8) return u32(0)
        embeddedIpTextStoreByte(output, u32(58))
        embeddedIpTextStoreByte(output + u32(1), u32(58))
        embeddedIpTextStoreByte(output + u32(2), u32(70))
        embeddedIpTextStoreByte(output + u32(3), u32(70))
        embeddedIpTextStoreByte(output + u32(4), u32(70))
        embeddedIpTextStoreByte(output + u32(5), u32(70))
        embeddedIpTextStoreByte(output + u32(6), u32(58))
        var index = i32(7)
        var octet = 0
        while (octet < 4) {
            if (octet != 0) {
                index = embeddedIpAppendTextByte(
                    output, index, outputLength, u32(46)
                )
                if (index < 0) return u32(0)
            }
            index = embeddedIpAppendDecimalByte(
                output, index, outputLength,
                u32(embeddedIpTextByte(address + u32(12 + octet)))
            )
            if (index < 0) return u32(0)
            octet = octet + 1
        }
        if (index >= outputLength) return u32(0)
        embeddedIpTextStoreByte(output + u32(index), u32(0))
        return output
    }

    var index = i32(0)
    var emptyBlock = 0
    var blockIndex = 0
    while (blockIndex < 8) {
        val block = embeddedIp6AddressBlock(address, blockIndex)
        if (block == u32(0)) {
            if (blockIndex == 7 && emptyBlock == 1) {
                index = embeddedIpAppendTextByte(
                    output, index, outputLength, u32(58)
                )
                if (index < 0) return u32(0)
                blockIndex = 8
            } else if (emptyBlock == 0 &&
                embeddedIp6AddressBlock(address, blockIndex + 1) == u32(0)) {
                emptyBlock = 1
                index = embeddedIpAppendTextByte(
                    output, index, outputLength, u32(58)
                )
                if (index < 0) return u32(0)
                blockIndex = blockIndex + 1
            } else if (emptyBlock == 1) blockIndex = blockIndex + 1
            else {
                if (blockIndex > 0) {
                    index = embeddedIpAppendTextByte(
                        output, index, outputLength, u32(58)
                    )
                    if (index < 0) return u32(0)
                }
                index = embeddedIpAppendTextByte(
                    output, index, outputLength, u32(48)
                )
                if (index < 0) return u32(0)
                blockIndex = blockIndex + 1
            }
        } else {
            if (emptyBlock == 1) emptyBlock = 2
            if (blockIndex > 0) {
                index = embeddedIpAppendTextByte(
                    output, index, outputLength, u32(58)
                )
                if (index < 0) return u32(0)
            }
            var shift = 12
            var started = false
            while (shift >= 0) {
                val digit = (block >> u32(shift)) & u32(15)
                if (digit != u32(0) || started || shift == 0) {
                    val character = if (digit < u32(10)) u32(48) + digit
                        else u32(55) + digit
                    index = embeddedIpAppendTextByte(
                        output, index, outputLength, character
                    )
                    if (index < 0) return u32(0)
                    started = true
                }
                shift = shift - 4
            }
            blockIndex = blockIndex + 1
        }
    }

    if (index >= outputLength) return u32(0)
    embeddedIpTextStoreByte(output + u32(index), u32(0))
    return output
}

val embeddedIp6StaticTextBuffer = nativeStaticAllocate(40)

trusted fun embeddedIp6AddressToStaticText(address: u32): u32 =
    embeddedIp6AddressToText(
        address, u32(embeddedIp6StaticTextBuffer), i32(40)
    )
