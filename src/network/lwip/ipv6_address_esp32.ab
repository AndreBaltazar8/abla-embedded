val esp32Data_ip6_addr_any_3a7ef08323Storage = nativeStaticMutableBytes("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00")
val esp32Data_ip6_addr_any_3a7ef08323Initialized = esp32Data_ip6_addr_any_3a7ef08323Storage
val esp32Data_ip6_addr_any_3a7ef08323 = u32(esp32Data_ip6_addr_any_3a7ef08323Initialized)


// The IPv6 any-address object is still referenced by recovered lwIP callers by
// its local object symbol. This provider contains data directives only; all
// parser and formatter instructions are now generated from typed Abla.
trusted fun esp32LwipIpv6AddressData(): void {
    // Static data is emitted by Abla above.
    return
}

@inline
trusted fun esp32LwipIp6AddressHasScope(address: u32): bool {
    val first = u32(embeddedIpTextByte(address))
    val second = u32(embeddedIpTextByte(address + u32(1)))
    val linkLocal = first == u32(254) &&
        (second & u32(192)) == u32(128)
    val localMulticast = first == u32(255) &&
        ((second & u32(143)) == u32(1) ||
            (second & u32(143)) == u32(2))
    return linkLocal || localMulticast
}

trusted fun esp32LwipIp6AddressFromText(input: u32, output: u32): i32 {
    val result = embeddedIp6AddressFromText(input, output)
    if (result == 0 || output == u32(0)) return result

    var cursor = input
    var byte = embeddedIpTextByte(cursor)
    while (byte != 0 && byte != 37) {
        cursor = cursor + u32(1)
        byte = embeddedIpTextByte(cursor)
    }
    if (byte == 37 && embeddedIpTextByte(cursor + u32(1)) != 0) {
        val netif = esp32LwipNetifFind(cursor + u32(1))
        if (netif != u32(0) && esp32LwipIp6AddressHasScope(output)) {
            embeddedIpTextStoreByte(
                output + u32(16),
                u32(embeddedIpTextByte(netif + u32(234)) + 1) & u32(255)
            )
        }
    }
    return result
}

