import "abla/unsafe/memory"
import "./netif_lookup_esp32.ab"
import "./pbuf_esp32.ab"
import "./definitions_esp32.ab"

// Abla/LLVM implementation of ESP lwIP IPv6 input, IPv4 source-route,
// netif-existence, and DHCP extra-option hooks.

trusted fun esp32LwipHookIp6Input(
    packet: u32,
    networkInterface: u32
): u32 {
    if (networkInterface == u32(0)) return u32(0)
    if (esp32LwipNetifLoadU32(networkInterface + u32(76)) != u32(0) ||
        esp32LwipNetifLoadU32(networkInterface + u32(80)) != u32(0) ||
        esp32LwipNetifLoadU32(networkInterface + u32(84)) != u32(0) ||
        esp32LwipNetifLoadU32(networkInterface + u32(88)) != u32(0)) {
        return u32(0)
    }
    val ignored = esp32LwipPbufFree(packet)
    return u32(1)
}

trusted fun esp32LwipIp4NetifExist(
    sourceAddress: u32,
    destinationAddress: u32
): u32 {
    if (sourceAddress == u32(0) || destinationAddress == u32(0)) return u32(0)
    val source = esp32LwipNetifLoadU32(sourceAddress)
    val destination = esp32LwipNetifLoadU32(destinationAddress)
    var networkInterface = esp32LwipNetifLoadU32(
        esp32LwipNetifListCell()
    )
    while (networkInterface != u32(0)) {
        val flags = u32(embeddedIpTextByte(networkInterface + u32(231)))
        val address = esp32LwipNetifLoadU32(networkInterface + u32(4))
        val mask = esp32LwipNetifLoadU32(networkInterface + u32(28))
        if ((flags & u32(5)) == u32(5) && address != u32(0) &&
            ((address ^ source) & mask) == u32(0) &&
            ((address ^ destination) & mask) == u32(0)) return u32(1)
        networkInterface = esp32LwipNetifLoadU32(networkInterface)
    }
    return u32(0)
}

trusted fun esp32LwipIp4RouteSourceHook(
    sourceAddress: u32,
    destinationAddress: u32
): u32 {
    if (sourceAddress == u32(0)) return u32(0)
    val source = esp32LwipNetifLoadU32(sourceAddress)
    if (source == u32(0)) return u32(0)
    var networkInterface = esp32LwipNetifLoadU32(
        esp32LwipNetifListCell()
    )
    while (networkInterface != u32(0)) {
        val flags = u32(embeddedIpTextByte(networkInterface + u32(231)))
        val address = esp32LwipNetifLoadU32(networkInterface + u32(4))
        if ((flags & u32(5)) == u32(5) && address != u32(0) &&
            address == source) return networkInterface
        networkInterface = esp32LwipNetifLoadU32(networkInterface)
    }
    return u32(0)
}

@inline
fun esp32LwipDhcpAppendClientIdentifier(messageType: u32): bool =
    messageType == u32(0) || messageType == u32(1) ||
    (messageType >= u32(3) && messageType <= u32(6)) ||
    messageType == u32(12)

trusted fun esp32LwipDhcpAppendExtraOptions(
    networkInterface: u32,
    rawMessageType: u32,
    options: u32,
    outputLength: u32
): void {
    val messageType = rawMessageType & u32(255)
    if (!esp32LwipDhcpAppendClientIdentifier(messageType)) return
    val currentLength = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(int(outputLength))
    )) & u32(65535)
    val hardwareLength = u32(embeddedIpTextByte(
        networkInterface + u32(230)
    ))
    if (currentLength + hardwareLength + u32(4) > u32(69)) return

    val output = options + u32(240) + currentLength
    ablaUnsafeStoreU16(
        nativePointerFromAddress(int(outputLength)),
        int((currentLength + hardwareLength + u32(3)) & u32(65535))
    )
    embeddedIpTextStoreByte(output, u32(61))
    embeddedIpTextStoreByte(output + u32(1), hardwareLength + u32(1))
    embeddedIpTextStoreByte(output + u32(2), u32(1))
    var index = u32(0)
    while (index < hardwareLength) {
        embeddedIpTextStoreByte(
            output + u32(3) + index,
            u32(embeddedIpTextByte(
                networkInterface + u32(224) + index
            ))
        )
        index = index + u32(1)
    }
    return
}

trusted fun esp32LwipDhcpParseExtraOptions(
    dhcpState: u32,
    rawMessageType: u32,
    rawOption: u32,
    rawLength: u32,
    packet: u32,
    rawOffset: u32
): void {
    val messageType = rawMessageType & u32(255)
    val option = rawOption & u32(255)
    val length = rawLength & u32(255)
    if (option != u32(26) || length != u32(2)) return
    if (messageType != u32(1) &&
        (messageType < u32(3) || messageType > u32(5))) return

    val temporary = nativeStackAllocate(4)
    ablaUnsafeStoreU32(nativePointerFromAddress(temporary), 0)
    if (esp32LwipPbufCopyPartial(
        packet, u32(temporary), u32(2), rawOffset & u32(65535)
    ) != u32(2)) return
    val maximumMessageSize = embeddedLwipHtons(u32(
        ablaUnsafeLoadU16(nativePointerFromAddress(temporary))
    )) & u32(65535)

    var networkInterface = esp32LwipNetifLoadU32(
        esp32LwipNetifListCell()
    )
    while (networkInterface != u32(0)) {
        if (esp32LwipNetifLoadU32(
            networkInterface + u32(196)
        ) == dhcpState) {
            val current = u32(ablaUnsafeLoadU16(
                nativePointerFromAddress(int(
                    networkInterface + u32(220)
                ))
            )) & u32(65535)
            if (maximumMessageSize < current) ablaUnsafeStoreU16(
                nativePointerFromAddress(int(
                    networkInterface + u32(220)
                )),
                int(maximumMessageSize)
            )
            return
        }
        networkInterface = esp32LwipNetifLoadU32(networkInterface)
    }
    return
}
