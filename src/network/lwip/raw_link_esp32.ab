import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipRawInternals(): bool {
    if (!internalFunction("esp32RecoveredRawInput", "raw_input")) return false
    if (!internalFunction("esp32RecoveredRawBind", "raw_bind")) return false
    if (!internalFunction("esp32RecoveredRawBindNetif", "raw_bind_netif")) return false
    if (!internalFunction("esp32RecoveredRawConnect", "raw_connect")) return false
    if (!internalFunction("esp32RecoveredRawDisconnect", "raw_disconnect")) return false
    if (!internalFunction("esp32RecoveredRawRecv", "raw_recv")) return false
    if (!internalFunction("esp32RecoveredRawSendtoIfSrc", "raw_sendto_if_src")) return false
    if (!internalFunction("esp32RecoveredRawSendto", "raw_sendto")) return false
    if (!internalFunction("esp32RecoveredRawSend", "raw_send")) return false
    if (!internalFunction("esp32RecoveredRawRemove", "raw_remove")) return false
    if (!internalFunction("esp32RecoveredRawNew", "raw_new")) return false
    if (!internalFunction("esp32RecoveredRawNewIpType", "raw_new_ip_type")) return false
    if (!internalFunction("esp32RecoveredRawNetifIpAddrChanged", "raw_netif_ip_addr_changed")) return false
    true
}
