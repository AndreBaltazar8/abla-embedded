import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipApiLibInternals(): bool {
    if (!internalFunction("esp32RecoveredNetconnNewWithProtoAndCallback", "netconn_new_with_proto_and_callback")) return false
    if (!internalFunction("esp32RecoveredNetconnPrepareDelete", "netconn_prepare_delete")) return false
    if (!internalFunction("esp32RecoveredNetconnDelete", "netconn_delete")) return false
    if (!internalFunction("esp32RecoveredNetconnGetaddr", "netconn_getaddr")) return false
    if (!internalFunction("esp32RecoveredNetconnBind", "netconn_bind")) return false
    if (!internalFunction("esp32RecoveredNetconnBindIf", "netconn_bind_if")) return false
    if (!internalFunction("esp32RecoveredNetconnConnect", "netconn_connect")) return false
    if (!internalFunction("esp32RecoveredNetconnDisconnect", "netconn_disconnect")) return false
    if (!internalFunction("esp32RecoveredNetconnListenWithBacklog", "netconn_listen_with_backlog")) return false
    if (!internalFunction("esp32RecoveredNetconnTcpRecvd", "netconn_tcp_recvd")) return false
    if (!internalFunction("esp32RecoveredNetconnSend", "netconn_send")) return false
    if (!internalFunction("esp32RecoveredNetconnSendto", "netconn_sendto")) return false
    if (!internalFunction("esp32RecoveredNetconnWriteVectorsPartly", "netconn_write_vectors_partly")) return false
    if (!internalFunction("esp32RecoveredNetconnWritePartly", "netconn_write_partly")) return false
    if (!internalFunction("esp32RecoveredNetconnClose", "netconn_close")) return false
    if (!internalFunction("esp32RecoveredNetconnErr", "netconn_err")) return false
    if (!internalFunction("esp32RecoveredNetconnAccept", "netconn_accept")) return false
    if (!internalFunction("esp32RecoveredNetconnRecvUdpRawNetbuf", "netconn_recv_udp_raw_netbuf")) return false
    if (!internalFunction("esp32RecoveredNetconnRecvUdpRawNetbufFlags", "netconn_recv_udp_raw_netbuf_flags")) return false
    if (!internalFunction("esp32RecoveredNetconnRecvTcpPbuf", "netconn_recv_tcp_pbuf")) return false
    if (!internalFunction("esp32RecoveredNetconnRecvTcpPbufFlags", "netconn_recv_tcp_pbuf_flags")) return false
    if (!internalFunction("esp32RecoveredNetconnRecv", "netconn_recv")) return false
    if (!internalFunction("esp32RecoveredNetconnShutdown", "netconn_shutdown")) return false
    if (!internalFunction("esp32RecoveredNetconnJoinLeaveGroup", "netconn_join_leave_group")) return false
    if (!internalFunction("esp32RecoveredNetconnJoinLeaveGroupNetif", "netconn_join_leave_group_netif")) return false
    if (!internalFunction("esp32RecoveredNetconnGethostbynameAddrtype", "netconn_gethostbyname_addrtype")) return false
    if (!internalFunction("esp32RecoveredNetconnThreadInit", "netconn_thread_init")) return false
    if (!internalFunction("esp32RecoveredNetconnThreadCleanup", "netconn_thread_cleanup")) return false
    true
}
