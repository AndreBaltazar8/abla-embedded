import "../../esp32/rom/md5_esp32.ab"
import "freertos_arch_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

// RFC 6528 TCP initial sequence numbers. The complete tuple construction and
// MD5 input remain ordinary Abla so LLVM can inline and prune this path with
// the rest of lwIP.

val esp32LwipTcpIsnInputStorage = nativeStaticAllocate(64)
val esp32LwipTcpIsnInput = u32(esp32LwipTcpIsnInputStorage)
val esp32LwipTcpIsnBaseTimeStorage = nativeStaticAllocate(4)
val esp32LwipTcpIsnBaseTime = u32(esp32LwipTcpIsnBaseTimeStorage)

@inline
trusted fun esp32LwipTcpIsnLoadU8(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32LwipTcpIsnStoreU8(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32LwipTcpIsnLoadU32(address: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32LwipTcpIsnStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

trusted fun esp32LwipTcpIsnCopy(
    destination: u32, source: u32, length: u32
): void {
    var index = u32(0)
    while (index < length) {
        esp32LwipTcpIsnStoreU8(destination + index,
            esp32LwipTcpIsnLoadU8(source + index))
        index = index + u32(1)
    }
}

trusted fun esp32LwipTcpIsnZero(destination: u32, length: u32): void {
    var index = u32(0)
    while (index < length) {
        esp32LwipTcpIsnStoreU8(destination + index, u32(0))
        index = index + u32(1)
    }
}

trusted fun esp32LwipInitTcpIsn(bootTime: u32, secret: u32): void {
    esp32LwipTcpIsnZero(esp32LwipTcpIsnInput, u32(64))
    esp32LwipTcpIsnCopy(esp32LwipTcpIsnInput + u32(36), secret, u32(16))
    esp32LwipTcpIsnStoreU32(esp32LwipTcpIsnBaseTime,
        bootTime * u32(250000))
}

trusted fun esp32LwipTcpIsnWriteIpv4Mapped(
    destination: u32, address: u32
): void {
    esp32LwipTcpIsnZero(destination, u32(10))
    esp32LwipTcpIsnStoreU8(destination + u32(10), u32(255))
    esp32LwipTcpIsnStoreU8(destination + u32(11), u32(255))
    esp32LwipTcpIsnCopy(destination + u32(12), address, u32(4))
}

trusted fun esp32LwipHookTcpIsn(
    localIp: u32,
    localPort: u32,
    remoteIp: u32,
    remotePort: u32
): u32 {
    // ip_addr_t stores the address at offset zero and its type byte at offset
    // 20 in this dual-stack lwIP configuration.
    val isIpv6 = localIp != u32(0) &&
        esp32LwipTcpIsnLoadU8(localIp + u32(20)) == u32(6)
    if (isIpv6) {
        esp32LwipTcpIsnCopy(esp32LwipTcpIsnInput, localIp, u32(16))
        esp32LwipTcpIsnCopy(esp32LwipTcpIsnInput + u32(16), remoteIp,
            u32(16))
    } else {
        esp32LwipTcpIsnWriteIpv4Mapped(esp32LwipTcpIsnInput, localIp)
        esp32LwipTcpIsnWriteIpv4Mapped(
            esp32LwipTcpIsnInput + u32(16), remoteIp)
    }

    esp32LwipTcpIsnStoreU8(esp32LwipTcpIsnInput + u32(32),
        (localPort >>> u32(8)) & u32(255))
    esp32LwipTcpIsnStoreU8(esp32LwipTcpIsnInput + u32(33),
        localPort & u32(255))
    esp32LwipTcpIsnStoreU8(esp32LwipTcpIsnInput + u32(34),
        (remotePort >>> u32(8)) & u32(255))
    esp32LwipTcpIsnStoreU8(esp32LwipTcpIsnInput + u32(35),
        remotePort & u32(255))

    val digest = u32(nativeStackAllocate(16))
    val context = u32(nativeStackAllocate(88))
    esp32RomMd5Init(context)
    esp32RomMd5Update(context, esp32LwipTcpIsnInput, u32(64))
    esp32RomMd5Final(digest, context)

    esp32LwipTcpIsnLoadU32(digest) +
        esp32LwipTcpIsnLoadU32(esp32LwipTcpIsnBaseTime) +
        esp32LwipSysNow() * u32(250)
}

// Narrow adapters remain only while neighboring lifted lwIP files still use
// the recovered Xtensa register-frame calling shape.
trusted fun esp32RecoveredLwipInitTcpIsn(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 { esp32LwipInitTcpIsn(a2, a3); a2 }

trusted fun esp32RecoveredLwipHookTcpIsn(
    a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,
    s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32
):u32 = esp32LwipHookTcpIsn(a2, a3, a4, a5)
