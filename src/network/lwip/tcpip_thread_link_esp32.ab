import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipTcpipThreadInternals(): bool {
    if (!internalFunction("esp32RecoveredTcpipInpkt", "tcpip_inpkt")) return false
    if (!internalFunction("esp32RecoveredTcpipInput", "tcpip_input")) return false
    if (!internalFunction("esp32RecoveredTcpipCallback", "tcpip_callback")) return false
    if (!internalFunction("esp32RecoveredTcpipTryCallback", "tcpip_try_callback")) return false
    if (!internalFunction("esp32RecoveredTcpipSendMsgWaitSem", "tcpip_send_msg_wait_sem")) return false
    if (!internalFunction("esp32RecoveredTcpipApiCall", "tcpip_api_call")) return false
    if (!internalFunction("esp32RecoveredTcpipCallbackmsgNew", "tcpip_callbackmsg_new")) return false
    if (!internalFunction("esp32RecoveredTcpipCallbackmsgDelete", "tcpip_callbackmsg_delete")) return false
    if (!internalFunction("esp32RecoveredTcpipCallbackmsgTrycallback", "tcpip_callbackmsg_trycallback")) return false
    if (!internalFunction("esp32RecoveredTcpipCallbackmsgTrycallbackFromisr", "tcpip_callbackmsg_trycallback_fromisr")) return false
    if (!internalFunction("esp32RecoveredTcpipCallbackWait", "tcpip_callback_wait")) return false
    if (!internalFunction("esp32RecoveredTcpipInit", "tcpip_init")) return false
    if (!internalFunction("esp32RecoveredPbufFreeCallback", "pbuf_free_callback")) return false
    if (!internalFunction("esp32RecoveredMemFreeCallback", "mem_free_callback")) return false
    true
}
