import "abla/unsafe/memory"
import "abla/unsafe/native"

// The callback head belongs to the Abla module. A callback record is the lwIP
// two-word layout: function pointer followed by next pointer.
val esp32LwipNetifCallbackHead = nativeStaticAllocate(4)

@inline
trusted fun esp32LwipNetifCallbackLoad(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32LwipNetifCallbackStore(
    address: u32,
    value: u32
): void {
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(address)), int(value)
    )
    return
}

trusted fun esp32LwipNetifAddExtendedCallback(
    callbackRecord: u32,
    callback: u32
): void {
    if (callbackRecord == u32(0) || callback == u32(0)) return
    esp32LwipNetifCallbackStore(callbackRecord, callback)
    esp32LwipNetifCallbackStore(
        callbackRecord + u32(4),
        esp32LwipNetifCallbackLoad(u32(esp32LwipNetifCallbackHead))
    )
    esp32LwipNetifCallbackStore(
        u32(esp32LwipNetifCallbackHead), callbackRecord
    )
    return
}

trusted fun esp32LwipNetifRemoveExtendedCallback(
    callbackRecord: u32
): void {
    if (callbackRecord == u32(0)) return
    var previous = u32(0)
    var current = esp32LwipNetifCallbackLoad(
        u32(esp32LwipNetifCallbackHead)
    )
    if (current == u32(0)) return
    while (current != u32(0)) {
        val next = esp32LwipNetifCallbackLoad(current + u32(4))
        if (current == callbackRecord) {
            if (previous == u32(0)) esp32LwipNetifCallbackStore(
                u32(esp32LwipNetifCallbackHead), next
            ) else esp32LwipNetifCallbackStore(previous + u32(4), next)
            current = u32(0)
        } else {
            previous = current
            current = next
        }
    }
    esp32LwipNetifCallbackStore(callbackRecord + u32(4), u32(0))
    return
}

trusted fun esp32LwipNetifInvokeExtendedCallbacks(
    networkInterface: u32,
    reason: u32,
    arguments: u32
): void {
    if (networkInterface == u32(0)) return
    var current = esp32LwipNetifCallbackLoad(
        u32(esp32LwipNetifCallbackHead)
    )
    while (current != u32(0)) {
        // Preserve lwIP's ability for a callback to remove itself.
        val next = esp32LwipNetifCallbackLoad(current + u32(4))
        val callback = esp32LwipNetifCallbackLoad(current)
        if (callback != u32(0)) callNativeVoidI32I32I32(
            int(callback),
            int(networkInterface),
            int(reason & u32(65535)),
            int(arguments)
        )
        current = next
    }
    return
}
