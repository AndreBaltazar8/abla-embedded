import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipMldIpv6Internals(): bool {
    if (!internalFunction("esp32RecoveredMld6Stop", "mld6_stop")) return false
    if (!internalFunction("esp32RecoveredMld6ReportGroups", "mld6_report_groups")) return false
    if (!internalFunction("esp32RecoveredMld6LookforGroup", "mld6_lookfor_group")) return false
    if (!internalFunction("esp32RecoveredMld6Input", "mld6_input")) return false
    if (!internalFunction("esp32RecoveredMld6JoingroupNetif", "mld6_joingroup_netif")) return false
    if (!internalFunction("esp32RecoveredMld6Joingroup", "mld6_joingroup")) return false
    if (!internalFunction("esp32RecoveredMld6LeavegroupNetif", "mld6_leavegroup_netif")) return false
    if (!internalFunction("esp32RecoveredMld6Leavegroup", "mld6_leavegroup")) return false
    if (!internalFunction("esp32RecoveredMld6Tmr", "mld6_tmr")) return false
    true
}
