import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipPppVjInternals(): bool {
    if (!internalFunction("esp32RecoveredVjCompressInit", "vj_compress_init")) return false
    if (!internalFunction("esp32RecoveredVjCompressTcp", "vj_compress_tcp")) return false
    if (!internalFunction("esp32RecoveredVjUncompressErr", "vj_uncompress_err")) return false
    if (!internalFunction("esp32RecoveredVjUncompressUncomp", "vj_uncompress_uncomp")) return false
    if (!internalFunction("esp32RecoveredVjUncompressTcp", "vj_uncompress_tcp")) return false
    true
}
