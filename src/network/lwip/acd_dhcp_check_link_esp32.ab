import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipAcdDhcpCheckInternals(): bool {
    if (!internalFunction("esp32RecoveredAcdRemove", "acd_remove")) return false
    if (!internalFunction("esp32RecoveredAcdNetifIpAddrChanged", "acd_netif_ip_addr_changed")) return false
    if (!internalFunction("esp32RecoveredAcdNetworkChangedLinkDown", "acd_network_changed_link_down")) return false
    if (!internalFunction("esp32RecoveredAcdArpReply", "acd_arp_reply")) return false
    if (!internalFunction("esp32RecoveredAcdAdd", "acd_add")) return false
    if (!internalFunction("esp32RecoveredAcdStart", "acd_start")) return false
    true
}
