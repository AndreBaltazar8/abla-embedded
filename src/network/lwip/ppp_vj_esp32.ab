@inline
trusted fun esp32InternalVjLoadU8(address: u32): u32 =
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32InternalVjLoadU16(address: u32): u32 =
