@inline
trusted fun esp32InternalVjLoadU32(address: u32): u32 =
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32InternalVjStoreU8(address: u32, value: u32): void =
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32InternalVjStoreU16(address: u32, value: u32): void =
    ablaUnsafeStoreU16(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32InternalVjStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32InternalVjEncodedDelta(cursor: u32): u32 =
    if (esp32InternalVjLoadU8(cursor) == u32(0))
        (esp32InternalVjLoadU8(cursor + u32(1)) << u32(8)) | esp32InternalVjLoadU8(cursor + u32(2))
    else esp32InternalVjLoadU8(cursor)

@inline
trusted fun esp32InternalVjNextEncodedDelta(cursor: u32): u32 =
    if (esp32InternalVjLoadU8(cursor) == u32(0)) cursor + u32(3) else cursor + u32(1)

trusted fun esp32InternalVjEncodeDelta(cursor: u32, value: u32, encodeZero: bool): u32 {
    val narrowed = value & u32(65535)
    if (narrowed >= u32(256) || (encodeZero && narrowed == u32(0))) {
        esp32InternalVjStoreU8(cursor, u32(0))
        esp32InternalVjStoreU8(cursor + u32(1), narrowed >>> u32(8))
        esp32InternalVjStoreU8(cursor + u32(2), narrowed)
        return cursor + u32(3)
    }
    esp32InternalVjStoreU8(cursor, narrowed)
    return cursor + u32(1)
}

@inline
trusted fun esp32InternalVjConnectionMatches(ipHeader: u32, tcpHeader: u32, state: u32): bool {
    val savedIp = state + u32(8)
    val savedTcp = savedIp + ((esp32InternalVjLoadU8(savedIp) & u32(15)) << u32(2))
    return esp32InternalVjLoadU32(ipHeader + u32(12)) == esp32InternalVjLoadU32(savedIp + u32(12)) &&
        esp32InternalVjLoadU32(ipHeader + u32(16)) == esp32InternalVjLoadU32(savedIp + u32(16)) &&
        esp32InternalVjLoadU32(tcpHeader) == esp32InternalVjLoadU32(savedTcp)
}

trusted fun esp32InternalVjReturnUncompressed(
    compressor: u32,
    state: u32,
    ipHeader: u32,
    headerLength: u32
): u32 {
    freestandingCopy(state + u32(8), ipHeader, headerLength)
    val connectionId = esp32InternalVjLoadU8(state + u32(6))
    esp32InternalVjStoreU8(ipHeader + u32(9), connectionId)
    esp32InternalVjStoreU8(compressor + u32(5), connectionId)
    return u32(112)
}

