import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipIpv6Internals(): bool {
    if (!internalFunction("esp32RecoveredIp6Route", "ip6_route")) return false
    if (!internalFunction("esp32RecoveredIp6SelectSourceAddress", "ip6_select_source_address")) return false
    if (!internalFunction("esp32RecoveredIp6Input", "ip6_input")) return false
    if (!internalFunction("esp32RecoveredIp6OutputIfSrc", "ip6_output_if_src")) return false
    if (!internalFunction("esp32RecoveredIp6OutputIf", "ip6_output_if")) return false
    if (!internalFunction("esp32RecoveredIp6Output", "ip6_output")) return false
    if (!internalFunction("esp32RecoveredIp6OptionsAddHbhRa", "ip6_options_add_hbh_ra")) return false
    true
}
