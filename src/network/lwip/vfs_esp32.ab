import "../../esp32/vfs/registry_esp32.ab"
import "../../runtime/freestanding_memory.ab"
import "sockets_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"
import "abla/unsafe/native"

// Structured-Abla implementation of ESP-IDF's lwIP VFS bridge. Socket
// protocol behavior remains in the Abla lwIP modules; this file only adapts
// their typed operations to the common VFS tables.
val esp32LwipVfsSocketMinimum = u32(54)
val esp32LwipVfsDescriptorMaximum = u32(64)
val esp32LwipVfsBadDescriptor = i32(9)
val esp32LwipVfsFailure = u32(0xffffffff)

trusted fun esp32LwipVfsWrite(
    context: u32, fd: u32, data: u32, size: u32
): u32 = esp32RecoveredLwipWrite(
    fd,data,size,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LwipVfsRead(
    context: u32, fd: u32, data: u32, size: u32
): u32 = esp32RecoveredLwipRead(
    fd,data,size,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LwipVfsClose(context: u32, fd: u32): u32 =
    esp32RecoveredLwipClose(
        fd,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LwipVfsFcntl(
    context: u32, fd: u32, command: u32, argument: u32
): u32 = esp32RecoveredLwipFcntl(
    fd,command,argument,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

// va_list is received as the Xtensa ABI's stack pointer, register-save
// pointer, and next-register offset. ioctl consumes one pointer argument.
trusted fun esp32LwipVfsIoctl(
    context: u32,
    fd: u32,
    command: u32,
    argumentStack: u32,
    argumentRegisters: u32,
    argumentIndex: u32
): u32 {
    var argument = u32(0)
    if (argumentIndex < u32(24)) {
        argument = esp32VfsLoad(argumentRegisters + argumentIndex)
    } else {
        val stackOffset = if (argumentIndex <= u32(24))
            u32(32) else argumentIndex - u32(4)
        argument = esp32VfsLoad(argumentStack + stackOffset)
    }
    return esp32RecoveredLwipIoctl(
        fd,command,argument,u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
}

trusted fun esp32LwipVfsFstat(
    context: u32, fd: u32, status: u32
): u32 {
    if (status == u32(0) ||
        fd < esp32LwipVfsSocketMinimum ||
        fd >= esp32LwipVfsDescriptorMaximum) {
        esp32LwipSetErrno(esp32LwipVfsBadDescriptor)
        return esp32LwipVfsFailure
    }
    freestandingSet(status, i32(0), u32(88))
    // struct stat::st_mode = S_IFSOCK on the recovered 32-bit ABI.
    esp32VfsStore(status + u32(4), u32(49152))
    return u32(0)
}

trusted fun esp32LwipVfsSelect(
    count: u32,
    readDescriptors: u32,
    writeDescriptors: u32,
    errorDescriptors: u32,
    timeout: u32
): u32 = esp32RecoveredLwipSelect(
    count,readDescriptors,writeDescriptors,errorDescriptors,timeout,u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LwipVfsGetSelectSemaphore(): u32 =
    esp32RecoveredSysThreadSemGet(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LwipVfsStopSelect(semaphore: u32): void {
    esp32RecoveredSysSemSignal(
        semaphore,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    return
}

trusted fun esp32LwipVfsStopSelectIsr(
    semaphore: u32, woken: u32
): void {
    val unblocked = esp32RecoveredSysSemSignalIsr(
        semaphore,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    if (unblocked != u32(0) && woken != u32(0)) {
        esp32VfsStore(woken, u32(1))
    }
}

val esp32LwipVfsSelectOperationsStorage = nativeStaticU32s([
    0,
    int(u32(nativeFunctionAddress(esp32LwipVfsSelect))),
    int(u32(nativeFunctionAddress(esp32LwipVfsStopSelect))),
    int(u32(nativeFunctionAddress(esp32LwipVfsStopSelectIsr))),
    int(u32(nativeFunctionAddress(esp32LwipVfsGetSelectSemaphore))),
    0
])
val esp32LwipVfsSelectOperations = u32(
    esp32LwipVfsSelectOperationsStorage
)

val esp32LwipVfsOperationsStorage = nativeStaticU32s([
    int(u32(nativeFunctionAddress(esp32LwipVfsWrite))),
    0,
    int(u32(nativeFunctionAddress(esp32LwipVfsRead))),
    0,0,0,
    int(u32(nativeFunctionAddress(esp32LwipVfsClose))),
    int(u32(nativeFunctionAddress(esp32LwipVfsFstat))),
    int(u32(nativeFunctionAddress(esp32LwipVfsFcntl))),
    int(u32(nativeFunctionAddress(esp32LwipVfsIoctl))),
    0,0,
    int(esp32LwipVfsSelectOperations)
])
val esp32LwipVfsOperations = u32(esp32LwipVfsOperationsStorage)

trusted fun esp32LwipVfsRegister(): void {
    val result = esp32VfsRegisterFdRange(
        esp32LwipVfsOperations,
        esp32VfsFlagStatic | esp32VfsFlagContext,
        u32(0),
        esp32LwipVfsSocketMinimum,
        esp32LwipVfsDescriptorMaximum
    )
    if (result != esp32VfsOk) ablaRuntimeTrap()
}
