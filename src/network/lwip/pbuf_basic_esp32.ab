import "abla/unsafe/memory"
import "abla/unsafe/native"
import "../ip_text.ab"
import "./definitions_esp32.ab"
import "../../xtensa/assembly.ab"
import "shared_storage_esp32.ab"

val esp32LwipPbufFreeOutOfSequencePending = nativeStaticAllocate(1)

// Typed, zero-cost views over the recovered Xtensa calling convention. Keeping
// the register-shaped entry points private to the recovered modules lets the
// rest of the lwIP implementation remain ordinary Abla.
@inline
trusted fun esp32LwipPbufSysArchUnprotect(protection: u32): void {
    esp32RecoveredSysArchUnprotect(
        protection, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return
}

@inline
trusted fun esp32LwipMempFree(pool: u32, allocation: u32): void {
    esp32RecoveredMempFree(
        pool, allocation, u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return
}

@inline
trusted fun esp32LwipTcpFreeOutOfSequence(controlBlock: u32): void {
    esp32RecoveredTcpFreeOoseq(
        controlBlock, u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return
}

@inline
trusted fun esp32LwipPbufLoadU8(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
) & u32(255)

@inline
trusted fun esp32LwipPbufLoadU16(address: u32): u32 = u32(
    ablaUnsafeLoadU16(nativePointerFromAddress(int(address)))
) & u32(65535)

@inline
trusted fun esp32LwipPbufLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline
trusted fun esp32LwipPbufStoreU8(address: u32, value: u32): void {
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)), int(value))
    return
}

@inline
trusted fun esp32LwipPbufStoreU16(address: u32, value: u32): void {
    ablaUnsafeStoreU16(nativePointerFromAddress(int(address)), int(value))
    return
}

@inline
trusted fun esp32LwipPbufStoreU32(address: u32, value: u32): void {
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))
    return
}

@inline
trusted fun esp32LwipPbufAlign4(value: u32): u32 =
    (value + u32(3)) & u32(4294967292)

@inline
trusted fun esp32LwipTcpActiveControlBlocksCell(): u32 =
    esp32Data_tcp_active_pcbs_ae33bb9f54

@inline
trusted fun esp32LwipPbufInitializeAllocated(
    packet: u32,
    payload: u32,
    totalLength: u32,
    length: u32,
    typeInternal: u32,
    flags: u32
): void {
    esp32LwipPbufStoreU32(packet, u32(0))
    esp32LwipPbufStoreU32(packet + u32(4), payload)
    esp32LwipPbufStoreU16(packet + u32(8), totalLength)
    esp32LwipPbufStoreU16(packet + u32(10), length)
    esp32LwipPbufStoreU8(packet + u32(12), typeInternal)
    esp32LwipPbufStoreU8(packet + u32(13), flags)
    esp32LwipPbufStoreU8(packet + u32(14), u32(1))
    esp32LwipPbufStoreU8(packet + u32(15), u32(0))
    return
}

trusted fun esp32LwipPbufAllocateReference(
    payload: u32,
    rawLength: u32,
    typeInternal: u32
): u32 {
    if (typeInternal != u32(1) && typeInternal != u32(65)) return u32(0)
    val packet = esp32RecoveredMempMalloc(u32(16))
    if (packet == u32(0)) return u32(0)
    val length = rawLength & u32(65535)
    esp32LwipPbufInitializeAllocated(
        packet, payload, length, length, typeInternal, u32(0)
    )
    return packet
}

trusted fun esp32LwipPbufFreeOutOfSequence(argument: u32): void {
    val protection = esp32RecoveredSysArchProtect()
    esp32LwipPbufStoreU8(
        u32(esp32LwipPbufFreeOutOfSequencePending), u32(0)
    )
    esp32LwipPbufSysArchUnprotect(protection)

    var controlBlock = esp32LwipPbufLoadU32(
        esp32LwipTcpActiveControlBlocksCell()
    )
    while (controlBlock != u32(0)) {
        if (esp32LwipPbufLoadU32(controlBlock + u32(160)) != u32(0)) {
            esp32LwipTcpFreeOutOfSequence(controlBlock)
            return
        }
        controlBlock = esp32LwipPbufLoadU32(controlBlock + u32(52))
    }
    return
}

trusted fun esp32LwipPbufPoolIsEmpty(): void {
    val protection = esp32RecoveredSysArchProtect()
    val pending = esp32LwipPbufLoadU8(
        u32(esp32LwipPbufFreeOutOfSequencePending)
    )
    esp32LwipPbufStoreU8(
        u32(esp32LwipPbufFreeOutOfSequencePending), u32(1)
    )
    esp32LwipPbufSysArchUnprotect(protection)
    if (pending != u32(0)) return

    val status = esp32RecoveredTcpipTryCallback(
        u32(nativeFunctionAddress(esp32LwipPbufFreeOutOfSequence)),
        u32(0)
    )
    if (status == u32(0)) return

    val resetProtection = esp32RecoveredSysArchProtect()
    esp32LwipPbufStoreU8(
        u32(esp32LwipPbufFreeOutOfSequencePending), u32(0)
    )
    esp32LwipPbufSysArchUnprotect(resetProtection)
    return
}

trusted fun esp32LwipPbufFree(first: u32): u32 {
    var packet = first
    var freed = u32(0)
    while (packet != u32(0)) {
        val protection = esp32RecoveredSysArchProtect()
        val references = esp32LwipPbufLoadU8(packet + u32(14))
        if (references == u32(0)) {
            esp32LwipPbufSysArchUnprotect(protection)
            return freed
        }
        val remainingReferences = (references - u32(1)) & u32(255)
        esp32LwipPbufStoreU8(packet + u32(14), remainingReferences)
        esp32LwipPbufSysArchUnprotect(protection)
        if (remainingReferences != u32(0)) return freed

        val next = esp32LwipPbufLoadU32(packet)
        val allocationType = esp32LwipPbufLoadU8(
            packet + u32(12)
        ) & u32(15)
        val flags = esp32LwipPbufLoadU8(packet + u32(13))
        if ((flags & u32(2)) != u32(0)) {
            val callback = esp32LwipPbufLoadU32(packet + u32(16))
            if (callback == u32(0)) return freed
            callNativeVoidPointer(
                int(callback), nativePointerFromAddress(int(packet))
            )
        } else if (allocationType == u32(2)) {
            esp32LwipMempFree(u32(17), packet)
        } else if (allocationType == u32(1)) {
            esp32LwipMempFree(u32(16), packet)
        } else if (allocationType == u32(0)) {
            esp32LwipMemFree(packet)
        } else return freed

        freed = (freed + u32(1)) & u32(255)
        packet = next
    }
    return freed
}

trusted fun esp32LwipPbufAllocate(
    rawLayer: u32,
    rawLength: u32,
    typeInternal: u32
): u32 {
    var layer = rawLayer & u32(65535)
    val length = rawLength & u32(65535)
    if (typeInternal == u32(1) || typeInternal == u32(65)) {
        return esp32LwipPbufAllocateReference(
            u32(0), length, typeInternal
        )
    }

    if (typeInternal == u32(386)) {
        var first = u32(0)
        var previous = u32(0)
        var remaining = length
        while (remaining != u32(0)) {
            val packet = esp32RecoveredMempMalloc(u32(17))
            if (packet == u32(0)) {
                esp32LwipPbufPoolIsEmpty()
                if (first != u32(0)) {
                    val ignored = esp32LwipPbufFree(first)
                }
                return u32(0)
            }
            val offset = esp32LwipPbufAlign4(layer)
            if (offset >= u32(1516)) {
                esp32LwipMempFree(u32(17), packet)
                if (first != u32(0)) {
                    val ignored = esp32LwipPbufFree(first)
                }
                return u32(0)
            }
            val capacity = u32(1516) - offset
            val packetLength = if (remaining < capacity)
                remaining else capacity
            val payload = esp32LwipPbufAlign4(packet + u32(16) + layer)
            esp32LwipPbufInitializeAllocated(
                packet,
                payload,
                remaining,
                packetLength,
                typeInternal,
                u32(0)
            )
            if (previous == u32(0)) first = packet
            else esp32LwipPbufStoreU32(previous, packet)
            previous = packet
            remaining = (remaining - packetLength) & u32(65535)
            layer = u32(0)
        }
        return first
    }

    if (typeInternal != u32(640)) return u32(0)
    val layerBytes = esp32LwipPbufAlign4(layer)
    val payloadBytes = esp32LwipPbufAlign4(length)
    if (layerBytes > u32(4294967279) - payloadBytes) return u32(0)
    val allocationSize = u32(16) + layerBytes + payloadBytes
    val packet = esp32LwipMemAllocate(allocationSize)
    if (packet == u32(0)) return u32(0)
    val payload = esp32LwipPbufAlign4(packet + u32(16) + layer)
    esp32LwipPbufInitializeAllocated(
        packet, payload, length, length, typeInternal, u32(0)
    )
    return packet
}

trusted fun esp32LwipPbufReallocate(
    first: u32,
    rawNewLength: u32
): void {
    if (first == u32(0)) return
    val newLength = rawNewLength & u32(65535)
    val oldTotalLength = esp32LwipPbufLoadU16(first + u32(8))
    if (newLength >= oldTotalLength) return

    var packet = first
    var remaining = newLength
    while (packet != u32(0) &&
        esp32LwipPbufLoadU16(packet + u32(10)) < remaining) {
        val packetLength = esp32LwipPbufLoadU16(packet + u32(10))
        remaining = (remaining - packetLength) & u32(65535)
        esp32LwipPbufStoreU16(
            packet + u32(8),
            esp32LwipPbufLoadU16(packet + u32(8)) +
                newLength - oldTotalLength
        )
        packet = esp32LwipPbufLoadU32(packet)
    }
    if (packet == u32(0)) return

    val packetLength = esp32LwipPbufLoadU16(packet + u32(10))
    val allocationType = esp32LwipPbufLoadU8(packet + u32(12)) & u32(15)
    val flags = esp32LwipPbufLoadU8(packet + u32(13))
    if (allocationType == u32(0) && packetLength != remaining &&
        (flags & u32(2)) == u32(0)) {
        val allocationSize = esp32LwipPbufLoadU32(packet + u32(4)) -
            packet + remaining
        val ignored = esp32LwipMemTrim(packet, allocationSize)
    }

    esp32LwipPbufStoreU16(packet + u32(10), remaining)
    esp32LwipPbufStoreU16(packet + u32(8), remaining)
    val tail = esp32LwipPbufLoadU32(packet)
    if (tail != u32(0)) {
        val ignored = esp32LwipPbufFree(tail)
    }
    esp32LwipPbufStoreU32(packet, u32(0))
    return
}

trusted fun esp32LwipPbufReallocateValue(
    first: u32,
    newLength: u32
): u32 {
    esp32LwipPbufReallocate(first, newLength)
    u32(0)
}

trusted fun esp32LwipPbufReference(packet: u32): void {
    if (packet == u32(0)) return
    val protection = esp32RecoveredSysArchProtect()
    val references = (
        esp32LwipPbufLoadU8(packet + u32(14)) + u32(1)
    ) & u32(255)
    esp32LwipPbufStoreU8(packet + u32(14), references)
    esp32LwipPbufSysArchUnprotect(protection)
    return
}

trusted fun esp32LwipPbufAllocatedCustom(
    layer: u32,
    rawLength: u32,
    typeInternal: u32,
    packet: u32,
    payloadMemory: u32,
    rawPayloadMemoryLength: u32
): u32 {
    val length = rawLength & u32(65535)
    val payloadMemoryLength = rawPayloadMemoryLength & u32(65535)
    val offset = ((layer & u32(65535)) + u32(3)) & u32(4294967292)
    if (payloadMemoryLength < length + offset) return u32(0)
    val payload = if (payloadMemory == u32(0)) u32(0)
        else payloadMemory + offset
    esp32LwipPbufInitializeAllocated(
        packet, payload, length, length, typeInternal, u32(2)
    )
    return packet
}

@inline
trusted fun esp32LwipPbufAddHeaderImplementation(
    packet: u32,
    rawHeaderSize: u32,
    force: bool
): u32 {
    if (packet == u32(0) || rawHeaderSize > u32(65535)) return u32(1)
    val headerSize = rawHeaderSize & u32(65535)
    if (headerSize == u32(0)) return u32(0)
    val totalLength = (
        esp32LwipPbufLoadU16(packet + u32(8)) + headerSize
    ) & u32(65535)
    if (totalLength < headerSize) return u32(1)

    val payload = esp32LwipPbufLoadU32(packet + u32(4)) - headerSize
    val typeInternal = i32(i8(esp32LwipPbufLoadU8(packet + u32(12))))
    if (typeInternal < 0) {
        if (payload < packet + u32(16)) return u32(1)
    } else if (!force) return u32(1)

    esp32LwipPbufStoreU32(packet + u32(4), payload)
    esp32LwipPbufStoreU16(
        packet + u32(10),
        esp32LwipPbufLoadU16(packet + u32(10)) + headerSize
    )
    esp32LwipPbufStoreU16(packet + u32(8), totalLength)
    return u32(0)
}

trusted fun esp32LwipPbufAddHeader(packet: u32, headerSize: u32): u32 =
    esp32LwipPbufAddHeaderImplementation(packet, headerSize, false)

trusted fun esp32LwipPbufAddHeaderForce(packet: u32, headerSize: u32): u32 =
    esp32LwipPbufAddHeaderImplementation(packet, headerSize, true)

trusted fun esp32LwipPbufRemoveHeader(
    packet: u32,
    rawHeaderSize: u32
): u32 {
    if (packet == u32(0) || rawHeaderSize > u32(65535)) return u32(1)
    val headerSize = rawHeaderSize & u32(65535)
    if (headerSize == u32(0)) return u32(0)
    val length = esp32LwipPbufLoadU16(packet + u32(10))
    if (length < headerSize) return u32(1)
    esp32LwipPbufStoreU32(
        packet + u32(4),
        esp32LwipPbufLoadU32(packet + u32(4)) + headerSize
    )
    esp32LwipPbufStoreU16(packet + u32(10), length - headerSize)
    esp32LwipPbufStoreU16(
        packet + u32(8),
        esp32LwipPbufLoadU16(packet + u32(8)) - headerSize
    )
    return u32(0)
}

@inline
trusted fun esp32LwipPbufHeaderImplementation(
    packet: u32,
    rawHeaderSizeIncrement: u32,
    force: bool
): u32 {
    val increment = i32(i16(rawHeaderSizeIncrement))
    if (increment < 0) return esp32LwipPbufRemoveHeader(
        packet, u32(0) - u32(increment)
    )
    return esp32LwipPbufAddHeaderImplementation(
        packet, u32(increment), force
    )
}

trusted fun esp32LwipPbufHeader(
    packet: u32,
    headerSizeIncrement: u32
): u32 = esp32LwipPbufHeaderImplementation(
    packet, headerSizeIncrement, false
)

trusted fun esp32LwipPbufHeaderForce(
    packet: u32,
    headerSizeIncrement: u32
): u32 = esp32LwipPbufHeaderImplementation(
    packet, headerSizeIncrement, true
)

trusted fun esp32LwipPbufFreeHeader(
    first: u32,
    rawHeaderSize: u32
): u32 {
    var packet = first
    var remaining = rawHeaderSize & u32(65535)
    while (packet != u32(0) && remaining != u32(0)) {
        val length = esp32LwipPbufLoadU16(packet + u32(10))
        if (remaining < length) {
            val ignored = esp32LwipPbufRemoveHeader(packet, remaining)
            remaining = u32(0)
        } else {
            remaining = (remaining - length) & u32(65535)
            val next = esp32LwipPbufLoadU32(packet)
            esp32LwipPbufStoreU32(packet, u32(0))
            val ignored = esp32LwipPbufFree(packet)
            packet = next
        }
    }
    return packet
}

trusted fun esp32LwipPbufChainLength(first: u32): u32 {
    var count = u32(0)
    var packet = first
    while (packet != u32(0)) {
        count = (count + u32(1)) & u32(65535)
        packet = esp32LwipPbufLoadU32(packet)
    }
    return count
}

trusted fun esp32LwipPbufConcatenate(first: u32, tail: u32): void {
    if (first == u32(0) || tail == u32(0)) return
    val tailLength = esp32LwipPbufLoadU16(tail + u32(8))
    var packet = first
    while (true) {
        esp32LwipPbufStoreU16(
            packet + u32(8),
            (esp32LwipPbufLoadU16(packet + u32(8)) + tailLength) &
                u32(65535)
        )
        val next = esp32LwipPbufLoadU32(packet)
        if (next == u32(0)) {
            esp32LwipPbufStoreU32(packet, tail)
            return
        }
        packet = next
    }
}

trusted fun esp32LwipPbufConcatenateValue(first: u32, tail: u32): u32 {
    esp32LwipPbufConcatenate(first, tail)
    u32(0)
}

trusted fun esp32LwipPbufChain(first: u32, tail: u32): void {
    esp32LwipPbufConcatenate(first, tail)
    esp32LwipPbufReference(tail)
    return
}

trusted fun esp32LwipPbufDechain(first: u32): u32 {
    val tail = esp32LwipPbufLoadU32(first)
    if (tail == u32(0)) return u32(0)
    esp32LwipPbufStoreU16(
        tail + u32(8),
        esp32LwipPbufLoadU16(first + u32(8)) -
            esp32LwipPbufLoadU16(first + u32(10))
    )
    esp32LwipPbufStoreU32(first, u32(0))
    esp32LwipPbufStoreU16(
        first + u32(8), esp32LwipPbufLoadU16(first + u32(10))
    )
    return if (esp32LwipPbufFree(tail) == u32(0)) tail else u32(0)
}

trusted fun esp32LwipPbufSkip(
    first: u32,
    rawOffset: u32,
    outputOffset: u32
): u32 {
    var packet = first
    var offset = rawOffset & u32(65535)
    while (packet != u32(0) &&
        offset >= esp32LwipPbufLoadU16(packet + u32(10))) {
        offset = (offset - esp32LwipPbufLoadU16(
            packet + u32(10)
        )) & u32(65535)
        packet = esp32LwipPbufLoadU32(packet)
    }
    if (outputOffset != u32(0)) esp32LwipPbufStoreU16(
        outputOffset, offset
    )
    return packet
}

trusted fun esp32LwipPbufGetContiguous(
    first: u32,
    buffer: u32,
    bufferSize: u32,
    rawLength: u32,
    rawOffset: u32
): u32 {
    val length = rawLength & u32(65535)
    if (first == u32(0) || buffer == u32(0) || bufferSize < length) {
        return u32(0)
    }
    val offsetCell = nativeStackAllocate(2)
    val packet = esp32LwipPbufSkip(
        first, rawOffset & u32(65535), u32(offsetCell)
    )
    if (packet == u32(0)) return u32(0)
    val offset = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(offsetCell)
    )) & u32(65535)
    if (esp32LwipPbufLoadU16(packet + u32(10)) >= offset + length) {
        return esp32LwipPbufLoadU32(packet + u32(4)) + offset
    }
    return if (esp32LwipPbufCopyPartial(
        first, buffer, length, rawOffset & u32(65535)
    ) == length) buffer else u32(0)
}

trusted fun esp32LwipPbufTake(
    first: u32,
    source: u32,
    rawLength: u32
): u32 {
    if (first == u32(0) || source == u32(0)) return u32(240)
    var remaining = rawLength & u32(65535)
    if (esp32LwipPbufLoadU16(first + u32(8)) < remaining) return u32(255)
    var packet = first
    var copied = u32(0)
    while (remaining != u32(0)) {
        if (packet == u32(0)) return u32(240)
        val packetLength = esp32LwipPbufLoadU16(packet + u32(10))
        val amount = if (packetLength < remaining) packetLength else remaining
        ablaUnsafeCopyMemory(
            int(esp32LwipPbufLoadU32(packet + u32(4))),
            int(source + copied),
            int(amount)
        )
        remaining = remaining - amount
        copied = copied + amount
        packet = esp32LwipPbufLoadU32(packet)
    }
    return u32(0)
}

trusted fun esp32LwipPbufTakeAt(
    first: u32,
    source: u32,
    rawLength: u32,
    rawOffset: u32
): u32 {
    val length = rawLength & u32(65535)
    val offsetCell = nativeStackAllocate(2)
    val packet = esp32LwipPbufSkip(
        first, rawOffset & u32(65535), u32(offsetCell)
    )
    if (packet == u32(0)) return u32(255)
    val offset = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(offsetCell)
    )) & u32(65535)
    if (esp32LwipPbufLoadU16(packet + u32(8)) < offset + length) {
        return u32(255)
    }
    val available = esp32LwipPbufLoadU16(packet + u32(10)) - offset
    val amount = if (available < length) available else length
    ablaUnsafeCopyMemory(
        int(esp32LwipPbufLoadU32(packet + u32(4)) + offset),
        int(source),
        int(amount)
    )
    val remaining = (length - amount) & u32(65535)
    if (remaining == u32(0)) return u32(0)
    return esp32LwipPbufTake(
        esp32LwipPbufLoadU32(packet), source + amount, remaining
    )
}

trusted fun esp32LwipPbufTryGetAt(first: u32, rawOffset: u32): i32 {
    val offsetCell = nativeStackAllocate(2)
    val packet = esp32LwipPbufSkip(
        first, rawOffset & u32(65535), u32(offsetCell)
    )
    if (packet == u32(0)) return -1
    val offset = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(offsetCell)
    )) & u32(65535)
    if (offset >= esp32LwipPbufLoadU16(packet + u32(10))) return -1
    return i32(esp32LwipPbufLoadU8(
        esp32LwipPbufLoadU32(packet + u32(4)) + offset
    ))
}

trusted fun esp32LwipPbufGetAt(first: u32, offset: u32): u32 {
    val result = esp32LwipPbufTryGetAt(first, offset)
    return if (result < 0) u32(0) else u32(result) & u32(255)
}

trusted fun esp32LwipPbufPutAt(
    first: u32,
    rawOffset: u32,
    value: u32
): void {
    val offsetCell = nativeStackAllocate(2)
    val packet = esp32LwipPbufSkip(
        first, rawOffset & u32(65535), u32(offsetCell)
    )
    if (packet == u32(0)) return
    val offset = u32(ablaUnsafeLoadU16(
        nativePointerFromAddress(offsetCell)
    )) & u32(65535)
    if (offset < esp32LwipPbufLoadU16(packet + u32(10))) {
        esp32LwipPbufStoreU8(
            esp32LwipPbufLoadU32(packet + u32(4)) + offset, value
        )
    }
    return
}

trusted fun esp32LwipPbufMemoryCompare(
    first: u32,
    rawOffset: u32,
    memory: u32,
    rawLength: u32
): u32 {
    val offset = rawOffset & u32(65535)
    val length = rawLength & u32(65535)
    if (esp32LwipPbufLoadU16(first + u32(8)) < offset + length) {
        return u32(65535)
    }
    var index = u32(0)
    while (index < length) {
        if (esp32LwipPbufGetAt(first, offset + index) !=
            u32(embeddedIpTextByte(memory + index))) {
            val bounded = if (index > u32(65534)) u32(65534) else index
            return (bounded + u32(1)) & u32(65535)
        }
        index = index + u32(1)
    }
    return u32(0)
}

trusted fun esp32LwipPbufMemoryFind(
    first: u32,
    memory: u32,
    rawLength: u32,
    rawStartOffset: u32
): u32 {
    val length = rawLength & u32(65535)
    var offset = rawStartOffset & u32(65535)
    val totalLength = esp32LwipPbufLoadU16(first + u32(8))
    if (totalLength < offset + length) return u32(65535)
    val last = (totalLength - length) & u32(65535)
    while (offset <= last) {
        if (esp32LwipPbufMemoryCompare(
            first, offset, memory, length
        ) == u32(0)) return offset
        offset = (offset + u32(1)) & u32(65535)
    }
    return u32(65535)
}

trusted fun esp32LwipPbufStringFind(first: u32, text: u32): u32 {
    if (text == u32(0) || embeddedIpTextByte(text) == 0 ||
        esp32LwipPbufLoadU16(first + u32(8)) == u32(65535)) {
        return u32(65535)
    }
    val length = embeddedLwipStringLength(text)
    if (length > u32(65534)) return u32(65535)
    return esp32LwipPbufMemoryFind(first, text, length, u32(0))
}

trusted fun esp32LwipPbufCopyPartialPbuf(
    destinationFirst: u32,
    sourceFirst: u32,
    rawLength: u32,
    rawDestinationOffset: u32
): u32 {
    val length = rawLength & u32(65535)
    val destinationStartOffset = rawDestinationOffset & u32(65535)
    if (sourceFirst == u32(0) ||
        esp32LwipPbufLoadU16(sourceFirst + u32(8)) < length) {
        return u32(240)
    }
    if (destinationFirst == u32(0) ||
        esp32LwipPbufLoadU16(destinationFirst + u32(8)) <
            destinationStartOffset + length) {
        return u32(240)
    }

    var destination = destinationFirst
    var source = sourceFirst
    var destinationOffset = destinationStartOffset
    var sourceOffset = u32(0)
    var remaining = length
    while (remaining != u32(0)) {
        if (destination == u32(0) || source == u32(0)) return u32(240)

        val destinationLength = esp32LwipPbufLoadU16(
            destination + u32(10)
        )
        val sourceLength = esp32LwipPbufLoadU16(source + u32(10))
        if (destinationOffset > destinationLength ||
            sourceOffset > sourceLength) return u32(240)

        val destinationAvailable = destinationLength - destinationOffset
        val sourceAvailable = sourceLength - sourceOffset
        var amount = if (destinationAvailable < sourceAvailable)
            destinationAvailable else sourceAvailable
        if (remaining < amount) amount = remaining
        ablaUnsafeCopyMemory(
            int(esp32LwipPbufLoadU32(destination + u32(4)) +
                destinationOffset),
            int(esp32LwipPbufLoadU32(source + u32(4)) + sourceOffset),
            int(amount)
        )
        destinationOffset = destinationOffset + amount
        sourceOffset = sourceOffset + amount
        remaining = remaining - amount

        if (sourceOffset == sourceLength) {
            val next = esp32LwipPbufLoadU32(source)
            if (esp32LwipPbufLoadU16(source + u32(8)) == sourceLength &&
                next != u32(0)) return u32(250)
            source = next
            sourceOffset = u32(0)
        }
        if (destinationOffset == destinationLength) {
            val next = esp32LwipPbufLoadU32(destination)
            if (esp32LwipPbufLoadU16(destination + u32(8)) ==
                destinationLength && next != u32(0)) return u32(250)
            destination = next
            destinationOffset = u32(0)
        }
    }
    return u32(0)
}

trusted fun esp32LwipPbufCopy(destination: u32, source: u32): u32 {
    if (source == u32(0)) return u32(240)
    return esp32LwipPbufCopyPartialPbuf(
        destination,
        source,
        esp32LwipPbufLoadU16(source + u32(8)),
        u32(0)
    )
}

trusted fun esp32LwipPbufCopyPartial(
    first: u32,
    destination: u32,
    rawLength: u32,
    rawOffset: u32
): u32 {
    if (first == u32(0) || destination == u32(0)) return u32(0)
    var packet = first
    var offset = rawOffset & u32(65535)
    var remaining = rawLength & u32(65535)
    var copied = u32(0)
    while (packet != u32(0) && remaining != u32(0)) {
        val packetLength = esp32LwipPbufLoadU16(packet + u32(10))
        if (offset >= packetLength) {
            offset = (offset - packetLength) & u32(65535)
        } else {
            val available = packetLength - offset
            val amount = if (remaining < available) remaining else available
            ablaUnsafeCopyMemory(
                int(destination + copied),
                int(esp32LwipPbufLoadU32(packet + u32(4)) + offset),
                int(amount)
            )
            copied = (copied + amount) & u32(65535)
            remaining = (remaining - amount) & u32(65535)
            offset = u32(0)
        }
        packet = esp32LwipPbufLoadU32(packet)
    }
    return copied
}

trusted fun esp32LwipPbufClone(
    layer: u32,
    typeInternal: u32,
    source: u32
): u32 {
    if (source == u32(0)) return u32(0)
    val clone = esp32LwipPbufAllocate(
        layer,
        esp32LwipPbufLoadU16(source + u32(8)),
        typeInternal
    )
    if (clone == u32(0)) return u32(0)
    if (esp32LwipPbufCopy(clone, source) != u32(0)) {
        val ignored = esp32LwipPbufFree(clone)
        return u32(0)
    }
    return clone
}

trusted fun esp32LwipPbufCoalesce(packet: u32, layer: u32): u32 {
    if (packet == u32(0) || esp32LwipPbufLoadU32(packet) == u32(0)) {
        return packet
    }
    val coalesced = esp32LwipPbufClone(layer, u32(640), packet)
    if (coalesced == u32(0)) return packet
    val ignored = esp32LwipPbufFree(packet)
    return coalesced
}
