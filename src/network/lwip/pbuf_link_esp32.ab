import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipPbufInternals(): bool {
    if (!internalFunction("esp32LwipPbufAllocateReference", "pbuf_alloc_reference")) return false
    if (!internalFunction("esp32LwipPbufAllocatedCustom", "pbuf_alloced_custom")) return false
    if (!internalFunction("esp32LwipPbufAddHeader", "pbuf_add_header")) return false
    if (!internalFunction("esp32LwipPbufAddHeaderForce", "pbuf_add_header_force")) return false
    if (!internalFunction("esp32LwipPbufRemoveHeader", "pbuf_remove_header")) return false
    if (!internalFunction("esp32LwipPbufHeader", "pbuf_header")) return false
    if (!internalFunction("esp32LwipPbufHeaderForce", "pbuf_header_force")) return false
    if (!internalFunction("esp32LwipPbufFree", "pbuf_free")) return false
    if (!internalFunction("esp32LwipPbufAllocate", "pbuf_alloc")) return false
    if (!internalFunction("esp32LwipPbufReallocate", "pbuf_realloc")) return false
    if (!internalFunction("esp32LwipPbufFreeHeader", "pbuf_free_header")) return false
    if (!internalFunction("esp32LwipPbufChainLength", "pbuf_clen")) return false
    if (!internalFunction("esp32LwipPbufReference", "pbuf_ref")) return false
    if (!internalFunction("esp32LwipPbufConcatenate", "pbuf_cat")) return false
    if (!internalFunction("esp32LwipPbufChain", "pbuf_chain")) return false
    if (!internalFunction("esp32LwipPbufDechain", "pbuf_dechain")) return false
    if (!internalFunction("esp32LwipPbufCopyPartialPbuf", "pbuf_copy_partial_pbuf")) return false
    if (!internalFunction("esp32LwipPbufCopy", "pbuf_copy")) return false
    if (!internalFunction("esp32LwipPbufCopyPartial", "pbuf_copy_partial")) return false
    if (!internalFunction("esp32LwipPbufGetContiguous", "pbuf_get_contiguous")) return false
    if (!internalFunction("esp32LwipPbufSkip", "pbuf_skip")) return false
    if (!internalFunction("esp32LwipPbufTake", "pbuf_take")) return false
    if (!internalFunction("esp32LwipPbufTakeAt", "pbuf_take_at")) return false
    if (!internalFunction("esp32LwipPbufClone", "pbuf_clone")) return false
    if (!internalFunction("esp32LwipPbufCoalesce", "pbuf_coalesce")) return false
    if (!internalFunction("esp32LwipPbufTryGetAt", "pbuf_try_get_at")) return false
    if (!internalFunction("esp32LwipPbufGetAt", "pbuf_get_at")) return false
    if (!internalFunction("esp32LwipPbufPutAt", "pbuf_put_at")) return false
    if (!internalFunction("esp32LwipPbufMemoryCompare", "pbuf_memcmp")) return false
    if (!internalFunction("esp32LwipPbufMemoryFind", "pbuf_memfind")) return false
    if (!internalFunction("esp32LwipPbufStringFind", "pbuf_strstr")) return false
    true
}
