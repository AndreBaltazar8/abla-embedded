@inline
trusted fun esp32InternalTcpInputAcknowledge(pcb: u32): void {
    val flags = esp32InternalTcpInputLoadU16(pcb + u32(70))
    if ((flags & u32(1)) != u32(0)) {
        esp32InternalTcpInputStoreU16(pcb + u32(70), (flags & u32(65534)) | u32(2))
    } else {
        esp32InternalTcpInputStoreU16(pcb + u32(70), flags | u32(1))
    }
}

@inline
