    val inputNetif = esp32InternalTcpInputLoadU32(esp32Data_ip_data_48d8350b61 + u32(4))
    index == ((esp32InternalTcpInputLoadU8(inputNetif + u32(234)) + u32(1)) & u32(255))
}

