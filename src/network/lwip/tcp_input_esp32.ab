            esp32Data_tcp_active_pcbs_ae33bb9f54,
            esp32InternalTcpInputLoadU32(pcb + u32(52))
        )
    } else {
        while (current != u32(0)) {
            val next = esp32InternalTcpInputLoadU32(current + u32(52))
            if (next == pcb) {
                esp32InternalTcpInputStoreU32(
                    current + u32(52),
                    esp32InternalTcpInputLoadU32(pcb + u32(52))
                )
                current = u32(0)
            } else {
                current = next
            }
        }
    }
    esp32InternalTcpInputStoreU32(pcb + u32(52), u32(0))
    esp32InternalTcpInputStoreU8(esp32Data_tcp_active_pcbs_changed_ed35697a30, u32(1))
    esp32InternalTcpInputStoreU32(pcb + u32(60), u32(10))
    esp32InternalTcpInputStoreU32(
        pcb + u32(52),
        esp32InternalTcpInputLoadU32(esp32Data_tcp_tw_pcbs_e6864109a6)
    )
    esp32InternalTcpInputStoreU32(esp32Data_tcp_tw_pcbs_e6864109a6, pcb)
    esp32RecoveredTcpTimerNeeded(
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0)
    )
    return
}

