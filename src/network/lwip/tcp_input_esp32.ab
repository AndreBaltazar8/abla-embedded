@inline
trusted fun esp32InternalTcpInputAddressEqual(left: u32, right: u32): bool {
    val addressType = esp32InternalTcpInputLoadU8(left + u32(20))
    if (addressType != esp32InternalTcpInputLoadU8(right + u32(20))) return false
    if (esp32InternalTcpInputLoadU32(left) != esp32InternalTcpInputLoadU32(right)) return false
    if (addressType != u32(6)) return true
