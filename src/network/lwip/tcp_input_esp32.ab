@inline
fun esp32InternalTcpInputInitialCongestionWindow(mss: u32): u32 {
    val twiceMss = mss + mss
    val fourTimesMss = mss << u32(2)
    val lowerBound = if (twiceMss > u32(4380)) twiceMss else u32(4380)
    if (fourTimesMss < lowerBound) fourTimesMss else lowerBound
}

