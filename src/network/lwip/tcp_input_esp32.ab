        esp32InternalTcpInputLoadU32(address + u32(8)) == u32(0) &&
        esp32InternalTcpInputLoadU32(address + u32(12)) == u32(0)
}

@inline
trusted fun esp32InternalTcpInputNetifMatches(pcb: u32): bool {
    val index = esp32InternalTcpInputLoadU8(pcb + u32(48))
