        esp32InternalTcpInputLoadU32(left + u32(8)) == esp32InternalTcpInputLoadU32(right + u32(8)) &&
        esp32InternalTcpInputLoadU32(left + u32(12)) == esp32InternalTcpInputLoadU32(right + u32(12)) &&
        esp32InternalTcpInputLoadU8(left + u32(16)) == esp32InternalTcpInputLoadU8(right + u32(16))
}

@inline
trusted fun esp32InternalTcpInputAddressIsAny(address: u32): bool {
    if (esp32InternalTcpInputLoadU32(address) != u32(0)) return false
    if (esp32InternalTcpInputLoadU8(address + u32(20)) != u32(6)) return true
