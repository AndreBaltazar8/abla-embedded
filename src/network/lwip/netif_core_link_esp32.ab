import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipNetifCoreInternals(): bool {
    if (!internalFunction("esp32RecoveredNetifPoll", "netif_poll")) return false
    if (!internalFunction("esp32RecoveredNetifInput", "netif_input")) return false
    if (!internalFunction("esp32LwipNetifSetDefault", "netif_set_default")) return false
    if (!internalFunction("esp32RecoveredNetifLoopOutput", "netif_loop_output")) return false
    if (!internalFunction("esp32LwipNetifAllocateClientDataId", "netif_alloc_client_data_id")) return false
    if (!internalFunction("esp32LwipNetifGetIp6AddrMatch", "netif_get_ip6_addr_match")) return false
    if (!internalFunction("esp32LwipNetifGetByIndex", "netif_get_by_index")) return false
    if (!internalFunction("esp32LwipNetifIndexToName", "netif_index_to_name")) return false
    if (!internalFunction("esp32LwipNetifFind", "netif_find")) return false
    if (!internalFunction("esp32LwipNetifNameToIndex", "netif_name_to_index")) return false
    if (!internalFunction("esp32LwipNetifAddExtendedCallback", "netif_add_ext_callback")) return false
    if (!internalFunction("esp32LwipNetifRemoveExtendedCallback", "netif_remove_ext_callback")) return false
    if (!internalFunction("esp32LwipNetifInvokeExtendedCallbacks", "netif_invoke_ext_callback")) return false
    if (!internalFunction("esp32RecoveredNetifSetIpaddr", "netif_set_ipaddr")) return false
    if (!internalFunction("esp32RecoveredNetifSetNetmask", "netif_set_netmask")) return false
    if (!internalFunction("esp32RecoveredNetifSetGw", "netif_set_gw")) return false
    if (!internalFunction("esp32RecoveredNetifSetAddr", "netif_set_addr")) return false
    if (!internalFunction("esp32RecoveredNetifAdd", "netif_add")) return false
    if (!internalFunction("esp32RecoveredNetifAddNoaddr", "netif_add_noaddr")) return false
    if (!internalFunction("esp32RecoveredNetifSetUp", "netif_set_up")) return false
    if (!internalFunction("esp32RecoveredNetifSetDown", "netif_set_down")) return false
    if (!internalFunction("esp32RecoveredNetifRemove", "netif_remove")) return false
    if (!internalFunction("esp32RecoveredNetifSetLinkUp", "netif_set_link_up")) return false
    if (!internalFunction("esp32RecoveredNetifInit", "netif_init")) return false
    if (!internalFunction("esp32RecoveredNetifSetLinkDown", "netif_set_link_down")) return false
    if (!internalFunction("esp32RecoveredNetifIp6AddrSetParts", "netif_ip6_addr_set_parts")) return false
    if (!internalFunction("esp32RecoveredNetifIp6AddrSet", "netif_ip6_addr_set")) return false
    if (!internalFunction("esp32RecoveredNetifIp6AddrSetState", "netif_ip6_addr_set_state")) return false
    if (!internalFunction("esp32RecoveredNetifCreateIp6LinklocalAddress", "netif_create_ip6_linklocal_address")) return false
    if (!internalFunction("esp32RecoveredNetifAddIp6Address", "netif_add_ip6_address")) return false
    true
}
