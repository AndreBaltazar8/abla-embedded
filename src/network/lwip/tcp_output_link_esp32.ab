import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipTcpOutputInternals(): bool {
    if (!internalFunction("esp32RecoveredTcpWrite", "tcp_write")) return false
    if (!internalFunction("esp32RecoveredTcpSplitUnsentSeg", "tcp_split_unsent_seg")) return false
    if (!internalFunction("esp32RecoveredTcpEnqueueFlags", "tcp_enqueue_flags")) return false
    if (!internalFunction("esp32RecoveredTcpSendFin", "tcp_send_fin")) return false
    if (!internalFunction("esp32RecoveredTcpRexmitRtoPrepare", "tcp_rexmit_rto_prepare")) return false
    if (!internalFunction("esp32RecoveredTcpRexmit", "tcp_rexmit")) return false
    if (!internalFunction("esp32RecoveredTcpRexmitFast", "tcp_rexmit_fast")) return false
    if (!internalFunction("esp32RecoveredTcpRst", "tcp_rst")) return false
    if (!internalFunction("esp32RecoveredTcpRstNetif", "tcp_rst_netif")) return false
    if (!internalFunction("esp32RecoveredTcpSendEmptyAck", "tcp_send_empty_ack")) return false
    if (!internalFunction("esp32RecoveredTcpOutput", "tcp_output")) return false
    if (!internalFunction("esp32RecoveredTcpRexmitRtoCommit", "tcp_rexmit_rto_commit")) return false
    if (!internalFunction("esp32RecoveredTcpRexmitRto", "tcp_rexmit_rto")) return false
    if (!internalFunction("esp32RecoveredTcpKeepalive", "tcp_keepalive")) return false
    if (!internalFunction("esp32RecoveredTcpZeroWindowProbe", "tcp_zero_window_probe")) return false
    true
}
