import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipNeighborDiscoveryIpv6Internals(): bool {
    if (!internalFunction("esp32RecoveredNd6Input", "nd6_input")) return false
    if (!internalFunction("esp32RecoveredNd6Tmr", "nd6_tmr")) return false
    if (!internalFunction("esp32RecoveredNd6ClearDestinationCache", "nd6_clear_destination_cache")) return false
    if (!internalFunction("esp32RecoveredNd6FindRoute", "nd6_find_route")) return false
    if (!internalFunction("esp32RecoveredNd6GetNextHopAddrOrQueue", "nd6_get_next_hop_addr_or_queue")) return false
    if (!internalFunction("esp32RecoveredNd6GetDestinationMtu", "nd6_get_destination_mtu")) return false
    if (!internalFunction("esp32RecoveredNd6ReachabilityHint", "nd6_reachability_hint")) return false
    if (!internalFunction("esp32RecoveredNd6CleanupNetif", "nd6_cleanup_netif")) return false
    if (!internalFunction("esp32RecoveredNd6AdjustMldMembership", "nd6_adjust_mld_membership")) return false
    if (!internalFunction("esp32RecoveredNd6RestartNetif", "nd6_restart_netif")) return false
    true
}
