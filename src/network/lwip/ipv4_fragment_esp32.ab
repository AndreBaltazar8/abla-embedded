import "pbuf_basic_esp32.ab"
import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

@inline
trusted fun esp32Ip4FragmentLoadU8(address:u32):u32=
    u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32Ip4FragmentStoreU8(address:u32,value:u32):void=
    ablaUnsafeStoreU8(nativePointerFromAddress(int(address)),int(value))

@inline
trusted fun esp32Ip4FragmentLoadU16(address:u32):u32=
    u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32Ip4FragmentLoadU32(address:u32):u32=
    u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(address))))

@inline
trusted fun esp32Ip4FragmentNetworkU16(address:u32):u32=
    (esp32Ip4FragmentLoadU8(address)<<u32(8))|
        esp32Ip4FragmentLoadU8(address+u32(1))

@inline
trusted fun esp32Ip4FragmentStoreNetworkU16(address:u32,value:u32):void {
    esp32Ip4FragmentStoreU8(address,value>>>u32(8))
    esp32Ip4FragmentStoreU8(address+u32(1),value)
}

trusted fun esp32LwipIp4Fragment(packet:u32,networkInterface:u32,destination:u32):u32 {
    val mtu=esp32Ip4FragmentLoadU16(networkInterface+u32(220))
    if(mtu<=u32(20)) return u32(250)
    val fragmentsPerMtu=(mtu-u32(20))/u32(8)
    if(fragmentsPerMtu==u32(0)) return u32(250)
    val originalHeader=esp32Ip4FragmentLoadU32(packet+u32(4))
    if((esp32Ip4FragmentLoadU8(originalHeader)&u32(15))<<u32(2)!=u32(20)) {
        return u32(250)
    }
    if(esp32Ip4FragmentLoadU16(packet+u32(10))<u32(20)) return u32(250)

    val originalOffset=esp32Ip4FragmentNetworkU16(originalHeader+u32(6))
    var offset=originalOffset&u32(0x1fff)
    val originalMoreFragments=originalOffset&u32(0x2000)
    var remaining=(esp32Ip4FragmentLoadU16(packet+u32(8))-u32(20))&u32(0xffff)
    var packetOffset=u32(20)

    while(remaining!=u32(0)) {
        val capacity=(fragmentsPerMtu<<u32(3))&u32(0xffff)
        val fragmentSize=if(remaining<capacity) remaining else capacity
        val fragment=esp32LwipPbufAllocate(u32(54),fragmentSize,u32(640))
        if(fragment==u32(0)) return u32(255)
        val payload=esp32Ip4FragmentLoadU32(fragment+u32(4))
        val copied=esp32LwipPbufCopyPartial(
            packet,payload,fragmentSize,packetOffset)
        packetOffset=(packetOffset+copied)&u32(0xffff)
        if(esp32LwipPbufAddHeader(fragment,u32(20))!=u32(0)) {
            esp32LwipPbufFree(fragment)
            return u32(255)
        }

        val header=esp32Ip4FragmentLoadU32(fragment+u32(4))
        freestandingCopy(header,originalHeader,u32(20))
        var fragmentOffset=offset&u32(0x1fff)
        val last=remaining<=mtu-u32(20)
        if(!last||originalMoreFragments!=u32(0)) {
            fragmentOffset=fragmentOffset|u32(0x2000)
        }
        esp32Ip4FragmentStoreNetworkU16(header+u32(6),fragmentOffset)
        esp32Ip4FragmentStoreNetworkU16(
            header+u32(2),(fragmentSize+u32(20))&u32(0xffff))
        esp32Ip4FragmentStoreU8(header+u32(10),u32(0))
        esp32Ip4FragmentStoreU8(header+u32(11),u32(0))
        val checksum=esp32RecoveredInetChksum(header,u32(20),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
            u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
        esp32Ip4FragmentStoreU8(header+u32(10),checksum)
        esp32Ip4FragmentStoreU8(header+u32(11),checksum>>>u32(8))

        val outputFunction=esp32Ip4FragmentLoadU32(networkInterface+u32(180))
        val ignored=u64(ablaUnsafeCallI64I32I32I32(
            int(outputFunction),int(networkInterface),int(fragment),int(destination)))
        esp32LwipPbufFree(fragment)
        remaining=(remaining-fragmentSize)&u32(0xffff)
        offset=(offset+fragmentsPerMtu)&u32(0xffff)
    }
    u32(0)
}

trusted fun esp32RecoveredIp4Frag(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LwipIp4Fragment(a2,a3,a4)
