import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipSntpCore(): bool {
    if (!internalFunction("esp32RecoveredSntpEnabled", "sntp_enabled")) return false
    if (!internalFunction("esp32RecoveredSntpGetkodreceived", "sntp_getkodreceived")) return false
    if (!internalFunction("esp32RecoveredSntpGetoperatingmode", "sntp_getoperatingmode")) return false
    if (!internalFunction("esp32RecoveredSntpGetreachability", "sntp_getreachability")) return false
    if (!internalFunction("esp32RecoveredSntpGetserver", "sntp_getserver")) return false
    if (!internalFunction("esp32RecoveredSntpGetservername", "sntp_getservername")) return false
    if (!internalFunction("esp32RecoveredSntpInit", "sntp_init")) return false
    if (!internalFunction("esp32RecoveredSntpSetoperatingmode", "sntp_setoperatingmode")) return false
    if (!internalFunction("esp32RecoveredSntpSetserver", "sntp_setserver")) return false
    if (!internalFunction("esp32RecoveredSntpSetservername", "sntp_setservername")) return false
    if (!internalFunction("esp32RecoveredSntpStop", "sntp_stop")) return false
    true
}
