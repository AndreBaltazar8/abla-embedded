// lwIP's complete FreeRTOS sys_arch contract, expressed as structured Abla.
// The queue/task functions below are also Abla implementations; these narrow
// helpers only remove the old recovered 16-register calling shape locally.
val esp32LwipSysOk = u32(0)
val esp32LwipSysMemoryError = u32(255)
val esp32LwipSysNeedSchedule = u32(123)
val esp32LwipSysTimeout = u32(0xffffffff)
val esp32LwipSysWaitForever = u32(0xffffffff)
val esp32LwipSysSemaphoreBytes = u32(84)
val esp32LwipSysHeapCapabilities = u32(2052)

val esp32LwipProtectMutexStorage = nativeStaticAllocate(4)
val esp32LwipProtectMutex = u32(esp32LwipProtectMutexStorage)
val esp32LwipThreadSemaphoreKeyStorage = nativeStaticAllocate(4)
val esp32LwipThreadSemaphoreKey = u32(
    esp32LwipThreadSemaphoreKeyStorage
)
val esp32LwipTcpipTaskStorage = nativeStaticAllocate(4)
val esp32LwipTcpipTask = u32(esp32LwipTcpipTaskStorage)

@inline trusted fun esp32LwipSysLoad(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline trusted fun esp32LwipSysStore(
    address: u32, value: u32
): void = ablaUnsafeStoreU32(
    nativePointerFromAddress(int(address)), int(value)
)

trusted fun esp32LwipQueueCreateMutex(): u32 =
    esp32RecoveredXQueueCreateMutex(
        u32(1),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LwipQueueCreateStatic(
    length: u32, itemBytes: u32, items: u32,
    queueStorage: u32, kind: u32
): u32 = esp32RecoveredXQueueGenericCreateStatic(
    length,itemBytes,items,queueStorage,kind,u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LwipQueueSend(
    queue: u32, item: u32, ticks: u32, position: u32
): u32 = esp32RecoveredXQueueGenericSend(
    queue,item,ticks,position,u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LwipQueueSendIsr(
    queue: u32, item: u32, woken: u32, position: u32
): u32 = esp32RecoveredXQueueGenericSendFromISR(
    queue,item,woken,position,u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LwipQueueGiveIsr(
    queue: u32, woken: u32
): u32 = esp32RecoveredXQueueGiveFromISR(
    queue,woken,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LwipQueueTake(
    queue: u32, ticks: u32
): u32 = esp32RecoveredXQueueSemaphoreTake(
    queue,ticks,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LwipQueueReceive(
    queue: u32, output: u32, ticks: u32
): u32 = esp32RecoveredXQueueReceive(
    queue,output,ticks,u32(0),u32(0),u32(0),u32(0),u32(0),
    u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
)

trusted fun esp32LwipQueueDelete(queue: u32): void {
    esp32RecoveredVQueueDelete(
        queue,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    return
}

trusted fun esp32LwipQueueWaiting(queue: u32): u32 =
    esp32RecoveredUxQueueMessagesWaiting(
        queue,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LwipCurrentTask(): u32 =
    esp32RecoveredXTaskGetCurrentTaskHandle(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LwipTickCount(): u32 =
    esp32RecoveredXTaskGetTickCount(
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LwipPthreadGetSpecific(): u32 =
    esp32RecoveredPthreadGetspecific(
        esp32LwipSysLoad(esp32LwipThreadSemaphoreKey),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )

trusted fun esp32LwipPthreadSetSpecific(value: u32): void {
    esp32RecoveredPthreadSetspecific(
        esp32LwipSysLoad(esp32LwipThreadSemaphoreKey),value,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    return
}

trusted fun esp32LwipSysMutexNew(output: u32): u32 {
    val mutex = esp32LwipQueueCreateMutex()
    esp32LwipSysStore(output, mutex)
    return if (mutex == u32(0))
        esp32LwipSysMemoryError else esp32LwipSysOk
}

trusted fun esp32LwipSysMutexLock(mutex: u32): void {
    if (esp32LwipQueueTake(
        esp32LwipSysLoad(mutex), esp32LwipSysWaitForever
    ) != u32(1)) ablaRuntimeTrap()
}

trusted fun esp32LwipSysMutexUnlock(mutex: u32): void {
    if (esp32LwipQueueSend(
        esp32LwipSysLoad(mutex),u32(0),u32(0),u32(0)
    ) != u32(1)) ablaRuntimeTrap()
}

trusted fun esp32LwipSysMutexFree(mutex: u32): void {
    val queue = esp32LwipSysLoad(mutex)
    if (queue != u32(0)) esp32LwipQueueDelete(queue)
    esp32LwipSysStore(mutex, u32(0))
}

trusted fun esp32LwipSysSemNew(
    semaphore: u32, initialCount: u32
): u32 {
    if (initialCount > u32(1)) ablaRuntimeTrap()
    val queue = esp32LwipQueueCreateStatic(
        u32(1),u32(0),u32(0),semaphore,u32(3)
    )
    if (queue != semaphore) return esp32LwipSysMemoryError
    if (initialCount == u32(1) &&
        esp32LwipQueueSend(queue,u32(0),u32(0),u32(0)) != u32(1)) {
        return esp32LwipSysMemoryError
    }
    return esp32LwipSysOk
}

trusted fun esp32LwipSysSemSignal(semaphore: u32): void {
    if (esp32LwipQueueSend(
        semaphore,u32(0),u32(0),u32(0)
    ) >= u32(2)) ablaRuntimeTrap()
}

trusted fun esp32LwipSysSemSignalIsr(semaphore: u32): u32 {
    val woken = u32(nativeStackAllocate(4))
    esp32LwipSysStore(woken, u32(0))
    esp32LwipQueueGiveIsr(semaphore, woken)
    return if (esp32LwipSysLoad(woken) == u32(1)) u32(1) else u32(0)
}

trusted fun esp32LwipSysArchSemWait(
    semaphore: u32, timeout: u32
): u32 {
    val ticks = if (timeout == u32(0))
        esp32LwipSysWaitForever else timeout + u32(1)
    return if (esp32LwipQueueTake(semaphore, ticks) == u32(1))
        u32(0) else esp32LwipSysTimeout
}

trusted fun esp32LwipSysSemFree(semaphore: u32): void {
    esp32LwipQueueDelete(semaphore)
    freestandingSet(semaphore, i32(0), esp32LwipSysSemaphoreBytes)
    return
}

trusted fun esp32LwipSysMboxNew(
    output: u32, length: u32
): u32 {
    val allocation = esp32HeapCapsMalloc(
        (length + u32(21)) * u32(4),
        esp32LwipSysHeapCapabilities
    )
    esp32LwipSysStore(output, allocation)
    if (allocation == u32(0)) return esp32LwipSysMemoryError
    val queue = esp32LwipQueueCreateStatic(
        length,u32(4),allocation + esp32LwipSysSemaphoreBytes,
        allocation,u32(0)
    )
    if (queue != allocation) {
        esp32HeapCapsFree(allocation)
        esp32LwipSysStore(output, u32(0))
        return esp32LwipSysMemoryError
    }
    return esp32LwipSysOk
}

trusted fun esp32LwipSysMboxPost(
    mailbox: u32, message: u32
): void {
    val item = u32(nativeStackAllocate(4))
    esp32LwipSysStore(item, message)
    if (esp32LwipQueueSend(
        esp32LwipSysLoad(mailbox),item,esp32LwipSysWaitForever,u32(0)
    ) != u32(1)) ablaRuntimeTrap()
}

trusted fun esp32LwipSysMboxTrypost(
    mailbox: u32, message: u32
): u32 {
    val item = u32(nativeStackAllocate(4))
    esp32LwipSysStore(item, message)
    return if (esp32LwipQueueSend(
        esp32LwipSysLoad(mailbox),item,u32(0),u32(0)
    ) == u32(1)) esp32LwipSysOk else esp32LwipSysMemoryError
}

trusted fun esp32LwipSysMboxTrypostFromIsr(
    mailbox: u32, message: u32
): u32 {
    val frame = u32(nativeStackAllocate(8))
    esp32LwipSysStore(frame, message)
    esp32LwipSysStore(frame + u32(4), u32(0))
    val result = esp32LwipQueueSendIsr(
        esp32LwipSysLoad(mailbox),frame,frame + u32(4),u32(0)
    )
    if (result != u32(1)) {
        if (result != u32(0)) ablaRuntimeTrap()
        return esp32LwipSysMemoryError
    }
    return if (esp32LwipSysLoad(frame + u32(4)) == u32(1))
        esp32LwipSysNeedSchedule else esp32LwipSysOk
}

trusted fun esp32LwipSysArchMboxFetch(
    mailbox: u32, output: u32, timeout: u32
): u32 {
    val temporary = u32(nativeStackAllocate(4))
    val destination = if (output == u32(0)) temporary else output
    val ticks = if (timeout == u32(0))
        esp32LwipSysWaitForever else timeout
    if (esp32LwipQueueReceive(
        esp32LwipSysLoad(mailbox),destination,ticks
    ) != u32(1)) {
        esp32LwipSysStore(destination, u32(0))
        return esp32LwipSysTimeout
    }
    return u32(0)
}

trusted fun esp32LwipSysArchMboxTryfetch(
    mailbox: u32, output: u32
): u32 {
    val temporary = u32(nativeStackAllocate(4))
    val destination = if (output == u32(0)) temporary else output
    if (esp32LwipQueueReceive(
        esp32LwipSysLoad(mailbox),destination,u32(0)
    ) != u32(1)) {
        esp32LwipSysStore(destination, u32(0))
        return esp32LwipSysTimeout
    }
    return u32(0)
}

trusted fun esp32LwipSysMboxFree(mailbox: u32): void {
    if (mailbox == u32(0)) return
    val queue = esp32LwipSysLoad(mailbox)
    if (queue == u32(0)) return
    if (esp32LwipQueueWaiting(queue) != u32(0)) ablaRuntimeTrap()
    esp32LwipQueueDelete(queue)
    esp32HeapCapsFree(queue)
    esp32LwipSysStore(mailbox, u32(0))
}

trusted fun esp32LwipSysThreadNew(
    name: u32, entry: u32, argument: u32,
    stackBytes: u32, priority: u32
): u32 {
    val output = u32(nativeStackAllocate(4))
    esp32LwipSysStore(output, u32(0))
    val result = esp32RecoveredXTaskCreatePinnedToCore(
        entry,name,stackBytes,argument,priority,output,
        u32(0x7fffffff),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0)
    )
    return if (result == u32(1))
        esp32LwipSysLoad(output) else u32(0)
}

trusted fun esp32LwipSysThreadSemaphoreFree(semaphore: u32): void {
    if (semaphore == u32(0)) return
    esp32LwipQueueDelete(semaphore)
    esp32HeapCapsFree(semaphore)
}

trusted fun esp32LwipSysInit(): void {
    if (esp32LwipSysLoad(esp32LwipProtectMutex) == u32(0)) {
        esp32LwipSysMutexNew(esp32LwipProtectMutex)
    }
    esp32RecoveredPthreadKeyCreate(
        esp32LwipThreadSemaphoreKey,
        u32(nativeFunctionAddress(esp32LwipSysThreadSemaphoreFree)),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    esp32LwipVfsRegister()
}

trusted fun esp32LwipSysJiffies(): u32 = esp32LwipTickCount()
trusted fun esp32LwipSysNow(): u32 = esp32LwipTickCount()

trusted fun esp32LwipSysArchProtect(): u32 {
    if (esp32LwipSysLoad(esp32LwipProtectMutex) == u32(0)) {
        esp32LwipSysMutexNew(esp32LwipProtectMutex)
    }
    esp32LwipSysMutexLock(esp32LwipProtectMutex)
    return u32(1)
}

trusted fun esp32LwipSysArchUnprotect(level: u32): void {
    esp32LwipSysMutexUnlock(esp32LwipProtectMutex)
}

trusted fun esp32LwipSysThreadSemInit(): u32 {
    val semaphore = esp32HeapCapsMalloc(
        esp32LwipSysSemaphoreBytes,esp32LwipSysHeapCapabilities
    )
    if (semaphore == u32(0)) return u32(0)
    if (esp32LwipQueueCreateStatic(
        u32(1),u32(0),u32(0),semaphore,u32(3)
    ) != semaphore) {
        esp32HeapCapsFree(semaphore)
        return u32(0)
    }
    esp32LwipPthreadSetSpecific(semaphore)
    return semaphore
}

trusted fun esp32LwipSysThreadSemGet(): u32 {
    val semaphore = esp32LwipPthreadGetSpecific()
    return if (semaphore != u32(0))
        semaphore else esp32LwipSysThreadSemInit()
}

trusted fun esp32LwipSysThreadSemDeinit(): void {
    val semaphore = esp32LwipPthreadGetSpecific()
    if (semaphore != u32(0)) {
        esp32LwipSysThreadSemaphoreFree(semaphore)
        esp32LwipPthreadSetSpecific(u32(0))
    }
}

trusted fun esp32LwipSysDelayMs(milliseconds: u32): void {
    esp32RecoveredVTaskDelay(
        milliseconds,u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0)
    )
    return
}

trusted fun esp32LwipSysThreadTcpip(query: u32): u32 {
    if (query == u32(4)) {
        return if (esp32LwipSysLoad(esp32LwipTcpipTask) != u32(0))
            u32(1) else u32(0)
    }
    if (query == u32(3)) {
        if (esp32LwipSysLoad(esp32LwipTcpipTask) != u32(0)) {
            ablaRuntimeTrap()
        }
        esp32LwipSysStore(esp32LwipTcpipTask, esp32LwipCurrentTask())
        return u32(1)
    }
    if (query == u32(0)) {
        val ownerTask = esp32LwipSysLoad(esp32LwipTcpipTask)
        return if (ownerTask == u32(0) || ownerTask == esp32LwipCurrentTask())
            u32(1) else u32(0)
    }
    return u32(0)
}

