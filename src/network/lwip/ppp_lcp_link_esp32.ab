import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipPppLcpInternals(): bool {
    if (!internalFunction("esp32RecoveredLcpLowerup", "lcp_lowerup")) return false
    if (!internalFunction("esp32RecoveredLcpOpen", "lcp_open")) return false
    if (!internalFunction("esp32RecoveredLcpClose", "lcp_close")) return false
    if (!internalFunction("esp32RecoveredLcpLowerdown", "lcp_lowerdown")) return false
    if (!internalFunction("esp32RecoveredLcpSprotrej", "lcp_sprotrej")) return false
    true
}
