import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipPppAuthInternals(): bool {
    if (!internalFunction("esp32RecoveredLinkRequired", "link_required")) return false
    if (!internalFunction("esp32RecoveredLinkTerminated", "link_terminated")) return false
    if (!internalFunction("esp32RecoveredUpperLayersDown", "upper_layers_down")) return false
    if (!internalFunction("esp32RecoveredLinkDown", "link_down")) return false
    if (!internalFunction("esp32RecoveredContinueNetworks", "continue_networks")) return false
    if (!internalFunction("esp32RecoveredStartNetworks", "start_networks")) return false
    if (!internalFunction("esp32RecoveredLinkEstablished", "link_established")) return false
    if (!internalFunction("esp32RecoveredNpUp", "np_up")) return false
    if (!internalFunction("esp32RecoveredNpDown", "np_down")) return false
    if (!internalFunction("esp32RecoveredNpFinished", "np_finished")) return false
    true
}
