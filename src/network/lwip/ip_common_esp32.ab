import "shared_storage_esp32.ab"
val esp32Data_ip_addr_any_type_af9696b39aStorage = nativeStaticMutableBytes("\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x2e\x00\x00\x00")
val esp32Data_ip_addr_any_type_af9696b39aInitialized = esp32Data_ip_addr_any_type_af9696b39aStorage
val esp32Data_ip_addr_any_type_af9696b39a = u32(esp32Data_ip_addr_any_type_af9696b39aInitialized)

// Abla/LLVM implementation of lwIP generic IP text conversion and
// address-family dispatch. Only the linker-owned data records remain target
// assembly; no executable instruction body is hidden from LLVM here.
trusted fun esp32LwipIpCommonData(): void {
    // Static data is emitted by Abla above.
    return
}

trusted fun esp32LwipIpAddressToStaticText(address: u32): u32 {
    if (address == u32(0)) return u32(0)
    if (embeddedIpTextByte(address + u32(20)) == 6) {
        return embeddedIp6AddressToStaticText(address)
    }
    return embeddedIp4AddressToStaticText(address)
}

trusted fun esp32LwipIpAddressToText(
    address: u32,
    output: u32,
    outputLength: i32
): u32 {
    if (address == u32(0)) return u32(0)
    if (embeddedIpTextByte(address + u32(20)) == 6) {
        return embeddedIp6AddressToText(address, output, outputLength)
    }
    return embeddedIp4AddressToText(address, output, outputLength)
}

trusted fun esp32LwipIpAddressFromText(input: u32, output: u32): i32 {
    if (input == u32(0)) return 0

    var cursor = input
    var byte = embeddedIpTextByte(cursor)
    while (byte != 0 && byte != 46) {
        if (byte == 58) {
            if (output != u32(0)) {
                embeddedIpTextStoreByte(output + u32(20), u32(6))
            }
            return esp32LwipIp6AddressFromText(input, output)
        }
        cursor = cursor + u32(1)
        byte = embeddedIpTextByte(cursor)
    }

    if (output != u32(0)) {
        embeddedIpTextStoreByte(output + u32(20), u32(0))
    }
    return embeddedIp4AddressFromText(input, output)
}

trusted fun esp32LwipIpInput(packet: u32, networkInterface: u32): i32 {
    if (packet == u32(0)) return 250
    val payload = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(packet + u32(4)))
    ))
    val version = u32(embeddedIpTextByte(payload)) >> u32(4)
    if (version == u32(6)) {
        return i32(esp32RecoveredIp6Input(packet, networkInterface))
    }
    return i32(esp32RecoveredIp4Input(packet, networkInterface))
}
