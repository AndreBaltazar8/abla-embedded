import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipPppCoreInternals(): bool {
    if (!internalFunction("esp32RecoveredPppFree", "ppp_free")) return false
    if (!internalFunction("esp32RecoveredPppIoctl", "ppp_ioctl")) return false
    if (!internalFunction("esp32RecoveredPppInit", "ppp_init")) return false
    if (!internalFunction("esp32RecoveredPppInput", "ppp_input")) return false
    if (!internalFunction("esp32RecoveredPppWrite", "ppp_write")) return false
    if (!internalFunction("esp32RecoveredPppLinkTerminated", "ppp_link_terminated")) return false
    if (!internalFunction("esp32RecoveredNewPhase", "new_phase")) return false
    if (!internalFunction("esp32RecoveredPppConnect", "ppp_connect")) return false
    if (!internalFunction("esp32RecoveredPppClose", "ppp_close")) return false
    if (!internalFunction("esp32RecoveredPppNew", "ppp_new")) return false
    if (!internalFunction("esp32RecoveredPppStart", "ppp_start")) return false
    if (!internalFunction("esp32RecoveredPppLinkFailed", "ppp_link_failed")) return false
    if (!internalFunction("esp32RecoveredPppLinkEnd", "ppp_link_end")) return false
    if (!internalFunction("esp32RecoveredPppSendConfig", "ppp_send_config")) return false
    if (!internalFunction("esp32RecoveredPppRecvConfig", "ppp_recv_config")) return false
    if (!internalFunction("esp32RecoveredSifaddr", "sifaddr")) return false
    if (!internalFunction("esp32RecoveredCifaddr", "cifaddr")) return false
    if (!internalFunction("esp32RecoveredSdns", "sdns")) return false
    if (!internalFunction("esp32RecoveredCdns", "cdns")) return false
    if (!internalFunction("esp32RecoveredSifvjcomp", "sifvjcomp")) return false
    if (!internalFunction("esp32RecoveredSifup", "sifup")) return false
    if (!internalFunction("esp32RecoveredSifdown", "sifdown")) return false
    if (!internalFunction("esp32RecoveredGetMask", "get_mask")) return false
    if (!internalFunction("esp32RecoveredSif6addr", "sif6addr")) return false
    if (!internalFunction("esp32RecoveredCif6addr", "cif6addr")) return false
    if (!internalFunction("esp32RecoveredSif6up", "sif6up")) return false
    if (!internalFunction("esp32RecoveredSif6down", "sif6down")) return false
    if (!internalFunction("esp32RecoveredPppNetifSetMtu", "ppp_netif_set_mtu")) return false
    if (!internalFunction("esp32RecoveredPppNetifGetMtu", "ppp_netif_get_mtu")) return false
    true
}
