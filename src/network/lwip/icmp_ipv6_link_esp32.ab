import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipIcmpIpv6Internals(): bool {
    if (!internalFunction("esp32RecoveredIcmp6Input", "icmp6_input")) return false
    if (!internalFunction("esp32RecoveredIcmp6DestUnreach", "icmp6_dest_unreach")) return false
    if (!internalFunction("esp32RecoveredIcmp6PacketTooBig", "icmp6_packet_too_big")) return false
    if (!internalFunction("esp32RecoveredIcmp6TimeExceeded", "icmp6_time_exceeded")) return false
    if (!internalFunction("esp32RecoveredIcmp6TimeExceededWithAddrs", "icmp6_time_exceeded_with_addrs")) return false
    if (!internalFunction("esp32RecoveredIcmp6ParamProblem", "icmp6_param_problem")) return false
    true
}
