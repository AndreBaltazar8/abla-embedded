trusted fun esp32InternalIpv6OptionsAreValid(packet: u32, headerLength: u32, allowHomeAddress: bool): bool {
    val header = esp32InternalIpv6LoadU32(packet + u32(4))
    var offset = u32(2)
    while (offset < headerLength) {
        val option = header + offset
        val optionType = esp32InternalIpv6LoadU8(option)
        if (optionType == u32(0)) {
            offset = offset + u32(1)
        } else if (optionType == u32(1) || optionType == u32(5) || optionType == u32(194) ||
                   (allowHomeAddress && optionType == u32(201))) {
            offset = offset + u32(2) + esp32InternalIpv6LoadU8(option + u32(1))
        } else {
            val action = optionType >>> u32(6)
            if (action == u32(1)) return false
            if (action == u32(2)) {
                esp32InternalIpv6ParameterProblem(packet, u32(2), option)
                return false
            }
            if (action == u32(3)) {
                if (!esp32InternalIpv6AddressIsMulticast(esp32Data_ip_data_48d8350b61 + u32(44))) {
                    esp32InternalIpv6ParameterProblem(packet, u32(2), option)
                }
                return false
            }
            offset = offset + u32(2) + esp32InternalIpv6LoadU8(option + u32(1))
        }
    }
    return true
}

