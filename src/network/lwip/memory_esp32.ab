// Typed lwIP allocation facade. The ESP heap implementation remains a
// separately replaceable lower layer; lwIP itself contributes no assembly.

trusted fun esp32LwipMemInitialize(): void {
    return
}

trusted fun esp32LwipMemTrim(memory: u32, size: u32): u32 = memory

trusted fun esp32LwipMemAllocate(size: u32): u32 =
    esp32LibcMalloc(size)

trusted fun esp32LwipMemFree(memory: u32): void {
    if (memory != u32(0)) esp32LibcFree(memory)
    return
}

trusted fun esp32LwipMemFreeValue(memory: u32): u32 {
    esp32LwipMemFree(memory)
    u32(0)
}

trusted fun esp32LwipMemCallocate(count: u32, size: u32): u32 =
    esp32LibcCalloc(count, size)
