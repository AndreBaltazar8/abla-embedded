import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipDefinitionsInternals(): bool {
    if (!internalFunction("embeddedLwipHtons", "lwip_htons")) return false
    if (!internalFunction("embeddedLwipHtonl", "lwip_htonl")) return false
    if (!internalFunction("embeddedLwipStrnstr", "lwip_strnstr")) return false
    if (!internalFunction("embeddedLwipStricmp", "lwip_stricmp")) return false
    if (!internalFunction("embeddedLwipStrnicmp", "lwip_strnicmp")) return false
    if (!internalFunction("embeddedLwipStrnistr", "lwip_strnistr")) return false
    if (!internalFunction("embeddedLwipItoa", "lwip_itoa")) return false
    true
}
