import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipIgmpInternals(): bool {
    if (!internalFunction("esp32RecoveredIgmpInit", "igmp_init")) return false
    if (!internalFunction("esp32RecoveredIgmpStop", "igmp_stop")) return false
    if (!internalFunction("esp32RecoveredIgmpReportGroups", "igmp_report_groups")) return false
    if (!internalFunction("esp32RecoveredIgmpLookforGroup", "igmp_lookfor_group")) return false
    if (!internalFunction("esp32RecoveredIgmpStart", "igmp_start")) return false
    if (!internalFunction("esp32RecoveredIgmpInput", "igmp_input")) return false
    if (!internalFunction("esp32RecoveredIgmpJoingroupNetif", "igmp_joingroup_netif")) return false
    if (!internalFunction("esp32RecoveredIgmpJoingroup", "igmp_joingroup")) return false
    if (!internalFunction("esp32RecoveredIgmpLeavegroupNetif", "igmp_leavegroup_netif")) return false
    if (!internalFunction("esp32RecoveredIgmpLeavegroup", "igmp_leavegroup")) return false
    if (!internalFunction("esp32RecoveredIgmpTmr", "igmp_tmr")) return false
    true
}
