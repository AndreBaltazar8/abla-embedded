import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipDhcpInternals(): bool {
    if (!internalFunction("esp32RecoveredDhcpFineTimeoutCb", "dhcp_fine_timeout_cb")) return false
    if (!internalFunction("esp32RecoveredDhcpSetStruct", "dhcp_set_struct")) return false
    if (!internalFunction("esp32RecoveredDhcpCleanup", "dhcp_cleanup")) return false
    if (!internalFunction("esp32RecoveredDhcpInform", "dhcp_inform")) return false
    if (!internalFunction("esp32RecoveredDhcpNetworkChangedLinkUp", "dhcp_network_changed_link_up")) return false
    if (!internalFunction("esp32RecoveredDhcpRenew", "dhcp_renew")) return false
    if (!internalFunction("esp32RecoveredDhcpSuppliedAddress", "dhcp_supplied_address")) return false
    if (!internalFunction("esp32RecoveredDhcpReleaseAndStop", "dhcp_release_and_stop")) return false
    if (!internalFunction("esp32RecoveredDhcpStart", "dhcp_start")) return false
    if (!internalFunction("esp32RecoveredDhcpCoarseTmr", "dhcp_coarse_tmr")) return false
    if (!internalFunction("esp32RecoveredDhcpFineTmr", "dhcp_fine_tmr")) return false
    if (!internalFunction("esp32RecoveredDhcpRelease", "dhcp_release")) return false
    if (!internalFunction("esp32RecoveredDhcpStop", "dhcp_stop")) return false
    true
}
