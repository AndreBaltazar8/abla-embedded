import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipNetdbInternals(): bool {
    if (!internalFunction("esp32RecoveredLwipGethostbyname", "lwip_gethostbyname")) return false
    if (!internalFunction("esp32RecoveredLwipGethostbynameR", "lwip_gethostbyname_r")) return false
    if (!internalFunction("esp32RecoveredLwipFreeaddrinfo", "lwip_freeaddrinfo")) return false
    if (!internalFunction("esp32RecoveredLwipGetaddrinfo", "lwip_getaddrinfo")) return false
    true
}
