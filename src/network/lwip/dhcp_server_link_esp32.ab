import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipDhcpServerInternals(): bool {
    if (!internalFunction("esp32RecoveredDhcpsNew", "dhcps_new")) return false
    if (!internalFunction("esp32RecoveredDhcpsDelete", "dhcps_delete")) return false
    if (!internalFunction("esp32RecoveredDhcpsOptionInfo", "dhcps_option_info")) return false
    if (!internalFunction("esp32RecoveredDhcpsSetOptionInfo", "dhcps_set_option_info")) return false
    if (!internalFunction("esp32RecoveredNodeRemoveFromList", "node_remove_from_list")) return false
    if (!internalFunction("esp32RecoveredDhcpsPbufAlloc", "dhcps_pbuf_alloc")) return false
    if (!internalFunction("esp32RecoveredDhcpsSetNewLeaseCb", "dhcps_set_new_lease_cb")) return false
    if (!internalFunction("esp32RecoveredDhcpsStart", "dhcps_start")) return false
    if (!internalFunction("esp32RecoveredDhcpsStop", "dhcps_stop")) return false
    if (!internalFunction("esp32RecoveredDhcpSearchIpOnMac", "dhcp_search_ip_on_mac")) return false
    if (!internalFunction("esp32RecoveredDhcpsDnsSetserverByType", "dhcps_dns_setserver_by_type")) return false
    if (!internalFunction("esp32RecoveredDhcpsDnsSetserver", "dhcps_dns_setserver")) return false
    if (!internalFunction("esp32RecoveredDhcpsDnsGetserverByType", "dhcps_dns_getserver_by_type")) return false
    if (!internalFunction("esp32RecoveredDhcpsDnsGetserver", "dhcps_dns_getserver")) return false
    if (!internalFunction("esp32RecoveredDhcpsGetHostnameOnMac", "dhcps_get_hostname_on_mac")) return false
    true
}
