// Abla/LLVM implementation of lwIP internal-error to POSIX errno conversion.
//
// lwIP's err_t is an eight-bit signed value, but Xtensa's C ABI carries it in
// a full argument register. Keep that ABI-sized input here and explicitly
// recover the low signed byte. This replaces both the recovered instruction
// block and its private 68-byte lookup table with ordinary optimizable Abla.

// Original ABI symbol: err_to_errno
@inline
fun esp32RecoveredErrToErrno(rawError: i32): i32 {
    val error = i32(i8(rawError))
    val index = -error
    if (index < 0 || index > 15) return 5
    // Pack the original table into four compile-time scalar constants. LLVM
    // sees the select and variable shift and does not have to retain storage.
    // Four u32 words also avoid introducing a 64-bit shift helper on ESP32.
    val packed = if (index < 4) u32(191433728)
        else if (index < 8) u32(186021750)
        else if (index < 12) u32(2155837552)
        else u32(2154328575)
    val result = i32(
        (packed >> u32((index & i32(3)) * i32(8))) & u32(255)
    )
    return if (result == i32(255)) i32(-1) else result
}
