import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipNetbufInternals(): bool {
    if (!internalFunction("esp32RecoveredNetbufNew", "netbuf_new")) return false
    if (!internalFunction("esp32RecoveredNetbufDelete", "netbuf_delete")) return false
    if (!internalFunction("esp32RecoveredNetbufAlloc", "netbuf_alloc")) return false
    if (!internalFunction("esp32RecoveredNetbufFree", "netbuf_free")) return false
    if (!internalFunction("esp32RecoveredNetbufRef", "netbuf_ref")) return false
    if (!internalFunction("esp32RecoveredNetbufChain", "netbuf_chain")) return false
    if (!internalFunction("esp32RecoveredNetbufData", "netbuf_data")) return false
    if (!internalFunction("esp32RecoveredNetbufNext", "netbuf_next")) return false
    if (!internalFunction("esp32RecoveredNetbufFirst", "netbuf_first")) return false
    true
}
