import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipTimeoutsInternals(): bool {
    if (!internalFunction("esp32RecoveredSysTimeout", "sys_timeout")) return false
    if (!internalFunction("esp32RecoveredTcpTimerNeeded", "tcp_timer_needed")) return false
    if (!internalFunction("esp32RecoveredSysTimeoutsInit", "sys_timeouts_init")) return false
    if (!internalFunction("esp32RecoveredSysUntimeout", "sys_untimeout")) return false
    if (!internalFunction("esp32RecoveredSysTimeoutsDeinit", "sys_timeouts_deinit")) return false
    if (!internalFunction("esp32RecoveredSysCheckTimeouts", "sys_check_timeouts")) return false
    if (!internalFunction("esp32RecoveredSysRestartTimeouts", "sys_restart_timeouts")) return false
    if (!internalFunction("esp32RecoveredSysTimeoutsSleeptime", "sys_timeouts_sleeptime")) return false
    true
}
