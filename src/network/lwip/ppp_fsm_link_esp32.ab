import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipPppFsmInternals(): bool {
    if (!internalFunction("esp32RecoveredFsmInit", "fsm_init")) return false
    if (!internalFunction("esp32RecoveredFsmLowerup", "fsm_lowerup")) return false
    if (!internalFunction("esp32RecoveredFsmLowerdown", "fsm_lowerdown")) return false
    if (!internalFunction("esp32RecoveredFsmOpen", "fsm_open")) return false
    if (!internalFunction("esp32RecoveredFsmSdata", "fsm_sdata")) return false
    if (!internalFunction("esp32RecoveredFsmClose", "fsm_close")) return false
    if (!internalFunction("esp32RecoveredFsmProtreject", "fsm_protreject")) return false
    if (!internalFunction("esp32RecoveredFsmInput", "fsm_input")) return false
    true
}
