@inline
trusted fun esp32InternalTcpCoreStoreU32(address: u32, value: u32): void =
    ablaUnsafeStoreU32(nativePointerFromAddress(int(address)), int(value))

@inline
trusted fun esp32InternalTcpCoreAddressIsAny(address: u32): bool {
    if (esp32InternalTcpCoreLoadU8(address + u32(20)) == u32(6))
        return esp32InternalTcpCoreLoadU32(address) == u32(0) &&
            esp32InternalTcpCoreLoadU32(address + u32(4)) == u32(0) &&
            esp32InternalTcpCoreLoadU32(address + u32(8)) == u32(0) &&
            esp32InternalTcpCoreLoadU32(address + u32(12)) == u32(0)
    return esp32InternalTcpCoreLoadU32(address) == u32(0)
}

@inline
trusted fun esp32InternalTcpCoreAddressEqual(left: u32, right: u32): bool {
    val addressType = esp32InternalTcpCoreLoadU8(left + u32(20))
    if (addressType != esp32InternalTcpCoreLoadU8(right + u32(20))) return false
    if (addressType != u32(6))
        return esp32InternalTcpCoreLoadU32(left) == esp32InternalTcpCoreLoadU32(right)
    return esp32InternalTcpCoreLoadU32(left) == esp32InternalTcpCoreLoadU32(right) &&
        esp32InternalTcpCoreLoadU32(left + u32(4)) == esp32InternalTcpCoreLoadU32(right + u32(4)) &&
        esp32InternalTcpCoreLoadU32(left + u32(8)) == esp32InternalTcpCoreLoadU32(right + u32(8)) &&
        esp32InternalTcpCoreLoadU32(left + u32(12)) == esp32InternalTcpCoreLoadU32(right + u32(12)) &&
        esp32InternalTcpCoreLoadU8(left + u32(16)) == esp32InternalTcpCoreLoadU8(right + u32(16))
}

@inline
trusted fun esp32InternalTcpCoreCopyAddress(destination: u32, source: u32): void {
    esp32InternalTcpCoreStoreU32(destination, esp32InternalTcpCoreLoadU32(source))
    esp32InternalTcpCoreStoreU32(destination + u32(4), esp32InternalTcpCoreLoadU32(source + u32(4)))
    esp32InternalTcpCoreStoreU32(destination + u32(8), esp32InternalTcpCoreLoadU32(source + u32(8)))
    esp32InternalTcpCoreStoreU32(destination + u32(12), esp32InternalTcpCoreLoadU32(source + u32(12)))
    esp32InternalTcpCoreStoreU8(destination + u32(16), esp32InternalTcpCoreLoadU8(source + u32(16)))
    esp32InternalTcpCoreStoreU8(destination + u32(20), esp32InternalTcpCoreLoadU8(source + u32(20)))
}

