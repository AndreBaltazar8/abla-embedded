import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipSocketsInternals(): bool {
    if (!internalFunction("esp32RecoveredLwipSocketThreadInit", "lwip_socket_thread_init")) return false
    if (!internalFunction("esp32RecoveredLwipSocketThreadCleanup", "lwip_socket_thread_cleanup")) return false
    if (!internalFunction("esp32RecoveredLwipSocketDbgGetSocket", "lwip_socket_dbg_get_socket")) return false
    if (!internalFunction("esp32RecoveredLwipAccept", "lwip_accept")) return false
    if (!internalFunction("esp32RecoveredLwipBind", "lwip_bind")) return false
    if (!internalFunction("esp32RecoveredLwipClose", "lwip_close")) return false
    if (!internalFunction("esp32RecoveredLwipConnect", "lwip_connect")) return false
    if (!internalFunction("esp32RecoveredLwipListen", "lwip_listen")) return false
    if (!internalFunction("esp32RecoveredLwipRecvfrom", "lwip_recvfrom")) return false
    if (!internalFunction("esp32RecoveredLwipRead", "lwip_read")) return false
    if (!internalFunction("esp32RecoveredLwipRecv", "lwip_recv")) return false
    if (!internalFunction("esp32RecoveredLwipRecvmsg", "lwip_recvmsg")) return false
    if (!internalFunction("esp32RecoveredLwipReadv", "lwip_readv")) return false
    if (!internalFunction("esp32RecoveredLwipSendmsg", "lwip_sendmsg")) return false
    if (!internalFunction("esp32RecoveredLwipSendto", "lwip_sendto")) return false
    if (!internalFunction("esp32RecoveredLwipSend", "lwip_send")) return false
    if (!internalFunction("esp32RecoveredLwipSocket", "lwip_socket")) return false
    if (!internalFunction("esp32RecoveredLwipWrite", "lwip_write")) return false
    if (!internalFunction("esp32RecoveredLwipWritev", "lwip_writev")) return false
    if (!internalFunction("esp32RecoveredLwipSelect", "lwip_select")) return false
    if (!internalFunction("esp32RecoveredLwipPoll", "lwip_poll")) return false
    if (!internalFunction("esp32RecoveredLwipShutdown", "lwip_shutdown")) return false
    if (!internalFunction("esp32RecoveredLwipGetpeername", "lwip_getpeername")) return false
    if (!internalFunction("esp32RecoveredLwipGetsockname", "lwip_getsockname")) return false
    if (!internalFunction("esp32RecoveredLwipGetsockopt", "lwip_getsockopt")) return false
