import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipEthernetInternals(): bool {
    if (!internalFunction("esp32RecoveredEthernetInput", "ethernet_input")) return false
    if (!internalFunction("esp32RecoveredEthernetOutput", "ethernet_output")) return false
    true
}
