import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipFreertosArchInternals(): bool {
    if (!internalFunction("esp32LwipSysMutexNew", "sys_mutex_new")) return false
    if (!internalFunction("esp32LwipSysMutexLock", "sys_mutex_lock")) return false
    if (!internalFunction("esp32LwipSysMutexUnlock", "sys_mutex_unlock")) return false
    if (!internalFunction("esp32LwipSysMutexFree", "sys_mutex_free")) return false
    if (!internalFunction("esp32LwipSysSemNew", "sys_sem_new")) return false
    if (!internalFunction("esp32LwipSysSemSignal", "sys_sem_signal")) return false
    if (!internalFunction("esp32LwipSysSemSignalIsr", "sys_sem_signal_isr")) return false
    if (!internalFunction("esp32LwipSysArchSemWait", "sys_arch_sem_wait")) return false
    if (!internalFunction("esp32LwipSysSemFree", "sys_sem_free")) return false
    if (!internalFunction("esp32LwipSysMboxNew", "sys_mbox_new")) return false
    if (!internalFunction("esp32LwipSysMboxPost", "sys_mbox_post")) return false
    if (!internalFunction("esp32LwipSysMboxTrypost", "sys_mbox_trypost")) return false
    if (!internalFunction("esp32LwipSysMboxTrypostFromIsr", "sys_mbox_trypost_fromisr")) return false
    if (!internalFunction("esp32LwipSysArchMboxFetch", "sys_arch_mbox_fetch")) return false
    if (!internalFunction("esp32LwipSysArchMboxTryfetch", "sys_arch_mbox_tryfetch")) return false
    if (!internalFunction("esp32LwipSysMboxFree", "sys_mbox_free")) return false
    if (!internalFunction("esp32LwipSysThreadNew", "sys_thread_new")) return false
    if (!internalFunction("esp32LwipSysInit", "sys_init")) return false
    if (!internalFunction("esp32LwipSysJiffies", "sys_jiffies")) return false
    if (!internalFunction("esp32LwipSysNow", "sys_now")) return false
    if (!internalFunction("esp32LwipSysArchProtect", "sys_arch_protect")) return false
    if (!internalFunction("esp32LwipSysArchUnprotect", "sys_arch_unprotect")) return false
    if (!internalFunction("esp32LwipSysThreadSemInit", "sys_thread_sem_init")) return false
    if (!internalFunction("esp32LwipSysThreadSemGet", "sys_thread_sem_get")) return false
    if (!internalFunction("esp32LwipSysThreadSemDeinit", "sys_thread_sem_deinit")) return false
    if (!internalFunction("esp32LwipSysDelayMs", "sys_delay_ms")) return false
