import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipIpv4Internals(): bool {
    if (!internalFunction("esp32RecoveredIp4SetDefaultMulticastNetif", "ip4_set_default_multicast_netif")) return false
    if (!internalFunction("esp32RecoveredIp4Route", "ip4_route")) return false
    if (!internalFunction("esp32RecoveredIp4RouteSrc", "ip4_route_src")) return false
    if (!internalFunction("esp32RecoveredIp4Input", "ip4_input")) return false
    if (!internalFunction("esp32RecoveredIp4OutputIfOptSrc", "ip4_output_if_opt_src")) return false
    if (!internalFunction("esp32RecoveredIp4OutputIfOpt", "ip4_output_if_opt")) return false
    if (!internalFunction("esp32RecoveredIp4OutputIf", "ip4_output_if")) return false
    if (!internalFunction("esp32RecoveredIp4OutputIfSrc", "ip4_output_if_src")) return false
    if (!internalFunction("esp32RecoveredIp4Output", "ip4_output")) return false
    true
}
