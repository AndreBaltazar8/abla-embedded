import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipMemoryPoolsInternals(): bool {
    if (!internalFunction("esp32RecoveredMempInitPool", "memp_init_pool")) return false
    if (!internalFunction("esp32RecoveredMempInit", "memp_init")) return false
    if (!internalFunction("esp32RecoveredMempMallocPool", "memp_malloc_pool")) return false
    if (!internalFunction("esp32RecoveredMempMalloc", "memp_malloc")) return false
    if (!internalFunction("esp32RecoveredMempFreePool", "memp_free_pool")) return false
    if (!internalFunction("esp32RecoveredMempFree", "memp_free")) return false
    true
}
