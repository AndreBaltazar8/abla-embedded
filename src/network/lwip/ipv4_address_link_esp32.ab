import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipIpv4AddressInternals(): bool {
    if (!internalFunction("esp32LwipIpv4AddressData", "esp32_lwip_ipv4_address_data")) return false
    if (!internalFunction("esp32LwipIp4AddressIsBroadcast", "ip4_addr_isbroadcast_u32")) return false
    if (!internalFunction("esp32LwipIp4AddressNetmaskValid", "ip4_addr_netmask_valid")) return false
    if (!internalFunction("embeddedIp4AddressFromText", "ip4addr_aton")) return false
    if (!internalFunction("embeddedIp4AddressValueFromText", "ipaddr_addr")) return false
    if (!internalFunction("embeddedIp4AddressToText", "ip4addr_ntoa_r")) return false
    if (!internalFunction("embeddedIp4AddressToStaticText", "ip4addr_ntoa")) return false
    true
}
