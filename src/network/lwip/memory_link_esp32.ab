import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipMemoryInternals(): bool {
    if (!internalFunction("esp32LwipMemInitialize", "mem_init")) return false
    if (!internalFunction("esp32LwipMemTrim", "mem_trim")) return false
    if (!internalFunction("esp32LwipMemAllocate", "mem_malloc")) return false
    if (!internalFunction("esp32LwipMemFree", "mem_free")) return false
    if (!internalFunction("esp32LwipMemCallocate", "mem_calloc")) return false
    true
}
