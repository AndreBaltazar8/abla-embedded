import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipSntpInternals(): bool {
    if (!internalFunction("esp32RecoveredSntpSetSyncStatus", "sntp_set_sync_status")) return false
    if (!internalFunction("esp32RecoveredSntpSyncTime", "sntp_sync_time")) return false
    if (!internalFunction("esp32RecoveredSntpSetSyncMode", "sntp_set_sync_mode")) return false
    if (!internalFunction("esp32RecoveredSntpGetSyncMode", "sntp_get_sync_mode")) return false
    if (!internalFunction("esp32RecoveredSntpSetTimeSyncNotificationCb", "sntp_set_time_sync_notification_cb")) return false
    if (!internalFunction("esp32RecoveredSntpGetSyncStatus", "sntp_get_sync_status")) return false
    if (!internalFunction("esp32RecoveredSntpSetSyncInterval", "sntp_set_sync_interval")) return false
    if (!internalFunction("esp32RecoveredSntpGetSyncInterval", "sntp_get_sync_interval")) return false
    if (!internalFunction("esp32RecoveredSntpRestart", "sntp_restart")) return false
    if (!internalFunction("esp32RecoveredSntpSetSystemTime", "sntp_set_system_time")) return false
    if (!internalFunction("esp32RecoveredSntpGetSystemTime", "sntp_get_system_time")) return false
    if (!internalFunction("esp32RecoveredEspSntpSetoperatingmode", "esp_sntp_setoperatingmode")) return false
    if (!internalFunction("esp32RecoveredEspSntpInit", "esp_sntp_init")) return false
    if (!internalFunction("esp32RecoveredEspSntpStop", "esp_sntp_stop")) return false
    if (!internalFunction("esp32RecoveredEspSntpSetserver", "esp_sntp_setserver")) return false
    if (!internalFunction("esp32RecoveredEspSntpSetservername", "esp_sntp_setservername")) return false
    if (!internalFunction("esp32RecoveredEspSntpGetservername", "esp_sntp_getservername")) return false
    if (!internalFunction("esp32RecoveredEspSntpGetserver", "esp_sntp_getserver")) return false
    if (!internalFunction("esp32RecoveredEspSntpGetreachability", "esp_sntp_getreachability")) return false
    if (!internalFunction("esp32RecoveredEspSntpGetoperatingmode", "esp_sntp_getoperatingmode")) return false
    if (!internalFunction("esp32RecoveredEspSntpEnabled", "esp_sntp_enabled")) return false
    true
}
