import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipInternetChecksumInternals(): bool {
    if (!internalFunction("esp32RecoveredLwipStandardChksum", "lwip_standard_chksum")) return false
    if (!internalFunction("esp32RecoveredInetChksumPseudo", "inet_chksum_pseudo")) return false
    if (!internalFunction("esp32RecoveredIp6ChksumPseudo", "ip6_chksum_pseudo")) return false
    if (!internalFunction("esp32RecoveredIpChksumPseudo", "ip_chksum_pseudo")) return false
    if (!internalFunction("esp32RecoveredInetChksumPseudoPartial", "inet_chksum_pseudo_partial")) return false
    if (!internalFunction("esp32RecoveredIp6ChksumPseudoPartial", "ip6_chksum_pseudo_partial")) return false
    if (!internalFunction("esp32RecoveredIpChksumPseudoPartial", "ip_chksum_pseudo_partial")) return false
    if (!internalFunction("esp32RecoveredInetChksum", "inet_chksum")) return false
    if (!internalFunction("esp32RecoveredInetChksumPbuf", "inet_chksum_pbuf")) return false
    true
}
