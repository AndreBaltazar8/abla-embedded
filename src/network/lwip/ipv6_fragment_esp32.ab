import "ipv4_fragment_esp32.ab"
import "abla/runtime/self"

val esp32Ip6FragmentIdentificationStorage=nativeStaticAllocate(4)
val esp32Ip6FragmentIdentification=u32(esp32Ip6FragmentIdentificationStorage)

@inline
trusted fun esp32Ip6FragmentNextIdentification():u32 {
    val next=esp32Ip4FragmentLoadU32(esp32Ip6FragmentIdentification)+u32(1)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(esp32Ip6FragmentIdentification)),
        int(next))
    next
}

trusted fun esp32LwipIp6Fragment(packet:u32,networkInterface:u32,destination:u32):u32 {
    val mtu=esp32RecoveredNd6GetDestinationMtu(destination,networkInterface,
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),
        u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0),u32(0))
    if(mtu<=u32(48)) return u32(255)
    val fragmentCapacity=(mtu-u32(48))&u32(0xfff8)
    if(fragmentCapacity==u32(0)) return u32(255)
    val identification=esp32Ip6FragmentNextIdentification()
    val originalHeader=esp32Ip4FragmentLoadU32(packet+u32(4))
    val totalLength=esp32Ip4FragmentLoadU16(packet+u32(8))
    if(totalLength<u32(40)) return u32(250)
    var remaining=(totalLength-u32(40))&u32(0xffff)
    var packetOffset=u32(40)
    var fragmentOffset=u32(0)

    while(remaining!=u32(0)) {
        val last=remaining<=fragmentCapacity
        val copiedLength=if(last) remaining else fragmentCapacity
        val fragment=esp32LwipPbufAllocate(
            u32(54),(copiedLength+u32(8))&u32(0xffff),u32(640))
        if(fragment==u32(0)) return u32(255)
        val initialPayload=esp32Ip4FragmentLoadU32(fragment+u32(4))
        val copied=esp32LwipPbufCopyPartial(packet,initialPayload+u32(8),
            copiedLength,packetOffset)
        packetOffset=(packetOffset+copied)&u32(0xffff)
        if(esp32LwipPbufAddHeader(fragment,u32(40))!=u32(0)) {
            esp32LwipPbufFree(fragment)
            return u32(255)
        }

        val header=esp32Ip4FragmentLoadU32(fragment+u32(4))
        freestandingCopy(header,originalHeader,u32(40))
        val fragmentHeader=header+u32(40)
        esp32Ip4FragmentStoreU8(fragmentHeader,
            esp32Ip4FragmentLoadU8(originalHeader+u32(6)))
        esp32Ip4FragmentStoreU8(fragmentHeader+u32(1),u32(0))
        esp32Ip4FragmentStoreNetworkU16(fragmentHeader+u32(2),
            (fragmentOffset&u32(0xfff8))|
                (if(last) u32(0) else u32(1)))
        esp32Ip4FragmentStoreU8(fragmentHeader+u32(4),identification>>>u32(24))
        esp32Ip4FragmentStoreU8(fragmentHeader+u32(5),identification>>>u32(16))
        esp32Ip4FragmentStoreU8(fragmentHeader+u32(6),identification>>>u32(8))
        esp32Ip4FragmentStoreU8(fragmentHeader+u32(7),identification)
        esp32Ip4FragmentStoreU8(header+u32(6),u32(44))
        esp32Ip4FragmentStoreNetworkU16(
            header+u32(4),(copiedLength+u32(8))&u32(0xffff))

        val outputFunction=esp32Ip4FragmentLoadU32(networkInterface+u32(188))
        val ignored=u64(ablaUnsafeCallI64I32I32I32(
            int(outputFunction),int(networkInterface),int(fragment),int(destination)))
        esp32LwipPbufFree(fragment)
        remaining=(remaining-copiedLength)&u32(0xffff)
        fragmentOffset=(fragmentOffset+copiedLength)&u32(0xffff)
    }
    u32(0)
}

trusted fun esp32RecoveredIp6Frag(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LwipIp6Fragment(a2,a3,a4)
