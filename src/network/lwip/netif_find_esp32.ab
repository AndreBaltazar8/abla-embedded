import "abla/unsafe/memory"
import "./shared_storage_esp32.ab"
import "../../xtensa/assembly.ab"

// The list cell is ordinary private Abla state shared by the lwIP modules.

@inline
trusted fun esp32LwipNetifListAddress(): u32 =
    esp32Data_netif_list_d0aa0ab78c

@inline
trusted fun esp32LwipNetifTextByte(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address))) & 255
)

trusted fun esp32LwipNetifFind(name: u32): u32 {
    if (name == u32(0)) return u32(0)

    var cursor = name + u32(2)
    var byte = esp32LwipNetifTextByte(cursor)
    while (byte == u32(32) || (byte >= u32(9) && byte <= u32(13))) {
        cursor = cursor + u32(1)
        byte = esp32LwipNetifTextByte(cursor)
    }

    var negative = false
    if (byte == u32(43) || byte == u32(45)) {
        negative = byte == u32(45)
        cursor = cursor + u32(1)
        byte = esp32LwipNetifTextByte(cursor)
    }

    var number = u32(0)
    while (byte >= u32(48) && byte <= u32(57)) {
        number = number * u32(10) + byte - u32(48)
        cursor = cursor + u32(1)
        byte = esp32LwipNetifTextByte(cursor)
    }
    if (negative) number = u32(0) - number
    number = number & u32(255)

    // This is the exact failure check used by lwIP after atoi(&name[2]).
    if (number == u32(0) && esp32LwipNetifTextByte(name + u32(2)) != u32(48)) {
        return u32(0)
    }

    var netif = u32(ablaUnsafeLoadU32(nativePointerFromAddress(
        int(esp32LwipNetifListAddress())
    )))
    while (netif != u32(0)) {
        if (esp32LwipNetifTextByte(netif + u32(234)) == number &&
            esp32LwipNetifTextByte(netif + u32(232)) ==
                esp32LwipNetifTextByte(name) &&
            esp32LwipNetifTextByte(netif + u32(233)) ==
                esp32LwipNetifTextByte(name + u32(1))) return netif
        netif = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(netif))))
    }
    return u32(0)
}
