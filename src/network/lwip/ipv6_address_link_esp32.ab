import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipIpv6AddressInternals(): bool {
    if (!internalFunction("esp32LwipIpv6AddressData", "esp32_lwip_ipv6_address_data")) return false
    if (!internalFunction("esp32LwipIp6AddressFromText", "ip6addr_aton")) return false
    if (!internalFunction("embeddedIp6AddressToText", "ip6addr_ntoa_r")) return false
    if (!internalFunction("embeddedIp6AddressToStaticText", "ip6addr_ntoa")) return false
    true
}
