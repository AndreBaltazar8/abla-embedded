import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipPppMagicInternals(): bool {
    if (!internalFunction("esp32PppMagicInit", "magic_init")) return false
    if (!internalFunction("esp32PppMagicRandomize", "magic_randomize")) return false
    if (!internalFunction("esp32PppMagic", "magic")) return false
    if (!internalFunction("esp32PppMagicRandomBytes", "magic_random_bytes")) return false
    if (!internalFunction("esp32PppMagicPow", "magic_pow")) return false
    true
}
