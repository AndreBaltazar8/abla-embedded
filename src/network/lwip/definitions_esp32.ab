import "abla/unsafe/memory"
import "../ip_text.ab"

// Target-independent lwIP utility semantics. These functions intentionally
// keep the established ESP-IDF ABI-sized scalar parameters while exposing all
// useful operations to LLVM.
@inline
fun embeddedLwipHtons(value: u32): u32 =
    ((value & u32(255)) << u32(8)) |
        ((value >> u32(8)) & u32(255))

@inline
fun embeddedLwipHtonl(value: u32): u32 =
    ((value & u32(255)) << u32(24)) |
        ((value & u32(65280)) << u32(8)) |
        ((value >> u32(8)) & u32(65280)) |
        ((value >> u32(24)) & u32(255))

@inline
trusted fun embeddedLwipBytesEqual(
    first: u32,
    second: u32,
    length: u32
): bool {
    var index = u32(0)
    while (index < length) {
        if (embeddedIpTextByte(first + index) !=
            embeddedIpTextByte(second + index)) return false
        index = index + u32(1)
    }
    return true
}

@inline
trusted fun embeddedLwipStringLength(value: u32): u32 {
    var length = u32(0)
    while (embeddedIpTextByte(value + length) != 0) {
        length = length + u32(1)
    }
    return length
}

trusted fun embeddedLwipStrnstr(
    haystack: u32,
    needle: u32,
    length: u32
): u32 {
    val needleLength = embeddedLwipStringLength(needle)
    if (needleLength == u32(0)) return haystack

    var cursor = haystack
    val limit = haystack + length
    while (embeddedIpTextByte(cursor) != 0) {
        if (cursor + needleLength > limit) return u32(0)
        if (embeddedIpTextByte(cursor) == embeddedIpTextByte(needle) &&
            embeddedLwipBytesEqual(cursor, needle, needleLength)) return cursor
        cursor = cursor + u32(1)
    }
    return u32(0)
}

@inline
fun embeddedLwipAsciiFold(byte: int): int = byte | 32

@inline
fun embeddedLwipFoldableAscii(byte: int): bool {
    val folded = embeddedLwipAsciiFold(byte)
    return folded >= 97 && folded <= 122
}

trusted fun embeddedLwipStricmp(first: u32, second: u32): i32 {
    var left = first
    var right = second
    while (true) {
        val leftByte = embeddedIpTextByte(left)
        val rightByte = embeddedIpTextByte(right)
        left = left + u32(1)
        right = right + u32(1)
        if (leftByte != rightByte) {
            if (!embeddedLwipFoldableAscii(leftByte) ||
                embeddedLwipAsciiFold(leftByte) !=
                    embeddedLwipAsciiFold(rightByte)) return 1
        }
        if (leftByte == 0) return 0
    }
}

trusted fun embeddedLwipStrnicmp(
    first: u32,
    second: u32,
    length: u32
): i32 {
    var left = first
    var right = second
    var remaining = length
    while (true) {
        val leftByte = embeddedIpTextByte(left)
        val rightByte = embeddedIpTextByte(right)
        left = left + u32(1)
        right = right + u32(1)
        if (leftByte != rightByte) {
            if (!embeddedLwipFoldableAscii(leftByte) ||
                embeddedLwipAsciiFold(leftByte) !=
                    embeddedLwipAsciiFold(rightByte)) return 1
        }
        remaining = remaining - u32(1)
        if (remaining == u32(0) || leftByte == 0) return 0
    }
}

trusted fun embeddedLwipStrnistr(
    haystack: u32,
    needle: u32,
    length: u32
): u32 {
    val needleLength = embeddedLwipStringLength(needle)
    if (needleLength == u32(0)) return haystack

    var cursor = haystack
    val limit = haystack + length
    while (embeddedIpTextByte(cursor) != 0) {
        if (cursor + needleLength > limit) return u32(0)
        if (embeddedLwipStrnicmp(cursor, needle, needleLength) == 0) {
            return cursor
        }
        cursor = cursor + u32(1)
    }
    return u32(0)
}

trusted fun embeddedLwipItoa(
    output: u32,
    outputLength: u32,
    value: i32
): void {
    if (outputLength < u32(2)) {
        if (outputLength == u32(1)) embeddedIpTextStoreByte(output, u32(0))
        return
    }

    var destination = output
    var magnitude = u32(value)
    if (value < 0) {
        embeddedIpTextStoreByte(output, u32(45))
        destination = output + u32(1)
        magnitude = u32(0) - magnitude
    }

    var digits = output + outputLength - u32(1)
    embeddedIpTextStoreByte(digits, u32(0))
    while (magnitude != u32(0) && destination < digits) {
        val quotient = magnitude / u32(10)
        val digit = magnitude - quotient * u32(10)
        digits = digits - u32(1)
        embeddedIpTextStoreByte(digits, u32(48) + digit)
        magnitude = quotient
    }

    if (magnitude != u32(0)) {
        embeddedIpTextStoreByte(output, u32(0))
        return
    }
    if (embeddedIpTextByte(digits) == 0) {
        embeddedIpTextStoreByte(destination, u32(48))
        embeddedIpTextStoreByte(destination + u32(1), u32(0))
        return
    }

    var source = digits
    while (true) {
        val byte = u32(embeddedIpTextByte(source))
        embeddedIpTextStoreByte(destination, byte)
        destination = destination + u32(1)
        source = source + u32(1)
        if (byte == u32(0)) return
    }
}
