import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipUdpInternals(): bool {
    if (!internalFunction("esp32RecoveredUdpInit", "udp_init")) return false
    if (!internalFunction("esp32RecoveredUdpInput", "udp_input")) return false
    if (!internalFunction("esp32RecoveredUdpBind", "udp_bind")) return false
    if (!internalFunction("esp32RecoveredUdpSendtoIfSrc", "udp_sendto_if_src")) return false
    if (!internalFunction("esp32RecoveredUdpSendtoIf", "udp_sendto_if")) return false
    if (!internalFunction("esp32RecoveredUdpSendto", "udp_sendto")) return false
    if (!internalFunction("esp32RecoveredUdpSend", "udp_send")) return false
    if (!internalFunction("esp32RecoveredUdpBindNetif", "udp_bind_netif")) return false
    if (!internalFunction("esp32RecoveredUdpConnect", "udp_connect")) return false
    if (!internalFunction("esp32RecoveredUdpDisconnect", "udp_disconnect")) return false
    if (!internalFunction("esp32RecoveredUdpRecv", "udp_recv")) return false
    if (!internalFunction("esp32RecoveredUdpRemove", "udp_remove")) return false
    if (!internalFunction("esp32RecoveredUdpNew", "udp_new")) return false
    if (!internalFunction("esp32RecoveredUdpNewIpType", "udp_new_ip_type")) return false
    if (!internalFunction("esp32RecoveredUdpNetifIpAddrChanged", "udp_netif_ip_addr_changed")) return false
    true
}
