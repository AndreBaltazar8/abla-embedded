import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipIpCommonInternals(): bool {
    if (!internalFunction("esp32LwipIpCommonData", "esp32_lwip_ip_common_data")) return false
    if (!internalFunction("esp32LwipIpAddressToStaticText", "ipaddr_ntoa")) return false
    if (!internalFunction("esp32LwipIpAddressToText", "ipaddr_ntoa_r")) return false
    if (!internalFunction("esp32LwipIpAddressFromText", "ipaddr_aton")) return false
    if (!internalFunction("esp32LwipIpInput", "ip_input")) return false
    true
}
