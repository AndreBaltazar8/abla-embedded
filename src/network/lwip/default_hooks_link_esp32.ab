import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipDefaultHooksInternals(): bool {
    if (!internalFunction("esp32LwipHookIp6Input", "lwip_hook_ip6_input")) return false
    if (!internalFunction("esp32LwipIp4NetifExist", "ip4_netif_exist")) return false
    if (!internalFunction("esp32LwipIp4RouteSourceHook", "ip4_route_src_hook")) return false
    if (!internalFunction("esp32LwipDhcpParseExtraOptions", "dhcp_parse_extra_opts")) return false
    if (!internalFunction("esp32LwipDhcpAppendExtraOptions", "dhcp_append_extra_opts")) return false
    true
}
