import "abla/unsafe/memory"
import "./definitions_esp32.ab"
import "./netif_find_esp32.ab"
import "./shared_storage_esp32.ab"
import "../../xtensa/assembly.ab"

val esp32LwipNetifClientDataId = nativeStaticAllocate(1)

@inline
trusted fun esp32LwipNetifListCell(): u32 =
    esp32Data_netif_list_d0aa0ab78c

@inline
trusted fun esp32LwipNetifDefaultCell(): u32 =
    esp32Data_netif_default_4073595ae5

@inline
trusted fun esp32LwipNetifLoadU32(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

trusted fun esp32LwipNetifSetDefault(networkInterface: u32): void {
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32LwipNetifDefaultCell())),
        int(networkInterface)
    )
    return
}

trusted fun esp32LwipNetifGetByIndex(rawIndex: u32): u32 {
    val index = rawIndex & u32(255)
    if (index == u32(0)) return u32(0)
    var networkInterface = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(esp32LwipNetifListCell()))
    ))
    while (networkInterface != u32(0)) {
        val current =
            (u32(embeddedIpTextByte(networkInterface + u32(234))) + u32(1)) &
                u32(255)
        if (current == index) return networkInterface
        networkInterface = u32(ablaUnsafeLoadU32(
            nativePointerFromAddress(int(networkInterface))
        ))
    }
    return u32(0)
}

trusted fun esp32LwipNetifIndexToName(rawIndex: u32, output: u32): u32 {
    val index = rawIndex & u32(255)
    val networkInterface = esp32LwipNetifGetByIndex(index)
    if (networkInterface == u32(0)) return u32(0)
    embeddedIpTextStoreByte(
        output, u32(embeddedIpTextByte(networkInterface + u32(232)))
    )
    embeddedIpTextStoreByte(
        output + u32(1),
        u32(embeddedIpTextByte(networkInterface + u32(233)))
    )
    embeddedLwipItoa(output + u32(2), u32(4), i32(index - u32(1)))
    return output
}

trusted fun esp32LwipNetifNameToIndex(name: u32): u32 {
    val networkInterface = esp32LwipNetifFind(name)
    if (networkInterface == u32(0)) return u32(0)
    return (u32(embeddedIpTextByte(networkInterface + u32(234))) + u32(1)) &
        u32(255)
}

// lwIP keeps three IPv6 address slots in each netif. The zone byte in a
// scoped address must identify this netif; an unscoped address retains lwIP's
// historical slot-zero result.
trusted fun esp32LwipNetifGetIp6AddrMatch(
    networkInterface: u32,
    address: u32
): u32 {
    if (networkInterface == u32(0) || address == u32(0)) return u32(255)
    val zone = u32(embeddedIpTextByte(address + u32(16)))
    if (zone == u32(0)) return u32(0)
    if (zone != ((u32(embeddedIpTextByte(
        networkInterface + u32(234)
    )) + u32(1)) & u32(255))) return u32(255)

    var index = u32(0)
    while (index < u32(3)) {
        if (embeddedIpTextByte(
            networkInterface + u32(148) + index
        ) != 0) {
            val candidate = networkInterface + u32(76) + index * u32(20)
            if (esp32LwipNetifLoadU32(candidate) ==
                    esp32LwipNetifLoadU32(address) &&
                esp32LwipNetifLoadU32(candidate + u32(4)) ==
                    esp32LwipNetifLoadU32(address + u32(4)) &&
                esp32LwipNetifLoadU32(candidate + u32(8)) ==
                    esp32LwipNetifLoadU32(address + u32(8)) &&
                esp32LwipNetifLoadU32(candidate + u32(12)) ==
                    esp32LwipNetifLoadU32(address + u32(12))) return index
        }
        index = index + u32(1)
    }
    return u32(255)
}

trusted fun esp32LwipNetifAllocateClientDataId(): u32 {
    val current = u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(esp32LwipNetifClientDataId)
    )) & u32(255)
    ablaUnsafeStoreU8(
        nativePointerFromAddress(esp32LwipNetifClientDataId),
        int((current + u32(1)) & u32(255))
    )
    return (current + u32(4)) & u32(255)
}
