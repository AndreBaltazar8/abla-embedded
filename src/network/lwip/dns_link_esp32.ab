import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipDnsInternals(): bool {
    if (!internalFunction("esp32RecoveredDnsInit", "dns_init")) return false
    if (!internalFunction("esp32RecoveredDnsSetserver", "dns_setserver")) return false
    if (!internalFunction("esp32RecoveredDnsClearCache", "dns_clear_cache")) return false
    if (!internalFunction("esp32RecoveredDnsGetserver", "dns_getserver")) return false
    if (!internalFunction("esp32RecoveredDnsTmr", "dns_tmr")) return false
    if (!internalFunction("esp32RecoveredDnsGethostbynameAddrtype", "dns_gethostbyname_addrtype")) return false
    if (!internalFunction("esp32RecoveredDnsGethostbyname", "dns_gethostbyname")) return false
    true
}
