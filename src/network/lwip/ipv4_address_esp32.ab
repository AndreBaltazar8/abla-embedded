import "abla/unsafe/memory"
import "../ip_text.ab"
import "./definitions_esp32.ab"
import "../../xtensa/assembly.ab"


val esp32Data_ip_addr_any_5092b3bdf8Storage = nativeStaticAllocate(24)
val esp32Data_ip_addr_any_5092b3bdf8 = u32(esp32Data_ip_addr_any_5092b3bdf8Storage)


// These two objects still need their exact lwIP linker names while recovered
// callers remain. They contain data only; all executable address logic below
// is ordinary Abla visible to LLVM.
trusted fun esp32LwipIpv4AddressData(): void {
    // Static data is emitted by Abla above.
    return
}

trusted fun esp32LwipIp4AddressIsBroadcast(
    address: u32,
    networkInterface: u32
): u32 {
    if (address == u32(0) || address == u32(4294967295)) return u32(1)
    if (networkInterface == u32(0)) return u32(0)
    val flags = u32(embeddedIpTextByte(networkInterface + u32(231)))
    if ((flags & u32(2)) == u32(0)) return u32(0)
    val localAddress = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(networkInterface + u32(4)))
    ))
    if (address == localAddress) return u32(0)
    val netmask = u32(ablaUnsafeLoadU32(
        nativePointerFromAddress(int(networkInterface + u32(28)))
    ))
    if (((address ^ localAddress) & netmask) != u32(0)) return u32(0)
    val hostBits = netmask ^ u32(4294967295)
    return if ((address & hostBits) == hostBits) u32(1) else u32(0)
}

trusted fun esp32LwipIp4AddressNetmaskValid(netmask: u32): u32 {
    val hostMask = embeddedLwipHtonl(netmask)
    val hostBits = hostMask ^ u32(4294967295)
    return if ((hostBits & (hostBits + u32(1))) == u32(0))
        u32(1) else u32(0)
}

val esp32Data_ip_addr_broadcast_05eaa31de4Storage = nativeStaticMutableU32s([
    4294967295,
    0,
    0,
    0,
    0,
    0
])
val esp32Data_ip_addr_broadcast_05eaa31de4Initialized = esp32Data_ip_addr_broadcast_05eaa31de4Storage
val esp32Data_ip_addr_broadcast_05eaa31de4 = u32(esp32Data_ip_addr_broadcast_05eaa31de4Initialized)
