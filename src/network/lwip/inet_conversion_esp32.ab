import "abla/unsafe/memory"
import "../ip_text.ab"
import "./ipv6_address_esp32.ab"
import "../../xtensa/assembly.ab"

@inline
trusted fun esp32LwipErrnoAddress(): u32 =
    u32(nativeInternalSectionThreadLocalAllocate(4, "errno", ".tdata.errno", 4))

@inline
trusted fun esp32LwipSetErrno(value: i32): void {
    ablaUnsafeStoreU32(
        nativePointerFromAddress(int(esp32LwipErrnoAddress())),
        int(value)
    )
    return
}

// Typed implementations of the BSD address-conversion boundary. The target
// subparser only produces errno's TLS address; LLVM owns all parsing,
// formatting, copying, branching, and stores.
trusted fun esp32LwipInetPton(
    addressFamily: i32,
    source: u32,
    destination: u32
): i32 {
    if (addressFamily == 2) {
        return embeddedIp4AddressFromText(source, destination)
    }
    if (addressFamily == 10) {
        val temporary = nativeStackAllocate(20)
        val result = esp32LwipIp6AddressFromText(source, u32(temporary))
        if (result == 0) return 0
        // This is a typed compiler intrinsic rather than a libc call. LLVM can
        // select the smallest safe constant-size copy for the target.
        ablaUnsafeCopyMemory(int(destination), temporary, 16)
        return 1
    }
    esp32LwipSetErrno(106)
    return -1
}

trusted fun esp32LwipInetNtop(
    addressFamily: i32,
    source: u32,
    destination: u32,
    size: i32
): u32 {
    if (size < 0) {
        esp32LwipSetErrno(28)
        return u32(0)
    }

    var result = u32(0)
    if (addressFamily == 2) {
        result = embeddedIp4AddressToText(source, destination, size)
    } else if (addressFamily == 10) {
        result = embeddedIp6AddressToText(source, destination, size)
    } else {
        esp32LwipSetErrno(106)
        return u32(0)
    }

    if (result == u32(0)) esp32LwipSetErrno(28)
    return result
}
