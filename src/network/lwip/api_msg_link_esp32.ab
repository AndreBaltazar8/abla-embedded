    if (!internalFunction("esp32RecoveredLwipNetconnIsErrMsg", "lwip_netconn_is_err_msg")) return false
    if (!internalFunction("esp32RecoveredLwipNetconnDoNewconn", "lwip_netconn_do_newconn")) return false
