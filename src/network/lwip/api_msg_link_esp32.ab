    if (!internalFunction("esp32RecoveredLwipNetconnDoBind", "lwip_netconn_do_bind")) return false
    if (!internalFunction("esp32RecoveredLwipNetconnDoBindIf", "lwip_netconn_do_bind_if")) return false
    if (!internalFunction("esp32RecoveredLwipNetconnDoConnect", "lwip_netconn_do_connect")) return false
    if (!internalFunction("esp32RecoveredLwipNetconnDoDisconnect", "lwip_netconn_do_disconnect")) return false
    if (!internalFunction("esp32RecoveredLwipNetconnDoListen", "lwip_netconn_do_listen")) return false
    if (!internalFunction("esp32RecoveredLwipNetconnDoSend", "lwip_netconn_do_send")) return false
    if (!internalFunction("esp32RecoveredLwipNetconnDoRecv", "lwip_netconn_do_recv")) return false
    if (!internalFunction("esp32RecoveredLwipNetconnDoAccepted", "lwip_netconn_do_accepted")) return false
