            var decodeLength = u32(0)
            if (option == u32(1)) {
                if (encodedLength != u32(4)) return u32(250)
                decodeIndex = u32(6)
                decodeLength = u32(4)
            } else if (option == u32(3)) {
                if (encodedLength < u32(4)) return u32(250)
                decodeIndex = u32(7)
                decodeLength = u32(4)
            } else if (option == u32(6)) {
                if ((encodedLength & u32(3)) != u32(0)) return u32(250)
                decodeIndex = u32(8)
                decodeLength = if (encodedLength < u32(12)) encodedLength else u32(12)
            } else if (option == u32(51)) {
                if (encodedLength != u32(4)) return u32(250)
                decodeIndex = u32(3)
                decodeLength = u32(4)
            } else if (option == u32(52)) {
                if (!allowOverload || encodedLength != u32(1)) return u32(250)
                decodeIndex = u32(0)
                decodeLength = u32(1)
            } else if (option == u32(53)) {
                if (encodedLength != u32(1)) return u32(250)
                decodeIndex = u32(1)
                decodeLength = u32(1)
            } else if (option == u32(54)) {
                if (encodedLength != u32(4)) return u32(250)
                decodeIndex = u32(2)
                decodeLength = u32(4)
            } else if (option == u32(58)) {
                if (encodedLength != u32(4)) return u32(250)
                decodeIndex = u32(4)
                decodeLength = u32(4)
            } else if (option == u32(59)) {
                if (encodedLength != u32(4)) return u32(250)
                decodeIndex = u32(5)
                decodeLength = u32(4)
            } else {
                val messageType =
