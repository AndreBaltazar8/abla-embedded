import "../../runtime/freestanding_memory.ab"
import "abla/unsafe/memory"
import "abla/unsafe/native"

trusted fun esp32LwipEthernetIpv6Output(
    networkInterface: u32,
    packet: u32,
    destination: u32
): u32 {
    val ethernetAddress = u32(nativeStackAllocate(16))
    if (u32(ablaUnsafeLoadU8(
        nativePointerFromAddress(int(destination))
    )) == u32(255)) {
        ablaUnsafeStoreU8(nativePointerFromAddress(int(ethernetAddress)), 51)
        ablaUnsafeStoreU8(nativePointerFromAddress(int(ethernetAddress + u32(1))), 51)
        var index = u32(0)
        while (index < u32(4)) {
            val byte = ablaUnsafeLoadU8(nativePointerFromAddress(
                int(destination + u32(12) + index)
            ))
            ablaUnsafeStoreU8(
                nativePointerFromAddress(int(ethernetAddress + u32(2) + index)),
                byte
            )
            index = index + u32(1)
        }
        return esp32RecoveredEthernetOutput(
            networkInterface, packet, networkInterface + u32(224),
            ethernetAddress, u32(34525), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0),
            u32(0), u32(0), u32(0), u32(0), u32(0)
        )
    }

    val addressOut = ethernetAddress + u32(8)
    ablaUnsafeStoreU32(nativePointerFromAddress(int(addressOut)), 0)
    val result = esp32RecoveredNd6GetNextHopAddrOrQueue(
        networkInterface, packet, destination, addressOut, u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
    if (result != u32(0)) return result
    val nextHop = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(addressOut))))
    if (nextHop == u32(0)) return u32(0)
    freestandingCopy(ethernetAddress, nextHop, u32(6))
    esp32RecoveredEthernetOutput(
        networkInterface, packet, networkInterface + u32(224),
        ethernetAddress, u32(34525), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0),
        u32(0), u32(0), u32(0), u32(0), u32(0)
    )
}

trusted fun esp32RecoveredEthip6Output(
    a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32,
    stack0: u32, stack1: u32, stack2: u32, stack3: u32,
    stack4: u32, stack5: u32, stack6: u32, stack7: u32,
    stack8: u32, stack9: u32
): u32 = esp32LwipEthernetIpv6Output(a2, a3, a4)
