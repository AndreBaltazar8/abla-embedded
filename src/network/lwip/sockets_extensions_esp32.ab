import "abla/unsafe/memory"
import "abla/unsafe/native"

// ESP lwIP IPv6 socket-option extensions in structured Abla.
val esp32LwipIpv6Level = u32(41)
val esp32LwipIpv6MulticastLoop = u32(768)
val esp32LwipIpv6MulticastHops = u32(769)
val esp32LwipIpv6UnicastHops = u32(770)
val esp32LwipSocketOptionInvalid = u32(22)
val esp32LwipSocketNotConnection = u32(109)

@inline trusted fun esp32LwipSocketExtLoad(address: u32): u32 = u32(
    ablaUnsafeLoadU32(nativePointerFromAddress(int(address)))
)

@inline trusted fun esp32LwipSocketExtLoadByte(address: u32): u32 = u32(
    ablaUnsafeLoadU8(nativePointerFromAddress(int(address)))
)

@inline trusted fun esp32LwipSocketExtStore(
    address: u32, value: u32
): void = ablaUnsafeStoreU32(
    nativePointerFromAddress(int(address)), int(value)
)

@inline trusted fun esp32LwipSocketExtStoreByte(
    address: u32, value: u32
): void = ablaUnsafeStoreU8(
    nativePointerFromAddress(int(address)), int(value & u32(255))
)

trusted fun esp32LwipSocketExtOptionSupported(
    level: u32, option: u32
): bool = level == esp32LwipIpv6Level && (
    option == esp32LwipIpv6MulticastLoop ||
    option == esp32LwipIpv6MulticastHops ||
    option == esp32LwipIpv6UnicastHops
)

trusted fun esp32LwipSocketExtUdpControl(
    socket: u32, lengthValid: bool, error: u32
): u32 {
    if (!lengthValid || socket == u32(0)) {
        esp32LwipSocketExtStore(error, esp32LwipSocketOptionInvalid)
        return u32(0)
    }
    val connection = esp32LwipSocketExtLoad(socket)
    if (connection == u32(0)) {
        esp32LwipSocketExtStore(error, esp32LwipSocketOptionInvalid)
        return u32(0)
    }
    val control = esp32LwipSocketExtLoad(connection + u32(8))
    if (control == u32(0)) {
        esp32LwipSocketExtStore(error, esp32LwipSocketOptionInvalid)
        return u32(0)
    }
    if (((esp32LwipSocketExtLoad(connection) >> u32(4)) &
        u32(15)) != u32(2)) {
        esp32LwipSocketExtStore(error, esp32LwipSocketNotConnection)
        return u32(0)
    }
    return control
}

// Returns one when the extension handled the option, including validation
// failures, and zero when the generic lwIP option implementation should try.
trusted fun esp32LwipSetsockoptImplExt(
    socket: u32,
    level: u32,
    option: u32,
    value: u32,
    length: u32,
    error: u32
): u32 {
    if (!esp32LwipSocketExtOptionSupported(level, option)) return u32(0)
    val control = esp32LwipSocketExtUdpControl(
        socket, length != u32(0), error
    )
    if (control == u32(0)) return u32(1)
    val byte = esp32LwipSocketExtLoadByte(value)
    if (option == esp32LwipIpv6MulticastLoop) {
        esp32LwipSocketExtStoreByte(control + u32(68), byte)
    } else if (option == esp32LwipIpv6MulticastHops) {
        esp32LwipSocketExtStoreByte(control + u32(69), byte)
    } else {
        val flags = esp32LwipSocketExtLoadByte(control + u32(56))
        esp32LwipSocketExtStoreByte(
            control + u32(56),
            if (byte != u32(0)) flags | u32(8) else flags & ~u32(8)
        )
    }
    return u32(1)
}

trusted fun esp32LwipGetsockoptImplExt(
    socket: u32,
    level: u32,
    option: u32,
    value: u32,
    length: u32,
    error: u32
): u32 {
    if (!esp32LwipSocketExtOptionSupported(level, option)) return u32(0)
    val control = esp32LwipSocketExtUdpControl(
        socket,
        length != u32(0) &&
            esp32LwipSocketExtLoad(length) != u32(0),
        error
    )
    if (control == u32(0)) return u32(1)
    val result = if (option == esp32LwipIpv6MulticastLoop)
        esp32LwipSocketExtLoadByte(control + u32(68))
    else if (option == esp32LwipIpv6MulticastHops)
        esp32LwipSocketExtLoadByte(control + u32(69))
    else if ((esp32LwipSocketExtLoadByte(
        control + u32(56)
    ) & u32(8)) != u32(0)) u32(1) else u32(0)
    esp32LwipSocketExtStoreByte(value, result)
    return u32(1)
}

trusted fun esp32RecoveredLwipSetsockoptImplExt(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LwipSetsockoptImplExt(a2,a3,a4,a5,a6,a7)
trusted fun esp32RecoveredLwipGetsockoptImplExt(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32LwipGetsockoptImplExt(a2,a3,a4,a5,a6,a7)
