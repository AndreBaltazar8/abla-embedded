import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipTcpCoreInternals(): bool {
    if (!internalFunction("esp32RecoveredTcpInit", "tcp_init")) return false
    if (!internalFunction("esp32RecoveredTcpFree", "tcp_free")) return false
    if (!internalFunction("esp32RecoveredTcpBacklogDelayed", "tcp_backlog_delayed")) return false
    if (!internalFunction("esp32RecoveredTcpBacklogAccepted", "tcp_backlog_accepted")) return false
    if (!internalFunction("esp32RecoveredTcpBind", "tcp_bind")) return false
    if (!internalFunction("esp32RecoveredTcpBindNetif", "tcp_bind_netif")) return false
    if (!internalFunction("esp32RecoveredTcpListenWithBacklogAndErr", "tcp_listen_with_backlog_and_err")) return false
    if (!internalFunction("esp32RecoveredTcpListenWithBacklog", "tcp_listen_with_backlog")) return false
    if (!internalFunction("esp32RecoveredTcpUpdateRcvAnnWnd", "tcp_update_rcv_ann_wnd")) return false
    if (!internalFunction("esp32RecoveredTcpRecved", "tcp_recved")) return false
    if (!internalFunction("esp32RecoveredTcpTxnow", "tcp_txnow")) return false
    if (!internalFunction("esp32RecoveredTcpSegFree", "tcp_seg_free")) return false
    if (!internalFunction("esp32RecoveredTcpSegsFree", "tcp_segs_free")) return false
    if (!internalFunction("esp32RecoveredTcpSetprio", "tcp_setprio")) return false
    if (!internalFunction("esp32RecoveredTcpSegCopy", "tcp_seg_copy")) return false
    if (!internalFunction("esp32RecoveredTcpArg", "tcp_arg")) return false
    if (!internalFunction("esp32RecoveredTcpRecv", "tcp_recv")) return false
    if (!internalFunction("esp32RecoveredTcpSent", "tcp_sent")) return false
    if (!internalFunction("esp32RecoveredTcpErr", "tcp_err")) return false
    if (!internalFunction("esp32RecoveredTcpAccept", "tcp_accept")) return false
    if (!internalFunction("esp32RecoveredTcpPoll", "tcp_poll")) return false
    if (!internalFunction("esp32RecoveredTcpNextIss", "tcp_next_iss")) return false
    if (!internalFunction("esp32RecoveredTcpEffSendMssNetif", "tcp_eff_send_mss_netif")) return false
    if (!internalFunction("esp32RecoveredTcpConnect", "tcp_connect")) return false
    if (!internalFunction("esp32RecoveredTcpDebugStateStr", "tcp_debug_state_str")) return false
    if (!internalFunction("esp32RecoveredTcpTcpGetTcpAddrinfo", "tcp_tcp_get_tcp_addrinfo")) return false
    if (!internalFunction("esp32RecoveredTcpFreeOoseq", "tcp_free_ooseq")) return false
    if (!internalFunction("esp32RecoveredTcpPcbPurge", "tcp_pcb_purge")) return false
    if (!internalFunction("esp32RecoveredTcpPcbRemove", "tcp_pcb_remove")) return false
    if (!internalFunction("esp32RecoveredTcpAbandon", "tcp_abandon")) return false
    if (!internalFunction("esp32RecoveredTcpAbort", "tcp_abort")) return false
    if (!internalFunction("esp32RecoveredTcpNetifIpAddrChanged", "tcp_netif_ip_addr_changed")) return false
    if (!internalFunction("esp32RecoveredTcpRecvNull", "tcp_recv_null")) return false
    if (!internalFunction("esp32RecoveredTcpAlloc", "tcp_alloc")) return false
    if (!internalFunction("esp32RecoveredTcpNew", "tcp_new")) return false
    if (!internalFunction("esp32RecoveredTcpNewIpType", "tcp_new_ip_type")) return false
    if (!internalFunction("esp32RecoveredTcpCloseExt", "tcp_close_ext")) return false
    if (!internalFunction("esp32RecoveredTcpClose", "tcp_close")) return false
    if (!internalFunction("esp32RecoveredTcpProcessRefusedData", "tcp_process_refused_data")) return false
    if (!internalFunction("esp32RecoveredTcpFasttmr", "tcp_fasttmr")) return false
