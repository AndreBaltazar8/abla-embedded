import "freertos_arch_esp32.ab"
import "../../esp32/crypto/random_hardware_esp32.ab"
import "abla/runtime/self"
import "abla/unsafe/memory"

val esp32PppMagicSeedStorage = nativeStaticAllocate(4)
val esp32PppMagicSeedAddress = u32(esp32PppMagicSeedStorage)

@inline
trusted fun esp32PppMagicSeed(): u32 = u32(ablaUnsafeLoadU32(
    nativePointerFromAddress(int(esp32PppMagicSeedAddress))))

@inline
trusted fun esp32PppSetMagicSeed(seed: u32): void = ablaUnsafeStoreU32(
    nativePointerFromAddress(int(esp32PppMagicSeedAddress)), int(seed))

trusted fun esp32PppMagicInit(): void =
    esp32PppSetMagicSeed(esp32PppMagicSeed() + esp32LwipSysJiffies())

trusted fun esp32PppMagicRandomize(): void = esp32PppMagicInit()

trusted fun esp32PppMagic(): u32 =
    (esp32HardwareRandom() << u32(16)) + esp32HardwareRandom() +
        esp32PppMagicSeed()

trusted fun esp32PppMagicRandomBytes(buffer: u32, lengthValue: u32): void {
    var destination = buffer
    var remaining = lengthValue
    while (remaining != u32(0)) {
        val random = esp32PppMagic()
        val count = if (remaining < u32(4)) remaining else u32(4)
        var index = u32(0)
        while (index < count) {
            ablaUnsafeStoreU8(
                nativePointerFromAddress(int(destination + index)),
                int((random >>> (index << u32(3))) & u32(255)))
            index = index + u32(1)
        }
        destination = destination + count
        remaining = remaining - count
    }
}

trusted fun esp32PppMagicPow(power: u32): u32 {
    if (power == u32(0)) return u32(0)
    if (power >= u32(32)) return esp32PppMagic()
    esp32PppMagic() & ~(u32(0xffffffff) << power)
}

trusted fun esp32RecoveredMagicInit(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32PppMagicInit(); a2 }
trusted fun esp32RecoveredMagicRandomize(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32PppMagicRandomize(); a2 }
trusted fun esp32RecoveredMagic(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32PppMagic()
trusted fun esp32RecoveredMagicRandomBytes(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32 { esp32PppMagicRandomBytes(a2,a3); a2 }
trusted fun esp32RecoveredMagicPow(a2:u32,a3:u32,a4:u32,a5:u32,a6:u32,a7:u32,s0:u32,s1:u32,s2:u32,s3:u32,s4:u32,s5:u32,s6:u32,s7:u32,s8:u32,s9:u32):u32=esp32PppMagicPow(a2 & u32(255))
