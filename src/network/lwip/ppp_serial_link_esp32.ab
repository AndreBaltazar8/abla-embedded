import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipPppSerialInternals(): bool {
    if (!internalFunction("esp32RecoveredPpposCreate", "pppos_create")) return false
    if (!internalFunction("esp32RecoveredPpposInputSys", "pppos_input_sys")) return false
    if (!internalFunction("esp32RecoveredPpposInputTcpip", "pppos_input_tcpip")) return false
    if (!internalFunction("esp32RecoveredPpposInput", "pppos_input")) return false
    true
}
