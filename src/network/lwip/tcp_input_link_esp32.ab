import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipTcpInputInternals(): bool {
    if (!internalFunction("esp32RecoveredTcpInput", "tcp_input")) return false
    if (!internalFunction("esp32RecoveredTcpTriggerInputPcbClose", "tcp_trigger_input_pcb_close")) return false
    true
}
