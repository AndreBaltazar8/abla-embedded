import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipSocketsExtensionsInternals(): bool {
    if (!internalFunction("esp32LwipSetsockoptImplExt", "lwip_setsockopt_impl_ext")) return false
    if (!internalFunction("esp32LwipGetsockoptImplExt", "lwip_getsockopt_impl_ext")) return false
    true
}
