import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipEtharpInternals(): bool {
    if (!internalFunction("esp32RecoveredEtharpAddStaticEntry", "etharp_add_static_entry")) return false
    if (!internalFunction("esp32RecoveredEtharpRemoveStaticEntry", "etharp_remove_static_entry")) return false
    if (!internalFunction("esp32RecoveredEtharpCleanupNetif", "etharp_cleanup_netif")) return false
    if (!internalFunction("esp32RecoveredEtharpFindAddr", "etharp_find_addr")) return false
    if (!internalFunction("esp32RecoveredEtharpGetEntry", "etharp_get_entry")) return false
    if (!internalFunction("esp32RecoveredEtharpInput", "etharp_input")) return false
    if (!internalFunction("esp32RecoveredEtharpRequest", "etharp_request")) return false
    if (!internalFunction("esp32RecoveredEtharpTmr", "etharp_tmr")) return false
    if (!internalFunction("esp32RecoveredEtharpQuery", "etharp_query")) return false
    if (!internalFunction("esp32RecoveredEtharpOutput", "etharp_output")) return false
    if (!internalFunction("esp32RecoveredEtharpAcdProbe", "etharp_acd_probe")) return false
    if (!internalFunction("esp32RecoveredEtharpAcdAnnounce", "etharp_acd_announce")) return false
    true
}
