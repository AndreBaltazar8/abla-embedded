import "abla/build"

// Exact names used by recovered assembly and mixed callers.
// Internal linkage is the default; list only proven foreign roots
// with --export-function while opaque callers remain.
compile fun esp32Idf6LinkLwipIcmpIpv4Internals(): bool {
    if (!internalFunction("esp32RecoveredIcmpInput", "icmp_input")) return false
    if (!internalFunction("esp32RecoveredIcmpDestUnreach", "icmp_dest_unreach")) return false
    true
}
