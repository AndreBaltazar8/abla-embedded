import "abla/unsafe/memory"
import "../esp32/sdk/buffer.ab"
import "../power/m5pm1.ab"
import "./types.ab"

// State layout: PMIC handle u32, count u8, data pin i8, brightness u8,
// initialized u8, auto-display u8, then up to 31 packed RGB888 colors.
val m5Pm1LedStateSize = 104
val m5Pm1LedColorOffset = 9
type M5Pm1Led = int

trusted fun m5Pm1LedAt(
    storageAddress: int,
    power: M5Pm1,
    count: int = 1,
    dataPin: int = 1
): M5Pm1Led {
    if (storageAddress == 0 || !power.valid() || count < 1 || count > 31 ||
        dataPin < -1 || dataPin > 4) return M5Pm1Led(0)
    nativeAddressClear(storageAddress, m5Pm1LedStateSize)
    nativeAddressStoreU32(storageAddress, 0, power & 4294967295)
    nativeAddressStoreU8(storageAddress, 4, count)
    nativeAddressStoreU8(storageAddress, 5, dataPin)
    nativeAddressStoreU8(storageAddress, 6, 63)
    nativeAddressStoreU8(storageAddress, 8, 1)
    M5Pm1Led(storageAddress & 4294967295)
}

trusted fun m5Pm1Led(
    power: M5Pm1,
    count: int = 1,
    dataPin: int = 1
): M5Pm1Led = m5Pm1LedAt(
    nativeStaticAllocate(104), power, count, dataPin
)

fun M5Pm1Led.valid(): bool = this != 0
trusted fun M5Pm1Led.power(): M5Pm1 =
    M5Pm1(nativeAddressLoadU32(this, 0))
trusted fun M5Pm1Led.count(): int =
    if (this.valid()) ablaUnsafeLoadU8(nativeAddressPointer(this, 4)) else 0
trusted fun M5Pm1Led.dataPin(): int {
    if (!this.valid()) return -1
    val value = ablaUnsafeLoadU8(nativeAddressPointer(this, 5))
    if (value < 128) value else value - 256
}
trusted fun M5Pm1Led.brightness(): int =
    if (this.valid()) ablaUnsafeLoadU8(nativeAddressPointer(this, 6)) else 0
trusted fun M5Pm1Led.autoDisplay(): bool =
    this.valid() && ablaUnsafeLoadU8(nativeAddressPointer(this, 8)) != 0

trusted fun M5Pm1Led.begin(): bool {
    if (!this.valid() || !this.power().valid()) return false
    val power = this.power()
    val pin = this.dataPin()
    var configured = power.setLedEnableLevel(true) &&
        power.device().updateRegister8(80, 31, this.count())
    if (configured && pin >= 0) {
        configured = power.setGpioFunction(pin, m5Pm1GpioFunctionSpecial) &&
            power.setGpioDrive(pin, m5Pm1GpioPushPull)
    }
    nativeAddressStoreU8(this, 7, if (configured) 1 else 0)
    configured
}

trusted fun M5Pm1Led.setAutoDisplay(enabled: bool): void {
    if (this.valid()) nativeAddressStoreU8(this, 8, if (enabled) 1 else 0)
    return
}

trusted fun M5Pm1Led.setBrightness(brightness: int): bool {
    if (!this.valid() || brightness < 0 || brightness > 255) return false
    nativeAddressStoreU8(this, 6, brightness)
    if (this.autoDisplay()) this.display() else true
}

trusted fun M5Pm1Led.storeColor(index: int, color: RgbColor): bool {
    if (!this.valid() || index < 0 || index >= this.count()) return false
    val offset = m5Pm1LedColorOffset + index * 3
    nativeAddressStoreU8(this, offset, color.red())
    nativeAddressStoreU8(this, offset + 1, color.green())
    nativeAddressStoreU8(this, offset + 2, color.blue())
    true
}

trusted fun M5Pm1Led.color(index: int): RgbColor {
    if (!this.valid() || index < 0 || index >= this.count()) {
        return rgbColor(0, 0, 0)
    }
    val offset = m5Pm1LedColorOffset + index * 3
    rgbColor(
        ablaUnsafeLoadU8(nativeAddressPointer(this, offset)),
        ablaUnsafeLoadU8(nativeAddressPointer(this, offset + 1)),
        ablaUnsafeLoadU8(nativeAddressPointer(this, offset + 2))
    )
}

trusted fun M5Pm1Led.setColor(index: int, color: RgbColor): bool =
    this.storeColor(index, color) &&
        (if (this.autoDisplay()) this.display() else true)

trusted fun M5Pm1Led.setAllColor(color: RgbColor): bool {
    if (!this.valid()) return false
    var index = 0
    while (index < this.count()) {
        this.storeColor(index, color)
        index = index + 1
    }
    if (this.autoDisplay()) this.display() else true
}

trusted fun M5Pm1Led.display(): bool {
    if (!this.valid() || ablaUnsafeLoadU8(nativeAddressPointer(this, 7)) == 0) {
        return false
    }
    val count = this.count()
    val output = nativeBufferAt(nativeStackAllocate(62), 62)
    var index = 0
    while (index < count) {
        output.storeU16(
            index * 2,
            this.color(index).scaled(this.brightness()).rgb565()
        )
        index = index + 1
    }
    this.power().device().writeRegister(96, output, count * 2) &&
        this.power().device().updateRegister8(80, 64, 64)
}
