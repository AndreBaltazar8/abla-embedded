fun rmtLedNanosecondsTicks(nanoseconds: int, frequency: int): int =
    nanoseconds * frequency / 1000000000

fun rmtLedMicrosecondsTicks(microseconds: int, frequency: int): int =
    microseconds * frequency / 1000000

// ESP-IDF rmt_symbol_word_t packs two 15-bit durations and their levels in
// one 32-bit word. WS2812-compatible symbols start high and finish low.
fun rmtLedSymbol(highTicks: int, lowTicks: int): int =
    (highTicks & 32767) | (1 << 15) | ((lowTicks & 32767) << 16)

fun rmtLedResetSymbol(resetTicks: int): int {
    val first = resetTicks >>> 1
    (first & 32767) | (((resetTicks - first) & 32767) << 16)
}

fun rmtLedTimingValid(
    frequency: int,
    t0HighNanoseconds: int,
    t0LowNanoseconds: int,
    t1HighNanoseconds: int,
    t1LowNanoseconds: int,
    resetMicroseconds: int
): bool {
    if (frequency <= 0 || t0HighNanoseconds <= 0 ||
        t0LowNanoseconds <= 0 || t1HighNanoseconds <= 0 ||
        t1LowNanoseconds <= 0 || resetMicroseconds <= 0) return false
    val t0h = rmtLedNanosecondsTicks(t0HighNanoseconds, frequency)
    val t0l = rmtLedNanosecondsTicks(t0LowNanoseconds, frequency)
    val t1h = rmtLedNanosecondsTicks(t1HighNanoseconds, frequency)
    val t1l = rmtLedNanosecondsTicks(t1LowNanoseconds, frequency)
    val reset = rmtLedMicrosecondsTicks(resetMicroseconds, frequency)
    t0h > 0 && t0h <= 32767 && t0l > 0 && t0l <= 32767 &&
        t1h > 0 && t1h <= 32767 && t1l > 0 && t1l <= 32767 &&
        reset > 1 && reset <= 65534
}
