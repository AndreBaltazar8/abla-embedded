// SDK-free display of the existing buffered strip. Construct with caller
// storage and use storeColor followed by this explicit owned display method.
// Legacy auto-display setters still select the SDK transport; don't use them
// in a freestanding image. They are not part of this entry point's call graph.
// Do NOT call SDK begin(): the caller instead owns/configures stopped RMT3,
// its pad route, memory, APB80MHz/div1 group clock and parked GDMA channel.
// Clock must be APB and requested resolution an exact 80MHz divisor <=256.
// Entire strip state must be disjoint from descriptors and DMA waveform.
// Returns full lifecycle/recovery flags; no allocation, implicit start-up,
// SDK encoder/channel handle, or loss of the stored brightness/order/timing.
trusted fun RmtLedStrip.displayDmaOwned(dmaChannel: int, descriptors: int,
    waveform: NativeBuffer, polls: int): int {
    val storage = this.storage()
    if (!storage.hasAddressRange(0, 40)) return 2
    val count = storage.loadU16(16)
    if (!rmtLedStorageValid(storage, count) || storage.load(20) != 0 ||
        storage.loadU16(22) != rmtClockSourceEsp32Apb) return 2
    val frequency = storage.loadU32(24)
    if (frequency < 312500 || frequency > 80000000) return 2
    // Validated clock values fit u32; don't introduce a 64-bit division ABI.
    val divider = int(u32(80000000) / u32(frequency))
    if (divider * frequency != 80000000) return 2
    val bytes = rmtRgbFrameBytes(count)
    if (!esp32s3GdmaLinearTxLayoutValid(descriptors, waveform.addressValue(), bytes)) return 2
    val descriptorBytes = esp32s3GdmaLinearTxCount(bytes) * 12
    val stateStart = storage.addressValue()
    val stateEnd = stateStart + storage.capacity()
    if ((stateStart < descriptors + descriptorBytes && descriptors < stateEnd) ||
        (stateStart < waveform.addressValue() + bytes && waveform.addressValue() < stateEnd)) return 2
    val t0h = storage.loadU16(28); val t0l = storage.loadU16(30)
    val t1h = storage.loadU16(32); val t1l = storage.loadU16(34)
    val reset = storage.loadU16(36)
    // For exact APB80MHz/div clocks: ns*frequency/1e9 == ns*2/(25*div).
    // Stored timings are u16, so every intermediate below fits u32.
    val denominator = u32(25 * divider)
    val zeroHigh = int(u32(t0h * 2) / denominator)
    val zeroLow = int(u32(t0l * 2) / denominator)
    val oneHigh = int(u32(t1h * 2) / denominator)
    val oneLow = int(u32(t1l * 2) / denominator)
    val resetTicks = int(u32(reset * 80) / u32(divider))
    if (zeroHigh < 1 || zeroHigh > 32767 || zeroLow < 1 || zeroLow > 32767 ||
        oneHigh < 1 || oneHigh > 32767 || oneLow < 1 || oneLow > 32767 ||
        resetTicks < 2 || resetTicks > 65534) return 2
    esp32s3RmtWriteRgbTimedDmaOwned(dmaChannel, descriptors,
        nativeBufferAt(stateStart + 40, count * 3), count, storage.load(18),
        storage.load(19), waveform, polls, divider,
        u32(rmtLedSymbol(zeroHigh, zeroLow)), u32(rmtLedSymbol(oneHigh, oneLow)), resetTicks)
}
