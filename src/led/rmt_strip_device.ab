import "../esp32/sdk/raw_buffer.ab"
import "./types.ab"
import "./rmt_strip_logic.ab"
import "./rmt_strip_state.ab"
import "./rmt_strip_pixels.ab"

trusted noescape extern:"c" fun rmt_new_tx_channel(
    config: i64*, result: i64*
): i32
trusted noescape extern:"c" fun rmt_enable(channel: i64*): i32
trusted noescape extern:"c" fun rmt_disable(channel: i64*): i32
trusted noescape extern:"c" fun rmt_del_channel(channel: i64*): i32
trusted noescape extern:"c" fun rmt_new_bytes_encoder(
    config: i64*, result: i64*
): i32
trusted noescape extern:"c" fun rmt_new_copy_encoder(
    config: i64*, result: i64*
): i32
trusted noescape extern:"c" fun rmt_del_encoder(encoder: i64*): i32
trusted noescape extern:"c" fun rmt_transmit(
    channel: i64*,
    encoder: i64*,
    payload: i64*,
    payloadBytes: u32,
    config: i64*
): i32
trusted noescape extern:"c" fun rmt_tx_wait_all_done(
    channel: i64*, timeoutMilliseconds: i32
): i32

trusted fun RmtLedStrip.begin(): bool {
    if (!this.valid()) return false
    if (this.initialized()) return true
    val address = this.addressValue()
    val pin = this.pin()
    // Normalize the pad as low push-pull output before RMT takes ownership.
    val output = Pin(pin)
    output.write(false)
    output.output()
    // rmt_tx_channel_config_t on the 32-bit IDF 6 ABI.
    val channelConfig = nativeStackAllocate(28)
    nativeAddressClear(channelConfig, 28)
    nativeAddressStoreU32(channelConfig, 0, pin)
    // APB is source 4 on classic ESP32/S2/S3/C2/C3. Other target adapters
    // pass their IDF clock enum explicitly through rmtLedStripAt.
    nativeAddressStoreU32(
        channelConfig, 4, nativeAddressLoadU16(address, 22)
    )
    nativeAddressStoreU32(channelConfig, 8, nativeAddressLoadU32(address, 24))
    nativeAddressStoreU32(channelConfig, 12, 64)
    nativeAddressStoreU32(channelConfig, 16, 4)
    val channelCell = nativeStackAllocate(4)
    nativeAddressStoreU32(channelCell, 0, 0)
    if (rmt_new_tx_channel(
        nativePointerFromAddress(channelConfig),
        nativePointerFromAddress(channelCell)
    ) != 0) return false
    val channel = nativeAddressLoadU32(channelCell, 0)

    val frequency = nativeAddressLoadU32(address, 24)
    val bytesConfig = nativeStackAllocate(12)
    nativeAddressClear(bytesConfig, 12)
    nativeAddressStoreU32(bytesConfig, 0, rmtLedSymbol(
        rmtLedNanosecondsTicks(nativeAddressLoadU16(address, 28), frequency),
        rmtLedNanosecondsTicks(nativeAddressLoadU16(address, 30), frequency)
    ))
    nativeAddressStoreU32(bytesConfig, 4, rmtLedSymbol(
        rmtLedNanosecondsTicks(nativeAddressLoadU16(address, 32), frequency),
        rmtLedNanosecondsTicks(nativeAddressLoadU16(address, 34), frequency)
    ))
    nativeAddressStoreU32(bytesConfig, 8, 1)
    val bytesCell = nativeStackAllocate(4)
    nativeAddressStoreU32(bytesCell, 0, 0)
    if (rmt_new_bytes_encoder(
        nativePointerFromAddress(bytesConfig),
        nativePointerFromAddress(bytesCell)
    ) != 0) {
        rmt_del_channel(nativePointerFromAddress(channel))
        return false
    }
    val bytesEncoder = nativeAddressLoadU32(bytesCell, 0)

    val copyConfig = nativeStackAllocate(1)
    nativeAddressStoreU8(copyConfig, 0, 0)
    val copyCell = nativeStackAllocate(4)
    nativeAddressStoreU32(copyCell, 0, 0)
    if (rmt_new_copy_encoder(
        nativePointerFromAddress(copyConfig),
        nativePointerFromAddress(copyCell)
    ) != 0) {
        rmt_del_encoder(nativePointerFromAddress(bytesEncoder))
        rmt_del_channel(nativePointerFromAddress(channel))
        return false
    }
    val copyEncoder = nativeAddressLoadU32(copyCell, 0)
    if (rmt_enable(nativePointerFromAddress(channel)) != 0) {
        rmt_del_encoder(nativePointerFromAddress(copyEncoder))
        rmt_del_encoder(nativePointerFromAddress(bytesEncoder))
        rmt_del_channel(nativePointerFromAddress(channel))
        return false
    }
    nativeAddressStoreU32(address, 0, channel)
    nativeAddressStoreU32(address, 4, bytesEncoder)
    nativeAddressStoreU32(address, 8, copyEncoder)
    nativeAddressStoreU8(address, 20, 1)
    true
}

trusted fun RmtLedStrip.close(): bool {
    if (!this.initialized()) return false
    val channel = nativePointerFromAddress(this.channelAddress())
    val waited = rmt_tx_wait_all_done(channel, -1) == 0
    val disabled = rmt_disable(channel) == 0
    val bytesDeleted = rmt_del_encoder(
        nativePointerFromAddress(this.bytesEncoderAddress())
    ) == 0
    val copyDeleted = rmt_del_encoder(
        nativePointerFromAddress(this.copyEncoderAddress())
    ) == 0
    val channelDeleted = rmt_del_channel(channel) == 0
    nativeAddressStoreU32(this.addressValue(), 0, 0)
    nativeAddressStoreU32(this.addressValue(), 4, 0)
    nativeAddressStoreU32(this.addressValue(), 8, 0)
    nativeAddressStoreU8(this.addressValue(), 20, 0)
    waited && disabled && bytesDeleted && copyDeleted && channelDeleted
}

trusted fun RmtLedStrip.setBrightness(brightness: int): bool {
    if (!this.storeBrightness(brightness)) return false
    if (this.autoDisplay()) this.display() else true
}

trusted fun RmtLedStrip.setColor(index: int, color: RgbColor): bool =
    this.storeColor(index, color) &&
        (if (this.autoDisplay()) this.display() else true)

trusted fun RmtLedStrip.setAllColor(color: RgbColor): bool {
    if (!this.storeAllColor(color)) return false
    if (this.autoDisplay()) this.display() else true
}

trusted fun RmtLedStrip.setColors(colors: NativeBuffer,index: int,length: int): bool =
    this.storeColors(colors,index,length) && (if (this.autoDisplay()) this.display() else true)

trusted fun RmtLedStrip.setPackedColors(colors: NativeBuffer,index: int,length: int,format: int): bool =
    this.storePackedColors(colors,index,length,format) && (if (this.autoDisplay()) this.display() else true)

trusted fun RmtLedStrip.display(): bool {
    if (!this.initialized()) return false
    val channel = nativePointerFromAddress(this.channelAddress())
    if (rmt_tx_wait_all_done(channel, -1) != 0) return false
    val storage = this.storage()
    val count = this.count()
    val outputOffset = rmtLedStripHeaderSize + count * 3
    var led = 0
    while (led < count) {
        val color = this.color(led).scaled(this.brightness())
        var channelIndex = 0
        while (channelIndex < 3) {
            storage.store(
                outputOffset + led * 3 + channelIndex,
                ledOrderedChannel(color, this.colorOrder(), channelIndex)
            )
            channelIndex = channelIndex + 1
        }
        led = led + 1
    }
    val transmitConfig = nativeStackAllocate(8)
    nativeAddressClear(transmitConfig, 8)
    val configPointer = nativePointerFromAddress(transmitConfig)
    if (rmt_transmit(
        channel, nativePointerFromAddress(this.bytesEncoderAddress()),
        storage.pointerAt(outputOffset), u32(count * 3), configPointer
    ) != 0) return false
    val frequency = nativeAddressLoadU32(this.addressValue(), 24)
    val resetTicks = rmtLedMicrosecondsTicks(
        nativeAddressLoadU16(this.addressValue(), 36), frequency
    )
    val resetSymbol = nativeStackAllocate(4)
    nativeAddressStoreU32(resetSymbol, 0, rmtLedResetSymbol(resetTicks))
    if (rmt_transmit(
        channel, nativePointerFromAddress(this.copyEncoderAddress()),
        nativePointerFromAddress(resetSymbol), 4, configPointer
    ) != 0) return false
    // Both the state-backed pixel bytes and stack reset symbol stay valid
    // until the queued transfers have completed.
    rmt_tx_wait_all_done(channel, -1) == 0
}
