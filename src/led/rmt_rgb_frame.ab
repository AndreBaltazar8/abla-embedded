import "../esp32/sdk/raw_buffer.ab"
import "./types.ab"
import "./rmt_strip_logic.ab"

// RGB888 input -> finite RMT frame, without a separate reordered byte buffer.
// Includes reset-low and the zero end word; caller owns disjoint storage.
fun rmtRgbFrameBytes(count: int): int =
    if (count < 1 || count > 65535) 0 else count * 96 + 8

fun rmtRgbFrameValid(colors: NativeBuffer, count: int, order: int,
    brightness: int, zero: u32, one: u32, resetTicks: int,
    destination: NativeBuffer): bool {
    val bytes = rmtRgbFrameBytes(count)
    if (bytes == 0 || !ledColorOrderValid(order) || brightness < 0 || brightness > 255 ||
        resetTicks < 2 || resetTicks > 65534 ||
        (zero & u32(32767)) == u32(0) || ((zero >>> u32(16)) & u32(32767)) == u32(0) ||
        (one & u32(32767)) == u32(0) || ((one >>> u32(16)) & u32(32767)) == u32(0) ||
        !colors.hasAddressRange(0, count * 3) || !destination.hasAddressRange(0, bytes)) return false
    colors.addressValue() >= destination.addressValue() + bytes ||
        destination.addressValue() >= colors.addressValue() + count * 3
}

trusted fun rmtEncodeRgbFrame(colors: NativeBuffer, count: int, order: int,
    brightness: int, zero: u32, one: u32, resetTicks: int,
    destination: NativeBuffer): bool {
    if (!rmtRgbFrameValid(colors, count, order, brightness, zero, one, resetTicks, destination)) return false
    var pixel = 0
    while (pixel < count) {
        val color = rgbColor(colors.load(pixel * 3), colors.load(pixel * 3 + 1),
            colors.load(pixel * 3 + 2)).scaled(brightness)
        var channel = 0
        while (channel < 3) {
            val value = ledOrderedChannel(color, order, channel)
            var bit = 0
            while (bit < 8) {
                destination.storeU32((pixel * 24 + channel * 8 + bit) * 4,
                    int(if ((value & (128 >>> bit)) == 0) zero else one))
                bit = bit + 1
            }
            channel = channel + 1
        }
        pixel = pixel + 1
    }
    destination.storeU32(count * 96, rmtLedResetSymbol(resetTicks))
    destination.storeU32(count * 96 + 4, 0)
}
