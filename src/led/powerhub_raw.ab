import "../esp32/sdk/raw_buffer.ab"

// PowerHub MCU LED protocol from M5Unified LED_PowerHub_Class. The RTC
// shares this address; callers serialize access rather than reset the MCU.
type PowerHubLedRaw = int
trusted fun powerHubLedRaw(bus: I2cBus): PowerHubLedRaw =
    PowerHubLedRaw(if (bus.valid()) bus.device(80, 400000) & 4294967295 else 0)
fun PowerHubLedRaw.valid(): bool = this != 0
fun PowerHubLedRaw.device(): I2cDevice = I2cDevice(this & 4294967295)
trusted fun PowerHubLedRaw.close(): bool = this.valid() && this.device().close()
trusted fun PowerHubLedRaw.enable(): bool =
    this.valid() && this.device().writeRegister8(0, 1)

// Eight independent linear brightness bytes, one per LED, no heap state.
trusted fun PowerHubLedRaw.writeBrightness(levels: NativeBuffer): bool =
    this.valid() && levels.hasAddressRange(0, 8) &&
        this.device().writeRegister(128, levels, 8)

// Eight little-endian 0x00RRGGBB words: B,G,R,zero on the wire. Reject
// nonzero reserved bytes before sending; false does not imply atomic rollback
// of a partially delivered I2C frame. No separate update register is needed.
trusted fun PowerHubLedRaw.writeColors(colors: NativeBuffer): bool {
    if (!this.valid() || !colors.hasAddressRange(0, 32)) return false
    var i = 0
    while (i < 8) {
        if (colors.load(i * 4 + 3) != 0) return false
        i = i + 1
    }
    this.device().writeRegister(96, colors, 32)
}
