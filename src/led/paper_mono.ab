import "abla/unsafe/memory"
import "../esp32/sdk/buffer.ab"
import "../io_expander/m5ioe1.ab"
import "../power/m5pm1.ab"
import "./types.ab"

// Two existing device handles and the one buffered color fit in a small
// caller-owned state region. Neither backend is heap-boxed by Abla.
val paperMonoLedStateSize = 16
type PaperMonoLed = int

trusted fun paperMonoLedAt(
    storageAddress: int,
    power: M5Pm1,
    io: M5Ioe1
): PaperMonoLed {
    if (storageAddress == 0 || !power.valid() || !io.valid()) {
        return PaperMonoLed(0)
    }
    nativeAddressClear(storageAddress, paperMonoLedStateSize)
    nativeAddressStoreU32(storageAddress, 0, power & 4294967295)
    nativeAddressStoreU32(storageAddress, 4, io & 4294967295)
    nativeAddressStoreU8(storageAddress, 8, 63)
    nativeAddressStoreU8(storageAddress, 10, 1)
    PaperMonoLed(storageAddress & 4294967295)
}

trusted fun paperMonoLed(power: M5Pm1, io: M5Ioe1): PaperMonoLed =
    paperMonoLedAt(
        nativeStaticAllocate(16), power, io
    )

fun PaperMonoLed.valid(): bool = this != 0
fun PaperMonoLed.count(): int = 1
trusted fun PaperMonoLed.power(): M5Pm1 =
    M5Pm1(nativeAddressLoadU32(this, 0))
trusted fun PaperMonoLed.io(): M5Ioe1 =
    M5Ioe1(nativeAddressLoadU32(this, 4))
trusted fun PaperMonoLed.brightness(): int =
    if (this.valid()) ablaUnsafeLoadU8(nativeAddressPointer(this, 8)) else 0
trusted fun PaperMonoLed.autoDisplay(): bool =
    this.valid() && ablaUnsafeLoadU8(nativeAddressPointer(this, 10)) != 0

trusted fun PaperMonoLed.begin(): bool {
    if (!this.valid()) return false
    // PM1 LED_EN red channel is push-pull. M5IOE1 G8/G9 drive green/blue.
    val configured = this.power().device().updateRegister8(19, 32, 0) &&
        this.io().setDirection(8, true) &&
        this.io().setDirection(9, true) &&
        this.io().setHighImpedance(8, false) &&
        this.io().setHighImpedance(9, false)
    nativeAddressStoreU8(this, 9, if (configured) 1 else 0)
    configured
}

trusted fun PaperMonoLed.setAutoDisplay(enabled: bool): void {
    if (this.valid()) nativeAddressStoreU8(this, 10, if (enabled) 1 else 0)
    return
}

trusted fun PaperMonoLed.setBrightness(brightness: int): bool {
    if (!this.valid() || brightness < 0 || brightness > 255) return false
    nativeAddressStoreU8(this, 8, brightness)
    if (this.autoDisplay()) this.display() else true
}

trusted fun PaperMonoLed.color(index: int = 0): RgbColor =
    if (this.valid() && index == 0) {
        rgbColor(
            ablaUnsafeLoadU8(nativeAddressPointer(this, 11)),
            ablaUnsafeLoadU8(nativeAddressPointer(this, 12)),
            ablaUnsafeLoadU8(nativeAddressPointer(this, 13))
        )
    } else rgbColor(0, 0, 0)

trusted fun PaperMonoLed.storeColor(index: int, color: RgbColor): bool {
    if (!this.valid() || index != 0) return false
    nativeAddressStoreU8(this, 11, color.red())
    nativeAddressStoreU8(this, 12, color.green())
    nativeAddressStoreU8(this, 13, color.blue())
    true
}

trusted fun PaperMonoLed.setColor(index: int, color: RgbColor): bool =
    this.storeColor(index, color) &&
        (if (this.autoDisplay()) this.display() else true)

trusted fun PaperMonoLed.setAllColor(color: RgbColor): bool =
    this.setColor(0, color)

trusted fun PaperMonoLed.display(): bool {
    if (!this.valid() || ablaUnsafeLoadU8(nativeAddressPointer(this, 9)) == 0) {
        return false
    }
    val color = this.color()
    val brightness = this.brightness()
    val red = ledPaperBrightnessScale(color.red(), brightness)
    var green = ledPaperBrightnessScale(color.green(), brightness)
    val blue = ledPaperBrightnessScale(color.blue(), brightness)
    val redOk = this.power().setLedEnableLevel(red >= 2048)
    val greenOk = this.io().digitalWrite(8, green >= 2048)
    val blueOk = this.io().digitalWrite(9, blue >= 2048)
    if (green > 4095) green = 4095
    val pwmOk = this.io().setPwmDuty12(2, green, false, green > 0)
    redOk && greenOk && blueOk && pwmOk
}
