import "./rmt_strip_state.ab"
import "./packed_color.ab"
// Nontransmitting bulk update; source length is clipped to available LEDs.
trusted fun RmtLedStrip.storePackedColors(source: NativeBuffer,index: int,length: int,format: int): bool {
    val storage=this.storage()
    if (!storage.hasAddressRange(0,40) || !rmtLedStorageValid(storage,storage.loadU16(16))) return false
    val count=this.count()
    if (index < 0 || index > count || length < 0) return false
    val amount=if (length > count-index) count-index else length
    return ledConvertPixels(source,amount,format,nativeBufferAt(storage.addressValue()+40+index*3,amount*3))
}
