import "./types.ab"
import "../esp32/sdk/raw_buffer.ab"
// Explicit byte layouts: no host-endian/swap flag ambiguity. Alpha bytes are
// ignored, matching opaque LED output. Useful independently of RMT transport.
val ledPixelsRgb332=1
val ledPixelsRgb565Le=2
val ledPixelsRgb565Be=3
val ledPixelsRgb888=4
val ledPixelsBgr888=5
val ledPixelsRgba8888=6
val ledPixelsBgra8888=7
val ledPixelsGray8=8
fun ledPixelBytes(format: int): int =
    if (format == 1 || format == 8) 1 else if (format == 2 || format == 3) 2
    else if (format == 4 || format == 5) 3 else if (format == 6 || format == 7) 4 else 0
fun rgbColorFrom332(value: int): RgbColor {
    val r=(value>>5)&7; val g=(value>>2)&7; val b=value&3
    return rgbColor((r<<5)|(r<<2)|(r>>1),(g<<5)|(g<<2)|(g>>1),b*85)
}
fun rgbColorFrom565(value: int): RgbColor {
    val r=(value>>11)&31; val g=(value>>5)&63; val b=value&31
    return rgbColor((r<<3)|(r>>2),(g<<2)|(g>>4),(b<<3)|(b>>2))
}
// Internal decode; caller validates the full source once before the loop.
trusted fun ledPixelLoad(source: NativeBuffer,offset: int,format: int): RgbColor {
    val first=source.load(offset)
    if (format == 1) return rgbColorFrom332(first)
    if (format == 8) return rgbColor(first,first,first)
    if (format == 2) return rgbColorFrom565(first|(source.load(offset+1)<<8))
    if (format == 3) return rgbColorFrom565((first<<8)|source.load(offset+1))
    val second=source.load(offset+1); val third=source.load(offset+2)
    return if (format == 5 || format == 7) rgbColor(third,second,first) else rgbColor(first,second,third)
}
// Convert to logical RGB888. All validation precedes writes. Exact in-place
// expansion/shrink and equal-stride overlap supported; differing-stride
// partial overlap rejected because simple memmove order cannot protect it.
trusted fun ledConvertPixels(source: NativeBuffer,count: int,format: int,destination: NativeBuffer): bool {
    val width=ledPixelBytes(format)
    if (width == 0 || count < 0 || count > 65535 || !source.hasAddressRange(0,count*width) || !destination.hasAddressRange(0,count*3)) return false
    val src=source.addressValue(); val dst=destination.addressValue()
    val overlap=src < dst+count*3 && dst < src+count*width
    if (overlap && width != 3 && src != dst) return false
    val backward=overlap && (dst > src || (src == dst && width < 3))
    var index=if (backward) count-1 else 0
    var remaining=count
    while (remaining > 0) {
        val color=ledPixelLoad(source,index*width,format)
        destination.store(index*3,color.red()); destination.store(index*3+1,color.green()); destination.store(index*3+2,color.blue())
        index=index+(if (backward) -1 else 1); remaining=remaining-1
    }
    return true
}
