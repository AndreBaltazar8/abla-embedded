import "../esp32/sdk/raw_buffer.ab"

// Encode bytes into RMT symbols without an SDK encoder, heap, or hardware
// access. Caller-owned disjoint buffers; 8 little-endian u32 words per byte.
// Both halves of each symbol must have nonzero15-bit durations. Explicit
// bit ordering supports protocols beyond RGB LEDs. No end/reset marker is
// appended: the transport owns termination and memory refill boundaries.
trusted fun rmtEncodeBytes(source: NativeBuffer, bytes: int,
    destination: NativeBuffer, zero: u32, one: u32, msbFirst: bool): bool {
    if (bytes < 0 || bytes > 65535 || !source.hasAddressRange(0, bytes) ||
        !destination.hasAddressRange(0, bytes * 32) ||
        (zero & u32(32767)) == u32(0) || ((zero >>> u32(16)) & u32(32767)) == u32(0) ||
        (one & u32(32767)) == u32(0) || ((one >>> u32(16)) & u32(32767)) == u32(0)) return false
    if (bytes > 0 && source.addressValue() < destination.addressValue() + bytes * 32 &&
        destination.addressValue() < source.addressValue() + bytes) return false
    var index = 0
    while (index < bytes) {
        val value = source.load(index)
        var bit = 0
        while (bit < 8) {
            val shift = if (msbFirst) 7 - bit else bit
            val symbol = if ((value & (1 << shift)) != 0) one else zero
            destination.storeU32((index * 8 + bit) * 4, int(symbol))
            bit = bit + 1
        }
        index = index + 1
    }
    true
}
