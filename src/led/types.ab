// RGB888 packed into one scalar, with the channels in logical rather than
// transport order. LED backends reorder or quantize only at their boundary.
type RgbColor = int

fun rgbColor(red: int, green: int, blue: int): RgbColor = RgbColor(
    (red & 255) | ((green & 255) << 8) | ((blue & 255) << 16)
)

fun RgbColor.red(): int = this & 255
fun RgbColor.green(): int = (this >>> 8) & 255
fun RgbColor.blue(): int = (this >>> 16) & 255

fun ledBrightnessScale(channel: int, brightness: int): int {
    val level = (brightness & 255) + 1
    (channel & 255) * level * level >>> 16
}

fun ledPaperBrightnessScale(channel: int, brightness: int): int {
    val level = (brightness & 255) + 1
    (channel & 255) * level * level >>> 8
}

fun RgbColor.scaled(brightness: int): RgbColor = rgbColor(
    ledBrightnessScale(this.red(), brightness),
    ledBrightnessScale(this.green(), brightness),
    ledBrightnessScale(this.blue(), brightness)
)

fun RgbColor.rgb565(): int =
    ((this.red() & 248) << 8) |
        ((this.green() & 252) << 3) | (this.blue() >>> 3)

val ledColorOrderRgb = 0
val ledColorOrderRbg = 1
val ledColorOrderGrb = 2
val ledColorOrderGbr = 3
val ledColorOrderBrg = 4
val ledColorOrderBgr = 5

fun ledColorOrderValid(order: int): bool = order >= 0 && order <= 5

fun ledOrderedChannel(color: RgbColor, order: int, index: int): int {
    if (order == ledColorOrderRgb) {
        return if (index == 0) color.red()
            else if (index == 1) color.green() else color.blue()
    }
    if (order == ledColorOrderRbg) {
        return if (index == 0) color.red()
            else if (index == 1) color.blue() else color.green()
    }
    if (order == ledColorOrderGrb) {
        return if (index == 0) color.green()
            else if (index == 1) color.red() else color.blue()
    }
    if (order == ledColorOrderGbr) {
        return if (index == 0) color.green()
            else if (index == 1) color.blue() else color.red()
    }
    if (order == ledColorOrderBrg) {
        return if (index == 0) color.blue()
            else if (index == 1) color.red() else color.green()
    }
    if (index == 0) color.blue()
    else if (index == 1) color.green() else color.red()
}
