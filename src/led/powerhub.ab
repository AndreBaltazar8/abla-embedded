import "abla/unsafe/memory"
import "../esp32/i2c_idf6.ab"
import "../esp32/sdk/buffer.ab"
import "./types.ab"

// One handle owns a caller-visible fixed state region; the ESP-IDF device
// allocation remains owned by the bus and is released explicitly with close.
val powerHubLedStateSize = 32
val powerHubLedColorOffset = 8
type PowerHubLed = int

trusted fun powerHubLedAt(
    storageAddress: int,
    bus: I2cBus,
    address: int = 80,
    frequency: int = 400000
): PowerHubLed {
    if (storageAddress == 0 || !bus.valid()) return PowerHubLed(0)
    val device = bus.device(address, frequency)
    if (!device.valid()) return PowerHubLed(0)
    nativeAddressClear(storageAddress, powerHubLedStateSize)
    nativeAddressStoreU32(storageAddress, 0, device & 4294967295)
    nativeAddressStoreU8(storageAddress, 4, 63)
    nativeAddressStoreU8(storageAddress, 6, 1)
    PowerHubLed(storageAddress & 4294967295)
}

trusted fun powerHubLed(
    bus: I2cBus,
    address: int = 80,
    frequency: int = 400000
): PowerHubLed = powerHubLedAt(
    nativeStaticAllocate(32), bus, address, frequency
)

fun PowerHubLed.valid(): bool = this != 0
fun PowerHubLed.count(): int = 8
trusted fun PowerHubLed.device(): I2cDevice =
    I2cDevice(nativeAddressLoadU32(this, 0))
trusted fun PowerHubLed.brightness(): int =
    if (this.valid()) ablaUnsafeLoadU8(nativeAddressPointer(this, 4)) else 0
trusted fun PowerHubLed.autoDisplay(): bool =
    this.valid() && ablaUnsafeLoadU8(nativeAddressPointer(this, 6)) != 0

trusted fun PowerHubLed.begin(): bool {
    val initialized = this.valid() && this.device().writeRegister8(0, 1)
    if (this.valid()) {
        nativeAddressStoreU8(this, 5, if (initialized) 1 else 0)
    }
    initialized && this.setBrightness(this.brightness())
}

trusted fun PowerHubLed.close(): bool =
    this.valid() && this.device().close()

trusted fun PowerHubLed.setAutoDisplay(enabled: bool): void {
    if (this.valid()) nativeAddressStoreU8(this, 6, if (enabled) 1 else 0)
    return
}

trusted fun PowerHubLed.setBrightness(brightness: int): bool {
    if (!this.valid() || brightness < 0 || brightness > 255) return false
    nativeAddressStoreU8(this, 4, brightness)
    val levels = nativeBufferAt(nativeStackAllocate(8), 8)
    var index = 0
    while (index < 8) {
        levels.store(index, brightness)
        index = index + 1
    }
    this.device().writeRegister(128, levels, 8)
}

trusted fun PowerHubLed.storeColor(index: int, color: RgbColor): bool {
    if (!this.valid() || index < 0 || index >= 8) return false
    val offset = powerHubLedColorOffset + index * 3
    nativeAddressStoreU8(this, offset, color.red())
    nativeAddressStoreU8(this, offset + 1, color.green())
    nativeAddressStoreU8(this, offset + 2, color.blue())
    true
}

trusted fun PowerHubLed.color(index: int): RgbColor {
    if (!this.valid() || index < 0 || index >= 8) return rgbColor(0, 0, 0)
    val offset = powerHubLedColorOffset + index * 3
    rgbColor(
        ablaUnsafeLoadU8(nativeAddressPointer(this, offset)),
        ablaUnsafeLoadU8(nativeAddressPointer(this, offset + 1)),
        ablaUnsafeLoadU8(nativeAddressPointer(this, offset + 2))
    )
}

trusted fun PowerHubLed.setColor(index: int, color: RgbColor): bool =
    this.storeColor(index, color) &&
        (if (this.autoDisplay()) this.display() else true)

trusted fun PowerHubLed.setAllColor(color: RgbColor): bool {
    if (!this.valid()) return false
    var index = 0
    while (index < 8) {
        this.storeColor(index, color)
        index = index + 1
    }
    if (this.autoDisplay()) this.display() else true
}

trusted fun PowerHubLed.display(): bool {
    if (!this.valid() || ablaUnsafeLoadU8(nativeAddressPointer(this, 5)) == 0) {
        return false
    }
    val output = nativeBufferAt(nativeStackAllocate(32), 32)
    var index = 0
    while (index < 8) {
        val color = this.color(index)
        output.store(index * 4, color.blue())
        output.store(index * 4 + 1, color.green())
        output.store(index * 4 + 2, color.red())
        output.store(index * 4 + 3, 0)
        index = index + 1
    }
    this.device().writeRegister(96, output, 32)
}
