// PaperMono single LED: PMIC red, M5IOE1 GPIO8 green/GPIO9 blue. Own both
// handles and GPIO8/9/PWM channel1; sequences are not atomic across devices.
// Matches M5Unified LED_PaperMono_Class; every transport error is reported.
trusted fun paperMonoLedConfigure(power: M5Pm1, expander: M5Ioe1): bool {
    if (!power.valid() || !expander.valid()) return false
    power.device().updateRegister8(19, 32, 0) &&
        expander.setDirection(8, true) && expander.setDirection(9, true) &&
        expander.setHighImpedance(8, false) && expander.setHighImpedance(9, false)
}

// Low3 bits: RGB digital levels. Bits3..14: clamped green PWM duty.
fun paperMonoLedLevels(red: int, green: int, blue: int, brightness: int): int {
    if (red < 0 || red > 255 || green < 0 || green > 255 ||
        blue < 0 || blue > 255 || brightness < 0 || brightness > 255) return -1
    val gain = (brightness + 1) * (brightness + 1)
    val r = (red * gain) >>> 8
    val g = (green * gain) >>> 8
    val b = (blue * gain) >>> 8
    val duty = if (g > 4095) 4095 else g
    (if (r >= 2048) 1 else 0) | (if (g >= 2048) 2 else 0) |
        (if (b >= 2048) 4 else 0) | (duty << 3)
}

trusted fun paperMonoLedWrite(power: M5Pm1, expander: M5Ioe1,
    red: int, green: int, blue: int, brightness: int): bool {
    val levels = paperMonoLedLevels(red, green, blue, brightness)
    if (!power.valid() || !expander.valid() || levels < 0) return false
    val duty = levels >>> 3
    power.setLedEnableLevel((levels & 1) != 0) &&
        expander.digitalWrite(8, (levels & 2) != 0) &&
        expander.digitalWrite(9, (levels & 4) != 0) &&
        expander.setPwmDuty12(1, duty, false, duty > 0)
}
