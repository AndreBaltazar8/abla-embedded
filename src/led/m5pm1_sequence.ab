// M5Unified LED_PMIC_Class register protocol. Caller owns the PMIC and
// serializes the entire sequence; failure may leave partial configuration.
// Count occupies low5 bits. pin=-1 preserves the existing output pin route.
trusted fun M5Pm1.configureLedStrip(count: int, pin: int): bool {
    if (!this.valid() || count < 1 || count > 31 || pin < -1 || pin > 4) return false
    val device = this.device()
    if (!this.setLedEnableLevel(true) || !device.updateRegister8(80, 31, count)) return false
    if (pin < 0) return true
    val shift = (pin & 3) * 2
    device.updateRegister8(if (pin < 4) 22 else 23, 3 << shift, 3 << shift) &&
        device.updateRegister8(19, 1 << pin, 0)
}

// Caller supplies exactly the configured count of little-endian RGB565
// colors. No brightness transform is implicit. Commit is sent only after
// the complete frame write succeeds; false means delivery is not confirmed.
trusted fun M5Pm1.writeLedRgb565(colors: NativeBuffer, count: int): bool {
    if (!this.valid() || count < 1 || count > 31 ||
        !colors.hasAddressRange(0, count * 2)) return false
    val device = this.device()
    device.writeRegister(96, colors, count * 2) && device.updateRegister8(80, 64, 64)
}

// Upstream perceptual brightness mapping, RGB888 -> RGB565. Invalid inputs
// return -1; full brightness preserves the standard RGB565 conversion.
fun m5Pm1LedColor(red: int, green: int, blue: int, brightness: int): int {
    if (red < 0 || red > 255 || green < 0 || green > 255 ||
        blue < 0 || blue > 255 || brightness < 0 || brightness > 255) return -1
    val gain = (brightness + 1) * (brightness + 1)
    val r = (red * gain) >>> 16
    val g = (green * gain) >>> 16
    val b = (blue * gain) >>> 16
    ((r >>> 3) << 11) | ((g >>> 2) << 5) | (b >>> 3)
}
