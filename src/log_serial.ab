import "./esp32/sdk/raw_buffer.ab"
// Platform supplies SerialPort.tryWriteByte. Caller owns configured UART and
// serializes the whole transaction, including color reset and suffix. No
// allocation/locking/initialization. Poll limit applies PER byte, not total.
fun logSerialColor(level: int): int = if (level == 1) 31 else if (level == 2) 33 else if (level == 3) 32 else if (level == 4) 36 else 37
trusted fun logSerialResetOwned(port: SerialPort,polls: int): bool {
    // Attempt every reset byte even after failure: best effort, not proof of
    // restored terminal state if any FIFO wait fails.
    var success=port.tryWriteByte(27,polls)
    if (!port.tryWriteByte(91,polls)) success=false
    if (!port.tryWriteByte(48,polls)) success=false
    if (!port.tryWriteByte(109,polls)) success=false
    return success
}
trusted fun logSerialRenderOwned(port: SerialPort,level: int,color: bool,text: NativeBuffer,length: int,suffix: NativeBuffer,suffixLength: int,polls: int): bool {
    if (level < 0 || level > 5 || length < 0 || length > 1048576 || suffixLength < 0 || suffixLength > 4096 || polls < 1 || polls > 1000000 ||
        !text.hasAddressRange(0,length) || !suffix.hasAddressRange(0,suffixLength)) return false
    val colored=color && level != 0
    var success=true
    if (colored) {
        val code=logSerialColor(level)
        success=port.tryWriteByte(27,polls) && port.tryWriteByte(91,polls) && port.tryWriteByte(48,polls) && port.tryWriteByte(59,polls) &&
            port.tryWriteByte(51,polls) && port.tryWriteByte(code-30+48,polls) && port.tryWriteByte(109,polls)
    }
    var index=0
    while (success && index < length) {
        success=port.tryWriteByte(text.load(index),polls)
        index=index+1
    }
    if (colored && !logSerialResetOwned(port,polls)) success=false
    index=0
    while (success && index < suffixLength) {
        success=port.tryWriteByte(suffix.load(index),polls)
        index=index+1
    }
    return success
}
