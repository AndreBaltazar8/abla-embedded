import "abla/unsafe/native"

// Board-neutral, zero-storage view over one aligned atomic word owned by the
// caller. LLVM selects the target instruction, so drivers do not need an
// Xtensa/RISC-V/ARM-specific compare-exchange API or assembly block.
type AtomicU32 = int

@inline
fun atomicU32At(address: int): AtomicU32 = AtomicU32(address)

@inline
fun AtomicU32.address(): int = this

@inline
fun AtomicU32.valid(): bool =
    this.address() != 0 && (this.address() & 3) == 0

// Return the observed value. Equality with expected means replacement was
// published. Callers retain the observed word so retry loops do not need an
// additional load.
@inline
trusted fun AtomicU32.compareExchange(
    expected: u32,
    replacement: u32
): u32 = nativeAtomicCompareExchangeU32(
    this.address(), expected, replacement
)

@inline
trusted fun AtomicU32.compareExchangeRelaxed(
    expected: u32,
    replacement: u32
): u32 = nativeAtomicCompareExchangeRelaxedU32(
    this.address(), expected, replacement
)

@inline
trusted fun AtomicU32.compareSetRelaxed(
    expected: u32,
    replacement: u32
): bool = this.compareExchangeRelaxed(expected, replacement) == expected

@inline
trusted fun atomicMemoryFence(): void = nativeAtomicFence()

// Zero denotes an unclaimed word. Tokens must be nonzero and unique among
// overlapping users, not merely a CPU id (tasks on one core can interleave).
// Storage must be aligned, atomic-capable RAM initialized before publication.
// These operations never spin or disable interrupts. Short RCC critical
// sections additionally need the platform's interrupt/preemption discipline.
@inline
trusted fun AtomicU32.tryClaim(owner: u32): bool =
    this.valid() && owner != u32(0) &&
        this.compareExchange(u32(0), owner) == u32(0)

// Compare-exchange supplies the release ordering and rejects a wrong owner.
// The caller must not release while hardware/state recovery is still pending.
@inline
trusted fun AtomicU32.releaseClaim(owner: u32): bool =
    this.valid() && owner != u32(0) &&
        this.compareExchange(owner, u32(0)) == owner
