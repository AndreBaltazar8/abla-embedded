// The board-neutral AtomicU32 view (atomic_methods.ab) and the real definer of its `valid` hook.
import "abla/unsafe/native"
export import "./atomic_type.ab"
export import "./atomic_methods.ab"
export import "./hal/atomic.ab"

@exportLocal("abla_atomicu32_valid")
fun atomicU32ValidHook(recv: int): bool =
    AtomicU32(recv).address() != 0 && (AtomicU32(recv).address() & 3) == 0
