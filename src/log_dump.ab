import "./log_policy.ab"
import "./log_buffers.ab"
fun logHexDigit(value: int): int = if (value < 10) 48+value else 87+value
// Formats 1..16 exact bytes with32-bit address, four hex groups and printable
// ASCII. Unlike upstream dump, no alignment-down or word-rounded overread.
// Missing hex bytes use '__'; nonprintable bytes use '.'. No NUL/suffix.
// Returns explicit length65..80, -1invalid; output unchanged on rejection.
trusted fun logDumpLine(source: NativeBuffer,count: int,address: int,output: NativeBuffer): int {
    if (count < 1 || count > 16 || address < 0 || address > 4294967296-count || !source.hasAddressRange(0,count) ||
        !output.hasAddressRange(0,64+count) || logBuffersOverlap(source,count,output,64+count)) return -1
    output.store(0,48); output.store(1,120)
    var position=9
    var remaining=address
    while (position >= 2) { output.store(position,logHexDigit(remaining&15)); remaining=remaining>>4; position=position-1 }
    output.store(10,124)
    position=11
    var index=0
    while (index < 16) {
        if ((index&3) == 0) { output.store(position,32); position=position+1 }
        if (index < count) {
            val value=source.load(index)
            output.store(position,logHexDigit(value>>4)); output.store(position+1,logHexDigit(value&15))
        } else { output.store(position,95); output.store(position+1,95) }
        output.store(position+2,32); position=position+3; index=index+1
    }
    output.store(position,124); position=position+1
    index=0
    while (index < count) {
        val value=source.load(index)
        output.store(position+index,if (value >= 32 && value <= 126) value else 46)
        index=index+1
    }
    return position+count
}
type LogDumpResult = int
// status1success2invalid3outputfailure. Completed sourcebytes bits8..39;
// failed row's LogWriteResult bits40..47 (some sinks may have emitted it).
fun LogDumpResult.status(): int = this&255
fun LogDumpResult.bytesCompleted(): int = (this>>8)&4294967295
fun LogDumpResult.outputFailure(): LogWriteResult = LogWriteResult((this>>40)&255)
// Caller owns immutable source and80-byte writable scratch, and serializes
// sinks. Max1MiB per call to bound work. Filtered messages do not read source
// or touch scratch. Failure stops before subsequent rows; do not auto-retry.
trusted fun LogPolicy.dumpOwned(level: int,source: NativeBuffer,length: int,scratch: NativeBuffer): LogDumpResult {
    if (!this.valid() || level < 0 || level > 5 || length < 0 || length > 1048576 || !source.hasAddressRange(0,length) ||
        !scratch.hasAddressRange(0,80) || logBuffersOverlap(source,length,scratch,80)) return LogDumpResult(2)
    if (this.targets(level) == 0) return LogDumpResult(1)
    var offset=0
    while (offset < length) {
        val count=if (length-offset < 16) length-offset else 16
        val row=logDumpLine(nativeBufferAt(source.addressValue()+offset,count),count,source.addressValue()+offset,scratch)
        if (row < 0) return LogDumpResult((offset<<8)|2)
        val written=this.writeOwned(level,scratch,row)
        if (!written.succeeded()) return LogDumpResult(((written|0)<<40)|(offset<<8)|3)
        offset=offset+count
    }
    return LogDumpResult((offset<<8)|1)
}
