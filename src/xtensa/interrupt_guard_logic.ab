// Scalar, core-bound saved INTLEVEL; not an affine token. Caller must use
// strict LIFO nesting, replace consumed tokens and never restore copies.
type XtensaInterruptGuard = int
fun XtensaInterruptGuard.valid(): bool = (this & 32) != 0 && (this & ~63) == 0
fun XtensaInterruptGuard.core(): int = (this>>>4) & 1
fun XtensaInterruptGuard.previousLevel(): int = this & 15
@section(".iram1.abla.interruptGuardEnter")
trusted fun xtensaInterruptGuardEnter(): XtensaInterruptGuard {
    val previous=xtensaGuardMaskLocal()
    XtensaInterruptGuard((previous & 15) | (xtensaGuardCore()<<4) | 32)
}
// Invalid token, different core, or changed INTLEVEL: refuse without mutation.
// Restores ONLY INTLEVEL: window/exception state may have changed across calls.
@section(".iram1.abla.interruptGuardLeave")
trusted fun xtensaInterruptGuardLeave(guard: XtensaInterruptGuard): bool {
    if (!guard.valid() || guard.core() != xtensaGuardCore() || (xtensaGuardStatus() & 15) != 15) return false
    xtensaGuardRestoreLevel(guard.previousLevel())
    true
}
