// One caller-owned aligned atomic word in retained internal RAM, initially0.
// Single requester and serialized peer service (no reentrant handlers);
// peer service runs on the OTHER core at a scheduler-safe
// rendezvous with no shared locks held. Caller delivers notification separately.
// Word: generation[31:3], phase[2:0]: request1, parked2, release3, done4,
// cancelled5. Generation never wraps: exhaustion refuses further requests.
// All CAS operations are acquire/release. No raw volatile races or ABA reuse.
@section(".iram1.abla.peerParkRequest")
trusted fun xtensaPeerParkRequestOwned(address: int): int {
    if (address <= 0 || address > 0xFFFFFFFC || (address & 3) != 0) return 0
    val old=xtensaPeerParkCas(address,0,0)
    val phase=old & 7
    if ((old != 0 && phase != 4 && phase != 5) || (old>>>3) >= 0x1FFFFFFF) return 0
    val ticket=((old>>>3)+1)<<3
    if (xtensaPeerParkCas(address,old,ticket | 1) != old) return 0
    ticket
}
// Returns phase for THIS ticket, 0 for invalid/stale. Only phase2 proves peer
// parked. After phase3 caller waits for4 before releasing shared resources.
@section(".iram1.abla.peerParkStatus")
trusted fun xtensaPeerParkStatusOwned(address: int,ticket: int): int {
    if (address <= 0 || address > 0xFFFFFFFC || (address & 3) != 0 || ticket <= 0 || ticket > 0xFFFFFFF8 || (ticket & 7) != 0) return 0
    val word=xtensaPeerParkCas(address,0,0)
    if ((word & 0xFFFFFFF8) != ticket) return 0
    word & 7
}
// Cancels only before peer acceptance. If it loses to peer CAS, requester
// must release and wait for completion; it cannot treat that race as timeout.
@section(".iram1.abla.peerParkCancel")
trusted fun xtensaPeerParkCancelOwned(address: int,ticket: int): bool {
    if (xtensaPeerParkStatusOwned(address,ticket) != 1) return false
    xtensaPeerParkCas(address,ticket | 1,ticket | 5) == (ticket | 1)
}
@section(".iram1.abla.peerParkRelease")
trusted fun xtensaPeerParkReleaseOwned(address: int,ticket: int): bool {
    if (xtensaPeerParkStatusOwned(address,ticket) != 2) return false
    xtensaPeerParkCas(address,ticket | 2,ticket | 3) == (ticket | 2)
}
// Peer receives the exact ticket from notification. Late/cancelled tickets
// fail CAS, so cannot park on behalf of a later request. Blocks after accept.
@section(".iram1.abla.peerParkServe")
trusted fun xtensaPeerParkServeOwned(address: int,ticket: int): bool {
    if (xtensaPeerParkStatusOwned(address,ticket) != 1) return false
    val guard=xtensaInterruptGuardEnter()
    if (xtensaPeerParkCas(address,ticket | 1,ticket | 2) != (ticket | 1)) {
        xtensaInterruptGuardLeave(guard)
        return false
    }
    while (xtensaPeerParkCas(address,0,0) != (ticket | 3)) {}
    // Completion is published only AFTER local interrupt state is restored.
    if (!xtensaInterruptGuardLeave(guard)) return false
    xtensaPeerParkCas(address,ticket | 3,ticket | 4) == (ticket | 3)
}
