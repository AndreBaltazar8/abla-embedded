import "./assembly.ab"
import "abla/unsafe/memory"

// A lock is only its aligned internal-RAM address. The caller owns its four
// zero-initialized bytes, so using atomics never introduces module state,
// allocation, or a runtime ABI.
type XtensaSpinLock = u32

@inline
fun xtensaSpinLock(address: u32): XtensaSpinLock = XtensaSpinLock(address)

@inline
fun XtensaSpinLock.address(): u32 = this

@inline
fun XtensaSpinLock.valid(): bool =
    this.address() != u32(0) && (this.address() & u32(3)) == u32(0)

@inline
trusted fun XtensaSpinLock.tryAcquire(): bool = this.valid() &&
    xtensaAtomicCompareExchangeU32(
        this.address(), u32(0), u32(1)
    ) == u32(0)

trusted fun XtensaSpinLock.acquire(maximumAttempts: int): bool {
    if (!this.valid() || maximumAttempts <= 0) return false
    var attempt = 0
    while (attempt < maximumAttempts) {
        if (this.tryAcquire()) return true
        attempt = attempt + 1
    }
    false
}

@inline
trusted fun XtensaSpinLock.release(): void {
    if (this.valid()) {
        // A volatile Xtensa store carries the compiler and MEMW ordering needed
        // before another core observes the unlocked word.
        ablaUnsafeVolatileStoreU32(int(this.address()), u32(0))
    }
    return
}
