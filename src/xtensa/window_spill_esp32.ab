import "./assembly.ab"

// Classic ESP32 has 64 physical registers. Register-window rotation has no
// portable scalar equivalent, so the target subparser owns and validates the
// complete operation while normal Abla code sees one semantic primitive.
@naked
@section(".iram1.abla.xtensa.window_spill_nw")
trusted fun ownedXtensaWindowSpillNonWindowed(): u32 =
    $xtensa spillWindowsNonWindowed()

@naked
@section(".iram1.abla.xtensa.window_spill")
trusted fun ownedXtensaWindowSpill(): void =
    $xtensa spillWindows {xthal_window_spill_nw}
