import "./assembly.ab"

// Classic ESP32 has 64 physical registers. This is the irreducible register
// window rotation leaf; ownership and selection still happen as ordinary Abla
// functions, while the `$xtensa` provider keeps target syntax out of ablac.
@naked
trusted fun ownedXtensaWindowSpillNonWindowed(): u32 =
    $xtensa call0Result {
        rsr.windowbase a2
        addi.n a2, a2, 1
        ssr a2
        rsr.windowstart a3
        srl a2, a3
        sll a3, a3
        bgez a3, .Labla_invalid_windowstart
        srli a3, a3, 16
        or a2, a2, a3
        neg a3, a2
        and a3, a3, a2
        nsau a3, a3
        ssl a3
        srl a2, a2
        wsr.windowstart a2
        rsr.windowbase a2
        addi a2, a2, 31
        sub a3, a2, a3
        wsr.windowbase a3
        rsync
        rsr.windowstart a2
    .Labla_spill_loop:
        beqz a2, .Labla_spill_done
        bbsi.l a2, 0, .Labla_spill4
        bbsi.l a2, 1, .Labla_spill8
        bbsi.l a2, 2, .Labla_spill12
        j .Labla_invalid_window
    .Labla_spill4:
        addi a3, a9, -16
        s32i.n a4, a3, 0
        s32i.n a5, a3, 4
        s32i.n a6, a3, 8
        s32i.n a7, a3, 12
        srli a6, a2, 1
        rotw 1
        j .Labla_spill_loop
    .Labla_spill8:
        addi a3, a13, -16
        s32i.n a4, a3, 0
        s32i.n a5, a3, 4
        s32i.n a6, a3, 8
        s32i.n a7, a3, 12
        addi a3, a5, -12
        l32i.n a3, a3, 0
        addi a3, a3, -32
        s32i.n a8, a3, 0
        s32i.n a9, a3, 4
        s32i.n a10, a3, 8
        s32i.n a11, a3, 12
        srli a10, a2, 2
        rotw 2
        j .Labla_spill_loop
    .Labla_spill12:
        rotw 1
        addi a13, a13, -16
        s32i.n a0, a13, 0
        s32i.n a1, a13, 4
        s32i.n a2, a13, 8
        s32i.n a3, a13, 12
        addi a3, a1, -12
        l32i.n a3, a3, 0
        addi a13, a13, 16
        addi a3, a3, -48
        s32i.n a4, a3, 0
        s32i.n a5, a3, 4
        s32i.n a6, a3, 8
        s32i.n a7, a3, 12
        s32i.n a8, a3, 16
        s32i.n a9, a3, 20
        s32i.n a10, a3, 24
        s32i.n a11, a3, 28
        rotw -1
        srli a14, a2, 3
        rotw 3
        j .Labla_spill_loop
    .Labla_spill_done:
        rotw 1
        rsr.windowbase a2
        ssl a2
        movi.n a2, 1
        sll a2, a2
        wsr.windowstart a2
        rsync
        movi.n a2, 0
        ret.n
    .Labla_invalid_windowstart:
        movi.n a2, 1
        ret.n
    .Labla_invalid_window:
        slli a2, a2, 1
        addi.n a2, a2, 1
        rsr.windowbase a3
        bbsi.l a2, 15, 2f
    1:
        addi.n a3, a3, -1
        slli a2, a2, 1
        bbci.l a2, 15, 1b
        extui a3, a3, 0, 4
    2:
        ssl a3
        slli a3, a2, 16
        src a2, a2, a3
        extui a2, a2, 0, 16
        wsr.windowstart a2
        rsr.sar a3
        movi.n a2, 32
        sub a3, a2, a3
        wsr.windowbase a3
        rsync
        movi.n a2, 2
        ret.n
    }

@naked
trusted fun ownedXtensaWindowSpill(): void = $xtensa windowedLeaf {
    movi a6, -262160
    rsr.ps a5
    mov.n a4, a0
    and a2, a5, a6
    addi.n a2, a2, 3
    wsr.ps a2
    rsync
    // ESP-IDF keeps the non-windowed leaf in IRAM while this public wrapper
    // may remain in flash. Materialize its linker address so the call remains
    // valid even when the two sections exceed Call0's PC-relative range.
    movi a3, xthal_window_spill_nw
    callx0 a3
    mov.n a0, a4
    wsr.ps a5
    rsync
}
