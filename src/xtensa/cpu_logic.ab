val xtensaMaximumDelayCycles = 2147483647
val xtensaInterruptCount = i32(32)

// A CPU interrupt number and its INTENABLE bit stay nominal 32-bit scalars.
// They each use one machine register and add no allocation or wrapper.
type XtensaInterrupt = i32
type XtensaInterruptMask = u32
type XtensaInterruptHandler = u32
type XtensaInterruptTable = u32

@inline
fun xtensaInterrupt(number: int): XtensaInterrupt =
    if (number < 0 || number >= 32) XtensaInterrupt(i32(-1))
    else XtensaInterrupt(i32(number))

@inline
fun XtensaInterrupt.valid(): bool =
    this >= i32(0) && this < xtensaInterruptCount

@inline
fun XtensaInterrupt.number(): i32 = this

@inline
fun XtensaInterrupt.mask(): XtensaInterruptMask =
    if (!this.valid()) XtensaInterruptMask(0)
    else XtensaInterruptMask(u32(1) << u32(this.number()))

@inline
fun XtensaInterruptMask.rawValue(): u32 = this

@inline
fun XtensaInterruptHandler.rawAddress(): u32 = this

@inline
fun XtensaInterruptTable.rawAddress(): u32 = this

@inline
fun XtensaInterruptTable.entryAddress(
    interrupt: XtensaInterrupt,
    core: int,
    coreCount: int
): u32 {
    if (this.rawAddress() == 0 || !interrupt.valid() || core < 0 ||
        coreCount <= 0 || core >= coreCount) return u32(0)
    this.rawAddress() + u32(
        (int(interrupt.number()) * coreCount + core) * 8
    )
}

@inline
fun XtensaInterruptMask.contains(interrupt: XtensaInterrupt): bool =
    interrupt.valid() && (this & interrupt.mask()) != 0

// Returns -1 when the requested delay cannot be represented by the bounded
// unsigned elapsed-time comparison used by the Xtensa cycle-counter loop.
fun xtensaDelayCycleCount(
    microseconds: int,
    cpuFrequencyMegahertz: int
): int {
    if (microseconds < 0 || cpuFrequencyMegahertz <= 0) return -1
    if (microseconds >
        xtensaMaximumDelayCycles / cpuFrequencyMegahertz) return -1
    microseconds * cpuFrequencyMegahertz
}
