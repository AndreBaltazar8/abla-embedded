import "abla/unsafe/xtensa"
import "./assembly.ab"
import "./window_spill_esp32.ab"

// Compatibility entry points used by Espressif's precompiled libraries and
// Xtensa vector code. Import this target-only module once to own the dispatcher
// tables and interrupt-mask helpers instead of selecting the corresponding
// vendor archive objects.
// These names are external because existing native objects require this exact
// ABI; normal Abla code should use the typed helpers in cpu.ab.
@export("xt_ints_on")
trusted fun ownedXtensaInterruptsEnable(mask: u32): u32 {
    // Lowering this call emits both ABI-compatible initialized tables. The
    // returned address is intentionally unused; the exported function anchors
    // ownership without any runtime initialization or storage allocation.
    nativeXtensaOwnedDispatcherTableAddress()
    nativeXtensaInterruptsEnable(mask)
}

@export("xt_ints_off")
trusted fun ownedXtensaInterruptsDisable(mask: u32): u32 =
    nativeXtensaInterruptsDisable(mask)

// These compatibility leaves are ordinary Abla functions. The only target
// primitives below them are the individual Xtensa special-register
// instructions, so LLVM can inline or eliminate each path independently.
@export("xthal_get_intenable")
trusted fun ownedXtensaGetInterruptEnable(): u32 =
    xtensaReadInterruptEnableRegister()

@export("xthal_set_intenable")
trusted fun ownedXtensaSetInterruptEnable(mask: u32): void =
    xtensaWriteInterruptEnableRegister(mask)

@export("xthal_get_intread")
trusted fun ownedXtensaGetInterruptRead(): u32 =
    xtensaReadPendingInterruptRegister()

@export("xthal_get_interrupt")
trusted fun ownedXtensaGetInterrupt(): u32 =
    xtensaReadPendingInterruptRegister()

@export("xthal_set_intset")
trusted fun ownedXtensaSetInterrupt(mask: u32): void =
    xtensaWritePendingInterruptSet(mask)

@export("xthal_set_intclear")
trusted fun ownedXtensaClearInterrupt(mask: u32): void =
    xtensaWritePendingInterruptClear(mask)

@export("xthal_save_extra_nw")
@naked
trusted fun ownedXtensaSaveExtraNonWindowed(state: u32): void {
    $xtensa call0Leaf {
        rur.threadptr a3
        s32i.n a3, a2, 0
        rsr.acclo a3
        s32i.n a3, a2, 4
        rsr.acchi a3
        s32i.n a3, a2, 8
        rsr.br a3
        s32i.n a3, a2, 12
        rsr.scompare1 a3
        s32i.n a3, a2, 16
        rsr.m0 a3
        s32i.n a3, a2, 20
        rsr.m1 a3
        s32i.n a3, a2, 24
        rsr.m2 a3
        s32i.n a3, a2, 28
        rsr.m3 a3
        s32i.n a3, a2, 32
        rur.f64r_lo a3
        s32i.n a3, a2, 36
        rur.f64r_hi a3
        s32i.n a3, a2, 40
        rur.f64s a3
        s32i.n a3, a2, 44
    }
}

@export("xthal_restore_extra_nw")
@naked
trusted fun ownedXtensaRestoreExtraNonWindowed(state: u32): void {
    $xtensa call0Leaf {
        l32i.n a3, a2, 0
        wur.threadptr a3
        l32i.n a3, a2, 4
        wsr.acclo a3
        l32i.n a3, a2, 8
        wsr.acchi a3
        l32i.n a3, a2, 12
        wsr.br a3
        l32i.n a3, a2, 16
        wsr.scompare1 a3
        l32i.n a3, a2, 20
        wsr.m0 a3
        l32i.n a3, a2, 24
        wsr.m1 a3
        l32i.n a3, a2, 28
        wsr.m2 a3
        l32i.n a3, a2, 32
        wsr.m3 a3
        l32i.n a3, a2, 36
        wur.f64r_lo a3
        l32i.n a3, a2, 40
        wur.f64r_hi a3
        l32i.n a3, a2, 44
        wur.f64s a3
    }
}
