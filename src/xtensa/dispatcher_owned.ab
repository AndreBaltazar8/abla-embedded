import "abla/unsafe/xtensa"

// Compatibility entry points used by Espressif's precompiled libraries and
// Xtensa vector code. Import this target-only module once to own the dispatcher
// tables and interrupt-mask helpers instead of linking xtensa_intr_asm.S.obj.
// These names are external because existing native objects require this exact
// ABI; normal Abla code should use the typed helpers in cpu.ab.
@export("xt_ints_on")
trusted fun ownedXtensaInterruptsEnable(mask: u32): u32 {
    // Lowering this call emits both ABI-compatible initialized tables. The
    // returned address is intentionally unused; the exported function anchors
    // ownership without any runtime initialization or storage allocation.
    nativeXtensaOwnedDispatcherTableAddress()
    nativeXtensaInterruptsEnable(mask)
}

@export("xt_ints_off")
trusted fun ownedXtensaInterruptsDisable(mask: u32): u32 =
    nativeXtensaInterruptsDisable(mask)
