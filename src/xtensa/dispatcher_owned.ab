import "abla/unsafe/xtensa"
import "./assembly.ab"
import "./window_spill_esp32.ab"

// ABI entry points used by the ESP32 startup layout and Xtensa vector code.
// Import this target-only module once to make the monolithic Abla compilation
// unit own the dispatcher tables and interrupt-mask helpers. These symbols use
// the platform ABI names because vector references and linker scripts require
// them; no precompiled implementation is retained. Normal Abla code should use
// the typed helpers in cpu.ab.
trusted fun ownedXtensaInterruptsEnable(mask: u32): u32 {
    // Lowering this call emits both ABI-compatible initialized tables. The
    // returned address is intentionally unused; the exported function anchors
    // ownership without any runtime initialization or storage allocation.
    nativeXtensaOwnedDispatcherTableAddress()
    nativeXtensaInterruptsEnable(mask)
}

trusted fun ownedXtensaInterruptsDisable(mask: u32): u32 =
    nativeXtensaInterruptsDisable(mask)

// These compatibility leaves are ordinary Abla functions. The only target
// primitives below them are the individual Xtensa special-register
// instructions, so LLVM can inline or eliminate each path independently.
trusted fun ownedXtensaGetInterruptEnable(): u32 =
    xtensaReadInterruptEnableRegister()

trusted fun ownedXtensaSetInterruptEnable(mask: u32): void =
    xtensaWriteInterruptEnableRegister(mask)

trusted fun ownedXtensaGetInterruptRead(): u32 =
    xtensaReadPendingInterruptRegister()

trusted fun ownedXtensaGetInterrupt(): u32 =
    xtensaReadPendingInterruptRegister()

trusted fun ownedXtensaSetInterrupt(mask: u32): void =
    xtensaWritePendingInterruptSet(mask)

trusted fun ownedXtensaClearInterrupt(mask: u32): void =
    xtensaWritePendingInterruptClear(mask)

@naked
trusted fun ownedXtensaSaveExtraNonWindowed(state: u32): void =
    $xtensa call0SaveSpecial {
        threadptr acclo acchi br scompare1 m0 m1 m2 m3 f64r_lo f64r_hi f64s
    }

@naked
trusted fun ownedXtensaRestoreExtraNonWindowed(state: u32): void =
    $xtensa call0RestoreSpecial {
        threadptr acclo acchi br scompare1 m0 m1 m2 m3 f64r_lo f64r_hi f64s
    }
