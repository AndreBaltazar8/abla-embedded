import "abla/unsafe/mmio"
import "../atomic.ab"


// Device accesses and their ordering are ordinary LLVM operations. The fence
// lowers to MEMW on classic ESP32 and to the equivalent native operation on
// other architectures, so shared peripheral code needs no Xtensa assembly.
@inline
trusted fun xtensaDeviceLoadU32(address: u32): u32 =
    u32(ablaUnsafeVolatileLoadU32(int(address)))

@inline
trusted fun xtensaMemoryBarrier(): void =
    atomicMemoryFence()

@inline
trusted fun xtensaDeviceStoreU32(address: u32, value: u32): void {
    // Xtensa LLVM emits the required leading MEMW for a volatile store. Keep
    // the explicit trailing barrier which the device API promises.
    ablaUnsafeVolatileStoreU32(int(address), int(value))
    xtensaMemoryBarrier()
}
