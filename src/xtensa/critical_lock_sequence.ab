import "./interrupt_guard_logic.ab"
import "../esp32/sdk/raw_buffer.ab"
// Caller-owned aligned atomic-capable RAM word, initialized to zero before
// publication. Only access through this protocol while live. No recursion,
// spinning, allocation, or task switching. NMI/debug users must not use it.
// Hold briefly; all participants use the same lock, and release strict LIFO.
// Token is scalar, NOT affine: no copies, stale reuse or address substitution.
@inline
fun xtensaCriticalLockValid(word: NativeBuffer): bool =
    word.hasAddressRange(0,4) && word.addressValue() != 0 && (word.addressValue() & 3) == 0
@section(".iram1.abla.criticalLockTry")
trusted fun xtensaCriticalLockTry(word: NativeBuffer): XtensaInterruptGuard {
    if (!xtensaCriticalLockValid(word)) return XtensaInterruptGuard(0)
    val guard=xtensaInterruptGuardEnter()
    if (xtensaCriticalLockCas(word.addressValue(),0,guard.core()+1) == 0) return guard
    // No callback or yield can intervene here; same core remains masked.
    xtensaGuardRestoreLevel(guard.previousLevel())
    XtensaInterruptGuard(0)
}
@section(".iram1.abla.criticalLockRelease")
trusted fun xtensaCriticalLockRelease(word: NativeBuffer,guard: XtensaInterruptGuard): bool {
    if (!xtensaCriticalLockValid(word) || !guard.valid() || guard.core() != xtensaGuardCore() ||
        (xtensaGuardStatus() & 15) != 15) return false
    // Publish protected writes before making the word available to the peer;
    // local interrupts remain masked until after that publication.
    if (xtensaCriticalLockCas(word.addressValue(),guard.core()+1,0) != guard.core()+1) return false
    xtensaGuardRestoreLevel(guard.previousLevel())
    true
}
