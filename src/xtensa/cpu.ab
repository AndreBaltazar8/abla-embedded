import "abla/unsafe/xtensa"
import "./cpu_logic.ab"

// Xtensa CCOUNT is an unsigned wrapping 32-bit counter. The compiler widens
// the register value to Abla int without allocating or calling a runtime.
@inline
trusted fun cpuCycleCount(): int = nativeXtensaCycleCounter()

// The half-range bound makes elapsed-time comparison unambiguous across one
// CCOUNT wrap. A zero delay is accepted without touching the counter.
trusted fun delayCpuCycles(cycles: int): bool {
    if (cycles < 0 || cycles > xtensaMaximumDelayCycles) return false
    if (cycles > 0) nativeXtensaDelayCycles(cycles)
    true
}

// CCOUNT advances at the CPU clock. Callers must provide the currently active
// frequency, not the APB frequency, and keep it fixed for the call; classic
// ESP32 normally runs at 80, 160, or 240 MHz. Invalid or overlong requests fail
// before any delay begins.
trusted fun delayMicroseconds(
    microseconds: int,
    cpuFrequencyMegahertz: int
): bool {
    val cycles = xtensaDelayCycleCount(
        microseconds, cpuFrequencyMegahertz
    )
    if (cycles < 0) return false
    delayCpuCycles(cycles)
}
