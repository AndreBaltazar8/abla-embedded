import "abla/unsafe/xtensa"
import "abla/unsafe/mmio"
import "./cpu_logic.ab"

// PRID identifies the executing core. Classic dual-core ESP32 encodes this in
// bit 13; the compiler emits rsr.prid + extui directly.
@inline
trusted fun cpuCoreId(): u32 = nativeXtensaCoreId()

// Xtensa CCOUNT is an unsigned wrapping 32-bit counter. The compiler widens
// the register value to Abla int without allocating or calling a runtime.
@inline
trusted fun cpuCycleCount(): int = nativeXtensaCycleCounter()

// The half-range bound makes elapsed-time comparison unambiguous across one
// CCOUNT wrap. A zero delay is accepted without touching the counter.
trusted fun delayCpuCycles(cycles: int): bool {
    if (cycles < 0 || cycles > xtensaMaximumDelayCycles) return false
    if (cycles > 0) nativeXtensaDelayCycles(cycles)
    true
}

// CCOUNT advances at the CPU clock. Callers must provide the currently active
// frequency, not the APB frequency, and keep it fixed for the call; classic
// ESP32 normally runs at 80, 160, or 240 MHz. Invalid or overlong requests fail
// before any delay begins.
trusted fun delayMicroseconds(
    microseconds: int,
    cpuFrequencyMegahertz: int
): bool {
    val cycles = xtensaDelayCycleCount(
        microseconds, cpuFrequencyMegahertz
    )
    if (cycles < 0) return false
    delayCpuCycles(cycles)
}

// These mirror Xtensa's race-safe interrupt-mask update: all lines are
// exchanged out briefly, the selected bits are changed, and the complete mask
// is restored with rsync. The returned mask is the state before the update.
@inline
trusted fun XtensaInterruptMask.enable(): XtensaInterruptMask =
    XtensaInterruptMask(nativeXtensaInterruptsEnable(this.rawValue()))

@inline
trusted fun XtensaInterruptMask.disable(): XtensaInterruptMask =
    XtensaInterruptMask(nativeXtensaInterruptsDisable(this.rawValue()))

@inline
trusted fun XtensaInterrupt.enable(): XtensaInterruptMask = this.mask().enable()

@inline
trusted fun XtensaInterrupt.disable(): XtensaInterruptMask =
    this.mask().disable()

// Direct special-register views used by low-level schedulers and interrupt
// controllers. These are deliberately separate from enable()/disable(): a
// complete INTENABLE replacement is not a race-safe read-modify-write.
@inline
trusted fun xtensaEnabledInterrupts(): XtensaInterruptMask =
    XtensaInterruptMask(nativeXtensaInterruptEnableMask())

@inline
trusted fun XtensaInterruptMask.replaceEnabled(): void =
    nativeXtensaSetInterruptEnableMask(this.rawValue())

@inline
trusted fun xtensaPendingInterrupts(): XtensaInterruptMask =
    XtensaInterruptMask(nativeXtensaPendingInterruptMask())

@inline
trusted fun XtensaInterruptMask.setPending(): void =
    nativeXtensaSetPendingInterruptMask(this.rawValue())

@inline
trusted fun XtensaInterruptMask.clearPending(): void =
    nativeXtensaClearPendingInterruptMask(this.rawValue())

@inline
trusted fun xtensaInterruptTable(): XtensaInterruptTable =
    XtensaInterruptTable(nativeXtensaInterruptTableAddress())

// Install a no-argument native entry into the current core's linker-owned
// dispatcher slot. Disabling only this line makes the two-word publication
// atomic with respect to its dispatcher. The volatile argument store precedes
// the handler store; on Xtensa LLVM emits MEMW for both accesses.
@inline
trusted fun XtensaInterruptTable.install(
    interrupt: XtensaInterrupt,
    core: int,
    coreCount: int,
    handler: XtensaInterruptHandler
): bool {
    val entry = this.entryAddress(interrupt, core, coreCount)
    if (entry == 0 || handler.rawAddress() == 0) return false
    this.installUnchecked(interrupt, entry, handler)
    true
}

// The caller has already proved that `entry` names the selected interrupt's
// current-core table slot and that `handler` is nonzero.
@inline
trusted fun XtensaInterruptTable.installUnchecked(
    interrupt: XtensaInterrupt,
    entry: u32,
    handler: XtensaInterruptHandler
): void {
    val previous = interrupt.disable()
    mmioStoreU32(int(entry) + 4, 0)
    mmioStoreU32(int(entry), int(handler.rawAddress()))
    if (previous.contains(interrupt)) interrupt.enable()
}

// Build a handler with
// XtensaInterruptHandler(nativeXtensaInterruptHandlerAddress(myHandler)).
// The compiler accepts only a named top-level () -> void function, emits a
// native no-argument entry point, and keeps its direct Abla call graph in
// IRAM. It deliberately rejects a closure, local alias, or captured value so
// this low-level address never creates a boxed Fn value.
