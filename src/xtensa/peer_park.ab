import "./peer_park_sequence.ab"
import "./interrupt_guard.ab"
import "../atomic.ab"
import "../hal/xtensa.ab"
@inline
@export("xtensaPeerParkCas")
trusted fun xtensaPeerParkCasHook(address: int,expected: int,replacement: int): int =
    int(atomicU32At(address).compareExchange(u32(expected),u32(replacement)))
