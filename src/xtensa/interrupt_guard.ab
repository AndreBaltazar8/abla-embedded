import "./interrupt_guard_logic.ab"
// Generic LLVM assembly boundary, kept separate from the parser module's
// hosted compile-time dependencies for standalone freestanding builds.
trusted noescape extern:"inline-assembly" fun xtensaGuardRead(template: string,constraints: string): u32
trusted noescape extern:"inline-assembly" fun xtensaGuardWrite(template: string,constraints: string,value: u32): void
// Local maskable interrupts only. Does NOT park another core, acquire shared
// locks, make flash safe, or suppress debug/nonmaskable hardware exceptions.
@inline
trusted fun xtensaGuardMaskLocal(): int = int(xtensaGuardRead("rsil $0, 15","=r,~{memory}"))
@inline
trusted fun xtensaGuardCore(): int = int((xtensaGuardRead("rsr.prid $0","=r")>>>u32(13)) & u32(1))
@inline
trusted fun xtensaGuardStatus(): int = int(xtensaGuardRead("rsr.ps $0","=r,~{memory}"))
@inline
trusted fun xtensaGuardRestoreLevel(level: int): void {
    val current=xtensaGuardRead("rsr.ps $0","=r,~{memory}")
    xtensaGuardWrite("wsr.ps $0\nrsync","r,~{memory}",(current & u32(0xFFFFFFF0)) | u32(level & 15))
    return
}
