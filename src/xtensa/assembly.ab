    }
    if (mode == "semihosting") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val operation = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val arguments = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
