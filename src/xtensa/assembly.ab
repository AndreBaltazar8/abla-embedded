import "abla/compiler/parser"

// A target package defines typed inline-assembly signatures; the compiler does
// not know or enumerate Xtensa operations. The template and constraints are
// compile-time literals and the remaining values become ordinary LLVM scalar
// operands.
trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32(
    template: string,
    constraints: string
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyVoid(
    template: string,
    constraints: string
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyWriteU32(
    template: string,
    constraints: string,
    value: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32WithU32(
    template: string,
    constraints: string,
    value: u32
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32WithU32U32(
    template: string,
    constraints: string,
    first: u32,
    second: u32
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32WithU32U32U32(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32WithU32U32U32U32(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32,
    fourth: u32
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyWriteU32U32(
    template: string,
    constraints: string,
    first: u32,
    second: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid1(
    template: string,
    constraints: string,
    first: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid2(
    template: string,
    constraints: string,
    first: u32,
    second: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid3(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid5(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32,
    fourth: u32,
    fifth: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid6(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32,
    fourth: u32,
    fifth: u32,
    sixth: u32
): void

// Windowed Xtensa passes six scalar words in a10-a15 and subsequent words in
// the caller's outgoing stack area. This is a generic ABI call shape rather
// than a declaration for any particular ROM or SDK symbol.
trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid9(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32,
    fourth: u32,
    fifth: u32,
    sixth: u32,
    seventh: u32,
    eighth: u32,
    ninth: u32
): void

compile fun parseXtensaAssembly(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    val mode = parserRawTakeName(cursor)
    parserRawSkipWhitespace(cursor)
    if (mode == "read") {
        parserRawExpect(cursor, "{")
        val instruction = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (instruction == "") {
            parserFail(cursor, "Xtensa read instruction cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyReadU32",
            [syntaxString("$instruction $0"), syntaxString("=a")]
        )
    }
    if (mode == "write") {
        parserRawExpect(cursor, "(")
        val value = parserParseAblaExpression(cursor)
        parserRawExpect(cursor, ")")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "{")
        val instruction = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (instruction == "") {
            parserFail(cursor, "Xtensa write instruction cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyWriteU32",
            [
                syntaxString("$instruction $0"),
                syntaxString("a"),
                value
            ]
        )
    }
    if (mode == "load") {
        parserRawExpect(cursor, "(")
        val address = parserParseAblaExpression(cursor)
        parserRawExpect(cursor, ")")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "{")
        val instruction = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (instruction == "") {
            parserFail(cursor, "Xtensa load instruction cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyReadU32WithU32",
            [
                syntaxString(instruction),
                syntaxString("=a,a"),
                address
            ]
        )
    }
    if (mode == "store") {
        parserRawExpect(cursor, "(")
        val address = parserParseAblaExpression(cursor)
        parserRawExpect(cursor, ",")
        val value = parserParseAblaExpression(cursor)
        parserRawExpect(cursor, ")")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "{")
        val instruction = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (instruction == "") {
            parserFail(cursor, "Xtensa store instruction cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyWriteU32U32",
            [
                syntaxString(instruction),
                syntaxString("a,a"),
                address,
                value
            ]
        )
    }
    if (mode == "call0State") {
        parserRawExpect(cursor, "(")
        val state = parserParseAblaExpression(cursor)
        parserRawExpect(cursor, ")")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "{")
        val instructions = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (instructions == "") {
            parserFail(cursor, "Xtensa call0 state block cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyWriteU32",
            [
                syntaxString(instructions),
                syntaxString("{a2},~{a3},~{memory}"),
                state
            ]
        )
    }
    if (mode == "call0Result") {
        parserRawExpect(cursor, "{")
        val instructions = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (instructions == "") {
            parserFail(cursor, "Xtensa call0 result block cannot be empty")
        }
        // The containing Abla function chooses `@naked`; this target parser
        // only supplies its body operation and architecture syntax.
        return syntaxCall(
            "xtensaAssemblyReadU32",
            [
                syntaxString(instructions),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "call0Leaf") {
        parserRawExpect(cursor, "{")
        val instructions = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (instructions == "") {
            parserFail(cursor, "Xtensa call0 leaf cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString("$instructions\nret.n"),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "block") {
        parserRawExpect(cursor, "{")
        val instructions = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (instructions == "") {
            parserFail(cursor, "Xtensa instruction block cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(instructions),
                syntaxString("~{a2},~{a3},~{a4},~{a5},~{a6},~{a7},~{memory}")
            ]
        )
    }
    if (mode == "windowedLeaf") {
        parserRawExpect(cursor, "{")
        val instructions = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (instructions == "") {
            parserFail(cursor, "Xtensa windowed leaf cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "entry a1, 16\n$instructions\nretw.n"
                ),
                syntaxString("~{memory}")
            ]
        )
    }
    val tailArgumentCount = if (mode == "tail0") 0 else
        if (mode == "tail1") 1 else
        if (mode == "tail2") 2 else
        if (mode == "tail3") 3 else
        if (mode == "tail4") 4 else
        if (mode == "tail5") 5 else
        if (mode == "tail6" || mode == "tail") 6 else -1
    if (tailArgumentCount >= 0) {
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "{")
        val target = parserRawTakeName(cursor)
        parserRawExpect(cursor, "}")
        if (target == "") {
            parserFail(cursor, "Xtensa tail-call target cannot be empty")
        }
        // A windowed Xtensa adapter must perform a call8: a plain jump does
        // not update PS.CALLINC, so a target beginning with `entry` would
        // later return through an invalid register window. These zero-storage
        // façade adapters use at most the six register argument words. The
        // arity is part of this generic ABI form so unused register copies do
        // not survive merely because the foreign target is opaque.
        val instructions = if (tailArgumentCount == 0)
            "entry a1, 32\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 1)
            "entry a1, 32\nmov a10, a2\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 2)
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 3)
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmov a12, a4\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 4)
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmov a12, a4\nmov a13, a5\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 5)
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmov a12, a4\nmov a13, a5\nmov a14, a6\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmov a12, a4\nmov a13, a5\nmov a14, a6\nmov a15, a7\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(instructions),
                syntaxString("~{memory}")
            ]
        )
    }
    parserFail(
        cursor,
        "unsupported Xtensa assembly form"
    )
    syntaxInteger(0)
}

#compilerRegisterSubparser("xtensa", parseXtensaAssembly)

@inline
trusted fun xtensaReadInterruptEnableRegister(): u32 =
    $xtensa read {rsr.intenable}

@inline
trusted fun xtensaWriteInterruptEnableRegister(value: u32): void =
    $xtensa write(value) {wsr.intenable}

@inline
trusted fun xtensaReadPendingInterruptRegister(): u32 =
    $xtensa read {rsr.interrupt}

@inline
trusted fun xtensaWritePendingInterruptSet(value: u32): void =
    $xtensa write(value) {wsr.intset}

@inline
trusted fun xtensaWritePendingInterruptClear(value: u32): void =
    $xtensa write(value) {wsr.intclear}

@inline
trusted fun xtensaReadThreadPointer(): u32 =
    $xtensa read {rur.threadptr}

@inline
trusted fun xtensaWriteThreadPointer(value: u32): void =
    $xtensa write(value) {wur.threadptr}

