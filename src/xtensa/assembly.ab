@inline
trusted fun xtensaReadCompare1(): u32 =
    $xtensa read {rsr.scompare1}

@inline
trusted fun xtensaWriteCompare1(value: u32): void =
    $xtensa write(value) {wsr.scompare1}

// Classic ESP32/ESP32-S3 atomic compare-exchange. S32C1I returns the memory
// word that participated in the comparison; equality with `expected` means
// `desired` was published. The address must name aligned internal RAM: classic
// ESP32 cannot apply this instruction to cached external RAM safely.
@inline
trusted fun xtensaAtomicCompareExchangeU32(
    address: u32,
    expected: u32,
    desired: u32
): u32 = xtensaAssemblyReadU32WithU32U32U32(
    "wsr.scompare1 $2\nrsync\nmov $0, $3\ns32c1i $0, $1, 0\nmemw",
    "=&a,a,a,a,~{memory}",
    address, expected, desired
)

@inline
trusted fun xtensaReadMultiply0(): u32 = $xtensa read {rsr.m0}

@inline
trusted fun xtensaWriteMultiply0(value: u32): void =
