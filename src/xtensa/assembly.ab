            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "movi a4, $switchTarget\ncallx4 a4\nmovi a2, $currentTaskTable\nrsr.prid a4\nextui a4, a4, 13, 1\naddx4 a2, a4, a2\nl32i.n a5, a2, 0\nl32i.n a1, a5, 0\nmovi a2, $startupDoneTable\naddx4 a2, a4, a2\nmovi.n a3, 1\ns32i.n a3, a2, 0\nl32i.n a2, a1, 0\nbnez.n a2, .Labla_xtensa_context_dispatch_interrupt_\${:uid}\nl32i.n a2, a1, 12\nwur.threadptr a2\nl32i.n a3, a1, 8\nl32i.n a0, a1, 4\nrsync\nwsr.ps a3\nretw.n\n.Labla_xtensa_context_dispatch_interrupt_\${:uid}:\nmovi a3, $endOfStackOffset\nadd.n a2, a5, a3\nl32i.n a2, a2, 0\nmovi a3, $coprocessorSaveOffset\nsub a2, a2, a3\nmovi a3, -16\nand a2, a2, a3\nl16ui a3, a2, 0\nwsr.cpenable a3\nmovi a0, $contextRestoreTarget\ncallx0 a0\nrsync\nl32i.n a0, a1, 0\nret.n"
