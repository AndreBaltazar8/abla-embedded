        // in a0. Keep that ABI observation as one typed scalar primitive so
        // address normalization and all subsequent logic remain normal Abla.
        return syntaxCall(
            "xtensaAssemblyReadU32",
            [syntaxString("mov $0, a0"), syntaxString("=r")]
