    }
    if (mode == "raiseInterruptLevel") {
        parserRawExpect(cursor, "{")
        val level = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (!xtensaKnownInterruptLevel(level)) {
            parserFail(cursor, "Xtensa interrupt level must be between 0 and 15")
