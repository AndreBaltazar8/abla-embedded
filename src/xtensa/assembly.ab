                syntaxString("r,r,~{memory}"),
                entry,
                virtualAddress
            ]
        )
    }
    if (mode == "waitForInterrupt") {
        parserRawExpect(cursor, "{")
        val level = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        if (!xtensaKnownInterruptLevel(level)) {
            parserFail(cursor, "Xtensa WAITI level must be between 0 and 15")
        }
