        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val processorState = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        val numericProcessorState =
            xtensaUnsignedImmediate(processorState, 1048575)
        if (contextSaveTarget == "" || bodyTarget == "" ||
            contextRestoreTarget == "" || numericProcessorState < 0) {
            parserFail(
                cursor,
                "Xtensa user-exception handling requires three targets and processor state"
            )
        }
        // General exception selection and the handler table live in the Abla
        // body. This shell owns only the pre-call physical register snapshot,
        // windowed backtrace metadata, and exception return sequence.
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "mov.n a0, a1\naddmi a1, a1, -256\naddi a1, a1, 64\ns32i.n a0, a1, 16\ns32e a0, a1, -12\nrsr.ps a0\ns32i.n a0, a1, 8\nrsr.epc1 a0\ns32i.n a0, a1, 4\nrsr.excsave1 a0\ns32i.n a0, a1, 12\ns32e a0, a1, -16\ns32i a12, a1, 60\ns32i a13, a1, 64\nmovi a0, $contextSaveTarget\ncallx0 a0\nrsr.exccause a0\ns32i a0, a1, 80\nrsr.excvaddr a0\ns32i a0, a1, 84\nmovi a0, $processorState\nwsr.ps a0\nl32i.n a3, a1, 12\ns32e a3, a1, -16\nl32i a3, a1, 16\ns32e a3, a1, -12\nrsr.epc1 a0\nmovi a5, 3221225472\nrsync\nor a0, a0, a5\naddx2 a0, a5, a0\nmov.n a6, a1\nrsr.exccause a7\nmovi a4, $bodyTarget\ncallx4 a4\nmovi a0, $contextRestoreTarget\ncallx0 a0\nl32i.n a0, a1, 8\nwsr.ps a0\nl32i.n a0, a1, 4\nwsr.epc1 a0\nl32i.n a0, a1, 12\nl32i.n a1, a1, 16\nrsync\nrfe"
                ),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "highInterruptDispatch") {
        parserRawExpect(cursor, "{")
        parserRawSkipWhitespace(cursor)
        val level = parserRawTakeUntil(cursor, ",")
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val directBit = parserRawTakeUntil(cursor, ",")
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val directTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val contextSaveTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val reasonTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val panicTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val contextRestoreTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val processorState = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        val numericLevel = xtensaUnsignedImmediate(level, 7)
        val numericDirectBit = xtensaUnsignedImmediate(directBit, 31)
        val numericProcessorState =
            xtensaUnsignedImmediate(processorState, 1048575)
        if (numericLevel < 2 || numericDirectBit < 0 ||
            numericProcessorState < 0 || directTarget == "" ||
            contextSaveTarget == "" || reasonTarget == "" ||
            panicTarget == "" || contextRestoreTarget == "") {
            parserFail(
                cursor,
                "Xtensa high-interrupt dispatch requires a level, bit, processor state, and five targets"
            )
        }
        // The direct branch runs before a frame exists. The panic branch owns
        // the exact exception-frame layout and stack restoration, while its
        // reason/policy calculation remains an ordinary typed Abla helper.
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "rsr.interrupt a0\nextui a0, a0, $directBit, 1\nbeqz.n a0, .Labla_xtensa_high_interrupt_panic_\${:uid}\nmovi a0, $directTarget\njx a0\n.Labla_xtensa_high_interrupt_panic_\${:uid}:\nmov.n a0, a1\naddmi a1, a1, -256\naddi a1, a1, 64\ns32i.n a0, a1, 16\ns32e a0, a1, -12\nrsr.ps a0\ns32i.n a0, a1, 8\nrsr.epc$level a0\ns32i.n a0, a1, 4\nrsr.excsave$level a0\ns32i.n a0, a1, 12\ns32e a0, a1, -16\ns32i.n a12, a1, 60\ns32i a13, a1, 64\nmovi a0, $contextSaveTarget\ncallx0 a0\nrsr.excvaddr a0\ns32i a0, a1, 84\nmovi a4, $reasonTarget\ncallx4 a4\ns32i a6, a1, 80\nmovi a0, $processorState\nwsr.ps a0\nmov.n a6, a1\nmovi a4, $panicTarget\ncallx4 a4\nmovi a0, $contextRestoreTarget\ncallx0 a0\nl32i.n a0, a1, 8\nwsr.ps a0\nl32i.n a0, a1, 4\nwsr.epc$level a0\nl32i.n a0, a1, 12\nl32i.n a1, a1, 16\nrsync\nrsr.excsave$level a0\nrfi $level"
                ),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "contextSave") {
        parserRawExpect(cursor, "{")
        val extraTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val schedulerTable = parserRawTakeSymbol(cursor)
        parserRawExpect(cursor, "}")
        if (extraTarget == "" || schedulerTable == "") {
            parserFail(cursor, "Xtensa context-save targets cannot be empty")
        }
        // This CALL0 leaf snapshots registers which normal LLVM IR is not
        // allowed to observe, deliberately rotates every live window, and
        // restores the exception return registers. It is architectural state
        // capture, not application control flow.
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "s32i.n a2, a1, 20\ns32i.n a3, a1, 24\ns32i.n a4, a1, 28\ns32i.n a5, a1, 32\ns32i.n a6, a1, 36\ns32i.n a7, a1, 40\ns32i.n a8, a1, 44\ns32i.n a9, a1, 48\ns32i.n a10, a1, 52\ns32i.n a11, a1, 56\ns32i a14, a1, 68\ns32i a15, a1, 72\nrsr.sar a3\ns32i a3, a1, 76\nrsr.lbeg a3\ns32i a3, a1, 88\nrsr.lend a3\ns32i a3, a1, 92\nrsr.lcount a3\ns32i a3, a1, 96\nmov.n a9, a0\ns32i a12, a1, 100\ns32i a13, a1, 104\ns32i a9, a1, 108\nl32i.n a12, a1, 60\nl32i a13, a1, 64\nl32i.n a9, a1, 48\naddi a2, a1, 112\nmovi a0, $extraTarget\ncallx0 a0\nrsr.prid a3\nextui a3, a3, 13, 1\nmovi a2, $schedulerTable\naddx4 a3, a3, a2\nl32i.n a3, a3, 0\nbeqz a3, .Labla_xtensa_context_save_skip_spill_\${:uid}\nrsr.ps a2\nmovi a0, 15\nand a3, a2, a0\nbgeui a3, 3, .Labla_xtensa_context_save_level_\${:uid}\nmovi a3, 3\n.Labla_xtensa_context_save_level_\${:uid}:\nmovi a0, 262176\nor a3, a3, a0\nwsr.ps a3\nrsr.epc1 a0\naddmi a1, a1, 0x100\naddi a1, a1, -64\nand a12, a12, a12\nrotw 3\nand a12, a12, a12\nrotw 3\nand a12, a12, a12\nrotw 3\nand a12, a12, a12\nrotw 3\nand a12, a12, a12\nrotw 4\naddmi a1, a1, -256\naddi a1, a1, 64\nwsr.ps a2\nrsync\nwsr.epc1 a0\n.Labla_xtensa_context_save_skip_spill_\${:uid}:\nl32i a12, a1, 100\nl32i a13, a1, 104\nl32i a9, a1, 108\nmov.n a0, a9\nret.n"
                ),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "contextRestore") {
        parserRawExpect(cursor, "{")
        val extraTarget = parserRawTakeSymbol(cursor)
        parserRawExpect(cursor, "}")
        if (extraTarget == "") {
            parserFail(cursor, "Xtensa context-restore extra-state target cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "or a13, a0, a0\naddi a2, a1, 112\nmovi a0, $extraTarget\ncallx0 a0\nmov.n a0, a13\nl32i a2, a1, 88\nl32i a3, a1, 92\nwsr.lbeg a2\nl32i a2, a1, 96\nwsr.lend a3\nwsr.lcount a2\nl32i a3, a1, 76\nl32i.n a2, a1, 20\nwsr.sar a3\nl32i.n a3, a1, 24\nl32i.n a4, a1, 28\nl32i.n a5, a1, 32\nl32i.n a6, a1, 36\nl32i.n a7, a1, 40\nl32i.n a8, a1, 44\nl32i.n a9, a1, 48\nl32i.n a10, a1, 52\nl32i.n a11, a1, 56\nl32i.n a12, a1, 60\nl32i a13, a1, 64\nl32i a14, a1, 68\nl32i a15, a1, 72\nret.n"
                ),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "call0CoprocessorSave" ||
        mode == "call0CoprocessorRestore") {
        parserRawExpect(cursor, "{")
        parserRawSkipWhitespace(cursor)
        val taskStateTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val offsetTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "}")
        if (taskStateTarget == "" || offsetTable == "") {
            parserFail(cursor, "Xtensa coprocessor context symbols cannot be empty")
        }
        val instructions = if (mode == "call0CoprocessorSave")
            "rsr.cpenable a2\nbeqz.n a2, .Labla_xtensa_coproc_save_done_\${:uid}\nmov.n a14, a0\nmovi a0, $taskStateTarget\ncallx0 a0\nmov.n a0, a14\nbeqz.n a15, .Labla_xtensa_coproc_save_done_\${:uid}\ns16i a2, a15, 4\nmovi a13, $offsetTable\nl32i.n a15, a15, 8\nbbci a2, 0, .Labla_xtensa_coproc_save_done_\${:uid}\nl32i.n a14, a13, 0\nadd.n a3, a14, a15\n.Labla_xtensa_coproc_save_done_\${:uid}:\nret.n"
        else
            "mov.n a14, a0\nmovi a0, $taskStateTarget\ncallx0 a0\nmov.n a0, a14\nbeqz.n a15, .Labla_xtensa_coproc_restore_done_\${:uid}\nl16ui a3, a15, 4\nxor a3, a3, a2\ns32i.n a3, a15, 4\nmovi a13, $offsetTable\nl32i.n a15, a15, 8\nbbci a2, 0, .Labla_xtensa_coproc_restore_done_\${:uid}\nl32i.n a14, a13, 0\nadd.n a3, a14, a15\n.Labla_xtensa_coproc_restore_done_\${:uid}:\nret.n"
        return syntaxCall(
            "xtensaAssemblyVoid",
            [syntaxString(instructions), syntaxString("~{memory}")]
        )
    }
    if (mode == "spillWindowsNonWindowed") {
        parserRawExpect(cursor, "(")
        parserRawExpect(cursor, ")")
        return syntaxCall(
            "xtensaAssemblyReadU32",
            [
                syntaxString("        rsr.windowbase a2\n        addi.n a2, a2, 1\n        ssr a2\n        rsr.windowstart a3\n        srl a2, a3\n        sll a3, a3\n        bgez a3, .Labla_invalid_windowstart\n        srli a3, a3, 16\n        or a2, a2, a3\n        neg a3, a2\n        and a3, a3, a2\n        nsau a3, a3\n        ssl a3\n        srl a2, a2\n        wsr.windowstart a2\n        rsr.windowbase a2\n        addi a2, a2, 31\n        sub a3, a2, a3\n        wsr.windowbase a3\n        rsync\n        rsr.windowstart a2\n    .Labla_spill_loop:\n        beqz a2, .Labla_spill_done\n        bbsi.l a2, 0, .Labla_spill4\n        bbsi.l a2, 1, .Labla_spill8\n        bbsi.l a2, 2, .Labla_spill12\n        j .Labla_invalid_window\n    .Labla_spill4:\n        addi a3, a9, -16\n        s32i.n a4, a3, 0\n        s32i.n a5, a3, 4\n        s32i.n a6, a3, 8\n        s32i.n a7, a3, 12\n        srli a6, a2, 1\n        rotw 1\n        j .Labla_spill_loop\n    .Labla_spill8:\n        addi a3, a13, -16\n        s32i.n a4, a3, 0\n        s32i.n a5, a3, 4\n        s32i.n a6, a3, 8\n        s32i.n a7, a3, 12\n        addi a3, a5, -12\n        l32i.n a3, a3, 0\n        addi a3, a3, -32\n        s32i.n a8, a3, 0\n        s32i.n a9, a3, 4\n        s32i.n a10, a3, 8\n        s32i.n a11, a3, 12\n        srli a10, a2, 2\n        rotw 2\n        j .Labla_spill_loop\n    .Labla_spill12:\n        rotw 1\n        addi a13, a13, -16\n        s32i.n a0, a13, 0\n        s32i.n a1, a13, 4\n        s32i.n a2, a13, 8\n        s32i.n a3, a13, 12\n        addi a3, a1, -12\n        l32i.n a3, a3, 0\n        addi a13, a13, 16\n        addi a3, a3, -48\n        s32i.n a4, a3, 0\n        s32i.n a5, a3, 4\n        s32i.n a6, a3, 8\n        s32i.n a7, a3, 12\n        s32i.n a8, a3, 16\n        s32i.n a9, a3, 20\n        s32i.n a10, a3, 24\n        s32i.n a11, a3, 28\n        rotw -1\n        srli a14, a2, 3\n        rotw 3\n        j .Labla_spill_loop\n    .Labla_spill_done:\n        rotw 1\n        rsr.windowbase a2\n        ssl a2\n        movi.n a2, 1\n        sll a2, a2\n        wsr.windowstart a2\n        rsync\n        movi.n a2, 0\n        ret.n\n    .Labla_invalid_windowstart:\n        movi.n a2, 1\n        ret.n\n    .Labla_invalid_window:\n        slli a2, a2, 1\n        addi.n a2, a2, 1\n        rsr.windowbase a3\n        bbsi.l a2, 15, 2f\n    1:\n        addi.n a3, a3, -1\n        slli a2, a2, 1\n        bbci.l a2, 15, 1b\n        extui a3, a3, 0, 4\n    2:\n        ssl a3\n        slli a3, a2, 16\n        src a2, a2, a3\n        extui a2, a2, 0, 16\n        wsr.windowstart a2\n        rsr.sar a3\n        movi.n a2, 32\n        sub a3, a2, a3\n        wsr.windowbase a3\n        rsync\n        movi.n a2, 2\n        ret.n"),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "spillWindows") {
        parserRawExpect(cursor, "{")
        val target = parserRawTakeSymbol(cursor)
        parserRawExpect(cursor, "}")
        if (target == "") {
            parserFail(cursor, "Xtensa window-spill target cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "entry a1, 16\nmovi a6, -262160\nrsr.ps a5\nmov.n a4, a0\nand a2, a5, a6\naddi.n a2, a2, 3\nwsr.ps a2\nrsync\nmovi a3, $target\ncallx0 a3\nmov.n a0, a4\nwsr.ps a5\nrsync\nretw.n"
                ),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "variadicEntry") {
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "{")
        val target = parserRawTakeSymbol(cursor)
        parserRawExpect(cursor, "}")
        if (target == "") {
            parserFail(cursor, "Xtensa variadic-entry target cannot be empty")
        }
        // Windowed Xtensa keeps the first six scalar argument words in
        // a2-a7 and places later words in the caller's outgoing stack area.
        // Preserve a3-a7, then describe that split to an ordinary typed Abla
        // helper as (format, overflow base, register base, byte offset).
        // Everything after this ABI capture remains visible to LLVM.
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "entry a1, 80\ns32i a3, a1, 20\ns32i a4, a1, 24\ns32i a5, a1, 28\ns32i a6, a1, 32\ns32i a7, a1, 36\nmov a10, a2\naddi a11, a1, 48\naddi a12, a1, 16\nmovi a13, 4\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
                ),
                syntaxString("~{memory}")
            ]
        )
    }
    val tailArgumentCount = if (mode == "tail0") 0 else
        if (mode == "tail1") 1 else
        if (mode == "tail2") 2 else
        if (mode == "tail3") 3 else
        if (mode == "tail4") 4 else
        if (mode == "tail5") 5 else
        if (mode == "tail6" || mode == "tail") 6 else -1
    if (tailArgumentCount >= 0) {
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "{")
        val target = parserRawTakeSymbol(cursor)
        parserRawExpect(cursor, "}")
        if (target == "") {
            parserFail(cursor, "Xtensa tail-call target cannot be empty")
        }
        // A windowed Xtensa adapter must perform a call8: a plain jump does
        // not update PS.CALLINC, so a target beginning with `entry` would
        // later return through an invalid register window. These zero-storage
        // façade adapters use at most the six register argument words. The
        // arity is part of this generic ABI form so unused register copies do
        // not survive merely because the foreign target is opaque.
        val instructions = if (tailArgumentCount == 0)
            "entry a1, 32\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 1)
            "entry a1, 32\nmov a10, a2\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 2)
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 3)
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmov a12, a4\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 4)
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmov a12, a4\nmov a13, a5\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else if (tailArgumentCount == 5)
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmov a12, a4\nmov a13, a5\nmov a14, a6\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        else
            "entry a1, 32\nmov a10, a2\nmov a11, a3\nmov a12, a4\nmov a13, a5\nmov a14, a6\nmov a15, a7\nmovi a8, $target\ncallx8 a8\nmov a2, a10\nretw.n"
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(instructions),
                syntaxString("~{memory}")
            ]
        )
    }
    parserFail(
        cursor,
        "unsupported Xtensa assembly form"
    )
    syntaxInteger(0)
}

#compilerRegisterSubparser("xtensa", parseXtensaAssembly)

@inline
trusted fun xtensaReadInterruptEnableRegister(): u32 =
    $xtensa read {rsr.intenable}

@inline
trusted fun xtensaWriteInterruptEnableRegister(value: u32): void =
    $xtensa write(value) {wsr.intenable}

@inline
trusted fun xtensaExchangeInterruptEnableRegister(value: u32): u32 =
    $xtensa exchange(value) {xsr.intenable}

@inline
trusted fun xtensaReadPendingInterruptRegister(): u32 =
    $xtensa read {rsr.interrupt}

@inline
trusted fun xtensaReadProcessorId(): u32 =
    $xtensa read {rsr.prid}

// CCOUNT is the architectural wrapping cycle counter. Keeping the operation
// this small lets delay loops and profilers remain ordinary Abla control flow
// that LLVM can inline, fold, and reason about.
@inline
trusted fun xtensaReadCycleCount(): u32 =
    $xtensa read {rsr.ccount}

@inline
trusted fun xtensaWriteCycleCount(value: u32): void =
    $xtensa write(value) {wsr.ccount}

@inline
trusted fun xtensaReadProcessorState(): u32 =
    $xtensa read {rsr.ps}

@inline
trusted fun xtensaWriteProcessorState(value: u32): void =
    $xtensa write(value) {wsr.ps}

@inline
trusted fun xtensaReadDebugCause(): u32 =
    $xtensa read {rsr.debugcause}

@inline
trusted fun xtensaReadExceptionProgramCounter1(): u32 =
    $xtensa read {rsr.epc1}

@inline
trusted fun xtensaReadExceptionProgramCounter2(): u32 =
    $xtensa read {rsr.epc2}

@inline
trusted fun xtensaReadExceptionProgramCounter3(): u32 =
    $xtensa read {rsr.epc3}

@inline
trusted fun xtensaReadExceptionProgramCounter4(): u32 =
    $xtensa read {rsr.epc4}

@inline
trusted fun xtensaReadInstructionBreakpointEnable(): u32 =
    $xtensa read {rsr.ibreakenable}

@inline
trusted fun xtensaWriteInstructionBreakpointEnable(value: u32): void =
    $xtensa write(value) {wsr.ibreakenable}

@inline
trusted fun xtensaWriteInstructionBreakpointAddress0(value: u32): void =
    $xtensa write(value) {wsr.ibreaka0}

@inline
trusted fun xtensaWriteInstructionBreakpointAddress1(value: u32): void =
    $xtensa write(value) {wsr.ibreaka1}

@inline
trusted fun xtensaWriteDataBreakpointAddress0(value: u32): void =
    $xtensa write(value) {wsr.dbreaka0}

@inline
trusted fun xtensaWriteDataBreakpointAddress1(value: u32): void =
    $xtensa write(value) {wsr.dbreaka1}

@inline
trusted fun xtensaWriteDataBreakpointControl0(value: u32): void =
    $xtensa write(value) {wsr.dbreakc0}

@inline
trusted fun xtensaWriteDataBreakpointControl1(value: u32): void =
    $xtensa write(value) {wsr.dbreakc1}

@inline
trusted fun xtensaWriteVectorBase(value: u32): void =
    $xtensa write(value) {wsr.vecbase}

@inline
trusted fun xtensaReadCompare0(): u32 =
    $xtensa read {rsr.ccompare0}

@inline
trusted fun xtensaWriteCompare0(value: u32): void =
    $xtensa write(value) {wsr.ccompare0}

// CPENABLE has no portable scalar equivalent, but its value and all memory
// bookkeeping around it stay in ordinary typed IR. Keeping this as a single
// validated register operation lets LLVM optimize the scheduler path.
@inline
trusted fun xtensaReadCoprocessorEnable(): u32 =
    $xtensa read {rsr.cpenable}

@inline
trusted fun xtensaWriteCoprocessorEnable(value: u32): void =
    $xtensa write(value) {wsr.cpenable}

@inline
trusted fun xtensaEventSynchronize(): void =
    $xtensa eventSynchronize()

@inline
trusted fun xtensaDataSynchronize(): void =
    $xtensa dataSynchronize()

@inline
trusted fun xtensaInstructionSynchronize(): void =
    $xtensa instructionSynchronize()

// A single architectural delay slot used where a peripheral transition is
// specified in CPU cycles rather than wall-clock time.
@inline
trusted fun xtensaNoOperation(): void =
    xtensaAssemblyVoid("nop", "")

@inline
trusted fun xtensaWriteDataTlb(entry: u32, virtualAddress: u32): void =
    $xtensa writeDataTlb(entry, virtualAddress)

@inline
trusted fun xtensaWriteInstructionTlb(
    entry: u32,
    virtualAddress: u32
): void = $xtensa writeInstructionTlb(entry, virtualAddress)

@inline
trusted fun xtensaReturnAddress(): u32 =
    $xtensa returnAddress()

@inline
trusted fun xtensaStackPointer(): u32 =
    $xtensa stackPointer()

@inline
trusted fun xtensaExternalRegisterRead(address: u32): u32 =
    $xtensa externalRegisterRead(address)

@inline
trusted fun xtensaSemihosting(operation: u32, arguments: u32): void =
    $xtensa semihosting(operation, arguments)

@inline
trusted fun xtensaRestoreProcessorState(value: u32): void =
    $xtensa restoreProcessorState(value)

@inline
trusted fun xtensaRaiseInterruptLevel0(): u32 =
    $xtensa raiseInterruptLevel {0}

@inline
trusted fun xtensaRaiseInterruptLevel3(): u32 =
    $xtensa raiseInterruptLevel {3}

@inline
trusted fun xtensaRaiseInterruptLevel5(): u32 =
    $xtensa raiseInterruptLevel {5}

@inline
trusted fun xtensaTrapForever(): void =
    ablaRuntimeTrap()

@inline
trusted fun xtensaWaitForInterrupt(): void =
    $xtensa waitForInterrupt {0}

@inline
trusted fun xtensaWritePendingInterruptSet(value: u32): void =
    $xtensa write(value) {wsr.intset}

@inline
trusted fun xtensaWritePendingInterruptClear(value: u32): void =
    $xtensa write(value) {wsr.intclear}

// Unlike raiseInterruptLevel, this accepts a run-time value. Only its low
// INTLEVEL nibble is consumed, so a complete saved PS value is also valid.
@inline
trusted fun xtensaSetInterruptLevel(value: u32): u32 =
    $xtensa setInterruptLevel(value)

@inline
trusted fun xtensaReadThreadPointer(): u32 =
    $xtensa read {rur.threadptr}

@inline
trusted fun xtensaWriteThreadPointer(value: u32): void =
    $xtensa write(value) {wur.threadptr}

@inline
trusted fun xtensaReadAccumulatorLow(): u32 =
    $xtensa read {rsr.acclo}

@inline
trusted fun xtensaWriteAccumulatorLow(value: u32): void =
    $xtensa write(value) {wsr.acclo}

@inline
trusted fun xtensaReadAccumulatorHigh(): u32 =
    $xtensa read {rsr.acchi}

@inline
trusted fun xtensaWriteAccumulatorHigh(value: u32): void =
    $xtensa write(value) {wsr.acchi}

@inline
trusted fun xtensaReadBooleanRegister(): u32 =
    $xtensa read {rsr.br}

@inline
trusted fun xtensaWriteBooleanRegister(value: u32): void =
    $xtensa write(value) {wsr.br}

@inline
trusted fun xtensaReadCompare1(): u32 =
    $xtensa read {rsr.scompare1}

@inline
trusted fun xtensaWriteCompare1(value: u32): void =
    $xtensa write(value) {wsr.scompare1}

// The operation is ordinary portable Abla backed by LLVM's atomic IR. On
// classic ESP32 LLVM selects S32C1I; other boards select their native atomic
// instruction without requiring another target subparser operation. The
// address must still name aligned internal RAM on classic ESP32.
@inline
trusted fun xtensaAtomicCompareExchangeU32(
    address: u32,
    expected: u32,
    desired: u32
): u32 = atomicU32At(int(address)).compareExchange(expected, desired)

// The ESP-IDF esp_cpu_compare_and_set ABI is a relaxed primitive and emits no
// surrounding synchronization instructions. Callers that publish data should
// use xtensaAtomicCompareExchangeU32 above; compatibility shims can request
// the exact relaxed operation without embedding another assembly string.
@inline
trusted fun xtensaAtomicCompareExchangeRelaxedU32(
    address: u32,
    expected: u32,
    desired: u32
): u32 = atomicU32At(int(address)).compareExchangeRelaxed(expected, desired)

@inline
trusted fun xtensaAtomicCompareSetRelaxedU32(
    address: u32,
    expected: u32,
    desired: u32
): u32 = if (atomicU32At(int(address)).compareSetRelaxed(
    expected, desired
)) u32(1) else u32(0)

@inline
trusted fun xtensaReadMultiply0(): u32 = $xtensa read {rsr.m0}

@inline
trusted fun xtensaWriteMultiply0(value: u32): void =
    $xtensa write(value) {wsr.m0}

@inline
trusted fun xtensaReadMultiply1(): u32 = $xtensa read {rsr.m1}

@inline
trusted fun xtensaWriteMultiply1(value: u32): void =
    $xtensa write(value) {wsr.m1}

