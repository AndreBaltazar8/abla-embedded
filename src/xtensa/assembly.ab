        // no instruction text: the target grammar validates every symbol and
        // the stack-size immediate, owns unique labels, and can peephole this
        // sequence centrally for every Xtensa RTOS user.
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "s32i.n a12, a1, 60\ns32i a13, a1, 64\nmov.n a12, a0\nmovi a0, $contextSaveTarget\ncallx0 a0\nrsr.prid a4\nextui a4, a4, 13, 1\nmovi a2, $schedulerTable\naddx4 a2, a4, a2\nmovi a3, $nestingTable\naddx4 a3, a4, a3\nl32i.n a2, a2, 0\nbeqz.n a2, .Labla_xtensa_exception_enter_done_\${:uid}\nl32i.n a2, a3, 0\naddi.n a2, a2, 1\ns32i.n a2, a3, 0\nbnei a2, 1, .Labla_xtensa_exception_enter_done_\${:uid}\nmovi a2, $currentTaskTable\naddx4 a2, a4, a2\nl32i.n a2, a2, 0\nbeqz.n a2, .Labla_xtensa_exception_enter_done_\${:uid}\ns32i.n a1, a2, 0\nmovi a1, $interruptStack\naddi a1, a1, 15\nmovi a2, -16\nand a1, a1, a2\naddmi a1, a1, $stackSize\nbeqz.n a4, .Labla_xtensa_exception_enter_done_\${:uid}\naddmi a1, a1, $stackSize\n.Labla_xtensa_exception_enter_done_\${:uid}:\nmov.n a0, a12\nret.n"
                ),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "call0ExceptionExit") {
        parserRawExpect(cursor, "{")
        parserRawSkipWhitespace(cursor)
        val schedulerTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val nestingTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val currentTaskTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val switchFlagTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val prepareSwitchTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val dispatchTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val contextRestoreTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val interruptLevel = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
