            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "movi a8, $target\ncallx8 a8\n${resultMove}ret.n"
                ),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "call0ExceptionEnter") {
        parserRawExpect(cursor, "{")
        parserRawSkipWhitespace(cursor)
        val contextSaveTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val schedulerTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val nestingTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val currentTaskTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val interruptStack = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val stackSizeText = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
