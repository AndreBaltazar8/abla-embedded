        val coprocessorSaveOffset = xtensaUnsignedImmediate(
            coprocessorSaveOffsetText, 32767
        )
        if (switchTarget == "" || currentTaskTable == "" ||
            startupDoneTable == "" || contextRestoreTarget == "") {
            parserFail(cursor, "Xtensa context-dispatch symbols cannot be empty")
