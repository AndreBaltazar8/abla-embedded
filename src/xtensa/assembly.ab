    if (mode == "contextDispatch") {
        parserRawExpect(cursor, "{")
        parserRawSkipWhitespace(cursor)
        val switchTarget = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val currentTaskTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val startupDoneTable = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val endOfStackOffsetText = parserRawTakeUntil(cursor, ",")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val coprocessorSaveOffsetText = parserRawTakeUntil(cursor, ",")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
