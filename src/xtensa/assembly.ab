        // decision and callback dispatch remain ordinary Abla/LLVM control
        // flow, while the target package validates the immediate operand.
        return syntaxCall(
            "xtensaAssemblyVoid",
            [syntaxString("waiti $level"), syntaxString("~{memory}")]
