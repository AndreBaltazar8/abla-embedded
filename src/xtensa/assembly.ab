        // one dot (for example `.Ltask_wrapper`). Parse that prefix as syntax
        // instead of accepting an arbitrary raw operand, then let the normal
        // name parser validate the remainder.
        var symbolPrefix = ""
        if (parserRawAt(cursor, ".")) {
            parserRawExpect(cursor, ".")
            symbolPrefix = "."
