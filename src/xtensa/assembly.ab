        // A1 may become another task's saved stack and dispatch deliberately
        // never returns. Keeping the exact transition in validated target
        // syntax avoids an otherwise mandatory windowed helper frame. The
        // table/callback names and RSIL immediate are parsed operands, while
        // labels and the density-safe store choice are owned centrally here.
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(
                    "rsr.prid a4\nextui a4, a4, 13, 1\nmovi a2, $schedulerTable\naddx4 a2, a4, a2\nmovi a3, $nestingTable\naddx4 a3, a4, a3\nrsil a0, $interruptLevel\nl32i.n a2, a2, 0\nbeqz.n a2, .Labla_xtensa_exception_exit_restore_\${:uid}\nl32i.n a2, a3, 0\naddi.n a2, a2, -1\ns32i.n a2, a3, 0\nbnez.n a2, .Labla_xtensa_exception_exit_restore_\${:uid}\nmovi a2, $currentTaskTable\naddx4 a2, a4, a2\nl32i.n a2, a2, 0\nbeqz.n a2, .Labla_xtensa_exception_exit_switch_\${:uid}\nl32i.n a1, a2, 0\nmovi a2, $switchFlagTable\naddx4 a2, a4, a2\nl32i.n a3, a2, 0\nbeqz.n a3, .Labla_xtensa_exception_exit_restore_\${:uid}\nmovi.n a3, 0\ns32i.n a3, a2, 0\n.Labla_xtensa_exception_exit_switch_\${:uid}:\nmovi a4, $prepareSwitchTarget\ncallx4 a4\nmovi a0, $dispatchTarget\ncallx0 a0\n.Labla_xtensa_exception_exit_restore_\${:uid}:\nmovi a0, $contextRestoreTarget\ncallx0 a0\nl32i.n a0, a1, 0\nret.n"
                ),
                syntaxString("~{memory}")
            ]
        )
