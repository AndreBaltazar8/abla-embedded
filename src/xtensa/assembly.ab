        return syntaxCall(
            "xtensaAssemblyReadU32",
            [
                syntaxString("rsil $0, $level"),
                syntaxString("=r,~{memory}")
            ]
        )
    }
    if (mode == "setInterruptLevel") {
        parserRawExpect(cursor, "(")
