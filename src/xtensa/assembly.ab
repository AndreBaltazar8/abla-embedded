    if (mode == "externalRegisterRead") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val address = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        // RER is the Xtensa external-register read primitive. Keep its
        // address and result as typed operands so surrounding masks and
        // branches remain visible to LLVM.
        return syntaxCall(
            "xtensaAssemblyReadU32WithU32",
            [
                syntaxString("rer $0, $1"),
                syntaxString("=r,r,~{memory}"),
                address
            ]
        )
    }
    if (mode == "eventSynchronize") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return syntaxCall(
            "xtensaAssemblyVoid",
            [syntaxString("esync"), syntaxString("~{memory}")]
        )
    }
    if (mode == "dataSynchronize" || mode == "instructionSynchronize") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return syntaxCall(
            "xtensaAssemblyVoid",
            [
                syntaxString(if (mode == "dataSynchronize") "dsync" else "isync"),
                syntaxString("~{memory}")
            ]
        )
    }
    if (mode == "writeDataTlb" || mode == "writeInstructionTlb") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val entry = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val virtualAddress = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return syntaxCall(
            "xtensaAssemblyWriteU32U32",
            [
                syntaxString(
                    if (mode == "writeDataTlb") "wdtlb $0, $1"
