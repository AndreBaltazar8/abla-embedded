        if (direction == "underflow" && width == "12") instructions =
            "l32e a0, a13, -16\nl32e a1, a13, -12\nl32e a2, a13, -8\nl32e a11, a1, -12\nl32e a3, a13, -4\nl32e a4, a11, -48\nl32e a5, a11, -44\nl32e a6, a11, -40\nl32e a7, a11, -36\nl32e a8, a11, -32\nl32e a9, a11, -28\nl32e a10, a11, -24\nl32e a11, a11, -20\nrfwu"
        // The alloca exception entry shares the unused tail of the Underflow-4
