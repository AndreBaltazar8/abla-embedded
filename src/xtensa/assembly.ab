// A target package defines typed inline-assembly signatures; the compiler does
// not know or enumerate Xtensa operations. The template and constraints are
// compile-time literals and the remaining values become ordinary LLVM scalar
// operands.
trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32(
    template: string,
    constraints: string
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyVoid(
    template: string,
    constraints: string
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyWriteU32(
    template: string,
    constraints: string,
    value: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32WithU32(
    template: string,
    constraints: string,
    value: u32
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32WithU32U32(
    template: string,
    constraints: string,
    first: u32,
    second: u32
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32WithU32U32U32(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyReadU32WithU32U32U32U32(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32,
    fourth: u32
): u32

trusted noescape extern:"inline-assembly" fun xtensaAssemblyWriteU32U32(
    template: string,
    constraints: string,
    first: u32,
    second: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid1(
    template: string,
    constraints: string,
    first: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid2(
    template: string,
    constraints: string,
    first: u32,
    second: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid3(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid5(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32,
    fourth: u32,
    fifth: u32
): void

trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid6(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32,
    fourth: u32,
    fifth: u32,
    sixth: u32
): void

// Windowed Xtensa passes six scalar words in a10-a15 and subsequent words in
// the caller's outgoing stack area. This is a generic ABI call shape rather
// than a declaration for any particular ROM or SDK symbol.
trusted noescape extern:"inline-assembly" fun xtensaAssemblyCallVoid9(
    template: string,
    constraints: string,
    first: u32,
    second: u32,
    third: u32,
    fourth: u32,
    fifth: u32,
    sixth: u32,
    seventh: u32,
    eighth: u32,
    ninth: u32
): void

// Instruction-shaped expressions whose semantics are already representable in
// Abla are expanded to ordinary typed syntax by the target package. LLVM then
// sees their data flow instead of an opaque inline-assembly call. Architecture
// operations without an Abla equivalent stay in the validated read/write
// forms below.
compile fun xtensaBinaryOperation(mode: string): string {
    if (mode == "add") return "+"
    if (mode == "sub") return "-"
    if (mode == "and") return "&"
    if (mode == "or") return "|"
    if (mode == "xor") return "^"
    if (mode == "sll") return "<<"
    if (mode == "srl") return ">>>"
    if (mode == "sra") return ">>"
    if (mode == "mull") return "*"
    if (mode == "eq") return "=="
    if (mode == "ne") return "!="
    if (mode == "lt" || mode == "ltu") return "<"
    if (mode == "le" || mode == "leu") return "<="
    if (mode == "gt" || mode == "gtu") return ">"
    if (mode == "ge" || mode == "geu") return ">="
    ""
}

compile fun xtensaMemoryLoad(
    width: int,
    address: SyntaxExpression
): SyntaxExpression {
    val name = if (width == 8) "ablaUnsafeLoadU8" else
        if (width == 16) "ablaUnsafeLoadU16" else
        "ablaUnsafeLoadU32"
    syntaxCall(
        "u32",
        [
            syntaxCall(
                name,
                [
                    syntaxCall(
                        "nativePointerFromAddress",
                        [syntaxCall("int", [address])]
                    )
                ]
            )
        ]
    )
}

compile fun xtensaMemoryStore(
    width: int,
    address: SyntaxExpression,
    value: SyntaxExpression
): SyntaxExpression {
    val name = if (width == 8) "ablaUnsafeStoreU8" else
        if (width == 16) "ablaUnsafeStoreU16" else
        "ablaUnsafeStoreU32"
    syntaxCall(
        name,
        [
            syntaxCall(
                "nativePointerFromAddress",
                [syntaxCall("int", [address])]
            ),
            syntaxCall("int", [value])
        ]
    )
}

compile fun xtensaKnownReadInstruction(instruction: string): bool =
    instruction == "rsr.intenable" ||
    instruction == "rsr.interrupt" ||
    instruction == "rsr.prid" ||
    instruction == "rsr.ccount" ||
    instruction == "rsr.ccompare0" ||
    instruction == "rsr.ps" ||
    instruction == "rsr.excsave5" ||
    instruction == "rsr.excsave7" ||
    instruction == "rsr.epc1" ||
    instruction == "rsr.epc2" ||
    instruction == "rsr.epc3" ||
    instruction == "rsr.epc4" ||
    instruction == "rsr.epc5" ||
    instruction == "rsr.epc6" ||
    instruction == "rsr.epc7" ||
    instruction == "rsr.excsave4" ||
    instruction == "rsr.debugcause" ||
    instruction == "rsr.exccause" ||
    instruction == "rsr.cpenable" ||
    instruction == "rsr.ibreakenable" ||
    instruction == "rur.threadptr" ||
    instruction == "rsr.acclo" ||
    instruction == "rsr.acchi" ||
    instruction == "rsr.br" ||
    instruction == "rsr.scompare1" ||
    instruction == "rsr.m0" ||
    instruction == "rsr.m1" ||
    instruction == "rsr.m2" ||
    instruction == "rsr.m3" ||
    instruction == "rur.f64r_lo" ||
    instruction == "rur.f64r_hi" ||
    instruction == "rur.f64s"

compile fun xtensaKnownWriteInstruction(instruction: string): bool =
    instruction == "wsr.intenable" ||
    instruction == "wsr.intset" ||
    instruction == "wsr.intclear" ||
    instruction == "wsr.ccompare0" ||
    instruction == "wsr.ps" ||
    instruction == "wsr.ccount" ||
    instruction == "wsr.dbreaka1" ||
    instruction == "wsr.dbreakc1" ||
    instruction == "wsr.eps2" ||
    instruction == "wsr.epc1" ||
    instruction == "wsr.epc2" ||
    instruction == "wsr.epc3" ||
    instruction == "wsr.eps3" ||
    instruction == "wsr.vecbase" ||
    instruction == "wsr.cpenable" ||
    instruction == "wsr.ibreakenable" ||
    instruction == "wsr.ibreaka0" ||
    instruction == "wsr.ibreaka1" ||
    instruction == "wsr.dbreaka0" ||
    instruction == "wsr.dbreaka1" ||
    instruction == "wsr.dbreakc0" ||
    instruction == "wsr.dbreakc1" ||
    instruction == "wur.threadptr" ||
    instruction == "wsr.acclo" ||
    instruction == "wsr.acchi" ||
    instruction == "wsr.br" ||
    instruction == "wsr.scompare1" ||
    instruction == "wsr.m0" ||
    instruction == "wsr.m1" ||
    instruction == "wsr.m2" ||
    instruction == "wsr.m3" ||
    instruction == "wur.f64r_lo" ||
    instruction == "wur.f64r_hi" ||
    instruction == "wur.f64s"

compile fun xtensaKnownInterruptLevel(level: string): bool =
    level == "0" || level == "1" || level == "2" || level == "3" ||
    level == "4" || level == "5" || level == "6" || level == "7" ||
    level == "8" || level == "9" || level == "10" || level == "11" ||
    level == "12" || level == "13" || level == "14" || level == "15"

compile fun xtensaSmallUnsigned(value: string): int {
    if (value == "0") return 0
    if (value == "1") return 1
    if (value == "2") return 2
    if (value == "3") return 3
    if (value == "4") return 4
    if (value == "5") return 5
    if (value == "6") return 6
    if (value == "7") return 7
    if (value == "8") return 8
    if (value == "9") return 9
    if (value == "10") return 10
    if (value == "11") return 11
    if (value == "12") return 12
    if (value == "13") return 13
    if (value == "14") return 14
    if (value == "15") return 15
    if (value == "16") return 16
    if (value == "17") return 17
    if (value == "18") return 18
    if (value == "19") return 19
    if (value == "20") return 20
    if (value == "21") return 21
    if (value == "22") return 22
    if (value == "23") return 23
    if (value == "24") return 24
    if (value == "25") return 25
    if (value == "26") return 26
    if (value == "27") return 27
    if (value == "28") return 28
    if (value == "29") return 29
    if (value == "30") return 30
    if (value == "31") return 31
    if (value == "32") return 32
    return -1
}

compile fun xtensaUnsignedImmediate(value: string, maximum: int): int {
    if (value.size == 0) return -1
    var result = 0
    var index = 0
    while (index < value.size &&
           (value[index] == 32 || value[index] == 9 ||
            value[index] == 10 || value[index] == 13)) index = index + 1
    val digitsBegin = index
    while (index < value.size &&
           value[index] >= 48 && value[index] <= 57) {
        val byte = value[index]
        result = result * 10 + byte - 48
        if (result > maximum) return -1
        index = index + 1
    }
    if (index == digitsBegin) return -1
    while (index < value.size &&
           (value[index] == 32 || value[index] == 9 ||
            value[index] == 10 || value[index] == 13)) index = index + 1
    if (index != value.size) return -1
    result
}

compile fun xtensaSignedImmediate(
    value: string,
    minimum: int,
    maximum: int
): int {
    if (value.size == 0) return minimum - 1
    var negative = false
    var index = 0
    while (index < value.size &&
           (value[index] == 32 || value[index] == 9 ||
            value[index] == 10 || value[index] == 13)) index = index + 1
    if (index < value.size && value[index] == 45) {
        negative = true
        index = index + 1
        if (index == value.size) return minimum - 1
    }
    var result = 0
    val digitsBegin = index
    while (index < value.size &&
           value[index] >= 48 && value[index] <= 57) {
        val byte = value[index]
        result = result * 10 + byte - 48
        if (result > 4096) return minimum - 1
        index = index + 1
    }
    if (index == digitsBegin) return minimum - 1
    while (index < value.size &&
           (value[index] == 32 || value[index] == 9 ||
            value[index] == 10 || value[index] == 13)) index = index + 1
    if (index != value.size) return minimum - 1
    if (negative) result = 0 - result
    if (result < minimum || result > maximum) return minimum - 1
    result
}

compile fun xtensaSpecialReadInstruction(name: string): string {
    if (name == "threadptr") return "rur.threadptr"
    if (name == "acclo") return "rsr.acclo"
    if (name == "acchi") return "rsr.acchi"
    if (name == "br") return "rsr.br"
    if (name == "scompare1") return "rsr.scompare1"
    if (name == "m0") return "rsr.m0"
    if (name == "m1") return "rsr.m1"
    if (name == "m2") return "rsr.m2"
    if (name == "m3") return "rsr.m3"
    if (name == "f64r_lo") return "rur.f64r_lo"
    if (name == "f64r_hi") return "rur.f64r_hi"
    if (name == "f64s") return "rur.f64s"
    ""
}

compile fun xtensaSpecialWriteInstruction(name: string): string {
    if (name == "threadptr") return "wur.threadptr"
    if (name == "acclo") return "wsr.acclo"
    if (name == "acchi") return "wsr.acchi"
    if (name == "br") return "wsr.br"
    if (name == "scompare1") return "wsr.scompare1"
    if (name == "m0") return "wsr.m0"
    if (name == "m1") return "wsr.m1"
    if (name == "m2") return "wsr.m2"
    if (name == "m3") return "wsr.m3"
    if (name == "f64r_lo") return "wur.f64r_lo"
    if (name == "f64r_hi") return "wur.f64r_hi"
    if (name == "f64s") return "wur.f64s"
    ""
}

compile fun xtensaRecoveredTokenByte(byte: int): bool =
    (byte >= 65 && byte <= 90) ||
    (byte >= 97 && byte <= 122) ||
    (byte >= 48 && byte <= 57) ||
    byte == 46 || byte == 95 || byte == 36

compile fun xtensaRecoveredDirectiveKnown(name: string): bool =
    name == ".pushsection" || name == ".popsection" ||
    name == ".section" || name == ".text" || name == ".data" ||
    name == ".bss" || name == ".p2align" || name == ".balign" ||
    name == ".align" || name == ".local" || name == ".global" ||
    name == ".weak" || name == ".hidden" || name == ".type" ||
    name == ".size" || name == ".literal" || name == ".reloc" ||
    name == ".set" || name == ".equ" || name == ".byte" ||
    name == ".short" || name == ".word" || name == ".long" ||
    name == ".zero" || name == ".space" || name == ".ascii" ||
    name == ".asciz" || name == ".rept" || name == ".endr" ||
    name == ".macro" || name == ".endm"

// Parse an Xtensa instruction body as records instead of accepting an opaque
// host-language string. Each non-empty line is classified as a label,
// directive, or instruction with a validated mnemonic token. The assembler
// remains the final authority for extension operands while subsequent passes
// can inspect and selectively lower this stable Abla sublanguage.
compile fun xtensaInstructionBodyValid(assembly: string): bool {
    // Xtensa/GNU extension directives evolve independently. Validate their
    // token/record shape here and leave the exact directive vocabulary to the
    // target assembler; instruction and label records remain structural too.
    parserRawLineRecordsValid(assembly, "")
}

compile fun parseXtensaAssembly(cursor: ParserCursor): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    val mode = parserRawTakeSymbol(cursor)
    parserRawSkipWhitespace(cursor)
    if (mode == "instructions" || mode == "instructionsU32" ||
        mode == "instructionsU32Pure") {
        parserRawExpect(cursor, "{")
        parserRawExpect(cursor, "\n")
        val assembly = parserRawTakeUntilText(cursor, "\n}")
        parserRawExpect(cursor, "\n}")
        if (!xtensaInstructionBodyValid(assembly)) {
            parserFail(
                cursor,
                "invalid Xtensa instruction or directive record"
            )
        }
        val instructionFunction = if (mode == "instructionsU32" ||
            mode == "instructionsU32Pure") {
            "xtensaAssemblyReadU32"
        } else "xtensaAssemblyVoid"
        val instructionConstraints = if (mode == "instructionsU32Pure") {
            "=r"
        } else "~{memory}"
        // Reconstructed bodies can contain section-local helper functions.
        // Xtensa's windowed ABI requires ENTRY to be the first executed
        // instruction. Establish the register window first, then jump over
        // each helper's literal pool before executing the recovered body.
        val nestedSafeAssembly = parserRawGuardNestedEntries(
            assembly,
            "entry",
            "# ABLA_XTENSA_BEGIN_NO_TRANSFORM\n",
            "\n# ABLA_XTENSA_END_NO_TRANSFORM\nj 99992f\n# ABLA_XTENSA_LITERAL_POSITION\n.align 4\n99992:\n"
        )
        // LLVM emits a naked inline-assembly function's symbol at the start of
        // this body. Keep that symbol and numeric self-offset anchor directly
        // on ENTRY; a pre-entry pool-skip branch would violate the windowed
        // call ABI. The post-ENTRY jump skips all explicit and synthesized
        // constants while preserving the recovered instruction body.
        val openedEntry = parserRawWrapTopLevelRecord(
            nestedSafeAssembly,
            "entry",
            "# ABLA_XTENSA_BEGIN_NO_TRANSFORM\n99991:\n",
            "\n# ABLA_XTENSA_END_NO_TRANSFORM\nj 99993f\n# ABLA_XTENSA_LITERAL_POSITION\n.align 4\n99993:\n"
        )
        return syntaxCall(
            instructionFunction,
            [
                syntaxString(openedEntry),
                syntaxString(instructionConstraints)
            ]
        )
    }
    if (mode == "publish") {
        parserRawExpect(cursor, "{")
        parserRawSkipWhitespace(cursor)
        var directives = ""
        var count = 0
        while (!parserRawAt(cursor, "}")) {
            val name = parserRawTakeSymbol(cursor)
            if (name == "") {
                parserFail(cursor, "Xtensa published symbol cannot be empty")
            }
            directives = "$directives.global $name\n"
            count = count + 1
            parserRawSkipWhitespace(cursor)
            if (!parserRawAt(cursor, "}")) {
                parserRawExpect(cursor, ",")
                parserRawSkipWhitespace(cursor)
            }
        }
        parserRawExpect(cursor, "}")
        if (count == 0) {
            parserFail(cursor, "Xtensa published-symbol list cannot be empty")
        }
        return syntaxCall(
            "xtensaAssemblyVoid",
            [syntaxString(directives), syntaxString("")]
        )
    }
    val binaryOperation = xtensaBinaryOperation(mode)
    if (binaryOperation != "") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val left = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val right = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return syntaxBinary(binaryOperation, left, right)
    }
    if (mode == "mov" || mode == "movi") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val value = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return value
    }
    if (mode == "nsau") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val value = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return syntaxCall("ablaCountLeadingZerosU32", [value])
    }
    if (mode == "neg" || mode == "not") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val value = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        if (mode == "neg") {
            return syntaxBinary(
                "-", syntaxCall("u32", [syntaxInteger(0)]), value
            )
        }
        return syntaxBinary(
            "^", value, syntaxCall("u32", [syntaxInteger(4294967295)])
        )
    }
    val scaledShift = if (mode == "addx2") 1 else
        if (mode == "addx4") 2 else
        if (mode == "addx8") 3 else -1
    if (scaledShift >= 0) {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val index = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val base = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return syntaxBinary(
            "+",
            syntaxBinary("<<", index, syntaxInteger(scaledShift)),
            base
        )
    }
    if (mode == "extui") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val value = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val offset = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val width = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        val one = syntaxCall("u32", [syntaxInteger(1)])
        val mask = syntaxBinary(
            "-", syntaxBinary("<<", one, width),
            syntaxCall("u32", [syntaxInteger(1)])
        )
        return syntaxBinary(
            "&", syntaxBinary(">>>", value, offset), mask
        )
    }
    if (mode == "extractImmediate") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val value = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "{")
        parserRawSkipWhitespace(cursor)
        val offsetText = parserRawTakeUntil(cursor, ",")
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val widthText = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        val offset = xtensaSmallUnsigned(offsetText)
        val width = xtensaSmallUnsigned(widthText)
        if (offset < 0 || width < 1 || width > 16 ||
            offset + width > 32) {
            parserFail(
                cursor,
                "Xtensa EXTUI requires offset 0..31, width 1..16, and offset + width <= 32"
            )
        }
        // Expose the extraction as normal typed IR. Xtensa instruction
        // selection can still choose EXTUI, while LLVM may fold, combine, or
        // eliminate the extraction with surrounding masks and branches.
        val shifted = syntaxBinary(
            ">>>", value,
            syntaxCall("u32", [syntaxInteger(offset)])
        )
        val mask = syntaxCall(
            "u32",
            [syntaxInteger((1 << width) - 1)]
        )
        return syntaxBinary("&", shifted, mask)
    }
    val memoryLoadWidth = if (mode == "load8") 8 else
        if (mode == "load16") 16 else
        if (mode == "load32") 32 else 0
    if (memoryLoadWidth != 0) {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val address = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return xtensaMemoryLoad(memoryLoadWidth, address)
    }
    val memoryStoreWidth = if (mode == "store8") 8 else
        if (mode == "store16") 16 else
        if (mode == "store32") 32 else 0
    if (memoryStoreWidth != 0) {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val address = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val value = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return xtensaMemoryStore(memoryStoreWidth, address, value)
    }
    if (mode == "store32Offset") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val base = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val value = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "{")
        parserRawSkipWhitespace(cursor)
        val offsetText = parserRawTakeUntil(cursor, "}")
        parserRawExpect(cursor, "}")
        val offset = xtensaUnsignedImmediate(offsetText, 1020)
        if (offset < 0 || (offset & 3) != 0) {
            parserFail(
                cursor,
                "Xtensa S32I offset must be a multiple of 4 between 0 and 1020"
            )
        }
        // LLVM currently reassociates integer-address frame stores against an
        // older stack base on Xtensa, which expands every access into MOVI +
        // ADD + S32I. Preserve the semantically relevant base+immediate shape
        // after all surrounding layout arithmetic has remained typed. Choose
        // the density encoding whenever its 0..60 range can represent it.
        val instruction = if (offset <= 60) "s32i.n" else "s32i"
        return syntaxCall(
            "xtensaAssemblyWriteU32U32",
            [
                syntaxString("$instruction $1, $0, $offset"),
                syntaxString("r,r,~{memory}"),
                base,
                value
            ]
        )
    }
    if (mode == "deviceLoad32") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val address = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
        return syntaxCall("xtensaDeviceLoadU32", [address])
    }
    if (mode == "deviceStore32") {
        parserRawExpect(cursor, "(")
        parserRawSkipWhitespace(cursor)
        val address = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ",")
        parserRawSkipWhitespace(cursor)
        val value = parserParseAblaExpression(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, ")")
