    }
    if (mode == "call" || mode == "callWide" || mode == "callVoid") {
        parserRawExpect(cursor, "{")
        parserRawSkipWhitespace(cursor)
        var symbolPrefix = ""
        if (parserRawAt(cursor, ".")) {
            parserRawExpect(cursor, ".")
            symbolPrefix = "."
        }
        val symbolName = parserRawTakeSymbol(cursor)
        parserRawSkipWhitespace(cursor)
        parserRawExpect(cursor, "}")
        if (symbolName == "") {
            parserFail(cursor, "Xtensa call symbol cannot be empty")
