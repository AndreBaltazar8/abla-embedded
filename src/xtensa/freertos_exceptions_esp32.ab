import "abla/compiler/parser"
import "assembly.ab"

// Xtensa/FreeRTOS exception ABI leaves. Each operation is selected by a
// parsed semantic name; ESP32 application sources contain no instruction
// blocks, and each routine remains an independent linker/pruning unit.
compile fun parseXtensaFreertosException(
    cursor: ParserCursor
): SyntaxExpression {
    parserRawSkipWhitespace(cursor)
    val mode = parserRawTakeName(cursor)
    parserRawSkipWhitespace(cursor)
    parserRawExpect(cursor, "(")
    parserRawExpect(cursor, ")")
    var assembly = ""
    // The coprocessor-disabled exception runs with EXCM set and preserves the
    // interrupted task's a8-a14. Keep its policy inline in the architectural
    // CALL0 shell, exactly as IDF does; a windowed helper call here would use
    // an unsaved return register and could itself require a window exception.
    if (mode == "coprocessorExact") assembly = "mov.n a0, a1\naddmi a1, a1, -256\naddi a1, a1, 64\ns32i.n a0, a1, 16\ns32e a0, a1, -12\nrsr.ps a0\ns32i.n a0, a1, 8\nrsr.epc1 a0\ns32i.n a0, a1, 4\nrsr.excsave1 a0\ns32i.n a0, a1, 12\ns32e a0, a1, -16\nmovi a0, _xt_user_exit\ns32i.n a0, a1, 0\nrsr.exccause a0\ns32i.n a5, a1, 32\naddi a5, a0, -32\ns32i.n a2, a1, 20\ns32i.n a3, a1, 24\ns32i.n a4, a1, 28\ns32i a6, a1, 36\ns32i.n a7, a1, 40\ns32i a15, a1, 72\ncall0 _frxt_coproc_exc_hook\ncall0 _frxt_task_coproc_state\nbeqz a15, .Labla_coproc_invalid_exact\nmovi a0, .Labla_recovered_Esp32XtensaVectors_data__rodata__xt_coproc_mask\nrsr.cpenable a4\naddx4 a0, a5, a0\nl32i.n a0, a0, 0\nextui a2, a0, 0, 16\nor a4, a4, a2\nwsr.cpenable a4\nrsr.prid a3\nextui a3, a3, 13, 1\nmovi.n a2, 4\nmull a2, a2, a3\nmovi a3, _xt_coproc_owner_sa\nadd.n a3, a3, a2\nmovi a6, _xt_coproc_owner_sa_lock\n.Labla_coproc_lock_exact:\nmovi.n a7, 0\nwsr.scompare1 a7\nrsync\nrsr.prid a7\ns32c1i a7, a6, 0\nbnez a7, .Labla_coproc_lock_exact\naddx4 a3, a5, a3\nl32i.n a2, a3, 0\ns32i.n a15, a3, 0\nrsync\nmovi a6, _xt_coproc_owner_sa_lock\nmovi.n a7, 0\ns32i.n a7, a6, 0\nbne a15, a2, .Labla_coproc_switch_exact\nj .Labla_coproc_done_exact\n.Labla_coproc_switch_exact:\nbeqz a2, .Labla_coproc_check_new_exact\nl16ui a4, a2, 0\nbnone a4, a0, .Labla_coproc_check_new_exact\nmovi a5, _xt_coproc_sa_offset\nxor a4, a4, a0\ns16i a4, a2, 0\nextui a4, a0, 16, 5\naddx4 a5, a4, a5\nl16ui a4, a2, 2\nl32i.n a5, a5, 0\nor a4, a4, a0\ns16i a4, a2, 2\nl32i.n a2, a2, 8\nextui a3, a0, 16, 5\nadd.n a2, a2, a5\nssi f0, a2, 0\nssi f1, a2, 4\nssi f2, a2, 8\nssi f3, a2, 12\nssi f4, a2, 16\nssi f5, a2, 20\nssi f6, a2, 24\nssi f7, a2, 28\nssi f8, a2, 32\nssi f9, a2, 36\nssi f10, a2, 40\nssi f11, a2, 44\nssi f12, a2, 48\nssi f13, a2, 52\nssi f14, a2, 56\nssi f15, a2, 60\nrur.fcr a3\ns32i a3, a2, 64\nrur.fsr a3\ns32i a3, a2, 68\n.Labla_coproc_check_new_exact:\nbeqz a15, .Labla_coproc_done_exact\nl16ui a3, a15, 2\nmovi a4, _xt_coproc_sa_offset\nbnone a3, a0, .Labla_coproc_check_cs_exact\nxor a3, a3, a0\ns16i a3, a15, 2\nextui a3, a0, 16, 5\naddx4 a4, a3, a4\nl32i.n a4, a4, 0\nl32i.n a5, a15, 8\nadd.n a2, a4, a5\nlsi f0, a2, 0\nlsi f1, a2, 4\nlsi f2, a2, 8\nlsi f3, a2, 12\nlsi f4, a2, 16\nlsi f5, a2, 20\nlsi f6, a2, 24\nlsi f7, a2, 28\nlsi f8, a2, 32\nlsi f9, a2, 36\nlsi f10, a2, 40\nlsi f11, a2, 44\nlsi f12, a2, 48\nlsi f13, a2, 52\nlsi f14, a2, 56\nlsi f15, a2, 60\nl32i a3, a2, 64\nwur.fcr a3\nl32i a3, a2, 68\nwur.fsr a3\nj .Labla_coproc_done_exact\n.Labla_coproc_check_cs_exact:\nl16ui a2, a15, 4\nbnone a2, a0, .Labla_coproc_done_exact\nand a2, a2, a0\nextui a2, a2, 0, 8\ns32i a13, a1, 64\ns32i a14, a1, 68\ncall0 _xt_coproc_restorecs\nl32i a13, a1, 64\nl32i a14, a1, 68\nj .Labla_coproc_done_exact\n.Labla_coproc_done_exact:\nl32i a15, a1, 72\nl32i.n a6, a1, 36\nl32i.n a7, a1, 40\nl32i.n a5, a1, 32\nl32i.n a4, a1, 28\nl32i a3, a1, 24\nl32i a2, a1, 20\ncall0 _xt_user_exit\n.Labla_coproc_invalid_exact:\nmovi.n a0, 4\nwsr.exccause a0\ncall0 _xt_panic"
    if (mode == "syscall") assembly = "addmi	a1, a1, -256\naddi	a1, a1, 64\ns32i.n	a12, a1, 60\ns32i	a13, a1, 64\nmovi a0, _xt_context_save\ncallx0	a0\nrsr.epc1	a2\naddi.n	a3, a2, 3\nrsr.lend	a0\nbne	a3, a0, .Labla_recovered__Labla_recovered_Esp32XtensaVectors_local__xt_syscall_exc_11d\nrsr.lcount	a0\nbeqz.n	a0, .Labla_recovered__Labla_recovered_Esp32XtensaVectors_local__xt_syscall_exc_11d\naddi.n	a0, a0, -1\nwsr.lcount	a0\nrsr.lbeg	a3\n.Labla_recovered__Labla_recovered_Esp32XtensaVectors_local__xt_syscall_exc_11d:\nwsr.epc1	a3\nmovi a0, _xt_context_restore\ncallx0	a0\naddmi	a1, a1, 0x100\naddi	a1, a1, -64\nmovi.n	a0, -1\nmovnez	a2, a0, a2\nrsr.excsave1	a0\nrfe"
    if (mode == "coprocessor") assembly = "mov.n	a0, a1\naddmi	a1, a1, -256\naddi	a1, a1, 64\ns32i.n	a0, a1, 16\ns32e	a0, a1, -12\nrsr.ps	a0\ns32i.n	a0, a1, 8\nrsr.epc1	a0\ns32i.n	a0, a1, 4\nrsr.excsave1	a0\ns32i.n	a0, a1, 12\ns32e	a0, a1, -16\nmovi a0, _xt_user_exit\ns32i.n	a0, a1, 0\nrsr.exccause	a0\ns32i.n	a5, a1, 32\naddi	a5, a0, -32\ns32i.n	a2, a1, 20\ns32i.n	a3, a1, 24\ns32i.n	a4, a1, 28\ns32i	a6, a1, 36\ns32i.n	a7, a1, 40\ns32i	a15, a1, 72\nmovi a0, _frxt_coproc_exc_hook\ncallx0	a0\nmovi a0, _frxt_task_coproc_state\ncallx0	a0\nbnez a15, .Labla_recovered_src_esp32_xtensa_vectors_esp32_ab_far_branch_1\nj .Labla_xtensa_coproc_invalid\n.Labla_recovered_src_esp32_xtensa_vectors_esp32_ab_far_branch_1:\nmovi a0, .Labla_recovered_Esp32XtensaVectors_data__rodata__xt_coproc_mask\nrsr.cpenable	a4\naddx4	a0, a5, a0\nl32i.n	a0, a0, 0\nextui	a2, a0, 0, 16\nor	a4, a4, a2\nwsr.cpenable	a4\ns32i a15, a1, 76\nmov a10, a5\nmov a11, a15\nmovi a8, abla_esp32_xt_swap_coprocessor_owner\ncallx8 a8\nmov a2, a10\nl32i a15, a1, 76\nbeq a15, a2, .Labla_xtensa_coproc_done_abla\ns32i a0, a1, 112\ns32i a15, a1, 116\nmov a10, a0\nmov a11, a2\nmovi a8, abla_esp32_xt_prepare_old_coprocessor\ncallx8 a8\nbeqz a10, .Labla_xtensa_coproc_check_new_abla\nmov a2, a10\nssi f0, a2, 0\nssi f1, a2, 4\nssi f2, a2, 8\nssi f3, a2, 12\nssi f4, a2, 16\nssi f5, a2, 20\nssi f6, a2, 24\nssi f7, a2, 28\nssi f8, a2, 32\nssi f9, a2, 36\nssi f10, a2, 40\nssi f11, a2, 44\nssi f12, a2, 48\nssi f13, a2, 52\nssi f14, a2, 56\nssi f15, a2, 60\nrur.fcr a3\ns32i a3, a2, 64\nrur.fsr a3\ns32i a3, a2, 68\n.Labla_xtensa_coproc_check_new_abla:\nl32i a10, a1, 112\nl32i a11, a1, 116\nmovi a8, abla_esp32_xt_prepare_new_coprocessor\ncallx8 a8\nbeqz a10, .Labla_xtensa_coproc_check_cs_abla\nmov a2, a10\nlsi f0, a2, 0\nlsi f1, a2, 4\nlsi f2, a2, 8\nlsi f3, a2, 12\nlsi f4, a2, 16\nlsi f5, a2, 20\nlsi f6, a2, 24\nlsi f7, a2, 28\nlsi f8, a2, 32\nlsi f9, a2, 36\nlsi f10, a2, 40\nlsi f11, a2, 44\nlsi f12, a2, 48\nlsi f13, a2, 52\nlsi f14, a2, 56\nlsi f15, a2, 60\nl32i a3, a2, 64\nwur.fcr a3\nl32i a3, a2, 68\nwur.fsr a3\nj .Labla_xtensa_coproc_done_abla\n.Labla_xtensa_coproc_check_cs_abla:\nbeqz a11, .Labla_xtensa_coproc_done_abla\nextui a2, a11, 0, 8\ns32i a13, a1, 64\ns32i a14, a1, 68\nmovi a0, _xt_coproc_restorecs\ncallx0 a0\nl32i a13, a1, 64\nl32i a14, a1, 68\n.Labla_xtensa_coproc_done_abla:\nl32i a15, a1, 72\nl32i.n a6, a1, 36\nl32i.n a7, a1, 40\nl32i.n a5, a1, 32\nl32i.n a4, a1, 28\nl32i a3, a1, 24\nl32i a2, a1, 20\ncall0 _xt_user_exit\n.Labla_xtensa_coproc_invalid:\nmovi.n	a0, 4\nwsr.exccause	a0\nmovi a0, _xt_panic\ncallx0	a0"
    // These handlers execute at an interrupt-stack root. Match IDF's CALL4
    // C-dispatch ABI so only the four-word base-save area is required; CALL8
    // would make overflow handling follow a nonexistent caller SP at a1-12.
    if (mode == "low1") assembly = "mov.n a0, a1\naddmi a1, a1, -256\naddi a1, a1, 64\ns32i.n a0, a1, 16\nrsr.ps a0\ns32i.n a0, a1, 8\nrsr.epc1 a0\ns32i.n a0, a1, 4\nrsr.excsave1 a0\ns32i.n a0, a1, 12\nmovi a0, _xt_user_exit\ns32i.n a0, a1, 0\nmov.n a0, a1\nwsr.excsave1 a0\nmovi a0, _frxt_int_enter\ncallx0 a0\nmovi a0, 262177\nwsr.ps a0\nrsync\nmovi a6, 407551\nmovi.n a7, 1\nmovi a4, abla_esp32_frxt_dispatch_interrupts\ncallx4 a4\nmovi a0, _frxt_int_exit\ncallx0 a0"
    if (mode == "medium2") assembly = "mov.n a0, a1\naddmi a1, a1, -256\naddi a1, a1, 64\ns32i.n a0, a1, 16\nrsr.eps2 a0\ns32i.n a0, a1, 8\nrsr.epc2 a0\ns32i.n a0, a1, 4\nrsr.excsave2 a0\ns32i.n a0, a1, 12\nmovi a0, _xt_medint2_exit\ns32i.n a0, a1, 0\nmov.n a0, a1\nwsr.excsave2 a0\nmovi a0, _frxt_int_enter\ncallx0 a0\nmovi a0, 262178\nwsr.ps a0\nrsync\nmovi a6, 3670016\nmovi.n a7, 0\nmovi a4, abla_esp32_frxt_dispatch_interrupts\ncallx4 a4\nmovi a0, _frxt_int_exit\ncallx0 a0"
    if (mode == "medium3") assembly = "mov.n a0, a1\naddmi a1, a1, -256\naddi a1, a1, 64\ns32i.n a0, a1, 16\nrsr.eps3 a0\ns32i.n a0, a1, 8\nrsr.epc3 a0\ns32i.n a0, a1, 4\nrsr.excsave3 a0\ns32i.n a0, a1, 12\nmovi a0, _xt_medint3_exit\ns32i.n a0, a1, 0\nmov.n a0, a1\nwsr.excsave3 a0\nmovi a0, _frxt_int_enter\ncallx0 a0\nmovi a0, 262179\nwsr.ps a0\nrsync\nmovi a6, 683706368\nmovi.n a7, 0\nmovi a4, abla_esp32_frxt_dispatch_interrupts\ncallx4 a4\nmovi a0, _frxt_int_exit\ncallx0 a0"
    if (mode == "debug") assembly = "movi	a0, 1\nwsr.exccause	a0\nrsr.epc6	a0\nwsr.epc1	a0\nrsr.excsave6	a0\nwsr.excsave1	a0\nmovi a0, _xt_panic\ncallx0	a0\nrfi	6"
    // Replace the recovered external _xt_handle_exc jump with explicit Abla-owned
    // routing. Only the alloca window exception remains a distinct architectural
    // leaf; ordinary exceptions enter the typed handler-table body.
    if (mode == "user") assembly = "rsr.exccause a0\nbnei a0, 4, .Labla_user_not_lowint\nj abla_esp32_xt_lowint1\n.Labla_user_not_lowint:\nbltui a0, 32, .Labla_user_not_coproc\nj abla_esp32_xt_coproc_exc\n.Labla_user_not_coproc:\nbnei a0, 5, .Labla_user_not_alloca\nj abla_esp32_xt_alloca_exc\n.Labla_user_not_alloca:\nbnei a0, 1, .Labla_user_not_syscall\nj abla_esp32_xt_syscall_exc\n.Labla_user_not_syscall:\nj abla_esp32_xt_handle_exc"
    if (mode == "alloca") assembly = "rsr.windowbase a0\nrotw -1\nrsr.ps a2\nextui a3, a2, 8, 4\nxor a3, a3, a4\nrsr.excsave1 a4\nslli a3, a3, 8\nxor a2, a2, a3\nwsr.ps a2\nrsync\nbbci.l a4, 31, _WindowUnderflow4\nrotw -1\nbbci.l a8, 30, _WindowUnderflow8\nrotw -1\nj _WindowUnderflow12\n.org 0x80"
    if (assembly == "") {
        parserFail(cursor, "unknown Xtensa FreeRTOS exception routine")
    }
    syntaxCall(
        "xtensaAssemblyVoid",
        [syntaxString(assembly), syntaxString("~{memory}")]
    )
}

#compilerRegisterSubparser(
    "xtensaFreertos",
    parseXtensaFreertosException
)
