import "./atomic.ab"

// One caller-owned atomic RAM word, initialized to zero before publication.
// 0=ready; token=owned; high bit=fault; high bit|token=recovery-owned.
// All users of a physical peripheral must share the same gate. Tokens are
// unique among outstanding users and occupy bits0..30. No spinning/IRQ masking.
type PeripheralGate = int

fun peripheralGateAt(address: int): PeripheralGate = PeripheralGate(address)
fun PeripheralGate.word(): AtomicU32 = atomicU32At(this)
fun peripheralOwnerValid(owner: u32): bool = owner > u32(0) && owner < u32(0x80000000)

// 0=acquired, 1=busy, 2=requires recovery, 3=invalid.
trusted fun PeripheralGate.tryBegin(owner: u32): int {
    if (!this.word().valid() || !peripheralOwnerValid(owner)) return 3
    val observed = this.word().compareExchange(u32(0), owner)
    if (observed == u32(0)) return 0
    if ((observed & u32(0x80000000)) != u32(0)) return 2
    1
}

trusted fun PeripheralGate.finish(owner: u32, healthy: bool): bool =
    this.word().valid() && peripheralOwnerValid(owner) &&
        this.word().compareExchange(owner,
            if (healthy) u32(0) else u32(0x80000000)) == owner

trusted fun PeripheralGate.tryBeginRecovery(owner: u32): bool =
    this.word().valid() && peripheralOwnerValid(owner) &&
        this.word().compareExchange(u32(0x80000000),
            u32(0x80000000) | owner) == u32(0x80000000)

// The owner may publish healthy only after actual hardware recovery succeeds.
// Failed recovery leaves the fault latched, never silently reopens admission.
trusted fun PeripheralGate.finishRecovery(owner: u32, healthy: bool): bool =
    this.word().valid() && peripheralOwnerValid(owner) &&
        this.word().compareExchange(u32(0x80000000) | owner,
            if (healthy) u32(0) else u32(0x80000000)) == (u32(0x80000000) | owner)
