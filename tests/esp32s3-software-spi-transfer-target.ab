import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/spi/software_transfer.ab"
import "abla/runtime/scalar"
@export("abla_s3_software_spi_transfer_test")
trusted fun spiTransferTargetTest(output: u32, written: i32, input: u32, read: i32, mode: i32): bool =
    softwareSpiTransferOwned(pin(12), pin(11), pin(13), nativeBufferAt(int(output), int(written)), int(written),
        nativeBufferAt(int(input), int(read)), int(read), int(mode), 1)
