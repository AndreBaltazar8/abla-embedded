import "../src/touch/transform.ab"
fun main(): int {
    var rotation = 0
    while (rotation < 8) {
        var x = 0
        while (x < 3) {
            var y = 0
            while (y < 5) {
                val point = touchPoint(x, y, 13, 2, 65535).forLcdRotation(3, 5, rotation)
                val expectedX = if (rotation == 0 || rotation == 4) x
                    else if (rotation == 1 || rotation == 5) y
                    else if (rotation == 2 || rotation == 6) 2 - x else 4 - y
                val expectedY = if (rotation == 0 || rotation == 6) y
                    else if (rotation == 1 || rotation == 7) 2 - x
                    else if (rotation == 2 || rotation == 4) 4 - y else x
                if (!point.valid() || point.x() != expectedX || point.y() != expectedY || point.id() != 13 || point.event() != 2 || point.size() != 65535) return 1
                y = y + 1
            }
            x = x + 1
        }
        rotation = rotation + 1
    }
    if (touchPoint(3, 0, 0, 0).forLcdRotation(3, 5, 0).valid() ||
        touchPoint(0, 5, 0, 0).forLcdRotation(3, 5, 0).valid() ||
        touchPoint(0, 0, 0, 0).forLcdRotation(3, 5, 8).valid() ||
        touchPoint(0, 0, 0, 0).forLcdRotation(0, 5, 0).valid()) return 2
    0
}
