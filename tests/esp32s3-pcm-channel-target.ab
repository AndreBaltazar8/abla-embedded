import "../src/audio/pcm_channel.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pcm_channel_target")
trusted fun channelTarget(channel: PcmChannel,wav: PcmWav,repeats: int,frames: int,output: NativeBuffer): bool =
    channel.enqueue(wav,repeats) && channel.render(frames,output)
