import "../src/esp32/power/sleep_alarm_session_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(24)
var hi=0
var lo=0
var raw=0
var now=0
var writes=0
var failAt=0
var bad=false
trusted fun c5RtcTimerRead(offset: int): int {
    if (offset == 0) return lo
    if (offset == 4) return hi
    if (offset == 0x10) return 0x20000000
    if (offset == 0x14) return now&0xFFFFFFFF
    if (offset == 0x18) return now>>>32
    if (offset == 0x28) return raw
    bad=true;return 0
}
trusted fun c5RtcTimerWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (offset == 0) lo=value
    else if (offset == 4) hi=value&0x7fffffff
    else if (offset == 0x34) { if (value != 0x80000000) bad=true;raw=raw&0x7fffffff }
    else if (offset == 0x10) { if (value != 0x28000000) bad=true }
    else bad=true
    return
}
@export("abla_sleep_alarm_session_c5_test")
trusted fun test(): int {
    val record=nativeBufferAt(memory,24)
    var mode=0
    while (mode < 3) {
        var fault=0
        while (fault < 4) {
            var offset=0
            while (offset < 24) { record.storeU32(offset,0);offset=offset+4 }
            hi=0x4050042;lo=0xabcdef01;raw=0xc0000000;now=if (mode == 1) 0x100000020 else 0
            writes=0;failAt=if (mode == 2) 3 else 0;bad=false
            val result=esp32C5SleepAlarmBeginOwned(record,0x100000010,16,true)
            if (result != (if (mode == 0) 1 else if (mode == 1) 4 else 3) || bad) return 1
            val before=writes
            if (esp32C5SleepAlarmBeginOwned(record,0x100000010,16,true) != 2 || writes != before || esp32C5SleepAlarmCloseOwned(record,false) != 2) return 2
            raw=0xc0000000;hi=hi|0x8000000
            writes=0;failAt=if (fault == 0) 0 else fault+1
            val closed=esp32C5SleepAlarmCloseOwned(record,true)
            if (mode == 1) {
                if (closed != 6 || writes != 0 || raw != 0xc0000000) return 3
            } else {
                // If initial high-target programming failed, the high field
                // already equals its original value: a lost restore is benign.
                if (closed != (if (fault == 0 || mode == 2 && fault == 2) 6 else 5) || record.loadU32(16) != 1) return 4
                failAt=0
                if (esp32C5SleepAlarmCloseOwned(record,true) != 6 || hi != 0xc050042 || lo != 0xabcdef01 || raw != 0x40000000 || record.loadU32(16) != 1) return 5
            }
            val finished=writes
            if (esp32C5SleepAlarmCloseOwned(record,true) != 6 || writes != finished || bad) return 6
            fault=fault+1
        }
        mode=mode+1
    }
    0
}
