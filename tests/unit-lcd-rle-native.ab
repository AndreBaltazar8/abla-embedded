import "../src/display/unit_lcd_rle.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(16384)
@export("abla_unit_lcd_rle_test")
trusted fun testRle(): i32 {
    val source=nativeBufferAt(memory,8192);val dest=nativeBufferAt(memory+8192,8192)
    var bytes=1
    while (bytes <= 4) {
        var lengthCase=0
        while (lengthCase < 10) {
            val pixels=if (lengthCase < 4) lengthCase+1 else if (lengthCase < 7) 250+lengthCase else 503+lengthCase
            var pattern=0
            while (pattern < 5) {
                var at=0
                while (at < pixels*bytes) {
                    val pixel=at/bytes;val component=at%bytes
                    val value=if (pattern == 0) component else if (pattern == 1) (pixel*73+component*19)&255 else
                        if (pattern == 2) ((pixel/255)*73+component)&255 else if (pattern == 3) ((pixel/254)*73+component)&255 else
                        if (component == bytes-1) pixel&255 else 0
                    source.store(at,value);at=at+1
                }
                val size=unitLcdRleSize(source,pixels,bytes)
                if (size < 1 || size > pixels*(bytes+1)) return i32(1)
                at=0;while (at <= size) { dest.store(at,165);at=at+1 }
                if (unitLcdRleEncode(source,pixels,bytes,nativeBufferAt(dest.addressValue(),size-1)) != 0) return i32(2)
                at=0;while (at <= size) { if (dest.load(at) != 165) return i32(3);at=at+1 }
                if (unitLcdRleEncode(source,pixels,bytes,nativeBufferAt(dest.addressValue(),size)) != size || dest.load(size) != 165) return i32(4)
                var encoded=0;var decoded=0
                while (encoded < size) {
                    var count=dest.load(encoded);encoded=encoded+1
                    val literal=count == 0
                    if (literal) {
                        if (encoded >= size) return i32(5)
                        count=dest.load(encoded);encoded=encoded+1
                        if (count < 3) return i32(6)
                    }
                    val packetBytes=if (literal) count*bytes else bytes
                    if (encoded+packetBytes > size || decoded+count > pixels) return i32(7)
                    var pixel=0
                    while (pixel < count) {
                        var component=0
                        while (component < bytes) {
                            if (dest.load(encoded+(if (literal) pixel*bytes else 0)+component) != source.load((decoded+pixel)*bytes+component)) return i32(8)
                            component=component+1
                        }
                        pixel=pixel+1
                    }
                    encoded=encoded+packetBytes;decoded=decoded+count
                }
                if (decoded != pixels || unitLcdRleEncode(source,pixels,bytes,source) != 0) return i32(9)
                pattern=pattern+1
            }
            lengthCase=lengthCase+1
        }
        bytes=bytes+1
    }
    if (unitLcdRleSize(source,0,2) != 0 || unitLcdRleSize(source,1,5) != 0) return i32(10)
    return i32(0)
}
