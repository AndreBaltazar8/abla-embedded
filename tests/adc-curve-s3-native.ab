import "../src/esp32/adc_curve_s3_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
// Golden hashes from arbitrary-precision integer evaluation of IDF coefficients.
fun golden(group: int): int = if (group == 0) 3988228060 else if (group == 1) 1173091515 else if (group == 2) 4234130506 else if (group == 3) 3083149141 else if (group == 4) 2124537865 else if (group == 5) 4294379166 else if (group == 6) 1548718714 else if (group == 7) 1977716580 else -1
@export("abla_adc_curve_s3_test")
fun curveTest(): i32 {
    var unit=1
    while (unit <= 2) {
        var attenuation=0
        while (attenuation < 4) {
            var x=0; var hash=2166136261
            while (x <= 4000) {
                hash=((hash^esp32S3AdcCorrectMillivolts(unit,attenuation,x))*16777619)&4294967295
                x=x+1
            }
            if (hash != golden((unit-1)*4+attenuation)) return i32(1)
            attenuation=attenuation+1
        }
        unit=unit+1
    }
    if (esp32S3AdcCorrectMillivolts(0,0,1) != -1 || esp32S3AdcCorrectMillivolts(1,4,1) != -1 || esp32S3AdcCorrectMillivolts(1,0,4001) != -1) return i32(2)
    return i32(0)
}
