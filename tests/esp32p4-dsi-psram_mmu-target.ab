import "../src/esp32/psram/mmu_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_psram_mmu_target")
trusted fun mmuTarget(op: int,address: int,physical: int,capacity: int,expected: int,polls: int): int {
    if (op == 0) return p4PsramMmuReadOwned(address,polls)
    if (op == 1) return p4PsramMmuMapOwned(address,physical,capacity,expected,polls)
    return p4PsramMmuUnmapOwned(address,expected,polls)
}
