import "../src/m5stack/tough_touch_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(128)
var calls=0
var captures=0
var failure=0
var matched=true
var bad=false
var count=1
fun toughTouchBusOwnsPmic(bus: int,pmic: int): bool = bus == 13 && pmic == 7 && matched
fun toughTouchBusOwnsController(bus: int,touch: int): bool = bus == 13 && touch == 9 && matched
fun touchControllerAllocate(bus: int,kind: int,address: int,frequency: int): int {
    if (bus != 13 || kind != 3 || address != 46 || frequency != 400000) bad=true
    calls=calls+1;return if (failure == 1) 0 else 9
}
fun touchControllerBegin(kind: int,handle: int): bool { calls=calls+1;return failure == 0 }
fun touchControllerRelease(kind: int,handle: int): bool { calls=calls+1;return failure != 3 }
trusted fun chsc6540Capture(handle: int,snapshot: NativeBuffer): int {
    if (handle != 9) bad=true
    captures=captures+1
    var i=0;while (i < 11) { snapshot.store(i,if (i == 0) count else i);i=i+1 }
    return count
}
@export("abla_toughc5_touch_test")
trusted fun test(): int {
    val storage=nativeBufferAt(memory,96);val owner=m5ToughPowerOwnerAt(storage)
    val snapshot=nativeBufferAt(memory+96,11);val previous=nativeBufferAt(memory+112,11)
    var mode=0
    while (mode < 1024) {
        val state=mode&7;val kind=(mode>>>3)&7
        val exclusive=(mode&64) != 0;val consumed=(mode&128) != 0
        failure=(mode>>>8)&3;calls=0;bad=false;matched=true
        storage.storeU32(0,0x54435057);storage.storeU32(4,state)
        storage.storeU32(8,7);storage.storeU32(12,kind|256)
        storage.storeU32(16,1|(5<<8));storage.storeU32(20,0)
        val admitted=state == 1 && kind == 5 && exclusive && consumed
        val result=owner.openTouchOwned(13,exclusive,consumed)
        if (result.status() != (if (admitted) failure+1 else 0) ||
            calls != (if (!admitted) 0 else if (failure == 0) 2 else if (failure == 1) 1 else 3) ||
            result.handle() != (if (admitted && (failure == 0 || failure == 3)) 9 else 0) || bad) return 1
        if (result.status() == 4) {
            failure=0
            if (result.closeOwned() != 0 || calls != 4) return 2
        }
        mode=mode+1
    }
    storage.storeU32(4,1);storage.storeU32(12,261)
    val ready=TouchControllerOpen((1<<40)|(3<<32)|9)
    count=-1
    while (count <= 3) {
        captures=0
        val result=owner.readTouchOwned(13,ready,snapshot,previous,true)
        if (result != (if (count < 0) -1 else if (count > 2) -3 else count) ||
            captures != (if (count == 1 || count == 2) 2 else 1) || bad) return 3
        count=count+1
    }
    captures=0;matched=false
    if (owner.readTouchOwned(13,ready,snapshot,previous,true) != -1 || captures != 0) return 4
    matched=true
    if (owner.readTouchOwned(13,ready,snapshot,snapshot,true) != -1 ||
        owner.readTouchOwned(13,ready,nativeBufferAt(memory,11),previous,true) != -1 ||
        owner.readTouchOwned(13,ready,snapshot,previous,false) != -1 ||
        owner.readTouchOwned(14,ready,snapshot,previous,true) != -1 ||
        owner.readTouchOwned(13,TouchControllerOpen((4<<40)|(3<<32)|9),snapshot,previous,true) != -1 || captures != 0) return 5
    storage.storeU32(16,6|(5<<8));calls=0
    if (owner.readTouchOwned(13,ready,snapshot,previous,true) != -1 ||
        owner.openTouchOwned(13,true,true) != 0 || captures != 0 || calls != 0) return 6
    return 0
}
