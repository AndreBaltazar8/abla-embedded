import "../src/imu/snapshot_calibration.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_snapshot_calibration_test")
trusted fun calibrationSnapshotTest(): i32 {
    val state = imuCalibration()
    val expected = imuCalibration()
    val offsets = imuOffsets()
    val referenceOffsets = imuOffsets()
    val snapshot = imuSnapshotAt(nativeBufferAt(nativeStaticAllocate(44),44))
    if (!snapshot.initialize()) return i32(1)
    var mask = 0
    while (mask < 8) {
        var enabled = 0
        while (enabled < 8) {
            state.clear(); expected.clear(); offsets.clear(); referenceOffsets.clear()
            var sensor = 0
            while (sensor < 3) {
                val strength = if ((enabled & (1 << sensor)) != 0) 64 else 0
                state.configure(sensor,0,0,256,1,strength)
                expected.configure(sensor,0,0,256,1,strength)
                sensor = sensor + 1
            }
            var iteration = 0
            while (iteration < 40) {
                snapshot.commit(7,imuAxes(3,4,5),imuAxes(6,7,8),imuAxes(9,10,11),0xFFFFFFFF+iteration)
                if (state.updateSnapshot(snapshot,offsets,mask) != (mask & enabled)) return i32(2)
                sensor = 0
                while (sensor < 3) {
                    if ((mask & enabled & (1 << sensor)) != 0) expected.update(sensor,snapshot.axes(sensor),referenceOffsets)
                    sensor = sensor + 1
                }
                var byte = 0
                while (byte < 120) {
                    if (state.buffer().loadU32(byte) != expected.buffer().loadU32(byte)) return i32(3)
                    byte = byte + 4
                }
                byte = 0
                while (byte < 9) {
                    if (offsets.get(byte) != referenceOffsets.get(byte)) return i32(4)
                    byte = byte + 1
                }
                iteration = iteration + 1
            }
            enabled = enabled + 1
        }
        mask = mask + 1
    }
    if (state.updateSnapshot(snapshot,offsets,-2) != -2 ||
        state.updateSnapshot(snapshot,offsets,8) != -1 ||
        state.updateSnapshot(snapshot,imuOffsetsAt(state.buffer().addressValue()),1) != -1 ||
        imuCalibrationAt(0).valid() || imuCalibrationAt(4294967280).valid()) return i32(5)
    snapshot.initialize()
    snapshot.commit(1,imuAxes(1,2,3),invalidImuAxes(),invalidImuAxes(),0)
    if (state.updateSnapshot(snapshot,offsets,3) != -1) return i32(6)
    i32(0)
}
