import "./paper-s3-sleep-cycle-native.ab"
import "./sleep-scheduler-s3-native.ab"
import "./gdma-sleep-s3-native.ab"
import "../src/m5stack/paper_s3_sleep_parked_sequence.ab"
@export("abla_paper_s3_sleep_parked_test")
fun testParkedCycle(): int {
    val r=nativeBufferAt(cycleMemory,336);val cfg=nativeBufferAt(cycleConfigMemory,72)
    val cpu=nativeBufferAt(prepareMemory,8800);val tags=nativeBufferAt(prepareMemory+8800,256)
    val q=nativeBufferAt(quiesceMemory,36)
    val instruction=esp32S3TagPlan(false,16384,4,32,0x42000000,4096,false)
    val data=esp32S3TagPlan(true,32768,4,32,0x3c000000,4096,false)
    if (!paperS3SleepConfigEncode(cfg,instruction,data,Esp32S3ClockBias(0),3,4,-1,2,3,100,0x20000,3495253,0,0)) return 1
    var profile=0
    while (profile < 12) {
        seedSession(nativeBufferAt(sessionMemory,36),48,true);r.storeU32(0,0);q.storeU32(0,0)
        qCore=profile&1;qLevel=3;qDone=false;qRace=false;qBad=false
        cycleBusKey=6;sleepGate=0;sleepBusIdle=true;sleepReleaseFails=false
        cyclePadOwned=false;cyclePadBad=false;cyclePadPrepareFailure=false;cyclePadRestoreFailure=false
        runProgress=0;runCalls=0;prepareCalls=0;prepareOutcome=1;runEntry=if (profile >= 6) 1 else 0
        reads=0;waits=0;outcome=0;releaseAfter=0
        if (paperS3SleepCycleOpenOwned(r,cpu,tags,cfg,123,true) != 1 || paperS3SleepCyclePollOwned(r,cpu,tags,cfg,nativeBufferAt(4096,40),true) != 3) return 2
        if (esp32S3SleepQuiesceOpenOwned(q,nativeBufferAt(4096,4),1,true) != 2) return 3
        val cancel=(profile%6) == 0
        if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,false,true) != 4 || prepareCalls != 0 || qLevel != 3) return 4
        qWord=(qWord&(~7))|2
        if (cancel && esp32S3SleepQuiescePollOwned(q) != 1) return 15
        val beforeReads=reads
        if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,cancel,true) != 4 || qLevel != 15) return 5
        if (!cancel) {
            if ((qWord&7) != 2 || runCalls != 1 || sleepGate != 2) return 6
            runProgress=1
            sleepReleaseFails=true
            if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,false,true) != 4 || (qWord&7) != 2 || qLevel != 15 || sleepGate != 2) return 7
            sleepReleaseFails=false
            if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,false,true) != 4) return 8
        }
        if ((qWord&7) != 3 || qLevel != 15 || sleepGate != 0 || cyclePadOwned || reads != beforeReads) return 9
        qDone=true
        if ((profile%3) == 2) {
            qLevel=0
            if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,false,true) != 4 || q.loadU32(24) != 1) return 10
            qLevel=15
        }
        val expected=if (cancel) 8 else if (runEntry == 0) 5 else 6
        if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,false,true) != expected || qLevel != 3 || q.loadU32(4) != 5 || qBad || cyclePadBad) return 11
        val calls=runCalls;val cas=qCalls
        if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,false,true) != expected || calls != runCalls || cas != qCalls) return 12
        qCore=qCore^1
        if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,false,true) != 9) return 13
        qCore=qCore^1
        q.storeU32(8,r.addressValue())
        if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,false,true) != 9 || cas != qCalls) return 14
        profile=profile+1
    }
    profile=0
    while (profile < 4) {
        seedSession(nativeBufferAt(sessionMemory,36),48,true);r.storeU32(0,0);q.storeU32(0,0)
        qCore=0;qLevel=3;qRace=false;qDone=false;qBad=false
        reads=0;releaseAfter=0;outcome=0;prepareCalls=0;runCalls=0
        if (paperS3SleepCycleOpenOwned(r,cpu,tags,cfg,123,true) != 1 || paperS3SleepCyclePollOwned(r,cpu,tags,cfg,nativeBufferAt(4096,40),true) != 3) return 16
        if (esp32S3SleepQuiesceOpenOwned(q,nativeBufferAt(4096,4),1,true) != 2) return 17
        qRace=(profile&1) != 0
        if (profile >= 2) {
            sleepReleaseFails=true
            if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,true,true) != 4 || (qWord&7) != 1 || sleepGate != 2) return 18
            sleepReleaseFails=false
        }
        val result=paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,true,true)
        if ((profile&1) != 0) {
            if (result != 4 || (qWord&7) != 3) return 19
            qDone=true
            if (paperS3SleepCycleContinueParkedOwned(r,cpu,tags,cfg,q,true,true) != 8) return 20
        } else if (result != 8 || (qWord&7) != 5) return 21
        if (qLevel != 3 || qBad || prepareCalls != 0 || runCalls != 0 || sleepGate != 0 || cyclePadOwned) return 22
        profile=profile+1
    }
    profile=0
    while (profile < 8) {
        val scheduled=nativeBufferAt(schedulerSleepMemory,68)
        seedSession(nativeBufferAt(sessionMemory,36),48,true);r.storeU32(0,0);scheduled.storeU32(0,0)
        qCore=profile&1;qLevel=2;qWord=0;qRace=false;qDone=false;qBad=false
        schedulerLock=0;schedulerReleaseFault=false
        reads=0;releaseAfter=0;outcome=0;prepareCalls=0;runCalls=0;prepareOutcome=1;runProgress=1;runEntry=if (profile >= 4) 1 else 0
        var cancel=(profile%4) == 0
        if (paperS3SleepCycleOpenOwned(r,cpu,tags,cfg,123,true) != 1 || paperS3SleepCyclePollOwned(r,cpu,tags,cfg,nativeBufferAt(4096,40),true) != 3) return 23
        if (esp32S3SleepSchedulerOpenOwned(scheduled,nativeBufferAt(8192,4),nativeBufferAt(4096,4),1,true) != 2) return 24
        if (!cancel) {
            if (paperS3SleepCycleContinueScheduledOwned(r,cpu,tags,cfg,scheduled,false,true) != 4 || runCalls != 0 || schedulerLock != qCore+1) return 25
            qWord=(qWord&(~7))|2
        }
        if ((profile%4) == 1) {
            gdmaSleepBusy=1<<(profile+1)
            if (paperS3SleepCycleContinueScheduledOwned(r,cpu,tags,cfg,scheduled,false,true) != 9 ||
                prepareCalls != 0 || runCalls != 0 || schedulerLock != qCore+1 || qLevel != 15) return 30
            // Cancel while DMA is STILL busy: the clock/cache path was never
            // entered and cleanup must not depend on DMA becoming idle.
            cancel=true
        }
        schedulerReleaseFault=true
        if (paperS3SleepCycleContinueScheduledOwned(r,cpu,tags,cfg,scheduled,cancel,true) != 4 || qLevel != 15 || schedulerLock != qCore+1 || sleepGate != 0) return 26
        qDone=true
        if (paperS3SleepCycleContinueScheduledOwned(r,cpu,tags,cfg,scheduled,cancel,true) != 4 || qLevel != 15 || schedulerLock != qCore+1) return 27
        schedulerReleaseFault=false
        val expected=if (cancel) 8 else if (runEntry == 0) 5 else 6
        if (paperS3SleepCycleContinueScheduledOwned(r,cpu,tags,cfg,scheduled,cancel,true) != expected || qLevel != 2 || schedulerLock != 0 || qBad || runCalls != (if (cancel) 0 else 1)) return 28
        if (paperS3SleepCycleContinueScheduledOwned(r,cpu,tags,cfg,scheduled,cancel,true) != expected || schedulerLock != 0 || qLevel != 2) return 29
        gdmaSleepBusy=0
        profile=profile+1
    }
    return 0
}
