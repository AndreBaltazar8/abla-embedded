import "../src/esp32/i2c/software_bus_c6_bindings.ab"
import "abla/build"
var apb=u32(1)
var mux=u32(0x700000)
var clock=u32(1)
var oe=u32(0)
var hold=u32(0)
var lp=u32(0)
var usb=u32(0)
var reads=0
var bad=false
fun c6GpioRead(address: int): u32 {
    reads=reads+1
    if (address == 0x600960e8) return apb
    if (address == 0x600960ec) return mux
    if (address == 0x6009162c) return clock
    if (address == 0x60091020) return oe
    if (address == 0x600b102c) return hold
    if (address == 0x600b1028) return lp
    if (address == 0x6000f018) return usb
    bad=true;return u32(0)
}
fun c6GpioWrite(address: int,value: u32): void { bad=true;return }
fun softwareI2cSample(pin: int): bool { bad=true;return false }
fun softwareI2cDrive(pin: int,released: bool): void { bad=true;return }
fun softwareI2cDelay(us: int): void { bad=true;return }
@export("abla_c6_i2c_admission_test")
fun testAdmission(): int {
    var sda=0
    while (sda < 31) {
        var scl=0
        while (scl < 31) {
            if (sda != scl) {
                val pins=(u32(1)<<u32(sda))|(u32(1)<<u32(scl))
                var source=0
                while (source < 4) {
                    mux=u32(0xa8400000)|u32(source<<20)
                    if (c6SoftwareI2cReady(sda,scl) != (source != 0) || bad) return 1
                    source=source+1
                }
                mux=u32(0x700000)
                apb=u32(0);if (c6SoftwareI2cReady(sda,scl)) return 2
                apb=u32(3);if (c6SoftwareI2cReady(sda,scl)) return 3
                apb=u32(1);clock=u32(0);if (c6SoftwareI2cReady(sda,scl)) return 4
                clock=u32(1);mux=u32(0x300000);if (c6SoftwareI2cReady(sda,scl)) return 5
                mux=u32(0x700000);oe=pins;if (c6SoftwareI2cReady(sda,scl)) return 6
                oe=u32(0);hold=pins;if (c6SoftwareI2cReady(sda,scl)) return 7
                hold=u32(0);lp=u32(255)
                if (c6SoftwareI2cReady(sda,scl) != ((pins&u32(255)) == u32(0))) return 8
                lp=u32(0);usb=u32(16384)
                if (c6SoftwareI2cReady(sda,scl) != ((pins&u32(0x3000)) == u32(0))) return 9
                usb=u32(0)
            }
            scl=scl+1
        }
        sda=sda+1
    }
    reads=0
    if (c6SoftwareI2cReady(-1,0) || c6SoftwareI2cReady(0,31) || c6SoftwareI2cReady(0,0) || reads != 0 || bad) return 10
    return 0
}
