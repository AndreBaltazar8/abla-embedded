import "../src/esp32/clock_resume_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(64)
var sys=0
var cpu=7
var ahb=7
var gates=0
var ticks=0
var fault=0
var pllCalls=0
var pvtCalls=0
var pllReady=false
var pvtReady=false
var requirePvt=false
var bad=false
var power=0
var rcGate=0
var rcDelay=0
var requirePll=false
trusted fun c5ClockResumeRead(address: int): int = if (address == 0x600b484c) 0x200 else if (address == 0x600b0028) 0x4000 else if (address == 0x600b00ac) power else if (address == 0x600b0420) rcGate else 0
trusted fun c5ClockResumeWrite(address: int,value: int): void {
    if (address == 0x600b00ac) { if (value != 0x40000005) bad=true;if (fault != 8) power=value }
    else if (address == 0x600b0420) { if (value != 0x80000005 || rcDelay < 50) bad=true;if (fault != 9) rcGate=value }
    else bad=true
    return
}
trusted fun c5ClockResumeDelay(us: int): void { if (us != 50 && us != 5) bad=true;rcDelay=rcDelay+us;return }
// Bounded subsystem models here; separate PLL/PVT fixtures exercise their
// actual transport/voltage logic. Native example links the real implementations.
trusted fun c5ClockResumePll(record: NativeBuffer,limit: int): int {
    pllCalls=pllCalls+1
    if (fault == 1) return 4
    if (fault == 2) return 3
    if (record.addressValue() != memory+16 || limit != 64) bad=true
    pllReady=true;return 1
}
trusted fun c5ClockResumePvt(record: NativeBuffer): int {
    pvtCalls=pvtCalls+1
    if (!pllReady || (gates&2) == 0 || (sys&0x30000) != 0 || record.addressValue() != memory+48) bad=true
    if (fault == 4) return 3
    pvtReady=true;return 1
}
trusted fun c5CpuClockRead(offset: int): int = if (offset == 0x110) sys else if (offset == 0x118) cpu else if (offset == 0x11c) ahb else if (offset == 0x128) gates else 0
trusted fun c5CpuClockWrite(offset: int,value: int): void {
    if (offset == 0x128) { if (!pllReady) bad=true;if (fault != 3) gates=value }
    else if (offset == 0x118) { if (fault != 5) cpu=value }
    else if (offset == 0x11c) { if (fault != 6) ahb=value }
    else if (offset == 0x110) { if (fault != 7) sys=value }
    else if (offset == 0x144) {
        if ((requirePll && !pllReady) || (requirePvt && !pvtReady) || value != 1) bad=true
        if ((sys&0x30000) == 0x10000 && (rcDelay < 55 || power != 0x40000005 || rcGate != 0x80000005)) bad=true
    } else bad=true
    return
}
trusted fun c5CpuClockTicks(mhz: int): void { ticks=mhz;return }
@export("abla_clock_resume_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,64)
    var mode=0
    while (mode < 32) {
        val peripheralPll=(mode&16) != 0
        val xtal=if ((mode&1) == 0) 40 else 48;val source=(mode>>1)&3
        requirePvt=(mode&8) != 0;requirePll=source >= 2 || requirePvt || peripheralPll
        val plan=C5CpuClock(source|(if (source == 3) (1<<2)|(5<<10) else if (source == 2) 3<<10 else 0)|(xtal<<18))
        var failure=0
        while (failure < 10) {
            record.storeU32(0,0);sys=xtal<<24;cpu=7;ahb=7;gates=0x80;ticks=0;fault=failure;pllCalls=0;pvtCalls=0;pllReady=false;pvtReady=false;bad=false
            power=5;rcGate=5;rcDelay=0
            val result=esp32C5ClockResumeOwned(record,plan,requirePvt,true,64,peripheralPll)
            if (result != 1 && result != 3 && result != 4) return i32(1)
            if (result != 1 && ticks != 0) return i32(2)
            val priorPll=pllCalls;val priorPvt=pvtCalls;val stage=record.loadU32(8)
            fault=0
            if (esp32C5ClockResumeOwned(record,plan,requirePvt,true,64,peripheralPll) != 1 || bad || ticks != (if (source == 3) 120 else if (source == 2) 160 else if (source == 1) 20 else xtal) ||
                gates != (0x80|(if (source == 3) 1 else if (source == 2) 2 else 0)|(if (requirePvt) 2 else 0))) return i32(3)
            if (!requirePll && pllCalls != 0 || source != 1 && rcDelay != 0) return i32(7)
            if ((stage > 0 && pllCalls != priorPll) || (stage > 2 && pvtCalls != priorPvt)) return i32(4)
            if (!requirePvt && pvtCalls != 0) return i32(5)
            if (esp32C5ClockResumeOwned(record,plan,!requirePvt,true) != 2 || esp32C5ClockResumeOwned(record,plan,requirePvt,false) != 2) return i32(6)
            failure=failure+1
        }
        mode=mode+1
    }
    return i32(0)
}
