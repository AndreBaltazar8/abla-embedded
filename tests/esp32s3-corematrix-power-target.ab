import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/corematrix_power.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable peripheral compilation check, not a C61 boot image.
@export("abla_corematrix_power_target")
trusted fun powerTarget(owner: M5Expanders,pmic: M5PmicOpen,sdPhase: bool): M5CoreMatrixPowerSetup =
    if (sdPhase) owner.configureCoreMatrixSdPower() else owner.configureCoreMatrixPowerInputs(pmic)
