import "../src/m5stack/corep4x_microphone_dma_sequence.ab"
import "../src/m5stack/tab5_microphone_dma_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
import "abla/runtime/scalar"
var step=0
var fail=0
var channel=0
var tab=false
var bad=false
trusted fun p4AhbDescriptorWrite(a: int,v: int): void { bad=true;return }
trusted fun next(expected: int): bool {
    step=step+1
    if (step != expected) bad=true
    return step != fail
}
trusted fun p4StereoMicParked(c: int): int { if (c != channel) bad=true;return if (next(1)) 1 else 0 }
trusted fun p4StereoMicBus(): int = if (next(2)) 1 else 7
trusted fun p4StereoMicI2sStopped(): bool = next(3)
trusted fun p4StereoMicReset(): int = if (next(4)) 1 else 7
trusted fun p4StereoMicDmaPrepare(c: int): int { if (c != channel) bad=true;return if (next(5)) 1 else 7 }
trusted fun p4StereoMicFormat(revision: int): int { if (revision != 100) bad=true;return if (next(6)) 1 else 7 }
trusted fun p4StereoMicEof(bytes: int): int { if (bytes != 64) bad=true;return if (next(7)) 1 else 7 }
trusted fun p4StereoMicPins(m: int,b: int,w: int,d: int): int {
    if (m != (if (tab) 30 else 2) || b != (if (tab) 27 else 6) || w != (if (tab) 29 else 4) || d != (if (tab) 28 else 5)) bad=true
    return if (next(8)) 1 else 7
}
fun spans(d: int,n: int,b: int,s: int,bytes: int): bool = d == 0x4ff00000 && n == 3 && b == 0x4ff40000 && s == 128 && bytes == 64
trusted fun p4StereoMicRing(d: int,n: int,b: int,s: int,bytes: int): bool { if (!spans(d,n,b,s,bytes)) bad=true;return next(9) }
trusted fun p4StereoMicPublish(d: int,n: int,b: int,s: int,bytes: int,polls: int): int {
    if (!spans(d,n,b,s,bytes) || polls != 17) bad=true
    return if (next(10)) 1 else 7
}
@export("abla_corep4x_microphone_dma_test")
trusted fun test(): i32 {
    var board=0
    while (board < 2) {
    tab=board == 1;channel=0
    while (channel < 3) {
        fail=0
        while (fail <= 10) {
            step=0;bad=false
            val result=if (tab) tab5PrepareMicrophoneDmaOwned(channel,0x4ff00000,3,0x4ff40000,128,64,100,17,true)
                else coreP4xPrepareMicrophoneDmaOwned(channel,0x4ff00000,3,0x4ff40000,128,64,100,17,true)
            val expected=if (fail == 0) 1 else (fail+2)|(if (fail == 1 || fail == 3 || fail == 9) 0 else 7 << 8)
            if (result != expected || step != (if (fail == 0) 10 else fail) || bad) return i32(1)
            fail=fail+1
        }
        channel=channel+1
    }
    board=board+1
    }
    step=0
    if (esp32p4PrepareStereoMicrophone24kDmaOwned(0,0x4ff00000,3,0x4ff40000,128,64,100,17,-1,6,4,5,true) != 2 ||
        esp32p4PrepareStereoMicrophone24kDmaOwned(0,0x4ff00000,3,0x4ff40000,128,64,100,17,2,6,4,4,true) != 2 ||
        coreP4xPrepareMicrophoneDmaOwned(0,0x4ff00000,3,0x4ff40000,128,64,100,17,false) != 2 ||
        coreP4xPrepareMicrophoneDmaOwned(3,0x4ff00000,3,0x4ff40000,128,64,100,17,true) != 2 ||
        coreP4xPrepareMicrophoneDmaOwned(0,0x4ff00000,3,0x4ff40000,128,63,100,17,true) != 2 ||
        coreP4xPrepareMicrophoneDmaOwned(0,0x4ff00000,3,0x4ff00040,128,64,100,17,true) != 2 ||
        coreP4xPrepareMicrophoneDmaOwned(0,0x4ff00000,1,0x4ff40000,128,64,100,17,true) != 2 || step != 0) return i32(2)
    return i32(0)
}
