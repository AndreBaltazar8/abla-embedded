import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/rx_eof_c6_sequence.ab"
var eof=u32(0)
var writes=0
var drop=0
var busy=false
var enabled=true
var bad=false
trusted fun c6I2sClockRead(at: int): u32 = if (at == 0) u32(1) else if (enabled) u32(0x400000) else u32(0)
trusted fun c6I2sClockWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6I2sRead(at: int): u32 = if (at == 0x64) eof else if (at == 0x6c) u32(1) else if (at == 0x14 && busy) u32(1) else u32(0)
trusted fun c6I2sWrite(at: int,v: u32): void {
    writes=writes+1
    if (at != 0x64 || (v&u32(0xfffff000)) != u32(0xa5a51000)) bad=true
    if (writes != drop) eof=v
    return
}
@export("abla_i2s_rx_eof_c6_test")
trusted fun test(): i32 {
    var bytes=1
    while (bytes <= 4095) {
        var fault=0
        while (fault < 3) {
            eof=u32(0xa5a51234);writes=0;drop=fault
            var owner=c6I2sRxEofOpenOwned(0,bytes,true)
            if (owner.status() != 1 && owner.status() != 5) return i32(1)
            if (owner.status() == 1 && eof != (u32(0xa5a51000)|u32(bytes))) return i32(2)
            owner=owner.closeOwned(true);drop=0;owner=owner.closeOwned(true)
            if (owner.status() != 6 || eof != u32(0xa5a51234) || bad) return i32(3)
            fault=fault+1
        }
        bytes=bytes+1
    }
    writes=0;busy=true
    if (c6I2sRxEofOpenOwned(0,64,true).status() != 4 || writes != 0) return i32(4)
    busy=false;enabled=false
    if (c6I2sRxEofOpenOwned(0,64,true).status() != 3 || writes != 0) return i32(5)
    enabled=true
    if (c6I2sRxEofOpenOwned(0,0,true).status() != 2 || c6I2sRxEofOpenOwned(0,4096,true).status() != 2 || c6I2sRxEofOpenOwned(1,64,true).status() != 2 || c6I2sRxEofOpenOwned(0,64,false).status() != 2 || writes != 0) return i32(6)
    var owner=c6I2sRxEofOpenOwned(0,64,true)
    val before=writes
    busy=true;owner=owner.closeOwned(true)
    if (owner.status() != 4 || writes != before) return i32(7)
    busy=false;owner=owner.closeOwned(true)
    if (owner.status() != 6 || eof != u32(0xa5a51234)) return i32(8)
    return i32(0)
}
