import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/pad_c6_sequence.ab"
var pin=0
var role=0
var signal=12
var inputRoute=u32(0)
var mux=u32(0)
var route=u32(0)
var pad=u32(0)
var latch=u32(0)
var oe=u32(0)
var held=u32(0)
var lp=u32(0)
var busy=false
var writes=0
var drop=0
var bad=false
trusted fun c6I2sClockRead(offset: int): u32 = u32(1)
trusted fun c6I2sClockWrite(offset: int,value: u32): void { bad=true;return }
trusted fun c6I2sRead(offset: int): u32 = if (offset == 0x6c) u32(1) else if (offset == 0x14 && busy) u32(1) else u32(0)
trusted fun c6GpioRead(address: int): u32 {
    if (address == 0x600960e8 || address == 0x6009162c) return u32(1)
    if (address == 0x600960ec) return u32(0x700000)
    if (address == 0x6000f018) return u32(0)
    if (address == 0x60091154+signal*4) return inputRoute
    if (address == 0x600b102c) return held
    if (address == 0x600b1028) return lp
    if (address == 0x60091020) return oe
    if (address == 0x60091004) return latch
    if (address == 0x60090004+pin*4) return mux
    if (address == 0x60091554+pin*4) return route
    if (address == 0x60091074+pin*4) return pad
    bad=true;return u32(0)
}
trusted fun c6GpioWrite(address: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x60091028) oe=oe&~value
    else if (address == 0x60091024) oe=oe|value
    else if (address == 0x60091154+signal*4) inputRoute=value
    else if (address == 0x60091008) latch=latch|value
    else if (address == 0x6009100c) latch=latch&~value
    else if (address == 0x60090004+pin*4) mux=value
    else if (address == 0x60091554+pin*4) route=value
    else if (address == 0x60091074+pin*4) pad=value
    else bad=true
    return
}
@export("abla_i2s_pad_c6_test")
trusted fun test(): i32 {
    while (pin < 31) {
        role=0
        while (role < 13) {
            signal=if (role < 2) 12 else if (role < 4) 13 else if (role < 6) 14 else if (role < 8) 16 else if (role < 10) 17 else if (role < 12) 15 else 18
            var variant=0
            while (variant < 4) {
                val originalMux=u32(0xa5000000)|(if ((variant&1) != 0) u32(29570) else u32(0))
                val originalRoute=u32(0x80000255)
                val originalPad=u32(0x12300000)|(if ((variant&2) != 0) u32(4) else u32(0))
                val originalLatch=u32(0x80000000)|(if ((variant&1) != 0) u32(1)<<u32(pin) else u32(0))
                var fault=0
                while (fault <= 20) {
                    mux=originalMux;route=originalRoute;pad=originalPad;latch=originalLatch;oe=u32(0);inputRoute=u32(0xa50001aa);writes=0;drop=fault;bad=false
                    var owner=c6I2sPadOpenOwned(pin,role,true)
                    if (owner.status() != 1 && owner.status() != 4) return i32(1)
                    if (owner.status() == 1) {
                        val input=(role&1) != 0
                        if ((mux&u32(29570)) != (if (input) u32(4608) else u32(4096)) ||
                            (route&u32(2047)) != (if (input) u32(640) else u32(512|signal)) ||
                            (pad&u32(4)) != u32(0) || oe != (if (input) u32(0) else u32(1)<<u32(pin)) ||
                            inputRoute != (if (input) u32(0xa5000180)|u32(pin) else u32(0xa50001aa))) return i32(2)
                    }
                    owner=owner.closeOwned(true)
                    drop=0
                    owner=owner.closeOwned(true)
                    if (owner.status() != 5 || mux != originalMux || route != originalRoute || pad != originalPad || latch != originalLatch || oe != u32(0) || inputRoute != u32(0xa50001aa) || bad) return i32(3)
                    fault=fault+1
                }
                variant=variant+1
            }
            role=role+1
        }
        pin=pin+1
    }
    pin=1;role=0;signal=12;drop=0;writes=0;held=u32(2)
    if (c6I2sPadOpenOwned(pin,role,true).status() != 3 || writes != 0) return i32(4)
    held=u32(0);lp=u32(2)
    if (c6I2sPadOpenOwned(pin,role,true).status() != 3 || writes != 0) return i32(5)
    lp=u32(0);busy=true
    if (c6I2sPadOpenOwned(pin,role,true).status() != 3 || writes != 0) return i32(6)
    busy=false
    if (c6I2sPadOpenOwned(-1,role,true).status() != 2 || c6I2sPadOpenOwned(31,role,true).status() != 2 || c6I2sPadOpenOwned(pin,13,true).status() != 2 || c6I2sPadOpenOwned(pin,role,false).status() != 2 || writes != 0) return i32(7)
    return i32(0)
}
