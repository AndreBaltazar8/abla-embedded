import "../src/esp32/power/sleep_profile_defaults_p4.ab"
import "abla/unsafe/native"
@export("abla_sleep_profile_defaults_p4_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(nativeStaticAllocate(112),112)
    val expected=nativeBufferAt(nativeStaticAllocate(108),108)
    var option=0
    while (option < 128) {
        val flags=u32((if ((option&1) != 0) 1 else 0)|(if ((option&2) != 0) 1024 else 0)|
            (if ((option&4) != 0) 1<<30 else 0)|(if ((option&8) != 0) 1<<25 else 0)|
            (if ((option&16) != 0) 16384 else 0))
        val deep=(option&32) != 0;val psram=(option&64) != 0
        var revision=100
        while (revision <= 300) {
            r.storeU32(108,0xdeadbeef)
            if (!esp32p4SleepProfileDefaults(r,flags,revision,deep,psram,19,21,27,16000000,65536)) return i32(1)
            if (!esp32p4SleepPowerDefaults(nativeBufferAt(expected.addressValue(),32),flags&u32(0x4400ffd1),revision,deep) ||
                !esp32p4SleepAnalogDefaults(nativeBufferAt(expected.addressValue()+32,32),flags&u32(0x52000402),revision,deep,psram,19,21,27)) return i32(2)
            val xtal=expected.loadU32(8) != 0
            if (!esp32p4SleepTimingCalibrated(nativeBufferAt(expected.addressValue()+64,40),16000000,65536,(option&1) != 0,xtal)) return i32(3)
            expected.storeU32(104,esp32p4SleepDigitalDefaults(flags,revision))
            var i=0
            while (i < 108) { if (r.loadU32(i) != expected.loadU32(i)) return i32(4);i=i+4 }
            if (r.loadU32(108) != 0xdeadbeef) return i32(5)
            revision=revision+200
        }
        option=option+1
    }
    var i=0
    while (i < 112) { r.storeU32(i,0xdeadbeef);i=i+4 }
    // Timing overflow discovered after otherwise valid power/analog input.
    if (esp32p4SleepProfileDefaults(r,u32(0),300,false,false,19,21,27,16000000,1) ||
        esp32p4SleepProfileDefaults(r,u32(4),300,false,false,19,21,27,16000000,65536) ||
        esp32p4SleepProfileDefaults(r,u32(16),100,false,false,19,21,27,16000000,65536) ||
        esp32p4SleepProfileDefaults(r,u32(0),300,false,false,32,21,27,16000000,65536)) return i32(6)
    i=0
    while (i < 112) { if (r.loadU32(i) != 0xdeadbeef) return i32(7);i=i+4 }
    return i32(0)
}
