import "../src/m5stack/rtc_profile.ab"
fun main: int {
    val matches=m5BoardPowerHub.rtcKind() == m5RtcPowerHub &&
        m5BoardTab5.rtcKind() == m5RtcRx8130 &&
        m5BoardTab5X.rtcKind() == m5RtcRx8130 &&
        m5BoardCoreP4X.rtcKind() == m5RtcRx8130 &&
        m5BoardToughC5.rtcKind() == m5RtcRx8130 &&
        m5BoardStopWatch.rtcKind() == m5RtcRx8130 &&
        m5BoardStampPLC.rtcKind() == m5RtcRx8130 &&
        m5BoardPaperColor.rtcKind() == m5RtcRx8130 &&
        m5BoardPaperMono.rtcKind() == m5RtcRx8130 &&
        m5BoardChainCaptain.rtcKind() == m5RtcRx8130 &&
        m5BoardUnknown.rtcKind() == m5RtcPcf8563 &&
        m5BoardStackCore2.rtcKind() == m5RtcPcf8563
    if (matches) 0 else 1
}
