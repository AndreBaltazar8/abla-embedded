import "../src/power/axp2101_logic.ab"

fun main: int {
    val ldoCodes = axp2101LdoCode(499) == -1 &&
        axp2101LdoCode(500) == 0 && axp2101LdoCode(3500) == 30 &&
        axp2101LdoCode(5000) == 30 &&
        axp2101DldoCode(0, 3300) == 28 &&
        axp2101DldoCode(1, 1450) == 19 &&
        axp2101DldoCode(2, 1000) == -1
    val chargeCodes = axp2101PrechargeCurrentCode(0) == 0 &&
        axp2101PrechargeCurrentCode(199) == 7 &&
        axp2101PrechargeCurrentCode(200) == 8 &&
        axp2101ChargeCurrentCode(0) == 4 &&
        axp2101ChargeCurrentCode(125) == 5 &&
        axp2101ChargeCurrentCode(999) == 15 &&
        axp2101ChargeCurrentCode(1000) == 16 &&
        axp2101ChargeVoltageCode(3999) == 1 &&
        axp2101ChargeVoltageCode(4100) == 2 &&
        axp2101ChargeVoltageCode(4400) == 5
    val telemetry = axp2101Register14(65535) == 16383 &&
        axp2101Register14(50194) == 1042 &&
        axp2101ChargeStatus(32) == 1 &&
        axp2101ChargeStatus(64) == -1 &&
        axp2101ChargeStatus(96) == 0 &&
        axp2101AdcValid(16350) && !axp2101AdcValid(16351)
    val irq = axp2101PackIrqStatuses(1, 128, 64) == 4227073 &&
        axp2101IrqByte(4227073, 0) == 1 &&
        axp2101IrqByte(4227073, 1) == 128 &&
        axp2101IrqByte(4227073, 2) == 64 &&
        axp2101IrqByte(4227073, 3) == 0
    if (ldoCodes && chargeCodes && telemetry && irq) 54 else 1
}
