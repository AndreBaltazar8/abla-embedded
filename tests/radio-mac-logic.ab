import "../src/dma.ab"
import "../src/esp32/radio/mac_esp32_logic.ab"

fun main(): int {
    if (esp32WifiMacBase != 1073164288) return 1
    if (esp32WifiMacRegisterAddress(esp32WifiMacRxControlOffset) !=
        1073164420) return 2
    if (esp32WifiMacRegisterAddress(esp32WifiMacInterruptStatusOffset) !=
        1073167432) return 3
    if (esp32WifiMacTxConfigAddress(wifiMacBeaconQueue()) !=
        1073167612) return 4
    if (esp32WifiMacTxPlcp0Address(wifiMacVoiceQueue()) !=
        1073167648) return 5
    if (esp32WifiMacTxParameterAddress(wifiMacVoiceQueue(), 0) !=
        1073168984) return 6
    if (esp32WifiMacFilterAddress(wifiMacBssidFilter(), 3, 36) !=
        1073164348) return 7
    if (esp32WifiMacFilterAddress(wifiMacReceiverFilter(), 0, 0) !=
        1073164352) return 8
    if (esp32WifiMacFilterControlAddress(3) != 1073164516) return 9
    if (esp32WifiMacControlFrameFilterAddress(3) != 1073164548) return 10
    if (wifiMacBeaconQueue().statusBit() != 16) return 11
    if (wifiMacVoiceQueue().statusBit() != 1) return 12
    if (WifiMacTxQueue(5).statusBit() != 0) return 13
    if (esp32WifiMacPackChannelAccess(1023, 511, 7) !=
        119534591) return 14
    if (esp32WifiMacPackPlcp0(74565, true, true) !=
        151069509) return 15
    if (esp32WifiMacPackPlcp1(1500, 11, 7, true, true, 2) !=
        2450437596) return 16
    if (esp32WifiMacPackDuration(4660) != 305402420) return 17
    if (esp32WifiMacPackHtSignal(5, true, 1500) !=
        2265308165) return 18
    if (esp32WifiMacPackHtLength(1500) != 329180) return 19
    val descriptor = dmaDescriptorAt(1073414144)
    if (descriptor.addressValue() != 1073414144 ||
        descriptor.isNull() || !descriptor.isAligned(4)) return 20
    66
}
