import "../src/m5stack/tough_boot_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var bad=false
var buzzer=1
var inputs=1
var rails=1
var verdict=-1
var ownerRaw=0
var presenceRaw=0
fun m5ExpanderBusValid(bus: int): bool { bad=true; return false }
fun m5ExpanderAllocate(bus: int,address: int,frequency: int): int { bad=true; return 0 }
fun m5ExpanderBegin(handle: int,kind: int): bool { bad=true; return false }
fun m5ExpanderClose(handle: int): bool { bad=true; return false }
fun checkPmic(pmic: M5PmicOpen): void {
    if (pmic != M5PmicOpen(9|(5<<32)|(1<<40))) bad=true
    return
}
fun toughBootBuzzer(pmic: M5PmicOpen): int {
    checkPmic(pmic)
    if (calls != 0) bad=true
    calls=1
    buzzer
}
fun toughBootInputs(owner: M5Expanders,pmic: M5PmicOpen): int {
    checkPmic(pmic)
    if (calls != 1 || owner != ownerRaw) bad=true
    calls=2
    inputs
}
fun toughBootPresence(owner: M5Expanders,pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): int {
    checkPmic(pmic)
    if (calls != 2 || owner != ownerRaw || presence != presenceRaw || now != 4294967295) bad=true
    calls=3
    verdict
}
fun toughBootRails(owner: M5Expanders,pmic: M5PmicOpen): int {
    checkPmic(pmic)
    if (calls != 3 || owner != ownerRaw) bad=true
    calls=4
    rails
}
@export("abla_tough_boot_test")
trusted fun bootTest(): i32 {
    val owner=m5ExpandersAt(nativeBufferAt(nativeStaticAllocate(32),32))
    val presence=pm1BatteryPresenceAt(nativeBufferAt(nativeStaticAllocate(32),32))
    owner.initialize(); presence.initialize()
    owner.buffer().storeU32(8,m5BoardToughC5 | 0)
    owner.storeSlot(0,M5ExpanderOpen(8|(2<<32)|(1<<40))); owner.buffer().storeU32(4,1)
    ownerRaw=owner | 0; presenceRaw=presence | 0
    val pmic=M5PmicOpen(9|(5<<32)|(1<<40))
    var profile=0
    while (profile < 120) {
        val b=profile%6
        buzzer=(if (b < 3) b+1 else 3)|((b/3)<<8)
        inputs=if (((profile/6)&1) == 0) 1 else 4|(6<<8)
        verdict=(profile/12)%5-2
        rails=if (profile < 60) 1 else 4|(17<<8)
        calls=0; bad=false
        val result=owner.configureToughPeripheralsOwned(pmic,presence,4294967295)
        val bs=buzzer&255
        val stage=if (bs == 3) 1 else if (inputs != 1) 2 else if (verdict < -1 || verdict > 1) 3 else 4
        val ok=stage == 4 && rails == 1
        val detail=if (stage == 1) buzzer else if (stage == 2) inputs else if (stage == 4 && !ok) rails else 0
        if (result.status() != (if (ok) bs else 5) || result.peripheralsReady() != ok ||
            result.stage() != stage || result.detail() != detail || calls != stage || bad ||
            result.buzzerDegraded() != (bs == 2 && stage != 1) ||
            result.batteryPresence() != (if (stage == 4) verdict else -1)) return i32(1)
        profile=profile+1
    }
    calls=0
    if (owner.configureToughPeripheralsOwned(M5PmicOpen(0),presence,0).status() != 3 ||
        owner.configureToughPeripheralsOwned(pmic,Pm1BatteryPresence(0),0).status() != 3 || calls != 0) return i32(2)
    owner.buffer().storeU32(8,m5BoardCoreMatrix | 0)
    if (owner.configureToughPeripheralsOwned(pmic,presence,0).status() != 4 || calls != 0) return i32(3)
    owner.buffer().storeU32(4,6)
    if (owner.configureToughPeripheralsOwned(pmic,presence,0).status() != 3 || calls != 0) return i32(4)
    i32(0)
}
