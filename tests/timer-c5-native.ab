import "../src/esp32/timer_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var unit = 0
var polls = 4
var delay = 0
var changes = 0
var reads = 0
var values = 0
var writes = 0
var bad = false
fun esp32C5TimerWrite(address: int, value: u32): void {
    if (address != 0x6000A004 + unit*4 || value != u32(0x40000055) || reads != 1 || writes != 0) bad = true
    writes = writes + 1
    return
}
fun esp32C5TimerRead(address: int): u32 {
    if (address == 0x6000A004 + unit*4) {
        reads = reads + 1
        if (reads == 1) return u32(0x55)
        if (writes != 1) bad = true
        return if (reads-2 >= delay) u32(0x20000000) else u32(0)
    }
    if (writes != 1 || reads-2 < delay) bad = true
    if (address == 0x6000A040 + unit*8) {
        if (values == 0) bad = true
        return u32(0xfffabcde)
    }
    if (address != 0x6000A044 + unit*8) bad = true
    val index = values
    values = values + 1
    // Simulate a snapshot changing between split reads, including low wrap.
    if (index == 0 && changes > 0) return u32(0xffffffff)
    if (index < changes) return u32(index)
    u32(changes)
}
@export("abla_timer_c5_test")
trusted fun timerC5Test(): i32 {
    while (unit < 2) {
        delay = 0
        while (delay <= 4) {
            changes = 0
            while (changes <= 5) {
                reads = 0; writes = 0; values = 0
                val result = esp32C5TimerTicks(unit,polls)
                val expected = if (delay >= polls) -2 else if (changes >= polls) -3 else (703710 << 32) | changes
                if (result != expected || writes != 1 || bad) return i32(1)
                if (delay >= polls && values != 0) return i32(2)
                changes = changes + 1
            }
            delay = delay + 1
        }
        unit = unit + 1
    }
    reads = 0; writes = 0
    if (esp32C5TimerTicks(-1,4) != -1 || esp32C5TimerTicks(2,4) != -1 ||
        esp32C5TimerTicks(0,0) != -1 || esp32C5TimerTicks(0,1000001) != -1 ||
        reads != 0 || writes != 0) return i32(3)
    i32(0)
}
