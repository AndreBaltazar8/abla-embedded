import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/cores3_microphone_stream.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun microphoneStreamTarget(handle: u32, channel: i32, descriptors: u32, stop: bool): int {
    val result = if (stop) cores3StopMicrophoneStream(Es7210(int(handle)), int(channel), 1000)
        else cores3StartMicrophoneStream(Es7210(int(handle)), int(channel), int(descriptors), 1000)
    result.status() | (result.dmaStatus() << 8) | (result.codecStatus() << 24)
}
#exportFunction("microphoneStreamTarget", "abla_s3_microphone_stream_test")
