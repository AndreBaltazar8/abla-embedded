import "../src/display/spi_program_c5_sequence.ab"
import "../src/display/mipi_programs.ab"
import "abla/runtime/scalar"
import "abla/build"
val gateMemory=nativeStaticAllocate(4)
val commands=nativeStaticU32s([200,192,193,197,176,246,224,225,182,56,41,17])
val counts=nativeStaticU32s([3,2,1,1,1,3,15,15,4,0,0,0])
var calls=0
var failure=0
var delays=0
var bad=false
var admit=true
var prefix=0
var failedPrefix=0
var custom=false
fun c5LcdProgramAdmission(master: int,dc: int): bool {
    if (master != 123 || dc != 26) bad=true
    return admit
}
trusted fun c5LcdProgramCommand(master: int,dc: int,command: int,data: NativeBuffer,bytes: int,polls: int): SpiBufferResult {
    val gate=peripheralGateAt(gateMemory)
    if (gate.tryBegin(u32(9)) != 1 || master != 123 || dc != 26 || polls != 4) bad=true
    if (!custom) {
        if (calls >= 12 || command != nativeAddressLoadU32(commands,calls*4) ||
            bytes != nativeAddressLoadU32(counts,calls*4) || data.addressValue() != ili9342InitProgram().addressValue()+prefix+2) bad=true
    } else if (command != 17 || bytes != 0) bad=true
    failedPrefix=prefix
    prefix=prefix+2+bytes
    calls=calls+1
    if (calls == failure) return SpiBufferResult((6<<56)|263|(1<<24))
    return SpiBufferResult((1<<56)|(bytes<<32)|257|(1<<25))
}
fun peripheralDelayMilliseconds(ms: int): void {
    if (ms != (if (custom) 500 else 120) || (!custom && calls != 12) ||
        peripheralGateAt(gateMemory).tryBegin(u32(9)) != 1) bad=true
    delays=delays+1;prefix=prefix+1;return
}
@export("abla_spi_program_c5_test")
trusted fun test(): int {
    val gate=peripheralGateAt(gateMemory)
    val program=ili9342InitProgram()
    failure=0
    while (failure <= 12) {
        nativeAddressStoreU32(gateMemory,0,0);calls=0;delays=0;bad=false;prefix=0
        val result=esp32C5LcdRunProgram(123,gate,u32(7),26,program,72,4)
        if (result.status() != (if (failure == 0) 1 else 6) ||
            result.completedBytes() != (if (failure == 0) 72 else failedPrefix) ||
            calls != (if (failure == 0) 12 else failure) ||
            delays != (if (failure == 0) 1 else 0) || bad) return 1
        if (failure != 0 && esp32C5LcdRunProgram(123,gate,u32(8),26,program,72,4).status() != 4) return 2
        failure=failure+1
    }
    nativeAddressStoreU32(gateMemory,0,0);calls=0
    var length=0
    while (length < 72) {
        if (esp32C5LcdRunProgram(123,gate,u32(7),26,program,length,4).status() != 3 || calls != 0) return 3
        length=length+1
    }
    admit=false
    if (esp32C5LcdRunProgram(123,gate,u32(7),26,program,72,4).status() != 6 || calls != 0) return 4
    admit=true;custom=true;failure=0;calls=0;delays=0;bad=false;prefix=0
    nativeAddressStoreU32(gateMemory,0,0)
    val delayed=nativeBufferAt(nativeStaticBytes("\x11\x80\xff\xff\xff"),5)
    if (!esp32C5LcdRunProgram(123,gate,u32(7),26,delayed,5,4).valid() ||
        calls != 1 || delays != 1 || bad) return 5
    return 0
}
