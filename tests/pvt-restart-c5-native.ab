import "../src/esp32/power/pvt_restart_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(88)
val parkMemory=nativeStaticAllocate(24)
var writes=0
var failAt=0
var delayed=0
var rawGap=0
var bad=false
var revision=0x200
fun slot(address: int): int = if (address == 0x600960b8) 0 else if (address == 0x600960bc) 1 else if (address == 0x60019064) 2 else if (address == 0x60019034) 3 else if (address == 0x6001903c) 4 else if (address == 0x60019040) 5 else if (address == 0x60019044) 6 else if (address == 0x60019050) 7 else if (address == 0x60019054) 8 else if (address == 0x60019058) 9 else if (address == 0x600190d8) 10 else if (address == 0x600190dc) 11 else if (address == 0x600190e0) 12 else if (address == 0x6001902c) 13 else if (address == 0x60019014) 14 else if (address == 0x60019028) 15 else if (address == 0x600b0028) 16 else if (address == 0x60019030) 17 else -1
trusted fun reg(address: int): int = nativeBufferAt(memory+16,72).loadU32(slot(address)*4)
trusted fun put(address: int,value: int): void { nativeBufferAt(memory+16,72).storeU32(slot(address)*4,value);return }
trusted fun c5PvtParkRead(address: int): int {
    if (address == 0x60096144 || address == 0x60096110) return 0
    if (address == 0x600b49d4) return 1
    if (address == 0x600b484c) return revision
    if (address == 0x600b4854) return rawGap<<1
    if (address == 0x600b009c) return nativeBufferAt(parkMemory,24).loadU32(20)
    if (slot(address) < 0) { bad=true;return 0 }
    if (address >= 0x60019000 && address < 0x60019100 && (reg(0x600960b8)&1) == 0) bad=true
    // WT bit reads as1 deliberately: implementation must not replay it.
    if (address == 0x600190d8 || address == 0x600190dc || address == 0x600190e0) return reg(address)|2
    reg(address)
}
trusted fun c5PvtParkWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (address == 0x600b009c) { nativeBufferAt(parkMemory,24).storeU32(20,value);return }
    if (slot(address) < 0) { bad=true;return }
    if ((address == 0x600190d8 || address == 0x600190dc || address == 0x600190e0) && (value&2) != 0) bad=true
    if (address == 0x600b0028 && (value&0x4000) == 0 && (reg(address)&0x4000) != 0 && delayed < 11) bad=true
    if (address == 0x60019028 && (value&512) != 0 && delayed < 61) bad=true
    if (address == 0x600960b8 && (value&2) != 0) {
        put(0x60019064,0)
        put(0x60019034,0)
        put(0x6001903c,0)
        put(0x60019040,0)
        put(0x60019044,0)
        put(0x60019050,0)
        put(0x60019054,0)
        put(0x60019058,0)
        put(0x600190d8,0)
        put(0x600190dc,0)
        put(0x600190e0,0)
        put(0x6001902c,0)
        put(0x60019014,0)
        put(0x60019028,0)
        put(0x60019030,0)
    }
    put(address,value);return
}
trusted fun c5PvtRestartDelay(us: int): void {
    if (us != 1 && us != 10 && us != 50) bad=true
    if (us == 1 && (reg(0x60019064)&0x80000000) != 0) bad=true
    if (us == 10 && (reg(0x600190d8)&1) == 0) bad=true
    if (us == 50 && ((reg(0x60019064)&0x80000000) == 0 || (reg(0x600b0028)&0x4008) != 0)) bad=true
    delayed=delayed+us;return
}
@export("abla_pvt_restart_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,16);val regs=nativeBufferAt(memory+16,72);val parkRecord=nativeBufferAt(parkMemory,24)
    rawGap=0
    while (rawGap < 32) {
        val signed=if (rawGap < 16) rawGap-8 else -(rawGap&15)-8
        val encoded=if (signed >= 0) signed else if (signed < -15) 31 else 16-signed
        if (esp32C5PvtGap(rawGap) != encoded) return i32(1)
        var fault=0
        while (fault <= 33) {
            var i=0;while (i < 72) { regs.storeU32(i,0);i=i+4 }
            put(0x600b0028,0x4000|(23<<9)|(17<<4))
            record.storeU32(0,0);parkRecord.storeU32(0,0);writes=0;failAt=fault;delayed=0;bad=false
            val result=esp32C5PvtRestartOwned(record,true)
            if (result != 1 && result != 3) return i32(2)
            failAt=0
            if (esp32C5PvtRestartOwned(record,true) != 1 || bad || delayed != 61) return i32(3)
            val gap=((encoded>>4)<<16)|((encoded&15)<<11)
            if (reg(0x60019034) != ((33<<25)|(37<<18)) || reg(0x6001903c) != 0x13e80 || reg(0x60019040) != 0x13e80 || reg(0x60019044) != 0x10000) return i32(4)
            if (reg(0x60019050) != (gap|0x24) || reg(0x60019054) != (gap|5) || reg(0x60019058) != (gap|0x427)) return i32(5)
            if (reg(0x60019064) != 0xffff8000 || reg(0x600960bc) != 0x500001 || reg(0x600960b8) != 1 || reg(0x600190d8) != ((154<<2)|1) || reg(0x600190dc) != 147<<2 || reg(0x600190e0) != 143<<2) return i32(6)
            if (reg(0x6001902c) != 1<<27 || reg(0x60019014) != 1<<22 || reg(0x60019028) != 512 || reg(0x60019030) != 256 || (reg(0x600b0028)&0x4008) != 0) return i32(7)
            val before=writes
            if (esp32C5PvtRestartOwned(record,true) != 1 || writes != before) return i32(8)
            if (esp32C5PvtParkOwned(parkRecord,true) != 1 || parkRecord.loadU32(8) != 23 || parkRecord.loadU32(12) != 17 || bad) return i32(9)
            fault=fault+1
        }
        rawGap=rawGap+1
    }
    record.storeU32(0,0);revision=0;writes=0
    if (esp32C5PvtRestartOwned(record,true) != 2 || esp32C5PvtRestartOwned(record,false) != 2 || writes != 0 || esp32C5PvtGap(-1) != -1 || esp32C5PvtGap(32) != -1) return i32(10)
    return i32(0)
}
