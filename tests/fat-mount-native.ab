import "../src/storage/fat_mount.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1052)
var calls=0
var failure=0
var mode=0
var bad=false
trusted fun put32(b: NativeBuffer,o: int,v: int): void {
    b.store(o,v&255); b.store(o+1,(v>>8)&255); b.store(o+2,(v>>16)&255); b.store(o+3,(v>>24)&255); return
}
trusted fun fatStorageReadOwned(reader: NativeBuffer,sector: int,destination: NativeBuffer): bool {
    calls=calls+1
    if (sector != 0 && sector != 2048) bad=true
    var index=0
    while (index < 512) { destination.store(index,0); index=index+1 }
    destination.store(510,85); destination.store(511,170)
    if (sector == 0 && mode != 1) {
        destination.store(450,if (mode == 3) 238 else 6)
        put32(destination,454,2048); put32(destination,458,11000)
    } else {
        destination.store(12,2); destination.store(13,1); destination.store(14,1); destination.store(16,2); destination.store(18,2)
        destination.store(22,40); destination.store(19,129); destination.store(20,39)
        if (mode == 2) destination.store(12,0)
    }
    return calls != failure
}
@export("abla_fat_mount_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(storage,28)
    val boot=nativeBufferAt(storage+28,512)
    val scratch=nativeBufferAt(storage+540,512)
    val mounted=fatMountReadOwned(reader,13048,0,boot,scratch)
    if (!mounted.valid() || mounted.firstSector() != 2048 || mounted.sectors() != 10113 || calls != 2 || !fatBootValidate(boot,mounted.firstSector(),mounted.sectors()).valid() || bad) return i32(1)
    mode=1; calls=0
    val unpartitioned=fatMountReadOwned(reader,4294967296,-1,boot,scratch)
    if (!unpartitioned.valid() || unpartitioned.firstSector() != 0 || unpartitioned.sectors() != 10113 || calls != 1) return i32(2)
    mode=0; calls=0
    if (fatMountReadOwned(reader,13047,0,boot,scratch).status() != 4 || calls != 1) return i32(3)
    mode=3; calls=0
    if (fatMountReadOwned(reader,13048,0,boot,scratch).status() != 4 || calls != 1) return i32(4)
    mode=2; calls=0
    if (fatMountReadOwned(reader,13048,0,boot,scratch).status() != 5 || calls != 2) return i32(5)
    mode=0; failure=1; calls=0
    if (fatMountReadOwned(reader,13048,0,boot,scratch).status() != 3 || calls != 1) return i32(6)
    failure=2; calls=0
    if (fatMountReadOwned(reader,13048,0,boot,scratch).status() != 3 || calls != 2) return i32(7)
    failure=0; calls=0
    if (fatMountReadOwned(reader,13048,4,boot,scratch).status() != 2 || fatMountReadOwned(reader,13048,0,boot,boot).status() != 2 ||
        fatMountReadOwned(reader,13048,0,nativeBufferAt(storage,512),scratch).status() != 2 || fatMountReadOwned(reader,13048,0,boot,nativeBufferAt(storage+540,511)).status() != 2 || calls != 0 || bad) return i32(8)
    return i32(0)
}
