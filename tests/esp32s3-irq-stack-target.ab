import "../src/esp32/irq_stack_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_irq_stack_target")
@section(".iram1.abla.s3IrqStackTarget")
trusted fun irqStackTarget(stack: NativeBuffer,core: int,callback: int,context: int,release: bool): bool =
    if (release) esp32S3IrqStackReleaseOwned(core) else esp32S3IrqStackInitializeOwned(stack,core,callback,context)
