import "./spi-buffer-c5-native.ab"
import "../src/esp32/spi/async_buffer_c5_sequence.ab"
val bulkContextMemory=nativeStaticAllocate(96)
@export("abla_spi_async_buffer_c5_test")
trusted fun testAsyncBuffer(): i32 {
    val gate=peripheralGateAt(gateStorage);val context=nativeBufferAt(bulkContextMemory,96)
    initialize();timeout=false;timeoutAt=0;starts=0;nativeAddressStoreU32(gateStorage,0,0)
    val master=openMaster(0)
    if (!master.ready() || !esp32C5SpiAsyncBufferInitialize(context)) return i32(1)
    var variant=0
    while (variant < 10) {
        val size=if (variant == 0) 1 else if (variant == 1) 63 else if (variant == 2) 64 else if (variant == 3) 65 else if (variant == 4) 127 else if (variant == 5) 128 else if (variant == 6) 512 else if (variant == 7) 513 else if (variant == 8) 65534 else 65535
        var inplace=0
        while (inplace < 3) {
            val tx=nativeBufferAt(buffers+1,size);val rx=if (inplace == 1) tx else nativeBufferAt(buffers+65541,size)
            var at=0;while (at < size) { tx.store(at,(at*17+variant)&255);if (inplace != 1) rx.store(at,90);at=at+1 }
            val gpioBefore=writes;val startBefore=starts
            var now=u32(4294967040)
            var result=master.beginBufferAsync(context,gate,u32(7),tx,rx,size,now,u32(100000),inplace != 2)
            var polls=0
            while (result == SpiBufferResult(0) && polls < 4000) {
                if (writes != gpioBefore+1 || gate.tryBegin(u32(8)) != 1) return i32(2)
                now=now+u32(1);result=esp32C5SpiAsyncBufferPoll(context,now);polls=polls+1
            }
            if (!result.valid() || result.completedBytes() != size || result.detail() != 257 || writes != gpioBefore+2 || starts != startBefore+(size+63)/64 || bad) return i32(3)
            at=0;while (at < size) { if (rx.load(at) != (if (inplace == 2) 90 else ((at*17+variant)&255)^255)) return i32(4);at=at+1 }
            val lastWrites=spiWrites
            if (esp32C5SpiAsyncBufferPoll(context,now+u32(100)) != result || spiWrites != lastWrites) return i32(5)
            inplace=inplace+1
        }
        variant=variant+1
    }
    val tx=nativeBufferAt(buffers,512);val rx=nativeBufferAt(buffers+1024,512)
    var cut=1
    while (cut <= 8) {
        var at=0;while (at < 512) { tx.store(at,at&255);rx.store(at,90);at=at+1 }
        timeoutAt=starts+cut
        var result=master.beginBufferAsync(context,gate,u32(7),tx,rx,512,u32(0),u32(64))
        var now=1
        while (result == SpiBufferResult(0) && now <= 64) { result=esp32C5SpiAsyncBufferPoll(context,u32(now));now=now+1 }
        if (result.status() != 6 || result.completedBytes() != (cut-1)*64 || (result.detail()&255) != 7 ||
            (result.detail()&(1<<24)) == 0 || (c5GpioRead(0x60091004)&u32(1<<25)) != u32(0) || bad) return i32(6)
        at=0;while (at < 512) { if (rx.load(at) != (if (at < (cut-1)*64) (at&255)^255 else 90)) return i32(7);at=at+1 }
        active=false;timeoutAt=0
        if (!master.recover(gate,u32(8),true)) return i32(8)
        cut=cut+1
    }
    // Overall deadline is not reset at each successful chunk.
    var result=master.beginBufferAsync(context,gate,u32(7),tx,rx,512,u32(0),u32(6))
    var now=1
    while (result == SpiBufferResult(0) && now <= 6) { result=esp32C5SpiAsyncBufferPoll(context,u32(now));now=now+1 }
    if (result.status() != 6 || result.completedBytes() != 64 || !master.recover(gate,u32(8),true)) return i32(9)
    val gpioBefore=writes;val spiBefore=spiWrites
    if (master.beginBufferAsync(context,gate,u32(7),tx,nativeBufferAt(buffers+1,512),512,u32(0),u32(10)).status() != 3 ||
        master.beginBufferAsync(context,gate,u32(7),nativeBufferAt(bulkContextMemory+64,7),rx,7,u32(0),u32(10)).status() != 3 ||
        master.beginBufferAsync(context,peripheralGateAt(bulkContextMemory+64),u32(7),tx,rx,7,u32(0),u32(10)).status() != 3 ||
        writes != gpioBefore || spiWrites != spiBefore || master.closeOwned(true) != 0 || bad) return i32(10)
    return i32(0)
}
