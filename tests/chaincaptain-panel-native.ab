import "../src/m5stack/chaincaptain_panel_s3_sequence.ab"
import "../src/display/spi_mipi_sequence_esp32s3.ab"
import "../src/display/spi_program_sequence_esp32s3.ab"
import "../src/esp32/spi/buffer_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
val gateStorage=nativeStaticAllocate(4)
// Pinned M5GFX ST7789 sequence, independent byte oracle.
val expected=nativeStaticBytes("\xb7\x01\x35\xbb\x01\x28\xc0\x01\x0c\xc2\x02\x01\xff\xc3\x01\x10\xc4\x01\x20\xd0\x02\xa4\xa1\xb0\x02\x00\xc0\xe0\x0e\xd0\x00\x02\x07\x0a\x28\x32\x44\x42\x06\x0e\x12\x14\x17\xe1\x0e\xd0\x00\x02\x07\x0a\x28\x31\x54\x47\x0e\x1c\x17\x1b\x1e\x11\x80\x82\x38\x00\x29\x00\xff\xff")
var calls=0
var cursor=0
var fail=-1
var rotation=0
var bad=false
var delays=0
fun esp32s3SpiCommandPinsValid(peripheral: int,pins: SpiPins,select: Pin,dc: Pin,shared: bool): bool =
    peripheral == 2 && pins == spiPins(16,-1,15) && select == 45 && dc == 46 && !shared
fun esp32s3SpiRead(address: int): int { bad=true;return 0 }
fun esp32s3SpiWrite(address: int,value: int): void { bad=true;return }
fun physicalRotation(): int = if (rotation < 4) (rotation+2)%4 else 4+(rotation-2)%4
trusted fun next(): int {
    if (nativeAddressLoadU32(gateStorage,0) != 37) bad=true
    val index=calls;calls=calls+1
    return if (index == fail) 0x20109 else 257
}
trusted fun esp32s3SpiCommandOwned(peripheral: int,select: Pin,dc: Pin,command: int,data: NativeBuffer,bytes: int,shared: bool): int {
    if (peripheral != 2 || select != 45 || dc != 46 || shared) bad=true
    if (calls < 13) {
        val oracle=nativeBufferAt(expected,68)
        val length=oracle.load(cursor+1)&127
        if (command != oracle.load(cursor) || bytes != length) bad=true
        var n=0
        while (n < bytes) {
            if (data.load(n) != oracle.load(cursor+2+n)) bad=true
            n=n+1
        }
        cursor=cursor+2+length+(if ((oracle.load(cursor+1)&128) != 0) 1 else 0)
    } else if (calls != 15 || command != 33 || bytes != 0) bad=true
    return next()
}
trusted fun esp32s3SpiCommandWordOwned(peripheral: int,select: Pin,dc: Pin,command: int,value: u32,bytes: int,shared: bool): int {
    if (peripheral != 2 || select != 45 || dc != 46 || shared || bytes != 1 ||
        (calls == 13 && (command != 58 || value != u32(85))) ||
        (calls == 14 && (command != 54 || value != u32(lcdMadctl(physicalRotation(),true)))) ||
        (calls != 13 && calls != 14)) bad=true
    return next()
}
fun peripheralDelayMilliseconds(ms: int): void {
    if (ms != 130 || calls != 11 || fail == 10) bad=true
    delays=delays+1;return
}
@export("abla_chaincaptain_panel_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateStorage)
    while (rotation < 8) {
        val view=chainCaptainDisplayView(rotation)
        val physical=physicalRotation()
        val col=if ((physical&2) != 0 && (physical&1) != 0) 80 else 0
        val row=if (((1<<physical)&150) != 0 && (physical&1) == 0) 80 else 0
        if (chainCaptainPanelRotation(rotation) != physical || view.width() != 240 || view.height() != 240 ||
            view.columnStart() != col || view.rowStart() != row || view.madctl() != lcdMadctl(physical,true)) return i32(1)
        fail=-1
        while (fail < 16) {
            calls=0;cursor=0;bad=false;delays=0;nativeAddressStoreU32(gateStorage,0,0)
            val result=chainCaptainPanelBeginOwned(gate,u32(37),rotation)
            if (result.status() != (if (fail < 0) 1 else 6) || calls != (if (fail < 0) 16 else fail+1) || bad ||
                delays != (if (fail < 0 || fail > 10) 1 else 0) ||
                nativeAddressLoadU32(gateStorage,0) != (if (fail < 0) 0 else 2147483648)) return i32(2)
            if (fail >= 0 && result.value() != u32(0x20109)) return i32(3)
            fail=fail+1
        }
        rotation=rotation+1
    }
    calls=0
    if (chainCaptainPanelBeginOwned(gate,u32(37),-1).status() != 3 ||
        chainCaptainPanelBeginOwned(gate,u32(37),8).status() != 3 || calls != 0) return i32(4)
    nativeAddressStoreU32(gateStorage,0,12)
    if (chainCaptainPanelBeginOwned(gate,u32(37),0).status() != 2 || calls != 0) return i32(5)
    nativeAddressStoreU32(gateStorage,0,2147483648)
    if (chainCaptainPanelBeginOwned(gate,u32(37),0).status() != 4 || calls != 0) return i32(6)
    return i32(0)
}
