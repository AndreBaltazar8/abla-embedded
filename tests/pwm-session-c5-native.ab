import "../src/esp32/pwm_session_c5_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
var writes=0
var drop=0
var fault=0
var bad=false
var expectedUnit=0
var txPin=0
var rxPin=1
fun addressOffset(address: int): int = if (address >= 0x60090000 && address < 0x60090078) address-0x60090000 else
    if (address >= 0x60091000 && address < 0x60091b4c) 256+address-0x60091000 else -1
fun c5GpioRead(address: int): u32 {
    if (address == 0x600960f0) return if (fault == 1) u32(3) else u32(1)
    if (address == 0x600960f4) return if (fault == 2) u32(0) else u32(0x400000)
    if (address == 0x60091df8) return u32(1)
    if (address == 0x600b102c) return if (fault == 3) u32(1)<<u32(txPin) else u32(0)
    if (address == 0x600b1028 || address == 0x6000f018) return u32(0)
    val at=addressOffset(address)
    if (at < 0) { bad=true;return u32(0) }
    return u32(nativeAddressLoadU32(memory,at))
}
fun c5GpioWrite(address: int,value: u32): void {
    writes=writes+1
    var at=addressOffset(address);var wanted=value
    if (address == 0x60091008 || address == 0x60091038) { at=at-4;wanted=u32(nativeAddressLoadU32(memory,at))|value }
    if (address == 0x6009100c || address == 0x6009103c) { at=at-8;wanted=u32(nativeAddressLoadU32(memory,at))&~value }
    if (at < 0) { bad=true;return }
    if (writes != drop) nativeAddressStoreU32(memory,at,int(wanted))
    return
}
val peripheral=nativeStaticAllocate(2048)
val recordMemory=nativeStaticAllocate(88)
var bus=4
var functional=0x200000
var memoryPower=4
var channel=0
var timer=0
var stallTimer=false
var stallDuty=false
fun c5LedcClockRead(offset: int): int = if (offset == 0) bus else if (offset == 4) functional else memoryPower
fun c5LedcClockWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0) bus=value else if (offset == 4) functional=value else if (offset == 8) memoryPower=value else bad=true
    return
}
fun c5LedcRead(offset: int): int {
    if ((bus&5) != 5 || offset < 0 || offset >= 2048 || offset%4 != 0) { bad=true;return 0 }
    return nativeAddressLoadU32(peripheral,offset)
}
fun c5LedcWrite(offset: int,value: int): void {
    if ((bus&5) != 5 || offset < 0 || offset >= 2048 || offset%4 != 0) { bad=true;return }
    writes=writes+1
    if (writes == drop) return
    var stored=value
    if (offset >= 160 && offset <= 184 && (offset-160)%8 == 0 && !stallTimer) stored=value&~0x4000000
    if (offset == channel*20 && (value&16) != 0 &&
        !(stallDuty && nativeAddressLoadU32(recordMemory,8) == 5)) {
        stored=value&~16
        if ((nativeAddressLoadU32(peripheral,offset+12)&0x80000000) != 0) {
            nativeAddressStoreU32(peripheral,offset+12,0)
            nativeAddressStoreU32(peripheral,offset+16,nativeAddressLoadU32(peripheral,offset+8))
        }
    }
    nativeAddressStoreU32(peripheral,offset,stored);return
}
@export("abla_pwm_session_c5_test")
trusted fun testPwm(): int {
    val record=nativeBufferAt(recordMemory,88)
    var scenario=0
    while (scenario < 960) {
        channel=scenario%6;timer=(scenario/6)%4;txPin=(scenario%29)
        writes=0;drop=0;fault=0;bad=false;record.storeU32(0,0)
        var at=0
        while (at < 4096) { nativeAddressStoreU32(memory,at,0);at=at+4 }
        at=0
        while (at < 2048) { nativeAddressStoreU32(peripheral,at,0);at=at+4 }
        at=0
        while (at < 4) { nativeAddressStoreU32(peripheral,160+at*8,0x1000000);at=at+1 }
        nativeAddressStoreU32(memory,addressOffset(0x60091ad4+txPin*4),1280)
        val gates=scenario%8
        bus=4|(gates&1);functional=0x200000|((gates&2)<<21);memoryPower=(gates&4)^4
        val oldBus=bus;val oldFunctional=functional;val oldMemory=memoryPower
        val failure=scenario/24
        drop=if (failure < 38) failure else 0
        stallTimer=failure == 38;stallDuty=failure == 39
        val opened=c5PwmSessionOpenOwned(record,2,80000000,1000,8,timer,channel,txPin,128,3,true)
        if ((opened != 1 && opened != 3) || bad) return 1
        if (opened == 1 && (nativeAddressLoadU32(peripheral,channel*20+16) != 2048 ||
            (c5GpioRead(0x60091034)&(u32(1)<<u32(txPin))) == u32(0))) return 2
        if (opened == 1) {
            drop=0
            val admittedWrites=writes;val oldDuty=record.loadU32(32)
            if (c5PwmSessionSetDutyOwned(record,257,3,true) != 2 ||
                c5PwmSessionSetDutyOwned(record,0,3,false) != 2 || writes != admittedWrites ||
                record.loadU32(4) != 1 || record.loadU32(32) != oldDuty) return 15
            val originalTimer=nativeAddressLoadU32(peripheral,160+timer*8)
            nativeAddressStoreU32(peripheral,160+timer*8,originalTimer^32)
            if (c5PwmSessionSetDutyOwned(record,1,3,true) != 6 || writes != admittedWrites) return 16
            nativeAddressStoreU32(peripheral,160+timer*8,originalTimer)
            var updated=0
            while (updated <= (if (failure == 0) 256 else 2)) {
                if (c5PwmSessionSetDutyOwned(record,updated,3,true) != 1 ||
                    nativeAddressLoadU32(peripheral,channel*20+16) != updated*16 ||
                    record.loadU32(32) != updated || nativeAddressLoadU32(peripheral,160+timer*8) != originalTimer) return 17
                updated=updated+1
            }
            stallDuty=true
            if (c5PwmSessionSetDutyOwned(record,33,3,true) != 5 || record.loadU32(4) != 3) return 18
            val pendingWrites=writes
            if (c5PwmSessionWaitDutyOwned(record,3,true) != 5 ||
                c5PwmSessionSetDutyOwned(record,44,3,true) != 2 || writes != pendingWrites) return 19
            stallDuty=false
            nativeAddressStoreU32(peripheral,channel*20,nativeAddressLoadU32(peripheral,channel*20)&~16)
            nativeAddressStoreU32(peripheral,channel*20+12,0)
            nativeAddressStoreU32(peripheral,channel*20+16,32*16)
            if (c5PwmSessionWaitDutyOwned(record,3,true) != 4 || record.loadU32(4) != 3) return 20
            nativeAddressStoreU32(peripheral,channel*20+16,33*16)
            if (c5PwmSessionWaitDutyOwned(record,3,true) != 1 || record.loadU32(4) != 1 || writes != pendingWrites) return 21
        }
        val evidence=record.loadU32(40);val beforeWrites=writes
        if (c5PwmSessionOpenOwned(record,2,80000000,1000,8,timer,channel,txPin,128,3,true) != 2 || writes != beforeWrites) return 3
        if (stallTimer || stallDuty) {
            if (c5PwmSessionCloseOwned(record,3,true) != 4 || writes != beforeWrites) return 4
            // Simulate eventual hardware completion, never a driver reset.
            stallTimer=false;stallDuty=false
            nativeAddressStoreU32(peripheral,160+timer*8,nativeAddressLoadU32(peripheral,160+timer*8)&~0x4000000)
            nativeAddressStoreU32(peripheral,channel*20,nativeAddressLoadU32(peripheral,channel*20)&~16)
            nativeAddressStoreU32(peripheral,channel*20+12,0)
        }
        drop=writes+1
        val closed=c5PwmSessionCloseOwned(record,3,true)
        if (closed != 4 && closed != 5) return 5
        drop=0
        val retried=c5PwmSessionCloseOwned(record,3,true)
        if (retried != 5) {
            // A dropped final PARA_UP leaves staged DUTY_START unpublished.
            // No completion can be assumed; retain the complete lease rather
            // than resetting hardware or silently discarding the request.
            if (retried != 4 || record.loadU32(8) != 5 ||
                (nativeAddressLoadU32(peripheral,channel*20)&16) != 0 ||
                (nativeAddressLoadU32(peripheral,channel*20+12)&0x80000000) == 0 ||
                record.loadU32(4) != 4 || record.loadU32(40) != evidence || bad) return 9
            val pendingWrites=writes
            if (c5PwmSessionCloseOwned(record,3,true) != 4 || writes != pendingWrites) return 10
            if (c5PwmSessionRecoverPublicationOwned(record,3,true,false) != 2 || writes != pendingWrites) return 11
            stallDuty=true
            if (c5PwmSessionRecoverPublicationOwned(record,3,true,true) != 4 || record.loadU32(44) != 4 ||
                c5GpioRead(0x60091034) != u32(0)) return 12
            val recoveryWrites=writes
            if (c5PwmSessionRecoverPublicationOwned(record,3,true,true) != 4 || writes != recoveryWrites ||
                c5PwmSessionCloseOwned(record,3,true) != 4 || writes != recoveryWrites) return 13
            // The one isolated publication eventually completes in hardware.
            stallDuty=false
            nativeAddressStoreU32(peripheral,channel*20,nativeAddressLoadU32(peripheral,channel*20)&~16)
            nativeAddressStoreU32(peripheral,channel*20+12,0)
            if (c5PwmSessionRecoverPublicationOwned(record,3,true,true) != 5) return 14
        }
        if (bad ||
            bus != oldBus || functional != oldFunctional || memoryPower != oldMemory ||
            c5GpioRead(0x60091034) != u32(0) ||
            c5GpioRead(0x60091ad4+txPin*4) != u32(1280) || record.loadU32(40) != evidence) return 6
        val finalWrites=writes
        if (c5PwmSessionCloseOwned(record,3,true) != 5 || writes != finalWrites) return 7
        scenario=scenario+1
    }
    return 0
}
