import "../src/storage/fat_sdmmc_esp32s3.ab"
import "../src/storage/fat_mount.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_sdmmc_target")
trusted fun target(operation: int,reader: int,card: int,session: int,descriptor: int,bounce: int,output: int,scratch: int,sector: int): int {
    val handle=nativeBufferAt(reader,28)
    if (operation == 0) return if (fatSdMmcReaderInitialize(handle,nativeBufferAt(card,80),nativeBufferAt(session,52),nativeBufferAt(descriptor,16),nativeBufferAt(bounce,512),1000,100000,true)) 1 else 0
    if (operation == 1) return if (fatStorageReadOwned(handle,sector,nativeBufferAt(output,512))) 1 else 0
    if (operation == 2) return fatSdMmcDrainOwned(handle)
    return fatMountReadOwned(handle,sdMmcCardBlockCount(nativeBufferAt(card,80)),sector,nativeBufferAt(output,512),nativeBufferAt(scratch,512))|0
}
