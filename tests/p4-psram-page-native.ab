import "../src/esp32/psram/page_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(48)
var entry=0
var active=false
var failure=0
var events=0
var bad=false
var geometry=true
fun p4CacheL2GeometryMatches(line: int): bool = geometry
fun p4PsramCommandStorageSafe(address: int,length: int): bool = address == memory && length == 48
fun p4PsramMmuIndex(address: int): int = if (address == 0x48000000) 0 else -1
fun p4PsramMappedProfileValid(r: int,w: int,polls: int): bool = r >= 1 && r <= 64 && w >= 1 && w <= 64 && polls >= 1 && polls <= 1000000
fun p4PsramMmuEncryptionEnabled(): bool = false
fun p4PsramMmuReadOwned(address: int,polls: int): int {
    if (active) bad=true
    return if (failure == 7) 5 else 1|(entry<<8)
}
fun p4PsramMmuMapOwned(address: int,physical: int,capacity: int,expected: int,polls: int): int {
    events=events*10+1
    if (active || entry != 0 || expected != 0) bad=true
    entry=(physical>>>16)|0xc00
    return (entry<<8)|(if (failure == 2) 7 else 1)
}
fun p4PsramMappedStartOwned(r: int,w: int,hex16: bool,polls: int): int {
    events=events*10+2; active=true
    return if (failure == 3) 1797 else 1
}
fun p4PsramVerifyFence(): void { return }
fun p4PsramMappedVerifyOwned(buffer: NativeBuffer,bytes: int,line: int,report: NativeBuffer,polls: int): int {
    events=events*10+3
    if (!active || bytes != 65536 || buffer.addressValue() != 0x48000000 || report.addressValue() != memory+32) bad=true
    return if (failure == 4) 5 else 1
}
fun p4PsramVerifyFlush(buffer: NativeBuffer,bytes: int,line: int,polls: int): int {
    events=events*10+4
    if (!active || bytes != 65536) bad=true
    return if (failure == 5) 5 else 1
}
fun p4PsramMappedStopOwned(polls: int): int {
    events=events*10+5
    // Simulate write taking effect despite failed readback; retry must NOT flush.
    active=false
    return if (failure == 6) 1797 else 1
}
fun p4PsramMmuUnmapOwned(address: int,expected: int,polls: int): int {
    events=events*10+6
    if (active || entry != expected) bad=true
    entry=0
    return if (failure == 8) 7 else 1
}
fun resetPage(): void { entry=0; active=false; failure=0; events=0; bad=false; geometry=true; return }
fun openPage(record: NativeBuffer): int = p4PsramPageOpenOwned(record,0x48000000,65536,131072,128,18,8,true,2)
@export("abla_p4_psram_page_test")
trusted fun pageTest(): i32 {
    val record=nativeBufferAt(memory,48)
    resetPage()
    if (!p4PsramPageInitializeOwned(record) || openPage(record) != 1 || record.loadU32(4) != 3 || p4PsramPageVerifyOwned(record,2) != 1 || record.loadU32(4) != 4 ||
        p4PsramPageCloseOwned(record,2) != 1 || events != 123456 || entry != 0 || active || bad) return i32(1)
    if (p4PsramPageCloseOwned(record,2) != 1 || events != 123456 || openPage(record) != 3) return i32(2)
    var fail=2
    while (fail <= 8) {
        resetPage(); p4PsramPageInitializeOwned(record)
        if (fail <= 3) failure=fail
        val opened=openPage(record)
        if (opened != (if (fail <= 3) 4 else 1)) return i32(3)
        if (fail == 4) { failure=4; if (p4PsramPageVerifyOwned(record,2) != 4 || record.loadU32(4) != 3) return i32(4) }
        if (fail >= 5) {
            failure=fail
            if (p4PsramPageCloseOwned(record,2) != 4 || record.loadU32(24) != fail) return i32(5)
            if (fail == 5 && (!active || entry == 0)) return i32(6)
        }
        failure=0
        if (p4PsramPageCloseOwned(record,2) != 1 || active || entry != 0 || bad || record.loadU32(4) != 7) return i32(7)
        fail=fail+1
    }
    resetPage(); p4PsramPageInitializeOwned(record); entry=0xc03
    if (openPage(record) != 4 || events != 0 || record.loadU32(4) != 0 || entry != 0xc03) return i32(8)
    resetPage(); p4PsramPageInitializeOwned(record); failure=2
    if (openPage(record) != 4) return i32(9)
    failure=0; entry=0xc03
    if (p4PsramPageCloseOwned(record,2) != 4 || entry != 0xc03 || record.loadU32(24) != 7) return i32(10)
    resetPage(); p4PsramPageInitializeOwned(record)
    if (p4PsramPageOpenOwned(record,0x48000000,1,131072,128,18,8,true,2) != 2 || events != 0 ||
        p4PsramPageOpenOwned(record,0x48000000,0,131072,32,18,8,true,2) != 2 || events != 0) return i32(11)
    geometry=false
    if (openPage(record) != 4 || events != 0 || entry != 0 || record.loadU32(24) != 9) return i32(12)
    geometry=true
    if (openPage(record) != 1) return i32(13)
    geometry=false
    if (p4PsramPageCloseOwned(record,2) != 4 || events != 12 || !active || entry == 0 || record.loadU32(4) != 3) return i32(14)
    geometry=true
    if (p4PsramPageCloseOwned(record,2) != 1 || active || entry != 0 || bad) return i32(15)
    return i32(0)
}
