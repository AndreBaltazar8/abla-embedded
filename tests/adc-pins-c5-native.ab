import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/adc_pins_c5_sequence.ab"
var pin=1
var mux=u32(0)
var route=u32(0)
var pad=u32(0)
var latch=u32(0)
var oe=u32(0)
var held=u32(0)
var lp=u32(0)
var busy=false
var writes=0
var drop=0
var bad=false
trusted fun c5AdcClockRead(offset: int): u32 = if (offset == 0) u32(4) else u32(0x400000)
trusted fun c5AdcClockWrite(offset: int,value: u32): void { bad=true;return }
trusted fun c5AdcRead(offset: int): u32 = if (offset == 0x20 && busy) u32(0x20000000) else u32(0)
trusted fun c5GpioRead(address: int): u32 {
    if (address == 0x600960f0 || address == 0x60091df8) return u32(1)
    if (address == 0x600960f4) return u32(0x400000)
    if (address == 0x600b102c) return held
    if (address == 0x600b1028) return lp
    if (address == 0x60091034) return oe
    if (address == 0x60091004) return latch
    if (address == 0x60090000+pin*4) return mux
    if (address == 0x60091ad4+pin*4) return route
    if (address == 0x600910d4+pin*4) return pad
    bad=true;return u32(0)
}
trusted fun c5GpioWrite(address: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x6009103c) oe=oe&~value
    else if (address == 0x60091008) latch=latch|value
    else if (address == 0x6009100c) latch=latch&~value
    else if (address == 0x60090000+pin*4) mux=value
    else if (address == 0x60091ad4+pin*4) route=value
    else if (address == 0x600910d4+pin*4) pad=value
    else bad=true
    return
}
@export("abla_adc_pins_c5_test")
trusted fun test(): i32 {
    pin=1
    while (pin <= 6) {
        var variant=0
        while (variant < 4) {
            val originalMux=u32(0xa5000000)|(if ((variant&1) != 0) u32(29570) else u32(0))
            val originalRoute=u32(0x80000455)
            val originalPad=u32(0x12300000)|(if ((variant&2) != 0) u32(4) else u32(0))
            val originalLatch=u32(0x80000000)|(if ((variant&1) != 0) u32(1)<<u32(pin) else u32(0))
            var fault=0
            while (fault <= 12) {
                mux=originalMux;route=originalRoute;pad=originalPad;latch=originalLatch;oe=u32(0);writes=0;drop=fault;bad=false
                var owner=c5AdcPadOpenOwned(pin-1,true)
                if (owner.status() == 1 && ((mux&u32(29570)) != u32(4096) || (route&u32(4095)) != u32(1280) || (pad&u32(4)) != u32(0) || oe != u32(0))) return i32(1)
                owner=owner.closeOwned(true)
                drop=0
                owner=owner.closeOwned(true)
                if (owner.status() != 5 || mux != originalMux || route != originalRoute || pad != originalPad || latch != originalLatch || oe != u32(0) || bad) return i32(2)
                fault=fault+1
            }
            variant=variant+1
        }
        pin=pin+1
    }
    pin=1;drop=0;writes=0
    held=u32(2)
    if (c5AdcPadOpenOwned(0,true).status() != 3 || writes != 0) return i32(3)
    held=u32(0);lp=u32(2)
    if (c5AdcPadOpenOwned(0,true).status() != 3 || writes != 0) return i32(4)
    lp=u32(0);busy=true
    if (c5AdcPadOpenOwned(0,true).status() != 3 || writes != 0) return i32(5)
    busy=false
    if (c5AdcPadOpenOwned(-1,true).status() != 2 || c5AdcPadOpenOwned(6,true).status() != 2 || c5AdcPadOpenOwned(0,false).status() != 2 || writes != 0) return i32(6)
    var owner=c5AdcPadOpenOwned(0,true)
    val before=writes
    busy=true;owner=owner.closeOwned(true)
    if (owner.status() != 6 || writes != before) return i32(7)
    busy=false;owner=owner.closeOwned(true)
    if (owner.status() != 5 || bad) return i32(8)
    return i32(0)
}
