import "../src/display/color.ab"
import "../src/display/lcd_logic.ab"
import "../src/m5stack/display_map.ab"

fun main: int {
    val colors = rgb565(255, 0, 0) == rgb565Red &&
        rgb565(0, 255, 0) == rgb565Green &&
        rgb565(0, 0, 255) == rgb565Blue &&
        rgb565White.red5() == 31 && rgb565White.green6() == 63 &&
        rgb565White.blue5() == 31

    val geometry = lcdGeometry(135, 240, 52, 40, 240, 320)
    val portrait = geometry.view(0)
    val landscape = geometry.view(1)
    val views = geometry.valid() && portrait.width() == 135 &&
        portrait.height() == 240 && portrait.columnStart() == 52 &&
        portrait.rowStart() == 40 && portrait.madctl() == 8 &&
        landscape.width() == 240 && landscape.height() == 135 &&
        landscape.columnStart() == 40 && landscape.rowStart() == 53 &&
        landscape.madctl() == 108

    val clipped = clipDisplayRect(-5, 7, 20, 30, 135, 240)
    val edge = clipDisplayRect(130, 230, 20, 20, 135, 240)
    val outside = clipDisplayRect(-20, 0, 10, 10, 135, 240)
    val clipping = clipped.x() == 0 && clipped.y() == 7 &&
        clipped.width() == 15 && clipped.height() == 30 &&
        edge.width() == 5 && edge.height() == 10 && outside.empty()

    val programs = lcdCommandProgramValid(st7789InitCommands) &&
        lcdCommandProgramValid("\x29\x00\xff\xff") &&
        !lcdCommandProgramValid("\x29\x01\xff\xff") &&
        !lcdCommandProgramValid("\x11\x80")

    val plus = m5BoardStickCPlus.displaySpiPins()
    val plus2 = m5BoardStickCPlus2.displaySpiPins()
    val station = m5BoardStation.displaySpiPins()
    val profiles = m5BoardStickCPlus.displayController() ==
            m5DisplayControllerSt7789 &&
        plus.mosi() == 15 && plus.miso() == 14 && plus.dataCommand() == 23 &&
        plus2.miso() == -1 && plus2.reset() == 12 && plus2.backlight() == 27 &&
        station.mosi() == 23 && station.clock() == 18 &&
        m5BoardStation.displayRotation() == 1 &&
        !m5BoardAtomVoice.displaySpiPins().available()

    if (colors && views && clipping && programs && profiles) 92 else 1
}
