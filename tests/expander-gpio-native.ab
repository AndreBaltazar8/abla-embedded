import "../src/m5stack/expander_gpio.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var bad=false
var calls=0
var fail=0
var registerExpected=0
var payload=0
var maskExpected=0
var valueExpected=0
var nextRegister=-1
var nextValue=0
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,buffer: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    calls=calls+1
    if (this != 8 || register != registerExpected) bad=true
    if (calls == fail) I2cByteResult(0) else I2cByteResult(256|payload)
}
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    calls=calls+1
    if (this != 8 || register != registerExpected || mask != maskExpected || value != valueExpected) bad=true
    if (calls == 1 && nextRegister >= 0) { registerExpected=nextRegister; valueExpected=nextValue }
    calls != fail
}
@export("abla_expander_gpio_test")
trusted fun gpioTest(): i32 {
    val owner=m5ExpandersAt(nativeBufferAt(nativeStaticAllocate(32),32))
    var kind=1
    while (kind <= 2) {
        owner.initialize()
        owner.buffer().storeU32(8,if (kind == 1) m5BoardStampPLC | 0 else m5BoardCoreMatrix | 0)
        owner.storeSlot(0,M5ExpanderOpen(8|(kind<<32)|(1<<40)))
        owner.buffer().storeU32(4,1)
        var profile=0
        while (profile < 14336) {
            payload=profile & 255
            val pin=(profile/256)%14
            fail=profile/3584%2
            val latch=profile >= 7168
            val supported=pin < (if (kind == 1) 8 else 14)
            registerExpected=if (latch) 5+(if (kind == 2) pin/8 else 0) else if (kind == 1) 15 else 7+pin/8
            calls=0; bad=false
            val result=if (latch) owner.outputLatchChecked(0,pin) else owner.digitalReadChecked(0,pin)
            val expected=if (!supported || fail != 0) 0 else 256|((payload>>>(pin%8))&1)
            if ((result | 0) != expected || calls != (if (supported) 1 else 0) || bad) return i32(1)
            profile=profile+1
        }
        profile=0
        while (profile < 112) {
            val pin=profile%14
            val direction=(profile/14)%2 != 0
            val enabled=(profile/28)%2 != 0
            fail=profile/56
            val supported=pin < (if (kind == 1) 8 else 14)
            registerExpected=(if (direction) 3 else 5)+(if (kind == 2) pin/8 else 0)
            maskExpected=1<<(pin%8); valueExpected=if (enabled) maskExpected else 0
            calls=0; bad=false
            val result=if (direction) owner.setDirection(0,pin,enabled) else owner.digitalWrite(0,pin,enabled)
            if (result != (supported && fail == 0) || calls != (if (supported) 1 else 0) || bad) return i32(2)
            profile=profile+1
        }
        profile=0
        while (profile < 126) {
            val pin=profile%14
            val mode=(profile/14)%3
            fail=profile/42
            val supported=pin < (if (kind == 1) 8 else 14)
            maskExpected=1<<(pin%8)
            val bank=pin/8
            if (kind == 1) {
                registerExpected=if (mode == 0) 11 else 13
                valueExpected=if (mode == 1) maskExpected else 0
                nextRegister=if (mode == 0) -1 else 11
                nextValue=maskExpected
            } else {
                registerExpected=(if (mode == 1) 11 else 9)+bank
                valueExpected=0
                nextRegister=(if (mode == 1) 9 else 11)+bank
                nextValue=if (mode == 0) 0 else maskExpected
            }
            val count=if (kind == 1 && mode == 0) 1 else 2
            calls=0; bad=false
            val result=owner.setPullMode(0,pin,mode)
            if (result != (supported && (fail == 0 || fail > count)) ||
                calls != (if (!supported) 0 else if (fail == 1) 1 else count) || bad) return i32(5)
            profile=profile+1
        }
        nextRegister=-1
        calls=0
        if (owner.digitalWrite(-1,0,true) || owner.digitalReadChecked(1,0).valid() || owner.setDirection(0,-1,true) ||
            owner.setPullMode(0,0,3) || owner.outputLatchChecked(0,14).valid() || calls != 0) return i32(3)
        owner.buffer().storeU32(4,6)
        if (owner.digitalWrite(0,0,true) || owner.setDirection(0,0,true) || owner.setPullMode(0,0,pullNone) ||
            owner.digitalReadChecked(0,0).valid() || owner.outputLatchChecked(0,0).valid() || calls != 0) return i32(4)
        kind=kind+1
    }
    i32(0)
}
