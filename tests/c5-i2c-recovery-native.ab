import "../src/esp32/i2c/recovery_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var seed=0
var failure=0
var captures=0
var restores=0
var loads=0
var phase=0
var bad=false
fun expectedMask(index: int): int = if (index == 0) 0x5FFFFF else if (index == 2) 65535 else if (index <= 8) 511 else if (index == 9) 63 else if (index == 10) 1023 else if (index == 11) 0x4FFF else 0x3DF
fun expectedAddress(index: int): int = if (index == 0) 0x60096024 else if (index == 1) 0x60004000 else if (index == 2) 0x60004038 else if (index == 3) 0x60004030 else if (index == 4) 0x60004034 else if (index <= 8) 0x60004040+(index-5)*4 else if (index == 9) 0x6000400C else if (index == 10) 0x60004050 else if (index == 11) 0x60004018 else 0x60004004
fun c5I2cRecoveryPinsMatch(sda: int,scl: int): bool {
    if (phase != 0 || sda != 2 || scl != 3) bad=true
    phase=1
    failure != 1
}
fun c5I2cRecoveryLoad(address: int): int {
    loads=loads+1
    if (phase == 1) {
        if (captures >= 13 || address != expectedAddress(captures)) bad=true
        captures=captures+1
        return seed
    }
    if (phase != 3 || address != expectedAddress(if (restores < 13) restores else 12)) bad=true
    if (restores == 13) return (seed&0x3DF)|0x80000000
    0x80000000
}
fun c5I2cRecoveryReset(source: int): bool {
    if (phase != 1 || captures != 13 || source != ((seed>>>20)&1)) bad=true
    phase=2
    failure != 2
}
fun c5I2cRecoveryInitialize(): bool {
    if (phase != 2) bad=true
    phase=3
    failure != 3
}
fun c5I2cRecoveryStore(address: int,value: int): void {
    val index=if (restores < 13) restores else 12
    val expected=(seed&expectedMask(index))|0x80000000|(if (restores == 13) 2048 else 0)
    if (phase != 3 || restores >= 14 || address != expectedAddress(index) || value != expected) bad=true
    restores=restores+1
    return
}
fun c5I2cRecoveryReleased(sda: int,scl: int): bool {
    if (phase != 3 || restores != 14 || sda != 2 || scl != 3) bad=true
    phase=4
    failure != 4
}
@export("abla_c5_i2c_recovery_test")
trusted fun recoveryTest(): i32 {
    val storage=nativeBufferAt(nativeStaticAllocate(56),56)
    var profile=0
    while (profile < 1280) {
        seed=(profile&255)*0x01010101; failure=profile/256
        captures=0; restores=0; loads=0; phase=0; bad=false
        storage.storeU32(52,0xA5A5A5A5)
        val result=esp32C5I2cRecoverOwned(0,2,3,storage)
        if (result != (if (failure == 0) 1 else if (failure == 1) 7 else if (failure <= 3) 9 else 10) ||
            captures != (if (failure == 1) 0 else 13) ||
            restores != (if (failure == 0 || failure == 4) 14 else 0) ||
            phase != (if (failure == 0 || failure == 4) 4 else failure) ||
            storage.loadU32(52) != 0xA5A5A5A5 || bad) return i32(1)
        if (captures == 13) {
            var i=0
            while (i < 13) {
                if (storage.loadU32(i*4) != (seed&expectedMask(i))) return i32(2)
                i=i+1
            }
        }
        profile=profile+1
    }
    phase=0
    if (esp32C5I2cRecoverOwned(1,2,3,storage) != 7 ||
        esp32C5I2cRecoverOwned(0,2,3,nativeBufferAt(storage.addressValue(),51)) != 7 ||
        esp32C5I2cRecoverOwned(0,2,3,nativeBufferAt(storage.addressValue()+1,52)) != 7 || phase != 0) return i32(3)
    i32(0)
}
