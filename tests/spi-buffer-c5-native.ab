import "../src/esp32/spi/buffer_transaction_c5_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
var sda=0
var scl=1
var writes=0
var drop=0
var fault=0
var bad=false
fun offset(address: int): int = if (address >= 0x60090000 && address < 0x60090078) address-0x60090000 else
    if (address >= 0x60091000 && address < 0x60091b4c) 256+address-0x60091000 else -1
fun c5GpioRead(address: int): u32 {
    if (address == 0x600960f0) return if (fault == 1) u32(3) else u32(1)
    if (address == 0x600960f4) return if (fault == 2) u32(0) else u32(0x400000)
    if (address == 0x60091df8) return u32(1)
    if (address == 0x600b102c) return if (fault == 4) u32(1)<<u32(scl) else u32(0)
    if (address == 0x600b1028) return if (fault == 5) u32(127) else u32(0)
    if (address == 0x6000f018) return if (fault == 6) u32(16384) else u32(0)
    if (address == 0x60091064) return if (fault == 7) u32(0) else u32(0xffffffff)
    val at=offset(address)
    if (at < 0 || (at&3) != 0) { bad=true;return u32(0) }
    return u32(nativeBufferAt(memory,4096).loadU32(at))
}
fun c5GpioWrite(address: int,value: u32): void {
    writes=writes+1
    var at=offset(address);var wanted=value
    if (address == 0x60091008 || address == 0x60091038) { at=at-4;wanted=u32(nativeAddressLoadU32(memory,at))|value }
    else if (address == 0x6009100c || address == 0x6009103c) { at=at-8;wanted=u32(nativeAddressLoadU32(memory,at))&(u32(0xffffffff)^value) }
    if (at < 0 || at >= 4096 || (at&3) != 0) { bad=true;return }
    if (writes != drop) nativeAddressStoreU32(memory,at,int(wanted))
    return
}
fun softwareI2cDrive(pin: int,released: bool): void { esp32C5GpioWriteOwned(pin,released);return }
fun softwareI2cSample(pin: int): bool = esp32C5GpioReadOwned(pin) == 1
fun softwareI2cDelay(us: int): void { if (us != 1 && us != 5) bad=true;return }
fun seed(): void {
    var at=0
    while (at < 4096) { nativeAddressStoreU32(memory,at,0);at=at+4 }
    writes=0;drop=0;fault=0;bad=false;return
}



val spi=nativeStaticAllocate(256)
var bus=u32(4)
var functional=u32(0x100000)
var spiWrites=0
var spiDrop=0
var pending=0
var stall=false
var active=false
fun c5SpiRead(address: int): u32 {
    if (address == 0x600960c4) return bus
    if (address == 0x600960c8) return functional
    if (address == 0x60081000) {
        if (active) return u32(1<<24)
        if (pending > 0) { if (!stall) pending=pending-1;return u32(1<<23) }
        return u32(0)
    }
    return u32(nativeAddressLoadU32(spi,address-0x60081000))
}
fun c5SpiWrite(address: int,value: u32): void {
    spiWrites=spiWrites+1
    if (spiWrites == spiDrop) return
    if (address == 0x600960c4) { bus=value;return }
    if (address == 0x600960c8) { functional=value;return }
    if (address == 0x60081000) {
        if (value == u32(1<<23)) { pending=1;return }
        if (value != u32(1<<24)) { bad=true;return }
        starts=starts+1
        if ((c5GpioRead(0x60091004)&u32(1<<25)) != u32(0)) bad=true
        if (timeout || starts == timeoutAt) { active=true;return }
        var at=0
        while (at < 64) { nativeAddressStoreU32(spi,152+at,nativeAddressLoadU32(spi,152+at)^0xffffffff);at=at+4 }
        nativeAddressStoreU32(spi,60,4096);return
    }
    if (address == 0x60081038) { nativeAddressStoreU32(spi,60,nativeAddressLoadU32(spi,60)&~int(value));return }
    nativeAddressStoreU32(spi,address-0x60081000,int(value));return
}
fun initialize(): void {
    seed()
    var at=0
    while (at < 256) { nativeAddressStoreU32(spi,at,0);at=at+4 }
    bus=u32(4);functional=u32(0x100000);spiWrites=0;spiDrop=0;pending=0;stall=false;active=false;return
}
fun openMaster(mode: int): Esp32C5SpiMaster =
    esp32C5SpiMasterOpenOwned(spiPins(7,8,9),25,160000000,2,1,8,mode,4,true)

val buffers=nativeStaticAllocate(131080)
val gateStorage=nativeStaticAllocate(4)
var timeout=false
var starts=0

var timeoutAt=0
@export("abla_spi_buffer_c5_test")
trusted fun testBuffer(): i32 {
    val gate=peripheralGateAt(gateStorage)
    var mode=0
    while (mode < 4) {
        initialize();timeout=false;timeoutAt=0;starts=0;nativeAddressStoreU32(gateStorage,0,0)
        val master=openMaster(mode)
        if (!master.ready()) return i32(1)
        var variant=0
        while (variant < 10) {
            val size=if (variant == 0) 1 else if (variant == 1) 63 else if (variant == 2) 64 else if (variant == 3) 65 else if (variant == 4) 127 else if (variant == 5) 128 else if (variant == 6) 512 else if (variant == 7) 513 else if (variant == 8) 65534 else 65535
            var inplace=0
            while (inplace < 3) {
                val tx=nativeBufferAt(buffers+1,size)
                val rx=if (inplace != 1) nativeBufferAt(buffers+65541,size) else tx
                var at=0
                while (at < size) { tx.store(at,(at*17+variant)&255);if (inplace != 1) rx.store(at,90);at=at+1 }
                val gpioWrites=writes;val transactions=starts
                val result=master.transferBuffer(gate,u32(7),tx,rx,size,4,inplace != 2)
                if (!result.valid() || result.completedBytes() != size || result.detail() != 257 ||
                    writes != gpioWrites+2 || starts != transactions+(size+63)/64 || bad) return i32(2)
                at=0
                while (at < size) { if (rx.load(at) != (if (inplace == 2) 90 else ((at*17+variant)&255)^255)) return i32(3);at=at+1 }
                inplace=inplace+1
            }
            variant=variant+1
        }
        val tx=nativeBufferAt(buffers,512);val rx=nativeBufferAt(buffers+1024,512)
        var chunk=1
        while (chunk <= 8) {
            var at=0
            while (at < 512) { tx.store(at,at&255);rx.store(at,90);at=at+1 }
            timeoutAt=starts+chunk
            val result=master.transferBuffer(gate,u32(7),tx,rx,512,4)
            if (result.status() != 6 || result.completedBytes() != (chunk-1)*64 ||
                (result.detail()&255) != 7 || bad || (c5GpioRead(0x60091004)&u32(1<<25)) != u32(0)) return i32(4)
            at=0
            while (at < 512) {
                if (rx.load(at) != (if (at < (chunk-1)*64) (at&255)^255 else 90)) return i32(5)
                at=at+1
            }
            active=false;timeoutAt=0
            if (!master.recover(gate,u32(8),true)) return i32(6)
            chunk=chunk+1
        }
        val before=writes
        if (master.transferBuffer(gate,u32(7),tx,nativeBufferAt(buffers+1,512),512,4).status() != 3 ||
            master.transferBuffer(gate,u32(7),nativeBufferAt(gateStorage,512),rx,512,4).status() != 3 ||
            master.transferBuffer(gate,u32(7),nativeBufferAt(buffers,65536),rx,65536,4,false).status() != 3 ||
            master.transferBuffer(gate,u32(7),tx,rx,0,4,false).status() != 3 ||
            writes != before || master.closeOwned(true) != 0 || bad) return i32(7)
        mode=mode+1
    }
    return i32(0)
}

