import "../src/rtc/calendar.ab"
fun main(): int {
    if (rtcDateTime(1970,1,1,4,0,0,0).unixSeconds() != 0 ||
        rtcDateTime(2000,1,1,6,0,0,0).unixSeconds() != 946684800 ||
        rtcDateTime(2000,2,29,2,0,0,0).unixSeconds() != 951782400 ||
        rtcDateTime(0,1,1,6,0,0,0).unixSeconds() != -62167219200) return 1
    val before=rtcDateTimeFromUnixSeconds(-1)
    if (before.year() != 1969 || before.month() != 12 || before.day() != 31 ||
        before.weekday() != 3 || before.hour() != 23 || before.minute() != 59 || before.second() != 59) return 2
    if (rtcDateTime(1900,2,29,0,0,0,0).calendarValid() ||
        rtcDateTime(2100,2,29,0,0,0,0).calendarValid() ||
        rtcDateTime(2000,4,31,0,0,0,0).unixSeconds() != rtcInvalidUnixSeconds ||
        RtcDateTime(0).unixSeconds() != rtcInvalidUnixSeconds) return 3
    var seconds = -2208988800
    var weekday=1
    // Independent consecutive-day oracle across the1900/2000 century rules.
    var year=1900
    while (year <= 2100) {
        var month=1
        while (month <= 12) {
            var day=1
            while (day <= rtcMonthDays(year,month)) {
                val date=rtcDateTimeFromUnixSeconds(seconds+86399)
                val automatic=rtcCalendarDate(year,month,day)
                val automaticTime=rtcCalendarDateTime(year,month,day,23,59,59)
                if (!automatic.calendarValid() || automatic.weekday() != weekday ||
                    automaticTime != date) return 7
                if (date.year() != year || date.month() != month || date.day() != day ||
                    date.weekday() != weekday || date.hour() != 23 || date.minute() != 59 ||
                    date.second() != 59 || date.unixSeconds() != seconds+86399) return 4
                seconds=seconds+86400; weekday=(weekday+1)%7; day=day+1
            }
            month=month+1
        }
        year=year+1
    }
    year=0
    while (year <= 65535) {
        val date=rtcDateTime(year,12,31,0,23,59,59)
        val result=rtcDateTimeFromUnixSeconds(date.unixSeconds())
        if (rtcCalendarDate(year,12,31).weekday() != result.weekday()) return 8
        if (result.year() != year || result.month() != 12 || result.day() != 31 ||
            result.hour() != 23 || result.minute() != 59 || result.second() != 59) return 5
        year=year+1
    }
    val maximum=rtcDateTime(65535,12,31,0,23,59,59).unixSeconds()
    if (rtcDateTimeFromUnixSeconds(maximum+1).valid() ||
        rtcDateTimeFromUnixSeconds(-62167219201).valid() ||
        rtcDateTimeFromUnixSeconds(rtcInvalidUnixSeconds).valid()) return 6
    if (rtcCalendarDate(1900,2,29).valid() || rtcCalendarDate(2100,2,29).valid() ||
        rtcCalendarDate(2000,4,31).valid() || rtcCalendarDate(-1,1,1).valid() ||
        rtcCalendarDate(65536,1,1).valid() || rtcCalendarDate(2026,0,1).valid() ||
        rtcCalendarDate(2026,13,1).valid() || rtcCalendarDate(2026,1,0).valid() ||
        rtcCalendarDateTime(2000,2,29,24,0,0).valid() ||
        rtcCalendarDateTime(2000,2,30,0,0,0).valid() ||
        rtcDate(1900,2,29,0).calendarValid() || RtcDate(0).calendarValid() ||
        rtcCalendarDate(0,1,1).weekday() != 6 || rtcCalendarDate(2000,2,29).weekday() != 2) return 9
    0
}
