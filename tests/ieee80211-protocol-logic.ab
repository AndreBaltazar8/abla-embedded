import "../src/wifi/ieee80211_protocol_logic.ab"

fun main: int {
    if (ieee80211TrafficIdentifier(0, 0, 9, 13) != 17) return 1
    if (ieee80211TrafficIdentifier(8, 0, 9, 13) != 16) return 2
    if (ieee80211TrafficIdentifier(136, 0, 25, 30) != 9) return 3
    if (ieee80211TrafficIdentifier(136, 3, 25, 30) != 14) return 4
    if (ieee80211ShortSlotCapabilities(7, true) != 1031) return 5
    if (ieee80211ShortSlotCapabilities(1031, false) != 7) return 6
    if (!ieee80211ContentionParameterValid(2, 3, 4)) return 7
    if (ieee80211ContentionParameterValid(0, 3, 4)) return 8
    if (ieee80211ContentionParameterValid(2, 4, 3)) return 9
    if (ieee80211ConnectState(0) != 3 ||
        ieee80211ConnectArgument(4, 0) != 128) return 10
    if (ieee80211ConnectState(1) != 2 ||
        ieee80211ConnectArgument(4, 1) != 176) return 11
    if (ieee80211ErpRate(0) != 2 || ieee80211ErpRate(6) != 48) return 12
    if (!ieee80211ErpRateSetValid([2, 4, 11, 12, 22, 24, 48])) return 13
    if (!ieee80211ErpRateSetValid([130, 132, 139, 140, 150, 152, 176])) {
        return 14
    }
    if (ieee80211ErpRateSetValid([2, 4, 11, 12, 22, 24])) return 15
    if (ieee80211ErpRateSetValid([2, 4, 11, 12, 22, 36, 48])) return 16
    89
}
