import "../src/esp32/adc1_session_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Esp32SarPower = int
fun Esp32SarPower.bits(): int = this
fun Esp32SarPower.status(): int = this&255
fun Esp32SarPower.powered(): bool = this.status() == 1
var fail=0
var live=false
var matching=true
var inFlight=false
var detached=false
var releases=0
var closes=0
var starts=0
var bad=false
fun esp32SarPowerOpenOwned(exclusive: bool): Esp32SarPower { live=fail != 1; return Esp32SarPower(if (fail == 1) 260 else 257) }
fun Esp32SarPower.closeOwned(): Esp32SarPower {
    closes=closes+1
    if (inFlight) bad=true
    live=false
    return Esp32SarPower(if (fail == 7) 260 else 0)
}
fun esp32Adc1PadConfigureOwned(channel: int): int { if (!live) bad=true; return if (fail == 2) 5 else 1 }
fun esp32Adc1ConfigureOwned(channel: int,width: int,atten: int,polls: int): int { if (!live) bad=true; return if (fail == 9) 2309 else if (fail == 3) 5 else 1 }
fun esp32Adc1SessionHardwareMatches(channel: int,width: int,atten: int): bool = live && matching
fun esp32Adc1StartOwned(channel: int,polls: int): int {
    if (!live || inFlight) bad=true
    starts=starts+1; inFlight=true
    return if (fail == 4) 261 else 257
}
fun esp32Adc1FinishOwned(channel: int,polls: int): int {
    if (!live || !inFlight) bad=true
    if (fail == 5) return 6
    inFlight=false
    return if (fail == 8) 7 else (321<<8)|1
}
fun esp32Adc1ReleaseOwned(channel: int,polls: int): int {
    releases=releases+1
    if (!live) bad=true
    if (fail == 6) return 6
    inFlight=false; detached=true; return 1
}
fun fresh(): void { fail=0; live=false; matching=true; inFlight=false; detached=false; releases=0; closes=0; starts=0; bad=false; return }
@export("abla_adc1_session_test")
fun sessionTest(): i32 {
    var channel=0
    while (channel < 8) {
        var width=9
        while (width <= 12) {
            var atten=0
            while (atten < 4) {
                fresh(); var owner=esp32Adc1SessionOpenOwned(channel,width,atten,true,3)
                if (!owner.ready() || owner.channel() != channel || owner.width() != width || owner.attenuation() != atten || owner.raw() != -1) return i32(1)
                owner=owner.startAfterSettlingOwned(3)
                if (!owner.pending() || owner.ready()) return i32(2)
                owner=owner.pollOwned(3)
                if (owner.raw() != 321 || !owner.ready() || owner.pending()) return i32(3)
                owner=owner.closeOwned(3)
                if (owner.bits() != 0 || !detached || closes != 1 || releases != 1 || bad) return i32(4)
                atten=atten+1
            }
            width=width+1
        }
        channel=channel+1
    }
    var stage=1
    while (stage <= 3) {
        fresh(); fail=stage; var owner=esp32Adc1SessionOpenOwned(0,12,3,true,3)
        if (owner.ready() || owner.status() != stage+2) return i32(5)
        fail=0; owner=owner.closeOwned(3)
        if (owner.bits() != 0 || releases != 0 || closes != 1 || bad) return i32(6)
        stage=stage+1
    }
    fresh(); var owner=esp32Adc1SessionOpenOwned(0,12,3,true,3); fail=4
    owner=owner.startAfterSettlingOwned(3)
    if (owner.status() != 7 || !owner.pending() || starts != 1) return i32(7)
    if (owner.startAfterSettlingOwned(3).status() != 2 || starts != 1) return i32(8)
    fail=5; owner=owner.pollOwned(3)
    if (owner.status() != 8 || !owner.pending()) return i32(9)
    fail=6; owner=owner.closeOwned(3)
    if (owner.status() != 10 || closes != 0 || !live) return i32(10)
    fail=7; owner=owner.closeOwned(3)
    if (owner.status() != 11 || releases != 2 || closes != 1) return i32(11)
    fail=0; owner=owner.closeOwned(3)
    if (owner.bits() != 0 || releases != 2 || closes != 2 || bad) return i32(12)
    fresh(); owner=esp32Adc1SessionOpenOwned(0,12,3,true,3); matching=false
    if (owner.startAfterSettlingOwned(3).status() != 6 || starts != 0) return i32(13)
    matching=true; owner=owner.startAfterSettlingOwned(3); fail=8; owner=owner.pollOwned(3)
    if (owner.status() != 9 || owner.pending() || owner.raw() != -1) return i32(14)
    fail=0; owner=owner.closeOwned(3)
    if (owner.bits() != 0 || bad || esp32Adc1SessionOpenOwned(8,12,3,true,3).status() != 2) return i32(15)
    fresh(); fail=9; owner=esp32Adc1SessionOpenOwned(0,12,3,true,3)
    if (owner.ready() || owner.status() != 5 || (owner.bits()&(1<<45)) == 0) return i32(16)
    owner=owner.startAfterSettlingOwned(3)
    if (owner.status() != 2 || (owner.bits()&(1<<45)) == 0) return i32(17)
    owner=owner.closeOwned(3)
    if (owner.status() != 10 || closes != 0 || releases != 0 || (owner.bits()&(1<<45)) == 0) return i32(18)
    fail=0; owner=owner.closeOwned(3)
    if (owner.status() != 0 || releases != 1 || closes != 1 || bad) return i32(19)
    return i32(0)
}
