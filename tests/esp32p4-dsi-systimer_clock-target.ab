import "../src/esp32/timer/clock_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_systimer_clock_target")
trusted fun systimerClockTarget(op: int,a: int,b: int): int {
    if (op == 0) return p4SystemTimerClockOpenOwned(a)
    if (op == 1) return P4SystemTimerClockOwner(a).closeOwned()
    if (op == 2) return p4SystemTimerClockSelectOwned(a,b)
    return p4SystemCounter(a).tryTicks(b)
}
