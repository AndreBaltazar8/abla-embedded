import "../src/esp32/i2c/bus_clear_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_i2c_active_recovery_test")
trusted fun activeRecoveryTargetTest(gate: PeripheralGate, rcc: AtomicU32,
    owner: u32, port: i32, sda: i32, scl: i32, budget: u32): int =
    esp32S3I2cRecoverAndClearGuarded(gate, rcc, owner, int(port), int(sda), int(scl), budget)
