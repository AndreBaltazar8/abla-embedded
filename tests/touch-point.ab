import "../src/touch/point.ab"
fun main(): int {
    val point = ft5x06PointBytes(0x8f, 0xfe, 0xaf, 0xfd)
    if (!point.valid() || point.x() != 4094 || point.y() != 4093 || point.id() != 10 || point.event() != 2) return 1
    if (touchPoint(-1, 0, 0, 0).valid() || touchPoint(0, 65536, 0, 0).valid() ||
        touchPoint(0, 0, 256, 0).valid() || touchPoint(0, 0, 0, 4).valid() ||
        touchPoint(0, 0, 0, 0, 65536).valid()) return 2
    if (!touchPoint(4095, 4095, 15, 3).valid() || !touchPoint(0, 0, 0, 0).valid()) return 3
    if (ft5x06PointBytes(256, 0, 0, 0).valid() || ft5x06PointBytes(0, -1, 0, 0).valid()) return 4
    if (ft5x06SnapshotBytes(0) != 1 || ft5x06SnapshotBytes(1) != 5 ||
        ft5x06SnapshotBytes(5) != 29 || ft5x06SnapshotBytes(6) != 0 || ft5x06SnapshotBytes(-1) != 0) return 5
    0
}
