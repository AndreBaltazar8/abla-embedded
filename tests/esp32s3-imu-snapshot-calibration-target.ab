import "../src/imu/snapshot_calibration.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_snapshot_calibration_target")
trusted fun calibrationSnapshotTarget(state: ImuCalibration, snapshot: ImuSnapshot, offsets: ImuOffsets, fresh: int): int =
    state.updateSnapshot(snapshot,offsets,fresh)
