import "../src/display/gc9a01_software.ab"
import "../src/display/gc9a01_read.ab"
import "../src/display/gc9a01_session.ab"
import "../src/display/gc9a01_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 5
fun Pin.outputCapable(): bool = this.valid()
val gateMemory=nativeStaticMutableU32s([0])
val captureMemory=nativeStaticAllocate(1024)
val pixels=nativeStaticBytes("\x12\x34\xab\xcd")
var selected=false
var dc=true
var mosi=false
var bits=0
var word=0
var bytes=0
var bad=false
var delayMs=0
var reading=false
var samples=0
var shared=false
var driven=true
var failInput=false
var failOutput=false
var failRelease=false
var partial=false
var restores=0
var powerSession=Gc9a01Session(0)
val readMemory=nativeStaticAllocate(32)
val sessionMemory=nativeStaticAllocate(64)
trusted fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateMemory,0) != 7) bad=true
    if (this == 2) { if (!driven) bad=true;mosi=high }
    if (this == 4) dc=high
    if (this == 3) selected=!high
    if (this == 1 && selected && high) {
        word=(word<<1)|(if (mosi) 1 else 0);bits=bits+1
        if (bits == 8) {
            if (bytes >= 512) bad=true
            else nativeBufferAt(captureMemory,1024).storeU16(bytes*2,word|(if (dc) 256 else 0))
            bytes=bytes+1;bits=0;word=0
        }
    }
    return
}
fun Pin.read(): bool {
    if (!reading || this != (if (shared) 2 else 5) || (shared && driven) || !selected || !dc || nativeAddressLoadU32(gateMemory,0) != 7) bad=true
    val index=samples;samples=samples+1
    if (index < 16) return true
    val value=(((index-16)/8)*37+11)&255
    return (value&(1<<(7-((index-16)%8)))) != 0
}
fun Pin.writeLevelOwned(high: bool): bool {
    if (!shared || this != 3 || !high || (nativeAddressLoadU32(gateMemory,0)&0x7fffffff) != 7) bad=true
    if (!failRelease || partial) selected=false
    return !failRelease
}
fun Pin.outputLevelOwned(high: bool): bool {
    if (!shared || this != 2 || selected || high || (nativeAddressLoadU32(gateMemory,0)&0x7fffffff) != 7) bad=true
    restores=restores+1
    if (!failOutput || partial) { driven=true;mosi=false }
    return !failOutput
}
fun Pin.inputOwned(): bool {
    if (!shared || this != 2 || !selected || !dc || nativeAddressLoadU32(gateMemory,0) != 7) bad=true
    if (!failInput || partial) driven=false
    return !failInput
}
fun peripheralDelayMicroseconds(us: int): void { bad=true;return }
fun peripheralDelayMilliseconds(ms: int): void {
    if (selected || nativeAddressLoadU32(gateMemory,0) != 7 || ms != 120) bad=true
    if (powerSession != 0 && (powerSession.state() != 5 || powerSession.fillRectOwned(0,0,1,1,Rgb565(0),true).status() != 3)) bad=true
    delayMs=delayMs+ms;return
}
fun reset(): void { selected=false;dc=true;bits=0;bytes=0;word=0;bad=false;delayMs=0;reading=false;samples=0;shared=false;driven=true;failInput=false;failOutput=false;failRelease=false;partial=false;restores=0;return }
trusted fun at(index: int,value: int,data: bool): bool = nativeBufferAt(captureMemory,1024).loadU16(index*2) == (value|(if (data) 256 else 0))
@export("abla_gc9a01_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateMemory)
    var rotation=0
    while (rotation < 8) {
        reset()
        if (!gc9a01BeginChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),rotation,false,true,0).valid() ||
            bad || selected || delayMs != 120 || bits != 0) return i32(1)
        val program=gc9a01InitProgram();var p=0;var index=0
        while (p < program.capacity()-2) {
            val command=program.load(p);val flags=program.load(p+1);p=p+2
            if (!at(index,command,false) || command == 0) return i32(2)
            index=index+1;var n=0
            while (n < (flags&127)) {
                if (!at(index,program.load(p),true)) return i32(3)
                index=index+1;p=p+1;n=n+1
            }
            if ((flags&128) != 0) p=p+1
        }
        if (bytes != index+5 || !at(index,58,false) || !at(index+1,85,true) ||
            !at(index+2,54,false) || !at(index+3,lcdMadctl(rotation,true),true) || !at(index+4,32,false)) return i32(4)
        var blit=0
        while (blit < 2) {
            reset()
            val result=if (blit == 0) gc9a01FillRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),rotation,238,239,3,2,Rgb565(0x1234),0)
                else gc9a01BlitChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),rotation,238,239,nativeBufferAt(pixels,4),2,1,4,false,0)
            val offset=if ((rotation&1) != 0) 5 else 0
            if (!result.valid() || bad || selected || bytes != offset+15 || bits != 0) return i32(5)
            if (offset != 0 && (!at(0,43,false) || !at(1,255,true) || !at(2,255,true) || !at(3,255,true) || !at(4,255,true))) return i32(6)
            if (!at(offset,42,false) || !at(offset+1,0,true) || !at(offset+2,238,true) || !at(offset+3,0,true) || !at(offset+4,239,true) ||
                !at(offset+5,43,false) || !at(offset+6,0,true) || !at(offset+7,239,true) || !at(offset+8,0,true) || !at(offset+9,239,true) ||
                !at(offset+10,44,false) || !at(offset+11,18,true) || !at(offset+12,52,true) ||
                !at(offset+13,if (blit == 0) 18 else 171,true) || !at(offset+14,if (blit == 0) 52 else 205,true)) return i32(7)
            blit=blit+1
        }
        var format=0
        while (format < 4) {
            reset();reading=true;shared=format >= 2
            val dest=nativeBufferAt(readMemory,32);var i=0
            while (i < 32) { dest.store(i,0xcc);i=i+1 }
            val step=if ((format&1) == 0) 3 else 2
            if (!gc9a01ReadRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(if (shared) 2 else 5),Pin(3),Pin(4),rotation,238,238,2,2,dest,9,(format&1) != 0,0,shared).valid() ||
                bad || selected || !driven || restores != (if (shared) 1 else 0) || samples != 112 || bits != 0 || nativeAddressLoadU32(gateMemory,0) != 0) return i32(13)
            val offset=if ((rotation&1) != 0) 5 else 0
            if (bytes != offset+26 || !at(offset+10,44,false) || !at(offset+11,46,false)) return i32(14)
            i=0
            while (i < 32) {
                val row=i/9;val col=(i%9)/step;val component=(i%9)%step
                var expected=0xcc
                if (row < 2 && i%9 < 2*step) {
                    val pixel=row*2+col
                    if ((format&1) == 0) expected=((pixel*3+component)*37+11)&255
                    else {
                        val red=(pixel*111+11)&255;val green=(pixel*111+48)&255;val blue=(pixel*111+85)&255
                        val packed=((red>>3)<<11)|((green>>2)<<5)|(blue>>3)
                        expected=if (component == 0) packed>>8 else packed&255
                    }
                }
                if (dest.load(i) != expected) return i32(15)
                i=i+1
            }
            format=format+1
        }
        rotation=rotation+1
    }
    reset()
    if (gc9a01FillRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),8,0,0,1,1,Rgb565(0),0).status() != 3 || bytes != 0) return i32(8)
    if (!gc9a01FillRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),1,240,0,1,1,Rgb565(0),0).valid() || bytes != 0) return i32(9)
    if (gate.tryBegin(u32(9)) != 0) return i32(10)
    if (gc9a01FillRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),1,0,0,1,1,Rgb565(0),0).status() != 2 || bytes != 0) return i32(11)
    if (!gate.finish(u32(9),true)) return i32(12)
    reset()
    val dest=nativeBufferAt(readMemory,32)
    if (gc9a01ReadRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(2),Pin(3),Pin(4),0,0,0,2,2,dest,9,false,0).status() != 3 ||
        gc9a01ReadRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(5),Pin(3),Pin(4),0,239,0,2,2,dest,9,false,0).status() != 3 ||
        gc9a01ReadRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(5),Pin(3),Pin(4),0,0,0,2,2,dest,4,false,0).status() != 3 ||
        gc9a01ReadRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(5),Pin(3),Pin(4),0,0,0,1,1,nativeBufferAt(gateMemory,4),3,false,0).status() != 3 || bytes != 0 || samples != 0) return i32(16)
    var failure=0
    while (failure < 6) {
        reset();shared=true;reading=true;partial=(failure&1) != 0
        failInput=failure < 2;failRelease=failure >= 2 && failure < 4;failOutput=failure >= 4
        var i=0;while (i < 32) { dest.store(i,0xcc);i=i+1 }
        val result=gc9a01ReadRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(2),Pin(3),Pin(4),1,0,0,1,1,dest,3,false,0,true)
        val detail=if (failInput) 1 else if (failRelease) 6 else 4
        if (result.status() != 6 || result.value() != u32(detail) || bad ||
            nativeAddressLoadU32(gateMemory,0) != 0x80000000 || samples != (if (failInput) 0 else 40) ||
            restores != (if (failRelease) 0 else 1)) return i32(17)
        if (failInput && dest.load(0) != 0xcc) return i32(18)
        val previous=bytes
        if (gc9a01ReadRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(2),Pin(3),Pin(4),1,0,0,1,1,dest,3,false,0,true).status() != 4 || bytes != previous) return i32(19)
        if (gc9a01SharedReadRecover(gate,u32(7),Pin(3),Pin(2),false)) return i32(20)
        failRelease=true;partial=false
        val before=restores
        if (gc9a01SharedReadRecover(gate,u32(7),Pin(3),Pin(2),true) || restores != before || bytes != previous) return i32(21)
        failRelease=false;failInput=false;failOutput=true
        if (gc9a01SharedReadRecover(gate,u32(7),Pin(3),Pin(2),true) || nativeAddressLoadU32(gateMemory,0) != 0x80000000) return i32(22)
        failOutput=false
        if (!gc9a01SharedReadRecover(gate,u32(7),Pin(3),Pin(2),true) || selected || !driven || bad || bytes != previous ||
            nativeAddressLoadU32(gateMemory,0) != 0) return i32(23)
        failure=failure+1
    }
    reset();shared=true
    val session=gc9a01SessionAt(nativeBufferAt(sessionMemory,64))
    if (!session.initializeFresh() || !session.openOwned(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),Pin(2),0,true,true,false,true,0).valid() ||
        session.state() != 1 || session.rotation() != 0 || bad) return i32(24)
    val initializedBytes=bytes
    if (session.openOwned(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),Pin(2),0,true,true,false,true,0).status() != 3 || bytes != initializedBytes) return i32(25)
    reset();shared=true
    if (gate.tryBegin(u32(9)) != 0 || session.setRotationOwned(3,true).status() != 2 || session.rotation() != 0 || bytes != 0 ||
        !gate.finish(u32(9),true)) return i32(26)
    if (!session.setRotationOwned(3,true).valid() || session.rotation() != 3 || bytes != 2 || !at(0,54,false) || !at(1,lcdMadctl(3,true),true)) return i32(27)
    reset();shared=true
    if (!session.fillRectOwned(0,0,1,1,Rgb565(0x1234),true).valid() || bytes != 18 || !at(0,43,false) || !at(1,255,true)) return i32(28)
    reset();shared=true;reading=true
    if (session.readRectOwned(0,0,1,1,session.buffer(),3,false,true).status() != 3 ||
        session.blitOwned(0,0,session.buffer(),1,1,2,false,true).status() != 3 || bytes != 0) return i32(29)
    failInput=true
    if (session.readRectOwned(0,0,1,1,dest,3,false,true).status() != 6 || session.state() != 2 || samples != 0) return i32(30)
    val failedBytes=bytes
    if (session.fillRectOwned(0,0,1,1,Rgb565(0),true).status() != 3 || session.setRotationOwned(0,true).status() != 3 ||
        session.detachOwned(true) || bytes != failedBytes || session.recoverSharedReadOwned(false)) return i32(31)
    failInput=false
    if (!session.recoverSharedReadOwned(true) || session.state() != 1 || session.rotation() != 3 || bytes != failedBytes) return i32(32)
    reset();shared=true;reading=true
    if (!session.readRectOwned(0,0,1,1,dest,3,false,true).valid() || samples != 40 || bad) return i32(33)
    reset();shared=true
    if (!session.setPowerSaveOwned(true,true).valid() || !session.setPowerSaveOwned(false,true).valid() ||
        !session.setDisplayEnabledOwned(false,true).valid() || !session.setDisplayEnabledOwned(true,true).valid() ||
        !session.setInvertedOwned(true,true).valid() || !session.setInvertedOwned(false,true).valid() ||
        bytes != 6 || !at(0,57,false) || !at(1,56,false) || !at(2,40,false) || !at(3,41,false) || !at(4,33,false) || !at(5,32,false) ||
        session.buffer().loadU32(36) != 43 || session.buffer().loadU32(56) != 0 || bad) return i32(36)
    reset();shared=true;powerSession=session
    if (gate.tryBegin(u32(9)) != 0 || session.setSleepOwned(true,true).status() != 2 || session.state() != 1 || bytes != 0 ||
        !gate.finish(u32(9),true)) return i32(37)
    if (!session.setSleepOwned(true,true).valid() || session.state() != 4 || bytes != 1 || !at(0,16,false) || delayMs != 120 || bad) return i32(38)
    if (!session.setSleepOwned(true,true).valid() || bytes != 1 || delayMs != 120 ||
        session.fillRectOwned(0,0,1,1,Rgb565(0),true).status() != 3 || session.setRotationOwned(1,true).status() != 3 ||
        session.readRectOwned(0,0,1,1,dest,3,false,true).status() != 3 || session.setPowerSaveOwned(true,true).status() != 3) return i32(39)
    if (!session.setSleepOwned(false,true).valid() || session.state() != 1 || bytes != 2 || !at(1,17,false) || delayMs != 240 ||
        session.rotation() != 3 || bad) return i32(40)
    if (!session.setSleepOwned(false,true).valid() || bytes != 2 || delayMs != 240) return i32(41)
    powerSession=Gc9a01Session(0)
    failRelease=true
    if (session.detachOwned(true) || session.state() != 3 || nativeAddressLoadU32(gateMemory,0) != 0x80000000) return i32(34)
    failRelease=false
    if (!session.detachOwned(true) || session.state() != 0 || nativeAddressLoadU32(gateMemory,0) != 0 || bad) return i32(35)
    reset();shared=true
    if (!session.openOwned(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),Pin(2),0,true,true,false,true,0).valid()) return i32(42)
    reset();shared=true;failRelease=true
    if (session.setSleepOwned(true,true).status() != 6 || session.state() != 2 || delayMs != 0 || bytes != 1 ||
        session.setSleepOwned(false,true).status() != 3 || session.recoverSharedReadOwned(true) ||
        nativeAddressLoadU32(gateMemory,0) != 0x80000000 || bad) return i32(43)
    return i32(0)
}
