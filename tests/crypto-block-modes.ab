import "../src/crypto/block_modes.ab"
import "abla/unsafe/memory"

trusted noescape extern:"c" fun mmap(
    address: i64*,
    length: int,
    protection: i32,
    flags: i32,
    fileDescriptor: i32,
    offset: int
): i64*

trusted noescape extern:"c" fun munmap(address: i64*, length: int): i32

trusted fun main(): int {
    val allocation = mmap(
        nativeNullPointer(), 4096, i32(3), i32(98), i32(-1), 0
    )
    val address = nativePointerAddress(allocation)
    if (address <= 0) return 1
    val x = nativeBufferAt(address, 16)
    val y = nativeBufferAt(address + 16, 16)
    val output = nativeBufferAt(address + 32, 16)
    val temporary = nativeBufferAt(address + 48, 16)
    nativeAddressClear(address, 64)

    // NIST SP 800-38B AES-128 example subkey K1.
    x.store(0, 125); x.store(1, 247); x.store(2, 107); x.store(3, 12)
    x.store(4, 26); x.store(5, 184); x.store(6, 153); x.store(7, 179)
    x.store(8, 62); x.store(9, 66); x.store(10, 240); x.store(11, 71)
    x.store(12, 185); x.store(13, 27); x.store(14, 84); x.store(15, 111)
    if (!cryptoCmacDoubleBlock(x)) return 2
    val expectedK1 = nativeBufferAt(address + 64, 16)
    expectedK1.store(0, 251); expectedK1.store(1, 238)
    expectedK1.store(2, 214); expectedK1.store(3, 24)
    expectedK1.store(4, 53); expectedK1.store(5, 113)
    expectedK1.store(6, 51); expectedK1.store(7, 102)
    expectedK1.store(8, 124); expectedK1.store(9, 133)
    expectedK1.store(10, 224); expectedK1.store(11, 143)
    expectedK1.store(12, 114); expectedK1.store(13, 54)
    expectedK1.store(14, 168); expectedK1.store(15, 222)
    if (!cryptoConstantTimeEqual(x, expectedK1, 16)) return 3

    // NIST GCM example: X dot H.
    x.store(0, 3); x.store(1, 136); x.store(2, 218); x.store(3, 206)
    x.store(4, 96); x.store(5, 182); x.store(6, 163); x.store(7, 146)
    x.store(8, 243); x.store(9, 40); x.store(10, 194); x.store(11, 185)
    x.store(12, 113); x.store(13, 178); x.store(14, 254); x.store(15, 120)
    y.store(0, 102); y.store(1, 233); y.store(2, 75); y.store(3, 212)
    y.store(4, 239); y.store(5, 138); y.store(6, 44); y.store(7, 59)
    y.store(8, 136); y.store(9, 76); y.store(10, 250); y.store(11, 89)
    y.store(12, 202); y.store(13, 52); y.store(14, 43); y.store(15, 46)
    if (!cryptoGhashMultiply(x, y, output, temporary)) return 4
    val expectedProduct = nativeBufferAt(address + 80, 16)
    expectedProduct.store(0, 94); expectedProduct.store(1, 46)
    expectedProduct.store(2, 199); expectedProduct.store(3, 70)
    expectedProduct.store(4, 145); expectedProduct.store(5, 112)
    expectedProduct.store(6, 98); expectedProduct.store(7, 136)
    expectedProduct.store(8, 44); expectedProduct.store(9, 133)
    expectedProduct.store(10, 176); expectedProduct.store(11, 104)
    expectedProduct.store(12, 83); expectedProduct.store(13, 83)
    expectedProduct.store(14, 222); expectedProduct.store(15, 183)
    if (!cryptoConstantTimeEqual(output, expectedProduct, 16)) return 5
    if (munmap(allocation, 4096) != i32(0)) return 6
    80
}
