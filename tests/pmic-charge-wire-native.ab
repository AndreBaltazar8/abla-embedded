import "./pm1-control-wire-native.ab"
import "../src/m5stack/pmic_charge.ab"
@export("abla_pmic_charge_wire_test")
trusted fun testChargeWire(): i32 {
    wireSeed()
    val bus=i2cSoftwareMaster(0,1,5,8)
    val r=nativeBufferAt(chargeRegisters,256)
    var kind=2
    while (kind <= 6) {
        if (kind != 5) {
            chargeAddress=if (kind < 4) 52 else if (kind == 4) 117 else 73
            val device=bus.device(chargeAddress,400000)
            if (!device.valid()) return i32(1)
            // The fixture supplies the detected kind; subsequent chip methods,
            // register transport and software-I2C engine are production code.
            val pmic=M5PmicOpen((device|0)|(kind<<32)|(1<<40))
            var operation=0
            while (operation < 4) {
                val reg=if (kind == 2) 51 else if (kind == 3) (if (operation < 2) 24 else if (operation == 2) 98 else 100)
                    else if (kind == 4) (if (operation < 2) 0 else if (operation == 2) 36 else 34)
                    else if (operation < 2) 1 else if (operation == 2) 2 else 4
                val mask=if (kind == 2) (if (operation < 2) 128 else if (operation == 2) 15 else 96)
                    else if (kind == 3) (if (operation < 2) 2 else 255)
                    else if (kind == 4) (if (operation < 2) 16 else if (operation == 2) 31 else 255)
                    else if (operation < 2) 8 else if (operation == 2) 255 else 63
                // Independently specified register values for500mA/4200mV.
                val value=if (operation < 2) (if (kind == 6) (if (operation == 0) 8 else 0) else if (operation == 1) mask else 0)
                    else if (operation == 2) (if (kind == 2 || kind == 4) 4 else if (kind == 3) 11 else 61)
                    else if (kind == 2) 64 else if (kind == 3) 3 else if (kind == 4) 2 else 40
                val limit=if (mask == 255) 3 else 6
                var fault=0
                while (fault <= limit) {
                    var commit=0
                    while (commit < 2) {
                        var at=0;while (at < 256) { r.store(at,165);at=at+1 }
                        val before=ackCount
                        chargeNackAfterCommit=commit == 1;nackAt=if (fault == 0) 0 else before+fault
                        val result=if (operation < 2) pmic.setBatteryChargeOwned(operation == 1,true)
                            else if (operation == 2) pmic.setChargeCurrentOwned(500,true) else pmic.setChargeVoltageOwned(4200,true)
                        if (result != M5ChargeControlResult(if (fault == 0) 1 else 4) || ackCount-before != (if (fault == 0) limit else fault) || bad || mode != 0) return i32(2)
                        val changed=fault == 0 || (commit == 1 && fault == limit)
                        at=0
                        while (at < 256) {
                            val expected=if (at == reg && changed) (165&~mask)|value else 165
                            if (r.load(at) != expected) return i32(3)
                            at=at+1
                        }
                        commit=commit+1
                    }
                    fault=fault+1
                }
                operation=operation+1
            }
            nackAt=0;chargeNackAfterCommit=false
            if (!device.close()) return i32(4)
            val before=ackCount
            if (pmic.setChargeCurrentOwned(500,true) != M5ChargeControlResult(4) || ackCount != before) return i32(5)
        }
        kind=kind+1
    }
    if (!bus.close() || pads != 0 || bad) return i32(6)
    return i32(0)
}
