import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/cores3_wav.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Caller provides parsed immutable WAV metadata and the existing speaker
// hardware prerequisites; this object is not a bootable firmware image.
@export("abla_s3_wav_playback_test")
trusted fun wavPlaybackTarget(amplifier: u32,expander: u32,descriptors: u32,
    buffers: u32,metadata: u32,staging: u32,owner: u32): int =
    cores3PlaybackWav(Aw88298(int(amplifier)),Aw9523(int(expander)),2,
        int(descriptors),int(buffers),PcmWav(int(metadata)),
        nativeBufferAt(int(staging),960),owner,1000)
