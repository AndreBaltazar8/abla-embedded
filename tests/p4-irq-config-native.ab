import "../src/esp32/irq_config_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(32)
var core=0
var enabled=-1
var machine=u32(0)
var fences=0
var bad=false
fun p4IrqConfigCurrentCore(): int = core
fun p4IrqConfigMachineStatus(): u32 = machine
fun p4IrqConfigLineEnabled(line: int): bool = line == enabled
fun p4IrqConfigStorage(index: int): NativeBuffer = nativeBufferAt(memory+index*16,16)
trusted fun p4IrqConfigFence(): void { fences=fences+1; if (p4IrqConfigStorage(core).loadU32(0) != 0) bad=true; return }
@export("abla_p4_irq_config_test")
trusted fun testConfig(): i32 {
    while (core < 2) {
        val currentConfig=p4IrqConfigStorage(core)
        val other=p4IrqConfigStorage(1-core)
        currentConfig.storeU32(0,0); currentConfig.storeU32(4,0); other.storeU32(0,1234)
        fences=0
        if (esp32P4IrqConfigureOwned(core,0x4ff00100,42) != 1 || currentConfig.loadU32(4) != 42 ||
            other.loadU32(0) != 1234 || fences != 1 || bad) return i32(1)
        if (esp32P4IrqConfigureOwned(core,0x4ff00200,43) != 3 || esp32P4IrqUnconfigureOwned(core,0x4ff00200) != 3) return i32(2)
        if (esp32P4IrqUnconfigureOwned(core,0x4ff00100) != 1 || currentConfig.loadU32(0) != 0 || currentConfig.loadU32(4) != 0 || fences != 2 || bad) return i32(3)
        enabled=0
        while (enabled < 48) {
            if (esp32P4IrqConfigureOwned(core,0x4ff00100,42) != 3 || fences != 2) return i32(4)
            enabled=enabled+1
        }
        enabled=-1; machine=u32(8)
        if (esp32P4IrqConfigureOwned(core,0x4ff00100,42) != 3) return i32(5)
        machine=u32(0)
        if (esp32P4IrqConfigureOwned(1-core,0x4ff00100,42) != 3 || esp32P4IrqConfigureOwned(core,1,42) != 2) return i32(6)
        core=core+1
    }
    return i32(0)
}
