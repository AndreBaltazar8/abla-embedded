import "../src/esp32/i2c_esp32s3.ab"
import "../src/touch/cst816s_session.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_cst816s_session_target")
trusted fun target(bus: I2cBus,owner: Cst816sSession,buffer: NativeBuffer,now: int,operation: int): Cst816sSession =
    if (operation == 0) openCst816sSession(bus) else if (operation == 1) owner.poll(buffer,now) else owner.close()
