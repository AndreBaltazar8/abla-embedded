import "../src/sd/mmc_negotiate_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(256)
var calls=0
var admitted=true
var scrBegin=2
var scrPoll=2
var widthBegin=2
var widthPoll=2
var capability=sdScrDecode(u32(0x502))
var expectedWidth=4
var expectedBudget=80
var bad=false
fun sdMmcNegotiationAdmission(card: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer): bool = admitted
fun sdMmcNegotiationScrBegin(context: NativeBuffer,card: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer,now: u32,budget: int): int {
    calls=calls*10+1
    if (context.addressValue() != memory+32 || card.addressValue() != memory+144 ||
        descriptor.addressValue() != memory+224 || payload.addressValue() != memory+240 || budget != 100) bad=true
    context.storeU32(0,0x53445202);return scrBegin
}
fun sdMmcNegotiationScrPoll(context: NativeBuffer,now: u32): int { calls=calls*10+2;return scrPoll }
fun sdMmcNegotiationScrResult(context: NativeBuffer): SdScr { calls=calls*10+3;return capability }
fun sdMmcNegotiationWidthBegin(context: NativeBuffer,card: NativeBuffer,scr: SdScr,width: int,now: u32,budget: int): int {
    calls=calls*10+4
    if (context.addressValue() != memory+96 || card.addressValue() != memory+144 || width != expectedWidth || budget != expectedBudget) bad=true
    context.storeU32(0,0x53445702);context.store(7,1);return widthBegin
}
fun sdMmcNegotiationWidthPoll(context: NativeBuffer,now: u32): int { calls=calls*10+5;context.store(7,3);return widthPoll }
@export("abla_sdmmc_negotiate_test")
trusted fun test(): i32 {
    val context=nativeBufferAt(memory,144);val card=nativeBufferAt(memory+144,80)
    val descriptor=nativeBufferAt(memory+224,16);val payload=nativeBufferAt(memory+240,8)
    var mode=0
    while (mode < 10) {
        context.storeU32(0,0);calls=0;bad=false
        scrBegin=if (mode == 1) 4 else 2;scrPoll=if (mode == 2) 7 else 1
        capability=if (mode == 3) SdScr(0) else if (mode == 4) sdScrDecode(u32(0x102)) else sdScrDecode(u32(0x502))
        widthBegin=if (mode == 5) 4 else 2;widthPoll=if (mode == 6) 6 else 1
        expectedWidth=if (mode == 7) 1 else 4;expectedBudget=80
        val start=if (mode == 8) u32(0xfffffff0) else u32(10)
        val first=sdMmcNegotiationBeginOwned(context,card,descriptor,payload,expectedWidth,start,100,true)
        if (first != (if (mode == 1) 4 else 2) || calls != 1 || bad) return i32(1)
        calls=0
        val second=sdMmcNegotiationPollOwned(context,start+u32(if (mode == 9) 100 else 20))
        val expected=if (mode == 1 || mode == 2) 4 else if (mode == 3 || mode == 4) 5 else if (mode == 5) 6 else if (mode == 9) 7 else 2
        if (second != expected || calls != (if (mode == 1) 0 else if (mode == 2) 2 else if (mode == 3 || mode == 4 || mode == 9) 23 else 234) || bad) return i32(2)
        calls=0
        if (second == 2) {
            if (sdMmcNegotiationPollOwned(context,start+u32(30)) != (if (mode == 6) 6 else 1) || calls != 5 || context.load(103) != 3) return i32(3)
        }
        val terminal=sdMmcNegotiationStatus(context);calls=0
        if (sdMmcNegotiationPollOwned(context,start+u32(200)) != terminal || calls != 0 ||
            sdMmcNegotiationBeginOwned(context,card,descriptor,payload,4,start,100,true) != 3) return i32(4)
        mode=mode+1
    }
    // Outer deadline does not bypass pending SCR DMA's own cleanup/poll.
    context.storeU32(0,0);calls=0;scrBegin=2;scrPoll=2
    if (sdMmcNegotiationBeginOwned(context,card,descriptor,payload,4,u32(0),100,true) != 2 ||
        sdMmcNegotiationPollOwned(context,u32(101)) != 2 || calls != 12) return i32(5)
    context.storeU32(0,0);calls=0;admitted=false
    if (sdMmcNegotiationBeginOwned(context,card,descriptor,payload,4,u32(0),100,true) != 3 || calls != 0) return i32(6)
    admitted=true
    if (sdMmcNegotiationBeginOwned(context,nativeBufferAt(memory+100,80),descriptor,payload,4,u32(0),100,true) != 3 ||
        sdMmcNegotiationBeginOwned(context,card,descriptor,payload,2,u32(0),100,true) != 3 ||
        sdMmcNegotiationBeginOwned(context,card,descriptor,payload,4,u32(0),100,false) != 3 || calls != 0) return i32(7)
    return i32(0)
}
