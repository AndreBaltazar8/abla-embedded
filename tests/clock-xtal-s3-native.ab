import "../src/esp32/clock_xtal_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var sys=0
var per=0
var stored=0x00280028
var step=0
var reads=0
var bad=false
var rtcBias=0
var digBias=0
var pll=false
fun esp32S3ClockRead(address: int): int {
    val expected=if (reads == 0) 0x600C0060 else if (reads == 1) 0x600C0010 else 0x600080C0
    if (reads >= 3 || address != expected || step != 0) bad=true
    reads=reads+1
    if (reads == 1) sys else if (reads == 2) per else stored
}
fun esp32S3ClockRomTicks(mhz: int): void {
    if (step != 0 || reads != 3 || mhz != 40) bad=true
    step=step+1
    return
}
fun esp32S3ClockBiasWrite(register: int,value: int): void {
    if (step == 4) { if (register != 4 || value != rtcBias) bad=true }
    else if (step == 5) { if (register != 6 || value != digBias) bad=true }
    else bad=true
    step=step+1
    return
}
fun esp32S3ClockRomDelay(us: int): void {
    if (step != 6 || us != 40) bad=true
    step=step+1
    return
}
fun esp32S3ClockUpdate(address: int,mask: int,value: int): void {
    val leaving240=((sys>>>10) & 3) == 1 && (per & 3) == 2
    val end=if (leaving240) 7 else 4
    if (step == 1 || step == 2 || step == 3) {
        if (address != 0x600C0060 || mask != (if (step == 3) 3072 else 1023) || value != 0) bad=true
    } else if (step == end) {
        if (address != 0x600081FC || mask != 63<<13 || value != 7<<13) bad=true
    } else if (step == end+1 && pll) {
        if (address != 0x60008000 || mask != 0x540 || value != mask) bad=true
    } else bad=true
    step=step+1
    return
}
@export("abla_clock_xtal_test")
trusted fun clockXtalTest(): i32 {
    var source=0
    while (source < 4) {
        sys=(source<<10) | 7
        per=0
        while (per < 8) {
            var variant=0
            while (variant < 4) {
                stored=if (variant >= 2) 0 else 0x00280028
                pll=(variant & 1) != 0
                rtcBias=0
                while (rtcBias <= 31) {
                    digBias=31-rtcBias; step=0; reads=0; bad=false
                    val expected=esp32S3ClockDecode(sys,per,stored)
                    val valid=stored != 0 && expected.valid()
                    val result=esp32S3ClockToXtalOwned(rtcBias,digBias,pll)
                    val leaving240=source == 1 && (per & 3) == 2
                    if (bad || reads != 3 || result.valid() != valid ||
                        (valid && result != expected) || step != (if (valid) 5+(if (leaving240) 3 else 0)+(if (pll) 1 else 0) else 0)) return i32(1)
                    rtcBias=rtcBias+1
                }
                variant=variant+1
            }
            per=per+1
        }
        source=source+1
    }
    reads=0; step=0
    if (esp32S3ClockToXtalOwned(-1,0,true).valid() || esp32S3ClockToXtalOwned(0,32,true).valid() || reads != 0 || step != 0) return i32(2)
    i32(0)
}
