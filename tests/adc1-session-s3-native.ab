import "../src/esp32/adc_fuse_s3_sequence.ab"
import "../src/esp32/adc1_session_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
// Lifecycle test doubles. Hardware transitions have separate MMIO fixtures.
type Esp32S3AdcPower = int
fun Esp32S3AdcPower.bits(): int = this
fun Esp32S3AdcPower.status(): int = this&255
fun Esp32S3AdcPower.powered(): bool = this.status() == 1
type Esp32S3AdcBus = int
fun Esp32S3AdcBus.bits(): int = this
fun Esp32S3AdcBus.status(): int = this&255
fun Esp32S3AdcBus.ready(): bool = this.status() == 1
var fail=0
var trace=0
var startResult=257
var finishResult=315905
var releaseResult=1
var busClose=0
var powerClose=0
var matching=true
var bad=false
fun esp32S3AdcFuseRead(offset: int): int { bad=true; return 0 }
fun esp32S3AdcPowerOpenOwned(exclusive: bool): Esp32S3AdcPower { trace=trace*10+1; return Esp32S3AdcPower(2048|(if (fail == 1) 4 else 1)) }
fun esp32S3AdcBusOpenOwned(exclusive: bool): Esp32S3AdcBus { trace=trace*10+2; return Esp32S3AdcBus(2048|(if (fail == 2) 3 else 1)) }
fun esp32S3Adc1PadConfigureOwned(channel: int): int { trace=trace*10+3; return if (fail == 3) 5 else 1 }
fun esp32S3Adc1ConfigureOwned(channel: int,attenuation: int,polls: int): int { trace=trace*10+4; return if (fail == 4) 773 else 1 }
fun esp32S3AdcAnalogConfigureOwned(calibration: Esp32S3AdcCalibration): int { trace=trace*10+5; return if (fail == 5) 3 else 1 }
fun esp32S3Adc1SessionHardwareMatches(channel: int,attenuation: int): bool = matching
fun esp32S3Adc1StartOwned(channel: int,polls: int): int { trace=trace*10+6; return startResult }
fun esp32S3Adc1FinishOwned(channel: int,polls: int): int { trace=trace*10+7; return finishResult }
fun esp32S3Adc1ReleaseOwned(channel: int,polls: int): int { trace=trace*10+8; return releaseResult }
fun Esp32S3AdcBus.closeOwned(): Esp32S3AdcBus {
    if (this == Esp32S3AdcBus(0)) return Esp32S3AdcBus(0)
    trace=trace*10+9; return Esp32S3AdcBus(if (busClose == 0) 0 else 2048|busClose)
}
fun Esp32S3AdcPower.closeOwned(): Esp32S3AdcPower {
    trace=trace*10+1; return Esp32S3AdcPower(if (powerClose == 0) 0 else 2048|powerClose)
}
fun reset(): void { fail=0; trace=0; startResult=257; finishResult=(1234<<8)|1; releaseResult=1; busClose=0; powerClose=0; matching=true; return }
@export("abla_adc1_session_s3_test")
fun test(): i32 {
    var channel=0
    while (channel < 10) {
        var attenuation=0
        while (attenuation < 4) {
            reset()
            val cal=Esp32S3AdcCalibration(268435456|(attenuation<<26)|(3000<<12)|2000)
            var session=esp32S3Adc1SessionOpenOwned(channel,cal,true,true,3)
            if (trace != 12345 || !session.ready() || session.channel() != channel || session.attenuation() != attenuation || session.raw() != -1) return i32(1)
            session=session.startAfterSettlingOwned(3)
            if (!session.pending() || session.ready() || session.raw() != -1) return i32(2)
            session=session.pollOwned(3)
            if (session.pending() || !session.ready() || session.raw() != 1234 || session.millivolts(cal) != cal.millivolts(1234)) return i32(3)
            trace=0; session=session.closeOwned(3)
            if (session.status() != 0 || trace != 891) return i32(4)
            attenuation=attenuation+1
        }
        channel=channel+1
    }
    val cal=Esp32S3AdcCalibration(268435456|(3000<<12)|2000)
    var stage=1
    while (stage <= 5) {
        reset(); fail=stage
        var session=esp32S3Adc1SessionOpenOwned(0,cal,true,true,3)
        if (session.status() != stage+2 || session.ready()) return i32(5)
        fail=0; trace=0; session=session.closeOwned(3)
        val expected=if (stage == 1) 1 else if (stage < 4) 91 else if (stage == 4) 4891 else 891
        if (session.status() != 0 || trace != expected) return i32(6)
        stage=stage+1
    }
    reset()
    var session=esp32S3Adc1SessionOpenOwned(0,cal,true,true,3)
    startResult=261; session=session.startAfterSettlingOwned(3)
    if (!session.pending() || session.status() != 9) return i32(7)
    finishResult=6; session=session.pollOwned(3)
    if (!session.pending() || session.status() != 10) return i32(8)
    releaseResult=6; trace=0; session=session.closeOwned(3)
    if (session.status() != 12 || trace != 8) return i32(9)
    releaseResult=1; busClose=3; trace=0; session=session.closeOwned(3)
    if (session.status() != 13 || session.ready() || trace != 89) return i32(10)
    busClose=0; powerClose=4; trace=0; session=session.closeOwned(3)
    if (session.status() != 14 || trace != 91) return i32(11)
    powerClose=0; trace=0; session=session.closeOwned(3)
    if (session.status() != 0 || trace != 1) return i32(12)
    reset(); session=esp32S3Adc1SessionOpenOwned(0,cal,true,true,3)
    session=session.startAfterSettlingOwned(3); finishResult=7; session=session.pollOwned(3)
    if (session.status() != 11 || session.pending() || session.raw() != -1) return i32(13)
    matching=false; trace=0; session=session.startAfterSettlingOwned(3)
    if (session.status() != 8 || trace != 0) return i32(14)
    reset()
    if (esp32S3Adc1SessionOpenOwned(10,cal,true,true,3).status() != 2 || esp32S3Adc1SessionOpenOwned(0,Esp32S3AdcCalibration(3),true,true,3).status() != 2 || trace != 0 || bad) return i32(15)
    return i32(0)
}
