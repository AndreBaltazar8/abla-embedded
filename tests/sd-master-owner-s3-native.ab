import "./sd-s3-fat-image.ab"
import "../src/storage/fat_spi_s3_owner.ab"
import "../src/storage/fat_file_read.ab"
import "../src/sd/master_owner_s3_sequence.ab"
import "../src/sd/transfer_clock_s3_sequence.ab"
import "../src/m5stack/sd_spi_s3_profile.ab"
val ownerMemory=nativeStaticAllocate(136)
val fatMemory=nativeStaticAllocate(2588)
var masterFailure=false
var closeFailure=false
var masterCalls=0
var closeCalls=0
var clockFailure=false
var clockCalls=0
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this|0
trusted fun s3SdOwnerMasterTransferClock(link: SdSpiS3Link): bool {
    clockCalls=clockCalls+1
    if (nativeAddressLoadU32(gateStorage,0) != 7 || nativeAddressLoadU32(ownerMemory,72) != 7 ||
        !csHigh || link.pins() != spiPins(10,11,12)) bad=true
    return !clockFailure && sdSpiS3TransferClockOwned(link)
}
trusted fun s3SdOwnerMasterBegin(storage: NativeBuffer,link: SdSpiS3Link,owner: u32,polls: int): int {
    masterCalls=masterCalls+1
    if (nativeAddressLoadU32(gateStorage,0) != 7 || owner != u32(7) || polls != 1 ||
        link.pins() != spiPins(10,11,12) || link.select() != 13) bad=true
    storage.storeU32(0,123);storage.storeU32(4,if (masterFailure) 3 else 1)
    return if (masterFailure) 3 else 1
}
trusted fun s3SdOwnerMasterClose(storage: NativeBuffer,polls: int): int {
    closeCalls=closeCalls+1
    val held=nativeAddressLoadU32(gateStorage,0)
    if ((held != 7 && held != 0x80000007) || polls != 1) bad=true
    if (closeFailure) return 3
    storage.storeU32(4,2);csHigh=true;return 2
}
@export("abla_sd_master_owner_s3_test")
trusted fun testOwner(): i32 {
    val record=s3SdMasterOwnerAt(nativeBufferAt(ownerMemory,136))
    val gate=peripheralGateAt(gateStorage)
    val scratch=nativeBufferAt(memory,2);val response=nativeBufferAt(memory+4,16)
    val link=sdSpiS3Link(2,spiPins(10,11,12),Pin(13))
    prepareSessionCard()
    if (!record.initializeFresh() || record.openOwned(link,gate,u32(7),scratch,response,1,true) != 1 ||
        record.session().blockCount(u32(7)) != 4294967296 || masterCalls != 1 || clockCalls != 1 || bad) return i32(1)
    val first=record.session();val before=starts
    if (record.openOwned(link,gate,u32(7),scratch,response,1,true) != 2 || starts != before) return i32(2)
    closeFailure=true
    if (record.closeOwned(u32(7),true,1) || record.status() != 5 || record.session() != 0 || first.blockCount(u32(7)) != 0 ||
        nativeAddressLoadU32(gateStorage,0) != 0x80000000 || bad) return i32(3)
    closeFailure=false
    if (!record.closeOwned(u32(7),true,1) || record.status() != 0 || closeCalls != 2 || bad) return i32(4)
    prepareSessionCard()
    if (record.openOwned(link,gate,u32(7),scratch,response,1,true) != 1 || record.session() == first ||
        record.cardStorage().loadU32(8) != 2 || first.blockCount(u32(7)) != 0) return i32(5)
    if (!record.closeOwned(u32(7),true,1)) return i32(6)
    prepareSessionCard();masterFailure=true
    if (record.openOwned(link,gate,u32(7),scratch,response,1,true) != 3 || starts != 0 ||
        record.session() != 0 || !record.closeOwned(u32(7),true,1) || bad) return i32(7)
    masterFailure=false;prepareSessionCard();failAt=1
    if (record.openOwned(link,gate,u32(7),scratch,response,1,true) != 4 || record.session() != 0 ||
        !record.closeOwned(u32(7),true,1) || bad) return i32(8)
    prepareSessionCard();clockFailure=true
    if (record.openOwned(link,gate,u32(7),scratch,response,1,true) != 6 || record.session() != 0 ||
        record.buffer().loadU32(24) != 3 || nativeAddressLoadU32(gateStorage,0) != 0x80000000 ||
        nativeAddressLoadU32(ownerMemory,72) != 0 || bad) return i32(11)
    if (!record.closeOwned(u32(7),true,1) || record.status() != 0 || record.cardStorage().loadU32(12) == 1 || bad) return i32(12)
    clockFailure=false;prepareSessionCard()
    if (record.openOwned(link,gate,u32(7),scratch,response,1,true) != 1 ||
        !record.closeOwned(u32(7),true,1) || bad) return i32(13)
    var ignored=1
    while (ignored <= 3) {
        prepareSessionCard();ignoredClockWrite=ignored
        if (record.openOwned(link,gate,u32(7),scratch,response,1,true) != 6 ||
            record.session() != 0 || record.buffer().loadU32(24) != 3 ||
            nativeAddressLoadU32(gateStorage,0) != 0x80000000 || bad ||
            !record.closeOwned(u32(7),true,1)) return i32(14)
        ignored=ignored+1
    }
    val prior=masterCalls
    if (record.openOwned(link,gate,u32(7),nativeBufferAt(ownerMemory+72,2),response,1,true) != 2 ||
        record.openOwned(link,gate,u32(7),scratch,response,1,false) != 2 || masterCalls != prior) return i32(9)
    // Literal board wiring plus explicit exclusion of nativeSDMMC/nonS3 maps.
    val core=m5BoardStackCoreS3.sdSpiS3Link(2)
    val card=m5BoardCardputer.sdSpiS3Link(3)
    val paper=m5BoardPaperS3.sdSpiS3Link(2)
    if (core.pins() != spiPins(37,35,36) || core.select() != 4 ||
        card.pins() != spiPins(14,39,40) || card.select() != 12 || card.peripheral() != 3 ||
        paper.pins() != spiPins(38,40,39) || paper.select() != 47 ||
        m5BoardPaperMono.sdSpiS3Link(2).valid() || m5BoardCoreMatrix.sdSpiS3Link(2).valid() ||
        m5BoardStackCore2.sdSpiS3Link(2).valid() || m5BoardCardputer.sdSpiS3Link(1).valid()) return i32(10)
    prepareSessionCard();prepareFatImage()
    if (record.openOwned(link,gate,u32(7),scratch,response,1,true) != 1 || transferDivider != ((3<<12)|64|3)) return i32(15)
    val reader=nativeBufferAt(fatMemory,28);val boot=nativeBufferAt(fatMemory+28,512)
    val output=nativeBufferAt(fatMemory+540,512);val workspace=nativeBufferAt(fatMemory+1052,1536)
    imageEnabled=true
    if (!record.bindFatReaderOwned(reader,u32(7),scratch,4) || !fatStorageReadOwned(reader,0,boot) ||
        !fatBootValidate(boot,0,10113).valid() || bad) return i32(16)
    val directory=fatDirectoryReadOwned(reader,boot,0,10113,0,0,1,output,nativeBufferAt(workspace.addressValue(),1024))
    val file=fatDirectoryDecode(output,0,16,10000)
    if (directory.status() != 1 || !file.isFile() || file.byteSize() != 700) return i32(17)
    var offset=0
    while (offset < 700) {
        val result=fatFileReadAtOwned(reader,boot,0,10113,file,offset,512,2,output,workspace)
        val expected=if (offset == 0) 512 else 188
        if (result.bytesRead() != expected || bad) return i32(18)
        var at=0
        while (at < expected) {
            if (output.load(at) != ((at+(if (offset == 0) 113 else 114))&255)) return i32(19)
            at=at+1
        }
        offset=offset+expected
    }
    val ioBefore=starts
    if (record.bindFatReaderOwned(nativeBufferAt(ownerMemory,28),u32(7),scratch,4) ||
        record.bindFatReaderOwned(reader,u32(7),nativeBufferAt(ownerMemory+32,2),4) ||
        fatStorageReadOwned(reader,0,nativeBufferAt(ownerMemory,512)) || starts != ioBefore || bad) return i32(20)
    if (!record.closeOwned(u32(7),true,1) || fatStorageReadOwned(reader,0,output) || starts != ioBefore) return i32(21)
    prepareSessionCard()
    if (record.openOwned(link,gate,u32(7),scratch,response,1,true) != 1) return i32(22)
    imageEnabled=true
    val reopenedIo=starts
    if (fatStorageReadOwned(reader,0,output) || starts != reopenedIo ||
        !record.bindFatReaderOwned(reader,u32(7),scratch,4) || !fatStorageReadOwned(reader,0,output) ||
        !record.closeOwned(u32(7),true,1) || bad) return i32(23)
    return i32(0)
}
