import "../src/esp32/cache_freeze_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var existing=0
var frozen=0
var events=0
var ir=0
var dr=0
var iready=0
var dready=0
var reads=0
var bad=false
fun esp32S3CacheFreezeRead(address: int): int {
    reads=reads+1
    if (address == 0x600C4154) return existing & 1
    if (address == 0x600C4150) return (existing>>>1) & 1
    if (address != 0x600C4130) bad=true
    if (frozen == 1) { ir=ir+1; return (if (ir > iready) 1 else 2) | (1<<12) }
    if (frozen == 3) { dr=dr+1; return (if (dr > dready) 1 else 2)<<12 }
    bad=true
    0
}
fun esp32S3CacheRomFreeze(instruction: bool): void {
    val bit=if (instruction) 1 else 2
    if ((frozen & bit) != 0 || (instruction && frozen != 0) || (!instruction && frozen != 1)) bad=true
    frozen=frozen | bit
    events=events*10+(if (instruction) 1 else 2)
    return
}
fun esp32S3CacheRomUnfreeze(instruction: bool): void {
    val bit=if (instruction) 1 else 2
    if ((frozen & bit) == 0) bad=true
    frozen=frozen & ~bit
    events=events*10+(if (instruction) 3 else 4)
    return
}
@export("abla_cache_freeze_test")
trusted fun freezeTest(): i32 {
    existing=0
    while (existing < 4) {
        iready=0
        while (iready < 5) {
            dready=0
            while (dready < 5) {
                frozen=0; events=0; ir=0; dr=0; reads=0; bad=false
                val expected=if (existing != 0) 2 else if (iready >= 3) 3 else if (dready >= 3) 4 else 1
                val result=esp32S3CachesFreezeOwned(3)
                if (result != expected || bad) return i32(1)
                if (result == 1) {
                    if (frozen != 3 || events != 12) return i32(2)
                    esp32S3CachesUnfreezeOwned()
                }
                if (bad || frozen != 0 || events != (if (existing != 0) 0 else if (iready >= 3) 13 else 1234)) return i32(3)
                if (ir != (if (existing != 0) 0 else if (iready >= 3) 3 else iready+1) ||
                    dr != (if (existing != 0 || iready >= 3) 0 else if (dready >= 3) 3 else dready+1)) return i32(4)
                dready=dready+1
            }
            iready=iready+1
        }
        existing=existing+1
    }
    reads=0; events=0
    if (esp32S3CachesFreezeOwned(0) != 0 || esp32S3CachesFreezeOwned(0x80000000) != 0 || reads != 0 || events != 0) return i32(5)
    i32(0)
}
