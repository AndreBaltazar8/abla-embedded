import "../src/power/m5pm1_logic.ab"

fun main: int {
    val gpio = m5Pm1GpioValid(0) && m5Pm1GpioValid(4) &&
        !m5Pm1GpioValid(-1) && !m5Pm1GpioValid(5) &&
        m5Pm1GpioFunctionValid(m5Pm1GpioFunctionGpio) &&
        m5Pm1GpioFunctionValid(m5Pm1GpioFunctionIrq) &&
        !m5Pm1GpioFunctionValid(2) &&
        m5Pm1GpioFunctionValid(m5Pm1GpioFunctionSpecial) &&
        m5Pm1GpioFieldRegister(3, 22) == 22 &&
        m5Pm1GpioFieldRegister(4, 22) == 23 &&
        m5Pm1GpioFieldShift(3) == 6 && m5Pm1GpioFieldShift(4) == 0
    val pwm = m5Pm1PwmDuty12FromPercent(0) == 0 &&
        m5Pm1PwmDuty12FromPercent(50) == 2047 &&
        m5Pm1PwmDuty12FromPercent(100) == 4095 &&
        m5Pm1PwmDuty12FromPercent(101) == -1 &&
        m5Pm1PwmValue(2748, false, false) == 2748 &&
        m5Pm1PwmValue(2748, false, true) == 6844 &&
        m5Pm1PwmValue(2748, true, true) == 15036
    val clearing = m5Pm1WakeClearValue(127) == 0 &&
        m5Pm1WakeClearValue(5) == 122 &&
        m5Pm1PowerKeyPending(255) == 5 &&
        m5Pm1PowerKeyPending(2) == 0
    val shortEvent = m5Pm1PowerKeyEvent(1, true)
    val doubleEvent = m5Pm1PowerKeyEvent(4, true)
    val event = shortEvent.valid() && shortEvent.pressed() &&
        !shortEvent.doubleClicked() && shortEvent.compatibilityCode() == 2 &&
        doubleEvent.valid() && doubleEvent.pressed() &&
        doubleEvent.doubleClicked() && doubleEvent.compatibilityCode() == 2 &&
        !m5Pm1PowerKeyEvent(5, false).valid() &&
        !m5Pm1PowerKeyEvent(5, false).pressed() &&
        m5Pm1PowerKeyEvent(5, false).compatibilityCode() == 0
    if (gpio && pwm && clearing && event) 57 else 1
}
