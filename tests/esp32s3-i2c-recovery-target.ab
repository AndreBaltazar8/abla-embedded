import "../src/esp32/i2c/recovery_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_i2c_recovery_test")
trusted fun i2cRecoveryTargetTest(port: i32): bool =
    esp32S3I2cResetPollingControllerLocked(int(port))
