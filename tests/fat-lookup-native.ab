            if (mode == 5 && (result.firstCluster() != 4 || result.byteSize() != 123)) return i32(11)
            if (location.loadU32(0) != (if (mode == 5) 1 else 0xabcdef) ||
                location.loadU32(4) != (if (mode == 5) 1 else 0xabcdef)) return i32(16)
            val item=fatNextDirectoryOwned(reader,boot,0,10113,root,0,0,3,2,listing,listWork)
            if (item.status() != 1 || item.ordinal() != 1 || item.entryIndex() != 1 ||
                item.nameUnits() != (if (mode == 5) 20 else 1) || listing.load(0) != (if (mode == 8) 66 else 65) ||
