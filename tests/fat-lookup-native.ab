    calls=0
    if (!fatLookupShortOwned(reader,boot,0,10113,2,name,3,sector,scratch).isFile() || calls != 3) return i32(2)
    mode=1; calls=0
    if (fatLookupShortOwned(reader,boot,0,10113,2,name,3,sector,scratch).status() != 9 || calls != 3) return i32(3)
    mode=2; calls=0
    if (fatLookupShortOwned(reader,boot,0,10113,2,name,4,sector,scratch).status() != 9 || calls != 4) return i32(4)
    mode=3; calls=0
