val storage=nativeStaticAllocate(2087)
var calls=0
var failure=0
var mode=0
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool = false
trusted fun longFragment(dest: NativeBuffer,offset: int,ordinal: int): void {
    dest.store(offset,ordinal | (if (ordinal == 2) 64 else 0)); dest.store(offset+11,15)
    dest.store(offset+13,if (mode == 6 && ordinal == 1) 129 else 128)
    var i=0
    while (i < 13) {
        val position=(ordinal-1)*13+i
        dest.storeU16(offset+fatLongNameUnitOffset(i),if (position < 20) 65+position else if (position == 20) 0 else 65535)
        i=i+1
    }
    return
}
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,dest: NativeBuffer): bool {
    calls=calls+1
    var i=0
    while (i < 512) { dest.store(i,0); i=i+1 }
    if (lba == 1) {
        dest.store(4,if (mode == 3) 2 else 3)
        dest.store(6,255); dest.store(7,255)
    } else if (mode >= 5) {
        if (lba == 81 || lba == 113) {
            i=0
            while (i < 15) { dest.store(i*32,229); i=i+1 }
            longFragment(dest,480,2)
        } else {
            longFragment(dest,0,1)
            if (mode == 7) dest.store(0,229)
            if (mode == 9) dest.store(0,2)
            i=0
            while (i < 11) { dest.store(32+i,32); i=i+1 }
            dest.store(32,if (mode == 8) 66 else 65); dest.store(58,4); dest.store(60,123)
            if (mode == 10) { dest.store(40,84);dest.store(41,88);dest.store(42,84);dest.store(44,24) }
            if (mode == 11) dest.store(32,5)
        }
    } else if (lba == 81 || lba == 113 || mode == 2) {
        i=0
        while (i < 16) { dest.store(i*32,229); i=i+1 }
    } else if (mode != 1) {
        i=0
        while (i < 11) { dest.store(i,32); i=i+1 }
        dest.store(0,65); dest.store(26,4); dest.store(28,123)
        if (mode == 4) dest.store(11,192)
    }
    return calls != failure
}
@export("abla_fat_lookup_test")
trusted fun test(): i32 {
