    mode=4; calls=0
    if (fatLookupShortOwned(reader,boot,0,10113,0,name,2,sector,scratch).status() != 12 || calls != 2) return i32(6)
    mode=0; calls=0
    if (fatLookupShortOwned(reader,boot,0,10113,2,name,2,sector,scratch).status() != 14 || calls != 2) return i32(7)
    var fail=1
    while (fail <= 3) {
        failure=fail; calls=0
        if (fatLookupShortOwned(reader,boot,0,10113,2,name,3,sector,scratch).status() != 11 || calls != fail) return i32(8)
        fail=fail+1
    }
    calls=0
