            val planned=fatPlanRemovalOwned(reader,boot,0,10113,root,1,1,nativeBufferAt(listing.addressValue(),32),3,removal,removalWork)
            if (planned.status() != (if (mode == 5 || mode == 7) 1 else 5)) return i32(26)
