import "../src/esp32/gpio_probe_esp32s3.ab"
import "abla/runtime/scalar"

// Compile-only hardware fixture. Never execute this on the host.
@export("abla_gpio_probe_test")
trusted fun gpioProbeTargetTest(): int {
    val state = gpioProbeCaptureEsp32S3(18)
    gpioProbeInput(18, 0)
    gpioProbeEsp32S3FastLow(18)
    gpioProbeEsp32S3FastHigh(18)
    gpioProbeEsp32S3ClockCycles(18, 2)
    gpioProbeI2cAddress(13, 15, 56)
    if (state.restore(18)) 0 else 1
}
