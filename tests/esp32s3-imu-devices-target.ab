import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/imu_delay_1khz_esp32s3.ab"
import "../src/imu/mpu6886_device.ab"
import "../src/imu/sh200q_device.ab"
import "../src/imu/bmi270_device.ab"
import "../src/imu/bmm150_device.ab"
import "../src/imu/ak8963_device.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")

// Compile-only. Select only the actually attached IMU on known wiring.
@export("abla_s3_imu_devices_test")
trusted fun imuDevicesTargetTest(busKey: int, selected: i32): int {
    val bus = I2cBus(busKey)
    // These acquisition branches require an already initialized sensor.
    if (selected == i32(6)) {
        val device=mpu6886(bus)
        val frame=nativeBufferAt(nativeStackAllocate(14),14)
        val result=device.readFrame(frame)
        val sample=if (result == 3) device.frameAcceleration(frame).x() +
            device.frameGyroscope(frame).y() + device.frameTemperature(frame).raw() else result
        if (!device.close()) return -1
        return sample
    }
    if (selected == i32(7)) {
        val device=sh200q(bus)
        val frame=nativeBufferAt(nativeStackAllocate(14),14)
        val result=device.readFrame(frame)
        val sample=if (result == 3) device.frameAcceleration(frame).x() +
            device.frameGyroscope(frame).y() + device.frameTemperature(frame).raw() else result
        if (!device.close()) return -1
        return sample
    }
    if (selected == i32(5)) {
        val device = mpu6886(bus)
        val frame = nativeBufferAt(nativeStackAllocate(14), 14)
        val result = device.enableFifo(9) && device.readFifoFrame(frame)
        if (!device.close()) return -1
        return if (result) 1 else 0
    }
    if (selected == i32(0)) {
        val device = mpu6886(bus)
        val result = device.begin()
        if (!device.close()) return -1
        return result
    }
    if (selected == i32(1)) {
        val device = sh200q(bus)
        val result = device.begin()
        if (!device.close()) return -1
        return result
    }
    if (selected == i32(2)) {
        val device = bmi270(bus)
        val result = device.begin()
        if (!device.close()) return -1
        return result
    }
    if (selected == i32(3)) {
        val device = bmm150(bus)
        val result = device.begin()
        if (!device.close()) return -1
        return result
    }
    if (selected == i32(4)) {
        val device = ak8963(bus)
        val result = device.begin()
        if (!device.close()) return -1
        return result
    }
    return -1
}
