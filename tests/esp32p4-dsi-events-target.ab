import "../src/display/dsi_events_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_events_target")
trusted fun target(layout: int,expected: int,enabled: int,capture: bool): int =
    if (capture) esp32P4DsiEventsCaptureOwned(layout) else esp32P4DsiEventsEnableOwned(layout,expected,enabled)
