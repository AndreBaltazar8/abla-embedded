import "../src/register.ab"
import "../src/esp32/gpio_esp32_logic.ab"

fun expectedEsp32IoMuxOffset(number: int): int {
    if (number == 0) return 68
    if (number == 1) return 136
    if (number == 2) return 64
    if (number == 3) return 132
    if (number == 4) return 72
    if (number == 5) return 108
    if (number == 6) return 96
    if (number == 7) return 100
    if (number == 8) return 104
    if (number == 9) return 84
    if (number == 10) return 88
    if (number == 11) return 92
    if (number == 12) return 52
    if (number == 13) return 56
    if (number == 14) return 48
    if (number == 15) return 60
    if (number == 16) return 76
    if (number == 17) return 80
    if (number == 18) return 112
    if (number == 19) return 116
    if (number == 20) return 120
    if (number == 21) return 124
    if (number == 22) return 128
    if (number == 23) return 140
    if (number == 25) return 36
    if (number == 26) return 40
    if (number == 27) return 44
    if (number == 32) return 28
    if (number == 33) return 32
    if (number == 34) return 20
    if (number == 35) return 24
    if (number == 36) return 4
    if (number == 37) return 8
    if (number == 38) return 12
    if (number == 39) return 16
    -1
}

fun main(): int {
    if (registerFieldMask(1, 0) != 1) return 1
    if (registerFieldMask(8, 8) != 65280) return 2
    if (registerFieldMask(32, 0) != 4294967295) return 3
    if (registerFieldMask(0, 0) != 0) return 4
    if (registerFieldMask(8, 30) != 0) return 5
    if (registerField(305419896, 8, 8) != 86) return 6
    if (!esp32GpioValid(0) || !esp32GpioValid(39)) return 7
    if (esp32GpioValid(24) || esp32GpioValid(28)) return 8
    if (!esp32GpioOutputValid(33) || esp32GpioOutputValid(34)) return 9
    var number = 0
    while (number < 40) {
        if (esp32IoMuxOffset(number) != expectedEsp32IoMuxOffset(number)) {
            return 10 + number
        }
        number = number + 1
    }
    65
}
