import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/axp_power.ab"
import "../src/power/ip5306_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_battery_level_target")
trusted fun batteryTarget(board: M5BoardId,device: I2cDevice,ip5306: bool): I2cByteResult =
    if (ip5306) Ip5306(device | 0).batteryLevelChecked() else board.bindAxpPower(device).batteryLevelChecked()
