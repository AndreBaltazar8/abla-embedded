import "../src/display/spi_blit_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun hardwareLcdBlitTarget(gateAddress: u32, source: u32, staging: u32, little: bool): int =
    esp32s3LcdBlitRgb565(peripheralGateAt(int(gateAddress)),u32(41),2,spiPins(37,35,36),Pin(3),Pin(35),
        lcdViewValue(320,240,0,0,8),0,0,nativeBufferAt(int(source),153600),320,240,640,
        little,nativeBufferAt(int(staging),64),true)
#exportFunction("hardwareLcdBlitTarget", "abla_s3_hardware_lcd_blit_test")
