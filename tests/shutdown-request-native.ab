import "../src/m5stack/shutdown_request_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"
import "abla/build"
var model=0
var calls=0
var failAt=0
var bad=false
var releasing=false
fun m5ShutdownHoldPin(board: M5BoardId): int = if (board == m5BoardPaperS3) 44 else -1
fun m5PmicShutdownWrite(handle: int,kind: int,preserve: bool): bool {
    calls=calls+1
    if (handle != 7 || preserve || kind != (if (model == 0) 2 else if (model == 1) 3 else if (model == 2) 4 else 5)) bad=true
    calls != failAt
}
trusted fun m5ShutdownHubRequest(handle: int,bytes: NativeBuffer): int {
    calls=calls+1
    if (handle != 9 || !bytes.hasAddressRange(0,6)) bad=true
    if (calls == failAt) 260 else 257
}
fun m5PowerOffPulseWrite(handle: int,pin: int,high: bool): bool {
    if (handle != (if (model == 8) 0 else 8) || pin != (if (model == 8) 44 else if (model == 6) 0 else 4) || high != (releasing || (calls & 1) != 0)) bad=true
    calls=calls+1
    calls != failAt
}
@export("abla_shutdown_request_test")
trusted fun shutdownTest(): i32 {
    val record=nativeBufferAt(nativeStaticAllocate(48),48)
    while (model < 10) {
        val board=if (model == 0 || model == 1) m5BoardStackCore2 else if (model == 2) m5BoardStack else
            if (model == 3) m5BoardStopWatch else if (model == 4) m5BoardTab5 else if (model == 5) m5BoardTab5X else
            if (model == 6) m5BoardArduinoNessoN1 else if (model == 7) m5BoardPowerHub else if (model == 8) m5BoardPaperS3 else m5BoardAtomVoice
        val kind=if (model == 0) 2 else if (model == 1) 3 else if (model == 2) 4 else 5
        val owner=M5PmicOpen(7|(kind<<32)|(1<<40))
        failAt=0
        while (failAt <= 10) {
            calls=0; bad=false
            var now=u32(4294967270)
            var status=board.beginShutdownRequestOwned(record,owner,8,9,now,true)
            var polls=0
            while (status == 2 && polls < 22) {
                status=m5ShutdownRequestPoll(record,now)
                now=now+u32(50); polls=polls+1
            }
            val pulse=(model >= 4 && model <= 6) || model == 8
            val maximum=if (model == 9) 0 else if (pulse) 10 else 1
            val failed=failAt > 0 && failAt <= maximum
            val wanted=if (model == 9) 4 else if (!failed) 1 else if (pulse) 6 else if (model == 7) 7 else 5
            if (status != wanted || bad || calls != (if (failed) failAt else maximum)) return i32(1)
            if (model != 9) {
                val before=calls
                if (m5ShutdownRequestPoll(record,now) != status || calls != before) return i32(2)
                if (!failed && record.loadU32(36) != (if (pulse) 2 else if (model == 7) 4 else 1)) return i32(3)
                if (failed && pulse) {
                    releasing=true
                    val edges=record.loadU32(16)
                    if (m5ShutdownRequestReleasePulseOwned(record) != 8 || calls != before+1 || bad || record.loadU32(16) != edges ||
                        m5ShutdownRequestPoll(record,now) != 8 || m5ShutdownRequestReleasePulseOwned(record) != 8 || calls != before+1) return i32(5)
                    releasing=false
                }
            }
            failAt=failAt+1
        }
        model=model+1
    }
    model=4;calls=0;failAt=0;releasing=false
    if (m5BoardTab5.beginShutdownRequestOwned(record,M5PmicOpen(0),8,0,u32(0),true) != 2) return i32(6)
    releasing=true;failAt=2
    if (m5ShutdownRequestReleasePulseOwned(record) != 6 || calls != 2 || m5ShutdownRequestPoll(record,u32(100)) != 6) return i32(7)
    failAt=0
    if (m5ShutdownRequestReleasePulseOwned(record) != 8 || calls != 3 || bad || m5ShutdownRequestPoll(record,u32(200)) != 8) return i32(8)
    releasing=false
    calls=0; record.storeU32(24,0xdeadbeef)
    val axp=M5PmicOpen(7|(2<<32)|(1<<40))
    if (m5BoardStackCoreS3.beginShutdownRequestOwned(record,axp,8,9,u32(0),true) != 3 ||
        m5BoardStackCore2.beginShutdownRequestOwned(record,M5PmicOpen(0),8,9,u32(0),true) != 3 ||
        m5BoardTab5.beginShutdownRequestOwned(record,axp,0,9,u32(0),true) != 3 ||
        m5BoardPowerHub.beginShutdownRequestOwned(record,axp,8,0,u32(0),true) != 3 ||
        m5BoardStackCore2.beginShutdownRequestOwned(record,axp,8,9,u32(0),false) != 3 ||
        calls != 0 || record.loadU32(24) != 0xdeadbeef) return i32(4)
    i32(0)
}
