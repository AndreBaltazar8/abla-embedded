import "../src/m5stack/toughc5_wake_clear.ab"
import "../src/i2c/register_access.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
fun I2cBus.valid(): bool = false
fun I2cBus.device(address: int,frequency: int): I2cDevice = I2cDevice(0)
fun I2cDevice.close(): bool = false
trusted fun I2cDevice.write(bytes: NativeBuffer,count: int): bool { bad=true;return false }
trusted fun I2cDevice.writeRegister(register: int,bytes: NativeBuffer,count: int): bool { bad=true;return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true;return I2cByteResult(0) }
var reads=0
var writes=0
var failures=0
var mode=0
var bad=false
trusted fun I2cDevice.readRegister(register: int,bytes: NativeBuffer,count: int): bool {
    reads=reads+1
    if (this != 8 || register != 2 || writes != 0 || count != (if ((reads&1) == 1) 1 else 5)) bad=true
    if (mode >= 3 && reads == mode-2) return false
    var i=0;while (i < count) { bytes.store(i,if (i == 0) (if (mode == 0) 0 else if (mode == 2) 3 else 1) else i);i=i+1 }
    true
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    val expectedReads=if (mode == 0 || mode == 2) 1 else if (mode >= 3) mode-2 else 4
    if (this != 7 || register != (if (writes == 0) 5 else 63+writes) || value != 0 || reads != expectedReads) bad=true
    val accepted=(failures&(1<<writes)) == 0
    writes=writes+1
    accepted
}
@export("abla_toughc5_wake_clear_test")
trusted fun test(): i32 {
    val scratch=nativeBufferAt(nativeStaticAllocate(24),24)
    while (mode < 7) {
        failures=0
        while (failures < 16) {
            reads=0;writes=0;bad=false;scratch.store(22,77);scratch.store(23,88)
            val result=toughC5ShutdownClearSources(7,8,nativeBufferAt(scratch.addressValue(),22))
            if (result != (256|(15^failures)|(if (mode < 2) 512 else 0)) || writes != 4 || bad ||
                scratch.load(22) != 77 || scratch.load(23) != 88) return i32(1)
            failures=failures+1
        }
        mode=mode+1
    }
    reads=0;writes=0
    if (toughC5ShutdownClearSources(7,8,nativeBufferAt(scratch.addressValue(),21)) != 0 ||
        toughC5ShutdownClearSources(-1,8,scratch) != 0 || toughC5ShutdownClearSources(7,0,scratch) != 0 ||
        reads != 0 || writes != 0) return i32(2)
    return i32(0)
}
