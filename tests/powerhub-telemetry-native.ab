import "../src/power/powerhub_telemetry.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
var rawValue=0
var expectedRegister=48
var fail=false
var calls=0
var bad=false
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult {
    calls=calls+1; if (this != 7 || register != expectedRegister) bad=true
    if (fail) I2cWordResult(0) else I2cWordResult(65536|rawValue)
}
@export("abla_powerhub_telemetry_test")
trusted fun telemetryTest(): i32 {
    val power=PowerHubPower(7)
    while (rawValue <= 65535) {
        val signed=if (rawValue >= 32768) rawValue-65536 else rawValue
        expectedRegister=48
        val voltage=power.batteryMillivoltsChecked()
        expectedRegister=50
        val current=power.batteryMilliampsChecked()
        val charging=power.chargingChecked()
        if (!voltage.valid() || voltage.value() != rawValue || !current.valid() || current.value() != -signed ||
            !charging.valid() || charging.value() != (if (-signed > 10) 1 else 0)) return i32(1)
        expectedRegister=66
        val external=power.externalMilliampsChecked(1)
        if (!external.valid() || external.value() != signed || bad) return i32(2)
        rawValue=rawValue+1
    }
    var mask=0
    rawValue=123
    while (mask < 256) {
        val register=if ((mask&1) != 0) 64 else if ((mask&8) != 0) 68 else if ((mask&32) != 0) 60 else if ((mask&64) != 0) 56 else if ((mask&128) != 0) 52 else -1
        var mode=0
        while (mode < 4) {
            fail=(mode&1) != 0; val voltage=(mode&2) != 0
            calls=0; expectedRegister=register+(if (voltage) 0 else 2)
            val result=power.externalMeasurement(mask,voltage)
            if (result.valid() != (register >= 0 && !fail) || calls != (if (register >= 0) 1 else 0) || bad) return i32(3)
            mode=mode+1
        }
        mask=mask+1
    }
    fail=true; expectedRegister=48
    if (power.batteryMillivoltsChecked().valid()) return i32(4)
    expectedRegister=50
    if (power.batteryMilliampsChecked().valid() || power.chargingChecked().valid() || bad) return i32(5)
    calls=0
    if (PowerHubPower(0).batteryMilliampsChecked().valid() || PowerHubPower(4294967297).batteryMilliampsChecked().valid() ||
        power.externalMillivoltsChecked(-1).valid() || calls != 0) return i32(6)
    i32(0)
}
