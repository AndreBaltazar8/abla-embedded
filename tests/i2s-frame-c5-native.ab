import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/frame_width_c5_sequence.ab"
var selected=0x20
var config=u32(0)
var frame=u32(0)
var writes=0
var drop=0
var busy=false
var bad=false
trusted fun c5I2sClockRead(offset: int): u32 = u32(13)
trusted fun c5I2sClockWrite(offset: int,value: u32): void { bad=true;return }
trusted fun c5I2sRead(offset: int): u32 = if (offset == selected) config else if (offset == selected+8) frame else if (offset == 0x6c) u32(1) else if (offset == 0x14 && busy) u32(1) else u32(0)
trusted fun c5I2sWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes != drop) { if (offset == selected) config=value else if (offset == selected+8) frame=value else bad=true }
    return
}
@export("abla_i2s_frame_c5_test")
trusted fun test(): i32 {
    var direction=0
    while (direction < 2) {
        selected=if (direction == 0) 0x20 else 0x24
        var bits=8
        while (bits <= 32) {
            var slot=bits
            while (slot <= 32) {
                var ws=1
                while (ws <= slot*2) {
                    var shift=0
                    while (shift < 2) {
                        var fault=0
                        while (fault < 5) {
                            config=u32(0xa0602010);frame=u32(0x12345678);writes=0;drop=fault
                            var owner=c5I2sFrameOpenOwned(0,direction == 1,bits,slot,ws,shift == 1,true)
                            if (owner.ready()) {
                                if ((frame&u32(511)) != u32(ws-1) || ((frame>>u32(14))&u32(31)) != u32(bits-1) || ((frame>>u32(19))&u32(255)) != u32(slot-1) || (frame>>u32(27)) != u32(slot-1) || ((config>>u32(13))&u32(1)) != u32(shift)) return i32(1)
                                if ((frame&u32(0x3e00)) != (u32(0x12345678)&u32(0x3e00))) return i32(2)
                            }
                            owner=owner.closeOwned(true);drop=0;owner=owner.closeOwned(true)
                            if (owner.status() != 0 || frame != u32(0x12345678) || config != u32(0xa0602010) || bad) return i32(3)
                            fault=fault+1
                        }
                        shift=shift+1
                    }
                    ws=ws+1
                }
                slot=slot+1
            }
            bits=bits+8
        }
        direction=direction+1
    }
    if (c5I2sFrameWidthWord(12,16,16) != -1 || c5I2sFrameWidthWord(32,16,16) != -1 || c5I2sFrameWidthWord(16,33,16) != -1 || c5I2sFrameWidthWord(16,16,0) != -1 || c5I2sFrameWidthWord(16,16,33) != -1) return i32(4)
    var owner=c5I2sFrameOpenOwned(0,true,16,32,32,true,true)
    val before=writes
    busy=true;owner=owner.closeOwned(true)
    if (owner.status() != 4 || writes != before) return i32(5)
    busy=false;owner=owner.closeOwned(true)
    if (owner.status() != 0) return i32(6)
    return i32(0)
}
