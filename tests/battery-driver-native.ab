import "../src/power/axp192_device.ab"
import "../src/power/axp2101_device.ab"
import "../src/power/bq27220_device.ab"
import "../src/power/m5pm1_device.ab"
import "../src/m5stack/axp_power.ab"
import "abla/runtime/scalar"
import "abla/build"

// Actual driver closures, test-only transport. Every unexpected operation
// fails the test, including resets, writes, delays or extra reads.
type I2cBus = int
type I2cDevice = int
var kind=0
var raw=0
var fail=false
var calls=0
var bad=false
var identityMode=false
var identityValue=3
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    calls=calls+1
    if (!identityMode || register != 3 || this != I2cDevice(7)) bad=true
    I2cByteResult(if (fail) 0 else 256 | identityValue)
}
fun I2cDevice.readRegister24BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun peripheralDelayMilliseconds(value: int): void { bad=true; return }
fun I2cDevice.readRegister16BigEndianChecked(register: int): I2cWordResult {
    calls=calls+1
    if (this != I2cDevice(7) || kind > 1 || register != (if (kind == 0) 120 else 52)) bad=true
    I2cWordResult(if (fail) 0 else 65536 | raw)
}
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult {
    calls=calls+1
    if (this != I2cDevice(7) || kind < 2 || register != (if (kind == 2) 8 else 34)) bad=true
    I2cWordResult(if (fail) 0 else 65536 | raw)
}
trusted fun readBattery(handle: int): I2cWordResult =
    if (kind == 0) Axp192(handle).batteryMillivoltsChecked() else
    if (kind == 1) Axp2101(handle).batteryMillivoltsChecked() else
    if (kind == 2) Bq27220(handle).batteryMillivoltsChecked() else M5Pm1(handle).batteryMillivoltsChecked()
@export("abla_battery_driver_test")
trusted fun batteryDriverTest(): i32 {
    while (kind < 4) {
        raw=0; fail=false
        while (raw <= 65535) {
            calls=0
            val result=readBattery(7)
            val expected=if (kind == 0) ((((raw >>> 8) << 4) | (raw & 15))*11)/10
                else if (kind == 1) raw & 16383 else raw
            if (!result.valid() || result.value() != expected || calls != 1 || bad) return i32(1)
            raw=raw+1
        }
        fail=true; calls=0
        if (readBattery(7).valid() || calls != 1 || bad) return i32(2)
        calls=0
        if (readBattery(0).valid() || calls != 0 || bad) return i32(3)
        kind=kind+1
    }
    identityMode=true
    var boardIndex=0
    while (boardIndex < 2) {
        val board=if (boardIndex == 0) m5BoardStackCore2 else m5BoardStackCoreS3
        identityValue=0
        while (identityValue < 256) {
            fail=false; calls=0
            val power=board.bindAxpPower(I2cDevice(7))
            val accepted=identityValue == 74 || (boardIndex == 0 && identityValue == 3)
            if (power.valid() != accepted || power.status() != (if (accepted) 5 else 4) ||
                power.identity() != identityValue || calls != 1 || bad) return i32(4)
            calls=0; raw=0x1234; kind=if (identityValue == 3) 0 else 1
            val voltage=power.batteryMillivoltsChecked()
            if (voltage.valid() != accepted || calls != (if (accepted) 1 else 0) || bad) return i32(5)
            identityValue=identityValue+1
        }
        fail=true; calls=0
        if (board.bindAxpPower(I2cDevice(7)).status() != 3 || calls != 1 || bad) return i32(6)
        calls=0
        if (board.bindAxpPower(I2cDevice(0)).status() != 2 || calls != 0) return i32(7)
        boardIndex=boardIndex+1
    }
    calls=0
    if (m5BoardAtomVoice.bindAxpPower(I2cDevice(7)).status() != 1 || calls != 0) return i32(8)
    i32(0)
}
