import "../src/m5stack/touch_poll_sequence.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
val storage=nativeStaticAllocate(184)
val scratch=nativeStaticAllocate(80)
var reads=0
var report=1
trusted fun m5TouchPollRead(kind: int,handle: int,snapshot: NativeBuffer,board: M5BoardId): int {
    reads=reads+1
    var i=0
    while (i < 40) { snapshot.store(i,0); i=i+1 }
    if (kind == 1) { snapshot.store(0,1); snapshot.store(4,240) }
    else snapshot.store(3,240)
    return report
}
@export("abla_touch_poll_test")
trusted fun testPoll(): i32 {
    val tracker=touchTrackerAt(storage)
    val snapshot=nativeBufferAt(scratch,40)
    val raw=nativeBufferAt(scratch+40,40)
    var kind=1
    while (kind <= 2) {
        touchTrackerAt(storage)
        report=1
        val pressed=m5BoardToughC5.pollTouchButtonsOwned(kind,1,tracker,snapshot,raw,10,0,0)
        if (!pressed.valid() || pressed.pressed() != 1) return i32(1)
        val before=reads
        if (!m5BoardToughC5.pollTouchButtonsOwned(kind,1,tracker,snapshot,raw,11,1,0).unchanged() || reads != before) return i32(2)
        report=-1
        if (m5BoardToughC5.pollTouchButtonsOwned(kind,1,tracker,snapshot,raw,20,1,0).valid() || tracker.lastMilliseconds() != 10) return i32(3)
        report=-2
        val pending=m5BoardToughC5.pollTouchButtonsOwned(kind,1,tracker,snapshot,raw,30,1,0)
        if (pending.valid() || pending.unchanged() != (kind == 2) || tracker.lastMilliseconds() != 10) return i32(4)
        report=0
        val released=m5BoardToughC5.pollTouchButtonsOwned(kind,1,tracker,snapshot,raw,40,1,0)
        if (!released.valid() || released.pressed() != 0) return i32(5)
        val done=reads
        if (m5BoardToughC5.pollTouchButtonsOwned(kind,1,tracker,snapshot,snapshot,50,0,0).valid() || reads != done) return i32(6)
        kind=kind+1
    }
    i32(0)
}
