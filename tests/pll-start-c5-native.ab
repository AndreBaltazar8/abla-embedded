import "../src/esp32/pll_start_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(48)
var xtal=40
var parent=0
var gate=0
var selector=0
var conf=4
var route=0
var control=0
var pending=0
var writes=0
var failAt=0
var delayed=0
var power=0
var allowed=true
var bad=false
trusted fun c5PllRead(address: int): int {
    if (address == 0x60096110) return xtal<<24
    if (address == 0x60096144) return 0
    if (address == 0x60096128) return parent
    if (address == 0x600af018) return gate
    if (address == 0x600af820) return route
    if (address == 0x600af81c) return selector
    if (address == 0x600af818) {
        if ((gate&4) == 0 || (parent&2) == 0) bad=true
        return conf|(if (allowed && power == 3) 0x1000000 else 0)
    }
    if (address == 0x600af800 || address == 0x600af804) {
        if ((gate&4) == 0 || (parent&2) == 0 || address != (if (route == 0) 0x600af804 else 0x600af800)) bad=true
        if (pending > 0) { pending=pending-1;return control|0x2000000 }
        return control
    }
    bad=true;return 0
}
trusted fun c5PllWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (address == 0x600b00cc) {
        if (value == 0x70000000) power=power|1 else if (value == 0x02000000) power=power|2 else bad=true
    } else if (address == 0x60096128) parent=value
    else if (address == 0x600af018) gate=value
    else if (address == 0x600af81c) selector=value
    else if (address == 0x600af818) conf=value&0xffffff
    else if (address == 0x600af800 || address == 0x600af804) {
        if (pending != 0 || (value&255) != 0x66 || selector != 0xffff7f || (gate&4) == 0 || (parent&2) == 0) bad=true
        val reg=(value>>8)&255
        if (reg > 15) { bad=true;return }
        val bytes=nativeBufferAt(memory+32,16)
        if ((value&0x1000000) != 0) bytes.store(reg,(value>>16)&255)
        control=(value&65535)|(bytes.load(reg)<<16);pending=1
    } else bad=true
    return
}
trusted fun c5AnalogRead(address: int): int = c5PllRead(address)
trusted fun c5AnalogWrite(address: int,value: int): void { c5PllWrite(address,value);return }
trusted fun c5PllDelay(us: int): void { if (us != 10 || !allowed || (conf&8) == 0) bad=true;delayed=delayed+us;return }
@export("abla_pll_start_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,32);val bytes=nativeBufferAt(memory+32,16)
    var mode=0
    while (mode < 16) {
        xtal=if ((mode&1) == 0) 40 else 48;route=if ((mode&2) == 0) 0 else 512
        var fault=0
        while (fault <= 60) {
            // WT power strobes have no readback; do not model undetectable
            // bus loss as a recoverable software failure.
            if (fault != 1 && fault != 2) {
                record.storeU32(0,0);parent=0x100|(if ((mode&4) != 0) 2 else 0);gate=0x80|(if ((mode&8) != 0) 4 else 0)
                selector=0x13579b;conf=0x123404;control=0;pending=0;power=0;writes=0;failAt=fault;delayed=0;bad=false;allowed=false
                var i=0;while (i < 16) { bytes.store(i,0xa5);i=i+1 }
                val result=esp32C5PllStartOwned(record,true,3)
                if (result != 3 && result != 4) return i32(1)
                if (result == 4 && ((gate&4) == 0 || (parent&2) == 0 || delayed != 0)) return i32(2)
                failAt=0;allowed=true
                if (esp32C5PllStartOwned(record,true,3) != 1 || bad || delayed != 10 || power != 3) return i32(3)
                if (bytes.load(2) != 0x51 || bytes.load(3) != (if (xtal == 48) 10 else 12) ||
                    bytes.load(5) != (if (xtal == 48) 0x91 else 0x80) || bytes.load(6) != 0x75 || bytes.load(9) != 0xa7) return i32(4)
                if (parent != (0x100|(if ((mode&4) != 0) 2 else 0)) || gate != (0x80|(if ((mode&8) != 0) 4 else 0)) || selector != 0x13579b || conf != 0x123404) return i32(5)
                val before=writes
                if (esp32C5PllStartOwned(record,true) != 1 || writes != before) return i32(6)
            }
            fault=fault+1
        }
        mode=mode+1
    }
    var teardown=1
    while (teardown <= 5) {
        record.storeU32(0,0);xtal=40;route=0;parent=0x100;gate=0x80;selector=0x13579b
        conf=0x123404;control=0;pending=0;power=0;writes=0;failAt=0;delayed=0;bad=false;allowed=false
        var i=0;while (i < 16) { bytes.store(i,0xa5);i=i+1 }
        if (esp32C5PllStartOwned(record,true,1) != 4) return i32(8)
        allowed=true;failAt=writes+teardown
        if (esp32C5PllStartOwned(record,true) != 3 || record.loadU32(24) != 15+teardown) return i32(9)
        failAt=0
        if (esp32C5PllStartOwned(record,true) != 1 || delayed != 10 || bad || parent != 0x100 || gate != 0x80 || selector != 0x13579b || conf != 0x123404) return i32(10)
        teardown=teardown+1
    }
    record.storeU32(0,0);writes=0;xtal=26
    if (esp32C5PllStartOwned(record,true) != 2 || esp32C5PllStartOwned(record,false) != 2 || esp32C5PllStartOwned(record,true,0) != 2 || writes != 0) return i32(7)
    return i32(0)
}
