import "../src/storage/fat_directory_create.ab"
import "../src/storage/fat_file_open_path.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(8192)
val image=nativeStaticAllocate(2560)
var writes=0
var failAt=0
var bad=false
fun slot(lba: int): int = if (lba == 1) 0 else if (lba == 41) 1 else if (lba == 81) 2 else if (lba == 113) 3 else if (lba == 114) 4 else -1
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    val selected=slot(lba)
    if (selected < 0 && lba != 0) return false
    val source=if (lba == 0) nativeBufferAt(memory+64,512) else nativeBufferAt(image+selected*512,512)
    var i=0;while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool {
    writes=writes+1;val selected=slot(lba)
    if (selected < 0) return false
    if (selected == 2 && source.load(43) == 16) {
        val child=nativeBufferAt(image+1536,512)
        if (child.load(0) != 46 || child.load(32) != 46 || child.load(33) != 46 || child.loadU16(26) != 2 ||
            child.loadU16(58) != 0 || child.load(64) != 0) bad=true
    }
    val output=nativeBufferAt(image+selected*512,512);var i=0
    while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return writes != failAt
}
@export("abla_fat_directory_create_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,32);val reader=nativeBufferAt(memory+32,28);val boot=nativeBufferAt(memory+64,512)
    val work=nativeBufferAt(memory+704,3780);val output=nativeBufferAt(memory+4544,512)
    val name=nativeBufferAt(memory+5120,16);val childName=nativeBufferAt(memory+5152,2)
    val path=nativeBufferAt(memory+5184,32);val handle=nativeBufferAt(memory+576,80)
    val spelling=nativeBufferAt(nativeStaticBytes("records"),7)
    var i=0;while (i < 512) { boot.store(i,0);i=i+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2)
    boot.storeU16(17,512);boot.storeU16(22,40);boot.storeU16(19,10113);boot.storeU16(510,0xaa55)
    i=0;while (i < 7) { name.storeU16(i*2,spelling.load(i));path.storeU16(i*2,spelling.load(i));i=i+1 }
    childName.storeU16(0,97);path.storeU16(14,47);path.storeU16(16,97)
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    val modified=rtcCalendarDateTime(2026,9,9,12,34,56)
    var failure=0
    while (failure <= 5) {
        writes=0;failAt=failure;bad=false;i=0
        while (i < 2560) { nativeBufferAt(image,2560).store(i,255);i=i+1 }
        i=0;while (i < 512) { nativeBufferAt(image+1024,512).store(i,0);i=i+1 }
        var copy=0;while (copy < 2) {
            val fat=nativeBufferAt(image+copy*512,512);fat.storeU16(4,0);fat.storeU16(6,0);copy=copy+1
        }
        val volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,output)
        val created=volume.createDirectory(u32(7),0,name,7,1,8,64,modified,work)
        if (bad || writes != (if (failure == 0) 5 else failure) || created.status() !=
            (if (failure == 0) 1 else if (failure <= 3) 17 else if (failure == 4) 21 else 8)) return i32(2)
        if (failure != 0 && state.loadU32(12) != 3) return i32(3)
        if (failure == 0) {
            val directory=nativeBufferAt(image+1024,512)
            if (directory.load(43) != 16 || directory.loadU16(58) != 2 || directory.loadU32(60) != 0) return i32(4)
            val before=writes
            if (volume.createDirectory(u32(7),0,name,7,1,8,64,modified,work).status() != 3 || writes != before) return i32(5)
            if (volume.createLongAuto(u32(7),2,childName,1,1,8,64,modified,work).status() != 1 ||
                !fatFileInitializeFresh(handle,volume,u32(7))) return i32(6)
            val file=fatFileOpenPathUtf16(handle,u32(7),path,9,64,work)
            if (file.status() != 1 || file.readAt(u32(7),0,1,64,output,work).status() != 2 || !file.close(u32(7))) return i32(7)
            // A nested directory stores its actual parent's cluster in '..'.
            if (volume.createDirectory(u32(7),2,name,7,1,8,64,modified,work).status() != 1 ||
                nativeBufferAt(image+2048,512).loadU16(58) != 2) return i32(8)
        }
        if (!volume.invalidate(u32(7))) return i32(9)
        failure=failure+1
    }
    return i32(0)
}
