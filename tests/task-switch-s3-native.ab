import "../src/esp32/task_switch_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var phase=0
var failure=0
var active=256
var bad=false
var expectedCore=0
var expectedLevel=1
fun checkArguments(current: NativeBuffer,binding: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,core: int): void {
    if (current.addressValue() != 64 || owners.addressValue() != 128 || core != expectedCore ||
        frame.addressValue() != (if (binding.addressValue() == 256) 1024 else 2048)) bad=true
    return
}
fun esp32S3TaskSwitchDetach(current: NativeBuffer,binding: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,core: int): bool {
    checkArguments(current,binding,owners,frame,core)
    if (active != binding.addressValue()) bad=true
    if (phase == 0) {
        phase=1
        if (failure == 1) return false
    } else {
        if (phase != 3) bad=true
        phase=4
        if (failure == 5) return false
    }
    active=0; true
}
fun esp32S3TaskSwitchAttach(current: NativeBuffer,binding: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,core: int): bool {
    checkArguments(current,binding,owners,frame,core)
    if (active != 0) bad=true
    if (binding.addressValue() == 512) {
        if (phase != 1) bad=true
        phase=2
        if (failure == 2 || failure == 4) return false
    } else {
        if (phase != 2 && phase != 4) bad=true
        phase=5
        if (failure == 4 || failure == 6) return false
    }
    active=binding.addressValue(); true
}
fun esp32S3TaskSwitchSelect(interrupted: NativeBuffer,resume: NativeBuffer,core: int,level: int): bool {
    if (phase != 2 || active != 512 || interrupted.addressValue() != 1024 || resume.addressValue() != 2048 || core != expectedCore || level != expectedLevel) bad=true
    phase=3
    failure == 0
}
@export("abla_task_switch_test")
fun switchTest(): i32 {
    val current=nativeBufferAt(64,8)
    val owners=nativeBufferAt(128,16)
    val previous=nativeBufferAt(256,16)
    val next=nativeBufferAt(512,16)
    val interrupted=nativeBufferAt(1024,192)
    val resume=nativeBufferAt(2048,192)
    var profile=0
    while (profile < 42) {
        expectedCore=profile & 1; expectedLevel=(profile/2)%3+1; failure=profile/6
        phase=0; active=256; bad=false
        val result=esp32S3TaskSwitchOwned(current,previous,next,owners,interrupted,resume,expectedCore,expectedLevel)
        val expected=if (failure == 0) 1 else if (failure == 1) -1 else if (failure == 2) -2 else if (failure == 3) -3 else -4
        if (result != expected || bad) return i32(1+profile)
        if (failure == 0 && active != 512) return i32(50)
        if (failure > 0 && failure < 4 && active != 256) return i32(51)
        phase=0
        if (esp32S3TaskSwitchOwned(current,previous,previous,owners,interrupted,resume,expectedCore,expectedLevel) != 0 || phase != 0) return i32(52)
        profile=profile+1
    }
    i32(0)
}
