import "../src/m5stack/detect_c3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var pin=20
var mux=0
var route=0
var enable=0
var savedMux=0
var savedRoute=0
var savedEnable=0
var hold=0
var high=false
var writes=0
var reads=0
var delays=0
var bad=false
var dropAt=-1
fun esp32C3ProbeRead(address: int): int {
    reads=reads+1
    if (address == 0x600080D4) return if ((hold&1)!=0) 1<<pin else 0
    if (address == 0x6000808C) return if ((hold&2)!=0) 0x8000 else 0
    if (address == 0x60009004+pin*4) return mux
    if (address == 0x60004554+pin*4) return route
    if (address == 0x60004020) return enable
    if (address == 0x6000403C) {
        if (delays != 1 || writes != 3) bad=true
        return if (high) 1<<pin else 0
    }
    bad=true; 0
}
fun esp32C3ProbeWrite(address: int,value: int): void {
    val expected=if (writes == 0) 0x60004028 else if (writes == 1 || writes == 4) 0x60004554+pin*4 else if (writes == 2 || writes == 3) 0x60009004+pin*4 else if ((savedEnable&(1<<pin))!=0) 0x60004024 else 0x60004028
    if (writes >= 6 || address != expected) bad=true
    if (writes == dropAt) { writes=writes+1;return }
    if (address == 0x60004028) { if (value != (1<<pin)) bad=true; enable=enable&~value }
    else if (address == 0x60004024) { if (value != (1<<pin)) bad=true; enable=enable|value }
    else if (address == 0x60009004+pin*4) mux=value
    else if (address == 0x60004554+pin*4) route=value
    else bad=true
    writes=writes+1; return
}
fun esp32C3ProbeDelay(): void {
    if ((enable&(1<<pin)) != 0 || mux != ((savedMux & ~0x7180)|0x1280) ||
        route != ((savedRoute & ~0x400)|0x200) || writes != 3) bad=true
    delays=delays+1; return
}
@export("abla_board_detect_c3_test")
fun detectTest(): i32 {
    pin=6
    while (pin <= 21) {
        var mode=0
        while (mode < 64) {
            savedMux=0x80008000|((mode*131)&0x7FFF); savedRoute=0xA0000000|((mode*37)&0x7FF)
            savedEnable=if ((mode&1)!=0) 0x3FFFFFF else 0x3FFFFFF&~(1<<pin)
            mux=savedMux; route=savedRoute; enable=savedEnable
            high=(mode&2)!=0; hold=(mode>>>2)&3
            writes=0; reads=0; delays=0; bad=false
            val result=esp32C3GpioPulldownProbeOwned(pin,true)
            if (result != (if (hold != 0) -2 else if (high) 1 else 0) || mux != savedMux || route != savedRoute || enable != savedEnable ||
                writes != (if (hold != 0) 0 else 6) || delays != (if (hold != 0) 0 else 1) || bad) return i32(1)
            mode=mode+1
        }
        pin=pin+1
    }
    pin=20; hold=0; reads=0; writes=0; delays=0; bad=false
    if (m5DetectCurrentEsp32C3Owned(m5BoardStampC3,false) != m5BoardStampC3 ||
        m5DetectCurrentEsp32C3Owned(m5BoardUnknown,false) != m5BoardUnknown || reads != 0 || writes != 0) return i32(2)
    savedEnable=0; savedMux=0; savedRoute=0; mux=0; route=0; enable=0; high=false
    if (m5DetectCurrentEsp32C3Owned(m5BoardUnknown,true) != m5BoardStampC3U || bad) return i32(3)
    writes=0; delays=0; high=true
    if (m5DetectCurrentEsp32C3Owned(m5BoardUnknown,true) != m5BoardUnknown || bad) return i32(4)
    reads=0; writes=0
    if (esp32C3GpioPulldownProbeOwned(5,true) != -1 || esp32C3GpioPulldownProbeOwned(22,true) != -1 || reads != 0 || writes != 0) return i32(5)
    var failure=0
    while (failure < 6) {
        pin=20;hold=0;savedMux=0;savedRoute=0;savedEnable=1<<20
        mux=savedMux;route=savedRoute;enable=savedEnable
        writes=0;reads=0;delays=0;bad=false;dropAt=failure
        val result=m5DetectCurrentEsp32C3CheckedOwned(m5BoardUnknown,true)
        if (result != (if (failure < 3) -3 else -4) || writes != 6 || delays != (if (failure < 3) 0 else 1) || bad) return i32(6)
        if (failure < 3 && (mux != savedMux || route != savedRoute || enable != savedEnable)) return i32(7)
        failure=failure+1
    }
    dropAt=-1;reads=0;writes=0
    if (m5DetectCurrentEsp32C3CheckedOwned(m5BoardUnknown,false) != -1 || reads != 0 || writes != 0) return i32(8)
    hold=1
    if (m5DetectCurrentEsp32C3CheckedOwned(m5BoardUnknown,true) != -2 || writes != 0) return i32(9)
    i32(0)
}
