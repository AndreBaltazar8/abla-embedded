import "../src/i2c/results.ab"
import "../src/m5stack/toughc5_buzzer.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var profile=0
var seen=0
var bad=false
var delays=0
var pendingDelay=false
var pwmAttempts=0
var gpioAttempts=0
var normalizedCalls=0
var lastSlot=-1
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true; return I2cWordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun operation(slot: int): bool {
    if (slot <= lastSlot || pendingDelay) bad=true
    lastSlot=slot
    seen=seen|(1<<slot)
    val ok=(profile&(1<<slot)) != 0
    pendingDelay= !ok && (slot == 0 || slot == 1 || slot == 8 || slot == 9)
    ok
}
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool {
    if (this != 9 || register != 50 || value != 0 || pwmAttempts >= 3 || normalizedCalls != 0) bad=true
    val slot=pwmAttempts
    pwmAttempts=pwmAttempts+1
    operation(slot)
}
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    if (this != 9 || pwmAttempts == 0) bad=true
    if (normalizedCalls < 4) {
        val n=normalizedCalls
        val expectedReg=if (n == 0) 19 else if (n == 1) 21 else if (n == 2) 17 else 16
        if (register != expectedReg || mask != (if (n == 1) 3 else 16) || value != (if (n == 3) 16 else 0)) bad=true
        normalizedCalls=normalizedCalls+1
        return operation(3+n)
    }
    if (register != 23 || mask != 3) bad=true
    if (value == 3) {
        if ((profile&7) == 0 || (profile&120) != 120 || gpioAttempts != 0) bad=true
        return operation(7)
    }
    if (value != 0 || gpioAttempts >= 3) bad=true
    val slot=8+gpioAttempts
    gpioAttempts=gpioAttempts+1
    operation(slot)
}
fun peripheralDelayMilliseconds(ms: int): void {
    if (ms != 10 || !pendingDelay) bad=true
    pendingDelay=false
    delays=delays+1
    return
}
fun firstSuccess(bits: int): int = if ((bits&1) != 0) 1 else if ((bits&2) != 0) 2 else 3
@export("abla_tough_buzzer_test")
trusted fun buzzerTest(): i32 {
    val pmic=M5PmicOpen(9|(5<<32)|(1<<40))
    profile=0
    while (profile < 2048) {
        seen=0; bad=false; delays=0; pendingDelay=false
        pwmAttempts=0; gpioAttempts=0; normalizedCalls=0; lastSlot=-1
        val result=m5BoardToughC5.configureToughBuzzer(pmic)
        val stopped=(profile&7) != 0
        val normalized=(profile&120) == 120
        val special=stopped && normalized
        val ready=special && (profile&128) != 0
        val fallback= !ready
        val gpioOk=(profile&1792) != 0
        val expectedStatus=if (ready) 1 else if (normalized && gpioOk) 2 else 3
        val pwms=firstSuccess(profile&7)
        val gpios=if (fallback) firstSuccess((profile>>>8)&7) else 0
        val expectedSeen=((1<<pwms)-1)|120|(if (special) 128 else 0)|(((1<<gpios)-1)<<8)
        if (result.status() != expectedStatus || result.valid() != ready ||
            result.silentConfigured() != (expectedStatus == 1 || expectedStatus == 2) ||
            result.pwmStopped() != stopped || result.pinsNormalized() != normalized ||
            seen != expectedSeen || pwmAttempts != pwms || gpioAttempts != gpios ||
            normalizedCalls != 4 || delays != pwms-1+(if (fallback) gpios-1 else 0) ||
            pendingDelay || bad) return i32(1)
        profile=profile+1
    }
    seen=0
    if (m5BoardCoreMatrix.configureToughBuzzer(pmic).status() != 5 ||
        m5BoardToughC5.configureToughBuzzer(M5PmicOpen(0)).status() != 4 ||
        m5BoardToughC5.configureToughBuzzer(M5PmicOpen(9|(3<<32)|(1<<40))).status() != 4 ||
        seen != 0) return i32(2)
    i32(0)
}
