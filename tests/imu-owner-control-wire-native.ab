import "./pm1-imu-owner-wire-native.ab"
import "../src/m5stack/imu_owner_control.ab"
@export("abla_imu_owner_control_wire_test")
trusted fun testOwnerControls(): i32 {
    wireSeed()
    val owner=m5Pm1ControlAt(nativeBufferAt(retainedImuParent,76))
    val imu=m5ImuOwnerAt(nativeBufferAt(retainedImuMemory,36))
    val r=nativeBufferAt(pm1ImuRegisters,256)
    val bus=i2cSoftwareMaster(0,1,5,8)
    if (!owner.initialize() || !imu.initialize() || owner.openOwned(bus|0,m5BoardStopWatch,true,true) != 1) return i32(1)
    val unready=ackCount
    if (imu.sleepOwned(true) != M5ImuControlResult(2) || imu.setInterruptActiveHighOwned(true,true) != M5ImuControlResult(2) || ackCount != unready) return i32(2)
    var at=0;while (at < 256) { r.store(at,0);at=at+1 }
    r.store(117,25);pm1ImuPresent=true
    if (owner.openRetainedImuPreparedOwned(imu,true) != 1) return i32(3)
    val before=ackCount
    if (imu.sleepOwned(false) != M5ImuControlResult(2) || imu.setInterruptActiveHighOwned(true,false) != M5ImuControlResult(2) || ackCount != before) return i32(4)
    var operation=0
    while (operation < 3) {
        val limit=if (operation == 0) 3 else 6
        var fault=0
        while (fault <= limit) {
            var commit=0
            while (commit < 2) {
                r.store(107,1);r.store(55,if (operation == 2) 118 else 246)
                val start=ackCount
                nackAt=if (fault == 0) 0 else start+fault
                pm1ImuNackAfterCommit=commit == 1
                val result=if (operation == 0) imu.sleepOwned(true) else imu.setInterruptActiveHighOwned(operation == 1,true)
                val changed=fault == 0 || (commit == 1 && fault == limit)
                val expectedPower=if (operation == 0 && changed) 64 else 1
                val expectedIrq=if (operation == 2) (if (changed) 246 else 118) else if (operation == 1 && changed) 118 else 246
                if (result != M5ImuControlResult(if (fault == 0) 1 else 4) ||
                    ackCount-start != (if (fault == 0) limit else fault) || r.load(107) != expectedPower ||
                    r.load(55) != expectedIrq || !owner.imuRetained() || imu.status() != 1 || bad) return i32(5)
                commit=commit+1
            }
            fault=fault+1
        }
        operation=operation+1
    }
    nackAt=0;pm1ImuNackAfterCommit=false
    // Unsupported dispatch is checked without inventing a register write.
    val original=imu.primary()|0
    var kind=4
    while (kind <= 5) {
        val alternate=(original&~((7<<32)|(127<<35)))|(kind<<32)|((if (M5ImuKind(kind) == m5ImuSh200q) 108 else 104)<<35)
        imu.buffer().storeU32(8,alternate&0xffffffff);imu.buffer().storeU32(12,alternate>>>32)
        val start=ackCount
        if (imu.sleepOwned(true) != M5ImuControlResult(3) || imu.setInterruptActiveHighOwned(true,true) != M5ImuControlResult(3) || ackCount != start) return i32(6)
        kind=kind+1
    }
    imu.buffer().storeU32(8,original&0xffffffff);imu.buffer().storeU32(12,original>>>32)
    if (!owner.closeRetainedImuOwned(imu,true) || !owner.closeOwned(true) || !bus.close() || pads != 0 || bad) return i32(7)
    return i32(0)
}
