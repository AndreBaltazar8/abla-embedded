import "../src/esp32/i2c/controller_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var step=0
var initial=0
var filter=0
var bad=false
fun c5I2cControllerLoad(address: int): int {
    step=step+1
    val expected=if (step == 1 || step == 20) 0x60004004 else if (step == 3 || step == 5) 0x60004018 else 0x60004050
    if (address != expected || (step != 1 && step != 3 && step != 5 && step != 8 && step != 20)) bad=true
    if (step == 20) (initial&~0x1FFB)|0x110 else if (step == 5) (initial&~0x4400)|0x4000 else initial
}
fun c5I2cControllerStore(address: int,value: int): void {
    step=step+1
    val expectedAddress=if (step == 2 || step == 21) 0x60004004 else if (step == 4 || step == 6 || step == 7) 0x60004018 else if (step == 9) 0x60004050 else if (step == 10) 0x60004028 else if (step == 11) 0x60004024 else 0x60004058+(step-12)*4
    val fifo=(initial&~0x4400)|0x4000
    val expectedValue=if (step == 2) (initial&~0x1FFB)|0x110 else if (step == 4) fifo else if (step == 6) fifo|12288 else if (step == 7) fifo&~12288 else if (step == 9) (initial&~1023)|(if (filter == 0) 0 else filter|(filter<<4)|768) else if (step == 10) 0 else if (step == 11) 0x3FFFF else if (step == 21) (initial&~0x1FFB)|0x910 else 8192
    if (address != expectedAddress || value != expectedValue) bad=true
    return
}
@export("abla_c5_i2c_controller_test")
trusted fun controllerTest(): i32 {
    var profile=0
    while (profile < 4096) {
        filter=profile&15
        initial=(profile/16)*0x01010101
        step=0; bad=false
        if (!esp32C5I2cInitializeControllerOwned(0,filter) || step != 21 || bad) return i32(1)
        profile=profile+1
    }
    step=0
    if (esp32C5I2cInitializeControllerOwned(1,7) || esp32C5I2cInitializeControllerOwned(0,-1) ||
        esp32C5I2cInitializeControllerOwned(0,16) || step != 0) return i32(2)
    i32(0)
}
