import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/clock_route_c5_sequence.ab"
var tx=u32(0)
var rx=u32(0)
var clock=u32(0)
var bus=u32(13)
var writes=0
var drop=0
var busy=false
var bad=false
trusted fun c5I2sClockRead(offset: int): u32 = if (offset == 0) bus else if (offset == 12) clock else u32(0x400000)
trusted fun c5I2sClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (offset != 12) bad=true
    if (writes != drop) clock=value
    return
}
trusted fun c5I2sRead(offset: int): u32 = if (offset == 0x24) tx else if (offset == 0x20) rx else if (offset == 0x6c) u32(1) else if (busy) u32(1) else u32(0)
trusted fun c5I2sWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes != drop) { if (offset == 0x24) tx=value else if (offset == 0x20) rx=value else bad=true }
    return
}
@export("abla_i2s_clock_route_c5_test")
trusted fun test(): i32 {
    var direction=0
    while (direction < 2) {
        var old=0
        while (old < 128) {
            var divisor=1
            while (divisor <= 64) {
                var fault=0
                while (fault < 5) {
                    val original=u32(0x80000010)|(u32(old&63)<<u32(21))
                    val originalClock=u32(0xa5403210)|(u32(old>>>6)<<u32(23))
                    tx=original;rx=original;clock=originalClock;writes=0;drop=fault
                    var owner=c5I2sClockRouteOpenOwned(0,direction == 0,divisor,true)
                    if (owner.ready() && ((clock&u32(0x800000)) != (if (direction == 0) u32(0) else u32(0x800000)) || ((if (direction == 0) tx else rx)&u32(0x7e00000)) != (u32(divisor-1)<<u32(21)))) return i32(1)
                    owner=owner.closeOwned(true);drop=0;owner=owner.closeOwned(true)
                    if (owner.status() != 0 || tx != original || rx != original || clock != originalClock || bad) return i32(2)
                    fault=fault+1
                }
                divisor=divisor+1
            }
            old=old+1
        }
        direction=direction+1
    }
    var owner=c5I2sClockRouteOpenOwned(0,true,3,true)
    val before=writes
    busy=true;owner=owner.closeOwned(true)
    if (owner.status() != 4 || writes != before) return i32(3)
    busy=false;bus=u32(0);owner=owner.closeOwned(true)
    if (owner.status() != 3 || writes != before) return i32(4)
    bus=u32(13);owner=owner.closeOwned(true)
    if (owner.status() != 0) return i32(5)
    writes=0
    if (c5I2sClockRouteOpenOwned(1,true,3,true).status() != 2 || c5I2sClockRouteOpenOwned(0,true,0,true).status() != 2 || c5I2sClockRouteOpenOwned(0,true,65,true).status() != 2 || c5I2sClockRouteOpenOwned(0,true,3,false).status() != 2 || writes != 0) return i32(6)
    return i32(0)
}
