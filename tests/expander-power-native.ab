import "../src/m5stack/expander_power_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var trace=0
var fail=0
var wanted=false
var bad=false
var referenceCalls=0
var referenceTrace=0
fun step(handle: int,pin: int,m5: bool,code: int): bool {
    calls=calls+1
    trace=(trace*131+handle*100+pin*10+code+(if (m5) 1000 else 0))&2147483647
    calls != fail
}
fun expanderPowerPull(handle: int,pin: int,enabled: bool): bool {
    if (enabled != wanted) bad=true
    step(handle,pin,false,1)
}
fun expanderPowerDrive(handle: int,pin: int,m5: bool): bool = step(handle,pin,m5,2)
fun expanderPowerDirection(handle: int,pin: int,m5: bool): bool = step(handle,pin,m5,3)
fun expanderPowerLatch(handle: int,pin: int,m5: bool,enabled: bool): bool {
    if (enabled != wanted) bad=true
    step(handle,pin,m5,4)
}
fun reference(handle: int,pin: int,mode: int): int {
    var code=if (mode == 2) 1 else if (mode == 4) 4 else 2
    while (code <= 4) {
        referenceCalls=referenceCalls+1
        referenceTrace=(referenceTrace*131+handle*100+pin*10+code+(if (mode == 1) 1000 else 0))&2147483647
        if (referenceCalls == fail) return code+4
        code=if (code == 1) 4 else code+1
    }
    1
}
@export("abla_expander_power_test")
fun powerTest(): i32 {
    var profile=0
    while (profile < 40960) {
        val ports=profile & 511
        wanted=(profile & 512) != 0; fail=(profile/1024)%8
        val index=profile/8192
        val board=if (index == 0) m5BoardTab5 else if (index == 1) m5BoardTab5X else
            if (index == 2) m5BoardCoreP4X else if (index == 3) m5BoardCoreMatrix else m5BoardArduinoNessoN1
        val allowed=if (index == 0 || index == 2) 33 else if (index == 1) 289 else 1
        referenceCalls=0; referenceTrace=0
        var status=if ((ports & ~allowed) != 0) 4 else 1
        var completed=0
        if (status == 1 && (ports & 1) != 0) {
            status=reference(if (index == 4) 8 else 7,if (index == 2 || index == 3) 4 else 2,
                if (index < 2) 2 else if (index == 4) 4 else 1)
            if (status == 1) completed=1
        }
        if (status == 1 && (ports & 256) != 0) {
            status=reference(7,3,3)
            if (status == 1) completed=completed|256
        }
        if (status == 1 && (ports & 32) != 0) {
            status=reference(if (index < 2) 8 else 7,if (index < 2) 3 else 1,if (index < 2) 2 else 1)
            if (status == 1) completed=completed|32
        }
        calls=0; trace=0; bad=false
        val result=board.setExpanderPowerOwned(7,8,ports,wanted)
        if (result.status() != status || result.appliedPorts() != completed || calls != referenceCalls || trace != referenceTrace || bad) return i32(1)
        profile=profile+1
    }
    calls=0
    if (m5BoardTab5X.setExpanderPowerOwned(7,0,289,true).status() != 3 ||
        m5BoardTab5.setExpanderPowerOwned(0,8,1,true).status() != 3 ||
        m5BoardCoreP4X.setExpanderPowerOwned(4294967296,8,1,true).status() != 3 ||
        m5BoardArduinoNessoN1.setExpanderPowerOwned(7,-1,1,true).status() != 3 ||
        m5BoardTab5.setExpanderPowerOwned(7,8,-1,true).status() != 4 ||
        m5BoardAtomVoice.setExpanderPowerOwned(7,8,1,true).status() != 2 || calls != 0) return i32(2)
    fail=0; wanted=true; bad=false
    if (!m5BoardTab5.setExpanderPowerOwned(0,8,32,true).valid() ||
        !m5BoardArduinoNessoN1.setExpanderPowerOwned(0,8,1,true).valid() || bad) return i32(3)
    i32(0)
}
