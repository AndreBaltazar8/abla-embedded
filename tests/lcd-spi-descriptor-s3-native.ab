import "../src/m5stack/display_spi_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun lcdSpiDescriptorTest(): int {
    val lcd = m5BoardStackCoreS3.spiDisplay()
    if (!lcd.valid() || !m5BoardStackCoreS3SE.spiDisplay().valid() ||
        lcd.peripheral() != 2 || lcd.pins() != spiPins(37,35,36) ||
        lcd.chipSelectPin() != Pin(3) || lcd.dataCommandPin() != Pin(35) || !lcd.sharedDataCommand()) return 1
    if (m5BoardAtomS3.spiDisplay().valid() || m5BoardStackCore2.spiDisplay().valid() ||
        m5BoardStickC.spiDisplay().valid() || SpiLcd(0).valid() || SpiLcd(lcd | (1 << 50)).valid()) return 2
    var peripheral = -1
    while (peripheral <= 256) {
        if (spiLcd(peripheral,spiPins(37,35,36),Pin(3),Pin(35),true).valid() !=
            (peripheral == 2 || peripheral == 3)) return 3
        peripheral = peripheral + 1
    }
    if (spiLcd(2,SpiPins(spiPins(37,35,36) | (1 << 24)),Pin(3),Pin(35),true).valid() ||
        spiLcd(2,spiPins(37,35,36),Pin(259),Pin(35),true).valid() ||
        spiLcd(2,spiPins(37,35,36),Pin(3),Pin(291),true).valid() ||
        spiLcd(2,spiPins(37,35,36),Pin(3),Pin(35),false).valid()) return 4
    // Invalid descriptor rejects before backend/gate access, even when the
    // rest of the arguments are unusable. No GPIO or MMIO in this fixture.
    if (SpiLcd(0).blitRgb565(peripheralGateAt(0),u32(1),lcdViewValue(1,1,0,0,0),
        0,0,nativeBufferAt(0,0),1,1,2).status() != 3) return 5
    0
}
#exportFunction("lcdSpiDescriptorTest", "abla_lcd_spi_descriptor_test")
