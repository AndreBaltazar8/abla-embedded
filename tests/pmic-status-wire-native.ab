import "./pm1-control-wire-native.ab"
import "../src/m5stack/pmic_status.ab"
@export("abla_pmic_status_wire_test")
trusted fun testPmicStatus(): i32 {
    wireSeed()
    val bus=i2cSoftwareMaster(0,1,5,8);val r=nativeBufferAt(chargeRegisters,256)
    var kind=2
    while (kind <= 6) {
        chargeAddress=if (kind < 4) 52 else if (kind == 4) 117 else if (kind == 5) 111 else 73
        val device=bus.device(chargeAddress,400000)
        val pmic=M5PmicOpen((device|0)|(kind<<32)|(1<<40))
        if (!device.valid()) return i32(1)
        var raw=0
        while (raw < 256) {
            var full=0
            while (full < 2) {
                val reg=if (kind == 2) 0 else if (kind == 3) 1 else if (kind == 4) 112 else 8
                r.store(reg,raw);r.store(113,165|(full<<3))
                val limit=if (kind == 5) 0 else if (kind == 4) 6 else 3
                var fault=0
                while (fault <= limit) {
                    val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                    val result=pmic.readChargingOwned(true)
                    val expected=if (kind == 2) (raw&4) != 0 else if (kind == 3) ((raw>>>5)&3) == 1
                        else if (kind == 4) (raw&8) != 0 && full == 0 else ((raw>>>3)&3) == 1 || ((raw>>>3)&3) == 2
                    if (result.status() != (if (kind == 5) 3 else if (fault == 0) 1 else 4) ||
                        result.valid() != (kind != 5 && fault == 0) || result.value() != (kind != 5 && fault == 0 && expected) ||
                        ackCount-before != (if (fault == 0) limit else fault) || r.load(reg) != raw || r.load(113) != (165|(full<<3)) || bad || mode != 0) return i32(2)
                    fault=fault+1
                }
                full=full+1
            }
            val reg=if (kind == 2) 1 else 0
            r.store(reg,raw)
            val limit=if (kind < 4) 3 else 0
            var fault=0
            while (fault <= limit) {
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                val result=pmic.readBatteryPresenceOwned(true)
                if (result.status() != (if (kind >= 4) 3 else if (fault == 0) 1 else 4) ||
                    result.value() != (kind < 4 && fault == 0 && (raw&(if (kind == 2) 32 else 8)) != 0) ||
                    ackCount-before != (if (fault == 0) limit else fault) || r.load(reg) != raw || bad) return i32(3)
                fault=fault+1
            }
            raw=raw+1
        }
        val before=ackCount
        if (pmic.readChargingOwned(false).status() != 2 || pmic.readBatteryPresenceOwned(false).status() != 2 || ackCount != before) return i32(4)
        nackAt=0
        if (!device.close()) return i32(5)
        if (kind != 5 && (pmic.readChargingOwned(true).status() != 4 || ackCount != before)) return i32(6)
        kind=kind+1
    }
    if (M5PmicOpen(0).readChargingOwned(true).status() != 2 || M5PmicOpen(0).readBatteryPresenceOwned(true).status() != 2 || !bus.close() || pads != 0 || bad) return i32(7)
    return i32(0)
}
