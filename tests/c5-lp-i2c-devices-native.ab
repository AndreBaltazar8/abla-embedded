import "../src/esp32/i2c/lp_devices_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(128)
trusted fun c5LpI2cBusAbortSetup(): int = 7
trusted fun c5LpI2cBusSetup(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int = 7
trusted fun c5LpI2cBusTeardown(sda: int,scl: int): int = 7
@export("abla_c5_lp_i2c_devices_test")
trusted fun devicesTest(): i32 {
    val state=esp32C5LpI2cBusStateAt(nativeBufferAt(storage,64))
    var address=0
    while (address < 128) {
        state.initialize(); state.buffer().storeU32(8,2); state.buffer().storeU32(12,1); state.buffer().storeU32(28,40000000)
        val pool=i2cInitializeDeviceSlots(storage+64,2)
        if (state.deviceOwned(pool,1,u32(7),address,400000) != 0) return i32(1)
        val first=state.deviceOwned(pool,2,u32(7),address,400000)
        val second=state.deviceOwned(pool,2,u32(7),address,100000)
        if (first == 0 || second == 0 || first == second ||
            pool.resolve(first) != esp32S3I2cDeviceKey(1,address,400000,2) ||
            state.deviceOwned(pool,2,u32(7),address,400000) != 0) return i32(2)
        nativeAddressStoreU32(storage,0,9)
        if (state.setDeviceFrequencyOwned(pool,u32(7),first,100000)) return i32(10)
        nativeAddressStoreU32(storage,0,0)
        if (!state.setDeviceFrequencyOwned(pool,u32(7),first,200000) ||
            pool.resolve(first) != esp32S3I2cDeviceKey(1,address,200000,2) ||
            pool.resolve(second) != esp32S3I2cDeviceKey(1,address,100000,2) ||
            state.setDeviceFrequencyOwned(pool,u32(7),first,0) ||
            state.setDeviceFrequencyOwned(pool,u32(7),first,1000001)) return i32(11)
        nativeAddressStoreU32(storage+64,0,9)
        if (state.setDeviceFrequencyOwned(pool,u32(7),first,100000)) return i32(12)
        nativeAddressStoreU32(storage+64,0,0)
        nativeAddressStoreU32(storage,0,9)
        if (state.closeDeviceOwned(pool,u32(7),first) || pool.resolve(first) == 0) return i32(3)
        nativeAddressStoreU32(storage,0,2147483648)
        if (state.setDeviceFrequencyOwned(pool,u32(7),first,100000)) return i32(13)
        if (state.deviceOwned(pool,2,u32(7),address,400000) != 0 || !state.closeDeviceOwned(pool,u32(7),first)) return i32(4)
        if (atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(0x80000000) || pool.resolve(first) != 0) return i32(5)
        nativeAddressStoreU32(storage,0,0); state.buffer().storeU32(8,3)
        if (state.setDeviceFrequencyOwned(pool,u32(7),second,200000) ||
            pool.resolve(second) != esp32S3I2cDeviceKey(1,address,100000,2)) return i32(14)
        if (!state.closeDeviceOwned(pool,u32(7),second) || state.closeDeviceOwned(pool,u32(7),second)) return i32(6)
        val replacement=state.deviceOwned(pool,3,u32(7),address,400000)
        if (replacement == 0 || replacement == first || replacement == second || pool.resolve(first) != 0) return i32(7)
        if (state.deviceOwned(pool,3,u32(7),128,400000) != 0 || state.deviceOwned(pool,3,u32(7),address,0) != 0) return i32(8)
        address=address+1
    }
    val pool=i2cInitializeDeviceSlots(storage+64,2)
    val foreign=pool.allocate(esp32S3I2cDeviceKey(0,73,100000,3))
    if (foreign == 0 || state.closeDeviceOwned(pool,u32(7),foreign) || pool.resolve(foreign) == 0) return i32(10)
    state.buffer().storeU32(56,2)
    if (state.devicePoolValid(i2cDeviceSlotsAt(storage+52))) return i32(9)
    i32(0)
}
