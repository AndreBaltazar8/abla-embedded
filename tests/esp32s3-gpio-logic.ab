import "../src/esp32/gpio/s3_logic.ab"

fun main(): int {
    var pin = -1
    while (pin < 51) {
        val valid = pin >= 0 && pin < 49 && (pin < 22 || pin > 25)
        val expected = if (valid) 0x60009004 + pin * 4 else 0
        if (esp32S3GpioMuxAddress(pin) != expected) return 1
        var drive = 0
        while (drive < 4) {
            val bits = esp32S3GpioDriveBits(pin, drive)
            if (esp32S3GpioDriveBits(pin, bits) != drive) return 2
            if (pin == 17 || pin == 18) {
                if (drive == 1 && bits != 2) return 3
                if (drive == 2 && bits != 1) return 4
            } else if (bits != drive) return 5
            drive = drive + 1
        }
        pin = pin + 1
    }
    if (esp32S3GpioBankOffset(31) != 0 || esp32S3GpioBankOffset(32) != 12) return 6
    0
}
