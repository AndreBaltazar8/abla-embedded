import "../src/esp32/dw_gdma_dsi_p4_sequence.ab"
import "../src/esp32/dw_gdma_channel_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1280)
var channel=0
var writes=0
var reads=0
var mode=0
var stopping=false
var ticks=0
var bad=false
trusted fun p4DwDmaRead(offset: int): u32 {
    reads=reads+1
    val memory=nativeBufferAt(storage,1280)
    if (offset == 24 && stopping) {
        ticks=ticks+1
        if (ticks == 3 && mode != 2) memory.storeU32(24,memory.loadU32(24)&(4294967295^(1<<channel)))
    }
    return u32(memory.loadU32(offset))
}
trusted fun p4DwDmaWrite(offset: int,value: u32): void {
    writes=writes+1
    val memory=nativeBufferAt(storage,1280)
    val bit=u32(1)<<u32(channel)
    if (offset == 24) {
        if (value == (u32(257)<<u32(channel))) {
            if (mode == 1) memory.storeU32(392+channel*256,2)
            else memory.storeU32(24,memory.loadU32(24)|int(bit))
        } else if (value == (u32(256)<<u32(channel))) { stopping=true; ticks=0 }
        else bad=true
    } else if (offset == 408+channel*256) {
        memory.storeU32(392+channel*256,memory.loadU32(392+channel*256)&int(u32(4294967295)^value))
    } else memory.storeU32(offset,int(value))
    return
}
trusted fun resetControl(): void {
    val memory=nativeBufferAt(storage,1280)
    var offset=0
    while (offset < 1280) { memory.storeU32(offset,0); offset=offset+4 }
    // Other three channels remain enabled throughout this channel's lifecycle.
    memory.storeU32(24,15^(1<<channel)); memory.storeU32(16,1)
    stopping=false; ticks=0; mode=0; bad=false
    if (esp32P4DwDmaDsiConfigureOwned(channel,805306368) != 1) bad=true
    reads=0; writes=0
    return
}
@export("abla_dsi_p4_dma_control_test")
trusted fun testControl(): i32 {
    val memory=nativeBufferAt(storage,1280)
    while (channel < 4) {
        resetControl()
        if (bad || esp32P4DwDmaDsiStartPreparedOwned(channel) != 1 || writes != 1 || memory.loadU32(24) != 15) return i32(1)
        if (esp32P4DwDmaDsiStartPreparedOwned(channel) != 4 || writes != 1) return i32(2)
        if (esp32P4DwDmaAcknowledgeOwned(channel,2) != 3 || writes != 1) return i32(3)
        if (esp32P4DwDmaStopOwned(channel,3) != 1 || ticks != 3 || writes != 2 ||
            memory.loadU32(24) != (15^(1<<channel)) || bad) return i32(4)
        resetControl(); mode=1
        if (esp32P4DwDmaDsiStartPreparedOwned(channel) != 1 || esp32P4DwDmaEventsOwned(channel) != 2) return i32(5)
        if (esp32P4DwDmaDsiStartPreparedOwned(channel) != 5 || writes != 1) return i32(6)
        memory.storeU32(392+channel*256,8194)
        if (esp32P4DwDmaAcknowledgeOwned(channel,2) != 1 || esp32P4DwDmaEventsOwned(channel) != 8192 || writes != 2) return i32(7)
        if (esp32P4DwDmaAcknowledgeOwned(channel,8192) != 1 || esp32P4DwDmaEventsOwned(channel) != 0) return i32(8)
        resetControl(); mode=2
        if (esp32P4DwDmaDsiStartPreparedOwned(channel) != 1 || esp32P4DwDmaStopOwned(channel,2) != 4 || ticks != 2 || memory.loadU32(24) != 15) return i32(9)
        mode=0
        if (esp32P4DwDmaStopOwned(channel,3) != 1) return i32(10)
        resetControl(); memory.storeU32(28,1<<channel)
        if (esp32P4DwDmaDsiStartPreparedOwned(channel) != 4 || esp32P4DwDmaStopOwned(channel,2) != 4 ||
            esp32P4DwDmaAcknowledgeOwned(channel,2) != 3 || writes != 0) return i32(11)
        resetControl(); memory.storeU32(300+channel*256,1)
        if (esp32P4DwDmaDsiStartPreparedOwned(channel) != 6 || writes != 0) return i32(12)
        resetControl(); memory.storeU32(16,0)
        if (esp32P4DwDmaDsiStartPreparedOwned(channel) != 3 || esp32P4DwDmaStopOwned(channel,1) != 3 || writes != 0) return i32(13)
        resetControl(); memory.storeU32(392+channel*256,2147483648)
        if (esp32P4DwDmaEventsOwned(channel) != 2147483648 || esp32P4DwDmaAcknowledgeOwned(channel,2147483648) != 1) return i32(14)
        channel=channel+1
    }
    reads=0; writes=0
    if (esp32P4DwDmaEventsOwned(-1) != -1 || esp32P4DwDmaDsiStartPreparedOwned(4) != 2 ||
        esp32P4DwDmaStopOwned(0,0) != 2 || esp32P4DwDmaStopOwned(0,1000001) != 2 ||
        esp32P4DwDmaAcknowledgeOwned(0,4) != 2 || esp32P4DwDmaAcknowledgeOwned(0,4294967296) != 2 ||
        esp32P4DwDmaAcknowledgeOwned(0,0) != 2 || reads != 0 || writes != 0) return i32(15)
    return i32(0)
}
