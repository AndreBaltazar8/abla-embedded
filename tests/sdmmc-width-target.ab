import "../src/sd/mmc_width_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_width_target")
trusted fun target(operation: int,address: int,card: int,scr: int,width: int,now: u32,budget: int,prepared: bool): int {
    val state=nativeBufferAt(address,48)
    if (operation == 0) return sdMmcWidthBeginOwned(state,nativeBufferAt(card,80),SdScr(scr),width,now,budget,prepared)
    return sdMmcWidthPollOwned(state,now)
}
