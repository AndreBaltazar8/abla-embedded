import "../src/m5stack/imu_control.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
var calls=0
var fail=false
var high=false
var bad=false
var operation=0
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    if (this != 7 || operation != 0 || register != 107 || value != 64) bad=true
    !fail
}
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    calls=calls+1
    if (this != 7 || operation != 1 || register != 55 || mask != 128 || value != (if (high) 0 else 128)) bad=true
    !fail
}
fun I2cDevice.close(): bool {
    calls=calls+1
    if (this != 7 || operation != 2) bad=true
    !fail
}
@export("abla_imu_control_test")
fun controlTest(): i32 {
    var profile=0
    while (profile < 20) {
        val kind=profile/4+1
        fail=(profile & 1) != 0; high=(profile & 2) != 0
        val imu=M5ImuProbeResult((1<<48)|(3<<42)|((if (kind == 5) 108 else 104)<<35)|(kind<<32)|7)
        val expected=if (kind >= 4) 3 else if (fail) 4 else 1
        calls=0; bad=false; operation=0
        if (imu.sleep() != M5ImuControlResult(expected) || calls != (if (kind >= 4) 0 else 1) || bad) return i32(1)
        calls=0; operation=1
        if (imu.setInterruptActiveHigh(high) != M5ImuControlResult(expected) || calls != (if (kind >= 4) 0 else 1) || bad) return i32(2)
        calls=0; operation=2
        if (imu.closeDevice() == fail || calls != 1 || bad) return i32(3)
        profile=profile+1
    }
    calls=0
    if (M5ImuProbeResult(0).sleep() != M5ImuControlResult(2) ||
        M5ImuProbeResult(0).setInterruptActiveHigh(true) != M5ImuControlResult(2) ||
        M5ImuProbeResult(0).closeDevice() || calls != 0) return i32(4)
    fail=false; operation=2
    if (!M5ImuProbeResult((4<<48)|(104<<35)|7).closeDevice() || calls != 1) return i32(5)
    i32(0)
}
