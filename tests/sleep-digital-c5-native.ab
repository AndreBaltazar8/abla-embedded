import "../src/esp32/power/sleep_digital_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(48)
var writes=0
var failAt=0
var deep=false
var bad=false
fun slot(offset: int): int = if (offset == 0x8c) 0 else if (offset == 0x6c) 1 else if (offset == 0x78) 2 else -1
trusted fun c5SleepDigitalRead(offset: int): int {
    val index=slot(offset)
    if (index < 0 || (deep && index == 2)) { bad=true;return 0 }
    nativeBufferAt(memory+32,12).loadU32(index*4)
}
trusted fun c5SleepDigitalWrite(offset: int,value: int): void {
    writes=writes+1
    if (slot(offset) < 0 || (deep && slot(offset) == 2)) { bad=true;return }
    if (writes != failAt) nativeBufferAt(memory+32,12).storeU32(slot(offset)*4,value)
    return
}
@export("abla_sleep_digital_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,32);val regs=nativeBufferAt(memory+32,12)
    var mode=0
    while (mode < 4) {
        deep=(mode&1) != 0
        var bit=0
        while (bit < 33) {
            val clocks=if (deep || bit == 32) u32(0) else u32(1)<<u32(bit)
            var fault=0
            while (fault <= 6) {
                record.storeU32(0,0);writes=0;failAt=fault;bad=false
                regs.storeU32(0,0x12345678);regs.storeU32(4,0xfedcba98);regs.storeU32(8,0x76543210)
                val result=esp32C5SleepDigitalApplyOwned(record,clocks,deep,(mode&2) != 0,true)
                if (result != 1 && result != 3) return i32(1)
                if (result == 1 && (regs.loadU32(4) != int(clocks) ||
                    regs.loadU32(0) != (0x12345678|(if (clocks != u32(0)) 0x08000000 else 0)) ||
                    regs.loadU32(8) != (0x76543210|(if (!deep && (mode&2) == 0) 0x08000000 else 0)))) return i32(2)
                esp32C5SleepDigitalCloseOwned(record,true);failAt=0
                if (esp32C5SleepDigitalCloseOwned(record,true) != 4 || bad || regs.loadU32(0) != 0x12345678 ||
                    regs.loadU32(4) != 0xfedcba98 || regs.loadU32(8) != 0x76543210) return i32(3)
                fault=fault+1
            }
            bit=bit+1
        }
        mode=mode+1
    }
    writes=0
    if (esp32C5SleepDigitalApplyOwned(record,u32(1),true,false,true) != 2 || writes != 0) return i32(4)
    return i32(0)
}
