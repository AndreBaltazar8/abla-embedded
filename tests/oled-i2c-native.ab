import "../src/m5stack/oled_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
fun I2cDevice.valid(): bool = this == 7
val memory=nativeStaticAllocate(1200)
var profile=OledProfile(0)
var calls=0
var failure=0
var mode=0
var brightness=0
var bad=false
trusted fun I2cDevice.write(bytes: NativeBuffer,length: int): bool {
    calls=calls+1
    if (this != 7) bad=true
    if (mode == 0) {
        val ssd=profile.kind() == 1
        val command=if (ssd) calls == 1 else (calls&1) == 1
        val page=if (ssd) calls-2 else (calls-1)/2
        if (command) {
            if (bytes.load(0) != 0) bad=true
            if (ssd) {
                if (length != 7 || bytes.load(1) != 33 || bytes.load(2) != profile.column() || bytes.load(3) != profile.column()+profile.width()-1 ||
                    bytes.load(4) != 34 || bytes.load(5) != profile.page() || bytes.load(6) != profile.page()+(profile.height()>>>3)-1) bad=true
            } else if (length != 4 || bytes.load(1) != 176+profile.page()+page || bytes.load(2) != 16+(profile.column()>>>4) || bytes.load(3) != (profile.column()&15)) bad=true
        } else {
            if (length != profile.width()+1 || bytes.load(0) != 64) bad=true
            var x=0;while (x < profile.width()) { if (bytes.load(x+1) != (((page*profile.width()+x)*73+19)&255)) bad=true;x=x+1 }
        }
    } else if (mode == 1) {
        if (bytes.load(0) != 0 || bytes.load(1) != 174 || length != (if (profile.kind() == 1) 27 else 28) || bytes.load(length-1) != 166) bad=true
    } else if (mode == 2) {
        if (bytes.load(0) != 0) bad=true
        if (profile.kind() == 1) {
            if (length != 7 || bytes.load(1) != 217 || bytes.load(2) != ((brightness+15)/17)*17 ||
                bytes.load(3) != 219 || bytes.load(4) != brightness/2 || bytes.load(5) != 129 || bytes.load(6) != brightness) bad=true
        } else if (length != 3 || bytes.load(1) != 129 || bytes.load(2) != brightness) bad=true
    } else if (length != 2 || bytes.load(0) != 0 || bytes.load(1) != (if (mode == 3) (if (brightness == 0) 175 else 174) else (if (brightness == 0) 166 else 167))) bad=true
    return calls != failure
}
@export("abla_oled_i2c_test")
trusted fun testOled(): i32 {
    val frame=nativeBufferAt(memory,1024);val scratch=nativeBufferAt(memory+1024,176);val device=I2cDevice(7)
    var variant=0
    while (variant < 4) {
        profile=if (variant == 0) m5UnitMiniOledProfile else if (variant == 1) m5UnitOledProfile else if (variant == 2) oledProfile(1,128,64) else oledProfile(2,32,16,16,3)
        if (!profile.valid()) return i32(1)
        var at=0;while (at < 1024) { frame.store(at,(at*73+19)&255);at=at+1 }
        val pages=profile.height()>>>3;val total=if (profile.kind() == 1) pages+1 else pages*2
        mode=0;failure=0
        while (failure <= total) {
            calls=0
            val result=device.oledDisplay(profile,frame,scratch)
            val command=if (profile.kind() == 1) failure == 1 else (failure&1) == 1
            val done=if (failure == 0) pages else if (profile.kind() == 1) (if (failure == 1) 0 else failure-2) else (failure-1)/2
            if ((result&255) != (if (failure == 0) 1 else if (command) 3 else 4) || result>>>8 != done || calls != (if (failure == 0) total else failure) || bad) return i32(2)
            at=0;while (at < 1024) { if (frame.load(at) != ((at*73+19)&255)) return i32(3);at=at+1 }
            failure=failure+1
        }
        calls=0
        if (device.oledDisplay(profile,frame,frame) != 2 || calls != 0) return i32(4)
        mode=1;failure=0;calls=0
        if (!device.oledInitialize(profile,scratch) || calls != 1 || bad) return i32(5)
        failure=1;calls=0
        if (device.oledInitialize(profile,scratch) || calls != 1 || bad) return i32(6)
        mode=2;brightness=0
        while (brightness < 256) {
            failure=0;calls=0
            if (!device.oledSetBrightness(profile,brightness,scratch) || calls != 1 || bad) return i32(7)
            failure=1;calls=0
            if (device.oledSetBrightness(profile,brightness,scratch) || calls != 1 || bad) return i32(8)
            brightness=brightness+1
        }
        mode=3
        while (mode <= 4) {
            brightness=0
            while (brightness <= 1) {
                failure=0;calls=0
                val ok=if (mode == 3) device.oledSetSleep(brightness != 0,scratch) else device.oledSetInvert(brightness != 0,scratch)
                if (!ok || calls != 1 || bad) return i32(9)
                brightness=brightness+1
            }
            mode=mode+1
        }
        variant=variant+1
    }
    if (oledProfile(1,72,40,29).valid() || oledProfile(2,64,128,65).valid() || oledProfile(1,128,64,0,1).valid()) return i32(10)
    return i32(0)
}
