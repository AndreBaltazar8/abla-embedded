import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/dma_start_c6_sequence.ab"
var descriptors=NativeBuffer(0)
var channel=0
var tx=false
var conf=u32(0)
var head=u32(0)
var delay=0
var writes=0
var drop=0
var starts=0
var updates=0
var bad=false
trusted fun acceptWrite(): bool { writes=writes+1;return writes != drop }
trusted fun c6I2sClockRead(at: int): u32 = if (at == 0) u32(1) else u32(0x400000)
trusted fun c6I2sClockWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6I2sRead(at: int): u32 {
    if (at == (if (tx) 0x24 else 0x20)) {
        if ((conf&u32(256)) != u32(0)) { if (delay == 0) conf=conf&~u32(256) else delay=delay-1 }
        return conf
    }
    if (at == 0x6c) return u32(1)
    if (at == 0x64) return u32(64)
    return u32(0)
}
trusted fun c6I2sWrite(at: int,v: u32): void {
    if (at != (if (tx) 0x24 else 0x20)) bad=true
    if ((v&u32(256)) != u32(0)) updates=updates+1
    if ((v&u32(4)) != u32(0) && starts != 1) bad=true
    if (acceptWrite()) conf=v
    return
}
trusted fun c6GdmaBusRead(): u32 = u32(1)
trusted fun c6GdmaBusWrite(v: u32): void { bad=true;return }
trusted fun c6GdmaRead(at: int): u32 {
    val base=0x70+channel*192+(if (tx) 96 else 0)
    if (at == 0x64) return u32(8)
    if (at == base) return u32(if (tx) 12 else 0)
    if (at == base+4) return u32(4096)
    if (at == base+8) return u32(2)
    if (at == base+16) return head
    if (at == base+48) return u32(3)
    return u32(0)
}
trusted fun c6GdmaWrite(at: int,v: u32): void {
    if (at != 0x80+channel*192+(if (tx) 96 else 0)) { bad=true;return }
    if ((v&u32(if (tx) 0x200000 else 0x400000)) != u32(0)) {
        if (updates != 1 || (conf&u32(0x104)) != u32(0) || (head&u32(0xfffff)) != u32(0)) bad=true
        starts=starts+1
    }
    if (acceptWrite()) head=v
    return
}
trusted fun c6GdmaDescriptorFence(): void { return }
trusted fun c6GdmaDescriptorRead(at: int): u32 = u32(descriptors.loadU32(at-0x40800000))
trusted fun c6GdmaDescriptorWrite(at: int,v: u32): void {
    if (starts != 0) bad=true
    if (acceptWrite()) descriptors.storeU32(at-0x40800000,int(v))
    return
}
@export("abla_i2s_dma_start_c6_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(96)
    val r=nativeBufferAt(storage,72)
    descriptors=nativeBufferAt(storage+72,24)
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 0
            var lag=0
            while (lag < 8) {
                var fault=0
                while (fault <= 12) {
                    var at=0
                    while (at < 72) { r.storeU32(at,0);at=at+4 }
                    at=0
                    while (at < 24) { descriptors.storeU32(at,0x55555555);at=at+4 }
                    conf=u32(0x80000);head=u32(if (tx) 0x800123 else 0x1100123);delay=lag;writes=0;drop=fault;starts=0;updates=0;bad=false
                    var result=c6I2sDmaStartBeginOwned(r,channel,0x40800000,2,0x40810000,64,64,true,1,true,tx)
                    if (result == 5) {
                        if (starts != 0 || updates != 1 || (conf&u32(4)) != u32(0)) return i32(1)
                        result=c6I2sDmaStartAdvanceOwned(r,16,true)
                    }
                    if (result != 1 && result != 4) return i32(2)
                    if (result == 1 && (starts != 1 || updates != 1 || (conf&u32(4)) == u32(0))) return i32(3)
                    val before=writes
                    if (c6I2sDmaStartAdvanceOwned(r,1,true) != 2 || c6I2sDmaStartBeginOwned(r,channel,0x40800000,2,0x40810000,64,64,true,1,true) != 2 || writes != before || bad) return i32(4)
                    fault=fault+1
                }
                lag=lag+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    return i32(0)
}
