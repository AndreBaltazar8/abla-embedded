import "../src/esp32/psram/command_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(200)
var phase=0
var bad=false
var ready=true
var busyAfter=false
var expectedCommand=0
var expectedLength=0
var expectedDummy=0
var commandAddress=0
fun s3PsramCommandStorageSafe(address: int,length: int): bool = address >= storage && address+length <= storage+200
fun s3PsramCommandReady(): bool = ready
fun s3PsramOpiDtrMode(): void { if (phase != 0) bad=true; phase=1; return }
fun s3PsramCommandConfigure(unit: int,descriptor: int): void {
    val work=nativeBufferAt(storage,100)
    val read=s3PsramCommandIsRead(expectedCommand)
    if (phase != 1 || unit != 1 || descriptor != storage || work.loadU32(0) != (expectedCommand|(16<<16)) || work.loadU32(4) != storage+32 ||
        work.loadU32(8) != 32 || work.loadU32(12) != (if (read) 0 else storage+36) || work.loadU32(16) != (if (read) 0 else expectedLength*8) ||
        work.loadU32(20) != (if (read) storage+36 else 0) || work.loadU32(24) != (if (read) expectedLength*8 else 0) ||
        work.loadU32(28) != expectedDummy || work.loadU32(32) != commandAddress) bad=true
    var offset=0
    while (offset < 64) {
        if (work.load(offset+36) != (if (!read && offset < expectedLength) (offset*7)&255 else 0)) bad=true
        offset=offset+1
    }
    phase=2; return
}
fun s3PsramCommandStart(rx: int,length: int): void {
    val read=s3PsramCommandIsRead(expectedCommand)
    if (phase != 2 || rx != (if (read) storage+36 else 0) || length != (if (read) expectedLength else 0)) bad=true
    if (read) {
        var offset=0
        while (offset < length) { nativeBufferAt(storage+36,64).store(offset,(offset*13)&255); offset=offset+1 }
    }
    phase=3; if (busyAfter) ready=false; return
}
@export("abla_s3_psram_command_test")
trusted fun commandTest(): i32 {
    val work=nativeBufferAt(storage,100)
    val payload=nativeBufferAt(storage+101,64)
    var kind=0
    while (kind < 4) {
        expectedCommand=if (kind == 0) 0 else if (kind == 1) 0x4040 else if (kind == 2) 0x8080 else 0xc0c0
        expectedLength=1
        while (expectedLength <= 64) {
            expectedDummy=if (kind < 2) 16 else 0; commandAddress=4294967295
            phase=0; bad=false
            var offset=0
            while (offset < 64) { payload.store(offset,(offset*7)&255); offset=offset+1 }
            nativeBufferAt(storage+100,1).store(0,0x5a); nativeBufferAt(storage+165,1).store(0,0xa5)
            if (s3PsramCommandOwned(expectedCommand,commandAddress,expectedDummy,payload,expectedLength,work) != 1 || phase != 3 || bad) return i32(1)
            offset=0
            while (offset < 64) {
                if (payload.load(offset) != (if (kind < 2 && offset < expectedLength) (offset*13)&255 else (offset*7)&255)) return i32(2)
                offset=offset+1
            }
            if (nativeBufferAt(storage+100,1).load(0) != 0x5a || nativeBufferAt(storage+165,1).load(0) != 0xa5) return i32(3)
            expectedLength=expectedLength+1
        }
        kind=kind+1
    }
    phase=0; ready=false
    if (s3PsramCommandOwned(0,0,0,payload,1,work) != 3 || phase != 0) return i32(4)
    ready=true
    if (s3PsramCommandOwned(1,0,0,payload,1,work) != 2 || s3PsramCommandOwned(0,-1,0,payload,1,work) != 2 ||
        s3PsramCommandOwned(0,0,65,payload,1,work) != 2 || s3PsramCommandOwned(0,0,0,payload,65,work) != 2 ||
        s3PsramCommandOwned(0,0,0,payload,1,nativeBufferAt(storage,99)) != 2 || s3PsramCommandOwned(0,0,0,payload,1,nativeBufferAt(storage+1,100)) != 2 ||
        s3PsramCommandOwned(0,0,0,nativeBufferAt(storage+99,1),1,work) != 2 || s3PsramCommandOwned(0,0,0,nativeBufferAt(storage+200,1),1,work) != 2 || phase != 0) return i32(5)
    expectedCommand=0; expectedLength=1; expectedDummy=0; commandAddress=0; busyAfter=true; payload.store(0,0xaa)
    if (s3PsramCommandOwned(0,0,0,payload,1,work) != 4 || payload.load(0) != 0xaa || bad) return i32(6)
    return i32(0)
}
