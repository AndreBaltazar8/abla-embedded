import "../src/esp32/startup_clock_s3_sequence.ab"
import "abla/build"
var scFault=0
var scStep=0
var scXtal=40
var scBad=false
fun esp32S3ClockRead(address: int): int {
    if (address == 0x600c0060) return if (scStep == 3) 1024 else if (scFault == 1) 1 else 0
    if (address == 0x600c0010) return if (scStep == 3) (if (scFault == 13) 0 else 4) else 0
    if (address == 0x60008000) return if (scStep >= 2) 0 else if (scFault == 2) 64 else 0x540
    if (address == 0x600080c0) return if (scFault == 3) 0 else scXtal|(scXtal<<16)
    if (address == 0x600c0000) return if (scFault == 4) 1 else 4
    if (address == 0x600c4000) return if (scFault == 5) 1 else 0
    if (address == 0x600c4060) return if (scFault == 6) 1 else 0
    if (address == 0x600c4130) return if (scFault == 7) 0 else 0x1001
    if (address == 0x60002000) return if (scFault == 8) 1 else 0
    if (address == 0x60003000) return if (scFault == 9) 1 else 0
    scBad=true;return 0
}
fun esp32S3ClockRomTicks(mhz: int): void { if (scStep != 0 || mhz != scXtal) scBad=true;scStep=1;return }
fun esp32S3PllStartOwned(mhz: int,polls: int): int {
    if (scStep != 1 || mhz != 480 || polls != 100) scBad=true
    if (scFault == 10) return 3
    if (scFault == 11) return 2
    scStep=2;return 1
}
fun esp32S3ClockToReadyPllOwned(mhz: int,a: int,b: int,c: int,d: int): Esp32S3ClockState {
    if (scStep != 2 || mhz != 80 || (a|b|c|d) != 0) scBad=true
    if (scFault == 12) return Esp32S3ClockState(0)
    scStep=3;return esp32S3ClockDecode(0,0,scXtal|(scXtal<<16))
}
@export("abla_s3_startup_clock_test")
fun testStartupClock(): int {
    var crystal=0
    while (crystal < 2) {
        scXtal=if (crystal == 0) 32 else 40
        scFault=0
        while (scFault <= 13) {
            scStep=0;scBad=false
            val expected=if (scFault == 0) 1 else if (scFault <= 9) 3 else if (scFault == 10) 4 else 5
            if (esp32S3StartupClock480Owned(100,true) != expected || scBad || (scFault >= 1 && scFault <= 9 && scStep != 0)) return 1
            scFault=scFault+1
        }
        scFault=0;scStep=3
        if (esp32S3StartupClock480Owned(100,true) != 1 || scStep != 3) return 2
        scStep=0
        if (esp32S3StartupClock480Owned(100,false) != 2 || esp32S3StartupClock480Owned(0,true) != 2 || esp32S3StartupClock480Owned(1000001,true) != 2 || scStep != 0) return 3
        crystal=crystal+1
    }
    return 0
}
