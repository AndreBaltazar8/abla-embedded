import "../src/esp32/power/sleep_uart_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_uart_target")
trusted fun sleepUartTarget(port: int,deep: bool,polls: int,operation: int): int {
    if (operation == 0) return esp32S3SleepUartPrepareOwned(port,deep,polls)
    if (operation == 1) return if (esp32S3SleepUartResumeOwned(port)) 1 else 0
    var transaction=esp32S3SleepUartsPrepareOwned(port,deep,polls)
    val result=transaction | 0
    transaction=transaction.resumeOwned()
    result
}
