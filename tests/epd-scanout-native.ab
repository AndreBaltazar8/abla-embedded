import "./i80-session-s3-native.ab"
import "./epd-gates-native.ab"
import "../src/display/epd_scanout_sequence.ab"
val scanoutMemory=nativeStaticAllocate(36)
val scanoutRow=nativeStaticAllocate(1920)
val scanoutGray=nativeStaticAllocate(480)
@export("abla_epd_scanout_test")
fun testEpdScanout(): int {
    val r=nativeBufferAt(scanoutMemory,36);val t=nativeBufferAt(sessionStorage,164)
    val cfg=nativeBufferAt(sessionConfig,76);val desc=nativeBufferAt(sessionDescriptors,24);val payload=nativeBufferAt(sessionPayload,4096)
    val gates=epdGatePins(46,17,18,45,15)
    var profile=0
    while (profile < 8) {
        t.storeU32(0,0);r.storeU32(0,0);r.storeU32(32,0x12345678)
        sessionFault=0;sessionReady=true;sessionPins=false;sessionDma=false;sessionBad=false;sessionAbortFails=false;sessionRestoreFails=false;sessionStarts=0
        epdPrepared=true;epdFail=0;epdCount=0;epdWrites=0;epdBad=false
        if (esp32S3I80SessionOpenOwned(t,cfg,desc,payload,8,2,2,5,1,8,true) != 1) return 1
        // Publish the modeled actual pin-owner snapshots that the session's
        // GPIO component fixture normally owns. No gate/transport pin overlap.
        t.storeU32(64,0x49385053);t.storeU32(68,1);t.storeU32(72,9)
        var pin=0
        while (pin < 9) { t.storeU32(80+pin*4,(1<<29)|((if (pin < 8) pin else 40)<<23));pin=pin+1 }
        val height=if (profile == 0) 540 else 2
        if (epdScanoutAttachOwned(r,t,gates,248,height,true) != 1) return 2
        if (profile == 1) epdFail=4
        val began=epdScanoutBeginFrameOwned(r,t,true)
        if (began != (if (profile == 1) 4 else 1)) return 3
        epdFail=0
        if (began == 1) {
            val wave=nativeBufferAt(scanoutRow,1920);val gray=nativeBufferAt(scanoutGray,480)
            if (profile == 7) {
                if (!epdWaveformInitialize(wave,960,true)) return 17
                var pixel=0
                while (pixel < 480) { gray.store(pixel,0);pixel=pixel+1 }
                if (!epdWaveformUpdateOwned(wave,gray,480,4,true)) return 18
                val before=wave.loadU32(0)
                if (epdScanoutRenderLineOwned(r,t,wave,944,8,true) != 3 || wave.loadU32(0) != before || epdCount != 25) return 19
            }
            if (epdScanoutEndFrameOwned(r,t,true) != 3) return 4
            var line=0
            while (line < height) {
                epdCount=0;epdWrites=0
                if (profile == 2) epdFail=1
                val result=if (profile == 7) epdScanoutRenderLineOwned(r,t,wave,960,8,true) else epdScanoutSendLineOwned(r,t,true)
                if (profile == 7 && (result != 7 || payload.load(0) != (if (line == 0) 170 else 85) ||
                    payload.load(239) != payload.load(0) || payload.loadU32(240) != 0 || payload.loadU32(244) != 0)) return 20
                val sent=if (result == 7) 2 else result
                if (sent != (if (profile == 2) 4 else 2)) return 5
                epdFail=0
                if (sent == 4) break
                if (profile == 7) {
                    val before=wave.loadU32(0)
                    if (epdScanoutRenderLineOwned(r,t,wave,960,8,true) != 3 || wave.loadU32(0) != before) return 21
                }
                if (epdScanoutSendLineOwned(r,t,true) != 3 || epdCount != 2) return 6
                sessionPollResult=0
                if (epdScanoutPollLineOwned(r,t,true) != 2 || epdCount != 2 || r.loadU32(24) != line) return 7
                if (profile == 3) break
                sessionPollResult=if (profile == 4) 3 else 1
                if (profile == 5) epdFail=epdWrites+1
                val polled=epdScanoutPollLineOwned(r,t,true)
                if (polled != (if (profile == 4 || profile == 5) 4 else 1)) return 8
                epdFail=0
                if (polled == 4) break
                if (r.loadU32(24) != line+1 || epdScanoutPollLineOwned(r,t,true) != 3 || epdCount != 4) return 9
                line=line+1
            }
            if (profile == 0 || profile == 6 || profile == 7) {
                epdCount=0;epdWrites=0
                if (profile == 6) epdFail=1
                if (epdScanoutEndFrameOwned(r,t,true) != (if (profile == 6) 4 else 1)) return 10
                epdFail=0
                if (profile == 0) {
                    epdCount=0;epdWrites=0
                    if (epdScanoutBeginFrameOwned(r,t,true) != 1 || epdCount != 19 || r.loadU32(24) != 0) return 11
                }
            }
        }
        epdCount=0;epdWrites=0;sessionAbortFails=true;sessionRestoreFails=true
        if (epdScanoutCloseOwned(r,t,true) != 6 || epdCount != 0) return 12
        sessionAbortFails=false
        if (epdScanoutCloseOwned(r,t,true) != 6 || epdCount != 0) return 13
        sessionRestoreFails=false;epdFail=1
        if (epdScanoutCloseOwned(r,t,true) != 6 || sessionDma || sessionPins) return 14
        epdFail=0;epdCount=0;epdWrites=0
        if (epdScanoutCloseOwned(r,t,true) != 5 || epdCount != 6 || sessionBad || epdBad || r.loadU32(32) != 0x12345678) return 15
        if (epdScanoutCloseOwned(r,t,true) != 5 || epdCount != 6) return 16
        profile=profile+1
    }
    return 0
}
