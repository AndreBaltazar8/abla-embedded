import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/esp32/gdma_ring_c6_sequence.ab"
var memory=NativeBuffer(0)
var writes=0
var drop=0
var fences=0
var bad=false
trusted fun c6GdmaDescriptorRead(at: int): u32 {
    if (at < 0x40800000 || at >= 0x40800300 || (at&3) != 0) { bad=true;return u32(0) }
    return u32(memory.loadU32(at-0x40800000))
}
trusted fun c6GdmaDescriptorWrite(at: int,value: u32): void {
    writes=writes+1
    if (at < 0x40800000 || at >= 0x40800300 || (at&3) != 0 || ((value&u32(0x80000000)) != u32(0) && fences == 0)) { bad=true;return }
    if (writes != drop) memory.storeU32(at-0x40800000,int(value))
    return
}
trusted fun c6GdmaDescriptorFence(): void { fences=fences+1;return }
@export("abla_gdma_ring_c6_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(768)
    memory=nativeBufferAt(storage,768)
    var count=1
    while (count <= 64) {
        var flags=0
        while (flags < 4) {
            var fault=0
            while (fault <= count*4) {
                var at=0
                while (at < 768) { memory.storeU32(at,0x55555555);at=at+4 }
                writes=0;drop=fault;fences=0;bad=false
                val tx=(flags&1) != 0;val circular=(flags&2) != 0
                val result=c6GdmaRingBuildOwned(0x40800000,count,0x40801000,64,60,tx,circular,true)
                if (result != (if (fault == 0) 1 else 3) || bad) return i32(1)
                if (result == 1) {
                    if (fences != 2 || writes != count*4) return i32(2)
                    var index=0
                    while (index < count) {
                        if (memory.loadU32(index*12) != (0x8000003c|(if (tx) 0x4003c000 else 0)) || memory.loadU32(index*12+4) != 0x40801000+index*64 ||
                            memory.loadU32(index*12+8) != (if (index+1 < count) 0x40800000+(index+1)*12 else if (circular) 0x40800000 else 0)) return i32(3)
                        index=index+1
                    }
                }
                fault=fault+1
            }
            flags=flags+1
        }
        count=count+1
    }
    writes=0;fences=0
    if (c6GdmaRingBuildOwned(0x40800000,1,0x40800004,4,4,true,false,true) != 2 || c6GdmaRingBuildOwned(0x40800000,1,0x40880000,4,4,true,false,true) != 2 || writes != 0 || fences != 0) return i32(4)
    if (!c6GdmaRingValid(0x40800000,1,0x4085fffc,4,4) || c6GdmaRingValid(0x40800001,1,0x40801000,4,4) || c6GdmaRingValid(0x40800000,1025,0x40801000,4,4)) return i32(5)
    if (!c6GdmaRingValid(0x4087fff4,1,0x40800000,4,4) || !c6GdmaRingValid(0x40800000,1,0x4087fffc,4,4) ||
        c6GdmaRingValid(0x4087fff8,1,0x40800000,4,4) || c6GdmaRingValid(0x40800000,1,0x4087fffc,8,8) ||
        c6GdmaRingValid(0x407ffffc,1,0x40800000,4,4)) return i32(6)
    return i32(0)
}
