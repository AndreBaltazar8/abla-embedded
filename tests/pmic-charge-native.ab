import "./charger-control-native.ab"
import "../src/m5stack/pmic_charge.ab"
@export("abla_pmic_charge_test")
fun testPmicCharge(): i32 {
    var kind=2
    while (kind <= 6) {
        val pmic=M5PmicOpen(7|(kind<<32)|(1<<40))
        if (pmic.supportsDirectChargeControl() != (kind != 5)) return i32(1)
        var operation=0
        while (operation < 3) {
            var value=0
            while (value <= 5001) {
                val requested=if (value == 5001) 65535 else value
                expectedRegister=if (kind == 2) 51 else if (kind == 3) (if (operation == 0) 24 else if (operation == 1) 98 else 100)
                    else if (kind == 4) (if (operation == 0) 0 else if (operation == 1) 36 else 34)
                    else if (operation == 0) 1 else if (operation == 1) 2 else 4
                expectedMask=if (kind == 2) (if (operation == 0) 128 else if (operation == 1) 15 else 96)
                    else if (kind == 3) (if (operation == 0) 2 else 255)
                    else if (kind == 4) (if (operation == 0) 16 else if (operation == 1) 31 else 255)
                    else if (operation == 0) 8 else if (operation == 1) 255 else 63
                expectedValue=if (operation == 0) (if (kind == 6) (if (requested == 0) 8 else 0) else if (requested != 0) expectedMask else 0)
                    else if (operation == 1) (if (kind == 2) axp192ChargeCurrentCode(requested) else if (kind == 3) axp2101ChargeCurrentCode(requested) else if (kind == 4) ip5306ChargeCurrentCode(requested) else aw32001ChargeCurrentCode(requested))
                    else if (kind == 2) axp192ChargeVoltageCode(requested)<<5 else if (kind == 3) axp2101ChargeVoltageCode(requested) else if (kind == 4) ip5306ChargeVoltageCode(requested) else aw32001ChargeVoltageCode(requested)
                var failure=0
                while (failure < 2) {
                    calls=0;bad=false;fail=failure == 1
                    val result=if (operation == 0) pmic.setBatteryChargeOwned(requested != 0,true)
                        else if (operation == 1) pmic.setChargeCurrentOwned(requested,true) else pmic.setChargeVoltageOwned(requested,true)
                    if (result != M5ChargeControlResult(if (kind == 5) 3 else if (fail) 4 else 1) || calls != (if (kind == 5) 0 else 1) || bad) return i32(2)
                    failure=failure+1
                }
                value=value+1
            }
            operation=operation+1
        }
        calls=0
        if (pmic.setBatteryChargeOwned(true,false) != M5ChargeControlResult(2) ||
            pmic.setChargeCurrentOwned(-1,true) != M5ChargeControlResult(2) || pmic.setChargeVoltageOwned(65536,true) != M5ChargeControlResult(2) || calls != 0) return i32(3)
        kind=kind+1
    }
    var status=0
    while (status < 9) {
        if (status != 1) {
            val pmic=M5PmicOpen(7|(2<<32)|(status<<40));calls=0
            if (pmic.supportsDirectChargeControl() || pmic.setBatteryChargeOwned(true,true) != M5ChargeControlResult(2) ||
                pmic.setChargeCurrentOwned(500,true) != M5ChargeControlResult(2) || pmic.setChargeVoltageOwned(4200,true) != M5ChargeControlResult(2) || calls != 0) return i32(4)
        }
        status=status+1
    }
    return i32(0)
}
