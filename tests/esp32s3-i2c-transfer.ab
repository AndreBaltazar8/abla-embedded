import "../src/esp32/i2c/transfer_s3_logic.ab"

fun main(): int {
    if (esp32S3I2cSmallTransferValid(-1, 0, 0) ||
        esp32S3I2cSmallTransferValid(128, 0, 0)) return 1
    var written = -1
    while (written <= 33) {
        var read = -1
        while (read <= 34) {
            val expected = written >= 0 && read >= 0 && read <= 32 &&
                written <= (if (read > 0) 30 else 31)
            if (esp32S3I2cSmallTransferValid(127, written, read) != expected) return 2
            val last = esp32S3I2cSmallTransferLast(written, read)
            if (!expected) {
                if (last != -1 || esp32S3I2cSmallTransferCommand(written, read, 0) != u32(0xffffffff)) return 3
            } else {
                var index = 0
                var tx = 0
                var rx = 0
                var starts = 0
                var nacks = 0
                while (index <= last) {
                    val command = esp32S3I2cSmallTransferCommand(written, read, index)
                    if (!esp32S3I2cCommandValid(command)) return 4
                    val op = int((command >>> u32(11)) & u32(7))
                    val count = int(command & u32(255))
                    if (op == 1) {
                        tx = tx + count
                        if ((command & u32(256)) == u32(0)) return 5
                    }
                    if (op == 3) {
                        rx = rx + count
                        if ((command & u32(1024)) != u32(0)) {
                            nacks = nacks + 1
                            if (count != 1 || index != last - 1) return 6
                        }
                    }
                    if (op == 6) starts = starts + 1
                    if ((op == 2) != (index == last)) return 7
                    index = index + 1
                }
                if (rx != read || tx != written + 1 + (if (written > 0 && read > 0) 1 else 0)) return 8
                if (starts != (if (written > 0 && read > 0) 2 else 1)) return 9
                if (nacks != (if (read > 0) 1 else 0)) return 10
                if (esp32S3I2cSmallTransferCommand(written, read, last + 1) != u32(0xffffffff)) return 11
            }
            read = read + 1
        }
        written = written + 1
    }
    0
}
