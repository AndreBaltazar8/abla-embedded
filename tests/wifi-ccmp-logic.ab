import "abla/unsafe/memory"
import "../src/esp32/sdk/buffer.ab"
import "../src/wifi/ccmp_logic.ab"

trusted noescape extern:"c" fun mmap(
    requested: i64*, length: int, protection: i32, flags: i32,
    descriptor: i32, offset: int
): i64*
trusted noescape extern:"c" fun munmap(address: i64*, length: int): i32

trusted fun main(): int {
    if (wifiCcmpCipher().identifier() != 3 ||
        wifiCcmpCipher().headerBytes() != 8 ||
        wifiCcmpCipher().trailerBytes() != 8 ||
        wifiCcmpCipher().micBytes() != 0) return 1
    val allocation = mmap(
        nativeNullPointer(), 4096, i32(3), i32(98), i32(-1), 0
    )
    val address = nativePointerAddress(allocation)
    if (address <= 0 || address > 4294967295) return 1
    val frame = nativeBufferAt(address, 64)
    val aad = nativeBufferAt(address + 128, 30)
    val nonce = nativeBufferAt(address + 192, 13)
    val key = nativeBufferAt(address + 256, 32)
    val keyStorage = nativeBufferAt(
        address + 512, wifiCcmpKeyStateBytes
    )
    val keyState = wifiCcmpKeyState(keyStorage)
    nativeAddressClear(address, 1024)

    frame.storeU16(0, 47496)
    var index = 0
    while (index < 18) {
        frame.store(4 + index, index + 1)
        index = index + 1
    }
    frame.storeU16(22, 43973)
    frame.store(24, 247)
    frame.store(25, 171)
    val packetNumber = wifiCcmpPacketNumber(6618611909121)
    if (!wifiCcmpWritePacketHeader(frame, 26, packetNumber, 2) ||
        !wifiCcmpPacketHeaderValid(frame, 26) ||
        wifiCcmpPacketHeaderKeyIdentifier(frame, 26) != 2 ||
        wifiCcmpReadPacketNumber(frame, 26).rawValue() !=
            packetNumber.rawValue()) return 2
    if (!packetNumber.freshAfter(wifiCcmpPacketNumber(6618611909120)) ||
        packetNumber.freshAfter(packetNumber) ||
        wifiCcmpPacketNumber(wifiCcmpMaximumPacketNumber).next().valid() ||
        wifiCcmpPacketNumber(-1).next().rawValue() != 0) return 3

    val aadLength = wifiCcmpWriteAadAndNonce(frame, 26, 26, aad, nonce)
    if (aadLength != 24 || aad.loadU16(0) != 16776 ||
        aad.loadU16(20) != 5 || aad.load(22) != 7 || aad.load(23) != 0 ||
        nonce.load(0) != 7) return 4
    index = 0
    while (index < 6) {
        if (aad.load(2 + index) != index + 1 ||
            nonce.load(1 + index) != index + 7 ||
            nonce.load(7 + index) != 6 - index) return 5
        index = index + 1
    }
    if (!wifiCcmpWriteEspNowNonce(frame, 26, 26, nonce) ||
        nonce.load(0) != 0) return 24
    index = 0
    while (index < 6) {
        if (nonce.load(1 + index) != index + 7 ||
            nonce.load(7 + index) != 6 - index) return 25
        index = index + 1
    }
    frame.store(28, 1)
    if (wifiCcmpPacketHeaderValid(frame, 26) ||
        wifiCcmpWriteAadAndNonce(frame, 26, 26, aad, nonce) != -1) return 6

    nativeAddressClear(address, 64)
    frame.storeU16(0, 30720)
    if (!wifiCcmpWritePacketHeader(frame, 24, packetNumber, 0) ||
        wifiCcmpWriteAadAndNonce(frame, 24, 24, aad, nonce) != 22 ||
        aad.loadU16(0) != 16384 || nonce.load(0) != 16) return 7

    nativeAddressClear(address, 64)
    frame.storeU16(0, 17160)
    index = 0
    while (index < 6) {
        frame.store(24 + index, 160 + index)
        index = index + 1
    }
    if (!wifiCcmpWritePacketHeader(frame, 30, packetNumber, 1) ||
        wifiCcmpWriteAadAndNonce(frame, 30, 30, aad, nonce) != 28 ||
        nonce.load(0) != 0) return 8
    index = 0
    while (index < 6) {
        if (aad.load(22 + index) != 160 + index) return 9
        index = index + 1
    }

    frame.storeU16(0, 17288)
    frame.store(30, 141)
    frame.store(31, 255)
    if (!wifiCcmpWritePacketHeader(frame, 32, packetNumber, 1) ||
        wifiCcmpWriteAadAndNonce(frame, 32, 32, aad, nonce) != 30 ||
        aad.load(28) != 13 || aad.load(29) != 0 ||
        nonce.load(0) != 13) return 10
    if (wifiCcmpWriteAadAndNonceWithOptions(
        frame, 32, 32, aad, nonce, true
    ) != 30 || aad.load(28) != 141 || aad.load(29) != 0 ||
        nonce.load(0) != 141) return 11

    frame.storeU16(0, 16385)
    if (!wifiCcmpWritePacketHeader(frame, 24, packetNumber, 0) ||
        wifiCcmpWriteAadAndNonce(frame, 24, 24, aad, nonce) != -1) return 12
    frame.storeU16(0, 16388)
    if (wifiCcmpWriteAadAndNonce(frame, 24, 24, aad, nonce) != -1) return 13
    nativeAddressClear(address, 64)
    frame.storeU16(0, 8)
    index = 0
    while (index < 20) {
        frame.store(24 + index, 80 + index)
        index = index + 1
    }
    if (wifiCcmpEncapHeaderInPlace(
        frame, 44, 24, wifiCcmpPacketNumber(9), 2
    ) != 52 || (frame.loadU16(0) & 16384) == 0 ||
        wifiCcmpReadPacketNumber(frame, 24).rawValue() != 9) return 22
    index = 0
    while (index < 20) {
        if (frame.load(32 + index) != 80 + index) return 23
        index = index + 1
    }
    index = 0
    while (index < 32) {
        key.store(index, index + 1)
        index = index + 1
    }
    if (!keyState.initialize(key, 32, 16, 3) || !keyState.valid() ||
        keyState.keyLength() != 32 || keyState.tagLength() != 16 ||
        keyState.keyIdentifier() != 3 || keyState.key().load(31) != 32 ||
        keyState.transmitPacketNumber().rawValue() != 0) return 14
    if (keyState.reserveTransmitPacketNumberUnlocked().rawValue() != 1 ||
        keyState.reserveTransmitPacketNumberUnlocked().rawValue() != 2 ||
        keyState.transmitPacketNumber().rawValue() != 2) return 15
    if (keyState.replayPacketNumber(7).valid() ||
        !keyState.packetNumberAcceptedUnlocked(
            7, wifiCcmpPacketNumber(123)
        ) || !keyState.commitReplayPacketNumberUnlocked(
            7, wifiCcmpPacketNumber(123)
        ) || keyState.packetNumberAcceptedUnlocked(
            7, wifiCcmpPacketNumber(123)
        ) || !keyState.packetNumberAcceptedUnlocked(
            7, wifiCcmpPacketNumber(123), true
        ) || keyState.packetNumberAcceptedUnlocked(
            7, wifiCcmpPacketNumber(122)
        )) return 16

    nativeAddressClear(address, 64)
    frame.storeU16(0, 136)
    frame.store(24, 13)
    if (wifiCcmpTrafficIdentifier(frame, 26) != 13) return 17
    frame.storeU16(0, 904)
    frame.store(30, 6)
    if (wifiCcmpTrafficIdentifier(frame, 32) != 6) return 18
    frame.storeU16(0, 8)
    if (wifiCcmpTrafficIdentifier(frame, 24) !=
        wifiCcmpNonQosTrafficIdentifier) return 19
    frame.storeU16(0, 0)
    if (wifiCcmpTrafficIdentifier(frame, 24) !=
        wifiCcmpNonQosTrafficIdentifier) return 20
    frame.storeU16(0, 4)
    if (wifiCcmpTrafficIdentifier(frame, 24) != -1) return 21
    if (munmap(allocation, 4096) != i32(0)) return 7
    79
}
