import "../src/esp32/i2s/standard_mode_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var base = 0
var tx = false
var configWord = 0
var slotWord = 0
var writes = 0
var reads = 0
var active = 0
var bad = false
trusted fun esp32s3I2sClockRead(address: int): int {
    reads = reads + 1
    if (address != base + (if (tx) 36 else 32)) bad = true
    active
}
trusted fun esp32s3I2sClockField(address: int, mask: int, value: int): void {
    if (writes == 0) {
        val expectedMask = if (tx) 0x1e80e8 else 0x3e82a8
        if (address != base + (if (tx) 36 else 32) || mask != expectedMask || value != configWord) bad = true
    } else if (writes == 1) {
        if (address != base + (if (tx) 84 else 80) || mask != (if (tx) 0x1fffff else 0xfffff) || value != slotWord) bad = true
    } else if (writes == 2 && tx) {
        if (address != base + 64 || mask != 0x2000000 || value != 0) bad = true
    } else bad = true
    writes = writes + 1
    return
}
trusted fun i2sStandardTest(): int {
    var route = 0
    while (route < 4) {
        base = 0x6000f000 + (route / 2) * 0x1e000
        tx = (route & 1) != 0
        var slots = 1
        while (slots <= 3) {
            var flags = 0
            while (flags < 64) {
                configWord = 0x80000
                if ((flags & 2) != 0) configWord = configWord | 8
                if ((flags & 4) != 0) configWord = configWord | 0x20000
                if ((flags & 8) != 0) configWord = configWord | 0x40000
                if ((flags & 16) != 0) configWord = configWord | 0x8000
                if ((flags & 32) != 0) configWord = configWord | 128
                slotWord = 65536 | slots
                if ((flags & 1) != 0) {
                    if (!tx) configWord = configWord | 544
                    else if (slots == 3) { configWord = configWord | 96; slotWord = 65537 }
                } else if (tx && slots != 3) slotWord = slotWord | 0x100000
                writes = 0
                if (!esp32s3I2sSetStandardMode(route / 2, tx, slots, flags) || writes != (if (tx) 3 else 2) || bad) return 1
                flags = flags + 1
            }
            slots = slots + 1
        }
        writes = 0
        active = 4
        if (esp32s3I2sSetStandardMode(route / 2, tx, 3, 0) || writes != 0) return 2
        active = 256
        if (esp32s3I2sSetStandardMode(route / 2, tx, 3, 0) || writes != 0) return 3
        active = 0
        route = route + 1
    }
    reads = 0
    writes = 0
    if (esp32s3I2sSetStandardMode(-1, false, 3, 0) || esp32s3I2sSetStandardMode(2, true, 3, 0) || esp32s3I2sSetStandardMode(0, true, 0, 0) || esp32s3I2sSetStandardMode(0, true, 4, 0) || esp32s3I2sSetStandardMode(0, true, 3, -1) || esp32s3I2sSetStandardMode(0, true, 3, 64) || reads != 0 || writes != 0) return 4
    0
}
#exportFunction("i2sStandardTest", "abla_i2s_standard_test")
