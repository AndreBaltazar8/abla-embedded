import "../src/audio/pcm_channels.ab"
import "abla/runtime/scalar"
import "abla/build"
val channelsState=nativeStaticAllocate(256)
val channelsSource=nativeStaticAllocate(2)
val channelsMeta=nativeStaticAllocate(20)
val channelsAcc=nativeStaticAllocate(256)
val channelsScratch=nativeStaticAllocate(128)
val channelsOutput=nativeStaticAllocate(128)
@export("abla_pcm_channels_test")
trusted fun channelsTest(): i32 {
    val source=nativeBufferAt(channelsSource,2)
    source.storeU16(0,10000)
    val wav=pcmRaw(source,nativeBufferAt(channelsMeta,20),16000,1,16)
    val bank=pcmChannelsAt(nativeBufferAt(channelsState,256),8,16000)
    val acc=nativeBufferAt(channelsAcc,256)
    val scratch=nativeBufferAt(channelsScratch,128)
    val output=nativeBufferAt(channelsOutput,128)
    var i=7
    while (i >= 0) { if (bank.enqueue(wav,0) != i) return i32(1); i=i-1 }
    if (bank.playingChannels() != 8 || bank.enqueue(wav) != -1 ||
        !bank.render(32,acc,scratch,output,8192)) return i32(2)
    i=0
    while (i < 32) { if (output.loadU32(i*4) != 1310740000) return i32(3); i=i+1 }
    acc.storeU32(0,12345)
    if (bank.render(1,acc,scratch,source) || bank.render(1,acc,acc,output) || acc.loadU32(0) != 12345 ||
        bank.playingChannels() != 8) return i32(4)
    if (!bank.stop() || bank.playingChannels() != 0 || bank.enqueue(wav,1,0) != 0 ||
        bank.enqueue(wav,2,0) != 0 || bank.channel(0).isPlaying() != 2) return i32(5)
    if (!bank.render(4,acc,scratch,output) || output.loadU16(0) != 10000 ||
        output.loadU16(8) != 10000 || output.loadU32(12) != 0 || bank.playingChannels() != 0) return i32(6)
    // A later channel's malformed metadata must reject before channel0 advances.
    if (bank.enqueue(wav,2,0) != 0 || bank.enqueue(wav,2,7) != 7) return i32(7)
    var mode=0
    while (mode < 2) {
        val stereo=mode == 0
        var span=0
        while (span < 3) {
            acc.storeU32(0,12345);scratch.storeU32(0,6789);output.storeU32(0,4567)
            if (bank.renderOutput(1,if (span == 0) nativeBufferAt(channelsAcc,7) else acc,
                if (span == 1) nativeBufferAt(channelsScratch,3) else scratch,
                if (span == 2) nativeBufferAt(channelsOutput,if (stereo) 3 else 1) else output,stereo) ||
                bank.channel(0).storage().loadU32(12) != 2 || bank.channel(7).storage().loadU32(12) != 2 ||
                acc.loadU32(0) != 12345 || scratch.loadU32(0) != 6789 || output.loadU32(0) != 4567) return i32(9)
            span=span+1
        }
        mode=mode+1
    }
    bank.channel(7).storage().storeU32(4,32769)
    if (bank.render(1,acc,scratch,output) || bank.channel(0).storage().loadU32(12) != 2) return i32(8)
    bank.channel(7).storage().storeU32(4,32768)
    if (!bank.renderOutput(1,acc,scratch,output,false) || output.loadU16(0) != 20000) return i32(10)
    i32(0)
}
