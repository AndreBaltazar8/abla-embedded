import "../src/esp32/clock_pll_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_clock_pll_target")
@section(".iram1.abla.s3ClockPllTarget")
trusted fun pllTarget(mhz: int,rtc240: int,dig240: int,rtcLow: int,digLow: int): int =
    esp32S3ClockToReadyPllOwned(mhz,rtc240,dig240,rtcLow,digLow) | 0
