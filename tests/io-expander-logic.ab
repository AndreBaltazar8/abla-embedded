import "../src/io_expander/types.ab"
import "../src/io_expander/m5ioe1_logic.ab"

fun main: int {
    val pins = m5Ioe1Register(3, 0) == 3 && m5Ioe1Bit(0) == 1 &&
        m5Ioe1Register(3, 7) == 3 && m5Ioe1Bit(7) == 128 &&
        m5Ioe1Register(3, 8) == 4 && m5Ioe1Bit(8) == 1 &&
        m5Ioe1Register(3, 13) == 4 && m5Ioe1Bit(13) == 32
    val pwm = m5Ioe1PwmValue(2048, false, true) == 34816 &&
        m5Ioe1PwmValue(4095, true, false) == 20479
    val pulls = validPullMode(pullNone) && validPullMode(pullUp) &&
        validPullMode(pullDown) && !validPullMode(3)
    if (pins && pwm && pulls) 45 else 1
}
