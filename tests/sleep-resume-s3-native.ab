import "../src/esp32/power/sleep_resume_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Esp32S3ClockState = int
type Esp32S3ClockBias = int
type Esp32S3AnalogSleepState = int
type Esp32S3SleepUarts = int
fun Esp32S3SleepUarts.ready(): bool = this == 1
var events=0
var clocks=0
var analogs=0
var ms=0
var serial=0
var clockResult=80000000
var mspiResult=1
fun esp32S3ClockResumeFromXtalOwned(clock: Esp32S3ClockState,bias: Esp32S3ClockBias,polls: int): int { events=events*10+1; clocks=clocks+1; return clockResult }
fun esp32S3AnalogSleepRestoreOwned(analog: Esp32S3AnalogSleepState): void { events=events*10+2; analogs=analogs+1; return }
fun esp32S3MspiLowEndOwned(mspi: NativeBuffer,polls: int): int { events=events*10+3; ms=ms+1; return mspiResult }
fun Esp32S3SleepUarts.resumeOwned(): Esp32S3SleepUarts { events=events*10+4; serial=serial+1; return Esp32S3SleepUarts(0) }
fun run(progress: Esp32S3SleepResume): Esp32S3SleepResume = esp32S3SleepResumeOwned(progress,Esp32S3ClockState(123),Esp32S3ClockBias(456),Esp32S3AnalogSleepState(789),nativeBufferAt(4096,56),Esp32S3SleepUarts(1),8)
@export("abla_sleep_resume_test")
trusted fun resumeTest(): i32 {
    mspiResult=0
    while (mspiResult < 8) {
        events=0; clocks=0; analogs=0; ms=0; serial=0
        val result=run(esp32S3SleepResumeStart())
        if (!result.valid() || result.apbHertz() != 80000000 || clocks != 1 || analogs != 1 || ms != 1) return i32(1)
        if (mspiResult == 1) {
            if (!result.complete() || events != 1234 || serial != 1 || run(result) != result || events != 1234) return i32(2)
        } else if (mspiResult >= 2 && mspiResult <= 5) {
            if (result.status() != 3 || result.phase() != 3 || result.detail() != mspiResult || events != 123 || serial != 0) return i32(3)
            val failure=mspiResult; mspiResult=1; events=0
            val retried=run(result)
            if (!retried.complete() || events != 34 || clocks != 1 || analogs != 1 || ms != 2 || serial != 1) return i32(4)
            mspiResult=failure
        } else {
            if (result.status() != 4 || result.detail() != mspiResult || run(result) != result || events != 123 || serial != 0) return i32(5)
        }
        mspiResult=mspiResult+1
    }
    clockResult=-3; mspiResult=1; events=0
    val timeout=run(esp32S3SleepResumeStart())
    if (timeout.status() != 2 || timeout.phase() != 0 || timeout.detail() != 3 || events != 1) return i32(6)
    clockResult=80000000; events=0
    if (!run(timeout).complete() || events != 1234) return i32(7)
    clockResult=-4; events=0
    val fatal=run(esp32S3SleepResumeStart())
    if (fatal.status() != 4 || run(fatal) != fatal || events != 1) return i32(8)
    events=0
    if (run(Esp32S3SleepResume(0)).status() != 5 || events != 0) return i32(9)
    i32(0)
}
