import "../src/input/touch_controller.ab"

fun main(): int {
    var id=0
    while (id < 256) {
        var event=0
        while (event < 4) {
            val point=touchPoint(123,321,id,event,65535)
            val gesture=point.gesturePoint()
            val expected=id < 5 && (event == 0 || event == 2)
            if (gesture.valid() != expected) return 1
            if (expected && (gesture.x() != 123 || gesture.y() != 321 ||
                gesture.id() != id || gesture.size() != 65535)) return 2
            event=event+1
        }
        id=id+1
    }
    if (TouchPoint(0).gesturePoint().valid() ||
        touchPoint(32768,0,0,0).gesturePoint().valid() ||
        touchPoint(0,32768,0,0).gesturePoint().valid() ||
        !touchPoint(32767,32767,4,2).gesturePoint().valid()) return 3
    if (gesturePoint(-4,-9,2,0).x() != -4) return 4
    0
}
