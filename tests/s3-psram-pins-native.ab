import "../src/esp32/psram/pins_s3_sequence.ab"
import "abla/build"
var psPinMux=0
var psPinClock=0
var psPinTiming=0
var psPinWrites=0
var psPinReads=0
var psPinFail=0
var psPinBusy=0
var psPinBad=false
fun s3PsramCsRead(address: int): int {
    psPinReads=psPinReads+1
    if (address == 0x60002000) return if (psPinBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (psPinBusy == 2) 0x80000000 else 0
    if (address == 0x6000906c) return psPinMux
    if (address == 0x600033fc) return psPinClock
    if (address == 0x600030dc) return psPinTiming
    psPinBad=true;return 0
}
fun s3PsramCsWrite(address: int,value: int): void {
    val step=psPinWrites
    val expectedAddress=if (step < 2) 0x6000906c else if (step == 2) 0x600033fc else 0x600030dc
    val old=if (step < 2) psPinMux else if (step == 2) psPinClock else psPinTiming
    val mask=if (step == 0) 28672 else if (step == 1) 3072 else if (step == 2 || step == 3) 3 else if (step == 4) 3968 else if (step == 5) 124 else 2113929216
    val bits=if (step == 0) 0 else if (step == 1) 3072 else if (step == 2 || step == 3) 3 else if (step == 4) 384 else if (step == 5) 12 else 67108864
    if (address != expectedAddress || value != ((old&(4294967295-mask))|bits)) psPinBad=true
    psPinWrites=psPinWrites+1
    val stored=if (psPinWrites == psPinFail) value^(mask&(-mask)) else value
    if (step < 2) psPinMux=stored else if (step == 2) psPinClock=stored else psPinTiming=stored
    return
}
@export("abla_s3_psram_pins_test")
fun testPsramPins(): int {
    var profile=0
    while (profile < 256) {
        psPinFail=0
        while (psPinFail <= 7) {
            psPinMux=(profile*65537)^0xa55a5aa5
            psPinClock=(profile*16777217)^0x12345678
            psPinTiming=(profile*65539)^0xa3a3a3a3
            val oldClock=psPinClock;val oldMux=psPinMux
            psPinWrites=0;psPinReads=0;psPinBusy=0;psPinBad=false
            if (s3PsramPinsAndCsOwned(true) != (if (psPinFail == 0) 1 else 4) ||
                psPinWrites != (if (psPinFail == 0) 7 else psPinFail) || psPinBad) return 1
            if (psPinFail == 0 && ((psPinClock&0xfffffffc) != (oldClock&0xfffffffc) ||
                (psPinMux&0xffff83ff) != (oldMux&0xffff83ff))) return 2
            psPinFail=psPinFail+1
        }
        profile=profile+1
    }
    psPinReads=0;psPinWrites=0
    if (s3PsramPinsAndCsOwned(false) != 2 || psPinReads != 0 || psPinWrites != 0) return 3
    psPinBusy=1
    if (s3PsramPinsAndCsOwned(true) != 3 || psPinWrites != 0) return 4
    psPinBusy=2
    if (s3PsramPinsAndCsOwned(true) != 3 || psPinWrites != 0) return 5
    return 0
}
