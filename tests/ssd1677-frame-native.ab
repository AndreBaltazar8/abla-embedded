import "../src/display/ssd1677_frame.ab"
import "../src/display/ssd1677_lut.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(64)
val hashes=nativeStaticU32s([3941292666,168892866,2223677466,837750466])
@export("abla_ssd1677_frame_test")
trusted fun test(): i32 {
    var mode=1
    while (mode <= 4) {
        val table=ssd1677Lut(mode)
        var hash=2166136261
        var index=0
        while (index < 110) { hash=((hash^table.load(index))*16777619)&4294967295;index=index+1 }
        if (table.capacity() != 110 || hash != nativeAddressLoadU32(hashes,(mode-1)*4)) return i32(1)
        mode=mode+1
    }
    val canvas=nativeBufferAt(storage,16);val history=nativeBufferAt(storage+16,16)
    val output=nativeBufferAt(storage+32,4)
    var seed=0
    while (seed < 16) {
        var i=0
        while (i < 16) { canvas.store(i,(i*73+seed*17)&255);history.store(i,(i*41+seed*29)&255);i=i+1 }
        mode=1
        while (mode <= 3) {
            var variant=0
            while (variant < 8) {
                val bank=variant&1;val odd=(variant&2) != 0;val invert=(variant&4) != 0
                if (!ssd1677EncodeRowOwned(output,canvas,NativeBuffer(0),32,2,1,bank,mode,odd,invert,0,0,32,2,true)) return i32(2)
                i=0
                while (i < 4) {
                    val sourceBank=if (mode != 3 && odd) 1-bank else bank
                    if (output.load(i) != (canvas.load(4+i+sourceBank*8)^(if (invert) 0 else 255))) return i32(3)
                    i=i+1
                }
                variant=variant+1
            }
            mode=mode+1
        }
        var x=0
        while (x < 32) {
            var w=1
            while (w <= 32-x) {
                var row=0
                while (row < 2) {
                    var bank=0
                    while (bank < 4) {
                        val invert=bank >= 2
                        if (!ssd1677EncodeRowOwned(output,canvas,history,32,2,row,bank&1,4,true,invert,x,1,w,1,true)) return i32(4)
                        var pixel=0
                        while (pixel < 32) {
                            val bit=128>>(pixel&7);val offset=row*4+pixel/8
                            val oldL=(if ((history.load(offset)&bit) != 0) 1 else 0)^(if (invert) 1 else 0)
                            val oldM=(if ((history.load(offset+8)&bit) != 0) 1 else 0)^(if (invert) 1 else 0)
                            val newM=(if ((canvas.load(offset+8)&bit) != 0) 1 else 0)^(if (invert) 1 else 0)
                            var expected=oldM
                            if (row == 1 && pixel >= x && pixel < x+w) {
                                expected=if ((bank&1) == 0) newM else if (newM == 1) (if (oldL+oldM == 2) 1 else 0) else (if (oldL+oldM != 0) 1 else 0)
                            }
                            if ((if ((output.load(pixel/8)&bit) != 0) 1 else 0) != expected) return i32(5)
                            pixel=pixel+1
                        }
                        bank=bank+1
                    }
                    row=row+1
                }
                w=w+1
            }
            x=x+1
        }
        // Preserve all bits outside a non-byte-aligned history commit.
        if (!ssd1677RememberOwned(history,canvas,32,2,3,1,19,1,true,true)) return i32(6)
        i=0
        while (i < 16) {
            var expected=(i*41+seed*29)&255
            var bitIndex=0
            while (bitIndex < 8) {
                val pixel=(i%4)*8+bitIndex
                if ((i%8) >= 4 && pixel >= 3 && pixel < 22) {
                    val bit=128>>bitIndex
                    expected=(expected&~bit)|(canvas.load(i%8+8)&bit)
                }
                bitIndex=bitIndex+1
            }
            if (history.load(i) != expected) return i32(7)
            i=i+1
        }
        if (!ssd1677RememberOwned(history,canvas,32,2,0,0,32,2,false,true)) return i32(8)
        i=0
        while (i < 16) { if (history.load(i) != canvas.load(i)) return i32(9);i=i+1 }
        seed=seed+1
    }
    output.storeU32(0,0x12345678)
    if (ssd1677EncodeRowOwned(output,canvas,NativeBuffer(0),32,2,0,0,4,false,false,0,0,32,2,true) ||
        ssd1677EncodeRowOwned(canvas,canvas,history,32,2,0,0,1,false,false,0,0,32,2,true) ||
        ssd1677RememberOwned(canvas,canvas,32,2,0,0,32,2,false,true) || output.loadU32(0) != 0x12345678) return i32(10)
    return i32(0)
}
