import "./i2s-capture-session-c6-native.ab"
import "../src/esp32/i2s/capture_cancel_c6_sequence.ab"
@export("abla_i2s_capture_cancel_c6_test")
trusted fun testCancel(): i32 {
    val memory=nativeStaticAllocate(2200);val session=nativeBufferAt(memory,364);val cancel=nativeBufferAt(memory+364,32)
    registers=nativeBufferAt(memory+396,1536);descriptors=nativeBufferAt(memory+1932,24)
    channel=0;cancelModel=true
    while (channel < 3) {
        var scenario=0
        while (scenario < 3) {
            var at=0
            while (at < 396) { nativeBufferAt(memory,396).storeU32(at,0);at=at+4 }
            initialize(nativeBufferAt(memory+40,180));drop=0;resetCount=0
            seed(0x60080000+channel*16,0);seed(0x6000c00c,0)
            delayed=scenario == 0
            val opened=c6CaptureOpenOwned(session,channel,1,240000000,48000,0,0,1,2,3,-1,16,16,16,true,0x40800000,2,0x40810000,64,64,1,true)
            if (opened != (if (scenario == 0) 5 else 1)) return i32(20)
            if (scenario == 0) {
                if (c6CaptureCancelOwned(session,cancel,1,1,0,false,true) != 5 || starts != 0) return i32(21)
                delayed=false
            } else {
                setRegister(0x60080078+channel*192,u32(0))
                if (scenario == 2) {
                    setRegister(0x60080000+channel*16,u32(4));setRegister(0x6000c00c,u32(5))
                    if (c6CapturePollOwned(session,1,1,true) != 3) return i32(22)
                    if (c6CaptureCancelOwned(session,cancel,1,1,0,false,true) != 10 ||
                        c6CaptureCancelOwned(session,cancel,1,1,4,false,true) != 10 || acknowledgements != 0) return i32(23)
                }
                if (c6CaptureCancelOwned(session,cancel,1,1,if (scenario == 2) 4 else 0,false,true,if (scenario == 2) 4 else 0) != 9 || resetCount != 0) return i32(24)
            }
            var result=c6CaptureCancelOwned(session,cancel,1,1,if (scenario == 2) 4 else 0,true,true,if (scenario == 2) 4 else 0)
            if (result == 5) result=c6CaptureCancelOwned(session,cancel,1,1,if (scenario == 2) 4 else 0,true,true,if (scenario == 2) 4 else 0)
            if (result != 8 || c6CapturePollOwned(session,1,1,true) != 8 || resetCount != (if (scenario == 0) 0 else 1) || bad) return i32(25)
            if (starts != (if (scenario == 0) 0 else 1) || stops != (if (scenario == 0) 0 else 1)) return i32(26)
            if (scenario == 2 && (cancel.loadU32(12) != 4 || cancel.loadU32(24) != 5 || session.loadU32(8) == 0)) return i32(27)
            var index=0
            while (index < entries) {
                if (registers.loadU32(index*12+4) != registers.loadU32(index*12+8)) return i32(28)
                index=index+1
            }
            scenario=scenario+1
        }
        channel=channel+1
    }
    cancelModel=false;return i32(0)
}
