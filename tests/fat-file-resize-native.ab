import "../src/storage/fat_file_resize.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(8192)
val image=nativeStaticAllocate(3584)
var writes=0
var failAt=0
var bad=false
var nested=false
var file=FatFile(0)
fun slot(lba: int): int = if (lba == 1) 0 else if (lba == 41) 1 else if (lba == 81) 2
    else if (lba >= 113 && lba <= 116) lba-110 else -1
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    val selected=slot(lba)
    if (selected < 0 && lba != 0) return false
    val source=if (lba == 0) nativeBufferAt(memory+64,512) else nativeBufferAt(image+selected*512,512)
    var i=0;while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool {
    writes=writes+1;val selected=slot(lba)
    if (selected < 0) return false
    if (nested) {
        nested=false
        if (file.resize(u32(8),50,64,rtcCalendarDateTime(2026,9,9,12,0,0),
            nativeBufferAt(memory+7168,32),nativeBufferAt(memory+4608,2560)).status() != 12) bad=true
    }
    val output=nativeBufferAt(image+selected*512,512);var i=0
    while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return writes != failAt
}
@export("abla_fat_file_resize_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,32);val reader=nativeBufferAt(memory+32,28);val boot=nativeBufferAt(memory+64,512)
    val handle=nativeBufferAt(memory+576,80);val work=nativeBufferAt(memory+704,2560)
    val output=nativeBufferAt(memory+3328,512);val plan=nativeBufferAt(memory+3840,32);val name=nativeBufferAt(memory+3904,2)
    val directory=nativeBufferAt(image+1024,512);val data=nativeBufferAt(image+1536,1536)
    var i=0;while (i < 512) { boot.store(i,0);i=i+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2)
    boot.storeU16(17,512);boot.storeU16(22,40);boot.storeU16(19,10113);boot.storeU16(510,0xaa55)
    name.storeU16(0,97)
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    val modified=rtcCalendarDateTime(2026,9,9,12,0,0)
    var mode=0
    while (mode < 10) {
        i=0;while (i < 3584) { nativeBufferAt(image,3584).store(i,77);i=i+1 }
        var copy=0;while (copy < 2) {
            val fat=nativeBufferAt(image+copy*512,512);i=0
            while (i < 512) { fat.store(i,255);i=i+1 }
            fat.storeU16(6,0);fat.storeU16(8,0);copy=copy+1
        }
        i=0;while (i < 512) { directory.store(i,0);i=i+1 }
        i=1;while (i < 11) { directory.store(i,32);i=i+1 }
        directory.store(0,65);directory.storeU16(26,2);directory.storeU32(28,100)
        val volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,output)
        // Previous iteration's handle is retired; its storage may be freshened.
        file=FatFile(0)
        if (!fatFileInitializeFresh(handle,volume,u32(7))) return i32(2)
        file=fatFileOpen(handle,u32(7),0,name,1,64,work)
        if (file.status() != 1) return i32(3)
        writes=0;failAt=if (mode == 0) 1 else if (mode == 1) 12 else 0;nested=true
        val grown=file.resize(u32(7),1200,64,modified,NativeBuffer(0),work)
        if (!grown.isGrowth() || bad) return i32(4)
        if (mode < 2) {
            if (grown.status() != (if (mode == 0) 7 else 10) || writes != failAt ||
                handle.loadU32(68) != 100 || state.loadU32(12) != 3) return i32(5)
        } else {
            if (grown.status() != 1 || writes != 12 || handle.loadU32(68) != 1200) return i32(6)
            i=0;while (i < 1200) { if (data.load(i) != (if (i < 100) 77 else 0)) return i32(7);i=i+1 }
            if (file.readAt(u32(7),1100,10,64,output,work).bytesRead() != 10 || output.load(0) != 0) return i32(8)
            writes=0;failAt=mode-2
            val shrunk=file.resize(u32(7),0,64,modified,plan,work)
            if (shrunk.isGrowth() || writes != (if (mode == 2) 7 else failAt)) return i32(9)
            if (mode == 2) {
                if (shrunk.status() != 1 || shrunk.freedClusters() != 3 || handle.loadU32(68) != 0 || handle.loadU16(66) != 0 ||
                    file.readAt(u32(7),0,1,64,output,work).status() != 2) return i32(10)
                if (file.resize(u32(7),20,64,modified,NativeBuffer(0),work).status() != 1 || handle.loadU32(68) != 20 ||
                    file.readAt(u32(7),0,20,64,output,work).bytesRead() != 20 || output.load(0) != 0) return i32(11)
                val prior=writes;directory.store(11,0)
                if (file.resize(u32(7),10,64,modified,plan,work).status() != 3 || writes != prior || state.loadU32(12) != 1) return i32(12)
                if (!file.close(u32(7)) || file.resize(u32(7),0,64,modified,plan,work).status() != 13) return i32(13)
            } else if (shrunk.status() != (if (failAt == 1) 8 else 10) || handle.loadU32(68) != 1200 ||
                state.loadU32(12) != 3 || shrunk.freedClusters() != (if (failAt == 1) 0 else (failAt-2)>>1)) return i32(14)
        }
        if (!volume.invalidate(u32(7))) return i32(15)
        mode=mode+1
    }
    return i32(0)
}
