import "../src/sd/mmc_command_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(16)
var command=0
var argument=0
var events=0
var status=0
var writes=0
var drop=false
trusted fun sdMmcS3Read(offset: int): int = if (offset == 44) command else if (offset == 40) argument else if (offset == 68) events else if (offset == 72) status else 0x11220000+offset
trusted fun sdMmcS3Write(offset: int,value: int): void {
    writes=writes+1
    if (offset == 44) command=value
    if (offset == 40 && !drop) argument=value
    if (offset == 68) events=events&~value
    return
}
@export("abla_sdmmc_command_test")
trusted fun test(): i32 {
    val output=nativeBufferAt(storage,16)
    var kind=0
    while (kind <= 4) {
        command=0; status=0; events=0x10001; writes=0
        var state=sdMmcCommandStartOwned(1,8,u32(426),kind,true)
        if (state.status() != 2 || command != sdMmcCommandWord(1,8,kind,true) || argument != 426 || writes != 3 || events != 0x10001) return i32(1)
        output.storeU32(0,42)
        state=state.pollOwned(output)
        if (state.status() != 2 || output.loadU32(0) != 42) return i32(2)
        command=command&0x7fffffff; events=events|4; status=if (kind == 4) 512 else 0
        state=state.pollOwned(output)
        if (kind == 4) {
            if (state.status() != 2 || output.loadU32(0) != 42) return i32(3)
            status=0; state=state.pollOwned(output)
        }
        if (state.status() != 1 || events != 0x10001 || output.loadU32(0) != (if (kind == 0) 0 else 0x11220030) || output.loadU32(12) != (if (kind == 2) 0x1122003c else 0)) return i32(4)
        kind=kind+1
    }
    var bit=0
    while (bit < 16) {
        if (((1<<bit)&0x1542) != 0) {
            events=(1<<bit)|4; output.storeU32(0,42)
            val error=SdMmcCommand(2).pollOwned(output)
            if (error.status() != 5 || error.events() != ((1<<bit)|4) || output.loadU32(0) != 42) return i32(5)
        }
        bit=bit+1
    }
    command=0x80000000; writes=0
    if (sdMmcCommandStartOwned(0,8,u32(0),1).status() != 4 || writes != 0) return i32(6)
    command=0; status=1024
    if (sdMmcCommandStartOwned(0,8,u32(0),1).status() != 4 || writes != 0 || sdMmcCommandWord(0,17,1,false) != -1) return i32(7)
    status=0; events=0; drop=true; argument=1
    if (sdMmcCommandStartOwned(0,8,u32(2),1).status() != 5 || command != 0) return i32(8)
    if (SdMmcCommand(2).pollOwned(nativeBufferAt(storage,15)).status() != 3) return i32(9)
    return i32(0)
}
