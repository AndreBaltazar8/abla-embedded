import "../src/esp32/task_launch_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var enabled=0
var status=0x4002F
var vectors=0x40378000
var depth=0
var ps=0x50030
var cp=0
var calls=0
var bad=false
fun esp32S3TaskLaunchCore(): int = core
fun esp32S3TaskLaunchEnabled(): int = enabled
fun esp32S3TaskLaunchStatus(): int = status
fun esp32S3TaskLaunchVectors(): int = 0x40378000
fun esp32S3TaskLaunchCurrentVectors(): int = vectors
fun esp32S3TaskLaunchConfig(): int = 4096
fun esp32S3TaskFrameReturnAddress(): int = 0x40379000
fun esp32S3TaskFrameEntryAddress(): int = 0x4037A000
fun esp32S3TaskLaunchRead(address: int): int {
    if (address < 8192) {
        val offset=address-4096-core*32
        if (offset == 0) return 0x3FC94FD0
        if (offset == 4) return depth
        if (offset == 8 || offset == 24) return 0x4037B000
    } else {
        val offset=address-0x3FC90330
        if (offset == 0) return 0x40379000
        if (offset == 4) return 0x4037A000
        if (offset == 8) return ps
        if (offset == 12) return 0
        if (offset == 16) return 0x3FC903F0
        if (offset == 148) return cp
    }
    bad=true; return 0
}
fun esp32S3TaskLaunchTransfer(address: int): void { if (address != 0x3FC90330) bad=true; calls=calls+1; return }
@export("abla_task_launch_test")
trusted fun launchTest(): i32 {
    val stack=nativeBufferAt(0x3FC90000,1024)
    val frame=nativeBufferAt(0x3FC90330,192)
    while (core < 2) {
        calls=0
        if (!esp32S3TaskLaunchFirstOwned(stack,frame,core) || calls != 1 || bad) return i32(1)
        calls=0; enabled=1
        if (esp32S3TaskLaunchFirstOwned(stack,frame,core)) return i32(2)
        enabled=0; vectors=0x40000000
        if (esp32S3TaskLaunchFirstOwned(stack,frame,core)) return i32(3)
        vectors=0x40378000; depth=1
        if (esp32S3TaskLaunchFirstOwned(stack,frame,core)) return i32(4)
        depth=0; ps=0x40030
        if (esp32S3TaskLaunchFirstOwned(stack,frame,core)) return i32(5)
        ps=0x50030; cp=1
        if (esp32S3TaskLaunchFirstOwned(stack,frame,core)) return i32(6)
        cp=0; status=0x4003F
        if (esp32S3TaskLaunchFirstOwned(stack,frame,core) || calls != 0 || bad) return i32(7)
        status=0x4002F; core=core+1
    }
    i32(0)
}
