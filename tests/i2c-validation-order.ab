// Guard the real facade/backend admission order, not a duplicate cache model.

import "../tools/lib/source_text.ab"
import "abla/text"

fun main: int {
    var facade = sourceAfter(sourceRead("src/esp32/i2c_idf6.ab"), "trusted fun i2cMaster(")
    facade = sourceBefore(facade, "fun I2cBus.valid")
    val guard = "if (!espChip32().i2cMasterConfigurationValid(port, sda, scl)) return I2cBus(0)"
    sourceOrder(facade, guard, "i2cPinsValue(sda, scl)", "facade validates before packing the pins")
    sourceOrder(facade, guard, "storedI2cBus(port)", "facade validates before the bus cache")
    for (kind in ["hardware", "software"]) {
        val source = sourceRead("src/esp32/i2c/${kind}_master_esp32.ab")
        val marker = if (kind == "hardware") "fun i2c_new_master_bus(" else "fun softwareI2cNewMasterBus("
        val body = sourceBefore(sourceAfter(source, marker), "val bus = esp32LibcMalloc")
        sourceHas(body, "espChip32().i2cMasterConfigurationValid(", "$kind backend validates before allocating")
        sourceHas(body, "int(port), int(sdaNumber), int(sclNumber)", "$kind backend validates the real port and pins")
    }
    sourceFinish("PASS: real I2C validation precedes cache/packing and backend allocation")
}
