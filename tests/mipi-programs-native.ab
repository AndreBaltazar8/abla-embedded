import "../src/display/mipi_programs.ab"
import "../src/display/software_program.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")

type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
var selected = false
var bad = false
var edges = 0
var delayTotal = 0
trusted fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 3) {
        if (selected == !high) bad = true
        selected = !high
    }
    if (this == 1 && high && selected) edges = edges + 1
    return
}
fun Pin.read(): bool { bad = true; false }
fun Pin.input(): void { bad = true; return }
fun Pin.output(): void { bad = true; return }
fun peripheralDelayMicroseconds(duration: int): void { bad = true; return }
trusted fun peripheralDelayMilliseconds(duration: int): void {
    if (selected || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    delayTotal = delayTotal + duration
    return
}

trusted fun checkProgram(program: NativeBuffer, wireBytes: int, milliseconds: int): bool {
    edges = 0
    delayTotal = 0
    if (!lcdCommandBufferValid(program, program.capacity())) return false
    val result = softwareLcdRunProgram(peripheralGateAt(gateStorage), u32(7),
        Pin(1), Pin(2), Pin(3), Pin(4), program, program.capacity(), 0)
    result.valid() && !bad && !selected && edges == wireBytes * 8 &&
        delayTotal == milliseconds && nativeAddressLoadU32(gateStorage, 0) == 0
}

@export("abla_mipi_programs_native_test")
trusted fun mipiProgramsNativeTest(): i32 {
    if (!checkProgram(st7789InitProgram(), 52, 130)) return i32(1)
    if (!checkProgram(st7735SInitProgram(), 74, 760)) return i32(2)
    if (!checkProgram(ili9342InitProgram(), 57, 120)) return i32(3)
    if (!checkProgram(ili9342EInitProgram(), 58, 240)) return i32(4)
    i32(0)
}
