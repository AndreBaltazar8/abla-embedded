import "../src/display/mipi_programs.ab"
import "../src/display/software_program.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
import "../src/hal/delay.ab"
import "../src/hal/pin.ab"
import "abla/unsafe/memory/raw"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/display/command_buffer.ab"
import "../src/peripheral_gate.ab"
import "../src/hal/spitransactionresult.ab"
import "../src/esp32/sdk/nativebuffer_type.ab"
#requiredInternalFunction("freestandingMemorySet32", "memset")

@exportLocal("abla_pin_valid")
fun pinValidHook(pin: int): bool = Pin(pin) >= 1 && Pin(pin) <= 4
@exportLocal("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin).valid()
val gateStorage = nativeStaticMutableU32s([0])
var selected = false
var bad = false
var edges = 0
var delayTotal = 0
@exportLocal("abla_pin_write")
trusted fun pinWriteHook(pin: int, high: bool): void {
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (Pin(pin) == 3) {
        if (selected == !high) bad = true
        selected = !high
    }
    if (Pin(pin) == 1 && high && selected) edges = edges + 1
    return
}
@exportLocal("abla_pin_read")
fun pinReadHook(pin: int): bool { bad = true; false }
@exportLocal("abla_pin_input")
fun pinInputHook(pin: int): void { bad = true; return }
@exportLocal("abla_pin_output")
fun pinOutputHook(pin: int): void { bad = true; return }
@export("peripheralDelayMicroseconds")
fun peripheralDelayMicrosecondsHook(duration: int): void { bad = true; return }
@export("peripheralDelayMilliseconds")
trusted fun peripheralDelayMillisecondsHook(duration: int): void {
    if (selected || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    delayTotal = delayTotal + duration
    return
}

trusted fun checkProgram(program: NativeBuffer, wireBytes: int, milliseconds: int): bool {
    edges = 0
    delayTotal = 0
    if (!lcdCommandBufferValid(program, program.capacity())) return false
    val result = softwareLcdRunProgram(peripheralGateAt(gateStorage), u32(7),
        Pin(1), Pin(2), Pin(3), Pin(4), program, program.capacity(), 0)
    result.valid() && !bad && !selected && edges == wireBytes * 8 &&
        delayTotal == milliseconds && nativeAddressLoadU32(gateStorage, 0) == 0
}

@export("abla_mipi_programs_native_test")
trusted fun mipiProgramsNativeTest(): i32 {
    if (!checkProgram(st7789InitProgram(), 52, 130)) return i32(1)
    if (!checkProgram(st7735SInitProgram(), 74, 760)) return i32(2)
    if (!checkProgram(ili9342InitProgram(), 57, 120)) return i32(3)
    if (!checkProgram(ili9342EInitProgram(), 58, 240)) return i32(4)
    i32(0)
}
