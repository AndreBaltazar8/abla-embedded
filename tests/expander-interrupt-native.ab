import "../src/i2c/results.ab"
import "../src/m5stack/expander_interrupt.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var bad=false
var calls=0
var fail=false
var operation=0
var expectedValue=0
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    calls=calls+1
    if (this != 8 || operation != 2 || register != 19) bad=true
    if (fail) I2cByteResult(0) else I2cByteResult(256)
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    if (this != 8 || operation != 0 || register != 17 || value != expectedValue) bad=true
    !fail
}
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool {
    calls=calls+1
    if (this != 8 || (operation != 1 && operation != 3) || register != (if (operation == 1) 13 else 17) || value != expectedValue) bad=true
    !fail
}
@export("abla_expander_interrupt_test")
trusted fun interruptTest(): i32 {
    val owner=m5ExpandersAt(nativeBufferAt(nativeStaticAllocate(32),32))
    var kind=1
    while (kind <= 2) {
        owner.initialize(); owner.buffer().storeU32(8,if (kind == 1) m5BoardStampPLC | 0 else m5BoardCoreMatrix | 0)
        owner.storeSlot(0,M5ExpanderOpen(8|(kind<<32)|(1<<40))); owner.buffer().storeU32(4,1)
        var profile=0
        while (profile < 32772) {
            val mask=profile%16386-1
            fail=profile >= 16386; operation=kind-1
            expectedValue=if (kind == 1) 255-mask else mask
            val valid=mask >= 0 && mask <= (if (kind == 1) 255 else 16383)
            calls=0; bad=false
            if (owner.setInterruptMask(0,mask) != (valid && !fail) || calls != (if (valid) 1 else 0) || bad) return i32(1)
            profile=profile+1
        }
        profile=0
        while (profile < 4) {
            val enabled=(profile & 1) != 0
            fail=profile >= 2; operation=kind-1
            expectedValue=if (kind == 1) (if (enabled) 0 else 255) else if (enabled) 16383 else 0
            calls=0; bad=false
            if (owner.setInterruptsEnabled(0,enabled) != !fail || calls != 1 || bad) return i32(2)
            operation=kind+1; expectedValue=0; calls=0
            if (owner.resetInterrupt(0) != !fail || calls != 1 || bad) return i32(3)
            profile=profile+1
        }
        calls=0
        if (owner.setInterruptMask(-1,0) || owner.setInterruptsEnabled(1,true) || owner.resetInterrupt(1) || calls != 0) return i32(4)
        owner.buffer().storeU32(4,6)
        if (owner.setInterruptMask(0,0) || owner.setInterruptsEnabled(0,true) || owner.resetInterrupt(0) || calls != 0) return i32(5)
        kind=kind+1
    }
    i32(0)
}
