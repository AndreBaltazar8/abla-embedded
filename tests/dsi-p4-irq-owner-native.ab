import "../src/display/dsi_irq_owner_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/hal/display.ab"
import "../src/hal/esp32.ab"
import "../src/hal/esp32_2.ab"
import "../src/hal/display_3.ab"
import "abla/unsafe/memory/raw"
import "../src/display/dsi_events_p4_sequence.ab"
import "../src/display/dsi_mailbox_p4_sequence.ab"
import "../src/esp32/irq_dispatch_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/hal/native_buffer.ab"
val boxMemory=nativeStaticAllocate(28)
val tableMemory=nativeStaticAllocate(272)
var core=0
var enabled=u32(0)
var cpu=false
var bound=false
var mapping=0
var other=0
var fail=0
var closing=false
var bad=false
var closeTrace=0
@export("p4DsiMailboxCore")
fun p4DsiMailboxCoreHook(): int = core
@export("p4DsiMailboxMasked")
fun p4DsiMailboxMaskedHook(): bool = true
@export("p4DispatchCore")
fun p4DispatchCoreHook(): int = core
@export("p4DispatchMasked")
fun p4DispatchMaskedHook(): bool = true
@export("p4DispatchLineEnabled")
fun p4DispatchLineEnabledHook(line: int): bool = cpu
@export("p4DispatchFence")
fun p4DispatchFenceHook(): void { return }
@export("p4DispatchCall")
fun p4DispatchCallHook(handler: int,frame: int,line: int,cpu: int,context: int): void { bad=true; return }
@export("p4DsiBridgeRead")
fun p4DsiBridgeReadHook(offset: int): u32 = enabled
@export("p4DsiBridgeWrite")
fun p4DsiBridgeWriteHook(offset: int,value: u32): void {
    if (offset != 80) bad=true
    if (closing) closeTrace=closeTrace*10+1
    if (fail != (if (closing) 1 else 5)) enabled=value
    return
}
@export("p4DsiIrqLineEnabled")
fun p4DsiIrqLineEnabledHook(line: int): bool = cpu
@export("p4DsiIrqSourceEnabled")
fun p4DsiIrqSourceEnabledHook(layout: int): int = int(enabled)&esp32P4DsiEventMask(layout)
@export("p4DsiIrqRouteRead")
fun p4DsiIrqRouteReadHook(layout: int,cpu: int): int = if (cpu == core) mapping else other
@export("p4DsiIrqRoute")
fun p4DsiIrqRouteHook(layout: int,cpu: int,expected: int,target: int): int {
    if (mapping != expected || cpu != core) { bad=true; return 3 }
    if (closing) closeTrace=closeTrace*10+3
    if (closing && fail == 3) return 4
    mapping=target
    return if (!closing && fail == 3) 4 else 1
}
@export("p4DsiIrqBind")
fun p4DsiIrqBindHook(box: P4DsiMailbox,table: P4IrqDispatch,remove: bool): int {
    if (remove) {
        closeTrace=closeTrace*10+4
        if (cpu || mapping != 0 || enabled != u32(0)) bad=true
        if (fail == 4) return 3
        bound=false; return 1
    }
    if (fail == 1) return 3
    bound=true; return 1
}
@export("p4DsiIrqConfigure")
fun p4DsiIrqConfigureHook(line: int,priority: int): int = if (fail == 2) 4 else 1
@export("p4DsiIrqEnableLine")
fun p4DsiIrqEnableLineHook(line: int,value: bool): int {
    if (closing) closeTrace=closeTrace*10+2
    if (closing && fail == 2) return 4
    cpu=value
    return if (!closing && fail == 4) 4 else 1
}
@export("abla_dsi_p4_irq_owner_test")
fun testOwner(): i32 {
    val box=p4DsiMailboxAt(nativeBufferAt(boxMemory,28))
    val table=p4IrqDispatchAt(nativeBufferAt(tableMemory,272))
    while (core < 2) {
        var layout=1
        while (layout <= 3) {
            var stage=0
            while (stage <= 5) {
                box.initialize(core,layout,16); table.initialize(core)
                enabled=u32(0); cpu=false; bound=false; mapping=0; closing=false; fail=stage
                val opened=esp32P4DsiIrqOpenOwned(box,table,3)
                if ((opened&255) != (if (stage == 0) 1 else stage+3)) return i32(1)
                closing=true; fail=0; closeTrace=0
                if (esp32P4DsiIrqCloseOwned(box,table,opened) != 1 || bound || cpu || mapping != 0 || enabled != u32(0) || bad) return i32(2)
                stage=stage+1
            }
            stage=1
            while (stage <= 4) {
                box.initialize(core,layout,16); table.initialize(core)
                enabled=u32(0); cpu=false; bound=false; mapping=0; closing=false; fail=0
                val opened=esp32P4DsiIrqOpenOwned(box,table,3)
                closing=true; fail=stage; closeTrace=0
                val partial=esp32P4DsiIrqCloseOwned(box,table,opened)
                if ((partial&255) != stage+8) return i32(3)
                fail=0; closeTrace=0
                if (esp32P4DsiIrqCloseOwned(box,table,partial) != 1 || closeTrace !=
                    (if (stage == 1) 1234 else if (stage == 2) 234 else if (stage == 3) 34 else 4) || bad) return i32(4)
                stage=stage+1
            }
            layout=layout+2
        }
        core=core+1
    }
    core=1; closing=false; other=17
    box.initialize(core,3,16)
    if (esp32P4DsiIrqOpenOwned(box,table,3) != 3 || bound) return i32(5)
    return i32(0)
}
