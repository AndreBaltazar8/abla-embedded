import "./corematrix-wire-native.ab"
import "../src/m5stack/corematrix_buttons.ab"
import "../src/m5stack/button_state.ab"
import "abla/runtime/scalar"
val buttonsBefore=nativeStaticAllocate(512)
@export("abla_corematrix_buttons_wire_test")
trusted fun testButtons(): i32 {
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    wireSeed()
    if (!control.initialize() || control.pollButtonLevelsOwned(true).validMask() != 0 || ackCount != 0) return i32(1)
    if (control.openOwned(40000000,20000000,true) != 1) return i32(2)
    val r=nativeBufferAt(registers,512)
    val snapshot=nativeBufferAt(buttonsBefore,512)
    var levels=0
    while (levels < 256) {
        r.store(274,levels)
        var at=0;while (at < 512) { snapshot.store(at,r.load(at));at=at+1 }
        val before=ackCount;val stopBefore=stops
        val frame=control.pollButtonLevelsOwned(true)
        if (frame.validMask() != 7 || frame.pressedMask() != ((~levels)&7) ||
            ackCount != before+3 || stops != stopBefore+1 || bad) return i32(3)
        at=0;while (at < 512) { if (snapshot.load(at) != r.load(at)) return i32(4);at=at+1 }
        levels=levels+1
    }
    val before=ackCount
    if (control.pollButtonLevelsOwned(false).validMask() != 0 || ackCount != before) return i32(5)
    if (!softwareI2cProviderEnter()) return i32(6)
    val busy=control.pollButtonLevelsOwned(true)
    if (!softwareI2cProviderLeave() || busy.validMask() != 0 || ackCount != before) return i32(7)
    // Keep a previously pressed state through each read-address/register NACK.
    var button=m5Button(true,0).updateFrom(m5ButtonRead(true,true),0)
    var fail=1
    while (fail <= 3) {
        val start=ackCount;nackAt=start+fail
        val frame=control.pollButtonLevelsOwned(true)
        button=button.updateFrom(frame.read(0),fail*1000)
        if (frame.validMask() != 0 || frame.pressedMask() != 0 || ackCount != start+fail ||
            button.sampleValid() || !button.state().isPressed() || button.state().isHolding() || bad) return i32(8)
        fail=fail+1
    }
    nackAt=0;r.store(274,7)
    val released=control.pollButtonLevelsOwned(true)
    button=button.updateFrom(released.read(0),4000)
    if (!button.sampleValid() || !button.state().isPressed()) return i32(9)
    button=button.updateFrom(released.read(0),4020)
    if (button.state().isPressed()) return i32(10)
    if (!control.closeOwned(true) || control.pollButtonLevelsOwned(true).validMask() != 0 || pads != 0 || bad) return i32(11)
    return i32(0)
}
