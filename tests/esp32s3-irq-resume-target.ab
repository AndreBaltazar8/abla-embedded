import "../src/esp32/irq_resume_esp32s3.ab"
import "../src/esp32/vectors_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_irq_resume_target")
@section(".iram1.abla.s3IrqResumeTarget")
trusted fun resumeTarget(old: NativeBuffer,next: NativeBuffer,core: int,level: int,mode: int): int {
    if (mode == 0) return esp32S3VectorsAddress()
    if (esp32S3IrqResumeSelectOwned(old,next,core,level)) 1 else 0
}
