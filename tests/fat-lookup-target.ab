import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/storage/fat_software_sd.ab"
import "../src/storage/fat_lookup.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_lookup_target")
trusted fun target(reader: int,boot: int,first: int,sectors: int,start: int,name: int,budget: int,sector: int,scratch: int): int =
    fatLookupShortOwned(nativeBufferAt(reader,28),nativeBufferAt(boot,512),first,sectors,start,nativeBufferAt(name,11),budget,nativeBufferAt(sector,512),nativeBufferAt(scratch,1024)).firstCluster()
