import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/gdma_events_c6_sequence.ab"
var channel=0
var tx=false
var raw=u32(0)
var irq=false
var enabled=true
var stuck=false
var writes=0
var last=u32(0)
var bad=false
trusted fun c6GdmaBusRead(): u32 = if (enabled) u32(1) else u32(0)
trusted fun c6GdmaBusWrite(v: u32): void { bad=true;return }
trusted fun c6GdmaRead(at: int): u32 {
    if (!enabled) bad=true
    if (at == 0x64) return u32(8)
    val base=channel*16+(if (tx) 48 else 0)
    if (at == base) return raw
    if (at == base+8) return if (irq) u32(1) else u32(0)
    bad=true;return u32(0)
}
trusted fun c6GdmaWrite(at: int,v: u32): void {
    writes=writes+1;last=v
    if (at != channel*16+(if (tx) 48 else 0)+12) bad=true
    if (!stuck) raw=raw&~v
    return
}
@export("abla_gdma_events_c6_test")
trusted fun test(): i32 {
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 1
            var bits=0
            while (bits < (if (tx) 64 else 128)) {
                var selected=0
                while (selected < 256) {
                    raw=u32(bits);writes=0
                    val events=c6GdmaEventsReadOwned(channel,tx,true)
                    if (events.status() != 1 || events.raw() != bits || events.errors() != (bits&(if (tx) 52 else 124)) || events.eof() != ((bits&2) != 0) || events.descriptorDone() != ((bits&1) != 0) || events.txTotalEof() != (tx && (bits&8) != 0)) return i32(1)
                    val handled=bits&selected
                    if (events.acknowledgeOwned(handled,true) != 1 || raw != u32(bits&~handled) || writes != (if (handled == 0) 0 else 1) || (handled != 0 && last != u32(handled)) || bad) return i32(2)
                    selected=selected+1
                }
                bits=bits+1
            }
            raw=u32(2);writes=0
            val events=c6GdmaEventsReadOwned(channel,tx,true)
            stuck=true
            if (events.acknowledgeOwned(2,true) != 6 || writes != 1) return i32(3)
            stuck=false;irq=true
            if (events.acknowledgeOwned(2,true) != 4 || c6GdmaEventsReadOwned(channel,tx,true).status() != 4 || writes != 1) return i32(4)
            irq=false;enabled=false
            if (events.acknowledgeOwned(2,true) != 3 || c6GdmaEventsReadOwned(channel,tx,true).status() != 3 || writes != 1) return i32(5)
            enabled=true
            if (events.acknowledgeOwned(4,true) != 2 || events.acknowledgeOwned(2,false) != 2 || writes != 1 || bad) return i32(6)
            raw=u32(256)
            if (c6GdmaEventsReadOwned(channel,tx,true).status() != 5) return i32(7)
            direction=direction+1
        }
        channel=channel+1
    }
    return i32(0)
}
