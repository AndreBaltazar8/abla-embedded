import "../src/esp32/power/sleep_record_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_record_target")
@section(".iram1.abla.s3SleepRecordTarget")
trusted fun recordTarget(record: NativeBuffer,wake: int,reject: int,polls: int,resume: bool): int {
    if (resume) return esp32S3SleepRecordResumeOwned(record,polls) | 0
    esp32S3SleepRecordEnterOwned(record,wake,reject)
}
