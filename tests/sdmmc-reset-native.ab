import "../src/sd/mmc_reset_s3_sequence.ab"
import "../src/sd/mmc_frequency.ab"
import "abla/runtime/scalar"
import "abla/build"
var control=0
var dma=0
var command=0
var status=0
var reads=0
var writes=0
trusted fun sdMmcS3Read(offset: int): int {
    reads=reads+1
    return if (offset == 0) control else if (offset == 128) dma else if (offset == 44) command else status
}
trusted fun sdMmcS3Write(offset: int,value: int): void { writes=writes+1; control=value; return }
@export("abla_sdmmc_reset_test")
trusted fun test(): i32 {
    if (sdMmcResetStartOwned(false,true).status() != 4 || sdMmcResetStartOwned(true,false).status() != 4 || reads != 0 || writes != 0) return i32(1)
    var bit=0
    while (bit < 32) {
        control=1<<bit; dma=0; writes=0
        val forbidden=(control&0x02000037) != 0
        val state=sdMmcResetStartOwned(true,true)
        if (forbidden) { if (state.status() != 3 || writes != 0) return i32(2) }
        else if (state.status() != 2 || control != ((1<<bit)|7) || writes != 1) return i32(3)
        bit=bit+1
    }
    control=0; dma=128; writes=0
    if (sdMmcResetStartOwned(true,true).status() != 3 || writes != 0) return i32(4)
    dma=0; control=0x10340000
    var state=sdMmcResetStartOwned(true,true)
    var pending=7
    while (pending > 0) {
        control=0x10340000|pending
        if (state.pollOwned().status() != 2) return i32(5)
        pending=pending-1
    }
    control=0x10340000; command=0x80000000
    if (state.pollOwned().status() != 2) return i32(6)
    command=0; status=1024
    if (state.pollOwned().status() != 2) return i32(7)
    // Card may remain busy after host reset; no false claim of card readiness.
    status=512
    if (state.pollOwned().status() != 1 || writes != 1) return i32(8)
    control=16
    if (state.pollOwned().status() != 3 || SdMmcReset(1).pollOwned().status() != 4) return i32(9)
    if (SdMmcFrequency(1<<41).valid() || SdMmcFrequency(1<<41).actualHz() != 0 || SdMmcFrequency((1<<41)|(1<<13)|31).valid()) return i32(10)
    return i32(0)
}
