import "../src/m5stack/touch_button_frame.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
val storage=nativeStaticAllocate(184)
val frameStorage=nativeStaticAllocate(41)
trusted fun put(frame: NativeBuffer,index: int,point: TouchPoint): void {
    var byte=0
    while (byte < 8) { frame.store(index*8+byte,(point >>> (byte*8))&255); byte=byte+1 }
    return
}
@export("abla_touch_button_frame_test")
trusted fun frameTest(): i32 {
    val tracker=touchTrackerAt(storage)
    val raw=nativeBufferAt(frameStorage+1,40)
    put(raw,0,touchPoint(0,240,0,0)); put(raw,1,touchPoint(319,240,1,0))
    tracker.updateControllerFrame(raw,2,10)
    val board=m5BoardToughC5
    val both=board.touchButtonsFromFrame(tracker,raw,2,10,0,0)
    if (!both.valid() || both.pressed() != 5 || both.controlled() != 7) return i32(1)
    if (board.touchButtonsFromFrame(tracker,raw,1,10,0,0).valid() ||
        board.touchButtonsFromFrame(tracker,raw,2,11,0,0).valid()) return i32(2)
    put(raw,1,touchPoint(319,240,0,0))
    if (board.touchButtonsFromFrame(tracker,raw,2,10,0,0).valid()) return i32(3)
    put(raw,1,touchPoint(319,240,1,1))
    if (board.touchButtonsFromFrame(tracker,raw,2,10,0,0).valid()) return i32(4)
    tracker.updateControllerFrame(raw,2,20)
    if (board.touchButtonsFromFrame(tracker,raw,2,20,0,0).pressed() != 1) return i32(5)
    tracker.updateControllerFrame(nativeBufferAt(0,0),0,30)
    val empty=board.touchButtonsFromFrame(tracker,nativeBufferAt(0,0),0,30,5,0)
    if (!empty.valid() || empty.pressed() != 0) return i32(6)
    tracker.updateControllerFrame(raw,2,31)
    if (board.touchButtonsFromFrame(tracker,raw,2,31,0,0).valid()) return i32(7)
    i32(0)
}
