import "../src/display/it8951_color.ab"
import "abla/runtime/scalar"
import "abla/build"
val matrix=nativeStaticMutableU32s([0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5])
val memory=nativeStaticAllocate(1536)
trusted fun oracle(red: int,green: int,blue: int,x: int,y: int,fast: bool): int {
    val bayer=nativeAddressLoadU32(matrix,((y%4)*4+x%4)*4)*4-30
    val value=red+2*green+blue
    if (fast) return if (value+bayer*16 < 512) 0 else 15
    val adjusted=value+bayer
    if (adjusted < 0) 0 else if (adjusted/64 > 15) 15 else adjusted/64
}
@export("abla_it8951_color_test")
trusted fun testColor(): i32 {
    // Every RGB565 color at every Bayer position, quality/fast and inversion.
    var color=0
    while (color < 65536) {
        val r=color/2048;val g=(color/32)%64;val b=color%32
        val red=r*8+r/4;val green=g*4+g/16;val blue=b*8+b/4
        var position=0
        while (position < 16) {
            var mode=0
            while (mode < 2) {
                val expected=oracle(red,green,blue,position%4,position/4,mode == 1)
                if (it8951Gray4(red,green,blue,position%4,position/4,mode == 1,false) != expected ||
                    it8951Gray4(red,green,blue,position%4,position/4,mode == 1,true) != 15-expected) return i32(1)
                mode=mode+1
            }
            position=position+1
        }
        color=color+1
    }
    val source=nativeBufferAt(memory,512)
    val dest=nativeBufferAt(memory+512,512)
    var index=0
    while (index < 512) { source.store(index,(index*73+19)&255);index=index+1 }
    var format=0
    while (format < 2) {
        var width=1
        while (width <= 17) {
            var mode=0
            while (mode < 4) {
                index=0
                while (index < 512) { dest.store(index,0xa5);index=index+1 }
                val srcStride=width*(if (format == 0) 3 else 2)+3
                val dstStride=(width+1)/2+2
                if (!it8951ConvertRgbOwned(source,srcStride,dest,dstStride,width,5,3,2,format == 1,mode >= 2,(mode&1) != 0,true)) return i32(2)
                var row=0
                while (row < 5) {
                    var column=0
                    while (column < width) {
                        val at=row*srcStride+column*(if (format == 0) 3 else 2)
                        var red=source.load(at);var green=source.load(at+1);var blue=0
                        if (format == 0) blue=source.load(at+2)
                        else {
                            val raw=red*256+green
                            val r=raw/2048;val g=(raw/32)%64;val b=raw%32
                            red=r*8+r/4;green=g*4+g/16;blue=b*8+b/4
                        }
                        val normal=oracle(red,green,blue,column+3,row+2,mode >= 2)
                        val expected=if ((mode&1) != 0) 15-normal else normal
                        val byte=dest.load(row*dstStride+column/2)
                        val actual=if (column%2 == 0) byte/16 else byte%16
                        if (actual != expected) return i32(3)
                        column=column+1
                    }
                    if (width%2 == 1 && dest.load(row*dstStride+width/2)%16 != 5) return i32(4)
                    row=row+1
                }
                index=0
                while (index < 512) {
                    if ((index/dstStride >= 5 || index%dstStride >= (width+1)/2) && dest.load(index) != 0xa5) return i32(5)
                    index=index+1
                }
                mode=mode+1
            }
            width=width+1
        }
        format=format+1
    }
    index=0
    while (index < 512) { dest.store(index,0xa5);index=index+1 }
    if (it8951ConvertRgbOwned(source,6,dest,1,2,1,0,0,false,false,false,false) ||
        it8951ConvertRgbOwned(source,5,dest,1,2,1,0,0,false,false,false,true) ||
        it8951ConvertRgbOwned(source,6,dest,1,2,1,65535,0,false,false,false,true) ||
        it8951ConvertRgbOwned(source,6,source,1,2,1,0,0,false,false,false,true) ||
        it8951ConvertRgbOwned(source,6,nativeBufferAt(dest.addressValue(),0),1,2,1,0,0,false,false,false,true)) return i32(6)
    index=0
    while (index < 512) { if (dest.load(index) != 0xa5) return i32(7);index=index+1 }
    if (it8951Gray4(-1,0,0,0,0,false,false) != -1 || it8951Gray4(0,256,0,0,0,false,false) != -1 ||
        it8951Gray4(0,0,0,65536,0,false,false) != -1) return i32(8)
    i32(0)
}
