import "./paper-display-owner-native.ab"
import "../src/m5stack/paper_display_operations.ab"
@export("abla_paper_display_operations_test")
trusted fun testPaperOperations(): i32 {
    val parent=m5PaperDisplayOwnerAt(nativeBufferAt(nativeStaticAllocate(312),312))
    val child=it8951SessionAt(nativeBufferAt(nativeStaticAllocate(40),40))
    val scratch=nativeBufferAt(nativeStaticAllocate(40),40)
    val pixels=nativeBufferAt(nativeStaticAllocate(259200),259200)
    val gate=peripheralGateAt(nativeStaticAllocate(4))
    nativeAddressStoreU32(gate|0,0,0)
    if (!parent.initialize() || !child.initialize() || parent.openOwned(gate,u32(7),child,scratch,3,true,true) != 1) return i32(1)
    val before=calls
    if (parent.loadFullOwned(pixels,480,parent.buffer(),3,3,true).status() != 2 ||
        parent.loadFullOwned(nativeBufferAt(parent.buffer().addressValue(),259200),480,scratch,3,3,true).status() != 2 ||
        parent.loadFullOwned(nativeBufferAt(gate|0,259200),480,scratch,3,3,true).status() != 2 ||
        parent.refreshFullOwned(2,child.buffer(),3,3,true).status() != 2 ||
        parent.waitDisplayOwned(nativeBufferAt(gate|0,4),3,3,true) != 2 ||
        parent.shutdownOwned(parent.buffer(),3,3,true) || calls != before || !parent.held()) return i32(2)
    // External ownership corruption must block every new operation, not drive
    // the bus under another token. Restore only in this isolated fault model.
    nativeAddressStoreU32(gate|0,0,8)
    if (parent.loadFullOwned(pixels,480,scratch,3,3,true).status() != 2 ||
        parent.refreshFullOwned(2,scratch,3,3,true).status() != 2 ||
        parent.waitDisplayOwned(scratch,3,3,true) != 2 || parent.shutdownOwned(scratch,3,3,true) ||
        calls != before || pins != 127) return i32(3)
    nativeAddressStoreU32(gate|0,0,7)
    nativeAddressClear(pixels.addressValue(),259200)
    if (!parent.loadFullOwned(pixels,480,scratch,3,3,true).success() ||
        !parent.refreshFullOwned(2,scratch,3,3,true).success() || child.state() != 3 ||
        parent.waitDisplayOwned(scratch,3,3,true) != 1 || !parent.held() || bad) return i32(4)
    failClose=4
    if (parent.shutdownOwned(scratch,3,3,true) || parent.state() != 4 || child.state() != 0 ||
        !parent.held() || pins != 31) return i32(5)
    failClose=-1
    val stopped=calls
    if (!parent.shutdownOwned(scratch,3,3,true) || calls != stopped || parent.state() != 0 || pins != 0 ||
        gate.word().compareExchange(u32(0),u32(0)) != u32(0) || bad || selected) return i32(6)
    // Controller failure during shutdown must retain all leases and the gate.
    if (parent.openOwned(gate,u32(7),child,scratch,3,true,true) != 1) return i32(7)
    failure=calls+8
    if (parent.shutdownOwned(scratch,3,3,true) || child.state() != 2 || pins != 127 || !parent.held()) return i32(8)
    failure=0
    if (parent.recoverControllerOwned(scratch,3,true) != 1 || !parent.shutdownOwned(scratch,3,3,true) || pins != 0 || bad) return i32(9)
    i32(0)
}
