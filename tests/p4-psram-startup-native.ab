import "../src/esp32/psram/startup_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(64)
var failure=0
var order=0
var valid=true
fun p4PsramCommandStorageSafe(address: int,bytes: int): bool = address == memory && bytes == 16
fun p4PsramStartupInputsValid(record: NativeBuffer,cold: NativeBuffer,mhz: int,dummy: int,scratch: NativeBuffer,work: NativeBuffer,polls: int): bool = valid
fun p4PsramStartupSuspend(polls: int): int { order=order*10+1; return 0x1000f00|(if (failure == 1) 4 else 1) }
fun p4CacheFlushAllDataOwned(polls: int): int { order=order*10+2; return if (failure == 2) 1030 else 1 }
fun p4PsramColdStartOwned(cold: NativeBuffer,mhz: int,hex16: bool,dummy: int,scratch: NativeBuffer,work: NativeBuffer,polls: int): int {
    order=order*10+3; cold.storeU32(4,if (failure == 3) 4 else 8); return if (failure == 3) 4 else 1
}
fun resetStartup(record: NativeBuffer,cold: NativeBuffer): void {
    var offset=0
    while (offset < 48) { cold.storeU32(offset,0); offset=offset+4 }
    cold.storeU32(0,0x50345053); p4PsramStartupInitializeOwned(record); order=0; failure=0; valid=true; return
}
fun startTest(record: NativeBuffer,cold: NativeBuffer): int = p4PsramStartupColdOwned(record,cold,80,true,18,nativeBufferAt(0,0),nativeBufferAt(0,0),2)
@export("abla_p4_psram_startup_test")
fun startupTest(): i32 {
    val record=nativeBufferAt(memory,16); val cold=nativeBufferAt(memory+16,48)
    resetStartup(record,cold)
    if (startTest(record,cold) != 1 || order != 123 || record.loadU32(4) != 4 || cold.loadU32(4) != 8 || record.loadU32(8) != 0x1000f01) return i32(1)
    if (startTest(record,cold) != 3 || order != 123) return i32(2)
    var fail=1
    while (fail <= 3) {
        resetStartup(record,cold); failure=fail
        if (startTest(record,cold) != 4 || record.loadU32(4) != fail || record.loadU32(8) != (0x1000f00|(if (fail == 1) 4 else 1)) ||
            order != (if (fail == 1) 1 else if (fail == 2) 12 else 123)) return i32(3)
        if (record.loadU32(12) != (if (fail == 2) 1030 else 4) || startTest(record,cold) != 3) return i32(4)
        fail=fail+1
    }
    resetStartup(record,cold); valid=false
    if (startTest(record,cold) != 2 || order != 0 || record.loadU32(4) != 0) return i32(5)
    valid=true; cold.storeU32(8,256)
    if (startTest(record,cold) != 3 || order != 0) return i32(6)
    return i32(0)
}
