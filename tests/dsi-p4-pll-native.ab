import "../src/esp32/dsi_pll_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var writes=0
var bad=false
var expected=DsiPhyPll(0)
fun p4DsiRead(offset: int): u32 { bad=true; return u32(0) }
fun p4DsiWrite(offset: int,value: u32): void {
    val transaction=writes/7
    val edge=writes%7
    val address=if (transaction == 0) 68 else if (transaction == 1) 25 else if (transaction == 2) 23 else 24
    val data=if (transaction == 0) expected.hsRange()*2 else if (transaction == 1) 48 else if (transaction == 2) expected.divider()-1 else if (transaction == 3) (expected.multiplier()-1)&31 else 128|(((expected.multiplier()-1)>>>5)&15)
    if (offset != (if (edge == 1 || edge == 4) 184 else 180) ||
        value != u32(if (edge == 1) 65536|address else if (edge == 4) data else if (edge == 2 || edge == 5) 2 else 0) || transaction > 4) bad=true
    writes=writes+1
    return
}
@export("abla_dsi_p4_pll_test")
trusted fun testPll(): i32 {
    var reference=5000
    while (reference <= 160000) {
        var mbps=80
        while (mbps <= 1500) {
            val plan=esp32P4DsiChoosePll(reference,mbps)
            // Independent candidate enumeration with signed wide arithmetic.
            var found=false
            var n=1
            var bestN=0
            var bestM=0
            var bestError=0
            while (n <= 32) {
                if (reference >= 5000*n && reference <= 40000*n) {
                    val m=mbps*1000*n/reference
                    if (m >= 2 && m <= 512 && m%2 == 0) {
                        val error=mbps*1000*n-reference*m
                        if (!found || error*bestN < bestError*n) {
                            found=true; bestN=n; bestM=m; bestError=error
                        }
                    }
                }
                n=n+1
            }
            if (plan.valid() != found || (found && (plan.divider() != bestN || plan.multiplier() != bestM))) return i32(1)
            mbps=mbps+1
        }
        reference=reference+1000
    }
    var mbps=80
    while (mbps <= 1500) {
        expected=esp32P4DsiChoosePll(40000,mbps); writes=0
        if (expected.valid()) {
        if (mbps >= 80 && mbps <= 89 && expected.hsRange() != 0) return i32(5)
        if (mbps >= 90 && mbps <= 99 && expected.hsRange() != 16) return i32(5)
        if (mbps >= 100 && mbps <= 109 && expected.hsRange() != 32) return i32(5)
        if (mbps >= 110 && mbps <= 129 && expected.hsRange() != 1) return i32(5)
        if (mbps >= 130 && mbps <= 139 && expected.hsRange() != 17) return i32(5)
        if (mbps >= 140 && mbps <= 149 && expected.hsRange() != 33) return i32(5)
        if (mbps >= 150 && mbps <= 169 && expected.hsRange() != 2) return i32(5)
        if (mbps >= 170 && mbps <= 179 && expected.hsRange() != 18) return i32(5)
        if (mbps >= 180 && mbps <= 199 && expected.hsRange() != 34) return i32(5)
        if (mbps >= 200 && mbps <= 219 && expected.hsRange() != 3) return i32(5)
        if (mbps >= 220 && mbps <= 239 && expected.hsRange() != 19) return i32(5)
        if (mbps >= 240 && mbps <= 249 && expected.hsRange() != 35) return i32(5)
        if (mbps >= 250 && mbps <= 269 && expected.hsRange() != 4) return i32(5)
        if (mbps >= 270 && mbps <= 299 && expected.hsRange() != 20) return i32(5)
        if (mbps >= 300 && mbps <= 329 && expected.hsRange() != 5) return i32(5)
        if (mbps >= 330 && mbps <= 359 && expected.hsRange() != 21) return i32(5)
        if (mbps >= 360 && mbps <= 399 && expected.hsRange() != 37) return i32(5)
        if (mbps >= 400 && mbps <= 449 && expected.hsRange() != 6) return i32(5)
        if (mbps >= 450 && mbps <= 499 && expected.hsRange() != 22) return i32(5)
        if (mbps >= 500 && mbps <= 549 && expected.hsRange() != 7) return i32(5)
        if (mbps >= 550 && mbps <= 599 && expected.hsRange() != 23) return i32(5)
        if (mbps >= 600 && mbps <= 649 && expected.hsRange() != 8) return i32(5)
        if (mbps >= 650 && mbps <= 699 && expected.hsRange() != 24) return i32(5)
        if (mbps >= 700 && mbps <= 749 && expected.hsRange() != 9) return i32(5)
        if (mbps >= 750 && mbps <= 799 && expected.hsRange() != 25) return i32(5)
        if (mbps >= 800 && mbps <= 849 && expected.hsRange() != 41) return i32(5)
        if (mbps >= 850 && mbps <= 899 && expected.hsRange() != 57) return i32(5)
        if (mbps >= 900 && mbps <= 949 && expected.hsRange() != 10) return i32(5)
        if (mbps >= 950 && mbps <= 999 && expected.hsRange() != 26) return i32(5)
        if (mbps >= 1000 && mbps <= 1049 && expected.hsRange() != 42) return i32(5)
        if (mbps >= 1050 && mbps <= 1099 && expected.hsRange() != 58) return i32(5)
        if (mbps >= 1100 && mbps <= 1149 && expected.hsRange() != 11) return i32(5)
        if (mbps >= 1150 && mbps <= 1199 && expected.hsRange() != 27) return i32(5)
        if (mbps >= 1200 && mbps <= 1249 && expected.hsRange() != 43) return i32(5)
        if (mbps >= 1250 && mbps <= 1299 && expected.hsRange() != 59) return i32(5)
        if (mbps >= 1300 && mbps <= 1349 && expected.hsRange() != 12) return i32(5)
        if (mbps >= 1350 && mbps <= 1399 && expected.hsRange() != 28) return i32(5)
        if (mbps >= 1400 && mbps <= 1449 && expected.hsRange() != 44) return i32(5)
        if (mbps >= 1450 && mbps <= 1500 && expected.hsRange() != 60) return i32(5)
        val actual=esp32P4DsiConfigurePllOwned(40000,mbps)
        if (actual != expected || writes != 35 || bad) return i32(2)
        } else {
            if (esp32P4DsiConfigurePllOwned(40000,mbps).valid() || writes != 0) return i32(6)
        }
        mbps=mbps+1
    }
    val tab900=esp32P4DsiChoosePll(40000,900)
    val tab1040=esp32P4DsiChoosePll(40000,1040)
    if (tab900.divider() != 4 || tab900.multiplier() != 90 || tab900.hsRange() != 10 ||
        tab1040.divider() != 1 || tab1040.multiplier() != 26 || tab1040.hsRange() != 42) return i32(3)
    writes=0
    val fractional=esp32P4DsiChoosePllKbps(40000,89500)
    if (!fractional.valid() || fractional.hsRange() != 0 ||
        esp32P4DsiChoosePllKbps(40000,1500001).valid()) return i32(7)
    if (esp32P4DsiConfigurePllOwned(4999,900).valid() || esp32P4DsiConfigurePllOwned(160001,900).valid() ||
        esp32P4DsiConfigurePllOwned(40000,79).valid() || esp32P4DsiConfigurePllOwned(40000,1501).valid() || writes != 0) return i32(4)
    i32(0)
}
