import "../src/esp32/i2c/configuration_logic.ab"

fun main(): int {
    var chipId = 0
    while (chipId <= 6) {
        val chip = EspChip(chipId)
        val count = if (chipId >= 1 && chipId <= 3) 2
            else if (chipId == 4 || chipId == 5) 1 else 0
        if (chip.i2cMasterControllerCount() != count) return 1
        var port = -1
        while (port <= 3) {
            if (chip.i2cMasterConfigurationValid(port, 4, 5) != (port >= 0 && port < count)) return 2
            if (chip.i2cMasterConfigurationValid(port, 4, 4)) return 3
            if (chip.i2cMasterConfigurationValid(port, -1, 5)) return 4
            if (chip.i2cMasterConfigurationValid(port, 260, 5)) return 5
            if (chip.i2cMasterConfigurationValid(port, 4, 261)) return 6
            port = port + 1
        }
        chipId = chipId + 1
    }
    if (espChip32().i2cMasterConfigurationValid(0, 34, 5)) return 7
    if (espChipS2().i2cMasterConfigurationValid(0, 46, 5)) return 8
    if (!espChipS3().i2cMasterConfigurationValid(1, 46, 48)) return 9
    if (espChipC6().i2cMasterConfigurationValid(1, 4, 5)) return 10
    if (espChip32().i2cMasterConfigurationValid(0, 4294967300, 5)) return 11
    0
}
