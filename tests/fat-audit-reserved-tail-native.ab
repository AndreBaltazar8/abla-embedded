import "../src/storage/fat_volume_audit.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(16384)
var fatLength=12
var root=25
var meaningful=0
var calls=0
var bad=false
var audited=FatVolume(0)
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,input: NativeBuffer): bool { bad=true;return false }
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    calls=calls+1
    if (audited.begin(u32(8)) != 12) bad=true
    var at=0
    if (lba == root) { while (at < 512) { output.store(at,0);at=at+1 };return true }
    val mirror=lba >= 1+fatLength
    val part=lba-1-(if (mirror) fatLength else 0)
    if (part < 0 || part >= fatLength) { bad=true;return false }
    while (at < 512) {
        // Deliberately disagree only in the unused/reserved-number tail.
        output.store(at,if (part*512+at >= meaningful) (if (mirror) 0x55 else 0xaa) else 0)
        at=at+1
    }
    return true
}
@export("abla_fat_audit_reserved_tail_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(memory,512);val reader=nativeBufferAt(memory+512,28);val state=nativeBufferAt(memory+544,32)
    val scratch=nativeBufferAt(memory+576,1024);val data=nativeBufferAt(memory+1600,512);val queue=nativeBufferAt(memory+2112,8)
    val bitmap=nativeBufferAt(memory+2128,10000)
    var kind=0
    while (kind < 2) {
        val limit=if (kind == 0) 4078 else 65518
        var variant=0
        while (variant < 4) {
            val clusters=if (variant == 0) limit-1 else if (variant == 1) limit else if (variant == 2) limit+1 else limit+7
            var at=0;while (at < 512) { boot.store(at,0);at=at+1 }
            fatLength=if (kind == 0) 12 else 256;root=1+fatLength*2
            val roots=if (kind == 0) 32 else 512
            val total=root+roots/16+clusters
            boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2);boot.storeU16(17,roots)
            boot.storeU16(22,fatLength);boot.storeU32(32,total);boot.storeU16(510,0xaa55)
            val geometry=fatBootValidate(boot,0,total)
            val usable=if (clusters < limit) clusters else limit
            if (!geometry.valid() || geometry.clusters() != clusters || geometry.usableClusters() != usable || geometry.fatBits() != (if (kind == 0) 12 else 16)) return i32(1)
            val entries=usable+2
            meaningful=if (kind == 0) entries+entries/2+(entries&1) else entries*2
            fatVolumeInitializeFresh(state);state.storeU32(8,1);state.storeU32(12,1);state.storeU32(16,reader.addressValue());state.storeU32(20,boot.addressValue());state.storeU32(24,0);state.storeU32(28,total)
            audited=FatVolume(state.addressValue()|(1<<32));calls=0;bad=false
            val result=audited.auditAllocation(u32(7),1000,queue,data,scratch,bitmap,true)
            if (!result.consistent() || !result.mirrorsChecked() || bitmap.loadU32(4) != usable || bitmap.loadU32(8) != 0 || bad || state.loadU32(0) != 0) return i32(2)
            if (fatClusterOwnershipAt(bitmap).lookup(usable+2) != 2) return i32(3)
            variant=variant+1
        }
        kind=kind+1
    }
    val largest=FatBootGeometry(0x0ffffff5|(3<<31))
    if (largest.fatBits() != 32 || largest.usableClusters() != 268435438 || fatClusterOwnershipBytes(largest.usableClusters()) == 0) return i32(4)
    return i32(0)
}
