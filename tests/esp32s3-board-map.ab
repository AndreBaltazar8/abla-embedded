import "../src/esp32/gpio_esp32s3.ab"
import "../src/m5stack/pin_map_shared.ab"
import "../src/m5stack/button_map_shared.ab"
fun main(): int {
    if (pin(-1).valid() || pin(22).valid() || pin(25).valid() || pin(49).valid() || !pin(48).valid()) return 1
    if (m5BoardAtomVoice.buttonA().number() != 39 || !m5BoardAtomVoice.buttonA().valid()) return 2
    if (m5GpioButtonSource(22).pin().valid() || m5TouchButtonSource(0).pin().valid()) return 3
    if (m5BoardUnknown.portA().available() || m5BoardUnknown.sdPins().available()) return 4
    0
}
