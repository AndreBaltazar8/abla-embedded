import "../src/m5stack/cores3_display_spi_sequence.ab"
import "../src/display/command_buffer.ab"
import "../src/peripheral_gate.ab"
import "../src/spi/transaction_result.ab"
import "abla/runtime/scalar"
import "abla/build"
type SpiLcd = int
var calls = 0
var panel = 0
var bad = false
var response = SpiTransactionResult(4294967553)
fun M5BoardId.spiDisplay(): SpiLcd { calls = calls + 1; SpiLcd(1) }
trusted fun SpiLcd.beginRgb565(gate: PeripheralGate, owner: u32, geometry: LcdGeometry,
    rotation: int, program: NativeBuffer, extra: NativeBuffer, inverted: bool, bgr: bool): SpiTransactionResult {
    calls = calls + 1
    if (owner != u32(41) || geometry.width() != 320 || geometry.height() != 240 || rotation != 0 ||
        !inverted || !bgr || program.capacity() != 72 || program.load(0) != 200 ||
        !lcdCommandBufferValid(program,program.capacity()) ||
        extra.capacity() != (if (panel == cores3PanelIli9342E) 77 else 0)) bad = true
    if (extra.capacity() != 0 && (extra.load(0) != 221 || !lcdCommandBufferValid(extra,extra.capacity()))) bad = true
    response
}
trusted fun cores3HardwareDisplayTest(): int {
    var board = 0
    while (board < 160) {
        panel = -1
        while (panel < 5) {
            calls = 0; bad = false
            val valid = (M5BoardId(board) == m5BoardStackCoreS3 || M5BoardId(board) == m5BoardStackCoreS3SE) &&
                (panel == cores3PanelIli9342C || panel == cores3PanelIli9342E)
            val result = M5BoardId(board).beginCoreS3SpiDisplay(peripheralGateAt(0),u32(41),panel)
            if (bad || result.status() != (if (valid) 1 else 3) || calls != (if (valid) 2 else 0)) return 1
            panel = panel + 1
        }
        board = board + 1
    }
    panel = cores3PanelIli9342E
    response = SpiTransactionResult((6 << 32) | 0x20109)
    if (m5BoardStackCoreS3.beginCoreS3SpiDisplay(peripheralGateAt(0),u32(41),panel) != response) return 2
    0
}
#exportFunction("cores3HardwareDisplayTest", "abla_cores3_hardware_display_test")
