import "../src/m5stack/rtc_wake_begin_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var released=true
var setup=true
var stop=true
var irq=true
var high=true
var pad=true
var nativeResult=1
var starts=0
var stops=0
var prepares=0
var restores=0
var bad=false
fun m5RtcCleanupRtcValid(handle: int): bool = handle == 7
fun m5RtcCleanupPmicValid(handle: int): bool = handle == 8
fun m5RtcTimerSupported(handle: int): bool = handle == 7
fun m5RtcWakeBeginReleased(record: NativeBuffer): bool = released
fun m5RtcWakeCancellationOwned(record: NativeBuffer): bool = true
fun m5RtcWakeCancellationRestore(record: NativeBuffer): bool { restores=restores+1; pad }
fun m5RtcConfigureTimer(handle: int,duration: int): RtcTimerResult {
    if (duration == 0) { stops=stops+1; return RtcTimerResult(if (stop) 1 else 5) }
    if (duration != 1000) bad=true
    starts=starts+1; RtcTimerResult(if (setup) (1000<<8)|1 else 5)
}
fun m5RtcCleanupRtc(handle: int,disable: bool): bool { bad=true; false }
fun m5RtcCleanupWake(handle: int): bool = irq
fun m5RtcCleanupPmicIrq(handle: int): bool = irq
fun m5RtcTimerWakeLineHigh(pin: int): bool = high
fun m5RtcTimerWakePrepare(record: NativeBuffer,pin: int): int { prepares=prepares+1; nativeResult }
@export("abla_rtc_wake_begin_test")
trusted fun beginTest(): i32 {
    val wake=nativeBufferAt(nativeStaticAllocate(176),176)
    val report=nativeBufferAt(nativeStaticAllocate(24),24)
    var model=0
    while (model < 3) {
        val board=if (model == 0) m5BoardPaperMono else if (model == 1) m5BoardPaperColor else m5BoardStampPLC
        var mode=0
        while (mode < 128) {
            setup=(mode&1)!=0; stop=(mode&2)!=0; irq=(mode&4)!=0
            high=(mode&8)!=0; pad=(mode&16)!=0; nativeResult=(mode>>>5)&3
            starts=0; stops=0; prepares=0; restores=0; bad=false
            wake.storeU32(0,0)
            val timerOk=setup && (model != 0 || irq)
            val success=timerOk && high && nativeResult == 1
            val cancelOk=stop && (model != 0 || irq)
            val expected=if (success) 1 else if (cancelOk && pad) 3 else 4
            val result=m5RtcWakeBeginS3Owned(board,7,8,wake,report,1000,true)
            if (result != expected || report.loadU32(0) != expected || starts != 1 ||
                stops != (if (success) 0 else 1) || prepares != (if (timerOk && high) 1 else 0) ||
                restores != (if (!success && cancelOk) 1 else 0) || bad) return i32(1)
            val original=M5RtcTimerResult(report.loadU32(8) | (report.loadU32(12)<<32))
            if (original.timer().status() != (if (setup) 1 else 5) || original.success() != timerOk) return i32(2)
            val admission=if (!timerOk) 0 else if (!high) 4 else if (nativeResult == 1) 1 else if (nativeResult == 0) 5 else nativeResult+4
            if (report.loadU32(4) != admission) return i32(3)
            mode=mode+1
        }
        model=model+1
    }
    starts=0; stops=0; report.storeU32(0,99)
    if (m5RtcWakeBeginS3Owned(m5BoardPaperMono,7,8,wake,wake,1000,true) != 2 ||
        m5RtcWakeBeginS3Owned(m5BoardPaperMono,7,0,wake,report,1000,true) != 2 ||
        m5RtcWakeBeginS3Owned(m5BoardPaperMono,7,8,wake,report,0,true) != 2 ||
        m5RtcWakeBeginS3Owned(m5BoardPaperMono,7,8,wake,report,1000,false) != 2) return i32(4)
    released=false
    if (m5RtcWakeBeginS3Owned(m5BoardPaperMono,7,8,wake,report,1000,true) != 2 || starts != 0 || stops != 0 || report.loadU32(0) != 99) return i32(5)
    i32(0)
}
