import "../src/scheduler/ready_queue.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_ready_queue_test")
trusted fun readyQueueTest(): i32 {
    val memory=nativeBufferAt(nativeStaticAllocate(80),80)
    var capacity=1
    while (capacity <= 16) {
        val queue=nativeBufferAt(memory.addressValue(),16+capacity*4)
        if (!readyQueueInitializeOwned(queue) || readyQueuePeekOwned(queue) != 0) return i32(1)
        var id=1
        while (id <= capacity) {
            if (!readyQueuePushOwned(queue,id) || readyQueuePushOwned(queue,id)) return i32(2)
            id=id+1
        }
        if (readyQueuePushOwned(queue,999)) return i32(3)
        var step=0
        while (step < 128) {
            val expected=step+1
            val next=step+capacity+1
            if (readyQueuePeekOwned(queue) != expected || readyQueueCommitOwned(queue,expected+1,0) ||
                readyQueueCommitOwned(queue,expected,expected) || readyQueuePeekOwned(queue) != expected) return i32(4)
            if (!readyQueueCanCommitOwned(queue,expected,next) || !readyQueueCommitOwned(queue,expected,next) || memory.loadU32(12) != capacity) return i32(5)
            step=step+1
        }
        id=129
        while (id < 129+capacity) {
            if (readyQueuePeekOwned(queue) != id || !readyQueueCommitOwned(queue,id,0)) return i32(6)
            id=id+1
        }
        if (readyQueuePeekOwned(queue) != 0 || readyQueueCommitOwned(queue,1,0)) return i32(7)
        if (!readyQueuePushOwned(queue,0xFFFFFFFF) || readyQueuePeekOwned(queue) != 0xFFFFFFFF ||
            !readyQueueCommitOwned(queue,0xFFFFFFFF,0)) return i32(8)
        memory.storeU32(8,capacity)
        if (readyQueuePeekOwned(queue) != -1 || readyQueuePushOwned(queue,1)) return i32(9)
        capacity=capacity+1
    }
    i32(0)
}
