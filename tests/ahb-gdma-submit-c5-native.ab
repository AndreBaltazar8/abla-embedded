import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/ahb_gdma_submit_c5_sequence.ab"
var record=NativeBuffer(0)
var channel=0
var tx=false
var circular=false
var count=1
var writes=0
var drop=0
var head=u32(0)
var fences=0
var corrupt=-1
var high=u32(0x40860000)
var bad=false
trusted fun c5AhbGdmaBusRead(): u32 = u32(1)
trusted fun c5AhbGdmaBusWrite(v: u32): void { bad=true;return }
trusted fun c5AhbGdmaRead(at: int): u32 {
    val base=0x70+channel*192+(if (tx) 96 else 0)
    if (at == 0x64) return u32(8)
    if (at == base) return u32(if (tx) 12 else 0)
    if (at == base+4) return u32(4096)
    if (at == base+8) return u32(2)
    if (at == base+16) return u32(if (tx) 8 else 17)
    if (at == base+48) return u32(3)
    if (at == 0x3c4) return u32(0x40800000)
    if (at == 0x3c8) return high
    if (at == 0x3ac+channel*4+(if (tx) 12 else 0)) return head
    return u32(0)
}
trusted fun c5AhbGdmaWrite(at: int,v: u32): void {
    writes=writes+1
    if (at == 0x3ac+channel*4+(if (tx) 12 else 0)) {
        if (record.loadU32(4) != 3 || fences != 1 || v != u32(0x40800000)) bad=true
        if (writes != drop) head=v
    } else if (at == 0x80+channel*192+(if (tx) 96 else 0)) {
        if (record.loadU32(4) != 4 || fences != 3 || v != u32(if (tx) 10 else 21)) bad=true
    } else bad=true
    return
}
trusted fun c5AhbGdmaDescriptorFence(): void { fences=fences+1;return }
trusted fun c5AhbGdmaDescriptorWrite(at: int,v: u32): void { bad=true;return }
trusted fun c5AhbGdmaDescriptorRead(at: int): u32 {
    val offset=at-0x40800000
    if (offset < 0 || offset >= count*12 || (offset&3) != 0) { bad=true;return u32(0) }
    if (offset == corrupt) return u32(0xdeadbeef)
    val index=offset/12;val word=offset%12
    return if (word == 0) u32(if (tx) 0xc0040040 else 0x80000040) else if (word == 4) u32(0x40810000+index*64) else u32(if (index+1 < count) 0x40800000+(index+1)*12 else if (circular) 0x40800000 else 0)
}
trusted fun resetModel(): void { record.storeU32(0,0);record.storeU32(4,0);writes=0;fences=0;head=u32(0);bad=false;return }
trusted fun submit(): int = c5AhbGdmaSubmitOwned(record,channel,tx,3,0x40800000,count,0x40810000,64,64,circular,true)
@export("abla_ahb_gdma_submit_c5_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(16)
    record=nativeBufferAt(storage,16)
    while (channel < 3) {
        var flags=0
        while (flags < 4) {
            tx=(flags&1) != 0;circular=(flags&2) != 0
            count=1
            while (count <= 16) {
                drop=0
                while (drop < 3) {
                    resetModel()
                    if (submit() != (if (drop == 1) 8 else 1) || writes != (if (drop == 1) 1 else 2) || bad) return i32(1)
                    val oldWrites=writes
                    if (submit() != 2 || writes != oldWrites) return i32(2)
                    drop=drop+1
                }
                drop=0;corrupt=0
                while (corrupt < count*12) {
                    resetModel()
                    if (submit() != 7 || writes != 0 || record.loadU32(0) != 0 || bad) return i32(3)
                    corrupt=corrupt+4
                }
                corrupt=-1
                count=count*2
            }
            flags=flags+1
        }
        channel=channel+1
    }
    channel=0;count=1;high=u32(0x40810020);resetModel()
    if (submit() != 6 || writes != 0 || fences != 0) return i32(4)
    return i32(0)
}
