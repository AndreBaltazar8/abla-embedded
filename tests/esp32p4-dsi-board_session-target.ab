import "../src/m5stack/tab5_board_session_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_board_session_target")
trusted fun target(session: Tab5BoardSession,board: M5BoardId,layout: int,expanders: NativeBuffer,scratch: NativeBuffer,operation: int,owner: NativeBuffer,reference: NativeBuffer): int {
    if (operation == 1) return session.closeOwned()
    if (operation == 2) return session.openOnChipOwned(board,expanders,scratch)
    if (operation == 3) return session.openPanelOwned(owner,reference,scratch,0,0,1,40000,0,10000,1000)
    return session.openOwned(board,layout,expanders,scratch)
}
