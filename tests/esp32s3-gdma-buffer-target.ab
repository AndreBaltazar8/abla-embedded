import "../src/esp32/gdma_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun gdmaBufferTarget(descriptor: u32, transmit: bool, length: i32, eof: bool, rearm: bool): i32 {
    if (rearm) return if (esp32s3GdmaRearm(int(descriptor), transmit, int(length), eof)) i32(1) else i32(0)
    i32(esp32s3GdmaCompletedBytes(int(descriptor)))
}
#exportFunction("gdmaBufferTarget", "abla_s3_gdma_buffer_test")
