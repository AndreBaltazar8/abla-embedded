import "./epd-frame-native.ab"
import "./epd-gate-pins-native.ab"
import "../src/display/epd_display_sequence.ab"
val displayMemory=nativeStaticAllocate(312)
@export("abla_epd_display_test")
fun testEpdDisplay(): int {
    val r=nativeBufferAt(displayMemory,312);val cfg=nativeBufferAt(sessionConfig,76)
    val f=nativeBufferAt(framePixels,1036800);val canvas=nativeBufferAt(frameGray,259200)
    val desc=nativeBufferAt(sessionDescriptors,24);val payload=nativeBufferAt(sessionPayload,248)
    val pins=epdGatePins(46,17,18,45,15)
    var index=0
    while (index < 19) { cfg.storeU32(index*4,0xFFFFFFFF);index=index+1 }
    cfg.storeU32(0,6);cfg.storeU32(4,14);cfg.storeU32(8,7);cfg.storeU32(12,12)
    cfg.storeU32(16,9);cfg.storeU32(20,11);cfg.storeU32(24,8);cfg.storeU32(28,10)
    cfg.storeU32(64,16);cfg.storeU32(68,13)
    var profile=0
    while (profile < 8) {
        r.storeU32(0,0)
        sessionStorageBytes=248;sessionFault=if (profile >= 2 && profile <= 4) profile-1 else if (profile == 7) 4 else 0
        sessionReady=profile != 3;sessionPins=false;sessionDma=false;sessionBad=false;sessionAbortFails=false;sessionRestoreFails=false;sessionStarts=0
        epdPrepared=true;epdFail=0;epdCount=0;epdWrites=0;epdBad=false
        gateCaptured=0;gatePreparedCount=0;gateParked=0;gateRestored=0;gateOwnerBad=false
        gatePrepareFail=if (profile == 1) 3 else 0;gateParkFail=0;gateRestoreFail=0
        val opened=epdDisplayOpenOwned(r,cfg,f,canvas,desc,payload,pins,960,540,8,2,1,8,true)
        if ((profile >= 1 && profile <= 4) || profile == 7) {
            if (opened != 4 || r.loadU32(4) != 7) return 1
        } else {
            if (opened != 1 || epdDisplayStartOwned(r,f,true) != 2) return 2
            var result=2;var now=0
            while (result == 2 && now < 45000) {
                epdCount=0;epdWrites=0
                sessionPollResult=if (profile == 5) 3 else 1
                result=epdDisplayPumpOwned(r,f,now,true);now=now+1
                if (profile == 6 && sessionDma) break
            }
            // Four eraser +32 quality +one fully inactive frame.
            if (profile == 0 && (result != 1 || sessionStarts != 540*37 || r.loadU32(4) != 1)) return 3
            if (profile == 5 && result != 4) return 4
            if (profile == 6 && !sessionDma) return 5
        }
        epdCount=0;epdWrites=0
        sessionRestoreFails=true;sessionAbortFails=true;gateParkFail=1
        if (epdDisplayCloseOwned(r,f,true) != 6 || gateRestored != 0) return 6
        sessionRestoreFails=false;sessionAbortFails=false;sessionReady=true
        if (epdDisplayCloseOwned(r,f,true) != 6 || gateRestored != 0) return 7
        gateParkFail=0;gateRestoreFail=3
        if (epdDisplayCloseOwned(r,f,true) != 6 || gateParked != 5 || gateRestored != 2) return 8
        gateRestoreFail=0
        if (epdDisplayCloseOwned(r,f,true) != 5 || sessionDma || sessionPins || gateRestored != 5 ||
            sessionBad || gateOwnerBad || epdBad || epdDisplayCloseOwned(r,f,true) != 5) return 9
        profile=profile+1
    }
    return 0
}
