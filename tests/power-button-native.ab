import "../src/m5stack/power_button_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var value=0
fun m5PmicKeyAxp(handle: int,kind: int): int = 0
fun m5PmicKeyPm1(handle: int): int = 0
fun m5PowerButtonRead(pmic: M5PmicOpen): M5PowerKeyRead { calls=calls+1; M5PowerKeyRead(value) }
@export("abla_power_button_test")
trusted fun buttonTest(): i32 {
    val pmic=M5PmicOpen((1<<40)|(5<<32)|123)
    var button=m5PowerButton(4294967294)
    value=3<<16
    button=button.pollOwned(pmic,1)
    if (calls != 0) return i32(1)
    value=(3<<16)|1
    button=button.pollOwned(pmic,2)
    if (calls != 1 || !button.wasClicked() || button.clickCount() != 1) return i32(2)
    value=3<<16; button=button.pollOwned(pmic,2)
    if (calls != 2 || button.event() != 0) return i32(3)
    button=button.pollOwned(pmic,502)
    if (button.wasDecideClickCount()) return i32(4)
    button=button.pollOwned(pmic,506)
    if (!button.wasDecideClickCount() || button.clickCount() != 1) return i32(5)
    button=button.pollOwned(pmic,506)
    if (button.event() != 0 || button.clickCount() != 0) return i32(6)
    value=(2<<16)|(4<<8)|5; button=button.pollOwned(pmic,510)
    if (button.event() != 0 || button.clickCount() != 0 || button.readStatus() != 2) return i32(7)
    value=(3<<16)|(4<<8)|5; button=button.pollOwned(pmic,514)
    if (!button.wasClicked() || !button.hardwareDoubleClick() || button.clickCount() != 1) return i32(8)
    value=3<<16; button=button.pollOwned(pmic,1200)
    if (button.clickCount() != 0 || button.wasDecideClickCount()) return i32(9)
    value=(3<<16)|2; button=button.pollOwned(pmic,1204)
    if (!button.wasHold()) return i32(10)
    value=1<<16; button=button.pollOwned(pmic,1204)
    if (button.event() != 0 || button.readStatus() != 1) return i32(11)
    val before=calls
    if (button.pollOwned(pmic,1300,-1) != button || button.pollOwned(pmic,1300,500,0) != button || calls != before) return i32(12)
    var threshold=0
    while (threshold <= 65535) {
        var bounded=m5PowerButton()
        value=(3<<16)|1
        bounded=bounded.pollOwned(pmic,4,threshold,1)
        value=3<<16
        bounded=bounded.pollOwned(pmic,4,threshold,1)
        bounded=bounded.pollOwned(pmic,4+threshold,threshold,1)
        if (bounded.wasDecideClickCount() || bounded.clickCount() != 1) return i32(13)
        bounded=bounded.pollOwned(pmic,5+threshold,threshold,1)
        if (!bounded.wasDecideClickCount() || bounded.clickCount() != 1) return i32(14)
        threshold=threshold+1
    }
    var wrap=m5PowerButton()
    var click=1
    value=(3<<16)|1
    while (click <= 257) {
        wrap=wrap.pollOwned(pmic,click*4)
        if (!wrap.wasClicked() || wrap.clickCount() != click%256) return i32(15)
        click=click+1
    }
    value=1<<16
    wrap=wrap.pollOwned(pmic,1000000)
    if (wrap.clickAge() != 131071 || wrap.event() != 0 || wrap.clickCount() != 1 || wrap.readStatus() != 1) return i32(16)
    value=3<<16
    wrap=wrap.pollOwned(pmic,1000004,65535)
    if (!wrap.wasDecideClickCount() || wrap.clickCount() != 1) return i32(17)
    val checks=calls
    if (wrap.pollOwned(pmic,2000000,65536) != wrap || wrap.pollOwned(pmic,2000000,500,65536) != wrap || calls != checks) return i32(18)
    i32(0)
}
