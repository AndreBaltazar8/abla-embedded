import "../src/rtc/pcf8563_device.ab"
import "../src/m5stack/rtc_device.ab"
import "../src/i2c/results.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type I2cDevice = int
var step=0
var failAt=0
var cleanupFail=false
var bad=false
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister8(register: int): int { bad=true; return 0 }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,buffer: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    step=step+1
    if (register != 1 || (step != 1 && step != failAt+1)) bad=true
    I2cByteResult(if (step == failAt) 0 else 256 | 14)
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    step=step+1
    if (failAt > 1 && step > failAt) {
        if (step == failAt+2) { if (register != 1 || value != 10) bad=true }
        else if (step == failAt+3) { if (register != 14 || value != 3) bad=true }
        else bad=true
        return !(cleanupFail && step == failAt+2)
    }
    val expectedRegister=if (step == 2 || step == 5) 14 else if (step == 3) 15 else 1
    val expectedValue=if (step == 2) 2 else if (step == 3) 1 else if (step == 4) 11 else 130
    if (register != expectedRegister || value != expectedValue) bad=true
    step != failAt
}
@export("abla_rtc_timer_test")
trusted fun timerTest(): i32 {
    // Pure planner must agree with checked API saturation over the full int
    // input domain; test before any bus activity, including signed endpoints.
    if (pcf8563TimerPlan(9223372036854775807) != pcf8563TimerPlan(15300000) ||
        pcf8563TimerPlan(9223372036854775308) != pcf8563TimerPlan(15300000) ||
        pcf8563TimerPlan(-9223372036854775807-1) != (3<<8) ||
        pcf8563TimerPlan(-1) != (3<<8) || pcf8563TimerPlan(0) != (3<<8)) return i32(10)
    var duration=1
    while (duration <= 15300000) {
        // Boundary sweep: every second and adjacent rounding edges.
        var delta=-1
        while (delta <= 1) {
            val request=duration+499+delta
            val plan=pcf8563TimerPlan(request)
            val rounded=(request+500)/1000
            val count=if (rounded <= 0) 0 else if (rounded < 270) (if (rounded > 255) 255 else rounded)
                else (if ((rounded+30)/60 > 255) 255 else (rounded+30)/60)
            val divisor=if (rounded < 270) 1 else 60
            if (pcf8563TimerCount(plan) != count || pcf8563TimerMilliseconds(plan) != count*divisor*1000) return i32(11)
            delta=delta+1
        }
        duration=duration+1000
    }
    var before=0
    while (before < 256) {
        var arrived=0
        while (arrived < 16) {
            val liveFlags=(before | arrived) & 12
            val stop=pcf8563Control2Write(before,4,1,0)
            val alarm=pcf8563Control2Write(before,0,2,2)
            if ((stop & 224) != 0 || (alarm & 224) != 0 || (stop & 1) != 0 ||
                (stop & 18) != (before & 18) || (liveFlags & stop) != (liveFlags & 8) ||
                (liveFlags & alarm) != liveFlags || (alarm & 2) == 0 || (alarm & 17) != (before & 17)) return i32(3)
            arrived=arrived+1
        }
        before=before+1
    }
    failAt=0
    while (failAt <= 5) {
        var variant=0
        while (variant < 4) {
            cleanupFail=(variant & 1) == 1; step=0; bad=false
            val result=if (variant < 2) Pcf8563(7).setTimerInterruptChecked(1000)
                else M5Rtc((1<<32)|7).setTimerInterruptChecked(1000)
            val expected=if (failAt == 0) 1 else if (failAt == 1) 3 else if (cleanupFail) 5 else 4
            if (result.status() != expected || result.milliseconds() != (if (failAt == 0) 1000 else 0) ||
                step != (if (failAt == 0) 5 else if (failAt == 1) 1 else failAt+3) || bad) return i32(1)
            variant=variant+1
        }
        failAt=failAt+1
    }
    step=0
    if (Pcf8563(0).setTimerInterruptChecked(1000).valid() || step != 0) return i32(2)
    if (M5Rtc(0).setTimerInterruptChecked(1000).status() != 2 ||
        M5Rtc((3<<32)|7).setTimerInterruptChecked(1000).status() != 6 ||
        M5Rtc((3<<32)|7).supportsTimerInterrupt() || step != 0) return i32(4)
    i32(0)
}
