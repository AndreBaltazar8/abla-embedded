import "../src/esp32/i2c/teardown_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var profile=0
var calls=0
var bad=false
fun c5I2cTeardownBusy(): bool {
    if (calls != 0) bad=true
    calls=1
    (profile&1) != 0
}
fun c5I2cTeardownRelease(sda: int,scl: int): bool {
    if (calls != 1 || sda != 2 || scl != 3) bad=true
    calls=2
    (profile&2) == 0
}
fun c5I2cTeardownDisable(): bool {
    if (calls != 2) bad=true
    calls=3
    (profile&4) == 0
}
@export("abla_c5_i2c_teardown_test")
trusted fun teardownTest(): i32 {
    while (profile < 8) {
        calls=0; bad=false
        val result=esp32C5I2cTeardownOwned(0,2,3)
        val status=if ((profile&1) != 0) 3 else if ((profile&2) != 0) 4 else if ((profile&4) != 0) 5 else 1
        if (result.status() != status || result.valid() != (status == 1) ||
            result.pinsReleased() != (status == 1 || status == 5) || calls != (if (status == 3) 1 else if (status == 4) 2 else 3) || bad) return i32(1)
        profile=profile+1
    }
    calls=0
    if (esp32C5I2cTeardownOwned(1,2,3).status() != 2 || esp32C5I2cTeardownOwned(0,2,2).status() != 2 ||
        esp32C5I2cTeardownOwned(0,13,3).status() != 2 || calls != 0) return i32(2)
    i32(0)
}
