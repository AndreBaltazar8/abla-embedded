import "../src/display/unit_glass_tone.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
fun I2cDevice.valid(): bool = this == 7
trusted fun I2cDevice.read(bytes: NativeBuffer,length: int): bool { bad=true;return false }
val memory=nativeStaticAllocate(32)
var calls=0
var waits=0
var fail=false
var commitFailed=false
var sounding=false
var bad=false
trusted fun I2cDevice.write(bytes: NativeBuffer,length: int): bool {
    calls=calls+1
    if (length == 5) {
        if (bytes.load(0) != 192 || bytes.loadU16(1) != 440 || bytes.load(3) != 128 || bytes.load(4) != 1) bad=true
        if (!fail || commitFailed) sounding=true
    } else {
        if (length != 2 || bytes.load(0) != 195 || bytes.load(1) != 0) bad=true
        if (!fail || commitFailed) sounding=false
    }
    return !fail
}
fun glassDelayMicroseconds(us: int): void { if (us != 1000) bad=true;waits=waits+1;return }
@export("abla_unit_glass_tone_test")
trusted fun test(): i32 {
    val tone=unitGlassToneAt(nativeBufferAt(memory,24))
    val scratch=nativeBufferAt(memory+24,8)
    var scenario=0
    while (scenario < 4) {
        calls=0;waits=0;bad=false;sounding=false
        fail=(scenario&1) != 0;commitFailed=(scenario&2) != 0
        if (!tone.initialize()) return i32(1)
        if (tone.startOwned(I2cDevice(7),440,128,4294967290,10,scratch,true) != (if (fail) 3 else 1) ||
            calls != 1 || waits != 1 || sounding != (!fail || commitFailed)) return i32(2)
        if (tone.startOwned(I2cDevice(7),440,128,0,10,scratch,true) != 2 || calls != 1) return i32(3)
        val status=tone.status()
        if (tone.pollOwned(3,scratch,true) != status || calls != 1 || tone.stopOwned(scratch,false)) return i32(4)
        fail=true
        if (tone.stopOwned(scratch,true) || tone.status() != 4 || tone.device() != I2cDevice(7)) return i32(5)
        fail=false
        if (tone.pollOwned(4,scratch,true) != 0 || sounding || tone.device() != I2cDevice(0) ||
            tone.startFailure() != (if ((scenario&1) != 0) 3 else 0) || calls != 3 || waits != 3 || bad) return i32(6)
        if (!tone.stopOwned(scratch,true) || calls != 3) return i32(7)
        if (tone.startOwned(I2cDevice(7),440,128,4294967290,10,scratch,true) != 1 ||
            tone.pollOwned(3,scratch,true) != 1 || tone.pollOwned(4,scratch,true) != 0 || sounding || calls != 5) return i32(8)
        scenario=scenario+1
    }
    calls=0
    if (tone.startOwned(I2cDevice(7),0,128,0,10,scratch,true) != 2 ||
        tone.startOwned(I2cDevice(7),440,0,0,10,scratch,true) != 2 ||
        tone.startOwned(I2cDevice(7),440,128,0,2147483648,scratch,true) != 2 ||
        tone.startOwned(I2cDevice(7),440,128,0,10,nativeBufferAt(memory,5),true) != 2 ||
        tone.startOwned(I2cDevice(0),440,128,0,10,scratch,true) != 2 || calls != 0) return i32(9)
    return i32(0)
}
