import "../src/esp32/ahb_gdma_controller_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val regs=nativeStaticAllocate(1024)
val addresses=nativeStaticU32s([0x500e6018,0x500e60c4,0x500e60c4,0x50085064,0x500853c4,0x500853c8])
val masks=nativeStaticU32s([8,2,2,13,0xffffffff,0xffffffff])
val values=nativeStaticU32s([8,2,0,8,0x40000000,0x4ffc0000])
var clock=0xa5a55a50
var resetReg=0x12345670
var writes=0
var reads=0
var fences=0
var fail=0
var bad=false
trusted fun p4AhbControllerRead(address: int): int {
    reads=reads+1
    if (address == 0x500e60c4) return resetReg
    if (address == 0x500e6018) return clock
    if ((clock & 8) == 0) bad=true
    val offset=address-0x50085000
    if (offset < 0 || offset >= 1024 || (offset & 3) != 0) { bad=true;return 0 }
    return nativeAddressLoadU32(regs,offset)
}
trusted fun p4AhbControllerWrite(address: int,value: int): void {
    if (writes >= 6) { bad=true;return }
    val expectedAddress=nativeAddressLoadU32(addresses,writes*4)
    val mask=nativeAddressLoadU32(masks,writes*4)
    val expected=(p4AhbControllerRead(expectedAddress)&(0xffffffff ^ mask)) | nativeAddressLoadU32(values,writes*4)
    if (address != expectedAddress || value != expected) bad=true
    writes=writes+1
    val stored=if (writes == fail) value ^ mask else value
    if (address == 0x500e60c4) resetReg=stored
    else if (address == 0x500e6018) clock=stored
    else nativeAddressStoreU32(regs,address-0x50085000,stored)
    return
}
trusted fun p4AhbControllerFence(): void { if (writes != 6) bad=true;fences=fences+1;return }
trusted fun reset(): void {
    var at=0
    while (at < 1024) { nativeAddressStoreU32(regs,at,0);at=at+4 }
    var channel=0
    while (channel < 3) {
        nativeAddressStoreU32(regs,128+channel*192,17)
        nativeAddressStoreU32(regs,224+channel*192,8)
        channel=channel+1
    }
    nativeAddressStoreU32(regs,100,0xfffffff2)
    clock=0xa5a55a50;resetReg=0x12345670
    writes=0;reads=0;fences=0;fail=0;bad=false
    return
}
trusted fun run(): int = esp32p4AhbGdmaControllerInitializeOwned(0x40000000,0x4ffc0000,true)
@export("abla_ahb_gdma_controller_p4_test")
trusted fun test(): i32 {
    reset()
    if (run() != 1 || bad || writes != 6 || fences != 1 || clock != 0xa5a55a58 || resetReg != 0x12345670) return i32(1)
    var stage=1
    while (stage <= 6) {
        reset();fail=stage
        if (run() != (if (stage == 1) 4 else stage+5) || writes != stage || fences != 0 || bad) return i32(2)
        stage=stage+1
    }
    var channel=0
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            var defect=0
            while (defect < 5) {
                reset()
                val base=112+channel*192+direction*96
                val events=channel*16+direction*48
                if (defect == 0) nativeAddressStoreU32(regs,base+16,0)
                if (defect == 1) nativeAddressStoreU32(regs,base,1)
                if (defect == 2) nativeAddressStoreU32(regs,base+16,if (direction == 1) 10 else 21)
                if (defect == 3) nativeAddressStoreU32(regs,events,1)
                if (defect == 4) nativeAddressStoreU32(regs,events+8,1)
                if (run() != (if (defect < 3) 5 else 6) || writes != 1 || fences != 0 || bad) return i32(3)
                defect=defect+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    reset();resetReg=resetReg | 2
    if (run() != 3 || writes != 0 || reads != 1) return i32(4)
    reset()
    if (esp32p4AhbGdmaControllerInitializeOwned(0x40000000,0x4ffc0000,false) != 2 ||
        esp32p4AhbGdmaControllerInitializeOwned(0x3fffffc0,0x4ffc0000,true) != 2 ||
        esp32p4AhbGdmaControllerInitializeOwned(0x40000000,0x4ffc0040,true) != 2 ||
        esp32p4AhbGdmaControllerInitializeOwned(0x40000004,0x4ffc0000,true) != 2 ||
        esp32p4AhbGdmaControllerInitializeOwned(0x4ff00000,0x4ff00000,true) != 2 || reads != 0 || writes != 0) return i32(5)
    return i32(0)
}
