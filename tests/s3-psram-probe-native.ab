import "../src/esp32/psram/probe_s3_sequence.ab"
import "abla/build"
val probeStorage=nativeStaticAllocate(128)
var probeWord=0
var probeAddress=0
var probeCalls=0
var probeFail=0
var probeCorrupt=false
var probeReady=true
var probeBad=false
fun s3PsramCommandStorageSafe(address: int,length: int): bool = address >= probeStorage && address+length <= probeStorage+128
fun s3PsramCommandReady(): bool = probeReady
fun s3PsramOpiDtrMode(): void { return }
fun s3PsramCommandConfigure(unit: int,descriptor: int): void { if (unit != 1 || descriptor != probeStorage) probeBad=true;return }
fun s3PsramCommandStart(rx: int,length: int): void {
    val work=nativeBufferAt(probeStorage,100)
    if (work.loadU32(32) != probeAddress || work.loadU32(8) != 32) probeBad=true
    if (probeCalls == 0) {
        if (work.loadU32(0) != 0x108080 || work.loadU32(28) != 8 || work.loadU32(16) != 32 || rx != 0 || length != 0) probeBad=true
        probeWord=work.loadU32(36)
    } else {
        if (probeCalls != 1 || work.loadU32(0) != 0x100000 || work.loadU32(28) != 18 ||
            work.loadU32(24) != 32 || rx != probeStorage+36 || length != 4) probeBad=true
        work.storeU32(36,if (probeCorrupt) probeWord^0x10000 else probeWord)
    }
    probeCalls=probeCalls+1
    if (probeCalls == probeFail) probeReady=false
    return
}
@export("abla_s3_psram_probe_test")
fun testPsramProbe(): int {
    val work=nativeBufferAt(probeStorage,100);val scratch=nativeBufferAt(probeStorage+104,8)
    var addressCase=0
    while (addressCase < 3) {
        probeAddress=if (addressCase == 0) 0 else if (addressCase == 1) 4096 else 4294967292
        var profile=0
        while (profile < 4) {
            probeCalls=0;probeWord=0;probeReady=true;probeBad=false
            probeFail=if (profile < 3) profile else 0;probeCorrupt=profile == 3
            val result=s3PsramProbeOwned(probeAddress,4,scratch,work,true)
            val expected=if (profile == 0) 1 else if (profile == 3) 5 else 4
            if (result != expected || probeCalls != (if (profile == 1) 1 else 2) || probeBad ||
                scratch.loadU32(0) != 0x5a6b7c8d || probeWord != 0x5a6b7c8d) return 1
            if (profile == 0 && scratch.loadU32(4) != 0x5a6b7c8d) return 2
            if ((profile == 1 || profile == 2) && scratch.loadU32(4) != 0) return 3
            profile=profile+1
        }
        addressCase=addressCase+1
    }
    probeCalls=0;probeReady=true
    if (s3PsramProbeOwned(1,4,scratch,work,true) != 2 || s3PsramProbeOwned(0,3,scratch,work,true) != 2 ||
        s3PsramProbeOwned(4294967292,8,scratch,work,true) != 2 || s3PsramProbeOwned(0,4,scratch,work,false) != 2 ||
        s3PsramProbeOwned(0,4,work,work,true) != 2 || probeCalls != 0) return 4
    probeReady=false
    if (s3PsramProbeOwned(0,4,scratch,work,true) != 3 || probeCalls != 0) return 5
    return 0
}
