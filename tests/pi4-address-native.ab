import "../src/i2c/results.ab"
import "../src/io_expander/pi4ioe5v6408_device.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var calls=0
var addressSeen=0
var bad=false
var fail=false
var payload=0
fun I2cBus.valid(): bool = this == 7
fun I2cBus.device(address: int,hz: int): I2cDevice {
    calls=calls+1; addressSeen=address
    if (this != 7 || hz != 400000) bad=true
    I2cDevice(if (fail) 0 else 8)
}
fun I2cDevice.close(): bool { calls=calls+1; return this == 8 }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    calls=calls+1
    if (this != 8 || register != 5) bad=true
    if (fail) I2cByteResult(0) else I2cByteResult(256|payload)
}
// Unexpected writes must be visible, even though these tests only open/read.
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; calls=calls+1; false }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; calls=calls+1; false }
@export("abla_pi4_address_test")
fun pi4Test(): i32 {
    var profile=0
    while (profile < 1040) {
        val address=profile%130-1
        fail=(profile/130)%2 != 0
        val bus=I2cBus(if (profile < 260) 7 else 0)
        calls=0; bad=false
        val device=pi4Ioe5v6408(bus,address)
        val allowed=bus == 7 && (address == 67 || address == 68)
        if (device.valid() != (allowed && !fail) || calls != (if (allowed) 1 else 0) || bad || (allowed && addressSeen != address)) return i32(1)
        profile=profile+1
    }
    fail=false; calls=0; bad=false
    if (!pi4Ioe5v6408(I2cBus(7)).valid() || calls != 1 || addressSeen != 67 || bad) return i32(2)
    profile=0
    while (profile < 4096) {
        payload=profile & 255; val pin=(profile/256)%8; fail=profile >= 2048
        calls=0; bad=false
        val result=Pi4Ioe5v6408(8).getWriteValueChecked(pin)
        if ((result | 0) != (if (fail) 0 else 256|((payload>>>pin)&1)) || calls != 1 || bad) return i32(3)
        profile=profile+1
    }
    calls=0
    if (Pi4Ioe5v6408(0).getWriteValueChecked(0).valid() || Pi4Ioe5v6408(8).getWriteValueChecked(-1).valid() ||
        Pi4Ioe5v6408(8).getWriteValueChecked(8).valid() || calls != 0) return i32(4)
    i32(0)
}
