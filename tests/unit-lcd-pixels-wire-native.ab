import "./unit-lcd-owner-wire-native.ab"
@export("abla_unit_lcd_pixels_wire_test")
trusted fun testLcdPixelsWire(): i32 {
    wireSeed();extraAddress=62;extraCanRead=true;extraReadValue=255
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val device=control.session().bus().device(62,100000)
    val source=nativeBufferAt(lcdMemory,2000);val scratch=nativeBufferAt(lcdMemory+2000,1201)
    val e=nativeBufferAt(oledExpected,16384);val captured=nativeBufferAt(extraWire,8192)
    var bpp=1
    while (bpp <= 4) {
        var variant=0
        while (variant < 5) {
            val width=if (variant < 3) variant+1 else if (variant == 3) 135 else 240
            val stride=width*bpp+3;val rotation=if (width == 240) 1 else 0
            var at=0;while (at < 2000) { source.store(at,165);at=at+1 }
            at=0;while (at < width*bpp) {
                source.store(at,(at%bpp)*37+19)
                source.store(stride+at,(at/bpp)*73+(at%bpp)*19);at=at+1
            }
            var encoded=0
            while (encoded < 2) {
                expectedCount=0;var row=0;var secondPayload=0
                while (row < 2) {
                    expectedPages=row;expectedStage=3
                    lcdExpectStart(124);expectByte(9);lcdExpectStart(125)
                    expectedStage=5;lcdExpectStart(124);expectByte(42);expectByte(0);expectByte(width-1);expectByte(43);expectByte(5+row);expectByte(5+row)
                    expectedStage=6
                    if (row == 1) secondPayload=expectedCount
                    lcdExpectStart(124);expectByte((if (encoded == 1) 72 else 64)|bpp)
                    if (encoded == 1 && row == 0) {
                        expectByte(width);at=0;while (at < bpp) { expectByte(at*37+19);at=at+1 }
                    } else {
                        if (encoded == 1 && width >= 3) { expectByte(0);expectByte(width) }
                        at=0;while (at < width*bpp) {
                            if (encoded == 1 && width < 3 && at%bpp == 0) expectByte(1)
                            expectByte(if (row == 0) (at%bpp)*37+19 else (at/bpp)*73+(at%bpp)*19)
                            at=at+1
                        }
                    }
                    row=row+1
                }
                var failure=0
                while (failure <= expectedCount) {
                    var commit=0
                    while (commit < 2) {
                        val before=ackCount;extraCount=0;nackAfterCommit=commit == 1
                        nackAt=if (failure == 0) 0 else before+failure
                        val result=device.unitLcdWritePixels(0,5,width,2,rotation,source,stride,bpp,scratch,1,encoded == 1)
                        val expected=if (failure == 0) 513 else e.load((failure-1)*4+2)|(e.load((failure-1)*4+3)<<8)
                        val failedIndex=if (failure == 0) 0 else if (failure > secondPayload) failure-secondPayload-1 else if (failure > 10) failure-11 else e.load((failure-1)*4)
                        // Only payload writes can commit on a modeled NACK;
                        // long transaction indices must not wrap for this rule.
                        val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && e.load((failure-1)*4+2) == 6 && failedIndex > 1) 1 else if (commit == 1 && e.load((failure-1)*4+2) != 6 && e.load((failure-1)*4) > 1) 1 else 0)
                        if (result != expected || ackCount-before != (if (failure == 0) expectedCount else failure) || extraCount != accepted || bad || mode != 0) return i32(2)
                        at=0;while (at < accepted) {
                            if (captured.load(at*2) != e.load(at*4) || captured.load(at*2+1) != e.load(at*4+1)) return i32(3)
                            at=at+1
                        }
                        commit=commit+1
                    }
                    failure=failure+1
                }
                encoded=encoded+1
            }
            at=0;while (at < 2000) {
                val original=if (at < width*bpp) ((at%bpp)*37+19)&255 else if (at >= stride && at < stride+width*bpp) ((((at-stride)/bpp)*73+((at-stride)%bpp)*19)&255) else 165
                if (source.load(at) != original) return i32(4)
                at=at+1
            }
            variant=variant+1
        }
        bpp=bpp+1
    }
    nackAt=0;nackAfterCommit=false;val before=ackCount
    if (device.unitLcdWritePixels(0,0,1,1,0,source,4,0,scratch,1) != 2 || device.unitLcdWritePixels(0,0,1,1,0,source,5,5,scratch,1) != 2 ||
        device.unitLcdWritePixels(0,0,240,2,1,source,960,4,nativeBufferAt(lcdMemory+2000,1200),1,true) != 2 ||
        device.unitLcdWritePixels(0,0,240,2,1,source,960,4,source,1,true) != 2 || ackCount != before) return i32(5)
    if (!device.close() || !control.closeOwned(true) || pads != 0 || bad) return i32(6)
    return i32(0)
}
