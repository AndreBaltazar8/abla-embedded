import "../src/esp32/timer_control_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var pcr=u32(0)
var clock=u32(0)
var config=u32(0)
var writes=0
var reads=0
var waitReads=0
var delay=0
var fault=0
var bad=false
fun esp32C5TimerRead(address: int): u32 {
    reads=reads+1
    if (address == 0x6009606C) {
        if (writes == 0) return pcr
        if (writes != 1) bad=true
        waitReads=waitReads+1
        return (pcr&~u32(4))|(if (waitReads > delay) u32(4) else u32(0))
    }
    if (address == 0x60096070) {
        if (writes < 1 || writes > 2 || waitReads <= delay) bad=true
        return clock
    }
    if (address == 0x6000A000) {
        if (writes < 2 || writes > 3 || (clock&u32(0x400000)) == u32(0)) bad=true
        return config
    }
    bad=true
    u32(0)
}
fun esp32C5TimerWrite(address: int,value: u32): void {
    if (writes == 0 && address == 0x6009606C) {
        if (value != ((pcr|u32(1))&~u32(2))) bad=true
        pcr=value
    } else if (writes == 1 && address == 0x60096070) {
        if (value != (clock|u32(0x400000))) bad=true
        if (fault != 1) clock=value
    } else if (writes == 2 && address == 0x6000A000) {
        if (fault != 2) config=value else config=value^u32(0x80000000)
    } else bad=true
    writes=writes+1
    return
}
@export("abla_timer_c5_control_test")
trusted fun controlTest(): i32 {
    var profile=0
    while (profile < 3840) {
        val unit=profile%2
        val enable=profile/2%2 == 1
        val stall0=profile/4%2 == 1
        val stall1=profile/8%2 == 1
        delay=profile/16%5; fault=profile/80%3
        val seed=u32(profile)*u32(2654435761)
        pcr=seed; clock=seed&~u32(0x400000); config=~seed
        val before=config; val oldClock=clock
        writes=0; reads=0; waitReads=0; bad=false
        val expected=delay < 4 && fault == 0
        if (esp32C5TimerConfigureLocked(unit,enable,stall0,stall1,4) != expected || bad ||
            writes != (if (delay >= 4) 1 else if (fault == 1) 2 else 3)) return i32(1)
        val work=if (unit == 0) u32(0x40000000) else u32(0x20000000)
        val c0=if (unit == 0) u32(0x10000000) else u32(0x04000000)
        val c1=if (unit == 0) u32(0x08000000) else u32(0x02000000)
        val mask=work|c0|c1|u32(0x80000000)
        if ((config&~mask) != (before&~mask) || (clock&~u32(0x400000)) != oldClock) return i32(2)
        if (expected && config != ((before&~mask)|u32(0x80000000)|(if (enable) work else u32(0))|
            (if (stall0) c0 else u32(0))|(if (stall1) c1 else u32(0)))) return i32(3)
        profile=profile+1
    }
    reads=0; writes=0
    if (esp32C5TimerConfigureLocked(-1,true,false,false,4) || esp32C5TimerConfigureLocked(2,true,false,false,4) ||
        esp32C5TimerConfigureLocked(0,true,false,false,0) || esp32C5TimerConfigureLocked(0,true,false,false,1000001) ||
        reads != 0 || writes != 0) return i32(4)
    i32(0)
}
