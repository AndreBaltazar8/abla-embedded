import "../src/esp32/spi/phases_async_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_spi_phases_async_s3_target")
trusted fun target(operation: int,context: NativeBuffer,peripheral: int,command: int,commandBits: int,address: int,addressBits: int,dummy: int,direction: int,data: NativeBuffer,bytes: int,now: u32,budget: u32,released: bool): int {
    if (operation == 0) return esp32s3SpiPhasesBeginOwned(context,peripheral,command,commandBits,address,addressBits,dummy,direction,data,bytes,now,budget,released)
    return esp32s3SpiPhasesPollOwned(context,now)
}
