import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/storage/fat_software_sd.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_read_target")
trusted fun target(reader: int,boot: int,first: int,sectors: int,cluster: int,scratch: int): int =
    fatReadLinkOwned(nativeBufferAt(reader,28),nativeBufferAt(boot,512),first,sectors,cluster,nativeBufferAt(scratch,1024)).nextCluster()
