import "../src/m5stack/cores3_playback_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/esp32/gdma_ring_esp32s3.ab"
import "../src/esp32/i2s/clock_choice_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Aw88298 = int
type Aw9523 = int
fun Aw88298.valid(): bool = this != 0
fun Aw9523.valid(): bool = this != 0
type TestResult = int
fun TestResult.status(): int = this & 255
fun TestResult.valid(): bool = this.status() == 1
var requestedRate=16000
var rateAdjustment=0
fun TestResult.sampleRate(): int = requestedRate+rateAdjustment
fun TestResult.dmaStatus(): int = cleanupDma
fun TestResult.amplifierStatus(): int = cleanupAmplifier
fun TestResult.transferredBytes(): int = 960
fun TestResult.nextIndex(): int = (this >>> 8) & 255
var prepared = false
var started = false
var leading = 0
var completed = 0
var stops = 0
var delays = 0
var staged = 0
var busyRemaining = 0
var failure = 0
var stopStatus = 1
var prepareStatus = 1
var startStatus = 1
var cleanupDma = 1
var cleanupAmplifier = 257
var bad = false
var mixed = false
var mixedRate = false
var queuedBank = false
trusted fun esp32s3GdmaWrite(address: int, value: int): void { bad = true; return }
trusted fun esp32s3GdmaPublish(): void { bad = true; return }
trusted fun coreS3PrepareAudioDma(tx: bool, rate: int, channel: int, descriptors: int, count: int, buffers: int, block: int, owner: u32): TestResult { if (!tx || rate != requestedRate || count != 6 || block != 960) bad = true; prepared = true; TestResult(prepareStatus) }
trusted fun coreS3LoadPlaybackBlock(destination: int, source: NativeBuffer, index: int, count: int): void {
    if (!prepared) bad = true
    if (!started) {
        if (destination != 0x3fc90000 + leading * 960 || count != 0) bad = true
        leading = leading + 1
    } else {
        if (true) bad = true
        staged = staged + 1
    }
    return
}
trusted fun cores3StartSpeakerStream(amp: Aw88298, expander: Aw9523, rate: int, channel: int, descriptors: int, polls: int): TestResult { if (leading != 6 || rate != requestedRate+rateAdjustment) bad = true; started = true; TestResult(startStatus) }
trusted fun cores3StopSpeakerStream(amp: Aw88298, expander: Aw9523, channel: int, polls: int): TestResult { stops = stops + 1; TestResult(stopStatus) }
trusted fun peripheralDelayMicroseconds(us: int): void { if (us != 1000) bad = true; delays = delays + 1; return }
trusted fun esp32s3GdmaPumpBlock(channel: int, tx: bool, descriptors: int, count: int, index: int, buffer: NativeBuffer, length: int, polls: int): TestResult {
    if (!started || !tx || count != 6 || index != completed % 6 || length != 960 || polls != 1) bad = true
    if (busyRemaining > 0) { busyRemaining = busyRemaining - 1; return TestResult(3) }
    if (failure != 0 && completed == 7) return TestResult(failure)
    val bytes=nativeBufferAt(stagingStorage,960)
    var offset=0
    while (offset < 960) {
        val sample=completed*240+offset/4
        val expected=if (queuedBank) (if (sample < 480) 49152 else 0) else if (mixed) ((if (sample >= 2 && sample < (if (mixedRate) 966 else 484)) -8192 else 0) +
            (if (sample < (if (mixedRate) 482 else 241)) -4096 else 0)) & 65535 else if (sample < 241) 49152 else 0
        if (bytes.loadU16(offset) != expected || bytes.loadU16(offset+2) != expected) bad=true
        offset=offset+4
    }
    completed = completed + 1
    TestResult(1 | ((completed % 6) << 8))
}
val stagingStorage=nativeStaticAllocate(960)
val metadataStorage=nativeStaticAllocate(20)
val sourceStorage=nativeStaticAllocate(241)
val mixTableStorage=nativeStaticAllocate(32)
val mixAccumulatorStorage=nativeStaticAllocate(1920)
val mixScratchStorage=nativeStaticAllocate(960)
val queuedBankStorage=nativeStaticAllocate(32)
@export("abla_cores3_wav_test")
trusted fun wavPlaybackTest(): i32 {
    val source=nativeBufferAt(sourceStorage,241)
    val metadata=nativeBufferAt(metadataStorage,20)
    var i=0
    while (i < 241) { source.store(i,64); i=i+1 }
    metadata.storeU32(0,sourceStorage); metadata.storeU32(4,241)
    metadata.storeU32(8,16000); metadata.storeU32(12,1); metadata.storeU32(16,8)
    var rateIndex=0
    while (rateIndex < 7) {
    requestedRate=if (rateIndex == 0) 8000 else if (rateIndex == 1) 11025 else if (rateIndex == 2) 16000 else if (rateIndex == 3) 22050 else if (rateIndex == 4) 44100 else if (rateIndex == 5) 48000 else 96000
    metadata.storeU32(8,requestedRate)
    val clock=esp32s3I2sChooseDivider(160000000,requestedRate*256)
    val actual=(clock.frequency(160000000)+128)/256
    val clockError=if (actual >= requestedRate) actual-requestedRate else requestedRate-actual
    if (!clock.valid() || clockError*1000 > requestedRate) return i32(4)
    val tail=if (requestedRate > 16000) (requestedRate+1999)/2000 else 8
    var variant=0
    while (variant < 3) {
        prepared=false; started=false; leading=0; completed=0; stops=0; bad=false
        busyRemaining=if (variant == 1) 2 else 0
        failure=if (variant == 2) 4 else 0
        val result=cores3PlaybackBlocks(Aw88298(1),Aw9523(1),2,
            0x3fc88000,0x3fc90000,source,2,nativeBufferAt(stagingStorage,960),
            u32(7),3,PcmWav(metadataStorage))
        if (result.status() != (if (variant == 2) 68 else 1) ||
            result.bytes() != (if (variant == 2) 960 else 964) ||
            result.dmaStatus() != 1 || result.amplifierStatus() != 257 ||
            completed != (if (variant == 2) 7 else 8+tail) || stops != 1 || bad) return i32(1)
        variant=variant+1
    }
    rateIndex=rateIndex+1
    }
    requestedRate=16000
    metadata.storeU32(8,16000)
    var sign=-1
    while (sign <= 1) {
        rateAdjustment=sign*17
        prepared=false; started=false; leading=0; stops=0
        if (cores3PlaybackBlocks(Aw88298(1),Aw9523(1),2,
            0x3fc88000,0x3fc90000,source,2,nativeBufferAt(stagingStorage,960),
            u32(7),3,PcmWav(metadataStorage)).status() != 31 || !prepared || started || leading != 0 || stops != 0) return i32(3)
        sign=sign+2
    }
    rateAdjustment=0
    mixed=true
    val mix=pcmWavMixAt(nativeBufferAt(mixTableStorage,32),2)
    if (!mix.setVoice(0,PcmWav(metadataStorage),16384,2,2) ||
        !mix.setVoice(1,PcmWav(metadataStorage),8192)) return i32(5)
    var variant=0
    while (variant < 4) {
        prepared=false; started=false; leading=0; completed=0; stops=0; bad=false
        busyRemaining=if (variant == 1) 2 else 0
        failure=if (variant == 2) 4 else 0
        val result=cores3PlaybackBlocks(Aw88298(1),Aw9523(1),2,
            0x3fc88000,0x3fc90000,mix.storage(),3,nativeBufferAt(stagingStorage,960),
            u32(7),3,PcmWav(0),mix,nativeBufferAt(mixAccumulatorStorage,1920),
            nativeBufferAt(if (variant == 3) mixAccumulatorStorage else mixScratchStorage,960))
        if (variant == 3) {
            if (result.status() != 2 || prepared || started || stops != 0) return i32(6)
        } else if (result.status() != (if (variant == 2) 68 else 1) ||
            result.bytes() != (if (variant == 2) 960 else 1936) ||
            completed != (if (variant == 2) 7 else 17) || stops != 1 || bad) return i32(7)
        variant=variant+1
    }
    mixedRate=true
    metadata.storeU32(8,8000)
    prepared=false; started=false; leading=0; completed=0; stops=0; bad=false; failure=0; busyRemaining=2
    val resampled=cores3PlaybackBlocks(Aw88298(1),Aw9523(1),2,
        0x3fc88000,0x3fc90000,mix.storage(),5,nativeBufferAt(stagingStorage,960),
        u32(7),3,PcmWav(0),mix,nativeBufferAt(mixAccumulatorStorage,1920),
        nativeBufferAt(mixScratchStorage,960),32768,16000)
    if (resampled.status() != 1 || resampled.bytes() != 3864 || completed != 19 || stops != 1 || bad) return i32(8)
    metadata.storeU32(8,16000)
    queuedBank=true
    var queuedVariant=0
    while (queuedVariant < 5) {
    val bank=pcmChannelsAt(nativeBufferAt(queuedBankStorage,32),1,16000)
    if (bank.enqueue(PcmWav(metadataStorage),10) != 0) return i32(9)
    prepared=false; started=false; leading=0; completed=0; stops=0; bad=false
    failure=if (queuedVariant == 1) 4 else 0
    busyRemaining=if (queuedVariant == 2) 3 else 2
    stopStatus=if (queuedVariant == 3) 6 else 1
    cleanupDma=if (queuedVariant == 3) 9 else 1
    cleanupAmplifier=if (queuedVariant == 3) 769 else 257
    val queued=cores3PlaybackBlocks(Aw88298(1),Aw9523(1),2,
        0x3fc88000,0x3fc90000,bank.storage(),2,nativeBufferAt(stagingStorage,960),u32(7),3,
        PcmWav(0),PcmWavMix(0),nativeBufferAt(mixAccumulatorStorage,1920),
        nativeBufferAt(if (queuedVariant == 4) queuedBankStorage else mixScratchStorage,960),32768,0,bank)
    if (queuedVariant == 4) {
        if (queued.status() != 2 || prepared || started || stops != 0 ||
            bank.channel(0).storage().loadU32(12) != 10 || bank.channel(0).storage().loadU32(16) != 0) return i32(11)
    } else {
        val expectedStatus=if (queuedVariant == 1) 68 else if (queuedVariant == 2) 67 else if (queuedVariant == 3) 96 else 1
        val expectedBytes=if (queuedVariant == 1) 960 else if (queuedVariant == 2) 0 else 1920
        val expectedCompleted=if (queuedVariant == 1) 7 else if (queuedVariant == 2) 0 else 16
        if (queued.status() != expectedStatus || queued.bytes() != expectedBytes || completed != expectedCompleted ||
            stops != 1 || bad || queued.dmaStatus() != cleanupDma || queued.amplifierStatus() != cleanupAmplifier ||
            bank.channel(0).storage().loadU32(12) != (if (queuedVariant == 2) 10 else 9) ||
            bank.channel(0).storage().loadU32(16) != (if (queuedVariant == 2) 240 else 239)) return i32(10)
    }
    queuedVariant=queuedVariant+1
    }
    metadata.storeU32(8,7999); prepared=false
    if (cores3PlaybackBlocks(Aw88298(1),Aw9523(1),2,
        0x3fc88000,0x3fc90000,source,2,nativeBufferAt(stagingStorage,960),
        u32(7),3,PcmWav(metadataStorage)).status() != 2 || prepared) return i32(2)
    i32(0)
}
