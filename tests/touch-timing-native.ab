import "../src/esp32/touch/timing.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_touch_timing_test")
fun test(): i32 {
    var clock=0
    while (clock < 6) {
        val fast=if (clock == 0) 1000000 else if (clock == 1) 7999999 else if (clock == 2) 8000000 else if (clock == 3) 10000000 else if (clock == 4) 40000000 else 1234567
        val slow=if (clock%2 == 0) 32768 else 150000
        var us=0
        while (us <= 65535) {
            val t=esp32TouchTimingFromMicroseconds(fast,slow,us,us+1,us)
            // Independent quotient/remainder decomposition of the conversion.
            val w=us*(fast/1000000)+(us*(fast%1000000))/1000000
            val c=(us+1)*(fast/1000000)+((us+1)*(fast%1000000))/1000000
            val interval=us*slow/1000000
            if (!t.valid() || t.waitTicks() != (if (w > 255) 255 else w) || t.chargeTicks() != (if (c > 65535) 65535 else c) || t.intervalTicks() != interval) return i32(1)
            us=us+1
        }
        val profile=esp32TouchTimingM5Classic(fast,slow)
        val expected=5000*(fast/1000000)
        if (!profile.valid() || profile.waitTicks() != 255 || profile.chargeTicks() != (if (expected > 65535) 65535 else expected) || profile.intervalTicks() != 320*slow/1000000) return i32(2)
        clock=clock+1
    }
    val max=esp32TouchTimingFromMicroseconds(40000000,1,2147483647,2147483647,2147483647)
    if (!max.valid() || max.waitTicks() != 255 || max.chargeTicks() != 65535 || max.intervalTicks() != 2147) return i32(3)
    if (!esp32TouchTimingFromMicroseconds(8000000,150000,0,1,436906).valid() ||
        esp32TouchTimingFromMicroseconds(8000000,150000,0,1,436907).valid()) return i32(4)
    if (esp32TouchTimingFromMicroseconds(999999,32768,1,1,1).valid() || esp32TouchTimingFromMicroseconds(40000001,32768,1,1,1).valid() ||
        esp32TouchTimingFromMicroseconds(8000000,0,1,1,1).valid() || esp32TouchTimingFromMicroseconds(8000000,32768,-1,1,1).valid() ||
        esp32TouchTimingFromMicroseconds(8000000,32768,1,0,1).valid() || esp32TouchTimingFromMicroseconds(8000000,32768,1,1,-1).valid() ||
        Esp32TouchTiming(1<<40).valid() || Esp32TouchTiming((1<<41)|256).valid()) return i32(5)
    i32(0)
}
