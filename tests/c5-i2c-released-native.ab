import "../src/esp32/i2c/released_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var defects=0
var physical=0
var delays=0
var reads=0
var bad=false
fun c5I2cPinLoad(address: int): int {
    reads=reads+1
    if (address == 0x600B102C) return if ((defects&1) != 0) 4 else 0
    if (address == 0x600B1028) return if ((defects&2) != 0) 8 else 0
    if (address == 0x60004008) return if ((physical&(if (delays == 0) 1 else 4)) != 0) 16 else 0
    if (address == 0x60091064) return if ((physical&(if (delays == 0) 2 else 8)) != 0) 8 else 12
    var index=0
    while (index < 2) {
        val pin=3-index
        val bit=2+index*4
        if (address == 0x60090000+pin*4) return 0x1300^(if ((defects&(1<<bit)) != 0) 2 else 0)
        if (address == 0x600910D4+pin*4) return if ((defects&(1<<(bit+1))) != 0) 0 else 4
        if (address == 0x600912D4+(46+index)*4) return (256|pin)^(if ((defects&(1<<(bit+2))) != 0) 128 else 0)
        if (address == 0x60091AD4+pin*4) return (46+index)|(if ((defects&(1<<(bit+3))) != 0) 1024 else 0)
        index=index+1
    }
    bad=true
    return 0
}
fun c5I2cPinStore(address: int,value: int): void { bad=true; return }
fun c5I2cReleasedDelay(): void {
    if (delays != 0) bad=true
    delays=delays+1
    return
}
@export("abla_c5_i2c_released_test")
trusted fun releasedTest(): i32 {
    var profile=0
    while (profile < 16384) {
        defects=profile&1023; physical=profile/1024
        delays=0; reads=0; bad=false
        val result=esp32C5I2cBusReleasedOwned(0,2,3)
        if (result != (defects == 0 && physical == 0) || bad ||
            delays != (if (defects == 0 && (physical&3) == 0) 1 else 0)) return i32(1)
        profile=profile+1
    }
    reads=0; delays=0
    if (esp32C5I2cBusReleasedOwned(1,2,3) || esp32C5I2cBusReleasedOwned(0,2,2) ||
        reads != 0 || delays != 0) return i32(2)
    i32(0)
}
