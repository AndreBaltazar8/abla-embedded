import "../src/esp32/radio/rx_queue_esp32_logic.ab"

fun main(): int {
    if (esp32WifiRxQueueBytes != 8 ||
        esp32WifiRxQueueFirstOffset != 0 ||
        esp32WifiRxQueueStateOffset != 4) return 1
    if (!esp32WifiRxQueueStorageAddressValid(1073414144) ||
        esp32WifiRxQueueStorageAddressValid(0) ||
        esp32WifiRxQueueStorageAddressValid(1073414145) ||
        esp32WifiRxQueueStorageAddressValid(4294967292) ||
        !esp32WifiRxQueueStorageAddressValid(4294967288)) return 2
    if (!esp32WifiRxQueueDescriptorAddressValid(0) ||
        !esp32WifiRxQueueDescriptorAddressValid(4294967284) ||
        esp32WifiRxQueueDescriptorAddressValid(4294967288) ||
        esp32WifiRxQueueDescriptorAddressValid(4294967295)) return 3
    if (!esp32WifiRxQueueEndpointsValid(0, 0) ||
        !esp32WifiRxQueueEndpointsValid(1073414144, 1073414168) ||
        esp32WifiRxQueueEndpointsValid(0, 1073414168) ||
        esp32WifiRxQueueEndpointsValid(1073414144, 0)) return 4
    if (!esp32WifiRxQueuePendingKindValid(esp32WifiRxQueueIdle) ||
        !esp32WifiRxQueuePendingKindValid(esp32WifiRxQueueTaking) ||
        !esp32WifiRxQueuePendingKindValid(esp32WifiRxQueueRecycling) ||
        esp32WifiRxQueuePendingKindValid(3)) return 5
    val state = esp32WifiRxQueueState(
        1073414168, esp32WifiRxQueueRecycling
    )
    if (esp32WifiRxQueueStateLast(state) != 1073414168 ||
        esp32WifiRxQueueStatePendingKind(state) !=
            esp32WifiRxQueueRecycling ||
        esp32WifiRxQueueState(1073414169, esp32WifiRxQueueIdle) != -1) return 6
    74
}
