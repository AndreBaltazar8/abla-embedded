import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/ahb_gdma_channel_c5_sequence.ab"
var channel=0
var tx=false
var conf=u32(0)
var owner=u32(0)
var peripheral=u32(0)
var writes=0
var drop=0
var busy=false
var bad=false
trusted fun c5AhbGdmaBusRead(): u32 = u32(1)
trusted fun c5AhbGdmaBusWrite(value: u32): void { bad=true;return }
trusted fun c5AhbGdmaRead(at: int): u32 {
    if (at == 0x64) return u32(8)
    val base=0x70+channel*192+(if (tx) 96 else 0)
    if (at == base) return conf
    if (at == base+4) return owner
    if (at == base+48) return peripheral
    if (at == base+8) return if (busy) u32(0) else u32(2)
    if (at == base+16) return u32(if (tx) 8 else 16)
    return u32(0)
}
trusted fun c5AhbGdmaWrite(at: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    val base=0x70+channel*192+(if (tx) 96 else 0)
    if (at == base) conf=value else if (at == base+4) owner=value else if (at == base+48) peripheral=value else bad=true
    return
}
@export("abla_ahb_gdma_channel_c5_test")
trusted fun test(): i32 {
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 1
            var mode=0
            while (mode < 4) {
                var flags=0
                while (flags <= (if (tx) 7 else 1)) {
                    var fault=0
                    while (fault < 7) {
                        val original=u32(0xa50003de)&~u32(if (tx) 65 else 33)
                        conf=original;owner=u32(0x80000055);peripheral=u32(0x8000003f);writes=0;drop=fault
                        var lease=c5AhbGdmaChannelOpenOwned(channel,tx,3,if (mode == 0) 4 else 8*(1<<mode),flags,true)
                        if (lease.status() != 1 && lease.status() != 5) return i32(1)
                        if (lease.status() == 1) {
                            val mask=u32(if (tx) 798 else 214)
                            val expected=u32(if (tx) mode*256+(flags&1)*16+((flags>>>1)&1)*4+((flags>>>2)&1)*8 else mode*64+(flags&1)*4)
                            if (conf != ((original&~mask)|expected) || owner != u32(0x80001055) || peripheral != u32(0x80000003)) return i32(2)
                        }
                        lease=lease.closeOwned(true);drop=0;lease=lease.closeOwned(true)
                        if (lease.status() != 6 || conf != original || owner != u32(0x80000055) || peripheral != u32(0x8000003f) || bad) return i32(3)
                        fault=fault+1
                    }
                    flags=flags+1
                }
                mode=mode+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    channel=0;tx=true;writes=0;busy=true
    if (c5AhbGdmaChannelOpenOwned(0,true,3,4,0,true).status() != 4 || writes != 0) return i32(4)
    busy=false
    if (c5AhbGdmaChannelOpenOwned(3,true,3,4,0,true).status() != 2 || c5AhbGdmaChannelOpenOwned(0,false,3,4,2,true).status() != 2 || c5AhbGdmaChannelOpenOwned(0,true,4,4,0,true).status() != 2 || writes != 0) return i32(5)
    return i32(0)
}
