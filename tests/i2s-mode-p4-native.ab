import "../src/esp32/i2s/standard_mode_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val regs=nativeStaticAllocate(96)
var port=0
var writes=0
var reads=0
var fail=0
var bad=false
var bus=0x1c000
var tx=false
trusted fun p4I2sModeRead(address: int): int {
    reads=reads+1
    if (address == 0x500e601c) return bus
    val offset=address-(0x500c6000+port*4096)
    if (offset < 32 || offset > 84 || (offset & 3) != 0) { bad=true;return 0 }
    return nativeAddressLoadU32(regs,offset)
}
trusted fun p4I2sModeWrite(address: int,value: int): void {
    val offset=address-(0x500c6000+port*4096)
    val expected=if (writes == 0) (if (tx) 36 else 32) else
        if (writes == 1) (if (tx) 84 else 80) else (if (tx) 64 else 72)
    if (offset != expected || writes >= 3) bad=true
    writes=writes+1
    val corrupt=if (writes == 1) 0x80000 else if (writes == 2) 1 else (if (tx) 0x2000000 else 0x80000)
    nativeAddressStoreU32(regs,expected,if (writes == fail) value ^ corrupt else value)
    return
}
trusted fun reset(): void {
    var at=0
    while (at < 96) { nativeAddressStoreU32(regs,at,0xffffffff);at=at+4 }
    nativeAddressStoreU32(regs,32,0xfffffef8)
    nativeAddressStoreU32(regs,36,0xfffffef8)
    writes=0;reads=0;bad=false;bus=0x1c000
    return
}
@export("abla_i2s_mode_p4_test")
trusted fun test(): i32 {
    while (port < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 1
            var flags=0
            while (flags < 64) {
                var slots=1
                while (slots <= 3) {
                    reset()
                    if (esp32p4I2sSetStandardModeOwned(port,tx,slots,flags,true) != 1 || bad || writes != 3) return i32(1)
                    val config=nativeAddressLoadU32(regs,32+direction*4)
                    val mono=(flags & 1) != 0
                    val copy=mono && slots == 3
                    if (((config >>> 3) & 1) != ((flags >>> 1) & 1) ||
                        ((config >>> 6) & 1) != (if (if (tx) copy else mono) 1 else 0) ||
                        ((config >>> 7) & 1) != ((flags >>> 5) & 1) ||
                        ((config >>> 15) & 1) != ((flags >>> 4) & 1) ||
                        ((config >>> 17) & 3) != ((flags >>> 2) & 3) ||
                        ((config >>> 19) & 3) != 1) return i32(2)
                    if (tx && ((config >>> 5) & 1) != (if (copy) 1 else 0)) return i32(3)
                    if (!tx && ((config >>> 9) & 1) != (if (mono) 1 else 0)) return i32(4)
                    // Preserve widths' shift bit, BCLK, PCM/FIFO/stop/loopback and reserved bits.
                    val changed=8+64+128+32768+131072+262144+524288+1048576+(if (tx) 32 else 512)
                    if ((config & (0xffffffff ^ changed)) != (0xfffffef8 & (0xffffffff ^ changed))) return i32(5)
                    val slotWord=nativeAddressLoadU32(regs,80+direction*4)
                    val expected=65536+(if (tx && copy) 1 else slots)+(if (tx && !mono && slots != 3) 1048576 else 0)
                    val mask=if (tx) 2097151 else 1048575
                    if (slotWord != ((0xffffffff ^ mask) | expected)) return i32(6)
                    val converter=nativeAddressLoadU32(regs,if (tx) 64 else 72)
                    if (converter != (0xffffffff ^ (if (tx) 33554432 else 524288)) ||
                        nativeAddressLoadU32(regs,if (tx) 72 else 64) != 0xffffffff ||
                        nativeAddressLoadU32(regs,if (tx) 32 else 36) != 0xfffffef8) return i32(7)
                    slots=slots+1
                }
                flags=flags+1
            }
            fail=1
            while (fail <= 3) {
                reset()
                if (esp32p4I2sSetStandardModeOwned(port,tx,3,1,true) != fail+4 || writes != fail || bad) return i32(8)
                fail=fail+1
            }
            fail=0;reset();bus=0
            if (esp32p4I2sSetStandardModeOwned(port,tx,3,1,true) != 3 || reads != 1 || writes != 0) return i32(9)
            reset();nativeAddressStoreU32(regs,if (tx) 32 else 36,4)
            if (esp32p4I2sSetStandardModeOwned(port,tx,3,1,true) != 4 || writes != 0) return i32(10)
            direction=direction+1
        }
        port=port+1
    }
    reads=0;writes=0
    if (esp32p4I2sSetStandardModeOwned(0,false,3,1,false) != 2 ||
        esp32p4I2sSetStandardModeOwned(3,false,3,1,true) != 2 ||
        esp32p4I2sSetStandardModeOwned(0,false,0,1,true) != 2 ||
        esp32p4I2sSetStandardModeOwned(0,false,4,1,true) != 2 ||
        esp32p4I2sSetStandardModeOwned(0,false,3,64,true) != 2 || reads != 0 || writes != 0) return i32(11)
    return i32(0)
}
