import "../src/storage/fat_volume_audit.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(16384)
val fatMemory=nativeStaticAllocate(4096)
val directories=nativeStaticAllocate(1536)
var format=0
var scenario=0
var calls=0
var fail=0
var bad=false
var fatBase=1
var fatSectors=3
var rootBase=7
var dataBase=9
var audited=FatVolume(0)
var mirrorMismatch=false
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,input: NativeBuffer): bool { bad=true;return false }
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    calls=calls+1
    if (audited.begin(u32(8)) != 12) bad=true
    if (calls == fail) return false
    val secondary=format != 2 && lba >= fatBase+fatSectors && lba < fatBase+fatSectors*2
    val selected=if (secondary) lba-fatSectors else lba
    var source=NativeBuffer(0)
    if (selected >= fatBase && selected < fatBase+fatSectors) {
        if (selected-fatBase < 8) source=nativeBufferAt(fatMemory+(selected-fatBase)*512,512)
    } else if (selected == rootBase) source=nativeBufferAt(directories,512)
    else if (selected == (if (format == 0) rootBase+1 else dataBase+5)) source=nativeBufferAt(directories+512,512)
    else if (selected == dataBase+3) source=nativeBufferAt(directories+1024,512)
    else { bad=true;return false }
    var at=0
    while (at < 512) { output.store(at,if (source == NativeBuffer(0)) 0 else source.load(at));at=at+1 }
    if (secondary && mirrorMismatch) output.store(0,output.load(0)^1)
    if (secondary && format != 0) {
        var index=3;while (index < 512) { output.store(index,output.load(index)^0xf0);index=index+4 }
    }
    return true
}
trusted fun setFat(cluster: int,value: int): void {
    val fat=nativeBufferAt(fatMemory,4096)
    if (format == 0) {
        val at=cluster+cluster/2;val old=fat.loadU16(at)
        fat.storeU16(at,if ((cluster&1) == 0) (old&0xf000)|(value&4095) else (old&15)|((value&4095)<<4))
    } else fat.storeU32(cluster*4,0xa0000000|value)
    return
}
trusted fun initialize(boot: NativeBuffer,state: NativeBuffer,reader: NativeBuffer): int {
    var at=0;while (at < 512) { boot.store(at,0);at=at+1 }
    at=0;while (at < 4096) { nativeBufferAt(fatMemory,4096).store(at,0);at=at+1 }
    at=0;while (at < 1536) { nativeBufferAt(directories,1536).store(at,0);at=at+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.store(16,2);boot.storeU16(510,0xaa55)
    //1000 data clusters fit three FAT12 sectors, including reserved entries.
    var total=1009
    if (format == 0) {
        boot.storeU16(14,1);boot.storeU16(17,32);boot.storeU16(22,3);boot.storeU16(19,total)
        fatBase=1;fatSectors=3;rootBase=7;dataBase=9
    } else {
        total=70000;boot.storeU16(14,32);boot.storeU32(32,total);boot.storeU32(36,600);boot.storeU32(44,2)
        boot.storeU16(48,65535);boot.storeU16(50,65535);boot.storeU16(40,if (format == 2) 129 else 0)
        fatBase=if (format == 2) 632 else 32;fatSectors=600;rootBase=1232;dataBase=1232
        setFat(2,7);setFat(7,0x0fffffff)
    }
    val eoc=if (format == 0) 4095 else 0x0fffffff
    setFat(5,eoc);setFat(341,if (scenario == 2) 341 else 342);setFat(342,eoc);setFat(8,eoc)
    if (scenario == 3) setFat(9,eoc)
    val root=nativeBufferAt(directories,512);val child=nativeBufferAt(directories+1024,512)
    val dirName=nativeBufferAt(nativeStaticBytes("DIR        "),11);val fileName=nativeBufferAt(nativeStaticBytes("FILE    TXT"),11)
    at=0;while (at < 11) { root.store(at,dirName.load(at));root.store(32+at,fileName.load(at));child.store(64+at,fileName.load(at));at=at+1 }
    root.store(11,16);root.storeU16(26,5);root.store(43,32);root.storeU16(58,341);root.storeU32(60,if (scenario == 5) 0xffffffff else 600)
    at=2;while (at < 16) { root.store(at*32,229);at=at+1 }
    var dot=0
    while (dot < 2) {
        at=0;while (at < 11) { child.store(dot*32+at,32);at=at+1 }
        child.store(dot*32,46);if (dot == 1) child.store(33,46)
        child.store(dot*32+11,16);child.storeU16(dot*32+26,if (dot == 0) 5 else if (scenario == 4) 6 else if (format == 2) 2 else 0)
        dot=dot+1
    }
    child.store(75,32);child.storeU16(90,if (scenario == 1) 342 else 8);child.storeU32(92,100)
    fatVolumeInitializeFresh(state);state.storeU32(8,1);state.storeU32(12,1);state.storeU32(16,reader.addressValue());state.storeU32(20,boot.addressValue());state.storeU32(24,0);state.storeU32(28,total)
    audited=FatVolume(state.addressValue()|(1<<32));calls=0;bad=false
    return total
}
@export("abla_fat_volume_mirrors_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(memory,512);val reader=nativeBufferAt(memory+512,28);val state=nativeBufferAt(memory+544,32)
    val scratch=nativeBufferAt(memory+576,1024);val data=nativeBufferAt(memory+1600,512);val queue=nativeBufferAt(memory+2112,32)
    val bitmap=nativeBufferAt(memory+2144,10000)
    while (format < 3) {
        initialize(boot,state,reader)
        if (!audited.auditAllocation(u32(7),10000,queue,data,scratch,bitmap).consistent()) return i32(1)
        val allocationReads=calls
        initialize(boot,state,reader)
        val complete=audited.auditAllocation(u32(7),10000,queue,data,scratch,bitmap,true)
        if (complete.phase() != 3 || complete.status() != (if (format == 2) 6 else 1) || complete.mirrorsChecked() != (format != 2) || bad || state.loadU32(0) != 0) return i32(2)
        val required=calls
        initialize(boot,state,reader)
        if (audited.auditAllocation(u32(7),required,queue,data,scratch,bitmap,true).status() != complete.status() || calls != required || bad) return i32(3)
        if (format != 2) {
            initialize(boot,state,reader)
            val short=audited.auditAllocation(u32(7),required-1,queue,data,scratch,bitmap,true)
            if (short.phase() != 3 || short.status() != 5 || calls != required-2 || state.loadU32(0) != 0) return i32(4)
            initialize(boot,state,reader)
            val none=audited.auditAllocation(u32(7),allocationReads,queue,data,scratch,bitmap,true)
            if (none.phase() != 3 || none.status() != 5 || calls != allocationReads) return i32(5)
            initialize(boot,state,reader);mirrorMismatch=true
            val mismatch=audited.auditAllocation(u32(7),10000,queue,data,scratch,bitmap,true)
            if (mismatch.phase() != 3 || mismatch.status() != 4 || mismatch.mirrorOffset() != 0 || calls != allocationReads+2 || bad) return i32(6)
            mirrorMismatch=false
            var point=0
            while (point < 4) {
                initialize(boot,state,reader)
                fail=if (point < 2) allocationReads+point+1 else required-(point-2)
                val failed=audited.auditAllocation(u32(7),10000,queue,data,scratch,bitmap,true)
                if (failed.phase() != 3 || failed.status() != 3 || calls != fail || bad || state.loadU32(0) != 0) return i32(7)
                fail=0;point=point+1
            }
        } else if (required != allocationReads) return i32(8)
        format=format+1
    }
    return i32(0)
}
