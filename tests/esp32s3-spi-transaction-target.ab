import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/spi/software_transaction.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_spi_transaction_test")
trusted fun spiTransactionTargetTest(gateAddress: u32, owner: u32, value: u32, mode: i32): int {
    val result = softwareSpiTransactionWord(peripheralGateAt(int(gateAddress)), owner,
        pin(12), pin(11), pin(13), pin(10), value, 32, int(mode), 1, false, 1, 1)
    if (result.valid()) int(result.value()) else -result.status()
}
