import "../src/m5stack/touch_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
fun check(board: M5BoardId,kind: int,address: int,irq: int,sda: int,scl: int,port: int,width: int,height: int,rotation: int): bool {
    val p=board.touchProfile()
    p.valid() && p.kind() == kind && p.address() == address && p.interruptNumber() == irq &&
        p.sdaNumber() == sda && p.sclNumber() == scl && p.port() == port && p.rawWidth() == width &&
        p.rawHeight() == height && p.rotationOffset() == rotation && p.frequency() == 400000
}
@export("abla_touch_profile_test")
fun testProfiles(): i32 {
    if (!check(m5BoardStackCore2,1,56,39,21,22,1,320,280,0) ||
        !check(m5BoardTough,3,46,39,21,22,1,320,240,0) ||
        !check(m5BoardToughC5,3,46,-1,2,3,0,320,240,0) ||
        !check(m5BoardStopWatch,4,21,13,47,48,1,234,234,0) ||
        !check(m5BoardCoreP4X,5,88,1,11,9,1,480,480,2) ||
        !check(m5BoardStackCoreS3,1,56,21,12,11,1,320,240,0) ||
        !check(m5BoardStackCoreS3SE,1,56,21,12,11,1,320,240,0) ||
        !check(m5BoardPaper,2,20,36,21,22,1,540,960,1) ||
        !check(m5BoardPaperS3,2,20,48,41,42,1,540,960,1) ||
        !check(m5BoardPaperMono,1,56,4,47,48,1,480,800,0) ||
        !check(m5BoardDial,1,56,14,11,12,1,240,240,0) ||
        !check(m5BoardArduinoNessoN1,1,56,3,10,8,0,135,240,0)) return i32(1)
    if (m5BoardUnknown.touchProfile().valid() || m5BoardAtomVoice.touchProfile().valid()) return i32(2)
    if (m5TouchProfile(7,56,1,2,3,0,320,240).valid() ||
        m5TouchProfile(1,56,1,2,2,0,320,240).valid() ||
        m5TouchProfile(1,56,63,2,3,0,320,240).valid() ||
        m5TouchProfile(1,56,1,2,3,0,4096,240).valid()) return i32(3)
    i32(0)
}
