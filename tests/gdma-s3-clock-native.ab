import "../src/esp32/gdma_clock_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var clock = 0
var reset = 0
var writes = 0
var bad = false
trusted fun esp32s3GdmaRead(address: int): int {
    if (address == 0x600c001c) return clock
    if (address == 0x600c0024) return reset
    bad = true
    0
}
trusted fun esp32s3GdmaWrite(address: int, value: int): void {
    writes = writes + 1
    if (address == 0x600c001c) {
        if (value != (clock | 64)) bad = true
        clock = value
    } else if (address == 0x600c0024) {
        if ((clock & 64) == 0 || value != (reset & 0xffffffbf)) bad = true
        reset = value
    } else bad = true
    return
}
trusted fun gdmaClockTest(): int {
    var bits = 0
    while (bits < 4) {
        clock = 0xa5a50000 | (if ((bits & 1) != 0) 64 else 0)
        reset = 0x5a5a0000 | (if ((bits & 2) != 0) 64 else 0)
        writes = 0
        esp32s3GdmaEnableClockLocked()
        val expected = (if ((bits & 1) == 0) 1 else 0) + (if ((bits & 2) != 0) 1 else 0)
        if (bad || writes != expected || clock != 0xa5a50040 || reset != 0x5a5a0000) return 1
        esp32s3GdmaEnableClockLocked()
        if (bad || writes != expected) return 2
        bits = bits + 1
    }
    0
}
#exportFunction("gdmaClockTest", "abla_gdma_clock_test")
