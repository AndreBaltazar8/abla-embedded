import "../src/power/powerhub_bus.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice = int
var calls=0
var bad=false
var fail=false
var voltage=3000
var limit=0
var flags=0
trusted fun I2cDevice.writeRegister(register: int,bytes: NativeBuffer,count: int): bool {
    calls=calls+1
    if (this != 7 || register != 32 || count != 5 || bytes.load(0) != voltage%256 ||
        bytes.load(1) != voltage/256 || bytes.load(2) != limit ||
        bytes.load(3) != (flags&1) || bytes.load(4) != ((flags>>>1)&1)) bad=true
    !fail
}
@export("abla_powerhub_bus_test")
trusted fun busTest(): i32 {
    val bytes=nativeBufferAt(nativeStaticAllocate(5),5)
    val power=PowerHubPower(7)
    while (voltage <= 20000) {
        flags=0
        while (flags < 4) {
            limit=(voltage/20)%233
            val config=powerHubBusConfig(voltage,limit,(flags&1) != 0,(flags&2) != 0)
            var attempt=0
            while (attempt < 2) {
                fail=attempt != 0; calls=0; bad=false
                if (!config.valid() || power.setExternalBusConfigWithBuffer(config,bytes) == fail || calls != 1 || bad) return i32(1)
                attempt=attempt+1
            }
            flags=flags+1
        }
        voltage=voltage+20
    }
    voltage=5000; flags=3; fail=false; limit=-1
    while (limit <= 256) {
        val config=powerHubBusConfig(voltage,limit,true,true)
        calls=0
        val expected=limit >= 0 && limit <= 232
        if (config.valid() != expected || power.setExternalBusConfigWithBuffer(config,bytes) != expected || calls != (if (expected) 1 else 0) || bad) return i32(2)
        limit=limit+1
    }
    var mv=0
    while (mv <= 65535) {
        val expected=mv >= 3000 && mv <= 20000 && mv%20 == 0
        if (powerHubBusConfig(mv,0,false,false).valid() != expected ||
            PowerHubBusConfig((1<<26)|mv).valid() != expected) return i32(3)
        mv=mv+1
    }
    val good=powerHubBusConfig(5000,100,false,false)
    var bit=27
    while (bit < 64) {
        if (PowerHubBusConfig(good | (1<<bit)).valid()) return i32(4)
        bit=bit+1
    }
    calls=0; bytes.storeU32(0,0xdeadbeef); bytes.store(4,99)
    if (power.setExternalBusConfigWithBuffer(good,nativeBufferAt(bytes.addressValue(),4)) ||
        power.setExternalBusConfigWithBuffer(good,nativeBufferAt(0,5)) ||
        power.setExternalBusConfigWithBuffer(PowerHubBusConfig(0),bytes) ||
        PowerHubPower(0).setExternalBusConfigWithBuffer(good,bytes) ||
        PowerHubPower(-1).setExternalBusConfigWithBuffer(good,bytes) ||
        PowerHubPower(4294967296).setExternalBusConfigWithBuffer(good,bytes) ||
        powerHubBusConfig(-1,0,false,false).valid() || calls != 0 ||
        bytes.loadU32(0) != 0xdeadbeef || bytes.load(4) != 99) return i32(5)
    i32(0)
}
