import "../src/m5stack/papermono_spi_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
val storage=nativeStaticAllocate(4)
var calls=0
var fail=0
var result=1
var bad=false
trusted fun Pin.outputLevelOwned(high: bool): bool {
    calls=calls+1
    if (nativeAddressLoadU32(storage,0) != 37 || !high || this != (if (calls == 1) 16 else 17)) bad=true
    return calls != fail
}
trusted fun esp32s3SpiInitializeTransmitOwned(peripheral: int,pins: SpiPins,select: Pin,source: int,pre: int,cycles: int,mode: int,owner: u32,polls: int): int {
    if (calls != 2 || peripheral != 2 || pins != spiPins(14,-1,15) || select != 16 ||
        source != 1 || pre != 1 || cycles != 2 || mode != 0 || owner != u32(37) || polls != 100000 ||
        nativeAddressLoadU32(storage,0) != 37) bad=true
    calls=3;return result
}
@export("abla_papermono_spi_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(storage)
    while (fail < 3) {
        result=1
        while (result < 9) {
            calls=0;bad=false;nativeAddressStoreU32(storage,0,0)
            val initialized=paperMonoSpiInitializeOwned(gate,u32(37),true)
            val detail=if (fail == 1) 9 else if (fail == 2) 10 else result
            if (initialized.status() != (if (detail == 1) 1 else 6) || initialized.value() != u32(detail) ||
                calls != (if (fail == 0) 3 else fail) || bad ||
                nativeAddressLoadU32(storage,0) != (if (detail == 1) 0 else 2147483648)) return i32(1)
            result=result+1
        }
        fail=fail+1
    }
    calls=0
    if (paperMonoSpiInitializeOwned(gate,u32(37),false).status() != 3 ||
        paperMonoSpiInitializeOwned(gate,u32(0),true).status() != 3 ||
        paperMonoSpiInitializeOwned(gate,u32(37),true).status() != 4 || calls != 0) return i32(2)
    nativeAddressStoreU32(storage,0,38)
    if (paperMonoSpiInitializeOwned(gate,u32(37),true).status() != 2 || calls != 0) return i32(3)
    return i32(0)
}
