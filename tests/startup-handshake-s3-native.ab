import "../src/esp32/startup_handshake_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var state=0
var calls=0
fun esp32S3StartupCore(): int = core
fun esp32S3StartupCas(address: int,expected: int,value: int): int {
    calls=calls+1
    val old=state
    if (old == expected) state=value
    old
}
@export("abla_startup_handshake_test")
trusted fun startupTest(): i32 {
    var p=0
    while (p < 28) {
        val initial=p/4
        core=p & 1
        val success=(p & 2) != 0
        state=initial
        if (esp32S3StartupStatusOwned(4096) != (if (initial <= 5) initial else -1)) return i32(1)
        if (esp32S3StartupRequestOwned(4096) != (core == 0 && initial == 0) || state != (if (core == 0 && initial == 0) 1 else initial)) return i32(2)
        state=initial
        if (esp32S3StartupInitializedOwned(4096,success) != (core == 1 && initial == 1) || state != (if (core == 1 && initial == 1) (if (success) 2 else 5) else initial)) return i32(3)
        state=initial
        if (esp32S3StartupReleaseOwned(4096) != (core == 0 && initial == 2) || state != (if (core == 0 && initial == 2) 3 else initial)) return i32(4)
        state=initial
        if (esp32S3StartupRunningOwned(4096) != (core == 1 && initial == 3) || state != (if (core == 1 && initial == 3) 4 else initial)) return i32(5)
        p=p+1
    }
    state=0; core=0
    if (!esp32S3StartupRequestOwned(4096) || esp32S3StartupRequestOwned(4096)) return i32(6)
    p=0
    while (p < 128) { if (esp32S3StartupStatusOwned(4096) != 1 || esp32S3StartupReleaseOwned(4096)) return i32(7); p=p+1 }
    core=1
    if (!esp32S3StartupInitializedOwned(4096,true) || esp32S3StartupRunningOwned(4096)) return i32(8)
    core=0
    if (!esp32S3StartupReleaseOwned(4096)) return i32(9)
    core=1
    if (!esp32S3StartupRunningOwned(4096) || esp32S3StartupRunningOwned(4096)) return i32(10)
    calls=0
    if (esp32S3StartupStatusOwned(0) != -1 || esp32S3StartupInitializedOwned(4097,true) || esp32S3StartupRunningOwned(0x100000000) || calls != 0) return i32(11)
    i32(0)
}
