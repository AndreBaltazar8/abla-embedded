import "../src/esp32/i2c/guarded_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_i2c_guarded_target")
trusted fun guardedTarget(gate: PeripheralGate,owner: u32,address: int,output: NativeBuffer,written: int,
    input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32C5I2cTransferGuarded(gate,owner,0,address,output,written,input,read,budget,prefix)
