import "../src/m5stack/chaincaptain_display_sleep_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val gateStorage=nativeStaticAllocate(4)
var blankCalls=0
var panelCalls=0
var brightCalls=0
var failed=0
var cleanupFailed=false
var dark=false
var bad=false
var sleepRequest=false
var level=0
fun chainDisplayAdmission(control: int,gate: PeripheralGate): bool =
    control == 7 && gate.word().address() == gateStorage && nativeAddressLoadU32(gateStorage,0) == 0
fun chainDisplayBlank(control: int): bool {
    if (control != 7) bad=true
    blankCalls=blankCalls+1
    val okay=if (blankCalls == 1) failed != 3 else !cleanupFailed
    if (okay) dark=true
    return okay
}
fun chainDisplayBrightness(control: int,brightness: int): bool {
    if (control != 7 || brightness != level || !dark || panelCalls != 1 || sleepRequest || failed == 4) bad=true
    brightCalls=brightCalls+1
    // Failed write can have partially enabled the light; cleanup must run.
    dark=false
    return failed != 5
}
fun chainDisplaySleepPanel(gate: PeripheralGate,owner: u32,sleeping: bool): SpiTransactionResult {
    if (!dark || blankCalls != 1 || owner != u32(37) || gate.word().address() != gateStorage || sleeping != sleepRequest) bad=true
    panelCalls=panelCalls+1
    return SpiTransactionResult(if (failed == 4) (6<<32)|0x20109 else (1<<32)|257)
}
trusted fun seed(): void {
    blankCalls=0;panelCalls=0;brightCalls=0;dark=false;bad=false
    nativeAddressStoreU32(gateStorage,0,0);return
}
@export("abla_chaincaptain_display_sleep_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateStorage)
    var variant=0
    while (variant < 8) {
        sleepRequest=(variant&1) != 0;cleanupFailed=(variant&2) != 0;level=if ((variant&4) == 0) 0 else 255
        failed=0
        while (failed <= 5) {
            if (failed == 0 || failed >= 3) {
                seed()
                val result=chainCaptainDisplaySleepOwned(7,gate,u32(37),sleepRequest,level,true)
                val brightnessFailure=failed == 5 && !sleepRequest
                val offFailure=failed == 3 || brightnessFailure
                val expected=if (failed == 0 || (failed == 5 && sleepRequest)) 1 else failed
                if (result.status() != expected || result.detail() != (if (failed == 4) (6<<32)|0x20109 else 0) ||
                    result.backlightOffFailed() != (offFailure && cleanupFailed) || bad ||
                    blankCalls != (if (offFailure) 2 else 1) || panelCalls != (if (failed == 3) 0 else 1) ||
                    brightCalls != (if (failed == 3 || failed == 4 || sleepRequest) 0 else 1)) return i32(1)
                if (((sleepRequest && failed != 3) || failed == 4 || (offFailure && !cleanupFailed)) && !dark) return i32(2)
            }
            failed=failed+1
        }
        variant=variant+1
    }
    seed()
    if (chainCaptainDisplaySleepOwned(7,gate,u32(37),false,0,false).status() != 2 ||
        chainCaptainDisplaySleepOwned(0,gate,u32(37),false,0,true).status() != 2 ||
        chainCaptainDisplaySleepOwned(7,gate,u32(0),false,0,true).status() != 2 ||
        chainCaptainDisplaySleepOwned(7,gate,u32(37),false,-1,true).status() != 2 ||
        chainCaptainDisplaySleepOwned(7,gate,u32(37),false,256,true).status() != 2) return i32(3)
    nativeAddressStoreU32(gateStorage,0,2147483648)
    if (chainCaptainDisplaySleepOwned(7,gate,u32(37),false,0,true).status() != 2 || blankCalls != 0 || panelCalls != 0 || brightCalls != 0) return i32(4)
    return i32(0)
}
