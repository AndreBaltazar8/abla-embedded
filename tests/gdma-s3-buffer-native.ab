import "../src/esp32/gdma_buffer_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var flags = 0
var buffer = 0x3fc90000
var next = 0
var trace = 0
var written = 0
var bad = false
fun esp32s3GdmaDescriptorValid(address: int): bool = address >= 0x3fc88000 && address <= 0x3fcffff4 && (address & 3) == 0
trusted fun esp32s3GdmaRead(address: int): int {
    if (address == 0x3fc88000) return flags
    if (address == 0x3fc88004) return buffer
    if (address == 0x3fc88008) return next
    bad = true
    0
}
trusted fun esp32s3GdmaPublish(): void { trace = trace * 10 + 1; return }
trusted fun esp32s3GdmaWrite(address: int, value: int): void {
    if (address != 0x3fc88000 || trace != 1) bad = true
    trace = trace * 10 + 2
    written = value
    return
}
trusted fun gdmaBufferTest(): int {
    var capacity = 1
    while (capacity <= 4095) {
        flags = capacity | (capacity << 12)
        trace = 0
        if (esp32s3GdmaCompletedBytes(0x3fc88000) != capacity || trace != 1) return 1
        trace = 0
        if (!esp32s3GdmaRearm(0x3fc88000, true, capacity, true) || trace != 12 || written != (0xc0000000 | flags) || bad) return 2
        trace = 0
        if (!esp32s3GdmaRearm(0x3fc88000, false, 0, false) || trace != 12 || written != (0x80000000 | capacity) || bad) return 3
        flags = flags | 0x80000000
        trace = 0
        if (esp32s3GdmaCompletedBytes(0x3fc88000) != -2 || esp32s3GdmaRearm(0x3fc88000, true, capacity, false) || trace != 0) return 4
        capacity = capacity + 1
    }
    flags = 0x20001
    trace = 0
    if (esp32s3GdmaCompletedBytes(0x3fc88000) != -3) return 5
    flags = 16
    var variant = 0
    while (variant < 4) {
        buffer = if (variant == 0) 0x3fc90001 else if (variant == 1) 0x3fcffff4 else 0x3fc90000
        next = if (variant == 2) 0x3fc88001 else if (variant == 3) 0x3fcffff8 else 0
        trace = 0
        if (esp32s3GdmaRearm(0x3fc88000, true, 16, false) || trace != 0) return 6
        variant = variant + 1
    }
    trace = 0
    if (esp32s3GdmaCompletedBytes(0) != -1 || esp32s3GdmaRearm(0x3fc88000, false, 1, false) || esp32s3GdmaRearm(0x3fc88000, false, 0, true) || esp32s3GdmaRearm(0x3fc88000, true, 0, false) || trace != 0) return 7
    0
}
#exportFunction("gdmaBufferTest", "abla_gdma_buffer_test")
