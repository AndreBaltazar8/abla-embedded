import "../src/esp32/cache_suspend_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var predictor=0
var autoload=0
var stage=0
var bad=false
trusted fun c5CachePredictorDisable(): int {
    if (stage != 0) bad=true
    stage=1
    val saved=predictor
    predictor=predictor & ~0x1030
    saved
}
trusted fun c5CacheRomSuspend(): int {
    if (stage != 1 || (predictor & 0x1030) != 0) bad=true
    stage=2
    autoload
}
trusted fun c5CacheRomResume(saved: int): void {
    if (stage != 2 || saved != autoload || (predictor & 0x1030) != 0) bad=true
    stage=3
    return
}
trusted fun c5CachePredictorRestore(saved: int): void {
    if (stage != 3 || (saved & ~0x1030) != 0) bad=true
    predictor=predictor | saved
    stage=4
    return
}
@export("abla_cache_suspend_c5_test")
trusted fun test(): int {
    var mode=0
    while (mode < 8) {
        var bit=0
        while (bit < 34) {
            autoload=if (bit == 32) 0 else if (bit == 33) 0xFFFFFFFF else 1<<bit
            val original=0x40000002 | ((mode&3)<<4) | ((mode&4)<<10)
            predictor=original;stage=0;bad=false
            val saved=esp32C5CacheSuspendOwned()
            if (stage != 2 || predictor != (original & ~0x1030)) return 1
            // Unrelated CSR changes made during the owned interval survive.
            predictor=predictor | 0x80
            esp32C5CacheResumeOwned(saved)
            if (bad || stage != 4 || predictor != (original | 0x80)) return 2
            bit=bit+1
        }
        mode=mode+1
    }
    0
}
