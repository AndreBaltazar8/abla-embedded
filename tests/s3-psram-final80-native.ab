import "../src/esp32/psram/final80_s3_sequence.ab"
import "abla/build"
val f80Registers=nativeStaticAllocate(8192)
var f80Writes=0
var f80Fail=0
var f80Busy=0
var f80Bad=false
var f80Dummy0=0
var f80Dummy1=0
fun s3FlashLegacyPointer(): int = 0x3fc90000
fun s3FlashDummyByteRead(address: int): int {
    if (address == 0x3fc90018) return f80Dummy0
    if (address != 0x3fc90019) f80Bad=true
    return f80Dummy1
}
fun s3FlashDummyByteWrite(address: int,value: int): void {
    f80Writes=f80Writes+1
    val stored=if (f80Writes == f80Fail) value^1 else value
    if (address == 0x3fc90018) f80Dummy0=stored else if (address == 0x3fc90019) f80Dummy1=stored else f80Bad=true
    return
}
fun s3PsramCsRead(address: int): int {
    if (address == 0x60002000) return if (f80Busy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (f80Busy == 2) 0x80000000 else 0
    if (address < 0x60002000 || address >= 0x60004000) { f80Bad=true;return 0 }
    return nativeAddressLoadU32(f80Registers,address-0x60002000)
}
fun s3PsramCsWrite(address: int,value: int): void {
    if (address < 0x60002000 || address >= 0x60004000) { f80Bad=true;return }
    f80Writes=f80Writes+1
    nativeAddressStoreU32(f80Registers,address-0x60002000,if (f80Writes == f80Fail) value^1 else value);return
}
@export("abla_s3_psram_final80_test")
fun testFinal80(): int {
    var profile=0
    while (profile < 96) {
        val protocol=profile%3;val frequency=if ((profile/3)%3 == 0) 20 else if ((profile/3)%3 == 1) 40 else 80
        val ft=profile&255;val pt=(profile*7)&255
        val dummyCount=if (protocol == 0) 8 else 4;val restoreCount=if (protocol == 0) 1 else 4
        val count=10+dummyCount+restoreCount+16
        f80Fail=0
        while (f80Fail <= count) {
            var offset=0
            while (offset < 8192) { nativeAddressStoreU32(f80Registers,offset,0xa55a5abf);offset=offset+4 }
            f80Dummy0=2;f80Dummy1=3;f80Writes=0;f80Busy=0;f80Bad=false
            val stage=if (f80Fail <= 4) 1 else if (f80Fail <= 10) 2 else if (f80Fail <= 10+dummyCount) 3 else if (f80Fail <= 10+dummyCount+restoreCount) 4 else 5
            if (s3PsramFinal80Owned(frequency,protocol,ft,pt,5,2,3,true,true) != (if (f80Fail == 0) 1 else (stage<<8)|4) ||
                f80Writes != (if (f80Fail == 0) count else f80Fail) || f80Bad) return 1
            val savedFail=f80Fail
            f80Fail=0;f80Writes=0
            if (s3PsramFinal80Owned(frequency,protocol,ft,pt,5,2,3,true,true) != 1 || f80Bad || f80Writes != count) return 2
            if ((s3PsramCsRead(0x600030ec)&3) != 2 || s3PsramCsRead(0x60003050) != 0x10001 ||
                s3PsramCsRead(0x60003014) != s3PsramCsRead(0x60002014) || ((s3PsramCsRead(0x60003014)>>>16)&255)+1 != 160/frequency) return 3
            if ((s3PsramCsRead(0x600030ac)&7) != (ft&7) || (s3PsramCsRead(0x600030c0)&7) != (pt&7) ||
                ((s3PsramCsRead(0x600030bc)>>>2)&7) != (pt>>>5)) return 4
            if (protocol == 0) {
                if ((s3PsramCsRead(0x600030a8)&30) != 0 || (s3PsramCsRead(0x600020a8)&30) != 0) return 11
                if (f80Dummy0 != 2+(ft>>>5) || f80Dummy1 != 3+(ft>>>5) || (s3PsramCsRead(0x6000203c)&2) != 0) return 5
            } else if ((s3PsramCsRead(0x600020e0)&14) != (if (protocol == 2) 12 else 0) ||
                (s3PsramCsRead(0x6000203c)&2) != 2 || ((s3PsramCsRead(0x600030a8)>>>2)&7) != (ft>>>5)) return 6
            if ((s3PsramCsRead(0x60003048)&65535) != 0 || (s3PsramCsRead(0x6000304c)&65535) != 0x8080 ||
                (s3PsramCsRead(0x600030e4)&15) != 3) return 7
            f80Fail=savedFail+1
        }
        profile=profile+1
    }
    f80Writes=0
    if (s3PsramFinal80Owned(120,0,0,0,5,2,3,true,true) != 2 || s3PsramFinal80Owned(80,0,255,0,63,2,3,true,true) != 2 ||
        s3PsramFinal80Owned(80,0,0,0,5,2,3,false,true) != 2 || f80Writes != 0) return 8
    f80Busy=1
    if (s3PsramFinal80Owned(80,0,0,0,5,2,3,true,true) != 259 || f80Writes != 0) return 9
    f80Busy=2
    if (s3PsramFinal80Owned(80,0,0,0,5,2,3,true,true) != 259 || f80Writes != 0) return 10
    return 0
}
