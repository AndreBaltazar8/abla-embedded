import "../src/m5stack/atom_s3_probe_session_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.outputCapable(): bool = this >= 1 && this <= 48
val memory=nativeStaticAllocate(256)
val saved=nativeStaticAllocate(16)
val gateMemory=nativeStaticMutableU32s([0])
val gpio=nativeBufferAt(nativeStaticAllocate(24576),24576)
val session=nativeBufferAt(nativeStaticAllocate(108),108)
var modeDrop=0
var resetCalls=0
var resetFail=0
var resetHigh=false
var delayTotal=0
fun peripheralDelayMilliseconds(ms: int): void {
    if (!gateHeld() || selected || (ms == 2 && resetHigh) || (ms != 2 && !resetHigh)) bad=true
    delayTotal=delayTotal+ms;return
}
var base=0x60024000
var board=11
var scenario=0
var starts=0
var updates=0
var bad=false
var selected=false
var commandData=true
var gpioCalls=0
var failPin=0
trusted fun gateHeld(): bool {
    val word=nativeAddressLoadU32(gateMemory,0)
    return word == 7 || word == 0x80000007
}
fun esp32S3PinStateRead(address: int): int { if (!gateHeld()) bad=true;return gpio.loadU32(address-0x60004000) }
fun esp32S3PinStateWrite(address: int,value: int): void {
    if (!gateHeld()) bad=true
    val at=address-0x60004000
    var bank=0
    while (bank <= 4) {
        // S3 high-bank latch+enable registers are12 bytes above low bank.
        val offset=if (bank == 0) 0 else 12
        if (at == 0x28+offset) { gpio.storeU32(0x20+offset,gpio.loadU32(0x20+offset)&~value);return }
        if (at == 0x24+offset) { gpio.storeU32(0x20+offset,gpio.loadU32(0x20+offset)|value);return }
        if (at == 8+offset) { gpio.storeU32(4+offset,gpio.loadU32(4+offset)|value);return }
        if (at == 12+offset) { gpio.storeU32(4+offset,gpio.loadU32(4+offset)&~value);return }
        bank=bank+4
    }
    gpio.storeU32(at,value);return
}
fun Pin.routeOutputSignal(signal: int,inverted: bool): bool {
    if (!gateHeld()) bad=true
    gpio.storeU32(0x554+this*4,signal);return true
}
fun Pin.routeBidirectionalSignal(input: int,output: int): bool {
    if (!gateHeld()) bad=true
    gpio.storeU32(0x554+this*4,output);gpio.storeU32(0x154+input*4,128|(this|0));return true
}
fun Pin.outputLevelOwned(high: bool): bool {
    val bank=esp32S3GpioBankOffset(this|0);val bit=1<<(this&31)
    gpio.storeU32(4+bank,if (high) gpio.loadU32(4+bank)|bit else gpio.loadU32(4+bank)&~bit)
    gpio.storeU32(32+bank,gpio.loadU32(32+bank)|bit)
    gpio.storeU32(0x554+this*4,1280)
    gpio.storeU32(esp32S3GpioMuxAddress(this|0)-0x60004000,0x1000)
    return this.writeLevelOwned(high)
}
trusted fun Pin.writeLevelOwned(high: bool): bool {
    if (!gateHeld() || (nativeBufferAt(memory,256).loadU32(0)&0x01800000) != 0) bad=true
    gpioCalls=gpioCalls+1
    if (this == Pin(if (board == 11) 34 else 48)) {
        resetCalls=resetCalls+1
        if (resetCalls == resetFail) return false
        resetHigh=high
        val bank=esp32S3GpioBankOffset(this|0);val bit=1<<(this&31)
        gpio.storeU32(4+bank,if (high) gpio.loadU32(4+bank)|bit else gpio.loadU32(4+bank)&~bit)
        return true
    }
    if (this == Pin(failPin)) return false
    if (this == Pin(if (board == 11) 15 else 14)) selected=!high
    else if (this == Pin(if (board == 11) 33 else 42)) commandData=high
    else bad=true
    return true
}
trusted fun esp32s3SpiRead(address: int): int {
    if (!gateHeld()) bad=true
    return nativeBufferAt(memory,256).loadU32(address-base)
}
trusted fun esp32s3SpiWrite(address: int,value: int): void {
    if (!gateHeld()) bad=true
    val r=nativeBufferAt(memory,256);val at=address-base
    if (starts == 0 && ((modeDrop == 1 && at == 0x20) || (modeDrop == 2 && at == 0x10) || (modeDrop == 3 && at == 8))) return
    // Failed temporary-divider write and failed original-divider restoration.
    if (at == 0x0c && ((scenario == 4 && starts == 0 && value != 0x31412345) ||
        (scenario == 5 && starts > 0 && value == 0x31412345))) return
    if (at == 0x38) { r.storeU32(0x3c,r.loadU32(0x3c)&~value);return }
    if (at == 0 && value == 0x00800000) {
        updates=updates+1;r.storeU32(0,0);return
    }
    if (at == 0 && value == 0x01000000) {
        if ((r.loadU32(0x20)&0x20000000) != 0 || (r.loadU32(0x10)&512) != 0 || (r.loadU32(8)&0x07800000) != 0) bad=true
        starts=starts+1
        val phase=(starts-1)%3
        if ((phase == 0 && (selected || commandData)) || (phase == 1 && (!selected || commandData)) ||
            (phase == 2 && (!selected || !commandData))) bad=true
        val divider=if (starts <= 3) (9<<12)|(4<<6)|9 else (15<<18)|(49<<12)|(24<<6)|49
        if (r.loadU32(0x0c) != (0x31400000|divider) || r.loadU32(0xe8) != 0xa5000007) bad=true
        r.storeU32(0,if (scenario == 3) value else 0)
        r.storeU32(0x3c,4096)
        if (phase == 2) r.storeU32(0x98,if (scenario == 0 || scenario == 5 || (scenario == 1 && starts > 3)) 0x079100 else 0x11223344)
        return
    }
    r.storeU32(at,value);return
}
trusted fun seed(): void {
    val r=nativeBufferAt(memory,256)
    var i=0;while (i < 256) { r.store(i,0);i=i+1 }
    i=0;while (i < 24576) { gpio.storeU32(i,0);i=i+4 }
    i=0;while (i < 108) { session.storeU32(i,0);i=i+4 }
    modeDrop=0
    resetCalls=0;resetFail=0;resetHigh=false;delayTotal=0
    r.storeU32(0x0c,0x31412345);r.storeU32(0xe8,0xa5000003)
    nativeAddressStoreU32(gateMemory,0,0)
    starts=0;updates=0;bad=false;selected=false;commandData=true;gpioCalls=0;failPin=0;return
}
@export("abla_atom_s3_panel_probe_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(memory,256);val snapshot=nativeBufferAt(saved,16)
    val gate=peripheralGateAt(gateMemory)
    var port=2
    while (port <= 3) {
        base=0x60024000+(port-2)*4096;board=11
        while (board <= 18) {
            scenario=0
            while (scenario <= 5) {
                seed()
                val result=M5BoardId(board).readAtomPanelIdNativeChecked(gate,u32(7),port,snapshot,3)
                if (bad) return i32(1)
                if (scenario == 3) {
                    if (result.status() != 6 || starts != 1 || updates != 1 || nativeAddressLoadU32(gateMemory,0) != 0x80000000 ||
                        r.loadU32(0x0c) == 0x31412345) return i32(2)
                    val before=updates
                    if (M5BoardId(board).readAtomPanelIdNativeChecked(gate,u32(7),port,snapshot,3).status() != 4 || updates != before) return i32(3)
                    val gpioBefore=gpioCalls
                    if (M5BoardId(board).recoverAtomPanelProbeNativeOwned(gate,u32(7),port,snapshot,3,true) != 4 ||
                        gpioCalls != gpioBefore || updates != before || nativeAddressLoadU32(gateMemory,0) != 0x80000000) return i32(9)
                    // Model hardware completing its stalled transfer; recovery
                    // itself must not force CMD clear or replay any transaction.
                    r.storeU32(0,0)
                    failPin=if (board == 11) 15 else 14
                    if (M5BoardId(board).recoverAtomPanelProbeNativeOwned(gate,u32(7),port,snapshot,3,true) != 5 ||
                        gpioCalls != gpioBefore+1 || updates != before) return i32(10)
                    failPin=if (board == 11) 33 else 42
                    if (M5BoardId(board).recoverAtomPanelProbeNativeOwned(gate,u32(7),port,snapshot,3,true) != 6 ||
                        updates != before) return i32(11)
                    failPin=0
                    if (M5BoardId(board).recoverAtomPanelProbeNativeOwned(gate,u32(7),port,snapshot,3,true) != 1 ||
                        starts != 1 || selected || !commandData || bad || nativeAddressLoadU32(gateMemory,0) != 0 ||
                        r.loadU32(0x0c) != 0x31412345 || r.loadU32(0xe8) != 0xa5000003) return i32(12)
                } else if (scenario >= 4) {
                    val detail=result&0xffffffff
                    if (result.status() != 6 || nativeAddressLoadU32(gateMemory,0) != 0x80000000 || selected || !commandData) return i32(6)
                    if (scenario == 4 && (starts != 0 || updates != 1 || detail != (6<<24) ||
                        r.loadU32(0x0c) != 0x31412345 || r.loadU32(0xe8) != 0xa5000003)) return i32(7)
                    if (scenario == 5 && (starts != 3 || updates != 3 || detail != ((7<<24)|5) ||
                        r.loadU32(0xe8) != 0xa5000000 || snapshot.loadU32(8) != 0x31412345)) return i32(8)
                    if (scenario == 5) {
                        if (M5BoardId(board).recoverAtomPanelProbeNativeOwned(gate,u32(7),port,snapshot,3,true) != (7|(5<<8)) ||
                            nativeAddressLoadU32(gateMemory,0) != 0x80000000) return i32(13)
                        scenario=0
                        val recovered=M5BoardId(board).recoverAtomPanelProbeNativeOwned(gate,u32(7),port,snapshot,3,true)
                        scenario=5
                        if (recovered != 1 || starts != 3 || bad || nativeAddressLoadU32(gateMemory,0) != 0 ||
                            r.loadU32(0x0c) != 0x31412345 || r.loadU32(0xe8) != 0xa5000003) return i32(14)
                    }
                } else {
                    val retried=board == 18 && scenario != 0
                    if (!result.valid() || starts != (if (retried) 6 else 3) || updates != starts+1 ||
                        selected || !commandData || nativeAddressLoadU32(gateMemory,0) != 0 ||
                        r.loadU32(0x0c) != 0x31412345 || r.loadU32(0xe8) != 0xa5000003) return i32(4)
                    val expected=if (scenario == 0 || (scenario == 1 && retried)) 0x079100 else 0x11223344
                    if (result.value() != u32(expected)) return i32(5)
                }
                scenario=scenario+1
            }
            scenario=0
            while (scenario <= 3) {
                seed()
                val result=atomS3ProbeSessionRunOwned(session,M5BoardId(board),port,gate,u32(7),3,true)
                if (bad) return i32(15)
                if (scenario == 3) {
                    if (result.status() != 6 || session.loadU32(4) != 3 || nativeAddressLoadU32(gateMemory,0) != 0x80000000) return i32(16)
                    val before=gpioCalls
                    if (atomS3ProbeSessionRecoverOwned(session,3,true) != 4 || gpioCalls != before) return i32(17)
                    r.storeU32(0,0)
                    if (atomS3ProbeSessionRecoverOwned(session,3,true) != 1 || starts != 1 || session.loadU32(28) != 6) return i32(18)
                } else if (!result.valid()) return i32(19)
                if (session.loadU32(4) != 2 || nativeAddressLoadU32(gateMemory,0) != 0 || bad ||
                    r.loadU32(0x0c) != 0x31412345 || r.loadU32(0xe8) != 0xa5000003 ||
                    gpio.loadU32(4) != 0 || gpio.loadU32(16) != 0 || gpio.loadU32(32) != 0 || gpio.loadU32(44) != 0 ||
                    gpio.loadU32(0x154+(if (port == 2) 103 else 68)*4) != 0) return i32(20)
                scenario=scenario+1
            }
            var resetFault=0
            while (resetFault <= 3) {
                seed();scenario=0;resetFail=resetFault
                val result=atomS3ProbeSessionRunOwned(session,M5BoardId(board),port,gate,u32(7),3,true,2)
                if (bad) return i32(21)
                if (resetFault == 0) {
                    if (!result.valid() || delayTotal != 13 || starts != 3 || resetCalls != 3) return i32(22)
                } else {
                    if (result.status() != 6 || (result&0xffffffff) != ((10<<24)|(resetFault+2)) || starts != 0 ||
                        session.loadU32(4) != 3 || nativeAddressLoadU32(gateMemory,0) != 0x80000000) return i32(23)
                    val before=delayTotal;resetFail=0
                    if (atomS3ProbeSessionRecoverOwned(session,3,true) != 1 || starts != 0 || delayTotal != before+10) return i32(24)
                }
                if (bad || session.loadU32(4) != 2 || session.loadU32(96) != 3 || nativeAddressLoadU32(gateMemory,0) != 0 ||
                    gpio.loadU32(4) != 0 || gpio.loadU32(16) != 0 || gpio.loadU32(32) != 0 || gpio.loadU32(44) != 0) return i32(25)
                resetFault=resetFault+1
            }
            var fields=0
            while (fields < 64) {
                seed();scenario=0
                r.storeU32(0x20,(fields&1)<<29);r.storeU32(0x10,((fields>>1)&1)<<9)
                r.storeU32(8,((fields>>2)&15)<<23)
                if (!atomS3ProbeSessionRunOwned(session,M5BoardId(board),port,gate,u32(7),3,true).valid() || bad ||
                    (r.loadU32(0x20)&0x20000000) != ((fields&1)<<29) || (r.loadU32(0x10)&512) != (((fields>>1)&1)<<9) ||
                    (r.loadU32(8)&0x07800000) != (((fields>>2)&15)<<23) || session.loadU32(104) != 2) return i32(26)
                fields=fields+1
            }
            var fault=1
            while (fault <= 3) {
                seed();scenario=0;modeDrop=fault
                r.storeU32(0x20,0x20000000);r.storeU32(0x10,512);r.storeU32(8,0x07800000)
                val result=atomS3ProbeSessionRunOwned(session,M5BoardId(board),port,gate,u32(7),3,true)
                if (result.status() != 6 || (result&0xffffffff) != (12<<24) || starts != 0 || session.loadU32(4) != 3 || bad) return i32(27)
                modeDrop=0
                if (atomS3ProbeSessionRecoverOwned(session,3,true) != 1 || starts != 0 || bad ||
                    (r.loadU32(0x20)&0x20000000) != 0x20000000 || (r.loadU32(0x10)&512) != 512 ||
                    (r.loadU32(8)&0x07800000) != 0x07800000) return i32(28)
                fault=fault+1
            }
            board=board+7
        }
        port=port+1
    }
    return i32(0)
}
