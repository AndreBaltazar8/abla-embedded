import "../src/display/software_lcd.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val pixelsBE = nativeStaticBytes("\x00\x00\x12\x34\xab\xcd\xff\x00\x00\x45\x67\x89\xab")
val pixelsLE = nativeStaticBytes("\x00\x00\x34\x12\xcd\xab\xff\x00\x00\x67\x45\xab\x89")
val expected = nativeStaticBytes("\x2a\x00\x02\x00\x03\x2b\x00\x03\x00\x04\x2c\x12\x34\xab\xcd\x45\x67\x89\xab")
var selected = false
var dataMode = true
var outputHigh = false
var bits = 0
var captured = 0
var activity = 0
var selections = 0
var bad = false
var shared = false
var driven = true
trusted fun Pin.write(high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) dataMode = high
    if (this == 3) {
        if (shared && !driven) bad = true
        if (selected == !high || (!high && dataMode)) bad = true
        selected = !high
        if (selected) selections = selections + 1
    }
    if (this == 1 && selected && high) {
        val index = bits / 8
        if (dataMode != (index != 0 && index != 5 && index != 10)) bad = true
        captured = (captured << 1) | (if (outputHigh) 1 else 0)
        bits = bits + 1
        if (bits % 8 == 0) {
            if (index >= 19 || captured != nativeBufferAt(expected, 19).load(index)) bad = true
            captured = 0
        }
    }
    return
}
fun Pin.read(): bool { bad = true; false }
trusted fun Pin.output(): void {
    if (!shared || this != 4 || driven || selected || dataMode || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    driven = true
    return
}
trusted fun Pin.input(): void {
    if (!shared || this != 4 || !driven || selected || !dataMode || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    driven = false
    return
}
fun peripheralDelayMicroseconds(duration: int): void { bad = true; return }
fun peripheralDelayMilliseconds(duration: int): void { bad = true; return }
@export("abla_software_blit_native_test")
trusted fun softwareBlitNativeTest(): i32 {
    val gate = peripheralGateAt(gateStorage)
    val view = lcdGeometry(2, 2, 2, 3, 4, 5).view(0)
    var variant = 0
    while (variant < 4) {
        shared = variant >= 2
        driven = !shared
        bits = 0
        selections = 0
        val source = nativeBufferAt(if ((variant & 1) == 0) pixelsBE else pixelsLE, 13)
        val result = softwareLcd(Pin(1), Pin(2), Pin(3), Pin(4), shared).blitRgb565(gate, u32(7),
            view, -1, 0, source, 3, 2, 7, (variant & 1) != 0, 0)
        if (!result.valid() || bad || selected || driven != !shared || bits != 152 || selections != 3 ||
            nativeAddressLoadU32(gateStorage, 0) != 0) return i32(1)
        variant = variant + 1
    }
    activity = 0
    val short = nativeBufferAt(pixelsBE, 12)
    if (softwareLcdBlitRgb565(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        view, -1, 0, short, 3, 2, 7, false, 0).status() != 3 || activity != 0) return i32(2)
    val source = nativeBufferAt(pixelsBE, 13)
    if (lcdRgb565SourceValid(source, 3, 2, 5) || lcdRgb565SourceValid(source, 3, 2, 9223372036854775807) ||
        lcdRgb565SourceValid(nativeBufferAt(4294967290, 13), 3, 2, 7) ||
        lcdRgb565SourceValid(source, -1, 2, 7)) return i32(3)
    if (!softwareLcdBlitRgb565(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        view, -9223372036854775807, 0, source, 3, 2, 7, false, 0).valid() || activity != 0) return i32(4)
    if (gate.tryBegin(u32(9)) != 0) return i32(5)
    if (softwareLcdBlitRgb565(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        view, 0, 0, source, 3, 2, 7, false, 0).status() != 2 || activity != 0) return i32(6)
    if (!gate.finish(u32(9), true)) return i32(7)
    i32(0)
}
