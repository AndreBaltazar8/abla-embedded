import "../src/esp32/reference_clock_owner_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_reference_owner_target")
trusted fun target(owner: Esp32P4ReferenceClockOwner,release: bool): Esp32P4ReferenceClockOwner {
    if (release) return owner.release()
    owner.acquire()
}
