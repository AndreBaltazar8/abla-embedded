import "../src/xtensa/cpu_logic.ab"
import "../src/esp32/interrupt_capabilities_s3.ab"
fun main(): int {
    var line=0
    while (line < 32) {
        var core=0
        while (core < 2) {
            val irq=xtensaInterrupt(line)
            if (XtensaInterruptTable(u32(4096)).entryAddress(irq,core,2) != u32(4096+line*16+core*8)) return 1
            if (XtensaInterruptTable(u32(0xFFFFFE00)).entryAddress(irq,core,2) != u32(0xFFFFFE00+line*16+core*8)) return 2
            if (XtensaInterruptTable(u32(0xFFFFFE04)).entryAddress(irq,core,2) != u32(0)) return 3
            core=core+1
        }
        val expected=if (line <= 10 || line == 12 || line == 13 || line == 17 || line == 18) 1
            else if (line >= 19 && line <= 21) 2
            else if (line == 11 || line == 15 || line == 22 || line == 23 || line == 27 || line == 29) 3
            else if (line == 24 || line == 25 || line == 28 || line == 30) 4
            else if (line == 14) 7 else 5
        if (esp32S3InterruptLevel(line) != expected || esp32S3InterruptSupportsNativeHandler(line) != (expected <= 3)) return 4
        line=line+1
    }
    val irq=xtensaInterrupt(0)
    if (XtensaInterruptTable(u32(4097)).entryAddress(irq,0,2) != u32(0) ||
        XtensaInterruptTable(u32(4096)).entryAddress(irq,0,16777217) != u32(0) ||
        XtensaInterruptTable(u32(4096)).entryAddress(irq,0,0) != u32(0) ||
        XtensaInterruptTable(u32(4096)).entryAddress(irq,2,2) != u32(0)) return 5
    if (esp32S3InterruptLevel(-1) != -1 || esp32S3InterruptLevel(32) != -1 || esp32S3InterruptExternalLevel(14) || esp32S3InterruptExternalLevel(16)) return 6
    0
}
