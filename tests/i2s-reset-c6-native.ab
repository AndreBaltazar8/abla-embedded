import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/reset_c6_sequence.ab"
var conf=u32(0)
var tx=false
var selfClear=false
var writes=0
var drop=0
var pulses=0
var history=0
var enabled=true
var busy=false
var bad=false
trusted fun c6I2sClockRead(at: int): u32 = if (at == 0) u32(1) else if (enabled) u32(0x400000) else u32(0)
trusted fun c6I2sClockWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6I2sRead(at: int): u32 = if (at == (if (tx) 0x24 else 0x20)) conf else if (at == 0x6c) u32(1) else if (at == 0x14 && busy) u32(1) else u32(0)
trusted fun c6I2sWrite(at: int,v: u32): void {
    writes=writes+1;history=(history<<2)|int(v&u32(3))
    if (at != (if (tx) 0x24 else 0x20) || ((v^conf)&~u32(3)) != u32(0)) bad=true
    if (writes == drop) return
    if ((v&u32(3)) != u32(0)) pulses=pulses+1
    conf=if (selfClear) v&~u32(3) else v
    return
}
@export("abla_i2s_reset_c6_test")
trusted fun test(): i32 {
    var direction=0
    while (direction < 2) {
        tx=direction == 1
        var mode=0
        while (mode < 2) {
            selfClear=mode == 1
            var selection=1
            while (selection <= 3) {
                var fault=0
                while (fault <= 4) {
                    conf=u32(0xa5a5a0f8);writes=0;pulses=0;history=0;drop=fault
                    val result=c6I2sResetOwned(0,tx,selection,true,true)
                    val count=if (selection == 3) 4 else 2
                    val failed=!selfClear && fault <= count && fault > 0 && (fault&1) == 0
                    if (result != (if (failed) 5 else 1)) return i32(1)
                    if (!failed && (writes != count || history != (if (selection == 1) 4 else if (selection == 2) 8 else 72))) return i32(2)
                    drop=0
                    val previousPulses=pulses
                    if (c6I2sResetReleaseOwned(0,tx,true) != 1 || conf != u32(0xa5a5a0f8) || pulses != previousPulses || bad) return i32(3)
                    fault=fault+1
                }
                selection=selection+1
            }
            mode=mode+1
        }
        writes=0;busy=true
        if (c6I2sResetOwned(0,tx,3,true,true) != 4 || c6I2sResetReleaseOwned(0,tx,true) != 4 || writes != 0) return i32(4)
        busy=false;enabled=false
        if (c6I2sResetOwned(0,tx,3,true,true) != 3 || writes != 0) return i32(5)
        enabled=true
        if (c6I2sResetOwned(0,tx,3,true,false) != 2 || c6I2sResetOwned(0,tx,3,false,true) != 2 || c6I2sResetOwned(1,tx,3,true,true) != 2 || c6I2sResetOwned(0,tx,0,true,true) != 2 || writes != 0) return i32(6)
        direction=direction+1
    }
    return i32(0)
}
