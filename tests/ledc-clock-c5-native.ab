import "../src/esp32/ledc_clock_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var bus=0
var functional=0
var memoryPower=0
var writes=0
var drop=0
var busy=0
var bad=false
fun c5LedcClockRead(offset: int): int {
    if (offset == 0) return bus
    if (offset == 4) return functional
    if (offset == 8) return memoryPower
    bad=true;return 0
}
fun c5LedcClockWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0) { if ((value&~1) != (bus&~1)) bad=true;bus=value;return }
    if (offset == 4) { if ((value&~0x400000) != (functional&~0x400000)) bad=true;functional=value;return }
    if (offset == 8) { if ((value&~4) != (memoryPower&~4)) bad=true;memoryPower=value;return }
    bad=true;return
}
fun c5LedcRead(offset: int): int {
    if ((bus&5) != 5) bad=true
    if (offset == 200) return if (busy == 1) 1 else 0
    if (offset >= 160 && offset <= 184 && (offset-160)%8 == 0) {
        val timer=(offset-160)/8
        return if (busy == 20+timer) 0 else if (busy == 24+timer) 0x4800000 else 0x800000
    }
    if (offset >= 0 && offset <= 100 && offset%20 == 0) {
        val channel=offset/20
        return if (busy == 2+channel) 4 else if (busy == 8+channel) 16 else 0
    }
    if (offset >= 12 && offset <= 112 && (offset-12)%20 == 0) return if (busy == 14+(offset-12)/20) 0x80000000 else 0
    bad=true;return 0
}
fun c5LedcWrite(offset: int,value: int): void { bad=true;return }
@export("abla_ledc_clock_c5_test")
trusted fun testClock(): int {
    var scenario=0
    while (scenario < 96) {
        val gates=scenario%8;val source=(scenario/8)%3
        val originalBus=0x80000004|(gates&1)
        val originalFunctional=0x80001234|(source<<20)|((gates&2)<<21)
        val originalMemory=0x80000002|((gates&4)^4)
        bus=originalBus;functional=originalFunctional;memoryPower=originalMemory
        writes=0;drop=scenario/24;busy=0;bad=false
        var owner=c5LedcClockOpenOwned(source,true,3)
        if (bad || (drop == 0 && (!owner.ready() || (bus&1) == 0 || (functional&0x400000) == 0 || (memoryPower&4) != 0))) return 1
        if (owner.ready() && (owner&1792) != 0) {
            busy=1
            while (busy < 28) {
                val oldWrites=writes
                if (owner.closeOwned(true).status() != 6 || writes != oldWrites || bad) return 2
                busy=busy+1
            }
            busy=0
        }
        drop=writes+1
        owner=owner.closeOwned(true)
        drop=0;owner=owner.closeOwned(true)
        if (owner.status() != 0 || bus != originalBus || functional != originalFunctional || memoryPower != originalMemory || bad) return 3
        val finalWrites=writes
        if (owner.closeOwned(true).status() != 0 || writes != finalWrites) return 4
        scenario=scenario+1
    }
    bus=0;functional=0;memoryPower=4;writes=0;drop=0
    var owner=c5LedcClockOpenOwned(0,true,3)
    if (owner.status() != 5 || writes != 1 || bad) return 5
    owner=owner.closeOwned(true)
    if (owner.status() != 0 || bus != 0 || memoryPower != 4 || bad) return 6
    bus=6;writes=0
    if (c5LedcClockOpenOwned(0,true,3).status() != 3 || writes != 0) return 7
    bus=4;functional=3<<20
    if (c5LedcClockOpenOwned(0,true,3).status() != 3 || writes != 0) return 8
    return 0
}
