import "../src/esp32/dsi_read_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(20)
var length=1
var headers=0
var words=0
var mode=0
var bad=false
fun p4DsiRead(offset: int): u32 {
    if (offset == 52) return u32(1)
    if (offset == 44) return u32(4)
    if (offset == 48) return u32(1)
    if (offset == 116) {
        if (headers < 2) return if (mode == 1) u32(5) else u32(21)
        if (mode == 2) return u32(85)
        if (mode == 3) return u32(21)
        return if (words < (length+3)/4+(if (mode == 4) 1 else 0)) u32(5) else u32(21)
    }
    if (offset == 112) {
        val base=words*4
        words=words+1
        return u32(base|((base+1)<<8)|((base+2)<<16)|((base+3)<<24))
    }
    u32(0)
}
fun p4DsiWrite(offset: int,value: u32): void {
    if (offset != 108 || value != u32(if (headers == 0) (length<<8)|119 else 55878)) bad=true
    headers=headers+1
    return
}
@export("abla_dsi_p4_read_test")
trusted fun testRead(): i32 {
    val buffer=nativeBufferAt(storage+1,17)
    nativeBufferAt(storage,20).store(0,123)
    while (length <= 17) {
        headers=0; words=0
        val result=esp32P4DsiDcsReadOwned(1,218,buffer,length,3)
        if (!result.hostComplete() || !result.enqueued() || headers != 2 || bad) return i32(1)
        var i=0
        while (i < length) { if (buffer.load(i) != i) return i32(2); i=i+1 }
        length=length+1
    }
    length=5; mode=1
    while (mode <= 4) {
        headers=0; words=0
        val result=esp32P4DsiDcsReadOwned(1,218,buffer,length,3)
        if (result.status() != (if (mode == 1) 9 else if (mode == 2) 5 else if (mode == 3) 11 else 12) ||
            result.enqueued() != (mode != 1) || bad) return i32(3)
        mode=mode+1
    }
    headers=0; words=0
    if (esp32P4DsiDcsReadOwned(1,218,buffer,18,3).status() != 2 || headers != 0 || words != 0 ||
        nativeBufferAt(storage,20).load(0) != 123) return i32(4)
    i32(0)
}
