import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/cores3_speaker_stream.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun speakerStreamTarget(amplifier: u32, expander: u32, channel: i32, descriptors: u32, stop: bool): int {
    val result = if (stop) cores3StopSpeakerStream(Aw88298(int(amplifier)), Aw9523(int(expander)), int(channel), 1000)
        else cores3StartSpeakerStream(Aw88298(int(amplifier)), Aw9523(int(expander)), 16000, int(channel), int(descriptors), 1000)
    result.status() | (result.dmaStatus() << 8) | (result.amplifierStatus() << 24)
}
#exportFunction("speakerStreamTarget", "abla_s3_speaker_stream_test")
