import "../src/esp32/i2c/hardware_provider_p4.ab"
import "../src/touch/st7123_device.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(72)
val chip=nativeStaticAllocate(256)
var transfers=0
var failedTransfer=0
var bad=false
trusted fun p4I2cSessionClockOpen(port: int,source: int): int { bad=true;return 0 }
trusted fun p4I2cSessionInitialize(port: int,filter: int): int { bad=true;return 0 }
trusted fun p4I2cSessionPinsOpen(r: NativeBuffer,port: int,sda: int,scl: int,pullup: bool,layout: int): int { bad=true;return 0 }
trusted fun p4I2cSessionClockClose(token: int): int = 4102
trusted fun p4I2cSessionPinsClose(r: NativeBuffer): int = 2
trusted fun p4I2cSessionTiming(port: int,t: P4I2cTiming): int {
    if (port != 0 || t != esp32p4I2cTiming(u32(40000000),u32(400000))) bad=true
    return 1
}
trusted fun p4I2cSessionTransfer(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    transfers=transfers+1
    if (p4HardwareLoad(0) != 1 || port != 0 || address != 85 || prefix != -1 || written != 2 ||
         budget != u32(400000000)) { bad=true;return 7 }
    if (transfers == failedTransfer) return 3
    val regs=nativeBufferAt(chip,256)
    val register=(output.load(0)<<8)|output.load(1)
    if (register+read > 256) { bad=true;return 7 }
    var i=0
    while (i < read) { input.store(i,regs.load(register+i));i=i+1 }
    return 1
}
trusted fun seed(): void {
    val r=nativeBufferAt(storage,72);val regs=nativeBufferAt(chip,256)
    var i=0
    while (i < 72) { r.storeU32(i,0);i=i+4 }
    i=0
    while (i < 256) { regs.store(i,0);i=i+1 }
    r.storeU32(0,0x49324234);r.storeU32(4,1);r.storeU32(16,4097);r.storeU32(24,1)
    regs.store(0,3)
    transfers=0;failedTransfer=0;bad=false;return
}
val snapshotStorage=nativeStaticAllocate(76)
@export("abla_p4_hardware_touch_test")
trusted fun test(): i32 {
    val snapshot=nativeBufferAt(snapshotStorage,76)
    var scenario=0
    while (scenario < 5) {
        seed()
        val bus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
        val touch=st7123(bus)
        if (!touch.valid() || !touch.begin() || transfers != 3 || bad) return i32(1)
        val regs=nativeBufferAt(chip,256)
        regs.store(16,8);regs.store(9,10)
        // Sparse contact slots0 and9 exercise the complete70-byte report.
        regs.store(20,0x81);regs.store(21,0x23);regs.store(22,4);regs.store(23,0x56);regs.store(24,17)
        regs.store(83,0xbf);regs.store(84,255);regs.store(85,0xab);regs.store(86,0xcd);regs.store(87,201)
        snapshot.storeU32(72,0x12345678)
        if (touch.readFrame(snapshot) != 2 || bad || snapshot.loadU32(72) != 0x12345678) return i32(2)
        val first=st7123Point(snapshot,0);val last=st7123Point(snapshot,1)
        if (!first.valid() || first.x() != 291 || first.y() != 1110 || first.id() != 0 || first.size() != 17 ||
            !last.valid() || last.x() != 16383 || last.y() != 43981 || last.id() != 9 || last.size() != 201 ||
            st7123Point(snapshot,2).valid()) return i32(3)
        if (scenario < 3) {
            failedTransfer=transfers+scenario+1
            if (touch.readFrame(snapshot) != -1 || nativeBufferAt(storage,72).loadU32(4) != 3) return i32(4)
            val stopped=transfers
            if (touch.readFrame(snapshot) != -1 || transfers != stopped) return i32(5)
        } else if (scenario == 3) {
            regs.store(16,0)
            if (touch.readFrame(snapshot) != -2 || snapshot.load(0) != 0) return i32(6)
        } else {
            regs.store(9,0)
            if (touch.readFrame(snapshot) != 0 || st7123Point(snapshot,0).valid()) return i32(7)
        }
        if (!touch.close() || !bus.close() || bad) return i32(8)
        scenario=scenario+1
    }
    var failure=1
    while (failure <= 3) {
        seed();failedTransfer=failure
        val bus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
        val touch=st7123(bus)
        if (touch.begin() || transfers != failure || !touch.close() || !bus.close() || bad) return i32(9)
        failure=failure+1
    }
    return i32(0)
}
