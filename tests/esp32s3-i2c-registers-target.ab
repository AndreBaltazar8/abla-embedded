import "../src/esp32/i2c_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_i2c_registers_test")
trusted fun registersTargetTest(port: i32, sda: i32, scl: i32, xtal: u32, cpu: u32,
    address: i32, register: i32, operation: i32, value: i32): int {
    val bus = i2cMaster(int(port), int(sda), int(scl), xtal, cpu)
    if (!bus.valid()) return -1
    val device = bus.device(int(address))
    var result = -1
    if (operation == i32(0)) {
        val word = device.readRegister16BigEndianChecked(int(register))
        if (word.valid()) result = word.value()
    }
    if (operation == i32(1)) {
        val word = device.readRegister16LittleEndianChecked(int(register))
        if (word.valid()) result = word.value()
    }
    if (operation == i32(2)) {
        val word = device.readRegister24BigEndianChecked(int(register))
        if (word.valid()) result = word.value()
    }
    if (operation == i32(3)) {
        val word = device.readRegister32BigEndianChecked(int(register))
        if (word.valid()) result = word.value()
    }
    if (operation == i32(4)) result = if (device.writeRegister16BigEndian(int(register), int(value))) 1 else -1
    if (operation == i32(5)) result = if (device.writeRegister16LittleEndian(int(register), int(value))) 1 else -1
    if (operation == i32(6)) result = if (device.updateRegister8(int(register), 15, int(value))) 1 else -1
    if (operation == i32(7)) result = device.readRegister8(int(register), -1)
    if (!bus.close()) return -2
    result
}
