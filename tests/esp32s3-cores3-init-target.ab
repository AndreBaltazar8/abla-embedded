#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_cores3_init_test")
trusted fun cores3InitTarget(pmic: u32, expander: u32, touch: u32, gate: u32, external5v: bool): int =
    m5BoardStackCoreS3.initializeCoreS3Display(Axp2101(int(pmic)), Aw9523(int(expander)),
        Ft5x06(int(touch)), peripheralGateAt(int(gate)), u32(7), external5v, 100).status()
