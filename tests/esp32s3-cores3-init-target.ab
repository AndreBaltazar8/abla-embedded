import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/cores3_display_init.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
import "../src/hal/aw9523.ab"
import "../src/hal/ft5x06.ab"
import "../src/m5stack/board_id.ab"
import "../src/power/axp2101_type.ab"
import "../src/io_expander/aw9523_type.ab"
import "../src/touch/ft5x06_type.ab"
