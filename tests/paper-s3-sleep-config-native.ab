import "../src/m5stack/paper_s3_sleep_config.ab"
import "abla/build"
val sleepConfigMemory=nativeStaticAllocate(80)
@export("abla_paper_s3_sleep_config_test")
fun testConfig(): int {
    val out=nativeBufferAt(sleepConfigMemory,76)
    val i=esp32S3TagPlan(false,16384,4,32,0x42000000,4096,false)
    var options=0
    while (options < 8) {
        val d=esp32S3TagPlan(true,32768,4,32,0x3c000000,4096,(options&2) != 0)
        val flags=if ((options&4) != 0) 0x20000 else 0
        out.storeU32(72,0x12345678)
        if (!paperS3SleepConfigEncode(out,i,d,Esp32S3ClockBias(0),7,options,2,0,0,100,flags,3495253,100000,0x3ffff) || !paperS3SleepConfigValid(out) || out.loadU32(72) != 0x12345678 || paperS3ConfigLoad64(out,8) != (d|0)) return 1
        var mutation=0
        while (mutation < 16) {
            val offset=if (mutation == 0) 4 else if (mutation == 1) 12 else if (mutation == 2) 20 else 24+(mutation-3)*4
            val old=out.loadU32(offset)
            val value=if (offset == 4 || offset == 12 || offset == 20 || offset == 60) 0x80000000 else
                if (offset == 24 || offset == 28) 8 else if (offset == 36 || offset == 40) 64 else
                if (offset == 48 || offset == 56 || offset == 68) 1 else if (offset == 64) 0x40000 else 0
            if (offset <= 68) {
                out.storeU32(offset,value)
                if (paperS3SleepConfigValid(out)) return 2
                out.storeU32(offset,old)
            }
            mutation=mutation+1
        }
        if (paperS3SleepConfigValuesValid(i,d,Esp32S3ClockBias(0),0,options,-1,0,0,100,flags^0x20000,3495253,0,0)) return 3
        options=options+1
    }
    val d=esp32S3TagPlan(true,32768,4,32,0x3c000000,4096,false)
    var offset=0
    while (offset < 72) { out.storeU32(offset,0xa5a5a5a5);offset=offset+4 }
    if (paperS3SleepConfigEncode(out,i,d,Esp32S3ClockBias(0),0,0,-1,0,0,100,1,3495253,0,0)) return 4
    offset=0
    while (offset < 72) { if (out.loadU32(offset) != 0xa5a5a5a5) return 5;offset=offset+4 }
    if (paperS3SleepConfigEncode(nativeBufferAt(sleepConfigMemory,68),i,d,Esp32S3ClockBias(0),0,0,-1,0,0,100,0,3495253,0,0) || paperS3SleepConfigValid(nativeBufferAt(sleepConfigMemory,68))) return 6
    if (!paperS3SleepConfigEncode(out,i,d,Esp32S3ClockBias(0),0,0,-1,0,0,100,0,3495253,0,0) || !paperS3SleepConfigValid(out)) return 7
    return 0
}
