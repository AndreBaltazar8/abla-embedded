import "../src/esp32/spi/command_pins_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
var base=0x60024000
var active=0
var calls=0
var failure=0
var bad=false
fun esp32s3SpiRead(address: int): int {
    if (address == base) return if (active == 1) 0x00800000 else if (active == 2) 0x01000000 else 0
    if (address == base+0x30) return if (active == 3) 0x18000000 else 0
    bad=true;return 0
}
fun esp32s3SpiWrite(address: int,value: int): void { bad=true;return }
fun Pin.outputLevelOwned(high: bool): bool { bad=true;return false }
fun Pin.writeLevelOwned(high: bool): bool {
    calls=calls+1;if (this != 3 || !high || active != 0) bad=true
    return failure != 1
}
fun Pin.inputOwned(): bool {
    calls=calls+1;if (this != 4 || active != 0 || calls != 2) bad=true
    return failure != 2
}
@export("abla_spi_command_cleanup_s3_test")
trusted fun test(): i32 {
    var port=2
    while (port <= 3) {
        base=0x60024000+(port-2)*4096
        var shared=0
        while (shared <= 1) {
            active=0
            while (active <= 3) {
                var success=0
                while (success <= 1) {
                    calls=0;failure=0
                    val detail=if (success == 1) 257 else 0x20109
                    val result=esp32s3SpiCommandPinsEndQuiescent(port,Pin(3),Pin(4),shared != 0,detail)
                    val expected=if (active == 0) detail else (if (success == 1) 266 else detail)|(1<<24)|(if (shared != 0) 1<<25 else 0)
                    if (result != expected || calls != (if (active == 0) 1+shared else 0) || bad) return i32(1)
                    success=success+1
                }
                active=active+1
            }
            active=0;failure=1;calls=0
            if (esp32s3SpiCommandPinsEndQuiescent(port,Pin(3),Pin(4),shared != 0,257) != (266|(1<<24)) || calls != 1 || bad) return i32(2)
            failure=2;calls=0
            val result=esp32s3SpiCommandPinsEndQuiescent(port,Pin(3),Pin(4),shared != 0,257)
            if (result != (if (shared == 0) 257 else 266|(1<<25)) || calls != 1+shared || bad) return i32(3)
            shared=shared+1
        }
        port=port+1
    }
    return i32(0)
}
