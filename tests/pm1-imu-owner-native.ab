import "./pm1-rtc-owner-native.ab"
import "../src/m5stack/pm1_imu_owner_sequence.ab"
val imuParentMemory=nativeStaticAllocate(76)
val imuChildMemory=nativeStaticAllocate(36)
var imuProbeStatus=0
var imuCloseFail=false
var imuCalls=0
fun pm1ImuParentStorageSafe(storage: NativeBuffer): bool = softwareI2cProviderBufferSafe(storage,76)
trusted fun pm1BoardImuAdmission(control: int,imu: M5ImuOwner): bool =
    M5Pm1Control(control).ready() && imu.status() == 0 && softwareI2cProviderBufferSafe(imu.buffer(),36)
trusted fun pm1BoardImuProbe(imu: M5ImuOwner,bus: int): int {
    imuCalls=imuCalls+1
    if (!I2cBus(bus).current()) bad=true
    return imuProbeStatus
}
trusted fun pm1BoardImuClose(imu: M5ImuOwner): bool { imuCalls=imuCalls+1;return !imuCloseFail }
@export("abla_pm1_imu_owner_test")
trusted fun testImuOwner(): i32 {
    val owner=m5Pm1ControlAt(nativeBufferAt(imuParentMemory,76))
    val child=m5ImuOwnerAt(nativeBufferAt(imuChildMemory,36))
    var boardIndex=0
    while (boardIndex < 3) {
        val board=if (boardIndex == 0) m5BoardChainCaptain else if (boardIndex == 1) m5BoardPaperMono else m5BoardStopWatch
        imuProbeStatus=-1
        while (imuProbeStatus <= 6) {
            wireSeed();imuCalls=0;imuCloseFail=false
            val bus=i2cSoftwareMaster(0,1,5,8)
            if (!owner.initialize() || !child.initialize() || owner.openOwned(bus|0,board,true,true) != 1) return i32(1)
            val short=m5Pm1ControlAt(nativeBufferAt(imuParentMemory,72))
            if (short.openRetainedImuPreparedOwned(child,true) != -1 || owner.openRetainedImuPreparedOwned(child,false) != -1 || imuCalls != 0) return i32(2)
            val before=ackCount
            if (owner.openRetainedImuPreparedOwned(child,true) != imuProbeStatus || !owner.imuRetained() || owner.openFailure() != 0 || imuCalls != 1) return i32(3)
            if (owner.closeOwned(true) || !owner.ready() || owner.openRetainedImuPreparedOwned(child,true) != -1 ||
                owner.closeRetainedImuOwned(child,false) || owner.closeRetainedImuOwned(M5ImuOwner(0),true) ||
                owner.closeRetainedImuOwned(m5ImuOwnerAt(nativeBufferAt(imuParentMemory,36)),true) || imuCalls != 1 || ackCount != before) return i32(4)
            val rtc=owner.openRetainedRtcOwned(true,true)
            if (!rtc.ready() || !owner.rtcRetained()) return i32(8)
            imuCloseFail=true
            if (owner.closeRetainedImuOwned(child,true) || !owner.imuRetained() || !owner.ready()) return i32(5)
            imuCloseFail=false
            if (!owner.closeRetainedImuOwned(child,true) || owner.imuRetained() || owner.buffer().loadU32(72) != 0 || owner.openFailure() != 0) return i32(6)
            if (!owner.rtcRetained() || owner.closeOwned(true) || !owner.closeRetainedRtcOwned(rtc.handle(),true)) return i32(9)
            if (!owner.closeOwned(true) || !bus.close() || pads != 0 || bad) return i32(7)
            imuProbeStatus=imuProbeStatus+1
        }
        boardIndex=boardIndex+1
    }
    return i32(0)
}
