import "../src/esp32/mspi_transition_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_mspi_transition_target")
@section(".iram1.abla.s3MspiTransitionTarget")
trusted fun transitionTarget(saved: NativeBuffer,octal: bool,ramKind: int,protocol: int,baseline: int,polls: int,restore: bool): int =
    if (restore) esp32S3MspiLowEndOwned(saved,polls) else esp32S3MspiLowBeginOwned(saved,octal,ramKind,protocol,baseline,polls)
