import "../src/esp32/rmt_clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Compile fixture, not board startup: caller owns stopped group and pad.
trusted fun rmtTransmitTarget(owner: u32, channel: u32, source: u32, symbols: u32): int {
    if (!esp32s3RmtEnableBusClock(owner)) return -1
    if (!esp32s3RmtSetGroupClockOwned(false, owner)) return -2
    if (!esp32s3RmtConfigureClock(1, 1, 0, 0, owner)) return -3
    if (!esp32s3RmtPrepareMemory(owner)) return -4
    if (!esp32s3RmtSetGroupClockOwned(true, owner)) return -5
    esp32s3RmtTransmitFrameOwned(int(channel), 8,
        nativeBufferAt(int(source), int(symbols) * 4), int(symbols), 100000)
}
#exportFunction("rmtTransmitTarget", "abla_s3_rmt_transmit_test")
