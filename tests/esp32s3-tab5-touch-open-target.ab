import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/tab5_touch_open.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_tab5_touch_open_target")
trusted fun target(board: M5BoardId,bus: I2cBus,probe: M5Tab5TouchProbe,gtVerified: bool): TouchControllerOpen =
    board.openTab5Touch(bus,probe,gtVerified)
