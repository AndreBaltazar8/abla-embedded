import "../src/storage/fat_mount.ab"
import "../src/storage/fat_lookup.ab"
import "../src/storage/fat_path.ab"
import "../src/storage/fat_file_read.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(2610)
var calls=0
var bad=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,dest: NativeBuffer): bool {
    calls=calls+1
    var i=0
    while (i < 512) { dest.store(i,0); i=i+1 }
    if (lba == 0) {
        dest.store(12,2); dest.store(13,1); dest.store(14,1); dest.store(16,2); dest.store(18,2)
        dest.store(22,40); dest.store(19,129); dest.store(20,39); dest.store(510,85); dest.store(511,170)
    } else if (lba == 81) {
        i=0
        while (i < 11) { dest.store(i,32); i=i+1 }
        dest.store(0,65); dest.store(26,2); dest.store(28,188); dest.store(29,2)
    } else if (lba == 1) {
        dest.store(4,5); dest.store(10,255); dest.store(11,255)
    } else if (lba == 113 || lba == 116) {
        i=0
        while (i < 512) { dest.store(i,(i+(if (lba == 113) 0 else 7))&255); i=i+1 }
    } else bad=true
    return !bad
}
@export("abla_fat_workflow_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(storage,28)
    val boot=nativeBufferAt(storage+28,512)
    val work=nativeBufferAt(storage+540,1536)
    val scratch=nativeBufferAt(work.addressValue(),1024)
    val sector=nativeBufferAt(work.addressValue()+1024,512)
    val dest=nativeBufferAt(storage+2076,512)
    val name=nativeBufferAt(storage+2588,11)
    val path=nativeBufferAt(storage+2599,11)
    var i=0
    while (i < 11) { name.store(i,32); i=i+1 }
    name.store(0,65)
    val mount=fatMountReadOwned(reader,10113,-1,boot,sector)
    if (!mount.valid() || calls != 1) return i32(1)
    val file=fatLookupShortOwned(reader,boot,mount.firstSector(),mount.sectors(),0,name,10,sector,scratch)
    if (!file.isFile() || file.byteSize() != 700 || calls != 2) return i32(2)
    path.store(0,97)
    val byPath=fatLookupPathOwned(reader,boot,mount.firstSector(),mount.sectors(),path,1,10,name,work)
    if (byPath != file || calls != 3) return i32(7)
    var offset=0
    while (offset < file.byteSize()) {
        val read=fatFileReadAtOwned(reader,boot,mount.firstSector(),mount.sectors(),file,offset,512,10,dest,work)
        if (read.status() != 1 || read.bytesRead() != (if (offset == 0) 512 else 188)) return i32(3)
        i=0
        while (i < read.bytesRead()) { if (dest.load(i) != ((i+(if (offset == 0) 0 else 7))&255)) return i32(4); i=i+1 }
        offset=offset+read.bytesRead()
    }
    if (offset != 700 || calls != 6 || bad) return i32(5)
    if (fatFileReadAtOwned(reader,boot,0,10113,file,offset,512,10,dest,work).status() != 2 || calls != 6) return i32(6)
    return i32(0)
}
