import "../src/esp32/timer/clock_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val registers=nativeStaticAllocate(256)
var config=0
var irq=0
var pending=0
var writes=0
var drop=0
var unsafeRead=false
fun p4SystemTimerClockRead(offset: int): int = nativeBufferAt(registers,256).loadU32(offset)
fun setClockRegister(offset: int,value: int): void { nativeBufferAt(registers,256).storeU32(offset,value); return }
fun p4SystemTimerClockWrite(offset: int,value: int): void { writes=writes+1; if (writes != drop) setClockRegister(offset,value); return }
fun p4SystemTimerRead(offset: int): int {
    if ((p4SystemTimerClockRead(28)&0x800000) == 0) unsafeRead=true
    return if (offset == 0) config else if (offset == 100) irq else pending
}
fun p4SystemTimerWrite(offset: int,value: int): void { writes=writes+1; if (writes != drop) config=value; return }
fun resetClock(): void {
    var offset=0
    while (offset < 256) { setClockRegister(offset,0); offset=offset+4 }
    config=0; irq=0; pending=0; writes=0; drop=0; unsafeRead=false; return
}
@export("abla_p4_systimer_clock_test")
trusted fun systimerClockTest(): i32 {
    var source=0
    while (source < 2) {
        var profile=0
        while (profile < 4) {
            resetClock()
            val bus=1|(if ((profile&1) != 0) 0x800000 else 0)
            val local=1|(if ((profile&2) != 0) 0x80000000 else 0)
            setClockRegister(28,bus); setClockRegister(152,(source<<29)|1); config=local
            val lease=p4SystemTimerClockOpenOwned(source)
            if (!lease.ready() || lease.source() != source || lease.closeOwned() != 0 || p4SystemTimerClockRead(28) != bus || config != local || unsafeRead) return i32(1)
            profile=profile+1
        }
        source=source+1
    }
    var failure=1
    while (failure < 3) {
        resetClock(); drop=failure
        val partial=p4SystemTimerClockOpenOwned(0)
        if (partial.status() != failure+3 || unsafeRead) return i32(2)
        drop=0
        if (partial.closeOwned() != 0 || unsafeRead) return i32(3)
        resetClock()
        val lease=p4SystemTimerClockOpenOwned(0)
        writes=0; drop=failure
        val remaining=lease.closeOwned()
        if (remaining.status() != 6-failure) return i32(4)
        drop=0
        if (remaining.closeOwned() != 0 || unsafeRead) return i32(5)
        failure=failure+1
    }
    // Every active counter/alarm/ETM and IRQ/pending bit blocks destructive close.
    var bit=0
    while (bit < 32) {
        if (((1<<bit)&0x61c00002) != 0 || bit < 3) {
            resetClock()
            val lease=p4SystemTimerClockOpenOwned(0)
            if (((1<<bit)&0x61c00002) != 0) config=config|(1<<bit) else irq=1<<bit
            writes=0
            if (lease.closeOwned().status() != 6 || writes != 0) return i32(6)
            config=config&0x80000000; irq=0; pending=1<<(bit%3)
            if (lease.closeOwned().status() != 6 || writes != 0) return i32(7)
            pending=0
            if (lease.closeOwned() != 0) return i32(8)
        }
        bit=bit+1
    }
    resetClock(); setClockRegister(196,32)
    if (p4SystemTimerClockOpenOwned(0).status() != 3 || writes != 0 || unsafeRead) return i32(9)
    resetClock(); setClockRegister(152,1<<29)
    if (p4SystemTimerClockOpenOwned(0).status() != 3 || writes != 0) return i32(10)
    resetClock()
    if (p4SystemTimerClockOpenOwned(2).status() != 2 || writes != 0) return i32(11)
    val lease=p4SystemTimerClockOpenOwned(0)
    setClockRegister(28,0); writes=0
    if (lease.closeOwned().status() != 7 || unsafeRead || writes != 0) return i32(12)
    setClockRegister(28,0x800000)
    if (lease.closeOwned() != 0) return i32(13)
    resetClock(); setClockRegister(152,0x12345678)
    if (p4SystemTimerClockSelectOwned(0,1) != 4 || unsafeRead || writes != 0) return i32(14)
    setClockRegister(28,0x800000); config=1<<30
    if (p4SystemTimerClockSelectOwned(0,1) != 5 || writes != 0 || p4SystemTimerClockSelectOwned(0,0) != 1) return i32(15)
    config=0
    if (p4SystemTimerClockSelectOwned(0,1) != 1 || p4SystemTimerClockRead(152) != 0x32345678 || p4SystemTimerClockSelectOwned(0,1) != 3) return i32(16)
    writes=0; drop=1
    if (p4SystemTimerClockSelectOwned(1,0) != 6) return i32(17)
    return i32(0)
}
