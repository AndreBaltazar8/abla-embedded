import "../src/log_source.ab"
import "../src/log_policy.ab"
import "abla/build"
val logSourceStorage=nativeStaticAllocate(128)
fun logOutputOwned(target: int,level: int,color: bool,text: NativeBuffer,length: int,suffix: int): bool = false
@export("abla_log_source_test")
fun testLogSource(): int {
    val output=nativeBufferAt(logSourceStorage,128)
    val path=nativeBufferAt(nativeStaticBytes("C:\\src/main.ab"),14)
    val functionName=nativeBufferAt(nativeStaticBytes("run"),3)
    val message=nativeBufferAt(nativeStaticBytes("hi"),2)
    var profile=0
    while (profile < 6) {
        val number=if (profile == 0) 0 else if (profile == 1) 9 else if (profile == 2) 10 else if (profile == 3) 999999 else if (profile == 4) 1000000 else 4294967295
        val expectedAddress=if (profile == 0) nativeStaticBytes("[     0][I][main.ab:0] run(): hi") else if (profile == 1) nativeStaticBytes("[     9][I][main.ab:9] run(): hi") else if (profile == 2) nativeStaticBytes("[    10][I][main.ab:10] run(): hi") else if (profile == 3) nativeStaticBytes("[999999][I][main.ab:999999] run(): hi") else if (profile == 4) nativeStaticBytes("[1000000][I][main.ab:1000000] run(): hi") else nativeStaticBytes("[4294967295][I][main.ab:4294967295] run(): hi")
        val length=if (profile < 2) 32 else if (profile == 2) 33 else if (profile == 3) 37 else if (profile == 4) 39 else 45
        val expected=nativeBufferAt(expectedAddress,length)
        var level=1
        while (level <= 5) {
            var i=0
            while (i < 128) { output.store(i,0xa5);i=i+1 }
            if (logSourceFormat(level,number,path,14,number,functionName,3,message,2,output) != length) return 1
            val letterPosition=(if (profile < 4) 6 else if (profile == 4) 7 else 10)+3
            i=0
            while (i < length) {
                val byte=if (i != letterPosition) expected.load(i) else if (level == 1) 69 else if (level == 2) 87 else if (level == 3) 73 else if (level == 4) 68 else 86
                if (output.load(i) != byte) return 2
                i=i+1
            }
            if (output.load(length) != 0xa5) return 3
            i=0
            while (i < 128) { output.store(i,0xa5);i=i+1 }
            if (logSourceFormat(level,number,path,14,number,functionName,3,message,2,nativeBufferAt(output.addressValue(),length-1)) != -1) return 4
            i=0
            while (i < 128) { if (output.load(i) != 0xa5) return 5;i=i+1 }
            level=level+1
        }
        profile=profile+1
    }
    if (logSourceFormat(0,0,path,14,0,functionName,3,message,2,output) != -1 ||
        logSourceFormat(1,4294967296,path,14,0,functionName,3,message,2,output) != -1 ||
        logSourceFormat(1,0,path,14,0,functionName,4,message,2,output) != -1 ||
        logSourceFormat(1,0,output,14,0,functionName,3,message,2,output) != -1) return 6
    var i=0
    while (i < 128) { if (output.load(i) != 0xa5) return 7;i=i+1 }
    // Reserved bits, negative values, and impossible completion masks rejected.
    i=-1
    while (i <= 512) {
        val expected=i >= 0 && i <= 63 && (((i>>>3)&7)&~(i&7)) == 0
        if (LogWriteResult(i).valid() != expected || (!expected && LogWriteResult(i).succeeded())) return 8
        i=i+1
    }
    return 0
}
