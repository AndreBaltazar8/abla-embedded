import "../src/display/dsi_worker_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val boxStorage=nativeStaticAllocate(28)
val gateStorage=nativeStaticAllocate(4)
val descStorage=nativeStaticAllocate(64)
val frameStorage=nativeStaticAllocate(64)
var masked=false
var enabled=u32(3)
var raw=u32(0)
var report=1
var action=0
var calls=0
var bad=false
fun p4DsiMailboxCore(): int = 0
fun p4DsiMailboxMasked(): bool = masked
fun p4DsiWorkerMask(): u32 { val old=if (masked) u32(0) else u32(8); masked=true; return old }
fun p4DsiWorkerRestore(saved: u32): void { if ((saved&u32(8)) != u32(0)) masked=false; return }
fun p4DsiBridgeRead(offset: int): u32 = if (offset == 80) enabled else raw&enabled
fun p4DsiBridgeWrite(offset: int,value: u32): void {
    if (!masked) bad=true
    if (offset == 80) enabled=value else raw=raw&(u32(4294967295)^value)
    return
}
trusted fun p4DsiWorkerRearm(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): int {
    calls=calls+1
    if (masked) bad=true
    if (action == 1) {
        masked=true; enabled=u32(3); raw=u32(1)
        p4DsiMailboxAt(nativeBufferAt(boxStorage,28)).captureOwned(16,0)
        masked=false
    }
    if (action == 2 && serviceGateAt(gateStorage).requestStop(1) != 2) bad=true
    return report
}
trusted fun initializeWorker(): void {
    p4DsiMailboxAt(nativeBufferAt(boxStorage,28)).initialize(0,3,16)
    nativeBufferAt(gateStorage,4).storeU32(0,0)
    masked=false; enabled=u32(3); raw=u32(0); calls=0; action=0; report=1
    return
}
trusted fun pollWorker(): P4DsiWorkerResult = esp32P4DsiWorkerPollOwned(p4DsiMailboxAt(nativeBufferAt(boxStorage,28)),
    serviceGateAt(gateStorage),u32(7),0,nativeBufferAt(descStorage,64),nativeBufferAt(frameStorage,64),64,64,2)
trusted fun injectEvent(bits: int): void {
    masked=true; raw=u32(bits)
    p4DsiMailboxAt(nativeBufferAt(boxStorage,28)).captureOwned(16,0)
    masked=false; return
}
@export("abla_dsi_p4_worker_test")
trusted fun testWorker(): i32 {
    initializeWorker()
    if (pollWorker().service() != 1 || calls != 1 || masked) return i32(1)
    injectEvent(2)
    val normal=pollWorker()
    if (normal.status() != 0 || normal.events() != 2 || normal.service() != 1 || enabled != u32(3) || masked) return i32(2)
    initializeWorker(); injectEvent(1)
    if (pollWorker().status() != 3 || calls != 0 || nativeBufferAt(gateStorage,4).loadU32(0) != 2147483648 || masked) return i32(3)
    initializeWorker(); action=1
    if (pollWorker().status() != 3 || calls != 1 || nativeBufferAt(boxStorage,28).loadU32(20) != 1 || masked) return i32(4)
    initializeWorker(); injectEvent(2); action=2
    if (pollWorker().status() != 0 || enabled != u32(0) || nativeBufferAt(gateStorage,4).loadU32(0) != 2147483648) return i32(5)
    var outcome=0
    while (outcome < 10) {
        initializeWorker(); report=131072|outcome
        val result=pollWorker()
        val healthy=outcome == 0 || outcome == 1 || outcome == 3
        if (result.status() != 0 || result.service() != report || nativeBufferAt(gateStorage,4).loadU32(0) !=
            (if (healthy) 0 else 2147483648) || masked) return i32(6)
        outcome=outcome+1
    }
    initializeWorker(); masked=true
    if (pollWorker().status() != 1 || calls != 0 || !masked) return i32(7)
    masked=false; serviceGateAt(gateStorage).requestStop(1)
    if (pollWorker().status() != 2 || calls != 0 || bad) return i32(8)
    return i32(0)
}
