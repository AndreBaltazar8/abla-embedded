import "../src/m5stack/button_touch_frame.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_button_frame_target")
fun buttonTarget(frame: M5ButtonFrame,touch: M5TouchButtons,index: int,value: M5ButtonRead): M5ButtonRead =
    frame.withRead(index,value).withTouch(touch).read(index)
