import "../src/hal/esp32_i2c.ab"
import "../src/esp32/i2c/poll_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2c/poll_c5_sequence.ab"
@export("abla_c5_i2c_poll_target")
