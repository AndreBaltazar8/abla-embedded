import "../src/esp32/ldo_pmu_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_ldo_pmu_target")
trusted fun target(channel: int,millivolts: int,revision: int,stop: bool): int {
    if (millivolts == -1) return Esp32P4LdoOwner(channel).closeOwned()|0
    if (millivolts == -2) return esp32P4LdoOpenOwned(channel,2500,revision)|0
    if (stop) return esp32P4LdoStop(channel,revision)
    esp32P4LdoStart(channel,millivolts,revision)
}
