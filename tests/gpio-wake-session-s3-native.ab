import "../src/esp32/gpio/wake_session_s3_sequence.ab"
import "abla/build"
val sessionMemory=nativeStaticAllocate(40)
var sessionPin=48
var sessionPad=0
var sessionTrigger=0
var originalPad=0
var originalTrigger=0
var sessionWrites=0
var sessionDrop=0
var sessionBad=false
fun s3GpioWakeRead(address: int): int {
    if (address == 0x6000803c) return sessionTrigger
    if (address != 0x60004074+sessionPin*4) sessionBad=true
    return sessionPad
}
fun s3GpioWakeWrite(address: int,value: int): void {
    sessionWrites=sessionWrites+1
    if (address == 0x6000803c) {
        if (((value^originalTrigger)&(~0x20000)) != 0) sessionBad=true
        if (sessionWrites != sessionDrop) sessionTrigger=value
    } else {
        if (address != 0x60004074+sessionPin*4 || (sessionTrigger&0x20000) != 0 || ((value^originalPad)&(~0x780)) != 0) sessionBad=true
        if (sessionWrites != sessionDrop) sessionPad=value
    }
    return
}
fun seedSession(r: NativeBuffer,pin: int,on: bool): void {
    sessionPin=pin;sessionPad=0xa5a01f84;originalPad=sessionPad
    sessionTrigger=0xa5a01234|(if (on) 0x20000 else 0);originalTrigger=sessionTrigger
    sessionWrites=0;sessionDrop=0;sessionBad=false
    var offset=0
    while (offset < 32) { r.storeU32(offset,0);offset=offset+4 }
    r.storeU32(32,0x12345678);return
}
fun restoredSession(r: NativeBuffer): bool = !sessionBad && sessionPad == originalPad && sessionTrigger == originalTrigger && r.loadU32(32) == 0x12345678
@export("abla_gpio_wake_session_s3_test")
fun gpioWakeSessionTest(): int {
    val r=nativeBufferAt(sessionMemory,36)
    var pin=0
    while (pin < 49) {
        if (pin < 22 || pin > 25) {
            var profile=0
            while (profile < 4) {
                seedSession(r,pin,(profile&1) != 0)
                if (esp32S3GpioWakeSessionOpenOwned(r,pin,profile >= 2,true) != 1 || (sessionTrigger&0x20000) == 0 || (sessionPad&0x780) != (if (profile >= 2) 0x680 else 0x600)) return 1
                if (esp32S3GpioWakeSessionCloseOwned(r,true) != 8 || !restoredSession(r)) return 2
                val writes=sessionWrites
                if (esp32S3GpioWakeSessionCloseOwned(r,true) != 8 || sessionWrites != writes) return 3
                profile=profile+1
            }
        }
        pin=pin+1
    }
    var fault=1
    while (fault <= 5) {
        seedSession(r,48,true);sessionDrop=fault
        val result=esp32S3GpioWakeSessionOpenOwned(r,48,false,true)
        if (result != (if (fault == 1) 3 else if (fault == 5) 5 else 4) || r.loadU32(8) != result) return 4
        sessionDrop=0
        if (esp32S3GpioWakeSessionCloseOwned(r,true) != 8 || !restoredSession(r) || r.loadU32(8) != result) return 5
        seedSession(r,48,true)
        if (esp32S3GpioWakeSessionOpenOwned(r,48,false,true) != 1) return 6
        sessionDrop=sessionWrites+fault
        if (esp32S3GpioWakeSessionCloseOwned(r,true) != 9) return 7
        sessionDrop=0
        if (esp32S3GpioWakeSessionCloseOwned(r,true) != 8 || !restoredSession(r) || r.loadU32(12) != 0) return 8
        fault=fault+1
    }
    seedSession(r,48,true);sessionPad=sessionPad|0x2000;originalPad=sessionPad
    if (esp32S3GpioWakeSessionOpenOwned(r,48,false,true) != 4 || esp32S3GpioWakeSessionCloseOwned(r,true) != 8 || !restoredSession(r)) return 9
    seedSession(r,48,true)
    if (esp32S3GpioWakeSessionOpenOwned(r,22,false,true) != 2 || esp32S3GpioWakeSessionOpenOwned(r,48,false,false) != 2 || esp32S3GpioWakeSessionOpenOwned(nativeBufferAt(sessionMemory,28),48,false,true) != 2 || sessionWrites != 0 || r.loadU32(0) != 0) return 10
    return 0
}
