import "../src/m5stack/detect_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var identity=u32(0)
var reads=0
var pins=0
var high32=0
var high0=0
fun m5P4ReadIdentity(): u32 { reads=reads+1; identity }
fun m5P4DetectReadPin(pin: int): int { pins=pins+1; if (pin == 32) high32 else high0 }
@export("abla_board_detect_p4_test")
fun detectTest(): i32 {
    var major=0
    while (major < 8) {
        var minor=0
        while (minor < 16) {
            var bit=0
            while (bit < 32) {
                identity=u32(((major&3)<<4)|((major>>2)<<23)|minor|((1<<bit)&~0x80003F))
                if (esp32P4RevisionFromEfuse(identity) != major*100+minor) return i32(1)
                high32=-1
                while (high32 <= 2) {
                    high0=-1
                    while (high0 <= 2) {
                        reads=0; pins=0
                        val result=m5DetectCurrentEsp32P4Prepared(m5BoardUnknown,true)
                        var expected=m5BoardUnknown
                        var expectedReads=0
                        if (high32 == 1) { expected=if (major >= 3) m5BoardTab5X else m5BoardTab5; expectedReads=1 }
                        if (high32 == 0 && high0 == 1) expected=m5BoardUnitPoEP4
                        if (high32 == 0 && high0 == 0) { expected=if (major >= 3) m5BoardStampP4X else m5BoardStampP4; expectedReads=1 }
                        if (result != expected || reads != expectedReads || pins != (if (high32 == 0) 2 else 1)) return i32(2)
                        high0=high0+1
                    }
                    high32=high32+1
                }
                bit=bit+1
            }
            minor=minor+1
        }
        major=major+1
    }
    var selected=-1
    while (selected <= 513) {
        reads=0; pins=0
        if (m5DetectCurrentEsp32P4Prepared(M5BoardId(selected),false) != M5BoardId(selected) || reads != 0 || pins != 0) return i32(3)
        if (M5BoardId(selected) != m5BoardUnknown && m5DetectCurrentEsp32P4Prepared(M5BoardId(selected),true) != M5BoardId(selected)) return i32(4)
        if (reads != 0 || pins != 0) return i32(5)
        selected=selected+1
    }
    i32(0)
}
