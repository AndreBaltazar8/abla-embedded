import "../src/esp32/mspi_clock_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(48)
var core=0
var flash0=0
var flash1=0
var psram=0
var ready=13
var writes=0
var failAt=0
var spi1Owned=false
var psramOwned=false
var bad=false
trusted fun c5MspiRead(address: int): int {
    if (address == 0x60096018) return ready
    if (address == 0x6009601c) return core
    if (address == 0x60002014) return flash0
    if (address == 0x60003014) { if (!spi1Owned) bad=true;return flash1 }
    if (address == 0x60002050) { if (!psramOwned) bad=true;return psram }
    bad=true;return 0
}
trusted fun c5MspiWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (address == 0x6009601c) core=value
    else if (address == 0x60002014) flash0=value
    else if (address == 0x60003014) { if (!spi1Owned) bad=true;flash1=value }
    else if (address == 0x60002050) { if (!psramOwned) bad=true;psram=value }
    else bad=true
    return
}
@export("abla_mspi_clock_c5_test")
trusted fun test(): i32 {
    var divider=1
    while (divider <= 256) {
        val bits=esp32C5MspiDividerBits(divider)
        if (bits != (if (divider == 1) 0x80000000 else ((divider-1)<<16)|(((divider-1)/2)<<8)|(divider-1))) return i32(1)
        var cpu=1
        while (cpu <= 240) {
            if (esp32C5PsramCpuSafe(120,divider,cpu) != (cpu*8*divider >= 120) ||
                esp32C5PsramCpuSafe(80,divider,cpu) != (cpu*8*divider >= 80)) return i32(2)
            cpu=cpu+1
        }
        divider=divider+1
    }
    if (esp32C5MspiDividerBits(3) != 0x020102 || esp32C5MspiDividerBits(0) != -1 || esp32C5MspiDividerBits(257) != -1 ||
        esp32C5MspiFrequencyBits(120,50) != -1 || esp32C5MspiFrequencyBits(80,40) != 0x010001 ||
        esp32C5PsramCpuSafe(120,1,14) || !esp32C5PsramCpuSafe(120,1,15)) return i32(3)
    val record=nativeBufferAt(memory,48)
    var mode=0
    while (mode < 16) {
        val mhz=if ((mode&1) == 0) 80 else 120
        spi1Owned=(mode&2) != 0;psramOwned=(mode&4) != 0
        var failure=0
        while (failure < 9) {
            record.storeU32(0,0);core=0x12340603;flash0=0x55030303;flash1=0x22030303;psram=0x11010101
            ready=13;writes=0;failAt=failure;bad=false
            val applied=esp32C5MspiClocksOwned(record,mhz,40,if (psramOwned) 20 else 0,spi1Owned,true)
            if (applied != 1 && applied != 3) return i32(4)
            if ((mode&8) == 0) {
                failAt=0
                if (esp32C5MspiClocksOwned(record,mhz,40,if (psramOwned) 20 else 0,spi1Owned,true) != 1 ||
                    (core&255) != (if (mhz == 80) 5 else 3) || (flash0&0x80ffffff) != esp32C5MspiFrequencyBits(mhz,40)) return i32(5)
                // Exercise every reverse stage independently of apply retries.
                failAt=writes+failure
            }
            core=core^0x10000;flash0=flash0^0x40000000;flash1=flash1^0x40000000;psram=psram^0x40000000
            val first=esp32C5MspiClocksCloseOwned(record,true)
            if (first != 3 && first != 4) return i32(6)
            failAt=0
            if (esp32C5MspiClocksCloseOwned(record,true) != 4 || bad || core != (0x12340603^0x10000) ||
                flash0 != (0x55030303^0x40000000) || flash1 != (0x22030303^0x40000000) || psram != (0x11010101^0x40000000)) return i32(7)
            val before=writes
            if (esp32C5MspiClocksCloseOwned(record,true) != 4 || writes != before ||
                esp32C5MspiClocksOwned(record,mhz,40,if (psramOwned) 20 else 0,spi1Owned,true) != 2) return i32(8)
            failure=failure+1
        }
        mode=mode+1
    }
    record.storeU32(0,0);ready=11;writes=0
    if (esp32C5MspiClocksOwned(record,80,40,0,false,true) != 2 || record.loadU32(0) != 0 || writes != 0) return i32(9)
    ready=13;core=0x12340503
    if (esp32C5MspiClocksOwned(record,80,40,0,false,true) != 2 || writes != 0) return i32(10)
    core=0x12340603;spi1Owned=false;psramOwned=false
    if (esp32C5MspiClocksOwned(record,80,40,0,false,false) != 2 || writes != 0) return i32(11)
    if (esp32C5MspiClocksOwned(record,80,40,0,false,true) != 1) return i32(12)
    ready=11
    if (esp32C5MspiClocksCloseOwned(record,true) != 3 || esp32C5MspiClocksOwned(record,80,40,0,false,true) != 2) return i32(13)
    ready=13
    if (esp32C5MspiClocksCloseOwned(record,true) != 4) return i32(14)
    return i32(0)
}
