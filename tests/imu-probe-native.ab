import "../src/m5stack/imu_probe_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var candidate=0
var found=0
var allocateFail=-1
var releaseFail=-1
var allocated=0
var released=0
var bad=false
var identity=2
var capabilities=3
fun m5ImuProbeAllocate(bus: int,address: int): int {
    if (bus != 7 || address != (if (candidate < 2) 104 else if (candidate == 2) 105 else 108)) bad=true
    allocated=allocated+1
    if (allocateFail == candidate) 0 else candidate+1
}
fun m5ImuProbeBegin(handle: int,index: int): int {
    if (index != candidate || handle != candidate+1) bad=true
    if (candidate == found) capabilities else 0
}
fun m5ImuProbeMpuKind(handle: int): M5ImuKind {
    if (handle != 1 || candidate != 0) bad=true
    M5ImuKind(identity)
}
fun m5ImuProbeRelease(handle: int): bool {
    if (handle != candidate+1) bad=true
    released=released+1
    val okay=releaseFail != candidate
    candidate=candidate+1
    okay
}
@export("abla_imu_probe_test")
fun probeTest(): i32 {
    found=0
    while (found < 5) {
        candidate=0; allocated=0; released=0; bad=false
        val result=m5ImuProbeOwned(7)
        if (bad || result.status() != (if (found < 4) 1 else 2) || released != found ||
            allocated != (if (found < 4) found+1 else 4) ||
            result.handle() != (if (found < 4) found+1 else 0)) return i32(1)
        found=found+1
    }
    found=4
    var failure=0
    while (failure < 4) {
        allocateFail=failure; releaseFail=-1; candidate=0; allocated=0; released=0; bad=false
        val allocation=m5ImuProbeOwned(7)
        if (allocation.status() != 3 || allocation.handle() != 0 || allocated != failure+1 || released != failure || bad) return i32(2)
        allocateFail=-1; releaseFail=failure; candidate=0; allocated=0; released=0; bad=false
        val release=m5ImuProbeOwned(7)
        if (release.status() != 4 || release.handle() != failure+1 || allocated != failure+1 || released != failure+1 || bad) return i32(3)
        failure=failure+1
    }
    releaseFail=-1; found=0; identity=0; candidate=0; allocated=0; released=0; bad=false
    val unknown=m5ImuProbeOwned(7)
    if (unknown.ready() || unknown.status() != 2 || released != 4 || bad) return i32(4)
    var profile=0
    while (profile < 256) {
        val index=profile%4
        identity=profile/4%8; capabilities=profile/32%8
        candidate=index; found=index; allocated=0; released=0; bad=false
        val result=m5ImuProbeCandidateOwned(7,index)
        val expected=(capabilities == 3 && (index != 0 || (identity >= 1 && identity <= 3))) ||
            (capabilities == 7 && (index == 1 || index == 2))
        if (result.ready() != expected || result.status() != (if (expected) 1 else 2) ||
            released != (if (expected) 0 else 1) || allocated != 1 || bad) return i32(5)
        profile=profile+1
    }
    i32(0)
}
