import "../src/esp32/power/sleep_power_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(80)
var writes=0
var failAt=0
var bad=false
fun slot(offset: int): int = if (offset == 0x68) 0 else if (offset == 0x7c) 1 else if (offset == 0x98) 2 else
    if (offset == 0xa8) 3 else if (offset == 0xac) 4 else if (offset == 0xc0) 5 else if (offset == 0xc4) 6 else if (offset == 0xbc) 7 else -1
trusted fun c5SleepPowerRead(offset: int): int {
    val index=slot(offset);if (index < 0) { bad=true;return 0 }
    nativeBufferAt(memory+48,32).loadU32(index*4)
}
trusted fun c5SleepPowerWrite(offset: int,value: int): void {
    writes=writes+1
    if (slot(offset) < 0) { bad=true;return }
    if (writes != failAt) nativeBufferAt(memory+48,32).storeU32(slot(offset)*4,value)
    return
}
@export("abla_sleep_power_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,48);val registers=nativeBufferAt(memory+48,32)
    var flags=0
    while (flags < 1024) {
        record.storeU32(0,0);writes=0;failAt=0
        var i=0;while (i < 8) { registers.storeU32(i*4,0xdeadbeef);i=i+1 }
        if (esp32C5SleepPowerApplyOwned(record,C5SleepPower(flags),true) != 1 || writes != 8) return i32(1)
        var hp=0
        if ((flags&1) != 0) hp=hp|0x00200000
        if ((flags&2) != 0) hp=hp|0x08000000
        if ((flags&4) != 0) hp=hp|0x20000000
        if ((flags&8) != 0) hp=hp|0x40000000
        if ((flags&16) != 0) hp=hp|0x80000000
        if (registers.loadU32(0) != (hp|0x000dbeef) || registers.loadU32(4) != 0x8eadbeef ||
            (registers.loadU32(8)>>>31) != (if ((flags&32) == 0) 1 else 0) ||
            (registers.loadU32(12)>>>30) != 0 || (registers.loadU32(20)>>>30) != (if ((flags&64) == 0) 0 else 2)) return i32(2)
        val oscillators=(if ((flags&128) == 0) 1 else 0)|(if ((flags&256) == 0) 2 else 0)
        if ((registers.loadU32(16)>>>28) != (oscillators|4) ||
            (registers.loadU32(24)>>>28) != (oscillators|(if ((flags&512) == 0) 4 else 0))) return i32(3)
        if (esp32C5SleepPowerCloseOwned(record,true) != 4 || bad) return i32(4)
        i=0;while (i < 8) { if (registers.loadU32(i*4) != 0xdeadbeef) return i32(5);i=i+1 }
        flags=flags+1
    }
    var fault=1
    while (fault <= 16) {
        record.storeU32(0,0);writes=0;failAt=fault
        esp32C5SleepPowerApplyOwned(record,C5SleepPower(0),true)
        esp32C5SleepPowerCloseOwned(record,true);failAt=0
        if (esp32C5SleepPowerCloseOwned(record,true) != 4 || bad) return i32(6)
        var i=0;while (i < 8) { if (registers.loadU32(i*4) != 0xdeadbeef) return i32(7);i=i+1 }
        fault=fault+1
    }
    writes=0
    if (esp32C5SleepPowerApplyOwned(record,C5SleepPower(1024),true) != 2 || writes != 0) return i32(8)
    return i32(0)
}
