import "../src/esp32/psram/boot80_s3_sequence.ab"
import "abla/build"
val bMemory=nativeStaticAllocate(676)
val bCounts=nativeStaticAllocate(44)
var bFail=0
var bError=4
var bBad=false
fun s3PsramCacheGeometryRead(address: int): int { bBad=true;return 0 }
fun s3PsramCacheGeometryOccupy(low: int,high: int): void { bBad=true;return }
fun s3PsramCacheGeometryMode(size: int,ways: int,line: int): void { bBad=true;return }
fun s3PsramCacheGeometryInvalidate(): void { bBad=true;return }
fun s3PsramCommandStorageSafe(address: int,length: int): bool = address == bMemory && length == 676
fun s3FlashLegacyPointer(): int = 0x3fc90000
fun s3FlashLegacyPointerValid(p: int): bool = p == 0x3fc90000
fun bEnter(stage: int): int {
    if (nativeAddressLoadU32(bMemory,4) != stage) bBad=true
    nativeAddressStoreU32(bCounts,stage*4,nativeAddressLoadU32(bCounts,stage*4)+1)
    return if (bFail == stage) bError else 1
}
fun s3PsramCacheMappingBeginOwned(r: NativeBuffer,proof: bool): int {
    if (r.addressValue() != bMemory+64 || !proof) bBad=true
    return bEnter(1)
}
fun s3PsramColdOwned(r: NativeBuffer,s: NativeBuffer,w: NativeBuffer,address: int,octal: bool,base: int,cold: bool,pll: bool,proof: bool): int {
    if (r.addressValue() != bMemory+96 || s.addressValue() != bMemory+532 || w.addressValue() != bMemory+540 || address != 0 || octal || base != 5 || !cold || !pll || !proof) bBad=true
    r.storeU32(48,0x302);return bEnter(2)
}
fun s3PsramBootPhysicalBytes(cold: NativeBuffer): int {
    if (cold.addressValue() != bMemory+96) bBad=true
    return if (bEnter(3) == 1) 4194304 else 0
}
fun s3PsramCalibrate80Owned(r: NativeBuffer,address: int,capacity: int,repetitions: int,octal: bool,base: int,o0: int,o1: int,pll: bool,proof: bool): int {
    if (r.addressValue() != bMemory+160 || address != 0 || capacity != 4194304 || repetitions != 3 || octal || base != 5 || o0 != 2 || o1 != 3 || !pll || !proof) bBad=true
    return bEnter(4)
}
fun s3PsramCalibratedFinal80Owned(r: NativeBuffer,mhz: int,profile: int,timing: int,pll: bool,proof: bool): int {
    if (r.addressValue() != bMemory+160 || mhz != 80 || profile != 0 || timing != 0 || !pll || !proof) bBad=true
    return bEnter(5)
}
fun s3PsramMmuMapOwned(r: NativeBuffer,virtual: int,physical: int,bytes: int,capacity: int,proof: bool): int {
    if (r.addressValue() != bMemory+640 || r.capacity() != 36 || virtual != 0x3c100000 || physical != 0 || bytes != 65536 || capacity != 4194304 || !proof) bBad=true
    return bEnter(6)
}
fun s3PsramCacheBusOpenOwned(r: NativeBuffer,proof: bool): int {
    if (r.addressValue() != bMemory+500 || !proof) bBad=true
    return bEnter(7)
}
fun s3PsramCacheMappingEndOwned(r: NativeBuffer,proof: bool): int {
    if (r.addressValue() != bMemory+64 || !proof) bBad=true
    val result=bEnter(8);return if (result == 1) 5 else result
}
fun s3PsramCacheActivateOwned(r: NativeBuffer,proof: bool): int {
    if (r.addressValue() != bMemory+516 || !proof) bBad=true
    return bEnter(9)
}
fun s3PsramMappedVerifyOwned(c: NativeBuffer,m: NativeBuffer,proof: bool): int {
    if (c.addressValue() != bMemory+160 || m.addressValue() != bMemory+640 || !proof) bBad=true
    return bEnter(10)
}
fun bRun(): int = s3PsramBoot80Owned(nativeBufferAt(bMemory,676),0x3c100000,65536,4194304,80,0,0,5,3,true)
@export("abla_s3_psram_boot80_test")
fun testBoot80(): int {
    if (!s3PsramBootOwnerAvoidsCache(0x3fcf0000-676,676) || s3PsramBootOwnerAvoidsCache(0x3fcf0000-675,676) ||
        s3PsramBootOwnerAvoidsCache(0x3fcf0000,676) || s3PsramBootOwnerAvoidsCache(0x3fcfffff,1) ||
        s3PsramBootOwnerAvoidsCache(4294967295,2)) return 6
    val r=nativeBufferAt(bMemory,676)
    var fail=1
    while (fail <= 10) {
        bError=2
        while (bError <= 4) {
            r.storeU32(0,0);bBad=false;bFail=fail
            var i=0
            while (i < 44) { nativeBufferAt(bCounts,44).store(i,0);i=i+1 }
            val expected=if (fail == 3) 6 else bError
            if (bRun() != expected || r.loadU32(4) != fail || r.loadU32(40) != expected || bBad) return 1
            bFail=0
            if (bRun() != 1 || r.loadU32(4) != 11 || r.loadU32(40) != 0 || bRun() != 1 || bBad) return 2
            i=1
            while (i <= 10) {
                if (nativeAddressLoadU32(bCounts,i*4) != (if (i == fail) 2 else 1)) return 3
                i=i+1
            }
            if (s3PsramBoot80Owned(r,0x3c100000,65536,4194304,40,0,0,5,3,true) != 2) return 4
            bError=bError+1
        }
        fail=fail+1
    }
    r.storeU32(0,0)
    if (s3PsramBoot80Owned(r,0x3c100000,65536,4194304,80,0,0,5,3,false) != 2 || r.loadU32(0) != 0 ||
        s3PsramBoot80Owned(r,0x3dff0000,131072,4194304,80,0,0,5,3,true) != 2 || r.loadU32(0) != 0 ||
        s3PsramBoot80Owned(nativeBufferAt(bMemory,675),0x3c100000,65536,4194304,80,0,0,5,3,true) != 2 || r.loadU32(0) != 0) return 5
    return 0
}
