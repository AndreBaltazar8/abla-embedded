import "../src/sd/spi_protocol.ab"
import "abla/runtime/scalar"
import "abla/build"

trusted fun sdProtocolTest(): int {
    if (sdSpiCommandFrameCrc(0, 0) != 149) return 1
    if (sdSpiCommandFrameCrc(8, 426) != 135) return 2
    if (sdSpiCommandFrameCrc(58, 0) != 253) return 3
    var crc = 0
    var value = 49
    while (value <= 57) {
        crc = sdSpiCrc16Byte(crc, value)
        value = value + 1
    }
    if (crc != 12739) return 4
    crc = 0
    value = 0
    while (value < 512) {
        crc = sdSpiCrc16Byte(crc, 255)
        value = value + 1
    }
    if (crc != 32673) return 5
    if (!sdSpiBlockAddressValid(false, 8388607) || sdSpiBlockAddressValid(false, 8388608)) return 6
    if (!sdSpiBlockAddressValid(true, 4294967295) || sdSpiBlockAddressValid(true, 4294967296)) return 7
    if (sdSpiBlockAddressValid(true, -1) || sdSpiBlockAddressValid(false, -1)) return 8
    value = -256
    while (value <= 511) {
        if (sdSpiR1Available(value) != (value >= 0 && value <= 127)) return 9
        if (sdSpiWriteAccepted(value) != (value >= 0 && value <= 255 && (value & 31) == 5)) return 10
        value = value + 1
    }
    0
}
#exportFunction("sdProtocolTest", "abla_sd_protocol_test")
