import "../src/log_serial.ab"
import "abla/runtime/scalar"
import "abla/build"
type SerialPort = int
val storage=nativeStaticAllocate(128)
var attempts=0
var count=0
var fail=0
var permanent=false
trusted fun SerialPort.tryWriteByte(value: int,polls: int): bool {
    attempts=attempts+1
    if (attempts == fail || (permanent && attempts >= fail)) return false
    nativeBufferAt(storage+32,96).store(count,value)
    count=count+1
    return true
}
@export("abla_log_serial_test")
trusted fun test(): i32 {
    val text=nativeBufferAt(storage,2)
    val suffix=nativeBufferAt(storage+2,2)
    val output=nativeBufferAt(storage+32,96)
    text.store(0,65); text.store(1,0); suffix.store(0,13); suffix.store(1,10)
    var level=0
    while (level <= 5) {
        count=0; attempts=0
        if (!logSerialRenderOwned(SerialPort(0),level,true,text,2,suffix,2,5)) return i32(1)
        if (level == 0) {
            if (count != 4 || output.load(0) != 65 || output.load(1) != 0 || output.load(2) != 13 || output.load(3) != 10) return i32(2)
        } else {
            if (count != 15 || output.load(0) != 27 || output.load(1) != 91 || output.load(3) != 59 || output.load(4) != 51 || output.load(5) != logSerialColor(level)+18 || output.load(6) != 109 || output.load(7) != 65 || output.load(8) != 0 || output.load(9) != 27 || output.load(12) != 109 || output.load(13) != 13 || output.load(14) != 10) return i32(3)
        }
        level=level+1
    }
    fail=1
    while (fail <= 15) {
        attempts=0; count=0
        if (logSerialRenderOwned(SerialPort(0),1,true,text,2,suffix,2,5)) return i32(4)
        val expected=if (fail <= 9) fail+4 else if (fail <= 13) 13 else fail
        if (attempts != expected) return i32(5)
        fail=fail+1
    }
    fail=8; permanent=true; count=0; attempts=0
    if (logSerialRenderOwned(SerialPort(0),1,true,text,2,suffix,2,5) || attempts != 12) return i32(6)
    attempts=0
    if (logSerialRenderOwned(SerialPort(0),6,true,text,2,suffix,2,5) || logSerialRenderOwned(SerialPort(0),1,true,text,3,suffix,2,5) || logSerialRenderOwned(SerialPort(0),1,true,text,2,suffix,2,0) || attempts != 0) return i32(7)
    return i32(0)
}
