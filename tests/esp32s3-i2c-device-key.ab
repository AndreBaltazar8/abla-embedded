import "../src/esp32/i2c/device_s3_logic.ab"

fun main(): int {
    var port = 0
    while (port <= 1) {
        var address = 0
        while (address <= 127) {
            val bus = esp32S3I2cBusKey(port, 2147483647)
            val key = esp32S3I2cDeviceKey(port, address, 1000000, 2147483647)
            if (!esp32S3I2cDeviceKeyMatchesBus(key, bus)) return 1
            if (esp32S3I2cDeviceKeyAddress(key) != address || esp32S3I2cDeviceKeyFrequency(key) != 1000000) return 2
            if (esp32S3I2cDeviceKeyMatchesBus(key, esp32S3I2cBusKey(port, 1))) return 3
            if (esp32S3I2cDeviceKeyMatchesBus(key, esp32S3I2cBusKey(1 - port, 2147483647))) return 4
            if (esp32S3I2cDeviceKeyValid(key | (1 << 60)) || esp32S3I2cDeviceKeyValid(key & ~1)) return 5
            address = address + 1
        }
        port = port + 1
    }
    if (esp32S3I2cBusKey(-1, 1) != 0 || esp32S3I2cBusKey(2, 1) != 0 ||
        esp32S3I2cBusKey(0, 0) != 0 || esp32S3I2cBusKey(0, 2147483648) != 0) return 6
    if (esp32S3I2cBusKeyValid(3) || esp32S3I2cBusKeyValid(-1) || esp32S3I2cBusKeyValid(1 << 33)) return 7
    if (esp32S3I2cDeviceKey(0, -1, 1, 1) != 0 || esp32S3I2cDeviceKey(0, 128, 1, 1) != 0 ||
        esp32S3I2cDeviceKey(0, 0, 0, 1) != 0 || esp32S3I2cDeviceKey(0, 0, 1000001, 1) != 0) return 8
    if (!esp32S3I2cDeviceKeyValid(esp32S3I2cDeviceKey(0, 0, 1, 1))) return 9
    0
}
