// Regression cases for the lower-abla-owned-addresses pass: each expectation is what the original Python tool
// produced for the same fixture (see the commit message of the port).
import "abla/io"
import "abla/test"
import "abla/text"
import "../tools/lower-abla-owned-symbol-addresses.ab"


fun main: int {
    expectEqual(abLowerSource("// Original ABI symbol: wifi_foo\ntrusted fun esp32Foo(): void {}\n// Original section-local ABI symbol: .text.sec_fn\n@naked\n// note\ntrusted fun esp32SecFn(): void {}\nval barLink = #internalFunction(\"esp32Bar\", \"bar_sym\")\ntrusted fun esp32Bar(): void {}\nval aliasLink = #exportFunction(\"abc_local_text_handler\", \"sym_handler\")\nval esp32Data_x_dd_dd_1 = 1\nval esp32Data_y = 2\nfun use(): u32 = \$xtensa address {wifi_foo} + \$xtensa address {unknown} + \$xtensa address {{ bar_sym }} + \$xtensa address {.text.sec_fn}\nfun alias(): u32 = \$xtensa address {.text.handler} + \$xtensa address {dd} + \$xtensa address {y}\n").text, "import \"abla/unsafe/native\"\n// Original ABI symbol: wifi_foo\ntrusted fun esp32Foo(): void {}\n// Original section-local ABI symbol: .text.sec_fn\n@naked\n// note\ntrusted fun esp32SecFn(): void {}\nval barLink = #internalFunction(\"esp32Bar\", \"bar_sym\")\ntrusted fun esp32Bar(): void {}\nval aliasLink = #exportFunction(\"abc_local_text_handler\", \"sym_handler\")\nval esp32Data_x_dd_dd_1 = 1\nval esp32Data_y = 2\nfun use(): u32 = u32(nativeFunctionAddress(esp32Foo)) + \$xtensa address {unknown} + u32(nativeFunctionAddress(esp32Bar)) + u32(nativeFunctionAddress(esp32SecFn))\nfun alias(): u32 = u32(nativeFunctionAddress(sym_handler)) + esp32Data_x_dd_dd_1 + \$xtensa address {y}\n", "owned addresses")
    expectEqual(abLowerSource("// Original ABI symbol: wifi_foo\ntrusted fun esp32Foo(): void {}\n// Original section-local ABI symbol: .text.sec_fn\n@naked\n// note\ntrusted fun esp32SecFn(): void {}\nval barLink = #internalFunction(\"esp32Bar\", \"bar_sym\")\ntrusted fun esp32Bar(): void {}\nval aliasLink = #exportFunction(\"abc_local_text_handler\", \"sym_handler\")\nval esp32Data_x_dd_dd_1 = 1\nval esp32Data_y = 2\nfun use(): u32 = \$xtensa address {wifi_foo} + \$xtensa address {unknown} + \$xtensa address {{ bar_sym }} + \$xtensa address {.text.sec_fn}\nfun alias(): u32 = \$xtensa address {.text.handler} + \$xtensa address {dd} + \$xtensa address {y}\n").functions, 4, "owned counts")
    expectEqual(abLocalKey(".text.foo\$part\$bar.Baz"), "foo_part_bar_baz", "local key")
    expectEqual(abDataIdentifier(".Labla_x.y"), "esp32Data_Labla_x_y_71193d07a4", "data identifier")
    expectEqual(abDataIdentifier("9a"), "esp32Data_data_9a_e8eef065fb", "data identifier digit")
    if (testsPassed() != 0) return 1
    println("PASS: lower-abla-owned-addresses matches the original Python tool on the fixtures")
    0
}
