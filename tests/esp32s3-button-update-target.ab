import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/button_poll.ab"
import "../src/m5stack/button_touch_frame.ab"
import "../src/m5stack/button_state.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_button_update_target")
trusted fun updateTarget(board: M5BoardId,pi4: Pi4Ioe5v6408,pm1: M5Pm1,powerHub: I2cDevice,
    touch: M5TouchButtons,button: M5Button,index: int,now: int): M5Button =
    button.updateFrame(board.pollButtonLevels(pi4,pm1,powerHub).withTouch(touch),index,now)
