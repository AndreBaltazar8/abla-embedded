        reg(0,sdMmcS3Read(0)&~4)
        if (sdMmcWritePollOwned(writer,u32(7)) != 2 || writer.load(4) != 5 || sdMmcWritePollOwned(writer,u32(8)) != 2 || writer.load(4) != 6 || sdMmcS3Read(40) != 0x12340000 || (sdMmcS3Read(44)&63) != 13) return i32(23)
        reg(44,0); reg(68,4); reg(48,if (mode < 4) 0x900 else 0x04000900)
        if (sdMmcWritePollOwned(writer,u32(9)) != (if (mode < 4) 1 else 5)) return i32(24)
        mode=mode+1
    }
    reset(true,0); card.storeU32(28,1)
    if (sdMmcWriteBeginOwned(writer,card,desc,payload,0,u32(0),100,true,false) != 3 || writes != 0) return i32(25)
    card.storeU32(48,4096)
    if (sdMmcWriteBeginOwned(writer,card,desc,payload,0,u32(0),100,true,true) != 10 || writes != 0) return i32(26)
    card.storeU32(48,8192)
    if (sdMmcWriteBeginOwned(writer,card,desc,payload,0,u32(0),100,true,true) != 10 || writes != 0) return i32(27)
    card.storeU32(48,0)
    if (sdMmcWriteBeginOwned(nativeBufferAt(storage+1,64),card,desc,payload,0,u32(0),100,true,true) != 3 || writes != 0) return i32(28)
    val scrPayload=nativeBufferAt(0x3fc89000,8)
    mode=0
    while (mode < 2) {
        reset(true,mode); card.storeU32(28,0x1234)
        if (sdMmcScrBeginOwned(writer,card,desc,scrPayload,u32(0),100,true) != 2 || (sdMmcS3Read(44)&63) != 55 || sdMmcS3Read(40) != 0x12340000 || sdMmcScrResultOwned(writer).valid()) return i32(29)
        reg(44,0); reg(68,4); reg(48,0x920)
        if (sdMmcScrPollOwned(writer,u32(1)) != 2 || writer.load(4) != 1 || sdMmcDmaS3Read(0x3fc88004) != 8) return i32(30)
        if (sdMmcScrPollOwned(writer,u32(2)) != 2 || sdMmcS3Read(44) != (0xa0002373|(mode<<16)) || sdMmcS3Read(32) != 8 || sdMmcS3Read(28) != 8 || sdMmcS3Read(40) != 0) return i32(31)
        reg(44,0); reg(68,12); reg(48,0x900); reg(140,258); sdMmcDmaS3Write(0x3fc88000,28)
        if (sdMmcScrPollOwned(writer,u32(3)) != 2 || writer.load(4) != 3 || sdMmcScrPollOwned(writer,u32(4)) != 2 || sdMmcScrPollOwned(writer,u32(5)) != 2) return i32(32)
        reg(0,sdMmcS3Read(0)&~4)
