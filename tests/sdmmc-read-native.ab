import "../src/sd/mmc_read_s3_sequence.ab"
import "../src/sd/mmc_write_s3_sequence.ab"
import "../src/sd/mmc_scr_s3_sequence.ab"
import "../src/sd/mmc_width_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val registers=nativeStaticAllocate(256)
val storage=nativeStaticAllocate(160)
val descriptorMemory=nativeStaticAllocate(16)
var writes=0
var drop=-1
var badAddress=false
var scrWord=0x03008502
trusted fun sdMmcS3Read(offset: int): int = nativeBufferAt(registers,256).loadU32(offset)
trusted fun sdMmcS3Write(offset: int,value: int): void {
    writes=writes+1
    if (offset != drop) nativeBufferAt(registers,256).storeU32(offset,if (offset == 68 || offset == 140) sdMmcS3Read(offset)&~value else value)
    return
}
trusted fun sdMmcDmaS3Read(address: int): int {
    if (address == 0x3fc89000) return scrWord
    if (address < 0x3fc88000 || address > 0x3fc8800c || (address&3) != 0) { badAddress=true; return 0 }
    return nativeBufferAt(descriptorMemory,16).loadU32(address-0x3fc88000)
}
trusted fun sdMmcDmaS3Write(address: int,value: int): void {
    if (address < 0x3fc88000 || address > 0x3fc8800c || (address&3) != 0) { badAddress=true; return }
    nativeBufferAt(descriptorMemory,16).storeU32(address-0x3fc88000,value)
    return
}
trusted fun reg(offset: int,value: int): void {
    nativeBufferAt(registers,256).storeU32(offset,value)
    return
}
trusted fun reset(high: bool,slot: int): void {
    var n=0
    while (n < 256) { nativeBufferAt(registers,256).store(n,0); n=n+1 }
    n=0
    while (n < 160) { nativeBufferAt(storage,160).store(n,0); n=n+1 }
    val card=nativeBufferAt(storage+64,80)
    card.storeU32(0,0x53444901); card.store(5,slot)
    card.storeU32(24,if (high) 0xc0ff8000 else 0x80ff8000)
    card.storeU32(60,if (high) 0x40000000 else 0)
    card.storeU32(56,if (high) 0x9003f else 0x903ff)
    card.storeU32(52,if (high) 0xffff0000 else 0xc0038000)
    writes=0; drop=-1; badAddress=false
    reg(68,0x10001)
    return
}
trusted fun begin(sector: int,now: u32,budget: int): int = sdMmcReadBeginOwned(nativeBufferAt(storage,48),nativeBufferAt(storage+64,80),nativeBufferAt(0x3fc88000,16),nativeBufferAt(0x3fc89000,512),sector,now,budget,true)
trusted fun cleanup(expected: int,now: u32): int {
    val ctx=nativeBufferAt(storage,48)
    if (sdMmcReadPollOwned(ctx,now) != 2 || ctx.load(4) != 4 || sdMmcReadPollOwned(ctx,now) != 2) return 1
    reg(0,sdMmcS3Read(0)&~4)
    reg(140,sdMmcS3Read(140)&~0x1e000)
    if (sdMmcReadPollOwned(ctx,now) != expected || sdMmcReadStatus(ctx) != expected) return 2
    val before=writes
    if (sdMmcReadPollOwned(ctx,now) != expected || writes != before) return 3
    return 0
}
@export("abla_sdmmc_read_test")
trusted fun test(): i32 {
    val ctx=nativeBufferAt(storage,48)
    // All six command/data/DMA event orders, both addressing modes and slots.
    var mode=0
    while (mode < 4) {
        var permutation=0
        while (permutation < 6) {
            reset((mode&1) != 0,mode>>1)
            if (begin(123,u32(0),100) != 2 || sdMmcReadPollOwned(ctx,u32(0)) != 2 || sdMmcS3Read(40) != (if ((mode&1) != 0) 123 else 62976) || sdMmcS3Read(44) != (0xa0002351|((mode>>1)<<16))) return i32(1)
            val first=permutation>>1
            val second=if ((permutation&1) == 0) (first+1)%3 else (first+2)%3
            val third=3-first-second
            var step=0
            while (step < 3) {
                val event=if (step == 0) first else if (step == 1) second else third
                if (event == 0) { reg(68,sdMmcS3Read(68)|4); reg(48,0x900); reg(44,sdMmcS3Read(44)&0x7fffffff) }
                if (event == 1) reg(68,sdMmcS3Read(68)|8)
                if (event == 2) reg(140,258)
                // Completion events alone cannot release a DMA-owned buffer.
                if (sdMmcReadPollOwned(ctx,u32(step+1)) != 2 || ctx.load(4) != 2) return i32(2)
                step=step+1
            }
            sdMmcDmaS3Write(0x3fc88000,28)
