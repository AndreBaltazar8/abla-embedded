        if (sdMmcWriteBeginOwned(writer,card,desc,payload,123,u32(0),100,true,true) != 2 || sdMmcReadPollOwned(ctx,u32(0)) != 3) return i32(18)
        if (sdMmcWritePollOwned(writer,u32(1)) != 2 || sdMmcS3Read(44) != (0xa0002758|(((mode>>1)&1)<<16)) || sdMmcS3Read(40) != (if ((mode&1) != 0) 123 else 62976)) return i32(19)
        reg(44,0); reg(48,0x900); reg(68,12); reg(140,258); sdMmcDmaS3Write(0x3fc88000,28)
