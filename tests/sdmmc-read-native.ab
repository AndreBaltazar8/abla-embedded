            reg(72,0)
            if (sdMmcReadPollOwned(ctx,u32(5)) != 2 || ctx.load(4) != 3 || ctx.load(7) != 1 || cleanup(1,u32(6)) != 0 || sdMmcS3Read(68) != 0x10001) return i32(4)
            permutation=permutation+1
        }
        mode=mode+1
    }
    var bit=0
    while (bit < 16) {
        if (((1<<bit)&0xbfc2) != 0) {
            reset(true,0); begin(0,u32(0),100); sdMmcReadPollOwned(ctx,u32(0))
            reg(68,0x1000d|(1<<bit))
            if (sdMmcReadPollOwned(ctx,u32(1)) != 2 || ctx.load(7) != 4 || cleanup(4,u32(2)) != 0 || (ctx.loadU32(24)&(1<<bit)) == 0) return i32(5)
        }
        bit=bit+1
    }
    bit=0
    while (bit < 10) {
        if (((1<<bit)&0x234) != 0) {
            reset(true,0); begin(0,u32(0),100); sdMmcReadPollOwned(ctx,u32(0)); reg(140,1<<bit)
            if (sdMmcReadPollOwned(ctx,u32(1)) != 2 || ctx.load(7) != 4 || cleanup(4,u32(2)) != 0) return i32(6)
        }
        bit=bit+1
    }
    // Setup failure after DMA enable still goes through stop, and retries a
    // dropped disable before allowing terminal failure.
    reset(true,0); begin(1,u32(0),100); drop=40
    if (sdMmcReadPollOwned(ctx,u32(0)) != 2 || ctx.load(7) != 9 || sdMmcS3Read(44) != 0) return i32(7)
    drop=0
    if (sdMmcReadPollOwned(ctx,u32(1)) != 2 || ctx.load(4) != 3) return i32(8)
    drop=-1
    if (cleanup(9,u32(2)) != 0) return i32(9)
    // DMA return cannot override a bad R1 response or descriptor corruption.
    reset(true,0); begin(0,u32(0),100); sdMmcReadPollOwned(ctx,u32(0))
    reg(68,4); reg(48,0x80000900)
    if (sdMmcReadPollOwned(ctx,u32(1)) != 2 || cleanup(5,u32(2)) != 0) return i32(10)
    reset(true,0); begin(0,u32(0),100); sdMmcReadPollOwned(ctx,u32(0)); sdMmcDmaS3Write(0x3fc88004,4)
    if (sdMmcReadPollOwned(ctx,u32(1)) != 2 || cleanup(7,u32(2)) != 0) return i32(11)
    // Deadline wraps and only starts cleanup; reset/FSM still pin the buffers.
    reset(true,0); begin(0,u32(0xfffffff0),32); sdMmcReadPollOwned(ctx,u32(0xfffffff0))
    if (sdMmcReadPollOwned(ctx,u32(16)) != 2 || ctx.load(7) != 6 || cleanup(6,u32(17)) != 0) return i32(12)
    // Late CRC during otherwise successful stop changes the final outcome.
    reset(true,0); begin(0,u32(0),100); sdMmcReadPollOwned(ctx,u32(0)); reg(44,0); reg(48,0x900); reg(68,12); reg(140,258); sdMmcDmaS3Write(0x3fc88000,28)
    sdMmcReadPollOwned(ctx,u32(1)); reg(68,128)
    if (cleanup(4,u32(2)) != 0) return i32(13)
    reset(true,0)
    if (begin(4294967295,u32(0),100) != 2 || ctx.loadU32(36) != 4294967295 || begin(4294967296,u32(0),100) != 3 || writes != 0) return i32(14)
    reset(false,0)
    if (begin(2097152,u32(0),100) != 3 || begin(-1,u32(0),100) != 3 || writes != 0) return i32(15)
    reset(true,0); begin(0,u32(0),100); reg(0,0x02000020)
    if (sdMmcReadPollOwned(ctx,u32(1)) != 8 || writes != 0) return i32(16)
