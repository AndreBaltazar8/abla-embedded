import "../src/esp32/power/sleep_cpu_aux_p4_sequence.ab"
import "abla/build"
val auxStorage=nativeStaticAllocate(260)
val auxBank=nativeStaticAllocate(240)
var auxHart=u32(0)
var auxStatus=u32(0)
var auxReads=0
var auxWrites=0
var auxFences=0
var auxBad=false
fun p4CpuAuxHart(): u32 = auxHart
fun p4CpuAuxStatus(): u32 = auxStatus
fun p4CpuAuxFence(): void { auxFences=auxFences+1;return }
fun auxPattern(slot: int): int = (0xa5000000|(slot<<16)|(slot*123+9))
fun p4CpuAuxRead(slot: int): u32 {
    if (slot != auxReads || auxWrites != 0 || auxFences != 0) auxBad=true
    auxReads=auxReads+1
    return u32(nativeBufferAt(auxBank,240).loadU32(slot*4))
}
fun p4CpuAuxWrite(slot: int,value: u32): void {
    if (slot != auxWrites || auxReads != 60 || auxFences != 1 ||
        nativeBufferAt(auxStorage,260).loadU32(4) != 2) auxBad=true
    auxWrites=auxWrites+1
    nativeBufferAt(auxBank,240).storeU32(slot*4,int(value))
    return
}
fun auxSeed(): NativeBuffer {
    val r=nativeBufferAt(auxStorage,260)
    var i=0
    while (i < 260) { r.storeU32(i,0);i=i+4 }
    r.storeU32(256,0x1234abcd)
    i=0
    while (i < 60) { nativeBufferAt(auxBank,240).storeU32(i*4,auxPattern(i));i=i+1 }
    auxHart=u32(0);auxStatus=u32(0);auxReads=0;auxWrites=0;auxFences=0;auxBad=false
    return r
}
@export("abla_sleep_cpu_aux_p4_test")
fun test(): int {
    var hart=0
    while (hart < 2) {
        val r=auxSeed();auxHart=u32(hart)
        if (esp32p4CpuAuxSaveOwned(r,true) != 1 || auxReads != 60 ||
            auxFences != 1 || r.loadU32(4) != 1 || r.loadU32(8) != hart) return 1
        var i=0
        while (i < 60) {
            if (r.loadU32(16+i*4) != auxPattern(i)) return 2
            nativeBufferAt(auxBank,240).storeU32(i*4,0)
            i=i+1
        }
        if (esp32p4CpuAuxSaveOwned(r,true) != 2 || auxReads != 60) return 3
        auxHart=u32(1-hart)
        if (esp32p4CpuAuxRestoreOwned(r,true) != 3 || auxWrites != 0) return 4
        auxHart=u32(hart);auxStatus=u32(8)
        if (esp32p4CpuAuxRestoreOwned(r,true) != 3 || auxWrites != 0) return 5
        auxStatus=u32(0)
        if (esp32p4CpuAuxRestoreOwned(r,false) != 2 || auxWrites != 0) return 6
        r.storeU32(12,1)
        if (esp32p4CpuAuxRestoreOwned(r,true) != 2 || auxWrites != 0) return 7
        r.storeU32(12,0)
        if (esp32p4CpuAuxRestoreOwned(r,true) != 4 || auxWrites != 60 ||
            auxFences != 2 || r.loadU32(4) != 3 || auxBad) return 8
        i=0
        while (i < 60) {
            if (nativeBufferAt(auxBank,240).loadU32(i*4) != auxPattern(i)) return 9
            i=i+1
        }
        if (r.loadU32(256) != 0x1234abcd ||
            esp32p4CpuAuxRestoreOwned(r,true) != 2 || auxWrites != 60) return 10
        hart=hart+1
    }
    val r=auxSeed()
    if (esp32p4CpuAuxSaveOwned(r,false) != 2) return 11
    if (esp32p4CpuAuxSaveOwned(nativeBufferAt(auxStorage,255),true) != 2) return 12
    if (esp32p4CpuAuxSaveOwned(nativeBufferAt(auxStorage+1,256),true) != 2) return 13
    if (esp32p4CpuAuxSaveOwned(nativeBufferAt(0,256),true) != 2) return 14
    auxHart=u32(2)
    if (esp32p4CpuAuxSaveOwned(r,true) != 3) return 15
    auxHart=u32(0);auxStatus=u32(8)
    if (esp32p4CpuAuxSaveOwned(r,true) != 3 || auxReads != 0 ||
        auxWrites != 0 || r.loadU32(0) != 0) return 16
    return 0
}
