import "./corematrix-wire-native.ab"
import "../src/m5stack/corematrix_buzzer.ab"
@export("abla_corematrix_buzzer_wire_test")
trusted fun testBuzzerSetup(): i32 {
    wireSeed()
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val r=nativeBufferAt(registers,512)
    var failure=0
    while (failure <= 34) {
        var commit=0
        while (commit < 2) {
            r.store(3,255);r.store(4,63);r.store(5,255);r.store(6,63);r.store(19,255);r.store(20,63)
            r.storeU16(31,34816);r.storeU16(37,4000)
            val before=ackCount;nackAfterCommit=commit == 1;nackAt=if (failure == 0) 0 else before+failure
            val result=control.configureBuzzerOwned(true)
            val completed=if (failure == 0) 6 else if (failure <= 6) 0 else if (failure <= 10) 1 else if (failure <= 16) 2 else if (failure <= 22) 3 else if (failure <= 28) 4 else 5
            if (result.status() != (if (failure == 0) 1 else 4) || result.appliedSteps() != completed || ackCount-before != (if (failure == 0) 34 else failure) || bad) return i32(2)
            if (failure == 0 && (r.load(5) != 253 || r.loadU16(31) != 0 || r.load(19) != 253 || r.load(20) != 59 || r.load(3) != 255 || r.load(4) != 63)) return i32(3)
            if (r.loadU16(37) != 4000 || r.load(6) != 63) return i32(4)
            nackAt=0
            if (control.silenceBuzzerOwned(true) != 769 || r.load(5) != 253 || r.loadU16(31) != 0 || bad) return i32(5)
            commit=commit+1
        }
        failure=failure+1
    }
    failure=1
    while (failure <= 10) {
        var commit=0
        while (commit < 2) {
            r.store(5,255);r.storeU16(31,34816)
            val before=ackCount;nackAfterCommit=commit == 1;nackAt=before+failure
            val result=control.silenceBuzzerOwned(true)
            // Power uses read-modify-write; a read failure skips its write,
            // but must still attempt all four PWM-off bytes.
            val expectedCalls=if (failure <= 3) failure+4 else if (failure <= 6) failure+4 else failure
            if (result != (4|(if (failure <= 6) 512 else 256)) || ackCount-before != expectedCalls || bad) return i32(6)
            nackAt=0
            if (control.silenceBuzzerOwned(true) != 769 || r.load(5) != 253 || r.loadU16(31) != 0) return i32(7)
            commit=commit+1
        }
        failure=failure+1
    }
    nackAfterCommit=false;val before=ackCount
    if (control.configureBuzzerOwned(false).status() != 2 || control.silenceBuzzerOwned(false) != 2 || ackCount != before) return i32(8)
    if (!control.closeOwned(true) || pads != 0 || bad) return i32(9)
    return i32(0)
}
