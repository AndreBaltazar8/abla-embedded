import "../src/esp32/rtc_ext0_record_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_ext0_record_target")
trusted fun ext0RecordTarget(record: NativeBuffer,pin: int,level: int,restore: bool): bool {
    if (restore) return esp32S3Ext0RecordRestoreOwned(record)
    esp32S3Ext0RecordPrepareOwned(record,pin,level)
}
