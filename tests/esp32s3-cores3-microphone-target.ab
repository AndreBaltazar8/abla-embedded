import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/cores3_microphone.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun cores3MicrophoneTarget(handle: u32, enabled: bool): int {
    val microphone = Es7210(int(handle))
    val result = if (enabled) cores3MicrophoneEnable(microphone) else cores3MicrophoneDisable(microphone)
    result.status() | (if (result.cleanupAttempted()) 256 else 0) | (if (result.cleanupFailed()) 512 else 0)
}
#exportFunction("cores3MicrophoneTarget", "abla_s3_cores3_microphone_test")
