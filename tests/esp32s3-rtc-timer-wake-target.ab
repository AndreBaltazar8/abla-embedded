import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/rtc_timer_wake_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_timer_wake_target")
trusted fun wakeTarget(board: M5BoardId,record: NativeBuffer,timer: M5RtcTimerResult,exclusive: bool): int = board.prepareS3RtcTimerWake(record,timer,exclusive)
