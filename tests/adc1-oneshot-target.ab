import "../src/esp32/adc1_oneshot_esp32.ab"
import "../src/esp32/adc1_config_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc1_oneshot_target")
trusted fun target(channel: int,polls: int,operation: int): int =
    if (operation == 1) esp32Adc1FinishOwned(channel,polls) else if (operation == 2) esp32Adc1ConfigureOwned(channel,12,3,polls) else if (operation == 3) esp32Adc1ReleaseOwned(channel,polls) else esp32Adc1StartOwned(channel,polls)
