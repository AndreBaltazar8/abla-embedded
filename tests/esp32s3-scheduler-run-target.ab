import "../src/esp32/scheduler_run_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_scheduler_run_target")
@section(".iram1.abla.s3SchedulerRunTarget")
trusted fun runTarget(context: NativeBuffer,request: bool): int =
    if (request) (if (esp32S3SchedulerRequestOwned(context)) 1 else 0) else esp32S3SchedulerRunAddress()
