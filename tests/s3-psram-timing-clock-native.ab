import "../src/esp32/psram/timing_clock_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val tclkRegs=nativeStaticAllocate(16)
var tclkWrites=0
var tclkFail=0
var tclkBusy=0
var tclkBad=false
fun tclkSlot(address: int): int = if (address == 0x600030ec) 0 else if (address == 0x60003014) 1 else if (address == 0x60002014) 2 else if (address == 0x600030bc) 3 else -1
fun s3PsramCsRead(address: int): int {
    if (address == 0x60002000) return if (tclkBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (tclkBusy == 2) 0x80000000 else 0
    val slot=tclkSlot(address)
    if (slot < 0) { tclkBad=true;return 0 }
    return nativeAddressLoadU32(tclkRegs,slot*4)
}
fun s3PsramCsWrite(address: int,value: int): void {
    val slot=tclkSlot(address)
    if (slot != tclkWrites || slot < 0) { tclkBad=true;return }
    tclkWrites=tclkWrites+1
    nativeAddressStoreU32(tclkRegs,slot*4,if (tclkWrites == tclkFail) value^1 else value);return
}
@export("abla_s3_psram_timing_clock_test")
fun testTimingClock(): int {
    var profile=0
    while (profile < 256) {
        var selector=0
        while (selector < 4) {
            val core=if (selector == 0) 80 else if (selector == 1) 120 else if (selector == 2) 160 else 240
            var module=20
            while (module <= 120) {
                val divider=core/module
                val allowed=(module == 20 || module == 40 || module == 80 || module == 120) && core%module == 0 &&
                    (divider == 1 || divider == 2 || divider == 4 || divider == 8)
                if (s3PsramTimingClockDivider(core,module) != (if (allowed) divider else -1)) return 1
                tclkFail=0
                while (tclkFail <= 4) {
                    val prior=0xa55a5aa5^(profile*16777217)
                    var i=0
                    while (i < 4) { nativeAddressStoreU32(tclkRegs,i*4,prior);i=i+1 }
                    tclkWrites=0;tclkBusy=0;tclkBad=false
                    if (s3PsramTimingClockOwned(core,module,true,true) != (if (!allowed) 2 else if (tclkFail == 0) 1 else 4) ||
                        tclkBad || tclkWrites != (if (!allowed) 0 else if (tclkFail == 0) 4 else tclkFail)) return 2
                    if (allowed && tclkFail == 0) {
                        if (nativeAddressLoadU32(tclkRegs,0) != ((prior&0xfffffffc)|selector) || nativeAddressLoadU32(tclkRegs,12) != (prior|1)) return 3
                        val clock=nativeAddressLoadU32(tclkRegs,4)
                        if (clock != nativeAddressLoadU32(tclkRegs,8)) return 4
                        if (divider == 1) { if (clock != 0x80000000) return 5 }
                        else if (((clock>>>16)&255)+1 != divider || (clock&255)+1 != divider || ((clock>>>8)&255)+1 != divider/2 || (clock>>>24) != 0) return 6
                    }
                    tclkFail=tclkFail+1
                }
                module=module+20
            }
            selector=selector+1
        }
        profile=profile+1
    }
    tclkWrites=0
    if (s3PsramTimingClockOwned(160,80,false,true) != 2 || s3PsramTimingClockOwned(160,80,true,false) != 2 ||
        s3PsramTimingClockOwned(0,0,true,true) != 2 || s3PsramTimingClockOwned(160,-1,true,true) != 2 || tclkWrites != 0) return 7
    tclkBusy=1
    if (s3PsramTimingClockOwned(160,80,true,true) != 3 || tclkWrites != 0) return 8
    tclkBusy=2
    if (s3PsramTimingClockOwned(160,80,true,true) != 3 || tclkWrites != 0) return 9
    return 0
}
