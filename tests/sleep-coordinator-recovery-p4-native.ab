import "./sleep-smp-p4-native.ab"
import "../src/esp32/power/sleep_coordinator_recovery_p4_sequence.ab"
// Integration ordering model. Actual session, clocks, CPU-bank and route
// implementations have separate MMIO/instruction tests; target composes them.
val recoveryStorage=nativeStaticAllocate(1688)
val recoveryPolicyStorage=nativeStaticAllocate(392)
var recoveryPolicyCalls=0
var recoveryOutcome=1
var recoverySessionCalls=0
var recoveryClockCalls=0
var recoveryCpuCalls=0
var recoveryRouteCalls=0
var recoveryPeerCalls=0
var recoveryOrder=0
var recoveryBad=false
var recoveryAbort=false
fun recoveryBase(): int = (recoveryStorage+15)&(~15)
fun recoveryRecord(): NativeBuffer = nativeBufferAt(recoveryBase(),64)
fun recoverySession(): NativeBuffer = nativeBufferAt(recoveryBase()+64,464)
fun recoveryClocks(): NativeBuffer = nativeBufferAt(recoveryBase()+528,288)
fun recoveryCpu(): NativeBuffer = nativeBufferAt(recoveryBase()+816,816)
fun recoveryRoute(): NativeBuffer = nativeBufferAt(recoveryBase()+1632,24)
fun recoveryShared(): NativeBuffer = nativeBufferAt(smpStorage,4)
fun recoveryPolicy(): NativeBuffer = nativeBufferAt(recoveryPolicyStorage,392)
fun p4CoordinatorPolicyClose(policy: NativeBuffer): int {
    recoveryPolicyCalls=recoveryPolicyCalls+1
    val state=esp32p4SleepSmpObserve(recoveryShared(),smpGeneration)
    if (recoveryCpuCalls != 2 || recoveryClockCalls != 2 || state.phase(int(smpHart)) != 3 || recoveryRouteCalls != 0) recoveryBad=true
    if (recoveryPolicyCalls == 1) return 9
    policy.storeU32(4,4);return 8
}
fun p4CoordinatorPeer(cpu: NativeBuffer,smp: NativeBuffer,generation: int): int {
    if (smpHart != u32(0) || cpu.loadU32(676) != 3 || ((smpWord>>>9)&u32(7)) != u32(2)) recoveryBad=true
    recoveryPeerCalls=recoveryPeerCalls+1;recoveryOrder=recoveryOrder*10+1;return 1
}
fun p4CoordinatorSession(session: NativeBuffer,polls: int,eventPolls: int): int {
    recoverySessionCalls=recoverySessionCalls+1
    if (recoverySessionCalls == 1) return 7
    if (recoveryOrder != (if (recoveryPeerCalls == 0) 0 else 1)) recoveryBad=true
    recoveryOrder=recoveryOrder*10+2;return recoveryOutcome
}
fun p4CoordinatorSessionAbort(session: NativeBuffer,polls: int,eventPolls: int): int {
    if (((smpWord>>>9)&u32(7)) != u32(4) || session.loadU32(176) != 0) recoveryBad=true
    return p4CoordinatorSession(session,polls,eventPolls)
}
fun p4CoordinatorClocks(clocks: NativeBuffer,polls: int): int {
    recoveryClockCalls=recoveryClockCalls+1
    if (recoveryClockCalls == 1) return 4
    val state=esp32p4SleepSmpObserve(recoveryShared(),smpGeneration)
    if (state.stage() != (if (recoveryOutcome == 2 || recoveryOutcome == 10) 4 else 3) ||
        state.phase(int(smpHart)) != (if (recoveryAbort) 1 else 2)) recoveryBad=true
    recoveryOrder=recoveryOrder*10+3;return 5
}
fun p4CoordinatorCpu(cpu: NativeBuffer): int {
    recoveryCpuCalls=recoveryCpuCalls+1
    if (recoveryCpuCalls == 1) return 4
    val state=esp32p4SleepSmpObserve(recoveryShared(),smpGeneration)
    if (state.phase(int(smpHart)) != 3 || recoveryClockCalls != 2) recoveryBad=true
    recoveryOrder=recoveryOrder*10+4;return 8
}
fun p4CoordinatorRoute(route: NativeBuffer): int {
    recoveryRouteCalls=recoveryRouteCalls+1
    val state=esp32p4SleepSmpObserve(recoveryShared(),smpGeneration)
    if ((!recoveryAbort && (state.phase(0) != 4 || state.phase(1) != 4)) || recoveryCpuCalls != 2) recoveryBad=true
    if (recoveryRouteCalls == 1) return 4
    recoveryOrder=recoveryOrder*10+5;return 5
}
fun recoverySeed(hart: int,phase: int,event: int): void {
    smpSeed();recoveryOutcome=event;recoveryAbort=false;recoveryPolicyCalls=0
    val policy=recoveryPolicy();policy.storeU32(0,0x50345053);policy.storeU32(4,1);policy.storeU32(16,hart);policy.storeU32(388,0x1234abcd)
    recoverySessionCalls=0;recoveryClockCalls=0;recoveryCpuCalls=0;recoveryRouteCalls=0;recoveryPeerCalls=0;recoveryOrder=0;recoveryBad=false
    val all=nativeBufferAt(recoveryBase(),1660)
    var offset=0
    while (offset < 1660) { all.storeU32(offset,0);offset=offset+4 }
    all.storeU32(1656,0x1234abcd)
    recoverySession().storeU32(0,0x50345332)
    recoveryClocks().storeU32(0,0x50344353);recoveryClocks().storeU32(4,4);recoveryClocks().storeU32(32,hart)
    val cpu=recoveryCpu()
    cpu.storeU32(0,0x50345243);cpu.storeU32(4,6);cpu.storeU32(8,hart)
    cpu.storeU32(672,0x50344358);cpu.storeU32(676,phase);cpu.storeU32(680,hart)
    recoveryRoute().storeU32(0,0x50345752);recoveryRoute().storeU32(4,2);recoveryRoute().storeU32(16,hart)
    if (smpAct(hart,0).status() != 1 || smpAct(1-hart,1).status() != 1 ||
        smpAct(1-hart,2).status() != 1 || smpAct(hart,2).status() != 1 || smpAct(hart,3).status() != 1) recoveryBad=true
    return
}
fun recoveryContinue(sources: bool,policy: bool): int =
    esp32p4SleepCoordinatorRecoveryContinueOwned(recoveryRecord(),2,2,sources,policy,true)
@export("abla_sleep_coordinator_recovery_p4_test")
fun recoveryTest(): int {
    var scenario=0
    while (scenario < 48) {
        val hart=scenario&1
        val mode=(scenario/2)%6
        val advanced=scenario%24 >= 12
        val bound=scenario >= 24
        val event=if (mode < 3) mode+1 else if (mode == 3) 10 else if (mode == 4) 1 else 3
        recoverySeed(hart,if (mode < 4) 2 else 3,event)
        val r=recoveryRecord()
        if (esp32p4SleepCoordinatorRecoveryOpenOwned(r,recoverySession(),recoveryClocks(),recoveryCpu(),recoveryShared(),recoveryRoute(),smpGeneration,true) != 7) return 1
        if (bound && (esp32p4SleepCoordinatorBindPolicyOwned(r,recoveryPolicy(),true) != 7 ||
            esp32p4SleepCoordinatorBindPolicyOwned(r,recoveryPolicy(),true) != 4)) return 28
        if (recoveryContinue(false,false) != 7 || r.loadU32(4) != 2) return 2
        if (recoveryContinue(false,false) != 7 || r.loadU32(4) != 4 || recoveryClockCalls != 0) return 3
        if (recoveryContinue(true,false) != 7 || recoveryContinue(true,false) != 9 || r.loadU32(4) != 6) return 4
        if (bound && (recoveryContinue(true,true) != 9 || r.loadU32(4) != 7 || r.loadU32(52) != 0 ||
            esp32p4SleepSmpObserve(recoveryShared(),smpGeneration).phase(hart) != 3)) return 29
        if (recoveryContinue(true,false) != 7 || r.loadU32(4) != 7 ||
            esp32p4SleepSmpObserve(recoveryShared(),smpGeneration).phase(hart) != 3) return 5
        if (recoveryContinue(true,true) != 7 || r.loadU32(4) != 8 || recoveryRouteCalls != 0) return 6
        if (smpAct(1-hart,7).status() != 1 || smpAct(1-hart,8).status() != 1) return 7
        smpHart=u32(hart)
        if (recoveryContinue(true,true) != 9 || r.loadU32(4) != 9) return 8
        if (recoveryContinue(true,true) != 7 || r.loadU32(4) != 11) return 9
        if (smpAct(1-hart,10).status() != 1) return 10
        if (advanced && smpAct(1-hart,0).status() != 1) return 11
        smpHart=u32(hart)
        if (recoveryContinue(true,true) != event || recoveryBad || recoverySessionCalls != 2 ||
            recoveryClockCalls != 2 || recoveryCpuCalls != 2 || recoveryRouteCalls != 2 ||
            recoveryOrder != (if (mode >= 4 && hart == 0) 12345 else 2345) ||
            nativeBufferAt(recoveryBase(),1660).loadU32(1656) != 0x1234abcd) return 12
        if (recoveryContinue(true,true) != event || recoveryRouteCalls != 2) return 13
        if (recoveryPolicyCalls != (if (bound) 2 else 0) || recoveryPolicy().loadU32(388) != 0x1234abcd) return 30
        scenario=scenario+1
    }
    recoverySeed(0,3,1)
    if (esp32p4SleepCoordinatorRecoveryOpenOwned(recoveryRecord(),recoverySession(),recoveryClocks(),recoveryCpu(),
        nativeBufferAt(recoveryBase()+16,4),recoveryRoute(),smpGeneration,true) != 4 ||
        recoveryRecord().loadU32(0) != 0) return 14
    // Abort before any CPU boundary/request, with peer not joined/saving/backed.
    var aborted=0
    while (aborted < 12) {
        val hart=aborted&1;val peerPhase=(aborted/2)%3;val empty=aborted >= 6
        recoverySeed(hart,2,10);recoveryAbort=true
        smpWord=smpControl(1,hart,1,peerPhase)
        recoveryCpu().storeU32(4,4);recoveryCpu().storeU32(672,0)
        recoverySession().storeU32(4,2)
        if (empty) {
            recoveryCpu().storeU32(0,0);recoverySession().storeU32(0,0)
            recoveryClocks().storeU32(0,0);recoveryRoute().storeU32(0,0)
        }
        if (esp32p4SleepCoordinatorAbortOpenOwned(recoveryRecord(),recoverySession(),recoveryClocks(),recoveryCpu(),recoveryShared(),recoveryRoute(),smpGeneration,true) != 7) return 15
        if (!empty) {
            if (recoveryContinue(false,false) != 7 || recoveryRecord().loadU32(4) != 2 ||
                recoveryContinue(false,false) != 7 || recoveryRecord().loadU32(4) != 4) return 16
            if (recoveryContinue(true,false) != 7 || recoveryContinue(true,false) != 9 || recoveryContinue(true,false) != 7) return 17
        } else if (recoveryContinue(false,false) != 7) return 18
        if (recoveryRecord().loadU32(4) != 7 || recoveryPeerCalls != 0) return 19
        if (peerPhase != 0) {
            if (recoveryContinue(true,true) != 7 || recoveryRecord().loadU32(4) != 8) return 20
            if (smpAct(1-hart,7).status() != 1 || smpAct(1-hart,8).status() != 1) return 21
            smpHart=u32(hart)
        }
        if (!empty && recoveryContinue(true,true) != 9) return 22
        val finished=recoveryContinue(true,true)
        if (peerPhase == 0) { if (finished != 10) return 23 }
        else {
            if (finished != 7 || recoveryRecord().loadU32(4) != 11 || smpAct(1-hart,10).status() != 1) return 24
            smpHart=u32(hart)
            if (recoveryContinue(true,true) != 10) return 25
        }
        if (recoveryBad || (empty && (recoverySessionCalls+recoveryCpuCalls+recoveryClockCalls+recoveryRouteCalls != 0))) return 26
        aborted=aborted+1
    }
    recoverySeed(0,2,1)
    if (esp32p4SleepCoordinatorAbortOpenOwned(recoveryRecord(),recoverySession(),recoveryClocks(),recoveryCpu(),recoveryShared(),recoveryRoute(),smpGeneration,true) != 4) return 27
    return 0
}
