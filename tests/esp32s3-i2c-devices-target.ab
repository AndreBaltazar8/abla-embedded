import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/power/bq27220_device.ab"
import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "../src/rtc/powerhub_device.ab"
import "../src/io_expander/m5ioe1_device.ab"
import "../src/io_expander/pi4ioe5v6408_device.ab"
import "../src/power/axp192_device.ab"
import "../src/power/axp2101_device.ab"
import "../src/power/ina226_device.ab"
import "../src/power/ina3221_device.ab"
import "../src/power/m5pm1_device.ab"
import "../src/power/ip5306_device.ab"
import "../src/power/aw32001_device.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")

// Compile fixture, not a board initialization sequence. Caller selects the
// actual attached device; never run every power-device begin on unknown wiring.
@export("abla_s3_i2c_devices_test")
trusted fun devicesTargetTest(busKey: int, selected: i32): bool {
    val bus = I2cBus(busKey)
    if (selected == i32(0)) {
        val device = pcf8563(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(1)) {
        val device = rx8130(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(2)) {
        val device = powerHubRtc(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(3)) {
        val device = m5Ioe1(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(4)) {
        val device = pi4Ioe5v6408(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(5)) {
        val device = axp192(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(6)) {
        val device = axp2101(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(7)) {
        val device = ina226(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(8)) {
        val device = ina3221(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(9)) {
        val device = m5Pm1(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(10)) {
        val device = ip5306(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(11)) {
        val device = aw32001(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    if (selected == i32(12)) {
        val device = bq27220(bus)
        val result = device.begin()
        val closed = device.close()
        return result && closed
    }
    bus.probe(127)
}
