import "./corematrix-wire-native.ab"
import "../src/m5stack/corematrix_imu_owner.ab"
import "../src/m5stack/imu_owner_update.ab"
import "abla/runtime/scalar"
val imuMemory=nativeStaticAllocate(100)
var imuWaits=0
fun imuDelay(ticks: int): void { if (ticks != 1) bad=true;imuWaits=imuWaits+1;return }
@export("abla_corematrix_imu_wire_test")
trusted fun testImu(): i32 {
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    val imu=m5ImuOwnerAt(nativeBufferAt(imuMemory,36))
    val snapshot=imuSnapshotAt(nativeBufferAt(imuMemory+36,44))
    val scratch=nativeBufferAt(imuMemory+80,20)
    wireSeed()
    if (!control.initialize() || !imu.initialize() || !snapshot.initialize()) return i32(1)
    if (control.openImuPreparedOwned(imu,true) != -1 || ackCount != 0) return i32(2)
    if (control.openOwned(40000000,20000000,true) != 1) return i32(3)
    val before=ackCount
    if (control.openImuPreparedOwned(imu,false) != -1 ||
        control.openImuPreparedOwned(m5ImuOwnerAt(nativeBufferAt(record+4,36)),true) != -1 ||
        control.openImuPreparedOwned(m5ImuOwnerAt(nativeBufferAt(softwareI2cProviderSlots,36)),true) != -1 || ackCount != before) return i32(4)
    if (control.openImuPreparedOwned(imu,true) != 2 || !control.imuRetained() || control.closeOwned(true) ||
        !control.closeImuOwned(imu,true) || control.imuRetained()) return i32(5)
    val r=nativeBufferAt(imuRegisters,256)
    var at=0;while (at < 256) { r.store(at,0);at=at+1 }
    r.store(0,36);imuPresent=true;imuWaits=0;imuExpectedConfig=bmi270ConfigurationAddress
    val scanStart=ackCount
    if (control.openImuPreparedOwned(imu,true) != 1 || imu.primary().kind() != m5ImuBmi270 ||
        imu.primary().address() != 105 || imu.primary().capabilities() != 3 || imuUploaded != 8192 || imuWaits != 3 || bad) return i32(6)
    val configOffset=imuConfigStart-scanStart
    val readyCount=ackCount
    if (control.openImuPreparedOwned(imu,true) != -1 || !control.imuRetained() ||
        control.closeOwned(true) || control.closeImuOwned(imu,false) ||
        control.closeImuOwned(m5ImuOwnerAt(nativeBufferAt(imuMemory+4,36)),true) ||
        !control.ready() || ackCount != readyCount) return i32(7)
    r.store(29,192)
    r.storeU16(12,100);r.storeU16(14,65536-200);r.storeU16(16,300)
    r.storeU16(18,400);r.storeU16(20,500);r.storeU16(22,65536-600)
    val updated=imu.updateSnapshot(snapshot,scratch,12345)
    if (!snapshot.has(0) || !snapshot.has(1) || snapshot.timestamp(0) != 12345 ||
        snapshot.axes(0).axis(0) != 100 || snapshot.axes(0).axis(1) != -200 || snapshot.axes(1).axis(2) != -600) return i32(8)
    val order=m5BoardCoreMatrix.imuAxisOrder(imu.primary().kind(),0,105)
    if (order.rawAxis(snapshot.axes(0),0) != -200 || order.rawAxis(snapshot.axes(0),1) != -100 || order.rawAxis(snapshot.axes(0),2) != 300) return i32(9)
    var failure=1
    while (failure <= 6) {
        nackAt=ackCount+failure
        val failed=imu.updateSnapshot(snapshot,scratch,67890)
        if (snapshot.timestamp(0) != 12345 || snapshot.timestamp(1) != 12345 || snapshot.axes(0).axis(0) != 100 || bad) return i32(10)
        failure=failure+1
    }
    nackAt=0
    // Provider admission failure during child close must retain ownership and
    // block parent teardown; retry after releasing the gate must release it.
    if (!softwareI2cProviderEnter()) return i32(14)
    val blocked=control.closeImuOwned(imu,true)
    if (!softwareI2cProviderLeave() || blocked || !control.imuRetained() ||
        imu.primary().handle() == 0 || control.closeOwned(true) || !control.ready()) return i32(15)
    if (!control.closeImuOwned(imu,true) || control.imuRetained() || !control.ready()) return i32(11)
    // Abort the actual long upload at first/middle/last data bytes; the scan
    // may continue only after STOP, and must not publish a half-started BMI.
    var cut=0
    while (cut < 3) {
        at=0;while (at < 256) { r.store(at,0);at=at+1 }
        r.store(0,36);imuUploaded=0
        val failedByte=if (cut == 0) 1 else if (cut == 1) 4096 else 8192
        nackAt=ackCount+configOffset+failedByte
        if (control.openImuPreparedOwned(imu,true) != 2 || imuUploaded != failedByte-1 ||
            !control.imuRetained() || control.closeOwned(true) ||
            !control.closeImuOwned(imu,true) || control.imuRetained() || !control.ready() || bad) return i32(12)
        nackAt=0;cut=cut+1
    }
    if (!control.closeOwned(true) || pads != 0 || bad) return i32(13)
    return i32(0)
}
