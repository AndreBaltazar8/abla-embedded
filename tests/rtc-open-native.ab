import "../src/m5stack/rtc_open_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var bad=false
var allocationFails=false
var beginFails=false
var closeFails=false
var expected=0
var expectedBoard=m5BoardStackCore2
fun m5RtcOpenAllocate(bus: int,board: M5BoardId): int {
    if (bus != 7 || board != expectedBoard || calls != 0) bad=true
    calls=calls+1; if (allocationFails) 0 else expected
}
fun m5RtcOpenBegin(rtc: int): bool {
    if (rtc != expected || calls != 1) bad=true
    calls=calls+1; !beginFails
}
fun m5RtcOpenClose(rtc: int): bool {
    if (rtc != expected || calls != 2) bad=true
    calls=calls+1; !closeFails
}
@export("abla_rtc_open_test")
fun openTest(): i32 {
    var profile=0
    while (profile < 24) {
        val kind=profile/8+1
        expectedBoard=if (kind == 1) m5BoardStackCore2 else if (kind == 2) m5BoardPaperMono else m5BoardPowerHub
        expected=(kind<<32)|4294967295
        allocationFails=(profile & 1) != 0; beginFails=(profile & 2) != 0; closeFails=(profile & 4) != 0
        calls=0; bad=false
        val result=m5RtcOpenOwned(7,expectedBoard)
        val status=if (allocationFails) 2 else if (!beginFails) 1 else if (closeFails) 4 else 3
        if (result.status() != status || result.ready() != (status == 1) ||
            result.handle() != (if (status == 1 || status == 4) expected else 0) ||
            calls != (if (allocationFails) 1 else if (beginFails) 3 else 2) || bad) return i32(1)
        profile=profile+1
    }
    i32(0)
}
