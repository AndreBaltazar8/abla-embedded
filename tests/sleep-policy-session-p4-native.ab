import "../src/esp32/power/sleep_policy_session_p4_sequence.ab"
import "abla/build"
val policyStorage=nativeStaticAllocate(500)
var policyTrigger=u32(0x80012345)
var policyReject=u32(0xa0054321)
var policyTiming=u32(0x12345678)
var policyWrites=0
var policyFail=0
var policyBad=false
var policyHart=u32(0)
var policyProfileLive=false
var policySourceLive=false
fun policyWriteAllowed(): bool { policyWrites=policyWrites+1;return policyWrites != policyFail }
fun p4PolicyHart(): u32 = policyHart
fun p4PolicyStatus(): u32 = u32(0)
fun p4WakeTriggerRead(): u32 = policyTrigger
fun p4WakeTriggerWrite(value: u32): void {
    if ((value&u32(0x7fffffff)) == u32(4096) && (!policySourceLive || !policyProfileLive)) policyBad=true
    if ((value&u32(0x7fffffff)) == u32(0x12345) && (policySourceLive || policyProfileLive)) policyBad=true
    if (policyWriteAllowed()) policyTrigger=value
    return
}
fun p4SleepPolicyRead(offset: int): u32 = if (offset == 292) policyReject else policyTiming
fun p4SleepPolicyWrite(offset: int,value: u32): void {
    if ((policyTrigger&u32(0x7fffffff)) != u32(0)) policyBad=true
    if (policyWriteAllowed()) { if (offset == 292) policyReject=value else policyTiming=value }
    return
}
fun p4PolicyProfileValid(c: NativeBuffer,revision: int): bool = c.hasAddressRange(0,108) && revision == 300
fun p4PolicyProfileOpen(r: NativeBuffer,c: NativeBuffer,revision: int): int {
    if ((policyTrigger&u32(0x7fffffff)) != u32(0)) policyBad=true
    r.storeU32(0,1);policyProfileLive=true
    return if (policyWriteAllowed()) 1 else 3
}
fun p4PolicyProfileClose(r: NativeBuffer): int {
    if (!policyProfileLive) return 8
    if (policySourceLive || policyReject != u32(0xa0054321) || policyTiming != u32(0x12345678)) policyBad=true
    if (!policyWriteAllowed()) return 9
    policyProfileLive=false;return 8
}
fun p4PolicySourceOpen(r: NativeBuffer,pins: u32,levels: u32,pull: int,filter: bool,layout: int): int {
    if (!policyProfileLive || (policyTrigger&u32(0x7fffffff)) != u32(0)) policyBad=true
    r.storeU32(0,1);policySourceLive=true;return if (policyWriteAllowed()) 1 else 6
}
fun p4PolicySourceClose(r: NativeBuffer): int {
    if (!policySourceLive) return 8
    if ((policyTrigger&u32(0x7fffffff)) != u32(0)) policyBad=true
    if (!policyWriteAllowed()) return 9
    policySourceLive=false;return 8
}
@export("abla_sleep_policy_session_p4_test")
fun policySessionTest(): i32 {
    val r=nativeBufferAt(policyStorage,392);val c=nativeBufferAt(policyStorage+392,108)
    var scenario=0
    while (scenario < 30) {
        var i=0
        while (i < 388) { r.storeU32(i,0);i=i+4 }
        r.storeU32(388,0x1234abcd)
        policyTrigger=u32(0x80012345);policyReject=u32(0xa0054321);policyTiming=u32(0x12345678)
        policyWrites=0;policyBad=false;policyProfileLive=false;policySourceLive=false;policyHart=u32(scenario&1)
        val fault=(scenario/2)%15;policyFail=if (fault <= 7) fault else 0
        val opened=esp32p4SleepPolicySessionOpenOwned(r,c,300,u32(1),u32(1),1,true,u32(4096),true,42,2,true)
        if ((fault == 0 || fault > 7) && opened != 1) return i32(1)
        if (fault > 0 && fault <= 7 && opened == 1) return i32(2)
        val primary=r.loadU32(8)
        policyFail=if (fault > 7) policyWrites+fault-7 else 0
        esp32p4SleepPolicySessionCloseOwned(r,true)
        policyFail=0
        if (esp32p4SleepPolicySessionCloseOwned(r,true) != 8 || policyBad || policyProfileLive || policySourceLive ||
            policyTrigger != u32(0x80012345) || policyReject != u32(0xa0054321) || policyTiming != u32(0x12345678) ||
            r.loadU32(388) != 0x1234abcd || r.loadU32(8) != primary) return i32(3)
        val count=policyWrites
        if (esp32p4SleepPolicySessionCloseOwned(r,true) != 8 || count != policyWrites) return i32(4)
        scenario=scenario+1
    }
    return i32(0)
}
