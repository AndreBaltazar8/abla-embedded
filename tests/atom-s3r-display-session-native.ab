import "../src/m5stack/atom_s3r_display_session_sequence.ab"
import "../src/m5stack/atom_s3r_display_from_probe.ab"
import "../src/m5stack/atom_s3r_display_draw_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var expectPrepare=false
var preparations=0
fun atomS3RDisplayPrepareOwned(gate: PeripheralGate,owner: u32,port: int,polls: int): int {
    preparations=preparations+1
    if (!expectPrepare || level != 0 || panels != 0 || calls != 4 || gate != peripheralGateAt(gateMemory) || owner != u32(7) || port != 2 || polls != 3) bad=true
    if (fail == 7) { nativeAddressStoreU32(gateMemory,0,0x80000000);return 3 }
    return 1
}
val record=nativeBufferAt(nativeStaticAllocate(40),40)
val gateMemory=nativeStaticMutableU32s([0])
val probe=nativeBufferAt(nativeStaticAllocate(108),108)
val pixelData=nativeBufferAt(nativeStaticAllocate(8),8)
var drawStatus=1
var drawCalls=0
fun AtomS3Panel.fillNativeChecked(gate: PeripheralGate,owner: u32,port: int,rotation: int,x: int,y: int,w: int,h: int,color: Rgb565): SpiTransactionResult {
    drawCalls=drawCalls+1
    if (this != atomS3PanelFromId(m5BoardAtomS3R,0x079100) || gate != peripheralGateAt(gateMemory) || owner != u32(7) || port != 2 || rotation != 3 || x != 0 || y != 0 || w != 2 || h != 2) bad=true
    return SpiTransactionResult((drawStatus<<32)|257)
}
fun AtomS3Panel.blitNativeChecked(gate: PeripheralGate,owner: u32,port: int,rotation: int,x: int,y: int,source: NativeBuffer,w: int,h: int,stride: int,little: bool,staging: NativeBuffer): SpiTransactionResult {
    if (source != pixelData || stride != 4 || little) bad=true
    return this.fillNativeChecked(gate,owner,port,rotation,x,y,w,h,Rgb565(0))
}
var calls=0
var panels=0
var fail=0
var level=-1
var requested=0
var bad=false
var blanking=false
fun I2cBus.valid(): bool = false
fun I2cBus.device(address: int,hz: int): I2cDevice = I2cDevice(0)
fun I2cDevice.valid(): bool = this == 9
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    if (this != 9) bad=true
    if (!blanking && register == 14 && value != 0 && (panels != 1 || record.loadU32(4) != 1)) bad=true
    if (calls == fail) return false
    if (register == 14) level=value
    return true
}
fun peripheralDelayMilliseconds(ms: int): void { if (ms != 1) bad=true;return }
trusted fun AtomS3Panel.beginNativeChecked(gate: PeripheralGate,owner: u32,port: int,rotation: int): SpiTransactionResult {
    panels=panels+1
    if (!this.valid() || (this&255) != 18 || port != 2 || rotation != 3 || owner != u32(7) ||
        gate != peripheralGateAt(gateMemory) || level != 0 || record.loadU32(4) != 1 || calls != 4) bad=true
    if (fail == 6) { nativeAddressStoreU32(gateMemory,0,0x80000000);return SpiTransactionResult((6<<32)|0x20109) }
    return SpiTransactionResult((1<<32)|257)
}
@export("abla_atom_s3r_display_session_test")
trusted fun test(): i32 {
    val panel=atomS3PanelFromId(m5BoardAtomS3R,0x079100)
    val gate=peripheralGateAt(gateMemory)
    requested=0
    while (requested <= 255) {
        fail=0
        while (fail <= 6) {
            var i=0;while (i < 40) { record.storeU32(i,0);i=i+4 }
            calls=0;panels=0;level=-1;bad=false;blanking=false;nativeAddressStoreU32(gateMemory,0,0)
            val result=atomS3RDisplaySessionBeginOwned(record,panel,I2cDevice(9),gate,u32(7),2,3,requested,true)
            if (result != (if (fail == 0) 1 else if (fail <= 4) 3 else if (fail == 5) 5 else 4) || bad) return i32(1)
            if (calls != (if (fail == 0) 5 else if (fail <= 5) fail else 4) || panels != (if (fail > 0 && fail <= 4) 0 else 1)) return i32(2)
            if (fail == 0 && (record.loadU32(4) != 2 || record.loadU32(32) != requested || level != requested)) return i32(3)
            val before=calls
            if (atomS3RDisplaySessionBeginOwned(record,panel,I2cDevice(9),gate,u32(7),2,3,requested,true) != 2 || calls != before) return i32(4)
            if (fail != 0 && (atomS3RDisplaySessionBrightnessOwned(record,255,true) != 2 || calls != before)) return i32(5)
            if (fail == 0) {
                blanking=true
                val next=(requested+1)&255
                if (atomS3RDisplaySessionBrightnessOwned(record,next,true) != 1 || record.loadU32(32) != next || level != next) return i32(8)
                fail=calls+1
                if (atomS3RDisplaySessionBrightnessOwned(record,255,true) != 5 || record.loadU32(4) != 3 || record.loadU32(32) != next) return i32(9)
                fail=0
            }
            val oldFail=fail;fail=0;calls=0;blanking=true
            val beforePanels=panels
            if (atomS3RDisplaySessionBlankOwned(record,true) != 1 || record.loadU32(4) != 4 || level != 0 ||
                panels != beforePanels || calls != (if (oldFail >= 1 && oldFail <= 4) 4 else 1) || bad) return i32(6)
            if (oldFail == 6 && nativeAddressLoadU32(gateMemory,0) != 0x80000000) return i32(7)
            fail=oldFail+1
        }
        requested=requested+1
    }
    expectPrepare=true;fail=0
    while (fail <= 7) {
        var i=0;while (i < 40) { record.storeU32(i,0);i=i+4 }
        i=0;while (i < 108) { probe.storeU32(i,0);i=i+4 }
        probe.storeU32(0,0x41535033);probe.storeU32(4,2);probe.storeU32(8,18);probe.storeU32(12,2)
        probe.storeU32(16,gateMemory);probe.storeU32(20,7);probe.storeU32(24,0x079100);probe.storeU32(28,1)
        probe.storeU32(36,3);probe.storeU32(44,2);probe.storeU32(104,2)
        calls=0;panels=0;preparations=0;level=-1;bad=false;blanking=false;nativeAddressStoreU32(gateMemory,0,0)
        val result=atomS3RDisplayFromProbeOwned(record,probe,I2cDevice(9),3,100,3,true)
        val expected=if (fail == 0) 1 else if (fail <= 4) 3 else if (fail == 5) 5 else if (fail == 6) 4 else 6
        if (result != expected || bad || probe.loadU32(4) != 6 || preparations != (if (fail >= 1 && fail <= 4) 0 else 1) ||
            panels != (if ((fail >= 1 && fail <= 4) || fail == 7) 0 else 1)) return i32(10)
        val before=calls
        if (atomS3RDisplayFromProbeOwned(record,probe,I2cDevice(9),3,100,3,true) != 2 || calls != before) return i32(11)
        fail=fail+1
    }
    drawStatus=1
    while (drawStatus <= 6) {
        record.storeU32(0,0x41534433);record.storeU32(4,2);record.storeU32(8,panel|0)
        record.storeU32(16,gateMemory);record.storeU32(20,7);record.storeU32(24,2);record.storeU32(28,3)
        drawCalls=0;bad=false
        if (atomS3RDisplayFillOwned(record,0,0,2,2,Rgb565(0),true).status() != drawStatus || bad || drawCalls != 1 ||
            record.loadU32(4) != (if (drawStatus >= 4) 3 else 2)) return i32(12)
        if (drawStatus >= 4) {
            if (atomS3RDisplayBlitOwned(record,0,0,pixelData,2,2,4,false,NativeBuffer(0),true).status() != 3 || drawCalls != 1) return i32(13)
        } else {
            if (atomS3RDisplayBlitOwned(record,0,0,pixelData,2,2,4,false,NativeBuffer(0),true).status() != drawStatus || drawCalls != 2 || bad) return i32(14)
            if (atomS3RDisplayBlitOwned(record,0,0,record,2,2,4,false,NativeBuffer(0),true).status() != 3 || drawCalls != 2) return i32(15)
        }
        drawStatus=drawStatus+1
    }
    return i32(0)
}
