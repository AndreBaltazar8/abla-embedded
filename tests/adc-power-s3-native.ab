import "../src/esp32/adc_power_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var clock=0
var power=0
var busy=0
var writes=0
var drop=0
var bad=false
fun esp32S3SarRead(address: int): int {
    if (address == 0x60008904) return clock
    if (address == 0x6000883c) return power
    if (address == 0x60008840) return if (busy == 1) 0x400000 else 0
    if (address == 0x6000880c) return if (busy == 2) 0x20000 else 0
    if (address == 0x60008830) return if (busy == 3) 0x20000 else 0
    bad=true; return 0
}
fun esp32S3SarWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x60008904) clock=value
    else if (address == 0x6000883c) power=value
    else bad=true
    return
}
fun reset(mode: int,enabled: int): void {
    clock=0x80000055|(enabled<<30); power=0x800000aa|(mode<<29)
    writes=0; drop=0; busy=0; return
}
@export("abla_adc_power_s3_test")
fun test(): i32 {
    var mode=0
    while (mode < 4) {
        var enabled=0
        while (enabled < 2) {
            reset(mode,enabled)
            val expected=if (mode == 1) 2 else if (mode == 3 && enabled == 1) 1 else 3
            if (esp32S3AdcPowerOpenOwned(false).status() != expected || writes != 0) return i32(1)
            reset(mode,enabled)
            var token=esp32S3AdcPowerOpenOwned(true)
            if (mode == 1) {
                if (token.status() != 2 || writes != 0) return i32(2)
            } else {
                val changes=writes
                if (!token.powered() || clock != 0xc0000055 || power != 0xe00000aa) return i32(3)
                if (token.closeOwned().status() != 0 || clock != (0x80000055|(enabled<<30)) || power != (0x800000aa|(mode<<29))) return i32(4)
                var failed=1
                while (failed <= changes) {
                    reset(mode,enabled); drop=failed
                    token=esp32S3AdcPowerOpenOwned(true)
                    if (token.status() != 4 || writes != failed) return i32(5)
                    drop=0
                    if (token.closeOwned().status() != 0 || clock != (0x80000055|(enabled<<30)) || power != (0x800000aa|(mode<<29))) return i32(6)
                    reset(mode,enabled); token=esp32S3AdcPowerOpenOwned(true); writes=0; drop=failed
                    token=token.closeOwned()
                    if (token.status() != 4 || writes != failed) return i32(7)
                    drop=0
                    if (token.closeOwned().status() != 0 || clock != (0x80000055|(enabled<<30)) || power != (0x800000aa|(mode<<29))) return i32(8)
                    failed=failed+1
                }
            }
            enabled=enabled+1
        }
        mode=mode+1
    }
    reset(0,0)
    var token=esp32S3AdcPowerOpenOwned(true)
    writes=0; busy=1
    while (busy <= 3) {
        token=token.closeOwned()
        if (token.status() != 5 || writes != 0) return i32(9)
        busy=busy+1
    }
    busy=0; power=0xc00000aa
    if (token.closeOwned().status() != 6 || writes != 0) return i32(10)
    reset(3,1); token=esp32S3AdcPowerOpenOwned(false); clock=0x80000055
    if (token.closeOwned().status() != 6 || writes != 0 || bad) return i32(11)
    return i32(0)
}
