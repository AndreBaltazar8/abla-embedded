import "../src/storage/fat_link.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1024)
@export("abla_fat_link_test")
trusted fun test(): i32 {
    val a=nativeBufferAt(storage,512)
    val b=nativeBufferAt(storage+512,512)
    var word=0
    while (word < 65536) {
        a.store(511,word&255); b.store(0,word>>8)
        var odd=0
        while (odd < 2) {
            val location=FatLinkLocation((1<<44)|(odd<<43)|(1<<41)|(511<<32)|100)
            val value=if (odd == 0) word&4095 else word>>4
            val expected=if (value >= 4088) 2 else if (value == 4087) 4 else if (value == 0) 3 else if (value == 1 || value >= 4080) 5 else if (value >= 1002) 6 else 1
            val link=fatLinkDecode(location,1000,a,b)
            if (link.status() != expected || link.nextCluster() != (if (expected == 1) value else -1)) return i32(1)
            if (!location.needsSecondSector() || location.sector() != 100 || fatLinkDecode(location,1000,a,nativeBufferAt(0,0)).status() != 7) return i32(2)
            odd=odd+1
        }
        // FAT16 shares the same classification except its marker width.
        a.store(510,word&255); a.store(511,word>>8)
        val location=FatLinkLocation((1<<44)|(2<<41)|(510<<32)|100)
        val expected=if (word >= 65528) 2 else if (word == 65527) 4 else if (word == 0) 3 else if (word == 1 || word >= 65520) 5 else if (word >= 10002) 6 else 1
        if (fatLinkDecode(location,10000,a,nativeBufferAt(0,0)).status() != expected) return i32(3)
        word=word+1
    }
    val location=FatLinkLocation((1<<44)|(3<<41)|(508<<32)|100)
    a.store(508,123); a.store(509,0); a.store(510,0)
    var upper=0
    while (upper < 16) {
        a.store(511,upper<<4)
        if (fatLinkDecode(location,100000,a,nativeBufferAt(0,0)).nextCluster() != 123) return i32(4)
        upper=upper+1
    }
    if (fatLinkDecode(FatLinkLocation(0),1000,a,b).status() != 7 || fatLinkDecode(location,100000,nativeBufferAt(storage,511),b).status() != 7) return i32(5)
    var index=0
    while (index < 512) { a.store(index,0); index=index+1 }
    a.store(12,2); a.store(13,1); a.store(14,1); a.store(16,1)
    a.store(18,2); a.store(22,3); a.store(19,12); a.store(20,4)
    a.store(510,85); a.store(511,170)
    val cross=fatLinkLocate(a,100,1036,341)
    if (!cross.valid() || cross.sector() != 101 || cross.offset() != 511 || !cross.needsSecondSector()) return i32(6)
    a.store(14,32); a.store(16,2); a.store(18,0); a.store(22,0); a.store(19,0); a.store(20,0)
    // total102032 = 0x18e90, each FAT1000 sectors, clusters100000.
    a.store(32,144); a.store(33,142); a.store(34,1)
    a.store(36,232); a.store(37,3); a.store(44,2); a.store(40,129)
    val active=fatLinkLocate(a,100,102032,2)
    if (!active.valid() || active.sector() != 1132 || active.offset() != 8 || active.needsSecondSector()) return i32(7)
    a.store(40,1)
    if (fatLinkLocate(a,100,102032,2).sector() != 132 || fatLinkLocate(a,100,102032,100002).valid()) return i32(8)
    return i32(0)
}
