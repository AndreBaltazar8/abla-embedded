// Callable peripheral graph, not C5 boot or CPU wake-pin initialization.
import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/tough_boot.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_tough_boot_target")
trusted fun bootTarget(owner: M5Expanders,pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): M5ToughBoot =
    owner.configureToughPeripherals(pmic,presence,now)
