import "../src/esp32/power/sleep_prepare_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(200)
var fault=0
var captures=0
var uarts=0
var parks=0
var restores=0
var resumes=0
var finishes=0
var suspended=0
var parked=false
var restored=false
var bad=false
// CPU operations belong to the child clock model in this stage fixture.
trusted fun c5CpuClockRead(offset: int): int { bad=true;return 0 }
trusted fun c5CpuClockWrite(offset: int,value: int): void { bad=true;return }
trusted fun c5CpuClockTicks(mhz: int): void { bad=true;return }
trusted fun c5SleepPrepareTimeCapture(record: NativeBuffer,period: int,polls: int): int {
    captures=captures+1
    if (uarts != 0 || period != 0x123456 || polls != 64 || record.addressValue() != memory+40) bad=true
    if (fault == 1) return 4
    record.storeU32(0,0x43545331);return 1
}
trusted fun c5SleepPrepareUarts(ports: int,polls: int): int {
    uarts=uarts+1
    if (captures < 1 || parks != 0 || ports != 3 || polls != 64) bad=true
    if (fault == 2) { suspended=2;return 6|0x200|0x20000 }
    suspended=3;return 0x301
}
trusted fun c5SleepPreparePark(record: NativeBuffer,pvt: bool): int {
    if (record.loadU32(4) == 1 && record.loadU32(0) != 0) return 1
    parks=parks+1
    if (suspended != 3 || !pvt) bad=true
    if (fault == 3) return 2
    record.storeU32(0,0x43504b31);record.storeU32(12,3|(1<<2)|(5<<10)|(40<<18))
    if (fault == 4) return 3
    record.storeU32(4,1);parked=true;return 1
}
trusted fun c5SleepPrepareRestore(record: NativeBuffer,plan: C5CpuClock,pvt: bool): int {
    restores=restores+1
    if (!parked || suspended != 3 || !pvt || (plan|0) != (3|(1<<2)|(5<<10)|(40<<18)) || record.addressValue() != memory+128) bad=true
    if (fault == 5) return 4
    restored=true;return 1
}
trusted fun c5SleepPrepareUartsResume(token: int): int {
    resumes=resumes+1
    if (parked && !restored || ((token>>>8)&3) != suspended) bad=true
    if (fault == 2 || fault == 6) {
        suspended=2
        return (token&~0x300)|0x200
    }
    suspended=0;return 0
}
trusted fun c5SleepPrepareTimeCancel(record: NativeBuffer): int {
    finishes=finishes+1
    if (suspended != 0 || parked && !restored || record.addressValue() != memory+40) bad=true
    if (fault == 7) return 3
    return 1
}
@export("abla_sleep_prepare_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,192)
    var scenario=0
    while (scenario < 8) {
        var i=0;while (i < 200) { nativeBufferAt(memory,200).store(i,0);i=i+1 }
        nativeBufferAt(memory,200).storeU32(192,0x12345678)
        fault=scenario;captures=0;uarts=0;parks=0;restores=0;resumes=0;finishes=0;suspended=0;parked=false;restored=false;bad=false
        val result=esp32C5SleepPrepareOwned(record,0x123456,3,64,true,true)
        if (result != (if (scenario >= 1 && scenario <= 4) 3 else 1)) return i32(1)
        val before=captures+uarts+parks+restores+resumes+finishes
        if (esp32C5SleepPrepareOwned(record,0x123457,3,64,true,true) != 2 ||
            esp32C5SleepPrepareCancelOwned(record,false) != 2 || captures+uarts+parks+restores+resumes+finishes != before) return i32(2)
        val cancelled=esp32C5SleepPrepareCancelOwned(record,true)
        if (cancelled != 3 && cancelled != 4) return i32(3)
        // Retry cancellation via the same preparation entry; it must never
        // capture again, suspend UART again, or return to preparation.
        val captured=captures;val prepared=uarts
        fault=0
        if (esp32C5SleepPrepareOwned(record,0x123456,3,64,true,true) != 4 ||
            captures != captured || uarts != prepared || suspended != 0 || bad ||
            nativeBufferAt(memory,200).loadU32(192) != 0x12345678) return i32(4)
        if (scenario == 1 && (uarts != 0 || parks != 0 || restores != 0 || resumes != 0 || finishes != 0)) return i32(5)
        if ((scenario == 2 || scenario == 3) && restores != 0) return i32(6)
        val done=captures+uarts+parks+restores+resumes+finishes
        if (esp32C5SleepPrepareCancelOwned(record,true) != 4 || done != captures+uarts+parks+restores+resumes+finishes) return i32(7)
        scenario=scenario+1
    }
    record.storeU32(0,0x43504b31)
    if (esp32C5SleepPrepareOwned(record,0x123456,3,64,true,true) != 2 || record.loadU32(0) != 0x43504b31) return i32(8)
    return i32(0)
}
