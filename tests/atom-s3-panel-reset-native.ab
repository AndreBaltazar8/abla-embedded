import "../src/m5stack/atom_s3_panel_reset_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
var expected=34
var calls=0
var fail=0
var elapsed=0
var high=false
var partial=false
var bad=false
fun Pin.outputLevelOwned(level: bool): bool {
    if (calls != 0 || !level) bad=true
    return this.writeLevelOwned(level)
}
fun Pin.writeLevelOwned(level: bool): bool {
    calls=calls+1
    if (this != Pin(expected)) bad=true
    if (calls != fail || partial) high=level
    return calls != fail
}
fun peripheralDelayMilliseconds(ms: int): void {
    if ((ms == 1 && (!high || calls != 1)) || (ms == 2 && (high || calls != 2)) ||
        (ms == 10 && !high)) bad=true
    elapsed=elapsed+ms;return
}
fun seed(): void { calls=0;elapsed=0;high=false;bad=false;return }
@export("abla_atom_s3_panel_reset_test")
trusted fun test(): i32 {
    var board=11
    while (board <= 18) {
        expected=if (board == 11) 34 else 48
        fail=0
        while (fail <= 3) {
            var commit=0
            while (commit < 2) {
                seed();partial=commit != 0
                val result=M5BoardId(board).resetAtomPanelOwned(true,true)
                if (result != (if (fail == 0) 1 else fail+2) || calls != (if (fail == 0) 3 else fail) || bad ||
                    elapsed != (if (fail == 0) 13 else if (fail == 1) 0 else if (fail == 2) 1 else 3)) return i32(1)
                val failure=fail;fail=0;calls=0;elapsed=0
                if (!M5BoardId(board).releaseAtomPanelResetOwned(true) || !high || elapsed != 10 || calls != 1 || bad) return i32(2)
                fail=failure;commit=commit+1
            }
            fail=fail+1
        }
        seed();fail=0
        if (M5BoardId(board).resetAtomPanelOwned(false,true) != 1 || elapsed != 1 || calls != 1 || !high || bad) return i32(3)
        seed()
        if (M5BoardId(board).resetAtomPanelOwned(true,false) != 2 || calls != 0 ||
            M5BoardId(0).resetAtomPanelOwned(true,true) != 2 || calls != 0) return i32(4)
        board=board+7
    }
    return i32(0)
}
