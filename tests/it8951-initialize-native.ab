import "../src/display/it8951_device.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(48)
var selected=false
var bad=false
var words=0
var failWord=0
var infoWidth=960
var infoHeight=540
var infoAddress=0x001236e0
var delays=0
fun it8951TransportValid(context: int): bool = context == 7
fun it8951TransportSelect(context: int,active: bool): bool {
    if (context != 7 || (active && selected)) bad=true
    selected=active;return true
}
fun it8951TransportReady(context: int): int = if (context == 7) 1 else -1
fun it8951TransportDelay(context: int,us: int): void {
    if (context != 7 || us != 1000) bad=true
    delays=delays+1;return
}
fun it8951TransportExchange(context: int,word: int): int {
    words=words+1
    var expected=0
    if (words == 1 || words == 25 || words == 27 || words == 33 || words == 39) expected=24576
    else if (words == 2) expected=770
    else if (words == 3) expected=4096
    else if (words == 26 || words == 32) expected=1
    else if (words == 28 || words == 34 || words == 40) expected=17
    else if (words == 30) expected=4
    else if (words == 36) expected=522
    else if (words == 38) expected=infoAddress>>>16
    else if (words == 42) expected=520
    else if (words == 44) expected=infoAddress&65535
    if (context != 7 || !selected || word != expected || words > 44) bad=true
    if (words == failWord) return -1
    if (words == 5) return infoWidth
    if (words == 6) return infoHeight
    if (words == 7) return infoAddress&65535
    if (words == 8) return infoAddress>>>16
    if (words >= 9 && words <= 24) return 0x4100+words
    0
}
trusted fun runInit(): It8951Initialization {
    selected=false;bad=false;words=0;delays=0
    val data=nativeBufferAt(memory,48)
    var index=0
    while (index < 48) { data.store(index,165);index=index+1 }
    it8951Initialize(7,nativeBufferAt(memory+4,40),3)
}
@export("abla_it8951_initialize_test")
trusted fun testInitialization(): i32 {
    val response=nativeBufferAt(memory+4,40)
    failWord=0
    val complete=runInit()
    val info=it8951DeviceInfo(response)
    if (!complete.success() || words != 44 || selected || bad || delays != 1 ||
        !info.valid() || info.width() != 960 || info.height() != 540 || info.imageAddress() != 0x001236e0) return i32(1)
    var index=4
    while (index < 20) { if (response.loadU16(index*2) != 0x4105+index) return i32(2);index=index+1 }
    failWord=1
    while (failWord <= 44) {
        val failed=runInit()
        val stage=if (failWord <= 24) 1 else if (failWord <= 26) 3 else if (failWord <= 32) 4 else if (failWord <= 38) 5 else 6
        if (failed.status() != 4 || failed.stage() != stage || words != failWord || selected || bad) return i32(3)
        if (nativeBufferAt(memory,48).loadU32(0) != 0xa5a5a5a5 || nativeBufferAt(memory,48).loadU32(44) != 0xa5a5a5a5) return i32(4)
        failWord=failWord+1
    }
    failWord=0
    var variant=0
    while (variant < 6) {
        infoWidth=if (variant == 0) 0 else 960
        infoHeight=if (variant == 1) 0 else 540
        infoAddress=if (variant == 2) 0 else if (variant == 3) 4294967295 else if (variant == 4) 4294967296-960*540+1 else 4294967296-960*540
        val result=runInit()
        if (variant < 5) {
            if (result.status() != 6 || result.stage() != 2 || words != 24 || it8951DeviceInfo(response).valid()) return i32(5)
        } else if (!result.success() || words != 44 || !it8951DeviceInfo(response).valid()) return i32(6)
        if (selected || bad) return i32(7)
        variant=variant+1
    }
    words=0;delays=0
    if (it8951Initialize(0,response,3).status() != 2 || it8951Initialize(7,response,0).status() != 2 ||
        it8951Initialize(7,nativeBufferAt(memory,39),3).status() != 2 || words != 0 || delays != 0 ||
        it8951DeviceInfo(nativeBufferAt(memory,39)).valid() || it8951DeviceInfo(nativeBufferAt(0,40)).valid()) return i32(8)
    i32(0)
}
