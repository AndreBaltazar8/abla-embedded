import "../src/sd/mmc_command_esp32s3.ab"
import "../src/sd/mmc_frequency.ab"
import "../src/sd/mmc_host_clock_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_frequency_target")
trusted fun target(source: int,maximum: int,operation: int,pll: bool,ready: bool): int {
    val plan=sdMmcFrequency(source,maximum)
    if (!plan.valid()) return -1
    if (operation == 0) return plan.actualHz()
    return sdMmcHostClockConfigureOwned(plan.hostDivider(),pll,ready)
}
