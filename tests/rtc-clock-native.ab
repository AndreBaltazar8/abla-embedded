import "../src/m5stack/rtc_clock_sequence.ab"
import "../src/esp32/unix_time_set_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val scratch=nativeStaticAllocate(24)
var expected=0
var calls=0
var bad=false
var failure=false
fun esp32SetUnixTimeValue(address: int): int {
    calls=calls+1
    val value=nativeBufferAt(address,16)
    if (address != scratch+4 || value.loadU32(0) != (expected & 0xFFFFFFFF) ||
        value.loadU32(4) != ((expected>>>32) & 0xFFFFFFFF) ||
        value.loadU32(8) != 0 || value.loadU32(12) != 0) bad=true
    if (failure) -1 else 0
}
trusted fun setUnixTimeSeconds(seconds: int): bool =
    esp32SetUnixTimeWithBuffer(seconds,nativeBufferAt(scratch+4,16))
@export("abla_rtc_clock_test")
trusted fun clockTest(): i32 {
    val outer=nativeBufferAt(scratch,24)
    var variant=0
    while (variant < 12) {
        val sample=variant/2
        expected=if (sample == 0) 0 else if (sample == 1) 1 else if (sample == 2) 2147483648
            else if (sample == 3) 4294967296 else if (sample == 4) 253402300799 else 9223372036854
        failure=(variant & 1) != 0; calls=0; bad=false
        outer.storeU32(0,0x12345678); outer.storeU32(20,0x87654321)
        if (setUnixTimeSeconds(expected) == failure || calls != 1 || bad ||
            outer.loadU32(0) != 0x12345678 || outer.loadU32(20) != 0x87654321) return i32(1)
        if (sample < 4) {
            calls=0
            if (m5RtcSynchronizeClock(rtcDateTimeFromUnixSeconds(expected)) == failure || calls != 1 || bad) return i32(2)
        }
        variant=variant+1
    }
    calls=0
    outer.storeU32(4,0xAABBCCDD)
    if (setUnixTimeSeconds(9223372036855) || setUnixTimeSeconds(-9223372036855) ||
        setUnixTimeSeconds(-1) || setUnixTimeSeconds(-62167219200) ||
        m5RtcSynchronizeClock(rtcCalendarDateTime(1900,1,1,0,0,0)) ||
        esp32SetUnixTimeWithBuffer(0,nativeBufferAt(scratch+4,15)) ||
        esp32SetUnixTimeWithBuffer(0,nativeBufferAt(0,16)) ||
        m5RtcSynchronizeClock(RtcDateTime(0)) ||
        m5RtcSynchronizeClock(rtcDateTime(1900,2,29,0,0,0,0)) || calls != 0 ||
        outer.loadU32(4) != 0xAABBCCDD) return i32(3)
    i32(0)
}
