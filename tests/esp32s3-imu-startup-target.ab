import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/imu_startup.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/m5stack/imu_owner_types.ab"
import "../src/imu/snapshot.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/imu/calibration.ab"
import "../src/imu/offsets.ab"
import "../src/m5stack/imu_calibrated_update_sequence.ab"
import "../src/esp32/sdk/nativebuffer_type.ab"
@export("abla_imu_startup_target")
trusted fun startupTarget(owner: M5ImuOwner,snapshot: ImuSnapshot,scratch: NativeBuffer,
    micros: int,calibration: ImuCalibration,offsets: ImuOffsets,initialized: int): M5ImuCalibratedUpdate =
    owner.updateStartup(snapshot,scratch,micros,calibration,offsets,initialized)
