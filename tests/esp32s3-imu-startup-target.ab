import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/imu_startup.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_startup_target")
trusted fun startupTarget(owner: M5ImuOwner,snapshot: ImuSnapshot,scratch: NativeBuffer,
    micros: int,calibration: ImuCalibration,offsets: ImuOffsets,initialized: int): M5ImuCalibratedUpdate =
    owner.updateStartup(snapshot,scratch,micros,calibration,offsets,initialized)
