import "./unit-lcd-rle-wire-native.ab"
import "../src/display/unit_lcd_owner_software.ab"
@export("abla_unit_lcd_owner_wire_test")
trusted fun testLcdOwnerWire(): i32 {
    wireSeed();extraAddress=62;extraCanRead=true;extraReadValue=255;extraReadAddress=lcdReply;extraReadCommand=4
    val reply=nativeBufferAt(lcdReply,256);reply.store(0,119);reply.store(1,137);reply.store(3,91)
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64));val scratch=nativeBufferAt(lcdMemory,16)
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val bus=control.session().bus()
    expectedCount=0;lcdExpectStart(124);expectByte(4);lcdExpectStart(125)
    var setup=5
    while (setup <= 10) {
        lcdExpectStart(124);expectByte(9);lcdExpectStart(125);lcdExpectStart(124)
        expectByte(if (setup == 5) 56 else if (setup == 6) 57 else if (setup == 7) 58 else if (setup == 8) 54 else if (setup == 9) 32 else 34)
        if (setup != 9) expectByte(if (setup == 5 || setup == 7) 1 else if (setup == 6) 0 else if (setup == 8) 7 else 99)
        setup=setup+1
    }
    val e=nativeBufferAt(oledExpected,16384);val capture=nativeBufferAt(extraWire,8192)
    var failure=0
    while (failure <= 38) {
        var commit=0
        while (commit < 2) {
            extraCount=0;val before=ackCount;nackAfterCommit=commit == 1
            if (unitLcdOpenOwned(bus,scratch,false).status() != 2 || unitLcdOpenOwned(bus,nativeBufferAt(softwareI2cProviderState,32),true).status() != 2 || ackCount != before) return i32(2)
            nackAt=if (failure == 0) 0 else before+failure
            var owner=unitLcdOpenOwned(bus,scratch,true,7,true,99,1)
            val step=if (failure <= 3) 4 else if (failure <= 9) 5 else if (failure <= 15) 6 else if (failure <= 21) 7 else if (failure <= 27) 8 else if (failure <= 32) 9 else 10
            val start=if (step == 5) 4 else if (step == 6) 10 else if (step == 7) 16 else if (step == 8) 22 else if (step == 9) 28 else 33
            val detail=if (failure == 0 || step == 4) 0 else if (failure-start < 3) 3 else 5
            if (owner.status() != (if (failure == 0) 1 else step) || owner.openFailure() != (if (failure == 0) 0 else step) || owner.detail() != detail || owner.ready() != (failure == 0) || !owner.device().valid() || owner.rotation() != 7 || !owner.byteSwap() || ackCount-before != (if (failure == 0) 38 else failure) || bad) return i32(3)
            val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && e.load((failure-1)*4) > 1) 1 else 0)
            if (extraCount != accepted) return i32(9)
            var at=0;while (at < accepted) {
                if (capture.load(at*2) != e.load(at*4) || capture.load(at*2+1) != e.load(at*4+1)) return i32(10)
                at=at+1
            }
            val handle=owner.device();val original=owner.openFailure();val firmware=owner.firmware()
            nackAt=0
            val untouched=ackCount
            if (owner.closeOwned(scratch,false) != owner || owner.closeOwned(nativeBufferAt(softwareI2cProviderState,32),true) != owner || ackCount != untouched) return i32(4)
            var fault=1
            while (fault <= 9) {
                nackAt=ackCount+fault
                owner=owner.closeOwned(scratch,true,1)
                if (owner.status() != 6 || owner.detail() != (if (fault <= 3 || fault >= 7) 3 else 5) || owner.device() != handle || owner.openFailure() != original || owner.firmware() != firmware || bad) return i32(5)
                fault=fault+1
            }
            nackAt=0;owner=owner.closeOwned(scratch,true,1)
            if (owner.status() != 0 || (owner.device()|0) != 0 || owner.openFailure() != original || !control.ready()) return i32(6)
            val closed=ackCount
            if (owner.closeOwned(scratch,true) != owner || owner.fill16Owned(0,0,1,1,0,scratch,true) != 2 || ackCount != closed) return i32(7)
            commit=commit+1
        }
        failure=failure+1
    }
    nackAfterCommit=false
    extraCount=0;reply.store(0,0)
    var rejected=unitLcdOpenOwned(bus,scratch,true)
    if (rejected.status() != 4 || rejected.ready() || extraCount != 3) return i32(11)
    reply.store(0,119);rejected=rejected.closeOwned(scratch,true)
    if (rejected.status() != 0 || rejected.openFailure() != 4) return i32(12)
    extraCount=0;extraReadValue=0;lcdWaited=0
    var starved=unitLcdOpenOwned(bus,scratch,true,0,false,128,2)
    if (starved.status() != 5 || starved.detail() != 4 || extraCount != 9 || lcdWaited != 2000) return i32(13)
    val retained=starved.device();starved=starved.closeOwned(scratch,true,1)
    if (starved.status() != 6 || starved.detail() != 4 || starved.device() != retained) return i32(14)
    extraReadValue=255;starved=starved.closeOwned(scratch,true)
    if (starved.status() != 0 || starved.openFailure() != 5) return i32(15)
    if (!control.closeOwned(true) || pads != 0 || bad) return i32(8)
    return i32(0)
}
