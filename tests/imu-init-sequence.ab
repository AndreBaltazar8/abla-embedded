import "../src/imu/mpu6886_device.ab"
import "../src/imu/sh200q_device.ab"

// Actual driver methods, fake transport. No sensor or raw memory access.
type I2cBus = int
type I2cDevice = int
var shMode=false
var step=0
var failure=-1
var mismatch=false
var expectedValue=0
var matchAt=1
var writes=0
var reads=0
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice = I2cDevice(1)
// Unused transport operations fail the fixture if unexpectedly reached.
fun I2cDevice.close(): bool { mismatch=true; return false }
fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,length: int): bool {
    mismatch=true; return false
}
fun I2cDevice.writeRegister(register: int,buffer: NativeBuffer,length: int): bool {
    mismatch=true; return false
}
fun I2cDevice.readRegister16BigEndianChecked(register: int): I2cWordResult {
    mismatch=true; return I2cWordResult(0)
}
fun expectedSh(index: int): int {
    if (index == 0) return 300048
    if ((index & 1) != 0) return 400001
    val operation=index/2
    if (operation == 1) return 200000+194*256+4
    if (operation == 2) return 200000+194*256
    if (operation == 3) return 200000+216*256+128
    if (operation == 4) return 200000+216*256
    if (operation == 5) return 120*256+97
    if (operation == 6) return 120*256
    if (operation == 7) return 14*256+145
    if (operation == 8) return 15*256+19
    if (operation == 9) return 17*256+3
    if (operation == 10) return 18*256
    if (operation == 11) return 20*256+32
    if (operation == 12) return 22*256+1
    if (operation == 13) return 43*256
    if (operation == 14) return 186*256+192
    if (operation == 15) return 200000+202*256+16
    if (operation == 16) return 200000+202*256
    return -1
}
fun event(value: int): bool {
    if (value != expectedSh(step)) mismatch=true
    val ok=step != failure
    step=step+1
    ok
}
fun I2cDevice.readRegister8(register: int): int =
    if (event(300000+register)) 24 else 0
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    if (mask != (if (register == 194) 4 else if (register == 216) 128 else 16)) mismatch=true
    event(200000+register*256+value)
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    if (shMode) return event(register*256+value)
    if (register != 56 || value != expectedValue) mismatch=true
    writes=writes+1
    failure != 1
}
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    if (register != 56 || reads+1 != writes) mismatch=true
    reads=reads+1
    if (failure == 2) return I2cByteResult(0)
    I2cByteResult(256 | (if (reads >= matchAt) expectedValue else expectedValue ^ 1))
}
fun imuDelay(ticks: int): void {
    if (!shMode) mismatch=true
    event(400000+ticks)
    return
}
fun main(): int {
    expectedValue=0
    while (expectedValue < 256) {
        matchAt=1
        while (matchAt <= 17) {
            failure=0
            while (failure <= 2) {
                writes=0; reads=0; mismatch=false
                val result=Mpu6886(1).writeRegister8Verified(56,expectedValue)
                val attempts=if (failure != 0) 1 else if (matchAt > 16) 16 else matchAt
                if (result != (failure == 0 && matchAt <= 16) || mismatch ||
                    writes != attempts || reads != (if (failure == 1) 0 else attempts)) return 1
                failure=failure+1
            }
            matchAt=matchAt+1
        }
        expectedValue=expectedValue+1
    }
    writes=0; reads=0
    if (Mpu6886(0).writeRegister8Verified(56,0) || writes != 0 || reads != 0) return 2
    shMode=true; failure=-1; step=0; mismatch=false
    if (Sh200q(1).begin() != 3 || step != 34 || mismatch) return 3
    failure=0
    while (failure <= 32) {
        step=0; mismatch=false
        if (Sh200q(1).begin() != 0 || step != failure+1 || mismatch) return 4
        failure=failure+2
    }
    step=0
    if (Sh200q(0).begin() != 0 || step != 0) return 5
    0
}
