import "../src/sd/mmc_read_multiple_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_read_multiple_target")
trusted fun target(operation: int,address: int,card: int,descriptor: int,payload: int,sectors: int,sector: int,now: u32,budget: int,released: bool): int {
    val context=nativeBufferAt(address,72)
    if (operation == 0) return sdMmcReadMultipleBeginOwned(context,nativeBufferAt(card,80),nativeBufferAt(descriptor,sdMmcDmaDescriptorCount(sectors<<9)*16),nativeBufferAt(payload,sectors<<9),sector,sectors,now,budget,released)
    return sdMmcReadMultiplePollOwned(context,now)
}
