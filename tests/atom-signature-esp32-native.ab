import "../src/m5stack/atom_signature_esp32_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val regs=nativeBufferAt(nativeStaticAllocate(24576),24576)
var pattern=0
var inputs=0
var writes=0
var drop=-1
var waited=false
var bad=false
fun classicProbeRead(address: int): int {
    if (address == 0x3FF4403C || address == 0x3FF44040) {
        val pin=if (inputs%3 == 0) 33 else if (inputs%3 == 1) 19 else 22
        if (inputs > 5 || address != (if (pin == 33) 0x3FF44040 else 0x3FF4403C) || (inputs >= 3 && !waited)) bad=true
        val high=(pattern&(1<<(5-inputs))) != 0
        inputs=inputs+1
        return if (high) 1<<(pin&31) else 0
    }
    if (address >= 0x3FF44000 && address < 0x3FF4A000 && (address&3) == 0) return regs.loadU32(address-0x3FF44000)
    bad=true; return 0
}
fun classicProbeWrite(address: int,value: int): void {
    val n=writes; writes=writes+1
    if (n == drop) return
    if (address == 0x3FF44024 || address == 0x3FF44028 || address == 0x3FF44030 || address == 0x3FF44034) {
        val base=if (address < 0x3FF44030) 32 else 44
        val set=address == 0x3FF44024 || address == 0x3FF44030
        regs.storeU32(base,if (set) regs.loadU32(base)|value else regs.loadU32(base)&~value)
    } else if (address >= 0x3FF44000 && address < 0x3FF4A000 && (address&3) == 0) regs.storeU32(address-0x3FF44000,value)
    else bad=true
    return
}
fun m5AtomSignatureDelayMilliseconds(ms: int): void {
    if (ms != 1 || inputs != 3 || (regs.loadU32(0x448C)&0x18000000) != 0 ||
        (regs.loadU32(0x5000+esp32IoMuxOffset(19))&0x180) != 0 || (regs.loadU32(0x5000+esp32IoMuxOffset(22))&0x180) != 0) bad=true
    waited=true; return
}
@export("abla_atom_signature_esp32_test")
fun test(): i32 {
    val r=nativeBufferAt(nativeStaticAllocate(128),128)
    pattern=0
    while (pattern < 64) {
        var fault=-1
        while (fault < 32) {
            var offset=0
            while (offset < 24576) { regs.storeU32(offset,0); offset=offset+4 }
            regs.storeU32(32,0xFFFFFFFF); regs.storeU32(44,0xFFFFFFFF)
            r.storeU32(0,0); inputs=0; writes=0; drop=fault; waited=false; bad=false
            val result=m5AtomSignatureProbeOwned(r,true)
            if (result != 1 && result != 3 && result != 4) return i32(1)
            if (result == 1 && (inputs != 6 || !waited || m5AtomSignatureValue(r) != pattern)) return i32(2)
            if (result == 3 && m5AtomSignatureValue(r) != -1) return i32(3)
            if (result == 4) {
                if (m5AtomSignatureValue(r) != -1) return i32(4)
                drop=-1
                if (m5AtomSignatureCloseOwned(r) != 1) return i32(5)
            }
            if (bad || r.loadU32(4) != 5) return i32(6)
            offset=0
            while (offset < 24576) {
                if (regs.loadU32(offset) != (if (offset == 32 || offset == 44) 0xFFFFFFFF else 0)) return i32(7)
                offset=offset+4
            }
            fault=fault+1
        }
        pattern=pattern+1
    }
    writes=0
    if (m5AtomSignatureProbeOwned(r,false) != 2 || writes != 0) return i32(8)
    i32(0)
}
