import "../src/led/rmt_strip_state.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
val state=nativeBufferAt(nativeStaticAllocate(88),88)
val source=nativeBufferAt(nativeStaticAllocate(24),24)
val expected=nativeBufferAt(nativeStaticAllocate(24),24)
@export("abla_rmt_led_buffer_test")
trusted fun test(): i32 {
    var from=0
    while (from <= 8) {
        var to=0
        while (to <= 8) {
            var length=0
            while (length <= 10) {
                val strip=rmtLedStripAt(state,7,8)
                var byte=0
                while (byte < 24) { state.store(40+byte,byte+1); expected.store(byte,byte+1); byte=byte+1 }
                val amount=if (length > 8-to) 8-to else length
                val valid=amount <= 8-from
                if (valid) {
                    byte=0
                    while (byte < amount*3) { expected.store(to*3+byte,from*3+byte+1); byte=byte+1 }
                }
                val colors=nativeBufferAt(state.addressValue()+40+from*3,(8-from)*3)
                if (strip.storeColors(colors,to,length) != valid) return i32(1)
                byte=0
                while (byte < 24) { if (state.load(40+byte) != expected.load(byte)) return i32(2); byte=byte+1 }
                if (state.load(19) != 63 || state.load(21) != 1 || state.loadU16(16) != 8) return i32(3)
                length=length+1
            }
            to=to+1
        }
        from=from+1
    }
    val strip=rmtLedStripAt(state,7,8)
    if (!strip.storeAllColor(rgbColor(1,2,3))) return i32(4)
    var index=0
    while (index < 8) { if (strip.color(index) != rgbColor(1,2,3)) return i32(5); index=index+1 }
    index=0
    while (index < 256) { if (!strip.storeBrightness(index) || strip.brightness() != index) return i32(6); index=index+1 }
    if (strip.storeBrightness(-1) || strip.storeBrightness(256) || strip.brightness() != 255 ||
        strip.storeColors(source,-1,1) || strip.storeColors(source,9,1) || strip.storeColors(source,0,-1)) return i32(7)
    if (RmtLedStrip(0).storeBrightness(1) || RmtLedStrip(0).storeAllColor(rgbColor(0,0,0)) || RmtLedStrip(0).storeColors(source,0,1)) return i32(8)
    return i32(0)
}
