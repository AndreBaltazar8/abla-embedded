import "../src/esp32/power/retention_timeout_p4_sequence.ab"
import "../src/esp32/power/retention_enable_p4_sequence.ab"
var active=u32(0)
var sleep=u32(0)
fun p4RetentionPmuRead(offset: int): u32 {
    if (offset == 28) return active
    if (offset == 132) return sleep
    bad=true;return u32(0)
}
fun p4RetentionPmuWrite(offset: int,value: u32): void {
    val mask=if (offset == 28) u32(0x20000000) else u32(0x80000000)
    if ((offset != 28 && offset != 132) || (value&~mask) != (p4RetentionPmuRead(offset)&~mask)) bad=true
    writes=writes+1
    if (writes != drop) { if (offset == 28) active=value else sleep=value }
    return
}
var pau=u32(0xaabbccdd)
var lp=u32(0x12345678)
var writes=0
var drop=0
var ready=true
var raw=u32(0)
var flow=u32(0)
var reads=0
var delay=0
var bad=false
fun p4RetentionClockReady(): bool = ready
fun p4RetentionPauRead(offset: int): u32 {
    if (offset == 44) return pau
    if (offset == 52) { reads=reads+1;return if (reads > delay) raw else u32(0) }
    if (offset == 0) return if (reads > delay) flow else u32(0)
    bad=true;return u32(0)
}
fun p4RetentionPauWrite(offset: int,value: u32): void {
    if (offset != 44 || (value&u32(0xfffe0000)) != (pau&u32(0xfffe0000))) bad=true
    writes=writes+1;if (writes != drop) pau=value;return
}
fun p4RetentionLpRead(offset: int): u32 { if (offset != 340) bad=true;return lp }
fun p4RetentionLpWrite(offset: int,value: u32): void {
    if (offset != 340 || (value&u32(31)) != (lp&u32(31))) bad=true
    writes=writes+1;if (writes != drop) lp=value;return
}
fun seed(): void {
    pau=u32(0xaabbccdd);lp=u32(0x12345678);writes=0;drop=0;ready=true;raw=u32(0);flow=u32(0);reads=0;delay=0;bad=false;return
}
@export("abla_retention_timeout_p4_test")
trusted fun test(): i32 {
    var fault=0
    while (fault <= 4) {
        seed();if (fault <= 2) drop=fault
        val token=esp32p4RetentionTimeoutOpenOwned(1023,127,200,300,50,true)
        if (!token.hasSnapshot() || token.status() != (if (fault == 1 || fault == 2) 4 else 1)) return i32(1)
        if (fault > 2) drop=writes+fault-2 else drop=0
        val closed=token.closeOwned(true)
        if (closed.status() != (if (fault > 2) 4 else 5)) return i32(2)
        drop=0
        val done=closed.closeOwned(true)
        if (done.status() != 5 || pau != u32(0xaabbccdd) || lp != u32(0x12345678) || bad) return i32(3)
        val count=writes
        if (done.closeOwned(true) != done || writes != count) return i32(4)
        fault=fault+1
    }
    seed();val owned=esp32p4RetentionTimeoutOpenOwned(1,1,1,1,1,true);ready=false
    val clockLost=owned.closeOwned(true)
    if (clockLost.status() != 3 || writes != 2) return i32(5)
    ready=true
    if (clockLost.closeOwned(true).status() != 5) return i32(6)
    var errors=0
    while (errors < 32) {
        seed();raw=u32(errors&3);flow=u32(errors>>>2);delay=3
        val expected=if (flow != u32(0)) 4 else if ((errors&2) != 0) 5 else if ((errors&1) != 0) 1 else 6
        val result=esp32p4RetentionWaitOwned(4,true)
        if ((result&255) != expected || reads != 4 || writes != 0 || bad ||
            (expected != 6 && (result>>>8) != (((errors&3)<<8)|(errors>>>2)))) return i32(7)
        errors=errors+1
    }
    seed()
    if (esp32p4RetentionTimeoutOpenOwned(0,1,1,1,1,true).status() != 2 ||
        esp32p4RetentionTimeoutOpenOwned(1,128,1,1,1,true).status() != 2 ||
        esp32p4RetentionTimeoutOpenOwned(1,1,1024,1,1,true).status() != 2 ||
        esp32p4RetentionWaitOwned(0,true) != 2 || esp32p4RetentionWaitOwned(1,false) != 2 || writes != 0 || reads != 0) return i32(8)
    var originals=0
    while (originals < 4) {
        fault=0
        while (fault <= 4) {
            seed();active=u32(0x81234567)|u32((originals&1)<<29);sleep=u32(0x12345678)|u32((originals>>>1)<<31)
            val oldActive=active;val oldSleep=sleep
            if (fault <= 2) drop=fault
            val owner=esp32p4RetentionEnableOpenOwned(true)
            val openFailed=(fault == 1 && (originals&2) == 0) || (fault == 2 && (originals&1) == 0)
            if (!owner.hasSnapshot() || owner.status() != (if (openFailed) 3 else 1)) return i32(9)
            val closeFails=(fault == 3 && active != oldActive) || (fault == 4 && sleep != oldSleep)
            if (fault > 2) drop=writes+fault-2 else drop=0
            val closed=owner.closeOwned(true)
            if (closed.status() != (if (closeFails) 3 else 4)) return i32(12)
            drop=0
            if (closed.closeOwned(true).status() != 4 || active != oldActive || sleep != oldSleep || bad) return i32(10)
            fault=fault+1
        }
        originals=originals+1
    }
    seed()
    if (esp32p4RetentionEnableOpenOwned(false).status() != 2 || writes != 0) return i32(11)
    return i32(0)
}
