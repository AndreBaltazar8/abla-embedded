import "../src/esp32/gdma_sleep_s3_sequence.ab"
import "abla/build"
var gdmaSleepClock=64
var gdmaSleepReset=0
var gdmaSleepBusy=0
var gdmaSleepCommand=0
var gdmaSleepFifo=0
var gdmaSleepReads=0
var gdmaSleepClockChange=false
var gdmaSleepBad=false
fun esp32S3GdmaSleepRead(address: int): int {
    gdmaSleepReads=gdmaSleepReads+1
    if (address == 0x600C001C) return gdmaSleepClock^(if (gdmaSleepClockChange && gdmaSleepReads > 2) 64 else 0)
    if (address == 0x600C0024) return gdmaSleepReset
    if (gdmaSleepClock == 0 || gdmaSleepReset != 0) gdmaSleepBad=true
    val offset=address-0x6003F000;val index=offset/96;val reg=offset%96;val tx=(index&1) != 0
    if (index < 0 || index > 9 || (reg != 24 && reg != 32)) { gdmaSleepBad=true;return 0 }
    if (reg == 24) return (if (tx) 0xFF80002A else 0xFF00002A)^gdmaSleepFifo
    return (if (((gdmaSleepBusy>>>index)&1) == 0) (if (tx) 1<<23 else 1<<24) else 0) | (gdmaSleepCommand<<(if (tx) 20 else 21)) | 0x80008000
}
@export("abla_gdma_sleep_s3_test")
fun testGdmaSleep(): int {
    gdmaSleepClock=64;gdmaSleepReset=0;gdmaSleepCommand=0;gdmaSleepFifo=0;gdmaSleepClockChange=false
    gdmaSleepBusy=0
    while (gdmaSleepBusy < 1024) {
        gdmaSleepReads=0
        if (esp32S3GdmaSleepStatusOwned(true) != gdmaSleepBusy || gdmaSleepReads != 24 || gdmaSleepBad) return 1
        gdmaSleepBusy=gdmaSleepBusy+1
    }
    gdmaSleepBusy=0;gdmaSleepCommand=1
    while (gdmaSleepCommand < 8) {
        if (esp32S3GdmaSleepStatusOwned(true) != 1023) return 2
        gdmaSleepCommand=gdmaSleepCommand+1
    }
    gdmaSleepCommand=0
    var bit=0
    while (bit < 24) {
        gdmaSleepFifo=1<<bit
        if (esp32S3GdmaSleepStatusOwned(true) != (if (bit == 23) 341 else 1023)) return 3
        bit=bit+1
    }
    gdmaSleepFifo=0;gdmaSleepReads=0
    if (esp32S3GdmaSleepStatusOwned(false) != -1 || gdmaSleepReads != 0) return 4
    gdmaSleepClock=0
    if (esp32S3GdmaSleepStatusOwned(true) != -2) return 5
    gdmaSleepReset=64
    if (esp32S3GdmaSleepStatusOwned(true) != 0 || gdmaSleepBad) return 6
    gdmaSleepClock=64;gdmaSleepReset=0;gdmaSleepClockChange=true;gdmaSleepReads=0
    if (esp32S3GdmaSleepStatusOwned(true) != -3) return 7
    gdmaSleepClockChange=false
    return 0
}
