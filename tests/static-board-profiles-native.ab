import "../src/m5stack/c6_board_profile.ab"
import "../src/m5stack/tough_c5_profile.ab"
import "../src/m5stack/p4_board_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_static_board_profiles_test")
fun testProfiles(): i32 {
    if (m5NessoN1().boardId() != M5BoardId(23)) return i32(1)
    if (m5NessoN1().i2cPins() != m5BoardArduinoNessoN1.i2cPins()) return i32(2)
    if (m5NessoN1().speakerProfile() != m5BoardArduinoNessoN1.speakerProfile()) return i32(3)
    if (m5NessoN1().touchProfile() != m5BoardArduinoNessoN1.touchProfile()) return i32(4)
    if (m5UnitC6L().boardId() != M5BoardId(25)) return i32(5)
    if (m5UnitC6L().i2cPins() != m5BoardUnitC6L.i2cPins()) return i32(6)
    if (m5UnitC6L().speakerProfile() != m5BoardUnitC6L.speakerProfile()) return i32(7)
    if (m5ToughC5().boardId() != M5BoardId(33)) return i32(8)
    if (m5ToughC5().i2cPins() != m5BoardToughC5.i2cPins()) return i32(9)
    if (m5ToughC5().touchProfile() != m5BoardToughC5.touchProfile()) return i32(10)
    if (m5ToughC5().rtcKind() != m5BoardToughC5.rtcKind()) return i32(11)
    if (m5CoreP4X().boardId() != M5BoardId(31)) return i32(12)
    if (m5CoreP4X().i2cPins() != m5BoardCoreP4X.i2cPins()) return i32(13)
    if (m5CoreP4X().speakerProfile() != m5BoardCoreP4X.speakerProfile()) return i32(14)
    if (m5CoreP4X().microphoneProfile() != m5BoardCoreP4X.microphoneProfile()) return i32(15)
    if (m5CoreP4X().touchProfile() != m5BoardCoreP4X.touchProfile()) return i32(16)
    if (m5CoreP4X().rtcKind() != m5BoardCoreP4X.rtcKind()) return i32(17)
    if (m5Tab5().boardId() != M5BoardId(22)) return i32(18)
    if (m5Tab5().i2cPins() != m5BoardTab5.i2cPins()) return i32(19)
    if (m5Tab5().speakerProfile() != m5BoardTab5.speakerProfile()) return i32(20)
    if (m5Tab5().microphoneProfile() != m5BoardTab5.microphoneProfile()) return i32(21)
    if (m5Tab5().rtcKind() != m5BoardTab5.rtcKind()) return i32(22)
    if (m5Tab5X().boardId() != M5BoardId(35)) return i32(23)
    if (m5Tab5X().i2cPins() != m5BoardTab5X.i2cPins()) return i32(24)
    if (m5Tab5X().speakerProfile() != m5BoardTab5X.speakerProfile()) return i32(25)
    if (m5Tab5X().microphoneProfile() != m5BoardTab5X.microphoneProfile()) return i32(26)
    if (m5Tab5X().rtcKind() != m5BoardTab5X.rtcKind()) return i32(27)
    val nesso=m5NessoN1().i2cPins();val unit=m5UnitC6L().i2cPins()
    if (nesso.internalData() != 10 || nesso.internalClock() != 8 || nesso.externalData() != 10 || nesso.externalClock() != 8 || unit.hasExternal()) return i32(40)
    if (m5NessoN1().speakerProfile().dataPin() != 11 || m5UnitC6L().speakerProfile().dataPin() != 11) return i32(41)
    val tough=m5ToughC5().i2cPins()
    if (tough.internalData() != 2 || tough.internalClock() != 3 || m5ToughC5().rtcKind() != m5RtcRx8130) return i32(42)
    val tab=m5Tab5().i2cPins();val core=m5CoreP4X().i2cPins()
    if (tab.internalData() != 31 || tab.internalClock() != 32 || tab.externalData() != 53 || tab.externalClock() != 54 || core.internalData() != 11 || core.internalClock() != 9) return i32(43)
    if (m5Tab5X().i2cPins() != tab || m5Tab5X().speakerProfile() != m5Tab5().speakerProfile() || m5Tab5X().microphoneProfile() != m5Tab5().microphoneProfile()) return i32(44)
    return i32(0)
}
