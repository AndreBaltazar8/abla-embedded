import "../src/touch/chsc6540_irq_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(22)
var captures=0
var mode=0
var level=0
fun chsc6540InterruptLevel(number: int): int = level
trusted fun chsc6540Capture(handle: int,snapshot: NativeBuffer): int {
    captures=captures+1
    var i=0
    while (i < 11) { snapshot.store(i,0); i=i+1 }
    snapshot.store(0,2)
    snapshot.store(1,255); snapshot.store(2,255)
    snapshot.store(3,255); snapshot.store(4,255)
    if (mode == 1) snapshot.store(8,captures)
    if (mode == 2) return -1
    if (mode == 3) return 0
    if (mode == 4) return 3
    2
}
@export("abla_chsc6540_test")
trusted fun testController(): i32 {
    val snapshot=nativeBufferAt(storage,11)
    val previous=nativeBufferAt(storage+11,11)
    while (mode < 5) {
        captures=0
        val count=chsc6540ReadStableOwned(1,snapshot,previous)
        val expected=if (mode < 2) 2 else if (mode == 2) -1 else if (mode == 3) 0 else -3
        if (count != expected || captures != (if (mode == 0) 2 else if (mode == 1) 5 else 1)) return i32(1)
        if (count == 2) {
            val first=chsc6540Point(snapshot,count,0)
            val second=chsc6540Point(snapshot,count,1)
            if (!first.valid() || first.x() != 4095 || first.y() != 4095 || first.id() != 0 || first.size() != 1 ||
                second.id() != 1 || second.x() != (if (mode == 1) 5 else 0)) return i32(2)
        }
        mode=mode+1
    }
    captures=0
    if (chsc6540ReadStableOwned(1,snapshot,snapshot) != -1 || captures != 0 ||
        chsc6540Point(snapshot,3,0).valid()) return i32(3)
    level=1
    if (chsc6540ReadInterruptOwned(1,39,snapshot,previous) != 0 || captures != 0) return i32(4)
    level=-1
    if (chsc6540ReadInterruptOwned(1,39,snapshot,previous) != -1 || captures != 0) return i32(5)
    level=0
    mode=0
    if (chsc6540ReadInterruptOwned(1,39,snapshot,previous) != 2 || captures != 2) return i32(6)
    i32(0)
}
