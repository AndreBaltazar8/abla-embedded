import "../src/esp32/i2s/clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun i2sFrameTarget(port: i32, transmit: bool, data: i32, slot: i32, ws: i32, shift: bool): bool =
    esp32s3I2sSetFrameWidths(int(port), transmit, int(data), int(slot), int(ws), shift)
