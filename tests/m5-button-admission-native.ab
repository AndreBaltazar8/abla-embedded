import "../src/m5stack/button_map_shared.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this|0
@export("abla_m5_button_admission_test")
fun testButtonAdmission(): i32 {
    var value=-260
    while (value <= 520) {
        val gpio=m5GpioButtonSource(value);val valid=value >= 0 && value < 255
        val pins=m5ButtonPinMap(value,value,value,value,value);val expected=if (valid) value else -1
        if (gpio.valid() != valid || gpio.pin().number() != expected || pins.buttonA().number() != expected || pins.buttonB().number() != expected || pins.buttonC().number() != expected || pins.buttonExt().number() != expected || pins.buttonPower().number() != expected) return i32(1)
        val bitValid=value >= 0 && value < 8
        val touch=m5TouchButtonSource(value);val pi4=m5Pi4ButtonSource(value);val hub=m5PowerHubButtonSource(value);val pm1=m5Pm1ButtonSource(value)
        if (touch.valid() != bitValid || pi4.valid() != bitValid || hub.valid() != bitValid || pm1.valid() != bitValid || touch.pin().number() != -1 || pi4.pin().number() != -1) return i32(2)
        if (bitValid && (touch.mask() != int(u32(1)<<u32(value)) || pi4.address() != 67 || pi4.register() != 15 || hub.address() != 80 || hub.register() != 160 || pm1.address() != 110 || pm1.register() != 18 || touch.activeLow() || !pm1.activeLow())) return i32(3)
        value=value+1
    }
    if (m5ButtonSource(257,1).valid() || m5ButtonSource(1,256).valid() || m5ButtonSource(3,1,323,15,2).valid() || m5ButtonSource(3,1,67,271,2).valid() ||
        m5ButtonSource(3,1,67,15,258).valid() || m5ButtonSource(3,1,67,15,1).valid() || m5ButtonSource(3,1,0,15,2).valid() || m5ButtonSource(1,2,67).valid()) return i32(4)
    if (M5ButtonSource(7).valid() || M5ButtonSource(1|(255<<8)).valid() || M5ButtonSource(1|(1<<42)).pin().number() != -1 || !m5PmicKeyButtonSource().valid()) return i32(5)
    var id=0
    while (id < 256) {
        val board=M5BoardId(id)
        val a=board.buttonASource();val b=board.buttonBSource();val c=board.buttonCSource();val p=board.buttonPowerSource()
        if (a.valid() != (a.kind() != 0) || b.valid() != (b.kind() != 0) || c.valid() != (c.kind() != 0) || p.valid() != (p.kind() != 0)) return i32(6)
        id=id+1
    }
    if (m5BoardAtomVoice.buttonA().number() != 39 || m5BoardStackCore2.buttonASource().kind() != 2 || m5BoardStampPLC.buttonASource().mask() != 4 || m5BoardCoreMatrix.buttonCSource().index() != 2) return i32(7)
    return i32(0)
}
