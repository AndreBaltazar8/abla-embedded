import "../src/esp32/i2c/fifo_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_i2c_fifo_target")
trusted fun fifoTarget(port: int,mode: int,buffer: NativeBuffer,count: int,command: u32): bool {
    if (mode == 0) return esp32C5I2cWriteCommand(port,count,command)
    if (mode == 1) return esp32C5I2cWriteFifo(port,buffer,count)
    if (mode == 2) return esp32C5I2cReadFifo(port,buffer,count)
    if (mode == 3) return esp32C5I2cResetFifos(port)
    false
}
