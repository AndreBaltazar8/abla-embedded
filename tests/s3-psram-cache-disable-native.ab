import "../src/esp32/psram/cache_disable_s3_sequence.ab"
import "abla/build"
var cdI=false
var cdToken=0
var cdNoise=0
var cdControl=0
var cdAuto=0
var cdSize=0
var cdSync=0
var cdWrites=0
var cdAutoReads=0
var cdAutoPoll=0
var cdPrePoll=0
var cdSyncPoll=0
var cdIdlePoll=0
var cdDelay=0
var cdPreDone=false
var cdSyncDone=false
var cdBad=false
fun s3PsramCacheMappingRead(address: int): int {
    val phase=cdWrites-(if (cdToken == 0) 0 else 2)
    if (address == (if (cdI) 0x600c4060 else 0x600c4000)) { if (cdWrites != 0) cdBad=true;return cdControl }
    if (address == (if (cdI) 0x600c40a0 else 0x600c404c)) {
        cdAutoReads=cdAutoReads+1
        if (phase == 1 && (cdToken != 0 || cdAutoReads > 1)) {
            cdAutoPoll=cdAutoPoll+1
            if (cdAutoPoll > (if ((cdDelay&1) != 0) 3 else 0)) cdAuto=cdAuto|8
        }
        return cdAuto
    }
    if (address == (if (cdI) 0x600c4094 else 0x600c4040)) {
        if (phase != 2 || (cdAuto&512) != 0 || (cdAuto&8) == 0) cdBad=true
        cdPrePoll=cdPrePoll+1
        cdPreDone=cdPrePoll > (if ((cdDelay&2) != 0) 3 else 0)
        return (cdNoise&0xfffffffd)|(if (cdPreDone) 2 else 0)
    }
    if (address == (if (cdI) 0x600c4090 else 0x600c4030)) { if (phase != 3) cdBad=true;return cdSize }
    if (address == (if (cdI) 0x600c4088 else 0x600c4028)) {
        if (phase == 5) {
            cdSyncPoll=cdSyncPoll+1
            cdSyncDone=cdSyncPoll > (if ((cdDelay&4) != 0) 3 else 0)
            if (cdSyncDone) cdSync=cdSync|(if (cdI) 2 else 8)
        } else if (phase != 4) cdBad=true
        return cdSync
    }
    if (address == 0x600c4130) {
        if (phase != 5 || !cdSyncDone) cdBad=true
        cdIdlePoll=cdIdlePoll+1
        val value=if (cdIdlePoll > (if ((cdDelay&8) != 0) 3 else 0)) 1 else 2
        return if (cdI) (cdNoise&0xfffff000)|value else (cdNoise&0xff000fff)|(value<<12)
    }
    cdBad=true;return 0xffffffff
}
fun s3PsramCacheMappingWrite(address: int,value: int): void {
    val step=cdWrites
    if (step == 0) {
        if (address != (if (cdI) 0x600c4060 else 0x600c4000) || value != (cdControl&0xfffffffe)) cdBad=true
        cdControl=value
    } else if (cdToken != 0 && step < 3) {
        val expected=if (step == 1) cdAuto&0xfffffffb else cdAuto|512
        if (address != (if (cdI) 0x600c40a0 else 0x600c404c) || value != expected) cdBad=true
        cdAuto=value
    } else {
        val phase=step-(if (cdToken == 0) 0 else 2)
        if (phase == 1) {
            if (address != (if (cdI) 0x600c40a0 else 0x600c404c) || value != (cdAuto&0xfffffdff) || (cdAuto&8) == 0) cdBad=true
            cdAuto=value
        } else if (phase == 2) {
            if (!cdPreDone || address != (if (cdI) 0x600c408c else 0x600c402c) || value != 0) cdBad=true
        } else if (phase == 3) {
            if (address != (if (cdI) 0x600c4090 else 0x600c4030) || value != (cdSize&0xff800000)) cdBad=true
            cdSize=value
        } else if (phase == 4) {
            if (address != (if (cdI) 0x600c4088 else 0x600c4028) || value != (cdSync|1)) cdBad=true
            cdSync=value
        } else cdBad=true
    }
    cdWrites=cdWrites+1;return
}
@export("abla_s3_psram_cache_disable_test")
fun testDisable(): int {
    var profile=0
    while (profile < 64) {
        cdI=(profile&1) != 0;cdToken=if ((profile&2) != 0) 4 else 0
        cdNoise=(profile*16777217)^0xa55a5aa5;cdDelay=0
        while (cdDelay < 16) {
            cdControl=cdNoise;cdAuto=(cdNoise&0xfffffff3)|cdToken
            cdSize=cdNoise;cdSync=cdNoise&(if (cdI) 0xfffffffc else 0xfffffff6)
            cdWrites=0;cdAutoReads=0;cdAutoPoll=0;cdPrePoll=0;cdSyncPoll=0;cdIdlePoll=0
            cdPreDone=false;cdSyncDone=false;cdBad=false
            if (s3PsramCacheDisableNativeOwned(cdI) != cdToken || cdBad || cdWrites != (if (cdToken == 0) 5 else 7) ||
                cdControl != (cdNoise&0xfffffffe) || (cdAuto&516) != 0 || cdSize != (cdNoise&0xff800000) ||
                cdIdlePoll != (if ((cdDelay&8) != 0) 4 else 1)) return 1
            cdDelay=cdDelay+1
        }
        profile=profile+1
    }
    return 0
}
