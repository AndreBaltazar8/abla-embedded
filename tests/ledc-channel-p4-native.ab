import "../src/esp32/ledc_channel_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var channel=0
var timer=0
var timerReg=0x7168
var config=0
var hpointReg=123
var dutyReg=456
var start=0
var actual=0
var gamma=0xa0000002
var ranges=0
var writes=0
var drop=0
var stall=false
var wrong=false
var bad=false
trusted fun p4LedcRead(offset: int): int {
    if (offset == 160+timer*8) return timerReg
    if (offset == channel*20) return config
    if (offset == channel*20+4) return hpointReg
    if (offset == channel*20+8) return dutyReg
    if (offset == channel*20+12) return start
    if (offset == channel*20+16) return actual
    if (offset == 256+channel*4) return gamma
    val index=(offset-1024-channel*64)/4
    if (offset >= 1024+channel*64 && offset < 1088+channel*64) {
        return 0x80000000|(if ((ranges&(1<<index)) == 0) 1234 else if (index == 0) 0x200003 else 0)
    }
    bad=true; return 0
}
trusted fun p4LedcWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == channel*20) {
        config=value
        if ((value&16) != 0 && !stall) {
            config=config&0xffffffef
            if (start != 0) { actual=if (wrong) 17 else dutyReg; start=0 }
        }
        return
    }
    if (offset == channel*20+4) { hpointReg=value; return }
    if (offset == channel*20+8) { dutyReg=value; return }
    if (offset == channel*20+12) { start=value; return }
    if (offset == 256+channel*4) { gamma=value; return }
    val index=(offset-1024-channel*64)/4
    if (offset >= 1024+channel*64 && offset < 1088+channel*64) {
        if (value != (0x80000000|(if (index == 0) 0x200003 else 0))) bad=true
        ranges=ranges|(1<<index); return
    }
    bad=true; return
}
fun fresh(): void {
    timerReg=0x7168; config=0x80000000; hpointReg=123; dutyReg=456
    start=0; actual=0; gamma=0xa0000002; ranges=0; writes=0; drop=0; stall=false; wrong=false; bad=false
    return
}
@export("abla_ledc_channel_p4_test")
trusted fun channelTest(): i32 {
    channel=0
    while (channel < 8) {
        timer=0
        while (timer < 4) {
            fresh()
            if (p4LedcChannelSetDutyOwned(channel,timer,128,7,3) != 1 || actual != 2048 || hpointReg != 7 || ranges != 65535 || gamma != 0xa0000001 || config != (0x80000004|timer) || bad) return i32(1)
            if (p4LedcChannelSetDutyOwned(channel,timer,0,0,3) != 1 || actual != 0) return i32(2)
            if (p4LedcChannelSetDutyOwned(channel,timer,256,0,3) != 1 || actual != 4096) return i32(3)
            if (p4LedcChannelStopOwned(channel,true,3) != 1 || config != (0x80000008|timer) || bad) return i32(4)
            timer=timer+1
        }
        channel=channel+1
    }
    channel=0; timer=0
    var stage=1
    while (stage <= 22) {
        fresh(); drop=stage
        val result=p4LedcChannelSetDutyOwned(0,0,128,7,3)
        if (result != (if (stage == 22) 5 else 4) || bad) return i32(5)
        if (stage <= 20 && (config&4) != 0) return i32(6)
        stage=stage+1
    }
    fresh(); stall=true
    if (p4LedcChannelSetDutyOwned(0,0,128,0,3) != 5 || p4LedcChannelStopOwned(0,false,3) != 3) return i32(7)
    val before=writes
    if (p4LedcChannelSetDutyOwned(0,0,10,0,3) != 3 || writes != before) return i32(8)
    config=config&0xffffffef; start=0; actual=dutyReg; stall=false
    if (p4LedcChannelWaitOwned(0,3) != 1 || p4LedcChannelStopOwned(0,false,3) != 1) return i32(9)
    fresh(); wrong=true
    if (p4LedcChannelSetDutyOwned(0,0,128,0,3) != 4) return i32(10)
    fresh(); config=config|5
    if (p4LedcChannelSetDutyOwned(0,0,128,0,3) != 3 || writes != 0) return i32(11)
    fresh(); timerReg=timerReg|0x800000
    if (p4LedcChannelSetDutyOwned(0,0,128,0,3) != 6 || writes != 0) return i32(12)
    fresh()
    if (p4LedcChannelSetDutyOwned(8,0,128,0,3) != 2 || p4LedcChannelSetDutyOwned(0,0,257,0,3) != 2 || p4LedcChannelSetDutyOwned(0,0,1,256,3) != 2 || writes != 0) return i32(13)
    timerReg=0x7174
    if (p4LedcChannelSetDutyOwned(0,0,1048576,0,3) != 2 || writes != 0 || bad) return i32(14)
    return i32(0)
}
