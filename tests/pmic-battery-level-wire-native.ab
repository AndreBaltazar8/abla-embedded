import "./pm1-control-wire-native.ab"
import "../src/m5stack/pmic_battery_level.ab"
@export("abla_pmic_battery_level_wire_test")
trusted fun testBatteryLevel(): i32 {
    wireSeed()
    val bus=i2cSoftwareMaster(0,1,5,8)
    val r=nativeBufferAt(chargeRegisters,256)
    var kind=2
    while (kind <= 4) {
        chargeAddress=if (kind == 4) 117 else 52
        val device=bus.device(chargeAddress,400000)
        val owner=M5PmicOpen((device|0)|(kind<<32)|(1<<40))
        if (!device.valid()) return i32(1)
        val limit=if (kind == 2) 4096 else 256
        val reg=if (kind == 3) 164 else 120
        var sample=0
        while (sample < limit) {
            val first=if (kind == 2) sample>>>4 else sample
            val second=if (kind == 2) (sample&15)|240 else 90
            r.store(reg,first);r.store(reg+1,second)
            val scaled=sample*11-33000
            val steps=sample>>>4
            val expected=if (kind == 2) (if (scaled < 0) 0 else if (scaled >= 8000) 100 else scaled/80)
                else if (kind == 3) sample
                else if (steps == 0) 100 else if (steps == 8) 75 else if (steps == 12) 50 else if (steps == 14) 25 else 0
            var fault=0
            while (fault <= 3) {
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                val result=owner.readBatteryLevelOwned(true)
                val valid=fault == 0 && (kind != 3 || sample <= 100)
                if (result.valid() != valid || result.status() != (if (valid) 1 else 4) ||
                    (valid && result.percent() != expected) || ackCount-before != (if (fault == 0) 3 else fault) ||
                    r.load(reg) != first || r.load(reg+1) != second || bad) return i32(2)
                fault=fault+1
            }
            sample=sample+1
        }
        val before=ackCount
        if (owner.readBatteryLevelOwned(false).status() != 2 || ackCount != before) return i32(3)
        nackAt=0
        if (!device.close() || owner.readBatteryLevelOwned(true).valid() || ackCount != before) return i32(4)
        kind=kind+1
    }
    val before=ackCount
    if (M5PmicOpen(0).readBatteryLevelOwned(true).status() != 2 ||
        M5PmicOpen(1|(5<<32)|(1<<40)).readBatteryLevelOwned(true).status() != 3 ||
        M5PmicOpen(1|(6<<32)|(1<<40)).readBatteryLevelOwned(true).status() != 3 || ackCount != before ||
        !bus.close() || pads != 0 || bad) return i32(5)
    return i32(0)
}
