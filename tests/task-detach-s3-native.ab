import "../src/esp32/task_detach_s3_sequence.ab"
import "../src/esp32/task_reattach_s3_sequence.ab"
import "../src/esp32/task_switch_s3_sequence.ab"
import "../src/esp32/irq_resume_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var memory=nativeBufferAt(0,0)
var core=0
var calls=0
var failAt=0
var bad=false
var restored0=0
var restored3=0
fun esp32S3IrqResumeCore(): int = core
fun esp32S3IrqResumeStatus(): int = 0x4002F
fun esp32S3IrqResumeConfig(): int = 0x3FC90060
trusted fun esp32S3IrqResumeRead(address: int): int = esp32S3CpOwnerRead(address)
trusted fun esp32S3IrqResumeWrite(address: int,value: int): void { esp32S3CpOwnerWrite(address,value); return }
trusted fun esp32S3TaskSwitchDetach(current: NativeBuffer,binding: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,c: int): bool = esp32S3TaskDetachOwned(current,binding,owners,frame,c)
trusted fun esp32S3TaskSwitchAttach(current: NativeBuffer,binding: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,c: int): bool = esp32S3TaskReattachOwned(current,binding,owners,frame,c)
trusted fun esp32S3TaskSwitchSelect(interrupted: NativeBuffer,resume: NativeBuffer,c: int,level: int): bool = esp32S3IrqResumeSelectOwned(interrupted,resume,c,level)
fun esp32S3TaskResolverCore(): int = core
fun esp32S3TaskResolverEnabled(): int = 0
fun esp32S3TaskResolverConfig(): int = 0x3FC90060
trusted fun esp32S3TaskResolverRead(address: int): int = esp32S3CpOwnerRead(address)
trusted fun esp32S3TaskResolverWrite(address: int,value: int): void { esp32S3CpOwnerWrite(address,value); return }
fun esp32S3CpOwnerCore(): int = core
fun esp32S3CpOwnerStatus(): int = 0x4002F
fun esp32S3CpOwnerEnabled(): int = 0
trusted fun esp32S3CpOwnerRead(address: int): int = memory.loadU32(address-0x3FC90000)
trusted fun esp32S3CpOwnerWrite(address: int,value: int): void { memory.storeU32(address-0x3FC90000,value); return }
trusted fun esp32S3CpOwnerTransfer(buffer: NativeBuffer,selected: int,cp: int,restore: bool): bool {
    calls=calls+1
    if (selected != core || (cp != 0 && cp != 3)) bad=true
    if (calls == failAt) return false
    if (restore) {
        if (cp == 0) restored0=esp32S3CpOwnerRead(buffer.addressValue())
        else restored3=esp32S3CpOwnerRead(buffer.addressValue())
    } else esp32S3CpOwnerWrite(buffer.addressValue(),100+core+cp)
    true
}
@export("abla_task_detach_test")
trusted fun detachTest(): i32 {
    memory=nativeBufferAt(nativeStaticAllocate(2048),2048)
    val owners=nativeBufferAt(0x3FC90000,16)
    val current=nativeBufferAt(0x3FC90010,8)
    val binding=nativeBufferAt(0x3FC90020,16)
    val frame=nativeBufferAt(0x3FC90300,192)
    var p=0
    while (p < 8) {
        core=p & 1; failAt=(p>>>1) & 3; calls=0; bad=false
        var offset=0
        while (offset < 1024) { memory.storeU32(offset,0); offset=offset+4 }
        memory.storeU32(916,9)
        memory.storeU32(32,0x3FC90100); memory.storeU32(36,0x3FC90200)
        memory.storeU32(40,core+1); memory.storeU32(44,0x54415331)
        memory.storeU32(16+core*4,0x3FC90020)
        if (!esp32S3CpRecordInitializeOwned(nativeBufferAt(0x3FC90100,256),0) || !esp32S3CpRecordInitializeOwned(nativeBufferAt(0x3FC90200,256),3)) return i32(1)
        if (failAt != 3) {
            memory.storeU32(264,core+1); memory.storeU32(268,0); memory.storeU32(core*8,0x3FC90100)
            memory.storeU32(520,core+1); memory.storeU32(524,0); memory.storeU32(core*8+4,0x3FC90200)
        }
        val expected=failAt == 0 || failAt == 3
        if (esp32S3TaskDetachOwned(current,binding,owners,frame,core) != expected || bad || memory.loadU32(916) != 0) return i32(2)
        if (!expected) {
            if (memory.loadU32(16+core*4) != binding.addressValue() || memory.loadU32(40) != core+1 || calls != failAt) return i32(3)
            val remaining=if (failAt == 1) 2 else 1
            calls=0; failAt=0
            if (!esp32S3TaskDetachOwned(current,binding,owners,frame,core) || calls != remaining) return i32(4)
        }
        if (memory.loadU32(16+core*4) != 0 || memory.loadU32(40) != 0 || memory.loadU32(44) != 0x54415331 ||
            memory.loadU32(264) != 0 || memory.loadU32(520) != 0 || memory.loadU32(268) != 1 || memory.loadU32(524) != 1) return i32(5)
        calls=0
        if (esp32S3TaskDetachOwned(current,binding,owners,frame,core) || calls != 0) return i32(6)
        val oldCore=core
        val snapshot0=memory.loadU32(288)
        val snapshot3=memory.loadU32(544)
        core=core ^ 1; failAt=0
        if (!esp32S3TaskReattachOwned(current,binding,owners,frame,core) || calls != 0 ||
            memory.loadU32(16+oldCore*4) != 0 || memory.loadU32(16+core*4) != binding.addressValue() || memory.loadU32(40) != core+1) return i32(7)
        core=oldCore
        if (esp32S3TaskReattachOwned(current,binding,owners,frame,core) || calls != 0) return i32(8)
        core=oldCore ^ 1
        if (!esp32S3CpOwnerAcquireOwned(owners,nativeBufferAt(0x3FC90100,256),core,0) ||
            !esp32S3CpOwnerAcquireOwned(owners,nativeBufferAt(0x3FC90200,256),core,3) ||
            calls != 2 || restored0 != snapshot0 || restored3 != snapshot3 || bad) return i32(9)
        p=p+1
    }
    p=0
    while (p < 6) {
        core=p & 1; failAt=0; calls=0; bad=false
        var offset=0
        while (offset < 2048) { memory.storeU32(offset,0); offset=offset+4 }
        val next=nativeBufferAt(0x3FC90040,16)
        val resume=nativeBufferAt(0x3FC90600,192)
        memory.storeU32(32,0x3FC90100); memory.storeU32(36,0x3FC90200)
        memory.storeU32(40,core+1); memory.storeU32(44,0x54415331)
        memory.storeU32(64,0x3FC90400); memory.storeU32(68,0x3FC90500)
        memory.storeU32(76,0x54415331); memory.storeU32(16+core*4,0x3FC90020)
        if (!esp32S3CpRecordInitializeOwned(nativeBufferAt(0x3FC90100,256),0) ||
            !esp32S3CpRecordInitializeOwned(nativeBufferAt(0x3FC90200,256),3) ||
            !esp32S3CpRecordInitializeOwned(nativeBufferAt(0x3FC90400,256),0) ||
            !esp32S3CpRecordInitializeOwned(nativeBufferAt(0x3FC90500,256),3)) return i32(20)
        memory.storeU32(264,core+1); memory.storeU32(268,0); memory.storeU32(core*8,0x3FC90100)
        memory.storeU32(520,core+1); memory.storeU32(524,0); memory.storeU32(core*8+4,0x3FC90200)
        memory.storeU32(916,9); memory.storeU32(920,2)
        memory.storeU32(100+core*32,1)
        memory.storeU32(112+core*32,0x3FC92000); memory.storeU32(116+core*32,0x3FC93000)
        memory.storeU32(1540,0x40378001); memory.storeU32(1544,0x50030); memory.storeU32(1552,0x3FC906C0)
        if (p/2 == 1) memory.storeU32(1540,0)
        if (p/2 == 2) memory.storeU32(76,0)
        val result=esp32S3TaskSwitchOwned(current,binding,next,owners,frame,resume,core,2)
        val expected=if (p/2 == 0) 1 else if (p/2 == 1) -3 else -2
        if (result != expected || bad || calls != 2 || memory.loadU32(916) != 0) return i32(21+p)
        if (p/2 == 0) {
            if (memory.loadU32(16+core*4) != next.addressValue() || memory.loadU32(924) != resume.addressValue()) return i32(30)
            // Model subsequent IRQ captures and repeatedly switch BOTH ways.
            // Actual detach/reattach/selector code; only register transfer and
            // hardware frame capture are modeled. Both saved contexts stay live.
            memory.storeU32(772,0x40378001); memory.storeU32(776,0x40020); memory.storeU32(784,0x3FC903C0)
            var turn=0
            while (turn < 64) {
                val from=if ((turn & 1) == 0) next else binding
                val to=if ((turn & 1) == 0) binding else next
                val fromFrame=if ((turn & 1) == 0) resume else frame
                val toFrame=if ((turn & 1) == 0) frame else resume
                val first=esp32S3CpOwnerRead(from.addressValue())
                val second=esp32S3CpOwnerRead(from.addressValue()+4)
                if (!esp32S3CpOwnerAcquireOwned(owners,nativeBufferAt(first,256),core,0) ||
                    !esp32S3CpOwnerAcquireOwned(owners,nativeBufferAt(second,256),core,3)) return i32(33)
                esp32S3CpOwnerWrite(fromFrame.addressValue()+148,9)
                esp32S3CpOwnerWrite(fromFrame.addressValue()+152,2)
                esp32S3CpOwnerWrite(fromFrame.addressValue()+156,0)
                if (esp32S3TaskSwitchOwned(current,from,to,owners,fromFrame,toFrame,core,2) != 1 ||
                    esp32S3CpOwnerRead(current.addressValue()+core*4) != to.addressValue() ||
                    esp32S3CpOwnerRead(fromFrame.addressValue()+156) != toFrame.addressValue() || bad) return i32(34)
                turn=turn+1
            }
        } else {
            if (memory.loadU32(16+core*4) != binding.addressValue() || memory.loadU32(924) != 0) return i32(31)
            if (!esp32S3CpOwnerAcquireOwned(owners,nativeBufferAt(0x3FC90100,256),core,0) ||
                !esp32S3CpOwnerAcquireOwned(owners,nativeBufferAt(0x3FC90200,256),core,3) ||
                restored0 != 100+core || restored3 != 103+core) return i32(32)
        }
        p=p+1
    }
    i32(0)
}
