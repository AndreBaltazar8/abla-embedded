import "../src/esp32/gpio/snapshot_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var out0=0
var out1=0
var en0=0
var en1=0
var writes=0
var drop=-1
var mux=0
var route=0
var od=0
var testedPin=0
trusted fun esp32S3PinStateRead(address: int): int =
    if (address == 0x60004004) out0 else if (address == 0x60004010) out1 else if (address == 0x60004020) en0 else if (address == 0x6000402c) en1 else
    if (address == esp32S3GpioMuxAddress(testedPin)) mux else if (address == 0x60004554+testedPin*4) route else od
trusted fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes
    writes=writes+1
    if (step == drop) return
    if (address == 0x60004008) out0=out0|value
    else if (address == 0x6000400c) out0=out0&~value
    else if (address == 0x60004014) out1=out1|value
    else if (address == 0x60004018) out1=out1&~value
    else if (address == 0x60004024) en0=en0|value
    else if (address == 0x60004028) en0=en0&~value
    else if (address == 0x60004030) en1=en1|value
    else if (address == 0x60004034) en1=en1&~value
    else if (address == esp32S3GpioMuxAddress(testedPin)) mux=value
    else if (address == 0x60004554+testedPin*4) route=value
    else od=value
    return
}
@export("abla_gpio_s3_snapshot_test")
trusted fun test(): i32 {
    var pin=0
    while (pin <= 48) {
        if (espChipS3().gpioOutputValid(pin)) {
            testedPin=pin
            var bits=0
            while (bits < 8) {
                mux=0xa5a57f80; route=0xdead0abc; od=if ((bits&1) != 0) 0xffffffff else 0xfffffffb
                out0=if ((bits&2) != 0) 0xffffffff else 0
                out1=out0; en0=if ((bits&4) != 0) 0xffffffff else 0; en1=en0
                val snapshot=esp32S3GpioSnapshotOwned(pin,true)
                val originalOd=od; val originalOut=out0; val originalEn=en0
                mux=0xa5a50000; route=0xdead0000; od=0xfffffff0
                out0=0x12345678; out1=0x12345678; en0=0x87654321; en1=0x87654321; writes=0; drop=-1
                if (!snapshot.valid() || snapshot.restoreOwned(true) != 1 || mux != 0xa5a57f80 || route != 0xdead0abc || od != (0xfffffff0|(originalOd&4))) return i32(1)
                val bit=1<<(pin&31)
                val expectedOut=(0x12345678&~bit)|(originalOut&bit)
                val expectedEn=(0x87654321&~bit)|(originalEn&bit)
                if ((if (pin < 32) out0 else out1) != expectedOut || (if (pin < 32) en0 else en1) != expectedEn || (if (pin < 32) out1 else out0) != 0x12345678 || (if (pin < 32) en1 else en0) != 0x87654321) return i32(2)
                bits=bits+1
            }
        }
        pin=pin+1
    }
    testedPin=17; mux=0x7f80; route=0xabc; od=4; out0=0xffffffff; en0=0xffffffff
    val snapshot=esp32S3GpioSnapshotOwned(17,true)
    var failedStep=0
    while (failedStep < 7) {
        mux=0; route=0; od=0; out0=0; en0=1<<17; writes=0; drop=failedStep
        if (snapshot.restoreOwned(true) != 4) return i32(3)
        drop=-1
        if (snapshot.restoreOwned(true) != 1) return i32(4)
        failedStep=failedStep+1
    }
    val before=writes
    if (snapshot.restoreOwned(false) != 3 || S3GpioSnapshot(0).restoreOwned(true) != 2 || esp32S3GpioSnapshotOwned(99,true).valid() || writes != before) return i32(5)
    return i32(0)
}
