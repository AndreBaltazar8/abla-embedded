import "./i80-config-s3-native.ab"
import "../src/display/i80_transfer_s3_sequence.ab"
var transferChannel=0
var transferFault=0
var transferPark=true
var transferLink=0x800000
var transferEvents=10
var transferFifo=42
var transferFlags=0x40010010
var transferNext=0
var transferLast=0x3FC88000
var transferCalls=0
var transferFences=0
fun esp32s3GdmaDescriptorValid(address: int): bool = address == 0x3FC88000
fun esp32s3GdmaParked(channel: int,tx: bool): bool { if (channel != transferChannel || !tx) i80Bad=true;return transferPark }
fun esp32s3GdmaConfigureLcd(channel: int,head: int): bool { transferCalls=transferCalls+1;return transferFault != 1 }
fun esp32s3GdmaAcknowledge(channel: int,tx: bool,mask: int): bool { transferCalls=transferCalls+1;return transferFault != 2 }
fun esp32s3GdmaStart(channel: int,tx: bool): bool {
    transferCalls=transferCalls+1
    if ((nativeAddressLoadU32(i80Memory,24)&(1<<27)) != 0) i80Bad=true
    if (transferFault == 4) return false
    i80DmaStarted=true;transferPark=false;return true
}
fun esp32S3I80DelayUs(us: int): void {
    if (us != 4 || !i80DmaStarted) i80Bad=true
    i80DelaySeen=true;return
}
fun esp32s3GdmaRequestStop(channel: int,tx: bool): bool { transferPark=transferFault != 5;return true }
fun esp32s3GdmaPublish(): void { transferFences=transferFences+1;return }
fun esp32s3GdmaRead(address: int): int {
    if (address == 0x3FC88000) return transferFlags
    if (address == 0x3FC88008) return transferNext
    val offset=address-(0x6003F060+transferChannel*192)
    if (offset == 8) return transferEvents
    if (offset == 40) return transferLast
    if (offset == 32) return transferLink
    if (offset == 24) return transferFifo
    i80Bad=true;return 0
}
@export("abla_i80_transfer_s3_test")
fun testI80Transfer(): int {
    val r=nativeBufferAt(i80Memory,128)
    i80TransferModel=true;i80Drop=0
    var profile=0
    while (profile < 30) {
        i80Seed();r.storeU32(20,0x1002000);r.storeU32(28,0)
        transferChannel=profile%5;transferFault=profile/5;transferCalls=0;transferFences=0;transferPark=true;transferLink=0x800000
        i80DmaStarted=false;i80DelaySeen=false;i80FifoStuck=transferFault == 3;i80StopStuck=false
        val result=esp32S3LcdI80StartOwned(transferChannel,0x3FC88000,3,true)
        val expected=if (transferFault == 1 || transferFault == 2) 4 else if (transferFault == 3) 5 else if (transferFault == 4) 6 else 1
        if (result != expected || i80Bad || i80DmaStarted != (expected == 1) || i80DelaySeen != (expected == 1)) return 1
        if (expected == 1 && (r.loadU32(20)&(1<<27)) == 0) return 2
        val aborted=esp32S3LcdI80AbortOwned(transferChannel,3,true)
        if (aborted != (if (transferFault == 5) 5 else 1) || i80Bad) return 3
        if (transferFault == 5) {
            transferFault=0
            if (esp32S3LcdI80AbortOwned(transferChannel,3,true) != 1) return 4
        }
        profile=profile+1
    }
    profile=0
    while (profile < 55) {
        i80Seed();r.storeU32(20,0x1002000);r.storeU32(104,6)
        transferChannel=profile%5;val fault=profile/5
        transferEvents=10;transferLast=0x3FC88000;transferLink=0x800000;transferFifo=42;transferFlags=0x40010010;transferNext=0
        if (fault == 1) r.storeU32(104,4)
        if (fault == 2) r.storeU32(20,0x9002000)
        if (fault == 3) transferEvents=2
        if (fault == 4) transferLast=0x3FC8800C
        if (fault == 5) transferLink=0
        if (fault == 6) transferFifo=106
        if (fault == 7) transferFlags=transferFlags|0x80000000
        if (fault == 8) transferNext=0x3FC88000
        if (fault == 9) transferEvents=14
        if (fault == 10) transferLink=0xA00000
        if (esp32S3LcdI80PollOwned(transferChannel,0x3FC88000,true) != (if (fault == 0) 1 else if (fault == 9) 3 else 0) || i80Bad || i80Writes != 0) return 5
        profile=profile+1
    }
    return 0
}
