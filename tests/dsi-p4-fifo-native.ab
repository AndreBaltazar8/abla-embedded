import "../src/esp32/dsi_fifo_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var status=u32(0)
var reads=0
var writes=0
var offsetWritten=0
var valueWritten=u32(0)
var payloadReads=0
fun p4DsiRead(offset: int): u32 { reads=reads+1; if (offset == 112) { payloadReads=payloadReads+1; return u32(4294967295) }; status }
fun p4DsiWrite(offset: int,value: u32): void { writes=writes+1; offsetWritten=offset; valueWritten=value; return }
@export("abla_dsi_p4_fifo_test")
fun testDsi(): i32 {
    var bits=0
    while (bits < 128) {
        status=u32(bits); reads=0; writes=0; payloadReads=0
        val header=dsiPacketHeader(3,57,255,255)
        val result=esp32P4DsiSubmitHeaderOwned(header,3)
        if (result != (if ((bits&2) == 0) 1 else -2) || reads != (if ((bits&2) == 0) 1 else 3)) return i32(1)
        if ((bits&2) == 0 && (writes != 1 || offsetWritten != 108 || valueWritten != u32(header))) return i32(2)
        reads=0; writes=0
        if (esp32P4DsiWritePayloadOwned(u32(4294967295),3) != (if ((bits&8) == 0) 1 else -2) ||
            writes != (if ((bits&8) == 0) 1 else 0)) return i32(3)
        if (writes != 0 && (offsetWritten != 112 || valueWritten != u32(4294967295))) return i32(4)
        val payload=esp32P4DsiReadPayloadOwned(3)
        if (payload != (if ((bits&16) == 0) 8589934591 else 0) || payloadReads != (if ((bits&16) == 0) 1 else 0)) return i32(5)
        if (esp32P4DsiWaitIdleOwned(3) != ((bits&69) == 5)) return i32(6)
        bits=bits+1
    }
    reads=0; writes=0
    if (esp32P4DsiSubmitHeaderOwned(16777216,3) != -1 || esp32P4DsiWritePayloadOwned(u32(0),0) != -1 ||
        esp32P4DsiReadPayloadOwned(0) != 0 || esp32P4DsiWaitIdleOwned(1000001) || reads != 0 || writes != 0 ||
        dsiPacketHeader(4,1,0,0) != -1) return i32(7)
    i32(0)
}
