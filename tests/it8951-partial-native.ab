import "./it8951-session-native.ab"
import "../src/display/it8951_session_partial.ab"
@export("abla_it8951_partial_test")
trusted fun testPartial(): i32 {
    val session=it8951SessionAt(nativeBufferAt(memory,40))
    val scratch=nativeBufferAt(memory+40,40)
    val pixels=nativeBufferAt(memory+80,16)
    if (!session.initialize() || session.openOwned(7,scratch,3,true) != 1) return i32(1)
    var before=calls
    if (session.loadRectOwned(1,1,1,1,pixels,1,scratch,3,3,true).status() != 2 ||
        session.refreshRectOwned(1,1,1,1,2,scratch,3,3,true).status() != 2 || calls != before) return i32(2)
    nativeAddressClear(pixels.addressValue(),16)
    if (!session.loadFullOwned(pixels,4,scratch,3,3,true).success()) return i32(3)
    var fault=0
    while (fault <= 19) {
        if (fault > 0) {
            command=0;selected=false
            if (session.state() == 2 && session.recoverAfterHardwareResetOwned(scratch,3,true) != 1) return i32(4)
            if (!session.loadFullOwned(pixels,4,scratch,3,3,true).success()) return i32(5)
        }
        before=calls;failure=if (fault == 0) 0 else calls+fault
        val result=session.loadRectOwned(1,1,1,1,pixels,1,scratch,3,3,true)
        failure=0
        if (result.status() != (if (fault == 0) 1 else 4) || calls-before != (if (fault == 0) 19 else fault) ||
            session.state() != (if (fault == 0) 1 else 2) || session.buffer().loadU32(32) != (if (fault == 0) 1 else 0) || bad || selected) return i32(6)
        fault=fault+1
    }
    command=0;selected=false
    if (session.recoverAfterHardwareResetOwned(scratch,3,true) != 1 ||
        !session.loadFullOwned(pixels,4,scratch,3,3,true).success() ||
        !session.loadRectOwned(7,3,1,1,pixels,1,scratch,3,3,true).success() ||
        !session.refreshRectOwned(7,3,1,1,2,scratch,3,3,true).success() || session.state() != 3) return i32(7)
    before=calls
    if (session.loadRectOwned(1,1,1,1,pixels,1,scratch,3,3,true).status() != 2 || calls != before) return i32(8)
    if (session.waitOwned(scratch,3,3,true) != 1) return i32(9)
    before=calls
    if (session.loadRectOwned(8,0,1,1,pixels,1,scratch,3,3,true).status() != 2 ||
        session.loadRectOwned(1,1,1,1,session.buffer(),1,scratch,3,3,true).status() != 2 ||
        session.loadRectOwned(1,1,1,1,pixels,1,scratch,3,3,false).status() != 2 ||
        session.refreshRectOwned(1,1,1,1,8,scratch,3,3,true).status() != 2 || calls != before ||
        session.state() != 1 || session.buffer().loadU32(32) != 1) return i32(10)
    i32(0)
}
