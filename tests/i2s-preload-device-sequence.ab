import "../src/esp32/i2s/preload_device_sequence_esp32.ab"
type I2sDevice = int
type NativeBuffer = int
var handle = 0
var preparationFails = false
var startFails = false
var starts = 0
var closes = 0
var swaps = 0
var loads = 0
var loadResult = 0
var bad = false
fun I2sDevice.prepare(microphone: bool, descriptors: int): bool {
    if (microphone || descriptors != 32) bad = true
    if (preparationFails) return false
    handle = 7
    true
}
fun I2sDevice.handleAddress(): int = handle
fun I2sDevice.uninstall(): void {
    closes = closes+1
    handle = 0
    return
}
fun esp32I2sStartPrepared(value: int): bool {
    if (value != 7) bad = true
    starts = starts+1
    !startFails
}
fun NativeBuffer.hasAddressRange(offset: int, length: int): bool =
    offset == 0 && length >= 0 && length <= this
fun NativeBuffer.addressValue(): int = 100
fun swapEsp32MonoSamplePairs(address: int, length: int): void {
    if (address != 100 || length != 16) bad = true
    swaps = swaps+1
    return
}
fun esp32I2sPreloadPrepared(value: int, address: int, length: int): int {
    if (value != 7 || address != 100 || length != 16 || (swaps & 1) != 1) bad = true
    loads = loads+1
    loadResult
}
fun main(): int {
    val audio = I2sDevice(1)
    preparationFails = true
    if (audio.install(false,32) || starts != 0 || closes != 0) return 1
    preparationFails = false
    startFails = true
    if (audio.install(false,32) || starts != 1 || closes != 1 || handle != 0) return 2
    if (audio.start() || starts != 1) return 3
    startFails = false
    if (!audio.install(false,32) || starts != 2 || closes != 1) return 4
    loadResult = -1
    while (loadResult <= 16) {
        if (loadResult == -1 || (loadResult & 3) == 0) {
            if (audio.preload(NativeBuffer(16),16) != loadResult || swaps != loads*2) return 5
        }
        loadResult = loadResult+1
    }
    val before = loads
    if (audio.preload(NativeBuffer(16),-4) != -1 ||
        audio.preload(NativeBuffer(16),2) != -1 ||
        audio.preload(NativeBuffer(16),20) != -1 ||
        audio.preload(NativeBuffer(16),0) != 0 || loads != before) return 6
    audio.uninstall()
    if (audio.preload(NativeBuffer(16),16) != -1 || loads != before ||
        starts != 2 || swaps != loads*2 || bad) return 7
    0
}
