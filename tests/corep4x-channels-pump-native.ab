import "../src/m5stack/corep4x_channels_pump_sequence.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
val sessionMemory=nativeStaticAllocate(192)
val bankMemory=nativeStaticAllocate(32)
val sourceMemory=nativeStaticAllocate(64)
val metaMemory=nativeStaticAllocate(20)
val accMemory=nativeStaticAllocate(64)
val scratchMemory=nativeStaticAllocate(32)
val stagingMemory=nativeStaticAllocate(16)
var outcome=3
var calls=0
var bad=false
fun m5P4SpeakerSessionValid(r: NativeBuffer,tab5: bool): bool = !tab5 && r.hasAddressRange(0,192) && r.loadU32(64) == 0x43505332
fun esp32p4AhbGdmaRingLayoutValid(desc: int,count: int,payload: int,stride: int,bytes: int): bool =
    desc == 0x4ff00000 && count == 2 && payload == 0x4ff40000 && bytes == 16 && stride == 64
trusted fun m5P4SpeakerPumpOwned(r: NativeBuffer,buffer: NativeBuffer,tab5: bool): int {
    val exclusive=!tab5
    calls=calls+1
    if (buffer.addressValue() != stagingMemory || buffer.capacity() != 16 || !exclusive) bad=true
    r.storeU32(48,outcome)
    if (outcome == 1) r.storeU32(40,1-r.loadU32(40))
    else if (outcome != 3) r.storeU32(68,3)
    return if (outcome == 1 || outcome == 3) 2 else 3
}
@export("abla_corep4x_channels_pump_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(sessionMemory,192)
    val source=nativeBufferAt(sourceMemory,64)
    var i=0
    while (i < 16) { source.storeU16(i*4,10000);source.storeU16(i*4+2,-2000);i=i+1 }
    val wav=pcmRaw(source,nativeBufferAt(metaMemory,20),24000,2,16)
    val acc=nativeBufferAt(accMemory,64);val scratch=nativeBufferAt(scratchMemory,32);val staging=nativeBufferAt(stagingMemory,16)
    var mode=0
    while (mode < 1) {
        val stereo=false
        val bank=pcmChannelsAt(nativeBufferAt(bankMemory,32),1,24000)
        if (bank.enqueue(wav,0) != 0) return i32(1)
        r.storeU32(64,0x43505332);r.storeU32(68,2);r.storeU32(12,1)
        r.storeU32(20,0x4ff00000);r.storeU32(24,2);r.storeU32(28,0x4ff40000);r.storeU32(32,64);r.storeU32(36,16);r.storeU32(40,0)
        var state=CoreP4xChannelsPump(0)
        var block=0
        while (block < 6) {
            outcome=3
            state=coreP4xPumpChannelsOwned(state,r,bank,acc,scratch,staging,32768,true)
            if (state.status() != 3 || !state.pending()) return i32(2)
            val cursor=bank.channel(0).storage().loadU32(16)
            val repeats=bank.channel(0).storage().loadU32(12)
            val word=staging.loadU32(0)
            var retry=0
            while (retry < 3) {
                state=coreP4xPumpChannelsOwned(state,r,bank,acc,scratch,staging,0,true)
                if (state.status() != 3 || bank.channel(0).storage().loadU32(16) != cursor ||
                    bank.channel(0).storage().loadU32(12) != repeats || staging.loadU32(0) != word) return i32(3)
                retry=retry+1
            }
            i=0
            while (i < 8) {
                val expected=if (!stereo) 4000 else if ((i&1) == 0) 10000 else 63536
                if (staging.loadU16(i*2) != expected) return i32(4)
                i=i+1
            }
            outcome=1
            state=coreP4xPumpChannelsOwned(state,r,bank,acc,scratch,staging,0,true)
            if (state.status() != 1 || state.pending() || state.index() != r.loadU32(40) ||
                bank.channel(0).storage().loadU32(16) != cursor || staging.loadU32(0) != word) return i32(5)
            block=block+1
        }
        val before=bank.channel(0).storage().loadU32(16);val beforeCalls=calls
        if (coreP4xPumpChannelsOwned(state,r,bank,nativeBufferAt(accMemory,1),scratch,staging,32768,true).status() != 2 ||
            coreP4xPumpChannelsOwned(state,r,bank,acc,scratch,nativeBufferAt(sessionMemory+188,16),32768,true).status() != 2 ||
            coreP4xPumpChannelsOwned(state,r,bank,acc,scratch,staging,32768,false).status() != 2 ||
            calls != beforeCalls || bank.channel(0).storage().loadU32(16) != before) return i32(6)
        bank.channel(0).storage().storeU32(0,24001)
        if (coreP4xPumpChannelsOwned(state,r,bank,acc,scratch,staging,32768,true).status() != 2 || calls != beforeCalls) return i32(7)
        bank.channel(0).storage().storeU32(0,24000);r.storeU32(40,1-r.loadU32(40))
        if (coreP4xPumpChannelsOwned(state,r,bank,acc,scratch,staging,32768,true).status() != 2 || calls != beforeCalls) return i32(8)
        r.storeU32(40,1-r.loadU32(40));outcome=4
        state=coreP4xPumpChannelsOwned(state,r,bank,acc,scratch,staging,32768,true)
        val failedCalls=calls
        if (state.status() != 4 || !state.pending() || coreP4xPumpChannelsOwned(state,r,bank,acc,scratch,staging,32768,true) != state || calls != failedCalls) return i32(9)
        if (bad) return i32(10)
        mode=mode+1
    }
    return i32(0)
}
