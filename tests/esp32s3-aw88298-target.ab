import "../src/esp32/i2c_esp32s3.ab"
import "../src/audio/aw88298_device.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun aw88298Target(handle: u32, rate: i32, enable: bool): bool {
    val amp = Aw88298(int(handle))
    if (enable) amp.configureI2s16(int(rate)) else amp.disableI2s()
}
#exportFunction("aw88298Target", "abla_s3_aw88298_test")
