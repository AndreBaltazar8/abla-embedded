import "../src/display/unit_lcd.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
fun I2cDevice.valid(): bool = this == 7
val memory=nativeStaticAllocate(16)
var queries=0
var writes=0
var waited=0
var readyAt=1
var failQuery=0
var failWrite=false
var bad=false
var command=34
var argument=0
var pixel=false
var rotated=false
var identityBad=false
fun unitLcdDelayMicroseconds(us: int): void { if (us != 2000) bad=true;waited=waited+us;return }
trusted fun I2cDevice.writeRead(output: NativeBuffer,written: int,input: NativeBuffer,read: int): bool {
    queries=queries+1
    if (written != 1 || this != 7) bad=true
    if (output.load(0) == 4) {
        if (read != 4) bad=true
        input.store(0,if (identityBad) 0 else 119);input.store(1,137);input.store(2,0);input.store(3,91)
    } else {
        if (output.load(0) != 9 || read != 1 || writes != 0) bad=true
        input.store(0,if (queries >= readyAt) 128 else 127)
    }
    return queries != failQuery
}
trusted fun I2cDevice.write(bytes: NativeBuffer,length: int): bool {
    writes=writes+1
    if (queries < readyAt || this != 7) bad=true
    if (command == 106) {
        if (bytes.load(0) != (if (pixel) 98 else 106) || bytes.load(1) != 0 || bytes.load(2) != 0 || length != (if (pixel) 5 else 7) ||
            bytes.loadU16(if (pixel) 3 else 5) != argument) bad=true
        if (!pixel && (bytes.load(3) != (if (rotated) 239 else 134) || bytes.load(4) != (if (rotated) 134 else 239))) bad=true
    } else if (bytes.load(0) != command || length != 2 || bytes.load(1) != argument) bad=true
    return !failWrite
}
fun seed(): void { queries=0;writes=0;waited=0;readyAt=1;failQuery=0;failWrite=false;return }
@export("abla_unit_lcd_test")
trusted fun testLcd(): i32 {
    val device=I2cDevice(7);val scratch=nativeBufferAt(memory,16)
    var poll=1
    while (poll <= 16) {
        seed();readyAt=poll
        if (device.unitLcdControl(34,argument,scratch,16) != 1 || queries != poll || writes != 1 || waited != (poll-1)*2000 || bad) return i32(1)
        seed();readyAt=17;failQuery=poll
        if (device.unitLcdControl(34,argument,scratch,16) != 3 || queries != poll || writes != 0 || waited != (poll-1)*2000 || bad) return i32(2)
        poll=poll+1
    }
    seed();readyAt=17
    if (device.unitLcdControl(34,0,scratch,16) != 4 || queries != 16 || writes != 0 || waited != 30000) return i32(3)
    seed();failWrite=true
    if (device.unitLcdControl(34,0,scratch,16) != 5 || queries != 1 || writes != 1) return i32(4)
    command=106
    var rotation=0
    while (rotation < 8) {
        var kind=0
        while (kind < 2) {
            seed();rotated=(rotation&1) != 0;pixel=kind == 0;argument=0xabcd
            if (device.unitLcdFill16(0,0,if (pixel) 1 else if (rotated) 240 else 135,if (pixel) 1 else if (rotated) 135 else 240,rotation,argument,scratch,1) != 1 || bad) return i32(5)
            kind=kind+1
        }
        rotation=rotation+1
    }
    seed()
    val identity=device.unitLcdIdentify(scratch)
    if (!identity.valid() || identity.value() != 91 || queries != 1 || bad) return i32(6)
    seed();identityBad=true
    if (device.unitLcdIdentify(scratch).valid()) return i32(7)
    seed();identityBad=false;failQuery=1
    if (device.unitLcdIdentify(scratch).valid()) return i32(8)
    seed()
    if (device.unitLcdControl(54,8,scratch,1) != 2 || device.unitLcdControl(0,0,scratch,1) != 2 ||
        device.unitLcdFill16(0,0,136,240,0,0,scratch,1) != 2 || device.unitLcdWaitCapacity(scratch,0) != 2 || queries != 0 || writes != 0) return i32(9)
    return i32(0)
}
