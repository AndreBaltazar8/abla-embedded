import "../src/m5stack/imu_owner_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var primaryStatus=1
var malformed=false
var present=0
var failAllocate=0
var failRelease=0
var live=0
var allocations=0
var bad=false
fun m5ImuOwnerProbePrimary(bus: int): M5ImuProbeResult {
    if (bus != 7) bad=true
    if (primaryStatus == 1 || primaryStatus == 4) live=live|4
    if (primaryStatus == 1) return M5ImuProbeResult((1<<48)|((if (malformed) 7 else 3)<<42)|(104<<35)|(2<<32)|100)
    M5ImuProbeResult((primaryStatus<<48)|(if (primaryStatus == 4) 100 else 0))
}
fun m5ImuOwnerReleasePrimary(handle: int): bool {
    if (handle != 100 || (live & 4) == 0) bad=true
    if ((failRelease & 4) != 0) return false
    live=live & ~4; true
}
fun m5MagnetometerAllocate(bus: int,address: int): int {
    allocations=allocations+1
    val kind=if (address == 16) 1 else 2
    if (bus != 7) bad=true
    if (kind == failAllocate) return 0
    live=live|(1<<(kind-1)); kind
}
fun m5MagnetometerBegin(handle: int,kind: int): int = if ((present & (1<<(kind-1))) != 0) 4 else 0
fun m5MagnetometerRelease(handle: int): bool {
    val bit=1<<(handle-1)
    if ((live & bit) == 0) bad=true
    if ((failRelease & bit) != 0) return false
    live=live & ~bit; true
}
@export("abla_imu_owner_test")
trusted fun ownerTest(): i32 {
    val owner=m5ImuOwnerAt(nativeBufferAt(nativeStaticAllocate(36),36))
    var profile=0
    while (profile < 384) {
        primaryStatus=1+profile%4; present=(profile/4)%4
        failAllocate=(profile/16)%3; failRelease=profile/48
        live=0; allocations=0; bad=false
        if (!owner.initialize()) return i32(1)
        val status=owner.openOwned(7)
        if (status != owner.status() || bad) return i32(2)
        if (primaryStatus != 1 && (allocations != 0 || status != primaryStatus)) return i32(3)
        if (primaryStatus == 1 && failAllocate == 0 && failRelease == 0 && status != 1) return i32(4)
        val before=allocations
        if (owner.openOwned(7) != -1 || before != allocations) return i32(5)
        owner.closeOwned()
        val retained=(if (owner.primary().handle() != 0) 4 else 0) |
            (if (owner.magnetometers().handle(1) != 0) 1 else 0) |
            (if (owner.magnetometers().handle(2) != 0) 2 else 0)
        if (live != retained || bad || owner.status() != (if (live == 0) 0 else 4)) return i32(6)
        failRelease=0
        if (!owner.closeOwned() || live != 0 || owner.status() != 0 || bad || !owner.closeOwned()) return i32(7)
        profile=profile+1
    }
    owner.initialize(); primaryStatus=1; malformed=true; allocations=0; live=0; bad=false
    if (owner.openOwned(7) != 6 || owner.status() != 6 || owner.primary().handle() != 100 ||
        allocations != 0 || live != 4 || bad) return i32(8)
    if (!owner.closeOwned() || live != 0 || bad) return i32(9)
    i32(0)
}
