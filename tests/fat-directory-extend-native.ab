import "../src/storage/fat_volume_create_growing.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
val image=nativeStaticAllocate(2048)
val newName=nativeStaticBytes("new.txt")
val oldName=nativeStaticBytes("OTHER   TXT")
var writes=0
var failAt=0
var bad=false
fun slot(lba: int): int = if (lba == 1) 0 else if (lba == 41) 1 else if (lba == 113 || lba == 81) 2 else if (lba == 114) 3 else -1
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    val selected=slot(lba)
    if (selected < 0 && lba != 0) return false
    val source=if (lba == 0) nativeBufferAt(memory+64,512) else nativeBufferAt(image+selected*512,512)
    var i=0
    while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool {
    writes=writes+1;val selected=slot(lba)
    val expected=if (writes == 1 || writes == 4) 0 else if (writes == 2 || writes == 5) 1 else 3
    if (selected < 0 || selected != expected) { bad=true;return false }
    if (writes == 4 || writes == 5) {
        var i=0
        while (i < 512) { if (nativeBufferAt(image+1536,512).load(i) != 0) bad=true;i=i+1 }
    }
    val output=nativeBufferAt(image+selected*512,512);var i=0
    while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return writes != failAt
}
@export("abla_fat_directory_extend_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,32);val reader=nativeBufferAt(memory+32,28);val boot=nativeBufferAt(memory+64,512)
    val work=nativeBufferAt(memory+640,2624);val scratch=nativeBufferAt(memory+3328,512);val plan=nativeBufferAt(memory+3840,32)
    var i=0
    while (i < 512) { boot.store(i,0);i=i+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2)
    boot.storeU16(17,512);boot.storeU16(22,40);boot.storeU16(19,10113);boot.storeU16(510,0xaa55)
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    val modified=rtcCalendarDateTime(2026,9,9,12,34,56)
    var failure=0
    while (failure <= 8) {
        writes=0;failAt=failure;bad=false;i=0
        while (i < 2048) { nativeBufferAt(image,2048).store(i,255);i=i+1 }
        var copy=0
        while (copy < 2) { nativeBufferAt(image+copy*512,512).storeU16(6,0);copy=copy+1 }
        val directory=nativeBufferAt(image+1024,512);i=0
        while (i < 512) { directory.store(i,0);i=i+1 }
        var entry=0
        while (entry < 16) {
            i=0
            while (i < 11) { directory.store(entry*32+i,nativeBufferAt(oldName,11).load(i));i=i+1 }
            directory.store(entry*32+11,32);entry=entry+1
        }
        if (failure == 7) { directory.store(480,65);directory.store(491,15) }
        if (failure == 8) boot.storeU16(17,16)
        val volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch)
        val result=volume.createShortGrowing(u32(7),if (failure == 8) 0 else 2,nativeBufferAt(newName,7),7,64,modified,plan,work)
        val status=if (failure == 0) 1 else if (failure <= 3) 17 else if (failure <= 5) 18 else if (failure == 6) 19 else if (failure == 7) 5 else 7
        if (result.status() != status || bad || writes != (if (failure == 0) 6 else if (failure >= 7) 0 else failure)) return i32(2)
        if (failure >= 1 && failure <= 6 && (state.loadU32(12) != 3 || ((result>>8)&0xfffffff) != 3)) return i32(5)
        if (failure == 0) {
            val created=nativeBufferAt(image+1536,512)
            if (result.ordinal() != 1 || result.entryIndex() != 0 || created.load(0) != 78 || created.load(32) != 0 ||
                nativeBufferAt(image,512).loadU16(4) != 3 || nativeBufferAt(image+512,512).loadU16(4) != 3 || created.loadU32(28) != 0) return i32(3)
        }
        // Existing directory is never rewritten during extension/insertion.
        if (directory.load(0) != 79 || directory.load(32) != 79 || !volume.invalidate(u32(7))) return i32(4)
        failure=failure+1
    }
    return i32(0)
}
