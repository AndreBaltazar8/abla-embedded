import "../src/m5stack/toughc5_shutdown_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(120)
var pmu=0
fun c5LpGpioClockLoad(address: int): int = if (address == 0x600b2800) 0x08000000 else if (address == 0x600b2804) 0 else 1
fun c5LpGpioClockStore(address: int,value: int): void { bad=true;return }
var ext=0
var level=1
var fallOnArm=false
var pin=4
var mux=0
var hp=0
var lp=0
var route=0
var hold=0
var writes=0
var failAt=0
var bad=false
fun c5WakeLoad(address: int): int {
    if (address == 0x600b102c) return hold
    if (address == 0x600b4000+pin*4) return mux
    if (address == 0x60091034) return hp
    if (address == 0x600b4410) return lp
    if (address == 0x600b1028) return route
    if (address == 0x600b441c) return level<<pin
    bad=true;return 0
}
fun c5WakeStore(address: int,value: int): void {
    if ((pmu&2) != 0) bad=true
    writes=writes+1
    if (writes == failAt) return
    if (address == 0x6009103c) hp=hp&~value
    else if (address == 0x600b4418) lp=lp&~value
    else if (address == 0x60091038) hp=hp|value
    else if (address == 0x600b4414) lp=lp|value
    else if (address == 0x600b4000+pin*4) mux=value
    else if (address == 0x600b1028) route=value
    else bad=true
    return
}
fun c5WakeTriggerRead(): int = pmu
fun c5WakeTriggerWrite(value: int): void {
    writes=writes+1
    if (writes != failAt) pmu=value
    if (fallOnArm && (value&2) != 0) level=0
    return
}
fun c5Ext1Read(): int = ext
fun c5Ext1Write(value: int): void {
    writes=writes+1
    if ((value&16384) != 0 && (pmu&2) != 0) bad=true
    if (writes != failAt) ext=(if ((value&16384) != 0) 0 else ext&255)|(value&0xffffbf00)
    return
}
var powerCalls=0
var successAt=0
var clears=0
var releaseAt=0
fun m5PmicShutdownWrite(handle: int,kind: int,preserve: bool): bool {
    powerCalls=powerCalls+1
    if (handle != 7 || kind != 5 || preserve) bad=true
    powerCalls == successAt
}
trusted fun toughC5ShutdownClearSources(pmic: int,touch: int,scratch: NativeBuffer): int {
    clears=clears+1
    if (pmic != 7 || touch != 8 || !scratch.hasAddressRange(0,22) || (pmu&2) != 0) bad=true
    if (clears == releaseAt) level=1
    return 783
}
@export("abla_toughc5_shutdown_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,120)
    val owner=M5PmicOpen(7|(5<<32)|(1<<40))
    var mode=0
    while (mode < 4) {
        record.storeU32(0,0);mux=0xdeadbeef;hp=255;lp=255;route=0;hold=0
        pmu=0x4002;ext=0xa5aa3fab;writes=0;failAt=0;bad=false;level=0;fallOnArm=false
        powerCalls=0;clears=0
        successAt=if (mode == 0) 1 else if (mode == 1) 3 else 0
        releaseAt=if (mode == 2) 2 else 0
        var status=toughC5ShutdownBeginOwned(record,owner,8,true)
        if (toughC5ShutdownBeginOwned(record,owner,8,true) != 3 || powerCalls != 1) return i32(1)
        var now=u32(4294967290)
        var polls=0
        while (status == 2 && polls < 2000) {
            status=toughC5ShutdownPollOwned(record,now)
            now=now+u32(20);polls=polls+1
        }
        if (status != (if (mode < 2) 1 else if (mode == 2) 5 else 6) || bad ||
            powerCalls != (if (mode == 0) 1 else 3) || clears != (if (mode < 2) 0 else if (mode == 2) 2 else 320)) return i32(2)
        if (mode == 3 && (pmu&2) != 0) return i32(3)
        if (mode == 2) {
            if ((pmu&2) == 0 || record.loadU32(80) != 783) return i32(4)
            level=0
            if (toughC5ShutdownPollOwned(record,now) != 2 || (pmu&2) != 0) return i32(5)
        }
        if (toughC5ShutdownCloseOwned(record) != 7 || pmu != 0x4002 || (ext&0xffffff00) != 0xa5aa3f00 ||
            hp != 255 || lp != 255 || route != 0 || mux != 0xdeadbeef || bad) return i32(6)
        val before=writes
        if (toughC5ShutdownPollOwned(record,now) != 7 || toughC5ShutdownCloseOwned(record) != 7 || writes != before) return i32(7)
        mode=mode+1
    }
    return i32(0)
}
