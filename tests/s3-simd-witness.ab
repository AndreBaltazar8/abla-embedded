import "../src/esp32/context_extra_esp32s3.ab"
import "abla/unsafe/mmio"
// Q0..Q7 memory layout matches CP3 frame offsets80..207. Fixed instruction
// encodings are the same checked LD.QR/ST.QR primitives as context save/restore.
// No CPENABLE write: first vector instruction must fault into lazy CP3 policy.
@naked
@noinline
@section(".iram1.abla.s3SimdWitnessLoad")
trusted fun s3SimdWitnessLoad(buffer: u32): void = esp32S3ContextExtraAssembly("entry a1, 32\n.byte 0x24, 0x25, 0xcd\n.byte 0x24, 0xa6, 0xcd\n.byte 0x24, 0x27, 0xdd\naddmi a2, a2, 256\naddi a2, a2, -128\n.byte 0x24, 0xa0, 0xdd\n.byte 0x24, 0x21, 0xed\n.byte 0x24, 0xa2, 0xed\n.byte 0x24, 0x23, 0xfd\n.byte 0x24, 0xa4, 0xfd\nretw","~{memory}")
@naked
@noinline
@section(".iram1.abla.s3SimdWitnessStore")
trusted fun s3SimdWitnessStore(buffer: u32): void = esp32S3ContextExtraAssembly("entry a1, 32\n.byte 0x24, 0x65, 0xcd\n.byte 0x24, 0xe6, 0xcd\n.byte 0x24, 0x67, 0xdd\naddmi a2, a2, 256\naddi a2, a2, -128\n.byte 0x24, 0xe0, 0xdd\n.byte 0x24, 0x61, 0xed\n.byte 0x24, 0xe2, 0xed\n.byte 0x24, 0x63, 0xfd\n.byte 0x24, 0xe4, 0xfd\nretw","~{memory}")
@section(".iram1.abla.s3SimdWitnessSeed")
trusted fun s3SimdWitnessSeed(buffer: int,pattern: int): void {
    var offset=80
    while (offset < 208) { mmioStoreU32(buffer+offset,pattern+offset); offset=offset+4 }
    callNativeVoidI32(nativeFunctionAddress(s3SimdWitnessLoad),buffer)
    return
}
@section(".iram1.abla.s3SimdWitnessValid")
trusted fun s3SimdWitnessValid(buffer: int,pattern: int): bool {
    callNativeVoidI32(nativeFunctionAddress(s3SimdWitnessStore),buffer)
    var offset=80
    while (offset < 208) {
        if (mmioLoadU32(buffer+offset) != pattern+offset) return false
        offset=offset+4
    }
    true
}
