import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/storage/fat_software_sd.ab"
import "../src/storage/fat_mount.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_mount_target")
trusted fun target(reader: int,card: int,partition: int,boot: int,scratch: int): int =
    fatMountReadOwned(nativeBufferAt(reader,28),card,partition,nativeBufferAt(boot,512),nativeBufferAt(scratch,512)).status()
