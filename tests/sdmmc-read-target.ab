import "../src/sd/mmc_read_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_read_target")
trusted fun target(operation: int,context: int,card: int,descriptor: int,payload: int,sector: int,now: u32,budget: int,released: bool): int {
    val state=nativeBufferAt(context,48)
    if (operation == 0) return sdMmcReadBeginOwned(state,nativeBufferAt(card,80),nativeBufferAt(descriptor,16),nativeBufferAt(payload,512),sector,now,budget,released)
    return sdMmcReadPollOwned(state,now)
}
