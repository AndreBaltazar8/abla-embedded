import "../src/i2c/register_access.ab"
import "../src/m5stack/cores3_panel.ab"
type I2cBus = int
type I2cDevice = int
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int, frequency: int): I2cDevice = I2cDevice(1)
fun I2cDevice.close(): bool = true
var steps = 0
var stage = 0
var attempts = 0
var failure = 0
var recoverAt = 99
var firmware = 16
var vendor = 17
var delays = 0
var bad = false
fun I2cDevice.readRegister(register: int, bytes: NativeBuffer, length: int): bool { bad = true; false }
fun I2cDevice.writeRegister(register: int, bytes: NativeBuffer, length: int): bool { bad = true; false }
fun I2cDevice.writeRegister8(register: int, value: int): bool {
    attempts = attempts + 1
    steps = steps + 1
    stage = 1
    if (this != 1 || register != 0 || value != 0) bad = true
    !(failure == 1 && attempts < recoverAt)
}
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    stage = stage + 1
    steps = steps + 1
    if (this != 1 || register != (if (stage == 2) 166 else 168) || stage > 3) bad = true
    if (failure == stage && attempts < recoverAt) return I2cByteResult(0)
    I2cByteResult(256 | (if (register == 166) firmware else vendor))
}
fun peripheralDelayMilliseconds(duration: int): void {
    if (duration != 20) bad = true
    delays = delays + 1
    return
}
fun reset(): void {
    steps = 0
    attempts = 0
    delays = 0
    failure = 0
    recoverAt = 99
    firmware = 16
    vendor = 17
    return
}
fun main(): int {
    var v = 0
    while (v < 256) {
        var f = 0
        while (f < 256) {
            val expected = if (v == 17 && f == 16) 1 else if (v == 17 && f == 18) 2 else 0
            if (cores3PanelIdentity(f, v) != expected) return 1
            f = f + 1
        }
        v = v + 1
    }
    reset()
    if (cores3DetectPanel(Ft5x06(0)) != -2 || steps != 0) return 2
    if (cores3DetectPanel(Ft5x06(1)) != 1 || steps != 3 || delays != 0) return 3
    reset()
    firmware = 18
    if (cores3DetectPanel(Ft5x06(1)) != 2 || steps != 3) return 4
    reset()
    vendor = 0
    if (cores3DetectPanel(Ft5x06(1)) != 0 || steps != 15 || delays != 4) return 5
    var fail = 1
    while (fail <= 3) {
        reset()
        failure = fail
        if (cores3DetectPanel(Ft5x06(1)) != -1 || steps != 5 * fail || delays != 4) return 6
        var recovery = 1
        while (recovery <= 5) {
            reset()
            failure = fail
            recoverAt = recovery
            if (cores3DetectPanel(Ft5x06(1)) != 1 || steps != (recovery - 1) * fail + 3 || delays != recovery - 1) return 7
            recovery = recovery + 1
        }
        fail = fail + 1
    }
    if (bad) 8 else 0
}
