import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/adc_clock_c5_sequence.ab"
var bus=u32(0)
var functional=u32(0)
var writes=0
var drop=0
var busyOffset=-1
var busyMask=u32(0)
var unsafeRead=false
trusted fun c5AdcClockRead(offset: int): u32 = if (offset == 0) bus else functional
trusted fun c5AdcClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes != drop) { if (offset == 0) bus=value else functional=value }
    return
}
trusted fun c5AdcRead(offset: int): u32 {
    if ((bus&u32(14)) != u32(4)) unsafeRead=true
    return if (offset == busyOffset) busyMask else u32(0)
}
@export("abla_adc_clock_c5_test")
trusted fun test(): i32 {
    var source=0
    while (source < 3) {
        var borrowed=0
        while (borrowed < 4) {
            val oldBus=u32(0xa5000001)|(if ((borrowed&1) != 0) u32(4) else u32(0))
            val oldFunction=u32(0x800041c2)|(u32(source)<<u32(20))|(if ((borrowed&2) != 0) u32(0x400000) else u32(0))
            var fault=0
            while (fault < 5) {
                bus=oldBus;functional=oldFunction;writes=0;drop=fault;busyOffset=-1;unsafeRead=false
                var owner=c5AdcClockOpenOwned(source,true)
                if (owner.ready() && !c5AdcClocksReady()) return i32(1)
                owner=owner.closeOwned(true)
                drop=0
                owner=owner.closeOwned(true)
                if (owner.status() != 0 || bus != oldBus || functional != oldFunction || unsafeRead) return i32(2)
                fault=fault+1
            }
            var blocked=0
            while (blocked < 13) {
                bus=oldBus;functional=oldFunction;writes=0;drop=0;busyOffset=-1
                var owner=c5AdcClockOpenOwned(source,true)
                if (!owner.ready()) return i32(3)
                if (blocked < 3) { busyOffset=0;busyMask=if (blocked == 0) u32(2) else if (blocked == 1) u32(0x800000) else u32(0x20000000) }
                else if (blocked == 3) { busyOffset=4;busyMask=u32(0x1000000) }
                else if (blocked < 7) { busyOffset=0x20;busyMask=u32(1)<<u32(blocked+25) }
                else if (blocked < 10) { busyOffset=0x3c;busyMask=if (blocked == 7) u32(0x8000000) else u32(1)<<u32(blocked+22) }
                else if (blocked == 10) { busyOffset=0x40;busyMask=u32(1) }
                else { busyOffset=0x50;busyMask=u32(1)<<u32(blocked+19) }
                val before=writes
                owner=owner.closeOwned(true)
                // PWDET power routing is permitted, unlike active triggers.
                if (blocked == 2) { if (owner.status() != 0) return i32(4) }
                else if (owner.status() != 5 || writes != before) return i32(4)
                busyOffset=-1
                owner=owner.closeOwned(true)
                if (owner.status() != 0 || bus != oldBus || functional != oldFunction) return i32(5)
                blocked=blocked+1
            }
            borrowed=borrowed+1
        }
        source=source+1
    }
    bus=u32(0);functional=u32(0);writes=0
    if (c5AdcClockOpenOwned(0,false).status() != 2 || c5AdcClockOpenOwned(3,true).status() != 2 || writes != 0) return i32(6)
    bus=u32(2)
    if (c5AdcClockOpenOwned(0,true).status() != 3 || writes != 0) return i32(7)
    bus=u32(8)
    if (c5AdcClockOpenOwned(0,true).status() != 3 || writes != 0) return i32(8)
    bus=u32(0)
    if (c5AdcClockOpenOwned(1,true).status() != 3 || writes != 0) return i32(9)
    return i32(0)
}
