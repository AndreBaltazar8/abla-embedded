import "../src/esp32/psram/startup_prepare_s3_sequence.ab"
import "abla/build"
var spBefore=0
var spAfter=0
var spSupply=0
var spPads=0
var spClock=1
var spStep=0
var spBad=false
fun s3PsramStartupHardwareMismatch(): int {
    if (spStep == 0) { spStep=1;return spBefore }
    if (spStep != 1234) spBad=true
    spStep=12345;return spAfter
}
fun esp32S3MemorySupplyRead(address: int): int {
    if (spStep != 1 || address != 0x6000807c) spBad=true
    spStep=12
    // Forced 1.8V enabled, forced 3.3V enabled, forced disabled.
    return if (spSupply == 0) 0x80400000 else if (spSupply == 1) 0x80c00000 else 0x400000
}
fun s3MspiDefaultBootPadMismatch(): int {
    if (spStep != 12) spBad=true
    spStep=123;return spPads
}
fun esp32S3StartupClock480Owned(polls: int,owned: bool): int {
    if (spStep != 123 || polls != 100 || !owned) spBad=true
    spStep=1234;return spClock
}
fun spRun(prepare: bool): bool {
    spStep=0;spBad=false
    var expected=1;var steps=123
    if ((spBefore&11) != 0 || (!prepare && spBefore != 0)) { expected=0x40000|spBefore;steps=1 }
    else if (spSupply != 0) { expected=0x100000;steps=12 }
    else if (spPads != 0) { expected=if (spPads < 0) 0x20000 else 0x20000|spPads }
    else if (prepare) {
        if (spClock != 1) { expected=0x80000|spClock;steps=1234 }
        else { expected=if (spAfter == 0) 1 else 0x40000|spAfter;steps=12345 }
    }
    val actual=s3PsramStartupPrepareOwned(1800,100,prepare,true)
    return actual == expected && spStep == steps && !spBad
}
@export("abla_s3_psram_startup_prepare_test")
fun startupPrepareTest(): int {
    spStep=0
    if (s3PsramStartupPrepareOwned(1800,100,true,false) != 2 ||
        s3PsramStartupPrepareOwned(0,100,true,true) != 2 ||
        s3PsramStartupPrepareOwned(1800,0,true,true) != 2 ||
        s3PsramStartupPrepareOwned(3300,1000001,true,true) != 2 || spStep != 0) return 1
    var prepare=0
    while (prepare < 2) {
        spBefore=0
        while (spBefore < 16) {
            spSupply=0
            while (spSupply < 3) {
                var pad=0
                while (pad < 4) {
                    spPads=if (pad == 0) 0 else if (pad == 1) -1 else if (pad == 2) 1 else 4095
                    spClock=1
                    while (spClock <= 5) {
                        spAfter=0
                        while (spAfter < 16) {
                            if (!spRun(prepare != 0)) return 2
                            spAfter=spAfter+1
                        }
                        spClock=spClock+1
                    }
                    pad=pad+1
                }
                spSupply=spSupply+1
            }
            spBefore=spBefore+1
        }
        prepare=prepare+1
    }
    // A matching 3.3V contract also succeeds without clock preparation.
    spBefore=0;spSupply=1;spPads=0;spStep=0;spBad=false
    if (s3PsramStartupPrepareOwned(3300,100,false,true) != 1 || spStep != 123 || spBad) return 3
    return 0
}
