import "../src/m5stack/vibration_sequence.ab"
import "../src/m5stack/stopwatch_vibration_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var trace=0
var failAt=0
var expectedLevel=0
var expectedIdentity=3
var bad=false
var ownerReady=true
var pwmFrequency=2000
var frequencyReads=0
fun stopWatchVibrationHandle(control: int): int = if (ownerReady && control == 19) 7 else 0
fun stopWatchVibrationFrequency(handle: int): int {
    frequencyReads=frequencyReads+1
    if (handle != 7) bad=true
    return pwmFrequency
}
fun step(handle: int,code: int): bool {
    if (handle != 7) bad=true
    calls=calls+1; trace=trace*10+code
    calls != failAt
}
fun m5VibrationVoltage(handle: int,identity: int,millivolts: int): bool {
    if (identity != expectedIdentity || millivolts != (if (expectedLevel == 0) 0 else 480+expectedLevel*12)) bad=true
    step(handle,4)
}
fun m5VibrationHighImpedance(handle: int,pin: int,enabled: bool): bool {
    if (pin != 8 || enabled) bad=true
    step(handle,1)
}
fun m5VibrationDirection(handle: int,pin: int,output: bool): bool {
    if (pin != 8 || !output) bad=true
    step(handle,2)
}
fun m5VibrationPwm(handle: int,channel: int,duty: int,enabled: bool): bool {
    if (channel != 0 || duty != expectedLevel*4095/255 || enabled != (expectedLevel > 0)) bad=true
    step(handle,3)
}
@export("abla_vibration_test")
fun vibrationTest(): i32 {
    while (expectedLevel <= 255) {
        failAt=0
        while (failAt <= 3) {
            calls=0; trace=0; bad=false
            val result=m5BoardStopWatch.setExpanderVibrationOwned(7,expectedLevel)
            val expectedCalls=if (expectedLevel == 0) 1 else if (failAt == 0) 3 else failAt
            val expectedStatus=if (failAt == 0 || (expectedLevel == 0 && failAt > 1)) 1
                else if (expectedLevel == 0 || failAt == 3) 6 else failAt+3
            if (result.status() != expectedStatus || result.ok() != (expectedStatus == 1) ||
                calls != expectedCalls || trace != (if (expectedLevel == 0) 3 else if (calls == 1) 1 else if (calls == 2) 12 else 123) || bad) return i32(1)
            var chip=0
            while (chip < 2) {
                expectedIdentity=if (chip == 0) 3 else 74
                calls=0; trace=0; bad=false
                val axp=m5BoardStackCore2.setAxpVibrationOwned(7,expectedIdentity,expectedLevel)
                if (axp.status() != (if (failAt == 1) 6 else 1) || calls != 1 || trace != 4 || bad) return i32(2)
                chip=chip+1
            }
            failAt=failAt+1
        }
        expectedLevel=expectedLevel+1
    }
    calls=0
    if (m5BoardTough.setAxpVibrationOwned(7,3,100).status() != 2 ||
        m5BoardStackCore2.setAxpVibrationOwned(7,4,100).status() != 2 ||
        m5BoardStopWatch.setAxpVibrationOwned(7,74,100).status() != 2 ||
        m5BoardStackCore2.setExpanderVibrationOwned(7,100).status() != 2) return i32(3)
    var sample=0
    while (sample < 5) {
        val handle=if (sample == 0) 0 else if (sample == 1) -1 else if (sample == 2) 4294967296 else 7
        val level=if (sample == 3) -1 else if (sample == 4) 256 else 0
        if (m5BoardStackCore2.setAxpVibrationOwned(handle,3,level).status() != 3 ||
            m5BoardStopWatch.setExpanderVibrationOwned(handle,level).status() != 3) return i32(4)
        sample=sample+1
    }
    if (calls != 0) return i32(5)
    expectedLevel=0
    while (expectedLevel <= 255) {
        var frequencyCase=0
        while (frequencyCase < 4) {
            pwmFrequency=if (frequencyCase == 0) 2000 else if (frequencyCase == 1) -1 else if (frequencyCase == 2) 0 else 5000
            failAt=0;calls=0;frequencyReads=0;bad=false;trace=0
            val result=stopWatchVibrationOwned(19,expectedLevel,true)
            val allowed=expectedLevel == 0 || frequencyCase == 0
            if (result.status() != (if (allowed) 1 else if (frequencyCase == 1) 7 else 8) ||
                frequencyReads != (if (expectedLevel == 0) 0 else 1) ||
                calls != (if (!allowed) 0 else if (expectedLevel == 0) 1 else 3) || bad) return i32(6)
            frequencyCase=frequencyCase+1
        }
        expectedLevel=expectedLevel+1
    }
    calls=0;frequencyReads=0;ownerReady=false
    if (stopWatchVibrationOwned(19,100,true).status() != 3 || stopWatchVibrationOwned(19,0,true).status() != 3) return i32(7)
    ownerReady=true
    if (stopWatchVibrationOwned(18,100,true).status() != 3 || stopWatchVibrationOwned(19,100,false).status() != 3 ||
        stopWatchVibrationOwned(19,-1,true).status() != 3 || stopWatchVibrationOwned(19,256,true).status() != 3 ||
        calls != 0 || frequencyReads != 0) return i32(8)
    i32(0)
}
