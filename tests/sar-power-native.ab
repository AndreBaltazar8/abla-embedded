import "../src/esp32/sar_power_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var power=0
var state=0
var adc1=0
var adc2=0
var writes=0
var drop=false
var bad=false
fun esp32SarPowerRead(offset: int): int {
    if (offset == 12) return power
    if (offset == 60) return state
    if (offset == 84) return adc1
    if (offset == 148) return adc2
    bad=true; return 0
}
fun esp32SarPowerWrite(offset: int,value: int): void {
    if (offset != 12 || (value&0xfff3ffff) != (power&0xfff3ffff)) bad=true
    writes=writes+1; if (!drop) power=value; return
}
@export("abla_sar_power_test")
fun powerTest(): i32 {
    var original=0
    while (original <= 3) {
        power=0xa5531234|(original<<18); writes=0
        var owner=esp32SarPowerOpenOwned(false)
        if (owner.status() != (if (original == 3) 1 else if (original == 1) 2 else 3) || writes != 0) return i32(1)
        owner=esp32SarPowerOpenOwned(true)
        if (original == 1) {
            if (owner.status() != 2 || writes != 0) return i32(2)
        } else {
            if (!owner.powered() || ((power>>18)&3) != 3) return i32(3)
            owner=owner.closeOwned()
            if (owner.status() != 0 || power != (0xa5531234|(original<<18)) || writes != (if (original == 3) 0 else 2)) return i32(4)
        }
        original=original+1
    }
    power=0; writes=0; drop=true
    var owner=esp32SarPowerOpenOwned(true)
    if (owner.status() != 4 || owner.closeOwned().status() != 0) return i32(5)
    drop=false; owner=esp32SarPowerOpenOwned(true); drop=true
    owner=owner.closeOwned()
    if (owner.status() != 4 || ((power>>18)&3) != 3) return i32(6)
    drop=false; owner=owner.closeOwned()
    if (owner.status() != 0 || power != 0) return i32(7)
    owner=esp32SarPowerOpenOwned(true); val before=writes
    state=0x400000
    if (owner.closeOwned().status() != 5) return i32(8)
    state=0; adc1=0x20000
    if (owner.closeOwned().status() != 5) return i32(9)
    adc1=0; adc2=0x20000
    if (owner.closeOwned().status() != 5 || writes != before) return i32(10)
    adc2=0; owner=owner.closeOwned()
    if (owner.status() != 0) return i32(11)
    power=0xc0000; owner=esp32SarPowerOpenOwned(false); power=0
    if (owner.closeOwned().status() != 6 || bad) return i32(12)
    return i32(0)
}
