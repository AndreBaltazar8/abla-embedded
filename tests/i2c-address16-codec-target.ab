import "../src/i2c/register_address16.ab"
import "abla/runtime/scalar"

// Test-only target backend validates every transmitted prefix byte.
type I2cDevice = int
trusted fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int,
    destination: NativeBuffer, length: int, timeout: int): bool {
    if (this != 1 || sourceLength != 2 || source.load(0) != 129 || source.load(1) != 78 ||
        length != 1 || timeout != 73) return false
    destination.store(0, 0x85)
    true
}
trusted fun I2cDevice.write(source: NativeBuffer, length: int, timeout: int): bool =
    this == 1 && length == 3 && source.load(0) == 129 && source.load(1) == 78 &&
        source.load(2) == 0 && timeout == 73

@export("abla_i2c_address16_codec_test")
trusted fun address16CodecTest(): int {
    val device = I2cDevice(1)
    val value = device.readRegisterAddress16ByteChecked(0x814e, 73)
    if (!value.valid() || value.value() != 0x85) return 1
    if (!device.writeRegisterAddress16Byte(0x814e, 0, 73)) return 2
    if (I2cDevice(0).readRegisterAddress16ByteChecked(0x814e, 73).valid() ||
        I2cDevice(0).writeRegisterAddress16Byte(0x814e, 0, 73)) return 3
    if (device.writeRegisterAddress16Byte(-1, 0) || device.writeRegisterAddress16Byte(65536, 0) ||
        device.writeRegisterAddress16Byte(0, -1) || device.writeRegisterAddress16Byte(0, 256)) return 4
    return 0
}
