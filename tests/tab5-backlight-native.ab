import "../src/m5stack/tab5_backlight_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var held=0
var ready=true
var latch=false
var drop=false
var writes=0
var configured=0
var bad=false
fun esp32P4GpioIndividualHoldOwned(layout: int,pin: int): int { if (pin != 22) bad=true; return held }
fun esp32P4GpioConfigureOwned(pin: int,output: bool,high: bool,openDrain: bool,input: bool,pull: int): int {
    if (pin != 22 || !output || high || openDrain || input || pull != 2) bad=true
    configured=configured+1; latch=false; return 1
}
fun p4Tab5BacklightGpioReady(): bool = ready
fun p4Tab5BacklightLatch(): bool = latch
fun esp32P4GpioWriteOwned(pin: int,on: bool): bool { if (pin != 22) bad=true; writes=writes+1; if (!drop) latch=on; return true }
@export("abla_tab5_backlight_test")
fun backlightTest(): i32 {
    if (tab5BacklightConfigureOffOwned(1) != 1 || tab5BacklightConfigureOffOwned(3) != 1 || configured != 2 || latch || bad) return i32(1)
    if (tab5BacklightSetOwned(3,true) != 1 || !latch || tab5BacklightSetOwned(1,false) != 1 || latch) return i32(2)
    held=1
    if (tab5BacklightConfigureOffOwned(3) != 3 || tab5BacklightSetOwned(3,true) != 3 || writes != 2 || configured != 2) return i32(3)
    held=0; ready=false
    if (tab5BacklightSetOwned(3,true) != 3 || writes != 2) return i32(4)
    ready=true; drop=true
    if (tab5BacklightSetOwned(3,true) != 4 || latch) return i32(5)
    if (tab5BacklightConfigureOffOwned(2) != 2 || tab5BacklightSetOwned(2,true) != 2 || writes != 3 || bad) return i32(6)
    return i32(0)
}
