import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
import "abla/runtime/scalar"
var descriptors=0x4ff00000
var buffers=0x4ff40000
var count=3
var stride=4096
var bytes=1
var tx=false
var circular=false
var writes=0
var bad=false
trusted fun p4AhbDescriptorWrite(address: int,value: int): void {
    val index=writes/3
    val word=writes%3
    val base=descriptors+index*64
    val last=index == count-1
    if (index >= count) bad=true
    if (word == 0 && (address != base+4 || value != buffers+index*stride)) bad=true
    if (word == 1 && (address != base+8 || value != (if (last) (if (circular) descriptors else 0) else base+64))) bad=true
    if (word == 2) {
        if (address != base || (value & 4095) != bytes || ((value >>> 12) & 4095) != (if (tx) bytes else 0) ||
            ((value >>> 24) & 63) != 0 || ((value >>> 30) & 1) != (if (tx && (circular || last)) 1 else 0) ||
            ((value >>> 31) & 1) != 1 || (value >>> 32) != 0) bad=true
    }
    writes=writes+1
    return
}
trusted fun run(): bool {
    writes=0;bad=false
    return esp32p4AhbGdmaBuildRingOwned(descriptors,count,buffers,stride,bytes,tx,circular,true) && writes == count*3 && !bad
}
@export("abla_ahb_gdma_ring_p4_test")
trusted fun test(): i32 {
    var mode=0
    while (mode < 4) {
        tx=(mode & 1) != 0;circular=(mode & 2) != 0
        bytes=1
        while (bytes <= 4095) { if (!run()) return i32(1);bytes=bytes+1 }
        mode=mode+1
    }
    count=4095;stride=64;bytes=64
    if (!run()) return i32(2)
    count=1;descriptors=0x4ffbffc0;buffers=0x4ff00000
    if (!run()) return i32(3)
    descriptors=0x4ff00000;buffers=0x4ffbffc0
    if (!run()) return i32(4)
    writes=0
    if (esp32p4AhbGdmaBuildRingOwned(descriptors,count,buffers,stride,bytes,tx,circular,false) || writes != 0) return i32(5)
    if (esp32p4AhbGdmaRingLayoutValid(0x4ff00004,1,0x4ff00100,64,64) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ff00000,1,0x4ff00104,64,64) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ff00000,1,0x4ff00100,68,64) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ff00000,1,0x4ff00100,64,65) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ff00000,2,0x4ff00040,64,1) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ff00040,2,0x4ff00000,64,1) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ffbffc0,2,0x4ff00000,64,1) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ff00000,2,0x4ffbffc0,64,1) ||
        esp32p4AhbGdmaRingLayoutValid(0x48000000,1,0x4ff00100,64,64) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ff00000,0,0x4ff00100,64,64) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ff00000,4096,0x4ff80000,64,64) ||
        esp32p4AhbGdmaRingLayoutValid(0x4ff00000,1,0x4ff00100,4096,4096)) return i32(6)
    if (esp32p4AhbGdmaBuildRingOwned(0x4ff00000,1,0x4ff00000,64,64,false,true,true) || writes != 0) return i32(7)
    return i32(0)
}
