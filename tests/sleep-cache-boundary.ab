// The sleep cache-off boundary check accepts a retained, non-inline IRAM closure and
// rejects the three unsafe placements.

import "abla/io"
import "abla/text"
import "../tools/check-sleep-cache-boundary.ab"

fun main: int {
    val source = "define internal i64 @boundary(i64 %x) #0 section \".iram1.abla.s3LightSleepSuspended\" {\n" +
        "  %y = call i64 @helper(i64 %x)\n  ret i64 %y\n}\n" +
        "define internal i64 @helper(i64 %x) #1 section \".iram1.abla.helper\" {\n  ret i64 %x\n}\n" +
        "define i64 @ordinary(i64 %x) #1 {\n  %y = call i64 @boundary(i64 %x)\n  ret i64 %y\n}\n" +
        "attributes #0 = { noinline minsize }\nattributes #1 = { minsize }\n"
    var failures = 0
    val good = validateSleepCacheBoundary(source)
    if (good.error != "" || good.retained != 2) {
        println("FAIL expected 2 retained functions, got ${good.retained} (${good.error})")
        failures = failures + 1
    }
    val broken = [
        source.replace("noinline ", ""),
        source.replace(".iram1.abla.s3LightSleepSuspended", ".text.boundary"),
        source.replace(".iram1.abla.helper", ".text.helper")
    ]
    val labels = ["inlinable boundary", "boundary moved to flash", "helper moved to flash"]
    var index = 0
    while (index < broken.size) {
        if (validateSleepCacheBoundary(broken[index]).error == "") {
            println("FAIL unsafe placement accepted: ${labels[index]}")
            failures = failures + 1
        }
        index = index + 1
    }
    if (failures != 0) return 1
    println("PASS: sleep boundary retention, inlining and helper placement regressions")
    0
}
