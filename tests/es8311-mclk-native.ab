import "../src/audio/es8311_device.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
fun I2cBus.valid(): bool = this == 1
fun I2cBus.device(address: int,frequency: int): I2cDevice = I2cDevice(2)
fun I2cDevice.close(): bool = this == 2
val registers=nativeStaticU32s([13,68,68,1,2,3,22,4,5,11,12,16,17,0,1,6,19,27,28,68,9,23,14,18,20,13,21,55,69,7,8,50])
val values=nativeStaticU32s([250,8,8,48,0,16,36,16,0,0,0,31,127,128,63,3,16,10,106,88,0,191,2,0,26,1,64,8,0,0,255,191])
var calls=0
var fail=0
var bad=false
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool {
    if (this != 2 || calls >= 32) { bad=true;return false }
    if (register != nativeAddressLoadU32(registers,calls*4) || value != nativeAddressLoadU32(values,calls*4)) bad=true
    calls=calls+1;return calls != fail
}
@export("abla_es8311_mclk_test")
trusted fun test(): i32 {
    while (fail <= 32) {
        calls=0
        if (Es8311(2).configureSpeakerMclk25624kOwned(true) != (if (fail == 0) 1 else fail+2) ||
            calls != (if (fail == 0) 32 else fail) || bad) return i32(1)
        fail=fail+1
    }
    calls=0
    if (Es8311(0).configureSpeakerMclk25624kOwned(true) != 2 || Es8311(2).configureSpeakerMclk25624kOwned(false) != 2 || calls != 0) return i32(2)
    return i32(0)
}
