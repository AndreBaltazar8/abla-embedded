import "../src/esp32/power/retention_clock_p4.ab"
trusted fun clockRetentionChecks(c: NativeBuffer,out: NativeBuffer): int {
    var node=0
    while (node < 9) {
        var terminal=0
        while (terminal < 2) {
            var i=0;while (i < 52) { out.storeU32(i,0x12345678);i=i+4 }
            val next=if (terminal == 0) 0x30200000 else 0
            if (!esp32p4RetentionClockConfig(c,node,if (node == 4) 0x30100000 else 0,next) || !esp32p4RetentionDescriptorEncode(out,c)) return 70
            val address=if (node == 0) 0x50120000 else if (node == 1 || node == 2 || node == 3) 0x500e60bc else if (node == 4) 0x500e6000 else if (node == 5 || node == 6) 0x500e6004 else 0x500e6038
            val wait=node == 2 || node == 6 || node == 8
            val head=(if (node == 4) 0xec/4+1 else (1<<30)|(if (wait) 3<<16 else 2<<16))|(if (terminal == 1) 1<<31 else 0)
            if (out.loadU32(0) != head || out.loadU32(4) != next || out.loadU32(8) != address || out.loadU32(20) != 0x12345678) return 71
            if (node == 4) {
                if (out.loadU32(12) != address || out.loadU32(16) != 0x30100000) return 72
            } else {
                val mask=if (node == 0) 1<<27 else if (node == 2) 1<<6 else if (node == 1 || node == 3) 1<<7 else if (node == 5 || node == 6) 1<<4 else 1<<8
                val value=if (node == 1 || node == 6 || node == 8) 0 else mask
                if (out.loadU32(12) != value || out.loadU32(16) != mask) return 73
            }
            terminal=terminal+1
        }
        node=node+1
    }
    c.storeU32(0,0xabcdef12)
    if (esp32p4RetentionClockConfig(c,9,0,0) || esp32p4RetentionClockConfig(c,4,0xfffffffc,0) ||
        esp32p4RetentionClockConfig(c,4,0,0) || esp32p4RetentionClockConfig(c,0,0x30100000,0) || c.loadU32(0) != 0xabcdef12) return 74
    return 0
}
