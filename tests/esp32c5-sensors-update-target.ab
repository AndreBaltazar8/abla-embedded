import "../src/esp32/i2c_lp_esp32c5.ab"
import "../src/esp32/peripheral_delay_esp32c5.ab"
import "../src/m5stack/sensors_update.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun imuDelay(milliseconds: int): void { peripheralDelayMilliseconds(milliseconds); return }
@export("abla_c5_sensors_update_target")
trusted fun updateTarget(owner: M5Sensors,snapshot: ImuSnapshot,scratch: NativeBuffer,offsets: ImuOffsets,
    micros: int,sensor: int,axis: int,order: ImuAxisOrder): int {
    val result=owner.updateImu(snapshot,scratch,micros)
    if (!result.valid() || result.failed()) return -1
    return owner.measureImuAxis(snapshot,offsets,sensor,axis,order) | 0
}
