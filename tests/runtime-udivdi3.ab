import "../src/esp32/runtime/libgcc_udivdi3_esp32.ab"
import "abla/runtime/self"

fun main: int = if (
    esp32UnsignedDivide64(u64(0), u64(1)) == u64(0) &&
    esp32UnsignedDivide64(
        u64(18446744073709551615), u64(1)
    ) == u64(18446744073709551615) &&
    esp32UnsignedDivide64(
        u64(18446744073709551615), u64(18446744073709551615)
    ) == u64(1) &&
    esp32UnsignedDivide64(
        u64(18446744073709551615), u64(2)
    ) == u64(9223372036854775807) &&
    esp32UnsignedDivide64(
        u64(9223372036854775808), u64(3)
    ) == u64(3074457345618258602) &&
    esp32UnsignedDivide64(
        u64(18446744073709551615), u64(4294967295)
    ) == u64(4294967297) &&
    esp32UnsignedDivide64(
        u64(9223372036854775808), u64(9223372036854775809)
    ) == u64(0)
) 0 else 1
