import "../src/display/dsi_frame_rearm_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var events=u32(2)
var active=false
var underrun=false
var step=0
var fail=0
var bad=false
fun p4DwDmaRead(offset: int): u32 {
    if (offset == 16) return u32(1)
    if (offset == 24 && active) return u32(15)
    if (offset >= 392) return events
    return u32(0)
}
fun p4DsiBridgeRead(offset: int): u32 = if (underrun) u32(1) else u32(0)
fun p4CacheSyncRead(offset: int): u32 = u32(16)
fun p4CacheSyncWrite(offset: int,value: u32): void { bad=true; return }
trusted fun p4DsiPrepareFrame(descriptor: NativeBuffer,frame: NativeBuffer,bytes: int): bool {
    if (step != 0) bad=true
    step=1; return fail != 1
}
fun p4DsiPublicationFence(): void {
    if (step != 1 && step != 3 && step != 6) bad=true
    step=step+1; return
}
trusted fun p4DsiWritebackFrame(buffer: NativeBuffer,bytes: int,line: int,polls: int): int {
    if (step != 2 || buffer.addressValue() != 1341128704 || bytes != 64) bad=true
    step=3; return if (fail == 3) 5 else 1
}
fun p4DsiAcknowledgeFrameChannel(channel: int,mask: int): int {
    if (step != 4 || mask != int(events)) bad=true
    step=5
    if (fail == 5) return 3
    events=u32(0); return 1
}
fun p4DsiConfigureFrameChannel(channel: int,address: int): int {
    if (step != 5 || events != u32(0)) bad=true
    step=6; return if (fail == 6) 6 else 1
}
fun p4DsiStartFrameChannel(channel: int): int {
    if (step != 7) bad=true
    step=8; return if (fail == 8) 5 else 1
}
fun resetRearm(): void { events=u32(2); active=false; underrun=false; step=0; fail=0; bad=false; return }
trusted fun runRearm(channel: int): int = esp32P4DsiFrameRearmImmutableOwned(channel,nativeBufferAt(1341128704,64),nativeBufferAt(1207959552,1843200),1843200,128,2)
@export("abla_dsi_p4_rearm_test")
trusted fun testRearm(): i32 {
    var channel=0
    while (channel < 4) {
        resetRearm()
        if (runRearm(channel) != 131073 || step != 8 || bad) return i32(1)
        var fault=1
        while (fault <= 8) {
            if (fault == 1 || fault == 3 || fault == 5 || fault == 6 || fault == 8) {
                resetRearm(); fail=fault
                val result=runRearm(channel)
                val expected=if (fault == 1) 5 else if (fault == 3) 1286 else if (fault == 5) 775 else if (fault == 6) 1544 else 1289
                if (result != (131072|expected) || step != fault || bad) return i32(2)
                if (fault <= 5 && events != u32(2)) return i32(3)
            }
            fault=fault+1
        }
        resetRearm(); active=true
        if (runRearm(channel) != 131075 || step != 0) return i32(4)
        resetRearm(); events=u32(0)
        if (runRearm(channel) != 0 || step != 0) return i32(5)
        resetRearm(); underrun=true
        if (runRearm(channel) != 131076 || step != 0 || events != u32(2)) return i32(6)
        var bit=0
        while (bit < 32) {
            if (bit != 0 && bit != 1 && bit != 3 && bit != 4) {
                resetRearm(); events=u32(2)|(u32(1)<<u32(bit))
                if (runRearm(channel) != ((int(events)<<16)|4) || step != 0 || bad) return i32(7)
            }
            bit=bit+1
        }
        channel=channel+1
    }
    return i32(0)
}
