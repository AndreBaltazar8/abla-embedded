import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/bootstrap_c5_sequence.ab"
var channel=0
var tx=false
var conf=u32(0)
var dma=u32(0)
var writes=0
var drop=0
var pulses=0
var history=0
var selfClear=false
var enabled=true
var busy=0
var bad=false
trusted fun c5I2sClockRead(at: int): u32 = if (at == 0) u32(13) else if (enabled) u32(0x400000) else u32(0)
trusted fun c5I2sClockWrite(at: int,v: u32): void { bad=true;return }
trusted fun c5I2sRead(at: int): u32 = if (at == (if (tx) 0x24 else 0x20)) conf else if (at == 0x6c) u32(1) else if (at == 0x14 && busy == 1) u32(1) else u32(0)
trusted fun c5I2sWrite(at: int,v: u32): void {
    if (at != (if (tx) 0x24 else 0x20) || ((v^conf)&~u32(3)) != u32(0)) bad=true
    writes=writes+1;history=history*4+int(v&u32(3))
    if (writes == drop) return
    if ((v&u32(3)) != u32(0)) pulses=pulses+1
    conf=if (selfClear) v&~u32(3) else v
    return
}
trusted fun c5AhbGdmaBusRead(): u32 = u32(1)
trusted fun c5AhbGdmaBusWrite(v: u32): void { bad=true;return }
trusted fun c5AhbGdmaRead(at: int): u32 {
    val base=0x70+channel*192+(if (tx) 96 else 0)
    val event=channel*16+(if (tx) 48 else 0)
    if (at == 0x64) return u32(8)
    if (at == base) return dma|(if (busy == 2) u32(if (tx) 64 else 32) else u32(0))
    if (at == base+16) return u32(if (busy == 3) 0 else if (tx) 8 else 16)
    if (at == event && busy == 4) return u32(1)
    if (at == event+8 && busy == 5) return u32(1)
    return u32(0)
}
trusted fun c5AhbGdmaWrite(at: int,v: u32): void {
    if (at != 0x70+channel*192+(if (tx) 96 else 0) || ((v^dma)&~u32(1)) != u32(0)) bad=true
    writes=writes+1;history=history*4+(if ((v&u32(1)) != u32(0)) 3 else 0)
    if (writes == drop) return
    if ((v&u32(1)) != u32(0)) pulses=pulses+1
    dma=if (selfClear) v&~u32(1) else v
    return
}
@export("abla_i2s_bootstrap_c5_test")
trusted fun test(): i32 {
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 1
            var mode=0
            while (mode < 2) {
                selfClear=mode == 1
                var fault=0
                while (fault <= 6) {
                    conf=u32(0xa5a5a0f8);dma=u32(0x100);writes=0;drop=fault;pulses=0;history=0
                    val result=c5I2sBootstrapOwned(channel,tx,true,true)
                    val failed=!selfClear && fault > 0 && (fault&1) == 0
                    if (result.status() != (if (failed) 5 else 1) || result.stage() != (if (failed) fault/2 else 3)) return i32(1)
                    // Six writes encode controller1,0; DMA3,0; FIFO2,0.
                    if (!failed && (writes != 6 || history != 1224)) return i32(2)
                    if (failed && writes != fault) return i32(3)
                    drop=0
                    val oldPulses=pulses
                    val released=result.releaseOwned(true)
                    if (released.status() != (if (failed) 6 else 1) || pulses != oldPulses || conf != u32(0xa5a5a0f8) || dma != u32(0x100)) return i32(4)
                    val oldWrites=writes
                    if (released.releaseOwned(true) != released || writes != oldWrites || bad) return i32(5)
                    fault=fault+1
                }
                mode=mode+1
            }
            busy=1;writes=0
            while (busy <= 5) {
                if (c5I2sBootstrapOwned(channel,tx,true,true).status() != 4 || writes != 0) return i32(6)
                busy=busy+1
            }
            busy=0;enabled=false
            if (c5I2sBootstrapOwned(channel,tx,true,true).status() != 3 || writes != 0) return i32(7)
            enabled=true
            if (c5I2sBootstrapOwned(channel,tx,true,false).status() != 2 || c5I2sBootstrapOwned(channel,tx,false,true).status() != 2 || writes != 0) return i32(8)
            direction=direction+1
        }
        channel=channel+1
    }
    return i32(0)
}
