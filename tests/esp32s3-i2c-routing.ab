import "../src/esp32/i2c/routing_s3_logic.ab"

fun main(): int {
    var number = -1
    while (number <= 49) {
        var signal = 89
        while (signal <= 92) {
            val valid = espChipS3().gpioOutputValid(number)
            val matrix = u32(128) | u32(number)
            if (esp32S3I2cPinRouteValid(number, signal, u32(0x1200), matrix, u32(signal)) != valid) return 1
            if (esp32S3I2cPinRouteValid(number, signal, u32(0x1000), matrix, u32(signal))) return 2
            if (esp32S3I2cPinRouteValid(number, signal, u32(0x2200), matrix, u32(signal))) return 3
            if (esp32S3I2cPinRouteValid(number, signal, u32(0x1200), matrix ^ u32(64), u32(signal))) return 4
            if (esp32S3I2cPinRouteValid(number, signal, u32(0x1200), matrix, u32(signal) | u32(1024))) return 5
            if (esp32S3I2cPinRouteValid(number, signal, u32(0x1200), matrix, u32(signal) | u32(512))) return 6
            signal = signal + 1
        }
        number = number + 1
    }
    if (esp32S3I2cPinRouteValid(4, 88, u32(0x1200), u32(132), u32(88))) return 7
    if (esp32S3I2cPinRouteValid(4, 93, u32(0x1200), u32(132), u32(93))) return 8
    0
}
