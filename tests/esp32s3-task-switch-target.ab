import "../src/esp32/task_switch_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_task_switch_target")
@section(".iram1.abla.s3TaskSwitchTarget")
trusted fun switchTarget(current: NativeBuffer,previous: NativeBuffer,next: NativeBuffer,owners: NativeBuffer,interrupted: NativeBuffer,resume: NativeBuffer,core: int,level: int): int =
    esp32S3TaskSwitchOwned(current,previous,next,owners,interrupted,resume,core,level)
