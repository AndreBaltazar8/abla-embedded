import "../src/esp32/i2c_esp32s3.ab"
import "../src/power/axp192_device.ab"
import "../src/power/ina3221_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_current_checked_target")
trusted fun currentTarget(power: Axp192,monitor: Ina3221,channel: int,axp: bool): PowerMeasurement =
    if (axp) power.batteryMilliampsChecked() else monitor.currentMilliampsChecked(channel)
