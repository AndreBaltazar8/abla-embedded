import "../src/sd/software_init.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val responseStorage = nativeStaticMutableU32s([0])
var selected = false
var outputHigh = false
var frame = 0
var bits = 0
var reads = 0
var variant = 0
var bad = false
var blockLength = false
var applicationCount = 0
var idleClocks = 0
trusted fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) {
        selected = !high
        if (selected) { frame = 0; bits = 0; reads = 0 }
    }
    if (this == 1 && high) {
        if (selected) {
            if (bits < 48) frame = (frame << 1) | (if (outputHigh) 1 else 0)
            bits = bits + 1
        } else {
            if (!outputHigh) bad = true
            idleClocks = idleClocks + 1
        }
    }
    return
}
trusted fun Pin.read(): bool {
    if (this != 3 || !selected || bits < 48) bad = true
    val command = (frame >>> 40) & 63
    val argument = (frame >>> 8) & 4294967295
    val byte = reads / 8
    var value = 0
    if (command == 0 || command == 55) value = 1
    else if (command == 8) {
        if (variant == 1) value = 5
        else if (byte == 0) value = 1
        else if (byte == 3) value = 1
        else if (byte == 4) value = if (variant == 3) 171 else 170
    } else if (command == 41) {
        if (reads == 0) applicationCount = applicationCount + 1
        if (argument != (if (variant == 1) 0 else 1073741824)) bad = true
        value = if (variant == 5 || applicationCount == 1) 1 else 0
    } else if (command == 58) {
        if (byte == 1) value = if (variant == 4) 64 else if (variant == 0) 192 else 128
        else if (byte == 2) value = 255
        else if (byte == 3) value = 128
    } else if (command == 16) {
        blockLength = true
        if (argument != 512) bad = true
    } else bad = true
    val result = ((value >> (7 - reads % 8)) & 1) != 0
    reads = reads + 1
    result
}
fun peripheralDelayMicroseconds(duration: int): void {
    if (duration != 2 && duration != 1000) bad = true
    return
}
trusted fun sdInitTest(): int {
    while (variant < 6) {
        applicationCount = 0
        blockLength = false
        idleClocks = 0
        val result = softwareSdInitialize(peripheralGateAt(gateStorage), u32(7), Pin(1), Pin(2), Pin(3), Pin(4), nativeBufferAt(responseStorage, 4))
        if (bad || selected || idleClocks < 80 || nativeAddressLoadU32(gateStorage, 0) != 0) return 1
        if (variant < 3) {
            if (!result.valid() || result.highCapacity() != (variant == 0) || result.version2() != (variant != 1)) return 2
            if (blockLength != (variant != 0) || applicationCount != 2) return 3
        } else if (result.status() != (if (variant == 3) 7 else if (variant == 4) 9 else 8)) return 4
        if (variant == 5 && applicationCount != 1000) return 5
        variant = variant + 1
    }
    0
}
#exportFunction("sdInitTest", "abla_sd_init_test")
