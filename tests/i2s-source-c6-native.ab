import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/source_c6_sequence.ab"
var bus=u32(0)
var tx=u32(0)
var rx=u32(0)
var writes=0
var drop=0
var busy=0
var bad=false
trusted fun c6I2sClockRead(offset: int): u32 = if (offset == 0) bus else if (offset == 4) tx else rx
trusted fun c6I2sClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes != drop) { if (offset == 0) bus=value else if (offset == 4) tx=value else if (offset == 12) rx=value else bad=true }
    return
}
trusted fun c6I2sRead(offset: int): u32 {
    if ((bus&u32(3)) != u32(1)) bad=true
    if (offset == 0x6c) return if (busy == 5) u32(0) else u32(1)
    if (offset == 0x14) return if (busy == 1) u32(1) else u32(0)
    if (offset == 0x20) return if (busy == 2) u32(4) else if (busy == 3) u32(256) else u32(0)
    if (offset == 0x24) return if (busy == 4) u32(4) else u32(0)
    bad=true;return u32(0)
}

@export("abla_i2s_source_c6_test")
trusted fun test(): i32 {
    var kind=0
    while (kind < 2) {
        var pair=0
        while (pair < 16) {
            val original=pair&3;val requested=pair>>>2
            var borrowed=0
            while (borrowed < 2) {
                val oldBus=u32(0xa5000000|borrowed)
                val oldTx=u32(0x80003210|(original<<20))
                val oldRx=u32(0x80802123|(original<<20))
                var fault=0
                while (fault < 8) {
                    bus=oldBus;tx=oldTx;rx=oldRx;writes=0;drop=fault;busy=0;bad=false
                    var source=c6I2sSourceOpenOwned(kind == 1,requested,true)
                    if (source.status() == 1 && int(((if (kind == 1) tx else rx)>>u32(20))&u32(3)) != requested) return i32(1)
                    source=source.closeOwned(true);drop=0;source=source.closeOwned(true)
                    if (source.status() != 7 || bus != oldBus || tx != oldTx || rx != oldRx || bad) return i32(2)
                    fault=fault+1
                }
                borrowed=borrowed+1
            }
            pair=pair+1
        }
        kind=kind+1
    }
    // Never retarget an enabled function clock, or restore through a live child.
    bus=u32(1);tx=u32(0x400000);rx=u32(0);writes=0;drop=0;busy=0;bad=false
    if (c6I2sSourceOpenOwned(true,1,true).status() != 5 || writes != 0) return i32(3)
    tx=u32(0)
    var owner=c6I2sSourceOpenOwned(true,1,true)
    if (owner.status() != 1) return i32(4)
    tx=tx|u32(0x400000);val before=writes
    owner=owner.closeOwned(true)
    if (owner.status() != 8 || writes != before) return i32(5)
    tx=tx&~u32(0x400000)
    tx=(tx&~u32(0x300000))|u32(0x200000)
    owner=owner.closeOwned(true)
    if (owner.status() != 9 || writes != before) return i32(6)
    tx=(tx&~u32(0x300000))|u32(0x100000)
    if (owner.closeOwned(true).status() != 7 || tx != u32(0)) return i32(7)
    // Unchanged borrowed functional gate survives close.
    tx=u32(0x500000);writes=0
    owner=c6I2sSourceOpenOwned(true,1,true)
    if (owner.status() != 1 || owner.closeOwned(true).status() != 7 || tx != u32(0x500000) || writes != 0) return i32(8)
    if (c6I2sSourceOpenOwned(true,4,true).status() != 2 || c6I2sSourceOpenOwned(true,1,false).status() != 2 || bad) return i32(9)
    return i32(0)
}
