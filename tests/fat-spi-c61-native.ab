import "./sd-fifo-c61-model.ab"
import "../src/storage/fat_spi_c61.ab"
import "../src/storage/fat_file_read.ab"
val sessionMemory=nativeStaticAllocate(64)
val fatMemory=nativeStaticAllocate(2588)
@export("abla_fat_spi_c61_test")
trusted fun testFatSpi(): i32 {
    cardMode=0;resetCard();imageEnabled=true
    val sessionStorage=nativeBufferAt(sessionMemory,64);val gate=peripheralGateAt(gateStorage)
    val spiScratch=nativeBufferAt(buffers,2);val response=nativeBufferAt(buffers+4,16)
    val reader=nativeBufferAt(fatMemory,28);val boot=nativeBufferAt(fatMemory+28,512)
    val output=nativeBufferAt(fatMemory+540,512);val workspace=nativeBufferAt(fatMemory+1052,1536)
    val image=nativeBufferAt(imageData,2560)
    var at=0
    while (at < 2560) { image.store(at,0);at=at+1 }
    image.store(12,2);image.store(13,1);image.store(14,1);image.store(16,2);image.store(18,2)
    image.store(22,40);image.store(19,129);image.store(20,39);image.store(510,85);image.store(511,170)
    image.storeU16(512,65528);image.storeU16(514,65535);image.storeU16(516,3);image.storeU16(518,65535)
    image.store(1024,86);image.store(1025,79);image.store(1026,73);image.store(1027,67);image.store(1028,69)
    at=5
    while (at < 8) { image.store(1024+at,32);at=at+1 }
    image.store(1032,82);image.store(1033,65);image.store(1034,87);image.store(1035,32)
    image.storeU16(1050,2);image.storeU32(1052,700)
    at=0
    while (at < 512) { image.store(1536+at,(at+113)&255);image.store(2048+at,(at+114)&255);at=at+1 }
    // CSD capacity10240 sectors, containing the10113-sector FAT16 volume.
    val csd=nativeBufferAt(cardRegisters,16);csd.store(9,9)
    var crc=0;at=0
    while (at < 15) { crc=sdSpiCrc7Byte(crc,csd.load(at));at=at+1 }
    csd.store(15,(crc<<1)|1)
    val master=openCardMaster()
    if (!esp32C61SdSessionInitializeFresh(sessionStorage)) return i32(1)
    var session=esp32C61SdSessionOpen(sessionStorage,master,gate,u32(7),160000000,spiScratch,response,4)
    if (session == 0 || !fatSpiC61ReaderInitialize(reader,session,u32(7),spiScratch,4) ||
        !fatStorageReadOwned(reader,0,boot) || !fatBootValidate(boot,0,10113).valid() || bad) return i32(2)
    val directory=fatDirectoryReadOwned(reader,boot,0,10113,0,0,1,output,nativeBufferAt(workspace.addressValue(),1024))
    val file=fatDirectoryDecode(output,0,16,10000)
    if (directory.status() != 1 || !file.isFile() || file.byteSize() != 700 || file.firstCluster() != 2 || bad) return i32(3)
    if (fatFileReadAtOwned(reader,boot,0,10113,file,0,512,2,output,workspace).bytesRead() != 512 || bad) return i32(4)
    at=0
    while (at < 512) { if (output.load(at) != ((at+113)&255)) return i32(5);at=at+1 }
    if (fatFileReadAtOwned(reader,boot,0,10113,file,512,512,2,output,workspace).bytesRead() != 188 || bad) return i32(6)
    at=0
    while (at < 188) { if (output.load(at) != ((at+114)&255)) return i32(7);at=at+1 }
    val before=starts
    if (fatStorageReadOwned(reader,10240,output) || fatStorageReadOwned(reader,0,nativeBufferAt(fatMemory,512)) ||
        fatSpiC61ReaderInitialize(nativeBufferAt(sessionMemory,28),session,u32(7),spiScratch,4) || starts != before) return i32(8)
    output.store(0,42);corruptRead=true
    if (fatFileReadAtOwned(reader,boot,0,10113,file,0,512,2,output,workspace).status() != 4 || output.load(0) != 42 || bad) return i32(9)
    corruptRead=false
    if (!master.recover(gate,u32(8),true)) return i32(10)
    session=esp32C61SdSessionOpen(sessionStorage,master,gate,u32(7),160000000,spiScratch,response,4)
    val reopened=starts
    if (session == 0 || fatStorageReadOwned(reader,0,output) || starts != reopened || bad) return i32(11)
    if (!fatSpiC61ReaderInitialize(reader,session,u32(7),spiScratch,4) || !fatStorageReadOwned(reader,0,output) || bad) return i32(12)
    if (!session.invalidate(u32(7)) || master.closeOwned(true) != 0 || bad) return i32(13)
    return i32(0)
}
