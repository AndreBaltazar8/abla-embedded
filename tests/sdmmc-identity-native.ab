import "./sdmmc-card-native.ab"
import "../src/sd/mmc_identity.ab"
import "../src/sd/cid.ab"
@export("abla_sdmmc_identity_test")
trusted fun testIdentity(): i32 {
    val card=nativeBufferAt(storage,80);val cid=nativeBufferAt(storage+80,16)
    var sample=0
    while (sample < 4096) {
        var index=0
        while (index < 15) { cid.store(index,(sample*37+index*17)&255);index=index+1 }
        cid.store(13,240|(sample>>>8));cid.store(14,sample)
        var crc=0;index=0
        while (index < 15) { crc=sdSpiCrc7Byte(crc,cid.load(index));index=index+1 }
        cid.store(15,(crc<<1)|1)
        // Independent bit-field assembly into RESP0..3 as IDF MMC_RSP_BITS.
        var word=0
        while (word < 4) {
            var value=0;var byte=0
            while (byte < 4) { value=value|(cid.load(15-word*4-byte)<<(byte*8));byte=byte+1 }
            card.storeU32(32+word*4,value);word=word+1
        }
        // Hardware may omit CRC/end bits; metadata must not depend on them.
        card.store(32,0);card.storeU32(0,0x53444901)
        if (sdMmcCardManufacturer(card) != sdCidManufacturer(cid) || sdMmcCardOem(card) != sdCidOem(cid) || sdMmcCardRevision(card) != sdCidRevision(cid) || sdMmcCardSerial(card) != sdCidSerial(cid) || sdMmcCardManufacturingYear(card) != sdCidManufacturingYear(cid) || sdMmcCardManufacturingMonth(card) != sdCidManufacturingMonth(cid)) return i32(1)
        index=0;while (index < 5) { if (sdMmcCardProductByte(card,index) != sdCidProductByte(cid,index)) return i32(2);index=index+1 }
        sample=sample+1
    }
    var status=0
    while (status < 256) {
        card.storeU32(0,0x53444900|status)
        if (status != 1 && (sdMmcCardManufacturer(card) != -1 || sdMmcCardOem(card) != -1 || sdMmcCardRevision(card) != -1 || sdMmcCardSerial(card) != -1 || sdMmcCardProductByte(card,0) != -1 || sdMmcCardManufacturingYear(card) != -1 || sdMmcCardManufacturingMonth(card) != -1)) return i32(3)
        status=status+1
    }
    card.storeU32(0,1)
    if (sdMmcCardSerial(card) != -1 || sdMmcCardSerial(nativeBufferAt(storage,79)) != -1 || sdMmcCardSerial(NativeBuffer(0)) != -1) return i32(4)
    card.storeU32(0,0x53444901)
    if (sdMmcCardProductByte(card,-1) != -1 || sdMmcCardProductByte(card,5) != -1 || writes != 0) return i32(5)
    return i32(0)
}
