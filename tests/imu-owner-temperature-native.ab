import "./imu-temperature-native.ab"
import "../src/m5stack/imu_owner_temperature.ab"
@export("abla_imu_owner_temperature_test")
trusted fun ownerTemperatureTest(): i32 {
    val memory=nativeStaticAllocate(48);val storage=nativeBufferAt(memory+4,36)
    val owner=m5ImuOwnerAt(storage);val scratch=nativeBufferAt(memory+40,2)
    if (!owner.initialize()) return i32(1)
    kind=1
    while (kind <= 5) {
        val primary=(1<<48)|(3<<42)|((if (kind == 5) 108 else 104)<<35)|(kind<<32)|7
        storage.storeU32(8,primary);storage.storeU32(12,primary>>>32)
        var state=0
        while (state <= 6) {
            storage.storeU32(4,state);calls=0;bad=false;fail=false;sample=0
            val value=owner.readTemperatureOwnedWithBuffer(scratch,true)
            if (state == 1) {
                if (!value.valid() || value.milliCelsius() != (if (kind == 4) 23000 else if (kind == 5) 21000 else 25000) || calls != 1 || bad) return i32(2)
            } else if (value.valid() || calls != 0) return i32(3)
            state=state+1
        }
        storage.storeU32(4,1)
        // All byte offsets intersecting the owner, including a straddling span.
        var offset=-1
        while (offset < 36) {
            calls=0
            if (owner.readTemperatureOwnedWithBuffer(nativeBufferAt(storage.addressValue()+offset,2),true).valid() || calls != 0 || storage.loadU32(4) != 1 || owner.primary() != M5ImuProbeResult(primary)) return i32(4)
            offset=offset+1
        }
        calls=0
        if (owner.readTemperatureOwnedWithBuffer(scratch,false).valid() || owner.readTemperatureOwnedWithBuffer(nativeBufferAt(memory+40,1),true).valid() || calls != 0) return i32(5)
        fail=true
        if (owner.readTemperatureOwnedWithBuffer(scratch,true).valid() || calls != 1) return i32(6)
        fail=false;sample=32768;calls=0
        val negative=owner.readTemperatureOwnedWithBuffer(scratch,true)
        if (negative.valid() != (kind != 4) || calls != 1 || bad) return i32(7)
        storage.storeU32(8,0);calls=0
        if (owner.readTemperatureOwnedWithBuffer(scratch,true).valid() || calls != 0) return i32(8)
        kind=kind+1
    }
    return i32(0)
}
