import "../src/esp32/startup_memory_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var memory=nativeBufferAt(0,0)
var core=0
var enabled=0
var sp=0x3FC94F00
var rtcBase=0x50000000
var reason=0
var resets=0
var writes=0
var bad=false
fun esp32S3StartupMemoryCore(): int = core
fun esp32S3StartupMemoryEnabled(): int = enabled
fun esp32S3StartupMemoryStackPointer(): int = sp
fun esp32S3StartupMemoryResetReason(): int { resets=resets+1; return reason }
trusted fun esp32S3StartupMemoryZero(address: int): void {
    val offset=if (address >= rtcBase && address < rtcBase+128) 256+address-rtcBase else address-0x3FC90000
    if (offset < 0 || offset >= 384 || (offset & 3) != 0) { bad=true; return }
    memory.storeU32(offset,0); writes=writes+1; return
}
@export("abla_startup_memory_test")
trusted fun startupMemoryTest(): i32 {
    memory=nativeBufferAt(nativeStaticAllocate(384),384)
    val stack=nativeBufferAt(0x3FC94000,4096)
    var p=0
    while (p < 512) {
        reason=p & 7; rtcBase=if ((p & 8) == 0) 0x50000000 else 0x600FE000
        val size=((p>>>4) & 31)*4
        val rtcSize=128-size
        var offset=0
        while (offset < 384) { memory.storeU32(offset,0xABC00000+offset); offset=offset+4 }
        writes=0; resets=0; bad=false
        if (!esp32S3StartupMemoryInitializeOwned(nativeBufferAt(0x3FC90000,size),nativeBufferAt(rtcBase,rtcSize),stack) ||
            writes != (size+(if (reason == 5) 0 else rtcSize))/4 || resets != 1 || bad) return i32(1)
        offset=0
        while (offset < 384) {
            val cleared=offset < size || (reason != 5 && offset >= 256 && offset < 256+rtcSize)
            if (memory.loadU32(offset) != (if (cleared) 0 else 0xABC00000+offset)) return i32(2)
            offset=offset+4
        }
        p=p+1
    }
    writes=0; resets=0
    val bss=nativeBufferAt(0x3FC90000,16)
    val rtc=nativeBufferAt(0x50000000,16)
    core=1
    if (esp32S3StartupMemoryInitializeOwned(bss,rtc,stack)) return i32(3)
    core=0; enabled=1
    if (esp32S3StartupMemoryInitializeOwned(bss,rtc,stack)) return i32(4)
    enabled=0; sp=0x3FC95000
    if (esp32S3StartupMemoryInitializeOwned(bss,rtc,stack)) return i32(5)
    sp=0x3FC94F00
    if (esp32S3StartupMemoryInitializeOwned(nativeBufferAt(0x3FC94000,16),rtc,stack) ||
        esp32S3StartupMemoryInitializeOwned(bss,nativeBufferAt(0x50001FFC,8),stack) ||
        esp32S3StartupMemoryInitializeOwned(nativeBufferAt(0x3FC90001,16),rtc,stack) ||
        esp32S3StartupMemoryInitializeOwned(bss,nativeBufferAt(0x600FE000,3),stack) || writes != 0 || resets != 0) return i32(6)
    if (!esp32S3StartupMemoryInitializeOwned(nativeBufferAt(0,0),nativeBufferAt(0,0),stack) || writes != 0) return i32(7)
    i32(0)
}
