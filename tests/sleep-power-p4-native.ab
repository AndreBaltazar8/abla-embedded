import "../src/esp32/power/sleep_power_p4_sequence.ab"
import "abla/unsafe/native"
var regs=NativeBuffer(0)
var writes=0
var fail=0
var bad=false
fun slot(offset: int): int = if (offset == 104) 0 else if (offset == 124) 4 else if (offset == 152) 8 else
    if (offset == 168) 12 else if (offset == 172) 16 else if (offset == 192) 20 else if (offset == 196) 24 else if (offset == 188) 28 else -1
fun maskFor(i: int,layout: int): u32 = if (i == 0) u32(0xc0e00000)|(if (layout == 3) u32(0x20000000) else u32(0)) else
    if (i == 1) u32(0x7fe00000) else if (i == 2 || i == 7) u32(0x80000000) else if (i == 3 || i == 5) u32(0xfc000000) else u32(0xf8000000)
trusted fun p4SleepPowerRead(offset: int): u32 {
    val i=slot(offset);if (i < 0) { bad=true;return u32(0) };return u32(regs.loadU32(i))
}
trusted fun p4SleepPowerWrite(offset: int,value: u32): void {
    val i=slot(offset);if (i < 0) { bad=true;return }
    writes=writes+1;if (writes != fail) regs.storeU32(i,int(value));return
}
trusted fun seed(r: NativeBuffer,c: NativeBuffer): void {
    var i=0
    while (i < 32) { regs.storeU32(i,0xffffffff);c.storeU32(i,0);i=i+4 }
    i=0
    while (i < 52) { r.storeU32(i,0);i=i+4 }
    r.storeU32(52,0x12345678);writes=0;fail=0;bad=false;return
}
@export("abla_sleep_power_p4_test")
trusted fun test(): i32 {
    regs=nativeBufferAt(nativeStaticAllocate(32),32)
    val c=nativeBufferAt(nativeStaticAllocate(32),32)
    val r=nativeBufferAt(nativeStaticAllocate(56),56)
    var layout=1
    while (layout <= 3) {
        var phase=0
        while (phase < 2) {
            var fault=0
            while (fault <= 8) {
                seed(r,c);if (phase == 0) fail=fault
                val opened=esp32p4SleepPowerOpenOwned(r,c,layout,true)
                if ((phase == 1 || fault == 0) && opened != 1) return i32(1)
                if (phase == 0 && fault != 0 && (opened != 3 || r.loadU32(8) != fault)) return i32(2)
                if (opened == 1) {
                    var i=0
                    while (i < 8) { if (u32(regs.loadU32(i*4)) != ~maskFor(i,layout)) return i32(3);i=i+1 }
                }
                val primary=r.loadU32(8);writes=0;fail=if (phase == 1) fault else 0
                val closed=esp32p4SleepPowerCloseOwned(r,true)
                if (phase == 1 && fault != 0 && (closed != 3 || r.loadU32(12) != 9-fault)) return i32(4)
                fail=0
                if (esp32p4SleepPowerCloseOwned(r,true) != 4 || r.loadU32(8) != primary || r.loadU32(52) != 0x12345678 || bad) return i32(5)
                var i=0
                while (i < 32) { if (regs.loadU32(i) != 0xffffffff) return i32(6);i=i+4 }
                fault=fault+1
            }
            phase=phase+1
        }
        var field=0
        while (field < 8) {
            var bit=0
            while (bit < 32) {
                seed(r,c);val value=u32(1)<<u32(bit);c.storeU32(field*4,int(value))
                val result=esp32p4SleepPowerOpenOwned(r,c,layout,true)
                if ((value&maskFor(field,layout)) == u32(0)) {
                    if (result != 2 || writes != 0) return i32(7)
                } else if (result != 1 || (u32(regs.loadU32(field*4))&maskFor(field,layout)) != value) return i32(8)
                bit=bit+1
            }
            field=field+1
        }
        layout=layout+2
    }
    seed(r,c)
    if (esp32p4SleepPowerOpenOwned(r,nativeBufferAt(r.addressValue()+4,32),3,true) != 2 || writes != 0) return i32(9)
    return i32(0)
}
