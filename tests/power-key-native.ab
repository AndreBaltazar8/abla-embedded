import "../src/power/key_event.ab"
import "../src/i2c/results.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice = int
var raw=0
var readOk=true
var writeOk=true
var writes=0
var written=0
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult =
    I2cByteResult(if (readOk) 256 | raw else 0)
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool {
    writes=writes+1; written=value; writeOk
}
@export("abla_power_key_test")
trusted fun keyTest(): i32 {
    var model=0
    while (model < 2) {
        val mask=if (model == 0) 3 else 12
        val shift=if (model == 0) 0 else 2
        raw=0
        while (raw < 256) {
            var failure=0
            while (failure < 3) {
                readOk=failure != 1; writeOk=failure != 2; writes=0; written=0
                val result=powerKeyReadAndClear(I2cDevice(1),if (model == 0) 70 else 73,mask,shift)
                val selected=raw & mask
                val expectedStatus=if (!readOk) 1 else if (selected != 0 && !writeOk) 2 else 3
                if (result.status() != expectedStatus || result.valid() != (expectedStatus == 3) ||
                    result.observed() != (if (readOk) selected >>> shift else 0) ||
                    writes != (if (readOk && selected != 0) 1 else 0) ||
                    (writes != 0 && written != selected)) return i32(1)
                failure=failure+1
            }
            raw=raw+1
        }
        model=model+1
    }
    i32(0)
}
