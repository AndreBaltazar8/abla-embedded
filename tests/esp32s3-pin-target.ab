import "../src/esp32/gpio_esp32s3.ab"
import "abla/runtime/scalar"

// Compile-only. Dynamic pin argument retains the complete GPIO path.
@export("abla_s3_pin_test")
trusted fun pinTargetTest(number: i32): bool {
    val p = pin(int(number))
    p.write(false)
    p.output()
    p.openDrainOutput()
    p.input()
    p.pullUp()
    p.pullDown()
    p.floating()
    p.setPull(true, true)
    p.setDriveStrength(1)
    p.routeOutputSignal(23, true)
    p.routeInputSignal(25, true)
    p.read()
}
