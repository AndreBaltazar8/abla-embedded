// Regression cases for the lower-single-block-functions pass: each expectation is what the original Python tool
// produced for the same fixture (see the commit message of the port).
import "abla/io"
import "abla/test"
import "abla/text"
import "../tools/lower-single-block-recovered-functions.ab"

val SRC_SINGLE = "trusted fun one(): u32 {\n    var programCounter = 0\n    while (true) {\n        when (programCounter) {\n            0 -> {\n            r10 = u32(1)\n            return r10\n        }\n            else -> ablaRuntimeTrap()\n        }\n    }\n}\ntrusted fun one(): u32 {\n    var programCounter = 0\n    while (true) {\n        when (programCounter) {\n            0 -> {\n            programCounter = 3\n            return\n        }\n            else -> ablaRuntimeTrap()\n        }\n    }\n}\ntrusted fun one(): u32 {\n    var programCounter = 0\n    while (true) {\n        when (programCounter) {\n            0 -> {\n            r10 = u32(1)\n        }\n            else -> ablaRuntimeTrap()\n        }\n    }\n}\ntrusted fun one(): u32 {\n    var programCounter = 0\n    while (true) {\n        when (programCounter) {\n            0 -> {\n            // c\n            ablaRuntimeTrap()\n            // end\n        }\n            else -> ablaRuntimeTrap()\n        }\n    }\n}\ntrusted fun one(): u32 {\n    var programCounter = 0\n    while (true) {\n        when (programCounter) {\n            0 -> {\n            return r10\n            5 -> {\n        }\n            else -> ablaRuntimeTrap()\n        }\n    }\n}\ntrusted fun one(): u32 {\n    var programCounter = 0\n    var loopCounter = u32(0)\n    var loopStart = 0\n    var loopEnd = 0\n    while (true) {\n        when (programCounter) {\n            0 -> {\n            return u32(3)\n        }\n            else -> ablaRuntimeTrap()\n        }\n    }\n}\n"

fun main: int {
    expectEqual(sbTransform(SRC_SINGLE).text, "trusted fun one(): u32 {\n    r10 = u32(1)\n    return r10\n}\ntrusted fun one(): u32 {\n    var programCounter = 0\n    while (true) {\n        when (programCounter) {\n            0 -> {\n            programCounter = 3\n            return\n        }\n            else -> ablaRuntimeTrap()\n        }\n    }\n}\ntrusted fun one(): u32 {\n    var programCounter = 0\n    while (true) {\n        when (programCounter) {\n            0 -> {\n            r10 = u32(1)\n        }\n            else -> ablaRuntimeTrap()\n        }\n    }\n}\ntrusted fun one(): u32 {\n    // c\n    ablaRuntimeTrap()\n    // end\n}\ntrusted fun one(): u32 {\n    var programCounter = 0\n    while (true) {\n        when (programCounter) {\n            0 -> {\n            return r10\n            5 -> {\n        }\n            else -> ablaRuntimeTrap()\n        }\n    }\n}\ntrusted fun one(): u32 {\n    return u32(3)\n}\n", "single block")
    expectEqual(sbTransform(SRC_SINGLE).count, 3, "single block count")
    if (testsPassed() != 0) return 1
    println("PASS: lower-single-block-functions matches the original Python tool on the fixtures")
    0
}
