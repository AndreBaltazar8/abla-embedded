import "../src/input/touch_gt911_sequence.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
type Gt911 = int
val trackerStorage=nativeStaticAllocate(184)
val snapshotStorage=nativeStaticAllocate(40)
val frameStorage=nativeStaticAllocate(40)
val savedStorage=nativeStaticAllocate(184)
var readResult=1
var contactId=0
var reads=0
fun Gt911.valid(): bool = this == 1
trusted fun Gt911.readFrame(snapshot: NativeBuffer): int {
    reads=reads+1
    if (readResult < 0 || readResult > 5) return readResult
    var index=0
    while (index < readResult) {
        val offset=index*8
        snapshot.store(offset,contactId)
        snapshot.store(offset+1,63)
        snapshot.store(offset+2,1)
        snapshot.store(offset+3,0)
        snapshot.store(offset+4,0)
        snapshot.store(offset+5,7)
        snapshot.store(offset+6,0)
        index=index+1
    }
    readResult
}
trusted fun saveState(): void {
    var index=0
    val source=nativeBufferAt(trackerStorage,184)
    val saved=nativeBufferAt(savedStorage,184)
    while (index < 184) { saved.store(index,source.load(index)); index=index+1 }
    return
}
trusted fun unchangedState(): bool {
    var index=0
    val source=nativeBufferAt(trackerStorage,184)
    val saved=nativeBufferAt(savedStorage,184)
    while (index < 184) {
        if (saved.load(index) != source.load(index)) return false
        index=index+1
    }
    true
}
@export("abla_touch_gt911_test")
trusted fun gtGestureTest(): i32 {
    val snapshot=nativeBufferAt(snapshotStorage,40)
    val frame=nativeBufferAt(frameStorage,40)
    val touch=Gt911(1)
    var rotation=0
    while (rotation < 8) {
        val tracker=touchTrackerAt(trackerStorage)
        if (tracker.updateGt911(touch,snapshot,frame,10,320,240,rotation) != 1 ||
            !tracker.detail(0).wasPressed()) return i32(1)
        val point=tracker.detail(0).point()
        val x=if (rotation == 0 || rotation == 4) 319 else if (rotation == 3 || rotation == 7) 239 else 0
        val y=if (rotation == 2 || rotation == 4) 239 else if (rotation == 3 || rotation == 5) 319 else 0
        if (point.x() != x || point.y() != y) return i32(2)
        val before=reads
        if (tracker.updateGt911(touch,snapshot,frame,12,320,240,rotation) != 1 || reads != before) return i32(3)
        saveState()
        readResult=-1
        if (tracker.updateGt911(touch,snapshot,frame,20,320,240,rotation) != -2 || !unchangedState()) return i32(4)
        readResult=-3
        if (tracker.updateGt911(touch,snapshot,frame,20,320,240,rotation) != -4 || !unchangedState()) return i32(5)
        readResult=2
        if (tracker.updateGt911(touch,snapshot,frame,20,320,240,rotation) != -4 || !unchangedState()) return i32(6)
        readResult=1; contactId=6
        if (tracker.updateGt911(touch,snapshot,frame,20,320,240,rotation) != -4 || !unchangedState()) return i32(7)
        contactId=0
        val nowReads=reads
        if (tracker.updateGt911(touch,nativeBufferAt(trackerStorage,40),frame,20,320,240,rotation) != -1 ||
            tracker.updateGt911(touch,snapshot,nativeBufferAt(snapshotStorage,40),20,320,240,rotation) != -1 ||
            tracker.updateGt911(touch,snapshot,frame,20,320,240,8) != -1 || reads != nowReads || !unchangedState()) return i32(8)
        readResult=-2
        if (tracker.updateGt911(touch,snapshot,frame,510,320,240,rotation) != 1 ||
            tracker.detail(0).wasHold() || tracker.detail(0).wasReleased() ||
            tracker.lastMilliseconds() != 10) return i32(10)
        if (tracker.updateGt911(touch,snapshot,frame,511,320,240,rotation) != 1 ||
            !tracker.detail(0).wasHold() || tracker.lastMilliseconds() != 10) return i32(11)
        if (tracker.updateGt911(touch,snapshot,frame,512,320,240,rotation) != 1 ||
            tracker.detail(0).wasHold() || tracker.detail(0).wasReleased()) return i32(12)
        readResult=0
        if (tracker.updateGt911(touch,snapshot,frame,520,320,240,rotation) != 1 || !tracker.detail(0).wasReleased()) return i32(9)
        readResult=1
        rotation=rotation+1
    }
    i32(0)
}
