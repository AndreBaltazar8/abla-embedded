import "../src/esp32/i2c/facade_buffer_s3_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_i2c_s3_facade_buffer_test")
fun bufferTest(): i32 {
    var begin=992
    while (begin < 1408) {
        var length=0
        while (length < 240) {
            // Independent byte-by-byte oracle, including containing spans.
            var safe=true
            var byte=begin
            while (byte < begin+length) {
                if ((byte >= 1024 && byte < 1060) || (byte >= 1088 && byte < 1124) ||
                    (byte >= 1152 && byte < 1352)) safe=false
                byte=byte+1
            }
            if (esp32S3I2cFacadeBufferSafe(nativeBufferAt(begin,length),length,1024,1088,1152) != safe) return i32(1)
            length=length+1
        }
        begin=begin+1
    }
    if (esp32S3I2cFacadeBufferSafe(nativeBufferAt(2000,4),5,1024,1088,1152) ||
        esp32S3I2cFacadeBufferSafe(nativeBufferAt(2000,4),-1,1024,1088,1152) ||
        esp32S3I2cFacadeBufferSafe(nativeBufferAt(4294967292,8),8,1024,1088,1152) ||
        esp32S3I2cFacadeBufferSafe(nativeBufferAt(2000,4),4,4294967290,1088,1152) ||
        !esp32S3I2cFacadeBufferSafe(nativeBufferAt(0,0),0,1024,1088,1152)) return i32(2)
    i32(0)
}
