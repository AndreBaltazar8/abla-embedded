import "../src/m5stack/tab5_microphone_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/hal/m5stack_3.ab"
import "../src/audio/es7210_type.ab"
import "../src/hal/es7210.ab"
@export("abla_es7210_valid")
fun es7210ValidHook(recv: int): bool = Es7210(recv) == 7
var calls=0
var enabled=false
var success=false
@export("abla_es7210_configureStereoMic12")
trusted fun es7210ConfigureStereoMic12Hook(recv: int): bool { calls=calls+1;enabled=true;return success }
@export("abla_es7210_reset")
trusted fun es7210ResetHook(recv: int): bool { calls=calls+1;enabled=false;return success }
@export("abla_tab5_microphone_test")
trusted fun test(): i32 {
    var profile=0
    while (profile < 4) {
        calls=0;success=(profile&1) != 0
        val on=(profile&2) != 0
        if (tab5MicrophoneOwned(Es7210(7),on,true) != (if (success) 1 else 3) || calls != 1 || enabled != on) return i32(1)
        profile=profile+1
    }
    calls=0
    if (tab5MicrophoneOwned(Es7210(0),true,true) != 2 || tab5MicrophoneOwned(Es7210(7),false,false) != 2 || calls != 0) return i32(2)
    return i32(0)
}
