import "../src/m5stack/tab5_microphone_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Es7210=int
fun Es7210.valid(): bool = this == 7
var calls=0
var enabled=false
var success=false
trusted fun Es7210.configureStereoMic12(): bool { calls=calls+1;enabled=true;return success }
trusted fun Es7210.reset(): bool { calls=calls+1;enabled=false;return success }
@export("abla_tab5_microphone_test")
trusted fun test(): i32 {
    var profile=0
    while (profile < 4) {
        calls=0;success=(profile&1) != 0
        val on=(profile&2) != 0
        if (tab5MicrophoneOwned(Es7210(7),on,true) != (if (success) 1 else 3) || calls != 1 || enabled != on) return i32(1)
        profile=profile+1
    }
    calls=0
    if (tab5MicrophoneOwned(Es7210(0),true,true) != 2 || tab5MicrophoneOwned(Es7210(7),false,false) != 2 || calls != 0) return i32(2)
    return i32(0)
}
