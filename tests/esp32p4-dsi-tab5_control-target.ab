import "../src/m5stack/tab5_control_bus_esp32p4.ab"
import "../src/m5stack/tab_power.ab"
import "../src/m5stack/tab5_reset_provider_esp32p4.ab"
import "../src/m5stack/tab5_board_prepare_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_tab5_control_target")
trusted fun target(owner: Tab5ControlBus,expanders: M5Expanders,operation: int): int {
    if (operation == 0) return tab5ControlBusOpenOwned(3)|0
    if (operation == 1) return expanders.open(owner.bus(),m5BoardTab5)
    if (operation == 2) return expanders.configureTabPower()|0
    if (operation == 3) return if (expanders.close()) 1 else 0
    if (operation == 4) return owner.bus().resetTab5DisplayTouchOwned(nativeBufferAt(nativeStackAllocate(1),1))
    if (operation == 5) return owner.prepareBoardOwned(m5BoardTab5,expanders,nativeBufferAt(nativeStackAllocate(1),1))|0
    return owner.closeOwned()|0
}
