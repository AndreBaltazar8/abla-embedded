import "../src/display/dsi_service_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_service_target")
trusted fun target(gate: ServiceGate,token: u32,channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int,close: bool): int =
    if (close) esp32P4DsiServiceShutdown(gate,channel,polls) else esp32P4DsiServiceRefresh(gate,token,channel,descriptor,frame,bytes,line,polls)
