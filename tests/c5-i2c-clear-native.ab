import "../src/esp32/i2c/clear_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var required=0
var stuck=false
var now=0
var rises=0
var clockHigh=true
var dataHigh=true
var captures=0
var prepares=0
var restores=0
var releasedChecks=0
var bad=false
fun c5I2cClearPinsMatch(port: int,sda: int,scl: int): bool = port == 0 && sda == 2 && scl == 3
fun c5I2cClearReleased(port: int,sda: int,scl: int): bool {
    releasedChecks=releasedChecks+1
    if (releasedChecks > 1 && restores != 2) bad=true
    !stuck && (required == 0 || rises >= required)
}
fun c5I2cClearCapture(pin: int): int {
    if (pin != 2+captures || prepares != 0) bad=true
    captures=captures+1
    123+pin
}
fun c5I2cClearCounter(): u32 { now=now+1; return u32(now) }
fun c5I2cClearPrepare(pin: int): void {
    if (captures != 2 || pin != 2+prepares) bad=true
    prepares=prepares+1
    return
}
fun c5I2cClearWrite(pin: int,high: bool): void {
    if (prepares != 2 || restores != 0) bad=true
    if (pin == 3) {
        if (high && !clockHigh) rises=rises+1
        clockHigh=high
    } else if (pin == 2) {
        if (!high && clockHigh) bad=true
        dataHigh=high
    } else bad=true
    return
}
fun c5I2cClearDelay(us: int): void {
    if (us != 1 && us != 5) bad=true
    now=now+us
    return
}
fun c5I2cClearRead(pin: int): bool {
    if (pin == 3) return clockHigh && !stuck
    if (pin != 2) bad=true
    dataHigh && rises >= required
}
fun c5I2cClearRestore(pin: int,saved: int): void {
    if (captures != 2 || prepares != 2 || pin != 3-restores || saved != pin+123) bad=true
    restores=restores+1
    return
}
@export("abla_c5_i2c_clear_test")
trusted fun clearTest(): i32 {
    var profile=0
    while (profile < 48) {
        required=profile%12; stuck=((profile/12)&1) != 0
        val budget=if (profile < 24) 1 else 1000
        now=0xFFFFFFFC; rises=0; clockHigh=true; dataHigh=true
        captures=0; prepares=0; restores=0; releasedChecks=0; bad=false
        val result=esp32C5I2cClearStuckBusOwned(0,2,3,u32(budget))
        val already=required == 0 && !stuck
        // Ninth recovery clock is followed by STOP's clock rise. A slave
        // modeled as releasing on that last rise is also legitimately free.
        val expected=already || budget == 1000 && !stuck && required <= 10
        if (result != expected || bad || rises > 10 ||
            captures != (if (already) 0 else 2) || prepares != captures || restores != captures ||
            now-0xFFFFFFFC > budget+32) return i32(1)
        profile=profile+1
    }
    captures=0; releasedChecks=0
    if (esp32C5I2cClearStuckBusOwned(1,2,3,u32(1000)) ||
        esp32C5I2cClearStuckBusOwned(0,2,3,u32(0)) || captures != 0 || releasedChecks != 0) return i32(2)
    i32(0)
}
