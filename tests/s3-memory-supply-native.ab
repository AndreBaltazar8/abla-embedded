import "../src/esp32/power/memory_supply_s3.ab"
import "abla/build"
var msSdio=0
var msStrap=0
var msReads=0
var msBad=false
fun esp32S3MemorySupplyRead(address: int): int {
    if (address != (if (msReads == 0) 0x6000807c else 0x60004038) || msReads > 1) msBad=true
    msReads=msReads+1;return if (msReads == 1) msSdio else msStrap
}
@export("abla_s3_memory_supply_test")
fun testMemorySupply(): int {
    var profile=0
    while (profile < 1024) {
        val forced=(profile&1) != 0;val enabled=(profile&2) != 0;val tieh=(profile&4) != 0
        val strap=(profile&8) != 0;val trims=profile>>>4
        msSdio=0x013fffff|((trims&3)<<29)|(((trims>>>2)&3)<<27)|(((trims>>>4)&3)<<25)|
            (if (forced) 1<<22 else 0)|(if (enabled) 1<<31 else 0)|(if (tieh) 1<<23 else 0)
        msStrap=0xffffffdf|(if (strap) 32 else 0);msReads=0;msBad=false
        val supply=esp32S3MemorySupplyReadOwned()
        val expected=if (forced && !enabled) -1 else if (if (forced) tieh else !strap) 3300 else 1800
        if (msBad || msReads != (if (forced) 1 else 2) || !supply.valid() || supply.forced() != forced ||
            supply.configuredEnabled() != (!forced || enabled) || supply.configuredMillivolts() != expected ||
            supply.highTrim() != (trims&3) || supply.middleTrim() != ((trims>>>2)&3) || supply.lowTrim() != ((trims>>>4)&3)) return 1
        if (supply.matchesConfiguredMillivolts(1800) != (expected == 1800) || supply.matchesConfiguredMillivolts(3300) != (expected == 3300) ||
            supply.matchesConfiguredMillivolts(-1) || supply.matchesConfiguredMillivolts(0)) return 2
        if (Esp32S3MemorySupply((supply|0)|1024).valid() || Esp32S3MemorySupply((supply|0)&511).valid()) return 3
        profile=profile+1
    }
    if (Esp32S3MemorySupply(-1).valid() || Esp32S3MemorySupply(0).configuredMillivolts() != -1) return 4
    return 0
}
