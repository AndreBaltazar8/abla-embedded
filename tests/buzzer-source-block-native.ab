import "../src/audio/buzzer_source_block.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun newBank(address: int): PcmSourceQueues {
    val bank=pcmSourceQueuesAt(nativeBufferAt(address,64),2,8000)
    val data=nativeBufferAt(address+180,8)
    data.storeU16(0,30000);data.storeU16(2,-20000);data.storeU16(4,10000);data.storeU16(6,-5000)
    val wav=pcmRaw(data,nativeBufferAt(address+160,20),8000,1,16)
    val channel=pcmChannelAt(nativeBufferAt(address+64,32),8000)
    val tone=pcmToneAt(nativeBufferAt(address+96,32),8000,500000,3)
    val other=pcmToneAt(nativeBufferAt(address+128,32),8000,731000,4294967295,12000)
    channel.enqueue(wav,2)
    bank.enqueue(pcmPlaybackChannel(channel),0)
    bank.enqueue(pcmPlaybackTone(tone),0)
    bank.enqueue(pcmPlaybackTone(other),1)
    return bank
}
@export("abla_buzzer_source_block_test")
trusted fun test(): i32 {
    val memory=nativeStaticAllocate(4096)
    val reference=newBank(memory)
    val r=nativeBufferAt(memory+512,24)
    val acc=nativeBufferAt(memory+1024,512);val scratch=nativeBufferAt(memory+1536,256)
    val mono=nativeBufferAt(memory+1792,128);val output=nativeBufferAt(memory+2048,256)
    val expected=nativeBufferAt(memory+2304,256);val referenceMono=nativeBufferAt(memory+2560,128)
    val volume=PcmVolume(177)
    if (!reference.renderOutput(64,acc,scratch,referenceMono,false,volume.gainQ15())) return i32(1)
    val finalState=BuzzerDeltaSigma(0).encodePcm16Stereo16(referenceMono,expected,64)
    var chunk=1
    while (chunk <= 64) {
        val bank=newBank(memory+256)
        var at=0
        while (at < 24) { r.storeU32(at,0);at=at+4 }
        if (!buzzerSourceBlockInitOwned(r,0,true)) return i32(2)
        val sentinel=output.loadU32(0)
        if (buzzerSourceBlockPrepareOwned(r,bank,1,acc,scratch,mono,r,volume,true) != 2 || buzzerSourceBlockPrepareOwned(r,bank,1,acc,scratch,scratch,output,volume,true) != 2 ||
            buzzerSourceBlockPrepareOwned(r,bank,1,acc,scratch,mono,bank.storage(),volume,true) != 2 || r.loadU32(4) != 1 || output.loadU32(0) != sentinel || nativeBufferAt(memory+320,32).loadU32(16) != 0) return i32(3)
        var position=0
        while (position < 64) {
            val frames=if (64-position < chunk) 64-position else chunk
            val destination=nativeBufferAt(output.addressValue()+position*4,(64-position)*4)
            if (buzzerSourceBlockPrepareOwned(r,bank,frames,acc,scratch,mono,destination,volume,true) != 1) return i32(4)
            val view=buzzerSourceBlockOutput(r)
            if (view.addressValue() != destination.addressValue() || view.capacity() != frames*4) return i32(5)
            val phase=nativeBufferAt(memory+384,32).loadU32(12);val remainder=r.loadU32(8);val first=view.loadU32(0)
            if (buzzerSourceBlockPrepareOwned(r,bank,frames,acc,scratch,mono,destination,PcmVolume(0),true) != 4 || buzzerSourceBlockReleaseOwned(r,false,true) ||
                r.loadU32(8) != remainder || view.loadU32(0) != first || nativeBufferAt(memory+384,32).loadU32(12) != phase) return i32(6)
            if (!buzzerSourceBlockReleaseOwned(r,true,true) || buzzerSourceBlockOutput(r) != NativeBuffer(0)) return i32(7)
            position=position+frames
        }
        if (r.loadU32(8) != (finalState|0)) return i32(8)
        at=0
        while (at < 256) { if (output.loadU32(at) != expected.loadU32(at)) return i32(9);at=at+4 }
        chunk=chunk+1
    }
    // A malformed late source must not advance the earlier lane or touch buffers.
    val bank=newBank(memory+256)
    r.storeU32(0,0)
    if (!buzzerSourceBlockInitOwned(r,123,true)) return i32(10)
    val other=nativeBufferAt(memory+384,32);other.storeU32(0,0)
    val first=output.loadU32(0)
    if (buzzerSourceBlockPrepareOwned(r,bank,16,acc,scratch,mono,output,volume,true) != 2 || r.loadU32(8) != 123 || r.loadU32(4) != 1 || output.loadU32(0) != first || nativeBufferAt(memory+320,32).loadU32(16) != 0) return i32(11)
    return i32(0)
}
