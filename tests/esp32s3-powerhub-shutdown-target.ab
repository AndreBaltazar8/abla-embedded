import "../src/esp32/i2c_esp32s3.ab"
import "../src/power/powerhub_shutdown.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_powerhub_shutdown_target")
trusted fun shutdownTarget(power: PowerHubPower,bytes: NativeBuffer,buffered: bool): int =
    (if (buffered) power.requestPowerOffWithBuffer(bytes) else power.requestPowerOff()) | 0
