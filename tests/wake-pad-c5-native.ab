import "../src/esp32/gpio/lp_wake_pad_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var pin=0
var mux=0
var hp=0
var lp=0
var route=0
var hold=0
var writes=0
var failAt=0
var bad=false
fun c5WakeLoad(address: int): int {
    if (address == 0x600b102c) return hold
    if (address == 0x600b4000+pin*4) return mux
    if (address == 0x60091034) return hp
    if (address == 0x600b4410) return lp
    if (address == 0x600b1028) return route
    if (address == 0x600b441c) return 1<<pin
    bad=true;return 0
}
fun c5WakeStore(address: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (address == 0x6009103c) hp=hp&~value
    else if (address == 0x600b4418) lp=lp&~value
    else if (address == 0x60091038) hp=hp|value
    else if (address == 0x600b4414) lp=lp|value
    else if (address == 0x600b4000+pin*4) mux=value
    else if (address == 0x600b1028) route=value
    else bad=true
    return
}
@export("abla_wake_pad_c5_test")
trusted fun test(): i32 {
    while (pin < 8) {
        var failed=0
        while (failed < 5) {
            mux=0xdeadbeef;hp=255;lp=255;route=0;hold=0;writes=0;failAt=failed
            var lease=esp32C5WakePadOpenOwned(pin,true)
            if (!lease.hasSnapshot() || lease.status() != (if (failed == 0) 1 else 4)) return i32(1)
            if (failed == 0 && (lease.levelOwned() != 1 || hp != (255^(1<<pin)) || lp != hp || route != (1<<pin))) return i32(2)
            failAt=0
            lease=lease.closeOwned(true)
            if (lease.status() != 5 || mux != 0xdeadbeef || hp != 255 || lp != 255 || route != 0 || bad) return i32(3)
            val before=writes;lease=lease.closeOwned(true)
            if (writes != before) return i32(4)
            failed=failed+1
        }
        hold=1<<pin;writes=0
        if (esp32C5WakePadOpenOwned(pin,true).status() != 3 || writes != 0) return i32(5)
        pin=pin+1
    }
    if (esp32C5WakePadOpenOwned(8,true).status() != 2 || esp32C5WakePadOpenOwned(4,false).status() != 2) return i32(6)
    return i32(0)
}
