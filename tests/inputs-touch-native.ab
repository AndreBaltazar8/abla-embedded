import "../src/m5stack/inputs_touch_sequence.ab"
import "../src/m5stack/button_touch_frame.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
val storage=nativeStaticAllocate(512)
var reads=0
var polls=0
var report=0
var accepted=M5TouchButtons(0)
fun m5PmicKeyAxp(handle: int,kind: int): int = 0
fun m5PmicKeyPm1(handle: int): int = 0
fun m5PowerButtonRead(pmic: M5PmicOpen): M5PowerKeyRead = M5PowerKeyRead(0)
trusted fun m5TouchPollRead(kind: int,handle: int,snapshot: NativeBuffer,board: M5BoardId): int {
    reads=reads+1
    if (report == 1) {
        var byte=0
        while (byte < 8) { snapshot.store(byte,0); byte=byte+1 }
        snapshot.store(3,240)
    }
    report
}
trusted fun m5InputsPollAccepted(owner: M5Inputs,board: M5BoardId,pi4: int,pmic: M5PmicOpen,
    powerHub: int,touch: M5TouchButtons,now: int): bool {
    polls=polls+1
    accepted=touch
    owner.updateOwned(m5ButtonFrame().withTouch(touch),pmic,false,now)
}
@export("abla_inputs_touch_test")
trusted fun testInputsTouch(): i32 {
    val owner=m5InputsAt(nativeBufferAt(storage+200,64))
    val tracker=touchTrackerAt(storage)
    val snapshot=nativeBufferAt(storage+300,40)
    val raw=nativeBufferAt(storage+340,40)
    owner.initialize()
    val board=m5BoardToughC5
    val pmic=M5PmicOpen(0)
    if (!owner.pollWithTouchOwned(board,2,1,tracker,snapshot,raw,0,0,pmic,0,10) ||
        reads != 1 || polls != 1 || !accepted.valid() || accepted.pressed() != 0) return i32(1)
    report=-1
    if (!owner.pollWithTouchOwned(board,2,1,tracker,snapshot,raw,0,0,pmic,0,20) ||
        reads != 2 || polls != 2 || accepted.valid()) return i32(2)
    // Every byte overlap with owner must fail before either hook runs.
    var offset=161
    while (offset < 264) {
        val alias=nativeBufferAt(storage+offset,40)
        if (owner.pollWithTouchOwned(board,2,1,tracker,alias,raw,0,0,pmic,0,30) ||
            owner.pollWithTouchOwned(board,2,1,tracker,snapshot,alias,0,0,pmic,0,30)) return i32(3)
        offset=offset+1
    }
    offset=17
    while (offset < 264) {
        if (owner.pollWithTouchOwned(board,2,1,TouchTracker(storage+offset),snapshot,raw,0,0,pmic,0,30)) return i32(4)
        offset=offset+1
    }
    if (reads != 2 || polls != 2 || !owner.valid()) return i32(5)
    if (owner.pollWithTouchOwned(board,0,1,tracker,snapshot,raw,0,0,pmic,0,30) ||
        owner.pollWithTouchOwned(board,2,0,tracker,snapshot,raw,0,0,pmic,0,30) ||
        owner.pollWithTouchOwned(board,2,1,tracker,snapshot,raw,256,0,pmic,0,30) ||
        reads != 2 || polls != 2) return i32(6)
    owner.initialize()
    touchTrackerAt(storage)
    report=1
    if (!owner.pollWithTouchOwned(board,2,1,tracker,snapshot,raw,0,0,pmic,0,10)) return i32(7)
    report=-2
    var now=11
    while (now <= 600) {
        if (!owner.pollWithTouchOwned(board,2,1,tracker,snapshot,raw,0,0,pmic,0,now) ||
            !owner.button(0).sampleValid()) return i32(8)
        if (now >= 21 && !owner.button(0).state().isPressed()) return i32(9)
        now=now+1
    }
    if (!owner.button(0).state().isHolding()) return i32(10)
    report=-1
    owner.pollWithTouchOwned(board,2,1,tracker,snapshot,raw,0,0,pmic,0,601)
    report=-2
    owner.pollWithTouchOwned(board,2,1,tracker,snapshot,raw,0,0,pmic,0,602)
    if (owner.button(0).sampleValid() || !owner.button(0).state().isPressed()) return i32(11)
    report=0
    owner.pollWithTouchOwned(board,2,1,tracker,snapshot,raw,0,0,pmic,0,610)
    report=-2
    now=611
    while (now <= 630) {
        owner.pollWithTouchOwned(board,2,1,tracker,snapshot,raw,0,0,pmic,0,now)
        now=now+1
    }
    if (!owner.button(0).sampleValid() || owner.button(0).state().isPressed()) return i32(12)
    i32(0)
}
