import "../src/esp32/adc_analog_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var unit=1
var reference=0
var high=0
var low=0
var ground=0
var writes=0
var reads=0
var drop=0
var disturb=false
var bad=false
fun esp32S3AdcFuseRead(offset: int): int { bad=true; return 0 }
fun esp32S3SarAnalogRead(register: int): int {
    reads=reads+1
    val refRegister=if (unit == 1) 2 else 5
    if (register == refRegister) return if (disturb && writes == 4) reference^16 else reference
    if (register == refRegister-1) return high
    if (register == refRegister-2) return low
    if (register == 7) return ground
    bad=true; return 0
}
fun esp32S3SarAnalogWrite(register: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    val refRegister=if (unit == 1) 2 else 5
    if (register == refRegister) reference=value
    else if (register == refRegister-1) high=value
    else if (register == refRegister-2) low=value
    else if (register == 7) ground=value
    else bad=true
    return
}
fun reset(value: int): void {
    reference=value; high=value&240; low=0; ground=value; writes=0; reads=0; drop=0; disturb=false; return
}
@export("abla_adc_analog_s3_test")
fun test(): i32 {
    while (unit <= 2) {
        val calibration=Esp32S3AdcCalibration(268435456|((unit-1)<<25)|(1000<<12)|0xabc)
        var neighbors=0
        while (neighbors < 256) {
            reset(neighbors)
            if (esp32S3AdcAnalogConfigureOwned(calibration) != 1 || writes != 4 || bad) return i32(1)
            if (reference != ((neighbors&143)|64) || high != ((neighbors&240)|10) || low != 188 || ground != (neighbors&(if (unit == 1) 223 else 127))) return i32(2)
            neighbors=neighbors+1
        }
        var stage=1
        while (stage <= 4) {
            reset(255); drop=stage
            val expected=if (stage == 1) 3 else if (stage == 2) 772 else if (stage == 3) 1028 else 5
            if (esp32S3AdcAnalogConfigureOwned(calibration) != expected || writes != stage) return i32(3)
            drop=0
            if (esp32S3AdcAnalogConfigureOwned(calibration) != 1 || bad) return i32(4)
            stage=stage+1
        }
        reset(255); disturb=true
        if (esp32S3AdcAnalogConfigureOwned(calibration) != 6) return i32(5)
        unit=unit+1
    }
    reset(255)
    if (esp32S3AdcAnalogConfigureOwned(Esp32S3AdcCalibration(3)) != 2 || reads != 0 || writes != 0 || bad) return i32(6)
    return i32(0)
}
