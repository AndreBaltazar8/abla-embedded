// Keep interrupt-stack-root dispatch calls on Xtensa's CALL4 ABI.
//
//     tools/abla-tool tests/xtensa-freertos-exception-abi.ab [SOURCE.ab]
//
// SOURCE defaults to src/xtensa/freertos_exceptions_esp32.ab (relative to the working directory).

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/arguments"

// The assembly string of the `if (mode == "MODE") assembly = "..."` line, with \n and \t
// unescaped; null when the source has no such line.
fun modeAssembly(source: string, mode: string): string? {
    val prefix = "if (mode == \"$mode\") assembly = \""
    val start = source.indexOf(prefix)
    if (start < 0) return null
    var i = start + prefix.size
    val body = i
    while (i < source.size && source[i] != 34) {
        if (source[i] == 92) {
            if (i + 1 >= source.size) return null
            i = i + 2
        } else {
            i = i + 1
        }
    }
    if (i >= source.size) return null
    source.slice(body, i).replace("\\n", "\n").replace("\\t", "\t")
}

fun main: int {
    val path = if (processArgumentCount() >= 1) processArgument(0) else "src/xtensa/freertos_exceptions_esp32.ab"
    val read = Path(path).readTextResult()
    if (!read.succeeded) {
        eprintln("cannot read $path")
        return 1
    }
    val modes = ["low1", "medium2", "medium3"]
    val masks = ["407551", "3670016", "683706368"]
    val timers = ["1", "0", "0"]
    var index = 0
    while (index < modes.size) {
        val assembly = modeAssembly(read.text, modes[index])
        if (assembly == null) {
            println("FAIL ${modes[index]}: no assembly string")
            return 1
        }
        val sequence = "movi a6, ${masks[index]}\nmovi.n a7, ${timers[index]}\n" +
            "movi a4, abla_esp32_frxt_dispatch_interrupts\ncallx4 a4"
        if (!assembly.contains(sequence)) {
            println("FAIL ${modes[index]}: dispatch call is not the CALL4 sequence")
            return 1
        }
        if (assembly.contains("callx8")) {
            println("FAIL ${modes[index]}: CALLX8 in an interrupt-stack-root dispatch")
            return 1
        }
        index = index + 1
    }
    println("Xtensa ISR roots: low1/medium2/medium3 use CALL4 dispatcher ABI")
    0
}
