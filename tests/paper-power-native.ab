import "../src/m5stack/gpio_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
var trace=0
var level=false
var input=false
var output=false
var bad=false
fun Pin.write(enabled: bool): void {
    if (this != 5) bad=true
    trace=trace*10+1; level=enabled
    return
}
fun Pin.output(): void {
    if (this != 5 || trace != 1) bad=true
    trace=trace*10+2; output=true; input=false
    return
}
fun Pin.selectGpioFunction(enabled: bool): void {
    if (this != 5 || trace != 12 || !enabled || !output) bad=true
    trace=trace*10+3; input=enabled
    return
}
fun Pin.read(): bool {
    if (this != 5 || !input) bad=true
    trace=trace*10+4; level
}
@export("abla_paper_power_test")
fun paperTest(): i32 {
    var board=0
    while (board <= 512) {
        val id=M5BoardId(board)
        if ((id.externalPowerEnablePin() | 0) != (if (id == m5BoardPaper) 5 else -1) ||
            (id.usbPowerEnablePin() | 0) != (if (id == m5BoardStation) 12 else -1)) return i32(1)
        if (id != m5BoardPaper) {
            trace=0
            if (id.preparePaperExternalOutput(true) || id.setPaperExternalOutput(true) || id.paperExternalOutputChecked().valid() || trace != 0) return i32(2)
        }
        board=board+1
    }
    var scenario=0
    while (scenario < 4) {
        val initial=(scenario & 1) != 0
        trace=0; output=false; input=false; bad=false
        if (!m5BoardPaper.preparePaperExternalOutput(initial) || trace != 123 || bad || level != initial) return i32(3)
        trace=0
        if (m5BoardPaper.paperExternalOutputChecked() != I2cByteResult(256|(if (initial) 1 else 0)) || trace != 4 || bad) return i32(4)
        val next=(scenario & 2) != 0
        trace=0
        if (!m5BoardPaper.setPaperExternalOutput(next) || trace != 1 || level != next || bad) return i32(5)
        trace=0
        if (m5BoardPaper.paperExternalOutputChecked() != I2cByteResult(256|(if (next) 1 else 0)) || trace != 4 || bad) return i32(6)
        scenario=scenario+1
    }
    i32(0)
}
