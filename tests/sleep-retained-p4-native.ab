import "./p4-analog-register-native.ab"
import "./retention-links-p4-native.ab"
import "../src/esp32/power/sleep_retained_p4_sequence.ab"
import "./p4-sleep-cached-checks.ab"
import "./p4-retention-published-checks.ab"
import "./p4-sleep-session-checks.ab"
val retainedCycleMemory=nativeStaticAllocate(228)
fun seedRetainedCycle(encrypted: bool): NativeBuffer {
    resetSleepLight();seedExtra();seedFlashRev(encrypted)
    lightRetainedCycle=true;flashRestoreGuard=false
    p4HoldModelShared=true;p4HoldModelValue=0xa4000000;p4HoldModelOriginal=0xa4000000
    flashHolds=0xa4000000;flashHoldWrites=0;flashHoldDrop=0;flashHoldBad=false
    val r=nativeBufferAt(retainedCycleMemory,228)
    var i=0
    while (i < 224) { r.storeU32(i,0);i=i+4 }
    r.storeU32(224,0x1234abcd);return r
}
@export("abla_sleep_retained_p4_test")
trusted fun retainedCycleTest(): i32 {
    var encrypted=0
    while (encrypted < 4) {
        var event=1
        while (event <= 3) {
            val r=seedRetainedCycle((encrypted&1) != 0);lightEvent=u32(0);lightRegdmaInTest=(encrypted&2) != 0
            if (esp32p4SleepRetainedBeginOwned(r,300,400,lightRegdmaInTest,2,2,true) != 7 || extraStarts != 1 || lightRequests != 0 ||
                flashReads != 0 || p4SleepFlashHoldRead() != 0xa400003f || lightCommands != 2 || (extraControl&u32(16)) == u32(0)) return i32(1)
            val before=retentionWrites
            if (esp32p4SleepRetainedContinueOwned(r,2,2,true) != 7 || retentionWrites != before || lightRequests != 0) return i32(2)
            extraRaw=u32(1)
            if (esp32p4SleepRetainedContinueOwned(r,2,2,true) != 7 || extraStarts != 1 || lightRequests != 1 || flashReads != 0 ||
                p4SleepPsramHoldRead() != 0xa7ffffff || p4SleepFlashHoldRead() != 0xa7ffffff || lightCommands != 6) return i32(3)
            flashRestoreGuard=true;lightEvent=u32(event)<<u32(30)
            if (esp32p4SleepRetainedContinueOwned(r,2,2,true) != 7 || extraStarts != 2 || flashReads != 2 ||
                p4SleepPsramHoldRead() != 0xa7ffffff || p4SleepFlashHoldRead() != 0xa7ffffff || lightMarker != u32(0xaabbccdc)) return i32(4)
            extraRaw=u32(1)
            val expected=if (event == 1) 2 else if (event == 2) 1 else 3
            if (esp32p4SleepRetainedContinueOwned(r,2,2,true) != expected || extraStarts != 2 || lightRequests != 1 ||
                p4SleepFlashHoldRead() != 0xa4000000 || !sleepMemoryOriginal() || lightMarker != u32(0xaabbccdd) ||
                flashBad || retentionBad || lightBad || sleepMemoryBad || flashHoldBad || r.loadU32(224) != 0x1234abcd) return i32(5)
            val finalWrites=retentionWrites;val finalFlashWrites=flashWrites;val finalMemoryWrites=mpllWrites
            if (esp32p4SleepRetainedContinueOwned(r,2,2,true) != expected || retentionWrites != finalWrites || flashWrites != finalFlashWrites || mpllWrites != finalMemoryWrites) return i32(6)
            event=event+1
        }
        encrypted=encrypted+1
    }
    val failed=seedRetainedCycle(false);retentionDrop=1
    if (esp32p4SleepRetainedBeginOwned(failed,300,400,false,2,2,true) != 9 || lightRequests != 0 || extraStarts != 0) return i32(7)
    retentionDrop=0
    if (esp32p4SleepRetainedContinueOwned(failed,2,2,true) != 10 || p4SleepFlashHoldRead() != 0xa4000000 || lightRequests != 0 || retentionBad) return i32(8)
    val cache=seedRetainedCycle(false);lightStuckPass=1
    if (esp32p4SleepRetainedBeginOwned(cache,300,400,false,2,2,true) != 9 || esp32p4SleepRetainedContinueOwned(cache,2,2,true) != 7 || extraStarts != 0 || flashHoldWrites != 0) return i32(9)
    lightCache=u32(16)
    if (esp32p4SleepRetainedContinueOwned(cache,2,2,true) != 10 || lightRequests != 0 || extraStarts != 0) return i32(10)
    val engine=seedRetainedCycle(false)
    if (esp32p4SleepRetainedBeginOwned(engine,300,400,false,2,2,true) != 7) return i32(11)
    extraRaw=u32(3)
    if (esp32p4SleepRetainedContinueOwned(engine,2,2,true) != 11 || lightRequests != 0 || p4SleepFlashHoldRead() != 0xa400003f) return i32(12)
    extraRaw=u32(1);val errorWrites=retentionWrites
    if (esp32p4SleepRetainedContinueOwned(engine,2,2,true) != 11 || retentionWrites != errorWrites || lightRequests != 0) return i32(13)
    // Coupled cleanup: flash close failure must retain BOTH hold fields;
    // after it succeeds a PLL failure may release flash but not PSRAM.
    val cleanup=seedRetainedCycle(false)
    if (esp32p4SleepRetainedBeginOwned(cleanup,300,400,false,2,2,true) != 7) return i32(14)
    extraRaw=u32(1)
    if (esp32p4SleepRetainedContinueOwned(cleanup,2,2,true) != 7 || extraStarts != 2) return i32(15)
    val parkedWrites=mpllWrites
    extraRaw=u32(1);flashHoldDrop=flashHoldWrites+1
    if (esp32p4SleepRetainedContinueOwned(cleanup,2,2,true) != 9 || cleanup.loadU32(4) != 9 ||
        p4SleepFlashHoldRead() != 0xa7ffffff || p4SleepPsramHoldRead() != 0xa7ffffff || mpllWrites != parkedWrites) return i32(16)
    flashHoldDrop=0;mpllDone=false
    if (esp32p4SleepRetainedContinueOwned(cleanup,2,2,true) != 9 || cleanup.loadU32(4) != 10 ||
        p4SleepFlashHoldRead() != 0xa7ffffc0 || p4SleepPsramHoldRead() != 0xa7ffffc0 || extraStarts != 2) return i32(17)
    mpllDone=true
    if (esp32p4SleepRetainedContinueOwned(cleanup,2,2,true) != 1 || !sleepMemoryOriginal() ||
        p4SleepFlashHoldRead() != 0xa4000000 || extraStarts != 2 || lightRequests != 1 || sleepMemoryBad || flashHoldBad || lightBad) return i32(18)
    p4HoldModelShared=false;lightRetainedCycle=false;lightRegdmaInTest=false
    val cached=sleepCachedChecks()
    if (cached != 0) return i32(cached)
    val published=retentionPublishedChecks()
    if (published != 0) return i32(published)
    return i32(sleepSessionChecks())
}
