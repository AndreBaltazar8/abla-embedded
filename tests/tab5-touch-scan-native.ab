import "../src/m5stack/tab5_touch_scan_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var current=true
var handle=4294967294
var probe=257
var closeOk=true
var opens=0
var closes=0
var waits=0
var bad=false
fun tab5TouchScanBusCurrent(bus: int): bool = current
fun tab5TouchScanOpen(bus: int): int { opens=opens+1; return handle }
fun tab5TouchScanClose(device: int): bool { closes=closes+1; if (device != handle) bad=true; return closeOk }
fun tab5TouchScanWait(board: M5BoardId,bus: int,device: int,attempts: int): M5Tab5TouchProbe {
    waits=waits+1
    if (attempts != 60 || device != handle) bad=true
    return M5Tab5TouchProbe(probe)
}
fun tab5TouchPrepare(bus: int): int { bad=true; return 0 }
fun tab5TouchFirmware(handle: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun tab5TouchGtAck(bus: int): bool { bad=true; return false }
@export("abla_tab5_touch_scan_test")
fun testScan(): i32 {
    val prepared=Tab5BoardPrepare(1)
    var state=1
    while (state <= 6) {
        probe=(173<<8)|state
        closeOk=false; closes=0
        val pending=prepared.scanTouchOwned(m5BoardTab5,1,60)
        if (pending.status() != 4 || pending.handle() != handle || pending.probe() != probe || pending.ready() || closes != 1) return i32(1)
        closeOk=true
        val done=pending.closeOwned()
        if (done.status() != (if (state <= 3) 1 else 5) || done.handle() != 0 || done.probe() != probe ||
            done.closeOwned() != done || closes != 2 || done.ready() != (state <= 3)) return i32(2)
        state=state+1
    }
    opens=0; waits=0; closes=0; handle=0
    if (prepared.scanTouchOwned(m5BoardTab5X,1,60).status() != 3 || opens != 1 || waits != 0 || closes != 0) return i32(3)
    opens=0
    if (Tab5BoardPrepare(6).scanTouchOwned(m5BoardTab5,1,60).status() != 2 ||
        prepared.scanTouchOwned(m5BoardTab5,1,61).status() != 2 || prepared.scanTouchOwned(m5BoardAtomVoice,1,60).status() != 2 || opens != 0) return i32(4)
    current=false
    if (prepared.scanTouchOwned(m5BoardTab5,1,60).status() != 2 || opens != 0 || bad) return i32(5)
    return i32(0)
}
