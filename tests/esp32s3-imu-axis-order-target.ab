import "../src/imu/axis_order.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_axis_order_target")
fun orderTarget(fixed: ImuAxisOrder,x: int,y: int,raw: ImuAxes,axis: int,left: bool): int =
    fixed.then(if (left) imuAxisOrderLeftHanded(x,y) else imuAxisOrderRightHanded(x,y)).rawAxis(raw,axis)
