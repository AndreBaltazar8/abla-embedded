import "../src/m5stack/pm1_digital_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val registers=nativeStaticAllocate(16384)
var writes=0
var drop=-1
var bad=false
fun regOffset(address: int): int {
    if (address < 0x60004000 || address >= 0x60008000 || (address&3) != 0) { bad=true;return 0 }
    return address-0x60004000
}
trusted fun esp32S3PinStateRead(address: int): int = nativeAddressLoadU32(registers,regOffset(address))
trusted fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes;writes=writes+1
    if (step == drop) return
    var target=address
    var updated=value
    if (address == 0x60004028) { target=0x60004020;updated=esp32S3PinStateRead(target)&~value }
    if (address == 0x60004034) { target=0x6000402c;updated=esp32S3PinStateRead(target)&~value }
    if (address == 0x60004024) { target=0x60004020;updated=esp32S3PinStateRead(target)|value }
    if (address == 0x6000400c) { target=0x60004004;updated=esp32S3PinStateRead(target)&~value }
    if (address == 0x60004008) { target=0x60004004;updated=esp32S3PinStateRead(target)|value }
    nativeAddressStoreU32(registers,regOffset(target),updated);return
}
@export("abla_pm1_digital_s3_test")
trusted fun test(): i32 {
    var route=0
    while (route < 3) {
        val board=if (route == 0) m5BoardChainCaptain else if (route == 1) m5BoardPaperMono else m5BoardStopWatch
        val total=if (route == 0) 19 else 8
        drop=-1
        while (drop < total) {
            var offset=0
            while (offset < 16384) { nativeAddressStoreU32(registers,offset,4294967295);offset=offset+4 }
            writes=0;bad=false
            if (board.configurePm1DigitalOwned(false) != 3 || m5BoardCoreP4X.configurePm1DigitalOwned(true) != 2 || writes != 0) return i32(1)
            val result=board.configurePm1DigitalOwned(true)
            val status=if (drop < 0) 1 else if (drop < (if (route == 0) 12 else 8)) 4 else 5
            val done=if (drop < 0) (if (route == 0) 4 else 2) else if (status == 5) 3 else drop/4
            if (result != (status|(done<<8)) || writes != (if (drop < 0) total else drop+1) || bad) return i32(2)
            if (drop < 0) {
                val inputMask=if (route == 0) 50 else if (route == 1) 12 else 6
                if (esp32S3PinStateRead(0x60004020) != (4294967295&~inputMask) ||
                    esp32S3PinStateRead(0x60004004) != (if (route == 0) 4292870143 else 4294967295)) return i32(3)
                var pin=0
                while (pin < 22) {
                    val input=(inputMask&(1<<pin)) != 0
                    val amplifier=route == 0 && pin == 21
                    val mux=if (input) (4294967295&~0x7380)|0x1200 else if (amplifier) (4294967295&~0x7200)|0x1000 else 4294967295
                    if (esp32S3PinStateRead(esp32S3GpioMuxAddress(pin)) != mux ||
                        esp32S3PinStateRead(0x60004554+pin*4) != (if (input || amplifier) (4294967295&~4095)|1280 else 4294967295) ||
                        esp32S3PinStateRead(0x60004074+pin*4) != (if (input || amplifier) 4294967291 else 4294967295)) return i32(4)
                    pin=pin+1
                }
            }
            drop=drop+1
        }
        route=route+1
    }
    // StopWatch OLED TE38 uses high-bank GPIO input-pullup, not RTC IO.
    drop=-1
    while (drop < 4) {
        var offset=0
        while (offset < 16384) { nativeAddressStoreU32(registers,offset,4294967295);offset=offset+4 }
        writes=0;bad=false
        val result=esp32S3GpioPrepareInputOwned(38,0,true)
        if (result != (if (drop < 0) 1 else 4) || writes != (if (drop < 0) 4 else drop+1) || bad) return i32(5)
        if (drop < 0 && (esp32S3PinStateRead(0x6000402c) != 4294967231 ||
            esp32S3PinStateRead(0x60004020) != 4294967295 ||
            esp32S3PinStateRead(esp32S3GpioMuxAddress(38)) != ((4294967295&~0x7380)|0x1300) ||
            esp32S3PinStateRead(0x60004554+38*4) != ((4294967295&~4095)|1280) ||
            esp32S3PinStateRead(0x60004074+38*4) != 4294967291)) return i32(6)
        drop=drop+1
    }
    return i32(0)
}
