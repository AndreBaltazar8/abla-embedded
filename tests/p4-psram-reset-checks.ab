import "../src/esp32/psram/reset_p4_sequence.ab"
val resetWriteLog=nativeStaticAllocate(16)
var resetWriteCount=0
fun psramResetChecks(): int {
    resetClock(1,2,7)
    val owner=p4PsramClockOpenOwned(1,2)
    if (owner.resetControllerOwned(1).status() != 1 || clockWrites != 4 || p4PsramClockRead(192) != 0xfd7fffff) return 70
    if (resetWriteCount != 4 || nativeBufferAt(resetWriteLog,16).loadU32(0) != 0xfdffffff || nativeBufferAt(resetWriteLog,16).loadU32(4) != 0xffffffff ||
        nativeBufferAt(resetWriteLog,16).loadU32(8) != 0xfdffffff || nativeBufferAt(resetWriteLog,16).loadU32(12) != 0xfd7fffff) return 80
    var failure=1
    while (failure <= 4) {
        resetClock(1,2,7); clockDrop=failure
        val partial=owner.resetControllerOwned(1)
        if (partial.status() != 5 || partial.failedStage() != failure || clockWrites != failure) return 71
        val reads=mappedReads
        clockDrop=0
        if (partial.releaseOwned().status() != 1 || mappedReads != reads || p4PsramClockRead(192) != 0xfd7fffff) return 72
        failure=failure+1
    }
    resetClock(1,2,7); registerWrite(60,1)
    if (owner.resetControllerOwned(1).status() != 4 || clockWrites != 0) return 73
    registerWrite(60,0); registerWrite(4096,1<<18)
    if (owner.resetControllerOwned(1).status() != 4 || clockWrites != 0) return 74
    registerWrite(4096,0); registerWrite(376,0)
    if (owner.resetControllerOwned(1).status() != 4 || clockWrites != 0) return 75
    resetClock(1,2,7); clockSet(192,0xffffffff)
    if (owner.resetControllerOwned(1).status() != 3 || clockWrites != 0 || mappedReads != 0) return 76
    resetClock(1,3,7)
    if (owner.resetControllerOwned(1).status() != 3 || clockWrites != 0 || mappedReads != 0) return 77
    resetClock(1,2,7); clockSet(20,0)
    if (owner.resetControllerOwned(1).status() != 3 || P4PsramReset(768).releaseOwned().status() != 3 || clockWrites != 0 || mappedReads != 0) return 78
    resetClock(1,2,7)
    if (owner.resetControllerOwned(0).status() != 2 || P4PsramClockOwner(0).resetControllerOwned(1).status() != 2 || clockWrites != 0 || mappedReads != 0) return 79
    return 0
}
