import "../src/m5stack/cores3_microphone_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Es7210 = int
fun Es7210.valid(): bool = this == 1
var trace = 0
var setupFails = false
var resetFails = false
trusted fun Es7210.configureStereoMic12(): bool { trace = trace * 10 + 1; !setupFails }
trusted fun Es7210.reset(): bool { trace = trace * 10 + 2; !resetFails }
trusted fun cores3MicrophoneTest(): int {
    var variant = 0
    while (variant < 4) {
        setupFails = (variant & 1) != 0
        resetFails = (variant & 2) != 0
        trace = 0
        val enabled = cores3MicrophoneEnable(Es7210(1))
        if (enabled.valid() == setupFails || enabled.cleanupAttempted() != setupFails || enabled.cleanupFailed() != (setupFails && resetFails)) return 1
        if (enabled.status() != (if (setupFails) 3 else 1) || trace != (if (setupFails) 12 else 1)) return 2
        trace = 0
        val disabled = cores3MicrophoneDisable(Es7210(1))
        if (disabled.status() != (if (resetFails) 4 else 1) || trace != 2) return 3
        trace = 0
        if (cores3MicrophoneEnable(Es7210(0)).status() != 2 || cores3MicrophoneDisable(Es7210(0)).status() != 2 || trace != 0) return 4
        variant = variant + 1
    }
    0
}
#exportFunction("cores3MicrophoneTest", "abla_cores3_microphone_test")
