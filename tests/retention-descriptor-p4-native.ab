import "../src/esp32/power/retention_descriptor_p4.ab"
import "../src/esp32/power/retention_system_p4.ab"
import "../src/esp32/power/retention_cache_p4.ab"
import "../src/esp32/power/retention_iomux_p4.ab"
import "./p4-retention-mspi-checks.ab"
import "./p4-retention-systimer-checks.ab"
import "./p4-retention-list-checks.ab"
import "./p4-retention-clock-checks.ab"
import "./p4-retention-uart-checks.ab"
import "./p4-retention-profile-checks.ab"
import "./p4-retention-graph-checks.ab"
import "./p4-retention-flash-transfer-checks.ab"
val configMemory=nativeStaticAllocate(56)
val outputMemory=nativeStaticAllocate(52)
trusted fun seedDescriptor(head: int): void {
    val c=nativeBufferAt(configMemory,56);val out=nativeBufferAt(outputMemory,52)
    var i=0
    while (i < 56) { c.storeU32(i,0);i=i+4 }
    i=0
    while (i < 52) { out.storeU32(i,0x12345678);i=i+4 }
    c.storeU32(0,head);c.storeU32(20,0x50000000);c.storeU32(24,0x50010000);c.storeU32(28,0x30100000)
    c.storeU32(48,0xabcdef12);c.storeU32(52,0xff00ff00);return
}
@export("abla_retention_descriptor_p4_test")
trusted fun test(): i32 {
    val c=nativeBufferAt(configMemory,56);val out=nativeBufferAt(outputMemory,52)
    var mode=0
    while (mode < 4) {
        var flags=0
        while (flags < 16) {
            val count=if (mode == 0) 1023 else if (mode == 1) 128 else 0
            val head=count|(mode<<16)|(flags<<28)
            seedDescriptor(head)
            val branches=if ((flags&1) != 0) 4 else 1
            var i=0
            if ((flags&8) == 0) { while (i < branches) { c.storeU32(4+i*4,0x30200000+i*64);i=i+1 } }
            i=0
            while (i < 4) { c.storeU32(32+i*4,0xffffffff);i=i+1 }
            if ((flags&9) == 9) {
                if (esp32p4RetentionDescriptorEncode(out,c) || out.loadU32(0) != 0x12345678) return i32(11)
                flags=flags+1;continue
            }
            if (!esp32p4RetentionDescriptorEncode(out,c)) return i32(1)
            val body=4+branches*4
            if (out.loadU32(0) != head || out.loadU32(body) != 0x50000000 ||
                out.loadU32(body+4) != (if (mode < 2) 0x50010000 else 0xabcdef12) ||
                out.loadU32(body+8) != (if (mode < 2) 0x30100000 else 0xff00ff00)) return i32(2)
            i=0
            while (i < branches) { if (out.loadU32(4+i*4) != c.loadU32(4+i*4)) return i32(3);i=i+1 }
            if (mode == 1) { i=0;while (i < 4) { if (out.loadU32(body+12+i*4) != 0xffffffff) return i32(4);i=i+1 } }
            if (out.loadU32(p4RetentionDescriptorBytes(head)) != 0x12345678) return i32(5)
            flags=flags+1
        }
        mode=mode+1
    }
    // Every bitmap position, including the last word/bit, and address wrap.
    var bit=0
    while (bit < 128) {
        seedDescriptor(0x80010001);c.storeU32(32+(bit/32)*4,1<<(bit%32))
        if (!esp32p4RetentionDescriptorEncode(out,c)) return i32(6)
        seedDescriptor(0x80010001);c.storeU32(32+(bit/32)*4,1<<(bit%32));c.storeU32(20,0xfffffffc)
        if (esp32p4RetentionDescriptorEncode(out,c) != (bit == 0)) return i32(7)
        bit=bit+1
    }
    var invalid=0
    while (invalid < 8) {
        seedDescriptor(0x80000001)
        if (invalid == 0) c.storeU32(0,0x80000401)
        if (invalid == 1) c.storeU32(0,0x80040001)
        if (invalid == 2) c.storeU32(4,0x30200000)
        if (invalid == 3) c.storeU32(0,1)
        if (invalid == 4) c.storeU32(28,outputMemory)
        if (invalid == 5) c.storeU32(24,3)
        if (invalid == 6) c.storeU32(0,0x80010001)
        if (invalid == 7) c.storeU32(8,0x30200000)
        if (esp32p4RetentionDescriptorEncode(out,c)) return i32(8)
        var i=0
        while (i < 52) { if (out.loadU32(i) != 0x12345678) return i32(9);i=i+4 }
        invalid=invalid+1
    }
    seedDescriptor(0x80000001)
    if (esp32p4RetentionDescriptorEncode(nativeBufferAt(outputMemory,19),c) || esp32p4RetentionDescriptorEncode(c,c)) return i32(10)
    var profile=0
    while (profile < 5) {
        val base=if (profile == 0) 0x500d6000 else if (profile == 1) 0x500d6800 else if (profile == 2) 0x500e5000 else if (profile == 3) 0x50082000 else 0x5009e000
        // Independent endpoint subtraction from the register headers.
        val end=base+(if (profile <= 1) 0x210 else if (profile == 2) 0x190 else if (profile == 3) 0x30 else 0x1c8)
        val count=(end-base)/4+1
        var terminal=0
        while (terminal < 2) {
            seedDescriptor(0)
            val next=if (terminal == 1) 0 else 0x30200000
            if (!esp32p4RetentionSystemConfig(c,profile,0x30100000,next) || !esp32p4RetentionDescriptorEncode(out,c)) return i32(12)
            if (out.loadU32(0) != (count|(if (terminal == 1) 0x80000000 else 0)) || out.loadU32(4) != next ||
                out.loadU32(8) != base || out.loadU32(12) != base || out.loadU32(16) != 0x30100000 || out.loadU32(20) != 0x12345678) return i32(13)
            terminal=terminal+1
        }
        profile=profile+1
    }
    seedDescriptor(0)
    if (esp32p4RetentionSystemConfig(c,5,0x30100000,0) || esp32p4RetentionSystemConfig(c,0,0xfffffffc,0) ||
        esp32p4RetentionSystemConfig(c,0,configMemory,0) || esp32p4RetentionSystemConfig(c,0,0x30100000,configMemory)) return i32(14)
    if (c.loadU32(0) != 0 || c.loadU32(48) != 0xabcdef12) return i32(15)
    var node=0
    while (node < 12) {
        seedDescriptor(0)
        val copy=node == 2 || node == 3
        val address=if (node == 0) 0x3ff10170 else if (node == 1) 0x3ff102f0 else if (node == 2) 0x3ff10000 else if (node == 3) 0x3ff10270 else
            if (node == 4) 0x3ff100a0 else if (node == 5) 0x3ff100a4 else if (node == 6) 0x3ff1009c else if (node < 10) 0x3ff10098 else 0x3ff103ac
        val value=if (node == 0) 31 else if (node == 6) (1|2|16) else if (node == 1 || node == 10) 32 else if (node == 8) 1 else if (node == 9) 16 else 0
        val mask=if (node == 4) 0xffffffff else if (node == 5) 0x0fffffff else if (node == 6) 63 else if (node == 7) 480 else if (node == 11) 32 else value
        val header=if (node == 2) 0x10005 else if (node == 3) 0x10006 else if (node == 9) 0x40030000 else 0x40020000
        if (!esp32p4RetentionCacheConfig(c,node,if (copy) 0x30100000 else 0,0x30200000) || !esp32p4RetentionDescriptorEncode(out,c)) return i32(16)
        if (out.loadU32(0) != header || out.loadU32(4) != 0x30200000 || out.loadU32(8) != address) return i32(17)
        if (copy) {
            if (out.loadU32(12) != address || out.loadU32(16) != 0x30100000 || out.loadU32(20) != (if (node == 2) 7 else 0xc000000f) ||
                out.loadU32(24) != 0 || out.loadU32(28) != (if (node == 2) 0x0c000000 else 0) || out.loadU32(32) != 0 || out.loadU32(36) != 0x12345678) return i32(18)
        } else if (out.loadU32(12) != value || out.loadU32(16) != mask || out.loadU32(20) != 0x12345678) return i32(19)
        node=node+1
    }
    seedDescriptor(0)
    if (esp32p4RetentionCacheConfig(c,12,0,0) || esp32p4RetentionCacheConfig(c,2,0,0) ||
        esp32p4RetentionCacheConfig(c,0,0x30100000,0) || esp32p4RetentionCacheConfig(c,3,0xfffffffc,0) || c.loadU32(48) != 0xabcdef12) return i32(20)
    node=0
    while (node < 6) {
        val address=if (node == 0) 0x500e1000 else if (node == 1) 0x500e1204 else if (node == 2) 0x500e0004 else if (node == 3) 0x500e0074 else if (node == 4) 0x500e015c else 0x500e064c
        val words=if (node == 0) (0xdc/4)+1 else if (node == 1) ((0x68-4)/4)+1 else if (node == 2) 6 else if (node == 3) ((0x154-0x74)/4)+1 else if (node == 4) ((0x638-0x15c)/4)+1 else 9
        var end=0
        while (end < 2) {
            seedDescriptor(0)
            val next=if (end == 0) 0x30200000 else 0
            if (!esp32p4RetentionIomuxConfig(c,node,0x30100000,next) || !esp32p4RetentionDescriptorEncode(out,c)) return i32(21)
            val header=words|(if (node == 2 || node == 5) 0x10000 else 0)|(if (end == 1) 0x80000000 else 0)
            if (out.loadU32(0) != header || out.loadU32(4) != next || out.loadU32(8) != address || out.loadU32(12) != address || out.loadU32(16) != 0x30100000) return i32(22)
            if (node == 2 || node == 5) {
                if (out.loadU32(20) != (if (node == 2) 0x90489 else 1) || out.loadU32(24) != (if (node == 5) 0x6fa000 else 0) || out.loadU32(28) != 0 || out.loadU32(32) != 0 || out.loadU32(36) != 0x12345678) return i32(23)
            } else if (out.loadU32(20) != 0x12345678) return i32(24)
            // Dedicated MSPI copy ends exactly at the last implemented word.
            if (node == 1 && address+(words-1)*4 != 0x500e1268) return i32(25)
            end=end+1
        }
        node=node+1
    }
    seedDescriptor(0)
    if (esp32p4RetentionIomuxConfig(c,6,0x30100000,0) || esp32p4RetentionIomuxConfig(c,4,0xfffffffc,0) ||
        esp32p4RetentionIomuxConfig(c,0,configMemory,0) || c.loadU32(48) != 0xabcdef12) return i32(26)
    val mspi=mspiRetentionChecks(c,out)
    if (mspi != 0) return i32(mspi)
    val systimer=systimerRetentionChecks(c,out)
    if (systimer != 0) return i32(systimer)
    val clocks=clockRetentionChecks(c,out)
    val uart=uartRetentionChecks()
    if (uart != 0) return i32(uart)
    val profileResult=retentionProfileChecks()
    if (profileResult != 0) return i32(profileResult)
    val graphResult=retentionGraphChecks()
    if (graphResult != 0) return i32(graphResult)
    val transferResult=retentionFlashTransferChecks()
    if (transferResult != 0) return i32(transferResult)
    return i32(if (clocks != 0) clocks else retentionListChecks())
}
