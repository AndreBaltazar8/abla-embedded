                if (esp32p4RetentionExtraPollOwned(r,3,true) != 6 || retentionWrites != count || extraStarts != (if (fault == 4) 0 else 1) ||
                    esp32p4RetentionExtraBeginOwned(r,true,true) != 2 || esp32p4RetentionExtraCloseOwned(r,false) != 2) return 51
