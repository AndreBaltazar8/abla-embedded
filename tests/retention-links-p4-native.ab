        retentionDrop=0
        if (esp32p4RetentionRoutedSessionCloseOwned(r,true) != 8 || retentionBad || !retentionOriginal() || entry3Register != 0x30400000 ||
            r.loadU32(8) != primary || r.loadU32(12) != 0 || r.loadU32(88) != 0x1234abcd) return 33
        val count=retentionWrites
        if (esp32p4RetentionRoutedSessionCloseOwned(r,true) != 8 || retentionWrites != count) return 34
        fault=fault+1
    }
