fun seedSession(): NativeBuffer {
    seedRetentionLinks()
    var i=16
    while (i < 32) { nativeBufferAt(registers,32).storeU32(i,if (i >= 24) 0x01234567 else 0x30100000+i*16);i=i+4 }
