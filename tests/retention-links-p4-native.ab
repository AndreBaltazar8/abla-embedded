    if (esp32p4RetentionExtraBeginOwned(r,true,true) != 4 || retentionWrites != 0 || r.loadU32(0) != 0) return 56
    extraRaw=u32(1);extraFlow=u32(1)
    if (esp32p4RetentionExtraBeginOwned(r,true,true) != 4 || retentionWrites != 0) return 57
    extraFlow=u32(0)
    if (esp32p4RetentionExtraBeginOwned(r,true,true) != 1) return 58
    extraRaw=u32(3)
    if (esp32p4RetentionExtraPollOwned(r,1,true) != 7 || r.loadU32(4) != 2 || esp32p4RetentionExtraCloseOwned(r,false) != 2) return 59
    val count=retentionWrites;retentionReady=false
    if (esp32p4RetentionExtraPollOwned(r,1,true) != 3 || esp32p4RetentionExtraCloseOwned(r,true) != 3 || retentionWrites != count) return 60
    retentionReady=true
    if (esp32p4RetentionExtraCloseOwned(r,true) != 8 || extraRaw != u32(3) || extraStarts != 1 || retentionBad) return 61
    return 0
}
fun seedRouted(): NativeBuffer {
    seedSession();routedGuard=true
    val r=nativeBufferAt(routedMemory,92)
    var i=0
    while (i < 88) { r.storeU32(i,0);i=i+4 }
    r.storeU32(88,0x1234abcd);return r
}
fun routedChecks(): int {
    val c=nativeBufferAt(configMemory,32)
    var fault=0
    while (fault <= 18) {
        val r=seedRouted()
        if (fault <= 9) retentionDrop=fault
        val expected=if (fault == 0 || fault > 9) 1 else if (fault == 1) 3 else 4
        if (esp32p4RetentionRoutedSessionOpenOwned(r,c,0x30500000,true) != expected || retentionBad) return 30
        val primary=r.loadU32(8)
