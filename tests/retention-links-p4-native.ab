val recordMemory=nativeStaticAllocate(36)
val registers=nativeStaticAllocate(32)
val sessionMemory=nativeStaticAllocate(68)
val configMemory=nativeStaticAllocate(32)
var retentionWrites=0
var retentionDrop=0
var retentionReady=true
var retentionBad=false
var routedGuard=false
var retentionExpectedHead=u32(0x30200000)
var entry3Register=0x30400000
val routedMemory=nativeStaticAllocate(92)
val extraMemory=nativeStaticAllocate(28)
var extraControl=u32(0x310)
var extraRaw=u32(1)
var extraFlow=u32(0)
var extraAon=u32(0x87654321)
var extraStarts=0
var extraFences=0
var flashRestoreGuard=false
val flashRestoreMemory=nativeStaticAllocate(84)
fun p4RetentionExtraFence(): void { extraFences=extraFences+1;return }
fun p4RetentionClockReady(): bool = retentionReady
fun p4RetentionPauRead(offset: int): u32 {
    if (offset == 0) return extraControl|extraFlow
    if (offset == 52) return extraRaw
    if (offset == 24) return u32(entry3Register)
    if (offset == 44) return u32(nativeBufferAt(registers,32).loadU32(16))
    if (offset < 12 || offset > 20 || (offset&3) != 0) { retentionBad=true;return u32(0) }
    return u32(nativeBufferAt(registers,16).loadU32(offset-12))
}
fun writeSlot(slot: int,value: u32): void {
    retentionWrites=retentionWrites+1
    if (retentionWrites != retentionDrop) nativeBufferAt(registers,32).storeU32(slot,int(value))
    return
}
fun p4RetentionPauWrite(offset: int,value: u32): void {
    if (offset == 56) {
        if (value != u32(1)) retentionBad=true
        retentionWrites=retentionWrites+1
        if (retentionWrites != retentionDrop) extraRaw=extraRaw&~value
        return
    }
    if (offset == 0) {
        if ((value&~u32(0x378)) != u32(0)) retentionBad=true
        retentionWrites=retentionWrites+1
        if (retentionWrites != retentionDrop) {
            extraControl=value&u32(0x370)
            if ((value&u32(8)) != u32(0)) {
                if (flashRestoreGuard && (flashReads != 2 || flashReset != u32(0x200) || flashError != u32(0xa0) ||
                    (value&u32(16)) != u32(0) || flashEntry != (u32(0x225)|(if (flashEncrypted) u32(0x3000) else u32(0x1000))))) retentionBad=true
                if ((extraAon&u32(0x80000000)) != u32(0) || extraRaw != u32(0) || extraFences == 0 || (value&u32(96)) != u32(96)) retentionBad=true
                extraStarts=extraStarts+1
                if (flashGraphEngineEnabled && !flashGraphEngineExecute(entry3Register,(value&u32(16)) != u32(0))) extraRaw=u32(2)
            }
        }
        return
    }
    if (offset == 24) {
        if (routedGuard && value == u32(0x30400000)) {
            if (!retentionOriginal()) retentionBad=true
            var i=16
            while (i < 32) {
                if (nativeBufferAt(registers,32).loadU32(i) != (if (i >= 24) 0x01234567 else 0x30100000+i*16)) retentionBad=true
                i=i+4
            }
        }
        retentionWrites=retentionWrites+1
        if (retentionWrites != retentionDrop) entry3Register=int(value)
        return
    }
    if (offset == 44) { writeSlot(16,value);return }
    if (offset < 12 || offset > 20 || (offset&3) != 0) { retentionBad=true;return }
    writeSlot(offset-12,value);return
}
fun p4RetentionLpRead(offset: int): u32 { if (offset == 344) return extraAon;if (offset != 348 && offset != 340) retentionBad=true;return u32(nativeBufferAt(registers,32).loadU32(if (offset == 348) 12 else 20)) }
fun p4RetentionLpWrite(offset: int,value: u32): void {
    if (offset == 344) {
        if ((value&u32(0x7fffffff)) != (extraAon&u32(0x7fffffff))) retentionBad=true
        retentionWrites=retentionWrites+1;if (retentionWrites != retentionDrop) extraAon=value;return
    }
    if (offset != 348 && offset != 340) retentionBad=true;writeSlot(if (offset == 348) 12 else 20,value);return
}
fun p4RetentionPmuRead(offset: int): u32 { if (offset != 28 && offset != 132) retentionBad=true;return u32(nativeBufferAt(registers,32).loadU32(if (offset == 28) 24 else 28)) }
fun p4RetentionPmuWrite(offset: int,value: u32): void {
    if (offset != 28 && offset != 132) retentionBad=true
    val mask=if (offset == 28) u32(0x20000000) else u32(0x80000000)
    if (routedGuard && (value&mask) != u32(0) && entry3Register != 0x30500000) retentionBad=true
    if ((value&mask) != u32(0) && (p4RetentionPauRead(12) != retentionExpectedHead || p4RetentionLpRead(348) != retentionExpectedHead)) retentionBad=true
    writeSlot(if (offset == 28) 24 else 28,value);return
}
fun seedRetentionLinks(): NativeBuffer {
    retentionExpectedHead=u32(0x30200000)
    val r=nativeBufferAt(recordMemory,36)
    var i=0
    while (i < 32) { r.storeU32(i,0);i=i+4 }
    i=0
    while (i < 16) { nativeBufferAt(registers,16).storeU32(i,0x30100000+i*16);i=i+4 }
    r.storeU32(32,0x1234abcd);retentionWrites=0;retentionDrop=0;retentionReady=true;retentionBad=false;routedGuard=false;entry3Register=0x30400000;return r
}
fun retentionOriginal(): bool {
    var i=0
    while (i < 16) { if (nativeBufferAt(registers,16).loadU32(i) != 0x30100000+i*16) return false;i=i+4 }
    return !retentionBad
}
@export("abla_retention_links_p4_test")
trusted fun retentionLinksTest(): i32 {
    var fault=0
    while (fault <= 8) {
        val r=seedRetentionLinks();if (fault <= 4) retentionDrop=fault
        val opened=esp32p4RetentionLinksOpenOwned(r,0x30200000,0,0x30300000,true)
        if (opened != (if (fault >= 1 && fault <= 4) 4 else 1)) return i32(1)
        val primary=r.loadU32(8)
        if (fault == 0 && (p4RetentionLpRead(348) != u32(0x30200000) || p4RetentionPauRead(16) != u32(0))) return i32(2)
        retentionDrop=if (fault > 4) retentionWrites+fault-4 else 0
        if (esp32p4RetentionLinksCloseOwned(r,true) != (if (fault > 4) 4 else 5)) return i32(3)
        retentionDrop=0
        if (esp32p4RetentionLinksCloseOwned(r,true) != 5 || !retentionOriginal() || r.loadU32(8) != primary || r.loadU32(32) != 0x1234abcd) return i32(4)
        val count=retentionWrites
        if (esp32p4RetentionLinksCloseOwned(r,true) != 5 || retentionWrites != count) return i32(5)
        fault=fault+1
    }
    val r=seedRetentionLinks()
    if (esp32p4RetentionLinksOpenOwned(r,0,0,0,true) != 2 || esp32p4RetentionLinksOpenOwned(r,recordMemory,0,0,true) != 2 ||
        esp32p4RetentionLinksOpenOwned(r,3,0,0,true) != 2 || retentionWrites != 0) return i32(6)
    if (esp32p4RetentionLinksOpenOwned(r,0x30200000,0,0,true) != 1) return i32(7)
    retentionReady=false;val count=retentionWrites
    if (esp32p4RetentionLinksCloseOwned(r,true) != 3 || retentionWrites != count) return i32(8)
    retentionReady=true
    if (esp32p4RetentionLinksCloseOwned(r,true) != 5 || !retentionOriginal()) return i32(9)
    val sessionResult=sessionChecks()
    if (sessionResult != 0) return i32(sessionResult)
    val routedResult=routedChecks()
    if (routedResult != 0) return i32(routedResult)
    val extraResult=extraChecks()
    if (extraResult != 0) return i32(extraResult)
    val flashRevResult=sleepFlashRev3Checks()
    val holdResult=sleepFlashHoldChecks()
    if (holdResult != 0) return i32(holdResult)
    val predictorResult=sleepPredictorChecks()
    if (predictorResult != 0) return i32(predictorResult)
    val l2Result=sleepL2Checks()
    if (l2Result != 0) return i32(l2Result)
    return i32(if (flashRevResult != 0) flashRevResult else flashRestoreChecks())
}
fun seedFlashRestore(encrypted: bool): NativeBuffer {
    flashHolds=0xa400003f
    seedExtra();seedFlashRev(encrypted);flashRestoreGuard=true
    val r=nativeBufferAt(flashRestoreMemory,84)
    var i=0
    while (i < 80) { r.storeU32(i,0);i=i+4 }
    r.storeU32(80,0x1234abcd);return r
}
fun flashRestoreChecks(): int {
    var encryption=0
    while (encryption < 2) {
        var fault=0
        while (fault <= 18) {
            val r=seedFlashRestore(encryption == 1)
            if (fault <= 12) flashDrop=fault
            if (fault >= 13 && fault <= 15) retentionDrop=fault-12
            val expected=if (fault == 0 || fault == 6 || fault > 15) 5 else if (fault <= 12) 3 else 4
            if (esp32p4SleepFlashRestoreBeginOwned(r,300,2,true) != expected || retentionBad || flashBad) return 120
            if ((expected == 3 || expected == 4) && extraStarts != 0) return 121
            retentionDrop=0;flashDrop=0
            if (esp32p4SleepFlashRestoreContinueOwned(r,2,true) != 5 || extraStarts != 1 || flashReads != 2 || retentionBad || flashBad) return 122
            val priorFlashWrites=flashWrites
            val priorPauWrites=retentionWrites
            if (esp32p4SleepFlashRestoreContinueOwned(r,2,true) != 5 || flashWrites != priorFlashWrites || retentionWrites != priorPauWrites ||
                esp32p4SleepFlashRestoreBeginOwned(r,300,2,true) != 2) return 123
            extraRaw=u32(1)
            if (fault > 15) retentionDrop=retentionWrites+fault-15
            if (esp32p4SleepFlashRestoreContinueOwned(r,2,true) != (if (fault > 15) 7 else 1)) return 124
            retentionDrop=0
            if (esp32p4SleepFlashRestoreContinueOwned(r,2,true) != 1 || extraStarts != 1 || flashWrites != priorFlashWrites ||
                extraControl != u32(0x310) || extraAon != u32(0x87654321) || r.loadU32(80) != 0x1234abcd || retentionBad || flashBad) return 125
            val count=retentionWrites
            if (esp32p4SleepFlashRestoreContinueOwned(r,2,true) != 1 || retentionWrites != count) return 126
            fault=fault+1
        }
        encryption=encryption+1
    }
    val r=seedFlashRestore(false);entry3Register=flashRestoreMemory+4
    if (esp32p4SleepFlashRestoreBeginOwned(r,300,2,true) != 4 || flashWrites != 0 || retentionWrites != 0 || r.loadU32(0) != 0) return 127
    entry3Register=0x30400000
    if (esp32p4SleepFlashRestoreBeginOwned(r,300,2,true) != 5) return 128
    retentionReady=false;val count=retentionWrites
    if (esp32p4SleepFlashRestoreContinueOwned(r,2,true) != 5 || retentionWrites != count || extraStarts != 1) return 129
    retentionReady=true;extraRaw=u32(3)
    if (esp32p4SleepFlashRestoreContinueOwned(r,2,true) != 6 || r.loadU32(4) != 6) return 130
    // Even a subsequent DONE must not erase the observed engine error.
    extraRaw=u32(1)
    if (esp32p4SleepFlashRestoreContinueOwned(r,2,true) != 6 || retentionWrites != count || extraStarts != 1 || extraAon != u32(0x07654321)) return 131
