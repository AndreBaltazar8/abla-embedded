    while (pin < 6) {
        val guarded=seedFlashRestore(false)
        flashHolds=flashHolds^(1<<pin)
        if (esp32p4SleepFlashRestoreBeginOwned(guarded,300,2,true) != 4 || retentionWrites != 0 || flashWrites != 0 || guarded.loadU32(0) != 0) return 132
        flashHolds=flashHolds|(1<<pin)
        if (esp32p4SleepFlashRestoreBeginOwned(guarded,300,2,true) != 5) return 133
        val heldWrites=retentionWrites;val heldFlashWrites=flashWrites
        flashHolds=flashHolds^(1<<pin);extraRaw=u32(1)
        if (esp32p4SleepFlashRestoreContinueOwned(guarded,2,true) != 4 || retentionWrites != heldWrites || flashWrites != heldFlashWrites || extraStarts != 1) return 134
        flashHolds=flashHolds|(1<<pin)
        if (esp32p4SleepFlashRestoreContinueOwned(guarded,2,true) != 1 || extraStarts != 1 || flashWrites != heldFlashWrites || retentionBad || flashBad) return 135
        pin=pin+1
    }
    flashRestoreGuard=false;return 0
}
fun seedExtra(): NativeBuffer {
    flashGraphEngineEnabled=false
    seedRetentionLinks();extraControl=u32(0x310);extraRaw=u32(1);extraFlow=u32(0);extraAon=u32(0x87654321);extraStarts=0;extraFences=0
    val r=nativeBufferAt(extraMemory,28)
    var i=0
    while (i < 24) { r.storeU32(i,0);i=i+4 }
    r.storeU32(24,0x1234abcd);return r
}
fun extraChecks(): int {
    var direction=0
    while (direction < 2) {
        var fault=0
        while (fault < 8) {
            val r=seedExtra();if (fault <= 4) retentionDrop=fault
            val started=esp32p4RetentionExtraBeginOwned(r,direction == 1,true)
            if (started != (if (fault >= 1 && fault <= 3) 5 else 1) || retentionBad) return 50
            if (started == 1) {
