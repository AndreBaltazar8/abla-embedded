    i=0;while (i < 64) { r.storeU32(i,0);i=i+4 }
    r.storeU32(64,0x1234abcd)
    val c=nativeBufferAt(configMemory,32)
    c.storeU32(0,0x30200000);c.storeU32(4,0);c.storeU32(8,0x30300000)
    c.storeU32(12,1023);c.storeU32(16,127);c.storeU32(20,200);c.storeU32(24,300);c.storeU32(28,50)
    return r
}
fun sessionChecks(): int {
