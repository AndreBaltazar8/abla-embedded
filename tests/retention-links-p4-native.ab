        retentionDrop=0
        if (esp32p4RetentionSessionCloseOwned(r,true) != 8 || !retentionOriginal() || r.loadU32(8) != primary || r.loadU32(12) != 0 || r.loadU32(64) != 0x1234abcd) return 23
        var i=16
        while (i < 32) { if (nativeBufferAt(registers,32).loadU32(i) != (if (i >= 24) 0x01234567 else 0x30100000+i*16)) return 24;i=i+4 }
        val count=retentionWrites
        if (esp32p4RetentionSessionCloseOwned(r,true) != 8 || retentionWrites != count) return 25
        fault=fault+1
    }
    val invalid=seedSession();c.storeU32(28,128)
    if (esp32p4RetentionSessionOpenOwned(invalid,c,true) != 2 || retentionWrites != 0 || invalid.loadU32(0) != 0) return 26
    c.storeU32(28,50);c.storeU32(0,sessionMemory)
    if (esp32p4RetentionSessionOpenOwned(invalid,c,true) != 2 || retentionWrites != 0) return 27
