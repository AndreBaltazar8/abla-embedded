import "../src/touch/controller_power_sequence.ab"
import "../src/touch/gt911_power_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var trace=0
var okay=true
var pad=true
var powerFailure=0
var elapsed=0
fun gt911PowerPinValid(interrupt: int): bool = interrupt == 48
fun gt911PowerOutputLowOwned(interrupt: int): bool { trace=trace*10+1; return (powerFailure&1) == 0 }
fun gt911PowerWriteHighOwned(interrupt: int): bool { trace=trace*10+2; return (powerFailure&2) == 0 }
fun gt911PowerInputPullupOwned(interrupt: int): bool { trace=trace*10+3; return (powerFailure&4) == 0 }
fun gt911PowerSleep(handle: int): bool { trace=trace*10+4; return (powerFailure&8) == 0 }
fun gt911PowerDelayMilliseconds(ms: int): void { elapsed=elapsed+ms; return }
fun touchControllerAllocate(bus: int,kind: int,address: int,frequency: int): int = 0
fun touchControllerBegin(kind: int,handle: int): bool = false
fun touchControllerRelease(kind: int,handle: int): bool { trace=trace*10+5; true }
fun touchPowerPadValid(kind: int,number: int): bool = pad
fun touchPowerPrepareSleep(number: int): void { trace=trace*10+1; return }
fun touchPowerSleepCommand(kind: int,handle: int): bool { trace=trace*10+2; okay }
fun touchPowerWakePulse(kind: int,number: int): void { trace=trace*10+3; return }
fun touchPowerMonitor(handle: int): bool { trace=trace*10+4; okay }
@export("abla_touch_power_test")
fun testPower(): i32 {
    var kind=1
    while (kind <= 2) {
        var profile=0
        while (profile < 4) {
            val owner=TouchControllerOpen((1<<40)|(kind<<32)|123)
            okay=(profile&1) != 0
            trace=0
            val asleep=owner.sleepOwned(7)
            if (asleep.status() != (if (okay) 5 else 6) || asleep.ready() || asleep.handle() != 123 ||
                trace != (if (kind == 1) 2 else 12)) return i32(1)
            trace=0
            if (asleep.sleepOwned(7) != asleep || trace != 0) return i32(2)
            okay=(profile&2) != 0
            val awake=asleep.wakeOwned(7)
            if (awake.ready() != (kind == 2 || okay) || awake.handle() != 123 ||
                trace != (if (kind == 1) 34 else 3)) return i32(3)
            trace=0
            if (asleep.closeOwned() != 0 || trace != 5) return i32(4)
            pad=false
            trace=0
            if (owner.sleepOwned(7) != owner || asleep.wakeOwned(7) != asleep || trace != 0) return i32(5)
            pad=true
            profile=profile+1
        }
        kind=kind+1
    }
    trace=0
    val chsc=TouchControllerOpen((1<<40)|(3<<32)|123)
    if (chsc.sleepOwned(7) != chsc || trace != 0) return i32(6)
    val gt=TouchControllerOpen((1<<40)|(2<<32)|123)
    powerFailure=0
    while (powerFailure < 16) {
        trace=0;elapsed=0
        val sleep=gt.sleepGt911CheckedOwned(48,true)
        val slept=(powerFailure&9) == 0
        if (sleep.status() != (if (slept) 5 else 6) || sleep.handle() != 123 || sleep.kind() != 2 ||
            trace != (if ((powerFailure&1) != 0) 13 else if ((powerFailure&8) != 0) 143 else 14) || elapsed != 0) return i32(7)
        trace=0
        val wake=sleep.wakeGt911CheckedOwned(48,true)
        if (wake.status() != (if ((powerFailure&7) == 0) 1 else 6) || wake.handle() != 123 || wake.kind() != 2 ||
            trace != (if ((powerFailure&1) != 0) 13 else 123) ||
            elapsed != (if ((powerFailure&1) != 0) 0 else if ((powerFailure&2) != 0) 58 else 60)) return i32(8)
        trace=0
        if (gt.wakeGt911CheckedOwned(48,true) != gt || sleep.sleepGt911CheckedOwned(48,true) != sleep ||
            gt.sleepGt911CheckedOwned(48,false) != gt || sleep.wakeGt911CheckedOwned(48,false) != sleep ||
            gt.sleepGt911CheckedOwned(36,true) != gt || sleep.wakeGt911CheckedOwned(36,true) != sleep ||
            chsc.sleepGt911CheckedOwned(48,true) != chsc || trace != 0) return i32(9)
        if (sleep.closeOwned() != 0 || trace != 5) return i32(10)
        powerFailure=powerFailure+1
    }
    i32(0)
}
