}
trusted fun c5CpuClockTicks(mhz: int): void {
    if (cycleRecovering() && modelPllDelay != 10) bad=true
    val restoring=cycleRecovering() || cycleAborting() && nativeBufferAt(memory+192,48).loadU32(4) == 1
    if (mhz != (if (restoring) expectedMHz else 40)) bad=true
    clockReady=cycleRecovering();return
}
trusted fun c5ClockParkPvtActive(): bool { bad=true;return false }
trusted fun c5ClockParkPvt(record: NativeBuffer): int { bad=true;return 2 }
import "./sleep-memory-pll-c5-model.ab"
// PVT remains unused; the independent MSPI PLL dependency is real above.
trusted fun c5ClockResumePvt(record: NativeBuffer): int { bad=true;return 3 }
trusted fun c5ClockResumeRead(address: int): int = if (address == 0x600b00ac) regRead(1024,0xac) else if (address == 0x600b0420) rcGate else 0
trusted fun c5ClockResumeWrite(address: int,value: int): void {
    if (address == 0x600b00ac) regWrite(1024,0xac,value)
    else if (address == 0x600b0420) rcGate=value
    else bad=true
    return
}
trusted fun c5ClockResumeDelay(us: int): void { if (us != 50 && us != 5) bad=true;return }
trusted fun c5RtcTimerRead(offset: int): int = regRead(2048,offset)
trusted fun c5RtcTimerWrite(offset: int,value: int): void {
    if ((preFault == 5 || preFault == 8) && !cycleAborting() && !injected && offset == 0) { injected=true;return }
    if (preFault == 8 && cycleAborting() && !cleanupInjected && offset == 4) { cleanupInjected=true;return }
    if (offset == 0x34) {
        if (cycleRecovering() && !clockReady) bad=true
        if (cycleRecovering() && fault == 3) { fault=0;return }
        regWrite(2048,0x28,regRead(2048,0x28)&~value)
    } else if (offset == 4) regWrite(2048,offset,value&0x7fffffff)
    else regWrite(2048,offset,value)
    return
}
trusted fun c5SleepUartRead(address: int): int {
    if (address == 0x60096000 || address == 0x6009600c) {
        if (preFault == 10 && cycleAborting() && !cleanupInjected && address == 0x60096000) { cleanupInjected=true;return 0 }
        if (cycleRecovering() && cacheResumes != 1) bad=true
        if (cycleRecovering() && fault == 4 && address == 0x60096000) { fault=0;return 0 }
        return 1
    }
    if (address == 0x60096004 || address == 0x60096010) return 0x400000
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset == 0x98 || offset == 0x70) return 0
    return regRead(2560,port*256+offset)
}
trusted fun c5SleepUartWrite(address: int,value: int): void {
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset != 0x98) regWrite(2560,port*256+offset,value)
    return
}
trusted fun c5CachePredictorDisable(): int = 0x1030
trusted fun c5CacheRomSuspend(): int { cacheSuspends=cacheSuspends+1;return 0x80000001 }
trusted fun c5SleepFlashReadyDelay(us: int): void { if (!clockReady || us != 700) bad=true;flashDelay=flashDelay+1;return }
trusted fun c5CacheRomResume(saved: int): void {
    if (modelPllDelay != 10 || modelPllGate != 0x80 || modelPllSelector != 0x13579b) bad=true
    if (nativeBufferAt(memoryState+48,448).loadU32(4) != 4 || memoryClock != 0x603) bad=true;
    var offset=0
    while (offset < 512) {
        if (nativeBufferAt(memoryState+512,512).loadU32(offset) != (if (offset == 0x50) esp32C5MspiDividerBits(3) else 0)) bad=true
        offset=offset+4
    }
    if (!clockReady || nativeBufferAt(memory+608,24).loadU32(4) != 6 || saved != 0x80000001 || flashDelay != 0) bad=true
    cacheResumes=cacheResumes+1;return
}
trusted fun c5CachePredictorRestore(saved: int): void { if (cacheResumes != 1 || saved != 0x1030) bad=true;predictorRestores=predictorRestores+1;return }

@export("abla_sleep_memory_cycle_c5_test")
trusted fun test(): int {
    val cycle=nativeBufferAt(memory,792);val request=nativeBufferAt(memory+792,68)
