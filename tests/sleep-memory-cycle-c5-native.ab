        val old=request.loadU32(offset);request.storeU32(offset,value)
        if (beginMemoryTest(cycle,request) != 2 || cycle.loadU32(0) != 0) return 16
        i=4;while (i < 792) { if (cycle.load(i) != 0xa5) return 17;i=i+1 }
        request.storeU32(offset,old);invalid=invalid+1
    }
