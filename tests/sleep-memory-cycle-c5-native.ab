val memoryState=nativeStaticAllocate(1024)
var memoryClock=0x603
var memoryFailure=0
var unsafeMemory=0
var memoryWrites=0
var idleRemaining0=0
var idleRemaining1=0
trusted fun c5MspiRead(address: int): int {
    // Read-only admission is allowed before preparation/cache suspension.
    if (cacheResumes != 0) bad=true
    if (address == 0x60096018) return 13
    if (address == 0x6009601c) return memoryClock
    if (address == 0x60002000 || address == 0x60003000) {
        if (cacheSuspends != 1 || cacheResumes != 0 || memoryWrites != 0 || requests != 0 || modelPllDelay != 0) bad=true
        if (address == 0x60002000 && idleRemaining0 > 0) { idleRemaining0=idleRemaining0-1;return 0x40000 }
        if (address == 0x60003000 && idleRemaining1 > 0) { idleRemaining1=idleRemaining1-1;return 0x80000000 }
        return 0
    }
    if (address < 0x60002000 || address >= 0x60002200) { bad=true;return 0 }
    nativeBufferAt(memoryState+512,512).loadU32(address-0x60002000)
}
trusted fun c5MspiWrite(address: int,value: int): void {
    if (cacheSuspends != 1 || cacheResumes != 0) bad=true
    if (!cycleRecovering() && !(address == 0x60002180 && (value&64) != 0)) {
        memoryWrites=memoryWrites+1
        if (memoryWrites == memoryFailure) return
    }
    if (address == 0x6009601c) { memoryClock=value;return }
    if (address < 0x60002000 || address >= 0x60002200) { bad=true;return }
    nativeBufferAt(memoryState+512,512).storeU32(address-0x60002000,if (address == 0x60002180) value&~64 else value)
    return
}
trusted fun beginMemoryTest(cycle: NativeBuffer,request: NativeBuffer): int {
    val context=nativeBufferAt(memoryState,496)
    var offset=0
    while (offset < 1024) { nativeBufferAt(memoryState,1024).storeU32(offset,0);offset=offset+4 }
    memoryClock=0x603;memoryWrites=0;modelPllDelay=0
    idleRemaining0=(memoryFailure%3)*3;idleRemaining1=(memoryFailure%4)*3
    nativeBufferAt(memoryState+512,512).storeU32(0x50,esp32C5MspiDividerBits(3))
    context.storeU32(0,80);context.storeU32(4,40);context.storeU32(8,20)
    context.storeU32(16,19);context.storeU32(24,19);context.storeU32(28,71)
    context.storeU32(36,68);context.storeU32(40,67);context.storeU32(44,10)
    if (unsafeMemory == 1) {
        memoryClock=0x600
        nativeBufferAt(memoryState+512,512).storeU32(0x50,0x80000000)
    }
    if (unsafeMemory == 2) { context.storeU32(0,120);context.storeU32(8,120);context.storeU32(44,15) }
    val result=esp32C5SleepMemoryCycleBeginOwned(cycle,request,context,true)
    if (cacheSuspends == 1 && int(i32(cycle.loadU32(12))) == -3) expectedResult=-3
    return result
}
