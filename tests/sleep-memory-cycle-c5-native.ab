val memory=nativeStaticAllocate(3072)
var timeHigh=u32(0)
var timeLow=u32(0)
var timeLoads=0
var preFault=0
var injected=false
var cleanupInjected=false
var cacheSuspends=0
trusted fun cycleAborting(): bool = nativeBufferAt(memory,792).loadU32(4) == 5
trusted fun esp32C5TimerRead(address: int): u32 {
    if (cycleRecovering() && (!clockReady || cacheResumes != 1 || regRead(2560,0x3c) != 0 || regRead(2560,0x13c) != 0)) bad=true
    if (address == 0x6009606c) return u32(if (preFault == 1) 0 else 5)
    if (address == 0x60096070) return u32(0x400000)
    if (address == 0x6000a004) return u32(0x20000000)
    if (address == 0x6000a040) return u32(0)
    if (address == 0x6000a044) return u32(1600)
    if (address == 0x6000a00c) return timeHigh
    if (address == 0x6000a010) return timeLow
    bad=true;return u32(0)
}
trusted fun esp32C5TimerWrite(address: int,value: u32): void {
    if (address == 0x6000a004) return
