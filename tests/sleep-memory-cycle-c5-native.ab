    var invalid=0
    while (invalid < 18) {
        var i=0;while (i < 792) { cycle.store(i,0xa5);i=i+1 };cycle.storeU32(0,0)
        val offset=if (invalid < 5) 0 else if (invalid == 5) 8 else if (invalid == 6) 12 else if (invalid == 7) 16 else
            if (invalid == 8) 24 else if (invalid == 9) 28 else if (invalid == 10) 32 else if (invalid == 11) 36 else
            if (invalid == 12) 40 else if (invalid == 13) 48 else if (invalid == 14) 56 else if (invalid == 15) 52 else if (invalid == 16) 60 else 64
        val value=if (invalid == 0) 1 else if (invalid == 1) 4 else if (invalid == 2) 8 else if (invalid == 3) 16 else if (invalid == 4) 1024 else
            if (invalid == 5) 0x10000000 else if (invalid == 8) -2 else if (invalid == 9) 32 else if (invalid == 10) 16 else if (invalid == 11) 4 else
