import "../src/esp32/ledc_pins_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var pin=0
var channel=0
var held=0
var enabled=true
var high=false
var openDrain=false
var mux=true
var route=0xa0000500
var config=0
var start=0
var writes=0
var drop=false
var bad=false
fun esp32P4GpioIndividualHoldOwned(layout: int,number: int): int { if (number != pin) bad=true; return held }
fun p4LedcRead(offset: int): int {
    if (offset == channel*20) return config
    if (offset == channel*20+12) return start
    bad=true; return 0
}
fun p4GpioRead(offset: int): u32 {
    val bit=u32(1)<<u32(pin&31)
    if (offset == (if (pin < 32) 32 else 44)) return if (enabled) bit else u32(0)
    if (offset == (if (pin < 32) 4 else 16)) return if (high) bit else u32(0)
    if (offset == 116+pin*4) return if (openDrain) u32(4) else u32(0)
    if (offset == 4100+pin*4) return if (mux) u32(0x1000) else u32(0)
    if (offset == 1368+pin*4) return u32(route)
    bad=true; return u32(0)
}
fun p4GpioWrite(offset: int,value: u32): void {
    if (offset != 1368+pin*4) bad=true
    writes=writes+1
    if (!drop) route=int(value)
    return
}
@export("abla_ledc_pins_p4_test")
fun pinsTest(): i32 {
    var layout=1
    while (layout <= 3) {
        pin=0
        while (pin <= 54) {
            channel=0
            while (channel < 8) {
                var invert=0
                while (invert < 2) {
                    config=if (invert == 1) 8 else 0; route=0xa0000500
                    if (p4LedcPinAttachLowOwned(layout,pin,channel,invert == 1) != 1 || route != (0xa0000000|1024|126+channel|(if (invert == 1) 512 else 0))) return i32(1)
                    if (p4LedcPinDetachLowOwned(layout,pin,channel,invert == 1) != 1 || route != 0xa0000500 || bad) return i32(2)
                    invert=invert+1
                }
                channel=channel+1
            }
            pin=pin+1
        }
        layout=layout+2
    }
    pin=22; channel=7; config=0; route=0xa0000500; writes=0
    held=1
    if (p4LedcPinAttachLowOwned(3,pin,channel,false) != 3) return i32(3)
    held=0; high=true
    if (p4LedcPinAttachLowOwned(3,pin,channel,false) != 3) return i32(4)
    high=false; openDrain=true
    if (p4LedcPinAttachLowOwned(3,pin,channel,false) != 3) return i32(5)
    openDrain=false; mux=false
    if (p4LedcPinAttachLowOwned(3,pin,channel,false) != 3) return i32(6)
    mux=true; enabled=false
    if (p4LedcPinAttachLowOwned(3,pin,channel,false) != 3) return i32(7)
    enabled=true; config=4
    if (p4LedcPinAttachLowOwned(3,pin,channel,false) != 4) return i32(8)
    config=0; start=0x80000000
    if (p4LedcPinAttachLowOwned(3,pin,channel,false) != 4 || writes != 0) return i32(9)
    start=0; drop=true
    if (p4LedcPinAttachLowOwned(3,pin,channel,false) != 5 || route != 0xa0000500) return i32(10)
    drop=false
    if (p4LedcPinAttachLowOwned(3,pin,channel,false) != 1) return i32(11)
    drop=true
    if (p4LedcPinDetachLowOwned(3,pin,channel,false) != 5) return i32(12)
    drop=false; config=4
    if (p4LedcPinDetachLowOwned(3,pin,channel,false) != 4) return i32(13)
    val before=writes
    if (p4LedcPinAttachLowOwned(2,22,7,false) != 2 || p4LedcPinAttachLowOwned(3,55,7,false) != 2 || p4LedcPinDetachLowOwned(3,22,8,false) != 2 || writes != before || bad) return i32(14)
    return i32(0)
}
