import "../src/display/dsi_video_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_video_target")
trusted fun target(operation: int,arg: int,events: int): int {
    if (operation == 0) return esp32P4DsiVideoBridgePrepare()
    if (operation == 1) return esp32P4DsiVideoStart(arg)
    if (operation == 2) return esp32P4DsiVideoDisableOutput()
    if (operation == 3) return esp32P4DsiVideoEvents(arg)
    if (operation == 4) return esp32P4DsiVideoAcknowledge(arg,events)
    return -1
}
