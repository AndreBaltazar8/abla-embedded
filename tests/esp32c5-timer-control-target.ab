import "../src/esp32/timer_control_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_timer_control_target")
trusted fun timerTarget(unit: int,enable: bool,stall0: bool,stall1: bool,polls: int): int =
    if (esp32C5TimerConfigureLocked(unit,enable,stall0,stall1,polls)) esp32C5TimerTicks(unit,polls) else -4
