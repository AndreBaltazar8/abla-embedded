import "./sd-fifo-c61-model.ab"
import "../src/m5stack/corematrix_sd_sequence.ab"
val boardMemory=nativeStaticAllocate(40)
val sessionMemory=nativeStaticAllocate(64)
var powerCalls=0
var powerFail=false
var delayCalls=0
var retained=false
fun coreMatrixSdRetain(control: int): bool { if (control != 123 || retained) return false;retained=true;return true }
fun coreMatrixSdRelease(control: int): void { if (control != 123 || !retained) bad=true;retained=false;return }
fun coreMatrixSdControlAdmission(control: int,storage: NativeBuffer,session: NativeBuffer,
    gate: PeripheralGate,scratch: NativeBuffer,response: NativeBuffer): bool = control == 123
fun coreMatrixSdPower(control: int): int {
    powerCalls=powerCalls+1
    if (spiWrites != 0 || starts != 0 || control != 123) bad=true
    return if (powerFail) 260 else 769
}
fun coreMatrixSdDelay(us: int): void {
    if (powerCalls != 1 || us != 10000 || spiWrites != 0) bad=true
    delayCalls=delayCalls+1;return
}
@export("abla_corematrix_sd_test")
trusted fun testCoreMatrixSd(): i32 {
    val sd=m5CoreMatrixSdAt(nativeBufferAt(boardMemory,40));val sessionStorage=nativeBufferAt(sessionMemory,64)
    val gate=peripheralGateAt(gateStorage);val scratch=nativeBufferAt(buffers,2);val response=nativeBufferAt(buffers+4,16)
    val destination=nativeBufferAt(buffers+528,512)
    cardMode=0;resetCard();powerCalls=0;delayCalls=0
    if (!sd.initializeFresh() || !esp32C61SdSessionInitializeFresh(sessionStorage)) return i32(1)
    if (sd.openOwned(123,sessionStorage,gate,u32(7),160000000,scratch,response,10000,true) != 1 ||
        powerCalls != 1 || delayCalls != 1 || !sd.master().ready() || sd.session() == 0 || !retained || bad) return i32(2)
    val old=sd.session()
    if (!old.readBlock(u32(7),3,scratch,destination,4).valid() || bad) return i32(3)
    if (sd.closeOwned(u32(7),false) || !sd.closeOwned(u32(7),true) || sd.master() != 0 ||
        old.readBlock(u32(7),3,scratch,destination).status() != 2 || retained || bad) return i32(4)
    // Failed power phase must not open clocks/pins or start card negotiation.
    resetCard();powerCalls=0;delayCalls=0;powerFail=true
    if (sd.openOwned(123,sessionStorage,gate,u32(7),160000000,scratch,response,10000,true) != 3 ||
        delayCalls != 0 || spiWrites != 0 || starts != 0 || c61SdSessionLoad64(sd.buffer(),24) != 260 || !retained || bad) return i32(5)
    if (!sd.closeOwned(u32(7),true)) return i32(6)
    // Failed selected command retains master; close cannot stop active hardware.
    resetCard();powerCalls=0;delayCalls=0;powerFail=false;failAt=11;failureKind=1
    if (sd.openOwned(123,sessionStorage,gate,u32(7),160000000,scratch,response,10000,true) != 5 ||
        !sd.master().ready() || sd.closeOwned(u32(7),true) || sd.master() == 0 || !retained || bad) return i32(7)
    active=false
    // Closing retained owner is retryable after observed completion. It must
    // not silently clear the canonical bus fault while releasing resources.
    if (!sd.closeOwned(u32(7),true) || retained || gate.tryBegin(u32(8)) != 2 || bad) return i32(8)
    resetCard();powerCalls=0;delayCalls=0
    if (m5CoreMatrixSdAt(nativeBufferAt(boardMemory,32)) != 0) return i32(10)
    if (sd.openOwned(0,sessionStorage,gate,u32(7),160000000,scratch,response,10000,true) != 2 ||
        sd.openOwned(123,sessionStorage,gate,u32(7),160000000,nativeBufferAt(boardMemory,2),response,10000,true) != 2 ||
        powerCalls != 0 || spiWrites != 0 || bad) return i32(9)
    return i32(0)
}
