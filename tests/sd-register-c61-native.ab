import "./sd-fifo-c61-model.ab"
import "../src/sd/session_c61_sequence.ab"
val sessionMemory=nativeStaticAllocate(64)
fun sealRegister(offset: int): void {
    var crc=0;var at=0
    while (at < 15) { crc=sdSpiCrc7Byte(crc,nativeBufferAt(cardRegisters,32).load(offset+at));at=at+1 }
    nativeBufferAt(cardRegisters,32).store(offset+15,(crc<<1)|1);return
}
@export("abla_sd_register_c61_test")
trusted fun testRegisters(): i32 {
    cardMode=0;resetCard()
    val storage=nativeBufferAt(sessionMemory,64);val gate=peripheralGateAt(gateStorage)
    val scratch=nativeBufferAt(buffers,2);val response=nativeBufferAt(buffers+4,16);val output=nativeBufferAt(buffers+16,16)
    val registers=nativeBufferAt(cardRegisters,32)
    var at=0
    while (at < 32) { registers.store(at,0);at=at+1 }
    // SDXC maximum C_SIZE: preserve the full 2^32-sector result.
    registers.store(0,64);registers.store(5,9);registers.store(7,63);registers.store(8,255);registers.store(9,255)
    registers.store(16,27);registers.store(17,65);registers.store(18,66);registers.store(19,84)
    sealRegister(0);sealRegister(16)
    val master=openCardMaster()
    if (!esp32C61SdSessionInitializeFresh(storage)) return i32(1)
    var session=esp32C61SdSessionOpen(storage,master,gate,u32(7),160000000,scratch,response,4)
    if (session == 0 || !session.readRegister(u32(7),9,scratch,output,4).valid() || sdCsdBlockCount(output) != 4294967296 || bad) return i32(2)
    if (!session.readRegister(u32(7),10,scratch,output,4).valid() || output.load(0) != 27 || output.load(3) != 84 || bad) return i32(3)
    val before=starts
    if (session.readRegister(u32(7),17,scratch,output).status() != 2 ||
        session.readRegister(u32(7),9,scratch,nativeBufferAt(buffers+16,15)).status() != 2 || starts != before) return i32(4)
    // Corrupt embedded CRC while wire CRC16 remains correct.
    registers.store(15,registers.load(15)^2)
    val invalid=session.readRegister(u32(7),9,scratch,output,4)
    if (invalid.status() != 9 || invalid.receivedBytes() != 16 || storage.loadU32(12) != 3 || bad) return i32(5)
    sealRegister(0)
    if (!master.recover(gate,u32(8),true)) return i32(6)
    var failure=1
    // readiness+CMD9+token+16B+CRC+release =28 byte transfers.
    while (failure <= 28) {
        session=esp32C61SdSessionOpen(storage,master,gate,u32(7),160000000,scratch,response,4)
        if (session == 0) return i32(7)
        failAt=starts+failure;failureKind=1
        val result=session.readRegister(u32(7),9,scratch,output,4)
        if (result.valid() || !result.cleanupPending() || storage.loadU32(12) != 3 || bad) return i32(8)
        active=false;failAt=0
        if (!master.recover(gate,u32(8),true,true)) return i32(9)
        failure=failure+1
    }
    if (master.closeOwned(true) != 0 || bad) return i32(10)
    return i32(0)
}
