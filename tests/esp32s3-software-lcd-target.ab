import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/display/software_rgb565.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_software_lcd_test")
trusted fun softwareLcdTargetTest(gateAddress: u32, x: i32, y: i32, width: i32, height: i32, color: u32): int =
    softwareLcdFillRect(peripheralGateAt(int(gateAddress)), u32(7), pin(12), pin(11), pin(10), pin(9),
        lcdViewValue(320, 240, 0, 0, 0), int(x), int(y), int(width), int(height), Rgb565(int(color)), 1).status()
