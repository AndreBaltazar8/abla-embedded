import "../src/m5stack/detect_c6_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var sys3=u32(0)
var sys4=u32(0)
var reads=0
var bad=false
fun m5C6ReadIdentity(address: int): u32 {
    reads=reads+1
    if ((reads == 1 && address != 0x600b0850) || (reads == 2 && address != 0x600b0854) || reads > 2) bad=true
    return if (address == 0x600b0850) sys3 else sys4
}
@export("abla_board_detect_c6_test")
fun testC6(): i32 {
    var package=0
    while (package < 8) {
        var capacity=0
        while (capacity < 8) {
            var bit=0
            while (bit < 32) {
                sys3=u32((package<<24)|((1<<bit)&~(7<<24)))
                sys4=u32(capacity|((1<<bit)&~7))
                reads=0;bad=false
                val expected=if (package != 1) m5BoardUnknown else if (capacity == 2) m5BoardStampC6 else m5BoardNanoC6
                if (m5DetectCurrentEsp32C6() != expected || reads != (if (package == 1) 2 else 1) || bad) return i32(1)
                bit=bit+1
            }
            capacity=capacity+1
        }
        package=package+1
    }
    var selected=-1
    while (selected <= 513) {
        if (M5BoardId(selected) != m5BoardUnknown) {
            reads=0
            if (m5DetectCurrentEsp32C6(M5BoardId(selected)) != M5BoardId(selected) || reads != 0) return i32(2)
        }
        selected=selected+1
    }
    return i32(0)
}
