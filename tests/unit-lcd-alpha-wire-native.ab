import "./unit-lcd-pixels-wire-native.ab"
@export("abla_unit_lcd_alpha_wire_test")
trusted fun testLcdAlphaWire(): i32 {
    wireSeed();extraAddress=62;extraCanRead=true;extraReadValue=255
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val device=control.session().bus().device(62,100000)
    val source=nativeBufferAt(lcdMemory,8);val scratch=nativeBufferAt(lcdMemory+8,16)
    source.store(0,128);source.store(1,128);source.store(2,128);source.store(3,165)
    source.store(4,0);source.store(5,128);source.store(6,255);source.store(7,165)
    val e=nativeBufferAt(oledExpected,16384);val captured=nativeBufferAt(extraWire,8192)
    var colorBytes=1
    while (colorBytes <= 4) {
        val color=if (colorBytes == 1) 239 else if (colorBytes == 2) 52719 else if (colorBytes == 3) 11259375 else 2309737967
        var encoded=0
        while (encoded < 2) {
            expectedCount=0;var row=0
            while (row < 2) {
                expectedPages=row;expectedStage=3
                lcdExpectStart(124);expectByte(9);lcdExpectStart(125)
                expectedStage=7;lcdExpectStart(124);expectByte(80|colorBytes)
                var component=0;var remaining=color
                while (component < colorBytes) { expectByte(remaining&255);remaining=remaining>>>8;component=component+1 }
                expectedStage=5;lcdExpectStart(124);expectByte(42);expectByte(7);expectByte(9);expectByte(43);expectByte(5+row);expectByte(5+row)
                expectedStage=6;lcdExpectStart(124);expectByte(if (encoded == 1) 77 else 69)
                if (encoded == 1 && row == 0) { expectByte(3);expectByte(128) }
                else {
                    if (encoded == 1) { expectByte(0);expectByte(3) }
                    expectByte(if (row == 0) 128 else 0);expectByte(128);expectByte(if (row == 0) 128 else 255)
                }
                row=row+1
            }
            var failure=0
            while (failure <= expectedCount) {
                var commit=0
                while (commit < 2) {
                    val before=ackCount;extraCount=0;nackAfterCommit=commit == 1
                    nackAt=if (failure == 0) 0 else before+failure
                    val result=device.unitLcdWriteAlpha(7,5,3,2,0,source,4,color,colorBytes,scratch,1,encoded == 1)
                    val expected=if (failure == 0) 513 else e.load((failure-1)*4+2)|(e.load((failure-1)*4+3)<<8)
                    val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && e.load((failure-1)*4) > 1) 1 else 0)
                    if (result != expected || ackCount-before != (if (failure == 0) expectedCount else failure) || extraCount != accepted || bad || mode != 0) return i32(2)
                    var at=0;while (at < accepted) {
                        if (captured.load(at*2) != e.load(at*4) || captured.load(at*2+1) != e.load(at*4+1)) return i32(3)
                        at=at+1
                    }
                    commit=commit+1
                }
                failure=failure+1
            }
            encoded=encoded+1
        }
        colorBytes=colorBytes+1
    }
    nackAt=0;nackAfterCommit=false;val before=ackCount
    if (device.unitLcdWriteAlpha(7,5,3,2,0,source,4,256,1,scratch,1) != 2 || device.unitLcdWriteAlpha(7,5,3,2,0,source,4,-1,4,scratch,1) != 2 ||
        device.unitLcdWriteAlpha(7,5,3,2,0,source,4,0,0,scratch,1) != 2 || device.unitLcdWriteAlpha(7,5,3,2,0,source,4,0,5,scratch,1) != 2 ||
        device.unitLcdWriteAlpha(7,5,3,2,0,source,4,0,4,source,1) != 2 || ackCount != before) return i32(4)
    var at=0;while (at < 8) {
        if (source.load(at) != (if (at == 3 || at == 7) 165 else if (at == 4) 0 else if (at == 6) 255 else 128)) return i32(5)
        at=at+1
    }
    if (!device.close() || !control.closeOwned(true) || pads != 0 || bad) return i32(6)
    return i32(0)
}
