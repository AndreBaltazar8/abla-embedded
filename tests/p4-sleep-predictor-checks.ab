import "../src/esp32/power/sleep_predictor_p4_sequence.ab"
var predictorCsr=u32(0)
var predictorHart=u32(0)
var predictorWrites=0
var predictorDrop=0
fun p4SleepPredictorHart(): u32 = predictorHart
fun p4SleepPredictorRead(): u32 = predictorCsr
fun p4SleepPredictorClear(mask: u32): u32 {
    val old=predictorCsr;predictorWrites=predictorWrites+1
    if (predictorWrites != predictorDrop) predictorCsr=predictorCsr&~mask
    return old
}
fun p4SleepPredictorSet(mask: u32): u32 {
    val old=predictorCsr;predictorWrites=predictorWrites+1
    if (predictorWrites != predictorDrop) predictorCsr=predictorCsr|mask
    return old
}
fun sleepPredictorChecks(): int {
    var hart=0
    while (hart < 2) {
        var bits=0
        while (bits < 8) {
            var fault=0
            while (fault < 4) {
                val mask=u32(((bits&3)<<4)|((bits>>>2)<<12))
                predictorHart=u32(hart);predictorCsr=u32(0xabcde00f)|mask;predictorWrites=0;predictorDrop=if (fault == 1) 1 else 0
                val token=esp32p4SleepPredictorDisableOwned(true)
                if (!token.hasSnapshot() || token.status() != (if (fault == 1 && bits != 0) 3 else 1)) return 150
                val count=predictorWrites
                predictorHart=u32(1-hart)
                if (token.closeOwned(true) != token || predictorWrites != count) return 151
                predictorHart=u32(hart)
                if (token.closeOwned(false) != token || predictorWrites != count) return 152
                // Other MHCR controls change while the predictor lease lives.
                predictorCsr=predictorCsr^u32(0x80000001)
                predictorDrop=if (fault > 1) predictorWrites+fault-1 else 0
                val closed=token.closeOwned(true)
                if (closed.status() != (if (fault == 3 && bits != 0) 3 else 4)) return 153
                predictorDrop=0
                val finalToken=closed.closeOwned(true)
                if (finalToken.status() != 4 || predictorCsr != (u32(0x2bcde00e)|mask)) return 154
                val finalWrites=predictorWrites
                if (finalToken.closeOwned(true) != finalToken || predictorWrites != finalWrites) return 155
                fault=fault+1
            }
            bits=bits+1
        }
        hart=hart+1
    }
    predictorWrites=0;predictorHart=u32(2)
    if (esp32p4SleepPredictorDisableOwned(true).status() != 2 || esp32p4SleepPredictorDisableOwned(false).status() != 2 || predictorWrites != 0) return 156
    return 0
}
