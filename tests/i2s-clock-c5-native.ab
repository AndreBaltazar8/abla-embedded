import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/clock_c5_sequence.ab"
var bus=u32(0)
var tx=u32(0)
var rx=u32(0)
var writes=0
var drop=0
var busy=0
var bad=false
trusted fun c5I2sClockRead(offset: int): u32 = if (offset == 0) bus else if (offset == 4) tx else rx
trusted fun c5I2sClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes != drop) { if (offset == 0) bus=value else if (offset == 4) tx=value else if (offset == 12) rx=value else bad=true }
    return
}
trusted fun c5I2sRead(offset: int): u32 {
    if ((bus&u32(15)) != u32(13)) bad=true
    if (offset == 0x6c) return if (busy == 5) u32(0) else u32(1)
    if (offset == 0x14) return if (busy == 1) u32(1) else u32(0)
    if (offset == 0x20) return if (busy == 2) u32(4) else if (busy == 3) u32(256) else u32(0)
    if (offset == 0x24) return if (busy == 4) u32(4) else u32(0)
    bad=true;return u32(0)
}
@export("abla_i2s_clock_c5_test")
trusted fun test(): i32 {
    var sources=0
    while (sources < 16) {
        var directions=1
        while (directions < 4) {
            var borrowed=0
            while (borrowed < 8) {
                val oldBus=u32(0xa500000c)|u32(borrowed&1)
                val oldTx=u32(0x80003210)|(u32(sources&3)<<u32(20))|(u32((borrowed>>>1)&1)<<u32(22))
                val oldRx=u32(0x80002123)|(u32(sources>>>2)<<u32(20))|(u32((borrowed>>>2)&1)<<u32(22))
                var fault=0
                while (fault < 7) {
                    bus=oldBus;tx=oldTx;rx=oldRx;writes=0;drop=fault;bad=false
                    var owner=c5I2sClockOpenOwned(0,directions,sources&3,sources>>>2,2,true)
                    if (owner.ready() && (((directions&1) != 0 && (tx&u32(0x400000)) == u32(0)) || ((directions&2) != 0 && (rx&u32(0x400000)) == u32(0)))) return i32(1)
                    owner=owner.closeOwned(true);drop=0;owner=owner.closeOwned(true)
                    if (owner.status() != 0 || bus != oldBus || tx != oldTx || rx != oldRx || bad) return i32(2)
                    fault=fault+1
                }
                borrowed=borrowed+1
            }
            directions=directions+1
        }
        sources=sources+1
    }
    var blocked=1
    while (blocked <= 5) {
        bus=u32(12);tx=u32(0);rx=u32(0);writes=0
        var owner=c5I2sClockOpenOwned(0,3,0,0,2,true)
        busy=blocked
        val before=writes
        owner=owner.closeOwned(true)
        if (owner.status() != 6 || writes != before) return i32(3)
        busy=0;owner=owner.closeOwned(true)
        if (owner.status() != 0 || bus != u32(12) || tx != u32(0) || rx != u32(0)) return i32(4)
        blocked=blocked+1
    }
    bus=u32(0);writes=0
    var owner=c5I2sClockOpenOwned(0,3,0,0,2,true)
    if (owner.status() != 5 || bad) return i32(5)
    owner=owner.closeOwned(true)
    if (owner.status() != 0 || bus != u32(0)) return i32(6)
    writes=0
    if (c5I2sClockOpenOwned(1,3,0,0,2,true).status() != 2 || c5I2sClockOpenOwned(0,0,0,0,2,true).status() != 2 || c5I2sClockOpenOwned(0,3,0,0,2,false).status() != 2 || writes != 0) return i32(7)
    return i32(0)
}
