import "../src/esp32/watchdog/lp_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_watchdog_target")
trusted fun watchdogTarget(op: int,a: int,b: int,c: int): int {
    if (op == 0) return p4LpWatchdogConfigureStageOwned(a,b,c)
    if (op == 1) return p4LpWatchdogEnableOwned(a != 0,b != 0)
    if (op == 2) return p4LpWatchdogFeedOwned()
    if (op == 3) return p4LpWatchdogResetPolicyOwned((a&1) != 0,(a&2) != 0,(a&4) != 0,b,c)
    if (op == 4) return p4LpWatchdogInterruptEnabledOwned(a != 0)
    if (op == 5) return p4LpWatchdogInterruptAcknowledgeOwned()
    if (op == 6) return if (p4LpWatchdogInterruptPending()) 1 else 0
    return p4LpWatchdogState()
}
