import "../src/esp32/clock_park_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(48)
var sys=0
var cpu=0
var ahb=0
var writes=0
var failAt=0
var ticks=0
var pvtCalls=0
var pvtFail=false
var active=true
var bad=false
trusted fun c5CpuClockRead(offset: int): int {
    if (offset == 0x110) return sys
    if (offset == 0x118) return cpu
    if (offset == 0x11c) return ahb
    if (offset == 0x144) return 0
    bad=true;return 0
}
trusted fun c5CpuClockWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (offset == 0x110) sys=value
    else if (offset == 0x118) cpu=value
    else if (offset == 0x11c) ahb=value
    else if (offset != 0x144 || value != 1) bad=true
    return
}
trusted fun c5CpuClockTicks(mhz: int): void { ticks=ticks+1;if (mhz != ((sys>>>24)&127)) bad=true;return }
trusted fun c5ClockParkPvtActive(): bool = active
// PVT transport is modeled here; real PVT sequence has its own failure grid.
trusted fun c5ClockParkPvt(record: NativeBuffer): int {
    pvtCalls=pvtCalls+1
    if ((sys&0x30000) != 0 || cpu != 0 || ahb != 0 || ticks != 1 || record.addressValue() != memory+24) bad=true
    if (pvtFail) return 3
    1
}
@export("abla_clock_park_c5_test")
trusted fun test(): int {
    val record=nativeBufferAt(memory,48)
    var mode=0
    while (mode < 16) {
        var failure=0
        while (failure < 5) {
            var offset=0
            while (offset < 48) { record.storeU32(offset,0);offset=offset+4 }
            val source=mode&3;val xtal=if ((mode&4) == 0) 40 else 48;val usePvt=(mode&8) != 0
            sys=(xtal<<24)|(source<<16);cpu=1;ahb=if (source < 2) 1 else 7
            val original=esp32C5CpuClockCaptureOwned(true)|0
            writes=0;failAt=if (failure < 4) failure else 0;ticks=0;pvtCalls=0;pvtFail=failure == 4;bad=false
            val result=esp32C5ClockParkOwned(record,usePvt,true)
            if (result != 1 && result != 3 || bad || record.loadU32(12) != original) return 1
            val oldTicks=ticks;val oldPvt=pvtCalls;val oldWrites=writes
            if (esp32C5ClockParkOwned(record,!usePvt,true) != 2 || writes != oldWrites || esp32C5ClockParkOwned(record,usePvt,false) != 2) return 2
            failAt=0;pvtFail=false
            if (esp32C5ClockParkOwned(record,usePvt,true) != 1 || record.loadU32(12) != original || ticks != 1 || bad) return 3
            if (oldTicks == 1 && ticks != oldTicks) return 4
            val doneWrites=writes;val donePvt=pvtCalls
            if (esp32C5ClockParkOwned(record,usePvt,true) != 1 || writes != doneWrites || pvtCalls != donePvt) return 5
            failure=failure+1
        }
        mode=mode+1
    }
    record.storeU32(0,0);active=false;writes=0
    if (esp32C5ClockParkOwned(record,true,true) != 2 || writes != 0 || record.loadU32(0) != 0) return 6
    0
}
