import "./oled-wire-native.ab"
import "../src/display/unit_lcd_reset.ab"
val resetReply=nativeStaticAllocate(256)
var resetDelay=0
var resetAttempts=0
var resetReadyAt=1
fun unitLcdDelayMicroseconds(us: int): void {
    if (mode != 0) bad=true
    val reply=nativeBufferAt(resetReply,256)
    if (us == 300000) {
        if (resetDelay != 0 || resetAttempts != 0) bad=true
        reply.store(0,0);reply.store(3,91)
    } else if (us == 32000) {
        if (resetDelay != 300000+resetAttempts*32000) bad=true
        resetAttempts=resetAttempts+1
        reply.store(0,if (resetAttempts >= resetReadyAt) 119 else 0)
    } else bad=true
    resetDelay=resetDelay+us;return
}
fun resetExpectStart(address: int): void { transactionIndex=0;expectByte(address);return }
fun resetExpected(limit: int): void {
    expectedCount=0;expectedPages=0;expectedStage=3
    resetExpectStart(124);expectByte(4);resetExpectStart(125)
    expectedStage=4;resetExpectStart(124);expectByte(9);resetExpectStart(125)
    expectedStage=5;resetExpectStart(124);expectByte(255);expectByte(119);expectByte(137);expectByte(255)
    var attempt=1
    while (attempt <= limit) {
        expectedPages=attempt;expectedStage=6;resetExpectStart(124);expectByte(0);expectByte(0)
        expectedStage=7;resetExpectStart(124);expectByte(4);resetExpectStart(125)
        attempt=attempt+1
    }
    return
}
@export("abla_unit_lcd_reset_wire_test")
trusted fun testResetWire(): i32 {
    wireSeed();extraAddress=62;extraCanRead=true;extraReadValue=255;extraReadAddress=resetReply;extraReadCommand=4
    val reply=nativeBufferAt(resetReply,256);reply.store(1,137);reply.store(2,0)
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64));val scratch=nativeBufferAt(oledMemory,16)
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val device=control.session().bus().device(62,100000)
    val e=nativeBufferAt(oledExpected,16384);val captured=nativeBufferAt(extraWire,8192)
    resetExpected(1)
    var failure=0
    while (failure <= expectedCount) {
        var commit=0
        while (commit < 2) {
            reply.store(0,119);reply.store(3,90);resetDelay=0;resetAttempts=0;extraCount=0
            val before=ackCount;nackAfterCommit=commit == 1;nackAt=if (failure == 0) 0 else before+failure
            val result=device.unitLcdReset(scratch,true,1,1)
            val status=if (failure == 0) 1 else e.load((failure-1)*4+2)
            val attempts=if (failure == 0) 1 else e.load((failure-1)*4+3)
            val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && e.load((failure-1)*4) > 1) 1 else 0)
            val delay=if (failure > 0 && failure <= 6) 0 else 300000+attempts*32000
            if (result.status() != status || result.attempts() != attempts || result.firmware().valid() != (status == 1) || (status == 1 && result.firmware().value() != 91) ||
                ackCount-before != (if (failure == 0) expectedCount else failure) || extraCount != accepted || resetDelay != delay || bad || mode != 0) return i32(2)
            var at=0;while (at < accepted) {
                if (captured.load(at*2) != e.load(at*4) || captured.load(at*2+1) != e.load(at*4+1)) return i32(3)
                at=at+1
            }
            commit=commit+1
        }
        failure=failure+1
    }
    nackAt=0;nackAfterCommit=false
    var limit=1
    while (limit <= 8) {
        resetReadyAt=1
        while (resetReadyAt <= limit+1) {
            resetDelay=0;resetAttempts=0;extraCount=0;reply.store(0,119);reply.store(3,90)
            val attempts=if (resetReadyAt <= limit) resetReadyAt else limit
            resetExpected(attempts)
            val before=ackCount
            val result=device.unitLcdReset(scratch,true,1,limit)
            val success=resetReadyAt <= limit
            if (result.status() != (if (success) 1 else 7) || result.attempts() != attempts || result.firmware().valid() != success || (success && result.firmware().value() != 91) ||
                ackCount-before != expectedCount || extraCount != expectedCount || resetDelay != 300000+attempts*32000 || bad || mode != 0) return i32(4)
            var at=0;while (at < expectedCount) {
                if (captured.load(at*2) != e.load(at*4) || captured.load(at*2+1) != e.load(at*4+1)) return i32(5)
                at=at+1
            }
            resetReadyAt=resetReadyAt+1
        }
        limit=limit+1
    }
    if (!device.close() || !control.closeOwned(true) || pads != 0 || bad) return i32(6)
    return i32(0)
}
