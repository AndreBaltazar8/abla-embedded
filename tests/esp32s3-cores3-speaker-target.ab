import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/cores3_speaker.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun cores3SpeakerTarget(amplifier: u32, expander: u32, rate: i32, enabled: bool): int {
    val amp = Aw88298(int(amplifier))
    val pins = Aw9523(int(expander))
    val result = if (enabled) cores3SpeakerEnable(amp, pins, int(rate)) else cores3SpeakerDisable(amp, pins)
    result.status() | (if (result.cleanupAttempted()) 256 else 0) |
        (if (result.amplifierDisableFailed()) 512 else 0) | (if (result.enableClearFailed()) 1024 else 0)
}
#exportFunction("cores3SpeakerTarget", "abla_s3_cores3_speaker_test")
