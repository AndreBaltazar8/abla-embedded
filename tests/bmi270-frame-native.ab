import "../src/imu/bmi270_frame.ab"
import "../src/imu/bmi270_snapshot.ab"
import "../src/m5stack/imu_update.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
var status=0
var failure=0
var reads=0
var bursts=0
var bad=false
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    reads=reads+1
    if (this != 7 || register != 29) bad=true
    I2cByteResult(if (failure == 1) 0 else 256|status)
}
trusted fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,count: int): bool {
    bursts=bursts+1
    if (this != 7 || register != 4 || count != 20 || reads != 1) bad=true
    var offset=0
    while (offset < (if (failure == 2) 10 else 20)) {
        buffer.storeU16(offset,32769+offset*271)
        offset=offset+2
    }
    failure != 2
}
@export("abla_bmi270_frame_test")
trusted fun frameTest(): i32 {
    val frame=nativeBufferAt(nativeStaticAllocate(20),20)
    val storage=nativeBufferAt(nativeStaticAllocate(44),44)
    val snapshot=imuSnapshotAt(storage)
    while (status < 256) {
        failure=0
        while (failure < 3) {
            reads=0; bursts=0; bad=false
            if (!snapshot.initialize() || !snapshot.commit(7,imuAxes(1,2,3),imuAxes(1,2,3),imuAxes(1,2,3),17)) return i32(4)
            val result=snapshot.updateBmi270(I2cDevice(7),frame,4294967297)
            val mask=((status>>>7)&1)|((status>>>5)&2)|((status>>>3)&4)
            val expected=if (failure == 1 || (failure == 2 && mask != 0)) -2 else mask
            if (result != expected || reads != 1 || bursts != (if (failure == 1 || mask == 0) 0 else 1) || bad) return i32(1)
            var checked=0
            while (checked < 3) {
                val fresh=result > 0 && (result & (1<<checked)) != 0
                if (snapshot.axes(checked) != (if (fresh) bmi270FrameAxes(frame,checked) else imuAxes(1,2,3)) ||
                    snapshot.timestamp(checked) != (if (fresh) 1 else 17)) return i32(5)
                checked=checked+1
            }
            if (result > 0) {
                var sensor=0
                while (sensor < 3) {
                    val axes=bmi270FrameAxes(frame,sensor)
                    val base=if (sensor == 0) 8 else if (sensor == 1) 14 else 0
                    var axis=0
                    while (axis < 3) {
                        val raw=32769+(base+axis*2)*271-65536
                        val decoded=if (sensor != 2) raw else if (axis < 2) raw>>2 else imuSigned16(raw & 65534)
                        if (!axes.valid() || axes.axis(axis) != decoded) return i32(2)
                        axis=axis+1
                    }
                    sensor=sensor+1
                }
            }
            failure=failure+1
        }
        status=status+1
    }
    reads=0; bursts=0
    status=32; failure=0
    val motionOnly=M5ImuProbeResult((1<<48)|(3<<42)|(105<<35)|(4<<32)|7)
    if (!motionOnly.ready() || motionOnly.updateSnapshot(snapshot,frame,99) != 0 ||
        snapshot.axes(2) != imuAxes(1,2,3) || snapshot.timestamp(2) != 17) return i32(8)
    reads=0; bursts=0
    if (M5ImuProbeResult(1<<48).updateSnapshot(snapshot,frame,99) != -1 || reads != 0 || bursts != 0) return i32(9)
    if (snapshot.updateBmi270(I2cDevice(7),nativeBufferAt(storage.addressValue()+4,20),0) != -1 ||
        snapshot.commit(3,imuAxes(5,6,7),invalidImuAxes(),invalidImuAxes(),99) || reads != 0 || bursts != 0) return i32(6)
    if (snapshot.axes(0) != imuAxes(1,2,3) || snapshot.timestamp(0) != 17 ||
        snapshot.axes(1) != imuAxes(1,2,3) || snapshot.timestamp(1) != 17) return i32(7)
    if (I2cDevice(7).readBmi270Frame(nativeBufferAt(frame.addressValue(),19)) != -1 || reads != 0 || bursts != 0 ||
        bmi270FrameAxes(frame,3).valid() || bmi270FrameAxes(nativeBufferAt(0,20),0).valid()) return i32(3)
    i32(0)
}
