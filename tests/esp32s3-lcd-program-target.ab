import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/display/software_program.ab"
import "../src/display/mipi_programs.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_lcd_program_test")
trusted fun lcdProgramTargetTest(gateAddress: u32, programAddress: u32, length: i32): int {
    val program = if (length == -1) st7789InitProgram()
        else if (length == -2) st7735SInitProgram()
        else if (length == -3) ili9342InitProgram()
        else if (length == -4) ili9342EInitProgram()
        else nativeBufferAt(int(programAddress), int(length))
    softwareLcdRunProgram(peripheralGateAt(int(gateAddress)), u32(7), pin(12), pin(11), pin(10), pin(9),
        program, program.capacity(), 1).status()
}
