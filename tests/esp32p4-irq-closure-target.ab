import "../src/display/dsi_irq_owner_esp32p4.ab"
import "../src/esp32/irq_vectors_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
// Link-only closure root. Caller-supplied local vectors, other registered
// handlers, stack and mailbox/table RAM require application-level validation.
@export("abla_p4_irq_closure_target")
trusted fun target(box: P4DsiMailbox,table: P4IrqDispatch,vectors: NativeBuffer,local: NativeBuffer,
    expectedMtvec: u32,expectedMtvt: u32,operation: int,lease: int): int {
    if (operation == 0) return esp32P4IrqPrepareTableOwned(vectors,local)
    if (operation == 1) return table.publishOwned()
    if (operation == 2) return esp32P4ClicInstallVectorsOwned(esp32P4IrqEntryAddress(),vectors,expectedMtvec,expectedMtvt)
    if (operation == 3) return esp32P4DsiIrqOpenOwned(box,table,3)
    if (operation == 4) return esp32P4DsiIrqCloseOwned(box,table,lease)
    return esp32P4IrqConfigAddress()
}
