import "../src/m5stack/button_state.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_m5_button_state_test")
fun stateTest(): i32 {
    var button=m5Button()
    val pressed=m5ButtonRead(true,true)
    val released=m5ButtonRead(true,false)
    val missing=m5ButtonRead(false)
    button=button.updateFrom(pressed,0).updateFrom(pressed,10)
    if (!button.sampleValid() || !button.state().wasPressed()) return i32(1)
    button=button.updateFrom(missing,10000)
    if (button.sampleValid() || !button.state().isPressed() || button.state().wasPressed() || button.state().wasHold()) return i32(2)
    button=button.updateFrom(pressed,20000)
    if (!button.sampleValid() || button.state().wasHold() || button.state().durationMilliseconds() != 0) return i32(3)
    button=button.updateFrom(pressed,20499)
    if (button.state().wasHold()) return i32(4)
    button=button.updateFrom(pressed,20500)
    if (!button.state().wasHold() || !button.state().isHolding()) return i32(5)
    button=button.updateFrom(missing,30000).updateFrom(pressed,40000)
    if (button.state().wasHold() || !button.state().isHolding()) return i32(6)
    button=button.updateFrom(released,40001).updateFrom(missing,40009).updateFrom(released,50000)
    if (button.state().wasReleased() || !button.state().isPressed()) return i32(7)
    button=button.updateFrom(released,50010)
    if (!button.state().wasReleased() || button.state().wasClicked()) return i32(8)
    var normal=m5Button(false,0)
    var plain=buttonState(false,0)
    normal=normal.updateFrom(released,0)
    var tick=1
    while (tick < 3000) {
        val down=tick%700 < 300
        normal=normal.updateFrom(m5ButtonRead(true,down),tick)
        plain=plain.update(down,tick)
        if ((normal.state() | 0) != (plain | 0)) return i32(9)
        tick=tick+1
    }
    var click=m5Button().updateFrom(pressed,0).updateFrom(pressed,10).updateFrom(released,20).updateFrom(released,30)
    if (!click.state().wasClicked()) return i32(10)
    click=click.updateFrom(missing,300).updateFrom(released,10000)
    if (click.state().wasClicked() || click.state().wasDecideClickCount()) return i32(11)
    click=click.updateFrom(released,10250)
    if (!click.state().wasSingleClicked()) return i32(12)
    click=click.updateFrom(missing,10251)
    if (click.state().wasDecideClickCount() || click.state().getClickCount() != 0) return i32(13)
    if (normal.updateFrame(m5ButtonFrame(),7,4000).sampleValid()) return i32(14)
    i32(0)
}
