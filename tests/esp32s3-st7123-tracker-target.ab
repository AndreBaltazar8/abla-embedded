import "../src/esp32/i2c_esp32s3.ab"
import "../src/input/touch_st7123.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_st7123_tracker_target")
trusted fun target(touch: St7123,tracker: TouchTracker10,snapshot: NativeBuffer,frame: NativeBuffer,now: int,rotation: int): int =
    tracker.updateSt7123(touch,snapshot,frame,now,720,1280,rotation)
