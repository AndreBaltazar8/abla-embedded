import "../src/sd/mmc_command_esp32s3.ab"
import "../src/sd/mmc_host_clock_s3_sequence.ab"
import "../src/sd/mmc_frequency.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_identification_target")
trusted fun target(slot: int,sourceHz: int,timeout: int,exclusive: bool): int = sdMmcHostIdentificationConfigureOwned(slot,sdMmcFrequency(sourceHz,400000).actualHzCeiling(),timeout,exclusive)
