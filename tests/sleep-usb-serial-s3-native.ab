import "../src/esp32/power/sleep_usb_serial_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var clk=0
var rst=0
var conf=0
var writes=0
var resets=0
var bad=false
fun esp32S3SleepUsbRead(address: int): int {
    if (address == 0x600C001C) return clk
    if (address == 0x600C0024) return rst
    if (address != 0x60038018 || (clk & 1024) == 0 || (rst & 1024) != 0) bad=true
    conf
}
fun esp32S3SleepUsbWrite(address: int,value: int): void {
    if (address == 0x600C001C) { if ((clk & ~1024) != (value & ~1024)) bad=true; clk=value }
    else if (address == 0x600C0024) {
        if ((rst & ~1024) != (value & ~1024) || (clk & 1024) == 0) bad=true
        if ((value & 1024) != 0) { resets=resets+1; conf=0x4200 }
        rst=value
    } else {
        if (address != 0x60038018 || (clk & 1024) == 0 || (rst & 1024) != 0 || (conf & ~16384) != (value & ~16384)) bad=true
        conf=value
    }
    writes=writes+1; return
}
@export("abla_sleep_usb_serial_test")
trusted fun usbTest(): i32 {
    var p=0
    while (p < 128) {
        val clockOn=(p & 1) != 0
        val held=(p & 2) != 0
        val pad=(p & 4) != 0
        val other=(p>>>3)*0x10201
        clk=(other & ~1024) | (if (clockOn) 1024 else 0)
        rst=(other & ~1024) | (if (held) 1024 else 0)
        conf=(other & ~16384) | (if (pad) 16384 else 0)
        writes=0; resets=0; bad=false
        val enabled=clockOn && !held
        val saved=esp32S3SleepUsbSerialPrepareOwned()
        if ((saved | 0) != (4 | (if (enabled) 1 else 0) | (if (enabled && pad) 2 else 0))) return i32(1)
        if (bad || (clk & 1024) != 0 || (rst & 1024) != 0 || (conf & 16384) != 0 || resets != (if (enabled) 0 else 1) || writes != (if (enabled) 2 else 5)) return i32(2)
        val before=writes
        clk=clk | 1024
        if (esp32S3SleepUsbSerialRestoreOwned(saved) || writes != before) return i32(3)
        clk=clk & ~1024; rst=rst | 1024
        if (esp32S3SleepUsbSerialRestoreOwned(saved) || writes != before) return i32(4)
        rst=rst & ~1024
        if (!esp32S3SleepUsbSerialRestoreOwned(saved) || bad || ((clk & 1024) != 0) != enabled || ((conf & 16384) != 0) != (enabled && pad)) return i32(5)
        p=p+1
    }
    writes=0
    if (esp32S3SleepUsbSerialRestoreOwned(Esp32S3SleepUsbSerial(6)) || writes != 0) return i32(6)
    i32(0)
}
