import "../src/esp32/i2c/lp_close_devices_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(128)
var outcome=1
var calls=0
var bad=false
trusted fun c5LpI2cBusAbortSetup(): int {
    if (nativeAddressLoadU32(storage,12) != 2) bad=true
    closeHardware()
}
trusted fun c5LpI2cBusSetup(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int = 7
trusted fun c5LpI2cBusTeardown(sda: int,scl: int): int {
    if (nativeAddressLoadU32(storage,12) == 2 || sda != 2 || scl != 3) bad=true
    closeHardware()
}
trusted fun closeHardware(): int {
    calls=calls+1
    val token=atomicU32At(storage).compareExchange(u32(0),u32(0))
    if (token != u32(7) && token != u32(0x80000007)) bad=true
    if (i2cDeviceSlotsAt(storage+64).resolve(256) != 0) bad=true
    outcome
}
@export("abla_c5_lp_i2c_close_devices_test")
trusted fun closeTest(): i32 {
    val state=esp32C5LpI2cBusStateAt(nativeBufferAt(storage,64))
    var profile=0
    while (profile < 20) {
        state.initialize(); state.buffer().storeU32(8,2); state.buffer().storeU32(12,1)
        state.buffer().storeU32(16,2); state.buffer().storeU32(20,3)
        val pool=i2cInitializeDeviceSlots(storage+64,2)
        val first=pool.allocate(esp32S3I2cDeviceKey(1,73,400000,2))
        val stale=pool.allocate(esp32S3I2cDeviceKey(1,74,100000,1))
        outcome=profile%5+1; calls=0; bad=false
        val faulted=profile/5%2 == 1
        val partial=profile/10 == 1
        if (faulted) nativeAddressStoreU32(storage,0,2147483648)
        if (partial) state.buffer().storeU32(12,2)
        if (state.closeDevicesOwned(pool,u32(7),1) || calls != 0 || pool.resolve(first) == 0) return i32(1)
        val epoch=if (partial) 0 else 2
        if (state.closeDevicesOwned(pool,u32(7),epoch) != (outcome == 1) || calls != 1 || bad ||
            pool.resolve(first) != 0 || pool.resolve(stale) != 0) return i32(2)
        if (atomicU32At(storage).compareExchange(u32(0),u32(0)) != (if (outcome == 1) u32(0) else u32(0x80000000))) return i32(3)
        if (outcome != 1) {
            outcome=1
            if (!state.closeDevicesOwned(pool,u32(7),epoch) || calls != 2 || bad) return i32(4)
        }
        if (!state.closeDevicesOwned(pool,u32(7),2) || state.phase() != 0) return i32(5)
        profile=profile+1
    }
    state.initialize(); state.buffer().storeU32(8,2); state.buffer().storeU32(12,1)
    val pool=i2cInitializeDeviceSlots(storage+64,2)
    val handle=pool.allocate(esp32S3I2cDeviceKey(1,73,400000,2))
    calls=0
    nativeAddressStoreU32(storage+64,0,1)
    if (state.closeDevicesOwned(pool,u32(7),2) || calls != 0 || state.phase() != 1) return i32(6)
    nativeAddressStoreU32(storage+64,0,0)
    if (pool.resolve(handle) == 0 || state.closeDevicesOwned(pool,u32(7),0) || calls != 0) return i32(7)
    // Revocation must never consume HP descriptors, even if incorrectly put
    // into the dedicated pool by the caller.
    state.buffer().storeU32(16,2); state.buffer().storeU32(20,3)
    val foreign=pool.allocate(esp32S3I2cDeviceKey(0,75,100000,2))
    outcome=1; bad=false
    if (foreign == 0 || !state.closeDevicesOwned(pool,u32(7),2) ||
        pool.resolve(foreign) == 0 || pool.resolve(handle) != 0 || bad) return i32(8)
    i32(0)
}
