import "../src/text/utf8.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_utf8_test")
trusted fun utf8Test(): i32 {
    val input=nativeBufferAt(nativeStaticAllocate(8),8)
    val output=nativeBufferAt(nativeStaticAllocate(8),8)
    var point=0
    while (point <= 0x10FFFF) {
        if (point < 0xD800 || point > 0xDFFF) {
            val bytes=if (point < 128) 1 else if (point < 2048) 2 else if (point < 65536) 3 else 4
            var value=point; var index=bytes-1
            while (index > 0) { input.store(index,128+value%64); value=value/64; index=index-1 }
            input.store(0,value+(if (bytes == 1) 0 else if (bytes == 2) 192 else if (bytes == 3) 224 else 240))
            val scalar=utf8ScalarAt(input,0,bytes)
            output.storeU32(4,0x12345678)
            if (!scalar.valid() || scalar.value() != point || scalar.bytes() != bytes ||
                utf8ToUtf16(input,bytes,output) != (if (point < 65536) 1 else 2) || output.loadU32(4) != 0x12345678) return i32(1)
            val restored=if (point < 65536) output.loadU16(0) else 65536+(output.loadU16(0)-0xD800)*1024+output.loadU16(2)-0xDC00
            if (restored != point) return i32(2)
            if (bytes > 1 && utf8ScalarAt(input,0,bytes-1).valid()) return i32(3)
        }
        point=point+1
    }
    // Exhaust all three-byte payloads: isolates overlong and surrogate forms.
    point=0
    while (point < 65536) {
        input.store(0,224+(point>>>12)); input.store(1,128+((point>>>6)&63)); input.store(2,128+(point&63))
        val accepted=point >= 2048 && (point < 0xD800 || point > 0xDFFF)
        if (utf8ScalarAt(input,0,3).valid() != accepted) return i32(4)
        point=point+1
    }
    input.store(0,65); input.store(1,255); output.storeU32(0,0x87654321)
    if (utf8ToUtf16(input,2,output) != -1 || output.loadU32(0) != 0x87654321 ||
        utf8ToUtf16(input,1,nativeBufferAt(output.addressValue(),1)) != -1 ||
        utf8ToUtf16(input,1,input) != -1 || utf8ToUtf16(NativeBuffer(0),0,NativeBuffer(0)) != 0) return i32(5)
    i32(0)
}
