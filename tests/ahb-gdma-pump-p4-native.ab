import "../src/esp32/ahb_gdma_pump_p4_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
var tx=false
var channel=0
var index=0
var size=64
var acquired=1 | (64 << 16)
var rearm=65537
var step=0
var copied=0
var bad=false
trusted fun p4AhbDescriptorWrite(address: int,value: int): void { bad=true;return }
trusted fun p4AhbPumpAcquire(c: int,t: bool,d: int,n: int,b: int,s: int,bytes: int,i: int,p: int): int {
    if (step != 0 || c != channel || t != tx || d != 0x4ff00000 || n != 3 || b != 0x4ff40000 ||
        s != 128 || bytes != size || i != index || p != 7) bad=true
    step=1;return acquired
}
trusted fun p4AhbPumpCopy(destination: int,source: int,bytes: int): void {
    if (step != 1 || destination != (if (tx) 0x4ff40000+index*128 else 0x20000001) ||
        source != (if (tx) 0x20000001 else 0x4ff40000+index*128) || bytes != ((acquired >>> 16)&4095)) bad=true
    step=2;copied=bytes;return
}
trusted fun p4AhbPumpRearm(d: int,n: int,b: int,s: int,bytes: int,i: int,t: bool,p: int): int {
    if (step != 2 || d != 0x4ff00000 || n != 3 || b != 0x4ff40000 || s != 128 || bytes != size || i != index || t != tx || p != 7) bad=true
    step=3;return rearm
}
trusted fun run(): Esp32P4AhbGdmaPumpResult {
    step=0;copied=0;bad=false
    return esp32p4AhbGdmaPumpBlockOwned(channel,tx,0x4ff00000,3,0x4ff40000,128,size,index,nativeBufferAt(0x20000001,128),7,true)
}
@export("abla_ahb_gdma_pump_p4_test")
trusted fun test(): i32 {
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction==1;index=0
            while (index < 3) {
                size=1
                while (size <= 128) {
                    acquired=1|(size << 16)|(3 << 32);rearm=65537
                    val result=run()
                    if (result.status() != 1 || result.copiedBytes() != size || !result.ownershipMayHaveTransferred() ||
                        result.events() != 3 || result.cacheStatus() != 0 || step != 3 || copied != size || bad) return i32(1)
                    size=size+1
                }
                size=64
                var status=2
                while (status <= 7) {
                    acquired=status|(5 << 8)|(128 << 32)
                    val result=run()
                    if (result.status() != (if (status == 3) 3 else 4) || step != 1 || copied != 0 ||
                        result.events() != 128 || (status != 3 && (result.detail() != status || result.cacheStatus() != 5)) || bad) return i32(2)
                    status=status+1
                }
                acquired=1|(64 << 16)|(3 << 32)
                status=2
                while (status <= 6) {
                    rearm=status|(5 << 8)|(if (status == 6) 65536 else 0)
                    val result=run()
                    if (result.status() != 5 || result.detail() != status || result.cacheStatus() != 5 || result.copiedBytes() != 64 ||
                        result.ownershipMayHaveTransferred() != (status == 6) || step != 3 || copied != 64 || bad) return i32(3)
                    status=status+1
                }
                rearm=65537;acquired=1|(32 << 16)
                val partial=run()
                if (partial.status() != (if (tx) 4 else 1) || copied != (if (tx) 0 else 32) || bad) return i32(4)
                index=index+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    step=0
    if (esp32p4AhbGdmaPumpBlockOwned(0,false,0x4ff00000,3,0x4ff40000,128,64,0,nativeBufferAt(0x4ff00040,64),7,true).status() != 2 ||
        esp32p4AhbGdmaPumpBlockOwned(0,false,0x4ff00000,3,0x4ff40000,128,64,0,nativeBufferAt(0x4ff40040,64),7,true).status() != 2 ||
        esp32p4AhbGdmaPumpBlockOwned(0,false,0x4ff00000,3,0x4ff40000,128,64,0,nativeBufferAt(0x20000000,63),7,true).status() != 2 ||
        esp32p4AhbGdmaPumpBlockOwned(0,false,0x4ff00000,3,0x4ff40000,128,64,0,nativeBufferAt(0x20000000,64),7,false).status() != 2 || step != 0) return i32(5)
    return i32(0)
}
