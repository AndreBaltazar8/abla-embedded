import "../src/esp32/psram/timing_candidate_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val tcRegisters=nativeStaticAllocate(20)
var tcDummy=0
var tcPointer=0x3fc90000
var tcWrites=0
var tcFail=0
var tcBusy=0
var tcBad=false
fun s3FlashLegacyPointer(): int = tcPointer
fun s3FlashDummyByteRead(address: int): int {
    if (address != 0x3fc90019) tcBad=true
    return tcDummy
}
fun s3FlashDummyByteWrite(address: int,value: int): void {
    if (address != 0x3fc90019) tcBad=true
    tcWrites=tcWrites+1;tcDummy=if (tcWrites == tcFail) value^1 else value;return
}
fun tcSlot(address: int): int = if (address == 0x600030c0) 0 else if (address == 0x600030c4) 1 else if (address == 0x600020a8) 2 else if (address == 0x60002018) 3 else if (address == 0x6000201c) 4 else -1
fun s3PsramCsRead(address: int): int {
    if (address == 0x60002000) return if (tcBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (tcBusy == 2) 0x80000000 else 0
    val slot=tcSlot(address)
    if (slot < 0) { tcBad=true;return 0 }
    return nativeAddressLoadU32(tcRegisters,slot*4)
}
fun s3PsramCsWrite(address: int,value: int): void {
    val slot=tcSlot(address)
    if (slot < 0) { tcBad=true;return }
    if ((tcWrites == 0 && slot != 0) || (tcWrites == 1 && slot != 1)) tcBad=true
    tcWrites=tcWrites+1
    nativeAddressStoreU32(tcRegisters,slot*4,if (tcWrites == tcFail) value^1 else value);return
}
@export("abla_s3_psram_timing_candidate_test")
fun testCandidate(): int {
    var profile=0
    while (profile < 512) {
        val mode=profile&7;val number=(profile>>>3)&3;val extra=(profile>>>5)&7;val octal=(profile&256) != 0
        val count=4
        tcFail=0
        while (tcFail <= count) {
            val prior=0xa55a5aa5^(profile*65537)
            var i=0
            while (i < 5) { nativeAddressStoreU32(tcRegisters,i*4,prior);i=i+1 }
            tcDummy=3;tcWrites=0;tcBusy=0;tcBad=false
            if (s3PsramTimingCandidateOwned(mode,number,extra,octal,5,2,3,true) != (if (tcFail == 0) 1 else 4) ||
                tcBad || tcWrites != (if (tcFail == 0) count else tcFail)) return 1
            if (tcFail == 0) {
                var lane=0
                val dm=nativeAddressLoadU32(tcRegisters,0);val dn=nativeAddressLoadU32(tcRegisters,4)
                while (lane < 9) {
                    if (((dm>>>(lane*3))&7) != mode || ((dn>>>(lane*2))&3) != number) return 2
                    lane=lane+1
                }
                if ((dm&0xf8000000) != (prior&0xf8000000) || (dn&0xfffc0000) != (prior&0xfffc0000)) return 3
                if (tcDummy != 3 || nativeAddressLoadU32(tcRegisters,12) != prior || nativeAddressLoadU32(tcRegisters,16) != prior ||
                    nativeAddressLoadU32(tcRegisters,8) != ((prior&0xffffffe1)|(extra<<2)|(if (extra == 0) 0 else 2))) return 4
            }
            tcFail=tcFail+1
        }
        profile=profile+1
    }
    tcWrites=0;tcPointer=0;tcFail=0
    if (s3PsramTimingCandidateOwned(0,0,0,false,5,2,3,true) != 1 || tcWrites != 4) return 6
    tcWrites=0
    tcPointer=0x3fc90000
    if (s3PsramTimingCandidateOwned(8,0,0,true,5,2,3,true) != 2 ||
        s3PsramTimingCandidateOwned(0,0,7,false,63,2,3,true) != 2 ||
        s3PsramTimingCandidateOwned(0,0,0,true,5,2,3,false) != 2 || tcWrites != 0) return 7
    tcBusy=1
    if (s3PsramTimingCandidateOwned(0,0,0,true,5,2,3,true) != 3 || tcWrites != 0) return 8
    tcBusy=2
    if (s3PsramTimingCandidateOwned(0,0,0,true,5,2,3,true) != 3 || tcWrites != 0) return 9
    return 0
}
