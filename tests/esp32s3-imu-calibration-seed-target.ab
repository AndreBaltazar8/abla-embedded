import "../src/imu/snapshot_calibration.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_calibration_seed_target")
trusted fun seedTarget(state: ImuCalibration,snapshot: ImuSnapshot,offsets: ImuOffsets,fresh: int,initialized: int): int =
    state.seedSnapshot(snapshot,offsets,fresh,initialized)
