import "../src/esp32/medium_vectors_esp32s3.ab"
import "../src/esp32/user_vector_esp32s3.ab"
import "../src/esp32/fatal_vectors_esp32s3.ab"
import "../src/esp32/high_vectors_esp32s3.ab"
import "../src/esp32/vectors_esp32s3.ab"
import "../src/esp32/vector_activate_esp32s3.ab"
import "../src/esp32/window_vectors_esp32s3.ab"
import "../src/esp32/irq_runtime_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_irq_vectors_target")
@section(".iram1.abla.s3IrqVectorsTarget")
trusted fun irqVectorsTarget(stack: NativeBuffer,table: NativeBuffer,record: NativeBuffer,core: int,fault: int,context: int,mode: int): int {
    if (mode == 0) return esp32S3WindowVectorsAddress()
    if (mode == 1) return esp32S3UserVectorAddress()
    if (mode == 4) return if (esp32S3ExceptionHandlerInstallOwned(core,fault,context)) 1 else 0
    if (mode == 5) return if (esp32S3ExceptionHandlerRemoveOwned(core,fault,context)) 1 else 0
    if (mode == 2) return esp32S3Level2VectorAddress()
    if (mode == 3) return esp32S3Level3VectorAddress()
    if (mode == 6) return esp32S3KernelVectorAddress()
    if (mode == 7) return esp32S3DoubleVectorAddress()
    if (mode == 8) return esp32S3FatalRecordsAddress()
    if (mode == 9) return esp32S3Level4VectorAddress()
    if (mode == 10) return esp32S3Level5VectorAddress()
    if (mode == 11) return esp32S3Level6VectorAddress()
    if (mode == 12) return esp32S3Level7VectorAddress()
    if (mode == 13) return esp32S3VectorsAddress()
    if (mode == 14) return if (esp32S3VectorsActivateOwned(core)) 1 else 0
    if (esp32S3IrqRuntimeInitializeOwned(stack,table,record,core,fault,context)) return 1
    return 0
}
