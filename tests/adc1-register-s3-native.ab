import "../src/esp32/adc_power_s3_sequence.ab"
import "../src/esp32/adc_bus_s3_sequence.ab"
import "../src/esp32/adc1_config_s3_sequence.ab"
import "../src/esp32/adc1_pins_s3_sequence.ab"
import "../src/esp32/adc_analog_s3_sequence.ab"
import "../src/esp32/adc1_session_s3_sequence.ab"
import "../src/esp32/adc1_session_s3_guard.ab"
import "abla/runtime/scalar"
import "abla/build"
// Actual production algorithms, mocked hardware boundaries only.
var pin=1
var writes=0
var drop=0
var complete=true
var raw=1234
var bad=false
var hi=0xf0
var lo=0
var ref=255
var ground=255
var clock=0x80000055
var power=0xc00000aa
var busA=0xa50000aa
var busB=0xa50400aa
var busC=0xa50000aa
var control=0x300000fe
var sample=0
var atten=0xffffffff
var digital=0xffffffff
var rtc=0xffffffff
var route=0xfab
var mux=0xffff
var pad=0xb82fe000
fun modelRead(address: int): int {
    if (address == 0x60008904) return clock
    if (address == 0x6000883c) return power
    if (address == 0x60008034) return busA
    if (address == 0x6000e044) return busB
    if (address == 0x6000e048) return busC
    if (address == 0x60008800) return control
    if (address == 0x6000880c) return sample
    if (address == 0x60008814) return atten
    if (address == 0x60004020) return digital
    if (address == 0x6000840c) return rtc
    if (address == 0x60004554+pin*4) return route
    if (address == 0x60009004+pin*4) return mux
    if (address == 0x60008484+pin*4) return pad
    if (address == 0x60008810 || address == 0x60008840 || address == 0x60008830 || address == 0x600080d8 || address == 0x60008088 || address == 0x60008094) return 0
    bad=true; return 0
}
fun modelWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x60004028) { digital=digital&(4294967295^value); return }
    if (address == 0x60008414) { rtc=rtc&(4294967295^value); return }
    if (address == 0x6000880c) {
        sample=value
        if ((value&0x20000) != 0 && complete) sample=sample|0x10000|raw
        return
    }
    if (address == 0x60008904) { clock=value; return }
    if (address == 0x6000883c) { power=value; return }
    if (address == 0x60008034) { busA=value; return }
    if (address == 0x6000e044) { busB=value; return }
    if (address == 0x6000e048) { busC=value; return }
    if (address == 0x60008800) { control=value; return }
    if (address == 0x60008814) { atten=value; return }
    if (address == 0x60004554+pin*4) { route=value; return }
    if (address == 0x60009004+pin*4) { mux=value; return }
    if (address == 0x60008484+pin*4) { pad=value; return }
    bad=true; return
}
fun esp32S3SarRead(address: int): int = modelRead(address)
fun esp32S3SarWrite(address: int,value: int): void = modelWrite(address,value)
fun esp32S3AdcBusRead(address: int): int = modelRead(address)
fun esp32S3AdcBusWrite(address: int,value: int): void = modelWrite(address,value)
fun esp32S3Adc1Read(offset: int): int = modelRead(0x60008800+offset)
fun esp32S3Adc1Write(offset: int,value: int): void = modelWrite(0x60008800+offset,value)
fun esp32S3AdcPadRead(address: int): int = modelRead(address)
fun esp32S3AdcPadWrite(address: int,value: int): void = modelWrite(address,value)
fun esp32S3AdcFuseRead(offset: int): int { bad=true; return 0 }
fun esp32S3SarAnalogRead(register: int): int {
    if (esp32S3AdcBusState() != 5) bad=true
    if (register == 0) return lo
    if (register == 1) return hi
    if (register == 2) return ref
    if (register == 7) return ground
    bad=true; return 0
}
fun esp32S3SarAnalogWrite(register: int,value: int): void {
    if (esp32S3AdcBusState() != 5) bad=true
    writes=writes+1
    if (writes == drop) return
    if (register == 0) lo=value
    else if (register == 1) hi=value
    else if (register == 2) ref=value
    else if (register == 7) ground=value
    else bad=true
    return
}
fun reset(): void {
    clock=0x80000055
    power=0xc00000aa
    busA=0xa50000aa
    busB=0xa50400aa
    busC=0xa50000aa
    control=0x300000fe
    sample=0
    atten=0xffffffff
    digital=0xffffffff
    rtc=0xffffffff
    route=0xfab
    mux=0xffff
    pad=0xb82fe000
    writes=0; drop=0; complete=true; raw=1234; hi=0xf0; lo=0; ref=255; ground=255; return
}
fun restored(): bool = clock == 0x80000055 && power == 0xc00000aa && busA == 0xa50000aa && busB == 0xa50400aa && busC == 0xa50000aa
@export("abla_adc1_register_s3_test")
fun test(): i32 {
    while (pin <= 10) {
        var attenuation=0
        while (attenuation < 4) {
            reset()
            val cal=Esp32S3AdcCalibration(268435456|(attenuation<<26)|(3000<<12)|2000)
            var session=esp32S3Adc1SessionOpenOwned(pin-1,cal,true,true,3)
            if (!session.ready() || !esp32S3Adc1SessionHardwareMatches(pin-1,attenuation) || bad) return i32(1)
            session=session.startAfterSettlingOwned(3)
            session=session.pollOwned(3)
            if (session.raw() != 1234 || session.millivolts(cal) != cal.millivolts(1234)) return i32(2)
            session=session.closeOwned(3)
            if (session.status() != 0 || !restored() || bad) return i32(3)
            attenuation=attenuation+1
        }
        pin=pin+1
    }
    pin=1
    val cal=Esp32S3AdcCalibration(268435456|(3000<<12)|2000)
    var failed=1
    while (failed <= 17) {
        reset(); drop=failed
        var session=esp32S3Adc1SessionOpenOwned(0,cal,true,true,3)
        drop=0
        session=session.closeOwned(3)
        if (session.status() != 0 || !restored() || bad) return i32(20+failed)
        failed=failed+1
    }
    failed=1
    while (failed <= 6) {
        reset()
        var owned=esp32S3Adc1SessionOpenOwned(0,cal,true,true,3)
        owned=owned.startAfterSettlingOwned(3); owned=owned.pollOwned(3)
        writes=0; drop=failed; owned=owned.closeOwned(3)
        if (owned.status() == 0 || writes != failed) return i32(60+failed)
        drop=0; owned=owned.closeOwned(3)
        if (owned.status() != 0 || !restored() || bad) return i32(70+failed)
        failed=failed+1
    }
    // Repeated final-config failure must preserve the recovery obligation.
    reset(); drop=13
    var session=esp32S3Adc1SessionOpenOwned(0,cal,true,true,3)
    drop=writes+3; session=session.closeOwned(3)
    if (session.status() != 12) return i32(80)
    drop=0
    if (session.closeOwned(3).status() != 0 || !restored()) return i32(81)
    reset()
    session=esp32S3Adc1SessionOpenOwned(0,cal,true,true,3)
    complete=false; session=session.startAfterSettlingOwned(3)
    if (session.pollOwned(3).status() != 10) return i32(50)
    val before=writes
    session=session.closeOwned(3)
    if (session.status() != 12 || writes != before) return i32(51)
    sample=sample|0x10000|raw
    if (session.closeOwned(3).status() != 0 || !restored() || bad) return i32(52)
    return i32(0)
}
