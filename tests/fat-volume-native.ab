import "../src/storage/fat_volume.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
val disk=nativeStaticAllocate(1536)
var volume=FatVolume(0)
var nested=false
var bad=false
var failWrite=false
var writes=0
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    val slot=if (lba == 0) 0 else if (lba == 81) 1 else if (lba == 113) 2 else -1
    if (slot < 0) return false
    val input=nativeBufferAt(disk+slot*512,512);var index=0
    while (index < 512) { output.store(index,input.load(index));index=index+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,input: NativeBuffer): bool {
    writes=writes+1
    if (nested) {
        val result=volume.read(u32(8),FatDirectoryEntry((1<<60)|(100<<28)|2),0,1,2,
            nativeBufferAt(memory+3200,512),nativeBufferAt(memory+1088,1536))
        if (result.status() != 12 || volume.invalidate(u32(8))) bad=true
    }
    val slot=if (lba == 81) 1 else if (lba == 113) 2 else -1
    if (slot < 0) return false
    val output=nativeBufferAt(disk+slot*512,512);var index=0
    while (index < 512) { output.store(index,input.load(index));index=index+1 }
    return !failWrite
}
@export("abla_fat_volume_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,32);val reader=nativeBufferAt(memory+32,28)
    val boot=nativeBufferAt(memory+64,512);val expected=nativeBufferAt(memory+576,32)
    val source=nativeBufferAt(memory+608,32);val workspace=nativeBufferAt(memory+1088,2048)
    val scratch=nativeBufferAt(memory+3200,512);val bpb=nativeBufferAt(disk,512)
    val directory=nativeBufferAt(disk+512,512)
    var index=0
    while (index < 1536) { nativeBufferAt(disk,1536).store(index,0);index=index+1 }
    bpb.store(12,2);bpb.store(13,1);bpb.store(14,1);bpb.store(16,2);bpb.store(18,2)
    bpb.store(22,40);bpb.store(19,129);bpb.store(20,39);bpb.store(510,85);bpb.store(511,170)
    directory.store(0,65);directory.storeU16(26,2);directory.storeU32(28,100)
    index=0
    while (index < 32) { expected.store(index,directory.load(index));source.store(index,42);index=index+1 }
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch)
    if (volume == 0 || fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch) != 0) return i32(2)
    val modified=rtcCalendarDateTime(2026,9,9,12,34,56)
    nested=true
    val result=volume.overwrite(u32(7),0,0,0,expected,0,10,2,source,modified,workspace)
    if (result.status() != 1 || result.dataBytesWritten() != 10 || bad || writes != 2 || state.loadU32(0) != 0) return i32(3)
    val file=FatDirectoryEntry((1<<60)|(100<<28)|2)
    if (volume.read(u32(7),file,0,10,2,scratch,workspace).bytesRead() != 10 || scratch.load(0) != 42) return i32(4)
    val old=volume
    if (!volume.invalidate(u32(7))) return i32(5)
    volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch)
    if (volume == 0 || old.read(u32(7),file,0,1,2,scratch,workspace).status() != 13 || old.invalidate(u32(7))) return i32(6)
    index=0
    while (index < 32) { expected.store(index,directory.load(index));index=index+1 }
    failWrite=true
    if (volume.overwrite(u32(7),0,0,0,expected,0,10,2,source,modified,workspace).status() != 8 ||
        state.loadU32(12) != 3 || volume.read(u32(7),file,0,1,2,scratch,workspace).status() != 14 ||
        fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch) != 0 || bad) return i32(7)
    if (!volume.invalidate(u32(7))) return i32(8)
    state.storeU32(8,16777215)
    if (fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch) != 0) return i32(9)
    return i32(0)
}
