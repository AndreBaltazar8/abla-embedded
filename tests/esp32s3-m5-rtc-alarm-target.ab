import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/rtc_alarm.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_m5_rtc_alarm_target")
trusted fun alarmTarget(rtc: M5Rtc,board: M5BoardId,pmic: M5Pm1,minute: int,hour: int,day: int,weekday: int): M5RtcAlarmResult =
    rtc.setBoardAlarmInterrupt(board,pmic,minute,hour,day,weekday)
