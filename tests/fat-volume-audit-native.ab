import "../src/storage/fat_volume_audit.ab"
import "../src/storage/fat_allocation_audit.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(8192)
val image=nativeStaticAllocate(1536)
var calls=0
var fail=0
var bad=false
var audited=FatVolume(0)
var lockChecks=0
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    calls=calls+1
    if (audited.begin(u32(8)) != 12) bad=true
    lockChecks=lockChecks+1
    if (calls == fail) return false
    var at=0
    if (lba == 1 || lba == 81 || lba == 113) {
        val input=nativeBufferAt(image+(if (lba == 1) 0 else if (lba == 81) 512 else 1024),512)
        while (at < 512) { output.store(at,input.load(at));at=at+1 }
    } else if (lba >= 2 && lba <= 40) {
        while (at < 512) { output.store(at,0);at=at+1 }
    } else { bad=true;return false }
    return true
}
trusted fun initialize(mode: int): void {
    val root=nativeBufferAt(image+512,512);val child=nativeBufferAt(image+1024,512)
    var at=0;while (at < 1536) { nativeBufferAt(image,1536).store(at,0);at=at+1 }
    val fat=nativeBufferAt(image,512)
    fat.storeU16(4,65535);fat.storeU16(6,if (mode == 2) 3 else 4);fat.storeU16(8,65535);fat.storeU16(10,65535)
    if (mode == 3) fat.storeU16(12,65535)
    val dirName=nativeBufferAt(nativeStaticBytes("DIR        "),11)
    val fileName=nativeBufferAt(nativeStaticBytes("FILE    TXT"),11)
    at=0;while (at < 11) { root.store(at,dirName.load(at));root.store(32+at,fileName.load(at));child.store(64+at,fileName.load(at));at=at+1 }
    root.store(11,16);root.storeU16(26,2)
    root.store(43,32);root.storeU16(58,3);root.storeU32(60,if (mode == 5) 2000 else 600)
    var dot=0
    while (dot < 2) {
        at=0;while (at < 11) { child.store(dot*32+at,32);at=at+1 }
        child.store(dot*32,46);if (dot == 1) child.store(33,46)
        child.store(dot*32+11,16);child.storeU16(dot*32+26,if (dot == 0) 2 else if (mode == 4) 7 else 0)
        dot=dot+1
    }
    child.store(75,32);child.storeU16(90,if (mode == 1) 4 else 5);child.storeU32(92,100)
    calls=0;bad=false;return
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,input: NativeBuffer): bool { bad=true;return false }
@export("abla_fat_volume_audit_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(memory,512);val reader=nativeBufferAt(memory+512,28)
    val scratch=nativeBufferAt(memory+540,1024);val data=nativeBufferAt(memory+1564,512)
    val queue=nativeBufferAt(memory+2076,32);val bitmap=nativeBufferAt(memory+2112,1266)
    val state=nativeBufferAt(memory+4000,32)
    var at=0;while (at < 512) { boot.store(at,0);at=at+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2);boot.storeU16(17,512)
    boot.storeU16(22,40);boot.storeU16(19,10113);boot.storeU16(510,0xaa55)
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    state.storeU32(8,1);state.storeU32(12,1);state.storeU32(16,reader.addressValue());state.storeU32(20,boot.addressValue());state.storeU32(24,0);state.storeU32(28,10113)
    audited=FatVolume(state.addressValue()|(1<<32))
    var mode=0
    while (mode < 6) {
        initialize(mode);lockChecks=0
        val result=audited.auditAllocation(u32(7),64,queue,data,scratch,bitmap)
        val expected=if (mode == 1 || mode == 2) 5 else if (mode == 3 || mode == 4) 7 else if (mode == 5) 9 else 1
        if (result.status() != expected || result.phase() != (if (mode == 0 || mode == 3) 2 else 1) || result.consistent() != (mode == 0) || bad || lockChecks != calls || state.loadU32(0) != 0) return i32(2)
        if (mode == 3 && result.detail() != 6) return i32(3)
        mode=mode+1
    }
    var fault=1
    while (fault <= 46) {
        initialize(0);fail=fault
        val result=audited.auditAllocation(u32(7),64,queue,data,scratch,bitmap)
        if (result.status() != 3 || result.phase() != (if (fault <= 6) 1 else 2) || calls != fault || bad || state.loadU32(0) != 0) return i32(4)
        fault=fault+1
    }
    fail=0
    var budget=1
    while (budget <= 46) {
        initialize(0)
        val result=audited.auditAllocation(u32(7),budget,queue,data,scratch,bitmap)
        if (result.status() != (if (budget < 46) 6 else 1) || calls != budget || result.consistent() != (budget == 46) || state.loadU32(0) != 0 || bad) return i32(5)
        budget=budget+1
    }
    initialize(0)
    bitmap.storeU32(0,12345)
    if (audited.auditAllocation(u32(7),64,queue,data,scratch,nativeBufferAt(boot.addressValue(),1266)).status() != 2 || calls != 0 || bitmap.loadU32(0) != 12345 || state.loadU32(0) != 0) return i32(6)
    if (audited.begin(u32(9)) != 0) return i32(7)
    if (audited.auditAllocation(u32(7),64,queue,data,scratch,bitmap).status() != 12 || calls != 0 || bitmap.loadU32(0) != 12345) return i32(8)
    peripheralGateAt(state.addressValue()).finish(u32(9),true)
    state.storeU32(8,2)
    if (audited.auditAllocation(u32(7),64,queue,data,scratch,bitmap).status() != 13 || calls != 0 || bitmap.loadU32(0) != 12345 || state.loadU32(0) != 0) return i32(9)
    return i32(0)
}
