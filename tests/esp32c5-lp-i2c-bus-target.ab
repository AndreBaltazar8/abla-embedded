import "../src/esp32/i2c/lp_bus_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_lp_i2c_bus_target")
trusted fun busTarget(state: Esp32C5LpI2cBusState,owner: u32,source: int,sourceHz: u32,cpuHz: u32,busHz: u32,close: bool): int =
    if (close) (if (state.closeOwned(owner)) 1 else 0) else state.openOwned(owner,2,3,source,sourceHz,cpuHz,busHz)
