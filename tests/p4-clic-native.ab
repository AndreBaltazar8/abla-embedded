import "../src/esp32/clic_p4_sequence.ab"
import "../src/esp32/clic_vectors_p4_sequence.ab"
import "../src/esp32/irq_vectors_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var current=16
var pending=0
var enable=0
var attribute=192
var control=31
var config=6
var writes=0
var reads=0
var drop=0
var bad=false
var scan=false
var activeLine=-1
var machine=u32(0)
val tableMemory=nativeStaticAllocate(256)
val localMemory=nativeStaticAllocate(64)
var mtvec=u32(0)
var mtvt=u32(0)
var csrTrace=0
var csrDrop=0
fun p4ClicReadMtvec(): u32 = mtvec
fun p4ClicReadMtvt(): u32 = mtvt
fun p4ClicVectorFence(): void { csrTrace=csrTrace*10+1; return }
fun p4ClicWriteMtvt(value: u32): void { csrTrace=csrTrace*10+2; if (csrDrop != 1) mtvt=value; return }
fun p4ClicWriteMtvec(value: u32): void { csrTrace=csrTrace*10+3; if (csrDrop != 2) mtvec=value; return }
fun p4ClicMachineStatus(): u32 = machine
fun p4ClicWriteConfig(value: int): void { writes=writes+1; if (writes != drop) config=value; return }
fun p4ClicReadConfig(): int { reads=reads+1; return config }
fun p4ClicReadByte(address: int): int {
    reads=reads+1
    if (scan) {
        if (address < 0x20801001 || address > 0x208010bd || ((address-0x20801001)&3) != 0) bad=true
        return if (address == 0x20801001+activeLine*4) 1 else 0
    }
    val offset=address-(0x20801000+current*4)
    if (offset == 0) return pending
    if (offset == 1) return enable
    if (offset == 2) return attribute
    if (offset == 3) return control
    bad=true; return 0
}
fun p4ClicWriteByte(address: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    val offset=address-(0x20801000+current*4)
    if (offset == 1) enable=value else if (offset == 2) attribute=value else if (offset == 3) control=value else bad=true
    return
}
@export("abla_p4_clic_test")
fun testClic(): i32 {
    scan=true
    var candidate=0
    while (candidate < 48) {
        activeLine=candidate; config=0; writes=0
        if (esp32P4ClicInitializeOwned() != 3 || writes != 0 || bad) return i32(7)
        candidate=candidate+1
    }
    activeLine=-1; config=0xffffffe1; writes=0
    if (esp32P4ClicInitializeOwned() != 1 || config != 0xffffffe7 || writes != 1 || bad) return i32(8)
    reads=0
    if (esp32P4ClicInitializeOwned() != 1 || writes != 1 || reads != 1) return i32(9)
    config=0; writes=0; drop=1
    if (esp32P4ClicInitializeOwned() != 4) return i32(10)
    drop=0; writes=0; reads=0; machine=u32(8)
    if (esp32P4ClicInitializeOwned() != 3 || writes != 0 || reads != 0) return i32(11)
    machine=u32(0); scan=false; config=6
    while (current <= 47) {
        var priority=1
        while (priority <= 7) {
            var mode=0
            while (mode < 6) {
                val trigger=if (mode/2 == 0) 0 else if (mode/2 == 1) 1 else 3
                val vectored=(mode&1) != 0
                attribute=199; control=31; enable=254; pending=0; writes=0
                if (esp32P4ClicConfigureOwned(current,priority,trigger,vectored) != 1 ||
                    attribute != (192|(trigger<<1)|(mode&1)) || control != ((priority<<5)|31) || enable != 254 || pending != 0 || bad) return i32(1)
                pending=1
                if (esp32P4ClicEnableOwned(current,true) != 1 || enable != 255 || pending != 1 ||
                    esp32P4ClicConfigureOwned(current,1,0,false) != 3 || esp32P4ClicEnableOwned(current,false) != 1 || pending != 1) return i32(2)
                mode=mode+1
            }
            priority=priority+1
        }
        current=current+1
    }
    current=16; pending=0; enable=0
    drop=1
    while (drop <= 2) {
        writes=0; attribute=192; control=31
        if (esp32P4ClicConfigureOwned(16,7,3,true) != 4 || enable != 0 || writes != drop) return i32(3)
        drop=drop+1
    }
    drop=1; writes=0; control=255
    if (esp32P4ClicEnableOwned(16,true) != 4) return i32(4)
    drop=0; config=0; writes=0
    if (esp32P4ClicConfigureOwned(16,1,0,false) != 3 || esp32P4ClicEnableOwned(16,true) != 3 || writes != 0) return i32(5)
    reads=0
    if (esp32P4ClicConfigureOwned(15,1,0,false) != 2 || esp32P4ClicConfigureOwned(16,0,0,false) != 2 ||
        esp32P4ClicConfigureOwned(16,1,2,false) != 2 || esp32P4ClicEnableOwned(48,false) != 2 || reads != 0 || bad) return i32(6)
    scan=true; activeLine=-1; config=6; machine=u32(0)
    val table=nativeBufferAt((tableMemory+63)&(-64),192)
    var slot=0
    while (slot < 48) { table.storeU32(slot*4,0x4ff00100); slot=slot+1 }
    if (esp32P4ClicInstallVectorsOwned(0x4ff00000,table,u32(0),u32(0)) != 1 || csrTrace != 123 || mtvec != u32(0x4ff00003)) return i32(12)
    csrTrace=0
    if (esp32P4ClicInstallVectorsOwned(0x4ff00000,table,u32(0),u32(0)) != 4 || csrTrace != 0) return i32(13)
    slot=0
    while (slot < 48) {
        table.storeU32(slot*4,0)
        if (esp32P4ClicInstallVectorsOwned(0x4ff00000,table,mtvec,mtvt) != 2 || csrTrace != 0) return i32(14)
        table.storeU32(slot*4,0x4ff00100); slot=slot+1
    }
    csrDrop=1; mtvec=u32(0); mtvt=u32(0)
    if (esp32P4ClicInstallVectorsOwned(0x4ff00000,table,u32(0),u32(0)) != 5 || csrTrace != 12) return i32(15)
    csrDrop=2; csrTrace=0
    if (esp32P4ClicInstallVectorsOwned(0x4ff00000,table,u32(0),u32(0)) != 6 || csrTrace != 123 || mtvec != u32(0)) return i32(16)
    if (bad) return i32(17)
    val local=nativeBufferAt(localMemory,64)
    mtvt=u32(0); csrTrace=0
    slot=0
    while (slot < 16) { local.storeU32(slot*4,0x4ff00200+slot*4); slot=slot+1 }
    slot=0
    while (slot < 16) {
        local.storeU32(slot*4,0)
        if (esp32P4IrqPrepareVectorsOwned(table,local,0x4ff00000) != 2 || csrTrace != 0) return i32(18)
        local.storeU32(slot*4,0x4ff00200+slot*4); slot=slot+1
    }
    if (esp32P4IrqPrepareVectorsOwned(table,local,0x4ff00000) != 1 || csrTrace != 1) return i32(19)
    slot=0
    while (slot < 48) {
        if (table.loadU32(slot*4) != (if (slot < 16) 0x4ff00200+slot*4 else 0x4ff00000)) return i32(20)
        slot=slot+1
    }
    csrTrace=0; mtvt=u32(table.addressValue())
    if (esp32P4IrqPrepareVectorsOwned(table,local,0x4ff00000) != 3 || csrTrace != 0) return i32(21)
    mtvt=u32(0)
    if (esp32P4IrqPrepareVectorsOwned(table,nativeBufferAt(table.addressValue()+4,64),0x4ff00000) != 2 ||
        esp32P4IrqPrepareVectorsOwned(table,local,table.addressValue()) != 2 || csrTrace != 0) return i32(22)
    return i32(0)
}
