import "../src/esp32/psram/tuning_p4_sequence.ab"
fun psramTuningChecks(): int {
    var phase=0
    while (phase < 4) {
        var dataDelay=0
        while (dataDelay < 16) {
            var dqsDelay=0
            while (dqsDelay < 16) {
                resetPins(2,true)
                var pin=0
                while (pin < 20) {
                    val dqs=pin == 8 || pin == 19
                    val desired=if (dqs) (phase<<1)|(dqsDelay<<7)|(dqsDelay<<17) else dataDelay<<4
                    pinSet(28+pin*4,4294967295^desired); pin=pin+1
                }
                if (p4PsramTuningCandidateOwned(phase,dataDelay,dqsDelay,1) != 1 || pinWrites != 20 || pinBad) return 90
                pin=0
                while (pin < 20) {
                    val dqs=pin == 8 || pin == 19
                    val expected=if (dqs) 0xffe1f879|(phase*2)|(dqsDelay*128)|(dqsDelay*131072) else 0xffffff0f|(dataDelay*16)
                    if (p4PsramPinRead(28+pin*4) != expected) return 91
                    pin=pin+1
                }
                dqsDelay=dqsDelay+1
            }
            dataDelay=dataDelay+1
        }
        phase=phase+1
    }
    var failure=1
    while (failure <= 20) {
        resetPins(2,true)
        var offset=28
        while (offset <= 104) { pinSet(offset,0); offset=offset+4 }
        pinDrop=failure
        if (p4PsramTuningCandidateOwned(3,15,15,1) != ((failure<<8)|5) || pinWrites != failure) return 92
        failure=failure+1
    }
    var index=0
    while (index < 31) {
        if (p4PsramTuningDataDelay(index) != (if (index <= 15) 0 else index-15) || p4PsramTuningDqsDelay(index) != (if (index < 15) 15-index else 0)) return 93
        index=index+1
    }
    var mask=0
    while (mask < 65536) {
        // Independent interval enumeration oracle, including ties/no passes.
        var best=0; var chosen=-1; var first=0
        while (first < 16) {
            var end=first
            while (end < 16 && (mask&(1<<end)) != 0) end=end+1
            val length=end-first
            if (length >= 2 && length > best) { best=length; chosen=first+(length-1)/2 }
            first=first+1
        }
        if (p4PsramTuningBestWindow(mask,16,2) != chosen) return 94
        mask=mask+1
    }
    if (p4PsramTuningBestWindow(2147483647,31,2) != 15 || p4PsramTuningBestWindow(0x60000000,31,2) != 29 ||
        p4PsramTuningBestWindow(0x40000001,31,2) != -1 || p4PsramTuningBestWindow(16,4,1) != -1 || p4PsramTuningBestWindow(1,4,2) != -1) return 95
    resetPins(2,true); registerWrite(60,1)
    if (p4PsramTuningCandidateOwned(0,0,0,1) != 3 || pinWrites != 0) return 96
    registerWrite(60,0); registerWrite(4096,16)
    if (p4PsramTuningCandidateOwned(0,0,0,1) != 4 || pinWrites != 0) return 97
    resetPins(2,true); clockSet(20,0)
    if (p4PsramTuningCandidateOwned(0,0,0,1) != 6 || pinWrites != 0 || mappedReads != 0) return 98
    resetPins(2,true)
    if (p4PsramTuningCandidateOwned(4,0,0,1) != 2 || p4PsramTuningCandidateOwned(0,16,0,1) != 2 || p4PsramTuningCandidateOwned(0,0,-1,1) != 2 || p4PsramTuningCandidateOwned(0,0,0,0) != 2 || pinWrites != 0) return 99
    return 0
}
