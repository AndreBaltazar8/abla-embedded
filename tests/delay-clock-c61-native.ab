import "../src/esp32/delay_clock_c61_sequence.ab"
import "abla/build"
var source=0
var divider=1
var reads=0
var writes=0
var ticks=0
var changeAt=0
fun c61DelayClockRead(address: int): int {
    reads=reads+1
    if (address == 0x600960e8) return ((if (changeAt != 0 && reads >= changeAt) (source+1)%3 else source)<<16)|0xa80000ff
    return (divider-1)|0x8000ff00
}
fun c61DelayClockSetRomTicks(value: int): void { writes=writes+1;ticks=value;return }
@export("abla_delay_clock_c61_test")
trusted fun testDelayClock(): i32 {
    while (source < 4) {
        divider=1
        while (divider <= 256) {
            reads=0;writes=0;ticks=0
            val result=esp32C61DelayClockConfigureOwned(40000000,20000000,true)
            val root=if (source == 0) 40000000 else if (source == 1) 20000000 else 160000000
            val valid=source < 3 && root%divider == 0 && (root/divider)%1000000 == 0 && root/divider >= 1000000
            if (result.ready() != valid || writes != (if (valid) 1 else 0)) return i32(1)
            if (valid && (ticks != root/divider/1000000 || result.ticksPerMicrosecond() != ticks)) return i32(2)
            divider=divider+1
        }
        source=source+1
    }
    source=2;divider=2
    changeAt=3
    while (changeAt <= 5) {
        reads=0;writes=0
        if (esp32C61DelayClockConfigureOwned(0,0,true).status() != 5 || writes != (if (changeAt == 5) 1 else 0)) return i32(3)
        changeAt=changeAt+2
    }
    reads=0;writes=0;changeAt=0
    if (esp32C61DelayClockConfigureOwned(0,0,false).status() != 2 || reads != 0 || writes != 0) return i32(4)
    source=0
    if (esp32C61DelayClockConfigureOwned(0,0,true).status() != 3 || writes != 0) return i32(5)
    if (esp32C61CpuRateHz(0,0,40000000,20000000) != 0 || esp32C61CpuRateHz(0,257,40000000,20000000) != 0) return i32(6)
    return i32(0)
}
