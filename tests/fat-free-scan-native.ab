import "../src/storage/fat_free_scan.ab"
import "../src/storage/fat_volume_space.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
val image=nativeStaticAllocate(4096)
var reads=0
var failAt=0
var base=1
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool = false
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,dest: NativeBuffer): bool {
    if (lba == 0) { var i=0;while (i < 512) { dest.store(i,nativeBufferAt(memory+32,512).load(i));i=i+1 };return true }
    reads=reads+1
    if (lba < base || lba >= base+8) return false
    val source=nativeBufferAt(image+(lba-base)*512,512);var index=0
    while (index < 512) { dest.store(index,source.load(index));index=index+1 }
    return reads != failAt
}
@export("abla_fat_free_scan_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(memory,28);val boot=nativeBufferAt(memory+32,512)
    val work=nativeBufferAt(memory+1024,1024)
    var index=0
    while (index < 512) { boot.store(index,0);index=index+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2)
    boot.storeU16(17,512);boot.storeU16(22,8);boot.storeU16(19,2549);boot.storeU16(510,0xaa55)
    index=0
    while (index < 4096) { nativeBufferAt(image,4096).store(index,255);index=index+1 }
    val location=fatLinkLocate(boot,0,2549,342)
    if (!fatLinkPatch(location,0,nativeBufferAt(image+512,512),nativeBufferAt(image+1024,512))) return i32(1)
    val mount=nativeBufferAt(memory+576,32)
    if (!fatVolumeInitializeFresh(mount)) return i32(18)
    val volume=fatVolumeOpen(mount,u32(7),reader,2549,-1,boot,nativeBufferAt(memory+2560,512))
    val spaceWork=nativeBufferAt(memory+1024,1028)
    var space=volume.space(u32(7),8,spaceWork)
    if (space.status() != 1 || space.totalClusters() != 2500 || space.freeClusters() != 1 || reads != 8) return i32(19)
    space=volume.space(u32(7),1,spaceWork)
    if (space.status() != 5 || space.totalClusters() != 0 || space.freeClusters() != 0 || mount.loadU32(12) != 1) return i32(20)
    if (volume.begin(u32(8)) != 0 || volume.space(u32(7),8,spaceWork).status() != 12) return i32(21)
    if (!peripheralGateAt(mount.addressValue()).finish(u32(8),true)) return i32(22)
    reads=0;failAt=2
    if (volume.space(u32(7),8,spaceWork).status() != 4 || volume.space(u32(7),8,spaceWork).status() != 14) return i32(23)
    if (!volume.invalidate(u32(7)) || volume.space(u32(7),8,spaceWork).status() != 13) return i32(24)
    reads=0;failAt=0
    val count=nativeBufferAt(memory+2048,4)
    var counted=fatCountFreeOwned(reader,boot,0,2549,2,3000,8,work,count)
    if (counted.status() != 2 || counted.inspected() != 2500 || count.loadU32(0) != 1 || reads != 8) return i32(12)
    reads=0
    counted=fatCountFreeOwned(reader,boot,0,2549,2,1000,1,work,count)
    if (counted.status() != 5 || counted.cluster() != 341 || counted.inspected() != 339 || count.loadU32(0) != 0) return i32(13)
    reads=0
    counted=fatCountFreeOwned(reader,boot,0,2549,counted.cluster(),2500-counted.inspected(),8,work,count)
    if (counted.status() != 5 || counted.cluster() != 2 || counted.inspected() != 2161 || count.loadU32(0) != 1) return i32(14)
    count.storeU32(0,77)
    if (fatCountFreeOwned(reader,boot,0,2549,1,1000,8,work,count).status() != 3 || count.loadU32(0) != 77 ||
        fatCountFreeOwned(reader,boot,0,2549,2,1000,8,work,work).status() != 3) return i32(15)
    reads=0
    // Cluster341 straddles two sectors;342 reuses its cached second sector.
    var result=fatFindFreeOwned(reader,boot,0,2549,2,1000,2,work)
    if (result.status() != 1 || result.cluster() != 342 || result.inspected() != 341 || reads != 2) return i32(2)
    reads=0
    result=fatFindFreeOwned(reader,boot,0,2549,2,1000,1,work)
    if (result.status() != 5 || result.cluster() != 341 || result.inspected() != 339 || reads != 1) return i32(3)
    reads=0
    result=fatFindFreeOwned(reader,boot,0,2549,result.cluster(),1000,2,work)
    if (result.status() != 1 || result.cluster() != 342 || result.inspected() != 2 || reads != 2) return i32(4)
    reads=0
    result=fatFindFreeOwned(reader,boot,0,2549,2499,10,2,work)
    if (result.status() != 5 || result.cluster() != 9 || result.inspected() != 10 || reads != 2) return i32(5)
    if (!fatLinkPatch(location,4095,nativeBufferAt(image+512,512),nativeBufferAt(image+1024,512))) return i32(6)
    reads=0
    result=fatFindFreeOwned(reader,boot,0,2549,2,3000,8,work)
    if (result.status() != 2 || result.inspected() != 2500 || reads != 8) return i32(7)
    reads=0;failAt=2
    result=fatFindFreeOwned(reader,boot,0,2549,2,1000,8,work)
    if (result.status() != 4 || result.cluster() != 341 || reads != 2) return i32(8)
    reads=0
    if (fatFindFreeOwned(reader,boot,0,2549,1,1000,8,work).status() != 3 ||
        fatFindFreeOwned(reader,boot,0,2549,2,1000,8,boot).status() != 3 || reads != 0) return i32(9)
    var mode=0
    while (mode < 3) {
        failAt=0;reads=0;index=0
        while (index < 512) { boot.store(index,0);index=index+1 }
        index=0
        while (index < 4096) { nativeBufferAt(image,4096).store(index,255);index=index+1 }
        boot.storeU16(11,512);boot.store(13,1);boot.store(16,2);boot.storeU16(510,0xaa55)
        if (mode == 0) {
            boot.storeU16(14,1);boot.storeU16(17,512);boot.storeU16(22,40);boot.storeU16(19,10113);base=1
        } else {
            boot.storeU16(14,32);boot.storeU32(32,70000);boot.storeU32(36,600);boot.storeU32(44,2)
            boot.storeU16(40,if (mode == 2) 129 else 0);base=if (mode == 2) 632 else 32
        }
        val target=if (mode == 0) 258 else 130
        val total=if (mode == 0) 10113 else 70000
        val free=fatLinkLocate(boot,0,total,target)
        if (!fatLinkPatch(free,0,nativeBufferAt(image+512,512),nativeBufferAt(image+1024,512))) return i32(10)
        result=fatFindFreeOwned(reader,boot,0,total,2,400,2,work)
        if (result.status() != 1 || result.cluster() != target || result.inspected() != target-1 || reads != 2) return i32(11)
        reads=0
        counted=fatCountFreeOwned(reader,boot,0,total,2,400,8,work,count)
        if (counted.status() != 5 || counted.inspected() != 400 || count.loadU32(0) != 1) return i32(16)
        reads=0;failAt=2
        counted=fatCountFreeOwned(reader,boot,0,total,2,400,8,work,count)
        if (counted.status() != 4 || count.loadU32(0) != 0 || reads != 2) return i32(17)
        mode=mode+1
    }
    return i32(0)
}
