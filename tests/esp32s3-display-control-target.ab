import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/cores3_display_control.ab"
import "../src/m5stack/cores3_power.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_display_control_test")
trusted fun displayControlTarget(handle: u32, brightness: i32, reset: bool): bool =
    if (reset) cores3DisplayReset(Aw9523(int(handle)))
    else if (brightness == i32(-1)) cores3ConfigurePmic(Axp2101(int(handle)))
    else if (brightness == i32(-2)) cores3ConfigureExpander(Aw9523(int(handle)), false)
    else if (brightness == i32(-3)) cores3ConfigureExpander(Aw9523(int(handle)), true)
    else cores3DisplaySetBrightness(Axp2101(int(handle)), int(brightness))
