import "../src/audio/es8311_device.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
fun I2cBus.valid(): bool = this == 1
fun I2cBus.device(address: int,frequency: int): I2cDevice = I2cDevice(2)
fun I2cDevice.close(): bool = this == 2
val registers=nativeStaticU32s([0,1,2,13,18,19,50,55])
val values=nativeStaticU32s([128,181,24,1,0,16,191,8])
var volume=0
var calls=0
var fail=0
var bad=false
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool {
    if (this != 2 || calls >= 8) { bad=true;return false }
    if (register != nativeAddressLoadU32(registers,calls*4) || value != (if (calls == 6) volume else nativeAddressLoadU32(values,calls*4))) bad=true
    calls=calls+1;return calls != fail
}
@export("abla_es8311_speaker_test")
trusted fun test(): i32 {
    while (volume <= 255) {
        fail=0
        while (fail <= 8) {
            calls=0
            val result=Es8311(2).configureSpeakerBclkOwned(true,volume)
            if (bad || result != (if (fail == 0) 1 else fail+2) || calls != (if (fail == 0) 8 else fail)) return i32(1)
            fail=fail+1
        }
        volume=volume+1
    }
    calls=0
    if (Es8311(0).configureSpeakerBclkOwned(true) != 2 || Es8311(2).configureSpeakerBclkOwned(false) != 2 ||
        Es8311(2).configureSpeakerBclkOwned(true,-1) != 2 || Es8311(2).configureSpeakerBclkOwned(true,256) != 2 || calls != 0) return i32(2)
    return i32(0)
}
