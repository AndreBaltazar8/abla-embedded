import "../src/display/spi_lcd_profile_esp32.ab"
import "../src/esp32/gpio_esp32_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
type SpiDevice = int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this
fun Pin.outputCapable(): bool = esp32BasicGpioOutputValid(this)
fun SpiDevice.valid(): bool = this != 0
@export("abla_lcd_classic_profile_test")
trusted fun profileTest(): i32 {
    var dc = -2
    while (dc <= 260) {
        val value = spiLcd(SpiDevice(1),dc)
        if (value.valid() != esp32BasicGpioOutputValid(dc)) return i32(1)
        if (value.valid() && (value.dataCommandPin().number() != dc ||
            value.resetPin().number() != -1 || value.backlightPin().number() != -1)) return i32(2)
        var reset = -2
        while (reset <= 40) {
            var backlight = -2
            while (backlight <= 40) {
                val expected = esp32BasicGpioOutputValid(dc) &&
                    (reset == -1 || esp32BasicGpioOutputValid(reset)) &&
                    (backlight == -1 || esp32BasicGpioOutputValid(backlight)) &&
                    dc != reset && dc != backlight && (reset == -1 || reset != backlight)
                val lcd = spiLcd(SpiDevice(1),dc,reset,backlight,true)
                if (lcd.valid() != expected || (expected && (!lcd.backlightActiveLow() ||
                    lcd.resetPin().number() != reset || lcd.backlightPin().number() != backlight))) return i32(3)
                backlight = backlight+1
            }
            reset = reset+1
        }
        dc = dc+1
    }
    if (spiLcd(SpiDevice(0),2).valid() || spiLcd(SpiDevice(4294967297),2).valid() ||
        spiLcd(SpiDevice(1),2,255).valid() || spiLcd(SpiDevice(1),2,-1,258).valid() ||
        SpiLcd(spiLcd(SpiDevice(1),2) | (1 << 57)).valid()) return i32(4)
    i32(0)
}
