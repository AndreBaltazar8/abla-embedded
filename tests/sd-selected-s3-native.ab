import "./sd-s3-fifo-model.ab"
@export("abla_sd_selected_s3_test")
trusted fun test(): i32 {
    val scratch=nativeBufferAt(memory,2);val response=nativeBufferAt(memory+4,4)
    while (peripheral <= 3) {
        firstPin=if (peripheral == 2) 10 else 40
        val link=sdSpiS3Link(peripheral,spiPins(firstPin,firstPin+1,firstPin+2),Pin(firstPin+3))
        if (!link.valid() || link.peripheral() != peripheral || !link.selectedReady()) return i32(1)
        var index=0
        while (index < 64) { nativeBufferAt(queue,64).store(index,255);index=index+1 }
        nativeBufferAt(queue,64).store(6,1);nativeBufferAt(queue,64).store(7,0)
        nativeBufferAt(queue,64).store(8,0);nativeBufferAt(queue,64).store(9,1);nativeBufferAt(queue,64).store(10,170)
        failAt=0
        while (failAt <= 11) {
            starts=0;done=false;bad=false
            val result=sdSpiCommandSelected(link|0,8,426,scratch,response,4)
            if (bad || starts != (if (failAt == 0) 11 else failAt) ||
                result.status() != (if (failAt == 0) 1 else 4) ||
                (failAt != 0 && result.transportDetail() != 0x20109)) return i32(2)
            if (failAt == 0 && (result.r1() != 1 || result.trailingBytes() != 4 || response.load(3) != 170 ||
                nativeBufferAt(sent,64).load(0) != 72 || nativeBufferAt(sent,64).load(5) != 135)) return i32(3)
            failAt=failAt+1
        }
        failAt=0;starts=0;done=false
        // Exercise actual byte FIFO -> token -> payload -> CRC publication.
        nativeBufferAt(queue,64).store(0,254)
        var crc=0;index=0
        while (index < 16) {
            val value=index*13
            nativeBufferAt(queue,64).store(index+1,value);crc=sdSpiCrc16Byte(crc,value);index=index+1
        }
        nativeBufferAt(queue,64).store(17,crc>>>8);nativeBufferAt(queue,64).store(18,crc)
        val payload=nativeBufferAt(memory+8,16)
        if (!sdSpiReadPayloadSelected(link|0,scratch,payload,16,1).valid() || starts != 19 || bad) return i32(4)
        index=0
        while (index < 16) { if (payload.load(index) != index*13) return i32(5);index=index+1 }
        // Reject stale mode, CS, OE and routing without any transaction.
        var fault=0
        while (fault < 6) {
            faultAddress=if (fault == 0) esp32s3SpiBase(peripheral)+0x20 else if (fault == 1) esp32s3SpiBase(peripheral)+0x10
                else if (fault == 2) 0x60004004+(if (firstPin >= 32) 12 else 0)
                else if (fault == 3) 0x60004554+firstPin*4 else if (fault == 4) s3SdMuxAddress(firstPin+1)
                else 0x60004154+((if (peripheral == 2) 101 else 66)+1)*4
            faultMask=if (fault == 0) 1<<29 else if (fault == 1) 512 else if (fault == 2) 1<<((firstPin+3)&31) else if (fault == 4) 512 else 1
            val before=starts
            if (sdSpiCommandSelected(link|0,0,0,scratch,response,0).status() != 2 || starts != before) return i32(6)
            fault=fault+1
        }
        faultAddress=0;faultMask=0
        if (sdSpiSelectedAdmission(link|0,nativeBufferAt(0x60004000,2),response,4) ||
            sdSpiSelectedAdmission(link|0,scratch,nativeBufferAt(0x60003ffe,4),4)) return i32(7)
        peripheral=peripheral+1
    }
    if (sdSpiS3Link(1,spiPins(10,11,12),Pin(13)).valid() || SdSpiS3Link(0).valid()) return i32(8)
    peripheral=2;firstPin=10;csHigh=true;failAt=0;faultAddress=0;faultMask=0
    val link=sdSpiS3Link(2,spiPins(10,11,12),Pin(13))
    val gate=peripheralGateAt(gateStorage)
    val q=nativeBufferAt(queue,1024)
    var index=0
    while (index < 1024) { q.store(index,255);index=index+1 }
    // Literal CMD0/CMD8/CMD55/ACMD41/CMD58 response offsets after80 clocks.
    q.store(16,1);q.store(23,1);q.store(24,0);q.store(25,0);q.store(26,1);q.store(27,170)
    q.store(34,1);q.store(41,0);q.store(48,0);q.store(49,192);q.store(50,255);q.store(51,128);q.store(52,0)
    starts=0;csCalls=0;done=false;bad=false
    val state=link.initializeSd(gate,u32(7),80000000,scratch,response,1)
    if (!state.valid() || !state.highCapacity() || !state.version2() || starts != 54 || csCalls != 2 || !csHigh ||
        u32(nativeAddressLoadU32(gateStorage,0)) != u32(0) || bad) return i32(9)
    index=0
    while (index < 10) { if (nativeBufferAt(sent,1024).load(index) != 255) return i32(10);index=index+1 }
    // Every initialization byte including CS-high release: preserve failure,
    // attempt cleanup, latch gate and refuse another initialization.
    failAt=1
    while (failAt <= 54) {
        nativeAddressStoreU32(gateStorage,0,0);starts=0;csCalls=0;csHigh=true;done=false
        val failed=link.initializeSd(gate,u32(7),80000000,scratch,response,1)
        if (failed.valid() || !csHigh || u32(nativeAddressLoadU32(gateStorage,0)) != u32(0x80000000) || bad ||
            (failAt == 54 && (!failed.cleanupPending() || failed.status() != 16))) return i32(11)
        val before=starts
        if (link.initializeSd(gate,u32(7),80000000,scratch,response,1).status() != 12 || starts != before) return i32(12)
        failAt=failAt+1
    }
    failAt=0;nativeAddressStoreU32(gateStorage,0,0);starts=0;csCalls=0;csHigh=true;done=false
    fastClock=true
    if (link.initializeSd(gate,u32(7),80000000,scratch,response,1).status() != 14 || starts != 0 || csCalls != 0) return i32(13)
    fastClock=false;nativeAddressStoreU32(gateStorage,0,0)
    if (link.initializeSd(gate,u32(7),40000000,scratch,response,1).status() != 14 || starts != 0) return i32(14)
    // One complete sector read including its CRC and post-CS release byte.
    index=0
    while (index < 1024) { q.store(index,255);index=index+1 }
    q.store(6,0);q.store(7,254)
    var crc=0;index=0
    while (index < 512) { val byte=(index*37)&255;q.store(index+8,byte);crc=sdSpiCrc16Byte(crc,byte);index=index+1 }
    q.store(520,crc>>>8);q.store(521,crc)
    val data=nativeBufferAt(memory+8,512)
    nativeAddressStoreU32(gateStorage,0,0);starts=0;csCalls=0;csHigh=true;done=false
    val read=link.readSdBlock(gate,u32(7),80000000,state,3,scratch,data,1)
    if (!read.valid() || read.receivedBytes() != 512 || starts != 523 || csCalls != 2 || !csHigh || bad) return i32(15)
    index=0
    while (index < 512) { if (data.load(index) != ((index*37)&255)) return i32(16);index=index+1 }
    // Write ready, CMD24 R1, token512+CRC, accepted, ready, CMD13/R2.
    index=0
    while (index < 1024) { q.store(index,255);index=index+1 }
    q.store(7,0);q.store(523,5);q.store(531,0);q.store(532,0)
    nativeAddressStoreU32(gateStorage,0,0);starts=0;csCalls=0;csHigh=true;done=false
    val written=link.writeSdBlock(gate,u32(7),80000000,state,3,scratch,data,1)
    if (!written.valid() || !written.mayHaveWritten() || written.transmittedBytes() != 512 ||
        starts != 534 || csCalls != 2 || !csHigh || bad) return i32(17)
    index=0
    while (index < 512) { if (nativeBufferAt(sent,1024).load(index+9) != data.load(index)) return i32(18);index=index+1 }
    // Gate aliases must fail before atomic admission changes payload bytes.
    val before=starts
    if (link.readSdBlock(peripheralGateAt(memory),u32(7),80000000,state,3,scratch,data,1).status() != 2 || starts != before) return i32(19)
    // Known write response stream retained above. Fail before command, during
    // payload/CRC/program status and at release; never replay a partial write.
    var slot=0
    while (slot < 6) {
        failAt=if (slot == 0) 1 else if (slot == 1) 5 else if (slot == 2) 100 else if (slot == 3) 522 else if (slot == 4) 533 else 534
        nativeAddressStoreU32(gateStorage,0,0);starts=0;csCalls=0;csHigh=true;done=false
        val failed=link.writeSdBlock(gate,u32(7),80000000,state,3,scratch,data,1)
        if (failed.valid() || !csHigh || nativeAddressLoadU32(gateStorage,0) != 0x80000000 || bad ||
            (slot == 5 && (failed.status() != 16 || !failed.cleanupPending())) ||
            (slot >= 2 && !failed.mayHaveWritten())) return i32(20)
        slot=slot+1
    }
    failAt=0;stallAt=100;nativeAddressStoreU32(gateStorage,0,0);starts=0;csCalls=0;csHigh=true;done=false
    val stalled=link.writeSdBlock(gate,u32(7),80000000,state,3,scratch,data,1)
    if (stalled.valid() || stalled.transportDetail() != 263 || !stalled.cleanupPending() ||
        csHigh || csCalls != 1 || !busy || starts != 100) return i32(21)
    // External modeled completion, NOT an implementation reset/recovery.
    busy=false;stallAt=0;done=false;csHigh=true
    var csFault=1
    while (csFault <= 2) {
        csFailAt=csFault;nativeAddressStoreU32(gateStorage,0,0);starts=0;csCalls=0;csHigh=true;done=false
        val failed=link.writeSdBlock(gate,u32(7),80000000,state,3,scratch,data,1)
        if (failed.status() != 15 || failed.cleanupPending() != (csFault == 2) || csCalls != 2 ||
            csHigh != (csFault == 1) || nativeAddressLoadU32(gateStorage,0) != 0x80000000) return i32(22)
        csFault=csFault+1
    }
    csFailAt=0;csHigh=true;nativeAddressStoreU32(gateStorage,0,9)
    val beforeBusy=starts
    if (link.initializeSd(gate,u32(7),80000000,scratch,response,1).status() != 11 || starts != beforeBusy ||
        nativeAddressLoadU32(gateStorage,0) != 9) return i32(23)
    val sessionStorage=nativeBufferAt(sessionMemory,64)
    val csd=nativeBufferAt(memory+4,16)
    prepareSessionCard()
    if (!esp32S3SdSessionInitializeFresh(sessionStorage)) return i32(24)
    val first=esp32S3SdSessionOpen(sessionStorage,link,gate,u32(7),80000000,scratch,csd,1)
    if (first == 0 || first.blockCount(u32(7)) != 4294967296 || starts != 82 || bad ||
        sessionStorage.loadU32(8) != 1 || !sdRegisterValid(csd)) return i32(25)
    val openedStarts=starts
    if (esp32S3SdSessionOpen(sessionStorage,link,gate,u32(7),80000000,scratch,csd,1) != 0 ||
        first.readBlock(u32(7),4294967296,scratch,data,1).status() != 2 ||
        first.readBlock(u32(7),0,nativeBufferAt(sessionMemory+8,2),data,1).status() != 2 ||
        Esp32S3SdSession(first|(1<<56)).blockCount(u32(7)) != 0 || starts != openedStarts) return i32(26)
    if (!first.invalidate(u32(7)) || first.blockCount(u32(7)) != 0 || first.invalidate(u32(7)) ||
        first.readBlock(u32(7),0,scratch,data,1).status() != 2 || starts != openedStarts) return i32(27)
    prepareSessionCard()
    val second=esp32S3SdSessionOpen(sessionStorage,link,gate,u32(7),80000000,scratch,csd,1)
    if (second == 0 || second == first || sessionStorage.loadU32(8) != 2 || first.blockCount(u32(7)) != 0 || first.invalidate(u32(7))) return i32(28)
    // Live bus contention preserves session validity without touching hardware.
    nativeAddressStoreU32(gateStorage,0,9)
    if (second.readBlock(u32(7),0,scratch,data,1).status() != 11 || second.blockCount(u32(7)) != 4294967296) return i32(29)
    nativeAddressStoreU32(gateStorage,0,0);failAt=starts+1
    if (second.readBlock(u32(7),0,scratch,data,1).status() != 4 || second.blockCount(u32(7)) != 0 ||
        sessionStorage.loadU32(12) != 3 || (s3SdSessionLoad64(sessionStorage,48)&255) != 4) return i32(30)
    // A valid transport CRC cannot conceal a corrupted embedded register CRC7.
    prepareSessionCard();q.store(78,q.load(78)^2)
    crc=0;index=0
    while (index < 16) { crc=sdSpiCrc16Byte(crc,q.load(63+index));index=index+1 }
    q.store(79,crc>>>8);q.store(80,crc)
    if (esp32S3SdSessionOpen(sessionStorage,link,gate,u32(7),80000000,scratch,csd,1) != 0 ||
        (s3SdSessionLoad64(sessionStorage,48)&255) != 9 || sessionStorage.loadU32(12) != 3 || bad) return i32(31)
    prepareSessionCard();sessionStorage.storeU32(8,16777215)
    if (esp32S3SdSessionOpen(sessionStorage,link,gate,u32(7),80000000,scratch,csd,1) != 0 || starts != 0) return i32(32)
    return i32(0)
}
