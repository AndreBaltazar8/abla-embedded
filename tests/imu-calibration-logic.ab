import "../src/imu/calibration_logic.ab"

fun main: int {
    val arithmetic = imuIntegerSqrt(0) == 0 && imuIntegerSqrt(2) == 1 &&
        imuIntegerSqrt(81) == 9 &&
        imuCalibrationAverage(0, 65536, 1) == 32768 &&
        imuCalibrationDistance(196608, 262144, 0) == 5 &&
        imuCalibrationDelta(655360, 10, 255, 255, 10) == 655360
    val metadata = imuCalibrationMetadata(6, 17, 255)
    val packed = imuCalibrationAverageShift(metadata) == 6 &&
        imuCalibrationStillnessValue(metadata) == 17 &&
        imuCalibrationStrength(metadata) == 255

    val stillness = imuCalibrationStillness(16, 256, 0) == 17 &&
        imuCalibrationStillness(200, 1, 65536) == 0
    if (arithmetic && packed && stillness) 63 else 1
}
