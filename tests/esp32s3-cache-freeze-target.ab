import "../src/esp32/cache_freeze_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_cache_freeze_target")
@section(".iram1.abla.s3CacheFreezeTarget")
trusted fun freezeTarget(polls: int): int {
    val result=esp32S3CachesFreezeOwned(polls)
    if (result == 1) esp32S3CachesUnfreezeOwned()
    result
}
