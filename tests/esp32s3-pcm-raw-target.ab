import "../src/audio/wav_resample.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pcm_raw_target")
trusted fun rawTarget(source: NativeBuffer,metadata: NativeBuffer,output: NativeBuffer,
    rate: int,channels: int,bits: int,signedSamples: bool,frames: int): int {
    val pcm=pcmRaw(source,metadata,rate,channels,bits,signedSamples)
    if (!pcm.valid()) return -1
    pcm.copyResampledStereo16(0,frames,16000,output)
}
