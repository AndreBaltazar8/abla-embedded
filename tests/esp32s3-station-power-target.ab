// Peripheral backend compile check only, not a Station board firmware.
import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/gpio_esp32s3.ab"
import "../src/m5stack/station_power.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_station_power_target")
trusted fun stationTarget(board: M5BoardId,power: I2cDevice,ports: int,enabled: bool): M5StationPowerResult =
    board.setStationPower(board.bindAxpPower(power),ports,enabled)
