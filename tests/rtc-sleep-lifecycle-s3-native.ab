import "../src/m5stack/rtc_sleep_finish_s3_sequence.ab"
import "../src/m5stack/rtc_sleep_run_s3_sequence.ab"
import "../src/m5stack/rtc_sleep_finish_state_s3.ab"
import "../src/esp32/power/sleep_prepare_s3_sequence.ab"
import "../src/esp32/power/sleep_prepare_retained_s3_sequence.ab"
import "../src/esp32/power/sleep_record_s3_sequence.ab"
import "../src/esp32/power/sleep_resume_s3_sequence.ab"
import "../src/esp32/rtc_retention_tag_plan_s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Real preparation, retained/ordinary resume and board finish, with only
// lower-level hardware operations replaced. Records use actual native RAM.
type Esp32S3ClockState=int
type Esp32S3ClockBias=int
type Esp32S3AnalogSleepState=int
type Esp32S3SleepUarts=int
type Esp32S3SleepUsbSerial=int
type Esp32S3SleepSar=int
fun Esp32S3ClockState.valid(): bool = this != 0
fun Esp32S3ClockBias.rtcLow(): int = 27
fun Esp32S3ClockBias.digitalLow(): int = 27
fun Esp32S3SleepUarts.ready(): bool = this == 1
fun Esp32S3SleepUsbSerial.valid(): bool = this == 7
var sleepAddress=0
var scenario=0
var failure=0
var cpuNormal=true
var mspiNormal=true
var uartNormal=true
var retention=false
var usbNormal=true
var sarNormal=true
var stopped=false
var padsReleased=false
var bad=false
var restores=0
var cancels=0
var finishes=0
var restoreBlocked=false
fun esp32S3MspiStateRead(address: int): int = nativeBufferAt(address,4).loadU32(0)
fun esp32S3MspiStateWrite(address: int,value: int): void { nativeBufferAt(address,4).storeU32(0,value); return }
fun esp32S3MspiStateLoad64(address: int): int = nativeBufferAt(address,8).loadU32(0) | (nativeBufferAt(address,8).loadU32(4)<<32)
fun esp32S3MspiStateStore64(address: int,value: int): void {
    nativeBufferAt(address,8).storeU32(0,value); nativeBufferAt(address,8).storeU32(4,value>>>32); return
}
fun esp32S3ClockRead(address: int): int = 0
fun esp32S3ClockDecode(a: int,b: int,c: int): Esp32S3ClockState = Esp32S3ClockState(123)
fun esp32S3ClockResumeMegahertz(saved: Esp32S3ClockState): int = 80
fun esp32S3SleepUartsPrepareOwned(ports: int,deep: bool,polls: int): Esp32S3SleepUarts { uartNormal=false; Esp32S3SleepUarts(1) }
fun Esp32S3SleepUarts.resumeOwned(): Esp32S3SleepUarts { if (!cpuNormal || !mspiNormal) bad=true; uartNormal=true; Esp32S3SleepUarts(0) }
fun esp32S3MspiLowBeginOwned(record: NativeBuffer,octal: bool,ram: int,protocol: int,baseline: int,polls: int): int {
    if (scenario == 0) return 0
    mspiNormal=false; if (scenario == 8) 7 else 1
}
fun esp32S3MspiLowEndOwned(record: NativeBuffer,polls: int): int { if (!cpuNormal) bad=true; mspiNormal=true; 1 }
fun esp32S3ClockToXtalOwned(rtc: int,dig: int,disable: bool): Esp32S3ClockState {
    if (scenario == 1) return Esp32S3ClockState(0)
    cpuNormal=false; Esp32S3ClockState(123)
}
fun esp32S3AnalogSleepCaptureOwned(): Esp32S3AnalogSleepState = Esp32S3AnalogSleepState(1234)
fun esp32S3AnalogSleepRestoreOwned(saved: Esp32S3AnalogSleepState): void {
    if (!cpuNormal || retention || !usbNormal || !sarNormal || (saved | 0) != 1234) bad=true
    return
}
fun esp32S3ClockResumeFromXtalOwned(clock: Esp32S3ClockState,bias: Esp32S3ClockBias,polls: int): int {
    restores=restores+1
    if (restoreBlocked) return -3
    cpuNormal=true; 80000000
}
fun esp32S3RetentionBuffersValid(cpu: NativeBuffer,tags: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan): bool = true
fun esp32S3TagBufferBytes(i: Esp32S3TagPlan,d: Esp32S3TagPlan): int = 32
fun esp32S3RetentionArmOwned(cpu: NativeBuffer,tags: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan,small: bool): int {
    if (scenario >= 2 && scenario <= 4) return if (scenario == 2) 0 else scenario-1
    retention=true; 1
}
fun esp32S3SleepUsbSerialPrepareOwned(): Esp32S3SleepUsbSerial { usbNormal=false; Esp32S3SleepUsbSerial(7) }
fun esp32S3SleepSarPrepareOwned(monitor: bool): Esp32S3SleepSar { sarNormal=false; Esp32S3SleepSar(5) }
fun esp32S3SleepUsbSerialRestoreOwned(saved: Esp32S3SleepUsbSerial): bool { if (!cpuNormal) bad=true; usbNormal=true; true }
fun esp32S3SleepSarRestoreOwned(saved: Esp32S3SleepSar): bool { if (!cpuNormal || !usbNormal) bad=true; sarNormal=true; true }
fun esp32S3RetentionCancelOwned(i: Esp32S3TagPlan,d: Esp32S3TagPlan): bool { cancels=cancels+1; retention=false; true }
fun esp32S3RetentionFinishOwned(i: Esp32S3TagPlan,d: Esp32S3TagPlan): int { finishes=finishes+1; retention=false; 1 }
fun esp32S3LightSleepSuspendedOwned(wake: int,reject: int): int = if (scenario == 5) 0 else if (scenario == 6) 1 else -2
fun esp32S3SleepExternalEnterOwned(sleep: NativeBuffer,wake: NativeBuffer,flags: int,period: int,reject: int): int =
    if (scenario == 9) -6 else esp32S3SleepRetainedRecordEnterOwned(sleep,1,reject)
fun m5RtcCleanupRtcValid(handle: int): bool = handle == 7
fun m5RtcCleanupPmicValid(handle: int): bool = handle == 8
fun m5RtcTimerSupported(handle: int): bool = handle == 7
fun m5RtcCleanupRtc(handle: int,disable: bool): bool { bad=true; false }
fun m5RtcCleanupWake(handle: int): bool { if (!cpuNormal || !uartNormal || !mspiNormal) bad=true; true }
fun m5RtcCleanupPmicIrq(handle: int): bool = true
fun m5RtcConfigureTimer(handle: int,duration: int): RtcTimerResult {
    if (!cpuNormal || !mspiNormal || !uartNormal || retention || !usbNormal || !sarNormal || duration != 0 ||
        !m5RtcSleepCpuRestored(nativeBufferAt(sleepAddress,128))) bad=true
    stopped=(failure&1)==0; RtcTimerResult(if (stopped) 1 else 5)
}
fun esp32S3SleepWakeRecordsDisjoint(sleep: NativeBuffer,wake: NativeBuffer): bool = sleep.addressValue()+128 <= wake.addressValue() || wake.addressValue()+176 <= sleep.addressValue()
fun esp32S3SleepExternalWakeCleanupOwned(sleep: NativeBuffer,wake: NativeBuffer): bool {
    if (!stopped || !m5RtcSleepCpuRestored(sleep)) bad=true
    padsReleased=(failure&2)==0; padsReleased
}
@export("abla_rtc_sleep_lifecycle_test")
trusted fun lifecycleTest(): i32 {
    val sleep=nativeBufferAt(nativeStaticAllocate(128),128)
    val wake=nativeBufferAt(nativeStaticAllocate(176),176)
    val report=nativeBufferAt(nativeStaticAllocate(16),16)
    val cpu=nativeBufferAt(nativeStaticAllocate(8800),8800)
    val tags=nativeBufferAt(nativeStaticAllocate(32),32)
    val i=esp32S3TagPlan(false,32768,8,32,0,65536,false)
    val d=esp32S3TagPlan(true,32768,4,32,0,65536,false)
    sleepAddress=sleep.addressValue()
    while (scenario <= 9) {
        failure=0
        while (failure < 4) {
            sleep.storeU32(0,0); sleep.storeU32(4,0)
            wake.storeU32(0,0x45585453); wake.storeU32(4,1); wake.storeU32(8,1); wake.storeU32(12,1)
            wake.storeU32(16,0x45585430); wake.storeU32(20,1); wake.storeU32(24,0)
            cpuNormal=true; mspiNormal=true; uartNormal=true; retention=false; usbNormal=true; sarNormal=true
            stopped=false; padsReleased=false; bad=false; restores=0; cancels=0; finishes=0
            report.storeU32(0,99)
            if (esp32S3SleepPrepareRetainedOwned(sleep,cpu,tags,i,d,Esp32S3ClockBias(0),7,false,-1,0,0,8,false,false,sleep) != 2 ||
                esp32S3SleepPrepareRetainedOwned(sleep,cpu,tags,i,d,Esp32S3ClockBias(0),7,false,-1,0,0,8,false,false,cpu) != 2 ||
                report.loadU32(0) != 99 || !uartNormal || !cpuNormal) return i32(11)
            val preparation=esp32S3SleepPrepareRetainedOwned(sleep,cpu,tags,i,d,Esp32S3ClockBias(0),7,false,-1,0,0,8,false,false,report)
            if (preparation != (if (scenario < 2) 3 else if (scenario <= 4) 4 else if (scenario == 8) 5 else 1)) return i32(12)
            val prepared=report.loadU32(0)
            if (prepared != (if (scenario == 0) 3 else if (scenario == 1) 4 else if (scenario == 8) 7 else 1)) return i32(1)
            if (prepared == 1) {
                val armed=report.loadU32(4)
                if (armed != (if (scenario == 2) 3 else if (scenario == 3) 5 else if (scenario == 4) 6 else 1)) return i32(7)
                if (armed != 1 && (scenario < 2 || scenario > 4)) return i32(2)
            }
            var result=M5RtcSleepFinish(0)
            if (scenario >= 5 && scenario != 8) {
                report.storeU32(4,99)
                if (m5RtcSleepRunPreparedS3Owned(m5BoardPaperMono,7,8,sleep,wake,report,0,1000,0,8,false) != 2 ||
                    m5RtcSleepRunPreparedS3Owned(m5BoardPaperMono,7,8,sleep,wake,sleep,0,1000,0,8,true) != 2 ||
                    report.loadU32(4) != 99 || sleep.loadU32(4) != 9 || restores != 0) return i32(8)
                val run=m5RtcSleepRunPreparedS3Owned(m5BoardPaperMono,7,8,sleep,wake,report,0,1000,0,8,true)
                if (run != (if (failure != 0) 4 else if (scenario == 5) 1 else 3) || report.loadU32(4) != run ||
                    report.loadU32(0) != ((if (scenario == 5) 0 else if (scenario == 6) 1 else if (scenario == 9) -6 else -2)&0xFFFFFFFF)) return i32(9)
                result=M5RtcSleepFinish(report.loadU32(8) | (report.loadU32(12)<<32))
                if (m5RtcSleepRunPreparedS3Owned(m5BoardPaperMono,7,8,sleep,wake,report,0,1000,0,8,true) != 2) return i32(10)
            } else result=m5RtcSleepFinishS3Owned(m5BoardPaperMono,7,8,sleep,wake,8)
            val expected=if (scenario == 8) 2 else if ((failure&1)!=0) 3 else if ((failure&2)!=0) 4 else 1
            if (result.status() != expected || bad) return i32(3)
            if (scenario == 8) { if (stopped || padsReleased || restores != 0) return i32(4) }
            else {
                val count=restores
                val previous=failure; failure=0
                if (!m5RtcSleepFinishS3Owned(m5BoardPaperMono,7,8,sleep,wake,8).complete() || !padsReleased || restores != count || bad) return i32(5)
                failure=previous
                if (count != (if (scenario < 2) 0 else 1) || finishes != (if (scenario == 5) 1 else 0) || cancels != (if (scenario == 6 || scenario == 7 || scenario == 9) 1 else 0)) return i32(6)
            }
            failure=failure+1
        }
        scenario=scenario+1
    }
    // Arm refusal followed by a PLL timeout retains ordinary stage4 and
    // reports retryable progress. No board timer/pad cleanup before retry.
    scenario=2; failure=0; restoreBlocked=true; restores=0; bad=false
    sleep.storeU32(0,0); sleep.storeU32(4,0)
    cpuNormal=true; uartNormal=true; mspiNormal=true; usbNormal=true; sarNormal=true; retention=false
    stopped=false; padsReleased=false
    if (esp32S3SleepPrepareRetainedOwned(sleep,cpu,tags,i,d,Esp32S3ClockBias(0),7,false,-1,0,0,8,false,false,report) != 5 ||
        Esp32S3SleepResume(report.loadU32(8) | (report.loadU32(12)<<32)).status() != 2 ||
        sleep.loadU32(4) != 4 || cpuNormal || stopped || padsReleased || bad) return i32(13)
    restoreBlocked=false
    if (!m5RtcSleepFinishS3Owned(m5BoardPaperMono,7,8,sleep,wake,8).complete() || restores != 2 || !padsReleased || bad) return i32(14)
    i32(0)
}
