import "../src/display/it8951_session.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(128)
var selected=false
var index=0
var preamble=0
var command=0
var calls=0
var failure=0
var busy=0
var bad=false
var releaseFailure=false
fun it8951TransportValid(context: int): bool = context == 7
fun it8951TransportSelect(context: int,active: bool): bool {
    if (!active && releaseFailure) return false
    if (context != 7 || (active && selected)) bad=true
    selected=active
    if (active) index=0
    return true
}
fun it8951TransportReady(context: int): int = if (context == 7) 1 else -1
fun it8951TransportDelay(context: int,us: int): void {
    if (context != 7 || (us != 1 && us != 1000)) bad=true
    return
}
fun it8951TransportExchange(context: int,word: int): int {
    calls=calls+1
    if (context != 7 || !selected) bad=true
    if (calls == failure) return -1
    if (index == 0) preamble=word
    if (index == 1 && preamble == 24576) command=word
    var result=0
    if (preamble == 4096 && index >= 2) {
        if (command == 770) result=if (index == 2) 8 else if (index == 3) 4 else if (index == 4) 0x1000 else 0
        else if (command == 16) result=busy
        else bad=true
    }
    index=index+1;return result
}
@export("abla_it8951_session_test")
trusted fun testSession(): i32 {
    val session=it8951SessionAt(nativeBufferAt(memory,40))
    val scratch=nativeBufferAt(memory+40,40)
    val pixels=nativeBufferAt(memory+80,16)
    if (!session.initialize() || session.openOwned(7,scratch,3,true) != 1 || session.state() != 1 ||
        session.info().width() != 8 || session.info().height() != 4 || selected || bad) return i32(1)
    var before=calls
    if (session.refreshFullOwned(2,scratch,3,3,true).status() != 2 || session.detachStandbyOwned(true) ||
        session.openOwned(7,scratch,3,true) != -1 || calls != before) return i32(2)
    failure=calls+17
    val failed=session.loadFullOwned(pixels,4,scratch,3,3,true)
    if (failed.status() != 4 || session.state() != 2 || session.context() != 7 || session.lastResult() != (failed|0)) return i32(3)
    failure=0;before=calls
    if (session.refreshFullOwned(2,scratch,3,3,true).status() != 2 ||
        session.lowPowerOwned(false,scratch,3,3,true).status() != 2 || session.detachStandbyOwned(true) || calls != before) return i32(4)
    // Simulated external hardware reset; it is not performed by recovery API.
    command=0;selected=false
    if (session.recoverAfterHardwareResetOwned(scratch,3,true) != 1 ||
        !session.loadFullOwned(pixels,4,scratch,3,3,true).success() ||
        !session.refreshFullOwned(2,scratch,3,3,true).success() || session.state() != 3) return i32(5)
    before=calls
    if (session.loadFullOwned(pixels,4,scratch,3,3,true).status() != 2 || calls != before) return i32(6)
    busy=1
    if (session.waitOwned(scratch,3,2,true) != 7 || session.state() != 3) return i32(7)
    busy=0
    if (session.waitOwned(scratch,3,2,true) != 1 || session.state() != 1 ||
        !session.lowPowerOwned(false,scratch,3,3,true).success() || session.state() != 4 ||
        !session.resumeStandbyOwned(3,true).success() || session.state() != 1 ||
        !session.refreshFullOwned(2,scratch,3,3,true).success() ||
        !session.lowPowerOwned(true,scratch,3,3,true).success() || session.state() != 5) return i32(8)
    before=calls
    if (session.resumeStandbyOwned(3,true).status() != 2 || session.detachStandbyOwned(true) || calls != before) return i32(9)
    command=0;selected=false
    if (session.recoverAfterHardwareResetOwned(scratch,3,true) != 1) return i32(10)
    before=calls
    if (session.refreshFullOwned(2,scratch,3,3,true).status() != 2 ||
        session.loadFullOwned(session.buffer(),4,scratch,3,3,true).status() != 2 ||
        session.loadFullOwned(pixels,4,session.buffer(),3,3,true).status() != 2 ||
        session.lowPowerOwned(false,scratch,3,3,false).status() != 2 || calls != before) return i32(11)
    if (!session.lowPowerOwned(false,scratch,3,3,true).success()) return i32(14)
    releaseFailure=true
    if (session.detachStandbyOwned(true) || session.state() != 2 || session.context() != 7 || session.lastResult() != 5) return i32(15)
    releaseFailure=false;command=0;selected=false
    if (session.recoverAfterHardwareResetOwned(scratch,3,true) != 1 ||
        !session.lowPowerOwned(false,scratch,3,3,true).success() || !session.detachStandbyOwned(true) ||
        session.state() != 0 || session.context() != 0 || session.info().valid() || bad || selected) return i32(12)
    failure=calls+1
    if (session.openOwned(7,scratch,3,true) != 2 || session.state() != 2 || session.context() != 7 ||
        session.lastResult() == 1 || session.detachStandbyOwned(true)) return i32(13)
    i32(0)
}
