import "../src/xtensa/interrupt_guard.ab"
// Raw register witnesses, no compiler-managed float temporaries or hidden
// stack spills. Every task holds distinct F0..F15 values across preemption.
@section(".iram1.abla.s3FpuWitnessSeed")
trusted fun s3FpuWitnessSeed(base: int): void {
    xtensaGuardWrite("addi a8, $0, 0\nwfr f0, a8\naddi a8, $0, 1\nwfr f1, a8\naddi a8, $0, 2\nwfr f2, a8\naddi a8, $0, 3\nwfr f3, a8\naddi a8, $0, 4\nwfr f4, a8\naddi a8, $0, 5\nwfr f5, a8\naddi a8, $0, 6\nwfr f6, a8\naddi a8, $0, 7\nwfr f7, a8\naddi a8, $0, 8\nwfr f8, a8\naddi a8, $0, 9\nwfr f9, a8\naddi a8, $0, 10\nwfr f10, a8\naddi a8, $0, 11\nwfr f11, a8\naddi a8, $0, 12\nwfr f12, a8\naddi a8, $0, 13\nwfr f13, a8\naddi a8, $0, 14\nwfr f14, a8\naddi a8, $0, 15\nwfr f15, a8","r,~{a8},~{memory}",u32(base)); return
}
@section(".iram1.abla.s3FpuWitnessValid")
trusted fun s3FpuWitnessValid(base: int): bool =
    int(xtensaGuardRead("rfr $0, f0","=r,~{memory}")) == base+0 &&
        int(xtensaGuardRead("rfr $0, f1","=r,~{memory}")) == base+1 &&
        int(xtensaGuardRead("rfr $0, f2","=r,~{memory}")) == base+2 &&
        int(xtensaGuardRead("rfr $0, f3","=r,~{memory}")) == base+3 &&
        int(xtensaGuardRead("rfr $0, f4","=r,~{memory}")) == base+4 &&
        int(xtensaGuardRead("rfr $0, f5","=r,~{memory}")) == base+5 &&
        int(xtensaGuardRead("rfr $0, f6","=r,~{memory}")) == base+6 &&
        int(xtensaGuardRead("rfr $0, f7","=r,~{memory}")) == base+7 &&
        int(xtensaGuardRead("rfr $0, f8","=r,~{memory}")) == base+8 &&
        int(xtensaGuardRead("rfr $0, f9","=r,~{memory}")) == base+9 &&
        int(xtensaGuardRead("rfr $0, f10","=r,~{memory}")) == base+10 &&
        int(xtensaGuardRead("rfr $0, f11","=r,~{memory}")) == base+11 &&
        int(xtensaGuardRead("rfr $0, f12","=r,~{memory}")) == base+12 &&
        int(xtensaGuardRead("rfr $0, f13","=r,~{memory}")) == base+13 &&
        int(xtensaGuardRead("rfr $0, f14","=r,~{memory}")) == base+14 &&
        int(xtensaGuardRead("rfr $0, f15","=r,~{memory}")) == base+15
