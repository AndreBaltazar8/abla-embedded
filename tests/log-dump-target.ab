import "../src/esp32/serial_esp32s3.ab"
import "../src/log_dump.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun logOutputOwned(target: int,level: int,color: bool,text: NativeBuffer,length: int,suffix: int): bool {
    if (target != 0 || color) return false
    var index=0
    while (index < length) {
        if (!serial().tryWriteByte(text.load(index),1000)) return false
        index=index+1
    }
    if (suffix == 2 && !serial().tryWriteByte(13,1000)) return false
    if (suffix != 0 && !serial().tryWriteByte(10,1000)) return false
    return true
}
@export("abla_log_dump_target")
trusted fun target(source: int,length: int,scratch: int,level: int): int =
    logPolicy().configure(0,5,false,true,1).dumpOwned(level,nativeBufferAt(source,length),length,nativeBufferAt(scratch,80)).status()
