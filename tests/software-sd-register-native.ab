import "../src/sd/software_register.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val storage = nativeStaticAllocate(16)
// Independently generated polynomial CRC7 D5; CRC16 0033. Flipping embedded
// CRC7 bit1 gives D7 with CRC16 2071, isolating the two validation layers.
val registerBytes = nativeStaticU32s([64,0,0,0,0,9,0,0,3,255,0,0,0,0,0,213])
var selected = false
var outputHigh = false
var bits = 0
var idleBits = 0
var frame = 0
var reads = 0
var variant = 0
var bad = false
trusted fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) selected = !high
    if (this == 1 && high) {
        if (selected) {
            if (bits >= 8 && bits < 56) frame = (frame << 1) | (if (outputHigh) 1 else 0)
            else if (!outputHigh) bad = true
            bits = bits + 1
        } else { idleBits = idleBits + 1; if (!outputHigh) bad = true }
    }
    return
}
trusted fun Pin.read(): bool {
    if (this != 3 || !selected) bad = true
    val byte = reads / 8
    var value = 255
    if (variant == 6) value = 0
    else if (byte == 1) value = if (variant == 5) 4 else 0
    else if (byte == 2) value = if (variant == 4) 8 else 254
    else if (byte >= 3 && byte < 19) {
        value = nativeAddressLoadU32(registerBytes, (byte - 3) * 4)
        if (variant == 3 && byte == 18) value = value ^ 2
    } else if (byte == 19) value = if (variant == 3) 32 else 0
    else if (byte == 20) value = if (variant == 3) 113 else if (variant == 2) 50 else 51
    val result = ((value >> (7 - reads % 8)) & 1) != 0
    reads = reads + 1
    result
}
fun peripheralDelayMicroseconds(duration: int): void {
    if (duration != 2 && duration != 1000) bad = true
    return
}
trusted fun sdRegisterWireTest(): int {
    val data = nativeBufferAt(storage, 16)
    while (variant < 7) {
        bits = 0; idleBits = 0; frame = 0; reads = 0
        val command = if (variant == 1) 10 else 9
        val result = softwareSdReadRegister(peripheralGateAt(gateStorage), u32(7), Pin(1), Pin(2), Pin(3), Pin(4), SoftwareSdInitResult(65537), command, data)
        if (bad || selected || idleBits != 8 || nativeAddressLoadU32(gateStorage, 0) != 0) return 1
        val expected = if (variant < 2) 1 else if (variant < 4) 9 else if (variant == 4) 8 else if (variant == 5) 6 else 11
        if (result.status() != expected) return 2
        if (variant < 6 && frame != (((64 | command) << 40) | sdSpiCommandFrameCrc(command, 0))) return 3
        if (variant < 2 && (reads != 21 * 8 || sdCsdBlockCount(data) != 1048576)) return 4
        if (variant == 6 && bits != 250 * 8) return 5
        variant = variant + 1
    }
    0
}
#exportFunction("sdRegisterWireTest", "abla_sd_register_wire_test")
