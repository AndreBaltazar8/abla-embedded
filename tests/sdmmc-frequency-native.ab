import "../src/sd/mmc_frequency.ab"
import "../src/sd/mmc_host_clock_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var clock=0
var busy=0
var writes=0
var drop=false
trusted fun sdMmcS3Read(offset: int): int = if (offset == 2048) clock else if (offset == 16) busy else 0
trusted fun sdMmcS3Write(offset: int,value: int): void { writes=writes+1; if (!drop) clock=value; return }
@export("abla_sdmmc_frequency_test")
trusted fun test(): i32 {
    var rate=1000
    while (rate <= 50000000) {
        val plan=sdMmcFrequency(160000000,rate)
        var best=0
        var host=2
        while (host <= 16) {
            var card=0
            while (card <= 255) {
                val divisor=host*(if (card == 0) 1 else card*2)
                if (160000000 <= rate*divisor && (best == 0 || divisor < best)) best=divisor
                card=card+1
            }
            host=host+1
        }
        if (plan.valid() != (best != 0) || (plan.valid() && (plan.divisor() != best || plan.actualHz() > rate))) return i32(1)
        rate=rate*2
    }
    if (sdMmcFrequency(160000000,400000).actualHz() != 400000 || sdMmcFrequency(160000000,25000000).divisor() != 7 || sdMmcFrequency(160000000,0).valid()) return i32(2)
    var divisor=2
    while (divisor <= 16) {
        clock=0xffe00000; writes=0
        if (sdMmcHostClockConfigureOwned(divisor,true,true) != 1 || writes != 1 || (clock&0xff600000) != 0xff600000 || (clock&511) != 1 || ((clock>>9)&15) != (divisor>>1)-1 || ((clock>>13)&15) != divisor-1 || ((clock>>17)&15) != divisor-1) return i32(3)
        divisor=divisor+1
    }
    busy=1; writes=0
    if (sdMmcHostClockConfigureOwned(4,true,true) != 3 || writes != 0) return i32(4)
    busy=0; drop=true; clock=0
    if (sdMmcHostClockConfigureOwned(4,false,true) != 4 || sdMmcHostClockConfigureOwned(1,true,true) != 2 || sdMmcHostClockConfigureOwned(4,true,false) != 2) return i32(5)
    return i32(0)
}
