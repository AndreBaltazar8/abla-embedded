import "../src/display/epd_canvas.ab"
import "abla/build"
val canvasMemory=nativeStaticAllocate(64)
val canvasSource=nativeStaticAllocate(64)
val canvasState=nativeStaticAllocate(256)
val canvasBayer=nativeStaticU32s([0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5])
@export("abla_epd_canvas_test")
fun testEpdCanvas(): int {
    val canvas=nativeBufferAt(canvasMemory,64);val source=nativeBufferAt(canvasSource,64);val state=nativeBufferAt(canvasState,256)
    var gray=0
    while (gray < 256) {
        var cell=0
        while (cell < 16) {
            val b=nativeAddressLoadU32(canvasBayer,cell*4)
            var level=0
            // Division only after clamping negative numerator, independent
            // of the implementation's arithmetic-shift formula.
            if (gray+b >= 8) level=(gray+b-8)/16
            if (level > 15) level=15
            var mode=1
            while (mode <= 4) {
                val expected=if (mode < 3) level else if (gray+b*16 < 248) 0 else 15
                if (epdCanvasDither(gray,cell%4,cell/4,mode) != expected) return 1
                mode=mode+1
            }
            cell=cell+1
        }
        gray=gray+1
    }
    var rotation=0
    while (rotation < 8) {
        var index=0
        while (index < 64) { canvas.store(index,0xA5);source.store(index,(index*29)&255);index=index+1 }
        val lw=if ((rotation&1) == 0) 7 else 5
        val lh=if ((rotation&1) == 0) 5 else 7
        if (!epdCanvasDrawOwned(canvas,7,5,0,0,lw,lh,rotation,source,lw,-1,1,true)) return 2
        var y=0
        while (y < lh) {
            var x=0
            while (x < lw) {
                var px=x;var py=y
                if (rotation == 1) { px=6-y;py=x }
                if (rotation == 2) { px=6-x;py=4-y }
                if (rotation == 3) { px=y;py=4-x }
                if (rotation == 4) { px=x;py=4-y }
                if (rotation == 5) { px=y;py=x }
                if (rotation == 6) { px=6-x;py=y }
                if (rotation == 7) { px=6-y;py=4-x }
                if (epdCanvasPosition(7,5,x,y,rotation) != (px|(py<<16))) return 3
                val expected=epdCanvasDither(source.load(y*lw+x),px,py,1)*17
                if (epdCanvasRead(canvas,7,5,x,y,rotation) != expected) return 4
                x=x+1
            }
            y=y+1
        }
        // Odd-width row padding nibble must never be written.
        y=0
        while (y < 5) { if ((canvas.load(y*4+3)&15) != 5) return 5;y=y+1 }
        if (canvas.load(20) != 0xA5 || canvas.load(63) != 0xA5) return 6
        if (!epdCanvasDrawOwned(canvas,7,5,1,1,1,1,rotation,source,0,255,4,true) ||
            epdCanvasRead(canvas,7,5,1,1,rotation) != 255) return 7
        rotation=rotation+1
    }
    // Submit the last single pixel: retain its neighbor from the canvas;
    // untouched row/pair states must remain inactive, including the next row.
    var index=0
    while (index < 64) { canvas.store(index,0xA5);index=index+1 }
    if (!epdWaveformInitialize(state,128,true)) return 8
    if (!epdCanvasSubmitOwned(canvas,state,16,8,15,0,1,1,4,true)) return 9
    index=0
    while (index < 64) {
        val expected=if (index == 7) epdWaveformRequest(0x88888888,0xA5,4) else 0x88888888
        if (state.loadU32(index*4) != expected) return 10
        index=index+1
    }
    // Whole-region preflight: final invalid request cannot partially queue.
    state.storeU32(60,21760)
    if (epdCanvasSubmitOwned(canvas,state,16,8,0,0,16,2,1,true) || state.loadU32(0) != 0x88888888) return 11
    val before=canvas.loadU32(0)
    if (epdCanvasDrawOwned(canvas,7,5,0,0,8,5,0,source,8,-1,1,true) ||
        epdCanvasDrawOwned(canvas,7,5,0,0,7,5,0,canvas,7,-1,1,true) ||
        epdCanvasDrawOwned(canvas,7,5,0,0,7,5,0,source,6,-1,1,true) ||
        epdCanvasDrawOwned(canvas,7,5,0,0,7,5,0,source,7,256,1,true) ||
        epdCanvasDrawOwned(canvas,7,5,0,0,7,5,0,source,7,0,1,false) || canvas.loadU32(0) != before) return 12
    if (epdCanvasSubmitOwned(canvas,canvas,16,8,0,0,16,8,1,true) ||
        epdCanvasRead(canvas,7,5,7,0,0) != -1 || epdCanvasPosition(7,5,0,0,8) != -1) return 13
    return 0
}
