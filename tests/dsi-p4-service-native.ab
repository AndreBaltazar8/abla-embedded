import "../src/display/dsi_service_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(8)
val descriptorStorage=nativeStaticAllocate(64)
val frameStorage=nativeStaticAllocate(64)
var report=1
var nestedStop=false
var calls=0
var closes=0
var bad=false
var cacheIdle=true
fun p4DsiServiceCacheIdle(): bool = cacheIdle
trusted fun p4DsiServiceRearm(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): int {
    calls=calls+1
    if (nestedStop && esp32P4DsiServiceShutdown(serviceGateAt(storage),0,2) != 522) bad=true
    return report
}
fun p4DsiServiceShutdownVideo(channel: int,polls: int): int { closes=closes+1; return 32769 }
trusted fun refresh(): int = esp32P4DsiServiceRefresh(serviceGateAt(storage),u32(7),0,nativeBufferAt(descriptorStorage,64),nativeBufferAt(frameStorage,64),64,64,2)
@export("abla_dsi_p4_service_test")
trusted fun testService(): i32 {
    val memory=nativeBufferAt(storage,8)
    val gate=serviceGateAt(storage)
    memory.storeU32(0,0)
    if (esp32P4DsiServiceRefresh(gate,u32(7),0,nativeBufferAt(storage,64),nativeBufferAt(frameStorage,64),64,64,2) != 2 ||
        esp32P4DsiServiceRefresh(gate,u32(7),0,nativeBufferAt(descriptorStorage,64),nativeBufferAt(storage,64),64,64,2) != 2 ||
        esp32P4DsiServiceRefresh(gate,u32(7),0,NativeBuffer(0),nativeBufferAt(frameStorage,64),64,64,2) != 2 || calls != 0 || memory.loadU32(0) != 0) return i32(12)
    var token=u32(1)
    while (token <= u32(256)) {
        memory.storeU32(0,0)
        if (!gate.tryBegin(token) || gate.tryBegin(token+u32(1)) || gate.finish(token+u32(1),true)) return i32(1)
        if (gate.requestStop(2) != 2 || gate.tryBegin(token+u32(1)) || !gate.finish(token,true) || gate.requestStop(2) != 1) return i32(2)
        if (gate.tryBegin(token) || gate.finish(token,true)) return i32(3)
        memory.storeU32(0,0)
        if (!gate.tryBegin(token) || !gate.finish(token,false) || gate.requestStop(2) != 1) return i32(4)
        token=token+u32(1)
    }
    memory.storeU32(0,0)
    if (refresh() != 1 || calls != 1 || closes != 0 || memory.loadU32(0) != 0) return i32(5)
    nestedStop=true
    if (refresh() != 1 || bad || closes != 0 || memory.loadU32(0) != 2147483648) return i32(6)
    if (refresh() != 10 || calls != 2 || esp32P4DsiServiceShutdown(gate,0,2) != 32769 || closes != 1) return i32(7)
    cacheIdle=false
    if (esp32P4DsiServiceShutdown(gate,0,2) != 12 || closes != 1) return i32(11)
    cacheIdle=true
    nestedStop=false
    var status=0
    while (status <= 9) {
        memory.storeU32(0,0); report=131072|status
        if (refresh() != report) return i32(8)
        val healthy=status == 0 || status == 1 || status == 3
        if (memory.loadU32(0) != (if (healthy) 0 else 2147483648)) return i32(9)
        status=status+1
    }
    if (serviceGateAt(0).requestStop(2) != 4 || serviceGateAt(storage+1).tryBegin(u32(1)) || gate.tryBegin(u32(0))) return i32(10)
    return i32(0)
}
