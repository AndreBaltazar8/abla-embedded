import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/adc_power_c5_sequence.ab"
var ctrl=u32(0)
var bus=u32(4)
var functional=u32(0x400000)
var busy=false
var writes=0
var drop=0
var bad=false
trusted fun c5AdcClockRead(offset: int): u32 = if (offset == 0) bus else functional
trusted fun c5AdcClockWrite(offset: int,value: u32): void { bad=true;return }
trusted fun c5AdcRead(offset: int): u32 {
    if ((bus&u32(14)) != u32(4)) bad=true
    return if (offset == 0) ctrl else if (offset == 0x20 && busy) u32(0x20000000) else u32(0)
}
trusted fun c5AdcWrite(offset: int,value: u32): void {
    if (offset != 0) bad=true
    writes=writes+1
    if (writes != drop) ctrl=value
    return
}
@export("abla_adc_power_c5_test")
trusted fun test(): i32 {
    var mode=0
    while (mode < 4) {
        var clock=0
        while (clock < 2) {
            var fault=0
            while (fault < 5) {
                val initial=u32(0x40038201)|(u32(mode)<<u32(27))|(u32(clock)<<u32(6))
                ctrl=initial;writes=0;drop=fault;bad=false;busy=false
                var owner=c5AdcPowerOpenOwned(true)
                if (mode == 1) {
                    if (owner.status() != 5 || writes != 0 || ctrl != initial) return i32(1)
                } else {
                    if (owner.ready() && (ctrl&u32(0x18000040)) != u32(0x18000040)) return i32(2)
                    owner=owner.closeOwned(true)
                    drop=0
                    owner=owner.closeOwned(true)
                    if (owner.status() != 0 || ctrl != initial) return i32(3)
                }
                if (bad) return i32(4)
                fault=fault+1
            }
            clock=clock+1
        }
        mode=mode+1
    }
    ctrl=u32(0);writes=0;drop=0
    var owner=c5AdcPowerOpenOwned(true)
    val before=writes
    busy=true
    owner=owner.closeOwned(true)
    if (owner.status() != 4 || writes != before) return i32(5)
    busy=false;bus=u32(0)
    owner=owner.closeOwned(true)
    if (owner.status() != 3 || writes != before || bad) return i32(6)
    bus=u32(4)
    val denied=owner.closeOwned(false)
    if (denied != owner || writes != before) return i32(7)
    owner=owner.closeOwned(true)
    if (owner.status() != 0 || ctrl != u32(0)) return i32(8)
    writes=0
    if (c5AdcPowerOpenOwned(false).status() != 2 || writes != 0) return i32(9)
    busy=true
    if (c5AdcPowerOpenOwned(true).status() != 4 || writes != 0) return i32(10)
    return i32(0)
}
