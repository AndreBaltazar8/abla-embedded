import "../src/storage/fat_path.ab"
import "../src/storage/fat_path_utf16.ab"
import "../src/storage/fat_path_read_utf16.ab"
import "../src/storage/fat_path_read_utf8.ab"
import "../src/storage/fat_file_open_path.ab"
import "../src/storage/fat_file_open_utf8.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(2342)
var calls=0
var longRoot=false
var longUnit=76
var failAt=0
// This fixture is read-only; any attempted filesystem write must fail.
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool = false
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,dest: NativeBuffer): bool {
    calls=calls+1
    var i=0
    if (lba == 0) {
        while (i < 512) { dest.store(i,nativeBufferAt(storage+28,512).load(i));i=i+1 }
        return calls != failAt
    }
    while (i < 512) { dest.store(i,0); i=i+1 }
    i=0
    while (i < 11) { dest.store(i,32); i=i+1 }
    if (lba == 81) {
        if (longRoot) {
            var part=0
            while (part < 2) {
                val ordinal=2-part; val offset=part*32
                var j=0
                while (j < 32) { dest.store(offset+j,0); j=j+1 }
                dest.store(offset,ordinal | (if (part == 0) 64 else 0)); dest.store(offset+11,15); dest.store(offset+13,65)
                j=0
                while (j < 13) {
                    val n=(ordinal-1)*13+j
                    dest.storeU16(offset+fatLongNameUnitOffset(j),if (n < 20)
                        (if (longUnit > 65535) (if ((n&1) == 0) 0xd83d else 0xde00) else longUnit)
                        else if (n == 20) 0 else 65535)
                    j=j+1
                }
                part=part+1
            }
            i=64
            while (i < 75) { dest.store(i,32); i=i+1 }
            dest.store(64,68); dest.store(75,16); dest.store(90,2)
        } else { dest.store(0,68); dest.store(11,16); dest.store(26,2) }
    }
    else if (lba == 113) {
        dest.store(0,65); dest.store(8,84); dest.store(9,88); dest.store(10,84); dest.store(26,3); dest.store(28,7)
        i=32
        while (i < 43) { dest.store(i,32); i=i+1 }
        dest.store(32,46); dest.store(33,46); dest.store(43,16)
    } else if (lba == 114) {
        i=0
        while (i < 7) { dest.store(i,97+i); i=i+1 }
    } else return false
    return calls != failAt
}
@export("abla_fat_path_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(storage,28)
    val boot=nativeBufferAt(storage+28,512)
    val work=nativeBufferAt(storage+540,1536)
    val name=nativeBufferAt(storage+2076,11)
    val path=nativeBufferAt(storage+2087,255)
    var i=0
    while (i < 512) { boot.store(i,0); i=i+1 }
    boot.store(12,2); boot.store(13,1); boot.store(14,1); boot.store(16,2); boot.store(18,2)
    boot.store(22,40); boot.store(19,129); boot.store(20,39); boot.store(510,85); boot.store(511,170)
    // /d/a.txt
    path.store(0,47); path.store(1,100); path.store(2,47); path.store(3,97); path.store(4,46); path.store(5,116); path.store(6,120); path.store(7,116)
    val file=fatLookupPathOwned(reader,boot,0,10113,path,8,4,name,work)
    if (!file.isFile() || file.firstCluster() != 3 || file.byteSize() != 7 || calls != 2) return i32(1)
    path.store(8,47); calls=0
    if (fatLookupPathOwned(reader,boot,0,10113,path,9,4,name,work).status() != 15 || calls != 2) return i32(2)
    // /d/../ : real '..' entry designates root
    path.store(3,46); path.store(4,46); path.store(5,47); calls=0
    val root=fatLookupPathOwned(reader,boot,0,10113,path,6,4,name,work)
    if (!root.isDirectory() || root.firstCluster() != 0 || calls != 2) return i32(3)
    path.store(0,46); path.store(1,46); path.store(2,47); calls=0
    if (fatLookupPathOwned(reader,boot,0,10113,path,3,4,name,work).firstCluster() != 0 || calls != 0) return i32(4)
    // Exhaustively reject forbidden ASCII, accept supported name characters.
    var value=0
    while (value < 256) {
        path.store(0,value); name.store(0,42)
        val accepted=fatShortNameEncode(path,1,name)
        if (accepted != (fatShortAsciiCharacter(value) || value == 46)) return i32(5)
        if (!accepted && name.load(0) != 42) return i32(6)
        value=value+1
    }
    i=0
    while (i < 13) { path.store(i,97); i=i+1 }
    if (fatShortNameEncode(path,9,name) || fatShortNameEncode(path,13,name)) return i32(7)
    path.store(8,46)
    if (!fatShortNameEncode(path,12,name) || name.load(0) != 65 || name.load(10) != 65) return i32(8)
    path.store(7,46)
    if (fatShortNameEncode(path,12,name) || fatShortNameEncode(path,8,name) || fatShortNameEncode(path,1,path)) return i32(9)
    calls=0
    if (fatLookupPathOwned(reader,boot,0,10113,path,256,4,name,work).status() != 10 ||
        fatLookupPathOwned(reader,boot,0,10113,path,1,4,boot,work).status() != 10 || calls != 0) return i32(10)
    val unicode=nativeBufferAt(nativeStaticAllocate(512),512)
    val wideWork=nativeBufferAt(nativeStaticAllocate(2067),2067)
    // Mixed long directory + lowercase short alias, one scan per component.
    longRoot=true
    i=0
    while (i < 20) { unicode.storeU16(i*2,76); i=i+1 }
    unicode.storeU16(40,47); unicode.storeU16(42,97); unicode.storeU16(44,46)
    unicode.storeU16(46,116); unicode.storeU16(48,120); unicode.storeU16(50,116)
    calls=0
    val wideFile=fatLookupPathUtf16Owned(reader,boot,0,10113,unicode,26,1,wideWork)
    if (!wideFile.isFile() || wideFile.byteSize() != 7 || calls != 2) return i32(11)
    val output=nativeBufferAt(nativeStaticAllocate(512),512)
    output.store(4,123); calls=0
    if (fatReadPathUtf16Owned(reader,boot,0,10113,unicode,26,2,4,1,output,wideWork) != 4 || calls != 3 ||
        output.load(0) != 99 || output.load(1) != 100 || output.load(2) != 101 || output.load(3) != 102 || output.load(4) != 123) return i32(16)
    calls=0; output.store(0,42)
    if (fatReadPathUtf16Owned(reader,boot,0,10113,unicode,26,7,4,1,output,wideWork) != 0 || output.load(0) != 42 || calls != 2) return i32(17)
    failAt=1
    while (failAt <= 3) {
        calls=0
        if (fatReadPathUtf16Owned(reader,boot,0,10113,unicode,26,0,4,1,output,wideWork) != (if (failAt < 3) -111 else -204) || output.load(0) != 42 || calls != failAt) return i32(18)
        failAt=failAt+1
    }
    failAt=0; calls=0
    if (fatReadPathUtf16Owned(reader,boot,0,10113,unicode,26,0,4,1,unicode,wideWork) != -1 || calls != 0) return i32(19)
    i=0
    while (i < 20) { unicode.storeU16(i*2,108); i=i+1 }
    calls=0
    if (!fatLookupPathUtf16Owned(reader,boot,0,10113,unicode,26,1,wideWork).isFile() || calls != 2) return i32(20)
    val utf8=nativeBufferAt(nativeStaticAllocate(32),32)
    val converted=nativeBufferAt(nativeStaticAllocate(64),64)
    i=0
    while (i < 26) { utf8.store(i,unicode.loadU16(i*2)); i=i+1 }
    calls=0
    if (fatReadPathUtf8Owned(reader,boot,0,10113,utf8,26,converted,2,4,1,output,wideWork) != 4 || calls != 3 || output.load(0) != 99) return i32(21)
    utf8.store(25,255); calls=0; output.store(0,42)
    if (fatReadPathUtf8Owned(reader,boot,0,10113,utf8,26,converted,2,4,1,output,wideWork) != -1 || calls != 0 || output.load(0) != 42) return i32(22)
    unicode.storeU16(52,47); calls=0
    if (fatLookupPathUtf16Owned(reader,boot,0,10113,unicode,27,1,wideWork).status() != 15 || calls != 2) return i32(12)
    unicode.storeU16(42,46); unicode.storeU16(44,46); unicode.storeU16(46,47); calls=0
    if (fatLookupPathUtf16Owned(reader,boot,0,10113,unicode,24,1,wideWork).firstCluster() != 0 || calls != 2) return i32(13)
    // Malformed later component must be rejected before reading the first.
    unicode.storeU16(42,0xD800); calls=0
    if (fatLookupPathUtf16Owned(reader,boot,0,10113,unicode,24,1,wideWork).status() != 10 || calls != 0) return i32(14)
    unicode.storeU16(0,47); unicode.storeU16(2,46); unicode.storeU16(4,47); unicode.storeU16(6,46); unicode.storeU16(8,46)
    if (fatLookupPathUtf16Owned(reader,boot,0,10113,unicode,5,1,wideWork).firstCluster() != 0 || calls != 0) return i32(15)
    val state=nativeBufferAt(nativeStaticAllocate(32),32)
    val handle=nativeBufferAt(nativeStaticAllocate(80),80)
    val mountedBoot=nativeBufferAt(nativeStaticAllocate(512),512)
    val handleWork=nativeBufferAt(nativeStaticAllocate(2092),2092)
    if (!fatVolumeInitializeFresh(state)) return i32(23)
    var volume=fatVolumeOpen(state,u32(7),reader,10113,-1,mountedBoot,output)
    if (volume == 0 || !fatFileInitializeFresh(handle,volume,u32(7))) return i32(24)
    // Existing lowercase20-unit LFN directory, then short alias a.txt.
    i=0;while (i < 20) { unicode.storeU16(i*2,108);i=i+1 }
    unicode.storeU16(40,47);unicode.storeU16(42,97);unicode.storeU16(44,46)
    unicode.storeU16(46,116);unicode.storeU16(48,120);unicode.storeU16(50,116)
    calls=0
    val opened=fatFileOpenPathUtf16(handle,u32(7),unicode,26,1,handleWork)
    if (opened.status() != 1 || calls != 2 || handle.loadU32(24) != 2 || handle.loadU32(28) != 0 || handle.loadU32(32) != 0) return i32(25)
    if (opened.readAt(u32(7),2,4,1,output,handleWork).bytesRead() != 4 || output.load(0) != 99 || !opened.close(u32(7))) return i32(26)
    unicode.storeU16(52,47);calls=0
    if (fatFileOpenPathUtf16(handle,u32(7),unicode,27,1,handleWork).status() != 9 || calls != 2 || handle.loadU32(8) != 0) return i32(27)
    unicode.storeU16(42,0xd800);calls=0
    if (fatFileOpenPathUtf16(handle,u32(7),unicode,26,1,handleWork).status() != 2 || calls != 0) return i32(28)
    longRoot=false
    val spelling=nativeBufferAt(nativeStaticBytes("/d/../d/./a.txt"),15)
    i=0;while (i < 15) { unicode.storeU16(i*2,spelling.load(i));i=i+1 }
    calls=0
    val traversed=fatFileOpenPathUtf16(handle,u32(7),unicode,15,1,handleWork)
    if (traversed.status() != 1 || calls != 4 || handle.loadU32(24) != 2 || !traversed.close(u32(7))) return i32(29)
    calls=0
    val utf8Opened=fatFileOpenPathUtf8(handle,u32(7),spelling,15,converted,1,handleWork)
    if (utf8Opened.status() != 1 || calls != 4 || !utf8Opened.close(u32(7))) return i32(31)
    converted.storeU16(0,123);utf8.store(0,0xc0);utf8.store(1,0xaf);calls=0
    if (fatFileOpenPathUtf8(handle,u32(7),utf8,2,converted,1,handleWork).status() != 2 ||
        calls != 0 || converted.loadU16(0) != 123) return i32(32)
    if (fatFileOpenPathUtf8(handle,u32(7),spelling,15,mountedBoot,1,handleWork).status() != 2 ||
        mountedBoot.loadU16(11) != 512 || calls != 0) return i32(33)
    if (fatFileOpenPathUtf8(handle,u32(7),spelling,15,nativeBufferAt(converted.addressValue(),28),1,handleWork).status() != 2 ||
        converted.loadU16(0) != 123 || calls != 0) return i32(34)
    val multibyte=nativeBufferAt(nativeStaticAllocate(46),46)
    val suffix=nativeBufferAt(nativeStaticBytes("/a.txt"),6)
    var encoding=0;longRoot=true
    while (encoding < 2) {
        longUnit=if (encoding == 0) 233 else 0x1f600
        i=0;while (i < 40) {
            multibyte.store(i,if (encoding == 0) (if ((i&1) == 0) 0xc3 else 0xa9)
                else if ((i&3) == 0) 0xf0 else if ((i&3) == 1) 0x9f else if ((i&3) == 2) 0x98 else 0x80)
            i=i+1
        }
        i=0;while (i < 6) { multibyte.store(40+i,suffix.load(i));i=i+1 }
        calls=0
        val multiFile=fatFileOpenPathUtf8(handle,u32(7),multibyte,46,converted,1,handleWork)
        if (multiFile.status() != 1 || calls != 2 || multiFile.readAt(u32(7),0,7,1,output,handleWork).bytesRead() != 7 ||
            output.load(0) != 97 || !multiFile.close(u32(7))) return i32(35)
        encoding=encoding+1
    }
    longRoot=false;longUnit=76
    failAt=2;calls=0
    if (fatFileOpenPathUtf16(handle,u32(7),unicode,15,1,handleWork).status() != 4 || calls != 2 ||
        handle.loadU32(8) != 0 || state.loadU32(12) != 3 || !volume.invalidate(u32(7))) return i32(30)
    return i32(0)
}
