import "../src/esp32/i2c/sleep_s3_sequence.ab"
import "abla/build"
var sleepGate=0
var sleepBusOpen=true
var sleepBusIdle=true
var sleepReleaseFails=false
var sleepReleaseCalls=0
fun s3I2cSleepHeld(bus: int): bool = sleepGate == 2
fun s3I2cSleepAcquire(bus: int): int {
    if (sleepGate != 0) return if (sleepGate == 0x80000000) 2 else 1
    sleepGate=2;return 0
}
fun s3I2cSleepRelease(bus: int): bool {
    sleepReleaseCalls=sleepReleaseCalls+1
    if (sleepGate != 2 || sleepReleaseFails) return false
    sleepGate=0;return true
}
fun s3I2cSleepBusOpen(bus: int): bool = sleepBusOpen
fun s3I2cSleepIdle(bus: int): bool = sleepBusIdle
@export("abla_i2c_sleep_s3_test")
fun testI2cSleep(): int {
    var profile=0
    while (profile < 6) {
        val key=esp32S3I2cBusKey(profile&1,if (profile < 2) 1 else if (profile < 4) 0x40000000 else 0x7fffffff)
        sleepGate=0;sleepBusOpen=true;sleepBusIdle=true;sleepReleaseFails=false
        var lease=esp32S3I2cPauseForSleepOwned(key)
        if (lease.status() != 1 || !lease.owned() || lease.bus() != key || sleepGate != 2) return 1
        val count=sleepReleaseCalls
        if (lease.resumeOwned(false) != lease || sleepReleaseCalls != count || esp32S3I2cPauseForSleepOwned(key).status() != 3) return 2
        sleepBusIdle=false;lease=lease.resumeOwned(true)
        if (lease.status() != 5 || !lease.owned() || sleepGate != 2) return 3
        sleepBusIdle=true;sleepReleaseFails=true;lease=lease.resumeOwned(true)
        if (lease.status() != 4 || !lease.owned() || sleepGate != 2) return 4
        sleepReleaseFails=false;lease=lease.resumeOwned(true)
        if (lease.status() != 6 || lease.owned() || lease.bus() != key || sleepGate != 0) return 5
        val closedCalls=sleepReleaseCalls
        if (lease.resumeOwned(true) != lease || sleepReleaseCalls != closedCalls) return 6
        sleepBusOpen=false
        if (esp32S3I2cPauseForSleepOwned(key).status() != 2 || sleepGate != 0) return 7
        sleepBusOpen=true;sleepBusIdle=false
        if (esp32S3I2cPauseForSleepOwned(key).status() != 5 || sleepGate != 0) return 8
        sleepGate=0x80000000
        val fault=esp32S3I2cPauseForSleepOwned(key)
        if (fault.status() != 4 || fault.owned() || sleepGate != 0x80000000) return 9
        profile=profile+1
    }
    if (esp32S3I2cPauseForSleepOwned(0).status() != 2 || esp32S3I2cPauseForSleepOwned(0x200000002).status() != 2) return 10
    return 0
}
