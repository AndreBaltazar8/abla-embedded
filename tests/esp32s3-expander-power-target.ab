import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/expander_power.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_expander_power_target")
trusted fun powerTarget(board: M5BoardId,ioe0: I2cDevice,ioe1: I2cDevice,ports: int,enabled: bool): M5ExpanderPowerResult =
    board.setExpanderPower(ioe0,ioe1,ports,enabled)
