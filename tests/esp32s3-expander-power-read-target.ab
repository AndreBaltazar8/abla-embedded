import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/expander_power_read.ab"
import "abla/runtime/scalar"
import "abla/build"
// Cross-board driver codegen check, not evidence these boards have an S3 CPU.
@export("abla_expander_power_read_target")
trusted fun readTarget(board: M5BoardId,ioe0: I2cDevice,ioe1: I2cDevice,port: int): int =
    board.expanderPowerEnabledChecked(ioe0,ioe1,port) | 0
