import "../src/m5stack/rtc_sleep_finish_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Esp32S3SleepResume=int
fun Esp32S3SleepResume.complete(): bool = this == 1
var restored=false
var resumeOk=true
var timerOk=true
var cleanupOk=true
var padsOk=true
var trace=0
var bad=false
fun esp32S3SleepWakeRecordsDisjoint(sleep: NativeBuffer,wake: NativeBuffer): bool = sleep.addressValue() == 4096 && wake.addressValue() == 8192
fun m5RtcCleanupRtcValid(handle: int): bool = handle == 7
fun m5RtcCleanupPmicValid(handle: int): bool = handle == 8
fun m5RtcTimerSupported(handle: int): bool = handle == 7
fun m5RtcSleepCpuRestored(record: NativeBuffer): bool = restored
fun m5RtcSleepResume(record: NativeBuffer,polls: int): Esp32S3SleepResume {
    trace=trace*10+1; restored=resumeOk
    Esp32S3SleepResume(if (resumeOk) 1 else 2)
}
fun m5RtcConfigureTimer(handle: int,duration: int): RtcTimerResult {
    if (!restored || handle != 7 || duration != 0) bad=true
    trace=trace*10+2
    RtcTimerResult(if (timerOk) 1 else 4)
}
fun m5RtcCleanupRtc(handle: int,disable: bool): bool { bad=true; false }
fun m5RtcCleanupWake(handle: int): bool { trace=trace*10+3; cleanupOk }
fun m5RtcCleanupPmicIrq(handle: int): bool { trace=trace*10+4; cleanupOk }
fun esp32S3SleepExternalWakeCleanupOwned(sleep: NativeBuffer,wake: NativeBuffer): bool {
    if (!restored || !timerOk) bad=true
    trace=trace*10+5; padsOk
}
@export("abla_rtc_sleep_finish_test")
trusted fun finishTest(): i32 {
    val sleep=nativeBufferAt(4096,128)
    val wake=nativeBufferAt(8192,176)
    var mode=0
    while (mode < 32) {
        restored=(mode&1) != 0; resumeOk=(mode&2) != 0; timerOk=(mode&4) != 0; cleanupOk=(mode&8) != 0; padsOk=(mode&16) != 0
        val startsRestored=restored
        trace=0; bad=false
        val result=m5RtcSleepFinishS3Owned(m5BoardPaperMono,7,8,sleep,wake,8)
        val status=if (!startsRestored && !resumeOk) 2 else if (!timerOk || !cleanupOk) 3 else if (!padsOk) 4 else 1
        val expected=if (status == 2) 1 else (if (startsRestored) 234 else 1234)*(if (status == 3) 1 else 10)+(if (status == 3) 0 else 5)
        if (result.status() != status || result.complete() != (status == 1) || trace != expected || bad) return i32(1)
        if (status == 2 && result.detail() != 2) return i32(2)
        if (status == 3 && M5RtcTimerResult(result.detail()).timer().status() != (if (timerOk) 1 else 4)) return i32(3)
        // Resume/cleanup retry must not restore CPU twice once already done.
        if (status != 1) {
            val wasRestored=restored
            resumeOk=true; timerOk=true; cleanupOk=true; padsOk=true; trace=0
            if (!m5RtcSleepFinishS3Owned(m5BoardPaperMono,7,8,sleep,wake,8).complete() || trace != (if (wasRestored) 2345 else 12345)) return i32(4)
        }
        mode=mode+1
    }
    trace=0
    if (m5RtcSleepFinishS3Owned(m5BoardPaperMono,7,0,sleep,wake,8).status() != 5 ||
        m5RtcSleepFinishS3Owned(m5BoardToughC5,7,8,sleep,wake,8).status() != 5 ||
        m5RtcSleepFinishS3Owned(m5BoardPaperMono,7,8,sleep,wake,0).status() != 5 || trace != 0) return i32(5)
    i32(0)
}
