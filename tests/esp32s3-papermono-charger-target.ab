import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/papermono_charger.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_papermono_charger_target")
trusted fun chargerTarget(pm1: M5Pm1,ioe: M5Ioe1,bus: I2cBus,charger: I2cDevice,mode: int): int {
    if (mode == 3) return if (ioe.preparePaperMonoCharger()) 1 else 0
    paperMonoCharger(pm1,ioe,bus,charger,mode) | 0
}
