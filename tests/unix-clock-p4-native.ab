import "../src/esp32/unix_time_p4_sequence.ab"
import "../src/m5stack/rtc_clock_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var ticks=0
var timeout=false
var bad=false
var unit=0
var writes=0
fun p4SystemTimerWrite(offset: int,value: int): void {
    if (offset != 4+unit*4 || value != 0x60000000) bad=true
    writes=writes+1;return
}
fun p4SystemTimerRead(offset: int): int {
    if (offset == 4+unit*4) return if (timeout) 0 else 0x20000000
    if (offset == 68+unit*8) return ticks&4294967295
    if (offset == 64+unit*8) return ticks>>>32
    bad=true;return 0
}
@export("abla_unix_clock_p4_test")
trusted fun test(): i32 {
    if (unixTimeSeconds() != -1 || setUnixTimeSeconds(0) || writes != 0) return i32(1)
    while (unit < 2) {
        if (!esp32P4ConfigureUnixClock(16,3,unit) || unixTimeSeconds() != -1) return i32(2)
        ticks=4503599627370490
        if (!m5RtcSynchronizeClock(rtcCalendarDateTime(2000,1,1,0,0,0))) return i32(3)
        ticks=2
        if (unixTimeSeconds() != 946684800) return i32(4)
        ticks=10
        if (unixTimeSeconds() != 946684801) return i32(5)
        timeout=true
        if (unixTimeSeconds() != -1 || setUnixTimeSeconds(123)) return i32(6)
        timeout=false;ticks=26
        if (unixTimeSeconds() != 946684802) return i32(7)
        val before=writes
        if (esp32P4ConfigureUnixClock(0,3,unit) || esp32P4ConfigureUnixClock(16,0,unit) ||
            esp32P4ConfigureUnixClock(16,3,2) || setUnixTimeSeconds(-1) ||
            m5RtcSynchronizeClock(RtcDateTime(0)) || writes != before) return i32(8)
        if (unixTimeSeconds() != 946684802 || !esp32P4ConfigureUnixClock(16,3,unit) || unixTimeSeconds() != -1) return i32(9)
        unit=unit+1
    }
    if (bad) return i32(10)
    return i32(0)
}
