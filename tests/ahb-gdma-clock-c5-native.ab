import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/ahb_gdma_clock_c5_sequence.ab"
var bus=u32(0)
var misc=u32(0)
var writes=0
var drop=0
var atFault=-1
var faultValue=u32(0)
var bad=false
trusted fun c5AhbGdmaBusRead(): u32 = bus
trusted fun c5AhbGdmaBusWrite(value: u32): void { writes=writes+1;if (writes != drop) bus=value;return }
trusted fun c5AhbGdmaRead(at: int): u32 {
    if ((bus&u32(1)) == u32(0)) bad=true
    if (at == atFault) return faultValue
    if (at == 0x64) return misc
    if (at == 0x80 || at == 0x140 || at == 0x200) return u32(16)
    if (at == 0xe0 || at == 0x1a0 || at == 0x260) return u32(8)
    return u32(0)
}
trusted fun c5AhbGdmaWrite(at: int,value: u32): void {
    writes=writes+1
    if (at != 0x64 || ((value^misc)&~u32(8)) != u32(0) || (bus&u32(1)) == u32(0)) bad=true
    if (writes != drop) misc=value
    return
}
@export("abla_ahb_gdma_clock_c5_test")
trusted fun test(): i32 {
    var variant=0
    while (variant < 4) {
        var fault=0
        while (fault < 5) {
            val oldBus=u32(0x80000000)|u32(variant&1)
            val oldMisc=u32(0x80000004)|u32((variant&2)*4)
            bus=oldBus;misc=oldMisc;writes=0;drop=fault
            var owner=c5AhbGdmaClockOpenOwned(true)
            if (owner.status() != 1 && owner.status() != 4 && owner.status() != 6) return i32(1)
            owner=owner.closeOwned(true);drop=0;owner=owner.closeOwned(true)
            if (owner.status() != 7 || bus != oldBus || misc != oldMisc || bad) return i32(2)
            fault=fault+1
        }
        variant=variant+1
    }
    var channel=0
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            var kind=0
            while (kind < 7) {
                val base=0x70+channel*192+direction*96
                bus=u32(1);misc=u32(8);writes=0;drop=0
                var owner=c5AhbGdmaClockOpenOwned(true)
                if (owner.status() != 1) return i32(3)
                atFault=if (kind < 2) base else if (kind < 5) base+16 else channel*16+direction*48+(if (kind == 6) 8 else 0)
                faultValue=if (kind == 0) u32(1) else if (kind == 1) u32(if (direction == 1) 64 else 32) else if (kind == 2) u32(0) else if (kind == 3) u32(if (direction == 1) 10 else 20) else if (kind == 4) u32(if (direction == 1) 12 else 24) else u32(1)
                if (c5AhbGdmaClockOpenOwned(true).status() != 5 || owner.closeOwned(true).status() != 5 || writes != 0) return i32(4)
                atFault=-1
                if (owner.closeOwned(true).status() != 7 || writes != 0) return i32(5)
                kind=kind+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    bus=u32(3);writes=0
    if (c5AhbGdmaClockOpenOwned(true).status() != 3 || c5AhbGdmaClockOpenOwned(false).status() != 2 || writes != 0 || bad) return i32(6)
    return i32(0)
}
