import "../src/esp32/gpio/lease_esp32_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var latch=0
var pinConfig=0
var originalLatch=0
var originalConfig=0
var pin=0
var rtc=255
var mux=0
var route=0
var enable=0
var rtcValue=0
var originalMux=0
var originalRoute=0
var originalEnable=0
var originalRtc=0
var reads=0
var writes=0
var drop=-1
var held=false
var bad=false
fun classicProbeRead(address: int): int {
    reads=reads+1
    if (address == (if (pin < 32) 0x3FF44004 else 0x3FF44010)) return latch
    if (address == 0x3FF44088+pin*4) return pinConfig
    if (address == 0x3FF49000+esp32IoMuxOffset(pin)) return mux
    if (address == 0x3FF44530+pin*4) return route
    if (address == (if (pin < 32) 0x3FF44020 else 0x3FF4402C)) return enable
    if (address == (if (pin < 32) 0x3FF4403C else 0x3FF44040)) return 1<<(pin&31)
    if (address == 0x3FF480C8) return if (held) 0xFFFFFFFF else 0
    if (address == 0x3FF48474) return if (held) 0xFFFFFFFF else 0
    if (rtc < 18 && address == esp32ProbeRtcField(rtc,0)) return rtcValue
    bad=true; return 0
}
fun classicProbeWrite(address: int,value: int): void {
    val n=writes; writes=writes+1
    if (n == drop) return
    val base=if (pin < 32) 0x3FF44020 else 0x3FF4402C
    val out=if (pin < 32) 0x3FF44004 else 0x3FF44010
    if (address == out+4) latch=latch|value
    else if (address == out+8) latch=latch&~value
    else if (address == 0x3FF44088+pin*4) pinConfig=value
    else if (address == 0x3FF49000+esp32IoMuxOffset(pin)) mux=value
    else if (address == 0x3FF44530+pin*4) route=value
    else if (address == base+4 || address == base+8) {
        if (value != (1<<(pin&31))) bad=true
        enable=if (address == base+4) enable|value else enable&~value
    } else if (rtc < 18 && address == esp32ProbeRtcField(rtc,0)) rtcValue=value
    else bad=true
    return
}
@export("abla_gpio_lease_esp32_test")
trusted fun leaseTest(): i32 {
    val r=nativeBufferAt(nativeStaticAllocate(40),40)
    pin=0
    while (pin < 34) {
        if (esp32BasicGpioOutputValid(pin)) {
            rtc=esp32ProbeRtcIndex(pin)
            var mode=0
            while (mode < 32) {
                var fault=-1
                while (fault < 22) {
                    val bit=1<<(pin&31)
                    originalMux=0x81234567^(mode*179);originalRoute=0xfedcba98^(mode*137)
                    originalEnable=if ((mode&1) != 0) 0xffffffff else 0xffffffff&~bit
                    originalLatch=if ((mode&2) != 0) 0xffffffff else 0xffffffff&~bit
                    originalConfig=0xabcdef03|(if ((mode&4) != 0) 4 else 0)
                    originalRtc=0x456789ab
                    if (rtc < 18) originalRtc=originalRtc&~esp32ProbeRtcField(rtc,9)
                    if (pin == 32 || pin == 33) originalRtc=originalRtc&~0x80000
                    mux=originalMux;route=originalRoute;enable=originalEnable;rtcValue=originalRtc
                    latch=originalLatch;pinConfig=originalConfig
                    reads=0;writes=0;drop=fault;held=false;bad=false;r.storeU32(0,0)
                    val output=(mode&8) != 0;val high=(mode&16) != 0
                    val opened=esp32GpioLeaseOpenOwned(r,pin,output,high,mode%3,true)
                    if (opened != 1 && opened != 4) return i32(1)
                    if (fault == -1 && (opened != 1 || (route&4095) != 1280 ||
                        (enable&bit) != (if (output) bit else 0) || (latch&bit) != (if (high) bit else 0) ||
                        (pinConfig&4) != 0 || (mux&0x7202) != 0x2200)) return i32(2)
                    val before=writes
                    if (esp32GpioLeaseCloseOwned(r,false) != 2 || writes != before) return i32(3)
                    val closed=esp32GpioLeaseCloseOwned(r,true)
                    if (closed == 4) {
                        if (r.loadU32(0) != 0x47504c31 || r.loadU32(24) != 4) return i32(4)
                        drop=-1
                        if (esp32GpioLeaseCloseOwned(r,true) != 1) return i32(5)
                    } else if (closed != 1) return i32(6)
                    if (bad || r.loadU32(0) != 0 || mux != originalMux || route != originalRoute ||
                        enable != originalEnable || latch != originalLatch || pinConfig != originalConfig ||
                        rtcValue != originalRtc) return i32(7)
                    fault=fault+1
                }
                mode=mode+1
            }
            held=true;writes=0;drop=-1;r.storeU32(0,0)
            if (rtc < 18 || esp32ProbeDigitalHold(pin) != 0) {
                if (esp32GpioLeaseOpenOwned(r,pin,true,true,0,true) != 3 || writes != 0) return i32(8)
            }
        }
        pin=pin+1
    }
    reads=0;writes=0
    if (esp32GpioLeaseOpenOwned(r,34,false,false,0,true) != 2 ||
        esp32GpioLeaseOpenOwned(r,24,true,false,0,true) != 2 ||
        esp32GpioLeaseOpenOwned(r,2,true,true,0,false) != 2 ||
        esp32GpioLeaseOpenOwned(nativeBufferAt(r.addressValue(),39),2,true,true,0,true) != 2 ||
        reads != 0 || writes != 0) return i32(9)
    i32(0)
}
