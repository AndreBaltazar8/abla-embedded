import "../src/esp32/cache_writeback_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var map=u32(0)
var address=u32(0)
var size=u32(0)
var commands=0
var writes=0
var reads=0
var busy=false
var fail=0
var drop=0
var bad=false
var operation=4
trusted fun p4CacheSyncRead(offset: int): u32 {
    reads=reads+1
    if (offset == 152) return if (busy || (commands > 0 && commands == fail)) u32(4) else u32(16)
    if (offset == 156) return map
    if (offset == 160) return address
    if (offset == 164) return size
    bad=true; return u32(0)
}
trusted fun p4CacheSyncWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 156) map=value
    else if (offset == 160) address=value
    else if (offset == 164) size=value
    else if (offset == 152) {
        if (value != u32(operation) || map != (if (commands < (if (operation == 1) 1 else 2)) u32(16) else u32(32)) ||
            address == u32(0) || size == u32(0)) bad=true
        commands=commands+1
    } else bad=true
    return
}
fun resetCache(): void {
    map=u32(0); address=u32(0); size=u32(0); commands=0; writes=0; reads=0
    busy=false; fail=0; drop=0; bad=false; operation=4; return
}
@export("abla_dsi_p4_cache_test")
trusted fun testCache(): i32 {
    var kind=0
    while (kind < 3) {
        val start=if (kind == 0) 1341128704 else 1207959552
        val line=if (kind == 2) 128 else 64
        val count=if (kind == 0) 2 else 4
        var bytes=1
        while (bytes <= 1024) {
            resetCache()
            if (esp32P4CacheWritebackOwned(nativeBufferAt(start,2048),bytes,line,2) != 1 ||
                bad || commands != count || int(size) != ((bytes+line-1)/line)*line) return i32(1)
            bytes=bytes+1
        }
        var fault=1
        while (fault <= count) {
            resetCache(); fail=fault
            if (esp32P4CacheWritebackOwned(nativeBufferAt(start,2048),512,line,2) != 5 ||
                commands != fault || bad) return i32(2)
            fault=fault+1
        }
        kind=kind+1
    }
    var dropped=1
    while (dropped <= 3) {
        resetCache(); drop=dropped
        if (esp32P4CacheWritebackOwned(nativeBufferAt(1341128704,64),64,64,2) != 4 || commands != 0) return i32(3)
        dropped=dropped+1
    }
    resetCache(); busy=true
    if (esp32P4CacheWritebackOwned(nativeBufferAt(1341128704,64),64,64,2) != 3 || writes != 0) return i32(4)
    resetCache()
    if (esp32P4CacheWritebackOwned(nativeBufferAt(1341915072,64),64,64,1) != 1) return i32(5)
    resetCache()
    if (esp32P4CacheWritebackOwned(nativeBufferAt(1275068288,128),128,128,1) != 1) return i32(6)
    resetCache()
    if (esp32P4CacheWritebackOwned(nativeBufferAt(1341128705,64),8,64,1) != 2 ||
        esp32P4CacheWritebackOwned(nativeBufferAt(1341128704,63),63,64,1) != 2 ||
        esp32P4CacheWritebackOwned(nativeBufferAt(1341915072,128),65,64,1) != 2 ||
        esp32P4CacheWritebackOwned(nativeBufferAt(1207959616,128),64,128,1) != 2 ||
        esp32P4CacheWritebackOwned(nativeBufferAt(1073741824,128),64,64,1) != 2 ||
        esp32P4CacheWritebackOwned(nativeBufferAt(1341128704,64),0,64,1) != 2 ||
        esp32P4CacheWritebackOwned(nativeBufferAt(1341128704,64),64,32,1) != 2 ||
        esp32P4CacheWritebackOwned(nativeBufferAt(1341128704,64),64,64,0) != 2 ||
        writes != 0 || reads != 0) return i32(7)
    var op=0
    while (op < 2) {
        var kind=0
        while (kind < 3) {
            val start=if (kind == 0) 0x4ff00000 else 0x48000000
            val line=if (kind == 2) 128 else 64
            val repeat=if (op == 0) 1 else 2
            val count=(if (kind == 0) 1 else 2)*repeat
            var bytes=1
            while (bytes <= 1024) {
                resetCache(); operation=if (op == 0) 1 else 8
                val buffer=nativeBufferAt(start,2048)
                val result=if (op == 0) esp32P4CacheInvalidateDataOwned(buffer,bytes,line,2) else esp32P4CacheWritebackInvalidateOwned(buffer,bytes,line,2)
                if (result != 1 || bad || commands != count || int(size) != ((bytes+line-1)/line)*line) return i32(8)
                bytes=bytes+1
            }
            var fault=1
            while (fault <= count) {
                resetCache(); operation=if (op == 0) 1 else 8; fail=fault
                if (esp32P4CacheDataSyncOwned(nativeBufferAt(start,128),128,line,2,operation) != 5 || commands != fault || bad) return i32(9)
                fault=fault+1
            }
            kind=kind+1
        }
        op=op+1
    }
    resetCache(); busy=true
    if (esp32P4CacheInvalidateDataOwned(nativeBufferAt(0x48000000,128),128,128,2) != 3 || writes != 0) return i32(10)
    resetCache()
    if (esp32P4CacheDataSyncOwned(nativeBufferAt(0x48000000,128),128,128,2,3) != 2 || writes != 0 || reads != 0) return i32(11)
    return i32(0)
}
