import "../src/esp32/psram/cold_esp32p4.ab"
import "../src/esp32/psram/probe_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_psram_identity_target")
trusted fun identityTarget(dummy: int,scratch: NativeBuffer,work: NativeBuffer,mhz: int,hex16: bool,read: bool,op: int,record: NativeBuffer,polls: int): int {
    if (op == 1) return if (p4PsramColdInitializeOwned(record)) 1 else 0
    if (op == 2) return p4PsramColdStartOwned(record,mhz,hex16,dummy,scratch,work,polls)
    if (op == 3) return p4PsramColdCloseOwned(record,polls)
    if (op == 4) return p4PsramColdProbeOwned(record,dummy,scratch,work)
    val identity=if (read) p4PsramIdentifyOwned(dummy,scratch,work) else p4PsramApplyProfileOwned(mhz,hex16,dummy,scratch,work)
    if (read) return identity
    return if (identity.matchesProfile(mhz,hex16)) identity.physicalBytes() else -identity.status()
}
