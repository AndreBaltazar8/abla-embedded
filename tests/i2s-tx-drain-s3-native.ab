import "../src/esp32/i2s/tx_drain_s3_sequence.ab"
import "abla/build"
var drainPort=0
var drainChannel=0
var drainConfig=0
var drainFlags=0
var drainNext=0
var drainEvents=10
var drainLink=0x800000
var drainFifo=42
var drainIdle=1
var drainEof=0x3FC88000
var drainBad=false
var drainStopFails=false
var drainStops=0
var drainFences=0
fun esp32s3GdmaDescriptorValid(address: int): bool = address == 0x3FC88000
fun esp32s3I2sClockRead(address: int): int {
    if (address == 0x6000F024+drainPort*0x1E000) return drainConfig
    if (address == 0x6000F06C+drainPort*0x1E000) return drainIdle
    drainBad=true;return 0
}
fun esp32s3I2sClockField(address: int,mask: int,value: int): void {
    if (address != 0x6000F024+drainPort*0x1E000 || mask != 8192) drainBad=true
    drainConfig=(drainConfig&(~mask))|(value&mask);return
}
fun esp32s3GdmaRead(address: int): int {
    if (address == 0x3FC88000) return drainFlags
    if (address == 0x3FC88008) return drainNext
    val offset=address-(0x6003F060+drainChannel*192)
    if (offset == 8) return drainEvents
    if (offset == 40) return drainEof
    if (offset == 32) return drainLink
    if (offset == 24) return drainFifo
    drainBad=true;return 0
}
fun esp32s3GdmaPublish(): void { drainFences=drainFences+1;return }
fun esp32s3I2sStopDirection(port: int,transmit: bool): bool {
    if (port != drainPort || !transmit || drainIdle != 1 || drainFifo != 42 || drainFences == 0) drainBad=true
    drainStops=drainStops+1
    if (!drainStopFails) drainConfig=drainConfig&(~4)
    return true
}
@export("abla_i2s_tx_drain_s3_test")
fun testTxDrain(): int {
    var profile=0
    while (profile < 130) {
        drainPort=profile&1;drainChannel=(profile/2)%5;val fault=profile/10
        drainConfig=0;drainBad=false;drainStops=0;drainFences=0;drainStopFails=false
        if (!esp32s3I2sSetTxDrainMode(drainPort,true) || drainConfig != 8192) return 1
        drainConfig=drainConfig|4
        if (esp32s3I2sSetTxDrainMode(drainPort,false) || drainConfig != 8196) return 2
        drainFlags=0x40010010;drainNext=0;drainEvents=10;drainLink=0x800000;drainFifo=42;drainIdle=1;drainEof=0x3FC88000
        if (fault == 1) drainEvents=2
        if (fault == 2) drainFlags=drainFlags|0x80000000
        if (fault == 3) drainLink=0
        if (fault == 4) drainFifo=106
        if (fault == 5) drainIdle=0
        if (fault == 6) drainEof=0x3FC8800C
        if (fault == 7) drainEvents=14
        if (fault == 8) drainNext=0x3FC88000
        if (fault == 9) drainConfig=4
        if (fault == 10) drainStopFails=true
        if (fault == 11) drainLink=0xA00000
        if (fault == 12) drainFlags=0x40011010
        val result=esp32s3I2sFinishTxStream(drainPort,drainChannel,0x3FC88000,3)
        val expected=if (fault == 0) 1 else if (fault == 7) 4 else if (fault == 8 || fault == 12) 2 else if (fault == 9) 3 else if (fault == 10) 6 else 5
        if (result != expected || drainBad || drainStops != (if (fault == 0 || fault == 10) 1 else 0)) return 3
        if (result != 1 && (drainConfig&4) == 0) return 4
        if (fault == 10) {
            drainStopFails=false
            if (esp32s3I2sFinishTxStream(drainPort,drainChannel,0x3FC88000,1) != 1) return 5
        }
        profile=profile+1
    }
    return 0
}
