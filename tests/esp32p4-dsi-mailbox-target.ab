import "../src/display/dsi_mailbox_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_mailbox_target")
trusted fun target(box: P4DsiMailbox,table: P4IrqDispatch,op: int): int {
    if (op == 0) return box.bindOwned(table,false)
    if (op == 1) return box.bindOwned(table,true)
    if (op == 2) return box.takeOwned()
    return box.resumeOwned()
}
