import "../src/m5stack/cores3_audio_power_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Axp2101 = int
type Aw9523 = int
type Aw88298 = int
type Es7210 = int
fun Axp2101.valid(): bool = this != 0
fun Aw9523.valid(): bool = this != 0
fun Aw88298.valid(): bool = this != 0
fun Es7210.valid(): bool = this != 0
type TestQuiet = int
fun TestQuiet.valid(): bool = (this & 255) == 1
var order = 0
var failedStage = 0
var speakerResult = 257
var micResult = 1
var bad = false
trusted fun cores3ConfigureExpander(device: Aw9523, external: bool): bool {
    if (external) bad = true
    order = order * 10 + 1; failedStage != 1
}
trusted fun cores3ConfigurePmic(device: Axp2101): bool { order = order * 10 + 2; failedStage != 2 }
trusted fun cores3SpeakerDisable(amp: Aw88298, expander: Aw9523): TestQuiet { order = order * 10 + 3; TestQuiet(speakerResult) }
trusted fun cores3MicrophoneDisable(mic: Es7210): TestQuiet { order = order * 10 + 4; TestQuiet(micResult) }
trusted fun audioPowerTest(): int {
    while (failedStage < 3) {
        var failures = 0
        while (failures < 4) {
            speakerResult = if ((failures & 1) != 0) 1797 else 257
            micResult = if ((failures & 2) != 0) 4 else 1
            order = 0
            val result = cores3InitializeAudioPower(Axp2101(1), Aw9523(1), Aw88298(1), Es7210(1))
            val expected = if (failedStage == 1) 3 else if (failedStage == 2) 4 else if (failures != 0) 5 else 1
            if (result.status() != expected || result.speakerStatus() != speakerResult ||
                result.microphoneStatus() != micResult || order != (if (failedStage == 1) 134 else 1234) || bad) return 1
            failures = failures + 1
        }
        failedStage = failedStage + 1
    }
    order = 0
    if (cores3InitializeAudioPower(Axp2101(0), Aw9523(1), Aw88298(1), Es7210(1)).status() != 2 || order != 0) return 2
    0
}
#exportFunction("audioPowerTest", "abla_cores3_audio_power_test")
