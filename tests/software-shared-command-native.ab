import "../src/spi/software_shared_command.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
import "../src/hal/delay.ab"
import "../src/hal/pin.ab"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_pin_valid")
fun pinValidHook(pin: int): bool = Pin(pin) >= 1 && Pin(pin) <= 4
@export("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin).valid()
val gateStorage = nativeStaticMutableU32s([0])
val bytes = nativeStaticBytes("\xa5")
var selected = false
var driven = false
var dataMode = true
var outputHigh = false
var bits = 0
var captured = 0
var activity = 0
var bad = false
trusted fun checkOwner(): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    return
}
@export("abla_pin_write")
trusted fun pinWriteHook(pin: int, high: bool): void {
    checkOwner()
    if (Pin(pin) == 2) outputHigh = high
    if (Pin(pin) == 4) dataMode = high
    if (Pin(pin) == 3) {
        if (!driven || selected == !high || (!high && dataMode)) bad = true
        selected = !high
    }
    if (Pin(pin) == 1 && selected && high) {
        if (!driven || dataMode != (bits >= 8)) bad = true
        captured = (captured << 1) | (if (outputHigh) 1 else 0)
        bits = bits + 1
    }
    return
}
@export("abla_pin_output")
trusted fun pinOutputHook(pin: int): void {
    checkOwner()
    if (Pin(pin) != 4 || driven || selected || dataMode) bad = true
    driven = true
    return
}
@export("abla_pin_input")
trusted fun pinInputHook(pin: int): void {
    checkOwner()
    if (Pin(pin) != 4 || !driven || selected || !dataMode) bad = true
    driven = false
    return
}
@export("abla_pin_read")
fun pinReadHook(pin: int): bool { bad = true; false }
@export("peripheralDelayMicroseconds")
fun peripheralDelayMicrosecondsHook(duration: int): void { bad = true; return }
@export("abla_shared_command_native_test")
trusted fun sharedCommandNativeTest(): i32 {
    val gate = peripheralGateAt(gateStorage)
    val payload = nativeBufferAt(bytes, 1)
    var iteration = 0
    while (iteration < 2) {
        bits = 0
        captured = 0
        val result = softwareSpiSharedCommand(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), 54, payload, 1, 0, 0)
        if (!result.valid() || bad || driven || selected || bits != 16 || captured != 0x36a5 ||
            nativeAddressLoadU32(gateStorage, 0) != 0) return i32(1)
        iteration = iteration + 1
    }
    activity = 0
    if (softwareSpiSharedCommand(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), 256, payload, 1, 0, 0).status() != 3 || activity != 0) return i32(2)
    if (gate.tryBegin(u32(9)) != 0) return i32(3)
    if (softwareSpiSharedCommand(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), 54, payload, 1, 0, 0).status() != 2 || activity != 0) return i32(4)
    if (!gate.finish(u32(9), false)) return i32(5)
    if (softwareSpiSharedCommand(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), 54, payload, 1, 0, 0).status() != 4 || activity != 0 || driven) return i32(6)
    i32(0)
}
