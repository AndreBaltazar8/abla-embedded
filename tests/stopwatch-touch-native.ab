import "../src/m5stack/stopwatch_touch_logic.ab"
import "../src/m5stack/stopwatch_touch_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var irqCalls=0
var allocations=0
var irqOkay=true
var handle=17
fun stopWatchTouchAdmission(control: int): bool = control == 7
fun stopWatchTouchPrepareIrq(): bool { irqCalls=irqCalls+1;return irqOkay }
fun stopWatchTouchAllocate(control: int): int { allocations=allocations+1;return if (control == 7 && irqCalls == 1) handle else 0 }
fun cst816sRead(handle: int,register: int,buffer: NativeBuffer,count: int): bool = false
fun cst816sWrite(handle: int,register: int,value: int): bool = false
fun cst816sSessionRelease(handle: int): bool = false
@export("abla_stopwatch_touch_test")
trusted fun test(): i32 {
    if (stopWatchTouchOpenOwned(7,false).handle() != 0 || stopWatchTouchOpenOwned(0,true).handle() != 0 || irqCalls != 0 || allocations != 0) return i32(1)
    irqOkay=false
    if (stopWatchTouchOpenOwned(7,true).handle() != 0 || irqCalls != 1 || allocations != 0) return i32(2)
    irqOkay=true;irqCalls=0
    val session=stopWatchTouchOpenOwned(7,true)
    if (session.handle() != 17 || session.initialized() || session.fresh() || session.status() != 0 || allocations != 1) return i32(3)
    handle=0;irqCalls=0
    if (stopWatchTouchOpenOwned(7,true).handle() != 0 || allocations != 2) return i32(4)
    var x=0
    while (x < 234) {
        var y=0
        while (y < 234) {
            var r=0
            while (r < 8) {
                val point=touchPoint(x,y,9,2,7).forStopWatchDisplay(r)
                val a=x*467/233;val b=y*467/233
                val u=if ((r&1) == 0) a else b
                val v=if ((r&1) == 0) b else a
                if (!point.valid() || point.x() != (if ((r&2) == 0) u else 467-u) ||
                    point.y() != (if (r == 1 || r == 2 || r == 4 || r == 7) 467-v else v) ||
                    point.id() != 9 || point.event() != 2 || point.size() != 7) return i32(5)
                r=r+1
            }
            y=y+1
        }
        x=x+1
    }
    if (TouchPoint(0).forStopWatchDisplay(0).valid() || touchPoint(234,0,0,0).forStopWatchDisplay(0).valid() ||
        touchPoint(0,234,0,0).forStopWatchDisplay(0).valid() || touchPoint(0,0,0,0).forStopWatchDisplay(8).valid()) return i32(6)
    return i32(0)
}
