import "../src/esp32/i2c/device_clock_s3_sequence.ab"
import "../src/i2c/software_devices.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(32)
var unexpected=false
fun softwareI2cDrive(pin: int,released: bool): void { unexpected=true;return }
fun softwareI2cSample(pin: int): bool { unexpected=true;return false }
fun softwareI2cDelay(us: int): void { unexpected=true;return }
@export("abla_i2c_device_clock_test")
trusted fun test(): i32 {
    val pool=i2cInitializeDeviceSlots(memory,2)
    val bus=esp32S3I2cBusKey(1,2147483647)
    val initial=esp32S3I2cDeviceKey(1,104,400000,2147483647)
    val handle=pool.allocate(initial)
    val second=pool.allocate(123)
    if (!pool.replace(second,123,0xabcdef123456) || pool.replace(second,123,456) ||
        pool.replace(second,0xabcdef123456,0) || pool.resolve(second) != 0xabcdef123456) return i32(1)
    var hz=1000
    while (hz <= 1000000) {
        val prior=pool.resolve(handle)
        val valid=esp32S3I2cTiming(u32(40000000),u32(hz)).valid()
        if (esp32S3I2cDeviceFrequencyOwned(pool,handle,bus,u32(40000000),hz) != valid) return i32(2)
        val current=pool.resolve(handle)
        if ((valid && (esp32S3I2cDeviceKeyFrequency(current) != hz ||
            !esp32S3I2cDeviceKeyMatchesBus(current,bus) || esp32S3I2cDeviceKeyAddress(current) != 104)) ||
            (!valid && current != prior)) return i32(3)
        hz=hz+997
    }
    val before=pool.resolve(handle)
    if (esp32S3I2cDeviceFrequencyOwned(pool,handle,esp32S3I2cBusKey(1,1),u32(40000000),100000) ||
        esp32S3I2cDeviceFrequencyOwned(pool,handle,bus,u32(0),100000) ||
        esp32S3I2cDeviceFrequencyOwned(pool,handle,bus,u32(40000000),1000001) ||
        pool.resolve(handle) != before) return i32(4)
    nativeAddressStoreU32(memory,0,9)
    if (pool.replace(handle,before,1)) return i32(5)
    nativeAddressStoreU32(memory,0,0)
    if (!pool.release(handle)) return i32(6)
    val lines=softwareI2cLines(3,4,5,2000)
    val soft=lines.deviceOwned(pool,104,400000)
    if (soft == handle || pool.replace(handle,before,1)) return i32(7)
    hz=1000
    while (hz <= 400000) {
        if (!lines.setDeviceFrequencyOwned(pool,soft,hz)) return i32(8)
        val descriptor=pool.resolve(soft)
        val half=(descriptor>>>16)&1023
        if (!lines.matchesDevice(descriptor) || ((descriptor>>>46)&127) != 104 ||
            500000 > hz*half || half < 5) return i32(9)
        hz=hz+997
    }
    val saved=pool.resolve(soft)
    if (softwareI2cLines(5,6,5,2000).setDeviceFrequencyOwned(pool,soft,100000) ||
        lines.setDeviceFrequencyOwned(pool,soft,999) || lines.setDeviceFrequencyOwned(pool,soft,400001) ||
        pool.resolve(soft) != saved || unexpected) return i32(10)
    return i32(0)
}
