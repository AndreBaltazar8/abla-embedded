import "abla/compiler"

val target = #compilerDefineTarget(
    "esp32-xtensa-test",
    "xtensa-esp-unknown-elf",
    "elf",
    "none",
    "none",
    false,
    false
)

val built = #compilerBuildProgram(
    "abla-embedded-xtensa-instruction-test",
    "tests/xtensa-instruction-parser.ab",
    "build/tests/xtensa-instruction-parser-target.o",
    "esp32-xtensa-test",
    "object",
    false,
    false
)

fun main: int = if (target && built) 0 else 1
