import "../src/m5stack/corep4x_speaker_session_sequence.ab"
import "../src/esp32/i2s/dma_session_p4_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
import "abla/build"
type Es8311=int
type M5Ioe1=int
fun Es8311.valid(): bool = this == 7
fun M5Ioe1.valid(): bool = this == 8
val memory=nativeStaticAllocate(256)
var capture=1
var close=2
var capturedCalls=0
var closedCalls=0
var enginesIdle=true
var prepared=1
var enable=1
var disable=1
var started=1
var stopped=1
var idle=true
var calls=0
var enabledCalls=0
var disabledCalls=0
var dmaStarts=0
var dmaStops=0
var bad=false
var pump=1|(64 << 16)|0x10000000
trusted fun p4AhbDescriptorWrite(a: int,v: int): void { bad=true;return }
trusted fun p4CoreSessionPinsCapture(r: NativeBuffer,revision: int): int {
    if (revision != 100 || !r.hasAddressRange(0,64) || enabledCalls != 0) bad=true
    capturedCalls=capturedCalls+1;return capture
}
trusted fun p4CoreSessionPinsClose(r: NativeBuffer): int {
    if (!idle || !enginesIdle || (enabledCalls != 0 && (disabledCalls == 0 || disable != 1)) ||
        (dmaStarts != 0 && (dmaStops == 0 || stopped != 1))) bad=true
    closedCalls=closedCalls+1;return close
}
trusted fun p4CoreSpeakerI2sStopped(): bool = enginesIdle
trusted fun p4CoreSpeakerParked(channel: int): int { if (channel != 1) bad=true;return if (enginesIdle) 1 else 0 }
trusted fun coreP4xPrepareSpeakerDmaOwned(c: int,d: int,n: int,b: int,s: int,bytes: int,rev: int,p: int,e: bool): int {
    if (c != 1 || d != 0x4ff00000 || n != 3 || b != 0x4ff40000 || s != 128 || bytes != 64 || rev != 100 || p != 7 || !e) bad=true
    if (capturedCalls != 1 || capture != 1) bad=true
    calls=calls+1;return prepared
}
trusted fun coreP4xSpeakerOwned(codec: Es8311,io: M5Ioe1,on: bool,e: bool): int {
    if (codec != 7 || io != 8 || !e) bad=true
    calls=calls+1
    if (on) { enabledCalls=enabledCalls+1;return enable }
    disabledCalls=disabledCalls+1;return disable
}
trusted fun p4I2sSessionDmaStart(r: NativeBuffer): int {
    if (enabledCalls != 1 || enable != 1) bad=true
    calls=calls+1;dmaStarts=dmaStarts+1;return started
}
trusted fun p4I2sSessionI2sStart(r: NativeBuffer): int { calls=calls+1;return 1 }
trusted fun p4I2sSessionI2sStop(r: NativeBuffer): int { if (disabledCalls == 0) bad=true;calls=calls+1;return 1 }
trusted fun p4I2sSessionDmaStop(r: NativeBuffer): int { if (disabledCalls == 0) bad=true;calls=calls+1;dmaStops=dmaStops+1;return stopped }
trusted fun p4I2sSessionPump(r: NativeBuffer,cpu: NativeBuffer): int { calls=calls+1;return pump }
trusted fun p4I2sSessionCacheIdle(): bool { calls=calls+1;return idle }
trusted fun p4I2sSessionStoppedFence(): void { if (!idle) bad=true;return }
trusted fun reset(r: NativeBuffer): void {
    r.storeU32(0,0);r.storeU32(64,0);r.storeU32(128,0)
    capture=1;close=2;capturedCalls=0;closedCalls=0;enginesIdle=true
    prepared=1;enable=1;disable=1;started=1;stopped=1;idle=true
    calls=0;enabledCalls=0;disabledCalls=0;dmaStarts=0;dmaStops=0;bad=false
    return
}
trusted fun prepare(r: NativeBuffer): int = coreP4xSpeakerPrepareOwned(r,Es8311(7),M5Ioe1(8),1,0x4ff00000,3,0x4ff40000,128,64,100,7,true)
@export("abla_corep4x_speaker_session_test")
trusted fun test(): i32 {
    val r=nativeBufferAt((memory+63)&0xffffffc0,192)
    val cpu=nativeBufferAt(0x20000000,64)
    reset(r)
    if (prepare(r) != 1 || coreP4xSpeakerStartOwned(r,true) != 2 || bad) return i32(1)
    var n=0
    while (n < 10) {
        if (coreP4xSpeakerPumpOwned(r,cpu,true) != 2 || r.loadU32(40) != (n+1)%3) return i32(2)
        n=n+1
    }
    calls=0
    if (coreP4xSpeakerPumpOwned(r,nativeBufferAt(r.addressValue()+64,64),true) != 0 || calls != 0) return i32(3)
    if (coreP4xSpeakerPumpOwned(r,nativeBufferAt(r.addressValue()+128,64),true) != 0 || calls != 0) return i32(19)
    pump=5|(64 << 16)|0xb0000000|(128 << 32)
    if (coreP4xSpeakerPumpOwned(r,cpu,true) != 3 || r.loadU32(68) != 3 || r.loadU32(52) != 128) return i32(4)
    calls=0
    if (coreP4xSpeakerPumpOwned(r,cpu,true) != 0 || coreP4xSpeakerStartOwned(r,true) != 0 || calls != 0) return i32(5)
    disable=9
    if (coreP4xSpeakerStopOwned(r,true) != 3 || dmaStops != 1 || r.loadU32(80) != 1 || r.loadU32(4) != 4 || closedCalls != 0) return i32(6)
    disable=1
    if (coreP4xSpeakerStopOwned(r,true) != 4 || dmaStops != 1 || r.loadU32(80) != 0 || r.loadU32(52) != 128 || closedCalls != 1 || bad) return i32(7)
    calls=0
    if (coreP4xSpeakerStopOwned(r,true) != 4 || calls != 0 || closedCalls != 1) return i32(8)
    var defect=2
    while (defect <= 11) {
        reset(r);prepared=defect
        if (prepare(r) != 3 || r.loadU32(84) != defect || enabledCalls != 0) return i32(9)
        idle=false
        if (coreP4xSpeakerStopOwned(r,true) != 3) return i32(10)
        idle=true
        if (coreP4xSpeakerStopOwned(r,true) != 4 || disabledCalls != 0 || dmaStops != 0 || bad) return i32(11)
        reset(r);enable=defect
        if (prepare(r) != 1 || coreP4xSpeakerStartOwned(r,true) != 3 || dmaStarts != 0 || r.loadU32(80) != 1) return i32(12)
        if (coreP4xSpeakerStopOwned(r,true) != 4 || disabledCalls != 1 || bad) return i32(13)
        defect=defect+1
    }
    reset(r);started=8
    if (prepare(r) != 1 || coreP4xSpeakerStartOwned(r,true) != 3) return i32(14)
    stopped=3
    if (coreP4xSpeakerStopOwned(r,true) != 3 || r.loadU32(80) != 0) return i32(15)
    stopped=1
    if (coreP4xSpeakerStopOwned(r,true) != 4 || disabledCalls != 1 || bad) return i32(16)
    reset(r);r.storeU32(0,0x50345331)
    if (prepare(r) != 0 || calls != 0) return i32(17)
    reset(r)
    capture=0
    if (prepare(r) != 3 || calls != 0 || r.loadU32(100) != 0 ||
        coreP4xSpeakerStopOwned(r,true) != 4 || closedCalls != 0) return i32(20)
    reset(r);prepared=9
    if (prepare(r) != 3) return i32(21)
    enginesIdle=false
    if (coreP4xSpeakerStopOwned(r,true) != 3 || closedCalls != 0) return i32(22)
    enginesIdle=true;close=3
    if (coreP4xSpeakerStopOwned(r,true) != 3 || r.loadU32(104) != 3 || r.loadU32(100) != 1) return i32(23)
    close=2
    if (coreP4xSpeakerStopOwned(r,true) != 4 || closedCalls != 2 || r.loadU32(100) != 0 || bad) return i32(24)
    reset(r);r.storeU32(128,0x49325034)
    if (prepare(r) != 0 || capturedCalls != 0) return i32(25)
    reset(r)
    if (coreP4xSpeakerPrepareOwned(r,Es8311(0),M5Ioe1(8),1,0x4ff00000,3,0x4ff40000,128,64,100,7,true) != 0 ||
        coreP4xSpeakerPrepareOwned(r,Es8311(7),M5Ioe1(8),1,0x4ff00000,3,0x4ff40000,128,64,100,7,false) != 0 || calls != 0) return i32(18)
    return i32(0)
}
