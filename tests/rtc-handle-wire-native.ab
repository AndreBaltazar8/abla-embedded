import "./pm1-control-wire-native.ab"
import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "../src/rtc/powerhub_device.ab"
@export("abla_rtc_handle_wire_test")
trusted fun testRtcHandle(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    if (!device.valid()) return i32(1)
    val handle=device|0;val scratch=nativeBufferAt(nativeStackAllocate(16),16)
    val date=rtcDate(2024,2,29,4);val time=rtcTime(12,34,56)
    val full=rtcDateTime(2024,2,29,4,12,34,56)
    var sample=0
    while (sample < 36) {
        val raw=if (sample == 0) 0 else if (sample == 1) -1 else if (sample == 2) 4294967296 else if (sample == 3) -9223372036854775807-1 else handle|(1<<(sample+28))
        val a=Pcf8563(raw);val b=Rx8130(raw);val c=PowerHubRtc(raw)
        var at=0;while (at < 16) { scratch.store(at,165);at=at+1 }
        val before=ackCount
        if (a.valid() || b.valid() || c.valid() || a.begin() || b.begin() || c.begin()) return i32(2)
        if (a.dateTimeWithBuffer(scratch).valid() || b.dateTimeWithBuffer(scratch).valid() || c.dateTimeWithBuffer(scratch).valid()) return i32(3)
        if (a.dateWithBuffer(scratch).valid() || b.dateWithBuffer(scratch).valid() || c.dateWithBuffer(scratch).valid() || a.timeWithBuffer(scratch).valid() || b.timeWithBuffer(scratch).valid() || c.timeWithBuffer(scratch).valid()) return i32(4)
        if (a.setDateTimeWithBuffer(full,scratch) || b.setDateTimeWithBuffer(full,scratch) || c.setDateTimeWithBuffer(full,scratch) || a.setDateWithBuffer(date,scratch) || b.setDateWithBuffer(date,scratch) || c.setDateWithBuffer(date,scratch) || a.setTimeWithBuffer(time,scratch) || b.setTimeWithBuffer(time,scratch) || c.setTimeWithBuffer(time,scratch)) return i32(5)
        if (a.lowVoltageChecked().valid() || b.lowVoltageChecked().valid() || c.lowVoltageChecked().valid() || a.close() || b.close() || c.close() || ackCount != before || bad) return i32(6)
        at=0;while (at < 16) { if (scratch.load(at) != 165) return i32(7);at=at+1 }
        // An invalid alias must not close the actual device.
        if (!device.writeRegister8(200,sample)) return i32(8)
        sample=sample+1
    }
    if (!Pcf8563(1).valid() || !Rx8130(4294967295).valid() || !PowerHubRtc(handle).valid()) return i32(9)
    if (!device.close() || !bus.close() || pads != 0 || bad) return i32(10)
    return i32(0)
}
