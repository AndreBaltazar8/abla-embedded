import "../src/imu/calibration_startup.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_calibration_ownership_test")
trusted fun ownershipTest(): i32 {
    val memory=nativeStaticAllocate(256);val bytes=nativeBufferAt(memory,256)
    val state=imuCalibrationAt(memory+64)
    var offset=-35
    while (offset < 120) {
        val offsets=imuOffsetsAt(memory+64+offset)
        var index=0
        while (index < 256) { bytes.store(index,(index*13+7)&255);index=index+1 }
        if (state.acceptsOffsets(offsets)) return i32(1)
        var sensor=0
        while (sensor < 3) {
            if (state.initializeSensor(sensor,imuAxes(1,2,3),offsets) ||
                state.calibrateSensor(sensor,offsets) || state.update(sensor,imuAxes(1,2,3),offsets) != 0) return i32(2)
            sensor=sensor+1
        }
        if (state.prepareStartup(offsets,false) || state.prepareStartup(offsets,true)) return i32(3)
        index=0
        while (index < 256) {
            if (bytes.load(index) != ((index*13+7)&255)) return i32(4)
            index=index+1
        }
        offset=offset+1
    }
    if (!state.acceptsOffsets(imuOffsetsAt(memory+28)) || !state.acceptsOffsets(imuOffsetsAt(memory+184))) return i32(5)
    if (state.acceptsOffsets(ImuOffsets(0)) || ImuCalibration(0).acceptsOffsets(imuOffsetsAt(memory))) return i32(6)
    return i32(0)
}
