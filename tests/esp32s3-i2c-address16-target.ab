import "../src/esp32/i2c_esp32s3.ab"
import "../src/i2c/register_address16.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_i2c_address16_test")
trusted fun address16TargetTest(handle: int, register: i32, value: i32): int {
    val device = I2cDevice(handle)
    if (value >= i32(0)) return if (device.writeRegisterAddress16Byte(int(register), int(value))) 0 else -1
    val result = device.readRegisterAddress16ByteChecked(int(register))
    if (result.valid()) result.value() else -1
}
