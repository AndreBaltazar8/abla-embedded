import "../src/m5stack/pm1_external_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var latch=0
var trace=0
var failure=0
var bad=false
var expectedEnabled=false
var boost=false
fun pm1ExternalSetPin(handle: int,pin: int,enabled: bool): bool {
    trace=trace*10+pin+1
    if (handle != 7 || enabled != expectedEnabled) bad=true
    if (failure == pin+1) return false
    latch=(latch & ~(1<<pin))|(if (enabled) 1<<pin else 0)
    true
}
fun pm1ExternalSetRail(handle: int,enabled: bool): bool {
    trace=trace*10+7
    if (handle != 7 || enabled != expectedEnabled) bad=true
    failure != 7
}
fun pm1ExternalLatch(handle: int): I2cByteResult {
    trace=trace*10+5
    if (handle != 7) bad=true
    if (failure == 5) I2cByteResult(0) else I2cByteResult(256|latch)
}
fun pm1ExternalBoost(handle: int,enabled: bool): bool {
    trace=trace*10+6
    if (handle != 8 || enabled != ((latch & 9) != 0)) bad=true
    if (failure == 6) return false
    boost=enabled
    true
}
@export("abla_pm1_external_test")
fun externalTest(): i32 {
    var profile=0
    while (profile < 32768) {
        val ports=profile & 7
        expectedEnabled=(profile & 8) != 0
        val initial=(profile>>>4)&255
        failure=(profile>>>12)&7
        latch=initial; trace=0; bad=false; boost=true
        val result=m5BoardChainCaptain.setPm1ExternalOwned(7,8,ports,expectedEnabled)
        var wanted=initial; var path=0; var applied=0; var status=1
        if ((ports & 1) != 0) {
            path=1
            if (failure == 1) status=5
            else { wanted=(wanted & ~1)|(if (expectedEnabled) 1 else 0); applied=1 }
        }
        if (status == 1 && (ports & 6) != 0) {
            path=path*10+4
            if (failure == 4) status=5
            else { wanted=(wanted & ~8)|(if (expectedEnabled) 8 else 0); applied=applied|6 }
        }
        if (status == 1 && ports != 0) {
            path=path*10+5
            if (failure == 5) status=6
            else { path=path*10+6; if (failure == 6) status=7 }
        }
        if (result.status() != status || result.appliedPorts() != applied || trace != path || latch != wanted || bad) return i32(1)
        if (status == 1 && ports != 0 && boost != ((wanted & 9) != 0)) return i32(2)
        if ((status != 1 || ports == 0) && !boost) return i32(3)
        profile=profile+1
    }
    var boardIndex=0
    while (boardIndex < 5) {
        val board=if (boardIndex == 0) m5BoardToughC5 else if (boardIndex == 1) m5BoardStickS3 else
            if (boardIndex == 2) m5BoardStopWatch else if (boardIndex == 3) m5BoardPaperColor else m5BoardStampS3Bat
        var mode=0
        while (mode < 4) {
            expectedEnabled=(mode & 1) != 0
            val stage=if (boardIndex == 4) 2 else 7
            failure=if (mode < 2) 0 else stage
            trace=0; bad=false
            val result=board.setPm1ExternalOwned(7,0,1,expectedEnabled)
            if (result.status() != (if (failure == 0) 1 else 5) || result.appliedPorts() != (if (failure == 0) 1 else 0) || trace != stage || bad) return i32(4)
            mode=mode+1
        }
        boardIndex=boardIndex+1
    }
    trace=0
    if (m5BoardChainCaptain.setPm1ExternalOwned(7,0,1,true).status() != 3 ||
        m5BoardChainCaptain.setPm1ExternalOwned(4294967296,8,1,true).status() != 3 ||
        m5BoardChainCaptain.setPm1ExternalOwned(7,8,8,true).status() != 4 ||
        m5BoardStickS3.setPm1ExternalOwned(7,0,2,true).status() != 4 ||
        m5BoardStickS3.setPm1ExternalOwned(7,0,-1,true).status() != 4 ||
        M5BoardId(0).setPm1ExternalOwned(7,8,1,true).status() != 2 || trace != 0) return i32(5)
    i32(0)
}
