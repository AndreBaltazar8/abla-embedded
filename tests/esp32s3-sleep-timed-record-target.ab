import "../src/esp32/power/sleep_timed_record_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_timed_record_target")
trusted fun timedTarget(record: NativeBuffer,flags: int,period: int,duration: int,wake: int,reject: int): int =
    esp32S3SleepTimedRecordEnterOwned(record,flags,period,duration,wake,reject)
