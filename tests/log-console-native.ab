import "../src/display/log_console.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(800)
@export("abla_log_console_test")
trusted fun test(): i32 {
    val frame=nativeBufferAt(storage,768)
    val text=nativeBufferAt(storage+768,1)
    text.store(0,65)
    var level=0
    while (level <= 5) {
        val cursor=textCursor().logRgb565Owned(frame,24,16,48,text,1,level,true,0x1234,0,1)
        if (!cursor.valid() || cursor.column() != 0 || cursor.row() != 1) return i32(1)
        // A column0 bit2 is set; column0 bit0 is clear.
        val expected=if (level == 0) 0x1234 else displayLogColor565(level)
        if ((frame.load(96)<<8|frame.load(97)) != expected || frame.load(0) != 0 || frame.load(1) != 0) return i32(2)
        level=level+1
    }
    if (displayLogColor565(1) != 0xf800 || displayLogColor565(2) != 0xffe0 || displayLogColor565(4) != 0x7ff) return i32(3)
    val plain=textCursor().logRgb565Owned(frame,24,16,48,text,1,1,false,0x1234,0,0)
    if (plain.column() != 1 || plain.row() != 0 || (frame.load(96)<<8|frame.load(97)) != 0x1234) return i32(4)
    frame.store(0,42)
    if (plain.logRgb565Owned(frame,24,16,48,text,1,6,true,1,0,1).valid() || plain.logRgb565Owned(frame,24,16,48,text,1,1,true,1,0,3).valid() || frame.load(0) != 42) return i32(5)
    return i32(0)
}
