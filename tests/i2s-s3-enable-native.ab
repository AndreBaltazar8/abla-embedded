import "../src/esp32/i2s/clock_enable_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var port = 0
var transmit = false
var activate = false
var active = 0
var writes = 0
var reads = 0
var bad = false
trusted fun esp32s3I2sClockRead(address: int): int {
    val base = 0x6000f000 + port * 0x1e000
    if (address != base + 32 && address != base + 36) bad = true
    reads = reads + 1
    active
}
trusted fun esp32s3I2sClockField(address: int, mask: int, value: int): void {
    val base = 0x6000f000 + port * 0x1e000
    if (activate) {
        if (writes == 0) {
            if (address != base + 48 || mask != (1 << 29) || value != (if (transmit) 0 else 1 << 29)) bad = true
        } else if (writes == 1) {
            if (address != base + (if (transmit) 52 else 48) || mask != (1 << 26) || value != (1 << 26)) bad = true
        } else bad = true
    } else {
        val bit = if (port == 0) 16 else 2097152
        if (writes == 0) { if (address != 0x600c0018 || mask != bit || value != bit) bad = true }
        else if (writes == 1) { if (address != 0x600c0020 || mask != bit || value != 0) bad = true }
        else if (writes == 2) { if (address != base + 52 || mask != (1 << 29) || value != (1 << 29)) bad = true }
        else bad = true
    }
    writes = writes + 1
    return
}
trusted fun i2sEnableTest(): int {
    port = 0
    while (port < 2) {
        activate = false
        writes = 0
        if (!esp32s3I2sEnableClockLocked(port) || writes != 3 || bad) return 1
        activate = true
        var direction = 0
        while (direction < 2) {
            transmit = direction == 1
            active = 0
            writes = 0
            if (!esp32s3I2sActivateClock(port, transmit) || writes != 2 || bad) return 2
            writes = 0
            active = 4
            if (esp32s3I2sActivateClock(port, transmit) || writes != 0) return 3
            active = 256
            if (esp32s3I2sActivateClock(port, transmit) || writes != 0) return 4
            direction = direction + 1
        }
        port = port + 1
    }
    reads = 0
    writes = 0
    if (esp32s3I2sEnableClockLocked(-1) || esp32s3I2sEnableClockLocked(2) || esp32s3I2sActivateClock(-1, false) || esp32s3I2sActivateClock(2, true) || reads != 0 || writes != 0) return 5
    0
}
#exportFunction("i2sEnableTest", "abla_i2s_enable_test")
