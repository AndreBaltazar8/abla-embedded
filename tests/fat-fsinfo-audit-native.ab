import "../src/storage/fat_fsinfo_audit.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(1052)
var calls=0
var affected=0
var mode=0
var backup=6
var bad=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    val copy=calls;calls=calls+1
    if (lba != 101+(if (copy == 0) 0 else backup) || copy > 1) bad=true
    var at=0;while (at < 512) { output.store(at,0x5a);at=at+1 }
    output.storeU32(0,0x41615252);output.storeU32(484,0x61417272);output.storeU32(508,0xaa550000)
    output.storeU32(488,42);output.storeU32(492,2)
    if (copy == affected) {
        if (mode == 1) return false
        if (mode >= 2 && mode <= 4) output.storeU32(if (mode == 2) 0 else if (mode == 3) 484 else 508,0)
        if (mode == 5) output.storeU32(488,68769)
        if (mode == 6) output.storeU32(492,1)
        if (mode == 7) output.storeU32(492,68770)
        if (mode == 8) output.storeU32(488,41)
        if (mode == 9) { output.storeU32(488,0xffffffff);output.storeU32(492,0xffffffff) }
    }
    return true
}
@export("abla_fat_fsinfo_audit_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(memory,512);val reader=nativeBufferAt(memory+512,28);val scratch=nativeBufferAt(memory+540,512)
    var at=0;while (at < 512) { boot.store(at,0);at=at+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,32);boot.store(16,2);boot.storeU32(32,70000);boot.storeU32(36,600);boot.storeU32(44,2)
    boot.storeU16(48,1);boot.storeU16(50,6);boot.storeU16(510,0xaa55)
    while (affected < 2) {
        mode=0
        while (mode < 10) {
            calls=0
            val result=fatAuditFsInfoOwned(reader,boot,100,70000,42,scratch)
            val expected=if (mode == 0 || mode == 9) 1 else if (mode == 1) 3 else if (mode <= 4) 4 else if (mode <= 7) 5 else 6
            if (result.status() != expected || calls != (if (expected == 1) 2 else affected+1) || (expected != 1 && result.copy() != affected) || bad) return i32(1)
            if (expected == 1 && result.reads() != 2) return i32(2)
            if (mode == 8) {
                calls=0
                if (fatAuditFsInfoOwned(reader,boot,100,70000,-1,scratch).status() != 1 || calls != 2) return i32(3)
            }
            mode=mode+1
        }
        affected=affected+1
    }
    mode=0;calls=0;boot.storeU16(50,0)
    if (fatAuditFsInfoOwned(reader,boot,100,70000,42,scratch).reads() != 1 || calls != 1) return i32(4)
    calls=0;boot.storeU16(48,65535)
    if (fatAuditFsInfoOwned(reader,boot,100,70000,42,scratch).status() != 7 || calls != 0) return i32(5)
    boot.storeU16(48,0)
    if (fatAuditFsInfoOwned(reader,boot,100,70000,42,scratch).status() != 2 || calls != 0) return i32(6)
    boot.storeU16(48,1);boot.storeU16(50,31)
    if (fatAuditFsInfoOwned(reader,boot,100,70000,42,scratch).status() != 2 || calls != 0) return i32(7)
    boot.storeU16(50,6)
    if (fatAuditFsInfoOwned(reader,boot,100,70000,42,boot).status() != 2 || calls != 0 || bad) return i32(8)
    return i32(0)
}
