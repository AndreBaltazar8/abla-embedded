import "../src/esp32/intercore_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var channel=0
var map0=0
var map1=0
var signal=0
var writes=0
var bad=false
fun esp32S3IntercoreRead(address: int): int {
    if (address == 0x600C0030+channel*4) return signal
    if (address == 0x600C213C+channel*4) return map0
    if (address == 0x600C293C+channel*4) return map1
    bad=true; 0
}
fun esp32S3IntercoreUpdate(address: int,mask: int,value: int): void {
    val old=esp32S3IntercoreRead(address)
    val next=(old & ~mask) | (value & mask)
    if (address == 0x600C0030+channel*4) { if (mask != 1) bad=true; signal=next }
    else { if (mask != 31) bad=true; if (address == 0x600C213C+channel*4) map0=next else map1=next }
    writes=writes+1; return
}
@export("abla_intercore_test")
trusted fun intercoreTest(): i32 {
    while (channel < 4) {
        var core=0
        while (core < 2) {
            var line=0
            while (line < 32) {
                map0=0xABCD0000 | line; map1=0xEF120000 | (31-line); signal=0x80; writes=0; bad=false
                val saved=esp32S3IntercoreRouteOwned(channel,core,line)
                val valid=(line <= 5 || line == 8 || line == 9 || line == 12 || line == 13 || (line >= 17 && line <= 21) || (line >= 23 && line <= 27) || line == 31)
                if (saved.valid() != valid || bad) return i32(1)
                if (valid) {
                    if (writes != 3 || (map0 & 31) != (if (core == 0) line else 16) || (map1 & 31) != (if (core == 1) line else 16)) return i32(2)
                    esp32S3IntercoreSignalOwned(channel,true)
                    if (esp32S3IntercoreRestoreOwned(saved) || writes != 4) return i32(3)
                    esp32S3IntercoreSignalOwned(channel,false)
                    if (!esp32S3IntercoreRestoreOwned(saved) || map0 != (0xABCD0000 | line) || map1 != (0xEF120000 | (31-line)) || signal != 0x80 || writes != 9) return i32(4)
                } else if (writes != 0) return i32(5)
                line=line+1
            }
            core=core+1
        }
        channel=channel+1
    }
    channel=0; signal=1; writes=0
    if (esp32S3IntercoreRouteOwned(0,1,3).valid() || writes != 0 || esp32S3IntercoreSignalOwned(4,true) || esp32S3IntercoreRestoreOwned(Esp32S3IntercoreRoute(0))) return i32(6)
    i32(0)
}
