import "../src/m5stack/tab_charge_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var state=0
var calls=0
var trace=0
var fail=0
var bad=false
fun tabChargeLatch(handle: int,pin: int,enabled: bool): bool {
    calls=calls+1; trace=trace*10+pin
    if (handle != 7 || (pin != 7 && pin != 5)) bad=true
    if (calls == fail) return false
    state=(state & ~(1<<pin))|(if (enabled) 1<<pin else 0)
    true
}
@export("abla_tab_charge_test")
fun chargeTest(): i32 {
    var profile=0
    while (profile < 6144) {
        val initial=profile & 255
        val mode=(profile/256)%4
        val milliamps=if (mode == 0) 0 else if (mode == 1) 500 else if (mode == 2) 1000 else 750
        fail=(profile/1024)%3
        val board=if (profile < 3072) m5BoardTab5 else m5BoardTab5X
        state=initial; calls=0; trace=0; bad=false
        val result=board.setTabChargeCurrentOwned(7,milliamps)
        var expected=initial
        if (mode != 3 && fail != 1) {
            expected=(expected & ~128)|(if (mode != 0) 128 else 0)
            if (fail != 2) expected=(expected & ~32)|(if (mode != 2) 32 else 0)
        }
        val status=if (mode == 3) 4 else if (fail == 1) 5 else if (fail == 2) 6 else 1
        val applied=if (mode == 3 || fail == 1) 0 else if (fail == 2) 128 else 160
        if (result.status() != status || result.appliedPins() != applied || state != expected ||
            calls != (if (mode == 3) 0 else if (fail == 1) 1 else 2) ||
            trace != (if (mode == 3) 0 else if (fail == 1) 7 else 75) || bad) return i32(1)
        profile=profile+1
    }
    profile=0
    while (profile < 2048) {
        val initial=profile & 255
        val enabled=(profile & 256) != 0
        fail=(profile/512)%2
        val board=if (profile < 1024) m5BoardTab5 else m5BoardTab5X
        state=initial; calls=0; trace=0; bad=false
        val result=board.setTabBatteryChargeOwned(7,enabled)
        if (result.status() != (if (fail == 0) 1 else 5) || result.appliedPins() != (if (fail == 0) 128 else 0) ||
            state != (if (fail != 0) initial else (initial & ~128)|(if (enabled) 128 else 0)) || calls != 1 || trace != 7 || bad) return i32(2)
        profile=profile+1
    }
    calls=0
    if (m5BoardTab5.setTabChargeCurrentOwned(7,-1).status() != 4 ||
        m5BoardTab5.setTabChargeCurrentOwned(7,1001).status() != 4 ||
        m5BoardTab5.setTabBatteryChargeOwned(0,true).status() != 3 ||
        m5BoardTab5X.setTabChargeCurrentOwned(4294967296,500).status() != 3 ||
        m5BoardAtomVoice.setTabChargeCurrentOwned(7,500).status() != 2 || calls != 0) return i32(3)
    i32(0)
}
