import "../src/esp32/dsi_phy_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_phy_target")
trusted fun target(operation: int,a: int,b: int): bool {
    if (operation == 0) return esp32P4DsiPhyWriteRegister(a,b)
    if (operation == 1) return esp32P4DsiPhyStart(a)
    if (operation == 2) return esp32P4DsiPhyWaitReady(a,b)
    if (operation == 3) { esp32P4DsiPhyStop(); return true }
    false
}
