import "../src/m5stack/paper_display_owner_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(128)
var selected=false
var index=0
var preamble=0
var command=0
var calls=0
var failure=0
var busy=0
var bad=false
var releaseFailure=false
fun it8951TransportValid(context: int): bool = context == 7
fun it8951TransportSelect(context: int,active: bool): bool {
    if (!active && releaseFailure) return false
    if (context != 7 || (active && selected)) bad=true
    selected=active
    if (active) index=0
    return true
}
fun it8951TransportReady(context: int): int = if (context == 7) 1 else -1
fun it8951TransportDelay(context: int,us: int): void {
    if (context != 7 || (us != 1 && us != 1000)) bad=true
    return
}
fun it8951TransportExchange(context: int,word: int): int {
    calls=calls+1
    if (context != 7 || !selected) bad=true
    if (calls == failure) return -1
    if (index == 0) preamble=word
    if (index == 1 && preamble == 24576) command=word
    var result=0
    if (preamble == 4096 && index >= 2) {
        if (command == 770) result=if (index == 2) 960 else if (index == 3) 540 else if (index == 4) 0x1000 else 0
        else if (command == 16) result=busy
        else bad=true
    }
    index=index+1;return result
}

var pins=0
var failPin=-1
var partial=false
var failClose=-1
var prepared=0
var resets=0
var resetOk=true
trusted fun paperDisplayPinOpen(record: NativeBuffer,which: int): int {
    if (pins != (1<<which)-1) bad=true
    if (which == failPin && !partial) return 3
    record.storeU32(0,123);record.storeU32(4,which);record.storeU32(24,1)
    pins=pins|(1<<which)
    if (which == failPin) 4 else 1
}
trusted fun paperDisplayPinClose(record: NativeBuffer): int {
    val which=record.loadU32(4)
    if (which == failClose) return 4
    if ((pins>>which) != 1) bad=true
    pins=pins&~(1<<which);record.storeU32(0,0);record.storeU32(24,0);return 1
}
fun paperDisplayPrepareSdHeld(): void {
    if (pins != 127) bad=true
    prepared=prepared+1;return
}
fun paperDisplayResetCycle(): bool {
    if (pins != 127) bad=true
    resets=resets+1;command=0;selected=false;return resetOk
}
fun paperDisplayTransport(): int = 7
@export("abla_paper_display_owner_test")
trusted fun testPaperOwner(): i32 {
    val parent=m5PaperDisplayOwnerAt(nativeBufferAt(nativeStaticAllocate(312),312))
    val child=it8951SessionAt(nativeBufferAt(nativeStaticAllocate(40),40))
    val scratch=nativeBufferAt(nativeStaticAllocate(40),40)
    val gate=peripheralGateAt(nativeStaticAllocate(4))
    nativeAddressStoreU32(gate|0,0,0)
    if (!parent.initialize() || !child.initialize()) return i32(1)
    var slot=0
    while (slot < 7) {
        var kind=0
        while (kind < 2) {
            failPin=slot;partial=kind == 1;prepared=0;resets=0
            if (parent.openOwned(gate,u32(7),child,scratch,3,true,true) != 2 ||
                !parent.held() || child.state() != 0 || prepared != 0 || resets != 0 ||
                pins != (1<<(slot+kind))-1) return i32(2)
            if (!parent.closeOwned(true) || pins != 0 || parent.state() != 0 ||
                gate.word().compareExchange(u32(0),u32(0)) != u32(0) || bad) return i32(3)
            kind=kind+1
        }
        slot=slot+1
    }
    failPin=-1
    if (parent.openOwned(gate,u32(7),child,scratch,3,true,true) != 1 || parent.state() != 1 ||
        child.state() != 1 || pins != 127 || !parent.held() || gate.tryBegin(u32(8)) != 1) return i32(4)
    if (parent.closeOwned(true) || parent.closeOwned(false) || pins != 127) return i32(5)
    if (!child.lowPowerOwned(true,scratch,3,3,true).success() || child.state() != 5 ||
        parent.recoverControllerOwned(scratch,3,true) != 1 || child.state() != 1 ||
        !child.lowPowerOwned(false,scratch,3,3,true).success() || !child.detachStandbyOwned(true)) return i32(6)
    failClose=5
    if (parent.closeOwned(true) || parent.state() != 4 || pins != 63 || !parent.held()) return i32(7)
    failClose=-1
    if (!parent.closeOwned(true) || pins != 0 || bad) return i32(8)
    failure=calls+1
    if (parent.openOwned(gate,u32(7),child,scratch,3,true,true) != 3 || child.state() != 2 ||
        parent.closeOwned(true) || !parent.held()) return i32(9)
    failure=0
    if (parent.recoverControllerOwned(scratch,3,true) != 1 || !child.lowPowerOwned(false,scratch,3,3,true).success() ||
        !child.detachStandbyOwned(true) || !parent.closeOwned(true) || pins != 0 || bad) return i32(10)
    val before=calls
    if (parent.openOwned(gate,u32(7),child,scratch,3,false,true) != -1 ||
        parent.openOwned(gate,u32(7),child,scratch,3,true,false) != -1 ||
        parent.openOwned(gate,u32(7),child,parent.buffer(),3,true,true) != -1 ||
        parent.openOwned(peripheralGateAt(parent.buffer().addressValue()),u32(7),child,scratch,3,true,true) != -1 ||
        calls != before || pins != 0) return i32(11)
    if (gate.tryBegin(u32(8)) != 0 || parent.openOwned(gate,u32(7),child,scratch,3,true,true) != -2 ||
        !gate.finish(u32(8),true) || pins != 0 || bad) return i32(12)
    i32(0)
}
