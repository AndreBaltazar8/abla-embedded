import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/imu_owner_update.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_owner_update_target")
trusted fun ownerUpdateTarget(owner: M5ImuOwner,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): M5ImuUpdateResult =
