import "../src/esp32/radio/crypto_table_logic.ab"

fun controlValid(
    control: int,
    interfaceIndex: int,
    cipher: int,
    keyIdentifier: int,
    peerHigh: int
): bool = esp32HalCryptoControlInterface(control) == interfaceIndex &&
    esp32HalCryptoControlCipher(control) == cipher &&
    esp32HalCryptoControlKeyIdentifier(control) == keyIdentifier &&
    esp32HalCryptoControlPeerHigh(control) == peerHigh

fun main: int {
    val ccmp = esp32HalCryptoEncodeControl(4, 2, 3, 1, 48042)
    if (ccmp != 1114422186 || !controlValid(ccmp, 2, 3, 1, 48042)) {
        return 1
    }
    val tkip = esp32HalCryptoEncodeControl(2, 1, 1, 2, 4660)
    if (tkip != 2179207732 || !controlValid(tkip, 1, 1, 2, 4660)) {
        return 2
    }
    val special = esp32HalCryptoEncodeControl(1, 0, 5, 3, 43981)
    if (special != 3236277197 ||
        !controlValid(special, 0, 5, 3, 43981)) return 3
    if (esp32HalCryptoSlotAddress(0) != esp32HalCryptoKeyTableAddress ||
        esp32HalCryptoSlotAddress(24) !=
            esp32HalCryptoKeyTableAddress + 960) return 4
    83
}
