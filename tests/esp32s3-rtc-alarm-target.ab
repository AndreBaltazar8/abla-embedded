import "../src/esp32/i2c_esp32s3.ab"
import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_alarm_target")
trusted fun alarmTarget(handle: int,minute: int,hour: int,day: int,rx: bool): RtcAlarmResult =
    if (rx) Rx8130(handle).setAlarmInterruptChecked(minute,hour,day) else Pcf8563(handle).setAlarmInterruptChecked(minute,hour,day)
