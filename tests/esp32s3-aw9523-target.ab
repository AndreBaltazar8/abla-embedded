import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/io_expander/aw9523_device.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_aw9523_test")
trusted fun aw9523TargetTest(handle: u32, pin: i32, operation: i32, value: i32): int {
    val chip = Aw9523(int(handle))
    if (operation == i32(0)) return if (chip.begin()) 1 else 0
    if (operation == i32(1)) return if (chip.digitalWrite(int(pin), value != i32(0))) 1 else 0
    if (operation == i32(2)) return if (chip.setDirection(int(pin), value != i32(0))) 1 else 0
    if (operation == i32(3)) return if (chip.setGpioMode(int(pin), value != i32(0))) 1 else 0
    if (operation == i32(4)) return if (chip.setInterruptEnabled(int(pin), value != i32(0))) 1 else 0
    if (operation == i32(5)) {
        val result = chip.digitalReadChecked(int(pin))
        return if (result.valid()) result.value() else -1
    }
    if (operation == i32(6)) return if (chip.setLedCurrent(int(pin), int(value))) 1 else 0
    if (operation == i32(7)) return if (chip.configureControl(true, int(value))) 1 else 0
    if (operation == i32(8)) return if (chip.softwareReset()) 1 else 0
    val ports = chip.readPortsChecked()
    return if (ports.valid()) ports.value() else -1
}
