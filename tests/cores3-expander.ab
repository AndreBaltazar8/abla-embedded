import "../src/i2c/register_access.ab"
import "../src/m5stack/cores3_power.ab"
type I2cBus = int
type I2cDevice = int
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int, frequency: int): I2cDevice = I2cDevice(1)
fun I2cDevice.close(): bool = true
var registers = 0
var steps = 0
var failure = -1
var bad = false
val operations = nativeStaticU32s([16, 3, 259, 2, 258, 273, 274, 275, 260, 261])
trusted fun check(operation: int): bool {
    if (steps >= 10) { bad = true; return false }
    if (int(nativeAddressLoadU32(operations, steps * 4)) != operation) bad = true
    steps = steps + 1
    steps != failure
}
fun I2cDevice.readRegister(register: int, bytes: NativeBuffer, length: int): bool { bad = true; false }
fun I2cDevice.writeRegister(register: int, bytes: NativeBuffer, length: int): bool { bad = true; false }
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    if (!check(register)) return I2cByteResult(0)
    I2cByteResult(256 | int(nativeAddressLoadU32(registers, register * 4)))
}
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool {
    if (!check(256 + register)) return false
    nativeAddressStoreU32(registers, register * 4, value)
    true
}
fun peripheralDelayMicroseconds(duration: int): void { bad = true; return }
fun peripheralDelayMilliseconds(duration: int): void { bad = true; return }
trusted fun reset(initial: int): void {
    var index = 0
    while (index < 256) {
        nativeAddressStoreU32(registers, index * 4, if (index == 16) 35 else initial)
        index = index + 1
    }
    steps = 0
    failure = -1
    return
}
trusted fun at(register: int): int = int(nativeAddressLoadU32(registers, register * 4))
trusted fun main(): int {
    registers = nativeStackAllocate(1024)
    var initial = 0
    while (initial < 256) {
        var enabled = 0
        while (enabled < 2) {
            reset(initial)
            if (!cores3ConfigureExpander(Aw9523(1), enabled == 1) || steps != 10 || bad) return 1
            if (at(2) != (initial | (if (enabled == 1) 7 else 5)) || at(3) != (initial | (if (enabled == 1) 131 else 3)) ||
                at(17) != 16 || at(18) != 255 || at(19) != 255 || at(4) != 24 || at(5) != 12) return 2
            var index = 0
            while (index < 256) {
                if (index != 16 && index != 2 && index != 3 && index != 4 && index != 5 && index != 17 && index != 18 && index != 19 && at(index) != initial) return 3
                index = index + 1
            }
            enabled = enabled + 1
        }
        initial = initial + 1
    }
    var fail = 1
    while (fail <= 10) {
        reset(0)
        failure = fail
        if (cores3ConfigureExpander(Aw9523(1), true) || steps != fail || bad) return 4
        fail = fail + 1
    }
    reset(0)
    if (cores3ConfigureExpander(Aw9523(0), true) || steps != 0) return 5
    nativeAddressStoreU32(registers, 64, 0)
    if (cores3ConfigureExpander(Aw9523(1), true) || steps != 1) return 6
    0
}
