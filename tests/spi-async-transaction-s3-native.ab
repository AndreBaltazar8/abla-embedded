import "../src/esp32/sdk/raw_buffer.ab"
import "../src/spi/pins.ab"
import "../src/esp32/spi/phases_async_transaction_sequence_esp32s3.ab"
import "../src/esp32/spi/async_recover_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
val memory=nativeStaticAllocate(144)
var selects=0
var polls=0
var ready=1
var begun=2
var completed=2
var bad=false
var pinFault=0
var begins=0
var recovering=false
var recoveryFault=0
var idleReads=0
var initializes=0
fun esp32s3SpiBase(peripheral: int): int = 0x60024000
fun checkRecovery(): void {
    if (!recovering || nativeBufferAt(memory,4).loadU32(0) != 0x80000029) bad=true
    return
}
fun esp32s3SpiEnableBusClock(peripheral: int,owner: u32): bool { checkRecovery();return recoveryFault != 2 }
fun esp32s3SpiCpuBufferIdle(base: int): bool { checkRecovery();idleReads=idleReads+1;return recoveryFault != 3 && idleReads >= 2 }
fun esp32s3SpiInitializeMasterOwned(peripheral: int,pins: SpiPins,select: Pin,source: int,pre: int,cycles: int,mode: int,owner: u32,polls: int): int {
    checkRecovery();initializes=initializes+1
    if (idleReads < 2 || select != 4) bad=true
    return if (recoveryFault == 4) 1544 else 1
}
trusted fun Pin.writeLevelOwned(high: bool): bool {
    if (!recovering && nativeBufferAt(memory+16,64).loadU32(52) != 1) bad=true
    if (recovering) { checkRecovery();if (!high) bad=true;return recoveryFault != 1 }
    this.write(high);return (pinFault&(if (high) 2 else 1)) == 0
}
fun esp32s3SpiMasterPinsValid(peripheral: int,pins: SpiPins,select: Pin): bool = peripheral == 2 && select == 4
fun esp32s3SpiMemoryRangeValid(peripheral: int,data: NativeBuffer,bytes: int): bool = peripheral == 2 && data.hasAddressRange(0,bytes)
fun esp32s3SpiBufferRangeValid(peripheral: int,data: NativeBuffer,bytes: int): bool = bytes <= 64 && esp32s3SpiMemoryRangeValid(peripheral,data,bytes)
trusted fun esp32s3SpiExchangeReady(peripheral: int): int = ready
trusted fun Pin.write(high: bool): void {
    if (this != 4 || nativeBufferAt(memory,4).loadU32(0) != 41 || high != (selects == 1)) bad=true
    selects=selects+1; return
}
trusted fun esp32s3SpiPhasesBeginOwned(context: NativeBuffer,peripheral: int,command: int,commandBits: int,address: int,addressBits: int,dummy: int,direction: int,data: NativeBuffer,bytes: int,now: u32,budget: u32,released: bool): int {
    if (selects != 1 || context.addressValue() != memory+16 || !released) bad=true
    begins=begins+1
    return begun
}
trusted fun esp32s3SpiPhasesPollOwned(context: NativeBuffer,now: u32): int { polls=polls+1; return completed }
trusted fun begin(): int = esp32s3SpiAsyncTransactionBegin(nativeBufferAt(memory+16,64),peripheralGateAt(memory),u32(41),2,spiPins(37,35,36),Pin(4),0x9f,8,0,0,0,2,nativeBufferAt(memory+96,4),4,u32(0),u32(100),true)
trusted fun reset(): void {
    nativeBufferAt(memory,4).storeU32(0,0); selects=0; polls=0; ready=1; begun=2; completed=2; begins=0; return
}
@export("abla_spi_async_transaction_s3_test")
trusted fun test(): i32 {
    val context=nativeBufferAt(memory+16,64)
    pinFault=1
    while (pinFault < 4) {
        var terminal=1
        while (terminal <= 8) {
            if (terminal != 2) {
                reset();context.storeU32(0,0x53504107);context.storeU32(20,0x60000)
                var status=begin()
                if ((pinFault&1) == 0) {
                    if (status != 2 || begins != 1) return i32(9)
                    context.storeU32(20,0x60000);completed=terminal
                    status=esp32s3SpiAsyncTransactionPoll(context,u32(1))
                } else if (begins != 0 || context.loadU32(0) != 0 || context.loadU32(20) != 0) return i32(10)
                val expected=(if ((pinFault&1) != 0) 4|(1<<25) else terminal)|(if ((pinFault&2) != 0) 1<<24 else 0)
                if (status != 7 || context.loadU32(48) != expected || context.loadU32(52) != (if ((pinFault&2) != 0) 1 else 0) ||
                    selects != 2 || bad || nativeBufferAt(memory,4).loadU32(0) != 0x80000000) return i32(11)
                if ((pinFault&1) == 0 && context.loadU32(20) != 0x60000) return i32(12)
                if (esp32s3SpiAsyncTransactionPoll(context,u32(2)) != 7 || selects != 2 || begin() != 5) return i32(13)
            }
            terminal=terminal+1
        }
        pinFault=pinFault+1
    }
    pinFault=0
    var scenario=0
    while (scenario < 5) {
        reset();pinFault=2;begin();completed=7
        esp32s3SpiAsyncTransactionPoll(context,u32(1))
        val original=context.loadU32(48)
        val report=nativeBufferAt(memory+112,16)
        recovering=true;recoveryFault=scenario;idleReads=0;initializes=0
        val result=esp32s3SpiAsyncRecoverOwned(context,report,2,spiPins(37,35,36),1,1,16,0,3,true)
        if (result != (if (scenario == 0) 1 else scenario+3) || report.loadU32(0) != result || bad ||
            context.loadU32(48) != original || spiAsyncTransactionStatus(context) != 7 ||
            context.loadU32(52) != (if (scenario == 1) 1 else 0) ||
            initializes != (if (scenario == 0 || scenario == 4) 1 else 0) ||
            nativeBufferAt(memory,4).loadU32(0) != (if (scenario == 0) 0 else 0x80000000)) return i32(14)
        if (scenario == 4 && report.loadU32(4) != 1544) return i32(15)
        if (scenario != 0) {
            recoveryFault=0;idleReads=0
            if (esp32s3SpiAsyncRecoverOwned(context,report,2,spiPins(37,35,36),1,1,16,0,3,true) != 1 || context.loadU32(48) != original) return i32(16)
        }
        if (esp32s3SpiAsyncRecoverOwned(context,report,2,spiPins(37,35,36),1,1,16,0,3,true) != 3) return i32(17)
        recovering=false;scenario=scenario+1
    }
    pinFault=0
    reset();begin();completed=7;esp32s3SpiAsyncTransactionPoll(context,u32(1))
    val guardedReport=nativeBufferAt(memory+112,16)
    guardedReport.storeU32(0,12345)
    if (esp32s3SpiAsyncRecoverOwned(context,guardedReport,2,spiPins(37,35,36),1,1,16,0,3,false) != 2 ||
        esp32s3SpiAsyncRecoverOwned(context,context,2,spiPins(37,35,36),1,1,16,0,3,true) != 2 ||
        esp32s3SpiAsyncRecoverOwned(context,nativeBufferAt(memory,16),2,spiPins(37,35,36),1,1,16,0,3,true) != 2 ||
        guardedReport.loadU32(0) != 12345 || nativeBufferAt(memory,4).loadU32(0) != 0x80000000 || bad) return i32(18)
    context.storeU32(0,0x53504107);context.store(5,2);context.store(7,4);context.storeU32(8,memory+112)
    if (esp32s3SpiAsyncRecoverOwned(context,guardedReport,2,spiPins(37,35,36),1,1,16,0,3,true) != 2 || guardedReport.loadU32(0) != 12345) return i32(19)
    var outcome=1
    while (outcome <= 8) {
        if (outcome != 2) {
            reset()
            if (begin() != 2 || selects != 1 || nativeBufferAt(memory,4).loadU32(0) != 41 || begin() != 4 || selects != 1) return i32(1)
            if (esp32s3SpiAsyncTransactionPoll(context,u32(1)) != 2 || selects != 1) return i32(2)
            completed=outcome
            if (esp32s3SpiAsyncTransactionPoll(context,u32(2)) != (if (outcome == 1) 1 else 7) || selects != 2 || context.loadU32(48) != outcome || nativeBufferAt(memory,4).loadU32(0) != (if (outcome == 1) 0 else 0x80000000)) return i32(3)
            esp32s3SpiAsyncTransactionPoll(context,u32(3))
            if (polls != 2 || selects != 2) return i32(4)
        }
        outcome=outcome+1
    }
    reset(); ready=3
    if (begin() != 7 || selects != 0 || nativeBufferAt(memory,4).loadU32(0) != 0x80000000 || begin() != 5) return i32(5)
    reset(); begun=4
    if (begin() != 7 || selects != 2 || context.loadU32(48) != 4) return i32(6)
    reset(); begin(); nativeBufferAt(memory,4).storeU32(0,42)
    if (esp32s3SpiAsyncTransactionPoll(context,u32(1)) != 6 || polls != 0 || selects != 1 || context.loadU32(52) != 1 || nativeBufferAt(memory,4).loadU32(0) != 42) return i32(7)
    reset()
    if (esp32s3SpiAsyncTransactionBegin(context,peripheralGateAt(memory+20),u32(41),2,spiPins(37,35,36),Pin(4),1,1,0,0,0,2,nativeBufferAt(memory+96,4),4,u32(0),u32(100),true) != 3 || selects != 0 || bad) return i32(8)
    return i32(0)
}
