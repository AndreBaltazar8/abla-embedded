import "../src/esp32/adc_calibration_s3_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc_calibration_s3_target")
fun target(unit: int,atten: int,raw: int,b1w5: int,w4: int,w5: int,w6: int,w7: int,init: bool): int =
    if (init) esp32S3AdcInitCode(unit,atten,w4,w5,w6) else esp32S3AdcCalibratedMillivolts(unit,atten,raw,esp32S3AdcReferenceCode(unit,atten,b1w5,w4,w6,w7))
