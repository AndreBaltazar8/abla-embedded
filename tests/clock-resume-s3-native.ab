import "../src/esp32/clock_resume_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var xtal=40
var sys=0
var startResult=1
var switchOk=true
var expectedPll=480
var expectedCpu=80
var starts=0
var switches=0
var updates=0
var ticks=0
var bad=false
fun esp32S3ClockRead(address: int): int {
    if (address == 0x600080C0) return xtal | (xtal<<16)
    if (address == 0x600C0060) return sys
    bad=true; 0
}
fun esp32S3ClockRomTicks(mhz: int): void { if (mhz != expectedCpu || updates != 0) bad=true; ticks=ticks+1; return }
fun esp32S3ClockUpdate(address: int,mask: int,value: int): void {
    if (address != 0x600C0060 || mask != 1023 || ticks != 1 || value != (if (updates == 0) 0 else xtal/expectedCpu-1)) bad=true
    updates=updates+1; return
}
fun esp32S3PllStartOwned(mhz: int,polls: int): int {
    if (mhz != expectedPll || polls != 8 || switches != 0) bad=true
    starts=starts+1; startResult
}
fun esp32S3ClockToReadyPllOwned(mhz: int,rh: int,dh: int,rl: int,dl: int): Esp32S3ClockState {
    if (mhz != expectedCpu || starts != 1 || startResult != 1 || rh != 28 || dh != 28 || rl != 27 || dl != 27) bad=true
    switches=switches+1
    Esp32S3ClockState(if (switchOk) 1<<40 else 0)
}
fun reset(): void { starts=0; switches=0; updates=0; ticks=0; bad=false; return }
@export("abla_clock_resume_test")
trusted fun resumeTest(): i32 {
    val bias=esp32S3ClockBiasDecode(0,0,0,0)
    var per=0
    while (per < 8) {
        val saved=esp32S3ClockDecode(1024,per,0x00280028)
        expectedPll=if ((per & 4) != 0) 480 else 320
        expectedCpu=if ((per & 3) == 0) 80 else if ((per & 3) == 1) 160 else 240
        startResult=0
        while (startResult < 4) {
            reset()
            val result=esp32S3ClockResumeFromXtalOwned(saved,bias,8)
            val expected=if (!saved.valid()) -1 else if (startResult == 1) 80000000 else if (startResult == 3) -3 else -4
            if (bad || result != expected || starts != (if (saved.valid()) 1 else 0) || switches != (if (expected > 0) 1 else 0) || updates != 0) return i32(1)
            startResult=startResult+1
        }
        per=per+1
    }
    xtal=32
    while (xtal <= 40) {
        var divider=1
        while (divider <= 1024) {
            reset(); expectedCpu=xtal/divider
            val saved=esp32S3ClockDecode(divider-1,0,xtal | (xtal<<16))
            val valid=expectedCpu > 0 && expectedCpu*divider == xtal
            val result=esp32S3ClockResumeFromXtalOwned(saved,bias,8)
            if (bad || result != (if (valid) expectedCpu*1000000 else -1) || starts != 0 || updates != (if (valid) 2 else 0)) return i32(2)
            divider=divider+1
        }
        xtal=xtal+8
    }
    xtal=40; sys=1; reset()
    val saved=esp32S3ClockDecode(1024,4,0x00280028)
    if (esp32S3ClockResumeFromXtalOwned(saved,bias,8) != -2 || starts != 0) return i32(3)
    sys=0; switchOk=false; startResult=1; expectedPll=480; expectedCpu=80; reset()
    if (esp32S3ClockResumeFromXtalOwned(saved,bias,8) != -4 || switches != 1 || bad) return i32(4)
    reset()
    if (esp32S3ClockResumeFromXtalOwned(Esp32S3ClockState((saved | 0) | (1<<39)),bias,8) != -1 || starts != 0) return i32(5)
    i32(0)
}
