import "../src/esp32/i2c/lp_released_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var defects=0
var physical=0
var reads=0
var delays=0
var bad=false
fun c5LpI2cPinLoad(address: int): int {
    reads=reads+1
    if (address == 0x600B102C) return if ((defects&1) != 0) 4 else 0
    if (address == 0x600B2800) return (if ((defects&2) != 0) 0 else 0x08000000)|(if ((defects&16) != 0) 0 else 0x10000000)
    if (address == 0x600B47F8) return if ((defects&4) != 0) 0 else 1
    if (address == 0x600B1028) return if ((defects&8) != 0) 4 else 12
    if (address == 0x600B4410) return if ((defects&32) != 0) 8 else 12
    if (address == 0x600B4008) return if ((defects&64) != 0) 0x1300 else 0x3300
    if (address == 0x600B400C) return if ((defects&128) != 0) 0x3302 else 0x3300
    if (address == 0x600B4438) return if ((defects&256) != 0) 0 else 4
    if (address == 0x600B443C) return if ((defects&512) != 0) 0 else 4
    if (address == 0x600B1808) return if ((physical&(if (delays == 0) 1 else 4)) != 0) 16 else 0
    if (address == 0x600B441C) return if ((physical&(if (delays == 0) 2 else 8)) != 0) 8 else 12
    bad=true
    0
}
fun c5LpI2cPinStore(address: int,value: int): void { bad=true; return }
fun c5LpI2cReleasedDelay(): void { if (delays != 0) bad=true; delays=delays+1; return }
@export("abla_c5_lp_i2c_released_test")
trusted fun releasedTest(): i32 {
    var profile=0
    while (profile < 16384) {
        defects=profile&1023; physical=profile/1024; reads=0; delays=0; bad=false
        if (esp32C5LpI2cBusReleasedOwned(0,2,3) != (defects == 0 && physical == 0) || bad ||
            delays != (if (defects == 0 && (physical&3) == 0) 1 else 0)) return i32(1)
        profile=profile+1
    }
    reads=0; delays=0
    if (esp32C5LpI2cBusReleasedOwned(1,2,3) || esp32C5LpI2cBusReleasedOwned(0,3,2) || reads != 0 || delays != 0) return i32(2)
    i32(0)
}
