import "../src/esp32/startup_handshake_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_startup_handshake_target")
@section(".iram1.abla.s3StartupHandshakeTarget")
trusted fun startupTarget(address: int,op: int,success: bool): int {
    if (op == 0) return esp32S3StartupStatusOwned(address)
    if (op == 1) return if (esp32S3StartupRequestOwned(address)) 1 else 0
    if (op == 2) return if (esp32S3StartupInitializedOwned(address,success)) 1 else 0
    if (op == 3) return if (esp32S3StartupReleaseOwned(address)) 1 else 0
    if (esp32S3StartupRunningOwned(address)) 1 else 0
}
