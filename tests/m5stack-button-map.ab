import "../src/m5stack/button_map.ab"

@export("gpio_set_direction")
trusted fun testGpioSetDirection(number: i32, mode: i32): i32 = 0

fun main: int {
    val core = m5BoardStack
    val coreInk = m5BoardStackCoreInk
    val atom = m5BoardAtomVoice
    val stickPlus2 = m5BoardStickCPlus2
    val rawPins = core.buttonA().number() == 39 &&
        core.buttonB().number() == 38 && core.buttonC().number() == 37 &&
        coreInk.buttonExt().number() == 5 &&
        coreInk.buttonPower().number() == 27 &&
        atom.buttonA().number() == 39 &&
        stickPlus2.buttonPower().number() == 35 &&
        m5BoardPaperColor.buttonC().number() == 1 &&
        m5BoardUnitPoEP4.buttonA().number() == 45
    val routed = m5BoardStackCore2.buttonASource().kind() ==
            m5ButtonSourceTouch &&
        m5BoardStampPLC.buttonASource().kind() ==
            m5ButtonSourcePi4Ioe5v6408 &&
        m5BoardStampPLC.buttonASource().mask() == 4 &&
        m5BoardArduinoNessoN1.buttonBSource().mask() == 2 &&
        m5BoardPowerHub.buttonBSource().address() == 80 &&
        m5BoardPowerHub.buttonBSource().register() == 160 &&
        m5BoardCoreMatrix.buttonCSource().kind() == m5ButtonSourceM5Pm1 &&
        m5BoardCoreMatrix.buttonCSource().index() == 2 &&
        m5BoardCoreP4X.buttonPowerSource().kind() ==
            m5ButtonSourcePmicKey &&
        m5BoardAtomVoice.buttonB().number() == -1
    if (rawPins && routed) 60 else 1
}
