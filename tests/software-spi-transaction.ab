import "../src/spi/software_transaction.ab"
import "../src/esp32/sdk/raw_buffer.ab"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this == 1 || this == 2 || this == 4
var gateAddress = 0
var phase = 0
var bits = 0
var activity = 0
var clockHigh = false
var dataHigh = false
var error = false
trusted fun checkOwner(): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateAddress, 0) != 7) error = true
    return
}
trusted fun Pin.write(high: bool): void {
    checkOwner()
    if (this == 1) clockHigh = high
    if (this == 2) dataHigh = high
    if (this == 4) {
        if (!high) {
            if (phase != 0 || !clockHigh) error = true
            phase = 1
        } else {
            if (phase != 3 || bits != 8) error = true
            phase = 4
        }
    }
    return
}
trusted fun Pin.read(): bool {
    checkOwner()
    if (this != 3 || phase != 2 || !clockHigh || dataHigh != ((165 & (1 << (7 - bits))) != 0)) error = true
    val value = (90 & (1 << (7 - bits))) != 0
    bits = bits + 1
    value
}
trusted fun peripheralDelayMicroseconds(duration: int): void {
    checkOwner()
    if (duration == 3) {
        if (phase != 1 || bits != 0) error = true
        phase = 2
    } else if (duration == 5) {
        if (phase != 2 || bits != 8) error = true
        phase = 3
    } else if (duration != 1 || phase != 2) error = true
    return
}
trusted fun exchange(gate: PeripheralGate): SpiTransactionResult =
    softwareSpiTransactionWord(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), u32(165), 8, 3, 1, false, 3, 5)
trusted fun main(): int {
    gateAddress = nativeStackAllocate(4)
    nativeAddressStoreU32(gateAddress, 0, 0)
    val gate = peripheralGateAt(gateAddress)
    val result = exchange(gate)
    if (!result.valid() || result.value() != u32(90) || phase != 4 || error ||
        nativeAddressLoadU32(gateAddress, 0) != 0) return 1
    activity = 0
    if (gate.tryBegin(u32(9)) != 0 || exchange(gate).status() != 2 || activity != 0) return 2
    if (!gate.finish(u32(9), false) || exchange(gate).status() != 4 || activity != 0) return 3
    if (!gate.tryBeginRecovery(u32(9)) || !gate.finishRecovery(u32(9), true)) return 4
    val invalid = softwareSpiTransactionWord(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(1), u32(0))
    if (invalid.status() != 3 || activity != 0 || nativeAddressLoadU32(gateAddress, 0) != 0) return 5
    val empty = nativeBufferAt(0, 0)
    val noOp = softwareSpiTransaction(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), empty, 0, empty, 0)
    if (!noOp.valid() || activity != 0 || nativeAddressLoadU32(gateAddress, 0) != 0) return 6
    if (gate.tryBegin(u32(9)) != 0) return 7
    if (softwareSpiTransaction(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), empty, 0, empty, 0).status() != 2 || activity != 0) return 8
    if (!gate.finish(u32(9), true)) return 9
    val overlapping = softwareSpiTransaction(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        nativeBufferAt(4096, 8), 8, nativeBufferAt(4100, 8), 8)
    if (overlapping.status() != 3 || activity != 0 || nativeAddressLoadU32(gateAddress, 0) != 0) return 10
    0
}
