import "../src/esp32/clock_resume_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_clock_resume_target")
@section(".iram1.abla.s3ClockResumeTarget")
trusted fun resumeTarget(saved: int,bias: int,polls: int): int =
    esp32S3ClockResumeFromXtalOwned(Esp32S3ClockState(saved),Esp32S3ClockBias(bias),polls)
