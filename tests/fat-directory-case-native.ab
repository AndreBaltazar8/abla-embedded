import "../src/storage/fat_directory_rename.ab"
import "../src/storage/fat_long_name_encode.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(8192)
val image=nativeStaticAllocate(4096)
var mode=0
var writes=0
var failAt=0
var committed=false
var bad=false
fun slot(lba: int): int = if (mode == 0)
    (if (lba == 116) 7 else if (lba == 1) 0 else if (lba == 41) 1 else if (lba >= 81 && lba <= 83) lba-79 else -1)
    else (if (lba == 1235) 7 else if (lba == 32) 0 else if (lba == 632) 1 else if (lba >= 1232 && lba <= 1234) lba-1230
        else if (lba == 1) 5 else if (lba == 7) 6 else -1)
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    val selected=slot(lba)
    if (selected < 0 && lba != 0) { bad=true;return false }
    val source=if (lba == 0) nativeBufferAt(memory+64,512) else nativeBufferAt(image+selected*512,512)
    var i=0;while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool {
    writes=writes+1;val selected=slot(lba);
    if (selected != 5-writes) { bad=true;return false }
    if (writes != failAt || committed) {
        val output=nativeBufferAt(image+selected*512,512);var i=0
        while (i < 512) { output.store(i,source.load(i));i=i+1 }
    }
    return writes != failAt
}
@export("abla_fat_directory_case_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,32);val reader=nativeBufferAt(memory+32,28);val boot=nativeBufferAt(memory+64,512)
    val expectedEntry=nativeBufferAt(memory+576,32);val work=nativeBufferAt(nativeStaticAllocate(5864),5864)
    val mountScratch=nativeBufferAt(memory+4288,512);val plan=nativeBufferAt(memory+4800,32)
    val name=nativeBufferAt(memory+4864,510);val encoded=nativeBufferAt(memory+5376,640)
    val preserved=nativeBufferAt(nativeStaticAllocate(1536),1536)
    val alias=nativeBufferAt(nativeStaticBytes("ALIAS   TXT"),11)
    var i=0;while (i < 255) { name.storeU16(i*2,65);i=i+1 }
    if (fatLongNameEncodeEntries(name,255,alias,encoded) != 20 || !fatVolumeInitializeFresh(state)) return i32(1)
    while (mode < 3) {
        val hints=if (mode == 0) 0 else 2;val mirrors=if (mode == 2) 1 else 2
        val maximum=3;var outcome=0
        while (outcome < 2) {
            committed=outcome == 1;var failure=0
            while (failure <= maximum) {
                writes=0;failAt=failure;bad=false;i=0
                while (i < 512) { boot.store(i,0);i=i+1 }
                boot.storeU16(11,512);boot.store(13,1);boot.store(16,2);boot.storeU16(510,0xaa55)
                if (mode == 0) { boot.storeU16(14,1);boot.storeU16(17,512);boot.storeU16(22,40);boot.storeU16(19,10113) }
                else { boot.storeU16(14,32);boot.storeU32(32,70000);boot.storeU32(36,600);boot.storeU32(44,2)
                    boot.storeU16(48,1);boot.storeU16(50,6);boot.storeU16(40,if (mode == 2) 129 else 0) }
                val total=if (mode == 0) 10113 else 70000
                i=0;while (i < 4096) { nativeBufferAt(image,4096).store(i,255);i=i+1 }
                var copy=0;while (copy < 2) {
                    val fat=nativeBufferAt(image+copy*512,512)
                    if (mode != 0) {
                        fat.storeU32(8,3);fat.storeU32(12,4);fat.storeU32(16,0xafffffff)
                        fat.storeU32(20,0xa0000006);fat.storeU32(24,0xafffffff)
                    } else { fat.storeU16(10,6);fat.storeU16(12,65535) }
                    val info=nativeBufferAt(image+2560+copy*512,512)
                    info.storeU32(0,0x41615252);info.storeU32(484,0x61417272);info.storeU32(508,0xaa550000)
                    info.storeU32(488,42);info.storeU32(492,7);copy=copy+1
                }
                if (mode == 2) { i=0;while (i < 512) { nativeBufferAt(image,512).store(i,85);i=i+1 } }
                val directory=nativeBufferAt(image+1024,1536);i=0
                while (i < 1536) { directory.store(i,0);i=i+1 }
                var entry=0;while (entry < 15) { directory.store(entry*32,229);entry=entry+1 }
                i=0;while (i < 640) { directory.store(480+i,encoded.load(i));i=i+1 }
                i=0;while (i < 11) { directory.store(1120+i,alias.load(i));i=i+1 }
                directory.store(1131,16);directory.storeU16(1146,5);directory.storeU32(1148,0)
                val child=nativeBufferAt(image+3584,512)
                i=0;while (i < 512) { child.store(i,0);i=i+1 }
                var dot=0
                while (dot < 2) {
                    var n=0;while (n < 11) { child.store(dot*32+n,32);n=n+1 }
                    child.store(dot*32,46);if (dot == 1) child.store(33,46)
                    child.store(dot*32+11,16);child.storeU16(dot*32+26,if (dot == 0) 5 else if (mode == 2) 2 else 0)
                    dot=dot+1
                }
                val childName=nativeBufferAt(nativeStaticBytes("CHILD   TXT"),11)
                i=0;while (i < 11) { child.store(64+i,childName.load(i));i=i+1 }
                child.store(75,32);child.storeU16(90,7);child.storeU32(92,123)
                i=0;while (i < 512) { preserved.store(i,child.load(i));i=i+1 }
                i=0;while (i < 1024) { preserved.store(512+i,nativeBufferAt(image,1024).load(i));i=i+1 }
                i=0;while (i < 32) { expectedEntry.store(i,directory.load(1120+i));i=i+1 }
                i=0;while (i < 255) { name.storeU16(i*2,97);i=i+1 }
                val volume=fatVolumeOpen(state,u32(7),reader,total,-1,boot,mountScratch)
                val result=volume.renameDirectory(u32(7),0,2,3,expectedEntry,if (mode == 2) 2 else 0,name,255,1,8,64,work)
                val status=if (failure == 0) 1 else 15
                if (bad || result.status() != status || writes != (if (failure == 0) maximum else failure)) return i32(2)
                i=0;while (i < 32) { if (directory.load(1120+i) != expectedEntry.load(i)) return i32(6);i=i+1 }
                if (failure == 0) {
                    val assembly=nativeBufferAt(nativeStaticAllocate(520),520);var lfn=FatLongName(0);var part=0
                    while (part < 20) { lfn=lfn.consume(nativeBufferAt(directory.addressValue()+480+part*32,32),assembly);part=part+1 }
                    if (!lfn.matches(expectedEntry,assembly)) return i32(7)
                    i=0;while (i < 255) { if (assembly.loadU16(i*2) != 97) return i32(8);i=i+1 }
                }
                i=0;while (i < 512) { if (child.load(i) != preserved.load(i)) return i32(9);i=i+1 }
                i=0;while (i < 1024) { if (nativeBufferAt(image,1024).load(i) != preserved.load(512+i)) return i32(10);i=i+1 }
                if (failure == 0) {
                    val before=writes
                    // Exact spelling is a no-op but still validates ancestry.
                    if (volume.renameDirectory(u32(7),0,2,3,expectedEntry,if (mode == 2) 2 else 0,name,255,1,8,64,work).status() != 1 || writes != before) return i32(11)
                    child.storeU16(58,8)
                    if (volume.renameDirectory(u32(7),0,2,3,expectedEntry,0,name,255,1,8,64,work).status() != 5 || writes != before) return i32(12)
                    child.storeU16(58,if (mode == 2) 2 else 0)
                }
                if (failure != 0 && state.loadU32(12) != 3) return i32(3)
                if (mode == 2) { i=0;while (i < 512) { if (nativeBufferAt(image,512).load(i) != 85) return i32(4);i=i+1 } }
                if (directory.load(1152) != 0 || !volume.invalidate(u32(7))) return i32(5)
                failure=failure+1
            }
            outcome=outcome+1
        }
        mode=mode+1
    }
    return i32(0)
}
