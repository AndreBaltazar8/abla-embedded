import "../src/esp32/ahb_gdma_acquire_p4_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
var channel=0
var tx=false
var index=0
var circular=false
var length=64
var descriptorFlags=0
var wrongBuffer=false
var wrongNext=false
var events=0
var later=0
var eventReads=0
var fences=0
var invalidates=0
var loads=0
var fail=0
var cacheError=5
var bad=false
trusted fun p4AhbDescriptorWrite(address: int,value: int): void { bad=true;return }
trusted fun p4AhbAcquireEvents(address: int): int {
    if (address != 0x50085000+channel*16+(if (tx) 48 else 0)) bad=true
    eventReads=eventReads+1
    return if (eventReads == 1) events else later
}
trusted fun p4AhbAcquireFence(): void { fences=fences+1;return }
trusted fun p4AhbAcquireInvalidate(buffer: NativeBuffer,bytes: int,polls: int): int {
    invalidates=invalidates+1
    if (polls != 7 || bytes != (if (invalidates == 1) 64 else 128) || buffer.capacity() != bytes ||
        buffer.addressValue() != (if (invalidates == 1) 0x4ff00000+index*64 else 0x4ff40000+index*128) ||
        fences != (if (invalidates == 1) 1 else 2) || (invalidates == 2 && (tx || loads != 3))) bad=true
    return if (invalidates == fail) cacheError else 1
}
trusted fun p4AhbAcquireLoad(address: int): int {
    if (fences != 2 || invalidates != 1) bad=true
    val base=0x4ff00000+index*64
    loads=loads+1
    if (address == base) return descriptorFlags | 64 | (length << 12)
    if (address == base+4) return 0x4ff40000+index*128+(if (wrongBuffer) 64 else 0)
    if (address == base+8) return (if (index == 2) (if (circular) 0x4ff00000 else 0) else base+64)+(if (wrongNext) 64 else 0)
    bad=true;return 0
}
trusted fun reset(): void {
    length=64;descriptorFlags=0;wrongBuffer=false;wrongNext=false;events=0;later=0
    eventReads=0;fences=0;invalidates=0;loads=0;fail=0;bad=false
    return
}
trusted fun run(): Esp32P4AhbGdmaAcquireResult = esp32p4AhbGdmaAcquireBlockOwned(channel,tx,0x4ff00000,3,0x4ff40000,128,64,index,circular,7,true)
@export("abla_ahb_gdma_acquire_p4_test")
trusted fun test(): i32 {
    while (channel < 3) {
        var mode=0
        while (mode < 4) {
            tx=(mode & 1) != 0;circular=(mode & 2) != 0;index=0
            while (index < 3) {
                var n=1
                while (n <= 64) {
                    reset();length=n
                    val result=run()
                    if (result.status() != (if (tx && n != 64) 6 else 1) || bad ||
                        result.bytes() != (if (tx && n != 64) 0 else n)) return i32(1)
                    if ((!tx || n == 64) && (invalidates != (if (tx) 1 else 2) || eventReads != 2 || fences != (if (tx) 2 else 3))) return i32(2)
                    n=n+1
                }
                reset();descriptorFlags=0x80000000
                if (run().status() != 3 || invalidates != 1 || loads != 1 || bad) return i32(3)
                var error=0
                while (error < 6) {
                    reset()
                    if (error == 0) descriptorFlags=0x10000000
                    if (error == 1) descriptorFlags=0x20000000
                    if (error == 2) length=0
                    if (error == 3) length=65
                    if (error == 4) wrongBuffer=true
                    if (error == 5) wrongNext=true
                    if (run().status() != 6 || invalidates != 1 || bad) return i32(4)
                    error=error+1
                }
                var stage=1
                while (stage <= (if (tx) 1 else 2)) {
                    cacheError=2
                    while (cacheError <= 5) {
                        reset();fail=stage
                        val result=run()
                        if (result.status() != (if (stage == 1) 5 else 7) || result.cacheStatus() != cacheError || invalidates != stage || eventReads != 1 || bad) return i32(5)
                        cacheError=cacheError+1
                    }
                    stage=stage+1
                }
                var raw=0
                while (raw < 256) {
                    reset();events=raw
                    val result=run()
                    val fault=(raw & (if (tx) 244 else 252)) != 0
                    if (result.status() != (if (fault) 4 else 1) || result.events() != raw ||
                        (fault && (invalidates != 0 || loads != 0)) || bad) return i32(6)
                    raw=raw+1
                }
                reset();events=1;later=128
                val late=run()
                if (late.status() != 4 || late.events() != 129 || late.bytes() != 0 || bad) return i32(7)
                index=index+1
            }
            mode=mode+1
        }
        channel=channel+1
    }
    reset()
    if (esp32p4AhbGdmaAcquireBlockOwned(0,false,0x4ff00000,3,0x4ff40000,128,64,3,true,7,true).status() != 2 ||
        esp32p4AhbGdmaAcquireBlockOwned(0,false,0x4ff00000,3,0x4ff40000,128,64,0,true,7,false).status() != 2 ||
        eventReads != 0 || fences != 0 || loads != 0) return i32(8)
    return i32(0)
}
