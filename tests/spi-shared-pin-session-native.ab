import "../src/esp32/spi/shared_pin_session_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this)
val regs=nativeBufferAt(nativeStaticAllocate(24576),24576)
val record=nativeBufferAt(nativeStaticAllocate(36),36)
var writes=0
var drop=-1
var routes=0
var failRoute=-1
var active=false
var gpioCalls=0
var bad=false
fun esp32s3SpiRead(address: int): int = if ((address&4095) == 0 && active) 0x01000000 else 0
fun esp32s3SpiWrite(address: int,value: int): void { bad=true;return }
fun esp32S3PinStateRead(address: int): int = regs.loadU32(address-0x60004000)
fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes;writes=writes+1;if (step == drop) return
    val offset=address-0x60004000
    if (offset == 0x28) regs.storeU32(0x20,regs.loadU32(0x20)&~value)
    else if (offset == 0x24) regs.storeU32(0x20,regs.loadU32(0x20)|value)
    else if (offset == 8) regs.storeU32(4,regs.loadU32(4)|value)
    else if (offset == 12) regs.storeU32(4,regs.loadU32(4)&~value)
    else regs.storeU32(offset,value)
    return
}
fun Pin.outputLevelOwned(high: bool): bool {
    gpioCalls=gpioCalls+1;if (active) bad=true
    regs.storeU32(4,if (high) regs.loadU32(4)|(1<<this) else regs.loadU32(4)&~(1<<this))
    regs.storeU32(32,regs.loadU32(32)|(1<<this))
    regs.storeU32(esp32S3GpioMuxAddress(this)-0x60004000,0x1000)
    regs.storeU32(0x554+this*4,1280);return true
}
fun Pin.routeOutputSignal(signal: int,inverted: bool): bool {
    val step=routes;routes=routes+1
    if (step == failRoute) return false
    this.outputLevelOwned(false);regs.storeU32(0x554+this*4,signal);return true
}
fun Pin.routeBidirectionalSignal(input: int,output: int): bool {
    val step=routes;routes=routes+1
    if (step == failRoute) return false
    this.outputLevelOwned(false);regs.storeU32(0x554+this*4,output)
    regs.storeU32(0x154+input*4,128|(this|0));return true
}
fun seed(port: int): void {
    var i=0;while (i < 24576) { regs.storeU32(i,0);i=i+4 }
    i=0;while (i < 36) { record.storeU32(i,0);i=i+4 }
    regs.storeU32(0x154+(if (port == 2) 103 else 68)*4,0x45)
    writes=0;drop=-1;routes=0;failRoute=-1;active=false;gpioCalls=0;bad=false;return
}
fun originals(port: int): bool {
    if (regs.loadU32(4) != 0 || regs.loadU32(32) != 0 || regs.loadU32(0x154+(if (port == 2) 103 else 68)*4) != 0x45) return false
    var pin=7
    while (pin <= 10) {
        if (regs.loadU32(esp32S3GpioMuxAddress(pin)-0x60004000) != 0 || regs.loadU32(0x554+pin*4) != 0) return false
        pin=pin+1
    }
    return !bad
}
@export("abla_spi_shared_pin_session_test")
trusted fun test(): i32 {
    var port=2
    while (port <= 3) {
        seed(port)
        if (esp32s3SpiSharedPinsOpenOwned(record,port,Pin(7),Pin(8),Pin(10),Pin(9),true) != 1) return i32(1)
        active=true;val before=gpioCalls
        if (esp32s3SpiSharedPinsCloseOwned(record,3,true) != 3 || gpioCalls != before || writes != 0 || bad) return i32(2)
        active=false
        if (esp32s3SpiSharedPinsCloseOwned(record,3,true) != 2 || !originals(port)) return i32(3)
        val count=writes
        var fail=0
        while (fail < count) {
            seed(port)
            if (esp32s3SpiSharedPinsOpenOwned(record,port,Pin(7),Pin(8),Pin(10),Pin(9),true) != 1) return i32(4)
            drop=fail
            val closed=esp32s3SpiSharedPinsCloseOwned(record,3,true)
            if (closed != 2 && closed != 3) return i32(5)
            drop=-1
            if (esp32s3SpiSharedPinsCloseOwned(record,3,true) != 2 || !originals(port)) return i32(6)
            fail=fail+1
        }
        fail=0
        while (fail < 2) {
            seed(port);failRoute=fail
            if (esp32s3SpiSharedPinsOpenOwned(record,port,Pin(7),Pin(8),Pin(10),Pin(9),true) != 3 ||
                esp32s3SpiSharedPinsOpenOwned(record,port,Pin(7),Pin(8),Pin(10),Pin(9),true) != 0) return i32(7)
            if (esp32s3SpiSharedPinsCloseOwned(record,3,true) != 2 || !originals(port)) return i32(8)
            fail=fail+1
        }
        seed(port);active=true
        if (esp32s3SpiSharedPinsOpenOwned(record,port,Pin(7),Pin(8),Pin(10),Pin(9),true) != 0 || gpioCalls != 0 || record.loadU32(0) != 0) return i32(9)
        active=false
        if (esp32s3SpiSharedPinsOpenOwned(record,port,Pin(7),Pin(8),Pin(10),Pin(8),true) != 0 || gpioCalls != 0) return i32(10)
        port=port+1
    }
    return i32(0)
}
