import "../src/led/rmt_strip_dma_esp32s3.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
// Compile fixture: full caller-owned constructor/store/display call graph.
// Caller must initialize clocks, route pin7 to RMT3, and own DMA/storage.
trusted fun rmtStripDmaTarget(state: u32, descriptors: u32, waveform: u32): int {
    val strip = rmtLedStripAt(nativeBufferAt(int(state), 52), 7, 2)
    if (!strip.valid()) return 2
    strip.storeColor(0, rgbColor(255, 0, 0))
    strip.storeColor(1, rgbColor(0, 0, 255))
    strip.displayDmaOwned(2, int(descriptors), nativeBufferAt(int(waveform), 200), 100000)
}
#exportFunction("rmtStripDmaTarget", "abla_s3_rmt_strip_dma_test")
