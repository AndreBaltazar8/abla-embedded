import "../src/i2c/results.ab"
import "../src/m5stack/corematrix_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var calls=0
var failure=0
var bad=false
var sd=false
val registers=nativeStaticAllocate(64)
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }

fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true; return I2cWordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun expectedDevice(step: int): int =
    if (step == 1) 9 else if (step == 2) 9 else if (step == 3) 9 else if (step == 4) 9 else if (step == 5) 9 else if (step == 6) 9 else if (step == 7) 9 else if (step == 8) 9 else if (step == 9) 9 else if (step == 10) 9 else if (step == 11) 9 else if (step == 12) 9 else if (step == 13) 9 else if (step == 14) 9 else if (step == 15) 8 else if (step == 16) 8 else if (step == 17) 8 else 8
fun expectedRegister(step: int): int =
    if (step == 1) 6 else if (step == 2) 22 else if (step == 3) 22 else if (step == 4) 22 else if (step == 5) 16 else if (step == 6) 16 else if (step == 7) 16 else if (step == 8) 23 else if (step == 9) 16 else if (step == 10) 16 else if (step == 11) 19 else if (step == 12) 20 else if (step == 13) 17 else if (step == 14) 22 else if (step == 15) 3 else if (step == 16) 19 else if (step == 17) 3 else 5
fun expectedMask(step: int): int =
    if (step == 1) 8 else if (step == 2) 3 else if (step == 3) 12 else if (step == 4) 48 else if (step == 5) 1 else if (step == 6) 2 else if (step == 7) 4 else if (step == 8) 3 else if (step == 9) 16 else if (step == 10) 8 else if (step == 11) 8 else if (step == 12) 192 else if (step == 13) 8 else if (step == 14) 192 else if (step == 15) 128 else if (step == 16) 1 else if (step == 17) 1 else 1
fun expectedValue(step: int): int =
    if (step == 1) 8 else if (step == 2) 0 else if (step == 3) 0 else if (step == 4) 0 else if (step == 5) 0 else if (step == 6) 0 else if (step == 7) 0 else if (step == 8) 0 else if (step == 9) 0 else if (step == 10) 8 else if (step == 11) 0 else if (step == 12) 64 else if (step == 13) 8 else if (step == 14) 64 else if (step == 15) 0 else if (step == 16) 0 else if (step == 17) 1 else 1

trusted fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    calls=calls+1
    val step=calls+(if (sd) 15 else 0)
    if (calls > (if (sd) 3 else 15) || this != expectedDevice(step) || register != expectedRegister(step) ||
        mask != expectedMask(step) || value != expectedValue(step)) bad=true
    if (calls == failure) return false
    val offset=(if (this == 9) 32 else 0)+register
    val buffer=nativeBufferAt(registers,64)
    buffer.store(offset,(buffer.load(offset)&~mask)|value)
    true
}
@export("abla_corematrix_power_test")
trusted fun powerTest(): i32 {
    val owner=m5ExpandersAt(nativeBufferAt(nativeStaticAllocate(32),32))
    owner.initialize(); owner.buffer().storeU32(8,m5BoardCoreMatrix | 0)
    owner.storeSlot(0,M5ExpanderOpen(8|(2<<32)|(1<<40))); owner.buffer().storeU32(4,1)
    val pmic=M5PmicOpen(9|(5<<32)|(1<<40))
    var phase=0
    while (phase < 2) {
        sd=phase == 1
        val count=if (sd) 3 else 15
        var profile=0
        while (profile < (count+1)*256) {
            val initial=profile&255; failure=profile/256
            val buffer=nativeBufferAt(registers,64)
            var r=0
            while (r < 64) { buffer.store(r,initial); r=r+1 }
            calls=0; bad=false
            val result=if (sd) owner.configureCoreMatrixSdPower() else owner.configureCoreMatrixPowerInputs(pmic)
            val acknowledged=if (failure == 0) count else failure-1
            if (result.status() != (if (failure == 0) 1 else 4) || result.appliedSteps() != acknowledged ||
                calls != (if (failure == 0) count else failure) || bad) return i32(1)
            r=0
            while (r < 64) {
                var expected=initial
                var i=1
                while (i <= acknowledged) {
                    val step=i+(if (sd) 15 else 0)
                    val offset=expectedRegister(step)+(if (expectedDevice(step) == 9) 32 else 0)
                    if (offset == r) expected=(expected&~expectedMask(step))|expectedValue(step)
                    i=i+1
                }
                if (buffer.load(r) != expected) return i32(2)
                r=r+1
            }
            profile=profile+1
        }
        phase=phase+1
    }
    calls=0
    if (owner.configureCoreMatrixPowerInputs(M5PmicOpen(0)).status() != 3 ||
        owner.configureCoreMatrixPowerInputs(M5PmicOpen(9|(3<<32)|(1<<40))).status() != 3 || calls != 0) return i32(3)
    owner.buffer().storeU32(8,m5BoardCoreP4X | 0)
    if (owner.configureCoreMatrixPowerInputs(pmic).status() != 2 || owner.configureCoreMatrixSdPower().status() != 2 || calls != 0) return i32(4)
    owner.buffer().storeU32(4,6)
    if (owner.configureCoreMatrixPowerInputs(pmic).status() != 3 || owner.configureCoreMatrixSdPower().status() != 3 || calls != 0) return i32(5)
    i32(0)
}
