import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/output_readback.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_output_readback_target")
trusted fun readbackTarget(board: M5BoardId,power: I2cDevice,expander: I2cDevice,usb: bool): I2cByteResult =
    if (usb) board.usbOutputChecked(expander) else board.externalOutputChecked(power,expander)
