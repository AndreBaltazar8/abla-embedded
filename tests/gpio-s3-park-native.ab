import "../src/esp32/gpio/park_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var pinNumber=0
var enable=0
var route=0
var writes=0
var dropped=-1
var bad=false
fun esp32S3PinStateRead(address: int): int {
    if (address == 0x60004020+esp32S3GpioBankOffset(pinNumber)) return enable
    if (address == 0x60004554+pinNumber*4) return route
    bad=true;return 0
}
fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes;writes=writes+1
    if (step == dropped) return
    if (address == 0x60004028+esp32S3GpioBankOffset(pinNumber)) enable=enable&~value
    else if (address == 0x60004554+pinNumber*4) {
        if ((enable&(1<<(pinNumber&31))) != 0) bad=true
        route=value
    } else bad=true
    return
}
@export("abla_gpio_s3_park_test")
fun test(): i32 {
    pinNumber=0
    while (pinNumber <= 48) {
        if (espChipS3().gpioValid(pinNumber)) {
            var bits=0
            while (bits < 4096) {
                enable=0xffffffff;route=0xabcd0000|bits;writes=0;dropped=-1;bad=false
                if (!esp32S3GpioParkOutputOwned(pinNumber) || bad || enable != (0xffffffff&~(1<<(pinNumber&31))) || route != (((0xabcd0000|bits)&~3072)|1024)) return i32(1)
                bits=bits+1
            }
            dropped=0;writes=0;enable=0xffffffff;route=0
            if (esp32S3GpioParkOutputOwned(pinNumber) || writes != 1 || route != 0) return i32(2)
            dropped=1;writes=0;enable=0xffffffff;route=0
            if (esp32S3GpioParkOutputOwned(pinNumber) || writes != 2) return i32(3)
        }
        pinNumber=pinNumber+1
    }
    writes=0
    if (esp32S3GpioParkOutputOwned(99) || writes != 0) return i32(4)
    return i32(0)
}
