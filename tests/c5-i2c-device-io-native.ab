import "../src/esp32/i2c/device_io_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(160)
var idle=true
var configured=true
var outcome=1
var calls=0
var stage=0
var bad=false
var probing=false
trusted fun c5I2cBusSetup(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int = 7
trusted fun c5I2cBusTeardown(sda: int,scl: int): int = 7
trusted fun c5I2cDeviceIdle(): bool {
    if (stage != 0 || atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(7)) bad=true
    stage=1
    idle
}
trusted fun c5I2cDeviceTiming(timing: u32): bool {
    if (stage != 1 || timing != (esp32S3I2cTiming(u32(40000000),u32(100000)) | u32(0))) bad=true
    stage=2
    configured
}
trusted fun c5I2cDeviceTransfer(address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    calls=calls+1
    if (stage != 2 || address != 73 || written != (if (probing) 0 else 1) || read != (if (probing) 0 else 2) ||
        budget != u32(160000) || prefix != (if (probing) -1 else 4)) bad=true
    stage=3
    outcome
}
@export("abla_c5_i2c_device_io_test")
trusted fun deviceIoTest(): i32 {
    val state=esp32C5I2cBusStateAt(nativeBufferAt(storage,64))
    val payload=nativeBufferAt(storage+128,32)
    var profile=0
    while (profile < 44) {
        state.initialize(); state.buffer().storeU32(8,2); state.buffer().storeU32(12,1)
        state.buffer().storeU32(28,40000000); state.buffer().storeU32(32,160000000)
        val pool=i2cInitializeDeviceSlots(storage+64,2)
        val handle=state.deviceOwned(pool,2,u32(7),73,100000)
        idle=profile/11%2 == 0; configured=profile/22 == 0; outcome=profile%11+1
        calls=0; stage=0; bad=false
        val expected=if (!idle) 8 else if (!configured) 7 else outcome
        val result=state.transferDeviceOwned(pool,u32(7),handle,payload,1,payload,2,1,4)
        if (result != expected || calls != (if (idle && configured) 1 else 0) || bad ||
            stage != (if (!idle) 1 else if (!configured) 2 else 3)) return i32(1)
        val token=atomicU32At(storage).compareExchange(u32(0),u32(0))
        if (token != (if (expected == 1) u32(0) else u32(0x80000000))) return i32(2)
        nativeAddressStoreU32(storage,0,0); calls=0; stage=0
        state.buffer().storeU32(8,3); state.buffer().storeU32(48,123)
        if (state.transferDeviceOwned(pool,u32(7),handle,payload,1,payload,2,1,4) != 7 || stage != 0 ||
            state.buffer().loadU32(48) != 123 || !state.closeDeviceOwned(pool,u32(7),handle)) return i32(3)
        state.buffer().storeU32(8,2)
        if (state.transferDeviceOwned(pool,u32(7),handle,payload,1,payload,2,1,4) != 7 || stage != 0) return i32(4)
        val replacement=state.deviceOwned(pool,2,u32(7),73,100000)
        var offset=0
        while (offset < 96) {
            val alias=nativeBufferAt(storage+offset,160-offset)
            if (state.transferDeviceOwned(pool,u32(7),replacement,alias,1,payload,2,1,4) != 7 ||
                state.transferDeviceOwned(pool,u32(7),replacement,payload,1,alias,1,1,4) != 7 || stage != 0) return i32(5)
            offset=offset+1
        }
        profile=profile+1
    }
    // Exhausted and even temporarily locked pool does not prevent a probe.
    val pool=i2cInitializeDeviceSlots(storage+64,1)
    val saved=pool.allocate(esp32S3I2cDeviceKey(0,73,100000,2))
    probing=true; idle=true; configured=true
    var result=1
    while (result <= 11) {
        nativeAddressStoreU32(storage,0,0); state.buffer().storeU32(8,2)
        stage=0; calls=0; bad=false; outcome=result
        nativeAddressStoreU32(storage+64,0,1)
        if (state.probeOwned(pool,u32(7),1,73,1) != 7 || stage != 0 ||
            state.probeOwned(pool,u32(7),2,128,1) != 7 || stage != 0) return i32(6)
        if (state.probeOwned(pool,u32(7),2,73,1) != result || calls != 1 || bad) return i32(7)
        nativeAddressStoreU32(storage+64,0,0)
        if (pool.resolve(saved) != esp32S3I2cDeviceKey(0,73,100000,2)) return i32(8)
        result=result+1
    }
    i32(0)
}
