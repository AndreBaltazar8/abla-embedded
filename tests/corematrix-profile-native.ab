import "../src/m5stack/corematrix_pins.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this
@export("abla_corematrix_profile_test")
fun coreMatrixProfileTest(): i32 {
    val board=m5CoreMatrix()
    if (board.boardId() != M5BoardId(152)) return i32(1)
    if (board.portA() != M5BoardId(152).portA()) return i32(2)
    if (board.portB() != M5BoardId(152).portB()) return i32(2)
    if (board.portC() != M5BoardId(152).portC()) return i32(2)
    if (board.portD() != M5BoardId(152).portD()) return i32(2)
    if (board.portE() != M5BoardId(152).portE()) return i32(2)
    if (board.sdPins() != M5BoardId(152).sdPins()) return i32(2)
    if (board.buttonA() != M5BoardId(152).buttonA()) return i32(2)
    if (board.buttonASource() != M5BoardId(152).buttonASource()) return i32(2)
    if (board.buttonB() != M5BoardId(152).buttonB()) return i32(2)
    if (board.buttonBSource() != M5BoardId(152).buttonBSource()) return i32(2)
    if (board.buttonC() != M5BoardId(152).buttonC()) return i32(2)
    if (board.buttonCSource() != M5BoardId(152).buttonCSource()) return i32(2)
    if (board.buttonExt() != M5BoardId(152).buttonExt()) return i32(2)
    if (board.buttonExtSource() != M5BoardId(152).buttonExtSource()) return i32(2)
    if (board.buttonPower() != M5BoardId(152).buttonPower()) return i32(2)
    if (board.buttonPowerSource() != M5BoardId(152).buttonPowerSource()) return i32(2)
    if (board.rgbLedPin() != M5BoardId(152).rgbLedPin()) return i32(2)
    if (board.powerHoldPin() != M5BoardId(152).powerHoldPin()) return i32(2)
    if (board.i2cPins() != m5I2cPinMap(1,0,1,0) || board.internalI2cClock().number() != 1 || board.internalI2cData().number() != 0 || board.externalI2cClock().number() != 1 || board.externalI2cData().number() != 0) return i32(3)
    if (board.buttonA().number() != -1 || board.buttonB().number() != -1 || board.buttonC().number() != -1 || board.buttonASource().isGpio() || board.buttonBSource().isGpio() || board.buttonCSource().isGpio()) return i32(4)
    if (board.buttonASource() != m5Pm1ButtonSource(0) || board.buttonBSource() != m5Pm1ButtonSource(1) || board.buttonCSource() != m5Pm1ButtonSource(2)) return i32(5)
    val sd=board.sdPins()
    if (sd.clock().number() != 25 || sd.command().number() != 27 || sd.data0().number() != 26 || sd.data3().number() != 28) return i32(6)
    var position=-1
    while (position <= 32) { if (board.mBusPin(position) != M5BoardId(152).mBusPin(position)) return i32(7); position=position+1 }
    if (board.rtcKind() != M5BoardId(152).rtcKind() || board.powerKind() != M5BoardId(152).powerKind()) return i32(8)
    i32(0)
}
