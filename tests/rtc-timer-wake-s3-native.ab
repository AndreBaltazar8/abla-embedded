import "../src/m5stack/rtc_timer_wake_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"
import "abla/build"
var reads=0
var prepares=0
var pinExpected=0
var high=true
var outcome=1
var bad=false
fun m5RtcCleanupRtcValid(handle: int): bool { bad=true; false }
fun m5RtcCleanupPmicValid(handle: int): bool { bad=true; false }
fun m5RtcCleanupRtc(handle: int,disable: bool): bool { bad=true; false }
fun m5RtcCleanupWake(handle: int): bool { bad=true; false }
fun m5RtcCleanupPmicIrq(handle: int): bool { bad=true; false }
fun m5RtcTimerSupported(handle: int): bool { bad=true; false }
fun m5RtcConfigureTimer(handle: int,duration: int): RtcTimerResult { bad=true; RtcTimerResult(0) }
fun m5RtcTimerWakeLineHigh(pin: int): bool { reads=reads+1; if (pin != pinExpected) bad=true; high }
fun m5RtcTimerWakePrepare(record: NativeBuffer,pin: int): int { prepares=prepares+1; if (pin != pinExpected) bad=true; outcome }
@export("abla_rtc_timer_wake_test")
trusted fun wakeTest(): i32 {
    val record=nativeBufferAt(nativeStaticAllocate(176),176)
    record.storeU32(0,0)
    var model=0
    while (model < 3) {
        val board=if (model == 0) m5BoardPaperColor else if (model == 1) m5BoardPaperMono else m5BoardStampPLC
        pinExpected=if (model == 0) 7 else if (model == 1) 1 else 14
        var cleanup=0
        while (cleanup < 512) {
            val accepted=cleanup == (if (model == 1) 375 else 273)
            val timer=M5RtcTimerResult(((1000<<8)|1)<<16 | cleanup)
            reads=0; prepares=0; bad=false; high=true; outcome=1
            if (board.prepareS3RtcTimerWakeOwned(record,timer,true) != (if (accepted) 1 else 3) ||
                reads != (if (accepted) 1 else 0) || prepares != reads || bad) return i32(1)
            cleanup=cleanup+1
        }
        val clean=if (model == 1) 375 else 273
        val timer=M5RtcTimerResult((((1000<<8)|1)<<16)|clean)
        outcome=0
        while (outcome < 4) {
            high=true; reads=0; prepares=0
            if (board.prepareS3RtcTimerWakeOwned(record,timer,true) != (if (outcome == 1) 1 else if (outcome == 0) 5 else outcome+4) || reads != 1 || prepares != 1) return i32(2)
            outcome=outcome+1
        }
        high=false; reads=0; prepares=0
        if (board.prepareS3RtcTimerWakeOwned(record,timer,true) != 4 || reads != 1 || prepares != 0) return i32(3)
        reads=0
        if (board.prepareS3RtcTimerWakeOwned(record,M5RtcTimerResult((1<<16)|clean),true) != 3 ||
            board.prepareS3RtcTimerWakeOwned(record,timer,false) != 3 || reads != 0) return i32(4)
        record.storeU32(0,123)
        if (board.prepareS3RtcTimerWakeOwned(record,timer,true) != 3 || reads != 0) return i32(5)
        record.storeU32(0,0)
        model=model+1
    }
    reads=0; prepares=0
    if (m5BoardToughC5.prepareS3RtcTimerWakeOwned(record,M5RtcTimerResult(0),true) != 2 ||
        m5BoardStickC.prepareS3RtcTimerWakeOwned(record,M5RtcTimerResult(0),true) != 2 || reads != 0 || prepares != 0) return i32(6)
    i32(0)
}
