import "../src/m5stack/charging_gpio.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
var cgPrepare=0
var cgReads=0
var cgFail=false
var cgLevel=false
var cgBad=false
fun m5ChargingInputOwned(number: int): bool {
    if (number != 4 || cgReads != 0) cgBad=true
    cgPrepare=cgPrepare+1;return !cgFail
}
fun Pin.read(): bool {
    if (this != 4 || cgPrepare != 1 || cgFail) cgBad=true
    cgReads=cgReads+1;return cgLevel
}
@export("abla_m5_charging_gpio_test")
fun testGpioCharging(): int {
    var board=0
    while (board < 256) {
        var scenario=0
        while (scenario < 8) {
            val owns=(scenario&1) != 0
            cgFail=(scenario&2) != 0;cgLevel=(scenario&4) != 0
            cgPrepare=0;cgReads=0;cgBad=false
            val id=M5BoardId(board)
            val supported=id == m5BoardPaperS3
            if (id.chargingStatusPin().number() != (if (supported) 4 else -1)) return 1
            val expected=if (!supported || !owns) -1 else if (cgFail) -2 else if (cgLevel) 0 else 1
            if (id.readGpioChargingOwned(owns) != expected || cgBad ||
                cgPrepare != (if (supported && owns) 1 else 0) || cgReads != (if (expected >= 0) 1 else 0)) return 2
            scenario=scenario+1
        }
        board=board+1
    }
    return 0
}
