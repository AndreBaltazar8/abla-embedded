import "../src/esp32/power/sleep_timed_record_s3_sequence.ab"
import "../src/esp32/power/sleep_policy_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Esp32S3SleepUsbSerial = int
fun Esp32S3SleepUsbSerial.valid(): bool = this == 7
var phase=0
var sar=5
var fail=0
var bad=false
var now=0xFFFFFFFFFFF0
var entry=0
var externalOnly=false
fun esp32S3SleepTimingBits(period: int,deep: bool): int = if (period > 0) 1 else -1
fun esp32S3RtcTicksForMicroseconds(duration: int,period: int): int = duration
fun esp32S3MspiStateRead(address: int): int {
    if (address == 4096) return 0x53504C50
    if (address == 4100) return 9
    if (address == 4200) return 1
    if (address == 4204) return 7 | (sar<<8)
    bad=true; 0
}
fun esp32S3SleepRegistersPrepareOwned(flags: int,period: int): bool {
    if (phase != 0) bad=true
    phase=1; fail != 1
}
fun esp32S3RtcCyclesOwned(): int { if (phase != 1) bad=true; phase=2; now }
fun esp32S3RtcSetAlarmOwned(deadline: int): bool {
    if (phase != 2 || deadline != 16) bad=true
    phase=3; fail != 2
}
fun esp32S3SleepRetainedRecordEnterOwned(record: NativeBuffer,wake: int,reject: int): int {
    if (phase != (if (externalOnly) 1 else 3) || wake != (if (externalOnly) 2 else 10) || reject != 1) bad=true
    phase=4; entry
}
@export("abla_sleep_timed_record_test")
trusted fun timedTest(): i32 {
    val record=nativeBufferAt(4096,128)
    var monitor=0
    while (monitor < 2) {
        sar=if (monitor != 0) 4 else 5
        val flags=256 | (if (monitor != 0) 0x20000 else 0)
        fail=0
        while (fail < 3) {
            entry=-2
            while (entry <= 1) {
                phase=0; bad=false
                val result=esp32S3SleepTimedRecordEnterOwned(record,flags,1,32,2,1)
                if (result != (if (fail == 0) entry else -5) || bad || phase != (if (fail == 0) 4 else if (fail == 1) 1 else 3)) return i32(1)
                entry=entry+1
            }
            fail=fail+1
        }
        phase=0
        if (esp32S3SleepTimedRecordEnterOwned(record,flags ^ 0x20000,1,32,2,1) != -4 || phase != 0) return i32(2)
        var bit=0
        while (bit < 3) {
            val unsupported=if (bit == 0) 1 else if (bit == 1) 32 else 512
            if (esp32S3SleepTimedRecordEnterOwned(record,flags | unsupported,1,32,2,1) != -4 || phase != 0) return i32(3)
            bit=bit+1
        }
        if (esp32S3SleepTimedRecordEnterOwned(record,flags,0,32,2,1) != -4 || phase != 0) return i32(4)
        if (esp32S3SleepTimedRecordEnterOwned(record,flags,1,0,2,1) != -4 || phase != 0) return i32(5)
        if (esp32S3SleepTimedRecordEnterOwned(record,flags | 2,1,32,1,1) != -4 || phase != 0) return i32(6)
        monitor=monitor+1
    }
    externalOnly=true; sar=5
    fail=0
    while (fail <= 1) {
        entry=-2
        while (entry <= 1) {
            phase=0; bad=false
            val result=esp32S3SleepExternalOnlyRecordEnterOwned(record,256,1,2,1)
            if (result != (if (fail == 0) entry else -5) || bad || phase != (if (fail == 0) 4 else 1)) return i32(7)
            entry=entry+1
        }
        fail=fail+1
    }
    phase=0
    if (esp32S3SleepExternalOnlyRecordEnterOwned(record,256,1,0,1) != -4 ||
        esp32S3SleepExternalOnlyRecordEnterOwned(record,256,1,10,1) != -4 ||
        esp32S3SleepExternalOnlyRecordEnterOwned(record,258,1,1,1) != -4 || phase != 0) return i32(8)
    i32(0)
}
