import "./nesso-display-wire-native.ab"
import "../src/m5stack/nesso_touch_c6_bindings.ab"
import "../src/m5stack/nesso_touch_tracker_c6_bindings.ab"
import "../src/m5stack/nesso_touch_power_c6_bindings.ab"
import "../src/runtime/memory32.ab"
#requiredInternalFunction("freestandingMemorySet32","memset")
val touchSnapshot=nativeStaticAllocate(29)
val trackerStorage=nativeStaticAllocate(184)
val savedTracker=nativeStaticAllocate(184)
fun trackerUnchanged(): bool {
    var at=0
    while (at < 184) {
        if (nativeBufferAt(trackerStorage,184).load(at) != nativeBufferAt(savedTracker,184).load(at)) return false
        at=at+1
    }
    return true
}
@export("abla_nesso_touch_wire_test")
trusted fun testTouchWire(): i32 {
    wireSeed();chargeAddress=68;afterCommit=false;bad=false;dropClose=false;ticks=0
    val gpioRegs=nativeBufferAt(gpioMemory,4096);var at=0
    while (at < 4096) { gpioRegs.storeU32(at,0);at=at+4 }
    apb=u32(0);functional=u32(0x300000);gpioClock=u32(0)
    var session=esp32C6I2cSessionOpenOwned(10,8,40000000,20000000,true,5,8)
    val display=nessoDisplayAt(nativeBufferAt(displayStorage,40))
    nativeBufferAt(chargeRegisters,256).store(1,1)
    if (!session.ready() || !display.initialize()) return i32(1)
    displayGateAddress=displayGate;displayCapture=true
    expectDisplay(nativeBufferAt(initialStream,68),64868)
    if (display.openOwned(session.bus()|0,peripheralGateAt(displayGate),u32(7),0,true,true) != 1 || !displayStreamDone()) return i32(2)
    rtcPresent=true;rtcAddress=56
    val regs=nativeBufferAt(rtcRegisters,256)
    at=0;while (at < 256) { regs.store(at,0);at=at+1 }
    regs.store(168,1)
    var fault=1
    while (fault <= 9) {
        val before=ackCount;nackAt=before+fault
        val failed=display.openTouchOwned(session.bus()|0,true)
        if (failed.status() != 3 || failed.handle() != 0 || ackCount-before != fault || bad) return i32(3)
        fault=fault+1
    }
    nackAt=0
    var touch=display.openTouchOwned(session.bus()|0,true)
    if (!touch.ready() || regs.load(0) != 0 || regs.load(164) != 0) return i32(4)
    regs.store(2,1);regs.store(3,128);regs.store(4,12);regs.store(5,48);regs.store(6,34)
    val snapshot=nativeBufferAt(touchSnapshot,29)
    val count=display.readTouchOwned(session.bus()|0,touch,snapshot,true)
    val point=nessoTouchPoint(snapshot,count,0,0)
    val rotated=nessoTouchPoint(snapshot,count,0,1)
    if (count != 1 || !point.valid() || point.x() != 12 || point.y() != 34 || point.id() != 3 || point.event() != 2 ||
        rotated.x() != 34 || rotated.y() != 122) return i32(5)
    val tracker=touchTrackerAt(trackerStorage)
    if (display.pollTouchTrackerOwned(session.bus()|0,touch,tracker,snapshot,10,true) != 1 ||
        !tracker.detail(3).wasPressed() || tracker.detail(3).point().x() != 12 || tracker.detail(3).point().y() != 34) return i32(12)
    at=0;while (at < 184) { nativeBufferAt(savedTracker,184).store(at,nativeBufferAt(trackerStorage,184).load(at));at=at+1 }
    val throttled=ackCount
    if (display.pollTouchTrackerOwned(session.bus()|0,touch,tracker,snapshot,14,true) != -3 || ackCount != throttled || !trackerUnchanged()) return i32(13)
    regs.store(4,135)
    if (display.pollTouchTrackerOwned(session.bus()|0,touch,tracker,snapshot,20,true) != -4 || !trackerUnchanged()) return i32(14)
    regs.store(4,12);regs.store(2,2);regs.store(9,128);regs.store(10,13);regs.store(11,48);regs.store(12,35)
    if (display.pollTouchTrackerOwned(session.bus()|0,touch,tracker,snapshot,20,true) != -4 || !trackerUnchanged()) return i32(15)
    regs.store(2,1)
    fault=1
    while (fault <= 12) {
        nackAt=ackCount+fault
        if (display.pollTouchTrackerOwned(session.bus()|0,touch,tracker,snapshot,20,true) != -1 || !trackerUnchanged()) return i32(6)
        fault=fault+1
    }
    nackAt=0;val before=ackCount
    if (display.readTouchOwned(session.bus()|0,touch,display.buffer(),true) != -1 ||
        display.readTouchOwned(session.bus()|0,touch,snapshot,false) != -1 || ackCount != before) return i32(7)
    if (display.pollTouchTrackerOwned(session.bus()|0,touch,tracker,nativeBufferAt(trackerStorage,29),20,true) != -1 ||
        ackCount != before || !trackerUnchanged()) return i32(16)
    regs.store(2,0)
    if (display.pollTouchTrackerOwned(session.bus()|0,touch,tracker,snapshot,20,true) != 0 || tracker.detail(3).state() != touchEnd) return i32(17)
    touchPowerPulse=true;touchPowerPulses=0
    val beforePower=ackCount;val writesBefore=gpioWrites
    if (nessoTouchSleepOwned(session.bus()|0,touch,false) != touch || nessoTouchWakeOwned(session.bus()|0,touch,false) != touch ||
        ackCount != beforePower || gpioWrites != writesBefore) return i32(18)
    var powerFault=0
    while (powerFault <= 6) {
        nackAt=if (powerFault >= 1 && powerFault <= 3) ackCount+powerFault else 0
        touch=nessoTouchSleepOwned(session.bus()|0,touch,true)
        if (touch.status() != (if (powerFault >= 1 && powerFault <= 3) 6 else 5) || touch.ready()) return i32(19)
        nackAt=if (powerFault >= 4) ackCount+powerFault-3 else 0
        touch=nessoTouchWakeOwned(session.bus()|0,touch,true)
        if (touch.status() != (if (powerFault >= 4) 6 else 1) || (gpioRegs.loadU32(288)&8) != 0 ||
            (gpioRegs.loadU32(16)&384) != 256) return i32(20)
        if (powerFault >= 4) {
            nackAt=0;touch=nessoTouchWakeOwned(session.bus()|0,touch,true)
            if (!touch.ready()) return i32(21)
        }
        if (regs.load(165) != 1 || bad) return i32(22)
        powerFault=powerFault+1
    }
    if (touchPowerPulses != 10) return i32(23)
    touchPowerPulse=false;nackAt=0
    val beforeClose=ackCount
    val stale=touch;touch=touch.closeOwned()
    if (touch != 0 || display.readTouchOwned(session.bus()|0,stale,snapshot,true) != -1 || ackCount != beforeClose) return i32(8)
    expectDisplay(NativeBuffer(0),0)
    if (!display.closeOwned(true) || !displayStreamDone()) return i32(9)
    displayCapture=false
    if (!Pin(17).inputOwned() || !Pin(16).inputOwned() || !Pin(20).inputOwned() || !Pin(21).inputOwned()) return i32(10)
    session=session.closeOwned(true)
    if (session != 0 || bad) return i32(11)
    return i32(0)
}
