import "../src/esp32/power/sleep_calibration_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var reads=0
var statusReads=0
var readyAfter=0
var race=false
var bad=false
trusted fun c5SleepEfuseRead(offset: int): int {
    reads=reads+1
    if (offset == 0x1d4) { statusReads=statusReads+1;return if (statusReads <= readyAfter || (race && statusReads > readyAfter+1)) 0 else 1 }
    if (offset == 0x4c) return 0x210
    if (offset == 0x50) return 0xffffffff
    if (offset == 0x54) return 1
    bad=true;return 0
}
@export("abla_sleep_calibration_c5_test")
trusted fun test(): i32 {
    var revision=0
    while (revision < 8192) {
        val chip=((revision>>4)&3)*100+(revision&15)
        val block=((revision>>11)&3)*100+((revision>>8)&7)
        val present=(chip == 1 && block >= 1) || (chip >= 100 && block >= 2)
        var raw=0
        while (raw < 32) {
            val nibble=raw&15
            val sys3=u32((nibble<<10)|(nibble<<14)|((raw&3)<<18)|(nibble<<20)|(nibble<<24)|(nibble<<28))
            val result=esp32C5SleepCalibrationDecode(u32(revision),sys3,u32(raw>>4))
            val active=if (!present || nibble == 0) 28 else if (nibble+19 > 31) 31 else nibble+19
            if (!result.valid() || (result&15) != (if (present) raw&3 else 1) || ((result>>4)&31) != (if (present) nibble else 0) ||
                ((result>>9)&15) != (if (present) nibble else 9) || ((result>>13)&31) != (if (present) raw else 15) ||
                ((result>>18)&31) != active || ((result>>23)&31) != active) return i32(1)
            raw=raw+1
        }
        revision=revision+1
    }
    var delay=0
    while (delay < 5) {
        reads=0;statusReads=0;readyAfter=delay;race=false
        val result=esp32C5SleepCalibrationReadOwned(true,4)
        if (result.valid() != (delay < 4) || reads != (if (delay < 4) delay+5 else 4) || bad) return i32(2)
        if (result.valid() && result != esp32C5SleepCalibrationDecode(u32(0x210),u32(0xffffffff),u32(1))) return i32(3)
        delay=delay+1
    }
    readyAfter=0;statusReads=0;race=true
    if (esp32C5SleepCalibrationReadOwned(true).valid()) return i32(4)
    reads=0
    if (esp32C5SleepCalibrationReadOwned(false).valid() || esp32C5SleepCalibrationReadOwned(true,0).valid() || reads != 0) return i32(5)
    val output=nativeBufferAt(nativeStaticAllocate(56),56)
    output.storeU32(0,123)
    if (C5SleepCalibration(-1).analog(output,false,true,true,false,false) || output.loadU32(0) != 123) return i32(6)
    val calibrated=esp32C5SleepCalibrationDecode(u32(0x210),u32(0xffffffff),u32(1))
    if (!calibrated.analog(output,false,true,true,false,false) || output.loadU32(0) != 3 || output.loadU32(16) != 15) return i32(7)
    return i32(0)
}
