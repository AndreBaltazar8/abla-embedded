import "../src/xtensa/interrupt_guard_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var status=0
var restores=0
fun xtensaGuardCore(): int = core
fun xtensaGuardStatus(): int = status
fun xtensaGuardMaskLocal(): int { val old=status; status=status | 15; return old }
fun xtensaGuardRestoreLevel(level: int): void { status=(status & ~15) | level; restores=restores+1; return }
@export("abla_interrupt_guard_test")
trusted fun guardTest(): i32 {
    while (core < 2) {
        var level=0
        while (level < 16) {
            status=0x40020 | level; restores=0
            val outer=xtensaInterruptGuardEnter()
            val inner=xtensaInterruptGuardEnter()
            if (!outer.valid() || outer.core() != core || outer.previousLevel() != level || !xtensaInterruptGuardLeave(inner) || status != 0x4002F) return i32(1)
            // Emulate unrelated PS changes; leave must not restore stale bits.
            status=0x5002F
            if (!xtensaInterruptGuardLeave(outer) || status != (0x50020 | level) || restores != 2) return i32(2)
            level=level+1
        }
        core=core+1
    }
    core=0; status=15; restores=0
    if (xtensaInterruptGuardLeave(XtensaInterruptGuard(0)) || xtensaInterruptGuardLeave(XtensaInterruptGuard(48)) || xtensaInterruptGuardLeave(XtensaInterruptGuard(96)) || restores != 0) return i32(3)
    status=14
    if (xtensaInterruptGuardLeave(XtensaInterruptGuard(32)) || restores != 0) return i32(4)
    i32(0)
}
