import "../src/m5stack/tough_rtc_interrupt_sequence.ab"
import "../src/power/m5pm1_device.ab"
import "../src/rtc/rx8130_device.ab"
import "../src/m5stack/rtc_device.ab"
import "../src/i2c/results.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type I2cDevice = int
val timerPreset=nativeStaticAllocate(2)
val timerVerify=nativeStaticAllocate(2)
var phase=0
var failure=0
var retries=0
var stopCalls=0
var cleanupBad=false
var bad=false
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister8(register: int): int { bad=true; return 0 }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    if (phase == 0) {
        if (register != 28) bad=true
        phase=1
        return I2cByteResult(if (failure == 1) 0 else 256)
    }
    if (phase == 9) {
        if (register != (if ((stopCalls & 3) == 2) 28 else 30)) bad=true
        stopCalls=stopCalls+1
        return I2cByteResult(if (cleanupBad) 272 else 256)
    }
    bad=true; I2cByteResult(0)
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    if (this == 9) {
        if ((phase != 1 && phase != 6 && phase != 9) || register != (if (pmicWrites == 0) 5 else 63+pmicWrites) ||
            value != 0 || pmicWrites >= 4) bad=true
        val accepted=(pmicFailure&int(u32(1)<<u32(pmicWrites))) == 0
        pmicWrites=pmicWrites+1
        return accepted
    }
    if (this != 7) bad=true
    if (phase == 1) {
        if (register != 28 || value != 1) bad=true
        phase=2
        return failure != 2
    }
    if (phase == 2) {
        if (register != 29 || value != 175) bad=true
        phase=3
        return failure != 3
    }
    if (phase == 5) {
        if (register != 28 || value != 17) bad=true
        phase=6
        return failure != 7
    }
    bad=true; false
}
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    if (value == 16) {
        if (phase != 3 || register != 30 || mask != 16) bad=true
        phase=4
        return failure != 4
    }
    phase=9
    if (register != (if ((stopCalls & 3) == 0) 28 else 30) || mask != 16 || value != 0) bad=true
    stopCalls=stopCalls+1
    true
}
trusted fun I2cDevice.writeRegister(register: int,buffer: NativeBuffer,bytes: int): bool {
    if ((phase != 4 && phase != 5) || register != 26 || bytes != 2 || buffer.loadU16(0) != 64) bad=true
    retries=retries+1; phase=4
    failure != 5
}
trusted fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,bytes: int): bool {
    if (phase != 4 || register != 26 || bytes != 2) bad=true
    buffer.storeU16(0,if (failure == 6 || (failure == 8 && retries < 3)) 63 else 64)
    phase=5
    true
}

val ownerMemory=nativeStaticAllocate(96)
var pmicFailure=0
var pmicWrites=0
var busChecks=0
fun toughRtcBusOwnsPmic(bus: int,pmic: int): bool { if (bus != 13 || pmic != 9 || busChecks != 0) bad=true;busChecks=1;return true }
fun toughRtcBusOwnsRx8130(bus: int,rtc: int): bool { if (bus != 13 || rtc != 7 || busChecks != 1) bad=true;busChecks=2;return true }
fun m5RtcCleanupRtcValid(rtc: int): bool = M5Rtc(rtc).valid()
fun m5RtcCleanupPmicValid(pmic: int): bool = M5Pm1(pmic).valid()
fun m5RtcTimerSupported(rtc: int): bool = M5Rtc(rtc).supportsTimerInterrupt()
trusted fun m5RtcConfigureTimer(rtc: int,milliseconds: int): RtcTimerResult = M5Rtc(rtc).setTimerInterruptChecked(milliseconds)
trusted fun m5RtcConfigureAlarm(rtc: int,minute: int,hour: int,day: int,weekday: int): RtcAlarmResult =
    M5Rtc(rtc).setAlarmInterruptChecked(minute,hour,day,weekday)
trusted fun m5RtcCleanupRtc(rtc: int,disable: bool): bool =
    if (disable) M5Rtc(rtc).disableInterrupts() else M5Rtc(rtc).clearInterrupt()
trusted fun m5RtcCleanupWake(pmic: int): bool = M5Pm1(pmic).clearWakeSource()
trusted fun m5RtcCleanupPmicIrq(pmic: int): bool = M5Pm1(pmic).clearIrqStatus()
// Unused device creation/telemetry boundary must never masquerade as success.
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true;return I2cDwordResult(0) }
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true;return I2cWordResult(0) }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true;return false }
@export("abla_toughc5_rtc_timer_components_test")
trusted fun test(): int {
    val bytes=nativeBufferAt(ownerMemory,96);val owner=m5ToughPowerOwnerAt(bytes)
    bytes.storeU32(0,0x54435057);bytes.storeU32(4,1);bytes.storeU32(8,9);bytes.storeU32(12,261)
    bytes.storeU32(16,1|(5<<8));bytes.storeU32(20,0)
    val rtc=M5RtcOpenResult((1<<40)|(2<<32)|7)
    var mode=0
    while (mode < 288) {
        failure=mode/32;cleanupBad=(mode&16) != 0;pmicFailure=mode&15
        phase=0;retries=0;stopCalls=0;bad=false;pmicWrites=0;busChecks=0
        val result=owner.setRtcTimerOwned(rtc,13,1000,true)
        val success=failure == 0 || failure == 8
        val expected=if (success) 1 else if (failure == 1) 3 else if (cleanupBad) 5 else 4
        val done=(if (success) 1 else 0)|(if ((pmicFailure&1) == 0) 2 else 0)|(if ((pmicFailure&14) == 0) 4 else 0)
        if (result.timer().status() != expected || result.timer().milliseconds() != (if (success) 1000 else 0) ||
            result.cleanup().completed() != done || !result.cleanup().valid() ||
            result.success() != (success && pmicFailure == 0) || pmicWrites != 4 || busChecks != 2 || bad ||
            stopCalls != (if (success || failure == 1) 0 else if (cleanupBad) 12 else 4) ||
            retries != (if (failure >= 1 && failure <= 4) 0 else if (failure == 5 || failure == 6 || failure == 8) 3 else 1)) return 1
        mode=mode+1
    }
    return 0
}
