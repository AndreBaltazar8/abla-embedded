import "../src/esp32/power/sleep_policy_p4_sequence.ab"
var reject=u32(0)
var timing=u32(0)
var events=u32(0)
var cause=u32(0)
var writes=0
var fail=0
var bad=false
trusted fun p4SleepPolicyRead(offset: int): u32 {
    if (offset == 292) return reject
    if (offset == 300) return timing
    if (offset == 324) return u32(0x80001000)
    if (offset == 328) return cause
    if (offset == 356) return events
    bad=true;return u32(0)
}
trusted fun p4SleepPolicyWrite(offset: int,value: u32): void {
    writes=writes+1;if (writes == fail) return
    if (offset == 292) { reject=value;return }
    if (offset == 300) {
        if ((reject&u32(0x80000000)) != u32(0)) bad=true
        timing=value;return
    }
    if (offset == 368) { if ((value&u32(0x3fffffff)) != u32(0)) bad=true;events=events&~value;return }
    if (offset == 304) { if (value != u32(0x80000000)) bad=true;cause=u32(0);return }
    bad=true;return
}
trusted fun seed(): void {
    reject=u32(0xfedcba98);timing=u32(0xdead55aa);events=u32(0xc0001234);cause=u32(0x80002000)
    writes=0;fail=0;bad=false;return
}
@export("abla_sleep_policy_p4_test")
trusted fun test(): i32 {
    var protection=0
    while (protection < 4) {
        var fault=0
        while (fault <= 3) {
            seed();fail=fault
            var owner=esp32p4SleepPolicyOpenOwned(u32(4096),true,17,protection,true)
            if (owner.status() != (if (fault == 0) 1 else 3) || !owner.hasSnapshot() || bad) return i32(1)
            fail=0;owner=owner.closeOwned(true)
            if (owner.status() != 4 || reject != u32(0xfedcba98) || timing != u32(0xdead55aa) ||
                events != u32(0xc0001234) || cause != u32(0x80002000) || bad) return i32(2)
            seed();owner=esp32p4SleepPolicyOpenOwned(u32(4096),true,17,protection,true)
            writes=0;fail=fault;owner=owner.closeOwned(true)
            if (owner.status() != (if (fault == 0) 4 else 3) || bad) return i32(3)
            fail=0;owner=owner.closeOwned(true)
            if (owner.status() != 4 || reject != u32(0xfedcba98) || timing != u32(0xdead55aa) || bad) return i32(4)
            fault=fault+1
        }
        protection=protection+1
    }
    var ack=0
    while (ack < 4) {
        seed()
        if (esp32p4SleepWakeCause() != u32(4096) || esp32p4SleepRejectCause() != u32(8192) || esp32p4SleepEvents() != 3 || writes != 0) return i32(5)
        if (!esp32p4SleepAcknowledgeOwned(ack,false,true) || cause != u32(0x80002000) ||
            events != (u32(0xc0001234)&~(u32(ack)<<u32(30))) || bad) return i32(6)
        if (!esp32p4SleepAcknowledgeOwned(0,true,true) || cause != u32(0) || bad) return i32(7)
        ack=ack+1
    }
    seed()
    if (esp32p4SleepPolicyOpenOwned(u32(0x100000),true,1,0,true).status() != 2 ||
        esp32p4SleepPolicyOpenOwned(u32(1),true,256,0,true).status() != 2 ||
        esp32p4SleepPolicyOpenOwned(u32(1),true,1,4,true).status() != 2 ||
        esp32p4SleepPolicyOpenOwned(u32(1),true,1,0,false).status() != 2 ||
        esp32p4SleepAcknowledgeOwned(4,true,true) || writes != 0 || bad) return i32(8)
    return i32(0)
}
