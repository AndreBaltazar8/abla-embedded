import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/run_c6_sequence.ab"
var conf=u32(0)
var tx=false
var idle=true
var enabled=true
var writes=0
var drop=false
var bad=false
trusted fun c6I2sClockRead(at: int): u32 = if (at == 0) u32(1) else if (enabled) u32(0x400000) else u32(0)
trusted fun c6I2sClockWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6I2sRead(at: int): u32 = if (at == (if (tx) 0x24 else 0x20)) conf else if (at == 0x6c && idle) u32(1) else u32(0)
trusted fun c6I2sWrite(at: int,v: u32): void {
    writes=writes+1
    if (at != (if (tx) 0x24 else 0x20) || ((v^conf)&~u32(4)) != u32(0)) bad=true
    if (!drop) conf=v
    return
}
@export("abla_i2s_run_c6_test")
trusted fun test(): i32 {
    var direction=0
    while (direction < 2) {
        tx=direction == 1
        var bit=0
        while (bit < 32) {
            val initial=(u32(1)<<u32(bit))&~u32(0x107)
            conf=initial;idle=true;writes=0;drop=false;enabled=true
            val update=C6I2sUpdate((int(initial)<<16)|513|(if (tx) 256 else 0))
            if (c6I2sStartUpdatedOwned(update,true) != 1 || writes != 1 || conf != (initial|u32(4))) return i32(1)
            if (c6I2sStartUpdatedOwned(update,true) != 4 || writes != 1) return i32(2)
            drop=true
            if (c6I2sStopOwned(0,tx,1,true) != 5 || conf != (initial|u32(4))) return i32(3)
            drop=false;idle=false
            if (c6I2sStopOwned(0,tx,1,true) != (if (tx) 6 else 1) || conf != initial) return i32(4)
            val stoppedWrites=writes
            idle=true
            if (c6I2sStopOwned(0,tx,1,true) != 1 || writes != stoppedWrites) return i32(5)
            drop=true
            if (c6I2sStartUpdatedOwned(update,true) != 5 || conf != initial) return i32(6)
            drop=false;conf=initial^u32(8192)
            val failedWrites=writes
            if (c6I2sStartUpdatedOwned(update,true) != 4 || writes != failedWrites) return i32(7)
            conf=initial;enabled=false
            if (c6I2sStartUpdatedOwned(update,true) != 3 || c6I2sStopOwned(0,tx,1,true) != 3 || writes != failedWrites) return i32(8)
            enabled=true
            if (c6I2sStartUpdatedOwned(C6I2sUpdate(update+4),true) != 2 || c6I2sStartUpdatedOwned(update,false) != 2 || c6I2sStopOwned(1,tx,1,true) != 2 || writes != failedWrites || bad) return i32(9)
            bit=bit+1
        }
        direction=direction+1
    }
    return i32(0)
}
