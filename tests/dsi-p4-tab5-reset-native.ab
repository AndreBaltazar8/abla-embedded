import "../src/m5stack/tab5_reset_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var latch=0
var direction=0
var impedance=0
var initial=0
var operations=0
var fail=0
var delays=0
var selected=false
var bad=false
fun softwareI2cDrive(pin: int,release: bool): void { bad=true; return }
fun softwareI2cSample(pin: int): bool { bad=true; return false }
fun softwareI2cDelay(us: int): void { bad=true; return }
fun operation(): bool { operations=operations+1; return operations != fail }
trusted fun tab5ResetRead(bus: SoftwareI2cLines,register: int,scratch: NativeBuffer): I2cByteResult {
    if (!operation()) return I2cByteResult(0)
    return I2cByteResult(256|(if (register == 5) latch else if (register == 3) direction else impedance))
}
trusted fun tab5ResetWrite(bus: SoftwareI2cLines,register: int,value: int,scratch: NativeBuffer): bool {
    if (!operation()) return false
    if (!selected || (value&207) != (initial&207)) bad=true
    if (register == 5) latch=value else if (register == 3) direction=value else impedance=value
    return true
}
fun tab5ResetSelectAddress(high: bool): bool {
    if (!operation()) return false
    selected=high; return true
}
fun tab5ResetDelay(ms: int): void {
    if (ms != (if (delays == 0) 10 else 100) || (direction&48) != 48 || (impedance&48) != 0 ||
        (latch&48) != (if (delays == 0) 0 else 48) || selected != (delays == 0)) bad=true
    delays=delays+1; return
}
fun resetFixture(value: int): void { initial=value; latch=value; direction=value; impedance=value; operations=0; fail=0; delays=0; selected=false; bad=false; return }
@export("abla_dsi_p4_tab5_reset_test")
trusted fun testReset(): i32 {
    val bus=softwareI2cLines(31,32,5,2000)
    val scratch=nativeBufferAt(805306368,1)
    var profile=0
    while (profile < 256) {
        resetFixture(profile)
        if (tab5DisplayTouchResetOwned(bus,scratch) != 1 || operations != 13 || delays != 2 || selected || bad) return i32(1)
        profile=profile+1
    }
    var fault=1
    while (fault <= 13) {
        resetFixture(165); fail=fault
        if (tab5DisplayTouchResetOwned(bus,scratch) == 1 || operations != fault || bad || delays > 1) return i32(2)
        fault=fault+1
    }
    resetFixture(0)
    if (tab5DisplayTouchResetOwned(softwareI2cLines(32,31,5,2000),scratch) != 2 ||
        tab5DisplayTouchResetOwned(bus,NativeBuffer(0)) != 2 || operations != 0) return i32(3)
    return i32(0)
}
