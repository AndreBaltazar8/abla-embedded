import "../src/esp32/rtc_timer_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var timer=0
var ticks=0
var hi=0
var lo=0
var stage=0
var fail=0
var alarm=false
var bad=false
trusted fun c5RtcTimerRead(offset: int): int {
    if (!alarm) {
        if (offset == 0x10 && stage == 0) return 0xf0000055
        if (offset == 0x14+timer*8 && stage == 1) { stage=2;return ticks&0xFFFFFFFF }
        if (offset == 0x18+timer*8 && stage == 2) { stage=3;return 0xbeef0000|((ticks>>>32)&65535) }
    } else {
        if (offset == timer*8+4) return hi
        if (offset == timer*8) return lo
    }
    bad=true;return 0
}
trusted fun c5RtcTimerWrite(offset: int,value: int): void {
    if (!alarm) {
        if (offset != 0x10 || value != 0xf8000055 || stage != 0) bad=true
        stage=1;return
    }
    if (stage == 0) {
        if (offset != (if (timer == 0) 0x34 else 0x44) || value != 0x80000000) bad=true
    } else if (stage == 1) {
        if (offset != timer*8+4 || (value&0xffff0000) != 0x4050000) bad=true
        if (fail != 1) hi=value
    } else if (stage == 2) {
        if (offset != timer*8 || value != (ticks&0xFFFFFFFF)) bad=true
        if (fail != 2) lo=value
    } else if (stage == 3) {
        if (offset != timer*8+4 || value != (hi|0x80000000)) bad=true
    } else bad=true
    stage=stage+1;return
}
@export("abla_rtc_timer_c5_test")
trusted fun test(): int {
    timer=0
    while (timer < 2) {
        var bit=0
        while (bit < 50) {
            ticks=if (bit == 48) 0 else if (bit == 49) 0xFFFFFFFFFFFF else 1<<bit
            stage=0;alarm=false;bad=false
            if (esp32C5RtcTicksOwned(timer,true) != ticks || stage != 3 || bad) return 1
            fail=0
            while (fail < 3) {
                hi=0x84050000|(((ticks>>>32)&65535)^65535)
                lo=(ticks&0xFFFFFFFF)^0xFFFFFFFF
                stage=0;alarm=true;bad=false
                val result=esp32C5RtcAlarmOwned(timer,ticks,true)
                if (result != (if (fail == 0) 1 else 3) || stage != (if (fail == 0) 4 else 3) || bad) return 2
                fail=fail+1
            }
            bit=bit+1
        }
        timer=timer+1
    }
    stage=0;bad=false
    if (esp32C5RtcTicksOwned(2,true) != -1 || esp32C5RtcTicksOwned(0,false) != -1 || esp32C5RtcAlarmOwned(0,-1,true) != 2 || esp32C5RtcAlarmOwned(1,0x1000000000000,true) != 2 || esp32C5RtcAlarmOwned(1,1,false) != 2 || stage != 0 || bad) return 3
    if (esp32C5RtcElapsedTicks(0xFFFFFFFFFFFF,3) != 4 || esp32C5RtcElapsedTicks(42,42) != 0 || esp32C5RtcElapsedTicks(0,0xFFFFFFFFFFFF) != 0xFFFFFFFFFFFF || esp32C5RtcElapsedTicks(-1,0) != -1) return 4
    0
}
