import "../src/esp32/spi/buffer_sequence_esp32s3.ab"
import "../src/esp32/spi/command_sequence_esp32s3.ab"
import "../src/spi/pins.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/hal/delay.ab"
import "../src/hal/esp32_spi.ab"
import "../src/hal/pin.ab"
import "../src/hal/esp32_spi_2.ab"
import "../src/hal/esp32_spi_3.ab"
import "../src/hal/spitransactionresult.ab"
import "abla/unsafe/memory/raw"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/spi/spitransactionresult_type.ab"
import "../src/peripheral_gate.ab"
import "../src/hal/native_buffer.ab"
import "../src/esp32/sdk/nativebuffer_type.ab"
var pinFail = -1
@export("abla_pin_outputLevelOwned")
trusted fun pinOutputLevelOwnedHook(pin: int, high: bool): bool {
    Pin(pin).write(high);Pin(pin).setOpenDrain(false);Pin(pin).output();return pinFail != 0
}
@export("abla_pin_writeLevelOwned")
trusted fun pinWriteLevelOwnedHook(pin: int, high: bool): bool {
    Pin(pin).write(high)
    return pinFail != (if (Pin(pin) == 35) 2 else if (high) 3 else 1)
}
@export("abla_pin_inputOwned")
trusted fun pinInputOwnedHook(pin: int): bool { Pin(pin).input();return pinFail != 4 }
val storage = nativeStaticAllocate(256)
var step = 0
var calls = 0
var failAt = -1
var bytes = 129
var offset = 0
var bad = false
@export("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin) == 35 || Pin(pin) == 3
@export("esp32s3SpiTransmitPinsValid")
fun esp32s3SpiTransmitPinsValidHook(peripheral: int, pins: SpiPins, select: Pin): bool =
    peripheral == 2 && pins == spiPins(37,35,36) && select == 3
trusted fun checkCommandOwner(): void { if (nativeAddressLoadU32(storage, 0) != 41) bad = true; return }
// This high-level fixture models completed/idle transfers, including failures.
// Active-controller cleanup is covered by spi-command-cleanup-s3-native.
@export("esp32s3SpiRead")
trusted fun esp32s3SpiReadHook(address: int): int {
    if (address != 0x60024000 && address != 0x60024030) bad=true
    if (nativeAddressLoadU32(storage,0) != 41) bad=true
    return 0
}
@export("esp32s3SpiWrite")
trusted fun esp32s3SpiWriteHook(address: int, value: int): void { bad = true; return }
@export("esp32s3SpiExchangeReady")
trusted fun esp32s3SpiExchangeReadyHook(peripheral: int): int { checkCommandOwner(); if (step != 0) bad = true; 1 }
@export("abla_pin_write")
trusted fun pinWriteHook(pin: int, high: bool): void {
    checkCommandOwner()
    if (Pin(pin) == 35 && !high && step == 0) step = 1
    else if (Pin(pin) == 3 && !high && step == 3) step = 4
    else if (Pin(pin) == 35 && high && step == 5) step = 6
    else if (Pin(pin) == 3 && high && (step == 3 || step == 4 || step == 5 || step == 6)) step = 7
    else bad = true
    return
}
@export("abla_pin_setOpenDrain")
trusted fun pinSetOpenDrainHook(pin: int, enabled: bool): void {
    checkCommandOwner(); if (Pin(pin) != 35 || enabled || step != 1) bad = true; step = 2; return
}
@export("abla_pin_output")
trusted fun pinOutputHook(pin: int): void { checkCommandOwner(); if (Pin(pin) != 35 || step != 2) bad = true; step = 3; return }
@export("abla_pin_input")
trusted fun pinInputHook(pin: int): void { checkCommandOwner(); if (Pin(pin) != 35 || step != 7) bad = true; step = 8; return }
@export("peripheralDelayMicroseconds")
trusted fun peripheralDelayMicrosecondsHook(us: int): void { bad = true; return }
@export("esp32s3SpiTransmitByteOwned")
trusted fun esp32s3SpiTransmitByteOwnedHook(peripheral: int, command: int, polls: int): int {
    checkCommandOwner(); if (step != 4 || command != 44 || polls != 100000) bad = true
    step = 5; calls = calls + 1
    if (failAt == 0) 263 else 257
}
@export("esp32s3SpiTransmitOwned")
trusted fun esp32s3SpiTransmitOwnedHook(peripheral: int, data: NativeBuffer, count: int, polls: int): int {
    checkCommandOwner()
    if (step != 6 || data.addressValue() != storage + 5 + offset ||
        count != (if (bytes - offset < 64) bytes - offset else 64) || polls != 100000) bad = true
    calls = calls + 1
    if (failAt == calls - 1) return 0x20109
    offset = offset + count
    257
}
trusted fun resetCommand(): void {
    nativeAddressStoreU32(storage, 0, 0); step = 0; calls = 0; offset = 0; bad = false; return
}
trusted fun runCommand(): SpiTransactionResult = esp32s3SpiCommand(peripheralGateAt(storage), u32(41),
    2, spiPins(37,35,36), Pin(3), Pin(35), 44, nativeBufferAt(storage + 5, 200), bytes, true)
trusted fun commandTest(): int {
    pinFail=0
    while (pinFail < 5) {
        failAt=-1;bytes=129;resetCommand()
        val result=runCommand()
        val expected=if (pinFail == 0) 11 else if (pinFail == 1) 12 else if (pinFail == 2) 269 else 266|(1<<(if (pinFail == 3) 24 else 25))
        if (result.status() != 6 || result.value() != u32(expected) || bad ||
            step != (if (pinFail == 3) 7 else 8) ||
            calls != (if (pinFail < 2) 0 else if (pinFail == 2) 1 else 4) ||
            nativeAddressLoadU32(storage,0) != 0x80000000) return 6
        pinFail=pinFail+1
    }
    pinFail=3;failAt=0;resetCommand()
    if (runCommand().value() != u32(263|(1<<24)) || bad || step != 7) return 7
    pinFail=4;resetCommand()
    if (runCommand().value() != u32(263|(1<<25)) || bad || step != 8) return 8
    pinFail=-1;failAt=-1
    bytes = 0
    while (bytes <= 129) {
        resetCommand()
        if (!runCommand().valid() || offset != bytes || calls != 1 + (bytes + 63) / 64 ||
            step != 8 || bad || nativeAddressLoadU32(storage, 0) != 0) return 1
        bytes = bytes + 1
    }
    bytes = 129; failAt = 0
    while (failAt < 4) {
        resetCommand()
        val result = runCommand()
        if (result.status() != 6 || calls != failAt + 1 || step != 8 || bad ||
            nativeAddressLoadU32(storage, 0) != 0x80000000) return 2
        if (runCommand().status() != 4 || calls != failAt + 1) return 3
        failAt = failAt + 1
    }
    failAt = -1; resetCommand()
    if (esp32s3SpiCommand(peripheralGateAt(storage), u32(41), 2, spiPins(37,35,36),
        Pin(3), Pin(35), 44, nativeBufferAt(storage + 5, 200), 1, false).status() != 3 || step != 0) return 4
    if (esp32s3SpiCommand(peripheralGateAt(storage), u32(41), 2, spiPins(37,35,36),
        Pin(3), Pin(35), 44, nativeBufferAt(storage, 200), 1, true).status() != 3 || step != 0) return 5
    0
}
#exportFunction("commandTest", "abla_spi_command_test")
