import "../src/esp32/rtc_ext1_record_s3_sequence.ab"
import "../src/esp32/rtc_wake_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/native"
import "abla/unsafe/mmio"
import "abla/build"
val memory=nativeStaticAllocate(256)
var holds=0
var clock=0
var selector=0
var level=0
var writes=0
var bad=false
trusted fun esp32S3RtcWakeRead(address: int): int {
    if (address >= 4096 && address < 4224) return mmioLoadU32(memory+address-4096)
    if (address >= 0x60008484 && address <= 0x600084D8) return mmioLoadU32(memory+128+address-0x60008484)
    if (address == 0x600080D8) return holds
    if (address == 0x60008904) return clock
    if (address == 0x600080E0) return selector
    if (address == 0x60008064) return level
    if (address == 0x60038018) return 0
    bad=true; 0
}
trusted fun esp32S3RtcWakeWrite(address: int,value: int): void {
    if (address >= 4096 && address < 4224) mmioStoreU32(memory+address-4096,value)
    else if (address >= 0x60008484 && address <= 0x600084D8) {
        if ((holds & (1<<((address-0x60008484)/4))) != 0) bad=true
        mmioStoreU32(memory+128+address-0x60008484,value)
    } else if (address == 0x600080D8) holds=value
    else if (address == 0x60008904) clock=value
    else if (address == 0x600080E0) selector=value & ~0x400000
    else if (address == 0x60008064) level=value
    else bad=true
    writes=writes+1; return
}
trusted fun esp32S3RtcWakeUpdate(address: int,mask: int,value: int): void {
    esp32S3RtcWakeWrite(address,(esp32S3RtcWakeRead(address) & ~mask) | (value & mask)); return
}
@export("abla_rtc_ext1_record_test")
trusted fun extRecordTest(): i32 {
    val record=nativeBufferAt(4096,128)
    var p=0
    while (p < 88) {
        val pins=1<<(p%22)
        val hold=(p/22)%2 != 0
        val polarity=p/44
        mmioStoreU32(memory,0)
        var n=0
        while (n < 22) { mmioStoreU32(memory+128+n*4,0xFFFFFFFF); n=n+1 }
        holds=0; clock=123; selector=0xA0000003; level=0x40000000; writes=0; bad=false
        if (!esp32S3Ext1RecordPrepareOwned(record,pins,polarity,hold) || bad) return i32(1)
        val count=writes
        selector=selector ^ 1
        if (esp32S3Ext1RecordRestoreOwned(record) || writes != count) return i32(2)
        selector=selector ^ 1
        if (!esp32S3Ext1RecordRestoreOwned(record) || bad || holds != 0 || clock != 123 || selector != 0xA0000003 || level != 0x40000000 || mmioLoadU32(memory) != 0) return i32(3)
        n=0
        while (n < 22) { if (mmioLoadU32(memory+128+n*4) != 0xFFFFFFFF) return i32(4); n=n+1 }
        writes=0; holds=pins
        if (esp32S3Ext1RecordPrepareOwned(record,pins,polarity,hold) || writes != 0) return i32(5)
        p=p+1
    }
    i32(0)
}
