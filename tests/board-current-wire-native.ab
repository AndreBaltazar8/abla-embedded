import "./pm1-control-wire-native.ab"
import "../src/m5stack/battery_current_owned.ab"
trusted fun peripheralDelayMilliseconds(milliseconds: int): void { bad=true;return }
@export("abla_board_current_wire_test")
trusted fun testBoardCurrent(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    if (!device.valid()) return i32(1)
    val handle=device|0;val registers=nativeBufferAt(chargeRegisters,256)
    val axp=M5AxpPower(handle|(3<<32)|(5<<40))
    val axpNew=M5AxpPower(handle|(74<<32)|(5<<40))
    val ina=Ina3221(handle|(10<<32));val tab=Ina226(handle|(1000000<<32))
    var kind=0
    while (kind < 5) {
        var sample=0
        while (sample < 8) {
            val raw=if (sample < 3) sample else if (sample == 3) 32767 else if (sample == 4) 32768 else if (sample == 5) 65534 else if (sample == 6) 65535 else 8191
            val signed=if (raw < 32768) raw else raw-65536
            if (kind == 0) {
                registers.store(122,0);registers.store(123,224)
                registers.store(124,(raw&8191)>>>5);registers.store(125,(raw&31)|224)
            } else if (kind == 1 || kind == 2) {
                val address=if (kind == 1) 1 else 4
                registers.store(address,raw>>>8);registers.store(address+1,raw)
            } else registers.storeU16(if (kind == 3) 20 else 50,raw)
            var fault=0
            val transactions=if (kind == 0) 6 else 3
            while (fault <= transactions) {
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                val result=if (kind == 0) axp.readBatteryMilliampsOwned(m5BoardStackCore2,ina,true)
                    else if (kind == 1) axpNew.readBatteryMilliampsOwned(m5BoardStackCore2,ina,true)
                    else if (kind == 2) tab.readBatteryMilliampsOwned(m5BoardTab5,true)
                    else if (kind == 3) Bq27220(handle).readBatteryMilliampsOwned(m5BoardArduinoNessoN1,true)
                    else PowerHubPower(handle).readBatteryMilliampsOwned(m5BoardPowerHub,true)
                val expected=if (kind == 0) -((raw&8191)/2) else if (kind == 1) signed*5/10 else if (kind == 3) signed else -signed
                if (result.valid() != (fault == 0) || (result.valid() && result.value() != expected) || ackCount-before != (if (fault == 0) transactions else fault) || bad) return i32(2)
                fault=fault+1
            }
            sample=sample+1
        }
        kind=kind+1
    }
    nackAt=0;val before=ackCount
    var board=0
    while (board < 256) {
        val id=M5BoardId(board)
        if (axp.readBatteryMilliampsOwned(id,ina,false).valid() || tab.readBatteryMilliampsOwned(id,false).valid() || Bq27220(handle).readBatteryMilliampsOwned(id,false).valid() || PowerHubPower(handle).readBatteryMilliampsOwned(id,false).valid()) return i32(3)
        if (id != m5BoardArduinoNessoN1 && Bq27220(handle).readBatteryMilliampsOwned(id,true).valid()) return i32(4)
        if (id != m5BoardPowerHub && PowerHubPower(handle).readBatteryMilliampsOwned(id,true).valid()) return i32(5)
        if (id != m5BoardTab5 && id != m5BoardTab5X && tab.readBatteryMilliampsOwned(id,true).valid()) return i32(6)
        if (id.powerKind() != m5PowerAxp192Or2101 && axp.readBatteryMilliampsOwned(id,ina,true).valid()) return i32(7)
        board=board+1
    }
    if (ackCount != before || bad) return i32(8)
    if (Ina226(handle).readBatteryMilliampsOwned(m5BoardTab5,true).valid() || Bq27220(0).readBatteryMilliampsOwned(m5BoardArduinoNessoN1,true).valid() || PowerHubPower(0).readBatteryMilliampsOwned(m5BoardPowerHub,true).valid() || ackCount != before) return i32(9)
    return i32(0)
}
