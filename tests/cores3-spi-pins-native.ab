import "../src/m5stack/cores3_spi.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin = int
var unavailable = -1
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 0 && this <= 48 && this != unavailable
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val expected = nativeStaticU32s([13, 17, 14, 18, 143, 144, 149, 146, 150])
var count = 0
var bad = false
trusted fun record(value: int): void {
    if (count >= 9 || nativeAddressLoadU32(gateStorage, 0) != 7) { bad = true; return }
    if (int(nativeAddressLoadU32(expected, count * 4)) != value) bad = true
    count = count + 1
    return
}
trusted fun Pin.write(high: bool): void = record(this * 4 + (if (high) 1 else 0))
trusted fun Pin.output(): void = record(this * 4 + 2)
trusted fun Pin.input(): void = record(this * 4 + 3)
fun Pin.read(): bool { bad = true; false }
fun peripheralDelayMicroseconds(duration: int): void { bad = true; return }
fun peripheralDelayMilliseconds(duration: int): void { bad = true; return }
@export("abla_cores3_spi_pins_native_test")
trusted fun cores3SpiPinsNativeTest(): i32 {
    val gate = peripheralGateAt(gateStorage)
    var variant = 0
    while (variant < 2) {
        count = 0
        val board = if (variant == 0) m5BoardStackCoreS3 else m5BoardStackCoreS3SE
        if (!board.configureCoreS3SpiPins(gate, u32(7)).valid() || count != 9 || bad || nativeAddressLoadU32(gateStorage, 0) != 0) return i32(1)
        variant = variant + 1
    }
    count = 0
    if (m5BoardStack.configureCoreS3SpiPins(gate, u32(7)).status() != 3 || count != 0) return i32(2)
    if (m5BoardStack.prepareCoreS3SdSpi(gate, u32(7)).status() != 3 || count != 0) return i32(3)
    unavailable = 0
    while (unavailable <= 48) {
        if (unavailable == 3 || unavailable == 4 || unavailable == 35 || unavailable == 36 || unavailable == 37) {
            if (m5BoardStackCoreS3.configureCoreS3SpiPins(gate, u32(7)).status() != 3 || count != 0) return i32(4)
        }
        unavailable = unavailable + 1
    }
    unavailable = -1
    if (gate.tryBegin(u32(9)) != 0) return i32(5)
    if (m5BoardStackCoreS3.configureCoreS3SpiPins(gate, u32(7)).status() != 2 || count != 0) return i32(6)
    if (!gate.finish(u32(9), false)) return i32(7)
    if (m5BoardStackCoreS3.configureCoreS3SpiPins(gate, u32(7)).status() != 4 || count != 0) return i32(8)
    i32(0)
}
