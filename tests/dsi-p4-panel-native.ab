import "../src/display/tab5_dsi_init_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var commands=0
var fail=0
var delays=0
var panel=1
var bad=false
fun p4DsiRead(offset: int): u32 = u32(0)
fun p4DsiWrite(offset: int,value: u32): void { return }
trusted fun dsiProgramWrite(channel: int,payload: NativeBuffer,length: int,polls: int): DsiCommandResult {
    commands=commands+1
    if (channel != 1 || polls != 3 || !payload.hasAddressRange(0,length)) bad=true
    DsiCommandResult(if (commands == fail) 53 else 49)
}
fun dsiPanelDelayMilliseconds(ms: int): void {
    if (panel == 1 && (ms != 120 || commands != 4)) bad=true
    if (panel == 2 && (ms != (if (delays == 0) 80 else 800) || commands != 28+delays)) bad=true
    if (panel == 3 && (ms != 120 || commands != 26)) bad=true
    delays=delays+1
    return
}
fun tab5DsiInitMadctl(channel: int,polls: int): DsiCommandResult { commands=commands+1; return DsiCommandResult(if (commands == fail) 21 else 17) }
fun tab5DsiInitColmod(channel: int,polls: int): DsiCommandResult { commands=commands+1; return DsiCommandResult(if (commands == fail) 21 else 17) }
@export("abla_dsi_p4_panel_test")
trusted fun testPanel(): i32 {
    val program0=tab5DsiInitProgram(1,0)
    if (!dsiProgramValid(program0) || program0.capacity() != 9) return i32(1)
    var hash0=u32(2166136261)
    var i0=0
    while (i0 < program0.capacity()) { hash0=(hash0^u32(program0.load(i0)))*u32(16777619); i0=i0+1 }
    if (hash0 != u32(94487534)) return i32(2)
    val program1=tab5DsiInitProgram(1,1)
    if (!dsiProgramValid(program1) || program1.capacity() != 8) return i32(1)
    var hash1=u32(2166136261)
    var i1=0
    while (i1 < program1.capacity()) { hash1=(hash1^u32(program1.load(i1)))*u32(16777619); i1=i1+1 }
    if (hash1 != u32(4143370957)) return i32(2)
    val program2=tab5DsiInitProgram(1,2)
    if (!dsiProgramValid(program2) || program2.capacity() != 387) return i32(1)
    var hash2=u32(2166136261)
    var i2=0
    while (i2 < program2.capacity()) { hash2=(hash2^u32(program2.load(i2)))*u32(16777619); i2=i2+1 }
    if (hash2 != u32(1636247016)) return i32(2)
    val program3=tab5DsiInitProgram(1,3)
    if (!dsiProgramValid(program3) || program3.capacity() != 199) return i32(1)
    var hash3=u32(2166136261)
    var i3=0
    while (i3 < program3.capacity()) { hash3=(hash3^u32(program3.load(i3)))*u32(16777619); i3=i3+1 }
    if (hash3 != u32(3271087713)) return i32(2)
    val program4=tab5DsiInitProgram(2,0)
    if (!dsiProgramValid(program4) || program4.capacity() != 484) return i32(1)
    var hash4=u32(2166136261)
    var i4=0
    while (i4 < program4.capacity()) { hash4=(hash4^u32(program4.load(i4)))*u32(16777619); i4=i4+1 }
    if (hash4 != u32(2079569970)) return i32(2)
    val program5=tab5DsiInitProgram(2,1)
    if (!dsiProgramValid(program5) || program5.capacity() != 3) return i32(1)
    var hash5=u32(2166136261)
    var i5=0
    while (i5 < program5.capacity()) { hash5=(hash5^u32(program5.load(i5)))*u32(16777619); i5=i5+1 }
    if (hash5 != u32(2448713061)) return i32(2)
    val program6=tab5DsiInitProgram(2,2)
    if (!dsiProgramValid(program6) || program6.capacity() != 3) return i32(1)
    var hash6=u32(2166136261)
    var i6=0
    while (i6 < program6.capacity()) { hash6=(hash6^u32(program6.load(i6)))*u32(16777619); i6=i6+1 }
    if (hash6 != u32(3255318701)) return i32(2)
    val program7=tab5DsiInitProgram(2,3)
    if (!dsiProgramValid(program7) || program7.capacity() != 4) return i32(1)
    var hash7=u32(2166136261)
    var i7=0
    while (i7 < program7.capacity()) { hash7=(hash7^u32(program7.load(i7)))*u32(16777619); i7=i7+1 }
    if (hash7 != u32(2091815120)) return i32(2)
    val program8=tab5DsiInitProgram(3,0)
    if (!dsiProgramValid(program8) || program8.capacity() != 474) return i32(1)
    var hash8=u32(2166136261)
    var i8=0
    while (i8 < program8.capacity()) { hash8=(hash8^u32(program8.load(i8)))*u32(16777619); i8=i8+1 }
    if (hash8 != u32(1368248344)) return i32(2)
    val program9=tab5DsiInitProgram(3,1)
    if (!dsiProgramValid(program9) || program9.capacity() != 8) return i32(1)
    var hash9=u32(2166136261)
    var i9=0
    while (i9 < program9.capacity()) { hash9=(hash9^u32(program9.load(i9)))*u32(16777619); i9=i9+1 }
    if (hash9 != u32(4177516264)) return i32(2)
    while (panel <= 3) {
        val count=if (panel == 1) 199 else if (panel == 2) 32 else 28
        fail=0; commands=0; delays=0
        if (!tab5DsiInitOwned(panel,1,3).hostComplete() || commands != count || delays != (if (panel == 2) 2 else 1) || bad) return i32(3)
        fail=1
        while (fail <= count) {
            commands=0; delays=0
            val result=tab5DsiInitOwned(panel,1,3)
            if (result.hostComplete() || !result.enqueued() || commands != fail || bad) return i32(4)
            fail=fail+1
        }
        panel=panel+1
    }
    commands=0; delays=0
    val malformed=nativeBufferAt(nativeStaticBytes("\x01\x11"),2)
    if (dsiRunProgramOwned(1,malformed,3).status() != 2 || tab5DsiInitOwned(0,1,3).status() != 2 || commands != 0 || delays != 0) return i32(5)
    i32(0)
}
