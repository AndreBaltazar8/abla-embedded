import "../src/esp32/dsi_read_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_read_target")
trusted fun target(channel: int,command: int,destination: NativeBuffer,length: int,polls: int): DsiCommandResult =
    esp32P4DsiDcsRead(channel,command,destination,length,polls)
