import "../src/esp32/cache_autoload_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(704)
var writes=0
var drop=0
var stalled=-1
fun p4CacheAutoloadRead(offset: int): int = nativeBufferAt(memory,704).loadU32(offset)
fun p4CacheAutoloadWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes != drop) nativeBufferAt(memory,704).storeU32(offset,if (offset == stalled) value&4294967293 else value|2)
    return
}
fun p4CacheAutoloadFence(): void { return }
fun resetAutoload(mask: int): void {
    writes=0; drop=0; stalled=-1
    var index=0
    while (index < 4) {
        nativeBufferAt(memory,704).storeU32(p4CacheAutoloadOffset(index),0xa5000002|(if ((mask&(p4CacheAutoloadFlag(index)>>>8)) != 0) 1 else 0))
        index=index+1
    }
    return
}
fun originalAutoload(mask: int): bool {
    var index=0
    while (index < 4) {
        if (p4CacheAutoloadRead(p4CacheAutoloadOffset(index)) != (0xa5000002|(if ((mask&(p4CacheAutoloadFlag(index)>>>8)) != 0) 1 else 0))) return false
        index=index+1
    }
    return true
}
@export("abla_p4_cache_autoload_test")
fun autoloadTest(): i32 {
    var mask=0
    while (mask < 16) {
        resetAutoload(mask)
        val owner=p4CacheAutoloadSuspendOwned(2)
        if (owner.status() != 1 || !owner.valid() || ((owner>>>8)&15) != mask || !originalAutoload(0)) return i32(1)
        val restored=owner.restoreOwned(2)
        if (restored.status() != 0 || !originalAutoload(mask)) return i32(2)
        val count=writes
        if (restored.restoreOwned(2).status() != 0 || writes != count) return i32(3)
        mask=mask+1
    }
    var failure=1
    while (failure <= 4) {
        resetAutoload(15); drop=failure
        var owner=p4CacheAutoloadSuspendOwned(2)
        if (owner.status() != 3 || ((owner>>>8)&15) != 15) return i32(4)
        drop=0; owner=owner.suspendOwned(2)
        if (owner.status() != 1 || !originalAutoload(0)) return i32(5)
        writes=0; drop=failure
        owner=owner.restoreOwned(2)
        if (owner.status() != 5) return i32(6)
        drop=0; owner=owner.restoreOwned(2)
        if (owner.status() != 0 || !originalAutoload(15)) return i32(7)
        failure=failure+1
    }
    resetAutoload(15); stalled=308
    var owner=p4CacheAutoloadSuspendOwned(2)
    if (owner.status() != 4 || ((owner>>>8)&15) != 15) return i32(8)
    val count=writes
    if (owner.restoreOwned(2).status() != 4 || writes != count) return i32(9)
    stalled=-1; nativeBufferAt(memory,704).storeU32(308,0xa5000002)
    owner=owner.restoreOwned(2)
    if (owner.status() != 0 || !originalAutoload(15)) return i32(10)
    resetAutoload(0)
    if (p4CacheAutoloadSuspendOwned(0).status() != 2 || writes != 0) return i32(11)
    owner=p4CacheAutoloadSuspendOwned(2)
    nativeBufferAt(memory,704).storeU32(228,3)
    if (owner.suspendOwned(2).status() != 3 || writes != 0) return i32(12)
    return i32(0)
}
