import "./nesso-display-power-wire-native.ab"
import "../src/m5stack/nesso_display_owner_sequence.ab"
// Real provider, device allocation, PI4 driver and retained owner. Only the
// external I2C slave, MMIO and ROM delay are modeled by the imported fixture.
fun nessoDisplayOwnerBusCurrent(bus: int): bool = nessoPowerBusCurrent(bus)
fun nessoDisplayOwnerPrepare(handle: int): int = Pi4Ioe5v6408(handle).prepareNessoDisplayOwned(true)
fun nessoDisplayOwnerBacklight(handle: int,brightness: int): bool = Pi4Ioe5v6408(handle).setNessoBacklightOwned(brightness,true)
@export("abla_nesso_display_owner_wire_test")
trusted fun testDisplayOwnerWire(): i32 {
    wireSeed();chargeAddress=68;afterCommit=false;bad=false;dropClose=false;ticks=0
    val gpioRegs=nativeBufferAt(gpioMemory,4096);var at=0
    while (at < 4096) { gpioRegs.storeU32(at,0);at=at+4 }
    apb=u32(0);functional=u32(0x300000);gpioClock=u32(0)
    var session=esp32C6I2cSessionOpenOwned(10,8,40000000,20000000,true,5,8)
    if (!session.ready()) return i32(1)
    val bus=session.bus()|0;val regs=nativeBufferAt(chargeRegisters,256)
    var commit=0
    while (commit < 2) {
        afterCommit=commit == 1
        var startupFault=0
        while (startupFault <= 21) {
            var closeFault=0
            while (closeFault <= 6) {
                at=0;while (at < 256) { regs.store(at,90);at=at+1 }
                val before=ackCount
                nackAt=if (startupFault == 0) 0 else before+startupFault
                var owner=nessoDisplayPowerOpenOwned(bus,true)
                val expectedStatus=if (startupFault == 0) 1 else if (startupFault <= 3) 3 else 4
                if (owner.status() != expectedStatus || owner.ready() != (startupFault == 0) ||
                    ackCount-before != (if (startupFault == 0) 21 else startupFault) || bad) return i32(2)
                val retained=startupFault == 0 || startupFault > 3
                if (owner.ownsDevice() != retained) return i32(3)
                if (retained && owner.setupWrites() != (if (startupFault == 0) 6 else (startupFault-4)/3)) return i32(4)
                val rejected=ackCount
                if (owner.closeOwned(false) != owner || owner.setBacklightOwned(1,false) ||
                    owner.setBacklightOwned(-1,true) || owner.setBacklightOwned(256,true) || ackCount != rejected) return i32(5)
                nackAt=0
                if (owner.setBacklightOwned(1,true) != (startupFault == 0)) return i32(6)
                if (startupFault == 0 && regs.load(5) != 194) return i32(7)
                val beforeClose=ackCount;val output=regs.load(5)
                nackAt=if (closeFault == 0) 0 else beforeClose+closeFault
                owner=owner.closeOwned(true)
                if (retained) {
                    if (ackCount-beforeClose != (if (closeFault == 0) 6 else closeFault)) return i32(8)
                    if (closeFault != 0) {
                        if (owner.status() != 5 || !owner.ownsDevice() || owner.ready()) return i32(9)
                        val changed=commit == 1 && closeFault == 6
                        if (regs.load(5) != (if (changed) output&191 else output)) return i32(10)
                        val retry=ackCount;nackAt=0;owner=owner.closeOwned(true)
                        if (ackCount-retry != 6) return i32(11)
                    }
                    if (regs.load(5) != (output&191)) return i32(12)
                } else if (ackCount != beforeClose) return i32(13)
                if (owner != 0 || bad) return i32(14)
                val closed=ackCount
                if (owner.closeOwned(true) != 0 || owner.setBacklightOwned(1,true) || ackCount != closed) return i32(15)
                closeFault=closeFault+1
            }
            startupFault=startupFault+1
        }
        commit=commit+1
    }
    // A readable but absent identity is a failure, never a setup bypass.
    nackAt=0;regs.store(1,0);val before=ackCount
    val absent=nessoDisplayPowerOpenOwned(bus,true)
    if (absent.status() != 3 || absent.ownsDevice() || ackCount-before != 3) return i32(16)
    val rejected=ackCount
    if (nessoDisplayPowerOpenOwned(bus,false).status() != 2 || ackCount != rejected) return i32(17)
    session=session.closeOwned(true)
    if (session != 0 || nessoDisplayPowerOpenOwned(bus,true).status() != 2 || ackCount != rejected || bad) return i32(18)
    return i32(0)
}
