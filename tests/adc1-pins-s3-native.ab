import "../src/esp32/adc1_pins_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var pin=1
var digital=0xffffffff
var rtc=0xffffffff
var route=0xfab
var mux=0xffff
var pad=0xb82fe000
var hold=0
var force=0
var digForce=0
var writes=0
var reads=0
var drop=0
var bad=false
fun esp32S3AdcPadRead(address: int): int {
    reads=reads+1
    if (address == 0x600080d8) return hold
    if (address == 0x60008088) return force
    if (address == 0x60008094) return digForce
    if (address == 0x60004020) return digital
    if (address == 0x6000840c) return rtc
    if (address == 0x60004554+pin*4) return route
    if (address == 0x60009004+pin*4) return mux
    if (address == 0x60008484+pin*4) return pad
    bad=true; return 0
}
fun esp32S3AdcPadWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x60004028) { if (value != (1<<pin)) bad=true; digital=digital&(4294967295^value); return }
    if (address == 0x60008414) { if (value != (1<<(pin+10))) bad=true; rtc=rtc&(4294967295^value); return }
    if (address == 0x60004554+pin*4) { route=value; return }
    if (address == 0x60009004+pin*4) { mux=value; return }
    if (address == 0x60008484+pin*4) { pad=value; return }
    bad=true; return
}
fun reset(): void {
    digital=0xffffffff; rtc=0xffffffff; route=0xfab; mux=0xffff; pad=0xb82fe000
    hold=0; force=0; digForce=0; writes=0; reads=0; drop=0; return
}
@export("abla_adc1_pins_s3_test")
fun test(): i32 {
    while (pin <= 10) {
        reset()
        if (esp32S3Adc1Pin(pin-1) != pin || esp32S3Adc1PadConfigureOwned(pin-1) != 1 || writes != 5 || bad) return i32(1)
        if (digital != (4294967295^(1<<pin)) || rtc != (4294967295^(1<<(pin+10))) || route != 0x7ab || mux != 0x9c7d || pad != 0xa020c000) return i32(2)
        var stage=1
        while (stage <= 5) {
            reset(); drop=stage
            if (esp32S3Adc1PadConfigureOwned(pin-1) != ((stage<<8)|5) || writes != stage) return i32(3)
            drop=0
            if (esp32S3Adc1PadConfigureOwned(pin-1) != 1 || bad) return i32(4)
            stage=stage+1
        }
        reset(); hold=1<<pin
        if (esp32S3Adc1PadConfigureOwned(pin-1) != 3 || writes != 0) return i32(5)
        reset(); force=0x200000
        if (esp32S3Adc1PadConfigureOwned(pin-1) != 3 || writes != 0) return i32(6)
        reset(); digForce=0x8000
        if (esp32S3Adc1PadConfigureOwned(pin-1) != 3 || writes != 0) return i32(7)
        reset(); pad=pad|0x100000
        if (esp32S3Adc1PadConfigureOwned(pin-1) != 4 || writes != 0) return i32(8)
        pin=pin+1
    }
    reset()
    if (esp32S3Adc1PadConfigureOwned(-1) != 2 || esp32S3Adc1PadConfigureOwned(10) != 2 || writes != 0 || reads != 0 || bad) return i32(9)
    return i32(0)
}
