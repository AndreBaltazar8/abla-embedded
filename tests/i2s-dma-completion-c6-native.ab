import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/dma_completion_c6_sequence.ab"
import "../src/esp32/i2s/captured_buffer_c6_sequence.ab"
var count=1
var available=0
var channel=0
var tx=false
var reads=0
var error=false
var bad=false
var viewMode=false
var viewFault=0
trusted fun c6I2sClockRead(at: int): u32 {
    if (!viewMode) { bad=true;return u32(0) }
    return if (viewFault == 1) u32(0) else if (at == 0) u32(1) else u32(0x400000)
}
trusted fun c6I2sClockWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6I2sRead(at: int): u32 {
    if (!viewMode) { bad=true;return u32(0) }
    return if (at == 0x6c) u32(1) else if (at == 0x20 && viewFault == 2) u32(4) else u32(0)
}
trusted fun c6I2sWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6GdmaBusRead(): u32 = u32(1)
trusted fun c6GdmaBusWrite(v: u32): void { bad=true;return }
trusted fun c6GdmaRead(at: int): u32 {
    if (at == 0x64) return u32(8)
    if (viewMode && at == 0x80+channel*192) return if (viewFault == 3) u32(0) else u32(0x1000000)
    if (viewMode && at == 0x78+channel*192) return if (viewFault == 4) u32(0) else u32(2)
    if (at == channel*16+(if (tx) 48 else 0)) return u32(if (error) (if (tx) 32 else 64) else 2)
    return u32(0)
}
trusted fun c6GdmaWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6GdmaDescriptorFence(): void { return }
trusted fun c6GdmaDescriptorWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6GdmaDescriptorRead(at: int): u32 {
    reads=reads+1
    val offset=at-0x40800000;val index=offset/12;val word=offset%12
    if (offset < 0 || index >= count || (at&3) != 0) { bad=true;return u32(0) }
    if (word == 0) return u32(64)|u32((if (tx) 64 else index)<<12)|u32(0x40000000)|(if (index < available) u32(0) else u32(0x80000000))
    if (word == 4) return u32(0x40810000+index*64)
    return u32(if (index+1 < count) at+4 else 0)
}
trusted fun initialize(r: NativeBuffer,q: NativeBuffer): void {
    var at=0
    while (at < 72) { r.storeU32(at,0);at=at+4 }
    at=0
    while (at < 28) { q.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x43364944);r.storeU32(4,1);r.storeU32(12,channel);r.storeU32(16,if (tx) 1 else 0);r.storeU32(20,0x40800000);r.storeU32(24,count);r.storeU32(28,0x40810000);r.storeU32(32,64);r.storeU32(36,64)
    reads=0;available=0;error=false;bad=false;return
}
@export("abla_i2s_dma_completion_c6_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(100)
    val r=nativeBufferAt(storage,72);val q=nativeBufferAt(storage+72,28)
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 0;count=1
            while (count <= 32) {
                initialize(r,q)
                if (c6I2sDmaCompletionPollOwned(r,q,1,true) != 5 || q.loadU32(12) != 0) return i32(1)
                while (available < count) {
                    available=available+1
                    if (c6I2sDmaCompletionPollOwned(r,q,1,true) != (if (available == count) 1 else 5) || q.loadU32(12) != available) return i32(2)
                    if (q.loadU32(16) != (if (tx) available*64 else available*(available-1)/2)) return i32(3)
                }
                val before=reads
                if (c6I2sDmaCompletionPollOwned(r,q,1024,true) != 1 || reads != before || q.loadU32(20) != 2 || bad) return i32(4)
                if (!tx) {
                    if (c6I2sCapturedBufferOwned(r,q,0,true).addressValue() != 0) return i32(7)
                    r.storeU32(4,7);viewMode=true;viewFault=0
                    var index=0
                    while (index < count) {
                        val view=c6I2sCapturedBufferOwned(r,q,index,true)
                        if (view.addressValue() != 0x40810000+index*64 || view.capacity() != index || bad) return i32(8)
                        index=index+1
                    }
                    viewFault=1
                    while (viewFault <= 4) {
                        if (c6I2sCapturedBufferOwned(r,q,0,true).addressValue() != 0) return i32(9)
                        viewFault=viewFault+1
                    }
                    viewFault=0;error=true
                    if (c6I2sCapturedBufferOwned(r,q,0,true).addressValue() != 0) return i32(10)
                    error=false;available=0
                    if (c6I2sCapturedBufferOwned(r,q,0,true).addressValue() != 0 || c6I2sCapturedBufferOwned(r,q,count,true).addressValue() != 0 ||
                        c6I2sCapturedBufferOwned(r,q,-1,true).addressValue() != 0 || c6I2sCapturedBufferOwned(r,q,0,false).addressValue() != 0) return i32(11)
                    viewMode=false
                }
                initialize(r,q);available=count;error=true
                if (c6I2sDmaCompletionPollOwned(r,q,1024,true) != 3 || reads != 0 || q.loadU32(20) != (if (tx) 32 else 64)) return i32(5)
                error=false
                if (c6I2sDmaCompletionPollOwned(r,q,1024,true) != 3 || reads != 0) return i32(6)
                count=count+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    return i32(0)
}
