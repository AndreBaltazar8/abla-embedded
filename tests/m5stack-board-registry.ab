import "../src/m5stack/board_id.ab"
import "../src/m5stack/i2c_pin_map.ab"

fun main: int {
    val atom = m5BoardAtomEcho().i2cPins()
    val coreS3 = m5BoardStackCoreS3.i2cPins()
    val tab5 = m5BoardTab5.i2cPins()
    val absent = m5BoardStampC5.i2cPins()
    val ids = m5BoardAtomEcho() == m5BoardAtomVoice &&
        m5BoardAtomEchoS3R() == m5BoardAtomVoiceS3R &&
        m5BoardTab5X.isBuiltInDisplay() && m5BoardStampP4X.isNonDisplay() &&
        m5BoardUnitPoEP4HDMI.isExternalDisplay()
    val pins = atom.internalClock() == 21 && atom.internalData() == 25 &&
        atom.externalClock() == 32 && atom.externalData() == 26 &&
        coreS3.internalClock() == 11 && coreS3.externalData() == 2 &&
        tab5.internalClock() == 32 && tab5.externalData() == 53 &&
        !absent.hasInternal() && !absent.hasExternal()
    if (ids && pins) 46 else 1
}
