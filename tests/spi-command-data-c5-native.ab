import "../src/esp32/spi/command_data_c5_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
var sda=0
var scl=1
var writes=0
var drop=0
var fault=0
var bad=false
fun offset(address: int): int = if (address >= 0x60090000 && address < 0x60090078) address-0x60090000 else
    if (address >= 0x60091000 && address < 0x60091b4c) 256+address-0x60091000 else -1
fun c5GpioRead(address: int): u32 {
    if (address == 0x600960f0) return if (fault == 1) u32(3) else u32(1)
    if (address == 0x600960f4) return if (fault == 2) u32(0) else u32(0x400000)
    if (address == 0x60091df8) return u32(1)
    if (address == 0x600b102c) return if (fault == 4) u32(1)<<u32(scl) else u32(0)
    if (address == 0x600b1028) return if (fault == 5) u32(127) else u32(0)
    if (address == 0x6000f018) return if (fault == 6) u32(16384) else u32(0)
    if (address == 0x60091064) return if (fault == 7) u32(0) else u32(0xffffffff)
    val at=offset(address)
    if (at < 0 || (at&3) != 0) { bad=true;return u32(0) }
    return u32(nativeBufferAt(memory,4096).loadU32(at))
}
fun c5GpioWrite(address: int,value: u32): void {
    if (active && (address == 0x60091008 || address == 0x6009100c)) bad=true
    writes=writes+1
    if ((address == 0x60091008 || address == 0x6009100c) && value == u32(1<<26)) {
        dcWrites=dcWrites+1
        if (dcWrites == dcDrop) return
    }
    var at=offset(address);var wanted=value
    if (address == 0x60091008 || address == 0x60091038) { at=at-4;wanted=u32(nativeAddressLoadU32(memory,at))|value }
    else if (address == 0x6009100c || address == 0x6009103c) { at=at-8;wanted=u32(nativeAddressLoadU32(memory,at))&(u32(0xffffffff)^value) }
    if (at < 0 || at >= 4096 || (at&3) != 0) { bad=true;return }
    if (writes != drop) nativeAddressStoreU32(memory,at,int(wanted))
    return
}
fun softwareI2cDrive(pin: int,released: bool): void { esp32C5GpioWriteOwned(pin,released);return }
fun softwareI2cSample(pin: int): bool = esp32C5GpioReadOwned(pin) == 1
fun softwareI2cDelay(us: int): void { if (us != 1 && us != 5) bad=true;return }
fun seed(): void {
    var at=0
    while (at < 4096) { nativeAddressStoreU32(memory,at,0);at=at+4 }
    writes=0;drop=0;fault=0;bad=false;return
}



val spi=nativeStaticAllocate(256)
var bus=u32(4)
var functional=u32(0x100000)
var spiWrites=0
var spiDrop=0
var pending=0
var stall=false
var active=false
fun c5SpiRead(address: int): u32 {
    if (address == 0x600960c4) return bus
    if (address == 0x600960c8) return functional
    if (address == 0x60081000) {
        if (active) return u32(1<<24)
        if (pending > 0) { if (!stall) pending=pending-1;return u32(1<<23) }
        return u32(0)
    }
    return u32(nativeAddressLoadU32(spi,address-0x60081000))
}
fun c5SpiWrite(address: int,value: u32): void {
    spiWrites=spiWrites+1
    if (spiWrites == spiDrop) return
    if (address == 0x600960c4) { bus=value;return }
    if (address == 0x600960c8) { functional=value;return }
    if (address == 0x60081000) {
        if (value == u32(1<<23)) { pending=1;return }
        if (value != u32(1<<24)) { bad=true;return }
        starts=starts+1
        val isData=(c5GpioRead(0x60091004)&u32(1<<26)) != u32(0)
        val length=nativeAddressLoadU32(spi,28)/8+1
        if (starts == 1) {
            if (isData || length != 1 || nativeAddressLoadU32(spi,152) != wantedCommand) bad=true
        } else {
            if (!isData) bad=true
            var byte=0
            while (byte < length) {
                val word=nativeAddressLoadU32(spi,152+(byte/4)*4)
                if (((word>>>((byte%4)*8))&255) != ((observed+byte)*17&255)) bad=true
                byte=byte+1
            }
            observed=observed+length
        }
        if ((c5GpioRead(0x60091004)&u32(1<<25)) != u32(0)) bad=true
        if (timeout || starts == timeoutAt) { active=true;return }
        var at=0
        while (at < 64) { nativeAddressStoreU32(spi,152+at,nativeAddressLoadU32(spi,152+at)^0xffffffff);at=at+4 }
        nativeAddressStoreU32(spi,60,4096);return
    }
    if (address == 0x60081038) { nativeAddressStoreU32(spi,60,nativeAddressLoadU32(spi,60)&~int(value));return }
    nativeAddressStoreU32(spi,address-0x60081000,int(value));return
}
fun initialize(): void {
    seed()
    var at=0
    while (at < 256) { nativeAddressStoreU32(spi,at,0);at=at+4 }
    bus=u32(4);functional=u32(0x100000);spiWrites=0;spiDrop=0;pending=0;stall=false;active=false;return
}
fun openMaster(mode: int): Esp32C5SpiMaster =
    esp32C5SpiMasterOpenOwned(spiPins(7,8,9),25,160000000,2,1,8,mode,4,true)

val buffers=nativeStaticAllocate(131080)
val gateStorage=nativeStaticAllocate(4)
var timeout=false
var starts=0

var timeoutAt=0

var dcWrites=0
var dcDrop=0
var wantedCommand=0
var observed=0
@export("abla_spi_command_data_c5_test")
trusted fun testCommand(): int {
    val gate=peripheralGateAt(gateStorage)
    var variant=0
    while (variant < 8) {
        val length=if (variant == 0) 0 else if (variant == 1) 1 else if (variant == 2) 63 else if (variant == 3) 64 else if (variant == 4) 65 else if (variant == 5) 129 else if (variant == 6) 513 else 65535
        initialize();timeout=false;timeoutAt=0;starts=0;observed=0;dcDrop=0
        nativeAddressStoreU32(gateStorage,0,0)
        val master=openMaster(0)
        if (!master.ready() || esp32C5GpioConfigureOwned(26,true,true,false,false,0,true) != 1) return 1
        val data=nativeBufferAt(buffers,length)
        var at=0;while (at < length) { data.store(at,at*17&255);at=at+1 }
        wantedCommand=if (variant == 0) 17 else 44;dcWrites=0
        val result=master.commandData(gate,u32(7),26,wantedCommand,data,length,4)
        if (!result.valid() || result.completedBytes() != length || result.detail() != (257|(1<<25)) ||
            starts != 1+(length+63)/64 || observed != length || bad ||
            (c5GpioRead(0x60091004)&u32(1<<25)) == u32(0)) return 2
        val before=writes;val sent=starts
        if (master.commandData(gate,u32(7),25,44,data,length,4).status() != 3 ||
            master.commandData(gate,u32(7),7,44,data,length,4).status() != 3 ||
            master.commandData(gate,u32(7),26,256,data,length,4).status() != 3 ||
            master.commandData(gate,u32(7),26,44,nativeBufferAt(gateStorage,1),1,4).status() != 3 ||
            master.commandData(gate,u32(7),26,44,data,length,0).status() != 3 ||
            writes != before || starts != sent) return 9
        if (gate.tryBegin(u32(8)) != 0 ||
            master.commandData(gate,u32(7),26,44,data,length,4).status() != 2 ||
            writes != before || starts != sent || !gate.finish(u32(8),true)) return 10
        if (master.closeOwned(true) != 0) return 3
        variant=variant+1
    }
    var failure=1
    while (failure <= 6) {
        initialize();timeout=false;timeoutAt=if (failure <= 4) failure else 0
        starts=0;observed=0;dcDrop=0;nativeAddressStoreU32(gateStorage,0,0)
        val master=openMaster(0)
        if (!master.ready() || esp32C5GpioConfigureOwned(26,true,true,false,false,0,true) != 1) return 4
        val data=nativeBufferAt(buffers,129)
        var at=0;while (at < 129) { data.store(at,at*17&255);at=at+1 }
        wantedCommand=44;dcWrites=0;dcDrop=if (failure >= 5) failure-4 else 0
        val result=master.commandData(gate,u32(7),26,44,data,129,4)
        val completed=if (failure <= 2 || failure >= 5) 0 else (failure-2)*64
        if (result.status() != 6 || result.completedBytes() != completed || bad ||
            (result.detail()&255) != (if (failure <= 4) 7 else 14)) return 5
        val before=starts;val gp=writes
        if (master.commandData(gate,u32(8),26,44,data,129,4).status() != 4 || starts != before || writes != gp) return 6
        if (failure <= 4 && master.recover(gate,u32(8),true)) return 7
        active=false;timeoutAt=0;dcDrop=0
        if (!master.recover(gate,u32(8),true) || master.closeOwned(true) != 0 || bad) return 8
        failure=failure+1
    }
    return 0
}
