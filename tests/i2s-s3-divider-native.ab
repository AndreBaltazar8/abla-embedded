import "../src/esp32/i2s/clock_divider_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var writes = 0
var config = 0
var expectedWord = 0
var bad = false
trusted fun esp32s3I2sClockField(address: int, mask: int, value: int): void {
    val step = writes
    writes = writes + 1
    var expectedMask = 255
    var expectedValue = 2
    var expectedAddress = config + 8
    if (step == 0 || step == 9) expectedAddress = config
    if (step == 9) expectedValue = 39
    if (step == 1 || step == 5) { expectedMask = 1 << 27; expectedValue = 0 }
    if (step == 2 || step == 7) { expectedMask = 511 << 9; expectedValue = 1 << 9 }
    if (step == 3 || step == 6) { expectedMask = 511; expectedValue = 0 }
    if (step == 4 || step == 8) { expectedMask = 511 << 18; expectedValue = 0 }
    if (step >= 5 && step <= 8) expectedValue = expectedWord & expectedMask
    if (step > 9 || address != expectedAddress || mask != expectedMask || value != expectedValue) bad = true
    return
}
trusted fun i2sDividerTest(): int {
    var denominator = 1
    while (denominator <= 511) {
        var numerator = 0
        while (numerator < denominator) {
            val word = esp32s3I2sFractionWord(numerator, denominator)
            val z = word & 511
            val y = (word >>> 9) & 511
            val x = (word >>> 18) & 511
            if (numerator == 0) { if (word != 0) return 1 }
            else {
                val reconstructed = (x + 1) * z + y
                val b = if ((word & (1 << 27)) != 0) reconstructed - z else z
                if (reconstructed != denominator || b != numerator || y >= z) return 2
            }
            numerator = numerator + 1
        }
        denominator = denominator + 1
    }
    var route = 0
    while (route < 4) {
        config = 0x6000f000 + (route / 2) * 0x1e000 + (if ((route & 1) != 0) 52 else 48)
        var numerator = 0
        while (numerator < 16) {
            expectedWord = esp32s3I2sFractionWord(numerator, 16)
            writes = 0
            if (!esp32s3I2sSetDivider(route / 2, (route & 1) != 0, 39, numerator, 16) || bad || writes != 10) return 3
            numerator = numerator + 1
        }
        route = route + 1
    }
    writes = 0
    if (esp32s3I2sSetDivider(-1, false, 39, 1, 16) || esp32s3I2sSetDivider(2, true, 39, 1, 16) || esp32s3I2sSetDivider(0, true, 256, 1, 16) || esp32s3I2sSetDivider(0, false, 1, 0, 1) || esp32s3I2sSetDivider(0, true, 39, 16, 16) || writes != 0) return 4
    if (esp32s3I2sFractionWord(-1, 16) != -1 || esp32s3I2sFractionWord(0, 0) != -1 || esp32s3I2sFractionWord(1, 512) != -1) return 5
    0
}
#exportFunction("i2sDividerTest", "abla_i2s_divider_test")
