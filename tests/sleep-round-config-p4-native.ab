import "../src/esp32/power/sleep_round_config_p4.ab"
import "../src/esp32/power/sleep_profile_defaults_p4.ab"
import "abla/build"
val roundConfigMemory=nativeStaticAllocate(336)
fun configBuild(out: NativeBuffer,p: NativeBuffer,t: NativeBuffer,flags: int): bool =
    esp32p4SleepRoundConfigEncode(out,p,t,400,400,flags,u32(5),u32(1),1,true,u32(4096),true,32,2,0x4ff01000)
@export("abla_sleep_round_config_p4_test")
fun configTest(): int {
    val out=nativeBufferAt(roundConfigMemory,196);val p=nativeBufferAt(roundConfigMemory+196,108);val t=nativeBufferAt(roundConfigMemory+304,32)
    var offset=0
    while (offset < 32) { t.storeU32(offset,1);offset=offset+4 }
    t.storeU32(0,0x4ff02000);t.storeU32(4,0);t.storeU32(8,0)
    if (!esp32p4SleepProfileDefaults(p,u32(0),300,false,true,12,15,15,16000000,65536)) return 1
    var flags=0
    while (flags < 8) {
        out.storeU32(192,0x1234abcd)
        if (!configBuild(out,p,t,flags) || !p4RoundConfigValid(out) || out.loadU32(12) != flags || out.loadU32(192) != 0x1234abcd) return 2
        offset=0
        while (offset < 108) { if (out.loadU32(52+offset) != p.loadU32(offset)) return 3;offset=offset+4 }
        offset=0
        while (offset < 32) { if (out.loadU32(160+offset) != t.loadU32(offset)) return 4;offset=offset+4 }
        flags=flags+1
    }
    offset=0
    while (offset < 192) { out.storeU32(offset,0xa5a5a5a5);offset=offset+4 }
    if (configBuild(out,p,t,8) || configBuild(out,p,t,-1) || configBuild(nativeBufferAt(roundConfigMemory+8,192),p,t,3)) return 5
    p.storeU32(104,64)
    if (configBuild(out,p,t,3)) return 6
    p.storeU32(104,0);t.storeU32(12,0)
    if (configBuild(out,p,t,3)) return 7
    offset=0
    while (offset < 192) { if (out.loadU32(offset) != 0xa5a5a5a5) return 8;offset=offset+4 }
    if (p4RoundConfigValid(nativeBufferAt(roundConfigMemory,4))) return 9
    return 0
}
