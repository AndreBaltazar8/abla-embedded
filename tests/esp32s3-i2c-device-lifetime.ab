import "../src/esp32/i2c_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
fun I2cDevice.testBits(): int = this
fun I2cBus.testBits(): int = this

// Target software ownership fixture. No controller setup or transfer:
// publish a synthetic open epoch in RAM, then exercise real device methods.
// Compile-only until an S3 runner is available; run once from fresh RAM.
@export("abla_s3_i2c_device_lifetime_test")
trusted fun deviceLifetimeTest(): int {
    val state = esp32S3I2cState(0)
    nativeAddressStoreU32(state, 4, 1)
    nativeAddressStoreU32(state, 8, 1)
    nativeAddressStoreU32(state, 20, 40000000)
    val bus = I2cBus(esp32S3I2cBusKey(0, 1))
    val first = bus.device(52)
    if (!first.valid() || (first.testBits() >>> 32) != 0) return 1
    val pool = esp32S3I2cDevicePool()
    val original = pool.resolve(first.testBits())
    if (!esp32S3I2cDeviceKeyMatchesBus(original, bus.testBits())) return 2
    if (!first.close() || first.close() || pool.resolve(first.testBits()) != 0) return 3
    val second = bus.device(52)
    if (!second.valid() || second.testBits() == first.testBits()) return 4
    val gate = peripheralGateAt(state)
    if (gate.tryBegin(u32(7)) != 0) return 5
    if (second.close() || bus.device(53).valid()) return 6
    if (!gate.finish(u32(7), false)) return 7
    if (!second.close()) return 8
    if (gate.tryBegin(u32(7)) != 2) return 9
    if (!gate.tryBeginRecovery(u32(7)) || !gate.finishRecovery(u32(7), true)) return 10
    var count = 0
    while (count < 16) {
        if (!bus.device(count).valid()) return 11
        count = count + 1
    }
    if (bus.device(17).valid()) return 12
    val mask = (2147483647 << 29) | 2
    if (pool.releaseMatching(mask, 1 << 29) != 16) return 13
    if (!bus.device(17).valid()) return 14
    0
}
