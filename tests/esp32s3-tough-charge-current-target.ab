import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/toughc5_charge_current.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_tough_charge_current_target")
trusted fun currentTarget(board: M5BoardId,ioe: M5Ioe1,maxMilliamps: int): M5ChargeCurrentResult =
    board.setToughChargeCurrent(ioe,maxMilliamps)
