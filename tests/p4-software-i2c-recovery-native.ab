import "../src/esp32/i2c/software_bus_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var data=true
var clock=true
var held=true
var stretch=0
var releaseAfter=0
var pulses=0
var writes=0
var pads=0
var bad=false
fun p4SoftwareI2cOutputEnabled(number: int): bool = false
fun p4SoftwareI2cConfigurePad(number: int,enable: bool): bool { pads=pads+1;return true }
fun softwareI2cDrive(number: int,released: bool): void {
    writes=writes+1
    if (number == 31) data=released
    else if (number == 32) {
        if (!clock && released) {
            pulses=pulses+1
            if (releaseAfter > 0 && pulses >= releaseAfter) held=false
        }
        clock=released
    } else bad=true
    return
}
fun softwareI2cSample(number: int): bool {
    if (number == 31) return data && !held
    if (number != 32) bad=true
    if (stretch > 0) { stretch=stretch-1;return false }
    return clock
}
fun softwareI2cDelay(us: int): void { if (us != 1 && us != 5) bad=true;return }
fun reset(): void { data=true;clock=true;held=true;stretch=0;releaseAfter=0;pulses=0;writes=0;pads=0;bad=false;return }
@export("abla_p4_software_i2c_recovery_test")
fun test(): int {
    var edge=0
    while (edge <= 10) {
        reset()
        var bus=esp32P4SoftwareI2cOpenOwned(31,32,5,8)
        if (bus.status() != 6 || pads != 2) return 1
        val original=bus
        bus=bus.recoverOwned()
        if (bus != original || pulses != 0 || pads != 2 || bad) return 2
        releaseAfter=edge
        bus=bus.recoverOwned(true)
        val success=edge >= 1 && edge <= 9
        if (bus.ready() != success || bus.status() != (if (success) 1 else 6) ||
            pulses != (if (success) edge+1 else 9) || !data || !clock || pads != 2 ||
            !bus.ownsSda() || !bus.ownsScl() || bus.lines() != original.lines() || bad) return 3
        held=false
        bus=bus.recoverOwned()
        if (!bus.ready() || pads != 2 || bad) return 4
        bus=bus.closeOwned()
        if (bus.status() != 0 || pads != 4) return 5
        edge=edge+1
    }
    reset()
    var bus=esp32P4SoftwareI2cOpenOwned(31,32,5,8)
    stretch=8
    bus=bus.recoverOwned(true)
    if (bus.status() != 10 || !data || !clock || pulses != 0 || pads != 2) return 6
    held=false;bus=bus.recoverOwned()
    if (!bus.ready() || bad) return 7
    // Reject closed, invalid, partially configured and closing leases untouched.
    var status=0
    while (status <= 11) {
        var owned=0
        while (owned < 4) {
            val state=Esp32P4SoftwareI2cBus((softwareI2cLines(31,32,5,8)|0)|(status<<48)|(owned<<56))
            if (owned != 3 || (status != 1 && status != 6 && status != 10)) {
                writes=0
                if (state.recoverOwned(true) != state || writes != 0) return 8
            }
            owned=owned+1
        }
        status=status+1
    }
    return 0
}
