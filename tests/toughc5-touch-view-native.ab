import "../src/m5stack/tough_touch_display_view.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_toughc5_touch_view_test")
fun testView(): int {
    var rotation=0
    while (rotation < 8) {
        val view=toughDisplayView(rotation)
        var y=0
        while (y < 240) {
            var x=0
            while (x < 320) {
                val p=toughDisplayTouchPoint(touchPoint(x,y,7,2,42),view)
                // Independent literal mapping for requested rotations0..7.
                val expectedX=if (rotation == 0 || rotation == 4) 239-y else if (rotation == 1 || rotation == 5) x else
                    if (rotation == 2 || rotation == 6) y else 319-x
                val expectedY=if (rotation == 0 || rotation == 6) x else if (rotation == 1 || rotation == 7) y else
                    if (rotation == 2 || rotation == 4) 319-x else 239-y
                if (!p.valid() || p.x() != expectedX || p.y() != expectedY || p.id() != 7 || p.event() != 2 || p.size() != 42 ||
                    !p.inside(view.width(),view.height())) return 1
                x=x+1
            }
            y=y+1
        }
        if (toughDisplayTouchPoint(touchPoint(320,0,0,2),view).valid() ||
            toughDisplayTouchPoint(touchPoint(0,240,0,2),view).valid() ||
            toughDisplayTouchPoint(TouchPoint(0),view).valid()) return 2
        rotation=rotation+1
    }
    if (toughDisplayTouchPoint(touchPoint(0,0,0,2),LcdView(u64(0))).valid()) return 3
    return 0
}
