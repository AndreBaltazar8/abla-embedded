import "../src/esp32/boot_main_esp32s3.ab"
import "../src/esp32/psram/boot80_esp32s3.ab"
import "../src/esp32/psram/startup_prepare_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Application-entry integration fixture, not a packaged/approved board image.
// Loader provides immutable internal request52B outside BSS: magic53335053,
// proof1 (already-ready clock) or3 (permit owned cold-clock preparation),
// then virtual,bytes,capacity,flashMHz,flashProfile,flashTiming,base,
// repetitions,cacheKiB,lineBytes,expectedMemoryMillivolts (1800 or3300).
// Proof certifies board wiring/power/cold RAM,
// independently valid flash timing/old mapping, DMA exclusion and watchdog.
// Proof3 additionally owns analog/UART/radio/APB users, initialized CPU80-safe
// voltage, cold clock prerequisites, and rebases APB consumers after startup.
// Link defaults proof0: missing loader contract is refusal, never inferred.
// Result is retained in internal BSS; main return enters masked halt tail.
@section(".iram1.abla.s3PsramBootApplication")
trusted fun esp32S3BootApplication(): void {
    val request=int(xtensaGuardRead("movi $0, __abla_psram_request","=r,~{memory}"))
    val owner=int(xtensaGuardRead("movi $0, __abla_psram_owner_low","=r,~{memory}"))
    val result=int(xtensaGuardRead("movi $0, __abla_psram_result","=r,~{memory}"))
    val q=nativeBufferAt(request,52)
    val proof=q.loadU32(4)
    val memoryMillivolts=q.loadU32(48)
    if (q.loadU32(0) != 0x53335053 || (proof != 1 && proof != 3) ||
        (memoryMillivolts != 1800 && memoryMillivolts != 3300)) { mmioStoreU32(result,2);return }
    if (!s3PsramBoot80ArgumentsValid(q.loadU32(8),q.loadU32(12),q.loadU32(16),q.loadU32(20),q.loadU32(24),q.loadU32(28),q.loadU32(32),q.loadU32(36),q.loadU32(40),q.loadU32(44))) {
        mmioStoreU32(result,2);return
    }
    val prepared=s3PsramStartupPrepareOwned(memoryMillivolts,100000,proof == 3,true)
    if (prepared != 1) { mmioStoreU32(result,prepared);return }
    // Preparation already admitted default routing under exclusive ownership.
    val status=s3PsramBoot80ConfiguredOwned(nativeBufferAt(owner,2720),q.loadU32(8),q.loadU32(12),q.loadU32(16),q.loadU32(20),q.loadU32(24),q.loadU32(28),q.loadU32(32),q.loadU32(36),q.loadU32(40),q.loadU32(44),true)
    mmioStoreU32(result,status);return
}
