import "../src/esp32/psram/command_mode_s3_sequence.ab"
import "abla/build"
var cmValue=0
var cmWrites=0
var cmReads=0
var cmFail=0
var cmBusy=0
var cmBad=false
fun s3PsramCsRead(address: int): int {
    cmReads=cmReads+1
    if (address == 0x60002000) return if (cmBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (cmBusy == 2) 0x80000000 else 0
    if (address != 0x600020e0) cmBad=true
    return cmValue
}
fun s3PsramCsWrite(address: int,value: int): void {
    if (address != 0x600020e0 || cmWrites > 1 || value != (if (cmWrites == 0) cmValue|2 else cmValue&0xfffffff3)) cmBad=true
    cmWrites=cmWrites+1
    cmValue=if (cmWrites == cmFail) value^(if (cmWrites == 1) 2 else 4) else value
    return
}
@export("abla_s3_psram_command_mode_test")
fun testCommandMode(): int {
    var profile=0
    while (profile < 256) {
        cmFail=0
        while (cmFail <= 2) {
            val original=(profile*16777217)^0xa55a5aa5
            cmValue=original;cmWrites=0;cmReads=0;cmBusy=0;cmBad=false
            if (s3PsramCommandModeOwned(true) != (if (cmFail == 0) 1 else 4) ||
                cmWrites != (if (cmFail == 0) 2 else cmFail) || cmBad) return 1
            if (cmFail == 0 && cmValue != ((original|2)&0xfffffff3)) return 2
            cmFail=cmFail+1
        }
        profile=profile+1
    }
    cmReads=0;cmWrites=0
    if (s3PsramCommandModeOwned(false) != 2 || cmReads != 0) return 3
    cmBusy=1
    if (s3PsramCommandModeOwned(true) != 3 || cmWrites != 0) return 4
    cmBusy=2
    if (s3PsramCommandModeOwned(true) != 3 || cmWrites != 0) return 5
    return 0
}
