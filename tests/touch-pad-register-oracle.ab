import "../src/esp32/touch/pad_esp32_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
// Host-only bridge to real production planning functions. Unused MMIO
// functions are deliberately unreachable, not substitutes in firmware.
fun touchScanRead(address: int): u32 = u32(0)
fun touchScanWrite(address: int,value: u32): void { return }
@export("abla_touch_pad_register_field")
fun field(index: int,channel: int): int {
    if (channel < 0 || channel > 9) return -1
    if (index == 0) return esp32TouchPadMuxAddress(channel)
    if (index == 1) return int(esp32TouchPadMuxMask(channel))
    if (index == 2) return int(esp32TouchPadMuxSelect(channel))
    if (index == 3) return int(esp32TouchPadHoldMask(channel))
    if (index == 4) return int(esp32TouchPadOutputMask(channel))
    if (index == 5) return esp32TouchPadChargeAddress(channel)
    return -1
}
