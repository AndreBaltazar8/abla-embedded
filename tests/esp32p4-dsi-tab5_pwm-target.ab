import "../src/m5stack/tab5_pwm_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_tab5_pwm_target")
trusted fun target(operation: int,owner: int,value: int,polls: int): int {
    if (operation == 0) return tab5PwmBacklightOpenOwned(value,polls).bits()
    if (operation == 1) return Tab5PwmBacklight(owner).setDutyOwned(value,polls).bits()
    if (operation == 2) return Tab5PwmBacklight(owner).waitOwned(polls).bits()
    return Tab5PwmBacklight(owner).closeOwned(polls).bits()
}
