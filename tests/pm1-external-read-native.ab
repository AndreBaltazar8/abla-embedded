import "../src/m5stack/pm1_external_read.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true; return I2cWordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
trusted fun I2cDevice.readRegister(register: int,bytes: NativeBuffer,count: int): bool { bad=true; return false }
trusted fun I2cDevice.writeRegister(register: int,bytes: NativeBuffer,count: int): bool { bad=true; return false }
var calls=0
var failAt=0
var bits=0
var boost=false
var bad=false
var trace=0
fun readStep(handle: int,expected: int,code: int,value: int): I2cByteResult {
    calls=calls+1; trace=trace*10+code
    if (handle != expected) bad=true
    I2cByteResult(if (calls == failAt) 0 else 256|value)
}
// Only the transport is modeled: production drivers must choose PM1 config6,
// PM1 output-latch17 and M5IOE1 output-latch5 (NOT input register7).
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    if (register == 6) return readStep(this,7,1,bits)
    if (register == 17) return readStep(this,7,3,bits)
    if (register == 5) return readStep(this,8,2,(bits & 239) | (if (boost) 16 else 0))
    bad=true; I2cByteResult(0)
}
@export("abla_pm1_external_read_test")
fun readTest(): i32 {
    var model=0
    while (model < 6) {
        val board=if (model == 0) m5BoardChainCaptain else if (model == 1) m5BoardStampS3Bat else
            if (model == 2) m5BoardToughC5 else if (model == 3) m5BoardStickS3 else if (model == 4) m5BoardStopWatch else m5BoardPaperColor
        bits=0
        while (bits < 256) {
            var setting=0
            while (setting < 6) {
                boost=(setting & 1) != 0; failAt=setting/2
                calls=0; trace=0; bad=false
                val result=board.pm1ExternalPortsCheckedOwned(7,if (model == 0) 8 else 0)
                val count=if (model == 0 && boost && failAt != 1) 2 else 1
                val success=failAt == 0 || failAt > count
                val expected=if (model == 0) (if (!boost) 0 else (bits & 1) | (if ((bits & 8) != 0) 6 else 0))
                    else if (model == 1) (bits>>>1)&1 else (bits>>>3)&1
                if (result != I2cByteResult(if (success) 256|expected else 0) || calls != count || bad ||
                    trace != (if (model == 0) (if (count == 1) 2 else 23) else if (model == 1) 3 else 1)) return i32(1)
                setting=setting+1
            }
            bits=bits+1
        }
        model=model+1
    }
    calls=0
    if (m5BoardAtomVoice.pm1ExternalPortsCheckedOwned(7,8).valid() ||
        m5BoardChainCaptain.pm1ExternalPortsCheckedOwned(7,0).valid() ||
        m5BoardChainCaptain.pm1ExternalPortsCheckedOwned(7,4294967296).valid() ||
        m5BoardStopWatch.pm1ExternalPortsCheckedOwned(-1,0).valid() ||
        m5BoardStampS3Bat.pm1ExternalPortsCheckedOwned(0,0).valid() || calls != 0) return i32(2)
    i32(0)
}
