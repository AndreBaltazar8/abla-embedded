import "../src/esp32/analog_sleep_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_analog_sleep_target")
@section(".iram1.abla.s3AnalogSleepTarget")
trusted fun analogTarget(restore: bool,state: int): int {
    if (restore) { esp32S3AnalogSleepRestoreOwned(Esp32S3AnalogSleepState(state)); return state }
    esp32S3AnalogSleepCaptureOwned() | 0
}
