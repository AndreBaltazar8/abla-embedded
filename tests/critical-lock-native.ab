import "../src/xtensa/critical_lock_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var status=0
var owner=0
var calls=0
var bad=false
fun xtensaGuardCore(): int = core
fun xtensaGuardStatus(): int = status
fun xtensaGuardMaskLocal(): int { val old=status; status=status | 15; return old }
fun xtensaGuardRestoreLevel(level: int): void { status=(status & ~15) | level; return }
fun xtensaCriticalLockCas(address: int,expected: int,replacement: int): int {
    if (address != 0x3FC90000 || (status & 15) != 15) bad=true
    calls=calls+1
    val old=owner
    if (old == expected) owner=replacement
    old
}
@export("abla_critical_lock_test")
trusted fun criticalLockTest(): i32 {
    val word=nativeBufferAt(0x3FC90000,4)
    var profile=0
    while (profile < 64) {
        core=(profile>>>4) & 1; status=0x40020 | (profile & 15); owner=0; calls=0; bad=false
        val before=status
        val token=xtensaCriticalLockTry(word)
        if (!token.valid() || owner != core+1 || calls != 1 || bad || status != 0x4002F) return i32(1)
        if (xtensaCriticalLockTry(word).valid() || owner != core+1 || status != 0x4002F) return i32(2)
        core=core ^ 1
        if (xtensaCriticalLockTry(word).valid() || xtensaCriticalLockRelease(word,token) || owner != (core ^ 1)+1) return i32(3)
        core=core ^ 1; status=0x5002F
        if (!xtensaCriticalLockRelease(word,token) || owner != 0 || status != (0x50020 | (before & 15))) return i32(4)
        status=0x40020 | (profile & 15); owner=2-core
        if (xtensaCriticalLockTry(word).valid() || status != before || owner != 2-core) return i32(5)
        calls=0
        if (xtensaCriticalLockTry(nativeBufferAt(0,4)).valid() ||
            xtensaCriticalLockTry(nativeBufferAt(0x3FC90001,4)).valid() ||
            xtensaCriticalLockTry(nativeBufferAt(0x3FC90000,3)).valid() ||
            xtensaCriticalLockRelease(word,XtensaInterruptGuard(0)) || calls != 0 || bad) return i32(6)
        profile=profile+1
    }
    i32(0)
}
