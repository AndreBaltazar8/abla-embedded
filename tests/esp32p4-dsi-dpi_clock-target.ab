import "../src/display/dpi_clock_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_dpi_clock_target")
trusted fun target(source: int,sourceKhz: int,expectedKhz: int,stop: bool): int {
    if (stop) return esp32P4DpiClockStop()
    esp32P4DpiClockStart(esp32P4DpiClockPlan(source,sourceKhz,expectedKhz))
}
