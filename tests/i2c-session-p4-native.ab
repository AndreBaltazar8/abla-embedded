import "../src/esp32/i2c/session_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(80)
val data=nativeStaticAllocate(16)
var step=0
var failure=0
var acquired=true
var pinsCloseFails=false
var clockCloseFails=false
var pinsClosed=0
var clocksClosed=0
var transfers=0
var transferResult=1
var bad=false
trusted fun p4I2cSessionClockOpen(port: int,source: int): int {
    if (step != 0 || port < 0 || port > 1 || source != 0) bad=true
    step=1
    return (if (acquired || failure != 1) 4096|(port<<11) else 0)|(if (failure == 1) 5 else 1)
}
trusted fun p4I2cSessionInitialize(port: int,filter: int): int {
    if (step != 1 || filter != 7) bad=true
    step=2;return if (failure == 2) 5 else 1
}
trusted fun p4I2cSessionTiming(port: int,timing: P4I2cTiming): int {
    if (step != 2 || !timing.valid()) bad=true
    step=3;return if (failure == 3) 5 else 1
}
trusted fun p4I2cSessionPinsOpen(r: NativeBuffer,port: int,sda: int,scl: int,pullup: bool,layout: int): int {
    if (step != 3 || sda != 7 || scl != 8 || !pullup || layout != 3) bad=true
    step=4
    if (failure != 4 || acquired) r.storeU32(0,0x49325050)
    return if (failure == 4) 3 else 1
}
trusted fun p4I2cSessionPinsClose(r: NativeBuffer): int {
    if (r.loadU32(0) != 0x49325050 || clocksClosed != 0) bad=true
    pinsClosed=pinsClosed+1;return if (pinsCloseFails) 3 else 2
}
trusted fun p4I2cSessionClockClose(token: int): int {
    if ((token&4096) == 0 || (step == 4 && (failure != 4 || acquired) && pinsClosed == 0)) bad=true
    clocksClosed=clocksClosed+1
    return (token&0x1f00)|(if (clockCloseFails) 5 else 6)
}
trusted fun p4I2cSessionTransfer(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    val r=nativeBufferAt(storage,80)
    if (r.loadU32(4) != 2 || address != 42 || written != 1 || read != 1 || prefix != 12) bad=true
    if (esp32p4I2cSessionCloseOwned(r,true) != 2 ||
        esp32p4I2cSessionTransferOwned(r,42,output,1,input,1,budget,true,12) != 7) bad=true
    transfers=transfers+1;return transferResult
}
trusted fun seed(): void {
    var i=0
    while (i < 80) { nativeBufferAt(storage,80).storeU32(i,0);i=i+4 }
    nativeBufferAt(storage,80).storeU32(72,0x12345678)
    nativeBufferAt(storage,80).storeU32(76,0x87654321)
    step=0;failure=0;acquired=true;pinsCloseFails=false;clockCloseFails=false
    pinsClosed=0;clocksClosed=0;transfers=0;transferResult=1;bad=false;return
}
trusted fun open(port: int): int = esp32p4I2cSessionOpenOwned(nativeBufferAt(storage,80),port,0,u32(40000000),u32(100000),7,8,7,true,3,true)
@export("abla_i2c_session_p4_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(storage,80);val b=nativeBufferAt(data,16)
    var port=0
    while (port < 2) {
        var f=0
        while (f <= 4) {
            var owned=0
            while (owned < 2) {
                seed();failure=f;acquired=owned != 0
                if (open(port) != (if (f == 0) 1 else f+2) || bad) return i32(1)
                if (r.loadU32(72) != 0x12345678 || r.loadU32(76) != 0x87654321) return i32(2)
                if (open(port) != 2) return i32(3)
                if (f == 0) {
                    var result=1
                    while (result <= 8) {
                        transferResult=result
                        if (esp32p4I2cSessionTransferOwned(r,42,b,1,b,1,u32(100),true,12) != result || bad) return i32(4)
                        if (r.loadU32(4) != (if (result == 1) 1 else 3)) return i32(5)
                        if (result != 1) {
                            val old=transfers
                            if (esp32p4I2cSessionTransferOwned(r,42,b,1,b,1,u32(100),true,12) != 7 || transfers != old) return i32(6)
                            // Isolated model scenario reset; production never forces ready.
                            r.storeU32(4,1)
                        }
                        result=result+1
                    }
                }
                val primary=r.loadU32(8)
                if (esp32p4I2cSessionCloseOwned(r,true) != 8 || bad || r.loadU32(8) != primary || r.loadU32(24) != 0) return i32(7)
                val calls=pinsClosed+clocksClosed
                if (esp32p4I2cSessionCloseOwned(r,true) != 8 || pinsClosed+clocksClosed != calls) return i32(8)
                owned=owned+1
            }
            f=f+1
        }
        seed();if (open(port) != 1) return i32(9)
        pinsCloseFails=true
        if (esp32p4I2cSessionCloseOwned(r,true) != 7 || clocksClosed != 0 || r.loadU32(12) != 6) return i32(10)
        pinsCloseFails=false;clockCloseFails=true
        if (esp32p4I2cSessionCloseOwned(r,true) != 7 || r.loadU32(24) != 1 || r.loadU32(12) != 3) return i32(11)
        val closed=pinsClosed;clockCloseFails=false
        if (esp32p4I2cSessionCloseOwned(r,true) != 8 || pinsClosed != closed || bad) return i32(12)
        seed();if (open(port) != 1) return i32(13)
        if (esp32p4I2cSessionTransferOwned(r,42,r,1,b,1,u32(100),true) != 7 ||
            esp32p4I2cSessionTransferOwned(r,42,b,1,nativeBufferAt(storage+71,1),1,u32(100),true) != 7 ||
            esp32p4I2cSessionTransferOwned(r,42,b,17,b,1,u32(100),true) != 7 || transfers != 0 || r.loadU32(4) != 1) return i32(14)
        port=port+1
    }
    seed()
    if (esp32p4I2cSessionOpenOwned(r,0,0,u32(40000000),u32(0),7,8,7,true,3,true) != 2 || step != 0 || r.loadU32(0) != 0) return i32(15)
    if (esp32p4I2cSessionOpenOwned(nativeBufferAt(storage,71),0,0,u32(40000000),u32(100000),7,8,7,true,3,true) != 2 || step != 0) return i32(16)
    return i32(0)
}
