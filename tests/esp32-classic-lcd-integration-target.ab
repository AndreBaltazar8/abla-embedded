import "../src/esp32/platform_full_link_esp32.ab"
import "../src/display/mipi_rgb565_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_classic_lcd_integration_test")
trusted fun classicLcdIntegrationTarget(busValue: int, rotation: int): int {
    // This fixture uses the complete scheduler/ROM-compatible runtime, whose
    // linker ABI requires errno plus the three per-thread stream slots. Check
    // that existing runtime contract before entering the peripheral workflow;
    // a caller still owns boot, TLS setup, and the initialized SPI bus.
    if (!esp32PicolibcTlsCompatibilityReady()) return 512
    val lcd = SpiBus(busValue).lcd(5,27,33,32,1000000,false)
    if (!lcd.valid()) return 1
    val view = lcd.beginMipiRgb565(lcdGeometry(320,240),rotation,"\x11\x80\x78\x29\x00\xff\xff")
    var result = if (view.width() == 0) 2 else 0
    if (result == 0 && !lcd.fill(view,rgb565Black)) result = 3
    if (result == 0 && !lcd.setRotation(lcdGeometry(320,240),rotation)) result = 4
    if (result == 0 && !lcd.setInverted(false)) result = 5
    if (result == 0 && !lcd.setIdle(false)) result = 6
    if (result == 0) {
        val source = nativeBufferAt(nativeStackAllocate(144),144)
        val staging = nativeBufferAt(nativeStackAllocate(64),64)
        var index = 0
        while (index < 144) {
            source.store(index,(index*73+199) & 255)
            index = index+1
        }
        if (!lcd.blitRgb565(view,-1,0,source,35,2,74)) result = 8
        if (result == 0 && !lcd.blitRgb565(view,36,0,source,35,2,74,true,staging)) result = 9
    }
    lcd.setBacklight(false)
    if (result == 0 && !lcd.setSleep(true,120)) result = 7
    if (!lcd.close()) result = result | 256
    result
}
