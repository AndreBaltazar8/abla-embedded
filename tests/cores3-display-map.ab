import "../src/m5stack/display_map.ab"
fun main(): int {
    var variant = 0
    while (variant < 2) {
        val board = if (variant == 0) m5BoardStackCoreS3 else m5BoardStackCoreS3SE
        val pins = board.displaySpiPins()
        if (!pins.available() || pins.mosi() != 37 || pins.miso() != 35 || pins.clock() != 36 ||
            pins.chipSelect() != 3 || pins.dataCommand() != 35 || pins.reset() != -1 || pins.backlight() != -1) return 1
        if (!board.displaySharedDataCommand() || !board.displayInverted() ||
            board.displayController() != m5DisplayControllerIli9342 || board.displayFrequency() != 40000000) return 2
        val geometry = board.displayGeometry()
        if (!geometry.valid() || geometry.width() != 320 || geometry.height() != 240 || board.displayRotation() != 0) return 3
        variant = variant + 1
    }
    if (m5BoardStack.displaySharedDataCommand() || m5BoardStackCore2.displaySharedDataCommand() ||
        m5BoardAtomVoice.displaySpiPins().available()) return 4
    0
}
