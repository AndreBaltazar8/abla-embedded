// Keep freestanding static-byte profiles identical to the legacy string API.

import "../tools/lib/source_text.ab"
import "abla/text"
import "abla/regex"
import "abla/integer"

fun main: int {
    val legacy = sourceRead("src/display/mipi_commands.ab")
    val native = sourceRead("src/display/mipi_programs.ab")
    val expectedNames: array<string> = []
    val expectedBytes: array<string> = []
    for (found in sourceFindAll("""val (\w+)InitCommands = \x22([^"]+)\x22""", legacy)) {
        expectedNames.append(sourceGroup(found, 1))
        expectedBytes.append(sourceGroup(found, 2))
    }
    val actual = sourceFindAll("""fun (\w+)InitProgram\(\): NativeBuffer =\s*nativeBufferAt\(nativeStaticBytes\(\x22([^"]+)\x22\), (\d+)\)""", native)
    sourceCheck(expectedNames.size == 4 && actual.size == 4, "four legacy and four freestanding profiles (${expectedNames.size}, ${actual.size})")
    for (found in actual) {
        val name = sourceGroup(found, 1)
        val encoded = sourceGroup(found, 2)
        val length = sourceGroup(found, 3).parseInt()
        val index = sourceNameIndex(expectedNames, name)
        sourceCheck(index >= 0, "$name has a legacy profile")
        if (index >= 0) sourceCheck(encoded == expectedBytes[index], "$name: bytes differ from the legacy profile")
        sourceCheck(sourceFind("""^(\\x[0-9a-f]{2})+$""", encoded) != null, "$name: not a plain \\xNN string")
        sourceCheck(length != null && encoded.size / 4 == length, "$name: the length argument is not the byte count")
    }
    sourceFinish("PASS: four freestanding MIPI profiles preserve every legacy command byte")
}
