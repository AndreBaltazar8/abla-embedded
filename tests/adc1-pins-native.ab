import "../src/esp32/adc1_pins_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var channel=0
var pad=0
var force=0
var enable=0
var digital=3
var writes=0
var drop=0
var bad=false
fun esp32Adc1PadRead(offset: int): int { if (offset == 12) return enable; if (offset != esp32Adc1PadOffset(channel)) bad=true; return pad }
fun esp32Adc1PadWrite(offset: int,value: int): void {
    writes=writes+1; if (writes == drop) return
    if (offset == 20) { if (value != (1<<(esp32Adc1RtcPad(channel)+14))) bad=true; enable=enable&(4294967295^value) }
    else { if (offset != esp32Adc1PadOffset(channel)) bad=true; pad=value }
    return
}
fun esp32Adc1ForceHoldRead(): int = force
fun esp32Adc1DigitalEnableRead(): int = digital
fun esp32Adc1DigitalDisable(mask: int): void {
    writes=writes+1; if (writes == drop) return
    if (mask != (if (channel == 4) 1 else 2)) bad=true
    digital=digital&(4294967295^mask); return
}
@export("abla_adc1_pins_test")
fun pinsTest(): i32 {
    if (esp32Adc1PadClear(0) != 0xe80000 || esp32Adc1PadClear(4) != 0xc00720 || esp32Adc1PadClear(5) != 0x1801c800 || esp32Adc1PadClear(6) != 0xe800000 || esp32Adc1RtcPad(4) != 9 || esp32Adc1RtcPad(5) != 8) return i32(9)
    while (channel < 8) {
        val pin=if (channel < 4) 36+channel else 28+channel
        if (esp32Adc1Pin(channel) != pin) return i32(1)
        pad=esp32Adc1PadClear(channel)|1; force=0; enable=0xffffffff; digital=3; writes=0
        val before=pad
        if (esp32Adc1PadConfigureOwned(channel) != 1 || bad) return i32(2)
        val mask=esp32Adc1PadClear(channel)|esp32Adc1PadMux(channel)
        if (pad != ((before&(4294967295^mask))|esp32Adc1PadMux(channel)) || enable != (0xffffffff^(1<<(esp32Adc1RtcPad(channel)+14)))) return i32(3)
        var stage=1
        val total=if (channel == 4 || channel == 5) 3 else 2
        while (stage <= total) {
            pad=before; enable=0xffffffff; digital=3; writes=0; drop=stage
            if (esp32Adc1PadConfigureOwned(channel) != 5 || writes != stage || bad) return i32(4)
            stage=stage+1
        }
        drop=0; writes=0; pad=esp32Adc1PadHold(channel)
        if (esp32Adc1PadConfigureOwned(channel) != 3 || writes != 0) return i32(5)
        pad=0; force=esp32Adc1PadForceHold(channel)
        if (esp32Adc1PadConfigureOwned(channel) != 3 || writes != 0) return i32(6)
        force=0
        if (channel == 4 || channel == 5) {
            pad=0x80000
            if (esp32Adc1PadConfigureOwned(channel) != 4 || writes != 0) return i32(7)
        }
        channel=channel+1
    }
    if (esp32Adc1PadConfigureOwned(8) != 2 || esp32Adc1Pin(-1) != -1) return i32(8)
    return i32(0)
}
