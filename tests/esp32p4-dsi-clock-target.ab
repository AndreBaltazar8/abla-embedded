import "../src/esp32/dsi_clock_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_clock_target")
trusted fun target(hwVersion: int,cfgSource: int,refSource: int,referenceDiv: int,stop: bool): int {
    if (stop) { esp32P4DsiClockStop(); return 1 }
    esp32P4DsiClockStart(hwVersion,cfgSource,refSource,referenceDiv)
}
