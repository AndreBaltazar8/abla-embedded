import "../src/esp32/i2c_esp32s3.ab"
import "../src/led/powerhub_raw.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun powerHubLedTarget(handle: u32, colors: u32, levels: u32): bool {
    val leds = PowerHubLedRaw(int(handle))
    leds.enable() && leds.writeBrightness(nativeBufferAt(int(levels), 8)) &&
        leds.writeColors(nativeBufferAt(int(colors), 32))
}
#exportFunction("powerHubLedTarget", "abla_s3_powerhub_led_raw_test")
