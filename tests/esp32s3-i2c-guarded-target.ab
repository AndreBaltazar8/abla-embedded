import "../src/esp32/i2c/guarded_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_i2c_guarded_test")
trusted fun i2cGuardedTargetTest(gate: PeripheralGate, owner: u32,
    port: i32, address: i32, output: NativeBuffer, written: i32,
    input: NativeBuffer, read: i32, budget: u32): int =
    esp32S3I2cTransferGuarded(gate, owner, int(port), int(address),
        output, int(written), input, int(read), budget)
