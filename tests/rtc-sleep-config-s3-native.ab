import "../src/m5stack/rtc_timer_sleep_config_s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var bad=false
fun esp32S3RtcWakeRead(address: int): int { bad=true; 0 }
fun esp32S3RtcWakeWrite(address: int,value: int): void { bad=true; return }
fun esp32S3RtcWakeUpdate(address: int,mask: int,value: int): void { bad=true; return }
@export("abla_rtc_sleep_config_test")
trusted fun configTest(): i32 {
    val c=nativeBufferAt(nativeStaticAllocate(64),64)
    val i=esp32S3TagPlan(false,32768,8,32,0x42000000,65536,false)
    var profile=0
    while (profile < 64) {
        val small=(profile&1)!=0; val monitor=(profile&2)!=0; val octal=(profile&4)!=0
        val ports=profile>>>3
        val d=esp32S3TagPlan(true,32768,4,32,0x3C000000,65536,small)
        val flags=if (monitor) 0x20000 else 0
        val protocol=if (octal) 0 else 3; val baseline=if (octal) 0 else 4
        if (!m5RtcSleepConfigWrite(c,Esp32S3ClockBias(123),i,d,ports,octal,-1,protocol,baseline,8,small,monitor,flags,1<<19,0,1000) || !m5RtcSleepConfigValid(c)) return i32(1)
        if (m5RtcCycleWord64(c,0) != 123 || m5RtcCycleWord64(c,8) != (i | 0) || m5RtcCycleWord64(c,16) != (d | 0) ||
            c.loadU32(24) != ports || c.loadU32(28) != ((if (octal) 1 else 0)|(if (small) 2 else 0)|(if (monitor) 4 else 0)) ||
            m5RtcCycleRam(c) != -1 || c.loadU32(36) != protocol || c.loadU32(40) != baseline || c.loadU32(44) != 8 ||
            c.loadU32(48) != flags || c.loadU32(52) != (1<<19) || c.loadU32(56) != 0 || c.loadU32(60) != 1000) return i32(2)
        var offset=0
        while (offset < 64) {
            val saved=c.loadU32(offset)
            val invalid=if (offset == 0) 1<<21 else if (offset == 4) 1 else if (offset == 12 || offset == 20) 1<<9 else if (offset == 24 || offset == 28) 8 else if (offset == 36 || offset == 40) 64 else if (offset == 48) 1 else if (offset == 56) 0x40000 else 0
            c.storeU32(offset,invalid)
            if (m5RtcSleepConfigValid(c)) return i32(3)
            c.storeU32(offset,saved)
            offset=offset+4
        }
        // Builder validates before writing; rejected input preserves all bytes.
        if (m5RtcSleepConfigWrite(c,Esp32S3ClockBias(123),i,d,ports,octal,-1,protocol,baseline,8,small,monitor,flags,0,0,1000) || !m5RtcSleepConfigValid(c)) return i32(4)
        profile=profile+1
    }
    if (m5RtcSleepConfigValid(nativeBufferAt(c.addressValue(),63)) || bad) return i32(5)
    i32(0)
}
