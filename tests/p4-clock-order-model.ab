// Shared observer used only by the combined clock fixture. Individual MMIO
// fixtures keep it disabled. Watches transitions, not just final registers.
var clockOrderEnabled=false
var clockOrderFlash=false
var clockOrderPsram=false
var clockOrderFlashLow=false
var clockOrderPsramLow=false
var clockOrderCpuRestored=true
var clockOrderBad=false
fun clockOrderCpu(old: int,next: int): void {
    if (!clockOrderEnabled) return
    if (old != 0 && next == 0) {
        if ((clockOrderFlash && !clockOrderFlashLow) || (clockOrderPsram && !clockOrderPsramLow)) clockOrderBad=true
        clockOrderCpuRestored=false
    } else if (old == 0 && next != 0) clockOrderCpuRestored=true
    return
}
fun clockOrderMemory(flash: bool,low: bool): void {
    if (!clockOrderEnabled) return
    if (!low && !clockOrderCpuRestored) clockOrderBad=true
    if (flash) clockOrderFlashLow=low else clockOrderPsramLow=low
    return
}
