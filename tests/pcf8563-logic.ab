import "../src/rtc/pcf8563_logic.ab"

fun main: int {
    val decoded = pcf8563DecodeDateTime(
        88, 89, 35, 38, 3, 136, 38
    )
    val validDate = decoded.valid() && decoded.year() == 1926 &&
        decoded.month() == 8 && decoded.day() == 26 &&
        decoded.weekday() == 3 && decoded.hour() == 23 &&
        decoded.minute() == 59 && decoded.second() == 58
    val invalidBcd = !pcf8563DecodeDateTime(
        106, 0, 0, 1, 0, 1, 0
    ).valid()
    val seconds = pcf8563TimerPlan(255600)
    val minutes = pcf8563TimerPlan(270000)
    val timers = pcf8563TimerCount(seconds) == 255 &&
        pcf8563TimerControl(seconds) == 130 &&
        pcf8563TimerMilliseconds(seconds) == 255000 &&
        pcf8563TimerCount(minutes) == 5 &&
        pcf8563TimerControl(minutes) == 131 &&
        pcf8563TimerMilliseconds(minutes) == 300000
    if (validDate && invalidBcd && timers) 44 else 1
}
