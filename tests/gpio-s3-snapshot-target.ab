import "../src/esp32/gpio/snapshot_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_gpio_s3_snapshot_target")
trusted fun target(operation: int,pin: int,state: int,quiescent: bool): int = if (operation == 0) esp32S3GpioSnapshotOwned(pin,quiescent)|0 else S3GpioSnapshot(state).restoreOwned(quiescent)
