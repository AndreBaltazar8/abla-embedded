import "../src/display/text_console_gray4.ab"
import "abla/build"
val grayConsoleStorage=nativeStaticAllocate(131072)
@export("abla_text_console_gray4_test")
fun testGrayConsole(): int {
    val gray=nativeBufferAt(grayConsoleStorage,32768)
    val rgb=nativeBufferAt(grayConsoleStorage+32768,98304-128)
    val text=nativeBufferAt(grayConsoleStorage+131072-128,128)
    var scale=1
    while (scale <= 8) {
        val width=18*scale+1;val height=16*scale+3;val stride=(width+1)/2
        var profile=0
        while (profile < 16) {
            var i=0
            while (i < stride*height) { gray.store(i,0xaa);i=i+1 }
            i=0
            while (i < width*height*2) { rgb.store(i,0xaa);i=i+1 }
            i=0
            while (i < 32) {
                text.store(i,if ((i&7) == 0) 13 else if ((i&7) == 1) 10 else if ((i&7) == 2) 0 else (i*19+profile*31)&255)
                i=i+1
            }
            var a=textCursor();var b=textCursor()
            i=0
            while (i < 32) {
                // Split writes check that cursor carries pending wrap/scroll.
                val chunk=nativeBufferAt(text.addressValue()+i,1)
                a=a.writeGray4Owned(gray,width,height,chunk,1,profile,15-profile,scale)
                b=b.writeRgb565Owned(rgb,width,height,width*2,chunk,1,profile*4369,(15-profile)*4369,scale,false)
                if (!a.valid() || a != b) return 1
                i=i+1
            }
            var y=0
            while (y < height) {
                var x=0
                while (x < width) {
                    val sample=epdCanvasRead(gray,width,height,x,y,0)
                    val offset=(y*width+x)*2
                    if (sample*257 != ((rgb.load(offset)<<8)|rgb.load(offset+1))) return 2
                    x=x+1
                }
                // Odd-width unused low nibble must remain unchanged too.
                if ((gray.load(y*stride+stride-1)&15) != 10) return 3
                y=y+1
            }
            profile=profile+1
        }
        scale=scale+1
    }
    val before=gray.loadU32(0)
    if (textCursor().writeGray4Owned(gray,16,16,gray,1,0,15).valid() ||
        textCursor().writeGray4Owned(gray,16,16,text,1,16,15).valid() ||
        textCursor().writeGray4Owned(gray,16,16,text,129,0,15).valid() ||
        textCursor(3,0).writeGray4Owned(gray,16,16,text,1,0,15).valid() ||
        textCursor().writeGray4Owned(nativeBufferAt(gray.addressValue(),127),16,16,text,1,0,15).valid() || gray.loadU32(0) != before) return 4
    return 0
}
