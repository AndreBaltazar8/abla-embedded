import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/adc_config_c5_sequence.ab"
var clock=u32(0)
var divider=u32(0)
var onetime=u32(0)
var sample=0
var writes=0
var drop=0
var bad=false
var powered=true
trusted fun c5AdcClockRead(offset: int): u32 = if (offset == 0) u32(4) else if (offset == 4) clock else divider
trusted fun c5AdcClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes != drop) { if (offset == 4) clock=value else if (offset == 0xc0) divider=value else bad=true }
    return
}
trusted fun c5AdcRead(offset: int): u32 = if (offset == 0 && powered) u32(0x18000040) else if (offset == 0x20) onetime else u32(0)
trusted fun c5AdcWrite(offset: int,value: u32): void {
    writes=writes+1
    if (offset != 0x20) bad=true
    if (writes != drop) onetime=value
    return
}
trusted fun c5AdcTrimField(reg: int,low: int,high: int,value: int): int {
    if (reg != 2 || low != 0 || high != 2) bad=true
    if (value == -1) return sample&7
    writes=writes+1
    if (writes != drop) sample=(sample&~7)|value
    return value
}
@export("abla_adc_config_c5_test")
trusted fun test(): i32 {
    var ch=0
    while (ch < 6) {
        var atten=0
        while (atten < 4) {
            var oldSample=0
            while (oldSample < 8) {
                var fault=0
                while (fault < 9) {
                    clock=u32(0x80623456);divider=u32(0x1234ff56);onetime=u32(0x1a012345);sample=0xf8|oldSample;writes=0;drop=fault
                    var owner=c5AdcControllerOpenOwned(ch,atten,true)
                    if (owner.ready() && (clock != u32(0x8060f040) || divider != u32(0x12340156) || onetime != (u32(0x12345)|(u32(atten|(ch<<2))<<u32(23))) || sample != 0xfa)) return i32(1)
                    owner=owner.closeOwned(true);drop=0;owner=owner.closeOwned(true)
                    if (owner.status() != 0 || clock != u32(0x80623456) || divider != u32(0x1234ff56) || onetime != u32(0x1a012345) || sample != (0xf8|oldSample) || bad) return i32(2)
                    fault=fault+1
                }
                oldSample=oldSample+1
            }
            atten=atten+1
        }
        ch=ch+1
    }
    var owner=c5AdcControllerOpenOwned(0,0,true)
    val before=writes
    onetime=onetime|u32(0x20000000);owner=owner.closeOwned(true)
    if (owner.status() != 4 || writes != before) return i32(3)
    onetime=onetime&~u32(0x20000000);powered=false;owner=owner.closeOwned(true)
    if (owner.status() != 3 || writes != before) return i32(4)
    powered=true;owner=owner.closeOwned(true)
    if (owner.status() != 0) return i32(5)
    if (c5AdcDefaultPulseMicros(40000000) != 3 || c5AdcDefaultPulseMicros(16000000) != 6 || c5AdcDefaultPulseMicros(15) != -1 || c5AdcDefaultPulseMicros(80000001) != -1) return i32(6)
    if (c5AdcControllerOpenOwned(6,0,true).status() != 2 || c5AdcControllerOpenOwned(0,4,true).status() != 2 || c5AdcControllerOpenOwned(0,0,false).status() != 2) return i32(7)
    return i32(0)
}
