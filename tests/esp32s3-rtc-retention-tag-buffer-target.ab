import "../src/esp32/rtc_retention_tag_buffer_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_retention_tag_buffer_target")
@section(".iram1.abla.s3TagBufferTarget")
trusted fun tagBufferTarget(storage: NativeBuffer,cache: int,ways: int,line: int,address: int,bytes: int,small: bool): bool {
    val i=esp32S3TagPlan(false,32768,8,32,0x42000000,65536,false)
    val d=esp32S3TagPlan(true,cache,ways,line,address,bytes,small)
    esp32S3TagBufferInitOwned(storage,i,d)
}
