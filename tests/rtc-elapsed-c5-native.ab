import "../src/esp32/rtc_elapsed_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun c5RtcTimerRead(offset: int): int = 0
trusted fun c5RtcTimerWrite(offset: int,value: int): void { return }
@noinline
fun convert(ticks: int,period: int): int = rtc48MicrosecondsForTicks(ticks,period)
// Fixed expected values generated with arbitrary-precision integer arithmetic.
@export("abla_rtc_elapsed_c5_test")
fun test(): int {
    if (convert(0,1) != 0) return 1
    if (convert(0,524287) != 0) return 2
    if (convert(0,524288) != 0) return 3
    if (convert(0,524289) != 0) return 4
    if (convert(0,16000000) != 0) return 5
    if (convert(0,4294967295) != 0) return 6
    if (convert(1,1) != 0) return 7
    if (convert(1,524287) != 0) return 8
    if (convert(1,524288) != 1) return 9
    if (convert(1,524289) != 1) return 10
    if (convert(1,16000000) != 30) return 11
    if (convert(1,4294967295) != 8191) return 12
    if (convert(524287,1) != 0) return 13
    if (convert(524287,524287) != 524286) return 14
    if (convert(524287,524288) != 524287) return 15
    if (convert(524287,524289) != 524287) return 16
    if (convert(524287,16000000) != 15999969) return 17
    if (convert(524287,4294967295) != 4294959103) return 18
    if (convert(524288,1) != 1) return 19
    if (convert(524288,524287) != 524287) return 20
    if (convert(524288,524288) != 524288) return 21
    if (convert(524288,524289) != 524289) return 22
    if (convert(524288,16000000) != 16000000) return 23
    if (convert(524288,4294967295) != 4294967295) return 24
    if (convert(524289,1) != 1) return 25
    if (convert(524289,524287) != 524287) return 26
    if (convert(524289,524288) != 524289) return 27
    if (convert(524289,524289) != 524290) return 28
    if (convert(524289,16000000) != 16000030) return 29
    if (convert(524289,4294967295) != 4294975486) return 30
    if (convert(4294967295,1) != 8191) return 31
    if (convert(4294967295,524287) != 4294959103) return 32
    if (convert(4294967295,524288) != 4294967295) return 33
    if (convert(4294967295,524289) != 4294975486) return 34
    if (convert(4294967295,16000000) != 131071999969) return 35
    if (convert(4294967295,4294967295) != 35184372072448) return 36
    if (convert(4294967296,1) != 8192) return 37
    if (convert(4294967296,524287) != 4294959104) return 38
    if (convert(4294967296,524288) != 4294967296) return 39
    if (convert(4294967296,524289) != 4294975488) return 40
    if (convert(4294967296,16000000) != 131072000000) return 41
    if (convert(4294967296,4294967295) != 35184372080640) return 42
    if (convert(140737488355327,1) != 268435455) return 43
    if (convert(140737488355327,524287) != 140737219919871) return 44
    if (convert(140737488355327,524288) != 140737488355327) return 45
    if (convert(140737488355327,524289) != 140737756790782) return 46
    if (convert(140737488355327,16000000) != 4294967295999969) return 47
    if (convert(140737488355327,4294967295) != 1152921504338403328) return 48
    if (convert(281474976710655,1) != 536870911) return 49
    if (convert(281474976710655,524287) != 281474439839743) return 50
    if (convert(281474976710655,524288) != 281474976710655) return 51
    if (convert(281474976710655,524289) != 281475513581566) return 52
    if (convert(281474976710655,16000000) != 8589934591999969) return 53
    if (convert(281474976710655,4294967295) != 2305843008676814848) return 54
    if (convert(-1,1) != -1 || convert(0x1000000000000,1) != -1 || convert(1,0) != -1 || convert(1,0x100000000) != -1) return 60
    if (esp32C5RtcElapsedMicroseconds(0xFFFFFFFFFFFF,3,524288) != 4 || esp32C5RtcElapsedMicroseconds(0,0,1) != 0 || esp32C5RtcElapsedMicroseconds(-1,0,1) != -1) return 61
    0
}
