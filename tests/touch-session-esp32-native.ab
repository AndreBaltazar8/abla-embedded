import "../src/esp32/touch/session_esp32_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val regs=nativeBufferAt(nativeStaticAllocate(4096),4096)
val original=nativeBufferAt(nativeStaticAllocate(4096),4096)
var reads=0
var writes=0
var drop=-1
var bad=false
var done=false
var sample=10
fun touchScanRead(address: int): u32 {
    reads=reads+1
    if (address == 0x3FF48884) return u32(regs.loadU32(0x884))|(if (done) u32(1024) else u32(0))
    if (address >= 0x3FF48870 && address <= 0x3FF48880 && (address&3) == 0) return u32((sample<<16)|sample)
    if (address >= 0x3FF48000 && address < 0x3FF49000 && (address&3) == 0) return u32(regs.loadU32(address-0x3FF48000))
    bad=true; u32(0)
}
fun touchScanWrite(address: int,value: u32): void {
    val n=writes; writes=writes+1
    if (n == drop) return
    if (address == 0x3FF48410 || address == 0x3FF48414) {
        val prior=u32(regs.loadU32(0x40C))
        regs.storeU32(0x40C,int(if (address == 0x3FF48410) prior|value else prior&(u32(0xFFFFFFFF)^value)))
    } else if (address >= 0x3FF48000 && address < 0x3FF49000 && (address&3) == 0) {
        if (address == 0x3FF48884 && (value&u32(4096)) != u32(0)) done=false
        regs.storeU32(address-0x3FF48000,int(value))
    } else bad=true
    return
}
@export("abla_touch_session_esp32_test")
fun sessionTest(): i32 {
    val s=nativeBufferAt(nativeStaticAllocate(456),456)
    var variant=0
    while (variant < 6) {
        val mask=if (variant == 0) 144 else if (variant == 1) 256 else if (variant == 2) 512 else if (variant == 3) 768 else if (variant == 4) 1023 else 1
        var fault=-1
        while (fault < 88) {
            var offset=0
            while (offset < 4096) { regs.storeU32(offset,0); offset=offset+4 }
            regs.storeU32(0x40C,0xFFFFFFFF); regs.storeU32(0x858,0x12345678); regs.storeU32(0x884,0x12342800); regs.storeU32(0x490,0xA5A55A5A); regs.storeU32(0x88C,0x12345678)
            offset=0
            while (offset < 4096) { original.storeU32(offset,regs.loadU32(offset)); offset=offset+4 }
            s.storeU32(0,0); writes=0; reads=0; bad=false; done=false; drop=fault
            val opened=esp32TouchSessionOpenOwned(s,mask,255,40000,48,7,0,7,2,true)
            if (opened != 1 && opened != 4) return i32(1)
            if (fault == -1) {
                if (opened != 1 || esp32TouchSessionStartOwned(s) != 2) return i32(2)
                val count=writes
                if (esp32TouchSessionStartOwned(s) != 0 || esp32TouchSessionCloseOwned(s) != 2 || writes != count || esp32TouchSessionRead(s,4,true) != -1) return i32(3)
                sample=10; done=true
                if (esp32TouchSessionPollOwned(s) != 3) return i32(4)
                if (esp32TouchSessionStartOwned(s) != 2) return i32(5)
                sample=21; done=true
                if (esp32TouchSessionPollOwned(s) != 3 || esp32TouchSessionPollOwned(s) != 3) return i32(6)
                var ch=0
                while (ch < 10) {
                    if (esp32TouchSessionRead(s,ch,false) != (if ((mask&(1<<ch)) != 0) 21 else -1) ||
                        esp32TouchSessionRead(s,ch,true) != (if ((mask&(1<<ch)) != 0) 15 else -1)) return i32(7)
                    ch=ch+1
                }
                if (esp32TouchSessionStartOwned(s) != 2 || esp32TouchSessionDiscardCompletedOwned(s) != 2) return i32(14)
                sample=65000; done=true
                if (esp32TouchSessionDiscardCompletedOwned(s) != 1 || esp32TouchSessionDiscardCompletedOwned(s) != 0) return i32(15)
                ch=0
                while (ch < 10) {
                    if ((mask&(1<<ch)) != 0 && (s.loadU32(376+ch*4) != 21 || s.loadU32(416+ch*4) != 15)) return i32(16)
                    ch=ch+1
                }
                if (esp32TouchSessionStartOwned(s) != 2) return i32(17)
                sample=3; done=true
                if (esp32TouchSessionPollOwned(s) != 3) return i32(18)
                ch=0
                while (ch < 10) {
                    if ((mask&(1<<ch)) != 0 && esp32TouchSessionRead(s,ch,true) != 9) return i32(19)
                    ch=ch+1
                }
            }
            val closed=esp32TouchSessionCloseOwned(s)
            if (closed != 4 && closed != 5) return i32(8)
            if (closed == 4) {
                drop=-1
                if (esp32TouchSessionStartOwned(s) != 0 || esp32TouchSessionCloseOwned(s) != 5) return i32(9)
            }
            if (bad || s.loadU32(4) != 5) return i32(10)
            val count=writes
            if (esp32TouchSessionCloseOwned(s) != 5 || writes != count) return i32(11)
            offset=0
            while (offset < 4096) { if (regs.loadU32(offset) != original.loadU32(offset)) return i32(12); offset=offset+4 }
            fault=fault+1
        }
        variant=variant+1
    }
    reads=0; writes=0
    if (esp32TouchSessionOpenOwned(s,1024,255,40000,48,7,0,7,2,true) != 0 ||
        esp32TouchSessionOpenOwned(s,144,255,40000,48,7,0,7,2,false) != 0 || reads != 0 || writes != 0) return i32(13)
    i32(0)
}
