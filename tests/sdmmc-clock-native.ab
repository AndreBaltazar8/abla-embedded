import "../src/sd/mmc_clock_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var clocks=0
var divs=0
var sources=0
var command=0
var events=0
var writes=0
var drop=0
trusted fun sdMmcS3Read(offset: int): int = if (offset == 16) clocks else if (offset == 8) divs else if (offset == 12) sources else if (offset == 44) command else if (offset == 68) events else 0
trusted fun sdMmcS3Write(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 16) clocks=value
    if (offset == 8) divs=value
    if (offset == 12) sources=value
    if (offset == 44) command=value
    if (offset == 68) events=events&~value
    return
}
@export("abla_sdmmc_clock_test")
trusted fun test(): i32 {
    var slot=0
    while (slot < 2) {
        var divider=0
        while (divider < 256) {
            clocks=0xa5000000|(1<<slot); sources=4; divs=0x12345678; command=0; events=0x10001; writes=0
            var state=sdMmcClockStartOwned(slot,divider,true,true)
            if (state.status() != 2 || state.phase() != 1 || (clocks&(1<<slot)) != 0 || command != (0xa0202000|(slot<<16)) || state.pollOwned() != state) return i32(1)
            command=command&0x7fffffff; state=state.pollOwned()
            if (state.status() != 2 || state.phase() != 2 || divs != ((0x12345678&~(255<<(slot*8)))|(divider<<(slot*8))) || sources != 4) return i32(2)
            command=command&0x7fffffff; state=state.pollOwned()
            if (state.phase() != 3 || clocks != (0xa5000000|(1<<slot)|(1<<(16+slot)))) return i32(3)
            command=command&0x7fffffff; state=state.pollOwned()
            if (state.status() != 1 || events != 0x10001) return i32(4)
            divider=divider+1
        }
        slot=slot+1
    }
    clocks=1; sources=0; command=0; writes=0
    if (sdMmcClockStartOwned(1,10,true,true).status() != 2) return i32(5)
    command=0; clocks=2; sources=0; writes=0
    if (sdMmcClockStartOwned(0,10,true,true).status() != 4 || writes != 0) return i32(6)
    clocks=1; sources=4; command=0; events=0; writes=0; drop=2
    if (sdMmcClockStartOwned(0,10,true,true).status() != 5) return i32(7)
    drop=0; clocks=0; command=0; events=0
    var state=sdMmcClockStartOwned(0,10,true,true)
    events=4096|1
    state=state.pollOwned()
    if (state.status() != 5 || !state.hardwareLocked() || events != 1) return i32(8)
    if (sdMmcClockStartOwned(2,1,true,true).status() != 3 || sdMmcClockStartOwned(0,256,true,true).status() != 3) return i32(9)
    return i32(0)
}
