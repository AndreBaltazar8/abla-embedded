import "../src/m5stack/tab5_touch_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
fun tab5TouchPrepare(bus: int): int = 0
fun tab5TouchFirmware(handle: int): I2cByteResult = I2cByteResult(0)
fun tab5TouchGtAck(bus: int): bool = false
@export("abla_tab5_touch_profile_test")
fun testProfile(): i32 {
    var version=0
    while (version < 256) {
        var status=0
        while (status < 7) {
            val probe=M5Tab5TouchProbe((version<<8)|status)
            val st=(status == 1 && version == 1) || (status == 2 && version == 3)
            val p=m5BoardTab5.touchProfileFromProbe(probe)
            if (p.valid() != st || (st && (p.kind() != 6 || p.address() != 85 || p.rawWidth() != 720 || p.rawHeight() != 1280))) return i32(1)
            val q=m5BoardTab5X.touchProfileFromProbe(probe,true)
            if (q.valid() != (st || status == 3) || (q.valid() && (q.sdaNumber() != 31 || q.sclNumber() != 32 || q.interruptNumber() != 23 || q.port() != 1))) return i32(2)
            if (status == 3 && q.kind() != 2) return i32(3)
            if (m5BoardAtomVoice.touchProfileFromProbe(probe,true).valid()) return i32(4)
            status=status+1
        }
        version=version+1
    }
    i32(0)
}
