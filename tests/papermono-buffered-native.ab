import "../src/led/paper_mono_state.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/runtime/memory32.ab"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type M5Pm1 = int
type M5Ioe1 = int
type I2cDevice = int
fun M5Pm1.valid(): bool = this != 0
fun M5Ioe1.valid(): bool = this != 0
fun M5Pm1.device(): I2cDevice = I2cDevice(this & 4294967295)
var writes = 0
var failAt = 0
var bad = false
val state = nativeStaticMutableU32s([0,0,0,0])
fun I2cDevice.updateRegister8(reg: int, mask: int, value: int): bool = reg == 19 && mask == 32 && value == 0
fun M5Ioe1.setDirection(pin: int, output: bool): bool = (pin == 8 || pin == 9) && output
fun M5Ioe1.setHighImpedance(pin: int, enabled: bool): bool = (pin == 8 || pin == 9) && !enabled
trusted fun M5Pm1.setLedEnableLevel(high: bool): bool { writes = writes + 1; if (writes != 1 || !high) bad = true; writes != failAt }
trusted fun M5Ioe1.digitalWrite(pin: int, high: bool): bool { writes = writes + 1; if (pin != writes + 6 || high != (pin == 8)) bad = true; writes != failAt }
trusted fun M5Ioe1.setPwmDuty12(channel: int, duty: int, inverted: bool, enabled: bool): bool { writes = writes + 1; if (writes != 4 || channel != 1 || duty != 4095 || inverted || !enabled) bad = true; writes != failAt }
trusted fun paperMonoBufferedTest(): int {
    if (paperMonoLedAt(-1, M5Pm1(1), M5Ioe1(1)).valid() ||
        paperMonoLedAt(4097, M5Pm1(1), M5Ioe1(1)).valid() ||
        paperMonoLedAt(4294967284, M5Pm1(1), M5Ioe1(1)).valid() ||
        PaperMonoLed(0).power().valid() || PaperMonoLed(0).io().valid()) return 5
    val led = paperMonoLedAt(state, M5Pm1(1), M5Ioe1(1))
    if (!led.valid() || led.display() || writes != 0 || !led.begin()) return 1
    led.setAutoDisplay(false)
    if (!led.setBrightness(255) || !led.setAllColor(rgbColor(255, 255, 0)) || writes != 0) return 2
    while (failAt <= 4) {
        writes = 0
        // Existing API attempts all channel writes, even if an earlier fails.
        if (led.display() != (failAt == 0) || writes != 4 || bad) return 3
        failAt = failAt + 1
    }
    if (led.setBrightness(256) || led.storeColor(1, rgbColor(0,0,0))) return 4
    0
}
#exportFunction("paperMonoBufferedTest", "abla_papermono_buffered_test")
