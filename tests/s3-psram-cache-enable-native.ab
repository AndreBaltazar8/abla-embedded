import "../src/esp32/psram/cache_enable_s3_sequence.ab"
import "abla/build"
var ceInstruction=false
var ceControl=0
var ceAutoload=0
var ceReads=0
var ceWrites=0
var ceBad=false
fun s3PsramCacheMappingRead(address: int): int {
    ceReads=ceReads+1
    if (ceReads == 1 && ceWrites == 0 && address == (if (ceInstruction) 0x600c4060 else 0x600c4000)) return ceControl
    if (ceReads == 2 && ceWrites == 1 && address == (if (ceInstruction) 0x600c40a0 else 0x600c404c)) return ceAutoload
    ceBad=true;return 0
}
fun s3PsramCacheMappingWrite(address: int,value: int): void {
    ceWrites=ceWrites+1
    if (ceWrites == 1 && ceReads == 1 && address == (if (ceInstruction) 0x600c4060 else 0x600c4000) && value == (ceControl|1)) ceControl=value
    else if (ceWrites == 2 && ceReads == 2 && address == (if (ceInstruction) 0x600c40a0 else 0x600c404c) && value == (ceAutoload|4)) ceAutoload=value
    else ceBad=true
    return
}
@export("abla_s3_psram_cache_enable_test")
fun testCacheEnable(): int {
    var profile=0
    while (profile < 256) {
        var token=0
        while (token < 256) {
            ceInstruction=(profile&1) != 0
            val beforeControl=(profile*65537)^0xa55a5aa5
            val beforeAutoload=(profile*16777217)^0x5aa5a55a
            ceControl=beforeControl;ceAutoload=beforeAutoload;ceReads=0;ceWrites=0;ceBad=false
            s3PsramCacheEnableNativeOwned(ceInstruction,token|0xffff0000)
            val count=if ((token&4) != 0) 2 else 1
            if (ceBad || ceReads != count || ceWrites != count || ceControl != (beforeControl|1) ||
                ceAutoload != (beforeAutoload|(token&4))) return 1
            token=token+1
        }
        profile=profile+1
    }
    return 0
}
