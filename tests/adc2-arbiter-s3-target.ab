import "../src/esp32/adc2_arbiter_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc2_arbiter_s3_target")
trusted fun target(open: bool,mode: int,exclusive: bool,hertz: int,token: int): int = if (open) esp32S3Adc2ArbiterOpenOwned(mode,exclusive,hertz).bits() else Esp32S3Adc2Arbiter(token).closeOwned().bits()
