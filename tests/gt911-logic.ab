import "../src/touch/gt911_logic.ab"
fun main(): int {
    var status = 0
    while (status < 256) {
        val expected = if (status < 128) -2 else if ((status & 15) <= 5) status & 15 else -3
        if (gt911ReadyCount(status) != expected) return 1
        status = status + 1
    }
    if (gt911ReadyCount(-1) != -3 || gt911ReadyCount(256) != -3) return 2
    val point = gt911PointValues(255, 65535, 65534, 65533)
    if (!point.valid() || point.id() != 255 || point.x() != 65535 || point.y() != 65534 ||
        point.size() != 65533 || point.event() != 2) return 3
    if (gt911PointValues(256, 0, 0, 0).valid() || gt911PointValues(0, 65536, 0, 0).valid() ||
        gt911PointValues(0, 0, 0, -1).valid()) return 4
    0
}
