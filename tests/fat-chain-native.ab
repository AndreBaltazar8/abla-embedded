import "../src/storage/fat_chain.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1564)
var calls=0
var failure=0
var mode=0
var bad=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,sector: int,destination: NativeBuffer): bool {
    calls=calls+1
    if (sector != 101) bad=true
    var index=0
    while (index < 512) { destination.store(index,0); index=index+1 }
    // FAT16:2->3->4->EOC; variations exercise every failure class.
    destination.store(4,if (mode == 1) 2 else if (mode == 3) 0 else 3)
    destination.store(6,4)
    if (mode == 2) destination.store(8,3)
    else if (mode == 4) { destination.store(8,247); destination.store(9,255) }
    else { destination.store(8,255); destination.store(9,255) }
    return calls != failure
}
@export("abla_fat_chain_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(storage,512)
    val reader=nativeBufferAt(storage+512,28)
    val scratch=nativeBufferAt(storage+540,1024)
    var i=0
    while (i < 512) { boot.store(i,0); i=i+1 }
    boot.store(12,2); boot.store(13,1); boot.store(14,1); boot.store(16,2); boot.store(18,2)
    boot.store(22,40); boot.store(19,129); boot.store(20,39) //10113 total
    boot.store(510,85); boot.store(511,170)
    val result=fatChainValidateOwned(reader,boot,100,10113,2,3,scratch)
    if (result.status() != 1 || result.clusterCount() != 3 || calls != 3 || bad) return i32(1)
    calls=0
    if (fatChainValidateOwned(reader,boot,100,10113,2,2,scratch).status() != 6 || calls != 2) return i32(2)
    mode=1; calls=0
    if (fatChainValidateOwned(reader,boot,100,10113,2,100,scratch).status() != 5 || calls != 1) return i32(3)
    mode=2; calls=0
    if (fatChainValidateOwned(reader,boot,100,10113,2,100,scratch).status() != 5 || calls > 6) return i32(4)
    mode=3; calls=0
    if (fatChainValidateOwned(reader,boot,100,10113,2,100,scratch).linkError() != 3 || calls != 1) return i32(5)
    mode=4; calls=0
    if (fatChainValidateOwned(reader,boot,100,10113,2,100,scratch).linkError() != 4 || calls != 3) return i32(6)
    mode=0; failure=2; calls=0
    if (fatChainValidateOwned(reader,boot,100,10113,2,100,scratch).status() != 3 || calls != 2) return i32(7)
    calls=0
    if (fatChainValidateOwned(reader,boot,100,10113,0,100,scratch).status() != 2 || fatChainValidateOwned(reader,boot,100,10113,2,0,scratch).status() != 2 || calls != 0 || bad) return i32(8)
    // FAT12 straddle must not spend two physical reads with budget one.
    boot.store(16,1); boot.store(22,3); boot.store(19,12); boot.store(20,4)
    if (fatChainValidateOwned(reader,boot,100,1036,341,1,scratch).status() != 6 || calls != 0) return i32(9)
    return i32(0)
}
