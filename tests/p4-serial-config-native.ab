import "../src/esp32/uart/config_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var divider=0xff0ff000
var clock=0xabcd0000
var framing=0xffffffc0
var update=0
var busy=0
var writes=0
var drop=0
var timeout=false
var selected=0
var bad=false
fun p4SerialRead(unit: int,offset: int): int {
    if (unit != selected) bad=true
    if (offset == 20) return divider
    if (offset == 32) return framing
    if (offset == 152) return update
    if (offset == 12 || offset == 28 || offset == 112) return if (offset == busy) 1 else 0
    bad=true; return 0
}
fun p4SerialConfigWrite(unit: int,offset: int,value: int): void {
    writes=writes+1
    if (unit != selected) bad=true
    if (writes == drop) return
    if (offset == 20) divider=value else if (offset == 32) framing=value else if (offset == 152) update=if (timeout) 1 else 0 else bad=true
    return
}
fun p4SerialClockRead(unit: int): int { if (unit != selected) bad=true; return clock }
fun p4SerialClockWrite(unit: int,value: int): void { writes=writes+1; if (unit != selected) bad=true; if (writes != drop) clock=value; return }
fun p4SerialWriteFifo(unit: int,value: int): void { bad=true; return }
@export("abla_p4_serial_config_test")
fun testConfig(): i32 {
    while (selected < 5) {
        var bits=5
        while (bits <= 8) {
            var parity=0
            while (parity < 3) {
                var stop=1
                while (stop <= 3) {
                    writes=0
                    if (serial(selected).configureOwned(40000000,115200,bits,parity,stop,3) != 1 || writes != 4 ||
                        (framing&63) != (((bits-5)<<2)|(stop<<4)|(if (parity == 1) 3 else if (parity == 2) 2 else 0)) ||
                        (divider&0xff0ff000) != 0xff0ff000 || (clock&0xffffff00) != 0xabcd0000 || bad) return i32(1)
                    stop=stop+1
                }
                parity=parity+1
            }
            bits=bits+1
        }
        selected=selected+1
    }
    selected=0; drop=1
    while (drop <= 3) {
        divider=0; clock=0; framing=0; writes=0
        // Low baud forces a nonzero RCC prescaler, exposing dropped write2.
        if (serial(0).configureOwned(40000000,100,8,0,1,3) != 4 || writes != drop) return i32(2)
        drop=drop+1
    }
    drop=0; timeout=true; writes=0
    if (serial(0).configureOwned(40000000,115200,8,0,1,3) != 5 || writes != 4) return i32(3)
    timeout=false; update=0; busy=12; writes=0
    if (serial(0).configureOwned(40000000,115200,8,0,1,3) != 3 || writes != 0) return i32(4)
    if (p4SerialBaudPlan(40000000,0) != 0 || p4SerialBaudPlan(40000000,40000001) != 0 || p4SerialBaudPlan(4294967295,1) != 0) return i32(5)
    if (p4SerialBaudPlan(4294967295,1000000) == 0 || bad) return i32(6)
    return i32(0)
}
