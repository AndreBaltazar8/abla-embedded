import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/display/software_lcd.ab"
import "../src/m5stack/display_software.ab"
import "../src/m5stack/cores3_display_software.ab"
import "../src/display/mipi_programs.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_shared_lcd_test")
trusted fun sharedLcdTargetTest(gateAddress: u32, operation: i32, dataAddress: u32, capacity: i32): int {
    val lcd = m5BoardStackCoreS3.softwareDisplay()
    val gate = peripheralGateAt(int(gateAddress))
    val geometry = m5BoardStackCoreS3.displayGeometry()
    if (operation == i32(0)) return lcd.configurePins(gate, u32(7)).status()
    if (operation == i32(1)) return m5BoardStackCoreS3.beginCoreS3SoftwareDisplay(gate, u32(7), int(capacity), 1).status()
    if (operation == i32(2)) return lcd.fillRect(gate, u32(7), geometry.view(0),
        0, 0, 320, 240, rgb565Red, 1).status()
    if (operation == i32(3)) return lcd.blitRgb565(gate, u32(7), geometry.view(0),
        0, 0, nativeBufferAt(int(dataAddress), int(capacity)), 320, 240, 640, false, 1).status()
    3
}
