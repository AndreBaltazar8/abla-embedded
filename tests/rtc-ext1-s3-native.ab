import "../src/esp32/rtc_wake_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var stage=0
var remaining=0
var pendingHold=0
var selected=0
var level=0
var hold=false
var usb=0
var reads=0
var bad=false
fun esp32S3RtcWakeRead(address: int): int {
    reads=reads+1
    if (address != 0x60038018) bad=true
    usb
}
fun esp32S3RtcWakeUpdate(address: int,mask: int,value: int): void {
    if (stage == 0) {
        if (address != 0x60008904 || mask != 0x80000000 || value != mask) bad=true
        stage=1
    } else if (pendingHold != 0) {
        if (address != 0x600080D8 || mask != pendingHold || value != mask) bad=true
        pendingHold=0
    } else if (remaining != 0) {
        var pin=0
        while ((remaining & (1<<pin)) == 0) pin=pin+1
        if (address != 0x60008484+pin*4 || mask != 0xE2000 || value != 0x82000) bad=true
        remaining=remaining & ~(1<<pin)
        if (hold) pendingHold=1<<pin
    } else if (stage == 1) {
        if (address != 0x600080E0 || mask != 0x400000 || value != mask) bad=true
        stage=2
    } else if (stage == 2) {
        if (address != 0x600080E0 || mask != 0x3FFFFF || value != selected) bad=true
        stage=3
    } else if (stage == 3) {
        if (address != 0x60008064 || mask != 0x80000000 || value != level<<31) bad=true
        stage=4
    } else bad=true
    return
}
@export("abla_rtc_ext1_s3_test")
trusted fun ext1Test(): i32 {
    var pattern=0
    while (pattern < 28) {
        selected=if (pattern < 22) 1<<pattern else if (pattern == 22) 0x3FFFFF else if (pattern == 23) 0x155555 else if (pattern == 24) 0 else if (pattern == 25) -1 else if (pattern == 26) 1<<22 else 1<<40
        level=-1
        while (level <= 2) {
            var variant=0
            while (variant < 4) {
                hold=(variant & 1) != 0; usb=if (variant >= 2) 16384 else 0
                stage=0; reads=0; bad=false; remaining=selected; pendingHold=0
                val valid=pattern < 24 && level >= 0 && level <= 1
                val usbPin=(selected & 0x180000) != 0
                val accepted=valid && !(usbPin && usb != 0)
                val result=esp32S3PrepareExt1Owned(selected,level,hold)
                if (result != accepted || bad || stage != (if (accepted) 4 else 0) ||
                    reads != (if (valid && usbPin) 1 else 0) ||
                    (accepted && (remaining != 0 || pendingHold != 0))) return i32(1)
                variant=variant+1
            }
            level=level+1
        }
        pattern=pattern+1
    }
    i32(0)
}
