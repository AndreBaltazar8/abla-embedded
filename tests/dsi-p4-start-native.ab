import "../src/esp32/dsi_start_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(256)
var bridge=u32(0)
var writes=0
var bridgeWrites=0
var reads=0
var mode=0
var bad=false
trusted fun p4DsiRead(offset: int): u32 {
    reads=reads+1
    if (offset == 176) return u32(if (mode == 1) 0 else 149)
    if (offset == 116) return u32(21)
    if (offset == 188) return u32(if (mode == 2) 1 else 0)
    return u32(nativeBufferAt(storage,256).loadU32(offset))
}
trusted fun p4DsiWrite(offset: int,value: u32): void {
    writes=writes+1
    nativeBufferAt(storage,256).storeU32(offset,int(value))
    return
}
fun p4DsiBridgeRead(offset: int): u32 { reads=reads+1; if (offset != 4) bad=true; return bridge }
fun p4DsiBridgeWrite(offset: int,value: u32): void {
    if (offset != 4 || value != u32(if (bridgeWrites == 0) 2 else 0)) bad=true
    bridgeWrites=bridgeWrites+1
    bridge=if (mode == 3) u32(2) else value
    return
}
trusted fun clear(): void {
    var i=0
    while (i < 256) { nativeBufferAt(storage,256).store(i,0); i=i+1 }
    bridge=u32(0); writes=0; bridgeWrites=0; reads=0
    return
}
@export("abla_dsi_p4_start_test")
trusted fun testStart(): i32 {
    var profile=0
    while (profile < 32) {
        clear()
        val version=if ((profile&1) == 0) 1 else 3
        val lanes=1+((profile>>>1)&1)
        val channel=(profile>>>2)&3
        val result=esp32P4DsiStartDigitalOwned(version,lanes,40000,900000,channel,(profile&16) != 0,3)
        if (!result.hostComplete() || !result.digitalOwned() || result.enqueued() || writes != 58 ||
            bridgeWrites != (if (version == 3) 2 else 0) || bad) return i32(1)
        if (p4DsiRead(48) != u32(channel) || (p4DsiRead(164)&u32(3)) != u32(lanes-1)) return i32(2)
        writes=0; bridgeWrites=0
        val busy=esp32P4DsiStartDigitalOwned(version,lanes,40000,900000,channel,false,3)
        if (busy.status() != 13 || busy.digitalOwned() || writes != 0 || bridgeWrites != 0) return i32(3)
        profile=profile+1
    }
    mode=1
    while (mode <= 3) {
        clear()
        val result=esp32P4DsiStartDigitalOwned(3,2,40000,900000,0,false,3)
        if (result.status() != (if (mode == 1) 14 else if (mode == 2) 4 else 15) || !result.digitalOwned() ||
            writes != (if (mode == 3) 7 else 42)) return i32(4)
        if (mode == 2 && result.errors0() != 1) return i32(5)
        mode=mode+1
    }
    mode=0; clear(); bridge=u32(1)
    if (esp32P4DsiStartDigitalOwned(3,2,40000,900000,0,false,3).status() != 13 || writes != 0 || bridgeWrites != 0) return i32(6)
    clear()
    if (esp32P4DsiStartDigitalOwned(2,2,40000,900000,0,false,3).status() != 2 ||
        esp32P4DsiStartDigitalOwned(3,2,40000,159000,0,false,3).status() != 2 || reads != 0 || writes != 0 || bad) return i32(7)
    i32(0)
}
