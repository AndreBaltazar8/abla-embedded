import "../src/display/it8951_software.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 0 && this <= 4
fun Pin.outputCapable(): bool = this == 0 || this == 1 || this == 3
var active=false
var clockHigh=false
var output=false
var bits=0
var transmitted=0
var words=0
var frames=0
var bad=false
var delays=0
var operation=0
val memory=nativeStaticAllocate(8)
fun expectedWord(index: int): int =
    if (operation == 0) (if (index == 0) 4096 else 0)
    else if (index == 0) 24576 else if (index == 1) 33 else if (index == 2) 0 else if (index == 3) 0x1234 else if (index == 4) 0xabcd else 65535
trusted fun Pin.write(high: bool): void {
    if (this == 3) {
        if (bits != 0 || clockHigh) bad=true
        if (!high) { if (active) bad=true;frames=frames+1 }
        active=!high;return
    }
    if (this == 1) { if (clockHigh) bad=true;output=high;return }
    if (this != 0 || !active || high == clockHigh) { bad=true;return }
    clockHigh=high
    if (high) { transmitted=(transmitted<<1)|(if (output) 1 else 0);bits=bits+1 }
    else if (bits == 16) {
        if (transmitted != expectedWord(words) || frames != (if (operation == 1 && words >= 2) 2 else 1)) bad=true
        words=words+1;bits=0;transmitted=0
    }
    return
}
trusted fun Pin.read(): bool {
    if (this == 4) return true
    if (this != 2 || !active || !clockHigh || bits < 1 || bits > 16) { bad=true;return false }
    val value=if (words == 2) 0x1234 else if (words == 3) 0xabcd else 65535
    (value&(1<<(16-bits))) != 0
}
fun peripheralDelayMicroseconds(us: int): void {
    if (us != 1) bad=true
    delays=delays+1;return
}
@export("abla_it8951_software_test")
trusted fun testSoftware(): i32 {
    val bus=it8951Software(pin(0),pin(1),pin(2),pin(3),pin(4),1)
    if (!bus.valid()) return i32(1)
    val scratch=nativeBufferAt(memory,8)
    scratch.storeU16(6,0xbeef)
    val read=it8951ReadWords(bus|0,scratch,3,3)
    if (!read.success() || read.completed() != 3 || words != 5 || frames != 1 || active || bits != 0 || bad || delays != 160 ||
        scratch.loadU16(0) != 0x1234 || scratch.loadU16(2) != 0xabcd || scratch.loadU16(4) != 65535 || scratch.loadU16(6) != 0xbeef) return i32(2)
    operation=1;words=0;frames=0;delays=0
    val write=it8951Command(bus|0,33,scratch,3,3)
    if (!write.success() || write.completed() != 3 || words != 6 || frames != 2 || active || bits != 0 || bad || delays != 192) return i32(3)
    val before=words
    var bit=56
    while (bit < 64) {
        val invalid=It8951Software((bus|0)|(1<<bit))
        if (invalid.valid() || it8951ReadWords(invalid|0,scratch,3,3).status() != 2) return i32(4)
        bit=bit+1
    }
    if (it8951Software(pin(0),pin(1),pin(2),pin(3),pin(4),0).valid() ||
        it8951Software(pin(0),pin(1),pin(2),pin(3),pin(3),1).valid() ||
        it8951Software(pin(0),pin(1),pin(-1),pin(3),pin(4),1).valid() ||
        it8951Software(pin(2),pin(1),pin(0),pin(3),pin(4),1).valid() || words != before || bad) return i32(5)
    i32(0)
}
