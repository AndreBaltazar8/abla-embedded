import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/sd/software_register.ab"
import "abla/runtime/scalar"
import "abla/build"
// Compile-only CoreS3 shared SPI wiring; caller performs power/pad setup and
// supplies the canonical bus gate. This is not a flashable standalone image.
trusted fun sdS3Target(gateAddress: u32, bufferAddress: u32, state: i32, block: u32, operation: i32): int {
    val gate = peripheralGateAt(int(gateAddress))
    val buffer = nativeBufferAt(int(bufferAddress), 512)
    if (state == i32(0)) {
        val result = softwareSdInitialize(gate, u32(7), Pin(36), Pin(37), Pin(35), Pin(4), buffer)
        return result.status() | (if (result.highCapacity()) 65536 else 0) | (if (result.version2()) 131072 else 0)
    }
    if (operation == i32(2) || operation == i32(3)) {
        val result = softwareSdReadRegister(gate, u32(7), Pin(36), Pin(37), Pin(35), Pin(4), SoftwareSdInitResult(int(state)), if (operation == i32(2)) 9 else 10, buffer)
        if (!result.valid()) return -result.status()
        return if (operation == i32(2)) sdCsdBlockCount(buffer) else 1
    }
    if (operation == i32(1)) return softwareSdWriteBlock(gate, u32(7), Pin(36), Pin(37), Pin(35), Pin(4), SoftwareSdInitResult(int(state)), int(block), buffer).status()
    softwareSdReadBlock(gate, u32(7), Pin(36), Pin(37), Pin(35), Pin(4), SoftwareSdInitResult(int(state)), int(block), buffer).status()
}
#exportFunction("sdS3Target", "abla_s3_sd_test")
