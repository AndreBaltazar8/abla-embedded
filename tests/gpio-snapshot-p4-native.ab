import "../src/esp32/gpio/snapshot_p4_sequence.ab"
var pin=0
var held=false
var route=0
var mux=0
var config=0
var lp=0
var enable=0
var latch=0
var writes=0
var fail=0
var bad=false
trusted fun p4GpioHoldRead(address: int): u32 = if (held) u32(0xffffffff) else u32(0)
trusted fun p4GpioHoldWrite(address: int,value: u32): void { bad=true;return }
trusted fun p4PinSnapshotRead(address: int): int {
    if (address == 0x500e0000+(if (pin < 32) 32 else 44)) return enable
    if (address == 0x500e0000+(if (pin < 32) 4 else 16)) return latch
    if (address == 0x500e0558+pin*4) return route
    if (address == 0x500e1004+pin*4) return mux
    if (address == 0x500e0074+pin*4) return config
    if (pin < 16 && address == 0x5012b008+pin*4) return lp
    bad=true;return 0
}
trusted fun p4PinSnapshotWrite(address: int,value: int): void {
    writes=writes+1
    val bit=int(u32(1)<<u32(pin&31))
    val en=0x500e0000+(if (pin < 32) 32 else 44)
    val out=0x500e0000+(if (pin < 32) 8 else 20)
    val broken=writes == fail
    if (address == en+8) {
        if (value != bit) bad=true
        enable=if (broken) enable|bit else enable&(0xffffffff ^ bit);return
    }
    if (address == en+4) {
        if (value != bit) bad=true
        enable=if (broken) enable&(0xffffffff ^ bit) else enable|bit;return
    }
    if (address == out || address == out+4) {
        if (value != bit) bad=true
        latch=if ((address == out) != broken) latch|bit else latch&(0xffffffff ^ bit);return
    }
    if (address == 0x500e0558+pin*4) { route=if (broken) value ^ 1024 else value;return }
    if (address == 0x500e1004+pin*4) { mux=if (broken) value ^ 2 else value;return }
    if (address == 0x500e0074+pin*4) { config=if (broken) value ^ 4 else value;return }
    if (pin < 16 && address == 0x5012b008+pin*4) { lp=if (broken) value ^ 16 else value;return }
    bad=true;return
}
trusted fun temporary(): void {
    route=0xabcd0000;mux=0xffff0000;config=0x12345670;lp=0x98765420
    enable=0xffffffff;latch=0xffffffff;writes=0;bad=false
    return
}
@export("abla_gpio_snapshot_p4_test")
trusted fun test(): i32 {
    var layout=1
    while (layout <= 3) {
        pin=0
        while (pin <= 54) {
            var variant=0
            while (variant < 32) {
                val bit=int(u32(1)<<u32(pin&31))
                route=if ((variant&1) != 0) 4095 else 123
                mux=if ((variant&2) != 0) 29570 else 4096
                config=if ((variant&4) != 0) 4 else 0
                enable=if ((variant&8) != 0) bit else 0
                latch=if ((variant&16) != 0) bit else 0
                lp=if ((variant&1) != 0) 16 else 0
                val savedRoute=route;val savedMux=mux;val savedConfig=config;val savedEnable=enable;val savedLatch=latch;val savedLp=lp
                writes=0
                val saved=esp32p4GpioSnapshotOwned(pin,layout,true)
                if (!saved.valid() || saved.pin() != pin || writes != 0) return i32(1)
                temporary();fail=0
                if (saved.restoreOwned(true) != 1 || bad || route != (0xabcd0000|savedRoute) ||
                    mux != (0xffff0000|savedMux) || config != (0x12345670|savedConfig) ||
                    (enable&bit) != savedEnable || (latch&bit) != savedLatch ||
                    (enable&(0xffffffff ^ bit)) != (0xffffffff ^ bit) ||
                    (latch&(0xffffffff ^ bit)) != (0xffffffff ^ bit) ||
                    (pin < 16 && lp != (0x98765420|savedLp))) return i32(2)
                val total=writes
                var fault=1
                while (fault <= total) {
                    temporary();fail=fault
                    if (saved.restoreOwned(true) != 4 || writes != fault || bad) return i32(3)
                    fail=0
                    if (saved.restoreOwned(true) != 1 || bad) return i32(4)
                    fault=fault+1
                }
                writes=0;held=true
                if (esp32p4GpioSnapshotOwned(pin,layout,true).valid() || saved.restoreOwned(true) != 3 || writes != 0) return i32(5)
                held=false
                if (saved.restoreOwned(false) != 3 || writes != 0) return i32(6)
                variant=variant+1
            }
            pin=pin+1
        }
        layout=layout+2
    }
    if (esp32p4GpioSnapshotOwned(55,3,true).valid() || esp32p4GpioSnapshotOwned(0,2,true).valid() || P4GpioSnapshot(0).restoreOwned(true) != 2) return i32(7)
    return i32(0)
}
