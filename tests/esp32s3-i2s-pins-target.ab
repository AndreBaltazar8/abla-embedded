import "../src/esp32/i2s/pins_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun i2sPinsTarget(port: i32, transmit: bool, flags: i32): bool =
    esp32s3I2sRoutePins(int(port), transmit, pin(0), pin(34), pin(33), pin(if (transmit) 13 else 14), int(flags))
#exportFunction("i2sPinsTarget", "abla_s3_i2s_pins_test")
