import "../src/power/axp192_logic.ab"

fun main: int {
    val voltageCodes = axp192DcdcCode(0, 127) == -1 &&
        axp192DcdcCode(3300, 127) == 104 &&
        axp192DcdcCode(5000, 63) == 63 &&
        axp192LdoCode(1700) == -1 && axp192LdoCode(3300) == 15
    val chargeCodes = axp192ChargeCurrentCode(100) == 0 &&
        axp192ChargeCurrentCode(190) == 1 &&
        axp192ChargeCurrentCode(1319) == 14 &&
        axp192ChargeCurrentCode(1320) == 15 &&
        axp192ChargeVoltageCode(4099) == 0 &&
        axp192ChargeVoltageCode(4150) == 1 &&
        axp192ChargeVoltageCode(4200) == 2 &&
        axp192ChargeVoltageCode(5000) == 3
    val adcPacking = axp192Register12(43788) == 2748 &&
        axp192Register13(4623) == 591
    val levels = axp192BatteryLevel(3151, 0) == 12 &&
        axp192BatteryLevel(4000, 0) == 100 &&
        axp192BatteryLevel(2800, 0) == 2 &&
        axp192BatteryLevel(2800, 17) == 0
    if (voltageCodes && chargeCodes && adcPacking && levels) 53 else 1
}
