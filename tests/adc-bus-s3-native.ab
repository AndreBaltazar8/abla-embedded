import "../src/esp32/adc_bus_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var a=0
var b=0
var c=0
var busy=0
var writes=0
var drop=0
var bad=false
fun esp32S3AdcBusRead(address: int): int {
    if (address == 0x60008034) return a
    if (address == 0x6000e044) return b
    if (address == 0x6000e048) return c
    if (address == 0x60008840) return if (busy == 1) 0x400000 else 0
    if (address == 0x6000880c) return if (busy == 2) 0x20000 else 0
    if (address == 0x60008830) return if (busy == 3) 0x20000 else 0
    bad=true; return 0
}
fun esp32S3AdcBusWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x60008034) a=value
    else if (address == 0x6000e044) b=value
    else if (address == 0x6000e048) c=value
    else bad=true
    return
}
fun reset(state: int): void {
    a=0xa50000aa|(if ((state&1) != 0) 0x400000 else 0)
    b=0xa50000aa|(if ((state&2) != 0) 0x40000 else 0)
    c=0xa50000aa|(if ((state&4) != 0) 0x10000 else 0)
    writes=0; drop=0; busy=0; return
}
@export("abla_adc_bus_s3_test")
fun test(): i32 {
    var initial=0
    while (initial < 8) {
        reset(initial)
        val rejected=esp32S3AdcBusOpenOwned(false)
        if (rejected.status() != (if (initial == 5) 1 else 2) || writes != 0) return i32(1)
        reset(initial)
        var token=esp32S3AdcBusOpenOwned(true)
        val changes=writes
        if (!token.ready() || esp32S3AdcBusState() != 5 || bad) return i32(2)
        token=token.closeOwned()
        if (token.status() != 0 || esp32S3AdcBusState() != initial || writes != changes*2) return i32(3)
        if ((a&0xffbfffff) != 0xa50000aa || (b&0xfffbffff) != 0xa50000aa || (c&0xfffeffff) != 0xa50000aa) return i32(4)
        var failed=1
        while (failed <= changes) {
            reset(initial); drop=failed
            token=esp32S3AdcBusOpenOwned(true)
            if (token.status() != 3 || writes != failed) return i32(5)
            drop=0; token=token.closeOwned()
            if (token.status() != 0 || esp32S3AdcBusState() != initial) return i32(6)
            reset(initial); token=esp32S3AdcBusOpenOwned(true); writes=0; drop=failed
            token=token.closeOwned()
            if (token.status() != 3 || writes != failed) return i32(7)
            drop=0; token=token.closeOwned()
            if (token.status() != 0 || esp32S3AdcBusState() != initial) return i32(8)
            failed=failed+1
        }
        initial=initial+1
    }
    reset(2)
    var token=esp32S3AdcBusOpenOwned(true)
    busy=1; writes=0
    while (busy <= 3) {
        token=token.closeOwned()
        if (token.status() != 4 || writes != 0) return i32(9)
        busy=busy+1
    }
    busy=0
    if (token.closeOwned().status() != 0) return i32(10)
    reset(5); token=esp32S3AdcBusOpenOwned(false); a=a^0x400000
    if (token.closeOwned().status() != 5 || writes != 0 || bad) return i32(11)
    return i32(0)
}
