import "../src/esp32/power/sleep_wake_route_p4_sequence.ab"
import "../src/esp32/power/sleep_marker_p4_sequence.ab"
import "abla/build"
val routeStorage=nativeStaticAllocate(28)
var routeHart=u32(0)
var routeValue=u32(0)
var routeWrites=0
var routeDrop=0
var routeFences=0
fun p4WakeRouteHart(): u32 = routeHart
fun p4WakeRouteRead(): u32 = routeValue
fun p4WakeRouteWrite(value: u32): void {
    routeWrites=routeWrites+1
    if (routeWrites != routeDrop) routeValue=value
    return
}
fun p4WakeRouteFence(): void { routeFences=routeFences+1;return }
fun p4SleepMarkerRead(): u32 = routeValue
fun p4SleepMarkerWrite(value: u32): void { routeValue=value;return }
fun routeSeed(bits: int): NativeBuffer {
    val r=nativeBufferAt(routeStorage,28)
    var i=0
    while (i < 28) { r.storeU32(i,0);i=i+4 }
    r.storeU32(24,0x1234abcd)
    routeHart=u32(0);routeValue=u32(0x4ff01234|bits);routeWrites=0;routeDrop=0;routeFences=0
    return r
}
@export("abla_sleep_wake_route_p4_test")
fun test(): int {
    var combination=0
    while (combination < 24) {
        val bits=combination&3
        val hart=(combination>>>2)&1
        val failure=combination/8
        val r=routeSeed(bits);routeHart=u32(hart);routeDrop=failure
        var opened=esp32p4SleepWakeRouteOpenOwned(r,0x4ff08000,true)
        if (failure == 1) {
            if (opened != 4 || routeValue != u32(0x4ff01234|bits)) return 1
            opened=esp32p4SleepWakeRouteContinueOwned(r,true)
        }
        if (opened != 1 || routeValue != u32(0x4ff08000|bits)) return 2
        val writes=routeWrites
        if (esp32p4SleepWakeRouteOpenOwned(r,0x4ff08000,true) != 2 || routeWrites != writes) return 3
        routeHart=u32(1-hart)
        if (esp32p4SleepWakeRouteCloseOwned(r,true) != 3 || routeWrites != writes) return 4
        routeHart=u32(hart)
        // Actual mode lease shares STORE8; independent pointer owner preserves it.
        var marker=esp32p4SleepMarkerOpenOwned((bits&1) == 0,true)
        if (marker.status() != 1 || routeValue != u32(0x4ff08000|(bits^1))) return 5
        if (esp32p4SleepWakeRouteCloseOwned(r,false) != 2 || routeWrites != writes) return 6
        var closed=esp32p4SleepWakeRouteCloseOwned(r,true)
        if (failure == 2) {
            if (closed != 4 || routeValue != u32(0x4ff08000|(bits^1))) return 7
            closed=esp32p4SleepWakeRouteContinueOwned(r,true)
        }
        if (closed != 5 || routeValue != u32(0x4ff01234|(bits^1))) return 8
        marker=marker.closeOwned(true)
        if (marker.status() != 4 || routeValue != u32(0x4ff01234|bits)) return 9
        if (esp32p4SleepWakeRouteCloseOwned(r,true) != 5 || r.loadU32(24) != 0x1234abcd) return 10
        combination=combination+1
    }
    val r=routeSeed(3);routeDrop=1
    if (esp32p4SleepWakeRouteOpenOwned(r,0x4ff08000,true) != 4) return 11
    if (esp32p4SleepWakeRouteCloseOwned(r,true) != 5 || routeWrites != 1 ||
        routeValue != u32(0x4ff01237)) return 12
    val conflict=routeSeed(0)
    if (esp32p4SleepWakeRouteOpenOwned(conflict,0x4ff08000,true) != 1) return 13
    routeValue=u32(0x4ff09001)
    if (esp32p4SleepWakeRouteCloseOwned(conflict,true) != 3 || routeWrites != 1 ||
        routeValue != u32(0x4ff09001)) return 14
    val invalid=routeSeed(0)
    if (esp32p4SleepWakeRouteOpenOwned(invalid,0,true) != 2 ||
        esp32p4SleepWakeRouteOpenOwned(invalid,0x4ff08002,true) != 2 ||
        esp32p4SleepWakeRouteOpenOwned(invalid,4294967296,true) != 2 ||
        esp32p4SleepWakeRouteOpenOwned(invalid,0x4ff08000,false) != 2 ||
        esp32p4SleepWakeRouteOpenOwned(nativeBufferAt(routeStorage,23),0x4ff08000,true) != 2 ||
        routeWrites != 0 || invalid.loadU32(0) != 0) return 15
    return 0
}
