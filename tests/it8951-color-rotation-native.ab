import "./it8951-color-native.ab"
import "../src/display/it8951_rotation.ab"
@export("abla_it8951_color_rotation_test")
trusted fun testColorRotation(): i32 {
    val source=nativeBufferAt(memory,384)
    val logical=nativeBufferAt(memory+384,384)
    val physical=nativeBufferAt(memory+768,384)
    val expected=nativeBufferAt(memory+1152,384)
    var differences=0
    var width=1
    while (width <= 9) {
        var height=1
        while (height <= 7) {
            var rotation=0
            while (rotation < 8) {
                val lw=if (rotation%2 == 0) width else height
                val lh=if (rotation%2 == 0) height else width
                var format=0
                while (format < 2) {
                    val pixelBytes=if (format == 0) 3 else 2
                    val ss=lw*pixelBytes+3;val ls=(lw+1)/2+2;val ps=(width+1)/2+2
                    var mode=0
                    while (mode < 4) {
                        var at=0
                        while (at < 384) {
                            source.store(at,(at*73+19)&255);logical.store(at,165);physical.store(at,165);expected.store(at,165);at=at+1
                        }
                        if (!it8951ConvertRgbForRotationOwned(source,ss,logical,ls,width,height,rotation,format == 1,mode >= 2,mode%2 == 1,true) ||
                            !it8951Rotate4Owned(logical,ls,physical,ps,width,height,rotation,true)) return i32(1)
                        var y=0
                        while (y < lh) {
                            var x=0
                            while (x < lw) {
                                val offset=y*ss+x*pixelBytes
                                var red=source.load(offset);var green=source.load(offset+1);var blue=0
                                if (format == 0) blue=source.load(offset+2)
                                else {
                                    val raw=red*256+green;val r=raw/2048;val g=(raw/32)%64;val b=raw%32
                                    red=r*8+r/4;green=g*4+g/16;blue=b*8+b/4
                                }
                                val mappedY=if (rotation >= 4) lh-1-y else y
                                val normal=oracle(red,green,blue,x,mappedY,mode >= 2)
                                if (normal != oracle(red,green,blue,x,y,mode >= 2)) differences=differences+1
                                val value=if (mode%2 == 1) 15-normal else normal
                                val position=epdCanvasPosition(width,height,x,y,rotation)
                                val px=position&65535;val py=position>>>16
                                val target=py*ps+px/2;val old=expected.load(target)
                                expected.store(target,if (px%2 == 0) value*16+old%16 else (old/16)*16+value)
                                x=x+1
                            }
                            y=y+1
                        }
                        at=0
                        while (at < 384) { if (physical.load(at) != expected.load(at)) return i32(2);at=at+1 }
                        mode=mode+1
                    }
                    format=format+1
                }
                rotation=rotation+1
            }
            height=height+1
        }
        width=width+1
    }
    if (differences == 0) return i32(3)
    if (it8951ConvertRgbForRotationOwned(source,30,logical,10,9,7,8,false,false,false,true) ||
        it8951ConvertRgbForRotationOwned(source,30,logical,10,9,7,4,false,false,false,false)) return i32(4)
    i32(0)
}
