import "../src/esp32/spi/transmit_transaction_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun spiTransmitTransactionTarget(gateAddress: u32, source: u32, bytes: u32): int =
    esp32s3SpiTransmitTransaction(peripheralGateAt(int(gateAddress)), u32(41),
        2, spiPins(37,35,36), Pin(4), nativeBufferAt(int(source), int(bytes)), int(bytes), 100000)
#exportFunction("spiTransmitTransactionTarget", "abla_s3_spi_transmit_transaction_test")
