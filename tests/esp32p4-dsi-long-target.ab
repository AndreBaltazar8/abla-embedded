import "../src/esp32/dsi_long_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_long_target")
trusted fun target(channel: int,dataType: int,payload: NativeBuffer,length: int,polls: int): DsiCommandResult =
    esp32P4DsiLongWrite(channel,dataType,payload,length,polls)
