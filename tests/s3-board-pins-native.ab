    if (board14.powerHoldPin() != M5BoardId(21).powerHoldPin()) return i32(14)
    if (board14.buttonASource() != M5BoardId(21).buttonASource()) return i32(14)
    if (board14.buttonBSource() != M5BoardId(21).buttonBSource()) return i32(14)
    if (board14.buttonCSource() != M5BoardId(21).buttonCSource()) return i32(14)
    if (board14.buttonExtSource() != M5BoardId(21).buttonExtSource()) return i32(14)
    if (board14.buttonPowerSource() != M5BoardId(21).buttonPowerSource()) return i32(14)
    var position14=-1
    while (position14 <= 32) { if (board14.mBusPin(position14) != M5BoardId(21).mBusPin(position14)) return i32(14);position14=position14+1 }
    if (m5CardputerADV().buttonA().number() != m5BoardCardputerADV.buttonA().number() || m5StampPLC().buttonA().number() != -1) return i32(15)
    return i32(0)
}
