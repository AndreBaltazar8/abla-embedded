import "../src/esp32/power/sleep_cache_p4_sequence.ab"
import "../src/esp32/power/sleep_request_p4_sequence.ab"
import "../src/esp32/power/sleep_resume_p4_sequence.ab"
var resumeTesting=false
var efuseReads=0
var efuseDelay=0
var efuseState=0
trusted fun p4SleepResumeEfuseStatus(): u32 {
    if (!resumeTesting || pmuWrites != 1 || fences != 1) bad=true
    efuseReads=efuseReads+1
    return u32(0xfffffff0)|(if (efuseReads > efuseDelay) u32(efuseState) else u32(0))
}
var address=u32(123)
var size=u32(456)
var map=u32(32)
var command=u32(0)
var writes=0
var drop=0
var commands=0
var reads=0
var delay=0
var timeoutPass=0
var fences=0
var bad=false
var pmuWrites=0
var wakeEnabled=true
var stale=u32(0)
var result=u32(0)
var eventReads=0
var eventDelay=0
trusted fun p4SleepRequestRead(offset: int): u32 {
    if (offset == 296) return if (wakeEnabled) u32(4096) else u32(0)
    if (offset == 356) {
        if (pmuWrites != 2) return stale
        eventReads=eventReads+1
        return if (eventReads > eventDelay) result else u32(0)
    }
    bad=true;return u32(0)
}
trusted fun p4SleepRequestWrite(offset: int,value: u32): void {
    if (resumeTesting) {
        if (offset != 228 || value != u32(0x08000000) || fences != 0 || pmuWrites != 0) bad=true
        pmuWrites=pmuWrites+1;return
    }
    if (commands != 2 || command != u32(16)) bad=true
    if (pmuWrites == 0) {
        if (offset != 228 || value != u32(0x04000000) || fences != 2) bad=true
    } else if (pmuWrites == 1) {
        if (offset != 288 || value != u32(0x80000000) || fences != 3) bad=true
    } else bad=true
    pmuWrites=pmuWrites+1;return
}
trusted fun p4SleepCacheRead(offset: int): u32 {
    if (offset == 160) return address
    if (offset == 164) return size
    if (offset == 156) return map
    if (offset == 152) {
        if (command == u32(4) && commands != 0) {
            reads=reads+1
            if (commands != timeoutPass && reads > delay) command=u32(16)
        }
        return command
    }
    bad=true;return u32(0)
}
trusted fun p4SleepCacheWrite(offset: int,value: u32): void {
    writes=writes+1;if (writes == drop) return
    if (offset == 160) { address=value;return }
    if (offset == 164) { size=value;return }
    if (offset == 156) { map=value;return }
    if (offset == 152) {
        if (value != u32(4) || address != u32(0) || size != u32(0) || map != u32(16) || fences != 1) bad=true
        command=value;commands=commands+1;reads=0;return
    }
    bad=true;return
}
trusted fun p4SleepCacheFence(): void { fences=fences+1;return }
trusted fun seed(): void {
    resumeTesting=false;efuseReads=0;efuseDelay=0;efuseState=0
    pmuWrites=0;wakeEnabled=true;stale=u32(0);result=u32(0);eventReads=0;eventDelay=0
    address=u32(123);size=u32(456);map=u32(32);command=u32(0);writes=0;drop=0;commands=0;reads=0;delay=0;timeoutPass=0;fences=0;bad=false;return
}
@export("abla_sleep_cache_p4_test")
trusted fun test(): i32 {
    var lag=0
    while (lag < 4) {
        seed();delay=lag
        if (esp32p4SleepCacheWritebackOwned(lag+1,true) != 1 || commands != 2 || fences != 2 || bad) return i32(1)
        lag=lag+1
    }
    var fault=1
    while (fault <= 3) {
        seed();drop=fault
        if (esp32p4SleepCacheWritebackOwned(4,true) != 4 || commands != 0 || bad) return i32(2)
        fault=fault+1
    }
    fault=1
    while (fault <= 2) {
        seed();timeoutPass=fault
        if (esp32p4SleepCacheWritebackOwned(4,true) != 5 || commands != fault || reads != 4 || fences != 1 || bad) return i32(3)
        fault=fault+1
    }
    seed();command=u32(4)
    if (esp32p4SleepCacheWritebackOwned(4,true) != 3 || writes != 0 || fences != 0) return i32(4)
    seed()
    if (esp32p4SleepCacheWritebackOwned(0,true) != 2 || esp32p4SleepCacheWritebackOwned(1000001,true) != 2 ||
        esp32p4SleepCacheWritebackOwned(4,false) != 2 || writes != 0 || fences != 0) return i32(5)
    var event=1
    while (event <= 3) {
        seed();result=u32(event)<<u32(30);eventDelay=3
        if (esp32p4SleepRequestPreparedOwned(4,4,true) != (if (event == 1) 2 else if (event == 2) 1 else 3) ||
            pmuWrites != 2 || eventReads != 4 || bad) return i32(6)
        event=event+1
    }
    seed();eventDelay=4;result=u32(0x80000000)
    if (esp32p4SleepRequestPreparedOwned(4,4,true) != 7 || eventReads != 4 || pmuWrites != 2 || bad) return i32(7)
    seed();stale=u32(0x40000000)
    if (esp32p4SleepRequestPreparedOwned(4,4,true) != 5 || writes != 0 || pmuWrites != 0) return i32(8)
    seed();wakeEnabled=false
    if (esp32p4SleepRequestPreparedOwned(4,4,true) != 4 || writes != 0 || pmuWrites != 0) return i32(9)
    seed();timeoutPass=2
    if (esp32p4SleepRequestPreparedOwned(4,4,true) != (6|(5<<8)) || pmuWrites != 0 || bad) return i32(10)
    seed()
    if (esp32p4SleepRequestPreparedOwned(4,0,true) != 4 || esp32p4SleepRequestPreparedOwned(4,4,false) != 4 || writes != 0 || pmuWrites != 0) return i32(11)
    event=1
    while (event <= 3) {
        var state=0
        while (state < 16) {
            seed();resumeTesting=true;stale=u32(event)<<u32(30);efuseState=state;efuseDelay=3
            val expected=if (state != 1) 6 else if (event == 1) 2 else if (event == 2) 1 else 3
            if (esp32p4SleepLightResumeBarrierOwned(4,true) != expected || efuseReads != 4 || pmuWrites != 1 ||
                fences != (if (state == 1) 2 else 1) || bad) return i32(12)
            state=state+1
        }
        event=event+1
    }
    seed();resumeTesting=true
    if (esp32p4SleepLightResumeBarrierOwned(4,true) != 5 || pmuWrites != 0 || efuseReads != 0 || fences != 0) return i32(13)
    stale=u32(0x80000000)
    if (esp32p4SleepLightResumeBarrierOwned(0,true) != 4 || esp32p4SleepLightResumeBarrierOwned(4,false) != 4 || pmuWrites != 0 || efuseReads != 0) return i32(14)
    return i32(0)
}
