import "../src/esp32/power/sleep_timing_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_timing_c5_test")
trusted fun test(): i32 {
    val output=nativeBufferAt(nativeStaticAllocate(60),60)
    var mode=0
    while (mode < 8) {
        val deep=(mode&1) != 0;val xtal=(mode&2) != 0
        var slow=3000000
        while (slow < 18000000) {
            var fast=12000
            while (fast < 80000) {
                val minimum=if ((mode&4) != 0) 3500000 else slow
                var valid=true;var index=0
                while (index < 14) {
                    val us=if (index < 2) 450 else if (index == 2) 154 else if (index == 3) (if (deep) 500 else 154)
                        else if (index < 8) 2 else if (index < 12) 1 else if (index == 12) 250 else 50
                    val period=if (index < 2) minimum else if (index == 3 || (index == 12 && xtal)) slow else fast
                    val limit=if (index == 2 || index >= 12) 65535 else if (index >= 4 && index <= 6) 511 else if (index == 7) 127 else 255
                    if ((us*524288)/period > limit) valid=false
                    output.storeU32(index*4,0xdeadbeef);index=index+1
                }
                output.storeU32(56,0x12345678)
                if (esp32C5SleepTimingCalibrated(output,slow,fast,deep,xtal,if ((mode&4) != 0) minimum else 0) != valid) return i32(1)
                index=0
                while (index < 14) {
                    val wanted=if (!valid) 0xdeadbeef else
                        (c5SleepTimingMicroseconds(index,deep)*524288)/c5SleepTimingPeriod(index,slow,fast,minimum,xtal)
                    if (output.loadU32(index*4) != wanted) return i32(2)
                    index=index+1
                }
                if (output.loadU32(56) != 0x12345678) return i32(3)
                fast=fast+7919
            }
            slow=slow+314159
        }
        mode=mode+1
    }
    if (esp32C5SleepTimingCalibrated(output,0,30000,false,false) ||
        esp32C5SleepTimingCalibrated(output,3500000,0,false,false) ||
        esp32C5SleepTimingCalibrated(output,3500000,30000,false,false,-1) ||
        esp32C5SleepTimingCalibrated(nativeBufferAt(output.addressValue(),55),3500000,30000,false,false)) return i32(4)
    return i32(0)
}
