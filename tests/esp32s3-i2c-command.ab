import "../src/esp32/i2c/fifo_esp32s3.ab"

trusted fun main(): int {
    if (esp32S3I2cCommand(6, 0) != u32(12288)) return 1
    if (esp32S3I2cCommand(1, 2, true) != u32(2306)) return 2
    if (esp32S3I2cCommand(3, 1, false, false, true) != u32(7169)) return 3
    if (esp32S3I2cCommand(2, 0) != u32(4096) || esp32S3I2cCommand(4, 0) != u32(8192)) return 4
    var count = -1
    while (count <= 256) {
        if (esp32S3I2cCommandValid(esp32S3I2cCommand(1, count, true)) != (count >= 1 && count <= 255)) return 5
        if (esp32S3I2cCommandValid(esp32S3I2cCommand(3, count)) != (count >= 1 && count <= 255)) return 6
        count = count + 1
    }
    if (esp32S3I2cCommandValid(u32(0x80003000)) || esp32S3I2cCommandValid(u32(0xffffffff))) return 7
    if (esp32S3I2cCommandValid(esp32S3I2cCommand(6, 0, true))) return 8
    if (esp32S3I2cTxCount(u32(32) << u32(18)) != 32 || esp32S3I2cRxCount(u32(31) << u32(8)) != 31) return 9
    val empty = nativeBufferAt(0, 0)
    if (esp32S3I2cWriteFifo(0, empty, 1) || esp32S3I2cReadFifo(0, empty, 1)) return 10
    if (!esp32S3I2cWriteFifo(0, empty, 0) || !esp32S3I2cReadFifo(0, empty, 0)) return 11
    if (esp32S3I2cResetFifos(2) || esp32S3I2cWriteCommand(0, 8, u32(8192))) return 12
    if (esp32S3I2cWriteCommand(0, 0, u32(0xffffffff))) return 13
    0
}
