import "./nesso-display-controls-native.ab"
import "../src/m5stack/nesso_display_orientation_sequence.ab"
var controlStatus=1
var controlCalls=0
var previousConfig=0
var wantedRotation=0
var wantedBgr=false
var wantedFlag=false
fun controlCheck(): int {
    reentryCheck()
    val display=nessoDisplayAt(nativeBufferAt(displayStorage,40))
    if (display.buffer().loadU32(24) != previousConfig ||
        display.setRotationOwned(1,true,true) || display.setInvertedOwned(true,true) || display.setIdleOwned(true,true)) bad=true
    controlCalls=controlCalls+1;return (controlStatus<<32)|171
}
fun nessoDisplaySetPanelRotation(gate: PeripheralGate,owner: u32,rotation: int,bgr: bool): int {
    if (rotation != wantedRotation || bgr != wantedBgr) bad=true
    return controlCheck()
}
fun nessoDisplaySetPanelInverted(gate: PeripheralGate,owner: u32,inverted: bool): int {
    if (inverted == wantedFlag) bad=true
    return controlCheck()
}
fun nessoDisplaySetPanelIdle(gate: PeripheralGate,owner: u32,idle: bool): int {
    if (idle != wantedFlag) bad=true
    return controlCheck()
}
@export("abla_nesso_display_orientation_test")
trusted fun testOrientation(): i32 {
    var config=0
    while (config < 64) {
        val display=openDisplay();controlCalls=0;controlStatus=1
        wantedRotation=config&7;wantedBgr=(config&8) != 0
        if (!display.setBrightnessOwned(config,true)) return i32(1)
        previousConfig=display.buffer().loadU32(24)
        if (!display.setRotationOwned(wantedRotation,wantedBgr,true) || display.rotation() != wantedRotation ||
            display.bgrOrder() != wantedBgr || display.brightness() != config || display.inverted() || display.idle()) return i32(2)
        wantedFlag=(config&16) != 0;previousConfig=display.buffer().loadU32(24)
        if (!display.setInvertedOwned(wantedFlag,true) || display.inverted() != wantedFlag || display.brightness() != config) return i32(3)
        wantedFlag=(config&32) != 0;previousConfig=display.buffer().loadU32(24)
        if (!display.setIdleOwned(wantedFlag,true) || display.idle() != wantedFlag || display.inverted() != ((config&16) != 0) ||
            display.rotation() != wantedRotation || display.bgrOrder() != wantedBgr || display.brightness() != config || controlCalls != 3 || bad) return i32(4)
        // Invalid/admission paths cannot emit commands or change geometry.
        previousConfig=display.buffer().loadU32(24)
        if (display.setRotationOwned(-1,true,true) || display.setRotationOwned(8,true,true) ||
            display.setRotationOwned(0,true,false) || display.setInvertedOwned(true,false) || display.setIdleOwned(true,false) ||
            controlCalls != 3 || display.buffer().loadU32(24) != previousConfig) return i32(5)
        if (!display.setSleepingOwned(true,130,true)) return i32(6)
        if (display.setRotationOwned(0,true,true) || display.setInvertedOwned(true,true) || display.setIdleOwned(true,true) || controlCalls != 3) return i32(7)
        expectedSleeping=false
        if (!display.setSleepingOwned(false,130,true) || display.buffer().loadU32(24) != previousConfig || !display.closeOwned(true) || owned || bad) return i32(8)
        config=config+1
    }
    var action=0
    while (action < 3) {
        var status=2
        while (status <= 6) {
            val display=openDisplay();controlCalls=0;controlStatus=status
            previousConfig=display.buffer().loadU32(24);wantedRotation=7;wantedBgr=false;wantedFlag=true
            val success=if (action == 0) display.setRotationOwned(7,false,true) else if (action == 1) display.setInvertedOwned(true,true) else display.setIdleOwned(true,true)
            if (success || display.phase() != 2 || display.failure() != 13 || display.buffer().loadU32(24) != previousConfig ||
                display.spiResult() != ((status<<32)|171) || controlCalls != 1 || !owned || bad) return i32(9)
            if (!display.closeOwned(true) || owned || bad) return i32(10)
            status=status+1
        }
        action=action+1
    }
    return i32(0)
}
