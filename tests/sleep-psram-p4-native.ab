import "../src/esp32/power/sleep_psram_p4_sequence.ab"
import "../src/esp32/psram/mapped_p4_sequence.ab"
var clock=0x125ad055
var holds=0xa400003f
var writes=0
var drop=0
var drained=false
var busy=false
var reset=0
var holdReads=0
var bad=false
trusted fun p4PsramClockRead(offset: int): int {
    if (offset == 48) return clock
    if (offset == 20) return 0x80000000
    if (offset == 192) return reset
    bad=true;return 0
}
trusted fun p4PsramClockWrite(offset: int,value: int): void {
    if (offset != 48 || !drained || (value&0xffff0fff) != (clock&0xffff0fff)) bad=true
    writes=writes+1;if (writes != drop) clock=value
    return
}
trusted fun p4PsramMappedRead(offset: int): int {
    if (offset == 4096 || offset == 0) return 0
    if (offset == 376) { if (!busy) drained=true;return if (busy) 0 else 0xfc000000 }
    bad=true;return 0
}
trusted fun p4PsramMappedWrite(offset: int,value: int): void { bad=true;return }
trusted fun p4SleepPsramHoldRead(): int { holdReads=holdReads+1;return holds }
trusted fun p4SleepPsramHoldWrite(value: int): void {
    if (!drained || (value&0xfc00003f) != (holds&0xfc00003f)) bad=true
    // Hold on XTAL; release only on fully restored MPLL/core/module clocks.
    if ((value&0x03ffffc0) == 0x03ffffc0) {
        if ((clock&0x3000) != 0) bad=true
    } else if ((clock&0xf000) != 0xd000) bad=true
    writes=writes+1;if (writes != drop) holds=value
    return
}
trusted fun seed(): void {
    clock=0x125ad055;holds=0xa400003f;writes=0;drop=0;drained=false;busy=false;reset=0;holdReads=0;bad=false;return
}
@export("abla_sleep_psram_p4_test")
trusted fun test(): i32 {
    var mode=0
    while (mode < 4) {
        val revision=if ((mode&1) == 0) 100 else 300
        val regdma=(mode&2) != 0
        val stages=1+(if (!regdma) 1 else 0)+(if (revision >= 300) 1 else 0)
        var fault=0
        while (fault <= stages) {
            seed();drop=fault
            val token=esp32p4SleepPsramParkOwned(revision,regdma,4,true)
            if (!token.hasSnapshot() || token.status() != (if (fault == 0) 1 else 5) || bad) return i32(1)
            val count=writes
            if (token.closeOwned(false,true) != token || writes != count) return i32(2)
            drop=0
            val closed=token.closeOwned(true,true)
            if (closed.status() != 6 || clock != 0x125ad055 || holds != 0xa400003f || bad || (revision < 300 && holdReads != 0)) return i32(3)
            val finalWrites=writes
            if (closed.closeOwned(true,true) != closed || writes != finalWrites) return i32(4)
            fault=fault+1
        }
        fault=1
        while (fault <= stages) {
            seed();val token=esp32p4SleepPsramParkOwned(revision,regdma,4,true)
            drop=writes+fault
            val failed=token.closeOwned(true,true)
            if (failed.status() != 5 || !failed.hasSnapshot() || bad) return i32(5)
            drop=0
            if (failed.closeOwned(true,true).status() != 6 || clock != 0x125ad055 || holds != 0xa400003f || bad) return i32(6)
            fault=fault+1
        }
        mode=mode+1
    }
    seed();busy=true
    if (esp32p4SleepPsramParkOwned(300,false,4,true).status() != 4 || writes != 0) return i32(7)
    seed();reset=0x02800000
    if (esp32p4SleepPsramParkOwned(300,false,4,true).status() != 3 || writes != 0) return i32(8)
    seed()
    if (esp32p4SleepPsramParkOwned(400,false,4,true).status() != 2 ||
        esp32p4SleepPsramParkOwned(300,false,0,true).status() != 2 ||
        esp32p4SleepPsramParkOwned(300,false,4,false).status() != 2 || writes != 0) return i32(9)
    return i32(0)
}
