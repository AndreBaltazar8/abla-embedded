import "../src/log_policy.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1)
var called=0
var failed=0
var bad=false
trusted fun logOutputOwned(target: int,level: int,color: bool,text: NativeBuffer,length: int,suffix: int): bool {
    called=called|(1<<target)
    if (length != 1 || text.load(0) != 65 || (level == 0 && color) || suffix < 0 || suffix > 2) bad=true
    return (failed&(1<<target)) == 0
}
@export("abla_log_policy_test")
trusted fun test(): i32 {
    val text=nativeBufferAt(storage,1)
    text.store(0,65)
    var levels=0
    while (levels < 216) {
        val a=levels%6
        val b=(levels/6)%6
        val c=levels/36
        val policy=logPolicy().configure(0,a,true,true,1).configure(1,b,false,true,0).configure(2,c,true,true,2)
        var level=0
        while (level <= 5) {
            val expected=(if (a >= level) 1 else 0)|(if (b >= level) 2 else 0)|(if (c >= level) 4 else 0)
            called=0
            val result=policy.writeOwned(level,text,1)
            if (!result.succeeded() || result.attempted() != expected || called != expected || bad) return i32(1)
            level=level+1
        }
        levels=levels+1
    }
    val all=logPolicy().configure(1,5,true,true,1).configure(2,5,true,true,2)
    failed=0
    while (failed < 8) {
        called=0
        val result=all.writeOwned(3,text,1)
        if (result.completed() != (7&~failed) || called != 7 || result.succeeded() != (failed == 0)) return i32(2)
        failed=failed+1
    }
    called=0
    if (all.writeOwned(6,text,1).valid() || all.writeOwned(1,text,2).valid() || called != 0) return i32(3)
    if (logPolicy().targets(0) != 1 || all.configure(3,1,true,true,1) != all || LogPolicy(7).valid() || all.configure(0,0,false,false,0).targets(0) != 6) return i32(4)
    return i32(0)
}
