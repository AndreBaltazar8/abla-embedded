import "../src/esp32/cache_cold_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(704)
var writes=0
var drop=0
var fences=0
var timeout=false
fun p4CacheGeometryRead(offset: int): int = nativeBufferAt(memory,704).loadU32(offset)
fun p4CacheColdWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes != drop) nativeBufferAt(memory,704).storeU32(offset,if (offset == 152 && !timeout) 16 else value)
    return
}
fun p4CacheColdFence(): void { fences=fences+1; return }
fun resetColdCache(): void {
    var offset=0
    while (offset < 704) { nativeBufferAt(memory,704).storeU32(offset,0); offset=offset+4 }
    nativeBufferAt(memory,704).storeU32(160,123); nativeBufferAt(memory,704).storeU32(164,456)
    var index=0
    while (index < 8) { nativeBufferAt(memory,704).storeU32(p4CacheColdWorkerOffset(index),2); index=index+1 }
    writes=0; fences=0; drop=0; timeout=false; return
}
@export("abla_p4_cache_cold_test")
fun coldCacheTest(): i32 {
    var layout=1
    while (layout <= 3) {
        var size=131072
        while (size <= 524288) {
            var line=64
            while (line <= 128) {
                resetColdCache()
                val address=if (layout == 1) 0x4ff10000 else 0x4ff80000
                if (p4CacheL2InitializeColdOwned(layout,size,line,address,0x18000,2) != 1 || writes != 6 || fences != 2 || !p4CacheL2GeometryMatches(line)) return i32(1)
                line=line*2
            }
            size=size*2
        }
        layout=layout+2
    }
    var failure=1
    while (failure <= 5) {
        resetColdCache(); drop=failure
        val expected=if (failure == 1) 4 else if (failure == 2) 5 else 6
        if (p4CacheL2InitializeColdOwned(3,524288,128,0x4ff80000,65536,2) != expected || fences != 1 || writes > 5) return i32(2)
        failure=failure+1
    }
    resetColdCache(); timeout=true
    if (p4CacheL2InitializeColdOwned(3,524288,128,0x4ff80000,65536,2) != 7 || writes != 6 || fences != 1) return i32(3)
    if (p4CacheL2InitializeColdOwned(3,524288,128,0x4ff80000,65536,2) != 3 || writes != 6) return i32(4)
    resetColdCache()
    if (p4CacheL2InitializeColdOwned(3,524288,128,0x4ff10000,65536,2) != 2 || writes != 0 || fences != 0) return i32(5)
    if (p4CacheSramSpanSafe(1,524288,0x4ff40000,1) || p4CacheSramSpanSafe(3,524288,0x4ffadfbf,2) ||
        !p4CacheSramSpanSafe(3,524288,0x4ffadfbf,1) || p4CacheSramSpanSafe(1,131072,0x4ff2bbcf,2) ||
        !p4CacheSramSpanSafe(1,131072,0x4ff40000,0x60000) || p4CacheSramSpanSafe(2,131072,0x4ff80000,1)) return i32(6)
    var index=0
    while (index < 8) {
        var state=0
        while (state < 4) {
            resetColdCache()
            val offset=p4CacheColdWorkerOffset(index)
            nativeBufferAt(memory,704).storeU32(offset,state)
            val result=p4CacheL2InitializeColdOwned(3,524288,128,0x4ff80000,65536,2)
            if (state == 2) { if (result != 1) return i32(7) }
            else if (result != (8|(offset<<8)) || writes != 0 || fences != 0) return i32(8)
            state=state+1
        }
        index=index+1
    }
    index=0
    while (index < 7) {
        val offset=if (index == 0) 136 else if (index == 1) 44 else if (index == 2) 652 else if (index == 3) 56 else if (index == 4) 72 else if (index == 5) 120 else 664
        val mask=if (index == 1) 0x50055 else if (index == 2) 0x500000 else 3
        var bit=1
        while (bit <= 0x400000) {
            if ((bit&mask) != 0) {
                resetColdCache(); nativeBufferAt(memory,704).storeU32(offset,bit)
                if (p4CacheL2InitializeColdOwned(3,524288,128,0x4ff80000,65536,2) != (8|(offset<<8)) || writes != 0 || fences != 0) return i32(9)
            }
            bit=bit<<1
        }
        index=index+1
    }
    return i32(0)
}
