import "../src/esp32/power/sleep_gpio_cycle_c5.ab"
import "../src/esp32/power/sleep_prepare_composition_c5.ab"
import "../src/esp32/power/sleep_entry_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(3072)
var timeHigh=u32(0)
var timeLow=u32(0)
var timeLoads=0
var preFault=0
var injected=false
var cleanupInjected=false
var cacheSuspends=0
trusted fun cycleAborting(): bool = nativeBufferAt(memory,792).loadU32(4) == 5
trusted fun esp32C5TimerRead(address: int): u32 {
    if (cycleRecovering() && (!clockReady || cacheResumes != 1 || regRead(2560,0x3c) != 0 || regRead(2560,0x13c) != 0)) bad=true
    if (address == 0x6009606c) return u32(if (preFault == 1) 0 else 5)
    if (address == 0x60096070) return u32(0x400000)
    if (address == 0x6000a004) return u32(0x20000000)
    if (address == 0x6000a040) return u32(0)
    if (address == 0x6000a044) return u32(1600)
    if (address == 0x6000a00c) return timeHigh
    if (address == 0x6000a010) return timeLow
    bad=true;return u32(0)
}
trusted fun esp32C5TimerWrite(address: int,value: u32): void {
    if (address == 0x6000a004) return
    if (address == 0x6000a00c) timeHigh=value
    else if (address == 0x6000a010) { if (fault == 6) { fault=0;return };timeLow=value }
    else if (address == 0x6000a05c) { if (value != u32(1)) bad=true;timeLoads=timeLoads+1 }
    else bad=true
    return
}
var fault=0
trusted fun cycleRecovering(): bool = nativeBufferAt(memory,792).loadU32(4) == 6
var bad=false
var clockReady=false
var cacheResumes=0
var predictorRestores=0
var flashDelay=0
var expectedResult=0
var expectedMHz=0
var rcGate=0
var modeStore=1
var requests=0
var efuseBusy=0
trusted fun c5SleepEntryRead(address: int): int {
    if (address == 0x600b1020) return modeStore
    if (address == 0x600b0068 && expectedResult == -2) return regRead(1024,0x68)|0x20000000
    if (address == 0x600b49d4) { if (efuseBusy > 0) { efuseBusy=efuseBusy-1;return 0 };return 1 }
    return regRead(1024,address-0x600b0000)
}
trusted fun c5SleepEntryWrite(address: int,value: int): void {
    if (address == 0x600b1020) { modeStore=value;return }
    val offset=address-0x600b0000
    if (offset == 0x12c && !cycleRecovering() && expectedResult == -3) return
    if (offset == 0x128 && cycleRecovering() && fault == 5) { fault=0;return }
    if (offset == 0x16c) regWrite(1024,0x160,regRead(1024,0x160)&~value)
    else if (offset == 0x134) regWrite(1024,0x148,0)
    else if (offset == 0x124) {
        if (value != 0x80000000 || expectedResult < 0) bad=true
        requests=requests+1;efuseBusy=3
        regWrite(2048,0x28,0xc0000000);regWrite(2048,0x14,20)
        regWrite(1024,0x160,if (expectedResult == 0) 0x80000000 else 0x40000000)
    } else regWrite(1024,offset,value)
    return
}
trusted fun regRead(bank: int,offset: int): int {
    if (offset < 0 || offset >= 512 || (offset&3) != 0) { bad=true;return 0 }
    nativeBufferAt(memory+bank,512).loadU32(offset)
}
trusted fun regWrite(bank: int,offset: int,value: int): void {
    if (offset < 0 || offset >= 512 || (offset&3) != 0) { bad=true;return }
    nativeBufferAt(memory+bank,512).storeU32(offset,value);return
}
trusted fun c5SleepPowerRead(offset: int): int = regRead(1024,offset)
trusted fun c5SleepPowerWrite(offset: int,value: int): void { regWrite(1024,offset,value);return }
trusted fun c5SleepDigitalRead(offset: int): int = regRead(1024,offset)
trusted fun c5SleepDigitalWrite(offset: int,value: int): void { regWrite(1024,offset,value);return }
trusted fun c5SleepAnalogRead(offset: int): int = regRead(1024,offset)
trusted fun c5SleepAnalogWrite(offset: int,value: int): void { regWrite(1024,offset,value);return }
trusted fun c5SleepTimingRead(offset: int): int = regRead(1024,offset)
trusted fun c5SleepTimingWrite(offset: int,value: int): void {
    if (preFault == 4 && !cycleAborting() && !injected && offset == 0x120) { injected=true;return }
    if (preFault == 7 && cycleAborting() && !cleanupInjected && offset == 0x120) { cleanupInjected=true;return }
    if (cycleRecovering() && fault == 1 && offset == 0x120) { fault=0;return }
    regWrite(1024,offset,value);return
}
trusted fun c5SleepEfuseRead(offset: int): int { bad=true;return 0 }
trusted fun c5CpuClockRead(offset: int): int = if (offset == 0x144) 0 else regRead(1536,offset)
trusted fun c5CpuClockWrite(offset: int,value: int): void {
    if (cycleAborting() && nativeBufferAt(memory+304,304).loadU32(0) != 0 && nativeBufferAt(memory+304,304).loadU32(4) != 4) bad=true
    if (preFault == 3 && !cycleAborting() && !injected && offset == 0x118) { injected=true;return }
    if (preFault == 9 && cycleAborting() && !cleanupInjected && offset == 0x118) { cleanupInjected=true;return }
    if (cycleRecovering() && nativeBufferAt(memory+304,304).loadU32(4) != 4) bad=true
    if (cycleRecovering() && offset == 0x118 && fault == 2) { fault=0;return }
    if (offset != 0x144) regWrite(1536,offset,value)
    return
}
trusted fun c5CpuClockTicks(mhz: int): void {
    val restoring=cycleRecovering() || cycleAborting() && nativeBufferAt(memory+192,48).loadU32(4) == 1
    if (mhz != (if (restoring) expectedMHz else 40)) bad=true
    clockReady=cycleRecovering();return
}
trusted fun c5ClockParkPvtActive(): bool { bad=true;return false }
trusted fun c5ClockParkPvt(record: NativeBuffer): int { bad=true;return 2 }
// These two paths must remain unused for XTAL/RC_FAST without PVT.
trusted fun c5ClockResumePll(record: NativeBuffer,limit: int): int { bad=true;return 3 }
trusted fun c5ClockResumePvt(record: NativeBuffer): int { bad=true;return 3 }
trusted fun c5ClockResumeRead(address: int): int = if (address == 0x600b00ac) regRead(1024,0xac) else if (address == 0x600b0420) rcGate else 0
trusted fun c5ClockResumeWrite(address: int,value: int): void {
    if (address == 0x600b00ac) regWrite(1024,0xac,value)
    else if (address == 0x600b0420) rcGate=value
    else bad=true
    return
}
trusted fun c5ClockResumeDelay(us: int): void { if (us != 50 && us != 5) bad=true;return }
trusted fun c5RtcTimerRead(offset: int): int = regRead(2048,offset)
trusted fun c5RtcTimerWrite(offset: int,value: int): void {
    if ((preFault == 5 || preFault == 8) && !cycleAborting() && !injected && offset == 0) { injected=true;return }
    if (preFault == 8 && cycleAborting() && !cleanupInjected && offset == 4) { cleanupInjected=true;return }
    if (offset == 0x34) {
        if (cycleRecovering() && !clockReady) bad=true
        if (cycleRecovering() && fault == 3) { fault=0;return }
        regWrite(2048,0x28,regRead(2048,0x28)&~value)
    } else if (offset == 4) regWrite(2048,offset,value&0x7fffffff)
    else regWrite(2048,offset,value)
    return
}
trusted fun c5SleepUartRead(address: int): int {
    if (address == 0x60096000 || address == 0x6009600c) {
        if (preFault == 10 && cycleAborting() && !cleanupInjected && address == 0x60096000) { cleanupInjected=true;return 0 }
        if (cycleRecovering() && cacheResumes != 1) bad=true
        if (cycleRecovering() && fault == 4 && address == 0x60096000) { fault=0;return 0 }
        return 1
    }
    if (address == 0x60096004 || address == 0x60096010) return 0x400000
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset == 0x98 || offset == 0x70) return 0
    return regRead(2560,port*256+offset)
}
trusted fun c5SleepUartWrite(address: int,value: int): void {
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset != 0x98) regWrite(2560,port*256+offset,value)
    return
}
trusted fun c5CachePredictorDisable(): int = 0x1030
trusted fun c5CacheRomSuspend(): int { cacheSuspends=cacheSuspends+1;return 0x80000001 }
trusted fun c5SleepFlashReadyDelay(us: int): void { if (!clockReady || us != 700) bad=true;flashDelay=flashDelay+1;return }
trusted fun c5CacheRomResume(saved: int): void {
    if (!clockReady || nativeBufferAt(memory+608,24).loadU32(4) != 6 || saved != 0x80000001 || flashDelay != 0) bad=true
    cacheResumes=cacheResumes+1;return
}
trusted fun c5CachePredictorRestore(saved: int): void { if (cacheResumes != 1 || saved != 0x1030) bad=true;predictorRestores=predictorRestores+1;return }

@export("abla_sleep_gpio_cycle_c5_test")
trusted fun test(): int {
    val cycle=nativeBufferAt(memory,792);val request=nativeBufferAt(memory+792,68)
    var mode=0
    while (mode < 96) {
        var failure=0
        while (failure < 7) {
            var i=0;while (i < 3072) { nativeBufferAt(memory,3072).storeU32(i,0);i=i+4 }
            timeHigh=u32(0);timeLow=u32(0);timeLoads=0;cacheSuspends=0
            bad=false;fault=failure;clockReady=false;cacheResumes=0;predictorRestores=0;flashDelay=0;rcGate=0
            gpioMode=mode/8
            val selected=mode%4
            expectedResult=if (selected == 0) -3 else if (selected == 1) -2 else if (selected == 2) 0 else 1
            val source=if (mode%8 < 4) 0 else 1;expectedMHz=if (source == 0) 20 else 10
            requests=0;modeStore=1;efuseBusy=0
            regWrite(1536,0x110,(40<<24)|(source<<16));regWrite(1536,0x118,1);regWrite(1536,0x11c,1)
            regWrite(2048,4,0x42);regWrite(2048,0,0x12345678)
            val cal=esp32C5SleepCalibrationDecode(u32(0x210),u32(0xffffffff),u32(1))
            request.storeU32(4,0x1234);request.storeU32(8,cal|0)
            request.storeU32(12,3500000);request.storeU32(16,30000)
            request.storeU32(24,117);request.storeU32(28,-1)
            request.storeU32(36,3);request.storeU32(40,2)
            request.storeU32(44,16);request.storeU32(48,1);request.storeU32(52,16);request.storeU32(60,16)
            val first=beginGpioCycle(cycle,request)
            if (first != 1 && first != 3 || bad) return 1
            if (gpioMode == 11) {
                if (first != 3 || requests != 0 || cacheResumes != 0 || cycle.loadU32(12) != 0xfffffffc ||
                    cacheSuspends != 1 || cycle.loadU32(4) != 7) return 21
                if (esp32C5SleepCycleContinueOwned(cycle,true) != 3 || cacheSuspends != 1 || requests != 0) return 22
                gpioInput=16
            }
            if (gpioEntryDrop) expectedResult=-3
            var done=esp32C5SleepCycleContinueOwned(cycle,true)
            var retries=0
            while (done == 3 && retries < 8) { done=esp32C5SleepCycleContinueOwned(cycle,true);retries=retries+1 }
            if (done != 1 || bad || gpioReg != gpioOriginal || regRead(1024,0x12c) != 0 ||
                nativeBufferAt(gpioMemory,36).loadU32(4) != 4) return 2
            if (int(i32(cycle.loadU32(12))) != expectedResult || requests != (if (expectedResult < 0) 0 else 1) ||
                cacheResumes != 1 || predictorRestores != 1 || flashDelay != 0 || efuseBusy != 0) return 3
            if (regRead(2560,0x3c) != 0 || regRead(2560,0x13c) != 0 || nativeBufferAt(memory+304,304).loadU32(4) != 4) return 4
            if (regRead(2048,0) != 0x12345678 || regRead(2048,4) != 0x42 ||
                regRead(1024,0x12c) != 0 || regRead(1024,0x128) != 0 || modeStore != 1) return 5
            if (nativeBufferAt(memory+152,40).loadU32(4) != 3 || timeLoads != (if (expectedResult == 0) 1 else 0) ||
                expectedResult == 0 && timeLow != u32(3728)) return 6
            if (esp32C5SleepCycleContinueOwned(cycle,true) != 1 || cacheResumes != 1 ||
                esp32C5SleepPrepareCancelOwned(nativeBufferAt(memory+112,192),true) != 2) return 7
            failure=failure+1
        }
        mode=mode+1
    }
    // Actual-component abort paths: capture, UART, park, profile, target,
    // deadline, and one-shot failures during each reverse cleanup phase.
    var source=0
    while (source < 2) {
        gpioMode=0
        preFault=1
        while (preFault <= 10) {
            var i=0;while (i < 3072) { nativeBufferAt(memory,3072).storeU32(i,0);i=i+4 }
            timeLoads=0;cacheSuspends=0;cacheResumes=0;predictorRestores=0;flashDelay=0
            bad=false;fault=0;injected=false;cleanupInjected=false;clockReady=false
            expectedResult=0;expectedMHz=if (source == 0) 20 else 10
            requests=0;modeStore=1;efuseBusy=0;rcGate=0
            regWrite(1536,0x110,(40<<24)|(source<<16));regWrite(1536,0x118,1);regWrite(1536,0x11c,1)
            regWrite(2048,4,0x42);regWrite(2048,0,0x12345678)
            if (preFault == 2) regWrite(2560,0x13c,0x20000)
            val cal=esp32C5SleepCalibrationDecode(u32(0x210),u32(0xffffffff),u32(1))
            request.storeU32(4,0x1234);request.storeU32(8,cal|0)
            request.storeU32(12,3500000);request.storeU32(16,30000);request.storeU32(24,117);request.storeU32(28,-1)
            request.storeU32(36,3);request.storeU32(40,2);request.storeU32(52,16);request.storeU32(60,16)
            if (preFault < 6 || preFault == 8) { request.storeU32(44,16);request.storeU32(48,1) }
            val first=beginGpioCycle(cycle,request)
            if ((first != 3 && first != 4) || bad) return 10
            if (esp32C5SleepCycleContinueOwned(cycle,true) != 4 || bad) return 11
            if (requests != 0 || cacheSuspends != 0 || cacheResumes != 0 || timeLoads != 0 ||
                int(i32(cycle.loadU32(12))) != -4 || cycle.loadU32(16) != (if (preFault <= 3) 1 else if (preFault == 4) 2 else 3)) return 12
            if (regRead(2560,0x3c) != 0 || regRead(2560,0x13c) != (if (preFault == 2) 0x20000 else 0) ||
                regRead(1536,0x118) != 1 || regRead(1536,0x11c) != 1 || (regRead(1536,0x110)&0x30000) != source<<16 ||
                regRead(2048,0) != 0x12345678 || regRead(2048,4) != 0x42) return 13
            if (preFault >= 7 && !cleanupInjected) return 14
            val stage=cycle.loadU32(16);val error=cycle.loadU32(20)
            if (esp32C5SleepCycleContinueOwned(cycle,true) != 4 || cycle.loadU32(16) != stage || cycle.loadU32(20) != error) return 15
            preFault=preFault+1
        }
        source=source+1
    }
    // Admission rejects unsupported domains and malformed requests without
    // claiming/mutating the session; this is not simulated successful sleep.
    preFault=0
    var invalid=0
    while (invalid < 18) {
        var i=0;while (i < 792) { cycle.store(i,0xa5);i=i+1 };cycle.storeU32(0,0)
        val offset=if (invalid < 5) 0 else if (invalid == 5) 8 else if (invalid == 6) 12 else if (invalid == 7) 16 else
            if (invalid == 8) 24 else if (invalid == 9) 28 else if (invalid == 10) 32 else if (invalid == 11) 36 else
            if (invalid == 12) 40 else if (invalid == 13) 48 else if (invalid == 14) 56 else if (invalid == 15) 52 else if (invalid == 16) 60 else 64
        val value=if (invalid == 0) 1 else if (invalid == 1) 4 else if (invalid == 2) 8 else if (invalid == 3) 16 else if (invalid == 4) 1024 else
            if (invalid == 5) 0x10000000 else if (invalid == 8) -2 else if (invalid == 9) 32 else if (invalid == 10) 16 else if (invalid == 11) 4 else
            if (invalid == 13) 65536 else if (invalid == 14) 32768 else if (invalid == 17) 0x80000000 else 0
        val old=request.loadU32(offset);request.storeU32(offset,value)
        if (beginGpioCycle(cycle,request) != 2 || cycle.loadU32(0) != 0) return 16
        i=4;while (i < 792) { if (cycle.load(i) != 0xa5) return 17;i=i+1 }
        request.storeU32(offset,old);invalid=invalid+1
    }
    return 0
}

val gpioMemory=nativeStaticAllocate(36)
var gpioReg=0
var gpioOriginal=0
var gpioInput=16
var gpioWrites=0
var gpioMode=0
var gpioEntryDrop=false
fun c5GpioWakeRead(address: int): int {
    if (cacheSuspends != 1) bad=true
    if (address == 0x600b012c) return regRead(1024,0x12c)
    if (address == 0x60091064) return gpioInput
    if (address != 0x600910e4) bad=true
    return gpioReg
}
fun c5GpioWakeWrite(address: int,value: int): void {
    if (cacheSuspends != 1) bad=true
    gpioWrites=gpioWrites+1
    val before=if (address == 0x600b012c) regRead(1024,0x12c) else gpioReg
    if (gpioWrites == gpioMode && gpioMode < 11 && before != value) {
        if (cacheResumes == 0) gpioEntryDrop=true
        return
    }
    if (address == 0x600b012c) {
        if (((before^value)&~4) != 0) bad=true
        regWrite(1024,0x12c,value)
    } else {
        if (address != 0x600910e4 || (regRead(1024,0x12c)&4) != 0 || ((value^gpioOriginal)&~0x780) != 0) bad=true
        gpioReg=value
    }
    if (cacheResumes != 0 && nativeBufferAt(memory+152,40).loadU32(4) != 3) bad=true
    return
}
trusted fun beginGpioCycle(cycle: NativeBuffer,request: NativeBuffer): int {
    val context=nativeBufferAt(gpioMemory,36)
    var offset=0;while (offset < 36) { context.storeU32(offset,0);offset=offset+4 }
    gpioReg=0xa5a01f84;gpioOriginal=gpioReg;gpioInput=if (gpioMode == 11) 0 else 16
    gpioWrites=0;gpioEntryDrop=false
    // Keep malformed zero wake-mask admission tests malformed.
    if (request.loadU32(60) != 0) request.storeU32(60,request.loadU32(60)|4)
    return esp32C5SleepGpioBeginOwned(cycle,request,context,4,false,true)
}
