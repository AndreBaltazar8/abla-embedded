import "../src/touch/cst816s_session_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(6)
var writes=0
var reads=0
var awake=false
var malformed=false
var count=1
var release=false
trusted fun cst816sWrite(handle: int,register: int,value: int): bool { writes=writes+1; awake }
trusted fun cst816sRead(handle: int,register: int,buffer: NativeBuffer,size: int): bool {
    reads=reads+1
    buffer.store(0,if (malformed) 2 else count)
    awake
}
fun cst816sSessionRelease(handle: int): bool = release
@export("abla_cst816s_session_test")
trusted fun testSession(): i32 {
    val buffer=nativeBufferAt(storage,6)
    var owner=cst816sSessionOwned(123)
    owner=owner.pollOwned(buffer,4194300)
    if (owner.initialized() || owner.status() != 3 || writes != 1 || reads != 0) return i32(1)
    owner=owner.pollOwned(buffer,5)
    if (owner.status() != 5 || writes != 1) return i32(2)
    awake=true
    owner=owner.pollOwned(buffer,6)
    if (!owner.initialized() || owner.reportCount() != 1 || writes != 4 || reads != 2) return i32(3)
    owner=owner.pollOwned(buffer,7)
    if (owner.fresh() || reads != 2) return i32(4)
    count=0
    owner=owner.pollOwned(buffer,16)
    if (owner.reportCount() != 0 || writes != 4 || reads != 3) return i32(5)
    awake=false
    owner=owner.pollOwned(buffer,26)
    if (owner.status() != 3 || !owner.initialized() || owner.fresh()) return i32(6)
    awake=true
    malformed=true
    owner=owner.pollOwned(buffer,36)
    if (owner.status() != 4 || reads != 7) return i32(7)
    owner=owner.reinitialize()
    if (owner.initialized() || owner.fresh() || owner.handle() != 123) return i32(8)
    owner=owner.closeOwned()
    val before=reads+writes
    if (owner.status() != 6 || owner.handle() != 123 || owner.pollOwned(buffer,100) != owner ||
        owner.reinitialize() != owner || reads+writes != before) return i32(9)
    release=true
    if (owner.closeOwned() != 0) return i32(10)
    i32(0)
}
