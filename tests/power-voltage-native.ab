import "../src/power/voltage_result.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_power_voltage_test")
fun voltageTest(): i32 {
    var value=0
    while (value <= 65535) {
        val raw=I2cWordResult(65536 | value)
        val a=axp192BatteryMillivolts(raw)
        val b=axp2101BatteryMillivolts(raw)
        if (a.valid() != (value <= 4095) || b.valid() != (value <= 16383) ||
            (a.valid() && a.value() != value+value/10) || (b.valid() && b.value() != value) ||
            axp192BatteryMillivolts(I2cWordResult(value)).valid() ||
            axp2101BatteryMillivolts(I2cWordResult(value)).valid()) return i32(1)
        value=value+1
    }
    i32(0)
}
