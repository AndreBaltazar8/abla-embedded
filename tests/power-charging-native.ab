import "../src/power/charging_checked.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
var chip=1
var status=0
var full=0
var failure=0
var calls=0
var bad=false
var presence=false
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    val expected=if (presence) (if (chip == 1) 1 else 0) else if (calls == 1) 113 else if (chip == 1) 0 else if (chip == 2) 1 else if (chip == 3) 112 else 8
    if (this != 7 || register != expected) bad=true
    calls=calls+1
    if (calls == failure) I2cByteResult(0) else I2cByteResult(256|(if (calls == 1) status else full))
}
@export("abla_power_charging_test")
fun chargingTest(): i32 {
    chip=1
    while (chip <= 4) {
        status=0
        while (status < 256) {
            full=0
            while (full < (if (chip == 3) 256 else 1)) {
                failure=0
                while (failure <= (if (chip == 3) 2 else 1)) {
                    calls=0; bad=false
                    val result=I2cDevice(7).readChargingChecked(PowerChargeKind(chip))
                    val expected=if (chip == 1) (status&4) != 0 else if (chip == 2) ((status>>>5)&3) == 1 else
                        if (chip == 3) (status&8) != 0 && (full&8) == 0 else ((status>>>3)&3) == 1 || ((status>>>3)&3) == 2
                    if (result.valid() != (failure == 0) || (result.valid() && result.value() != (if (expected) 1 else 0)) ||
                        bad || calls != (if (chip != 3 || failure == 1) 1 else 2)) return i32(1)
                    failure=failure+1
                }
                full=full+1
            }
            status=status+1
        }
        chip=chip+1
    }
    presence=true; chip=1
    while (chip <= 2) {
        status=0
        while (status < 256) {
            failure=0
            while (failure < 2) {
                calls=0; bad=false
                val result=I2cDevice(7).readBatteryPresentChecked(PowerChargeKind(chip))
                if (result.valid() != (failure == 0) || calls != 1 || bad ||
                    (result.valid() && result.value() != (if ((status & (if (chip == 1) 32 else 8)) != 0) 1 else 0))) return i32(3)
                failure=failure+1
            }
            status=status+1
        }
        chip=chip+1
    }
    calls=0
    if (I2cDevice(7).readBatteryPresentChecked(powerChargeIp5306).valid() ||
        I2cDevice(0).readBatteryPresentChecked(powerChargeAxp192).valid() || calls != 0) return i32(4)
    if (I2cDevice(0).readChargingChecked(powerChargeAxp192).valid() ||
        I2cDevice(4294967297).readChargingChecked(powerChargeAxp192).valid() ||
        I2cDevice(7).readChargingChecked(PowerChargeKind(0)).valid() || calls != 0) return i32(2)
    i32(0)
}
