import "../src/storage/fat_directory_entry.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/hal/native_buffer.ab"
@export("abla_fat_directory_entry_target")
trusted fun target(address: int,index: int,bits: int,clusters: int): int = fatDirectoryDecode(nativeBufferAt(address,512),index,bits,clusters).byteSize()
