import "../src/esp32/power/sleep_analog_p4_sequence.ab"
import "abla/unsafe/native"
var regs=NativeBuffer(0)
var writes=0
var fail=0
var closing=false
var bad=false
fun expectedOffset(i: int): int = if (i == 0) 24 else if (i == 1) 128 else if (i == 2) 128 else if (i == 3) 128 else if (i == 4) 128 else if (i == 5) 144 else if (i == 6) 144 else if (i == 7) 144 else if (i == 8) 144 else if (i == 9) 144 else if (i == 10) 128 else if (i == 11) 144 else if (i == 12) 148 else if (i == 13) 156 else if (i == 14) 156 else if (i == 15) 160 else if (i == 16) 200 else if (i == 17) 200 else if (i == 18) 180 else if (i == 19) 180 else if (i == 20) 180 else if (i == 21) 180 else if (i == 22) 200 else if (i == 23) 184 else if (i == 24) 156 else 156
fun expectedMask(i: int): u32 = u32(if (i == 0) 25165824 else if (i == 1) 25165824 else if (i == 2) 8126464 else if (i == 3) 1073741824 else if (i == 4) 2147483648 else if (i == 5) 65536 else if (i == 6) 131072 else if (i == 7) 262144 else if (i == 8) 7864320 else if (i == 9) 125829120 else if (i == 10) 1006632960 else if (i == 11) 4160749568 else if (i == 12) 4227858432 else if (i == 13) 125829120 else if (i == 14) 4160749568 else if (i == 15) 4227858432 else if (i == 16) 1073741824 else if (i == 17) 2147483648 else if (i == 18) 4194304 else if (i == 19) 2097152 else if (i == 20) 125829120 else if (i == 21) 4160749568 else if (i == 22) 1006632960 else if (i == 23) 4227858432 else if (i == 24) 2097152 else 4194304)
fun slot(offset: int): int = if (offset == 24) 0 else if (offset == 128) 4 else if (offset == 200) 8 else
    if (offset == 144) 12 else if (offset == 148) 16 else if (offset == 156) 20 else if (offset == 160) 24 else
    if (offset == 180) 28 else if (offset == 184) 32 else -1
trusted fun p4SleepAnalogRead(offset: int): u32 {
    val i=slot(offset);if (i < 0) { bad=true;return u32(0) };return u32(regs.loadU32(i))
}
trusted fun p4SleepAnalogWrite(offset: int,value: u32): void {
    val i=slot(offset);if (i < 0) { bad=true;return }
    val step=if (closing) (writes+1)%26 else writes
    if (offset != expectedOffset(step) || ((value^u32(regs.loadU32(i)))&~expectedMask(step)) != u32(0)) bad=true
    writes=writes+1;if (writes != fail) regs.storeU32(i,int(value));return
}
trusted fun seed(r: NativeBuffer,c: NativeBuffer): void {
    var i=0
    while (i < 36) { regs.storeU32(i,0xffffffff);i=i+4 }
    i=0
    while (i < 32) { c.storeU32(i,0);i=i+4 }
    i=0
    while (i < 56) { r.storeU32(i,0);i=i+4 }
    r.storeU32(56,0x12345678);writes=0;fail=0;closing=false;bad=false;return
}
@export("abla_sleep_analog_p4_test")
trusted fun test(): i32 {
    regs=nativeBufferAt(nativeStaticAllocate(36),36)
    val c=nativeBufferAt(nativeStaticAllocate(32),32)
    val r=nativeBufferAt(nativeStaticAllocate(60),60)
    var phase=0
    while (phase < 2) {
        var fault=0
        while (fault <= 26) {
            seed(r,c);if (phase == 0) fail=fault
            val opened=esp32p4SleepAnalogOpenOwned(r,c,300,false,true)
            if ((phase == 1 || fault == 0) && opened != 1) return i32(1)
            if (phase == 0 && fault != 0 && (opened != 3 || r.loadU32(8) != fault)) return i32(2)
            if (bad) return i32(3)
            val primary=r.loadU32(8)
            writes=0;closing=true;fail=if (phase == 1) fault else 0
            val closed=esp32p4SleepAnalogCloseOwned(r,true)
            if (phase == 1 && fault != 0 && closed != 3) return i32(4)
            if (bad) return i32(5)
            writes=0;fail=0
            if (esp32p4SleepAnalogCloseOwned(r,true) != 4 || r.loadU32(8) != primary || r.loadU32(56) != 0x12345678 || bad) return i32(6)
            var i=0
            while (i < 36) { if (regs.loadU32(i) != 0xffffffff) return i32(7);i=i+4 }
            fault=fault+1
        }
        phase=phase+1
    }
    seed(r,c);c.storeU32(8,0x80000)
    if (esp32p4SleepAnalogOpenOwned(r,c,300,false,true) != 2 || writes != 0) return i32(8)
    return i32(0)
}
