import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/display/software_lcd.ab"
import "../src/display/mipi_programs.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_mipi_init_test")
trusted fun mipiInitTargetTest(gateAddress: u32, rotation: i32, extended: bool): int =
    softwareLcd(pin(12), pin(11), pin(10), pin(9)).beginRgb565(peripheralGateAt(int(gateAddress)), u32(7),
        lcdGeometry(320, 240), int(rotation), ili9342InitProgram(),
        if (extended) ili9342EInitProgram() else nativeBufferAt(0, 0), false, true, 1).status()
