import "../src/esp32/i2c/lp_release_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var sdaMux=0
var sclMux=0
var enabled=0
var failure=0
var writes=0
var bad=false
fun c5LpI2cReleaseLoad(address: int): int {
    if (address == 0x600B102C) return if (failure == 1) 4 else 0
    if (address == 0x600B1028) return if (failure == 2) 4 else 12
    if (address == 0x600B2800) return if (failure == 3) 0 else 0x08000000
    if (address == 0x600B47F8) return if (failure == 4) 0 else 1
    if (address == 0x600B4008) return sdaMux
    if (address == 0x600B400C) return sclMux
    if (address == 0x600B4410) return enabled
    bad=true
    0
}
fun c5LpI2cReleaseStore(address: int,value: int): void {
    val step=writes%3
    if (step == 0) {
        if (address != 0x600B4418 || value != 12) bad=true
        enabled=enabled&~12
    } else if (step == 1) {
        if (address != 0x600B4008 || value != ((sdaMux&~0x7382)|0x1200)) bad=true
        sdaMux=value
    } else {
        if (address != 0x600B400C || value != ((sclMux&~0x7382)|0x1200)) bad=true
        sclMux=value
    }
    writes=writes+1
    return
}
@export("abla_c5_lp_i2c_release_test")
trusted fun releaseTest(): i32 {
    var profile=0
    while (profile < 2048) {
        val pattern=(profile/8)*0x01010101
        failure=profile%8
        sdaMux=(pattern&~0x7382)|0x3300; sclMux=sdaMux; enabled=pattern|12
        if (failure == 5) sdaMux=(sdaMux&~0x7000)|0x2000
        if (failure == 6) sclMux=sclMux|2
        if (failure == 7) sdaMux=(sdaMux&~0x7382)|0x1200
        writes=0; bad=false
        if (esp32C5LpI2cReleasePinsOwned(0,2,3) != (failure == 0) || writes != (if (failure == 0) 3 else 0) || bad) return i32(1)
        if (failure == 0 && (!esp32C5LpI2cReleasePinsOwned(0,2,3) || writes != 6 || bad || (enabled&12) != 0)) return i32(2)
        profile=profile+1
    }
    writes=0
    if (esp32C5LpI2cReleasePinsOwned(1,2,3) || esp32C5LpI2cReleasePinsOwned(0,3,2) || writes != 0) return i32(3)
    i32(0)
}
