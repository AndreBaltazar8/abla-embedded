// Regression cases for the lower-esp32-fixed-addresses pass: each expectation is what the original Python tool
// produced for the same fixture (see the commit message of the port).
import "abla/io"
import "abla/test"
import "abla/text"
import "../tools/lower-esp32-fixed-addresses.ab"


fun main: int {
    expectEqual(fixedLowerSource("a = \$xtensa address {UART0} + \$xtensa address {{ g_i2s }} + \$xtensa address {other}\n").text, "a = u32(1072955392) + esp32I2sObject + \$xtensa address {other}\n", "fixed addresses")
    if (testsPassed() != 0) return 1
    println("PASS: lower-esp32-fixed-addresses matches the original Python tool on the fixtures")
    0
}
