import "../src/m5stack/cores3_display_spi.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun hardwareLcdFillTarget(gateAddress: u32): int =
    m5BoardStackCoreS3.clearCoreS3SpiDisplay(peripheralGateAt(int(gateAddress)),u32(41))
#exportFunction("hardwareLcdFillTarget", "abla_s3_hardware_lcd_fill_test")
