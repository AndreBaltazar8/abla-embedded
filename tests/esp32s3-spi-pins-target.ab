import "../src/esp32/spi/pins_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun spiPinsTarget(peripheral: u32, mosi: u32, miso: u32, clock: u32, select: u32): int =
    esp32s3SpiRouteMasterPinsOwned(int(peripheral), spiPins(int(mosi), int(miso), int(clock)), Pin(int(select)))
#exportFunction("spiPinsTarget", "abla_s3_spi_pins_test")
