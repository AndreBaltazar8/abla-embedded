import "../src/i2c/results.ab"
import "../src/m5stack/toughc5_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var calls=0
var failure=0
var bad=false
var sd=false
val registers=nativeStaticAllocate(160)
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    if (sd || calls >= 5) bad=true
    this.applyWrite(register,255,value)
}
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }

fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true; return I2cWordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun expectedDevice(step: int): int =
    if (step == 1) 9 else if (step == 2) 9 else if (step == 3) 9 else if (step == 4) 9 else if (step == 5) 9 else if (step == 6) 9 else if (step == 7) 9 else if (step == 8) 8 else if (step == 9) 8 else if (step == 10) 8 else if (step == 11) 8 else if (step == 12) 8 else if (step == 13) 8 else if (step == 14) 8 else if (step == 15) 8 else if (step == 16) 9 else if (step == 17) 9 else if (step == 18) 9 else if (step == 19) 9 else if (step == 20) 9 else if (step == 21) 9 else if (step == 22) 9 else if (step == 23) 9 else if (step == 24) 9 else if (step == 25) 9 else 9
fun expectedRegister(step: int): int =
    if (step == 1) 5 else if (step == 2) 64 else if (step == 3) 65 else if (step == 4) 66 else if (step == 5) 67 else if (step == 6) 22 else if (step == 7) 16 else if (step == 8) 3 else if (step == 9) 19 else if (step == 10) 9 else if (step == 11) 11 else if (step == 12) 3 else if (step == 13) 19 else if (step == 14) 3 else if (step == 15) 5 else if (step == 16) 6 else if (step == 17) 6 else if (step == 18) 6 else if (step == 19) 6 else if (step == 20) 16 else if (step == 21) 19 else if (step == 22) 20 else if (step == 23) 17 else if (step == 24) 22 else if (step == 25) 22 else 16
fun expectedMask(step: int): int =
    if (step == 1) 255 else if (step == 2) 255 else if (step == 3) 255 else if (step == 4) 255 else if (step == 5) 255 else if (step == 6) 3 else if (step == 7) 1 else if (step == 8) 1 else if (step == 9) 1 else if (step == 10) 1 else if (step == 11) 1 else if (step == 12) 4 else if (step == 13) 64 else if (step == 14) 64 else if (step == 15) 64 else if (step == 16) 1 else if (step == 17) 2 else if (step == 18) 4 else if (step == 19) 16 else if (step == 20) 2 else if (step == 21) 2 else if (step == 22) 12 else if (step == 23) 2 else if (step == 24) 12 else if (step == 25) 192 else 8
fun expectedValue(step: int): int =
    if (step == 1) 0 else if (step == 2) 0 else if (step == 3) 0 else if (step == 4) 0 else if (step == 5) 22 else if (step == 6) 0 else if (step == 7) 0 else if (step == 8) 0 else if (step == 9) 1 else if (step == 10) 0 else if (step == 11) 0 else if (step == 12) 0 else if (step == 13) 0 else if (step == 14) 64 else if (step == 15) 64 else if (step == 16) 1 else if (step == 17) 2 else if (step == 18) 4 else if (step == 19) 16 else if (step == 20) 2 else if (step == 21) 0 else if (step == 22) 4 else if (step == 23) 2 else if (step == 24) 4 else if (step == 25) 0 else 0
trusted fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    if (!sd && calls < 5) bad=true
    this.applyWrite(register,mask,value)
}
trusted fun I2cDevice.applyWrite(register: int,mask: int,value: int): bool {
    calls=calls+1
    val step=calls+(if (sd) 7 else 0)
    if (calls > (if (sd) 19 else 7) || this != expectedDevice(step) || register != expectedRegister(step) ||
        mask != expectedMask(step) || value != expectedValue(step)) bad=true
    if (calls == failure) return false
    val offset=(if (this == 9) 80 else 0)+register
    val buffer=nativeBufferAt(registers,160)
    buffer.store(offset,(buffer.load(offset)&~mask)|value)
    true
}
@export("abla_toughc5_power_test")
trusted fun powerTest(): i32 {
    val owner=m5ExpandersAt(nativeBufferAt(nativeStaticAllocate(32),32))
    owner.initialize(); owner.buffer().storeU32(8,m5BoardToughC5 | 0)
    owner.storeSlot(0,M5ExpanderOpen(8|(2<<32)|(1<<40))); owner.buffer().storeU32(4,1)
    val pmic=M5PmicOpen(9|(5<<32)|(1<<40))
    var phase=0
    while (phase < 2) {
        sd=phase == 1
        val count=if (sd) 19 else 7
        var profile=0
        while (profile < (count+1)*256) {
            val initial=profile&255; failure=profile/256
            val buffer=nativeBufferAt(registers,160)
            var r=0
            while (r < 160) { buffer.store(r,initial); r=r+1 }
            calls=0; bad=false
            val result=if (sd) owner.configureToughPowerRails(pmic) else owner.configureToughPowerInputs(pmic)
            val acknowledged=if (failure == 0) count else failure-1
            if (result.status() != (if (failure == 0) 1 else 4) || result.appliedSteps() != (if (sd && acknowledged > 2) acknowledged-1 else acknowledged) ||
                calls != (if (failure == 0) count else failure) || bad) return i32(1)
            r=0
            while (r < 160) {
                var expected=initial
                var i=1
                while (i <= acknowledged) {
                    val step=i+(if (sd) 7 else 0)
                    val offset=expectedRegister(step)+(if (expectedDevice(step) == 9) 80 else 0)
                    if (offset == r) expected=(expected&~expectedMask(step))|expectedValue(step)
                    i=i+1
                }
                if (buffer.load(r) != expected) return i32(2)
                r=r+1
            }
            profile=profile+1
        }
        phase=phase+1
    }
    calls=0
    if (owner.configureToughPowerInputs(M5PmicOpen(0)).status() != 3 ||
        owner.configureToughPowerInputs(M5PmicOpen(9|(3<<32)|(1<<40))).status() != 3 || calls != 0) return i32(3)
    owner.buffer().storeU32(8,m5BoardCoreP4X | 0)
    if (owner.configureToughPowerInputs(pmic).status() != 2 || owner.configureToughPowerRails(pmic).status() != 2 || calls != 0) return i32(4)
    owner.buffer().storeU32(4,6)
    if (owner.configureToughPowerInputs(pmic).status() != 3 || owner.configureToughPowerRails(pmic).status() != 3 || calls != 0) return i32(5)
    i32(0)
}
