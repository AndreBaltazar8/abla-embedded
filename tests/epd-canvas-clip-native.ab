import "../src/display/epd_canvas_clip.ab"
import "abla/build"
val clipStorage=nativeStaticAllocate(128)
@export("abla_epd_canvas_clip_test")
fun testClip(): int {
    val canvas=nativeBufferAt(clipStorage,24)
    val reference=nativeBufferAt(clipStorage+32,24)
    val source=nativeBufferAt(clipStorage+64,42)
    var i=0
    while (i < 42) { source.store(i,(i*37+13)&255);i=i+1 }
    var rotation=0
    while (rotation < 8) {
        var mode=1
        while (mode <= 4) {
            var ix=0
            while (ix < 7) {
                val x=if (ix == 0) -6 else if (ix == 1) -1 else if (ix == 2) 0 else if (ix == 3) 3 else if (ix == 4) 7 else if (ix == 5) 8 else 20
                var iy=0
                while (iy < 7) {
                    val y=if (iy == 0) -5 else if (iy == 1) -1 else if (iy == 2) 0 else if (iy == 3) 3 else if (iy == 4) 5 else if (iy == 5) 8 else 20
                    var extent=0
                    while (extent < 16) {
                        val w=if ((extent&3) == 0) 0 else if ((extent&3) == 1) 1 else if ((extent&3) == 2) 4 else 6
                        val h=if ((extent>>>2) == 0) 0 else if ((extent>>>2) == 1) 1 else if ((extent>>>2) == 2) 3 else 5
                        var fill=-1
                        while (fill < 2) {
                            val gray=if (fill == -1) -1 else if (fill == 0) 0 else 137
                            i=0
                            while (i < 24) { canvas.store(i,0xa5);reference.store(i,0xa5);i=i+1 }
                            if (!epdCanvasDrawClippedOwned(canvas,8,6,x,y,w,h,rotation,source,7,gray,mode,true)) return 1
                            var row=0
                            while (row < h) {
                                var col=0
                                while (col < w) {
                                    val px=x+col;val py=y+row
                                    if (px >= 0 && py >= 0 && px < (if ((rotation&1) == 0) 8 else 6) && py < (if ((rotation&1) == 0) 6 else 8)) {
                                        val pixel=if (gray == -1) source.load(row*7+col) else gray
                                        if (!epdCanvasDrawOwned(reference,8,6,px,py,1,1,rotation,source,7,pixel,mode,true)) return 2
                                    }
                                    col=col+1
                                }
                                row=row+1
                            }
                            i=0
                            while (i < 24) { if (canvas.load(i) != reference.load(i)) return 3;i=i+1 }
                            fill=fill+1
                        }
                        extent=extent+1
                    }
                    iy=iy+1
                }
                ix=ix+1
            }
            mode=mode+1
        }
        rotation=rotation+1
    }
    i=0
    while (i < 24) { canvas.store(i,0xa5);i=i+1 }
    if (epdCanvasDrawClippedOwned(canvas,8,6,0,0,6,5,0,nativeBufferAt(source.addressValue(),33),7,-1,1,true) ||
        epdCanvasDrawClippedOwned(canvas,8,6,-1,-1,6,5,0,canvas,7,-1,1,true) ||
        epdCanvasDrawClippedOwned(canvas,8,6,0,0,6,5,0,source,5,-1,1,true) ||
        epdCanvasDrawClippedOwned(canvas,8,6,0,0,6,5,0,source,7,255,1,false) ||
        epdCanvasDrawClippedOwned(canvas,8,6,0,0,-1,5,0,source,7,255,1,true) ||
        epdCanvasDrawClippedOwned(canvas,8,6,0,0,6,5,8,source,7,255,1,true) ||
        epdCanvasDrawClippedOwned(canvas,8,6,2147483648,0,6,5,0,source,7,255,1,true)) return 4
    if (!epdCanvasDrawClippedOwned(canvas,8,6,-2147483648,2147483647,65535,65535,0,source,0,255,1,true)) return 5
    i=0
    while (i < 24) { if (canvas.load(i) != 0xa5) return 6;i=i+1 }
    return 0
}
