import "../src/m5stack/imu_orientation.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_board_orientation_test")
fun orientationTest(): i32 {
    var sensor=0
    while (sensor < 3) {
        val motion=sensor < 2
        if (m5BoardAtomMatrix.imuAxisOrder(m5ImuMpu6886,sensor) != (if (motion) imuAxisOrder(1,2,5) else imuAxisOrder(0,2,4)) ||
            m5BoardAtomMatrix.imuAxisOrder(m5ImuBmi270,sensor) != (if (motion) imuAxisOrder(1,2,5) else imuAxisOrder(0,2,4)) ||
            m5BoardAtomMatrix.imuAxisOrder(m5ImuSh200q,sensor) != imuAxisOrder(0,2,4) ||
            m5BoardCoreP4X.imuAxisOrder(m5ImuBmi270,sensor) != (if (motion) imuAxisOrder(0,2,5) else imuAxisOrder(0,2,4)) ||
            m5BoardChainCaptain.imuAxisOrder(m5ImuBmi270,sensor) != (if (motion) imuAxisOrder(3,1,5) else imuAxisOrder(0,2,4)) ||
            m5BoardCoreMatrix.imuAxisOrder(m5ImuBmi270,sensor) != (if (motion) imuAxisOrder(2,1,4) else imuAxisOrder(0,2,4))) return i32(1)
        val atom=if (motion) imuAxisOrder(2,1,4) else imuAxisOrder(1,2,5)
        if (m5BoardAtomS3R.imuAxisOrder(m5ImuBmi270,sensor) != atom ||
            m5BoardAtomS3RCam.imuAxisOrder(m5ImuBmi270,sensor) != atom ||
            m5BoardAtomS3RExt.imuAxisOrder(m5ImuBmi270,sensor) != atom) return i32(2)
        var address=104
        while (address <= 105) {
            val core=if (!motion && address == 105) imuAxisOrder(0,3,5) else imuAxisOrder(0,2,4)
            if (m5BoardStackCoreS3.imuAxisOrder(m5ImuBmi270,sensor,address) != core ||
                m5BoardStackChan.imuAxisOrder(m5ImuBmi270,sensor,address) != core) return i32(3)
            address=address+1
        }
        if (m5BoardStack.imuAxisOrder(m5ImuMpu6886,sensor,104,m5MagnetometerBmm150) !=
                (if (motion) imuAxisOrder(0,2,4) else imuAxisOrder(1,2,5)) ||
            m5BoardStack.imuAxisOrder(m5ImuMpu9250,sensor,104,m5MagnetometerAk8963) !=
                (if (motion) imuAxisOrder(0,2,4) else imuAxisOrder(2,0,5))) return i32(4)
        sensor=sensor+1
    }
    if (m5BoardAtomMatrix.imuAxisOrder(M5ImuKind(0),0).valid() ||
        m5BoardAtomMatrix.imuAxisOrder(m5ImuBmi270,3).valid() ||
        m5BoardAtomMatrix.imuAxisOrder(m5ImuBmi270,0,128).valid() ||
        m5BoardAtomMatrix.imuAxisOrder(m5ImuBmi270,0,104,M5MagnetometerKind(3)).valid()) return i32(5)
    i32(0)
}
