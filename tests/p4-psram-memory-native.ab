import "../src/esp32/psram/memory_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(88)
var fail=0
var order=0
var active=false
var mapped=false
var bad=false
var geometry=true
fun p4PsramCommandStorageSafe(address: int,bytes: int): bool = address == memory && bytes == 88
fun p4PsramMmuIndex(address: int): int = if (address == 0x48000000) 0 else -1
fun p4PsramMappedProfileValid(r: int,w: int,polls: int): bool = r == 18 && w == 8 && polls == 2
fun p4CacheL2GeometryMatches(line: int): bool = geometry
fun p4PsramRangeInitializeOwned(record: NativeBuffer): bool = record.addressValue() == memory+24
fun p4PsramRangeMapOwned(record: NativeBuffer,address: int,physical: int,pages: int,capacity: int,polls: int): int {
    order=order*10+1; mapped=true
    if (active || pages != 29 || record.addressValue() != memory+24) bad=true
    return if (fail == 1) 4 else 1
}
fun p4PsramMappedStartOwned(r: int,w: int,hex16: bool,polls: int): int {
    order=order*10+2
    if (!mapped) bad=true
    active=true; return if (fail == 2) 1797 else 1
}
fun p4PsramMappedRangeVerifyOwned(buffer: NativeBuffer,bytes: int,line: int,report: NativeBuffer,polls: int): int {
    order=order*10+3
    if (!active || bytes != 1900544 || report.addressValue() != memory+64) bad=true
    return if (fail == 3) 6 else 1
}
fun p4PsramVerifyFence(): void { return }
fun p4PsramVerifyFlush(buffer: NativeBuffer,bytes: int,line: int,polls: int): int {
    order=order*10+4
    if (!active || bytes != 1900544) bad=true
    return if (fail == 4) 5 else 1
}
fun p4PsramMappedStopOwned(polls: int): int { order=order*10+5; active=false; return if (fail == 5) 1797 else 1 }
fun p4PsramRangeUnmapOwned(record: NativeBuffer,polls: int): int {
    order=order*10+6
    if (active) bad=true
    if (fail == 6) return 4
    mapped=false; return 1
}
fun resetMemory(record: NativeBuffer): void {
    fail=0; order=0; active=false; mapped=false; bad=false; geometry=true; p4PsramMemoryInitializeOwned(record); return
}
fun openMemory(record: NativeBuffer): int = p4PsramMemoryOpenOwned(record,0x48000000,0,29,33554432,128,18,8,true,2)
@export("abla_p4_psram_memory_test")
fun memoryTest(): i32 {
    val record=nativeBufferAt(memory,88)
    resetMemory(record)
    if (openMemory(record) != 1 || p4PsramMemoryVerifyOwned(record,2) != 1 || record.loadU32(4) != 4 || p4PsramMemoryCloseOwned(record,2) != 1 || order != 123456 || active || mapped || bad) return i32(1)
    if (p4PsramMemoryCloseOwned(record,2) != 1 || order != 123456 || openMemory(record) != 3) return i32(2)
    var stage=1
    while (stage <= 6) {
        resetMemory(record); fail=stage
        if (openMemory(record) != (if (stage <= 2) 4 else 1)) return i32(3)
        if (stage == 3 && p4PsramMemoryVerifyOwned(record,2) != 4) return i32(4)
        if (stage >= 4 && p4PsramMemoryCloseOwned(record,2) != 4) return i32(5)
        if (stage == 4 && !active) return i32(6)
        fail=0
        if (p4PsramMemoryCloseOwned(record,2) != 1 || mapped || active || bad || record.loadU32(4) != 7) return i32(7)
        stage=stage+1
    }
    resetMemory(record); geometry=false
    if (openMemory(record) != 4 || order != 0) return i32(8)
    geometry=true; openMemory(record); geometry=false
    if (p4PsramMemoryCloseOwned(record,2) != 4 || order != 12 || !active) return i32(9)
    resetMemory(record)
    if (p4PsramMemoryOpenOwned(record,0x48000000,0,29,65536,128,18,8,true,2) != 2 || order != 0) return i32(10)
    return i32(0)
}
