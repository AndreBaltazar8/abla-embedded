import "../src/audio/pcm16_mix.ab"
import "abla/runtime/scalar"
import "abla/build"

// Callable integration entry: caller owns disjoint accumulator/source/output
// spans. This is not a board boot image and performs no hardware operations.
trusted fun mixStereoPcmTarget(
    accumulator: NativeBuffer,first: NativeBuffer,second: NativeBuffer,
    output: NativeBuffer,frames: int,firstGain: int,secondGain: int,masterGain: int
): bool {
    if (frames < 0 || frames > 268435455) return false
    val samples=frames*2
    clearPcm16Mix(accumulator,samples) &&
        addPcm16ToMix(accumulator,first,samples,firstGain) &&
        addPcm16ToMix(accumulator,second,samples,secondGain) &&
        finishPcm16Mix(accumulator,output,samples,masterGain)
}
#exportFunction("mixStereoPcmTarget","abla_pcm16_mix_target")
