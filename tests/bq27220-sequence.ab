import "../src/i2c/results.ab"
import "../src/power/bq27220_device.ab"

// Test-only transport and clock. Execute the real driver, recording every
// command/wait and injecting errors without accessing hardware.
type I2cBus = int
type I2cDevice = int
var step = 0
var failure = -1
var mismatch = false
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int, frequency: int): I2cDevice =
    I2cDevice(if (address == 85 && frequency == 100000) 256 else 0)
fun I2cDevice.close(): bool = this != 0
fun sequenceExpected(index: int): int {
    if (index == 0) return 65
    if (index == 1) return 1
    if (index == 2) return 1000010
    if (index == 3) return 2000062
    if (index == 4) return 1000200
    if (index == 5 || index == 6) return 32768
    if (index == 7 || index == 8) return 65535
    return -1
}
fun sequenceEvent(value: int): bool {
    if (value != sequenceExpected(step)) mismatch = true
    val success = step != failure
    step = step + 1
    success
}
fun I2cDevice.writeRegister16LittleEndian(register: int, value: int): bool =
    register == 0 && sequenceEvent(value)
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult =
    I2cDwordResult(if (sequenceEvent(2000000 + register)) 4294967296 else 0)
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult = I2cWordResult(0)
fun peripheralDelayMilliseconds(milliseconds: int): void {
    val observed = sequenceEvent(1000000 + milliseconds)
    return
}
trusted fun main(): int {
    val gauge = bq27220(I2cBus(1))
    if (!gauge.begin() || mismatch || step != 9) return 1
    failure = 0
    while (failure < 9) {
        if (failure != 2 && failure != 4) {
            step = 0
            mismatch = false
            if (gauge.begin() || mismatch || step != failure + 1) return 2
        }
        failure = failure + 1
    }
    step = 0
    if (bq27220(I2cBus(0)).begin() || step != 0) return 3
    0
}
