import "./pm1-control-wire-native.ab"
import "../src/touch/ft5x06_device.ab"
import "../src/touch/gt911_device.ab"
import "../src/touch/cst3530_device.ab"
import "../src/touch/st7123_device.ab"
import "../src/touch/cst816s_device.ab"
import "../src/touch/chsc6540_device.ab"
trusted fun peripheralDelayMilliseconds(milliseconds: int): void { bad=true;return }
@export("abla_touch_handle_wire_test")
trusted fun testTouchHandle(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    if (!device.valid()) return i32(1)
    val handle=device|0;val scratch=nativeBufferAt(nativeStackAllocate(160),160)
    var sample=0
    while (sample < 36) {
        val raw=if (sample == 0) 0 else if (sample == 1) -1 else if (sample == 2) 4294967296 else if (sample == 3) -9223372036854775807-1 else handle|(1<<(sample+28))
        val a=Ft5x06(raw);val b=Gt911(raw);val c=Cst3530(raw)
        val d=St7123(raw);val e=Cst816s(raw);val f=Chsc6540(raw)
        var at=0;while (at < 160) { scratch.store(at,165);at=at+1 }
        val before=ackCount
        if (a.valid() || b.valid() || c.valid() || d.valid() || e.valid() || f.valid()) return i32(2)
        if ((a.device()|0) != 0 || (b.device()|0) != 0 || (c.device()|0) != 0 || (d.device()|0) != 0 || (e.device()|0) != 0 || (f.device()|0) != 0) return i32(3)
        if (a.begin() || b.begin() || c.begin() || d.begin() || e.begin() || f.begin()) return i32(4)
        if (a.readSnapshot(scratch) != -1 || b.readFrame(scratch) != -1 || c.readFrame(scratch) != -1 || d.readFrame(scratch) != -1 || e.readFrame(scratch) != -1 || f.readStable(scratch) != -1) return i32(5)
        if (a.close() || b.close() || c.close() || d.close() || e.close() || f.close() || ackCount != before || bad) return i32(6)
        // Direct protocol helpers must not bypass nominal handle admission.
        if (cst3530Command(raw,0) || cst3530Header(raw,scratch) || cst3530Continue(raw,scratch,1) || st7123Read(raw,0,scratch,1) || cst816sRead(raw,0,scratch,1) || cst816sWrite(raw,0,0) || chsc6540Capture(raw,scratch) != -1 || ackCount != before || bad) return i32(7)
        at=0;while (at < 160) { if (scratch.load(at) != 165) return i32(8);at=at+1 }
        if (!device.writeRegister8(200,sample)) return i32(9)
        sample=sample+1
    }
    if (!Ft5x06(handle).valid() || !Gt911(handle).valid() || !Cst3530(handle).valid() || !St7123(handle).valid() || !Cst816s(handle).valid() || !Chsc6540(handle).valid()) return i32(10)
    if (!device.close() || !bus.close() || pads != 0 || bad) return i32(11)
    return i32(0)
}
