import "../src/i2c/results.ab"
import "../src/m5stack/tough_tone_owner.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var writes=0
var fail=0
var frequency=1000
var duty=0
var bad=false
var readFails=false
var nackApplied=false
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult {
    if (this != 9 || register != 52) bad=true
    return I2cWordResult(if (readFails) 0 else 65536|frequency)
}
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true;return false }
fun peripheralDelayMilliseconds(ms: int): void { bad=true;return }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool {
    if (this != 9 || (register != 50 && register != 52)) bad=true
    writes=writes+1
    val success=writes != fail
    if (success || nackApplied) {
        if (register == 50) duty=value
        else {
            if (duty != 0) bad=true
            frequency=value
        }
    }
    return success
}
@export("abla_tough_tone_owner_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(128)
    val parent=nativeBufferAt(storage,96)
    val r=nativeBufferAt(storage+96,32)
    var field=0
    while (field < 96) { parent.storeU32(field,0);field=field+4 }
    parent.storeU32(0,0x54435057);parent.storeU32(4,1);parent.storeU32(8,9);parent.storeU32(12,261);parent.storeU32(16,1281)
    val owner=m5ToughPowerOwnerAt(parent)
    val pmic=M5PmicOpen(9|(5<<32)|(1<<40))
    val setup=M5ToughBuzzerSetup(769)
    var mode=0
    while (mode < 2) {
        nackApplied=mode == 1
        var fault=0
        while (fault <= 5) {
            var at=0
            while (at < 32) { r.storeU32(at,0);at=at+4 }
            writes=0;fail=fault;frequency=1000;duty=0;bad=false
            val result=owner.beginToneOwned(r,2200,1024,0xfffffff0,32,true)
            if (result != (if (fault > 0 && fault <= 3) 4 else 1)) return i32(1)
            if (!owner.toneRetained() || owner.beginToneOwned(r,2200,1024,0,32,true) != 2) return i32(8)
            val primary=r.loadU32(16)
            if (result == 1) {
                val before=writes
                if (owner.pollToneOwned(r,0xffffffff,true) != 5 || owner.pollToneOwned(r,15,true) != 5 || writes != before) return i32(2)
                val ended=owner.pollToneOwned(r,16,true)
                if (ended != (if (fault == 4 || fault == 5) 4 else 6)) return i32(3)
            }
            fail=0
            if (owner.stopToneOwned(r,true) != 6 || duty != 0 || frequency != 1000 || r.loadU32(16) != primary || bad || owner.toneRetained()) return i32(4)
            val before=writes
            if (owner.pollToneOwned(r,20,true) != 6 || owner.stopToneOwned(r,true) != 6 || writes != before) return i32(5)
            fault=fault+1
        }
        mode=mode+1
    }
    r.storeU32(0,0);writes=0;readFails=true
    if (owner.beginToneOwned(r,2200,1024,0,32,true) != 4 || owner.stopToneOwned(r,true) != 6 || writes != 0) return i32(6)
    r.storeU32(0,0);readFails=false
    parent.storeU32(20,4)
    if (owner.beginToneOwned(r,2200,1024,0,32,true) != 2 || owner.beginToneOwned(r,2200,1024,0,32,false) != 2 || writes != 0 || owner.toneRetained()) return i32(7)
    return i32(0)
}
