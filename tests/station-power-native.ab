import "../src/m5stack/station_power_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var fail=0
var trace=0
var bad=false
var expectedEnabled=false
fun step(handle: int,code: int,enabled: bool): bool {
    calls=calls+1; trace=trace*10+code
    if (handle != 7 || enabled != expectedEnabled) bad=true
    calls != fail
}
fun stationPowerGpio(handle: int,pin: int,enabled: bool): bool = step(handle,pin+1,enabled)
fun stationPowerUsb(enabled: bool): bool = step(7,6,enabled)
fun stationPowerMain(handle: int,enabled: bool): bool = step(handle,7,enabled)
@export("abla_station_power_test")
fun stationTest(): i32 {
    var profile=0
    while (profile < 2048) {
        val encoded=profile & 127
        val ports=(encoded & 63)|((encoded & 64)<<9)
        expectedEnabled=(profile & 128) != 0; fail=profile/256
        calls=0; trace=0; bad=false
        var expectedTrace=0; var expectedCalls=0; var applied=0; var status=1; var index=0
        while (index < 7 && status == 1) {
            if ((encoded & (1<<index)) != 0) {
                expectedCalls=expectedCalls+1; expectedTrace=expectedTrace*10+index+1
                if (expectedCalls == fail) status=if (index < 5) 5 else if (index == 5) 6 else 7
                else applied=applied|(if (index == 6) 32768 else 1<<index)
            }
            index=index+1
        }
        val result=m5BoardStation.setStationPowerOwned(7,3,ports,expectedEnabled)
        if (result.status() != status || result.appliedPorts() != applied || trace != expectedTrace || calls != expectedCalls || bad) return i32(1)
        profile=profile+1
    }
    calls=0
    if (m5BoardStation.setStationPowerOwned(7,74,1,true).status() != 2 ||
        m5BoardStation.setStationPowerOwned(0,3,1,true).status() != 3 ||
        m5BoardStation.setStationPowerOwned(7,3,64,true).status() != 4 ||
        m5BoardStation.setStationPowerOwned(7,3,-1,true).status() != 4 ||
        m5BoardAtomVoice.setStationPowerOwned(7,3,1,true).status() != 2 || calls != 0) return i32(2)
    fail=0; trace=0; bad=false; expectedEnabled=true
    if (!m5BoardStation.setStationPowerOwned(0,3,32,true).valid() || trace != 6 || bad) return i32(3)
    i32(0)
}
