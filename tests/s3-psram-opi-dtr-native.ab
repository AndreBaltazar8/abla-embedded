import "../src/esp32/psram/opi_dtr_s3_sequence.ab"
import "abla/build"
var odCtrl=0
var odUser=0
var odDdr=0
var odStep=0
var odBad=false
fun odAddress(step: int): int = if (step == 1) 0x60002018 else if (step >= 3) 0x600020e0 else 0x60002008
fun s3PsramOpiRead(address: int): int {
    if ((odStep&1) != 0 || address != odAddress(odStep>>>1)) odBad=true
    odStep=odStep+1
    return if (address == 0x60002008) odCtrl else if (address == 0x60002018) odUser else odDdr
}
fun s3PsramOpiWrite(address: int,value: int): void {
    if ((odStep&1) != 1 || address != odAddress(odStep>>>1)) odBad=true
    val step=odStep>>>1
    // Independent per-field oracle: CTRL bits4..9,13..14,20,23,24 clear;
    // then FDOUT_OCT/FDIN_OCT/FADDR_OCT/FCMD_OCT/FAST_READ bits4,5,6,9,13 set.
    var expected=if (step == 0 || step == 2) odCtrl else if (step == 1) odUser else odDdr
    var bit=0
    while (bit < 32) {
        val clear=(step == 0 && ((bit >= 4 && bit <= 9) || bit == 13 || bit == 14 || bit == 20 || bit == 23 || bit == 24)) ||
            (step == 1 && bit >= 12 && bit <= 15) || (step == 3 && bit == 4)
        val set=(step == 2 && (bit == 4 || bit == 5 || bit == 6 || bit == 9 || bit == 13)) || (step == 4 && bit == 0)
        if (clear) expected=expected&(~(1<<bit))
        if (set) expected=expected|(1<<bit)
        bit=bit+1
    }
    if (value != expected) odBad=true
    if (address == 0x60002008) odCtrl=value else if (address == 0x60002018) odUser=value else odDdr=value
    odStep=odStep+1;return
}
@export("abla_s3_psram_opi_dtr_test")
fun opiDtrTest(): int {
    var seed=0
    while (seed < 4096) {
        odCtrl=(seed*104729)&0xffffffff;odUser=(seed*15485863)&0xffffffff;odDdr=(seed*32452843)&0xffffffff
        val ddrBefore=odDdr
        odStep=0;odBad=false
        s3PsramOpiDtrNativeOwned()
        if (odBad || odStep != 10 || (odDdr&14) != (ddrBefore&14)) return 1
        // Repeated commands must preserve all already configured fields.
        val ctrl=odCtrl;val user=odUser;val ddr=odDdr
        odStep=0
        s3PsramOpiDtrNativeOwned()
        if (odBad || odStep != 10 || odCtrl != ctrl || odUser != user || odDdr != ddr) return 2
        seed=seed+1
    }
    return 0
}
