import "../src/esp32/adc_calibration_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
// Golden FNV32 digests generated independently using IDF's coefficient and
// four-term bilinear interpolation equations, over all raw codes/attenuations.
fun golden(index: int): int = if (index == 0) 1682495102 else if (index == 1) 3629638413 else if (index == 2) 2266491464 else if (index == 3) 1300439878 else if (index == 4) 3215644593 else if (index == 5) 2578108721 else if (index == 6) 3971585292 else if (index == 7) 2065799264 else if (index == 8) 1868763331 else if (index == 9) 917200594 else -1
@export("abla_adc_calibration_test")
fun calibrationTest(): i32 {
    var profile=0
    while (profile < 5) {
        val vref=if (profile == 0) 995 else if (profile == 1) 1000 else if (profile == 2) 1100 else if (profile == 3) 1200 else 1205
        var unit=1
        while (unit <= 2) {
            var hash=2166136261; var attenuation=0
            while (attenuation < 4) {
                var raw=0
                while (raw < 4096) {
                    val mv=esp32AdcVrefMillivolts(unit,attenuation,12,raw,vref)
                    if (mv < 0 || mv > 4000) return i32(1)
                    hash=((hash^mv)*16777619)&4294967295
                    raw=raw+1
                }
                attenuation=attenuation+1
            }
            if (hash != golden(profile*2+unit-1)) return i32(2)
            unit=unit+1
        }
        profile=profile+1
    }
    var bits=1
    while (bits < 32) {
        if (esp32AdcVrefFromFuse(bits) != 1100+(if (bits < 16) bits else -(bits-16))*7) return i32(3)
        bits=bits+1
    }
    var raw=0
    while (raw < 512) {
        if (esp32AdcVrefMillivolts(1,3,9,raw,1100) != esp32AdcVrefMillivolts(1,3,12,raw*8,1100)) return i32(4)
        raw=raw+1
    }
    if (esp32AdcVrefFromFuse(0) != -1 || esp32AdcVrefFromFuse(32) != -1 || esp32AdcVrefMillivolts(0,0,12,0,1100) != -1 || esp32AdcVrefMillivolts(1,4,12,0,1100) != -1 || esp32AdcVrefMillivolts(1,0,9,512,1100) != -1 || esp32AdcVrefMillivolts(1,0,12,4096,1100) != -1 || esp32AdcVrefMillivolts(1,0,8,0,1100) != -1 || esp32AdcVrefMillivolts(1,0,12,0,994) != -1) return i32(5)
    return i32(0)
}

