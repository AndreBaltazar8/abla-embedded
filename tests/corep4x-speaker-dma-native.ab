import "../src/m5stack/corep4x_speaker_dma_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
import "abla/runtime/scalar"
var step=0
var fail=0
var channel=0
var bad=false
trusted fun p4AhbDescriptorWrite(a: int,v: int): void { bad=true;return }
trusted fun next(expected: int): bool {
    step=step+1
    if (step != expected) bad=true
    return step != fail
}
trusted fun p4CoreSpeakerParked(c: int): int { if (c != channel) bad=true;return if (next(1)) 1 else 0 }
trusted fun p4CoreSpeakerBus(): int = if (next(2)) 1 else 7
trusted fun p4CoreSpeakerI2sStopped(): bool = next(3)
trusted fun p4CoreSpeakerReset(): int = if (next(4)) 1 else 7
trusted fun p4CoreSpeakerDmaPrepare(c: int): int { if (c != channel) bad=true;return if (next(5)) 1 else 7 }
trusted fun p4CoreSpeakerFormat(revision: int): int { if (revision != 100) bad=true;return if (next(6)) 1 else 7 }
trusted fun p4CoreSpeakerPins(): int = if (next(7)) 1 else 7
fun spans(d: int,n: int,b: int,s: int,bytes: int): bool = d == 0x4ff00000 && n == 3 && b == 0x4ff40000 && s == 128 && bytes == 64
trusted fun p4CoreSpeakerRing(d: int,n: int,b: int,s: int,bytes: int): bool { if (!spans(d,n,b,s,bytes)) bad=true;return next(8) }
trusted fun p4CoreSpeakerPublish(d: int,n: int,b: int,s: int,bytes: int,polls: int): int {
    if (!spans(d,n,b,s,bytes) || polls != 17) bad=true
    return if (next(9)) 1 else 7
}
@export("abla_corep4x_speaker_dma_test")
trusted fun test(): i32 {
    while (channel < 3) {
        fail=0
        while (fail <= 9) {
            step=0;bad=false
            val result=coreP4xPrepareSpeakerDmaOwned(channel,0x4ff00000,3,0x4ff40000,128,64,100,17,true)
            val expected=if (fail == 0) 1 else (fail+2)|(if (fail == 1 || fail == 3 || fail == 8) 0 else 7 << 8)
            if (result != expected || step != (if (fail == 0) 9 else fail) || bad) return i32(1)
            fail=fail+1
        }
        channel=channel+1
    }
    step=0
    if (coreP4xPrepareSpeakerDmaOwned(0,0x4ff00000,3,0x4ff40000,128,64,100,17,false) != 2 ||
        coreP4xPrepareSpeakerDmaOwned(3,0x4ff00000,3,0x4ff40000,128,64,100,17,true) != 2 ||
        coreP4xPrepareSpeakerDmaOwned(0,0x4ff00000,3,0x4ff40000,128,63,100,17,true) != 2 ||
        coreP4xPrepareSpeakerDmaOwned(0,0x4ff00000,3,0x4ff00040,128,64,100,17,true) != 2 ||
        coreP4xPrepareSpeakerDmaOwned(0,0x4ff00000,1,0x4ff40000,128,64,100,17,true) != 2 || step != 0) return i32(2)
    return i32(0)
}
