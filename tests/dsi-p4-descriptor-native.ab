import "../src/display/dsi_frame_descriptor_p4.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(256)
@export("abla_dsi_p4_descriptor_test")
trusted fun testDescriptor(): i32 {
    val base=(storage+63)&4294967232
    val descriptor=nativeBufferAt(base,64)
    val guard=nativeBufferAt(base,68)
    val frame=nativeBufferAt(805306368,33554432)
    var items=1
    while (items <= 4096) {
        var offset=0
        while (offset < 68) { guard.store(offset,165); offset=offset+1 }
        if (!esp32P4DsiFrameDescriptorPrepareOwned(descriptor,frame,items*8)) return i32(1)
        offset=0
        while (offset < 64) {
            var expected=0
            if (offset == 0) expected=805306368
            if (offset == 8) expected=1343246336
            if (offset == 16) expected=items-1
            if (offset == 24) expected=1
            if (offset == 32) expected=1973057
            if (offset == 36) expected=3222308928
            if (descriptor.loadU32(offset) != expected) return i32(2)
            offset=offset+4
        }
        if (guard.loadU32(64) != 2779096485) return i32(3)
        items=items+1
    }
    if (!esp32P4DsiFrameDescriptorPrepareOwned(descriptor,frame,33554432) || descriptor.loadU32(16) != 4194303) return i32(4)
    if (!esp32P4DsiFrameDescriptorPrepareOwned(descriptor,frame,1843200) || descriptor.loadU32(16) != 230399) return i32(5)
    var tail=1
    while (tail < 8) {
        if (esp32P4DsiFrameDescriptorPrepareOwned(descriptor,frame,8+tail)) return i32(6)
        tail=tail+1
    }
    if (esp32P4DsiFrameDescriptorPrepareOwned(descriptor,frame,0) ||
        esp32P4DsiFrameDescriptorPrepareOwned(descriptor,frame,33554440) ||
        esp32P4DsiFrameDescriptorPrepareOwned(nativeBufferAt(base+1,64),frame,8) ||
        esp32P4DsiFrameDescriptorPrepareOwned(nativeBufferAt(base,63),frame,8) ||
        esp32P4DsiFrameDescriptorPrepareOwned(descriptor,nativeBufferAt(0,8),8) ||
        esp32P4DsiFrameDescriptorPrepareOwned(descriptor,nativeBufferAt(4294967288,16),16) ||
        esp32P4DsiFrameDescriptorPrepareOwned(descriptor,nativeBufferAt(805306369,8),8) ||
        esp32P4DsiFrameDescriptorPrepareOwned(descriptor,nativeBufferAt(base+56,8),8) ||
        esp32P4DsiFrameDescriptorPrepareOwned(descriptor,nativeBufferAt(base-8,16),16)) return i32(7)
    if (descriptor.loadU32(16) != 230399 || guard.loadU32(64) != 2779096485) return i32(8)
    return i32(0)
}
