import "../src/esp32/i2s/pdm_pin_session_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this|0
fun Pin.valid(): bool = espChipS3().gpioValid(this)
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this)
val regs=nativeBufferAt(nativeStaticAllocate(24576),24576)
val original=nativeBufferAt(nativeStaticAllocate(24576),24576)
val record=nativeBufferAt(nativeStaticAllocate(56),56)
var writes=0
var drop=-1
var routeFail=-1
var routes=0
fun esp32S3PinStateRead(address: int): int = regs.loadU32(address-0x60004000)
fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes;writes=writes+1;if (step == drop) return
    if (address == 0x60004028) regs.storeU32(32,regs.loadU32(32)&~value)
    else if (address == 0x60004024) regs.storeU32(32,regs.loadU32(32)|value)
    else if (address == 0x60004008) regs.storeU32(4,regs.loadU32(4)|value)
    else if (address == 0x6000400c) regs.storeU32(4,regs.loadU32(4)&~value)
    else regs.storeU32(address-0x60004000,value)
    return
}
fun Pin.routeInputSignal(signal: int,inverted: bool): bool {
    val step=routes;routes=routes+1;if (step == routeFail) return false
    regs.storeU32(32,regs.loadU32(32)&~(1<<this))
    regs.storeU32(esp32S3GpioMuxAddress(this)-0x60004000,0x1200)
    regs.storeU32(0x154+signal*4,(regs.loadU32(0x154+signal*4)&~255)|128|(if (inverted) 64 else 0)|(this|0))
    return true
}
fun Pin.routeOutputSignal(signal: int,inverted: bool): bool {
    val step=routes;routes=routes+1;if (step == routeFail) return false
    regs.storeU32(esp32S3GpioMuxAddress(this)-0x60004000,0x1200)
    regs.storeU32(0x554+this*4,(regs.loadU32(0x554+this*4)&~4095)|signal|(if (inverted) 512 else 0))
    return true
}
fun reset(): void {
    var i=0
    while (i < 24576) { regs.storeU32(i,0x100);original.storeU32(i,0x100);i=i+4 }
    i=0;while (i < 56) { record.storeU32(i,0);i=i+4 }
    writes=0;drop=-1;routes=0;routeFail=-1;return
}
fun restored(): bool {
    var i=0
    while (i < 24576) { if (regs.loadU32(i) != original.loadU32(i)) return false;i=i+4 }
    return true
}
@export("abla_pdm_pin_session_test")
fun test(): i32 {
    val pins=pdmPins(14,10,11,12,13)
    var mask=1
    while (mask <= 255) {
        var mode=0
        while (mode < 4) {
            reset()
            if (esp32s3PdmPinsOpenOwned(record,pins,mask,(mode&1) != 0,(mode&2) != 0,true) != 1 ||
                esp32s3PdmPinsOpenOwned(record,pins,mask,false,false,true) != 0 ||
                esp32s3PdmPinsCloseOwned(record,true) != 2 || !restored()) return i32(1)
            mode=mode+1
        }
        mask=mask+1
    }
    var fault=0
    while (fault < 5) {
        reset();routeFail=fault
        if (esp32s3PdmPinsOpenOwned(record,pins,255,true,false,true) != 3 ||
            record.loadU32(12) != 3+fault || esp32s3PdmPinsCloseOwned(record,true) != 2 || !restored()) return i32(2)
        fault=fault+1
    }
    reset();esp32s3PdmPinsOpenOwned(record,pins,255,true,false,true)
    writes=0;esp32s3PdmPinsCloseOwned(record,true);val total=writes
    fault=0
    while (fault < total) {
        reset();esp32s3PdmPinsOpenOwned(record,pins,255,true,false,true);writes=0;drop=fault
        val result=esp32s3PdmPinsCloseOwned(record,true)
        if (result != 2 && result != 3) return i32(3)
        drop=-1
        if (esp32s3PdmPinsCloseOwned(record,true) != 2 || !restored()) return i32(4)
        fault=fault+1
    }
    reset()
    if (esp32s3PdmPinsCaptureOwned(record,pins,3,false,true) != 1 || writes != 0 || routes != 0 || !restored()) return i32(5)
    record.storeU32(36,0)
    if (esp32s3PdmPinsCloseOwned(record,true) != 0 || writes != 0) return i32(6)
    return i32(0)
}
