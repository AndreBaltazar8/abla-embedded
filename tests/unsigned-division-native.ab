import "../src/runtime/unsigned_division64.ab"
import "../src/esp32/runtime/libgcc_udivdi3_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
// The x86-64 oracle uses hardware division; production uses restoring shifts.
@export("abla_unsigned_division_test")
trusted fun divisionTest(): i32 {
    var state=u64(123456789)
    var index=u32(0)
    while (index < u32(20000)) {
        state=state*u64(6364136223846793005)+u64(1442695040888963407)
        val dividend=state
        state=state*u64(6364136223846793005)+u64(1442695040888963407)
        var divisor=state
        if ((index & u32(3)) == u32(0)) divisor=divisor & u64(4294967295)
        if ((index & u32(3)) == u32(1)) divisor=u64(1) << u64(index & u32(63))
        if ((index & u32(3)) == u32(2)) divisor=dividend
        if (divisor == u64(0)) divisor=u64(1)
        val expected=dividend/divisor
        if (unsignedDivide64(dividend,divisor) != expected ||
            esp32UnsignedDivide64(dividend,divisor) != expected) return i32(1)
        index=index+u32(1)
    }
    i32(0)
}
