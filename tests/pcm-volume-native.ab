import "../src/audio/pcm_volume.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(384)
@export("abla_pcm_volume_test")
trusted fun test(): i32 {
    val bank=pcmChannelsAt(nativeBufferAt(memory,256),8,16000)
    val tone=pcmToneAt(nativeBufferAt(memory+256,32),16000,440000,1)
    var level=0;var previous=-1
    while (level <= 255) {
        val volume=PcmVolume(level);val gain=volume.gainQ15()
        if (!volume.valid() || gain <= previous || gain != (level*level*32768+32512)/65025 ||
            !bank.setAllChannelVolume(volume) || !tone.setVolume(volume)) return i32(1)
        var index=0
        while (index < 8) {
            if (bank.channel(index).storage().loadU32(4) != gain) return i32(2)
            index=index+1
        }
        if (tone.storage().loadU32(16) != gain) return i32(3)
        previous=gain;level=level+1
    }
    if (PcmVolume(0).gainQ15() != 0 || PcmVolume(255).gainQ15() != 32768 ||
        PcmVolume(128).gainQ15() != 8256 || PcmVolume(-1).gainQ15() != -1 || PcmVolume(256).valid()) return i32(4)
    if (!bank.setChannelVolume(3,PcmVolume(0)) || bank.channel(2).storage().loadU32(4) != 32768 ||
        bank.channel(3).storage().loadU32(4) != 0 || bank.setChannelVolume(8,PcmVolume(0)) ||
        bank.setChannelVolume(-1,PcmVolume(0)) || bank.setAllChannelVolume(PcmVolume(256))) return i32(5)
    bank.channel(7).storage().storeU32(28,0)
    if (bank.setAllChannelVolume(PcmVolume(0)) || bank.channel(0).storage().loadU32(4) != 32768 ||
        tone.setVolume(PcmVolume(-1)) || tone.storage().loadU32(16) != 32768) return i32(6)
    return i32(0)
}
