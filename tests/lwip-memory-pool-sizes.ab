// Keep recovered lwIP pool descriptors large enough for their active ABI.

import "../tools/lib/source_text.ab"
import "abla/text"

class PoolSize(val name: string, val size: int)

fun main: int {
    val poolSource = sourceRead("src/network/lwip/memory_pools_esp32.ab")
    val expected = [
        PoolSize("RAW_PCB", 72), PoolSize("UDP_PCB", 80), PoolSize("TCP_PCB", 208),
        PoolSize("TCP_PCB_LISTEN", 76), PoolSize("TCP_SEG", 16), PoolSize("FRAG_PBUF", 24),
        PoolSize("NETBUF", 36), PoolSize("NETCONN", 60), PoolSize("TCPIP_MSG_API", 16),
        PoolSize("TCPIP_MSG_INPKT", 16), PoolSize("ARP_QUEUE", 8), PoolSize("IGMP_GROUP", 16),
        PoolSize("SYS_TIMEOUT", 16), PoolSize("NETDB", 317), PoolSize("ND6_QUEUE", 8),
        PoolSize("MLD6_GROUP", 32), PoolSize("PBUF", 16), PoolSize("PBUF_POOL", 1532)
    ]
    for (pool in expected) {
        val found = sourceFind("memp_${pool.name}_[A-Za-z0-9_]+Storage = nativeStaticBytes\\(\\x22([^\"]+)\\x22\\)", poolSource)
        if (found == null) {
            sourceFail("missing initialized descriptor for ${pool.name}")
            continue
        }
        val raw = sourceHexEscapes(sourceGroup(found, 1))
        if (raw.size != 2) {
            sourceFail("invalid descriptor width for ${pool.name}")
            continue
        }
        val actual = raw[0] + raw[1] * 256
        sourceCheck(actual == pool.size, "${pool.name}: expected ${pool.size}, got $actual")
    }

    val constructorPaths = [
        "src/network/lwip/raw_esp32.ab", "src/network/lwip/udp_esp32.ab",
        "src/network/lwip/tcp_core_esp32.ab", "src/network/lwip/netbuf_esp32.ab",
        "src/network/lwip/api_msg_esp32.ab", "src/network/lwip/pbuf_basic_esp32.ab"
    ]
    val constructorSources = [
        "freestandingSet(controlBlock, i32(0), u32(72))", "freestandingSet(controlBlock, i32(0), u32(80))",
        "freestandingSet(pcb, i32(0), u32(208))", "freestandingSet(buffer, i32(0), u32(36))",
        "freestandingSet(connection, i32(0), u32(60))", "val capacity = u32(1516) - offset"
    ]
    var index = 0
    while (index < constructorPaths.size) {
        sourceHas(sourceRead(constructorPaths[index]), constructorSources[index], "active ABI changed in ${constructorPaths[index]}")
        index = index + 1
    }

    val memberPaths = [
        "src/network/lwip/tcp_core_esp32.ab", "src/network/lwip/neighbor_discovery_ipv6_esp32.ab",
        "src/network/lwip/mld_ipv6_esp32.ab"
    ]
    val memberSources = ["listener + u32(73)", "newEntry + u32(4)", "group + u32(28)"]
    index = 0
    while (index < memberPaths.size) {
        sourceHas(sourceRead(memberPaths[index]), memberSources[index], "active member layout changed in ${memberPaths[index]}")
        index = index + 1
    }
    sourceFinish("lwIP memory-pool descriptors match all 18 active ABI sizes")
}
