import "../src/wifi/connection_logic.ab"

fun main(): int {
    var transition = wifiStationStartTransition()
    if (transition.state() != wifiConnectionScanning ||
        transition.action() != wifiConnectionRestartScan) return 1
    transition = wifiStationCandidateTransition(
        transition.state(), true, true, false
    )
    if (transition.state() != wifiConnectionAuthenticating ||
        transition.action() != wifiConnectionSendAuthentication) return 2
    val ignored = wifiStationCandidateTransition(
        wifiConnectionScanning, true, true, true
    )
    if (ignored.state() != wifiConnectionScanning ||
        ignored.action() != wifiConnectionNoAction) return 3
    transition = wifiStationAuthenticationTransition(
        transition.state(), wifiAuthenticationOpenSystem, 2, wifiStatusSuccess
    )
    if (transition.state() != wifiConnectionAssociating ||
        transition.action() != wifiConnectionSendAssociation) return 4
    transition = wifiStationAssociationTransition(
        transition.state(), wifiStatusSuccess, 42, true
    )
    if (transition.state() != wifiConnectionSecuring ||
        transition.action() != wifiConnectionStartKeyExchange) return 5
    transition = wifiStationKeysInstalledTransition(transition.state(), true)
    if (transition.state() != wifiConnectionConnected ||
        transition.action() != wifiConnectionReportConnected) return 6
    transition = wifiStationDisassociationTransition(transition.state(), 8)
    if (transition.state() != wifiConnectionAssociating ||
        transition.action() != wifiConnectionSendAssociation ||
        transition.status() != 8) return 7
    transition = wifiStationDeauthenticationTransition(transition.state(), 3)
    if (transition.state() != wifiConnectionScanning ||
        transition.action() != wifiConnectionReportDisconnected ||
        transition.status() != 3) return 8

    val sharedChallenge = wifiStationAuthenticationTransition(
        wifiConnectionAuthenticating, wifiAuthenticationSharedKey, 2, 0
    )
    val saeCommit = wifiStationAuthenticationTransition(
        wifiConnectionAuthenticating, wifiAuthenticationSaeAlgorithm, 2, 0
    )
    val saeConfirm = wifiStationAuthenticationTransition(
        wifiConnectionAuthenticating, wifiAuthenticationSaeAlgorithm, 4, 0
    )
    if (sharedChallenge.action() != wifiConnectionSendSharedKeyResponse ||
        saeCommit.action() != wifiConnectionSendSaeConfirm ||
        saeConfirm.state() != wifiConnectionAssociating ||
        saeConfirm.action() != wifiConnectionSendAssociation) return 9
    if (wifiStationAuthenticationTransition32(
        u32(2), u32(3), u32(2), u32(0)
    ) != u32(1026) || wifiStationAuthenticationTransition32(
        u32(2), u32(0), u32(2), u32(0)
    ) != u32(1283) || wifiStationAuthenticationTransition32(
        u32(2), u32(0), u32(2), u32(13)
    ) != (u32(257) | (u32(13) << u32(16)))) return 22
    val refused = wifiStationAuthenticationTransition(
        wifiConnectionAuthenticating, wifiAuthenticationOpenSystem, 2, 13
    )
    if (refused.state() != wifiConnectionScanning ||
        refused.action() != wifiConnectionRestartScan ||
        refused.status() != 13) return 10
    val invalidAid = wifiStationAssociationTransition(
        wifiConnectionAssociating, 0, 0, false
    )
    if (invalidAid.state() != wifiConnectionScanning) return 11
    val openAssociated = wifiStationAssociationTransition(
        wifiConnectionAssociating, 0, 2007, false
    )
    if (openAssociated.state() != wifiConnectionConnected ||
        openAssociated.action() != wifiConnectionReportConnected) return 12
    if (wifiConnectionTimeoutTransition(
        wifiConnectionAuthenticating, 1, 3
    ).action() != wifiConnectionSendAuthentication ||
        wifiConnectionTimeoutTransition(
            wifiConnectionAssociating, 3, 3
        ).state() != wifiConnectionScanning) return 13
    if (wifiNextScanChannel(1, 1, 13) != 2 ||
        wifiNextScanChannel(13, 1, 13) != 1 ||
        wifiNextScanChannel(0, 1, 13) != 1 ||
        wifiNextScanChannel(1, 13, 1) != 0) return 14
    if (wifiDeadlineRemainingMilliseconds(u32(100), u32(110)) != u32(10) ||
        wifiDeadlineRemainingMilliseconds(u32(100), u32(90)) != u32(0) ||
        wifiDeadlineRemainingMilliseconds(
            u32(4294967280), u32(10)
        ) != u32(26)) return 15

    transition = wifiAccessPointAuthenticationTransition(
        wifiAccessPointAbsent, wifiAuthenticationOpenSystem, 1, 0
    )
    if (transition.state() != wifiAccessPointAuthenticated ||
        transition.action() != wifiAccessPointSendAuthenticationResponse) {
        return 16
    }
    transition = wifiAccessPointAssociationTransition(
        transition.state(), true, 1, true, 0
    )
    if (transition.state() != wifiAccessPointSecuring ||
        transition.action() != wifiAccessPointBeginKeyExchange) return 17
    transition = wifiAccessPointKeysInstalledTransition(transition.state(), true)
    if (transition.state() != wifiAccessPointAuthorized ||
        transition.action() != wifiAccessPointAuthorizePeer) return 18
    transition = wifiAccessPointDisassociationTransition(transition.state(), 8)
    if (transition.state() != wifiAccessPointAuthenticated ||
        transition.status() != 8) return 19
    val apSaeCommit = wifiAccessPointAuthenticationTransition(
        wifiAccessPointAbsent, wifiAuthenticationSaeAlgorithm, 1, 0
    )
    val apSaeConfirm = wifiAccessPointAuthenticationTransition(
        apSaeCommit.state(), wifiAuthenticationSaeAlgorithm, 3, 0
    )
    if (apSaeCommit.state() != wifiAccessPointAuthenticating ||
        apSaeCommit.action() != wifiAccessPointSendSaeCommit ||
        apSaeConfirm.state() != wifiAccessPointAuthenticated ||
        apSaeConfirm.action() != wifiAccessPointSendSaeConfirm) return 20
    val apRejected = wifiAccessPointAssociationTransition(
        wifiAccessPointAuthenticated, false, 0, false, 17
    )
    if (apRejected.action() != wifiAccessPointSendAssociationFailure ||
        apRejected.status() != 17 ||
        wifiAccessPointDeauthenticationTransition(3).state() !=
            wifiAccessPointAbsent) return 21
    78
}
