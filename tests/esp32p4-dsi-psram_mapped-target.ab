import "../src/esp32/psram/timing_esp32p4.ab"
import "../src/esp32/psram/clock_esp32p4.ab"
import "../src/esp32/psram/pins_esp32p4.ab"
import "../src/esp32/psram/prepare_esp32p4.ab"
import "../src/esp32/analog/register_esp32p4.ab"
import "../src/esp32/psram/mpll_esp32p4.ab"
import "../src/esp32/psram/reset_esp32p4.ab"
import "../src/esp32/psram/tuning_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_psram_mapped_target")
trusted fun psramTarget(op: int,readDummy: int,writeDummy: int,hex16: bool,polls: int): int {
    if (op == 0) return p4PsramMappedConfigureOwned(readDummy,writeDummy,hex16,polls)
    if (op == 1) return p4PsramMappedStartOwned(readDummy,writeDummy,hex16,polls)
    if (op == 3) return p4PsramTimingConfigureOwned(readDummy,writeDummy,4,4,3,2048,hex16,polls)
    if (op == 4) return p4PsramClockOpenOwned(readDummy,writeDummy)
    if (op == 5) return P4PsramClockOwner(readDummy).closeOwned(polls)
    if (op == 6) return P4PsramClockOwner(readDummy).resumeOwned()
    if (op == 7) return p4PsramClockSelectOwned(readDummy,writeDummy,polls)
    if (op == 8) return p4PsramPinsConfigureOwned(readDummy,hex16,polls)
    if (op == 9) return P4PsramClockOwner(readDummy).prepareApControllerOwned(writeDummy,20,2,polls)
    if (op == 10) return p4AnalogRegisterOwned(0x63,readDummy,writeDummy,hex16,polls)
    if (op == 11) return p4AnalogRegisterMaskOwned(0x63,readDummy,4,5,writeDummy,polls)
    if (op == 12) return p4MpllStartColdOwned(readDummy,writeDummy,polls)
    if (op == 13) return P4MpllOwner(readDummy).closeOwned(polls)
    if (op == 14) return P4PsramClockOwner(readDummy).resetControllerOwned(polls)
    if (op == 15) return P4PsramReset(readDummy).releaseOwned()
    if (op == 16) return p4PsramTuningCandidateOwned(readDummy,p4PsramTuningDataDelay(writeDummy),p4PsramTuningDqsDelay(writeDummy),polls)
    if (op == 17) return p4PsramTuningBestWindow(readDummy,writeDummy,polls)
    return p4PsramMappedStopOwned(polls)
}
