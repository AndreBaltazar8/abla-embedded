import "../src/esp32/gpio.ab"
import "../src/m5stack/gpio_power.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_paper_power_target")
trusted fun paperTarget(board: M5BoardId,enabled: bool,mode: int): int {
    if (mode == 0) return if (board.preparePaperExternalOutput(enabled)) 1 else 0
    if (mode == 1) return if (board.setPaperExternalOutput(enabled)) 1 else 0
    board.paperExternalOutputChecked() | 0
}
