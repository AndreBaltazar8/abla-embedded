import "../src/esp32/irq_runtime_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_irq_runtime_target")
@section(".iram1.abla.s3IrqRuntimeTarget")
trusted fun runtimeTarget(stack: NativeBuffer,table: NativeBuffer,record: NativeBuffer,core: int,fault: int,context: int,release: bool): bool =
    if (release) esp32S3IrqRuntimeReleaseOwned(record,core) else esp32S3IrqRuntimeInitializeOwned(stack,table,record,core,fault,context)
