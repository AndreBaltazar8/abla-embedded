import "../src/esp32/psram/flash_dummy_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val dummyRegisters=nativeStaticAllocate(24)
var dummyPointer=0x3fc90000
var dummy0=0
var dummy1=0
var dummyWrites=0
var dummyFail=0
var dummyBusy=false
var dummyBad=false
fun s3FlashLegacyPointer(): int = dummyPointer
fun s3FlashDummyByteRead(address: int): int {
    if (address == 0x3fc90018) return dummy0
    if (address == 0x3fc90019) return dummy1
    dummyBad=true;return 0
}
fun s3FlashDummyByteWrite(address: int,value: int): void {
    dummyWrites=dummyWrites+1
    val stored=if (dummyWrites == dummyFail) value^1 else value
    if (address == 0x3fc90018) dummy0=stored else if (address == 0x3fc90019) dummy1=stored else dummyBad=true
    return
}
fun dummySlot(address: int): int = if (address == 0x60003018) 0 else if (address == 0x6000301c) 1 else if (address == 0x600030a8) 2 else if (address == 0x60002018) 3 else if (address == 0x6000201c) 4 else if (address == 0x600020a8) 5 else -1
fun s3PsramCsRead(address: int): int {
    if (address == 0x60002000 || address == 0x60003000) return if (dummyBusy) 0x40000 else 0
    val slot=dummySlot(address)
    if (slot < 0) { dummyBad=true;return 0 }
    return nativeAddressLoadU32(dummyRegisters,slot*4)
}
fun s3PsramCsWrite(address: int,value: int): void {
    val slot=dummySlot(address)
    if (slot < 0) { dummyBad=true;return }
    dummyWrites=dummyWrites+1
    nativeAddressStoreU32(dummyRegisters,slot*4,if (dummyWrites == dummyFail) value^1 else value)
    return
}
@export("abla_s3_flash_dummy_test")
fun testFlashDummy(): int {
    var profile=0
    while (profile < 128) {
        val octal=(profile&1) != 0;val extra=(profile>>>1)&7
        val original0=profile&15;val original1=(profile>>>4)&7
        val count=if (octal) 4 else 8
        dummyFail=0
        while (dummyFail <= count) {
            var i=0
            while (i < 6) { nativeAddressStoreU32(dummyRegisters,i*4,0xa55a5abf);i=i+1 }
            dummy0=original0;dummy1=original1;dummyPointer=0x3fc90000;dummyWrites=0;dummyBusy=false;dummyBad=false
            if (s3FlashDummyBaselineOwned(true) != (original0|(original1<<8))) return 1
            if (s3FlashDummyOwned(octal,5,original0,original1,extra,true) != (if (dummyFail == 0) 1 else 4) ||
                dummyWrites != (if (dummyFail == 0) count else dummyFail) || dummyBad) return 2
            if (dummyFail == 0) {
                var port=0
                while (port < 2) {
                    val addition=(if (port == 0) original0 else original1)+extra
                    val user=nativeAddressLoadU32(dummyRegisters,port*12)
                    val user1=nativeAddressLoadU32(dummyRegisters,port*12+4)
                    val cal=nativeAddressLoadU32(dummyRegisters,port*12+8)
                    if (octal) {
                        if (user != 0xa55a5abf || user1 != 0xa55a5abf ||
                            cal != ((0xa55a5abf&0xffffffe1)|(if (extra == 0) 0 else 2)|(extra<<2)) ||
                            dummy0 != original0 || dummy1 != original1) return 3
                    } else {
                        if (cal != (0xa55a5abf&0xffffffe1) || user != (0xa55a5abf|0x20000000) ||
                            user1 != ((0xa55a5abf&0xffffffc0)|(5+addition))) return 4
                    }
                    port=port+1
                }
                // Zero extra restores original additions, never accumulates.
                if (s3FlashDummyOwned(octal,5,original0,original1,0,true) != 1 || dummy0 != original0 || dummy1 != original1) return 5
            }
            dummyFail=dummyFail+1
        }
        profile=profile+1
    }
    dummyWrites=0;dummyFail=0;dummyBusy=false;dummyPointer=0
    if (s3FlashDummyBaselineOwned(true) != -1 || s3FlashDummyOwned(false,5,0,0,0,true) != 2 || dummyWrites != 0) return 6
    dummyPointer=0x3fc90000
    if (s3FlashDummyOwned(false,63,1,0,0,true) != 2 || s3FlashDummyOwned(true,5,0,0,8,true) != 2 ||
        s3FlashDummyOwned(false,5,0,0,0,false) != 2 || dummyWrites != 0) return 7
    dummyBusy=true
    if (s3FlashDummyOwned(false,5,0,0,0,true) != 3 || dummyWrites != 0) return 8
    return 0
}
