import "../src/m5stack/cores3_audio_dma.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun coreS3AudioDmaTarget(transmit: bool, rate: i32, channel: i32, descriptors: u32, buffers: u32, owner: u32): i32 =
    i32(coreS3PrepareAudioDma(transmit, int(rate), int(channel), int(descriptors), 6, int(buffers), 960, owner).status())
