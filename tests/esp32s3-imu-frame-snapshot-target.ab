import "../src/esp32/i2c_esp32s3.ab"
import "../src/imu/frame_snapshot.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_frame_snapshot_target")
trusted fun snapshotTarget(snapshot: ImuSnapshot,device: I2cDevice,frame: NativeBuffer,micros: int,sh200q: bool): int =
    if (sh200q) snapshot.updateSh200q(device,frame,micros) else snapshot.updateMpu6886(device,frame,micros)
