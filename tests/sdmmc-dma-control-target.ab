import "../src/sd/mmc_dma_control_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_dma_control_target")
trusted fun target(operation: int,descriptors: int,payload: int,bytes: int,block: int,exclusive: bool,clocksReady: bool): int {
    if (operation == 0) return sdMmcDmaArmOwned(nativeBufferAt(descriptors,2048),nativeBufferAt(payload,bytes),bytes,block,exclusive)
    if (operation == 1) return sdMmcDmaStopOwned(exclusive,clocksReady)
    return sdMmcDmaStopPollOwned(operation)
}
