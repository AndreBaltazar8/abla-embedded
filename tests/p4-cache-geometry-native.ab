import "../src/esp32/cache_geometry_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var size=512
var line=8
var reads=0
fun p4CacheGeometryRead(offset: int): int { reads=reads+1; return if (offset == 632) size else if (offset == 636) line else 0 }
@export("abla_p4_cache_geometry_test")
fun geometryTest(): i32 {
    var raw=0
    while (raw < 8192) {
        val expected=if (raw == 512) 131072 else if (raw == 1024) 262144 else if (raw == 2048) 524288 else 0
        if (p4CacheL2SizeFromRaw(raw) != expected || p4CacheL2SizeFromRaw(raw|0xffffe000) != expected) return i32(1)
        raw=raw+1
    }
    raw=0
    while (raw < 64) {
        val expected=if (raw == 8) 64 else if (raw == 16) 128 else 0
        if (p4CacheL2LineFromRaw(raw) != expected || p4CacheL2LineFromRaw(raw|0xffffffc0) != expected) return i32(2)
        line=raw
        if (p4CacheL2GeometryMatches(64) != (raw == 8) || p4CacheL2GeometryMatches(128) != (raw == 16)) return i32(3)
        raw=raw+1
    }
    size=1536; line=8
    if (p4CacheL2GeometryMatches(64)) return i32(4)
    reads=0
    if (p4CacheL2GeometryMatches(32) || reads != 0) return i32(5)
    return i32(0)
}
