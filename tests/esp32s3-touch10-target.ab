import "../src/input/touch10.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
@export("abla_s3_touch10_target")
trusted fun target(tracker: TouchTracker10,frame: NativeBuffer,count: int,now: int): int = tracker.updateControllerFrame(frame,count,now)
