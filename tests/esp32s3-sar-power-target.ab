import "../src/esp32/sar_power_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sar_power_target")
@section(".iram1.abla.s3SarTarget")
trusted fun sarTarget(operation: int,value: int): int {
    if (operation == 0) return if (esp32S3SarPowerSetOwned(value)) 1 else 0
    if (operation == 1) return if (esp32S3SarPwdetPowerSetOwned(value)) 1 else 0
    if (operation == 2) return esp32S3SleepSarPrepareOwned(value != 0) | 0
    if (esp32S3SleepSarRestoreOwned(Esp32S3SleepSar(value))) 1 else 0
}
