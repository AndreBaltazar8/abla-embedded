import "../src/esp32/gdma_linear_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var bytes = 4
var writes = 0
var fences = 0
var bad = false
trusted fun esp32s3GdmaWrite(address: int, value: int): void {
    val node = writes / 3
    val part = writes % 3
    val base = 0x3fc88000 + node * 12
    val remaining = bytes - node * 4092
    val length = if (remaining > 4092) 4092 else remaining
    if (part == 0) {
        if (address != base + 4 || value != 0x3fc90000 + node * 4092) bad = true
    } else if (part == 1) {
        if (address != base + 8 || value != (if (remaining <= 4092) 0 else base + 12)) bad = true
    } else {
        if (address != base || (value & 4095) != length || ((value >>> 12) & 4095) != length ||
            (value & 0x80000000) == 0 || ((value & 0x40000000) != 0) != (remaining <= 4092)) bad = true
    }
    writes = writes + 1
    return
}
trusted fun esp32s3GdmaPublish(): void { fences = fences + 1; if (writes != ((bytes + 4091) / 4092) * 3) bad = true; return }
trusted fun gdmaLinearTest(): int {
    while (bytes <= 12280) {
        writes = 0; fences = 0
        val count = esp32s3GdmaInitializeTxChainOwned(0x3fc88000, 0x3fc90000, bytes)
        if (count != (bytes + 4091) / 4092 || writes != count * 3 || fences != 1 || bad) return 1
        bytes = bytes + 4
    }
    writes = 0; fences = 0
    if (esp32s3GdmaInitializeTxChainOwned(0x3fc90000, 0x3fc90000, 4092) != 0 ||
        esp32s3GdmaInitializeTxChainOwned(0x3fc88000, 0x3fcffffc, 8) != 0 ||
        esp32s3GdmaInitializeTxChainOwned(0x3fcffff4, 0x3fc90000, 4096) != 0 ||
        esp32s3GdmaInitializeTxChainOwned(0x3fc88001, 0x3fc90000, 4) != 0 ||
        esp32s3GdmaInitializeTxChainOwned(0x3fc88000, 0x3fc90000, 3) != 0 || writes != 0 || fences != 0) return 2
    if (!esp32s3GdmaLinearTxLayoutValid(0x3fcffff4, 0x3fc90000, 4) ||
        esp32s3GdmaLinearTxCount(9223372036854775807) != 0) return 3
    0
}
#exportFunction("gdmaLinearTest", "abla_gdma_linear_test")
