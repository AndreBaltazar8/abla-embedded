import "../src/sd/selected_command.ab"
import "abla/build"
val memory=nativeStaticAllocate(16)
var calls=0
var failed=0
var selectedCommand=0
var selectedArgument=0
var response=1
var bad=false
fun sdSpiSelectedAdmission(context: int,scratch: NativeBuffer,trailing: NativeBuffer,bytes: int): bool = context == 123
fun sdSpiSelectedExchange(context: int,value: int,scratch: NativeBuffer): int {
    calls=calls+1
    val index=calls-1
    val expected=if (index == 0) 64|selectedCommand else if (index == 5) sdSpiCommandFrameCrc(selectedCommand,selectedArgument)
        else if (index < 5) (selectedArgument>>>((4-index)*8))&255 else 255
    if (value != expected || context != 123) bad=true
    if (calls == failed) return 263
    val input=if (selectedCommand == 12 && calls == 7) 0 else if (calls < 9 || response == 255) 255 else if (calls == 9) response else 16+calls-10
    return (1<<32)|input
}
@export("abla_sd_selected_command_test")
trusted fun testCommand(): i32 {
    val scratch=nativeBufferAt(memory,2);val trailing=nativeBufferAt(memory+4,4)
    if (sdSpiCommandFrameCrc(0,0) != 149 || sdSpiCommandFrameCrc(8,426) != 135) return i32(1)
    while (selectedCommand < 64) {
        selectedArgument=0x89abcdef
        failed=0;calls=0;response=1;bad=false
        val result=sdSpiCommandSelected(123,selectedCommand,selectedArgument,scratch,trailing,4)
        if (!result.valid() || result.r1() != 1 || result.trailingBytes() != 4 || calls != 13 || bad) return i32(2)
        var index=0
        while (index < 4) { if (trailing.load(index) != 16+index) return i32(3);index=index+1 }
        selectedCommand=selectedCommand+1
    }
    selectedCommand=8;selectedArgument=426
    failed=1
    while (failed <= 13) {
        calls=0;bad=false
        val result=sdSpiCommandSelected(123,8,426,scratch,trailing,4)
        if (result.status() != 4 || result.transportDetail() != 263 || calls != failed ||
            result.trailingBytes() != (if (failed >= 10) failed-10 else 0) || bad) return i32(4)
        failed=failed+1
    }
    calls=0;failed=0;response=5
    val rejected=sdSpiCommandSelected(123,8,426,scratch,trailing,4)
    if (!rejected.valid() || rejected.r1() != 5 || rejected.trailingBytes() != 0 || calls != 9) return i32(5)
    calls=0;response=255
    // After the configured response, keep all bytes busy for timeout test.
    val timeout=sdSpiCommandSelected(123,8,426,scratch,trailing,0)
    if (timeout.status() != 3 || calls != 14) return i32(6)
    calls=0
    if (sdSpiCommandSelected(123,8,426,scratch,nativeBufferAt(memory+1,4),4).status() != 2 ||
        sdSpiCommandSelected(0,8,426,scratch,trailing,4).status() != 2 ||
        sdSpiCommandSelected(123,64,426,scratch,trailing,4).status() != 2 || calls != 0) return i32(7)
    return i32(0)
}
