import "../src/esp32/psram/pin_config_s3.ab"
import "../src/esp32/psram/pin_config_read_s3_sequence.ab"
import "abla/build"
var pcSys1=0
var pcSys2=0
var pcSys3=0
var pcReads=0
var pcBad=false
fun s3MspiEfuseRead(address: int): int {
    if (address != 0x60007048+pcReads*4) pcBad=true
    pcReads=pcReads+1
    return if (address == 0x60007048) pcSys1 else if (address == 0x6000704c) pcSys2 else pcSys3
}
@export("abla_s3_mspi_pin_config_test")
fun testMspiPinConfig(): int {
    var role=0
    while (role < 12) {
        if (s3MspiConfiguredPin(role,0,63,0) != s3MspiDefaultPin(role)) return 1
        var pin=0
        while (pin < 64) {
            if (role < 5) {
                val config=(pin<<(role*6))|(1<<(((role+1)%5)*6))
                if (s3MspiConfiguredPin(role,config,63,0) != pin) return 2
            } else if (role == 5) {
                if (s3MspiConfiguredPin(role,0,pin,0) != (if (pin == 63) 28 else pin)) return 3
            } else if (role < 11) {
                val slot=role-6
                val config=(pin<<(slot*6))|(1<<(((slot+1)%5)*6))
                val sys2=(config&4095)<<20|0xabcde
                val sys3=(config>>>12)|0xfffc0000
                if (s3MspiOpiConfig(sys2,sys3) != config || s3MspiConfiguredPin(role,0,63,config) != pin) return 4
            } else if (s3MspiConfiguredPin(role,1,pin,1) != 26) return 5
            pin=pin+1
        }
        role=role+1
    }
    if (s3MspiOpiConfig(0xfffff,0xfffc0000) != 0 || s3MspiOpiConfig(0xffffffff,0xffffffff) != 0 ||
        s3MspiConfiguredPin(-1,0,63,0) != -1 || s3MspiConfiguredPin(12,0,63,0) != -1 ||
        s3MspiConfiguredPin(0,0,64,0) != -1 || s3MspiConfiguredPin(0,-1,63,0) != -1 ||
        s3MspiConfiguredPin(0,0,63,0x40000000) != -1) return 6
    if (s3MspiDefaultPin(0) != 30 || s3MspiDefaultPin(1) != 31 || s3MspiDefaultPin(2) != 32 ||
        s3MspiDefaultPin(3) != 29 || s3MspiDefaultPin(4) != 27 || s3MspiDefaultPin(5) != 28 ||
        s3MspiDefaultPin(6) != 37 || s3MspiDefaultPin(7) != 33 || s3MspiDefaultPin(8) != 34 ||
        s3MspiDefaultPin(9) != 35 || s3MspiDefaultPin(10) != 36 || s3MspiDefaultPin(11) != 26) return 7
    var slot=0
    while (slot < 6) {
        var pin=0
        while (pin < 64) {
            val raw=(pin<<(slot*6))|(1<<(((slot+1)%6)*6))
            pcSys1=((raw&65535)<<16)|0xa55a
            pcSys2=(raw>>>16)|0xa5a00000;pcSys3=0xfffc1234
            if (s3MspiFlashPinConfig(pcSys1,pcSys2) != raw) return 8
            role=0
            while (role < 12) {
                pcReads=0;pcBad=false
                val expected=s3MspiConfiguredPin(role,raw&0x3fffffff,raw>>>30,s3MspiOpiConfig(pcSys2,pcSys3))
                if (s3MspiReadConfiguredPin(role) != expected || pcReads != 3 || pcBad) return 9
                role=role+1
            }
            pin=pin+1
        }
        slot=slot+1
    }
    if (s3MspiFlashPinConfig(0x0000ffff,0xfff00000) != 0xfc0000000 ||
        s3MspiFlashPinConfig(0xffff0000,0x000fffff) != 0xfc0000000 ||
        s3MspiFlashPinConfig(0xffff0000,0x00003fff) != 0x3fffffff ||
        s3MspiFlashPinConfig(0,0x000fc000) != 0xfc0000000 ||
        s3MspiFlashPinConfig(0,0x00004000) != 0x40000000) return 10
    pcReads=0
    if (s3MspiReadConfiguredPin(-1) != -1 || s3MspiReadConfiguredPin(12) != -1 || pcReads != 0) return 11
    return 0
}
