fun paperMonoFatDestinationSafe(owner: PaperMonoSdOwner,destination: NativeBuffer): bool = paperSafe
var unexpectedSystem=false
trusted fun sdMmcS3SystemRead(address: int): int { unexpectedSystem=true; return 0 }
trusted fun sdMmcS3SystemWrite(address: int,value: int): void { unexpectedSystem=true; return }
var tick=0
var commands=0
var stalled=false
var failed=false
var clockFailed=false
var badAddress=false
var scrWord=0x502
var commandSequence=0
var clockUpdates=0
var dropClock=false
trusted fun sdMmcS3Read(offset: int): int = nativeBufferAt(registers,4096).loadU32(offset)
trusted fun reg(offset: int,value: int): void { nativeBufferAt(registers,4096).storeU32(offset,value); return }
trusted fun sdMmcS3Write(offset: int,value: int): void {
    if (dropClock && offset == 2048) return
    reg(offset,if (offset == 68 || offset == 140) sdMmcS3Read(offset)&~value else value)
    if (offset == 44) commands=commands+1
    return
}
trusted fun sdMmcDmaS3Read(address: int): int {
    if (address >= 0x3fc88000 && address < 0x3fc88010) return nativeBufferAt(dma,16).loadU32(address-0x3fc88000)
    if (address >= 0x3fc89000 && address < 0x3fc89200) return nativeBufferAt(dma+16,512).loadU32(address-0x3fc89000)
    badAddress=true; return 0
}
trusted fun sdMmcDmaS3Write(address: int,value: int): void {
    if (address >= 0x3fc88000 && address < 0x3fc88010) nativeBufferAt(dma,16).storeU32(address-0x3fc88000,value)
    else badAddress=true
    return
}
trusted fun fatSdMmcNowMilliseconds(): int {
    if (clockFailed) return -1
    tick=tick+1
    if (!stalled) {
        if ((sdMmcS3Read(44)&0x80000000) != 0) {
            val command=sdMmcS3Read(44)&63
            if ((sdMmcS3Read(44)&(1<<21)) != 0) {
                clockUpdates=clockUpdates+1; reg(44,0)
            } else if (command != 17) {
                commandSequence=(commandSequence<<6)|command
                reg(44,0); reg(68,if (failed) 128 else if (command == 51) 12 else 4)
                reg(48,if (command == 55) 0x920 else 0x900)
                if (command == 51) {
                    reg(140,258); sdMmcDmaS3Write(0x3fc88000,28)
                    nativeBufferAt(dma+16,512).storeU32(0,scrWord)
                }
            } else {
            reg(44,0); reg(68,if (failed) 128 else 12); reg(140,258); reg(48,0x900)
            sdMmcDmaS3Write(0x3fc88000,28)
            val bytes=nativeBufferAt(dma+16,512)
            var index=0
            while (index < 512) { bytes.store(index,0); index=index+1 }
            bytes.store(510,85); bytes.store(511,170)
            if (sdMmcS3Read(40) == 0) {
                bytes.store(450,6); bytes.storeU32(454,2048); bytes.storeU32(458,11000)
            } else if (sdMmcS3Read(40) == 2129) {
                bytes.storeU32(0,0x54534554); bytes.storeU32(4,0x20202020)
                bytes.store(8,84); bytes.store(9,88); bytes.store(10,84)
                bytes.storeU16(26,2); bytes.storeU32(28,3)
            } else if (sdMmcS3Read(40) == 2161) {
                bytes.store(0,97); bytes.store(1,98); bytes.store(2,99)
            } else {
                bytes.store(12,2); bytes.store(13,1); bytes.store(14,1); bytes.store(16,2); bytes.store(18,2)
                bytes.store(22,40); bytes.store(19,129); bytes.store(20,39)
            }
            }
        }
        if ((sdMmcS3Read(0)&4) != 0) reg(0,sdMmcS3Read(0)&~4)
    }
    return tick
}
trusted fun initialize(polls: int): bool {
    var index=0
    while (index < 4096) { nativeBufferAt(registers,4096).store(index,0); index=index+1 }
    val card=nativeBufferAt(storage+32,80)
    index=0
    while (index < 80) { card.store(index,0); index=index+1 }
    card.storeU32(0,0x53444901); card.storeU32(24,0xc0ff8000)
    card.storeU32(28,1)
    card.storeU32(60,0x40000000); card.storeU32(56,0x9003f); card.storeU32(52,0xffff0000)
    tick=0; commands=0; stalled=false; failed=false; clockFailed=false
    commandSequence=0; scrWord=0x502; clockUpdates=0; dropClock=false
    return fatSdMmcReaderInitialize(nativeBufferAt(storage,28),card,nativeBufferAt(storage+112,52),nativeBufferAt(0x3fc88000,16),nativeBufferAt(0x3fc89000,512),100, polls,true)
}
@export("abla_fat_sdmmc_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(storage,28)
    val session=nativeBufferAt(storage+112,52)
    val boot=nativeBufferAt(storage+192,512)
    val scratch=nativeBufferAt(storage+704,512)
    if (!initialize(100)) return i32(1)
    val mounted=fatMountReadOwned(reader,4294967296,0,boot,scratch)
    if (!mounted.valid() || mounted.firstSector() != 2048 || mounted.sectors() != 10113 || commands != 2 || session.loadU32(48) != 0 || badAddress) return i32(2)
    val unicodeWork=nativeBufferAt(nativeStaticAllocate(2067),2067)
    val utf8Path=nativeBufferAt(nativeStaticAllocate(8),8)
    val converted=nativeBufferAt(nativeStaticAllocate(16),16)
    val unicodeOutput=nativeBufferAt(nativeStaticAllocate(512),512)
    utf8Path.storeU32(0,0x74736574); utf8Path.storeU32(4,0x7478742e)
    unicodeOutput.storeU32(0,0xeeeeeeee)
    if (fatSdMmcReadPathUtf8Owned(reader,boot,2048,10113,utf8Path,8,converted,0,512,100,unicodeOutput,unicodeWork) != 3 ||
        unicodeOutput.loadU32(0) != 0xee636261 || commands != 4 || session.loadU32(48) != 0 || badAddress) return i32(30)
    // Conversion and scratch aliases are rejected before any DMA/MMIO read.
    val prior=commands
    var regionIndex=0
    while (regionIndex < 5) {
        val address=if (regionIndex == 0) storage else if (regionIndex == 1) storage+32 else if (regionIndex == 2) storage+112 else if (regionIndex == 3) 0x3fc88000 else 0x3fc89000
        if (fatSdMmcReadPathUtf8Owned(reader,boot,2048,10113,utf8Path,8,nativeBufferAt(address,16),0,512,100,unicodeOutput,unicodeWork) != -1 || commands != prior) return i32(31)
        regionIndex=regionIndex+1
    }
    session.storeU32(48,1)
    if (fatSdMmcReadPathUtf8Owned(reader,boot,2048,10113,utf8Path,8,converted,0,512,100,unicodeOutput,unicodeWork) != -1 || commands != prior) return i32(32)
    session.storeU32(48,0)
    initialize(100); failed=true
    boot.storeU32(0,0xdeadbeef)
    if (fatStorageReadOwned(reader,1,boot) || boot.loadU32(0) != 0xdeadbeef || session.loadU32(48) != 2) return i32(3)
    val before=commands
    if (fatStorageReadOwned(reader,1,boot) || commands != before) return i32(4)
    initialize(1); stalled=true
    if (fatStorageReadOwned(reader,1,boot) || session.loadU32(48) != 1 || boot.loadU32(0) != 0xdeadbeef) return i32(5)
    clockFailed=true
    if (fatSdMmcDrainOwned(reader) != -1 || session.loadU32(48) != 1) return i32(12)
    clockFailed=false
    stalled=false
    var n=0
    while (session.loadU32(48) == 1 && n < 10) { fatSdMmcDrainOwned(reader); n=n+1 }
    if (session.loadU32(48) != 2 || boot.loadU32(0) != 0xdeadbeef || fatStorageReadOwned(reader,1,boot)) return i32(6)
    initialize(100); clockFailed=true
    if (fatStorageReadOwned(reader,1,boot) || commands != 0 || session.loadU32(48) != 0) return i32(7)
    initialize(100)
    if (fatStorageReadOwned(reader,1,nativeBufferAt(storage+32,512)) || fatStorageReadOwned(reader,1,nativeBufferAt(0x3fc89000,512)) || commands != 0) return i32(8)
    if (fatSdMmcReaderInitialize(reader,nativeBufferAt(storage+32,80),nativeBufferAt(storage,52),nativeBufferAt(0x3fc88000,16),nativeBufferAt(0x3fc89000,512),100,100,true)) return i32(9)
    // Exact division reference includes micros wrap, millis wrap and 52-bit max.
    var ticks=0
    while (ticks <= 4503599627370495) {
        if (fatSdMmcMillisecondsFromTicks(ticks) != ((ticks/16000)&4294967295)) return i32(10)
        if (ticks == 4503599627370495) break
        ticks=if (ticks == 0) 15999 else if (ticks*3+1 > 4503599627370495) 4503599627370495 else ticks*3+1
    }
    if (fatSdMmcMillisecondsFromTicks(68719476735999) != 4294967295 || fatSdMmcMillisecondsFromTicks(68719476736000) != 0 || fatSdMmcMillisecondsFromTicks(-1) != -1) return i32(11)
    // Exercise the callable example's production session through MBR, BPB,
    // root lookup and file data, not a replacement storage hook.
    initialize(100)
    val example=nativeBufferAt(exampleStorage,2304)
    n=0
    while (n < 2304) { example.store(n,0); n=n+1 }
    n=0
    while (n < 80) { example.store(48+n,nativeBufferAt(storage+32,80).load(n)); n=n+1 }
    example.storeU32(0,0x53445301); example.storeU32(2280,0x3fc88000); example.storeU32(2284,0x3fc89000); example.storeU32(2288,2)
    val er=nativeBufferAt(exampleStorage+180,28)
    if (!fatSdMmcReaderInitialize(er,nativeBufferAt(exampleStorage+48,80),nativeBufferAt(exampleStorage+128,52),nativeBufferAt(0x3fc88000,16),nativeBufferAt(0x3fc89000,512),100,100,true)) return i32(13)
    val path=nativeBufferAt(exampleStorage+2304,8)
    path.storeU32(0,0x54534554); path.storeU32(4,0x5458542e)
    val output=nativeBufferAt(exampleStorage+2320,512)
    output.storeU32(0,0xeeeeeeee)
    if (sdMmcFatExampleRead(example,path,8,output,0,0,100) != 3 || output.loadU32(0) != 0xee636261 || commands != 4 || example.loadU32(2288) != 2) return i32(14)
    if (sdMmcFatExampleRead(example,path,8,output,0,3,100) != 0 || sdMmcFatExampleRead(example,path,8,nativeBufferAt(exampleStorage,512),0,0,100) != -1) return i32(15)
    failed=true; output.store(0,42)
    if (sdMmcFatExampleRead(example,path,8,output,0,0,100) != -303 || output.load(0) != 42 || example.loadU32(2288) != 3 || sdMmcFatExampleRead(example,path,8,output,0,0,100) != -1) return i32(16)
    if (unexpectedSystem) return i32(17)
    // Real SCR -> ACMD6 -> CMD13 negotiation before binding the FAT reader.
    initialize(100); reg(16,1)
    n=0
    while (n < 2304) { example.store(n,0); n=n+1 }
    n=0
    while (n < 80) { example.store(48+n,nativeBufferAt(storage+32,80).load(n)); n=n+1 }
    example.storeU32(0,0x53445301); example.storeU32(2280,0x3fc88000); example.storeU32(2284,0x3fc89000); example.storeU32(2288,1)
    if (sdMmcFatWideBegin(example,u32(0)) != 0) return i32(18)
    var wide=0
    n=0
    while (wide == 0 && n < 100) {
        if (commands < 4 && sdMmcS3Read(24) != 0) return i32(19)
        val now=fatSdMmcNowMilliseconds()
        wide=if (example.loadU32(2288) == 10) sdMmcFatExamplePoll(example,u32(now),u32(now*1000)) else sdMmcFatWidePoll(example,u32(now)); n=n+1
    }
    if (wide != 1 || example.loadU32(2288) != 2 || sdMmcS3Read(24) != 1 || commands != 12 || clockUpdates != 6 || commandSequence != ((((((55<<6)|51)<<6|55)<<6|6)<<6|13)<<6|13)) return i32(20)
    if (example.loadU32(40) != 20000000 || sdMmcS3Read(20) != ((12000000<<8)|255)) return i32(24)
    if (!fatSdMmcReaderValid(er) || sdMmcFatExampleRead(example,path,8,output,0,0,100) != 3) return i32(21)
    // Unsupported requested width fails before any FAT binding or ACMD6.
    initialize(100); reg(16,1); scrWord=0x102
    n=128
    while (n < 208) { example.store(n,0); n=n+1 }
    example.storeU32(2288,1)
    if (sdMmcFatWideBegin(example,u32(0)) != 0) return i32(22)
    wide=0; n=0
    while (wide == 0 && n < 100) { wide=sdMmcFatWidePoll(example,u32(fatSdMmcNowMilliseconds())); n=n+1 }
    if (wide != -903 || example.loadU32(2288) != 3 || fatSdMmcReaderValid(er) || commands != 2 || sdMmcS3Read(24) != 0) return i32(23)
    // Base one-bit poll promotes too; PLL160 plan reaches 160M/7 safely.
    initialize(100); reg(16,1)
    n=128
    while (n < 208) { example.store(n,0); n=n+1 }
    example.store(6,1); example.storeU32(2288,1)
    wide=sdMmcFatExamplePoll(example,u32(0),u32(0)); n=0
    while (wide == 0 && n < 100) {
        val now=fatSdMmcNowMilliseconds()
        wide=sdMmcFatExamplePoll(example,u32(now),u32(now*1000)); n=n+1
    }
    if (wide != 1 || commands != 7 || clockUpdates != 6 || sdMmcS3Read(24) != 0 || example.loadU32(40) != 22857143 || !fatSdMmcReaderValid(er)) return i32(27)
    if (sdMmcFatExampleRead(example,path,8,output,0,0,100) != 3) return i32(28)
    // One-bit promotion also gates FAT; a dropped source write cannot bind it.
    initialize(100); reg(16,1); dropClock=true
    n=128
    while (n < 208) { example.store(n,0); n=n+1 }
    example.storeU32(2288,1)
    if (sdMmcFatSpeedBegin(example,u32(0)) != 0 || sdMmcFatExampleClose(example) != -1) return i32(25)
    wide=0; n=0
    while (wide == 0 && n < 100) {
        val now=fatSdMmcNowMilliseconds()
        wide=sdMmcFatExamplePoll(example,u32(now),u32(now*1000)); n=n+1
    }
    if (wide != -1105 || example.loadU32(2288) != 3 || fatSdMmcReaderValid(er) || clockUpdates != 3 || sdMmcS3Read(16) != 0) return i32(26)
    initialize(100)
    val paper=paperMonoSdOwnerAt(nativeBufferAt(paperOwnerStorage,432))
    if (!paper.initializeFresh()) return i32(29)
    paper.buffer().storeU32(4,1)
    var at=0
    while (at < 80) { nativeBufferAt(paperOwnerStorage+80,80).store(at,nativeBufferAt(storage+32,80).load(at));at=at+1 }
    if (!paperMonoFatReaderInitialize(reader,paper,session,nativeBufferAt(0x3fc88000,16),nativeBufferAt(0x3fc89000,512),100,100,true) ||
        !paperMonoFatReadOwned(reader,0,boot) || commands != 1 || session.loadU32(48) != 0) return i32(30)
    val beforePaper=commands
    var state=0
    while (state <= 7) {
        if (state != 1) {
            paper.buffer().storeU32(4,state)
            if (paperMonoFatReadOwned(reader,0,boot) || commands != beforePaper) return i32(31)
        }
        state=state+1
    }
    paper.buffer().storeU32(4,1);paperReady=false
    if (paperMonoFatReadOwned(reader,0,boot) || commands != beforePaper) return i32(32)
    paperReady=true;paperSafe=false
    if (paperMonoFatReadOwned(reader,0,boot) || commands != beforePaper) return i32(33)
    paperSafe=true
    if (paperMonoFatReadOwned(reader,0,nativeBufferAt(paperOwnerStorage+224,512)) || commands != beforePaper) return i32(34)
    // Exhausted poll budget retains DMA; drain after owner leaves ready state.
    reader.storeU32(20,1);stalled=true;boot.storeU32(0,0xdeadbeef)
    if (paperMonoFatReadOwned(reader,0,boot) || session.loadU32(48) != 1 || boot.loadU32(0) != 0xdeadbeef) return i32(35)
    paper.buffer().storeU32(4,5);stalled=false
    var drained=2;at=0
    while (drained == 2 && at < 100) { drained=paperMonoFatDrainOwned(reader);at=at+1 }
    if (drained == 2 || session.loadU32(48) != 2 || boot.loadU32(0) != 0xdeadbeef || paperMonoFatReadOwned(reader,0,boot) || paperUnexpected) return i32(36)
    return i32(0)
}
