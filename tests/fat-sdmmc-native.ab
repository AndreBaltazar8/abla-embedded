val storage=nativeStaticAllocate(1280)
val registers=nativeStaticAllocate(4096)
val dma=nativeStaticAllocate(528)
val exampleStorage=nativeStaticAllocate(2832)
val paperOwnerStorage=nativeStaticAllocate(432)
var paperReady=true
var paperSafe=true
var paperUnexpected=false
fun paperMonoSdOwnerAdmission(control: int,storage: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer): bool { paperUnexpected=true;return false }
fun paperMonoSdOwnerBegin(control: int,startup: NativeBuffer,pads: NativeBuffer,slot: int,pll: bool,now: u32,budget: int): int { paperUnexpected=true;return 3 }
fun paperMonoSdOwnerStartupPoll(startup: NativeBuffer,now: u32,us: u32): int { paperUnexpected=true;return 3 }
fun paperMonoSdOwnerNegotiateBegin(context: NativeBuffer,startup: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer,width: int,now: u32,budget: int): int { paperUnexpected=true;return 3 }
fun paperMonoSdOwnerNegotiatePoll(context: NativeBuffer,now: u32): int { paperUnexpected=true;return 3 }
fun paperMonoSdOwnerClockBegin(context: NativeBuffer,startup: NativeBuffer,now: u32,budget: int): int { paperUnexpected=true;return 3 }
fun paperMonoSdOwnerClockPoll(context: NativeBuffer,now: u32,us: u32): int { paperUnexpected=true;return 3 }
fun paperMonoSdOwnerReady(startup: NativeBuffer,context: NativeBuffer,clock: NativeBuffer): bool = paperReady
fun paperMonoSdOwnerClose(startup: NativeBuffer,pads: NativeBuffer): int { paperUnexpected=true;return 3 }
