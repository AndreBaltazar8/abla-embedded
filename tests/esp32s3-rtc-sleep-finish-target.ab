import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/rtc_sleep_finish_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_sleep_finish_target")
trusted fun finishTarget(board: M5BoardId,rtc: M5Rtc,pmic: M5Pm1,sleep: NativeBuffer,wake: NativeBuffer,polls: int): int =
    m5RtcSleepFinishS3Owned(board,rtc | 0,pmic | 0,sleep,wake,polls) | 0
