import "../src/esp32/dsi_bus_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_bus_target")
trusted fun target(bus: Esp32P4DsiBus,close: bool,hwVersion: int,lanes: int,cfg: int,ref: int,div: int,khz: int,kbps: int,channel: int,force: bool,polls: int): Esp32P4DsiBus {
    if (close) return bus.close(polls)
    esp32P4DsiOpen(hwVersion,lanes,cfg,ref,div,khz,kbps,channel,force,polls)
}
