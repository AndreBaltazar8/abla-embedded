import "../src/esp32/gpio/lp_clock_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_lp_gpio_clock_target")
trusted fun clockTarget(enable: bool,readLimit: int): bool =
    if (enable) esp32C5LpGpioEnableClocksOwned(readLimit) else esp32C5LpGpioDisableClocksOwned(readLimit)
