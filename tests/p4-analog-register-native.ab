import "../src/esp32/analog/register_p4_sequence.ab"
import "./p4-mpll-checks.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(64)
var writes=0
var drop=0
var ready=true
var stuck=false
var data=0
var command=0
fun p4AnalogClockReady(): bool = ready && (!mpllTesting || ((p4MpllRead(0x50120000)&0x08000000) != 0 && (p4MpllRead(0x50120008)&0x04000000) == 0 && (p4MpllRead(0x50124034)&1) != 0))
fun p4AnalogRead(offset: int): int = nativeBufferAt(memory,64).loadU32(offset)
fun p4AnalogWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0) {
        command=value
        if (mpllTesting) {
            val index=(value>>>8)&255
            val block=value&255
            if (revisionTesting && (block == 0x67 || block == 0x66)) {
                if (index != 3) lightBad=true
                if ((value&(1<<24)) != 0 && block != revisionDropBlock) {
                    if (block == 0x67) revisionCpll=(value>>>16)&255 else revisionSyspll=(value>>>16)&255
                }
                data=if (block == 0x67) revisionCpll else revisionSyspll
            } else {
                if ((value&(1<<24)) != 0) nativeBufferAt(mpllChip,256).store(index,(value>>>16)&255)
                data=nativeBufferAt(mpllChip,256).load(index)
            }
        }
        if ((value&(1<<24)) != 0) data=(value>>>16)&255
        nativeBufferAt(memory,64).storeU32(0,(data<<16)|(if (stuck) 1<<25 else 0))
    } else nativeBufferAt(memory,64).storeU32(offset,value)
    return
}
fun resetAnalog(): void {
    writes=0; drop=0; ready=true; stuck=false; data=0; command=0
    nativeBufferAt(memory,64).storeU32(0,0); nativeBufferAt(memory,64).storeU32(4,0)
    nativeBufferAt(memory,64).storeU32(28,0xaaffffff); nativeBufferAt(memory,64).storeU32(32,0xbbffffff)
    return
}
@export("abla_p4_analog_register_test")
trusted fun analogTest(): i32 {
    var block=0
    while (block < 256) {
        resetAnalog()
        val mask=p4AnalogBlockMask(block)
        val expected=if (block == 0x6d) 1024 else if (block == 0x67) 2048 else if (block == 0x62) 64 else if (block == 0x6a) 4096 else if (block == 0x63) 512 else if (block == 0x66) 32 else if (block == 0x6f) 256 else if (block == 0x69) 128 else 0
        if (mask != expected) return i32(1)
        if (mask == 0) { if (p4AnalogRegisterOwned(block,0,0,false,1) != 2 || writes != 0) return i32(2) }
        else {
            var byte=0
            while (byte < 256) {
                resetAnalog(); data=byte
                if (p4AnalogRegisterOwned(block,255-byte,0,false,1) != (1|(byte<<8)) || writes != 4 || command != (block|((255-byte)<<8)) || p4AnalogRead(28) != 0xaa000000 || p4AnalogRead(32) != (0xbb000000|mask)) return i32(3)
                if (p4AnalogRegisterOwned(block,byte,255-byte,true,1) != 1 || data != 255-byte || command != (block|(byte<<8)|((255-byte)<<16)|(1<<24))) return i32(4)
                byte=byte+1
            }
        }
        block=block+1
    }
    var low=0
    while (low < 8) {
        var high=low
        while (high < 8) {
            resetAnalog(); data=0xa5
            val mask=((1<<(high-low+1))-1)<<low
            if (p4AnalogRegisterMaskOwned(0x63,3,low,high,0,1) != 1 || data != (0xa5&(255^mask)) || writes != 8) return i32(5)
            high=high+1
        }
        low=low+1
    }
    var failure=1
    while (failure <= 3) { resetAnalog(); drop=failure; if (p4AnalogRegisterOwned(0x63,2,0,false,1) != 5 || writes != failure) return i32(6); failure=failure+1 }
    resetAnalog(); stuck=true
    if (p4AnalogRegisterOwned(0x63,2,0,false,2) != 6 || writes != 4) return i32(7)
    resetAnalog(); nativeBufferAt(memory,64).storeU32(4,1<<25)
    if (p4AnalogRegisterOwned(0x63,2,0,false,2) != 4 || writes != 0) return i32(8)
    resetAnalog(); ready=false
    if (p4AnalogRegisterOwned(0x63,2,0,false,1) != 3 || writes != 0) return i32(9)
    resetAnalog()
    if (p4AnalogRegisterOwned(0x63,256,0,false,1) != 2 || p4AnalogRegisterOwned(0x63,2,256,true,1) != 2 || p4AnalogRegisterOwned(0x63,2,0,false,0) != 2 || p4AnalogRegisterMaskOwned(0x63,2,5,4,0,1) != 2 || p4AnalogRegisterMaskOwned(0x63,2,0,7,256,1) != 2 || writes != 0) return i32(10)
    return i32(mpllChecks())
}
