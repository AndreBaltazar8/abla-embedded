import "../src/esp32/power/retention_published_p4_sequence.ab"
val publishedMemory=nativeStaticAllocate(148)
fun seedPublished(): NativeBuffer {
    resetSleepLight();seedExtra();seedSession()
    val head=seedFlashGraphEngine(0,true,true)
    val entries=nativeBufferAt(graphEntries,20)
    val c=nativeBufferAt(configMemory,32)
    c.storeU32(0,entries.loadU32(0));c.storeU32(4,0);c.storeU32(8,0)
    retentionExpectedHead=u32(entries.loadU32(0))
    val r=nativeBufferAt(publishedMemory,148)
    var i=0
    while (i < 144) { r.storeU32(i,0);i=i+4 }
    r.storeU32(144,0x1234abcd);return r
}
fun openPublished(r: NativeBuffer): int = esp32p4RetentionPublishedOpenOwned(r,nativeBufferAt(configMemory,32),nativeBufferAt(graphEntries,20).loadU32(12),nativeBufferAt(profileOutput,flashGraphBytes),nativeBufferAt(profileBacking,6000),2,true)
fun retentionPublishedChecks(): int {
    var fault=0
    while (fault <= 18) {
        val r=seedPublished()
        if (fault <= 9) retentionDrop=fault
        val opened=openPublished(r)
        if (opened != (if (fault == 0 || fault > 9) 1 else 6) || lightCommands != 2 || extraStarts != 0 || lightRequests != 0) return 190
        // A partial child must be closed, never silently reacquired/reissued.
        val before=retentionWrites
        if (esp32p4RetentionPublishedContinueOwned(r,2,true) != opened || retentionWrites != before || lightCommands != 2) return 191
        retentionDrop=if (fault > 9) retentionWrites+fault-9 else 0
        val closed=esp32p4RetentionPublishedCloseOwned(r,true)
        if (closed != (if (fault > 9) 7 else 8)) return 192
        if (closed == 7 && esp32p4RetentionPublishedContinueOwned(r,2,true) != 6) return 204
        retentionDrop=0
        if (esp32p4RetentionPublishedCloseOwned(r,true) != 8 || !retentionOriginal() || entry3Register != 0x30400000 ||
            r.loadU32(144) != 0x1234abcd || retentionBad || lightBad || extraStarts != 0) return 193
        fault=fault+1
    }
    var pass=1
    while (pass <= 2) {
        val r=seedPublished();lightStuckPass=pass
        if (openPublished(r) != 5 || retentionWrites != 0 || lightCommands != pass) return 194
        if (esp32p4RetentionPublishedContinueOwned(r,2,true) != 5 || esp32p4RetentionPublishedCloseOwned(r,true) != 5 || retentionWrites != 0 || lightCommands != pass) return 195
        lightStuckPass=0;lightCache=u32(16)
        if (esp32p4RetentionPublishedContinueOwned(r,2,true) != 1 || lightCommands != pass+2 || esp32p4RetentionPublishedCloseOwned(r,true) != 8) return 196
        pass=pass+1
    }
    val aborted=seedPublished();lightStuckPass=1
    if (openPublished(aborted) != 5) return 197
    lightCache=u32(16)
    if (esp32p4RetentionPublishedCloseOwned(aborted,true) != 8 || retentionWrites != 0) return 198
    val invalid=seedPublished();val c=nativeBufferAt(configMemory,32)
    c.storeU32(0,profileOutput+flashGraphBytes-4)
    if (openPublished(invalid) != 2 || invalid.loadU32(0) != 0 || lightCommands != 0 || retentionWrites != 0) return 199
    val busy=seedPublished();extraFlow=u32(1)
    if (openPublished(busy) != 3 || retentionWrites != 0 || lightCommands != 0) return 200
    extraFlow=u32(0)
    if (esp32p4RetentionPublishedContinueOwned(busy,2,true) != 1) return 201
    extraFlow=u32(1);val count=retentionWrites
    if (esp32p4RetentionPublishedCloseOwned(busy,true) != 7 || retentionWrites != count) return 202
    extraFlow=u32(0)
    if (esp32p4RetentionPublishedCloseOwned(busy,true) != 8) return 203
    flashGraphEngineEnabled=false;return 0
}
