import "../src/display/text_console.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(500)
trusted fun cellMatches(buffer: NativeBuffer,column: int,row: int,character: int): bool {
    var y=0
    while (y < 8) {
        var x=0
        while (x < 6) {
            val expected=if ((classicFontColumn(character,x)&(1<<y)) != 0) 65535 else 0
            val offset=(row*8+y)*28+(column*6+x)*2
            if ((buffer.load(offset)<<8|buffer.load(offset+1)) != expected) return false
            x=x+1
        }
        y=y+1
    }
    return true
}
@export("abla_text_console_test")
trusted fun test(): i32 {
    val buffer=nativeBufferAt(storage,444)
    val text=nativeBufferAt(storage+460,10)
    var i=0
    while (i < 460) { nativeBufferAt(storage,460).store(i,90); i=i+1 }
    text.store(0,65); text.store(1,66); text.store(2,67); text.store(3,68); text.store(4,69)
    var cursor=textCursor().writeRgb565Owned(buffer,12,16,28,text,4,65535,0)
    if (!cursor.valid() || cursor.column() != 2 || cursor.row() != 1 || !cellMatches(buffer,0,0,65) || !cellMatches(buffer,1,1,68)) return i32(1)
    cursor=cursor.writeRgb565Owned(buffer,12,16,28,nativeBufferAt(text.addressValue()+4,1),1,65535,0)
    if (cursor.column() != 1 || cursor.row() != 1 || !cellMatches(buffer,0,0,67) || !cellMatches(buffer,1,0,68) || !cellMatches(buffer,0,1,69) || !cellMatches(buffer,1,1,32)) return i32(2)
    text.store(0,13); text.store(1,70)
    cursor=cursor.writeRgb565Owned(buffer,12,16,28,text,2,65535,0)
    if (cursor.column() != 1 || !cellMatches(buffer,0,1,70)) return i32(3)
    text.store(0,10)
    cursor=cursor.writeRgb565Owned(buffer,12,16,28,text,1,65535,0)
    if (cursor.column() != 0 || cursor.row() != 1 || !cellMatches(buffer,0,0,70) || !cellMatches(buffer,0,1,32)) return i32(4)
    i=0
    while (i < 460) { if ((i%28 >= 24 || i >= 444) && nativeBufferAt(storage,460).load(i) != 90) return i32(5); i=i+1 }
    buffer.store(0,42)
    if (textCursor(3,0).writeRgb565Owned(buffer,12,16,28,text,1,1,0).valid() || textCursor().writeRgb565Owned(buffer,12,16,28,buffer,1,1,0).valid() || textCursor().writeRgb565Owned(buffer,12,16,28,text,1,1,0,0).valid() || buffer.load(0) != 42) return i32(6)
    // Single row scroll clears without reading beyond the last row.
    text.store(0,10)
    cursor=textCursor().writeRgb565Owned(buffer,12,8,28,text,1,0,0x1234,1,true)
    if (!cursor.valid() || cursor.row() != 0 || buffer.load(0) != 52 || buffer.load(1) != 18) return i32(7)
    return i32(0)
}
