import "../src/wifi/bip_logic.ab"
import "abla/unsafe/memory"

trusted noescape extern:"c" fun mmap(
    address: i64*, length: int, protection: i32, flags: i32,
    fileDescriptor: i32, offset: int
): i64*
trusted noescape extern:"c" fun munmap(address: i64*, length: int): i32

trusted fun main(): int {
    val allocation = mmap(
        nativeNullPointer(), 4096, i32(3), i32(98), i32(-1), 0
    )
    val address = nativePointerAddress(allocation)
    if (address <= 0) return 1
    val frame = nativeBufferAt(address, 128)
    val aad = nativeBufferAt(address + 128, 20)
    val nonce = nativeBufferAt(address + 160, 12)
    val key = nativeBufferAt(address + 192, 32)
    val state = wifiBipKeyState(nativeBufferAt(address + 256, 68))
    nativeAddressClear(address, 512)
    if (wifiCipherMicLength(3) != 8 || wifiCipherMicLength(4) != 8 ||
        wifiCipherMicLength(5) != 0 || wifiCipherMicLength(6) != 0 ||
        wifiCipherMicLength(7) != 16 || wifiCipherMicLength(8) != 16 ||
        wifiCipherMicLength(9) != 16 || wifiCipherMicLength(10) != 0) return 2
    var index = 0
    while (index < 32) {
        key.store(index, index + 1)
        index = index + 1
    }
    if (!state.initialize(key, wifiBipGmac256, 5) || !state.valid() ||
        state.cipher() != wifiBipGmac256 || state.keyLength() != 32 ||
        state.key().load(31) != 32) return 3
    val pn = state.reserveTransmitPacketNumberUnlocked()
    if (pn.rawValue() != 1 || state.transmitPacketNumber().rawValue() != 1 ||
        !state.packetNumberAcceptedUnlocked(wifiBipPacketNumber(9)) ||
        !state.commitReplayPacketNumberUnlocked(wifiBipPacketNumber(9)) ||
        state.packetNumberAcceptedUnlocked(wifiBipPacketNumber(9))) return 4

    frame.storeU16(0, 14336)
    index = 0
    while (index < 18) {
        frame.store(4 + index, 32 + index)
        index = index + 1
    }
    if (!wifiBipWriteAad(frame, 24, aad) || aad.loadU16(0) != 0) return 5
    index = 0
    while (index < 18) {
        if (aad.load(2 + index) != 32 + index) return 6
        index = index + 1
    }
    val packetNumber = wifiBipPacketNumber(6618611909121)
    val protectedLength = wifiBipAppendMmie(
        frame, 24, wifiBipGmac256, 5, packetNumber
    )
    if (protectedLength != 50 || wifiBipMmieOffset(
        frame, protectedLength, wifiBipGmac256
    ) != 24 || frame.load(24) != 76 || frame.load(25) != 24 ||
        frame.loadU16(26) != 5 || wifiBipReadPacketNumber(
            frame, 28
        ).rawValue() != packetNumber.rawValue()) return 7
    if (!wifiBipWriteGmacNonce(
        frame, protectedLength, packetNumber, nonce
    )) return 8
    index = 0
    while (index < 6) {
        if (nonce.load(index) != 38 + index ||
            nonce.load(6 + index) != 6 - index) return 9
        index = index + 1
    }
    if (munmap(allocation, 4096) != i32(0)) return 10
    81
}
