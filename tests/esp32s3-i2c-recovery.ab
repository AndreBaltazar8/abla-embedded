import "../src/esp32/i2c/recovery_s3_logic.ab"

fun main(): int {
    if (esp32S3I2cRecoveryOffset(-1) != -1 || esp32S3I2cRecoveryOffset(13) != -1) return 1
    if (esp32S3I2cRecoveryMask(-1) != u32(0) || esp32S3I2cRecoveryMask(13) != u32(0)) return 2
    if (esp32S3I2cRecoveryOffset(0) != 0x54 || esp32S3I2cRecoveryOffset(12) != 4) return 3
    var index = 0
    while (index < 13) {
        val offset = esp32S3I2cRecoveryOffset(index)
        if (offset < 0 || offset > 0x54 || (offset & 3) != 0) return 4
        if (esp32S3I2cRecoveryMask(index) == u32(0)) return 5
        var other = index + 1
        while (other < 13) {
            if (offset == esp32S3I2cRecoveryOffset(other)) return 6
            other = other + 1
        }
        index = index + 1
    }
    if ((esp32S3I2cRecoveryMask(12) & u32(0xc20)) != u32(0)) return 7
    if ((esp32S3I2cRecoveryMask(11) & u32(0x3000)) != u32(0)) return 8
    if ((esp32S3I2cRecoveryMask(0) & u32(0x300000)) != u32(0x300000)) return 9
    0
}
