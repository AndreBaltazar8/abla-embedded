import "../src/esp32/power/sleep_retained_record_s3_sequence.ab"
import "../src/esp32/rtc_retention_tag_plan_s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Esp32S3ClockState = int
type Esp32S3ClockBias = int
type Esp32S3SleepResume = int
type Esp32S3SleepUsbSerial = int
fun Esp32S3SleepUsbSerial.valid(): bool = this == 7
var usb=0
var usbRestores=0
var usbFails=false
type Esp32S3SleepSar = int
var sarRestores=0
var sarFails=false
var monitor=false
fun esp32S3SleepSarPrepareOwned(active: bool): Esp32S3SleepSar {
    if (active != monitor) bad=true
    Esp32S3SleepSar(if (active) 4 else 5)
}
fun esp32S3SleepSarRestoreOwned(saved: Esp32S3SleepSar): bool {
    if ((usb & 255) != 0 || (progress & 15) != 1 || (saved | 0) != (if (monitor) 4 else 5)) bad=true
    sarRestores=sarRestores+1
    !sarFails
}
fun esp32S3SleepUsbSerialPrepareOwned(): Esp32S3SleepUsbSerial = Esp32S3SleepUsbSerial(7)
fun esp32S3SleepUsbSerialRestoreOwned(saved: Esp32S3SleepUsbSerial): bool {
    if ((progress & 15) != 1 || (saved | 0) != 7) bad=true
    usbRestores=usbRestores+1
    !usbFails
}
fun Esp32S3SleepResume.valid(): bool = this >= 0
fun Esp32S3SleepResume.phase(): int = this & 15
fun Esp32S3SleepResume.status(): int = (this>>>4) & 15
fun Esp32S3SleepResume.apbHertz(): int = this>>>8
fun esp32S3SleepResumeResult(phase: int,status: int,apb: int,detail: int): Esp32S3SleepResume = Esp32S3SleepResume(phase | (status<<4) | (apb<<8))
var stage=3
var owned=0
var progress=0
var ip=0
var dp=0
var clockResult=80000000
var entryResult=0
var armResult=1
var releaseResult=1
var clocks=0
var cancels=0
var finishes=0
var resumes=0
var bad=false
fun esp32S3MspiStateRead(address: int): int {
    if (address == 4096) return 0x53504C50
    if (address == 4100) return stage
    if (address == 4200) return owned
    if (address == 4204) return usb
    bad=true; 0
}
fun esp32S3MspiStateWrite(address: int,value: int): void {
    if (address == 4100) stage=value
    else if (address == 4200) owned=value
    else if (address == 4204) usb=value
    else bad=true
    return
}
fun esp32S3MspiStateLoad64(address: int): int {
    if (address == 4136) return progress
    if (address == 4208) return ip
    if (address == 4216) return dp
    if (address == 4104 || address == 4128) return 1
    bad=true; 0
}
fun esp32S3MspiStateStore64(address: int,value: int): void {
    if (address == 4136) progress=value
    else if (address == 4208) ip=value
    else if (address == 4216) dp=value
    else bad=true
    return
}
fun esp32S3RetentionBuffersValid(cpu: NativeBuffer,tags: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan): bool = true
fun esp32S3TagBufferBytes(i: Esp32S3TagPlan,d: Esp32S3TagPlan): int = 6160
fun esp32S3RetentionArmOwned(cpu: NativeBuffer,tags: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan,small: bool): int = armResult
fun esp32S3LightSleepSuspendedOwned(wake: int,reject: int): int { if (stage != 10) bad=true; entryResult }
fun esp32S3ClockResumeFromXtalOwned(clock: Esp32S3ClockState,bias: Esp32S3ClockBias,polls: int): int { clocks=clocks+1; clockResult }
fun esp32S3RetentionCancelOwned(i: Esp32S3TagPlan,d: Esp32S3TagPlan): bool { if ((progress & 15) != 1 || usb != 0) bad=true; cancels=cancels+1; releaseResult == 1 }
fun esp32S3RetentionFinishOwned(i: Esp32S3TagPlan,d: Esp32S3TagPlan): int { if ((progress & 15) != 1 || usb != 0) bad=true; finishes=finishes+1; releaseResult }
fun esp32S3SleepRecordResumeOwned(record: NativeBuffer,polls: int): Esp32S3SleepResume {
    if ((stage & 255) != 3 && (owned != 2 || (stage & 255) != 4)) bad=true
    resumes=resumes+1; esp32S3SleepResumeResult(15,1,80000000,0)
}
@export("abla_sleep_retained_record_test")
trusted fun retainedTest(): i32 {
    val record=nativeBufferAt(4096,128)
    val cpu=nativeBufferAt(8192,8800)
    val tags=nativeBufferAt(20000,8000)
    val i=esp32S3TagPlan(false,32768,8,32,0,65536,false)
    val d=esp32S3TagPlan(true,32768,4,32,0,65536,false)
    armResult=0
    while (armResult <= 3) {
        if (armResult != 1) {
            stage=3; owned=0; progress=0; clocks=0; cancels=0; finishes=0; resumes=0; bad=false; usb=0; usbRestores=0; sarRestores=0
            if (esp32S3SleepRecordArmRetentionOwned(record,cpu,tags,i,d,false,false) != armResult+3 || stage != 3) return i32(13)
            if (esp32S3SleepRetainedRecordResumeOwned(record,8).status() != 1 || resumes != 1 || clocks != 0 ||
                cancels != 0 || finishes != 0 || usbRestores != 0 || sarRestores != 0 || bad) return i32(14)
        }
        armResult=armResult+1
    }
    armResult=1
    entryResult=-3
    while (entryResult <= 1) {
        stage=3; owned=0; progress=0; clocks=0; cancels=0; finishes=0; resumes=0; bad=false; releaseResult=1; usb=0; usbRestores=0; usbFails=false
        sarRestores=0; sarFails=false; monitor=(entryResult & 1) != 0
        if (esp32S3SleepRecordArmRetentionOwned(record,cpu,tags,i,d,false,monitor) != 1 || stage != 9 || owned != 1) return i32(1)
        if (entryResult != -3) {
            if (esp32S3SleepRetainedRecordEnterOwned(record,1,0) != entryResult) return i32(2)
            if (esp32S3SleepRetainedRecordEnterOwned(record,1,0) != -3) return i32(3)
        }
        clockResult=-3
        if (esp32S3SleepRetainedRecordResumeOwned(record,8).status() != 2 || resumes != 0 || cancels != 0 || finishes != 0) return i32(4)
        clockResult=80000000; usbFails=true
        if (esp32S3SleepRetainedRecordResumeOwned(record,8).status() != 4 || (usb & 255) != 7 || finishes != 0 || cancels != 0 || sarRestores != 0) return i32(11)
        usbFails=false; sarFails=true
        if (esp32S3SleepRetainedRecordResumeOwned(record,8).status() != 4 || (usb & 255) != 0 || usb == 0 || finishes != 0 || cancels != 0) return i32(12)
        sarFails=false; releaseResult=0
        if (esp32S3SleepRetainedRecordResumeOwned(record,8).status() != 4 || owned != 1 || resumes != 0) return i32(5)
        releaseResult=1
        if (esp32S3SleepRetainedRecordResumeOwned(record,8).status() != 1 || clocks != 2 || resumes != 1 || bad || usbRestores != 2 || sarRestores != 2 || usb != 0) return i32(6)
        if (cancels != (if (entryResult != 0) 2 else 0) || finishes != (if (entryResult != 0) 0 else 2)) return i32(7)
        entryResult=entryResult+1
    }
    stage=9; progress=0; owned=1; clockResult=-2; clocks=0
    if (esp32S3SleepRetainedRecordResumeOwned(record,8).status() != 4 || esp32S3SleepRetainedRecordResumeOwned(record,8).status() != 4 || clocks != 1) return i32(8)
    stage=10
    if (esp32S3SleepRetainedRecordResumeOwned(record,8).status() != 5) return i32(9)
    stage=3
    if (esp32S3SleepRecordArmRetentionOwned(record,nativeBufferAt(4096,8800),tags,i,d,false,false) != 0 || stage != 3) return i32(10)
    i32(0)
}
