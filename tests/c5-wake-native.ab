import "../src/esp32/gpio/c5_wake_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
import "./c5-wake-register-model.ab"
@export("abla_c5_wake_test")
trusted fun wakeTest(): i32 {
    var profile=0
    while (profile < 131072) {
        pattern=(profile&65535)|0xA5A50000
        held=profile >= 65536
        seedWakeModel(pattern,held,0)
        val ok=esp32C5ConfigureGpio4WakeInputOwned()
        if (ok == held || calls != (if (held) 1 else 12) || bad) return i32(1)
        profile=profile+1
    }
    var failure=1
    while (failure <= 4) {
        seedWakeModel(0xffffffff,false,failure)
        if (esp32C5ConfigureGpio4WakeInputOwned() || wakeWrites != failure || bad || wakeLp != 0xffffffff) return i32(2)
        wakeDrop=0
        if (!esp32C5ConfigureGpio4WakeInputOwned() || bad || wakeOutput != 0xffffffef ||
            wakeRoute != 0xfffff500 || wakeMux != 0xffff9f7d || wakeLp != 0xffffffef) return i32(3)
        failure=failure+1
    }
    i32(0)
}
