import "../src/esp32/runtime/libgcc_divsf3_esp32.ab"
import "abla/float"

fun main():int {
    if (esp32Binary32Divide(u32(0x3f800000),u32(0x40400000)) != u32(0x3eaaaaab)) return 1
    if (esp32Binary32Divide(u32(0xc0c00000),u32(0x40000000)) != u32(0xc0400000)) return 2
    if (esp32Binary32Divide(u32(1),u32(0x40000000)) != u32(0)) return 3
    if (esp32Binary32Divide(u32(3),u32(0x40000000)) != u32(2)) return 4
    if (esp32Binary32Divide(u32(5),u32(0x40000000)) != u32(2)) return 5
    if (esp32Binary32Divide(u32(0x80000001),u32(0x40000000)) != u32(0x80000000)) return 6
    if (esp32Binary32Divide(u32(0x00800000),u32(0x40000000)) != u32(0x00400000)) return 7
    if (esp32Binary32Divide(u32(0x00ffffff),u32(0x40000000)) != u32(0x00800000)) return 8
    if (esp32Binary32Divide(u32(0x7f7fffff),u32(0x3f000000)) != u32(0x7f800000)) return 9
    if (esp32Binary32Divide(u32(0x3f800000),u32(0x80000000)) != u32(0xff800000)) return 10
    if (esp32Binary32Divide(u32(0x80000000),u32(0x3f800000)) != u32(0x80000000)) return 11
    if (esp32Binary32Divide(u32(0),u32(0)) != u32(0x7fc00000)) return 12
    if (esp32Binary32Divide(u32(0x7f800000),u32(0x7f800000)) != u32(0x7fc00000)) return 13
    if (esp32Binary32Divide(u32(0x7f800001),u32(0x3f800000)) != u32(0x7fc00001)) return 14
    if (esp32Binary32Divide(u32(0x3f800000),u32(0xff800001)) != u32(0xffc00001)) return 15
    if (esp32Binary32Divide(u32(1),u32(1)) != u32(0x3f800000)) return 16
    if (esp32Binary32Divide(u32(0xbf800000),u32(0x7f800000)) != u32(0x80000000)) return 17
    // The test alone uses native host division as an independent oracle.
    var state = u32(0x934801ad)
    var index = 0
    while (index < 20000) {
        state = state * u32(1664525) + u32(1013904223)
        val left = state
        state = state * u32(1664525) + u32(1013904223)
        val right = state
        if ((left & u32(0x7f800000)) != u32(0x7f800000) &&
            (right & u32(0x7f800000)) != u32(0x7f800000)) {
            val expected = f32ToBits(f32FromBits(left) / f32FromBits(right))
            if (esp32Binary32Divide(left,right) != expected) return 18
        }
        index = index + 1
    }
    return 0
}
