import "../src/esp32/tls/socket_mode_sequence_esp32.ab"
var testFlags=u32(0)
var testSetResult=u32(0)
var expectedFlags=u32(0)
var calls=0
var errors=0
var setError=false
var bad=false
trusted fun esp32TlsSocketFlags(descriptor: u32,command: u32,value: u32): u32 {
    calls=calls+1
    if (descriptor != u32(54)) bad=true
    if (calls == 1) {
        if (command != u32(3) || value != u32(0)) bad=true
        return testFlags
    }
    if (calls != 2 || command != u32(4) || value != expectedFlags) bad=true
    testSetResult
}
trusted fun esp32TlsSocketModeError(descriptor: u32,setting: bool): void {
    errors=errors+1
    if (descriptor != u32(54) || setting != setError) bad=true
    return
}
fun resetCase(): void { calls=0; errors=0; bad=false; return }
fun main(): int {
    var flags=0
    while (flags < 65536) {
        testFlags=u32(flags)
        var enabled=0
        while (enabled < 2) {
            var outcome=0
            while (outcome < 3) {
                resetCase()
                expectedFlags=if (enabled == 1) testFlags | u32(16384) else testFlags & u32(4294950911)
                testSetResult=if (outcome == 0) u32(0) else if (outcome == 1) u32(7) else u32(4294967295)
                setError=true
                val result=esp32TlsSetSocketNonblocking(u32(54),enabled == 1)
                if (bad || calls != 2 || errors != (if (outcome == 2) 1 else 0) ||
                    result != (if (outcome == 2) u32(32773) else u32(0))) return 1
                outcome=outcome+1
            }
            enabled=enabled+1
        }
        flags=flags+1
    }
    resetCase(); testFlags=u32(4294967295); setError=false
    if (esp32TlsSetSocketNonblocking(u32(54),true) != u32(32773) || calls != 1 || errors != 1 || bad) return 2
    resetCase(); testFlags=u32(2147483648)
    if (esp32TlsSetSocketNonblocking(u32(54),false) != u32(32773) || calls != 1 || errors != 1 || bad) return 3
    0
}
