import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/expander_controls.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_expander_controls_target")
trusted fun controlTarget(owner: M5Expanders,mode: int,value: int,enabled: bool,power: I2cDevice): int {
    if (mode == 0) return owner.setExternalOutput(value,enabled) | 0
    if (mode == 1) return owner.setChargeCurrent(value) | 0
    if (mode == 2) return owner.setBatteryCharge(enabled) | 0
    if (mode == 3) return owner.externalOutputChecked(power) | 0
    owner.usbOutputChecked() | 0
}
