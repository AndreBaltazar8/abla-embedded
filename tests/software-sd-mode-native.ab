import "../src/spi/software_sd_mode.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
var selected = false
var outputHigh = false
var selectedBits = 0
var idleBits = 0
var selections = 0
var command = 0
var readBits = 0
var response = 0
var delays = 0
var activity = 0
var bad = false
trusted fun Pin.write(high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) {
        if (!high) {
            if (selected || idleBits != selections * 128 + 128) bad = true
            selections = selections + 1
            command = 0
        } else if (selected) {
            // Keep last 7 bytes: argument0/CRC plus two dummy FF bytes.
            val tail = if (selections == 1) 0xfdffff else 0x95ffff
            if (command != tail || selectedBits != selections * 64) bad = true
        }
        selected = !high
    }
    if (this == 1 && high) {
        if (selected) {
            if (selectedBits % 64 < 8 && outputHigh != ((((if (selections == 1) 122 else 64) >> (7 - selectedBits % 8)) & 1) != 0)) bad = true
            command = ((command << 1) | (if (outputHigh) 1 else 0)) & 72057594037927935
            selectedBits = selectedBits + 1
        } else {
            if (!outputHigh) bad = true
            idleBits = idleBits + 1
        }
    }
    return
}
trusted fun Pin.read(): bool {
    if (this != 3 || !selected || selections != 1 || readBits >= 16 || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    val value = ((response >> (15 - readBits)) & 1) != 0
    readBits = readBits + 1
    value
}
fun peripheralDelayMicroseconds(duration: int): void {
    if (duration != 2) bad = true
    delays = delays + 1
    return
}
@export("abla_sd_mode_native_test")
trusted fun sdModeNativeTest(): i32 {
    val gate = peripheralGateAt(gateStorage)
    var variant = 0
    while (variant < 3) {
        selectedBits = 0
        idleBits = 0
        selections = 0
        readBits = 0
        delays = 0
        response = if (variant == 0) 0xff00 else if (variant == 1) 0xffff else 0
        val result = softwareSdPrepareSpi(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4))
        val resets = variant != 0
        val expected = if (variant == 0) 255 else if (variant == 1) 131071 else 65536
        if (!result.valid() || result.value() != u32(expected) || bad || selected || readBits != 16) return i32(1)
        if (selections != (if (resets) 2 else 1) || delays != (idleBits + selectedBits) * 2 || nativeAddressLoadU32(gateStorage, 0) != 0) return i32(2)
        variant = variant + 1
    }
    activity = 0
    if (softwareSdPrepareSpi(gate, u32(7), Pin(1), Pin(2), Pin(-1), Pin(4)).status() != 3 || activity != 0) return i32(3)
    if (softwareSdPrepareSpi(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), 1).status() != 3 || activity != 0) return i32(4)
    if (gate.tryBegin(u32(9)) != 0) return i32(5)
    if (softwareSdPrepareSpi(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4)).status() != 2 || activity != 0) return i32(6)
    if (!gate.finish(u32(9), false)) return i32(7)
    if (softwareSdPrepareSpi(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4)).status() != 4 || activity != 0) return i32(8)
    i32(0)
}
