import "../src/m5stack/tough_rtc_open_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(96)
var calls=0
var checks=0
var failure=0
var matches=true
var bad=false
fun toughRtcBusOwnsPmic(bus: int,pmic: int): bool {
    checks=checks+1
    if (bus != 13 || pmic != 7 || calls != 0) bad=true
    return matches
}
fun m5RtcOpenAllocate(bus: int,board: M5BoardId): int {
    if (bus != 13 || board != m5BoardToughC5 || calls != 0 || checks != 1) bad=true
    calls=calls+1;return if (failure == 1) 0 else 9|(2<<32)
}
fun m5RtcOpenBegin(rtc: int): bool {
    if (rtc != (9|(2<<32)) || calls != 1) bad=true
    calls=calls+1;return failure == 0
}
fun m5RtcOpenClose(rtc: int): bool {
    if (rtc != (9|(2<<32)) || calls != 2) bad=true
    calls=calls+1;return failure != 3
}
@export("abla_toughc5_rtc_open_test")
trusted fun test(): int {
    val storage=nativeBufferAt(memory,96);val owner=m5ToughPowerOwnerAt(storage)
    var mode=0
    while (mode < 1024) {
        val state=mode&7;val kind=(mode>>>3)&7
        val exclusive=(mode&64) != 0;val consumed=(mode&128) != 0
        failure=(mode>>>8)&3;calls=0;checks=0;bad=false;matches=true
        storage.storeU32(0,0x54435057);storage.storeU32(4,state)
        storage.storeU32(8,7);storage.storeU32(12,kind|256)
        storage.storeU32(16,1|(5<<8));storage.storeU32(20,0)
        val admitted=state == 1 && kind == 5 && exclusive && consumed
        val result=owner.openRtcOwned(13,exclusive,consumed)
        val expected=if (!admitted) 6 else failure+1
        if (result.status() != expected || calls != (if (!admitted) 0 else if (failure == 0) 2 else if (failure == 1) 1 else 3) ||
            checks != (if (admitted) 1 else 0) || bad || result.handle() != (if (admitted && (failure == 0 || failure == 3)) 9|(2<<32) else 0)) return 1
        mode=mode+1
    }
    storage.storeU32(4,1);storage.storeU32(12,261);calls=0;checks=0;matches=false
    if (owner.openRtcOwned(13,true,true).status() != 6 || calls != 0 || checks != 1) return 2
    matches=true;storage.storeU32(16,6|(5<<8));checks=0
    if (owner.openRtcOwned(13,true,true).status() != 6 || calls != 0 || checks != 0) return 3
    return 0
}
