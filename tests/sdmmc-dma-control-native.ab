import "../src/sd/mmc_dma_control_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(256)
var writes=0
var drop=-1
var owner=0x8000001c
var unexpectedDescriptorWrite=false
trusted fun sdMmcDmaS3Write(address: int,value: int): void {
    unexpectedDescriptorWrite=true
    return
}
trusted fun sdMmcS3Read(offset: int): int = nativeBufferAt(memory,256).loadU32(offset)
trusted fun sdMmcS3Write(offset: int,value: int): void {
    writes=writes+1
    if (offset != drop) nativeBufferAt(memory,256).storeU32(offset,if (offset == 140) sdMmcS3Read(offset)&~value else value)
    return
}
trusted fun sdMmcDmaS3Read(address: int): int = if (address == 0x3fc88000) owner else if (address == 0x3fc88004) 512 else if (address == 0x3fc88008) 0x3fc89000 else 0
trusted fun reset(): void {
    var n=0
    while (n < 256) { nativeBufferAt(memory,256).store(n,0); n=n+1 }
    writes=0; drop=-1; owner=0x8000001c
    return
}
@export("abla_sdmmc_dma_control_test")
trusted fun test(): i32 {
    val desc=nativeBufferAt(0x3fc88000,16)
    val data=nativeBufferAt(0x3fc89000,512)
    reset()
    nativeBufferAt(memory,256).storeU32(0,0x10000000)
    nativeBufferAt(memory,256).storeU32(128,0x400)
    nativeBufferAt(memory,256).storeU32(140,0x337)
    if (sdMmcDmaArmOwned(desc,data,512,512,true) != 1 || sdMmcS3Read(0) != 0x12000020 || sdMmcS3Read(128) != 0x482 || sdMmcS3Read(136) != 0x3fc88000 || sdMmcS3Read(132) != 1 || sdMmcS3Read(140) != 0) return i32(1)
    if (sdMmcDmaStopOwned(true,true) != 2 || sdMmcS3Read(0) != 0x10000004 || sdMmcS3Read(128) != 0x400 || sdMmcDmaStopPollOwned(2) != 2) return i32(2)
    nativeBufferAt(memory,256).storeU32(0,0x10000000)
    nativeBufferAt(memory,256).storeU32(140,0x2000)
    if (sdMmcDmaStopPollOwned(2) != 2) return i32(3)
    nativeBufferAt(memory,256).storeU32(140,0)
    if (sdMmcDmaStopPollOwned(2) != 1 || sdMmcDmaStopPollOwned(1) != 3) return i32(4)
    var stage=0
    while (stage < 6) {
        reset()
        drop=if (stage == 0) 140 else if (stage == 1) 32 else if (stage == 2) 28 else if (stage == 3) 136 else if (stage == 4) 0 else 128
        if (stage == 0) nativeBufferAt(memory,256).storeU32(140,2)
        if (sdMmcDmaArmOwned(desc,data,512,512,true) != 5 || sdMmcS3Read(132) != 0) return i32(5)
        stage=stage+1
    }
    var bit=0
    while (bit < 32) {
        if (((1<<bit)&0x02000037) != 0) {
            reset(); nativeBufferAt(memory,256).storeU32(0,1<<bit)
            if (sdMmcDmaArmOwned(desc,data,512,512,true) != 4 || writes != 0) return i32(6)
        }
        bit=bit+1
    }
    var guard=0
    while (guard < 4) {
        bit=0
        val offset=if (guard == 0) 128 else if (guard == 1) 44 else if (guard == 2) 72 else 140
        val mask=if (guard == 0) 0x83 else if (guard == 1) 0x80000000 else if (guard == 2) 0x3ffe06f0 else 0x1e000
        while (bit < 32) {
            if (((1<<bit)&mask) != 0) {
                reset(); nativeBufferAt(memory,256).storeU32(offset,1<<bit)
                if (sdMmcDmaArmOwned(desc,data,512,512,true) != 4 || writes != 0) return i32(12)
            }
            bit=bit+1
        }
        guard=guard+1
    }
    var fsm=1
    while (fsm < 16) {
        reset(); nativeBufferAt(memory,256).storeU32(140,fsm<<13)
        if (sdMmcDmaStopPollOwned(2) != 2 || writes != 0) return i32(13)
        fsm=fsm+1
    }
    reset(); owner=28
    if (sdMmcDmaArmOwned(desc,data,512,512,true) != 3 || writes != 0) return i32(7)
    reset()
    if (sdMmcDmaArmOwned(desc,data,512,12,true) != 3 || sdMmcDmaStopOwned(false,true) != 3 || writes != 0) return i32(8)
    nativeBufferAt(memory,256).storeU32(0,0x02000020); drop=0
    if (sdMmcDmaStopOwned(true,true) != 5 || sdMmcDmaStopPollOwned(2) != 5) return i32(9)
    reset(); nativeBufferAt(memory,256).storeU32(128,130); drop=128
    if (sdMmcDmaStopOwned(true,true) != 5 || sdMmcDmaStopPollOwned(2) != 5) return i32(10)
    if (unexpectedDescriptorWrite) return i32(11)
    return i32(0)
}
