import "../src/esp32/context_return_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_context_return_target")
@section(".iram1.abla.s3ContextReturnTarget")
trusted fun returnTarget(level: int): int {
    if (level == 1) return esp32S3ContextReturn1Address()
    if (level == 2) return esp32S3ContextReturn2Address()
    if (level == 3) return esp32S3ContextReturn3Address()
    0
}
