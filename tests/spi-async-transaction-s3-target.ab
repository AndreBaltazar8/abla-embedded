import "../src/esp32/spi/phases_async_transaction_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_spi_async_transaction_s3_target")
trusted fun target(operation: int,context: NativeBuffer,parameters: NativeBuffer,data: NativeBuffer,now: u32,budget: u32,released: bool): int {
    if (!parameters.hasAddressRange(0,48)) return 3
    if (operation == 0) return esp32s3SpiAsyncTransactionBegin(context,peripheralGateAt(parameters.loadU32(0)),u32(parameters.loadU32(4)),parameters.loadU32(8),SpiPins(parameters.loadU32(12)),Pin(parameters.loadU32(16)),parameters.loadU32(20),parameters.loadU32(24),parameters.loadU32(28),parameters.loadU32(32),parameters.loadU32(36),parameters.loadU32(40),data,parameters.loadU32(44),now,budget,released)
    return esp32s3SpiAsyncTransactionPoll(context,now)
}
