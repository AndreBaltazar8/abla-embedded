import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/spi/software_transaction.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_spi_buffer_transaction_test")
trusted fun spiBufferTransactionTargetTest(gateAddress: u32, owner: u32, data: u32, size: i32, mode: i32): int {
    val buffer = nativeBufferAt(int(data), int(size))
    val result = softwareSpiTransaction(peripheralGateAt(int(gateAddress)), owner,
        pin(12), pin(11), pin(13), pin(10), buffer, int(size), buffer, int(size), int(mode), 1)
    result.status()
}
