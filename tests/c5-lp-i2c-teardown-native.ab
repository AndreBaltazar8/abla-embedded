import "../src/esp32/i2c/lp_teardown_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var profile=0
var stage=0
var bad=false
fun c5LpI2cTeardownBusy(): bool { if (stage != 0) bad=true; stage=1; return (profile&1) != 0 }
fun c5LpI2cTeardownRelease(): bool { if (stage != 1) bad=true; stage=2; return (profile&2) == 0 }
fun c5LpI2cTeardownDisable(): bool { if (stage != 2) bad=true; stage=3; return (profile&4) == 0 }
@export("abla_c5_lp_i2c_teardown_test")
fun teardownTest(): i32 {
    while (profile < 8) {
        stage=0; bad=false
        val expected=if ((profile&1) != 0) 3 else if ((profile&2) != 0) 4 else if ((profile&4) != 0) 5 else 1
        if (esp32C5LpI2cTeardownOwned(0,2,3) != expected || bad || stage != (if (expected == 3) 1 else if (expected == 4) 2 else 3)) return i32(1)
        profile=profile+1
    }
    stage=0
    if (esp32C5LpI2cTeardownOwned(1,2,3) != 2 || esp32C5LpI2cTeardownOwned(0,3,2) != 2 || stage != 0) return i32(2)
    i32(0)
}
