import "../src/esp32/scheduler_select_s3_sequence.ab"
import "../src/scheduler/ready_queue.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var storage=nativeBufferAt(0,0)
var result=1
var calls=0
var core=0
var bad=false
trusted fun esp32S3SchedulerSelectRead(address: int): int = mmioLoadU32(address)
trusted fun esp32S3SchedulerSelectWrite(address: int,value: int): void { mmioStoreU32(address,value); return }
trusted fun esp32S3SchedulerSelectSwitch(current: NativeBuffer,previous: NativeBuffer,next: NativeBuffer,owners: NativeBuffer,interrupted: NativeBuffer,resume: NativeBuffer,c: int,level: int): int {
    calls=calls+1
    if (previous.addressValue() != 0x3FC90000 || next.addressValue() != 0x3FC90020 ||
        resume.addressValue() != 0x3FC91000 || interrupted.addressValue() != 0x3FC92000 || c != core || level != 2 ||
        current.addressValue() != storage.addressValue()+72 || owners.addressValue() != 0x3FC93000) bad=true
    return result
}
@export("abla_scheduler_select_test")
trusted fun selectTest(): i32 {
    storage=nativeBufferAt(nativeStaticAllocate(96),96)
    val queue=nativeBufferAt(storage.addressValue(),24)
    val records=nativeBufferAt(storage.addressValue()+32,32)
    val running=nativeBufferAt(storage.addressValue()+64,8)
    val current=nativeBufferAt(storage.addressValue()+72,8)
    val owners=nativeBufferAt(0x3FC93000,16)
    val frame=nativeBufferAt(0x3FC92000,192)
    var profile=0
    while (profile < 20) {
        core=profile & 1; calls=0; bad=false
        var offset=0
        while (offset < 96) { storage.storeU32(offset,0); offset=offset+4 }
        if (!readyQueueInitializeOwned(queue)) return i32(1)
        storage.storeU32(32,0x3FC90000); storage.storeU32(36,0x3FC94000)
        storage.storeU32(40,core+2); storage.storeU32(44,3)
        storage.storeU32(48,0x3FC90020); storage.storeU32(52,0x3FC91000)
        storage.storeU32(56,1); storage.storeU32(60,3)
        storage.storeU32(64+core*4,1); storage.storeU32(72+core*4,0x3FC90000)
        if (esp32S3SchedulerSelectOwned(queue,records,running,current,owners,frame,core,2) != 0 || calls != 0) return i32(2)
        if (!readyQueuePushOwned(queue,2)) return i32(3)
        val mode=profile/2
        result=if (mode < 4) -1-mode else 1
        if (mode == 5) storage.storeU32(56,3)
        if (mode == 6) storage.storeU32(60,1<<(core ^ 1))
        if (mode == 7) storage.storeU32(64+(core ^ 1)*4,2)
        if (mode == 8) storage.storeU32(72+core*4,0x3FC95000)
        if (mode == 9) storage.storeU32(60,7)
        val actual=esp32S3SchedulerSelectOwned(queue,records,running,current,owners,frame,core,2)
        val expected=if (mode >= 5) -5 else result
        if (bad || actual != expected || calls != (if (mode >= 5) 0 else 1)) return i32(4+profile)
        if (actual == 1) {
            if (readyQueuePeekOwned(queue) != 1 || storage.loadU32(36) != frame.addressValue() ||
                storage.loadU32(40) != 1 || storage.loadU32(56) != core+2 || storage.loadU32(64+core*4) != 2) return i32(30)
        } else if (readyQueuePeekOwned(queue) != 2 || storage.loadU32(36) != 0x3FC94000 ||
            storage.loadU32(40) != core+2 || storage.loadU32(64+core*4) != 1) return i32(31)
        profile=profile+1
    }
    i32(0)
}
