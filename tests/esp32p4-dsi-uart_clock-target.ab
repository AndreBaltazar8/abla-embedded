import "../src/esp32/uart/clock_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_uart_clock_target")
trusted fun target(unit: int,source: int,lease: P4UartClockOwner,close: bool,select: bool): int =
    if (select) p4UartClockSelectOwned(unit,0,source) else (if (close) lease.closeOwned() else p4UartClockOpenOwned(unit,source))|0
