import "../src/display/it8951_rotation.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
@export("abla_it8951_rotation_test")
trusted fun testRotation(): i32 {
    val source=nativeBufferAt(memory,1024)
    val output=nativeBufferAt(memory+1024,1024)
    val expected=nativeBufferAt(memory+2048,1024)
    var width=1
    while (width <= 17) {
        var height=1
        while (height <= 13) {
            var rotation=0
            while (rotation < 8) {
                val lw=if (rotation%2 == 0) width else height
                val lh=if (rotation%2 == 0) height else width
                val ss=(lw+1)/2+2
                val ds=(width+1)/2+3
                var index=0
                while (index < 1024) {
                    source.store(index,(index*53+37)&255);output.store(index,0xa5);expected.store(index,0xa5);index=index+1
                }
                // Independent upstream sequence: software mirror first,
                // counterclockwise IT8951 hardware rotation second.
                val hardware=((4-rotation%4)%4)|(rotation&4)
                var y=0
                while (y < lh) {
                    var x=0
                    while (x < lw) {
                        val mirroredY=if (rotation >= 4) lh-y-1 else y
                        val rx=if (((hardware+1)&2) != 0) lw-x-1 else x
                        val ry=if ((hardware&2) != 0) lh-mirroredY-1 else mirroredY
                        val px=if (hardware%2 == 1) ry else rx
                        val py=if (hardware%2 == 1) rx else ry
                        val byte=source.load(y*ss+x/2)
                        val level=if (x%2 == 0) byte/16 else byte%16
                        val at=py*ds+px/2
                        val old=expected.load(at)
                        expected.store(at,if (px%2 == 0) level*16+old%16 else (old/16)*16+level)
                        x=x+1
                    }
                    y=y+1
                }
                if (!it8951Rotate4Owned(source,ss,output,ds,width,height,rotation,true)) return i32(1)
                index=0
                while (index < 1024) {
                    if (output.load(index) != expected.load(index) || source.load(index) != ((index*53+37)&255)) return i32(2)
                    index=index+1
                }
                rotation=rotation+1
            }
            height=height+1
        }
        width=width+1
    }
    var index=0
    while (index < 1024) { output.store(index,0xa5);index=index+1 }
    if (it8951Rotate4Owned(source,8,output,8,8,8,8,true) ||
        it8951Rotate4Owned(source,8,output,8,8,8,0,false) ||
        it8951Rotate4Owned(source,3,output,8,8,8,0,true) ||
        it8951Rotate4Owned(source,8,source,8,8,8,0,true) ||
        it8951Rotate4Owned(source,8,nativeBufferAt(output.addressValue(),59),8,8,8,0,true) ||
        it8951Rotate4Owned(source,8,output,8,0,8,0,true)) return i32(3)
    index=0
    while (index < 1024) { if (output.load(index) != 0xa5) return i32(4);index=index+1 }
    i32(0)
}
