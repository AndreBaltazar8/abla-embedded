import "../src/esp32/i2c_esp32s3.ab"
import "../src/touch/st7123_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_st7123_target")
trusted fun target(touch: St7123,snapshot: NativeBuffer,operation: int): int =
    if (operation == 0) (if (touch.begin()) 1 else -1) else if (operation == 1) touch.readFrame(snapshot) else (if (touch.close()) 1 else 0)
