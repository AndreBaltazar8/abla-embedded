import "../src/esp32/i2c_esp32s3.ab"
import "../src/touch/chsc6540_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_chsc6540_target")
trusted fun target(touch: Chsc6540,snapshot: NativeBuffer,initialize: bool): int =
    if (initialize) (if (touch.begin()) 0 else -1) else touch.readStable(snapshot)
