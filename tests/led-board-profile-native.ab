import "../src/m5stack/led_strip_buffer.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin=int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this|0
val storage=nativeBufferAt(nativeStaticAllocate(256),256)
@export("abla_led_board_profile_test")
trusted fun test(): i32 {
    val matrix=m5BoardAtomMatrix.ledProfile()
    if (matrix.backend() != 1 || matrix.count() != 25 || matrix.dataPinNumber() != 27) return i32(1)
    val color=m5BoardPaperColor.ledProfile()
    if (color.backend() != 1 || color.count() != 2 || color.dataPinNumber() != 21) return i32(2)
    val pmic=m5BoardStampS3Bat.ledProfile()
    if (pmic.backend() != 2 || pmic.count() != 1 || pmic.dataPinNumber() != 0) return i32(3)
    if (m5BoardPowerHub.ledProfile().backend() != 4 || m5BoardPowerHub.ledProfile().count() != 8 || m5BoardPaperMono.ledProfile().backend() != 3) return i32(4)
    val strip=m5BoardAtomMatrix.ledStripAt(storage)
    if (!strip.valid() || strip.count() != 25 || strip.pin() != 27 || strip.brightness() != 63 || strip.initialized()) return i32(5)
    storage.store(0,123)
    if (m5BoardPowerHub.ledStripAt(storage).valid() || m5BoardUnknown.ledStripAt(storage).valid() || storage.load(0) != 123) return i32(6)
    // Cover all currently assigned ID ranges, including gaps and aliases.
    var id=0
    while (id < 1024) {
        val board=M5BoardId(id)
        val profile=board.ledProfile()
        if (profile.backend() == 1 && (profile.dataPinNumber() != board.rgbLedPin().number() || !profile.available())) return i32(7)
        if (profile.backend() == 0 && profile.available()) return i32(8)
        id=id+1
    }
    return i32(0)
}
