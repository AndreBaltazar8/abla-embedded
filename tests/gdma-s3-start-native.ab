import "../src/esp32/gdma_control_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var base = 0
var link = 0
var flags = 0
var buffer = 0x3fc90000
var trace = 0
var transmit = false
var bad = false
trusted fun esp32s3GdmaRead(address: int): int {
    if (address == base + 32) return link
    if (address == 0x3fc88000) return flags
    if (address == 0x3fc88004) return buffer
    bad = true
    0
}
trusted fun esp32s3GdmaPublish(): void { trace = trace * 10 + 1; return }
trusted fun esp32s3GdmaWrite(address: int, value: int): void {
    trace = trace * 10 + 2
    val expected = (link & (0xffffffff ^ esp32s3GdmaCommandMask(transmit))) | (if (transmit) 1 << 21 else 1 << 22)
    if (address != base + 32 || value != expected || trace != 12) bad = true
    return
}
trusted fun gdmaStartTest(): int {
    var channel = 0
    while (channel < 5) {
        var direction = 0
        while (direction < 2) {
            transmit = direction == 1
            base = 0x6003f000 + channel * 192 + direction * 96
            var variant = 0
            while (variant < 8) {
                link = esp32s3GdmaParkMask(transmit) | esp32s3GdmaCommandMask(transmit) | 0x88000
                flags = 0x80010010
                buffer = 0x3fc90000
                if (variant == 1) link = 0x88000
                if (variant == 2) flags = 0x00010010
                if (variant == 3) flags = 0x80000000
                if (variant == 4) flags = 0x80011010
                if (variant == 5) buffer = 0x3fcffff4
                if (variant == 6) buffer = 0x3fc90001
                if (variant == 7) flags = 0x80000010
                trace = 0
                val expected = variant == 0 || (!transmit && (variant == 4 || variant == 7))
                if (esp32s3GdmaStart(channel, transmit) != expected || bad || trace != (if (expected) 12 else 0)) return 1
                variant = variant + 1
            }
            direction = direction + 1
        }
        channel = channel + 1
    }
    trace = 0
    if (esp32s3GdmaStart(-1, false) || esp32s3GdmaStart(5, true) || trace != 0) return 2
    0
}
#exportFunction("gdmaStartTest", "abla_gdma_start_test")
