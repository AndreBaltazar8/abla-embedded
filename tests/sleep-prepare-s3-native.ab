import "../src/esp32/power/sleep_prepare_s3_sequence.ab"
import "../src/esp32/power/sleep_resume_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Esp32S3ClockState = int
type Esp32S3ClockBias = int
type Esp32S3SleepUarts = int
type Esp32S3AnalogSleepState = int
fun Esp32S3ClockState.valid(): bool = this != 0
fun Esp32S3ClockBias.rtcLow(): int = 27
fun Esp32S3ClockBias.digitalLow(): int = 27
fun Esp32S3SleepUarts.ready(): bool = this == 1
var savedProgress=0
var header=0
var stage=0
var analogSaved=0
var events=0
var uartOk=true
var mspiResult=1
var clockOk=true
var restoreResult=1
var bad=false
fun esp32S3ClockRead(address: int): int = 0
fun esp32S3ClockDecode(a: int,b: int,c: int): Esp32S3ClockState = Esp32S3ClockState(123)
fun esp32S3ClockResumeMegahertz(clock: Esp32S3ClockState): int = 80
fun esp32S3MspiStateRead(address: int): int { if (address != 4096) bad=true; return header }
fun esp32S3MspiStateWrite(address: int,value: int): void {
    if (address == 4096) {
        if (value == 0 && (stage != 6 || !Esp32S3SleepResume(savedProgress).valid() || !Esp32S3SleepResume(savedProgress).complete())) bad=true
        header=value
    }
    else if (address == 4100) stage=value
    else if (address != 4144 || value != 0) bad=true
    return
}
fun esp32S3MspiStateStore64(address: int,value: int): void {
    if (address == 4104) { if (value != 123) bad=true }
    else if (address == 4112) analogSaved=value
    else if (address == 4120) { if (value != 1) bad=true }
    else if (address == 4128) { if (value != 0) bad=true }
    else if (address == 4136) savedProgress=value
    else bad=true
    return
}
fun esp32S3SleepUartsPrepareOwned(ports: int,deep: bool,polls: int): Esp32S3SleepUarts { events=events*10+1; return Esp32S3SleepUarts(if (uartOk) 1 else 0) }
fun Esp32S3SleepUarts.resumeOwned(): Esp32S3SleepUarts { events=events*10+5; return Esp32S3SleepUarts(0) }
fun esp32S3MspiLowBeginOwned(buffer: NativeBuffer,octal: bool,ram: int,protocol: int,baseline: int,polls: int): int {
    if (buffer.addressValue() != 4144 || header != 0x53504C50 || stage != 1) bad=true
    events=events*10+2; return mspiResult
}
fun esp32S3ClockToXtalOwned(rtc: int,dig: int,disable: bool): Esp32S3ClockState {
    if (stage != 2 || rtc != 27 || dig != 27 || !disable) bad=true
    events=events*10+3; return Esp32S3ClockState(if (clockOk) 123 else 0)
}
fun esp32S3MspiLowEndOwned(buffer: NativeBuffer,polls: int): int { events=events*10+4; return restoreResult }
fun esp32S3AnalogSleepCaptureOwned(): Esp32S3AnalogSleepState { events=events*10+6; return Esp32S3AnalogSleepState(0xFEDCBA9876543210) }
fun esp32S3ClockResumeFromXtalOwned(clock: Esp32S3ClockState,bias: Esp32S3ClockBias,polls: int): int { bad=true; 0 }
fun esp32S3AnalogSleepRestoreOwned(saved: Esp32S3AnalogSleepState): void { bad=true; return }
@export("abla_sleep_prepare_test")
trusted fun prepareTest(): i32 {
    var uart=0
    while (uart < 2) {
        uartOk=uart == 1; mspiResult=0
        while (mspiResult < 8) {
            var clock=0
            while (clock < 2) {
                clockOk=clock == 1; restoreResult=1
                while (restoreResult <= 7) {
                    header=0; stage=0; events=0; bad=false; analogSaved=0
                    val result=esp32S3SleepPrepareOwned(nativeBufferAt(4096,104),Esp32S3ClockBias(0),7,false,-1,0,0,8)
                    val expected=if (!uartOk) 2 else if (mspiResult == 7) 7 else if (mspiResult != 1) 3 else if (!clockOk) (if (restoreResult == 1) 4 else 7) else 1
                    val order=if (!uartOk) 1 else if (mspiResult == 7) 12 else if (mspiResult != 1) 125 else if (!clockOk) (if (restoreResult == 1) 12345 else 1234) else 1236
                    if (bad || result != expected || events != order || header != (if (expected == 1 || expected == 7) 0x53504C50 else 0)) return i32(1)
                    if (expected == 1 && (stage != 3 || analogSaved != 0xFEDCBA9876543210)) return i32(2)
                    if (expected == 7 && stage != 7) return i32(3)
                    if ((expected == 3 || expected == 4) && (stage != 6 || !Esp32S3SleepResume(savedProgress).complete() || Esp32S3SleepResume(savedProgress).apbHertz() != 80000000)) return i32(5)
                    restoreResult=restoreResult+2
                }
                clock=clock+1
            }
            mspiResult=mspiResult+1
        }
        uart=uart+1
    }
    header=1; events=0
    if (esp32S3SleepPrepareOwned(nativeBufferAt(4096,104),Esp32S3ClockBias(0),7,false,-1,0,0,8) != 0 || events != 0) return i32(4)
    i32(0)
}
