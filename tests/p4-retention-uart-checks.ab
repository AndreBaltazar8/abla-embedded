import "../src/esp32/power/retention_uart_p4.ab"
import "../src/esp32/power/retention_list_p4.ab"
val uartRetentionConfigs=nativeStaticAllocate(168)
val uartRetentionOutput=nativeStaticAllocate(120)
val uartRetentionScratch=nativeStaticAllocate(36)
val uartRetentionStorage=nativeStaticAllocate(88)
trusted fun uartRetentionChecks(): int {
    val configs=nativeBufferAt(uartRetentionConfigs,168)
    val out=nativeBufferAt(uartRetentionOutput,120)
    val scratch=nativeBufferAt(uartRetentionScratch,36)
    var uart=0
    while (uart < 5) {
        var node=0
        while (node < 3) {
            val c=nativeBufferAt(uartRetentionConfigs+node*56,56)
            if (!esp32p4RetentionUartConfig(c,uart,node,if (node == 0) uartRetentionStorage else 0,0)) return 70
            node=node+1
        }
        out.storeU32(116,0x12345678)
        if (esp32p4RetentionListEncode(out,configs,scratch,3) != 116 || out.loadU32(116) != 0x12345678) return 71
        val base=0x500ca000+uart*4096
        if (out.loadU32(0) != 0x10016 || out.loadU32(4) != uartRetentionOutput+36 ||
            out.loadU32(8) != base+12 || out.loadU32(12) != base+12 || out.loadU32(16) != uartRetentionStorage ||
            out.loadU32(20) != 0x807fff6d || out.loadU32(24) != 16 || out.loadU32(28) != 0 || out.loadU32(32) != 0) return 72
        // Independent list of retained offsets: exclude FIFO/status/W1C and
        // reg-update; include ID at9c (bitmap's highest selected position).
        var bit=0
        while (bit < 128) {
            val offset=12+bit*4
            val expected=offset == 12 || offset == 20 || offset == 24 || offset == 32 || offset == 36 ||
                (offset >= 44 && offset <= 100) || offset == 136 || offset == 156
            if (((out.loadU32(20+(bit/32)*4)&(1<<(bit%32))) != 0) != expected) return 73
            bit=bit+1
        }
        node=0
        while (node < 4) {
            val offset=36+node*20
            val terminal=node == 3
            if (out.loadU32(offset) != (0x40000000|((if (node == 0 || node == 2) 2 else 3)<<16)|(if (terminal) 0x80000000 else 0)) ||
                out.loadU32(offset+4) != (if (terminal) 0 else uartRetentionOutput+offset+20) ||
                out.loadU32(offset+8) != (if (node < 2) base+0x98 else 0x501153fc) ||
                out.loadU32(offset+12) != (if (node == 0) 1 else if (node == 1) 0 else 0xffffffff) || out.loadU32(offset+16) != 1) return 74
            node=node+1
        }
        uart=uart+1
    }
    var fault=0
    while (fault < 7) {
        var word=0
        while (word < 56) { configs.storeU32(word,0x12345678);word=word+4 }
        if (esp32p4RetentionUartConfig(configs,if (fault == 0) -1 else if (fault == 1) 5 else 0,
            if (fault == 2) 3 else if (fault == 3) 1 else 0,
            if (fault == 4) 0xfffffffc else if (fault == 5) uartRetentionConfigs else uartRetentionStorage,
            if (fault == 6) uartRetentionConfigs+4 else 0)) return 75
        word=0
        while (word < 56) { if (configs.loadU32(word) != 0x12345678) return 76;word=word+4 }
        fault=fault+1
    }
    return 0
}
