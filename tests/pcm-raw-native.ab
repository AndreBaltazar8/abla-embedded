import "../src/audio/wav_resample.ab"
import "abla/runtime/scalar"
import "abla/build"
val rawSource=nativeStaticAllocate(512)
val rawMetadata=nativeStaticAllocate(20)
val rawOutput=nativeStaticAllocate(1024)
@export("abla_pcm_raw_test")
trusted fun rawPcmTest(): i32 {
    val source=nativeBufferAt(rawSource,512)
    val metadata=nativeBufferAt(rawMetadata,20)
    val output=nativeBufferAt(rawOutput,1024)
    var i=0
    while (i < 256) { source.store(i*2,i); source.store(i*2+1,255-i); i=i+1 }
    var mode=0
    while (mode < 2) {
        val signed=mode == 1
        val pcm=pcmRaw(source,metadata,16000,2,8,signed)
        if (!pcm.valid() || pcm.frames() != 256 || pcm.signed8() != signed ||
            pcm.copyStereo16(0,256,output) != 1024) return i32(1)
        i=0
        while (i < 256) {
            val left=(if (signed) (if (i >= 128) i-256 else i) else i-128)*256
            val right=(if (signed) (if (255-i >= 128) -1-i else 255-i) else 127-i)*256
            if (output.loadU16(i*4) != (left & 65535) || output.loadU16(i*4+2) != (right & 65535)) return i32(2)
            i=i+1
        }
        if (pcm.copyResampledStereo16(0,256,16000,output) != 1024) return i32(3)
        i=0
        while (i < 256) {
            val expected=(if (signed) (if (i >= 128) i-256 else i) else i-128)*256
            if (output.loadU16(i*4) != (expected & 65535)) return i32(4)
            i=i+1
        }
        mode=mode+1
    }
    metadata.storeU32(0,12345)
    if (pcmRaw(source,metadata,0,2,8).valid() || pcmRaw(source,metadata,16000,3,8).valid() ||
        pcmRaw(source,metadata,16000,2,16,false).valid() ||
        pcmRaw(nativeBufferAt(rawSource,511),metadata,16000,2,8).valid() ||
        pcmRaw(source,source,16000,2,8).valid() || metadata.loadU32(0) != 12345) return i32(5)
    i32(0)
}
