import "../src/esp32/psram/sweep_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(256)
var speed=20
var speedCalls=0
var candidateCalls=0
var reads=0
var writes=0
var phase=0
var candidate=15
var mode=0
var bad=false
var expectedAddress=128
fun p4PsramCommandStorageSafe(address: int,length: int): bool = address >= memory && address+length <= memory+256
fun p4PsramProfileValid(mhz: int): bool = mhz == 20 || mhz == 80 || mhz == 200 || mhz == 250
fun p4PsramSweepSpeed(mapped: int,command: int,polls: int): int {
    speedCalls=speedCalls+1
    if (mapped != 20 || (command != 20 && command != 2) || polls != 3) bad=true
    if (mode == 5 && speedCalls == 3) return 773
    speed=command; return 1
}
fun p4PsramSweepCandidate(p: int,index: int,polls: int): int {
    candidateCalls=candidateCalls+1; phase=p; candidate=index
    if (mode == 4 && candidateCalls == 7) return 261
    return 1
}
fun p4PsramSweepCommand(write: bool,address: int,mhz: int,scratch: NativeBuffer,work: NativeBuffer): int {
    if (address != expectedAddress || mhz != 200) bad=true
    if (write) {
        writes=writes+1
        if (speed != 20 || writes != 1) bad=true
        var i=0
        while (i < 64) { if (scratch.load(i) != ((i*73+41)&255)) bad=true; i=i+1 }
        return 1
    }
    reads=reads+1
    if (mode == 3 && reads == 20) return 4
    val passing=if (speed == 20) mode != 6 else phase == 1 && candidate >= 10 && candidate <= 16 && mode != 1 && !(mode == 2 && reads > 125)
    var i=0
    while (i < 64) { scratch.store(i,((i*73+41)&255)^(if (passing) 0 else 1)); i=i+1 }
    return 1
}
@export("abla_p4_psram_sweep_test")
trusted fun sweepTest(): i32 {
    val scratch=nativeBufferAt(memory+101,64); val work=nativeBufferAt(memory,100); val passes=nativeBufferAt(memory+168,16)
    mode=0
    while (mode <= 6) {
        speed=20; speedCalls=0; candidateCalls=0; reads=0; writes=0; bad=false
        val result=p4PsramReadSweepOwned(200,false,16777216,128,scratch,work,passes,3)
        val expected=if (mode == 0) 1 else if (mode == 1) 4 else if (mode == 2) 5 else 3
        if ((result&255) != expected || bad || writes != 1) return i32(1)
        if (mode != 5 && speed != 20) return i32(2)
        if (mode == 0 && (result != (1|(1<<8)|(13<<16)) || reads != 129 || candidateCalls != 126 || passes.loadU32(4) != 0x1fc00 || passes.loadU32(0) != 0 || passes.loadU32(8) != 0 || passes.loadU32(12) != 0)) return i32(3)
        if (mode == 5 && ((result&(1<<32)) == 0 || ((result>>>40)&65535) != 773)) return i32(4)
        if (mode == 6 && (speedCalls != 2 || reads != 1)) return i32(5)
        mode=mode+1
    }
    mode=0; expectedAddress=64; speedCalls=0; candidateCalls=0; reads=0; writes=0; bad=false
    if ((p4PsramReadSweepOwned(200,true,16777216,128,scratch,work,passes,3)&255) != 1 || bad) return i32(6)
    speedCalls=0
    if (p4PsramReadSweepOwned(100,false,16777216,128,scratch,work,passes,3) != 2 ||
        p4PsramReadSweepOwned(200,false,16777216,1,scratch,work,passes,3) != 2 ||
        p4PsramReadSweepOwned(200,false,16777216,128,scratch,work,nativeBufferAt(memory+160,16),3) != 2 || speedCalls != 0) return i32(7)
    return i32(0)
}
