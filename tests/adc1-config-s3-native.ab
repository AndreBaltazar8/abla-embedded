import "../src/esp32/adc1_config_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var control=0
var mux=0
var sample=0
var attenuationWord=0
var state=0
var writes=0
var reads=0
var drop=0
var bad=false
fun esp32S3Adc1Read(offset: int): int {
    reads=reads+1
    if (offset == 0) return control
    if (offset == 16) return mux
    if (offset == 12) return sample
    if (offset == 20) return attenuationWord
    if (offset == 64) return state
    bad=true; return 0
}
fun esp32S3Adc1Write(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0) { control=value; return }
    if (offset == 20) { attenuationWord=value; return }
    if (offset == 12) { sample=value; return }
    bad=true; return
}
fun reset(): void {
    control=0xb7fc00fe; mux=0; sample=0; attenuationWord=0xa55aa55a
    writes=0; reads=0; drop=0; state=0; return
}
@export("abla_adc1_config_s3_test")
fun test(): i32 {
    var channel=0
    while (channel < 10) {
        var attenuation=0
        while (attenuation < 4) {
            reset()
            val desired=(attenuationWord&(4294967295^(3<<(channel*2))))|(attenuation<<(channel*2))
            if (esp32S3Adc1ConfigureOwned(channel,attenuation,3) != 1 || writes != 3) return i32(1)
            if (control != 0x87fc0001 || attenuationWord != desired || sample != 0x80040000 || !esp32S3Adc1Prepared() || bad) return i32(2)
            attenuation=attenuation+1
        }
        channel=channel+1
    }
    var stage=1
    while (stage <= 3) {
        reset(); drop=stage
        if (esp32S3Adc1ConfigureOwned(0,1,3) != ((stage<<8)|5) || writes != stage) return i32(3)
        drop=0
        if (esp32S3Adc1ConfigureOwned(0,1,3) != 1) return i32(4)
        stage=stage+1
    }
    reset(); mux=0x80000000
    if (esp32S3Adc1ConfigureOwned(0,1,3) != 3 || writes != 0) return i32(5)
    reset(); sample=0x800c0000
    if (esp32S3Adc1ConfigureOwned(1,1,3) != 3 || writes != 0) return i32(6)
    reset(); sample=0x80060000
    if (esp32S3Adc1ConfigureOwned(0,1,3) != 4 || writes != 0) return i32(7)
    reset(); state=0x400000
    if (esp32S3Adc1ConfigureOwned(0,1,3) != 4 || writes != 0) return i32(8)
    reset()
    if (esp32S3Adc1ConfigureOwned(-1,0,3) != 2 || esp32S3Adc1ConfigureOwned(10,0,3) != 2 || esp32S3Adc1ConfigureOwned(0,4,3) != 2 || esp32S3Adc1ConfigureOwned(0,0,0) != 2 || reads != 0 || writes != 0) return i32(9)
    return i32(0)
}
