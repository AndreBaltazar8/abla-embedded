import "../src/esp32/gdma_control_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// This fixture exercises configure/stop only; start ordering has its own test.
trusted fun esp32s3GdmaPublish(): void { return }
var base = 0
var link = 0
var transmit = false
var port = 0
var writes = 0
var reads = 0
var stopping = false
var bad = false
var originalConfig = 0
trusted fun esp32s3GdmaRead(address: int): int {
    reads = reads + 1
    if (address == base + 32) return link
    if (address == base) return originalConfig
    if (address == base + 4) return 0x55000055
    if (address == base + 72) return 0xaaaaaaff
    bad = true
    0
}
trusted fun esp32s3GdmaWrite(address: int, value: int): void {
    writes = writes + 1
    if (stopping) {
        if (address != base + 32 || value != ((link & (0xffffffff ^ esp32s3GdmaCommandMask(transmit))) | (if (transmit) 1 << 20 else 1 << 21))) bad = true
    } else if (writes == 1) {
        if (address != base || value != (originalConfig | 1)) bad = true
    } else if (writes == 2) {
        val expectedConfig = if (transmit) (originalConfig & 0xfffffffe) | 12 else originalConfig & 0xffffffee
        if (address != base || value != expectedConfig) bad = true
        if (transmit && (value & 13) != 12) bad = true
    } else if (writes == 3) {
        if (address != base + 4 || value != 0x55001055) bad = true
    } else if (writes == 4) {
        if (address != base + 72 || value != (0xaaaaaac0 | (if (port == 2) 9 else if (port == 3) 5 else 3 + port))) bad = true
    } else if (writes == 5) {
        val expected = esp32s3GdmaParkMask(transmit) | (if (transmit) 0 else 1 << 20) | 0x88000
        if (address != base + 32 || value != expected) bad = true
    } else bad = true
    return
}
trusted fun gdmaS3Test(): int {
    var channel = 0
    while (channel < 5) {
        var direction = 0
        while (direction < 2) {
            transmit = direction == 1
            base = 0x6003f000 + channel * 192 + direction * 96
            link = esp32s3GdmaParkMask(transmit) | esp32s3GdmaCommandMask(transmit) | (if (transmit) 0 else 1 << 20)
            port = 0
            while (port < (if (transmit) 4 else 2)) {
                // Exercise every prior low-bit combination: reset, FIFO/loop,
                // auto-writeback, EOF mode and burst/M2M configuration.
                var prior = 0
                while (prior < 64) {
                    originalConfig = 0xa5a50000 | prior
                    writes = 0; reads = 0; stopping = false
                    val configured = if (port == 3) esp32s3GdmaConfigureLcd(channel,0x3fc88000) else if (port == 2) esp32s3GdmaConfigureRmt(channel, 0x3fc88000)
                        else esp32s3GdmaConfigureI2s(channel, transmit, port, 0x3fc88000)
                    if (!configured || writes != 5 || bad) return 1
                    prior = prior + 1
                }
                port = port + 1
            }
            writes = 0; stopping = true
            if (!esp32s3GdmaRequestStop(channel, transmit) || writes != 1 || bad) return 2
            link = 0; writes = 0
            if (esp32s3GdmaConfigureI2s(channel, transmit, 0, 0x3fc88000) || writes != 0) return 3
            direction = direction + 1
        }
        channel = channel + 1
    }
    reads = 0; writes = 0
    if (esp32s3GdmaConfigureI2s(-1, false, 0, 0x3fc88000) || esp32s3GdmaConfigureI2s(5, false, 0, 0x3fc88000) || esp32s3GdmaConfigureI2s(0, false, 2, 0x3fc88000)) return 4
    if (esp32s3GdmaConfigureI2s(0, false, 0, 0x3fc87ffc) || esp32s3GdmaConfigureI2s(0, false, 0, 0x3fcffff8) || esp32s3GdmaConfigureI2s(0, false, 0, 0x3fc88001) || reads != 0 || writes != 0) return 5
    if (!esp32s3GdmaDescriptorValid(0x3fcffff4)) return 6
    reads=0;writes=0
    if (esp32s3GdmaConfigureStreamTrigger(0,false,5,0x3fc88000) || reads != 0 || writes != 0) return 7
    0
}
#exportFunction("gdmaS3Test", "abla_gdma_s3_test")
