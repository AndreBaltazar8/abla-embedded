import "../src/esp32/power/sleep_bias_p4_sequence.ab"
import "abla/unsafe/native"
var active=u32(0xffffffff)
var hp=u32(0xffffffff)
var lp=u32(0xffffffff)
var writes=0
var fail=0
var bad=false
trusted fun p4SleepBiasRead(offset: int): u32 {
    if (offset == 24) return active
    if (offset == 128) return hp
    if (offset == 200) return lp
    bad=true;return u32(0)
}
trusted fun p4SleepBiasWrite(offset: int,value: u32): void {
    writes=writes+1;if (writes == fail) return
    if (offset == 24) { active=value;return }
    if (offset == 128) { hp=value;return }
    if (offset == 200) { lp=value;return }
    bad=true;return
}
trusted fun seed(r: NativeBuffer): void {
    active=u32(0xffffffff);hp=u32(0xffffffff);lp=u32(0xffffffff)
    writes=0;fail=0;bad=false
    var i=0
    while (i < 28) { r.storeU32(i,0);i=i+4 }
    r.storeU32(28,0x12345678);return
}
@export("abla_sleep_bias_p4_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(nativeStaticAllocate(32),32)
    var deep=0
    while (deep < 2) {
        var phase=0
        while (phase < 2) {
            var fault=0
            while (fault <= 3) {
                seed(r);if (phase == 0) fail=fault
                val opened=esp32p4SleepBiasOpenOwned(r,u32(0),u32(0),deep == 1,true)
                if ((phase == 1 || fault == 0) && opened != 1) return i32(1)
                if (phase == 0 && fault != 0 && (opened != 3 || r.loadU32(8) != fault)) return i32(2)
                if (opened == 1 && (active != (if (deep == 1) u32(0xfe7fffff) else u32(0xfeffffff)) ||
                    hp != u32(0x0203ffff) || lp != u32(0x03ffffff))) return i32(3)
                val primary=r.loadU32(8);writes=0;fail=if (phase == 1) fault else 0
                val closed=esp32p4SleepBiasCloseOwned(r,true)
                if (phase == 1 && fault != 0 && (closed != 3 || r.loadU32(12) != 4-fault)) return i32(4)
                fail=0
                if (esp32p4SleepBiasCloseOwned(r,true) != 4 || active != u32(0xffffffff) || hp != u32(0xffffffff) ||
                    lp != u32(0xffffffff) || r.loadU32(8) != primary || r.loadU32(28) != 0x12345678 || bad) return i32(5)
                fault=fault+1
            }
            phase=phase+1
        }
        deep=deep+1
    }
    var bit=0
    while (bit < 32) {
        seed(r);val mask=u32(1)<<u32(bit)
        val result=esp32p4SleepBiasOpenOwned(r,mask,u32(0),false,true)
        if ((mask&u32(0xfdfc0000)) == u32(0)) { if (result != 2 || writes != 0) return i32(6) }
        else if (result != 1 || (hp&u32(0xfdfc0000)) != mask) return i32(7)
        bit=bit+1
    }
    return i32(0)
}
