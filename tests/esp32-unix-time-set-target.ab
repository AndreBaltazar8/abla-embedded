import "../src/esp32/platform_full_link_esp32.ab"
import "../src/esp32/unix_time_set_idf6.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_unix_time_set_target")
trusted fun timeSetTarget(seconds: int): bool {
    // Full scheduler/ROM profile requires errno and all three stream slots.
    // Caller owns initialized startup, TLS, timers and task locking.
    if (!esp32PicolibcTlsCompatibilityReady()) return false
    setUnixTimeSeconds(seconds)
}
