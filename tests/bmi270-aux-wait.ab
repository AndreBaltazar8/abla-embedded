import "../src/i2c/results.ab"
import "../src/imu/bmi270_aux_wait.ab"
type I2cDevice = int
var reads=0
var delays=0
var readyAt=0
var failureAt=0
var payload=0
var bad=false
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    if (this != 1 || register != 3 || reads != delays) bad=true
    reads=reads+1
    if (reads == failureAt) return I2cByteResult(0)
    I2cByteResult(256 | payload | (if (reads < readyAt) 4 else 0))
}
fun imuDelay(ticks: int): void {
    if (ticks != 1 || reads != delays+1) bad=true
    delays=delays+1
    return
}
fun main(): int {
    payload=0
    while (payload < 256) {
        if ((payload & 4) == 0) {
            readyAt=1
            while (readyAt <= 4) {
                failureAt=0
                while (failureAt <= 3) {
                    reads=0; delays=0; bad=false
                    val result=I2cDevice(1).waitBmi270AuxiliaryReady()
                    val failed=failureAt > 0 && failureAt <= readyAt
                    val expectedReads=if (failed) failureAt else if (readyAt > 3) 3 else readyAt
                    val success=readyAt <= 3 && !failed
                    if (result != success || bad || reads != expectedReads ||
                        delays != expectedReads-(if (failed || success) 1 else 0)) return 1
                    failureAt=failureAt+1
                }
                readyAt=readyAt+1
            }
        }
        payload=payload+1
    }
    0
}
