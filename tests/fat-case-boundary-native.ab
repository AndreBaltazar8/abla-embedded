import "../src/storage/fat_file_rename.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(10000)
val disk=nativeStaticAllocate(2048)
var writes=0
var failAt=0
var committed=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    if (lba != 0 && (lba < 81 || lba > 84)) return false
    val source=if (lba == 0) nativeBufferAt(memory+64,512) else nativeBufferAt(disk+(lba-81)*512,512)
    var i=0;while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,input: NativeBuffer): bool {
    if (lba < 81 || lba > 84) return false
    writes=writes+1
    if (writes != failAt || committed) {
        val target=nativeBufferAt(disk+(lba-81)*512,512)
        var i=0;while (i < 512) { target.store(i,input.load(i));i=i+1 }
    }
    return writes != failAt
}
@export("abla_fat_case_boundary_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,32);val reader=nativeBufferAt(memory+32,28)
    val boot=nativeBufferAt(memory+64,512);val expected=nativeBufferAt(memory+576,32)
    val work=nativeBufferAt(memory+640,5352);val scratch=nativeBufferAt(memory+6016,512)
    val name=nativeBufferAt(memory+6592,14);val all=nativeBufferAt(disk,2048)
    val spelling=nativeBufferAt(nativeStaticBytes("FoO.TxT"),7)
    val alias=nativeBufferAt(nativeStaticBytes("FOO     TXT"),11)
    var i=0;while (i < 512) { boot.store(i,0);i=i+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2)
    boot.storeU16(17,512);boot.storeU16(22,40);boot.storeU16(19,10113);boot.storeU16(510,0xaa55)
    i=0;while (i < 7) { name.storeU16(i*2,spelling.load(i));i=i+1 }
    i=0;while (i < 32) { expected.store(i,0);i=i+1 }
    i=0;while (i < 11) { expected.store(i,alias.load(i));i=i+1 }
    expected.store(11,33);expected.storeU16(26,2);expected.storeU32(28,100)
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    var position=0
    while (position < 32) {
        var total=0;var scenario=0
        while (scenario <= total*2) {
            writes=0;failAt=if (scenario == 0) 0 else (scenario+1)/2;committed=(scenario&1) == 0
            i=0;while (i < 2048) { all.store(i,0);i=i+1 }
            // Occupied unrelated entries force publication immediately AFTER
            // the source, including LFN/SFN and end-marker sector crossings.
            i=0;while (i < position) {
                var j=0;while (j < 11) { all.store(i*32+j,32);j=j+1 }
                all.store(i*32,65+i%26);all.store(i*32+1,48+i/26);all.store(i*32+11,32);i=i+1
            }
            i=0;while (i < 32) { all.store(position*32+i,expected.load(i));i=i+1 }
            val volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch)
            val result=volume.renameFile(u32(7),0,position/16,position%16,expected,0,name,7,1,8,64,work)
            if (scenario == 0) {
                if (result.status() != 1 || all.load(position*32) != 229) return i32(2)
                total=writes
                val assembled=nativeBufferAt(memory+6656,520)
                val lfn=FatLongName(0).consume(nativeBufferAt(disk+(position+1)*32,32),assembled)
                val renamed=nativeBufferAt(disk+(position+2)*32,32)
                if (!lfn.matches(renamed,assembled) || lfn.length() != 7) return i32(3)
                i=0;while (i < 7) { if (assembled.loadU16(i*2) != name.loadU16(i*2)) return i32(4);i=i+1 }
                i=11;while (i < 32) { if (renamed.load(i) != expected.load(i)) return i32(5);i=i+1 }
            } else if (writes != failAt || state.loadU32(12) != 3 ||
                result.status() != (if (failAt == total) 16 else 15)) return i32(6)
            i=0;while (i < position) {
                if (all.load(i*32) != 65+i%26 || all.load(i*32+1) != 48+i/26 || all.load(i*32+11) != 32) return i32(7)
                i=i+1
            }
            if (!volume.invalidate(u32(7))) return i32(8)
            scenario=scenario+1
        }
        position=position+1
    }
    return i32(0)
}
