import "../src/esp32/i2c/pins_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var sda=0
var scl=0
var pulls=false
var blocked=0
var original=0
var calls=0
var writes=0
var bad=false
fun pairMask(): int = (1<<sda)|(1<<scl)
fun preflights(): int = if ((pairMask()&127) != 0) 2 else 1
fun expectedAddress(operation: int): int {
    if (operation == 0) return 0x6009103C
    val pair=(operation-1)/6
    val field=((operation-1)%6)/2
    val pin=if (pair == 0) scl else sda
    if (field == 0) 0x60091AD4+pin*4 else if (field == 1) 0x60090000+pin*4 else 0x600912D4+(46+pair)*4
}
fun c5I2cPinLoad(address: int): int {
    val call=calls
    calls=calls+1
    if (call == 0) {
        if (address != 0x600B102C) bad=true
        return if (blocked == 1) 1<<sda else 0
    }
    if (call == 1 && preflights() == 2) {
        if (address != 0x600B1028) bad=true
        return if (blocked == 2) pairMask()&127 else 0
    }
    val operation=call-preflights()
    if (operation < 1 || operation >= 13 || (operation&1) != 1 || address != expectedAddress(operation)) bad=true
    original
}
fun c5I2cPinStore(address: int,value: int): void {
    val operation=calls-preflights()
    calls=calls+1; writes=writes+1
    if (address != expectedAddress(operation)) bad=true
    if (operation == 0) {
        if (value != pairMask()) bad=true
        return
    }
    if (operation < 2 || operation > 12 || (operation&1) != 0) bad=true
    val field=((operation-1)%6)/2
    val mask=if (field == 0) 4095 else if (field == 1) 0x7382 else 511
    val payload=if (field == 0) 1280 else if (field == 1) 0x1200 else 320
    if (value != ((original&~mask)|payload)) bad=true
    return
}
@export("abla_c5_i2c_release_test")
trusted fun pinsTest(): i32 {
    var profile=0
    while (profile < 20184) {
        sda=profile%29; scl=(profile/29)%29
        pulls=((profile/841)&1) != 0
        blocked=(profile/1682)%3
        val pattern=profile/5046
        original=if (pattern == 0) 0 else if (pattern == 1) 0xFFFFFFFF else if (pattern == 2) 0xA5A5A5A5 else 0x5A5A5A5A
        calls=0; writes=0; bad=false
        val valid=sda != scl && sda != 13 && sda != 14 && scl != 13 && scl != 14
        val held=blocked == 1
        val lp=blocked == 2 && (pairMask()&127) != 0
        val success=valid && !held && !lp
        if (esp32C5I2cReleasePinsOwned(0,sda,scl) != success ||
            calls != (if (!valid) 0 else if (held) 1 else if (lp) 2 else preflights()+13) ||
            writes != (if (success) 7 else 0) || bad) return i32(1)
        profile=profile+1
    }
    calls=0
    if (esp32C5I2cReleasePinsOwned(1,2,3) || esp32C5I2cReleasePinsOwned(0,-1,3) ||
        esp32C5I2cReleasePinsOwned(0,2,29) || calls != 0) return i32(2)
    i32(0)
}
