import "../src/esp32/mspi_timing_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(132)
var target=0
var writes=0
var failAt=0
var commits=0
var latchedMode=0
var latchedNum=0
var latchedCal=0
var bad=false
var ready=13
var clock=0x603
var initialClock=1
fun index(address: int): int = if (address >= 0x60002180 && address <= 0x60002188) (address-0x60002180)/4 else
    if (address >= 0x60003180 && address <= 0x60003188) 3+(address-0x60003180)/4 else
    if (address >= 0x60002190 && address <= 0x60002198) 6+(address-0x60002190)/4 else -1
fun initial(i: int): int = if (i%3 == 0) 0x12340020|(if (i == 0) initialClock else 1)|(if (i == 6) 64 else 0) else if (i%3 == 1) 0xa8000000|(2*0x1249249) else 0xd0000000|0x15555
trusted fun value(i: int): int = nativeBufferAt(memory+96,36).loadU32(i*4)
trusted fun c5MspiRead(address: int): int {
    if (address == 0x60096018) return ready
    if (address == 0x6009601c) return clock
    val i=index(address)
    if (i < 0 || (target == 1 && i > 3) || (target != 1 && i/3 != target && i != 0)) { bad=true;return 0 }
    return value(i)|(if (i == 0 || i == 3) 64 else 0)
}
trusted fun c5MspiWrite(address: int,bits: int): void {
    val i=index(address)
    if (i < 0) { bad=true;return }
    if (i == 0 && (bits&64) != 0) {
        commits=commits+1
        latchedMode=value((if (target == 1) 0 else target*3)+1)&0x7ffffff
        latchedNum=value((if (target == 1) 0 else target*3)+2)&0x3ffff
        latchedCal=value(target*3)&31
        if ((bits&~64) != value(0)) bad=true
    } else {
        if ((target == 1 && i > 3) || (target != 1 && i/3 != target) || (i == 3 && (bits&64) != 0)) bad=true
        writes=writes+1
        if (writes == failAt) return
    }
    nativeBufferAt(memory+96,36).storeU32(i*4,if (i == 0 || i == 3) bits&~64 else bits)
    return
}
@export("abla_mspi_timing_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,48);val regs=nativeBufferAt(memory+96,36)
    target=0
    while (target < 3) {
        var mode=0
        while (mode < 7) {
            var num=0
            while (num < 4) {
                var extra=0
                while (extra < 8) {
                    var scenario=0
                    while (scenario < 18) {
                        initialClock=scenario&1
                        var i=0;while (i < 9) { regs.storeU32(i*4,initial(i));i=i+1 }
                        record.storeU32(0,0);writes=0;failAt=scenario%9;commits=0;bad=false
                        latchedMode=0;latchedNum=0;latchedCal=0
                        val first=esp32C5MspiTimingOwned(record,target,mode,num,extra,true)
                        if (first != 1 && first != 3 || bad || commits != (if (first == 1) 1 else 0)) return i32(1)
                        if (scenario < 9) {
                            failAt=0
                            if (esp32C5MspiTimingOwned(record,target,mode,num,extra,true) != 1 || commits != 1 ||
                                latchedMode != mode*0x1249249 || latchedNum != num*0x15555 ||
                                latchedCal != (1|(if (extra > 0) 2 else 0)|(extra<<2))) return i32(2)
                            failAt=writes+(scenario%9)
                        }
                        val published=commits
                        // Reserved/DLL fields may change under their separate
                        // owner; only this lease's fields are restored.
                        i=0;while (i < 9) { regs.storeU32(i*4,value(i)^0x80000000);i=i+1 }
                        val closed=esp32C5MspiTimingCloseOwned(record,true)
                        if (closed != 3 && closed != 4) return i32(3)
                        failAt=0
                        if (esp32C5MspiTimingCloseOwned(record,true) != 4 || bad || commits != published+1) return i32(4)
                        i=0;while (i < 9) { if (value(i) != (initial(i)^0x80000000)) return i32(5);i=i+1 }
                        val count=commits
                        if (esp32C5MspiTimingCloseOwned(record,true) != 4 || commits != count ||
                            esp32C5MspiTimingOwned(record,target,mode,num,extra,true) != 2) return i32(6)
                        scenario=scenario+1
                    }
                    extra=extra+1
                }
                num=num+1
            }
            mode=mode+1
        }
        target=target+1
    }
    record.storeU32(0,0);writes=0;commits=0;target=0
    if (esp32C5MspiTimingOwned(record,0,7,0,0,true) != 2 || esp32C5MspiTimingOwned(record,3,0,0,0,true) != 2 ||
        esp32C5MspiTimingOwned(record,0,0,4,0,true) != 2 || esp32C5MspiTimingOwned(record,0,0,0,8,true) != 2 ||
        esp32C5MspiTimingOwned(record,0,0,0,0,false) != 2 || writes != 0 || commits != 0) return i32(7)
    ready=11
    if (esp32C5MspiTimingOwned(record,0,0,0,0,true) != 2 || record.loadU32(0) != 0) return i32(8)
    ready=13;clock=0x703
    if (esp32C5MspiTimingOwned(record,0,0,0,0,true) != 2 || writes != 0) return i32(9)
    // A coordinator may nest SPI1 extra-dummy state inside the flash0 lease.
    // The shared delay/clock snapshots must unwind to the outer lease first.
    val second=nativeBufferAt(memory+48,48)
    record.storeU32(0,0);second.storeU32(0,0);ready=13;clock=0x603;initialClock=0
    writes=0;failAt=0;commits=0;bad=false
    var i=0;while (i < 9) { regs.storeU32(i*4,initial(i));i=i+1 }
    target=0
    if (esp32C5MspiTimingOwned(record,0,3,2,1,true) != 1) return i32(10)
    target=1
    if (esp32C5MspiTimingOwned(second,1,3,2,6,true) != 1 ||
        second.loadU32(28) != 3*0x1249249 || second.loadU32(32) != 2*0x15555 || second.loadU32(44) != 1 ||
        (value(3)&31) != 27 || value(4) != initial(4) || value(5) != initial(5)) return i32(11)
    if (esp32C5MspiTimingCloseOwned(second,true) != 4 || (value(0)&31) != 7 ||
        (value(1)&0x7ffffff) != 3*0x1249249 || value(3) != initial(3)) return i32(12)
    target=0
    if (esp32C5MspiTimingCloseOwned(record,true) != 4 || bad || commits != 4) return i32(13)
    i=0;while (i < 9) { if (value(i) != initial(i)) return i32(14);i=i+1 }
    return i32(0)
}
