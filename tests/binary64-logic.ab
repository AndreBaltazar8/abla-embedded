import "../src/esp32/runtime/libgcc_muldf3_esp32.ab"
import "../src/esp32/runtime/libgcc_divdf3_esp32.ab"
import "../src/esp32/runtime/libgcc_floatsidf_esp32.ab"
import "../src/esp32/runtime/libgcc_truncdfsf2_esp32.ab"
import "../src/esp32/runtime/libgcc_divsf3_esp32.ab"

// Compare the integer binary64 implementation by representation. This test
// performs no host floating-point arithmetic, so it cannot accidentally call
// the very libgcc helpers being replaced.
fun main(): int {
    val one = u64(4607182418800017408)
    val two = u64(4611686018427387904)
    val three = u64(4613937818241073152)
    val negativeTwo = u64(13835058055282163712)
    val negativeSix = u64(13841813454723219456)
    val positiveInfinity = u64(9218868437227405312)
    val minimumNormal = u64(4503599627370496)
    val minimumSubnormal = u64(1)

    if (esp32Binary64Multiply(one, one) != one) return 1
    if (esp32Binary64Multiply(u64(4609434218613702656), two) !=
        three) return 2
    if (esp32Binary64Multiply(negativeTwo, three) != negativeSix) return 3
    if (esp32Binary64Multiply(minimumNormal, u64(4602678819172646912)) !=
        u64(2251799813685248)) return 4
    if (esp32Binary64Multiply(minimumSubnormal, one) !=
        minimumSubnormal) return 5
    if (esp32Binary64Multiply(u64(4607182418800017409),
        u64(4607182418800017409)) != u64(4607182418800017410)) return 6
    if (esp32Binary64Multiply(u64(9218868437227405311), two) !=
        positiveInfinity) return 7
    if (esp32Binary64Multiply(positiveInfinity, u64(0)) !=
        esp32Binary64QuietNan) return 8

    if (esp32Binary64Divide(one, one) != one) return 9
    if (esp32Binary64Divide(three, two) !=
        u64(4609434218613702656)) return 10
    if (esp32Binary64Divide(negativeSix, two) !=
        u64(13837309855095848960)) return 11
    if (esp32Binary64Divide(one, three) !=
        u64(4599676419421066581)) return 12
    if (esp32Binary64Divide(minimumNormal, two) !=
        u64(2251799813685248)) return 13
    if (esp32Binary64Divide(minimumSubnormal, one) !=
        minimumSubnormal) return 14
    if (esp32Binary64Divide(one, u64(0)) != positiveInfinity) return 15
    if (esp32Binary64Divide(u64(0), three) != u64(0)) return 16
    if (esp32Binary64Divide(u64(0), u64(0)) !=
        esp32Binary64QuietNan) return 17
    // Channel-1 PLL input: (2412 MHz << 10) << 2. Its low double
    // word is zero; dropping the high word turns the frequency into zero.
    val frequency = esp32Unsigned32ToBinary64(u32(9879552))
    if (frequency != u64(4711565654694559744)) return 18
    if (esp32Binary64Divide(frequency, three) !=
        u64(4704326470137282560)) return 19
    if (esp32Signed32ToBinary64(i32(-9879552)) !=
        u64(13934937691549335552)) return 20
    val pllIntermediate = esp32Binary64BitsToBinary32(
        esp32Binary64Divide(frequency, three)
    )
    if (pllIntermediate != u32(0x4a490000)) return 21
    if (esp32Binary32Divide(pllIntermediate, u32(0x47200000)) !=
        u32(0x42a0cccd)) return 22
    return 0
}
