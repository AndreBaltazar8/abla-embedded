import "../src/storage/fat_cluster_ownership.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_cluster_ownership_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(536)
    val all=nativeBufferAt(storage,536)
    val tracker=fatClusterOwnershipAt(nativeBufferAt(storage+4,528))
    var count=1
    while (count <= 4096) {
        all.storeU32(0,0x12345678);all.storeU32(532,0x87654321)
        if (!tracker.initialize(count) || !tracker.valid()) return i32(1)
        var cluster=count+1
        while (cluster >= 2) {
            if (tracker.lookup(cluster) != 0 || tracker.claim(cluster) != 1 || tracker.lookup(cluster) != 1) return i32(2)
            cluster=cluster-1
        }
        if (tracker.claim(count+1) != 3 || tracker.claim(2) != 3 || tracker.storage().loadU32(12) != count+1 || tracker.storage().loadU32(8) != count) return i32(3)
        if (tracker.claim(1) != 2 || tracker.claim(count+2) != 2 || tracker.lookup(count+2) != 2 || tracker.lookup(-1) != 2) return i32(4)
        if (all.loadU32(0) != 0x12345678 || all.loadU32(532) != 0x87654321) return i32(5)
        count=count+1
    }
    if (tracker.initialize(4097) || tracker.initialize(0) || fatClusterOwnershipBytes(0x0fffffff) != 0) return i32(6)
    return i32(0)
}
