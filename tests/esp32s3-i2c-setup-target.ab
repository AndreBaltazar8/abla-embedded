import "../src/esp32/i2c/setup_esp32s3.ab"
import "abla/runtime/scalar"

// Compile only: exercising reset requires exclusive peripheral/RCC ownership.
@export("abla_s3_i2c_setup_test")
trusted fun i2cSetupTargetTest(port: i32, sda: i32, scl: i32): bool =
    esp32S3I2cResetClockedControllerLocked(int(port)) &&
        esp32S3I2cSetupMaster(int(port), int(sda), int(scl), u32(40000000), u32(100000))
