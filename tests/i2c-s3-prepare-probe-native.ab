import "../src/esp32/i2c/prepare_probe_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(40)
var calls=0
var outcome=1
var port=0
var steal=false
var bad=false
trusted fun s3PrepareProbeRecover(state: int,selected: int,owner: u32): int {
    calls=calls+1
    if (state != storage || selected != port || owner != u32(7) ||
        atomicU32At(state).compareExchange(u32(0),u32(0)) != u32(0x80000007)) bad=true
    if (steal) nativeAddressStoreU32(storage,0,0x80000009)
    outcome
}
@export("abla_i2c_s3_prepare_probe_test")
trusted fun probeTest(): i32 {
    var profile=0
    while (profile < 1056) {
        val cause=profile%12
        val faulted=profile/12%2 == 1
        outcome=profile/24%11+1
        val stale=profile/264%2 == 1
        port=profile/528
        nativeAddressStoreU32(storage,0,if (faulted) 0x80000000 else 0)
        nativeAddressStoreU32(storage,4,2); nativeAddressStoreU32(storage,8,1)
        nativeAddressStoreU32(storage,32,cause); nativeAddressStoreU32(storage,36,123)
        calls=0; bad=false
        val recovery=faulted && cause == 3 && !stale
        val expected=if (stale) 7 else if (!faulted) 1 else if (recovery) outcome else 10
        val key=esp32S3I2cBusKey(port,if (stale) 1 else 2)
        if (esp32S3I2cPrepareProbeOwned(storage,key,u32(7)) != expected || calls != (if (recovery) 1 else 0) || bad ||
            nativeAddressLoadU32(storage,32) != (if (recovery) outcome else cause) || nativeAddressLoadU32(storage,36) != 123) return i32(1)
        val healthy= !faulted || (recovery && outcome == 1)
        if (atomicU32At(storage).compareExchange(u32(0),u32(0)) != (if (healthy) u32(0) else u32(0x80000000))) return i32(2)
        profile=profile+1
    }
    calls=0
    val key=esp32S3I2cBusKey(1,2)
    nativeAddressStoreU32(storage,0,9)
    if (esp32S3I2cPrepareProbeOwned(storage,key,u32(7)) != 9 || calls != 0) return i32(3)
    nativeAddressStoreU32(storage,0,0x80000000); nativeAddressStoreU32(storage,32,3)
    if (esp32S3I2cPrepareProbeOwned(storage+1,key,u32(7)) != 7 ||
        esp32S3I2cPrepareProbeOwned(storage,0,u32(7)) != 7 || calls != 0) return i32(4)
    steal=true; outcome=1
    if (esp32S3I2cPrepareProbeOwned(storage,key,u32(7)) != 11 || calls != 1 || bad) return i32(5)
    i32(0)
}
