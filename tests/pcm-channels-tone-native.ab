import "../src/audio/pcm_channels_tone.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(2048)
@export("abla_pcm_channels_tone_test")
trusted fun test(): i32 {
    val bank=pcmChannelsAt(nativeBufferAt(memory,64),2,8000)
    val toneStorage=nativeBufferAt(memory+64,32)
    val source=nativeBufferAt(memory+96,2);source.storeU16(0,30000)
    val wav=pcmRaw(source,nativeBufferAt(memory+100,20),8000,1,16)
    val acc=nativeBufferAt(memory+128,512);val scratch=nativeBufferAt(memory+640,256)
    val output=nativeBufferAt(memory+896,256)
    val tone=pcmToneAt(toneStorage,8000,500000,4294967295)
    if (bank.enqueue(wav,0,0) != 0 || bank.enqueue(wav,0,1) != 1 ||
        !bank.renderWithTone(tone,16,acc,scratch,output,true,8192)) return i32(1)
    var at=0
    while (at < 16) {
        val sample=(nativeBufferAt(pcmToneWave,16).load(at)-128)*256
        val expected=pcm16AttenuatedSample(60000+sample,8192)
        if (output.loadU16(at*4) != expected || output.loadU16(at*4+2) != expected ||
            acc.loadU32(at*8) != 60000+sample) return i32(2)
        at=at+1
    }
    // All validation precedes advancement/clearing, including a later channel.
    acc.storeU32(0,123);scratch.storeU32(0,456);output.storeU32(0,789)
    val phase=toneStorage.loadU32(12)
    if (bank.renderWithTone(tone,1,acc,scratch,toneStorage) ||
        bank.renderWithTone(tone,1,acc,acc,output) ||
        bank.renderWithTone(tone,1,acc,scratch,source) ||
        bank.renderWithTone(tone,1,acc,scratch,output,true,32769) ||
        acc.loadU32(0) != 123 || scratch.loadU32(0) != 456 || output.loadU32(0) != 789 ||
        toneStorage.loadU32(12) != phase) return i32(3)
    toneStorage.storeU32(4,16000)
    if (bank.renderWithTone(tone,1,acc,scratch,output) || acc.loadU32(0) != 123) return i32(4)
    toneStorage.storeU32(4,8000)
    bank.channel(1).storage().storeU32(28,0)
    if (bank.renderWithTone(tone,1,acc,scratch,output) || acc.loadU32(0) != 123) return i32(5)
    bank.channel(1).storage().storeU32(28,0x50434d43)
    if (!tone.stop() || !bank.renderWithTone(tone,1,acc,scratch,output,false,32768) ||
        output.loadU16(0) != 32767) return i32(6)
    if (!bank.stop() || !bank.renderWithTone(tone,1,acc,scratch,output,false) || output.loadU16(0) != 0) return i32(7)
    return i32(0)
}
