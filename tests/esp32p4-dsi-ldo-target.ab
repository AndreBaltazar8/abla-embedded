import "../src/esp32/ldo_p4_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_ldo_target")
fun target(channel: int,millivolts: int,calibrated: bool,k: int,vos: int,c: int,dref: int,mul: int): Esp32P4LdoVoltage =
    esp32P4LdoSelectVoltage(channel,millivolts,calibrated,k,vos,c,dref,mul)
