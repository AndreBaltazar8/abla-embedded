import "../src/spi/software_shared_checked.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 0 && this < 30
fun Pin.outputCapable(): bool = this.valid()
val memory=nativeStaticAllocate(16)
var setupFail=false
var cleanupFail=false
var csFail=false
var output=false
var csHigh=true
var setups=0
var cleanups=0
var edges=0
var bad=false
fun Pin.read(): bool { bad=true;return false }
fun Pin.write(high: bool): void {
    if (this == 3) csHigh=high
    if (this == 0) { edges=edges+1;if (!output) bad=true }
    return
}
fun Pin.writeLevelOwned(high: bool): bool { if (csFail) return false;this.write(high);return true }
fun Pin.outputLevelOwned(high: bool): bool {
    setups=setups+1;output=true
    if (this != 4 || high || !csHigh) bad=true
    return !setupFail
}
fun Pin.inputOwned(): bool {
    cleanups=cleanups+1
    if (this != 4 || !csHigh) bad=true
    if (cleanupFail) return false
    output=false;return true
}
fun peripheralDelayMicroseconds(us: int): void { if (us != 2) bad=true;return }
fun reset(): void {
    nativeAddressStoreU32(memory,0,0)
    setupFail=false;cleanupFail=false;csFail=false;output=false;csHigh=true
    setups=0;cleanups=0;edges=0;bad=false;return
}
fun command(gate: PeripheralGate): SpiTransactionResult =
    softwareSpiSharedCommandChecked(gate,u32(7),Pin(0),Pin(1),Pin(3),Pin(4),42,nativeBufferAt(memory+8,8),2,0,2)
@export("abla_spi_shared_checked_test")
trusted fun testShared(): i32 {
    val gate=peripheralGateAt(memory)
    var fault=0
    while (fault < 4) {
        reset();setupFail=(fault&1) != 0;cleanupFail=(fault&2) != 0
        val result=command(gate)
        if (result.status() != (if (fault == 0) 1 else 6) ||
            int(result.value()) != ((if (setupFail) 1 else 0)|(if (cleanupFail) 4 else 0)) ||
            setups != 1 || cleanups != 1 || !csHigh || output != cleanupFail || bad) return i32(1)
        if (edges != (if (setupFail) 0 else 49)) return i32(2)
        if (fault != 0) {
            val before=edges
            if (command(gate).status() != 4 || edges != before || setups != 1) return i32(3)
            if (softwareSpiSharedPinRecover(gate,u32(8),Pin(3),Pin(4),false)) return i32(4)
            cleanupFail=true
            if (softwareSpiSharedPinRecover(gate,u32(8),Pin(3),Pin(4),true)) return i32(5)
            cleanupFail=false;csFail=true
            val attempts=cleanups
            if (softwareSpiSharedPinRecover(gate,u32(8),Pin(3),Pin(4),true) || cleanups != attempts) return i32(6)
            csFail=false
            if (!softwareSpiSharedPinRecover(gate,u32(8),Pin(3),Pin(4),true) || output || edges != before || bad) return i32(7)
            setupFail=false
            if (!command(gate).valid()) return i32(8)
        }
        fault=fault+1
    }
    reset()
    if (gate.tryBegin(u32(9)) != 0 || command(gate).status() != 2 || setups != 0 || !gate.finish(u32(9),true)) return i32(9)
    val invalid=softwareSpiSharedCommandChecked(gate,u32(7),Pin(0),Pin(1),Pin(3),Pin(4),42,nativeBufferAt(memory,8),2,0,2)
    if (invalid.status() != 3 || setups != 0 || edges != 0) return i32(10)
    return i32(0)
}
