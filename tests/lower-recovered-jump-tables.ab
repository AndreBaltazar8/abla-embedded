// Regression cases for the lower-recovered-jump-tables pass: each expectation is what the original Python tool
// produced for the same fixture (see the commit message of the port).
import "abla/io"
import "abla/test"
import "abla/text"
import "../tools/lower-recovered-jump-tables.ab"


fun jtSitesText(sites: JtSites): string {
    val parts: array<string> = []
    var k = 0
    while (k < sites.jumps.size) {
        parts.append("${sites.jumps[k]},${sites.offsets[k]},${sites.selectors[k]},${sites.shifts[k]}")
        k += 1
    }
    parts.join(";")
}

fun main: int {
    expectEqual(jtShellSplit("steam-run 'a b' \"c d\" e\\ f").join("|"), "steam-run|a b|c d|e f", "shell split")
    expectEqual(jtSitesText(jtTableSites("trusted fun f(): u32 {\n    r8 = (TBL + u32(8))\n    r8 = r8 + u32(4)\n    r9 = (r5 << u32(2)) + r8\n    r4 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r9))))\n    r7 = u32(1)\n    return u32(ablaUnsafeCallI32(int(r4), 1))\n}\n", "TBL")), "6,12,r5,3", "jump sites")
    if (testsPassed() != 0) return 1
    println("PASS: lower-recovered-jump-tables matches the original Python tool on the fixtures")
    0
}
