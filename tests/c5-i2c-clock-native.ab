import "../src/esp32/i2c/clock_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var bad=false
var source=0
var disable=false
var mismatch=0
var conf=0
var sclk=0
var writes=0
fun c5I2cClockLoad(address: int): int {
    calls=calls+1
    val writeCount=if (disable) 2 else 4
    val verifying=writes == writeCount
    val isConf=if (verifying) calls == writeCount*2+1 else writes == 1 || (!disable && writes == 2)
    if (address != (if (isConf) 0x60096020 else 0x60096024) ||
        (!verifying && (calls&1) != 1)) bad=true
    val value=if (isConf) conf else sclk
    if (verifying && (mismatch&(if (isConf) 1 else 2)) != 0) value^(if (isConf) 1 else 1<<22) else value
}
fun c5I2cClockStore(address: int,value: int): void {
    calls=calls+1
    val isConf=writes == 1 || (!disable && writes == 2)
    if ((calls&1) != 0 || address != (if (isConf) 0x60096020 else 0x60096024)) bad=true
    val expected=if (writes == 0) sclk&~(1<<22) else if (disable) conf&~1 else if (writes == 1) conf|3 else if (writes == 2) conf&~2 else (sclk&~0x500000)|(source<<20)|(1<<22)
    if (value != expected) bad=true
    if (isConf) conf=value else sclk=value
    writes=writes+1
    return
}
@export("abla_c5_i2c_clock_test")
trusted fun clockTest(): i32 {
    var profile=0
    while (profile < 4096) {
        val seed=profile&255
        conf=seed*0x01010101; sclk=conf
        source=(profile/256)&1; disable=((profile/512)&1) != 0
        mismatch=profile/1024
        calls=0; writes=0; bad=false
        val result=if (disable) esp32C5I2cDisableClockOwned(0) else esp32C5I2cResetClockOwned(0,source)
        val count=if (disable) 2 else 4
        if (result != (mismatch == 0) || writes != count ||
            calls != count*2+(if ((mismatch&1) != 0) 1 else 2) || bad) return i32(1)
        profile=profile+1
    }
    calls=0
    if (esp32C5I2cDisableClockOwned(1) || esp32C5I2cResetClockOwned(-1,0) ||
        esp32C5I2cResetClockOwned(0,-1) || esp32C5I2cResetClockOwned(0,2) || calls != 0) return i32(2)
    i32(0)
}
