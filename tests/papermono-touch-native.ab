import "../src/m5stack/papermono_touch_sequence.ab"
import "../src/m5stack/papermono_touch_tracker_sequence.ab"
import "../src/runtime/memory32.ab"
import "../src/m5stack/papermono_touch_logic.ab"
import "../src/touch/ft5x06_device.ab"
import "../src/touch/ft5x06_power_sequence.ab"
import "../src/m5stack/ft5x06_power_s3_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
type I2cBus=int
type I2cDevice=int
val storage=nativeStaticAllocate(29)
val trackerStorage=nativeStaticAllocate(184)
val savedTracker=nativeStaticAllocate(184)
val frameStorage=nativeStaticAllocate(40)
var bus=8589934590
var calls=0
var fail=0
var bad=false
var closeFail=false
var allocFail=false
var irqFail=false
var contacts=0
var malformed=false
var unstable=false
var fullReads=0
var identity=true
var duplicateId=false
var powerMode=false
var monitor=false
var pinCalls=0
var pinFailure=0
var pulseUs=0
fun ft5x06PowerPinValid(interrupt: int): bool = interrupt == 4
fun ft5x06PowerInputOwned(interrupt: int,pull: int): bool {
    pinCalls=pinCalls+1
    if (interrupt != 4 || pull != (if (pinCalls == 1) 1 else 0) || pinCalls > 2) bad=true
    return pinCalls != pinFailure
}
fun ft5x06PowerDelayMicroseconds(us: int): void { if (pinCalls != 1 || us != 512) bad=true;pulseUs=pulseUs+us;return }
trusted fun ft5x06PowerSleep(handle: int): bool = Ft5x06(handle).sleep()
trusted fun ft5x06PowerMonitor(handle: int): bool = Ft5x06(handle).monitorMode()
fun paperMonoTouchTrackerStorageAdmission(control: int,tracker: TouchTracker,frame: NativeBuffer): bool = control == 7
trusted fun sameTracker(): bool {
    var i=0
    while (i < 184) {
        if (nativeBufferAt(trackerStorage,184).load(i) != nativeBufferAt(savedTracker,184).load(i)) return false
        i=i+1
    }
    return true
}
fun paperMonoTouchAdmission(control: int): bool = control == 7
fun paperMonoTouchPrepareIrq(): bool = !irqFail
fun paperMonoTouchBus(control: int): int = bus
fun paperMonoTouchReadAdmission(control: int,handle: int,snapshot: NativeBuffer): bool = control == 7 && handle == 17 && snapshot.hasAddressRange(0,29)
trusted fun paperMonoTouchReadStable(handle: int,snapshot: NativeBuffer): int = Ft5x06(handle).readStable(snapshot)
fun I2cBus.valid(): bool = this == bus
fun I2cBus.device(address: int,hz: int): int {
    if (this != bus || address != 56 || hz != 400000) bad=true
    return if (allocFail) 0 else 17
}
fun I2cDevice.close(): bool { if (this != 17) bad=true;return !closeFail }
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    if (powerMode) {
        if (this != 17 || register != 165 || value != (if (monitor) 1 else 3) || (monitor && pinCalls != 2)) bad=true
        return calls != fail
    }
    if (this != 17 || value != 0 || register != (if (calls == 1) 0 else 164)) bad=true
    return calls != fail
}
trusted fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool {
    calls=calls+1
    if (this != 17) bad=true
    if (calls == fail) return false
    if (register == 163) {
        if (bytes != 6) bad=true
        var i=0
        while (i < 6) { data.store(i,if (identity) 1 else 0);i=i+1 }
        return true
    }
    if (register != 2 || (bytes != 1 && bytes != ft5x06SnapshotBytes(contacts))) bad=true
    data.store(0,contacts)
    if (bytes > 1) {
        fullReads=fullReads+1
        var i=0
        while (i < contacts) {
            val offset=1+i*6
            val x=if (malformed) 480 else if (unstable) fullReads else 479-i
            val y=799-i
            data.store(offset,x>>8);data.store(offset+1,x&255)
            data.store(offset+2,((if (duplicateId) 0 else i)<<4)|(y>>8));data.store(offset+3,y&255)
            if (offset+4 < bytes) data.store(offset+4,0)
            if (offset+5 < bytes) data.store(offset+5,0)
            i=i+1
        }
    }
    return true
}
trusted fun touchControllerAllocate(key: int,kind: int,address: int,hz: int): int {
    if (kind != 1) bad=true;return ft5x06(I2cBus(key),address,hz)|0
}
trusted fun touchControllerBegin(kind: int,handle: int): bool = Ft5x06(handle).begin()
trusted fun touchControllerRelease(kind: int,handle: int): bool = Ft5x06(handle).close()
@export("abla_papermono_touch_test")
trusted fun test(): i32 {
    var boardNumber=0
    while (boardNumber < 256) {
        val board=M5BoardId(boardNumber)
        val profile=board.touchProfile()
        val supported=board == m5BoardStackCoreS3 || board == m5BoardStackCoreS3SE ||
            board == m5BoardDial || board == m5BoardPaperMono
        val busKey=esp32S3I2cBusKey(profile.port(),2147483647)
        val descriptor=esp32S3I2cDeviceKey(profile.port(),56,400000,2147483647)
        if (board.ft5x06S3PowerMatches(busKey,descriptor,1,2147483647,profile.sdaNumber(),profile.sclNumber()) != supported) return i32(26)
        if (board.ft5x06S3PowerMatches(busKey,descriptor,0,2147483647,profile.sdaNumber(),profile.sclNumber()) ||
            board.ft5x06S3PowerMatches(busKey,descriptor,1,2147483646,profile.sdaNumber(),profile.sclNumber()) ||
            board.ft5x06S3PowerMatches(busKey,descriptor,1,2147483647,profile.sclNumber(),profile.sdaNumber()) ||
            board.ft5x06S3PowerMatches(busKey,0,1,2147483647,profile.sdaNumber(),profile.sclNumber()) ||
            board.ft5x06S3PowerMatches(busKey,esp32S3I2cDeviceKey(profile.port(),57,400000,2147483647),1,2147483647,profile.sdaNumber(),profile.sclNumber()) ||
            board.ft5x06S3PowerMatches(busKey,esp32S3I2cDeviceKey(profile.port(),56,100000,2147483647),1,2147483647,profile.sdaNumber(),profile.sclNumber())) return i32(27)
        boardNumber=boardNumber+1
    }
    val snapshot=nativeBufferAt(storage,29)
    var variant=0
    while (variant < 16) {
        bus=if ((variant&8) == 0) 4294967293 else 8589934590
        fail=variant&3;closeFail=(variant&4) != 0;calls=0;bad=false
        val opened=paperMonoTouchOpenOwned(7,true)
        val status=if (fail == 0) 1 else if (closeFail) 4 else 3
        if (opened.status() != status || opened.handle() != (if (status == 1 || status == 4) 17 else 0) || bad) return i32(1)
        closeFail=false
        if (opened.closeOwned().handle() != 0) return i32(2)
        variant=variant+1
    }
    fail=0;calls=0;bad=false
    val owned=paperMonoTouchOpenOwned(7,true)
    contacts=0
    while (contacts <= 5) {
        calls=0;fullReads=0
        if (paperMonoTouchReadOwned(7,owned,snapshot,true) != contacts || bad || calls != (if (contacts == 0) 2 else 4)) return i32(3)
        contacts=contacts+1
    }
    contacts=1;malformed=true;calls=0
    if (paperMonoTouchReadOwned(7,owned,snapshot,true) != -4) return i32(4)
    malformed=false;unstable=true;calls=0;fullReads=0
    if (paperMonoTouchReadOwned(7,owned,snapshot,true) != -2 || calls != 12) return i32(5)
    unstable=false;fail=1;calls=0
    if (paperMonoTouchReadOwned(7,owned,snapshot,true) != -1) return i32(6)
    calls=0
    if (paperMonoTouchReadOwned(0,owned,snapshot,true) != -3 || paperMonoTouchOpenOwned(7,false) != 0 || calls != 0) return i32(7)
    // Exact rational endpoint geometry, all8 display rotations and metadata.
    var rotation=0
    while (rotation < 8) {
        val point=touchPoint(479,799,4,2,9).forPaperMonoDisplay(rotation)
        val internal=((rotation+3)&3)|(rotation&4)
        val width=if ((internal&1) == 0) 800 else 480
        val height=if ((internal&1) == 0) 480 else 800
        val expectedX=if (rotation == 0 || rotation == 3 || rotation == 4 || rotation == 7) 0 else width-1
        val expectedY=if (rotation == 2 || rotation == 3 || rotation == 4 || rotation == 5) 0 else height-1
        if (!point.valid() || point.x() != expectedX || point.y() != expectedY || point.id() != 4 || point.event() != 2 || point.size() != 9) return i32(8)
        rotation=rotation+1
    }
    if (touchPoint(480,799,0,0).forPaperMonoDisplay(0).valid() || touchPoint(0,800,0,0).forPaperMonoDisplay(0).valid()) return i32(9)
    fail=0;calls=0;identity=false
    if (paperMonoTouchOpenOwned(7,true).status() != 3 || calls != 3) return i32(10)
    identity=true;allocFail=true;calls=0
    if (paperMonoTouchOpenOwned(7,true).status() != 2 || calls != 0) return i32(11)
    allocFail=false;irqFail=true
    if (paperMonoTouchOpenOwned(7,true) != 0 || calls != 0) return i32(12)
    irqFail=false;contacts=6;calls=0
    if (paperMonoTouchReadOwned(7,owned,snapshot,true) != -1 || calls != 1) return i32(13)
    val tracker=touchTrackerAt(trackerStorage)
    val frame=nativeBufferAt(frameStorage,40)
    contacts=1;calls=0;bad=false
    if (tracker.updatePaperMonoOwned(7,owned,snapshot,frame,10,0,true) != 1 ||
        !tracker.detail(0).wasPressed() || tracker.detail(0).point().x() != 0 || tracker.detail(0).point().y() != 799) return i32(14)
    val before=calls
    if (tracker.updatePaperMonoOwned(7,owned,snapshot,frame,12,0,true) != 1 || calls != before) return i32(15)
    var i=0
    while (i < 184) { nativeBufferAt(savedTracker,184).store(i,nativeBufferAt(trackerStorage,184).load(i));i=i+1 }
    fail=1;calls=0
    if (tracker.updatePaperMonoOwned(7,owned,snapshot,frame,20,0,true) != -2 || !sameTracker()) return i32(16)
    fail=0;unstable=true;fullReads=0
    if (tracker.updatePaperMonoOwned(7,owned,snapshot,frame,20,0,true) != -3 || !sameTracker()) return i32(17)
    unstable=false;contacts=2;duplicateId=true
    if (tracker.updatePaperMonoOwned(7,owned,snapshot,frame,20,0,true) != -4 || !sameTracker()) return i32(18)
    duplicateId=false;contacts=1;malformed=true
    if (tracker.updatePaperMonoOwned(7,owned,snapshot,frame,20,0,true) != -4 || !sameTracker()) return i32(19)
    malformed=false;calls=0
    if (tracker.updatePaperMonoOwned(7,owned,nativeBufferAt(trackerStorage,29),frame,20,0,true) != -1 ||
        tracker.updatePaperMonoOwned(7,owned,snapshot,nativeBufferAt(storage,40),20,0,true) != -1 ||
        tracker.updatePaperMonoOwned(7,owned,snapshot,frame,20,8,true) != -1 || calls != 0 || !sameTracker()) return i32(20)
    contacts=0
    if (tracker.updatePaperMonoOwned(7,owned,snapshot,frame,20,0,true) != 1 || !tracker.detail(0).wasReleased() || bad) return i32(21)
    powerMode=true;monitor=false;fail=0;calls=0
    val asleep=owned.sleepFt5x06CheckedOwned(true)
    if (asleep.status() != 5 || asleep.handle() != 17 || calls != 1 || bad ||
        paperMonoTouchReadOwned(7,asleep,snapshot,true) != -3) return i32(22)
    calls=0;fail=1
    if (owned.sleepFt5x06CheckedOwned(true).status() != 6 || calls != 1) return i32(23)
    var failure=0
    monitor=true
    while (failure <= 3) {
        pinCalls=0;pinFailure=if (failure <= 2) failure else 0
        calls=0;fail=if (failure == 3) 1 else 0;pulseUs=0;bad=false
        val awake=asleep.wakeFt5x06CheckedOwned(4,true)
        if (awake.status() != (if (failure == 0) 1 else 6) || awake.handle() != 17 ||
            pinCalls != 2 || pulseUs != (if (failure == 1) 0 else 512) ||
            calls != (if (failure == 1 || failure == 2) 0 else 1) || bad) return i32(24)
        failure=failure+1
    }
    pinCalls=0;calls=0
    if (asleep.wakeFt5x06CheckedOwned(5,true) != asleep || asleep.wakeFt5x06CheckedOwned(4,false) != asleep ||
        owned.wakeFt5x06CheckedOwned(4,true) != owned || pinCalls != 0 || calls != 0) return i32(25)
    return i32(0)
}
