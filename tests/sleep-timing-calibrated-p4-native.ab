import "../src/esp32/power/sleep_timing_logic_p4.ab"
import "abla/unsafe/native"
@export("abla_sleep_timing_calibrated_p4_test")
trusted fun test(): i32 {
    val output=nativeBufferAt(nativeStaticAllocate(44),44)
    var top=0
    while (top < 2) {
        var xtal=0
        while (xtal < 2) {
            var slow=1048576
            while (slow <= 32000000) {
                var fast=32768
                while (fast <= 131072) {
                    var i=0
                    while (i < 44) { output.storeU32(i,0xdeadbeef);i=i+4 }
                    val ok=esp32p4SleepTimingCalibrated(output,slow,fast,top == 1,xtal == 1)
                    var valid=true
                    i=0
                    while (i < 10) {
                        // Independent short-input oracle: direct scaled integer divide.
                        val us=if (i < 2) 450 else if (i == 2) (if (top == 1) 260 else 945) else if (i == 3) 154 else
                            if (i == 5) 26 else if (i < 8) 2 else if (i == 8) 250 else 50
                        val period=if (i < 4 || (i == 8 && xtal == 1)) slow else fast
                        val expected=(us*524288)/period
                        val limit=if (i == 2 || i >= 8) 65535 else if (i >= 4) 511 else 255
                        if (expected > limit) valid=false
                        if (ok && output.loadU32(i*4) != expected) return i32(1)
                        i=i+1
                    }
                    if (ok != valid || output.loadU32(40) != 0xdeadbeef) return i32(2)
                    if (!ok) {
                        i=0
                        while (i < 40) { if (output.loadU32(i) != 0xdeadbeef) return i32(3);i=i+4 }
                    }
                    fast=fast+8192
                }
                slow=slow+524288
            }
            xtal=xtal+1
        }
        top=top+1
    }
    if (esp32p4SleepTimingCalibrated(output,0,65536,true,true) ||
        esp32p4SleepTimingCalibrated(output,16000000,0x100000000,true,true) ||
        esp32p4SleepTimingCalibrated(nativeBufferAt(output.addressValue(),39),16000000,65536,true,true)) return i32(4)
    return i32(0)
}
