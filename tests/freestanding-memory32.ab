import "../src/runtime/memory32.ab"

trusted fun main(): int {
    val address = nativeStackAllocate(32)
    freestandingMemorySetBytes(address, i32(170), u32(32))
    if (freestandingMemorySetBytes(address + 3, i32(511), u32(19)) != address + 3) return 1
    freestandingMemorySetBytes(address, i32(0), u32(0))
    var index = 0
    while (index < 32) {
        val expected = if (index >= 3 && index < 22) 255 else 170
        if (ablaUnsafeLoadU8(nativePointerFromAddress(address + index)) != expected) return 2
        index = index + 1
    }
    0
}
