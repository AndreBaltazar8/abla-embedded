import "../src/esp32/uart/config_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var expectedUnit=0
var clock=0
var bus=5
var divider=0
var framing=0
var pending=0
var failure=0
var busy=0
var writes=0
var bad=false
fun c5SerialBusRead(unit: int): int { if (unit != expectedUnit) bad=true;return bus }
fun c5SerialClockRead(unit: int): int { if (unit != expectedUnit) bad=true;return clock }
fun c5SerialClockWrite(unit: int,value: int): void {
    writes=writes+1
    if (unit != expectedUnit || writes != 2) bad=true
    if (failure != 2) clock=value
    return
}
fun c5SerialRead(unit: int,offset: int): int {
    if (unit != expectedUnit) bad=true
    if (offset == 20) return divider
    if (offset == 32) return framing
    if (offset == 152) {
        if (busy == 1) return 1
        if (pending > 0) { if (failure != 4) pending=pending-1;return 1 }
        return 0
    }
    if (offset == 12) return if (busy == 2) 1 else 0
    if (offset == 28) return if (busy == 3) 1 else if (busy == 4) 65536 else 0
    if (offset == 112) return if (busy == 5) 1 else if (busy == 6) 16 else 0
    bad=true;return 0
}
fun c5SerialConfigWrite(unit: int,offset: int,value: int): void {
    writes=writes+1
    if (unit != expectedUnit) bad=true
    if (offset == 20 && writes == 1) { if (failure != 1) divider=value;return }
    if (offset == 32 && writes == 3) { if (failure != 3) framing=value;return }
    if (offset == 152 && writes == 4 && value == 1) { pending=1;return }
    bad=true;return
}
fun c5SerialWriteFifo(unit: int,value: int): void { bad=true;return }
@export("abla_serial_config_c5_test")
trusted fun testConfig(): int {
    var unit=0
    while (unit < 2) {
        expectedUnit=unit
        var format=0
        while (format < 36) {
            val bits=5+format%4;val parity=(format/4)%3;val stop=1+format/12
            val expectedFormat=((bits-5)<<2)|(stop<<4)|(if (parity == 1) 3 else if (parity == 2) 2 else 0)
            var fault=0
            while (fault < 5) {
                failure=fault;clock=0xa0601000;divider=0xff0ff000;framing=0x80100000|((expectedFormat+1)&63)
                pending=0;writes=0
                val result=serial(unit).configureOwned(80000000,115200,bits,parity,stop,3)
                if (result != (if (fault == 0) 1 else if (fault == 4) 5 else 4) ||
                    writes != (if (fault == 0 || fault == 4) 4 else fault) || bad) return 1
                if (fault == 0 && (divider != (0xff0ff000|694|(7<<20)) ||
                    clock != 0xa0600000 || framing != (0x80100000|expectedFormat))) return 2
                fault=fault+1
            }
            format=format+1
        }
        failure=0
        var guard=0
        while (guard < 12) {
            clock=0x600000;bus=5;busy=0;pending=0;writes=0
            if (guard < 6) busy=guard+1
            else if (guard == 6) bus=4
            else if (guard == 7) bus=7
            else if (guard == 8) clock=0x200000
            else if (guard == 9) clock=0x700000
            else if (guard == 10) clock=0x600001
            else clock=0x600040
            if (serial(unit).configureOwned(80000000,115200,8,0,1,3) != 3 || writes != 0) return 3
            guard=guard+1
        }
        busy=0;bus=5;clock=0x600000
        unit=unit+1
    }
    // Independent wide-integer baud oracle, covering small bauds/prescalers.
    var baud=1
    while (baud < 1000000) {
        val pre=(80000000+4095*baud-1)/(4095*baud)
        val plan=c5SerialBaudPlan(80000000,baud)
        if (pre > 256) { if (plan != 0) return 4 }
        else {
            val div=1280000000/(baud*pre)
            if (plan != ((1<<32)|((pre-1)<<24)|(div/16)|((div%16)<<20))) return 5
        }
        baud=baud+137
    }
    if (serial(2).configureOwned(80000000,115200,8,0,1,3) != 2 ||
        c5SerialBaudPlan(0,1) != 0 || c5SerialBaudPlan(80000000,0) != 0 || bad) return 6
    return 0
}
