import "../src/esp32/dsi_fifo_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_fifo_target")
trusted fun target(operation: int,value: int,polls: int): int =
    if (operation == 0) esp32P4DsiSubmitHeader(value,polls) else if (operation == 1) esp32P4DsiWritePayload(u32(value),polls) else
    if (operation == 2) esp32P4DsiReadPayload(polls) else (if (esp32P4DsiWaitIdle(polls)) 1 else 0)
