import "../src/esp32/power/sleep_uart_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var port=0
var mode=0
var flow=0
var writes=0
var reads=0
var observations=0
var readyAt=0
var state=0
var deep=false
var bad=false
fun esp32S3SleepUartRead(address: int): int {
    reads=reads+1
    val bit=1<<(if (port == 0) 2 else if (port == 1) 5 else 9)
    val base=esp32S3SleepUartBase(port)
    if (address == 0x600C0020) return if (mode == 1) bit else ~bit & 0xFFFFFFFF
    if (address == 0x600C0018) return if (mode == 2) ~bit & 0xFFFFFFFF else bit
    if (address == base+0x34) return flow
    if (address == base+0x1C && deep) return if (observations >= readyAt) 0 else 1<<16
    if (address == base+0x6C) {
        val result=if (observations >= readyAt) state else 1
        observations=observations+1
        return result<<4
    }
    bad=true
    0
}
fun esp32S3SleepUartUpdate(address: int,mask: int,value: int): void {
    if (deep || address != esp32S3SleepUartBase(port)+0x34) bad=true
    val expectedMask=if (writes == 0) 4 else if (writes == 1) 9 else if (writes == 2) 8 else if (writes == 3) 4 else 5
    val expectedValue=if (writes == 1) 9 else if (writes == 3) 4 else 0
    if (writes > 4 || mask != expectedMask || value != expectedValue) bad=true
    flow=(flow & ~mask) | value
    writes=writes+1
    return
}
@export("abla_sleep_uart_s3_test")
trusted fun sleepUartTest(): i32 {
    port=0
    while (port < 3) {
        var scenario=0
        while (scenario < 2) {
            deep=scenario == 1
            state=0
            while (state < 16) {
                readyAt=0
                while (readyAt <= 3) {
                    mode=0; flow=0xFFFFFFF2; writes=0; reads=0; observations=0; bad=false
                    val ready=(if (deep) state == 0 else state == 0 || state == 15) && readyAt < 3
                    val expected=if (ready) (if (deep) 2 else 3) else 4
                    val result=esp32S3SleepUartPrepareOwned(port,deep,3)
                    if (result != expected || bad || observations != (if (ready) readyAt+1 else 3) ||
                        writes != (if (deep) 0 else if (ready) 2 else 5)) return i32(1)
                    if (result == 3 && !esp32S3SleepUartResumeOwned(port)) return i32(2)
                    if (bad || flow != 0xFFFFFFF2) return i32(3)
                    readyAt=readyAt+1
                }
                state=state+1
            }
            scenario=scenario+1
        }
        mode=1
        while (mode <= 2) {
            writes=0; reads=0
            if (esp32S3SleepUartPrepareOwned(port,false,3) != 1 || writes != 0 || reads != mode) return i32(4)
            mode=mode+1
        }
        mode=0; deep=false
        var owned=1
        while (owned < 16) {
            if ((owned & 13) != 0) {
                flow=owned; writes=0
                if (esp32S3SleepUartPrepareOwned(port,false,3) != 5 || writes != 0 || flow != owned) return i32(5)
            }
            owned=owned+1
        }
        port=port+1
    }
    reads=0; writes=0
    if (esp32S3SleepUartPrepareOwned(-1,false,3) != 0 || esp32S3SleepUartPrepareOwned(3,false,3) != 0 ||
        esp32S3SleepUartPrepareOwned(0,false,0) != 0 || esp32S3SleepUartResumeOwned(3) || reads != 0 || writes != 0) return i32(6)
    i32(0)
}
