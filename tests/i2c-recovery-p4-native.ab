import "../src/esp32/i2c/recovery_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val registers=nativeStaticAllocate(128)
var tick=u32(0)
var response=0
var raw=128
var starts=0
var writes=0
var done=true
var bad=false
var selectedPort=0
var expectedAddress=42
var lines=true
var drop=0
trusted fun p4I2cRecoveryLinesHigh(sda: int,scl: int): bool = lines
trusted fun p4I2cCounter(): u32 { tick=tick+u32(1);return tick }
trusted fun p4I2cRead(address: int): u32 {
    if (address == 0x500e601c) return u32(0x3000)
    if (address == 0x500e6040) return u32(0x8000002)
    if (address == 0x500e60c4) return u32(0)
    val at=address-(0x500c4000+selectedPort*4096)
    if (at < 0 || at >= 128) { bad=true;return u32(0) }
    return u32(nativeBufferAt(registers,128).loadU32(at))
}
trusted fun p4I2cWrite(address: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    val at=address-(0x500c4000+selectedPort*4096)
    val r=nativeBufferAt(registers,128)
    if (at < 0 || at >= 128) { bad=true;return }
    if (at == 24 && (value&u32(0x3000)) != u32(0)) r.storeU32(8,r.loadU32(8)&(0xffffffff^((63<<8)|(63<<18))))
    if (at == 28) {
        if (value != u32(expectedAddress*2) || ((r.loadU32(8)>>18)&63) != 0) bad=true
        r.storeU32(8,r.loadU32(8)+(1<<18));return
    }
    if (at == 36) { r.storeU32(32,r.loadU32(32)&(0xffffffff^int(value)));return }
    if (at == 4) {
        r.storeU32(4,int(value)&0xfffff7df)
        if ((value&u32(32)) != u32(0)) {
            starts=starts+1
            if (r.loadU32(88) != 4096) bad=true
            r.storeU32(8,response);r.storeU32(32,raw)
            if (done) r.storeU32(88,0x80001000)
        }
        return
    }
    r.storeU32(at,int(value));return
}
trusted fun seed(): void {
    val r=nativeBufferAt(registers,128)
    var i=0
    while (i < 128) { r.storeU32(i,0);i=i+4 }
    r.storeU32(4,0x110);r.storeU32(24,0x4000)
    tick=u32(0);response=0;raw=128;starts=0;writes=0;done=true;bad=false;lines=true;drop=0;return
}
@export("abla_i2c_recovery_p4_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(registers,128)
    selectedPort=0
    while (selectedPort < 2) {
        seed();r.storeU32(8,(4<<18)|(3<<8))
        if (esp32p4I2cRecoverOwned(selectedPort,31,32,u32(100),true) != 1 || starts != 0 || bad) return i32(1)
        val total=writes
        var fault=1
        while (fault <= total-2) {
            seed();drop=fault;r.storeU32(8,(4<<18)|(3<<8))
            if (esp32p4I2cRecoverOwned(selectedPort,31,32,u32(100),true) != 6 || starts != 0 || bad) return i32(2)
            drop=0
            if (esp32p4I2cRecoverOwned(selectedPort,31,32,u32(100),true) != 1 || bad) return i32(3)
            fault=fault+1
        }
        seed();lines=false
        if (esp32p4I2cRecoverOwned(selectedPort,31,32,u32(10),true) != 5 || writes != 0) return i32(4)
        seed();r.storeU32(8,16);r.storeU32(32,1024)
        if (esp32p4I2cRecoverOwned(selectedPort,31,32,u32(10),true) != 5 || writes != 0) return i32(5)
        var scenario=0
        while (scenario < 7) {
            seed();r.storeU32(8,16|(4<<18));r.storeU32(32,1024)
            if (scenario == 1) r.storeU32(32,1056)
            if (scenario == 2) r.storeU32(32,256)
            if (scenario == 3) raw=160
            if (scenario == 4) done=false
            if (scenario == 5) lines=false
            if (scenario == 6) raw=1152
            val result=esp32p4I2cRecoverOwned(selectedPort,31,32,u32(20),true,true)
            val expected=if (scenario == 0) 1 else if (scenario == 1 || scenario == 3) 4 else if (scenario == 2) 7 else if (scenario == 6) 3 else 5
            if (result != expected || starts != (if (scenario == 1 || scenario == 2) 0 else 1) || bad) return i32(6)
            scenario=scenario+1
        }
        seed();tick=u32(0xfffffffe)
        if (esp32p4I2cRecoverOwned(selectedPort,31,32,u32(100),true) != 1 || bad) return i32(7)
        seed()
        if (esp32p4I2cRecoverOwned(selectedPort,31,31,u32(100),true) != 7 || writes != 0) return i32(8)
        selectedPort=selectedPort+1
    }
    return i32(0)
}
