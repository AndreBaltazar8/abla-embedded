import "./pm1-control-wire-native.ab"
import "../src/m5stack/pm1_imu_owner_sequence.ab"
import "../src/m5stack/imu_owner_prepared.ab"
import "../src/m5stack/imu_owner_update.ab"
val retainedImuParent=nativeStaticAllocate(76)
val retainedImuMemory=nativeStaticAllocate(100)
var pm1ImuWaits=0
fun imuDelay(ticks: int): void { if (ticks != 10 || mode != 0) bad=true;pm1ImuWaits=pm1ImuWaits+1;return }
fun pm1ImuParentStorageSafe(storage: NativeBuffer): bool = softwareI2cProviderBufferSafe(storage,76)
trusted fun pm1BoardImuAdmission(control: int,imu: M5ImuOwner): bool =
    M5Pm1Control(control).ready() && softwareI2cProviderBufferSafe(imu.buffer(),36) &&
    imu.status() == 0 && imu.primary().handle() == 0 && imu.magnetometers().status() == 0 &&
    imu.magnetometers().handle(1) == 0 && imu.magnetometers().handle(2) == 0
trusted fun pm1BoardImuProbe(imu: M5ImuOwner,bus: int): int = imu.openPrepared(I2cBus(bus))
trusted fun pm1BoardImuClose(imu: M5ImuOwner): bool = imu.close()
@export("abla_pm1_imu_owner_wire_test")
trusted fun testRetainedImuWire(): i32 {
    val owner=m5Pm1ControlAt(nativeBufferAt(retainedImuParent,76))
    val imu=m5ImuOwnerAt(nativeBufferAt(retainedImuMemory,36))
    val snapshot=imuSnapshotAt(nativeBufferAt(retainedImuMemory+36,44))
    val scratch=nativeBufferAt(retainedImuMemory+80,20)
    val r=nativeBufferAt(pm1ImuRegisters,256)
    var boardIndex=0
    while (boardIndex < 3) {
        wireSeed()
        val board=if (boardIndex == 0) m5BoardChainCaptain else if (boardIndex == 1) m5BoardPaperMono else m5BoardStopWatch
        val bus=i2cSoftwareMaster(0,1,5,8)
        if (!owner.initialize() || !imu.initialize() || !snapshot.initialize() || owner.openOwned(bus|0,board,true,true) != 1) return i32(1)
        // Absent-device path performs real candidate allocation/close, not a stub.
        if (owner.openRetainedImuPreparedOwned(imu,true) != 2 || !owner.imuRetained() ||
            owner.closeOwned(true) || !owner.closeRetainedImuOwned(imu,true)) return i32(2)
        pm1ImuPresent=true
        var fault=0
        while (fault <= 75) {
            var commit=0
            while (commit < 2) {
                var at=0;while (at < 256) { r.store(at,0);at=at+1 }
                r.store(117,25);pm1ImuWaits=0;pm1ImuNackAfterCommit=commit == 1
                nackAt=if (fault == 0) 0 else ackCount+fault
                val result=owner.openRetainedImuPreparedOwned(imu,true)
                if (result != (if (fault == 0) 1 else 2) || !owner.imuRetained() || owner.closeOwned(true) || bad) return i32(3)
                nackAt=0
                if (fault == 0) {
                    if (imu.primary().kind() != m5ImuMpu6886 || imu.primary().address() != 104 || pm1ImuWaits != 2 ||
                        r.load(107) != 1 || r.load(28) != 16 || r.load(27) != 24 || r.load(26) != 1 || r.load(25) != 3 || r.load(55) != 192) return i32(4)
                    r.store(58,1)
                    // Big-endian acceleration + temperature + gyroscope burst.
                    r.store(59,0);r.store(60,100);r.store(61,255);r.store(62,56);r.store(63,1);r.store(64,44)
                    r.store(67,1);r.store(68,144);r.store(69,1);r.store(70,244);r.store(71,253);r.store(72,168)
                    imu.updateSnapshot(snapshot,scratch,12345)
                    if (!snapshot.has(0) || !snapshot.has(1) || snapshot.timestamp(0) != 12345 ||
                        snapshot.axes(0).axis(0) != 100 || snapshot.axes(0).axis(1) != -200 || snapshot.axes(1).axis(2) != -600) return i32(5)
                    if (!softwareI2cProviderEnter()) return i32(6)
                    val closed=owner.closeRetainedImuOwned(imu,true)
                    if (!softwareI2cProviderLeave() || closed || !owner.imuRetained() || imu.primary().handle() == 0) return i32(7)
                }
                if (!owner.closeRetainedImuOwned(imu,true) || owner.imuRetained() || imu.status() != 0 || !owner.ready() || bad) return i32(8)
                commit=commit+1
            }
            fault=fault+1
        }
        if (!owner.closeOwned(true) || !bus.close() || pads != 0 || bad) return i32(9)
        boardIndex=boardIndex+1
    }
    return i32(0)
}
