import "./dsi-p4-gpio-native.ab"
import "../src/esp32/gpio_pin_p4_sequence.ab"
import "../src/m5stack/c6_board_pins.ab"
import "../src/m5stack/tough_c5_pins.ab"
import "../src/m5stack/p4_board_pins.ab"
@export("abla_board_pins_cross_test")
trusted fun testBoardPins(): i32 {
    if (testGpio() != i32(0)) return i32(1)
    var number=-1
    while (number <= 55) {
        val p=pin(number);val valid=number >= 0 && number <= 54
        resetGpio()
        if (p.number() != number || p.valid() != valid || p.outputCapable() != valid || p.pullCapable() != valid) return i32(2)
        if (!valid) {
            if (p.readLevelOwned() != -1 || p.read() || p.writeLevelOwned(true) || p.inputOwned() || p.outputLevelOwned(false) || writes != 0) return i32(3)
        } else {
            val input=if (number < 32) 60 else 64
            nativeBufferAt(storage,4608).storeU32(input,0)
            if (p.readLevelOwned() != 0 || p.read()) return i32(4)
            nativeBufferAt(storage,4608).storeU32(input,int(u32(1)<<u32(number&31)))
            if (p.readLevelOwned() != 1 || !p.read()) return i32(5)
            if (!p.outputLevelOwned(false) || !p.writeLevelOwned(true) || !p.inputOwned()) return i32(6)
            var pull=0
            while (pull <= 2) { if (!p.inputPullOwned(pull)) return i32(7);pull=pull+1 }
            val before=writes
            if (p.inputPullOwned(3) || writes != before) return i32(8)
        }
        number=number+1
    }
    if (m5NessoN1().portA() != m5BoardArduinoNessoN1.portA()) return i32(9)
    if (m5NessoN1().portB() != m5BoardArduinoNessoN1.portB()) return i32(9)
    if (m5NessoN1().portC() != m5BoardArduinoNessoN1.portC()) return i32(9)
    if (m5NessoN1().internalI2cData().number() != m5BoardArduinoNessoN1.i2cPins().internalData() || m5NessoN1().internalI2cClock().number() != m5BoardArduinoNessoN1.i2cPins().internalClock()) return i32(12)
    if (m5NessoN1().externalI2cData().number() != m5BoardArduinoNessoN1.i2cPins().externalData() || m5NessoN1().externalI2cClock().number() != m5BoardArduinoNessoN1.i2cPins().externalClock()) return i32(13)
    if (m5UnitC6L().portB() != m5BoardUnitC6L.portB()) return i32(9)
    if (m5UnitC6L().portC() != m5BoardUnitC6L.portC()) return i32(9)
    if (m5UnitC6L().internalI2cData().number() != m5BoardUnitC6L.i2cPins().internalData() || m5UnitC6L().internalI2cClock().number() != m5BoardUnitC6L.i2cPins().internalClock()) return i32(12)
    if (m5ToughC5().portA() != m5BoardToughC5.portA()) return i32(9)
    if (m5ToughC5().portB() != m5BoardToughC5.portB()) return i32(9)
    if (m5ToughC5().portC() != m5BoardToughC5.portC()) return i32(9)
    if (m5ToughC5().sdPins() != m5BoardToughC5.sdPins() || !m5ToughC5().sdPins().available()) return i32(10)
    if (m5ToughC5().internalI2cData().number() != m5BoardToughC5.i2cPins().internalData() || m5ToughC5().internalI2cClock().number() != m5BoardToughC5.i2cPins().internalClock()) return i32(12)
    if (m5ToughC5().externalI2cData().number() != m5BoardToughC5.i2cPins().externalData() || m5ToughC5().externalI2cClock().number() != m5BoardToughC5.i2cPins().externalClock()) return i32(13)
    if (m5CoreP4X().portA() != m5BoardCoreP4X.portA()) return i32(9)
    if (m5CoreP4X().sdPins() != m5BoardCoreP4X.sdPins() || !m5CoreP4X().sdPins().available()) return i32(10)
    number=0
    while (number <= 31) { if (m5CoreP4X().mBusPin(number) != m5BoardCoreP4X.mBusPin(number)) return i32(11);number=number+1 }
    if (m5CoreP4X().internalI2cData().number() != m5BoardCoreP4X.i2cPins().internalData() || m5CoreP4X().internalI2cClock().number() != m5BoardCoreP4X.i2cPins().internalClock()) return i32(12)
    if (m5CoreP4X().externalI2cData().number() != m5BoardCoreP4X.i2cPins().externalData() || m5CoreP4X().externalI2cClock().number() != m5BoardCoreP4X.i2cPins().externalClock()) return i32(13)
    if (m5Tab5().portA() != m5BoardTab5.portA()) return i32(9)
    if (m5Tab5().portB() != m5BoardTab5.portB()) return i32(9)
    if (m5Tab5().portC() != m5BoardTab5.portC()) return i32(9)
    if (m5Tab5().sdPins() != m5BoardTab5.sdPins() || !m5Tab5().sdPins().available()) return i32(10)
    number=0
    while (number <= 31) { if (m5Tab5().mBusPin(number) != m5BoardTab5.mBusPin(number)) return i32(11);number=number+1 }
    if (m5Tab5().internalI2cData().number() != m5BoardTab5.i2cPins().internalData() || m5Tab5().internalI2cClock().number() != m5BoardTab5.i2cPins().internalClock()) return i32(12)
    if (m5Tab5().externalI2cData().number() != m5BoardTab5.i2cPins().externalData() || m5Tab5().externalI2cClock().number() != m5BoardTab5.i2cPins().externalClock()) return i32(13)
    if (m5Tab5X().portA() != m5BoardTab5X.portA()) return i32(9)
    if (m5Tab5X().portB() != m5BoardTab5X.portB()) return i32(9)
    if (m5Tab5X().portC() != m5BoardTab5X.portC()) return i32(9)
    if (m5Tab5X().sdPins() != m5BoardTab5X.sdPins() || !m5Tab5X().sdPins().available()) return i32(10)
    number=0
    while (number <= 31) { if (m5Tab5X().mBusPin(number) != m5BoardTab5X.mBusPin(number)) return i32(11);number=number+1 }
    if (m5Tab5X().internalI2cData().number() != m5BoardTab5X.i2cPins().internalData() || m5Tab5X().internalI2cClock().number() != m5BoardTab5X.i2cPins().internalClock()) return i32(12)
    if (m5Tab5X().externalI2cData().number() != m5BoardTab5X.i2cPins().externalData() || m5Tab5X().externalI2cClock().number() != m5BoardTab5X.i2cPins().externalClock()) return i32(13)
    if (!m5Tab5().sdPins().usesSdmmcFourBit() || m5CoreP4X().sdPins().usesSdmmcFourBit() || m5ToughC5().sdPins().usesSdmmcFourBit()) return i32(14)
    return i32(0)
}
