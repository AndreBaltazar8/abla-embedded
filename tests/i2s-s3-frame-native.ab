import "../src/esp32/i2s/frame_width_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var base = 0
var transmit = false
var active = 0
var reads = 0
var writes = 0
var expected = 0
var bad = false
trusted fun esp32s3I2sClockRead(address: int): int {
    reads = reads + 1
    if (address != base + 32 && address != base + 36) bad = true
    active
}
trusted fun esp32s3I2sClockField(address: int, mask: int, value: int): void {
    writes = writes + 1
    if (address != base + (if (transmit) 44 else 40) || mask != 0x3fffe07f || value != expected) bad = true
    return
}
trusted fun i2sFrameTest(): int {
    var data = 8
    while (data <= 32) {
        var slot = data
        while (slot <= 32) {
            var width = 1
            while (width <= slot * 2) {
                var shift = 0
                while (shift < 2) {
                    val word = esp32s3I2sFrameWidthWord(data, slot, width, shift != 0)
                    if ((word & 127) != width - 1 || ((word >>> 13) & 31) != data - 1 || ((word >>> 18) & 63) != slot - 1 || ((word >>> 24) & 31) != slot - 1 || ((word >>> 29) & 1) != shift || (word & 0xc0001f80) != 0) return 1
                    shift = shift + 1
                }
                width = width + 1
            }
            slot = slot + 1
        }
        data = data + 8
    }
    var route = 0
    while (route < 4) {
        base = 0x6000f000 + route / 2 * 0x1e000
        transmit = (route & 1) != 0
        writes = 0
        active = 0
        expected = 15 | (15 << 13) | (15 << 18) | (15 << 24) | (1 << 29)
        if (!esp32s3I2sSetFrameWidths(route / 2, transmit, 16, 16, 16, true) || writes != 1 || bad) return 2
        writes = 0
        active = 4
        if (esp32s3I2sSetFrameWidths(route / 2, transmit, 16, 16, 16, true) || writes != 0) return 3
        active = 256
        if (esp32s3I2sSetFrameWidths(route / 2, transmit, 16, 16, 16, true) || writes != 0) return 4
        route = route + 1
    }
    reads = 0
    writes = 0
    if (esp32s3I2sSetFrameWidths(-1, false, 16, 16, 16, true) || esp32s3I2sSetFrameWidths(2, true, 16, 16, 16, true) || esp32s3I2sSetFrameWidths(0, true, 17, 32, 32, true) || esp32s3I2sSetFrameWidths(0, true, 24, 16, 16, true) || esp32s3I2sSetFrameWidths(0, true, 32, 33, 32, true) || esp32s3I2sSetFrameWidths(0, true, 16, 16, 0, true) || esp32s3I2sSetFrameWidths(0, true, 16, 16, 33, true) || reads != 0 || writes != 0) return 5
    0
}
#exportFunction("i2sFrameTest", "abla_i2s_frame_test")
