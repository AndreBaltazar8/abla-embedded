import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/rtc_wake_cancel_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_wake_cancel_target")
trusted fun cancelTarget(board: M5BoardId,rtc: M5Rtc,pmic: M5Pm1,wake: NativeBuffer,clocksUnchanged: bool): int =
    m5RtcWakeCancelS3Owned(board,rtc | 0,pmic | 0,wake,clocksUnchanged) | 0
