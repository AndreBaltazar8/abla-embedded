import "./sd-register-native.ab"
import "../src/sd/mmc_card_s3_sequence.ab"
val cardStorage=nativeStaticAllocate(80)
var hardwareTouched=false
trusted fun sdMmcS3Read(offset: int): int { hardwareTouched=true;return 0 }
trusted fun sdMmcS3Write(offset: int,value: int): void { hardwareTouched=true;return }
trusted fun checkCapacityLayouts(data: NativeBuffer,expected: int): bool {
    seal(data)
    val card=nativeBufferAt(cardStorage,80);card.storeU32(0,0x53444901)
    var word=0
    while (word < 4) {
        var value=0;var byte=0
        while (byte < 4) { value=value|(data.load(15-word*4-byte)<<(byte*8));byte=byte+1 }
        card.storeU32(48+word*4,value);word=word+1
    }
    return sdCsdBlockCount(data) == expected && sdMmcCardBlockCount(card) == expected && !hardwareTouched
}
@export("abla_sd_capacity_layout_test")
trusted fun testLayouts(): i32 {
    val data=nativeBufferAt(storage,16)
    var i=0;while (i < 16) { data.store(i,0);i=i+1 }
    var version=0
    while (version < 4) {
        setField(data,126,2,version)
        var length=0
        while (length < 16) {
            setField(data,80,4,length)
            var size=0
            while (size < 4096) {
                setField(data,62,12,size)
                val multiplier=size&7;setField(data,47,3,multiplier)
                val expected=if (version == 0 && length >= 9 && length <= 11) (size+1)*(1<<(multiplier+2))*(1<<length)/512
                    else if (version == 1 && length == 9) ((((data.load(7)&63)<<16)|(data.load(8)<<8)|data.load(9))+1)*1024 else 0
                if (!checkCapacityLayouts(data,expected)) return i32(1)
                size=size+1
            }
            length=length+1
        }
        version=version+1
    }
    setField(data,126,2,1);setField(data,80,4,9);setField(data,48,22,4194303)
    if (!checkCapacityLayouts(data,4294967296)) return i32(2)
    if (sdCsdCapacityFields(-1,0,0) != 0 || sdCsdCapacityFields(0,4294967296,0) != 0 || sdCsdCapacityFields(0,0,-1) != 0) return i32(3)
    if (sdRegisterTest() != 0) return i32(4)
    return i32(0)
}
