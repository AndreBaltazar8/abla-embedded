import "../src/m5stack/tough_power_owner_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(104)
var pmicBegin=true
var ioeBegin=true
var pmicClose=true
var ioeClose=true
var boot=M5ToughBoot(1|(5<<8))
var opens=0
var boots=0
var wakes=0
var bad=false
trusted fun m5PmicBusValid(bus: int): bool = bus == 7
trusted fun m5ExpanderBusValid(bus: int): bool = bus == 7
trusted fun m5PmicAllocate(bus: int,address: int,frequency: int): int {
    opens=opens+1
    if (bus != 7 || address != 110 || frequency != 100000) bad=true
    256
}
trusted fun m5PmicBegin(handle: int,kind: int): int = if (pmicBegin) 5 else 0
trusted fun m5PmicClose(handle: int): bool = pmicClose
trusted fun m5ExpanderAllocate(bus: int,address: int,frequency: int): int {
    opens=opens+1
    if (bus != 7 || address != 79 || frequency != 100000) bad=true
    257
}
trusted fun m5ExpanderBegin(handle: int,kind: int): bool = ioeBegin
trusted fun m5ExpanderClose(handle: int): bool = ioeClose
trusted fun toughOwnerConfigure(owner: M5Expanders,pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): M5ToughBoot {
    boots=boots+1
    if (!owner.ready() || !pmic.ready() || !presence.valid() || now != 123 ||
        owner.buffer().addressValue() != storage+36 || presence.buffer().addressValue() != storage+68) bad=true
    boot
}
trusted fun toughOwnerFinishWake(value: M5ToughBoot): M5ToughBoot { wakes=wakes+1; return boot }
@export("abla_tough_power_owner_test")
trusted fun ownerTest(): i32 {
    val owner=m5ToughPowerOwnerAt(nativeBufferAt(storage+4,96))
    var profile=0
    while (profile < 64) {
        nativeAddressStoreU32(storage,0,12345); nativeAddressStoreU32(storage,100,54321)
        if (!owner.initialize()) return i32(1)
        pmicBegin=profile%2 == 0; ioeBegin=profile/2%2 == 0
        pmicClose=profile/4%2 == 0; ioeClose=profile/8%2 == 0
        boot=M5ToughBoot(if (profile/16 == 0) 1|(5<<8) else if (profile/16 == 1) 2|(5<<8)|(1<<34) else if (profile/16 == 2) 6|(5<<8) else 5|(2<<8))
        opens=0; boots=0; wakes=0; bad=false
        if (owner.beginOwned(0,123) != 2 || opens != 0 || owner.status() != 0) return i32(2)
        val expected=if (!pmicBegin) 3 else if (!ioeBegin) 4 else if (boot.powerReady()) 1 else 5
        if (owner.beginOwned(7,123) != expected || bad || boots != (if (pmicBegin && ioeBegin) 1 else 0)) return i32(3)
        val originalOpens=opens
        if (owner.beginOwned(7,123) != 2 || opens != originalOpens) return i32(4)
        val canRetry=expected == 5 && boot.status() == 6
        boot=M5ToughBoot(1|(5<<8))
        if (owner.retryWakeInput() != canRetry || wakes != (if (canRetry) 1 else 0) || opens != originalOpens) return i32(5)
        val ownsPmic=owner.pmic().ownsDevice()
        val ownsIoe=owner.expanders().slot(0).ownsDevice()
        val shouldClose=(!ownsPmic || pmicClose) && (!ownsIoe || ioeClose)
        val heldStatus=owner.status()
        owner.buffer().storeU32(24,1234)
        if (owner.close() || owner.status() != heldStatus || owner.pmic().ownsDevice() != ownsPmic || owner.expanders().slot(0).ownsDevice() != ownsIoe) return i32(9)
        owner.buffer().storeU32(24,0)
        if (owner.close() != shouldClose || owner.status() != (if (shouldClose) 7 else 6)) return i32(6)
        pmicClose=true; ioeClose=true
        if (!owner.close() || !owner.close() || owner.pmic().ownsDevice() || owner.expanders().slot(0).ownsDevice()) return i32(7)
        if (nativeAddressLoadU32(storage,0) != 12345 || nativeAddressLoadU32(storage,100) != 54321) return i32(8)
        profile=profile+1
    }
    i32(0)
}
