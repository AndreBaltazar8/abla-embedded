import "../src/esp32/ldo_p4_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_ldo_p4_test")
fun testLdo(): i32 {
    var profile=0
    while (profile < 9) {
        val rawK=if (profile == 0) 0 else if (profile <= 4) 127 else 255
        val rawVos=if (profile == 0) 0 else if (profile%2 == 0) 31 else 63
        val rawC=if (profile == 0) 0 else if ((profile&2) == 0) 31 else 63
        val k=if (profile == 0) 1000 else if (profile <= 4) 1102 else 848
        val vos=if (profile == 0) 0 else if (profile%2 == 0) 28 else -34
        val c=if (profile == 0) 1000 else if ((profile&2) == 0) 1021 else 959
        var mv=500
        while (mv <= 2700) {
            val plan=esp32P4LdoSelectVoltage(3,mv,true,rawK,rawVos,rawC,0,0)
            var error=1000000000
            var expected=0
            var expectedVoltage=0
            var i=0
            while (i < 128) {
                val d=i/8
                val m=i%8
                val ref=if (d < 9) 10+d else 20+(d-9)*2
                val voltage=(ref*k+20*vos)*(4000+m*c)
                var delta=voltage-mv*80000
                if (delta < 0) delta= -delta
                if (delta < error) { error=delta; expected=d+m*16; expectedVoltage=voltage }
                i=i+1
            }
            if (!plan.valid() || plan.bypass() || plan.dref()+plan.multiplier()*16 != expected ||
                plan.predictedScaled() != expectedVoltage) return i32(1)
            mv=mv+1
        }
        profile=profile+1
    }
    var channel=1
    while (channel <= 4) {
        val rail=esp32P4LdoSelectVoltage(channel,3300,false,0,0,0,0,0)
        if (!rail.valid() || !rail.bypass() || rail.predictedScaled() != 264000000) return i32(2)
        val factory=esp32P4LdoSelectVoltage(channel,1800,true,0,0,0,15,7)
        if (channel <= 2 && (factory.dref() != 15 || factory.multiplier() != 7)) return i32(3)
        if (channel >= 3 && factory.dref() == 15 && factory.multiplier() == 7) return i32(4)
        val absent=esp32P4LdoSelectVoltage(channel,1800,false,255,63,63,15,7)
        if (absent != esp32P4LdoSelectVoltage(channel,1800,false,0,0,0,0,0)) return i32(5)
        channel=channel+1
    }
    if (esp32P4LdoSelectVoltage(0,2500,false,0,0,0,0,0).valid() ||
        esp32P4LdoSelectVoltage(3,2701,false,0,0,0,0,0).valid() ||
        esp32P4LdoSelectVoltage(3,499,false,0,0,0,0,0).valid() ||
        esp32P4LdoSelectVoltage(3,2500,true,256,0,0,0,0).valid()) return i32(6)
    i32(0)
}
