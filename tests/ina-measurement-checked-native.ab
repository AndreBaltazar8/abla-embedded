import "../src/power/ina226_device.ab"
import "../src/power/ina3221_device.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
fun I2cBus.valid(): bool = false
fun I2cBus.device(address: int,frequency: int): I2cDevice = I2cDevice(0)
fun I2cDevice.close(): bool = false
fun I2cDevice.writeRegister16BigEndian(register: int,value: int): bool = false
var word=0
var readOk=true
var expectedRegister=0
var calls=0
var bad=false
fun I2cDevice.readRegister16BigEndianChecked(register: int): I2cWordResult {
    calls=calls+1
    if (this != 7 || register != expectedRegister) bad=true
    return I2cWordResult(if (readOk) 65536|word else 0)
}
@export("abla_ina_measurement_checked_test")
fun measurementTest(): i32 {
    while (word < 65536) {
        val raw=I2cWordResult(65536|word);val signed=if (word < 32768) word else word-65536
        if (!ina226BusMillivoltsChecked(raw).valid() || ina226BusMillivoltsChecked(raw).value() != word*5/4 ||
            !ina226ShuntMicrovoltsChecked(raw).valid() || ina226ShuntMicrovoltsChecked(raw).value() != signed*5/2 ||
            !ina3221BusMillivoltsChecked(raw).valid() || ina3221BusMillivoltsChecked(raw).value() != signed ||
            !ina3221ShuntMicrovoltsChecked(raw).valid() || ina3221ShuntMicrovoltsChecked(raw).value() != signed*5) return i32(1)
        var profile=0
        while (profile < 4) {
            val lsb=if (profile == 0) 1 else if (profile == 1) 61036 else if (profile == 2) 1000000 else 2147483647
            val expected=word*lsb*25/1000000
            val result=ina226PowerMilliwattsChecked(raw,lsb)
            if (result.valid() != (expected <= 2147483647) || (result.valid() && result.value() != expected)) return i32(2)
            profile=profile+1
        }
        word=word+1
    }
    word=0
    val sensor=Ina226((61036<<32)|7);val triple=Ina3221(7)
    var failure=0
    while (failure < 2) {
        readOk=failure == 0;calls=0;bad=false
        expectedRegister=2
        if (sensor.busMillivoltsChecked().valid() != readOk) return i32(3)
        expectedRegister=1
        if (sensor.shuntMicrovoltsChecked().valid() != readOk) return i32(4)
        expectedRegister=3
        if (sensor.powerMilliwattsChecked().valid() != readOk) return i32(5)
        var channel=0
        while (channel < 3) {
            expectedRegister=2+channel*2
            if (triple.busMillivoltsChecked(channel).valid() != readOk) return i32(6)
            expectedRegister=1+channel*2
            if (triple.shuntMicrovoltsChecked(channel).valid() != readOk) return i32(7)
            channel=channel+1
        }
        if (calls != 9 || bad) return i32(8)
        failure=failure+1
    }
    calls=0
    if (Ina226(0).busMillivoltsChecked().valid() || Ina226(7).powerMilliwattsChecked().valid() || Ina226(0).shuntMicrovoltsChecked().valid() ||
        triple.busMillivoltsChecked(-1).valid() || triple.shuntMicrovoltsChecked(3).valid() || calls != 0) return i32(9)
    val invalid=I2cWordResult(0)
    if (ina226BusMillivoltsChecked(invalid).valid() || ina226ShuntMicrovoltsChecked(invalid).valid() || ina3221BusMillivoltsChecked(invalid).valid() || ina3221ShuntMicrovoltsChecked(invalid).valid() ||
        ina226PowerMilliwattsChecked(invalid,1).valid() || ina226PowerMilliwattsChecked(I2cWordResult(65536),0).valid() || ina226PowerMilliwattsChecked(I2cWordResult(65536),2147483648).valid()) return i32(10)
    return i32(0)
}
