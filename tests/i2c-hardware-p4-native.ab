import "../src/esp32/i2c/hardware_provider_p4.ab"
import "../src/esp32/i2c/hardware_scan_p4.ab"
import "../src/esp32/i2c/hardware_recovery_p4.ab"
import "../src/esp32/i2c/hardware_clear_idle_p4.ab"
import "../src/io_expander/m5ioe1_device.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(72)
val data=nativeStaticAllocate(8)
val enclosingStorage=nativeStaticAllocate(96)
val clearStorage=nativeStaticAllocate(80)
var clearResult=4
var clears=0
var aborts=0
var abortResult=1
trusted fun p4HardwareAbortFailed(session: NativeBuffer,budget: u32): int {
    aborts=aborts+1
    if (p4HardwareLoad(0) != 1 || p4HardwareLoad(20) != 3 ||
        session.loadU32(4) != 3 || budget != u32(400000000)) bad=true
    return abortResult
}
trusted fun p4HardwareClearIdle(record: NativeBuffer,session: NativeBuffer,budget: u32): int {
    clears=clears+1
    val bus=I2cBus(p4HardwareLoad(4))
    if (p4HardwareLoad(0) != 1 || p4HardwareLoad(20) != 3 ||
        p4HardwareLoad(32) != record.addressValue() || budget != u32(400000000) || bus.close() || bus.device(42).valid()) bad=true
    if (clearResult == 3) return 3
    record.storeU32(0,0x4932434c);record.storeU32(4,if (clearResult == 4) 2 else 3)
    session.storeU32(4,if (clearResult == 1) 1 else 3)
    return clearResult
}
var wire=1
var calls=0
var timingCalls=0
var timingFails=false
var cleanupFails=false
var bad=false
var expectedAddress=42
var expectedPrefix=12
var expectedBudget=u32(400000000)
var probeResult=9
var probes=0
var recoveryResult=1
var recoveries=0
trusted fun p4HardwareRecover(r: NativeBuffer,budget: u32,stopAfterNack: bool): int {
    if (r.loadU32(4) != 2 || p4HardwareLoad(0) != 1 || budget != u32(400000000)) bad=true
    recoveries=recoveries+1;return recoveryResult
}
trusted fun p4HardwareProbe(port: int,address: int,budget: u32): int {
    if (port != 1 || address != 42 || budget != u32(20000000) || p4HardwareLoad(0) != 1 || p4HardwareSession().loadU32(4) != 2) bad=true
    probes=probes+1;return probeResult
}
trusted fun p4I2cSessionClockOpen(port: int,source: int): int { bad=true;return 0 }
trusted fun p4I2cSessionInitialize(port: int,filter: int): int { bad=true;return 0 }
trusted fun p4I2cSessionPinsOpen(r: NativeBuffer,port: int,sda: int,scl: int,pullup: bool,layout: int): int { bad=true;return 0 }
trusted fun p4I2cSessionClockClose(token: int): int = if (cleanupFails) 4101 else 4102
trusted fun p4I2cSessionPinsClose(r: NativeBuffer): int = 2
trusted fun p4I2cSessionTiming(port: int,t: P4I2cTiming): int {
    timingCalls=timingCalls+1
    if (!t.valid() || port != 1) bad=true
    return if (timingFails) 5 else 1
}
trusted fun p4I2cSessionTransfer(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    if (port != 1 || address != expectedAddress || prefix != expectedPrefix || budget != expectedBudget ||
        p4HardwareLoad(0) != 1) bad=true
    var i=0
    while (i < read) { input.store(i,0x5a);i=i+1 }
    calls=calls+1;return wire
}
trusted fun seedSession(): void {
    val r=nativeBufferAt(storage,72)
    var i=0
    while (i < 72) { r.storeU32(i,0);i=i+4 }
    r.storeU32(0,0x49324234);r.storeU32(4,1);r.storeU32(16,4097);r.storeU32(20,1);r.storeU32(24,1)
    return
}
@export("abla_i2c_hardware_p4_test")
trusted fun test(): i32 {
    seedSession()
    val r=nativeBufferAt(storage,72);val b=nativeBufferAt(data,8)
    val bus=i2cHardwareBindOwned(r,u32(40000000),u32(400000000))
    if (!bus.valid() || i2cHardwareBindOwned(r,u32(40000000),u32(400000000)).valid()) return i32(1)
    val d=bus.device(42,100000)
    if (!d.valid() || d.transferStatus(b,1,b,1,1000,12) != 1 || bad) return i32(2)
    if (!d.close() || d.transferStatus(b,1,b,1,1000,12) != 2 || d.close()) return i32(3)
    val next=bus.device(42,400000)
    if (!next.valid() || next == d) return i32(4)
    val before=calls
    if (next.transferStatus(r,1,b,1) != 2 || next.transferStatus(b,1,nativeBufferAt(p4HardwareSlots,200),1) != 2 ||
        next.transferStatus(b,1,b,1,1000000) != 2 || calls != before) return i32(5)
    if (!p4HardwareEnter()) return i32(6)
    if (next.transferStatus(b,1,b,1) != 4 || bus.close()) return i32(7)
    if (!p4HardwareLeave()) return i32(8)
    wire=3
    if (next.transferStatus(b,1,b,1,1000,12) != 5 || next.transferStatus(b,1,b,1,1000,12) != 7) return i32(9)
    cleanupFails=true
    if (bus.close() || next.close()) return i32(10)
    cleanupFails=false
    if (!bus.close()) return i32(11)
    seedSession();wire=1
    val reopened=i2cHardwareBindOwned(r,u32(40000000),u32(400000000))
    if (!reopened.valid() || reopened == bus || bus.close() || bus.device(42).valid()) return i32(12)
    val expander=m5Ioe1(reopened)
    expectedAddress=79;expectedPrefix=37
    // NativeBuffer packs32-bit addresses: use the unchanged caller-buffer
    // driver API on x86_64, where the process stack is above that range.
    if (!expander.setPwmFrequencyWithBuffer(12345,b) || b.loadU16(0) != 12345 || bad) return i32(13)
    timingFails=true
    val count=calls
    if (expander.device().transferStatus(b,1,b,1) != 6 || calls != count || r.loadU32(4) != 3) return i32(14)
    if (!expander.close() || !reopened.close() || bad) return i32(15)
    seedSession();timingFails=false
    val enclosing=nativeBufferAt(enclosingStorage,96)
    var i=0
    while (i < 72) { enclosing.storeU32(24+i,r.loadU32(i));i=i+4 }
    val inner=nativeBufferAt(enclosingStorage+24,72)
    if (i2cHardwareBindOwned(inner,u32(40000000),u32(400000000),nativeBufferAt(enclosingStorage,95)).valid()) return i32(16)
    val guarded=i2cHardwareBindOwned(inner,u32(40000000),u32(400000000),enclosing)
    val guardedDevice=guarded.device(42)
    val oldCalls=calls
    if (!guarded.valid() || !guardedDevice.valid() ||
        guardedDevice.transferStatus(enclosing,1,b,1) != 2 ||
        guardedDevice.transferStatus(b,1,nativeBufferAt(enclosingStorage+23,1),1) != 2 ||
        guardedDevice.transferStatus(nativeBufferAt(p4HardwareState+31,1),1,b,1) != 2 || calls != oldCalls) return i32(17)
    if (guardedDevice.transferStatus(nativeBufferAt(p4HardwareState+35,1),1,b,1) != 2 || calls != oldCalls) return i32(40)
    if (!guarded.close() || bad) return i32(18)
    seedSession()
    val scan=i2cHardwareBindOwned(r,u32(40000000),u32(400000000))
    // A full device pool must not prevent address-only probes.
    i=0
    while (i < 16) { if (!scan.device(i+1).valid()) return i32(19);i=i+1 }
    if (scan.device(42).valid()) return i32(20)
    probeResult=9
    if (scan.probeStatus(42) != 5 || scan.probeStatus(42) != 5 || r.loadU32(4) != 1 || bad) return i32(21)
    probeResult=1
    if (!scan.probe(42) || r.loadU32(4) != 1 || bad) return i32(22)
    // A raw NACK interrupt is not completed absence, and must latch fault.
    probeResult=3
    if (scan.probeStatus(42) != 6 || r.loadU32(4) != 3) return i32(23)
    val oldProbes=probes
    if (scan.probeStatus(42) != 7 || probes != oldProbes || bad) return i32(24)
    if (scan.recoverStatus() != 7 || recoveries != 0) return i32(25)
    r.storeU32(24,3);recoveryResult=5
    if (scan.recoverStatus(1000,true) != 3 || r.loadU32(4) != 3 || r.loadU32(8) != 3 || r.loadU32(12) != 5) return i32(26)
    r.storeU32(8,4)
    val oldRecoveries=recoveries
    if (scan.recoverStatus(1000,true) != 7 || recoveries != oldRecoveries) return i32(27)
    recoveryResult=1
    if (!scan.recover() || r.loadU32(4) != 1 || r.loadU32(8) != 4 || r.loadU32(12) != 0) return i32(28)
    probeResult=9
    if (scan.probeStatus(42) != 5 || !scan.close() || bad) return i32(29)
    seedSession();r.storeU32(24,3)
    val clearing=i2cHardwareBindOwned(r,u32(40000000),u32(400000000))
    val record=nativeBufferAt(clearStorage,40);val other=nativeBufferAt(clearStorage+40,40)
    if (clearing.clearIdleStatus(r) != 2 || clearing.clearIdleStatus(nativeBufferAt(p4HardwareSlots,40)) != 2 ||
        clearing.clearIdleStatus(nativeBufferAt(p4HardwareState+32,40)) != 2 ||
        clearing.clearIdleStatus(record,1000000) != 2 || clears != 0) return i32(30)
    clearResult=3
    if (clearing.clearIdleStatus(record) != 3 || p4HardwareLoad(32) != 0 || !clearing.current()) return i32(31)
    clearResult=4
    if (clearing.clearIdleStatus(record) != 4 || clearing.current() || p4HardwareLoad(32) != clearStorage ||
        clearing.close() || clearing.recoverStatus() != 2 || clearing.probeStatus(42) != 2 ||
        clearing.device(42).valid() || p4HardwareSafe(record,1)) return i32(32)
    val previousClears=clears
    if (clearing.clearIdleStatus(other) != 9 || scan.clearIdleStatus(record) != 9 || clears != previousClears) return i32(33)
    if (!p4HardwareEnter()) return i32(34)
    val blocked=clearing.clearIdleStatus(record)
    if (!p4HardwareLeave() || blocked != 9 || clears != previousClears) return i32(35)
    clearResult=1
    if (clearing.clearIdleStatus(record) != 1 || !clearing.current() || r.loadU32(4) != 1 ||
        p4HardwareLoad(32) != 0 || clearing.clearIdleStatus(record) != 9 || !clearing.close() || bad) return i32(36)
    seedSession();r.storeU32(24,3)
    val aborting=i2cHardwareBindOwned(r,u32(40000000),u32(400000000))
    if (aborting.abortAndClearStatus(other) != 2 || aborts != 0) return i32(41)
    r.storeU32(4,3);r.storeU32(8,5)
    var failure=2
    val clearCount=clears
    while (failure <= 6) {
        abortResult=failure
        if (aborting.abortAndClearStatus(other) != (0x100|failure) || clears != clearCount ||
            r.loadU32(4) != 3 || r.loadU32(8) != 5 || p4HardwareLoad(32) != 0 ||
            other.loadU32(0) != 0 || !aborting.current() || bad) return i32(42)
        failure=failure+1
    }
    abortResult=1;clearResult=4
    if (aborting.abortAndClearStatus(other) != 4 || p4HardwareLoad(32) != other.addressValue()) return i32(43)
    val abortCount=aborts
    clearResult=1
    if (aborting.abortAndClearStatus(other) != 1 || aborts != abortCount ||
        r.loadU32(4) != 1 || r.loadU32(8) != 5 || !aborting.close() || bad) return i32(44)
    return i32(0)
}
