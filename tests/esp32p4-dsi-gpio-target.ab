import "../src/esp32/gpio_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_gpio_target")
trusted fun target(pin: int,output: bool,high: bool,od: bool,input: bool,pull: int): int {
    if (pull == -4) return esp32P4IomuxClockOpenOwned(pin)|0
    if (pull == -5) return Esp32P4IomuxClockOwner(pin).closeOwned()|0
    if (pull == -1 || pull == -3) return esp32P4GpioSetIndividualHoldOwned(-pull,pin,high)
    val configured=esp32P4GpioConfigure(pin,output,high,od,input,pull)
    if (configured != 1) return configured
    return 16|esp32P4GpioRead(pin)
}
