import "../src/esp32/gpio/output_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var number=0
var enable=0
var latch=0
var pad=0
var mux=0
var route=0
var writes=0
var drop=-1
var bad=false
var high=false
fun esp32S3PinStateRead(address: int): int {
    val bank=esp32S3GpioBankOffset(number)
    if (address == 0x60004020+bank) return enable
    if (address == 0x60004004+bank) return latch
    if (address == 0x60004074+number*4) return pad
    if (address == esp32S3GpioMuxAddress(number)) return mux
    if (address == 0x60004554+number*4) return route
    bad=true;return 0
}
fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes;writes=writes+1
    if (step == drop) return
    val bank=esp32S3GpioBankOffset(number)
    val bit=1<<(number&31)
    if (address == 0x60004028+bank) enable=enable&~value
    else {
        if ((enable&bit) != 0) bad=true
        if (address == 0x60004554+number*4) route=value
        else {
            if ((route&3072) != 1024) bad=true
            if (address == 0x60004008+bank) latch=latch|value
            else if (address == 0x6000400c+bank) latch=latch&~value
            else if (address == 0x60004074+number*4) pad=value
            else if (address == esp32S3GpioMuxAddress(number)) mux=value
            else if (address == 0x60004024+bank) {
                if ((route&4095) != 1280 || (mux&29184) != 4096 || (pad&4) != 0 || ((latch&bit) != 0) != high) bad=true
                enable=enable|value
            } else bad=true
        }
    }
    return
}
@export("abla_gpio_s3_output_test")
fun test(): i32 {
    while (number <= 48) {
        if (espChipS3().gpioOutputValid(number)) {
            drop=-1
            while (drop < 4) {
                enable=0xffffffff;pad=0xabcd0004;mux=0xabcd7200;route=0xabcd0800;writes=0;bad=false
                val okay=esp32S3GpioInputOwned(number)
                if (okay != (drop == -1) || bad || writes != (if (drop < 0) 4 else drop+1)) return i32(6)
                if (drop != 0 && (enable&(1<<(number&31))) != 0) return i32(7)
                if (drop == -1 && ((mux&29184) != 4608 || (pad&4) != 0)) return i32(8)
                drop=drop+1
            }
            var level=0
            while (level < 2) {
                high=level == 1;drop=-1
                while (drop < 7) {
                    val bit=1<<(number&31)
                    enable=0xffffffff;latch=if (high) 0 else 0xffffffff
                    pad=0xabcd0004;mux=0xabcd7200;route=0xabcd0800;writes=0;bad=false
                    val okay=esp32S3GpioOutputLevelOwned(number,high)
                    if (okay != (drop == -1) || bad || writes != (if (drop < 0) 7 else drop+1)) return i32(1)
                    if (drop > 0 && (enable&bit) != 0) return i32(2)
                    if (drop == -1 && (enable != 0xffffffff || pad != 0xabcd0000 || mux != ((0xabcd7200&~29184)|4096) || route != 0xabcd0500)) return i32(3)
                    drop=drop+1
                }
                level=level+1
            }
        } else {
            writes=0
            if (esp32S3GpioOutputLevelOwned(number,true) || writes != 0) return i32(4)
        }
        number=number+1
    }
    writes=0
    if (esp32S3GpioOutputLevelOwned(-1,true) || esp32S3GpioOutputLevelOwned(49,false) || writes != 0) return i32(5)
    return i32(0)
}
