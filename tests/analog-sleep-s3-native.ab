import "../src/esp32/analog_sleep_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var expected=0
var reads=0
var writes=0
var bad=false
fun esp32S3AnalogSleepRead(register: int): int {
    if (register != reads || writes != 0) bad=true
    reads=reads+1
    (expected >>> (register*8)) & 255
}
fun esp32S3AnalogSleepWrite(register: int,value: int): void {
    if (register != writes || reads != 8 || value != ((expected >>> (register*8)) & 255)) bad=true
    writes=writes+1
    return
}
@export("abla_analog_sleep_test")
trusted fun analogTest(): i32 {
    var lane=0
    while (lane < 8) {
        var value=0
        while (value < 256) {
            expected=(0xA5C3E781193B5D7F & ~(255 << (lane*8))) | (value << (lane*8))
            reads=0; writes=0; bad=false
            val saved=esp32S3AnalogSleepCaptureOwned()
            if ((saved | 0) != expected) return i32(1)
            esp32S3AnalogSleepRestoreOwned(saved)
            if (bad || reads != 8 || writes != 8) return i32(2)
            value=value+1
        }
        lane=lane+1
    }
    i32(0)
}
