import "../src/esp32/i2c/software_devices_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_i2c_devices_target")
trusted fun target(bus: Esp32P4SoftwareI2cBus,pool: I2cDeviceSlots,handle: int,operation: int,buffer: NativeBuffer): int {
    if (operation == 0) return bus.deviceOwned(pool,67,400000)
    if (operation == 1) return bus.transferDeviceOwned(pool,handle,NativeBuffer(0),0,buffer,1,1)|0
    if (operation == 2) return if (bus.closeDeviceOwned(pool,handle)) 1 else 0
    return bus.closeWithDevicesOwned(pool)|0
}
