import "../src/m5stack/pmic_key_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var value=0
var calls=0
var expectedKind=2
var bad=false
fun m5PmicKeyAxp(handle: int,kind: int): int {
    calls=calls+1
    if (handle != 123 || kind != expectedKind) bad=true
    value
}
fun m5PmicKeyPm1(handle: int): int {
    calls=calls+1
    if (handle != 123 || expectedKind != 5) bad=true
    value
}
@export("abla_pmic_key_test")
fun keyTest(): i32 {
    var profile=0
    while (profile < 96) {
        expectedKind=if (profile/32 == 0) 2 else if (profile/32 == 1) 3 else 5
        val raw=profile%8
        val status=profile/8%4
        value=if (expectedKind == 5) (raw&5)|(if (status == 3) 256 else 0) else raw|(status<<8)
        val pmic=M5PmicOpen((1<<40)|(expectedKind<<32)|123)
        calls=0; bad=false
        val result=pmic.readKeyOwned()
        val observed=if (expectedKind == 5) raw&5 else raw
        val expectedStatus=if (expectedKind != 5) status else if (status == 3) 3 else if (observed != 0) 2 else 1
        if (result.status() != expectedStatus || result.observed() != observed || calls != 1 || bad) return i32(1)
        val code=if (expectedStatus != 3 || observed == 0) 0 else if (expectedKind == 5 || observed == 2) 2 else 1
        if (result.compatibilityCode() != code || result.doubleClicked() !=
            (expectedKind == 5 && expectedStatus == 3 && (observed&4) != 0)) return i32(2)
        profile=profile+1
    }
    calls=0
    if (M5PmicOpen(0).readKeyOwned().valid() || M5PmicOpen((1<<40)|(4<<32)|123).readKeyOwned().valid() ||
        M5PmicOpen((6<<40)|(2<<32)|123).readKeyOwned().valid() || calls != 0) return i32(3)
    i32(0)
}
