// Regression for PHY globals and table tails lost by objdump parsing.

import "abla/io"
import "abla/bytes"
import "abla/text"
import "../tools/lib/reconstruct-xtensa.ab"

val noRelocations: Map<int, ReconReloc> = Map()

fun hex2(value: int): string = reconHex2(value)

// bytes(range(size)) as a string of bytes
fun counting(size: int): string {
    val parts: array<string> = []
    var index = 0
    while (index < size) {
        parts.append(byteEncode(index))
        index = index + 1
    }
    parts.join("")
}

fun dump(size: int): string {
    val lines: array<string> = ["Contents of section .data:"]
    var offset = 0
    while (offset < size) {
        val groups: array<string> = []
        var at = offset
        while (at < size && at < offset + 16) {
            val group: array<string> = []
            var inner = at
            while (inner < size && inner < at + 4 && inner < offset + 16) {
                group.append(hex2(inner))
                inner = inner + 1
            }
            groups.append(group.join(""))
            at = at + 4
        }
        lines.append(" " + reconHex(offset).padStart(4, "0") + " " + groups.join(" ").padEnd(35) + "  deadbeef")
        offset = offset + 16
    }
    lines.append("Contents of section .rodata:")
    lines.append(" 0000 fd        .")
    lines.join("\n")
}

fun main: int {
    var size = 1
    while (size <= 33) {
        val parsed = sectionBytes(dump(size))
        val data = parsed.get(".data")
        val rodata = parsed.get(".rodata")
        if (parsed.size != 2 || data == null || data != counting(size) || rodata == null || rodata != byteEncode(0xfd)) {
            println("FAIL section bytes of length $size")
            return 1
        }
        size = size + 1
    }
    val truncated = dataSectionDirectives(".data.test", "test", 3, 0, byteEncode(1), noRelocations)
    if (truncated.error == "") {
        println("FAIL Truncated initialized data must not become zero padding")
        return 1
    }
    val zeroed = dataSectionDirectives(".bss.test", "test", 3, 0, "", noRelocations)
    if (zeroed.error != "" || !reconContains(zeroed.lines, ".zero 3")) {
        println("FAIL .bss directives lost their .zero")
        return 1
    }
    println("Exact section bytes: lengths 1..33; truncated initialized data rejected")
    0
}
