import "../src/rtc/powerhub_logic.ab"

fun main: int {
    val decoded = powerHubDecodeDateTime(58, 59, 23, 26, 8, 26, 8)
    val valid = decoded.valid() && decoded.year() == 2026 &&
        decoded.month() == 8 && decoded.day() == 26 &&
        decoded.weekday() == 3 && decoded.hour() == 23 &&
        decoded.minute() == 59 && decoded.second() == 58
    val weekdays = powerHubWeekdayValue(0) == 1 &&
        powerHubWeekdayValue(4) == 10 && powerHubWeekdayValue(6) == 40 &&
        powerHubWeekday(20) == 5 && powerHubWeekday(3) == -1
    if (valid && weekdays) 48 else 1
}
