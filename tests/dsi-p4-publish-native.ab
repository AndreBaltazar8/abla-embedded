import "../src/display/dsi_frame_publish_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var step=0
var fail=0
var bad=false
var active=false
var reads=0
fun p4DwDmaRead(offset: int): u32 {
    reads=reads+1
    if (offset == 16) return u32(1)
    if (offset == 24 && active) return u32(15)
    return u32(0)
}
fun p4CacheSyncRead(offset: int): u32 { reads=reads+1; return u32(16) }
fun p4CacheSyncWrite(offset: int,value: u32): void { bad=true; return }
trusted fun p4DsiPrepareFrame(descriptor: NativeBuffer,frame: NativeBuffer,bytes: int): bool {
    if (step != 0 || descriptor.addressValue() != 1341128704 || frame.addressValue() != 1207959552 || bytes != 1843200) bad=true
    step=step+1; return fail != 1
}
fun p4DsiPublicationFence(): void {
    if (step != 1 && step != 4 && step != 6) bad=true
    step=step+1; return
}
trusted fun p4DsiWritebackFrame(buffer: NativeBuffer,bytes: int,line: int,polls: int): int {
    if ((step != 2 && step != 3) || line != 128 || polls != 2 ||
        buffer.addressValue() != (if (step == 2) 1207959552 else 1341128704) ||
        bytes != (if (step == 2) 1843200 else 64)) bad=true
    step=step+1; return if (fail == step) 5 else 1
}
fun p4DsiConfigureFrameChannel(channel: int,address: int): int {
    if (step != 5 || channel < 0 || channel > 3 || address != 1341128704) bad=true
    step=step+1; return if (fail == 6) 6 else 1
}
fun p4DsiStartFrameChannel(channel: int): int {
    if (step != 7) bad=true
    step=step+1; return if (fail == 8) 5 else 1
}
fun resetPublish(): void { step=0; fail=0; bad=false; active=false; reads=0; return }
@export("abla_dsi_p4_publish_test")
trusted fun testPublish(): i32 {
    val descriptor=nativeBufferAt(1341128704,64)
    val frame=nativeBufferAt(1207959552,1843200)
    var channel=0
    while (channel < 4) {
        resetPublish()
        if (esp32P4DsiFramePublishOwned(channel,descriptor,frame,1843200,128,2) != 1 || step != 8 || bad) return i32(1)
        var fault=1
        while (fault <= 8) {
            if (fault == 1 || fault == 3 || fault == 4 || fault == 6 || fault == 8) {
                resetPublish(); fail=fault
                var expected=4
                if (fault == 3) expected=1285
                if (fault == 4) expected=1286
                if (fault == 6) expected=1543
                if (fault == 8) expected=1288
                if (esp32P4DsiFramePublishOwned(channel,descriptor,frame,1843200,128,2) != expected || step != fault || bad) return i32(2)
            }
            fault=fault+1
        }
        resetPublish(); active=true
        if (esp32P4DsiFramePublishOwned(channel,descriptor,frame,1843200,128,2) != 3 || step != 0) return i32(3)
        channel=channel+1
    }
    resetPublish()
    if (esp32P4DsiFramePublishOwned(0,descriptor,nativeBufferAt(1341128704,64),64,64,2) != 2 ||
        esp32P4DsiFramePublishOwned(0,nativeBufferAt(1207959552,128),frame,1843200,128,2) != 2 ||
        esp32P4DsiFramePublishOwned(0,descriptor,nativeBufferAt(1207959552,8),8,128,2) != 2 ||
        esp32P4DsiFramePublishOwned(4,descriptor,frame,1843200,128,2) != 2 ||
        esp32P4DsiFramePublishOwned(0,descriptor,frame,1843199,128,2) != 2 || reads != 0 || step != 0) return i32(4)
    return i32(0)
}
