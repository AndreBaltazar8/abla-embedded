import "../src/esp32/i2c/guarded_recovery_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(64)
var outcome=1
var clearOk=false
var stolen=false
var calls=0
var clears=0
var bad=false
trusted fun c5I2cGuardedRecover(sda: int,scl: int,scratch: NativeBuffer): int {
    if (sda != 2 || scl != 3 || scratch.addressValue() != storage+8 || calls != 0 ||
        atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(0x80000007)) bad=true
    calls=calls+1
    if (stolen) nativeAddressStoreU32(storage,0,9)
    outcome
}
fun c5I2cGuardedClear(sda: int,scl: int,budget: u32): bool {
    if (sda != 2 || scl != 3 || calls != 1 || clears != 0 || budget != u32(1000) || outcome != 10) bad=true
    clears=clears+1
    clearOk
}
@export("abla_c5_i2c_guarded_recovery_test")
trusted fun recoveryTest(): i32 {
    val gate=peripheralGateAt(storage)
    val scratch=nativeBufferAt(storage+8,52)
    var profile=0
    while (profile < 128) {
        val state=profile%4
        val variant=(profile/4)%4
        outcome=if (variant == 0) 1 else if (variant == 1) 7 else if (variant == 2) 9 else 10
        val clearStuck=((profile/16)&1) != 0
        clearOk=((profile/32)&1) != 0
        stolen=profile >= 64
        val initial=if (state == 0) u32(0x80000000) else if (state == 1) u32(0) else if (state == 2) u32(9) else u32(0x80000009)
        nativeAddressStoreU32(storage,0,int(initial))
        calls=0; clears=0; bad=false
        val result=esp32C5I2cRecoverGuardedOwned(gate,u32(7),0,2,3,scratch,u32(1000),clearStuck)
        val clearExpected=state == 0 && outcome == 10 && clearStuck && !stolen
        val healthy=outcome == 1 || clearExpected && clearOk
        val expected=if (state != 0) 9 else if (stolen) 11 else if (healthy) 1 else outcome
        val finalState=if (state != 0) initial else if (stolen) u32(9) else if (healthy) u32(0) else u32(0x80000000)
        if (result != expected || gate.word().compareExchange(u32(0),u32(0)) != finalState ||
            calls != (if (state == 0) 1 else 0) || clears != (if (clearExpected) 1 else 0) || bad) return i32(1)
        profile=profile+1
    }
    nativeAddressStoreU32(storage,0,0x80000000); calls=0
    if (esp32C5I2cRecoverGuardedOwned(gate,u32(7),0,2,3,nativeBufferAt(storage,52),u32(1000)) != 7 ||
        esp32C5I2cRecoverGuardedOwned(gate,u32(7),0,2,3,scratch,u32(0)) != 7 ||
        calls != 0 || gate.word().compareExchange(u32(0),u32(0)) != u32(0x80000000)) return i32(2)
    i32(0)
}
