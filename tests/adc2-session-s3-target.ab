import "../src/esp32/adc2_session_esp32s3.ab"
import "../src/m5stack/battery_adc2_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc2_session_s3_target")
trusted fun target(op: int,token: int,channel: int,calibration: int): int {
    val session=Esp32S3Adc2Session(token)
    val cal=Esp32S3AdcCalibration(calibration)
    if (op == 0) return esp32S3Adc2SessionOpenOwned(channel,cal,true,true,true,0,80000000).bits()
    if (op == 1) return session.startAfterSettlingOwned().bits()
    if (op == 2) return session.pollOwned(100000).bits()
    if (op == 3) return session.closeOwned(100000).bits()
    if (op == 4) return m5BoardAirQ.openBatteryAdc2S3Owned(cal,true,true,true,0,80000000).bits()
    if (op == 5) return session.batteryMillivoltsAdc2S3(m5BoardAirQ,cal)
    return session.millivolts(cal)
}
