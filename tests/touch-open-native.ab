import "../src/touch/controller_open_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var allocation=true
var began=true
var released=true
var trace=0
var expectedKind=1
var expectedBus=17
var bad=false
fun touchControllerAllocate(bus: int,kind: int,address: int,frequency: int): int {
    if (bus != expectedBus || kind != expectedKind || frequency != 400000 ||
        address != (if (kind == 1) 56 else if (kind == 2) 93 else if (kind == 3) 46 else 85)) bad=true
    trace=trace*10+1
    if (allocation) 123 else 0
}
fun touchControllerBegin(kind: int,handle: int): bool {
    if (kind != expectedKind || handle != 123) bad=true
    trace=trace*10+2
    began
}
fun touchControllerRelease(kind: int,handle: int): bool {
    if (kind != expectedKind || handle != 123) bad=true
    trace=trace*10+3
    released
}
@export("abla_touch_open_test")
fun testOpen(): i32 {
    var kind=1
    while (kind <= 6) {
        expectedKind=kind
        var profile=0
        while (profile < 8) {
            allocation=(profile&1) != 0
            began=(profile&2) != 0
            released=(profile&4) != 0
            trace=0
            val owner=touchControllerOpenOwned(17,kind,if (kind == 1) 56 else if (kind == 2) 93 else if (kind == 3) 46 else 85,400000)
            val expected=if (!allocation) 2 else if (began) 1 else if (released) 3 else 4
            if (bad || owner.status() != expected || owner.kind() != kind ||
                owner.ready() != (expected == 1) || owner.handle() != (if (expected == 1 || expected == 4) 123 else 0) ||
                trace != (if (!allocation) 1 else if (began) 12 else 123)) return i32(1)
            trace=0
            released=false
            val retry=owner.closeOwned()
            if (owner.handle() != 0 && (retry.status() != 4 || retry.handle() != 123 || trace != 3)) return i32(2)
            if (owner.handle() == 0 && (retry != 0 || trace != 0)) return i32(3)
            released=true
            if (retry.closeOwned() != 0) return i32(4)
            profile=profile+1
        }
        kind=if (kind == 3) 6 else kind+1
    }
    trace=0
    if (touchControllerOpenOwned(0,1,56,400000) != 0 || touchControllerOpenOwned(17,4,56,400000) != 0 ||
        touchControllerOpenOwned(17,2,56,400000) != 0 || touchControllerOpenOwned(17,1,56,0) != 0 ||
        touchControllerOpenOwned(17,1,56,400001) != 0 || trace != 0) return i32(5)
    expectedBus=0x1fffffffe;expectedKind=2;allocation=true;began=true;released=true
    val wide=touchControllerOpenOwned(expectedBus,2,93,400000)
    if (!wide.ready() || bad || wide.closeOwned() != 0 || touchControllerOpenOwned(0x200000000,2,93,400000) != 0) return i32(6)
    i32(0)
}
