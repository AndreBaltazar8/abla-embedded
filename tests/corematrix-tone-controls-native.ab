import "./corematrix-tone-wire-native.ab"
import "../src/m5stack/corematrix_tone_controls.ab"
@export("abla_corematrix_tone_controls_test")
trusted fun testToneControls(): i32 {
    wireSeed()
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    val tone=m5CoreMatrixToneAt(nativeBufferAt(ownedToneMemory,56));val r=nativeBufferAt(registers,512)
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1 || !tone.initializeFresh()) return i32(1)
    r.storeU16(37,1000)
    if (tone.playOwned(control,2000,64,100,100,false,true) != 1) return i32(2)
    val before=ackCount
    if (tone.playOwned(control,3000,128,120,10,false,true) != 7 || tone.playOwned(control,0,128,120,10,true,true) != 2 || tone.setVolumeOwned(256,true) != 2 || ackCount != before || tone.tone().loadU32(12) != 200) return i32(3)
    var volume=1
    while (volume <= 255) {
        if (tone.setVolumeOwned(volume,true) != 1 || r.loadU16(31) != (32768|((volume*2048+127)/255)) || r.loadU16(37) != 2000 || (r.load(5)&2) == 0 || tone.tone().loadU32(12) != 200 || bad) return i32(4)
        volume=volume+1
    }
    if (tone.playOwned(control,3000,128,150,100,true,true) != 1 || r.loadU16(37) != 3000 || tone.tone().loadU32(24) != 1000 || tone.tone().loadU32(12) != 250 || tone.setVolumeOwned(0,true) != 0 || control.toneRetained() || r.loadU16(37) != 1000) return i32(5)
    var failure=1
    while (failure <= 16) {
        var commit=0
        while (commit < 2) {
            nackAt=0;nackAfterCommit=commit == 1
            if (tone.playOwned(control,2000,64,0,100,false,true) != 1) return i32(6)
            val start=ackCount;nackAt=start+failure
            if (tone.setVolumeOwned(128,true) != 5 || ackCount != nackAt || !control.toneRetained() || control.closeOwned(true) || tone.tone().loadU32(12) != 100 || bad) return i32(7)
            val primary=tone.buffer().loadU32(48);nackAt=0
            if (!tone.closeOwned(true) || tone.buffer().loadU32(48) != primary || r.loadU16(37) != 1000 || r.loadU16(31) != 0 || (r.load(5)&2) != 0) return i32(8)
            commit=commit+1
        }
        failure=failure+1
    }
    if (tone.playOwned(control,2000,64,0,100,false,true) != 1) return i32(9)
    nackAt=ackCount+1
    if (tone.playOwned(control,3000,128,10,100,true,true) != 6 || !control.toneRetained() || tone.status() != 6 || r.loadU16(37) != 1000) return i32(10)
    nackAt=0;nackAfterCommit=false
    if (tone.playOwned(control,3000,128,20,100,true,true) != 1 || r.loadU16(37) != 3000 || tone.playOwned(control,3000,0,20,100,false,true) != 0 || !control.closeOwned(true) || pads != 0 || bad) return i32(11)
    return i32(0)
}
