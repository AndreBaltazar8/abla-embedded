import "../src/m5stack/button_source_io_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_button_source_test")
trusted fun buttonSourceTargetTest(boardId: int, deviceHandle: int, kind: i32): int {
    val board = M5BoardId(boardId)
    val source = board.buttonASource()
    var result = m5ButtonRead(false)
    if (kind == i32(0)) result = source.readGpio()
    if (kind == i32(1)) result = source.readPi4(Pi4Ioe5v6408(deviceHandle))
    if (kind == i32(2)) result = source.readM5Pm1(M5Pm1(deviceHandle))
    if (kind == i32(3)) result = source.readDevice(I2cDevice(deviceHandle))
    if (!result.valid()) return -1
    if (result.pressed()) 1 else 0
}
