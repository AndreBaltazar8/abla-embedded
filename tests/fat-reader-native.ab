import "../src/storage/fat_software_sd.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
trusted fun Pin.write(value: bool): void { return }
trusted fun Pin.read(): bool = false
fun peripheralDelayMicroseconds(value: int): void { return }
val storage=nativeStaticAllocate(28)
val gateStorage=nativeStaticMutableU32s([0])
@export("abla_fat_reader_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(storage,28)
    val gate=peripheralGateAt(gateStorage)
    val card=SoftwareSdInitResult(196609)
    if (!fatSoftwareSdReaderInitialize(reader,gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),card,4294967296)) return i32(1)
    if (fatBootU32(reader,0) != gateStorage || fatBootU32(reader,4) != 7 || fatBootU32(reader,8) != 0x04030201 ||
        fatBootU32(reader,12) != 196609 || fatBootU32(reader,16) != 2 || fatBootU32(reader,20) != 0 || fatBootU32(reader,24) != 1) return i32(2)
    if (fatSoftwareSdReaderInitialize(reader,gate,u32(0),Pin(1),Pin(2),Pin(3),Pin(4),card,1) ||
        fatSoftwareSdReaderInitialize(reader,gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),SoftwareSdInitResult(65537),1) ||
        fatSoftwareSdReaderInitialize(reader,gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),SoftwareSdInitResult(1),8388609) ||
        fatSoftwareSdReaderInitialize(reader,gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(3),card,1) ||
        fatSoftwareSdReaderInitialize(reader,gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),card,1,65536)) return i32(3)
    if (fatBootU32(reader,24) != 1 || fatBootU32(reader,4) != 7) return i32(4)
    if (fatSoftwareSdReaderInitialize(nativeBufferAt(gateStorage,28),gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),card,1) ||
        fatSoftwareSdReaderInitialize(nativeBufferAt(storage,27),gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),card,1)) return i32(5)
    if (!fatSoftwareSdReaderInitialize(reader,gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),SoftwareSdInitResult(1),8388608)) return i32(6)
    return i32(0)
}
