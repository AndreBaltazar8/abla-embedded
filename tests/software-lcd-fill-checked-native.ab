import "../src/display/software_rgb565_checked.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
var gateAddress = 0
var selected = false
var dataMode = true
var outputHigh = false
var bitCount = 0
var byteIndex = 0
var byteValue = 0
var selections = 0
var activity = 0
var bad = false
var shared = false
var driven = true
fun expectedByte(index: int): int {
    if (index == 0) return 42
    if (index == 2) return 2
    if (index == 4) return 3
    if (index == 5) return 43
    if (index == 7) return 4
    if (index == 9) return 5
    if (index == 10) return 44
    if (index >= 11 && (index & 1) == 1) return 248
    0
}
trusted fun Pin.write(high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateAddress, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) dataMode = high
    if (this == 3) {
        if (shared && !driven) bad = true
        if (!high) {
            if (selected || dataMode) bad = true
            selections = selections + 1
        } else if (!selected || (byteIndex != 5 && byteIndex != 10 && byteIndex != 19)) bad = true
        selected = !high
    }
    if (this == 1 && high && selected) {
        byteValue = (byteValue << 1) | (if (outputHigh) 1 else 0)
        bitCount = bitCount + 1
        if (bitCount == 8) {
            if (byteValue != expectedByte(byteIndex) || dataMode != (byteIndex != 0 && byteIndex != 5 && byteIndex != 10)) bad = true
            bitCount = 0
            byteValue = 0
            byteIndex = byteIndex + 1
        }
    }
    return
}
fun Pin.read(): bool {
    bad = true
    false
}
var directionCalls=0
var failDirection=0
fun Pin.writeLevelOwned(high: bool): bool { bad=true;return false }
trusted fun Pin.outputLevelOwned(high: bool): bool {
    if (!shared || this != 4 || selected || high || nativeAddressLoadU32(gateAddress,0) != 7) bad=true
    driven=true;dataMode=high;directionCalls=directionCalls+1
    return directionCalls != failDirection
}
trusted fun Pin.inputOwned(): bool {
    if (!shared || this != 4 || selected || nativeAddressLoadU32(gateAddress,0) != 7) bad=true
    driven=false;directionCalls=directionCalls+1
    return directionCalls != failDirection
}
fun peripheralDelayMilliseconds(ms: int): void { bad=true;return }
fun peripheralDelayMicroseconds(duration: int): void {
    bad = true
    return
}
@export("abla_software_lcd_fill_checked_test")
trusted fun testFillChecked(): int {
    gateAddress = nativeStackAllocate(4)
    nativeAddressStoreU32(gateAddress, 0, 0)
    val gate = peripheralGateAt(gateAddress)
    val view = lcdViewValue(4, 4, 2, 3, 0)
    var variant = 0
    while (variant < 2) {
    shared = variant == 1
    driven = !shared
    byteIndex = 0
    selections = 0
    val result = softwareLcdFillRectChecked(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), view, -1, 1, 3, 2, rgb565Red, 0, shared)
    if (!result.valid() || bad || selected || driven != !shared || selections != 3 || byteIndex != 19 || nativeAddressLoadU32(gateAddress, 0) != 0) return 1
    variant = variant + 1
    }
    activity = 0
    if (!softwareLcdFillRectChecked(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), view, 5, 0, 1, 1, rgb565Red, 0).valid() || activity != 0) return 2
    val wide = clipDisplayRect(1, 1, 9223372036854775807, 9223372036854775807, 4, 4)
    if (wide.x() != 1 || wide.y() != 1 || wide.width() != 3 || wide.height() != 3) return 3
    if (!clipDisplayRect(-9223372036854775807, 0, 9223372036854775807, 1, 4, 4).empty()) return 4
    var failure=1
    while (failure <= 6) {
        nativeAddressStoreU32(gateAddress,0,0)
        selected=false;dataMode=true;outputHigh=false;bitCount=0;byteIndex=0;byteValue=0;selections=0;activity=0;bad=false
        shared=true;driven=false;directionCalls=0;failDirection=failure
        val outcome=softwareLcdFillRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),view,-1,1,3,2,rgb565Red,0,true)
        val expected=if (failure == 1) 0 else if (failure <= 3) 5 else if (failure <= 5) 10 else 19
        if (outcome.status() != 6 || int(outcome.value()) != (if ((failure&1) == 1) 1 else 4) ||
            byteIndex != expected || selected || driven || bad || nativeAddressLoadU32(gateAddress,0) != 0x80000000) return 5
        failure=failure+1
    }
    0
}
