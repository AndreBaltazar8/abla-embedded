import "../src/esp32/syscall_frame_s3.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_syscall_frame_test")
trusted fun syscallFrameTest(): i32 {
    val allocation=nativeStaticAllocate(208)
    val address=(allocation+15) & ~15
    val frame=nativeBufferAt(address,192)
    var profile=0
    while (profile < 256) {
        var offset=0
        while (offset < 192) { frame.storeU32(offset,0xABC00000+offset+profile); offset=offset+4 }
        val pc=if ((profile & 32) != 0) 0xFFFFFFFE else 0x42001000+profile*4
        val next=(pc+3) & 0xFFFFFFFF
        val end=if ((profile & 1) != 0) next else (next+4) & 0xFFFFFFFF
        val count=if ((profile & 2) != 0) 0 else if ((profile & 64) != 0) 0xFFFFFFFF else 5
        val number=if ((profile & 4) != 0) 0 else if ((profile & 16) != 0) 0xFFFFFFFF else 37
        val cause=if ((profile & 8) != 0) 1 else 9
        val begin=0x42000020
        frame.storeU32(4,pc); frame.storeU32(20,number); frame.storeU32(80,cause)
        frame.storeU32(88,begin); frame.storeU32(92,end); frame.storeU32(96,count)
        if (esp32S3SyscallFrameOwned(frame) != (cause == 1)) return i32(1)
        val looping=cause == 1 && next == end && count != 0
        offset=0
        while (offset < 192) {
            var expected=0xABC00000+offset+profile
            if (offset == 4) expected=if (cause != 1) pc else if (looping) begin else next
            if (offset == 20) expected=if (cause == 1 && number != 0) 0xFFFFFFFF else number
            if (offset == 80) expected=cause
            if (offset == 88) expected=begin
            if (offset == 92) expected=end
            if (offset == 96) expected=if (looping) count-1 else count
            if (frame.loadU32(offset) != expected) return i32(2)
            offset=offset+4
        }
        if (esp32S3SyscallFrameOwned(nativeBufferAt(address,191)) || esp32S3SyscallFrameOwned(nativeBufferAt(address+4,192))) return i32(3)
        profile=profile+1
    }
    i32(0)
}
