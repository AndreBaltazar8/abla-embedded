import "../src/esp32/mspi_dummy_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(68)
var target=0
var writes=0
var failAt=0
var bad=false
var ready=13
var clock=0x603
fun index(address: int): int = if (address == 0x6000201c) 0 else if (address == 0x60002018) 1 else if (address == 0x600020d4) 2 else
    if (address == 0x6000301c) 3 else if (address == 0x60003018) 4 else if (address == 0x600030d4) 5 else if (address == 0x60002040) 6 else -1
trusted fun value(i: int): int = nativeBufferAt(memory+40,28).loadU32(i*4)
trusted fun c5MspiRead(address: int): int {
    if (address == 0x60096018) return ready
    if (address == 0x6009601c) return clock
    val i=index(address)
    if (i < 0 || (target < 2 && i/3 != target) || (target >= 2 && i != 6)) { bad=true;return 0 }
    value(i)
}
trusted fun c5MspiWrite(address: int,bits: int): void {
    val i=index(address)
    if (i < 0 || (target < 2 && i/3 != target) || (target >= 2 && i != 6)) { bad=true;return }
    writes=writes+1
    if (writes != failAt) nativeBufferAt(memory+40,28).storeU32(i*4,bits)
    return
}
@export("abla_mspi_dummy_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,40);val regs=nativeBufferAt(memory+40,28)
    target=0
    while (target < 4) {
        var length=0
        while (length < 64) {
            var flags=0
            while (flags < (if (target < 2) 4 else 2)) {
                var scenario=0
                while (scenario < 14) {
                    var i=0;while (i < 7) { regs.storeU32(i*4,0xa5a5a5a5);i=i+1 }
                    record.storeU32(0,0);writes=0;failAt=scenario%7;bad=false
                    val enabled=(flags&1) != 0;val variableDummy=(flags&2) != 0
                    val first=esp32C5MspiDummyOwned(record,target,length,enabled,variableDummy,true)
                    if (first != 1 && first != 3 || bad) return i32(1)
                    if (scenario < 7) {
                        failAt=0
                        if (esp32C5MspiDummyOwned(record,target,length,enabled,variableDummy,true) != 1) return i32(2)
                        val raw=if (target < 2) value(target*3) else value(6)
                        val shift=if (target < 2) 0 else if (target == 2) 6 else 22
                        if (((raw>>>shift)&63) != length) return i32(3)
                        val en=if (target < 2) (value(target*3+1)>>>29)&1 else (value(6) >>> (if (target == 2) 4 else 3))&1
                        if (en != (flags&1) || (target < 2 && ((value(target*3+2)>>>1)&1) != ((flags>>>1)&1))) return i32(4)
                        failAt=writes+(scenario%7)
                    }
                    i=0;while (i < 7) { regs.storeU32(i*4,value(i)^0x80000000);i=i+1 }
                    val closed=esp32C5MspiDummyCloseOwned(record,true)
                    if (closed != 3 && closed != 4) return i32(5)
                    failAt=0
                    if (esp32C5MspiDummyCloseOwned(record,true) != 4 || bad) return i32(6)
                    i=0;while (i < 7) { if (value(i) != 0x25a5a5a5) return i32(7);i=i+1 }
                    val count=writes
                    if (esp32C5MspiDummyCloseOwned(record,true) != 4 || writes != count ||
                        esp32C5MspiDummyOwned(record,target,length,enabled,variableDummy,true) != 2) return i32(8)
                    scenario=scenario+1
                }
                flags=flags+1
            }
            length=length+1
        }
        target=target+1
    }
    record.storeU32(0,0);writes=0;target=0
    if (esp32C5MspiDummyOwned(record,4,0,false,false,true) != 2 || esp32C5MspiDummyOwned(record,0,64,false,false,true) != 2 ||
        esp32C5MspiDummyOwned(record,2,0,true,true,true) != 2 || esp32C5MspiDummyOwned(record,0,0,true,false,false) != 2 || writes != 0) return i32(9)
    ready=11
    if (esp32C5MspiDummyOwned(record,0,0,false,false,true) != 2 || record.loadU32(0) != 0) return i32(10)
    ready=13;clock=0x703
    if (esp32C5MspiDummyOwned(record,0,0,false,false,true) != 2 || writes != 0) return i32(11)
    return i32(0)
}
