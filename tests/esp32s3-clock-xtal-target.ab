import "../src/esp32/clock_xtal_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_clock_xtal_target")
@section(".iram1.abla.s3ClockTarget")
trusted fun clockXtalTarget(rtcBias: int,digitalBias: int,disablePll: bool): int =
    esp32S3ClockToXtalOwned(rtcBias,digitalBias,disablePll) | 0
