import "./it8951-image-native.ab"
import "../src/display/it8951_power.ab"
@export("abla_it8951_power_test")
trusted fun testPower(): i32 {
    val scratch=nativeBufferAt(memory+256,14)
    var mode=0
    while (mode < 2) {
        resetTrace();failWord=0;busyStatus=0
        val low=it8951EnterLowPower(7,mode == 1,scratch,3,3,true)
        if (!low.success() || low.stage() != 8 || words != 9 || sent(7) != 24576 ||
            sent(8) != mode+2 || selected || bad) return i32(1)
        failWord=1
        while (failWord <= 9) {
            resetTrace()
            val failed=it8951EnterLowPower(7,mode == 1,scratch,3,3,true)
            if (failed.status() != 4 || failed.stage() != (if (failWord <= 7) 7 else 8) ||
                words != failWord || selected || bad) return i32(2)
            failWord=failWord+1
        }
        failWord=0;busyStatus=1;idleOnly=true;resetTrace()
        val busy=it8951EnterLowPower(7,mode == 1,scratch,3,3,true)
        if (busy.status() != 7 || busy.stage() != 7 || words != 21 || delays != 2 || selected || bad) return i32(3)
        busyStatus=65535;resetTrace()
        val fault=it8951EnterLowPower(7,mode == 1,scratch,3,3,true)
        if (fault.status() != 6 || words != 7 || selected || bad) return i32(4)
        idleOnly=false;mode=mode+1
    }
    busyStatus=0;resetTrace()
    if (!it8951ResumeStandby(7,3,true).success() || words != 2 || sent(0) != 24576 || sent(1) != 1 || selected || bad) return i32(5)
    failWord=1
    while (failWord <= 2) {
        resetTrace()
        if (it8951ResumeStandby(7,3,true).status() != 4 || words != failWord || selected || bad) return i32(6)
        failWord=failWord+1
    }
    failWord=0;resetTrace()
    if (it8951EnterLowPower(7,true,scratch,3,3,false).status() != 2 ||
        it8951EnterLowPower(7,true,nativeBufferAt(memory,1),3,3,true).status() != 2 ||
        it8951EnterLowPower(7,true,scratch,3,0,true).status() != 2 ||
        it8951ResumeStandby(7,3,false).status() != 2 || words != 0 || selected || bad) return i32(7)
    i32(0)
}
