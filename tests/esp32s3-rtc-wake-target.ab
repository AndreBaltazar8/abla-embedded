import "../src/esp32/rtc_wake_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_wake_target")
trusted fun rtcWakeTarget(pin: int, level: int, operation: int): int {
    if (operation == 0) return if (esp32S3PrepareExt0Owned(pin,level)) 1 else 0
    if (operation == 1) return if (esp32S3PrepareExt1Owned(pin,level,true)) 1 else 0
    if (operation == 2) return if (esp32S3ReleaseRtcHoldsOwned(pin)) 1 else 0
    if (operation == 3) return if (esp32S3RtcAlarmAfterOwned(pin,level)) 1 else 0
    if (operation == 4) return esp32S3RtcCyclesOwned()
    if (operation == 5) return if (esp32S3SleepDomainsPrepareOwned(esp32S3SleepPolicy(pin))) 1 else 0
    if (operation == 6) return esp32S3SleepPolicy(pin) | 0
    if (operation == 7) return if (esp32S3SleepInitOwned(esp32S3SleepPolicy(pin))) 1 else 0
    if (operation == 8) return if (esp32S3SleepRegistersPrepareOwned(pin,level)) 1 else 0
    esp32S3Ext1LatchedPins()
}
