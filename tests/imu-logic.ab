import "../src/imu/types_logic.ab"
import "../src/imu/mpu6886_logic.ab"
import "../src/imu/bmm150_logic.ab"
import "../src/imu/bmi270_logic.ab"
import "../src/imu/bmi270_config.ab"

fun main: int {
    val big = imuAxesBigEndianBytes(127, 255, 128, 0, 255, 255)
    val little = imuAxesLittleEndianBytes(52, 18, 204, 237, 0, 128)
    val magnetic = bmm150DecodeMagneticField(
        imuAxes(-4, 8, -2)
    )
    val packed = big.valid() && big.x() == 32767 && big.y() == -32768 &&
        big.z() == -1 && little.valid() && little.x() == 4660 &&
        little.y() == -4660 && little.z() == -32768
    val decoded = magnetic.valid() && magnetic.x() == -1 &&
        magnetic.y() == 2 && magnetic.z() == -2
    val identity = mpu6886IdentityValid(25) &&
        mpu6886IdentityValid(104) && mpu6886IdentityValid(113) &&
        !mpu6886IdentityValid(24) && bmi270IdentityValid(36) &&
        !bmi270IdentityValid(35) && bmi270Configuration.size == 8192 &&
        bmi270Configuration[0] == 200 &&
        bmi270Configuration[8191] == 193
    val sample = imuSample(65535)
    if (packed && decoded && identity && sample.valid() &&
        sample.raw() == -1 && !invalidImuAxes().valid()) 49 else 1
}
