import "../src/input/capacitive_filter.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_capacitive_filter_test")
fun filterTest(): i32 {
    var previous=0
    while (previous <= 65535) {
        var sample=0
        while (sample <= 65535) {
            // Independent integer oracle, avoiding overflow at uint32 limits.
            val expected=if (previous == 0) sample else (previous+1)/2+sample/2
            if (int(capacitiveIirHalf(u32(previous),u32(sample))) != expected) return i32(1)
            var mode=0
            while (mode < 4) {
                val wasActive=(mode&1)!=0
                val below=(mode&2)!=0
                var delta=-1
                while (delta <= 1) {
                    val threshold=expected+delta
                    val state=CapacitiveTouchFilter(previous|(if (wasActive) 65536 else 0)|393216)
                    val result=state.update(sample,threshold,below)
                    if (threshold >= 0 && threshold <= 65535) {
                        val active=if (below) expected < threshold else expected >= threshold
                        if (!result.accepted() || result.value() != expected || result.active() != active || result.justActivated() != (active && !wasActive) || result.justDeactivated() != (!active && wasActive)) return i32(2)
                        val rejected=result.update(-1,threshold,below)
                        if (rejected.accepted() || rejected.justActivated() || rejected.justDeactivated() || rejected.value() != result.value() || rejected.active() != active) return i32(3)
                    } else if (result.accepted() || result.justActivated() || result.justDeactivated()) return i32(4)
                    delta=delta+1
                }
                mode=mode+1
            }
            // Bound run time: all previous16-bit values against key raw values.
            sample=if (sample == 0) 1 else if (sample == 1) 32767 else if (sample == 32767) 32768 else if (sample == 32768) 65534 else if (sample == 65534) 65535 else 65536
        }
        previous=previous+1
    }
    if (capacitiveIirHalf(u32(0xFFFFFFFF),u32(0xFFFFFFFF)) != u32(0xFFFFFFFF) || capacitiveIirHalf(u32(0),u32(0xFFFFFFFF)) != u32(0xFFFFFFFF) ||
        capacitiveIirHalf(u32(0xFFFFFFFF),u32(0)) != u32(0x80000000)) return i32(5)
    i32(0)
}
