import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/storage/fat_software_sd.ab"
import "../src/storage/fat_chain.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_chain_target")
trusted fun target(reader: int,boot: int,first: int,sectors: int,start: int,budget: int,scratch: int): int =
    fatChainValidateOwned(nativeBufferAt(reader,28),nativeBufferAt(boot,512),first,sectors,start,budget,nativeBufferAt(scratch,1024)).clusterCount()
