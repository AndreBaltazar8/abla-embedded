import "../src/esp32/adc_fuse_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc_fuse_test")
fun fuseTest(): i32 {
    val empty=esp32AdcCalibrationFromWords(0,0,0)
    if (empty.source(0) != 0 || empty.source(1100) != 3 || empty.millivolts(1,0,12,100,0) != -1) return i32(1)
    var code=1
    while (code <= 31) {
        val fuse=esp32AdcCalibrationFromWords(0,code<<8,0)
        if (fuse.source(1100) != 2 || fuse.vref() != esp32AdcVrefFromFuse(code) || fuse.millivolts(2,3,12,3500,1100) != esp32AdcVrefMillivolts(2,3,12,3500,fuse.vref())) return i32(2)
        code=code+1
    }
    code=1
    while (code <= 511) {
        val low=if (code < 128) code else 1
        val word=low|(code<<7)|(low<<16)|(code<<23)
        val fuse=esp32AdcCalibrationFromWords(16384,256,word)
        if (!fuse.hasTwoPoint() || fuse.source(1100) != 1) return i32(3)
        if (fuse.lowPoint(1) != 278+(if (low >= 64) low-128 else low)*4 || fuse.lowPoint(2) != 421+(if (low >= 64) low-128 else low)*4) return i32(4)
        if (fuse.highPoint(1) != 3265+(if (code >= 256) code-512 else code)*4 || fuse.highPoint(2) != 3406+(if (code >= 256) code-512 else code)*4) return i32(5)
        code=code+1
    }
    val all=1|(1<<7)|(1<<16)|(1<<23)
    if (esp32AdcCalibrationFromWords(0,0,all).hasTwoPoint()) return i32(6)
    if (esp32AdcCalibrationFromWords(16384,0,all&4294967168).hasTwoPoint() || esp32AdcCalibrationFromWords(16384,0,all&4294901887).hasTwoPoint() || esp32AdcCalibrationFromWords(16384,0,all&4286644223).hasTwoPoint() || esp32AdcCalibrationFromWords(16384,0,all&8388607).hasTwoPoint()) return i32(7)
    val tp=esp32AdcCalibrationFromWords(16384,0,all)
    if (tp.millivolts(1,0,12,500,0) < 0 || tp.millivolts(1,3,12,3500,0) != -1 || tp.millivolts(1,3,12,3500,1100) < 0) return i32(8)
    if (tp.lowPoint(0) != -1 || tp.highPoint(3) != -1 || empty.lowPoint(1) != -1) return i32(9)
    return i32(0)
}
