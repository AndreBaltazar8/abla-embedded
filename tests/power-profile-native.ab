import "../src/m5stack/power_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_power_profile_test")
fun profileTest(): i32 {
    if (m5BoardStackCore2.powerKind() != m5PowerAxp192Or2101 ||
        m5BoardStackCoreS3.powerKind() != m5PowerAxp2101 || m5BoardStack.powerKind() != m5PowerIp5306 ||
        m5BoardCoreP4X.powerKind() != m5PowerM5Pm1 || m5BoardArduinoNessoN1.powerKind() != m5PowerAw32001 ||
        m5BoardAtomVoice.powerKind() != m5PowerUnknown) return i32(1)
    var id=0
    while (id <= 512) {
        val board=M5BoardId(id)
        val expectedPin=if (id == 19) 3 else if (id == 139) 6 else if (id == 15) 14 else
            if (id == 13 || id == 14 || id == 24) 10 else if (id == 132 || id == 5) 38 else
            if (id == 6 || id == 7) 35 else -1
        if (board.batteryAdcPin() != expectedPin || board.batteryAdcUnit() !=
            (if (expectedPin < 0) 0 else if (id == 15) 2 else 1)) return i32(2)
        if ((board.powerKind() == m5PowerAdc) != (expectedPin >= 0)) return i32(3)
        if (board.batteryMillivoltsFromAdc(-1) != -1 || board.batteryMillivoltsFromAdc(65536) != -1) return i32(4)
        id=id+1
    }
    var mv=0
    while (mv <= 65535) {
        if (m5BoardTimerCam.batteryMillivoltsFromAdc(mv) != (mv*1513)/1000 ||
            m5BoardStackCoreInk.batteryMillivoltsFromAdc(mv) != (mv*251)/51 ||
            m5BoardPaper.batteryMillivoltsFromAdc(mv) != mv*2 ||
            m5BoardAtomVoice.batteryMillivoltsFromAdc(mv) != -1) return i32(5)
        mv=mv+1
    }
    i32(0)
}
