import "../src/i2c/results.ab"

fun main(): int {
    if (I2cByteResult(0).valid() || !I2cByteResult(256).valid() || I2cByteResult(256).value() != 0) return 1
    if (I2cByteResult(511).value() != 255) return 2
    if (I2cWordResult(0).valid() || !I2cWordResult(65536).valid()) return 3
    if (I2cWordResult(65536 | 32767).signedValue() != 32767) return 4
    if (I2cWordResult(65536 | 32768).signedValue() != -32768) return 5
    if (I2cWordResult(131071).signedValue() != -1) return 6
    if (I2cDwordResult(0).valid() || !I2cDwordResult(4294967296).valid()) return 7
    if (I2cDwordResult(8589934591).value() != 4294967295) return 8
    0
}
