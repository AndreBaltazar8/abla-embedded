import "../src/esp32/mspi_idle_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var spi0=0
var spi1=0
var gate=13
var source=0x603
var reads=0
var reads0=0
var reads1=0
var releaseAfter=0
var selected=3
var bad=false
trusted fun c5MspiRead(address: int): int {
    reads=reads+1
    if (address == 0x60096018) return gate
    if (address == 0x6009601c) return source
    if (address == 0x60002000) {
        if ((selected&1) == 0) bad=true
        reads0=reads0+1
        return if (releaseAfter != 0 && reads0 >= releaseAfter) 0 else spi0
    }
    if (address == 0x60003000) {
        if ((selected&2) == 0) bad=true
        reads1=reads1+1
        return if (releaseAfter != 0 && reads1 >= releaseAfter) 0 else spi1
    }
    bad=true;return 0
}
trusted fun c5MspiWrite(address: int,value: int): void { bad=true;return }
@export("abla_mspi_idle_c5_test")
trusted fun test(): i32 {
    selected=1
    while (selected <= 3) {
        var bit=0
        while (bit < 32) {
            var bank=0
            while (bank < 2) {
                spi0=if (bank == 0) int(u32(1)<<u32(bit)) else 0
                spi1=if (bank == 1) int(u32(1)<<u32(bit)) else 0
                reads0=0;reads1=0;releaseAfter=0
                val busy=if (bank == 0) (selected&1) != 0 && (bit < 8 || bit == 18) else (selected&2) != 0 && (bit < 8 || bit >= 17)
                if (esp32C5MspiWaitIdleOwned(selected,3,true) != (if (busy) 3 else 1) || bad) return i32(1)
                val rounds=if (busy) 3 else 1
                if (reads0 != (if ((selected&1) != 0) rounds else 0) || reads1 != (if ((selected&2) != 0) rounds else 0)) return i32(2)
                bank=bank+1
            }
            bit=bit+1
        }
        var end=1
        while (end <= 8) {
            spi0=1;spi1=0x80000000;releaseAfter=end;reads0=0;reads1=0
            if (esp32C5MspiWaitIdleOwned(selected,end,true) != 1 || bad) return i32(3)
            if (end > 1) {
                reads0=0;reads1=0
                if (esp32C5MspiWaitIdleOwned(selected,end-1,true) != 3) return i32(4)
                if (esp32C5MspiWaitIdleOwned(selected,1,true) != 1) return i32(5)
            }
            end=end+1
        }
        selected=selected+1
    }
    val before=reads
    if (esp32C5MspiWaitIdleOwned(3,1,false) != 2 || esp32C5MspiWaitIdleOwned(0,1,true) != 2 ||
        esp32C5MspiWaitIdleOwned(4,1,true) != 2 || esp32C5MspiWaitIdleOwned(3,0,true) != 2 ||
        esp32C5MspiWaitIdleOwned(3,1000001,true) != 2 || reads != before) return i32(6)
    selected=3;gate=9;reads0=0;reads1=0
    if (esp32C5MspiWaitIdleOwned(3,1,true) != 3 || reads0 != 0 || reads1 != 0) return i32(7)
    gate=13;source=0x503
    if (esp32C5MspiWaitIdleOwned(3,1,true) != 3 || reads0 != 0 || reads1 != 0 || bad) return i32(8)
    return i32(0)
}
