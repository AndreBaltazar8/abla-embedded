import "../src/i2c/device_slots.ab"

trusted fun main(): int {
    if (i2cDeviceSlotsBytes(0) != 0 || i2cDeviceSlotsBytes(257) != 0 || i2cDeviceSlotsBytes(256) != 3080) return 1
    val storage = nativeStackAllocate(32)
    val pool = i2cInitializeDeviceSlots(storage, 2)
    val first = pool.allocate(0x123456789abc)
    val second = pool.allocate(0x23456789abcd)
    if (first != 256 || second != 257 || pool.allocate(3) != 0) return 2
    if (pool.resolve(first) != 0x123456789abc || pool.resolve(second) != 0x23456789abcd) return 3
    if (!pool.release(first) || pool.release(first) || pool.resolve(first) != 0) return 4
    val next = pool.allocate(55)
    if (next != 512 || pool.resolve(first) != 0 || pool.resolve(next) != 55) return 5
    if (pool.release(first) || pool.resolve(next | (1 << 32)) != 0) return 6
    if (!pool.release(next) || !pool.release(second)) return 7
    // Retired generation must not wrap and resurrect an old handle.
    nativeAddressStoreU32(storage, 8, 16777215)
    if (pool.allocate(66) != 513 || pool.allocate(77) != 0) return 8
    val lock = atomicU32At(storage)
    if (!lock.tryClaim(u32(9))) return 9
    if (pool.allocate(88) != 0 || pool.resolve(513) != 0 || pool.release(513)) return 10
    if (!lock.releaseClaim(u32(9)) || pool.resolve(513) != 66) return 11
    if (i2cInitializeDeviceSlots(0, 2).address() != 0 ||
        i2cInitializeDeviceSlots(storage + 1, 2).address() != 0) return 12
    val invalid = i2cDeviceSlotsAt(0)
    if (invalid.allocate(1) != 0 || invalid.resolve(256) != 0 || invalid.release(256) ||
        invalid.releaseMatching(1, 1) != -1) return 13
    val storage2 = nativeStackAllocate(44)
    val pool2 = i2cInitializeDeviceSlots(storage2, 3)
    val a = pool2.allocate(0x123400000001)
    val b = pool2.allocate(0x123400000002)
    val c = pool2.allocate(0x567800000001)
    if (pool2.releaseMatching(0xffff00000000, 0x123400000000) != 2) return 14
    if (pool2.resolve(a) != 0 || pool2.resolve(b) != 0 || pool2.resolve(c) != 0x567800000001) return 15
    if (pool2.allocate(99) != 512 || pool2.resolve(a) != 0) return 16
    if (pool2.releaseMatching(0, 0) != -1 || pool2.releaseMatching(1, 2) != -1) return 17
    val lock2 = atomicU32At(storage2)
    if (!lock2.tryClaim(u32(9))) return 18
    if (pool2.releaseMatching(0xffff00000000, 0x567800000000) != -1) return 19
    if (!lock2.releaseClaim(u32(9)) || pool2.resolve(c) != 0x567800000001) return 20
    0
}
