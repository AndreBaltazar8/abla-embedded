import "../src/m5stack/expander_owner_sequence.ab"
import "../src/m5stack/expander_controls_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var allocFail=0
var beginFail=0
var closeFail=0
var live=0
var calls=0
var bad=false
var dual=false
var controlCalls=0
var lastControl=0
var controlFailure=false
fun control(handle: int,pin: int,m5: bool,code: int): bool {
    controlCalls=controlCalls+1
    if ((handle != 8 && handle != 9) || m5 == dual) bad=true
    lastControl=handle*100+pin*10+code
    !controlFailure
}
fun expanderPowerPull(handle: int,pin: int,enabled: bool): bool {
    if (!enabled) bad=true
    control(handle,pin,false,1)
}
fun expanderPowerDrive(handle: int,pin: int,m5: bool): bool = control(handle,pin,m5,2)
fun expanderPowerDirection(handle: int,pin: int,m5: bool): bool = control(handle,pin,m5,3)
fun expanderPowerLatch(handle: int,pin: int,m5: bool,enabled: bool): bool {
    if (!enabled) bad=true
    control(handle,pin,m5,4)
}
fun tabChargeLatch(handle: int,pin: int,enabled: bool): bool {
    controlCalls=controlCalls+1; lastControl=handle*100+pin
    if (handle != 9 || (pin != 7 && pin != 5) || enabled != (pin == 7)) bad=true
    !controlFailure
}
fun m5OutputReadByte(handle: int,register: int): I2cByteResult {
    controlCalls=controlCalls+1; lastControl=handle*100+register
    if (register != 5 || (handle != 8 && handle != 9)) bad=true
    if (controlFailure) I2cByteResult(0) else I2cByteResult(511)
}
fun m5OutputReadDword(handle: int,register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun m5ExpanderBusValid(bus: int): bool { calls=calls+1; return bus == 7 }
fun m5ExpanderAllocate(bus: int,address: int,frequency: int): int {
    calls=calls+1
    val index=if (address == 68) 1 else 0
    if (bus != 7 || address != (if (dual) 67+index else 79) || frequency != (if (dual) 400000 else 100000)) bad=true
    val bit=1<<index
    if ((allocFail & bit) != 0) return 0
    if ((live & bit) != 0) bad=true
    live=live|bit
    8+index
}
fun m5ExpanderBegin(handle: int,kind: int): bool {
    calls=calls+1
    if (handle < 8 || handle > 9 || kind != (if (dual) 1 else 2) || (live & (1<<(handle-8))) == 0) bad=true
    (beginFail & (1<<(handle-8))) == 0
}
fun m5ExpanderClose(handle: int): bool {
    calls=calls+1
    if (handle < 8 || handle > 9 || (live & (1<<(handle-8))) == 0) bad=true
    val bit=1<<(handle-8)
    if ((closeFail & bit) != 0) return false
    live=live & ~bit
    true
}
@export("abla_expander_owner_test")
trusted fun ownerTest(): i32 {
    val memory=nativeBufferAt(nativeStaticAllocate(32),32)
    val owner=m5ExpandersAt(memory)
    var profile=0
    while (profile < 192) {
        allocFail=profile & 3; beginFail=(profile>>>2)&3; closeFail=(profile>>>4)&3
        val variant=profile/64
        dual=variant < 2
        val board=if (variant == 0) m5BoardTab5 else if (variant == 1) m5BoardArduinoNessoN1 else m5BoardCoreMatrix
        live=0; calls=0; bad=false
        if (!owner.initialize()) return i32(1)
        val opened=owner.openOwned(7,board)
        var expectedLive=0; var expectedFailure=0
        if ((allocFail & 1) != 0) expectedFailure=4
        else if ((beginFail & 1) != 0) {
            expectedFailure=if ((closeFail & 1) != 0) 6 else 5
            expectedLive=if ((closeFail & 1) != 0) 1 else 0
        } else {
            expectedLive=1
            if (dual) {
                if ((allocFail & 2) != 0) expectedFailure=4
                else if ((beginFail & 2) != 0) {
                    expectedFailure=if ((closeFail & 2) != 0) 6 else 5
                    if ((closeFail & 2) != 0) expectedLive=expectedLive|2
                } else expectedLive=3
                if (expectedFailure != 0 && (closeFail & 1) == 0) expectedLive=expectedLive & ~1
            }
        }
        val expectedStatus=if (expectedFailure == 0) 1 else if (expectedLive != 0) 6 else expectedFailure
        if (opened != expectedStatus || owner.status() != expectedStatus || owner.openFailure() != expectedFailure || live != expectedLive || bad) return i32(2)
        val before=calls
        if (owner.openOwned(7,board) != -1 || calls != before) return i32(3)
        val closed=owner.closeOwned()
        expectedLive=expectedLive & closeFail
        if (closed != (expectedLive == 0) || live != expectedLive || bad) return i32(4)
        closeFail=0
        if (!owner.closeOwned() || live != 0 || owner.status() != 0 || bad) return i32(5)
        val finalCalls=calls
        if (!owner.closeOwned() || calls != finalCalls) return i32(6)
        profile=profile+1
    }
    var scenario=0
    while (scenario < 10) {
        val variant=scenario%5
        val board=if (variant == 0) m5BoardTab5 else if (variant == 1) m5BoardTab5X else
            if (variant == 2) m5BoardArduinoNessoN1 else if (variant == 3) m5BoardCoreP4X else m5BoardCoreMatrix
        dual=variant < 3; allocFail=0; beginFail=0; closeFail=0; live=0; bad=false
        controlFailure=scenario >= 5
        if (!owner.initialize() || owner.openOwned(7,board) != 1 || !owner.ready()) return i32(8)
        controlCalls=0
        val ports=if (variant == 1) 289 else if (variant == 0 || variant == 3) 33 else 1
        val result=owner.setExternalOutputOwned(ports,true)
        val firstFailure=if (variant < 2) 5 else if (variant == 2) 8 else 6
        val count=if (variant == 0) 4 else if (variant == 1) 7 else if (variant == 2) 1 else if (variant == 3) 6 else 3
        if (result.status() != (if (controlFailure) firstFailure else 1) || controlCalls != (if (controlFailure) 1 else count) || bad) return i32(9)
        // M5IOE1 gpio2/gpio5 labels map to zero-based pins1/4.
        if (!controlFailure && (result.appliedPorts() != ports || lastControl != (if (variant < 2) 934 else if (variant == 2) 924 else if (variant == 3) 814 else 844))) return i32(10)
        controlCalls=0
        val read=owner.externalOutputCheckedOwned()
        if (read.valid() == controlFailure || controlCalls != 1 || lastControl != (if (variant == 2) 905 else 805) || bad) return i32(11)
        controlCalls=0
        val usb=owner.usbOutputCheckedOwned()
        val supported=variant < 2 || variant == 3
        if (usb.valid() != (supported && !controlFailure) || controlCalls != (if (supported) 1 else 0) || bad) return i32(12)
        if (supported && lastControl != (if (variant < 2) 905 else 805)) return i32(13)
        controlCalls=0
        val charge=owner.setChargeCurrentOwned(1000)
        if (charge.status() != (if (variant >= 2) 2 else if (controlFailure) 5 else 1) ||
            controlCalls != (if (variant >= 2) 0 else if (controlFailure) 1 else 2) || bad) return i32(14)
        controlCalls=0
        val enabled=owner.setBatteryChargeOwned(true)
        if (enabled.status() != (if (variant >= 2) 2 else if (controlFailure) 5 else 1) ||
            controlCalls != (if (variant >= 2) 0 else 1) || bad) return i32(15)
        owner.buffer().storeU32(4,6); controlCalls=0
        if (owner.setExternalOutputOwned(ports,true).status() != 3 || owner.setChargeCurrentOwned(500).status() != 3 ||
            owner.setBatteryChargeOwned(true).status() != 3 || owner.externalOutputCheckedOwned().valid() ||
            owner.usbOutputCheckedOwned().valid() || controlCalls != 0) return i32(16)
        owner.buffer().storeU32(4,1)
        val first=owner.slot(0)
        owner.storeSlot(0,M5ExpanderOpen(first | (1<<34)))
        if (owner.ready()) return i32(17)
        owner.storeSlot(0,first)
        if (!owner.closeOwned() || live != 0 || bad) return i32(18)
        scenario=scenario+1
    }
    calls=0
    if (m5ExpandersAt(nativeBufferAt(memory.addressValue(),31)).initialize() || M5Expanders(0).closeOwned() || calls != 0) return i32(7)
    i32(0)
}
