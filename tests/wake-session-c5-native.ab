import "../src/esp32/power/wake_session_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(40)
var pmu=0
fun c5LpGpioClockLoad(address: int): int = if (address == 0x600b2800) 0x08000000 else if (address == 0x600b2804) 0 else 1
fun c5LpGpioClockStore(address: int,value: int): void { bad=true;return }
var ext=0
var level=1
var fallOnArm=false
var pin=4
var mux=0
var hp=0
var lp=0
var route=0
var hold=0
var writes=0
var failAt=0
var bad=false
fun c5WakeLoad(address: int): int {
    if (address == 0x600b102c) return hold
    if (address == 0x600b4000+pin*4) return mux
    if (address == 0x60091034) return hp
    if (address == 0x600b4410) return lp
    if (address == 0x600b1028) return route
    if (address == 0x600b441c) return level<<pin
    bad=true;return 0
}
fun c5WakeStore(address: int,value: int): void {
    if ((pmu&2) != 0) bad=true
    writes=writes+1
    if (writes == failAt) return
    if (address == 0x6009103c) hp=hp&~value
    else if (address == 0x600b4418) lp=lp&~value
    else if (address == 0x60091038) hp=hp|value
    else if (address == 0x600b4414) lp=lp|value
    else if (address == 0x600b4000+pin*4) mux=value
    else if (address == 0x600b1028) route=value
    else bad=true
    return
}
fun c5WakeTriggerRead(): int = pmu
fun c5WakeTriggerWrite(value: int): void {
    writes=writes+1
    if (writes != failAt) pmu=value
    if (fallOnArm && (value&2) != 0) level=0
    return
}
fun c5Ext1Read(): int = ext
fun c5Ext1Write(value: int): void {
    writes=writes+1
    if ((value&16384) != 0 && (pmu&2) != 0) bad=true
    if (writes != failAt) ext=(if ((value&16384) != 0) 0 else ext&255)|(value&0xffffbf00)
    return
}
@export("abla_wake_session_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,40)
    var fault=0
    while (fault < 20) {
        record.storeU32(0,0);mux=0xdeadbeef;hp=255;lp=255;route=0;hold=0
        pmu=0x4002;ext=0xa5aa3fab;writes=0;failAt=fault;bad=false;level=1;fallOnArm=false
        val opened=esp32C5WakeSessionOpenOwned(record,4,true)
        if (opened != 1 && opened != 4) return i32(1)
        if (opened == 1 && ((pmu&2) == 0 || (ext&0x7f8000) != (16<<15))) return i32(2)
        if (opened == 1 && (esp32C5WakeSessionPreviousStatus(record) != 171 || (ext&255) != 0)) return i32(10)
        // Fault position spans initialization and teardown. Explicit close
        // retries after removing the injected fault; no lost child snapshots.
        var closed=esp32C5WakeSessionCloseOwned(record)
        if (closed != 5 && closed != 4) return i32(3)
        failAt=0
        closed=esp32C5WakeSessionCloseOwned(record)
        if (closed != 5 || mux != 0xdeadbeef || hp != 255 || lp != 255 || route != 0 ||
            pmu != 0x4002 || (ext&0xffffff00) != 0xa5aa3f00 || bad) return i32(4)
        fault=fault+1
    }
    record.storeU32(0,0);writes=0;failAt=0;level=0;bad=false
    if (esp32C5WakeSessionOpenOwned(record,4,true) != 2 || (pmu&2) != 0) return i32(5)
    val before=writes
    if (esp32C5WakeSessionOpenOwned(record,4,true) != 3 || writes != before) return i32(6)
    level=1;fallOnArm=true
    if (esp32C5WakeSessionArmOwned(record) != 2 || (pmu&2) != 0) return i32(7)
    fallOnArm=false;level=1
    if (esp32C5WakeSessionArmOwned(record) != 1 || (pmu&2) == 0) return i32(8)
    ext=ext|16
    level=0
    if (esp32C5WakeSessionArmOwned(record) != 2 || (pmu&2) != 0 ||
        esp32C5WakeSessionCloseOwned(record) != 5 || bad || (ext&255) != 16) return i32(9)
    return i32(0)
}
