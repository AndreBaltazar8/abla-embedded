import "./m5-buzzer-pcm-c6-native.ab"
import "../src/m5stack/buzzer_stream_c6_sequence.ab"
trusted fun streamBank(address: int): PcmSourceQueues {
    val sources=pcmSourceQueuesAt(nativeBufferAt(address,32),1,48000)
    val tone=pcmToneAt(nativeBufferAt(address+32,32),48000,731000,4294967295,12000)
    sources.enqueue(pcmPlaybackTone(tone),0);return sources
}
@export("abla_m5_buzzer_stream_c6_test")
trusted fun streamTest(): i32 {
    val memory=nativeStaticAllocate(8192)
    registers=nativeBufferAt(memory,1536)
    val board=nativeBufferAt(memory+1536,640)
    val setup=nativeBufferAt(board.addressValue()+112,172)
    descriptors=nativeBufferAt(0x40800000,24)
    payload=nativeBufferAt(0x40810000,128)
    pcm=nativeBufferAt(memory+2304,64)
    val acc=nativeBufferAt(memory+2560,128);val scratch=nativeBufferAt(memory+2688,64)
    val mono=nativeBufferAt(memory+2752,32);val staging=nativeBufferAt(memory+2816,64)
    val referenceOutput=nativeBufferAt(memory+2880,64)
    var kind=0
    while (kind < 2) {
        channel=0
        while (channel < 3) {
            var mode=0
            while (mode < 9) {
                clear(board);initialize(setup);clear(descriptors);drop=0;dataOnly=true;streamMode=true
                dmaResets=0;i2sResets=0;descriptorDrop=false;deassertDrop=false;stopDrop=false
                wireFrames=0;wireBits=0;chargeRemainder=0
                original(0x60096070,0x3000)
                original(0x600960e8,0);original(0x600960ec,0x300000);original(0x6009162c,0)
                val sources=streamBank(memory+3008);val reference=streamBank(memory+3072)
                val id=if (kind == 0) m5BoardArduinoNessoN1 else m5BoardUnitC6L
                if (mode >= 7) delayed=true
                if (mode == 5) drop=1
                if (mode == 5) {
                    if (id.openC6BuzzerStreamOwned(board,sources,channel,1,240000000,48000,0,0x40800000,2,0x40810000,64,64,1,true,true) != 3 || starts != 0 ||
                        c6BuzzerStreamCloseOwned(board,1,true) != 6 || board.loadU32(8) == 0 || bad) return i32(39)
                } else {
                if (id.openC6BuzzerStreamOwned(board,sources,channel,1,240000000,48000,0,0x40800000,2,0x40810000,64,64,1,true,true) != 5 || starts != 0 || bad) return i32(20)
                if (mode >= 7) {
                    val pendingWrites=writes;val phase=sources.queue(0).storage().loadU32(12)
                    var retry=0
                    while (retry < 3) {
                        if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(255),1,1,true) != 5 || writes != pendingWrites || starts != 0 ||
                            sources.queue(0).storage().loadU32(12) != phase || board.loadU32(452) != 0) return i32(43)
                        retry=retry+1
                    }
                    if (mode == 8 && (c6BuzzerStreamCancelOwned(board,2,1,0,false,true) != 5 || starts != 0)) return i32(44)
                    delayed=false
                }
                if (mode == 1 || mode == 8) {
                    // Cancellation before prefill must never publish descriptors.
                    if (c6BuzzerStreamCancelOwned(board,2,1,0,false,true) != 8 || starts != 0 || stops != 0) return i32(21)
                } else {
                    if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(255),1,1,true) != 5 || starts != 0) return i32(22)
                    if (mode == 4) {
                        if (c6BuzzerStreamCancelOwned(board,2,1,0,false,true) != 8 || starts != 0 || board.loadU32(464) != 1) return i32(40)
                    } else {
                    if (mode == 7) {
                        delayed=true
                        if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(255),1,1,true) != 5 || starts != 0 || board.loadU32(464) != 2) return i32(45)
                        val pendingWrites=writes;val tonePhase=nativeBufferAt(memory+3040,32).loadU32(12)
                        var retry=0
                        while (retry < 3) {
                            if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(0),1,1,true) != 5 || writes != pendingWrites ||
                                nativeBufferAt(memory+3040,32).loadU32(12) != tonePhase || starts != 0) return i32(46)
                            retry=retry+1
                        }
                        delayed=false
                    }
                    if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(255),1,1,true) != 1 || starts != 1 || bad) return i32(23)
                    if (c6BuzzerStreamCloseOwned(board,1,true) != 2) return i32(24)
                    if (mode == 2) {
                        setRegister(0x60080030+channel*16,u32(4))
                        if (c6BuzzerStreamCancelOwned(board,2,1,0,false,true) != 10 || c6BuzzerStreamCancelOwned(board,2,1,4,false,true) != 9 ||
                            c6BuzzerStreamCancelOwned(board,2,1,4,true,true) != 8 || starts != 1 || stops != 1) return i32(25)
                    } else {
                        var refState=BuzzerDeltaSigma(0);var block=0
                        // Compare all prefills/refills in playback order to one
                        // continuous source and encode oracle before OWNER release.
                        while (block < 8) {
                            val index=block%2
                            if (!reference.renderOutput(16,acc,scratch,mono,false,32768)) return i32(26)
                            refState=refState.encodePcm16Stereo16(mono,referenceOutput,16)
                            var at=0
                            while (at < 64) { if (payload.loadU32(index*64+at) != referenceOutput.loadU32(at)) return i32(27);at=at+4 }
                            descriptors.storeU32(index*12,descriptors.loadU32(index*12)&0x7fffffff)
                            if (block < 7) {
                                if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(255),2,1,true) != 1 || bad) return i32(28)
                            } else if (c6BuzzerStreamEndOwned(board,acc,scratch,mono,staging,PcmVolume(255),true) != 5 || board.loadU32(4) != 4) return i32(29)
                            block=block+1
                        }
                        if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(255),2,1,true) != 5 || bad) return i32(30)
                        // Remaining descriptor0 then final descriptor1, now NULL.
                        if (descriptors.loadU32(20) != 0) return i32(31)
                        block=0
                        while (block < 2) {
                            if (!reference.renderOutput(16,acc,scratch,mono,false,32768)) return i32(32)
                            refState=refState.encodePcm16Stereo16(mono,referenceOutput,16)
                            var at=0
                            while (at < 64) { if (payload.loadU32(block*64+at) != referenceOutput.loadU32(at)) return i32(33);at=at+4 }
                            descriptors.storeU32(block*12,descriptors.loadU32(block*12)&0x7fffffff);block=block+1
                        }
                        setRegister(0x60080030+channel*16,u32(11));setRegister(0x6000c06c,u32(0))
                        if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(255),2,1,true) != 5 || stops != 0) return i32(34)
                        if (mode == 6) {
                            setRegister(0x6000c06c,u32(1));stopDrop=true
                            if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(255),2,1,true) != 5 || stops != 0) return i32(41)
                            stopDrop=false
                            if (c6BuzzerStreamCancelOwned(board,2,1,0,true,true) != 5 || stops != 0 ||
                                c6BuzzerStreamRetryStopOwned(board,1,true) != 1 || c6BuzzerStreamCancelOwned(board,2,1,0,true,true) != 8 || stops != 1) return i32(42)
                        } else if (mode == 3) {
                            setRegister(0x6000c06c,u32(1))
                            if (c6BuzzerStreamCancelOwned(board,2,1,0,true,true) != 8 || stops != 1) return i32(35)
                        } else {
                            setRegister(0x6000c06c,u32(1))
                            if (c6BuzzerStreamAdvanceOwned(board,acc,scratch,mono,staging,PcmVolume(255),2,1,true) != 4 ||
                                c6BuzzerStreamCloseOwned(board,1,true) != 6 || stops != 1 || board.loadU32(608) != 1) return i32(36)
                        }
                    }
                    }
                }
                }
                if (bad) return i32(37)
                var index=0
                while (index < entries) {
                    if (registers.loadU32(index*12+4) != registers.loadU32(index*12+8)) return i32(38)
                    index=index+1
                }
                mode=mode+1
            }
            channel=channel+1
        }
        kind=kind+1
    }
    streamMode=false;return i32(0)
}
