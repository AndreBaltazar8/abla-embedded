import "../src/esp32/psram/clock_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val clockStorage=nativeStaticAllocate(16)
var clockWrites=0
var clockReads=0
var clockFail=0
var clockBusy=0
var clockBad=false
fun clockSlot(address: int): int = if (address == 0x600030ec) 0 else if (address == 0x60003014) 1 else if (address == 0x60002014) 2 else if (address == 0x60003050) 3 else -1
fun s3PsramCsRead(address: int): int {
    clockReads=clockReads+1
    if (address == 0x60002000) return if (clockBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (clockBusy == 2) 0x80000000 else 0
    val slot=clockSlot(address)
    if (slot < 0) { clockBad=true;return 0 }
    return nativeAddressLoadU32(clockStorage,slot*4)
}
fun s3PsramCsWrite(address: int,value: int): void {
    val slot=clockSlot(address)
    if (slot != clockWrites || slot < 0) { clockBad=true;return }
    val expected=if (slot == 0) nativeAddressLoadU32(clockStorage,0)&0xfffffffc else (3*65536+256+3)
    if (value != expected) clockBad=true
    clockWrites=clockWrites+1
    nativeAddressStoreU32(clockStorage,slot*4,if (clockWrites == clockFail) value^1 else value)
    return
}
@export("abla_s3_psram_clock_test")
fun testPsramClock(): int {
    var profile=0
    while (profile < 256) {
        clockFail=0
        while (clockFail <= 4) {
            var i=0
            while (i < 4) { nativeAddressStoreU32(clockStorage,i*4,((profile*16777217)^0xa55a5aa5)^i);i=i+1 }
            val initial=nativeAddressLoadU32(clockStorage,0)
            clockWrites=0;clockReads=0;clockBusy=0;clockBad=false
            if (s3PsramLowClockOwned(true,true) != (if (clockFail == 0) 1 else 4) ||
                clockWrites != (if (clockFail == 0) 4 else clockFail) || clockBad) return 1
            if (clockFail == 0 && nativeAddressLoadU32(clockStorage,0) != (initial&0xfffffffc)) return 2
            clockFail=clockFail+1
        }
        profile=profile+1
    }
    clockWrites=0;clockReads=0
    if (s3PsramLowClockOwned(false,true) != 2 || s3PsramLowClockOwned(true,false) != 2 || clockReads != 0) return 3
    clockBusy=1
    if (s3PsramLowClockOwned(true,true) != 3 || clockWrites != 0) return 4
    clockBusy=2
    if (s3PsramLowClockOwned(true,true) != 3 || clockWrites != 0) return 5
    return 0
}
