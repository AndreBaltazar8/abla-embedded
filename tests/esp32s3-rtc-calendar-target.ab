import "../src/rtc/calendar.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_calendar_test")
fun rtcCalendarTarget(seconds: int): int {
    val value=rtcDateTimeFromUnixSeconds(seconds)
    if (!value.valid()) return rtcInvalidUnixSeconds
    rtcCalendarDateTime(value.year(),value.month(),value.day(),value.hour(),value.minute(),value.second()).unixSeconds()
}
