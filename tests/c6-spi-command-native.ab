import "../src/spi/software_command.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
import "../src/esp32/gpio_pin_c6_sequence.ab"
import "../src/m5stack/display_map.ab"
val storage = nativeStaticAllocate(68)
var bits = 0
var totalBits = 24
var mode = 0
var selected = false
var dataMode = true
var dataHigh = false
var bad = false
var activity = 0
trusted fun c6GpioWrite(address: int,value: u32): void {
    if (address != 0x60091008 && address != 0x6009100c) bad=true
    val high=address == 0x60091008
    val pinNumber=if (value == u32(1<<20)) 1 else if (value == u32(1<<21)) 2 else if (value == u32(1<<17)) 4 else if (value == u32(1<<16)) 5 else -1
    if (pinNumber < 0) bad=true
    activity = activity + 1
    if (nativeAddressLoadU32(storage, 0) != 7) bad = true
    if (pinNumber == 2) dataHigh = high
    if (pinNumber == 5) dataMode = high
    if (pinNumber == 4) {
        if (!high && (selected || bits != 0 || dataMode)) bad = true
        if (high && (!selected || bits != totalBits || !dataMode)) bad = true
        selected = !high
    }
    val idle = (mode & 2) != 0
    val sampleClock = if ((mode & 1) != 0) idle else !idle
    if (pinNumber == 1 && selected && high == sampleClock) {
        val byte = if (bits < 8) 44 else ((((bits>>>3)-1)*17+3)&255)
        if (bits >= totalBits || dataMode != (bits >= 8) || dataHigh != ((byte & (1 << (7 - (bits & 7)))) != 0)) bad = true
        bits = bits + 1
    }
    return
}
fun c6GpioRead(address: int): u32 { bad=true;return u32(0) }
fun peripheralDelayMicroseconds(duration: int): void {
    bad = true
    return
}
@export("abla_c6_spi_command_test")
trusted fun commandNativeTest(): i32 {
    if (storage <= 0 || storage > 4294967288) return i32(10)
    nativeAddressStoreU32(storage,0,0)
    var at=0;while (at < 64) { nativeAddressStoreU8(storage,4+at,(at*17+3)&255);at=at+1 }
    val board=m5BoardArduinoNessoN1;val pins=board.displaySpiPins();val geometry=board.displayGeometry()
    if (pins.clock() != 20 || pins.mosi() != 21 || pins.miso() != 22 || pins.chipSelect() != 17 || pins.dataCommand() != 16 || pins.reset() != -1 || pins.backlight() != -1 || board.displayController() != m5DisplayControllerSt7789 || geometry.width() != 135 || geometry.height() != 240 || geometry.offsetX() != 52 || geometry.offsetY() != 40 || !board.displayInverted()) return i32(11)
    val data = nativeBufferAt(storage + 4, 64)
    while (mode < 4) {
        var length = 0
        while (length <= 64) {
            bits = 0
            totalBits = 8 + length * 8
            bad = false
            val result = softwareSpiCommand(peripheralGateAt(storage), u32(7), Pin(20), Pin(21), Pin(17), Pin(16), 44, data, length, mode, 0)
            if (!result.valid() || bad || selected || bits != totalBits || nativeAddressLoadU32(storage, 0) != 0) return i32(1)
            length = length + 1
        }
        mode = mode + 1
    }
    activity = 0
    if (softwareSpiCommand(peripheralGateAt(storage), u32(7), Pin(20), Pin(21), Pin(17), Pin(16), 256, data, 2).status() != 3 || activity != 0) return i32(2)
    i32(0)
}
