import "../src/esp32/peer_binding_s3_sequence.ab"
import "abla/build"
val bindingMemory=nativeStaticAllocate(68)
val bindingTable=nativeStaticAllocate(512)
val bindingMailbox=nativeStaticAllocate(4)
var core=0
var channel=0
var enabled=0
var map0=0
var map1=0
var signal=0
var dropMap=false
var dropSignal=false
var dropEnable=false
var bad=false
fun esp32S3InterruptInstallCore(): int = core
fun esp32S3InterruptInstallEnabled(): int = enabled
fun esp32S3PeerHandlerAddress(): int = 0x40378000
fun esp32S3InterruptInstallRead(address: int): int = nativeAddressLoadU32(address,0)
fun esp32S3InterruptInstallWrite(address: int,value: int): void { nativeAddressStoreU32(address,0,value);return }
fun esp32S3PeerHandlerRead(address: int): int = nativeAddressLoadU32(address,0)
fun esp32S3PeerHandlerWrite(address: int,value: int): void { nativeAddressStoreU32(address,0,value);return }
fun xtensaPeerParkCas(address: int,expected: int,replacement: int): int {
    if (address != bindingMailbox) bad=true
    val old=nativeAddressLoadU32(address,0)
    if (old == expected) nativeAddressStoreU32(address,0,replacement)
    return old
}
fun esp32S3IntercoreRead(address: int): int {
    if (address == 0x600C0030+channel*4) return signal
    if (address == 0x600C213C+channel*4) return map0
    if (address == 0x600C293C+channel*4) return map1
    bad=true;return 0
}
fun esp32S3IntercoreUpdate(address: int,mask: int,value: int): void {
    val next=(esp32S3IntercoreRead(address)&(~mask))|(value&mask)
    if (address == 0x600C0030+channel*4) { if (!dropSignal) signal=next }
    else if (!dropMap) { if (address == 0x600C213C+channel*4) map0=next else map1=next }
    return
}
fun esp32S3PeerBindingEnable(line: int,on: bool): bool {
    if (on && (nativeAddressLoadU32(bindingTable,3*16+core*8) != 0x40378000 ||
        (if (core == 0) map0&31 else map1&31) != 3)) bad=true
    if (dropEnable) return false
    enabled=if (on) enabled|(1<<line) else enabled&(~(1<<line))
    return true
}
@export("abla_peer_binding_s3_test")
fun testBinding(): int {
    val r=nativeBufferAt(bindingMemory,68);val table=nativeBufferAt(bindingTable,512);val mailbox=nativeBufferAt(bindingMailbox,4)
    var profile=0
    while (profile < 48) {
        core=profile&1;channel=(profile>>>1)%4;val fault=profile/8
        val entry=3*16+core*8
        r.storeU32(0,0);r.storeU32(64,0x12345678);mailbox.storeU32(0,0)
        table.storeU32(entry,0x40379900);table.storeU32(entry+4,1234)
        enabled=1<<7;map0=0xABCD0011;map1=0xEF120012;signal=0x80
        dropMap=fault == 1;dropEnable=fault == 2;dropSignal=false;bad=false
        val opened=esp32S3PeerBindingOpenOwned(r,table,mailbox,channel,3,true)
        if (opened != (if (fault == 1 || fault == 2) 2 else 1) || bad) return 1
        if (opened == 1 && enabled != ((1<<7)|8)) return 2
        dropMap=false;dropEnable=false
        if (fault == 3) {
            mailbox.storeU32(0,10)
            if (esp32S3PeerBindingCloseOwned(r,true) != 2 || enabled != ((1<<7)|8)) return 3
            mailbox.storeU32(0,13);signal=0x81
            dropSignal=true
        }
        if (fault == 4) dropMap=true
        if (fault == 5) dropEnable=true
        if (fault >= 3) {
            if (esp32S3PeerBindingCloseOwned(r,true) != 2 || r.loadU32(4) != 2) return 4
            dropSignal=false;dropMap=false;dropEnable=false
        }
        core=core^1
        if (esp32S3PeerBindingCloseOwned(r,true) != 3) return 5
        core=core^1
        if (esp32S3PeerBindingCloseOwned(r,false) != 3 || esp32S3PeerBindingCloseOwned(r,true) != 4) return 6
        if (enabled != (1<<7) || map0 != 0xABCD0011 || map1 != 0xEF120012 || signal != 0x80 ||
            table.loadU32(entry) != 0x40379900 || table.loadU32(entry+4) != 1234 || r.loadU32(64) != 0x12345678 || bad) return 7
        if (esp32S3PeerBindingCloseOwned(r,true) != 4) return 8
        r.storeU32(0,0)
        if (esp32S3PeerBindingOpenOwned(r,table,nativeBufferAt(bindingMemory+12,4),channel,3,true) != 3 || r.loadU32(0) != 0) return 9
        profile=profile+1
    }
    return 0
}
