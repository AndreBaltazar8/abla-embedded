import "../src/sd/cid.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(16)
trusted fun finishCid(cid: NativeBuffer): void {
    var crc=0;var i=0
    while (i < 15) { crc=sdSpiCrc7Byte(crc,cid.load(i));i=i+1 }
    cid.store(15,(crc<<1)|1);return
}
@export("abla_sd_cid_test")
trusted fun testCid(): i32 {
    val cid=nativeBufferAt(memory,16)
    var i=0;while (i < 16) { cid.store(i,255);i=i+1 }
    var date=0
    while (date < 4096) {
        cid.store(13,240|(date>>>8));cid.store(14,date);finishCid(cid)
        val month=date&15;val valid=month >= 1 && month <= 12
        if (sdCidManufacturingMonth(cid) != (if (valid) month else -1) || sdCidManufacturingYear(cid) != (if (valid) 2000+(date>>>4) else -1)) return i32(1)
        if (sdCidManufacturer(cid) != 255 || sdCidOem(cid) != 65535 || sdCidRevision(cid) != 255 || sdCidSerial(cid) != 4294967295) return i32(2)
        date=date+1
    }
    i=0;while (i < 15) { cid.store(i,i*17);i=i+1 };finishCid(cid)
    if (sdCidManufacturer(cid) != 0 || sdCidOem(cid) != 4386 || sdCidSerial(cid) != 2578103244 || sdCidRevision(cid) != 136) return i32(3)
    i=0;while (i < 5) { if (sdCidProductByte(cid,i) != (i+3)*17) return i32(4);i=i+1 }
    var bit=0
    while (bit < 128) {
        val offset=bit/8;val original=cid.load(offset);cid.store(offset,original^(1<<(bit%8)))
        if (sdCidManufacturer(cid) != -1 || sdCidOem(cid) != -1 || sdCidProductByte(cid,0) != -1 || sdCidRevision(cid) != -1 || sdCidSerial(cid) != -1 || sdCidManufacturingYear(cid) != -1 || sdCidManufacturingMonth(cid) != -1) return i32(5)
        cid.store(offset,original);bit=bit+1
    }
    if (sdCidProductByte(cid,-1) != -1 || sdCidProductByte(cid,5) != -1 || sdCidSerial(nativeBufferAt(memory,15)) != -1 || sdCidManufacturer(NativeBuffer(0)) != -1) return i32(6)
    return i32(0)
}
