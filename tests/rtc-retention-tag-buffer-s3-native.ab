import "../src/esp32/rtc_retention_tag_buffer_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var size=0
var writes=0
var bad=false
fun esp32S3TagBufferWrite(address: int,value: int): void {
    if (writes < size/4) {
        if (address != 4096+writes*4 || value != 0) bad=true
    } else if (writes == size/4) {
        if (address != 4100 || value != 4112) bad=true
    } else if (writes == size/4+1) {
        val blocks=(size-16)/16
        if (address != 4096 || value != (0xC0000000 | blocks | (blocks<<12))) bad=true
    } else bad=true
    writes=writes+1; return
}
@export("abla_rtc_retention_tag_buffer_test")
trusted fun tagBufferTest(): i32 {
    var profile=0
    while (profile < 4096) {
        val data=(profile & 1) != 0
        val large=(profile & 2) != 0
        val cache=if (data) (if (large) 65536 else 32768) else (if (large) 32768 else 16384)
        val ways=if ((profile & 4) != 0) 8 else 4
        val line=if ((profile & 8) != 0) 32 else 16
        val small=(profile & 16) != 0
        val bytes=((profile>>>5) & 127)*127
        val address=0x3C000000+((profile>>>5) & 127)*17
        val p=esp32S3TagPlan(data,cache,ways,line,address,bytes,small)
        val valid=!(large && line == 16) && (!small || (data && !large))
        if (p.valid() != valid) return i32(1)
        if (valid) {
            val sets=cache/ways/line
            val groups=ways/4
            val limit=if (data) 511 else 255
            val total=(sets*groups) & limit
            val aligned=((bytes+line-1)/line)*line
            val count=if (!(data && small) && aligned < cache/ways) (aligned/line)*groups else total
            val blocks=(((if (count != 0) count else sets*groups)+3)/4)*4
            if (p.start() != (address/line)%sets || p.validBlocks() != count || p.sizeBlocks() != total || p.bufferBytes() != blocks*12 || p.enabled() != (bytes != 0 || (data && small))) return i32(2)
            var allocation=0
            while (allocation < 1024) {
                val altered=Esp32S3TagPlan((p & ~(1023<<30)) | (allocation<<30))
                if (altered.valid() != (allocation == blocks)) return i32(10)
                allocation=allocation+1
            }
        }
        profile=profile+1
    }
    val i=esp32S3TagPlan(false,32768,8,32,0x42000000,65536,false)
    val d=esp32S3TagPlan(true,32768,4,32,0x3C000000,0,true)
    size=esp32S3TagBufferBytes(i,d)
    if (size != 6160 || !d.enabled()) return i32(3)
    writes=0; bad=false
    if (!esp32S3TagBufferInitOwned(nativeBufferAt(4096,size),i,d) || bad || writes != size/4+2) return i32(4)
    var n=0
    while (n < size) {
        writes=0
        if (esp32S3TagBufferInitOwned(nativeBufferAt(4096,n),i,d) || writes != 0) return i32(5)
        n=n+1
    }
    if (esp32S3TagBufferBytes(d,i) != 0) return i32(6)
    if (esp32S3TagPlan(true,16384,4,32,0,0,true).valid()) return i32(7)
    if (esp32S3TagPlan(false,16384,4,32,0xFFFFFFFF,2,false).valid()) return i32(8)
    //64-byte D-cache lines and zero-length full-span allocation semantics.
    val wide=esp32S3TagPlan(true,65536,8,64,0,0,false)
    if (!wide.valid() || wide.enabled() || wide.bufferBytes() != 3072) return i32(9)
    var bit=41
    while (bit < 64) {
        val corrupt=Esp32S3TagPlan(d | (1<<bit))
        writes=0
        if (corrupt.valid() || esp32S3TagBufferBytes(i,corrupt) != 0 ||
            esp32S3TagBufferInitOwned(nativeBufferAt(4096,65536),i,corrupt) || writes != 0) return i32(11)
        bit=bit+1
    }
    val undersized=Esp32S3TagPlan(d & ~(1023<<30))
    writes=0
    if (esp32S3TagBufferInitOwned(nativeBufferAt(4096,65536),i,undersized) || writes != 0) return i32(12)
    if (Esp32S3TagPlan(i | (1<<40)).valid() || Esp32S3TagPlan(d & ~(1<<27)).valid() ||
        Esp32S3TagPlan(i | (1<<26)).valid()) return i32(13)
    i32(0)
}
