import "../src/esp32/revision_p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_revision_test")
fun testRevision(): i32 {
    var major=0
    while (major < 8) {
        var minor=0
        while (minor < 16) {
            val bits=((major&3)<<4)|((major>>>2)<<23)|minor
            val expected=major*100+minor
            if (esp32P4RevisionFromEfuse(u32(bits)) != expected ||
                esp32P4RevisionFromEfuse(u32(bits|0xff7fffc0)) != expected ||
                esp32P4RegisterLayout(expected) != (if (major < 3) 1 else if (major == 3) 3 else 0)) return i32(1)
            minor=minor+1
        }
        major=major+1
    }
    return i32(0)
}
