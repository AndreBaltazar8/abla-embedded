import "../src/m5stack/papercolor_microphone_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
type Es7210=int
fun Es7210.valid(): bool = this == 1
var stage=0
var fail=0
var enabled=false
var bad=false
fun Pin.outputLevelOwned(high: bool): bool {
    if (this != 45 || !high || stage != 0) bad=true
    stage=1
    return fail != 1
}
fun peripheralDelayMilliseconds(ms: int): void {
    if (ms != 50 || stage != 1) bad=true
    stage=2
    return
}
fun Es7210.configureMic1(): bool {
    if (this != 1 || !enabled || stage != 2) bad=true
    stage=3
    return fail != 3
}
fun Es7210.reset(): bool {
    if (this != 1 || enabled || stage != 2) bad=true
    stage=3
    return fail != 3
}
@export("abla_papercolor_microphone_test")
fun test(): i32 {
    var mode=0
    while (mode < 2) {
        enabled=mode == 1
        fail=0
        while (fail <= 3) {
            stage=0
            val result=paperColorMicrophoneOwned(Es7210(1),enabled,true)
            if (bad || result != (if (fail == 1) 3 else if (fail == 3) 4 else 1) || stage != (if (fail == 1) 1 else 3)) return i32(1)
            fail=fail+1
        }
        stage=0
        if (paperColorMicrophoneOwned(Es7210(0),enabled,true) != 2 || paperColorMicrophoneOwned(Es7210(1),enabled,false) != 2 || stage != 0) return i32(2)
        mode=mode+1
    }
    return i32(0)
}
