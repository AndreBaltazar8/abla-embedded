import "../src/m5stack/papercolor_microphone_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/hal/delay.ab"
import "../src/hal/pin.ab"
import "../src/hal/m5stack_3.ab"
import "../src/audio/es7210_type.ab"
import "../src/hal/es7210.ab"
@exportLocal("abla_es7210_valid")
fun es7210ValidHook(recv: int): bool = Es7210(recv) == 1
var stage=0
var fail=0
var enabled=false
var bad=false
@exportLocal("abla_pin_outputLevelOwned")
fun pinOutputLevelOwnedHook(pin: int, high: bool): bool {
    if (Pin(pin) != 45 || !high || stage != 0) bad=true
    stage=1
    return fail != 1
}
@export("peripheralDelayMilliseconds")
fun peripheralDelayMillisecondsHook(ms: int): void {
    if (ms != 50 || stage != 1) bad=true
    stage=2
    return
}
@exportLocal("abla_es7210_configureMic1")
fun es7210ConfigureMic1Hook(recv: int): bool {
    if (Es7210(recv) != 1 || !enabled || stage != 2) bad=true
    stage=3
    return fail != 3
}
@exportLocal("abla_es7210_reset")
fun es7210ResetHook(recv: int): bool {
    if (Es7210(recv) != 1 || enabled || stage != 2) bad=true
    stage=3
    return fail != 3
}
@export("abla_papercolor_microphone_test")
fun test(): i32 {
    var mode=0
    while (mode < 2) {
        enabled=mode == 1
        fail=0
        while (fail <= 3) {
            stage=0
            val result=paperColorMicrophoneOwned(Es7210(1),enabled,true)
            if (bad || result != (if (fail == 1) 3 else if (fail == 3) 4 else 1) || stage != (if (fail == 1) 1 else 3)) return i32(1)
            fail=fail+1
        }
        stage=0
        if (paperColorMicrophoneOwned(Es7210(0),enabled,true) != 2 || paperColorMicrophoneOwned(Es7210(1),enabled,false) != 2 || stage != 0) return i32(2)
        mode=mode+1
    }
    return i32(0)
}
