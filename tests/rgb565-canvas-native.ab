import "../src/display/rgb565_canvas.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(128)
@export("abla_rgb565_canvas_test")
trusted fun test(): i32 {
    val all=nativeBufferAt(storage,128)
    val canvas=nativeBufferAt(storage+4,116)
    var x=-2
    while (x < 10) {
        var y=-2
        while (y < 8) {
            var w=0
            while (w <= 10) {
                var h=0
                while (h <= 8) {
                    var n=0
                    while (n < 128) { all.store(n,0xa5);n=n+1 }
                    if (!rgb565CanvasFillOwned(canvas,8,6,20,x,y,w,h,Rgb565(0xf81f),true)) return i32(1)
                    val aligned=rgb565CanvasAlignedRegion(8,6,x,y,w,h)
                    var changed=0
                    n=0
                    while (n < 128) {
                        val offset=n-4
                        val row=offset/20;val col=(offset%20)/2
                        val inside=offset >= 0 && row < 6 && offset%20 < 16 && col >= x && col < x+w && row >= y && row < y+h
                        if (all.load(n) != (if (inside) (if ((offset&1) == 0) 0xf8 else 0x1f) else 0xa5)) return i32(2)
                        if (inside) {
                            changed=changed+1
                            if (aligned.empty() || col < aligned.x() || col >= aligned.x()+aligned.width() ||
                                row < aligned.y() || row >= aligned.y()+aligned.height()) return i32(3)
                        }
                        n=n+1
                    }
                    if ((changed == 0) != aligned.empty()) return i32(4)
                    if (!aligned.empty() && ((aligned.x()|aligned.y()|aligned.width()|aligned.height())&1) != 0) return i32(5)
                    h=h+1
                }
                w=w+1
            }
            y=y+1
        }
        x=x+1
    }
    var n=0
    while (n < 128) { all.store(n,0xa5);n=n+1 }
    if (rgb565CanvasFillOwned(canvas,8,6,20,0,0,8,6,Rgb565(0),false) ||
        rgb565CanvasFillOwned(canvas,8,6,15,0,0,8,6,Rgb565(0),true) ||
        rgb565CanvasFillOwned(nativeBufferAt(storage,115),8,6,20,0,0,8,6,Rgb565(0),true) ||
        !rgb565CanvasAlignedRegion(7,6,1,1,1,1).empty()) return i32(6)
    n=0
    while (n < 128) { if (all.load(n) != 0xa5) return i32(7);n=n+1 }
    val edge=rgb565CanvasAlignedRegion(468,468,467,467,1,1)
    if (edge.x() != 466 || edge.y() != 466 || edge.width() != 2 || edge.height() != 2) return i32(8)
    return i32(0)
}
