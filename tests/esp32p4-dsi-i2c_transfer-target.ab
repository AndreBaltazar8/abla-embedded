import "../src/esp32/i2c/software_transfer_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_i2c_transfer_target")
trusted fun target(tx: NativeBuffer,txLength: int,rx: NativeBuffer,rxLength: int,address: int): SoftwareI2cTransfer = esp32P4SoftwareI2cLines(31,32,5,2000).transfer(address,tx,txLength,rx,rxLength)
