import "../src/esp32/irq_dispatch_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val data=nativeStaticAllocate(272)
val frameData=nativeStaticAllocate(160)
var core=0
var masked=true
var enabled=false
var calls=0
var bad=false
var activeFences=0
fun p4DispatchCore(): int = core
fun p4DispatchMasked(): bool = masked
fun p4DispatchLineEnabled(line: int): bool = enabled
fun p4DispatchFence(): void {
    if (nativeBufferAt(data,272).loadU32(8) == 1) activeFences=activeFences+1
    return
}
trusted fun p4DispatchCall(handler: int,frame: int,line: int,cpu: int,context: int): void {
    calls=calls+1
    val table=p4IrqDispatchAt(nativeBufferAt(data,272))
    if (handler != 256 || context != line+100 || cpu != core || table.buffer().loadU32(8) != 1 || activeFences != calls*2-1 ||
        table.setOwned(line,256,0,0) != 3 || table.dispatchOwned(nativeBufferAt(frame,144),line,cpu) != 4) bad=true
    return
}
@export("abla_p4_irq_dispatch_test")
trusted fun testDispatch(): i32 {
    val table=p4IrqDispatchAt(nativeBufferAt(data,272))
    val frame=nativeBufferAt((frameData+15)&(-16),144)
    while (core < 2) {
        table.initialize(core)
        var line=16
        while (line < 48) {
            if (table.dispatchOwned(frame,line,core) != 3 || table.setOwned(line,0,256,line+100) != 1 ||
                table.setOwned(line,0,512,0) != 3 || table.dispatchOwned(frame,line,core) != 1 || bad || activeFences != calls*2) return i32(1)
            if (table.setOwned(line,256,0,0) != 1 || table.dispatchOwned(frame,line,core) != 3) return i32(2)
            line=line+1
        }
        core=core+1
    }
    core=1; enabled=true
    if (table.setOwned(16,0,256,0) != 3) return i32(3)
    enabled=false; masked=false
    if (table.setOwned(16,0,256,0) != 3 || table.dispatchOwned(frame,16,core) != 4) return i32(4)
    masked=true
    if (table.dispatchOwned(nativeBufferAt(data,144),16,core) != 2 || calls != 64) return i32(5)
    return i32(0)
}
