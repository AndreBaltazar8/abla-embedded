import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/storage/fat_software_sd.ab"
import "../src/storage/fat_file_read.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_file_read_target")
trusted fun target(reader: int,boot: int,first: int,sectors: int,file: int,offset: int,length: int,budget: int,destination: int,workspace: int): int =
    fatFileReadAtOwned(nativeBufferAt(reader,28),nativeBufferAt(boot,512),first,sectors,FatDirectoryEntry(file),offset,length,budget,nativeBufferAt(destination,512),nativeBufferAt(workspace,1536)).bytesRead()
