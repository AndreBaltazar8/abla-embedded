import "../src/esp32/adc_analog_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
import "abla/runtime/scalar"
val registers=nativeStaticAllocate(64)
val original=nativeStaticAllocate(64)
var writes=0
var reads=0
var drop=0
var bad=false
fun offset(address: int): int =
    if (address == 0x500e601c) 0 else if (address == 0x500e60a0) 4
    else if (address == 0x500e609c) 8 else if (address == 0x500e60b4) 12
    else if (address == 0x50120000) 16 else if (address == 0x500e60c8) 20
    else if (address == 0x500de000) 24 else if (address == 0x5012703c) 28
    else if (address == 0x500de004) 32 else if (address == 0x500de060) 36
    else if (address == 0x5012700c) 40 else if (address == 0x50127030) 44 else -1
trusted fun p4AdcRead(address: int): u32 {
    reads=reads+1
    val at=offset(address)
    if (at < 0) { bad=true;return u32(0) }
    return u32(nativeBufferAt(registers,64).loadU32(at))
}
trusted fun p4AdcWrite(address: int,value: u32): void {
    writes=writes+1
    val at=offset(address)
    if (at < 0) { bad=true;return }
    if (writes != drop) nativeBufferAt(registers,64).storeU32(at,int(value))
    return
}
trusted fun seed(flags: int,source: int): void {
    val r=nativeBufferAt(registers,64)
    var at=0
    while (at < 64) { r.storeU32(at,0);at=at+4 }
    r.storeU32(0,0xa55555c0|((flags&1)<<5))
    r.storeU32(4,0xfeccaa54|((flags>>1)&1))
    r.storeU32(8,0x3555aaaa|(source<<30))
    r.storeU32(12,0xaaac5678|(((flags>>2)&3)<<15))
    r.storeU32(16,0x7755aabb|(((flags>>4)&1)<<23))
    r.storeU32(24,0x81235547)
    r.storeU32(28,0xabcd1230)
    at=0
    while (at < 64) { nativeBufferAt(original,64).storeU32(at,r.loadU32(at));at=at+4 }
    writes=0;reads=0;drop=0;bad=false;return
}
trusted fun same(): bool {
    var at=0
    while (at < 64) {
        if (nativeBufferAt(original,64).loadU32(at) != nativeBufferAt(registers,64).loadU32(at)) return false
        at=at+4
    }
    return !bad
}
trusted fun powerSeed(unit: int,hp: int,lp: int,clock: int): void {
    seed(31,0)
    val r=nativeBufferAt(registers,64)
    val shift=if (unit == 1) 26 else 28
    val ls=if (unit == 1) 0 else 2
    r.storeU32(24,(r.loadU32(24)&(0xffffffff^((3<<shift)|32)))|(hp<<shift)|(clock<<5))
    r.storeU32(28,(r.loadU32(28)&(0xffffffff^(3<<ls)))|(lp<<ls))
    nativeBufferAt(original,64).storeU32(24,r.loadU32(24))
    nativeBufferAt(original,64).storeU32(28,r.loadU32(28))
    return
}

val bus=nativeStaticAllocate(64)
val chip=nativeStaticAllocate(256)
var commands=0
var timeoutCommand=0
var chipWrites=0
var dropChipWrite=0
var analogReady=true
trusted fun p4AnalogClockReady(): bool = analogReady
trusted fun p4AnalogRead(at: int): int = nativeBufferAt(bus,64).loadU32(at)
trusted fun p4AnalogWrite(at: int,value: int): void {
    val b=nativeBufferAt(bus,64)
    if (at != 0) { b.storeU32(at,value);return }
    commands=commands+1
    val index=(value>>>8)&255
    if ((value&255) != 0x69) { bad=true;return }
    if ((value&(1<<24)) != 0) {
        chipWrites=chipWrites+1
        if (chipWrites != dropChipWrite) nativeBufferAt(chip,256).store(index,(value>>>16)&255)
    }
    b.storeU32(0,(nativeBufferAt(chip,256).load(index)<<16)|(if (commands == timeoutCommand) 1<<25 else 0))
    return
}
trusted fun analogSeed(unit: int): void {
    powerSeed(unit,3,3,1)
    var at=0
    while (at < 256) { nativeBufferAt(chip,256).store(at,255);at=at+1 }
    at=0
    while (at < 64) { nativeBufferAt(bus,64).storeU32(at,0);at=at+4 }
    commands=0;timeoutCommand=0;chipWrites=0;dropChipWrite=0;analogReady=true;return
}
trusted fun chipRestored(): bool {
    var at=0
    while (at < 256) {
        if (nativeBufferAt(chip,256).load(at) != 255) return false
        at=at+1
    }
    return !bad
}
@export("abla_adc_analog_p4_test")
trusted fun analogTest(): i32 {
    var unit=1
    while (unit <= 2) {
        analogSeed(unit)
        var lease=esp32p4AdcAnalogOpenOwned(unit,2345,2,true)
        if (lease.status() != 1 || !lease.hasSnapshot() || chipWrites != 6 || commands != 24) return i32(1)
        val c=nativeBufferAt(chip,256)
        val shift=(unit-1)*3
        if (c.load(9) != 0xf0 || (c.load(2)&7) != 2 || ((c.load(2+shift)>>4)&7) != 4 ||
            (c.load(1+shift)&15) != 9 || c.load(shift) != 41 ||
            (c.load(7)&(if (unit == 1) 32 else 128)) != 0) return i32(2)
        val count=commands
        if (lease.closeOwned(2,false) != lease || commands != count) return i32(3)
        lease=lease.closeOwned(2,true)
        if (lease.status() != 5 || !chipRestored()) return i32(4)
        val closed=commands
        if (lease.closeOwned(2,true) != lease || commands != closed) return i32(5)
        var fault=1
        while (fault <= 24) {
            analogSeed(unit);timeoutCommand=fault
            val failed=esp32p4AdcAnalogOpenOwned(unit,2345,2,true)
            if (commands != fault || failed.detail() != 6) return i32(6)
            if (fault <= 6) {
                if (failed.status() != 3 || failed.hasSnapshot() || chipWrites != 0 || !chipRestored()) return i32(7)
            } else {
                if (failed.status() != 4 || !failed.hasSnapshot()) return i32(8)
                // Timeout may have already changed chip; prebusy close retains token.
                val pending=failed.closeOwned(2,true)
                if (pending.status() != 4 || pending.detail() != 4 || !pending.hasSnapshot() || commands != fault) return i32(9)
                nativeBufferAt(bus,64).storeU32(0,0)
                timeoutCommand=0
                if (pending.closeOwned(2,true).status() != 5 || !chipRestored()) return i32(10)
            }
            fault=fault+1
        }
        fault=1
        while (fault <= 18) {
            analogSeed(unit)
            val opened=esp32p4AdcAnalogOpenOwned(unit,2345,2,true)
            timeoutCommand=commands+fault
            var failed=opened.closeOwned(2,true)
            if (failed.status() != 4 || failed.detail() != 6 || !failed.hasSnapshot()) return i32(11)
            nativeBufferAt(bus,64).storeU32(0,0);timeoutCommand=0
            failed=failed.closeOwned(2,true)
            if (failed.status() != 5 || !chipRestored()) return i32(12)
            fault=fault+1
        }
        fault=1
        while (fault <= 6) {
            analogSeed(unit);dropChipWrite=fault
            val failed=esp32p4AdcAnalogOpenOwned(unit,2345,2,true)
            if (failed.status() != 4 || failed.detail() != 7 || !failed.hasSnapshot()) return i32(13)
            dropChipWrite=0
            if (failed.closeOwned(2,true).status() != 5 || !chipRestored()) return i32(14)
            fault=fault+1
        }
        analogSeed(unit)
        val opened=esp32p4AdcAnalogOpenOwned(unit,2345,2,true)
        nativeBufferAt(registers,64).storeU32(40,0x20000)
        val before=commands
        val busy=opened.closeOwned(2,true)
        if (busy.status() != 6 || !busy.hasSnapshot() || commands != before) return i32(15)
        nativeBufferAt(registers,64).storeU32(40,0)
        if (busy.closeOwned(2,true).status() != 5 || !chipRestored()) return i32(16)
        unit=unit+1
    }
    analogSeed(1)
    if (esp32p4AdcAnalogOpenOwned(0,0,1,true).status() != 2 ||
        esp32p4AdcAnalogOpenOwned(1,4096,1,true).status() != 2 ||
        esp32p4AdcAnalogOpenOwned(1,0,0,true).status() != 2 ||
        esp32p4AdcAnalogOpenOwned(1,0,1,false).status() != 2 || commands != 0) return i32(17)
    analogReady=false
    val unavailable=esp32p4AdcAnalogOpenOwned(1,0,1,true)
    if (unavailable.status() != 3 || unavailable.detail() != 3 || commands != 0) return i32(18)
    return i32(0)
}
