import "../src/display/dsi_shutdown_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var bridge=u32(17)
var dpi=u32(4097)
var mode=u32(16)
var stopped=false
var writes=0
var calls=0
var drop=0
var failure=0
var bad=false
fun p4DsiShutdownDma(channel: int,polls: int): int {
    calls=calls+1
    if (channel < 0 || channel > 3 || polls != 2) bad=true
    if (failure == 1) return 4
    stopped=true; return 1
}
fun p4DsiBridgeRead(offset: int): u32 {
    if (!stopped) bad=true
    if (offset == 4) return bridge
    if (offset == 64) return dpi
    bad=true; return u32(0)
}
fun p4DsiBridgeWrite(offset: int,value: u32): void {
    writes=writes+1
    if (!stopped) bad=true
    if (writes == drop) return
    if (offset == 64) dpi=value
    else if (offset == 68) { if (value != u32(1) || dpi != u32(4096)) bad=true }
    else if (offset == 4) { if (dpi != u32(4096)) bad=true; bridge=value }
    else bad=true
    return
}
fun p4DsiRead(offset: int): u32 { if (!stopped || offset != 52) bad=true; return mode }
fun p4DsiWrite(offset: int,value: u32): void {
    writes=writes+1
    if (!stopped || bridge != u32(16) || offset != 52) bad=true
    if (writes != drop) mode=value
    return
}
fun p4DsiShutdownPixelClock(): int {
    calls=calls+1
    if (!stopped || bridge != u32(16) || dpi != u32(4096) || mode != u32(17)) bad=true
    return if (failure == 2) 5 else 1
}
fun resetShutdown(): void {
    bridge=u32(17); dpi=u32(4097); mode=u32(16); stopped=false
    writes=0; calls=0; drop=0; failure=0; bad=false; return
}
@export("abla_dsi_p4_shutdown_test")
trusted fun testShutdown(): i32 {
    var channel=0
    while (channel < 4) {
        resetShutdown()
        if (esp32P4DsiVideoShutdownOwned(channel,2) != 32769 || writes != 4 || calls != 2 || bad) return i32(1)
        if (esp32P4DsiVideoShutdownOwned(channel,2) != 32769 || writes != 4 || bad) return i32(2)
        resetShutdown(); failure=1
        if (esp32P4DsiVideoShutdownOwned(channel,2) != 1027 || writes != 0 || calls != 1 || bad) return i32(3)
        failure=0
        if (esp32P4DsiVideoShutdownOwned(channel,2) != 32769 || bad) return i32(4)
        var fault=1
        while (fault <= 4) {
            if (fault != 2) {
                resetShutdown(); drop=fault
                val expected=if (fault == 1) 32772 else if (fault == 3) 32773 else 32774
                if (esp32P4DsiVideoShutdownOwned(channel,2) != expected || writes != fault || calls != 1 || bad) return i32(5)
                drop=0
                if (esp32P4DsiVideoShutdownOwned(channel,2) != 32769 || bad) return i32(6)
            }
            fault=fault+1
        }
        resetShutdown(); failure=2
        if (esp32P4DsiVideoShutdownOwned(channel,2) != 34055 || bad) return i32(7)
        failure=0
        if (esp32P4DsiVideoShutdownOwned(channel,2) != 32769 || writes != 4 || bad) return i32(8)
        channel=channel+1
    }
    resetShutdown()
    if (esp32P4DsiVideoShutdownOwned(4,2) != 2 || esp32P4DsiVideoShutdownOwned(0,0) != 2 || calls != 0 || writes != 0) return i32(9)
    return i32(0)
}
