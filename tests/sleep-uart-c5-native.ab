import "../src/esp32/power/sleep_uart_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var port=0
var conf=1
var clock=0x400000
var shadow=0x405
var active=0x405
var pending=0
var fsm=15
var fifo=23
var writes=0
var syncs=0
var bad=false
trusted fun c5SleepUartRead(address: int): int {
    val base=0x60000000+port*4096
    if (address == 0x60096000+port*12) return conf
    if (address == 0x60096004+port*12) return clock
    if (address == base+0x3c) return shadow
    if (address == base+0x98) {
        if (pending > 0) { pending=pending-1;return 1 }
        active=shadow;return 0
    }
    if (address == base+0x70) { if (pending != 0) bad=true;return fsm<<4 }
    if (address == base+0x1c) return fifo<<16
    bad=true;return 0
}
trusted fun c5SleepUartWrite(address: int,value: int): void {
    val base=0x60000000+port*4096
    writes=writes+1
    if (pending != 0) bad=true
    if (address == base+0x3c) {
        if ((value&~0x1a0000) != 0x405) bad=true
        shadow=value
    } else if (address == base+0x98) {
        if (value != 1) bad=true
        syncs=syncs+1;pending=3
    } else bad=true
    return
}
fun reset(): void { conf=1;clock=0x400000;shadow=0x405;active=shadow;pending=0;writes=0;syncs=0;bad=false;return }
@export("abla_sleep_uart_c5_test")
trusted fun test(): int {
    port=0
    while (port < 2) {
        var state=0
        while (state < 16) {
            reset();fsm=state;fifo=23
            val result=esp32C5SleepUartPrepareOwned(port,false,3,true)
            val suspended=state == 0 || state == 15
            if (result != (if (suspended) 3 else 4) || fifo != 23 || bad) return 1
            if (suspended && !esp32C5SleepUartResumeOwned(port,true)) return 2
            if (shadow != 0x405 || active != shadow || writes != 9 || syncs != 2 || bad) return 3
            var queued=0
            while (queued < 256) {
                reset();fifo=queued;fsm=state
                val drained=esp32C5SleepUartPrepareOwned(port,true,2,true)
                if (drained != (if (state == 0 && queued == 0) 2 else 4) || writes != 0 || bad || fifo != queued) return 4
                queued=queued+1
            }
            state=state+1
        }
        var mask=1
        while (mask < 8) {
            reset();shadow=shadow | ((mask&1)<<17) | ((mask&2)<<18) | ((mask&4)<<18)
            if (esp32C5SleepUartPrepareOwned(port,false,1,true) != 5 || writes != 0) return 5
            mask=mask+1
        }
        reset();conf=0
        if (esp32C5SleepUartPrepareOwned(port,false,1,true) != 1 || writes != 0) return 6
        reset();conf=3
        if (esp32C5SleepUartPrepareOwned(port,false,1,true) != 1 || writes != 0) return 7
        reset();clock=0
        if (esp32C5SleepUartPrepareOwned(port,false,1,true) != 7 || writes != 0) return 8
        reset();pending=9
        if (esp32C5SleepUartPrepareOwned(port,false,1,true) != 7 || writes != 0) return 9
        reset()
        if (esp32C5SleepUartPrepareOwned(port,false,1,false) != 0 || esp32C5SleepUartResumeOwned(port,false) || writes != 0) return 10
        if (esp32C5SleepUartPrepareOwned(port,false,0,true) != 0 || writes != 0) return 11
        port=port+1
    }
    reset()
    if (esp32C5SleepUartPrepareOwned(2,false,1,true) != 0 || esp32C5SleepUartResumeOwned(-1,true) || bad || writes != 0) return 12
    0
}
