import "../src/m5stack/tab5_board_prepare_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val data=nativeStaticAllocate(4)
var failure=0
var steps=0
var bad=false
var expectedBoard=m5BoardTab5
fun tab5BoardPrepareValid(bus: int,expanders: int,scratch: NativeBuffer): bool = bus == 42 && expanders == 64 && failure != 1
fun tab5BoardPrepareFresh(expanders: int): bool = failure != 2
fun tab5BoardPrepareExpanders(bus: int,expanders: int,board: M5BoardId): int {
    if (steps != 0 || board != expectedBoard) bad=true
    steps=steps+1; return if (failure == 3) 6 else 1
}
fun tab5BoardPreparePower(expanders: int): int {
    if (steps != 1) bad=true
    steps=steps+1; return if (failure == 4) 1796 else 2561
}
fun tab5BoardPrepareReset(bus: int,scratch: NativeBuffer): int {
    if (steps != 2) bad=true
    steps=steps+1; return if (failure == 5) 1288 else 1
}
@export("abla_tab5_board_prepare_test")
fun testPrepare(): i32 {
    var boardIndex=0
    while (boardIndex < 2) {
        expectedBoard=if (boardIndex == 0) m5BoardTab5 else m5BoardTab5X
        failure=0
        while (failure <= 5) {
            steps=0
            val result=tab5BoardPrepareOwned(expectedBoard,42,64,nativeBufferAt(data,4))
            if (result.status() != failure+1 || bad) return i32(1)
            if (steps != (if (failure == 0 || failure == 5) 3 else if (failure < 3) 0 else failure-2)) return i32(2)
            if (result.detail() != (if (failure == 3) 6 else if (failure == 4) 1796 else if (failure == 5) 1288 else 0)) return i32(3)
            failure=failure+1
        }
        boardIndex=boardIndex+1
    }
    steps=0; failure=0
    if (tab5BoardPrepareOwned(M5BoardId(0),42,64,nativeBufferAt(data,4)).status() != 2 ||
        tab5BoardPrepareOwned(m5BoardTab5,42,64,NativeBuffer(0)).status() != 2 || steps != 0) return i32(4)
    return i32(0)
}
