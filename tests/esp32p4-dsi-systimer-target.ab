import "../src/esp32/timer/system_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_systimer_target")
trusted fun systimerTarget(op: int,a: int,b: int,c: int,d: int): int {
    if (op == 0) return p4SystemCounter(a).tryTicks(b)
    if (op == 1) return p4SystemCounter(a).configureOwned(b != 0,c != 0,d != 0)
    if (op == 2) return p4SystemCounter(a).loadOwned(b)
    if (op == 3) return p4SystemAlarmConfigureOwned(a,b,c,d)
    if (op == 4) return p4SystemAlarmEnableOwned(a,b != 0)
    if (op == 5) return p4SystemAlarmInterruptEnableOwned(a,b != 0)
    if (op == 6) return p4SystemAlarmAcknowledgeOwned(a)
    if (op == 7) return p4SystemTimerElapsed(a,b)
    if (op == 8) return p4SystemTimerXtalMicroseconds(a)
    return p4SystemAlarmPending()
}
