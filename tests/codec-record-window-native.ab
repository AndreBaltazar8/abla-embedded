import "../src/esp32/sdk/raw_buffer.ab"
import "../src/m5stack/codec_record_window_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(1024)
var paper=false
var scenario=0
var calls=0
var completed=0
var delays=0
var closes=0
var bad=false
type Esp32S3GdmaPumpResult=int
fun Esp32S3GdmaPumpResult.status(): int = this&255
fun paperColorCaptureValid(r: NativeBuffer): bool = r.hasAddressRange(0,132) && r.loadU32(0) == 2
fun m5Es8311CaptureValid(r: NativeBuffer): bool = r.hasAddressRange(0,132) && r.loadU32(0) == 1
fun esp32s3GdmaRingLayoutValid(desc: int,count: int,payload: int,bytes: int,stride: int): bool =
    desc == memory+512 && count == 2 && payload == memory+768 && bytes == 16 && stride == 16
trusted fun read(r: NativeBuffer,output: NativeBuffer,polls: int,exclusive: bool,selectedPaper: bool): Esp32S3GdmaPumpResult {
    calls=calls+1
    if (selectedPaper != paper || polls != 1 || !exclusive || output.capacity() != 16 || output.addressValue() != memory+160+completed*16) bad=true
    if (scenario == 1 || (scenario == 0 && (calls&1) != 0)) return Esp32S3GdmaPumpResult(3)
    if (scenario == 2 && completed == 2) { output.storeU32(0,0xdeadbeef);r.storeU32(4,3);return Esp32S3GdmaPumpResult(7) }
    var offset=0
    while (offset < 16) { output.storeU32(offset,completed+100);offset=offset+4 }
    completed=completed+1
    return Esp32S3GdmaPumpResult(1)
}
trusted fun paperColorCaptureReadOwned(r: NativeBuffer,o: NativeBuffer,p: int,e: bool): Esp32S3GdmaPumpResult = read(r,o,p,e,true)
trusted fun m5Es8311CaptureReadOwned(r: NativeBuffer,o: NativeBuffer,p: int,e: bool): Esp32S3GdmaPumpResult = read(r,o,p,e,false)
trusted fun close(r: NativeBuffer,polls: int,exclusive: bool,selectedPaper: bool): int {
    closes=closes+1
    if (polls != 1000 || !exclusive || selectedPaper != paper) bad=true
    r.storeU32(4,if (scenario == 3) 3 else 4)
    return if (scenario == 3) 3 else 4
}
trusted fun paperColorCaptureCloseOwned(r: NativeBuffer,p: int,e: bool): int = close(r,p,e,true)
trusted fun m5Es8311CaptureCloseOwned(r: NativeBuffer,p: int,e: bool): int = close(r,p,e,false)
fun peripheralDelayMilliseconds(ms: int): void { if (ms != 1) bad=true;delays=delays+1;return }
trusted fun initialize(r: NativeBuffer): void {
    calls=0;completed=0;delays=0;closes=0
    r.storeU32(0,if (paper) 2 else 1);r.storeU32(4,2);r.storeU32(28,memory+512)
    r.storeU32(32,2);r.storeU32(36,memory+768);r.storeU32(40,16);r.storeU32(44,0)
    return
}
@export("abla_codec_record_window_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(memory,132);val output=nativeBufferAt(memory+160,64)
    var mode=0
    while (mode < 2) {
        paper=mode == 1;scenario=0
        while (scenario < 4) {
            initialize(r)
            val result=m5CodecRecordWindowOwned(r,output,4,3,true)
            val expectedStatus=if (scenario == 0) 1 else if (scenario == 1) 3 else if (scenario == 2) 7 else 10
            val expectedBytes=if (scenario == 1) 0 else if (scenario == 2) 32 else 64
            if (result.status() != expectedStatus || result.bytes() != expectedBytes || closes != 1 || bad) return i32(1)
            var i=0
            while (i < expectedBytes) { if (output.loadU32(i) != 100+i/16) return i32(2);i=i+4 }
            if (scenario == 2 && output.loadU32(32) != 0xdeadbeef) return i32(3)
            if (delays != (if (scenario == 0) 4 else if (scenario == 1) 2 else 0)) return i32(4)
            scenario=scenario+1
        }
        initialize(r)
        if (m5CodecRecordWindowOwned(r,nativeBufferAt(memory+160,63),4,3,true).status() != 2 ||
            m5CodecRecordWindowOwned(r,nativeBufferAt(memory+128,64),4,3,true).status() != 2 ||
            m5CodecRecordWindowOwned(r,nativeBufferAt(memory+496,64),4,3,true).status() != 2 ||
            m5CodecRecordWindowOwned(r,nativeBufferAt(memory+752,64),4,3,true).status() != 2 ||
            m5CodecRecordWindowOwned(r,output,4,3,false).status() != 2 ||
            m5CodecRecordWindowOwned(r,output,0,3,true).status() != 2 || calls != 0 || closes != 0 || r.loadU32(4) != 2) return i32(5)
        mode=mode+1
    }
    return i32(0)
}
