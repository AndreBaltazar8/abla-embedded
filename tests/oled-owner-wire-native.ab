import "./oled-wire-native.ab"
import "../src/display/oled_owner_software.ab"
val ownerMemory=nativeStaticAllocate(32)
@export("abla_oled_owner_wire_test")
trusted fun testOwner(): i32 {
    wireSeed();extraAddress=60
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    val owner=oledOwnerAt(nativeBufferAt(ownerMemory,32))
    val frame=nativeBufferAt(oledMemory,1024);val scratch=nativeBufferAt(oledMemory+1024,176)
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1 || !owner.initializeFresh()) return i32(1)
    val bus=control.session().bus()
    if (oledOwnerAt(nativeBufferAt(softwareI2cProviderState,32)) != 0) return i32(2)
    var variant=0
    while (variant < 2) {
        val profile=if (variant == 0) m5UnitMiniOledProfile else m5UnitOledProfile
        val total=if (variant == 0) 28 else 29
        var failed=0
        while (failed <= total) {
            extraCount=0
            val before=ackCount
            if (owner.openOwned(bus,profile,scratch,false) != 2 || owner.openOwned(bus,profile,owner.buffer(),true) != 2 || ackCount != before) return i32(3)
            nackAt=if (failed == 0) 0 else before+failed
            val opened=owner.openOwned(bus,profile,scratch,true)
            if (opened != (if (failed == 0) 1 else 4) || owner.ready() != (failed == 0) ||
                !owner.device().valid() || owner.openFailure() != (if (failed == 0) 0 else 4) || bad) return i32(4)
            val after=ackCount
            if (owner.openOwned(bus,profile,scratch,true) != 2 || ackCount != after) return i32(5)
            nackAt=0
            if (failed == 0) {
                var at=0;while (at < 1024) { frame.store(at,at&255);at=at+1 }
                val result=owner.displayOwned(frame,scratch,true)
                if ((result&255) != 1 || owner.lastPublication() != result) return i32(6)
                val noIO=ackCount
                if (owner.displayOwned(frame,owner.buffer(),true) != 2 ||
                    owner.displayOwned(nativeBufferAt(softwareI2cProviderSlots,1024),scratch,true) != 2 || ackCount != noIO) return i32(7)
            }
            // Every shutdown byte may fail after hardware effects. Retain the
            // exact generation handle, preserve original open failure, retry.
            val handle=owner.device()
            var closeFail=1
            while (closeFail <= 3) {
                nackAt=ackCount+closeFail
                if (owner.closeOwned(scratch,true) || owner.status() != 5 || owner.device() != handle ||
                    owner.openFailure() != (if (failed == 0) 0 else 4) || bad) return i32(8)
                closeFail=closeFail+1
            }
            nackAt=0
            if (!owner.closeOwned(scratch,true) || owner.status() != 0 || (owner.device()|0) != 0 ||
                !control.ready() || bad) return i32(9)
            val closedAt=ackCount
            if (!owner.closeOwned(scratch,true) || ackCount != closedAt || owner.displayOwned(frame,scratch,true) != 2) return i32(10)
            failed=failed+1
        }
        variant=variant+1
    }
    if (!softwareI2cProviderEnter()) return i32(11)
    val allocated=owner.openOwned(bus,m5UnitOledProfile,scratch,true)
    if (!softwareI2cProviderLeave() || allocated != 3 || (owner.device()|0) != 0 || owner.openFailure() != 3) return i32(12)
    if (!owner.closeOwned(scratch,true) || !control.closeOwned(true) || pads != 0 || bad) return i32(13)
    return i32(0)
}
