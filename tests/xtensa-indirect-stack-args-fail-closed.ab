// CALLX8 lifting must not silently discard outgoing stack arguments.

import "abla/io"
import "abla/text"
import "../tools/lift-xtensa-leaves-to-abla.ab"

fun main: int {
    val unsafe = "entry a1, 32\nmov a8, a3\ns32i a2, a1, 0\ncallx8 a8\nretw.n"
    val rejected = lift("indirectSevenArguments", unsafe)
    if (rejected.error == "") {
        println("FAIL CALLX8 silently dropped the seventh argument")
        return 1
    }
    if (!rejected.error.contains("outgoing stack arguments at a1+0")) {
        println("FAIL unexpected error: ${rejected.error}")
        return 1
    }

    val safe = "entry a1, 32\nmov a8, a3\ncallx8 a8\nretw.n"
    val result = lift("indirectRegisterArguments", safe)
    if (result.error != "" || !result.source.contains("ablaUnsafeCallI32")) {
        println("FAIL register-only CALLX8 stopped lifting")
        return 1
    }

    println("Xtensa indirect stack arguments: ambiguous CALLX8 rejected")
    0
}
