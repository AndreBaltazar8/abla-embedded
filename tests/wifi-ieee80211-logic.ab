import "../src/checksum/crc32.ab"
import "../src/wifi/ieee80211_logic.ab"

fun main(): int {
    val control = wifiFrameControl(
        wifiFrameTypeData,
        u8(8),
        true,
        false,
        true,
        true,
        false,
        true,
        true,
        false
    )
    if (control.rawValue() != u16(28040) ||
        control.protocolVersion() != u8(0) ||
        control.frameType() != wifiFrameTypeData ||
        control.subtype() != u8(8) ||
        !control.toDistributionSystem() ||
        control.fromDistributionSystem() || !control.moreFragments() ||
        !control.retry() || control.powerManagement() || !control.moreData() ||
        !control.protectedFrame() || control.ordered()) return 1
    val sequence = wifiSequenceControl(u16(2748), u8(13))
    if (sequence.rawValue() != u16(43981) ||
        sequence.sequenceNumber() != u16(2748) ||
        sequence.fragmentNumber() != u8(13)) return 2
    var crc = crc32IeeeInitial
    crc = crc32IeeeUpdateByte(crc, u8(49))
    crc = crc32IeeeUpdateByte(crc, u8(50))
    crc = crc32IeeeUpdateByte(crc, u8(51))
    crc = crc32IeeeUpdateByte(crc, u8(52))
    crc = crc32IeeeUpdateByte(crc, u8(53))
    crc = crc32IeeeUpdateByte(crc, u8(54))
    crc = crc32IeeeUpdateByte(crc, u8(55))
    crc = crc32IeeeUpdateByte(crc, u8(56))
    crc = crc32IeeeUpdateByte(crc, u8(57))
    if (crc32IeeeFinalize(crc) != u32(3421780262)) return 3
    71
}
