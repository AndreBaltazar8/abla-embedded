import "../src/audio/buzzer_delta_sigma.ab"
import "abla/runtime/scalar"
import "abla/build"
val inputMemory=nativeStaticAllocate(512)
val outputMemory=nativeStaticAllocate(1024)
val splitMemory=nativeStaticAllocate(1024)
// Independent charge-balance oracle: count crossings via division of total
// consumed charge, then derive each bit from successive counts, not recurrence.
fun referenceWord(sample: int,remainder: int): int {
    val charge=32768+sample
    var word=0;var previous=0;var n=1
    while (n <= 32) {
        val crossings=(n*charge+65535-remainder)/65536
        word=word*2+(crossings-previous)
        previous=crossings;n=n+1
    }
    return word
}
@export("abla_buzzer_delta_sigma_test")
trusted fun testBuzzer(): int {
    var raw=0
    while (raw < 65536) {
        val sample=raw-32768
        var kind=0
        while (kind < 4) {
            val remainder=if (kind == 0) 0 else if (kind == 1) 32768 else if (kind == 2) 65535 else raw
            val encoded=BuzzerDeltaSigma(remainder).sample(sample)
            val expected=(remainder-32*(32768+sample))&65535
            if (!encoded.valid() || encoded.bits() != referenceWord(sample,remainder) || (encoded.next()|0) != expected) return 1
            kind=kind+1
        }
        raw=raw+1
    }
    if (BuzzerDeltaSigma(-1).sample(0).valid() || BuzzerDeltaSigma(65536).sample(0).valid() ||
        BuzzerDeltaSigma(0).sample(-32769).valid() || BuzzerDeltaSigma(0).sample(32768).valid()) return 2
    val input=nativeBufferAt(inputMemory,512);val output=nativeBufferAt(outputMemory,1024);val split=nativeBufferAt(splitMemory,1024)
    var i=0
    while (i < 256) { input.storeU16(i*2,(i*7919)&65535);i=i+1 }
    val complete=BuzzerDeltaSigma(0).encodePcm16(input,output,256)
    if (!complete.valid()) return 3
    var cut=0
    while (cut <= 256) {
        val first=BuzzerDeltaSigma(0).encodePcm16(input,split,cut)
        val last=first.encodePcm16(nativeBufferAt(inputMemory+cut*2,512-cut*2),nativeBufferAt(splitMemory+cut*4,1024-cut*4),256-cut)
        if (last != complete) return 4
        i=0
        while (i < 256) { if (output.loadU32(i*4) != split.loadU32(i*4)) return 5;i=i+1 }
        cut=cut+1
    }
    val sentinel=output.loadU32(0)
    if (BuzzerDeltaSigma(0).encodePcm16(input,output,257).valid() ||
        BuzzerDeltaSigma(0).encodePcm16(input,output,-1).valid() ||
        BuzzerDeltaSigma(-1).encodePcm16(input,output,1).valid() ||
        BuzzerDeltaSigma(0).encodePcm16(output,output,1).valid() || output.loadU32(0) != sentinel) return 6
    return 0
}
