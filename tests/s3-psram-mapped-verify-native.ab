import "./s3-psram-calibrated-final80-native.ab"
import "../src/esp32/psram/mapped_verify_s3_sequence.ab"
val mvOwner=nativeStaticAllocate(2080)
var mvFirst=0
var mvCount=0
var mvPage=0
var mvVirtual=0
var mvReads=0
var mvMismatch=-1
var mvMmuBad=false
var mvDisabled=false
var mvGate=0
var mvBad=false
fun s3PsramMmuStorageSafe(address: int,length: int): bool = address == mvOwner && length <= 2080
fun s3PsramMmuRead(entry: int): int {
    if (entry < mvFirst || entry >= mvFirst+mvCount) mvBad=true
    return (32768+mvPage+entry-mvFirst)^(if (mvMmuBad && entry == mvFirst+mvCount-1) 1 else 0)
}
fun s3PsramMappedRead(address: int): int {
    if (address == 0x600c4000) return if (mvDisabled) 0 else 1
    if (address == 0x600c4004) return mvGate
    if (address != mvVirtual+mvReads*4 || mvReads >= 16) mvBad=true
    val value=0xa5ff005a^(if (mvReads == mvMismatch) 1 else 0)
    mvReads=mvReads+1;return value
}
@export("abla_s3_psram_mapped_verify_test")
fun testMappedVerify(): int {
    calReset();calFailPhase=0
    if (calRun() != 1) return 1
    val cal=nativeBufferAt(calMemory,340);val mapping=nativeBufferAt(mvOwner,2080)
    // Model a completed calibration at the final64B of a1GiB chip, to cover
    // full physical page-field and DBUS boundary arithmetic independently.
    cal.storeU32(12,1073741824);cal.storeU32(8,1073741760)
    mvFirst=0
    while (mvFirst < 512) {
        mvCount=512-mvFirst;mvPage=16384-mvCount;mvVirtual=0x3dffffc0
        mapping.storeU32(0,0x53334d4d);mapping.storeU32(4,2);mapping.storeU32(8,mvFirst);mapping.storeU32(12,mvCount)
        mapping.storeU32(16,mvPage);mapping.storeU32(20,mvCount);mapping.storeU32(24,1073741824);mapping.storeU32(28,0)
        var i=0
        while (i < mvCount) { mapping.storeU32(32+i*4,16384);i=i+1 }
        mvMismatch=-1
        while (mvMismatch < 16) {
            mvReads=0;mvBad=false
            if (s3PsramMappedVerifyOwned(cal,mapping,true) != (if (mvMismatch < 0) 1 else 5) || mvBad ||
                mvReads != (if (mvMismatch < 0) 16 else mvMismatch+1)) return 2
            mvMismatch=mvMismatch+1
        }
        mvReads=0;mvMmuBad=true
        if (s3PsramMappedVerifyOwned(cal,mapping,true) != 3 || mvReads != 0) return 3
        mvMmuBad=false;mvDisabled=true
        if (s3PsramMappedVerifyOwned(cal,mapping,true) != 3 || mvReads != 0) return 4
        mvDisabled=false;mvGate=3
        if (s3PsramMappedVerifyOwned(cal,mapping,true) != 3 || mvReads != 0) return 5
        mvGate=0;mvFirst=mvFirst+1
    }
    mvReads=0
    if (s3PsramMappedVerifyOwned(cal,mapping,false) != 2 || mvReads != 0) return 6
    mapping.storeU32(20,0)
    if (s3PsramMappedVerifyOwned(cal,mapping,true) != 2 || mvReads != 0) return 7
    mapping.storeU32(20,1);cal.storeU32(8,0)
    if (s3PsramMappedVerifyOwned(cal,mapping,true) != 2 || mvReads != 0) return 8
    return 0
}
