import "../src/m5stack/corep4x_record_window_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
val session=nativeBufferAt(memory,192)
val output=nativeBufferAt(memory+1024,2048)
var calls=0
var closes=0
var waits=0
var done=0
var failAt=-1
var closeResult=4
var malformed=0
var alwaysBusy=false
var bad=false
fun m5P4MicrophoneSessionValid(r: NativeBuffer,tab5: bool): bool = !tab5 && r.hasAddressRange(0,192) && r.loadU32(64) == 0x43504d31
fun esp32p4AhbGdmaRingLayoutValid(d: int,n: int,p: int,s: int,b: int): bool =
    d == memory+384 && n == 2 && p == memory+640 && s == 128 && b == 64
trusted fun peripheralDelayMilliseconds(ms: int): void { if (ms != 1) bad=true;waits=waits+1;return }
trusted fun m5P4MicrophonePumpOwned(r: NativeBuffer,d: NativeBuffer,tab5: bool): int {
    val e=!tab5
    calls=calls+1
    if (!e || !d.hasAddressRange(0,64)) bad=true
    if (alwaysBusy || calls%3 != 0) { r.storeU32(48,3);return 2 }
    val bytes=if (malformed != 0) malformed else if (done%2 == 0) 24 else 64
    var i=0
    while (i < bytes && i < 64) { d.store(i,done+1);i=i+1 }
    if (done == failAt) { r.storeU32(48,5|(bytes << 16));r.storeU32(68,3);return 3 }
    r.storeU32(48,1|(bytes << 16));done=done+1;return 2
}
trusted fun m5P4MicrophoneStopOwned(r: NativeBuffer,tab5: bool): int {
    val e=!tab5
    if (!e) bad=true
    closes=closes+1;r.storeU32(68,if (closeResult == 4) 4 else 3);return closeResult
}
trusted fun reset(): void {
    session.storeU32(64,0x43504d31);session.storeU32(68,2);session.storeU32(12,0)
    session.storeU32(20,memory+384);session.storeU32(24,2);session.storeU32(28,memory+640)
    session.storeU32(32,128);session.storeU32(36,64);session.storeU32(40,0)
    calls=0;closes=0;waits=0;done=0;failAt=-1;closeResult=4;malformed=0;alwaysBusy=false;bad=false;return
}
@export("abla_corep4x_record_window_test")
trusted fun test(): i32 {
    var blocks=1
    while (blocks <= 32) {
        reset()
        val result=coreP4xRecordWindowOwned(session,output,blocks,3,true)
        val bytes=(blocks/2)*88+(if ((blocks&1) != 0) 24 else 0)
        if (result.status() != 1 || result.bytes() != bytes || closes != 1 || waits != blocks*2 || calls != blocks*3 || bad) return i32(1)
        var offset=0;var block=0
        while (block < blocks) {
            val size=if ((block&1) == 0) 24 else 64
            var i=0
            while (i < size) { if (output.load(offset+i) != block+1) return i32(2);i=i+1 }
            offset=offset+size;block=block+1
        }
        blocks=blocks+1
    }
    reset();alwaysBusy=true;closeResult=3
    val timeout=coreP4xRecordWindowOwned(session,output,2,4,true)
    if (timeout.status() != 3 || timeout.bytes() != 0 || calls != 4 || waits != 3 || closes != 1 || session.loadU32(68) != 3) return i32(3)
    reset();closeResult=3
    val closeFailure=coreP4xRecordWindowOwned(session,output,2,3,true)
    if (closeFailure.status() != 10 || closeFailure.bytes() != 88 || closes != 1) return i32(4)
    reset();failAt=1;closeResult=3
    val dma=coreP4xRecordWindowOwned(session,output,4,3,true)
    if (dma.status() != 4 || dma.bytes() != 24 || closes != 1 || done != 1) return i32(5)
    reset();malformed=7
    val frame=coreP4xRecordWindowOwned(session,output,4,3,true)
    if (frame.status() != 5 || frame.bytes() != 0 || closes != 1) return i32(6)
    reset()
    var alias=0
    while (alias < 4) {
        val address=if (alias == 0) memory+128 else if (alias == 1) memory+400 else if (alias == 2) memory+736 else memory+884
        if (coreP4xRecordWindowOwned(session,nativeBufferAt(address,128),2,3,true).status() != 2 || calls != 0 || closes != 0) return i32(7)
        alias=alias+1
    }
    if (coreP4xRecordWindowOwned(session,nativeBufferAt(memory+1024,127),2,3,true).status() != 2 ||
        coreP4xRecordWindowOwned(session,output,2,0,true).status() != 2 ||
        coreP4xRecordWindowOwned(session,output,2,3,false).status() != 2 || calls != 0 || closes != 0) return i32(8)
    return i32(0)
}
