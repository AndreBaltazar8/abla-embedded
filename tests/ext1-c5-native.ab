import "../src/esp32/power/ext1_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var register=0
var fail=false
var bad=false
var writes=0
fun c5Ext1Read(): int = register
fun c5Ext1Write(value: int): void {
    writes=writes+1
    if ((value&16511) != 0) bad=true
    if (!fail) register=(register&255)|(value&0xffffff00)
    return
}
@export("abla_ext1_c5_test")
trusted fun test(): i32 {
    var mask=1
    while (mask < 256) {
        register=0xa5aa3fab;val original=register;writes=0;fail=false
        var lease=esp32C5Ext1ParkOwned(true)
        if (lease.status() != 6 || !lease.hasSnapshot() || (register&0x7f8000) != 0 || esp32C5Ext1WakeStatus() != 171) return i32(1)
        lease=lease.configureOwned(mask,mask,true,true)
        if (lease.status() != 1 || register != ((mask<<15)|(mask<<23)|0x80003fab)) return i32(2)
        val before=writes
        if (lease.configureOwned(0,0,false,true).status() != 2 || writes != before) return i32(3)
        fail=true;lease=lease.parkOwned(true)
        if (lease.status() != 4 || !lease.hasSnapshot()) return i32(4)
        fail=false;lease=lease.parkOwned(true)
        if (lease.status() != 6) return i32(5)
        lease=lease.closeOwned(true)
        if (lease.status() != 5 || register != original || bad) return i32(6)
        val closed=writes
        lease=lease.closeOwned(true)
        if (writes != closed) return i32(7)
        mask=mask+1
    }
    writes=0;register=16384
    if (esp32C5Ext1ParkOwned(true).status() != 3 || esp32C5Ext1ParkOwned(false).status() != 2 || writes != 0) return i32(8)
    return i32(0)
}
