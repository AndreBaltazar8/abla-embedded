import "../src/esp32/dsi_start_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_start_target")
trusted fun target(hwVersion: int,lanes: int,referenceKhz: int,laneKbps: int,channel: int,forceHs: bool,polls: int): DsiCommandResult =
    esp32P4DsiStartDigital(hwVersion,lanes,referenceKhz,laneKbps,channel,forceHs,polls)
