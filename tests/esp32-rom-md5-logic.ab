import "abla/unsafe/memory"
import "../src/esp32/rom/md5_esp32.ab"

trusted noescape extern:"c" fun mmap(
    requested: i64*,
    length: int,
    protection: i32,
    flags: i32,
    descriptor: i32,
    offset: int
): i64*
trusted noescape extern:"c" fun munmap(address: i64*, length: int): i32

trusted fun esp32RomMd5DigestByte(digest: u32, index: u32): u32 =
    esp32RomMd5LoadU8(digest + index)

trusted fun main(): int {
    val allocation = mmap(nativeNullPointer(), 4096, i32(3), i32(98), i32(-1), 0)
    val address = nativePointerAddress(allocation)
    if (address <= 0 || address > 4294967295) return 1
    val context = u32(address)
    val input = context + u32(128)
    val digest = context + u32(256)

    esp32RomMd5Init(context)
    esp32RomMd5Final(digest, context)
    val empty0 = esp32RomMd5DigestByte(digest,u32(0)) | (esp32RomMd5DigestByte(digest,u32(1)) << u32(8)) | (esp32RomMd5DigestByte(digest,u32(2)) << u32(16)) | (esp32RomMd5DigestByte(digest,u32(3)) << u32(24))
    val empty1 = esp32RomMd5DigestByte(digest,u32(4)) | (esp32RomMd5DigestByte(digest,u32(5)) << u32(8)) | (esp32RomMd5DigestByte(digest,u32(6)) << u32(16)) | (esp32RomMd5DigestByte(digest,u32(7)) << u32(24))
    val empty2 = esp32RomMd5DigestByte(digest,u32(8)) | (esp32RomMd5DigestByte(digest,u32(9)) << u32(8)) | (esp32RomMd5DigestByte(digest,u32(10)) << u32(16)) | (esp32RomMd5DigestByte(digest,u32(11)) << u32(24))
    val empty3 = esp32RomMd5DigestByte(digest,u32(12)) | (esp32RomMd5DigestByte(digest,u32(13)) << u32(8)) | (esp32RomMd5DigestByte(digest,u32(14)) << u32(16)) | (esp32RomMd5DigestByte(digest,u32(15)) << u32(24))
    if (empty0 != u32(0xd98c1dd4) || empty1 != u32(0x04b2008f) ||
        empty2 != u32(0x980980e9) || empty3 != u32(0x7e42f8ec)) return 2

    esp32RomMd5StoreU8(input,u32(97))
    esp32RomMd5StoreU8(input+u32(1),u32(98))
    esp32RomMd5StoreU8(input+u32(2),u32(99))
    esp32RomMd5Init(context)
    esp32RomMd5Update(context,input,u32(1))
    esp32RomMd5Update(context,input+u32(1),u32(2))
    esp32RomMd5Final(digest,context)
    if (esp32RomMd5LoadU32(digest) != u32(0x98500190) ||
        esp32RomMd5LoadU32(digest+u32(4)) != u32(0xb04fd23c) ||
        esp32RomMd5LoadU32(digest+u32(8)) != u32(0x7d3f96d6) ||
        esp32RomMd5LoadU32(digest+u32(12)) != u32(0x727fe128)) return 3

    var index = u32(0)
    while (index < u32(88)) {
        if (esp32RomMd5LoadU8(context + index) != u32(0)) return 4
        index = index + u32(1)
    }
    if (munmap(allocation, 4096) != i32(0)) return 5
    return 0
}
