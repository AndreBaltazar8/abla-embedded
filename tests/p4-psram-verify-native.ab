import "../src/esp32/psram/verify_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(16)
val cached=nativeStaticAllocate(65536)
val chip=nativeStaticAllocate(65536)
var writes=0
var reads=0
var flushes=0
var fences=0
var fail=0
var corrupt=-1
var ready=true
var bad=false
fun p4PsramCommandStorageSafe(address: int,length: int): bool = address == memory && length == 16
fun p4PsramVerifyReady(line: int): bool = ready
fun p4PsramVerifyFence(): void { fences=fences+1; return }
fun p4PsramVerifyWrite(address: int,value: int): void {
    if (fences != 1+flushes*3) bad=true
    nativeBufferAt(cached,65536).storeU32(address-0x48000000,value); writes=writes+1; return
}
fun p4PsramVerifyRead(address: int): int {
    if (fences != flushes*3) bad=true
    reads=reads+1
    return nativeBufferAt(chip,65536).loadU32(address-0x48000000)
}
fun p4PsramVerifyFlush(buffer: NativeBuffer,bytes: int,line: int,polls: int): int {
    if (fences != 2+flushes*3) bad=true
    flushes=flushes+1
    if (flushes == fail) return 5
    var offset=0
    while (offset < bytes) {
        nativeBufferAt(chip,65536).storeU32(offset,nativeBufferAt(cached,65536).loadU32(offset)^(if (offset == corrupt) 0x80000000 else 0))
        offset=offset+4
    }
    return 1
}
fun resetVerify(): void { writes=0; reads=0; flushes=0; fences=0; fail=0; corrupt=-1; ready=true; bad=false; return }
@export("abla_p4_psram_verify_test")
trusted fun verifyTest(): i32 {
    val report=nativeBufferAt(memory,16)
    var size=64
    while (size <= 65536) {
        resetVerify()
        val line=if (size == 64) 64 else 128
        if (p4PsramMappedVerifyOwned(nativeBufferAt(0x48000000,size),size,line,report,2) != 1 || bad || writes != 38*(size/4) || reads != writes || flushes != 38 || fences != 115) return i32(1)
        if (nativeBufferAt(chip,65536).loadU32(0) != 0x80000000) return i32(2)
        size=size*2
    }
    var failure=1
    while (failure <= 38) {
        resetVerify(); fail=failure
        if (p4PsramMappedVerifyOwned(nativeBufferAt(0x48000000,128),128,128,report,2) != 4 || bad || flushes != failure || reads != (failure-1)*32 || report.loadU32(8) != 5) return i32(3)
        failure=failure+1
    }
    resetVerify(); corrupt=124
    if (p4PsramMappedVerifyOwned(nativeBufferAt(0x48000000,128),128,128,report,2) != 5 || report.loadU32(4) != 124 || report.loadU32(8) != 0 || report.loadU32(12) != 0x80000000) return i32(4)
    resetVerify(); ready=false
    if (p4PsramMappedVerifyOwned(nativeBufferAt(0x48000000,128),128,128,report,2) != 3 || writes != 0 || fences != 0) return i32(5)
    resetVerify()
    if (p4PsramMappedVerifyOwned(nativeBufferAt(0x4800ffc0,128),128,64,report,2) != 2 ||
        p4PsramMappedVerifyOwned(nativeBufferAt(0x48000000,128),64,128,report,2) != 2 ||
        p4PsramMappedVerifyOwned(nativeBufferAt(0x4c000000,128),128,128,report,2) != 2 ||
        p4PsramMappedVerifyOwned(nativeBufferAt(0x48000000,128),128,128,nativeBufferAt(memory+1,16),2) != 2 || writes != 0 || fences != 0) return i32(6)
    return i32(0)
}
