import "../src/esp32/spi/queue_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_spi_queue_s3_target")
trusted fun target(operation: int,queue: NativeBuffer,parameters: NativeBuffer,data: NativeBuffer,now: u32): int {
    if (operation == 2) return esp32s3SpiQueueService(queue,now)
    if (operation == 3) return esp32s3SpiQueueTake(queue)
    if (!parameters.hasAddressRange(0,48)) return 3
    if (operation == 4) return esp32s3SpiQueueCancelTail(queue,u32(parameters.loadU32(0)))
    if (operation == 0) return if (esp32s3SpiQueueInitialize(queue,parameters.loadU32(0),peripheralGateAt(parameters.loadU32(4)),u32(parameters.loadU32(8)),parameters.loadU32(12),SpiPins(parameters.loadU32(16)),parameters.loadU32(20) == 1)) 1 else 0
    return esp32s3SpiQueueSubmit(queue,u32(parameters.loadU32(0)),Pin(parameters.loadU32(4)),parameters.loadU32(8),parameters.loadU32(12),parameters.loadU32(16),parameters.loadU32(20),parameters.loadU32(24),parameters.loadU32(28),data,parameters.loadU32(32),u32(parameters.loadU32(36)),parameters.loadU32(40),parameters.loadU32(44))
}
