import "../src/esp32/rtc_external_wake_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_external_wake_target")
trusted fun externalWakeTarget(record: NativeBuffer,pin: int,level0: int,pins: int,level1: int,off: bool,op: int): int {
    if (op == 0) return esp32S3ExternalWakePrepareOwned(record,pin,level0,pins,level1,off)
    if (op == 1) return if (esp32S3ExternalWakeRestoreOwned(record)) 1 else 0
    if (op == 3) return if (esp32S3ExternalWakeInitializeOwned(record,off)) 1 else 0
    if (op == 4) return if (esp32S3ExternalWakeReleasedOwned(record)) 1 else 0
    esp32S3ExternalWakeTriggersOwned(record)
}
