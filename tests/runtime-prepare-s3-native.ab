import "../src/esp32/runtime_prepare_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var enabled=0
var failure=0
var phase=0
var cleanup=0
var bad=false
fun esp32S3RuntimePrepareCore(): int = core
fun esp32S3RuntimePrepareEnabled(): int = enabled
fun esp32S3RuntimePrepareIrq(stack: NativeBuffer,table: NativeBuffer,record: NativeBuffer,selected: int,fault: int,context: int): bool {
    if (phase != 0 || stack.addressValue() != 0x3FC94000 || table.addressValue() != 0x3FC90020 || record.addressValue() != 0x3FC91000 || selected != core || fault != 0x40378000 || context != 123) bad=true
    phase=1; failure != 1
}
fun esp32S3RuntimePreparePolicy(record: NativeBuffer,table: NativeBuffer,lock: NativeBuffer,selected: int,fault: int,context: int,resolver: int): bool {
    if (phase != 1 || record.addressValue() != 0x3FC91010 || table.addressValue() != 0x3FC90010 || lock.addressValue() != 0x3FC90000 || selected != core || fault != 0x40379000 || resolver != 0x4037A000 || context != 123) bad=true
    phase=2; failure != 2
}
fun esp32S3RuntimePrepareActivate(selected: int): bool { if (phase != 2 || selected != core) bad=true; phase=3; failure == 0 }
fun esp32S3RuntimePreparePolicyRemove(record: NativeBuffer,selected: int): bool {
    if (phase != 3 || cleanup != 0 || record.addressValue() != 0x3FC91010 || selected != core) bad=true
    cleanup=1; failure != 4
}
fun esp32S3RuntimePrepareIrqRemove(record: NativeBuffer,selected: int): bool {
    if ((phase != 2 && phase != 3) || cleanup != (if (phase == 2) 0 else 1) || record.addressValue() != 0x3FC91000 || selected != core) bad=true
    cleanup=2; failure != 5
}
@export("abla_runtime_prepare_test")
trusted fun prepareTest(): i32 {
    val stack=nativeBufferAt(0x3FC94000,4096)
    val local=nativeBufferAt(0x3FC91000,40)
    val shared=nativeBufferAt(0x3FC90000,544)
    var p=0
    while (p < 12) {
        core=p & 1; failure=p/2; phase=0; cleanup=0; bad=false
        val result=esp32S3RuntimePrepareOwned(stack,local,shared,core,0x40378000,0x40379000,0x4037A000,123)
        val expected=if (failure == 0) 1 else if (failure < 4) -failure else -4
        if (result != expected || bad || cleanup != (if (failure < 2) 0 else if (failure == 4) 1 else 2)) return i32(1)
        p=p+1
    }
    phase=0; enabled=1
    if (esp32S3RuntimePrepareOwned(stack,local,shared,core,0x40378000,0x40379000,0x4037A000,123) != 0 || phase != 0) return i32(2)
    enabled=0
    if (esp32S3RuntimePrepareOwned(stack,nativeBufferAt(0x3FC90000,40),shared,core,0x40378000,0x40379000,0x4037A000,123) != 0 ||
        esp32S3RuntimePrepareOwned(stack,local,nativeBufferAt(0x3FC94000,544),core,0x40378000,0x40379000,0x4037A000,123) != 0 || phase != 0) return i32(3)
    i32(0)
}
