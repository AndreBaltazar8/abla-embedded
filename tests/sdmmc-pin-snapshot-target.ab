import "../src/sd/mmc_pin_snapshot_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_pin_snapshot_target")
trusted fun target(operation: int,pins: int,slot: int,address: int,quiescent: bool): int {
    val snapshot=nativeBufferAt(address,64)
    if (operation == 0) return sdMmcPinsCaptureOwned(SdMmcPins(pins),slot,snapshot,quiescent)
    return sdMmcPinsRestoreOwned(snapshot,quiescent)
}
