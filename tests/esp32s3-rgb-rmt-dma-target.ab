import "../src/esp32/rgb_rmt_dma_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Compile fixture; ownership/clock/pad initialization is the caller's job.
trusted fun rgbRmtDmaTarget(dma: u32, descriptors: u32, colors: u32,
    count: u32, waveform: u32, capacity: u32): int =
    esp32s3RmtWriteRgbDmaOwned(int(dma), int(descriptors),
        nativeBufferAt(int(colors), int(count) * 3), int(count), 2, 255,
        nativeBufferAt(int(waveform), int(capacity)), 100000)
#exportFunction("rgbRmtDmaTarget", "abla_s3_rgb_rmt_dma_test")
