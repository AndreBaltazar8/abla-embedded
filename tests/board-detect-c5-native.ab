import "../src/m5stack/detect_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var identity=u32(0)
var reads=0
fun m5C5ReadIdentity(): u32 { reads=reads+1; identity }
@export("abla_board_detect_c5_test")
fun detectTest(): i32 {
    var flash=0
    while (flash < 8) {
        var psram=0
        while (psram < 8) {
            var bit=0
            while (bit < 32) {
                identity=u32((flash<<13)|(psram<<19)|((1<<bit)&~((7<<13)|(7<<19))))
                reads=0
                if (esp32C5FlashCapacityFromEfuse(identity) != flash || esp32C5PsramCapacityFromEfuse(identity) != psram ||
                    m5DetectCurrentEsp32C5() != (if (flash == 1 && psram == 0) m5BoardStampC5 else m5BoardUnknown) || reads != 1) return i32(1)
                bit=bit+1
            }
            psram=psram+1
        }
        flash=flash+1
    }
    var selected=-1
    while (selected <= 513) {
        if (M5BoardId(selected) != m5BoardUnknown) {
            reads=0
            if (m5DetectCurrentEsp32C5(M5BoardId(selected)) != M5BoardId(selected) || reads != 0) return i32(2)
        }
        selected=selected+1
    }
    i32(0)
}
