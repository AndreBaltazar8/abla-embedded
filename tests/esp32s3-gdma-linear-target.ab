import "../src/esp32/gdma_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun gdmaLinearTarget(descriptors: u32, buffer: u32, bytes: u32): int =
    esp32s3GdmaInitializeTxChainOwned(int(descriptors), int(buffer), int(bytes))
