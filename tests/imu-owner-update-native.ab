import "../src/m5stack/imu_owner_update_sequence.ab"
import "../src/m5stack/imu_calibrated_update_sequence.ab"
import "../src/m5stack/imu_startup_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var primaryResult=0
var magneticResult=0
var calls=0
var bad=false
trusted fun m5ImuOwnerReadPrimary(primary: M5ImuProbeResult,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int {
    if (calls != 0 || !primary.ready()) bad=true
    calls=calls+1
    if (primaryResult > 0) snapshot.commit(primaryResult,imuAxes(1,2,3),imuAxes(4,5,6),imuAxes(7,8,9),micros)
    primaryResult
}
trusted fun m5ImuOwnerReadMagnetic(mag: M5Magnetometers,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int {
    if (calls != 1 || mag.selected() != 2) bad=true
    calls=calls+1
    if (magneticResult > 0) snapshot.commit(4,invalidImuAxes(),invalidImuAxes(),imuAxes(10,11,12),micros)
    magneticResult
}
@export("abla_imu_owner_update_test")
trusted fun ownerUpdateTest(): i32 {
    val owner=m5ImuOwnerAt(nativeBufferAt(nativeStaticAllocate(36),36))
    val snapshot=imuSnapshotAt(nativeBufferAt(nativeStaticAllocate(44),44))
    val scratch=nativeBufferAt(nativeStaticAllocate(20),20)
    val calibration=imuCalibration()
    val reference=imuCalibration()
    val offsets=imuOffsets()
    val expectedOffsets=imuOffsets()
    owner.initialize(); owner.buffer().storeU32(4,1)
    val primary=(1<<48)|(7<<42)|(104<<35)|(4<<32)|100
    owner.buffer().storeU32(8,primary & 0xFFFFFFFF); owner.buffer().storeU32(12,primary>>>32)
    val mag=owner.magnetometers()
    var external=0
    while (external < 2) {
        mag.buffer().storeU32(16,if (external == 0) 2 else 1)
        mag.buffer().storeU32(12,if (external == 0) 0 else 2); mag.buffer().storeU32(8,if (external == 0) 0 else 200)
        primaryResult=-2
        while (primaryResult <= 7) {
            var index=0
            while (index < 5) {
                magneticResult=if (index == 4) 4 else index-3
                snapshot.initialize(); snapshot.commit(7,imuAxes(-1,0,0),imuAxes(-2,0,0),imuAxes(-3,0,0),10)
                calls=0; bad=false
                val result=owner.updateOwned(snapshot,scratch,4294967297)
                val magnetic=if (external == 0) 0 else magneticResult
                val fresh=(if (primaryResult > 0) primaryResult else 0)|(if (magnetic > 0) 4 else 0)
                if (!result.valid() || result.primaryStatus() != primaryResult || result.magneticStatus() != magnetic ||
                    result.fresh() != fresh || result.failed() != (primaryResult < 0 || magnetic < 0) || calls != external+1 || bad) return i32(1)
                var sensor=0
                while (sensor < 3) {
                    val expected=if (sensor == 2 && magnetic > 0) 10 else
                        if (primaryResult > 0 && (primaryResult & (1<<sensor)) != 0) 1+sensor*3 else -1-sensor
                    if (snapshot.axes(sensor).x() != expected || snapshot.timestamp(sensor) !=
                        (if ((fresh & (1<<sensor)) != 0) 1 else 10)) return i32(2)
                    sensor=sensor+1
                }
                calibration.clear(); reference.clear(); offsets.clear(); expectedOffsets.clear()
                calibration.configureM5UnifiedDefaults(255,255,255)
                reference.configureM5UnifiedDefaults(255,255,255)
                calls=0
                val calibrated=owner.updateCalibratedOwned(snapshot,scratch,2,calibration,offsets)
                if (calibrated.acquisition() != result || calibrated.calibrationStatus() != fresh) return i32(5)
                reference.updateSnapshot(snapshot,expectedOffsets,fresh)
                var byte=0
                while (byte < 120) {
                    if (calibration.buffer().loadU32(byte) != reference.buffer().loadU32(byte)) return i32(6)
                    byte=byte+4
                }
                byte=0
                while (byte < 9) {
                    if (offsets.get(byte) != expectedOffsets.get(byte)) return i32(7)
                    byte=byte+1
                }
                calibration.clear(); reference.clear(); offsets.clear(); expectedOffsets.clear()
                calibration.configureM5UnifiedDefaults(255,255,255)
                reference.configureM5UnifiedDefaults(255,255,255)
                calls=0
                val started=owner.updateCalibratedOwned(snapshot,scratch,3,calibration,offsets,0)
                if (started.acquisition() != result || started.initializedMask() != fresh || started.calibrationStatus() != 0) return i32(9)
                reference.seedSnapshot(snapshot,expectedOffsets,fresh,0)
                calls=0
                val continued=owner.updateCalibratedOwned(snapshot,scratch,4,calibration,offsets,started.initializedMask())
                if (continued.initializedMask() != fresh || continued.calibrationStatus() != fresh) return i32(10)
                reference.updateSnapshot(snapshot,expectedOffsets,fresh)
                byte=0
                while (byte < 120) {
                    if (calibration.buffer().loadU32(byte) != reference.buffer().loadU32(byte)) return i32(11)
                    byte=byte+4
                }
                byte=0
                while (byte < 9) {
                    if (offsets.get(byte) != expectedOffsets.get(byte)) return i32(12)
                    byte=byte+1
                }
                index=index+1
            }
            primaryResult=primaryResult+1
        }
        external=external+1
    }
    calibration.clear(); offsets.clear(); calibration.configureM5UnifiedDefaults(255,255,255)
    primaryResult=1; magneticResult=0; calls=0
    val early=owner.updateCalibratedOwned(snapshot,scratch,5,calibration,offsets,0)
    if (early.initializedMask() != 1) return i32(14)
    val accelMetadata=calibration.buffer().loadU32(36)
    val accelOffset=offsets.get(0)
    primaryResult=2; magneticResult=4; calls=0
    val late=owner.updateCalibratedOwned(snapshot,scratch,6,calibration,offsets,early.initializedMask())
    if (late.initializedMask() != 7 || late.calibrationStatus() != 0 ||
        calibration.buffer().loadU32(36) != accelMetadata || offsets.get(0) != accelOffset) return i32(15)
    var loaded=0
    while (loaded < 2) {
        offsets.set(0,1234567)
        if (!calibration.prepareStartup(offsets,loaded == 1)) return i32(16)
        if (offsets.get(0) != (if (loaded == 1) 1234567 else 0)) return i32(17)
        primaryResult=3; magneticResult=-2; calls=0
        val motion=owner.updateStartupOwned(snapshot,scratch,7,calibration,offsets,0)
        if (motion.initializedMask() != 3 || owner.startupComplete(3) ||
            imuCalibrationStrength(calibration.buffer().loadU32(36)) != 0 ||
            imuCalibrationStrength(calibration.buffer().loadU32(76)) != 0 ||
            imuCalibrationStrength(calibration.buffer().loadU32(116)) != (if (loaded == 1) 0 else 255)) return i32(18)
        val saved=offsets.get(0)
        primaryResult=3; magneticResult=4; calls=0
        val magnetic=owner.updateStartupOwned(snapshot,scratch,8,calibration,offsets,3)
        if (!owner.startupComplete(magnetic.initializedMask()) || offsets.get(0) != saved ||
            imuCalibrationStrength(calibration.buffer().loadU32(116)) != 0 ||
            (loaded == 1 && saved != 1234567)) return i32(19)
        loaded=loaded+1
    }
    calls=0
    if (owner.updateCalibratedOwned(snapshot,scratch,0,calibration,offsets,8).acquisition().valid() || calls != 0) return i32(13)
    if (owner.updateCalibratedOwned(snapshot,calibration.buffer(),0,calibration,offsets).acquisition().valid() ||
        owner.updateCalibratedOwned(snapshot,offsets.buffer(),0,calibration,offsets).acquisition().valid() ||
        owner.updateCalibratedOwned(snapshot,scratch,0,calibration,imuOffsetsAt(owner.buffer().addressValue())).acquisition().valid() || calls != 0) return i32(8)
    if (owner.updateOwned(snapshot,owner.buffer(),0).valid() ||
        owner.updateOwned(snapshot,snapshot.buffer(),0).valid() ||
        owner.updateOwned(snapshot,nativeBufferAt(scratch.addressValue(),19),0).valid() || calls != 0) return i32(3)
    owner.buffer().storeU32(4,4)
    if (owner.updateOwned(snapshot,scratch,0).valid() || calls != 0) return i32(4)
    i32(0)
}
