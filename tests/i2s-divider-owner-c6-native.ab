import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/divider_owner_c6_sequence.ab"
var tx=false
var clock=u32(0)
var fraction=u32(0)
var writes=0
var drop=0
var busy=false
var enabled=true
var bad=false
trusted fun c6I2sClockRead(at: int): u32 {
    if (at == 0) return u32(1)
    if (at == (if (tx) 4 else 12)) return if (enabled) clock else clock&~u32(0x400000)
    if (at == (if (tx) 8 else 16)) return fraction
    bad=true;return u32(0)
}
trusted fun c6I2sClockWrite(at: int,v: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (at == (if (tx) 4 else 12)) {
        if (((v^clock)&~u32(0xff000)) != u32(0)) bad=true
        clock=v
    } else if (at == (if (tx) 8 else 16)) {
        if (((v^fraction)&u32(0xf0000000)) != u32(0)) bad=true
        fraction=v
    } else bad=true
    return
}
trusted fun c6I2sRead(at: int): u32 = if (at == 0x6c) u32(1) else if (at == 0x14 && busy) u32(1) else u32(0)
trusted fun c6I2sWrite(at: int,v: u32): void { bad=true;return }
@export("abla_i2s_divider_owner_c6_test")
trusted fun test(): i32 {
    var direction=0
    while (direction < 2) {
        tx=direction == 1
        var oldN=0
        while (oldN < 256) {
            var fault=0
            while (fault <= 20) {
                val oldClock=u32(0xa5e00000)|u32(oldN<<12)
                val oldFraction=u32(0xb0000000)|u32(oldN*524287)
                clock=oldClock;fraction=oldFraction;writes=0;drop=fault
                var owner=c6I2sDividerOpenOwned(0,tx,7,3,8,true)
                if (owner.status() != 1 && (owner.status() < 5 || owner.status() > 14)) return i32(1)
                if (fault == 0 && writes != 10) return i32(2)
                owner=owner.closeOwned(true)
                if (fault == 0 && writes != 20) return i32(3)
                drop=0;owner=owner.closeOwned(true)
                if (owner.status() != 15 || clock != oldClock || fraction != oldFraction || bad) return i32(4)
                fault=fault+1
            }
            oldN=oldN+1
        }
        direction=direction+1
    }
    var owner=c6I2sDividerOpenOwned(0,tx,7,3,8,true)
    val before=writes
    busy=true;owner=owner.closeOwned(true)
    if (owner.status() != 4 || writes != before) return i32(5)
    busy=false;enabled=false;owner=owner.closeOwned(true)
    if (owner.status() != 3 || writes != before) return i32(6)
    enabled=true;owner=owner.closeOwned(true)
    if (owner.status() != 15 || bad) return i32(7)
    return i32(0)
}
