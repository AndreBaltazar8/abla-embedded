import "../src/spi/software_transfer.ab"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 3
fun Pin.outputCapable(): bool = this == 1 || this == 2
var activity = 0
fun Pin.write(high: bool): void {
    activity = activity + 1
    return
}
fun Pin.read(): bool {
    activity = activity + 1
    false
}
fun peripheralDelayMicroseconds(duration: int): void {
    activity = activity + 1
    return
}
trusted fun main(): int {
    val a = nativeBufferAt(4096, 16)
    val b = nativeBufferAt(4104, 16)
    val empty = nativeBufferAt(0, 0)
    if (!softwareSpiRangesCompatible(a, 16, a, 16) || !softwareSpiRangesCompatible(a, 8, b, 8) ||
        !softwareSpiRangesCompatible(empty, 0, a, 16)) return 1
    if (softwareSpiRangesCompatible(a, 16, b, 16) || softwareSpiRangesCompatible(b, 16, a, 16) ||
        softwareSpiRangesCompatible(a, -1, b, 0) || softwareSpiRangesCompatible(a, 17, b, 0) ||
        softwareSpiRangesCompatible(nativeBufferAt(4294967295, 2), 2, empty, 0)) return 2
    if (softwareSpiTransferOwned(Pin(1), Pin(2), Pin(3), a, 16, b, 16) ||
        softwareSpiTransferOwned(Pin(1), Pin(-1), Pin(3), a, 1, b, 1) ||
        softwareSpiTransferOwned(Pin(1), Pin(2), Pin(-1), a, 1, b, 1) ||
        softwareSpiTransferOwned(Pin(1), Pin(2), Pin(3), empty, 0, empty, 0, 0, 1, 256)) return 3
    if (!softwareSpiTransferOwned(Pin(1), Pin(2), Pin(3), empty, 0, empty, 0) || activity != 0) return 4
    0
}
