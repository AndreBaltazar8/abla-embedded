import "../src/esp32/psram/cold_page_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(96)
var failure=0
var events=0
var busy=false
fun p4PsramColdStorage(buffer: NativeBuffer): bool = buffer.addressValue() == memory && buffer.hasAddressRange(0,48)
fun p4PsramPageStorage(buffer: NativeBuffer): bool = buffer.addressValue() == memory+48 && buffer.hasAddressRange(0,48)
fun p4CacheSramSpanSafe(layout: int,size: int,address: int,bytes: int): bool = address == memory && bytes == 96
fun p4PsramMmuIndex(address: int): int = if (address == 0x48000000) 0 else -1
fun p4PsramColdPageProfile(cold: NativeBuffer): int = if (cold.loadU32(4) == 8) 18|(8<<8)|65536|(2<<17) else 0
fun p4PsramMmuReadOwned(address: int,polls: int): int = if (failure == 15) 1|(0xc00<<8) else 1
fun p4CacheGeometryRead(offset: int): int = if (busy) 1 else 16
fun p4PsramColdFailure(cold: NativeBuffer,stage: int,error: int): int { cold.storeU32(36,error); cold.storeU32(40,stage); return 4 }
fun p4CacheL2InitializeColdOwned(layout: int,size: int,line: int,address: int,bytes: int,polls: int): int { events=events*10+1; return if (failure == 16) 7 else 1 }
fun p4PsramPageOpenOwned(page: NativeBuffer,address: int,physical: int,capacity: int,line: int,r: int,w: int,hex16: bool,polls: int): int {
    events=events*10+2; page.storeU32(4,2)
    if (capacity != 131072 || r != 18 || w != 8 || !hex16) return 2
    return if (failure == 17) 4 else 1
}
fun p4PsramPageVerifyOwned(page: NativeBuffer,polls: int): int { events=events*10+3; return if (failure == 18) 4 else 1 }
fun p4PsramPageCloseOwned(page: NativeBuffer,polls: int): int {
    events=events*10+4
    if (failure == 19) return 4
    page.storeU32(4,7); return 1
}
fun p4PsramColdCloseOwned(cold: NativeBuffer,polls: int): int { events=events*10+5; cold.storeU32(4,9); return if (failure == 20) 4 else 1 }
fun resetColdPage(cold: NativeBuffer,page: NativeBuffer): void {
    cold.storeU32(0,0x50345053); cold.storeU32(4,8); page.storeU32(0,0x50345047); page.storeU32(4,0)
    events=0; failure=0; busy=false; return
}
fun openColdPage(cold: NativeBuffer,page: NativeBuffer): int = p4PsramColdPageOpenOwned(cold,page,3,524288,128,memory,96,0x48000000,65536,2)
@export("abla_p4_psram_cold_page_test")
fun coldPageTest(): i32 {
    val cold=nativeBufferAt(memory,48); val page=nativeBufferAt(memory+48,48)
    resetColdPage(cold,page)
    if (openColdPage(cold,page) != 1 || cold.loadU32(4) != 13 || events != 123 || p4PsramColdPageCloseOwned(cold,page,2) != 1 || events != 12345) return i32(1)
    var fail=16
    while (fail <= 18) {
        resetColdPage(cold,page); failure=fail
        if (openColdPage(cold,page) != 4 || cold.loadU32(40) != fail || cold.loadU32(4) != (if (fail == 16) 11 else 12)) return i32(2)
        if (openColdPage(cold,page) != 3) return i32(3)
        failure=0
        if (p4PsramColdPageCloseOwned(cold,page,2) != 1 || page.loadU32(4) != 7) return i32(4)
        fail=fail+1
    }
    resetColdPage(cold,page); failure=15
    if (openColdPage(cold,page) != 4 || events != 0 || cold.loadU32(4) != 8) return i32(5)
    resetColdPage(cold,page); openColdPage(cold,page); busy=true
    if (p4PsramColdPageCloseOwned(cold,page,2) != 4 || events != 123) return i32(6)
    busy=false; failure=19
    if (p4PsramColdPageCloseOwned(cold,page,2) != 4 || cold.loadU32(4) != 13 || events != 1234) return i32(7)
    failure=20
    if (p4PsramColdPageCloseOwned(cold,page,2) != 4 || events != 123445 || cold.loadU32(4) != 9) return i32(8)
    failure=0; busy=true
    if (p4PsramColdPageCloseOwned(cold,page,2) != 1 || events != 1234455) return i32(9)
    resetColdPage(cold,page)
    if (p4PsramColdPageOpenOwned(cold,page,3,524288,128,memory,95,0x48000000,0,2) != 2 || events != 0 ||
        p4PsramColdPageOpenOwned(cold,page,3,524288,128,memory,96,0x48000000,131072,2) != 2 || events != 0) return i32(10)
    return i32(0)
}
