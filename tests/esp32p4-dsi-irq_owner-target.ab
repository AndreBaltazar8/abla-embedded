import "../src/display/dsi_irq_owner_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_irq_owner_target")
trusted fun target(box: P4DsiMailbox,table: P4IrqDispatch,priority: int,lease: int,close: bool): int =
    if (close) esp32P4DsiIrqCloseOwned(box,table,lease) else esp32P4DsiIrqOpenOwned(box,table,priority)
