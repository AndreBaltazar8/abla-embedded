import "../src/esp32/psram/boot80_s3_sequence.ab"
import "../src/esp32/psram/opi_dtr_s3_sequence.ab"
import "../src/esp32/psram/command_config_s3_sequence.ab"
import "../src/esp32/psram/command_start_s3_sequence.ab"
import "../src/esp32/psram/cold_s3_sequence.ab"
import "../src/esp32/psram/calibrate80_s3_sequence.ab"
import "../src/esp32/psram/calibrated_final80_s3_sequence.ab"
import "../src/esp32/psram/final80_s3_sequence.ab"
import "../src/esp32/psram/timing_clock_s3_sequence.ab"
import "../src/esp32/psram/timing_sweep_s3_sequence.ab"
import "../src/esp32/psram/timing_sample_s3_sequence.ab"
import "../src/esp32/psram/timing_candidate_s3_sequence.ab"
import "../src/esp32/psram/mmu_s3_sequence.ab"
import "../src/esp32/psram/cache_mapping_s3_sequence.ab"
import "../src/esp32/psram/cache_enable_s3_sequence.ab"
import "../src/esp32/psram/cache_disable_s3_sequence.ab"
import "../src/esp32/psram/cache_geometry_native_s3_sequence.ab"
import "../src/esp32/psram/cache_bus_s3_sequence.ab"
import "../src/esp32/psram/cache_activate_s3_sequence.ab"
import "../src/esp32/psram/mapped_verify_s3_sequence.ab"
import "abla/build"
val biOwner=nativeStaticAllocate(676)
val biRegs=nativeStaticAllocate(65536)
val biMmu=nativeStaticAllocate(2048)
val biRam=nativeStaticAllocate(64)
val biModes=nativeStaticAllocate(16)
var biDescriptor=0
var biReady=true
var biBad=false
var biDummy0=2
var biDummy1=3
var biProtocol=0
var biFault=0
var biInjected=false
var biCommands=0
var biMappedReads=0
var biDisableI=0
var biDisableD=0
var biEnableI=0
var biEnableD=0
var biWritebacks=0
var biGeometryCalls=0
var biGeometryKib=0
var biGeometryLine=0
fun s3PsramCacheGeometryRead(address: int): int = s3PsramCsRead(address)
fun s3PsramCacheGeometryWrite(address: int,value: int): void = s3PsramCsWrite(address,value)
fun s3PsramCacheGeometryOccupy(low: int,high: int): void {
    if (biGeometryKib == 0 || low != (if (biGeometryKib == 32) 2 else 1) || high != (if (biGeometryKib == 32) 0 else 2) ||
        (s3PsramCsRead(0x600c4000)&1) != 0 || (s3PsramCsRead(0x600c4060)&1) != 0 || biCommands != 0) biBad=true
    s3PsramCacheGeometryOccupyNativeOwned(low,high)
    biGeometryCalls=biGeometryCalls+1;return
}
fun s3PsramCacheGeometryMode(size: int,ways: int,line: int): void {
    if (ways != 0 || size != (if (biGeometryKib == 32) 0 else 1) || (16<<line) != biGeometryLine) biBad=true
    s3PsramCacheGeometryModeNativeOwned(size,ways,line)
    var value=s3PsramCsRead(0x600c4000)
    if (biFault == 7 && !biInjected) { value=value^4;biInjected=true }
    s3PsramCsWrite(0x600c4000,value);return
}
fun s3PsramCacheGeometryInvalidate(): void {
    if ((s3PsramCsRead(0x600c4000)&1) != 0 || biCommands != 0) biBad=true
    s3PsramCacheInvalidateNativeOwned(false)
    return
}
fun s3PsramCommandStorageSafe(address: int,length: int): bool = address >= biOwner && length > 0 && address+length <= biOwner+676
fun s3PsramLowStorageSafe(address: int,length: int): bool = s3PsramCommandStorageSafe(address,length)
fun s3PsramMmuStorageSafe(address: int,length: int): bool = s3PsramCommandStorageSafe(address,length)
fun s3PsramCacheMappingStorageSafe(address: int,length: int): bool = s3PsramCommandStorageSafe(address,length)
fun s3PsramCacheBusStorageSafe(address: int,length: int): bool = s3PsramCommandStorageSafe(address,length)
fun s3FlashLegacyPointer(): int = 0x3fc90000
fun s3FlashDummyByteRead(address: int): int {
    if (address == 0x3fc90018) return biDummy0
    if (address != 0x3fc90019) biBad=true
    return biDummy1
}
fun s3FlashDummyByteWrite(address: int,value: int): void {
    if (address == 0x3fc90018) biDummy0=value else if (address == 0x3fc90019) biDummy1=value else biBad=true
    return
}
fun s3PsramCsRead(address: int): int {
    if (address == 0x60002000 || address == 0x60003000) return if (biReady) 0 else 0x40000
    if (address == 0x600c4130) return 0x1001
    // Zero-latency hardware completion here; standalone native-disable test
    // exercises delayed completion independently at every wait boundary.
    if (address == 0x600c404c || address == 0x600c40a0 || address == 0x600c4028) return nativeAddressLoadU32(biRegs,address&65535)|8
    if (address == 0x600c4040 || address == 0x600c4094 || address == 0x600c4088) return nativeAddressLoadU32(biRegs,address&65535)|2
    return nativeAddressLoadU32(biRegs,address&65535)
}
fun s3PsramCsWrite(address: int,value: int): void {
    if (address == 0x60002000 && value == 0x40000) { biTransfer();return }
    var stored=value
    if (biFault == 1 && !biInjected && nativeAddressLoadU32(biOwner,4) == 5) { stored=value^1;biInjected=true }
    if (biFault == 4 && !biInjected && nativeAddressLoadU32(biOwner,4) == 7) { stored=value^1;biInjected=true }
    nativeAddressStoreU32(biRegs,address&65535,stored);return
}
fun s3PsramCommandReady(): bool = biReady
fun s3PsramOpiRead(address: int): int = s3PsramCsRead(address)
fun s3PsramOpiWrite(address: int,value: int): void = s3PsramCsWrite(address,value)
fun s3PsramOpiDtrMode(): void = s3PsramOpiDtrNativeOwned()
fun s3PsramCommandConfigure(unit: int,descriptor: int): void {
    if (unit != 1 || (descriptor != biOwner+540 && descriptor != biOwner+400)) biBad=true
    biDescriptor=descriptor;s3PsramCommandConfigNativeOwned(unit,descriptor);return
}
fun s3PsramCommandStart(rx: int,length: int): void {
    s3PsramCommandStartNativeOwned(rx,length)
    if (biFault == 2 && !biInjected && nativeAddressLoadU32(biOwner,4) == 4) { biReady=false;biInjected=true }
    return
}
fun biTransfer(): void {
    val work=nativeBufferAt(biDescriptor,100);val modes=nativeBufferAt(biModes,16);val ram=nativeBufferAt(biRam,64)
    val fifo=nativeBufferAt(biRegs+0x2058,64)
    val length=work.loadU32(24)/8
    val command=work.loadU32(0)&65535;val address=work.loadU32(32)
    if ((s3PsramCsRead(0x60002034)&3) != 1 || s3PsramCsRead(0x60002004) != address ||
        (s3PsramCsRead(0x60002020)&0xf000ffff) != (0xf0000000|command)) biBad=true
    if ((work.loadU32(0)>>>16) != 16 || work.loadU32(8) != 32) biBad=true
    if (command == 0x4040) {
        if (address > 8 || work.loadU32(28) != 8) biBad=true
        var i=0
        while (i < length) { fifo.store(i,modes.load(address+i));i=i+1 }
    } else if (command == 0xc0c0) {
        if (address != 0 || work.loadU32(16) != 16) biBad=true
        modes.store(0,fifo.load(0));modes.store(1,fifo.load(1))
    } else if (command == 0x8080) {
        val bytes=work.loadU32(16)/8
        if (address+bytes > 64 || work.loadU32(28) != 8) biBad=true
        var i=0
        while (i < bytes) { ram.store(address+i,fifo.load(i));i=i+1 }
    } else if (command == 0) {
        if (address+length > 64 || work.loadU32(28) != 18) biBad=true
        val mode=s3PsramCsRead(0x600030c0)&7;val number=s3PsramCsRead(0x600030c4)&3
        // Current command is OPI regardless of the flash chip's protocol.
        if ((s3PsramCsRead(0x6000201c)&63) != 17) biBad=true
        val cal=s3PsramCsRead(0x600020a8)
        val extra=if ((cal&2) == 0) 0 else (cal>>>2)&7
        val packed=mode|(number<<3)|(extra<<5)
        val high=(s3PsramCsRead(0x600030ec)&3) == 2
        val good=!high || (biFault != 6 && (packed == 76 || packed == 33 || packed == 68 || packed == 32))
        var i=0
        while (i < length) { fifo.store(i,ram.load(address+i)^(if (!good && i == 0) 1 else 0));i=i+1 }
    } else biBad=true
    biCommands=biCommands+1
    return
}
fun s3PsramTimingFifoWrite(word: int,value: int): void {
    if (word < 0 || word > 15 || value != 0) biBad=true
    s3PsramCsWrite(0x60002058+word*4,value);return
}
fun s3PsramBootPhysicalBytes(cold: NativeBuffer): int {
    val identity=s3PsramIdentityFrom(nativeBufferAt(cold.addressValue()+32,6))
    return if (identity.good()) identity.physicalBytes() else 0
}
fun s3PsramMmuRead(entry: int): int = nativeAddressLoadU32(biMmu,entry*4)
fun s3PsramMmuWrite(entry: int,value: int): void {
    var stored=value
    if (biFault == 3 && !biInjected) { stored=value^1;biInjected=true }
    nativeAddressStoreU32(biMmu,entry*4,stored);return
}
fun s3PsramCacheMappingRead(address: int): int = s3PsramCsRead(address)
fun s3PsramCacheMappingWrite(address: int,value: int): void = s3PsramCsWrite(address,value)
fun s3PsramCacheBusRead(address: int): int = s3PsramCsRead(address)
fun s3PsramCacheBusWrite(address: int,value: int): void = s3PsramCsWrite(address,value)
fun s3PsramCacheMappingWriteback(): void {
    biWritebacks=biWritebacks+1
    if ((s3PsramCsRead(0x600c4000)&1) == 0) biBad=true
    s3PsramCacheWritebackNativeOwned();return
}
fun s3PsramCacheMappingDisable(instruction: bool): int {
    if (instruction) biDisableI=biDisableI+1 else biDisableD=biDisableD+1
    return s3PsramCacheDisableNativeOwned(instruction)
}
fun s3PsramCacheMappingEnable(instruction: bool,state: int): void {
    if (instruction) { if (state != 4) biBad=true;biEnableI=biEnableI+1 }
    else { if (state != 0 && state != 4) biBad=true;biEnableD=biEnableD+1 }
    s3PsramCacheEnableNativeOwned(instruction,state);return
}
fun s3PsramMappedRead(address: int): int {
    if (address == 0x600c4000 || address == 0x600c4004) return s3PsramCsRead(address)
    if (address < 0x3c100000 || address >= 0x3c100040 || s3PsramMmuRead(16) != 32768 ||
        (s3PsramCsRead(0x600c4000)&1) == 0 || (s3PsramCsRead(0x600c4004)&3) != 0) biBad=true
    biMappedReads=biMappedReads+1
    return nativeAddressLoadU32(biRam,address-0x3c100000)^(if (biFault == 5) 1 else 0)
}
fun biReset(flags: int): void {
    nativeAddressStoreU32(biOwner,0,0)
    var i=0
    while (i < 65536) { nativeAddressStoreU32(biRegs,i,0xa55a5aa5);i=i+4 }
    i=0
    while (i < 512) { nativeAddressStoreU32(biMmu,i*4,16384);i=i+1 }
    val modes=nativeBufferAt(biModes,16)
    modes.store(0,192);modes.store(1,13);modes.store(2,0x81);modes.store(3,0x60);modes.store(4,0x20);modes.store(8,3)
    nativeAddressStoreU32(biRegs,0x4060,flags&1);nativeAddressStoreU32(biRegs,0x4000,(flags>>>1)&1)
    nativeAddressStoreU32(biRegs,0x4004,3)
    biDummy0=2;biDummy1=3;biReady=true;biBad=false;biInjected=false;biCommands=0;biMappedReads=0
    biDisableI=0;biDisableD=0;biEnableI=0;biEnableD=0;biWritebacks=0;biGeometryCalls=0;return
}
fun biRun(): int = s3PsramBoot80Owned(nativeBufferAt(biOwner,676),0x3c100000,65536,4194304,80,biProtocol,0,5,3,true)
fun biConfiguredRun(): int = s3PsramBoot80ConfiguredOwned(nativeBufferAt(biOwner,676),0x3c100000,65536,4194304,80,biProtocol,0,5,3,biGeometryKib,biGeometryLine,true)
@export("abla_s3_psram_boot80_integrated_test")
fun testBootIntegrated(): int {
    biProtocol=0
    while (biProtocol <= 2) {
        var flags=0
        while (flags < 4) {
            var fault=0
            while (fault <= 6) {
                biFault=fault;biReset(flags)
                val result=biRun()
                if (biBad) return 1
                if (fault == 0) { if (result != 1) return 2 }
                else if (fault == 6) {
                    if (result != 5 || nativeAddressLoadU32(biOwner,4) != 4 || nativeAddressLoadU32(biOwner,164) != 9 || biMappedReads != 0) return 3
                } else {
                    val stage=if (fault == 1) 5 else if (fault == 2) 4 else if (fault == 3) 6 else if (fault == 4) 7 else 10
                    if (result == 1 || nativeAddressLoadU32(biOwner,4) != stage) return 4
                    biFault=0;biReady=true
                    if (biRun() != 1 || biBad) return 5
                }
                if (fault != 6) {
                    if (nativeAddressLoadU32(biOwner,4) != 11 || biDisableI != 1 || biDisableD != 1 ||
                        biEnableI != (flags&1) || biEnableD != 1 || biWritebacks != ((flags>>>1)&1) || biMappedReads < 16) return 6
                    if ((s3PsramCsRead(0x600c40a0)&4) != (if ((flags&1) != 0) 4 else 0) ||
                        (s3PsramCsRead(0x600c404c)&4) != (if ((flags&2) != 0) 4 else 0)) return 16
                    val calls=biCommands
                    if (biRun() != 1 || biCommands != calls) return 7
                }
                fault=fault+1
            }
            flags=flags+1
        }
        biProtocol=biProtocol+1
    }
    biProtocol=0
    var geometry=0
    while (geometry < 6) {
        biGeometryKib=if (geometry < 3) 32 else 64;biGeometryLine=16<<(geometry%3)
        var flags=0
        while (flags < 4) {
            var failure=0
            while (failure < 2) {
                biFault=if (failure == 0) 0 else 7;biReset(flags)
                val result=biConfiguredRun()
                if (failure == 1) {
                    if (result != 4 || nativeAddressLoadU32(biOwner,4) != 1 || biCommands != 0 || biGeometryCalls != 1) return 8
                    if (biRun() != 2) return 9
                    biFault=0
                    if (biConfiguredRun() != 1) return 10
                } else if (result != 1) return 11
                val expected=((if (geometry < 3) 0 else 1)<<2)|((geometry%3)<<3)|1
                if (biBad || (s3PsramCsRead(0x600c4000)&29) != expected || biGeometryCalls != 1+failure || biDisableI != 1 || biDisableD != 1) return 12
                failure=failure+1
            }
            flags=flags+1
        }
        geometry=geometry+1
    }
    return 0
}
