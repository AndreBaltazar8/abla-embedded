import "../src/esp32/crypto/aes_hal_primitives_esp32.ab"
import "abla/unsafe/memory"

trusted noescape extern:"c" fun mmap(
    address: i64*, length: int, protection: i32,
    flags: i32, fileDescriptor: i32, offset: int
): i64*
trusted noescape extern:"c" fun munmap(address: i64*, length: int): i32

trusted fun main(): int {
    // Anonymous emulated MMIO; NOREPLACE never overwrites an existing mapping.
    val base = 0x3ff01000
    val allocation = mmap(nativePointerFromAddress(base), 4096,
        i32(3), i32(0x100022), i32(-1), 0)
    if (nativePointerAddress(allocation) != base) return 1
    val key = base + 258
    var byte = 0
    while (byte < 32) {
        ablaUnsafeStoreU8(nativePointerFromAddress(key + byte), byte * 7 + 3)
        byte = byte + 1
    }
    var size = 16
    while (size <= 32) {
        var mode = 0
        while (mode <= 1) {
            var word = 0
            while (word < 8) {
                register32(base + 16 + word * 4).write(0x5a5a5a5a)
                word = word + 1
            }
            if (esp32AesHalSetkey(u32(key), u32(size), i32(mode)) != u32(size)) return 2
            val expectedMode = (if (mode == 1) 0 else 4) + size / 8 - 2
            if (register32(base + 8).read() != expectedMode) return 3
            word = 0
            while (word < 8) {
                var expected = u32(0x5a5a5a5a)
                if (word < size / 4) {
                    val first = word * 4
                    expected = u32(first * 7 + 3) |
                        (u32((first + 1) * 7 + 3) << u32(8)) |
                        (u32((first + 2) * 7 + 3) << u32(16)) |
                        (u32((first + 3) * 7 + 3) << u32(24))
                }
                if (u32(register32(base + 16 + word * 4).read()) != expected) return 4
                word = word + 1
            }
            mode = mode + 1
        }
        size = size + 8
    }
    if (munmap(allocation, 4096) != i32(0)) return 5
    return 0
}
