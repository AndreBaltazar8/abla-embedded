import "../src/esp32/power/sleep_prepare_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_prepare_target")
@section(".iram1.abla.s3SleepPrepareTarget")
trusted fun prepareTarget(record: NativeBuffer,bias: Esp32S3ClockBias,ports: int,octal: bool,ram: int,protocol: int,baseline: int,polls: int): int =
    esp32S3SleepPrepareOwned(record,bias,ports,octal,ram,protocol,baseline,polls)
