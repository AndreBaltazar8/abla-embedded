import "../src/sd/block_c61_sequence.ab"
import "abla/build"
val memory=nativeStaticAllocate(528)
var csHigh=true
var busy=false
var calls=0
var failAt=0
var failBusy=false
var csWrites=0
var csFail=0
var highClocks=0
var phase=0
var packet=0
var bad=false
var fast=false
var failed=false
fun device(): Esp32C61SpiMaster =
    Esp32C61SpiMaster(25|(27<<5)|(26<<10)|(28<<15)|(1<<24)|(15<<32)|(1<<49)|(1<<59))
fun c61SpiRead(address: int): u32 {
    if (address == 0x60096094) return u32(5)
    if (address == 0x60096098) return u32(1<<22)
    if (address == 0x60081000) return if (busy) u32(1<<24) else u32(0)
    if (address == 0x6008100c) return if (fast) u32(0x80000000) else u32((9<<18)|(9<<12)|(4<<6)|9)
    if (address == 0x60081020 || address == 0x60081010 || address == 0x60081008 ||
        address == 0x60081030 || address == 0x60081034 || address == 0x600810e0 || address == 0x6008103c) return u32(0)
    bad=true;return u32(0)
}
fun c61SpiWrite(address: int,value: u32): void { bad=true;return }
fun c61GpioRead(address: int): u32 {
    if (address == 0x60091034) return u32((1<<28)|(1<<25)|(1<<27))
    if (address == 0x60091004) return if (csHigh) u32(1<<28) else u32(0)
    if (address == 0x60091ad4+28*4) return u32(1280)
    if (address == 0x60090000+28*4 || address == 0x60090000+25*4 || address == 0x60090000+27*4) return u32(4096)
    if (address == 0x60090000+26*4) return u32(4608)
    if (address == 0x60091ad4+25*4) return u32(1088)
    if (address == 0x60091ad4+27*4) return u32(1090)
    if (address == 0x600913d8) return u32(282)
    if (address == 0x600910d4+25*4 || address == 0x600910d4+27*4 ||
        address == 0x600910d4+28*4 || address == 0x600b102c) return u32(0)
    bad=true;return u32(0)
}
fun c61GpioWrite(address: int,value: u32): void {
    csWrites=csWrites+1
    if (value != u32(1<<28) || busy) bad=true
    if (csWrites == csFail) return
    if (address == 0x60091008) csHigh=true
    else if (address == 0x6009100c) { if (highClocks != 10) bad=true;csHigh=false }
    else bad=true
    return
}
fun resetStartup(): void {
    nativeAddressStoreU32(memory,0,0);csHigh=true;busy=false;calls=0;failAt=0;failBusy=false
    csWrites=0;csFail=0;highClocks=10;phase=0;packet=0;bad=false;fast=false;failed=false;return
}

var writeMode=false
fun sdSpiSelectedAdmission(context: int,scratch: NativeBuffer,response: NativeBuffer,bytes: int): bool =
    context == (device()|0) && !csHigh && !busy
fun sdSpiSelectedDelay(us: int): void { if (us != 1000) bad=true;return }
fun frameByte(command: int,argument: int,index: int): int =
    if (index == 0) 64|command else if (index == 5) sdSpiCommandFrameCrc(command,argument)
    else (argument>>>((4-index)*8))&255
fun sdSpiSelectedExchange(context: int,value: int,scratch: NativeBuffer): int {
    calls=calls+1
    if (peripheralGateAt(memory).tryBegin(u32(99)) != 1 || context != (device()|0) || busy) bad=true
    if (calls == failAt) { failed=true;busy=failBusy;return 263 }
    if (csHigh) { if (value != 255) bad=true;return (1<<32)|255 }
    if (failed) bad=true
    if (writeMode) {
        val expected=if (calls >= 2 && calls <= 7) frameByte(24,3,calls-2)
            else if (calls == 9) 254 else if (calls == 522) 127 else if (calls == 523) 161
            else if (calls >= 527 && calls <= 532) frameByte(13,0,calls-527) else 255
        if (value != expected) bad=true
        val input=if (calls == 8 || calls == 525 || calls == 533 || calls == 534) 0 else if (calls == 524) 5 else 255
        return (1<<32)|input
    }
    val expected=if (calls <= 6) frameByte(17,3,calls-1) else 255
    if (value != expected) bad=true
    val input=if (calls == 7) 0 else if (calls == 10) 254 else if (calls == 523) 127 else if (calls == 524) 161 else 255
    return (1<<32)|input
}
@export("abla_sd_block_c61_test")
trusted fun testBlock(): i32 {
    val gate=peripheralGateAt(memory);val scratch=nativeBufferAt(memory+4,2);val payload=nativeBufferAt(memory+16,512)
    val state=SdSpiInitResult(1|(1<<24)|(1<<25))
    var mode=0
    while (mode < 2) {
        writeMode=mode == 1
        resetStartup()
        var index=0
        while (index < 512) { payload.store(index,255);index=index+1 }
        val good=if (writeMode) device().writeSdBlock(gate,u32(7),40000000,state,3,scratch,payload,4)|0
            else device().readSdBlock(gate,u32(7),40000000,state,3,scratch,payload,4)|0
        val total=if (writeMode) 535 else 525
        if ((good&255) != 1 || !csHigh || csWrites != 2 || calls != total || bad) return i32(1)
        var failure=1
        while (failure <= total) {
            var stuck=0
            while (stuck < 2) {
                resetStartup();failAt=failure;failBusy=stuck == 1
                val result=if (writeMode) device().writeSdBlock(gate,u32(7),40000000,state,3,scratch,payload,4)|0
                    else device().readSdBlock(gate,u32(7),40000000,state,3,scratch,payload,4)|0
                val pending=(result&(1<<31)) != 0
                val count=if (writeMode) SdSpiWriteResult(result).transmittedBytes() else SdSpiReadResult(result).receivedBytes()
                val prefix=if (writeMode) (if (failure <= 10) 0 else if (failure <= 522) failure-10 else 512)
                    else (if (failure <= 11) 0 else if (failure <= 523) failure-11 else 512)
                if ((result&255) != (if (failure == total) 16 else 4) || (result>>>32) != 263 ||
                    pending != (stuck == 1 || failure == total) || count != prefix || bad) return i32(2)
                if (writeMode && SdSpiWriteResult(result).mayHaveWritten() != (failure >= 9)) return i32(3)
                if (stuck == 1 && failure < total && csHigh) return i32(4)
                if (stuck == 0 && !csHigh) return i32(5)
                val previous=calls
                if (device().readSdBlock(gate,u32(8),40000000,state,3,scratch,payload).status() != 12 || calls != previous) return i32(6)
                stuck=stuck+1
            }
            failure=failure+1
        }
        failure=1
        while (failure <= 2) {
            resetStartup();csFail=failure
            val result=if (writeMode) device().writeSdBlock(gate,u32(7),40000000,state,3,scratch,payload,4)|0
                else device().readSdBlock(gate,u32(7),40000000,state,3,scratch,payload,4)|0
            if ((result&255) != 15 || ((result&(1<<31)) != 0) != (failure == 2) || bad) return i32(7)
            failure=failure+1
        }
        mode=mode+1
    }
    resetStartup();fast=true
    if (device().readSdBlock(gate,u32(7),40000000,state,3,scratch,payload).status() != 14 || calls != 0 || csWrites != 0 || bad) return i32(8)
    resetStartup()
    if (device().readSdBlock(gate,u32(7),40000000,SdSpiInitResult(0),3,scratch,payload).status() != 2 ||
        device().writeSdBlock(gate,u32(7),40000000,state,3,scratch,nativeBufferAt(memory,512)).status() != 2 || calls != 0) return i32(9)
    if (gate.tryBegin(u32(1)) != 0 || device().readSdBlock(gate,u32(7),40000000,state,3,scratch,payload).status() != 11 ||
        calls != 0 || !gate.finish(u32(1),true)) return i32(10)
    return i32(0)
}
