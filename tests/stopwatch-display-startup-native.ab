import "../src/m5stack/stopwatch_display_startup_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val gateStorage=nativeStaticAllocate(4)
var stage=2
var failed=0
var rotation=0
var brightness=0
var bad=false
var teCalls=0
fun stopWatchDisplayPrepareTe(): int {
    if (stage != 4 || teCalls != 0) bad=true
    teCalls=teCalls+1;return if (failed == 9) 4 else 1
}
fun stopWatchDisplayAdmission(control: int,gate: PeripheralGate): bool =
    control == 7 && gate.word().address() == gateStorage && nativeAddressLoadU32(gateStorage,0) == 0
fun next(expected: int): bool { stage=stage+1;if (stage != expected) bad=true;return stage != failed }
fun stopWatchDisplayPower(control: int): int {
    if (control != 7) bad=true
    return if (next(3)) 2561 else 4|(6<<8)
}
fun transaction(expected: int,gate: PeripheralGate,owner: u32): SpiTransactionResult {
    if (expected >= 5 && teCalls != 1) bad=true
    if (gate.word().address() != gateStorage || owner != u32(37)) bad=true
    return SpiTransactionResult(if (next(expected)) (1<<32)|257 else (6<<32)|0x20109)
}
fun stopWatchDisplaySpi(gate: PeripheralGate,owner: u32): SpiTransactionResult = transaction(4,gate,owner)
fun stopWatchDisplayPanel(gate: PeripheralGate,owner: u32): SpiTransactionResult = transaction(5,gate,owner)
fun stopWatchDisplayRotation(gate: PeripheralGate,owner: u32,requested: int): SpiTransactionResult {
    if (requested != rotation) bad=true
    return transaction(6,gate,owner)
}
fun stopWatchDisplayClear(gate: PeripheralGate,owner: u32,requested: int): SpiTransactionResult {
    if (requested != rotation) bad=true
    return transaction(7,gate,owner)
}
fun stopWatchDisplayBrightness(gate: PeripheralGate,owner: u32,requested: int): SpiTransactionResult {
    if (requested != brightness) bad=true
    return transaction(8,gate,owner)
}
@export("abla_stopwatch_display_startup_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateStorage)
    var variant=0
    while (variant < 16) {
        rotation=variant&7;brightness=if ((variant&8) == 0) 0 else 255
        failed=0
        while (failed <= 9) {
            if (failed == 0 || failed >= 3) {
                stage=2;bad=false;teCalls=0
                val result=stopWatchDisplayStartupOwned(7,gate,u32(37),rotation,brightness,true)
                if (result.status() != (if (failed == 0) 1 else failed) || bad ||
                    stage != (if (failed == 0) 8 else if (failed == 9) 4 else failed) ||
                    teCalls != (if (failed == 3 || failed == 4) 0 else 1) ||
                    result.detail() != (if (failed == 0) 0 else if (failed == 9) 4 else if (failed == 3) 4|(6<<8) else (6<<32)|0x20109)) return i32(1)
            }
            failed=failed+1
        }
        variant=variant+1
    }
    stage=2
    if (stopWatchDisplayStartupOwned(7,gate,u32(37),0,0,false).status() != 2 ||
        stopWatchDisplayStartupOwned(0,gate,u32(37),0,0,true).status() != 2 ||
        stopWatchDisplayStartupOwned(7,gate,u32(0),0,0,true).status() != 2 ||
        stopWatchDisplayStartupOwned(7,gate,u32(37),-1,0,true).status() != 2 ||
        stopWatchDisplayStartupOwned(7,gate,u32(37),8,0,true).status() != 2 ||
        stopWatchDisplayStartupOwned(7,gate,u32(37),0,-1,true).status() != 2 ||
        stopWatchDisplayStartupOwned(7,gate,u32(37),0,256,true).status() != 2 || stage != 2) return i32(2)
    nativeAddressStoreU32(gateStorage,0,2147483648)
    if (stopWatchDisplayStartupOwned(7,gate,u32(37),0,0,true).status() != 2 || stage != 2) return i32(3)
    return i32(0)
}
