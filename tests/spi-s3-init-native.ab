import "../src/spi/pins.ab"
import "../src/esp32/spi/master_init_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
var transmitOnly=false
var stage = 0
var writes = 0
var failAt = 0
var updates = 0
var updateAt = 1
var routeResult = 1
var bad = false
fun esp32s3SpiMasterPinsValid(peripheral: int, pins: SpiPins, select: Pin): bool =
    peripheral == 2 && pins == spiPins(37, 35, 36) && select == 3
fun esp32s3SpiBase(peripheral: int): int = 0x60024000
trusted fun Pin.outputLevelOwned(level: bool): bool { if (this != 3 || !level || stage != 0) bad = true; stage = 3; return failAt != 3 }
trusted fun esp32s3SpiEnableBusClock(peripheral: int, owner: u32): bool {
    if (stage != 3 || peripheral != 2 || owner != u32(41)) bad = true
    stage = 4; failAt != 4
}
trusted fun esp32s3SpiCpuBufferIdle(base: int): bool {
    if (base != 0x60024000 || stage != 4) bad = true
    stage = 5; failAt != 5
}
trusted fun esp32s3SpiWrite(address: int, value: int): void {
    if (stage == 5) {
        val offset = if (writes == 0) 0x34 else if (writes == 1) 0x38 else if (writes == 2) 0xe0 else
            if (writes == 3) 8 else if (writes == 4) 16 else if (writes == 5) 20 else
            if (writes == 6) 24 else if (writes == 7) 32 else if (writes == 8) 36 else
            if (writes == 9) 40 else if (writes == 10) 44 else 48
        val expected = if (writes == 1) 0x7ffff else if (writes == 5) 0x10000 else
            if (writes == 6) 0x08000000 else if (writes == 7) 63 else if (writes == 11) 0x180000 else 0
        if (address != 0x60024000 + offset || value != expected || writes >= 12) bad = true
        writes = writes + 1
    } else {
        if (stage != 7 || address != 0x60024000 || value != 0x00800000) bad = true
        stage = 8
    }
    return
}
trusted fun esp32s3SpiConfigureClockOwned(peripheral: int, source: int, pre: int, cycles: int, high: int): bool {
    if (stage != 5 || writes != 12 || peripheral != 2 || source != 1 || pre != 1 || cycles != 16 || high != 8) bad = true
    stage = 6; failAt != 6
}
trusted fun esp32s3SpiConfigureModeOwned(peripheral: int, mode: int, tx: bool, rx: bool): bool {
    if (stage != 6 || peripheral != 2 || mode != 0 || tx || rx) bad = true
    stage = 7; failAt != 7
}
trusted fun esp32s3SpiRead(address: int): int {
    if (address != 0x60024000 || stage != 8) bad = true
    updates = updates + 1
    if (updates < updateAt) 0x00800000 else 0
}
trusted fun esp32s3SpiRouteMasterPinsOwned(peripheral: int, pins: SpiPins, select: Pin): int {
    if (stage != 8 || updates < updateAt || !esp32s3SpiMasterPinsValid(peripheral, pins, select)) bad = true
    stage = 9; routeResult
}
trusted fun resetInit(): void { stage = 0; writes = 0; updates = 0; return }
trusted fun runInit(): int =
    if (transmitOnly) esp32s3SpiInitializeTransmitOwned(2,spiPins(37,-1,36),Pin(3),1,1,16,0,u32(41),4)
    else esp32s3SpiInitializeMasterOwned(2, spiPins(37, 35, 36), Pin(3), 1, 1, 16, 0, u32(41), 4)
trusted fun initCases(): int {
    resetInit();updateAt=1;routeResult=1;bad=false
    failAt = 3
    if (runInit() != (8 | (6 << 8)) || stage != 3 || writes != 0 || bad) return 5
    failAt = 0
    while (updateAt <= 5) {
        resetInit()
        if (runInit() != (if (updateAt <= 4) 1 else 7) ||
            stage != (if (updateAt <= 4) 9 else 8) || bad) return 1
        updateAt = updateAt + 1
    }
    updateAt = 1; failAt = 4
    while (failAt <= 7) {
        resetInit()
        if (runInit() != failAt - 1 || stage != failAt || bad || (failAt <= 5 && writes != 0)) return 2
        failAt = failAt + 1
    }
    failAt = 0; routeResult = 2
    while (routeResult <= 5) {
        resetInit()
        if (runInit() != (8 | (routeResult << 8)) || stage != 9 || bad) return 3
        routeResult = routeResult + 1
    }
    resetInit()
    if (esp32s3SpiInitializeMasterOwned(2, spiPins(37, 35, 36), Pin(3), 1, 1, 16, 0, u32(0), 4) != 2 ||
        esp32s3SpiInitializeMasterOwned(2, spiPins(37, 35, 36), Pin(3), 1, 2, 1, 0, u32(41), 4) != 2 ||
        esp32s3SpiInitializeMasterOwned(2, spiPins(37, 35, 36), Pin(3), 1, 1, 16, 0, u32(41), 0) != 2 || stage != 0) return 4
    0
}
fun esp32s3SpiTransmitPinsValid(peripheral: int,pins: SpiPins,select: Pin): bool =
    peripheral == 2 && pins == spiPins(37,-1,36) && select == 3
trusted fun esp32s3SpiRouteTransmitPinsOwned(peripheral: int,pins: SpiPins,select: Pin): int {
    if (!transmitOnly || stage != 8 || updates < updateAt || !esp32s3SpiTransmitPinsValid(peripheral,pins,select)) bad=true
    stage=9;return routeResult
}
trusted fun initTest(): int {
    transmitOnly=false
    val full=initCases()
    if (full != 0) return full
    transmitOnly=true
    val tx=initCases()
    if (tx != 0) return 10+tx
    resetInit()
    if (esp32s3SpiInitializeMasterOwned(2,spiPins(37,-1,36),Pin(3),1,1,16,0,u32(41),4) != 2 ||
        esp32s3SpiInitializeTransmitOwned(2,spiPins(37,-2,36),Pin(3),1,1,16,0,u32(41),4) != 2 || stage != 0) return 20
    return 0
}
#exportFunction("initTest", "abla_spi_init_test")
