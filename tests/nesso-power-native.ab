import "../src/m5stack/nesso_power_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(40)
var fail=0
var closeFail=0
var live=0
var setup=0
var closes=0
var bad=false
fun nessoPowerStorageSafe(buffer: NativeBuffer): bool = true
fun nessoPowerBusCurrent(bus: int): bool = bus == 7
fun m5ExpanderBusValid(bus: int): bool = bus == 7
fun m5PmicBusValid(bus: int): bool = bus == 7
fun m5ExpanderAllocate(bus: int,address: int,hz: int): int {
    if (bus != 7 || address != 67 || hz != 400000) bad=true
    if (fail == 1) return 0
    live=live|1;return 11
}
fun m5ExpanderBegin(handle: int,kind: int): bool { if (handle != 11 || kind != 1) bad=true;return fail != 2 }
fun m5PmicAllocate(bus: int,address: int,hz: int): int {
    if (bus != 7 || address != 73 || hz != 400000) bad=true
    if (fail == 3) return 0
    live=live|2;return 12
}
fun m5PmicBegin(handle: int,kind: int): int { if (handle != 12 || kind != 6) bad=true;return if (fail == 4) 0 else 6 }
fun nessoPowerGaugeAllocate(bus: int): int { if (bus != 7) bad=true;if (fail == 5) return 0;live=live|4;return 13 }
fun release(bit: int): bool {
    closes=closes+1
    if ((live&bit) == 0) bad=true
    if (closeFail == bit) return false
    live=live&~bit;return true
}
fun m5ExpanderClose(handle: int): bool { if (handle != 11) bad=true;return release(1) }
fun m5PmicClose(handle: int): bool { if (handle != 12) bad=true;return release(2) }
fun nessoPowerGaugeClose(handle: int): bool { if (handle != 13) bad=true;return release(4) }
fun step(): bool {
    setup=setup+1
    val owner=nessoPowerAt(nativeBufferAt(storage,40))
    if (owner.openOwned(7,true) != 2 || owner.closeOwned(true) || owner.gaugeHandle() != 0) bad=true
    return fail != setup+5
}
fun c6PowerWrite(handle: int,reg: int,value: int): bool {
    if (handle != 11 || reg != c6PowerRegister(setup) || value != c6PowerValue(setup)) bad=true
    return step()
}
fun c6PowerChargeEnable(handle: int): bool { if (handle != 12 || setup != 7) bad=true;return step() }
fun c6PowerChargeCurrent(handle: int): bool { if (handle != 12 || setup != 8) bad=true;return step() }
fun c6PowerChargeVoltage(handle: int): bool { if (handle != 12 || setup != 9) bad=true;return step() }
fun c6PowerGaugeBegin(handle: int): bool { if (handle != 13 || setup != 10) bad=true;return step() }
@export("abla_nesso_power_test")
trusted fun testPower(): i32 {
    val owner=nessoPowerAt(nativeBufferAt(storage,40))
    fail=0
    while (fail <= 16) {
        var closeChoice=0
        while (closeChoice < 4) {
            closeFail=if (closeChoice == 0) 0 else if (closeChoice == 1) 1 else if (closeChoice == 2) 2 else 4
            live=0;setup=0;closes=0;bad=false
            if (!owner.initialize() || owner.openOwned(8,true) != 2 || owner.openOwned(7,false) != 2 || live != 0) return i32(1)
            val expected=if (fail == 0) 1 else if (fail <= 2) 3 else if (fail <= 4) 4 else if (fail == 5) 5 else 6
            if (owner.openOwned(7,true) != expected || owner.ready() != (fail == 0) || bad) return i32(2)
            if (fail >= 6 && (setup != fail-5 || owner.setupResult().appliedSteps() != fail-6)) return i32(3)
            if (fail == 0 && (setup != 11 || owner.gaugeHandle() != 13 || !owner.setupResult().valid())) return i32(4)
            val before=closes
            if (owner.closeOwned(false) || closes != before || owner.openOwned(7,true) != 2) return i32(5)
            val blocked=closeFail != 0 && (live&closeFail) != 0
            if (owner.closeOwned(true) == blocked || (blocked && (owner.phase() != 2 || live == 0)) || bad) return i32(6)
            closeFail=0
            if (!owner.closeOwned(true) || live != 0 || owner.phase() != 0 || owner.gaugeHandle() != 0 || bad) return i32(7)
            if (fail != 0 && owner.openFailure() != expected) return i32(8)
            closeChoice=closeChoice+1
        }
        fail=fail+1
    }
    return i32(0)
}
