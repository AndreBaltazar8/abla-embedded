import "../src/m5stack/nesso_power_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/hal/m5stack.ab"
import "abla/unsafe/memory/raw"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/m5stack/c6_power_sequence.ab"
import "../src/hal/native_buffer.ab"
import "../src/esp32/sdk/nativebuffer_type.ab"
val storage=nativeStaticAllocate(40)
var fail=0
var closeFail=0
var live=0
var setup=0
var closes=0
var bad=false
@export("nessoPowerStorageSafe")
fun nessoPowerStorageSafeHook(buffer: NativeBuffer): bool = true
@export("nessoPowerBusCurrent")
fun nessoPowerBusCurrentHook(bus: int): bool = bus == 7
@export("m5ExpanderBusValid")
fun m5ExpanderBusValidHook(bus: int): bool = bus == 7
@export("m5PmicBusValid")
fun m5PmicBusValidHook(bus: int): bool = bus == 7
@export("m5ExpanderAllocate")
fun m5ExpanderAllocateHook(bus: int,address: int,hz: int): int {
    if (bus != 7 || address != 67 || hz != 400000) bad=true
    if (fail == 1) return 0
    live=live|1;return 11
}
@export("m5ExpanderBegin")
fun m5ExpanderBeginHook(handle: int,kind: int): bool { if (handle != 11 || kind != 1) bad=true;return fail != 2 }
@export("m5PmicAllocate")
fun m5PmicAllocateHook(bus: int,address: int,hz: int): int {
    if (bus != 7 || address != 73 || hz != 400000) bad=true
    if (fail == 3) return 0
    live=live|2;return 12
}
@export("m5PmicBegin")
fun m5PmicBeginHook(handle: int,kind: int): int { if (handle != 12 || kind != 6) bad=true;return if (fail == 4) 0 else 6 }
@export("nessoPowerGaugeAllocate")
fun nessoPowerGaugeAllocateHook(bus: int): int { if (bus != 7) bad=true;if (fail == 5) return 0;live=live|4;return 13 }
fun release(bit: int): bool {
    closes=closes+1
    if ((live&bit) == 0) bad=true
    if (closeFail == bit) return false
    live=live&~bit;return true
}
@export("m5ExpanderClose")
fun m5ExpanderCloseHook(handle: int): bool { if (handle != 11) bad=true;return release(1) }
@export("m5PmicClose")
fun m5PmicCloseHook(handle: int): bool { if (handle != 12) bad=true;return release(2) }
@export("nessoPowerGaugeClose")
fun nessoPowerGaugeCloseHook(handle: int): bool { if (handle != 13) bad=true;return release(4) }
fun step(): bool {
    setup=setup+1
    val owner=nessoPowerAt(nativeBufferAt(storage,40))
    if (owner.openOwned(7,true) != 2 || owner.closeOwned(true) || owner.gaugeHandle() != 0) bad=true
    return fail != setup+5
}
@export("c6PowerWrite")
fun c6PowerWriteHook(handle: int,reg: int,value: int): bool {
    if (handle != 11 || reg != c6PowerRegister(setup) || value != c6PowerValue(setup)) bad=true
    return step()
}
@export("c6PowerChargeEnable")
fun c6PowerChargeEnableHook(handle: int): bool { if (handle != 12 || setup != 7) bad=true;return step() }
@export("c6PowerChargeCurrent")
fun c6PowerChargeCurrentHook(handle: int): bool { if (handle != 12 || setup != 8) bad=true;return step() }
@export("c6PowerChargeVoltage")
fun c6PowerChargeVoltageHook(handle: int): bool { if (handle != 12 || setup != 9) bad=true;return step() }
@export("c6PowerGaugeBegin")
fun c6PowerGaugeBeginHook(handle: int): bool { if (handle != 13 || setup != 10) bad=true;return step() }
@export("abla_nesso_power_test")
trusted fun testPower(): i32 {
    val owner=nessoPowerAt(nativeBufferAt(storage,40))
    fail=0
    while (fail <= 16) {
        var closeChoice=0
        while (closeChoice < 4) {
            closeFail=if (closeChoice == 0) 0 else if (closeChoice == 1) 1 else if (closeChoice == 2) 2 else 4
            live=0;setup=0;closes=0;bad=false
            if (!owner.initialize() || owner.openOwned(8,true) != 2 || owner.openOwned(7,false) != 2 || live != 0) return i32(1)
            val expected=if (fail == 0) 1 else if (fail <= 2) 3 else if (fail <= 4) 4 else if (fail == 5) 5 else 6
            if (owner.openOwned(7,true) != expected || owner.ready() != (fail == 0) || bad) return i32(2)
            if (fail >= 6 && (setup != fail-5 || owner.setupResult().appliedSteps() != fail-6)) return i32(3)
            if (fail == 0 && (setup != 11 || owner.gaugeHandle() != 13 || !owner.setupResult().valid())) return i32(4)
            val before=closes
            if (owner.closeOwned(false) || closes != before || owner.openOwned(7,true) != 2) return i32(5)
            val blocked=closeFail != 0 && (live&closeFail) != 0
            if (owner.closeOwned(true) == blocked || (blocked && (owner.phase() != 2 || live == 0)) || bad) return i32(6)
            closeFail=0
            if (!owner.closeOwned(true) || live != 0 || owner.phase() != 0 || owner.gaugeHandle() != 0 || bad) return i32(7)
            if (fail != 0 && owner.openFailure() != expected) return i32(8)
            closeChoice=closeChoice+1
        }
        fail=fail+1
    }
    return i32(0)
}
