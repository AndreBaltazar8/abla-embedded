import "../src/esp32/power/sleep_uarts_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var shadow0=0x405
var shadow1=0x405
var blocked=0
var outcome=0
var sync0=0
var sync1=0
var writes=0
var bad=false
trusted fun c5SleepUartRead(address: int): int {
    if (address == 0x60096000 || address == 0x6009600c) return 1
    if (address == 0x60096004) return if ((blocked&1) != 0) 0 else 0x400000
    if (address == 0x60096010) return if ((blocked&2) != 0) 0 else 0x400000
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-(0x60000000+port*4096)
    if (offset == 0x3c) return if (port == 0) shadow0 else shadow1
    if (offset == 0x98) return 0
    if (offset == 0x70) {
        // The second UART never becomes idle in failure modes. In mode2
        // its observation also removes UART0's clock to fail reverse cleanup.
        if (port == 1 && outcome != 0) { if (outcome == 2) blocked=blocked|1;return 16 }
        return 0
    }
    if (offset == 0x1c) return 0
    bad=true;return 0
}
trusted fun c5SleepUartWrite(address: int,value: int): void {
    writes=writes+1
    if (address == 0x6000003c) shadow0=value
    else if (address == 0x6000103c) shadow1=value
    else if (address == 0x60000098) { if (value != 1) bad=true;sync0=sync0+1 }
    else if (address == 0x60001098) { if (value != 1) bad=true;sync1=sync1+1 }
    else bad=true
    if ((shadow0&~0x1a0000) != 0x405 || (shadow1&~0x1a0000) != 0x405) bad=true
    return
}
fun reset(): void { shadow0=0x405;shadow1=0x405;blocked=0;sync0=0;sync1=0;writes=0;bad=false;return }
@export("abla_sleep_uarts_c5_test")
trusted fun test(): int {
    var ports=0
    while (ports < 4) {
        var drain=0
        while (drain < 2) {
            outcome=0
            while (outcome < 3) {
                var failMask=0
                while (failMask < 4) {
                    reset()
                    var saved=esp32C5SleepUartsPrepareOwned(ports,drain != 0,2,true)
                    val failed=(ports&2) != 0 && outcome != 0
                    val owned=if (!failed) (if (drain == 0) ports else 0) else if (outcome == 2 && drain == 0) ports&1 else 0
                    if (saved.ready() == failed || saved.suspendedMask() != owned || saved.failedPort() != (if (failed) 1 else -1) || bad) return 1
                    if (failed && saved.status() != 4) return 2
                    val oldWrites=writes
                    saved=esp32C5SleepUartsResumeOwned(saved,false)
                    if (writes != oldWrites || saved.suspendedMask() != owned) return 3
                    blocked=failMask
                    saved=esp32C5SleepUartsResumeOwned(saved,true)
                    if (saved.suspendedMask() != (owned&failMask) || bad) return 4
                    val before0=sync0
                    val before1=sync1
                    blocked=0
                    saved=esp32C5SleepUartsResumeOwned(saved,true)
                    if ((saved|0) != 0 || shadow0 != 0x405 || shadow1 != 0x405 || bad) return 5
                    if (sync0 != before0+(if ((owned&failMask&1) != 0) 1 else 0) || sync1 != before1+(if ((owned&failMask&2) != 0) 1 else 0)) return 6
                    val completed=writes
                    saved=esp32C5SleepUartsResumeOwned(saved,true)
                    if (writes != completed) return 7
                    failMask=failMask+1
                }
                outcome=outcome+1
            }
            drain=drain+1
        }
        ports=ports+1
    }
    reset()
    if (esp32C5SleepUartsPrepareOwned(4,false,1,true).ready() || esp32C5SleepUartsPrepareOwned(3,false,1,false).ready() || writes != 0) return 8
    0
}
