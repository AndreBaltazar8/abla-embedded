import "../src/imu/mpu6886_device.ab"

// Test-only I2C/clock implementation. No hardware or NativeBuffer dereference.
type I2cBus = int
type I2cDevice = int
var step = 0
var failure = -1
var mismatch = false
var fifoCount = 0
var countReads = 0
var frameReads = 0
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int, frequency: int): I2cDevice = I2cDevice(256)
fun I2cDevice.close(): bool = true
fun expectedEvent(index: int): int {
    if (index == 0) return 100027
    if (index == 1) return 27 * 256 + 28
    if (index == 3) return 25 * 256 + 9
    if (index == 5) return 100026
    if (index == 6) return 26 * 256 + 191
    if (index == 8) return 35 * 256 + 248
    if (index == 10) return 100056
    if (index == 11) return 56 * 256 + 17
    if (index == 13) return 106 * 256 + 68
    if (index == 2 || index == 4 || index == 7 || index == 9 || index == 12 || index == 14) return 200010
    return -1
}
fun recordEvent(value: int): bool {
    if (value != expectedEvent(step)) mismatch = true
    val success = step != failure
    step = step + 1
    success
}
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult =
    I2cByteResult(if (recordEvent(100000 + register)) 256 | (if (register == 56) 1 else 255) else 0)
fun I2cDevice.writeRegister8(register: int, value: int): bool = recordEvent(register * 256 + value)
fun imuDelay(ticks: int): void {
    val recorded = recordEvent(200000 + ticks)
    return
}
fun I2cDevice.readRegister8(register: int): int = 0
fun I2cDevice.readRegister16BigEndianChecked(register: int): I2cWordResult {
    if (register != 114) mismatch = true
    countReads = countReads + 1
    I2cWordResult(fifoCount)
}
fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int): bool {
    if (register != 116 || length != 14) mismatch = true
    frameReads = frameReads + 1
    false
}
fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int): bool = false
fun I2cDevice.updateRegister8(register: int, mask: int, value: int): bool = false

trusted fun main(): int {
    val sensor = mpu6886(I2cBus(1))
    if (!sensor.enableFifo(9) || mismatch || step != 15) return 1
    failure = 0
    while (failure < 15) {
        if (expectedEvent(failure) != 200010) {
            step = 0
            mismatch = false
            if (sensor.enableFifo(9) || mismatch || step != failure + 1) return 2
        }
        failure = failure + 1
    }
    step = 0
    if (sensor.enableFifo(-1) || sensor.enableFifo(256) || mpu6886(I2cBus(0)).enableFifo() || step != 0) return 3
    mismatch = false
    if (sensor.readFifoFrame(nativeBufferAt(4096, 13)) || countReads != 0) return 4
    val frame = nativeBufferAt(4096, 14)
    if (sensor.readFifoFrame(frame) || frameReads != 0) return 5
    fifoCount = 65536 | 13
    if (sensor.readFifoFrame(frame) || frameReads != 0) return 6
    fifoCount = 65536 | 14
    if (sensor.readFifoFrame(frame) || frameReads != 1 || countReads != 3 || mismatch) return 7
    0
}
