import "../src/esp32/power/sleep_record_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Esp32S3ClockState = int
type Esp32S3ClockBias = int
type Esp32S3AnalogSleepState = int
type Esp32S3SleepUarts = int
type Esp32S3SleepResume = int
fun Esp32S3SleepResume.valid(): bool = this >= 0
fun Esp32S3SleepResume.phase(): int = this & 15
fun Esp32S3SleepResume.status(): int = (this>>>4) & 15
fun Esp32S3SleepResume.apbHertz(): int = 0
fun Esp32S3SleepResume.detail(): int = 0
fun Esp32S3SleepResume.complete(): bool = this.status() == 1
fun esp32S3SleepResumeResult(phase: int,status: int,apb: int,detail: int): Esp32S3SleepResume = Esp32S3SleepResume(phase | (status<<4))
var header=0x53504C50
var stage=3
var progress=0
var outcome=1
var entryResult=0
var calls=0
var writes=0
var bad=false
fun esp32S3MspiStateRead(address: int): int {
    if (address == 4096) return header
    if (address == 4100) return stage
    bad=true; 0
}
fun esp32S3MspiStateLoad64(address: int): int {
    if (address == 4136) return progress
    if (address == 4104) return 123
    if (address == 4128) return 456
    if (address == 4112) return 789
    if (address == 4120) return 1
    bad=true; 0
}
fun esp32S3MspiStateStore64(address: int,value: int): void {
    if (address != 4136 || writes != 0) bad=true
    progress=value; writes=writes+1; return
}
fun esp32S3MspiStateWrite(address: int,value: int): void {
    if (address == 4100) stage=value
    else if (address == 4096) { if (value != 0 || writes != 2 || (stage & 255) != 6) bad=true; header=value }
    else bad=true
    writes=writes+1; return
}
fun esp32S3LightSleepSuspendedOwned(wake: int,reject: int): int {
    if (stage != 8) bad=true
    calls=calls+1; return entryResult
}
fun esp32S3SleepResumeOwned(saved: Esp32S3SleepResume,clock: Esp32S3ClockState,bias: Esp32S3ClockBias,analog: Esp32S3AnalogSleepState,mspi: NativeBuffer,uarts: Esp32S3SleepUarts,polls: int): Esp32S3SleepResume {
    if ((saved | 0) != progress || (clock | 0) != 123 || (bias | 0) != 456 || (analog | 0) != 789 || mspi.addressValue() != 4144 || (uarts | 0) != 1) bad=true
    calls=calls+1; return Esp32S3SleepResume(outcome<<4)
}
@export("abla_sleep_record_test")
trusted fun recordTest(): i32 {
    val record=nativeBufferAt(4096,104)
    entryResult=-2
    while (entryResult <= 1) {
        header=0x53504C50; stage=3; calls=0; writes=0; bad=false
        if (esp32S3SleepRecordEnterOwned(record,1,1) != entryResult || bad || calls != 1 || stage != (4 | ((entryResult & 255)<<8))) return i32(1)
        if (esp32S3SleepRecordEnterOwned(record,1,1) != -3 || calls != 1) return i32(2)
        outcome=1
        while (outcome <= 5) {
            header=0x53504C50; stage=4 | ((entryResult & 255)<<8); progress=0; calls=0; writes=0; bad=false
            val result=esp32S3SleepRecordResumeOwned(record,8)
            if (result.status() != outcome || progress != (result | 0) || bad || calls != 1 || (stage & 0xFF00) != ((entryResult & 255)<<8)) return i32(3)
            if (header != (if (outcome == 1) 0 else 0x53504C50) || writes != (if (outcome == 1) 3 else 2)) return i32(4)
            outcome=outcome+1
        }
        entryResult=entryResult+1
    }
    header=0x53504C50; stage=7; calls=0; writes=0; progress=0
    if (esp32S3SleepRecordResumeOwned(record,8).status() != 4 || calls != 0 || writes != 0) return i32(5)
    stage=8
    if (esp32S3SleepRecordResumeOwned(record,8).status() != 5 || calls != 0 || writes != 0) return i32(6)
    stage=4; progress=-1
    if (esp32S3SleepRecordResumeOwned(record,8).status() != 5 || calls != 0 || writes != 0) return i32(7)
    i32(0)
}
