import "../src/esp32/spi/shared_pins_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/hal/pin.ab"
@export("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin) >= 1 && Pin(pin) <= 4
var port=2
var fail=0
var calls=0
var bad=false
@export("abla_pin_outputLevelOwned")
fun pinOutputLevelOwnedHook(pin: int, high: bool): bool {
    if (Pin(pin) != 3 || !high || calls != 0) bad=true
    calls=calls+1;return fail != 1
}
@export("abla_pin_routeOutputSignal")
fun pinRouteOutputSignalHook(pin: int, signal: int,inverted: bool): bool {
    if (Pin(pin) != 1 || inverted || signal != (if (port == 2) 101 else 66) || calls != 1) bad=true
    calls=calls+1;return fail != 2
}
@export("abla_pin_routeBidirectionalSignal")
fun pinRouteBidirectionalSignalHook(pin: int, input: int,output: int): bool {
    if (Pin(pin) != 2 || input != (if (port == 2) 103 else 68) || input != output || calls != 2) bad=true
    calls=calls+1;return fail != 3
}
@export("abla_spi_sio_pins_s3_test")
fun test(): i32 {
    while (port <= 3) {
        fail=0
        while (fail <= 3) {
            calls=0;bad=false
            val result=esp32s3SpiRouteSharedPinsOwned(port,Pin(1),Pin(2),Pin(3))
            if (result != (if (fail == 0) 1 else if (fail == 1) 6 else if (fail == 2) 3 else 4) ||
                calls != (if (fail == 0) 3 else fail) || bad) return i32(1)
            fail=fail+1
        }
        calls=0
        if (esp32s3SpiRouteSharedPinsOwned(port,Pin(1),Pin(1),Pin(3)) != 2 ||
            esp32s3SpiRouteSharedPinsOwned(port,Pin(1),Pin(2),Pin(2)) != 2 ||
            esp32s3SpiRouteSharedPinsOwned(port,Pin(1),Pin(0),Pin(3)) != 2 || calls != 0) return i32(2)
        port=port+1
    }
    if (esp32s3SpiRouteSharedPinsOwned(1,Pin(1),Pin(2),Pin(3)) != 2 || calls != 0) return i32(3)
    return i32(0)
}
