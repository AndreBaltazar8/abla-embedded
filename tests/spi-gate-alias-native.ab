import "../src/sd/software_register.ab"
import "../src/display/software_lcd.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val storage = nativeStaticAllocate(544)
val validProgramAddress = nativeStaticBytes("\xff\xff")
var activity = 0
trusted fun Pin.write(high: bool): void { activity = activity + 1; return }
trusted fun Pin.read(): bool { activity = activity + 1; false }
trusted fun Pin.output(): void { activity = activity + 1; return }
trusted fun Pin.input(): void { activity = activity + 1; return }
trusted fun peripheralDelayMicroseconds(us: int): void { activity = activity + 1; return }
trusted fun peripheralDelayMilliseconds(ms: int): void { activity = activity + 1; return }
trusted fun gateAliasTest(): int {
    var gateOffset = 4
    while (gateOffset <= 64) {
        val gate = peripheralGateAt(storage + gateOffset)
        var offset = 0
        while (offset <= 68) {
            var bytes = 0
            while (bytes <= 12) {
                var disjoint = true
                var byte = 0
                while (byte < bytes) {
                    if (offset + byte >= gateOffset && offset + byte < gateOffset + 4) disjoint = false
                    byte = byte + 1
                }
                if (gate.bufferDisjoint(nativeBufferAt(storage + offset, bytes), bytes) != disjoint) return 1
                bytes = bytes + 1
            }
            offset = offset + 1
        }
        gateOffset = gateOffset + 4
    }
    val gate = peripheralGateAt(storage + 16)
    val alias = nativeBufferAt(storage + 16, 512)
    val safe = nativeBufferAt(storage, 4)
    val clock = Pin(1); val mosi = Pin(2); val miso = Pin(3); val cs = Pin(4)
    nativeAddressStoreU32(storage + 16, 0, 0)
    if (softwareSpiTransaction(gate, u32(7), clock, mosi, miso, cs, alias, 1, safe, 1, 0, 0).status() != 3 ||
        softwareSpiTransaction(gate, u32(7), clock, mosi, miso, cs, safe, 1, alias, 1, 0, 0).status() != 3 ||
        softwareSpiCommand(gate, u32(7), clock, mosi, cs, miso, 1, alias, 1, 0, 0).status() != 3 ||
        softwareSpiSharedCommand(gate, u32(7), clock, mosi, cs, miso, 1, alias, 1, 0, 0).status() != 3) return 2
    val card = SoftwareSdInitResult(65537)
    if (softwareSdCommand(gate, u32(7), clock, mosi, miso, cs, 8, 426, alias, 4).status() != 3 ||
        softwareSdInitialize(gate, u32(7), clock, mosi, miso, cs, alias).status() != 3 ||
        softwareSdReadBlock(gate, u32(7), clock, mosi, miso, cs, card, 0, alias).status() != 3 ||
        softwareSdWriteBlock(gate, u32(7), clock, mosi, miso, cs, card, 0, alias).status() != 3 ||
        softwareSdReadRegister(gate, u32(7), clock, mosi, miso, cs, card, 9, alias).status() != 3) return 3
    if (nativeAddressLoadU32(storage + 16, 0) != 0 || activity != 0) return 4
    // Valid command program aliases the gate. It must be invalid, not busy,
    // and must not change either the program or gate word.
    nativeAddressStoreU32(storage + 16, 0, 65535)
    val aliasedProgram = nativeBufferAt(storage + 16, 2)
    val validProgram = nativeBufferAt(validProgramAddress, 2)
    val geometry = lcdGeometry(2, 2)
    if (!lcdCommandBufferValid(aliasedProgram, 2)) return 5
    if (softwareLcdRunProgram(gate, u32(7), clock, mosi, cs, miso, aliasedProgram, 2, 0).status() != 3 ||
        softwareLcdBeginRgb565(gate, u32(7), clock, mosi, cs, miso, geometry, 0,
            aliasedProgram, nativeBufferAt(0, 0), false, true, 0).status() != 3 ||
        softwareLcdBeginRgb565(gate, u32(7), clock, mosi, cs, miso, geometry, 0,
            validProgram, aliasedProgram, false, true, 0).status() != 3 ||
        softwareLcdBlitRgb565(gate, u32(7), clock, mosi, cs, miso, geometry.view(0),
            0, 0, alias, 1, 1, 2, false, 0).status() != 3) return 6
    if (nativeAddressLoadU32(storage + 16, 0) != 65535 || activity != 0) return 7
    0
}
#exportFunction("gateAliasTest", "abla_spi_gate_alias_test")
