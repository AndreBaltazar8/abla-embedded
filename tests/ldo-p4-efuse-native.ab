import "../src/esp32/ldo_efuse_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var sys2=u32(0)
var sys3=u32(0)
var sys4=u32(0)
var reads=0
var bad=false
fun p4LdoEfuseRead(offset: int): u32 {
    if (offset != 76+reads*4) bad=true
    reads=reads+1
    if (offset == 76) return sys2
    if (offset == 80) return sys3
    if (offset == 84) return sys4
    bad=true
    u32(0)
}
@export("abla_ldo_p4_efuse_test")
trusted fun testEfuse(): i32 {
    var version=0
    while (version < 32) {
        var sample=0
        while (sample < 256) {
            val k=sample
            val vos=sample%64
            val c=(sample*17)%64
            val d=sample%16
            val m=sample%8
            sys2=u32(128|(version<<8)|(d<<24)|(d<<28))
            sys3=u32(m|(m<<3)|(k<<6)|(vos<<14)|(c<<20)|((k&63)<<26))
            sys4=u32((k>>>6)|(vos<<2)|(c<<8))
            var channel=1
            while (channel <= 4) {
                reads=0
                val mv=if (channel <= 2) 1800 else 2500
                val result=esp32P4LdoReadVoltagePlanOwned(channel,mv)
                val expected=esp32P4LdoSelectVoltage(channel,mv,version != 0,k,vos,c,d,m)
                if (result != expected || reads != (if (version == 0) 1 else if (channel == 4) 3 else 2) || bad) return i32(1)
                channel=channel+1
            }
            sample=sample+1
        }
        version=version+1
    }
    reads=0
    if (esp32P4LdoReadVoltagePlanOwned(0,2500).valid() || esp32P4LdoReadVoltagePlanOwned(3,2701).valid() || reads != 0) return i32(2)
    i32(0)
}
