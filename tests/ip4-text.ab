import "../src/network/ip_text.ab"
import "abla/unsafe/memory"

trusted noescape extern:"c" fun mmap(
    address: i64*,
    length: int,
    protection: i32,
    flags: i32,
    fileDescriptor: i32,
    offset: int
): i64*

trusted noescape extern:"c" fun munmap(address: i64*, length: int): i32

trusted fun ip4TestWrite(address: u32, text: string): void {
    var index = 0
    while (index < text.size) {
        ablaUnsafeStoreU8(
            nativePointerFromAddress(int(address + u32(index))), text[index]
        )
        index = index + 1
    }
    ablaUnsafeStoreU8(
        nativePointerFromAddress(int(address + u32(text.size))), 0
    )
    return
}

trusted fun ip4TestAddress(
    input: u32,
    output: u32,
    text: string,
    first: int,
    second: int,
    third: int,
    fourth: int
): bool {
    ip4TestWrite(input, text)
    if (embeddedIp4AddressFromText(input, output) != 1) return false
    embeddedIpTextByte(output) == first &&
        embeddedIpTextByte(output + u32(1)) == second &&
        embeddedIpTextByte(output + u32(2)) == third &&
        embeddedIpTextByte(output + u32(3)) == fourth
}

trusted fun ip4TestRejected(input: u32, output: u32, text: string): bool {
    ip4TestWrite(input, text)
    embeddedIp4AddressFromText(input, output) == 0
}

@export("abla_ip4_text_probe")
trusted fun ip4TextProbe(input: u32, output: u32): i32 =
    embeddedIp4AddressFromText(input, output)

trusted fun main(): int {
    val allocation = mmap(
        nativeNullPointer(), 4096, i32(3), i32(98), i32(-1), 0
    )
    val nativeAddress = nativePointerAddress(allocation)
    if (nativeAddress <= 0 || nativeAddress > 4294967295) return 14
    val storage = u32(nativeAddress)
    val output = storage + u32(72)
    if (!ip4TestAddress(storage, output, "127.0.0.1", 127, 0, 0, 1)) return 1
    if (!ip4TestAddress(storage, output, "127.1", 127, 0, 0, 1)) return 2
    if (!ip4TestAddress(storage, output, "127.0.1", 127, 0, 0, 1)) return 3
    if (!ip4TestAddress(storage, output, "0177.0.0.1", 127, 0, 0, 1)) return 4
    if (!ip4TestAddress(storage, output, "0x7f.1", 127, 0, 0, 1)) return 5
    if (!ip4TestAddress(storage, output, "4294967295", 255, 255, 255, 255)) return 6
    if (!ip4TestAddress(storage, output, "1 ", 0, 0, 0, 1)) return 7
    if (!ip4TestRejected(storage, output, "")) return 8
    if (!ip4TestRejected(storage, output, "08")) return 9
    if (!ip4TestRejected(storage, output, "256.0.0.1")) return 10
    if (!ip4TestRejected(storage, output, "1.2.3.4.5")) return 11
    if (!ip4TestRejected(storage, output, "1x")) return 12
    ip4TestWrite(storage, "192.168.1.1")
    if (embeddedIp4AddressFromText(storage, u32(0)) != 1) return 13
    if (munmap(allocation, 4096) != i32(0)) return 15
    return 0
}
