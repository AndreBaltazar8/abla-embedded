import "../src/esp32/psram/cache_mapping_s3_sequence.ab"
import "abla/build"
val cmMemory=nativeStaticAllocate(32)
var cmI=0
var cmD=0
var cmHold=0
var cmWb=0
var cmDi=0
var cmDd=0
var cmEi=0
var cmEd=0
var cmBad=false
var cmToken=0
fun s3PsramCacheMappingStorageSafe(address: int,length: int): bool = address == cmMemory && length == 32
fun s3PsramCacheMappingRead(address: int): int {
    if (address == 0x600c4060) return cmI
    if (address == 0x600c4000) return cmD
    if (address == 0x600c4130) return if (cmHold == 3) 0x1002 else if (cmHold == 5) 0x2001 else 0x1001
    cmBad=true;return 0
}
fun s3PsramCacheMappingWriteback(): void {
    if (cmD != 1 || cmDi != 0 || cmDd != 0) cmBad=true
    cmWb=cmWb+1;return
}
fun s3PsramCacheMappingDisable(instruction: bool): int {
    if (instruction) { if (cmDd != 0) cmBad=true;cmDi=cmDi+1;cmI=0 }
    else { if (cmDi != 1) cmBad=true;cmDd=cmDd+1;cmD=0 }
    return if (instruction) cmToken else cmToken^0xffffffff
}
fun s3PsramCacheMappingEnable(instruction: bool,state: int): void {
    if (state != (if (instruction) cmToken else cmToken^0xffffffff)) cmBad=true
    if (instruction) { cmEi=cmEi+1;if (cmHold != 8) cmI=1 }
    else { cmEd=cmEd+1;if (cmHold != 10) cmD=1 }
    return
}
@export("abla_s3_psram_cache_mapping_test")
fun testCacheMapping(): int {
    val r=nativeBufferAt(cmMemory,32)
    var profile=0
    while (profile < 256) {
        cmToken=profile*16777217
        var flags=0
        while (flags < 4) {
            r.storeU32(0,0);cmI=flags&1;cmD=(flags>>>1)&1
            cmWb=0;cmDi=0;cmDd=0;cmEi=0;cmEd=0;cmBad=false;cmHold=3
            if (s3PsramCacheMappingBeginOwned(r,true) != 3 || r.loadU32(4) != 3 || cmDi != 1) return 1
            cmHold=5
            if (s3PsramCacheMappingBeginOwned(r,true) != 3 || r.loadU32(4) != 5 || cmDi != 1 || cmDd != 1) return 2
            cmHold=0
            if (s3PsramCacheMappingBeginOwned(r,true) != 1 || s3PsramCacheMappingBeginOwned(r,true) != 1 ||
                cmWb != ((flags>>>1)&1) || cmDi != 1 || cmDd != 1 || cmI != 0 || cmD != 0) return 3
            if (s3PsramCacheMappingEndOwned(r,false) != 2 || r.loadU32(4) != 6) return 4
            cmHold=8
            val first=s3PsramCacheMappingEndOwned(r,true)
            if ((flags&1) != 0) {
                if (first != 3 || r.loadU32(4) != 8) return 5
                cmI=1;cmHold=10
                val second=s3PsramCacheMappingEndOwned(r,true)
                if ((flags&2) != 0) { if (second != 3 || r.loadU32(4) != 10) return 6;cmD=1 }
                else if (second != 5) return 7
            } else if (first != 5) return 8
            cmHold=0
            if (s3PsramCacheMappingEndOwned(r,true) != 5 || cmEi != (flags&1) || cmEd != ((flags>>>1)&1) || cmBad ||
                cmI != (flags&1) || cmD != ((flags>>>1)&1) || s3PsramCacheMappingBeginOwned(r,true) != 2) return 9
            flags=flags+1
        }
        profile=profile+1
    }
    r.storeU32(0,0)
    if (s3PsramCacheMappingBeginOwned(r,false) != 2 || r.loadU32(0) != 0 || s3PsramCacheMappingEndOwned(r,true) != 2) return 10
    return 0
}
