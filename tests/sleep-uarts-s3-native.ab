import "../src/esp32/power/sleep_uarts_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var profile=0
var mask=0
var deep=false
var called=0
var resumed=0
var resumeOrder=0
var expectedOrder=0
var bad=false
fun esp32S3SleepUartPrepareOwned(port: int,isDeep: bool,polls: int): int {
    if (isDeep != deep || polls != 7 || (mask & (1<<port)) == 0 || (called & (1<<port)) != 0) bad=true
    called=called | (1<<port)
    val code=(profile>>>(port*3)) & 7
    // Disabled, ready, timeout and ownership conflict outcomes.
    if (code == 0) 1 else if (code == 1) (if (deep) 2 else 3) else if (code == 2) 4 else 5
}
fun esp32S3SleepUartResumeOwned(port: int): bool {
    if ((resumed & (1<<port)) != 0) bad=true
    resumed=resumed | (1<<port)
    resumeOrder=resumeOrder*4+port+1
    true
}
@export("abla_sleep_uarts_s3_test")
trusted fun sleepUartsTest(): i32 {
    var scenario=0
    while (scenario < 2) {
        deep=scenario != 0
        mask=0
        while (mask < 8) {
            var combination=0
            while (combination < 64) {
                profile=(combination & 3) | ((combination & 12)<<1) | ((combination & 48)<<2)
                called=0; resumed=0; resumeOrder=0; bad=false
                var expectedCalled=0
                var expectedSuspended=0
                var expectedStatus=1
                var failed=-1
                var port=0
                while (port < 3 && failed == -1) {
                    if ((mask & (1<<port)) != 0) {
                        expectedCalled=expectedCalled | (1<<port)
                        val code=(combination>>>(port*2)) & 3
                        if (code >= 2) { expectedStatus=code+2; failed=port }
                        else if (code == 1 && !deep) expectedSuspended=expectedSuspended | (1<<port)
                    }
                    port=port+1
                }
                var token=esp32S3SleepUartsPrepareOwned(mask,deep,7)
                if (bad || called != expectedCalled || token.status() != expectedStatus || token.failedPort() != failed ||
                    token.ready() != (failed == -1) || token.suspendedMask() != (if (failed == -1) expectedSuspended else 0) ||
                    resumed != (if (failed == -1) 0 else expectedSuspended)) return i32(1)
                token=token.resumeOwned()
                expectedOrder=0; port=2
                while (port >= 0) {
                    if ((expectedSuspended & (1<<port)) != 0) expectedOrder=expectedOrder*4+port+1
                    port=port-1
                }
                if (bad || token.ready() || token.suspendedMask() != 0 || resumed != expectedSuspended || resumeOrder != expectedOrder) return i32(2)
                token=token.resumeOwned()
                if (bad || resumeOrder != expectedOrder) return i32(3)
                combination=combination+1
            }
            mask=mask+1
        }
        scenario=scenario+1
    }
    called=0; resumed=0
    if (esp32S3SleepUartsPrepareOwned(-1,false,7).ready() || esp32S3SleepUartsPrepareOwned(8,false,7).ready() ||
        esp32S3SleepUartsPrepareOwned(7,false,0).ready() || esp32S3SleepUartsPrepareOwned(7,false,0x80000000).ready() || called != 0 || resumed != 0) return i32(4)
    i32(0)
}
