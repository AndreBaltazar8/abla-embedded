import "../src/m5stack/cores3_audio_dma_sequence.ab"
import "../src/esp32/i2s/clock_choice_esp32s3.ab"
import "../src/esp32/gdma_ring_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun pin(number: int): Pin = Pin(number)
fun esp32s3I2sPinsValid(port: int,transmit: bool,mclk: Pin,bclk: Pin,ws: Pin,data: Pin,flags: int): bool =
    port == expectedPort && mclk == Pin(0) && bclk == Pin(34) && ws == Pin(33) && data == Pin(if (transmit) 13 else 14) && flags == 0
var expectedPort=1
var expectedSlots=3
var expectedDuplicate=false
var fail = 0
var last = 2
var tx = false
var bad = false
trusted fun stage(value: int): bool {
    if (value != last + 1 && !(tx && last == 10 && value == 12)) bad = true
    last = value
    value != fail
}
trusted fun esp32s3GdmaEnableClock(owner: u32): bool { if (owner != u32(7)) bad = true; stage(3) }
trusted fun esp32s3I2sEnableClock(port: int, owner: u32): bool { if (port != expectedPort || owner != u32(7)) bad = true; stage(4) }
trusted fun esp32s3GdmaParked(channel: int, transmit: bool): bool { if (channel != 2 || transmit != tx) bad = true; stage(5) }
trusted fun esp32s3I2sResetDirection(port: int, transmit: bool): bool { if (port != expectedPort || transmit != tx) bad = true; stage(6) }
trusted fun esp32s3I2sSelectClock(port: int, transmit: bool, source: int, bclk: int): bool { if (port != expectedPort || transmit != tx || source != 2 || bclk != 8) bad = true; stage(7) }
trusted fun esp32s3I2sSetDivider(port: int, transmit: bool, integer: int, numerator: int, denominator: int): bool { if (port != expectedPort || transmit != tx || integer != 39 || numerator != 1 || denominator != 16) bad = true; stage(8) }
trusted fun esp32s3I2sSetFrameWidths(port: int, transmit: bool, data: int, slot: int, ws: int, shift: bool): bool { if (port != expectedPort || transmit != tx || data != 16 || slot != 16 || ws != 16 || !shift) bad = true; stage(9) }
trusted fun esp32s3I2sSetStandardMode(port: int, transmit: bool, slots: int, flags: int): bool { if (port != expectedPort || transmit != tx || slots != expectedSlots || flags != (if (expectedSlots == 3 && !expectedDuplicate) 0 else 1)) bad = true; stage(10) }
trusted fun esp32s3I2sSetReceiveBlockBytes(port: int, bytes: int): bool { if (port != expectedPort || bytes != 960) bad = true; stage(11) }
trusted fun esp32s3I2sActivateClock(port: int, transmit: bool): bool { if (port != expectedPort || transmit != tx) bad = true; stage(12) }
trusted fun esp32s3I2sRoutePins(port: int, transmit: bool, mclk: Pin, bclk: Pin, ws: Pin, data: Pin, flags: int): bool { if (port != expectedPort || transmit != tx || mclk != Pin(0) || bclk != Pin(34) || ws != Pin(33) || data != Pin(if (tx) 13 else 14) || flags != 0) bad = true; stage(13) }
// Actual ring initializer is used, but its writes are redirected to RAM-free
// assertions. Its publication is the final preparation stage.
var writes = 0
trusted fun esp32s3GdmaWrite(address: int, value: int): void { writes = writes + 1; return }
trusted fun esp32s3GdmaPublish(): void { if (!stage(14)) bad = true; return }
trusted fun audioDmaTest(): int {
    var direction = 0
    while (direction < 2) {
        tx = direction == 1
        fail = 0
        while (fail <= 13) {
            last = 2
            writes = 0
            val result = coreS3PrepareAudioDma(tx, 16000, 2, 0x3fc88000, 6, 0x3fc90000, 960, u32(7))
            val expected = if (fail < 3 || (tx && fail == 11)) 1 else fail
            if (result.status() != expected || bad) return 1
            if (expected == 1 && (result.sampleRate() != 16000 || last != 14 || writes != 18)) return 2
            if (expected != 1 && (last != fail || writes != 0)) return 3
            fail = fail + 1
        }
        direction = direction + 1
    }
    expectedPort=0
    while (expectedPort < 2) {
        expectedSlots=1
        while (expectedSlots <= 3) {
            direction=0
            while (direction < 2) {
                tx=direction == 1
                fail=0
                while (fail <= 13) {
                    last=2;writes=0
                    val result=esp32s3PrepareStandard16Dma(expectedPort,tx,pin(0),pin(34),pin(33),pin(if (tx) 13 else 14),
                        expectedSlots,16000,2,0x3fc88000,6,0x3fc90000,960,u32(7))
                    val expected=if (fail < 3 || (tx && fail == 11)) 1 else fail
                    if (result.status() != expected || bad) return 5
                    if (expected == 1 && (result.sampleRate() != 16000 || last != 14 || writes != 18)) return 6
                    if (expected != 1 && (last != fail || writes != 0)) return 7
                    fail=fail+1
                }
                direction=direction+1
            }
            expectedSlots=expectedSlots+1
        }
        expectedPort=expectedPort+1
    }
    expectedPort=1;expectedSlots=3;last=2
    expectedDuplicate=true;tx=true;fail=0
    while (fail <= 13) {
        last=2;writes=0
        val result=esp32s3PrepareStandard16Dma(1,true,pin(0),pin(34),pin(33),pin(13),3,16000,2,0x3fc88000,6,0x3fc90000,960,u32(7),true)
        val expected=if (fail < 3 || fail == 11) 1 else fail
        if (bad || result.status() != expected || (expected == 1 && (last != 14 || writes != 18))) return 9
        fail=fail+1
    }
    last=2
    if (esp32s3PrepareStandard16Dma(1,false,pin(0),pin(34),pin(33),pin(14),3,16000,2,0x3fc88000,6,0x3fc90000,960,u32(7),true).status() != 2 ||
        esp32s3PrepareStandard16Dma(1,true,pin(0),pin(34),pin(33),pin(13),1,16000,2,0x3fc88000,6,0x3fc90000,960,u32(7),true).status() != 2 || last != 2) return 10
    expectedDuplicate=false
    if (esp32s3PrepareStandard16Dma(1,false,pin(0),pin(34),pin(33),pin(14),0,16000,2,0x3fc88000,6,0x3fc90000,960,u32(7)).status() != 2 ||
        esp32s3PrepareStandard16Dma(1,false,pin(0),pin(34),pin(33),pin(14),4,16000,2,0x3fc88000,6,0x3fc90000,960,u32(7)).status() != 2 || last != 2) return 8
    last = 2
    if (coreS3PrepareAudioDma(true, 16000, 2, 0x3fc88000, 6, 0x3fc88004, 960, u32(7)).status() != 2 || coreS3PrepareAudioDma(true, 16000, 2, 0x3fc88000, 6, 0x3fc90000, 960, u32(0)).status() != 2 || last != 2) return 4
    0
}
#exportFunction("audioDmaTest", "abla_cores3_audio_dma_test")
