import "../src/esp32/ledc_clock_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var apb=0
var clock=0
var reset=0
var writes=0
var drop=0
var reads=0
var active=-1
var duty=-1
var pending=-1
var peripheralDrop=false
var paused=0
var bad=false
trusted fun p4LedcClockRead(offset: int): int {
    if (offset == 32) return apb
    if (offset == 156) return clock
    if (offset == 196) return reset
    bad=true; return 0
}
trusted fun p4LedcClockWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 32) apb=value else if (offset == 156) clock=value else if (offset == 196) reset=value else bad=true
    return
}
trusted fun p4LedcRead(offset: int): int {
    reads=reads+1
    if ((apb&1) == 0 || (clock&4) == 0 || (reset&0x20000000) != 0) bad=true
    if (offset < 160) {
        if (offset == active*20) return 4
        if (offset == duty*20+12) return 0x80000000
        return 0
    }
    val timer=(offset-160)/8
    return (if (pending == timer) 0x4000000 else 0)|(if ((paused&(1<<timer)) != 0) 0x800000 else 0)
}
trusted fun p4LedcWrite(offset: int,value: int): void {
    if (offset < 160 || offset > 184 || (value&0x800000) == 0) bad=true
    if (!peripheralDrop) paused=paused|(1<<((offset-160)/8))
    return
}
fun fresh(original: int): void {
    apb=0xa0000000; clock=0xb0000000|original; reset=0x80000000
    writes=0; drop=0; reads=0; active=-1; duty=-1; pending=-1; paused=0; peripheralDrop=false; bad=false
    return
}
@export("abla_ledc_clock_p4_test")
trusted fun clockTest(): i32 {
    var original=0
    while (original < 4) {
        var source=0
        while (source < 3) {
            fresh(original)
            var owner=esp32P4LedcClockOpenOwned(source)
            if (owner.status() != 1 || !owner.ownsClocks() || clock != (0xb0000004|source) || apb != 0xa0000001 || reset != 0x80000000) return i32(1)
            owner=owner.closeOwned()
            if (owner.status() != 0 || owner.ownsClocks() || clock != (0xb0000000|original) || apb != 0xa0000000 || paused != 15 || bad) return i32(2)
            source=source+1
        }
        original=original+1
    }
    var stage=1
    while (stage <= 5) {
        fresh(1); drop=stage
        var owner=esp32P4LedcClockOpenOwned(2)
        if (owner.status() != 4 || !owner.ownsClocks() || writes != stage) return i32(3)
        drop=0; owner=owner.closeOwned()
        if (owner.status() != 0 || reads != 0 || clock != 0xb0000001 || apb != 0xa0000000 || reset != 0x80000000 || bad) return i32(4)
        stage=stage+1
    }
    stage=1
    while (stage <= 4) {
        fresh(1); var owner=esp32P4LedcClockOpenOwned(2)
        // Make reset release a real transition for partial-open close tests.
        owner=Esp32P4LedcClock(owner.bits()|512); reset=reset|0x20000000
        writes=0; drop=stage; owner=owner.closeOwned()
        if (owner.status() != 4 || !owner.ownsClocks() || reads != 0) return i32(5)
        drop=0; owner=owner.closeOwned()
        if (owner.status() != 0 || reads != 0 || clock != 0xb0000001 || apb != 0xa0000000 || bad) return i32(6)
        stage=stage+1
    }
    var channel=0
    while (channel < 8) {
        fresh(0); var owner=esp32P4LedcClockOpenOwned(0); active=channel
        if (owner.closeOwned().status() != 3 || writes != 5) return i32(7)
        active=-1; duty=channel
        if (owner.closeOwned().status() != 3 || writes != 5) return i32(8)
        duty=-1
        if (owner.closeOwned().status() != 0 || bad) return i32(9)
        channel=channel+1
    }
    fresh(0); var owner=esp32P4LedcClockOpenOwned(0); pending=3
    if (owner.closeOwned().status() != 3 || writes != 5) return i32(10)
    pending=-1; peripheralDrop=true
    if (owner.closeOwned().status() != 6 || writes != 5) return i32(11)
    peripheralDrop=false; apb=apb&0xfffffffe; reads=0
    if (owner.closeOwned().status() != 5 || reads != 0) return i32(12)
    fresh(0); apb=apb|1
    if (esp32P4LedcClockOpenOwned(0).status() != 3 || writes != 0) return i32(13)
    fresh(0); clock=clock|4
    if (esp32P4LedcClockOpenOwned(0).status() != 3 || writes != 0) return i32(14)
    fresh(0); reset=reset|0x20000000
    if (esp32P4LedcClockOpenOwned(0).status() != 3 || esp32P4LedcClockOpenOwned(3).status() != 2 || writes != 0) return i32(15)
    return i32(0)
}
