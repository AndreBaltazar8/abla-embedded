import "../src/esp32/spi/buffer_sequence_esp32s3.ab"
import "../src/esp32/spi/transmit_transaction_sequence_esp32s3.ab"
import "../src/spi/pins.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
var pinFault=0
trusted fun Pin.writeLevelOwned(high: bool): bool {
    this.write(high);return (pinFault&(if (high) 2 else 1)) == 0
}
val storage = nativeStaticAllocate(66000)
var bytes = 0
var offset = 0
var chunks = 0
var failAt = -1
var ready = 1
var stage = 0
var selects = 0
var bad = false
fun esp32s3SpiTransmitPinsValid(peripheral: int, pins: SpiPins, select: Pin): bool =
    peripheral == 2 && pins == spiPins(37,35,36) && select == 4
trusted fun esp32s3SpiRead(address: int): int { bad = true; 0 }
trusted fun esp32s3SpiWrite(address: int, value: int): void { bad = true; return }
trusted fun checkTransmitOwner(): void {
    if (nativeAddressLoadU32(storage, 0) != 41) bad = true
    return
}
trusted fun esp32s3SpiExchangeReady(peripheral: int): int {
    checkTransmitOwner(); if (stage != 0) bad = true; ready
}
trusted fun Pin.write(high: bool): void {
    checkTransmitOwner()
    if (this != 4) bad = true
    if (!high) { if (stage != 0) bad = true; stage = 1 }
    else { if (stage != (if ((pinFault&1) != 0) 1 else if (failAt < 0) 3 else 2)) bad = true; stage = 4 }
    selects = selects + 1; return
}
trusted fun peripheralDelayMicroseconds(us: int): void {
    checkTransmitOwner()
    if (stage == 1 && us == 2) stage = 2
    else if (stage == 2 && us == 3 && offset == bytes) stage = 3
    else bad = true
    return
}
trusted fun esp32s3SpiTransmitOwned(peripheral: int, source: NativeBuffer, count: int, polls: int): int {
    checkTransmitOwner()
    val expected = if (bytes - offset < 64) bytes - offset else 64
    if (stage != 2 || peripheral != 2 || count != expected || source.capacity() != count ||
        source.addressValue() != storage + 5 + offset || polls != 10) bad = true
    chunks = chunks + 1
    if (chunks - 1 == failAt) return 0x20109
    offset = offset + count
    257
}
trusted fun resetTransmit(): void {
    nativeAddressStoreU32(storage, 0, 0)
    offset = 0; chunks = 0; stage = 0; selects = 0; bad = false
    return
}
trusted fun runTransmit(): SpiTransactionResult = esp32s3SpiTransmitTransaction(
    peripheralGateAt(storage), u32(41), 2, spiPins(37,35,36), Pin(4),
    nativeBufferAt(storage + 5, 65536), bytes, 10, 2, 3)
trusted fun transmitTransactionTest(): int {
    bytes=193;pinFault=1
    while (pinFault < 4) {
        failAt=-1
        while (failAt < 1) {
            resetTransmit()
            val result=runTransmit()
            val prior=if ((pinFault&1) != 0) 12 else if (failAt == 0) 0x20109 else 257
            val expected=if ((pinFault&2) == 0) prior else (if (prior == 257) 266 else prior)|(1<<24)
            if (result.status() != 6 || result.value() != u32(expected) || bad || selects != 2 ||
                chunks != (if ((pinFault&1) != 0) 0 else if (failAt == 0) 1 else 4) ||
                nativeAddressLoadU32(storage,0) != 0x80000000) return 10
            failAt=failAt+1
        }
        pinFault=pinFault+1
    }
    pinFault=0;failAt=-1;bytes=0
    while (bytes <= 193) {
        resetTransmit()
        if (!runTransmit().valid() || chunks != (bytes + 63) / 64 || offset != bytes || bad ||
            selects != (if (bytes == 0) 0 else 2) || nativeAddressLoadU32(storage, 0) != 0) return 1
        bytes = bytes + 1
    }
    bytes = 65536; resetTransmit()
    if (!runTransmit().valid() || chunks != 1024 || offset != bytes || bad) return 2
    bytes = 193; failAt = 0
    while (failAt < 4) {
        resetTransmit()
        val result = runTransmit()
        if (result.status() != 6 || result.value() != u32(0x20109) || chunks != failAt + 1 ||
            offset != failAt * 64 || selects != 2 || bad || nativeAddressLoadU32(storage, 0) != 0x80000000) return 3
        if (runTransmit().status() != 4 || chunks != failAt + 1 || selects != 2) return 4
        failAt = failAt + 1
    }
    failAt = -1; ready = 3; resetTransmit()
    if (runTransmit().status() != 6 || chunks != 0 || selects != 0 || bad) return 5
    ready = 1; bytes = 65537; resetTransmit()
    if (runTransmit().status() != 3 || selects != 0 || chunks != 0 || nativeAddressLoadU32(storage, 0) != 0) return 6
    bytes = 1; resetTransmit(); nativeAddressStoreU32(storage, 0, 42)
    if (runTransmit().status() != 2 || selects != 0 || chunks != 0 || nativeAddressLoadU32(storage, 0) != 42) return 7
    resetTransmit()
    if (esp32s3SpiTransmitTransaction(peripheralGateAt(storage), u32(41), 2,
        spiPins(37,35,36), Pin(4), nativeBufferAt(storage, 8), 8, 10).status() != 3 ||
        nativeAddressLoadU32(storage, 0) != 0 || selects != 0) return 8
    if (esp32s3SpiMemoryRangeValid(2, nativeBufferAt(0x60023ff0, 100), 100) ||
        esp32s3SpiMemoryRangeValid(2, nativeBufferAt(0xfffffff0, 100), 100)) return 9
    0
}
#exportFunction("transmitTransactionTest", "abla_spi_transmit_transaction_test")
