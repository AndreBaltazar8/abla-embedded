import "../src/m5stack/atom_s3r_backlight.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var calls=0
var fail=0
var brightness=0
var setting=false
var elapsed=0
var bad=false
var opens=0
fun I2cBus.valid(): bool = this == 7
fun I2cDevice.valid(): bool = this == 9
fun I2cBus.device(address: int,frequency: int): I2cDevice {
    opens=opens+1
    if (this != 7 || address != 48 || frequency != 400000) bad=true
    return I2cDevice(9)
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    val expectedRegister=if (setting || calls == 4) 14 else if (calls == 1) 0 else if (calls == 2) 8 else 112
    val expectedValue=if (setting || calls == 4) brightness else if (calls == 1) 64 else if (calls == 2) 1 else 0
    if (this != 9 || register != expectedRegister || value != expectedValue || (!setting && calls > 1 && elapsed != 1)) bad=true
    return calls != fail
}
fun peripheralDelayMilliseconds(ms: int): void {
    if (ms != 1 || calls != 1 || setting || fail == 1) bad=true
    elapsed=elapsed+ms;return
}
@export("abla_atom_s3r_backlight_test")
trusted fun test(): i32 {
    if (m5BoardAtomS3R.openAtomS3RBacklight(I2cBus(7)) != 9 || opens != 1 || bad ||
        m5BoardAtomS3.openAtomS3RBacklight(I2cBus(7)) != 0 || m5BoardAtomS3R.openAtomS3RBacklight(I2cBus(0)) != 0 || opens != 1) return i32(1)
    brightness=0
    while (brightness < 256) {
        setting=false;fail=0
        while (fail <= 4) {
            calls=0;elapsed=0
            val result=atomS3RBacklightBeginOwned(I2cDevice(9),brightness,true)
            val done=if (fail == 0) 4 else fail-1
            if (result != ((if (fail == 0) 1 else 4)|(done<<8)) || calls != (if (fail == 0) 4 else fail) ||
                elapsed != (if (fail == 1) 0 else 1) || bad) return i32(2)
            fail=fail+1
        }
        setting=true;fail=0
        while (fail < 2) {
            calls=0;elapsed=0
            if (atomS3RBacklightSetOwned(I2cDevice(9),brightness,true) != (if (fail == 0) 1 else 4) || calls != 1 || elapsed != 0 || bad) return i32(3)
            fail=fail+1
        }
        brightness=brightness+1
    }
    calls=0
    if (atomS3RBacklightBeginOwned(I2cDevice(0),1,true) != 3 || atomS3RBacklightBeginOwned(I2cDevice(9),256,true) != 3 ||
        atomS3RBacklightBeginOwned(I2cDevice(9),1,false) != 3 || atomS3RBacklightSetOwned(I2cDevice(9),-1,true) != 3 || calls != 0) return i32(4)
    return i32(0)
}
