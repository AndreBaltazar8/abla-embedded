import "../src/esp32/i2c/guarded_recovery_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_i2c_guarded_recovery_target")
trusted fun recoveryTarget(gate: PeripheralGate,owner: u32,sda: int,scl: int,scratch: NativeBuffer,budget: u32,clearStuck: bool): int =
    esp32C5I2cRecoverGuarded(gate,owner,0,sda,scl,scratch,budget,clearStuck)
