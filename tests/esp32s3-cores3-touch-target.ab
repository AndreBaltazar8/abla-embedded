import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/cores3_touch.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_cores3_touch_test")
trusted fun cores3TouchTarget(touch: u32, expander: u32, address: u32, rotation: i32): int {
    if (rotation == i32(-1)) return if (cores3ConfigureTouchInterrupt()) 1 else -1
    val buffer = nativeBufferAt(int(address), 29)
    val count = cores3ReadTouch(Ft5x06(int(touch)), Aw9523(int(expander)), buffer)
    if (count <= 0) return count
    val point = cores3TouchPoint(buffer, count, 0, int(rotation))
    if (point.valid()) point.x() | (point.y() << 16) else -4
}
