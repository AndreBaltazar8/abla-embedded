import "../src/esp32/soc/identity_c6_logic.ab"
import "../src/m5stack/detect_logic.ab"
fun main(): int {
    var package=0
    while (package < 8) {
        val word=u32(package) << u32(24)
        if (esp32C6PackageFromEfuse(word) != package ||
            esp32C6PackageFromEfuse(word | u32(0xf8ffffff)) != package) return 1
        var capacity=0
        while (capacity < 8) {
            val expected=if (package != 1) m5BoardUnknown else
                if (capacity == 2) m5BoardStampC6 else m5BoardNanoC6
            if (m5DetectEsp32C6(m5BoardUnknown,package,capacity) != expected ||
                m5DetectEsp32C6(m5BoardAtomVoice,package,capacity) != m5BoardAtomVoice) return 2
            capacity=capacity+1
        }
        package=package+1
    }
    0
}
