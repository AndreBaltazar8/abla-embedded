import "../src/display/it8951_protocol.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(32)
var selected=false
var bad=false
var words=0
var selections=0
var readyCalls=0
var waits=0
var wordFailure=0
var selectFailure=0
var readyFailure=0
var readyError=false
var operation=0
var frame=0
fun it8951TransportValid(context: int): bool = context == 7
fun it8951TransportSelect(context: int,active: bool): bool {
    selections=selections+1
    if (context != 7) bad=true
    if (selections == selectFailure) return false
    if (active) { if (selected) bad=true; frame=frame+1 }
    selected=active;return true
}
fun it8951TransportReady(context: int): int {
    readyCalls=readyCalls+1
    if (context != 7) bad=true
    if (readyFailure > 0 && readyCalls >= readyFailure) return if (readyError) -1 else 0
    return 1
}
fun expectedWord(index: int): int {
    if (operation == 0) return if (index == 1) 24576 else if (index == 2) 33 else if (index == 3) 0 else if (index == 4) 0x1234 else if (index == 5) 0xabcd else 65535
    if (operation == 1) return if (index == 1) 4096 else 0
    if (operation == 2) return if (index == 1) 24576 else if (index == 2) 17 else if (index == 4) 0x020a else if (index == 6) 0xabcd else 0
    return if (index == 1) 0 else 0x1234
}
fun it8951TransportExchange(context: int,word: int): int {
    words=words+1
    val expectedFrame=if (operation == 0) (if (words <= 2) 1 else 2) else if (operation == 2) (words+1)/2 else 1
    if (context != 7 || !selected || word != expectedWord(words) || frame != expectedFrame) bad=true
    if (words == wordFailure) return -1
    return if (operation == 1 && words >= 3) (if (words == 3) 0x1234 else if (words == 4) 0xabcd else 65535) else 0
}
fun it8951TransportDelay(context: int,us: int): void {
    if (context != 7 || us != 1) bad=true
    waits=waits+1;return
}
trusted fun runTransfer(): It8951Transfer {
    val data=nativeBufferAt(memory,32)
    var offset=0
    while (offset < 32) { data.store(offset,165);offset=offset+1 }
    if (operation != 1) { data.storeU16(0,0x1234);data.storeU16(2,0xabcd);data.storeU16(4,65535) }
    selected=false;bad=false;words=0;selections=0;readyCalls=0;waits=0;frame=0
    if (operation == 0) return it8951Command(7,33,data,3,3)
    if (operation == 1) return it8951ReadWords(7,data,3,3)
    if (operation == 2) return it8951WriteRegister(7,0x020a,0xabcd,3)
    it8951WriteWord(7,0x1234,3)
}
@export("abla_it8951_protocol_test")
trusted fun testProtocol(): i32 {
    operation=0
    while (operation < 4) {
        wordFailure=0;selectFailure=0;readyFailure=0
        val complete=runTransfer()
        val maximumWords=words;val maximumSelections=selections;val maximumReady=readyCalls
        if (!complete.success() || complete.completed() != (if (operation < 2) 3 else 1) || selected || bad || waits != 0) return i32(1)
        wordFailure=1
        while (wordFailure <= maximumWords) {
            val failed=runTransfer()
            if (failed.status() != 4 || words != wordFailure || selected || bad) return i32(2)
            if (operation == 1) {
                val count=if (wordFailure < 3) 0 else wordFailure-3
                if (failed.completed() != count) return i32(3)
                var index=0
                while (index < 16) {
                    val expected=if (index >= count) 0xa5a5 else if (index == 0) 0x1234 else if (index == 1) 0xabcd else 65535
                    if (nativeBufferAt(memory,32).loadU16(index*2) != expected) return i32(4)
                    index=index+1
                }
            }
            wordFailure=wordFailure+1
        }
        wordFailure=0;selectFailure=1
        while (selectFailure <= maximumSelections) {
            val failed=runTransfer()
            if (failed.success() || bad || (failed.status() != 4 && failed.status() != 5)) return i32(5)
            // A reported failed release retains ownership; model recovery only.
            selected=false;selectFailure=selectFailure+1
        }
        selectFailure=0;readyFailure=1
        while (readyFailure <= maximumReady) {
            readyError=false
            val timeout=runTransfer()
            if (timeout.status() != 3 || selected || bad || waits != 2) return i32(6)
            readyError=true
            val failed=runTransfer()
            if (failed.status() != 4 || selected || bad || waits != 0) return i32(7)
            readyFailure=readyFailure+1
        }
        operation=operation+1
    }
    selections=0;words=0;readyCalls=0
    val data=nativeBufferAt(memory,32)
    if (it8951Command(0,33,data,3,3).status() != 2 || it8951Command(7,-1,data,3,3).status() != 2 ||
        it8951Command(7,33,data,-1,3).status() != 2 || it8951ReadWords(7,data,17,3).status() != 2 ||
        it8951ReadWords(7,data,0,3).status() != 2 || it8951ReadWords(7,data,1,0).status() != 2 ||
        it8951WriteRegister(7,65536,1,3).status() != 2 || selections != 0 || words != 0 || readyCalls != 0) return i32(8)
    i32(0)
}
