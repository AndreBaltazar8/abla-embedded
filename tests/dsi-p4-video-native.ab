import "../src/display/dsi_video_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var bridge=u32(16)
var dpi=u32(4096)
var mode=u32(17)
var events=u32(0)
var dmaEvents=u32(0)
var dmaActive=u32(1)
var aborting=u32(0)
var writes=0
var latches=0
var drop=0
var bad=false
fun p4DsiRead(offset: int): u32 { if (offset != 52) bad=true; return mode }
fun p4DsiWrite(offset: int,value: u32): void {
    writes=writes+1
    if (offset != 52 || (bridge&u32(1)) == u32(0) || (dpi&u32(1)) != u32(0)) bad=true
    if (writes != drop) mode=value
    return
}
fun p4DsiBridgeRead(offset: int): u32 {
    if (offset == 4) return bridge
    if (offset == 64) return dpi
    if (offset == 88) return events
    bad=true; return u32(0)
}
fun p4DsiBridgeWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 4) bridge=value
    else if (offset == 64) dpi=value
    else if (offset == 68) { if (value != u32(1)) bad=true; latches=latches+1 }
    else if (offset == 84) events=events&(u32(4294967295)^value)
    else bad=true
    return
}
fun p4DwDmaRead(offset: int): u32 {
    if (offset == 24) return dmaActive
    if (offset == 28) return aborting
    if (offset == 392 || offset == 648 || offset == 904 || offset == 1160) return dmaEvents
    bad=true; return u32(0)
}
fun resetVideo(): void {
    bridge=u32(16); dpi=u32(4096); mode=u32(17); events=u32(0); dmaEvents=u32(0)
    dmaActive=u32(15); aborting=u32(0); writes=0; latches=0; drop=0; bad=false; return
}
@export("abla_dsi_p4_video_test")
trusted fun testVideo(): i32 {
    var channel=0
    while (channel < 4) {
        resetVideo()
        if (esp32P4DsiVideoBridgePrepareOwned() != 1 || bridge != u32(17) || writes != 2 || latches != 1) return i32(1)
        if (esp32P4DsiVideoStartOwned(channel) != 1 || mode != u32(16) || dpi != u32(4097) || writes != 5 || latches != 2 || bad) return i32(2)
        if (esp32P4DsiVideoDisableOutputOwned() != 1 || dpi != u32(4096) || latches != 3 || bad) return i32(3)
        resetVideo(); bridge=u32(17); dmaActive=u32(0); dmaEvents=u32(2)
        if (esp32P4DsiVideoStartOwned(channel) != 1 || bad) return i32(4)
        resetVideo(); bridge=u32(17); dmaActive=u32(0)
        if (esp32P4DsiVideoStartOwned(channel) != 6 || writes != 0) return i32(5)
        resetVideo(); bridge=u32(17); aborting=u32(15)
        if (esp32P4DsiVideoStartOwned(channel) != 6 || writes != 0) return i32(6)
        var bit=0
        while (bit < 32) {
            resetVideo(); bridge=u32(17); dmaEvents=u32(1)<<u32(bit)
            val allowed=bit == 0 || bit == 1 || bit == 3 || bit == 4
            if (esp32P4DsiVideoStartOwned(channel) != (if (allowed) 1 else 4) || bad) return i32(7)
            if (!allowed && writes != 0) return i32(8)
            bit=bit+1
        }
        channel=channel+1
    }
    resetVideo(); drop=1
    if (esp32P4DsiVideoBridgePrepareOwned() != 5 || latches != 0) return i32(9)
    var fault=1
    while (fault <= 2) {
        resetVideo(); bridge=u32(17); drop=fault
        if (esp32P4DsiVideoStartOwned(0) != 5 || writes != fault || latches != 0) return i32(10)
        fault=fault+1
    }
    resetVideo(); bridge=u32(17); dpi=u32(4097); drop=1
    if (esp32P4DsiVideoDisableOutputOwned() != 5 || latches != 0) return i32(11)
    resetVideo(); events=u32(3)
    if (esp32P4DsiVideoBridgePrepareOwned() != 4 || writes != 0 ||
        esp32P4DsiVideoEventsOwned(1) != 1 || esp32P4DsiVideoEventsOwned(3) != 3 ||
        esp32P4DsiVideoAcknowledgeOwned(1,2) != 2 || writes != 0 ||
        esp32P4DsiVideoAcknowledgeOwned(3,2) != 1 || events != u32(1) ||
        esp32P4DsiVideoAcknowledgeOwned(1,1) != 1 || events != u32(0)) return i32(12)
    resetVideo()
    if (esp32P4DsiVideoStartOwned(-1) != 2 || esp32P4DsiVideoStartOwned(4) != 2 ||
        esp32P4DsiVideoEventsOwned(2) != -1 || esp32P4DsiVideoAcknowledgeOwned(3,4) != 2 || writes != 0 || bad) return i32(13)
    return i32(0)
}
