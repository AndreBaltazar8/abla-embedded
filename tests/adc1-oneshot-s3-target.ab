import "../src/esp32/adc1_oneshot_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc1_oneshot_s3_target")
trusted fun target(op: int,channel: int,polls: int): int {
    if (op == 0) return esp32S3Adc1StartOwned(channel,polls)
    if (op == 1) return esp32S3Adc1FinishOwned(channel,polls)
    return esp32S3Adc1ReleaseOwned(channel,polls)
}
