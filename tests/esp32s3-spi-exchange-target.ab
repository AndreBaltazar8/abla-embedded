import "../src/esp32/spi/transfer_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun spiExchangeTarget(peripheral: u32, source: u32, destination: u32, bytes: u32): int =
    esp32s3SpiExchangeOwned(int(peripheral), nativeBufferAt(int(source), int(bytes)),
        nativeBufferAt(int(destination), int(bytes)), int(bytes), 100000)
#exportFunction("spiExchangeTarget", "abla_s3_spi_exchange_test")
