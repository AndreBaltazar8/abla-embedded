import "../src/i2c/results.ab"
import "../src/m5stack/papermono_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var calls=0
var failure=0
var bad=false
var initial=0
val registers=nativeStaticAllocate(160)
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool {
    if (calls >= 5) bad=true
    this.applyWrite(register,255,value)
}
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }

fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true; return I2cWordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
// device,register,mask,value; literal oracle from PM1/M5IOE register definitions.
val operations=nativeStaticU32s([
    9,5,255,0, 9,64,255,0, 9,65,255,0, 9,66,255,0, 9,67,255,30,
    9,22,3,0, 9,16,1,0, 9,16,2,2, 9,19,2,0, 9,20,12,4,
    9,17,2,2, 9,22,12,4,
    8,20,32,0, 8,4,32,32, 8,6,32,32,
    8,6,4,0, 8,20,4,0, 8,4,4,4
])
trusted fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    if (calls < 5) bad=true
    this.applyWrite(register,mask,value)
}
trusted fun I2cDevice.applyWrite(register: int,mask: int,value: int): bool {
    val n=calls
    calls=calls+1
    if (n >= 18) { bad=true; return false }
    if (this != nativeAddressLoadU32(operations,n*16) ||
        register != nativeAddressLoadU32(operations,n*16+4) ||
        mask != nativeAddressLoadU32(operations,n*16+8) ||
        value != nativeAddressLoadU32(operations,n*16+12)) bad=true
    if (calls == failure) return false
    val buffer=nativeBufferAt(registers,160)
    val offset=register+(if (this == 9) 80 else 0)
    buffer.store(offset,(buffer.load(offset)&~mask)|value)
    return true
}
@export("abla_papermono_power_test")
trusted fun test(): i32 {
    val owner=m5ExpandersAt(nativeBufferAt(nativeStaticAllocate(32),32))
    owner.initialize()
    owner.buffer().storeU32(8,m5BoardPaperMono|0)
    owner.storeSlot(0,M5ExpanderOpen(8|(2<<32)|(1<<40)))
    owner.buffer().storeU32(4,1)
    val pmic=M5PmicOpen(9|(5<<32)|(1<<40))
    initial=0
    while (initial < 256) {
        failure=0
        while (failure <= 18) {
            val buffer=nativeBufferAt(registers,160)
            var r=0
            while (r < 160) { buffer.store(r,initial); r=r+1 }
            calls=0; bad=false
            val result=owner.configurePaperMonoPower(pmic,true,true)
            val applied=if (failure == 0) 18 else failure-1
            val highSteps=if (failure == 0) 16 else if (failure <= 16) failure-1 else 15
            if (result != ((if (failure == 0) 1 else 4)|(highSteps<<8)) ||
                calls != (if (failure == 0) 18 else failure) || bad) return i32(1)
            r=0
            while (r < 160) {
                var expected=initial
                var step=0
                while (step < applied) {
                    val offset=nativeAddressLoadU32(operations,step*16+4)+
                        (if (nativeAddressLoadU32(operations,step*16) == 9) 80 else 0)
                    if (r == offset) expected=(expected&~nativeAddressLoadU32(operations,step*16+8))|
                        nativeAddressLoadU32(operations,step*16+12)
                    step=step+1
                }
                if (buffer.load(r) != expected) return i32(2)
                r=r+1
            }
            failure=failure+1
        }
        initial=initial+1
    }
    calls=0
    if (owner.configurePaperMonoPower(pmic,true,false) != 3 ||
        owner.configurePaperMonoPower(pmic,false,true) != 3 ||
        owner.configurePaperMonoPower(M5PmicOpen(0),true,true) != 3 ||
        owner.configurePaperMonoPower(M5PmicOpen(9|(3<<32)|(1<<40)),true,true) != 3 || calls != 0) return i32(3)
    owner.buffer().storeU32(8,m5BoardStopWatch|0)
    if (owner.configurePaperMonoPower(pmic,true,true) != 2 || calls != 0) return i32(4)
    owner.buffer().storeU32(4,6)
    if (owner.configurePaperMonoPower(pmic,true,true) != 3 || calls != 0) return i32(5)
    return i32(0)
}
