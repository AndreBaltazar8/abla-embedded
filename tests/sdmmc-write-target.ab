import "../src/sd/mmc_write_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_write_target")
trusted fun target(operation: int,context: int,card: int,descriptor: int,payload: int,sector: int,now: u32,budget: int,released: bool,allowWrite: bool): int {
    val state=nativeBufferAt(context,64)
    if (operation == 0) return sdMmcWriteBeginOwned(state,nativeBufferAt(card,80),nativeBufferAt(descriptor,16),nativeBufferAt(payload,512),sector,now,budget,released,allowWrite)
    return sdMmcWritePollOwned(state,now)
}
