import "../src/esp32/i2c/fifo_esp32s3.ab"
import "abla/runtime/scalar"

@export("abla_s3_i2c_fifo_test")
trusted fun i2cFifoTargetTest(port: i32, address: u32, count: u32): bool {
    val buffer = nativeBufferAt(int(address), int(count))
    if (!esp32S3I2cResetFifos(int(port))) return false
    if (!esp32S3I2cWriteCommand(int(port), 0, esp32S3I2cCommand(1, int(count), true))) return false
    esp32S3I2cWriteFifo(int(port), buffer, int(count)) && esp32S3I2cReadFifo(int(port), buffer, int(count))
}
