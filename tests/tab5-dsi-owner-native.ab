fun tab5DsiOwnerReferenceRelease(value: int): int { trace=trace*10+6; return if (fault == 6) value else value|(1<<32) }
fun tab5DsiOwnerRailClose(value: int): int { trace=trace*10+7; return if (fault == 7) value else 0 }
