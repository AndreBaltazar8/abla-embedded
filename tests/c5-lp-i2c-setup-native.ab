import "../src/esp32/i2c/lp_setup_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var step=0
var failure=0
var cleanupOk=false
var source=0
var filter=0
var pulls=false
var bad=false
fun c5LpI2cTimingLoad(address: int): int { bad=true; return 0 }
fun c5LpI2cTimingStore(address: int,value: int): void { bad=true; return }
fun advance(expected: int): bool {
    step=step+1
    if (step != expected) bad=true
    step != failure
}
fun c5LpI2cSetupPadsAvailable(sda: int,scl: int): bool {
    if (sda != 2 || scl != 3) bad=true
    advance(1)
}
fun c5LpI2cSetupClock(value: int): bool {
    if (value != source) bad=true
    advance(2)
}
fun c5LpI2cSetupController(value: int): bool {
    if (value != filter) bad=true
    advance(3)
}
fun c5LpI2cSetupTiming(timing: Esp32C5LpI2cTiming): bool {
    if (timing != esp32C5LpI2cTiming(u32(20000000),u32(400000))) bad=true
    advance(4)
}
fun c5LpI2cSetupRoute(sda: int,scl: int,pullup: bool): bool {
    if (sda != 2 || scl != 3 || pullup != pulls) bad=true
    advance(5)
}
fun c5LpI2cSetupDisable(): bool {
    if (failure < 2 || step != failure) bad=true
    step=step+1
    cleanupOk
}
@export("abla_c5_lp_i2c_setup_test")
trusted fun setupTest(): i32 {
    var profile=0
    while (profile < 768) {
        failure=profile%6; cleanupOk=((profile/6)&1) != 0
        source=(profile/12)&1; filter=(profile/24)%16; pulls=profile >= 384
        step=0; bad=false
        val result=esp32C5LpI2cSetupOwned(0,2,3,source,u32(20000000),u32(400000),filter,pulls)
        val cleanup=failure >= 2
        if (result.status() != (if (failure == 0) 1 else failure+2) ||
            result.valid() != (failure == 0) || result.cleanupAttempted() != cleanup ||
            result.cleanupFailed() != (cleanup && !cleanupOk) ||
            step != (if (failure == 0) 5 else if (cleanup) failure+1 else 1) || bad) return i32(1)
        profile=profile+1
    }
    step=0
    if (esp32C5LpI2cSetupOwned(1,2,3,0,u32(20000000),u32(400000)).status() != 2 ||
        esp32C5LpI2cSetupOwned(0,2,3,2,u32(20000000),u32(400000)).status() != 2 ||
        esp32C5LpI2cSetupOwned(0,2,3,0,u32(0),u32(400000)).status() != 2 ||
        esp32C5LpI2cSetupOwned(0,2,3,0,u32(20000000),u32(400000),16).status() != 2 || step != 0) return i32(2)
    i32(0)
}
