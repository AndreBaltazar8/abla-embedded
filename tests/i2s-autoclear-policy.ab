// Source regression: TX clear policy reaches the ISR before buffer reuse.
//
// This checks configuration/layout/order, not timing or physical sound quality.

import "../tools/lib/source_text.ab"
import "abla/text"

fun main: int {
    val facade = sourceRead("src/esp32/i2s_idf6.ab")
    val install = sourceAfter(facade, "trusted fun I2sDevice.prepare(")
    val policy = "if (!microphone) nativeAddressStoreU8(channelConfig, 16, 1)"
    sourceOrder(install, "nativeAddressClear(channelConfig, 24)", policy, "configuration cleared before the policy is stored")
    sourceOrder(install, policy, "i2s_new_channel(", "policy stored before the channel is created")

    val driver = sourceRead("src/esp32/i2s/driver_typed_esp32.ab")
    sourceHas(driver, "channel, u32(32),\n                esp32I2sLoadU8(configuration, u32(16))", "the policy reaches the channel handle")
    var interrupt = sourceAfter(driver, "trusted fun esp32I2sDmaTxInterrupt(")
    interrupt = sourceBefore(interrupt, "\ntrusted fun ")
    val clear = sourceIndex(interrupt, "if (esp32I2sLoadU8(handle, u32(32)) != u32(0))")
    val wipe = sourceIndex(interrupt, "freestandingSet(buffer, 0, size)", clear)
    val requeue = sourceIndex(interrupt, "esp32RecoveredXQueueGenericSendFromISR(")
    sourceCheck(clear < wipe && wipe < requeue, "the consumed buffer is cleared before it is requeued")
    sourceFinish("PASS: TX-only auto-clear configured and consumed buffers cleared before requeue")
}
