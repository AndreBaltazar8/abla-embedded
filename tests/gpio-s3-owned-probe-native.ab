import "../src/esp32/gpio/probe_owned_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var out0=0
var out1=0
var en0=0
var en1=0
var writes=0
var drop=-1
var mux=0
var route=0
var od=0
var testedPin=0
var input=0
trusted fun esp32S3PinStateRead(address: int): int =
    if (address == 0x6000403c || address == 0x60004040) input else if (address == 0x60004004) out0 else if (address == 0x60004010) out1 else if (address == 0x60004020) en0 else if (address == 0x6000402c) en1 else
    if (address == esp32S3GpioMuxAddress(testedPin)) mux else if (address == 0x60004554+testedPin*4) route else od
trusted fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes
    writes=writes+1
    if (step == drop) return
    if (address == 0x60004008) out0=out0|value
    else if (address == 0x6000400c) out0=out0&~value
    else if (address == 0x60004014) out1=out1|value
    else if (address == 0x60004018) out1=out1&~value
    else if (address == 0x60004024) en0=en0|value
    else if (address == 0x60004028) en0=en0&~value
    else if (address == 0x60004030) en1=en1|value
    else if (address == 0x60004034) en1=en1&~value
    else if (address == esp32S3GpioMuxAddress(testedPin)) mux=value
    else if (address == 0x60004554+testedPin*4) route=value
    else od=value
    return
}
@export("abla_gpio_s3_owned_probe_test")
trusted fun test(): i32 {
    var pin=0
    while (pin <= 48) {
        if (espChipS3().gpioOutputValid(pin)) {
            testedPin=pin
            var pull=0
            while (pull < 4) {
                var failed=-1
                while (failed < 4) {
                    mux=0xa5a56c80; route=0xdead0abc; od=0xffffffff
                    out0=0x12345678; out1=0x76543210; en0=0xffffffff; en1=0xffffffff
                    val snapshot=esp32S3GpioSnapshotOwned(pin,true)
                    writes=0; drop=failed
                    val status=snapshot.prepareProbeInputOwned(pull,true)
                    if (status != (if (failed < 0) 1 else 4)) return i32(1)
                    drop=-1
                    if (failed < 0) {
                        val expectedPull=(if (pull == 0 || pull == 2) 256 else 0)|(if (pull == 1 || pull == 2) 128 else 0)
                        if (route != 0xdead0500 || mux != ((0xa5a56c80&~0x7380)|0x1200|expectedPull) || od != 0xfffffffb) return i32(2)
                        input=1<<(pin&31)
                        if (snapshot.readProbeInputOwned(true) != 1) return i32(3)
                        input=0
                        if (snapshot.readProbeInputOwned(true) != 0) return i32(4)
                        route=route^512
                        if (snapshot.readProbeInputOwned(true) != -1) return i32(5)
                        route=route^512
                    }
                    if (snapshot.restoreOwned(true) != 1 || mux != 0xa5a56c80 || route != 0xdead0abc || od != 0xffffffff ||
                        out0 != 0x12345678 || out1 != 0x76543210 || en0 != 0xffffffff || en1 != 0xffffffff) return i32(6)
                    val before=writes
                    if (snapshot.prepareProbeInputOwned(pull,false) != 3 ||
                        snapshot.readProbeInputOwned(false) != -1 || snapshot.prepareProbeInputOwned(4,true) != 2 ||
                        S3GpioSnapshot(0).prepareProbeInputOwned(0,true) != 2 || writes != before) return i32(7)
                    failed=failed+1
                }
                pull=pull+1
            }
        }
        pin=pin+1
    }
    return i32(0)
}
