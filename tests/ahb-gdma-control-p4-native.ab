import "../src/esp32/ahb_gdma_control_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val regs=nativeStaticAllocate(64)
val offsets=nativeStaticU32s([0,0,4,48,0])
val masks=nativeStaticU32s([1,1,4096,63,16])
var base=0
var tx=false
var port=0
var writes=0
var reads=0
var fail=0
var bad=false
var stopping=false
var polls=0
var delay=1
trusted fun p4AhbGdmaRead(address: int): int {
    reads=reads+1
    val offset=address-base
    if (offset != 0 && offset != 4 && offset != 16 && offset != 48) { bad=true;return 0 }
    if (stopping && offset == 16) {
        polls=polls+1
        if (delay > 0 && polls >= delay) nativeAddressStoreU32(regs,16,if (tx) 8 else 17)
    }
    return nativeAddressLoadU32(regs,offset)
}
trusted fun p4AhbGdmaWrite(address: int,value: int): void {
    val offset=address-base
    if (stopping) {
        if (offset != 16 || value != (if (tx) 0x80000001 else 0x80000003)) bad=true
        writes=writes+1;return
    }
    if (writes >= (if (tx) 4 else 5)) { bad=true;return }
    val at=nativeAddressLoadU32(offsets,writes*4)
    val mask=nativeAddressLoadU32(masks,writes*4)
    val bit=if (writes == 0) 1 else if (writes == 2) 4096 else if (writes == 3) 3+port else 0
    val expected=(nativeAddressLoadU32(regs,at)&(0xffffffff ^ mask))|bit
    if (offset != at || value != expected) bad=true
    writes=writes+1
    nativeAddressStoreU32(regs,at,if (writes == fail) value ^ mask else value)
    return
}
trusted fun reset(): void {
    nativeAddressStoreU32(regs,0,0xa5a55a5a)
    nativeAddressStoreU32(regs,4,0xa5a55a5a)
    nativeAddressStoreU32(regs,48,0xa5a55a5a)
    nativeAddressStoreU32(regs,16,if (tx) 8 else 17)
    writes=0;reads=0;bad=false;stopping=false;polls=0;delay=1
    return
}
@export("abla_ahb_gdma_control_p4_test")
trusted fun test(): i32 {
    var channel=0
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction==1;base=0x50085070+channel*192+direction*96
            port=0
            while (port < 3) {
                reset();fail=0
                if (esp32p4AhbGdmaPrepareI2sOwned(channel,tx,port,true) != 1 || bad || writes != (if (tx) 4 else 5)) return i32(1)
                fail=2
                while (fail <= (if (tx) 4 else 5)) {
                    reset()
                    if (esp32p4AhbGdmaPrepareI2sOwned(channel,tx,port,true) != fail+2 || bad || writes != fail) return i32(2)
                    fail=fail+1
                }
                fail=0;port=port+1
            }
            reset();nativeAddressStoreU32(regs,16,0)
            if (esp32p4AhbGdmaParkedOwned(channel,tx,true) != 0 || esp32p4AhbGdmaPrepareI2sOwned(channel,tx,0,true) != 3 || writes != 0) return i32(3)
            var pending=1
            while (pending <= 4) {
                reset();nativeAddressStoreU32(regs,16,(if (tx) 8 else 17)|(if (tx) pending else pending*2))
                if (esp32p4AhbGdmaPrepareI2sOwned(channel,tx,0,true) != 3 || writes != 0) return i32(4)
                pending=pending*2
            }
            var after=0
            while (after <= 8) {
                reset();stopping=true;delay=after
                // Initial read is not one of the bounded post-command polls.
                polls=-1
                nativeAddressStoreU32(regs,16,if (tx) 0x80000006 else 0x8000000d)
                if (esp32p4AhbGdmaStopOwned(channel,tx,8,true) != (if (after == 0) 3 else 1) ||
                    writes != 1 || polls != (if (after == 0) 8 else after) || bad) return i32(5)
                after=after+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    reset()
    if (esp32p4AhbGdmaParkedOwned(3,false,true) != -1 || esp32p4AhbGdmaStopOwned(0,false,0,true) != 2 ||
        esp32p4AhbGdmaStopOwned(0,false,1000001,true) != 2 || esp32p4AhbGdmaPrepareI2sOwned(0,false,3,true) != 2 ||
        esp32p4AhbGdmaPrepareI2sOwned(0,false,0,false) != 2 || reads != 0 || writes != 0) return i32(6)
    return i32(0)
}
