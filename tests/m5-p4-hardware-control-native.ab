import "../src/m5stack/control_bus_hardware_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(100)
var fail=0
var step=0
var sessionCloses=0
var busCloses=0
var clockCloses=0
var cleanup=0
var expectedSda=0
var expectedScl=0
var bad=false
trusted fun m5P4HardwareProviderFree(): bool = fail != 1
trusted fun m5P4HardwareClockOpen(layout: int): int { step=1;return if (fail == 2) 260 else 769 }
trusted fun m5P4HardwareClockClose(clock: int): int {
    if (step >= 2 && sessionCloses+busCloses == 0) bad=true
    clockCloses=clockCloses+1;return if (cleanup == 3) 260 else 0
}
trusted fun m5P4HardwareSessionOpen(r: NativeBuffer,port: int,sda: int,scl: int,layout: int,sourceHz: u32): int {
    if (step != 1 || sda != expectedSda || scl != expectedScl || r.capacity() != 72) bad=true
    step=2;r.storeU32(0,0x49324234);r.storeU32(4,if (fail == 3) 3 else 1)
    return if (fail == 3) 4 else 1
}
trusted fun m5P4HardwareBind(r: NativeBuffer,sourceHz: u32,cpuHz: u32): int {
    if (step != 2 || r.addressValue() != storage || r.capacity() != 96) bad=true
    step=3;return if (fail == 4) 0 else 123
}
trusted fun m5P4HardwareSessionClose(r: NativeBuffer): int {
    sessionCloses=sessionCloses+1
    if (cleanup == 1) return 7
    r.storeU32(4,4);return 8
}
trusted fun m5P4HardwareBusClose(bus: int): bool {
    if (bus != 123) bad=true
    busCloses=busCloses+1
    if (cleanup == 2) return false
    nativeBufferAt(storage,100).storeU32(28,4);return true
}
trusted fun seed(): void {
    var i=0
    while (i < 100) { nativeBufferAt(storage,100).storeU32(i,0);i=i+4 }
    nativeBufferAt(storage,100).storeU32(96,0x12345678)
    step=0;sessionCloses=0;busCloses=0;clockCloses=0;cleanup=0;bad=false;return
}
@export("abla_m5_p4_hardware_control_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(storage,100)
    var boardIndex=0
    while (boardIndex < 3) {
        val board=if (boardIndex == 0) m5BoardCoreP4X else if (boardIndex == 1) m5BoardTab5 else m5BoardTab5X
        expectedSda=if (boardIndex == 0) 11 else 31
        expectedScl=if (boardIndex == 0) 9 else 32
        fail=0
        while (fail <= 4) {
            seed()
            val result=m5P4HardwareControlOpenOwned(r,board,1,3,u32(40000000),u32(400000000),true)
            if (result != (if (fail == 0) 1 else fail+2) || bad || r.loadU32(96) != 0x12345678) return i32(1)
            if (fail == 1) {
                if (step != 0 || r.loadU32(0) != 0) return i32(2)
            } else {
                if (m5P4HardwareControlBus(r) != (if (fail == 0) 123 else 0)) return i32(3)
                cleanup=if (fail == 0) 2 else if (fail >= 3) 1 else 3
                if (m5P4HardwareControlCloseOwned(r,true) != 7 || (cleanup != 3 && clockCloses != 0)) return i32(4)
                cleanup=0
                if (m5P4HardwareControlCloseOwned(r,true) != 8 || bad) return i32(5)
                val calls=sessionCloses+busCloses+clockCloses
                if (m5P4HardwareControlCloseOwned(r,true) != 8 || calls != sessionCloses+busCloses+clockCloses) return i32(6)
            }
            fail=fail+1
        }
        seed();fail=0
        if (m5P4HardwareControlOpenOwned(r,board,0,1,u32(40000000),u32(400000000),true) != 1) return i32(7)
        cleanup=3
        if (m5P4HardwareControlCloseOwned(r,true) != 7 || busCloses != 1) return i32(8)
        cleanup=0
        if (m5P4HardwareControlCloseOwned(r,true) != 8 || busCloses != 1 || sessionCloses != 0 || bad) return i32(9)
        boardIndex=boardIndex+1
    }
    seed()
    if (m5P4HardwareControlOpenOwned(r,M5BoardId(0),0,1,u32(40000000),u32(400000000),true) != 2 || step != 0) return i32(10)
    return i32(0)
}
