import "../src/esp32/psram/memory_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_psram_memory_target")
trusted fun memoryTarget(record: NativeBuffer,action: int,address: int,physical: int,pages: int,capacity: int,line: int,readDummy: int,writeDummy: int,hex16: bool,polls: int): int =
    if (action == 0) (if (p4PsramMemoryInitializeOwned(record)) 1 else 2) else if (action == 1) p4PsramMemoryOpenOwned(record,address,physical,pages,capacity,line,readDummy,writeDummy,hex16,polls) else
    if (action == 2) p4PsramMemoryVerifyOwned(record,polls) else p4PsramMemoryCloseOwned(record,polls)
