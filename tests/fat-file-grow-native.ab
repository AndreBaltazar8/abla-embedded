import "../src/storage/fat_volume_grow.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
val image=nativeStaticAllocate(3584)
var writes=0
var failAt=0
var oldSize=100
var bad=false
fun slot(lba: int): int = if (lba == 1) 0 else if (lba == 41) 1 else if (lba == 81) 2
    else if (lba >= 113 && lba <= 116) lba-110 else -1
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,destination: NativeBuffer): bool {
    val selected=slot(lba)
    if (selected < 0 && lba != 0) return false
    val source=if (lba == 0) nativeBufferAt(memory+64,512) else nativeBufferAt(image+selected*512,512)
    var index=0
    while (index < 512) { destination.store(index,source.load(index));index=index+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool {
    writes=writes+1;val selected=slot(lba)
    if (selected < 0) return false
    // Publication cannot expose uninitialized bytes, even if writefails.
    if (lba == 81) {
        var offset=oldSize
        while (offset < 1200) {
            if (nativeBufferAt(image+1536,1536).load(offset) != 0) bad=true
            offset=offset+1
        }
    }
    val destination=nativeBufferAt(image+selected*512,512);var index=0
    while (index < 512) { destination.store(index,source.load(index));index=index+1 }
    return writes != failAt
}
@export("abla_fat_file_grow_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,32);val reader=nativeBufferAt(memory+32,28)
    val boot=nativeBufferAt(memory+64,512);val expected=nativeBufferAt(memory+576,32)
    val work=nativeBufferAt(memory+640,2560);val scratch=nativeBufferAt(memory+3200,512)
    val directory=nativeBufferAt(image+1024,512)
    var index=0
    while (index < 512) { boot.store(index,0);index=index+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2)
    boot.storeU16(17,512);boot.storeU16(22,40);boot.storeU16(19,10113);boot.storeU16(510,0xaa55)
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    val modified=rtcCalendarDateTime(2026,9,9,12,0,0)
    var mode=0
    while (mode < 2) {
        oldSize=if (mode == 0) 100 else 0
        var maximum=if (mode == 0) 12 else 14
        var failure=0
        while (failure <= maximum) {
            writes=0;failAt=failure;bad=false;index=0
            while (index < 3584) { nativeBufferAt(image,3584).store(index,77);index=index+1 }
            var copy=0
            while (copy < 2) {
                val fat=nativeBufferAt(image+copy*512,512);index=0
                while (index < 512) { fat.store(index,255);index=index+1 }
                fat.storeU16(4,if (mode == 0) 65535 else 0);fat.storeU16(6,0);fat.storeU16(8,0)
                copy=copy+1
            }
            index=0
            while (index < 32) { directory.store(index,0);index=index+1 }
            directory.store(0,65);directory.storeU16(26,if (mode == 0) 2 else 0);directory.storeU32(28,oldSize)
            index=0
            while (index < 32) { expected.store(index,directory.load(index));index=index+1 }
            val volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch)
            if (volume == 0) return i32(2)
            val result=volume.grow(u32(7),0,0,0,expected,1200,64,modified,work)
            if (bad || writes != (if (failure == 0) maximum else failure) ||
                (failure == 0 && result.status() != 1) || (failure != 0 && (result.status() == 1 || state.loadU32(12) != 3))) return i32(3)
            index=0
            while (index < oldSize) { if (nativeBufferAt(image+1536,512).load(index) != 77) return i32(4);index=index+1 }
            if (failure == 0) {
                if (directory.loadU32(28) != 1200 || directory.loadU16(26) != 2 || directory.load(11) != 32) return i32(5)
                copy=0
                while (copy < 2) {
                    val fat=nativeBufferAt(image+copy*512,512)
                    if (fat.loadU16(4) != 3 || fat.loadU16(6) != 4 || fat.loadU16(8) != 65535) return i32(6)
                    copy=copy+1
                }
            }
            if (!volume.invalidate(u32(7))) return i32(7)
            failure=failure+1
        }
        mode=mode+1
    }
    writes=0;failAt=0
    index=0
    while (index < 32) { expected.store(index,directory.load(index));index=index+1 }
    // A cyclic preexisting chain is rejected before any write.
    nativeBufferAt(image,512).storeU16(4,2)
    var volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch)
    if (volume.grow(u32(7),0,0,0,expected,1300,64,modified,work).status() != 5 || writes != 0 ||
        !volume.invalidate(u32(7))) return i32(8)
    nativeBufferAt(image,512).storeU16(4,3)
    volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch)
    expected.store(1,1)
    if (volume.grow(u32(7),0,0,0,expected,1300,64,modified,work).status() != 3 || writes != 0 ||
        state.loadU32(12) != 1) return i32(9)
    expected.store(1,directory.load(1))
    // Grow inside the already allocated final cluster: data+directory only.
    if (volume.grow(u32(7),0,0,0,expected,1300,64,modified,work).status() != 1 || writes != 2 ||
        directory.loadU32(28) != 1300 || !volume.invalidate(u32(7))) return i32(10)
    index=1200
    while (index < 1300) { if (nativeBufferAt(image+1536,1536).load(index) != 0) return i32(11);index=index+1 }
    return i32(0)
}
