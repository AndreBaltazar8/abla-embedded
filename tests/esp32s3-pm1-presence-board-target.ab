import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/pm1_presence.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pm1_presence_board_target")
trusted fun boardTarget(state: Pm1BatteryPresence,board: M5BoardId,pm1: M5Pm1,ioe: M5Ioe1,now: int): int =
    state.updateBoard(board,pm1,ioe,now)
