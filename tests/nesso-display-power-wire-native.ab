import "./nesso-power-wire-native.ab"
import "../src/m5stack/nesso_display_power.ab"
@export("abla_nesso_display_power_wire_test")
trusted fun testDisplayPower(): i32 {
    wireSeed();chargeAddress=68;afterCommit=false;bad=false;dropClose=false;ticks=0
    val gpioRegs=nativeBufferAt(gpioMemory,4096);var at=0
    while (at < 4096) { gpioRegs.storeU32(at,0);at=at+4 }
    apb=u32(0);functional=u32(0x300000);gpioClock=u32(0)
    var session=esp32C6I2cSessionOpenOwned(10,8,40000000,20000000,true,5,8)
    val device=session.bus().device(68,100000);val io=Pi4Ioe5v6408(device|0)
    val r=nativeBufferAt(chargeRegisters,256)
    if (!session.ready() || !device.valid()) return i32(1)
    var commit=0
    while (commit < 2) {
        afterCommit=commit == 1
        var fault=0
        while (fault <= 18) {
            at=0;while (at < 256) { r.store(at,90);at=at+1 }
            val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
            val result=io.prepareNessoDisplayOwned(true)
            val complete=if (fault == 0) 6 else (fault-1)/3
            if ((result&255) != (if (fault == 0) 1 else 4) || result>>>8 != complete ||
                ackCount-before != (if (fault == 0) 18 else fault) || bad) return i32(2)
            val applied=complete+(if (fault != 0 && commit == 1 && fault%3 == 0) 1 else 0)
            at=0
            while (at < 256) {
                val expected=if (at == 3 && applied >= 1) 199 else if (at == 7 && applied >= 2) 24 else
                    if (at == 5 && applied >= 3) (if (applied >= 6) 130 else 0) else
                    if (at == 13 && applied >= 4) 128 else if (at == 11 && applied >= 5) 255 else 90
                if (r.load(at) != expected) return i32(3)
                at=at+1
            }
            fault=fault+1
        }
        var brightness=0
        while (brightness <= 255) {
            var fault=0
            while (fault <= 6) {
                val initial=if (brightness == 0) 229 else 165
                r.store(5,initial)
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                if (io.setNessoBacklightOwned(brightness,true) != (fault == 0) || ackCount-before != (if (fault == 0) 6 else fault)) return i32(4)
                val changed=fault == 0 || (commit == 1 && fault == 6)
                if (r.load(5) != (if (changed) (if (brightness == 0) 165 else 229) else initial) || bad) return i32(5)
                fault=fault+1
            }
            brightness=brightness+1
        }
        commit=commit+1
    }
    val before=ackCount
    if (io.prepareNessoDisplayOwned(false) != 3 || io.setNessoBacklightOwned(256,true) || io.setNessoBacklightOwned(-1,true) ||
        io.setNessoBacklightOwned(1,false) || ackCount != before) return i32(6)
    nackAt=0
    if (!device.close() || io.setNessoBacklightOwned(0,true) || ackCount != before) return i32(7)
    session=session.closeOwned(true)
    if (session != 0 || bad) return i32(8)
    return i32(0)
}
