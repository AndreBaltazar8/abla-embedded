import "../src/esp32/dma_descriptor_chain.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val descriptorStorage = nativeStaticAllocate(24)
val bufferStorage = nativeStaticAllocate(8)
trusted fun dmaChainBoundaryTest(): int {
    var count = 1
    while (count <= 4095) {
        val lastValid = 4294967296 - count * 12
        if (espDmaDescriptorChainPack(lastValid, count, 0) < 0) return 1
        if (espDmaDescriptorChainPack(lastValid + 4, count, 0) >= 0) return 2
        if (!espDmaDescriptorChainLayoutValid(lastValid, count, 4096, 4, 4)) return 3
        if (espDmaDescriptorChainLayoutValid(lastValid + 4, count, 4096, 4, 4)) return 4
        // Must reject before any MMIO store to these synthetic addresses.
        if (espDmaInitializeRxChain(u32(lastValid + 4), u32(count), u32(4096), u32(4), u32(4))) return 7
        count = count + 1
    }
    if (espDmaDescriptorChainLayoutValid(4096, 2, 8192, 9223372036854775804, 4)) return 5
    if (espDmaDescriptorChainPack(4096, 0, 0) >= 0 || espDmaDescriptorChainPack(4096, 4096, 0) >= 0) return 6
    if (!espDmaInitializeRxChain(u32(descriptorStorage), u32(2), u32(bufferStorage), u32(4), u32(4))) return 8
    if (nativeAddressLoadU32(descriptorStorage, 0) != 2147483652 || nativeAddressLoadU32(descriptorStorage, 12) != 2147483652) return 9
    if (nativeAddressLoadU32(descriptorStorage, 4) != bufferStorage || nativeAddressLoadU32(descriptorStorage, 16) != bufferStorage + 4) return 10
    if (nativeAddressLoadU32(descriptorStorage, 8) != descriptorStorage + 12 || nativeAddressLoadU32(descriptorStorage, 20) != 0) return 11
    0
}
#exportFunction("dmaChainBoundaryTest", "abla_dma_chain_boundary_test")
