import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/expander_gpio.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_expander_gpio_target")
trusted fun gpioTarget(owner: M5Expanders,index: int,pin: int,mode: int,value: int): int {
    if (mode == 0) return if (owner.digitalWrite(index,pin,value != 0)) 1 else 0
    if (mode == 1) return if (owner.setDirection(index,pin,value != 0)) 1 else 0
    if (mode == 2) return if (owner.setPullMode(index,pin,value)) 1 else 0
    if (mode == 3) return owner.digitalReadChecked(index,pin) | 0
    owner.outputLatchChecked(index,pin) | 0
}
