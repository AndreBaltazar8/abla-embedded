import "../src/led/rmt_session_s3_sequence.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin=int
fun pin(n: int): Pin = Pin(n)
val record=nativeBufferAt(nativeStaticAllocate(40),40)
val storage=nativeBufferAt(nativeStaticAllocate(52),52)
val regs=nativeBufferAt(nativeStaticAllocate(24576),24576)
var prepared=1
var transfer=1
var recovered=1
var recoveryCalls=0
var displayCalls=0
var dropRestore=false
var writes=0
var bad=false
fun reset(): void {
    var n=0
    while (n < 24576) { regs.storeU32(n,0);n=n+4 }
    n=0;while (n < 40) { record.storeU32(n,0);n=n+4 }
    prepared=1;transfer=1;recovered=1;recoveryCalls=0;displayCalls=0;dropRestore=false;writes=0;bad=false;return
}
fun esp32S3PinStateRead(address: int): int = regs.loadU32(address-0x60004000)
fun esp32S3PinStateWrite(address: int,value: int): void {
    writes=writes+1
    if (dropRestore) return
    if (address == 0x60004028) regs.storeU32(32,regs.loadU32(32)&~value)
    else if (address == 0x60004024) regs.storeU32(32,regs.loadU32(32)|value)
    else if (address == 0x60004008) regs.storeU32(4,regs.loadU32(4)|value)
    else if (address == 0x6000400c) regs.storeU32(4,regs.loadU32(4)&~value)
    else regs.storeU32(address-0x60004000,value)
    return
}
fun esp32s3RmtPrepareRgbDmaOwned(pin: Pin,dma: int,owner: u32): int {
    if (pin != Pin(7) || dma != 2 || owner != u32(1) || record.loadU32(4) != 3 || record.loadU32(8) == 0) bad=true
    regs.storeU32(32,128);regs.storeU32(esp32S3GpioMuxAddress(7)-0x60004000,0x1000)
    return prepared
}
fun esp32s3GdmaLinearTxLayoutValid(desc: int,address: int,bytes: int): bool = bytes == 104
fun esp32s3GdmaLinearTxCount(bytes: int): int = 1
fun RmtLedStrip.displayDmaOwned(dma: int,desc: int,waveform: NativeBuffer,polls: int): int {
    displayCalls=displayCalls+1
    if (record.loadU32(4) != 3 || record.loadU32(36) != 1) bad=true
    return transfer
}
fun esp32s3RmtRecoverDmaOwned(dma: int,polls: int): int { recoveryCalls=recoveryCalls+1;return recovered }
@export("abla_rmt_led_session_test")
trusted fun test(): i32 {
    var failure=1
    while (failure <= 11) {
        reset();prepared=failure
        val strip=rmtLedStripAt(storage,7,1)
        if (rmtLedSessionBeginOwned(record,strip,2,u32(1),true) != (if (failure == 1) 1 else 3) || bad) return i32(1)
        if (rmtLedSessionBeginOwned(record,strip,2,u32(1),true) != 0) return i32(2)
        if (rmtLedSessionCloseOwned(record,4,true) != 2 || recoveryCalls != 0 || regs.loadU32(32) != 0 || regs.loadU32(esp32S3GpioMuxAddress(7)-0x60004000) != 0) return i32(3)
        failure=failure+1
    }
    var result=1
    while (result <= 11) {
        reset();transfer=result|0x100000
        val strip=rmtLedStripAt(storage,7,1)
        if (rmtLedSessionBeginOwned(record,strip,2,u32(1),true) != 1) return i32(4)
        if (rmtLedSessionDisplayOwned(record,4096,nativeBufferAt(8192,104),4,true) != transfer || record.loadU32(28) != transfer || bad) return i32(5)
        if (result != 1) {
            if (rmtLedSessionDisplayOwned(record,4096,nativeBufferAt(8192,104),4,true) != 2 || displayCalls != 1) return i32(6)
            recovered=5;val before=writes
            if (rmtLedSessionCloseOwned(record,4,true) != 3 || writes != before || record.loadU32(36) != 1) return i32(7)
            recovered=1
        }
        dropRestore=true
        if (rmtLedSessionCloseOwned(record,4,true) != 3 || record.loadU32(36) != 0) return i32(8)
        val before=recoveryCalls;dropRestore=false
        if (rmtLedSessionCloseOwned(record,4,true) != 2 || recoveryCalls != before || regs.loadU32(32) != 0) return i32(9)
        result=result+1
    }
    reset()
    val strip=rmtLedStripAt(storage,7,1)
    if (rmtLedSessionBeginOwned(record,strip,2,u32(1),false) != 0 || writes != 0) return i32(10)
    if (rmtLedSessionBeginOwned(record,strip,2,u32(1),true) != 1) return i32(11)
    if (rmtLedSessionDisplayOwned(record,record.addressValue(),nativeBufferAt(8192,104),4,true) != 2 ||
        rmtLedSessionDisplayOwned(record,4096,nativeBufferAt(record.addressValue(),104),4,true) != 2 || displayCalls != 0) return i32(12)
    return i32(0)
}
