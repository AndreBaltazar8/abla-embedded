import "../src/m5stack/imu_measurement.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_measurement_target")
trusted fun measurementTarget(owner: M5ImuOwner,snapshot: ImuSnapshot,offsets: ImuOffsets,
    board: M5BoardId,sensor: int,axis: int,userOrder: ImuAxisOrder): ImuFixedSample =
    owner.measureAxis(snapshot,offsets,board,sensor,axis,userOrder)
