// Host tests exercise only portable logic. The polling target fixture checks
// the Xtensa cycle-counter primitive using the actual target backend.
import "../src/esp32/i2c/status_s3_logic.ab"

trusted fun main(): int {
    if (esp32S3I2cPollResult(u32(0), true) != 0) return 1
    if (esp32S3I2cPollResult(u32(8), true) != 0 || esp32S3I2cPollResult(u32(8), false) != 2) return 2
    if (esp32S3I2cPollResult(u32(128), true) != 1) return 3
    if (esp32S3I2cPollResult(u32(128 | 1024), true) != 3) return 4
    if (esp32S3I2cPollResult(u32(128 | 1024 | 32), true) != 4) return 5
    if (esp32S3I2cPollResult(u32(128 | 256), true) != 5) return 6
    if (esp32S3I2cPollResult(u32(8192), true) != 5 || esp32S3I2cPollResult(u32(16384), true) != 5) return 7
    if (esp32S3I2cPollResult(u32(128 | 4), true) != 6) return 8
    if (esp32S3I2cDeadlineExpired(u32(0xfffffff0), u32(15), u32(32))) return 9
    if (!esp32S3I2cDeadlineExpired(u32(0xfffffff0), u32(16), u32(32))) return 10
    0
}
