import "../src/imu/offsets.ab"
import "abla/runtime/scalar"
import "abla/build"

@export("abla_imu_offsets_buffer_test")
trusted fun offsetsBufferTest(): i32 {
    val memory=nativeBufferAt(nativeStaticAllocate(80),80)
    var alignment=0
    while (alignment < 4) {
        var index=0
        while (index < 80) { memory.store(index,165); index=index+1 }
        val offsets=imuOffsetsFromBuffer(nativeBufferAt(memory.addressValue()+4+alignment,60))
        if (!offsets.valid() || offsets.buffer().capacity() != 36 ||
            offsets.get(0) != -1515870811) return i32(1)
        index=0
        while (index < 9) {
            val value=if (index == 0) -2147483648 else if (index == 8) 2147483647 else index*65536
            if (!offsets.setSensorAxis(index/3,index%3,value) || offsets.get(index) != value) return i32(2)
            index=index+1
        }
        if (offsets.set(-1,1) || offsets.set(9,1)) return i32(3)
        offsets.clear()
        index=0
        while (index < 80) {
            val expected=if (index >= 4+alignment && index < 40+alignment) 0 else 165
            if (memory.load(index) != expected) return i32(4)
            index=index+1
        }
        alignment=alignment+1
    }
    var length=0
    while (length < 36) {
        if (imuOffsetsFromBuffer(nativeBufferAt(memory.addressValue(),length)).valid()) return i32(5)
        length=length+1
    }
    if (imuOffsetsFromBuffer(nativeBufferAt(0,36)).valid() ||
        imuOffsetsFromBuffer(nativeBufferAt(4294967261,36)).valid() ||
        !imuOffsetsFromBuffer(nativeBufferAt(4294967260,36)).valid()) return i32(6)
    i32(0)
}
