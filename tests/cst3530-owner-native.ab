import "../src/touch/cst3530_owner_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var allocate=true
var begin=true
var release=true
var trace=0
var bad=false
var expectedBus=17
fun cst3530OwnerAllocate(bus: int,address: int,frequency: int): int {
    if (bus != expectedBus || address != 88 || frequency != 400000) bad=true
    trace=trace*10+1
    if (allocate) 123 else 0
}
fun cst3530OwnerBegin(handle: int): bool { if (handle != 123) bad=true; trace=trace*10+2; begin }
fun cst3530OwnerRelease(handle: int): bool { if (handle != 123) bad=true; trace=trace*10+3; release }
@export("abla_cst3530_owner_test")
fun testOwner(): i32 {
    var profile=0
    while (profile < 8) {
        allocate=(profile&1) != 0; begin=(profile&2) != 0; release=(profile&4) != 0; trace=0
        val owner=cst3530OpenOwned(17,88,400000)
        val expected=if (!allocate) 2 else if (begin) 1 else if (release) 3 else 4
        if (owner.status() != expected || owner.ready() != (expected == 1) ||
            trace != (if (!allocate) 1 else if (begin) 12 else 123) || bad) return i32(1)
        release=false; trace=0
        val retry=owner.closeOwned()
        if (owner.handle() != 0 && (retry.status() != 4 || retry.handle() != 123 || trace != 3)) return i32(2)
        if (owner.handle() == 0 && (retry != 0 || trace != 0)) return i32(3)
        trace=0
        if (retry.wakeOwned() != retry || trace != 0) return i32(4)
        release=true
        if (retry.closeOwned() != 0) return i32(5)
        profile=profile+1
    }
    var owner=Cst3530Owner((1<<32)|123)
    begin=false; trace=0
    owner=owner.wakeOwned()
    if (owner.status() != 5 || owner.ready() || owner.handle() != 123 || trace != 2) return i32(6)
    begin=true
    owner=owner.wakeOwned()
    if (!owner.ready() || trace != 22) return i32(7)
    trace=0
    if (cst3530OpenOwned(0,88,400000) != 0 || cst3530OpenOwned(17,128,400000) != 0 ||
        cst3530OpenOwned(17,88,0) != 0 || trace != 0) return i32(8)
    expectedBus=0x1fffffffe;allocate=true;begin=true;release=true
    val wide=cst3530OpenOwned(expectedBus,88,400000)
    if (!wide.ready() || bad || wide.closeOwned() != 0 || cst3530OpenOwned(0x200000000,88,400000) != 0) return i32(9)
    i32(0)
}
