import "../src/esp32/power/wake_clock_p4_sequence.ab"
var apb=u32(0)
var functional=u32(0)
var lpMux=u32(0)
var lpGpio=u32(0)
var reset=false
var changed=0
var fail=0
var bad=false
trusted fun p4IomuxClockRead(offset: int): u32 {
    if (offset == 32) return apb
    if (offset == 172) return functional
    if (offset == 196) return if (reset) u32(8) else u32(0)
    bad=true;return u32(0)
}
trusted fun p4IomuxClockWrite(offset: int,value: u32): void {
    val before=p4IomuxClockRead(offset)
    if (before != value) { changed=changed+1;if (changed == fail) return }
    if (offset == 32) apb=value else if (offset == 172) functional=value else bad=true
    return
}
trusted fun p4WakeClockRead(address: int): u32 {
    if ((apb&u32(8)) == u32(0)) bad=true
    if (address == 0x5012b000) return lpMux
    if (address == 0x5012a000) return lpGpio
    bad=true;return u32(0)
}
trusted fun p4WakeClockWrite(address: int,value: u32): void {
    val before=p4WakeClockRead(address)
    if (before != value) { changed=changed+1;if (changed == fail) return }
    if (address == 0x5012b000) lpMux=value else if (address == 0x5012a000) lpGpio=value else bad=true
    return
}
trusted fun seed(mask: int): void {
    apb=u32(0xa5000000)|(if ((mask&1) != 0) u32(8) else u32(0))
    functional=u32(0x5a000000)|(if ((mask&2) != 0) u32(512) else u32(0))
    lpMux=u32(0x12340000)|u32((mask>>2)&1)
    lpGpio=u32(0x56780000)|u32((mask>>3)&1)
    reset=false;changed=0;fail=0;bad=false;return
}
trusted fun restored(mask: int): bool = !bad &&
    apb == (u32(0xa5000000)|(if ((mask&1) != 0) u32(8) else u32(0))) &&
    functional == (u32(0x5a000000)|(if ((mask&2) != 0) u32(512) else u32(0))) &&
    lpMux == (u32(0x12340000)|u32((mask>>2)&1)) && lpGpio == (u32(0x56780000)|u32((mask>>3)&1))
@export("abla_wake_clock_p4_test")
trusted fun test(): i32 {
    var layout=1
    while (layout <= 3) {
        var mask=0
        while (mask < 16) {
            seed(mask)
            val owner=esp32p4WakeClockOpenOwned(layout,true)
            if (owner.status() != 1 || owner.ownsResources() != (mask != 15) || bad) return i32(1)
            val count=changed
            if (owner.closeOwned(true).status() != 6 || !restored(mask)) return i32(2)
            var fault=1
            while (fault <= count) {
                seed(mask);fail=fault
                val partial=esp32p4WakeClockOpenOwned(layout,true)
                if (partial.status() < 3 || partial.status() > 5 || changed != fault) return i32(3)
                fail=0
                if (partial.closeOwned(true).status() != 6 || !restored(mask)) return i32(4)
                seed(mask);val ready=esp32p4WakeClockOpenOwned(layout,true)
                changed=0;fail=fault
                val failed=ready.closeOwned(true)
                if (failed.status() < 3 || failed.status() > 5 || changed != fault) return i32(5)
                fail=0
                if (failed.closeOwned(true).status() != 6 || !restored(mask)) return i32(6)
                fault=fault+1
            }
            mask=mask+1
        }
        layout=layout+2
    }
    seed(0);reset=true
    val held=esp32p4WakeClockOpenOwned(1,true)
    if (held.status() != 3 || changed != 0 || held.closeOwned(true).status() != 6 || bad) return i32(7)
    if (esp32p4WakeClockOpenOwned(2,true).status() != 2 || changed != 0) return i32(8)
    return i32(0)
}
