import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/source_c5_sequence.ab"
var bus=u32(12)
var clock=u32(0)
var tx=false
var writes=0
var drop=0
var busy=false
var bad=false
trusted fun c5I2sClockRead(at: int): u32 = if (at == 0) bus else if (at == (if (tx) 4 else 12)) clock else u32(0)
trusted fun c5I2sClockWrite(at: int,v: u32): void {
    writes=writes+1
    if (at == 0) {
        if (((v^bus)&~u32(1)) != u32(0)) bad=true
        if (writes != drop) bus=v
    } else if (at == (if (tx) 4 else 12)) {
        if ((clock&u32(0x400000)) != u32(0) || ((v^clock)&~u32(0x300000)) != u32(0)) bad=true
        if (writes != drop) clock=v
    } else bad=true
    return
}
trusted fun c5I2sRead(at: int): u32 = if (at == 0x6c) u32(1) else if (at == 0x14 && busy) u32(1) else u32(0)
trusted fun c5I2sWrite(at: int,v: u32): void { bad=true;return }
@export("abla_i2s_source_c5_test")
trusted fun test(): i32 {
    var direction=0
    while (direction < 2) {
        tx=direction == 1
        var borrowed=0
        while (borrowed < 2) {
            var old=0
            while (old < 4) {
                var source=0
                while (source < 4) {
                    var fault=0
                    while (fault <= 5) {
                        val initial=u32(0xa5803456)|(u32(old)<<u32(20))
                        clock=initial;bus=u32(12|borrowed);writes=0;drop=fault
                        val opened=c5I2sSourceOpenOwned(tx,source,1,true)
                        if (opened.status() == 1 && (clock&u32(0x300000)) != (u32(source)<<u32(20))) return i32(1)
                        if (opened.status() != 1 && opened.status() != 4 && opened.status() != 7) return i32(2)
                        var closed=opened.closeOwned(true)
                        drop=0
                        if (closed.status() != 8) closed=closed.closeOwned(true)
                        if (closed.status() != 8 || bus != u32(12|borrowed) || clock != initial || bad) return i32(3)
                        val before=writes
                        if (closed.closeOwned(true) != closed || writes != before) return i32(4)
                        fault=fault+1
                    }
                    source=source+1
                }
                old=old+1
            }
            borrowed=borrowed+1
        }
        bus=u32(13);clock=u32(0x400000);writes=0
        if (c5I2sSourceOpenOwned(tx,1,1,true).status() != 6 || writes != 0) return i32(5)
        clock=u32(0);busy=true
        if (c5I2sSourceOpenOwned(tx,1,1,true).status() != 6 || writes != 0) return i32(6)
        busy=false
        val ready=c5I2sSourceOpenOwned(tx,1,1,true)
        clock=clock|u32(0x400000)
        val before=writes
        val waiting=ready.closeOwned(true)
        if (waiting.status() != 6 || writes != before) return i32(7)
        clock=clock&~u32(0x400000)
        if (waiting.closeOwned(true).status() != 8 || clock != u32(0)) return i32(8)
        bus=u32(0);clock=u32(0);writes=0
        val timeout=c5I2sSourceOpenOwned(tx,1,1,true)
        if (timeout.status() != 5 || timeout.closeOwned(true).status() != 8 || bus != u32(0)) return i32(9)
        direction=direction+1
    }
    return i32(0)
}
