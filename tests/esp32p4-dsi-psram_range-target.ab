import "../src/esp32/psram/range_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_psram_range_target")
trusted fun rangeTarget(record: NativeBuffer,action: int,address: int,physical: int,pages: int,capacity: int,polls: int): int =
    if (action == 0) (if (p4PsramRangeInitializeOwned(record)) 1 else 2) else if (action == 1) p4PsramRangeMapOwned(record,address,physical,pages,capacity,polls) else p4PsramRangeUnmapOwned(record,polls)
