import "../src/esp32/gdma_transfer_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var result = 16
var capacity = 16
var payload = 0x3fc90000
var next = 0
var tx = false
var caller = 0x3fca0000
var trace = 0
var rearmOk = true
var bad = false
fun esp32s3GdmaDescriptorValid(address: int): bool = address == 0x3fc88000 || address == 0x3fc8800c
trusted fun esp32s3GdmaCompletedBytes(descriptor: int): int { trace = trace * 10 + 1; result }
trusted fun esp32s3GdmaRead(address: int): int {
    if (address == 0x3fc88000) return capacity
    if (address == 0x3fc88004) return payload
    if (address == 0x3fc88008) return next
    bad = true
    0
}
trusted fun esp32s3GdmaCopyBytes(destination: int, source: int, count: int): void {
    if (trace != 1 || destination != (if (tx) payload else caller) || source != (if (tx) caller else payload) || count != 16) bad = true
    trace = trace * 10 + 2
    return
}
trusted fun esp32s3GdmaRearm(descriptor: int, transmit: bool, length: int, eof: bool): bool {
    if (trace != 12 || descriptor != 0x3fc88000 || transmit != tx || length != (if (tx) 16 else 0) || eof != tx) bad = true
    trace = trace * 10 + 3
    rearmOk
}
trusted fun gdmaTransferTest(): int {
    var direction = 0
    while (direction < 2) {
        tx = direction == 1
        trace = 0
        rearmOk = true
        if (esp32s3GdmaTransferBuffer(0x3fc88000, nativeBufferAt(caller, 16), tx, if (tx) 16 else 0, tx) != 16 || trace != 123 || bad) return 1
        trace = 0
        rearmOk = false
        if (esp32s3GdmaTransferBuffer(0x3fc88000, nativeBufferAt(caller, 16), tx, if (tx) 16 else 0, tx) != -5 || trace != 123 || bad) return 2
        direction = direction + 1
    }
    result = -1
    while (result >= -3) {
        trace = 0
        if (esp32s3GdmaTransferBuffer(0x3fc88000, nativeBufferAt(caller, 16), false, 0, false) != result || trace != 1) return 3
        result = result - 1
    }
    result = 16
    var variant = 0
    while (variant < 6) {
        caller = if (variant == 0) 0 else if (variant == 1) 0xfffffff8 else if (variant == 2) 0x3fc88004 else if (variant == 3) payload else 0x3fca0000
        next = if (variant == 5) 1 else 0
        trace = 0
        val expected = if (variant == 5) -3 else -4
        if (esp32s3GdmaTransferBuffer(0x3fc88000, nativeBufferAt(caller, if (variant == 4) 15 else 16), false, 0, false) != expected || trace != 1 || bad) return 4
        variant = variant + 1
    }
    0
}
#exportFunction("gdmaTransferTest", "abla_gdma_transfer_test")
