import "../src/m5stack/ioe1_es8311_speaker_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
type Es8311=int
type M5Ioe1=int
type Pin=int
type I2cByteResult=int
fun Es8311.valid(): bool = this == 2
fun M5Ioe1.valid(): bool = this == 3
fun I2cByteResult.valid(): bool = (this&256) != 0
fun I2cByteResult.value(): int = this&255
val enableEvents=nativeStaticU32s([3,4,8,5,6,7])
val disableWatchEvents=nativeStaticU32s([6,7,3,4])
val disableChainEvents=nativeStaticU32s([6,3,4])
var events=0
var calls=0
var fail=0
var watch=false
var enabled=false
var mismatch=false
var bad=false
trusted fun step(event: int): bool {
    if (event != nativeAddressLoadU32(events,calls*4)) bad=true
    calls=calls+1
    return calls != fail
}
trusted fun M5Ioe1.digitalWrite(pin: int,high: bool): bool {
    if (this != 3 || high != enabled || (pin != 9 && pin != (if (watch) 2 else 4))) bad=true
    return step(if (pin == 9) 6 else 3)
}
trusted fun M5Ioe1.getWriteValueChecked(pin: int): I2cByteResult {
    if (this != 3 || (pin != 9 && pin != (if (watch) 2 else 4))) bad=true
    if (!step(if (pin == 9) 7 else 4)) return I2cByteResult(if (mismatch) 256|(if (enabled) 0 else 1) else 0)
    return I2cByteResult(256|(if (enabled) 1 else 0))
}
trusted fun peripheralDelayMilliseconds(ms: int): void {
    if (ms != 10 || !enabled) bad=true
    step(8);return
}
trusted fun Es8311.configureSpeakerBclkOwned(exclusive: bool,volume: int): int {
    if (this != 2 || !exclusive || volume != 239 || !enabled) bad=true
    return if (step(5)) 1 else 9
}
trusted fun Pin.outputLevelOwned(high: bool): bool {
    if (this != 21 || watch || high != enabled) bad=true
    return step(6)
}
@export("abla_ioe1_es8311_speaker_test")
trusted fun test(): i32 {
    var variant=0
    while (variant < 8) {
        watch=(variant&1) != 0;enabled=(variant&2) != 0;mismatch=(variant&4) != 0
        val board=if (watch) m5BoardStopWatch else m5BoardChainCaptain
        events=if (enabled) enableEvents else if (watch) disableWatchEvents else disableChainEvents
        val count=if (enabled) (if (watch) 6 else 5) else if (watch) 4 else 3
        fail=0
        while (fail <= count) {
            calls=0
            val event=if (fail == 0) 0 else nativeAddressLoadU32(events,(fail-1)*4)
            val ignored=event == 0 || event == 8
            val expected=if (ignored) 1 else if (event == 5) 5|(9<<8) else event
            if (board.ioe1Es8311SpeakerOwned(Es8311(if (enabled) 2 else 0),M5Ioe1(3),enabled,true) != expected ||
                calls != (if (ignored) count else fail) || bad) return i32(1)
            fail=fail+1
        }
        variant=variant+1
    }
    calls=0
    if (m5BoardStopWatch.ioe1Es8311SpeakerOwned(Es8311(2),M5Ioe1(3),true,false) != 2 ||
        m5BoardStopWatch.ioe1Es8311SpeakerOwned(Es8311(0),M5Ioe1(3),true,true) != 2 ||
        m5BoardStopWatch.ioe1Es8311SpeakerOwned(Es8311(2),M5Ioe1(0),false,true) != 2 ||
        m5BoardStickS3.ioe1Es8311SpeakerOwned(Es8311(2),M5Ioe1(3),true,true) != 2 || calls != 0) return i32(2)
    return i32(0)
}
