import "../src/esp32/i2s/dma_stream_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var failure = 0
var trace = 0
var stopTrace = 0
var parkReads = 0
var cleanup = false
var timeout = false
var stoppedI2s = true
var stoppedDma = true
var published = false
fun esp32s3GdmaDescriptorValid(address: int): bool = address == 0x3fc88000
fun esp32s3GdmaEventMask(tx: bool): int = if (tx) 255 else 1023
trusted fun esp32s3GdmaParked(channel: int, tx: bool): bool {
    parkReads = parkReads + 1
    if (cleanup) return !timeout
    trace = trace * 10 + 1
    failure != 1
}
trusted fun esp32s3I2sResetDirection(port: int, tx: bool): bool { trace = trace * 10 + 2; failure != 2 }
trusted fun esp32s3GdmaConfigureI2s(channel: int, tx: bool, port: int, descriptor: int): bool { trace = trace * 10 + 3; failure != 3 }
trusted fun esp32s3GdmaAcknowledge(channel: int, tx: bool, mask: int): bool { trace = trace * 10 + 4; failure != 4 }
trusted fun esp32s3GdmaStart(channel: int, tx: bool): bool { trace = trace * 10 + 5; failure != 5 }
trusted fun esp32s3I2sStartDirection(port: int, tx: bool, polls: int): bool { trace = trace * 10 + 6; failure != 6 }
trusted fun esp32s3I2sStopDirection(port: int, tx: bool): bool { cleanup = true; stopTrace = stopTrace * 10 + 1; stoppedI2s }
trusted fun esp32s3GdmaRequestStop(channel: int, tx: bool): bool { stopTrace = stopTrace * 10 + 2; stoppedDma }
trusted fun esp32s3GdmaPublish(): void { published = true; return }
trusted fun i2sStreamTest(): int {
    failure = 0
    while (failure <= 6) {
        trace = 0
        stopTrace = 0
        cleanup = false
        published = false
        val result = esp32s3I2sStartStream(1, true, 3, 0x3fc88000, 4)
        var expectedTrace = 123456
        if (failure == 1) expectedTrace = 1
        if (failure == 2) expectedTrace = 12
        if (failure == 3) expectedTrace = 123
        if (failure == 4) expectedTrace = 1234
        if (failure == 5) expectedTrace = 12345
        val expected = if (failure == 0) 1 else if (failure == 6) 264 else failure + 2
        if (result != expected || trace != expectedTrace || stopTrace != (if (failure == 6) 12 else 0) || published != (failure == 6)) return 1
        failure = failure + 1
    }
    var variant = 0
    while (variant < 8) {
        stoppedI2s = (variant & 1) == 0
        stoppedDma = (variant & 2) == 0
        timeout = (variant & 4) != 0
        stopTrace = 0
        parkReads = 0
        published = false
        val expected = if (!stoppedI2s) 3 else if (!stoppedDma) 4 else if (timeout) 5 else 1
        if (esp32s3I2sStopStream(0, false, 4, 4) != expected || stopTrace != 12 || parkReads != (if (timeout) 4 else 1) || published != (expected == 1)) return 2
        variant = variant + 1
    }
    trace = 0
    stopTrace = 0
    if (esp32s3I2sStartStream(2, false, 0, 0x3fc88000, 4) != 2 || esp32s3I2sStartStream(0, true, 5, 0x3fc88000, 4) != 2 || esp32s3I2sStartStream(0, false, 0, 0, 4) != 2 || esp32s3I2sStopStream(0, true, 0, 0) != 2 || trace != 0 || stopTrace != 0) return 3
    0
}
#exportFunction("i2sStreamTest", "abla_i2s_stream_test")
