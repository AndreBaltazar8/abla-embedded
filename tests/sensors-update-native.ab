import "../src/m5stack/sensors_update_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(160)
var calls=0
trusted fun m5ImuOwnerReadPrimary(primary: M5ImuProbeResult,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int {
    calls=calls+1
    snapshot.commit(3,imuAxes(10,20,30),imuAxes(40,50,60),invalidImuAxes(),micros)
    3
}
trusted fun m5ImuOwnerReadMagnetic(mag: M5Magnetometers,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int { calls=calls+100; return -1 }
@export("abla_sensors_update_test")
trusted fun updateTest(): i32 {
    val owner=m5SensorsAt(nativeBufferAt(storage,72))
    val snapshot=imuSnapshotAt(nativeBufferAt(storage+80,44))
    val scratch=nativeBufferAt(storage+128,20)
    val offsets=imuOffsets()
    offsets.clear(); owner.initialize(); snapshot.initialize()
    owner.buffer().storeU32(16,1026); owner.buffer().storeU32(24,m5BoardAtomMatrix)
    val primary=(1<<48)|(3<<42)|(104<<35)|(2<<32)|100
    owner.imu().buffer().storeU32(4,1)
    owner.imu().buffer().storeU32(8,primary&0xFFFFFFFF); owner.imu().buffer().storeU32(12,primary>>>32)
    owner.imu().magnetometers().buffer().storeU32(16,2)
    val result=owner.updateImuOwned(snapshot,scratch,123)
    if (!result.valid() || result.fresh() != 3 || calls != 1 || snapshot.timestamp(0) != 123) return i32(1)
    val order=imuAxisOrder(0,2,4)
    if (owner.measureImuAxis(snapshot,offsets,0,0,order).fixed() != -655360 ||
        owner.measureImuAxis(snapshot,offsets,0,2,order).fixed() != -1966080) return i32(2)
    owner.buffer().storeU32(16,1034)
    if (owner.measureImuAxis(snapshot,offsets,0,0,order).fixed() != 655360 ||
        owner.measureImuAxis(snapshot,offsets,0,2,order).fixed() != 1966080) return i32(3)
    var offset=0
    while (offset < 72) {
        calls=0
        if (owner.updateImuOwned(snapshot,nativeBufferAt(storage+offset,20),124).valid() || calls != 0) return i32(4)
        offset=offset+1
    }
    // A valid snapshot magic can exist in header bytes without damaging the
    // aggregate/IMU magic: still reject this whole-record overlap before I/O.
    owner.buffer().storeU32(4,0x494D5531); owner.buffer().storeU32(8,0)
    if (owner.updateImuOwned(imuSnapshotAt(nativeBufferAt(storage+4,44)),scratch,124).valid() || calls != 0) return i32(5)
    owner.buffer().storeU32(16,0)
    if (owner.updateImuOwned(snapshot,scratch,124).valid() || owner.measureImuAxis(snapshot,offsets,0,0,order).valid()) return i32(6)
    i32(0)
}
