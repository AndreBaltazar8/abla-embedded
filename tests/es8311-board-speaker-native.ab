import "../src/m5stack/es8311_speaker_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
type Es8311=int
type M5Pm1=int
type M5Ioe1=int
type Pin=int
type I2cByteResult=int
fun Es8311.valid(): bool = this == 2
fun M5Pm1.valid(): bool = this == 3
fun I2cByteResult.valid(): bool = (this&256) != 0
fun I2cByteResult.value(): int = this&255
val order=nativeStaticU32s([3,4,0,0, 3,4,5,0, 6,3,0,0, 3,6,5,0, 0,0,0,0, 5,0,0,0, 6,0,0,0, 5,6,0,0])
val counts=nativeStaticU32s([2,3,2,3,0,1,1,2])
var row=0
var calls=0
var fail=0
var board=m5BoardStickS3
var enabled=false
var mismatch=false
var bad=false
trusted fun step(event: int): bool {
    if (event != nativeAddressLoadU32(order,(row*4+calls)*4)) bad=true
    calls=calls+1;return calls != fail
}
trusted fun M5Pm1.setGpioOutput(pin: int,high: bool): bool {
    if (this != 3 || board != m5BoardStickS3 || pin != 3 || high != enabled) bad=true
    return step(3)
}
trusted fun M5Pm1.gpioOutputLatchBitsChecked(): I2cByteResult {
    if (!step(4)) return I2cByteResult(if (mismatch) 256|(if (enabled) 0 else 8) else 0)
    return I2cByteResult(256|(if (enabled) 8 else 0))
}
trusted fun Es8311.configureSpeakerBclkOwned(exclusive: bool,volume: int): int {
    val expected=if (board == m5BoardPaperColor) 207 else if (board == m5BoardAtomVoiceS3R) 255 else 191
    if (this != 2 || !exclusive || !enabled || volume != expected) bad=true
    return if (step(5)) 1 else 10
}
trusted fun Pin.outputLevelOwned(high: bool): bool {
    if (high != enabled || (board == m5BoardPaperColor && this != 45 && this != 46) ||
        (board == m5BoardAtomVoiceS3R && this != 18)) bad=true
    return step(if (this == 45) 3 else 6)
}
fun M5BoardId.ioe1Es8311SpeakerOwned(codec: Es8311,io: M5Ioe1,high: bool,exclusive: bool): int {
    if ((this != m5BoardStopWatch && this != m5BoardChainCaptain) || codec != Es8311(2) || io != M5Ioe1(4) || !exclusive) bad=true
    return 7
}
@export("abla_es8311_board_speaker_test")
trusted fun test(): i32 {
    while (row < 8) {
        board=if (row < 2) m5BoardStickS3 else if (row < 4) m5BoardPaperColor else if (row < 6) m5BoardCardputerADV else m5BoardAtomVoiceS3R
        enabled=(row&1) != 0
        val count=nativeAddressLoadU32(counts,row*4)
        var variant=0
        while (variant < 2) {
            mismatch=variant == 1;fail=0
            while (fail <= count) {
                calls=0
                val event=if (fail == 0) 1 else nativeAddressLoadU32(order,(row*4+fail-1)*4)
                val expected=if (event == 5) 5|(10<<8) else event
                if (board.es8311SpeakerOwned(Es8311(if (enabled) 2 else 0),M5Pm1(if (board == m5BoardStickS3) 3 else 0),M5Ioe1(0),enabled,true) != expected ||
                    calls != (if (fail == 0) count else fail) || bad) return i32(1)
                fail=fail+1
            }
            variant=variant+1
        }
        row=row+1
    }
    calls=0
    if (m5BoardStickS3.es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(0),true,true) != 2 ||
        m5BoardCardputerADV.es8311SpeakerOwned(Es8311(0),M5Pm1(0),M5Ioe1(0),true,true) != 2 ||
        m5BoardPaperColor.es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(0),true,false) != 2 ||
        M5BoardId(0).es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(0),true,true) != 2 || calls != 0) return i32(2)
    if (m5BoardStopWatch.es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(4),true,true) != 7 ||
        m5BoardChainCaptain.es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(4),false,true) != 7 || bad) return i32(3)
    return i32(0)
}
