import "../src/esp32/radio/power_esp32_logic.ab"

fun main(): int {
    if (esp32DportWifiClockAddress != 1072693452) return 1
    if (esp32DportWifiResetAddress != 1072693456) return 2
    if (esp32RtcWifiPowerAddress != 1072988292) return 3
    if (esp32RtcWifiIsolationAddress != 1072988296) return 4
    if (esp32WifiMacControlAddress != 1073167544) return 5
    if (!esp32WifiClockEnabled(1030, esp32WifiMacClockMask)) return 6
    if (esp32WifiClockEnabled(2, esp32WifiMacClockMask)) return 7
    if (!esp32WifiClockEnabled(969, esp32WifiBtCommonClockMask)) return 8
    if (!esp32WifiPowerForced(131072, esp32WifiForcePowerDownMask)) return 9
    if (esp32WifiPowerForced(0, esp32WifiForceIsolationMask)) return 10
    if (esp32WifiPowerOnResetMask != 541 ||
        esp32WifiMacStateMask != 6143) return 11
    68
}
