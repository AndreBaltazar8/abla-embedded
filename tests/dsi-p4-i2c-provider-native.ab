import "../src/esp32/i2c/software_provider_p4.ab"
import "../src/m5stack/tab5_reset_provider_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val payload=nativeStaticAllocate(8)
var pads=0
var failPad=0
var drives=0
var nested=false
var bad=false
var activeBus=I2cBus(0)
var activeDevice=I2cDevice(0)
var lowPin=-1
var resetWrites=0
var resetFail=false
var resetWait=0
var resetLatch=0
var resetDirection=0
var resetHighZ=0
fun tab5ResetRead(bus: SoftwareI2cLines,register: int,scratch: NativeBuffer): I2cByteResult =
    I2cByteResult(256|(if (register == 5) resetLatch else if (register == 3) resetDirection else resetHighZ))
fun tab5ResetWrite(bus: SoftwareI2cLines,register: int,value: int,scratch: NativeBuffer): bool {
    resetWrites=resetWrites+1
    if (resetFail) return false
    if (register == 5) resetLatch=value else if (register == 3) resetDirection=value else resetHighZ=value
    return true
}
fun tab5ResetSelectAddress(high: bool): bool = true
trusted fun tab5ResetDelay(ms: int): void {
    resetWait=resetWait+ms
    if (activeBus.close() || activeDevice.close() || activeBus.device(68).valid() || activeBus.probeStatus(20) != 4) bad=true
    return
}
fun p4SoftwareI2cOutputEnabled(pin: int): bool = false
fun p4SoftwareI2cConfigurePad(pin: int,enable: bool): bool { pads=pads+1; return pads != failPad }
fun softwareI2cSample(pin: int): bool = pin != lowPin
trusted fun softwareI2cDrive(pin: int,release: bool): void {
    drives=drives+1
    if (nested) {
        nested=false
        if (activeDevice.close() || activeBus.close() || activeBus.device(68).valid()) bad=true
    }
    return
}
fun softwareI2cDelay(us: int): void { return }
@export("abla_dsi_p4_i2c_provider_test")
trusted fun testProvider(): i32 {
    activeBus=i2cSoftwareMaster(31,32)
    if (!activeBus.valid() || pads != 2 || i2cSoftwareMaster(31,32).valid()) return i32(1)
    activeDevice=activeBus.device(67)
    if (!activeDevice.valid() || !activeBus.current()) return i32(2)
    if (activeBus.resetTab5DisplayTouchOwned(nativeBufferAt(p4SoftwareProviderState,32)) != 2 || resetWrites != 0) return i32(23)
    if (activeBus.resetTab5DisplayTouchOwned(nativeBufferAt(payload,8)) != 1 || resetWrites != 4 || resetWait != 110 || bad) return i32(24)
    resetFail=true
    if (activeBus.resetTab5DisplayTouchOwned(nativeBufferAt(payload,8)) != (5|(5<<8)) || p4SoftwareProviderLoad(16) != 7) return i32(25)
    val savedResetWrites=resetWrites
    val savedDrives=drives
    if (activeDevice.transferStatus(NativeBuffer(0),0,NativeBuffer(0),0) != 7 || drives != savedDrives || p4SoftwareProviderLoad(16) != 7) return i32(28)
    if (activeBus.resetTab5DisplayTouchOwned(nativeBufferAt(payload,8)) != 11 || resetWrites != savedResetWrites) return i32(26)
    resetFail=false
    if (!activeBus.recover() || activeBus.resetTab5DisplayTouchOwned(nativeBufferAt(payload,8)) != 1) return i32(27)
    if (activeBus.prepareProbeStatus() != 1 || activeBus.probeStatus(20) != 5 || activeBus.prepareProbeStatus() != 1) return i32(15)
    drives=0
    lowPin=31
    if (activeBus.prepareProbeStatus() != 4 || activeBus.probeStatus(20) != 4 || drives != 0) return i32(16)
    lowPin=-1
    p4SoftwareProviderStore(16,3)
    if (activeBus.prepareProbeStatus() != 3 || activeBus.probeStatus(20) != 3 || drives != 0) return i32(17)
    lowPin=31
    if (activeBus.recoverStatus() != 4 || p4SoftwareProviderLoad(16) != 3) return i32(21)
    lowPin=-1
    if (!activeBus.recover() || activeBus.prepareProbeStatus() != 1 || p4SoftwareProviderLoad(16) != 0) return i32(22)
    drives=0
    p4SoftwareProviderStore(16,261)
    if (!p4SoftwareProviderEnter()) return i32(18)
    val busy=activeBus.prepareProbeStatus() == 4 && activeBus.probeStatus(20) == 4 && activeBus.recoverStatus() == 4
    if (!p4SoftwareProviderLeave() || !busy || drives != 0) return i32(19)
    nested=true
    if (activeDevice.transferStatus(NativeBuffer(0),0,nativeBufferAt(payload,8),1) != 5 || drives == 0 || bad) return i32(3)
    drives=0
    if (activeDevice.transferStatus(nativeBufferAt(p4SoftwareProviderState,32),1,NativeBuffer(0),0) != 2 ||
        activeDevice.transferStatus(NativeBuffer(0),0,nativeBufferAt(p4SoftwareProviderSlots+199,2),2) != 2 || drives != 0) return i32(4)
    if (!activeDevice.close() || activeDevice.close()) return i32(5)
    val replacement=activeBus.device(68)
    if (!replacement.valid() || replacement == activeDevice || activeDevice.transferStatus(NativeBuffer(0),0,nativeBufferAt(payload,8),1) != 2 || drives != 0) return i32(6)
    val oldBus=activeBus
    failPad=pads+2
    if (activeBus.close() || p4SoftwareProviderLoad(24) != 2 || replacement.close()) return i32(7)
    failPad=0
    if (!activeBus.close() || p4SoftwareProviderLoad(24) != 0) return i32(8)
    activeBus=i2cSoftwareMaster(31,32)
    if (oldBus.prepareProbeStatus() != 2 || oldBus.probeStatus(20) != 2 || activeBus.prepareProbeStatus() != 1) return i32(20)
    if (!activeBus.valid() || activeBus == oldBus || oldBus.close() || oldBus.device(67).valid() || esp32P4SoftwareI2cAbortSetup()) return i32(9)
    if (!activeBus.close()) return i32(10)
    failPad=pads+2
    if (i2cSoftwareMaster(31,32).valid() || p4SoftwareProviderLoad(24) != 2 || activeBus.close()) return i32(11)
    failPad=0
    if (!esp32P4SoftwareI2cAbortSetup() || p4SoftwareProviderLoad(24) != 0) return i32(12)
    activeBus=i2cSoftwareMaster(31,32)
    var count=0
    while (count < 16) { if (!activeBus.device(67).valid()) return i32(13); count=count+1 }
    if (activeBus.device(67).valid() || activeBus.probeStatus(20) != 5 || !activeBus.close()) return i32(14)
    // Unpublished busy setup can recover without reallocating its epoch/pads.
    val stale=activeBus
    lowPin=31
    if (i2cSoftwareMaster(31,32,5,8).valid()) return i32(29)
    val pendingEpoch=p4SoftwareProviderLoad(4)
    val savedPads=pads
    if (i2cSoftwareRecoverSetup().valid() || p4SoftwareProviderOwner().status() != 6 || pads != savedPads) return i32(30)
    lowPin=32
    if (i2cSoftwareRecoverSetup().valid() || p4SoftwareProviderOwner().status() != 10 || pads != savedPads) return i32(31)
    lowPin=-1;drives=0
    if (!p4SoftwareProviderEnter()) return i32(32)
    val refused=i2cSoftwareRecoverSetup().valid()
    if (!p4SoftwareProviderLeave() || refused || drives != 0) return i32(33)
    activeBus=i2cSoftwareRecoverSetup()
    if (!activeBus.current() || (activeBus|0) != pendingEpoch || pads != savedPads || stale.close() ||
        i2cSoftwareRecoverSetup().valid() || esp32P4SoftwareI2cAbortSetup()) return i32(34)
    if (!activeBus.device(67).valid() || !activeBus.close()) return i32(35)
    // A failed pad readback is not merely an idle-bus failure.
    failPad=pads+2
    if (i2cSoftwareMaster(31,32).valid()) return i32(36)
    drives=0
    if (i2cSoftwareRecoverSetup(true).valid() || drives != 0) return i32(37)
    failPad=0
    if (!esp32P4SoftwareI2cAbortSetup()) return i32(38)
    return i32(0)
}
