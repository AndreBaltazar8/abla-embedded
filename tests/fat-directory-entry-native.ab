import "../src/storage/fat_directory_entry.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(512)
@export("abla_fat_directory_entry_test")
trusted fun test(): i32 {
    val b=nativeBufferAt(storage,512)
    var i=0
    while (i < 512) { b.store(i,0); i=i+1 }
    var entry=0
    while (entry < 16) {
        val o=entry*32
        b.store(o,65); b.store(o+11,32); b.store(o+26,2)
        b.store(o+28,255); b.store(o+29,255); b.store(o+30,255); b.store(o+31,255)
        val result=fatDirectoryDecode(b,entry,32,100000)
        if (!result.isFile() || result.firstCluster() != 2 || result.byteSize() != 4294967295) return i32(1)
        b.store(o+20,1)
        if (fatDirectoryDecode(b,entry,32,100000).firstCluster() != 65538 || fatDirectoryDecode(b,entry,16,10000).firstCluster() != 2) return i32(2)
        b.store(o+20,0); b.store(o+11,16)
        if (fatDirectoryDecode(b,entry,32,100000).status() != 7) return i32(3)
        b.store(o+28,0); b.store(o+29,0); b.store(o+30,0); b.store(o+31,0)
        if (!fatDirectoryDecode(b,entry,32,100000).isDirectory()) return i32(4)
        b.store(o+26,0)
        if (fatDirectoryDecode(b,entry,32,100000).status() != 7) return i32(5)
        b.store(o,46); b.store(o+1,46)
        var j=2
        while (j < 11) { b.store(o+j,32); j=j+1 }
        val parent=fatDirectoryDecode(b,entry,32,100000)
        if (parent.status() != 8 || !parent.isDirectory() || parent.firstCluster() != 0) return i32(6)
        b.store(o+11,0)
        if (!fatDirectoryDecode(b,entry,32,100000).isFile() || fatDirectoryDecode(b,entry,32,100000).byteSize() != 0) return i32(7)
        b.store(o+11,15)
        if (fatDirectoryDecode(b,entry,32,100000).status() != 5) return i32(8)
        b.store(o+11,8)
        if (fatDirectoryDecode(b,entry,32,100000).status() != 6) return i32(9)
        b.store(o,229)
        if (fatDirectoryDecode(b,entry,32,100000).status() != 4) return i32(10)
        b.store(o,0)
        if (fatDirectoryDecode(b,entry,32,100000).status() != 3) return i32(11)
        b.store(o,5)
        if (fatShortNameByte(b,entry,0) != 229) return i32(12)
        entry=entry+1
    }
    if (fatDirectoryDecode(nativeBufferAt(storage,511),0,32,100000).status() != 7 || fatDirectoryDecode(b,16,32,100000).status() != 7 || fatDirectoryDecode(b,0,64,100000).status() != 7) return i32(13)
    return i32(0)
}
