@export("abla_fat_path_target")
trusted fun target(reader: int,boot: int,first: int,sectors: int,path: int,length: int,budget: int,name: int,work: int): int =
    fatLookupPathOwned(nativeBufferAt(reader,28),nativeBufferAt(boot,512),first,sectors,nativeBufferAt(path,length),length,budget,nativeBufferAt(name,11),nativeBufferAt(work,1536)).firstCluster()
