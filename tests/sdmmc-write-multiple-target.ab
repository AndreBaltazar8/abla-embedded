import "../src/sd/mmc_write_multiple_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_write_multiple_target")
trusted fun target(operation: int,address: int,card: int,descriptor: int,payload: int,sectors: int,sector: int,now: u32,budget: int,released: bool,allowWrite: bool): int {
    val context=nativeBufferAt(address,72)
    if (operation == 0) return sdMmcWriteMultipleBeginOwned(context,nativeBufferAt(card,80),nativeBufferAt(descriptor,sdMmcDmaDescriptorCount(sectors<<9)*16),nativeBufferAt(payload,sectors<<9),sector,sectors,now,budget,released,allowWrite)
    return sdMmcWriteMultiplePollOwned(context,now)
}
