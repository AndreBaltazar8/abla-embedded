import "../src/audio/pcm_source_render.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(512)
@export("abla_pcm_source_render_test")
trusted fun test(): i32 {
    val channel=pcmChannelAt(nativeBufferAt(memory,32),8000)
    val tone=pcmToneAt(nativeBufferAt(memory+32,32),8000,500000,1)
    val samples=nativeBufferAt(memory+64,4);samples.storeU16(0,1000);samples.storeU16(2,2000)
    val wav=pcmRaw(samples,nativeBufferAt(memory+68,20),8000,1,16)
    val output=nativeBufferAt(memory+96,128)
    var at=0
    while (at < 128) { output.store(at,42);at=at+1 }
    if (!channel.enqueue(wav,2) || !channel.enqueue(wav,1) || channel.availableFrames(32) != 6 ||
        channel.availableFrames(3) != 3 || tone.availableFrames(32) != 8) return i32(1)
    if (channel.renderAvailable(32,output) != 6 || channel.isPlaying() != 0 || output.load(24) != 42) return i32(2)
    if (tone.renderAvailable(26,nativeBufferAt(output.addressValue()+24,104)) != 8 ||
        tone.playing() || output.load(56) != 42) return i32(3)
    at=0
    while (at < 6) {
        val expected=if ((at&1) == 0) 1000 else 2000
        if (output.loadU16(at*4) != expected || output.loadU16(at*4+2) != expected) return i32(4)
        at=at+1
    }
    if (!channel.enqueue(wav,4294967295) || channel.availableFrames(268435455) != 268435455 ||
        channel.renderAvailable(1,output) != 1 || channel.storage().loadU32(16) != 1 ||
        channel.availableFrames(32) != 32) return i32(5)
    val cursor=channel.storage().loadU32(16);output.storeU32(0,12345)
    if (channel.renderAvailable(33,output) != -1 || channel.renderAvailable(1,samples) != -1 ||
        channel.storage().loadU32(16) != cursor || output.loadU32(0) != 12345 ||
        tone.renderAvailable(1,tone.storage()) != -1) return i32(6)
    channel.stop()
    if (!channel.enqueue(wav,1) || !channel.enqueue(wav,0) || channel.availableFrames(32) != 32 ||
        channel.renderAvailable(32,output) != 32 || channel.isPlaying() != 1) return i32(7)
    return i32(0)
}
