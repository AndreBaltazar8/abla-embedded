import "../src/audio/wav_pcm16_block.ab"
import "abla/runtime/scalar"
import "abla/build"
val sourceStorage=nativeStaticAllocate(64)
val infoStorage=nativeStaticAllocate(20)
val outputStorage=nativeStaticAllocate(962)
fun sample8(index: int): int = if (index%4 == 0) 0 else if (index%4 == 1) 128 else if (index%4 == 2) 255 else 127
fun sample16(index: int): int = if (index%4 == 0) 32768 else if (index%4 == 1) 0 else if (index%4 == 2) 32767 else 65535
trusted fun fixture(bits: int,channels: int): PcmWav {
    val source=nativeBufferAt(sourceStorage,64)
    val frameBytes=channels*(bits >>> 3)
    source.storeU32(0,0x46464952); source.storeU32(4,36+4*frameBytes); source.storeU32(8,0x45564157)
    source.storeU32(12,0x20746d66); source.storeU32(16,16)
    source.storeU16(20,1); source.storeU16(22,channels); source.storeU32(24,16000)
    source.storeU32(28,16000*frameBytes); source.storeU16(32,frameBytes); source.storeU16(34,bits)
    source.storeU32(36,0x61746164); source.storeU32(40,4*frameBytes)
    var index=0
    while (index < 4*channels) {
        if (bits == 8) source.store(44+index,sample8(index))
        else source.storeU16(44+index*2,sample16(index))
        index=index+1
    }
    pcmWav(source,nativeBufferAt(infoStorage,20))
}
@export("abla_wav_pcm16_test")
trusted fun wavPcm16Test(): i32 {
    val output=nativeBufferAt(outputStorage+1,32)
    val whole=nativeBufferAt(outputStorage,34)
    var bits=8
    while (bits <= 16) {
        var channels=1
        while (channels <= 2) {
            val wav=fixture(bits,channels)
            if (!wav.valid()) return i32(1)
            var first=0
            while (first <= 4) {
                var count=0
                while (count <= 4-first) {
                    var index=0
                    while (index < 34) { whole.store(index,85); index=index+1 }
                    if (wav.copyStereo16(first,count,output) != count*4) return i32(2)
                    index=0
                    while (index < count*2) {
                        val sourceIndex=(first+index/2)*channels+(if (channels == 1) 0 else index%2)
                        val expected=if (bits == 8) ((sample8(sourceIndex)-128)*256) & 65535 else sample16(sourceIndex)
                        if (output.loadU16(index*2) != expected) return i32(3)
                        index=index+1
                    }
                    if (whole.load(0) != 85) return i32(4)
                    index=count*4+1
                    while (index < 34) {
                        if (whole.load(index) != 85) return i32(5)
                        index=index+1
                    }
                    count=count+1
                }
                first=first+1
            }
            var index=0
            while (index < 34) { whole.store(index,85); index=index+1 }
            if (wav.copyStereo16(-1,1,output) != -1 || wav.copyStereo16(4,1,output) != -1 ||
                wav.copyStereo16(0,536870912,output) != -1 ||
                wav.copyStereo16(0,4,nativeBufferAt(outputStorage,15)) != -1 ||
                wav.copyStereo16(0,1,wav.samples()) != -1 ||
                wav.copyStereo16(0,1,nativeBufferAt(infoStorage,20)) != -1 ||
                PcmWav(0).copyStereo16(0,1,output) != -1) return i32(6)
            index=0
            while (index < 34) {
                if (whole.load(index) != 85) return i32(7)
                index=index+1
            }
            val block=nativeBufferAt(outputStorage+1,960)
            val guarded=nativeBufferAt(outputStorage,962)
            index=0
            while (index < 962) { guarded.store(index,85); index=index+1 }
            if (!wav.copyStereo16Block(0,block)) return i32(8)
            index=0
            while (index < 8) {
                val sourceIndex=(index/2)*channels+(if (channels == 1) 0 else index%2)
                val expected=if (bits == 8) ((sample8(sourceIndex)-128)*256) & 65535 else sample16(sourceIndex)
                if (block.loadU16(index*2) != expected) return i32(9)
                index=index+1
            }
            index=16
            while (index < 960) {
                if (block.load(index) != 0) return i32(10)
                index=index+1
            }
            if (!wav.copyStereo16Block(1,block) || guarded.load(0) != 85 || guarded.load(961) != 85) return i32(11)
            index=0
            while (index < 960) {
                if (block.load(index) != 0) return i32(12)
                index=index+1
            }
            if (wav.copyStereo16Block(-1,block) || wav.copyStereo16Block(4096,block) ||
                wav.copyStereo16Block(0,nativeBufferAt(infoStorage,960))) return i32(13)
            channels=channels+1
        }
        bits=bits+8
    }
    i32(0)
}
