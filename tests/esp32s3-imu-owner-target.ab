import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/imu_delay_1khz_esp32s3.ab"
import "../src/m5stack/imu_owner.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_owner_target")
trusted fun ownerTarget(owner: M5ImuOwner,bus: I2cBus,closing: bool): int =
    if (closing) (if (owner.close()) 0 else 4) else owner.open(bus)
