import "../src/esp32/reference_clock_owner_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var reg=u32(0)
var reads=0
var writes=0
var drop=false
var bad=false
fun p4ReferenceClockRead(offset: int): u32 { reads=reads+1; if (offset != 44) bad=true; return reg }
fun p4ReferenceClockWrite(offset: int,value: u32): void {
    writes=writes+1; if (offset != 44) bad=true
    if (!drop) reg=value
    return
}
@export("abla_reference_owner_p4_test")
trusted fun testOwner(): i32 {
    var preexisting=0
    while (preexisting < 2) {
        reg=if (preexisting == 0) u32(1) else u32(257)
        reads=0; writes=0
        var owner=esp32P4ReferenceClockOwner(20)
        owner=owner.acquireOwned()
        if (owner.references() != 1 || owner.status() != 1 || owner.borrowed() != (preexisting == 1) ||
            reg != u32(257) || writes != (if (preexisting == 1) 0 else 1)) return i32(1)
        reads=0; writes=0
        var i=1
        while (i < 65535) { owner=owner.acquireOwned(); i=i+1 }
        if (owner.references() != 65535 || reads != 0 || writes != 0 || owner.borrowed() != (preexisting == 1)) return i32(2)
        owner=owner.acquireOwned()
        if (owner.references() != 65535 || owner.status() != 2 || reads != 0 || writes != 0) return i32(3)
        i=65535
        while (i > 1) { owner=owner.releaseOwned(); i=i-1 }
        if (owner.references() != 1 || reads != 0 || writes != 0) return i32(4)
        owner=owner.releaseOwned()
        if (owner.references() != 0 || owner.status() != 0 || owner.borrowed() ||
            reg != (if (preexisting == 1) u32(257) else u32(1)) || writes != (if (preexisting == 1) 0 else 1)) return i32(5)
        reads=0; writes=0
        owner=owner.releaseOwned()
        if (reads != 0 || writes != 0) return i32(6)
        preexisting=preexisting+1
    }
    reg=u32(0); drop=true
    var failed=esp32P4ReferenceClockOwner(20).acquireOwned()
    if (failed.status() != 3 || failed.references() != 0 || !failed.cleanupRequired()) return i32(7)
    reads=0; writes=0
    if (failed.acquireOwned() != failed || reads != 0 || writes != 0) return i32(8)
    drop=false
    failed=failed.releaseOwned()
    if (failed.status() != 0 || failed.cleanupRequired()) return i32(9)
    failed=failed.acquireOwned(); drop=true
    failed=failed.releaseOwned()
    if (failed.status() != 4 || failed.references() != 1 || reg != u32(256)) return i32(10)
    drop=false; failed=failed.releaseOwned()
    if (failed.references() != 0 || reg != u32(0)) return i32(11)
    reads=0; writes=0
    val invalid=esp32P4ReferenceClockOwner(40)
    if (invalid.valid() || invalid.acquireOwned() != invalid || invalid.releaseOwned() != invalid || reads != 0 || writes != 0 || bad) return i32(12)
    i32(0)
}
