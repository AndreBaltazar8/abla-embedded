import "../src/m5stack/cores3_speaker_sequence.ab"
import "../src/m5stack/cores3_speaker_stream_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Aw88298 = int
type Aw9523 = int
fun Aw88298.valid(): bool = this != 0
fun Aw9523.valid(): bool = this != 0
fun aw88298RateIndex(rate: int): int = if (rate == 16000) 3 else -1
var trace = 0
var parked = true
var startResult = 1
var stopResult = 1
var enableOk = true
var configureOk = true
var disableOk = true
var clearOk = true
var bad = false
trusted fun Aw9523.digitalWrite(pin: int, enabled: bool): bool { if (pin != 2) bad = true; trace = trace * 10 + (if (enabled) 3 else 6); if (enabled) enableOk else clearOk }
trusted fun Aw88298.configureI2s16(rate: int): bool { if (rate != 16000) bad = true; trace = trace * 10 + 4; configureOk }
trusted fun Aw88298.disableI2s(): bool { trace = trace * 10 + 5; disableOk }
fun esp32s3GdmaDescriptorValid(address: int): bool = address == 0x3fc88000
trusted fun esp32s3GdmaParked(channel: int, tx: bool): bool { if (channel != 2 || !tx) bad = true; trace = trace * 10 + 1; parked }
trusted fun esp32s3I2sStartStream(port: int, tx: bool, channel: int, descriptor: int, polls: int): int { if (port != 1 || !tx || channel != 2 || descriptor != 0x3fc88000 || polls != 4) bad = true; trace = trace * 10 + 2; startResult }
trusted fun esp32s3I2sStopStream(port: int, tx: bool, channel: int, polls: int): int { if (port != 1 || !tx || channel != 2 || polls != 4) bad = true; trace = trace * 10 + 7; stopResult }
trusted fun speakerStreamTest(): int {
    var variant = 0
    while (variant < 8) {
        enableOk = (variant & 1) != 0
        configureOk = false
        disableOk = (variant & 2) == 0
        clearOk = (variant & 4) == 0
        stopResult = 1
        while (stopResult <= 5) {
            trace = 0
            val result = cores3StartSpeakerStream(Aw88298(1), Aw9523(1), 16000, 2, 0x3fc88000, 4)
            val detail = (if (enableOk) 4 else 3) | 256 | (if (disableOk) 0 else 512) | (if (clearOk) 0 else 1024)
            if (result.status() != 4 || result.dmaStatus() != stopResult || result.amplifierStatus() != detail || trace != (if (enableOk) 1234567 else 123567) || bad) return 1
            trace = 0
            val stopped = cores3StopSpeakerStream(Aw88298(1), Aw9523(1), 2, 4)
            if (stopped.status() != (if (disableOk && clearOk && stopResult == 1) 1 else 6) || stopped.dmaStatus() != stopResult || trace != 567 || bad) return 2
            stopResult = stopResult + 1
        }
        variant = variant + 1
    }
    enableOk = true
    configureOk = true
    trace = 0
    if (!cores3StartSpeakerStream(Aw88298(1), Aw9523(1), 16000, 2, 0x3fc88000, 4).valid() || trace != 1234) return 3
    startResult = 1288
    trace = 0
    val failed = cores3StartSpeakerStream(Aw88298(1), Aw9523(1), 16000, 2, 0x3fc88000, 4)
    if (failed.status() != 5 || failed.dmaStatus() != 1288 || trace != 12) return 4
    parked = false
    trace = 0
    if (cores3StartSpeakerStream(Aw88298(1), Aw9523(1), 16000, 2, 0x3fc88000, 4).status() != 3 || trace != 1) return 5
    trace = 0
    if (cores3StartSpeakerStream(Aw88298(0), Aw9523(1), 16000, 2, 0x3fc88000, 4).status() != 2 || cores3StopSpeakerStream(Aw88298(1), Aw9523(1), 5, 4).status() != 2 || trace != 0) return 6
    0
}
#exportFunction("speakerStreamTest", "abla_cores3_speaker_stream_test")
