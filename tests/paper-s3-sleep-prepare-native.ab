import "./paper-s3-sleep-run-native.ab"
import "../src/m5stack/paper_s3_sleep_prepare_sequence.ab"
import "../src/esp32/rtc_retention_tag_plan_s3.ab"
import "../src/esp32/clock_bias_s3.ab"
val prepareMemory=nativeStaticAllocate(9400)
var prepareOutcome=1
var prepareCalls=0
var prepareBad=false
fun esp32S3RetentionBuffersValid(cpu: NativeBuffer,tags: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan): bool = cpu.hasAddressRange(0,8800) && tags.hasAddressRange(0,256)
fun esp32S3TagBufferBytes(i: Esp32S3TagPlan,d: Esp32S3TagPlan): int = 256
fun esp32S3SleepPrepareRetainedOwned(sleep: NativeBuffer,cpu: NativeBuffer,tags: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan,bias: Esp32S3ClockBias,ports: int,flashOctal: bool,ramKind: int,protocol: int,baseline: int,polls: int,small: bool,monitor: bool,report: NativeBuffer): int {
    prepareCalls=prepareCalls+1
    if (ports != 3 || flashOctal || ramKind != -1 || protocol != 2 || baseline != 3 || polls != 100 || small || !monitor) prepareBad=true
    report.storeU32(0,42);report.storeU32(4,43)
    if (prepareOutcome == 1 || prepareOutcome == 5) { sleep.storeU32(0,0x53504c50);sleep.storeU32(4,9);sleep.storeU32(104,1) }
    else if (prepareOutcome == 3 || prepareOutcome == 4) { sleep.storeU32(0,0);sleep.storeU32(4,6);runProgress=1 }
    return prepareOutcome
}
@export("abla_paper_s3_sleep_prepare_test")
fun testPrepare(): int {
    val sleep=nativeBufferAt(runSleepMemory,128);val wake=nativeBufferAt(sessionMemory,36)
    val cpu=nativeBufferAt(prepareMemory,8800);val tags=nativeBufferAt(prepareMemory+8800,256)
    val config=nativeBufferAt(prepareMemory+9056,48);val report=nativeBufferAt(prepareMemory+9104,68)
    config.storeU32(24,3);config.storeU32(28,4);config.storeU32(32,-1);config.storeU32(36,2);config.storeU32(40,3);config.storeU32(44,100)
    var outcome=1
    while (outcome <= 5) {
        seedSession(wake,48,true);sleep.storeU32(0,0);sleep.storeU32(4,0);sleep.storeU32(108,0);report.storeU32(0,0);report.storeU32(64,0x12345678)
        prepareOutcome=outcome;prepareCalls=0;prepareBad=false;runProgress=0;runCalls=0;runResumes=0
        if (esp32S3GpioWakeSessionOpenOwned(wake,48,false,true) != 1) return 1
        val result=paperS3SleepPrepareOwned(sleep,wake,cpu,tags,config,report,true)
        if (result != (if (outcome == 1) 1 else if (outcome == 5) 4 else 3) || prepareCalls != 1 || prepareBad || runCalls != 0 || report.loadU32(8) != outcome || report.loadU32(32) != 42 || report.loadU32(64) != 0x12345678) return 2
        if (outcome == 5) {
            runProgress=1;sessionDrop=sessionWrites+1
            if (paperS3SleepPrepareOwned(sleep,wake,cpu,tags,config,report,true) != 4 || prepareCalls != 1) return 3
            sessionDrop=0
        }
        if (paperS3SleepPrepareOwned(sleep,wake,cpu,tags,config,report,true) != (if (outcome == 1) 1 else 3) || prepareCalls != 1 || report.loadU32(8) != outcome || (outcome != 1 && !restoredSession(wake))) return 4
        outcome=outcome+1
    }
    var a=0
    while (a < 6) {
        var b=a+1
        while (b < 6) {
            val dest=paperS3PrepareBuffer(b,sleep,wake,cpu,tags,config,report,256).addressValue()
            val length=paperS3PrepareBuffer(a,sleep,wake,cpu,tags,config,report,256).capacity()
            val overlap=nativeBufferAt(dest,length)
            val count=prepareCalls;val writes=sessionWrites
            if (paperS3SleepPrepareOwned(if (a == 0) overlap else sleep,if (a == 1) overlap else wake,if (a == 2) overlap else cpu,if (a == 3) overlap else tags,if (a == 4) overlap else config,report,true) != 2 || count != prepareCalls || writes != sessionWrites) return 5
            b=b+1
        }
        a=a+1
    }
    return 0
}
