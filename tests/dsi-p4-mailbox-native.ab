import "../src/display/dsi_mailbox_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(28)
var core=0
var masked=true
var enabled=u32(0)
var raw=u32(0)
var drop=false
var accesses=0
fun p4DsiMailboxCore(): int = core
fun p4DsiMailboxMasked(): bool = masked
fun p4DsiBridgeRead(offset: int): u32 { accesses=accesses+1; return if (offset == 80) enabled else raw&enabled }
fun p4DsiBridgeWrite(offset: int,value: u32): void {
    accesses=accesses+1
    if (offset == 80) { if (!drop) enabled=value } else raw=raw&(u32(4294967295)^value)
    return
}
@export("abla_dsi_p4_mailbox_test")
fun testMailbox(): i32 {
    val box=p4DsiMailboxAt(nativeBufferAt(storage,28))
    while (core < 2) {
        box.initialize(core,3,16)
        enabled=u32(0)
        if (box.resumeOwned() != 1) return i32(1)
        raw=u32(2)
        if (box.captureOwned(16,core) != 1 || box.resumeOwned() != 3 ||
            box.takeOwned() != (1|512|(3<<16)) || box.takeOwned() != 0 || box.resumeOwned() != 1) return i32(2)
        raw=u32(1)
        if (box.captureOwned(16,core) != 1 || box.takeOwned() != (1|256|(3<<16)) || box.resumeOwned() != 3) return i32(3)
        box.initialize(core,3,16); enabled=u32(3); raw=u32(2); drop=true
        if (box.captureOwned(16,core) != 4 || (box.takeOwned()&255) != 4 || box.resumeOwned() != 3) return i32(4)
        drop=false; core=core+1
    }
    accesses=0
    if (box.captureOwned(16,1) != 2 || box.takeOwned() != 2 || box.resumeOwned() != 2 || accesses != 0) return i32(5)
    core=1; masked=false
    if (box.captureOwned(16,1) != 2 || box.takeOwned() != 2 || accesses != 0) return i32(6)
    return i32(0)
}
