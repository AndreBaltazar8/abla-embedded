// Offline instruction-verifier regression; requires all six bring-up ELFs.
//
//     tools/abla-tool tests/p4-internal-entry-test.ab [BUILD_DIR]
//
// BUILD_DIR (default "build", relative to the working directory) holds
// <application>/layout-<n>/application.elf for p4-internal-console, tab5-control-bringup and
// tab5-panel-bringup, layouts 1 and 3.

import "abla/io"
import "abla/text"
import "abla/process/arguments"
import "../tools/check-p4-internal-entry.ab"
import "../tools/lib/elf.ab"
import "../tools/lib/xtensa-check.ab"

// File offset of the entry address in the ELF's program headers; -1 when no segment holds it.
fun entryFileOffset(elf: string): int {
    val entry = elfU32(elf, 24)
    val headers = elfU32(elf, 28)
    val count = elfU16(elf, 44)
    var index = 0
    while (index < count) {
        val header = headers + index * 32
        val tag = elfU32(elf, header)
        val offset = elfU32(elf, header + 4)
        val address = elfU32(elf, header + 8)
        val size = elfU32(elf, header + 16)
        if (tag == 1 && address <= entry && entry < address + size) return offset + entry - address
        index = index + 1
    }
    -1
}

fun main: int {
    val build = if (processArgumentCount() >= 1) processArgument(0) else "build"
    var failures = 0
    var mutants = 0
    for (application in ["p4-internal-console", "tab5-control-bringup", "tab5-panel-bringup"]) {
        for (layout in [1, 3]) {
            val path = "$build/$application/layout-$layout/application.elf"
            val file = readBinaryFile(path)
            if (file.error != "") {
                println("FAIL ${file.error}")
                return 1
            }
            val elf = file.data
            val verdict = validateP4Entry(elf)
            if (verdict != "") {
                println("FAIL $path rejected: $verdict")
                return 1
            }
            val location = entryFileOffset(elf)
            if (location < 0) {
                println("FAIL $path: entry has no load payload")
                return 1
            }
            // Corrupt privilege/core checks, relocations, BSS loop, call, handler CSR capture,
            // fences and magic commit independently.
            for (offset in [0, 8, 24, 32, 36, 44, 52, 60, 68, 84, 92, 128, 140, 152, 176, 192, 204, 208]) {
                val at = location + offset
                mutants = mutants + 1
                if (validateP4Entry(elfWithByte(elf, at, elf[at] ^ 1)) == "") {
                    println("FAIL $path: accepted a flipped bit at entry+$offset")
                    failures = failures + 1
                }
            }
        }
    }
    if (failures != 0) return 1
    println("PASS: instruction verifier accepted 6 bring-up ELFs and rejected $mutants corruptions")
    0
}
