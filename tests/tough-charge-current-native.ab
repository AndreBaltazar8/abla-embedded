import "../src/m5stack/toughc5_charge_current_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var failure=0
var bad=false
var requested=0
fun chargeStep(handle: int,step: int): bool { calls=calls+1; if (handle != 7 || step != calls) bad=true; step != failure }
fun toughChargePullNone(handle: int): bool = chargeStep(handle,1)
fun toughChargeLatch(handle: int,low: bool): bool { if (low != (requested < 830)) bad=true; chargeStep(handle,2) }
fun toughChargePushPull(handle: int): bool = chargeStep(handle,3)
fun toughChargeOutput(handle: int): bool = chargeStep(handle,4)
@export("abla_tough_charge_current_test")
fun currentTest(): i32 {
    requested=-1
    while (requested <= 1000) {
        failure=0
        while (failure < 5) {
            calls=0; bad=false
            val result=m5BoardToughC5.setToughChargeCurrentOwned(7,requested)
            val status=if (requested < 180) 4 else if (failure == 0) 1 else failure+4
            if (result.status() != status || calls != (if (requested < 180) 0 else if (failure == 0) 4 else failure) || bad ||
                (result.valid() && result.milliamps() != (if (requested < 830) 180 else 830))) return i32(1)
            failure=failure+1
        }
        requested=requested+1
    }
    calls=0
    if (m5BoardAtomMatrix.setToughChargeCurrentOwned(7,830).status() != 2 ||
        m5BoardToughC5.setToughChargeCurrentOwned(0,830).status() != 3 || calls != 0) return i32(2)
    i32(0)
}
