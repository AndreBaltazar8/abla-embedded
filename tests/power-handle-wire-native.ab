import "./pm1-control-wire-native.ab"
import "../src/power/axp192_device.ab"
import "../src/power/axp2101_device.ab"
import "../src/power/ip5306_device.ab"
import "../src/power/aw32001_device.ab"
import "../src/power/m5pm1_device.ab"
import "../src/power/bq27220_device.ab"
trusted fun peripheralDelayMilliseconds(milliseconds: int): void { bad=true;return }
@export("abla_power_handle_wire_test")
trusted fun testPowerHandles(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    if (!device.valid()) return i32(1)
    val handle=device|0
    var sample=0
    while (sample < 36) {
        val raw=if (sample == 0) 0 else if (sample == 1) -1 else if (sample == 2) 4294967296 else if (sample == 3) -9223372036854775807-1 else handle|(1<<(sample+28))
        val before=ackCount
        val axp192=Axp192(raw)
        if (axp192.valid() || (axp192.device()|0) != 0 || axp192.begin() || axp192.close()) return i32(2)
        if (axp192.setBatteryCharge(true)) return i32(3)
        val axp2101=Axp2101(raw)
        if (axp2101.valid() || (axp2101.device()|0) != 0 || axp2101.begin() || axp2101.close()) return i32(2)
        if (axp2101.setBatteryCharge(true)) return i32(3)
        val ip5306=Ip5306(raw)
        if (ip5306.valid() || (ip5306.device()|0) != 0 || ip5306.begin() || ip5306.close()) return i32(2)
        if (ip5306.setBatteryCharge(true)) return i32(3)
        val aw32001=Aw32001(raw)
        if (aw32001.valid() || (aw32001.device()|0) != 0 || aw32001.begin() || aw32001.close()) return i32(2)
        if (aw32001.setBatteryCharge(true)) return i32(3)
        val m5pm1=M5Pm1(raw)
        if (m5pm1.valid() || (m5pm1.device()|0) != 0 || m5pm1.begin() || m5pm1.close()) return i32(2)
        if (m5pm1.setBatteryCharge(true)) return i32(3)
        val bq27220=Bq27220(raw)
        if (bq27220.valid() || (bq27220.device()|0) != 0 || bq27220.begin() || bq27220.close()) return i32(2)
        if (bq27220.control(65) || bq27220.currentMilliampsChecked().valid() || bq27220.batteryMillivoltsChecked().valid()) return i32(3)
        if (Axp192(raw).chargingChecked().valid() || Axp2101(raw).chargingChecked().valid() || Ip5306(raw).chargingChecked().valid() || Aw32001(raw).chargingChecked().valid() || ackCount != before || bad) return i32(4)
        if (!device.writeRegister8(200,sample)) return i32(5)
        sample=sample+1
    }
    if (!device.close() || !bus.close() || bad) return i32(6)
    return i32(0)
}
