import "../examples/cores3-display-log/session.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(7700)
val gateStorage=nativeStaticMutableU32s([0,0])
var transfers=0
var transferStatus=1
var frameHash=u32(0)
trusted fun coreS3DisplayLogBlitOwned(gate: PeripheralGate,frame: NativeBuffer): SpiTransactionResult {
    transfers=transfers+1
    var hash=u32(0)
    var index=0
    while (index < 7680) { hash=hash*u32(33)+u32(frame.load(index)); index=index+1 }
    frameHash=hash
    return SpiTransactionResult(transferStatus<<32)
}
@export("abla_display_log_session_test")
trusted fun test(): i32 {
    val gate=u32(gateStorage)
    val frame=u32(storage)
    val text=u32(storage+7680)
    nativeBufferAt(storage+7680,1).store(0,65)
    if (coreS3DisplayLogExample(gate,frame,0,text,1,3) != 0 || !pending || transfers != 0) return i32(1)
    if (coreS3DisplayLogExample(gate,frame,1,text,1,3) != -2 || coreS3DisplayLogExample(gate,frame,3,text,1,3) != -2 || coreS3DisplayLogExample(gate,frame,0,text,1,3) != -1) return i32(2)
    if (coreS3DisplayLogExample(gate,frame,2,text,1,3) != 0 || pending || transfers != 1 || frameHash != u32(0)) return i32(3)
    if (coreS3DisplayLogExample(gate,frame,2,text,1,3) != 0 || transfers != 1) return i32(4)
    var failure=2
    while (failure <= 6) {
        transferStatus=failure
        val before=transfers
        if (coreS3DisplayLogExample(gate,frame,1,text,1,3) != -100-failure || !pending || transfers != before+1) return i32(5)
        val retained=cursor
        val hash=frameHash
        if (coreS3DisplayLogExample(gate,frame,1,text,1,3) != -2 || coreS3DisplayLogExample(gate,frame,3,text,1,3) != -2 || transfers != before+1 || cursor != retained) return i32(6)
        if (coreS3DisplayLogExample(gate,frame,2,text,1,3) != -100-failure || frameHash != hash || cursor != retained || !pending) return i32(7)
        transferStatus=1
        if (coreS3DisplayLogExample(gate,frame,2,text,1,3) != 0 || pending || frameHash != hash || cursor != retained || transfers != before+3) return i32(8)
        failure=failure+1
    }
    val before=transfers
    val retained=cursor
    if (coreS3DisplayLogExample(u32(gateStorage+4),frame,1,text,1,3) != -1 || coreS3DisplayLogExample(gate,frame,1,frame,1,3) != -1 || coreS3DisplayLogExample(gate,frame,1,text,1,6) != -1 || pending || transfers != before || cursor != retained) return i32(9)
    if (coreS3DisplayLogExample(gate,frame,3,text,1,3) != 0 || frameAddress != 0 || coreS3DisplayLogExample(gate,frame,2,text,1,3) != -1) return i32(10)
    if (coreS3DisplayLogExample(gate,u32(gateStorage),0,text,1,3) != -1 || coreS3DisplayLogExample(gate,frame,0,text,1,3) != 0) return i32(11)
    return i32(0)
}
