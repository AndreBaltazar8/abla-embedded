import "../src/m5stack/es8311_playback_prepare_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun pin(n: int): Pin = Pin(n)
type Esp32S3StandardDmaPreparation=int
// Independent board id,MCLK,BCLK,WS,DATA,port,mono-DMA.
val rows=nativeStaticU32s([26,18,17,15,14,0,0, 30,18,17,15,21,0,0, 32,40,38,41,42,0,0,
    28,42,40,41,38,0,0, 24,-1,41,43,42,1,1, 145,-1,17,3,48,1,1])
var row=0
var calls=0
var result=0
var bad=false
trusted fun expected(column: int): int {
    val value=nativeAddressLoadU32(rows,(row*7+column)*4)
    return if (value == 4294967295) -1 else value
}
trusted fun esp32s3PrepareStandard16Dma(port: int,tx: bool,m: Pin,b: Pin,w: Pin,d: Pin,slots: int,hz: int,
    channel: int,desc: int,count: int,payload: int,bytes: int,owner: u32,duplicateMono: bool): Esp32S3StandardDmaPreparation {
    calls=calls+1
    if (!tx || port != expected(5) || m != Pin(expected(1)) || b != Pin(expected(2)) || w != Pin(expected(3)) ||
        d != Pin(expected(4)) || slots != 3 || duplicateMono != (expected(6) != 0) || hz != 44100 || channel != 2 ||
        desc != 0x3fc88000 || count != 2 || payload != 0x3fc90000 || bytes != 16 || owner != u32(7)) bad=true
    return Esp32S3StandardDmaPreparation(result)
}
@export("abla_es8311_playback_prepare_test")
trusted fun test(): i32 {
    while (row < 6) {
        val board=M5BoardId(expected(0))
        result=1
        while (result <= 14) {
            calls=0
            val actual=board.prepareEs8311PlaybackOwned(44100,2,0x3fc88000,2,0x3fc90000,16,u32(7),true)
            if (actual != Esp32S3StandardDmaPreparation(result) || calls != 1 || bad) return i32(1)
            result=result+1
        }
        calls=0
        if (board.prepareEs8311PlaybackOwned(44100,2,0x3fc88000,2,0x3fc90000,16,u32(7),false) != Esp32S3StandardDmaPreparation(2) || calls != 0) return i32(2)
        row=row+1
    }
    calls=0
    if (m5BoardCardputer.prepareEs8311PlaybackOwned(44100,2,0x3fc88000,2,0x3fc90000,16,u32(7),true) != Esp32S3StandardDmaPreparation(2) || calls != 0) return i32(3)
    return i32(0)
}
