import "../src/m5stack/papermono_sdmmc_sequence.ab"
import "../src/m5stack/papermono_sdmmc_close_sequence.ab"
import "../src/m5stack/papermono_sd_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
type I2cDevice=int
fun Pin.outputCapable(): bool = this >= 0 && this <= 48
fun Pin.setPull(up: bool,down: bool): void { bad=true;return }
fun Pin.setDriveStrength(strength: int): bool { bad=true;return false }
fun Pin.routeOutputSignal(signal: int,inverted: bool): bool { bad=true;return false }
fun Pin.routeBidirectionalSignal(input: int,output: int): bool { bad=true;return false }
val memory=nativeStaticAllocate(192)
var bad=false
var stage=0
var failure=0
var admitted=true
var stopped=true
var reads=0
var readFailure=0
var seed=0
var bits=6
var closeTrace=0
var closeResult=2
var restoreFailure=false
fun paperMonoSdMmcCloseBegin(context: NativeBuffer): int {
    closeTrace=closeTrace*10+1
    if (closeResult == 2) context.store(0,6)
    return closeResult
}
fun paperMonoSdMmcClosePoll(context: NativeBuffer): int {
    closeTrace=closeTrace*10+2
    if (closeResult == 1) context.store(0,7)
    return closeResult
}
fun paperMonoSdMmcRestore(snapshot: NativeBuffer): int {
    closeTrace=closeTrace*10+3
    if (restoreFailure) return 34
    snapshot.storeU32(0,0x53445002);return 1
}
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    reads=reads+1
    if (this != 8 || register != (if (reads == 1) 20 else if (reads == 2) 4 else 6) || reads > 3) bad=true
    if (reads == readFailure) return I2cByteResult(0)
    val enabled=(bits&(1<<(reads-1))) != 0
    return I2cByteResult(256|(seed&~32)|(if (enabled) 32 else 0))
}
fun paperMonoSdMmcAdmission(control: int,context: NativeBuffer,snapshot: NativeBuffer): bool = admitted && control == 7
fun paperMonoSdMmcHostStopped(): bool = stopped
fun paperMonoSdMmcPowerReady(control: int): int { stage=stage*10+1;return paperMonoSdRailReady(I2cDevice(8)) }
fun paperMonoSdMmcCapture(pins: SdMmcPins,slot: int,snapshot: NativeBuffer): int {
    stage=stage*10+2
    if (pins != sdMmcPins(13,12,11,10,9,8) || slot != 1) bad=true
    if (failure == 2) return 2
    snapshot.storeU32(0,0x53445001);return 1
}
fun paperMonoSdMmcRoute(pins: SdMmcPins,slot: int): int { stage=stage*10+3;return if (failure == 3) 4 else 1 }
fun paperMonoSdMmcStart(context: NativeBuffer,slot: int,pll: bool,now: u32,budget: int): int {
    stage=stage*10+4
    if (slot != 1 || pll || now != u32(123) || budget != 2000) bad=true
    context.storeU32(0,0x53445302);return if (failure == 4) 3 else 2
}
@export("abla_papermono_sdmmc_test")
trusted fun test(): i32 {
    val context=nativeBufferAt(memory,128);val snapshot=nativeBufferAt(memory+128,64)
    while (seed < 256) {
        bits=0
        while (bits < 8) {
            readFailure=0
            while (readFailure <= 3) {
                reads=0;bad=false
                val result=paperMonoSdRailReady(I2cDevice(8))
                if (result != (if (readFailure != 0) 2 else if (bits == 6) 1 else 3) ||
                    reads != (if (readFailure == 0) 3 else readFailure) || bad) return i32(1)
                readFailure=readFailure+1
            }
            bits=bits+1
        }
        seed=seed+1
    }
    bits=6;readFailure=0;seed=0
    while (failure <= 4) {
        context.storeU32(0,0);snapshot.storeU32(0,0);stage=0;reads=0
        if (failure == 1) readFailure=2 else readFailure=0
        val result=paperMonoSdMmcBeginOwned(7,context,snapshot,1,false,u32(123),2000,true)
        if (result != (if (failure == 0) 2 else if (failure == 1) 4 else failure+4) ||
            stage != (if (failure == 1) 1 else if (failure == 2) 12 else if (failure == 3) 123 else 1234) || bad) return i32(2)
        if (failure == 3 && snapshot.loadU32(56) != 4) return i32(3)
        failure=failure+1
    }
    context.storeU32(0,0);snapshot.storeU32(0,0);stage=0;stopped=false
    if (paperMonoSdMmcBeginOwned(7,context,snapshot,1,false,u32(123),2000,true) != 3 || stage != 0) return i32(4)
    stopped=true;admitted=false
    if (paperMonoSdMmcBeginOwned(7,context,snapshot,1,false,u32(123),2000,true) != 3 || stage != 0) return i32(5)
    admitted=true
    if (paperMonoSdMmcBeginOwned(7,context,nativeBufferAt(memory+64,64),1,false,u32(123),2000,true) != 3 ||
        paperMonoSdMmcBeginOwned(7,context,snapshot,1,false,u32(123),2000,false) != 3 || stage != 0) return i32(6)
    var index=0
    while (index < 64) { snapshot.store(index,0);index=index+1 }
    snapshot.storeU32(0,0x53445001);snapshot.store(4,1);snapshot.store(5,6)
    index=0
    while (index < 6) { snapshot.storeU32(8+index*4,(1<<29)|((13-index)<<23));index=index+1 }
    context.storeU32(0,0x53445302);context.store(5,1)
    if (paperMonoSdMmcCloseOwned(context,snapshot,true) != 3 || closeTrace != 0) return i32(7)
    context.store(0,1)
    if (paperMonoSdMmcCloseOwned(context,snapshot,true) != 2 || closeTrace != 1 || snapshot.loadU32(0) != 0x53445001) return i32(8)
    closeTrace=0;closeResult=4
    if (paperMonoSdMmcCloseOwned(context,snapshot,true) != 4 || closeTrace != 2) return i32(9)
    closeTrace=0;closeResult=1;restoreFailure=true
    if (paperMonoSdMmcCloseOwned(context,snapshot,true) != 6 || closeTrace != 23 || context.load(0) != 7 || snapshot.loadU32(0) != 0x53445001) return i32(10)
    closeTrace=0;restoreFailure=false;stopped=false
    if (paperMonoSdMmcCloseOwned(context,snapshot,true) != 4 || closeTrace != 0) return i32(11)
    stopped=true
    if (paperMonoSdMmcCloseOwned(context,snapshot,true) != 1 || closeTrace != 3 || snapshot.loadU32(0) != 0x53445002) return i32(12)
    closeTrace=0
    if (paperMonoSdMmcCloseOwned(context,snapshot,true) != 1 || closeTrace != 0) return i32(13)
    // A failed route before host startup restores only the captured pins.
    context.storeU32(0,0);snapshot.storeU32(0,0x53445001)
    if (paperMonoSdMmcCloseOwned(context,snapshot,true) != 1 || closeTrace != 3) return i32(14)
    closeTrace=0;snapshot.storeU32(0,0x53445001);snapshot.storeU32(8,(1<<29)|(7<<23))
    if (paperMonoSdMmcCloseOwned(context,snapshot,true) != 3 || closeTrace != 0 ||
        paperMonoSdMmcCloseOwned(context,snapshot,false) != 3) return i32(15)
    return i32(0)
}
