import "../src/esp32/adc1_oneshot_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var control=1
var mux=0
var sample=0x80040000
var state=0
var writes=0
var reads=0
var drop=0
var complete=true
var raw=1234
var bad=false
fun esp32S3Adc1Read(offset: int): int {
    reads=reads+1
    if (offset == 0) return control
    if (offset == 16) return mux
    if (offset == 64) return state
    if (offset == 12) return sample
    bad=true; return 0
}
fun esp32S3Adc1Write(offset: int,value: int): void {
    if (offset != 12 || (value&0x1ffff) != 0) bad=true
    writes=writes+1
    if (writes == drop) return
    sample=value
    if ((value&0x20000) != 0 && complete) sample=sample|0x10000|raw
    return
}
@export("abla_adc1_oneshot_s3_test")
fun test(): i32 {
    var channel=0
    while (channel < 10) {
        raw=0
        while (raw < 4096) {
            sample=0x80040000; writes=0
            if (esp32S3Adc1StartOwned(channel,3) != 257 || writes != 2) return i32(1)
            if (esp32S3Adc1FinishOwned(channel,3) != ((raw<<8)|1)) return i32(2)
            if (esp32S3Adc1ReleaseOwned(channel,3) != 1 || sample != 0x80040000) return i32(3)
            raw=raw+1
        }
        channel=channel+1
    }
    complete=false; sample=0x80040000; writes=0
    if (esp32S3Adc1StartOwned(0,3) != 257 || esp32S3Adc1FinishOwned(0,3) != 6 || esp32S3Adc1ReleaseOwned(0,3) != 6 || esp32S3Adc1StartOwned(0,3) != 4 || writes != 2) return i32(4)
    sample=sample|0x10000|123
    if (esp32S3Adc1FinishOwned(0,3) != 31489 || esp32S3Adc1ReleaseOwned(0,3) != 1) return i32(5)
    complete=true; raw=4096
    if (esp32S3Adc1StartOwned(0,3) != 257 || esp32S3Adc1FinishOwned(0,3) != 7 || esp32S3Adc1ReleaseOwned(0,3) != 1) return i32(6)
    raw=17; drop=1; writes=0
    if (esp32S3Adc1StartOwned(1,3) != 261 || writes != 1 || esp32S3Adc1ReleaseOwned(1,3) != 1) return i32(7)
    drop=2; writes=0
    if (esp32S3Adc1StartOwned(1,3) != 261 || writes != 2 || esp32S3Adc1ReleaseOwned(1,3) != 1) return i32(8)
    drop=0
    if (esp32S3Adc1StartOwned(1,3) != 257) return i32(9)
    writes=0; drop=1
    if (esp32S3Adc1ReleaseOwned(1,3) != 5 || esp32S3Adc1ReleaseOwned(1,3) != 1) return i32(10)
    drop=0; sample=0x800c0000; writes=0
    if (esp32S3Adc1StartOwned(1,3) != 3 || esp32S3Adc1ReleaseOwned(1,3) != 3 || writes != 0) return i32(11)
    sample=0x80040000; state=0x400000
    if (esp32S3Adc1StartOwned(0,3) != 4 || esp32S3Adc1ReleaseOwned(0,3) != 6 || writes != 0) return i32(12)
    state=0; mux=0x80000000
    if (esp32S3Adc1StartOwned(0,3) != 3 || esp32S3Adc1ReleaseOwned(0,3) != 3) return i32(13)
    mux=0; control=0x10000001
    if (esp32S3Adc1StartOwned(0,3) != 3) return i32(14)
    reads=0
    if (esp32S3Adc1StartOwned(10,3) != 2 || esp32S3Adc1FinishOwned(-1,3) != 2 || esp32S3Adc1ReleaseOwned(0,0) != 2 || reads != 0 || bad) return i32(15)
    return i32(0)
}
