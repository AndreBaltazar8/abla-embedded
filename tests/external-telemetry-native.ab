import "../src/m5stack/external_telemetry_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var observedSource=0
var rawWord=0
var failed=false
var bad=false
fun externalTelemetryPm1Read(handle: int,source: int): I2cWordResult {
    calls=calls+1; observedSource=source
    if (handle != 7) bad=true
    I2cWordResult(if (failed) 0 else 65536|rawWord)
}
@export("abla_external_telemetry_test")
fun telemetryTest(): i32 {
    while (rawWord <= 65535) {
        calls=0
        val chain=m5BoardChainCaptain.pm1ExternalMillivoltsCheckedOwned(7,7)
        val direct=m5BoardStopWatch.pm1ExternalMillivoltsCheckedOwned(7,1)
        val plc=m5PlcBusMillivolts(I2cWordResult(65536|rawWord))
        if (!chain.valid() || chain.value() != rawWord+(if (rawWord >= 2000) 530 else 0) ||
            !direct.valid() || direct.value() != rawWord || !plc.valid() ||
            plc.value() != rawWord+rawWord/4 || calls != 2 || bad) return i32(1)
        rawWord=rawWord+1
    }
    rawWord=5000
    var profile=0
    while (profile < 5) {
        val board=if (profile == 0) m5BoardChainCaptain else if (profile == 1) m5BoardStopWatch
            else if (profile == 2) m5BoardStickS3 else if (profile == 3) m5BoardStampS3Bat else m5BoardStackCore2
        var ports=-1
        while (ports <= 256) {
            var failure=0
            while (failure < 2) {
                failed=failure == 1; calls=0; observedSource=0
                val supported=if (profile == 0) ports >= 1 && ports <= 7 else profile < 4 && ports == 1
                val result=board.pm1ExternalMillivoltsCheckedOwned(7,ports)
                if (result.valid() != (supported && !failed) || calls != (if (supported) 1 else 0) ||
                    observedSource != (if (!supported) 0 else if (profile == 0 && (ports & 1) != 0) 1 else 2)) return i32(2)
                failure=failure+1
            }
            if (m5BoardStampPLC.plcExternalTelemetrySupported(ports) != (ports == 64 || ports == 128 || ports == 192) ||
                m5BoardStopWatch.plcExternalTelemetrySupported(ports)) return i32(3)
            ports=ports+1
        }
        profile=profile+1
    }
    calls=0
    if (m5BoardChainCaptain.pm1ExternalMillivoltsCheckedOwned(0,1).valid() ||
        m5BoardChainCaptain.pm1ExternalMillivoltsCheckedOwned(-1,1).valid() ||
        m5BoardChainCaptain.pm1ExternalMillivoltsCheckedOwned(4294967296,1).valid() ||
        m5PlcBusMillivolts(I2cWordResult(0)).valid() || calls != 0) return i32(4)
    i32(0)
}
