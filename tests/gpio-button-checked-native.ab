import "../src/esp32/button_checked_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 0 && this <= 54
var level=0
var reads=0
var initialized=0
var initializeOk=true
trusted fun Pin.readLevelOwned(): int { reads=reads+1;return level }
trusted fun Pin.inputOwned(): bool { initialized=initialized+1;return initializeOk }
@export("abla_gpio_button_checked_test")
trusted fun testButtons(): i32 {
    var number=-1
    while (number <= 300) {
        val input=pin(number).asButton()
        val encoded=if (number >= 0 && number < 255) number else 255
        if (input.pin().number() != encoded) return i32(1)
        reads=0;initialized=0
        val valid=number >= 0 && number <= 54
        if (input.initializeOwned() != valid || initialized != (if (valid) 1 else 0)) return i32(2)
        level=0
        if (input.updateAtOwned(0).valid() != valid || reads != (if (valid) 1 else 0)) return i32(3)
        number=number+1
    }
    var polarity=0
    while (polarity < 2) {
        var button=pin(39).asButton(polarity == 0)
        var tick=0
        while (tick < 1000) {
            level=if (tick%13 == 0) -1 else if ((tick/40)%2 == 0) 0 else 1
            reads=0;val before=button
            val result=button.updateAtOwned(tick*5)
            if (reads != 1) return i32(4)
            if (level < 0) {
                if (result.valid() || result.button() != before) return i32(5)
            } else {
                val expected=before.updateWith(if (polarity == 0) level == 0 else level == 1,tick*5)
                if (!result.valid() || result.button() != expected || result.button().pin().number() != 39 || result.button().activeLow() != (polarity == 0)) return i32(6)
                button=result.button()
            }
            tick=tick+1
        }
        // A state borrowed from another source must not merge pin/polarity bits.
        val replaced=button.withState(pin(54).asButton(polarity != 0).state())
        if (replaced.pin().number() != 39 || replaced.activeLow() != (polarity == 0)) return i32(7)
        if (button.updateFromLevel(2,6000).valid()) return i32(8)
        polarity=polarity+1
    }
    initializeOk=false;initialized=0
    if (pin(4).asButton().initializeOwned() || initialized != 1) return i32(9)
    return i32(0)
}
