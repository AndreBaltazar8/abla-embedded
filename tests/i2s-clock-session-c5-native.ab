import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/clock_session_c5_sequence.ab"
var bus=u32(0)
var txClock=u32(0)
var rxClock=u32(0)
var txFraction=u32(0)
var rxFraction=u32(0)
var conf=u32(0)
var tx=false
var writes=0
var drop=0
var busy=false
var bad=false
trusted fun c5I2sClockRead(at: int): u32 = if (at == 0) bus else if (at == 4) txClock else if (at == 8) txFraction else if (at == 12) rxClock else rxFraction
trusted fun c5I2sClockWrite(at: int,v: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (at == 0) bus=v else if (at == 4) txClock=v else if (at == 8) txFraction=v else if (at == 12) rxClock=v else if (at == 16) rxFraction=v else bad=true
    return
}
trusted fun c5I2sRead(at: int): u32 {
    if ((bus&u32(15)) != u32(13)) bad=true
    if (at == 0x6c) return u32(1)
    if (at == 0x14 && busy) return u32(1)
    if (at == (if (tx) 0x24 else 0x20)) return conf
    return u32(0)
}
trusted fun c5I2sWrite(at: int,v: u32): void {
    writes=writes+1
    if (at != (if (tx) 0x24 else 0x20) || ((v^conf)&~u32(0x7e00000)) != u32(0)) bad=true
    if (writes != drop) conf=v
    return
}
@export("abla_i2s_clock_session_c5_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(32)
    val r=nativeBufferAt(storage,32)
    var direction=0
    while (direction < 2) {
        tx=direction == 1
        var variant=0
        while (variant < 16) {
            val oldBus=u32(0x8000000c)|u32(variant&1)
            val oldTx=u32(0x80112000)|(if ((variant&2) != 0) u32(0x400000) else u32(0))
            val oldRx=u32(0x90123000)|(if ((variant&4) != 0) u32(0x400000) else u32(0))|(if ((variant&8) != 0) u32(0x800000) else u32(0))
            var fault=0
            while (fault <= 32) {
                var at=0
                while (at < 32) { r.storeU32(at,0);at=at+4 }
                bus=oldBus;txClock=oldTx;rxClock=oldRx;txFraction=u32(0xab123456);rxFraction=u32(0xd8123456);conf=u32(0xa4200000);writes=0;drop=fault;bad=false
                val result=c5I2sClockSessionOpenOwned(r,tx,1,7,3,8,8,1,true)
                if (result != 1 && result != 4) return i32(1)
                val primary=r.loadU32(8)
                c5I2sClockSessionCloseOwned(r,true)
                drop=0
                if (c5I2sClockSessionCloseOwned(r,true) != 6 || bus != oldBus || txClock != oldTx || rxClock != oldRx || txFraction != u32(0xab123456) || rxFraction != u32(0xd8123456) || conf != u32(0xa4200000) || r.loadU32(8) != primary || bad) return i32(2)
                fault=fault+1
            }
            variant=variant+1
        }
        direction=direction+1
    }
    return i32(0)
}
