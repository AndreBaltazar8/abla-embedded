import "../src/esp32/pll_start_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(80)
var xtal=40
var parent=0
var gate=0
var selector=0
var conf=4
var route=0
var control=0
var pending=0
var writes=0
var failAt=0
var pllDelay=0
var power=0
var allowed=true
var bad=false
trusted fun c5PllRead(address: int): int {
    if (address == 0x60096110) return sys
    if (address == 0x60096144) return 0
    if (address == 0x60096128) return parent
    if (address == 0x600af018) return gate
    if (address == 0x600af820) return route
    if (address == 0x600af81c) return selector
    if (address == 0x600af818) {
        if ((gate&4) == 0 || (parent&2) == 0) bad=true
        return conf|(if (allowed && power == 3) 0x1000000 else 0)
    }
    if (address == 0x600af800 || address == 0x600af804) {
        if ((gate&4) == 0 || (parent&2) == 0 || address != (if (route == 0) 0x600af804 else 0x600af800)) bad=true
        if (pending > 0) { pending=pending-1;return control|0x2000000 }
        return control
    }
    bad=true;return 0
}
trusted fun c5PllWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (address == 0x600b00cc) {
        if (value == 0x70000000) power=power|1 else if (value == 0x02000000) power=power|2 else bad=true
    } else if (address == 0x60096128) parent=value
    else if (address == 0x600af018) gate=value
    else if (address == 0x600af81c) selector=value
    else if (address == 0x600af818) conf=value&0xffffff
    else if (address == 0x600af800 || address == 0x600af804) {
        if (pending != 0 || (value&255) != 0x66 || selector != 0xffff7f || (gate&4) == 0 || (parent&2) == 0) bad=true
        val reg=(value>>8)&255
        if (reg > 15) { bad=true;return }
        val bytes=nativeBufferAt(memory+64,16)
        if ((value&0x1000000) != 0) bytes.store(reg,(value>>16)&255)
        control=(value&65535)|(bytes.load(reg)<<16);pending=1
    } else bad=true
    return
}
trusted fun c5AnalogRead(address: int): int = c5PllRead(address)
trusted fun c5AnalogWrite(address: int,value: int): void { c5PllWrite(address,value);return }
trusted fun c5PllDelay(us: int): void { if (us != 10 || !allowed || (conf&8) == 0) bad=true;pllDelay=pllDelay+us;return }

import "../src/esp32/power/pvt_restart_c5_sequence.ab"
val pvtMemory=nativeStaticAllocate(88)
val parkMemory=nativeStaticAllocate(24)
var pvtwrites=0
var pvtfailAt=0
var pvtdelayed=0
var rawGap=0
var revision=0x200
fun slot(address: int): int = if (address == 0x600960b8) 0 else if (address == 0x600960bc) 1 else if (address == 0x60019064) 2 else if (address == 0x60019034) 3 else if (address == 0x6001903c) 4 else if (address == 0x60019040) 5 else if (address == 0x60019044) 6 else if (address == 0x60019050) 7 else if (address == 0x60019054) 8 else if (address == 0x60019058) 9 else if (address == 0x600190d8) 10 else if (address == 0x600190dc) 11 else if (address == 0x600190e0) 12 else if (address == 0x6001902c) 13 else if (address == 0x60019014) 14 else if (address == 0x60019028) 15 else if (address == 0x600b0028) 16 else if (address == 0x60019030) 17 else -1
trusted fun reg(address: int): int = nativeBufferAt(pvtMemory+16,72).loadU32(slot(address)*4)
trusted fun put(address: int,value: int): void { nativeBufferAt(pvtMemory+16,72).storeU32(slot(address)*4,value);return }
trusted fun c5PvtParkRead(address: int): int {
    if (address == 0x60096144) return 0
    if (address == 0x60096110) return sys
    if (address == 0x600b49d4) return 1
    if (address == 0x600b484c) return revision
    if (address == 0x600b4854) return rawGap<<1
    if (address == 0x600b009c) return nativeBufferAt(parkMemory,24).loadU32(20)
    if (slot(address) < 0) { bad=true;return 0 }
    if (address >= 0x60019000 && address < 0x60019100 && (reg(0x600960b8)&1) == 0) bad=true
    // WT bit reads as1 deliberately: implementation must not replay it.
    if (address == 0x600190d8 || address == 0x600190dc || address == 0x600190e0) return reg(address)|2
    reg(address)
}
trusted fun c5PvtParkWrite(address: int,value: int): void {
    if (pllDelay != 10 || (parent&2) == 0 || (sys&0x30000) != 0) bad=true
    pvtwrites=pvtwrites+1
    if (pvtwrites == pvtfailAt) return
    if (address == 0x600b009c) { nativeBufferAt(parkMemory,24).storeU32(20,value);return }
    if (slot(address) < 0) { bad=true;return }
    if ((address == 0x600190d8 || address == 0x600190dc || address == 0x600190e0) && (value&2) != 0) bad=true
    if (address == 0x600b0028 && (value&0x4000) == 0 && (reg(address)&0x4000) != 0 && pvtdelayed < 11) bad=true
    if (address == 0x60019028 && (value&512) != 0 && pvtdelayed < 61) bad=true
    if (address == 0x600960b8 && (value&2) != 0) {
        put(0x60019064,0)
        put(0x60019034,0)
        put(0x6001903c,0)
        put(0x60019040,0)
        put(0x60019044,0)
        put(0x60019050,0)
        put(0x60019054,0)
        put(0x60019058,0)
        put(0x600190d8,0)
        put(0x600190dc,0)
        put(0x600190e0,0)
        put(0x6001902c,0)
        put(0x60019014,0)
        put(0x60019028,0)
        put(0x60019030,0)
    }
    put(address,value);return
}
trusted fun c5PvtRestartDelay(us: int): void {
    if (us != 1 && us != 10 && us != 50) bad=true
    if (us == 1 && (reg(0x60019064)&0x80000000) != 0) bad=true
    if (us == 10 && (reg(0x600190d8)&1) == 0) bad=true
    if (us == 50 && ((reg(0x60019064)&0x80000000) == 0 || (reg(0x600b0028)&0x4008) != 0)) bad=true
    pvtdelayed=pvtdelayed+us;return
}

import "../src/esp32/clock_resume_c5_sequence.ab"
// Actual CPU, PLL, analog-bus and PVT sequences share one modeled device.
// Only MMIO and ROM delays are substituted. No subsystem success stubs.
var sys=0
var cpu=0
var ahb=0
var ticks=0
var rcPower=0
var rcGate=0
var rcDelay=0
var cpuWrites=0
var cpuFailAt=0
var needsPvt=false
var needsPll=false
trusted fun c5ClockResumeRead(address: int): int = if (address == 0x600b00ac) rcPower else if (address == 0x600b0420) rcGate else c5PvtParkRead(address)
trusted fun c5ClockResumeWrite(address: int,value: int): void {
    if (address == 0x600b00ac) rcPower=value
    else if (address == 0x600b0420) { if (rcDelay < 50) bad=true;rcGate=value }
    else bad=true
    return
}
trusted fun c5ClockResumeDelay(us: int): void { if (us != 50 && us != 5) bad=true;rcDelay=rcDelay+us;return }
trusted fun c5ClockResumePll(record: NativeBuffer,limit: int): int = esp32C5PllStartOwned(record,true,limit)
trusted fun c5ClockResumePvt(record: NativeBuffer): int = esp32C5PvtRestartOwned(record,true)
trusted fun c5CpuClockRead(offset: int): int = if (offset == 0x110) sys else if (offset == 0x118) cpu else if (offset == 0x11c) ahb else if (offset == 0x128) parent else 0
trusted fun c5CpuClockWrite(offset: int,value: int): void {
    cpuWrites=cpuWrites+1
    // The update strobe has no software readback, so inject only shadows/gates.
    if (cpuWrites == cpuFailAt && offset != 0x144) return
    if (offset == 0x128) { if (pllDelay != 10) bad=true;parent=value }
    else if (offset == 0x118) cpu=value
    else if (offset == 0x11c) ahb=value
    else if (offset == 0x110) sys=value
    else if (offset == 0x144) {
        if (value != 1 || (needsPll && pllDelay != 10) || (needsPvt && (pvtdelayed != 61 || (reg(0x60019028)&512) == 0))) bad=true
        if ((sys&0x30000) == 0x10000 && (rcDelay < 55 || (rcPower&0x40000000) == 0 || (rcGate&0x80000000) == 0)) bad=true
    } else bad=true
    return
}
trusted fun c5CpuClockTicks(mhz: int): void { ticks=mhz;return }
@export("abla_clock_resume_components_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,64);val bytes=nativeBufferAt(memory+64,16)
    val regs=nativeBufferAt(pvtMemory+16,72)
    var mode=0
    while (mode < 64) {
        val peripheralPll=(mode&32) != 0
        xtal=if ((mode&1) == 0) 40 else 48
        val source=(mode>>1)&3
        needsPvt=(mode&8) != 0;needsPll=source >= 2 || needsPvt || peripheralPll
        route=if ((mode&16) == 0) 0 else 512
        val plan=C5CpuClock(source|(if (source == 3) (1<<2)|(5<<10) else if (source == 2) 3<<10 else 0)|(xtal<<18))
        var fault=0
        while (fault < 104) {
            // 1,2 are unacknowledged PMU power strobes, not recoverable faults.
            if (fault != 1 && fault != 2) {
                record.storeU32(0,0);sys=xtal<<24;cpu=7;ahb=7;ticks=0
                parent=0x100;gate=0x80;selector=0x13579b;conf=0x123404;control=0;pending=0
                power=0;writes=0;failAt=if (fault < 65) fault else 0;pllDelay=0;bad=false;allowed=false
                pvtwrites=0;pvtfailAt=if (fault >= 65 && fault < 98) fault-64 else 0;pvtdelayed=0
                cpuWrites=0;cpuFailAt=if (fault >= 98) fault-97 else 0
                rcPower=5;rcGate=5;rcDelay=0;rawGap=mode&31
                var i=0;while (i < 16) { bytes.store(i,0xa5);i=i+1 }
                i=0;while (i < 72) { regs.storeU32(i,0);i=i+4 }
                put(0x600b0028,0x4000|(23<<9)|(17<<4))
                val first=esp32C5ClockResumeOwned(record,plan,needsPvt,true,3,peripheralPll)
                if (first != 1 && first != 3 && first != 4) return i32(1)
                if (first != 1 && ticks != 0) return i32(2)
                if (needsPll && (pvtwrites != 0 || ticks != 0)) return i32(3)
                // Calibration becomes ready; remaining single dropped write may
                // occur in PVT/CPU later. Retry with actual child state retained.
                allowed=true;failAt=0
                val second=esp32C5ClockResumeOwned(record,plan,needsPvt,true,3,peripheralPll)
                if (second != 1 && second != 3) return i32(4)
                pvtfailAt=0;cpuFailAt=0
                if (esp32C5ClockResumeOwned(record,plan,needsPvt,true,3,peripheralPll) != 1 || bad) return i32(5)
                if (ticks != (if (source == 3) 120 else if (source == 2) 160 else if (source == 1) 20 else xtal)) return i32(6)
                if (parent != (0x100|(if (source == 3) 1 else if (source == 2) 2 else 0)|(if (needsPvt) 2 else 0)) || gate != 0x80 || selector != 0x13579b) return i32(7)
                if (pllDelay != (if (needsPll) 10 else 0) || pvtdelayed != (if (needsPvt) 61 else 0)) return i32(8)
                if (needsPll && (bytes.load(2) != 0x51 || bytes.load(3) != (if (xtal == 48) 10 else 12))) return i32(9)
                val before=writes+pvtwrites+cpuWrites
                if (esp32C5ClockResumeOwned(record,plan,needsPvt,true,64,!peripheralPll) != 2 || writes+pvtwrites+cpuWrites != before) return i32(11)
                if (esp32C5ClockResumeOwned(record,plan,needsPvt,true,64,peripheralPll) != 1 || writes+pvtwrites+cpuWrites != before) return i32(10)
            }
            fault=fault+1
        }
        mode=mode+1
    }
    // Foreign live records must survive admission unchanged, with no MMIO.
    var foreign=1
    while (foreign <= 3) {
        record.storeU32(0,if (foreign == 1) 0x43504b31 else if (foreign == 2) 0xffffffff else 1)
        val tag=record.loadU32(0);val before=writes+pvtwrites+cpuWrites
        if (esp32C5ClockResumeOwned(record,C5CpuClock(40<<18),false,true) != 2 ||
            esp32C5PllStartOwned(record,true) != 2 || esp32C5PvtRestartOwned(record,true) != 2 ||
            record.loadU32(0) != tag || writes+pvtwrites+cpuWrites != before) return i32(11)
        foreign=foreign+1
    }
    return i32(0)
}
