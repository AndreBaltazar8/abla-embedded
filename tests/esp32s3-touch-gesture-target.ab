import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/input/touch_ft5x06.ab"
import "../src/input/touch_gt911.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")

// Callable only: caller supplies initialized I2C/controller/tracker and owns
// disjoint184/40/40-byte regions. No boot or hardware initialization implied.
@export("abla_s3_touch_gesture_test")
trusted fun touchGestureTarget(controller: u32,tracker: u32,snapshot: u32,
    frame: u32,now: u32,rotation: i32,goodix: bool): int =
    if (goodix) TouchTracker(int(tracker)).updateGt911(Gt911(int(controller)),
        nativeBufferAt(int(snapshot),40),nativeBufferAt(int(frame),40),
        int(now),320,240,int(rotation))
    else TouchTracker(int(tracker)).updateFt5x06(Ft5x06(int(controller)),
        nativeBufferAt(int(snapshot),29),nativeBufferAt(int(frame),40),
        int(now),320,240,int(rotation))
