import "../src/esp32/psram/boot80_arguments_s3.ab"
import "abla/build"

// Independent boundary oracle: vary one field of an otherwise valid request.
fun argumentCase(field: int,value: int): bool = s3PsramBoot80ArgumentsValid(
    if (field == 0) value else 0x3c000000,
    if (field == 1) value else 65536,
    if (field == 2) value else 67108864,
    if (field == 3) value else 80,
    if (field == 4) value else 0,
    if (field == 5) value else 0,
    if (field == 6) value else 0,
    if (field == 7) value else 1,
    if (field == 8) value else 32,
    if (field == 9) value else 32)

@export("abla_s3_psram_boot80_arguments_test")
fun argumentsTest(): int {
    var value=-1
    while (value <= 1025) {
        if (argumentCase(3,value) != (value == 20 || value == 40 || value == 80)) return 1
        if (argumentCase(4,value) != (value >= 0 && value <= 2)) return 2
        if (argumentCase(5,value) != (value >= 0 && value <= 255)) return 3
        if (argumentCase(6,value) != (value >= 0 && value <= 63)) return 4
        if (argumentCase(7,value) != (value >= 1 && value <= 1024)) return 5
        if (argumentCase(8,value) != (value == 32 || value == 64)) return 6
        if (argumentCase(9,value) != (value == 16 || value == 32 || value == 64)) return 7
        value=value+1
    }
    var page=0
    while (page < 512) {
        val address=0x3c000000+page*65536
        val bytes=(512-page)*65536
        // Every possible aligned start, exactly filling the virtual aperture.
        if (!s3PsramBoot80ArgumentsValid(address,bytes,67108864,20,2,255,63,1024,0,0)) return 8
        if (s3PsramBoot80ArgumentsValid(address,bytes+65536,67108864,20,2,255,63,1024,0,0)) return 9
        if (argumentCase(0,address+1) || argumentCase(1,page*65536+1)) return 10
        page=page+1
    }
    if (argumentCase(0,0x3bff0000) || argumentCase(0,0x3e000000) || argumentCase(0,0xffffffff)) return 11
    if (argumentCase(1,0) || argumentCase(1,65535) || argumentCase(1,33619968) || argumentCase(1,0xffffffff)) return 12
    if (argumentCase(2,65535) || argumentCase(2,67108865) || argumentCase(2,0xffffffff)) return 13
    if (!argumentCase(2,65536) || !argumentCase(2,67108864)) return 14
    if (s3PsramBoot80ArgumentsValid(0x3c000000,131072,65536,80,0,0,0,1,0,0)) return 15
    if (s3PsramBoot80ArgumentsValid(0x3c000000,65536,65536,80,0,0,0,1,0,32)) return 16
    return 0
}
