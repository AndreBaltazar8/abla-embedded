import "../src/esp32/i2c_esp32s3.ab"
import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_timer_target")
trusted fun timerTarget(handle: int,milliseconds: int,rx: bool): RtcTimerResult =
    if (rx) Rx8130(handle).setTimerInterruptChecked(milliseconds) else Pcf8563(handle).setTimerInterruptChecked(milliseconds)
