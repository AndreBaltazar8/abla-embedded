import "../src/esp32/power/retention_systimer_p4.ab"
trusted fun systimerRetentionChecks(c: NativeBuffer,out: NativeBuffer): int {
    var node=0
    while (node < 19) {
        val words=if (node == 2 || node == 6) 2 else if (node == 8) ((0x3c-0x1c)/4)+1 else if (node >= 17) 1 else 0
        val offset=if (node == 0 || node == 1) 4 else if (node == 2) 64 else if (node == 3) 92 else if (node == 4 || node == 5) 8 else if (node == 6) 72 else if (node == 7) 96 else if (node == 8) 28 else if (node == 9) 80 else if (node == 10) 84 else if (node == 11) 88 else if (node == 12 || node == 13) 52 else if (node == 14 || node == 15) 56 else if (node == 16) 60 else if (node == 17) 0 else 100
        var terminal=0
        while (terminal < 2) {
            var i=0;while (i < 52) { out.storeU32(i,0x12345678);i=i+4 }
            val next=if (terminal == 0) 0x30200000 else 0
            if (!esp32p4RetentionSystimerConfig(c,node,if (words == 0) 0 else 0x30100000,next) || !esp32p4RetentionDescriptorEncode(out,c)) return 40
            val backup=node == 0 || node == 1 || node == 4 || node == 5
            val wait=node == 1 || node == 5
            val head=(if (words != 0) words else (if (wait) 3<<16 else 2<<16)|(if (backup) 1<<29 else 1<<30))|(if (terminal == 1) 1<<31 else 0)
            if (out.loadU32(0) != head || out.loadU32(4) != next || out.loadU32(8) != 0x500e2000+offset || out.loadU32(20) != 0x12345678) return 41
            if (words != 0) {
                val restore=if (node == 2) 12 else if (node == 6) 20 else offset
                if (out.loadU32(12) != 0x500e2000+restore || out.loadU32(16) != 0x30100000) return 42
            } else {
                val mask=if (wait) 1<<29 else if (node == 0 || node == 4 || node >= 12) 1<<30 else 1
                val value=if (node == 12 || node == 14 || node == 16) 0 else mask
                if (out.loadU32(12) != value || out.loadU32(16) != mask) return 43
            }
            terminal=terminal+1
        }
        node=node+1
    }
    c.storeU32(0,0xabcdef12)
    if (esp32p4RetentionSystimerConfig(c,19,0,0) || esp32p4RetentionSystimerConfig(c,2,0,0) ||
        esp32p4RetentionSystimerConfig(c,8,0xfffffffc,0) || esp32p4RetentionSystimerConfig(c,0,0x30100000,0) || c.loadU32(0) != 0xabcdef12) return 44
    return 0
}
