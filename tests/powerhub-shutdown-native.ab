import "../src/power/powerhub_shutdown.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
var calls=0
var failAt=0
var bad=false
trusted fun I2cDevice.writeRegister(register: int,bytes: NativeBuffer,count: int): bool {
    calls=calls+1
    if (this != 7 || register != 0 || count != 6 || calls != 1) bad=true
    var i=0
    while (i < 6) { if (bytes.load(i) != 0) bad=true; i=i+1 }
    calls != failAt
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    if (this != 7 || register != 224 || value != 1 || calls != 2) bad=true
    calls != failAt
}
@export("abla_powerhub_shutdown_test")
trusted fun shutdownTest(): i32 {
    val bytes=nativeBufferAt(nativeStaticAllocate(8),8)
    while (failAt < 3) {
        calls=0; bad=false; bytes.storeU32(0,0xffffffff); bytes.storeU32(4,0xffffffff)
        val result=PowerHubPower(7).requestPowerOffWithBuffer(bytes)
        if (result.status() != (if (failAt == 0) 1 else failAt+2) ||
            result.controlsCleared() != (failAt != 1) || result.requestAcknowledged() != (failAt == 0) ||
            calls != (if (failAt == 1) 1 else 2) || bad || bytes.loadU16(6) != 65535) return i32(1)
        failAt=failAt+1
    }
    calls=0; bytes.storeU32(0,0xdeadbeef)
    var sample=0
    while (sample < 3) {
        val power=PowerHubPower(if (sample == 0) 0 else if (sample == 1) -1 else 4294967296)
        if (power.requestPowerOffWithBuffer(bytes).status() != 2 || power.requestPowerOff().status() != 2) return i32(2)
        sample=sample+1
    }
    if (PowerHubPower(7).requestPowerOffWithBuffer(nativeBufferAt(bytes.addressValue(),5)).status() != 2 ||
        PowerHubPower(7).requestPowerOffWithBuffer(nativeBufferAt(0,6)).status() != 2 ||
        calls != 0 || bytes.loadU32(0) != 0xdeadbeef) return i32(3)
    i32(0)
}
