import "../src/esp32/psram/cold_s3_sequence.ab"
import "abla/build"
val coldMemory=nativeStaticAllocate(192)
val coldRegisters=nativeStaticAllocate(65536)
val coldModes=nativeStaticAllocate(16)
var coldWrites=0
var coldFail=0
var coldReady=true
var coldBad=false
var coldDummy0=2
var coldDummy1=3
var coldWord=0
var coldCorrupt=false
fun s3PsramLowStorageSafe(address: int,length: int): bool = address >= coldMemory && address+length <= coldMemory+192
fun s3PsramCommandStorageSafe(address: int,length: int): bool = s3PsramLowStorageSafe(address,length)
fun s3FlashLegacyPointer(): int = 0x3fc90000
fun s3FlashDummyByteRead(address: int): int {
    if (address == 0x3fc90018) return coldDummy0
    if (address == 0x3fc90019) return coldDummy1
    coldBad=true;return 0
}
fun s3FlashDummyByteWrite(address: int,value: int): void {
    coldWrites=coldWrites+1
    val stored=if (coldWrites == coldFail) value^1 else value
    if (address == 0x3fc90018) coldDummy0=stored else if (address == 0x3fc90019) coldDummy1=stored else coldBad=true
    return
}
fun s3PsramCsRead(address: int): int {
    if (address == 0x60002000 || address == 0x60003000) return if (coldReady) 0 else 0x40000
    if (address < 0x60002000 || address > 0x60026064 || (address&3) != 0) { coldBad=true;return 0 }
    return nativeAddressLoadU32(coldRegisters,address&65535)
}
fun s3PsramCsWrite(address: int,value: int): void {
    if (address < 0x60002000 || address > 0x60026064 || (address&3) != 0) { coldBad=true;return }
    coldWrites=coldWrites+1
    nativeAddressStoreU32(coldRegisters,address&65535,if (coldWrites == coldFail) value^1 else value)
    return
}
fun s3PsramCommandReady(): bool = coldReady
fun s3PsramOpiDtrMode(): void { return }
fun s3PsramCommandConfigure(unit: int,descriptor: int): void { if (unit != 1 || descriptor != coldMemory+72) coldBad=true;return }
fun s3PsramCommandStart(rx: int,length: int): void {
    val work=nativeBufferAt(coldMemory+72,100);val modes=nativeBufferAt(coldModes,16)
    val command=work.loadU32(0)&65535;val address=work.loadU32(32)
    if ((work.loadU32(0)>>>16) != 16 || work.loadU32(8) != 32) coldBad=true
    if (command == 0x4040) {
        if (address > 8 || length != (if (address < 4) 2 else 1) || work.loadU32(28) != 8) coldBad=true
        var i=0
        while (i < length) { work.store(36+i,modes.load(address+i));i=i+1 }
    } else if (command == 0xc0c0) {
        if (address != 0 || work.loadU32(16) != 16 || work.loadU32(28) != 0) coldBad=true
        modes.store(0,work.load(36));modes.store(1,work.load(37))
    } else if (command == 0x8080) {
        if (address != 4096 || work.loadU32(16) != 32 || work.loadU32(28) != 8) coldBad=true
        coldWord=work.loadU32(36)
    } else if (command == 0) {
        if (address != 4096 || length != 4 || work.loadU32(28) != 18) coldBad=true
        work.storeU32(36,if (coldCorrupt) coldWord^1 else coldWord)
    } else coldBad=true
    coldWrites=coldWrites+1
    if (coldWrites == coldFail) coldReady=false
    return
}
fun coldReset(): void {
    nativeAddressStoreU32(coldMemory,0,0)
    var offset=0
    while (offset < 65536) { nativeAddressStoreU32(coldRegisters,offset,0xa55a5aa5);offset=offset+4 }
    val modes=nativeBufferAt(coldModes,16)
    modes.store(0,192);modes.store(1,13);modes.store(2,0x83);modes.store(3,0x60);modes.store(4,0x20);modes.store(8,3)
    coldWrites=0;coldReady=true;coldBad=false;coldDummy0=2;coldDummy1=3;coldWord=0;coldCorrupt=false
    return
}
@export("abla_s3_psram_cold_test")
fun testPsramCold(): int {
    val r=nativeBufferAt(coldMemory,64);val scratch=nativeBufferAt(coldMemory+64,8);val work=nativeBufferAt(coldMemory+72,100)
    var kind=0
    while (kind < 2) {
        val count=if (kind == 0) 40 else 36
        var failure=0
        while (failure <= count) {
            coldReset();coldFail=failure
            val result=s3PsramColdOwned(r,scratch,work,4096,kind == 1,5,true,true,true)
            if (result != (if (failure == 0) 1 else 4) || coldWrites != (if (failure == 0) count else failure) || coldBad) return 1
            if (failure != 0) {
                if (r.loadU32(4) >= 8 || r.loadU32(28) == 0) return 2
                coldReady=true;coldFail=0;coldWrites=0
                if (s3PsramColdOwned(r,scratch,work,8192,kind == 1,5,true,true,true) != 2 || coldWrites != 0) return 3
                if (s3PsramColdOwned(r,scratch,work,4096,kind == 1,5,true,true,true) != 1 || coldBad) return 4
            }
            val identity=s3PsramIdentityFrom(nativeBufferAt(coldMemory+32,6))
            if (r.loadU32(4) != 8 || r.loadU32(28) != 0 || !identity.good() || identity.physicalBytes() != 8388608 ||
                !identity.knownVendor() || coldWord != 0x5a6b7c8d || coldDummy0 != 2 || coldDummy1 != 3) return 5
            coldWrites=0
            if (s3PsramColdOwned(r,scratch,work,4096,kind == 1,5,true,true,true) != 1 || coldWrites != 0) return 6
            failure=failure+1
        }
        kind=kind+1
    }
    coldReset();coldFail=0;coldCorrupt=true
    if (s3PsramColdOwned(r,scratch,work,4096,false,5,true,true,true) != 5 || r.loadU32(4) != 6) return 7
    coldCorrupt=false
    if (s3PsramColdOwned(r,scratch,work,4096,false,5,true,true,true) != 1) return 8
    coldReset();nativeBufferAt(coldModes,16).store(2,3)
    if (s3PsramColdOwned(r,scratch,work,4096,false,5,true,true,true) != 6 || r.loadU32(4) != 7) return 9
    coldReset()
    if (s3PsramColdOwned(r,scratch,work,4096,false,5,false,true,true) != 2 ||
        s3PsramColdOwned(r,r,work,4096,false,5,true,true,true) != 2 || coldWrites != 0 || r.loadU32(0) != 0) return 10
    return 0
}
