import "../src/scheduler/ready_queue.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_ready_queue_target")
@section(".iram1.abla.readyQueueTarget")
trusted fun queueTarget(buffer: NativeBuffer,mode: int,id: int,previous: int): int {
    if (mode == 0) return if (readyQueueInitializeOwned(buffer)) 1 else 0
    if (mode == 1) return if (readyQueuePushOwned(buffer,id)) 1 else 0
    if (mode == 2) return readyQueuePeekOwned(buffer)
    if (readyQueueCommitOwned(buffer,id,previous)) 1 else 0
}
