import "./sleep-round-p4-native.ab"
import "./sleep-rendezvous-p4-native.ab"
import "../src/esp32/power/sleep_handoff_p4_sequence.ab"
@export("abla_sleep_handoff_p4_test")
fun handoffTest(): int {
    var scenario=0
    while (scenario < 38) {
        val hart=scenario&1;val mode=scenario/2;smpSeed();smpHart=u32(hart)
        peerIrq0=u32(0);peerIrq1=u32(0);peerBad=false
        val base=(rendezvousStorage+15)&(~15);val rv=nativeBufferAt(base,64)
        val payload=nativeBufferAt(base+64,848);val binding=nativeBufferAt(base+912,64)
        var i=0
        while (i < 976) { nativeBufferAt(base,976).storeU32(i,0);i=i+4 }
        val r=roundRecord();val rb=roundBase();i=0
        while (i < 2560) { nativeBufferAt(rb,2560).storeU32(i,0);i=i+4 }
        val c=nativeBufferAt(rb+2176,192);c.storeU32(0,300)
        binding.storeU32(0,0x50344249);binding.storeU32(4,5);binding.storeU32(16,1-hart)
        binding.storeU32(20,3);binding.storeU32(32,rendezvousTable);binding.storeU32(36,payload.addressValue())
        if (esp32p4SleepRendezvousOpenOwned(rv,nativeBufferAt(smpStorage,4),payload,binding,true) != 7 ||
            esp32p4SleepRendezvousContinueOwned(rv,2,true) != 7) return 1
        smpGeneration=rv.loadU32(28)
        if (esp32p4SleepRendezvousContinueOwned(rv,2,true) != 7 || esp32p4SleepRendezvousContinueOwned(rv,2,true) != 7) return 2
        smpHart=u32(1-hart)
        if (esp32p4SleepPeerAcknowledgeOwned(nativeBufferAt(smpStorage,4),smpGeneration,2,true) != 1 ||
            smpAct(1-hart,1).status() != 1 || smpAct(1-hart,2).status() != 1) return 3
        smpHart=u32(hart)
        if (esp32p4SleepRendezvousContinueOwned(rv,2,true) != 1) return 4
        var owner=r;var config=c;var graph=nativeBufferAt(rb+2368,64);var backing=nativeBufferAt(rb+2432,64)
        if (mode >= 1 && mode <= 16) {
            val target=(mode-1)%4;val address=if (target == 0) base else if (target == 1) base+64 else if (target == 2) base+912 else rendezvousTable
            val input=(mode-1)/4
            if (input == 0) owner=nativeBufferAt(address,2168)
            else if (input == 1) config=nativeBufferAt(address,192)
            else if (input == 2) graph=nativeBufferAt(address,64)
            else backing=nativeBufferAt(address,64)
        }
        if (mode == 17) c.storeU32(0,0)
        if (mode == 18) binding.storeU32(20,1)
        val result=esp32p4SleepRoundHandoffOwned(owner,rv,config,graph,backing,true)
        if (mode == 0) {
            if (result != 7 || rv.loadU32(4) != 13 || r.loadU32(40) != smpGeneration ||
                esp32p4SleepRoundHandoffOwned(owner,rv,config,graph,backing,true) != 4 ||
                esp32p4SleepRendezvousCancelOwned(rv,true) != 4) return 5
        } else {
            if (result != 9 || rv.loadU32(4) != 6 || r.loadU32(0) != 0) return 6
            var tick=0;var done=7
            while (tick < 16 && done != 10) {
                done=esp32p4SleepRendezvousContinueOwned(rv,2,true)
                val state=esp32p4SleepSmpObserve(nativeBufferAt(smpStorage,4),smpGeneration)
                if (state.stage() == 4 && state.phase(hart) == 4 && state.phase(1-hart) == 2) {
                    if (smpAct(1-hart,7).status() != 1 || smpAct(1-hart,8).status() != 1) return 7
                }
                if (state.stage() == 5 && smpAct(1-hart,10).status() != 1) return 8
                smpHart=u32(hart);tick=tick+1
            }
            if (done != 10 || (smpWord&u32(0xfff)) != u32(hart<<8) || peerBad) return 9
        }
        scenario=scenario+1
    }
    return 0
}
