import "../src/network/ip_text.ab"
import "abla/unsafe/memory"

trusted noescape extern:"c" fun mmap(
    address: i64*,
    length: int,
    protection: i32,
    flags: i32,
    fileDescriptor: i32,
    offset: int
): i64*

trusted noescape extern:"c" fun munmap(address: i64*, length: int): i32

trusted fun ip6TestWrite(address: u32, text: string): void {
    var index = 0
    while (index < text.size) {
        embeddedIpTextStoreByte(address + u32(index), u32(text[index]))
        index = index + 1
    }
    embeddedIpTextStoreByte(address + u32(text.size), u32(0))
    return
}

trusted fun ip6TestTextEquals(address: u32, expected: string): bool {
    var index = 0
    while (index < expected.size) {
        if (embeddedIpTextByte(address + u32(index)) != expected[index]) {
            return false
        }
        index = index + 1
    }
    return embeddedIpTextByte(address + u32(expected.size)) == 0
}

trusted fun ip6TestParseAndFormat(
    input: u32,
    address: u32,
    output: u32,
    source: string,
    expected: string
): bool {
    ip6TestWrite(input, source)
    if (embeddedIp6AddressFromText(input, address) != 1) return false
    if (embeddedIp6AddressToText(address, output, i32(64)) != output) return false
    return ip6TestTextEquals(output, expected)
}

@export("abla_ip6_text_probe")
trusted fun ip6TextProbe(input: u32, output: u32): i32 =
    embeddedIp6AddressFromText(input, output)

trusted fun main(): int {
    val allocation = mmap(
        nativeNullPointer(), 4096, i32(3), i32(98), i32(-1), 0
    )
    val nativeAddress = nativePointerAddress(allocation)
    if (nativeAddress <= 0 || nativeAddress > 4294967295) return 20
    val input = u32(nativeAddress)
    val address = input + u32(128)
    val output = input + u32(192)

    if (!ip6TestParseAndFormat(input, address, output, "::", "::")) return 1
    if (!ip6TestParseAndFormat(input, address, output, "::1", "::1")) return 2
    if (!ip6TestParseAndFormat(
        input, address, output, "2001:db8::1", "2001:DB8::1"
    )) return 3
    if (!ip6TestParseAndFormat(
        input, address, output,
        "2001:db8:1:2:3:4:5:6", "2001:DB8:1:2:3:4:5:6"
    )) return 4
    if (!ip6TestParseAndFormat(
        input, address, output,
        "::ffff:192.0.2.1", "::FFFF:192.0.2.1"
    )) return 5
    if (!ip6TestParseAndFormat(
        input, address, output,
        "0:0:1:0:0:0:2:3", "::1:0:0:0:2:3"
    )) return 6

    ip6TestWrite(input, "fe80::1%en0")
    if (embeddedIp6AddressFromText(input, address) != 1) return 7
    if (embeddedIpTextByte(address + u32(16)) != 0) return 8
    ip6TestWrite(input, ":::")
    if (embeddedIp6AddressFromText(input, address) != 0) return 9
    ip6TestWrite(input, "1:2:3:4:5:6:7:8:9")
    if (embeddedIp6AddressFromText(input, address) != 0) return 10
    ip6TestWrite(input, "g::")
    if (embeddedIp6AddressFromText(input, address) != 0) return 11
    ip6TestWrite(input, "2001:db8::1")
    if (embeddedIp6AddressFromText(input, u32(0)) != 1) return 12
    if (embeddedIp6AddressFromText(input, address) != 1) return 13
    if (embeddedIp6AddressToText(address, output, i32(4)) != u32(0)) return 14

    if (munmap(allocation, 4096) != i32(0)) return 21
    return 0
}
