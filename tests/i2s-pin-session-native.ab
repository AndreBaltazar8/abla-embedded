import "../src/esp32/i2s/pin_session_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this|0
fun Pin.valid(): bool = espChipS3().gpioValid(this)
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this)
val regs=nativeBufferAt(nativeStaticAllocate(24576),24576)
val original=nativeBufferAt(nativeStaticAllocate(24576),24576)
val record=nativeBufferAt(nativeStaticAllocate(48),48)
var writes=0
var drop=-1
var routes=0
var failRoute=-1
fun reset(): void {
    var n=0
    while (n < 24576) { regs.storeU32(n,0);n=n+4 }
    n=21
    while (n <= 32) { regs.storeU32(0x154+n*4,0xabcd0045);n=n+1 }
    n=0;while (n < 24576) { original.storeU32(n,regs.loadU32(n));n=n+4 }
    n=0;while (n < 48) { record.storeU32(n,0);n=n+4 }
    writes=0;drop=-1;routes=0;failRoute=-1;return
}
fun restored(): bool {
    var n=0
    while (n < 24576) { if (regs.loadU32(n) != original.loadU32(n)) return false;n=n+4 }
    return true
}
fun esp32S3PinStateRead(address: int): int = regs.loadU32(address-0x60004000)
fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes;writes=writes+1;if (step == drop) return
    if (address == 0x60004028 || address == 0x60004034) regs.storeU32(address-8-0x60004000,esp32S3PinStateRead(address-8)&~value)
    else if (address == 0x60004024 || address == 0x60004030) regs.storeU32(address-4-0x60004000,esp32S3PinStateRead(address-4)|value)
    else if (address == 0x60004008 || address == 0x60004014) regs.storeU32(address-4-0x60004000,esp32S3PinStateRead(address-4)|value)
    else if (address == 0x6000400c || address == 0x60004018) regs.storeU32(address-8-0x60004000,esp32S3PinStateRead(address-8)&~value)
    else regs.storeU32(address-0x60004000,value)
    return
}
fun Pin.routeOutputSignal(signal: int,inverted: bool = false): bool {
    val step=routes;routes=routes+1;if (step == failRoute) return false
    regs.storeU32(esp32S3GpioMuxAddress(this)-0x60004000,0x1000)
    regs.storeU32(0x554+this*4,signal|(if (inverted) 512 else 0))
    val offset=32+esp32S3GpioBankOffset(this)
    regs.storeU32(offset,regs.loadU32(offset)|(1<<(this&31)))
    return true
}
fun Pin.routeInputSignal(signal: int,inverted: bool = false): bool {
    val step=routes;routes=routes+1;if (step == failRoute) return false
    regs.storeU32(esp32S3GpioMuxAddress(this)-0x60004000,0x1200)
    regs.storeU32(0x154+signal*4,(regs.loadU32(0x154+signal*4)&~255)|128|(this|0)|(if (inverted) 64 else 0))
    return true
}
@export("abla_i2s_pin_session_test")
trusted fun test(): i32 {
    var variant=0
    while (variant < 256) {
        val port=(variant>>6)&1;val tx=(variant&128) != 0;val flags=variant&31
        val mclk=Pin(if ((variant&32) != 0) 0 else -1)
        var fault=-1
        while (fault < 4) {
            reset();failRoute=fault
            val valid=mclk != Pin(-1) || (flags&2) == 0
            val count=if (mclk == Pin(-1)) 3 else 4
            val expected=if (!valid) 0 else if (fault >= 0 && fault < count) 3 else 1
            if (esp32S3I2sPinsOpenOwned(record,port,tx,mclk,Pin(34),Pin(33),Pin(14),flags,true) != expected) return i32(1)
            if (valid) {
                if (esp32S3I2sPinsOpenOwned(record,port,tx,mclk,Pin(34),Pin(33),Pin(14),flags,true) != 0) return i32(2)
                if (esp32S3I2sPinsCloseOwned(record,true) != 2 || !restored()) return i32(3)
            } else if (routes != 0 || writes != 0) return i32(4)
            fault=fault+1
        }
        variant=variant+1
    }
    reset()
    if (esp32S3I2sPinsOpenOwned(record,1,false,Pin(0),Pin(34),Pin(33),Pin(14),3,true) != 1) return i32(5)
    writes=0
    if (esp32S3I2sPinsCloseOwned(record,true) != 2) return i32(6)
    val count=writes
    var fault=0
    while (fault < count) {
        reset()
        if (esp32S3I2sPinsOpenOwned(record,1,false,Pin(0),Pin(34),Pin(33),Pin(14),3,true) != 1) return i32(7)
        writes=0;drop=fault
        val result=esp32S3I2sPinsCloseOwned(record,true)
        if (result != 2 && result != 3) return i32(8)
        drop=-1
        if (esp32S3I2sPinsCloseOwned(record,true) != 2 || !restored()) return i32(9)
        fault=fault+1
    }
    reset()
    if (esp32S3I2sPinsOpenOwned(record,0,true,Pin(0),Pin(34),Pin(33),Pin(14),0,false) != 0 || routes != 0) return i32(10)
    return i32(0)
}
