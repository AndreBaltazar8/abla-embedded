import "./nesso-power-wire-native.ab"
import "../src/m5stack/nesso_power_controls.ab"
@export("abla_nesso_power_controls_wire_test")
trusted fun testControls(): i32 {
    wireSeed();chargeAddress=85;afterCommit=false;commands=0;delayTotal=0
    bad=false;dropClose=false;ticks=0
    val gpioRegs=nativeBufferAt(gpioMemory,4096);var at=0
    while (at < 4096) { gpioRegs.storeU32(at,0);at=at+4 }
    apb=u32(0);functional=u32(0x300000);gpioClock=u32(0)
    val regs=nativeBufferAt(registers,512);regs.store(1,1);regs.store(266,73)
    val gauge=nativeBufferAt(chargeRegisters,256);gauge.storeU16(8,3700);gauge.storeU16(20,65413)
    var session=esp32C6I2cSessionOpenOwned(10,8,40000000,20000000,true,5,8)
    val power=nessoPowerAt(nativeBufferAt(powerStorage,40))
    if (!session.ready() || !power.initialize() || power.openOwned(session.bus()|0,true) != 1 || bad) return i32(1)
    var sample=0
    while (sample < 256) {
        regs.store(15,sample);regs.store(264,sample)
        var fault=0
        while (fault <= 3) {
            var before=ackCount;nackAt=if (fault == 0) 0 else before+fault
            val buttons=power.pollButtonLevelsOwned(true)
            if (buttons.validMask() != (if (fault == 0) 3 else 0) || buttons.pressedMask() != (if (fault == 0) (~sample)&3 else 0) ||
                ackCount-before != (if (fault == 0) 3 else fault) || regs.load(15) != sample || bad) return i32(2)
            before=ackCount;nackAt=if (fault == 0) 0 else before+fault
            val charge=power.readChargingOwned(true);val state=(sample>>>3)&3
            if (charge.valid() != (fault == 0) || (charge.valid() && charge.value() != (state == 1 || state == 2)) ||
                ackCount-before != (if (fault == 0) 3 else fault) || regs.load(264) != sample || bad) return i32(3)
            fault=fault+1
        }
        sample=sample+1
    }
    nackAt=0
    if (!power.readBatteryMillivoltsOwned(true).valid() || power.readBatteryMillivoltsOwned(true).millivolts() != 3700 ||
        power.readBatteryLevelOwned(true).percent() != 50 || power.readBatteryMilliampsOwned(true).value() != -123) return i32(4)
    var operation=0
    while (operation < 3) {
        val limit=if (operation == 1) 3 else 6
        var commit=0
        while (commit < 2) {
            afterCommit=commit == 1
            var fault=0
            while (fault <= limit) {
                regs.store(257,255);regs.store(258,255);regs.store(260,255)
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                val result=if (operation == 0) power.setBatteryChargeOwned(true,true) else if (operation == 1) power.setChargeCurrentOwned(100,true) else power.setChargeVoltageOwned(4200,true)
                if (result.applied() != (fault == 0) || (result|0) != (if (fault == 0) 1 else 4) ||
                    ackCount-before != (if (fault == 0) limit else fault) || !power.ready() || bad) return i32(5)
                val changed=fault == 0 || (commit == 1 && fault == limit)
                if (regs.load(257) != (if (operation == 0 && changed) 247 else 255) ||
                    regs.load(258) != (if (operation == 1 && changed) 11 else 255) ||
                    regs.load(260) != (if (operation == 2 && changed) 232 else 255)) return i32(6)
                fault=fault+1
            }
            commit=commit+1
        }
        operation=operation+1
    }
    val before=ackCount
    if (power.pollButtonLevelsOwned(false).validMask() != 0 || power.readBatteryMillivoltsOwned(false).status() != 2 ||
        power.setChargeVoltageOwned(-1,true).applied() || power.setChargeCurrentOwned(65536,true).applied() || ackCount != before) return i32(7)
    nackAt=0
    if (!power.closeOwned(true) || power.pollButtonLevelsOwned(true).validMask() != 0 || power.readChargingOwned(true).status() != 2 ||
        power.setBatteryChargeOwned(false,true).applied() || ackCount != before) return i32(8)
    session=session.closeOwned(true)
    if (session != 0 || bad) return i32(9)
    return i32(0)
}
