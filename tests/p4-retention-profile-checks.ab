import "../src/esp32/power/retention_profile_p4.ab"
val profileConfigs=nativeStaticAllocate(76*56+4)
val profileBacking=nativeStaticAllocate(6000)
val profileScratch=nativeStaticAllocate(56)
val profileOutput=nativeStaticAllocate(2000)
trusted fun retentionProfileChecks(): int {
    val configs=nativeBufferAt(profileConfigs,76*56+4)
    val backing=nativeBufferAt(profileBacking,6000)
    val scratch=nativeBufferAt(profileScratch,56)
    val out=nativeBufferAt(profileOutput,2000)
    var uart=-1
    while (uart < 5) {
        var flags=0
        while (flags < 4) {
            val psram=(flags&1) != 0;val pvt=(flags&2) != 0
            var w=0
            while (w < 76*56+4) { configs.storeU32(w,0x12345678);w=w+4 }
            w=0
            while (w < 6000) { backing.storeU32(w,0x87654321);w=w+4 }
            val count=58+(if (uart >= 0) 3 else 0)+(if (psram) 14 else 0)+(if (pvt) 1 else 0)
            if (esp32p4RetentionProfileConfigs(configs,backing,scratch,uart,psram,pvt) != count || configs.loadU32(count*56) != 0x12345678) return 80
            // Independent batch inventory in execution order; within the
            // interrupt-matrix batch CPU0 must precede CPU1, not reverse.
            var batch=0
            var index=0
            var used=0
            while (batch < 11) {
                val nodes=if (batch == 0) 9 else if (batch == 1) (if (uart >= 0) 3 else 0) else if (batch == 2) 12 else if (batch == 4) 2 else if (batch == 5) (if (pvt) 1 else 0) else if (batch == 7) 19 else if (batch == 8) (if (psram) 14 else 0) else if (batch == 9) 8 else if (batch == 10) 6 else 1
                var n=0
                while (n < nodes) {
                    val key=if (batch == 0) n else if (batch == 1) 256+n else if (batch == 2) 512+n else if (batch == 3) 770 else if (batch == 4) 768+n else if (batch == 5) 772 else if (batch == 6) 771 else if (batch == 7) 1024+n else if (batch == 8) 1280+n else if (batch == 9) 1536+n else 1792+n
                    if (p4RetentionProfileNode(uart,psram,pvt,index) != key) return 81
                    val c=nativeBufferAt(profileConfigs+index*56,56)
                    val words=c.loadU32(0)&1023
                    if (c.loadU32(4) != 0 || (c.loadU32(0)&0x80000000) == 0 || c.loadU32(28) != (if (words == 0) 0 else profileBacking+used)) return 82
                    if (esp32p4RetentionProfileEntries(uart,psram,pvt,index,300) != (if (batch == 9) 9 else 1) ||
                        esp32p4RetentionProfileEntries(uart,psram,pvt,index,301) != 1 ||
                        esp32p4RetentionProfileEntries(uart,psram,pvt,index,0) != 1) return 83
                    used=used+words*4;index=index+1;n=n+1
                }
                batch=batch+1
            }
            if (index != count || used != (1080+(if (uart >= 0) 22 else 0)+(if (psram) 71 else 0)+(if (pvt) 115 else 0))*4) return 84
            w=0
            while (w < 6000) { if (backing.loadU32(w) != 0x87654321) return 85;w=w+4 }
            if (esp32p4RetentionListEncode(out,configs,scratch,count) != count*20+64+(if (uart >= 0) 16 else 0)+240+(if (uart >= 0) 40 else 0)) return 86
            if (esp32p4RetentionProfileConfigs(configs,nativeBufferAt(profileBacking,used-1),scratch,uart,psram,pvt) != 0 ||
                esp32p4RetentionProfileEntries(uart,psram,pvt,count,300) != 0 || p4RetentionProfileNode(uart,psram,pvt,-1) != -1) return 87
            flags=flags+1
        }
        uart=uart+1
    }
    var w=0
    while (w < 76*56+4) { configs.storeU32(w,0x12345678);w=w+4 }
    if (esp32p4RetentionProfileConfigs(configs,backing,scratch,5,true,true) != 0 ||
        esp32p4RetentionProfileConfigs(configs,backing,scratch,-2,true,true) != 0 ||
        esp32p4RetentionProfileConfigs(nativeBufferAt(profileConfigs,76*56-1),backing,scratch,0,true,true) != 0 ||
        esp32p4RetentionProfileConfigs(configs,nativeBufferAt(profileConfigs,6000),scratch,0,true,true) != 0 ||
        esp32p4RetentionProfileConfigs(configs,backing,nativeBufferAt(profileConfigs,56),0,true,true) != 0 ||
        esp32p4RetentionProfileConfigs(configs,backing,nativeBufferAt(profileBacking,56),0,true,true) != 0) return 88
    w=0
    while (w < 76*56+4) { if (configs.loadU32(w) != 0x12345678) return 89;w=w+4 }
    return 0
}
