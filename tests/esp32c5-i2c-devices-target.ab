import "../src/esp32/i2c/devices_c5_sequence.ab"
import "../src/esp32/i2c/bus_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_i2c_devices_target")
trusted fun devicesTarget(state: Esp32C5I2cBusState,pool: I2cDeviceSlots,epoch: int,owner: u32,address: int,frequency: int,closeHandle: int): int =
    if (closeHandle != 0) (if (state.closeDeviceOwned(pool,owner,closeHandle)) 1 else 0) else state.deviceOwned(pool,epoch,owner,address,frequency)
