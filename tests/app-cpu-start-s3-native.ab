import "../src/esp32/app_cpu_start_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var options=0
var stall=0
var control=0
var writes=0
var published=0
var core=0
var bad=false
var initiallyEnabled=false
fun esp32S3AppCpuRead(address: int): int {
    if (address == 0x60008000) return options
    if (address == 0x600080BC) return stall
    if (address == 0x600C0000) return control
    bad=true; return 0
}
fun esp32S3AppCpuWrite(address: int,value: int): void {
    if (writes == 0) { if (address != 0x60008000 || value != (options & ~3)) bad=true; options=value }
    else if (writes == 1) { if (address != 0x600080BC || value != (stall & ~0x03F00000)) bad=true; stall=value }
    else {
        val expected=if (writes == 2) control | 2 else if (writes == 3) control & ~1 else if (writes == 4) control | 4 else control & ~4
        if (address != 0x600C0000 || value != expected || initiallyEnabled) bad=true
        control=value
    }
    writes=writes+1; return
}
fun esp32S3AppCpuCurrentCore(): int = core
fun esp32S3AppCpuPublishEntry(entry: int): void {
    if (entry != 0x40378000 || writes != (if (initiallyEnabled) 2 else 6)) bad=true
    published=published+1; return
}
@export("abla_app_cpu_start_test")
trusted fun appCpuTest(): i32 {
    var p=0
    while (p < 64) {
        initiallyEnabled=(p & 1) != 0
        val initial=0xFFFFFFFF ^ (1<<(p/2))
        control=(initial & ~2) | (if (initiallyEnabled) 2 else 0)
        val saved=control
        options=initial; stall=initial; writes=0; published=0; bad=false
        if (!esp32S3AppCpuReleaseRomOwned(0x40378000,2) || bad || published != 1) return i32(1)
        if (initiallyEnabled && control != saved) return i32(2)
        if (!initiallyEnabled && control != ((saved | 2) & ~5)) return i32(3)
        p=p+1
    }
    writes=0; published=0; core=1
    if (esp32S3AppCpuReleaseRomOwned(0x40378000,2)) return i32(4)
    core=0
    if (esp32S3AppCpuReleaseRomOwned(0x40378000,1) || esp32S3AppCpuReleaseRomOwned(0x40378001,2) || esp32S3AppCpuReleaseRomOwned(0x42000000,2) || writes != 0 || published != 0) return i32(5)
    i32(0)
}
