import "../src/m5stack/detect_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var captured=0
var restored=0
var captureFail=-1
var restoreFail=0
var configFail=-1
var configurations=0
var stopFail=-1
var stops=0
var reads=0
var pattern=50
var camera=false
var ackMask=0
var addressAck=-1
var addresses=0
var bad=false
val ownedRegs=nativeBufferAt(nativeStaticAllocate(24576),24576)
val ownedRecord=nativeBufferAt(nativeStaticAllocate(88),88)
var ownedWrites=0
var ownedDrop=-1
trusted fun esp32S3PinStateRead(address: int): int = ownedRegs.loadU32(address-0x60004000)
trusted fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=ownedWrites; ownedWrites=ownedWrites+1
    if (step == ownedDrop) return
    if (address == 0x60004028 || address == 0x60004034) ownedRegs.storeU32(address-8-0x60004000,esp32S3PinStateRead(address-8)&~value)
    else if (address == 0x60004024 || address == 0x60004030) ownedRegs.storeU32(address-4-0x60004000,esp32S3PinStateRead(address-4)|value)
    else if (address == 0x60004008 || address == 0x60004014) ownedRegs.storeU32(address-4-0x60004000,esp32S3PinStateRead(address-4)|value)
    else if (address == 0x6000400c || address == 0x60004018) ownedRegs.storeU32(address-8-0x60004000,esp32S3PinStateRead(address-8)&~value)
    else ownedRegs.storeU32(address-0x60004000,value)
    return
}
fun resetOwned(): void {
    reset(); ownedWrites=0; ownedDrop=-1
    var offset=0
    while (offset < 24576) { ownedRegs.storeU32(offset,0); offset=offset+4 }
    offset=0
    while (offset < 88) { ownedRecord.storeU32(offset,0); offset=offset+4 }
    return
}
fun reset(): void {
    captured=0; restored=0; captureFail=-1; restoreFail=0; configFail=-1; configurations=0; stopFail=-1; stops=0; reads=0; pattern=50; camera=false; ackMask=0; addressAck=-1; addresses=0; bad=false; return
}
fun gpioProbeCaptureEsp32S3(pin: int): GpioProbePinState {
    captured=captured|(1<<pin)
    GpioProbePinState(if (pin == captureFail) 0 else (pin<<10)|1)
}
fun GpioProbePinState.restore(pin: int): bool {
    if ((this>>10) != pin || !gpioProbeStateValid(this)) bad=true
    restored=restored|(1<<pin)
    (restoreFail&(1<<pin)) == 0
}
fun configure(): bool { val n=configurations; configurations=configurations+1; n != configFail }
fun gpioProbeInput(pin: int,pull: int): bool = configure()
fun gpio_set_level(pin: i32,value: u32): i32 = i32(if (configure()) 0 else 258)
fun gpio_set_direction(pin: i32,value: i32): i32 = i32(if (configure()) 0 else 258)
fun gpioProbeEsp32S3FastHigh(pin: int): bool = configure()
fun gpioProbeEsp32S3FastLow(pin: int): bool = configure()
fun gpioProbeEsp32S3ClockCycles(pin: int,cycles: int): void { if (pin != 21 || cycles <= 0) bad=true; return }
fun gpioProbeRead(pin: int): bool {
    val n=reads; reads=reads+1
    if (camera) return (ackMask&(1<<n)) == 0
    if (n > 5) { bad=true; return false }
    (pattern&(1<<(5-n))) != 0
}
fun gpioProbeDelayMicroseconds(us: int): void { if (us != 1000 && us != 50000) bad=true; return }
fun gpioProbeI2cStop(sda: int,scl: int): bool { val n=stops; stops=stops+1; n != stopFail }
fun gpioProbeI2cAddressChecked(sda: int,scl: int,address: int): int { addresses=addresses+1; if (addressAck == -2) -1 else if (address == addressAck) 1 else 0 }
@export("abla_detect_s3_cleanup_test")
fun test(): i32 {
    val mainMask=(1<<4)|(1<<8)|(1<<10)|(1<<12)|(1<<38)
    val capsuleMask=(1<<13)|(1<<15)
    var index=-1
    while (index < 7) {
        reset()
        val pin=if (index == 0) 4 else if (index == 1) 8 else if (index == 2) 10 else if (index == 3) 12 else if (index == 4) 38 else if (index == 5) 13 else 15
        if (index >= 0) restoreFail=1<<pin
        val result=m5DetectEsp32S3Qfn56Hardware()
        if (bad || result != (if (index < 0) m5BoardCapsule else m5BoardUnknown) || restored != (if (index >= 0 && index < 5) mainMask else mainMask|capsuleMask)) return i32(1)
        reset(); captureFail=pin
        if (m5DetectEsp32S3Qfn56Hardware() != m5BoardUnknown || restored != (if (index >= 0 && index < 5) 0 else mainMask)) return i32(2)
        index=index+1
    }
    index=0
    while (index < 9) {
        reset(); configFail=index
        if (m5DetectEsp32S3Qfn56Hardware() != m5BoardUnknown || restored != mainMask || addresses != 0 || bad) return i32(3)
        index=index+1
    }
    index=-1
    while (index < 4) {
        reset(); addressAck=104
        if (index < 2) stopFail=index
        else restoreFail=1<<(if (index == 2) 45 else 0)
        val result=m5ProbeI2cEsp32S3(45,0,104,105)
        if (result != (if (index == -1) 1 else -2) || restored != ((1<<45)|1) || bad) return i32(4)
        index=index+1
    }
    reset(); restoreFail=1<<45; addressAck=104
    if (m5DetectEsp32S3PicoHardware() != m5BoardUnknown || (captured&((1<<48)|(1<<47))) != 0) return i32(5)
    reset(); addressAck=-2
    if (m5DetectEsp32S3PicoHardware() != m5BoardUnknown || addresses != 1 || restored != ((1<<45)|1)) return i32(11)
    val cameraMask=(1<<9)|(1<<12)|(1<<18)|(1<<21)
    var ack=0
    var cameraConfigurations=0
    while (ack < 4) {
        reset(); camera=true; ackMask=ack
        if (m5ProbeEsp32S3CameraChecked() != (if (ack == 1 || ack == 2) 1 else 0) || restored != cameraMask || bad) return i32(6)
        cameraConfigurations=configurations
        ack=ack+1
    }
    index=0
    while (index < cameraConfigurations) {
        reset(); camera=true; ackMask=1; configFail=index
        val result=m5ProbeEsp32S3CameraChecked()
        if (result != -1 || restored != cameraMask || bad) return i32(7)
        index=index+1
    }
    reset(); camera=true; ackMask=1; restoreFail=cameraMask
    if (m5ProbeEsp32S3CameraChecked() != -1 || restored != cameraMask) return i32(8)
    index=0
    while (index < 4) {
        val pin=if (index == 0) 9 else if (index == 1) 12 else if (index == 2) 18 else 21
        reset(); camera=true; captureFail=pin
        if (m5ProbeEsp32S3CameraChecked() != -1 || restored != 0 || configurations != 0) return i32(9)
        reset(); camera=true; ackMask=1; restoreFail=1<<pin
        if (m5ProbeEsp32S3CameraChecked() != -1 || restored != cameraMask || bad) return i32(10)
        index=index+1
    }
    var signature=0
    while (signature < 64) {
        resetOwned(); pattern=signature
        val status=m5S3OwnedDetectBegin(ownedRecord,m5BoardUnknown,0,true)
        if (status != 2 && status != 4) return i32(12)
        if (m5S3OwnedDetectResult(ownedRecord) != m5DetectEsp32S3Qfn56(m5BoardUnknown,signature,false)) return i32(13)
        signature=signature+1
    }
    resetOwned(); pattern=50
    if (m5S3OwnedDetectBegin(ownedRecord,m5BoardUnknown,0,true) != 2) return i32(14)
    val count=ownedWrites
    index=0
    while (index < count) {
        resetOwned(); pattern=50; ownedDrop=index
        val status=m5S3OwnedDetectBegin(ownedRecord,m5BoardUnknown,0,true)
        if (status == 3) {
            if (m5S3OwnedDetectResult(ownedRecord) != m5BoardUnknown || m5S3OwnedDetectBegin(ownedRecord,m5BoardUnknown,0,true) != 0) return i32(15)
            ownedDrop=-1
            val closed=m5S3OwnedDetectCleanup(ownedRecord,true)
            if (closed != 2 && closed != 4) return i32(16)
        } else if (status != 2 && status != 4) return i32(17)
        var offset=0
        while (offset < 24576) {
            if (ownedRegs.loadU32(offset) != 0) return i32(18)
            offset=offset+4
        }
        index=index+1
    }
    resetOwned(); addressAck=24
    if (m5S3OwnedDetectBegin(ownedRecord,m5BoardUnknown,1,true) != 2 || ownedRecord.loadU32(12) != 2) return i32(19)
    resetOwned(); addressAck=104; camera=true; ackMask=1
    if (m5S3OwnedDetectBegin(ownedRecord,m5BoardUnknown,1,true) != 2 || ownedRecord.loadU32(12) != 6 || m5S3OwnedDetectResult(ownedRecord) != m5BoardAtomS3RCam) return i32(22)
    resetOwned()
    if (m5S3OwnedDetectBegin(ownedRecord,m5BoardUnknown,0,false) != 0 || ownedWrites != 0 || captured != 0) return i32(20)
    if (m5S3OwnedDetectBegin(ownedRecord,m5BoardCapsule,0,false) != 2 || ownedWrites != 0 || captured != 0) return i32(21)
    i32(0)
}
