import "../src/esp32/psram/startup_admission_s3.ab"
import "abla/build"
@export("abla_s3_startup_admission_test")
fun admissionTest(): int {
    var profile=0
    while (profile < 4096) {
        val fault=profile&15;val variant=profile>>>4
        val core=if ((fault&1) == 0) 0 else 1
        val status=if ((fault&2) == 0) 0x4002f else if ((variant&1) == 0) 0x4002e else 0x4003f
        val enabled=if ((fault&2) != 0 && (variant&3) == 3) 1 else 0
        var sysclk=0xa5a50000|1024|(variant&1023)
        var cpu=0xa5a50000|4|(variant%3)
        var power=0xa5a50000
        if ((fault&4) != 0) {
            val kind=variant%6
            if (kind == 0) sysclk=sysclk&0xfffff3ff
            else if (kind == 1) cpu=cpu&0xfffffffb
            else if (kind == 2) cpu=cpu|3
            else power=power|(if (kind == 3) 64 else if (kind == 4) 256 else 1024)
        }
        val peer=0xa5a50000|(variant&3)|(if ((fault&8) == 0) 4 else 0)
        if (s3PsramStartupMismatch(core,status,enabled,sysclk,cpu,power,peer) != fault) return 1
        profile=profile+1
    }
    // A software stall alone is not a cold-start reset guarantee.
    if (s3PsramStartupMismatch(0,0x4002f,0,1024,4,0,1) != 8 ||
        s3PsramStartupMismatch(0,0x4002f,1,1024,4,0,4) != 2) return 2
    return 0
}
