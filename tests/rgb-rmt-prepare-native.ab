import "../src/esp32/rgb_rmt_prepare_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.outputCapable(): bool = this == 7
var stage = 0
var failAt = 0
var bad = false
trusted fun nextStage(expected: int, owner: u32): bool {
    if (owner != u32(41) || stage != expected - 1) bad = true
    stage = expected
    stage != failAt
}
trusted fun esp32s3RmtEnableBusClock(owner: u32): bool = nextStage(1, owner)
trusted fun esp32s3GdmaEnableClock(owner: u32): bool = nextStage(2, owner)
trusted fun esp32s3GdmaParked(channel: int, tx: bool): bool {
    if (channel != 2 || !tx) bad = true
    nextStage(3, u32(41))
}
trusted fun esp32s3RmtSetGroupClockOwned(active: bool, owner: u32): bool = nextStage(if (active) 9 else 4, owner)
trusted fun esp32s3RmtConfigureClock(source: int, integer: int, numerator: int, denominator: int, owner: u32): bool {
    if (source != 1 || integer != 1 || numerator != 0 || denominator != 0) bad = true
    nextStage(5, owner)
}
trusted fun esp32s3RmtPrepareMemory(owner: u32): bool = nextStage(6, owner)
trusted fun esp32s3RmtConfigureSingleBlockTxOwned(channel: int, divider: int): bool {
    if (channel != 3 || divider != 8) bad = true
    nextStage(7, u32(41))
}
trusted fun Pin.routeOutputSignal(signal: int, inverted: bool): bool {
    if (this != 7 || signal != 84 || inverted) bad = true
    nextStage(8, u32(41))
}
trusted fun prepareTest(): int {
    while (failAt <= 9) {
        stage = 0
        val result = esp32s3RmtPrepareRgbDmaOwned(Pin(7), 2, u32(41))
        if (result != (if (failAt == 0) 1 else failAt + 2) ||
            stage != (if (failAt == 0) 9 else failAt) || bad) return 1
        failAt = failAt + 1
    }
    stage = 0
    if (esp32s3RmtPrepareRgbDmaOwned(Pin(6), 2, u32(41)) != 2 ||
        esp32s3RmtPrepareRgbDmaOwned(Pin(7), -1, u32(41)) != 2 ||
        esp32s3RmtPrepareRgbDmaOwned(Pin(7), 5, u32(41)) != 2 ||
        esp32s3RmtPrepareRgbDmaOwned(Pin(7), 2, u32(0)) != 2 || stage != 0) return 2
    0
}
#exportFunction("prepareTest", "abla_rmt_prepare_test")
