import "../src/m5stack/c6_power_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var failure=0
var bad=false
fun c6PowerWrite(handle: int,register: int,value: int): bool {
    val step=calls
    val r=if (step == 0) 3 else if (step == 1) 5 else if (step == 2) 7 else if (step == 3) 13 else if (step == 4) 11 else if (step == 5) 9 else 17
    val v=if (step == 0) 224 else if (step == 1) 128 else if (step == 2) 28 else if (step == 3 || step == 4) 195 else if (step == 5) 3 else 252
    if (handle != 8 || step >= 7 || register != r || value != v) bad=true
    calls=calls+1; calls != failure
}
fun c6PowerChargeEnable(handle: int): bool { if (handle != 9 || calls != 7) bad=true; calls=calls+1; calls != failure }
fun c6PowerChargeCurrent(handle: int): bool { if (handle != 9 || calls != 8) bad=true; calls=calls+1; calls != failure }
fun c6PowerChargeVoltage(handle: int): bool { if (handle != 9 || calls != 9) bad=true; calls=calls+1; calls != failure }
fun c6PowerGaugeBegin(handle: int): bool { if (handle != 10 || calls != 10) bad=true; calls=calls+1; calls != failure }
@export("abla_c6_power_test")
fun powerTest(): i32 {
    var profile=0
    while (profile < 24) {
        failure=profile%12
        val nesso=profile >= 12
        val board=if (nesso) m5BoardArduinoNessoN1 else m5BoardUnitC6L
        val total=if (nesso) 11 else 7
        calls=0; bad=false
        val result=board.configureC6PowerOwned(8,if (nesso) 9 else 0,if (nesso) 10 else 0)
        val failed=failure > 0 && failure <= total
        val expected=if (!failed) 1 else if (failure <= 7) 4 else failure-3
        if (result.status() != expected || result.appliedSteps() != (if (failed) failure-1 else total) ||
            calls != (if (failed) failure else total) || bad) return i32(1)
        profile=profile+1
    }
    calls=0
    if (m5BoardArduinoNessoN1.configureC6PowerOwned(8,0,10).status() != 3 ||
        m5BoardArduinoNessoN1.configureC6PowerOwned(8,9,0).status() != 3 ||
        m5BoardUnitC6L.configureC6PowerOwned(4294967296,0,0).status() != 3 ||
        m5BoardAtomVoice.configureC6PowerOwned(8,9,10).status() != 2 || calls != 0) return i32(2)
    i32(0)
}
