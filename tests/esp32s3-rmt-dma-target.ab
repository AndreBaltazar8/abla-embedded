import "../src/esp32/rmt_dma_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Compile fixture only: caller must initialize/own RMT group,channel3,pad.
trusted fun rmtDmaTarget(owner: u32, dma: u32, descriptors: u32, source: u32, bytes: u32): int {
    if (!esp32s3GdmaEnableClock(owner)) return -1
    esp32s3RmtTransmitDmaOwned(int(dma), 8, int(descriptors),
        nativeBufferAt(int(source), int(bytes)), int(bytes), 100000)
}
#exportFunction("rmtDmaTarget", "abla_s3_rmt_dma_test")
