import "./pwm-session-c6-native.ab"
import "../src/m5stack/tone_c6_sequence.ab"
val toneMemory=nativeStaticAllocate(112)
@export("abla_tone_c6_test")
trusted fun testTone(): int {
    val r=nativeBufferAt(toneMemory,112)
    var scenario=0
    while (scenario < 96) {
        channel=scenario%6;timer=(scenario/6)%4;txPin=11
        writes=0;drop=0;fault=0;bad=false;stallTimer=false;stallDuty=false
        clockTicks=0;writeReady=0;readReady=0
        var at=0
        while (at < 4096) { nativeAddressStoreU32(memory,at,0);at=at+4 }
        at=0
        while (at < 2048) { nativeAddressStoreU32(peripheral,at,0);at=at+4 }
        at=0
        while (at < 4) { nativeAddressStoreU32(peripheral,160+at*8,0x1000000);at=at+1 }
        nativeAddressStoreU32(memory,addressOffset(0x60091554+11*4),640)
        nativeAddressStoreU32(recordMemory,8,5)
        bus=0;functional=0x100000;r.storeU32(0,0)
        val failure=scenario/24
        fault=if (failure == 1) 1 else 0
        stallTimer=failure == 2;stallDuty=failure == 3
        val now=if (scenario%2 == 0) 100 else 0xfffffff0
        val board=if (scenario%2 == 0) m5BoardArduinoNessoN1 else m5BoardUnitC6L
        if (board.startC6ToneOwned(r,1,80000000,1000,timer,channel,now,0,3,true) != 2 ||
            board.startC6ToneOwned(r,1,80000000,1000,timer,channel,now,32,3,false) != 2 || writes != 0 || r.loadU32(0) != 0) return 1
        val result=board.startC6ToneOwned(r,1,80000000,1000,timer,channel,now,32,3,true)
        if (result != (if (failure == 0) 1 else 3) || bad) return 2
        val startedWrites=writes;val original=r.loadU32(12)
        if (board.startC6ToneOwned(r,1,80000000,1000,timer,channel,now,32,3,true) != 2 ||
            c6ToneStopOwned(r,3,false) != 2 || writes != startedWrites) return 3
        if (failure == 0) {
            if (c6TonePollOwned(r,int(u32(now)+u32(31)),3,true) != 6 || writes != startedWrites) return 4
            drop=writes+1
            val closed=c6TonePollOwned(r,int(u32(now)+u32(32)),3,true)
            if (closed != 4 && closed != 5) return 5
        } else {
            if (c6TonePollOwned(r,int(u32(now)+u32(32)),3,true) != 3 || writes != startedWrites) return 6
            if (failure >= 2 && c6ToneStopOwned(r,3,true) != 4) return 7
        }
        fault=0;drop=0;stallTimer=false;stallDuty=false
        // Model actual pending hardware completion, not a driver bypass.
        nativeAddressStoreU32(peripheral,160+timer*8,nativeAddressLoadU32(peripheral,160+timer*8)&~0x4000000)
        nativeAddressStoreU32(peripheral,channel*20,nativeAddressLoadU32(peripheral,channel*20)&~16)
        nativeAddressStoreU32(peripheral,channel*20+12,0)
        if (c6ToneStopOwned(r,3,true) != 5 || bad || bus != 0 || functional != 0x100000 ||
            c6GpioRead(0x60091020) != u32(0) || r.loadU32(12) != original) return 8
        val finalWrites=writes
        if (c6ToneStopOwned(r,3,true) != 5 || c6TonePollOwned(r,0,3,true) != 5 || writes != finalWrites) return 9
        scenario=scenario+1
    }
    return 0
}
