import "../src/esp32/power/sleep_regulator_p4_sequence.ab"
import "abla/unsafe/native"
var regs=NativeBuffer(0)
var writes=0
var fail=0
var bad=false
fun slot(offset: int): int = if (offset == 144) 0 else if (offset == 148) 4 else if (offset == 156) 8 else
    if (offset == 160) 12 else if (offset == 180) 16 else if (offset == 184) 20 else -1
trusted fun p4SleepRegulatorRead(offset: int): u32 {
    val i=slot(offset);if (i < 0) { bad=true;return u32(0) };return u32(regs.loadU32(i))
}
trusted fun p4SleepRegulatorWrite(offset: int,value: u32): void {
    val i=slot(offset);if (i < 0) { bad=true;return }
    writes=writes+1;if (writes != fail) regs.storeU32(i,int(value));return
}
trusted fun seed(r: NativeBuffer,c: NativeBuffer): void {
    var i=0
    while (i < 24) { regs.storeU32(i,0xffffffff);c.storeU32(i,0);i=i+4 }
    i=0
    while (i < 44) { r.storeU32(i,0);i=i+4 }
    r.storeU32(44,0x12345678);writes=0;fail=0;bad=false;return
}
@export("abla_sleep_regulator_p4_test")
trusted fun test(): i32 {
    regs=nativeBufferAt(nativeStaticAllocate(24),24)
    val c=nativeBufferAt(nativeStaticAllocate(24),24)
    val r=nativeBufferAt(nativeStaticAllocate(48),48)
    var revision=0
    while (revision <= 300) {
        var phase=0
        while (phase < 2) {
            var fault=0
            while (fault <= 6) {
                seed(r,c);if (phase == 0) fail=fault
                val opened=esp32p4SleepRegulatorOpenOwned(r,c,revision,true)
                if ((phase == 1 || fault == 0) && opened != 1) return i32(1)
                if (phase == 0 && fault != 0 && (opened != 3 || r.loadU32(8) != fault)) return i32(2)
                if (opened == 1 && (regs.loadU32(0) != (if (revision < 100) 0x0078ffff else 0xffff) ||
                    regs.loadU32(4) != 0x3ffffff || regs.loadU32(8) != 0x1fffff || regs.loadU32(12) != 0x3ffffff ||
                    regs.loadU32(16) != 0x1fffff || regs.loadU32(20) != 0x3ffffff)) return i32(3)
                val primary=r.loadU32(8);writes=0;fail=if (phase == 1) fault else 0
                val closed=esp32p4SleepRegulatorCloseOwned(r,true)
                if (phase == 1 && fault != 0 && (closed != 3 || r.loadU32(12) != 7-fault)) return i32(4)
                fail=0
                if (esp32p4SleepRegulatorCloseOwned(r,true) != 4 || r.loadU32(8) != primary || r.loadU32(44) != 0x12345678 || bad) return i32(5)
                var i=0
                while (i < 24) { if (regs.loadU32(i) != 0xffffffff) return i32(6);i=i+4 }
                fault=fault+1
            }
            phase=phase+1
        }
        seed(r,c);c.storeU32(0,0x00400000)
        val result=esp32p4SleepRegulatorOpenOwned(r,c,revision,true)
        if (revision < 100) { if (result != 2 || writes != 0) return i32(7) }
        else if (result != 1 || regs.loadU32(0) != 0x0040ffff) return i32(8)
        seed(r,c);c.storeU32(0,0x00080000)
        if (esp32p4SleepRegulatorOpenOwned(r,c,revision,true) != 2 || writes != 0) return i32(9)
        revision=if (revision == 0) 99 else if (revision == 99) 100 else if (revision == 100) 300 else 400
    }
    seed(r,c)
    if (esp32p4SleepRegulatorOpenOwned(r,nativeBufferAt(r.addressValue()+4,24),300,true) != 2 || writes != 0) return i32(10)
    return i32(0)
}
