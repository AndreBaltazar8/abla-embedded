import "../src/spi/software_command.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 5
fun Pin.outputCapable(): bool = this.valid()
val storage = nativeStaticMutableU32s([0, 0])
var bits = 0
var totalBits = 24
var mode = 0
var selected = false
var dataMode = true
var dataHigh = false
var bad = false
var activity = 0
trusted fun Pin.write(high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(storage, 0) != 7) bad = true
    if (this == 2) dataHigh = high
    if (this == 5) dataMode = high
    if (this == 4) {
        if (!high && (selected || bits != 0 || dataMode)) bad = true
        if (high && (!selected || bits != totalBits || !dataMode)) bad = true
        selected = !high
    }
    val idle = (mode & 2) != 0
    val sampleClock = if ((mode & 1) != 0) idle else !idle
    if (this == 1 && selected && high == sampleClock) {
        val byte = if (bits < 8) 44 else if (bits < 16) 18 else 52
        if (bits >= totalBits || dataMode != (bits >= 8) || dataHigh != ((byte & (1 << (7 - (bits & 7)))) != 0)) bad = true
        bits = bits + 1
    }
    return
}
fun Pin.read(): bool {
    bad = true
    false
}
fun peripheralDelayMicroseconds(duration: int): void {
    bad = true
    return
}
@export("abla_spi_command_native_test")
trusted fun commandNativeTest(): i32 {
    if (storage <= 0 || storage > 4294967288) return i32(10)
    nativeAddressStoreU8(storage, 4, 18)
    nativeAddressStoreU8(storage, 5, 52)
    val data = nativeBufferAt(storage + 4, 2)
    while (mode < 4) {
        var length = 0
        while (length <= 2) {
            bits = 0
            totalBits = 8 + length * 8
            bad = false
            val result = softwareSpiCommand(peripheralGateAt(storage), u32(7), Pin(1), Pin(2), Pin(4), Pin(5), 44, data, length, mode, 0)
            if (!result.valid() || bad || selected || bits != totalBits || nativeAddressLoadU32(storage, 0) != 0) return i32(1)
            length = length + 1
        }
        mode = mode + 1
    }
    activity = 0
    if (softwareSpiCommand(peripheralGateAt(storage), u32(7), Pin(1), Pin(2), Pin(4), Pin(5), 256, data, 2).status() != 3 || activity != 0) return i32(2)
    i32(0)
}
