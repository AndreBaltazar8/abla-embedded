import "../src/spi/software_command.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
import "../src/hal/delay.ab"
import "../src/hal/pin.ab"
import "abla/unsafe/memory/raw"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/peripheral_gate.ab"
import "../src/hal/spitransactionresult.ab"
import "../src/hal/native_buffer.ab"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_pin_valid")
fun pinValidHook(pin: int): bool = Pin(pin) >= 1 && Pin(pin) <= 5
@export("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin).valid()
val storage = nativeStaticMutableU32s([0, 0])
var bits = 0
var totalBits = 24
var mode = 0
var selected = false
var dataMode = true
var dataHigh = false
var bad = false
var activity = 0
@export("abla_pin_write")
trusted fun pinWriteHook(pin: int, high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(storage, 0) != 7) bad = true
    if (Pin(pin) == 2) dataHigh = high
    if (Pin(pin) == 5) dataMode = high
    if (Pin(pin) == 4) {
        if (!high && (selected || bits != 0 || dataMode)) bad = true
        if (high && (!selected || bits != totalBits || !dataMode)) bad = true
        selected = !high
    }
    val idle = (mode & 2) != 0
    val sampleClock = if ((mode & 1) != 0) idle else !idle
    if (Pin(pin) == 1 && selected && high == sampleClock) {
        val byte = if (bits < 8) 44 else if (bits < 16) 18 else 52
        if (bits >= totalBits || dataMode != (bits >= 8) || dataHigh != ((byte & (1 << (7 - (bits & 7)))) != 0)) bad = true
        bits = bits + 1
    }
    return
}
@export("abla_pin_read")
fun pinReadHook(pin: int): bool {
    bad = true
    false
}
@export("peripheralDelayMicroseconds")
fun peripheralDelayMicrosecondsHook(duration: int): void {
    bad = true
    return
}
@export("abla_spi_command_native_test")
trusted fun commandNativeTest(): i32 {
    if (storage <= 0 || storage > 4294967288) return i32(10)
    nativeAddressStoreU8(storage, 4, 18)
    nativeAddressStoreU8(storage, 5, 52)
    val data = nativeBufferAt(storage + 4, 2)
    while (mode < 4) {
        var length = 0
        while (length <= 2) {
            bits = 0
            totalBits = 8 + length * 8
            bad = false
            val result = softwareSpiCommand(peripheralGateAt(storage), u32(7), Pin(1), Pin(2), Pin(4), Pin(5), 44, data, length, mode, 0)
            if (!result.valid() || bad || selected || bits != totalBits || nativeAddressLoadU32(storage, 0) != 0) return i32(1)
            length = length + 1
        }
        mode = mode + 1
    }
    activity = 0
    if (softwareSpiCommand(peripheralGateAt(storage), u32(7), Pin(1), Pin(2), Pin(4), Pin(5), 256, data, 2).status() != 3 || activity != 0) return i32(2)
    i32(0)
}
