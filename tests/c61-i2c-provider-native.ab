import "../src/esp32/i2c/software_provider_c61.ab"
import "abla/runtime/scalar"
import "abla/build"
val payload=nativeStaticAllocate(8)
var pads=0
var failPad=0
var drives=0
var nested=false
var bad=false
var activeBus=I2cBus(0)
var activeDevice=I2cDevice(0)
var lowPin=-1
var expectedDelay=0
fun c61SoftwareI2cReady(sda: int,scl: int): bool = true
fun c61SoftwareI2cConfigure(pin: int,enable: bool): bool { pads=pads+1; return pads != failPad }
fun softwareI2cSample(pin: int): bool = pin != lowPin
trusted fun softwareI2cDrive(pin: int,release: bool): void {
    drives=drives+1
    if (nested) {
        nested=false
        if (activeDevice.close() || activeBus.close() || activeBus.device(68).valid() || activeDevice.setFrequency(100000)) bad=true
    }
    return
}
fun softwareI2cDelay(us: int): void { if (expectedDelay != 0 && us != expectedDelay) bad=true;return }
@export("abla_c61_i2c_provider_test")
trusted fun testProvider(): i32 {
    activeBus=i2cSoftwareMaster(27,28)
    if (!activeBus.valid() || pads != 2 || i2cSoftwareMaster(27,28).valid()) return i32(1)
    activeDevice=activeBus.device(67)
    if (!activeDevice.valid() || !activeBus.current()) return i32(2)
    if (activeBus.prepareProbeStatus() != 1 || activeBus.probeStatus(20) != 5 || activeBus.prepareProbeStatus() != 1) return i32(15)
    drives=0
    lowPin=27
    if (activeBus.prepareProbeStatus() != 4 || activeBus.probeStatus(20) != 4 || drives != 0) return i32(16)
    lowPin=-1
    softwareI2cProviderStore(16,3)
    if (activeBus.prepareProbeStatus() != 3 || activeBus.probeStatus(20) != 3 || drives != 0) return i32(17)
    lowPin=27
    if (activeBus.recoverStatus() != 4 || softwareI2cProviderLoad(16) != 3) return i32(21)
    lowPin=-1
    if (!activeBus.recover() || activeBus.prepareProbeStatus() != 1 || softwareI2cProviderLoad(16) != 0) return i32(22)
    drives=0
    softwareI2cProviderStore(16,261)
    if (!softwareI2cProviderEnter()) return i32(18)
    val busy=activeBus.prepareProbeStatus() == 4 && activeBus.probeStatus(20) == 4 && activeBus.recoverStatus() == 4
    if (!softwareI2cProviderLeave() || !busy || drives != 0) return i32(19)
    val descriptorBefore=softwareI2cProviderPool().resolve(activeDevice|0)
    if (!activeDevice.setFrequency(20000) || activeDevice.setFrequency(999) || drives != 0) return i32(39)
    val changed=softwareI2cProviderPool().resolve(activeDevice|0)
    if (((changed>>>16)&1023) != 25 || (changed&~(1023<<16)) != (descriptorBefore&~(1023<<16))) return i32(40)
    expectedDelay=25
    nested=true
    if (activeDevice.transferStatus(NativeBuffer(0),0,nativeBufferAt(payload,8),1) != 5 || drives == 0 || bad) return i32(3)
    expectedDelay=0
    drives=0
    if (activeDevice.transferStatus(nativeBufferAt(softwareI2cProviderState,32),1,NativeBuffer(0),0) != 2 ||
        activeDevice.transferStatus(NativeBuffer(0),0,nativeBufferAt(softwareI2cProviderSlots+199,2),2) != 2 || drives != 0) return i32(4)
    if (!activeDevice.close() || activeDevice.close() || activeDevice.setFrequency(100000)) return i32(5)
    val replacement=activeBus.device(68)
    if (!replacement.valid() || replacement == activeDevice || activeDevice.transferStatus(NativeBuffer(0),0,nativeBufferAt(payload,8),1) != 2 || drives != 0) return i32(6)
    val oldBus=activeBus
    failPad=pads+2
    if (activeBus.close() || softwareI2cProviderLoad(24) != 2 || replacement.close()) return i32(7)
    failPad=0
    if (!activeBus.close() || softwareI2cProviderLoad(24) != 0) return i32(8)
    activeBus=i2cSoftwareMaster(27,28)
    if (oldBus.prepareProbeStatus() != 2 || oldBus.probeStatus(20) != 2 || activeBus.prepareProbeStatus() != 1) return i32(20)
    if (!activeBus.valid() || activeBus == oldBus || oldBus.close() || oldBus.device(67).valid() || i2cSoftwareAbortSetup()) return i32(9)
    if (!activeBus.close()) return i32(10)
    failPad=pads+2
    if (i2cSoftwareMaster(27,28).valid() || softwareI2cProviderLoad(24) != 2 || activeBus.close()) return i32(11)
    failPad=0
    if (!i2cSoftwareAbortSetup() || softwareI2cProviderLoad(24) != 0) return i32(12)
    activeBus=i2cSoftwareMaster(27,28)
    var count=0
    while (count < 16) { if (!activeBus.device(67).valid()) return i32(13); count=count+1 }
    if (activeBus.device(67).valid() || activeBus.probeStatus(20) != 5 || !activeBus.close()) return i32(14)
    // Unpublished busy setup can recover without reallocating its epoch/pads.
    val stale=activeBus
    lowPin=27
    if (i2cSoftwareMaster(27,28,5,8).valid()) return i32(29)
    val pendingEpoch=softwareI2cProviderLoad(4)
    val savedPads=pads
    if (i2cSoftwareRecoverSetup().valid() || softwareI2cProviderOwner().status() != 6 || pads != savedPads) return i32(30)
    lowPin=28
    if (i2cSoftwareRecoverSetup().valid() || softwareI2cProviderOwner().status() != 10 || pads != savedPads) return i32(31)
    lowPin=-1;drives=0
    if (!softwareI2cProviderEnter()) return i32(32)
    val refused=i2cSoftwareRecoverSetup().valid()
    if (!softwareI2cProviderLeave() || refused || drives != 0) return i32(33)
    activeBus=i2cSoftwareRecoverSetup()
    if (!activeBus.current() || (activeBus|0) != pendingEpoch || pads != savedPads || stale.close() ||
        i2cSoftwareRecoverSetup().valid() || i2cSoftwareAbortSetup()) return i32(34)
    if (!activeBus.device(67).valid() || !activeBus.close()) return i32(35)
    // A failed pad readback is not merely an idle-bus failure.
    failPad=pads+2
    if (i2cSoftwareMaster(27,28).valid()) return i32(36)
    drives=0
    if (i2cSoftwareRecoverSetup(true).valid() || drives != 0) return i32(37)
    failPad=0
    if (!i2cSoftwareAbortSetup()) return i32(38)
    return i32(0)
}
