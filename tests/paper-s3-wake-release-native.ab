import "../src/m5stack/paper_s3_wake_release_sequence.ab"
import "abla/build"
var releaseAfter=0
var reads=0
var waits=0
var outcome=0
var bad=false
fun paperS3WakePinReleased(): bool = reads >= releaseAfter
fun paperS3WakeConsume(handle: int,scratch: NativeBuffer): int {
    if (handle != 123 || scratch.addressValue() != 4096 || reads != waits) bad=true
    reads=reads+1;return outcome
}
fun paperS3WakeDelayMilliseconds(milliseconds: int): void {
    if (milliseconds != 5 || reads != waits+1) bad=true
    waits=waits+1;return
}
@export("abla_paper_s3_wake_release_test")
fun test(): int {
    val scratch=nativeBufferAt(4096,40)
    var round=0
    while (round <= 9) {
        var code=-3
        while (code <= 6) {
            releaseAfter=round;reads=0;waits=0;outcome=code;bad=false
            val result=paperS3ReleaseWakePinOwned(123,scratch,true)
            val count=if (round > 8) 8 else round
            val comm=round < 8 || (code >= 0 && code <= 5) || code == -2
            if (!result.valid() || result.released() != (round <= 8) || result.communicated() != comm || result.attempts() != count || reads != count || waits != count || bad) return 1
            if (paperS3WakePinFinalReleasedOwned() != (round <= 8)) return 2
            code=code+1
        }
        round=round+1
    }
    reads=0;waits=0
    if (paperS3ReleaseWakePinOwned(0,scratch,true).valid() || paperS3ReleaseWakePinOwned(123,scratch,false).valid() || paperS3ReleaseWakePinOwned(123,nativeBufferAt(4096,39),true).valid() || reads != 0 || waits != 0) return 3
    return 0
}
