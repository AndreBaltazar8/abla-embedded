import "./i2s-capture-session-c6-native.ab"
import "../src/esp32/i2s/capture_stream_c6_sequence.ab"
@export("abla_i2s_capture_stream_c6_test")
trusted fun testStream(): i32 {
    val memory=nativeStaticAllocate(2304)
    val r=nativeBufferAt(memory,364);val q=nativeBufferAt(memory+364,32);val cancel=nativeBufferAt(memory+396,32)
    registers=nativeBufferAt(memory+428,1536);descriptors=nativeBufferAt(memory+1964,24)
    channel=0;cancelModel=true;streamModel=true
    while (channel < 3) {
        var mode=0
        while (mode < 4) {
            var at=0
            while (at < 428) { nativeBufferAt(memory,428).storeU32(at,0);at=at+4 }
            initialize(nativeBufferAt(memory+40,180));drop=0;resetCount=0
            seed(0x60080000+channel*16,0);seed(0x6000c00c,0)
            delayed=(mode&1) != 0
            val opened=c6CaptureOpenOwned(r,channel,1,240000000,48000,0,0,1,2,3,-1,16,16,16,true,0x40800000,2,0x40810000,64,64,1,true,true)
            if (opened != (if (delayed) 5 else 1) || bad) return i32(1)
            if (delayed) {
                val before=writes
                if (c6CaptureStreamPollOwned(r,q,1,true) != 5 || writes != before || starts != 0) return i32(2)
                delayed=false
            }
            if (c6CaptureStreamPollOwned(r,q,1,true) != 5 || starts != 1 || r.loadU32(260) != 1 || descriptors.loadU32(20) != 0x40800000) return i32(3)
            var cycle=0
            while (cycle < 130) {
                val index=cycle&1;val length=cycle%65
                descriptors.storeU32(index*12,0x40000040|(length<<12))
                if (c6CaptureStreamPollOwned(r,q,1,true) != 1) return i32(4)
                val view=c6CaptureStreamBufferOwned(r,q,true)
                if (view.addressValue() != 0x40810000+index*64 || view.capacity() != length || c6CaptureStreamReleaseOwned(r,q,false,true) != 2) return i32(5)
                if (c6CaptureStreamReleaseOwned(r,q,true,true) != 1 || descriptors.loadU32(index*12) != 0x80000040 || c6CaptureStreamBufferOwned(r,q,true) != NativeBuffer(0) || bad) return i32(6)
                cycle=cycle+1
            }
            if (mode >= 2) {
                setRegister(0x6000c00c,u32(5))
                if (c6CaptureStreamPollOwned(r,q,1,true) != 3 || r.loadU32(8) != 0x50001 || c6CaptureStreamBufferOwned(r,q,true) != NativeBuffer(0)) return i32(7)
            }
            var result=c6CaptureCancelOwned(r,cancel,2,1,0,true,true,if (mode >= 2) 4 else 0)
            var tries=0
            while (result == 5 && tries < 10) { result=c6CaptureCancelOwned(r,cancel,2,1,0,true,true,if (mode >= 2) 4 else 0);tries=tries+1 }
            if (result != 8 || stops != 1 || resetCount != 1 || bad || c6CaptureStreamBufferOwned(r,q,true) != NativeBuffer(0) || c6CaptureStreamReleaseOwned(r,q,true,true) != 2) return i32(8)
            at=0
            while (at < entries) {
                if (registers.loadU32(at*12+4) != registers.loadU32(at*12+8)) return i32(9)
                at=at+1
            }
            mode=mode+1
        }
        channel=channel+1
    }
    return i32(0)
}
