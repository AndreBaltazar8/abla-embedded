import "../src/esp32/mspi_cpu_guard_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
var gate=13
var core=0x603
var bits=0
var reads=0
var memoryReads=0
var bad=false
trusted fun c5MspiRead(address: int): int {
    reads=reads+1
    if (address == 0x60096018) return gate
    if (address == 0x6009601c) return core
    if (address == 0x60002050) { memoryReads=memoryReads+1;return bits }
    bad=true;return 0
}
trusted fun c5MspiWrite(address: int,value: int): void { bad=true;return }
@export("abla_mspi_cpu_guard_c5_test")
trusted fun test(): i32 {
    var divider=1
    while (divider <= 256) {
        core=0x600|(divider-1)
        var n=1
        while (n <= 256) {
            bits=n-1
            var cpu=1
            while (cpu <= 60) {
                val expected=cpu*8*divider*n >= 480 && cpu*8 >= 20
                if (esp32C5MspiCpuChangeSafeOwned(cpu,80,20,true) != expected ||
                    esp32C5MspiCpuChangeSafeOwned(80,cpu,20,true) != expected) return i32(1)
                cpu=cpu+1
            }
            n=n+1
        }
        divider=divider+1
    }
    core=0x603;bits=0x800000ff
    if (esp32C5MspiCpuChangeSafeOwned(14,40,20,true) || !esp32C5MspiCpuChangeSafeOwned(15,40,20,true)) return i32(2)
    core=0x602;bits=6 //160/7MHz: CPU2 unsafe, CPU3 safe
    if (esp32C5MspiCpuChangeSafeOwned(2,40,16,true) || !esp32C5MspiCpuChangeSafeOwned(3,40,16,true)) return i32(3)
    val before=reads
    if (esp32C5MspiCpuChangeSafeOwned(20,40,20,false) || reads != before) return i32(4)
    memoryReads=0
    if (!esp32C5MspiCpuChangeSafeOwned(1,40,0,true) || memoryReads != 0) return i32(5)
    gate=9
    if (esp32C5MspiCpuChangeSafeOwned(20,40,20,true)) return i32(6)
    gate=13;core=0x503
    if (esp32C5MspiCpuChangeSafeOwned(20,40,20,true)) return i32(7)
    return if (bad) i32(8) else i32(0)
}
