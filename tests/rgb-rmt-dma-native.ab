val descriptorsAddress = nativeStaticMutableU32s([0,0,0,0,0,0])
var parked = true
var transfers = 0
var transferResult = 0x710201
var expectedBytes = 0
var bad = false
fun esp32s3GdmaLinearTxCount(bytes: int): int = (bytes + 4091) / 4092
fun esp32s3GdmaLinearTxLayoutValid(desc: int, buffer: int, bytes: int): bool =
    desc == descriptorsAddress && buffer == waveformAddress && bytes >= 8 && bytes <= 6152
trusted fun esp32s3GdmaParked(channel: int, tx: bool): bool {
    if (channel != 2 || !tx) bad = true
    parked
}
trusted fun esp32s3RmtTransmitDmaOwned(channel: int, divider: int, desc: int,
    source: NativeBuffer, bytes: int, polls: int): int {
    transfers = transfers + 1
    if (channel != 2 || divider != 8 || desc != descriptorsAddress ||
        source.addressValue() != waveformAddress || bytes != expectedBytes || polls != 100 ||
        source.loadU32(bytes - 4) != 0 || source.loadU32(bytes - 8) != 0x05780578) bad = true
    transferResult
}
trusted fun rgbDmaTest(): int {
    val colors = nativeBufferAt(colorsAddress, 192)
    val frame = nativeBufferAt(waveformAddress, 6160)
    var index = 0
    while (index < 192) { colors.store(index, (index * 37 + 11) & 255); index = index + 1 }
    var count = 1
    while (count <= 64) {
        expectedBytes = count * 96 + 8
        var order = 0
        while (order < 6) {
            val mapping = if (order == 0) 0x020100 else if (order == 1) 0x010200 else
                if (order == 2) 0x020001 else if (order == 3) 0x000201 else
                if (order == 4) 0x010002 else 0x000102
            var level = 0
            while (level < 4) {
                val brightness = if (level == 0) 0 else if (level == 1) 63 else if (level == 2) 127 else 255
                frame.storeU32(expectedBytes, 0xdeadbeef)
                transfers = 0
                if (esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, colors, count,
                    order, brightness, frame, 100) != transferResult || transfers != 1 || bad) return 1
                var pixel = 0
                while (pixel < count) {
                    var channel = 0
                    while (channel < 3) {
                        val inputIndex = pixel * 3 + ((mapping >>> (channel * 8)) & 255)
                        val raw = (inputIndex * 37 + 11) & 255
                        val expected = raw * (brightness + 1) * (brightness + 1) / 65536
                        var bit = 0
                        while (bit < 8) {
                            val symbol = if ((expected & (1 << (7 - bit))) == 0) 0x00088004 else 0x00048008
                            if (frame.loadU32((pixel * 24 + channel * 8 + bit) * 4) != symbol) return 2
                            bit = bit + 1
                        }
                        channel = channel + 1
                    }
                    pixel = pixel + 1
                }
                if (frame.loadU32(expectedBytes) != 0xdeadbeef) return 3
                level = level + 1
            }
            order = order + 1
        }
        count = count + 1
    }
    index = 0
    while (index < 192) {
        if (colors.load(index) != ((index * 37 + 11) & 255)) return 4
        index = index + 1
    }
    // Both hardware errors and recovery flags must survive this adapter.
    expectedBytes = 104; transferResult = 0x720909
    if (esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, colors, 1, 2, 255, frame, 100) != transferResult || bad) return 5
    frame.storeU32(0, 0x12345678); transfers = 0; parked = false
    if (esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, colors, 1, 2, 255, frame, 100) != 3 ||
        frame.loadU32(0) != 0x12345678 || transfers != 0) return 6
    parked = true
    if (esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, colors, 0, 2, 255, frame, 100) != 2 ||
        esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, colors, 65, 2, 255, frame, 100) != 2 ||
        esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, colors, 1, 6, 255, frame, 100) != 2 ||
        esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, colors, 1, 2, 256, frame, 100) != 2 ||
        esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, colors, 1, 2, 255, nativeBufferAt(waveformAddress, 103), 100) != 2 ||
        esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, nativeBufferAt(waveformAddress, 3), 1, 2, 255, frame, 100) != 2 ||
        esp32s3RmtWriteRgbDmaOwned(2, descriptorsAddress, nativeBufferAt(descriptorsAddress, 3), 1, 2, 255, frame, 100) != 2 ||
        frame.loadU32(0) != 0x12345678 || transfers != 0 || bad) return 7
    0
}
#exportFunction("rgbDmaTest", "abla_rgb_dma_test")
