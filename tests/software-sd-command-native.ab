import "../src/sd/software_command.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val receivedStorage = nativeStaticMutableU32s([0])
var selected = false
var outputHigh = false
var bits = 0
var idleBits = 0
var inputBits = 0
var bad = false
var variant = 0
trusted fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) selected = !high
    if (this == 1 && high) {
        if (selected) {
            val frame = if (variant == 3) 0x4c0000000061 else 0x48000001aa87
            val expected = if (bits < 48) ((frame >> (47 - bits)) & 1) != 0 else true
            if (outputHigh != expected) bad = true
            bits = bits + 1
        } else {
            if (!outputHigh) bad = true
            idleBits = idleBits + 1
        }
    }
    return
}
trusted fun Pin.read(): bool {
    if (this != 3 || !selected || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    val bit = inputBits
    inputBits = inputBits + 1
    if (variant == 1) return true
    if (variant == 2) return ((5 >> (7 - bit)) & 1) != 0
    if (variant == 3) return ((1 >> (15 - bit)) & 1) != 0
    // Delayed R1=idle, followed by R7 voltage/check pattern.
    ((0xff01000001aa >> (47 - bit)) & 1) != 0
}
fun peripheralDelayMicroseconds(duration: int): void {
    if (duration != 2) bad = true
    return
}
trusted fun sdCommandTest(): int {
    val gate = peripheralGateAt(gateStorage)
    val receive = nativeBufferAt(receivedStorage, 4)
    while (variant < 4) {
        bits = 0
        inputBits = 0
        idleBits = 0
        nativeAddressStoreU32(receivedStorage, 0, 0)
        val result = softwareSdCommand(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
            if (variant == 3) 12 else 8, if (variant == 3) 0 else 426, receive, if (variant == 3) 0 else 4)
        if (bad || selected || idleBits != 8 || nativeAddressLoadU32(gateStorage, 0) != 0) return 1
        if (variant == 0 && (result.status() != 1 || result.value() != u32(1) || bits != 96 || inputBits != 48 || nativeAddressLoadU32(receivedStorage, 0) != 0xaa010000)) return 2
        if (variant == 1 && (result.status() != 6 || bits != 112 || inputBits != 64)) return 3
        if (variant == 2 && (result.status() != 1 || result.value() != u32(5) || bits != 56 || inputBits != 8 || nativeAddressLoadU32(receivedStorage, 0) != 0)) return 4
        if (variant == 3 && (result.status() != 1 || result.value() != u32(1) || bits != 64 || inputBits != 16)) return 9
        variant = variant + 1
    }
    bits = 0
    idleBits = 0
    if (softwareSdCommand(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), 64, 0, receive, 4).status() != 3) return 5
    if (softwareSdCommand(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), 8, 426, nativeBufferAt(4294967295, 4), 4).status() != 3) return 8
    nativeAddressStoreU32(gateStorage, 0, 9)
    if (softwareSdCommand(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), 8, 426, receive, 4).status() != 2) return 6
    if (bits != 0 || idleBits != 0) return 7
    0
}
#exportFunction("sdCommandTest", "abla_sd_command_test")
