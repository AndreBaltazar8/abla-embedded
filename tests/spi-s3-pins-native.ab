import "../src/esp32/spi/pins_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.valid(): bool = this >= 0 && this <= 48
fun Pin.outputCapable(): bool = this.valid()
var stage = 0
var failAt = 0
var peripheral = 2
var bad = false
trusted fun Pin.outputLevelOwned(level: bool): bool { if (this != 4 || !level || stage != 0) bad = true; stage = 3; return failAt != 3 }
trusted fun Pin.routeOutputSignal(signal: int, inverted: bool): bool {
    val expected = if (peripheral == 2) 101 else 66
    if (inverted || (stage != 3 && stage != 4) ||
        this != (if (stage == 3) 1 else 2) || signal != expected + (if (stage == 3) 0 else 2)) bad = true
    stage = stage + 1
    stage != failAt
}
trusted fun Pin.routeInputSignal(signal: int, inverted: bool): bool {
    if (stage != 5 || this != 3 || inverted || signal != (if (peripheral == 2) 102 else 67)) bad = true
    stage = 6
    stage != failAt
}
trusted fun spiPinsTest(): int {
    val pins = spiPins(2, 3, 1)
    while (peripheral <= 3) {
        failAt = 0
        while (failAt <= 6) {
            stage = 0
            val result = esp32s3SpiRouteMasterPinsOwned(peripheral, pins, Pin(4))
            if (result != (if (failAt == 3) 6 else if (failAt < 4) 1 else failAt - 1) ||
                stage != (if (failAt < 3) 6 else failAt) || bad) return 1
            failAt = failAt + 1
        }
        peripheral = peripheral + 1
    }
    var a = 0
    while (a < 4) {
        var b = 0
        while (b < 4) {
            var c = 0
            while (c < 4) {
                var d = 0
                while (d < 4) {
                    val distinct = a != b && a != c && a != d && b != c && b != d && c != d
                    if (esp32s3SpiMasterPinsValid(2, spiPins(a, b, c), Pin(d)) != distinct) return 2
                    d = d + 1
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    stage = 0
    if (esp32s3SpiRouteMasterPinsOwned(1, pins, Pin(4)) != 2 ||
        esp32s3SpiRouteMasterPinsOwned(2, spiPins(-1, 3, 1), Pin(4)) != 2 ||
        esp32s3SpiRouteMasterPinsOwned(2, pins, Pin(3)) != 2 ||
        esp32s3SpiRouteMasterPinsOwned(2, pins, Pin(49)) != 2 || stage != 0) return 3
    peripheral=2
    while (peripheral <= 3) {
        failAt=0
        while (failAt <= 5) {
            stage=0;bad=false
            val tx=spiPins(2,-1,1)
            if (esp32s3SpiMasterPinsValid(peripheral,tx,Pin(4)) ||
                !esp32s3SpiTransmitPinsValid(peripheral,tx,Pin(4))) return 4
            val result=esp32s3SpiRouteTransmitPinsOwned(peripheral,tx,Pin(4))
            if (result != (if (failAt == 3) 6 else if (failAt < 4) 1 else failAt-1) ||
                stage != (if (failAt < 3) 5 else failAt) || bad) return 5
            failAt=failAt+1
        }
        peripheral=peripheral+1
    }
    stage=0
    if (esp32s3SpiRouteTransmitPinsOwned(2,spiPins(2,-2,1),Pin(4)) != 2 ||
        esp32s3SpiRouteTransmitPinsOwned(2,spiPins(1,-1,1),Pin(4)) != 2 || stage != 0) return 6
    0
}
#exportFunction("spiPinsTest", "abla_spi_pins_test")
