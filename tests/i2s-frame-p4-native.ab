import "../src/esp32/i2s/frame_width_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/sdk/raw_buffer.ab"
val regs = nativeStaticAllocate(48)
var reads=0
var writes=0
var fail=0
var bad=false
var selected=0
trusted fun offset(address: int): int {
    val delta=address-0x500c6000
    val port=delta/4096
    val reg=delta-port*4096-32
    if (port != selected || reg < 0 || reg > 12 || (reg & 3) != 0) { bad=true;return 0 }
    return port*16+reg
}
trusted fun p4I2sFrameRead(address: int): int {
    reads=reads+1
    return nativeAddressLoadU32(regs,offset(address))
}
trusted fun p4I2sFrameWrite(address: int,value: int): void {
    writes=writes+1
    val at=offset(address)
    if (writes != fail) nativeAddressStoreU32(regs,at,value)
    return
}
trusted fun reset(): void {
    var at=0
    while (at < 48) { nativeAddressStoreU32(regs,at,0x40000200);at=at+4 }
    reads=0;writes=0;bad=false
    return
}
@export("abla_i2s_frame_p4_test")
trusted fun test(): i32 {
    while (selected < 3) {
        var tx=0
        while (tx < 2) {
            var bits=8
            while (bits <= 32) {
                var slot=bits
                while (slot <= 32) {
                    var ws=1
                    while (ws <= slot*2) {
                        reset();fail=0
                        if (esp32p4I2sSetFrameWidthsOwned(selected,tx==1,bits,slot,ws,true,true) != 1 || bad || writes != 2) return i32(1)
                        val frame=nativeAddressLoadU32(regs,selected*16+tx*4+8)
                        if ((frame & 511) != ws-1 || ((frame >>> 14) & 31) != bits-1 ||
                            ((frame >>> 19) & 255) != slot-1 || ((frame >>> 27) & 31) != slot-1 ||
                            (frame & 0x3e00) != 512) return i32(2)
                        if (nativeAddressLoadU32(regs,selected*16+tx*4) != 0x40002200 ||
                            nativeAddressLoadU32(regs,selected*16+(1-tx)*4) != 0x40000200 ||
                            nativeAddressLoadU32(regs,selected*16+(1-tx)*4+8) != 0x40000200) return i32(3)
                        if (esp32p4I2sSetFrameWidthsOwned(selected,tx==1,bits,slot,ws,false,true) != 1 ||
                            nativeAddressLoadU32(regs,selected*16+tx*4) != 0x40000200) return i32(4)
                        ws=ws+1
                    }
                    slot=slot+1
                }
                bits=bits+8
            }
            fail=1
            while (fail <= 2) {
                reset()
                if (esp32p4I2sSetFrameWidthsOwned(selected,tx==1,16,16,16,true,true) != fail+3 || writes != fail || bad) return i32(5)
                fail=fail+1
            }
            var direction=0
            while (direction < 2) {
                var bit=1
                while (bit <= 256) {
                    if ((bit & 263) != 0) {
                        reset();nativeAddressStoreU32(regs,selected*16+direction*4,bit)
                        if (esp32p4I2sSetFrameWidthsOwned(selected,tx==1,16,16,16,true,true) != 3 || writes != 0) return i32(6)
                    }
                    bit=bit*2
                }
                direction=direction+1
            }
            tx=tx+1
        }
        selected=selected+1
    }
    reset()
    if (esp32p4I2sSetFrameWidthsOwned(0,false,16,16,16,true,false) != 2 ||
        esp32p4I2sSetFrameWidthsOwned(-1,false,16,16,16,true,true) != 2 ||
        esp32p4I2sSetFrameWidthsOwned(3,false,16,16,16,true,true) != 2 ||
        esp32p4I2sSetFrameWidthsOwned(0,false,12,16,16,true,true) != 2 ||
        esp32p4I2sFrameWidthWord(32,16,16) != -1 || esp32p4I2sFrameWidthWord(16,33,16) != -1 ||
        esp32p4I2sFrameWidthWord(16,16,0) != -1 || esp32p4I2sFrameWidthWord(16,16,33) != -1 || reads != 0 || writes != 0) return i32(7)
    return i32(0)
}
