import "../src/esp32.ab"

trusted fun persistentBufferCheck(): bool {
    val buffer = nativeBufferAt(nativeStaticAllocate(8), 8)
    buffer.storeU32(1, 305419896)
    buffer.capacity() == 8 && buffer.loadU32(1) == 305419896 &&
        buffer.load(0) == 0 && buffer.load(5) == 0
}

trusted fun main: int {
    val led: Pin = pin(27)
    val audio: I2sDevice = i2s(0, i2sPins(19, 33, 22, 23), 16000)
    val spi: SpiPins = spiPins(23, 19, 18)
    val descriptor: DmaDescriptor = dmaDescriptorAt(1073414144)
    val rxQueue: WifiRxQueue = wifiRxQueueAt(1073410048)
    val buttonSource: GpioButton = pin(39).asButton()
    if (led == Pin(27) && audio.portNumber() == 0 &&
        spi.mosiPin() == 23 && spi.misoPin() == 19 &&
        spi.clockPin() == 18 &&
        descriptor.addressValue() == 1073414144 &&
        descriptor.isAligned(4) &&
        rxQueue.addressValue() == 1073410048 && rxQueue.valid() &&
        buttonSource.pin().number() == 39 && buttonSource.activeLow() &&
        persistentBufferCheck()) 42 else 1
}
