import "../src/esp32.ab"

trusted fun persistentBufferCheck(): bool {
    val buffer = nativeBufferAt(nativeStaticAllocate(8), 8)
    buffer.storeU32(0, 42)
    buffer.capacity() == 8 && buffer.loadU32(0) == 42
}

trusted fun main: int {
    val led: Pin = pin(27)
    val audio: I2sDevice = i2s(0, i2sPins(19, 33, 22, 23), 16000)
    if (led == Pin(27) && audio.portNumber() == 0 &&
        persistentBufferCheck()) 42 else 1
}
