import "../src/sd/software_block.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val storage = nativeStaticAllocate(512)
var selected = false
var outputHigh = false
var bits = 0
var idleBits = 0
var frame = 0
var reads = 0
var variant = 0
var bad = false
trusted fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) selected = !high
    if (this == 1 && high) {
        if (selected) {
            if (bits < 48) frame = (frame << 1) | (if (outputHigh) 1 else 0)
            else if (!outputHigh) bad = true
            bits = bits + 1
        } else { idleBits = idleBits + 1; if (!outputHigh) bad = true }
    }
    return
}
trusted fun Pin.read(): bool {
    if (this != 3 || !selected) bad = true
    val byte = reads / 8
    var value = 255
    if (byte == 0) value = if (variant == 4) 4 else 0
    else if (byte == 1) value = if (variant == 2) 255 else if (variant == 3) 8 else 254
    else if (byte == 514) value = 127
    else if (byte == 515) value = if (variant == 1) 160 else 161
    val bit = (value >> (7 - reads % 8)) & 1
    reads = reads + 1
    bit != 0
}
fun peripheralDelayMicroseconds(duration: int): void {
    if (duration != 2 && duration != 1000) bad = true
    return
}
trusted fun sdReadTest(): int {
    val data = nativeBufferAt(storage, 512)
    while (variant < 5) {
        bits = 0; idleBits = 0; frame = 0; reads = 0
        val result = softwareSdReadBlock(peripheralGateAt(gateStorage), u32(7), Pin(1), Pin(2), Pin(3), Pin(4), SoftwareSdInitResult(65537), 7, data)
        if (bad || selected || idleBits != 8 || nativeAddressLoadU32(gateStorage, 0) != 0) return 1
        if ((frame >>> 40) != 81 || ((frame >>> 8) & 4294967295) != 7 || (frame & 255) != sdSpiCommandFrameCrc(17, 7)) return 2
        val expected = if (variant == 0) 1 else if (variant == 1) 9 else if (variant == 2) 7 else if (variant == 3) 8 else 6
        if (result.status() != expected) return 3
        if (variant == 0) {
            var index = 0
            while (index < 512) { if (data.load(index) != 255) return 4; index = index + 1 }
            if (reads != 516 * 8) return 5
        }
        if (variant == 2 && reads != 251 * 8) return 6
        variant = variant + 1
    }
    0
}
#exportFunction("sdReadTest", "abla_sd_read_test")
