// Regression for REL addends stored in Xtensa literal words.

import "abla/io"
import "abla/bytes"
import "abla/text"
import "../tools/lib/reconstruct-xtensa.ab"
import "../tools/lift-xtensa-leaves-to-abla.ab"

fun main: int {
    // GCC represents this PHY end pointer as an R_XTENSA_32 relocation against an
    // anonymous rodata section while keeping the +6 REL addend in the literal word.
    // BFD omits that addend from the relocation text, so reconstruction must read
    // it from the section contents.
    val content = byteEncode(0).repeat(16) + byteEncode(6) + byteEncode(0) + byteEncode(0) + byteEncode(0)
    val data: Map<string, string> = Map()
    data.set(".text.fixture", content)
    val fixtureRelocations: Map<int, ReconReloc> = Map()
    fixtureRelocations.set(0x10, ReconReloc("32", ".rodata.CSWTCH\$356"))
    val relocations: Map<string, Map<int, ReconReloc>> = Map()
    relocations.set(".text.fixture", fixtureRelocations)
    val expression = literalExpression(".text.fixture", 0x10, data, relocations)
    if (expression.error != "" || expression.text != ".rodata.CSWTCH\$356+0x6") {
        println("FAIL literal expression: '${expression.text}' (${expression.error})")
        return 1
    }

    // The REL rule is not specific to anonymous section symbols. If BFD presents
    // a bare named target, its nonzero in-place addend has the same meaning.
    val named = dataRelocationExpression("named_table", byteEncode(6) + byteEncode(0) + byteEncode(0) + byteEncode(0), 0)
    if (named != "named_table+0x6") {
        println("FAIL named target: '$named'")
        return 1
    }

    val none: array<ReconReloc> = []
    val instruction = ReconInstruction(0x20, "l32r\ta3, 10 <fixture-0x10>", none)
    val recovered = recoverInstruction("fixture", ".text.fixture", instruction, data, relocations)
    if (recovered.error != "" || recovered.text != "movi a3, .rodata.CSWTCH\$356\naddi a3, a3, 6") {
        println("FAIL recovered instruction: '${recovered.text}' (${recovered.error})")
        return 1
    }
    // The structured lifter must retain the address adjustment rather than
    // collapsing both iterator bounds to the same section base.
    val lifted = lift("fixture",
        "entry a1, 32\nmovi a2, .rodata.CSWTCH\$356\nmovi a3, .rodata.CSWTCH\$356\naddi a3, a3, 6\nretw.n")
    if (lifted.error != "" || !lifted.source.contains("r3 = r3 + u32(6)")) {
        println("FAIL lifter dropped the +6 adjustment: '${lifted.source}' (${lifted.error})")
        return 1
    }
    println("Xtensa REL addend: section base +6 survives reconstruction and lifting")
    0
}
