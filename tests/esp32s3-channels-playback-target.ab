import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/cores3_channels_playback.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_channels_playback_target")
trusted fun channelsPlaybackTarget(amplifier: Aw88298,expander: Aw9523,bank: PcmChannels,
    descriptors: int,buffers: int,blocks: int,acc: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,owner: u32): CoreS3PlaybackResult =
    cores3PlaybackChannels(amplifier,expander,2,descriptors,buffers,bank,blocks,staging,acc,scratch,owner,1000)
