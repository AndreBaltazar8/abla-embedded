// Fixtures for tools/check-cache-internal-relocations.ab: internal data, flash
// table/helper, undefined relocation and relocation-free closure cases.

import "abla/io"
import "abla/text"
import "../tools/check-cache-internal-relocations.ab"

fun relocationFixture(
    targetName: string, targetIndex: int, relocations: bool, root: string, source: string
): string {
    val names = elfNameTable([".names", root, targetName, ".symtab", ".rela.iram1.code", source])
    val file = elfFixture()
    file.add(elfNameOffset(names, ".names"), 3, 0, names, 0, 0, 0)
    file.add(elfNameOffset(names, root), 1, 6, elfZeros(4), 0, 0, 0)
    file.add(elfNameOffset(names, targetName), 1, 2, elfZeros(4), 0, 0, 0)
    file.add(elfNameOffset(names, ".symtab"), 2, 0,
        elfZeros(16) + elfBytes32(0) + elfBytes32(0) + elfBytes32(4) + elfByte(3) + elfByte(0) +
            elfBytes16(targetIndex), 4, 0, 16)
    if (source != "") file.add(elfNameOffset(names, source), 1, 6, elfZeros(4), 0, 0, 0)
    if (relocations) {
        // info: the section the relocations apply to (2: the internal root, 5: the flash source)
        file.add(elfNameOffset(names, ".rela.iram1.code"), 4, 0,
            elfBytes32(0) + elfBytes32(257) + elfBytes32(0), 4, if (source != "") 5 else 2, 12)
    }
    file.finish(1)
}

var failures = 0

fun expectRejected(data: string, label: string): void {
    if (validateCacheInternalRelocations(data).error == "") {
        println("FAIL unsafe relocation accepted: $label")
        failures = failures + 1
    }
}

fun expectChecked(data: string, count: int, label: string): void {
    val result = validateCacheInternalRelocations(data)
    if (result.error != "" || result.checked != count) {
        println("FAIL $label: expected $count, got ${result.checked} (${result.error})")
        failures = failures + 1
    }
}

fun main: int {
    expectChecked(relocationFixture(".dram1.table", 3, true, ".iram1.code", ""), 1, "internal data")
    expectRejected(relocationFixture(".rodata.table", 3, true, ".iram1.code", ""), "flash table")
    expectRejected(relocationFixture(".text.helper", 3, true, ".iram1.code", ""), "flash helper")
    expectRejected(relocationFixture(".dram1.table", 0, true, ".iram1.code", ""), "undefined symbol")
    // A closure with no relocation at all is whole in internal memory: nothing to check. Without
    // any allocated internal section the check would be vacuous and must fail.
    expectChecked(relocationFixture(".dram1.table", 3, false, ".iram1.code", ""), 0, "relocation-free")
    expectRejected(relocationFixture(".text.helper", 3, false, ".text.code", ""), "no internal section")
    // Only a relocation whose source section is internal counts: one that applies to flash code is
    // skipped, so with an internal root present and nothing else to check the closure is accepted.
    expectChecked(relocationFixture(".text.helper", 3, true, ".iram1.code", ".text.caller"), 0, "flash source")
    if (failures != 0) return 1
    println("PASS: internal data, flash table/helper, undefined relocation and relocation-free closure cases")
    0
}
