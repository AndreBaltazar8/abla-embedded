import "../src/xtensa/assembly.ab"

@export("abla_xtensa_shift_probe")
fun xtensaShiftProbe(value: u32): u32 =
    $xtensa sll(value, u32(2))

@export("abla_xtensa_extract_probe")
fun xtensaExtractProbe(value: u32): u32 =
    $xtensa extui(value, u32(8), u32(8))

@export("abla_xtensa_extract_immediate_probe")
fun xtensaExtractImmediateProbe(value: u32): u32 =
    $xtensa extractImmediate(value) {13,1}

@export("abla_xtensa_add_probe")
fun xtensaAddProbe(left: u32, right: u32): u32 =
    $xtensa add(left, right)

@export("abla_xtensa_nsau_probe")
fun xtensaNsauProbe(value: u32): u32 =
    $xtensa nsau(value)

@export("abla_xtensa_composed_probe")
fun xtensaComposedProbe(value: u32, extra: u32): u32 =
    $xtensa sll(value, u32(2)) +
        $xtensa extui(extra, u32(8), u32(8))

@export("abla_xtensa_load32_probe")
trusted fun xtensaLoad32Probe(address: u32): u32 =
    $xtensa load32(address)

@export("abla_xtensa_store32_probe")
trusted fun xtensaStore32Probe(address: u32, value: u32): void = $xtensa store32(
    address,
    value
)

trusted fun xtensaStore32OffsetParseProbe(
    address: u32,
    value: u32
): void = $xtensa store32Offset(address, value) {40}

@export("abla_xtensa_device_load32_probe")
trusted fun xtensaDeviceLoad32Probe(address: u32): u32 =
    $xtensa deviceLoad32(address)

@export("abla_xtensa_device_store32_probe")
trusted fun xtensaDeviceStore32Probe(address: u32, value: u32): void =
    $xtensa deviceStore32(address, value)

trusted fun xtensaSetInterruptLevelParseProbe(value: u32): u32 =
    $xtensa setInterruptLevel(value)

trusted fun xtensaExternalRegisterReadParseProbe(address: u32): u32 =
    $xtensa externalRegisterRead(address)

trusted fun xtensaSemihostingParseProbe(
    operation: u32,
    arguments: u32
): void = $xtensa semihosting(operation, arguments)

trusted fun xtensaReadCycleCountParseProbe(): u32 =
    xtensaReadCycleCount()

trusted fun xtensaWaitForInterruptParseProbe(): void =
    xtensaWaitForInterrupt()

trusted fun xtensaCoprocessorEnableParseProbe(value: u32): u32 {
    val previous = $xtensa read {rsr.cpenable}
    $xtensa write(
        value
    ) {wsr.cpenable}
    return previous
}

trusted fun xtensaAtomicCompareExchangeParseProbe(
    address: u32,
    expected: u32,
    desired: u32
): u32 = $xtensa atomicCompareExchangeRelaxed(
    address,
    expected,
    desired
)

trusted fun xtensaAtomicCompareSetParseProbe(
    address: u32,
    expected: u32,
    desired: u32
): u32 = $xtensa atomicCompareSetRelaxed(address, expected, desired)

// Kept internal so host validation exercises the target subparser without
// asking the host assembler to accept Xtensa TLS instructions.
trusted fun xtensaTlsAddressParseProbe(): u32 =
    $xtensa tlsAddress {errno}

// Linker-generated local symbols are parsed as a validated optional dot plus
// a normal symbol name, never as an arbitrary assembly operand.
trusted fun xtensaLocalAddressParseProbe(): u32 =
    $xtensa address {.Labla_xtensa_local_probe}

@naked
trusted fun xtensaCall0ExceptionEnterParseProbe(): void =
    $xtensa call0ExceptionEnter {
        xtensa_context_save_probe,
        xtensa_scheduler_table_probe,
        xtensa_nesting_table_probe,
        xtensa_current_task_table_probe,
        xtensa_interrupt_stack_probe,
        1536}

@naked
trusted fun xtensaCall0ExceptionExitParseProbe(): void =
    $xtensa call0ExceptionExit {
        xtensa_scheduler_table_probe,
        xtensa_nesting_table_probe,
        xtensa_current_task_table_probe,
        xtensa_switch_flag_table_probe,
        xtensa_prepare_switch_probe,
        xtensa_dispatch_probe,
        xtensa_context_restore_probe,
        3}

@naked
trusted fun xtensaContextDispatchParseProbe(): void =
    $xtensa contextDispatch {
        xtensa_switch_probe,
        xtensa_current_task_table_probe,
        xtensa_startup_done_table_probe,
        72,
        96,
        xtensa_context_restore_probe}

@naked
trusted fun xtensaContextYieldParseProbe(): void =
    $xtensa contextYield {
        xtensa_window_spill_probe,
        xtensa_coprocessor_save_probe,
        xtensa_current_task_table_probe,
        72,
        96,
        xtensa_dispatch_probe,
        32,
        3}

trusted fun xtensaStartDispatcherParseProbe(): void =
    $xtensa startDispatcher {xtensa_dispatch_probe}

// A complete instruction body remains one optimizer-visible target extension,
// while the subparser owns the text-literal entry guard required by naked
// functions on Xtensa.
@naked
trusted fun xtensaInstructionBodyParseProbe(): void = $xtensa instructions {
.literal .Labla_xtensa_instruction_body_value, 0x12345678
entry a1, 32
l32r a2, .Labla_xtensa_instruction_body_value
retw.n
}

fun main: int = 0
