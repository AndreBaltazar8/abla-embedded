import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "../src/i2c/results.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type I2cDevice = int
var raw=0
var fail=false
var rx=false
var calls=0
var bad=false
var timerStopMode=false
var stopFailure=0
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister8(register: int): int { bad=true; return 0 }
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    if (!timerStopMode || register != 29 || value != 175) bad=true
    calls=calls+1
    stopFailure != 4
}
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    if (!timerStopMode || register != (if ((calls & 3) == 0) 28 else 30) || mask != 16 || value != 0) bad=true
    calls=calls+1
    stopFailure != 1
}
fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,buffer: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    if (timerStopMode) {
        if (register != (if ((calls & 3) == 2) 28 else 30)) bad=true
        calls=calls+1
        return I2cByteResult(if (stopFailure == 2) 0 else if (stopFailure == 3) 272 else 256)
    }
    calls=calls+1
    if (register != (if (rx) 29 else 1)) bad=true
    I2cByteResult(if (fail) 0 else 256 | raw)
}
@export("abla_rtc_interrupt_test")
trusted fun rtcInterruptTest(): i32 {
    var model=0
    while (model < 2) {
        rx=model == 1; raw=0
        while (raw < 256) {
            fail=false; calls=0
            val result=if (rx) Rx8130(7).interruptPendingChecked() else Pcf8563(7).interruptPendingChecked()
            if (!result.valid() || result.value() != (if ((raw & (if (rx) 24 else 12)) != 0) 1 else 0) || calls != 1 || bad) return i32(1)
            fail=true; calls=0
            val failure=if (rx) Rx8130(7).interruptPendingChecked() else Pcf8563(7).interruptPendingChecked()
            if (failure.valid() || calls != 1 || bad) return i32(2)
            raw=raw+1
        }
        model=model+1
    }
    calls=0
    if (Pcf8563(7).setAlarmInterrupt(0,0,0) || Rx8130(7).setAlarmInterrupt(0,0,0) ||
        Rx8130(0).stopTimer() || Pcf8563(0).interruptPendingChecked().valid() ||
        Rx8130(0).interruptPendingChecked().valid() || calls != 0 || bad) return i32(3)
    timerStopMode=true
    while (stopFailure <= 4) {
        calls=0
        val stopped=Rx8130(7).setTimerInterruptChecked(0)
        if (stopped.status() != (if (stopFailure == 0) 1 else 5) || stopped.milliseconds() != 0 ||
            calls != (if (stopFailure == 0 || stopFailure == 4) 5 else 13) || bad) return i32(4)
        stopFailure=stopFailure+1
    }
    i32(0)
}
