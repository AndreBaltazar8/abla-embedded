import "../src/esp32/i2c_esp32c5.ab"
import "../src/m5stack/touch_open.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_touch_board_target")
trusted fun target(bus: I2cBus,owner: TouchControllerOpen,snapshot: NativeBuffer,operation: int): int {
    if (operation == 0) return m5BoardToughC5.openTouch(bus) | 0
    if (operation == 1) return owner.chsc6540View().readStable(snapshot)
    if (operation == 2) return owner.close() | 0
    return -1
}
