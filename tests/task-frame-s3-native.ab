import "../src/esp32/task_frame_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var memory=nativeBufferAt(0,0)
var writes=0
fun esp32S3TaskFrameEntryAddress(): int = 0x40379000
fun esp32S3TaskFrameReturnAddress(): int = 0x4037A000
trusted fun esp32S3TaskFrameWrite(address: int,value: int): void { memory.storeU32(address-0x3FC90000,value); writes=writes+1; return }
@export("abla_task_frame_test")
trusted fun frameTest(): i32 {
    memory=nativeBufferAt(nativeStaticAllocate(2048),2048)
    var p=0
    while (p < 128) {
        val size=1024+(p & 31)*16
        var offset=0
        while (offset < 2048) { memory.storeU32(offset,0xABC00000+offset); offset=offset+4 }
        writes=0
        val arg=if ((p & 32) == 0) p else 0xFFFFFFFF
        val tls=if ((p & 64) == 0) 0 else 0x3FCA0000
        val frame=esp32S3TaskFrameInitializeOwned(nativeBufferAt(0x3FC90000,size),0x40378000,arg,0x4037B000,tls)
        val relative=size-208
        if (frame != 0x3FC90000+relative || writes != 64) return i32(1)
        offset=0
        while (offset < 2048) {
            var expected=if (offset >= relative-16 && offset < size) 0 else 0xABC00000+offset
            val slot=offset-relative
            if (slot == 0) expected=0x4037A000
            if (slot == 4) expected=0x40379000
            if (slot == 8) expected=0x50030
            if (slot == 16) expected=0x3FC90000+size-16
            if (slot == 36) expected=0x40378000
            if (slot == 40) expected=arg
            if (slot == 44) expected=0x4037B000
            if (slot == 112) expected=tls
            if (memory.loadU32(offset) != expected) return i32(2)
            offset=offset+4
        }
        p=p+1
    }
    writes=0
    val stack=nativeBufferAt(0x3FC90000,1024)
    if (esp32S3TaskFrameInitializeOwned(stack,0x40378001,0,0x4037B000,0) != 0 ||
        esp32S3TaskFrameInitializeOwned(stack,0x40378000,-1,0x4037B000,0) != 0 ||
        esp32S3TaskFrameInitializeOwned(stack,0x40378000,0,0,0) != 0 ||
        esp32S3TaskFrameInitializeOwned(nativeBufferAt(0x3FCFFC10,1024),0x40378000,0,0x4037B000,0) != 0 || writes != 0) return i32(3)
    i32(0)
}
