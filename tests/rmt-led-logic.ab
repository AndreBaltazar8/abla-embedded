import "../src/led/rmt_strip_logic.ab"

fun main: int {
    val ticks = rmtLedNanosecondsTicks(300, 10000000) == 3 &&
        rmtLedNanosecondsTicks(900, 10000000) == 9 &&
        rmtLedMicrosecondsTicks(280, 10000000) == 2800
    val symbols = rmtLedSymbol(3, 9) == 622595 &&
        rmtLedSymbol(9, 3) == 229385 &&
        rmtLedResetSymbol(2800) == 91751800
    val validity = rmtLedTimingValid(
        10000000, 300, 900, 900, 300, 280
    ) && !rmtLedTimingValid(0, 300, 900, 900, 300, 280) &&
        !rmtLedTimingValid(10000000, 0, 900, 900, 300, 280)
    if (ticks && symbols && validity) 59 else 1
}
