import "../src/esp32/rtc_ext0_record_s3_sequence.ab"
import "../src/esp32/rtc_wake_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/native"
import "abla/unsafe/mmio"
import "abla/build"
val memory=nativeStaticAllocate(128)
var holds=0
var clock=0
var selector=0
var level=0
var usb=0
var writes=0
var bad=false
trusted fun esp32S3RtcWakeRead(address: int): int {
    if (address >= 4096 && address < 4128) return mmioLoadU32(memory+address-4096)
    if (address >= 0x60008484 && address <= 0x600084D8) return mmioLoadU32(memory+32+address-0x60008484)
    if (address == 0x600080D8) return holds
    if (address == 0x60008904) return clock
    if (address == 0x600084DC) return selector
    if (address == 0x60008064) return level
    if (address == 0x60038018) return usb
    bad=true; 0
}
trusted fun esp32S3RtcWakeWrite(address: int,value: int): void {
    if (address >= 4096 && address < 4128) mmioStoreU32(memory+address-4096,value)
    else if (address >= 0x60008484 && address <= 0x600084D8) mmioStoreU32(memory+32+address-0x60008484,value)
    else if (address == 0x60008904) clock=value
    else if (address == 0x600084DC) selector=value
    else if (address == 0x60008064) level=value
    else bad=true
    writes=writes+1; return
}
trusted fun esp32S3RtcWakeUpdate(address: int,mask: int,value: int): void {
    esp32S3RtcWakeWrite(address,(esp32S3RtcWakeRead(address) & ~mask) | (value & mask)); return
}
@export("abla_rtc_ext0_record_test")
trusted fun ext0Test(): i32 {
    val record=nativeBufferAt(4096,32)
    var p=0
    while (p < 88) {
        val pin=p%22
        val polarity=(p/22)%2
        val original=if (p < 44) 0xFFFFFFFF else 0
        mmioStoreU32(memory,0)
        var n=0
        while (n < 22) { mmioStoreU32(memory+32+n*4,original); n=n+1 }
        holds=0; clock=123; selector=0xA0000003; level=0x80000000; usb=0; writes=0; bad=false
        if (!esp32S3Ext0RecordPrepareOwned(record,pin,polarity) || bad) return i32(1)
        val count=writes
        holds=1<<pin
        if (esp32S3Ext0RecordRestoreOwned(record) || writes != count) return i32(2)
        holds=0; selector=selector ^ (1<<27)
        if (esp32S3Ext0RecordRestoreOwned(record) || writes != count) return i32(3)
        selector=selector ^ (1<<27)
        if (!esp32S3Ext0RecordRestoreOwned(record) || bad || clock != 123 || selector != 0xA0000003 || level != 0x80000000 || mmioLoadU32(memory) != 0) return i32(4)
        n=0
        while (n < 22) { if (mmioLoadU32(memory+32+n*4) != original) return i32(5); n=n+1 }
        writes=0; holds=1<<pin
        if (esp32S3Ext0RecordPrepareOwned(record,pin,polarity) || writes != 0) return i32(6)
        p=p+1
    }
    holds=0; usb=16384; writes=0
    if (esp32S3Ext0RecordPrepareOwned(record,19,0) || esp32S3Ext0RecordPrepareOwned(record,20,1) || writes != 0) return i32(7)
    i32(0)
}
