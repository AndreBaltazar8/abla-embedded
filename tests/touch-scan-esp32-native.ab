import "../src/esp32/touch/scan_esp32_sequence.ab"
import "../src/esp32/touch/filter_esp32_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var ctrl=u32(0)
var work=u32(0)
var timer=u32(0)
var irq=u32(0)
var reads=0
var writes=0
var bad=false
var complete=false
var base=u32(0)
var dropStart=false
fun touchScanRead(address: int): u32 {
    reads=reads+1
    if (address == 0x3FF48884) return if (complete) ctrl|u32(1024) else ctrl&u32(0xFFFFFBFF)
    if (address == 0x3FF4888C) return work
    if (address == 0x3FF48018) return timer
    if (address == 0x3FF4803C) return irq
    if (address >= 0x3FF48870 && address <= 0x3FF48880 && (address&3) == 0) {
        val pair=(address-0x3FF48870)/4
        return u32(((pair*2)<<16)|(pair*2+1))
    }
    bad=true; u32(0)
}
fun touchScanWrite(address: int,value: u32): void {
    if (address != 0x3FF48884 || writes > 1 || value != (if (writes == 0) base|u32(4096) else base)) bad=true
    if (!(writes == 0 && dropStart)) { ctrl=value; complete=false }
    writes=writes+1; return
}
@export("abla_touch_scan_esp32_test")
fun scanTest(): i32 {
    var mask=1
    while (mask <= 1023) {
        var mode=0
        while (mode < 8) {
            ctrl=u32(0xCAAAA800)
            work=u32((mask&255)|((mask>>8 & 1)<<9)|((mask>>9 & 1)<<8))
            timer=u32(0); irq=u32(0); reads=0; writes=0; bad=false; complete=true; dropStart=mode == 7
            if (mode == 1) ctrl=ctrl|u32(4096)
            if (mode == 2) ctrl=ctrl&u32(0xFFFFDFFF)
            if (mode == 3) ctrl=ctrl&u32(0xFFFFF7FF)
            if (mode == 4) work=work^u32(1)
            if (mode == 5) timer=u32(0x800000)
            if (mode == 6) irq=u32(64)
            base=ctrl&u32(0xBFFFFBFF)
            var scan=esp32TouchScanBeginOwned(mask,true)
            if (bad || scan.status() != (if (mode == 0) 1 else 3) || writes != (if (mode == 0 || mode == 7) 2 else 0)) return i32(1)
            if (mode == 0) {
                if (scan.channels() != mask || scan.pollOwned().status() != 1 || scan.readRawOwned(4) != -1) return i32(2)
                complete=true; scan=scan.pollOwned()
                if (scan.status() != 2 || scan.channels() != mask) return i32(3)
                var channel=-1
                while (channel <= 10) {
                    val count=reads
                    val value=scan.readRawOwned(channel)
                    val valid=channel >= 0 && channel <= 9 && (mask&(1<<channel)) != 0
                    val expected=if (channel == 8) 9 else if (channel == 9) 8 else channel
                    if (value != (if (valid) expected else -1) || reads != count+(if (valid) 1 else 0)) return i32(4)
                    val filtered=CapacitiveTouchFilter(0).updateFrom(scan,channel,5,true)
                    if (filtered.accepted() != valid || (valid && (filtered.value() != expected || filtered.active() != (expected < 5)))) return i32(8)
                    channel=channel+1
                }
                val count=reads
                if (scan.pollOwned() != scan || reads != count) return i32(5)
                if (CapacitiveTouchFilter(65536).updateFrom(scan,4,-1).accepted() || reads != count) return i32(9)
            }
            if (bad) return i32(6)
            mode=mode+1
        }
        mask=mask+1
    }
    reads=0; writes=0
    if (esp32TouchScanBeginOwned(0,true).status() != 0 || esp32TouchScanBeginOwned(1024,true).status() != 0 ||
        esp32TouchScanBeginOwned(1,false).status() != 0 || Esp32TouchScan(8192).readRawOwned(0) != -1 || reads != 0 || writes != 0) return i32(7)
    i32(0)
}
