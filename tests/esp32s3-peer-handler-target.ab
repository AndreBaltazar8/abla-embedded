import "../src/esp32/peer_handler_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_peer_handler_target")
trusted fun handlerTarget(table: NativeBuffer,previous: NativeBuffer,context: NativeBuffer,mailbox: NativeBuffer,channel: int,line: int,remove: bool): bool {
    if (remove) return esp32S3PeerHandlerRemoveOwned(table,previous,context,line)
    esp32S3PeerHandlerInstallOwned(table,previous,context,mailbox,channel,line)
}
