import "./pm1-control-wire-native.ab"
import "../src/m5stack/pmic_temperature.ab"
@export("abla_pmic_temperature_wire_test")
trusted fun testTemperature(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    if (!device.valid()) return i32(1)
    val registers=nativeBufferAt(chargeRegisters,256)
    val a=Axp192(device|0);val b=Axp2101(device|0)
    val ownerA=M5PmicOpen((device|0)|(2<<32)|(1<<40));val ownerB=M5PmicOpen((device|0)|(3<<32)|(1<<40))
    var field=0
    while (field < 6) {
        val address=if (field == 0) 94 else if (field == 1) 86 else if (field == 2) 126 else if (field == 3) 60 else if (field == 4) 54 else 58
        var sample=0
        while (sample < 8) {
            val raw=if (field < 3) (if (sample == 0) 0 else if (sample == 1) 1 else if (sample == 2) 1446 else if (sample == 3) 1447 else if (sample == 4) 1448 else if (sample == 5) 2048 else if (sample == 6) 4094 else 4095)
                else (if (sample == 0) 0 else if (sample == 1) 1 else if (sample == 2) 7274 else if (sample == 3) 7714 else if (sample == 4) 16350 else if (sample == 5) 16351 else if (sample == 6) 16383 else if (field == 3) 65535 else 1001)
            registers.store(address,if (field < 3) raw>>>4 else raw>>>8)
            registers.store(address+1,if (field < 3) (raw&15)|240 else raw&255)
            val expected=if (field == 0) raw*100-144700 else if (field == 1) raw*17/10 else if (field == 2) raw*14/10 else if (field == 3) 22000+(7274-raw)*50 else if (field == 4) raw/2 else raw
            var fault=0
            while (fault <= 3) {
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                val result=if (field == 0) ownerA.readInternalTemperatureMilliCelsiusOwned(true)
                    else if (field == 1) a.acinMillivoltsChecked() else if (field == 2) a.apsMillivoltsChecked()
                    else if (field == 3) ownerB.readInternalTemperatureMilliCelsiusOwned(true)
                    else if (field == 4) b.tsMillivoltsChecked() else b.apsMillivoltsChecked()
                val valid=fault == 0 && (field < 4 || raw < 16351)
                if (result.valid() != valid || (valid && result.value() != expected) || ackCount-before != (if (fault == 0) 3 else fault) || bad) return i32(2)
                fault=fault+1
            }
            sample=sample+1
        }
        field=field+1
    }
    nackAt=0;val before=ackCount
    var kind=0
    while (kind < 8) {
        if (kind != 2 && kind != 3 && M5PmicOpen((device|0)|(kind<<32)|(1<<40)).readInternalTemperatureMilliCelsiusOwned(true).valid()) return i32(3)
        kind=kind+1
    }
    if (ownerA.readInternalTemperatureMilliCelsiusOwned(false).valid() || M5PmicOpen(0).readInternalTemperatureMilliCelsiusOwned(true).valid() || ackCount != before) return i32(4)
    var raw=0
    while (raw < 65536) {
        val sample=I2cWordResult(65536|raw)
        val temperature=axp192TemperatureMilliCelsiusChecked(sample)
        if (temperature.valid() != (raw <= 4095) || (temperature.valid() && temperature.value() != raw*100-144700) || axp2101TemperatureMilliCelsiusChecked(sample).value() != 385700-raw*50) return i32(5)
        raw=raw+1
    }
    if (axp192TemperatureMilliCelsiusChecked(I2cWordResult(0)).valid() || axp2101TemperatureMilliCelsiusChecked(I2cWordResult(0)).valid()) return i32(6)
    return i32(0)
}
