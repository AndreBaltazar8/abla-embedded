import "../src/audio/pcm_source_queue.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(1024)
@export("abla_pcm_source_queue_test")
trusted fun test(): i32 {
    val channel=pcmChannelAt(nativeBufferAt(memory,32),8000)
    var tone=pcmToneAt(nativeBufferAt(memory+32,40),8000,500000,1)
    val queue=pcmSourceQueueAt(nativeBufferAt(memory+80,32),8000)
    val samples=nativeBufferAt(memory+112,4);samples.storeU16(0,1000);samples.storeU16(2,2000)
    val wav=pcmRaw(samples,nativeBufferAt(memory+120,20),8000,1,16)
    val output=nativeBufferAt(memory+160,128)
    val reference=nativeBufferAt(memory+320,128)
    val refTone=pcmToneAt(nativeBufferAt(memory+480,40),8000,500000,1)
    if (!refTone.render(8,reference,true) || !channel.enqueue(wav,2) || !channel.enqueue(wav,1) ||
        !queue.enqueue(pcmPlaybackChannel(channel)) || !queue.enqueue(pcmPlaybackTone(tone)) ||
        queue.enqueue(pcmPlaybackTone(refTone)) || !queue.render(16,output)) return i32(1)
    var index=0
    while (index < 6) {
        if (output.loadU16(index*4) != (if ((index&1) == 0) 1000 else 2000)) return i32(2)
        index=index+1
    }
    index=0
    while (index < 8) {
        if (output.loadU32((index+6)*4) != reference.loadU32(index*4)) return i32(3)
        index=index+1
    }
    if (queue.source(0) != 0 || tone.playing() || output.loadU32(56) != 0 || output.loadU32(60) != 0) return i32(4)
    tone=pcmToneAt(tone.storage(),8000,500000,1)
    if (!channel.enqueue(wav) || !queue.enqueue(pcmPlaybackTone(tone)) ||
        !queue.enqueue(pcmPlaybackChannel(channel)) || !queue.render(8,output) ||
        queue.source(0).kind() != 1 || channel.storage().loadU32(16) != 0 ||
        !queue.render(2,output) || output.loadU16(0) != 1000 || output.loadU16(4) != 2000 ||
        queue.source(0) != 0) return i32(5)
    // Malformed pending source must not advance the valid current source.
    tone=pcmToneAt(tone.storage(),8000,500000,1)
    if (!channel.enqueue(wav) || !queue.enqueue(pcmPlaybackChannel(channel)) ||
        !queue.enqueue(pcmPlaybackTone(tone))) return i32(6)
    tone.storage().storeU32(0,0);output.storeU32(0,12345)
    if (queue.render(4,output) || channel.storage().loadU32(16) != 0 || output.loadU32(0) != 12345) return i32(7)
    tone=pcmToneAt(tone.storage(),8000,500000,1)
    if (queue.render(4,queue.storage()) || queue.render(1,samples) ||
        queue.render(1,tone.storage()) || channel.storage().loadU32(16) != 0 ||
        !queue.stop() || channel.isPlaying() != 1 || !tone.playing()) return i32(8)
    // Replacement drops references, retaining the old source's phase.
    if (!queue.enqueue(pcmPlaybackChannel(channel)) || queue.enqueue(pcmPlaybackChannel(channel)) ||
        !queue.enqueue(pcmPlaybackTone(tone),true) || !queue.render(1,output) ||
        channel.storage().loadU32(16) != 0 || !queue.stop()) return i32(9)
    // Endless playback holds the pending source, without advancing it.
    channel.stop();tone=pcmToneAt(tone.storage(),8000,500000,1)
    if (!channel.enqueue(wav,0) || !queue.enqueue(pcmPlaybackChannel(channel)) ||
        !queue.enqueue(pcmPlaybackTone(tone)) || !queue.render(32,output) ||
        queue.source(0).kind() != 1 || tone.storage().loadU32(12) != 0 || !queue.stop()) return i32(10)
    channel.stop()
    // Empty sources are consumed without leaving a gap before the tone.
    if (!queue.enqueue(pcmPlaybackChannel(channel)) || !queue.enqueue(pcmPlaybackTone(tone)) ||
        !queue.render(16,output) || output.loadU32(0) != reference.loadU32(0) ||
        output.loadU32(32) != 0 || !queue.stop()) return i32(11)
    tone=pcmToneAt(tone.storage(),16000,500000,1)
    if (queue.enqueue(pcmPlaybackTone(tone))) return i32(12)
    // Custom waveform is borrowed immutable data, including during preflight.
    tone=pcmToneWaveAt(tone.storage(),samples,false,8000,500000,1)
    if (!queue.enqueue(pcmPlaybackTone(tone)) || queue.render(1,samples) ||
        tone.storage().loadU32(12) != 0 || !queue.render(8,output)) return i32(13)
    // Non-integral tone phase and source handoff must be block-size independent.
    tone=pcmToneAt(tone.storage(),8000,440123,2)
    if (!channel.enqueue(wav,3) || !queue.enqueue(pcmPlaybackChannel(channel)) ||
        !queue.enqueue(pcmPlaybackTone(tone)) || !queue.render(32,reference)) return i32(14)
    tone=pcmToneAt(tone.storage(),8000,440123,2)
    if (!channel.enqueue(wav,3) || !queue.enqueue(pcmPlaybackChannel(channel)) ||
        !queue.enqueue(pcmPlaybackTone(tone)) || !queue.render(0,output) ||
        channel.storage().loadU32(16) != 0) return i32(15)
    index=0
    while (index < 32) {
        val count=if (32-index < 3) 32-index else 3
        if (!queue.render(count,nativeBufferAt(output.addressValue()+index*4,count*4))) return i32(16)
        index=index+count
    }
    index=0
    while (index < 32) {
        if (output.loadU32(index*4) != reference.loadU32(index*4)) return i32(17)
        index=index+1
    }
    if (queue.source(0) != 0 || !queue.valid()) return i32(18)
    return i32(0)
}
