import "../src/checksum/sum8.ab"
fun main(): int {
    var sum = 0
    var byte = 0
    while (byte < 256) {
        var previous = 0
        while (previous < 256) {
            if (checksum8Add(previous, byte) != (previous + byte) % 256) return 1
            previous = previous + 1
        }
        if (checksum8Add(byte, checksum8Complement(byte)) != 0) return 2
        sum = checksum8Add(sum, byte)
        byte = byte + 1
    }
    if (sum != 128 || checksum8Complement(0) != 0 || checksum8Complement(255) != 1) return 3
    if (checksum8Add(9223372036854775807, 9223372036854775807) != 254 ||
        checksum8Add(-1, 1) != 0 || checksum8Complement(-1) != 1) return 4
    0
}
