import "../src/esp32/i2c/guarded_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(32)
var outcome=1
var called=0
var bad=false
var stolen=false
trusted fun c5I2cGuardedTransfer(port: int,address: int,output: NativeBuffer,written: int,
    input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    called=called+1
    if (port != 0 || address != 110 || written != 4 || read != 4 || budget != u32(1000) || prefix != 34 ||
        output.addressValue() != storage+8 || input.addressValue() != storage+16 ||
        atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(7)) bad=true
    if (stolen) nativeAddressStoreU32(storage,0,9)
    outcome
}
@export("abla_c5_i2c_guarded_test")
trusted fun guardedTest(): i32 {
    val gate=peripheralGateAt(storage)
    val output=nativeBufferAt(storage+8,4)
    val input=nativeBufferAt(storage+16,4)
    var profile=0
    while (profile < 80) {
        outcome=profile%8+1
        val state=(profile/8)%5
        stolen=profile >= 40
        val initial=if (state == 0) u32(0) else if (state == 1) u32(9) else if (state == 2) u32(0x80000000) else if (state == 3) u32(0x80000009) else u32(7)
        nativeAddressStoreU32(storage,0,int(initial))
        called=0; bad=false
        val result=esp32C5I2cTransferGuardedOwned(gate,u32(7),0,110,output,4,input,4,u32(1000),34)
        val expected=if (state == 2 || state == 3) 10 else if (state != 0) 9 else if (stolen) 11 else outcome
        val finalState=if (state != 0) initial else if (stolen) u32(9) else if (outcome == 1) u32(0) else u32(0x80000000)
        if (result != expected || gate.word().compareExchange(u32(0),u32(0)) != finalState || called != (if (state == 0) 1 else 0) || bad) return i32(1)
        profile=profile+1
    }
    nativeAddressStoreU32(storage,0,0); called=0
    if (esp32C5I2cTransferGuardedOwned(gate,u32(0),0,110,output,4,input,4,u32(1000)) != 7 ||
        esp32C5I2cTransferGuardedOwned(gate,u32(7),0,110,nativeBufferAt(storage,4),4,input,4,u32(1000)) != 7 ||
        esp32C5I2cTransferGuardedOwned(gate,u32(7),0,110,output,4,nativeBufferAt(storage+3,4),4,u32(1000)) != 7 ||
        esp32C5I2cTransferGuardedOwned(gate,u32(7),0,110,output,4,input,4,u32(1000),256) != 7 ||
        called != 0 || gate.word().compareExchange(u32(0),u32(0)) != u32(0)) return i32(2)
    i32(0)
}
