// Mutation checks against a real emitted window vector object; no rebuild.
//
//     tools/abla-tool tests/window-vectors.ab OBJECT.o

import "abla/io"
import "abla/process/arguments"
import "../tools/check-window-vectors.ab"
import "../tools/lib/xtensa-check.ab"
import "../tools/lib/elf.ab"

fun main: int {
    if (processArgumentCount() != 1) {
        eprintln("usage: window-vectors OBJECT.o")
        return 2
    }
    val file = readBinaryFile(processArgument(0))
    if (file.error != "") {
        eprintln(file.error)
        return 1
    }
    val data = file.data
    val verdict = checkWindowVectors(data)
    if (verdict != "") {
        println("FAIL window vectors rejected: $verdict")
        return 1
    }
    val elf = elf32Parse(data)
    val index = elf.uniqueSection(".iram1.abla.s3WindowVectors")
    if (index < 0) {
        println("FAIL missing window vector section")
        return 1
    }
    val offset = elf.sections[index].offset
    // Alter saved/loaded registers, base pointers, displacements and returns in
    // each hardware slot, plus the MOVSP window-base field and branch targets.
    val positions: array<int> = []
    val masks: array<int> = []
    for (slot in [0, 0x40, 0x80, 0xc0, 0x100, 0x140]) {
        for (delta in [0, 1, 1, 2]) {
            positions.append(slot + delta)
        }
        for (mask in [0x10, 1, 0x10, 1]) {
            masks.append(mask)
        }
    }
    for (pc in [0x59, 0x6e, 0x74, 0x7a, 0xc, 0x4c, 0x9b, 0xdb, 0x127, 0x167]) {
        positions.append(pc)
        masks.append(1)
    }
    var failures = 0
    var index2 = 0
    while (index2 < positions.size) {
        val at = offset + positions[index2]
        val damaged = elfWithByte(data, at, data[at] ^ masks[index2])
        if (checkWindowVectors(damaged) == "") {
            println("FAIL accepted damaged vector at ${positions[index2]}, xor ${masks[index2]}")
            failures = failures + 1
        }
        index2 = index2 + 1
    }
    if (failures != 0) return 1
    println("PASS: rejected ${positions.size} emitted window-vector corruptions")
    0
}
