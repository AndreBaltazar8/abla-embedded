import "../src/esp32/uart/serial_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var count = 0
var reads = 0
var writes = 0
var byte = -1
var releaseAfter = -1
fun esp32S3SerialReadStatus(): int {
    val before = reads
    reads = reads + 1
    ((if (releaseAfter >= 0 && before >= releaseAfter) 0 else count) << 16) | 65535
}
fun esp32S3SerialWriteFifo(value: int): void { writes = writes + 1; byte = value; return }
@export("abla_serial_s3_test")
trusted fun serialS3Test(): i32 {
    while (count < 1024) {
        reads = 0; writes = 0
        val result = serial().tryWriteByte(511,3)
        if (result != (count < 128)) return i32(1)
        if (reads != (if (count < 128) 1 else 3) || writes != (if (count < 128) 1 else 0)) return i32(2)
        if (result && byte != 255) return i32(3)
        count = count + 1
    }
    count = 128
    releaseAfter = 0
    while (releaseAfter <= 5) {
        reads = 0; writes = 0
        if (serial().tryWriteByte(-1,5) != (releaseAfter < 5)) return i32(4)
        if (reads != (if (releaseAfter < 5) releaseAfter+1 else 5)) return i32(5)
        releaseAfter = releaseAfter + 1
    }
    reads = 0; writes = 0
    if (serial(1).tryWriteByte(1) || serial().tryWriteByte(1,0) ||
        serial().tryWriteByte(1,1000001) || reads != 0 || writes != 0) return i32(6)
    i32(0)
}
