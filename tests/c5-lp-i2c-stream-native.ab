import "../src/esp32/i2c/lp_stream_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(256)
var totalWrite=0
var totalRead=0
var prefix=-1
var writeOffset=0
var readOffset=0
var batch=0
var failure=0
var failureCode=3
var bad=false
var statusReads=0
var counterReads=0
fun esp32C5LpI2cControllerAddress(port: int): int = if (port == 0) 0x600B1800 else 0
fun esp32C5LpI2cTxCount(status: u32): int = int((status>>>u32(18))&u32(31))
fun esp32C5LpI2cRxCount(status: u32): int = int((status>>>u32(8))&u32(31))
fun c5LpI2cStreamLoad(address: int): int {
    if (address != 0x600B1808 || batch != 0) bad=true
    statusReads=statusReads+1
    return 0
}
fun esp32C5LpI2cReadCounter(): u32 {
    if (batch != 0) bad=true
    counterReads=counterReads+1
    u32(0xFFFFFFF0)
}
trusted fun esp32C5LpI2cStreamChunkOwned(port: int,address: int,data: NativeBuffer,count: int,
    reading: bool,first: bool,finish: bool,continued: bool,started: u32,budget: u32,registerPrefix: int = -1): int {
    val writePhase=writeOffset < totalWrite || batch == 0 && (totalRead == 0 || prefix >= 0)
    val expectedReading= !writePhase
    val expectedFirst=if (expectedReading) readOffset == 0 else batch == 0
    val capacity=if (expectedReading || !expectedFirst) 16 else if (prefix >= 0) 14 else 15
    val remaining=if (expectedReading) totalRead-readOffset else totalWrite-writeOffset
    val expectedCount=if (remaining < capacity) remaining else capacity
    val expectedFinish=if (expectedReading) readOffset+expectedCount == totalRead else writeOffset+expectedCount == totalWrite && totalRead == 0
    val expectedAddress=storage+(if (expectedReading) 128+readOffset else writeOffset)
    if (port != 0 || address != 110 || reading != expectedReading || first != expectedFirst ||
        finish != expectedFinish || continued != (batch != 0) || count != expectedCount ||
        data.addressValue() != expectedAddress || !data.hasAddressRange(0,count) ||
        started != u32(0xFFFFFFF0) || budget != u32(1000) ||
        registerPrefix != (if (!expectedReading && expectedFirst) prefix else -1)) bad=true
    batch=batch+1
    if (batch == failure) return failureCode
    if (reading) readOffset=readOffset+count else writeOffset=writeOffset+count
    if (finish) 1 else 2
}
fun length(index: int): int = if (index == 0) 0 else if (index == 1) 1 else if (index == 2) 14 else if (index == 3) 15 else if (index == 4) 16 else if (index == 5) 17 else if (index == 6) 31 else if (index == 7) 32 else if (index == 8) 33 else if (index == 9) 48 else 49
@export("abla_c5_lp_i2c_stream_test")
trusted fun streamTest(): i32 {
    var plan=0
    while (plan < 152) {
        val count=plan%19-1
        val mode=plan/19
        val reading=(mode&1) != 0
        val first=(mode&2) != 0
        val finish=(mode&4) != 0
        val valid=if (reading) count >= 1 && count <= 16 else count >= (if (first) 0 else 1) && count <= (if (first) 15 else 16)
        val last=esp32C5LpI2cStreamLast(reading,first,finish,count)
        if ((last >= 0) != valid) return i32(3)
        if (valid) {
            var tx=0; var rx=0; var nack=0; var starts=0; var i=0
            while (i <= last) {
                val command=int(esp32C5LpI2cStreamCommand(reading,first,finish,count,i))
                val op=(command>>>11)&7
                if (i == last && op != (if (finish) 2 else 4)) return i32(4)
                if (i < last && (op == 2 || op == 4)) return i32(5)
                if (op == 1) tx=tx+(command&255)
                if (op == 3) { rx=rx+(command&255); if ((command&1024) != 0) nack=nack+1 }
                if (op == 6) starts=starts+1
                i=i+1
            }
            if (tx != (if (reading) (if (first) 1 else 0) else count+(if (first) 1 else 0)) ||
                rx != (if (reading) count else 0) || starts != (if (first) 1 else 0) ||
                nack != (if (reading && finish) 1 else 0) || tx > 16 || rx > 16) return i32(6)
        }
        plan=plan+1
    }
    var profile=0
    while (profile < 13068) {
        totalWrite=length(profile%11); totalRead=length((profile/11)%11)
        prefix=if (((profile/121)&1) == 0) -1 else 255
        failure=(profile/242)%9
        failureCode=profile/2178+3
        writeOffset=0; readOffset=0; batch=0; bad=false; statusReads=0; counterReads=0
        val result=esp32C5LpI2cTransferOwned(0,110,nativeBufferAt(storage,128),totalWrite,
            nativeBufferAt(storage+128,128),totalRead,u32(1000),prefix)
        val failed=failure > 0 && batch == failure
        if (result != (if (failed) failureCode else 1) || bad || statusReads != 1 || counterReads != 1 ||
            (!failed && (writeOffset != totalWrite || readOffset != totalRead))) return i32(1)
        profile=profile+1
    }
    statusReads=0; counterReads=0; batch=0
    if (esp32C5LpI2cTransferOwned(0,110,nativeBufferAt(storage,1),2,nativeBufferAt(storage+128,1),0,u32(1000)) != 7 ||
        esp32C5LpI2cTransferOwned(0,110,nativeBufferAt(storage,1),0,nativeBufferAt(storage+128,1),0,u32(1000),256) != 7 ||
        statusReads != 0 || counterReads != 0 || batch != 0) return i32(2)
    i32(0)
}
