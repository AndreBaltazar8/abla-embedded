import "../src/m5stack/battery_adc_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_battery_adc_s3_test")
fun test(): i32 {
    val cal=Esp32S3AdcCalibration(268435456|(3<<26)|(3000<<12)|2000)
    val paper=Esp32S3Adc1Session((1<<57)|(2000<<42)|(2<<8)|(3<<12))
    val capsule=Esp32S3Adc1Session((1<<57)|(2000<<42)|(5<<8)|(3<<12))
    val card=Esp32S3Adc1Session((1<<57)|(2000<<42)|(9<<8)|(3<<12))
    val expected=cal.millivolts(2000)*2
    if (expected <= 0 || paper.batteryMillivoltsS3(m5BoardPaperS3,cal) != expected || capsule.batteryMillivoltsS3(m5BoardCapsule,cal) != expected) return i32(1)
    if (card.batteryMillivoltsS3(m5BoardCardputer,cal) != expected || card.batteryMillivoltsS3(m5BoardCardputerADV,cal) != expected || card.batteryMillivoltsS3(m5BoardDinMeter,cal) != expected) return i32(2)
    if (paper.batteryMillivoltsS3(m5BoardCapsule,cal) != -1 || card.batteryMillivoltsS3(m5BoardAirQ,cal) != -1 || card.batteryMillivoltsS3(m5BoardPaper,cal) != -1) return i32(3)
    if (Esp32S3Adc1Session(0).batteryMillivoltsS3(m5BoardPaperS3,cal) != -1 || paper.batteryMillivoltsS3(m5BoardPaperS3,Esp32S3AdcCalibration(3)) != -1) return i32(4)
    // Invalid open paths must return before any physical MMIO/ROM access.
    if (m5BoardAirQ.openBatteryAdcS3Owned(cal,true,true,3).status() != 2 || m5BoardPaper.openBatteryAdcS3Owned(cal,true,true,3).status() != 2) return i32(5)
    if (m5BoardPaperS3.openBatteryAdcS3Owned(Esp32S3AdcCalibration(cal.bits()|(1<<25)),true,true,3).status() != 2 || m5BoardPaperS3.openBatteryAdcS3Owned(Esp32S3AdcCalibration(cal.bits()^(3<<26)),true,true,3).status() != 2) return i32(6)
    return i32(0)
}
