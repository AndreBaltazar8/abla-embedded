import "../src/esp32/power/sleep_cached_p4_sequence.ab"
val cachedCycleMemory=nativeStaticAllocate(292)
fun seedCachedCycle(hart: int,encrypted: bool): NativeBuffer {
    seedRetainedCycle(encrypted);seedL2(3)
    lightCachedCycle=true;l2FlashShared=true;flashControl=u32(0x01234561)
    entry3Register=seedFlashGraphEngine(0,true,true)
    predictorHart=u32(hart);predictorCsr=u32(0x1030);predictorWrites=0;predictorDrop=0
    val r=nativeBufferAt(cachedCycleMemory,292)
    var i=0
    while (i < 288) { r.storeU32(i,0);i=i+4 }
    r.storeU32(288,0x1234abcd);return r
}
fun sleepCachedChecks(): int {
    var mode=0
    while (mode < 96) {
        val hart=mode&1
        val r=seedCachedCycle(hart,(mode&2) != 0)
        val profile=mode>>>2
        entry3Register=seedFlashGraphEngine((profile>>>2)-1,(profile&1) != 0,(profile&2) != 0)
        if (entry3Register == 0) return 183
        if (esp32p4SleepCachedBeginOwned(r,300,400,false,2,2,true) != 7 || predictorCsr != u32(0) ||
            (l2Auto&u32(1)) != u32(0) || (flashControl&u32(0x80000000)) == u32(0) || extraStarts != 1 || lightRequests != 0) return 170
        predictorHart=u32(1-hart);val before=l2Writes+retentionWrites+predictorWrites+mpllWrites
        if (esp32p4SleepCachedContinueOwned(r,2,2,true) != 4 || before != l2Writes+retentionWrites+predictorWrites+mpllWrites) return 171
        predictorHart=u32(hart);extraRaw=u32(1)
        if (esp32p4SleepCachedContinueOwned(r,2,2,true) != 7 || extraStarts != 2 || lightRequests != 1 || lightCommands != 8 || predictorCsr != u32(0)) return 172
        // Actual emitted descriptors restored FCTRL and all148 saved words.
        // Only interrupt timing is injected; no manual register restoration.
        if ((flashControl&u32(0x80000000)) == u32(0) || flashGraphTransfers != 2 || flashGraphCopied != 296 || flashGraphBad) return 182
        extraRaw=u32(1)
        l2Drop=l2Writes+2
        if (esp32p4SleepCachedContinueOwned(r,2,2,true) != 9 || r.loadU32(4) != 5 || predictorCsr != u32(0) ||
            !sleepMemoryOriginal() || (flashControl&u32(0x80000000)) != u32(0)) return 173
        l2Drop=0;predictorDrop=predictorWrites+2
        if (esp32p4SleepCachedContinueOwned(r,2,2,true) != 9 || r.loadU32(4) != 6 || (l2Auto&u32(1)) != u32(1) || predictorCsr != u32(0)) return 174
        predictorDrop=0
        if (esp32p4SleepCachedContinueOwned(r,2,2,true) != 1 || predictorCsr != u32(0x1030) || flashControl != u32(0x01234561) ||
            extraStarts != 2 || lightRequests != 1 || l2Pulses != 1 || l2Thaws != 1 || r.loadU32(288) != 0x1234abcd ||
            retentionBad || lightBad || l2Bad || flashBad || flashHoldBad || sleepMemoryBad || flashGraphBad) return 175
        val finalWrites=l2Writes+retentionWrites+predictorWrites+mpllWrites
        if (esp32p4SleepCachedContinueOwned(r,2,2,true) != 1 || finalWrites != l2Writes+retentionWrites+predictorWrites+mpllWrites) return 176
        mode=mode+1
    }
    val cache=seedCachedCycle(0,false);lightStuckPass=1
    if (esp32p4SleepCachedBeginOwned(cache,300,400,false,2,2,true) != 9 || esp32p4SleepCachedContinueOwned(cache,2,2,true) != 7 || predictorCsr != u32(0) || extraStarts != 0 || l2Writes != 0) return 177
    lightCache=u32(16)
    if (esp32p4SleepCachedContinueOwned(cache,2,2,true) != 10 || predictorCsr != u32(0x1030) || lightRequests != 0) return 178
    val frozen=seedCachedCycle(1,false);l2Stuck=8
    if (esp32p4SleepCachedBeginOwned(frozen,300,400,false,2,2,true) != 7 || extraStarts != 0 || predictorCsr != u32(0)) return 179
    l2Stuck=0
    if (esp32p4SleepCachedContinueOwned(frozen,2,2,true) != 7 || extraStarts != 1 || l2Pulses != 1) return 180
    extraRaw=u32(3)
    if (esp32p4SleepCachedContinueOwned(frozen,2,2,true) != 11 || predictorCsr != u32(0) || (l2Auto&u32(1)) != u32(0) || lightRequests != 0) return 181
    // Corrupt a real generated descriptor before backup or restore. The
    // interpreter reports an engine fault; neither a later DONE nor repairing
    // the descriptor permits releasing resources after an uncertain transfer.
    var phase=0
    while (phase < 2) {
        val damaged=seedCachedCycle(phase,false)
        if (phase == 1 && esp32p4SleepCachedBeginOwned(damaged,300,400,false,2,2,true) != 7) return 184
        val graph=nativeBufferAt(profileOutput,flashGraphBytes)
        val offset=entry3Register-profileOutput
        val original=graph.loadU32(offset)
        graph.storeU32(offset,(original&0xfff0ffff)|0x000f0000)
        if (phase == 1) extraRaw=u32(1)
        val result=if (phase == 0) esp32p4SleepCachedBeginOwned(damaged,300,400,false,2,2,true) else esp32p4SleepCachedContinueOwned(damaged,2,2,true)
        if (result != 11 || !flashGraphBad || predictorCsr != u32(0) || (l2Auto&u32(1)) != u32(0) ||
            lightRequests != phase || extraStarts != phase+1 || flashGraphTransfers != phase) return 185
        graph.storeU32(offset,original);extraRaw=u32(1)
        val heldWrites=l2Writes+retentionWrites+predictorWrites+mpllWrites
        if (esp32p4SleepCachedContinueOwned(damaged,2,2,true) != 11 || heldWrites != l2Writes+retentionWrites+predictorWrites+mpllWrites || extraStarts != phase+1) return 186
        phase=phase+1
    }
    flashGraphEngineEnabled=false;p4HoldModelShared=false;l2FlashShared=false;lightCachedCycle=false;lightRetainedCycle=false
    return 0
}
