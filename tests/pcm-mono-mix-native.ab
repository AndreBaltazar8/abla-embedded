import "../src/audio/pcm16_mix.ab"
import "abla/runtime/scalar"
import "abla/build"
val words=nativeStaticMutableU32s([100000,-80000,2147483647,-2147483648,-1,0,1,0,
    2147483647,2147483647,-2147483648,-2147483648,65534,0,-65536,0])
val full=nativeStaticU32s([10000,65535,65535,1,32767,32768,32767,32768])
val half=nativeStaticU32s([5000,0,0,0,32767,32768,16384,49152])
val outputMemory=nativeStaticAllocate(16)
@export("abla_pcm_mono_mix_test")
trusted fun test(): i32 {
    val accumulator=nativeBufferAt(words,64);val output=nativeBufferAt(outputMemory,16)
    var variant=0
    while (variant < 3) {
        val gain=if (variant == 0) 32768 else if (variant == 1) 16384 else 0
        if (!finishPcm16MixMono(accumulator,output,8,gain)) return i32(1)
        var i=0
        while (i < 8) {
            val expected=if (variant == 2) 0 else nativeAddressLoadU32(if (variant == 0) full else half,i*4)
            if (output.loadU16(i*2) != expected) return i32(2)
            i=i+1
        }
        variant=variant+1
    }
    output.storeU16(0,1234)
    if (finishPcm16MixMono(accumulator,nativeBufferAt(outputMemory,15),8) ||
        finishPcm16MixMono(nativeBufferAt(words,63),output,8) ||
        finishPcm16MixMono(accumulator,output,-1) || finishPcm16MixMono(accumulator,output,8,32769) ||
        finishPcm16MixMono(accumulator,nativeBufferAt(words+4,16),8) || output.loadU16(0) != 1234 || accumulator.loadU32(0) != 100000) return i32(3)
    return i32(0)
}
