import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/pmic_open.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pmic_open_target")
trusted fun pmicTarget(board: M5BoardId,bus: I2cBus,previous: M5PmicOpen,mode: int): int {
    if (mode == 0) return board.openPmic(bus) | 0
    if (mode == 1) return previous.release() | 0
    if (mode == 2) return previous.axpPower() | 0
    if (mode == 3) return previous.pm1() | 0
    if (mode == 4) return previous.ip5306() | 0
    previous.aw32001() | 0
}
