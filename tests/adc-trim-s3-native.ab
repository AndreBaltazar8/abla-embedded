import "../src/esp32/adc_trim_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var unit=1
var hi=0
var lo=0
var writes=0
var reads=0
var drop=0
var disturb=false
var bad=false
fun esp32S3AdcFuseRead(offset: int): int { bad=true; return 0 }
fun esp32S3SarAnalogRead(register: int): int {
    reads=reads+1
    if (register == (if (unit == 1) 1 else 4)) return if (disturb && reads >= 4) hi^16 else hi
    if (register == (if (unit == 1) 0 else 3)) return lo
    bad=true; return 0
}
fun esp32S3SarAnalogWrite(register: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (register == (if (unit == 1) 1 else 4)) hi=value else if (register == (if (unit == 1) 0 else 3)) lo=value else bad=true
    return
}
@export("abla_adc_trim_s3_test")
fun trimTest(): i32 {
    while (unit <= 2) {
        var code=0
        while (code <= 4095) {
            hi=0xa0; lo=0; writes=0; reads=0
            val calibration=Esp32S3AdcCalibration(268435456|((unit-1)<<25)|(1000<<12)|code)
            if (esp32S3AdcApplyTrimOwned(calibration) != 1 || hi != (160|(code>>8)) || lo != (code&255) || writes != 2 || bad) return i32(1)
            code=code+1
        }
        unit=unit+1
    }
    unit=1
    val calibration=Esp32S3AdcCalibration(268435456|(1000<<12)|0xabc)
    hi=0x50; lo=0; writes=0; reads=0; drop=1
    if (esp32S3AdcApplyTrimOwned(calibration) != 3 || writes != 1) return i32(2)
    hi=0x50; lo=0; writes=0; reads=0; drop=2
    if (esp32S3AdcApplyTrimOwned(calibration) != 4 || writes != 2 || hi != 0x5a) return i32(3)
    drop=0; writes=0; reads=0; disturb=true
    if (esp32S3AdcApplyTrimOwned(calibration) != 5) return i32(4)
    disturb=false; writes=0; reads=0
    if (esp32S3AdcApplyTrimOwned(calibration) != 1 || hi != 0x5a || lo != 0xbc || bad) return i32(5)
    writes=0; reads=0
    if (esp32S3AdcApplyTrimOwned(Esp32S3AdcCalibration(3)) != 2 || writes != 0 || reads != 0) return i32(6)
    return i32(0)
}
