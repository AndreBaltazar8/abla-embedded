import "../src/esp32/clock_state_s3.ab"
import "../src/esp32/pll_start_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var xtal=40
var mhz=480
var source=0
var power=0x540
var phase=0
var analog=0
var readyAfter=0
var reads=0
var delay=0
var bad=false
fun esp32S3ClockRead(address: int): int {
    if (address == 0x600080C0) return xtal | (xtal<<16)
    if (address == 0x600C0060) return source<<10
    if (address == 0x60008000) return power
    if (address == 0x6000E040) {
        if (phase != 4 || analog != 7) bad=true
        reads=reads+1
        return if (reads > readyAfter) 0x1000000 else 0
    }
    bad=true; 0
}
fun esp32S3ClockUpdate(address: int,mask: int,value: int): void {
    if (phase == 0) { if (address != 0x60008000 || mask != 0x540 || value != 0) bad=true; power=0 }
    else if (phase == 1) { if (address != 0x600C0010 || mask != 4 || value != (if (mhz == 480) 4 else 0)) bad=true }
    else if (phase == 2) { if (address != 0x6000E040 || mask != 4 || value != 0) bad=true }
    else if (phase == 3) { if (address != 0x6000E040 || mask != 8 || value != 8) bad=true }
    else if (phase == 4) { if (address != 0x6000E040 || mask != 8 || value != 0 || analog != 7) bad=true }
    else if (phase == 5) { if (address != 0x6000E040 || mask != 4 || value != 4) bad=true }
    else if (phase == 6) { if (address != 0x60008000 || mask != 0x540 || value != 0x540) bad=true; power=0x540 }
    else bad=true
    phase=phase+1; return
}
fun esp32S3PllAnalogWrite(register: int,msb: int,lsb: int,value: int): void {
    val special=xtal == 32 && mhz == 480
    val reg=if (analog == 0) 4 else if (analog == 1) 2 else if (analog == 2) 3 else if (analog < 5) 5 else if (analog == 5) 6 else 9
    val hi=if (analog == 3) 2 else if (analog == 4) 6 else if (analog == 6) 1 else 7
    val expected=if (analog == 0) (if (mhz == 480) 107 else 105)
        else if (analog == 1) (if (xtal == 40) 80 else if (special) 65 else 81)
        else if (analog == 2) (if (xtal == 40) (if (mhz == 480) 8 else 4) else (if (special) 26 else 6))
        else if (analog < 5) (if (special) 1 else 0)
        else if (analog == 5) (if (special) 112 else 115) else 3
    if (phase != 4 || register != reg || msb != hi || lsb != (if (analog == 4) 4 else 0) || value != expected) bad=true
    analog=analog+1; return
}
fun esp32S3ClockRomDelay(us: int): void { if (phase != 4 || us != 10 || reads <= readyAfter) bad=true; delay=delay+1; return }
@export("abla_pll_start_test")
trusted fun startTest(): i32 {
    xtal=32
    while (xtal <= 40) {
        mhz=320
        while (mhz <= 480) {
            readyAfter=0
            while (readyAfter < 10) {
                phase=0; analog=0; reads=0; delay=0; power=0x540; bad=false
                val result=esp32S3PllStartOwned(mhz,8)
                val success=readyAfter < 8
                if (bad || result != (if (success) 1 else 3) || phase != (if (success) 6 else 7) ||
                    power != (if (success) 0 else 0x540) || delay != (if (success) 1 else 0) || reads != (if (success) readyAfter+1 else 8)) return i32(1)
                readyAfter=readyAfter+1
            }
            mhz=mhz+160
        }
        xtal=xtal+8
    }
    xtal=40; phase=0; source=1; power=0x540
    if (esp32S3PllStartOwned(480,8) != 2 || phase != 0) return i32(2)
    source=0; power=0
    if (esp32S3PllStartOwned(480,8) != 2 || phase != 0) return i32(3)
    if (esp32S3PllStartOwned(400,8) != 0 || esp32S3PllStartOwned(480,0) != 0 || phase != 0) return i32(4)
    i32(0)
}
