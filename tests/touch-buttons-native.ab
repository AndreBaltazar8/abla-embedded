import "../src/m5stack/touch_buttons.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_touch_buttons_test")
fun touchButtonsTest(): i32 {
    var panel=0
    while (panel < 3) {
        val board=if (panel == 0) m5BoardToughC5 else if (panel == 1) m5BoardPaper else m5BoardTab5X
        val height=if (panel == 0) 240 else if (panel == 1) 960 else 1280
        val width=if (panel == 0) 320 else if (panel == 1) 540 else 720
        val factor=if (panel == 0) 614 else if (panel == 1) 364 else 273
        var ratio=0
        while (ratio <= 255) {
            if (board.touchButtonHeightByRatio(ratio) != height*ratio/255) return i32(1)
            val boundary=height-height*ratio/255
            if (board.accumulateTouchButtons(0,0,0,boundary-1,1,ratio) != 0 ||
                board.accumulateTouchButtons(0,0,0,boundary,1,ratio) != 1) return i32(2)
            ratio=ratio+1
        }
        var x=0
        while (x < width) {
            val bit=1 << ((x*factor)>>16)
            if (board.accumulateTouchButtons(0,0,x,height,1,0) != bit) return i32(3)
            x=x+1
        }
        var profile=0
        while (profile < 1024) {
            val state=profile%16
            val previous=profile/16%8
            val accumulated=profile/128
            val held=previous|accumulated
            val expected=if ((state&1) == 0) accumulated else if (held == 0 && (state&8) != 0) 0 else held|2
            if (board.accumulateTouchButtons(previous,accumulated,width/2,height,state,0) != expected) return i32(4)
            profile=profile+1
        }
        if (board.accumulateTouchButtons(7,0,-1,height,1,0) != 0 ||
            board.accumulateTouchButtons(7,0,width,height,1,0) != 0 || board.touchButtonHeightByRatio(256) != -1) return i32(5)
        panel=panel+1
    }
    if (m5BoardAtomEcho().touchButtonRawMask() != 0 || m5BoardAtomEcho().accumulateTouchButtons(7,0,0,240,1,255) != 0) return i32(6)
    i32(0)
}
