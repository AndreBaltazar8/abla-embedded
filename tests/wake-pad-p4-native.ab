import "../src/esp32/power/wake_pad_p4_sequence.ab"
var pin=0
var mux=u32(0)
var route=u32(0)
var enable=u32(0)
var changed=0
var fail=0
var held=false
var clocks=true
var bad=false
trusted fun p4GpioHoldRead(address: int): u32 = if (held) u32(0xffffffff) else u32(0)
trusted fun p4GpioHoldWrite(address: int,value: u32): void { bad=true;return }
trusted fun p4WakePadRead(address: int): u32 {
    if (address == 0x5012a000 || address == 0x5012b000) return if (clocks) u32(1) else u32(0)
    if (address == 0x500e6020) return u32(8)
    if (address == 0x5012a014) return enable
    if (address == 0x5012b008+pin*4) return mux
    if (address == 0x5012a0f4+pin*4) return route
    bad=true;return u32(0)
}
trusted fun p4WakePadWrite(address: int,value: u32): void {
    var wanted=value
    var old=u32(0)
    if (address == 0x5012a018 || address == 0x5012a01c) {
        if (value != (u32(1)<<u32(pin))) bad=true
        old=enable;wanted=if (address == 0x5012a018) enable|value else enable&~value
    } else old=p4WakePadRead(address)
    if (old != wanted) { changed=changed+1;if (changed == fail) return }
    if (address == 0x5012a018 || address == 0x5012a01c) enable=wanted
    else if (address == 0x5012b008+pin*4) mux=wanted
    else if (address == 0x5012a0f4+pin*4) route=wanted
    else bad=true
    return
}
trusted fun seed(): void {
    mux=u32(0xdead07ef);route=u32(0xabcd01ff);enable=u32(0xffffffff)
    changed=0;fail=0;held=false;clocks=true;bad=false;return
}
@export("abla_wake_pad_p4_test")
trusted fun test(): i32 {
    var layout=1
    while (layout <= 3) {
        pin=0
        while (pin < 16) {
            var pull=0
            while (pull < 3) {
                seed()
                val owner=esp32p4WakePadOpenOwned(pin,pull,layout,true)
                if (owner.status() != 1 || !owner.hasSnapshot() || bad ||
                    (mux&u32(2047)) != u32(1075+(if (pull == 1) 8 else if (pull == 2) 4 else 0)) ||
                    route != u32(0xabcd0102) || (enable&(u32(1)<<u32(pin))) != u32(0)) return i32(1)
                val openChanges=changed;changed=0
                if (owner.closeOwned(true).status() != 6 || mux != u32(0xdead07ef) || route != u32(0xabcd01ff) || enable != u32(0xffffffff) || bad) return i32(2)
                val closeChanges=changed
                var fault=1
                while (fault <= openChanges) {
                    seed();fail=fault
                    val partial=esp32p4WakePadOpenOwned(pin,pull,layout,true)
                    if (partial.status() != 5 || !partial.hasSnapshot() || changed != fault) return i32(3)
                    fail=0
                    if (partial.closeOwned(true).status() != 6 || mux != u32(0xdead07ef) || route != u32(0xabcd01ff) || enable != u32(0xffffffff) || bad) return i32(4)
                    fault=fault+1
                }
                fault=1
                while (fault <= closeChanges) {
                    seed();val ready=esp32p4WakePadOpenOwned(pin,pull,layout,true)
                    changed=0;fail=fault
                    val failed=ready.closeOwned(true)
                    if (failed.status() != 5 || changed != fault) return i32(5)
                    fail=0
                    if (failed.closeOwned(true).status() != 6 || mux != u32(0xdead07ef) || route != u32(0xabcd01ff) || enable != u32(0xffffffff) || bad) return i32(6)
                    fault=fault+1
                }
                pull=pull+1
            }
            pin=pin+1
        }
        layout=layout+2
    }
    seed();pin=0;held=true
    if (esp32p4WakePadOpenOwned(0,0,1,true).status() != 3 || changed != 0) return i32(7)
    held=false;clocks=false
    if (esp32p4WakePadOpenOwned(0,0,1,true).status() != 4 || changed != 0) return i32(8)
    if (esp32p4WakePadOpenOwned(16,0,1,true).status() != 2 || changed != 0) return i32(9)
    return i32(0)
}
