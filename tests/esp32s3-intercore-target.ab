import "../src/esp32/intercore_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_intercore_target")
@section(".iram1.abla.s3IntercoreTarget")
trusted fun intercoreTarget(channel: int,core: int,line: int): bool {
    val saved=esp32S3IntercoreRouteOwned(channel,core,line)
    if (!saved.valid()) return false
    esp32S3IntercoreSignalOwned(channel,true)
    esp32S3IntercoreSignalOwned(channel,false)
    esp32S3IntercoreRestoreOwned(saved)
}
