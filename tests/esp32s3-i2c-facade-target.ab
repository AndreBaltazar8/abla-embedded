import "../src/esp32/i2c_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_i2c_facade_test")
trusted fun facadeTargetTest(port: i32, sda: i32, scl: i32, xtal: u32, cpu: u32, address: i32): int {
    val bus = i2cMaster(int(port), int(sda), int(scl), xtal, cpu)
    if (!bus.valid()) return -1
    val result = bus.device(int(address)).readRegister8Checked(0)
    if (!result.valid()) {
        val recovered = bus.recover()
        val closedAfterFailure = bus.close()
        return -2
    }
    if (!bus.close()) return -3
    result.value()
}
