// Regression cases for the lower-static-byte-layouts pass: each expectation is what the original Python tool
// produced for the same fixture (see the commit message of the port).
import "abla/io"
import "abla/test"
import "abla/text"
import "../tools/lower-recovered-static-mutable-byte-layouts.ab"

val SRC_BYTES = "val esp32Data_f_1Storage = nativeStaticAllocate(16)\ntrusted fun esp32Data_f_1Initialize(): int {\n    ablaUnsafeStoreU8(nativePointerFromAddress(esp32Data_f_1Storage + 0), -1)\n    ablaUnsafeStoreU8(nativePointerFromAddress(esp32Data_f_1Storage + 1), 300)\n    ablaUnsafeStoreU16(nativePointerFromAddress(esp32Data_f_1Storage + 2), 65535)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_f_1Storage + 4), -2)\n    ablaUnsafeStoreU64(nativePointerFromAddress(esp32Data_f_1Storage + 8), 18446744073709551615)\n    esp32Data_f_1Storage\n}\nval esp32Data_f_1Initialized = esp32Data_f_1Initialize()\nval esp32Data_f_1 = u32(esp32Data_f_1Initialized)\nval esp32Data_g_1Storage = nativeStaticAllocate(8)\ntrusted fun esp32Data_g_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_g_1Storage + 0), 1)\n    ablaUnsafeStoreU16(nativePointerFromAddress(esp32Data_g_1Storage + 2), 2)\n    esp32Data_g_1Storage\n}\nval esp32Data_g_1Initialized = esp32Data_g_1Initialize()\nval esp32Data_g_1 = u32(esp32Data_g_1Initialized)\nval esp32Data_h_1Storage = nativeStaticAllocate(40)\ntrusted fun esp32Data_h_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_h_1Storage + 4), 3)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_h_1Storage + 0), 4)\n    esp32Data_h_1Storage\n}\nval esp32Data_h_1Initialized = esp32Data_h_1Initialize()\nval esp32Data_h_1 = u32(esp32Data_h_1Initialized)\nval esp32Data_i_1Storage = nativeStaticAllocate(4)\ntrusted fun esp32Data_i_1Initialize(): int {\n    ablaUnsafeStoreU16(nativePointerFromAddress(esp32Data_i_1Storage + 1), 3)\n    esp32Data_i_1Storage\n}\nval esp32Data_i_1Initialized = esp32Data_i_1Initialize()\nval esp32Data_i_1 = u32(esp32Data_i_1Initialized)\n"

fun main: int {
    expectEqual(layoutLowerSource(SRC_BYTES).text, "val esp32Data_f_1Storage = nativeStaticMutableBytes(\"\\xff\\x2c\\xff\\xff\\xfe\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xff\")\nval esp32Data_f_1Initialized = esp32Data_f_1Storage\nval esp32Data_f_1 = u32(esp32Data_f_1Initialized)\nval esp32Data_g_1Storage = nativeStaticAllocate(8)\ntrusted fun esp32Data_g_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_g_1Storage + 0), 1)\n    ablaUnsafeStoreU16(nativePointerFromAddress(esp32Data_g_1Storage + 2), 2)\n    esp32Data_g_1Storage\n}\nval esp32Data_g_1Initialized = esp32Data_g_1Initialize()\nval esp32Data_g_1 = u32(esp32Data_g_1Initialized)\nval esp32Data_h_1Storage = nativeStaticMutableBytes(\n    (\n        \"\\x04\\x00\\x00\\x00\\x03\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\" +\n        \"\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\"\n    )\n)\nval esp32Data_h_1Initialized = esp32Data_h_1Storage\nval esp32Data_h_1 = u32(esp32Data_h_1Initialized)\nval esp32Data_i_1Storage = nativeStaticAllocate(4)\ntrusted fun esp32Data_i_1Initialize(): int {\n    ablaUnsafeStoreU16(nativePointerFromAddress(esp32Data_i_1Storage + 1), 3)\n    esp32Data_i_1Storage\n}\nval esp32Data_i_1Initialized = esp32Data_i_1Initialize()\nval esp32Data_i_1 = u32(esp32Data_i_1Initialized)\n", "byte layouts")
    expectEqual(layoutLowerSource(SRC_BYTES).layouts, 2, "byte layouts count")
    if (testsPassed() != 0) return 1
    println("PASS: lower-static-byte-layouts matches the original Python tool on the fixtures")
    0
}
