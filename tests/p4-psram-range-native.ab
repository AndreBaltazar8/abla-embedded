import "../src/esp32/psram/range_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(40)
val table=nativeStaticAllocate(4096)
var maps=0
var unmaps=0
var failMap=-1
var failUnmap=-1
var encrypted=false
var active=false
var bad=false
var last=1024
fun p4PsramCommandStorageSafe(address: int,bytes: int): bool = address == memory && bytes == 40
fun p4PsramMmuIndex(address: int): int = if (address < 0x48000000 || address >= 0x4c000000 || (address&65535) != 0) -1 else (address-0x48000000)>>>16
fun p4PsramMmuEncryptionEnabled(): bool = encrypted
fun p4PsramMmuReadOwned(address: int,polls: int): int = if (active) 4 else 1|(nativeBufferAt(table,4096).loadU32(p4PsramMmuIndex(address)*4)<<8)
fun p4PsramMmuMapOwned(address: int,physical: int,capacity: int,expected: int,polls: int): int {
    val index=p4PsramMmuIndex(address); maps=maps+1
    val entry=(physical>>>16)|0xc00|(if (encrypted) 0x1000 else 0)
    if (nativeBufferAt(table,4096).loadU32(index*4) != 0 || expected != 0 || physical+65536 > capacity) bad=true
    nativeBufferAt(table,4096).storeU32(index*4,entry)
    return (entry<<8)|(if (index == failMap) 7 else 1)
}
fun p4PsramMmuUnmapOwned(address: int,expected: int,polls: int): int {
    val index=p4PsramMmuIndex(address); unmaps=unmaps+1
    if (index >= last || nativeBufferAt(table,4096).loadU32(index*4) != expected) bad=true
    last=index; nativeBufferAt(table,4096).storeU32(index*4,0)
    return if (index == failUnmap) 7 else 1
}
fun resetRange(record: NativeBuffer): void {
    var index=0
    while (index < 1024) { nativeBufferAt(table,4096).storeU32(index*4,0); index=index+1 }
    maps=0; unmaps=0; failMap=-1; failUnmap=-1; active=false; encrypted=false; bad=false; last=1024
    p4PsramRangeInitializeOwned(record); return
}
@export("abla_p4_psram_range_test")
fun rangeTest(): i32 {
    val record=nativeBufferAt(memory,40)
    var pages=1
    while (pages <= 1024) {
        resetRange(record); encrypted=(pages&1) != 0
        if (p4PsramRangeMapOwned(record,0x48000000,0,pages,67108864,2) != 1 || maps != pages || record.loadU32(24) != pages || bad) return i32(1)
        if (p4PsramRangeUnmapOwned(record,2) != 1 || unmaps != pages || record.loadU32(24) != 0 || bad) return i32(2)
        pages=pages+1
    }
    var failure=0
    while (failure < 29) {
        resetRange(record); failMap=failure
        if (p4PsramRangeMapOwned(record,0x48000000,65536,29,67108864,2) != 4 || maps != failure+1 || record.loadU32(24) != failure+1) return i32(3)
        if (p4PsramRangeUnmapOwned(record,2) != 1 || unmaps != failure+1 || bad) return i32(4)
        resetRange(record)
        if (p4PsramRangeMapOwned(record,0x48000000,65536,29,67108864,2) != 1) return i32(5)
        failUnmap=failure
        if (p4PsramRangeUnmapOwned(record,2) != 4 || record.loadU32(24) != failure+1) return i32(6)
        failUnmap=-1
        if (p4PsramRangeUnmapOwned(record,2) != 1 || bad) return i32(7)
        failure=failure+1
    }
    resetRange(record); nativeBufferAt(table,4096).storeU32(28*4,0xc07)
    if (p4PsramRangeMapOwned(record,0x48000000,0,29,67108864,2) != 4 || maps != 0 || record.loadU32(24) != 0) return i32(8)
    resetRange(record); p4PsramRangeMapOwned(record,0x48000000,0,29,67108864,2)
    active=true
    if (p4PsramRangeUnmapOwned(record,2) != 4 || unmaps != 0) return i32(9)
    active=false; nativeBufferAt(table,4096).storeU32(28*4,0xc07)
    if (p4PsramRangeUnmapOwned(record,2) != 4 || unmaps != 0 || record.loadU32(24) != 29) return i32(10)
    resetRange(record)
    if (p4PsramRangeMapOwned(record,0x4bff0000,0,2,67108864,2) != 2 || p4PsramRangeMapOwned(record,0x48000000,0,29,65536,2) != 2 || maps != 0) return i32(11)
    return i32(0)
}
