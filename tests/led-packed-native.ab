import "../src/led/rmt_strip_pixels.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
val buffer=nativeBufferAt(nativeStaticAllocate(256),256)
val out=nativeBufferAt(nativeStaticAllocate(256),256)
val reference=nativeBufferAt(nativeStaticAllocate(256),256)
@export("abla_led_packed_test")
trusted fun test(): i32 {
    var value=0
    while (value < 65536) {
        val color=rgbColorFrom565(value)
        if (color.rgb565() != value || color.red() != (((value>>11)&31)*8+((value>>13)&7)) ||
            color.green() != (((value>>5)&63)*4+((value>>9)&3)) || color.blue() != ((value&31)*8+((value>>2)&7))) return i32(1)
        buffer.store(0,value&255); buffer.store(1,value>>8)
        if (!ledConvertPixels(buffer,1,ledPixelsRgb565Le,out) || out.load(0) != color.red() || out.load(1) != color.green() || out.load(2) != color.blue()) return i32(2)
        buffer.store(0,value>>8); buffer.store(1,value&255)
        if (!ledConvertPixels(buffer,1,ledPixelsRgb565Be,out) || out.load(0) != color.red() || out.load(1) != color.green() || out.load(2) != color.blue()) return i32(3)
        value=value+1
    }
    value=0
    while (value < 256) {
        val c=rgbColorFrom332(value)
        if (c.red() != ((value>>5)*36+((value>>5)/2)) || c.green() != (((value>>2)&7)*36+(((value>>2)&7)/2)) || c.blue() != (value&3)*85) return i32(4)
        value=value+1
    }
    var format=1
    while (format <= 8) {
        val width=ledPixelBytes(format)
        var i=0
        while (i < 256) { buffer.store(i,(i*37+11)&255); i=i+1 }
        if (!ledConvertPixels(buffer,16,format,reference) || !ledConvertPixels(buffer,16,format,buffer)) return i32(5)
        i=0
        while (i < 48) { if (buffer.load(i) != reference.load(i)) return i32(6); i=i+1 }
        if (width != 3 && ledConvertPixels(buffer,16,format,nativeBufferAt(buffer.addressValue()+1,100))) return i32(7)
        i=0
        while (i < 48) { if (buffer.load(i) != reference.load(i)) return i32(8); i=i+1 }
        format=format+1
    }
    val strip=rmtLedStripAt(out,7,8)
    buffer.store(0,0xf8); buffer.store(1,0)
    if (!strip.storePackedColors(buffer,7,99,ledPixelsRgb565Be) || strip.color(7) != rgbColor(255,0,0)) return i32(9)
    if (strip.storePackedColors(nativeBufferAt(buffer.addressValue(),1),7,1,ledPixelsRgb565Be) || strip.color(7) != rgbColor(255,0,0)) return i32(10)
    if (ledConvertPixels(buffer,1,0,reference) || ledConvertPixels(buffer,-1,1,reference)) return i32(11)
    return i32(0)
}
