import "../src/display/tm1680_device.ab"
import "abla/build"
type I2cDevice=int
fun I2cDevice.valid(): bool = this == 123
val memory=nativeStaticAllocate(128)
var calls=0
var failAt=0
var length=0
var bad=false
trusted fun I2cDevice.write(source: NativeBuffer,count: int): bool {
    calls=calls+1;length=count
    if (this != 123 || count < 1 || count > 33) bad=true
    var at=0
    while (at < count) { nativeBufferAt(memory+80,33).store(at,source.load(at));at=at+1 }
    return calls != failAt
}
@export("abla_tm1680_test")
trusted fun testPanel(): i32 {
    val frame=nativeBufferAt(memory,32);val scratch=nativeBufferAt(memory+40,33);val wire=nativeBufferAt(memory+80,33)
    var at=0
    while (at < 32) { frame.store(at,0);at=at+1 }
    var rotation=0
    while (rotation < 4) {
        var pixel=0
        while (pixel < 256) {
            val x=pixel&15;val y=pixel>>>4
            if (!tm1680SetPixel(frame,x,y,true,rotation)) return i32(1)
            var px=x;var py=y;var turn=0
            while (turn < rotation) { val previous=px;px=15-py;py=previous;turn=turn+1 }
            val index=1+py*2+(px>>>3);val mask=int(u32(1)<<u32((px&7)^4))
            var inverted=0
            while (inverted < 2) {
                if (!tm1680PackFrame(frame,scratch,inverted == 1) || scratch.load(0) != 0) return i32(2)
                at=1
                while (at < 33) {
                    var pixelValue=0
                    if (at == index) pixelValue=mask
                    var inversion=0
                    if (inverted == 1) inversion=255
                    if (scratch.load(at) != (pixelValue^inversion)) return i32(3)
                    at=at+1
                }
                inverted=inverted+1
            }
            if (!tm1680SetPixel(frame,x,y,false,rotation)) return i32(4)
            pixel=pixel+1
        }
        rotation=rotation+1
    }
    val panel=tm1680FromDevice(I2cDevice(123))
    calls=0;failAt=1
    if (panel.begin(frame,scratch) || calls != 1 || length != 6 || wire.load(0) != 128 || wire.load(1) != 164 ||
        wire.load(2) != 152 || wire.load(3) != 129 || wire.load(4) != 177 || wire.load(5) != 131) return i32(5)
    calls=0;failAt=2
    if (panel.begin(frame,scratch) || calls != 2 || length != 33) return i32(6)
    calls=0;failAt=0
    if (!panel.begin(frame,scratch) || calls != 2 || length != 33) return i32(7)
    at=0
    while (at < 33) { if (wire.load(at) != 0) return i32(8);at=at+1 }
    var brightness=0
    while (brightness < 256) {
        calls=0
        if (!panel.setBrightness(brightness,scratch) || calls != 1 ||
            length != (if (brightness == 0) 1 else 2) || wire.load(0) != (if (brightness == 0) 130 else 176+brightness/16) ||
            (brightness != 0 && wire.load(1) != 131)) return i32(9)
        brightness=brightness+1
    }
    if (!panel.setSleep(true,scratch) || wire.load(0) != 130 || wire.load(1) != 128 ||
        !panel.setSleep(false,scratch) || wire.load(0) != 129 || wire.load(1) != 131) return i32(10)
    calls=0
    if (panel.setBrightness(256,scratch) || panel.setBrightness(-1,scratch) ||
        panel.begin(frame,nativeBufferAt(memory+1,33)) || panel.display(frame,nativeBufferAt(memory+40,32)) ||
        tm1680FromDevice(I2cDevice(0)).display(frame,scratch) || calls != 0 || bad) return i32(11)
    calls=0;failAt=1
    if (panel.display(frame,scratch) || calls != 1) return i32(12)
    return i32(0)
}
