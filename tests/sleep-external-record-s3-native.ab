import "../src/esp32/power/sleep_external_record_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Esp32S3SleepResume = int
fun Esp32S3SleepResume.valid(): bool = this >= 0
fun Esp32S3SleepResume.complete(): bool = this == 1
var triggers=0
var pin=0
var pins=2
var holds=0
var usb=0
var header=0
var stage=6
var progress=1
var calls=0
var cleanupCalls=0
var cleanupOk=true
var released=false
fun esp32S3ExternalWakeReleasedOwned(record: NativeBuffer): bool = released
fun esp32S3ExternalWakeTriggersOwned(record: NativeBuffer): int = triggers
fun esp32S3RtcWakeMaskValid(mask: int): bool = mask > 0 && (mask & ~0x3FFFFF) == 0
fun esp32S3RtcWakeRead(address: int): int {
    if (address == 8212) return pin
    if (address == 8244) return pins
    if (address == 8248) return holds
    return -1
}
fun esp32S3MspiStateRead(address: int): int {
    if (address == 4096) return header
    if (address == 4100) return stage
    if (address == 4204) return usb
    return -1
}
fun esp32S3MspiStateLoad64(address: int): int = progress
fun esp32S3SleepTimedRecordEnterOwned(sleep: NativeBuffer,flags: int,period: int,duration: int,wake: int,reject: int): int { calls=calls+1; if (wake == triggers) 42 else -42 }
fun esp32S3SleepExternalOnlyRecordEnterOwned(sleep: NativeBuffer,flags: int,period: int,wake: int,reject: int): int { calls=calls+1; if (wake == triggers && wake > 0 && (wake & 8) == 0) 43 else -43 }
fun esp32S3ExternalWakeRestoreOwned(record: NativeBuffer): bool { cleanupCalls=cleanupCalls+1; cleanupOk }
@export("abla_sleep_external_record_test")
trusted fun externalTest(): i32 {
    val sleep=nativeBufferAt(4096,128)
    val wake=nativeBufferAt(8192,176)
    var p=0
    while (p < 128) {
        triggers=p & 3
        pin=if ((p & 4) != 0) 19 else 0
        pins=if ((p & 8) != 0) 1<<20 else 2
        usb=if ((p & 16) != 0) 7 else 4
        val off=(p & 32) != 0
        holds=if ((p & 64) != 0) pins else 0
        val selected=(if ((triggers & 1) != 0) 1<<pin else 0) | (if ((triggers & 2) != 0) pins else 0)
        val invalid=(off && ((triggers & 1) != 0 || ((triggers & 2) != 0 && holds == 0))) || ((selected & 0x180000) != 0 && usb == 7)
        calls=0
        val result=esp32S3SleepExternalTimedEnterOwned(sleep,wake,if (off) 2 else 0,1,32,0)
        if (result != (if (invalid) -6 else 42) || calls != (if (invalid) 0 else 1)) return i32(1)
        calls=0
        val only=esp32S3SleepExternalEnterOwned(sleep,wake,if (off) 2 else 0,1,0)
        if (only != (if (invalid || triggers == 0) -6 else 43) || calls != (if (invalid || triggers == 0) 0 else 1)) return i32(8)
        p=p+1
    }
    calls=0
    if (esp32S3SleepExternalTimedEnterOwned(sleep,nativeBufferAt(4100,176),0,1,1,0) != -6 || calls != 0) return i32(2)
    cleanupCalls=0; header=1
    if (esp32S3SleepExternalWakeCleanupOwned(sleep,wake) || cleanupCalls != 0) return i32(3)
    header=0; stage=7
    if (esp32S3SleepExternalWakeCleanupOwned(sleep,wake) || cleanupCalls != 0) return i32(4)
    stage=6; progress=0
    if (esp32S3SleepExternalWakeCleanupOwned(sleep,wake) || cleanupCalls != 0) return i32(5)
    progress=1; cleanupOk=false
    if (esp32S3SleepExternalWakeCleanupOwned(sleep,wake) || cleanupCalls != 1) return i32(6)
    cleanupOk=true
    if (!esp32S3SleepExternalWakeCleanupOwned(sleep,wake) || cleanupCalls != 2) return i32(7)
    released=true
    if (!esp32S3SleepExternalWakeCleanupOwned(sleep,wake) || cleanupCalls != 2) return i32(9)
    header=1
    if (esp32S3SleepExternalWakeCleanupOwned(sleep,wake) || cleanupCalls != 2) return i32(10)
    i32(0)
}
