import "../src/esp32/power/sleep_clic_p4_sequence.ab"
import "abla/build"
val clicRecord=nativeStaticAllocate(224)
val clicBank=nativeStaticAllocate(204)
var clicHart=u32(0)
var clicStatus=u32(0)
var clicReads=0
var clicWrites=0
var clicFences=0
var clicBad=false
fun p4SleepClicHart(): u32 = clicHart
fun p4SleepClicStatus(): u32 = clicStatus
fun p4SleepClicFence(): void { clicFences=clicFences+1;return }
fun clicSlot(address: int): int {
    if (address >= 0x20800000 && address <= 0x20800008 && (address&3) == 0) return (address-0x20800000)/4
    if (address >= 0x20801000 && address <= 0x208010bc && (address&3) == 0) return 3+(address-0x20801000)/4
    clicBad=true;return 0
}
fun clicPattern(slot: int): int = 0xa5c70101|(slot<<24)|(slot<<1)
fun p4SleepClicRead(address: int): int {
    val slot=clicSlot(address)
    if (slot != clicReads || clicFences != 0 || clicWrites != 0) clicBad=true
    clicReads=clicReads+1
    return nativeBufferAt(clicBank,204).loadU32(slot*4)
}
fun p4SleepClicWrite(address: int,value: int): void {
    val slot=clicSlot(address)
    if (slot != (if (clicWrites == 0) 0 else clicWrites+1) ||
        clicFences != 1 || clicReads != 51 || nativeBufferAt(clicRecord,224).loadU32(4) != 2) clicBad=true
    val mask=if (slot == 0) 30 else if (slot == 2) 4278190080 else 4278649089
    if ((value&(~mask)) != 0) clicBad=true
    val bank=nativeBufferAt(clicBank,204)
    bank.storeU32(slot*4,(bank.loadU32(slot*4)&(~mask))|value)
    clicWrites=clicWrites+1;return
}
fun clicSeed(): NativeBuffer {
    val r=nativeBufferAt(clicRecord,224)
    var i=0
    while (i < 224) { r.storeU32(i,0);i=i+4 }
    r.storeU32(220,0x1234abcd)
    i=0
    while (i < 51) { nativeBufferAt(clicBank,204).storeU32(i*4,clicPattern(i));i=i+1 }
    clicHart=u32(0);clicStatus=u32(0);clicReads=0;clicWrites=0;clicFences=0;clicBad=false
    return r
}
@export("abla_sleep_clic_p4_test")
fun test(): int {
    var hart=0
    while (hart < 2) {
        val r=clicSeed();clicHart=u32(hart)
        if (esp32p4SleepClicSaveOwned(r,true) != 1 || clicReads != 51 || clicFences != 1) return 1
        var i=0
        while (i < 51) {
            if (r.loadU32(16+i*4) != clicPattern(i)) return 2
            nativeBufferAt(clicBank,204).storeU32(i*4,0x00404040)
            i=i+1
        }
        if (esp32p4SleepClicSaveOwned(r,true) != 2 || clicReads != 51) return 3
        clicHart=u32(1-hart)
        if (esp32p4SleepClicRestoreOwned(r,true) != 3 || clicWrites != 0) return 4
        clicHart=u32(hart);clicStatus=u32(8)
        if (esp32p4SleepClicRestoreOwned(r,true) != 3 || clicWrites != 0) return 5
        clicStatus=u32(0)
        if (esp32p4SleepClicRestoreOwned(r,false) != 2 || clicWrites != 0) return 6
        if (esp32p4SleepClicRestoreOwned(r,true) != 4 || clicWrites != 50 || clicFences != 2 || clicBad) return 7
        i=0
        while (i < 51) {
            val mask=if (i == 0) 30 else if (i == 1) 0 else if (i == 2) 4278190080 else 4278649089
            if (nativeBufferAt(clicBank,204).loadU32(i*4) != ((0x00404040&(~mask))|(clicPattern(i)&mask))) return 8
            i=i+1
        }
        if (r.loadU32(220) != 0x1234abcd || esp32p4SleepClicRestoreOwned(r,true) != 2 || clicWrites != 50) return 9
        hart=hart+1
    }
    val r=clicSeed()
    if (esp32p4SleepClicSaveOwned(r,false) != 2 ||
        esp32p4SleepClicSaveOwned(nativeBufferAt(clicRecord,219),true) != 2 ||
        esp32p4SleepClicSaveOwned(nativeBufferAt(clicRecord+1,220),true) != 2) return 10
    clicStatus=u32(8)
    if (esp32p4SleepClicSaveOwned(r,true) != 3) return 11
    clicStatus=u32(0);clicHart=u32(2)
    if (esp32p4SleepClicSaveOwned(r,true) != 3 || clicReads != 0 || r.loadU32(0) != 0) return 12
    return 0
}
