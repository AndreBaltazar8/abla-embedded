import "../src/esp32/power/sleep_recovery_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(456)
var stage=0
var fault=0
var calls=0
var bad=false
var withAlarm=false
trusted fun c5SleepRecoveryEntry(record: NativeBuffer): int { bad=true;return 2 }
trusted fun c5SleepRecoveryTime(record: NativeBuffer,outcome: int): int { bad=true;return 2 }
trusted fun c5CpuClockRead(offset: int): int { bad=true;return 0 }
trusted fun c5CpuClockWrite(offset: int,value: int): void { bad=true;return }
trusted fun c5CpuClockTicks(mhz: int): void { bad=true;return }
fun visit(expected: int): bool {
    calls=calls+1
    if (stage != expected) bad=true
    if (fault == expected+1) return false
    stage=stage+1;return true
}
trusted fun c5SleepRecoveryProfile(record: NativeBuffer): int {
    if (record.addressValue() != memory+128) bad=true
    return if (visit(0)) 4 else 3
}
trusted fun c5SleepRecoveryClock(record: NativeBuffer,plan: C5CpuClock,pvt: bool,peripheralPll: bool): int {
    if (peripheralPll) bad=true
    if (record.addressValue() != memory+64 || (plan|0) != (40<<18) || pvt) bad=true
    if (!visit(1)) return 4
    if (!withAlarm) stage=3
    return 1
}
trusted fun c5SleepRecoveryAlarm(record: NativeBuffer): int {
    if (record.addressValue() != memory+432) bad=true
    return if (visit(2)) 6 else 5
}
trusted fun c5SleepRecoveryCache(token: int,result: int,down: bool,us: int): bool {
    if (token != 0x103080000001 || result != 0 || !down || us != 700) bad=true
    visit(3)
}
trusted fun c5SleepRecoveryUarts(token: int): int {
    // Simulate one port resuming successfully while another remains owned.
    if (!visit(4)) return 0x101
    if (token != 0x301 && token != 0x101) bad=true
    return 0
}
@export("abla_sleep_recovery_c5_test")
trusted fun test(): int {
    val record=nativeBufferAt(memory,128);val profile=nativeBufferAt(memory+128,304)
    var alarm=0
    while (alarm < 2) {
        withAlarm=alarm != 0
        fault=0
        while (fault < 6) {
            val failure=fault
            record.storeU32(0,0);stage=0;calls=0;bad=false
            val result=esp32C5SleepRecoveryBeginOwned(record,profile,if (withAlarm) memory+432 else 0,C5CpuClock(40<<18),false,0,true,700,0x103080000001,0x301,true)
            if (result != (if (fault == 0 || fault == 3 && !withAlarm) 1 else 3) || bad) return 1
            val oldCalls=calls
            if (esp32C5SleepRecoveryContinueOwned(record,false) != 2 || calls != oldCalls) return 2
            fault=0
            if (esp32C5SleepRecoveryContinueOwned(record,true) != 1 || stage != 5 || bad) return 3
            val doneCalls=calls
            if (esp32C5SleepRecoveryContinueOwned(record,true) != 1 || calls != doneCalls) return 4
            fault=failure+1
        }
        alarm=alarm+1
    }
    record.storeU32(0,0);calls=0
    if (esp32C5SleepRecoveryBeginOwned(record,nativeBufferAt(memory,304),0,C5CpuClock(40<<18),false,0,true,700,0,0,true) != 2 || record.loadU32(0) != 0 || calls != 0) return 5
    if (esp32C5SleepRecoveryBeginOwned(record,profile,memory+132,C5CpuClock(40<<18),false,0,true,700,0,0,true) != 2 || record.loadU32(0) != 0 || calls != 0) return 6
    return 0
}
