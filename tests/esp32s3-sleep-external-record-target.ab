import "../src/esp32/power/sleep_external_record_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_external_record_target")
trusted fun externalSleepTarget(sleep: NativeBuffer,wake: NativeBuffer,flags: int,period: int,duration: int,reject: int,cleanup: bool): int {
    if (cleanup) return if (esp32S3SleepExternalWakeCleanupOwned(sleep,wake)) 1 else 0
    esp32S3SleepExternalTimedEnterOwned(sleep,wake,flags,period,duration,reject)
}
