import "../src/storage/fat_directory_slots.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
val image=nativeStaticAllocate(2048)
var reads=0
var failAt=0
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,destination: NativeBuffer): bool {
    reads=reads+1
    if (lba < 81 || lba > 84) return false
    val source=nativeBufferAt(image+(lba-81)*512,512);var index=0
    while (index < 512) { destination.store(index,source.load(index));index=index+1 }
    return reads != failAt
}
@export("abla_fat_directory_slots_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(memory,28);val boot=nativeBufferAt(memory+32,512)
    val sector=nativeBufferAt(memory+544,512);val scratch=nativeBufferAt(memory+1056,992)
    // Allocate independent full scratch; above intentionally undersized for rejection.
    val work=nativeBufferAt(memory+2048,1024)
    var index=0
    while (index < 512) { boot.store(index,0);index=index+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2)
    boot.storeU16(17,64);boot.storeU16(22,40);boot.storeU16(19,10113);boot.storeU16(510,0xaa55)
    var scenario=0
    while (scenario < 8) {
        reads=0;failAt=if (scenario == 6) 2 else 0;index=0
        while (index < 2048) { nativeBufferAt(image,2048).store(index,0);index=index+1 }
        index=0
        while (index < 64) {
            val entry=nativeBufferAt(image+index*32,32)
            var byte=0
            while (byte < 11) { entry.store(byte,65);byte=byte+1 }
            entry.store(11,32);index=index+1
        }
        val entries=nativeBufferAt(image,2048)
        if (scenario == 0 || scenario == 6) { entries.store(14*32,229);entries.store(15*32,229);entries.store(16*32,229) }
        if (scenario == 1 || scenario == 5) {
            entries.store(15*32,0);index=512
            while (index < 2048) { entries.store(index,77);index=index+1 }
        }
        if (scenario == 2) { entries.store(0,229);entries.store(64,229);entries.store(128,229) }
        if (scenario == 3) { entries.store(11,15);entries.store(32,0) }
        if (scenario == 4) { entries.store(11,15);entries.store(32,229);entries.store(64,229);entries.store(96,229);entries.store(128,229) }
        val needed=if (scenario == 1 || scenario == 5) 21 else 3
        val result=fatFindDirectorySlotsOwned(reader,boot,0,10113,0,needed,if (scenario == 5) 1 else 8,sector,if (scenario == 7) scratch else work)
        val status=if (scenario == 0 || scenario == 1 || scenario == 4) 1 else if (scenario == 2) 2 else if (scenario == 3) 5 else if (scenario == 5) 6 else if (scenario == 6) 4 else 3
        if (result.status() != status) return i32(1)
        if (status == 1 && (result.ordinal() != 0 || result.entryIndex() != (if (scenario == 0) 14 else if (scenario == 1) 15 else 2) ||
            result.consumesEnd() != (scenario == 1))) return i32(2)
        scenario=scenario+1
    }
    if (fatFindDirectorySlotsOwned(reader,boot,0,10113,0,22,8,sector,work).status() != 3) return i32(3)
    return i32(0)
}
