import "../src/m5stack/cores3_output_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var latch=0
var status=8
var ts=0
var fail=0
var calls=0
var trace=0
var written=-1
var bad=false
fun step(handle: int,expected: int,code: int): bool {
    calls=calls+1; trace=trace*10+code
    if (handle != expected) bad=true
    calls != fail
}
fun cores3OutputStatus(handle: int): I2cByteResult =
    if (step(handle,7,1)) I2cByteResult(256|status) else I2cByteResult(0)
fun cores3OutputTs(handle: int): I2cWordResult =
    if (step(handle,7,2)) I2cWordResult(65536|ts) else I2cWordResult(0)
fun cores3OutputLatches(handle: int): I2cWordResult =
    if (step(handle,8,3)) I2cWordResult(65536|latch) else I2cWordResult(0)
fun cores3OutputWrite(handle: int,value: int): bool {
    written=value
    step(handle,8,4)
}
@export("abla_cores3_output_test")
fun outputTest(): i32 {
    // All two-byte latch states, both rail selectors and both directions.
    var profile=0
    while (profile < 262144) {
        latch=profile & 65535
        val usb=(profile & 65536) != 0
        val enabled=(profile & 131072) != 0
        calls=0; trace=0; written=-1; bad=false; fail=0; status=8
        val result=m5BoardStackCoreS3.setCoreS3OutputOwned(8,7,usb,enabled)
        val mask=if (usb) 32 else 2
        val low=if (enabled) (latch & 255)|mask else (latch & 255)&~mask
        val boost=enabled || (low & 2) != 0
        val expected=(latch & 32512)|low|(if (boost) 32768 else 0)
        if (!result.valid() || written != expected || trace != (if (!usb && enabled) 134 else 34) || bad) return i32(1)
        profile=profile+1
    }
    // Exhaustive ADC domain crossed with presence/VBUS and each I/O failure.
    profile=0
    while (profile < 393216) {
        ts=profile & 16383
        val bits=(profile>>>14)&3
        status=(if ((bits & 1) != 0) 8 else 0)|(if ((bits & 2) != 0) 32 else 0)
        fail=profile/65536
        calls=0; trace=0; written=-1; bad=false; latch=0
        var path=1; var count=1; var expectedStatus=1
        if (fail == 1) expectedStatus=4
        if (expectedStatus == 1 && (bits & 1) == 0) {
            path=12; count=2
            if (fail == 2) expectedStatus=4
            if (expectedStatus == 1 && ts > 4000 && ts < 16351) {
                path=121; count=3
                if (fail == 3) expectedStatus=4
                else if ((bits & 2) != 0) expectedStatus=5
            }
        }
        if (expectedStatus == 1) {
            path=path*10+3; count=count+1
            if (fail == count) expectedStatus=6
            else {
                path=path*10+4; count=count+1
                if (fail == count) expectedStatus=7
            }
        }
        val result=m5BoardStackCoreS3SE.setCoreS3OutputOwned(8,7,false,true)
        if (result.status() != expectedStatus || trace != path || calls != count || bad) return i32(2)
        if ((expectedStatus == 1 || expectedStatus == 7) && written != 32770) return i32(3)
        if (expectedStatus != 1 && expectedStatus != 7 && written != -1) return i32(4)
        profile=profile+1
    }
    calls=0
    if (m5BoardStackCoreS3.setCoreS3OutputOwned(0,7,false,true).status() != 3 ||
        m5BoardStackChan.setCoreS3OutputOwned(8,0,false,true).status() != 3 ||
        m5BoardStackChan.setCoreS3OutputOwned(4294967296,7,true,false).status() != 3 ||
        M5BoardId(0).setCoreS3OutputOwned(8,7,false,true).status() != 2 || calls != 0) return i32(5)
    fail=0; calls=0; trace=0; bad=false
    if (!m5BoardStackChan.setCoreS3OutputOwned(8,0,true,true).valid() || trace != 34 || bad) return i32(6)
    i32(0)
}
