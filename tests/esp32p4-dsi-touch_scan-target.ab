import "../src/m5stack/tab5_touch_scan_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_touch_scan_target")
trusted fun target(prepared: Tab5BoardPrepare,board: M5BoardId,bus: int,scan: Tab5TouchScan,close: bool): Tab5TouchScan =
    if (close) scan.closeOwned() else prepared.scanTouchOwned(board,bus,60)
