import "../src/esp32/gdma_tx_channel_c6_sequence.ab"
import "abla/build"
var channel=0
var conf=u32(0)
var ownerReg=u32(0)
var peripheralReg=u32(0)
var fault=0
var writes=0
var drop=0
var bad=false
fun c6GdmaBusRead(): u32 = if (fault == 1) u32(3) else u32(1)
fun c6GdmaRead(at: int): u32 {
    val base=0xd0+channel*0xc0
    if (at == 0x64) return if (fault == 2) u32(9) else u32(8)
    if (at == base) return conf|(if (fault == 3) u32(64) else u32(0))
    if (at == base+4) return ownerReg
    if (at == base+48) return peripheralReg
    if (at == base+16) return if (fault == 4) u32(0x200000) else u32(0x800123)
    if (at == base+8) return if (fault == 5) u32(0) else u32(2)
    if (at == 0x30+channel*16) return if (fault == 6) u32(1) else u32(0)
    if (at == 0x38+channel*16) return if (fault == 7) u32(1) else u32(0)
    bad=true;return u32(0)
}
fun c6GdmaWrite(at: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    val base=0xd0+channel*0xc0
    if (at == base) conf=value else if (at == base+4) ownerReg=value else if (at == base+48) peripheralReg=value else bad=true
    return
}
@export("abla_gdma_tx_channel_c6_test")
trusted fun test(): int {
    var scenario=0
    while (scenario < 2688) {
        channel=scenario%3
        val oldConf=u32(0xa5000000)|u32(((scenario/3)%32)<<1)
        val oldOwner=u32(0xb0000000)|u32(((scenario/96)%2)<<12)
        val oldPeripheral=u32(0xc000003f)
        conf=oldConf;ownerReg=oldOwner;peripheralReg=oldPeripheral;writes=0;drop=scenario/384;fault=0;bad=false
        var owner=c6GdmaTxChannelOpenOwned(channel,3,true)
        if (owner.status() != 1 && owner.status() != 5) return 1
        if (owner.status() == 1 && ((conf&u32(62)) != u32(12) || (ownerReg&u32(4096)) == u32(0) || (peripheralReg&u32(63)) != u32(3))) return 2
        owner=owner.closeOwned(true);drop=0;owner=owner.closeOwned(true)
        if (owner.status() != 6 || conf != oldConf || ownerReg != oldOwner || peripheralReg != oldPeripheral || bad) return 3
        scenario=scenario+1
    }
    fault=1
    while (fault <= 7) {
        writes=0
        if (c6GdmaTxChannelOpenOwned(channel,3,true).status() != (if (fault <= 2) 3 else 4) || writes != 0) return 4
        fault=fault+1
    }
    fault=0;writes=0
    var owner=c6GdmaTxChannelOpenOwned(channel,3,true)
    val before=writes;fault=4
    owner=owner.closeOwned(true)
    if (owner.status() != 7 || writes != before) return 5
    fault=0;owner=owner.closeOwned(true)
    if (owner.status() != 6 || bad) return 6
    return 0
}
