import "../src/esp32/security/crypto/psa_status_esp32.ab"

@export("abla_mbedtls_to_psa_error_probe")
fun mbedtlsToPsaErrorProbe(error: i32): i32 =
    esp32MbedtlsToPsaError(error)

@export("abla_psa_key_bits_probe")
fun psaKeyBitsProbe(keyType: i32, bits: i32): i32 =
    esp32PsaValidateUnstructuredKeyBitSize(keyType, bits)

@export("abla_psa_can_hash_probe")
fun psaCanHashProbe(algorithm: u32): i32 = esp32PsaCanDoHash(algorithm)

@export("abla_psa_max_ops_probe")
fun psaMaximumOperationsProbe(maximum: u32): u32 {
    esp32PsaInterruptibleSetMaximumOperations(maximum)
    return esp32PsaInterruptibleGetMaximumOperations()
}

fun main(): int {
    if (esp32MbedtlsToPsaError(0) != 0) return 1
    if (esp32MbedtlsToPsaError(-129) != -129) return 2
    if (esp32MbedtlsToPsaError(-134) != -134) return 23
    if (esp32MbedtlsToPsaError(-147) != -147) return 24
    if (esp32MbedtlsToPsaError(-148) != -148) return 25
    if (esp32MbedtlsToPsaError(-151) != -151) return 26
    if (esp32MbedtlsToPsaError(-4095) != -4095) return 3
    if (esp32MbedtlsToPsaError(-128) != -132) return 4
    if (esp32MbedtlsToPsaError(-4096) != -132) return 5
    if (esp32MbedtlsToPsaError(-24608) != -134) return 6
    if (esp32MbedtlsToPsaError(-24672) != -135) return 7
    if (esp32MbedtlsToPsaError(-25472) != -151) return 8
    if (esp32MbedtlsToPsaError(-17536) != -148) return 9
    if (esp32MbedtlsToPsaError(-15872) != -146) return 10
    if (esp32MbedtlsToPsaError(-15360) != -133) return 11
    if (esp32MbedtlsToPsaError(-16768) != -147) return 12
    if (esp32MbedtlsToPsaError(-12288) != -132) return 13

    if (esp32PsaValidateUnstructuredKeyBitSize(4097, 128) != 0) return 14
    if (esp32PsaValidateUnstructuredKeyBitSize(4097, 9) != -135) return 15
    if (esp32PsaValidateUnstructuredKeyBitSize(9216, 128) != 0) return 16
    if (esp32PsaValidateUnstructuredKeyBitSize(9216, 64) != -135) return 17
    if (esp32PsaValidateUnstructuredKeyBitSize(1, 128) != -134) return 18
    if (esp32PsaCanDoHash(u32(0)) != 1) return 19

    esp32PsaInterruptibleSetMaximumOperations(u32(73))
    if (esp32PsaInterruptibleGetMaximumOperations() != u32(73)) return 20
    if (esp32MbedtlsPsaInterruptibleOperationCount(u32(0)) != u32(0)) return 21
    if (esp32MbedtlsPsaInterruptibleAbort(u32(0)) != -134) return 22
    return 0
}
