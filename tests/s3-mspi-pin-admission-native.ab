import "../src/esp32/psram/pin_admission_s3_sequence.ab"
import "../src/esp32/psram/pin_config_s3.ab"
import "../src/esp32/psram/boot80_pins_s3_sequence.ab"
import "abla/build"
val paMemory=nativeStaticAllocate(688)
var paMask=0
var paReads=0
var paBoots=0
var paBad=false
fun s3PsramCommandStorageSafe(address: int,length: int): bool = address >= paMemory && address+length <= paMemory+688
fun s3MspiReadConfiguredPin(role: int): int {
    if (role != paReads%12) paBad=true
    paReads=paReads+1
    return if ((paMask&(1<<role)) != 0) 63 else nativeBufferAt(paMemory,12).load(role)
}
fun s3PsramBoot80ConfiguredOwned(r: NativeBuffer,virtual: int,bytes: int,capacity: int,mhz: int,profile: int,timing: int,base: int,repetitions: int,kib: int,line: int,proof: bool): int {
    if (r.addressValue() != paMemory+12 || virtual != 0x3c100000 || bytes != 65536 || capacity != 4194304 || mhz != 80 ||
        profile != 0 || timing != 0 || base != 5 || repetitions != 3 || kib != 64 || line != 32 || !proof) paBad=true
    paBoots=paBoots+1;r.storeU32(0,123);return 42
}
fun paRun(): int = s3PsramBoot80PinsOwned(nativeBufferAt(paMemory,12),nativeBufferAt(paMemory+12,676),0x3c100000,65536,4194304,80,0,0,5,3,64,32,true)
@export("abla_s3_mspi_pin_admission_test")
fun testPinAdmission(): int {
    val expected=nativeBufferAt(paMemory,12);val r=nativeBufferAt(paMemory+12,676)
    var role=0
    while (role < 12) { expected.store(role,s3MspiDefaultPin(role));role=role+1 }
    paMask=0
    while (paMask < 4096) {
        paReads=0;paBoots=0;paBad=false;r.storeU32(0,0)
        if (paRun() != (if (paMask == 0) 42 else 65536|paMask) || paReads != 12 || paBad ||
            paBoots != (if (paMask == 0) 1 else 0) || r.loadU32(0) != (if (paMask == 0) 123 else 0)) return 1
        paMask=paMask+1
    }
    paMask=0;paReads=0;paBoots=0
    role=0
    while (role < 11) { expected.store(role,role);role=role+1 }
    if (paRun() != 42 || paBad) return 2
    paReads=0;paBoots=0
    expected.store(0,22)
    if (paRun() != 2 || paReads != 0 || paBoots != 0) return 3
    expected.store(0,1)
    if (paRun() != 2 || paReads != 0) return 4
    expected.store(0,0)
    if (s3PsramBoot80PinsOwned(r,r,0x3c100000,65536,4194304,80,0,0,5,3,64,32,true) != 2 ||
        s3PsramBoot80PinsOwned(expected,r,0x3c100000,65536,4194304,80,0,0,5,3,64,32,false) != 2 || paReads != 0 || paBoots != 0) return 5
    return 0
}
