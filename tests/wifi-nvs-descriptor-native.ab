var calls = 0
var barriers = 0
var failAt = 0
var bad = false
trusted fun xtensaMemoryBarrier(): void { barriers = barriers + 1; return }
trusted fun check(value: u32, column: int): void {
    if (value != u32(nativeAddressLoadU32(expected, calls * 32 + column * 4))) bad = true
    return
}
trusted fun esp32RecoveredWifiNvsCfgItemInit(key: u32, index: u32, kind: u32, length: u32, minimum: u32, maximum: u32, initial: u32, value: u32, unused0: u32, unused1: u32, unused2: u32, unused3: u32, unused4: u32, unused5: u32, unused6: u32, unused7: u32): u32 {
    check(key, 0)
    check(index, 1)
    check(kind, 2)
    check(length, 3)
    check(minimum, 4)
    check(maximum, 5)
    check(initial, 6)
    check(value, 7)
    calls = calls + 1
    if (barriers != calls) bad = true
    if (calls == failAt) u32(258) else u32(0)
}
trusted fun nvsDescriptorTest(): int {
    var failure = 0
    while (failure <= 85) {
        calls = 0
        barriers = 0
        failAt = failure
        val result = esp32WifiNvsInitDescriptorTail(u32(65536), u32(131072))
        if (bad) return 1
        if (failure == 0) {
            if (result != u32(0) || calls != 85) return 2
        } else {
            if (result != u32(258) || calls != failure) return 3
        }
        failure = failure + 1
    }
    0
}
