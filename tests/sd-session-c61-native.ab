import "./sd-fifo-c61-model.ab"
import "../src/sd/session_c61_sequence.ab"
val sessionMemory=nativeStaticAllocate(64)
@export("abla_sd_session_c61_test")
trusted fun testSession(): i32 {
    cardMode=0;resetCard()
    val storage=nativeBufferAt(sessionMemory,64)
    val gate=peripheralGateAt(gateStorage);val lock=peripheralGateAt(sessionMemory)
    val scratch=nativeBufferAt(buffers,2);val response=nativeBufferAt(buffers+4,16)
    val source=nativeBufferAt(buffers+16,512);val destination=nativeBufferAt(buffers+528,512)
    val master=openCardMaster()
    if (!master.ready() || !esp32C61SdSessionInitializeFresh(storage)) return i32(1)
    val first=esp32C61SdSessionOpen(storage,master,gate,u32(7),160000000,scratch,response,4)
    if (first == 0 || storage.loadU32(8) != 1 || bad) return i32(2)
    var index=0
    while (index < 512) { source.store(index,(index*13+7)&255);index=index+1 }
    if (!first.writeBlock(u32(7),3,scratch,source,4).valid() || !first.readBlock(u32(7),3,scratch,destination,4).valid() || bad) return i32(3)
    index=0
    while (index < 512) { if (source.load(index) != destination.load(index)) return i32(4);index=index+1 }
    val before=starts
    if (esp32C61SdSessionOpen(storage,master,gate,u32(7),160000000,scratch,response,4) != 0 || starts != before) return i32(5)
    if (lock.tryBegin(u32(9)) != 0 || first.invalidate(u32(7)) ||
        first.readBlock(u32(7),3,scratch,destination,4).status() != 11 || starts != before || !lock.finish(u32(9),true)) return i32(6)
    if (gate.tryBegin(u32(9)) != 0 || first.readBlock(u32(7),3,scratch,destination,4).status() != 11 ||
        storage.loadU32(12) != 1 || starts != before || !gate.finish(u32(9),true)) return i32(7)
    if (first.readBlock(u32(7),3,scratch,nativeBufferAt(sessionMemory,512),4).status() != 2 ||
        first.writeBlock(u32(7),3,nativeBufferAt(sessionMemory+8,2),source,4).status() != 2 || starts != before) return i32(8)
    if (!first.invalidate(u32(7)) || first.invalidate(u32(7)) || first.readBlock(u32(7),3,scratch,destination).status() != 2 || starts != before) return i32(9)
    val second=esp32C61SdSessionOpen(storage,master,gate,u32(7),160000000,scratch,response,4)
    val reopened=starts
    if (second == 0 || second == first || storage.loadU32(8) != 2 || first.invalidate(u32(7)) ||
        first.readBlock(u32(7),3,scratch,destination).status() != 2 || starts != reopened || bad) return i32(10)
    corruptRead=true
    if (second.readBlock(u32(7),3,scratch,destination,4).status() != 7 || storage.loadU32(12) != 3 ||
        (c61SdSessionLoad64(storage,48)&255) != 7 || bad) return i32(11)
    val failedAt=starts
    if (second.readBlock(u32(7),3,scratch,destination).status() != 2 || starts != failedAt ||
        !master.recover(gate,u32(8),true)) return i32(12)
    corruptRead=false
    val third=esp32C61SdSessionOpen(storage,master,gate,u32(7),160000000,scratch,response,4)
    if (third == 0 || third == second || !third.readBlock(u32(7),3,scratch,destination,4).valid() || bad) return i32(13)
    if (!third.invalidate(u32(7))) return i32(14)
    // Exhausted generations never wrap and resurrect an old handle.
    storage.storeU32(8,16777215)
    val exhausted=starts
    if (esp32C61SdSessionOpen(storage,master,gate,u32(7),160000000,scratch,response,4) != 0 || starts != exhausted ||
        storage.loadU32(8) != 16777215 || bad) return i32(15)
    if (master.closeOwned(true) != 0 || bad) return i32(16)
    return i32(0)
}
