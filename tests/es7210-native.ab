import "../src/audio/es7210_device.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type I2cDevice = int
fun I2cBus.valid(): bool = this == 1
fun I2cBus.device(address: int, frequency: int): I2cDevice = I2cDevice(if (address == 64 && frequency == 400000) 2 else 0)
fun I2cDevice.close(): bool = this == 2
val expectedRegisters = nativeStaticU32s([0,0,1,6,7,8,9,10,32,33,34,35,2,4,5,17,64,65,66,67,68,69,70,71,72,73,74,75,76,1])
val expectedValues = nativeStaticU32s([255,65,31,0,32,16,48,48,10,42,10,42,193,1,0,96,66,112,112,27,27,0,0,0,0,0,0,0,255,20])
var calls = 0
var failAt = 0
var bad = false
var mic1Only = false
var allInputs = false
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool {
    if (this != 2 || calls >= 30) { bad = true; return false }
    val expectedValue = if (mic1Only && calls == 20) 0 else if (allInputs && (calls == 21 || calls == 22)) 27 else
        if (allInputs && calls == 28) 0 else nativeAddressLoadU32(expectedValues, calls * 4)
    if (register != nativeAddressLoadU32(expectedRegisters, calls * 4) || value != expectedValue) bad = true
    calls = calls + 1
    calls != failAt
}
trusted fun es7210Test(): int {
    val mic = es7210(I2cBus(1))
    if (!mic.valid() || es7210(I2cBus(0)).valid()) return 1
    while (failAt <= 30) {
        calls = 0
        val result = mic.configureStereoMic12()
        if (bad || result != (failAt == 0) || calls != (if (failAt == 0) 30 else failAt)) return 2
        failAt = failAt + 1
    }
    calls = 0
    if (Es7210(0).configureStereoMic12() || calls != 0) return 3
    failAt = 0
    if (!mic.reset() || calls != 1) return 4
    calls = 0; failAt = 1
    if (mic.reset() || calls != 1) return 5
    if (!mic.close()) return 6
    mic1Only = true
    failAt = 0
    while (failAt <= 30) {
        calls = 0
        val result = mic.configureMic1()
        if (bad || result != (failAt == 0) || calls != (if (failAt == 0) 30 else failAt)) return 7
        failAt = failAt + 1
    }
    mic1Only=false;allInputs=true;failAt=0
    while (failAt <= 30) {
        calls=0
        val result=mic.configureMic1234()
        if (bad || result != (failAt == 0) || calls != (if (failAt == 0) 30 else failAt)) return 8
        failAt=failAt+1
    }
    0
}
#exportFunction("es7210Test", "abla_es7210_test")
