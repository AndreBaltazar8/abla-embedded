import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/touch/cst3530_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_cst3530_target")
trusted fun target(touch: Cst3530,buffer: NativeBuffer,operation: int): int =
    if (operation == 0) (if (touch.begin()) 1 else -1) else if (operation == 1) touch.readFrame(buffer) else (if (touch.close()) 1 else 0)
