import "../src/esp32/i2c/bus_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(64)
var setupResult=1
var closeResult=1
var setups=0
var closes=0
var bad=false
trusted fun c5I2cBusSetup(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int {
    setups=setups+1
    val buffer=nativeBufferAt(storage,64)
    if (sda != 2 || scl != 3 || source != 0 || sourceHz != u32(40000000) || busHz != u32(400000) ||
        filter != 7 || !pulls || buffer.loadU32(12) != 2 || buffer.loadU32(16) != 2 || buffer.loadU32(32) != 160000000 ||
        atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(7)) bad=true
    setupResult
}
trusted fun c5I2cBusTeardown(sda: int,scl: int): int {
    closes=closes+1
    val token=atomicU32At(storage).compareExchange(u32(0),u32(0))
    if (sda != 2 || scl != 3 || (token != u32(7) && token != u32(0x80000007))) bad=true
    closeResult
}
trusted fun open(state: Esp32C5I2cBusState): int = state.openOwned(u32(7),2,3,0,u32(40000000),u32(160000000),u32(400000))
@export("abla_c5_i2c_bus_test")
trusted fun busTest(): i32 {
    val state=esp32C5I2cBusStateAt(nativeBufferAt(storage,64))
    var profile=0
    while (profile < 35) {
        state.initialize(); setups=0; closes=0; bad=false
        val variant=profile%7
        setupResult=if (variant == 0) 1 else if (variant == 1) 2 else if (variant == 2) 3 else if (variant == 3) 260 else if (variant == 4) 772 else if (variant == 5) 263 else 775
        closeResult=profile/7+1
        val epoch=open(state)
        val partial=variant == 4 || variant == 6
        if (epoch != (if (variant == 0) 1 else 0) || state.phase() != (if (variant == 0) 1 else if (partial) 2 else 0) ||
            state.epoch() != epoch || setups != 1 || bad) return i32(1)
        if (partial) {
            if (open(state) != 0 || setups != 1) return i32(2)
        } else if (epoch == 1) {
            if (open(state) != 1 || setups != 1 ||
                state.openOwned(u32(7),2,3,0,u32(40000000),u32(160000000),u32(100000)) != 0 || setups != 1) return i32(3)
        }
        val needsClose=state.phase() != 0
        val closed=state.closeOwned(u32(7))
        if (closed != (!needsClose || closeResult == 1) || closes != (if (needsClose) 1 else 0) || bad) return i32(4)
        if (!closed) {
            if (open(state) != 0) return i32(5)
            closeResult=1
            if (!state.closeOwned(u32(7))) return i32(6)
        }
        val oldEpoch=state.epoch()
        if (state.matches(oldEpoch) || state.phase() != 0) return i32(7)
        val previousCloses=closes
        if (!state.closeOwned(u32(7)) || closes != previousCloses) return i32(8)
        setupResult=1
        if (open(state) != oldEpoch+1 || !state.matches(oldEpoch+1) || state.matches(oldEpoch) || bad) return i32(9)
        profile=profile+1
    }
    state.initialize(); state.buffer().storeU32(8,2147483647); setups=0
    if (open(state) != 0 || setups != 0) return i32(10)
    state.initialize(); nativeAddressStoreU32(storage,0,9)
    if (open(state) != 0 || state.closeOwned(u32(7)) || setups != 0) return i32(11)
    i32(0)
}
