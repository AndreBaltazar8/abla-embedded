import "../src/esp32/i2c/guarded_setup_esp32s3.ab"
import "../src/esp32/i2c/guarded_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

// Compile the entire setup -> register read -> recovery path together. This
// fixture is never executed on the host and does not claim physical success.
@export("abla_s3_i2c_lifecycle_test")
trusted fun i2cLifecycleTargetTest(gate: PeripheralGate, rcc: AtomicU32,
    owner: u32, port: i32, sda: i32, scl: i32, address: i32,
    output: NativeBuffer, input: NativeBuffer, budget: u32): int {
    val setup = esp32S3I2cSetupGuarded(gate, rcc, owner,
        int(port), int(sda), int(scl), u32(40000000), u32(100000))
    if (setup != 1) return setup
    val transferred = esp32S3I2cTransferGuarded(gate, owner,
        int(port), int(address), output, 1, input, 2, budget)
    if (transferred != 1) {
        // Never substitute recovery's success for the failed transfer result.
        val recovered = esp32S3I2cRecoverGuarded(gate, rcc, owner, int(port), int(sda), int(scl))
    }
    transferred
}
