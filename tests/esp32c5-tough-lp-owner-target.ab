// Whole LP provider -> PMIC/expander -> power/wake graph. Not startup firmware.
// Caller excludes all other HP/LP pad and clock users, owns IOMUX clock, and
// consumes wake reasons first. Owner storage is fresh for operation0 only.
import "../src/esp32/i2c_lp_esp32c5.ab"
import "../src/esp32/gpio/lp_clock_esp32c5.ab"
import "../src/esp32/peripheral_delay_esp32c5.ab"
import "../src/m5stack/tough_power_owner_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_tough_lp_owner_target")
trusted fun ownerTarget(owner: M5ToughPowerOwner,bus: I2cBus,now: int,operation: int,sourceHz: u32,cpuHz: u32): int {
    if (operation == 0) {
        if (!owner.initialize()) return -1
        if (!esp32C5LpGpioEnableClocksOwned()) return -2
        // Source1 = XTAL_D2. sourceHz is its actual rate, not the XTAL rate.
        val opened=i2cMaster(0,2,3,sourceHz,cpuHz,1)
        if (!opened.valid()) return if (esp32C5LpI2cAbortSetup()) -3 else -4
        // Failure retains PMIC/expander handles for explicit cleanup.
        return owner.begin(opened,now)
    }
    if (operation == 1) return if (owner.retryWakeInput()) 1 else 0
    if (operation == 2) {
        if (!owner.close()) return -5
        if (!bus.close()) return -6
        // Only caller-guaranteed exclusive ownership makes this legal.
        return if (esp32C5LpGpioDisableClocksOwned()) 1 else -7
    }
    if (operation == 3) return bus.recoverStatus()
    // Expose current bus key for caller retention after initialization.
    if (operation == 4) return esp32S3I2cBusKey(1,esp32C5LpI2cState().buffer().loadU32(8))
    return -8
}
