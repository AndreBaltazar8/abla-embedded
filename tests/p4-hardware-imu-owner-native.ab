import "../src/esp32/i2c/hardware_provider_p4.ab"
import "../src/m5stack/imu_owner_prepared.ab"
import "../src/m5stack/imu_owner_update.ab"
import "../src/esp32/i2c/hardware_prepared_scan_p4.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(72)
val chip=nativeStaticAllocate(768)
var externalMode=0
var injectedFault=3
var firstMagTransfer=0
var primaryMode=0
var firstPrimaryTransfer=0
var lastPrimaryTransfer=0
var transfers=0
var failedTransfer=0
var bad=false
trusted fun p4I2cSessionClockOpen(port: int,source: int): int { bad=true;return 0 }
trusted fun p4I2cSessionInitialize(port: int,filter: int): int { bad=true;return 0 }
trusted fun p4I2cSessionPinsOpen(r: NativeBuffer,port: int,sda: int,scl: int,pullup: bool,layout: int): int { bad=true;return 0 }
trusted fun p4I2cSessionClockClose(token: int): int = 4102
trusted fun p4I2cSessionPinsClose(r: NativeBuffer): int = 2
trusted fun p4I2cSessionTiming(port: int,t: P4I2cTiming): int {
    if (port != 0 || t != esp32p4I2cTiming(u32(40000000),u32(400000))) bad=true
    return 1
}
trusted fun p4I2cSessionTransfer(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    transfers=transfers+1
    val primaryAddress=if (primaryMode == 0) 105 else if (primaryMode == 4) 108 else 104
    if (address != primaryAddress && !(address == 16 && (externalMode&1) != 0) && !(address == 12 && (externalMode&2) != 0)) { absentCalls=absentCalls+1;return absentFault }
    if (address != primaryAddress && firstMagTransfer == 0) firstMagTransfer=transfers
    if (address == primaryAddress) { if (firstPrimaryTransfer == 0) firstPrimaryTransfer=transfers;lastPrimaryTransfer=transfers }
    if (p4HardwareLoad(0) != 1 || port != 0 || prefix < 0 ||
        (prefix != 94 && prefix+written > 256) || prefix+read > 256 || budget != u32(400000000)) { bad=true;return 7 }
    if (transfers == failedTransfer) return injectedFault
    val regs=nativeBufferAt(chip+(if (address == 16) 256 else if (address == 12) 512 else 0),256)
    if (prefix == 94) {
        if (written != 8192 || read != 0) bad=true
        var at=0
        while (at < written) { if (output.load(at) != nativeBufferAt(bmi270ConfigurationAddress,8192).load(at)) bad=true;at=at+1 }
        uploaded=written;return 1
    }
    if (prefix == 126 && written == 1 && output.load(0) == 182) regs.store(124,1)
    var i=0
    while (i < written) { regs.store(prefix+i,output.load(i));i=i+1 }
    i=0
    while (i < read) { input.store(i,regs.load(prefix+i));i=i+1 }
    if (prefix == 124 && read == 1) { resetPolls=resetPolls+1;input.store(0,if (resetPolls >= resetAfter) 1 else 0) }
    if (prefix == 33 && read == 1) { initPolls=initPolls+1;input.store(0,if (initPolls >= initAfter) 1 else 0) }
    return 1
}
trusted fun seed(): void {
    val r=nativeBufferAt(storage,72);val regs=nativeBufferAt(chip,768)
    var i=0
    while (i < 72) { r.storeU32(i,0);i=i+4 }
    i=0
    while (i < 768) { regs.store(i,0);i=i+1 }
    r.storeU32(0,0x49324234);r.storeU32(4,1);r.storeU32(16,4097);r.storeU32(24,3)
    regs.store(0,36);regs.store(33,1);regs.store(4,50)
    regs.store(320,50);regs.store(512,72)
    externalMode=0;injectedFault=3;firstMagTransfer=0;primaryMode=0;firstPrimaryTransfer=0;lastPrimaryTransfer=0
    uploaded=0;delays=0;resetPolls=0;initPolls=0;resetAfter=1;initAfter=1
    transfers=0;failedTransfer=0;bad=false;return
}
var uploaded=0
var delays=0
var resetPolls=0
var initPolls=0
var resetAfter=1
var initAfter=1
trusted fun imuDelay(ticks: int): void { if (ticks != 1 && ticks != 10) bad=true;delays=delays+ticks;return }
val ownerStorage=nativeStaticAllocate(36)
val snapshotStorage=nativeStaticAllocate(44)
val scratchStorage=nativeStaticAllocate(20)
var absentCalls=0
var absentFault=3
var recoveries=0
var recoveryResult=1
trusted fun p4HardwareProbeReady(r: NativeBuffer): bool {
    if (p4HardwareLoad(0) != 1 || r.loadU32(4) != 1) bad=true
    return true
}
trusted fun p4HardwareRecover(r: NativeBuffer,budget: u32,stopAfterNack: bool): int {
    if (p4HardwareLoad(0) != 1 || r.loadU32(4) != 2 || !stopAfterNack || r.loadU32(8) != 3) bad=true
    recoveries=recoveries+1;return recoveryResult
}
@export("abla_p4_hardware_imu_owner_test")
trusted fun test(): i32 {
    val owner=m5ImuOwnerAt(nativeBufferAt(ownerStorage,36))
    var scenario=0
    while (scenario < 5) {
        seed();absentCalls=0;recoveries=0
        absentFault=if (scenario == 1) 4 else if (scenario == 2) 5 else if (scenario == 3) 6 else 3
        recoveryResult=if (scenario == 4) 4 else 1
        if (!owner.initialize()) return i32(1)
        val bus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
        val result=owner.openPrepared(bus)
        if (result != (if (scenario == 0) 1 else 5) || bad) return i32(2)
        if (scenario == 0) {
            if (!owner.primary().ready() || owner.primary().kind() != m5ImuBmi270 ||
                owner.primary().address() != 105 || absentCalls != 4 || recoveries != 4 ||
                owner.magnetometers().status() != 2) return i32(3)
            val snapshot=imuSnapshotAt(nativeBufferAt(snapshotStorage,44))
            val scratch=nativeBufferAt(scratchStorage,20)
            if (!snapshot.initialize()) return i32(6)
            val registers=nativeBufferAt(chip,256)
            registers.store(29,192);registers.storeU16(12,0x8000);registers.storeU16(18,0x7fff)
            val update=owner.updateSnapshot(snapshot,scratch,1234)
            if (!update.valid() || update.failed() || update.fresh() != 3 || snapshot.axes(0).x() != -32768 ||
                snapshot.axes(1).x() != 32767 || snapshot.timestamp(0) != 1234 || snapshot.has(2)) return i32(7)
            val oldCalls=transfers
            if (owner.updateSnapshot(snapshot,nativeBufferAt(ownerStorage,20),9999).valid() || transfers != oldCalls) return i32(8)
            failedTransfer=transfers+2
            val failed=owner.updateSnapshot(snapshot,scratch,5678)
            if (!failed.failed() || snapshot.timestamp(0) != 1234 || snapshot.timestamp(1) != 1234) return i32(9)
        } else if (absentCalls != 1 || recoveries != (if (scenario == 4) 1 else 0)) return i32(4)
        if (!owner.close() || owner.status() != 0 || owner.primary().handle() != 0 || !bus.close() || bad) return i32(5)
        scenario=scenario+1
    }
    var mode=1
    var magFirst=0
    var magLast=0
    while (mode <= 3) {
        seed();externalMode=mode;absentFault=3;recoveryResult=1
        if (!owner.initialize()) return i32(10)
        val bus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
        if (owner.openPrepared(bus) != 1 || owner.magnetometers().status() != 1 || bad) return i32(11)
        val selected=if (mode == 1) 1 else 2
        if (owner.magnetometers().selected() != selected || (mode == 3 && owner.magnetometers().handle(1) != 0)) return i32(12)
        if (mode == 3) { magFirst=firstMagTransfer;magLast=transfers }
        val regs=nativeBufferAt(chip,768)
        regs.store(29,0)
        regs.store(328,1);regs.storeU16(322,80);regs.storeU16(324,160);regs.storeU16(326,240)
        regs.store(514,1);regs.storeU16(515,10);regs.storeU16(517,20);regs.storeU16(519,30);regs.store(521,0)
        val snapshot=imuSnapshotAt(nativeBufferAt(snapshotStorage,44));val scratch=nativeBufferAt(scratchStorage,20)
        if (!snapshot.initialize()) return i32(13)
        val update=owner.updateSnapshot(snapshot,scratch,100)
        if (update.primaryStatus() != 0 || update.magneticStatus() != 4 || snapshot.timestamp(2) != 100 || !snapshot.axes(2).valid()) return i32(14)
        if (selected == 2 && (snapshot.axes(2).x() != 10 || snapshot.axes(2).y() != 20 || snapshot.axes(2).z() != 30)) return i32(15)
        if (selected == 2) {
            regs.store(521,8)
            val overflow=owner.updateSnapshot(snapshot,scratch,200)
            if (overflow.magneticStatus() != -3 || snapshot.timestamp(2) != 100) return i32(16)
        } else {
            regs.store(328,0)
            if (owner.updateSnapshot(snapshot,scratch,200).magneticStatus() != 0 || snapshot.timestamp(2) != 100) return i32(17)
        }
        if (!owner.close() || !bus.close() || bad) return i32(18)
        mode=mode+1
    }
    // Every optional-sensor startup transaction must stop prepared discovery
    // on arbitration loss, retain the primary handle and permit full cleanup.
    var fault=magFirst
    while (fault <= magLast) {
        seed();externalMode=3;injectedFault=4;failedTransfer=fault
        if (!owner.initialize()) return i32(19)
        val bus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
        if (owner.openPrepared(bus) != 5 || !owner.primary().ready() || transfers != fault ||
            !owner.close() || !bus.close() || bad) return i32(20)
        fault=fault+1
    }
    var primary=1
    while (primary <= 4) {
        seed();primaryMode=primary;absentFault=3;recoveryResult=1
        val regs=nativeBufferAt(chip,256)
        regs.store(117,if (primary == 1) 25 else if (primary == 2) 104 else 113)
        regs.store(48,24)
        if (!owner.initialize()) return i32(21)
        val bus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
        if (owner.openPrepared(bus) != 1 || owner.primary().kind() !=
            (if (primary == 1) m5ImuMpu6886 else if (primary == 2) m5ImuMpu6050 else if (primary == 3) m5ImuMpu9250 else m5ImuSh200q) || bad) return i32(22)
        val beginFirst=firstPrimaryTransfer;val beginLast=lastPrimaryTransfer
        val snapshot=imuSnapshotAt(nativeBufferAt(snapshotStorage,44));val scratch=nativeBufferAt(scratchStorage,20)
        if (!snapshot.initialize()) return i32(23)
        val base=if (primary == 4) 0 else 59
        regs.store(if (primary == 4) 44 else 58,if (primary == 4) 32 else 1)
        var i=0
        while (i < 14) { regs.store(base+i,0);i=i+1 }
        if (primary == 4) { regs.storeU16(0,0x8000);regs.storeU16(6,0x7fff) }
        else { regs.store(59,128);regs.store(60,0);regs.store(67,127);regs.store(68,255) }
        if (owner.updateSnapshot(snapshot,scratch,9876).fresh() != 3 ||
            snapshot.axes(0).x() != -32768 || snapshot.axes(1).x() != 32767 || snapshot.timestamp(1) != 9876) return i32(24)
        if (!owner.close() || !bus.close() || bad) return i32(25)
        fault=beginFirst
        while (fault <= beginLast) {
            seed();primaryMode=primary;injectedFault=4;failedTransfer=fault
            regs.store(117,if (primary == 1) 25 else if (primary == 2) 104 else 113);regs.store(48,24)
            if (!owner.initialize()) return i32(26)
            val failedBus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
            if (owner.openPrepared(failedBus) != 5 || transfers != fault ||
                !owner.close() || !failedBus.close() || bad) return i32(27)
            fault=fault+1
        }
        primary=primary+1
    }
    return i32(0)
}
