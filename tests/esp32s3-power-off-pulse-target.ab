import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/power_off_pulse.ab"
import "abla/runtime/scalar"
import "abla/build"
// Cross-board codegen check only, not a flash image for P4/C6 boards.
@export("abla_power_off_pulse_target")
trusted fun pulseTarget(board: M5BoardId,context: NativeBuffer,handle: int,now: u32,begin: bool,released: bool,gpio: bool): int {
    if (!begin) return m5PowerOffPulsePoll(context,now)
    if (gpio) return board.beginPowerHoldOffPulse(context,now,released)
    board.beginPowerOffPulse(context,handle,now,released)
}
