import "../src/m5stack/tab5_channels_window_sequence.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
val memory=nativeStaticAllocate(1024)
var scenario=0
var writes=0
var sourceBlocks=0
var silenceBlocks=0
var delays=0
var closes=0
var bad=false
var expectedTail=0
var savedCursor=0
var queuedMode=false
val retryBytes=nativeStaticAllocate(16)
trusted fun report(r: NativeBuffer,status: int): int { r.storeU32(48,status);return if (status == 1 || status == 3) 2 else 3 }
fun m5P4SpeakerSessionValid(r: NativeBuffer,tab5: bool): bool = tab5 && r.hasAddressRange(0,192) && r.loadU32(64) == 0x54355331
fun esp32p4AhbGdmaRingLayoutValid(desc: int,count: int,payload: int,stride: int,bytes: int): bool =
    desc == 0x4ff00000 && count == 2 && payload == 0x4ff40000 && bytes == 16 && stride == 64
trusted fun m5P4SpeakerPumpOwned(r: NativeBuffer,buffer: NativeBuffer,tab5: bool): int {
    val exclusive=tab5
    writes=writes+1
    if (buffer.addressValue() != memory+512 || buffer.capacity() != 16 || !exclusive) bad=true
    val silence=buffer.loadU32(0) == 0
    if (queuedMode && !silence && sourceBlocks == 0 &&
        (buffer.loadU16(0) != 10000 || buffer.loadU16(2) != 10000 || buffer.loadU16(4) != 17920)) bad=true
    if (scenario == 0) {
        val saved=nativeBufferAt(retryBytes,16);var offset=0
        while (offset < 16) {
            if ((writes&1) != 0) saved.store(offset,buffer.load(offset))
            else if (saved.load(offset) != buffer.load(offset)) bad=true
            offset=offset+1
        }
    }
    if (scenario == 1 && !silence) return report(r,3)
    if ((scenario == 2 && !silence) || (scenario == 4 && silence)) { r.storeU32(68,3);return report(r,4) }
    if (scenario == 3 && silence) return report(r,3)
    // Alternate busy/success for the normal case, including the silence tail.
    if (scenario == 0 && (writes&1) != 0) return report(r,3)
    if (silence) {
        if (sourceBlocks != 3) bad=true
        val cursor=nativeAddressLoadU32(memory+192,16)
        if (silenceBlocks == 0) savedCursor=cursor else if (cursor != savedCursor) bad=true
        var offset=0
        while (offset < 16) { if (buffer.load(offset) != u8(0)) bad=true;offset=offset+1 }
        silenceBlocks=silenceBlocks+1
    } else sourceBlocks=sourceBlocks+1
    r.storeU32(40,1-r.loadU32(40))
    return report(r,1)
}
trusted fun m5P4SpeakerStopOwned(r: NativeBuffer,tab5: bool): int {
    val exclusive=tab5
    closes=closes+1
    if (!exclusive || ((scenario == 0 || scenario == 5) && silenceBlocks != expectedTail)) bad=true
    r.storeU32(68,if (scenario == 5) 3 else 4)
    return if (scenario == 5) 3 else 4
}
fun peripheralDelayMilliseconds(ms: int): void { if (ms != 1) bad=true;delays=delays+1;return }
@export("abla_tab5_channels_window_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(memory,192);val acc=nativeBufferAt(memory+320,64)
    val scratch=nativeBufferAt(memory+448,32);val staging=nativeBufferAt(memory+512,16)
    val source=nativeBufferAt(memory+256,64)
    var i=0
    while (i < 32) { source.storeU16(i*2,10000);i=i+1 }
    val wav=pcmRaw(source,nativeBufferAt(memory+224,20),24000,2,16)
    var mode=0
    while (mode < 3) {
        queuedMode=mode == 2
        expectedTail=363
        scenario=0
        while (scenario <= 6) {
            writes=0;sourceBlocks=0;silenceBlocks=0;delays=0;closes=0
            val bank=pcmChannelsAt(nativeBufferAt(memory+192,32),1,24000)
            if (bank.enqueue(wav,0) != 0) return i32(1)
            r.storeU32(64,0x54355331);r.storeU32(68,2);r.storeU32(12,1)
            r.storeU32(20,0x4ff00000);r.storeU32(24,2);r.storeU32(28,0x4ff40000);r.storeU32(32,64);r.storeU32(36,16);r.storeU32(40,0)
            val tone=if (mode >= 1) pcmToneWaveAt(nativeBufferAt(memory+600,40),nativeBufferAt(pcmToneWave,16),true,24000,440123,4294967295) else PcmTone(0)
            val queues=pcmSourceQueuesAt(nativeBufferAt(memory+704,32),1,24000)
            if (queuedMode) {
                bank.stop()
                val shortWav=pcmRaw(nativeBufferAt(source.addressValue(),8),nativeBufferAt(memory+752,20),24000,2,16)
                if (bank.enqueue(shortWav,1) != 0 || queues.enqueue(pcmPlaybackChannel(bank.channel(0))) != 0 ||
                    queues.enqueue(pcmPlaybackTone(tone),0) != 0) return i32(7)
            }
            val target=if (scenario == 6) nativeBufferAt(memory+512,1) else staging
            val result=if (queuedMode) tab5PlaybackSourceQueuesWindowOwned(r,queues,3,acc,scratch,target,3,32768,true)
                else tab5PlaybackChannelsWindowOwned(r,bank,3,acc,scratch,target,3,32768,true,tone)
            if (tone != 0) {
                val rendered=if (scenario == 6) 0 else if (scenario == 1 || scenario == 2) 1 else 3
                if (tone.storage().loadU32(12) != ((rendered*8-(if (queuedMode && rendered != 0) 2 else 0))*440123)%24000000) return i32(6)
            }
            val status=if (scenario == 0) 1 else if (scenario == 1 || scenario == 3) 3 else if (scenario == 5) 10 else if (scenario == 6) 2 else 4
            if (result.status() != status || result.queuedBlocks() != sourceBlocks || bad || closes != (if (scenario == 6) 0 else 1)) return i32(2)
            if (scenario == 6 && (writes != 0 || r.loadU32(68) != 2 || bank.channel(0).storage().loadU32(16) != 0)) return i32(3)
            if ((scenario == 1 || scenario == 3) && delays != 2) return i32(4)
            if (scenario == 0 && (sourceBlocks != 3 || silenceBlocks != expectedTail || delays != 3+expectedTail)) return i32(5)
            scenario=scenario+1
        }
        mode=mode+1
    }
    return i32(0)
}
