import "../src/power/pm1_battery_presence.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pm1_battery_presence_target")
trusted fun presenceTarget(state: Pm1BatteryPresence,enabled: I2cByteResult,chargeStat: I2cByteResult,
    nodeDown: bool,voltage: I2cWordResult,now: int): int = state.observe(enabled,chargeStat,nodeDown,voltage,now)
