import "../src/storage/fat_directory_read.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_directory_read_target")
trusted fun target(reader: int,boot: int,first: int,sectors: int,start: int,ordinal: int,budget: int,destination: int,scratch: int): int =
    fatDirectoryReadOwned(nativeBufferAt(reader,28),nativeBufferAt(boot,512),first,sectors,start,ordinal,budget,nativeBufferAt(destination,512),nativeBufferAt(scratch,1024)).status()
