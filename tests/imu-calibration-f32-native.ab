import "../src/imu/calibration_f32.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_calibration_f32_test")
trusted fun calibrationFloatTest(dx: int,dy: int,dz: int,radius: i32,tolerance: i32,stillness: i32,strength: i32): int =
    imuCalibrationFloatDelta(dx,imuCalibrationFloatGain(dx,dy,dz,int(radius),int(tolerance),int(stillness),int(strength)))
@export("abla_imu_calibration_offset_test")
trusted fun calibrationOffsetTest(dx: int,dy: int,dz: int,radius: i32,tolerance: i32,stillness: i32,strength: i32,offset: i32): int =
    imuCalibrationFloatOffset(int(offset),dx,imuCalibrationFloatGain(dx,dy,dz,int(radius),int(tolerance),int(stillness),int(strength)))
@export("abla_imu_calibration_limits_test")
trusted fun calibrationLimitsTest(dx: int,dy: int,dz: int,radius: u32,tolerance: u32,stillness: i32,strength: i32): int =
    imuCalibrationFloatDelta(dx,imuCalibrationFloatGainWithLimits(dx,dy,dz,f32FromBits(radius),f32FromBits(tolerance),int(stillness),int(strength)))
