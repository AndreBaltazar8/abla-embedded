import "../src/m5stack/rtc_wake_profile.ab"
import "../src/m5stack/rtc_wake_cleanup_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
// Cleanup functions are not exercised here; reject accidental I/O calls.
fun m5RtcCleanupRtcValid(handle: int): bool = false
fun m5RtcCleanupPmicValid(handle: int): bool = false
fun m5RtcCleanupRtc(handle: int,disable: bool): bool = false
fun m5RtcCleanupWake(handle: int): bool = false
fun m5RtcCleanupPmicIrq(handle: int): bool = false
@export("abla_rtc_wake_profile_test")
fun profileTest(): i32 {
    var id=-1
    while (id <= 513) {
        val board=M5BoardId(id)
        val expected=if (board == m5BoardPaperColor) 7 else if (board == m5BoardStampPLC) 14 else
            if (board == m5BoardStackCoreInk) 19 else if (board == m5BoardStickC || board == m5BoardStickCPlus) 35 else
            if (board == m5BoardPaperMono) 1 else if (board == m5BoardToughC5) 4 else -1
        val profile=board.rtcWakeProfile()
        if (profile.valid() != (expected >= 0) || profile.pinNumber() != expected || profile.activeLow() != (expected >= 0) ||
            profile.throughPmic() != board.rtcNeedsPmicCleanup()) return i32(1)
        id=id+1
    }
    var value=0
    while (value < 1024) {
        val profile=M5RtcWakeProfile(value)
        val valid=value >= 320 && value <= 447
        if (profile.valid() != valid || (!valid && (profile.pinNumber() != -1 || profile.activeLow() || profile.throughPmic()))) return i32(2)
        value=value+1
    }
    if (M5RtcWakeProfile(-1).valid()) return i32(3)
    i32(0)
}
