import "../src/storage/fat_allocation_audit.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1564)
var calls=0
var failure=0
var mode=0
var bad=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,sector: int,output: NativeBuffer): bool {
    calls=calls+1
    if (sector != 101 && sector != 102) bad=true
    var at=0;while (at < 512) { output.store(at,0);at=at+1 }
    if (sector == 101) {
        output.storeU16(4,3);output.storeU16(6,if (mode == 2) 0 else 65535)
        output.storeU16(8,if (mode == 1) 65535 else if (mode == 3) 65520 else if (mode == 4) 20000 else 0)
        output.storeU16(10,65527)
    }
    return calls != failure
}
@export("abla_fat_allocation_audit_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(storage,512);val reader=nativeBufferAt(storage+512,28);val scratch=nativeBufferAt(storage+540,1024)
    val tracker=fatClusterOwnershipAt(nativeBufferAt(nativeStaticAllocate(1266),1266))
    var i=0;while (i < 512) { boot.store(i,0);i=i+1 }
    boot.store(12,2);boot.store(13,1);boot.store(14,1);boot.store(16,2);boot.store(18,2)
    boot.store(22,40);boot.store(19,129);boot.store(20,39);boot.store(510,85);boot.store(511,170)
    val clusters=fatBootValidate(boot,100,10113).clusters()
    while (mode < 5) {
        tracker.initialize(clusters);tracker.claim(2);tracker.claim(3);calls=0
        val result=fatAuditAllocationRangeOwned(reader,boot,100,10113,2,254,1,scratch,tracker)
        val expected=if (mode == 0) 1 else if (mode == 1) 7 else if (mode == 2) 8 else 4
        if (result.status() != expected || calls != 1 || tracker.storage().loadU32(8) != 2 || bad) return i32(1)
        if (result.detail() != (if (mode == 0) 254 else if (mode == 2) 3 else 4)) return i32(2)
        if (mode == 3 && result.linkStatus() != 5) return i32(3)
        if (mode == 4 && result.linkStatus() != 6) return i32(4)
        mode=mode+1
    }
    mode=0;calls=0
    if (fatAuditAllocationRangeOwned(reader,boot,100,10113,2,255,1,scratch,tracker).status() != 6 || calls != 1) return i32(5)
    calls=0
    if (fatAuditAllocationRangeOwned(reader,boot,100,10113,2,255,2,scratch,tracker).status() != 1 || calls != 2) return i32(6)
    failure=2;calls=0
    if (fatAuditAllocationRangeOwned(reader,boot,100,10113,2,255,2,scratch,tracker).status() != 3 || calls != 2) return i32(7)
    failure=0;calls=0;tracker.claim(5)
    val claimedBad=fatAuditAllocationRangeOwned(reader,boot,100,10113,5,1,1,scratch,tracker)
    if (claimedBad.status() != 8 || claimedBad.detail() != 5 || claimedBad.linkStatus() != 4) return i32(8)
    tracker.claim(2);calls=0
    if (fatAuditAllocationRangeOwned(reader,boot,100,10113,2,1,1,scratch,tracker).status() != 5 || calls != 0) return i32(9)
    if (fatAuditAllocationRangeOwned(reader,boot,100,10113,1,1,1,scratch,tracker).status() != 2 ||
        fatAuditAllocationRangeOwned(reader,boot,100,10113,clusters+1,2,1,scratch,tracker).status() != 2 || calls != 0) return i32(10)
    return i32(0)
}
