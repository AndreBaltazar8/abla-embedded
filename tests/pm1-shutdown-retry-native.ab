import "../src/m5stack/pm1_shutdown_retry_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(24)
var calls=0
var success=0
var bad=false
fun m5PmicShutdownWrite(handle: int,kind: int,preserve: bool): bool {
    calls=calls+1
    if (handle != 7 || kind != 5 || preserve) bad=true
    calls == success
}
@export("abla_pm1_shutdown_retry_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,24)
    val pmic=M5PmicOpen(7|(5<<32)|(1<<40))
    while (success < 4) {
        calls=0;record.storeU32(0,0)
        var result=pmic.beginShutdownRetryOwned(record,true)
        var now=u32(4294967290)
        while (result == 2) {
            val before=calls
            if (pmic.beginShutdownRetryOwned(record,true) != 3 || calls != before) return i32(1)
            // First poll can be arbitrarily late: it only starts the delay.
            now=now+u32(1000)
            if (m5Pm1ShutdownRetryPoll(record,now) != 2 || calls != before ||
                m5Pm1ShutdownRetryPoll(record,now+u32(9)) != 2 || calls != before) return i32(2)
            now=now+u32(10)
            result=m5Pm1ShutdownRetryPoll(record,now)
            if (calls != before+1) return i32(3)
        }
        if (result != (if (success == 0) 4 else 1) || calls != (if (success == 0) 3 else success) || bad ||
            m5Pm1ShutdownRetryPoll(record,now+u32(100)) != result || record.loadU32(8) != calls) return i32(4)
        success=success+1
    }
    calls=0
    if (pmic.beginShutdownRetryOwned(record,false) != 3 ||
        M5PmicOpen(7|(3<<32)|(1<<40)).beginShutdownRetryOwned(record,true) != 3 ||
        pmic.beginShutdownRetryOwned(nativeBufferAt(memory,23),true) != 3 || calls != 0) return i32(5)
    return i32(0)
}
