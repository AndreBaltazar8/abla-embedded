import "./pm1-control-wire-native.ab"
import "../src/m5stack/c6_gauge.ab"
// Gauge reset/unseal initialization must never run during read-only telemetry.
trusted fun peripheralDelayMilliseconds(milliseconds: int): void { bad=true;return }
@export("abla_c6_gauge_wire_test")
trusted fun testGauge(): i32 {
    wireSeed();chargeAddress=85
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(85,100000)
    val gauge=Bq27220(device|0);val board=m5BoardArduinoNessoN1
    val r=nativeBufferAt(chargeRegisters,256)
    if (!device.valid()) return i32(1)
    var sample=0
    while (sample < 65536) {
        r.storeU16(8,sample);r.storeU16(20,sample)
        var fault=0
        while (fault <= 3) {
            var before=ackCount;nackAt=if (fault == 0) 0 else before+fault
            val voltage=board.readBatteryMillivoltsOwned(gauge,true)
            if (voltage.status() != (if (fault == 0) 1 else 4) ||
                (voltage.valid() && voltage.millivolts() != sample) || ackCount-before != (if (fault == 0) 3 else fault)) return i32(2)
            before=ackCount;nackAt=if (fault == 0) 0 else before+fault
            val level=board.readBatteryLevelOwned(gauge,true)
            val expected=if (sample <= 3300) 0 else if (sample >= 4100) 100 else (sample-3300)/8
            if (level.status() != (if (fault == 0) 1 else 4) || (level.valid() && level.percent() != expected) ||
                ackCount-before != (if (fault == 0) 3 else fault)) return i32(3)
            before=ackCount;nackAt=if (fault == 0) 0 else before+fault
            val current=gauge.currentMilliampsChecked()
            if (current.valid() != (fault == 0) || (current.valid() && current.value() != (if (sample < 32768) sample else sample-65536)) ||
                ackCount-before != (if (fault == 0) 3 else fault) || r.loadU16(8) != sample || r.loadU16(20) != sample || bad) return i32(4)
            fault=fault+1
        }
        sample=sample+1
    }
    val before=ackCount
    if (board.readBatteryMillivoltsOwned(gauge,false).status() != 2 || board.readBatteryLevelOwned(Bq27220(0),true).status() != 2 ||
        m5BoardUnitC6L.readBatteryLevelOwned(gauge,true).status() != 3 || ackCount != before) return i32(5)
    nackAt=0
    if (!device.close() || gauge.currentMilliampsChecked().valid() || board.readBatteryMillivoltsOwned(gauge,true).valid() ||
        ackCount != before || !bus.close() || pads != 0 || bad) return i32(6)
    return i32(0)
}
