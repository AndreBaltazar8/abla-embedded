import "../src/m5stack/axp_power.ab"
import "../src/m5stack/stamp_charge.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var calls=0
var fail=false
var bad=false
var expectedRegister=0
var expectedMask=0
var expectedValue=0
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    calls=calls+1
    if (this != 7 || register != expectedRegister || mask != expectedMask || value != expectedValue) bad=true
    !fail
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    if (this != 7 || register != expectedRegister || expectedMask != 255 || value != expectedValue) bad=true
    !fail
}
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.readRegister16BigEndianChecked(register: int): I2cWordResult { bad=true; return I2cWordResult(0) }
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true; return I2cWordResult(0) }
fun I2cDevice.readRegister24BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
@export("abla_charger_control_test")
fun chargerTest(): i32 {
    var profile=0
    while (profile < 60012) {
        val value=profile%5001
        val mode=(profile/5001)%3
        val newer=(profile/15003)%2 != 0
        fail=profile >= 30006; calls=0; bad=false
        val power=M5AxpPower(7|((if (newer) 74 else 3)<<32)|(5<<40))
        expectedRegister=if (!newer) 51 else if (mode == 0) 24 else if (mode == 1) 98 else 100
        expectedMask=if (newer) (if (mode == 0) 2 else 255) else if (mode == 0) 128 else if (mode == 1) 15 else 96
        expectedValue=if (mode == 0) (if (value != 0) expectedMask else 0) else if (mode == 1)
            (if (newer) axp2101ChargeCurrentCode(value) else axp192ChargeCurrentCode(value)) else
            (if (newer) axp2101ChargeVoltageCode(value) else axp192ChargeVoltageCode(value)<<5)
        val result=if (mode == 0) power.setBatteryCharge(value != 0) else if (mode == 1) power.setChargeCurrent(value) else power.setChargeVoltage(value)
        if (result != !fail || calls != 1 || bad) return i32(1)
        profile=profile+1
    }
    profile=0
    while (profile < 131072) {
        val value=profile & 65535
        fail=profile >= 65536; calls=0; bad=false
        expectedRegister=17; expectedMask=8; expectedValue=if (value < 650) 8 else 0
        if (m5BoardStampS3Bat.setStampChargeCurrent(M5Pm1(7),value) != !fail || calls != 1 || bad) return i32(2)
        profile=profile+1
    }
    calls=0
    val power=M5AxpPower(7|(3<<32)|(5<<40))
    if (power.setChargeCurrent(-1) || power.setChargeVoltage(-1) || M5AxpPower(0).setBatteryCharge(true) ||
        m5BoardAtomVoice.setStampChargeCurrent(M5Pm1(7),650) ||
        m5BoardStampS3Bat.setStampChargeCurrent(M5Pm1(4294967296),650) ||
        m5BoardStampS3Bat.setStampChargeCurrent(M5Pm1(7),-1) ||
        m5BoardStampS3Bat.setStampChargeCurrent(M5Pm1(7),65536) || calls != 0) return i32(3)
    i32(0)
}
