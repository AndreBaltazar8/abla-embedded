import "../src/storage/fat_mirror_audit.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(1564)
var reserved=1
var length=3
var used=0
var bits=12
var change=-1
var padding=false
var calls=0
var fail=0
var bad=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    calls=calls+1
    if (calls == fail) return false
    val mirror=lba >= reserved+length
    val part=lba-reserved-(if (mirror) length else 0)
    if (part < 0 || part >= length) { bad=true;return false }
    var at=0
    while (at < 512) {
        val offset=part*512+at
        var value=0x5a
        if (mirror && offset == change) value=value^1
        if (mirror && padding && ((bits == 32 && (offset&3) == 3) || offset >= used || (bits == 12 && offset == used-1))) value=value^0xf0
        output.store(at,value);at=at+1
    }
    return true
}
@export("abla_fat_mirror_audit_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(memory,512);val reader=nativeBufferAt(memory+512,28);val scratch=nativeBufferAt(memory+540,1024)
    var format=0
    while (format < 3) {
        var at=0;while (at < 512) { boot.store(at,0);at=at+1 }
        boot.storeU16(11,512);boot.store(13,1);boot.store(16,2);boot.storeU16(510,0xaa55)
        var total=1008
        if (format == 0) { bits=12;reserved=1;length=3;boot.storeU16(17,32) }
        else if (format == 1) { bits=16;reserved=1;length=40;total=10113;boot.storeU16(17,512) }
        else { bits=32;reserved=32;length=600;total=70000;boot.storeU32(44,2);boot.storeU32(36,length) }
        boot.storeU16(14,reserved)
        if (format < 2) { boot.storeU16(22,length);boot.storeU16(19,total) } else boot.storeU32(32,total)
        val entries=fatBootValidate(boot,0,total).clusters()+2
        used=if (bits == 12) entries+entries/2+(entries&1) else entries*(bits/8)
        val required=((used+511)/512)*2
        calls=0;change=-1;padding=true
        val valid=fatAuditMirrorsOwned(reader,boot,0,total,required,scratch)
        if (valid.status() != 1 || valid.reads() != required || calls != required || bad) return i32(1)
        var location=0
        while (location < 3) {
            change=if (location == 0) 0 else if (location == 1) 511 else used-1;calls=0
            val mismatch=fatAuditMirrorsOwned(reader,boot,0,total,required,scratch)
            if (mismatch.status() != 4 || mismatch.offset() != change || bad) return i32(2)
            location=location+1
        }
        change=-1;calls=0
        if (fatAuditMirrorsOwned(reader,boot,0,total,required-1,scratch).status() != 5 || calls != required-2) return i32(3)
        fail=2;calls=0
        if (fatAuditMirrorsOwned(reader,boot,0,total,required,scratch).status() != 3 || calls != 2) return i32(4)
        fail=0;calls=0;boot.store(16,1)
        if (fatAuditMirrorsOwned(reader,boot,0,total,required,scratch).status() != 1 || calls != 0) return i32(5)
        boot.store(16,2)
        if (format == 2) {
            boot.storeU16(40,129)
            if (fatAuditMirrorsOwned(reader,boot,0,total,required,scratch).status() != 6 || calls != 0) return i32(6)
        }
        format=format+1
    }
    return i32(0)
}
