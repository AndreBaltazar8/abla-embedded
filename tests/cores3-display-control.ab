import "../src/i2c/register_access.ab"
import "../src/m5stack/cores3_display_control.ab"
type I2cBus = int
type I2cDevice = int
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int, frequency: int): I2cDevice = I2cDevice(1)
fun I2cDevice.close(): bool = true
var registers = 0
var steps = 0
var failure = -1
var delayCount = 0
var bad = false
fun I2cDevice.readRegister(register: int, bytes: NativeBuffer, length: int): bool = false
fun I2cDevice.writeRegister(register: int, bytes: NativeBuffer, length: int): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    steps = steps + 1
    if (steps == failure) return I2cByteResult(0)
    I2cByteResult(256 | int(nativeAddressLoadU32(registers, register * 4)))
}
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool {
    steps = steps + 1
    if (steps == failure) return false
    nativeAddressStoreU32(registers, register * 4, value)
    true
}
fun peripheralDelayMicroseconds(duration: int): void { bad = true; return }
fun peripheralDelayMilliseconds(duration: int): void {
    if (duration != (if (delayCount == 0) 8 else 64)) bad = true
    delayCount = delayCount + 1
    return
}
trusted fun reset(): void {
    var index = 0
    while (index < 256) {
        nativeAddressStoreU32(registers, index * 4, 165)
        index = index + 1
    }
    steps = 0
    failure = -1
    delayCount = 0
    return
}
trusted fun at(register: int): int = int(nativeAddressLoadU32(registers, register * 4))
trusted fun main(): int {
    registers = nativeStackAllocate(1024)
    reset()
    if (!cores3DisplayReset(Aw9523(1)) || steps != 8 || delayCount != 2 || bad) return 1
    if (at(3) != 167 || at(19) != 167 || at(5) != 165 || at(127) != 165) return 2
    var index = 0
    while (index < 256) {
        if (index != 3 && index != 19 && at(index) != 165) return 10
        index = index + 1
    }
    var fail = 1
    while (fail <= 8) {
        reset()
        failure = fail
        if (cores3DisplayReset(Aw9523(1)) || steps != fail || delayCount != (if (fail > 6) 1 else 0)) return 3
        fail = fail + 1
    }
    var brightness = 0
    while (brightness <= 255) {
        reset()
        if (!cores3DisplaySetBrightness(Axp2101(1), brightness) || steps != 3) return 4
        val code = if (brightness == 0) 0 else (brightness + 641) / 32
        if (at(153) != code || at(144) != (if (brightness == 0) 37 else 165)) return 5
        brightness = brightness + 1
    }
    fail = 1
    while (fail <= 3) {
        reset()
        failure = fail
        if (cores3DisplaySetBrightness(Axp2101(1), 255) || steps != fail) return 6
        if (at(153) != (if (fail == 1) 165 else 28) || at(144) != 165) return 11
        reset()
        failure = fail
        if (cores3DisplaySetBrightness(Axp2101(1), 0) || steps != fail) return 7
        if (at(153) != 165 || at(144) != (if (fail == 3) 37 else 165)) return 12
        fail = fail + 1
    }
    reset()
    if (cores3DisplaySetBrightness(Axp2101(0), 1) || cores3DisplaySetBrightness(Axp2101(1), -1) ||
        cores3DisplaySetBrightness(Axp2101(1), 256) || cores3DisplayReset(Aw9523(0)) || steps != 0) return 8
    if (bad) 9 else 0
}
