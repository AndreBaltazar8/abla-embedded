import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/adc_oneshot_c5_sequence.ab"
var onetime=u32(0)
var events=u32(0)
var raw=0
var writes=0
var drop=0
var delays=0
var phase=0
var stalled=false
var bad=false
trusted fun c5AdcClockRead(offset: int): u32 = if (offset == 0) u32(4) else if (offset == 4) u32(0x40f040) else u32(0x100)
trusted fun c5AdcClockWrite(offset: int,value: u32): void { bad=true;return }
trusted fun c5AdcTrimField(reg: int,low: int,high: int,value: int): int { bad=true;return -1 }
trusted fun c5AdcRead(offset: int): u32 = if (offset == 0) u32(0x38000040) else if (offset == 0x20) onetime else if (offset == 0x44) events else if (offset == 0x2c) u32(raw)|u32(0xabc00000) else u32(0)
trusted fun c5AdcWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0x4c) {
        if (value != u32(0x80000000)) bad=true
        events=events&~value
    } else if (offset == 0x20) {
        if ((value&u32(0x20000000)) != u32(0) && (onetime&u32(0x20000000)) == u32(0)) phase=1
        if ((value&u32(0x20000000)) == u32(0) && (onetime&u32(0x20000000)) != u32(0)) {
            if (phase != 2) bad=true
            phase=3
        }
        onetime=value
    } else bad=true
    return
}
trusted fun c5AdcDelayMicros(microseconds: int): void {
    if (microseconds != 3) bad=true
    delays=delays+1
    if (phase == 1) phase=2
    else if (phase == 3) { phase=4;if (!stalled) events=events|u32(0x80000000) }
    return
}
@export("abla_adc_oneshot_c5_test")
trusted fun test(): i32 {
    var channel=0
    while (channel < 6) {
        var attenuation=0
        while (attenuation < 4) {
            raw=0
            while (raw < 4096) {
                onetime=u32(channel*4+attenuation)<<u32(23);events=u32(0x80000001);writes=0;delays=0;phase=0;drop=0
                var conversion=c5AdcConversionStartOwned(channel,attenuation,40000000,true)
                if (conversion.status() != 8 || delays != 2 || phase != 4 || events != u32(0x80000001)) return i32(1)
                val before=writes
                conversion=conversion.waitOwned(1,true)
                if (conversion.status() != 1 || conversion.raw() != raw || writes != before) return i32(2)
                conversion=conversion.releaseOwned(true)
                if (conversion.status() != 7 || onetime != (u32(channel*4+attenuation)<<u32(23)) || bad) return i32(3)
                raw=raw+1
            }
            attenuation=attenuation+1
        }
        channel=channel+1
    }
    onetime=u32(0);events=u32(1);phase=0;writes=0;stalled=true
    var conversion=c5AdcConversionStartOwned(0,0,40000000,true)
    val before=writes
    conversion=conversion.waitOwned(3,true)
    if (conversion.status() != 8 || writes != before) return i32(4)
    conversion=conversion.releaseOwned(true)
    if (conversion.status() != 8 || writes != before || c5AdcConversionStartOwned(0,0,40000000,true).status() != 4) return i32(5)
    events=events|u32(0x80000000);raw=123
    conversion=conversion.waitOwned(1,true)
    if (conversion.raw() != 123 || writes != before) return i32(6)
    conversion=conversion.releaseOwned(true)
    if (conversion.status() != 7) return i32(7)
    stalled=false
    var fault=1
    while (fault <= 5) {
        onetime=u32(0);events=u32(0x80000001);phase=0;writes=0;drop=fault
        conversion=c5AdcConversionStartOwned(0,0,40000000,true)
        if (fault == 1) { if (conversion.status() != 5 || writes != 1) return i32(8) }
        else if (fault == 2) {
            if (conversion.status() != 6 || (conversion&8192) != 0) return i32(9)
            drop=0;conversion=conversion.releaseOwned(true)
            if (conversion.status() != 7) return i32(10)
        } else if (fault == 3 || fault == 4) {
            if (conversion.status() != 6 || (conversion&8192) == 0) return i32(11)
            val count=writes
            conversion=conversion.waitOwned(1,true);conversion=conversion.releaseOwned(true)
            if (conversion.status() == 7 || writes != count) return i32(12)
        } else {
            conversion=conversion.waitOwned(1,true);conversion=conversion.releaseOwned(true)
            if (conversion.status() != 6) return i32(13)
            drop=0;conversion=conversion.releaseOwned(true)
            if (conversion.status() != 7) return i32(14)
        }
        fault=fault+1
    }
    if (bad) return i32(15)
    return i32(0)
}
