import "../src/m5stack/corep4x_microphone_process_sequence.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
val memory=nativeStaticAllocate(4096)
val session=nativeBufferAt(memory,192)
val state=nativeBufferAt(memory+192,40)
val reference=nativeBufferAt(memory+232,40)
val raw=nativeBufferAt(memory+272,64)
val output=nativeBufferAt(memory+1024,256)
val expected=nativeBufferAt(memory+1280,256)
var calls=0
var status=1
var actual=64
fun m5P4MicrophoneSessionValid(r: NativeBuffer,tab5: bool): bool = !tab5 && r.hasAddressRange(0,192) && r.loadU32(64) == 0x43504d31
fun esp32p4AhbGdmaRingLayoutValid(d: int,n: int,p: int,s: int,b: int): bool =
    d == memory+384 && n == 2 && p == memory+640 && s == 128 && b == 64
trusted fun m5P4MicrophonePumpOwned(r: NativeBuffer,d: NativeBuffer,tab5: bool): int {
    val e=!tab5
    calls=calls+1
    r.storeU32(48,status|(actual << 16));r.storeU32(52,0)
    if (status == 1) {
        var i=0
        while (i+2 <= actual && i < 64) { d.storeU16(i,i*1719-32768);i=i+2 }
    }
    if (status != 1 && status != 3 && status != 2) { r.storeU32(68,3);return 3 }
    return 2
}
fun equal(a: NativeBuffer,b: NativeBuffer,bytes: int): bool {
    var n=0;while (n < bytes) { if (a.load(n) != b.load(n)) return false;n=n+1 };return true
}
@export("abla_corep4x_microphone_process_test")
trusted fun test(): i32 {
    session.storeU32(64,0x43504d31);session.storeU32(68,2);session.storeU32(12,0)
    session.storeU32(20,memory+384);session.storeU32(24,2);session.storeU32(28,memory+640)
    session.storeU32(32,128);session.storeU32(36,64)
    var os=1
    while (os <= 8) {
        var format=0
        while (format < 4) {
            val stereo=(format&1) != 0;val bits16=(format&2) != 0
            microphoneProcessInitialize(state,os,2,128,true,false,false)
            microphoneProcessInitialize(reference,os,2,128,true,false,false)
            actual=4
            while (actual <= 64) {
                status=3;calls=0
                if (coreP4xMicrophoneProcessBlockOwned(session,state,raw,output,stereo,bits16,true).status() != 3 ||
                    calls != 1 || !equal(state,reference,40)) return i32(1)
                status=1
                val result=coreP4xMicrophoneProcessBlockOwned(session,state,raw,output,stereo,bits16,true)
                val samples=microphoneProcess(reference,raw,actual/4,expected,stereo,bits16)
                if (result.status() != 1 || result.samples() != samples || !equal(state,reference,40) ||
                    !equal(output,expected,samples*(if (bits16) 2 else 1))) return i32(2)
                actual=actual+4
            }
            format=format+1
        }
        os=os+1
    }
    microphoneProcessInitialize(state,1,2,0,true,false,false)
    microphoneProcessInitialize(reference,1,2,0,true,false,false)
    calls=0
    var alias=0
    while (alias < 4) {
        val address=if (alias == 0) memory+128 else if (alias == 1) memory+400 else if (alias == 2) memory+736 else memory+884
        if (coreP4xMicrophoneProcessBlockOwned(session,state,raw,nativeBufferAt(address,128),false,true,true).status() != 2 ||
            coreP4xMicrophoneProcessBlockOwned(session,state,nativeBufferAt(address,64),output,false,true,true).status() != 2 || calls != 0) return i32(3)
        alias=alias+1
    }
    if (coreP4xMicrophoneProcessBlockOwned(session,state,raw,nativeBufferAt(memory+1024,1),true,true,true).status() != 2 || calls != 0) return i32(4)
    actual=0;status=1
    while (actual <= 68) {
        if (actual == 0 || actual > 64 || (actual&3) != 0) {
            session.storeU32(68,2)
            if (coreP4xMicrophoneProcessBlockOwned(session,state,raw,output,false,true,true).status() != 5 ||
                session.loadU32(68) != 3 || !equal(state,reference,40)) return i32(5)
        }
        actual=actual+1
    }
    status=4;actual=64;session.storeU32(68,2)
    if (coreP4xMicrophoneProcessBlockOwned(session,state,raw,output,false,true,true).status() != 4 ||
        !equal(state,reference,40) || session.loadU32(68) != 3) return i32(6)
    return i32(0)
}
