// Peripheral compilation fixture, not a C5 boot image.
import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/toughc5_power.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_tough_power_target")
trusted fun powerTarget(owner: M5Expanders,pmic: M5PmicOpen,rails: bool): M5ToughPowerSetup =
    if (rails) owner.configureToughPowerRails(pmic) else owner.configureToughPowerInputs(pmic)
