import "../src/esp32/gpio_esp32_logic.ab"

fun main(): int {
    var failures = 0
    var number = -2
    while (number <= 64) {
        val classic = number >= 0 && number < 40 && number != 24 &&
            (number < 28 || number > 31)
        val s2 = number >= 0 && number < 47 && (number < 22 || number > 25)
        val s3 = number >= 0 && number < 49 && (number < 22 || number > 25)
        val c3 = number >= 0 && number < 22
        val c6 = number >= 0 && number < 31
        if (espChip32().gpioValid(number) != classic) failures = failures + 1
        if (espChipS2().gpioValid(number) != s2) failures = failures + 1
        if (espChipS3().gpioValid(number) != s3) failures = failures + 1
        if (espChipC3().gpioValid(number) != c3) failures = failures + 1
        if (espChipC6().gpioValid(number) != c6) failures = failures + 1
        if (espChip32().gpioOutputValid(number) != (classic && number < 34)) failures = failures + 1
        if (espChipS2().gpioOutputValid(number) != (s2 && number != 46)) failures = failures + 1
        if (espChipS3().gpioOutputValid(number) != s3) failures = failures + 1
        if (espChipC3().gpioOutputValid(number) != c3) failures = failures + 1
        if (espChipC6().gpioOutputValid(number) != c6) failures = failures + 1
        if (esp32BasicGpioValid(number) != classic) failures = failures + 1
        if (esp32BasicGpioOutputValid(number) != (classic && number < 34)) failures = failures + 1
        if (EspChip(0).gpioValid(number) || EspChip(99).gpioOutputValid(number)) failures = failures + 1
        number = number + 1
    }
    if (failures != 0) return 1
    0
}
