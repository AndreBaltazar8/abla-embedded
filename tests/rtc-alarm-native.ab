import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "../src/m5stack/rtc_device.ab"
import "../src/i2c/results.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type I2cDevice = int
val alarmScratch=nativeStaticAllocate(4)
var step=0
var failAt=0
var cleanupFail=false
var disabled=false
var bad=false
var rx=false
var weekdayMode=false
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister8(register: int): int { bad=true; return 0 }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    if (!rx) { bad=true; return false }
    step=step+1
    val cleanup=failAt > 0 && step > failAt
    if (mask != 8) bad=true
    if (cleanup || step == 1) {
        if (register != 30 || value != 0) bad=true
    } else if (step == 2 && !disabled) {
        if (register != 28 || value != (if (weekdayMode) 0 else 8)) bad=true
    } else if (step == (if (disabled) 4 else 5)) {
        if (register != 30 || value != (if (disabled) 0 else 8)) bad=true
    } else bad=true
    if (cleanup) !cleanupFail else step != failAt
}
fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    step=step+1
    if (step != 1 || register != 1) bad=true
    I2cByteResult(if (failAt == 1) 0 else 256 | 255)
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    step=step+1
    if (rx) {
        if (step != (if (disabled) 3 else 4) || register != 29 || value != 183) bad=true
        return step != failAt
    }
    val cleanup=failAt > 1 && step > failAt
    val expected=if (step == 2 || cleanup || disabled) 21 else 23
    if (register != 1 || value != expected) bad=true
    if (cleanup) return !cleanupFail
    step != failAt
}
trusted fun I2cDevice.writeRegister(register: int,buffer: NativeBuffer,bytes: int): bool {
    step=step+1
    if (rx) {
        if (step != (if (disabled) 2 else 3) || register != 23 || bytes != 3 ||
            buffer.load(0) != (if (disabled) 128 else 0x59) || buffer.load(1) != (if (disabled) 128 else 0x23) ||
            buffer.load(2) != (if (disabled) 128 else if (weekdayMode) 64 else 0x31)) bad=true
        return step != failAt
    }
    if (step != 3 || register != 9 || bytes != 4 || buffer.load(0) != (if (disabled) 128 else 0x59) ||
        buffer.load(1) != (if (disabled) 128 else 0x23) || buffer.load(2) != (if (disabled) 128 else 0x31) ||
        buffer.load(3) != (if (disabled) 128 else 6)) bad=true
    step != failAt
}
@export("abla_rtc_alarm_test")
trusted fun alarmTest(): i32 {
    var mode=0
    while (mode < 2) {
        disabled=mode == 1; failAt=0
        while (failAt <= 4) {
            var variant=0
            while (variant < 4) {
                cleanupFail=(variant & 1) == 1; step=0; bad=false
                val result=if (variant < 2) Pcf8563(7).setAlarmInterruptWithBuffer(nativeBufferAt(alarmScratch,4),
                    if (disabled) -1 else 59,if (disabled) -1 else 23,if (disabled) -1 else 31,if (disabled) -1 else 6)
                else M5Rtc((1<<32)|7).setAlarmInterruptWithBuffer(nativeBufferAt(alarmScratch,4),
                    if (disabled) -1 else 59,if (disabled) -1 else 23,if (disabled) -1 else 31,if (disabled) -1 else 6)
                if (result.status() != (if (failAt == 0) 1 else if (failAt == 1) 3 else if (cleanupFail) 5 else 4) ||
                    step != (if (failAt == 0) 4 else if (failAt == 1) 1 else failAt+1) || bad) return i32(1)
                variant=variant+1
            }
            failAt=failAt+1
        }
        mode=mode+1
    }
    step=0
    if (Pcf8563(7).setAlarmInterruptWithBuffer(nativeBufferAt(alarmScratch,3),1).status() != 2 || step != 0) return i32(2)
    rx=true; mode=0
    while (mode < 3) {
        disabled=mode == 2; weekdayMode=mode == 1; failAt=0
        val total=if (disabled) 4 else 5
        while (failAt <= total) {
            var variant=0
            while (variant < 4) {
                cleanupFail=(variant & 1) == 1; step=0; bad=false
                val result=if (variant < 2) Rx8130(7).setAlarmInterruptWithBuffer(nativeBufferAt(alarmScratch,3),
                    if (disabled) -1 else 59,if (disabled) -1 else 23,
                    if (disabled || weekdayMode) -1 else 31,if (weekdayMode) 6 else -1)
                else M5Rtc((2<<32)|7).setAlarmInterruptWithBuffer(nativeBufferAt(alarmScratch,3),
                    if (disabled) -1 else 59,if (disabled) -1 else 23,
                    if (disabled || weekdayMode) -1 else 31,if (weekdayMode) 6 else -1)
                if (result.status() != (if (failAt == 0) 1 else if (cleanupFail) 5 else 4) ||
                    step != (if (failAt == 0) total else failAt+1) || bad) return i32(3)
                variant=variant+1
            }
            failAt=failAt+1
        }
        mode=mode+1
    }
    i32(0)
}
