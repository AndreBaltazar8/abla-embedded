import "../src/esp32/psram/din_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val dinStorage=nativeStaticAllocate(20)
var dinWrites=0
var dinReads=0
var dinFail=0
var dinBusy=0
var dinBad=false
var dinProfile=0
fun dinSlot(address: int): int = if (address == 0x600030ac) 0 else if (address == 0x600030b0) 1 else if (address == 0x600030c0) 2 else if (address == 0x600030c4) 3 else if (address == 0x600030bc) 4 else -1
fun s3PsramCsRead(address: int): int {
    dinReads=dinReads+1
    if (address == 0x60002000) return if (dinBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (dinBusy == 2) 0x80000000 else 0
    val slot=dinSlot(address)
    if (slot < 0) { dinBad=true;return 0 }
    return nativeAddressLoadU32(dinStorage,slot*4)
}
fun s3PsramCsWrite(address: int,value: int): void {
    val slot=dinSlot(address);val step=dinWrites
    if (slot != (if (step < 4) step else 4)) { dinBad=true;return }
    val old=nativeAddressLoadU32(dinStorage,slot*4)
    var mask=0;var bits=0
    if (step < 4) {
        val width=if ((step&1) == 0) 3 else 2
        val field=if (step == 0) dinProfile&7 else if (step == 1) (dinProfile>>>3)&3 else if (step == 2) (dinProfile>>>2)&7 else (dinProfile>>>5)&3
        var lane=0
        while (lane < 9) { mask=mask|(((1<<width)-1)<<(lane*width));bits=bits|(field<<(lane*width));lane=lane+1 }
    } else {
        mask=if (step == 4) 2 else 28
        val extra=(dinProfile>>>6)&7
        bits=if (step == 4) (if (extra == 0) 0 else 2) else extra*4
    }
    if (value != ((old&(4294967295-mask))|bits)) dinBad=true
    dinWrites=dinWrites+1
    nativeAddressStoreU32(dinStorage,slot*4,if (dinWrites == dinFail) value^(mask&(-mask)) else value)
    return
}
@export("abla_s3_psram_din_test")
fun testPsramDin(): int {
    dinProfile=0
    while (dinProfile < 512) {
        dinFail=0
        while (dinFail <= 6) {
            var i=0
            while (i < 5) { nativeAddressStoreU32(dinStorage,i*4,((dinProfile*8388617)^0xa55a5aa5)^i);i=i+1 }
            dinWrites=0;dinReads=0;dinBusy=0;dinBad=false
            if (s3PsramDinOwned(dinProfile&7,(dinProfile>>>3)&3,(dinProfile>>>2)&7,(dinProfile>>>5)&3,(dinProfile>>>6)&7,true) != (if (dinFail == 0) 1 else 4) ||
                dinWrites != (if (dinFail == 0) 6 else dinFail) || dinBad) return 1
            dinFail=dinFail+1
        }
        dinProfile=dinProfile+1
    }
    dinReads=0;dinWrites=0
    if (s3PsramDinOwned(0,0,0,0,0,false) != 2 || s3PsramDinOwned(8,0,0,0,0,true) != 2 ||
        s3PsramDinOwned(0,4,0,0,0,true) != 2 || s3PsramDinOwned(0,0,8,0,0,true) != 2 ||
        s3PsramDinOwned(0,0,0,4,0,true) != 2 || s3PsramDinOwned(0,0,0,0,8,true) != 2 || dinReads != 0) return 2
    dinBusy=1
    if (s3PsramDinOwned(0,0,0,0,0,true) != 3 || dinWrites != 0) return 3
    dinBusy=2
    if (s3PsramDinOwned(0,0,0,0,0,true) != 3 || dinWrites != 0) return 4
    return 0
}
