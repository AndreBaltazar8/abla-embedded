import "../src/esp32/rtc_retention_tag_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var ctrl=0
var ir=0
var dr=0
var lr=0
var writes=0
var bad=false
fun esp32S3TagRead(address: int): int {
    if (address == 0x60008140) return ctrl
    if (address == 0x600260BC) return ir
    if (address == 0x600260C0) return dr
    if (address == 0x600260B8) return lr
    bad=true; 0
}
fun esp32S3TagWrite(address: int,value: int): void {
    if (address == 0x60008140) ctrl=value
    else if (address == 0x600260BC) ir=value
    else if (address == 0x600260C0) dr=value
    else if (address == 0x600260B8) { if (writes != 0) bad=true; lr=value }
    else bad=true
    writes=writes+1; return
}
@export("abla_rtc_retention_tag_test")
trusted fun tagTest(): i32 {
    var profile=0
    while (profile < 1024) {
        val i=(profile & 1) != 0
        val d=(profile & 2) != 0
        val initial=if ((profile & 4) != 0) 0x7FFFFFFF else 0
        val start=(profile>>>3) & 127
        val valid=255-start
        ctrl=0x01004001; ir=initial; dr=initial; lr=0xF8000000; writes=0; bad=false
        if (!esp32S3TagRetentionEnableOwned(0x3FC90000,i,start,valid,0,d,start+256,valid+256,511)) return i32(1)
        val expectedI=if (i) (initial & 0x4020100F) | 0x80000000 | (start<<22) | (valid<<13) else initial
        val expectedD=if (d) (initial & 15) | 0x80000000 | ((start+256)<<22) | ((valid+256)<<13) | (511<<4) else initial
        val count=2+(if (i) 4 else 0)+(if (d) 4 else 0)
        if (bad || writes != count || ir != expectedI || dr != expectedD || lr != 0xFFC90000 || ctrl != 0x0100C001) return i32(2)
        // Refuse removal before CPU retention has been disabled.
        if (esp32S3TagRetentionDisableOwned(i,d) || writes != count) return i32(3)
        ctrl=ctrl & 0xFEFFFFFF
        if (esp32S3TagRetentionDisableOwned(!i,d) || writes != count) return i32(4)
        if (!esp32S3TagRetentionDisableOwned(i,d) || ctrl != 0x4001 || ir != (expectedI & 0x7FFFFFFF) || dr != (expectedD & 0x7FFFFFFF)) return i32(5)
        profile=profile+1
    }
    var fault=0
    while (fault < 12) {
        ctrl=0x01004000; ir=0; dr=0; lr=0; writes=0
        if (fault == 0) ctrl=0
        if (fault == 1) ctrl=ctrl | 0x8000
        if (fault == 2) ir=0x80000000
        if (fault == 3) dr=0x80000000
        val link=if (fault == 4) 0 else if (fault == 5) 0x3FC90001 else 0x3FC90000
        val a=if (fault == 6) 256 else 0
        val b=if (fault == 7) -1 else 0
        val c=if (fault == 8) 256 else 0
        val e=if (fault == 9) 512 else 0
        val f=if (fault == 10) -1 else 0
        val g=if (fault == 11) 512 else 0
        if (esp32S3TagRetentionEnableOwned(link,true,a,b,c,true,e,f,g) || writes != 0) return i32(6)
        fault=fault+1
    }
    i32(0)
}
