import "../src/storage/fat_file_overwrite.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
var reads=0
var writes=0
var failRead=false
var failWrite=false
var writtenSector=0
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,dest: NativeBuffer): bool {
    reads=reads+1
    var index=0
    while (index < 512) { dest.store(index,(index+lba)&255);index=index+1 }
    if (lba == 1) { dest.storeU16(4,4);dest.storeU16(8,65535) }
    return !failRead
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool {
    writes=writes+1;writtenSector=lba
    val capture=nativeBufferAt(memory+3584,512);var index=0
    while (index < 512) { capture.store(index,source.load(index));index=index+1 }
    return !failWrite
}
@export("abla_fat_file_overwrite_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(memory,28);val boot=nativeBufferAt(memory+32,512)
    val directory=nativeBufferAt(memory+544,512);val source=nativeBufferAt(memory+1056,512)
    val workspace=nativeBufferAt(memory+1568,1536);val capture=nativeBufferAt(memory+3584,512)
    var index=0
    while (index < 512) { boot.store(index,0);directory.store(index,0);source.store(index,42);index=index+1 }
    boot.store(12,2);boot.store(13,1);boot.store(14,1);boot.store(16,2);boot.store(18,2)
    boot.store(22,40);boot.store(19,129);boot.store(20,39);boot.store(510,85);boot.store(511,170)
    directory.store(0,65);directory.storeU16(26,2);directory.storeU32(28,700)
    var result=fatFileOverwriteAtOwned(reader,boot,0,10113,directory,0,510,20,2,source,workspace)
    if (result.bytesWritten() != 2 || writes != 1 || writtenSector != 113) return i32(1)
    index=0
    while (index < 512) {
        if (capture.load(index) != (if (index < 510) (index+113)&255 else 42)) return i32(2)
        index=index+1
    }
    result=fatFileOverwriteAtOwned(reader,boot,0,10113,directory,0,512,512,2,source,workspace)
    if (result.bytesWritten() != 188 || writtenSector != 115 || writes != 2) return i32(3)
    index=0
    while (index < 512) {
        if (capture.load(index) != (if (index < 188) 42 else (index+115)&255)) return i32(4)
        index=index+1
    }
    val before=reads
    directory.store(11,1)
    if (fatFileOverwriteAtOwned(reader,boot,0,10113,directory,0,0,1,2,source,workspace).status() != 9 || reads != before || writes != 2) return i32(5)
    directory.store(11,0)
    if (fatFileOverwriteAtOwned(reader,boot,0,10113,directory,0,700,1,2,source,workspace).status() != 2 ||
        fatFileOverwriteAtOwned(reader,boot,0,10113,directory,0,701,1,2,source,workspace).status() != 3 ||
        fatFileOverwriteAtOwned(reader,boot,0,10113,directory,0,0,1,2,workspace,workspace).status() != 3 || reads != before || writes != 2) return i32(6)
    failRead=true
    if (fatFileOverwriteAtOwned(reader,boot,0,10113,directory,0,0,1,2,source,workspace).status() != 4 || writes != 2) return i32(7)
    failRead=false;failWrite=true
    result=fatFileOverwriteAtOwned(reader,boot,0,10113,directory,0,0,1,2,source,workspace)
    if (result.status() != 8 || result.bytesWritten() != 0 || writes != 3) return i32(8)
    return i32(0)
}
