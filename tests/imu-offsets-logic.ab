import "../src/imu/offsets_logic.ab"

fun main: int {
    val indices = imuOffsetIndex(0, 0) == 0 &&
        imuOffsetIndex(1, 2) == 5 && imuOffsetIndex(2, 2) == 8 &&
        imuOffsetIndex(-1, 0) == -1 && imuOffsetIndex(0, 3) == -1
    val keys = imuOffsetKey(0) == "ax" && imuOffsetKey(4) == "gy" &&
        imuOffsetKey(8) == "mz" && imuOffsetKey(9) == ""
    val signed = imuSigned32(4294967295) == -1 &&
        imuSigned32(2147483648) == -2147483648 &&
        imuSigned32(2147483647) == 2147483647
    val corrected = imuCorrectedFixed(100, 65536) == 6488064 &&
        imuCorrectedFixed(-2, -32768) == -98304
    if (indices && keys && signed && corrected &&
        imuOffsetCount == 9 && imuOffsetStorageBytes == 36) 62 else 1
}
