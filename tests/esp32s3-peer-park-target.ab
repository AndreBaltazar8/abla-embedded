import "../src/xtensa/peer_park.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_peer_park_target")
@section(".iram1.abla.peerParkTarget")
trusted fun peerTarget(address: int,ticket: int,operation: int): int {
    if (operation == 0) return xtensaPeerParkRequestOwned(address)
    if (operation == 1) return xtensaPeerParkStatusOwned(address,ticket)
    if (operation == 2) return if (xtensaPeerParkCancelOwned(address,ticket)) 1 else 0
    if (operation == 3) return if (xtensaPeerParkReleaseOwned(address,ticket)) 1 else 0
    if (operation == 4) return if (xtensaPeerParkServeOwned(address,ticket)) 1 else 0
    0
}
