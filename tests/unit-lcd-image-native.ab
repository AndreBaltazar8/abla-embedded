import "../src/display/unit_lcd.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
fun I2cDevice.valid(): bool = this == 7
val memory=nativeStaticAllocate(2000)
var calls=0
var fail=0
var width=1
var stride=0
var bad=false
var starved=false
fun unitLcdDelayMicroseconds(us: int): void { bad=true;return }
trusted fun I2cDevice.writeRead(bytes: NativeBuffer,length: int,output: NativeBuffer,count: int): bool {
    calls=calls+1
    if ((calls-1)%3 != 0 || length != 1 || bytes.load(0) != 9 || count != 1) bad=true
    output.store(0,if (starved) 0 else 128)
    return calls != fail
}
trusted fun I2cDevice.write(bytes: NativeBuffer,length: int): bool {
    calls=calls+1
    val row=(calls-1)/3;val stage=(calls-1)%3
    if (stage == 1) {
        if (length != 6 || bytes.load(0) != 42 || bytes.load(1) != 0 || bytes.load(2) != width-1 ||
            bytes.load(3) != 43 || bytes.load(4) != row+7 || bytes.load(5) != row+7) bad=true
    } else if (stage == 2) {
        if (length != width*2+1 || bytes.load(0) != 66) bad=true
        var at=0;while (at < width*2) { if (bytes.load(at+1) != (((row*stride+at)*73+19)&255)) bad=true;at=at+1 }
    } else bad=true
    return calls != fail
}
@export("abla_unit_lcd_image_test")
trusted fun testImage(): i32 {
    val source=nativeBufferAt(memory,1500);val scratch=nativeBufferAt(memory+1500,500);val device=I2cDevice(7)
    var variant=0
    while (variant < 5) {
        width=if (variant == 0) 1 else if (variant == 1) 2 else if (variant == 2) 7 else if (variant == 3) 135 else 240
        stride=width*2+3
        var at=0;while (at < 1500) { source.store(at,(at*73+19)&255);at=at+1 }
        fail=0
        while (fail <= 9) {
            calls=0
            val result=device.unitLcdWrite16(0,7,width,3,if (variant == 4) 1 else 0,source,stride,scratch,1)
            val rows=if (fail == 0) 3 else (fail-1)/3
            val status=if (fail == 0) 1 else if ((fail-1)%3 == 0) 3 else if ((fail-1)%3 == 1) 5 else 6
            if (result != (status|(rows<<8)) || calls != (if (fail == 0) 9 else fail) || bad) return i32(1)
            at=0;while (at < 1500) { if (source.load(at) != ((at*73+19)&255)) return i32(2);at=at+1 }
            fail=fail+1
        }
        variant=variant+1
    }
    width=1;stride=2;calls=0;fail=0;starved=true
    if (device.unitLcdWrite16(0,7,1,3,0,source,2,scratch,1) != 4 || calls != 1) return i32(3)
    calls=0
    if (device.unitLcdWrite16(0,7,1,3,0,source,2,source,1) != 2 || device.unitLcdWrite16(0,7,1,3,0,source,1,scratch,1) != 2 ||
        device.unitLcdWrite16(0,7,1,3,0,source,2,scratch,0) != 2 || calls != 0) return i32(4)
    return i32(0)
}
