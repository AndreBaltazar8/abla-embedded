import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/tab_charge.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_tab_charge_target")
trusted fun chargeTarget(board: M5BoardId,ioe: Pi4Ioe5v6408,milliamps: int,enableOnly: bool): M5TabChargeResult =
    if (enableOnly) board.setTabBatteryCharge(ioe,milliamps != 0) else board.setTabChargeCurrent(ioe,milliamps)
