import "../src/esp32/ledc_esp32p4.ab"
import "../src/esp32/ledc_clock_esp32p4.ab"
import "../src/esp32/ledc_channel_esp32p4.ab"
import "../src/esp32/ledc_pins_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_ledc_target")
trusted fun ledcTarget(timer: int,source: int,hz: int,resolution: int,operation: int): int {
    if (operation == 7) return p4LedcPinAttachLowOwned(resolution,hz,source,false)
    if (operation == 8) return p4LedcPinDetachLowOwned(resolution,hz,source,false)
    if (operation == 5) return p4LedcChannelSetDutyOwned(source,timer,hz,0,1000)
    if (operation == 6) return p4LedcChannelStopOwned(source,false,1000)
    if (operation == 3) return esp32P4LedcClockOpenOwned(source).bits()
    if (operation == 4) return Esp32P4LedcClock(source).closeOwned().bits()
    if (operation == 1) return p4LedcTimerPauseOwned(timer)
    if (operation == 2) return p4LedcTimerResumeOwned(timer)
    return p4LedcTimerConfigurePausedOwned(timer,resolution,p4LedcDividerForHz(source,hz,resolution))
}
