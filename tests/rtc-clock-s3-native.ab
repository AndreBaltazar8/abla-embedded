import "../src/esp32/rtc_timer_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var step=0
var bad=false
var low=0
var high=0
var deadline=0
fun esp32S3RtcWakeUpdate(address: int,mask: int,value: int): void {
    if (step == 0) {
        if (address != 0x6000800C || mask != 0x80000000 || value != mask) bad=true
    } else if (step == 6) {
        if (address != 0x60008008 || mask != 65536 || value != mask) bad=true
    } else bad=true
    step=step+1
    return
}
fun esp32S3RtcWakeRead(address: int): int {
    if (step == 1) {
        if (address != 0x60008010) bad=true
        step=step+1
        return low
    }
    if (step != 2 || address != 0x60008014) bad=true
    step=step+1
    high
}
fun esp32S3RtcWakeWrite(address: int,value: int): void {
    val expectedAddress=if (step == 3) 0x60008004 else if (step == 4) 0x60008008 else 0x6000804C
    val expectedValue=if (step == 3) deadline & 0xFFFFFFFF else if (step == 4) deadline>>>32 else 1024
    if (step < 3 || step > 5 || address != expectedAddress || value != expectedValue) bad=true
    step=step+1
    return
}
@export("abla_rtc_clock_s3_test")
trusted fun rtcClockTest(): i32 {
    var period=1
    while (period < 10000000) {
        var micros=0
        while (micros < 10000000) {
            // Independent bounded native arithmetic reference.
            if (esp32S3RtcTicksForMicroseconds(micros,period) != (micros*524288)/period) return i32(1)
            micros=micros+7919
        }
        period=period*3+1
    }
    if (esp32S3RtcTicksForMicroseconds(-1,1) != -1 ||
        esp32S3RtcTicksForMicroseconds(1,0) != -1 ||
        esp32S3RtcTicksForMicroseconds(1,0x100000000) != -1 ||
        esp32S3RtcTicksForMicroseconds(0x7FFFFFFFFFFFFFFF,1) != -1 ||
        esp32S3RtcTicksForMicroseconds(0x7FFFFFFFFFFF,524288) != 0x7FFFFFFFFFFF ||
        esp32S3RtcTicksForMicroseconds(0x800000000000,524288) != -1 ||
        esp32S3RtcTicksForMicroseconds(0x3FFFFFFFC000000,0xFFFFFFFF) != 0x200000000000 ||
        esp32S3RtcTicksForMicroseconds(0xFFFFFFFF0000000,0xFFFFFFFF) != -1) return i32(2)
    var variant=0
    while (variant < 4) {
        low=if (variant < 2) 0xFFFFFFFF else 0
        high=if ((variant & 1) == 0) 0xFFFFFFFF else 0
        deadline=(((high & 65535)<<32)+low+1) & 0xFFFFFFFFFFFF
        step=0; bad=false
        if (!esp32S3RtcAlarmAfterOwned(1,524288) || step != 7 || bad) return i32(3)
        variant=variant+1
    }
    step=0; bad=false
    if (esp32S3RtcAlarmAfterOwned(0,524288) || esp32S3RtcAlarmAfterOwned(1,0) ||
        esp32S3RtcSetAlarmOwned(-1) || esp32S3RtcSetAlarmOwned(0x1000000000000) || step != 0 || bad) return i32(4)
    i32(0)
}
