import "../src/display/glyph_rgb565.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(200)
@export("abla_glyph_rgb565_test")
trusted fun test(): i32 {
    val buffer=nativeBufferAt(storage,196)
    var character=0
    while (character < 256) {
        var i=0
        while (i < 200) { nativeBufferAt(storage,200).store(i,90); i=i+1 }
        if (!drawClassicGlyphRgb565(buffer,8,10,20,1,1,character,0x1234,0xabcd)) return i32(1)
        var y=0
        while (y < 10) {
            var x=0
            while (x < 8) {
                var expected=0x5a5a
                if (x >= 1 && x < 7 && y >= 1 && y < 9) {
                    expected=if ((classicFontColumn(character,x-1)&(1<<(y-1))) != 0) 0x1234 else 0xabcd
                }
                if ((buffer.load(y*20+x*2)<<8|buffer.load(y*20+x*2+1)) != expected) return i32(2)
                x=x+1
            }
            y=y+1
        }
        i=0
        while (i < 200) {
            if ((i%20 >= 16 || i >= 196) && nativeBufferAt(storage,200).load(i) != 90) return i32(3)
            i=i+1
        }
        character=character+1
    }
    var scale=1
    while (scale <= 8) {
        var i=0
        while (i < 196) { buffer.store(i,90); i=i+1 }
        if (!drawClassicGlyphRgb565(buffer,8,10,20,-3,-2,65,0x1234,0,scale,true,true)) return i32(4)
        var y=0
        while (y < 10) {
            var x=0
            while (x < 8) {
                val sx=x+3
                val sy=y+2
                val ink=sx < 6*scale && sy < 8*scale && (classicFontColumn(65,sx/scale)&(1<<(sy/scale))) != 0
                val expected=if (ink) 0x1234 else 0x5a5a
                if ((buffer.load(y*20+x*2)|(buffer.load(y*20+x*2+1)<<8)) != expected) return i32(5)
                x=x+1
            }
            y=y+1
        }
        scale=scale+1
    }
    buffer.store(0,42)
    if (drawClassicGlyphRgb565(buffer,8,10,15,0,0,65,1,0) || drawClassicGlyphRgb565(buffer,8,10,20,0,0,256,1,0) || drawClassicGlyphRgb565(buffer,8,10,20,0,0,65,1,0,0) || buffer.load(0) != 42) return i32(6)
    if (classicFontColumn(32,0) != 0 || classicFontColumn(65,0) != 124 || classicFontColumn(65,1) != 18 || classicFontColumn(65,5) != 0) return i32(7)
    return i32(0)
}
