import "../src/m5stack/papermono_sd_owner_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(464)
var admitted=true
var startResult=2
var startPoll=2
var negotiateBegin=2
var negotiatePoll=2
var clockBegin=2
var clockPoll=2
var closeResult=2
var calls=0
var bad=false
var ready=true
fun paperMonoSdOwnerAdmission(control: int,storage: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer): bool =
    admitted && control == 7 && storage.addressValue() == memory && descriptor.addressValue() == memory+432 && payload.addressValue() == memory+448
fun paperMonoSdOwnerBegin(control: int,startup: NativeBuffer,pads: NativeBuffer,slot: int,pll: bool,now: u32,budget: int): int {
    calls=calls*10+1
    if (control != 7 || startup.addressValue() != memory+32 || pads.addressValue() != memory+160 || slot != 1 || pll || budget != 2000) bad=true
    return startResult
}
fun paperMonoSdOwnerStartupPoll(startup: NativeBuffer,now: u32,us: u32): int { calls=calls*10+2;return startPoll }
fun paperMonoSdOwnerNegotiateBegin(context: NativeBuffer,startup: NativeBuffer,descriptor: NativeBuffer,payload: NativeBuffer,
    width: int,now: u32,budget: int): int {
    calls=calls*10+3
    if (context.addressValue() != memory+224 || startup.addressValue() != memory+32 || descriptor.addressValue() != memory+432 ||
        payload.addressValue() != memory+448 || width != 4 || budget != 2000) bad=true
    context.storeU32(28,0x12345678);return negotiateBegin
}
fun paperMonoSdOwnerNegotiatePoll(context: NativeBuffer,now: u32): int { calls=calls*10+4;return negotiatePoll }
fun paperMonoSdOwnerClockBegin(context: NativeBuffer,startup: NativeBuffer,now: u32,budget: int): int {
    calls=calls*10+6
    if (context.addressValue() != memory+368 || startup.addressValue() != memory+32 || budget != 2000) bad=true
    context.storeU32(56,0xabcdef);return clockBegin
}
fun paperMonoSdOwnerClockPoll(context: NativeBuffer,now: u32,us: u32): int { calls=calls*10+7;return clockPoll }
fun paperMonoSdOwnerReady(startup: NativeBuffer,context: NativeBuffer,clock: NativeBuffer): bool = ready
fun paperMonoSdOwnerClose(startup: NativeBuffer,pads: NativeBuffer): int { calls=calls*10+5;return closeResult }
@export("abla_papermono_sd_owner_test")
trusted fun test(): i32 {
    val owner=paperMonoSdOwnerAt(nativeBufferAt(memory,432))
    val descriptor=nativeBufferAt(memory+432,16);val payload=nativeBufferAt(memory+448,8)
    if (!owner.initializeFresh() || owner.beginOwned(7,descriptor,payload,1,false,4,u32(0),2000,true) != 2 || calls != 1 || owner.card() != 0) return i32(1)
    calls=0
    if (owner.closeOwned(true) != 2 || owner.card() != 0 || calls != 0 ||
        owner.beginOwned(7,descriptor,payload,1,false,4,u32(0),2000,true) != 3) return i32(2)
    if (owner.pollOwned(u32(1),u32(1000),true) != 2 || calls != 2 || owner.status() != 2) return i32(3)
    calls=0;startPoll=1
    if (owner.pollOwned(u32(2),u32(2000),true) != 2 || calls != 23 || owner.status() != 3 || owner.card() != 0) return i32(4)
    calls=0;negotiatePoll=1
    if (owner.pollOwned(u32(3),u32(3000),true) != 2 || calls != 46 || owner.status() != 7 || owner.card() != 0) return i32(5)
    calls=0
    if (owner.closeOwned(true) != 2 || calls != 0 || owner.pollOwned(u32(4),u32(4000),true) != 2 || calls != 7 || owner.card() != 0) return i32(14)
    calls=0;clockPoll=1
    if (owner.pollOwned(u32(5),u32(5000),true) != 1 || calls != 7 || owner.card().addressValue() != memory+80) return i32(15)
    ready=false
    if (owner.card() != 0) return i32(6)
    ready=true;calls=0
    if (owner.closeOwned(true) != 2 || owner.status() != 5 || owner.card() != 0 || calls != 5) return i32(7)
    closeResult=6;calls=0
    if (owner.closeOwned(true) != 6 || owner.status() != 5 || calls != 5 || owner.negotiation().loadU32(28) != 0x12345678) return i32(8)
    closeResult=1;calls=0
    if (owner.closeOwned(true) != 1 || owner.status() != 6 || calls != 5) return i32(9)
    calls=0
    if (owner.closeOwned(true) != 1 || calls != 0 || owner.card() != 0) return i32(10)
    var phase=0
    while (phase < 6) {
        owner.initializeFresh();calls=0;startResult=if (phase == 0) 7 else 2
        startPoll=if (phase == 1) 5 else 1;negotiateBegin=if (phase == 2) 4 else 2;negotiatePoll=if (phase == 3) 6 else 1
        clockBegin=if (phase == 4) 5 else 2;clockPoll=7
        var result=owner.beginOwned(7,descriptor,payload,1,false,4,u32(0),2000,true)
        if (result == 2) result=owner.pollOwned(u32(1),u32(1000),true)
        if (result == 2) result=owner.pollOwned(u32(2),u32(2000),true)
        if (result == 2) result=owner.pollOwned(u32(3),u32(3000),true)
        if (result != 4 || owner.status() != 4 || owner.card() != 0 || bad ||
            calls != (if (phase == 0) 1 else if (phase == 1) 12 else if (phase == 2) 123 else if (phase == 3) 1234 else if (phase == 4) 12346 else 123467)) return i32(11)
        if (phase >= 4 && owner.transferClock().loadU32(56) != 0xabcdef) return i32(16)
        if (owner.closeOwned(true) != 1 || owner.status() != 6) return i32(12)
        phase=phase+1
    }
    owner.initializeFresh();calls=0;admitted=false
    if (owner.beginOwned(7,descriptor,payload,1,false,4,u32(0),2000,true) != 3 || owner.status() != 0 || calls != 0 ||
        owner.pollOwned(u32(1),u32(1000),false) != 3 || owner.closeOwned(false) != 3) return i32(13)
    return i32(0)
}
