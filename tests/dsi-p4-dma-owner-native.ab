import "../src/esp32/dw_gdma_controller_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(512)
var writes=0
var drop=0
var resetStuck=false
var bad=false
trusted fun p4DwClockRead(offset: int): u32 = u32(nativeBufferAt(storage,512).loadU32(offset))
trusted fun p4DwClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes != drop) nativeBufferAt(storage,512).storeU32(offset,int(value))
    return
}
trusted fun p4DwDmaRead(offset: int): u32 {
    if ((p4DwClockRead(20)&u32(8192)) == u32(0) || (p4DwClockRead(24)&u32(32)) == u32(0)) bad=true
    if (offset == 88 && !resetStuck) return u32(0)
    return u32(nativeBufferAt(storage,512).loadU32(256+offset))
}
trusted fun p4DwDmaWrite(offset: int,value: u32): void {
    if ((p4DwClockRead(20)&u32(8192)) == u32(0) || (p4DwClockRead(24)&u32(32)) == u32(0)) bad=true
    writes=writes+1
    if (writes != drop) nativeBufferAt(storage,512).storeU32(256+offset,int(value))
    return
}
trusted fun resetOwner(): void {
    var i=0
    while (i < 512) { nativeBufferAt(storage,512).storeU32(i,0); i=i+4 }
    nativeBufferAt(storage,512).storeU32(20,4096)
    nativeBufferAt(storage,512).storeU32(24,64)
    nativeBufferAt(storage,512).storeU32(192,2)
    writes=0; drop=0; resetStuck=false; bad=false; return
}
@export("abla_dsi_p4_dma_owner_test")
trusted fun testOwner(): i32 {
    resetOwner()
    var owner=esp32P4DwDmaControllerOpenOwned(2)
    if (owner.status() != 1 || !owner.ownsClocks() || owner.quiesced() || writes != 6 || bad) return i32(1)
    if (esp32P4DwDmaControllerOpenOwned(2).status() != 3 || writes != 6) return i32(2)
    nativeBufferAt(storage,512).storeU32(280,8)
    if (owner.closeOwned(2).status() != 7 || writes != 6) return i32(3)
    nativeBufferAt(storage,512).storeU32(280,0)
    nativeBufferAt(storage,512).storeU32(284,4)
    if (owner.closeOwned(2).status() != 7 || writes != 6) return i32(4)
    nativeBufferAt(storage,512).storeU32(284,0)
    owner=owner.closeOwned(2)
    if (owner.status() != 0 || owner.ownsClocks() || bad || p4DwClockRead(20) != u32(4096) ||
        p4DwClockRead(24) != u32(64) || p4DwClockRead(192) != u32(2)) return i32(5)
    var fault=1
    while (fault <= 4) {
        resetOwner(); drop=fault
        owner=esp32P4DwDmaControllerOpenOwned(2)
        if (owner.status() != 4 || !owner.quiesced() || !owner.ownsClocks() || bad) return i32(6)
        drop=0; owner=owner.closeOwned(2)
        if (owner.status() != 0 || bad) return i32(7)
        fault=fault+1
    }
    resetOwner(); resetStuck=true
    owner=esp32P4DwDmaControllerOpenOwned(2)
    if (owner.status() != 5 || owner.quiesced() || writes != 5) return i32(8)
    if (owner.closeOwned(2).status() != 5 || writes != 5) return i32(9)
    resetStuck=false
    if (owner.closeOwned(2).status() != 0 || bad) return i32(10)
    resetOwner(); drop=6
    owner=esp32P4DwDmaControllerOpenOwned(2)
    if (owner.status() != 6 || !owner.ownsClocks()) return i32(11)
    drop=0
    if (owner.closeOwned(2).status() != 0 || bad) return i32(12)
    fault=1
    while (fault <= 4) {
        resetOwner(); owner=esp32P4DwDmaControllerOpenOwned(2)
        // Reset deassert is already zero; deliberately preset to exercise drop.
        if (fault == 2) nativeBufferAt(storage,512).storeU32(192,2097154)
        drop=writes+fault
        owner=owner.closeOwned(2)
        if (owner.status() != (if (fault == 1) 6 else 4) || !owner.ownsClocks()) return i32(13)
        drop=0; owner=owner.closeOwned(2)
        if (owner.status() != 0 || bad) return i32(14)
        fault=fault+1
    }
    resetOwner()
    if (esp32P4DwDmaControllerOpenOwned(0).status() != 2 || writes != 0 || bad) return i32(15)
    return i32(0)
}
