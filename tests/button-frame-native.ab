import "../src/m5stack/button_frame.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_button_frame_test")
fun frameTest(): i32 {
    var frame=0
    while (frame < 1024) {
        val value=M5ButtonFrame(u32(frame))
        var index=0
        while (index < 5) {
            val valid=(frame&(1<<(index+5))) != 0
            val pressed=valid && (frame&(1<<index)) != 0
            if (value.read(index).valid() != valid || value.read(index).pressed() != pressed) return i32(1)
            val cleared=value.withRead(index,m5ButtonRead(false))
            if (cleared.read(index).valid() || (int(cleared | u32(0))&~((1<<index)|(1<<(index+5)))) !=
                (frame&~((1<<index)|(1<<(index+5))))) return i32(2)
            if (!value.withRead(index,m5ButtonRead(true,true)).read(index).pressed() ||
                value.withRead(index,m5ButtonRead(true,false)).read(index).pressed()) return i32(3)
            index=index+1
        }
        var controlled=0
        while (controlled < 8) {
            var pressed=0
            while (pressed < 8) {
                val result=value.withTouchLevels(controlled,pressed)
                val expected=if ((pressed&~controlled) != 0) frame else (frame&~controlled)|pressed|(controlled<<5)
                if (int(result | u32(0)) != expected) return i32(4)
                pressed=pressed+1
            }
            controlled=controlled+1
        }
        if (value.read(-1).valid() || value.read(5).valid() || value.withRead(5,m5ButtonRead(true,true)) != value ||
            value.withTouchLevels(8,0) != value) return i32(5)
        frame=frame+1
    }
    i32(0)
}
