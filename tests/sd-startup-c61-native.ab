import "../src/sd/startup_c61_sequence.ab"
import "abla/build"
val memory=nativeStaticAllocate(16)
var csHigh=true
var busy=false
var calls=0
var failAt=0
var failBusy=false
var csWrites=0
var csFail=0
var highClocks=0
var phase=0
var packet=0
var bad=false
var fast=false
var failed=false
fun device(): Esp32C61SpiMaster =
    Esp32C61SpiMaster(25|(27<<5)|(26<<10)|(28<<15)|(1<<24)|(15<<32)|(1<<49)|(1<<59))
fun c61SpiRead(address: int): u32 {
    if (address == 0x60096094) return u32(5)
    if (address == 0x60096098) return u32(1<<22)
    if (address == 0x60081000) return if (busy) u32(1<<24) else u32(0)
    if (address == 0x6008100c) return if (fast) u32(0x80000000) else u32((9<<18)|(9<<12)|(4<<6)|9)
    if (address == 0x60081020 || address == 0x60081010 || address == 0x60081008 ||
        address == 0x60081030 || address == 0x60081034 || address == 0x600810e0 || address == 0x6008103c) return u32(0)
    bad=true;return u32(0)
}
fun c61SpiWrite(address: int,value: u32): void { bad=true;return }
fun c61GpioRead(address: int): u32 {
    if (address == 0x60091034) return u32((1<<28)|(1<<25)|(1<<27))
    if (address == 0x60091004) return if (csHigh) u32(1<<28) else u32(0)
    if (address == 0x60091ad4+28*4) return u32(1280)
    if (address == 0x60090000+28*4 || address == 0x60090000+25*4 || address == 0x60090000+27*4) return u32(4096)
    if (address == 0x60090000+26*4) return u32(4608)
    if (address == 0x60091ad4+25*4) return u32(1088)
    if (address == 0x60091ad4+27*4) return u32(1090)
    if (address == 0x600913d8) return u32(282)
    if (address == 0x600910d4+25*4 || address == 0x600910d4+27*4 ||
        address == 0x600910d4+28*4 || address == 0x600b102c) return u32(0)
    bad=true;return u32(0)
}
fun c61GpioWrite(address: int,value: u32): void {
    csWrites=csWrites+1
    if (value != u32(1<<28) || busy) bad=true
    if (csWrites == csFail) return
    if (address == 0x60091008) csHigh=true
    else if (address == 0x6009100c) { if (highClocks != 10) bad=true;csHigh=false }
    else bad=true
    return
}
fun sdSpiSelectedAdmission(context: int,scratch: NativeBuffer,response: NativeBuffer,bytes: int): bool =
    context == (device()|0) && !csHigh && !busy
fun sdSpiSelectedDelay(us: int): void { bad=true;return }
fun sdSpiSelectedExchange(context: int,value: int,scratch: NativeBuffer): int {
    calls=calls+1
    if (peripheralGateAt(memory).tryBegin(u32(99)) != 1 || context != (device()|0) || busy) bad=true
    if (calls == failAt) { failed=true;busy=failBusy;return 263 }
    if (csHigh) {
        if (value != 255 || (!failed && csFail != 1 && highClocks >= 10 && packet != 5)) bad=true
        highClocks=highClocks+1;return (1<<32)|255
    }
    val command=if (packet == 0) 0 else if (packet == 1) 8 else if (packet == 2) 55 else if (packet == 3) 41 else 58
    val argument=if (command == 8) 426 else if (command == 41) 1073741824 else 0
    val expected=if (phase == 0) 64|command else if (phase == 5) sdSpiCommandFrameCrc(command,argument)
        else if (phase < 5) (argument>>>((4-phase)*8))&255 else 255
    if (value != expected || highClocks != 10 || packet >= 5 || failed) bad=true
    val input=if (phase < 6) 255 else if (phase == 6) (if (packet < 3) 1 else 0)
        else if (command == 8) (if (phase == 9) 1 else if (phase == 10) 170 else 0)
        else (if (phase == 7) 192 else if (phase == 8) 255 else 0)
    phase=phase+1
    if (phase == 11 || (phase == 7 && command != 8 && command != 58)) { phase=0;packet=packet+1 }
    return (1<<32)|input
}
fun resetStartup(): void {
    nativeAddressStoreU32(memory,0,0);csHigh=true;busy=false;calls=0;failAt=0;failBusy=false
    csWrites=0;csFail=0;highClocks=0;phase=0;packet=0;bad=false;fast=false;failed=false;return
}
@export("abla_sd_startup_c61_test")
trusted fun testStartup(): i32 {
    val gate=peripheralGateAt(memory);val scratch=nativeBufferAt(memory+4,2);val response=nativeBufferAt(memory+8,4)
    resetStartup()
    val good=device().initializeSd(gate,u32(7),40000000,scratch,response,2)
    if (!good.valid() || !good.highCapacity() || good.cleanupPending() || !csHigh || highClocks != 11 || calls != 54 || bad) return i32(1)
    var failure=1
    while (failure <= 54) {
        var stuck=0
        while (stuck < 2) {
            resetStartup();failAt=failure;failBusy=stuck == 1
            val result=device().initializeSd(gate,u32(7),40000000,scratch,response,2)
            if (result.status() != (if (failure == 54) 16 else 4) || result.transportDetail() != 263 ||
                result.cleanupPending() != (stuck == 1 || failure == 54) || bad) return i32(2)
            if (stuck == 1 && failure > 10 && failure < 54 && csHigh) return i32(3)
            if (stuck == 0 && !csHigh) return i32(4)
            val previous=calls
            if (device().initializeSd(gate,u32(8),40000000,scratch,response,2).status() != 12 || calls != previous) return i32(5)
            stuck=stuck+1
        }
        failure=failure+1
    }
    failure=1
    while (failure <= 2) {
        resetStartup();csFail=failure
        val result=device().initializeSd(gate,u32(7),40000000,scratch,response,2)
        if (result.status() != 15 || result.cleanupPending() != (failure == 2) || bad) return i32(6)
        failure=failure+1
    }
    resetStartup();fast=true
    if (device().initializeSd(gate,u32(7),40000000,scratch,response).status() != 14 || calls != 0 || csWrites != 0 || bad) return i32(7)
    resetStartup()
    if (device().initializeSd(gate,u32(7),40000000,nativeBufferAt(memory,2),response).status() != 2 || calls != 0) return i32(8)
    if (gate.tryBegin(u32(1)) != 0 || device().initializeSd(gate,u32(7),40000000,scratch,response).status() != 11 || calls != 0 ||
        !gate.finish(u32(1),true)) return i32(9)
    return i32(0)
}
