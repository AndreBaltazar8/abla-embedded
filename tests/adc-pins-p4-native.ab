import "../src/esp32/adc_pins_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/esp32/gpio_p4_sequence.ab"
import "abla/build"
val registers=nativeStaticAllocate(4608)
val record=nativeStaticAllocate(64)
var writes=0
var drop=0
var held=false
trusted fun mapped(offset: int): int = if (offset >= 0x4b008 && offset <= 0x4b044) 4352+offset-0x4b008 else offset
trusted fun p4GpioRead(offset: int): u32 = u32(nativeBufferAt(registers,4608).loadU32(mapped(offset)))
trusted fun p4GpioWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    val r=nativeBufferAt(registers,4608)
    if (offset == 8 || offset == 20 || offset == 36 || offset == 48) r.storeU32(offset-4,int(p4GpioRead(offset-4)|value))
    else if (offset == 12 || offset == 24 || offset == 40 || offset == 52) r.storeU32(offset-8,int(p4GpioRead(offset-8)&(u32(0xffffffff)^value)))
    else r.storeU32(mapped(offset),int(value))
    return
}
trusted fun p4GpioHoldRead(address: int): u32 = if (held) u32(0xffffffff) else u32(0)
trusted fun p4GpioHoldWrite(address: int,value: u32): void { return }
trusted fun p4PinSnapshotRead(address: int): int = int(p4GpioRead(address-0x500e0000))
trusted fun p4PinSnapshotWrite(address: int,value: int): void { p4GpioWrite(address-0x500e0000,u32(value));return }
trusted fun p4I2sPinRead(offset: int): u32 = p4GpioRead(offset)
trusted fun p4I2sPinWrite(offset: int,value: u32): void { p4GpioWrite(offset,value);return }
trusted fun p4I2sPinField(offset: int,mask: u32,value: u32): bool = p4GpioField(offset,mask,value)
trusted fun p4I2sPinConfigure(pin: int,input: bool): int = esp32P4GpioConfigureOwned(pin,false,false,false,input,0)
trusted fun clear(): void {
    var offset=0
    while (offset < 4608) { nativeBufferAt(registers,4608).storeU32(offset,0xffffffff);offset=offset+4 }
    nativeBufferAt(record,64).storeU32(0,0)
    writes=0;drop=0;held=false;return
}
@export("abla_adc_pins_p4_test")
trusted fun test(): i32 {
    var layout=1
    while (layout <= 3) {
        var unit=1
        while (unit <= 2) {
            var channel=0
            while (channel < (if (unit == 1) 8 else 6)) {
                val pin=if (unit == 1) 16+channel else 49+channel
                clear()
                val before=esp32p4GpioSnapshotOwned(pin,layout,true)
                var lease=esp32p4AdcPadOpenOwned(unit,channel,layout,true)
                if (lease.status() != 1 || !lease.hasSnapshot() || lease.pin() != pin ||
                    (p4GpioRead(4100+pin*4)&u32(29570)) != u32(4096) ||
                    (p4GpioRead(if (pin < 32) 32 else 44)&(u32(1)<<u32(pin&31))) != u32(0)) return i32(1)
                val readyWrites=writes
                if (lease.closeOwned(false) != lease || writes != readyWrites) return i32(2)
                held=true
                lease=lease.closeOwned(true)
                if (lease.status() != 6 || writes != readyWrites) return i32(3)
                held=false
                lease=lease.closeOwned(true)
                if (lease.status() != 5 || esp32p4GpioSnapshotOwned(pin,layout,true) != before) return i32(4)
                val closedWrites=writes
                if (lease.closeOwned(true) != lease || writes != closedWrites) return i32(5)
                var fault=1
                while (fault <= 5) {
                    clear();drop=fault
                    val failed=esp32p4AdcPadOpenOwned(unit,channel,layout,true)
                    if (failed.status() != 4 || !failed.hasSnapshot() || writes != fault) return i32(6)
                    drop=0
                    if (failed.closeOwned(true).status() != 5 || esp32p4GpioSnapshotOwned(pin,layout,true) != before) return i32(7)
                    fault=fault+1
                }
                clear();held=true
                if (esp32p4AdcPadOpenOwned(unit,channel,layout,true).status() != 3 || writes != 0) return i32(8)
                channel=channel+1
            }
            unit=unit+1
        }
        layout=layout+2
    }
    clear()
    var unit=0
    while (unit <= 3) {
        var channel=-1
        while (channel <= 8) {
            if (esp32p4AdcPin(unit,channel) < 0 &&
                esp32p4AdcPadOpenOwned(unit,channel,1,true).status() != 2) return i32(9)
            channel=channel+1
        }
        unit=unit+1
    }
    if (esp32p4AdcPadOpenOwned(1,0,2,true).status() != 2 ||
        esp32p4AdcPadOpenOwned(1,0,1,false).status() != 2 || writes != 0) return i32(10)
    return i32(0)
}
