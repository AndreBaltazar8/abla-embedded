import "../src/esp32/rtc_alarm_control_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var timer=0
var high=0
var raw=0
var enable=0
var writes=0
var fault=0
var cancelling=false
var bad=false
trusted fun c5RtcTimerRead(offset: int): int {
    if (offset == timer*8+4) return high
    if (offset == (if (timer == 0) 0x28 else 0x38)) return raw
    if (offset == (if (timer == 0) 0x30 else 0x40)) return enable
    bad=true;return 0
}
trusted fun c5RtcTimerWrite(offset: int,value: int): void {
    writes=writes+1
    if (cancelling) {
        if (writes == 1) {
            if (offset != timer*8+4 || value != (high&0x7fffffff)) bad=true
            high=value
        } else if (writes == 2) {
            if (offset != (if (timer == 0) 0x34 else 0x44) || value != 0x80000000 || (high&0x80000000) != 0) bad=true
            if (fault == 0) raw=raw&0x7fffffff
        } else bad=true
    } else {
        if (offset != (if (timer == 0) 0x30 else 0x40)) bad=true
        if (fault == 0) enable=value
    }
    return
}
@export("abla_rtc_alarm_control_c5_test")
fun test(): int {
    timer=0
    while (timer < 2) {
        var bit=0
        while (bit < 32) {
            var pending=0
            while (pending < 2) {
                fault=0
                while (fault < 2) {
                    val unrelated=(1<<bit)&0x7fffffff
                    high=0x81234567;raw=unrelated|(pending<<31);enable=0xc0000005;writes=0;bad=false;cancelling=true
                    if (esp32C5RtcAlarmPendingOwned(timer,true) != pending || writes != 0) return 1
                    val result=esp32C5RtcAlarmCancelOwned(timer,true)
                    if (result != (fault == 0 || pending == 0) || writes != 2 || raw != (unrelated|(if (fault == 0) 0 else pending<<31)) || high != 0x01234567 || enable != 0xc0000005 || bad) return 2
                    var desired=0
                    while (desired < 2) {
                        cancelling=false;enable=unrelated|((1-desired)<<31);writes=0
                        val ok=esp32C5RtcAlarmInterruptOwned(timer,desired != 0,true)
                        if (ok != (fault == 0) || writes != 1 || (enable&0x7fffffff) != unrelated || bad) return 3
                        desired=desired+1
                    }
                    fault=fault+1
                }
                pending=pending+1
            }
            bit=bit+1
        }
        timer=timer+1
    }
    writes=0;bad=false
    if (esp32C5RtcAlarmCancelOwned(2,true) || esp32C5RtcAlarmInterruptOwned(-1,true,true) || esp32C5RtcAlarmPendingOwned(0,false) != -1 || esp32C5RtcAlarmCancelOwned(0,false) || writes != 0 || bad) return 4
    0
}
