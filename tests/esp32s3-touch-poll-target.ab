import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/inputs_touch.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_touch_poll_target")
trusted fun touchPollTarget(owner: M5Inputs,board: M5BoardId,kind: int,handle: int,
    tracker: TouchTracker,snapshot: NativeBuffer,raw: NativeBuffer,now: int,previous: int,
    pi4: Pi4Ioe5v6408,pmic: M5PmicOpen,powerHub: I2cDevice): bool {
    owner.pollWithTouchOwned(board,kind,handle,tracker,snapshot,raw,0,pi4 | 0,pmic,powerHub | 0,now)
}
