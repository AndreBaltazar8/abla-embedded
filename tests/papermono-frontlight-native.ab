import "../src/i2c/results.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/m5stack/papermono_frontlight.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
val storage=nativeStaticAllocate(64)
var calls=0
var failure=0
var level=0
var bad=false
fun I2cBus.valid(): bool { bad=true;return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true;return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true;return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true;return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true;return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true;return I2cByteResult(0) }
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true;return I2cWordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true;return I2cDwordResult(0) }
trusted fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    calls=calls+1
    if (this != 9 || calls > 2 || register != (if (calls == 1) 19 else 22) ||
        mask != (if (calls == 1) 8 else 192) || value != (if (calls == 1) 0 else 192)) bad=true
    if (calls == failure) return false
    val r=nativeBufferAt(storage,64)
    r.store(register,(r.load(register)&~mask)|value);return true
}
trusted fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool {
    calls=calls+1
    if (this != 9 || (calls != 3 && calls != 4) || register != (if (calls == 3) 52 else 48) ||
        value != (if (calls == 3) 5000 else 4096+(level*level)/16)) bad=true
    if (calls == failure) return false
    nativeBufferAt(storage,64).storeU16(register,value);return true
}
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    if (this != 9 || calls != 4 || level != 0 || register != 49 || value != 0) bad=true
    if (calls == failure) return false
    nativeBufferAt(storage,64).store(register,value);return true
}
@export("abla_papermono_frontlight_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(storage,64)
    while (level < 256) {
        var initial=0
        while (initial < 256) {
            failure=0
            while (failure <= 4) {
                var i=0
                while (i < 64) { r.store(i,initial);i=i+1 }
                calls=0;bad=false
                val result=paperMonoFrontlightInitializeOwned(M5Pm1(9),level,true)
                val applied=if (failure == 0) 4 else failure-1
                if (result != (if (failure == 0) 1 else failure+2) || bad || calls != (if (failure == 0) 4 else failure)) return i32(1)
                i=0
                while (i < 64) {
                    var expected=initial
                    if (i == 19 && applied >= 1) expected=initial&247
                    if (i == 22 && applied >= 2) expected=initial|192
                    if (i == 52 && applied >= 3) expected=136
                    if (i == 53 && applied >= 3) expected=19
                    if (applied == 4) {
                        if (i == 48 && level != 0) expected=((level*level)/16)&255
                        if (i == 49) expected=if (level == 0) 0 else 16+(level*level)/4096
                    }
                    if (r.load(i) != expected) return i32(2)
                    i=i+1
                }
                failure=failure+1
            }
            initial=initial+1
        }
        level=level+1
    }
    calls=0
    if (paperMonoFrontlightInitializeOwned(M5Pm1(9),256,true) != 2 ||
        paperMonoFrontlightInitializeOwned(M5Pm1(0),0,true) != 2 ||
        paperMonoFrontlightOwned(M5Pm1(9),-1,true) != 2 ||
        paperMonoFrontlightOwned(M5Pm1(9),0,false) != 2 || calls != 0) return i32(3)
    return i32(0)
}
