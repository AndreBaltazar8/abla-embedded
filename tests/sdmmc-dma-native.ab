import "../src/sd/mmc_dma_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(2048)
var writes=0
var invalidAccess=false
var prematurePublish=false
var expectedCount=0
trusted fun sdMmcDmaS3Read(address: int): int {
    if (address < 0x3fc88000 || address >= 0x3fc88800 || (address&3) != 0) { invalidAccess=true; return 0 }
    return nativeBufferAt(storage,2048).loadU32(address-0x3fc88000)
}
trusted fun sdMmcDmaS3Write(address: int,value: int): void {
    if (address < 0x3fc88000 || address >= 0x3fc88800 || (address&3) != 0) { invalidAccess=true; return }
    val memory=nativeBufferAt(storage,2048)
    if ((address&15) == 0 && (value&0x80000000) != 0) {
        var n=0
        while (n < expectedCount) {
            if (memory.loadU32(n*16+4) == 0 || memory.loadU32(n*16+8) == 0) prematurePublish=true
            n=n+1
        }
    }
    memory.storeU32(address-0x3fc88000,value)
    writes=writes+1
    return
}
@export("abla_sdmmc_dma_test")
trusted fun test(): i32 {
    val memory=nativeBufferAt(storage,2048)
    val descriptors=nativeBufferAt(0x3fc88000,2048)
    val payload=nativeBufferAt(0x3fc89000,0x77000)
    var bytes=4
    while (bytes <= 0x77000) {
        expectedCount=(bytes+4095)>>12
        var n=0
        while (n < 2048) { memory.store(n,0); n=n+1 }
        if (sdMmcDmaPrepareOwned(descriptors,payload,bytes,true) != expectedCount || sdMmcDmaInspectOwned(descriptors,payload,bytes) != 2) return i32(1)
        n=expectedCount-1
        while (n >= 0) {
            val flags=memory.loadU32(n*16)
            if (flags != (0x80000010|(if (n == 0) 8 else 0)|(if (n+1 == expectedCount) 4 else 0))) return i32(2)
            memory.storeU32(n*16,flags&0x7fffffff)
            if (sdMmcDmaInspectOwned(descriptors,payload,bytes) != (if (n == 0) 1 else 2)) return i32(3)
            n=n-1
        }
        if (bytes < 4104) bytes=bytes+4 else if (bytes < 0x77000) bytes=if (bytes+4096 > 0x77000) 0x77000 else bytes+4096 else bytes=bytes+4
    }
    expectedCount=2
    sdMmcDmaPrepareOwned(descriptors,payload,4100,true)
    memory.storeU32(16,memory.loadU32(16)|0x40000000)
    if (sdMmcDmaInspectOwned(descriptors,payload,4100) != 4) return i32(4)
    var word=0
    while (word < 8) {
        sdMmcDmaPrepareOwned(descriptors,payload,4100,true)
        memory.storeU32(word*4,memory.loadU32(word*4)^1)
        if (sdMmcDmaInspectOwned(descriptors,payload,4100) != 5) return i32(5)
        word=word+1
    }
    val before=writes
    if (sdMmcDmaPrepareOwned(descriptors,payload,512,false) != -2 || writes != before) return i32(6)
    if (sdMmcDmaPrepareOwned(descriptors,payload,0,true) != -1 || sdMmcDmaPrepareOwned(descriptors,payload,513,true) != -1 || sdMmcDmaPrepareOwned(descriptors,descriptors,512,true) != -1) return i32(7)
    if (sdMmcDmaPrepareOwned(nativeBufferAt(0x3fc88004,15),payload,512,true) != -1 || sdMmcDmaPrepareOwned(descriptors,nativeBufferAt(0x3fc87ffc,512),512,true) != -1 || sdMmcDmaPrepareOwned(descriptors,nativeBufferAt(0x3fc89001,512),512,true) != -1 || sdMmcDmaPrepareOwned(descriptors,nativeBufferAt(0x3fcffffc,512),512,true) != -1 || writes != before) return i32(8)
    if (invalidAccess || prematurePublish) return i32(9)
    return i32(0)
}
