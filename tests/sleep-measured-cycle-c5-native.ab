    if (address == 0x6009606c) return u32(if (preFault == 1) 0 else 5)
    if (address == 0x60096070) return u32(0x400000)
    if (address == 0x6000a004) return u32(0x20000000)
    if (address == 0x6000a040) return u32(0)
    if (address == 0x6000a044) return u32(1600)
    if (address == 0x6000a00c) return timeHigh
    if (address == 0x6000a010) return timeLow
    bad=true;return u32(0)
}
trusted fun esp32C5TimerWrite(address: int,value: u32): void {
    if (address == 0x6000a004) return
    if (address == 0x6000a00c) timeHigh=value
    else if (address == 0x6000a010) { if (fault == 6) { fault=0;return };timeLow=value }
    else if (address == 0x6000a05c) { if (value != u32(1)) bad=true;timeLoads=timeLoads+1 }
    else bad=true
    return
}
var fault=0
trusted fun cycleRecovering(): bool = nativeBufferAt(memory+232,792).loadU32(4) == 6
var bad=false
var clockReady=false
var cacheResumes=0
var predictorRestores=0
var flashDelay=0
var expectedResult=0
var expectedMHz=0
var rcGate=0
var modeStore=1
var requests=0
var efuseBusy=0
trusted fun c5SleepEntryRead(address: int): int {
    if (address == 0x600b1020) return modeStore
    if (address == 0x600b0068 && expectedResult == -2) return regRead(2048,0x68)|0x20000000
    if (address == 0x600b49d4) { if (efuseBusy > 0) { efuseBusy=efuseBusy-1;return 0 };return 1 }
    return regRead(2048,address-0x600b0000)
}
trusted fun c5SleepEntryWrite(address: int,value: int): void {
    if (address == 0x600b1020) { modeStore=value;return }
    val offset=address-0x600b0000
    if (offset == 0x12c && !cycleRecovering() && expectedResult == -3) return
    if (offset == 0x128 && cycleRecovering() && fault == 5) { fault=0;return }
    if (offset == 0x16c) regWrite(2048,0x160,regRead(2048,0x160)&~value)
    else if (offset == 0x134) regWrite(2048,0x148,0)
    else if (offset == 0x124) {
        if (value != 0x80000000 || expectedResult < 0) bad=true
        requests=requests+1;efuseBusy=3
        regWrite(3072,0x28,0xc0000000);regWrite(3072,0x14,20)
        regWrite(2048,0x160,if (expectedResult == 0) 0x80000000 else 0x40000000)
    } else regWrite(2048,offset,value)
    return
}
trusted fun regRead(bank: int,offset: int): int {
    if (offset < 0 || offset >= 512 || (offset&3) != 0) { bad=true;return 0 }
    nativeBufferAt(memory+bank,512).loadU32(offset)
}
trusted fun regWrite(bank: int,offset: int,value: int): void {
    if (offset < 0 || offset >= 512 || (offset&3) != 0) { bad=true;return }
    nativeBufferAt(memory+bank,512).storeU32(offset,value);return
}
trusted fun c5SleepPowerRead(offset: int): int = regRead(2048,offset)
trusted fun c5SleepPowerWrite(offset: int,value: int): void { regWrite(2048,offset,value);return }
trusted fun c5SleepDigitalRead(offset: int): int = regRead(2048,offset)
trusted fun c5SleepDigitalWrite(offset: int,value: int): void { regWrite(2048,offset,value);return }
trusted fun c5SleepAnalogRead(offset: int): int = regRead(2048,offset)
trusted fun c5SleepAnalogWrite(offset: int,value: int): void { regWrite(2048,offset,value);return }
trusted fun c5SleepTimingRead(offset: int): int = regRead(2048,offset)
trusted fun c5SleepTimingWrite(offset: int,value: int): void {
    if (preFault == 4 && !cycleAborting() && !injected && offset == 0x120) { injected=true;return }
    if (preFault == 7 && cycleAborting() && !cleanupInjected && offset == 0x120) { cleanupInjected=true;return }
    if (cycleRecovering() && fault == 1 && offset == 0x120) { fault=0;return }
    regWrite(2048,offset,value);return
}
trusted fun c5SleepEfuseRead(offset: int): int { bad=true;return 0 }
trusted fun c5CpuClockRead(offset: int): int = if (offset == 0x144) 0 else regRead(2560,offset)
trusted fun c5CpuClockWrite(offset: int,value: int): void {
    if (cycleAborting() && nativeBufferAt(memory+536,304).loadU32(0) != 0 && nativeBufferAt(memory+536,304).loadU32(4) != 4) bad=true
    if (preFault == 3 && !cycleAborting() && !injected && offset == 0x118) { injected=true;return }
    if (preFault == 9 && cycleAborting() && !cleanupInjected && offset == 0x118) { cleanupInjected=true;return }
    if (cycleRecovering() && nativeBufferAt(memory+536,304).loadU32(4) != 4) bad=true
    if (cycleRecovering() && offset == 0x118 && fault == 2) { fault=0;return }
    if (offset != 0x144) regWrite(2560,offset,value)
    return
}
trusted fun c5CpuClockTicks(mhz: int): void {
    val restoring=cycleRecovering() || cycleAborting() && nativeBufferAt(memory+424,48).loadU32(4) == 1
    if (mhz != (if (restoring) expectedMHz else 40)) bad=true
    clockReady=cycleRecovering();return
}
trusted fun c5ClockParkPvtActive(): bool { bad=true;return false }
trusted fun c5ClockParkPvt(record: NativeBuffer): int { bad=true;return 2 }
// These two paths must remain unused for XTAL/RC_FAST without PVT.
trusted fun c5ClockResumePll(record: NativeBuffer,limit: int): int { bad=true;return 3 }
trusted fun c5ClockResumePvt(record: NativeBuffer): int { bad=true;return 3 }
trusted fun c5ClockResumeRead(address: int): int = if (address == 0x600b00ac) regRead(2048,0xac) else if (address == 0x600b0420) rcGate else 0
trusted fun c5ClockResumeWrite(address: int,value: int): void {
    if (address == 0x600b00ac) regWrite(2048,0xac,value)
    else if (address == 0x600b0420) rcGate=value
    else bad=true
    return
}
trusted fun c5ClockResumeDelay(us: int): void { if (us != 50 && us != 5) bad=true;return }
trusted fun c5RtcTimerRead(offset: int): int = regRead(3072,offset)
trusted fun c5RtcTimerWrite(offset: int,value: int): void {
    if ((preFault == 5 || preFault == 8) && !cycleAborting() && !injected && offset == 0) { injected=true;return }
    if (preFault == 8 && cycleAborting() && !cleanupInjected && offset == 4) { cleanupInjected=true;return }
    if (offset == 0x34) {
        if (cycleRecovering() && !clockReady) bad=true
        if (cycleRecovering() && fault == 3) { fault=0;return }
        regWrite(3072,0x28,regRead(3072,0x28)&~value)
    } else if (offset == 4) regWrite(3072,offset,value&0x7fffffff)
    else regWrite(3072,offset,value)
    return
}
trusted fun c5SleepUartRead(address: int): int {
    if (address == 0x60096000 || address == 0x6009600c) {
        if (preFault == 10 && cycleAborting() && !cleanupInjected && address == 0x60096000) { cleanupInjected=true;return 0 }
        if (cycleRecovering() && cacheResumes != 1) bad=true
        if (cycleRecovering() && fault == 4 && address == 0x60096000) { fault=0;return 0 }
        return 1
    }
    if (address == 0x60096004 || address == 0x60096010) return 0x400000
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset == 0x98 || offset == 0x70) return 0
    return regRead(3584,port*256+offset)
}
trusted fun c5SleepUartWrite(address: int,value: int): void {
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset != 0x98) regWrite(3584,port*256+offset,value)
    return
}
trusted fun c5CachePredictorDisable(): int = 0x1030
trusted fun c5CacheRomSuspend(): int { cacheSuspends=cacheSuspends+1;return 0x80000001 }
trusted fun c5SleepFlashReadyDelay(us: int): void { if (!clockReady || us != 700) bad=true;flashDelay=flashDelay+1;return }
trusted fun c5CacheRomResume(saved: int): void {
    if (!clockReady || nativeBufferAt(memory+840,24).loadU32(4) != 6 || saved != 0x80000001 || flashDelay != 0) bad=true
    cacheResumes=cacheResumes+1;return
}
trusted fun c5CachePredictorRestore(saved: int): void { if (cacheResumes != 1 || saved != 0x1030) bad=true;predictorRestores=predictorRestores+1;return }


var calCfg=0
var calTimeout=0
var calMux=0
var calGate=0
var calDigital=0
var calStarts=0
var calReads=0
var calWaiting=0
var timeoutSource=0
var loseCleanup=false
var cleanupLost=false
trusted fun c5CalibrationRead(address: int): int {
    if (cacheSuspends != 0) bad=true
    if (address == 0x600b0400) return 0
    if (address == 0x60096110) return regRead(2560,0x110)
    if (address == 0x60096054) return 1
    if (address == 0x600b00ac) return 0x40000000
    if (address == 0x60096160) return calGate
    if (address == 0x600b0420) return calDigital
    if (address == 0x60096130) return calMux
    if (address == 0x60008068) {
        if ((calCfg&0x80000000) != 0) {
            if (calWaiting > 0) calWaiting=calWaiting-1
            else if ((calMux&7) != timeoutSource) return calCfg|0x8000
        }
        return calCfg
    }
    if (address == 0x60008080) {
        if ((calTimeout&0xffffff80) == 128 || calWaiting == 0 && (calMux&7) == timeoutSource) return calTimeout|1
        return calTimeout
    }
    if (address == 0x6000806c) {
        calReads=calReads+1
        val count=(calCfg>>>16)&32767
        val value=if ((calMux&7) == 3) 40*count*7 else 40*count*32/20
        return value<<7
    }
    bad=true;return 0
}
trusted fun c5CalibrationWrite(address: int,value: int): void {
    if (cacheSuspends != 0) bad=true
    if (address == 0x60096160) calGate=value
    else if (address == 0x600b0420) calDigital=value
    else if (address == 0x60096130) {
        if (loseCleanup && calReads == 2 && !cleanupLost && value == 0x44000700) { cleanupLost=true;return }
        calMux=value
    } else if (address == 0x60008080) calTimeout=value&~1
    else if (address == 0x60008068) {
        if ((value&0x80000000) != 0 && (calCfg&0x80000000) == 0) { calStarts=calStarts+1;calWaiting=4 }
        calCfg=value&~0x8000
    } else bad=true
    return
}
@export("abla_sleep_measured_cycle_c5_test")
trusted fun test(): int {
    val wrapper=nativeBufferAt(memory,1024);val request=nativeBufferAt(memory+1024,68)
    var mode=0
    while (mode < 20) {
        var i=0;while (i < 4096) { nativeBufferAt(memory,4096).storeU32(i,0);i=i+4 }
        timeHigh=u32(0);timeLow=u32(0);timeLoads=0;cacheSuspends=0;preFault=0
        bad=false;fault=if (mode%10 == 4) 6 else 0;clockReady=false;cacheResumes=0;predictorRestores=0;flashDelay=0;rcGate=0
        val kind=mode%10
        expectedResult=if (kind == 1) 1 else if (kind == 2) -3 else if (kind == 3) -2 else 0
        val source=if (mode < 10) 0 else 1;expectedMHz=if (source == 0) 20 else 10
        requests=0;modeStore=1;efuseBusy=0
        regWrite(2560,0x110,(40<<24)|(source<<16));regWrite(2560,0x118,1);regWrite(2560,0x11c,1)
        regWrite(3072,4,0x42);regWrite(3072,0,0x12345678)
        calCfg=0x21005;calTimeout=0xabcdef18;calMux=0x44000700;calGate=0x84;calDigital=0xf0001234
        calStarts=0;calReads=0;calWaiting=0;timeoutSource=if (kind == 6) 3 else if (kind == 7) 4 else 0
        loseCleanup=kind == 5;cleanupLost=false
        val cal=esp32C5SleepCalibrationDecode(u32(0x210),u32(0xffffffff),u32(1))
        request.storeU32(4,0x1234);request.storeU32(8,cal|0)
        // Zero periods are intentional: the measured entry replaces them.
        request.storeU32(24,117);request.storeU32(28,-1)
        request.storeU32(36,3);request.storeU32(40,2)
        if (kind != 8) { request.storeU32(44,16);request.storeU32(48,1) }
        request.storeU32(52,16);request.storeU32(60,16)
        if (kind == 9) request.storeU32(0,4)
        var result=esp32C5SleepMeasuredBeginOwned(wrapper,request,256,8192,true)
        if (kind == 9) {
            if (result != 2 || wrapper.loadU32(0) != 0 || calStarts != 0 || requests != 0) return 1
        } else {
            if (result != 3 || calStarts != 1 || cacheSuspends != 0) return 2
            // Caller request changes after Begin must not change this cycle.
            request.storeU32(0,4);request.storeU32(40,0);request.storeU32(60,0)
            var retries=0
            while (result == 3 && retries < 20) { result=esp32C5SleepMeasuredContinueOwned(wrapper,true);retries=retries+1 }
            if (result != (if (kind >= 6) 4 else 1) || bad || calCfg != 0x21005 || calMux != 0x44000700 ||
                calGate != 0x84 || calDigital != 0xf0001234 || calTimeout != 0xabcdef18) return 3
            if (calStarts != (if (kind == 6) 1 else 2) || kind == 5 && !cleanupLost) return 4
            if (kind >= 6) {
                if (cacheSuspends != 0 || requests != 0 || wrapper.loadU32(24) != (if (kind == 6) 1 else if (kind == 7) 2 else 4)) return 5
            } else {
                if (int(i32(wrapper.loadU32(244))) != expectedResult || requests != (if (expectedResult < 0) 0 else 1) ||
                    cacheSuspends != 1 || cacheResumes != 1 || calReads != 2 || timeLoads != (if (expectedResult == 0) 1 else 0) ||
                    expectedResult == 0 && timeLow != u32(3840)) return 6
                if (wrapper.loadU32(44) != 3670016 || wrapper.loadU32(48) != 26214) return 7
            }
            val starts=calStarts;val issued=requests
            if (esp32C5SleepMeasuredContinueOwned(wrapper,true) != result || calStarts != starts || requests != issued) return 8
        }
        mode=mode+1
    }
    return 0
}
