import "./p4-retention-graph-checks.ab"
// Test-only PAU interpreter for the flash route. Executes actual emitted
// descriptor bytes against a modeled register window and real backup memory.
// Deliberately rejects active WAIT/bitmap/unknown modes rather than inventing
// their hardware behavior. The flash route needs contiguous copy, masked
// WRITE, branching, skip directions and the both-skipped terminal WAIT.
val flashTransferRegisters=nativeStaticAllocate(8192)
fun flashTransferBase(n: int): int =
    if (n == 0) 0x5008d000 else if (n == 1) 0x5008d0c0 else if (n == 2) 0x5008d180 else if (n == 3) 0x5008c000 else if (n == 4) 0x5008c100 else if (n == 5) 0x5008c200 else 0x5008c384
fun flashTransferWords(n: int): int = if (n == 0) 42 else if (n == 1) 6 else if (n == 3) 55 else if (n == 4) 41 else if (n == 6) 2 else 1
fun flashTransferInitial(offset: int): int = (0x5a000000^(offset*0x1021))&0xffffffff
fun flashTransferSelected(address: int): bool {
    var n=0
    while (n < 7) { if (address >= flashTransferBase(n) && address < flashTransferBase(n)+flashTransferWords(n)*4) return true;n=n+1 }
    return false
}
trusted fun runFlashTransfer(graph: NativeBuffer,backing: NativeBuffer,head: int,entry: int,backup: bool): int {
    var cursor=head
    var nodes=0
    var copied=0
    val regs=nativeBufferAt(flashTransferRegisters,8192)
    while (nodes < 64) {
        val offset=cursor-graph.addressValue()
        if ((cursor&3) != 0 || !graph.hasAddressRange(offset,20)) return -1
        val h=graph.loadU32(offset)
        val branch=(h&0x10000000) != 0
        val body=if (branch) 20 else 8
        if (!graph.hasAddressRange(offset,body+12)) return -2
        val skipped=(h&(if (backup) 0x40000000 else 0x20000000)) != 0
        if (!skipped) {
            val mode=(h>>>16)&15
            val register=graph.loadU32(offset+body+(if (mode == 0 && !backup) 4 else 0))
            val regOffset=register-0x5008c000
            if (mode == 0) {
                val bytes=(h&1023)*4
                val memory=graph.loadU32(offset+body+8)-backing.addressValue()
                if (bytes == 0 || (regOffset&3) != 0 || (memory&3) != 0 || !regs.hasAddressRange(regOffset,bytes) || !backing.hasAddressRange(memory,bytes)) return -3
                var word=0
                while (word < bytes) {
                    if (backup) backing.storeU32(memory+word,regs.loadU32(regOffset+word))
                    else regs.storeU32(regOffset+word,backing.loadU32(memory+word))
                    word=word+4;copied=copied+1
                }
            } else if (mode == 2) {
                if ((regOffset&3) != 0 || !regs.hasAddressRange(regOffset,4)) return -4
                val value=graph.loadU32(offset+body+4);val mask=graph.loadU32(offset+body+8)
                regs.storeU32(regOffset,(regs.loadU32(regOffset)&(mask^0xffffffff))|(value&mask))
            } else return -5
        }
        nodes=nodes+1
        if ((h&0x80000000) != 0) return (nodes<<16)|copied
        cursor=graph.loadU32(offset+4+(if (branch) entry*4 else 0))
    }
    return -6
}
trusted fun retentionFlashTransferChecks(): int {
    val configs=nativeBufferAt(profileConfigs,76*56+4)
    val backing=nativeBufferAt(profileBacking,6000)
    val scratch=nativeBufferAt(profileScratch,56)
    val output=nativeBufferAt(profileOutput,2000)
    val entries=nativeBufferAt(graphEntries,20)
    val registers=nativeBufferAt(flashTransferRegisters,8192)
    var uart=-1
    while (uart < 5) {
        var flags=0
        while (flags < 4) {
            val psram=(flags&1) != 0;val pvt=(flags&2) != 0
            val count=esp32p4RetentionProfileConfigs(configs,backing,scratch,uart,psram,pvt)
            val bytes=esp32p4RetentionGraphEncode(output,entries,configs,scratch,uart,psram,pvt,300)
            if (count == 0 || bytes == 0) return 180
            val graph=nativeBufferAt(profileOutput,bytes)
            var word=0
            while (word < 8192) { registers.storeU32(word,flashTransferInitial(word));word=word+4 }
            word=0
            while (word < 6000) { backing.storeU32(word,0xdeadbeef);word=word+4 }
            if (runFlashTransfer(graph,backing,entries.loadU32(12),3,true) != ((9<<16)|148)) return 181
            word=0
            while (word < 8192) { if (registers.loadU32(word) != flashTransferInitial(word)) return 182;word=word+4 }
            // Verify exact backing contents and untouched sibling buffers.
            word=0
            while (word < 6000) {
                var expected=0xdeadbeef
                var i=0
                while (i < count) {
                    val key=p4RetentionProfileNode(uart,psram,pvt,i)
                    if (key >= 1536 && key <= 1542) {
                        val n=key-1536;val start=configs.loadU32(i*56+28)-profileBacking
                        if (word >= start && word < start+flashTransferWords(n)*4) expected=flashTransferInitial(flashTransferBase(n)-0x5008c000+word-start)
                    }
                    i=i+1
                }
                if (backing.loadU32(word) != expected) return 183
                word=word+4
            }
            // Corrupt the complete register window, including MMU INDEX /
            // CONTENT. Only retained ranges and calibration bit6 may change.
            word=0
            while (word < 8192) { registers.storeU32(word,flashTransferInitial(word)^0xffffffff);word=word+4 }
            if (runFlashTransfer(graph,backing,entries.loadU32(12),3,false) != ((9<<16)|148)) return 184
            word=0
            while (word < 8192) {
                var expected=flashTransferInitial(word)
                if (!flashTransferSelected(0x5008c000+word)) expected=expected^0xffffffff
                if (word == 0x180) expected=expected|64
                if (registers.loadU32(word) != expected) return 185
                word=word+4
            }
            flags=flags+1
        }
        uart=uart+1
    }
    return 0
}
