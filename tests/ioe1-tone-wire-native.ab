import "./corematrix-wire-native.ab"
import "../src/io_expander/m5ioe1_tone.ab"
val toneMemory=nativeStaticAllocate(32)
@export("abla_ioe1_tone_wire_test")
trusted fun testIoe1Tone(): i32 {
    wireSeed()
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val chip=M5Ioe1(control.expanders().device(0)|0)
    val tone=nativeBufferAt(toneMemory,32);val regs=nativeBufferAt(registers,512)
    var channel=0
    while (channel < 4) {
        var failure=0
        while (failure <= 15) {
            var commit=0
            while (commit < 2) {
                var at=0;while (at < 32) { tone.store(at,0);at=at+1 }
                at=27;while (at < 35) { regs.store(at,0);at=at+1 }
                regs.storeU16(37,1000)
                val before=ackCount;nackAfterCommit=commit == 1;nackAt=if (failure == 0) 0 else before+failure
                val result=ioe1ToneStartOwned(tone,chip,channel,2000,2048,4294967290,10,true)
                val original=if (failure == 0) 0 else if (failure <= 3) 1 else if (failure <= 7) 2 else if (failure <= 11) 3 else 4
                if (result != (if (failure == 0) 1 else 4) || tone.loadU32(16) != original || ackCount-before != (if (failure == 0) 15 else failure) || bad) return i32(2)
                nackAt=0
                if (failure == 0) {
                    val pending=ackCount
                    if (regs.loadU16(37) != 2000 || regs.loadU16(27+channel*2) != 34816 || ioe1TonePollOwned(tone,3,true) != 5 || ackCount != pending) return i32(3)
                }
                var fault=1
                while (fault <= (if (failure > 0 && failure <= 3) 4 else 8)) {
                    nackAt=ackCount+fault
                    if (ioe1ToneStopOwned(tone,true) != 4 || tone.loadU32(16) != original || bad) return i32(4)
                    fault=fault+1
                }
                nackAt=0
                if (ioe1ToneStopOwned(tone,true) != 6 || regs.loadU16(37) != 1000 || regs.loadU16(27+channel*2) != 0 || tone.loadU32(16) != original || bad) return i32(5)
                val stopped=ackCount
                if (ioe1ToneStopOwned(tone,true) != 6 || ioe1TonePollOwned(tone,4,true) != 6 || ackCount != stopped) return i32(6)
                var other=0;while (other < 4) { if (regs.loadU16(27+other*2) != 0) return i32(7);other=other+1 }
                commit=commit+1
            }
            failure=failure+1
        }
        channel=channel+1
    }
    nackAfterCommit=false;var at=0;while (at < 32) { tone.store(at,0);at=at+1 }
    val before=ackCount
    if (ioe1ToneStartOwned(tone,chip,4,2000,2048,0,10,true) != 2 || ioe1ToneStartOwned(tone,chip,0,2000,2048,0,10,false) != 2 || ackCount != before) return i32(8)
    if (ioe1ToneStartOwned(tone,chip,0,2000,2048,4294967290,10,true) != 1 || ioe1TonePollOwned(tone,4,true) != 6 || regs.loadU16(37) != 1000 || regs.loadU16(27) != 0) return i32(9)
    if (!control.closeOwned(true) || pads != 0 || bad) return i32(10)
    return i32(0)
}
