import "../src/i2c/register_access.ab"
import "../src/io_expander/aw9523_device.ab"
type I2cBus = int
type I2cDevice = int
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int, frequency: int): I2cDevice =
    I2cDevice(if (address >= 88 && address <= 91 && frequency == 400000) 1 else 0)
fun I2cDevice.close(): bool = this == 1
var registers = 0
var steps = 0
var failure = -1
var delays = 0
var bad = false
// Unused multi-byte transport hooks must never be reached by this driver.
fun I2cDevice.readRegister(register: int, bytes: NativeBuffer, length: int): bool { bad = true; false }
fun I2cDevice.writeRegister(register: int, bytes: NativeBuffer, length: int): bool { bad = true; false }
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    steps = steps + 1
    if (this != 1 || register < 0 || register > 127) { bad = true; return I2cByteResult(0) }
    if (steps == failure) return I2cByteResult(0)
    I2cByteResult(256 | int(nativeAddressLoadU32(registers, register * 4)))
}
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool {
    steps = steps + 1
    if (this != 1 || register < 0 || register > 127 || value < 0 || value > 255) { bad = true; return false }
    if (steps == failure) return false
    nativeAddressStoreU32(registers, register * 4, value)
    true
}
fun peripheralDelayMicroseconds(duration: int): void {
    if (duration != 1000) bad = true
    delays = delays + 1
    return
}
trusted fun resetRegisters(): void {
    var index = 0
    while (index < 128) {
        nativeAddressStoreU32(registers, index * 4, 165)
        index = index + 1
    }
    steps = 0
    failure = -1
    delays = 0
    return
}
trusted fun valueAt(register: int): int = int(nativeAddressLoadU32(registers, register * 4))
trusted fun main(): int {
    registers = nativeStackAllocate(512)
    resetRegisters()
    val chip = aw9523(I2cBus(1))
    if (!chip.valid() || aw9523(I2cBus(0)).valid() || aw9523(I2cBus(1), 87).valid() || aw9523(I2cBus(1), 92).valid()) return 1
    nativeAddressStoreU32(registers, 64, 35)
    if (!chip.begin() || steps != 1 || delays != 0) return 2
    var pin = 0
    while (pin < 16) {
        resetRegisters()
        val bit = 1 << (pin & 7)
        val bank = pin / 8
        if (!chip.digitalWrite(pin, true) || valueAt(2 + bank) != (165 | bit)) return 3
        if (!chip.digitalWrite(pin, false) || valueAt(2 + bank) != (165 & (255 - bit))) return 4
        if (!chip.setDirection(pin, true) || valueAt(4 + bank) != (165 & (255 - bit))) return 5
        if (!chip.setDirection(pin, false) || valueAt(4 + bank) != (165 | bit)) return 6
        if (!chip.setGpioMode(pin, false) || valueAt(18 + bank) != (165 & (255 - bit))) return 7
        if (!chip.setGpioMode(pin, true) || valueAt(18 + bank) != (165 | bit)) return 8
        if (!chip.setInterruptEnabled(pin, true) || valueAt(6 + bank) != (165 & (255 - bit))) return 9
        if (!chip.setInterruptEnabled(pin, false) || valueAt(6 + bank) != (165 | bit)) return 10
        val sample = chip.digitalReadChecked(pin)
        if (!sample.valid() || sample.value() != ((165 >> (pin & 7)) & 1)) return 11
        val expectedDim = if (pin < 8) 36 + pin else if (pin < 12) 24 + pin else 32 + pin
        if (!chip.setLedCurrent(pin, 123) || aw9523DimRegister(pin) != expectedDim || valueAt(expectedDim) != 123) return 12
        pin = pin + 1
    }
    resetRegisters()
    val ports = chip.readPortsChecked()
    if (!ports.valid() || ports.value() != 42405 || steps != 2) return 13
    var fail = 1
    while (fail <= 2) {
        resetRegisters()
        failure = fail
        if (chip.digitalWrite(9, false) || valueAt(3) != 165 || steps != fail) return 14
        resetRegisters()
        failure = fail
        if (chip.readPortsChecked().valid() || steps != fail) return 15
        fail = fail + 1
    }
    resetRegisters()
    if (chip.setLedCurrent(16, 5) || chip.setLedCurrent(0, 256) || chip.setDirection(-1, true) ||
        chip.configureControl(true, 4) || steps != 0) return 16
    var scale = 0
    while (scale < 4) {
        if (!chip.configureControl(true, scale) || valueAt(17) != (16 | scale)) return 17
        if (!chip.configureControl(false, scale) || valueAt(17) != scale) return 18
        scale = scale + 1
    }
    resetRegisters()
    failure = 1
    if (chip.softwareReset() || delays != 0 || valueAt(127) != 165) return 19
    resetRegisters()
    if (!chip.softwareReset() || delays != 1 || steps != 1 || valueAt(127) != 0 || !chip.close() || bad) return 20
    0
}
