import "../src/esp32/rtc_retention_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_retention_target")
@section(".iram1.abla.s3RetentionTarget")
trusted fun retentionTarget(cpu: NativeBuffer,tags: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan,small: bool,operation: int): int {
    if (operation == 0) return if (esp32S3RetentionInitOwned(cpu,tags,i,d)) 1 else 0
    if (operation == 1) return esp32S3RetentionArmOwned(cpu,tags,i,d,small)
    esp32S3RetentionFinishOwned(i,d)
}
