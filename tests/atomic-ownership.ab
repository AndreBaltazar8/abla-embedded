import "../src/atomic.ab"
import "abla/unsafe/memory"

trusted fun main(): int {
    val storage = nativeStackAllocate(4)
    ablaUnsafeStoreU32(nativePointerFromAddress(storage), 0)
    val lock = atomicU32At(storage)
    if (!lock.tryClaim(u32(17))) return 1
    if (lock.tryClaim(u32(17)) || lock.tryClaim(u32(18))) return 2
    if (lock.releaseClaim(u32(18)) || lock.releaseClaim(u32(0))) return 3
    if (!lock.releaseClaim(u32(17))) return 4
    if (lock.releaseClaim(u32(17)) || lock.tryClaim(u32(0))) return 5
    if (!lock.tryClaim(u32(0xffffffff)) || !lock.releaseClaim(u32(0xffffffff))) return 6
    if (atomicU32At(0).tryClaim(u32(1)) || atomicU32At(0).releaseClaim(u32(1))) return 7
    if (atomicU32At(storage + 1).tryClaim(u32(1)) ||
        atomicU32At(storage + 1).releaseClaim(u32(1))) return 8
    if (ablaUnsafeLoadU32(nativePointerFromAddress(storage)) != 0) return 9
    0
}
