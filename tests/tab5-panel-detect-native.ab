import "../src/m5stack/tab5_panel_detect_sequence.ab"
import "../src/m5stack/tab5_panel_start_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(16)
val startupMemory=nativeStaticAllocate(32)
var commands=0
var unexpectedMmio=false
// Tripwires for imported low-level declarations; composition uses command mock.
fun p4DsiRead(offset: int): u32 { unexpectedMmio=true; return u32(0) }
fun p4DsiWrite(offset: int,value: u32): void { unexpectedMmio=true; return }
var startedPanel=0
var transport=1
fun tab5PanelStartCommands(panel: int,channel: int,polls: int): DsiCommandResult {
    commands=commands+1; startedPanel=panel; return DsiCommandResult(transport)
}
var calls=0
var waits=0
var readyAfter=0
var version=1
var blocked=false
var gt=false
var ili=1
var iliCalls=0
fun tab5TouchPrepare(bus: int): int = if (blocked) 4 else 1
fun tab5TouchFirmware(handle: int): I2cByteResult { calls=calls+1; return if (calls >= readyAfter) I2cByteResult(256|version) else I2cByteResult(0) }
fun tab5TouchGtAck(bus: int): bool = gt
fun tab5PanelDetectDelay(ms: int): void { waits=waits+ms; return }
fun tab5PanelDetectIli(channel: int,scratch: NativeBuffer,polls: int): int { iliCalls=iliCalls+1; return ili }
@export("abla_tab5_panel_detect_test")
fun testPanel(): i32 {
    var attempt=1
    while (attempt <= 60) {
        calls=0; waits=0; readyAfter=attempt
        val result=m5BoardTab5.waitTab5TouchOwned(1,2)
        if (result.status() != 1 || calls != attempt || waits != (attempt-1)*10 || result.tab5LaneKbps() != 900000) return i32(1)
        attempt=attempt+1
    }
    calls=0; waits=0; readyAfter=61
    if (m5BoardTab5.waitTab5TouchOwned(1,2).status() != 5 || calls != 60 || waits != 590) return i32(2)
    calls=0; waits=0; blocked=true
    if (m5BoardTab5.waitTab5TouchOwned(1,2).status() != 6 || calls != 0 || waits != 0) return i32(3)
    blocked=false; version=99; readyAfter=1; gt=true
    if (m5BoardTab5.waitTab5TouchOwned(1,2,2).status() != 4) return i32(4)
    val buffer=nativeBufferAt(memory,16)
    if (M5Tab5TouchProbe(257).identifyTab5PanelOwned(0,buffer,10).panel() != 2 ||
        M5Tab5TouchProbe(770).identifyTab5PanelOwned(0,buffer,10).panel() != 3 || iliCalls != 0) return i32(5)
    var status=0
    while (status <= 3) {
        ili=status|(5<<8)|(0x128198<<16)
        val result=M5Tab5TouchProbe(3).identifyTab5PanelOwned(0,buffer,10)
        if (result.iliResult() != ili || result.panel() != (if (status == 1) 1 else 0) ||
            result.status() != (if (status == 0) 2 else if (status == 1) 1 else status+1)) return i32(6)
        status=status+1
    }
    if (M5Tab5TouchProbe(1).tab5LaneKbps() != 0 || M5Tab5TouchProbe(770).tab5LaneKbps() != 1040000 ||
        M5Tab5TouchProbe(3).tab5LaneKbps() != 1040000 ||
        M5Tab5TouchProbe(3).identifyTab5PanelOwned(0,NativeBuffer(0),10).status() != 2) return i32(7)
    val scratch=nativeBufferAt(startupMemory,32)
    var panel=1
    while (panel <= 3) {
        val probe=M5Tab5TouchProbe(if (panel == 1) 3 else if (panel == 2) 257 else 770)
        ili=1|(0x128198<<16); commands=0; transport=1
        val ready=probe.startTab5PanelOwned(0,scratch,10)
        if (!ready.ready() || ready.panel() != panel || startedPanel != panel || commands != 1 ||
            scratch.loadU32(24) != 1 || ready.laneKbps() != (if (panel == 2) 900000 else 1040000)) return i32(8)
        transport=9|(15<<8)|(123<<32)
        val failed=probe.startTab5PanelOwned(0,scratch,10)
        if (failed.ready() || failed.status() != 4 || failed.transport() != transport ||
            scratch.loadU32(28) != 123 || failed.laneKbps() != 0) return i32(9)
        panel=panel+1
    }
    commands=0; ili=2
    if (M5Tab5TouchProbe(3).startTab5PanelOwned(0,scratch,10).status() != 3 || commands != 0 ||
        scratch.loadU32(16) != ((3<<8)|(2<<16)) || scratch.loadU32(24) != 0) return i32(10)
    if (M5Tab5TouchProbe(257).startTab5PanelOwned(0,buffer,10).status() != 2 || commands != 0) return i32(11)
    if (unexpectedMmio) return i32(12)
    return i32(0)
}
