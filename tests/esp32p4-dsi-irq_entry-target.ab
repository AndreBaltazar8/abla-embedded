import "../src/esp32/irq_entry_esp32p4.ab"
import "../src/esp32/irq_config_esp32p4.ab"
import "../src/esp32/irq_dispatch_esp32p4.ab"
import "../src/esp32/irq_vectors_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_irq_entry_target")
trusted fun target(config: bool,core: int,callback: int,context: int): int {
    if (core == -3) return esp32P4IrqPrepareTableOwned(nativeBufferAt(context,192),nativeBufferAt(callback,64))
    if (core == -2) return p4IrqDispatchAt(nativeBufferAt(context,272)).publishOwned()
    if (core >= 0) return if (config) esp32P4IrqConfigureOwned(core,callback,context) else esp32P4IrqUnconfigureOwned(core,callback)
    return if (config) esp32P4IrqConfigAddress() else esp32P4IrqEntryAddress()
}
