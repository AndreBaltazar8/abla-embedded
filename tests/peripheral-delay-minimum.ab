import "../src/esp32/peripheral_delay_1khz_logic.ab"
fun main(): int {
    if (peripheralDelayTicks1Khz(0) != 0 || peripheralDelayTicks1Khz(-1) != 0 ||
        peripheralDelayTicks1Khz(9223372036854775807) != 1001) return 1
    var requested = 1
    while (requested <= 2001) {
        var remaining = requested
        var minimumElapsed = 0
        while (remaining > 0) {
            val ticks = peripheralDelayTicks1Khz(remaining)
            if (ticks < 2 || ticks > 1001 || ticks - 1 > remaining) return 2
            // Worst phase: the first tick occurs immediately after blocking.
            minimumElapsed = minimumElapsed + ticks - 1
            remaining = remaining - (ticks - 1)
        }
        if (minimumElapsed != requested) return 3
        requested = requested + 1
    }
    0
}
