import "../src/esp32/gpio/wake_s3_sequence.ab"
import "abla/build"
var wakePin=0
var wakeReg=0
var wakeOriginal=0
var wakeWrites=0
var wakeDrop=0
var wakeBad=false
fun s3GpioWakeRead(address: int): int { if (address != 0x60004074+wakePin*4) wakeBad=true;return wakeReg }
fun s3GpioWakeWrite(address: int,value: int): void {
    if (address != 0x60004074+wakePin*4 || ((value^wakeOriginal)&(~0x780)) != 0) wakeBad=true
    wakeWrites=wakeWrites+1
    if (wakeWrites != wakeDrop) wakeReg=value
    return
}
fun seedGpioWake(pin: int,fields: int): void {
    wakePin=pin;wakeReg=0xa5a01804|(fields<<7);wakeOriginal=wakeReg;wakeWrites=0;wakeDrop=0;wakeBad=false;return
}
@export("abla_gpio_wake_s3_test")
fun gpioWakeTest(): int {
    var pin=0
    while (pin < 49) {
        if (pin < 22 || pin > 25) {
            var profile=0
            while (profile < 32) {
                seedGpioWake(pin,profile&15)
                val owner=esp32S3GpioWakeOpenOwned(pin,profile >= 16,true)
                if (owner.status() != 1 || !owner.hasSnapshot() || owner.pin() != pin ||
                    (wakeReg&0x780) != (if (profile >= 16) 0x680 else 0x600)) return 1
                val closed=owner.closeOwned(true)
                if (closed.status() != 5 || wakeReg != wakeOriginal || wakeBad) return 2
                val count=wakeWrites
                if (closed.closeOwned(true).status() != 5 || count != wakeWrites) return 3
                profile=profile+1
            }
        } else if (esp32S3GpioWakeOpenOwned(pin,false,true).status() != 2) return 4
        pin=pin+1
    }
    var fault=1
    while (fault <= 3) {
        seedGpioWake(48,15);wakeDrop=fault
        val owner=esp32S3GpioWakeOpenOwned(48,false,true)
        if (owner.status() != 4 || !owner.hasSnapshot()) return 5
        wakeDrop=0
        if (owner.closeOwned(true).status() != 5 || wakeReg != wakeOriginal) return 6
        seedGpioWake(48,15)
        val ready=esp32S3GpioWakeOpenOwned(48,false,true);wakeDrop=wakeWrites+fault
        val partial=ready.closeOwned(true);wakeDrop=0
        if (partial.status() != 4 || partial.closeOwned(true).status() != 5 || wakeReg != wakeOriginal || wakeBad) return 7
        fault=fault+1
    }
    seedGpioWake(48,0);wakeReg=wakeReg|0x2000
    if (esp32S3GpioWakeOpenOwned(48,false,true).status() != 3 || wakeWrites != 0 ||
        esp32S3GpioWakeOpenOwned(-1,false,true).status() != 2 || esp32S3GpioWakeOpenOwned(49,false,true).status() != 2) return 8
    return 0
}
