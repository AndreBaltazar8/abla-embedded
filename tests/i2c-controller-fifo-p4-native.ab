import "../src/esp32/i2c/controller_p4_sequence.ab"
import "../src/esp32/i2c/poll_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(288)
val tx=nativeStaticAllocate(64)
val rx=nativeStaticAllocate(64)
val payload=nativeStaticAllocate(40)
val checked=nativeStaticAllocate(128)
var writes=0
var drop=0
var fifoReads=0
var dropRead=0
var rxCursor=0
var starts=0
var triggered=false
var eventReads=0
var eventDelay=1
var events=u32(128)
var done=true
var tick=u32(0)
var bad=false
fun mapping(address: int): int =
    if (address >= 0x500c4000 && address < 0x500c4080) address-0x500c4000
    else if (address >= 0x500c5000 && address < 0x500c5080) address-0x500c5000+128
    else if (address == 0x500e601c) 256 else if (address == 0x500e6040) 260
    else if (address == 0x500e60c4) 268 else -1
trusted fun p4I2cRead(address: int): u32 {
    val at=mapping(address)
    if (at < 0) { bad=true;return u32(0) }
    val m=nativeBufferAt(memory,288)
    val b=if (at < 128) 0 else 128
    if (at == b+28) {
        fifoReads=fifoReads+1
        val count=(m.loadU32(b+8)>>8)&63
        if (count < 1 || count > 32) { bad=true;return u32(0) }
        val value=nativeBufferAt(rx,64).load(b/4+rxCursor)
        if (fifoReads != dropRead) { rxCursor=rxCursor+1;m.storeU32(b+8,m.loadU32(b+8)-256) }
        return u32(value)
    }
    if (at == b+32 && triggered) {
        eventReads=eventReads+1
        if (eventReads >= eventDelay) {
            m.storeU32(at,int(events))
            if (done) m.storeU32(b+96,m.loadU32(b+96)|0x80000000)
        }
    }
    return u32(m.loadU32(at))
}
trusted fun p4I2cWrite(address: int,value: u32): void {
    writes=writes+1
    val at=mapping(address)
    if (at < 0) { bad=true;return }
    val b=if (at < 128) 0 else 128
    nativeBufferAt(checked,128).store(writes,if (at == b+36 || (at == b+4 && (value&u32(2048)) != u32(0))) 0 else 1)
    if (writes == drop) return
    val m=nativeBufferAt(memory,288)
    if (at == b+28) {
        val used=(m.loadU32(b+8)>>18)&63
        if (used >= 32) { bad=true;return }
        nativeBufferAt(tx,64).store(b/4+used,int(value)&255)
        m.storeU32(b+8,m.loadU32(b+8)+(1<<18));return
    }
    if (at == b+24 && (value&u32(0x3000)) != u32(0)) m.storeU32(b+8,m.loadU32(b+8)&(0xffffffff^((63<<18)|(63<<8))))
    if (at == b+36) { m.storeU32(b+32,m.loadU32(b+32)&(0xffffffff^int(value)));return }
    if (at == b+4) {
        if ((value&u32(32)) != u32(0)) { starts=starts+1;triggered=true }
        m.storeU32(at,int(value&u32(0xfffff7ff)));return
    }
    m.storeU32(at,int(value));return
}
trusted fun p4I2cCounter(): u32 { tick=tick+u32(1);return tick }
trusted fun seed(port: int): void {
    val m=nativeBufferAt(memory,288)
    var at=0
    while (at < 288) { m.storeU32(at,0);at=at+4 }
    m.storeU32(256,0x3000);m.storeU32(260,0x8000002)
    m.storeU32(port*128+4,0x110);m.storeU32(port*128+24,0x4000)
    var i=0
    while (i < 40) { nativeBufferAt(payload,40).store(i,i^0xa5);i=i+1 }
    i=0
    while (i < 64) { nativeBufferAt(tx,64).store(i,0);nativeBufferAt(rx,64).store(i,i^0x5a);i=i+1 }
    writes=0;drop=0;fifoReads=0;dropRead=0;rxCursor=0;starts=0;triggered=false;eventReads=0;eventDelay=1;events=u32(128);done=true;tick=u32(0);bad=false;return
}
trusted fun initSeed(port: int): void {
    seed(port)
    val m=nativeBufferAt(memory,288);val b=port*128
    m.storeU32(b+4,0xfffff7df);m.storeU32(b+24,0x4400);m.storeU32(b+40,0x7ffff);m.storeU32(b+80,1023)
    var i=0
    while (i < 8) { m.storeU32(b+88+i*4,0xffffffff);i=i+1 }
    return
}
trusted fun queue(port: int,terminal: int): bool {
    val data=nativeBufferAt(payload,40)
    return esp32p4I2cWriteFifoOwned(port,data,2,true) == 513 &&
        esp32p4I2cWriteCommandOwned(port,0,esp32S3I2cCommand(6,0),true) == 1 &&
        esp32p4I2cWriteCommandOwned(port,1,esp32S3I2cCommand(1,2,true),true) == 1 &&
        esp32p4I2cWriteCommandOwned(port,2,esp32S3I2cCommand(terminal,0),true) == 1
}
@export("abla_i2c_controller_fifo_p4_test")
trusted fun test(): i32 {
    val data=nativeBufferAt(payload,40)
    var port=0
    while (port < 2) {
        var filter=0
        while (filter < 16) {
            initSeed(port)
            if (esp32p4I2cInitializeControllerOwned(port,filter,true) != 1 || starts != 0 || !p4I2cFifoReady(port) || bad) return i32(1)
            val m=nativeBufferAt(memory,288);val b=port*128
            if ((m.loadU32(b+80)&1023) != (if (filter == 0) 0 else filter|(filter<<4)|768) || m.loadU32(b+40) != 0) return i32(2)
            var i=0
            while (i < 8) { if (m.loadU32(b+88+i*4) != 8192) return i32(3);i=i+1 }
            filter=filter+1
        }
        initSeed(port)
        if (esp32p4I2cInitializeControllerOwned(port,3,true) != 1) return i32(4)
        val count=writes
        var fault=1
        while (fault <= count) {
            initSeed(port)
            if (esp32p4I2cInitializeControllerOwned(port,3,true) != 1) return i32(5)
            val verified=nativeBufferAt(checked,128).load(fault) != 0
            if (verified) {
                initSeed(port);drop=fault
                if (esp32p4I2cInitializeControllerOwned(port,3,true) != 5 || writes != fault) return i32(6)
                drop=0
                if (esp32p4I2cInitializeControllerOwned(port,3,true) != 1 || bad) return i32(7)
            }
            fault=fault+1
        }
        var used=0
        while (used <= 33) {
            var n=0
            while (n <= 33) {
                seed(port)
                nativeBufferAt(memory,288).storeU32(port*128+8,used<<18)
                val expected=if (n > 32) 2 else if (n == 0) 1 else if (used > 32 || n > 32-used) 4 else (n<<8)|1
                if (esp32p4I2cWriteFifoOwned(port,data,n,true) != expected || starts != 0 || bad) return i32(8)
                if ((expected&255) == 1 && n > 0) {
                    var i=0
                    while (i < n) { if (nativeBufferAt(tx,64).load(port*32+used+i) != data.load(i)) return i32(9);i=i+1 }
                }
                seed(port);nativeBufferAt(memory,288).storeU32(port*128+8,used<<8)
                val expectedRead=if (n > 32) 2 else if (n == 0) 1 else if (used > 32 || n > used) 4 else (n<<8)|1
                if (esp32p4I2cReadFifoOwned(port,data,n,true) != expectedRead || bad || fifoReads != (if ((expectedRead&255) == 1) n else 0)) return i32(10)
                var i=0
                while (i < 40) {
                    val wanted=if ((expectedRead&255) == 1 && i < n) (port*32+i)^0x5a else i^0xa5
                    if (data.load(i) != wanted) return i32(19)
                    i=i+1
                }
                n=n+1
            }
            used=used+1
        }
        seed(port);drop=2
        if (esp32p4I2cWriteFifoOwned(port,data,3,true) != 773) return i32(11)
        seed(port);nativeBufferAt(memory,288).storeU32(port*128+8,3<<8);dropRead=2
        if (esp32p4I2cReadFifoOwned(port,data,3,true) != 773) return i32(12)
        var scenario=0
        while (scenario < 10) {
            seed(port)
            val terminal=if (scenario == 1) 4 else 2
            if (!queue(port,terminal)) return i32(13)
            events=if (scenario == 1) u32(8) else if (scenario == 2) u32(160) else if (scenario == 3) u32(1152)
                else if (scenario == 4) u32(384) else if (scenario == 5) u32(132) else if (scenario == 6) u32(0) else u32(128)
            if (scenario == 7) done=false
            if (scenario == 8) { tick=u32(0xfffffffc);eventDelay=6 }
            if (scenario == 9) nativeBufferAt(memory,288).storeU32(port*128+8,(2<<18)|16)
            val result=esp32p4I2cRunBatchOwned(port,2,u32(12),false,true)
            val wanted=if (scenario == 1) 2 else if (scenario == 2) 4 else if (scenario == 3) 3 else if (scenario == 4 || scenario == 6 || scenario == 7) 5 else if (scenario == 5) 6 else if (scenario == 9) 8 else 1
            if (result != wanted || starts != (if (scenario == 9) 0 else 1) || bad) return i32(14)
            scenario=scenario+1
        }
        seed(port);if (!queue(port,2)) return i32(15)
        if (esp32p4I2cRunBatchOwned(port,2,u32(12),true,true) != 7 || starts != 0) return i32(16)
        nativeBufferAt(memory,288).storeU32(port*128+32,8)
        nativeBufferAt(memory,288).storeU32(port*128+8,(2<<18)|16)
        if (esp32p4I2cRunBatchOwned(port,2,u32(12),true,true) != 1 || starts != 1 || bad) return i32(17)
        port=port+1
    }
    seed(0)
    if (esp32p4I2cWriteFifoOwned(0,data,-1,true) != 2 || esp32p4I2cReadFifoOwned(0,nativeBufferAt(payload,1),2,true) != 2 ||
        esp32p4I2cWriteCommandOwned(0,8,u32(8192),true) != 2 || esp32p4I2cWriteCommandOwned(0,0,u32(0xffffffff),true) != 2 ||
        esp32p4I2cRunBatchOwned(0,8,u32(1),false,true) != 7 || esp32p4I2cInitializeControllerOwned(2,0,true) != 2 || writes != 0 || fifoReads != 0) return i32(18)
    return i32(0)
}
