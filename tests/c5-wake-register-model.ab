var calls=0
var pattern=0
var held=false
var bad=false
var wakeOutput=0
var wakeRoute=0
var wakeMux=0
var wakeLp=0
var wakeWrites=0
var wakeDrop=0
fun seedWakeModel(value: int,hold: bool,drop: int): void {
    calls=0;pattern=value;held=hold;bad=false;wakeOutput=value;wakeRoute=value;wakeMux=value;wakeLp=value
    wakeWrites=0;wakeDrop=drop;return
}
fun c5WakeLoad(address: int): int {
    calls=calls+1
    if (address == 0x600b102c) return if (held) 16 else 0
    if (address == 0x60091034) return wakeOutput
    if (address == 0x60091ae4) return wakeRoute
    if (address == 0x60090010) return wakeMux
    if (address == 0x600b1028) return wakeLp
    bad=true;return 0
}
fun c5WakeStore(address: int,value: int): void {
    calls=calls+1;wakeWrites=wakeWrites+1
    if (held) bad=true
    if (address == 0x6009103c) {
        if (value != 16) bad=true
        if (wakeWrites != wakeDrop) wakeOutput=wakeOutput&~16
    } else if (address == 0x60091ae4) {
        if ((wakeOutput&16) != 0 || value != ((pattern&~4095)|1280)) bad=true
        if (wakeWrites != wakeDrop) wakeRoute=value
    } else if (address == 0x60090010) {
        if ((wakeOutput&16) != 0 || (wakeRoute&4095) != 1280 || value != ((pattern&~29570)|4864)) bad=true
        if (wakeWrites != wakeDrop) wakeMux=value
    } else if (address == 0x600b1028) {
        if ((wakeOutput&16) != 0 || (wakeRoute&4095) != 1280 || (wakeMux&29570) != 4864 || value != (pattern&~16)) bad=true
        if (wakeWrites != wakeDrop) wakeLp=value
    } else bad=true
    return
}
