import "../src/crypto/ghash_small_table.ab"
import "abla/runtime/scalar"
import "abla/build"

trusted fun ghashSmallTableTarget(table: u32, reduction: u32, input: u32, output: u32): void =
    cryptoGhashSmallTable(int(table), int(reduction), int(input), int(output))
