import "../src/esp32/adc_fuse_s3_sequence.ab"
import "../src/esp32/adc2_session_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var trace=0
var fail=0
var finish=315905
var closing=0
var mismatch=false
var bad=false
fun esp32S3AdcFuseRead(offset: int): int { bad=true; return 0 }
type Esp32S3AdcPower = int
fun Esp32S3AdcPower.bits(): int = this
fun Esp32S3AdcPower.status(): int = this&255
fun Esp32S3AdcPower.powered(): bool = this.status() == 1
type Esp32S3AdcBus = int
fun Esp32S3AdcBus.bits(): int = this
fun Esp32S3AdcBus.status(): int = this&255
fun Esp32S3AdcBus.ready(): bool = this.status() == 1
type Esp32S3Adc2Arbiter = int
fun Esp32S3Adc2Arbiter.bits(): int = this
fun Esp32S3Adc2Arbiter.status(): int = this&255
fun Esp32S3Adc2Arbiter.ready(): bool = this.status() == 1
fun esp32S3AdcPowerOpenOwned(exclusive: bool): Esp32S3AdcPower { trace=trace*10+1; return Esp32S3AdcPower(0xb00|(if (fail == 1) 4 else 1)) }
fun esp32S3AdcBusOpenOwned(exclusive: bool): Esp32S3AdcBus { trace=trace*10+2; return Esp32S3AdcBus(0xa00|(if (fail == 2) 3 else 1)) }
fun esp32S3Adc2ArbiterOpenOwned(mode: int,exclusive: bool,hertz: int): Esp32S3Adc2Arbiter { trace=trace*10+3; return Esp32S3Adc2Arbiter(0x85900|(mode<<21)|(if (fail == 3) 4 else 1)) }
fun esp32S3Adc2PadConfigureOwned(channel: int): int { trace=trace*10+4; return if (fail == 4) 5 else 1 }
fun esp32S3Adc2ConfigureOwned(channel: int,attenuation: int): int { trace=trace*10+5; return if (fail == 5) 1029 else 1 }
fun esp32S3AdcAnalogConfigureOwned(calibration: Esp32S3AdcCalibration): int { trace=trace*10+6; return if (fail == 6) 3 else 1 }
fun esp32S3Adc2SessionHardwareMatches(channel: int,attenuation: int,mode: int): bool = !mismatch
fun esp32S3Adc2StartOwned(channel: int): int = if (fail == 7) 261 else 257
fun esp32S3Adc2FinishOwned(channel: int,polls: int): int = finish
fun esp32S3Adc2ReleaseOwned(channel: int,polls: int): int { trace=trace*10+7; return if (closing == 1) 6 else 1 }
fun Esp32S3Adc2Arbiter.closeOwned(): Esp32S3Adc2Arbiter {
    if ((this|0) == 0) return Esp32S3Adc2Arbiter(0)
    if ((this&0x1fff00) != 0x85900) bad=true
    trace=trace*10+8; return Esp32S3Adc2Arbiter(if (closing == 2) (this&(-256))|4 else 0)
}
fun Esp32S3AdcBus.closeOwned(): Esp32S3AdcBus {
    if ((this|0) == 0) return Esp32S3AdcBus(0)
    if ((this&0x1f00) != 0xa00) bad=true
    trace=trace*10+9; return Esp32S3AdcBus(if (closing == 3) 0xa03 else 0)
}
fun Esp32S3AdcPower.closeOwned(): Esp32S3AdcPower {
    if ((this&0x1f00) != 0xb00) bad=true
    trace=trace*10+1; return Esp32S3AdcPower(if (closing == 4) 0xb04 else 0)
}
fun reset(): void { trace=0; fail=0; finish=(1234<<8)|1; closing=0; mismatch=false; return }
@export("abla_adc2_session_s3_test")
fun test(): i32 {
    var channel=0
    while (channel < 10) {
        var attenuation=0
        while (attenuation < 4) {
            var mode=0
            while (mode < 2) {
                reset()
                val cal=Esp32S3AdcCalibration(268435456|(1<<25)|(attenuation<<26)|(3000<<12)|2000)
                var owner=esp32S3Adc2SessionOpenOwned(channel,cal,true,true,true,mode,8000000)
                if (!owner.ready() || trace != 123456 || owner.channel() != channel || owner.attenuation() != attenuation || ((owner.bits()>>37)&1) != mode) return i32(1)
                owner=owner.startAfterSettlingOwned()
                if (!owner.pending() || owner.ready()) return i32(2)
                owner=owner.pollOwned(3)
                if (owner.raw() != 1234 || owner.millivolts(cal) != cal.millivolts(1234)) return i32(3)
                trace=0; owner=owner.closeOwned(3)
                if (owner.status() != 0 || trace != 7891 || bad) return i32(4)
                mode=mode+1
            }
            attenuation=attenuation+1
        }
        channel=channel+1
    }
    val cal=Esp32S3AdcCalibration(268435456|(1<<25)|(3000<<12)|2000)
    var stage=1
    while (stage <= 6) {
        reset(); fail=stage
        var owner=esp32S3Adc2SessionOpenOwned(3,cal,true,true,true,0,8000000)
        if (owner.status() != stage+2 || owner.ready()) return i32(5)
        fail=0; trace=0; owner=owner.closeOwned(3)
        val expected=if (stage == 1) 1 else if (stage == 2) 91 else if (stage < 5) 891 else if (stage == 5) 57891 else 7891
        if (owner.status() != 0 || trace != expected || bad) return i32(6)
        stage=stage+1
    }
    reset()
    var owner=esp32S3Adc2SessionOpenOwned(3,cal,true,true,true,0,8000000)
    owner=owner.startAfterSettlingOwned(); finish=6; owner=owner.pollOwned(3)
    if (owner.status() != 11 || !owner.pending()) return i32(7)
    closing=1; trace=0; owner=owner.closeOwned(3)
    if (owner.status() != 16 || trace != 7) return i32(8)
    closing=2; trace=0; owner=owner.closeOwned(3)
    if (owner.status() != 17 || trace != 78 || owner.ready()) return i32(9)
    closing=3; trace=0; owner=owner.closeOwned(3)
    if (owner.status() != 18 || trace != 89) return i32(10)
    closing=4; trace=0; owner=owner.closeOwned(3)
    if (owner.status() != 19 || trace != 91) return i32(11)
    closing=0; trace=0; owner=owner.closeOwned(3)
    if (owner.status() != 0 || trace != 1 || bad) return i32(12)
    stage=7
    while (stage <= 10) {
        reset(); owner=esp32S3Adc2SessionOpenOwned(3,cal,true,true,true,0,8000000)
        owner=owner.startAfterSettlingOwned(); finish=stage; owner=owner.pollOwned(3)
        if (owner.status() != stage+5 || owner.pending() || owner.raw() != -1 || owner.millivolts(cal) != -1) return i32(13)
        stage=stage+1
    }
    reset()
    if (esp32S3Adc2SessionOpenOwned(10,cal,true,true,true,0,8000000).status() != 2 || esp32S3Adc2SessionOpenOwned(3,cal,true,true,true,0,7999999).status() != 2 || trace != 0 || bad) return i32(14)
    return i32(0)
}
