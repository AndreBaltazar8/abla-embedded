import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/shutdown_request.ab"
import "abla/runtime/scalar"
import "abla/build"
// Cross-board codegen only; does not execute on the connected Atom.
@export("abla_shutdown_request_target")
trusted fun shutdownTarget(board: M5BoardId,record: NativeBuffer,pmic: M5PmicOpen,ioe: I2cDevice,hub: PowerHubPower,now: u32,begin: bool,quiesced: bool): int =
    if (begin) board.beginShutdownRequest(record,pmic,ioe,hub,now,quiesced) else m5ShutdownRequestPoll(record,now)
