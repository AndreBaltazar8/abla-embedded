import "./oled-wire-native.ab"
import "../src/display/unit_glass.ab"
var glassWaited=0
fun glassDelayMicroseconds(us: int): void {
    if (mode != 0 || !masterHigh || !slaveHigh || !clockHigh || (us != 96 && us != 512 && us != 1000 && us != 5000)) bad=true
    glassWaited=glassWaited+us;return
}
fun glassExpectStart(): void { transactionIndex=0;expectByte(122);return }
@export("abla_unit_glass_wire_test")
trusted fun testGlassWire(): i32 {
    wireSeed();extraAddress=61;extraCanRead=true;extraReadValue=90
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val device=control.session().bus().device(61,100000)
    val frame=nativeBufferAt(oledMemory,1024);val scratch=nativeBufferAt(oledMemory+1024,176)
    if (!device.valid()) return i32(2)
    var key=-1
    while (key <= 1) {
        var fail=0
        while (fail <= 3) {
            val before=ackCount;val stopBefore=stops;val startBefore=starts
            extraCount=0;glassWaited=0;nackAt=if (fail == 0) 0 else before+fail
            val result=device.glassReadByte(key,scratch)
            val transactions=if (fail == 1 || fail == 2) 1 else 2
            if (result.valid() != (fail == 0) || (result.valid() && result.value() != 90) ||
                ackCount-before != (if (fail == 0) 3 else fail) || stops-stopBefore != transactions || starts-startBefore != transactions ||
                glassWaited != 1000+(if (key < 0) 0 else 512) || bad) return i32(3)
            if (fail == 0) {
                val bytes=nativeBufferAt(extraWire,8192)
                if (extraCount != 3 || bytes.load(1) != 122 || bytes.load(3) != (if (key < 0) 254 else 208+key) || bytes.load(5) != 123) return i32(4)
            }
            fail=fail+1
        }
        key=key+1
    }
    var at=0;while (at < 1024) { frame.store(at,at&255);at=at+1 }
    expectedCount=0;var page=0
    while (page < 2) {
        expectedPages=page;expectedStage=3
        var column=0
        while (column < 3) {
            glassExpectStart();expectByte(144);expectByte(column);expectByte(0);expectByte((page*128+7+column)&255)
            column=column+1
        }
        expectedStage=4
        glassExpectStart();expectByte(176);expectByte(7);expectByte(page*8);expectByte(3);expectByte(8);expectByte(1)
        page=page+1
    }
    expectedPages=2;expectedStage=5;glassExpectStart();expectByte(16);expectByte(1)
    var failure=0
    while (failure <= expectedCount) {
        var commit=0
        while (commit < 2) {
            val before=ackCount;extraCount=0;glassWaited=0;nackAfterCommit=commit == 1
            nackAt=if (failure == 0) 0 else before+failure
            val result=device.glassDisplayRegion(frame,scratch,7,7,3,3)
            val e=nativeBufferAt(oledExpected,16384)
            val stage=if (failure == 0) 1 else e.load((failure-1)*4+2)
            val pages=if (failure == 0) 2 else e.load((failure-1)*4+3)
            val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && e.load((failure-1)*4) > 1) 1 else 0)
            val waited=if (stage == 1 || stage == 5) 5192 else pages*96+(if (stage == 4) 96 else 1000)
            if (result != (stage|(pages<<8)) || ackCount-before != (if (failure == 0) expectedCount else failure) ||
                extraCount != accepted || glassWaited != waited || bad || mode != 0) return i32(5)
            at=0;while (at < accepted) {
                if (nativeBufferAt(extraWire,8192).load(at*2) != e.load(at*4) || nativeBufferAt(extraWire,8192).load(at*2+1) != e.load(at*4+1)) return i32(6)
                at=at+1
            }
            commit=commit+1
        }
        failure=failure+1
    }
    nackAt=0;nackAfterCommit=false
    if (!device.glassBuzzerEnable(false,scratch) || !device.glassSetSleep(true,scratch) || !device.close() || !control.closeOwned(true) || bad || pads != 0) return i32(7)
    return i32(0)
}
