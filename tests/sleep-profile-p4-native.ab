import "../src/esp32/power/sleep_profile_p4_sequence.ab"
import "../src/esp32/power/sleep_profile_defaults_p4.ab"
import "abla/unsafe/native"
var regs=NativeBuffer(0)
var writes=0
var fail=0
var bad=false
fun allowed(offset: int): bool = offset == 24 || offset == 104 || offset == 120 || offset == 124 || offset == 128 ||
    offset == 144 || offset == 148 || offset == 152 || offset == 156 || offset == 160 || offset == 168 || offset == 172 ||
    offset == 180 || offset == 184 || offset == 188 || offset == 192 || offset == 196 || offset == 200 ||
    offset == 236 || offset == 240 || offset == 284 || offset == 300 || offset == 308 || offset == 316
trusted fun read(offset: int): u32 {
    if (!allowed(offset)) { bad=true;return u32(0) };return u32(regs.loadU32(offset))
}
trusted fun write(offset: int,value: u32): void {
    if (!allowed(offset)) { bad=true;return }
    writes=writes+1;if (writes != fail) regs.storeU32(offset,int(value));return
}
trusted fun p4SleepPowerRead(offset: int): u32 = read(offset)
trusted fun p4SleepPowerWrite(offset: int,value: u32): void { write(offset,value);return }
trusted fun p4SleepAnalogRead(offset: int): u32 = read(offset)
trusted fun p4SleepAnalogWrite(offset: int,value: u32): void { write(offset,value);return }
trusted fun p4SleepTimingRead(offset: int): u32 = read(offset)
trusted fun p4SleepTimingWrite(offset: int,value: u32): void { write(offset,value);return }
trusted fun p4SleepDigitalRead(address: int): u32 = read(address-0x50115000)
trusted fun p4SleepDigitalWrite(address: int,value: u32): void { write(address-0x50115000,value);return }
trusted fun seed(r: NativeBuffer,c: NativeBuffer): void {
    var i=0
    while (i < 320) { regs.storeU32(i,0xffffffff);i=i+4 }
    i=0
    while (i < 180) { r.storeU32(i,0);i=i+4 }
    i=0
    while (i < 108) { c.storeU32(i,0);i=i+4 }
    r.storeU32(180,0x12345678);writes=0;fail=0;bad=false;return
}
@export("abla_sleep_profile_p4_test")
trusted fun test(): i32 {
    regs=nativeBufferAt(nativeStaticAllocate(320),320)
    val c=nativeBufferAt(nativeStaticAllocate(108),108)
    val r=nativeBufferAt(nativeStaticAllocate(184),184)
    var revision=0
    while (revision <= 300) {
        val count=if (revision < 100) 40 else 41
        var deep=0
        while (deep < 2) {
            var phase=0
            while (phase < 2) {
                var fault=0
                while (fault <= count) {
                    seed(r,c);if (phase == 0) fail=fault
                    val opened=esp32p4SleepProfileOpenOwned(r,c,revision,deep == 1,true)
                    if ((phase == 1 || fault == 0) && (opened != 1 || writes != count)) return i32(1)
                    if (phase == 0 && fault != 0 && (opened == 1 || writes != fault || r.loadU32(8) == 0)) return i32(2)
                    val primary=r.loadU32(8);writes=0;fail=if (phase == 1) fault else 0
                    val closed=esp32p4SleepProfileCloseOwned(r,true)
                    if (phase == 1 && fault != 0 && (closed != 9 || writes != fault)) return i32(3)
                    fail=0
                    if (esp32p4SleepProfileCloseOwned(r,true) != 8 || r.loadU32(8) != primary ||
                        r.loadU32(12) != 0 || r.loadU32(180) != 0x12345678 || bad) return i32(4)
                    var i=0
                    while (i < 320) { if (regs.loadU32(i) != 0xffffffff) return i32(5);i=i+4 }
                    val before=writes
                    if (esp32p4SleepProfileCloseOwned(r,true) != 8 || writes != before) return i32(6)
                    fault=fault+1
                }
                phase=phase+1
            }
            deep=deep+1
        }
        revision=if (revision == 0) 100 else if (revision == 100) 300 else 400
    }
    // Even invalid FINAL-stage input must cause zero writes to earlier stages.
    seed(r,c);c.storeU32(100,65536)
    if (esp32p4SleepProfileOpenOwned(r,c,300,false,true) != 2 || writes != 0) return i32(7)
    seed(r,c);c.storeU32(104,64)
    if (esp32p4SleepProfileOpenOwned(r,c,300,false,true) != 2 || writes != 0) return i32(8)
    seed(r,c);c.storeU32(40,0x80000)
    if (esp32p4SleepProfileOpenOwned(r,c,300,false,true) != 2 || writes != 0) return i32(9)
    seed(r,c)
    if (esp32p4SleepProfileOpenOwned(r,nativeBufferAt(r.addressValue()+4,108),300,false,true) != 2 || writes != 0) return i32(10)
    seed(r,c)
    if (!esp32p4SleepProfileDefaults(c,u32(1025),300,false,true,19,21,27,16000000,65536) ||
        !p4SleepProfileConfigValid(c,300) || esp32p4SleepProfileOpenOwned(r,c,300,false,true) != 1 || bad) return i32(11)
    if (esp32p4SleepProfileCloseOwned(r,true) != 8 || bad) return i32(12)
    var i=0
    while (i < 320) { if (regs.loadU32(i) != 0xffffffff) return i32(13);i=i+4 }
    return i32(0)
}
