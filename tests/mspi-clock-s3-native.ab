import "../src/esp32/mspi_clock_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var flash=0
var ram=0
var both=false
var step=0
var bad=false
fun referenceBits(freq: int): int {
    val divider=core/freq
    if (divider == 1) 0x80000000 else ((divider-1)<<16) | ((divider/2-1)<<8) | (divider-1)
}
fun esp32S3MspiClockUpdate(address: int,mask: int,value: int): void {
    val select=if (core == 80) 0 else if (core == 120) 1 else if (core == 160) 2 else 3
    if (step != 0 || address != 0x600030EC || mask != 3 || value != select) bad=true
    step=step+1
    return
}
fun esp32S3MspiClockWrite(address: int,value: int): void {
    if (step == 1) { if (address != 0x60003014 || value != referenceBits(flash)) bad=true }
    else if (step == 2 && both) { if (address != 0x60002014 || value != referenceBits(flash)) bad=true }
    else if (step == (if (both) 3 else 2) && ram != 0) { if (address != 0x60003050 || value != referenceBits(ram)) bad=true }
    else bad=true
    step=step+1
    return
}
@export("abla_mspi_clock_test")
trusted fun mspiClockTest(): i32 {
    var divider=1
    while (divider <= 256) {
        val bits=esp32S3MspiDividerBits(divider)
        if (divider == 1) { if (bits != 0x80000000) return i32(1) }
        else if (((bits>>>16) & 255) != divider-1 || ((bits>>>8) & 255) != divider/2-1 || (bits & 255) != divider-1 || (bits & ~0xFFFFFF) != 0) return i32(2)
        divider=divider+1
    }
    var option=0
    while (option < 5) {
        core=if (option == 0) 80 else if (option == 1) 120 else if (option == 2) 160 else if (option == 3) 240 else 0
        flash=0
        while (flash <= 241) {
            var variant=0
            while (variant < 6) {
                ram=if (variant < 2) 0 else if (variant < 4) 20 else 17
                both=(variant & 1) != 0
                step=0; bad=false
                val valid=core != 0 && flash > 0 && flash <= core && core%flash == 0 && (ram == 0 || core%ram == 0)
                val result=esp32S3MspiClocksOwned(core,flash,ram,both)
                if (result != valid || bad || step != (if (valid) 2+(if (both) 1 else 0)+(if (ram != 0) 1 else 0) else 0)) return i32(3)
                variant=variant+1
            }
            flash=flash+1
        }
        option=option+1
    }
    if (esp32S3MspiDividerBits(0) != -1 || esp32S3MspiDividerBits(257) != -1) return i32(4)
    i32(0)
}
