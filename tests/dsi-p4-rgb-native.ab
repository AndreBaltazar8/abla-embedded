import "../src/display/dsi_rgb_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(256)
var bridge=u32(0)
var writes=0
var reads=0
var drop=-1
var mode=0
var bad=false
trusted fun p4DsiRead(offset: int): u32 {
    reads=reads+1
    if (offset == 52) return u32(if (mode == 1) 0 else 1)
    if (offset == 44) return u32(if (mode == 6) 0 else 4)
    if (offset == 116) return u32(if (mode == 2) 85 else if (mode == 3) 5 else 21)
    if (offset == 188) return u32(if (mode == 4) 1 else 0)
    if (offset == 192) return u32(0)
    return u32(nativeBufferAt(storage,256).loadU32(offset))
}
trusted fun p4DsiWrite(offset: int,value: u32): void {
    if (offset != (if (writes < 3) 12+writes*4 else 56+(writes-3)*4) || writes > 6) bad=true
    if (writes != drop) nativeBufferAt(storage,256).storeU32(offset,int(value))
    writes=writes+1
    return
}
fun p4DsiBridgeRead(offset: int): u32 { reads=reads+1; if (offset == 4) return u32(if (mode == 5) 1 else 0); if (offset != 24) bad=true; return bridge }
fun p4DsiBridgeWrite(offset: int,value: u32): void { if (offset != 24 || writes != 7) bad=true; if (writes != drop) bridge=value; writes=writes+1; return }
trusted fun fill(value: int): void {
    var i=0
    while (i < 256) { nativeBufferAt(storage,256).store(i,value); i=i+1 }
    bridge=if (value == 0) u32(0) else u32(4294967295)
    reads=0; writes=0
    return
}
@export("abla_dsi_p4_rgb_test")
trusted fun testRgb(): i32 {
    var profile=0
    while (profile < 256) {
        val version=if ((profile&1) == 0) 1 else 3
        val input=if ((profile&2) == 0) 16 else 24
        val output=if ((profile&4) == 0) 16 else 24
        val lp=(profile&8) != 0
        val ack=(profile&16) != 0
        val pattern=if ((profile&32) == 0) u32(0) else u32(4294967295)
        val channel=profile>>>6
        fill(if (pattern == u32(0)) 0 else 255)
        val result=esp32P4DsiConfigureRgbOwned(version,720,input,output,channel,lp,ack,3)
        if (version == 1 && input != output) {
            if (result.status() != 2 || reads != 0 || writes != 0) return i32(1)
        } else {
            val mask=u32(if (version == 1) 127 else 2047)
            if (!result.hostComplete() || writes != 8 || bad ||
                bridge != ((pattern&(u32(4294967295)^mask))|u32((if (input == 16) 2 else 0)|(if (version == 3 && output == 16) 256 else 0)))) return i32(2)
            if (p4DsiRead(12) != ((pattern&u32(4294967292))|u32(channel)) ||
                p4DsiRead(16) != ((pattern&u32(4294967024))|u32(if (output == 16) 0 else 5)) ||
                p4DsiRead(20) != (pattern&u32(4294967264)) ||
                p4DsiRead(56) != ((pattern&u32(4294836476))|u32(2|(if (lp) 48896 else 0)|(if (ack) 16384 else 0))) ||
                p4DsiRead(60) != ((pattern&u32(4294950912))|u32(720)) ||
                p4DsiRead(64) != (pattern&u32(4294959104)) || p4DsiRead(68) != (pattern&u32(4294959104))) return i32(3)
        }
        profile=profile+1
    }
    drop=0
    while (drop < 8) {
        fill(255)
        if (esp32P4DsiConfigureRgbOwned(3,720,16,16,0,true,true,3).status() != 6 || writes != drop+1 || bad) return i32(4)
        drop=drop+1
    }
    drop= -1; mode=1
    while (mode <= 6) {
        fill(0)
        val result=esp32P4DsiConfigureRgbOwned(3,720,16,16,0,true,true,3)
        if (result.status() != (if (mode == 1 || mode >= 5) 10 else if (mode == 2) 3 else if (mode == 3) 9 else 4) || writes != 0) return i32(5)
        mode=mode+1
    }
    reads=0
    if (esp32P4DsiConfigureRgbOwned(3,4096,16,16,0,true,true,3).status() != 2 || reads != 0 || bad) return i32(6)
    i32(0)
}
