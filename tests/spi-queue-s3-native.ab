import "../src/esp32/sdk/raw_buffer.ab"
import "../src/spi/pins.ab"
import "../src/esp32/spi/queue_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
val memory=nativeStaticAllocate(512)
var begins=0
var polls=0
var admission=2
var completion=2
var selected=0
fun esp32s3SpiMemoryRangeValid(peripheral: int,data: NativeBuffer,bytes: int): bool = peripheral == 2 && data.hasAddressRange(0,bytes)
fun esp32s3SpiBufferRangeValid(peripheral: int,data: NativeBuffer,bytes: int): bool = bytes >= 0 && bytes <= 64 && esp32s3SpiMemoryRangeValid(peripheral,data,bytes)
fun esp32s3SpiMasterPinsValid(peripheral: int,pins: SpiPins,select: Pin): bool = peripheral == 2 && (select == 4 || select == 5)
trusted fun esp32s3SpiAsyncTransactionBegin(context: NativeBuffer,gate: PeripheralGate,owner: u32,peripheral: int,pins: SpiPins,select: Pin,command: int,commandBits: int,address: int,addressBits: int,dummy: int,direction: int,data: NativeBuffer,bytes: int,now: u32,budget: u32,released: bool,setupTicks: int = 0,holdTicks: int = 0): int { begins=begins+1; selected=select|0; return admission }
trusted fun esp32s3SpiAsyncTransactionPoll(context: NativeBuffer,now: u32): int { polls=polls+1; return completion }
trusted fun submit(queue: NativeBuffer,token: int,pin: int,offset: int): int = esp32s3SpiQueueSubmit(queue,u32(token),Pin(pin),0x9f,8,0,0,0,2,nativeBufferAt(memory+offset,4),4,u32(100))
@export("abla_spi_queue_s3_test")
trusted fun test(): i32 {
    val queue=nativeBufferAt(memory,256)
    if (!esp32s3SpiQueueInitialize(queue,2,peripheralGateAt(memory+400),u32(41),2,spiPins(37,35,36),true) || esp32s3SpiQueueService(queue,u32(0)) != 4 || esp32s3SpiQueueTake(queue) != 0) return i32(1)
    if (submit(queue,1,4,300) != 1 || submit(queue,1,5,304) != 3 || submit(queue,2,5,302) != 3 || submit(queue,2,5,304) != 1 || submit(queue,3,4,308) != 2 || begins != 0) return i32(2)
    admission=4
    if (esp32s3SpiQueueService(queue,u32(0)) != 5 || queue.loadU32(64) != 2 || queue.loadU32(96) != 0) return i32(3)
    admission=2
    if (esp32s3SpiQueueService(queue,u32(1)) != 2 || selected != 4 || esp32s3SpiQueueTake(queue) != 0) return i32(4)
    if (esp32s3SpiQueueService(queue,u32(2)) != 2 || polls != 1) return i32(5)
    completion=1
    if (esp32s3SpiQueueService(queue,u32(3)) != 1 || esp32s3SpiQueueService(queue,u32(4)) != 1 || polls != 2 || begins != 2) return i32(6)
    if (esp32s3SpiQueueTake(queue) != ((1<<32)|1) || submit(queue,3,4,308) != 1) return i32(7)
    if (esp32s3SpiQueueService(queue,u32(5)) != 2 || selected != 5 || esp32s3SpiQueueService(queue,u32(6)) != 1 || esp32s3SpiQueueTake(queue) != ((2<<32)|1)) return i32(8)
    if (esp32s3SpiQueueService(queue,u32(7)) != 2 || selected != 4) return i32(9)
    completion=7
    if (esp32s3SpiQueueService(queue,u32(8)) != 1 || submit(queue,4,5,312) != 4 || esp32s3SpiQueueTake(queue) != ((3<<32)|7) || esp32s3SpiQueueService(queue,u32(9)) != 6) return i32(10)
    if (esp32s3SpiQueueInitialize(queue,2,peripheralGateAt(memory+4),u32(41),2,spiPins(37,35,36),true)) return i32(11)
    // Reinitialize only after caller-proven recovery/release (modeled here).
    esp32s3SpiQueueInitialize(queue,2,peripheralGateAt(memory+400),u32(41),2,spiPins(37,35,36),true)
    if (submit(queue,1,4,200) != 3 || submit(queue,1,4,400) != 3 || submit(queue,0,4,300) != 3) return i32(12)
    submit(queue,1,4,300); submit(queue,2,5,304); admission=5
    val before=begins
    if (esp32s3SpiQueueService(queue,u32(0)) != 1 || esp32s3SpiQueueTake(queue) != ((1<<32)|5) || esp32s3SpiQueueService(queue,u32(1)) != 6 || queue.loadU32(64) != 1 || begins != before+1) return i32(13)
    val beforePolls=polls
    if (esp32s3SpiQueueCancelTail(queue,u32(9)) != 4 || esp32s3SpiQueueCancelTail(queue,u32(2)) != 1 || queue.loadU32(100) != 5 || esp32s3SpiQueueService(queue,u32(2)) != 6 || begins != before+1 || polls != beforePolls) return i32(14)
    if (esp32s3SpiQueueCancelTail(queue,u32(2)) != 2) return i32(15)
    esp32s3SpiQueueInitialize(queue,2,peripheralGateAt(memory+400),u32(41),2,spiPins(37,35,36),true)
    admission=2; completion=2
    submit(queue,1,4,300); submit(queue,2,5,304)
    esp32s3SpiQueueService(queue,u32(0))
    if (esp32s3SpiQueueCancelTail(queue,u32(1)) != 4 || esp32s3SpiQueueCancelTail(queue,u32(2)) != 1 || esp32s3SpiQueueCancelTail(queue,u32(1)) != 5 || queue.loadU32(96) != 1) return i32(16)
    if (submit(queue,2,5,304) != 1 || esp32s3SpiQueueCancelTail(queue,u32(2)) != 1) return i32(17)
    completion=1; esp32s3SpiQueueService(queue,u32(1))
    if (esp32s3SpiQueueCancelTail(queue,u32(1)) != 5 || esp32s3SpiQueueTake(queue) != ((1<<32)|1)) return i32(18)
    return i32(0)
}
