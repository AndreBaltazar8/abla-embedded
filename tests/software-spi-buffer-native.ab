import "../src/spi/software_transaction.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")

// Native non-PIE host fixture: static storage resides below4GiB so the real
// embedded NativeBuffer representation can be dereferenced without truncation.
// Mock only GPIO/timing; buffer transfer, selection and atomic gate are real.
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this == 1 || this == 2 || this == 4
val storage = nativeStaticMutableU32s([0, 0, 0])
var bits = 0
var selected = false
var clockHigh = false
var dataHigh = false
var bad = false
var currentMode = 0
var secondOutput = 60
trusted fun checkGate(): void {
    if (nativeAddressLoadU32(storage, 0) != 7) bad = true
    return
}
trusted fun Pin.write(high: bool): void {
    checkGate()
    if (this == 1) clockHigh = high
    if (this == 2) dataHigh = high
    if (this == 4) {
        if (!high && (selected || clockHigh != ((currentMode & 2) != 0) || bits != 0)) bad = true
        if (high && (!selected || bits != 16)) bad = true
        selected = !high
    }
    return
}
trusted fun Pin.read(): bool {
    checkGate()
    val outgoing = if (bits < 8) 165 else secondOutput
    val incoming = if (bits < 8) 90 else 195
    val mask = 1 << (7 - (bits & 7))
    val idle = (currentMode & 2) != 0
    val expectedClock = if ((currentMode & 1) != 0) idle else !idle
    if (this != 3 || !selected || clockHigh != expectedClock || bits >= 16 || dataHigh != ((outgoing & mask) != 0)) bad = true
    bits = bits + 1
    (incoming & mask) != 0
}
fun peripheralDelayMicroseconds(duration: int): void {
    bad = true // zero-delay transfer should never call this
    return
}
trusted fun bufferNativeCase(mode: int, inPlace: bool, fillSecond: bool): bool {
    bits = 0
    selected = false
    bad = false
    currentMode = mode
    secondOutput = if (fillSecond) 255 else 60
    nativeAddressClear(storage, 12)
    nativeAddressStoreU8(storage, 4, 165)
    nativeAddressStoreU8(storage, 5, 60)
    val buffer = nativeBufferAt(storage + 4, 2)
    val input = if (inPlace) buffer else nativeBufferAt(storage + 8, 2)
    val result = softwareSpiTransaction(peripheralGateAt(storage), u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        buffer, if (fillSecond) 1 else 2, input, 2, mode, 0)
    if (!result.valid() || bad || selected || bits != 16 || nativeAddressLoadU32(storage, 0) != 0) return false
    input.load(0) == 90 && input.load(1) == 195 &&
        (inPlace || (buffer.load(0) == 165 && buffer.load(1) == 60))
}
@export("abla_spi_buffer_native_test")
trusted fun bufferNativeTest(): i32 {
    if (storage <= 0 || storage > 4294967284) return i32(10)
    var mode = 0
    while (mode < 4) {
        if (!bufferNativeCase(mode, true, false) || !bufferNativeCase(mode, false, false) ||
            !bufferNativeCase(mode, true, true) || !bufferNativeCase(mode, false, true)) return i32(1)
        mode = mode + 1
    }
    i32(0)
}
