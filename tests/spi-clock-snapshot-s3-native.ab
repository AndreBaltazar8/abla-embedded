import "../src/esp32/spi/clock_snapshot_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(256)
val saved=nativeStaticAllocate(16)
var base=0x60024000
var writes=0
var dropped=0
var timeout=false
var bad=false
trusted fun esp32s3SpiRead(address: int): int = nativeBufferAt(memory,256).loadU32(address-base)
trusted fun esp32s3SpiWrite(address: int,value: int): void {
    writes=writes+1
    val at=address-base
    if (at != 0 && at != 0x0c && at != 0xe8) bad=true
    if (at == 0 && value != 0x00800000) bad=true
    if (writes != dropped) nativeBufferAt(memory,256).storeU32(at,if (at == 0 && !timeout) 0 else value)
    return
}
trusted fun seed(): void {
    val r=nativeBufferAt(memory,256)
    var i=0;while (i < 256) { r.store(i,0);i=i+1 }
    r.storeU32(0x0c,0x31412345);r.storeU32(0xe8,0xa5000003)
    writes=0;dropped=0;timeout=false;bad=false;return
}
@export("abla_spi_clock_snapshot_s3_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(memory,256);val snapshot=nativeBufferAt(saved,16)
    var port=2
    while (port <= 3) {
        base=0x60024000+(port-2)*4096
        seed()
        if (!esp32s3SpiClockSnapshotOwned(snapshot,port,true) || writes != 0 ||
            snapshot.loadU32(4) != port || snapshot.loadU32(8) != 0x31412345 || snapshot.loadU32(12) != 0xa5000003) return i32(1)
        r.storeU32(0x0c,0x12400909);r.storeU32(0xe8,0x5a000007)
        if (esp32s3SpiClockRestoreOwned(snapshot,3,true) != 1 || writes != 4 || bad ||
            r.loadU32(0x0c) != 0x31412345 || r.loadU32(0xe8) != 0xa5000003) return i32(2)
        var fail=1
        while (fail <= 3) {
            seed();r.storeU32(0x0c,0x12400909);r.storeU32(0xe8,0x5a000007);dropped=fail
            if (esp32s3SpiClockRestoreOwned(snapshot,3,true) != 5 || writes != fail || bad) return i32(3)
            dropped=0;writes=0
            if (esp32s3SpiClockRestoreOwned(snapshot,3,true) != 1 || writes != 4 || bad ||
                r.loadU32(0x0c) != 0x31412345 || r.loadU32(0xe8) != 0xa5000003) return i32(4)
            fail=fail+1
        }
        seed();timeout=true
        if (esp32s3SpiClockRestoreOwned(snapshot,3,true) != 6 || writes != 4) return i32(5)
        if (esp32s3SpiClockRestoreOwned(snapshot,3,true) != 3 || writes != 4) return i32(6)
        timeout=false;r.storeU32(0,0)
        if (esp32s3SpiClockRestoreOwned(snapshot,3,true) != 1 || bad) return i32(7)
        var blocked=0
        while (blocked < 5) {
            seed()
            if (blocked == 0) r.storeU32(0,0x00800000)
            if (blocked == 1) r.storeU32(0,0x01000000)
            if (blocked == 2) r.storeU32(0x30,0x18000000)
            if (blocked == 3) r.storeU32(0xe0,0x04000000)
            if (blocked == 4) r.storeU32(0xe8,0)
            snapshot.storeU32(0,0x11223344)
            if (esp32s3SpiClockSnapshotOwned(snapshot,port,true) || snapshot.loadU32(0) != 0x11223344 || writes != 0) return i32(8)
            blocked=blocked+1
        }
        seed()
        if (esp32s3SpiClockSnapshotOwned(snapshot,port,false) || esp32s3SpiClockSnapshotOwned(snapshot,1,true) ||
            esp32s3SpiClockRestoreOwned(snapshot,0,true) != 2 || writes != 0) return i32(9)
        port=port+1
    }
    return i32(0)
}
