import "../src/esp32/gpio/matrix_routes_esp32s3.ab"
import "../src/esp32/soc/gpio_capabilities.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = espChipS3().gpioValid(this)
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this)
var trace = 0
var number = 0
var signal = 0
var inverted = false
var output = false
var bad = false
var bidirectional = false
var parkFails=false
trusted fun esp32S3GpioParkOutputOwned(pin: int): bool { if (pin != number || trace != 0) bad=true;trace=9;return !parkFails }
trusted fun Pin.selectGpioFunction(input: bool): void { if (input != (bidirectional || !output)) bad = true; trace = trace * 10 + 1; return }
trusted fun Pin.setOpenDrain(value: bool): void { if (value) bad = true; trace = trace * 10 + 2; return }
trusted fun Pin.input(): void { trace = trace * 10 + 5; return }
trusted fun esp32S3GpioUpdate(address: int, mask: int, value: int): void {
    if (bidirectional) {
        if (trace == 912) {
            if (address != 0x60004154+signal*4 || mask != 255 || value != (128|number)) bad=true
        } else if (trace != 9123 || address != 0x60004554+number*4 || mask != 4095 || value != signal) bad=true
    } else if (output) {
        if (address != 0x60004554 + number * 4 || mask != 4095 || value != (signal | (if (inverted) 512 else 0))) bad = true
    } else {
        if (address != 0x60004154 + signal * 4 || mask != 255 || value != (128 | number | (if (inverted) 64 else 0))) bad = true
    }
    trace = trace * 10 + 3
    return
}
trusted fun gpio_set_direction(pin: i32, mode: i32): i32 {
    if (int(pin) != number || mode != (if (bidirectional) i32(3) else if (output) i32(2) else i32(1)) || trace != (if (bidirectional) 91233 else if (output) 9123 else 91)) bad = true
    trace = trace * 10 + 4
    i32(0)
}
trusted fun gpioMatrixTest(): int {
    number = -1
    while (number <= 49) {
        var direction = 0
        while (direction < 2) {
            output = direction == 1
            signal = -1
            while (signal <= (if (output) 512 else 256)) {
                var invert = 0
                while (invert < 2) {
                    inverted = invert != 0
                    trace = 0
                    val p = Pin(number)
                    val valid = signal >= 0 && signal <= (if (output) 511 else 255) && (if (output) p.outputCapable() else p.valid())
                    val result = if (output) p.routeOutputSignal(signal, inverted) else p.routeInputSignal(signal, inverted)
                    if (result != valid || bad || trace != (if (!valid) 0 else if (output) 91234 else 9143)) return 1
                    invert = invert + 1
                }
                signal = signal + 1
            }
            direction = direction + 1
        }
        number = number + 1
    }
    bidirectional=true; number=4; signal=178; trace=0
    if (!Pin(number).routeBidirectionalSignal(signal,signal) || trace != 912334 || bad) return 2
    trace=0
    if (Pin(number).routeBidirectionalSignal(256,1) || Pin(number).routeBidirectionalSignal(1,512) || trace != 0) return 3
    parkFails=true;trace=0
    if (Pin(number).routeBidirectionalSignal(signal,signal) || trace != 9) return 4
    bidirectional=false;trace=0
    if (Pin(number).routeOutputSignal(signal) || trace != 9) return 5
    trace=0
    if (Pin(number).routeInputSignal(signal) || trace != 9) return 6
    0
}
#exportFunction("gpioMatrixTest", "abla_gpio_matrix_test")
