import "../src/esp32/uart/pins_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var unit=0
var tx=0
var rx=0
var stage=0
var fail=0
var bad=false
fun p4UartPinConfigure(pin: int,input: bool): int {
    stage=stage+1
    if (pin != (if (stage == 1) tx else rx) || input != (stage == 2)) bad=true
    return if (fail == stage) 3 else 1
}
fun p4UartPinField(offset: int,mask: int,value: int): bool {
    stage=stage+1
    val signal=10+unit*3
    if (stage == 3) { if (offset != 1368+tx*4 || mask != 4095 || value != (signal|1024)) bad=true }
    else if (stage == 4) { if (offset != 344+signal*4 || mask != 255 || value != (rx|128)) bad=true }
    else bad=true
    return fail != stage
}
fun p4UartPinWrite(offset: int,value: u32): void {
    stage=stage+1
    if (stage != 5 || offset != (if (tx < 32) 36 else 48) || value != (u32(1)<<u32(tx&31))) bad=true
    return
}
fun p4UartPinRead(offset: int): u32 {
    if (stage != 5 || offset != (if (tx < 32) 32 else 44)) bad=true
    return if (fail == 5) u32(0) else u32(1)<<u32(tx&31)
}
@export("abla_p4_uart_pins_test")
fun testPins(): i32 {
    while (unit < 5) {
        tx=0
        while (tx < 55) {
            rx=(tx+1)%55; stage=0
            if (p4UartPinsConfigureOwned(unit,tx,rx) != 1 || stage != 5 || bad) return i32(1)
            tx=tx+1
        }
        unit=unit+1
    }
    unit=0; tx=54; rx=0; fail=1
    while (fail <= 5) {
        stage=0
        if (p4UartPinsConfigureOwned(unit,tx,rx) != (if (fail < 3) fail+2 else if (fail < 5) 5 else 6) || stage != fail || bad) return i32(2)
        fail=fail+1
    }
    stage=0
    if (p4UartPinsConfigureOwned(5,0,1) != 2 || p4UartPinsConfigureOwned(0,55,0) != 2 || p4UartPinsConfigureOwned(0,1,1) != 2 || stage != 0) return i32(3)
    return i32(0)
}
