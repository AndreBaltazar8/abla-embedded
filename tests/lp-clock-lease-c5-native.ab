import "../src/esp32/gpio/lp_clock_lease_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var parent=0
var child=0
var writes=0
var failAt=0
var bad=false
fun c5LpGpioClockLoad(address: int): int {
    if (address == 0x600960f0) return 1
    if (address == 0x600b2804) return 0
    if (address == 0x600b2800) return parent
    if (address == 0x600b47f8) { if ((parent&0x08000000) == 0) bad=true;return child }
    bad=true;return 0
}
fun c5LpGpioClockStore(address: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (address == 0x600b2800) parent=value
    else if (address == 0x600b47f8) { if ((parent&0x08000000) == 0) bad=true;child=value }
    else bad=true
    return
}
@export("abla_lp_clock_lease_c5_test")
trusted fun test(): i32 {
    var mode=0
    while (mode < 4) {
        var fault=0
        while (fault < 5) {
            val oldParent=0x80000007|((mode&1)<<27)
            val oldChild=0x80000006|((mode>>>1)&1)
            parent=oldParent;child=oldChild;writes=0;failAt=fault;bad=false
            var lease=esp32C5LpClockOpenOwned(true)
            if (!lease.hasSnapshot() || (lease.status() != 1 && lease.status() != 3)) return i32(1)
            lease=lease.closeOwned(true)
            failAt=0;lease=lease.closeOwned(true)
            if (lease.status() != 4 || parent != oldParent || child != oldChild || bad) return i32(2)
            fault=fault+1
        }
        mode=mode+1
    }
    writes=0
    if (esp32C5LpClockOpenOwned(false).status() != 2 || writes != 0) return i32(3)
    return i32(0)
}
