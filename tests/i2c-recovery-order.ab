// Source-order regression only; not an electrical/timing simulation.

import "../tools/lib/source_text.ab"
import "abla/text"

fun main: int {
    val clear = sourceRead("src/esp32/i2c/bus_clear_esp32s3.ab")
    var owned = sourceAfter(clear, "trusted fun esp32S3I2cClearStuckBusOwned(")
    owned = sourceBefore(owned, "trusted fun esp32S3I2cRecoverAndClearGuarded(")
    val captured = sourceAfter(owned, "val savedData =")
    sourceLacks(captured, "return ", "cleanup cannot be skipped by an early return")
    sourceOrder(captured, "esp32S3I2cClearPinRestore(scl", "healthy && esp32S3I2cBusReleased", "scl restored before the released check")
    sourceOrder(captured, "esp32S3I2cClearPinRestore(sda", "healthy && esp32S3I2cBusReleased", "sda restored before the released check")
    sourceHas(owned, "pulses < 9", "at most nine clock pulses")
    sourceHas(owned, "esp32S3I2cClearWaitClock(scl, started, budget)", "clock stretch wait is bounded")

    val active = sourceAfter(clear, "trusted fun esp32S3I2cRecoverAndClearGuarded(")
    sourceOrder(active, "gate.tryBeginRecovery", "esp32S3I2cResetWithRccLock", "gate taken before the reset")
    sourceOrder(active, "esp32S3I2cResetWithRccLock", "esp32S3I2cClearStuckBusOwned", "reset before the clear")
    sourceOrder(active, "esp32S3I2cClearStuckBusOwned", "gate.finishRecovery(owner, result == 1)", "clear before the gate is released")
    val passive = sourceRead("src/esp32/i2c/guarded_recovery_esp32s3.ab")
    sourceLacks(passive, "ClearStuckBus", "passive recovery never clears the bus")
    sourceLacks(passive, "RecoverAndClear", "passive recovery is not the active one")
    sourceFinish("PASS: explicit active recovery owns gate through reset, clear and unconditional GPIO restoration")
}
