import "../src/m5stack/imu_owner_clock_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(36)
var calls=0
var failures=0
var bad=false
fun m5ImuClockSetDevice(handle: int,frequency: int): bool {
    val bit=if (handle == 100) 1 else if (handle == 200) 2 else if (handle == 300) 4 else 0
    if (bit == 0 || (calls&bit) != 0 || frequency != 100000) bad=true
    calls=calls|bit
    return (failures&bit) == 0
}
@export("abla_imu_owner_clock_test")
trusted fun test(): i32 {
    val owner=m5ImuOwnerAt(nativeBufferAt(memory,36))
    owner.initialize()
    owner.buffer().storeU32(4,1)
    val primary=(1<<48)|(3<<42)|(104<<35)|(2<<32)|100
    owner.buffer().storeU32(8,primary);owner.buffer().storeU32(12,primary>>>32)
    var kind=0
    while (kind <= 2) {
        val mag=owner.magnetometers()
        mag.buffer().storeU32(4,if (kind == 1) 200 else 0)
        mag.buffer().storeU32(8,if (kind == 2) 300 else 0)
        mag.buffer().storeU32(12,kind);mag.buffer().storeU32(16,if (kind == 0) 2 else 1)
        failures=0
        while (failures < 8) {
            calls=0
            val result=owner.setClockOwned(100000,true)
            val expected=1|(if (kind == 0) 0 else 1<<kind)
            if (result.attempted() != expected || result.updated() != (expected&~failures) ||
                result.failed() != (expected&failures) || result.complete() != ((expected&failures) == 0) ||
                calls != expected || bad || owner.status() != 1 || owner.primary() != primary) return i32(1)
            failures=failures+1
        }
        kind=kind+1
    }
    calls=0
    if (owner.setClockOwned(100000,false).status() != 2 || owner.setClockOwned(999,true).status() != 2 ||
        owner.setClockOwned(400001,true).status() != 2 || calls != 0) return i32(2)
    owner.magnetometers().buffer().storeU32(4,200)
    if (owner.setClockOwned(100000,true).status() != 2 || calls != 0) return i32(3)
    owner.magnetometers().buffer().storeU32(4,0);owner.magnetometers().buffer().storeU32(8,100)
    if (owner.setClockOwned(100000,true).status() != 2 || calls != 0) return i32(4)
    owner.buffer().storeU32(4,4)
    if (owner.setClockOwned(100000,true).status() != 2 || calls != 0) return i32(5)
    return i32(0)
}
