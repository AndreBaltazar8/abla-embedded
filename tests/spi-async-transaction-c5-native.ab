import "./spi-transaction-c5-native.ab"
import "../src/esp32/spi/async_transaction_c5_sequence.ab"
import "abla/runtime/scalar"
val asyncTransactionMemory=nativeStaticAllocate(64)
@export("abla_spi_async_transaction_c5_test")
trusted fun testAsyncTransaction(): i32 {
    val context=nativeBufferAt(asyncTransactionMemory,64)
    val device=master();val gate=peripheralGateAt(gateMemory)
    val tx=nativeBufferAt(ram+1,7);val rx=nativeBufferAt(ram+96,7)
    var scenario=0
    while (scenario <= 9) {
        transactionSeed();esp32C5SpiAsyncTransactionInitialize(context)
        if (scenario <= 7) fault=scenario else csFail=scenario-7
        var result=device.beginTransferAsync(context,gate,u32(7),tx,rx,7,u32(4294967290),u32(10))
        if (result == SpiTransactionResult(0)) {
            if (csHigh || gate.tryBegin(u32(8)) != 1 || device.transfer(gate,u32(8),tx,rx,7,4).status() != 2 ||
                device.beginTransferAsync(context,gate,u32(8),tx,rx,7,u32(0),u32(10)).status() != 2) return i32(1)
            esp32C5SpiAsyncTransactionPoll(context,u32(4294967291))
            esp32C5SpiAsyncTransactionPoll(context,u32(4294967292))
            result=esp32C5SpiAsyncTransactionPoll(context,if (scenario >= 1 && scenario <= 3) u32(4) else u32(3))
        }
        if (result.status() != (if (scenario == 0) 1 else 6) || bad) return i32(2)
        val oldWrites=writes;val oldCs=csWrites
        if (esp32C5SpiAsyncTransactionPoll(context,u32(100)) != result || writes != oldWrites || csWrites != oldCs) return i32(3)
        if (scenario == 0) {
            if (!csHigh || nativeAddressLoadU32(gateMemory,0) != 0 || started != 1) return i32(4)
            var at=0;while (at < 7) { if (rx.load(at) != (tx.load(at)^255)) return i32(5);at=at+1 }
        } else {
            if (nativeAddressLoadU32(gateMemory,0) != 2147483648 || device.beginTransferAsync(context,gate,u32(8),tx,rx,7,u32(0),u32(10)).status() != 4) return i32(6)
            if (scenario <= 3 && (csHigh || (result.value()&u32(1<<24)) == u32(0) || device.recover(gate,u32(8),true))) return i32(7)
            command=u32(0);fault=0;csFail=0
            if (!device.recover(gate,u32(8),true,true) || !csHigh || bad) return i32(8)
        }
        scenario=scenario+1
    }
    transactionSeed();esp32C5SpiAsyncTransactionInitialize(context)
    if (device.beginTransferAsync(context,gate,u32(7),context,rx,7,u32(0),u32(10)).status() != 3 ||
        device.beginTransferAsync(context,peripheralGateAt(asyncTransactionMemory),u32(7),tx,rx,7,u32(0),u32(10)).status() != 3 || csWrites != 0 || writes != 0) return i32(9)
    if (device.beginTransferAsync(context,gate,u32(7),tx,rx,7,u32(0),u32(10)) != SpiTransactionResult(0)) return i32(10)
    // External ownership corruption: do not touch somebody else's CS/controller.
    nativeAddressStoreU32(gateMemory,0,99)
    val previousWrites=writes;val previousCs=csWrites
    if (esp32C5SpiAsyncTransactionPoll(context,u32(1)).status() != 5 || writes != previousWrites || csWrites != previousCs || nativeAddressLoadU32(gateMemory,0) != 99) return i32(11)
    return i32(0)
}
