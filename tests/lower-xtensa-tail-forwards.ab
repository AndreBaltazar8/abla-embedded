// Regression cases for the lower-xtensa-tail-forwards pass: each expectation is what the original Python tool
// produced for the same fixture (see the commit message of the port).
import "abla/io"
import "abla/test"
import "abla/text"
import "../tools/lower-xtensa-tail-forwards-to-abla.ab"


fun main: int {
    expectEqual(tailLowerCalls("fun a() {\n    esp32InterfaceCreateWifiTask()\n    r10 = u32(0)\n    x = esp32InterfaceSetKeepAliveTime(r5, 3)\n    esp32InterfaceGetFixedRate (  )\n}\n").text, "fun a() {\n    r10 = esp32InterfaceCreateWifiTask()\n    x = esp32InterfaceSetKeepAliveTime(r5)\n    r10 = esp32InterfaceGetFixedRate(r10, r11, r12)\n}\n", "tail calls")
    expectEqual(tailLowerCalls("fun a() {\n    esp32InterfaceCreateWifiTask()\n    r10 = u32(0)\n    x = esp32InterfaceSetKeepAliveTime(r5, 3)\n    esp32InterfaceGetFixedRate (  )\n}\n").zeroReturns, 1, "tail counts")
    if (testsPassed() != 0) return 1
    println("PASS: lower-xtensa-tail-forwards matches the original Python tool on the fixtures")
    0
}
