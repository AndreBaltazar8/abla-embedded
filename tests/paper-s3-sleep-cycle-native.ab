import "./paper-s3-sleep-prepare-native.ab"
import "./paper-s3-wake-release-native.ab"
import "../src/m5stack/paper_s3_sleep_cycle_sequence.ab"
import "./i2c-sleep-s3-native.ab"
val cycleMemory=nativeStaticAllocate(336)
val cycleConfigMemory=nativeStaticAllocate(72)
var cyclePadOwned=false
var cyclePadPrepareFailure=false
var cyclePadRestoreFailure=false
var cyclePadBad=false
var cyclePadRestores=0
var cycleBusKey=6
fun paperS3CycleTouchBus(touch: int): int = if (touch == 123) cycleBusKey else 0
fun paperS3CyclePadCapture(): S3GpioSnapshot {
    if (cyclePadOwned) cyclePadBad=true
    cyclePadOwned=true
    return S3GpioSnapshot((1<<29)|(48<<23))
}
fun paperS3CyclePadPrepare(pad: S3GpioSnapshot): int {
    if (!cyclePadOwned || !pad.valid() || pad.pin() != 48) cyclePadBad=true
    return if (cyclePadPrepareFailure) 4 else 1
}
fun paperS3CyclePadRestore(pad: S3GpioSnapshot): int {
    if (!cyclePadOwned || !pad.valid() || pad.pin() != 48 || sessionPad != originalPad || sessionTrigger != originalTrigger) cyclePadBad=true
    if (cyclePadRestoreFailure) return 4
    cyclePadRestores=cyclePadRestores+1;cyclePadOwned=false;return 1
}
@export("abla_paper_s3_sleep_cycle_test")
fun testCycle(): int {
    val r=nativeBufferAt(cycleMemory,336);val cfg=nativeBufferAt(cycleConfigMemory,72)
    val cpu=nativeBufferAt(prepareMemory,8800);val tags=nativeBufferAt(prepareMemory+8800,256);val scratch=nativeBufferAt(4096,40)
    val instruction=esp32S3TagPlan(false,16384,4,32,0x42000000,4096,false)
    val data=esp32S3TagPlan(true,32768,4,32,0x3c000000,4096,false)
    if (!paperS3SleepConfigEncode(cfg,instruction,data,Esp32S3ClockBias(0),3,4,-1,2,3,100,0x20000,3495253,0,0)) return 14
    var profile=0
    while (profile < 20) {
        seedSession(nativeBufferAt(sessionMemory,36),48,true);r.storeU32(0,0)
        runProgress=0;runCalls=0;runResumes=0;prepareCalls=0;prepareBad=false
        prepareOutcome=1+profile%5;runEntry=if (profile >= 10) 1 else 0
        cycleBusKey=if (profile >= 10) 0x1fffffffe else 6
        reads=0;waits=0;bad=false;outcome=-1;releaseAfter=if ((profile%10) >= 5) 9999 else 2
        if (paperS3SleepCycleOpenOwned(r,cpu,tags,cfg,123,true) != 1) return 1
        if (paperS3SleepCycleContinueQuiescedOwned(r,cpu,tags,cfg,true) != 9 || prepareCalls != 0) return 2
        var poll=paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true)
        if (releaseAfter == 9999) {
            if (poll != 2) return 3
            poll=paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true)
            if (poll != 2) return 4
            poll=paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true)
        }
        if (poll != 3 || sleepGate != 2 || bad || prepareCalls != 0 || PaperS3WakeRelease(r.loadU32(36)).released() != (releaseAfter != 9999)) return 5
        val touchReads=reads
        var result=paperS3SleepCycleContinueQuiescedOwned(r,cpu,tags,cfg,true)
        if (prepareOutcome == 1 || prepareOutcome == 5) {
            if (result != 4 || paperS3SleepCycleCancelNormalOwned(r,cpu,tags,cfg,true) != 9) return 6
            if (prepareOutcome == 1 && paperS3SleepCycleCancelQuiescedOwned(r,cpu,tags,cfg,true) != 9) return 7
            runProgress=1
            result=paperS3SleepCycleContinueQuiescedOwned(r,cpu,tags,cfg,true)
        }
        val expected=if (prepareOutcome != 1) 7 else if (runEntry == 0) 5 else 6
        if (result != expected || sleepGate != 0 || prepareCalls != 1 || prepareBad || runCalls != (if (prepareOutcome == 1) 1 else 0) || reads != touchReads || sessionBad || cyclePadOwned || cyclePadBad || sessionPad != originalPad || sessionTrigger != originalTrigger) return 8
        val writes=sessionWrites
        if (paperS3SleepCycleContinueQuiescedOwned(r,cpu,tags,cfg,true) != expected || paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true) != expected || writes != sessionWrites || reads != touchReads) return 9
        profile=profile+1
    }
    var phase=0
    while (phase < 3) {
        seedSession(nativeBufferAt(sessionMemory,36),48,true);r.storeU32(0,0);runProgress=0
        reads=0;waits=0;releaseAfter=0;prepareCalls=0;runCalls=0
        if (paperS3SleepCycleOpenOwned(r,cpu,tags,cfg,123,true) != 1) return 10
        if (phase > 0 && paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true) != 3) return 11
        sessionDrop=sessionWrites+1
        val result=if (phase == 2) paperS3SleepCycleCancelQuiescedOwned(r,cpu,tags,cfg,true) else paperS3SleepCycleCancelNormalOwned(r,cpu,tags,cfg,true)
        if (result != 4) return 12
        sessionDrop=0
        val finished=if (phase == 2) paperS3SleepCycleContinueQuiescedOwned(r,cpu,tags,cfg,true) else paperS3SleepCycleCancelNormalOwned(r,cpu,tags,cfg,true)
        if (finished != 8 || prepareCalls != 0 || runCalls != 0 || sessionPad != originalPad || sessionTrigger != originalTrigger) return 13
        phase=phase+1
    }
    var fault=0
    while (fault < 4) {
        seedSession(nativeBufferAt(sessionMemory,36),48,true);r.storeU32(0,0);runProgress=1
        reads=0;waits=0;releaseAfter=0;prepareCalls=0;runCalls=0;prepareOutcome=1;runEntry=0
        cyclePadPrepareFailure=fault == 0 || fault == 3;cyclePadRestoreFailure=fault != 0
        val opened=paperS3SleepCycleOpenOwned(r,cpu,tags,cfg,123,true)
        if (fault == 0) { if (opened != 8 || cyclePadOwned) return 16 }
        else {
            if (fault == 3) { if (opened != 4 || !cyclePadOwned) return 17 }
            else {
                if (opened != 1) return 18
                if (fault == 1) { if (paperS3SleepCycleCancelNormalOwned(r,cpu,tags,cfg,true) != 4) return 19 }
                else {
                    if (paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true) != 3 || paperS3SleepCycleContinueQuiescedOwned(r,cpu,tags,cfg,true) != 4 || runCalls != 1) return 20
                }
            }
            cyclePadRestoreFailure=false
            val calls=runCalls;val restores=cyclePadRestores
            val closed=if (fault == 2) paperS3SleepCycleContinueQuiescedOwned(r,cpu,tags,cfg,true) else paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true)
            if (closed != (if (fault == 2) 5 else 8) || cyclePadOwned || cyclePadRestores != restores+1 || runCalls != calls) return 21
        }
        if (cyclePadBad) return 22
        fault=fault+1
    }
    cyclePadPrepareFailure=false;cyclePadRestoreFailure=false
    var busFault=0
    while (busFault < 5) {
        seedSession(nativeBufferAt(sessionMemory,36),48,true);r.storeU32(0,0);runProgress=1
        reads=0;waits=0;releaseAfter=0;prepareCalls=0;runCalls=0;prepareOutcome=1;runEntry=0
        sleepGate=0;sleepBusIdle=true;sleepReleaseFails=false
        if (paperS3SleepCycleOpenOwned(r,cpu,tags,cfg,123,true) != 1) return 23
        if (busFault == 0) sleepGate=1
        if (busFault == 1 || busFault == 3) sleepBusIdle=false
        if (busFault == 2) sleepGate=0x80000000
        if (busFault == 3) sleepReleaseFails=true
        val polled=paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true)
        if (busFault < 2) {
            if (polled != 2 || prepareCalls != 0) return 24
            sleepGate=0;sleepBusIdle=true;releaseAfter=reads+2;outcome=0
            val before=reads
            if (paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true) != 3 || reads != before+2 || sleepGate != 2) return 25
            if (paperS3SleepCycleCancelNormalOwned(r,cpu,tags,cfg,true) != 8 || sleepGate != 0) return 26
        } else if (busFault == 2) {
            if (polled != 9 || paperS3SleepCycleCancelNormalOwned(r,cpu,tags,cfg,true) != 8 || sleepGate != 0x80000000) return 27
            sleepGate=0
        } else if (busFault == 3) {
            val before=reads
            if (polled != 4 || paperS3SleepCyclePollOwned(r,cpu,tags,cfg,scratch,true) != 4 || reads != before || sleepGate != 2) return 28
            if (paperS3SleepCycleCancelNormalOwned(r,cpu,tags,cfg,true) != 4) return 29
            sleepBusIdle=true;sleepReleaseFails=false
            if (paperS3SleepCycleCancelNormalOwned(r,cpu,tags,cfg,true) != 8 || sleepGate != 0) return 30
        } else {
            if (polled != 3) return 31
            sleepReleaseFails=true
            if (paperS3SleepCycleContinueQuiescedOwned(r,cpu,tags,cfg,true) != 4 || runCalls != 1 || sleepGate != 2) return 32
            sleepReleaseFails=false
            if (paperS3SleepCycleContinueQuiescedOwned(r,cpu,tags,cfg,true) != 5 || runCalls != 1 || sleepGate != 0) return 33
        }
        if (cyclePadOwned || cyclePadBad) return 34
        busFault=busFault+1
    }
    r.storeU32(0,0);cfg.storeU32(68,1)
    val writes=sessionWrites
    if (paperS3SleepCycleOpenOwned(r,cpu,tags,cfg,123,true) != 9 || r.loadU32(0) != 0 || writes != sessionWrites) return 15
    return 0
}
