import "../src/esp32/dsi_long_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(70)
var length=1
var words=0
var header=false
var bad=false
var mode=0
var reads=0
fun p4DsiRead(offset: int): u32 {
    reads=reads+1
    if (offset != 116) return u32(0)
    if (mode == 1 && words >= 1) return u32(13)
    if (mode == 2 && words*4 >= length) return u32(7)
    if (mode == 3 && header) return u32(64)
    u32(5)
}
fun p4DsiWrite(offset: int,value: u32): void {
    if (offset == 112) {
        var expected=u32(0)
        var byte=0
        while (byte < 4 && words*4+byte < length) {
            expected=expected|(u32((words*4+byte)*3+1)<<u32(byte*8))
            byte=byte+1
        }
        if (header || value != expected) bad=true
        words=words+1
    } else if (offset == 108) {
        if (words != (length+3)/4 || value != u32((length<<8)|185)) bad=true
        header=true
    } else bad=true
    return
}
@export("abla_dsi_p4_long_test")
trusted fun testLong(): i32 {
    val buffer=nativeBufferAt(storage+1,65)
    var byte=0
    while (byte < 65) { buffer.store(byte,byte*3+1); byte=byte+1 }
    while (length <= 65) {
        words=0; header=false
        val result=esp32P4DsiLongWriteOwned(2,57,buffer,length,3)
        if (!result.hostComplete() || !result.enqueued() || !result.payloadStaged() || !header || bad) return i32(1)
        length=length+1
    }
    length=9
    mode=1
    while (mode <= 3) {
        words=0; header=false
        val result=esp32P4DsiLongWriteOwned(2,57,buffer,length,3)
        if (result.status() != (if (mode == 1) 7 else if (mode == 2) 8 else 5) ||
            !result.payloadStaged() || result.enqueued() != (mode == 3) || bad) return i32(2)
        mode=mode+1
    }
    reads=0; words=0; header=false
    if (esp32P4DsiLongWriteOwned(2,5,buffer,9,3).status() != 2 ||
        esp32P4DsiLongWriteOwned(2,57,buffer,66,3).status() != 2 || reads != 0 || words != 0) return i32(3)
    i32(0)
}
