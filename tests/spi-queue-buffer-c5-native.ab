import "./spi-buffer-c5-native.ab"
import "../src/esp32/spi/queue_c5_sequence.ab"
val bulkQueueMemory=nativeStaticAllocate(256)
val bulkCompletion=nativeStaticAllocate(16)
val bulkPayload=nativeStaticAllocate(131104)
val secondPayload=nativeStaticAllocate(16)
@export("abla_spi_queue_buffer_c5_test")
trusted fun testBulkQueue(): i32 {
    val queue=nativeBufferAt(bulkQueueMemory,256);val completion=nativeBufferAt(bulkCompletion,16)
    val gate=peripheralGateAt(gateStorage)
    initialize();timeout=false;timeoutAt=0;starts=0;nativeAddressStoreU32(gateStorage,0,0)
    val master=openMaster(0)
    if (!master.ready()) return i32(1)
    var variant=0
    while (variant < 4) {
        val size=if (variant == 0) 65 else if (variant == 1) 513 else if (variant == 2) 65535 else 513
        val tx=nativeBufferAt(bulkPayload+16,size);val rx=nativeBufferAt(bulkPayload+65568,size)
        val tx2=nativeBufferAt(secondPayload,7);val rx2=nativeBufferAt(secondPayload+8,7)
        var at=0;while (at < size) { tx.store(at,at&255);rx.store(at,90);at=at+1 }
        at=0;while (at < 7) { tx2.store(at,at);rx2.store(at,90);at=at+1 }
        if (!esp32C5SpiQueueInitialize(queue,2,master,gate,u32(7),true)) return i32(2)
        val initialWrites=spiWrites
        if (esp32C5SpiQueueSubmit(queue,u32(1),tx,nativeBufferAt(tx.addressValue()+1,size),size,u32(10000)) != 3 || spiWrites != initialWrites) return i32(3)
        if (esp32C5SpiQueueSubmit(queue,u32(1),tx,rx,size,u32(10000)) != 1 ||
            esp32C5SpiQueueSubmit(queue,u32(2),tx2,rx2,7,u32(10)) != 1) return i32(4)
        val previousStarts=starts;val previousGpio=writes
        timeoutAt=if (variant == 3) starts+2 else 0
        var now=0
        var result=esp32C5SpiQueueService(queue,u32(now))
        while (result == 2 && now < 10001) {
            if (writes != previousGpio+1 || gate.tryBegin(u32(8)) != 1) return i32(5)
            now=now+1;result=esp32C5SpiQueueService(queue,u32(now))
        }
        if (result != 1 || starts != previousStarts+(if (variant == 3) 2 else (size+63)/64) || bad) return i32(6)
        val finishedStarts=starts;val finishedWrites=spiWrites
        if (esp32C5SpiQueueService(queue,u32(now+1)) != 1 || starts != finishedStarts || spiWrites != finishedWrites ||
            esp32C5SpiQueueTake(queue,nativeBufferAt(bulkCompletion,12),true) != 3 ||
            esp32C5SpiQueueTake(queue,nativeBufferAt(tx.addressValue()-12,16),true) != 3 ||
            esp32C5SpiQueueTake(queue,completion,true) != 1 || completion.loadU32(0) != 1 ||
            completion.loadU32(4) != (if (variant == 3) 6 else 1) || completion.loadU32(12) != (if (variant == 3) 64 else size)) return i32(7)
        at=0;while (at < size) { if (rx.load(at) != (if (variant == 3 && at >= 64) 90 else (at&255)^255)) return i32(8);at=at+1 }
        if (variant == 3) {
            if (esp32C5SpiQueueService(queue,u32(now+2)) != 6 || esp32C5SpiQueueCancelTail(queue,u32(2)) != 1) return i32(9)
            active=false;timeoutAt=0
            if (!master.recover(gate,u32(8),true)) return i32(10)
        } else {
            if (writes != previousGpio+2 || esp32C5SpiQueueService(queue,u32(now+1)) != 2) return i32(11)
            esp32C5SpiQueueService(queue,u32(now+2));esp32C5SpiQueueService(queue,u32(now+3))
            if (esp32C5SpiQueueService(queue,u32(now+4)) != 1 || esp32C5SpiQueueTake(queue,completion,true) != 1 ||
                completion.loadU32(0) != 2 || completion.loadU32(4) != 1 || completion.loadU32(12) != 7 || writes != previousGpio+4) return i32(12)
        }
        variant=variant+1
    }
    if (master.closeOwned(true) != 0 || bad) return i32(13)
    return i32(0)
}
