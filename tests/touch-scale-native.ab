import "../src/m5stack/papermono_touch_logic.ab"
import "../src/m5stack/stopwatch_touch_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_touch_scale_test")
fun testScale(): i32 {
    var size=0
    while (size < 8) {
        val source=if (size == 0) 1 else if (size == 1) 2 else if (size == 2) 234 else if (size == 3) 480 else if (size == 4) 800 else if (size == 5) 32768 else if (size == 6) 65535 else 65536
        var target=0
        while (target < 8) {
            val width=if (target == 0) 1 else if (target == 1) 2 else if (target == 2) 468 else if (target == 3) 480 else if (target == 4) 800 else if (target == 5) 32768 else if (target == 6) 65535 else 65536
            var x=0
            while (x < source) {
                val point=touchPoint(x,source-1-x,255,3,65535)
                val result=point.scaled(source,source,width,width)
                val expectedX=if (source == 1) 0 else x*(width-1)/(source-1)
                val expectedY=if (source == 1) 0 else (source-1-x)*(width-1)/(source-1)
                if (!result.inside(width,width) || result.x() != expectedX || result.y() != expectedY || result.id() != 255 || result.event() != 3 || result.size() != 65535) return i32(1)
                x=x+1
            }
            target=target+1
        }
        size=size+1
    }
    var y=0
    while (y < 800) {
        var x=0
        while (x < 480) {
            val point=touchPoint(x,y,7,2,42)
            var rotation=0
            while (rotation < 8) {
                val expected=touchPoint(x,y,7,2,42).forLcdRotation(480,800,rotation)
                if (point.forPaperMonoDisplay(rotation) != expected) return i32(2)
                if (x < 234 && y < 234 && point.forStopWatchDisplay(rotation) != touchPoint(x*467/233,y*467/233,7,2,42).forLcdRotation(468,468,rotation)) return i32(3)
                rotation=rotation+1
            }
            x=x+1
        }
        y=y+1
    }
    val p=touchPoint(0,0,0,0)
    if (p.scaled(0,1,1,1).valid() || p.scaled(1,65537,1,1).valid() || p.scaled(1,1,0,1).valid() || p.scaled(1,1,1,65537).valid() || touchPoint(1,0,0,0).scaled(1,1,1,1).valid() || TouchPoint(0).scaled(1,1,1,1).valid()) return i32(4)
    return i32(0)
}
