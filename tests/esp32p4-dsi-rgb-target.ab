import "../src/display/dsi_rgb_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_rgb_target")
trusted fun target(version: int,width: int,input: int,output: int,channel: int,lp: bool,ack: bool,polls: int): DsiCommandResult =
    esp32P4DsiConfigureRgb(version,width,input,output,channel,lp,ack,polls)
