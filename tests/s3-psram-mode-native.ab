import "../src/esp32/psram/mode_s3_sequence.ab"
import "abla/build"
val modeStorage=nativeStaticAllocate(160)
val modeRegisters=nativeStaticAllocate(16)
var modeCalls=0
var modeFail=0
var modeReady=true
var modeDrop=false
var modeBad=false
fun s3PsramCommandStorageSafe(address: int,length: int): bool = address >= modeStorage && address+length <= modeStorage+160
fun s3PsramCommandReady(): bool = modeReady
fun s3PsramOpiDtrMode(): void { return }
fun s3PsramCommandConfigure(unit: int,descriptor: int): void { if (unit != 1 || descriptor != modeStorage) modeBad=true;return }
fun s3PsramCommandStart(rx: int,length: int): void {
    val work=nativeBufferAt(modeStorage,100);val regs=nativeBufferAt(modeRegisters,16)
    val command=work.loadU32(0)&65535;val address=work.loadU32(32)
    if (address > 8 || (work.loadU32(0)>>>16) != 16 || work.loadU32(8) != 32) modeBad=true
    if (command == 0x4040) {
        if (rx != modeStorage+36 || work.loadU32(28) != 8 || length != (if (address < 4) 2 else 1)) modeBad=true
        var i=0
        while (i < length) { work.store(36+i,regs.load(address+i));i=i+1 }
    } else if (command == 0xc0c0) {
        if (address != 0 || rx != 0 || length != 0 || work.loadU32(28) != 0 || work.loadU32(16) != 16) modeBad=true
        if (!modeDrop) { regs.store(0,work.load(36));regs.store(1,work.load(37)) }
    } else modeBad=true
    modeCalls=modeCalls+1
    if (modeCalls == modeFail) modeReady=false
    return
}
@export("abla_s3_psram_mode_test")
fun testPsramMode(): int {
    val work=nativeBufferAt(modeStorage,100);val scratch=nativeBufferAt(modeStorage+104,8)
    val output=nativeBufferAt(modeStorage+120,8);val regs=nativeBufferAt(modeRegisters,16)
    var value=0
    while (value < 256) {
        regs.store(0,value);regs.store(1,value^165);regs.store(2,0x83);regs.store(3,0x60);regs.store(4,0x20);regs.store(8,0xA3)
        modeCalls=0;modeFail=0;modeReady=true;modeDrop=false;modeBad=false
        if (s3PsramConfigureModeOwned(scratch,work,true) != 1 || modeCalls != 3 ||
            regs.load(0) != ((value&192)|40) || regs.load(1) != (value^165)) return 1
        output.store(6,0xA5);output.store(7,0x5A)
        if (s3PsramReadIdentityOwned(output,scratch,work,true) != 1 || modeCalls != 7 ||
            output.load(0) != regs.load(0) || output.load(1) != regs.load(1) ||
            output.load(2) != 0x83 || output.load(3) != 0x60 || output.load(4) != 0x20 || output.load(5) != 0xA3 ||
            output.load(6) != 0xA5 || output.load(7) != 0x5A || modeBad) return 2
        val identity=s3PsramIdentityFrom(output)
        if (!identity.good() || identity.physicalBytes() != 8388608 || identity.vendor() != ((value^165)&31) ||
            identity.knownVendor() != (identity.vendor() == 13 || identity.vendor() == 26)) return 3
        value=value+1
    }
    var failure=1
    while (failure <= 4) {
        modeCalls=0;modeFail=failure;modeReady=true;modeDrop=false;modeBad=false
        output.storeU32(0,0x55555555);output.storeU32(4,0x55555555)
        if (s3PsramReadIdentityOwned(output,scratch,work,true) != 4 || modeCalls != failure ||
            output.loadU32(0) != 0x55555555 || output.loadU32(4) != 0x55555555 || modeBad) return 4
        if (failure <= 3) {
            modeCalls=0;modeReady=true
            if (s3PsramConfigureModeOwned(scratch,work,true) != 4 || modeCalls != failure) return 5
        }
        failure=failure+1
    }
    modeCalls=0;modeFail=0;modeReady=true;modeDrop=true;regs.store(0,192)
    if (s3PsramConfigureModeOwned(scratch,work,true) != 5 || modeCalls != 3) return 6
    modeCalls=0
    if (s3PsramConfigureModeOwned(scratch,work,false) != 2 ||
        s3PsramReadIdentityOwned(scratch,scratch,work,true) != 2 ||
        s3PsramReadIdentityOwned(output,scratch,nativeBufferAt(modeStorage,99),true) != 2 || modeCalls != 0) return 7
    value=0
    while (value < 256) {
        val id=S3PsramIdentity(value<<16)
        val density=value&7
        val expected=if (density == 1) 4194304 else if (density == 3) 8388608 else if (density == 5) 16777216 else if (density == 7) 33554432 else if (density == 6) 67108864 else 0
        if (id.physicalBytes() != expected || id.good() != ((value&128) != 0)) return 8
        value=value+1
    }
    if (S3PsramIdentity(-1).valid() || S3PsramIdentity(281474976710656).valid()) return 9
    return 0
}
