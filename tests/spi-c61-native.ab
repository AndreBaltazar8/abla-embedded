import "../src/esp32/gpio_pin_c61_sequence.ab"
import "../src/spi/software_transfer.ab"
import "abla/build"
val memory=nativeStaticAllocate(128)
var mode=0
var levels=u32(0)
var samples=0
var delays=0
var writes=0
var bad=false
fun c61GpioRead(address: int): u32 {
    if (address != 0x60091064) { bad=true;return u32(0) }
    val idle=(mode&2) != 0
    val expected=if ((mode&1) != 0) idle else !idle
    if (((levels&u32(1<<25)) != u32(0)) != expected) bad=true
    val byte=samples/8
    val bit=7-(samples&7)
    val tx=(byte*37+19)&255
    if (((levels&u32(1<<27)) != u32(0)) != ((tx&(1<<bit)) != 0)) bad=true
    val rx=(byte*53+127)&255
    samples=samples+1
    return if ((rx&(1<<bit)) != 0) u32(1<<26) else u32(0)
}
fun c61GpioWrite(address: int,value: u32): void {
    writes=writes+1
    if ((value&~u32((1<<25)|(1<<27))) != u32(0)) bad=true
    if (address == 0x60091008) levels=levels|value
    else if (address == 0x6009100c) levels=levels&~value
    else bad=true
    return
}
fun peripheralDelayMicroseconds(us: int): void { if (us != 2) bad=true;delays=delays+1;return }
@export("abla_spi_c61_test")
trusted fun testSpi(): i32 {
    val output=nativeBufferAt(memory,64)
    val input=nativeBufferAt(memory+64,64)
    while (mode < 4) {
        var count=0
        while (count <= 33) {
            var at=0
            while (at < 64) { output.store(at,(at*37+19)&255);input.store(at,0);at=at+1 }
            var inplace=0
            while (inplace < 2) {
                levels=if ((mode&2) != 0) u32(1<<25) else u32(0)
                samples=0;delays=0;writes=0;bad=false
                val destination=if (inplace == 0) input else output
                if (!softwareSpiTransferOwned(Pin(25),Pin(27),Pin(26),output,count,destination,count,mode,2,255) ||
                    bad || samples != count*8 || delays != count*16 ||
                    ((levels&u32(1<<25)) != u32(0)) != ((mode&2) != 0)) return i32(1)
                at=0
                while (at < count) { if (destination.load(at) != ((at*53+127)&255)) return i32(2);at=at+1 }
                inplace=inplace+1
            }
            count=count+1
        }
        mode=mode+1
    }
    writes=0;samples=0
    if (softwareSpiTransferOwned(Pin(25),Pin(27),Pin(26),output,8,nativeBufferAt(memory+1,8),8,0,2) ||
        softwareSpiTransferOwned(Pin(30),Pin(27),Pin(26),output,8,input,8,0,2) ||
        softwareSpiTransferOwned(Pin(25),Pin(25),Pin(26),output,8,input,8,0,2) ||
        Pin(-1).writeLevelOwned(true) || Pin(30).readLevelOwned() != -1 || writes != 0 || samples != 0) return i32(3)
    return i32(0)
}
