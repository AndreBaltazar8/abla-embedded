import "../src/esp32/spi/command_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun spiCommandTarget(gateAddress: u32, command: u32, address: u32, bytes: u32): int =
    esp32s3SpiCommand(peripheralGateAt(int(gateAddress)), u32(41), 2,
        spiPins(37,35,36), Pin(3), Pin(35), int(command),
        nativeBufferAt(int(address), int(bytes)), int(bytes), true)
#exportFunction("spiCommandTarget", "abla_s3_spi_cpu_command_test")
