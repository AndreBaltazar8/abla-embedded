import "./oled-owner-wire-native.ab"
@export("abla_oled_region_wire_test")
trusted fun testRegion(): i32 {
    wireSeed();extraAddress=60
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    val owner=oledOwnerAt(nativeBufferAt(ownerMemory,32))
    val frame=nativeBufferAt(oledMemory,1024);val scratch=nativeBufferAt(oledMemory+1024,176)
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1 || !owner.initializeFresh()) return i32(1)
    var variant=0
    while (variant < 2) {
        val profile=if (variant == 0) m5UnitMiniOledProfile else m5UnitOledProfile
        if (owner.openOwned(control.session().bus(),profile,scratch,true) != 1) return i32(2)
        var at=0;while (at < 1024) { frame.store(at,(at*73+19)&255);at=at+1 }
        var regionIndex=0
        while (regionIndex < 3) {
            val x=if (regionIndex == 0) 3 else if (regionIndex == 1) 5 else profile.width()-1
            val y=if (regionIndex == 0) 7 else if (regionIndex == 1) 17 else profile.height()-1
            val w=if (regionIndex == 0) 5 else if (regionIndex == 1) 9 else 1
            val h=if (regionIndex == 0) 3 else if (regionIndex == 1) 9 else 1
            val first=y/8;val end=(y+h-1)/8
            val left=if (variant == 0) (x/4)*4 else x
            val right=if (variant == 0) ((x+w+3)/4)*4-1 else x+w-1
            expectedCount=0;expectedPages=0;expectedStage=3
            if (variant == 0) {
                expectStart();expectByte(0);expectByte(33);expectByte(profile.column()+left);expectByte(profile.column()+right)
                expectByte(34);expectByte(first);expectByte(end)
            }
            var page=first
            while (page <= end) {
                expectedPages=page-first;expectedStage=3
                if (variant == 1) {
                    val column=profile.column()+left
                    expectStart();expectByte(0);expectByte(176+page);expectByte(16+column/16);expectByte(column%16)
                }
                expectedStage=4;expectStart();expectByte(64)
                at=left;while (at <= right) { expectByte(((page*profile.width()+at)*73+19)&255);at=at+1 }
                page=page+1
            }
            var failure=0
            while (failure <= expectedCount) {
                var commit=0
                while (commit < 2) {
                    val before=ackCount;extraCount=0;nackAfterCommit=commit == 1
                    nackAt=if (failure == 0) 0 else before+failure
                    val result=owner.displayRegionOwned(frame,scratch,x,y,w,h,true)
                    val e=nativeBufferAt(oledExpected,16384)
                    val expected=if (failure == 0) 1|((end-first+1)<<8) else e.load((failure-1)*4+2)|(e.load((failure-1)*4+3)<<8)
                    val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && e.load((failure-1)*4) > 1) 1 else 0)
                    if (result != expected || owner.lastPublication() != result || ackCount-before != (if (failure == 0) expectedCount else failure) ||
                        extraCount != accepted || bad || mode != 0) return i32(3)
                    at=0;while (at < accepted) {
                        if (nativeBufferAt(extraWire,8192).load(at*2) != e.load(at*4) || nativeBufferAt(extraWire,8192).load(at*2+1) != e.load(at*4+1)) return i32(4)
                        at=at+1
                    }
                    commit=commit+1
                }
                failure=failure+1
            }
            nackAt=0;nackAfterCommit=false
            regionIndex=regionIndex+1
        }
        val before=ackCount
        if (owner.displayRegionOwned(frame,scratch,-1,0,1,1,true) != 2 || owner.displayRegionOwned(frame,scratch,0,0,2147483647,1,true) != 2 ||
            owner.displayRegionOwned(frame,scratch,0,0,1,0,true) != 2 || ackCount != before) return i32(5)
        at=0;while (at < 1024) { if (frame.load(at) != ((at*73+19)&255)) return i32(6);at=at+1 }
        if (!owner.closeOwned(scratch,true)) return i32(7)
        variant=variant+1
    }
    if (!control.closeOwned(true) || pads != 0 || bad) return i32(8)
    return i32(0)
}
