    val board4=m5Dial()
    if (board4.boardId() != M5BoardId(12) || board4.i2cPins() != M5BoardId(12).i2cPins() || board4.speakerProfile() != M5BoardId(12).speakerProfile() || board4.microphoneProfile() != M5BoardId(12).microphoneProfile() || board4.touchProfile() != M5BoardId(12).touchProfile() || board4.rtcKind() != M5BoardId(12).rtcKind() || board4.powerKind() != M5BoardId(12).powerKind()) return i32(4)
    val board5=m5DinMeter()
    if (board5.boardId() != M5BoardId(13) || board5.i2cPins() != M5BoardId(13).i2cPins() || board5.speakerProfile() != M5BoardId(13).speakerProfile() || board5.microphoneProfile() != M5BoardId(13).microphoneProfile() || board5.touchProfile() != M5BoardId(13).touchProfile() || board5.rtcKind() != M5BoardId(13).rtcKind() || board5.powerKind() != M5BoardId(13).powerKind()) return i32(5)
    val board6=m5Capsule()
    if (board6.boardId() != M5BoardId(139) || board6.i2cPins() != M5BoardId(139).i2cPins() || board6.speakerProfile() != M5BoardId(139).speakerProfile() || board6.microphoneProfile() != M5BoardId(139).microphoneProfile() || board6.touchProfile() != M5BoardId(139).touchProfile() || board6.rtcKind() != M5BoardId(139).rtcKind() || board6.powerKind() != M5BoardId(139).powerKind()) return i32(6)
    val board7=m5PaperS3()
    if (board7.boardId() != M5BoardId(19) || board7.i2cPins() != M5BoardId(19).i2cPins() || board7.speakerProfile() != M5BoardId(19).speakerProfile() || board7.microphoneProfile() != M5BoardId(19).microphoneProfile() || board7.touchProfile() != M5BoardId(19).touchProfile() || board7.rtcKind() != M5BoardId(19).rtcKind() || board7.powerKind() != M5BoardId(19).powerKind()) return i32(7)
    val board8=m5PaperColor()
    if (board8.boardId() != M5BoardId(28) || board8.i2cPins() != M5BoardId(28).i2cPins() || board8.speakerProfile() != M5BoardId(28).speakerProfile() || board8.microphoneProfile() != M5BoardId(28).microphoneProfile() || board8.touchProfile() != M5BoardId(28).touchProfile() || board8.rtcKind() != M5BoardId(28).rtcKind() || board8.powerKind() != M5BoardId(28).powerKind()) return i32(8)
    val board9=m5PaperMono()
    if (board9.boardId() != M5BoardId(29) || board9.i2cPins() != M5BoardId(29).i2cPins() || board9.speakerProfile() != M5BoardId(29).speakerProfile() || board9.microphoneProfile() != M5BoardId(29).microphoneProfile() || board9.touchProfile() != M5BoardId(29).touchProfile() || board9.rtcKind() != M5BoardId(29).rtcKind() || board9.powerKind() != M5BoardId(29).powerKind()) return i32(9)
    val board10=m5StopWatch()
    if (board10.boardId() != M5BoardId(30) || board10.i2cPins() != M5BoardId(30).i2cPins() || board10.speakerProfile() != M5BoardId(30).speakerProfile() || board10.microphoneProfile() != M5BoardId(30).microphoneProfile() || board10.touchProfile() != M5BoardId(30).touchProfile() || board10.rtcKind() != M5BoardId(30).rtcKind() || board10.powerKind() != M5BoardId(30).powerKind()) return i32(10)
    val board11=m5ChainCaptain()
    if (board11.boardId() != M5BoardId(32) || board11.i2cPins() != M5BoardId(32).i2cPins() || board11.speakerProfile() != M5BoardId(32).speakerProfile() || board11.microphoneProfile() != M5BoardId(32).microphoneProfile() || board11.touchProfile() != M5BoardId(32).touchProfile() || board11.rtcKind() != M5BoardId(32).rtcKind() || board11.powerKind() != M5BoardId(32).powerKind()) return i32(11)
    val board12=m5StackChan()
    if (board12.boardId() != M5BoardId(27) || board12.i2cPins() != M5BoardId(27).i2cPins() || board12.speakerProfile() != M5BoardId(27).speakerProfile() || board12.microphoneProfile() != M5BoardId(27).microphoneProfile() || board12.touchProfile() != M5BoardId(27).touchProfile() || board12.rtcKind() != M5BoardId(27).rtcKind() || board12.powerKind() != M5BoardId(27).powerKind()) return i32(12)
    val board13=m5PaperDIY()
    if (board13.boardId() != M5BoardId(34) || board13.i2cPins() != M5BoardId(34).i2cPins() || board13.speakerProfile() != M5BoardId(34).speakerProfile() || board13.microphoneProfile() != M5BoardId(34).microphoneProfile() || board13.touchProfile() != M5BoardId(34).touchProfile() || board13.rtcKind() != M5BoardId(34).rtcKind() || board13.powerKind() != M5BoardId(34).powerKind()) return i32(13)
    val board14=m5StampPLC()
    if (board14.boardId() != M5BoardId(21) || board14.i2cPins() != M5BoardId(21).i2cPins() || board14.speakerProfile() != M5BoardId(21).speakerProfile() || board14.microphoneProfile() != M5BoardId(21).microphoneProfile() || board14.touchProfile() != M5BoardId(21).touchProfile() || board14.rtcKind() != M5BoardId(21).rtcKind() || board14.powerKind() != M5BoardId(21).powerKind()) return i32(14)
    return i32(0)
}
