import "../src/m5stack/s3_board_profiles.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_board_profiles_test")
fun testProfiles(): i32 {
    val board1=m5Cardputer()
    if (board1.boardId() != M5BoardId(14) || board1.i2cPins() != M5BoardId(14).i2cPins() || board1.speakerProfile() != M5BoardId(14).speakerProfile() || board1.microphoneProfile() != M5BoardId(14).microphoneProfile() || board1.touchProfile() != M5BoardId(14).touchProfile() || board1.rtcKind() != M5BoardId(14).rtcKind() || board1.powerKind() != M5BoardId(14).powerKind()) return i32(1)
    val board2=m5CardputerADV()
    if (board2.boardId() != M5BoardId(24) || board2.i2cPins() != M5BoardId(24).i2cPins() || board2.speakerProfile() != M5BoardId(24).speakerProfile() || board2.microphoneProfile() != M5BoardId(24).microphoneProfile() || board2.touchProfile() != M5BoardId(24).touchProfile() || board2.rtcKind() != M5BoardId(24).rtcKind() || board2.powerKind() != M5BoardId(24).powerKind()) return i32(2)
    val board3=m5StickS3()
