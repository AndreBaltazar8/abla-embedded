import "./unit-glass-wire-native.ab"
import "../src/display/unit_glass_owner_software.ab"
@export("abla_unit_glass_owner_wire_test")
trusted fun testGlassOwner(): i32 {
    wireSeed();extraAddress=61;extraCanRead=true;extraReadValue=90
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    val scratch=nativeBufferAt(oledMemory+1024,176)
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val bus=control.session().bus()
    var failure=0
    while (failure <= 12) {
        extraCount=0;glassWaited=0
        val before=ackCount
        if (unitGlassOpenOwned(bus,scratch,false).status() != 2 ||
            unitGlassOpenOwned(bus,nativeBufferAt(softwareI2cProviderState,32),true).status() != 2 || ackCount != before) return i32(2)
        nackAt=if (failure == 0) 0 else before+failure
        var owner=unitGlassOpenOwned(bus,scratch,true)
        val expected=if (failure == 0) 1 else if (failure <= 3) 4 else if (failure <= 6) 5 else if (failure <= 9) 8 else 6
        val original=if (failure == 0) 0 else expected
        if (owner.status() != expected || owner.openFailure() != original || owner.ready() != (failure == 0) ||
            !owner.device().valid() || ackCount-before != (if (failure == 0) 12 else failure) || bad) return i32(3)
        nackAt=0
        val handle=owner.device();val firmware=owner.firmware()
        if (failure == 0) {
            if (!owner.readKeyOwned(0,scratch,true).valid() || !owner.setBuzzerOwned(1000,128,false,scratch,true)) return i32(4)
        }
        val untouched=ackCount
        if (owner.closeOwned(scratch,false) != owner ||
            owner.closeOwned(nativeBufferAt(softwareI2cProviderState,32),true) != owner || ackCount != untouched) return i32(5)
        var fault=1
        while (fault <= 6) {
            nackAt=ackCount+fault
            owner=owner.closeOwned(scratch,true)
            if (owner.status() != (if (fault <= 3) 5 else 6) || owner.device() != handle || owner.openFailure() != original || owner.firmware() != firmware || bad) return i32(6)
            fault=fault+1
        }
        nackAt=0
        owner=owner.closeOwned(scratch,true)
        if (owner.status() != 0 || (owner.device()|0) != 0 || owner.openFailure() != original || owner.firmware() != firmware || !control.ready()) return i32(7)
        val closed=ackCount
        if (owner.closeOwned(scratch,true) != owner || owner.readKeyOwned(0,scratch,true).valid() || ackCount != closed) return i32(8)
        failure=failure+1
    }
    if (!softwareI2cProviderEnter()) return i32(9)
    val blocked=unitGlassOpenOwned(bus,scratch,true)
    if (!softwareI2cProviderLeave() || blocked.status() != 3 || (blocked.device()|0) != 0 || blocked.closeOwned(scratch,true).status() != 0) return i32(10)
    if (!control.closeOwned(true) || pads != 0 || bad) return i32(11)
    return i32(0)
}
