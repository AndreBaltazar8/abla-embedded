import "../src/m5stack/nesso_devices_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(112)
var owned=0
var failOpen=-1
var failClose=-1
var openCalls=0
var closeCalls=0
var bad=false
fun nessoDevicesStorageSafe(buffer: NativeBuffer): bool = true
fun nessoDevicesInitializeChildren(buffer: NativeBuffer): bool = true
fun nessoDevicesAdmission(buffer: NativeBuffer,bus: int,gate: PeripheralGate,owner: u32): bool = bus == 7 && gate == 16 && owner == u32(9)
fun checkReentry(): void {
    val devices=nessoDevicesAt(nativeBufferAt(storage,112))
    if (devices.ready() || devices.closeOwned(true) || devices.openOwned(7,PeripheralGate(16),u32(9),true) != 2) bad=true
    return
}
fun nessoDevicesOpenChild(buffer: NativeBuffer,child: int,bus: int,gate: PeripheralGate,owner: u32): bool {
    checkReentry()
    if (child != openCalls || owned != (1<<child)-1 || buffer.loadU32(8) != (1<<(child+1))-1) bad=true
    owned=owned|(1<<child);openCalls=openCalls+1;return child != failOpen
}
fun nessoDevicesCloseChild(buffer: NativeBuffer,child: int): bool {
    checkReentry()
    if (owned != (1<<(child+1))-1 || buffer.loadU32(8) != owned) bad=true
    closeCalls=closeCalls+1
    if (child == failClose) return false
    owned=owned&~(1<<child);return true
}
@export("abla_nesso_devices_test")
trusted fun testDevices(): i32 {
    val devices=nessoDevicesAt(nativeBufferAt(storage,112))
    var opening=-1
    while (opening < 4) {
        var closing=-1
        while (closing < 4) {
            owned=0;failOpen=opening;failClose=closing;openCalls=0;closeCalls=0;bad=false
            if (!devices.initialize() || devices.openOwned(7,PeripheralGate(16),u32(9),false) != 2 ||
                devices.openOwned(8,PeripheralGate(16),u32(9),true) != 2 || openCalls != 0) return i32(1)
            val expected=if (opening < 0) 1 else 11+opening
            if (devices.openOwned(7,PeripheralGate(16),u32(9),true) != expected || devices.ready() != (opening < 0) || bad) return i32(2)
            val highest=if (opening < 0) 3 else opening
            if (devices.pending() != (1<<(highest+1))-1 || openCalls != highest+1 || devices.closeOwned(false) || closeCalls != 0) return i32(3)
            val willFail=closing >= 0 && closing <= highest
            if (devices.closeOwned(true) == willFail || bad) return i32(4)
            if (willFail) {
                if (devices.failure() != 21+closing || devices.pending() != (1<<(closing+1))-1 || devices.phase() != 2) return i32(5)
                failClose=-1
                if (!devices.closeOwned(true)) return i32(6)
            }
            val closedCalls=closeCalls
            if (owned != 0 || devices.pending() != 0 || devices.phase() != 0 || !devices.closeOwned(true) || closeCalls != closedCalls || bad) return i32(7)
            closing=closing+1
        }
        opening=opening+1
    }
    if (nessoDevicesAt(nativeBufferAt(storage,111)) != 0 || nessoDevicesAt(nativeBufferAt(storage+1,112)) != 0) return i32(8)
    return i32(0)
}
