import "../src/esp32/i2s/clock_control_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var base = 0
var offset = 0
var source = 0
var divider = 0
var active = 0
var writes = 0
var reads = 0
var latch = false
var remaining = 0
var bad = false
trusted fun esp32s3I2sClockRead(address: int): int {
    reads = reads + 1
    if (address != base + 32 && address != base + 36) bad = true
    if (latch && writes != 0 && remaining > 0) { remaining = remaining - 1; return 256 }
    active
}
trusted fun esp32s3I2sClockField(address: int, mask: int, value: int): void {
    if (latch) {
        if (address != base + 32 + offset || mask != 256 || value != 256) bad = true
    } else if (writes == 0) {
        if (address != base + 48 + offset || mask != (3 << 27) || value != (source << 27)) bad = true
    } else if (writes == 1) {
        if (address != base + 40 + offset || mask != (63 << 7) || value != ((divider - 1) << 7)) bad = true
    } else bad = true
    writes = writes + 1
    return
}
trusted fun i2sControlTest(): int {
    var route = 0
    while (route < 4) {
        base = 0x6000f000 + (route / 2) * 0x1e000
        offset = (route & 1) * 4
        latch = false
        source = 0
        while (source < 4) {
            divider = 1
            while (divider <= 64) {
                writes = 0
                if (!esp32s3I2sSelectClock(route / 2, offset != 0, source, divider) || writes != 2 || bad) return 1
                divider = divider + 1
            }
            source = source + 1
        }
        latch = true
        var delay = 0
        while (delay <= 4) {
            remaining = delay
            reads = 0
            writes = 0
            if (esp32s3I2sLatchConfiguration(route / 2, offset != 0, 4) != (delay < 4) || writes != 1 || reads != 1 + (if (delay < 4) delay + 1 else 4) || bad) return 2
            delay = delay + 1
        }
        writes = 0
        active = 4
        if (esp32s3I2sSelectClock(route / 2, offset != 0, 2, 8) || esp32s3I2sLatchConfiguration(route / 2, offset != 0, 4) || writes != 0) return 3
        active = 256
        if (esp32s3I2sSelectClock(route / 2, offset != 0, 2, 8) || esp32s3I2sLatchConfiguration(route / 2, offset != 0, 4) || writes != 0) return 4
        active = 0
        route = route + 1
    }
    reads = 0
    writes = 0
    if (esp32s3I2sSelectClock(-1, false, 0, 1) || esp32s3I2sSelectClock(2, false, 0, 1) || esp32s3I2sSelectClock(0, false, 4, 1) || esp32s3I2sSelectClock(0, false, 0, 0) || esp32s3I2sSelectClock(0, false, 0, 65) || esp32s3I2sLatchConfiguration(0, false, 0) || reads != 0 || writes != 0) return 5
    0
}
#exportFunction("i2sControlTest", "abla_i2s_control_test")
