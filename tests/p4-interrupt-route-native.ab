import "../src/esp32/interrupt_route_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var value=u32(0)
var address=0
var reads=0
var writes=0
var drop=false
var bad=false
fun p4InterruptRouteRead(at: int): u32 { reads=reads+1; if (at != address) bad=true; return value }
fun p4InterruptRouteWrite(at: int,next: u32): void { writes=writes+1; if (at != address) bad=true; if (!drop) value=next; return }
@export("abla_p4_interrupt_route_test")
fun testRoute(): i32 {
    var layout=1
    while (layout <= 3) {
        var core=0
        while (core < 2) {
            var source=0
            while (source <= 135) {
                val valid=source <= 127 || (layout == 3 && source >= 133)
                address=0x500d6000+core*2048+source*4; reads=0; writes=0; value=u32(0xffffffc0)
                if (!valid) {
                    if (esp32P4InterruptRouteOwned(layout,core,source,0,16) != 2 || reads != 0 || writes != 0) return i32(1)
                } else {
                    var target=16
                    while (target <= 47) {
                        if (esp32P4InterruptRouteOwned(layout,core,source,0,target) != 1 || value != (u32(0xffffffc0)|u32(target)) ||
                            esp32P4InterruptRouteReadOwned(layout,core,source) != target ||
                            esp32P4InterruptRouteOwned(layout,core,source,0,17) != 3) return i32(2)
                        if (esp32P4InterruptRouteOwned(layout,core,source,target,0) != 1 || value != u32(0xffffffc0) || bad) return i32(3)
                        target=target+1
                    }
                }
                source=source+1
            }
            core=core+1
        }
        layout=layout+2
    }
    address=0x500d6000; value=u32(0); drop=true
    if (esp32P4InterruptRouteOwned(3,0,0,0,16) != 4) return i32(4)
    reads=0; writes=0
    if (esp32P4InterruptRouteOwned(3,0,0,0,15) != 2 || esp32P4InterruptRouteOwned(3,2,0,0,16) != 2 ||
        esp32P4InterruptRouteOwned(2,0,0,0,16) != 2 || reads != 0 || writes != 0) return i32(5)
    return i32(0)
}
