import "../src/esp32/i2c/timeout_logic.ab"

fun main(): int {
    if (esp32S3I2cTimeoutCycles(0, 240000000) != u32(0) ||
        esp32S3I2cTimeoutCycles(-1, 240000000) != u32(0) ||
        esp32S3I2cTimeoutCycles(1, 0) != u32(0)) return 1
    var clock = 1
    while (clock <= 4294967295) {
        var ms = 1
        while (ms <= 2147483647) {
            val exact = (ms * clock + 999) / 1000
            val expected = if (exact <= 2147483647) u32(exact) else u32(0)
            if (esp32S3I2cTimeoutCycles(ms, clock) != expected) return 2
            ms = ms * 5 + 1
        }
        clock = clock * 7 + 17
    }
    if (esp32S3I2cTimeoutCycles(8947, 240000000) != u32(2147280000)) return 3
    if (esp32S3I2cTimeoutCycles(8948, 240000000) != u32(0)) return 4
    if (esp32S3I2cTimeoutCycles(1, 999) != u32(1)) return 5
    if (esp32S3I2cTimeoutCycles(2147483647, 4294967295) != u32(0)) return 6
    0
}
