import "./cpu-clock-p4-native.ab"
import "./psram-speed-p4-native.ab"
import "./flash-speed-p4-native.ab"
import "../src/esp32/power/sleep_clocks_p4_sequence.ab"
val sleepClocksMemory=nativeStaticAllocate(292)
fun seedSleepClocks(profile: int,flags: int): NativeBuffer {
    fsPllStatus=0x3cc
    clockOrderEnabled=false
    seedCpuClock(profile);seedSpeed(if (profile < 3) 320 else 400,1);seedFlashSpeed(1)
    if (profile%3 == 2) { speedMapped=0x55030103;speedOldMapped=speedMapped }
    clockOrderEnabled=true;clockOrderFlash=(flags&1) != 0;clockOrderPsram=(flags&2) != 0
    clockOrderFlashLow=false;clockOrderPsramLow=false;clockOrderCpuRestored=true;clockOrderBad=false
    val r=nativeBufferAt(sleepClocksMemory,292)
    var i=0
    while (i < 288) { r.storeU32(i,0);i=i+4 }
    r.storeU32(288,0x1234abcd);return r
}
fun openSleepClocks(r: NativeBuffer,profile: int,flags: int): int = esp32p4SleepClocksOpenOwned(r,cpuRootMHz,if (profile%3 == 0) 0 else if (profile%3 == 1) 1 else 300,if (profile < 3) 320 else 400,(flags&1) != 0,(flags&2) != 0,3,true)
@export("abla_sleep_clocks_p4_test")
trusted fun sleepClocksTest(): i32 {
    var profile=0
    while (profile < 6) {
        var flags=0
        while (flags < 4) {
            val r=seedSleepClocks(profile,flags)
            if (openSleepClocks(r,profile,flags) != 1 || clockOrderCpuRestored || (cpllRoot&3) != 0 ||
                clockOrderFlashLow != ((flags&1) != 0) || clockOrderPsramLow != ((flags&2) != 0) || clockOrderBad) return i32(40)
            val count=fsWrites+speedWrites+cpuClockWrites+cpllWrites
            if (esp32p4SleepClocksRestoreOwned(r,3,false,true) != 2 || count != fsWrites+speedWrites+cpuClockWrites+cpllWrites) return i32(41)
            cpllDone=false;cpllPower=false;cpllGlobalGate=false
            if (esp32p4SleepClocksRestoreOwned(r,3,true,true) != 4 || r.loadU32(4) != 5 || cpllStarts != 1 || cpllStops != 0 || cpllPowerCommands != 2 || cpllPowerFences != 2 ||
                clockOrderCpuRestored || clockOrderBad) return i32(42)
            val held=fsWrites+speedWrites+cpuClockWrites+cpllWrites+cpllAnalogWrites+cpllPowerCommands
            cpllHart=u32(1-(profile&1))
            if (esp32p4SleepClocksContinueOwned(r,3,true) != 2 || held != fsWrites+speedWrites+cpuClockWrites+cpllWrites+cpllAnalogWrites+cpllPowerCommands) return i32(43)
            cpllHart=u32(profile&1);cpllDone=true
            if (esp32p4SleepClocksContinueOwned(r,3,true) != 5 || cpllStarts != 1 || cpllStops != 1 || cpllPowerCommands != 2 || cpuUpdates != 5 ||
                cpllRoot != cpuOldRoot || cpllDiv != cpuOldDiv || cpuMem != cpuOldMem || cpuApb != cpuOldApb ||
                !speedPadsMatch(false) || speedMapped != speedOldMapped || speedCommand != speedOldCommand || speedAxi != speedOldAxi ||
                !fsMemoryMatches(false) || !clockOrderCpuRestored || clockOrderBad || cpuBad || fsBad || speedBad || cpllBad || r.loadU32(288) != 0x1234abcd) return i32(44)
            val completed=fsWrites+speedWrites+cpuClockWrites+cpllWrites+cpllAnalogWrites
            if (esp32p4SleepClocksContinueOwned(r,3,true) != 5 || completed != fsWrites+speedWrites+cpuClockWrites+cpllWrites+cpllAnalogWrites) return i32(45)
            flags=flags+1
        }
        profile=profile+1
    }
    profile=6
    while (profile < 12) {
        val r=seedSleepClocks(profile,1)
        if (openSleepClocks(r,profile,1) != 1 || (cpllRoot&3) != 0 || (cpllDiv&0x1fffffe0) != 0) return i32(55)
        if (esp32p4SleepClocksRestoreOwned(r,3,true,true) != 5 || cpllStarts != 0 || cpllStops != 0 || cpllPowerCommands != 0 ||
            cpllRoot != cpuOldRoot || cpllDiv != cpuOldDiv || cpuMem != cpuOldMem || cpuApb != cpuOldApb || !fsMemoryMatches(false) || clockOrderBad) return i32(56)
        profile=profile+1
    }
    val noClock=seedSleepClocks(3,3);speedReady=false
    if (openSleepClocks(noClock,3,3) != 3 || noClock.loadU32(0) != 0 || fsWrites != 0 || speedWrites != 0 || cpuClockWrites != 0) return i32(57)
    val failed=seedSleepClocks(3,3);fsDrop=1
    if (openSleepClocks(failed,3,3) != 3 || failed.loadU32(4) != 1 || speedWrites != 0 || cpuClockWrites != 0) return i32(46)
    fsDrop=0
    if (esp32p4SleepClocksContinueOwned(failed,3,true) != 1) return i32(47)
    speedDrop=speedWrites+1
    if (esp32p4SleepClocksRestoreOwned(failed,3,true,true) != 3 || failed.loadU32(4) != 7 || !clockOrderCpuRestored || !clockOrderPsramLow || !clockOrderFlashLow) return i32(48)
    speedDrop=0;fsDrop=fsWrites+1
    if (esp32p4SleepClocksContinueOwned(failed,3,true) != 3 || failed.loadU32(4) != 8 || clockOrderPsramLow || !clockOrderFlashLow) return i32(49)
    fsDrop=0
    if (esp32p4SleepClocksContinueOwned(failed,3,true) != 5 || clockOrderBad || cpllStarts != 1 || cpllStops != 1 || cpuUpdates != 5) return i32(50)
    val pending=seedSleepClocks(3,3);fsStuck=1
    if (openSleepClocks(pending,3,3) != 4 || speedWrites != 0 || cpuClockWrites != 0) return i32(51)
    fsLatch();fsStuck=0;cpuStuckUpdate=1
    if (esp32p4SleepClocksContinueOwned(pending,3,true) != 4 || pending.loadU32(4) != 3 || !clockOrderFlashLow || !clockOrderPsramLow) return i32(52)
    cpuLatch();cpuStuckUpdate=0
    if (esp32p4SleepClocksRestoreOwned(pending,3,true,true) != 5 || clockOrderBad || fsUpdates != 2 || cpuUpdates != 5) return i32(53)
    val invalid=seedSleepClocks(5,3);speedMapped=0x55010001
    if (openSleepClocks(invalid,5,3) != 2 || invalid.loadU32(0) != 0 || fsWrites != 0 || speedWrites != 0 || cpuClockWrites != 0) return i32(54)
    var abortCase=0
    while (abortCase < 18) {
        val mode=abortCase%3;val r=seedSleepClocks(abortCase/3,3)
        if (mode == 0) fsReady=false
        // Corrupt encoding but preserve the divider: parent ratio checks
        // pass, then PSRAM preflight fails after flash has already opened.
        if (mode == 1) speedCommand=speedCommand^1
        if (mode == 2) cpuFrac=1
        if (openSleepClocks(r,abortCase/3,3) != 3) return i32(80+abortCase)
        if (r.loadU32(4) != mode+1 || cpuClockWrites != 0) return i32(100+abortCase)
        val psramBefore=speedWrites
        if (esp32p4SleepClocksRestoreOwned(r,3,true,true) != 5 || r.loadU32(4) != 9 ||
            cpuClockWrites != 0 || cpllStarts != 0 || cpllPowerCommands != 0 ||
            (mode < 2 && speedWrites != psramBefore) || (mode == 0 && fsWrites != 0) ||
            (mode != 0 && !fsMemoryMatches(false)) ||
            (mode == 2 && (!speedPadsMatch(false) || speedMapped != speedOldMapped || speedCommand != speedOldCommand || speedAxi != speedOldAxi)) ||
            clockOrderBad || fsBad || speedBad || cpuBad || r.loadU32(288) != 0x1234abcd) return i32(59)
        abortCase=abortCase+1
    }
    // Partial flash ownership: do not acquire PSRAM or CPU while unwinding.
    val partial=seedSleepClocks(3,3);fsDrop=1
    if (openSleepClocks(partial,3,3) != 3) return i32(60)
    fsDrop=0
    if (esp32p4SleepClocksRestoreOwned(partial,3,true,true) != 5 || !fsMemoryMatches(false) ||
        speedWrites != 0 || cpuClockWrites != 0 || cpllStarts != 0 || clockOrderBad) return i32(61)
    var missing=0
    while (missing < 4) {
        val r=seedSleepClocks(3,3)
        if (openSleepClocks(r,3,3) != 1) return i32(62)
        fsPllStatus=0x3cc&(~(if (missing == 0) 256 else if (missing == 1) 512 else if (missing == 2) 64 else 128))
        val psramWrites=speedWrites;val flashWrites=fsWrites
        if (esp32p4SleepClocksRestoreOwned(r,3,true,true) != 3 ||
            r.loadU32(4) != (if (missing < 2) 7 else 8) || r.loadU32(12) != (if (missing < 2) 21 else 20) ||
            (missing < 2 && speedWrites != psramWrites) || fsWrites != flashWrites) return i32(63)
        fsPllStatus=0x3cc
        if (esp32p4SleepClocksContinueOwned(r,3,true) != 5 || !fsMemoryMatches(false) ||
            !speedPadsMatch(false) || clockOrderBad || cpuBad || fsBad || speedBad) return i32(64)
        missing=missing+1
    }
    clockOrderEnabled=false;return i32(0)
}
