import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "../src/rtc/powerhub_device.ab"
import "../src/m5stack/rtc_device.ab"
import "../src/i2c/results.ab"
import "abla/runtime/scalar"
import "abla/unsafe/native"
import "abla/build"
type I2cBus = int
type I2cDevice = int
var model=0
var dateMode=false
var fail=false
var calls=0
var bad=false
var reading=false
var malformed=false
var allocated=0
var lastAddress=0
var closed=0
var statusMode=false
var statusRegister=0
var statusValue=0
var calendarMode=false
var fullMode=false
fun fullByte(index: int): int {
    if (index == 0) return if (model == 2) 59 else 89
    if (index == 1) return if (model == 2) 58 else 88
    if (index == 2) return if (model == 2) 23 else 35
    if (index == 3) return if (model == 0) 49 else if (model == 1) 64 else 31
    if (index == 4) return if (model == 0) 6 else if (model == 1) 49 else 12
    if (index == 5) return if (model == 2) 26 else 18
    if (model == 2) 40 else 38
}
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice {
    if (frequency != 400000) bad=true
    allocated=allocated+1; lastAddress=address; I2cDevice(1)
}
fun I2cDevice.close(): bool { closed=closed+1; true }
fun I2cDevice.readRegister8(register: int): int { bad=true; return 0 }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    calls=calls+1
    if (!statusMode || register != statusRegister) bad=true
    I2cByteResult(if (fail) 0 else 256 | statusValue)
}
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
trusted fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,count: int): bool {
    if (fullMode) {
        calls=calls+1
        if (register != (if (model == 0) 2 else if (model == 1) 16 else 192) || count != 7) bad=true
        var i=0
        while (i < 7) { buffer.store(i,fullByte(i)); i=i+1 }
        if (malformed) buffer.store(0,127)
        return !fail
    }
    if (!reading) { bad=true; return false }
    val start=if (model == 0) 2 else if (model == 1) 16 else 192
    if (register != start+(if (dateMode) 3 else 0) || count != (if (dateMode) 4 else 3)) bad=true
    calls=calls+1
    if (dateMode) {
        buffer.store(0,if (model == 0) 49 else if (model == 1) 64 else 31)
        buffer.store(1,if (model == 0) 6 else if (model == 1) 49 else 12)
        buffer.store(2,if (model == 0) 146 else if (model == 1) 18 else 26)
        buffer.store(3,if (model == 0) 153 else if (model == 1) 38 else powerHubWeekdayValue(6))
    } else {
        buffer.store(0,if (model == 2) 59 else 89); buffer.store(1,if (model == 2) 58 else 88)
        buffer.store(2,if (model == 2) 23 else 35)
    }
    if (malformed) buffer.store(0,if (dateMode) 0 else 127)
    !fail
}
trusted fun I2cDevice.writeRegister(register: int,buffer: NativeBuffer,count: int): bool {
    calls=calls+1
    if (fullMode) {
        if (register != (if (model == 0) 2 else if (model == 1) 16 else 192) || count != 7) bad=true
        var i=0
        while (i < 7) { if (buffer.load(i) != fullByte(i)) bad=true; i=i+1 }
        return !fail
    }
    if (calendarMode) {
        if (count != 4 || register != (if (model == 0) 5 else if (model == 1) 19 else 195)) bad=true
        return true
    }
    val start=if (model == 0) 2 else if (model == 1) 16 else 192
    if (register != start+(if (dateMode) 3 else 0) || count != (if (dateMode) 4 else 3)) bad=true
    if (dateMode) {
        val a=if (model == 0) 49 else if (model == 1) 64 else 31
        val b=if (model == 0) 6 else if (model == 1) 49 else 12
        val c=if (model == 0) 146 else if (model == 1) 18 else 26
        val d=if (model == 0) 153 else if (model == 1) 38 else powerHubWeekdayValue(6)
        if (buffer.load(0) != a || buffer.load(1) != b || buffer.load(2) != c || buffer.load(3) != d) bad=true
    } else if (buffer.load(0) != (if (model == 2) 59 else 89) ||
        buffer.load(1) != (if (model == 2) 58 else 88) || buffer.load(2) != (if (model == 2) 23 else 35)) bad=true
    !fail
}
@export("abla_rtc_partial_test")
trusted fun partialTest(): i32 {
    val scratch=nativeBufferAt(nativeStaticAllocate(4),4)
    while (model < 3) {
        var profile=0
        while (profile < 4) {
            dateMode=(profile & 1) != 0; fail=(profile & 2) != 0; calls=0; bad=false
            val date=rtcDate(if (model == 0) 1999 else 2026,12,31,6)
            val time=rtcTime(23,58,59)
            val rtc=M5Rtc(((model+1)<<32)|1)
            val result=if (dateMode) rtc.setDateWithBuffer(date,scratch) else rtc.setTimeWithBuffer(time,scratch)
            if (result == fail || bad || calls != 1) return i32(1)
            calls=0
            if (Pcf8563(1).setDateWithBuffer(date,nativeBufferAt(scratch.addressValue(),3)) ||
                Rx8130(1).setTimeWithBuffer(time,nativeBufferAt(scratch.addressValue(),2)) ||
                PowerHubRtc(1).setTimeWithBuffer(time,nativeBufferAt(0,3)) || calls != 0) return i32(4)
            if (Pcf8563(1).setDate(RtcDate(-1)) || Rx8130(1).setTime(RtcTime(-1)) ||
                PowerHubRtc(1).setDate(rtcDate(2128,1,1,0)) || Pcf8563(0).setTime(time) ||
                Rx8130(1).setDate(rtcDate(1999,1,1,0)) || calls != 0) return i32(2)
            profile=profile+1
        }
        model=model+1
    }
    reading=true; model=0
    while (model < 3) {
        var profile=0
        while (profile < 8) {
            dateMode=(profile & 1) != 0; fail=(profile & 2) != 0; malformed=(profile & 4) != 0; calls=0; bad=false
            if (dateMode) {
                val date=if (model == 0) Pcf8563(1).dateWithBuffer(scratch) else if (model == 1) Rx8130(1).dateWithBuffer(scratch) else PowerHubRtc(1).dateWithBuffer(scratch)
                if (date.valid() != (!fail && !malformed)) return i32(5)
                if (date.valid() && (date.year() != (if (model == 0) 1999 else 2026) || date.month() != 12 || date.day() != 31 || date.weekday() != 6)) return i32(6)
            } else {
                val time=if (model == 0) Pcf8563(1).timeWithBuffer(scratch) else if (model == 1) Rx8130(1).timeWithBuffer(scratch) else PowerHubRtc(1).timeWithBuffer(scratch)
                if (time.valid() != (!fail && !malformed)) return i32(7)
                if (time.valid() && (time.hour() != 23 || time.minute() != 58 || time.second() != 59)) return i32(8)
            }
            if (calls != 1 || bad) return i32(9)
            calls=0
            if (Pcf8563(0).dateWithBuffer(scratch).valid() || Rx8130(1).timeWithBuffer(nativeBufferAt(0,3)).valid() ||
                PowerHubRtc(1).dateWithBuffer(nativeBufferAt(scratch.addressValue(),3)).valid() || calls != 0) return i32(10)
            profile=profile+1
        }
        model=model+1
    }
    val full=rtcDateTime(2026,9,7,1,12,34,56)
    statusMode=true; model=0
    while (model < 3) {
        val rtc=M5Rtc(((model+1)<<32) | 1)
        statusValue=0
        while (statusValue < 256) {
            var failure=0
            while (failure < 2) {
                fail=failure == 1; bad=false; calls=0
                statusRegister=if (model == 1) 29 else 2
                val voltage=rtc.lowVoltageChecked()
                if (voltage.valid() == fail || (!fail && voltage.value() != (if ((statusValue & 128) != 0) 1 else 0)) || calls != 1 || bad) return i32(14)
                calls=0; statusRegister=if (model == 0) 1 else 29
                val irq=rtc.interruptPendingChecked()
                if (model == 2) {
                    if (rtc.supportsInterruptStatus() || irq.valid() || calls != 0) return i32(15)
                } else if (!rtc.supportsInterruptStatus() || irq.valid() == fail ||
                    (!fail && irq.value() != (if ((statusValue & (if (model == 0) 12 else 24)) != 0) 1 else 0)) || calls != 1 || bad) return i32(16)
                failure=failure+1
            }
            statusValue=statusValue+1
        }
        model=model+1
    }
    statusMode=false
    model=0
    while (model < 3) {
        allocated=0; closed=0; bad=false
        val board=if (model == 0) m5BoardStackCore2 else if (model == 1) m5BoardTab5 else m5BoardPowerHub
        val rtc=m5Rtc(I2cBus(1),board)
        if (!rtc.valid() || rtc.kind() != board.rtcKind() || rtc.handle() != 1 || allocated != 1 ||
            lastAddress != (if (model == 0) 81 else if (model == 1) 50 else 80) || bad) return i32(11)
        if (!rtc.close() || closed != 1 || m5Rtc(I2cBus(0),board).valid() || allocated != 1) return i32(12)
        if (M5Rtc(1).valid() || M5Rtc(-1).valid() || M5Rtc((4<<32) | 1).valid() ||
            M5Rtc(0).close() || M5Rtc(0).begin() || M5Rtc(0).dateTime().valid() || closed != 1) return i32(13)
        model=model+1
    }
    if (!full.date().valid() || full.date().year() != 2026 || !full.time().valid() || full.time().second() != 56 ||
        RtcDateTime(0).date().valid() || RtcDateTime(0).time().valid() || rtcTime(24,0,0).valid() || rtcDate(2026,13,1,0).valid()) return i32(3)
    fullMode=true; malformed=false; model=0
    val fullScratch=nativeBufferAt(nativeStaticAllocate(7),7)
    val fullExpected=rtcDateTime(2026,12,31,6,23,58,59)
    while (model < 3) {
        val rtc=M5Rtc(((model+1)<<32)|1)
        var attempt=0
        while (attempt < 2) {
            fail=attempt == 1; calls=0; bad=false
            if (rtc.setDateTimeWithBuffer(fullExpected,fullScratch) == fail || bad || calls != 1) return i32(19)
            calls=0
            val read=rtc.dateTimeWithBuffer(fullScratch)
            if (read != (if (fail) RtcDateTime(0) else fullExpected) || bad || calls != 1) return i32(20)
            attempt=attempt+1
        }
        fail=false; malformed=true; calls=0
        if (rtc.dateTimeWithBuffer(fullScratch).valid() || calls != 1) return i32(21)
        malformed=false; calls=0
        val short=nativeBufferAt(fullScratch.addressValue(),6)
        if (rtc.setDateTimeWithBuffer(fullExpected,short) || rtc.dateTimeWithBuffer(short).valid() ||
            rtc.dateTimeWithBuffer(nativeBufferAt(0,7)).valid() ||
            M5Rtc(0).dateTimeWithBuffer(fullScratch).valid() ||
            M5Rtc(0).setDateTimeWithBuffer(fullExpected,fullScratch) || calls != 0) return i32(22)
        model=model+1
    }
    fullMode=false; calendarMode=true; fail=false
    model=0
    while (model < 3) {
        var sample=0
        while (sample < 7) {
            val year=if (sample == 0) 1900 else if (sample == 1) 2000 else if (sample == 2) 2023 else if (sample == 3) 2024 else if (sample == 4) 2099 else if (sample == 5) 2100 else 2127
            var month=1
            while (month <= 12) {
                var day=28
                while (day <= 31) {
                    calls=0; bad=false; scratch.storeU32(0,0xdeadbeef)
                    val date=rtcDate(year,month,day,0)
                    // Independent table oracle; do not reuse the validator under test.
                    val leap=year == 2000 || year == 2024
                    val days=if (month == 2) (if (leap) 29 else 28) else if (month == 4 || month == 6 || month == 9 || month == 11) 30 else 31
                    val expected=day <= days && year >= (if (model == 0) 1900 else 2000) && year <= (if (model == 2) 2127 else 2099)
                    val written=if (model == 0) Pcf8563(1).setDateWithBuffer(date,scratch) else if (model == 1) Rx8130(1).setDateWithBuffer(date,scratch) else PowerHubRtc(1).setDateWithBuffer(date,scratch)
                    if (written != expected || calls != (if (expected) 1 else 0) || bad || (!expected && scratch.loadU32(0) != 0xdeadbeef)) return i32(17)
                    if (!expected) {
                        val fullDate=rtcDateTime(year,month,day,0,12,34,56)
                        val fullWrite=if (model == 0) Pcf8563(1).setDateTime(fullDate) else if (model == 1) Rx8130(1).setDateTime(fullDate) else PowerHubRtc(1).setDateTime(fullDate)
                        if (fullWrite || calls != 0) return i32(18)
                    }
                    day=day+1
                }
                month=month+1
            }
            sample=sample+1
        }
        model=model+1
    }
    i32(0)
}
