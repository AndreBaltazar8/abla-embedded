import "../src/esp32/i2c_esp32s3.ab"
import "../src/imu/bmi270_snapshot.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_bmi270_frame_target")
trusted fun frameTarget(device: I2cDevice,frame: NativeBuffer,snapshot: ImuSnapshot,sensor: int,micros: int): ImuAxes {
    val fresh=snapshot.updateBmi270(device,frame,micros)
    if (sensor < 0 || sensor > 2 || fresh <= 0 || (fresh & (1<<sensor)) == 0) return invalidImuAxes()
    snapshot.axes(sensor)
}
