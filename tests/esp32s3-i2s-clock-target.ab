import "../src/esp32/i2s/clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun i2sClockTarget(port: i32, transmit: bool, integer: i32, numerator: i32, denominator: i32): bool =
    esp32s3I2sSetDivider(int(port), transmit, int(integer), int(numerator), int(denominator))
