import "../src/esp32/i2c/hardware_provider_p4.ab"
import "../src/m5stack/tab5_touch_probe.ab"
import "../src/m5stack/tab5_touch_profile.ab"
import "../src/esp32/i2c/hardware_prepared_scan_p4.ab"
import "../src/esp32/i2c/hardware_scan_p4.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(72)
val chip=nativeStaticAllocate(256)
var transfers=0
var failedTransfer=0
var bad=false
trusted fun p4I2cSessionClockOpen(port: int,source: int): int { bad=true;return 0 }
trusted fun p4I2cSessionInitialize(port: int,filter: int): int { bad=true;return 0 }
trusted fun p4I2cSessionPinsOpen(r: NativeBuffer,port: int,sda: int,scl: int,pullup: bool,layout: int): int { bad=true;return 0 }
trusted fun p4I2cSessionClockClose(token: int): int = 4102
trusted fun p4I2cSessionPinsClose(r: NativeBuffer): int = 2
trusted fun p4I2cSessionTiming(port: int,t: P4I2cTiming): int {
    if (port != 0 || t != esp32p4I2cTiming(u32(40000000),u32(100000))) bad=true
    return 1
}
trusted fun p4I2cSessionTransfer(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    transfers=transfers+1
    if (p4HardwareLoad(0) != 1 || port != 0 || address != 85 || prefix != -1 || written != 2 ||
         budget != u32(400000000)) { bad=true;return 7 }
    if (transfers == failedTransfer) return wireFailure
    val regs=nativeBufferAt(chip,256)
    val register=(output.load(0)<<8)|output.load(1)
    if (register+read > 256) { bad=true;return 7 }
    var i=0
    while (i < read) { input.store(i,regs.load(register+i));i=i+1 }
    return 1
}
trusted fun seed(): void {
    val r=nativeBufferAt(storage,72);val regs=nativeBufferAt(chip,256)
    var i=0
    while (i < 72) { r.storeU32(i,0);i=i+4 }
    i=0
    while (i < 256) { regs.store(i,0);i=i+1 }
    r.storeU32(0,0x49324234);r.storeU32(4,1);r.storeU32(16,4097);r.storeU32(24,3)
    regs.store(0,3)
    transfers=0;failedTransfer=0;bad=false;return
}
var wireFailure=3
var probeResult=1
var recoveryResult=1
var recoveries=0
var probes=0
var ready=true
trusted fun p4HardwareProbeReady(r: NativeBuffer): bool {
    if (p4HardwareLoad(0) != 1 || r.loadU32(4) != 1) bad=true
    return ready
}
trusted fun p4HardwareProbe(port: int,address: int,budget: u32): int {
    if (p4HardwareLoad(0) != 1 || address != 20 || budget != u32(20000000)) bad=true
    probes=probes+1;return probeResult
}
trusted fun p4HardwareRecover(r: NativeBuffer,budget: u32,stopAfterNack: bool): int {
    if (p4HardwareLoad(0) != 1 || r.loadU32(4) != 2 || r.loadU32(8) != 3 ||
        !stopAfterNack || budget != u32(20000000)) bad=true
    recoveries=recoveries+1;return recoveryResult
}
@export("abla_p4_hardware_touch_probe_test")
trusted fun test(): i32 {
    var boardIndex=0
    while (boardIndex < 2) {
        val board=if (boardIndex == 0) m5BoardTab5 else m5BoardTab5X
        var scenario=0
        while (scenario < 11) {
            seed();recoveries=0;probes=0;ready=scenario != 10
            wireFailure=if (scenario == 5) 4 else if (scenario == 6) 5 else if (scenario == 7) 6 else 3
            recoveryResult=if (scenario == 8) 4 else 1
            probeResult=if (scenario == 4) 9 else if (scenario == 9) 3 else 1
            nativeBufferAt(chip,256).store(0,if (scenario == 0) 1 else if (scenario == 1) 3 else 7)
            if (scenario >= 3) failedTransfer=1
            val bus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
            val st=st7123(bus,85,100000)
            val result=board.probeTab5Touch(bus,st)
            val expected=if (scenario == 0) 1 else if (scenario == 1) 2 else if (scenario == 2) 4 else
                if (scenario == 3) 3 else if (scenario == 4) 5 else 6
            if (result.status() != expected || bad) return i32(1)
            if (scenario < 3 && (probes != 0 || recoveries != 0 || result.firmware() != (if (scenario == 0) 1 else if (scenario == 1) 3 else 7))) return i32(2)
            if (scenario == 3 && (board.touchProfileFromProbe(result).valid() || !board.touchProfileFromProbe(result,true).valid())) return i32(3)
            if (scenario == 5 || scenario == 6 || scenario == 7 || scenario == 10) {
                if (recoveries != 0 || probes != 0) return i32(4)
            }
            if (scenario == 8) {
                val old=recoveries
                if (bus.prepareProbeStatus() != 3 || recoveries != old || probes != 0 ||
                    nativeBufferAt(storage,72).loadU32(8) != 3 || nativeBufferAt(storage,72).loadU32(12) != 4) return i32(5)
            }
            if (!st.close() || !bus.close() || bad) return i32(6)
            scenario=scenario+1
        }
        boardIndex=boardIndex+1
    }
    return i32(0)
}
