import "../src/esp32/scheduler_tick_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var period=1024
var owner=0
var cycle=0
var delay=0
var compares=0
var requests=0
var programmed=0
var saved=0
var bad=false
fun esp32S3SchedulerTickCore(): int = core
fun esp32S3SchedulerTickRead(address: int): int {
    if (address == 0x3FC90000) return period
    if (address == 0x3FC90004) return 0x3FC90100
    if (address == 0x3FC90008 || address == 0x3FC90128) return owner
    bad=true; return 0
}
fun esp32S3SchedulerTickWrite(address: int,value: int): void {
    if (address != 0x3FC9000C) bad=true
    saved=value; return
}
fun esp32S3SchedulerTickCount(): int = cycle
fun esp32S3SchedulerTickCompare(deadline: int): void {
    compares=compares+1; programmed=deadline
    cycle=(cycle+(if (compares == 1) delay else 1)) & 0xFFFFFFFF
    return
}
fun esp32S3SchedulerTickRequest(context: NativeBuffer): bool {
    if (context.addressValue() != 0x3FC90100 || saved != programmed || ((programmed-cycle) & 0xFFFFFFFF) >= 0x80000000 || programmed == cycle) bad=true
    requests=requests+1; true
}
@export("abla_scheduler_tick_test")
fun tickTest(): i32 {
    val record=nativeBufferAt(0x3FC90000,16)
    var profile=0
    while (profile < 256) {
        core=profile & 1; owner=core; period=1024+(profile/2)*257
        cycle=if ((profile & 2) == 0) 12345 else 0xFFFFFF00
        delay=if ((profile & 4) == 0) 1 else period+100
        compares=0; requests=0; bad=false
        if (!esp32S3SchedulerTickOwned(record) || bad || requests != 1 || compares != (if (delay == 1) 1 else 2)) return i32(1)
        compares=0; requests=0; owner=core ^ 1
        if (esp32S3SchedulerTickOwned(record) || compares != 0 || requests != 0) return i32(2)
        owner=core; period=1023
        if (esp32S3SchedulerTickOwned(record) || compares != 0) return i32(3)
        period=0x40000000
        if (esp32S3SchedulerTickOwned(record) || compares != 0) return i32(4)
        profile=profile+1
    }
    i32(0)
}
