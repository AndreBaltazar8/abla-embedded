import "../src/m5stack/pm1_control_bus_s3.ab"
import "abla/runtime/scalar"
import "abla/build"
val first=nativeStaticAllocate(36)
val second=nativeStaticAllocate(36)
val epochs=nativeStaticU32s([1,1073741823,1073741824,2147483647])
@export("abla_pm1_control_bus_s3_test")
trusted fun test(): i32 {
    var route=0
    while (route < 3) {
        val board=if (route == 0) m5BoardChainCaptain else if (route == 1) m5BoardPaperMono else m5BoardStopWatch
        val pins=board.i2cPins()
        var port=0
        while (port < 2) {
            val state=nativeBufferAt(if (port == 0) first else second,36)
            val other=nativeBufferAt(if (port == 0) second else first,36)
            var epochIndex=0
            while (epochIndex < 4) {
                val epoch=nativeAddressLoadU32(epochs,epochIndex*4)
                val key=esp32S3I2cBusKey(port,epoch)
                var offset=0
                while (offset < 36) { state.storeU32(offset,0);other.storeU32(offset,4294967295);offset=offset+4 }
                state.storeU32(4,epoch);state.storeU32(8,1)
                state.storeU32(12,pins.internalData());state.storeU32(16,pins.internalClock())
                if (!pm1ControlS3BusReady(key,board,first,second)) return i32(1)
                var field=0
                while (field < 5) {
                    val saved=state.loadU32(field*4)
                    state.storeU32(field*4,saved+1)
                    if (pm1ControlS3BusReady(key,board,first,second)) return i32(2)
                    state.storeU32(field*4,saved)
                    field=field+1
                }
                state.storeU32(0,2147483648)
                if (pm1ControlS3BusReady(key,board,first,second)) return i32(3)
                state.storeU32(0,2147483649)
                if (pm1ControlS3BusReady(key,board,first,second)) return i32(4)
                state.storeU32(0,0)
                if (pm1ControlS3BusReady(key,board,second,first) ||
                    pm1ControlS3BusReady(key,m5BoardCoreP4X,first,second) ||
                    pm1ControlS3BusReady(key,board,0,0) ||
                    pm1ControlS3BusReady(key,board,first+1,second+1)) return i32(5)
                epochIndex=epochIndex+1
            }
            port=port+1
        }
        route=route+1
    }
    if (pm1ControlS3BusReady(0,m5BoardChainCaptain,0,0) ||
        pm1ControlS3BusReady(-1,m5BoardChainCaptain,0,0) ||
        pm1ControlS3BusReady(3,m5BoardChainCaptain,0,0) ||
        pm1ControlS3BusReady(8589934593,m5BoardChainCaptain,0,0)) return i32(6)
    return i32(0)
}
