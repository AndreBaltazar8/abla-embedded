import "../src/m5stack/display_map.ab"
import "../src/peripheral_gate.ab"
import "../src/spi/pins.ab"
import "../src/spi/transaction_result.ab"
import "../src/m5stack/cores3_spi_hardware_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"

type Pin = int
val storage = nativeStaticMutableU32s([0])
var operations = 0
var bad = false
var resultDetail = 1
var loseOwnership = false
var pinFault=0
trusted fun Pin.outputLevelOwned(high: bool): bool {
    if (!high || this != (if (operations == 0) 3 else 4)) bad=true
    record(if (this == 3) 0 else 1)
    if (this == 4) operations=4
    return this != pinFault
}
trusted fun record(expected: int): void {
    if (operations != expected || nativeAddressLoadU32(storage,0) != 7) bad = true
    operations = operations + 1
    return
}
trusted fun Pin.write(high: bool): void {
    if (!high || (operations == 0 && this != 3) || (operations == 1 && this != 4)) bad = true
    record(if (this == 3) 0 else 1)
    return
}
trusted fun Pin.setOpenDrain(enabled: bool): void {
    if (this != 4 || enabled) bad = true
    record(2)
    return
}
trusted fun Pin.output(): void {
    if (this != 4) bad = true
    record(3)
    return
}
trusted fun esp32s3SpiInitializeMasterOwned(peripheral: int, pins: SpiPins,
    select: Pin, source: int, pre: int, cycles: int, mode: int,
    owner: u32, polls: int): int {
    record(4)
    if (peripheral != 2 || pins.mosiPin() != 37 || pins.misoPin() != 35 ||
        pins.clockPin() != 36 || select != 3 || source != 1 || pre != 1 ||
        cycles != 2 || mode != 0 || owner != u32(7) || polls != 100000) bad = true
    if (loseOwnership) nativeAddressStoreU32(storage,0,u32(9))
    resultDetail
}
@export("abla_cores3_hardware_spi_test")
trusted fun main(): i32 {
    val gate = peripheralGateAt(storage)
    pinFault=3
    while (pinFault <= 4) {
        operations=0;nativeAddressStoreU32(storage,0,0)
        val failed=m5BoardStackCoreS3.configureCoreS3HardwareSpi(gate,u32(7))
        if (failed.status() != 6 || failed.value() != u32(pinFault+6) || bad ||
            operations != (if (pinFault == 3) 1 else 4) ||
            nativeAddressLoadU32(storage,0) != 0x80000000) return i32(10)
        pinFault=pinFault+1
    }
    pinFault=0
    var variant = 0
    while (variant < 2) {
        val board = if (variant == 0) m5BoardStackCoreS3 else m5BoardStackCoreS3SE
        resultDetail = 1
        while (resultDetail <= 8) {
            operations = 0
            nativeAddressStoreU32(storage,0,u32(0))
            val result = board.configureCoreS3HardwareSpi(gate,u32(7))
            if (result.status() != (if (resultDetail == 1) 1 else 6) ||
                result.value() != u32(resultDetail) || operations != 5 || bad) return i32(1)
            if (nativeAddressLoadU32(storage,0) !=
                (if (resultDetail == 1) u32(0) else u32(0x80000000))) return i32(2)
            resultDetail = resultDetail + 1
        }
        variant = variant + 1
    }
    operations = 0
    if (m5BoardStack.configureCoreS3HardwareSpi(gate,u32(7)).status() != 3 || operations != 0) return i32(3)
    if (m5BoardStackCoreS3.configureCoreS3HardwareSpi(gate,u32(7)).status() != 4 || operations != 0) return i32(4)
    nativeAddressStoreU32(storage,0,u32(9))
    if (m5BoardStackCoreS3.configureCoreS3HardwareSpi(gate,u32(7)).status() != 2 || operations != 0) return i32(5)
    nativeAddressStoreU32(storage,0,u32(0))
    if (m5BoardStackCoreS3.configureCoreS3HardwareSpi(gate,u32(0)).status() != 3 || operations != 0) return i32(6)
    if (m5BoardStackCoreS3.configureCoreS3HardwareSpi(peripheralGateAt(0),u32(7)).status() != 3 || operations != 0) return i32(7)
    // Preserve the full nested routing detail, not just its low byte.
    resultDetail = 8 | (5 << 8)
    val routing = m5BoardStackCoreS3.configureCoreS3HardwareSpi(gate,u32(7))
    if (routing.status() != 6 || routing.value() != u32(resultDetail) || operations != 5 || bad) return i32(8)
    nativeAddressStoreU32(storage,0,u32(0))
    operations = 0
    loseOwnership = true
    resultDetail = 1
    val lost = m5BoardStackCoreS3.configureCoreS3HardwareSpi(gate,u32(7))
    if (lost.status() != 5 || lost.value() != u32(1) || nativeAddressLoadU32(storage,0) != 9 || operations != 5 || bad) return i32(9)
    i32(0)
}
