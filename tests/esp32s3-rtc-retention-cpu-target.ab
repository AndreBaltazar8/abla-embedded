import "../src/esp32/rtc_retention_cpu_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_retention_cpu_target")
@section(".iram1.abla.s3RtcRetentionCpuTarget")
trusted fun retentionCpuTarget(storage: NativeBuffer,enable: bool,i: bool,d: bool,small: bool): bool {
    if (enable) return esp32S3CpuRetentionEnableOwned(storage,d,small)
    esp32S3CpuRetentionDisableOwned(i,d)
}
