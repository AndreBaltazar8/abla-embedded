import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/expander_open.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_expander_open_target")
trusted fun openTarget(board: M5BoardId,bus: I2cBus,index: int,previous: M5ExpanderOpen,release: bool): M5ExpanderOpen =
    if (release) previous.release() else board.openExpander(bus,index)
