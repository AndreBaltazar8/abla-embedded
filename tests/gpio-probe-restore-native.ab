import "../src/esp32/gpio_probe_restore_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var mode=7
var level=0
var pull=0
var drive=0
var step=0
var failure=-1
var bad=false
fun reset(): void { mode=7; level=0; pull=0; drive=0; step=0; failure=-1; bad=false; return }
fun operation(pin: int): bool {
    if (pin != 18) bad=true
    val n=step; step=step+1; n != failure
}
fun gpio_set_direction(pin: int,value: int): int {
    if (!operation(pin)) return 258
    if (step == 1 && value != 0) bad=true
    mode=value; 0
}
fun gpio_set_level(pin: int,value: int): int {
    if ((mode&2) != 0) bad=true
    if (!operation(pin)) return 258
    level=value; 0
}
fun gpio_set_pull_mode(pin: int,value: int): int {
    if ((mode&2) != 0) bad=true
    if (!operation(pin)) return 258
    pull=value; 0
}
fun gpio_set_drive_capability(pin: int,value: int): int {
    if ((mode&2) != 0) bad=true
    if (!operation(pin)) return 258
    drive=value; 0
}
@export("abla_gpio_probe_restore_test")
fun test(): i32 {
    var bits=0
    while (bits < 256) {
        val state=GpioProbePinState(1|(bits<<1))
        val expectedMode=((bits>>2)&1)|(((bits>>3)&1)<<1)|(((bits>>4)&1)<<2)
        var fault=-1
        while (fault < 5) {
            reset(); failure=fault
            val result=state.restore(18)
            if (bad || result != (fault == -1)) return i32(1)
            if (fault >= 1 && mode != 0) return i32(2)
            if (fault >= 0) {
                failure=-1; step=0
                if (!state.restore(18) || bad) return i32(3)
            }
            if (mode != expectedMode || drive != ((bits>>5)&3) || level != ((bits>>7)&1)) return i32(4)
            val expectedPull=if ((bits&3) == 3) 2 else if ((bits&2) != 0) 1 else if ((bits&1) != 0) 0 else 3
            if (pull != expectedPull) return i32(5)
            fault=fault+1
        }
        bits=bits+1
    }
    reset()
    if (GpioProbePinState(0).restore(18) || step != 0) return i32(6)
    i32(0)
}
