import "../src/esp32/power/wake_trigger_p4_sequence.ab"
var reg=u32(0)
var writes=0
var drop=false
trusted fun p4WakeTriggerRead(): u32 = reg
trusted fun p4WakeTriggerWrite(value: u32): void {
    writes=writes+1;if (!drop) reg=value;return
}
@export("abla_wake_trigger_p4_test")
trusted fun test(): i32 {
    if (esp32p4WakeTriggerExt1() != u32(4096) || esp32p4WakeTriggerTimer() != u32(8192) ||
        esp32p4WakeTriggerTimer1() != u32(262144)) return i32(1)
    var bit=0
    while (bit < 31) {
        val original=u32(0x80000000)|(u32(1)<<u32(bit))
        reg=original;writes=0;drop=true
        var owner=esp32p4WakeTriggerParkOwned(true)
        if (owner.status() != 3 || !owner.hasSnapshot() || reg != original) return i32(2)
        drop=false;owner=owner.parkOwned(true)
        if (owner.status() != 5 || reg != u32(0x80000000)) return i32(3)
        var source=0
        while (source < 20) {
            val mask=u32(1)<<u32(source)
            drop=true
            owner=owner.configureOwned(mask,true)
            if (owner.status() != 3 || reg != u32(0x80000000)) return i32(4)
            drop=false;owner=owner.configureOwned(mask,true)
            if (owner.status() != 1 || reg != (u32(0x80000000)|mask)) return i32(5)
            drop=true;owner=owner.parkOwned(true)
            if (owner.status() != 3) return i32(6)
            drop=false;owner=owner.parkOwned(true)
            if (owner.status() != 5) return i32(7)
            source=source+1
        }
        val before=writes
        owner=owner.configureOwned(u32(0x100000),true)
        if (owner.status() != 2 || !owner.hasSnapshot() || writes != before) return i32(8)
        if (owner.configureOwned(u32(1),false) != owner || owner.closeOwned(false) != owner ||
            owner.parkOwned(false) != owner || writes != before) return i32(9)
        drop=true;owner=owner.closeOwned(true)
        if (owner.status() != 3) return i32(10)
        drop=false;owner=owner.closeOwned(true)
        if (owner.status() != 4 || reg != original) return i32(11)
        val closedWrites=writes
        if (owner.closeOwned(true) != owner || owner.parkOwned(true) != owner ||
            owner.configureOwned(u32(1),true) != owner || writes != closedWrites) return i32(12)
        bit=bit+1
    }
    writes=0
    if (esp32p4WakeTriggerParkOwned(false).status() != 2 || writes != 0) return i32(13)
    return i32(0)
}
