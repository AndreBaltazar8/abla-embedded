import "../src/m5stack/atom_s3_panel_draw_sequence.ab"
import "../src/spi/pins.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
val gateMemory=nativeStaticMutableU32s([0])
val source=nativeBufferAt(nativeStaticAllocate(8),8)
var resetExpected=false
var resetFail=false
var words=0
var pixels=0
var starts=0
var bad=false
fun owned(): void { if (nativeAddressLoadU32(gateMemory,0) != 7) bad=true;return }
fun esp32s3SpiRead(address: int): int { owned();return 0 }
fun esp32s3SpiWrite(address: int,value: int): void { bad=true;return }
fun esp32s3SpiCommandPinsValid(port: int,pins: SpiPins,cs: Pin,dc: Pin,shared: bool): bool =
    (port == 2 || port == 3) && pins.mosiPin() == 21 && pins.misoPin() == -1 && !shared
fun Pin.outputLevelOwned(high: bool): bool { owned();return true }
fun Pin.writeLevelOwned(high: bool): bool { owned();return true }
fun Pin.inputOwned(): bool { bad=true;return false }
fun esp32s3SpiCommandWordOwned(port: int,cs: Pin,dc: Pin,command: int,value: u32,bytes: int,shared: bool): int {
    owned();val index=words;words=words+1
    if (bytes != 4 || shared) bad=true
    if (resetExpected && index == 0) {
        if (command != 43 || value != u32(0xffffffff)) bad=true
        return if (resetFail) 263 else 257
    }
    val normal=index-(if (resetExpected) 1 else 0)
    if (command != (if (normal == 0) 42 else 43) || normal > 1) bad=true
    return 257
}
fun esp32s3SpiTransmitByteOwned(port: int,command: int,polls: int): int {
    owned();starts=starts+1;if (command != 44 || words != (if (resetExpected) 3 else 2)) bad=true
    return 257
}
fun esp32s3SpiTransmitColorOwned(port: int,color: u32,count: int): int {
    owned();pixels=pixels+count;if (color != u32(0x1234)) bad=true;return 257
}
fun esp32s3SpiTransmitOwned(port: int,data: NativeBuffer,bytes: int,polls: int): int {
    owned();pixels=pixels+bytes/2;return 257
}
@export("abla_atom_s3_native_draw_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateMemory)
    var board=11
    while (board <= 18) {
        var kind=0
        while (kind < 2) {
            val panel=atomS3PanelFromId(M5BoardId(board),if (kind == 0) 0x7683 else 0x079100)
            var rotation=0
            while (rotation < 8) {
                resetExpected=kind == 1 && (rotation&1) != 0
                var variant=0
                while (variant < 4) {
                    resetFail=variant >= 2
                    words=0;pixels=0;starts=0;bad=false;nativeAddressStoreU32(gateMemory,0,0)
                    val result=if ((variant&1) == 0) panel.fillNativeChecked(gate,u32(7),2,rotation,0,0,2,2,Rgb565(0x1234)) else
                        panel.blitNativeChecked(gate,u32(7),3,rotation,0,0,source,2,2,4)
                    if (bad) return i32(1)
                    if (resetExpected && resetFail) {
                        if (result.status() != 6 || words != 1 || pixels != 0 || starts != 0 || nativeAddressLoadU32(gateMemory,0) != 0x80000000) return i32(2)
                    } else if (!result.valid() || words != (if (resetExpected) 3 else 2) || starts != 1 || pixels != 4 || nativeAddressLoadU32(gateMemory,0) != 0) return i32(3)
                    variant=variant+1
                }
                rotation=rotation+1
            }
            kind=kind+1
        }
        board=board+7
    }
    return i32(0)
}
