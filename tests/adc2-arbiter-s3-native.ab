import "../src/esp32/adc2_arbiter_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var arbiter=0
var sample=0
var writes=0
var reads=0
var drop=false
var bad=false
fun esp32S3Adc2ArbiterRead(): int { reads=reads+1; return arbiter }
fun esp32S3Adc2ArbiterWrite(value: int): void { writes=writes+1; if (!drop) arbiter=value; return }
fun esp32S3Adc2Read(offset: int): int { if (offset != 48) bad=true; return sample }
@export("abla_adc2_arbiter_s3_test")
fun test(): i32 {
    var mode=0
    while (mode < 2) {
        var original=0
        while (original < 2048) {
            arbiter=0xa5000003|(original<<2); writes=0
            val before=arbiter
            var owner=esp32S3Adc2ArbiterOpenOwned(mode,true,8000000)
            if (!owner.ready() || arbiter != (0xa5000003|esp32S3Adc2ArbiterProfile(mode))) return i32(1)
            if (owner.closeOwned().status() != 0 || arbiter != before) return i32(2)
            if ((before&0x1ffc) != esp32S3Adc2ArbiterProfile(mode)) {
                writes=0; drop=true; owner=esp32S3Adc2ArbiterOpenOwned(mode,true,8000000)
                if (owner.status() != 4 || writes != 1) return i32(3)
                drop=false
                if (owner.closeOwned().status() != 0 || arbiter != before) return i32(4)
                owner=esp32S3Adc2ArbiterOpenOwned(mode,true,8000000); drop=true
                owner=owner.closeOwned()
                if (owner.status() != 4) return i32(5)
                drop=false
                if (owner.closeOwned().status() != 0 || arbiter != before) return i32(6)
            }
            original=original+1
        }
        mode=mode+1
    }
    arbiter=0; writes=0
    if (esp32S3Adc2ArbiterOpenOwned(0,false,8000000).status() != 3 || writes != 0) return i32(7)
    sample=0x800c0000
    if (esp32S3Adc2ArbiterOpenOwned(0,true,8000000).status() != 5 || writes != 0) return i32(8)
    sample=0
    var owner=esp32S3Adc2ArbiterOpenOwned(0,true,8000000)
    sample=0x80060000; writes=0; owner=owner.closeOwned()
    if (owner.status() != 5 || writes != 0) return i32(9)
    sample=0; arbiter=0x900
    if (owner.closeOwned().status() != 6 || writes != 0) return i32(10)
    arbiter=0x1910; owner=esp32S3Adc2ArbiterOpenOwned(0,false,8000000); arbiter=0
    if (owner.closeOwned().status() != 6 || writes != 0) return i32(11)
    reads=0
    if (esp32S3Adc2ArbiterOpenOwned(0,true,7999999).status() != 2 || esp32S3Adc2ArbiterOpenOwned(2,true,8000000).status() != 2 || reads != 0 || bad) return i32(12)
    if (!esp32S3Adc2ArbiterOpenOwned(1,true,1000000).ready()) return i32(13)
    return i32(0)
}
