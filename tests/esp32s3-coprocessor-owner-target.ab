import "../src/esp32/coprocessor_owner_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_coprocessor_owner_target")
@section(".iram1.abla.s3CpOwnerTarget")
trusted fun ownerTarget(table: NativeBuffer,record: NativeBuffer,core: int,cp: int,mode: int): bool {
    if (mode == 0) return esp32S3CpRecordInitializeOwned(record,cp)
    if (mode == 1) return esp32S3CpOwnerAcquireOwned(table,record,core,cp)
    esp32S3CpOwnerReleaseOwned(table,core,cp)
}
