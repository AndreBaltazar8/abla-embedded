import "../src/esp32/i2s/clock_choice_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
fun magnitude(value: int): int = if (value < 0) -value else value
fun auditChoice(source: int, target: int): bool {
    val chosen = esp32s3I2sChooseDivider(source, target)
    if (!chosen.valid()) return false
    val a = chosen.denominator()
    val d = chosen.integer() * a + chosen.numerator()
    val error = magnitude(source * a - target * d)
    if (chosen.frequency(source) != (source * a + d / 2) / d) return false
    // Independent exhaustive fraction oracle at the neighboring integer
    // divisors. All farther integer intervals are monotonically worse.
    var n = source / target - 1
    while (n <= source / target + 1) {
        if (n >= 2 && n <= 255) {
            var denominator = 1
            while (denominator <= 511) {
                var numerator = 0
                while (numerator < denominator) {
                    val divisor = n * denominator + numerator
                    if (magnitude(source * denominator - target * divisor) * d < error * divisor) return false
                    numerator = numerator + 1
                }
                denominator = denominator + 1
            }
        }
        n = n + 1
    }
    true
}
trusted fun i2sChoiceTest(): int {
    val exact = esp32s3I2sChooseDivider(160000000, 4096000)
    if (!exact.valid() || exact.integer() != 39 || exact.numerator() != 1 || exact.denominator() != 16 || exact.frequency(160000000) != 4096000) return 1
    if (!auditChoice(160000000, 11289600) || !auditChoice(160000000, 12288000) || !auditChoice(160000000, 24576000) || !auditChoice(4294967295, 2147483647) || !auditChoice(4294967295, 16777217) || !auditChoice(1000003, 7001)) return 2
    if (esp32s3I2sChooseDivider(0, 1).valid() || esp32s3I2sChooseDivider(160000000, 0).valid() || esp32s3I2sChooseDivider(160000000, 80000001).valid() || esp32s3I2sChooseDivider(160000000, 625000).valid() || esp32s3I2sChooseDivider(4294967296, 4096000).valid()) return 3
    0
}
#exportFunction("i2sChoiceTest", "abla_i2s_choice_test")
