import "../src/esp32/boot_main_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var ready=false
var phase=0
var bad=false
fun esp32S3BootMemoryPrepare(): bool { if (phase != 0) bad=true; phase=1; ready }
fun esp32S3BootApplication(): void { if (phase != 1 || !ready) bad=true; phase=2; return }
@export("abla_boot_main_test")
fun bootMainTest(): i32 {
    esp32S3BootMain()
    if (bad || phase != 1) return i32(1)
    phase=0; ready=true
    esp32S3BootMain()
    if (bad || phase != 2) return i32(2)
    i32(0)
}
