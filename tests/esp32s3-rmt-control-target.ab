import "../src/esp32/rmt_clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun rmtControlTarget(owner: u32, channel: u32, divider: u32): int {
    if (!esp32s3RmtEnableBusClock(owner)) return -1
    if (!esp32s3RmtConfigureClock(1, 1, 0, 0, owner)) return -2
    if (!esp32s3RmtConfigureSingleBlockTxOwned(int(channel), int(divider))) return -3
    val events = esp32s3RmtTxEvents(int(channel))
    if (!esp32s3RmtTxAcknowledge(int(channel), events)) return -4
    if (!esp32s3RmtTxRequestOwned(int(channel), false)) return -5
    events
}
#exportFunction("rmtControlTarget", "abla_s3_rmt_control_test")
