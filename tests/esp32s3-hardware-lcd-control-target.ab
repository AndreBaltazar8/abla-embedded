import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/display_spi_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
@export("abla_s3_lcd_control_test")
trusted fun lcdControlTarget(gateAddress: u32, rotation: int, inverted: bool): int {
    val display = m5BoardStackCoreS3.spiDisplay()
    val gate = peripheralGateAt(int(gateAddress))
    val result = display.setRotation(gate,u32(7),lcdGeometry(320,240),rotation,true)
    if (!result.valid()) return result.status()
    val inversion = display.setInverted(gate,u32(7),inverted)
    if (!inversion.valid()) return inversion.status()
    val idle = display.setIdle(gate,u32(7),false)
    if (!idle.valid()) return idle.status()
    display.setSleep(gate,u32(7),false,120).status()
}
