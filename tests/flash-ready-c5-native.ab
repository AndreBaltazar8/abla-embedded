import "../src/esp32/flash_ready_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(560)
var response=0
var busySamples=0
var sr2=0
var count1=0
var count2=0
var pending=0
var commands=0
var writes=0
var failAt=0
var bad=false
fun initial(offset: int): int = if (offset == 0 || offset == 0xd4) 0 else if (offset == 0x34) 2 else 0x5a5affff|offset
trusted fun c5MspiRead(address: int): int {
    if (address == 0x60096018) return 13
    if (address == 0x6009601c) return 0x603
    if (address == 0x60002000) return 0
    if (address < 0x60003000 || address >= 0x60003200) { bad=true;return 0 }
    if (address == 0x60003000) {
        if (pending > 0) { pending=pending-1;return 0x40000 }
        return 0
    }
    return nativeBufferAt(memory+48,512).loadU32(address-0x60003000)
}
trusted fun c5MspiWrite(address: int,value: int): void {
    if (address < 0x60003000 || address >= 0x60003200 || pending != 0) { bad=true;return }
    val regs=nativeBufferAt(memory+48,512)
    if (address == 0x60003000) {
        if (value != 0x40000 || (regs.loadU32(8)&0x2320) != 0 || (regs.loadU32(0x18)&0xf900f000) != 0x90000000 ||
            ((regs.loadU32(0x20)&0xf000ffff) != 0x70000005 && (regs.loadU32(0x20)&0xf000ffff) != 0x70000035) || (regs.loadU32(0x28)&1023) != 7) bad=true
        if ((regs.loadU32(0x20)&255) == 5) {
            count1=count1+1
            response=if (busySamples > 0) 1 else 0
            if (busySamples > 0) busySamples=busySamples-1
        } else { count2=count2+1;response=sr2 }
        commands=commands+1;pending=if ((response&1) == 0) 0 else 3
        regs.storeU32(0x58,response);return
    }
    writes=writes+1
    if (writes == failAt) return
    regs.storeU32(address-0x60003000,value);return
}

val readyMemory=nativeStaticAllocate(120)
@export("abla_flash_ready_c5_test")
trusted fun readyTest(): i32 {
    val record=nativeBufferAt(readyMemory,120);val regs=nativeBufferAt(memory+48,512)
    var policy=0
    while (policy < 2) {
        val mask=if (policy == 0) 0x80 else 0x84
        var value=0
        while (value < 6) {
            sr2=if (value == 0) 0 else if (value == 1) 4 else if (value == 2) 128 else if (value == 3) 132 else if (value == 4) 2 else 255
            var busy=0
            while (busy < 4) {
                var failure=0
                while (failure <= 40) {
                    var offset=0
                    while (offset < 512) { regs.storeU32(offset,initial(offset));offset=offset+4 }
                    record.storeU32(0,0);commands=0;writes=0;pending=0;bad=false;failAt=failure
                    busySamples=busy;count1=0;count2=0
                    var result=esp32C5FlashReadyOwned(record,mask,1,true)
                    var retries=0
                    while (result == 3 && retries < 32) { result=esp32C5FlashReadyOwned(record,mask,1,true);retries=retries+1 }
                    if (result != (if ((sr2&mask) == 0) 1 else 4) || bad || count1 != busy+1 || count2 != 1 ||
                        record.loadU32(12) != sr2<<8 || record.loadU32(20) != busy) return i32(1)
                    offset=0
                    while (offset < 512) { if (regs.loadU32(offset) != initial(offset)) return i32(2);offset=offset+4 }
                    val issued=commands;val changed=writes
                    if (esp32C5FlashReadyOwned(record,mask,1,true) != result || commands != issued || writes != changed) return i32(3)
                    if (esp32C5FlashReadyOwned(record,mask^4,1,true) != 2 || commands != issued || writes != changed) return i32(4)
                    failure=failure+1
                }
                busy=busy+1
            }
            value=value+1
        }
        policy=policy+1
    }
    record.storeU32(0,0);commands=0;writes=0
    if (esp32C5FlashReadyOwned(record,0,1,true) != 2 || esp32C5FlashReadyOwned(record,128,1,false) != 2 ||
        record.loadU32(0) != 0 || commands != 0 || writes != 0) return i32(5)
    return i32(0)
}

