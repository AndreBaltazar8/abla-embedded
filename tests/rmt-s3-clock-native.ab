import "../src/esp32/rmt_clock_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var clock = 0
var reset = 0
var config = 0
var writes = 0
var bad = false
trusted fun esp32s3RmtRead(address: int): int = if (address == 0x600c0018) clock else if (address == 0x600c0020) reset else config
trusted fun esp32s3RmtWrite(address: int, value: int): void {
    writes = writes + 1
    if (address == 0x600c0018) clock = value
    else if (address == 0x600c0020) reset = value
    else if (address == 0x600160c0) config = value
    else bad = true
    return
}
trusted fun rmtClockTest(): int {
    var variant = 0
    while (variant < 4) {
        clock = 0x80000001 | ((variant & 1) << 9)
        reset = 0x40000001 | (((variant >>> 1) & 1) << 9)
        writes = 0
        esp32s3RmtEnableBusClockLocked()
        if (clock != 0x80000201 || reset != 0x40000001 || bad) return 1
        val first = writes
        esp32s3RmtEnableBusClockLocked()
        if (writes != first) return 2
        variant = variant + 1
    }
    var source = 1
    while (source <= 3) {
        var integer = 1
        while (integer <= 256) {
            config = 0x8800000f; writes = 0
            if (!esp32s3RmtConfigureClockLocked(source, integer, 17, 63) || writes != 1 ||
                ((config >>> 4) & 255) != integer - 1 || ((config >>> 12) & 63) != 17 ||
                ((config >>> 18) & 63) != 63 || ((config >>> 24) & 3) != source ||
                (config & 0xfc00000f) != 0x8800000f) return 3
            integer = integer + 1
        }
        source = source + 1
    }
    config = 0x04000000; writes = 0
    if (esp32s3RmtConfigureClockLocked(1, 1, 0, 0) || writes != 0) return 4
    config = 0
    if (esp32s3RmtConfigureClockLocked(0, 1, 0, 0) ||
        esp32s3RmtConfigureClockLocked(1, 257, 0, 0) ||
        esp32s3RmtConfigureClockLocked(1, 1, 1, 0) ||
        esp32s3RmtConfigureClockLocked(1, 1, 63, 63) || writes != 0) return 5
    if (!esp32s3RmtConfigureClockLocked(1, 256, 0, 0) || bad) return 6
    0
}
#exportFunction("rmtClockTest", "abla_rmt_clock_test")
