import "../src/esp32/i2c/lp_pins_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var original=0
var failure=0
var pulls=false
var writes=0
var reads=0
var bad=false
fun c5LpI2cPinLoad(address: int): int {
    reads=reads+1
    if (address == 0x600B102C && writes == 0) return if (failure == 1) 4 else 0
    if (address == 0x600B2800 && writes == 0) return if (failure == 2) 0 else 0x08000000
    if (address == 0x600B47F8 && writes == 0) return if (failure == 3) 0 else 1
    val expected=if (writes == 3) 0x600B4438 else if (writes == 4) 0x600B4008 else if (writes == 5) 0x600B443C else if (writes == 6) 0x600B400C else if (writes == 8) 0x600B1028 else 0
    if (address != expected) bad=true
    original
}
fun c5LpI2cPinStore(address: int,value: int): void {
    val expectedAddress=if (writes == 0) 0x6009103C else if (writes == 1) 0x600B4418 else if (writes == 2) 0x600B4408 else if (writes == 3) 0x600B4438 else if (writes == 4) 0x600B4008 else if (writes == 5) 0x600B443C else if (writes == 6) 0x600B400C else if (writes == 7) 0x600B4414 else 0x600B1028
    val expected=if (writes < 3 || writes == 7) 12 else if (writes == 3 || writes == 5) original|4 else if (writes == 8) original|12 else (original&~0x7382)|0x3200|(if (pulls) 256 else 0)
    if (address != expectedAddress || value != expected) bad=true
    writes=writes+1
    return
}
@export("abla_c5_lp_i2c_pins_test")
trusted fun pinsTest(): i32 {
    var profile=0
    while (profile < 2048) {
        original=(profile/8)*0x01010101; pulls=(profile&1) != 0; failure=(profile/2)%4
        writes=0; reads=0; bad=false
        if (esp32C5LpI2cRoutePinsOwned(0,2,3,pulls) != (failure == 0) ||
            writes != (if (failure == 0) 9 else 0) || reads != (if (failure == 0) 8 else failure) || bad) return i32(1)
        profile=profile+1
    }
    writes=0; reads=0
    if (esp32C5LpI2cRoutePinsOwned(1,2,3,true) || esp32C5LpI2cRoutePinsOwned(0,3,2,true) ||
        writes != 0 || reads != 0) return i32(2)
    i32(0)
}
