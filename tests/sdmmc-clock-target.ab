import "../src/sd/mmc_command_esp32s3.ab"
import "../src/sd/mmc_clock_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_clock_target")
trusted fun target(operation: int,state: int,slot: int,divider: int,enabled: bool,lowPower: bool): int =
    if (operation == 0) sdMmcClockStartOwned(slot,divider,enabled,lowPower)|0 else SdMmcClock(state).pollOwned()|0
