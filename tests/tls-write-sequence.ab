import "../src/esp32/tls/write_sequence_esp32.ab"
var total=u32(0)
var accepted=u32(0)
var limit=u32(0)
var stopAfter=0
var calls=0
var errors=0
var failure=u32(0)
var bad=false
trusted fun esp32TlsWriteChunk(tls: u32,source: u32,length: u32): u32 {
    val remaining=total-accepted
    val expected=if (remaining > u32(4096)) u32(4096) else remaining
    if (tls != u32(123) || source != u32(1000)+accepted || length != expected || length == u32(0)) bad=true
    calls=calls+1
    if (calls > stopAfter) return failure
    val count=if (length < limit) length else limit
    accepted=accepted+count
    count
}
trusted fun esp32TlsWriteError(tls: u32,result: u32): void {
    errors=errors+1
    if (tls != u32(123) || result != failure) bad=true
    return
}
fun testLength(index: int): u32 =
    if (index == 0) u32(0) else if (index == 1) u32(1) else
    if (index == 2) u32(4095) else if (index == 3) u32(4096) else
    if (index == 4) u32(4097) else if (index == 5) u32(8192) else
    if (index == 6) u32(8193) else u32(16385)
fun main(): int {
    var size=0
    while (size < 8) {
        total=testLength(size)
        var chunk=0
        while (chunk < 3) {
            limit=if (chunk == 0) u32(1) else if (chunk == 1) u32(17) else u32(4096)
            stopAfter=0
            while (stopAfter < 7) {
                var kind=0
                while (kind < 4) {
                    failure=if (kind == 0) u32(0) else if (kind == 1) u32(4294940416) else
                        if (kind == 2) u32(4294940544) else u32(4294967295)
                    accepted=u32(0); calls=0; errors=0; bad=false
                    val result=esp32TlsWriteChunks(u32(123),u32(1000),total)
                    val full=accepted == total
                    val expected=if (full) total else if (kind == 3 || accepted == u32(0)) failure else accepted
                    if (bad || result != expected || errors != (if (!full && kind == 3) 1 else 0)) return 1
                    if (!full && calls != stopAfter+1) return 2
                    kind=kind+1
                }
                stopAfter=stopAfter+1
            }
            // Complete writes including many short positive results.
            stopAfter=20000; accepted=u32(0); calls=0; errors=0; bad=false
            if (esp32TlsWriteChunks(u32(123),u32(1000),total) != total || accepted != total || errors != 0 || bad) return 3
            chunk=chunk+1
        }
        size=size+1
    }
    0
}
