import "../src/input/touch10.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
val storage=nativeStaticAllocate(428)
trusted fun put(frame: NativeBuffer,index: int,id: int): void {
    val point=touchPoint(10+id,20+id,id,2,123)
    var byte=0
    while (byte < 8) { frame.store(index*8+byte,(point>>>(byte*8))&255); byte=byte+1 }
    return
}
@export("abla_touch10_test")
trusted fun testTen(): i32 {
    val bounded=touchTracker10At(nativeBufferAt(storage,344),4294967296,2147483648)
    if (touchLoad32(bounded|0,336) != 65535 || touchLoad32(bounded|0,340) != 65535) return i32(20)
    val tracker=touchTracker10At(nativeBufferAt(storage,344))
    val frame=nativeBufferAt(storage+344,80)
    var mask=0
    while (mask < 1024) {
        var count=0
        var id=0
        while (id < 10) {
            if ((mask&(1<<id)) != 0) { put(frame,count,id); count=count+1 }
            id=id+1
        }
        if (tracker.updateControllerFrame(frame,count,(mask+1)*10) < 0 || tracker.updatedMask() != mask) return i32(1)
        id=0
        while (id < 10) {
            val detail=tracker.detail(id)
            if (detail.isPressed() != ((mask&(1<<id)) != 0)) return i32(2)
            if (detail.isPressed() && (detail.point().id() != id || detail.point().size() != 123)) return i32(3)
            id=id+1
        }
        mask=mask+1
    }
    put(frame,0,9); put(frame,1,9)
    if (tracker.updateControllerFrame(frame,2,20000) != -1 || tracker.updatedMask() != 1023) return i32(4)
    if (tracker.updateControllerFrame(nativeBufferAt(storage+343,80),1,20000) != -1) return i32(5)
    var id=0
    while (id < 8) {
        if ((gesturePoint(1,2,3,id) | 0) != (1|(2<<16)|(3<<32)|(id<<48)|(1<<51))) return i32(6)
        id=id+1
    }
    i32(0)
}
