import "../src/esp32/rtc_pad_c61_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val storage=nativeStaticAllocate(4096)
var writes=0
var drop=0
var fault=0
var pin=0
var bad=false
fun offset(address: int): int =
    if (address >= 0x60090000 && address < 0x60090078) address-0x60090000 else
    if (address >= 0x60091000 && address < 0x60091b4c) 256+address-0x60091000 else
    if (address >= 0x600b4000 && address < 0x600b401c) 3400+address-0x600b4000 else
    if (address == 0x600b4410 || address == 0x600b4418) 3500+address-0x600b4410 else
    if (address == 0x600b1028) 3540 else -1
fun c61GpioRead(address: int): u32 {
    if (address == 0x600b102c) return if (fault == 1) u32(1)<<u32(pin) else u32(0)
    if (address == 0x600b2800) return if (fault == 2) u32(0) else u32(1<<27)
    if (address == 0x600960c0) return if (fault == 3) u32(3) else u32(1)
    if (address == 0x600960c4) return if (fault == 4) u32(0) else u32(0x400000)
    if (address == 0x60091df8) return if (fault == 5) u32(0) else u32(1)
    val at=offset(address)
    if (at < 0) { bad=true;return u32(0) }
    return u32(nativeAddressLoadU32(storage,at))
}
fun c61GpioWrite(address: int,value: u32): void {
    writes=writes+1
    var at=offset(address);var desired=value
    if (address == 0x6009103c || address == 0x6009100c || address == 0x600b4418) {
        at=at-8;desired=u32(nativeAddressLoadU32(storage,at))&(u32(0xffffffff)^value)
    } else if (address == 0x60091008) {
        at=at-4;desired=u32(nativeAddressLoadU32(storage,at))|value
    }
    if (at < 0) { bad=true;return }
    if (writes == drop) return
    if (address == 0x600b1028) {
        val bit=u32(1)<<u32(pin)
        if ((c61GpioRead(0x60091034)&bit) != u32(0) ||
            (c61GpioRead(0x60091ad4+pin*4)&u32(3072)) != u32(1024) ||
            (c61GpioRead(0x600b4410)&bit) != u32(0)) bad=true
    }
    nativeAddressStoreU32(storage,at,int(desired));return
}
fun seed(): void {
    var at=0
    while (at < 4096) { nativeAddressStoreU32(storage,at,0xffffffff);at=at+4 }
    writes=0;drop=0;fault=0;bad=false;return
}
@export("abla_rtc_pad_c61_test")
trusted fun testRtcPad(): i32 {
    while (pin < 7) {
        var pull=0
        while (pull < 3) {
            seed()
            if (esp32C61RtcPadInputOwned(pin,pull,true) != 1 || bad) return i32(1)
            val total=writes
            val bit=u32(1)<<u32(pin)
            if (c61GpioRead(0x600b1028) != (u32(0xffffffff)^bit) ||
                c61GpioRead(0x600b4410) != (u32(0xffffffff)^bit) ||
                c61GpioRead(0x60091034) != (u32(0xffffffff)^bit) ||
                c61GpioRead(0x600b4000+pin*4) != (u32(0xffffffff)^u32(896))) return i32(2)
            val mux=c61GpioRead(0x60090000+pin*4)&u32(29570)
            if (mux != (u32(4608)|(if (pull == 1) u32(256) else if (pull == 2) u32(128) else u32(0)))) return i32(3)
            var failed=1
            while (failed <= total) {
                seed();drop=failed
                val status=esp32C61RtcPadInputOwned(pin,pull,true)
                if ((status != 1 && (status < 5 || status > 8)) || bad) return i32(4)
                drop=0
                if (esp32C61RtcPadInputOwned(pin,pull,true) != 1 || bad) return i32(5)
                failed=failed+1
            }
            pull=pull+1
        }
        var blocked=1
        while (blocked <= 5) {
            seed();fault=blocked
            if (esp32C61RtcPadInputOwned(pin,1,true) != (if (blocked == 1) 3 else 4) || writes != 0) return i32(6)
            blocked=blocked+1
        }
        seed()
        if (esp32C61RtcPadInputOwned(pin,1,false) != 3 || writes != 0) return i32(7)
        pin=pin+1
    }
    seed()
    if (esp32C61RtcPadInputOwned(7,1,true) != 2 || esp32C61RtcPadInputOwned(-1,1,true) != 2 ||
        esp32C61RtcPadInputOwned(2,3,true) != 2 || writes != 0) return i32(8)
    return i32(0)
}
