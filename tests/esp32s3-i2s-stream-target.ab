import "../src/esp32/i2s/dma_stream_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun i2sStreamTarget(port: i32, transmit: bool, channel: i32, descriptor: u32, stop: bool): i32 {
    if (stop) return i32(esp32s3I2sStopStream(int(port), transmit, int(channel), 1000))
    i32(esp32s3I2sStartStream(int(port), transmit, int(channel), int(descriptor), 1000))
}
#exportFunction("i2sStreamTarget", "abla_s3_i2s_stream_test")
