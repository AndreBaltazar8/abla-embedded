import "../src/esp32/gpio/wake_c5_sequence.ab"
import "abla/build"
var pinNumber=0
var reg=0
var original=0
var writes=0
var reads=0
var drop=0
var bad=false
fun c5GpioWakeRead(address: int): int {
    reads=reads+1
    if (address != 0x600910d4+pinNumber*4) bad=true
    return reg
}
fun c5GpioWakeWrite(address: int,value: int): void {
    if (address != 0x600910d4+pinNumber*4 || ((value^original)&~0x780) != 0) bad=true
    // Change polarity only while wake is disabled.
    if (((value^reg)&0x380) != 0 && (reg&0x400) != 0) bad=true
    writes=writes+1
    if (writes != drop) reg=value
    return
}
fun seed(pin: int,fields: int,fault: int): void {
    pinNumber=pin;reg=0xa5a01804|(fields<<7);original=reg
    writes=0;reads=0;drop=fault;bad=false
    return
}
@export("abla_gpio_wake_c5_test")
fun test(): int {
    var pin=0
    while (pin < 29) {
        var profile=0
        while (profile < 32) {
            var fault=0
            while (fault < 7) {
                seed(pin,profile&15,fault)
                val owner=esp32C5GpioWakeOpenOwned(pin,profile >= 16,true)
                if (!owner.hasSnapshot() || owner.pin() != pin ||
                    (owner.status() != 1 && owner.status() != 4)) return 1
                if (owner.status() == 1 && (reg&0x780) != (if (profile >= 16) 0x680 else 0x600)) return 2
                val before=writes;val beforeReads=reads
                if (owner.closeOwned(false) != owner || writes != before || reads != beforeReads) return 3
                var closed=owner.closeOwned(true)
                if (closed.status() != 5 && closed.status() != 4) return 4
                drop=0
                closed=closed.closeOwned(true)
                if (closed.status() != 5 || reg != original || bad) return 5
                val count=writes;val samples=reads
                if (closed.closeOwned(true) != closed || writes != count || reads != samples) return 6
                fault=fault+1
            }
            profile=profile+1
        }
        seed(pin,15,0)
        val owner=esp32C5GpioWakeOpenOwned(pin,false,true)
        reg=reg|0x2000;original=original|0x2000
        val count=writes
        val busy=owner.closeOwned(true)
        if (busy.status() != 3 || !busy.hasSnapshot() || writes != count) return 7
        reg=reg&~0x2000;original=original&~0x2000
        if (busy.closeOwned(true).status() != 5 || reg != original || bad) return 8
        var route=0
        while (route < 5) {
            seed(pin,0,0);reg=reg|int(u32(1)<<u32(13+route))
            if (esp32C5GpioWakeOpenOwned(pin,false,true).status() != 3 || writes != 0) return 9
            route=route+1
        }
        pin=pin+1
    }
    seed(0,0,0)
    if (esp32C5GpioWakeOpenOwned(-1,false,true).status() != 2 ||
        esp32C5GpioWakeOpenOwned(29,false,true).status() != 2 ||
        esp32C5GpioWakeOpenOwned(0,false,false).status() != 2 || reads != 0 || writes != 0) return 10
    val forged=C5GpioWake((1<<18)|(29<<8)|1)
    if (forged.hasSnapshot() || forged.closeOwned(true) != forged || reads != 0 || writes != 0) return 11
    return 0
}
