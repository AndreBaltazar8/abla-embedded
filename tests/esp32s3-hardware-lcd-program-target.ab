import "../src/display/spi_program_esp32s3.ab"
import "../src/display/mipi_programs.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun hardwareLcdProgramTarget(gateAddress: u32): int {
    val program = ili9342EInitProgram()
    esp32s3LcdRunProgram(peripheralGateAt(int(gateAddress)), u32(41), 2,
        spiPins(37,35,36), Pin(3), Pin(35), program, program.capacity(), true)
}
#exportFunction("hardwareLcdProgramTarget", "abla_s3_hardware_lcd_program_test")
