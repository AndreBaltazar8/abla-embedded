import "../src/m5stack/atom_s3_panel.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 0 && this <= 48
fun Pin.outputCapable(): bool = this.valid()
val gateMemory=nativeStaticMutableU32s([0])
val trace=nativeStaticAllocate(1024)
var pins=M5SpiDisplayPins(0)
var selected=false
var dc=true
var mosi=false
var bits=0
var value=0
var bytes=0
var delays=0
var bad=false
trusted fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateMemory,0) != 7) bad=true
    if (this == pins.mosi()) mosi=high
    else if (this == pins.dataCommand()) dc=high
    else if (this == pins.chipSelect()) selected=!high
    else if (this != pins.clock()) bad=true
    if (this == pins.clock() && selected && high) {
        value=(value<<1)|(if (mosi) 1 else 0);bits=bits+1
        if (bits == 8) {
            if (bytes >= 512) bad=true
            else nativeBufferAt(trace,1024).storeU16(bytes*2,value|(if (dc) 256 else 0))
            bytes=bytes+1;bits=0;value=0
        }
    }
    return
}
fun Pin.read(): bool { bad=true;return false }
fun Pin.writeLevelOwned(high: bool): bool { bad=true;return false }
fun Pin.outputLevelOwned(high: bool): bool { bad=true;return false }
fun Pin.inputOwned(): bool { bad=true;return false }
fun peripheralDelayMicroseconds(us: int): void { bad=true;return }
fun peripheralDelayMilliseconds(ms: int): void {
    if (selected || nativeAddressLoadU32(gateMemory,0) != 7 || ms <= 0) bad=true
    delays=delays+ms;return
}
fun reset(): void { selected=false;dc=true;bits=0;value=0;bytes=0;delays=0;bad=false;return }
trusted fun at(index: int,value: int): bool = nativeBufferAt(trace,1024).loadU16(index*2) == value
@export("abla_atom_s3_panel_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateMemory)
    var low=0
    while (low < 65536) {
        val p=atomS3PanelFromId(m5BoardAtomS3,low)
        if (p.valid() != (low == 0x7683 || low == 0x897c)) return i32(1)
        low=low+1
    }
    if (atomS3PanelFromId(m5BoardAtomS3,-1).valid() || atomS3PanelFromId(m5BoardAtomS3,0x100079100).valid() ||
        atomS3PanelFromId(m5BoardAtomEcho(),0x079100).valid() || AtomS3Panel(0x100010b).valid()) return i32(2)
    var board=0
    while (board < 2) {
        var kind=0
        while (kind < 3) {
            val profile=atomS3PanelFromId(if (board == 0) m5BoardAtomS3 else m5BoardAtomS3R,
                if (kind == 0) 0x007683 else if (kind == 1) 0xff897c else 0x079100)
            pins=profile.pins()
            if (!profile.valid() || profile.gc9107() != (kind == 2)) return i32(3)
            var rotation=0
            while (rotation < 8) {
                reset()
                val internal=if (kind == 2) rotation else ((rotation+2)&3)|(rotation&4)
                val column=if (kind == 2) (if (rotation == 1 || rotation == 5) 32 else 0)
                    else if ((internal&1) == 0) 2 else if ((internal&2) == 0) 1 else 3
                val row=if (kind == 2) (if (rotation == 0 || rotation == 6) 32 else 0)
                    else if ((internal&1) != 0) 2 else if (internal == 2 || internal == 4) 3 else 1
                val view=profile.view(rotation)
                if (view.columnStart() != column || view.rowStart() != row || profile.internalRotation(rotation) != internal) return i32(4)
                if (!profile.beginChecked(gate,u32(7),rotation,0).valid() || bad || selected || delays != (if (kind == 2) 130 else 760) ||
                    !at(bytes-5,58) || !at(bytes-4,341) || !at(bytes-3,54) || !at(bytes-2,256|lcdMadctl(internal,true)) || !at(bytes-1,if (kind == 2) 32 else 33)) return i32(5)
                reset()
                if (!profile.fillRectChecked(gate,u32(7),rotation,127,127,2,2,Rgb565(0x1234),0).valid() || bad || selected) return i32(6)
                val offset=if (kind == 2 && (rotation&1) != 0) 5 else 0
                if (bytes != offset+13 || !at(offset,42) || !at(offset+2,256|127+column) || !at(offset+4,256|127+column) ||
                    !at(offset+5,43) || !at(offset+7,256|127+row) || !at(offset+9,256|127+row) || !at(offset+10,44) ||
                    !at(offset+11,274) || !at(offset+12,308)) return i32(7)
                rotation=rotation+1
            }
            kind=kind+1
        }
        board=board+1
    }
    reset()
    if (AtomS3Panel(0).beginChecked(gate,u32(7),0,0).status() != 3 || bytes != 0) return i32(8)
    return i32(0)
}
