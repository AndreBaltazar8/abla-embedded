import "../src/sd/selected_write.ab"
import "abla/build"
val memory=nativeStaticAllocate(520)
var calls=0
var failAt=0
var variant=0
var argument=0
var bad=false
var delays=0
fun sdSpiSelectedAdmission(context: int,scratch: NativeBuffer,source: NativeBuffer,bytes: int): bool = context == 123
fun sdSpiSelectedDelay(us: int): void { if (us != 1000) bad=true;delays=delays+1;return }
fun frameByte(command: int,arg: int,index: int): int =
    if (index == 0) 64|command else if (index == 5) sdSpiCommandFrameCrc(command,arg)
    else (arg>>>((4-index)*8))&255
fun sdSpiSelectedExchange(context: int,value: int,scratch: NativeBuffer): int {
    calls=calls+1
    val expected=if (calls >= 2 && calls <= 7) frameByte(24,argument,calls-2)
        else if (calls == 9) 254 else if (calls == 522) 127 else if (calls == 523) 161
        else if (calls >= 527 && calls <= 532) frameByte(13,0,calls-527) else 255
    // Busy/response timeout variants stop before the ordinary next command.
    if (context != 123 || (variant != 1 && variant != 3 && variant != 5 && value != expected)) bad=true
    if (calls == failAt) return 263
    val input=if (variant == 1) 0 else
        if (calls == 8) (if (variant == 2) 4 else 0) else
        if (calls == 524) (if (variant == 3) 255 else if (variant == 4) 11 else 5) else
        if (variant == 3 && calls > 524) 255 else
        if (calls == 525 || (variant == 5 && calls >= 525)) 0 else
        if (calls == 533) (if (variant == 6) 4 else 0) else
        if (calls == 534) (if (variant == 7) 32 else 0) else 255
    return (1<<32)|input
}
fun resetWrite(): void { calls=0;failAt=0;variant=0;bad=false;delays=0;return }
@export("abla_sd_selected_write_test")
trusted fun testWrite(): i32 {
    val scratch=nativeBufferAt(memory,2);val source=nativeBufferAt(memory+4,512)
    var index=0
    while (index < 512) { source.store(index,255);index=index+1 }
    var mode=0
    while (mode < 2) {
        resetWrite();argument=if (mode == 0) 1536 else 3
        val result=sdSpiWriteBlockSelected(123,mode == 1,3,scratch,source,4)
        if (!result.valid() || !result.mayHaveWritten() || result.transmittedBytes() != 512 || calls != 534 || delays != 1 || bad) return i32(1)
        mode=mode+1
    }
    var failure=1
    while (failure <= 534) {
        resetWrite();argument=3;failAt=failure
        val result=sdSpiWriteBlockSelected(123,true,3,scratch,source,4)
        val count=if (failure <= 10) 0 else if (failure <= 522) failure-10 else 512
        if (result.status() != 4 || result.transportDetail() != 263 || result.transmittedBytes() != count ||
            result.mayHaveWritten() != (failure >= 9) || calls != failure || bad) return i32(2)
        failure=failure+1
    }
    var kind=1
    while (kind <= 7) {
        resetWrite();variant=kind
        val result=sdSpiWriteBlockSelected(123,true,3,scratch,source,4)
        val expected=if (kind == 1 || kind == 5) 5 else if (kind == 2) 3 else if (kind == 3) 6 else if (kind == 4) 7 else 8
        val expectedCalls=if (kind == 1) 4 else if (kind == 2) 8 else if (kind == 3) 531 else if (kind == 4) 524 else if (kind == 5) 528 else if (kind == 6) 533 else 534
        val detail=if (kind == 2 || kind == 6) 4 else if (kind == 4) 11 else if (kind == 7) 32 else 0
        if (result.status() != expected || result.cardDetail() != detail || calls != expectedCalls ||
            result.mayHaveWritten() != (kind >= 3) || bad) return i32(3)
        kind=kind+1
    }
    resetWrite()
    if (sdSpiWriteBlockSelected(123,false,8388608,scratch,source).status() != 2 ||
        sdSpiWriteBlockSelected(123,true,4294967296,scratch,source).status() != 2 ||
        sdSpiWriteBlockSelected(123,true,3,scratch,nativeBufferAt(memory+1,512)).status() != 2 ||
        sdSpiWriteBlockSelected(123,true,3,scratch,nativeBufferAt(memory+4,511)).status() != 2 ||
        sdSpiWriteBlockSelected(0,true,3,scratch,source).status() != 2 || calls != 0) return i32(4)
    index=0
    while (index < 512) { if (source.load(index) != 255) return i32(5);index=index+1 }
    return i32(0)
}
