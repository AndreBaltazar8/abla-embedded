import "../src/m5stack/tab5_panel_detect_esp32p4.ab"
import "../src/m5stack/tab5_panel_start_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_tab5_detect_target")
trusted fun target(bus: int,st: int,probe: M5Tab5TouchProbe,scratch: NativeBuffer,operation: int): int {
    if (operation == 0) return m5BoardTab5.waitTab5TouchOwned(bus,st)|0
    if (operation == 1) return probe.tab5LaneKbps()
    if (operation == 2) return probe.startTab5PanelOwned(0,scratch,10000)|0
    if (operation == 3) return Tab5PanelStart(bus).openVideoOwned(3,0,0,scratch,nativeBufferAt(st,1843200),64,10000)|0
    return probe.identifyTab5PanelOwned(0,scratch,10000)|0
}
