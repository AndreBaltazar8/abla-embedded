import "../src/display/ssd1677_canvas.ab"
import "../src/m5stack/papermono_canvas.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(128)
val pixels=nativeStaticAllocate(128)
val boardStorage=nativeStaticAllocate(96016)
val oracle=nativeStaticU32s([0,48,8,56,16,32,24,40,12,60,4,52,28,44,20,36])
fun expectedGray(gray: int,x: int,y: int): int {
    val sum=gray+nativeAddressLoadU32(oracle,((x&3)+(y&3)*4)*4)-30
    return if (sum < 0) 0 else if (sum >= 256) 3 else sum/64
}
// Independent explicit8-case coordinate oracle for physical13x7.
fun position(x: int,y: int,r: int): int {
    if (r == 0) return x|(y<<16)
    if (r == 1) return (12-y)|(x<<16)
    if (r == 2) return (12-x)|((6-y)<<16)
    if (r == 3) return y|((6-x)<<16)
    if (r == 4) return x|((6-y)<<16)
    if (r == 5) return y|(x<<16)
    if (r == 6) return (12-x)|(y<<16)
    return (12-y)|((6-x)<<16)
}
@export("abla_ssd1677_canvas_test")
trusted fun test(): i32 {
    var gray=0
    while (gray < 256) {
        var i=0
        while (i < 16) {
            if (ssd1677CanvasGray(gray,i&3,i>>2) != expectedGray(gray,i&3,i>>2)) return i32(1)
            i=i+1
        }
        gray=gray+1
    }
    val canvas=nativeBufferAt(memory+8,28)
    val storage=nativeBufferAt(memory,128)
    val source=nativeBufferAt(pixels,128)
    var r=0
    while (r < 8) {
        var i=0
        while (i < 128) { source.store(i,(i*37)&255);i=i+1 }
        var variant=0
        while (variant < 4) {
            i=0
            while (i < 128) { storage.store(i,165);i=i+1 }
            val x=if (variant == 0) 0 else -2
            val y=if (variant == 0) 0 else -1
            val w=if ((r&1) == 0) 13 else 7
            val h=if ((r&1) == 0) 7 else 13
            val fill=if (variant < 2) 137 else -1
            // tightly packed grayscale source, clipped origin retained
            if (!ssd1677CanvasDrawOwned(canvas,13,7,x,y,w,h,r,source,w,fill,true)) return i32(2)
            var py=0
            while (py < h) {
                var px=0
                while (px < w) {
                    val pos=position(px,py,r)
                    if (ssd1677CanvasPosition(13,7,px,py,r) != pos) return i32(3)
                    val nx=pos&65535;val ny=pos>>>16
                    val bit=128>>(nx&7)
                    val initial=(if ((165&bit) != 0) 3 else 0)
                    val expected=if (px >= x+w || py >= y+h) initial else
                        expectedGray(if (fill >= 0) fill else source.load((py-y)*w+px-x),nx,ny)
                    val offset=ny*2+nx/8
                    val actual=(if ((canvas.load(offset)&bit) != 0) 1 else 0)|(if ((canvas.load(offset+14)&bit) != 0) 2 else 0)
                    if (actual != expected || ssd1677CanvasRead(canvas,13,7,px,py,r) != expected) return i32(4)
                    px=px+1
                }
                py=py+1
            }
            i=0
            while (i < 128) {
                if ((i < 8 || i >= 36) && storage.load(i) != 165) return i32(5)
                i=i+1
            }
            i=1
            while (i < 28) { if ((canvas.load(i)&7) != (165&7)) return i32(6);i=i+2 }
            variant=variant+1
        }
        r=r+1
    }
    var i=0
    while (i < 128) { storage.store(i,165);i=i+1 }
    if (ssd1677CanvasDrawOwned(canvas,13,7,0,0,13,7,0,canvas,13,-1,true) ||
        ssd1677CanvasDrawOwned(canvas,13,7,0,0,13,7,0,source,13,256,true) ||
        ssd1677CanvasDrawOwned(canvas,13,7,0,0,13,7,0,source,13,0,false) ||
        ssd1677CanvasDrawOwned(canvas,13,7,0,0,13,7,8,source,13,0,true)) return i32(7)
    i=0
    while (i < 128) { if (storage.load(i) != 165) return i32(8);i=i+1 }
    val boardCanvas=nativeBufferAt(boardStorage+8,96000)
    val all=nativeBufferAt(boardStorage,96016)
    i=0
    while (i < 96016) { all.store(i,165);i=i+1 }
    r=0
    while (r < 8) {
        val width=if ((r&1) == 0) 480 else 800
        val height=if ((r&1) == 0) 800 else 480
        if (!paperMonoCanvasDrawOwned(boardCanvas,0,0,width,height,r,NativeBuffer(0),0,255,true)) return i32(9)
        i=0
        while (i < 96000) { if (boardCanvas.load(i) != 255) return i32(10);i=i+1 }
        if (!paperMonoCanvasDrawOwned(boardCanvas,width-1,height-1,1,1,r,NativeBuffer(0),0,0,true) ||
            paperMonoCanvasRead(boardCanvas,width-1,height-1,r) != 0 ||
            paperMonoCanvasRead(boardCanvas,width-2,height-1,r) != 3) return i32(11)
        val internal=paperMonoCanvasRotation(r)
        val pos=ssd1677CanvasPosition(800,480,width-1,height-1,internal)
        val offset=(pos>>>16)*100+(pos&65535)/8
        val expected=255^(128>>((pos&65535)&7))
        i=0
        while (i < 96000) {
            if (boardCanvas.load(i) != (if (i == offset || i == offset+48000) expected else 255)) return i32(12)
            i=i+1
        }
        r=r+1
    }
    i=0
    while (i < 8) { if (all.load(i) != 165 || all.load(96008+i) != 165) return i32(13);i=i+1 }
    return i32(0)
}
