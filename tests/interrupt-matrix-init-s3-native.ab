import "../src/esp32/interrupt_matrix_init_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var enabled=0
var writes=0
var reads=0
var initial=0
var bad=false
fun esp32S3MatrixInitCore(): int = core
fun esp32S3MatrixInitEnabled(): int = enabled
fun esp32S3MatrixInitRead(address: int): int {
    if (address != (if (core == 0) 0x600C2000 else 0x600C2800)+writes*4 || reads != writes) bad=true
    reads=reads+1; initial
}
fun esp32S3MatrixInitWrite(address: int,value: int): void {
    if (address != (if (core == 0) 0x600C2000 else 0x600C2800)+writes*4 || reads != writes+1 || value != ((initial & 0xFFFFFFE0) | 6)) bad=true
    writes=writes+1; return
}
@export("abla_interrupt_matrix_init_test")
trusted fun matrixTest(): i32 {
    var p=0
    while (p < 64) {
        core=p & 1; initial=0xFFFFFFFF ^ (1<<(p/2)); reads=0; writes=0; bad=false
        if (!esp32S3InterruptMatrixInitOwned(core) || bad || reads != 99 || writes != 99) return i32(1)
        reads=0; writes=0
        if (esp32S3InterruptMatrixInitOwned(core ^ 1) || reads != 0 || writes != 0) return i32(2)
        enabled=1<<(p/2)
        if (esp32S3InterruptMatrixInitOwned(core) || reads != 0 || writes != 0) return i32(3)
        enabled=0; p=p+1
    }
    if (esp32S3InterruptMatrixInitOwned(-1) || esp32S3InterruptMatrixInitOwned(2)) return i32(4)
    i32(0)
}
