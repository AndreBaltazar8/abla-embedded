import "../src/esp32/irq_stack_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var storage=nativeBufferAt(0,0)
var core=0
var enabled=0
var writes=0
var bad=false
var release=false
fun esp32S3IrqStackCore(): int = core
fun esp32S3IrqStackEnabled(): int = enabled
fun esp32S3IrqConfigAddress(): int = 0x3FC8F000
trusted fun esp32S3IrqStackRead(address: int): int = storage.loadU32(address-0x3FC8F000)
trusted fun esp32S3IrqStackWrite(address: int,value: int): void {
    val offset=if (release) (if (writes == 0) 0 else (writes+1)*4) else (if (writes == 4) 0 else (writes+2)*4)
    if (address != 0x3FC8F000+core*32+offset || writes >= 5) bad=true
    storage.storeU32(address-0x3FC8F000,value)
    writes=writes+1; return
}
trusted fun resetIrqStack(): void {
    var i=0
    while (i < 64) { storage.storeU32(i,0); i=i+4 }
    writes=0; enabled=0; bad=false; release=false; return
}
@export("abla_irq_stack_test")
trusted fun irqStackTest(): i32 {
    storage=nativeBufferAt(nativeStaticAllocate(64),64)
    var profile=0
    while (profile < 64) {
        resetIrqStack(); core=profile & 1
        val low=0x3FC90000+profile*1024
        val stack=nativeBufferAt(low,1024)
        if (!esp32S3IrqStackInitializeOwned(stack,core,0x40378000,profile) || bad || writes != 5 ||
            storage.loadU32(core*32) != low+976 || storage.loadU32(core*32+12) != profile) return i32(1)
        writes=0
        if (esp32S3IrqStackInitializeOwned(stack,core,0x40378000,profile) || writes != 0) return i32(2)
        storage.storeU32(core*32+4,1)
        if (esp32S3IrqStackReleaseOwned(core) || writes != 0) return i32(3)
        storage.storeU32(core*32+4,0); release=true
        storage.storeU32(core*32+24,0x40379000)
        if (esp32S3IrqStackReleaseOwned(core) || writes != 0) return i32(9)
        storage.storeU32(core*32+24,0)
        if (!esp32S3IrqStackReleaseOwned(core) || bad || writes != 5 || storage.loadU32(core*32) != 0) return i32(4)
        resetIrqStack(); enabled=1
        if (esp32S3IrqStackInitializeOwned(stack,core,0x40378000,0) || writes != 0) return i32(5)
        enabled=0
        if (esp32S3IrqStackInitializeOwned(stack,core ^ 1,0x40378000,0) || writes != 0) return i32(6)
        val peer=(core ^ 1)*32
        storage.storeU32(peer,low+976); storage.storeU32(peer+16,low); storage.storeU32(peer+20,low+1024)
        if (esp32S3IrqStackInitializeOwned(stack,core,0x40378000,0) || writes != 0) return i32(7)
        resetIrqStack()
        if (esp32S3IrqStackInitializeOwned(nativeBufferAt(low+1,1024),core,0x40378000,0) ||
            esp32S3IrqStackInitializeOwned(nativeBufferAt(low,1023),core,0x40378000,0) ||
            esp32S3IrqStackInitializeOwned(nativeBufferAt(0x3FC8F000,1024),core,0x40378000,0) ||
            esp32S3IrqStackInitializeOwned(nativeBufferAt(0x3FC87000,1024),core,0x40378000,0) ||
            esp32S3IrqStackInitializeOwned(nativeBufferAt(0x3FCFFF00,1024),core,0x40378000,0) ||
            esp32S3IrqStackInitializeOwned(stack,core,0x42000000,0) ||
            esp32S3IrqStackInitializeOwned(stack,core,0x40378001,0) ||
            esp32S3IrqStackInitializeOwned(stack,core,0x40378000,-1) || writes != 0) return i32(8)
        profile=profile+1
    }
    i32(0)
}
