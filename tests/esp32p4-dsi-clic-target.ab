import "../src/esp32/clic_esp32p4.ab"
import "../src/esp32/clic_vectors_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_clic_target")
trusted fun target(line: int,priority: int,trigger: int,vectored: bool,enable: bool): int {
    if (priority == -1) return esp32P4ClicInitializeOwned()
    if (priority == -2) return esp32P4ClicInstallVectorsOwned(line,nativeBufferAt(trigger,192),u32(0),u32(0))
    if (priority == 0) return esp32P4ClicEnableOwned(line,enable)
    return esp32P4ClicConfigureOwned(line,priority,trigger,vectored)
}
