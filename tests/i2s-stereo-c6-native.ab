import "../src/esp32/i2s/standard_tx_c6_sequence.ab"
import "abla/build"
var conf=u32(0)
var frame=u32(0)
var slots=u32(0)
var converter=u32(0)
var fault=0
var writes=0
var drop=0
var bad=false
fun c6I2sClockRead(offset: int): u32 = if (offset == 0) (if (fault == 1) u32(3) else u32(1)) else (if (fault == 2) u32(0) else u32(0x500000))
fun c6I2sRead(offset: int): u32 {
    if (offset == 0x24) return conf|(if (fault == 3) u32(4) else if (fault == 4) u32(256) else u32(0))
    if (offset == 0x2c) return frame
    if (offset == 0x54) return slots
    if (offset == 0x40) return converter
    if (offset == 0x14) return if (fault == 5) u32(1) else u32(0)
    if (offset == 0x20) return if (fault == 6) u32(4) else u32(0)
    if (offset == 0x6c) return if (fault == 7) u32(0) else u32(1)
    bad=true;return u32(0)
}
fun c6I2sWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0x24) conf=value else if (offset == 0x2c) frame=value
    else if (offset == 0x54) slots=value else if (offset == 0x40) converter=value else bad=true
    return
}
@export("abla_i2s_stereo_c6_test")
trusted fun testStereo(): int {
    var data=8
    while (data <= 32) {
        var width=data
        while (width <= 32) {
            var ws=1
            while (ws <= width*2) {
                var variant=0
                while (variant < 10) {
                    val philips=variant%2 != 0
                    conf=u32(0xfffefef8);frame=u32(0xc0001f80);slots=u32(0xffffffff);converter=u32(0xffffffff)
                    writes=0;drop=variant/2;fault=0;bad=false
                    val result=c6I2sConfigureStereoTxOwned(data,width,ws,philips,true)
                    if (result != 1 && (result != drop+4 || writes != drop)) return 1
                    drop=0
                    if (c6I2sConfigureStereoTxOwned(data,width,ws,philips,true) != 1 || bad) return 2
                    val expected=u32(ws-1)|(u32(data-1)<<u32(13))|(u32(width-1)<<u32(18))|(u32(width-1)<<u32(24))|(if (philips) u32(0x20000000) else u32(0))
                    if (frame != (u32(0xc0001f80)|expected) || slots != u32(0xffe10003) || converter != u32(0xfdffffff) ||
                        conf != ((u32(0xfffefef8)&~u32(0x1fbce8))|u32(0x8b000))) return 3
                    variant=variant+1
                }
                ws=ws+1
            }
            width=width+1
        }
        data=data+8
    }
    fault=1
    while (fault <= 7) {
        writes=0
        if (c6I2sConfigureStereoTxOwned(16,16,16,true,true) != (if (fault <= 2) 3 else 4) || writes != 0) return 4
        fault=fault+1
    }
    fault=0;writes=0
    if (c6I2sConfigureStereoTxOwned(7,16,16,true,true) != 2 || c6I2sConfigureStereoTxOwned(32,16,16,true,true) != 2 ||
        c6I2sConfigureStereoTxOwned(16,16,33,true,true) != 2 || c6I2sConfigureStereoTxOwned(16,16,16,true,false) != 2 || writes != 0) return 5
    return 0
}
