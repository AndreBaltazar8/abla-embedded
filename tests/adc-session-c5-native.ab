import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/adc_factory_session_c5_sequence.ab"
val storage=nativeStaticAllocate(104)
var masterGate=u32(0)
var masterBusy=false
trusted fun c5AnalogClockRead(offset: int): u32 {
    if (offset == 0) return masterGate
    if (offset == 4) return u32(4096)
    if ((masterGate&u32(4)) == u32(0)) bad=true
    return if (masterBusy) u32(0x2000000) else u32(0)
}
trusted fun c5AnalogClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (offset != 0) bad=true
    if (writes != drop) masterGate=value
    return
}
var bus=u32(0)
var clock=u32(0)
var divider=u32(0)
var ctrl=u32(0)
var one=u32(0)
var events=u32(0)
var fe=u32(0)
var pmu=u32(0)
var pwdet=u32(0)
var mux=u32(0)
var route=u32(0)
var pad=u32(0)
var latch=u32(0)
var analog0=0
var analog1=0
var analog2=0
var analog8=0
var pin=1
var writes=0
var drop=0
var phase=0
var stalled=false
var bad=false
var fuseVersion=u32(256)
var fuseReads=0
trusted fun c5AdcFuseRead(offset: int): u32 {
    fuseReads=fuseReads+1
    if (offset == 0x4c) return fuseVersion
    if (offset < 0x6c || offset > 0x78 || (offset&3) != 0) bad=true
    return u32(0)
}
trusted fun c5AdcClockRead(offset: int): u32 = if (offset == 0) bus else if (offset == 4) clock else divider
trusted fun c5AdcClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes != drop) { if (offset == 0) bus=value else if (offset == 4) clock=value else divider=value }
    return
}
trusted fun c5AdcRead(offset: int): u32 {
    if ((bus&u32(14)) != u32(4)) bad=true
    return if (offset == 0) ctrl else if (offset == 0x20) one else if (offset == 0x44) events else if (offset == 0x2c) u32(2048) else u32(0)
}
trusted fun c5AdcWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0) ctrl=value
    else if (offset == 0x4c) events=events&~value
    else if (offset == 0x20) {
        if ((value&u32(0x20000000)) != u32(0) && (one&u32(0x20000000)) == u32(0)) phase=1
        if ((value&u32(0x20000000)) == u32(0) && (one&u32(0x20000000)) != u32(0)) { if (phase != 2) bad=true;phase=3 }
        one=value
    } else bad=true
    return
}
trusted fun c5AdcDelayMicros(us: int): void {
    if (us != 3) bad=true
    if (phase == 1) phase=2 else if (phase == 3) { phase=4;if (!stalled) events=events|u32(0x80000000) }
    return
}
trusted fun c5AdcFrontendRead(offset: int): u32 = if (offset == 0) fe else if (offset == 4) pmu else if (offset == 8) pwdet else if (offset == 12) masterGate else if (masterBusy) u32(0x2000000) else u32(0)
trusted fun c5AdcFrontendWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes != drop) {
        if (offset == 0) fe=value
        else if (offset == 4) {
            pmu=value
            // Reset invalidates analog trim; no pre-reset values are restored.
            if ((pmu&u32(0x4000000)) == u32(0)) { analog0=0;analog1=0;analog2=0;analog8=0 }
        } else if (offset == 8) pwdet=value else bad=true
    }
    return
}
trusted fun c5AdcTrimField(reg: int,low: int,high: int,value: int): int {
    if ((masterGate&u32(4)) == u32(0)) bad=true
    if ((pmu&u32(0xc000000)) != u32(0xc000000)) { bad=true;return -1 }
    val original=if (reg == 0) analog0 else if (reg == 1) analog1 else if (reg == 2) analog2 else analog8
    val mask=(1<<(high-low+1))-1
    if (value == -1) return (original>>>low)&mask
    writes=writes+1
    if (writes != drop) {
        val changed=(original&~(mask<<low))|(value<<low)
        if (reg == 0) analog0=changed else if (reg == 1) analog1=changed else if (reg == 2) analog2=changed else if (reg == 8) analog8=changed else bad=true
    }
    return value
}
trusted fun c5GpioRead(address: int): u32 {
    if (address == 0x600960f0 || address == 0x60091df8) return u32(1)
    if (address == 0x600960f4) return u32(0x400000)
    if (address == 0x600b102c || address == 0x600b1028 || address == 0x60091034) return u32(0)
    if (address == 0x60091004) return latch
    if (address == 0x60090000+pin*4) return mux
    if (address == 0x60091ad4+pin*4) return route
    if (address == 0x600910d4+pin*4) return pad
    bad=true;return u32(0)
}
trusted fun c5GpioWrite(address: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x6009103c) return
    if (address == 0x60091008) latch=latch|value else if (address == 0x6009100c) latch=latch&~value
    else if (address == 0x60090000+pin*4) mux=value else if (address == 0x60091ad4+pin*4) route=value else if (address == 0x600910d4+pin*4) pad=value else bad=true
    return
}
trusted fun resetSessionModel(r: NativeBuffer): void {
    masterGate=u32(0);masterBusy=false
    r.storeU32(0,0);bus=u32(0);clock=u32(0x4123);divider=u32(0x455);ctrl=u32(0x40000200);one=u32(0x1a000000);events=u32(0x80000001)
    fe=u32(0);pmu=u32(0xc000000);pwdet=u32(0);mux=u32(29570);route=u32(0x455);pad=u32(4);latch=u32(2)
    analog0=17;analog1=0xa5;analog2=0xf9;analog8=0xff;pin=1;writes=0;drop=0;phase=0;bad=false;stalled=false;fuseVersion=u32(256);fuseReads=0
    return
}
@export("abla_adc_session_c5_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(storage,104)
    var channel=0
    while (channel < 6) {
        var attenuation=0
        while (attenuation < 4) {
            val calibration=esp32c5AdcCalibrationFromFields(channel,attenuation,1,100,20,3)
            var fault=0
            while (fault < 42) {
                masterGate=u32(0);masterBusy=false
                r.storeU32(0,0);bus=u32(0);clock=u32(0x4123);divider=u32(0x455);ctrl=u32(0x40000200);one=u32(0x1a000000);events=u32(1)
                fe=u32(0);pmu=u32(0xc000000);pwdet=u32(0);mux=u32(29570);route=u32(0x455);pad=u32(4);latch=u32(1)<<u32(channel+1)
                analog0=17;analog1=0xa5;analog2=0xf9;analog8=0xff;pin=channel+1;writes=0;drop=fault;phase=0;bad=false;stalled=false
                val opened=c5AdcSessionOpenOwned(r,calibration,0,40000000,true,false)
                // Fault sweep covers acquisition and reverse cleanup. Successful
                // acquisitions exercise the actual composed conversion path.
                if (opened == 1) {
                    drop=0
                    if (c5AdcSessionStartAfterSettlingOwned(r,true) != 1 || c5AdcSessionPollOwned(r,1,true) != 1 || c5AdcSessionRaw(r) != 2048 || c5AdcSessionMillivolts(r) != calibration.millivolts(2048)) return i32(1)
                    stalled=true
                    if (c5AdcSessionStartAfterSettlingOwned(r,true) != 1) return i32(2)
                    val before=writes
                    if (c5AdcSessionPollOwned(r,2,true) != 4 || c5AdcSessionCloseOwned(r,2,true) != 4 || writes != before || r.loadU32(16) != 6) return i32(3)
                    if (c5AdcSessionStartAfterSettlingOwned(r,true) != 2) return i32(4)
                    events=events|u32(0x80000000)
                    // Drop a cleanup write after completed conversion release.
                    if (fault > 0) drop=writes+2
                }
                var closed=c5AdcSessionCloseOwned(r,2,true)
                drop=0
                if (closed != 5) closed=c5AdcSessionCloseOwned(r,2,true)
                if (closed != 5 || r.loadU32(16) != 0 || bad || masterGate != u32(0)) return i32(5)
                if (bus != u32(0) || clock != u32(0x4123) || divider != u32(0x455) || ctrl != u32(0x40000200) || one != u32(0x1a000000) || pmu != u32(0xc000000) || pwdet != u32(0) || mux != u32(29570) || route != u32(0x455) || pad != u32(4) || latch != (u32(1)<<u32(pin))) return i32(6)
                if (analog0 != 17 || analog1 != 0xa5 || analog2 != 0xf9 || analog8 != 0xff) return i32(7)
                fault=fault+1
            }
            attenuation=attenuation+1
        }
        channel=channel+1
    }
    resetSessionModel(r)
    fuseVersion=u32(0)
    if (c5AdcSessionOpenFactoryOwned(r,0,0,0,40000000,true,false,true) != 6 || r.loadU32(0) != 0 || writes != 0) return i32(8)
    fuseReads=0
    if (c5AdcSessionOpenFactoryOwned(r,0,0,0,40000000,true,false,false) != 2 || fuseReads != 0 || writes != 0) return i32(9)
    resetSessionModel(r);pmu=u32(0)
    if (c5AdcSessionOpenFactoryOwned(r,0,0,0,40000000,true,false,true) != 3 || r.loadU32(8) != 0x20004) return i32(10)
    if (c5AdcSessionCloseOwned(r,1,true) != 5 || bus != u32(0)) return i32(11)
    resetSessionModel(r);pmu=u32(0)
    if (c5AdcSessionOpenFactoryOwned(r,0,0,0,40000000,true,true,true) != 1 || c5AdcSessionStartAfterSettlingOwned(r,true) != 1 || c5AdcSessionPollOwned(r,1,true) != 1) return i32(12)
    if (c5AdcSessionMillivolts(r) != esp32c5AdcCalibrationFromFields(0,0,1,0,0,0).millivolts(2048)) return i32(13)
    if (c5AdcSessionCloseOwned(r,1,true) != 5 || pmu != u32(0) || analog0 != 0 || analog1 != 0 || analog2 != 0 || analog8 != 0 || bad) return i32(14)
    var startFault=1
    while (startFault <= 4) {
        resetSessionModel(r)
        if (c5AdcSessionOpenFactoryOwned(r,0,0,0,40000000,true,false,true) != 1) return i32(15)
        drop=writes+startFault
        if (c5AdcSessionStartAfterSettlingOwned(r,true) != 3) return i32(16)
        val primary=r.loadU32(8)
        val count=writes
        drop=0
        val closed=c5AdcSessionCloseOwned(r,1,true)
        if (startFault <= 2) { if (closed != 5 || bus != u32(0)) return i32(17) }
        else if (closed == 5 || writes != count || r.loadU32(16) != 6 || bus != u32(4) || masterGate != u32(4)) return i32(18)
        if (r.loadU32(8) != primary || primary == 0 || bad) return i32(19)
        // Each iteration is a fresh modeled device, NOT forced recovery.
        startFault=startFault+1
    }
    resetSessionModel(r);masterGate=u32(4)
    if (c5AdcSessionOpenFactoryOwned(r,0,0,0,40000000,true,false,true) != 1 || c5AdcSessionCloseOwned(r,1,true) != 5 || masterGate != u32(4)) return i32(20)
    resetSessionModel(r);masterBusy=true
    if (c5AdcSessionOpenFactoryOwned(r,0,0,0,40000000,true,false,true) != 3 || r.loadU32(8) != 0x80005 || bus != u32(0)) return i32(21)
    if (c5AdcSessionCloseOwned(r,1,true) != 3 || masterGate != u32(4)) return i32(22)
    masterBusy=false
    if (c5AdcSessionCloseOwned(r,1,true) != 5 || masterGate != u32(0) || bad) return i32(23)
    return i32(0)
}
