import "../src/esp32/tls/read_sequence_esp32.ab"
var result=u32(0)
var calls=0
var errors=0
var bad=false
trusted fun esp32TlsReadChunk(tls: u32,destination: u32,length: u32): u32 {
    calls=calls+1
    if (tls != u32(123) || destination != u32(456) || length != u32(64)) bad=true
    result
}
trusted fun esp32TlsReadError(tls: u32,error: u32): void {
    errors=errors+1
    if (tls != u32(123) || error != result) bad=true
    return
}
fun main(): int {
    var value=-65536
    while (value <= 64) {
        result=u32(value); calls=0; errors=0; bad=false
        val actual=esp32TlsReadOnce(u32(123),u32(456),u32(64))
        val expected=if (value == -30848) u32(0) else result
        val terminal=value < 0 && value != -30848 && value != -26880 && value != -26752
        if (bad || actual != expected || calls != 1 || errors != (if (terminal) 1 else 0)) return 1
        value=value+1
    }
    0
}
