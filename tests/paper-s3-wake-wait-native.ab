import "./paper-s3-wake-release-native.ab"
import "../src/m5stack/paper_s3_wake_wait_sequence.ab"
@export("abla_paper_s3_wake_wait_test")
fun testWait(): int {
    val scratch=nativeBufferAt(4096,40)
    var sequence=0
    while (sequence < 256) {
        var token=paperS3WakeWait(123)
        var step=0;var failures=0;var state=1
        while (step < 4) {
            val event=(sequence>>>(step*2))&3
            reads=0;waits=0;bad=false
            releaseAfter=if (event == 3) 0 else 9999
            outcome=if (event == 0) -1 else if (event == 1) -2 else 2
            val terminal=state == 3 || state == 4
            val old=token
            token=token.updateOwned(scratch,true)
            if (!terminal) {
                failures=if (event == 0) failures+1 else 0
                state=if (event == 3) 3 else if (failures == 3) 4 else 2
            }
            if (!token.valid() || token.touch() != 123 || token.status() != state || token.failures() != failures || token.retryDelayMilliseconds() != (if (state == 2) 10 else 0) || bad) return 1
            if (terminal && ((token|0) != (old|0) || reads != 0 || waits != 0)) return 2
            if (!terminal && reads != (if (event == 3) 0 else 8)) return 3
            step=step+1
        }
        sequence=sequence+1
    }
    reads=0;waits=0
    val token=paperS3WakeWait(123)
    if (paperS3WakeWait(0).valid() || paperS3WakeWait(4294967296).valid() || !paperS3WakeWait(4294967295).valid() || PaperS3WakeWait((token|0)|(1<<48)).valid()) return 4
    if (token.updateOwned(scratch,false).valid() || token.updateOwned(nativeBufferAt(4096,39),true).valid() || reads != 0 || waits != 0) return 5
    return 0
}
