import "../src/esp32/i2c/hardware_provider_p4.ab"
import "../src/imu/bmi270_device.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(72)
val chip=nativeStaticAllocate(256)
var transfers=0
var failedTransfer=0
var bad=false
trusted fun p4I2cSessionClockOpen(port: int,source: int): int { bad=true;return 0 }
trusted fun p4I2cSessionInitialize(port: int,filter: int): int { bad=true;return 0 }
trusted fun p4I2cSessionPinsOpen(r: NativeBuffer,port: int,sda: int,scl: int,pullup: bool,layout: int): int { bad=true;return 0 }
trusted fun p4I2cSessionClockClose(token: int): int = 4102
trusted fun p4I2cSessionPinsClose(r: NativeBuffer): int = 2
trusted fun p4I2cSessionTiming(port: int,t: P4I2cTiming): int {
    if (port != 0 || t != esp32p4I2cTiming(u32(40000000),u32(400000))) bad=true
    return 1
}
trusted fun p4I2cSessionTransfer(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    transfers=transfers+1
    if (p4HardwareLoad(0) != 1 || port != 0 || address != 105 || prefix < 0 ||
        (prefix != 94 && prefix+written > 256) || prefix+read > 256 || budget != u32(400000000)) { bad=true;return 7 }
    if (transfers == failedTransfer) return 3
    val regs=nativeBufferAt(chip,256)
    if (prefix == 94) {
        if (written != 8192 || read != 0) bad=true
        var at=0
        while (at < written) { if (output.load(at) != nativeBufferAt(bmi270ConfigurationAddress,8192).load(at)) bad=true;at=at+1 }
        uploaded=written;return 1
    }
    if (prefix == 126 && written == 1 && output.load(0) == 182) regs.store(124,1)
    var i=0
    while (i < written) { regs.store(prefix+i,output.load(i));i=i+1 }
    i=0
    while (i < read) { input.store(i,regs.load(prefix+i));i=i+1 }
    if (prefix == 124 && read == 1) { resetPolls=resetPolls+1;input.store(0,if (resetPolls >= resetAfter) 1 else 0) }
    if (prefix == 33 && read == 1) { initPolls=initPolls+1;input.store(0,if (initPolls >= initAfter) 1 else 0) }
    return 1
}
trusted fun seed(): void {
    val r=nativeBufferAt(storage,72);val regs=nativeBufferAt(chip,256)
    var i=0
    while (i < 72) { r.storeU32(i,0);i=i+4 }
    i=0
    while (i < 256) { regs.store(i,0);i=i+1 }
    r.storeU32(0,0x49324234);r.storeU32(4,1);r.storeU32(16,4097);r.storeU32(24,1)
    regs.store(0,36);regs.store(33,1);regs.store(4,50)
    uploaded=0;delays=0;resetPolls=0;initPolls=0;resetAfter=1;initAfter=1
    transfers=0;failedTransfer=0;bad=false;return
}
var uploaded=0
var delays=0
var resetPolls=0
var initPolls=0
var resetAfter=1
var initAfter=1
trusted fun imuDelay(ticks: int): void { if (ticks != 1) bad=true;delays=delays+ticks;return }
val frameStorage=nativeStaticAllocate(24)
@export("abla_p4_hardware_bmi270_test")
trusted fun test(): i32 {
    seed()
    val bus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
    val imu=bmi270(bus)
    if (imu.begin() != 7 || uploaded != 8192 || delays < 3 || bad) return i32(1)
    val startupTransfers=transfers
    val regs=nativeBufferAt(chip,256);val frame=nativeBufferAt(frameStorage,24)
    regs.store(29,192)
    regs.storeU16(12,0x8000);regs.storeU16(14,123);regs.storeU16(16,0x7fff)
    regs.storeU16(18,0xffff);regs.storeU16(20,2);regs.storeU16(22,3)
    frame.storeU32(20,0x12345678)
    if (imu.readFrame(frame) != 3 || frame.loadU32(20) != 0x12345678 || bad) return i32(2)
    val acceleration=imu.accelerationFromFrame(frame)
    if (!acceleration.valid() || acceleration.x() != -32768 || acceleration.y() != 123 || acceleration.z() != 32767) return i32(3)
    regs.store(29,0)
    val before=transfers
    if (imu.readFrame(frame) != 0 || transfers != before+1) return i32(4)
    if (!imu.close() || !bus.close()) return i32(5)
    var fault=1
    while (fault <= startupTransfers) {
        seed();failedTransfer=fault
        val b=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
        val sensor=bmi270(b)
        if (sensor.begin() != 0 || transfers != fault || !sensor.close() || !b.close() || bad) return i32(6)
        fault=fault+1
    }
    seed();regs.store(4,0)
    val absentBus=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
    val absent=bmi270(absentBus)
    // Successful auxiliary identity read of a different value is the genuine
    // optional-sensor absence case, unlike a failed host I2C transaction.
    if (absent.begin() != 3 || nativeBufferAt(storage,72).loadU32(4) != 1 || !absent.close() || !absentBus.close() || bad) return i32(7)
    var boundary=0
    while (boundary < 4) {
        seed()
        if (boundary < 2) resetAfter=16+boundary else initAfter=14+boundary
        val b=i2cHardwareBindOwned(nativeBufferAt(storage,72),u32(40000000),u32(400000000))
        val sensor=bmi270(b)
        if (sensor.begin() != (if ((boundary&1) == 0) 7 else 0) ||
            (boundary < 2 && resetPolls != 16) || (boundary >= 2 && initPolls != 16) ||
            !sensor.close() || !b.close() || bad) return i32(8)
        boundary=boundary+1
    }
    return i32(0)
}
