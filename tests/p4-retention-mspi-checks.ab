import "../src/esp32/power/retention_mspi_p4.ab"
// Register endpoints transcribed separately from hw_ver3 register headers.
fun mspiExpectedStart(psram: bool,n: int): int {
    if (!psram) return if (n == 0) 0x5008d000 else if (n == 1) 0x5008d0c0 else if (n == 2) 0x5008d180 else if (n == 3) 0x5008c000 else if (n == 4) 0x5008c100 else if (n == 5) 0x5008c200 else if (n == 6) 0x5008c384 else 0x5008c180
    return if (n == 0 || n == 12) 0x500e6030 else if (n == 1 || n == 13) 0x500e6014 else if (n == 2) 0x5008e008 else if (n == 3) 0x5008e034 else if (n == 4) 0x5008e0c0 else if (n == 5) 0x5008e168 else if (n == 6) 0x5008e384 else if (n == 7) 0x5008f000 else if (n == 8) 0x5008f098 else if (n == 9) 0x5008f0c0 else if (n == 10) 0x5008f180 else 0x5008f200
}
fun mspiExpectedEnd(psram: bool,n: int): int {
    if (!psram) return if (n == 0) 0x5008d0a4 else if (n == 1) 0x5008d0d4 else if (n == 2) 0x5008d180 else if (n == 3) 0x5008c0d8 else if (n == 4) 0x5008c1a0 else if (n == 5) 0x5008c200 else 0x5008c388
    return if (n == 2) 0x5008e020 else if (n == 3) 0x5008e054 else if (n == 4) 0x5008e0d8 else if (n == 5) 0x5008e1ac else if (n == 6) 0x5008e388 else if (n == 7) 0x5008f03c else if (n == 8) 0x5008f0a4 else if (n == 9) 0x5008f0d4 else if (n == 10) 0x5008f180 else 0x5008f200
}
trusted fun mspiRetentionChecks(c: NativeBuffer,out: NativeBuffer): int {
    var kind=0
    while (kind < 2) {
        val psram=kind == 1
        var node=0
        while (node < (if (psram) 14 else 8)) {
            val command=if (psram) node < 2 || node >= 12 else node == 7
            val address=mspiExpectedStart(psram,node)
            val words=if (command) 0 else (mspiExpectedEnd(psram,node)-address)/4+1
            var terminal=0
            while (terminal < 2) {
                var i=0;while (i < 52) { out.storeU32(i,0x12345678);i=i+4 }
                val next=if (terminal == 0) 0x30200000 else 0
                if (!esp32p4RetentionMspiConfig(c,psram,node,if (command) 0 else 0x30100000,next) || !esp32p4RetentionDescriptorEncode(out,c)) return 30
                val skip=if (psram && node >= 12) 0x20000000 else 0x40000000
                val head=(if (command) 0x20000|skip else words)|(if (terminal == 1) 0x80000000 else 0)
                if (out.loadU32(0) != head || out.loadU32(4) != next || out.loadU32(8) != address || out.loadU32(20) != 0x12345678) return 31
                if (command) {
                    val mask=if (!psram) 64 else if (node == 0 || node == 12) 32768 else 2147483648
                    if (out.loadU32(12) != (if (psram && node >= 12) 0 else mask) || out.loadU32(16) != mask) return 32
                } else {
                    if (out.loadU32(12) != address || out.loadU32(16) != 0x30100000) return 33
                    // No copied span includes either MMU table access register.
                    val base=address&0xfffff000
                    if (address <= base+0x380 && address+words*4 > base+0x37c) return 34
                }
                terminal=terminal+1
            }
            node=node+1
        }
        kind=kind+1
    }
    if (esp32p4RetentionMspiEntries(false,300) != 9 || esp32p4RetentionMspiEntries(false,301) != 1 || esp32p4RetentionMspiEntries(true,300) != 1) return 35
    c.storeU32(0,0xabcdef12)
    if (esp32p4RetentionMspiConfig(c,false,8,0,0) || esp32p4RetentionMspiConfig(c,true,14,0,0) ||
        esp32p4RetentionMspiConfig(c,true,2,0xfffffffc,0) || esp32p4RetentionMspiConfig(c,false,7,0x30100000,0) || c.loadU32(0) != 0xabcdef12) return 36
    return 0
}
