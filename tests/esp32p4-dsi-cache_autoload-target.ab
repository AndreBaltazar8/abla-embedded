import "../src/esp32/cache_autoload_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_cache_autoload_target")
trusted fun autoloadTarget(owner: P4CacheAutoloadOwner,action: int,polls: int): P4CacheAutoloadOwner =
    if (action == 0) p4CacheAutoloadSuspendOwned(polls) else if (action == 1) owner.suspendOwned(polls) else owner.restoreOwned(polls)
