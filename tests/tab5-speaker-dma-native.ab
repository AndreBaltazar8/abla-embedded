import "../src/m5stack/tab5_speaker_dma_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
import "abla/runtime/scalar"
import "../src/hal/m5stack.ab"
import "../src/hal/esp32.ab"
var step=0
var fail=0
var channel=0
var bad=false
@export("p4AhbDescriptorWrite")
trusted fun p4AhbDescriptorWriteHook(a: int,v: int): void { bad=true;return }
trusted fun next(expected: int): bool {
    step=step+1
    if (step != expected) bad=true
    return step != fail
}
@export("p4Tab5SpeakerParked")
trusted fun p4Tab5SpeakerParkedHook(c: int): int { if (c != channel) bad=true;return if (next(1)) 1 else 0 }
@export("p4Tab5SpeakerBus")
trusted fun p4Tab5SpeakerBusHook(): int = if (next(2)) 1 else 7
trusted fun p4Tab5SpeakerI2sStopped(): bool = next(3)
@export("p4Tab5SpeakerReset")
trusted fun p4Tab5SpeakerResetHook(): int = if (next(4)) 1 else 7
@export("p4Tab5SpeakerDmaPrepare")
trusted fun p4Tab5SpeakerDmaPrepareHook(c: int): int { if (c != channel) bad=true;return if (next(5)) 1 else 7 }
@export("p4Tab5SpeakerFormat")
trusted fun p4Tab5SpeakerFormatHook(revision: int): int { if (revision != 100) bad=true;return if (next(6)) 1 else 7 }
@export("p4Tab5SpeakerPins")
trusted fun p4Tab5SpeakerPinsHook(): int = if (next(7)) 1 else 7
fun spans(d: int,n: int,b: int,s: int,bytes: int): bool = d == 0x4ff00000 && n == 3 && b == 0x4ff40000 && s == 128 && bytes == 64
@export("p4Tab5SpeakerRing")
trusted fun p4Tab5SpeakerRingHook(d: int,n: int,b: int,s: int,bytes: int): bool { if (!spans(d,n,b,s,bytes)) bad=true;return next(8) }
@export("p4Tab5SpeakerPublish")
trusted fun p4Tab5SpeakerPublishHook(d: int,n: int,b: int,s: int,bytes: int,polls: int): int {
    if (!spans(d,n,b,s,bytes) || polls != 17) bad=true
    return if (next(9)) 1 else 7
}
@export("abla_tab5_speaker_dma_test")
trusted fun test(): i32 {
    while (channel < 3) {
        fail=0
        while (fail <= 9) {
            step=0;bad=false
            val result=tab5PrepareSpeakerDmaOwned(channel,0x4ff00000,3,0x4ff40000,128,64,100,17,true)
            val expected=if (fail == 0) 1 else (fail+2)|(if (fail == 1 || fail == 3 || fail == 8) 0 else 7 << 8)
            if (result != expected || step != (if (fail == 0) 9 else fail) || bad) return i32(1)
            fail=fail+1
        }
        channel=channel+1
    }
    step=0
    if (tab5PrepareSpeakerDmaOwned(0,0x4ff00000,3,0x4ff40000,128,64,100,17,false) != 2 ||
        tab5PrepareSpeakerDmaOwned(3,0x4ff00000,3,0x4ff40000,128,64,100,17,true) != 2 ||
        tab5PrepareSpeakerDmaOwned(0,0x4ff00000,3,0x4ff40000,128,63,100,17,true) != 2 ||
        tab5PrepareSpeakerDmaOwned(0,0x4ff00000,3,0x4ff00040,128,64,100,17,true) != 2 ||
        tab5PrepareSpeakerDmaOwned(0,0x4ff00000,1,0x4ff40000,128,64,100,17,true) != 2 || step != 0) return i32(2)
    return i32(0)
}
