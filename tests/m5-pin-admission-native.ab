import "../src/m5stack/pin_map_shared.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this|0
@export("abla_m5_pin_admission_test")
fun testPinAdmission(): i32 {
    var value=-260
    while (value <= 520) {
        val expected=if (value >= 0 && value < 255) value else -1
        val bus=m5I2cPinMap(1,value,value,2);val port=m5PortPins(1,value)
        if (bus.internalData() != expected || bus.externalClock() != expected || port.pin2().number() != expected ||
            bus.hasInternal() != (expected >= 0 && expected != 1) || bus.hasExternal() != (expected >= 0 && expected != 2) || port.available() != (expected >= 0 && expected != 1)) return i32(1)
        val sd=m5SdPinMap(value,value,value,value,value,value)
        var index=0;while (index < 6) { if (sd.entryNumber(index) != expected) return i32(2);index=index+1 }
        if (sd.available() || sd.usesSdmmcFourBit()) return i32(3)
        value=value+1
    }
    var slot=0
    while (slot < 6) {
        value=-1
        while (value <= 6) {
            val sd=m5SdPinMap(if (slot == 0) value else 0,if (slot == 1) value else 1,if (slot == 2) value else 2,if (slot == 3) value else 3,if (slot == 4) value else 4,if (slot == 5) value else 5)
            val available=slot >= 3 || (value >= 0 && (value >= 3 || value == slot))
            val four=value == slot || value == 6
            if (sd.available() != available || sd.usesSdmmcFourBit() != four) return i32(4)
            value=value+1
        }
        slot=slot+1
    }
    if (!m5SdPinMap(1,2,3,-1,-1,-1).available() || m5SdPinMap(1,2,3,-1,-1,-1).usesSdmmcFourBit()) return i32(5)
    // All existing registry descriptors retain their previous availability;
    // stricter admission affects malformed caller-created maps only.
    var id=0
    while (id < 256) {
        val board=M5BoardId(id);val bus=board.i2cPins();val sd=board.sdPins()
        if (bus.hasInternal() != (bus.internalClock() >= 0) || bus.hasExternal() != (bus.externalClock() >= 0) || sd.available() != (sd.clock().number() >= 0) || sd.usesSdmmcFourBit() != (sd.data1().number() >= 0) ||
            board.portA().available() != (board.portA().pin1().number() >= 0) || board.portB().available() != (board.portB().pin1().number() >= 0) || board.portC().available() != (board.portC().pin1().number() >= 0) || board.portD().available() != (board.portD().pin1().number() >= 0) || board.portE().available() != (board.portE().pin1().number() >= 0)) return i32(7)
        id=id+1
    }
    if (!m5BoardTab5X.sdPins().usesSdmmcFourBit() || !m5BoardPaperMono.sdPins().usesSdmmcFourBit() || m5BoardStackCore2.sdPins().usesSdmmcFourBit() ||
        m5BoardTab5X.portA().pin1().number() != 54 || m5BoardStackCore2.sdPins().spiMiso().number() != 38 || m5BoardUnknown.i2cPins().hasInternal()) return i32(6)
    return i32(0)
}
