import "../src/touch/st7123_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(74)
var mask=0
var calls=0
var fail=0
var coordinate=true
var zero=false
trusted fun st7123Read(handle: int,register: int,buffer: NativeBuffer,count: int): bool {
    calls=calls+1
    var i=0
    while (i < count) { buffer.store(i,if (zero) 0 else 255); i=i+1 }
    if (register == 16) buffer.store(0,if (coordinate) 8 else 0)
    if (register == 9) buffer.store(0,10)
    if (register == 20) {
        i=0
        while (i < 10) { buffer.store(i*7,if ((mask&(1<<i)) != 0) 255 else 0); i=i+1 }
    }
    calls != fail
}
@export("abla_st7123_test")
trusted fun testSt(): i32 {
    val buffer=nativeBufferAt(storage+1,72)
    while (fail <= 3) {
        calls=0
        if (st7123BeginOwned(123,buffer) != (fail == 0) || calls != (if (fail == 0) 3 else fail)) return i32(1)
        fail=fail+1
    }
    fail=0; zero=true; calls=0
    if (st7123BeginOwned(123,buffer)) return i32(2)
    zero=false
    while (mask < 1024) {
        val count=st7123ReadOwned(123,buffer)
        var index=0
        var slot=0
        while (slot < 10) {
            if ((mask&(1<<slot)) != 0) {
                val point=st7123Point(buffer,index)
                if (!point.valid() || point.id() != slot || point.x() != 16383 || point.y() != 65535 || point.size() != 255) return i32(3)
                index=index+1
            }
            slot=slot+1
        }
        if (count != index || st7123Point(buffer,index).valid()) return i32(4)
        mask=mask+1
    }
    fail=1
    while (fail <= 3) { calls=0; if (st7123ReadOwned(123,buffer) != -1) return i32(5); fail=fail+1 }
    fail=0; coordinate=false; calls=0
    if (st7123ReadOwned(123,buffer) != -2 || calls != 1) return i32(6)
    i32(0)
}
