import "./epd-gates-native.ab"
import "../src/display/epd_gate_pins_s3_sequence.ab"
val gateOwner=nativeStaticAllocate(44)
var gateCaptured=0
var gatePreparedCount=0
var gateParked=0
var gateRestored=0
var gatePrepareFail=0
var gateParkFail=0
var gateRestoreFail=0
var gateOwnerBad=false
fun gateOwnerIndex(number: int): int {
    var i=0
    val pins=epdGatePins(46,17,18,45,15)
    while (i < 5) { if (pins.pin(i) == number) return i;i=i+1 }
    return -1
}
fun epdGatePinValid(number: int): bool = gateOwnerIndex(number) >= 0
fun epdGatePinCapture(number: int): S3GpioSnapshot {
    if (gatePreparedCount != 0 || gateOwnerIndex(number) != gateCaptured) gateOwnerBad=true
    gateCaptured=gateCaptured+1
    return S3GpioSnapshot((1<<29)|(number<<23)|gateCaptured)
}
fun epdGatePinPrepareLow(number: int): bool {
    if (gateCaptured != 5 || gateOwnerIndex(number) != gatePreparedCount) gateOwnerBad=true
    gatePreparedCount=gatePreparedCount+1
    return gatePreparedCount != gatePrepareFail
}
fun epdGatePinPark(number: int): bool {
    val index=gateOwnerIndex(number)
    if (index != gateParked || gateRestored != 0) gateOwnerBad=true
    if (index+1 == gateParkFail) return false
    gateParked=gateParked+1;return true
}
fun epdGatePinRestore(saved: S3GpioSnapshot): int {
    val index=gateOwnerIndex(saved.pin())
    if (gateParked != 5 || index != gateRestored || (saved&65535) != index+1) gateOwnerBad=true
    if (index+1 == gateRestoreFail) return 2
    gateRestored=gateRestored+1;return 1
}
@export("abla_epd_gate_pins_test")
fun testGatePins(): int {
    val r=nativeBufferAt(gateOwner,44);val pins=epdGatePins(46,17,18,45,15)
    var setupFail=0
    while (setupFail <= 5) {
        var cleanupFail=0
        while (cleanupFail <= 5) {
            r.storeU32(0,0);r.storeU32(40,0x12345678)
            gateCaptured=0;gatePreparedCount=0;gateParked=0;gateRestored=0;gateOwnerBad=false
            gatePrepareFail=setupFail;gateParkFail=cleanupFail;gateRestoreFail=cleanupFail
            if (epdGatePinsOpenOwned(r,pins,false) != 0 || gateCaptured != 0) return 1
            if (epdGatePinsOpenOwned(r,pins,true) != (if (setupFail == 0) 1 else 3) || gateCaptured != 5 ||
                gatePreparedCount != (if (setupFail == 0) 5 else setupFail)) return 2
            if (epdGatePinsOpenOwned(r,pins,true) != 0 || epdGatePinsCloseOwned(r,false) != 0 || gateParked != 0) return 3
            if (epdGatePinsCloseOwned(r,true) != (if (cleanupFail == 0) 2 else 3)) return 4
            if (cleanupFail != 0) {
                if (gateParked != cleanupFail-1 || gateRestored != 0 || r.loadU32(4) != 3) return 5
                gateParkFail=0
                if (epdGatePinsCloseOwned(r,true) != 3 || gateParked != 5 || gateRestored != cleanupFail-1 || r.loadU32(4) != 4) return 6
                gateRestoreFail=0
                if (epdGatePinsCloseOwned(r,true) != 2) return 7
            }
            if (gateParked != 5 || gateRestored != 5 || gateOwnerBad || r.loadU32(40) != 0x12345678 ||
                epdGatePinsCloseOwned(r,true) != 2) return 8
            cleanupFail=cleanupFail+1
        }
        setupFail=setupFail+1
    }
    return 0
}
