import "../src/m5stack/cores3_channels_pump_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val pumpBank=nativeStaticAllocate(32)
val pumpSource=nativeStaticAllocate(2)
val pumpMeta=nativeStaticAllocate(20)
val pumpAcc=nativeStaticAllocate(1920)
val pumpScratch=nativeStaticAllocate(960)
val pumpStage=nativeStaticAllocate(960)
val toneMemory=nativeStaticAllocate(40)
val savedStage=nativeStaticAllocate(960)
var calls=0
var outcome=3
type PumpResult = int
fun PumpResult.status(): int = this & 255
fun PumpResult.transferredBytes(): int = 960
fun PumpResult.nextIndex(): int = (this >>> 8) & 7
fun esp32s3GdmaRingLayoutValid(d: int,n: int,b: int,size: int,stride: int): bool =
    d == 0x3fc88000 && b == 0x3fc90000 && n == 6 && size == 960 && stride == 960
trusted fun esp32s3GdmaPumpBlock(ch: int,tx: bool,d: int,n: int,index: int,buffer: NativeBuffer,bytes: int,polls: int): PumpResult {
    calls=calls+1
    PumpResult(outcome | ((if (index == 5) 0 else index+1) << 8))
}
@export("abla_cores3_channels_pump_test")
trusted fun pumpTest(): i32 {
    nativeBufferAt(pumpSource,2).storeU16(0,1000)
    val wav=pcmRaw(nativeBufferAt(pumpSource,2),nativeBufferAt(pumpMeta,20),16000,1,16)
    val bank=pcmChannelsAt(nativeBufferAt(pumpBank,32),1,16000)
    if (bank.enqueue(wav,1000) != 0) return i32(1)
    val acc=nativeBufferAt(pumpAcc,1920)
    val scratch=nativeBufferAt(pumpScratch,960)
    val staging=nativeBufferAt(pumpStage,960)
    var state=CoreS3ChannelsPump(0)
    var i=0
    while (i < 3) {
        state=cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging)
        if (state.status() != 3 || !state.pending() || state.index() != 0 || bank.channel(0).storage().loadU32(12) != 760) return i32(2)
        i=i+1
    }
    outcome=1
    state=cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging)
    if (state.status() != 1 || state.pending() || state.index() != 1 || bank.channel(0).storage().loadU32(12) != 760) return i32(3)
    outcome=4
    state=cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging)
    if (state.status() != 4 || !state.pending() || bank.channel(0).storage().loadU32(12) != 520) return i32(4)
    state=cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging)
    if (calls != 5 || state.status() != 4) return i32(5)
    bank.stop()
    val tone=pcmToneWaveAt(nativeBufferAt(toneMemory,40),nativeBufferAt(pcmToneWave,16),false,16000,440123,4294967295)
    state=CoreS3ChannelsPump(0);outcome=3;calls=0
    state=cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging,32768,tone)
    val phase=tone.storage().loadU32(12)
    if (state.status() != 3 || !state.pending() || phase != (240*440123)%16000000) return i32(6)
    val sourceAddress=tone.storage().loadU32(32)
    tone.storage().storeU32(32,pumpStage)
    val beforeAlias=calls
    if (cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging,32768,tone).status() != 2 ||
        calls != beforeAlias || tone.storage().loadU32(12) != phase) return i32(14)
    tone.storage().storeU32(32,sourceAddress)
    val saved=nativeBufferAt(savedStage,960)
    i=0
    while (i < 960) { saved.store(i,staging.load(i));i=i+1 }
    var retry=0
    while (retry < 3) {
        state=cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging,32768,tone)
        if (state.status() != 3 || tone.storage().loadU32(12) != phase) return i32(7)
        i=0
        while (i < 960) { if (saved.load(i) != staging.load(i)) return i32(8);i=i+1 }
        retry=retry+1
    }
    outcome=1
    state=cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging,32768,tone)
    if (state.status() != 1 || state.index() != 1 || tone.storage().loadU32(12) != phase) return i32(9)
    outcome=4
    state=cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging,32768,tone)
    val after=tone.storage().loadU32(12)
    if (state.status() != 4 || after != (480*440123)%16000000) return i32(10)
    val beforeCalls=calls
    state=cores3PumpChannels(state,bank,0,0x3fc88000,0x3fc90000,acc,scratch,staging,32768,tone)
    if (calls != beforeCalls || tone.storage().loadU32(12) != after) return i32(11)
    val aliasRetry=cores3PumpChannels(CoreS3ChannelsPump(2051),bank,0,0x3fc88000,0x3fc90000,acc,scratch,
        nativeBufferAt(toneMemory,960),32768,tone)
    if (aliasRetry.status() != 2 || calls != beforeCalls || tone.storage().loadU32(12) != after) return i32(13)
    state=cores3PumpChannels(CoreS3ChannelsPump(0),bank,0,0x3fc88000,0x3fc90000,acc,scratch,
        nativeBufferAt(toneMemory,960),32768,tone)
    if (state.status() != 2 || calls != beforeCalls || tone.storage().loadU32(12) != after) return i32(12)
    i32(0)
}
