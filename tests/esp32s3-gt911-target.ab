import "../src/esp32/i2c_esp32s3.ab"
import "../src/touch/gt911_device.ab"
import "../src/touch/transform.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_gt911_test")
trusted fun gt911TargetTest(busKey: int, operation: i32): int {
    val touch = gt911(I2cBus(busKey))
    var result = -1
    if (operation == i32(0)) result = if (touch.begin()) 0 else -1
    if (operation == i32(1)) result = if (touch.sleepCommand()) 0 else -1
    if (operation == i32(3)) result = if (touch.setMaximumContacts(5)) 0 else -1
    if (operation == i32(4)) result = if (touch.refreshConfiguration()) 0 else -1
    if (operation == i32(2)) {
        val frame = nativeBufferAt(nativeStackAllocate(40), 40)
        result = touch.readFrame(frame)
        if (result > 0) {
            val point = gt911FramePoint(frame, result, 0).rotated(65536, 65536, 1)
            result = if (point.valid()) point.x() | (point.y() << 16) else -1
        }
    }
    if (!touch.close()) return -1
    result
}
