import "../src/m5stack/pm1_imu_open_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var status=1
var expectedBus=8589934590
var admitted=true
var bad=false
fun pm1BoardImuAdmission(control: int,imu: M5ImuOwner): bool = admitted && control == 7 && (imu|0) == 99
fun pm1BoardImuBus(control: int): int { if (control != 7) bad=true;return expectedBus }
fun pm1BoardImuProbe(imu: M5ImuOwner,bus: int): int {
    if ((imu|0) != 99 || bus != expectedBus) bad=true
    calls=calls+1;return status
}
@export("abla_pm1_board_imu_test")
fun test(): i32 {
    var variant=0
    while (variant < 2) {
        expectedBus=if (variant == 0) 4294967293 else 8589934590
        status=-1
        while (status <= 6) {
            calls=0;bad=false
            if (pm1BoardImuOpenPreparedOwned(7,M5ImuOwner(99),true) != status || calls != 1 || bad) return i32(1)
            status=status+1
        }
        variant=variant+1
    }
    calls=0
    if (pm1BoardImuOpenPreparedOwned(7,M5ImuOwner(99),false) != -1 ||
        pm1BoardImuOpenPreparedOwned(0,M5ImuOwner(99),true) != -1 ||
        pm1BoardImuOpenPreparedOwned(7,M5ImuOwner(0),true) != -1 || calls != 0) return i32(2)
    admitted=false
    if (pm1BoardImuOpenPreparedOwned(7,M5ImuOwner(99),true) != -1 || calls != 0) return i32(3)
    return i32(0)
}
