import "../src/esp32/i2s/dma_session_p4_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
import "abla/build"
val storage=nativeStaticAllocate(128)
var calls=0
var dmaStart=1
var i2sStart=1
var i2sStop=1
var dmaStop=1
var idle=true
var pump=1 | (64 << 16) | 0x10000000
var bad=false
trusted fun p4AhbDescriptorWrite(a: int,v: int): void { bad=true;return }
trusted fun p4I2sSessionDmaStart(r: NativeBuffer): int {
    if (r.loadU32(4) != 3 || r.loadU32(56) != 1 || r.loadU32(60) != 0) bad=true
    calls=calls+1;return dmaStart
}
trusted fun p4I2sSessionI2sStart(r: NativeBuffer): int {
    if (r.loadU32(4) != 3 || r.loadU32(56) != 1 || r.loadU32(60) != 1) bad=true
    calls=calls+1;return i2sStart
}
trusted fun p4I2sSessionPump(r: NativeBuffer,cpu: NativeBuffer): int {
    if (r.loadU32(4) != 2 || r.loadU32(56) != 1 || r.loadU32(60) != 1) bad=true
    calls=calls+1;return pump
}
trusted fun p4I2sSessionI2sStop(r: NativeBuffer): int {
    if (r.loadU32(4) != 3 || r.loadU32(60) != 1) bad=true
    calls=calls+1;return i2sStop
}
trusted fun p4I2sSessionDmaStop(r: NativeBuffer): int {
    if (r.loadU32(4) != 3 || r.loadU32(60) != 0 || r.loadU32(56) != 1) bad=true
    calls=calls+1;return dmaStop
}
trusted fun p4I2sSessionCacheIdle(): bool { calls=calls+1;return idle }
trusted fun p4I2sSessionStoppedFence(): void { if (!idle) bad=true;return }
trusted fun attach(r: NativeBuffer,tx: bool): bool {
    r.storeU32(0,0);calls=0;bad=false;dmaStart=1;i2sStart=1;i2sStop=1;dmaStop=1;idle=true
    return esp32p4I2sDmaSessionAttachOwned(r,2,tx,1,0x4ff00000,3,0x4ff40000,128,64,7,true) == 1
}
@export("abla_i2s_dma_session_p4_test")
trusted fun test(): i32 {
    val r=nativeBufferAt((storage+63)&0xffffffc0,64)
    val cpu=nativeBufferAt(0x20000000,64)
    var direction=0
    while (direction < 2) {
        if (!attach(r,direction == 1) || esp32p4I2sDmaSessionStartOwned(r,true) != 2 || calls != 2 || bad) return i32(1)
        var n=0
        while (n < 12) {
            pump=3
            val cursor=r.loadU32(40)
            if (esp32p4I2sDmaSessionPumpOwned(r,cpu,true) != 2 || r.loadU32(40) != cursor) return i32(2)
            pump=1 | (64 << 16) | 0x10000000
            if (esp32p4I2sDmaSessionPumpOwned(r,cpu,true) != 2 || r.loadU32(40) != (n+1)%3) return i32(3)
            n=n+1
        }
        pump=5 | (6 << 8) | (64 << 16) | 0xb0000000 | (129 << 32)
        if (esp32p4I2sDmaSessionPumpOwned(r,cpu,true) != 3 || r.loadU32(52) != 129 || r.loadU32(48) != (pump & 0xffffffff)) return i32(4)
        calls=0
        if (esp32p4I2sDmaSessionPumpOwned(r,cpu,true) != 0 || esp32p4I2sDmaSessionStartOwned(r,true) != 0 || calls != 0) return i32(5)
        i2sStop=5
        if (esp32p4I2sDmaSessionStopOwned(r,true) != 3 || calls != 1 || r.loadU32(60) != 1 || r.loadU32(56) != 1) return i32(6)
        i2sStop=1;dmaStop=3;calls=0
        if (esp32p4I2sDmaSessionStopOwned(r,true) != 3 || calls != 2 || r.loadU32(60) != 0 || r.loadU32(56) != 1) return i32(7)
        dmaStop=1;idle=false;calls=0
        if (esp32p4I2sDmaSessionStopOwned(r,true) != 3 || calls != 2 || r.loadU32(56) != 0) return i32(8)
        idle=true;calls=0
        if (esp32p4I2sDmaSessionStopOwned(r,true) != 4 || calls != 1 || r.loadU32(52) != 129 || bad) return i32(9)
        calls=0
        if (esp32p4I2sDmaSessionStopOwned(r,true) != 4 || calls != 0) return i32(10)
        var stage=0
        while (stage < 2) {
            if (!attach(r,direction == 1)) return i32(11)
            if (stage == 0) dmaStart=8 else i2sStart=5
            if (esp32p4I2sDmaSessionStartOwned(r,true) != 3 || calls != stage+1 || r.loadU32(56) != 1 || r.loadU32(60) != stage) return i32(12)
            if (esp32p4I2sDmaSessionStopOwned(r,true) != 4 || bad) return i32(13)
            stage=stage+1
        }
        if (!attach(r,direction == 1) || esp32p4I2sDmaSessionStartOwned(r,true) != 2) return i32(14)
        calls=0
        if (esp32p4I2sDmaSessionPumpOwned(r,r,true) != 0 || esp32p4I2sDmaSessionPumpOwned(r,cpu,false) != 0 ||
            esp32p4I2sDmaSessionPumpOwned(r,nativeBufferAt(0x20000000,63),true) != 0 || calls != 0) return i32(15)
        if (esp32p4I2sDmaSessionAttachOwned(r,2,true,1,0x4ff00000,3,0x4ff40000,128,64,7,true) != 0) return i32(16)
        direction=direction+1
    }
    return i32(0)
}
