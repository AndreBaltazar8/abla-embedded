import "../src/esp32/peer_notify_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_peer_notify_target")
@section(".iram1.abla.s3PeerNotifyTarget")
trusted fun notifyTarget(address: int,channel: int,serve: bool): int {
    if (serve) return if (esp32S3PeerParkServiceOwned(address,channel)) 1 else 0
    esp32S3PeerParkNotifyOwned(address,channel)
}
