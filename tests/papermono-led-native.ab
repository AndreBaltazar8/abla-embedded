import "../src/led/papermono_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type M5Pm1 = int
type M5Ioe1 = int
type I2cDevice = int
fun M5Pm1.valid(): bool = this != 0
fun M5Ioe1.valid(): bool = this != 0
fun M5Pm1.device(): I2cDevice = I2cDevice(this & 4294967295)
var calls = 0
var failAt = 0
var bad = false
trusted fun step(): bool { calls = calls + 1; calls != failAt }
trusted fun I2cDevice.updateRegister8(reg: int, mask: int, value: int): bool { if (calls != 0 || reg != 19 || mask != 32 || value != 0) bad = true; step() }
trusted fun M5Ioe1.setDirection(pin: int, output: bool): bool { if (pin != calls + 7 || !output) bad = true; step() }
trusted fun M5Ioe1.setHighImpedance(pin: int, enabled: bool): bool { if (pin != calls + 5 || enabled) bad = true; step() }
trusted fun M5Pm1.setLedEnableLevel(high: bool): bool { if (calls != 0 || !high) bad = true; step() }
trusted fun M5Ioe1.digitalWrite(pin: int, high: bool): bool { if (pin != calls + 7 || high != (pin == 8)) bad = true; step() }
trusted fun M5Ioe1.setPwmDuty12(channel: int, duty: int, inverted: bool, enabled: bool): bool { if (calls != 3 || channel != 1 || duty != 4095 || inverted || !enabled) bad = true; step() }
trusted fun paperMonoLedTest(): int {
    while (failAt <= 5) {
        calls = 0
        if (paperMonoLedConfigure(M5Pm1(1), M5Ioe1(1)) != (failAt == 0) || calls != (if (failAt == 0) 5 else failAt) || bad) return 1
        failAt = failAt + 1
    }
    failAt = 0
    while (failAt <= 4) {
        calls = 0
        if (paperMonoLedWrite(M5Pm1(1), M5Ioe1(1), 255, 255, 0, 255) != (failAt == 0) || calls != (if (failAt == 0) 4 else failAt) || bad) return 2
        failAt = failAt + 1
    }
    var brightness = 0
    while (brightness <= 255) {
        var component = 0
        while (component <= 255) {
            val raw = component * (brightness + 1) * (brightness + 1) / 256
            val expected = (if (raw >= 2048) 7 else 0) | ((if (raw > 4095) 4095 else raw) << 3)
            if (paperMonoLedLevels(component, component, component, brightness) != expected) return 3
            component = component + 1
        }
        brightness = brightness + 1
    }
    calls = 0
    if (paperMonoLedWrite(M5Pm1(1), M5Ioe1(1), 256, 0, 0, 255) || paperMonoLedConfigure(M5Pm1(0), M5Ioe1(1)) || calls != 0) return 4
    0
}
#exportFunction("paperMonoLedTest", "abla_papermono_led_test")
