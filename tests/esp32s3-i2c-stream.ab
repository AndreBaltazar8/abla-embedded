import "../src/esp32/i2c/stream_s3_logic.ab"

fun main(): int {
    if (esp32S3I2cStreamPayloadCapacity(true, -1) != 31 ||
        esp32S3I2cStreamPayloadCapacity(false, -1) != 32) return 12
    var prefix = 0
    while (prefix <= 255) {
        if (esp32S3I2cStreamPayloadCapacity(true, prefix) != 30 ||
            esp32S3I2cStreamPayloadCapacity(false, prefix) != -1) return 13
        prefix = prefix + 1
    }
    if (esp32S3I2cStreamPayloadCapacity(true, -2) != -1 ||
        esp32S3I2cStreamPayloadCapacity(true, 256) != -1) return 14
    var flags = 0
    while (flags < 8) {
        val reading = (flags & 1) != 0
        val first = (flags & 2) != 0
        val finish = (flags & 4) != 0
        var count = -1
        while (count <= 33) {
            val valid = count >= (if (reading || !first) 1 else 0) &&
                count <= (if (!reading && first) 31 else 32)
            val last = esp32S3I2cStreamLast(reading, first, finish, count)
            if ((last >= 0) != valid) return 1
            if (valid) {
                var index = 0
                var tx = 0
                var rx = 0
                var starts = 0
                var nacks = 0
                while (index <= last) {
                    val command = esp32S3I2cStreamCommand(reading, first, finish, count, index)
                    if (!esp32S3I2cCommandValid(command)) return 2
                    val op = int((command >>> u32(11)) & u32(7))
                    val bytes = int(command & u32(255))
                    if (op == 1) {
                        tx = tx + bytes
                        if ((command & u32(256)) == u32(0)) return 3
                    }
                    if (op == 3) rx = rx + bytes
                    if (op == 6) starts = starts + 1
                    if ((command & u32(1024)) != u32(0)) {
                        if (bytes != 1 || index != last - 1) return 4
                        nacks = nacks + 1
                    }
                    if (index == last && op != (if (finish) 2 else 4)) return 5
                    if (index != last && (op == 2 || op == 4)) return 6
                    index = index + 1
                }
                if (tx != (if (reading) 0 else count) + (if (first) 1 else 0)) return 7
                if (rx != (if (reading) count else 0)) return 8
                if (starts != (if (first) 1 else 0)) return 9
                if (nacks != (if (reading && finish) 1 else 0)) return 10
            }
            if (esp32S3I2cStreamCommand(reading, first, finish, count, last + 1) != u32(0xffffffff)) return 11
            count = count + 1
        }
        flags = flags + 1
    }
    0
}
