import "../src/storage/fat_read_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1564)
var calls=0
var failure=0
var bad=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,sector: int,destination: NativeBuffer): bool {
    calls=calls+1
    if (sector != 100+calls || destination.capacity() != 512) bad=true
    var index=0
    while (index < 512) { destination.store(index,0); index=index+1 }
    if (calls == 1) destination.store(511,64) else destination.store(0,31)
    return calls != failure
}
@export("abla_fat_read_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(storage,512)
    val reader=nativeBufferAt(storage+512,28)
    val scratch=nativeBufferAt(storage+540,1024)
    var index=0
    while (index < 512) { boot.store(index,0); index=index+1 }
    boot.store(12,2); boot.store(13,1); boot.store(14,1); boot.store(16,1)
    boot.store(18,2); boot.store(22,3); boot.store(19,12); boot.store(20,4)
    boot.store(510,85); boot.store(511,170)
    if (fatReadLinkOwned(reader,boot,100,1036,341,scratch).nextCluster() != 500 || calls != 2 || bad) return i32(1)
    calls=0; failure=1
    if (fatReadLinkOwned(reader,boot,100,1036,341,scratch).status() != 8 || calls != 1) return i32(2)
    calls=0; failure=2
    if (fatReadLinkOwned(reader,boot,100,1036,341,scratch).status() != 8 || calls != 2) return i32(3)
    calls=0; failure=0
    if (fatReadLinkOwned(reader,boot,100,1036,2,scratch).status() != 3 || calls != 1) return i32(4)
    calls=0
    if (fatReadLinkOwned(reader,boot,100,1036,1,scratch).status() != 7 || fatReadLinkOwned(reader,boot,100,1036,341,nativeBufferAt(storage,1024)).status() != 7 ||
        fatReadLinkOwned(reader,boot,100,1036,341,nativeBufferAt(storage+512,1024)).status() != 7 || fatReadLinkOwned(reader,boot,100,1036,341,nativeBufferAt(storage+540,1023)).status() != 7 || calls != 0 || bad) return i32(5)
    return i32(0)
}
