import "../src/esp32/power/sleep_analog_defaults_p4.ab"
import "abla/unsafe/native"
@export("abla_sleep_analog_defaults_p4_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(nativeStaticAllocate(36),36)
    var revision=0
    while (revision <= 300) {
        var options=0
        while (options < 128) {
            val deep=(options&1) != 0;val psram=(options&2) != 0
            val flashOff=(options&4) != 0;val xtalOff=(options&8) != 0
            val rc=(options&16) != 0;val monitor=(options&32) != 0;val fastXtal=(options&64) != 0
            val flags=u32((if (flashOff) 2 else 0)|(if (xtalOff) 1024 else 0)|(if (rc) 1<<25 else 0)|
                (if (monitor) 1<<28 else 0)|(if (fastXtal) 1<<30 else 0))
            r.storeU32(32,0xdeadbeef)
            if (!esp32p4SleepAnalogDefaults(r,flags,revision,deep,psram,19,21,27)) return i32(1)
            val hpDb=if (rc) 21 else if (fastXtal || (!deep && !xtalOff)) 24 else if (deep) 0 else 1
            val lpDb=if (rc) 27 else if (deep) 23 else 12
            val hpSleep=!(monitor || fastXtal || (!deep && !xtalOff))
            val hpPd=hpSleep && !(!deep && psram)
            val lpSleep=deep || xtalOff
            val lpPd=lpSleep && !(!deep && psram)
            val hpExpected=(if (deep) 0 else (19<<18)|(1<<23))|(if (hpSleep) 1<<31 else 0)|(if (hpPd) 1<<30 else 0)
            val lpExpected=(if (deep && !rc) 12<<26 else 0)|(if (lpSleep) 1<<31 else 0)|(if (lpPd) 1<<30 else 0)
            if (r.loadU32(0) != hpExpected || r.loadU32(4) != lpExpected ||
                r.loadU32(8) != ((hpDb<<27)|(if (revision >= 100 && !deep && !flashOff) 1<<22 else 0)) ||
                r.loadU32(12) != 0 || r.loadU32(16) != (((if (deep) 26 else 29)<<27)|(1<<22)) ||
                r.loadU32(20) != (if (deep) 7<<26 else 0) || r.loadU32(24) != ((lpDb<<27)|(1<<22)) ||
                r.loadU32(28) != 0 || r.loadU32(32) != 0xdeadbeef) return i32(2)
            options=options+1
        }
        revision=if (revision == 0) 100 else if (revision == 100) 300 else 400
    }
    var i=0
    while (i < 36) { r.storeU32(i,0xdeadbeef);i=i+4 }
    if (esp32p4SleepAnalogDefaults(r,u32(1),300,false,false,19,21,27) ||
        esp32p4SleepAnalogDefaults(r,u32(0),300,false,false,32,21,27) ||
        esp32p4SleepAnalogDefaults(r,u32(0),300,false,false,19,-1,27)) return i32(3)
    i=0
    while (i < 36) { if (r.loadU32(i) != 0xdeadbeef) return i32(4);i=i+4 }
    return i32(0)
}
