import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/rtc_wake_cleanup.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_wake_cleanup_target")
trusted fun cleanupTarget(rtc: M5Rtc,board: M5BoardId,pmic: M5Pm1,disable: bool): M5RtcCleanupResult =
    if (disable) rtc.disableBoardInterrupts(board,pmic) else rtc.clearBoardInterrupt(board,pmic)
