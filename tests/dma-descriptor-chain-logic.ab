import "../src/esp32/dma_descriptor_chain_logic.ab"

fun main(): int {
    val packed = espDmaDescriptorChainPack(1073418240, 8, 3)
    if (packed < 0) return 1
    if (espDmaDescriptorChainBase(packed) != 1073418240 ||
        espDmaDescriptorChainCount(packed) != 8 ||
        espDmaDescriptorChainIndex(packed) != 3) return 2
    if (espDmaDescriptorChainPack(1073418241, 8, 0) != -1 ||
        espDmaDescriptorChainPack(1073418240, 0, 0) != -1 ||
        espDmaDescriptorChainPack(1073418240, 8, 9) != -1) return 3
    if (!espDmaDescriptorChainLayoutValid(
        1073418240, 8, 1073479680, 1600, 1600
    )) return 4
    if (espDmaDescriptorChainLayoutValid(
        1073418240, 8, 1073479680, 1596, 1600
    )) return 5
    if (espDmaDescriptorChainLayoutValid(
        4294967292, 2, 1073479680, 1600, 1600
    )) return 6
    if (espDmaDescriptorChainLayoutValid(
        1073418240, 2, 4294965696, 1600, 1600
    )) return 7
    70
}
