import "../src/esp32/spi/buffer_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun spiCpuBufferTarget(peripheral: u32, address: u32, bytes: u32, receive: bool): bool =
    if (receive) esp32s3SpiReadBufferOwned(int(peripheral), nativeBufferAt(int(address), int(bytes)), int(bytes))
    else esp32s3SpiWriteBufferOwned(int(peripheral), nativeBufferAt(int(address), int(bytes)), int(bytes))
#exportFunction("spiCpuBufferTarget", "abla_s3_spi_cpu_buffer_test")
