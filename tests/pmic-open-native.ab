import "../src/m5stack/pmic_open_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var trace=0
var flags=0
var identity=0
var expectedKind=0
var bad=false
var live=false
fun m5PmicBusValid(bus: int): bool { trace=trace*10+1; return bus == 7 }
fun m5PmicAllocate(bus: int,address: int,hz: int): int {
    trace=trace*10+2
    val expectedAddress=if (expectedKind < 4) 52 else if (expectedKind == 4) 117 else if (expectedKind == 5) 110 else 73
    if (bus != 7 || address != expectedAddress || hz != (if (expectedKind == 5) 100000 else 400000) || live) bad=true
    if ((flags & 1) != 0) return 0
    live=true; 8
}
fun m5PmicBegin(handle: int,kind: int): int {
    trace=trace*10+3
    if (handle != 8 || !live || kind != expectedKind) bad=true
    if ((flags & 2) != 0) return 0
    if (kind < 4) return if (identity == 74) 3 else if (kind == 2 && identity == 3) 2 else 0
    kind
}
fun m5PmicClose(handle: int): bool {
    trace=trace*10+4
    if (handle != 8 || !live) bad=true
    if ((flags & 4) != 0) return false
    live=false; true
}
fun expectedPmic(board: int): int {
    if (board == 1) return 4
    if (board == 2 || board == 3 || board == 4 || board == 8 || board == 9) return 2
    if (board == 10 || board == 17 || board == 27) return 3
    if (board == 31 || board == 152 || board == 33 || board == 26 || board == 30 || board == 149 ||
        board == 34 || board == 28 || board == 32 || board == 29) return 5
    if (board == 23) return 6
    0
}
@export("abla_pmic_open_test")
fun pmicTest(): i32 {
    var profile=0
    while (profile < 24624) {
        val board=profile%513
        flags=(profile/513)%8
        val idcase=(profile/4104)%3
        identity=if (idcase == 0) 3 else if (idcase == 1) 74 else 99
        val bus=if (profile < 12312) 7 else 0
        expectedKind=expectedPmic(board)
        trace=0; bad=false; live=false
        val result=M5BoardId(board).openPmicOwned(bus)
        val detected=if (expectedKind >= 4) expectedKind else if (identity == 74) 3 else if (expectedKind == 2 && identity == 3) 2 else 0
        val failed=(flags & 2) != 0 || detected == 0
        val status=if (expectedKind == 0) 2 else if (bus == 0) 3 else if ((flags & 1) != 0) 4 else
            if (!failed) 1 else if ((flags & 4) != 0) 6 else 5
        val path=if (status == 2) 0 else if (status == 3) 1 else if (status == 4) 12 else if (status == 1) 123 else 1234
        val owns=status == 1 || status == 6
        if (result.status() != status || result.ready() != (status == 1) || result.ownsDevice() != owns ||
            live != owns || trace != path || bad || (status == 1 && result.kind() != detected)) return i32(1)
        trace=0
        val released=result.releaseOwned()
        if (!owns) { if (released != result || trace != 0) return i32(2) }
        else {
            if (trace != 4 || bad || released.status() != (if ((flags & 4) != 0) 6 else 7)) return i32(3)
            flags=0; trace=0
            val retried=released.releaseOwned()
            if (retried.status() != 7 || live || bad || trace != (if (released.status() == 6) 4 else 0)) return i32(4)
        }
        profile=profile+1
    }
    trace=0
    val malformed=M5PmicOpen(8|(2<<32)|(1<<40)|(1<<36))
    if (malformed.ready() || malformed.releaseOwned() != malformed || trace != 0) return i32(5)
    i32(0)
}
