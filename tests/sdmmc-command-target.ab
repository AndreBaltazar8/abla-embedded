import "../src/sd/mmc_command_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_command_target")
trusted fun target(operation: int,state: int,buffer: int,slot: int,index: int,argument: u32,response: int): int =
    if (operation == 0) sdMmcCommandStartOwned(slot,index,argument,response)|0 else SdMmcCommand(state).pollOwned(nativeBufferAt(buffer,16))|0
