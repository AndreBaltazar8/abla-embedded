import "../src/esp32/gpio/probe_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var pin=0
var layout=1
var mux=u32(0)
var route=u32(0)
var enable=u32(0)
var lp=u32(0)
var held=false
var high=false
var reads=0
var writes=0
var delays=0
var drop=-1
var bad=false
fun p4GpioRead(offset: int): u32 {
    reads=reads+1
    if (offset == 4100+pin*4) return mux
    if (offset == 1368+pin*4) return route
    if (offset == (if (pin < 32) 32 else 44)) return enable
    if (offset == (if (pin < 32) 60 else 64)) {
        if (delays != 1) bad=true
        return if (high) u32(1)<<u32(pin&31) else u32(0)
    }
    bad=true; u32(0)
}
fun p4GpioWrite(offset: int,value: u32): void {
    val index=writes; writes=writes+1
    if (index == drop) return
    val base=if (pin < 32) 32 else 44
    if (offset == 4100+pin*4) mux=value
    else if (offset == 1368+pin*4) route=value
    else if (offset == base+8 || offset == base+4) {
        if (value != (u32(1)<<u32(pin&31))) bad=true
        enable=if (offset == base+8) enable & (u32(0xFFFFFFFF)^value) else enable|value
    } else bad=true
    return
}
fun p4GpioHoldRead(address: int): u32 {
    reads=reads+1
    if (address == p4GpioHoldAddress(layout,pin)) return if (held) p4GpioHoldBit(layout,pin) else u32(0)
    if (pin < 16 && address == 0x5012B008+pin*4) return lp
    bad=true; u32(0)
}
fun p4GpioHoldWrite(address: int,value: u32): void {
    val index=writes; writes=writes+1
    if (index == drop) return
    if (pin < 16 && address == 0x5012B008+pin*4) lp=value
    else bad=true
    return
}
fun p4ProbeDelay(): void {
    if ((enable & (u32(1)<<u32(pin&31))) != u32(0) || (route&u32(0xC00)) != u32(0x400) ||
        (mux&u32(0x7382)) != u32(0x1280) || (pin < 16 && (lp&u32(16)) != u32(0))) bad=true
    delays=delays+1; return
}
@export("abla_gpio_probe_p4_test")
fun probeTest(): i32 {
    layout=1
    while (layout <= 3) {
        pin=0
        while (pin <= 54) {
            var mode=0
            while (mode < 64) {
                val savedMux=u32(0x80000000)|u32(mode*7919)
                val savedRoute=u32(0x80000000)|u32(mode*131)
                val savedEnable=if ((mode&1)!=0) u32(0xFFFFFFFF) else u32(0xFFFFFFFF)^(u32(1)<<u32(pin&31))
                val savedLp=u32(mode*37)
                drop=-1
                while (drop < 8) {
                    mux=savedMux; route=savedRoute; enable=savedEnable; lp=savedLp
                    held=(mode&4)!=0; high=(mode&2)!=0
                    reads=0; writes=0; delays=0; bad=false
                    val result=esp32P4GpioPulldownProbeOwned(layout,pin,true)
                    val restored=mux == savedMux && route == savedRoute && enable == savedEnable && lp == savedLp
                    if (bad || (held && (result != -2 || writes != 0 || delays != 0))) return i32(1)
                    if (!held && drop == -1 && (result != (if (high) 1 else 0) || !restored || writes != (if (pin < 16) 8 else 6))) return i32(2)
                    if (!held && ((!restored && result != -4) || (restored && result == -4))) return i32(3)
                    if (!held && result >= 0 && delays != 1) return i32(4)
                    drop=drop+1
                }
                mode=mode+1
            }
            pin=pin+1
        }
        layout=layout+2
    }
    reads=0; writes=0
    if (esp32P4GpioPulldownProbeOwned(2,0,true) != -1 || esp32P4GpioPulldownProbeOwned(1,-1,true) != -1 ||
        esp32P4GpioPulldownProbeOwned(3,55,true) != -1 || esp32P4GpioPulldownProbeOwned(3,0,false) != -1 || reads != 0 || writes != 0) return i32(5)
    i32(0)
}
