import "../src/runtime/ct_stack_bounds.ab"

fun main: int {
    if (embeddedCtStackProtectedLow(u32(0)) != u32(0)) return 1
    if (embeddedCtStackProtectedLow(u32(0x3FFB0000)) != u32(0x3FFB0040)) return 2
    if (embeddedCtStackProtectedLow(u32(0xFFFFFFBF)) != u32(0xFFFFFFFF)) return 3
    if (embeddedCtStackProtectedLow(u32(0xFFFFFFC0)) != u32(0) ||
        embeddedCtStackProtectedLow(u32(0xFFFFFFFF)) != u32(0)) return 4
    val low = u32(0x3FC98000)
    val top = low + u32(4096)
    if (embeddedCtBootStackLow(top - u32(32),low,top) != low + u32(64)) return 5
    // Other tasks and the S3's dedicated IRQ stacks are not the boot stack.
    if (embeddedCtBootStackLow(low-u32(1),low,top) != u32(0) ||
        embeddedCtBootStackLow(top+u32(1),low,top) != u32(0)) return 6
    if (embeddedCtBootStackLow(low+u32(63),low,top) != u32(0)) return 7
    if (embeddedCtBootStackLow(low+u32(64),low,top) != low+u32(64) ||
        embeddedCtBootStackLow(top,low,top) != low+u32(64)) return 8
    if (embeddedCtBootStackLow(low,top,low) != u32(0) ||
        embeddedCtBootStackLow(low,low,low+u32(63)) != u32(0) ||
        embeddedCtBootStackLow(u32(0),u32(0),u32(0)) != u32(0)) return 9
    0
}
