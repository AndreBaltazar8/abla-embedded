import "./unit-lcd-alpha-wire-native.ab"
import "../src/display/unit_lcd_read_pixels.ab"
@export("abla_unit_lcd_read_pixels_wire_test")
trusted fun testLcdReadPixelsWire(): i32 {
    wireSeed();extraAddress=62;extraCanRead=true;extraReadValue=255
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val device=control.session().bus().device(62,100000)
    val output=nativeBufferAt(lcdMemory,32);val scratch=nativeBufferAt(lcdMemory+32,16)
    val e=nativeBufferAt(oledExpected,16384);val captured=nativeBufferAt(extraWire,8192)
    var bpp=1
    while (bpp <= 3) {
        val stride=3*bpp+2
        expectedCount=0;var row=0
        while (row < 2) {
            expectedPages=row;expectedStage=3;lcdExpectStart(124);expectByte(9);lcdExpectStart(125)
            expectedStage=5;lcdExpectStart(124);expectByte(42);expectByte(7);expectByte(9);expectByte(43);expectByte(5+row);expectByte(5+row)
            expectedStage=6;lcdExpectStart(124);expectByte(128|bpp);lcdExpectStart(125)
            row=row+1
        }
        var failure=0
        while (failure <= expectedCount) {
            var commit=0
            while (commit < 2) {
                var at=0;while (at < 32) { output.store(at,165);at=at+1 }
                val before=ackCount;extraCount=0;nackAfterCommit=commit == 1
                nackAt=if (failure == 0) 0 else before+failure
                val result=device.unitLcdReadPixels(7,5,3,2,0,output,stride,bpp,scratch,1)
                val expected=if (failure == 0) 513 else e.load((failure-1)*4+2)|(e.load((failure-1)*4+3)<<8)
                val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && e.load((failure-1)*4) > 1) 1 else 0)
                if (result != expected || ackCount-before != (if (failure == 0) expectedCount else failure) || extraCount != accepted || bad || mode != 0) return i32(2)
                at=0;while (at < accepted) {
                    if (captured.load(at*2) != e.load(at*4) || captured.load(at*2+1) != e.load(at*4+1)) return i32(3)
                    at=at+1
                }
                at=0;while (at < 32) {
                    if (output.load(at) != (if (at/stride < (result>>>8) && at%stride < 3*bpp) 255 else 165)) return i32(4)
                    at=at+1
                }
                commit=commit+1
            }
            failure=failure+1
        }
        bpp=bpp+1
    }
    nackAt=0;nackAfterCommit=false
    if (!device.close() || !control.closeOwned(true) || pads != 0 || bad) return i32(5)
    return i32(0)
}
