import "../src/storage/fat_chain_ownership.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1564)
var calls=0
var failure=0
var mode=0
var bad=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,sector: int,destination: NativeBuffer): bool {
    calls=calls+1
    if (sector != 101) bad=true
    var index=0
    while (index < 512) { destination.store(index,0); index=index+1 }
    // FAT16:2->3->4->EOC; variations exercise every failure class.
    destination.store(4,if (mode == 1) 2 else if (mode == 3) 0 else 3)
    destination.store(6,4)
    destination.storeU16(10,6);destination.storeU16(12,65535)
    destination.storeU16(14,3)
    if (mode == 2) destination.store(8,3)
    else if (mode == 4) { destination.store(8,247); destination.store(9,255) }
    else { destination.store(8,255); destination.store(9,255) }
    return calls != failure
}
@export("abla_fat_chain_ownership_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(storage,512)
    val reader=nativeBufferAt(storage+512,28)
    val scratch=nativeBufferAt(storage+540,1024)
    val tracker=fatClusterOwnershipAt(nativeBufferAt(nativeStaticAllocate(1266),1266))
    var i=0
    while (i < 512) { boot.store(i,0);i=i+1 }
    boot.store(12,2);boot.store(13,1);boot.store(14,1);boot.store(16,2);boot.store(18,2)
    boot.store(22,40);boot.store(19,129);boot.store(20,39);boot.store(510,85);boot.store(511,170)
    val clusters=fatBootValidate(boot,100,10113).clusters()
    if (!tracker.initialize(clusters)) return i32(1)
    val first=fatClaimChainOwned(reader,boot,100,10113,2,3,scratch,tracker)
    if (first.status() != 1 || first.detail() != 3 || calls != 3) return i32(2)
    val second=fatClaimChainOwned(reader,boot,100,10113,5,2,scratch,tracker)
    if (second.status() != 1 || second.detail() != 2 || tracker.storage().loadU32(8) != 5) return i32(3)
    calls=0
    val shared=fatClaimChainOwned(reader,boot,100,10113,7,5,scratch,tracker)
    if (shared.status() != 5 || shared.detail() != 3 || calls != 1 || tracker.storage().loadU32(12) != 3) return i32(4)
    if (fatClaimChainOwned(reader,boot,100,10113,8,5,scratch,tracker).status() != 5 || calls != 1) return i32(5)
    mode=1
    while (mode <= 4) {
        if (!tracker.initialize(clusters)) return i32(6)
        calls=0
        val result=fatClaimChainOwned(reader,boot,100,10113,2,20,scratch,tracker)
        if (result.status() != (if (mode <= 2) 5 else 4) || bad) return i32(7)
        if (mode == 1 && (result.detail() != 2 || calls != 1)) return i32(8)
        if (mode == 2 && (result.detail() != 3 || calls != 3)) return i32(9)
        if (mode == 3 && result.detail() != 3) return i32(10)
        if (mode == 4 && result.detail() != 4) return i32(11)
        mode=mode+1
    }
    mode=0
    var failureIndex=1
    while (failureIndex <= 3) {
        tracker.initialize(clusters);calls=0;failure=failureIndex
        if (fatClaimChainOwned(reader,boot,100,10113,2,3,scratch,tracker).status() != 3 || calls != failureIndex) return i32(12)
        failureIndex=failureIndex+1
    }
    failure=0;calls=0;tracker.initialize(clusters)
    if (fatClaimChainOwned(reader,boot,100,10113,2,2,scratch,tracker).status() != 6 || calls != 2 || tracker.storage().loadU32(8) != 2) return i32(13)
    boot.store(16,1);boot.store(22,3);boot.store(19,12);boot.store(20,4)
    tracker.initialize(fatBootValidate(boot,100,1036).clusters());calls=0
    if (fatClaimChainOwned(reader,boot,100,1036,341,1,scratch,tracker).status() != 6 || calls != 0 || tracker.storage().loadU32(8) != 0) return i32(14)
    return i32(0)
}
