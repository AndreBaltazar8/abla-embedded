import "../src/esp32/rgb_rmt_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun rgbRmtTarget(owner: u32, pad: u32, rgb: u32, storage: u32): int {
    if (!esp32s3RmtEnableBusClock(owner) || !esp32s3RmtSetGroupClockOwned(false, owner) ||
        !esp32s3RmtConfigureClock(1, 1, 0, 0, owner) || !esp32s3RmtPrepareMemory(owner) ||
        !esp32s3RmtSetGroupClockOwned(true, owner)) return -1
    esp32s3RmtWriteRgbOwned(Pin(int(pad)), 0, RgbColor(int(rgb)), nativeBufferAt(int(storage), 104), 100000)
}
#exportFunction("rgbRmtTarget", "abla_s3_rgb_rmt_test")
