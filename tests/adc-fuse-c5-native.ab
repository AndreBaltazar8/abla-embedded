import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/adc_fuse_c5_sequence.ab"
var reads=0
var version=u32(256)
var pattern=u32(0)
trusted fun c5AdcFuseRead(offset: int): u32 {
    reads=reads+1
    if (offset == 0x4c) return version
    if (offset < 0x6c || offset > 0x78 || (offset&3) != 0) { reads=1000000;return u32(0) }
    return pattern
}
@export("abla_adc_fuse_c5_test")
trusted fun test(): int {
    var channel=0
    while (channel < 6) {
        var attenuation=0
        while (attenuation < 4) {
            var field=0
            while (field < 1024) {
                var difference=0
                while (difference < 16) {
                    val value=esp32c5AdcCalibrationFromFields(channel,attenuation,1,field,field,difference)
                    val signedRef=if (field < 512) field else -(field-512)
                    val compensation=(if (difference < 8) difference else -(difference-8))*(4-attenuation)
                    if (!value.valid() || value.channel() != channel || value.attenuation() != attenuation || value.initCode() != field+1600) return 1
                    if (value.referenceCode() != (if (attenuation < 2) 2250 else 2300)+signedRef || value.compensation() != compensation) return 2
                    if (value.compensatedRaw(2048) != 2048-compensation || value.compensatedRaw(-1) != -1 || value.compensatedRaw(4096) != -1) return 3
                    difference=difference+1
                }
                field=field+1
            }
            var bit=0
            while (bit < 32) {
                pattern=u32(1)<<u32(bit)
                // Independent bit-by-bit oracle, including cross-word fields.
                var initial=0;var reference=0;var difference=0;var b=0
                while (b < 10) {
                    if (((145+attenuation*10+b)&31) == bit) initial=initial|(1<<b)
                    if (((185+attenuation*10+b)&31) == bit) reference=reference|(1<<b)
                    if (b < 4 && ((225+channel*4+b)&31) == bit) difference=difference|(1<<b)
                    b=b+1
                }
                val actual=esp32c5AdcReadCalibration(channel,attenuation,true)
                if (actual != esp32c5AdcCalibrationFromFields(channel,attenuation,1,initial,reference,difference)) return 4
                bit=bit+1
            }
            attenuation=attenuation+1
        }
        channel=channel+1
    }
    reads=0
    if (esp32c5AdcReadCalibration(0,0,false).error() != 2 || esp32c5AdcReadCalibration(6,0,true).error() != 2 || esp32c5AdcReadCalibration(0,4,true).error() != 2 || reads != 0) return 5
    var v=0
    while (v < 32) {
        version=u32(v)<<u32(8);reads=0
        val result=esp32c5AdcReadCalibration(0,0,true)
        if (v >= 1 && v < 8) { if (!result.valid()) return 6 }
        else if (result.error() != 3 || reads != 1) return 7
        v=v+1
    }
    if (c5AdcChannelForPin(0) != -1 || c5AdcChannelForPin(1) != 0 || c5AdcChannelForPin(6) != 5 || c5AdcChannelForPin(7) != -1) return 8
    return 0
}
