import "../src/m5stack/expander_open_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var trace=0
var flags=0
var bad=false
var expectedProfile=0
fun m5ExpanderBusValid(bus: int): bool { trace=trace*10+1; return bus == 7 }
fun m5ExpanderAllocate(bus: int,address: int,frequency: int): int {
    trace=trace*10+2
    if (bus != 7 || address != (expectedProfile&255) || frequency != (if ((expectedProfile>>>8) == 1) 400000 else 100000)) bad=true
    if ((flags & 1) != 0) 0 else 8
}
fun m5ExpanderBegin(handle: int,kind: int): bool {
    trace=trace*10+3
    if (handle != 8 || kind != (expectedProfile>>>8)) bad=true
    (flags & 2) == 0
}
fun m5ExpanderClose(handle: int): bool {
    trace=trace*10+4
    if (handle != 8) bad=true
    (flags & 4) == 0
}
fun expectedBoardProfile(board: int,index: int): int {
    if (index < 0 || index > 1) return 0
    if (board == 22 || board == 35 || board == 23) return 256|(67+index)
    if (index != 0) return 0
    if (board == 25 || board == 21) return 323
    if (board == 31 || board == 32 || board == 29 || board == 30 || board == 33 || board == 152) return 591
    0
}
@export("abla_expander_open_test")
fun openTest(): i32 {
    var profile=0
    while (profile < 32832) {
        val board=profile%513
        val index=(profile/513)%4-1
        flags=(profile/2052)%8
        val bus=if (profile < 16416) 7 else 0
        expectedProfile=expectedBoardProfile(board,index)
        if (M5BoardId(board).expanderProfile(index) != expectedProfile) return i32(1)
        trace=0; bad=false
        val result=M5BoardId(board).openExpanderOwned(bus,index)
        val status=if (expectedProfile == 0) 2 else if (bus == 0) 3 else if ((flags & 1) != 0) 4 else
            if ((flags & 2) == 0) 1 else if ((flags & 4) == 0) 5 else 6
        val path=if (status == 2) 0 else if (status == 3) 1 else if (status == 4) 12 else if (status == 1) 123 else 1234
        val owns=status == 1 || status == 6
        if (result.status() != status || trace != path || bad || result.ready() != (status == 1) ||
            result.ownsDevice() != owns || result.deviceHandle() != (if (owns) 8 else 0)) return i32(2)
        trace=0
        val released=result.releaseOwned()
        if (!owns) {
            if (released != result || trace != 0) return i32(3)
        } else {
            if (trace != 4 || bad || released.status() != (if ((flags & 4) == 0) 7 else 6)) return i32(4)
            if ((flags & 4) != 0) {
                if (!released.ownsDevice() || released.ready() || released.deviceHandle() != 8) return i32(5)
                flags=0; trace=0
                val retry=released.releaseOwned()
                if (retry.status() != 7 || retry.ownsDevice() || trace != 4) return i32(6)
            } else {
                trace=0
                if (released.releaseOwned() != released || trace != 0 || released.ownsDevice()) return i32(7)
            }
        }
        profile=profile+1
    }
    trace=0
    val malformed=M5ExpanderOpen(8|(1<<32)|(1<<40)|(1<<34))
    if (malformed.ready() || malformed.ownsDevice() || malformed.releaseOwned() != malformed || trace != 0) return i32(8)
    i32(0)
}
