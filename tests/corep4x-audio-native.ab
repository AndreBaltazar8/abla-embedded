import "../src/m5stack/corep4x_audio_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
type Es8311=int
type Es7210=int
type M5Ioe1=int
type I2cByteResult=int
fun Es8311.valid(): bool = this == 2
fun Es7210.valid(): bool = this == 3
fun M5Ioe1.valid(): bool = this == 4
fun I2cByteResult.valid(): bool = (this&256) != 0
fun I2cByteResult.value(): int = this&255
val micOn=nativeStaticU32s([3,4,5,6,12,11])
val micOff=nativeStaticU32s([11])
val spkOn=nativeStaticU32s([3,4,5,6,12,7,8,9,10,11])
val spkOff=nativeStaticU32s([7,8,9,10])
var events=0
var calls=0
var fail=0
var enabled=false
var tx=false
var bad=false
trusted fun step(event: int): bool {
    if (event != nativeAddressLoadU32(events,calls*4)) bad=true
    calls=calls+1;return fail != event
}
trusted fun M5Ioe1.setHighImpedance(pin: int,high: bool): bool { if (high || (pin != 0 && pin != 2)) bad=true;return step(if (pin == 0) 3 else 7) }
trusted fun M5Ioe1.setDirection(pin: int,high: bool): bool { if (!high || (pin != 0 && pin != 2)) bad=true;return step(if (pin == 0) 4 else 8) }
trusted fun M5Ioe1.digitalWrite(pin: int,high: bool): bool { if (high != enabled || (pin != 0 && pin != 2)) bad=true;return step(if (pin == 0) 5 else 9) }
trusted fun M5Ioe1.getWriteValueChecked(pin: int): I2cByteResult {
    val ready=step(if (pin == 0) 6 else 10)
    return I2cByteResult(if (ready) 256|(if (enabled) 1 else 0) else 0)
}
trusted fun peripheralDelayMilliseconds(ms: int): void { if (ms != 20 || !enabled) bad=true;step(12);return }
trusted fun Es7210.configureMic1234(): bool { if (!enabled || tx || this != 3) bad=true;return step(11) }
trusted fun Es7210.reset(): bool { if (enabled || tx || this != 3) bad=true;return step(11) }
trusted fun Es8311.configureSpeakerMclk25624kOwned(exclusive: bool): int {
    if (!enabled || !tx || !exclusive || this != 2) bad=true
    return if (step(11)) 1 else 34
}
@export("abla_corep4x_audio_test")
trusted fun test(): i32 {
    var variant=0
    while (variant < 4) {
        enabled=(variant&1) != 0;tx=(variant&2) != 0
        events=if (tx) (if (enabled) spkOn else spkOff) else if (enabled) micOn else micOff
        val count=if (tx) (if (enabled) 10 else 4) else if (enabled) 6 else 1
        var faultIndex=0
        while (faultIndex <= count) {
            fail=if (faultIndex == 0) 0 else nativeAddressLoadU32(events,(faultIndex-1)*4);calls=0
            val result=if (tx) coreP4xSpeakerOwned(Es8311(if (enabled) 2 else 0),M5Ioe1(4),enabled,true)
                else coreP4xMicrophoneOwned(Es7210(3),M5Ioe1(if (enabled) 4 else 0),enabled,true)
            val expected=if (fail == 0 || fail == 12) 1 else if (fail == 11 && tx) 11|(34<<8) else fail
            if (result != expected || calls != (if (fail == 0 || fail == 12) count else faultIndex) || bad) return i32(1)
            faultIndex=faultIndex+1
        }
        variant=variant+1
    }
    calls=0
    if (coreP4xSpeakerOwned(Es8311(2),M5Ioe1(4),true,false) != 2 ||
        coreP4xMicrophoneOwned(Es7210(0),M5Ioe1(4),true,true) != 2 ||
        coreP4xAudioPowerOwned(M5Ioe1(0),true) != 2 || calls != 0) return i32(2)
    return i32(0)
}
