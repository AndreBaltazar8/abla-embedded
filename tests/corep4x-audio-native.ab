import "../src/m5stack/corep4x_audio_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/hal/delay.ab"
import "../src/hal/m5stack_3.ab"
import "../src/hal/m5ioe1.ab"
import "../src/hal/es7210.ab"
import "../src/hal/es8311.ab"
import "../src/audio/es8311_type.ab"
import "../src/audio/es7210_type.ab"
import "../src/io_expander/m5ioe1_type.ab"
import "abla/unsafe/memory/raw"
type I2cByteResult=int
@exportLocal("abla_es8311_valid")
fun es8311ValidHook(recv: int): bool = Es8311(recv) == 2
@exportLocal("abla_es7210_valid")
fun es7210ValidHook(recv: int): bool = Es7210(recv) == 3
@exportLocal("abla_m5ioe1_valid")
fun m5Ioe1ValidHook(recv: int): bool = M5Ioe1(recv) == 4
fun I2cByteResult.valid(): bool = (this&256) != 0
fun I2cByteResult.value(): int = this&255
val micOn=nativeStaticU32s([3,4,5,6,12,11])
val micOff=nativeStaticU32s([11])
val spkOn=nativeStaticU32s([3,4,5,6,12,7,8,9,10,11])
val spkOff=nativeStaticU32s([7,8,9,10])
var events=0
var calls=0
var fail=0
var enabled=false
var tx=false
var bad=false
trusted fun step(event: int): bool {
    if (event != nativeAddressLoadU32(events,calls*4)) bad=true
    calls=calls+1;return fail != event
}
@exportLocal("abla_m5ioe1_setHighImpedance")
trusted fun m5Ioe1SetHighImpedanceHook(recv: int, pin: int, high: bool): bool { if (high || (pin != 0 && pin != 2)) bad=true;return step(if (pin == 0) 3 else 7) }
@exportLocal("abla_m5ioe1_setDirection")
trusted fun m5Ioe1SetDirectionHook(recv: int, pin: int, high: bool): bool { if (!high || (pin != 0 && pin != 2)) bad=true;return step(if (pin == 0) 4 else 8) }
@exportLocal("abla_m5ioe1_digitalWrite")
trusted fun m5Ioe1DigitalWriteHook(recv: int, pin: int, high: bool): bool { if (high != enabled || (pin != 0 && pin != 2)) bad=true;return step(if (pin == 0) 5 else 9) }
@exportLocal("abla_m5ioe1_getWriteValueChecked")
trusted fun m5Ioe1GetWriteValueCheckedHook(recv: int, pin: int): I2cByteResult {
    val ready=step(if (pin == 0) 6 else 10)
    return I2cByteResult(if (ready) 256|(if (enabled) 1 else 0) else 0)
}
@export("peripheralDelayMilliseconds")
trusted fun peripheralDelayMillisecondsHook(ms: int): void { if (ms != 20 || !enabled) bad=true;step(12);return }
@exportLocal("abla_es7210_configureMic1234")
trusted fun es7210ConfigureMic1234Hook(recv: int): bool { if (!enabled || tx || Es7210(recv) != 3) bad=true;return step(11) }
@exportLocal("abla_es7210_reset")
trusted fun es7210ResetHook(recv: int): bool { if (enabled || tx || Es7210(recv) != 3) bad=true;return step(11) }
@exportLocal("abla_es8311_configureSpeakerMclk25624kOwned")
trusted fun es8311ConfigureSpeakerMclk25624kOwnedHook(recv: int, exclusive: bool): int {
    if (!enabled || !tx || !exclusive || Es8311(recv) != 2) bad=true
    return if (step(11)) 1 else 34
}
@export("abla_corep4x_audio_test")
trusted fun test(): i32 {
    var variant=0
    while (variant < 4) {
        enabled=(variant&1) != 0;tx=(variant&2) != 0
        events=if (tx) (if (enabled) spkOn else spkOff) else if (enabled) micOn else micOff
        val count=if (tx) (if (enabled) 10 else 4) else if (enabled) 6 else 1
        var faultIndex=0
        while (faultIndex <= count) {
            fail=if (faultIndex == 0) 0 else nativeAddressLoadU32(events,(faultIndex-1)*4);calls=0
            val result=if (tx) coreP4xSpeakerOwned(Es8311(if (enabled) 2 else 0),M5Ioe1(4),enabled,true)
                else coreP4xMicrophoneOwned(Es7210(3),M5Ioe1(if (enabled) 4 else 0),enabled,true)
            val expected=if (fail == 0 || fail == 12) 1 else if (fail == 11 && tx) 11|(34<<8) else fail
            if (result != expected || calls != (if (fail == 0 || fail == 12) count else faultIndex) || bad) return i32(1)
            faultIndex=faultIndex+1
        }
        variant=variant+1
    }
    calls=0
    if (coreP4xSpeakerOwned(Es8311(2),M5Ioe1(4),true,false) != 2 ||
        coreP4xMicrophoneOwned(Es7210(0),M5Ioe1(4),true,true) != 2 ||
        coreP4xAudioPowerOwned(M5Ioe1(0),true) != 2 || calls != 0) return i32(2)
    return i32(0)
}
