import "../src/audio/wav_resample.ab"
import "abla/runtime/scalar"
import "abla/build"
val resampleSource=nativeStaticAllocate(8)
val resampleMetadata=nativeStaticAllocate(20)
val resampleOutput=nativeStaticAllocate(260)
val resamplePart=nativeStaticAllocate(260)
@export("abla_wav_resample_test")
trusted fun resampleTest(): i32 {
    val source=nativeBufferAt(resampleSource,8)
    source.storeU16(0,0); source.storeU16(2,1000)
    source.storeU16(4,0); source.storeU16(6,-1000)
    val metadata=nativeBufferAt(resampleMetadata,20)
    metadata.storeU32(0,resampleSource); metadata.storeU32(4,8)
    metadata.storeU32(8,8000); metadata.storeU32(12,1); metadata.storeU32(16,16)
    val wav=PcmWav(resampleMetadata)
    val output=nativeBufferAt(resampleOutput,260)
    val part=nativeBufferAt(resamplePart,260)
    if (wav.resampledFrames(16000) != 8 || wav.copyResampledStereo16(0,10,16000,output) != 40) return i32(1)
    var i=0
    while (i < 10) {
        val expected=if (i == 1 || i == 3) 500 else if (i == 2) 1000 else
            if (i == 5) -500 else if (i == 6 || i == 7) -1000 else 0
        if (output.loadU16(i*4) != (expected & 65535) || output.loadU16(i*4+2) != (expected & 65535)) return i32(2)
        i=i+1
    }
    var rate=8000
    while (rate <= 96000) {
        if (wav.copyResampledStereo16(0,64,rate,output) != 256) return i32(3)
        i=0
        while (i < 64) {
            if (wav.copyResampledStereo16(i,1,rate,part) != 4 || part.loadU32(0) != output.loadU32(i*4)) return i32(4)
            i=i+1
        }
        rate=rate+137
    }
    output.storeU32(0,12345)
    if (wav.copyResampledStereo16(0,1,7999,output) != -1 || output.loadU32(0) != 12345 ||
        wav.copyResampledStereo16(0,1,16000,metadata) != -1 ||
        wav.copyResampledStereo16(0,1,16000,source) != -1) return i32(5)
    i32(0)
}
