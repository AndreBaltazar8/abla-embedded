import "../src/esp32/adc_calibration_p4_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
// Host-only differential-test entry. No C oracle is linked into firmware.
@export("abla_p4_adc_voltage_probe")
fun voltageProbe(unit: i32,attenuation: i32,reference: i32,difference: i32,raw: i32): i32 =
    i32(esp32p4AdcCalibrationFromFields(int(unit),0,int(attenuation),1,0,int(reference),int(difference)).millivolts(int(raw)))
