import "../src/esp32/i2s/clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun i2sStandardTarget(port: i32, transmit: bool, slots: i32, flags: i32): bool =
    esp32s3I2sSetStandardMode(int(port), transmit, int(slots), int(flags))
