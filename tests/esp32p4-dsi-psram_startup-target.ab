import "../src/esp32/psram/startup_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_psram_startup_target")
trusted fun startupTarget(record: NativeBuffer,cold: NativeBuffer,mhz: int,hex16: bool,dummy: int,scratch: NativeBuffer,work: NativeBuffer,polls: int): int =
    p4PsramStartupColdOwned(record,cold,mhz,hex16,dummy,scratch,work,polls)
