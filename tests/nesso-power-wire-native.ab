import "../src/m5stack/nesso_i2c_profile.ab"
import "../src/esp32/i2c/software_session_c6_sequence.ab"
import "../src/esp32/i2c/software_bus_c6_bindings.ab"
import "../src/m5stack/c6_gauge.ab"
import "../src/m5stack/nesso_power_sequence.ab"
import "../src/m5stack/c6_power.ab"
import "abla/build"
// Actual C6 session, clocks, GPIO configuration/latches, provider, bit engine
// and gauge. Only MMIO/ROM timing and the external slave are simulated.
// Nesso SDA10/SCL8; no physical validation or automatic board power setup.
val registers=nativeStaticAllocate(512)
val gpioMemory=nativeStaticAllocate(4096)
var bad=false
var ticks=0
var apb=u32(0)
var functional=u32(0x300000)
var gpioClock=u32(0)
var dropClose=false
var gpioWrites=0
// Optional SPI observer; existing board-power tests leave it disabled.
var displayCapture=false
var displayExpected=NativeBuffer(0)
var displayExpectedBytes=0
var displayByteCount=0
var displayBits=0
var displayByte=0
var displayGateAddress=0
var displayDelays=0
fun displayObserve(old: int,now: int): void {
    if (!displayCapture) return
    if ((old&0x100000) == 0 && (now&0x100000) != 0 && (now&0x20000) == 0) {
        if (nativeAddressLoadU32(displayGateAddress,0) != 7) bad=true
        displayByte=(displayByte<<1)|(if ((now&0x200000) != 0) 1 else 0);displayBits=displayBits+1
        if (displayBits == 8) {
            val expected=if (displayByteCount < displayExpected.capacity()) displayExpected.load(displayByteCount) else 0
            if (displayByteCount >= displayExpectedBytes || displayByte != expected) bad=true
            displayByteCount=displayByteCount+1;displayBits=0;displayByte=0
        }
    }
    return
}
fun c6DelayClockRead(address: int): int {
    if (address == 0x60096110) return 65536|512
    if (address == 0x60096118) return 256
    bad=true;return 0
}
fun c6DelayClockSetRomTicks(value: int): void { ticks=value;return }
fun c6GpioClockRead(address: int): u32 = c6GpioRead(address)
fun c6GpioClockWrite(address: int,value: u32): void {
    if (nativeBufferAt(gpioMemory,4096).loadU32(256+32) != 0) bad=true
    if (address == 0x600960e8) apb=value
    else if (address == 0x600960ec) functional=value
    else if (address == 0x6009162c) gpioClock=value
    else bad=true
    return
}
fun mapped(address: int): int {
    if (address >= 0x60090004 && address < 0x60090080) return address-0x60090000
    if (address >= 0x60091000 && address < 0x6009162c) return 256+address-0x60091000
    return -1
}
fun c6GpioRead(address: int): u32 {
    if (address == 0x600960e8) return apb
    if (address == 0x600960ec) return functional
    if (address == 0x6009162c) return gpioClock
    if (address == 0x600b102c || address == 0x600b1028 || address == 0x6000f018) return u32(0)
    if (address == 0x6009103c) return u32((if (masterHigh && slaveHigh) 1024 else 0)|(if (clockHigh) 256 else 0))
    val at=mapped(address)
    if (at < 0) { bad=true;return u32(0) }
    return u32(nativeBufferAt(gpioMemory,4096).loadU32(at))
}
fun c6GpioWrite(address: int,value: u32): void {
    gpioWrites=gpioWrites+1
    if (apb != u32(1) || functional != u32(0x700000) || gpioClock != u32(1) || ticks != 80) bad=true
    val r=nativeBufferAt(gpioMemory,4096)
    val at=mapped(address)
    if (at < 0) { bad=true;return }
    val oldOutput=r.loadU32(260)
    if (address == 0x60091028 && dropClose) return
    if (address == 0x60091008 || address == 0x60091024) r.storeU32(at-4,r.loadU32(at-4)|int(value))
    else if (address == 0x6009100c || address == 0x60091028) r.storeU32(at-8,r.loadU32(at-8)&(0xffffffff^int(value)))
    else r.storeU32(at,int(value))
    val enabled=r.loadU32(256+32);val output=r.loadU32(256+4)
    displayObserve(oldOutput,output)
    wireDrive(0,(enabled&1024) == 0 || (output&1024) != 0)
    wireDrive(1,(enabled&256) == 0 || (output&256) != 0)
    return
}
fun softwareI2cSample(pin: int): bool = esp32C6GpioReadOwned(pin) == 1
fun softwareI2cDrive(pin: int,released: bool): void { esp32C6GpioWriteOwned(pin,released);return }
fun softwareI2cDelay(us: int): void { if (ticks != 80 || us <= 0) bad=true;return }
fun peripheralDelayMilliseconds(ms: int): void {
    if (displayCapture && ms == 130) {
        if (ms != 130 || nativeAddressLoadU32(displayGateAddress,0) != 7 ||
            (nativeBufferAt(gpioMemory,4096).loadU32(260)&0x20000) == 0) bad=true
        displayDelays=displayDelays+1
    } else if (ms != 10 && ms != 200) bad=true
    delayTotal=delayTotal+ms;return
}
var masterHigh=true
var slaveHigh=true
var clockHigh=true
var mode=0
var bits=0
var value=0
var index=0
var selected=-1
var pointer=0
var reading=false
var ack=true
var ackCount=0
var nackAt=0
var starts=0
var stops=0
// Optional RX8130 slave for retained-child integration; disabled by default.
val rtcRegisters=nativeStaticAllocate(256)
var rtcPresent=false
var rtcAddress=50
var rtcNackAfterCommit=false
// Optional MPU6886 at0x68. Off by default; existing PM1/RTC tests unchanged.
val pm1ImuRegisters=nativeStaticAllocate(256)
var pm1ImuPresent=false
var bmiModel=false
var bmiUploaded=0
var bmiExpectedConfig=0
var pm1ImuNackAfterCommit=false
// Optional configurable charger-register slave, default off.
val chargeRegisters=nativeStaticAllocate(256)
var chargeAddress=85
var chargeNackAfterCommit=false
// Optional E1 alongside charger/gauge, for whole-board integration.
var e1Present=false
val e1Registers=nativeStaticAllocate(256)
fun wireByte(): void {
    ackCount=ackCount+1
    ack=ackCount != nackAt
    if (index == 0) {
        selected=if ((value>>>1) == 67) 0 else if ((value>>>1) == 73) 256 else if (rtcPresent && (value>>>1) == rtcAddress) 512 else if (pm1ImuPresent && (value>>>1) == 104) 768 else if (chargeAddress != 0 && (value>>>1) == chargeAddress) 1024 else if (e1Present && (value>>>1) == 68) 1280 else -1
        reading=(value&1) != 0
        if (selected < 0) ack=false
    } else if ((ack || (index > 1 && afterCommit)) && selected >= 0) {
        if (index == 1) pointer=value
        else {
            if (selected == 512) nativeBufferAt(rtcRegisters,256).store(pointer,value)
            else if (selected == 768) {
                val r=nativeBufferAt(pm1ImuRegisters,256)
                if (bmiModel && pointer == 94) {
                    if (bmiUploaded >= 8192 || value != nativeBufferAt(bmiExpectedConfig,8192).load(bmiUploaded)) bad=true
                    bmiUploaded=bmiUploaded+1
                } else {
                    r.store(pointer,value)
                    if (bmiModel && pointer == 126 && value == 182) r.store(124,1)
                    if (bmiModel && pointer == 89 && value == 1) r.store(33,1)
                }
            }
            else if (selected == 1024) nativeBufferAt(chargeRegisters,256).store(pointer,value)
            else if (selected == 1280) nativeBufferAt(e1Registers,256).store(pointer,value)
            else nativeBufferAt(registers,512).store(selected+pointer,value)
            if (selected == 1024 && pointer == 1) {
                val command=nativeBufferAt(chargeRegisters,256).loadU16(0)
                val expected=if (commands == 0) 65 else if (commands == 1) 1 else if (commands < 4) 32768 else 65535
                if (command != expected || commands >= 6) bad=true
                commands=commands+1
            }
            if (!(selected == 768 && bmiModel && pointer == 94)) pointer=(pointer+1)&255
        }
    }
    index=index+1
    return
}
fun sendBit(): void {
    val byte=if (selected == 512) nativeBufferAt(rtcRegisters,256).load(pointer) else if (selected == 768) nativeBufferAt(pm1ImuRegisters,256).load(pointer) else if (selected == 1024) nativeBufferAt(chargeRegisters,256).load(pointer) else if (selected == 1280) nativeBufferAt(e1Registers,256).load(pointer) else nativeBufferAt(registers,512).load(selected+pointer)
    slaveHigh=(byte&(128>>>bits)) != 0;return
}
fun wireDrive(pin: int,high: bool): void {
    if (pin == 0) {
        val old=masterHigh
        masterHigh=high
        if (clockHigh && slaveHigh && old != high) {
            if (!high) { starts=starts+1;mode=1;bits=0;value=0;index=0;reading=false }
            else { stops=stops+1;mode=0;slaveHigh=true }
        }
        return
    }
    if (pin != 1) { bad=true;return }
    if (clockHigh == high) return
    clockHigh=high
    if (high) {
        if (mode == 1) { value=(value<<1)|(if (masterHigh) 1 else 0);bits=bits+1 }
        else if (mode == 3) bits=bits+1
        else if (mode == 4) ack=!masterHigh
    } else {
        if (mode == 1 && bits == 8) { wireByte();mode=2;slaveHigh=!ack }
        else if (mode == 2) {
            slaveHigh=true;bits=0;value=0
            if (!ack) mode=5
            else if (reading) { mode=3;sendBit() }
            else mode=1
        } else if (mode == 3) {
            if (bits == 8) { mode=4;slaveHigh=true } else sendBit()
        } else if (mode == 4) {
            bits=0
            if (ack) { pointer=(pointer+1)&255;mode=3;sendBit() } else { mode=5;slaveHigh=true }
        }
    }
    return
}
fun wireSeed(): void {
    rtcPresent=false;rtcAddress=50;rtcNackAfterCommit=false;e1Present=false
    pm1ImuPresent=false;pm1ImuNackAfterCommit=false;bmiModel=false;bmiUploaded=0;bmiExpectedConfig=0
    chargeAddress=0;chargeNackAfterCommit=false
    masterHigh=true;slaveHigh=true;clockHigh=true;mode=0;bits=0;value=0;index=0
    selected=-1;pointer=0;reading=false;ack=true;ackCount=0;nackAt=0;starts=0;stops=0
    var at=0
    while (at < 512) { nativeBufferAt(registers,512).store(at,255);at=at+1 }
    nativeBufferAt(registers,512).store(256,18)
    nativeBufferAt(registers,512).store(257,52)
    nativeBufferAt(registers,512).store(258,86)
    nativeBufferAt(registers,512).store(259,120)
    return
}


val powerStorage=nativeStaticAllocate(40)
var afterCommit=false
var commands=0
var delayTotal=0
fun nessoPowerStorageSafe(buffer: NativeBuffer): bool = softwareI2cProviderBufferSafe(buffer,40)
fun nessoPowerBusCurrent(bus: int): bool = I2cBus(bus).current() && nessoI2cPinsMatch(softwareI2cProviderOwner().lines().sda(),softwareI2cProviderOwner().lines().scl())
fun nessoPowerGaugeAllocate(bus: int): int = I2cBus(bus).device(85,100000)|0
fun nessoPowerGaugeClose(handle: int): bool = I2cDevice(handle).close()
@export("abla_nesso_power_wire_test")
trusted fun testNessoPowerWire(): i32 {
    val power=nessoPowerAt(nativeBufferAt(powerStorage,40))
    var commit=0
    while (commit < 2) {
        var fault=0
        while (fault <= 75) {
            wireSeed();chargeAddress=85;afterCommit=commit == 1;commands=0;delayTotal=0
            bad=false;dropClose=false;ticks=0;gpioWrites=0
            val gpioRegs=nativeBufferAt(gpioMemory,4096)
            var at=0;while (at < 4096) { gpioRegs.storeU32(at,0);at=at+4 }
            apb=u32(0);functional=u32(0x300000);gpioClock=u32(0)
            val regs=nativeBufferAt(registers,512)
            // This model maps the second slave to AW32001, not the PM1 whose
            // identity bytes the shared wire seed initializes at256..259.
            at=0;while (at < 512) { regs.store(at,255);at=at+1 }
            regs.store(1,1);regs.store(256+10,73)
            val gaugeRegs=nativeBufferAt(chargeRegisters,256)
            at=0;while (at < 256) { gaugeRegs.store(at,90);at=at+1 }
            gaugeRegs.storeU16(8,3700);gaugeRegs.storeU16(20,65413)
            var session=esp32C6I2cSessionOpenOwned(10,8,40000000,20000000,true,5,8)
            if (!session.ready() || !power.initialize()) return i32(1)
            nackAt=fault
            val result=power.openOwned(session.bus()|0,true)
            val expected=if (fault == 0) 1 else if (fault <= 3) 3 else if (fault <= 12) 4 else 6
            if (result != expected || power.ready() != (fault == 0) || ackCount != (if (fault == 0) 75 else fault) || bad) return i32(2)
            if (fault == 0) {
                if (commands != 6 || delayTotal != 210 || power.setupResult().appliedSteps() != 11 ||
                    regs.load(3) != 224 || regs.load(5) != 128 || regs.load(7) != 28 || regs.load(13) != 195 ||
                    regs.load(11) != 195 || regs.load(9) != 3 || regs.load(17) != 252 ||
                    regs.load(256+5) != 31 || regs.load(256+1) != 247 || regs.load(256+2) != 11 || regs.load(256+4) != 232) return i32(3)
                val gauge=Bq27220(power.gaugeHandle())
                if (m5BoardArduinoNessoN1.readBatteryMillivoltsOwned(gauge,true).millivolts() != 3700 ||
                    gauge.currentMilliampsChecked().value() != -123) return i32(4)
            }
            val before=ackCount
            if (!power.closeOwned(true) || power.phase() != 0 || ackCount != before || !session.bus().current() ||
                mode != 0 || !masterHigh || !slaveHigh || !clockHigh || bad) return i32(5)
            session=session.closeOwned(true)
            if (session != 0 || gpioRegs.loadU32(288) != 0 || apb != u32(0) || functional != u32(0x300000) || gpioClock != u32(0) || bad) return i32(6)
            fault=fault+1
        }
        commit=commit+1
    }
    return i32(0)
}
