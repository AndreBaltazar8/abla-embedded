import "../src/esp32/power/sleep_analog_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_analog_c5_test")
trusted fun test(): i32 {
    val output=nativeBufferAt(nativeStaticAllocate(60),60)
    output.storeU32(56,0x12345678)
    var mode=0
    while (mode < 32) {
        val deep=(mode&1) != 0;val xd=(mode&2) != 0;val rd=(mode&4) != 0
        val xf=(mode&8) != 0;val lf=(mode&16) != 0
        var bias=0
        while (bias < 32) {
            if (!esp32C5SleepAnalogCalibrated(output,deep,xd,rd,xf,lf,bias&15,bias,15-(bias&15),31-bias,31-bias,bias)) return i32(1)
            val active= !deep && (!xd || !rd)
            if (output.loadU32(0) != (if (deep || active || xf) 0 else bias&15)) return i32(2)
            if (output.loadU32(4) != (if (deep || active || xf) 0 else 1) || output.loadU32(8) != output.loadU32(4)) return i32(3)
            if (output.loadU32(16) != (if (active || xf || lf) 31-bias else if (deep) 0 else bias)) return i32(4)
            if (output.loadU32(24) != (if (active || lf) 0 else if (deep) 15-(bias&15) else 1)) return i32(5)
            if (output.loadU32(28) != (if (active) 0 else 1) || output.loadU32(32) != output.loadU32(28)) return i32(6)
            if (output.loadU32(48) != (if (active || lf) bias else if (deep) 31-bias else 15)) return i32(7)
            if (output.loadU32(12) != (if (deep) 0 else 1) || output.loadU32(20) != 0 || output.loadU32(36) != 0 || output.loadU32(40) != 1 || output.loadU32(44) != 0 || output.loadU32(52) != 0 || output.loadU32(56) != 0x12345678) return i32(8)
            bias=bias+1
        }
        mode=mode+1
    }
    var field=0
    while (field < 6) {
        var invalid= -1
        while (invalid < 33) {
            var i=0;while (i < 56) { output.storeU32(i,0xdeadbeef);i=i+4 }
            val bad=if (invalid == -1) -1 else if (field == 0 || field == 2) 16 else 32
            if (esp32C5SleepAnalogCalibrated(output,false,true,true,false,false,
                if (field == 0) bad else 1,if (field == 1) bad else 15,
                if (field == 2) bad else 9,if (field == 3) bad else 15,
                if (field == 4) bad else 24,if (field == 5) bad else 24)) return i32(9)
            i=0;while (i < 56) { if (output.loadU32(i) != 0xdeadbeef) return i32(10);i=i+4 }
            invalid=invalid+33
        }
        field=field+1
    }
    if (esp32C5SleepAnalogCalibrated(nativeBufferAt(output.addressValue(),55),false,true,true,false,false,1,15,9,15,24,24)) return i32(11)
    return i32(0)
}
