import "../src/m5stack/stopwatch_canvas_dirty_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val pixels=nativeStaticAllocate(438048)
val metadata=nativeStaticAllocate(32)
val gateMemory=nativeStaticAllocate(4)
var calls=0
var success=false
var expected=displayRect(0,0,468,468)
var bad=false
fun stopWatchCanvasFlushOwned(gate: PeripheralGate,owner: u32,rotation: int,canvas: NativeBuffer,stride: int,
    x: int,y: int,w: int,h: int,exclusive: bool): SpiTransactionResult {
    if (gate.word().address() != gateMemory || owner != u32(37) || rotation != 0 || canvas.addressValue() != pixels ||
        stride != 936 || displayRect(x,y,w,h) != expected || !exclusive) bad=true
    calls=calls+1
    return SpiTransactionResult(if (success) 1<<32 else (6<<32)|0x20109)
}
@export("abla_stopwatch_canvas_dirty_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(metadata,32)
    val canvas=nativeBufferAt(pixels,438048)
    val gate=peripheralGateAt(gateMemory)
    if (!rgb565DirtyOpenOwned(record,canvas,468,468,936,true) || !rgb565DirtyValid(record,canvas) ||
        rgb565DirtyRect(record) != expected || rgb565DirtyOpenOwned(record,canvas,468,468,936,true)) return i32(1)
    var result=stopWatchCanvasDirtyFlushOwned(record,canvas,gate,u32(37),0,true)
    if (result.status() != 6 || result.value() != u32(0x20109) || rgb565DirtyRect(record) != expected || calls != 1 || bad) return i32(2)
    success=true
    result=stopWatchCanvasDirtyFlushOwned(record,canvas,gate,u32(37),0,true)
    if (!result.valid() || !rgb565DirtyRect(record).empty() || calls != 2 || bad) return i32(3)
    if (!rgb565DirtyFillOwned(record,canvas,13,17,1,1,Rgb565(0xf800),true) ||
        !rgb565DirtyFillOwned(record,canvas,20,23,1,1,Rgb565(0x07e0),true)) return i32(4)
    expected=displayRect(13,17,8,7)
    if (rgb565DirtyRect(record) != expected) return i32(5)
    // Neighbor pixels remain black; byte order matches the native SPI stream.
    val red=17*936+13*2;val green=23*936+20*2
    if (canvas.load(red) != 0xf8 || canvas.load(red+1) != 0 || canvas.load(red-1) != 0 || canvas.load(red+2) != 0 ||
        canvas.load(green) != 7 || canvas.load(green+1) != 0xe0 || canvas.load(green+2) != 0) return i32(6)
    success=false
    result=stopWatchCanvasDirtyFlushOwned(record,canvas,gate,u32(37),0,true)
    if (result.valid() || rgb565DirtyRect(record) != expected) return i32(7)
    if (!rgb565DirtyFillOwned(record,canvas,467,467,1,1,Rgb565(0x001f),true)) return i32(8)
    expected=displayRect(13,17,455,451)
    if (rgb565DirtyRect(record) != expected || bad) return i32(9)
    val before=calls
    if (stopWatchCanvasDirtyFlushOwned(record,canvas,gate,u32(37),0,false).status() != 3 ||
        stopWatchCanvasDirtyFlushOwned(record,canvas,peripheralGateAt(metadata),u32(37),0,true).status() != 3 ||
        rgb565DirtyFillOwned(record,canvas,0,0,-1,1,Rgb565(0),true) || rgb565DirtyRect(record) != expected || calls != before) return i32(10)
    success=true
    if (!stopWatchCanvasDirtyFlushOwned(record,canvas,gate,u32(37),0,true).valid() || !rgb565DirtyRect(record).empty() || bad) return i32(11)
    if (rgb565DirtyValid(record,nativeBufferAt(pixels,438047))) return i32(12)
    return i32(0)
}
