import "../src/esp32/coprocessor_context_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_coprocessor_context_target")
@section(".iram1.abla.s3CoprocessorContextTarget")
trusted fun cpContextTarget(cp: int,restore: bool): int {
    if (cp == 0) return if (restore) esp32S3Cp0RestoreAddress() else esp32S3Cp0SaveAddress()
    if (cp == 3) return if (restore) esp32S3Cp3RestoreAddress() else esp32S3Cp3SaveAddress()
    return 0
}
