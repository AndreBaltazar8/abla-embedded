import "../src/i2c/results.ab"
import "../src/m5stack/tough_backlight.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var calls=0
var failure=0
var expectedDuty=0
var initial=0
var drive=0
var direction=0
var bad=false
var setting=false
fun I2cBus.valid(): bool { bad=true;return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true;return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true;return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true;return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true;return I2cByteResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true;return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true;return false }
trusted fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool {
    val step=calls;calls=calls+1
    val value=if (setting || step == 4) expectedDuty|32768 else if (step == 1) 1000 else 32768
    if (this != 8 || bytes != 2 || register != (if (!setting && step == 1) 37 else 33) ||
        data.load(0) != (value&255) || data.load(1) != (value>>>8) ||
        (!setting && step != 0 && step != 1 && step != 4)) bad=true
    return calls != failure
}
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    val step=calls;calls=calls+1
    if (this != 8 || setting || (step != 2 && step != 3) || mask != 2 ||
        register != (if (step == 2) 20 else 4) || value != (if (step == 2) 0 else 2)) bad=true
    if (calls == failure) return false
    if (step == 2) drive=drive&~2 else direction=direction|2
    return true
}
@export("abla_toughc5_backlight_test")
trusted fun test(): int {
    var brightness=0
    while (brightness < 256) {
        val rounded=(brightness*brightness*4095+32512)/65025
        expectedDuty=if (brightness != 0 && rounded == 0) 1 else rounded
        if (toughBacklightDuty(brightness) != expectedDuty) return 1
        initial=0
        while (initial < 256) {
            failure=0
            while (failure <= 5) {
                calls=0;bad=false;setting=false;drive=initial;direction=initial
                val result=toughBacklightBeginOwned(M5Ioe1(8),brightness,true)
                val done=if (failure == 0) 5 else failure-1
                if (result != ((if (failure == 0) 1 else 4)|(done<<8)) || bad ||
                    calls != (if (failure == 0) 5 else failure) ||
                    drive != (if (done >= 3) initial&~2 else initial) ||
                    direction != (if (done >= 4) initial|2 else initial)) return 2
                failure=failure+1
            }
            initial=initial+1
        }
        failure=0
        while (failure < 2) {
            calls=0;bad=false;setting=true
            if (toughBacklightSetOwned(M5Ioe1(8),brightness,true) != (if (failure == 0) 1 else 4) || calls != 1 || bad) return 3
            failure=failure+1
        }
        brightness=brightness+1
    }
    calls=0
    if (toughBacklightBeginOwned(M5Ioe1(8),-1,true) != 3 ||
        toughBacklightBeginOwned(M5Ioe1(8),256,true) != 3 ||
        toughBacklightBeginOwned(M5Ioe1(8),1,false) != 3 ||
        toughBacklightBeginOwned(M5Ioe1(0),1,true) != 3 ||
        toughBacklightSetOwned(M5Ioe1(4294967296),1,true) != 3 ||
        toughBacklightSetOwned(M5Ioe1(8),256,true) != 3 ||
        toughBacklightSetOwned(M5Ioe1(8),1,false) != 3 || calls != 0) return 4
    return 0
}
