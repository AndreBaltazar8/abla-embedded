import "../src/esp32/spi/clock_c61_sequence.ab"
import "abla/build"
var bus=u32(0)
var functional=u32(0)
var writes=0
var drop=0
var busy=0
var bad=false
fun c61SpiRead(address: int): u32 {
    if (address == 0x60096094) return bus
    if (address == 0x60096098) return functional
    if ((bus&u32(5)) != u32(5)) bad=true
    if (address == 0x60081000) return if (busy == 1) u32(1<<24) else if (busy == 2) u32(1<<23) else u32(0)
    if (address == 0x60081030) return if (busy == 3) u32(1<<27) else if (busy == 4) u32(1<<28) else u32(0)
    if (address == 0x60081034) return if (busy == 5) u32(1) else u32(0)
    if (address == 0x600810e0) return if (busy == 6) u32(1<<26) else if (busy == 7) u32(1<<27) else u32(0)
    bad=true;return u32(0)
}
fun c61SpiWrite(address: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x60096094) {
        if (((bus^value)&~u32(1)) != u32(0)) bad=true
        bus=value
    } else if (address == 0x60096098) {
        if (((functional^value)&~u32(0x400000)) != u32(0)) bad=true
        functional=value
    } else bad=true
    return
}
fun seed(borrow: int,source: int,divider: int): void {
    bus=u32(0xa5000004|(borrow&1))
    functional=u32(0x80000000|(source<<20)|(divider<<12)|(if ((borrow&2) != 0) 1<<22 else 0))
    writes=0;drop=0;busy=0;bad=false;return
}
@export("abla_spi_clock_c61_test")
trusted fun testClock(): i32 {
    var borrow=0
    while (borrow < 4) {
        var source=0
        while (source < 3) {
            var divider=0
            while (divider < 256) {
                seed(borrow,source,divider)
                val oldBus=bus;val oldFunctional=functional
                val owner=esp32C61SpiClockOpenOwned(true,4)
                if (!owner.ready() || !esp32C61SpiCpuIdleOwned() || owner.closeOwned(false) != owner ||
                    owner.closeOwned(true) != 0 || bus != oldBus || functional != oldFunctional || bad) return i32(1)
                divider=divider+1
            }
            source=source+1
        }
        borrow=borrow+1
    }
    var failed=1
    while (failed <= 2) {
        seed(0,1,3);drop=failed
        var owner=esp32C61SpiClockOpenOwned(true,4)
        if (owner.status() != (if (failed == 1) 5 else 7)) return i32(2)
        drop=0
        if (owner.closeOwned(true) != 0 || (bus&u32(1)) != u32(0) || (functional&u32(1<<22)) != u32(0) || bad) return i32(3)
        seed(0,1,3);owner=esp32C61SpiClockOpenOwned(true,4);drop=writes+failed
        owner=owner.closeOwned(true)
        if (owner.status() != (if (failed == 1) 9 else 10)) return i32(4)
        drop=0
        if (owner.closeOwned(true) != 0 || (bus&u32(1)) != u32(0) || (functional&u32(1<<22)) != u32(0) || bad) return i32(5)
        failed=failed+1
    }
    seed(0,0,0)
    var owner=esp32C61SpiClockOpenOwned(true,4)
    val before=writes
    busy=1
    while (busy <= 7) {
        if (esp32C61SpiCpuIdleOwned() || owner.closeOwned(true).status() != 8 || writes != before) return i32(6)
        busy=busy+1
    }
    busy=0
    if (owner.closeOwned(true) != 0 || bad) return i32(7)
    seed(0,0,0);bus=bus&~u32(4)
    owner=esp32C61SpiClockOpenOwned(true,2)
    if (owner.status() != 6 || (functional&u32(1<<22)) != u32(0) || owner.closeOwned(true).status() != 8) return i32(8)
    bus=bus|u32(4)
    if (owner.closeOwned(true) != 0 || bad) return i32(9)
    seed(0,3,0)
    if (esp32C61SpiClockOpenOwned(true).status() != 4 || writes != 0) return i32(10)
    seed(0,0,0);bus=bus|u32(2)
    if (esp32C61SpiClockOpenOwned(true).status() != 3 || writes != 0) return i32(11)
    if (esp32C61SpiClockOpenOwned(false).status() != 2 || esp32C61SpiClockOpenOwned(true,0).status() != 2 || writes != 0) return i32(12)
    return i32(0)
}
