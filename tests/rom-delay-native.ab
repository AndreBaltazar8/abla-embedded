import "../src/esp32/peripheral_delay_rom_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var total=0
var expected=0
var ms=false
var bad=false
fun peripheralRomDelay(microseconds: int): void {
    val want=if (ms || expected-total > 1000) 1000 else expected-total
    if (microseconds != want || microseconds < 1 || microseconds > 1000) bad=true
    calls=calls+1
    total=total+microseconds
    return
}
@export("abla_rom_delay_test")
trusted fun delayTest(): i32 {
    var mode=0
    while (mode < 2) {
        ms=mode == 1
        var duration=-2
        while (duration <= 2048) {
            calls=0; total=0; bad=false
            expected=if (duration <= 0) 0 else if (ms) duration*1000 else duration
            if (ms) peripheralDelayMilliseconds(duration) else peripheralDelayMicroseconds(duration)
            if (total != expected || calls != (if (expected == 0) 0 else if (ms) duration else (duration+999)/1000) || bad) return i32(1)
            duration=duration+1
        }
        mode=mode+1
    }
    i32(0)
}
