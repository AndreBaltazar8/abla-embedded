import "../src/esp32/core_local_init_s3_sequence.ab"
import "../src/esp32/vector_activate_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var enabled=0
var calls=0
var vector=0
var matrixOk=true
var bad=false
var status=0x40020
var fault=0x40379000
var depth=0
var top=0x3FC92FD0
fun esp32S3VectorsAddress(): int = vector
fun esp32S3VectorStatus(): int = status
fun esp32S3VectorConfig(): int = 4096
fun esp32S3VectorRead(address: int): int {
    val offset=address-4096-core*32
    if (offset == 0) return top
    if (offset == 4) return depth
    if (offset == 8) return 0x40378000
    if (offset == 16) return 0x3FC92000
    if (offset == 20) return 0x3FC93000
    if (offset == 24) return fault
    bad=true; return 0
}
fun esp32S3MatrixInitCore(): int = core
fun esp32S3MatrixInitEnabled(): int = enabled
fun esp32S3CoreInitializeAtomics(): void { if (calls != (if (core == 0) 3 else 4) || !matrixOk) bad=true; calls=calls+1; return }
fun esp32S3CoreSetVectorBase(address: int): void { if (calls != (if (core == 0) 4 else 5) || address != vector || !matrixOk) bad=true; calls=calls+1; return }
fun esp32S3CoreClearBootEntry(): void { if (core != 1 || calls != 1) bad=true; calls=calls+1; return }
fun esp32S3CoreDebugWrite(address: int,value: int): void {
    val offset=calls-(if (core == 0) 1 else 2)
    if (offset < 0 || offset > 1 || address != (if (core == 0) 0x600CE048 else 0x600CE0D8)+offset*4 || value != 1) bad=true
    calls=calls+1; return
}
fun esp32S3InterruptMatrixInitOwned(target: int): bool {
    if (target != core || calls != 0) bad=true
    calls=calls+1; matrixOk
}
@export("abla_core_local_init_test")
trusted fun localTest(): i32 {
    var p=0
    while (p < 1792) {
        core=p & 1; vector=0x40370000+(p/4)*1024; matrixOk=(p & 2) == 0
        calls=0; bad=false
        if (esp32S3CoreLocalInitOwned(core,vector) != matrixOk || bad || calls != (if (!matrixOk) 1 else if (core == 0) 5 else 6)) return i32(1)
        p=p+1
    }
    calls=0; core=0
    if (esp32S3CoreLocalInitOwned(1,0x40378000) || esp32S3CoreLocalInitOwned(0,0x40378004) || esp32S3CoreLocalInitOwned(0,0x403E0000) || esp32S3CoreLocalInitOwned(0,0x42000000)) return i32(2)
    enabled=1
    if (esp32S3CoreLocalInitOwned(0,0x40378000) || calls != 0) return i32(3)
    enabled=0; vector=0x40378000; p=0
    while (p < 4) {
        core=p & 1; matrixOk=(p & 2) == 0; calls=0; bad=false
        if (esp32S3VectorsActivateOwned(core) != matrixOk || bad || calls != (if (!matrixOk) 1 else if (core == 0) 5 else 6)) return i32(4)
        p=p+1
    }
    calls=0; matrixOk=true; fault=0
    if (esp32S3VectorsActivateOwned(core) || calls != 0) return i32(5)
    fault=0x40379000; depth=1
    if (esp32S3VectorsActivateOwned(core) || calls != 0) return i32(6)
    depth=0; top=0x3FC92FC0
    if (esp32S3VectorsActivateOwned(core) || calls != 0) return i32(7)
    top=0x3FC92FD0; status=0x40030
    if (esp32S3VectorsActivateOwned(core) || calls != 0) return i32(8)
    status=0x40020; vector=0
    if (esp32S3VectorsActivateOwned(core) || calls != 0) return i32(9)
    i32(0)
}
