import "../src/m5stack/papermono_charger_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var readyAt=1
var probes=0
var closes=0
var enables=0
var operations=0
var delays=0
var failure=0
var observed=0
var bad=false
fun paperMonoChargerSource(handle: int): I2cByteResult = if (failure == 1) I2cByteResult(0) else I2cByteResult(257)
fun paperMonoChargerEnable(handle: int,enabled: bool): bool {
    if (handle != 8) bad=true
    if (enabled) { enables=enables+1; return failure != 2 }
    closes=closes+1; failure != 4
}
fun paperMonoChargerDelay(ms: int): void { if (ms != 2 || enables != 1) bad=true; delays=delays+1; return }
fun paperMonoChargerProbe(bus: int): bool { if (bus != 0 || delays != 1) bad=true; probes=probes+1; probes == readyAt }
fun paperMonoChargerRead(handle: int): I2cByteResult {
    if (handle != 9) bad=true
    operations=operations+1
    if (failure == 3) I2cByteResult(0) else I2cByteResult(256|observed)
}
fun paperMonoChargerWrite(handle: int,enabled: bool): bool { if (handle != 9) bad=true; operations=operations+1; failure != 3 }
@export("abla_papermono_charger_test")
fun chargerTest(): i32 {
    var profile=0
    while (profile < 975) {
        val mode=profile%3; failure=(profile/3)%5; readyAt=(profile/15)+1
        probes=0; closes=0; enables=0; operations=0; delays=0; bad=false; observed=128
        val result=paperMonoChargerOwned(7,8,0,9,mode)
        val skipped=mode == 0 && failure == 1
        val expected=if (skipped) 2 else if (failure == 2) 3 else if (readyAt == 65) 4 else if (failure == 3) 5 else 1
        if (result.status() != expected || result.cleanupFailed() != (!skipped && failure == 4) ||
            probes != (if (skipped || failure == 2) 0 else if (readyAt == 65) 64 else readyAt) ||
            closes != (if (skipped) 0 else 1) || bad ||
            operations != (if (skipped || failure == 2 || readyAt == 65) 0 else 1)) return i32(1)
        profile=profile+1
    }
    i32(0)
}
