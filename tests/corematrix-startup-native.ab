import "../src/m5stack/corematrix_startup_sequence.ab"
import "abla/build"
val memory=nativeStaticAllocate(32)
var calls=0
var failure=0
var verdict=-1
var bad=false
fun coreMatrixStartupAdmission(owner: int,presence: Pm1BatteryPresence): bool = owner == 7
fun step(expected: int): bool { calls=calls+1;if (calls != expected) bad=true;return failure != expected }
fun coreMatrixStartupInputs(owner: int): int = if (step(1)) 3585 else 1796
fun coreMatrixStartupIrq(): int = if (step(2)) 1 else 7
fun coreMatrixStartupChargeSense(owner: int): bool = step(3)
fun coreMatrixStartupPresence(owner: int,presence: Pm1BatteryPresence,now: int): int {
    step(4);return verdict
}
fun coreMatrixStartupSd(owner: int): int = if (step(5)) 769 else 260
@export("abla_corematrix_startup_test")
trusted fun testStartup(): i32 {
    val presence=pm1BatteryPresenceAt(nativeBufferAt(memory,32))
    if (!presence.initialize()) return i32(1)
    while (verdict <= 1) {
        failure=0
        while (failure <= 5) {
            calls=0;bad=false
            val result=m5CoreMatrixStartupOwned(7,presence,123,true)
            val expected=if (failure == 1) 3 else if (failure == 2) 4 else if (failure == 3) 5 else if (failure == 5) 6 else 1
            if (result.status() != expected || bad || calls != (if (failure >= 1 && failure <= 3) failure else 5)) return i32(2)
            if (result.presence() != (if (calls >= 4) verdict else -1)) return i32(3)
            if (result.detail() != (if (failure == 1) 1796 else if (failure == 2) 7 else if (failure == 5) 260 else 0)) return i32(4)
            failure=failure+1
        }
        verdict=verdict+1
    }
    calls=0
    if (m5CoreMatrixStartupOwned(0,presence,0,true).status() != 2 ||
        m5CoreMatrixStartupOwned(7,presence,-1,true).status() != 2 ||
        m5CoreMatrixStartupOwned(7,presence,4294967296,true).status() != 2 ||
        m5CoreMatrixStartupOwned(7,presence,0,false).status() != 2 ||
        m5CoreMatrixStartupOwned(7,Pm1BatteryPresence(0),0,true).status() != 2 || calls != 0) return i32(5)
    return i32(0)
}
