import "../src/esp32/gdma_control_esp32s3.ab"
import "../src/esp32/gdma_events_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var base = 0
var raw = 0
var reads = 0
var written = 0
var bad = false
trusted fun esp32s3GdmaPublish(): void { return }
trusted fun esp32s3GdmaRead(address: int): int {
    reads = reads + 1
    if (address == base + 8) return raw
    if (address == base + 40) return 0x3fc88000
    bad = true
    0
}
trusted fun esp32s3GdmaWrite(address: int, value: int): void {
    if (address != base + 20) bad = true
    written = value
    return
}
trusted fun gdmaEventsTest(): int {
    var channel = 0
    while (channel < 5) {
        var direction = 0
        while (direction < 2) {
            val transmit = direction == 1
            base = 0x6003f000 + channel * 192 + direction * 96
            val mask = if (transmit) 255 else 1023
            var event = 0
            while (event <= mask) {
                raw = event | 0xfffffc00
                written = -1
                reads = 0
                if (esp32s3GdmaEvents(channel, transmit) != event || reads != 1) return 1
                if (!esp32s3GdmaAcknowledge(channel, transmit, event) || reads != 1 || written != (if (event == 0) -1 else event)) return 2
                val errors = if (transmit) event & (4 | 16 | 32 | 64 | 128)
                    else event & (4 | 8 | 16 | 64 | 128 | 256 | 512)
                if (esp32s3GdmaEventErrors(event, transmit) != errors || esp32s3GdmaEventEof(event) != ((event & 2) != 0)) return 3
                event = event + 1
            }
            if (esp32s3GdmaEofDescriptor(channel, transmit) != 0x3fc88000) return 4
            written = -1
            if (esp32s3GdmaAcknowledge(channel, transmit, -1) || esp32s3GdmaAcknowledge(channel, transmit, mask + 1) || written != -1 || bad) return 5
            direction = direction + 1
        }
        channel = channel + 1
    }
    reads = 0
    written = -1
    if (esp32s3GdmaEvents(-1, false) != -1 || esp32s3GdmaEvents(5, true) != -1 || esp32s3GdmaEofDescriptor(5, false) != 0 || esp32s3GdmaAcknowledge(-1, true, 1) || reads != 0 || written != -1) return 6
    0
}
#exportFunction("gdmaEventsTest", "abla_gdma_events_test")
