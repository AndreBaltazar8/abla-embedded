import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/axp_power.ab"
import "../src/m5stack/stamp_charge.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_charger_control_target")
trusted fun chargerTarget(board: M5BoardId,device: I2cDevice,value: int,mode: int): bool {
    if (mode == 3) return board.setStampChargeCurrent(M5Pm1(device | 0),value)
    val power=board.bindAxpPower(device)
    if (mode == 0) return power.setBatteryCharge(value != 0)
    if (mode == 1) power.setChargeCurrent(value) else power.setChargeVoltage(value)
}
