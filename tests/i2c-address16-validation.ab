import "../src/i2c/register_address16.ab"
type I2cDevice = int
var calls = 0
fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int,
    destination: NativeBuffer, length: int, timeout: int): bool {
    calls = calls + 1
    return false
}
fun I2cDevice.write(source: NativeBuffer, length: int, timeout: int): bool {
    calls = calls + 1
    return false
}
trusted fun main(): int {
    val device = I2cDevice(1)
    val buffer = nativeBufferAt(4096, 4)
    if (device.readRegisterAddress16(-1, buffer, 1) || device.readRegisterAddress16(65536, buffer, 1) ||
        device.readRegisterAddress16(0, buffer, -1) || device.readRegisterAddress16(0, buffer, 5) ||
        device.readRegisterAddress16(0, nativeBufferAt(4294967295, 4), 4)) return 1
    if (device.writeRegisterAddress16Byte(-1, 0) || device.writeRegisterAddress16Byte(65536, 0) ||
        device.writeRegisterAddress16Byte(0, -1) || device.writeRegisterAddress16Byte(0, 256) || calls != 0) return 2
    // Failure propagates without reading an unwritten receive cell.
    if (device.readRegisterAddress16ByteChecked(65535).valid() || calls != 1) return 3
    if (device.writeRegisterAddress16Byte(65535, 255) || calls != 2) return 4
    return 0
}
