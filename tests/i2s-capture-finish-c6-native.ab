import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/capture_finish_c6_sequence.ab"
var channel=0
var count=1
var available=0
var conf=u32(4)
var link=u32(0)
var events=u32(0)
var raw=u32(0)
var stops=0
var acks=0
var fault=0
var fifo=false
var bad=false
trusted fun c6I2sClockRead(at: int): u32 = if (at == 0) u32(1) else u32(0x400000)
trusted fun c6I2sClockWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6I2sRead(at: int): u32 = if (at == 0x20) conf else if (at == 0xc) raw else if (at == 0x6c) u32(1) else u32(0)
trusted fun c6I2sWrite(at: int,v: u32): void {
    if (at == 0x20 && v == u32(0)) conf=v
    else if (at == 0x18 && v == u32(1) && conf == u32(0) && stops == 1) {
        if (fault != 4) raw=raw&~v
    } else bad=true
    return
}
trusted fun c6GdmaBusRead(): u32 = u32(1)
trusted fun c6GdmaBusWrite(v: u32): void { bad=true;return }
trusted fun c6GdmaRead(at: int): u32 {
    if (at == 0x64) return u32(8)
    if (at == channel*16) return events
    if (at == 0x80+channel*192) return link
    if (at == 0x78+channel*192) return if (fifo) u32(2) else u32(0)
    return u32(0)
}
trusted fun c6GdmaWrite(at: int,v: u32): void {
    if (at == 0x80+channel*192 && v == u32(0x200000) && conf == u32(0)) {
        stops=stops+1;link=u32(0x1000000)
        if (fault == 2) events=u32(4)
        if (fault == 3) raw=u32(5)
    } else if (at == channel*16+12 && v == u32(3) && stops == 1 && fifo && raw == u32(1)) {
        acks=acks+1;events=u32(0)
    } else bad=true
    return
}
trusted fun c6GdmaDescriptorFence(): void { return }
trusted fun c6GdmaDescriptorWrite(at: int,v: u32): void { bad=true;return }
trusted fun c6GdmaDescriptorRead(at: int): u32 {
    val offset=at-0x40800000;val index=offset/12
    if (offset < 0 || index >= count) { bad=true;return u32(0) }
    if (offset%12 == 0) return u32(64)|u32(32<<12)|u32(0x40000000)|(if (index < available) u32(0) else u32(0x80000000))
    if (offset%12 == 4) return u32(0x40810000+index*64)
    return u32(if (index+1 < count) at+4 else 0)
}
@export("abla_i2s_capture_finish_c6_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(144);val r=nativeBufferAt(storage,72);val q=nativeBufferAt(storage+72,72)
    while (channel < 3) {
        count=1
        while (count <= 8) {
            fault=0
            while (fault < 5) {
                var at=0
                while (at < 144) { nativeBufferAt(storage,144).storeU32(at,0);at=at+4 }
                r.storeU32(0,0x43364944);r.storeU32(4,1);r.storeU32(12,channel);r.storeU32(20,0x40800000);r.storeU32(24,count)
                r.storeU32(28,0x40810000);r.storeU32(32,64);r.storeU32(36,64);r.storeU32(52,3)
                available=0;conf=u32(4);link=u32(0);events=u32(0);raw=u32(0);stops=0;acks=0;fifo=false;bad=false
                if (c6CaptureFinishOwned(r,q,1,1,true) != 5 || stops != 0) return i32(1)
                available=count
                if (c6CaptureFinishOwned(r,q,8,1,true) != 5 || stops != 0 || q.loadU32(24) != count*32) return i32(2)
                events=u32(3);raw=u32(if (fault == 1) 5 else 1)
                val result=c6CaptureFinishOwned(r,q,8,1,true)
                if (fault == 1) {
                    if (result != 3 || stops != 0 || acks != 0 || q.loadU32(64) != 5) return i32(3)
                } else {
                    if (result != 5 || stops != 1 || acks != 0) return i32(4)
                    fifo=true
                    val finished=c6CaptureFinishOwned(r,q,8,1,true)
                    if (fault == 2 || fault == 3) {
                        if (finished != 3 || acks != 0) return i32(5)
                    } else if (fault == 4) {
                        if (finished != 4 || acks != 1) return i32(6)
                        fault=0
                        if (c6CaptureFinishOwned(r,q,8,1,true) != 1 || acks != 1) return i32(7)
                        fault=4
                    } else if (finished != 1 || acks != 1 || raw != u32(0)) return i32(8)
                }
                if (bad || stops > 1) return i32(9)
                fault=fault+1
            }
            count=count+1
        }
        channel=channel+1
    }
    return i32(0)
}
