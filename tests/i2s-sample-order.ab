import "../src/esp32/i2s_sample_order.ab"
import "abla/unsafe/memory"

trusted fun main(): int {
    val samples = nativeStackAllocate(8)
    nativeAddressStoreU16(samples, 0, 1)
    nativeAddressStoreU16(samples, 2, 2)
    nativeAddressStoreU16(samples, 4, 3)
    nativeAddressStoreU16(samples, 6, 4)

    swapEsp32MonoSamplePairs(samples, 8)
    val wireOrder = nativeAddressLoadU16(samples, 0) == 2 &&
        nativeAddressLoadU16(samples, 2) == 1 &&
        nativeAddressLoadU16(samples, 4) == 4 &&
        nativeAddressLoadU16(samples, 6) == 3

    swapEsp32MonoSamplePairs(samples, 8)
    val restored = nativeAddressLoadU16(samples, 0) == 1 &&
        nativeAddressLoadU16(samples, 2) == 2 &&
        nativeAddressLoadU16(samples, 4) == 3 &&
        nativeAddressLoadU16(samples, 6) == 4

    if (wireOrder && restored) 43 else 1
}
