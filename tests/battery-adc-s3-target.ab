import "../src/m5stack/battery_adc_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_battery_adc_s3_target")
trusted fun target(open: bool,board: int,token: int,calibration: int): int {
    val cal=Esp32S3AdcCalibration(calibration)
    if (open) return M5BoardId(board).openBatteryAdcS3Owned(cal,true,true,100000).bits()
    return Esp32S3Adc1Session(token).batteryMillivoltsS3(M5BoardId(board),cal)
}
