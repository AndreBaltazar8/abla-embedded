import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/adc_frontend_c5_sequence.ab"
var fe=u32(0)
var pmu=u32(0)
var pwdet=u32(0)
var ctrl=u32(0)
var writes=0
var drop=0
var masterBusy=false
var bad=false
trusted fun c5AdcClockRead(offset: int): u32 = if (offset == 0) u32(4) else u32(0x400000)
trusted fun c5AdcClockWrite(offset: int,value: u32): void { bad=true;return }
trusted fun c5AdcRead(offset: int): u32 = if (offset == 0) ctrl else u32(0)
trusted fun c5AdcWrite(offset: int,value: u32): void {
    writes=writes+1
    if (offset != 0) bad=true
    if (writes != drop) ctrl=value
    return
}
trusted fun c5AdcFrontendRead(offset: int): u32 = if (offset == 0) fe else if (offset == 4) pmu else if (offset == 8) pwdet else if (offset == 12) u32(4) else if (masterBusy) u32(0x2000000) else u32(0)
trusted fun c5AdcFrontendWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0) { if ((value&fe) != fe) bad=true;fe=value }
    else if (offset == 4) pmu=value else if (offset == 8) pwdet=value else bad=true
    return
}
@export("abla_adc_frontend_c5_test")
trusted fun test(): i32 {
    var state=0
    while (state < 128) {
        val oldPmu=u32(0x123456)|(u32(state&3)<<u32(26))
        val oldPwdet=u32(0xa0123456)|(u32((state>>>2)&3)<<u32(23))
        val oldCtrl=u32(0x40000240)|(u32((state>>>4)&1)<<u32(29))
        val oldFe=u32(0x12340000)|(u32((state>>>5)&1)<<u32(13))|(u32((state>>>6)&1)<<u32(15))
        var fault=0
        while (fault < 12) {
            pmu=oldPmu;pwdet=oldPwdet;ctrl=oldCtrl;fe=oldFe;writes=0;drop=fault;bad=false
            var owner=c5AdcFrontendOpenOwned(true,true)
            if (owner.ready() && ((pmu&u32(0xc000000)) != u32(0xc000000) || (pwdet&u32(0x1800000)) != u32(0x1800000) || (ctrl&u32(0x20000000)) == u32(0) || (fe&u32(0xa000)) != u32(0xa000))) return i32(1)
            owner=owner.closeOwned(true);drop=0;owner=owner.closeOwned(true)
            if (owner.status() != 0 || pmu != oldPmu || pwdet != oldPwdet || ctrl != oldCtrl || (fe&~u32(0xa000)) != (oldFe&~u32(0xa000)) || bad) return i32(2)
            fault=fault+1
        }
        state=state+1
    }
    pmu=u32(0);writes=0
    if (c5AdcFrontendOpenOwned(true,false).status() != 4 || writes != 0) return i32(3)
    if (c5AdcFrontendOpenOwned(false,true).status() != 2 || writes != 0) return i32(4)
    masterBusy=true
    if (c5AdcFrontendOpenOwned(true,true).status() != 3 || writes != 0) return i32(5)
    masterBusy=false
    var owner=c5AdcFrontendOpenOwned(true,true)
    val before=writes
    masterBusy=true;owner=owner.closeOwned(true)
    if (owner.status() != 3 || writes != before) return i32(6)
    masterBusy=false;owner=owner.closeOwned(true)
    if (owner.status() != 0 || bad) return i32(7)
    return i32(0)
}
