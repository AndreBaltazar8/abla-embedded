import "./sd-s3-fat-image.ab"
import "../src/storage/fat_spi_s3.ab"
import "../src/storage/fat_file_read.ab"
import "../src/storage/fat_spi_s3_write.ab"
import "../src/storage/fat_file_overwrite_checked.ab"
val fatMemory=nativeStaticAllocate(2588)
val directoryMemory=nativeStaticAllocate(512)
val checkedMemory=nativeStaticAllocate(2048)
@export("abla_fat_spi_s3_test")
trusted fun testFatSpiS3(): i32 {
    peripheral=2;firstPin=10;prepareSessionCard()
    val sessionStorage=nativeBufferAt(sessionMemory,64);val gate=peripheralGateAt(gateStorage)
    val spiScratch=nativeBufferAt(memory,2);val response=nativeBufferAt(memory+4,16)
    val reader=nativeBufferAt(fatMemory,28);val boot=nativeBufferAt(fatMemory+28,512)
    val output=nativeBufferAt(fatMemory+540,512);val workspace=nativeBufferAt(fatMemory+1052,1536)
    prepareFatImage()
    var at=0
    val master=sdSpiS3Link(2,spiPins(10,11,12),Pin(13))
    if (!esp32S3SdSessionInitializeFresh(sessionStorage)) return i32(1)
    var session=esp32S3SdSessionOpen(sessionStorage,master,gate,u32(7),80000000,spiScratch,response,4)
    imageEnabled=true
    if (session == 0 || !fatSpiS3ReaderInitialize(reader,session,u32(7),spiScratch,4) ||
        !fatStorageReadOwned(reader,0,boot) || !fatBootValidate(boot,0,10113).valid() || bad) return i32(2)
    val directory=fatDirectoryReadOwned(reader,boot,0,10113,0,0,1,output,nativeBufferAt(workspace.addressValue(),1024))
    val file=fatDirectoryDecode(output,0,16,10000)
    if (directory.status() != 1 || !file.isFile() || file.byteSize() != 700 || file.firstCluster() != 2 || bad) return i32(3)
    if (fatFileReadAtOwned(reader,boot,0,10113,file,0,512,2,output,workspace).bytesRead() != 512 || bad) return i32(4)
    at=0
    while (at < 512) { if (output.load(at) != ((at+113)&255)) return i32(5);at=at+1 }
    if (fatFileReadAtOwned(reader,boot,0,10113,file,512,512,2,output,workspace).bytesRead() != 188 || bad) return i32(6)
    at=0
    while (at < 188) { if (output.load(at) != ((at+114)&255)) return i32(7);at=at+1 }
    val rawDirectory=nativeBufferAt(directoryMemory,512)
    if (!fatStorageReadOwned(reader,81,rawDirectory)) return i32(14)
    output.store(0,42);output.store(1,43)
    val overwritten=fatFileOverwriteAtOwned(reader,boot,0,10113,rawDirectory,0,510,2,2,output,workspace)
    if (overwritten.bytesWritten() != 2 || bad || !fatStorageReadOwned(reader,113,output)) return i32(15)
    at=0
    while (at < 512) {
        if (output.load(at) != (if (at == 510) 42 else if (at == 511) 43 else (at+113)&255)) return i32(16)
        at=at+1
    }
    val before=starts
    if (fatStorageWriteOwned(reader,4294967296,output) || fatStorageWriteOwned(reader,0,nativeBufferAt(fatMemory,512)) ||
        fatStorageReadOwned(reader,4294967296,output) || fatStorageReadOwned(reader,0,nativeBufferAt(fatMemory,512)) ||
        fatSpiS3ReaderInitialize(nativeBufferAt(sessionMemory,28),session,u32(7),spiScratch,4) || starts != before) return i32(8)
    val modified=rtcCalendarDateTime(2026,9,9,12,34,57)
    output.store(0,99)
    val checked=fatFileOverwriteCheckedOwned(reader,boot,0,10113,0,0,0,nativeBufferAt(directoryMemory,32),
        0,1,2,output,modified,nativeBufferAt(checkedMemory,2048))
    if (checked.status() != 1 || checked.dataBytesWritten() != 1 || bad ||
        !fatStorageReadOwned(reader,81,output) || output.load(11) != 32 ||
        output.loadU32(22) != fatModifiedTimestamp(modified) || output.loadU32(28) != 700 ||
        !fatStorageReadOwned(reader,113,output) || output.load(0) != 99 || output.load(510) != 42) return i32(17)
    output.store(0,42);imageCorrupt=true
    if (fatFileReadAtOwned(reader,boot,0,10113,file,0,512,2,output,workspace).status() != 4 || output.load(0) != 42 || bad) return i32(9)
    imageCorrupt=false
    prepareSessionCard()
    session=esp32S3SdSessionOpen(sessionStorage,master,gate,u32(7),80000000,spiScratch,response,4)
    imageEnabled=true
    val reopened=starts
    if (session == 0 || fatStorageReadOwned(reader,0,output) || fatStorageWriteOwned(reader,0,output) || starts != reopened || bad) return i32(11)
    if (!fatSpiS3ReaderInitialize(reader,session,u32(7),spiScratch,4) || !fatStorageReadOwned(reader,0,output) || bad) return i32(12)
    if (!session.invalidate(u32(7)) || bad) return i32(13)
    return i32(0)
}
