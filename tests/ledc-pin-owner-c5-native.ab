import "../src/esp32/ledc_pin_owner_c5_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
var writes=0
var drop=0
var fault=0
var bad=false
var expectedUnit=0
var txPin=0
var rxPin=1
fun addressOffset(address: int): int = if (address >= 0x60090000 && address < 0x60090078) address-0x60090000 else
    if (address >= 0x60091000 && address < 0x60091b4c) 256+address-0x60091000 else -1
fun c5GpioRead(address: int): u32 {
    if (address == 0x600960f0) return if (fault == 1) u32(3) else u32(1)
    if (address == 0x600960f4) return if (fault == 2) u32(0) else u32(0x400000)
    if (address == 0x60091df8) return u32(1)
    if (address == 0x600b102c) return if (fault == 3) u32(1)<<u32(txPin) else u32(0)
    if (address == 0x600b1028 || address == 0x6000f018) return u32(0)
    val at=addressOffset(address)
    if (at < 0) { bad=true;return u32(0) }
    return u32(nativeAddressLoadU32(memory,at))
}
fun c5GpioWrite(address: int,value: u32): void {
    writes=writes+1
    var at=addressOffset(address);var wanted=value
    if (address == 0x60091008 || address == 0x60091038) { at=at-4;wanted=u32(nativeAddressLoadU32(memory,at))|value }
    if (address == 0x6009100c || address == 0x6009103c) { at=at-8;wanted=u32(nativeAddressLoadU32(memory,at))&~value }
    if (at < 0) { bad=true;return }
    if (writes != drop) nativeAddressStoreU32(memory,at,int(wanted))
    return
}
var channel=0
var inverted=false
var live=false
fun c5LedcClockRead(offset: int): int = if (offset == 0) 5 else if (offset == 4) 0x600000 else 0
fun c5LedcClockWrite(offset: int,value: int): void { bad=true;return }
fun c5LedcRead(offset: int): int {
    if (offset == channel*20) return (if (inverted) 8 else 0)|(if (live) 4 else 0)
    if (offset == channel*20+12) return 0
    bad=true;return 0
}
fun c5LedcWrite(offset: int,value: int): void { bad=true;return }
val saved=nativeStaticAllocate(4096)
val lease=nativeStaticAllocate(40)
@export("abla_ledc_pin_owner_c5_test")
trusted fun testOwner(): int {
    val record=nativeBufferAt(lease,40)
    var scenario=0
    while (scenario < 3828) {
        txPin=scenario%29;channel=(scenario/29)%6;inverted=(scenario/174)%2 != 0
        writes=0;drop=0;fault=0;bad=false;live=false;record.storeU32(0,0)
        var at=0
        while (at < 4096) { nativeAddressStoreU32(memory,at,0);at=at+4 }
        nativeAddressStoreU32(memory,addressOffset(0x60091ad4+txPin*4),0x84000580)
        nativeAddressStoreU32(memory,addressOffset(0x60090000+txPin*4),0x85001380)
        nativeAddressStoreU32(memory,addressOffset(0x600910d4+txPin*4),0x82000004)
        nativeAddressStoreU32(memory,addressOffset(0x60091004),scenario%2*0x1fffffff)
        at=0
        while (at < 4096) { nativeAddressStoreU32(saved,at,nativeAddressLoadU32(memory,at));at=at+4 }
        drop=scenario/348
        val opened=c5LedcPinOpenOwned(record,txPin,channel,inverted,true)
        if ((opened != 1 && opened != 4) || bad) return 1
        if (opened == 1 && ((c5GpioRead(0x60091ad4+txPin*4)&u32(4095)) != u32(1024|channel|(if (inverted) 512 else 0)) ||
            (c5GpioRead(0x60091034)&(u32(1)<<u32(txPin))) == u32(0))) return 2
        val oldWrites=writes
        if (c5LedcPinOpenOwned(record,txPin,channel,inverted,true) != 2 || writes != oldWrites) return 3
        live=true
        if (c5LedcPinCloseOwned(record,true) != 3 || writes != oldWrites) return 4
        live=false;drop=writes+1+scenario%6
        val closed=c5LedcPinCloseOwned(record,true)
        if (closed != 5 && closed != 6) return 5
        drop=0
        if (c5LedcPinCloseOwned(record,true) != 6 || bad) return 6
        at=0
        while (at < 4096) {
            if (nativeAddressLoadU32(memory,at) != nativeAddressLoadU32(saved,at)) return 7
            at=at+4
        }
        val finalWrites=writes
        if (c5LedcPinCloseOwned(record,true) != 6 || writes != finalWrites) return 8
        scenario=scenario+1
    }
    return 0
}
