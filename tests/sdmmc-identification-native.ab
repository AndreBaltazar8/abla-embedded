import "../src/sd/mmc_host_clock_s3_sequence.ab"
import "../src/sd/mmc_frequency.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(4096)
var writes=0
var drop=-1
trusted fun sdMmcS3Read(offset: int): int = nativeBufferAt(storage,4096).loadU32(offset)
trusted fun sdMmcS3Write(offset: int,value: int): void {
    writes=writes+1
    if (offset != drop) nativeBufferAt(storage,4096).storeU32(offset,value)
    return
}
trusted fun reset(): void {
    var index=0
    while (index < 4096) { nativeBufferAt(storage,4096).store(index,0); index=index+1 }
    nativeBufferAt(storage,4096).storeU32(24,0xffffffff)
    nativeBufferAt(storage,4096).storeU32(116,0xffffffff)
    nativeBufferAt(storage,4096).storeU32(268,0xffffffff)
    writes=0; drop=-1
    return
}
@export("abla_sdmmc_identification_test")
trusted fun test(): i32 {
    val fractional=SdMmcFrequency((1<<41)|(39999999<<13)|(5<<5)|10)
    if (fractional.actualHz() != 399999 || fractional.actualHzCeiling() != 400000 || SdMmcFrequency(0).actualHzCeiling() != 0) return i32(8)
    var slot=0
    while (slot < 2) {
        var ms=1
        while (ms <= 1000) {
            reset()
            if (sdMmcHostIdentificationConfigureOwned(slot,400000,ms,true) != 1 || sdMmcS3Read(20) != (((400*ms)<<8)|255)) return i32(1)
            val bit=1<<slot
            if (sdMmcS3Read(24) != (0xffffffff&~(bit|(bit<<16))) || sdMmcS3Read(116) != (0xffffffff&~(bit<<16)) || sdMmcS3Read(268) != (0xffffffff&~bit)) return i32(2)
            ms=ms+1
        }
        slot=slot+1
    }
    reset()
    if (sdMmcHostIdentificationConfigureOwned(0,399999,1,true) != 1 || sdMmcS3Read(20) != 102655) return i32(3)
    reset()
    if (sdMmcHostIdentificationConfigureOwned(0,1,1,true) != 1 || sdMmcS3Read(20) != 511) return i32(4)
    var stage=0
    while (stage < 4) {
        reset(); drop=if (stage == 0) 20 else if (stage == 1) 24 else if (stage == 2) 116 else 268
        if (sdMmcHostIdentificationConfigureOwned(0,400000,100,true) != 4 || writes != stage+1) return i32(5)
        stage=stage+1
    }
    var guard=0
    while (guard < 6) {
        val offset=if (guard == 0) 16 else if (guard == 1) 44 else if (guard == 2) 72 else if (guard == 3) 0 else if (guard == 4) 128 else 140
        val mask=if (guard == 0) 65535 else if (guard == 1) 0x80000000 else if (guard == 2) 0x3ffe06f0 else if (guard == 3) 0x02000037 else if (guard == 4) 0x83 else 0x1e000
        var bit=0
        while (bit < 32) {
            if (((1<<bit)&mask) != 0) {
                reset(); nativeBufferAt(storage,4096).storeU32(offset,1<<bit)
                if (sdMmcHostIdentificationConfigureOwned(0,400000,100,true) != 3 || writes != 0) return i32(6)
            }
            bit=bit+1
        }
        guard=guard+1
    }
    reset()
    if (sdMmcHostIdentificationConfigureOwned(2,400000,100,true) != 2 || sdMmcHostIdentificationConfigureOwned(0,400001,100,true) != 2 || sdMmcHostIdentificationConfigureOwned(0,400000,0,true) != 2 || sdMmcHostIdentificationConfigureOwned(0,400000,1001,true) != 2 || sdMmcHostIdentificationConfigureOwned(0,400000,100,false) != 2 || writes != 0) return i32(7)
    return i32(0)
}
