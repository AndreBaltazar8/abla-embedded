import "../src/display/dpi_clock_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var reg=u32(0)
var bus=u32(4096)
var bridge=u32(0)
var writes=0
var reads=0
var drop=-1
var bad=false
fun p4DsiClockRead(offset: int): u32 { reads=reads+1; if (offset == 24) return bus; if (offset != 60) bad=true; return reg }
fun p4DsiClockWrite(offset: int,value: u32): void { if (offset != 60) bad=true; if (writes != drop) reg=value; writes=writes+1; return }
fun p4DsiBridgeRead(offset: int): u32 { reads=reads+1; if (offset != 4 || bus == u32(0)) bad=true; return bridge }
@export("abla_dsi_p4_dpi_clock_test")
trusted fun testClock(): i32 {
    var source=0
    while (source < 4) {
        val khz=if (source == 0) 40000 else if (source == 1) 240000 else if (source == 2) 160000 else 98304
        var expected=1000
        while (expected <= 160000) {
            val plan=esp32P4DpiClockPlan(source,khz,expected)
            val div=(khz+expected/2)/expected
            if (plan.valid() != (div >= 1 && div <= 256)) return i32(1)
            if (plan.valid()) {
                if (plan.divider() != div || plan.source() != source || plan.sourceKhz() != khz ||
                    plan.floorKhz() != khz/div || plan.ceilKhz() != (khz+div-1)/div) return i32(2)
                reg=u32(4294967167); writes=0
                if (esp32P4DpiClockStartOwned(plan) != 1 || writes != 2 || reg != (u32(4294901791)|u32(source*32+(div-1)*256+128))) return i32(3)
                writes=0
                if (esp32P4DpiClockStartOwned(plan) != 4 || writes != 0) return i32(4)
                if (esp32P4DpiClockStopOwned() != 1 || (reg&u32(128)) != u32(0) || bad) return i32(5)
            }
            expected=expected+997
        }
        source=source+1
    }
    val tab=esp32P4DpiClockPlan(1,240000,70000)
    if (tab.divider() != 3 || tab.floorKhz() != 80000) return i32(6)
    drop=0; reg=u32(0); writes=0
    if (esp32P4DpiClockStartOwned(tab) != 5 || writes != 1) return i32(7)
    drop=1; reg=u32(0); writes=0
    if (esp32P4DpiClockStartOwned(tab) != 5 || writes != 2) return i32(8)
    drop=0; reg=u32(128); writes=0
    if (esp32P4DpiClockStopOwned() != 5) return i32(9)
    drop= -1; bus=u32(0); reg=u32(0); writes=0
    if (esp32P4DpiClockStartOwned(tab) != 3 || writes != 0 || bad) return i32(10)
    bus=u32(4096); bridge=u32(1)
    if (esp32P4DpiClockStartOwned(tab) != 4 || writes != 0) return i32(11)
    reads=0
    if (esp32P4DpiClockStartOwned(esp32P4DpiClockPlan(1,160000,70000)) != 2 || reads != 0 || bad) return i32(12)
    i32(0)
}
