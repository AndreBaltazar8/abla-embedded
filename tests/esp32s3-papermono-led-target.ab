import "../src/esp32/i2c_esp32s3.ab"
import "../src/led/papermono.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun paperMonoTarget(power: u32, expander: u32, rgb: u32, brightness: u32): bool {
    val pmic = M5Pm1(int(power))
    val ioe = M5Ioe1(int(expander))
    paperMonoLedConfigure(pmic, ioe) && paperMonoLedWrite(pmic, ioe,
        int((rgb >>> u32(16)) & u32(255)), int((rgb >>> u32(8)) & u32(255)),
        int(rgb & u32(255)), int(brightness))
}
#exportFunction("paperMonoTarget", "abla_s3_papermono_led_test")
