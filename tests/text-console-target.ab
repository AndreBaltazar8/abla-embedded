import "../src/display/text_console.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_text_console_target")
trusted fun target(buffer: int,size: int,width: int,height: int,stride: int,text: int,length: int,cursor: int,scale: int): int =
    TextCursor(cursor).writeRgb565Owned(nativeBufferAt(buffer,size),width,height,stride,nativeBufferAt(text,length),length,65535,0,scale)|0
