type Pin=int
fun Pin.number(): int = this|0
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this|0)
val memory=nativeStaticAllocate(256)
val source=nativeStaticAllocate(130)
val gateStorage=nativeStaticAllocate(4)
var starts=0
var edges=0
var failAt=0
var csFailure=0
var cs=true
var bad=false
var pixelMode=false
var total=0
var sent=0
var programMode=false
var waits=0
var fillMode=false
var blitMode=false
var shadowMode=false
var shadowSmall=false
var shadowRotation=0
var sleepMode=false
var sleeping=false
var sleepBrightness=0
val shadow=nativeStaticAllocate(438048)
val dirtyRecord=nativeStaticAllocate(32)
val frame=nativeStaticAllocate(240)
val programOracle=nativeStaticU32s([17,0,0, 196,1,128, 53,1,128, 68,2,0xd201, 83,1,32, 32,0,0, 54,1,0, 81,1,0, 41,0,0, 58,1,85])
fun peripheralDelayMilliseconds(ms: int): void {
    if ((!programMode && !sleepMode) || (sleepMode && sleeping) || !cs || starts != 1 || ms != 150 || nativeAddressLoadU32(gateStorage,0) != 37) bad=true
    waits=waits+1;return
}
fun Pin.outputLevelOwned(high: bool): bool { bad=true;return false }
fun Pin.routeOutputSignal(signal: int,inverted: bool): bool { bad=true;return false }
trusted fun Pin.writeLevelOwned(high: bool): bool {
    if (this != 39 || high == cs || nativeAddressLoadU32(gateStorage,0) != 37) bad=true
    cs=high;edges=edges+1
    return edges != csFailure
}
trusted fun esp32s3SpiRead(address: int): int = nativeBufferAt(memory,256).loadU32(address-0x60024000)
trusted fun esp32s3SpiWrite(address: int,value: int): void {
    val regs=nativeBufferAt(memory,256)
    val offset=address-0x60024000
    if (cs || nativeAddressLoadU32(gateStorage,0) != 37) bad=true
    if (offset == 0x38) { regs.storeU32(0x3c,regs.loadU32(0x3c)&~value);return }
    if (offset == 0) {
        if (value == 0x01000000) {
            if (sleepMode) {
                val brightnessCommand=if (sleeping) starts == 0 else starts == 1
                val cmd=if (brightnessCommand) 81 else if (sleeping) 16 else 17
                if (starts > 1 || regs.loadU32(0x10) != (if (brightnessCommand) 0xc8000000 else 0xc0000000) ||
                    regs.loadU32(0x18) != 0x70000002 || regs.loadU32(4) != cmd<<16 ||
                    regs.loadU32(0x1c) != (if (brightnessCommand) 7 else 0) ||
                    (brightnessCommand && regs.loadU32(0x98) != (if (sleeping) 0 else sleepBrightness))) bad=true
                if (!sleeping && starts == 1 && waits != 1) bad=true
                starts=starts+1
                regs.storeU32(0x3c,4096|(if (starts == failAt) 0x20000 else 0))
                regs.storeU32(0,0);return
            }
            if (shadowMode) {
                val header=starts < 2
                val first=starts == 2
                val width=if (shadowSmall) 2 else 468
                val rowBytes=width*2
                val left=(if (shadowSmall) 12 else 0)+(if ((shadowRotation&1) == 0) 6 else 0)
                val top=(if (shadowSmall) 16 else 0)+(if ((shadowRotation&1) == 0) 0 else 6)
                val count=if (header) 4 else if (rowBytes-sent%rowBytes < 64) rowBytes-sent%rowBytes else 64
                if (regs.loadU32(0x10) != (if (header) 0xc8000000 else if (first) 0xc8002000 else 0x08002000) ||
                    regs.loadU32(0x18) != (if (header) 0x70000002 else if (first) 0x70000032 else 0) ||
                    regs.loadU32(4) != (if (starts == 0) 0x2a0000 else if (starts == 1) 0x2b0000 else if (first) 0x2c0000 else 0) ||
                    regs.loadU32(0x1c) != count*8-1) bad=true
                if (header) {
                    val low=if (starts == 0) left else top
                    val high=low+width-1
                    if (regs.load(0x98) != low>>>8 || regs.load(0x99) != (low&255) ||
                        regs.load(0x9a) != high>>>8 || regs.load(0x9b) != (high&255)) bad=true
                } else {
                    var n=0
                    while (n < count) {
                        // Small update is a2x2 square, red bottom-right only.
                        if (regs.load(0x98+n) != (if (shadowSmall && sent+n == 6) 0xf8 else 0)) bad=true
                        n=n+1
                    }
                    sent=sent+count
                }
                starts=starts+1
                regs.storeU32(0x3c,4096|(if (starts == failAt) 0x20000 else 0))
                regs.storeU32(0,0);return
            }
            if (blitMode) {
                val header=starts < 2
                val first=starts == 2
                val count=if (header) 4 else if ((starts&1) == 0) 64 else 4
                if (regs.loadU32(0x10) != (if (header) 0xc8000000 else if (first) 0xc8002000 else 0x08002000) ||
                    regs.loadU32(0x18) != (if (header) 0x70000002 else if (first) 0x70000032 else 0) ||
                    regs.loadU32(4) != (if (starts == 0) 0x2a0000 else if (starts == 1) 0x2b0000 else if (first) 0x2c0000 else 0) ||
                    regs.loadU32(0x1c) != count*8-1) bad=true
                if (header) {
                    if (regs.loadU32(0x98) != (if (starts == 0) 0x27000600 else 0x01000000)) bad=true
                } else {
                    var n=0
                    while (n < count) {
                        val offset=if (sent < 68) sent+n else 80+sent-68+n
                        if (regs.load(0x98+n) != ((offset*19+3)&255)) bad=true
                        n=n+1
                    }
                    sent=sent+count
                }
                starts=starts+1
                regs.storeU32(0x3c,4096|(if (starts == failAt) 0x20000 else 0))
                regs.storeU32(0,0);return
            }
            if (fillMode) {
                val header=starts < 2
                val first=starts == 2
                val count=if (header) 4 else if (438048-sent < 64) 438048-sent else 64
                if (regs.loadU32(0x10) != (if (header) 0xc8000000 else if (first) 0xc8002000 else 0x08002000) ||
                    regs.loadU32(0x18) != (if (header) 0x70000002 else if (first) 0x70000032 else 0) ||
                    regs.loadU32(4) != (if (starts == 0) 0x2a0000 else if (starts == 1) 0x2b0000 else if (first) 0x2c0000 else 0) ||
                    regs.loadU32(0x1c) != count*8-1) bad=true
                if (header) {
                    if (regs.loadU32(0x98) != (if (starts == 0) 0xd9010600 else 0xd3010000)) bad=true
                } else {
                    var n=0
                    while (n < count) { if (regs.load(0x98+n) != 0) bad=true;n=n+1 }
                    sent=sent+count
                }
                starts=starts+1
                regs.storeU32(0x3c,4096|(if (starts == failAt) 0x20000 else 0))
                regs.storeU32(0,0);return
            }
            if (programMode) {
                if (starts >= 10) { bad=true;return }
                val expectedCommand=nativeAddressLoadU32(programOracle,starts*12)
                val expectedCount=nativeAddressLoadU32(programOracle,starts*12+4)
                if (regs.loadU32(0x10) != (0xc0000000|(if (expectedCount > 0) 0x08000000 else 0)) ||
                    regs.loadU32(0x18) != 0x70000002 || regs.loadU32(4) != expectedCommand<<16 ||
                    regs.loadU32(0x1c) != (if (expectedCount == 0) 0 else expectedCount*8-1) ||
                    (expectedCount > 0 && regs.loadU32(0x98) != nativeAddressLoadU32(programOracle,starts*12+8))) bad=true
                starts=starts+1
                regs.storeU32(0x3c,4096|(if (starts == failAt) 0x20000 else 0))
                regs.storeU32(0,0);return
            }
            val count=if (total-sent < 64) total-sent else 64
            val user=(if (starts == 0) 0xc0000000 else 0)|(if (count > 0) 0x08000000 else 0)|(if (pixelMode) 0x2000 else 0)
            if (regs.loadU32(0x10) != user || regs.loadU32(8) != 0 ||
                regs.loadU32(0x18) != (if (starts == 0) 0x70000000|(if (pixelMode) 50 else 2) else 0) ||
                regs.loadU32(4) != (if (starts == 0) (if (pixelMode) 0x2c0000 else 0x510000) else 0) ||
                regs.loadU32(0x14) != (if (starts == 0) 23<<27 else 0) ||
                regs.loadU32(0x1c) != (if (count == 0) 0 else count*8-1)) bad=true
            var n=0
            while (n < count) {
                if (regs.load(0x98+n) != (((sent+n)*37+11)&255)) bad=true
                n=n+1
            }
            sent=sent+count;starts=starts+1
            regs.storeU32(0x3c,4096|(if (starts == failAt) 0x20000 else 0))
        } else if (value != 0x00800000) bad=true
        regs.storeU32(0,0);return
    }
    regs.storeU32(offset,value);return
}
trusted fun seed(): void {
    var n=0
    while (n < 256) { nativeBufferAt(memory,256).store(n,0);n=n+1 }
    nativeAddressStoreU32(gateStorage,0,0)
    starts=0;edges=0;sent=0;waits=0;cs=true;bad=false;return
}
@export("abla_co5300_transfer_test")
trusted fun test(): i32 {
    val data=nativeBufferAt(source,130)
    val gate=peripheralGateAt(gateStorage)
    val pins=quadSpiPins(40,41,42,46,45)
    var n=0
    while (n < 130) { data.store(n,(n*37+11)&255);n=n+1 }
    var mode=0
    while (mode < 2) {
        pixelMode=mode == 1
        total=if (pixelMode) 2 else 0
        while (total <= 130) {
            val chunks=if (total == 0) 1 else (total+63)/64
            failAt=0
            while (failAt <= chunks) {
                csFailure=0
                while (csFailure <= 2) {
                    seed()
                    val result=esp32s3Co5300Transfer(gate,u32(37),2,pins,Pin(39),if (pixelMode) 44 else 81,data,total,pixelMode)
                    val failure=failAt != 0 || csFailure != 0
                    val expectedStarts=if (csFailure == 1) 0 else if (failAt != 0) failAt else chunks
                    val detail=if (csFailure == 1) 12 else if (failAt != 0) 0x20109 else if (csFailure == 2) 266 else 257
                    if (bad || !cs || edges != 2 || starts != expectedStarts || result.status() != (if (failure) 6 else 1) ||
                        result.value() != u32(detail|(if (csFailure == 2) 1<<24 else 0)) ||
                        nativeAddressLoadU32(gateStorage,0) != (if (failure) 2147483648 else 0)) return i32(1)
                    csFailure=csFailure+1
                }
                failAt=failAt+1
            }
            total=total+(if (pixelMode) 2 else 1)
        }
        mode=mode+1
    }
    seed()
    if (esp32s3Co5300Transfer(gate,u32(37),2,pins,Pin(39),44,data,1,true).status() != 3 ||
        esp32s3Co5300Transfer(gate,u32(37),2,pins,Pin(39),43,data,2,true).status() != 3 ||
        esp32s3Co5300Transfer(gate,u32(37),2,pins,Pin(39),81,data,131,false).status() != 3 || edges != 0 || starts != 0) return i32(2)
    nativeAddressStoreU32(gateStorage,0,7)
    if (esp32s3Co5300Transfer(gate,u32(37),2,pins,Pin(39),81,data,0,false).status() != 2 || edges != 0) return i32(3)
    programMode=true;csFailure=0
    failAt=0
    while (failAt <= 10) {
        seed()
        val result=esp32s3Co5300RunProgram(gate,u32(37),2,pins,Pin(39),stopWatchPanelInitProgram())
        if (bad || !cs || starts != (if (failAt == 0) 10 else failAt) || edges != starts*2 ||
            waits != (if (failAt == 1) 0 else 1) || result.status() != (if (failAt == 0) 1 else 6) ||
            nativeAddressLoadU32(gateStorage,0) != (if (failAt == 0) 0 else 2147483648)) return i32(4)
        failAt=failAt+1
    }
    val rotationOracle=nativeStaticBytes("\x00\x60\xc0\xa0\xc2\x62\x02\xa2")
    n=0
    while (n < 8) {
        if (stopWatchPanelMadctl(n) != nativeBufferAt(rotationOracle,8).load(n) ||
            stopWatchPanelColumnStart(n) != (if ((n&1) == 0) 6 else 0) ||
            stopWatchPanelRowStart(n) != (if ((n&1) == 0) 0 else 6)) return i32(5)
        n=n+1
    }
    fillMode=true;programMode=false;csFailure=0
    var trial=0
    while (trial < 5) {
        seed();failAt=if (trial < 4) trial else 6847
        val result=esp32s3Co5300Fill(gate,u32(37),2,pins,Pin(39),6,0,468,468,rgb565Black)
        if (bad || !cs || starts != (if (failAt == 0) 6847 else failAt) ||
            edges != (if (failAt == 1) 2 else if (failAt == 2) 4 else 6) ||
            result.status() != (if (failAt == 0) 1 else 6) || (failAt == 0 && sent != 438048)) return i32(6)
        trial=trial+1
    }
    seed()
    if (esp32s3Co5300Fill(gate,u32(37),2,pins,Pin(39),7,0,2,1,rgb565Black).status() != 3 ||
        esp32s3Co5300Fill(gate,u32(37),2,pins,Pin(39),6,0,3,1,rgb565Black).status() != 3 || edges != 0 || starts != 0) return i32(7)
    fillMode=false;blitMode=true
    n=0
    while (n < 240) { nativeBufferAt(frame,240).store(n,(n*19+3)&255);n=n+1 }
    failAt=0
    while (failAt <= 6) {
        seed()
        val result=esp32s3Co5300Blit(gate,u32(37),2,pins,Pin(39),6,0,34,2,nativeBufferAt(frame,240),80)
        if (bad || !cs || starts != (if (failAt == 0) 6 else failAt) ||
            edges != (if (failAt == 1) 2 else if (failAt == 2) 4 else 6) || result.status() != (if (failAt == 0) 1 else 6) ||
            (failAt == 0 && sent != 136)) return i32(8)
        n=0
        while (n < 240) { if (nativeBufferAt(frame,240).load(n) != ((n*19+3)&255)) return i32(9);n=n+1 }
        failAt=failAt+1
    }
    seed()
    if (esp32s3Co5300Blit(gate,u32(37),2,pins,Pin(39),6,0,34,2,nativeBufferAt(frame,147),80).status() != 3 ||
        esp32s3Co5300Blit(gate,u32(37),2,pins,Pin(39),6,0,34,2,nativeBufferAt(frame,240),67).status() != 3 ||
        esp32s3Co5300Blit(gate,u32(37),2,pins,Pin(39),7,0,34,2,nativeBufferAt(frame,240),80).status() != 3 || starts != 0 || edges != 0) return i32(10)
    blitMode=false;shadowMode=true;csFailure=0;failAt=0
    val canvas=nativeBufferAt(shadow,438048)
    val record=nativeBufferAt(dirtyRecord,32)
    if (!rgb565DirtyOpenOwned(record,canvas,468,468,936,true)) return i32(11)
    seed()
    if (!stopWatchCanvasDirtyFlushOwned(record,canvas,gate,u32(37),0,true).valid() ||
        bad || starts != 7022 || sent != 438048 || edges != 6 || !rgb565DirtyRect(record).empty()) return i32(12)
    shadowSmall=true
    // Independent model scenarios; explicit model gate reset is not an API
    // retry/recovery recommendation for real hardware.
    shadowRotation=0
    while (shadowRotation < 8) {
        if (!rgb565DirtyFillOwned(record,canvas,13,17,1,1,Rgb565(0xf800),true)) return i32(13)
        seed();failAt=4
        val failed=stopWatchCanvasDirtyFlushOwned(record,canvas,gate,u32(37),shadowRotation,true)
        if (failed.status() != 6 || bad || !cs || edges != 6 || starts != 4 || sent != 8 ||
            rgb565DirtyRect(record) != displayRect(13,17,1,1) || nativeAddressLoadU32(gateStorage,0) != 2147483648) return i32(14)
        val previousStarts=starts
        if (stopWatchCanvasDirtyFlushOwned(record,canvas,gate,u32(37),shadowRotation,true).status() != 4 || starts != previousStarts ||
            rgb565DirtyRect(record) != displayRect(13,17,1,1)) return i32(15)
        seed();failAt=0
        if (!stopWatchCanvasDirtyFlushOwned(record,canvas,gate,u32(37),shadowRotation,true).valid() ||
            bad || !cs || starts != 4 || sent != 8 || edges != 6 || !rgb565DirtyRect(record).empty()) return i32(16)
        shadowRotation=shadowRotation+1
    }
    shadowMode=false;sleepMode=true
    var variant=0
    while (variant < 4) {
        sleeping=(variant&1) != 0;sleepBrightness=if ((variant&2) == 0) 0 else 255
        failAt=0
        while (failAt <= 2) {
            seed()
            val result=stopWatchPanelSleepOwned(gate,u32(37),sleeping,sleepBrightness,true)
            if (bad || !cs || starts != (if (failAt == 0) 2 else failAt) || edges != starts*2 ||
                waits != (if (sleeping || failAt == 1) 0 else 1) || result.status() != (if (failAt == 0) 1 else 6) ||
                nativeAddressLoadU32(gateStorage,0) != (if (failAt == 0) 0 else 2147483648)) return i32(17)
            failAt=failAt+1
        }
        variant=variant+1
    }
    seed()
    if (stopWatchPanelSleepOwned(gate,u32(37),false,0,false).status() != 3 ||
        stopWatchPanelSleepOwned(gate,u32(37),false,-1,true).status() != 3 ||
        stopWatchPanelSleepOwned(gate,u32(37),false,256,true).status() != 3 || starts != 0 || edges != 0 || waits != 0) return i32(18)
    return i32(0)
}
