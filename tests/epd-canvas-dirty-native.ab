import "../src/display/epd_canvas_dirty.ab"
import "abla/build"
val dirtyStorage=nativeStaticAllocate(576)
@export("abla_epd_canvas_dirty_test")
fun testDirty(): int {
    val r=nativeBufferAt(dirtyStorage,40);val canvas=nativeBufferAt(dirtyStorage+64,48)
    val state=nativeBufferAt(dirtyStorage+128,192);val source=nativeBufferAt(dirtyStorage+384,48)
    val savedCanvas=nativeBufferAt(dirtyStorage+448,48);val savedRecord=nativeBufferAt(dirtyStorage+512,40)
    var profile=0
    while (profile < 256) {
        var i=0
        while (i < 40) { r.store(i,0);i=i+1 }
        i=0
        while (i < 48) { canvas.store(i,0x88);source.store(i,(i*29+profile)&255);i=i+1 }
        if (!epdCanvasDirtyOpenOwned(r,canvas,16,6,true) || !epdCanvasDirtyValid(r,canvas) ||
            epdCanvasDirtyOpenOwned(r,canvas,16,6,true) || !epdWaveformInitialize(state,96,true)) return 1
        val mode=(profile>>>6)+1
        var minX=16;var minY=6;var endX=0;var endY=0
        var draw=0
        while (draw < 2) {
            val rotation=if (draw == 0) profile&7 else (profile>>>3)&7
            val x=if (draw == 0) -1 else 2;val y=if (draw == 0) 1 else -1
            val w=if (draw == 0) 5 else 3
            if (!epdCanvasDirtyDrawOwned(r,canvas,x,y,w,4,rotation,source,5,-1,mode,true)) return 2
            var ly=0
            while (ly < (if ((rotation&1) == 0) 6 else 16)) {
                var lx=0
                while (lx < (if ((rotation&1) == 0) 16 else 6)) {
                    if (lx >= x && lx < x+w && ly >= y && ly < y+4) {
                        var px=if ((rotation&1) == 0) lx else ly;var py=if ((rotation&1) == 0) ly else lx
                        if (rotation == 1 || rotation == 2 || rotation == 6 || rotation == 7) px=15-px
                        if (rotation == 2 || rotation == 3 || rotation == 4 || rotation == 7) py=5-py
                        if (px < minX) minX=px
                        if (py < minY) minY=py
                        if (px+1 > endX) endX=px+1
                        if (py+1 > endY) endY=py+1
                    }
                    lx=lx+1
                }
                ly=ly+1
            }
            if (r.loadU32(16) != mode || r.loadU32(20) != minX || r.loadU32(24) != minY || r.loadU32(28) != endX || r.loadU32(32) != endY) return 3
            draw=draw+1
        }
        i=0
        while (i < 48) { savedCanvas.store(i,canvas.load(i));i=i+1 }
        i=0
        while (i < 40) { savedRecord.store(i,r.load(i));i=i+1 }
        if (epdCanvasDirtyDrawOwned(r,canvas,0,0,1,1,0,source,5,255,(mode%4)+1,true) ||
            epdCanvasDirtyDrawOwned(r,canvas,0,0,1,1,0,r,1,-1,mode,true) ||
            epdCanvasDirtySubmitOwned(r,canvas,nativeBufferAt(r.addressValue(),192),true) ||
            epdCanvasDirtyDrawOwned(r,canvas,0,0,1,1,0,source,5,255,mode,false)) return 4
        if (!epdCanvasDirtyDrawOwned(r,canvas,-2147483648,0,10,10,0,source,0,255,(mode%4)+1,true)) return 5
        i=0
        while (i < 48) { if (savedCanvas.load(i) != canvas.load(i)) return 6;i=i+1 }
        i=0
        while (i < 40) { if (savedRecord.load(i) != r.load(i)) return 7;i=i+1 }
        // Corrupt the last selected pair: failed submit must retain dirty work
        // AND leave every earlier waveform record intact, then permit retry.
        val badPair=(endY-1)*8+(endX-1)/2
        state.storeU32(badPair*4,0x7fff7fff)
        if (epdCanvasDirtySubmitOwned(r,canvas,state,true)) return 8
        i=0
        while (i < 40) { if (savedRecord.load(i) != r.load(i)) return 9;i=i+1 }
        i=0
        while (i < 48) { if (state.loadU32(i*4) != (if (i == badPair) 0x7fff7fff else 0x88888888)) return 10;i=i+1 }
        state.storeU32(badPair*4,0x88888888)
        if (!epdCanvasDirtySubmitOwned(r,canvas,state,true) || !epdCanvasDirtyValid(r,canvas) || r.loadU32(16) != 0) return 11
        i=0
        while (i < 48) {
            val row=i/8;val pair=i%8
            val selected=row >= minY && row < endY && pair >= minX/2 && pair < (endX+1)/2
            val expected=if (selected) epdWaveformRequest(0x88888888,canvas.load(i),mode) else 0x88888888
            if (state.loadU32(i*4) != expected) return 12
            i=i+1
        }
        if (!epdCanvasDirtySubmitOwned(r,canvas,state,true) ||
            !epdCanvasDirtyDrawOwned(r,canvas,0,0,1,1,0,source,5,255,(mode%4)+1,true)) return 13
        profile=profile+1
    }
    return 0
}
