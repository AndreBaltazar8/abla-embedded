import "../src/peripheral_gate.ab"
import "abla/unsafe/memory"

trusted fun main(): int {
    val storage = nativeStackAllocate(4)
    ablaUnsafeStoreU32(nativePointerFromAddress(storage), 0)
    val gate = peripheralGateAt(storage)
    if (gate.tryBegin(u32(0)) != 3 || gate.tryBegin(u32(0x80000000)) != 3) return 1
    if (gate.tryBegin(u32(1)) != 0 || gate.tryBegin(u32(2)) != 1) return 2
    if (gate.finish(u32(2), true) || gate.tryBeginRecovery(u32(2))) return 3
    if (!gate.finish(u32(1), false)) return 4
    if (gate.tryBegin(u32(1)) != 2 || gate.finish(u32(1), true)) return 5
    if (!gate.tryBeginRecovery(u32(2)) || gate.tryBeginRecovery(u32(3))) return 6
    if (gate.tryBegin(u32(1)) != 2 || gate.finishRecovery(u32(3), true)) return 7
    if (!gate.finishRecovery(u32(2), false) || gate.tryBegin(u32(1)) != 2) return 8
    if (!gate.tryBeginRecovery(u32(3)) || !gate.finishRecovery(u32(3), true)) return 9
    if (gate.tryBegin(u32(0x7fffffff)) != 0 || !gate.finish(u32(0x7fffffff), true)) return 10
    if (gate.finish(u32(0x7fffffff), true) || gate.finishRecovery(u32(3), true)) return 11
    if (peripheralGateAt(0).tryBegin(u32(1)) != 3 ||
        peripheralGateAt(storage + 1).tryBegin(u32(1)) != 3) return 12
    if (ablaUnsafeLoadU32(nativePointerFromAddress(storage)) != 0) return 13
    0
}
