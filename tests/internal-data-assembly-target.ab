import "abla/unsafe/memory/raw"
import "abla/runtime/scalar"
import "abla/build"

// Regression for tools/check-internal-data-assembly: architecture-only symbol
// references must retain the source-owned data without exporting it or rooting
// an unrelated initialization function. Host x86-64 avoids a firmware build.
val assemblyStorage = nativeInternalLinkedStaticAllocate(8,"abla_assembly_storage")
val assemblyBytes = nativeInternalSectionBytes(
    "\x01\x00\x00\x00", "abla_assembly_bytes", ".rodata.abla.assembly_bytes",4
)
val unusedStorage = nativeInternalLinkedStaticAllocate(8,"abla_unused_storage")
val assemblyWords = nativeInternalSectionU32s(
    [7,11], "abla_assembly_words", ".rodata.abla.assembly_words"
)
val assemblyTls = nativeInternalSectionThreadLocalAllocate(
    4,"abla_assembly_tls",".tdata.abla.assembly_tls",4
)
val unusedWords = nativeInternalSectionU32s(
    [13], "abla_unused_words", ".rodata.abla.unused_words"
)
val unusedBytes = nativeInternalSectionBytes(
    "unused", "abla_unused_bytes", ".rodata.abla.unused_bytes",4
)
val unusedTls = nativeInternalSectionThreadLocalAllocate(
    4,"abla_unused_tls",".tdata.abla.unused_tls",4
)

trusted noescape extern:"inline-assembly" fun assemblyVoid(
    template: string, constraints: string
): void

@naked
@export("abla_internal_data_assembly_test")
trusted fun assemblyRoot(): void = assemblyVoid(
    "movq abla_assembly_storage(%rip), %rax\nmovl abla_assembly_bytes(%rip), %eax\nmovl abla_assembly_words(%rip), %eax\nmovl %fs:abla_assembly_tls@tpoff, %eax\nretq",
    "~{rax},~{memory}"
)
