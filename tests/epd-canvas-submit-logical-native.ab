import "../src/display/epd_canvas_submit_logical.ab"
import "abla/build"
val submitStorage=nativeStaticAllocate(320)
@export("abla_epd_canvas_submit_logical_test")
fun testSubmitLogical(): int {
    val canvas=nativeBufferAt(submitStorage,48)
    val state=nativeBufferAt(submitStorage+64,192)
    val selected=nativeBufferAt(submitStorage+256,48)
    var i=0
    while (i < 48) { canvas.store(i,(i*37+29)&255);i=i+1 }
    var rotation=0
    while (rotation < 8) {
        val lw=if ((rotation&1) == 0) 16 else 6
        val lh=if ((rotation&1) == 0) 6 else 16
        var mode=1
        while (mode <= 4) {
            var scenario=0
            while (scenario < 512) {
                val xi=scenario&7;val yi=(scenario>>>3)&7;val extent=scenario>>>6
                val x=if (xi == 0) -16 else if (xi == 1) -1 else if (xi == 2) 0 else if (xi == 3) 1 else if (xi == 4) lw-2 else if (xi == 5) lw-1 else if (xi == 6) lw else 30
                val y=if (yi == 0) -16 else if (yi == 1) -1 else if (yi == 2) 0 else if (yi == 3) 1 else if (yi == 4) lh-2 else if (yi == 5) lh-1 else if (yi == 6) lh else 30
                val w=if (extent == 0) 0 else if (extent < 3) 1 else if (extent < 5) 3 else 17
                val h=if (extent == 1) 0 else if (extent < 4) 1 else if (extent < 6) 3 else 17
                if (!epdWaveformInitialize(state,96,true)) return 1
                i=0
                while (i < 48) { selected.store(i,0);i=i+1 }
                // Per-logical-pixel oracle: mark pairs individually, no corner
                // transform or bounding-box calculation shared with submit.
                var ly=0
                while (ly < lh) {
                    var lx=0
                    while (lx < lw) {
                        if (lx >= x && lx < x+w && ly >= y && ly < y+h) {
                            var px=if ((rotation&1) == 0) lx else ly
                            var py=if ((rotation&1) == 0) ly else lx
                            if (rotation == 1 || rotation == 2 || rotation == 6 || rotation == 7) px=15-px
                            if (rotation == 2 || rotation == 3 || rotation == 4 || rotation == 7) py=5-py
                            selected.store(py*8+px/2,1)
                        }
                        lx=lx+1
                    }
                    ly=ly+1
                }
                if (!epdCanvasSubmitLogicalOwned(canvas,state,16,6,x,y,w,h,rotation,mode,true)) return 2
                i=0
                while (i < 48) {
                    val expected=if (selected.load(i) == 0) 0x88888888 else epdWaveformRequest(0x88888888,canvas.load(i),mode)
                    if (state.loadU32(i*4) != expected) return 3
                    i=i+1
                }
                scenario=scenario+1
            }
            mode=mode+1
        }
        rotation=rotation+1
    }
    if (!epdWaveformInitialize(state,96,true)) return 4
    // Invalid late record must not partially queue earlier pairs.
    state.storeU32(188,0x7fff7fff)
    if (epdCanvasSubmitLogicalOwned(canvas,state,16,6,0,0,16,6,0,1,true)) return 5
    i=0
    while (i < 47) { if (state.loadU32(i*4) != 0x88888888) return 6;i=i+1 }
    if (state.loadU32(188) != 0x7fff7fff ||
        epdCanvasSubmitLogicalOwned(canvas,state,16,6,0,0,1,1,0,1,false) ||
        epdCanvasSubmitLogicalOwned(canvas,state,16,6,0,0,1,1,8,1,true) ||
        epdCanvasSubmitLogicalOwned(canvas,state,16,6,0,0,-1,1,0,1,true) ||
        epdCanvasSubmitLogicalOwned(canvas,state,16,6,0,0,1,1,0,0,true) ||
        epdCanvasSubmitLogicalOwned(canvas,nativeBufferAt(state.addressValue(),191),16,6,0,0,1,1,0,1,true) ||
        epdCanvasSubmitLogicalOwned(nativeBufferAt(state.addressValue(),48),state,16,6,0,0,1,1,0,1,true)) return 7
    if (!epdCanvasSubmitLogicalOwned(canvas,state,16,6,-2147483648,2147483647,65535,65535,0,1,true)) return 8
    return 0
}
