import "../src/esp32/i2c/fifo_esp32s3.ab"

trusted fun main(): int {
    val empty = nativeBufferAt(0, 0)
    if (!empty.hasAddressRange(0, 0) || empty.hasAddressRange(0, 1)) return 1
    val normal = nativeBufferAt(4096, 32)
    if (!normal.hasAddressRange(0, 32) || !normal.hasAddressRange(32, 0)) return 2
    if (normal.hasAddressRange(-1, 1) || normal.hasAddressRange(0, -1) ||
        normal.hasAddressRange(31, 2) || normal.hasAddressRange(33, 0)) return 3
    if (normal.hasAddressRange(9223372036854775807, 1) ||
        normal.hasAddressRange(1, 9223372036854775807)) return 4
    val end = nativeBufferAt(4294967295, 2)
    if (!end.hasAddressRange(0, 1) || end.hasAddressRange(0, 2) ||
        end.hasAddressRange(1, 1)) return 5
    val boundary = nativeBufferAt(4294967264, 33)
    if (!boundary.hasAddressRange(0, 32) || boundary.hasAddressRange(0, 33)) return 6
    if (nativeBufferAt(0, 32).hasAddressRange(1, 1)) return 7
    // These are real backend calls: invalid spans must return before MMIO.
    if (esp32S3I2cWriteFifo(0, end, 2) || esp32S3I2cReadFifo(0, end, 2)) return 8
    if (esp32S3I2cWriteFifo(0, normal, -1) || esp32S3I2cReadFifo(0, normal, -1)) return 9
    0
}
