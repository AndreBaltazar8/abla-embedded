trusted fun c5SleepEfuseRead(offset: int): int { bad=true;return 0 }
trusted fun c5CpuClockRead(offset: int): int = if (offset == 0x144) 0 else regRead(1536,offset)
trusted fun c5CpuClockWrite(offset: int,value: int): void {
    if (cycleAborting() && nativeBufferAt(memory+304,304).loadU32(0) != 0 && nativeBufferAt(memory+304,304).loadU32(4) != 4) bad=true
    if (preFault == 3 && !cycleAborting() && !injected && offset == 0x118) { injected=true;return }
    if (preFault == 9 && cycleAborting() && !cleanupInjected && offset == 0x118) { cleanupInjected=true;return }
    if (cycleRecovering() && nativeBufferAt(memory+304,304).loadU32(4) != 4) bad=true
    if (cycleRecovering() && offset == 0x118 && fault == 2) { fault=0;return }
    if (offset != 0x144) regWrite(1536,offset,value)
    return
}
trusted fun c5CpuClockTicks(mhz: int): void {
    val restoring=cycleRecovering() || cycleAborting() && nativeBufferAt(memory+192,48).loadU32(4) == 1
    if (mhz != (if (restoring) expectedMHz else xtal)) bad=true
    if (cycleRecovering() && (pllDelay != 10 || pvtDelayed != 61 || (reg(0x60019028)&512) == 0)) bad=true
    clockReady=cycleRecovering();return
}
trusted fun c5ClockParkPvtActive(): bool = (reg(0x600960b8)&3) == 1 && (reg(0x600960bc)&0x400000) != 0 && (reg(0x60019064)&0x80000000) != 0 && (reg(0x600b0028)&0x4000) == 0
trusted fun c5ClockParkPvt(record: NativeBuffer): int = esp32C5PvtParkOwned(record,true)
// Real PLL/analog transport and PVT restart participate in the same lifecycle.
trusted fun c5ClockResumePll(record: NativeBuffer,limit: int): int = esp32C5PllStartOwned(record,true,limit)
trusted fun c5ClockResumePvt(record: NativeBuffer): int { restarting=true;return esp32C5PvtRestartOwned(record,true) }
trusted fun c5ClockResumeRead(address: int): int = if (address == 0x600b00ac) regRead(1024,0xac) else if (address == 0x600b0420) rcGate else c5PvtParkRead(address)
trusted fun c5ClockResumeWrite(address: int,value: int): void {
    if (address == 0x600b00ac) regWrite(1024,0xac,value)
    else if (address == 0x600b0420) rcGate=value
    else bad=true
    return
}
trusted fun c5ClockResumeDelay(us: int): void { if (us != 50 && us != 5) bad=true;return }
trusted fun c5RtcTimerRead(offset: int): int = regRead(2048,offset)
trusted fun c5RtcTimerWrite(offset: int,value: int): void {
    if ((preFault == 5 || preFault == 8) && !cycleAborting() && !injected && offset == 0) { injected=true;return }
    if (preFault == 8 && cycleAborting() && !cleanupInjected && offset == 4) { cleanupInjected=true;return }
    if (offset == 0x34) {
        if (cycleRecovering() && !clockReady) bad=true
        if (cycleRecovering() && fault == 3) { fault=0;return }
        regWrite(2048,0x28,regRead(2048,0x28)&~value)
    } else if (offset == 4) regWrite(2048,offset,value&0x7fffffff)
    else regWrite(2048,offset,value)
    return
}
trusted fun c5SleepUartRead(address: int): int {
    if (address == 0x60096000 || address == 0x6009600c) {
        if (preFault == 10 && cycleAborting() && !cleanupInjected && address == 0x60096000) { cleanupInjected=true;return 0 }
        if (cycleRecovering() && cacheResumes != 1) bad=true
        if (cycleRecovering() && fault == 4 && address == 0x60096000) { fault=0;return 0 }
        return 1
    }
    if (address == 0x60096004 || address == 0x60096010) return 0x400000
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset == 0x98 || offset == 0x70) return 0
    return regRead(2560,port*256+offset)
}
trusted fun c5SleepUartWrite(address: int,value: int): void {
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset != 0x98) regWrite(2560,port*256+offset,value)
    return
}
trusted fun c5CachePredictorDisable(): int = 0x1030
trusted fun c5CacheRomSuspend(): int { cacheSuspends=cacheSuspends+1;return 0x80000001 }
trusted fun c5SleepFlashReadyDelay(us: int): void { if (!clockReady || us != 700) bad=true;flashDelay=flashDelay+1;return }
trusted fun c5CacheRomResume(saved: int): void {
    if (!clockReady || nativeBufferAt(memory+608,24).loadU32(4) != 6 || saved != 0x80000001 || flashDelay != 0) bad=true
    cacheResumes=cacheResumes+1;return
}
trusted fun c5CachePredictorRestore(saved: int): void { if (cacheResumes != 1 || saved != 0x1030) bad=true;predictorRestores=predictorRestores+1;return }

import "../src/esp32/pll_start_c5_sequence.ab"
val pllBytes=nativeStaticAllocate(16)
var xtal=40
var gate=0
var selector=0
var conf=4
var route=0
var control=0
var pending=0
var writes=0
var failAt=0
var pllDelay=0
var power=0
var allowed=true
trusted fun c5PllRead(address: int): int {
    if (address == 0x60096110) return regRead(1536,0x110)
    if (address == 0x60096144) return 0
    if (address == 0x60096128) return regRead(1536,0x128)
    if (address == 0x600af018) return gate
    if (address == 0x600af820) return route
    if (address == 0x600af81c) return selector
    if (address == 0x600af818) {
        if ((gate&4) == 0 || (regRead(1536,0x128)&2) == 0) bad=true
        return conf|(if (allowed && power == 3) 0x1000000 else 0)
    }
    if (address == 0x600af800 || address == 0x600af804) {
        if ((gate&4) == 0 || (regRead(1536,0x128)&2) == 0 || address != (if (route == 0) 0x600af804 else 0x600af800)) bad=true
        if (pending > 0) { pending=pending-1;return control|0x2000000 }
        return control
    }
    bad=true;return 0
}
trusted fun c5PllWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (address == 0x600b00cc) {
        if (value == 0x70000000) power=power|1 else if (value == 0x02000000) power=power|2 else bad=true
    } else if (address == 0x60096128) regWrite(1536,0x128,value)
    else if (address == 0x600af018) gate=value
    else if (address == 0x600af81c) selector=value
    else if (address == 0x600af818) conf=value&0xffffff
    else if (address == 0x600af800 || address == 0x600af804) {
        if (pending != 0 || (value&255) != 0x66 || selector != 0xffff7f || (gate&4) == 0 || (regRead(1536,0x128)&2) == 0) bad=true
        val reg=(value>>8)&255
        if (reg > 15) { bad=true;return }
        val bytes=nativeBufferAt(pllBytes,16)
        if ((value&0x1000000) != 0) bytes.store(reg,(value>>16)&255)
        control=(value&65535)|(bytes.load(reg)<<16);pending=1
    } else bad=true
    return
}
trusted fun c5AnalogRead(address: int): int = c5PllRead(address)
trusted fun c5AnalogWrite(address: int,value: int): void { c5PllWrite(address,value);return }
trusted fun c5PllDelay(us: int): void { if (us != 10 || !allowed || (conf&8) == 0) bad=true;pllDelay=pllDelay+us;return }

import "../src/esp32/power/pvt_restart_c5_sequence.ab"
val pvtMemory=nativeStaticAllocate(256)
var pvtWrites=0
var pvtFailAt=0
var pvtDelayed=0
var restarting=false
var liveHp=23
var rawGap=0
trusted fun reg(address: int): int {
    if (address >= 0x60019000 && address < 0x60019100) return nativeBufferAt(pvtMemory,256).loadU32(address-0x60019000)
    if (address >= 0x60096000 && address < 0x60096200) return c5CpuClockRead(address-0x60096000)
    if (address >= 0x600b0000 && address < 0x600b0200) return regRead(1024,address-0x600b0000)
    bad=true;return 0
}
trusted fun put(address: int,value: int): void {
    if (address >= 0x60019000 && address < 0x60019100) nativeBufferAt(pvtMemory,256).storeU32(address-0x60019000,value)
    else if (address >= 0x60096000 && address < 0x60096200) regWrite(1536,address-0x60096000,value)
    else if (address >= 0x600b0000 && address < 0x600b0200) regWrite(1024,address-0x600b0000,value)
    else bad=true
    return
}
trusted fun c5PvtParkRead(address: int): int {
    if (address == 0x600b49d4) return 1
    if (address == 0x600b484c) return 0x200
    if (address == 0x600b4854) return rawGap<<1
    if (address >= 0x60019000 && address < 0x60019100 && (reg(0x600960b8)&1) == 0) bad=true
    if (address == 0x600190d8 || address == 0x600190dc || address == 0x600190e0) return reg(address)|2
    reg(address)
}
trusted fun c5PvtParkWrite(address: int,value: int): void {
    if ((regRead(1536,0x110)&0x30000) != 0) bad=true
    if (restarting) {
        if (pllDelay != 10 || (regRead(1536,0x128)&2) == 0) bad=true
        pvtWrites=pvtWrites+1
        if (pvtWrites == pvtFailAt) return
    }
    if ((address == 0x600190d8 || address == 0x600190dc || address == 0x600190e0) && (value&2) != 0) bad=true
    if (address == 0x600b0028 && (value&0x4000) == 0 && (reg(address)&0x4000) != 0 && pvtDelayed < 11) bad=true
    if (address == 0x60019028 && (value&512) != 0 && pvtDelayed < 61) bad=true
    if (address == 0x600960b8 && (value&2) != 0) {
        var i=0;while (i < 256) { nativeBufferAt(pvtMemory,256).storeU32(i,0);i=i+4 }
    }
    put(address,value);return
}
trusted fun c5PvtRestartDelay(us: int): void {
    if (us != 1 && us != 10 && us != 50) bad=true
    if (us == 1 && (reg(0x60019064)&0x80000000) != 0) bad=true
    if (us == 10 && (reg(0x600190d8)&1) == 0) bad=true
    if (us == 50 && ((reg(0x60019064)&0x80000000) == 0 || (reg(0x600b0028)&0x4008) != 0)) bad=true
    pvtDelayed=pvtDelayed+us;return
}
@export("abla_sleep_cycle_pll_pvt_c5_test")
trusted fun test(): int {
    val cycle=nativeBufferAt(memory,792);val request=nativeBufferAt(memory+792,68)
    var mode=0
    while (mode < 128) {
        var failure=0
        while (failure < 12) {
            var i=0;while (i < 3072) { nativeBufferAt(memory,3072).storeU32(i,0);i=i+4 }
            i=0;while (i < 256) { nativeBufferAt(pvtMemory,256).storeU32(i,0);i=i+4 }
            i=0;while (i < 16) { nativeBufferAt(pllBytes,16).store(i,0xa5);i=i+1 }
            val source=mode&3;xtal=if ((mode&4) == 0) 40 else 48
            liveHp=mode&31;rawGap=mode&31;route=if ((mode&8) == 0) 0 else 512
            expectedMHz=if (source == 0) xtal/2 else if (source == 1) 10 else if (source == 2) 80 else 120
            regWrite(1536,0x110,(xtal<<24)|(source<<16));regWrite(1536,0x118,1);regWrite(1536,0x11c,if (source == 3) 5 else if (source == 2) 3 else 1)
            regWrite(1536,0x128,0x80|2|(if (source == 3) 1 else 0))
            put(0x600960b8,1);put(0x600960bc,0x500001);put(0x60019064,0x80000000);put(0x60019028,512)
            regWrite(1024,0x28,(liveHp<<9)|(17<<4));regWrite(1024,0x5c,1<<27)
            regWrite(2048,4,0x42);regWrite(2048,0,0x12345678)
            gate=0x80;selector=0x13579b;conf=0x123404;control=0;pending=0;power=0;writes=0
            failAt=if (failure == 7) 8 else 0;pllDelay=0;allowed=false
            restarting=false;pvtWrites=0;pvtFailAt=if (failure == 8) 1 else if (failure == 9) 32 else 0;pvtDelayed=0
            timeHigh=u32(0);timeLow=u32(0);timeLoads=0;cacheSuspends=0;preFault=0
            bad=false;fault=if (failure <= 6) failure else 0;clockReady=false;cacheResumes=0;predictorRestores=0;flashDelay=0;rcGate=0
            val outcome=(mode>>>5)&3
            expectedResult=if (outcome == 0) 0 else if (outcome == 1) 1 else if (outcome == 2) -3 else -2
            requests=0;modeStore=1;efuseBusy=0
            val cal=esp32C5SleepCalibrationDecode(u32(0x210),u32(0xffffffff),u32(1))
            request.storeU32(4,0x1234);request.storeU32(8,cal|0);request.storeU32(12,3500000);request.storeU32(16,30000)
            request.storeU32(24,117);request.storeU32(28,if (failure == 10) liveHp else if (failure == 11) (liveHp+1)&31 else -1);request.storeU32(32,8)
            request.storeU32(36,3);request.storeU32(40,2);request.storeU32(44,16);request.storeU32(48,1);request.storeU32(52,16);request.storeU32(60,16)
            var result=esp32C5SleepCycleBeginOwned(cycle,request,true)
            if (result != 3 || bad || cacheResumes != 0 || pvtWrites != 0) return 1
            allowed=true;failAt=0
            var retries=0
            while (result == 3 && retries < 8) { result=esp32C5SleepCycleContinueOwned(cycle,true);retries=retries+1 }
            val issued=if (failure == 11 || expectedResult < 0) 0 else 1
            if (result != (if (failure == 11) 4 else 1) || bad || requests != issued || cacheResumes != (if (failure == 11) 0 else 1) ||
                pllDelay != 10 || pvtDelayed != 61 || timeLoads != (if (failure != 11 && expectedResult == 0) 1 else 0)) return 2
            if (regRead(1024,0x5c) != 1<<27 || (regRead(1024,0x28)&0x4000) != 0 || (reg(0x60019028)&512) == 0 ||
                cycle.loadU32(224) != liveHp || gate != 0x80 || selector != 0x13579b) return 3
            val prior=writes+pvtWrites
            if (esp32C5SleepCycleContinueOwned(cycle,true) != result || writes+pvtWrites != prior || requests != issued) return 4
            if (failure == 11 && (cycle.loadU32(16) != 2 || cycle.loadU32(20) != 2 || int(i32(cycle.loadU32(12))) != -4 || cacheSuspends != 0)) return 5
            if (failure != 11 && int(i32(cycle.loadU32(12))) != expectedResult) return 6
            failure=failure+1
        }
        mode=mode+1
    }
    return 0
}
