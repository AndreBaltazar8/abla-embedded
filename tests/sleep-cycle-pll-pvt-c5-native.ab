}
trusted fun regRead(bank: int,offset: int): int {
    if (offset < 0 || offset >= 512 || (offset&3) != 0) { bad=true;return 0 }
    nativeBufferAt(memory+bank,512).loadU32(offset)
}
trusted fun regWrite(bank: int,offset: int,value: int): void {
    if (offset < 0 || offset >= 512 || (offset&3) != 0) { bad=true;return }
    nativeBufferAt(memory+bank,512).storeU32(offset,value);return
}
trusted fun c5SleepPowerRead(offset: int): int = regRead(1024,offset)
trusted fun c5SleepPowerWrite(offset: int,value: int): void { regWrite(1024,offset,value);return }
trusted fun c5SleepDigitalRead(offset: int): int = regRead(1024,offset)
trusted fun c5SleepDigitalWrite(offset: int,value: int): void { regWrite(1024,offset,value);return }
trusted fun c5SleepAnalogRead(offset: int): int = regRead(1024,offset)
trusted fun c5SleepAnalogWrite(offset: int,value: int): void { regWrite(1024,offset,value);return }
trusted fun c5SleepTimingRead(offset: int): int = regRead(1024,offset)
trusted fun c5SleepTimingWrite(offset: int,value: int): void {
    if (preFault == 4 && !cycleAborting() && !injected && offset == 0x120) { injected=true;return }
    if (preFault == 7 && cycleAborting() && !cleanupInjected && offset == 0x120) { cleanupInjected=true;return }
    if (cycleRecovering() && fault == 1 && offset == 0x120) { fault=0;return }
    regWrite(1024,offset,value);return
