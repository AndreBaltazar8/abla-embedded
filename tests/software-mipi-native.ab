import "../src/display/software_lcd.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val baseBytes = nativeStaticBytes("\x11\x80\x05\xff\xff")
val extraBytes = nativeStaticBytes("\x29\x00\xff\xff")
var selected = false
var dataMode = true
var outputHigh = false
var bits = 0
var captured = 0
var activity = 0
var selections = 0
var bad = false
var shared = false
var driven = true
var delays = 0
trusted fun Pin.write(high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) dataMode = high
    if (this == 3) {
        if (shared && !driven) bad = true
        if (selected == !high || (!high && dataMode)) bad = true
        selected = !high
        if (selected) selections = selections + 1
    }
    if (this == 1 && selected && high) {
        if (dataMode != (bits / 8 == 3 || bits / 8 == 5)) bad = true
        captured = (captured << 1) | (if (outputHigh) 1 else 0)
        bits = bits + 1
    }
    return
}
fun Pin.read(): bool { bad = true; false }
trusted fun Pin.output(): void {
    if (!shared || this != 4 || driven || selected || dataMode || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    driven = true
    return
}
trusted fun Pin.input(): void {
    if (!shared || this != 4 || !driven || selected || !dataMode || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    driven = false
    return
}
fun peripheralDelayMicroseconds(duration: int): void { bad = true; return }
trusted fun peripheralDelayMilliseconds(duration: int): void {
    if (duration != 5 || selected || driven != !shared || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    delays = delays + 1
    return
}
@export("abla_software_mipi_native_test")
trusted fun softwareMipiNativeTest(): i32 {
    val gate = peripheralGateAt(gateStorage)
    val base = nativeBufferAt(baseBytes, 5)
    val extra = nativeBufferAt(extraBytes, 4)
    val geometry = lcdGeometry(135, 240, 52, 40, 240, 320)
    var variant = 0
    while (variant < 2) {
    shared = variant == 1
    driven = !shared
    bits = 0
    captured = 0
    selections = 0
    delays = 0
    val result = softwareLcd(Pin(1), Pin(2), Pin(3), Pin(4), shared).beginRgb565(gate, u32(7),
        geometry, 1, base, extra, true, true, 0)
    if (!result.valid() || bad || selected || bits != 56 || captured != 0x11293a55366c21 ||
        selections != 5 || delays != 1 || driven != !shared || nativeAddressLoadU32(gateStorage, 0) != 0) return i32(1)
    variant = variant + 1
    }
    activity = 0
    if (softwareLcdBeginRgb565(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        geometry, 1, base, nativeBufferAt(extraBytes, 3), true, true, 0).status() != 3 || activity != 0) return i32(2)
    if (softwareLcdBeginRgb565(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        geometry, 8, base, extra, true, true, 0).status() != 3 || activity != 0) return i32(3)
    if (gate.tryBegin(u32(9)) != 0) return i32(4)
    if (softwareLcdBeginRgb565(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        geometry, 1, base, extra, true, true, 0).status() != 2 || activity != 0) return i32(5)
    if (!gate.finish(u32(9), false)) return i32(6)
    if (softwareLcdBeginRgb565(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        geometry, 1, base, extra, true, true, 0).status() != 4 || activity != 0) return i32(7)
    i32(0)
}
