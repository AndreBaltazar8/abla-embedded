import "../src/m5stack/display_spi_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun hardwareLcdFacadeTarget(gateAddress: u32, source: u32, staging: u32, little: bool): int =
    m5BoardStackCoreS3.spiDisplay().blitRgb565(peripheralGateAt(int(gateAddress)), u32(41),
        lcdViewValue(320,240,0,0,8),0,0,nativeBufferAt(int(source),153600),320,240,640,
        little,nativeBufferAt(int(staging),64))
#exportFunction("hardwareLcdFacadeTarget", "abla_s3_hardware_lcd_facade_test")
