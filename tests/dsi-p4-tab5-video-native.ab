import "../src/m5stack/tab5_video_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var step=0
var fail=0
var busy=false
var bad=false
var reads=0
fun p4DsiClockRead(offset: int): u32 { reads=reads+1; return if (offset == 24) u32(4096) else if (busy) u32(128) else u32(0) }
fun p4DsiRead(offset: int): u32 { reads=reads+1; return u32(1) }
fun p4DsiBridgeRead(offset: int): u32 { reads=reads+1; return u32(0) }
fun p4DwDmaRead(offset: int): u32 { reads=reads+1; return if (offset == 16) u32(1) else u32(0) }
fun p4CacheSyncRead(offset: int): u32 { reads=reads+1; return u32(16) }
fun p4CacheSyncWrite(offset: int,value: u32): void { bad=true; return }
fun stage(expected: int): int { step=step+1; if (step != expected) bad=true; return if (fail == step) 5 else 1 }
fun p4Tab5VideoClock(plan: DpiClockPlan): int { if (plan.source() != 1 || plan.floorKhz() != 80000) bad=true; return stage(1) }
fun p4Tab5VideoTiming(panel: int,lane: int,dpi: int,polls: int): int {
    if (panel < 1 || panel > 3 || lane != 1000000 || dpi != 80000 || polls != 2) bad=true
    return stage(2)
}
fun p4Tab5VideoRgb(hw: int,vc: int,polls: int): int { if ((hw != 1 && hw != 3) || vc != 1 || polls != 2) bad=true; return stage(3) }
fun p4Tab5VideoDmaConfig(): int = stage(4)
fun p4Tab5VideoBridge(): int = stage(5)
trusted fun p4Tab5VideoPublish(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): int {
    if (channel != 2 || descriptor.addressValue() != 1341128704 || frame.addressValue() != 1207959552 || line != 128 || polls != 2) bad=true
    return stage(6)
}
fun p4Tab5VideoStart(channel: int): int { if (channel != 2) bad=true; return stage(7) }
fun resetVideoOpen(): void { step=0; fail=0; busy=false; bad=false; reads=0; return }
trusted fun openVideo(panel: int,hw: int): Tab5VideoStart = tab5VideoOpenOwned(panel,hw,1000000,1,2,nativeBufferAt(1341128704,64),nativeBufferAt(1207959552,1843200),128,2)
@export("abla_dsi_p4_tab5_video_test")
trusted fun testTab5Video(): i32 {
    var panel=1
    while (panel <= 3) {
        var hw=1
        while (hw <= 3) {
            resetVideoOpen()
            val result=openVideo(panel,hw)
            if (result.status() != 1 || !result.ownsDpiClock() || !result.ownsBridge() || !result.mayOwnDma() || step != 7 || bad) return i32(1)
            var fault=1
            while (fault <= 7) {
                resetVideoOpen(); fail=fault
                val failed=openVideo(panel,hw)
                if (failed.status() != fault+3 || failed.detail() != 5 || !failed.ownsDpiClock() ||
                    failed.ownsBridge() != (fault >= 5) || failed.mayOwnDma() != (fault >= 6) || step != fault || bad) return i32(2)
                fault=fault+1
            }
            resetVideoOpen(); busy=true
            if (openVideo(panel,hw).status() != 3 || step != 0) return i32(3)
            hw=hw+2
        }
        panel=panel+1
    }
    resetVideoOpen()
    if (openVideo(0,1).status() != 2 || openVideo(1,2).status() != 2 || reads != 0 || step != 0) return i32(4)
    return i32(0)
}
