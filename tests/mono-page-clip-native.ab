import "./mono-page-canvas-native.ab"
@export("abla_mono_page_clip_test")
trusted fun testClip(): i32 {
    if (test() != i32(0)) return i32(1)
    val frame=nativeBufferAt(memory+4,128);val expected=nativeBufferAt(memory+140,128);val source=nativeBufferAt(memory+272,128)
    var rotation=0
    while (rotation < 8) {
        val lw=if ((rotation&1) == 0) 9 else 17
        val lh=if ((rotation&1) == 0) 17 else 9
        var location=0
        while (location < 36) {
            val xi=location%6;val yi=location/6
            val x=if (xi == 0) -2147483648 else if (xi == 1) -3 else if (xi == 2) 0 else if (xi == 3) lw-3 else if (xi == 4) lw else 2147483647
            val y=if (yi == 0) -2147483648 else if (yi == 1) -2 else if (yi == 2) 0 else if (yi == 3) lh-3 else if (yi == 4) lh else 2147483647
            var variant=0
            while (variant < 5) {
                var at=0;while (at < 128) { frame.store(at,165);expected.store(at,165);source.store(at,(at*73+19)&255);at=at+1 }
                val fill=if (variant < 2) variant else -1
                val transparent=if (variant < 3) -1 else variant-3
                var row=0
                while (row < 9) {
                    var column=0
                    while (column < 11) {
                        val dx=x+column;val dy=y+row
                        if (dx >= 0 && dy >= 0 && dx < lw && dy < lh) {
                            val bit=if (fill >= 0) fill else (source.load(row*4+column/8)>>>(7-column%8))&1
                            if (bit != transparent && !monoPageDrawOwned(expected,9,17,dx,dy,1,1,rotation,NativeBuffer(0),0,bit,-1,true)) return i32(2)
                        }
                        column=column+1
                    }
                    row=row+1
                }
                if (!monoPageDrawClippedOwned(frame,9,17,x,y,11,9,rotation,source,4,fill,transparent,true)) return i32(3)
                at=0;while (at < 128) { if (frame.load(at) != expected.load(at)) return i32(4);at=at+1 }
                if (monoPageDrawClippedOwned(frame,9,17,x,y,11,9,rotation,frame,4,-1,-1,true) ||
                    monoPageDrawClippedOwned(frame,9,17,x,y,11,9,rotation,source,1,-1,-1,true)) return i32(5)
                at=0;while (at < 128) { if (frame.load(at) != expected.load(at)) return i32(6);at=at+1 }
                variant=variant+1
            }
            location=location+1
        }
        rotation=rotation+1
    }
    return i32(0)
}
