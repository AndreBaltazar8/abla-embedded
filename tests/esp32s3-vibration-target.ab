import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/vibration.ab"
import "abla/runtime/scalar"
import "abla/build"
// Code-generation check only: Core2's physical CPU is ESP32, not S3.
@export("abla_vibration_target")
trusted fun vibrationTarget(power: M5AxpPower,expander: M5Ioe1,board: M5BoardId,level: int): int {
    if (board == m5BoardStopWatch) return expander.setVibration(board,level).status()
    power.setVibration(board,level).status()
}
