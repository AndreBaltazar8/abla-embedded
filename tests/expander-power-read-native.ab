import "../src/m5stack/expander_power_read.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }
trusted fun I2cDevice.readRegister(register: int,bytes: NativeBuffer,count: int): bool { bad=true; return false }
trusted fun I2cDevice.writeRegister(register: int,bytes: NativeBuffer,count: int): bool { bad=true; return false }
var calls=0
var expectedHandle=0
var expectedPin=0
var expectedM5=false
var response=0
var bad=false
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    calls=calls+1
    // All mapped pins are in the first bank. Both real drivers must read
    // output latch5, never their distinct input sampling registers7/15.
    if (this != expectedHandle || register != 5) bad=true
    if (response == 0) return I2cByteResult(0)
    val bit=1<<expectedPin
    I2cByteResult(256 | (if (response == 257) bit else 255-bit))
}
@export("abla_expander_power_read_test")
fun readTest(): i32 {
    var model=0
    while (model < 6) {
        val board=if (model == 0) m5BoardTab5 else if (model == 1) m5BoardTab5X else
            if (model == 2) m5BoardCoreP4X else if (model == 3) m5BoardCoreMatrix else
            if (model == 4) m5BoardArduinoNessoN1 else m5BoardAtomVoice
        var port=-1
        while (port <= 512) {
            val supported=(port == 1 && model < 5) || (port == 32 && model < 3) || (port == 256 && model == 1)
            expectedHandle=if (model == 4 || (model < 2 && port == 32)) 8 else 7
            expectedPin=if (port == 256) 3 else if (port == 32) (if (model < 2) 3 else 1) else if (model == 2 || model == 3) 4 else 2
            expectedM5=model == 2 || model == 3
            var outcome=0
            while (outcome < 3) {
                response=if (outcome == 0) 0 else if (outcome == 1) 256 else 257
                calls=0; bad=false
                val result=board.expanderPowerEnabledCheckedOwned(7,8,port)
                if (result != I2cByteResult(if (supported) response else 0) || calls != (if (supported) 1 else 0) || bad) return i32(1)
                outcome=outcome+1
            }
            port=port+1
        }
        model=model+1
    }
    calls=0
    if (m5BoardTab5.expanderPowerEnabledCheckedOwned(0,8,1).valid() ||
        m5BoardTab5.expanderPowerEnabledCheckedOwned(7,-1,32).valid() ||
        m5BoardCoreP4X.expanderPowerEnabledCheckedOwned(4294967296,8,1).valid() || calls != 0) return i32(2)
    expectedHandle=8; expectedPin=3; expectedM5=false; response=257; bad=false
    if (m5BoardTab5.expanderPowerEnabledCheckedOwned(0,8,32) != I2cByteResult(257) || bad) return i32(3)
    i32(0)
}
