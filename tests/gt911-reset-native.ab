import "../src/touch/gt911_reset_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var step=0
var bad=false
var address=20
fun gt911ResetPadValid(number: int,interrupt: bool): bool = number >= 0 && number < 40
fun gt911ResetDrive(number: int,high: bool): void {
    if ((step == 0 && (number != 3 || high)) ||
        (step == 2 && (number != 4 || high != (address == 20))) ||
        (step == 4 && (number != 3 || !high)) ||
        (step == 6 && (number != 4 || high)) || (step != 0 && step != 2 && step != 4 && step != 6)) bad=true
    step=step+1
    return
}
fun gt911ResetDelayUs(duration: int): void {
    val expected=if (step == 1) 20000 else if (step == 3) 200 else if (step == 5) 6000 else if (step == 7) 50000 else -1
    if (duration != expected) bad=true
    step=step+1
    return
}
fun gt911ResetInput(number: int): void {
    if (step != 8 || number != 4) bad=true
    step=step+1
    return
}
@export("abla_gt911_reset_test")
fun resetTest(): i32 {
    var index=0
    while (index < 2) {
        address=if (index == 0) 20 else 93
        step=0
        if (!gt911ResetAddressOwned(3,4,address) || step != 9 || bad) return i32(1)
        index=index+1
    }
    step=0
    if (gt911ResetAddressOwned(3,3,20) || gt911ResetAddressOwned(-1,4,20) ||
        gt911ResetAddressOwned(3,40,20) || gt911ResetAddressOwned(3,4,56) || step != 0) return i32(2)
    i32(0)
}
