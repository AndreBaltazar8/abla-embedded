import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/cores3_display_hardware_init.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_cores3_hardware_init_test")
trusted fun cores3InitTarget(pmic: u32, expander: u32, touch: u32, gate: u32, external5v: bool): int =
    m5BoardStackCoreS3.initializeCoreS3HardwareDisplay(Axp2101(int(pmic)), Aw9523(int(expander)),
        Ft5x06(int(touch)), peripheralGateAt(int(gate)), u32(7), external5v, 100).status()
