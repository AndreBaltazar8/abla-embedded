import "../src/esp32/gpio/lp_clock_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var parent=0
var child=0
var mux=1
var reset=0
var fault=0
var reads=0
var writes=0
var bad=false
trusted fun c5LpGpioClockLoad(address: int): int {
    reads=reads+1
    if (address == 0x600960F0) return mux
    if (address == 0x600B2804) return reset
    if (address == 0x600B2800) return parent
    if (address == 0x600B47F8) {
        if ((parent&0x08000000) == 0) bad=true
        return child
    }
    bad=true
    0
}
trusted fun c5LpGpioClockStore(address: int,value: int): void {
    writes=writes+1
    if (address == 0x600B2800) {
        if ((value&~0x08000000) != (parent&~0x08000000)) bad=true
        if ((value&0x08000000) == 0 && (child&1) != 0) bad=true
        if (fault != 1) parent=value
    } else if (address == 0x600B47F8) {
        if ((parent&0x08000000) == 0 || (value&~1) != (child&~1)) bad=true
        if (fault != 2) child=value
    } else bad=true
    return
}
@export("abla_c5_lp_gpio_clock_test")
trusted fun clockTest(): i32 {
    var profile=0
    while (profile < 4096) {
        val seed=int(u32(profile)*u32(2654435761))
        parent=(seed&~0x08000000)|(if (profile%2 == 0) 0 else 0x08000000)
        child=(seed&~1)|(profile/2%2)
        val oldParent=parent; val oldChild=child
        fault=profile/4%3; mux=profile/12%2
        reads=0; writes=0; bad=false
        val expected=mux == 1 && (fault != 1 || (oldParent&0x08000000) != 0) &&
            (fault != 2 || (oldChild&1) != 0)
        if (esp32C5LpGpioEnableClocksOwned(3) != expected || bad || reads > 9 || writes > 2) return i32(1)
        if ((parent&~0x08000000) != (oldParent&~0x08000000) || (child&~1) != (oldChild&~1)) return i32(2)
        if (mux == 0 && (writes != 0 || reads != 1)) return i32(3)
        val beforeParent=parent; val beforeChild=child
        reads=0; writes=0; bad=false
        val disabled=(beforeParent&0x08000000) == 0 ||
            (fault != 1 && (fault != 2 || (beforeChild&1) == 0))
        if (esp32C5LpGpioDisableClocksOwned(3) != disabled || bad || reads > 9 || writes > 2) return i32(4)
        fault=0; mux=1
        if (!esp32C5LpGpioEnableClocksOwned(3) || !esp32C5LpGpioEnableClocksOwned(3) ||
            !esp32C5LpGpioDisableClocksOwned(3) || !esp32C5LpGpioDisableClocksOwned(3) || bad) return i32(5)
        profile=profile+1
    }
    reads=0; writes=0; mux=3
    if (esp32C5LpGpioEnableClocksOwned(3) || reads != 1 || writes != 0) return i32(7)
    reads=0; mux=1; reset=0x08000000
    if (esp32C5LpGpioEnableClocksOwned(3) || reads != 2 || writes != 0) return i32(8)
    reads=0; writes=0
    if (esp32C5LpGpioEnableClocksOwned(0) || esp32C5LpGpioDisableClocksOwned(65536) || reads != 0 || writes != 0) return i32(6)
    i32(0)
}
