import "../src/esp32/i2c/lp_stream_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_lp_i2c_stream_target")
trusted fun streamTarget(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int =
    esp32C5LpI2cTransferOwned(port,address,output,written,input,read,budget,prefix)
