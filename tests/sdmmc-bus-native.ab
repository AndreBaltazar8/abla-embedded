import "../src/sd/mmc_bus_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var clock=0
var reset=0
var writes=0
var failure=0
var hostReads=0
var busy=false
trusted fun sdMmcS3SystemRead(address: int): int = if (address == 0x600c001c) clock else reset
trusted fun sdMmcS3SystemWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == failure) return
    if (address == 0x600c001c) clock=value else reset=value
    return
}
trusted fun sdMmcS3Read(offset: int): int { hostReads=hostReads+1; return if (busy && offset == 16) 1 else 0 }
@export("abla_sdmmc_bus_test")
trusted fun test(): i32 {
    var original=0
    while (original < 4) {
        val oldClock=0x12340000|((original&1)<<7)
        val oldReset=0x23450000|(((original>>1)&1)<<7)
        clock=oldClock; reset=oldReset; writes=0
        val denied=sdMmcBusOpenOwned(false)
        if (denied.status() != (if (original == 1) 1 else 2) || writes != 0) return i32(1)
        val lease=sdMmcBusOpenOwned(true)
        if (lease.status() != 1 || clock != (oldClock|128) || reset != (oldReset&~128)) return i32(2)
        if (lease.closeOwned(true).status() != 0 || clock != oldClock || reset != oldReset) return i32(3)
        original=original+1
    }
    var failed=1
    while (failed <= 4) {
        clock=0; reset=128; writes=0; failure=failed; hostReads=0
        var lease=sdMmcBusOpenOwned(true)
        if (failed <= 2 && lease.status() != 3) return i32(4)
        lease=lease.closeOwned(true)
        if (failed >= 3 && lease.status() != 3) return i32(5)
        failure=0
        lease=lease.closeOwned(true)
        if (lease.status() != 0 || clock != 0 || reset != 128) return i32(6)
        failed=failed+1
    }
    clock=0; reset=128; writes=0; failure=0
    var lease=sdMmcBusOpenOwned(true)
    busy=true
    if (lease.closeOwned(true).status() != 4 || lease.closeOwned(false).status() != 4 || clock != 128 || reset != 0) return i32(7)
    busy=false
    if (lease.closeOwned(true).status() != 0) return i32(8)
    clock=128; reset=0; writes=0
    lease=sdMmcBusOpenOwned(false); clock=0
    if (lease.closeOwned(true).status() != 6 || writes != 0 || SdMmcBus(1).closeOwned(true).status() != 5) return i32(9)
    return i32(0)
}
