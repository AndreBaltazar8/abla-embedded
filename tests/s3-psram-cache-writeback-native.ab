import "../src/esp32/psram/cache_disable_s3_sequence.ab"
import "abla/build"
var cwSize=0
var cwControl=0
var cwWrites=0
var cwPolls=0
var cwDelay=0
var cwBad=false
fun s3PsramCacheMappingRead(address: int): int {
    if (address == 0x600c4030 && cwWrites == 1) return cwSize
    if (address == 0x600c4028) {
        if (cwWrites == 2) return cwControl
        if (cwWrites == 3) {
            cwPolls=cwPolls+1
            return cwControl|(if (cwPolls > cwDelay) 8 else 0)
        }
    }
    cwBad=true;return 0xffffffff
}
fun s3PsramCacheMappingWrite(address: int,value: int): void {
    if (cwWrites == 0) { if (address != 0x600c402c || value != 0) cwBad=true }
    else if (cwWrites == 1) {
        if (address != 0x600c4030 || value != (cwSize&0xff800000)) cwBad=true
        cwSize=value
    } else if (cwWrites == 2) {
        if (address != 0x600c4028 || value != (cwControl|2)) cwBad=true
        cwControl=value
    } else cwBad=true
    cwWrites=cwWrites+1;return
}
@export("abla_s3_psram_cache_writeback_test")
fun testWriteback(): int {
    var profile=0
    while (profile < 256) {
        cwDelay=0
        while (cwDelay < 8) {
            val before=(profile*16777217)^0xa55a5aa5
            cwSize=before;cwControl=before&0xfffffff7
            cwWrites=0;cwPolls=0;cwBad=false
            s3PsramCacheWritebackNativeOwned()
            if (cwBad || cwWrites != 3 || cwPolls != cwDelay+1 || cwSize != (before&0xff800000) || cwControl != ((before&0xfffffff7)|2)) return 1
            cwDelay=cwDelay+1
        }
        profile=profile+1
    }
    return 0
}
