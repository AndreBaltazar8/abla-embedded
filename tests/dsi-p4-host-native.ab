import "../src/esp32/dsi_host_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var pattern=u32(0)
var rate=80000
var channel=0
var force=false
var mode=0
var writes=0
var reads=0
var bad=false
fun p4DsiRead(offset: int): u32 {
    reads=reads+1
    if (offset == 116) return u32(if (mode == 1) 85 else if (mode == 2) 5 else 21)
    if (offset == 188) return u32(if (mode == 3) 1 else 0)
    if (offset == 192) return u32(0)
    pattern
}
fun p4DsiWrite(offset: int,value: u32): void {
    val expectedOffset=if (writes == 0) 52 else if (writes == 1) 148 else if (writes == 2) 156 else if (writes == 3) 152 else if (writes == 4) 44 else if (writes == 5) 8 else if (writes < 12) 120+(writes-6)*4 else if (writes == 12) 244 else if (writes == 13) 164 else if (writes == 14) 48 else 104
    var expected=pattern
    if (offset == 52) expected=pattern|u32(1)
    else if (offset == 148) expected=(pattern&u32(4294967292))|u32(if (force) 1 else 3)
    else if (offset == 156 || offset == 152) {
        expected=(pattern&u32(4227922944))|u32(if (offset == 156) 3276904 else 3014784)
    } else if (offset == 44) expected=(pattern&u32(4294967263))|u32(29)
    else if (offset == 8) {
        var escape=2
        while (rate > escape*144000) escape=escape+1
        val timeout=(rate/40000+1)/2
        expected=(pattern&u32(4294901760))|u32(timeout*256+escape)
    } else if (offset == 120) expected=u32(0)
    else if (offset >= 124 && offset <= 140) expected=pattern&u32(4294901760)
    else if (offset == 244) expected=(pattern&u32(4294934528))|u32(6000)
    else if (offset == 164) expected=(pattern&u32(4294902015))|u32(16128)
    else if (offset == 48) expected=(pattern&u32(4294967292))|u32(channel)
    else if (offset == 104) expected=(pattern&u32(4294967292))|u32(17792768)
    if (offset != expectedOffset || value != expected || writes >= 16) bad=true
    writes=writes+1
    return
}
@export("abla_dsi_p4_host_test")
trusted fun testHost(): i32 {
    var profile=0
    while (profile < 16) {
        pattern=if ((profile&1) == 0) u32(0) else u32(4294967295)
        force=(profile&2) != 0; channel=profile/4
        rate=80000
        while (rate <= 1500000) {
            writes=0
            val result=esp32P4DsiConfigureCommandHostOwned(rate,channel,force,3)
            if (!result.hostComplete() || result.enqueued() || writes != 16 || bad) return i32(1)
            rate=rate+1000
        }
        profile=profile+1
    }
    mode=1
    while (mode <= 3) {
        writes=0
        val result=esp32P4DsiConfigureCommandHostOwned(900000,0,false,3)
        if (result.status() != (if (mode == 1) 3 else if (mode == 2) 9 else 4) || writes != 0) return i32(2)
        mode=mode+1
    }
    reads=0; writes=0
    if (esp32P4DsiConfigureCommandHostOwned(79999,0,false,3).status() != 2 ||
        esp32P4DsiConfigureCommandHostOwned(1500001,0,false,3).status() != 2 ||
        esp32P4DsiConfigureCommandHostOwned(900000,4,false,3).status() != 2 ||
        esp32P4DsiConfigureCommandHostOwned(900000,0,false,0).status() != 2 || reads != 0 || writes != 0) return i32(3)
    i32(0)
}
