import "../src/esp32/radio/tx_esp32_logic.ab"

fun main(): int {
    if (esp32WifiDmaDescriptorAddressValid(1072693248) ||
        !esp32WifiDmaDescriptorAddressValid(1072693252) ||
        !esp32WifiDmaDescriptorAddressValid(1073741812) ||
        esp32WifiDmaDescriptorAddressValid(1072693249) ||
        esp32WifiDmaDescriptorAddressValid(1073741816)) return 1
    if (esp32WifiTxFrameLength(0) != 4 ||
        esp32WifiTxFrameLength(4091) != 4095 ||
        esp32WifiTxFrameLength(-1) != -1 ||
        esp32WifiTxFrameLength(4092) != -1) return 2
    val voice = wifiMacVoiceQueue()
    if (esp32WifiTxOutcome(0, 0, voice).rawValue() !=
        wifiTxPending().rawValue()) return 3
    if (esp32WifiTxOutcome(1, 0, voice).rawValue() !=
        wifiTxComplete().rawValue()) return 4
    if (esp32WifiTxOutcome(0, 65536, voice).rawValue() !=
        wifiTxTimeout().rawValue()) return 5
    if (esp32WifiTxOutcome(0, 1, voice).rawValue() !=
        wifiTxCollision().rawValue()) return 6
    if (esp32WifiTxOutcome(1, 1, voice).rawValue() !=
        wifiTxConflicting().rawValue()) return 7
    if (esp32WifiTxOutcome(0, 0, WifiMacTxQueue(5)).rawValue() !=
        wifiTxInvalid().rawValue()) return 8
    if (!wifiTxComplete().terminal() || !wifiTxTimeout().terminal() ||
        !wifiTxCollision().terminal() || !wifiTxConflicting().terminal() ||
        wifiTxPending().terminal() || wifiTxInvalid().terminal()) return 9
    75
}
