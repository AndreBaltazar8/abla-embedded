// Tests for tools/lib/toml.ab, the reader of the tools/recovery/*.toml profiles. The expected
// dump is what Python's tomllib reads from the same text (keys flattened to dotted paths, an
// array of tables as `path[N].key`).

import "abla/io"
import "abla/text"
import "../tools/lib/toml.ab"

val FIXTURE = """
# comment line
chip = "esp32s3"   # trailing comment
path = '~/literal\no\escape'
escaped = "tab\there \"quoted\" \\ back \u00e9 \U0001F600"
hex = 0xFF_ff
neg = -42
plus = +7
under = 1_000
flag = true
off = false
empty = []
list = ["a", "b", "c#not-a-comment",]
multi = [
    "one",   # first
    "two",
    3,
    true,
]
"quoted key" = "v"
dotted.key.here = "x"
a . b = "spaced dots"

[archives]
libpp = "components/lib/libpp.a"
"lib-with-dash" = "x"

[features.sta]
description = "station only"

[[features.sta.rewrite]]
function = "f1"
null_addresses = [
    "a",
    "b",
]

[[features.sta.rewrite]]
function = "f2"
skip_calls = ["c"]

[[other]]
n = 1
[[other]]
n = 2

[table.sub]
x = "y"

"""

val EXPECTED = """
a.b|s|spaced dots
archives.lib-with-dash|s|x
archives.libpp|s|components/lib/libpp.a
chip|s|esp32s3
dotted.key.here|s|x
empty|a|
escaped|s|tab	here "quoted" \ back é 😀
features.sta.description|s|station only
features.sta.rewrite[0].function|s|f1
features.sta.rewrite[0].null_addresses|a|a,b
features.sta.rewrite[1].function|s|f2
features.sta.rewrite[1].skip_calls|a|c
flag|b|true
hex|i|65535
list|a|a,b,c#not-a-comment
multi|a|one,two,3,true
neg|i|-42
off|b|false
other[0].n|i|1
other[1].n|i|2
path|s|~/literal\no\escape
plus|i|7
quoted key|s|v
table.sub.x|s|y
under|i|1000
"""

var failures = 0

fun dump(doc: TomlDoc): string {
    val lines: array<string> = []
    for (key in doc.keys) {
        val value = doc.values.get(key)
        if (value == null) continue
        if (value.kind == TOML_STRING) lines.append("$key|s|${value.text}")
        else if (value.kind == TOML_INT) lines.append("$key|i|${value.number}")
        else if (value.kind == TOML_BOOL) lines.append("$key|b|${value.text}")
        else lines.append("$key|a|${value.items.join(",")}")
    }
    sortedStrings(lines).join("\n")
}

fun expectError(label: string, text: string): void {
    if (tomlParse(text).error == "") {
        println("FAIL $label: accepted")
        failures = failures + 1
    }
    return
}

fun main: int {
    val doc = tomlParse(FIXTURE)
    if (doc.error != "") {
        println("FAIL fixture: ${doc.error}")
        return 1
    }
    val actual = dump(doc)
    if (actual != EXPECTED) {
        println("FAIL dump: expected")
        println(EXPECTED)
        println("got")
        println(actual)
        failures = failures + 1
    }
    if (doc.tableCount("features.sta.rewrite") != 2 || doc.tableCount("other") != 2 || doc.tableCount("archives") != 1 ||
        doc.tableCount("absent") != 0) {
        println("FAIL table counts")
        failures = failures + 1
    }
    val children = doc.childKeys("archives").join(",")
    if (children != "libpp,lib-with-dash") {
        println("FAIL child keys: $children")
        failures = failures + 1
    }
    if (doc.string("chip") != "esp32s3" || !doc.bool("flag") || doc.bool("off") || doc.int("hex") != 65535 ||
        doc.strings("list").size != 3 || doc.string("missing", "fallback") != "fallback") {
        println("FAIL accessors")
        failures = failures + 1
    }
    expectError("inline table", "a = { b = 1 }")
    expectError("duplicate key", "a = 1\na = 2")
    expectError("unterminated string", "a = \"open")
    expectError("bad header", "[a")
    expectError("missing value", "a =")
    expectError("junk after value", "a = 1 2")
    expectError("unterminated array", "a = [1, 2")
    expectError("nested array", "a = [[1]]")
    if (failures != 0) return 1
    println("PASS: the recovery profile reader matches tomllib on the fixture")
    0
}
