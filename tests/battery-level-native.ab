import "../src/power/battery_level.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_battery_level_test")
fun batteryTest(): i32 {
    var value=0
    while (value <= 65535) {
        val raw=I2cWordResult(65536|value)
        val level=batteryLevelFromMillivolts(raw)
        val expected=if (value < 3300) 0 else if (value > 4100) 100 else (value-3300)*100/800
        if (!level.valid() || level.value() != expected || batteryLevelFromMillivolts(I2cWordResult(value)).valid()) return i32(1)
        val axp=axp192PowerBatteryLevel(raw)
        val scaled=if (value*11 < 33000) 0 else if (value*11 > 41000) 100 else (value*11-33000)*100/8000
        if (axp.valid() != (value <= 4095) || (axp.valid() && axp.value() != scaled)) return i32(2)
        value=value+1
    }
    value=0
    while (value < 256) {
        val raw=I2cByteResult(256|value)
        val axp=axp2101BatteryLevelChecked(raw)
        val ip=ip5306BatteryLevelChecked(raw)
        val nibble=value>>>4
        val expected=if (nibble == 0) 100 else if (nibble == 8) 75 else if (nibble == 12) 50 else if (nibble == 14) 25 else 0
        if (axp.valid() != (value <= 100) || (axp.valid() && axp.value() != value) || !ip.valid() || ip.value() != expected ||
            axp2101BatteryLevelChecked(I2cByteResult(value)).valid() || ip5306BatteryLevelChecked(I2cByteResult(value)).valid()) return i32(3)
        value=value+1
    }
    i32(0)
}
