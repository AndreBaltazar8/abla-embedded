import "../src/m5stack/tab5_psram_video_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(88)
val ownerStorage=nativeStaticAllocate(40)
val descriptorStorage=nativeStaticAllocate(64)
val gateStorage=nativeStaticAllocate(4)
type Tab5DsiOwner = int
var ready=true
var calls=0
var startResult=1
var stopResult=32769
var bad=false
fun Tab5DsiOwner.buffer(): NativeBuffer = nativeBufferAt(this|0,40)
fun Tab5DsiOwner.panelReady(): bool = ready
fun Tab5DsiOwner.videoBufferSafe(buffer: NativeBuffer,bytes: int): bool = buffer.addressValue()+bytes <= (this|0) || buffer.addressValue() >= (this|0)+40
fun p4PsramMemoryStorage(memory: NativeBuffer): bool = memory.addressValue() == storage && memory.hasAddressRange(0,88)
fun tab5OwnedVideoBuffersValid(descriptor: NativeBuffer,frame: NativeBuffer,line: int): bool = descriptor.hasAddressRange(0,64) && frame.hasAddressRange(0,1843200) && line == 128
fun Tab5DsiOwner.startVideoOwned(channel: int,descriptor: NativeBuffer,frame: NativeBuffer,line: int,polls: int): int {
    calls=calls+1
    if (nativeBufferAt(storage,88).loadU32(4) != 8 || nativeBufferAt(storage,88).loadU32(20) != (this|0) || frame.addressValue() != 0x48000000) bad=true
    if (startResult != 2) ready=false
    return startResult
}
fun Tab5DsiOwner.stopVideoOwned(gate: int,polls: int): int { calls=calls+1; return stopResult }
fun resetPsramVideo(memory: NativeBuffer): void {
    memory.storeU32(0,0x50344d45); memory.storeU32(4,4); memory.storeU32(8,0x48000000); memory.storeU32(12,1900544); memory.storeU32(16,128); memory.storeU32(20,0)
    ready=true; calls=0; startResult=1; stopResult=32769; bad=false; return
}
@export("abla_tab5_psram_video_test")
fun psramVideoTest(): i32 {
    val memory=nativeBufferAt(storage,88); val owner=Tab5DsiOwner(ownerStorage); val descriptor=nativeBufferAt(descriptorStorage,64)
    resetPsramVideo(memory)
    if (owner.startPsramVideoOwned(memory,0,descriptor,2) != 1 || memory.loadU32(4) != 8 || bad) return i32(1)
    if (owner.startPsramVideoOwned(memory,0,descriptor,2) != 2 || calls != 1) return i32(2)
    stopResult=1
    if (owner.stopPsramVideoOwned(memory,gateStorage,2) != 1 || memory.loadU32(4) != 8) return i32(3)
    stopResult=32769
    if (owner.stopPsramVideoOwned(memory,gateStorage,2) != 32769 || memory.loadU32(4) != 4 || memory.loadU32(20) != 0) return i32(4)
    resetPsramVideo(memory); startResult=10
    if (owner.startPsramVideoOwned(memory,0,descriptor,2) != 10 || memory.loadU32(4) != 8) return i32(5)
    if (Tab5DsiOwner(ownerStorage+4).stopPsramVideoOwned(memory,gateStorage,2) != 2 || calls != 1) return i32(6)
    if (owner.stopPsramVideoOwned(memory,storage+4,2) != 2 || calls != 1) return i32(7)
    if (owner.stopPsramVideoOwned(memory,gateStorage,2) != 32769 || memory.loadU32(4) != 4) return i32(8)
    resetPsramVideo(memory); startResult=2
    if (owner.startPsramVideoOwned(memory,0,descriptor,2) != 2 || memory.loadU32(4) != 4) return i32(9)
    resetPsramVideo(memory); memory.storeU32(12,65536)
    if (owner.startPsramVideoOwned(memory,0,descriptor,2) != 2 || calls != 0) return i32(10)
    resetPsramVideo(memory)
    if (owner.startPsramVideoOwned(memory,0,nativeBufferAt(storage,64),2) != 2 || calls != 0) return i32(11)
    return i32(0)
}
