import "../src/esp32/power/retention_graph_p4.ab"
import "./p4-retention-profile-checks.ab"
val graphEntries=nativeStaticAllocate(20)
val graphReference=nativeStaticAllocate(2000)
trusted fun retentionGraphChecks(): int {
    val configs=nativeBufferAt(profileConfigs,76*56+4)
    val backing=nativeBufferAt(profileBacking,6000)
    val scratch=nativeBufferAt(profileScratch,56)
    val out=nativeBufferAt(profileOutput,2000)
    val reference=nativeBufferAt(graphReference,2000)
    val entries=nativeBufferAt(graphEntries,20)
    var uart=-1
    while (uart < 5) {
        var flags=0
        while (flags < 4) {
            val psram=(flags&1) != 0;val pvt=(flags&2) != 0
            val count=esp32p4RetentionProfileConfigs(configs,backing,scratch,uart,psram,pvt)
            if (count == 0) return 90
            val linear=esp32p4RetentionListEncode(reference,configs,scratch,count)
            var revisionCase=0
            while (revisionCase < 3) {
                val rev=if (revisionCase == 0) 0 else if (revisionCase == 1) 300 else 301
                val expected=linear+(if (rev == 300) 32 else 0)
                out.storeU32(expected,0x12345678);entries.storeU32(16,0x12345678)
                if (esp32p4RetentionGraphEncode(out,entries,configs,scratch,uart,psram,pvt,rev) != expected ||
                    out.loadU32(expected) != 0x12345678 || entries.loadU32(16) != 0x12345678 ||
                    entries.loadU32(0) != profileOutput || entries.loadU32(4) != 0 || entries.loadU32(8) != 0 ||
                    (rev != 300 && entries.loadU32(12) != 0)) return 91
                // Follow entry0 as hardware does and compare every node body
                // to independently encoded linear output, including poison
                // WAIT pairs. Bound traversal to catch cycles/bad termination.
                var cursor=entries.loadU32(0)
                var source=0
                var visited=0
                var branches=0
                while (cursor != 0 && visited < 100) {
                    val offset=cursor-profileOutput
                    if (offset < 0 || offset+20 > expected || source >= linear) return 92
                    val head=out.loadU32(offset);val old=reference.loadU32(source)
                    val branch=(head&0x10000000) != 0
                    if ((head&0xefffffff) != old) return 93
                    val body=if (branch) 20 else 8
                    val size=p4RetentionDescriptorBytes(old)
                    var word=8
                    while (word < size) { if (out.loadU32(offset+body+word-8) != reference.loadU32(source+word)) return 94;word=word+4 }
                    if (branch) {
                        branches=branches+1
                        if (out.loadU32(offset+8) != 0 || out.loadU32(offset+12) != 0 || out.loadU32(offset+16) != profileOutput+linear+12 || out.loadU32(offset+20) != 0x5008c180) return 95
                    }
                    cursor=if ((head&0x80000000) != 0) 0 else out.loadU32(offset+4)
                    source=source+size;visited=visited+1
                }
                if (cursor != 0 || source != linear || branches != (if (rev == 300) 1 else 0)) return 96
                if (rev == 300) {
                    cursor=entries.loadU32(12)
                    var n=0
                    while (n < 8) {
                        val offset=cursor-profileOutput
                        if (offset < 0 || offset+20 > expected) return 97
                        val head=out.loadU32(offset);val body=if (n == 7) 20 else 8
                        if (((head&0x10000000) != 0) != (n == 7) || out.loadU32(offset+body) != esp32p4RetentionMspiAddress(false,n)) return 98
                        cursor=out.loadU32(offset+(if (n == 7) 16 else 4));n=n+1
                    }
                    if (cursor != profileOutput+linear+12 || out.loadU32(linear+12) != 0xe0030000 ||
                        out.loadU32(linear+16) != 0 || out.loadU32(linear+20) != 0 || out.loadU32(linear+24) != 0 || out.loadU32(linear+28) != 0) return 99
                }
                revisionCase=revisionCase+1
            }
            flags=flags+1
        }
        uart=uart+1
    }
    var fault=0
    while (fault < 9) {
        if (esp32p4RetentionProfileConfigs(configs,backing,scratch,0,true,true) != 76) return 100
        var word=0
        while (word < 2000) { out.storeU32(word,0x12345678);word=word+4 }
        word=0
        while (word < 20) { entries.storeU32(word,0x12345678);word=word+4 }
        word=0
        while (word < 56) { scratch.storeU32(word,0xabcdef12);word=word+4 }
        if (fault == 0) configs.storeU32(75*56+20,0x50000000)
        if (fault == 1) configs.storeU32(75*56+4,profileOutput)
        if (fault == 2) configs.storeU32(75*56+28,profileOutput+1900)
        if (fault == 3) configs.storeU32(75*56+28,graphEntries)
        if (fault == 4) configs.storeU32(75*56+28,profileConfigs)
        if (fault == 7) configs.storeU32(75*56+28,profileScratch)
        if (esp32p4RetentionGraphEncode(if (fault == 5) nativeBufferAt(profileOutput,1911) else out,
            if (fault == 8) nativeBufferAt(profileOutput+1900,16) else entries,configs,scratch,0,true,true,if (fault == 6) 400 else 300) != 0) return 101
        if (fault == 7) {
            word=0
            while (word < 56) { if (scratch.loadU32(word) != 0xabcdef12) return 104;word=word+4 }
        }
        word=0
        while (word < 2000) { if (out.loadU32(word) != 0x12345678) return 102;word=word+4 }
        word=0
        while (word < 20) { if (entries.loadU32(word) != 0x12345678) return 103;word=word+4 }
        fault=fault+1
    }
    return 0
}
