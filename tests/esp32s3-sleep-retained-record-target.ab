import "../src/esp32/power/sleep_retained_record_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_retained_record_target")
@section(".iram1.abla.s3SleepRetainedRecordTarget")
trusted fun retainedRecordTarget(record: NativeBuffer,cpu: NativeBuffer,tags: NativeBuffer,i: Esp32S3TagPlan,d: Esp32S3TagPlan,op: int,first: int,second: int): int {
    if (op == 0) return esp32S3SleepRecordArmRetentionOwned(record,cpu,tags,i,d,first != 0,second != 0)
    if (op == 1) return esp32S3SleepRetainedRecordEnterOwned(record,first,second)
    esp32S3SleepRetainedRecordResumeOwned(record,first) | 0
}
