import "../src/esp32/i2c/clear_idle_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(112)
var fault=0
var prepares=0
var restores=0
var finishes=0
var drives=0
var pulses=0
var releaseAt=0
var held=true
var clock=true
var data=true
var bad=false
fun p4I2cClearIdleAdmission(session: NativeBuffer): bool = fault != 1
fun p4I2cClearIdleCapture(session: NativeBuffer,index: int): P4GpioSnapshot =
    if (fault == 2) P4GpioSnapshot(0) else P4GpioSnapshot((1<<37)|((32-index)<<30))
fun p4I2cClearIdlePrepare(pin: int): bool {
    prepares=prepares+1
    if (nativeAddressLoadU32(memory,4) != 2 || nativeAddressLoadU32(memory+72,4) != 2) bad=true
    return !((fault == 3 && prepares == 1) || (fault == 4 && prepares == 2))
}
fun p4I2cClearIdleRestore(saved: P4GpioSnapshot): bool {
    restores=restores+1
    if (nativeAddressLoadU32(memory,4) != 3) bad=true
    return !(fault == 5 && saved.pin() == 32) && !(fault == 6 && saved.pin() == 31)
}
fun p4I2cClearIdleFinish(session: NativeBuffer,budget: u32): int {
    finishes=finishes+1
    if (session.loadU32(4) != 3 || budget != u32(100)) bad=true
    return if (fault == 7) 5 else 1
}
fun softwareI2cDrive(pin: int,released: bool): void {
    drives=drives+1
    if (pin == 31) data=released
    else if (pin == 32) {
        if (!clock && released) {
            pulses=pulses+1
            if (releaseAt > 0 && pulses >= releaseAt) held=false
        }
        clock=released
    } else bad=true
    return
}
fun softwareI2cSample(pin: int): bool = if (pin == 32) clock && fault != 8 else data && !held
fun softwareI2cDelay(us: int): void { if (us != 1 && us != 5) bad=true;return }
fun run(r: NativeBuffer,s: NativeBuffer): int = esp32p4I2cClearIdleOwned(r,s,5,8,u32(100),true)
@export("abla_p4_i2c_clear_idle_test")
fun test(): int {
    val s=nativeBufferAt(memory,72);val r=nativeBufferAt(memory+72,40)
    var port=0
    while (port < 2) {
        var edge=0
        while (edge <= 10) {
            fault=0
            while (fault < 9) {
                var offset=0
                while (offset < 112) { nativeAddressStoreU32(memory,offset,0);offset=offset+4 }
                s.storeU32(0,0x49324234);s.storeU32(4,3);s.storeU32(20,port);s.storeU32(24,3)
                prepares=0;restores=0;finishes=0;drives=0;pulses=0;releaseAt=edge;held=true;clock=true;data=true;bad=false
                val clearSuccess=edge >= 1 && edge <= 9
                val expected=if (fault == 1 || fault == 2) 3 else if (fault == 5 || fault == 6) 4 else
                    if (fault == 3 || fault == 4) 5 else if (fault == 8) 7 else if (!clearSuccess) 6 else if (fault == 7) 8 else 1
                if (run(r,s) != expected || bad) return 1
                if (fault == 1 || fault == 2) {
                    if (prepares != 0 || restores != 0 || drives != 0 || r.loadU32(0) != 0) return 2
                } else {
                    if (restores != 2 || s.loadU32(4) != (if (expected == 1) 1 else 3)) return 3
                    if (fault == 3 || fault == 4) { if (drives != 0) return 4 }
                    else if (pulses != (if (fault == 8) 0 else if (clearSuccess) edge+1 else 9)) return 5
                    val savedDrives=drives;val savedPrepares=prepares
                    if (fault == 5 || fault == 6) {
                        val savedFault=fault;fault=0
                        if (run(r,s) != (if (clearSuccess) 1 else 6) || restores != 4) return 6
                        fault=savedFault
                    } else if (run(r,s) != expected || restores != 2) return 7
                    if (drives != savedDrives || prepares != savedPrepares || bad) return 8
                    if (s.loadU32(4) == 1) {
                        s.storeU32(4,3)
                        if (run(r,s) != 3 || s.loadU32(4) != 3 || drives != savedDrives) return 10
                    }
                }
                fault=fault+1
            }
            edge=edge+1
        }
        port=port+1
    }
    // Validation is non-mutating, including alias and missing exclusive proof.
    drives=0
    if (esp32p4I2cClearIdleOwned(r,s,5,8,u32(100),false) != 2 ||
        esp32p4I2cClearIdleOwned(s,s,5,8,u32(100),true) != 2 ||
        esp32p4I2cClearIdleOwned(r,s,5,8,u32(0),true) != 2 || drives != 0) return 9
    return 0
}
