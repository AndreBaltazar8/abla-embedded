import "../src/esp32/timer_control_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var clock = u32(0)
var reset = u32(0)
var config = u32(0)
var writes = 0
var bad = false
fun esp32S3TimerRead(address: int): u32 {
    if (address == 0x600c0018 && writes == 0) return clock
    if (address == 0x600c0020 && writes == 1) return reset
    if (address == 0x60023000 && (writes == 2 || writes == 3)) return config
    bad = true
    u32(0)
}
fun esp32S3TimerWrite(address: int, value: u32): void {
    if (writes == 0 && address == 0x600c0018) clock = value
    else if (writes == 1 && address == 0x600c0020) reset = value
    else if ((writes == 2 || writes == 3) && address == 0x60023000) config = value
    else bad = true
    writes = writes + 1
    return
}
@export("abla_timer_s3_control_test")
trusted fun timerControlTest(): i32 {
    var variant = 0
    while (variant < 64) {
        val unit = variant & 1
        val enabled = (variant & 2) != 0
        val stall0 = (variant & 4) != 0
        val stall1 = (variant & 8) != 0
        val initial = if ((variant & 16) == 0) u32(0xa5a5a5a5) else u32(0x5a5a5a5a)
        clock = initial
        reset = ~initial
        config = if ((variant & 32) == 0) initial else ~initial
        val before = config
        writes = 0
        if (!esp32S3TimerConfigureLocked(unit,enabled,stall0,stall1) || writes != 4 || bad) return i32(1)
        if (clock != (initial | u32(0x20000000)) || reset != (~initial & u32(0xdfffffff))) return i32(2)
        val work = if (unit == 0) u32(0x40000000) else u32(0x20000000)
        val core0 = if (unit == 0) u32(0x10000000) else u32(0x04000000)
        val core1 = if (unit == 0) u32(0x08000000) else u32(0x02000000)
        val mask = work | core0 | core1
        val expected = (before & ~mask) | u32(0x80000000) |
            (if (enabled) work else u32(0)) | (if (stall0) core0 else u32(0)) | (if (stall1) core1 else u32(0))
        if (config != expected) return i32(3)
        variant = variant + 1
    }
    writes = 0
    if (esp32S3TimerConfigureLocked(-1,true,false,false) ||
        esp32S3TimerConfigureLocked(2,true,false,false) || writes != 0 || bad) return i32(4)
    i32(0)
}
