import "../src/m5stack/pm1_wake_pins_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val registers=nativeStaticAllocate(20480)
var writes=0
var drop=-1
var bad=false
var usb=0
fun regOffset(address: int): int {
    if (address < 0x60004000 || address >= 0x60009000 || (address&3) != 0) { bad=true;return 0 }
    return address-0x60004000
}
trusted fun esp32S3PinStateRead(address: int): int = if (address == 0x60038018) usb else nativeAddressLoadU32(registers,regOffset(address))
trusted fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes;writes=writes+1
    if (step == drop) return
    var target=address
    var updated=value
    if (address == 0x60004028) { target=0x60004020;updated=esp32S3PinStateRead(target)&~value }
    if (address == 0x60004024) { target=0x60004020;updated=esp32S3PinStateRead(target)|value }
    if (address == 0x6000400c) { target=0x60004004;updated=esp32S3PinStateRead(target)&~value }
    if (address == 0x60004008) { target=0x60004004;updated=esp32S3PinStateRead(target)|value }
    if (address == 0x60008414) { target=0x6000840c;updated=esp32S3PinStateRead(target)&~value }
    nativeAddressStoreU32(registers,regOffset(target),updated);return
}


@export("abla_pm1_wake_pins_s3_test")
trusted fun test(): i32 {
    var route=0
    while (route < 3) {
        val board=if (route == 0) m5BoardChainCaptain else if (route == 1) m5BoardPaperMono else m5BoardStopWatch
        val count=if (route == 0) 4 else if (route == 1) 3 else 2
        val total=count*7+(if (route == 0) 7 else 0)
        val mask=if (route == 0) 2097202 else if (route == 1) 14 else 6
        drop=-1
        while (drop < total) {
            var offset=0
            while (offset < 20480) { nativeAddressStoreU32(registers,offset,4294967295);offset=offset+4 }
            nativeAddressStoreU32(registers,0x4088,0);nativeAddressStoreU32(registers,0x4090,0)
            writes=0;bad=false;usb=0
            if (board.configurePm1WakePinsOwned(false) != 3 || m5BoardCoreP4X.configurePm1WakePinsOwned(true) != 2 || writes != 0) return i32(1)
            val result=board.configurePm1WakePinsOwned(true)
            // Repeated OE/route/OD writes in final output setup may be no-ops:
            // dropping those is harmless; changes to latch/mux/OE must fail.
            val harmless=route == 0 && (drop == 28 || drop == 29 || drop == 31 || drop == 33)
            if (drop < 0 || harmless) {
                if (result != (1|(count<<8)) || writes != total || bad) return i32(2)
                if (esp32S3PinStateRead(0x6000840c) != (4294967295&~(mask<<10)) ||
                    esp32S3PinStateRead(0x600080d8) != (4294967295&~mask) ||
                    esp32S3PinStateRead(0x60004020) != ((4294967295&~mask)|(if (route == 0) 2097152 else 0)) ||
                    esp32S3PinStateRead(0x60004004) != (if (route == 0) 4292870143 else 4294967295)) return i32(3)
                var pin=0
                while (pin < 22) {
                    val selected=(mask&(1<<pin)) != 0
                    val amplifier=route == 0 && pin == 21
                    if (esp32S3PinStateRead(0x60008484+pin*4) != (if (selected) 4294967295&~0x18082000 else 4294967295) ||
                        esp32S3PinStateRead(esp32S3GpioMuxAddress(pin)) != (if (selected) (4294967295&~0x7380)|(if (amplifier) 4096 else 4608) else 4294967295)) return i32(4)
                    pin=pin+1
                }
            } else {
                val step=drop%7
                val detail=if (step < 4) 4 else step+1
                val expected=if (drop < count*7) 4|((drop/7)<<8)|(detail<<16) else 5|(4<<8)
                if (result != expected || writes != drop+1 || bad) return i32(5)
            }
            drop=drop+1
        }
        route=route+1
    }
    return i32(0)
}
