import "../src/esp32/task_resolver_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_task_resolver_target")
@section(".iram1.abla.s3TaskResolverTarget")
trusted fun resolverTarget(current: NativeBuffer,binding: NativeBuffer,cp0: NativeBuffer,cp3: NativeBuffer,core: int,mode: int): int {
    if (mode == 0) return esp32S3TaskResolverAddress()
    if (esp32S3TaskPublishFirstOwned(current,binding,cp0,cp3,core)) 1 else 0
}
