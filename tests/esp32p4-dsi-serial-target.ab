import "../src/esp32/serial_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_serial_target")
trusted fun target(unit: int,operation: int,value: int,polls: int): int {
    if (operation == 0) return serial(unit).tryReadByte()
    if (operation == 1) return if (serial(unit).tryWriteByte(value,polls)) 1 else 0
    if (operation == 3) return serial(unit).configureOwned(40000000,value,8,0,1,polls)
    return if (serial(unit).tryFlush(polls)) 1 else 0
}
