import "../src/esp32/i2c/lp_clock_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var clockWord=0
var resetWord=0
var sourceWord=0
var writes=0
var reads=0
var source=0
var bad=false
var fault=0
var disabling=false
trusted fun c5LpI2cClockLoad(address: int): int {
    reads=reads+1
    val checking= writes == (if (disabling) 1 else 4)
    if (address == 0x600B2800) return clockWord ^ (if (checking && fault == 1) 0x10000000 else 0)
    if (address == 0x600B2804) return resetWord ^ (if (checking && fault == 2) 0x10000000 else 0)
    if (address == 0x600B0428) return sourceWord ^ (if (checking && fault == 3) 0x40000000 else 0)
    bad=true
    0
}
trusted fun c5LpI2cClockStore(address: int,value: int): void {
    val expectedAddress=if (disabling || writes == 0) 0x600B2800 else if (writes == 2) 0x600B0428 else 0x600B2804
    if (address != expectedAddress) bad=true
    if (address == 0x600B2800) {
        val expected=if (disabling) clockWord&~0x10000000 else clockWord|0x10000000
        if (value != expected) bad=true
        clockWord=value
    } else if (address == 0x600B2804) {
        val expected=if (writes == 1) resetWord|0x10000000 else resetWord&~0x10000000
        if (value != expected) bad=true
        resetWord=value
    } else if (address == 0x600B0428) {
        if (value != ((sourceWord&~0x40000000)|(source<<30))) bad=true
        sourceWord=value
    }
    writes=writes+1
    return
}
@export("abla_c5_lp_i2c_clock_test")
trusted fun clockTest(): i32 {
    var profile=0
    while (profile < 4096) {
        source=profile%2; fault=profile/2%4
        clockWord=int(u32(profile)*u32(2654435761)); resetWord=clockWord^0xFFFFFFFF; sourceWord=clockWord^0xA5A5A5A5
        disabling=false; writes=0; reads=0; bad=false
        if (esp32C5LpI2cResetClockOwned(0,source) != (fault == 0) || writes != 4 || bad) return i32(1)
        disabling=true; writes=0; reads=0; bad=false
        if (esp32C5LpI2cDisableClockOwned(0) != (fault != 1) || writes != 1 || bad) return i32(2)
        profile=profile+1
    }
    writes=0; reads=0
    if (esp32C5LpI2cResetClockOwned(1,0) || esp32C5LpI2cResetClockOwned(0,2) ||
        esp32C5LpI2cResetClockOwned(0,-1) || esp32C5LpI2cDisableClockOwned(-1) || writes != 0 || reads != 0) return i32(3)
    i32(0)
}
