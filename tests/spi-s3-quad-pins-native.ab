import "../src/esp32/spi/quad_pins_sequence_esp32s3.ab"
import "../src/esp32/soc/gpio_capabilities.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this|0
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this|0)
var calls=0
var failure=0
var port=2
var bad=false
trusted fun Pin.outputLevelOwned(high: bool): bool {
    if (calls != 0 || this != 39 || !high) bad=true
    calls=calls+1;return failure != calls
}
trusted fun Pin.routeOutputSignal(signal: int,inverted: bool): bool {
    val expectedPin=if (calls == 1) 40 else if (calls == 2) 41 else if (calls == 3) 42 else if (calls == 4) 46 else 45
    val expectedSignal=(if (port == 2) 101 else 66)+(if (calls == 1) 0 else if (calls == 2) 2 else if (calls == 3) 1 else if (calls == 4) 4 else 3)
    if (calls < 1 || calls > 5 || this != expectedPin || signal != expectedSignal || inverted) bad=true
    calls=calls+1;return failure != calls
}
@export("abla_spi_s3_quad_pins_test")
trusted fun test(): i32 {
    val pins=quadSpiPins(40,41,42,46,45)
    if (pins.clockPin() != 40 || pins.dataPin(0) != 41 || pins.dataPin(1) != 42 ||
        pins.dataPin(2) != 46 || pins.dataPin(3) != 45 || pins.dataPin(-1) != -1 || pins.dataPin(4) != -1) return i32(1)
    while (port <= 3) {
        failure=0
        while (failure <= 6) {
            calls=0;bad=false
            val result=esp32s3SpiRouteQuadTransmitPinsOwned(port,pins,Pin(39))
            if (result != (if (failure == 0) 1 else failure+2) || calls != (if (failure == 0) 6 else failure) || bad) return i32(2)
            failure=failure+1
        }
        // Exhaustively vary each data lane across representable GPIO numbers:
        // reserved holes, duplicates, clock/select collisions rejected pre-I/O.
        var lane=0
        while (lane < 4) {
            var number=0
            while (number <= 62) {
                val changed=quadSpiPins(40,if (lane == 0) number else 41,if (lane == 1) number else 42,
                    if (lane == 2) number else 46,if (lane == 3) number else 45)
                var expected=Pin(number).outputCapable() && number != 40 && number != 39
                var other=0
                while (other < 4) {
                    if (other != lane && number == pins.dataPin(other)) expected=false
                    other=other+1
                }
                if (esp32s3SpiQuadTransmitPinsValid(port,changed,Pin(39)) != expected) return i32(3)
                if (!expected) {
                    calls=0
                    if (esp32s3SpiRouteQuadTransmitPinsOwned(port,changed,Pin(39)) != 2 || calls != 0) return i32(4)
                }
                number=number+1
            }
            lane=lane+1
        }
        port=port+1
    }
    calls=0
    if (esp32s3SpiRouteQuadTransmitPinsOwned(1,pins,Pin(39)) != 2 ||
        esp32s3SpiRouteQuadTransmitPinsOwned(2,quadSpiPins(-1,41,42,46,45),Pin(39)) != 2 ||
        esp32s3SpiRouteQuadTransmitPinsOwned(2,quadSpiPins(40,41,42,46,63),Pin(39)) != 2 ||
        esp32s3SpiRouteQuadTransmitPinsOwned(2,pins,Pin(40)) != 2 || calls != 0) return i32(5)
    return i32(0)
}
