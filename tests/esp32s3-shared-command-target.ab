import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/spi/software_shared_command.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_shared_command_test")
trusted fun sharedCommandTargetTest(gateAddress: u32, dataAddress: u32, length: i32, command: i32): int =
    softwareSpiSharedCommand(peripheralGateAt(int(gateAddress)), u32(7), pin(36), pin(37), pin(3), pin(35),
        int(command), nativeBufferAt(int(dataAddress), int(length)), int(length), 0, 1).status()
