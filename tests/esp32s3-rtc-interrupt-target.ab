import "../src/esp32/i2c_esp32s3.ab"
import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_interrupt_target")
trusted fun rtcInterruptTarget(handle: int,rx: bool): I2cByteResult =
    if (rx) Rx8130(handle).interruptPendingChecked() else Pcf8563(handle).interruptPendingChecked()
