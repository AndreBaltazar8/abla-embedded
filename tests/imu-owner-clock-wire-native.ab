import "./pm1-imu-owner-wire-native.ab"
import "../src/m5stack/imu_owner_clock.ab"
@export("abla_imu_owner_clock_wire_test")
trusted fun testClockWire(): i32 {
    wireSeed()
    val parent=m5Pm1ControlAt(nativeBufferAt(retainedImuParent,76))
    val imu=m5ImuOwnerAt(nativeBufferAt(retainedImuMemory,36))
    val snapshot=imuSnapshotAt(nativeBufferAt(retainedImuMemory+36,44))
    val scratch=nativeBufferAt(retainedImuMemory+80,20)
    val r=nativeBufferAt(pm1ImuRegisters,256)
    val bus=i2cSoftwareMaster(0,1,5,8)
    if (!parent.initialize() || !imu.initialize() || !snapshot.initialize() ||
        parent.openOwned(bus|0,m5BoardStopWatch,true,true) != 1) return i32(1)
    var offset=0
    while (offset < 256) { r.store(offset,0);offset=offset+1 }
    r.store(117,25);pm1ImuPresent=true
    if (parent.openRetainedImuPreparedOwned(imu,true) != 1) return i32(2)
    val handle=imu.primary().handle()
    val pool=softwareI2cProviderPool()
    val original=pool.resolve(handle)
    val originalWaits=pm1ImuWaits
    val start=ackCount
    // Exercise every legal request: ceiling rounding, minimum half-period,
    // and metadata preservation must hold even between common standard rates.
    var rate=1000
    while (rate <= 400000) {
        val result=imu.setClockOwned(rate,true)
        val descriptor=pool.resolve(handle)
        val rounded=(500000+rate-1)/rate
        val expected=if (rounded < 5) 5 else rounded
        if (!result.complete() || result.attempted() != 1 || result.updated() != 1 ||
            ((descriptor>>>16)&1023) != expected ||
            (descriptor&~(1023<<16)) != (original&~(1023<<16)) ||
            imu.primary().handle() != handle || !parent.imuRetained()) return i32(3)
        rate=rate+1
    }
    val before=pool.resolve(handle)
    if (imu.setClockOwned(999,true).status() != 2 || imu.setClockOwned(400001,true).status() != 2 ||
        imu.setClockOwned(10000,false).status() != 2 || pool.resolve(handle) != before) return i32(4)
    if (!softwareI2cProviderEnter()) return i32(5)
    val busy=imu.setClockOwned(10000,true)
    if (!softwareI2cProviderLeave() || busy.status() != 4 || busy.failed() != 1 ||
        pool.resolve(handle) != before) return i32(6)
    if (!imu.setClockOwned(10000,true).complete() || ackCount != start || pm1ImuWaits != originalWaits) return i32(7)
    // A rate update is metadata only, not sensor reset/reinitialization.
    r.store(58,1);r.store(59,0x80);r.store(60,0);r.store(71,0x7f);r.store(72,0xff)
    val acquired=imu.updateSnapshot(snapshot,scratch,123)
    if (!acquired.valid() || acquired.failed() || acquired.fresh() != 3 ||
        snapshot.axes(0).axis(0) != -32768 || snapshot.axes(1).axis(2) != 32767 ||
        snapshot.timestamp(0) != 123 || r.load(107) != 1 || r.load(27) != 24 || r.load(28) != 16) return i32(8)
    if (!parent.closeRetainedImuOwned(imu,true) || pool.resolve(handle) != 0 ||
        I2cDevice(handle).setFrequency(100000) || !parent.closeOwned(true) || !bus.close() || pads != 0 || bad) return i32(9)
    i32(0)
}
