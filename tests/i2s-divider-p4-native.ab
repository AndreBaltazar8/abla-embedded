import "../src/esp32/i2s/clock_divider_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
// Independent oracle extracted from cached Espressif register definitions.
val offsets=nativeStaticU32s([72,72,72,76,76,76,76,80,80,80,80,84,84,84,84,88,88,88,92,92,92,92,96,96,96,96,100,100,100,100])
val shifts=nativeStaticU32s([0,8,17,0,9,13,21,0,9,18,23,0,9,18,27,0,8,17,0,9,14,22,0,9,18,22,0,9,18,27])
val order=nativeStaticU32s([0,4,2,3,1,4,3,2,1,0])
val expected=nativeStaticAllocate(40)
val registers=nativeStaticAllocate(40)
var route=0
var step=0
var fail=0
var bad=false
var busy=0
var reads=0
trusted fun p4I2sDividerRead(address: int): int {
    reads=reads+1
    val base=0x500c6000+(route/2)*4096
    if (address == base+32 || address == base+36) return busy
    val offset=address-0x500e6044
    if (offset < 0 || offset > 32 || (offset & 3) != 0) { bad=true;return 0 }
    return nativeAddressLoadU32(registers,offset)
}
trusted fun p4I2sDividerWrite(address: int,value: int): void {
    if (step >= 10) { bad=true;return }
    val field=nativeAddressLoadU32(order,step*4)
    val index=(route*5+field)*4
    val offset=nativeAddressLoadU32(offsets,index)
    val shift=nativeAddressLoadU32(shifts,index)
    val mask=(if (field == 0) 255 else if (field == 4) 1 else 511) << shift
    val old=nativeAddressLoadU32(registers,offset-68)
    val want=(old & (0xffffffff ^ mask)) | (nativeAddressLoadU32(expected,step*4) << shift)
    if (address != 0x500e6000+offset || value != want) bad=true
    step=step+1
    // Corrupt one owned bit even when this write would otherwise be a no-op.
    nativeAddressStoreU32(registers,offset-68,if (step == fail) value ^ (1 << shift) else value)
    return
}
trusted fun run(n: int,num: int,den: int): bool {
    var at=0
    while (at < 40) { nativeAddressStoreU32(registers,at,0xa5a55a5a);at=at+4 }
    var x=0;var y=0;var z=0;var inv=0
    if (num != 0) {
        inv=if (num > den-num) 1 else 0
        z=if (inv == 1) den-num else num
        x=den/z-1;y=den%z
    }
    nativeAddressStoreU32(expected,0,2);nativeAddressStoreU32(expected,4,0)
    nativeAddressStoreU32(expected,8,1);nativeAddressStoreU32(expected,12,0)
    nativeAddressStoreU32(expected,16,0);nativeAddressStoreU32(expected,20,inv)
    nativeAddressStoreU32(expected,24,z);nativeAddressStoreU32(expected,28,y)
    nativeAddressStoreU32(expected,32,x);nativeAddressStoreU32(expected,36,n)
    step=0;reads=0;bad=false
    val result=esp32p4I2sSetDividerOwned(route/2,(route & 1) == 1,n,num,den,true)
    return result == (if (busy != 0) 3 else if (fail == 0) 1 else fail+3) &&
        step == (if (busy != 0) 0 else if (fail == 0) 10 else fail) && !bad
}
@export("abla_i2s_divider_p4_test")
trusted fun test(): i32 {
    while (route < 6) {
        var den=1
        while (den <= 511) {
            var num=0
            while (num < den) {
                if (!run(2+num%254,num,den)) return i32(1)
                num=num+1
            }
            den=den+1
        }
        var n=2
        while (n <= 255) { if (!run(n,0,1)) return i32(2);n=n+1 }
        fail=1
        while (fail <= 10) { if (!run(17,7,11)) return i32(3);fail=fail+1 }
        fail=0;busy=256
        if (!run(17,7,11)) return i32(4)
        busy=0;route=route+1
    }
    reads=0;step=0
    if (esp32p4I2sSetDividerOwned(0,false,2,0,1,false) != 2 ||
        esp32p4I2sSetDividerOwned(3,false,2,0,1,true) != 2 ||
        esp32p4I2sSetDividerOwned(-1,false,2,0,1,true) != 2 ||
        esp32p4I2sSetDividerOwned(0,false,1,0,1,true) != 2 ||
        esp32p4I2sSetDividerOwned(0,false,256,0,1,true) != 2 ||
        esp32p4I2sSetDividerOwned(0,false,2,-1,1,true) != 2 ||
        esp32p4I2sSetDividerOwned(0,false,2,1,1,true) != 2 ||
        esp32p4I2sSetDividerOwned(0,false,2,0,0,true) != 2 ||
        esp32p4I2sSetDividerOwned(0,false,2,0,512,true) != 2 || reads != 0 || step != 0) return i32(5)
    return i32(0)
}
