import "../src/m5stack/tab_power_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var failure=0
var bad=false
fun tabPowerWrite(handle: int,register: int,value: int): bool {
    val step=calls
    val r=if (step%5 == 0) 5 else if (step%5 == 1) 3 else if (step%5 == 2) 7 else if (step%5 == 3) 13 else 11
    val v=if (step == 0) 112 else if (step == 1) 115 else if (step == 2) 8 else if (step < 5) 4 else
        if (step == 5) 129 else if (step == 6) 177 else if (step == 7) 6 else 8
    if (handle != (if (step < 5) 8 else 9) || step >= 10 || register != r || value != v) bad=true
    calls=calls+1; calls != failure
}
fun tabPowerExtDrive(handle: int): bool { if (handle != 8 || calls != 10) bad=true; calls=calls+1; calls != failure }
fun tabPowerExtDirection(handle: int): bool { if (handle != 8 || calls != 11) bad=true; calls=calls+1; calls != failure }
fun tabPowerExtLatch(handle: int): bool { if (handle != 8 || calls != 12) bad=true; calls=calls+1; calls != failure }
@export("abla_tab_power_test")
fun powerTest(): i32 {
    var profile=0
    while (profile < 28) {
        failure=profile%14
        val extended=profile >= 14
        val total=if (extended) 13 else 10
        calls=0; bad=false
        val result=(if (extended) m5BoardTab5X else m5BoardTab5).configureTabPowerOwned(8,9)
        val failed=failure > 0 && failure <= total
        val expected=if (!failed) 1 else if (failure <= 10) 4 else failure-6
        if (result.status() != expected || result.appliedSteps() != (if (failed) failure-1 else total) ||
            calls != (if (failed) failure else total) || bad) return i32(1)
        profile=profile+1
    }
    calls=0
    if (m5BoardTab5.configureTabPowerOwned(0,9).status() != 3 || m5BoardTab5X.configureTabPowerOwned(8,8).status() != 3 ||
        m5BoardTab5.configureTabPowerOwned(8,4294967296).status() != 3 || m5BoardAtomVoice.configureTabPowerOwned(8,9).status() != 2 || calls != 0) return i32(2)
    i32(0)
}
