import "../src/audio/wav.ab"
import "abla/runtime/scalar"
import "abla/build"
val sourceStorage=nativeStaticAllocate(128)
val infoStorage=nativeStaticAllocate(22)
trusted fun makeWav(bits: int,channels: int,swapped: bool): void {
    val source=nativeBufferAt(sourceStorage+1,120)
    var index=0
    while (index < 120) { source.store(index,0); index=index+1 }
    source.storeU32(0,0x46464952); source.storeU32(4,58); source.storeU32(8,0x45564157)
    // Odd-sized JUNK with padding before the format/audio chunks.
    source.storeU32(12,0x4b4e554a); source.storeU32(16,1); source.store(20,99)
    val fmt=if (swapped) 34 else 22
    val data=if (swapped) 22 else 46
    source.storeU32(fmt,0x20746d66); source.storeU32(fmt+4,16)
    source.storeU16(fmt+8,1); source.storeU16(fmt+10,channels)
    source.storeU32(fmt+12,16000); source.storeU32(fmt+16,16000*channels*(bits >>> 3))
    source.storeU16(fmt+20,channels*(bits >>> 3)); source.storeU16(fmt+22,bits)
    source.storeU32(data,0x61746164); source.storeU32(data+4,4)
    source.storeU32(data+8,0x80ff007f)
    // Empty LIST metadata after audio; never included in sample view.
    source.storeU32(58,0x5453494c); source.storeU32(62,0)
    return
}
trusted fun clearInfo(): void {
    val info=nativeBufferAt(infoStorage,22)
    var index=0
    while (index < 22) { info.store(index,85); index=index+1 }
    return
}
trusted fun untouched(): bool {
    val info=nativeBufferAt(infoStorage,22)
    var index=0
    while (index < 22) {
        if (info.load(index) != 85) return false
        index=index+1
    }
    true
}
@export("abla_wav_test")
trusted fun wavTest(): i32 {
    val source=nativeBufferAt(sourceStorage+1,120)
    val info=nativeBufferAt(infoStorage+1,20)
    var bits=8
    while (bits <= 16) {
        var channels=1
        while (channels <= 2) {
            var order=0
            while (order < 2) {
                makeWav(bits,channels,order != 0); clearInfo()
                val wav=pcmWav(source,info)
                if (!wav.valid() || wav.sampleRate() != 16000 || wav.channels() != channels ||
                    wav.bitsPerSample() != bits || wav.samples().capacity() != 4 ||
                    wav.samples().loadU32(0) != 0x80ff007f ||
                    nativeBufferAt(infoStorage,22).load(0) != 85 ||
                    nativeBufferAt(infoStorage,22).load(21) != 85) return i32(1)
                var length=0
                while (length < 66) {
                    clearInfo()
                    if (pcmWav(nativeBufferAt(sourceStorage+1,length),info).valid() || !untouched()) return i32(2)
                    length=length+1
                }
                order=order+1
            }
            channels=channels+1
        }
        bits=bits+8
    }
    var failure=0
    while (failure < 9) {
        makeWav(16,2,false); clearInfo()
        if (failure == 0) source.storeU32(4,4294967295)
        if (failure == 1) source.storeU32(16,4294967295)
        if (failure == 2) source.storeU16(30,3)
        if (failure == 3) source.storeU16(32,3)
        if (failure == 4) source.storeU16(44,24)
        if (failure == 5) source.storeU16(42,2)
        if (failure == 6) source.storeU32(38,1)
        if (failure == 7) source.storeU32(50,3)
        if (failure == 8) source.storeU32(58,0x61746164)
        if (pcmWav(source,info).valid() || !untouched()) return i32(3)
        failure=failure+1
    }
    makeWav(16,2,false); clearInfo()
    if (pcmWav(source,nativeBufferAt(sourceStorage+1,20)).valid() ||
        pcmWav(source,nativeBufferAt(infoStorage+1,19)).valid() || !untouched()) return i32(4)
    i32(0)
}
