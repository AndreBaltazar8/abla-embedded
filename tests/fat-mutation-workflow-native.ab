        val reopenedStorage=nativeBufferAt(memory+5760,80)
        if (remounted == 0 || file.readAt(u32(7),0,1,64,output,work).status() != 13 ||
            !fatFileInitializeFresh(reopenedStorage,remounted,u32(7))) return i32(20)
        val reopened=fatFileOpenPathUtf16(reopenedStorage,u32(7),name,9,64,work)
        if (reopened.status() != 1 || reopened.readAt(u32(7),0,1,64,output,work).status() != 2 ||
            reopenedStorage.loadU16(66) != 0 || reopenedStorage.loadU32(68) != 0 ||
            !reopened.close(u32(7))) return i32(21)
        val dirName=nativeBufferAt(memory+5840,2);val nestedName=nativeBufferAt(memory+5856,2)
        val nestedPath=nativeBufferAt(memory+5888,128)
        dirName.storeU16(0,100);nestedName.storeU16(0,101)
        // Explicit FAT32 root cluster must also produce a zero '..' target.
        val rootParent=if (mode == 2) 2 else 0
        if (remounted.createDirectory(u32(7),rootParent,dirName,1,1,8,64,modified,work).status() != 1 ||
            remounted.createDirectory(u32(7),firstCluster,nestedName,1,1,8,64,modified,work).status() != 1) return i32(22)
        val outer=nativeBufferAt(image+1536,512);val inner=nativeBufferAt(image+2048,512)
        if (outer.load(0) != 46 || outer.load(33) != 46 || outer.loadU16(26) != firstCluster || outer.loadU16(58) != 0 ||
            inner.loadU16(26) != firstCluster+1 || inner.loadU16(58) != firstCluster || inner.load(64) != 0) return i32(23)
        if (remounted.createLongAuto(u32(7),firstCluster+1,name,9,1,8,64,modified,work).status() != 1) return i32(24)
        val pathText=nativeBufferAt(nativeStaticBytes("d/e/../e/voice.raw"),18)
        i=0;while (i < 18) { nestedPath.storeU16(i*2,pathText.load(i));i=i+1 }
        var nestedFile=fatFileOpenPathUtf16(reopenedStorage,u32(7),nestedPath,18,64,work)
        if (nestedFile.status() != 1 || nestedFile.resize(u32(7),7,64,modified,NativeBuffer(0),work).status() != 1) return i32(25)
        i=0;while (i < 7) { input.store(i,97+i);i=i+1 }
        if (nestedFile.overwriteAt(u32(7),0,7,64,input,modified,work).dataBytesWritten() != 7 ||
            nestedFile.readAt(u32(7),0,7,64,output,work).bytesRead() != 7) return i32(26)
        i=0;while (i < 7) { if (output.load(i) != 97+i) return i32(27);i=i+1 }
        copy=0;while (copy < 2) {
            val fat=nativeBufferAt(image+copy*512,512)
            if (mode == 2 && copy == 0) { i=0;while (i < 512) { if (fat.load(i) != 85) return i32(28);i=i+1 } }
            else {
                var cluster=firstCluster
                while (cluster < firstCluster+3) {
                    if (fatLinkRaw(fatLinkLocate(boot,0,total,cluster),fat,NativeBuffer(0)) != (if (mode == 0) 4095 else 0xfffffff)) return i32(29)
                    if (mode != 0 && (fat.loadU32(cluster*4)>>>28) != 10) return i32(30)
                    cluster=cluster+1
                }
            }
            copy=copy+1
        }
        val expectedEntry=nativeBufferAt(memory+6208,32)
        val renameWork=nativeBufferAt(nativeStaticAllocate(5352),5352)
        val movedName=nativeBufferAt(memory+6272,18)
        val movedText=nativeBufferAt(nativeStaticBytes("moved.raw"),9)
        i=0;while (i < 9) { movedName.storeU16(i*2,movedText.load(i));i=i+1 }
        i=0;while (i < 32) { expectedEntry.store(i,reopenedStorage.load(40+i));i=i+1 }
        if (remounted.renameFile(u32(7),firstCluster+1,0,3,expectedEntry,rootParent,movedName,9,1,8,64,renameWork).status() != 1 ||
            nestedFile.readAt(u32(7),0,7,64,output,work).status() != 10 || !nestedFile.close(u32(7))) return i32(39)
        nestedFile=fatFileOpenPathUtf16(reopenedStorage,u32(7),movedName,9,64,work)
        if (nestedFile.status() != 1 || nestedFile.readAt(u32(7),0,7,64,output,work).bytesRead() != 7 || output.load(0) != 97) return i32(40)
        i=11;while (i < 32) { if (reopenedStorage.load(40+i) != expectedEntry.load(i)) return i32(41);i=i+1 }
        i=0;while (i < 32) { expectedEntry.store(i,reopenedStorage.load(40+i));i=i+1 }
        if (remounted.renameFile(u32(7),rootParent,reopenedStorage.loadU32(28),reopenedStorage.loadU32(32),expectedEntry,
