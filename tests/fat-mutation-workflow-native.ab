        i=0;while (i < 14) { parentPath.storeU16(i*2,parentText.load(i));i=i+1 }
        val rootFile=fatLookupPathUtf16Owned(reader,boot,0,total,parentPath,14,64,work)
        if (!rootFile.isFile() || rootFile.byteSize() != 0) return i32(47)
        i=0;while (i < 32) { expectedEntry.store(i,rootBeforeMove.load(160+i));i=i+1 }
        if (remounted.renameDirectory(u32(7),rootParent,0,5,expectedEntry,firstCluster,nestedName,1,1,8,64,directoryMoveWork).status() != 1 ||
