        i=0;while (i < 32) { expectedEntry.store(i,outer.load(96+i));i=i+1 }
        val beforeRemove=writes
        if (remounted.removeEntry(u32(7),firstCluster,0,3,expectedEntry,64,plan,work).status() != 10 || writes != beforeRemove) return i32(32)
        i=0;while (i < 32) { expectedEntry.store(i,reopenedStorage.load(40+i));i=i+1 }
        val removedFile=remounted.removeEntry(u32(7),firstCluster+1,0,3,expectedEntry,64,plan,work)
        if (removedFile.status() != 1 || removedFile.freedClusters() != 1 || inner.load(64) != 229 || inner.load(96) != 229 ||
