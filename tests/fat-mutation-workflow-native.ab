    val modified=rtcCalendarDateTime(2026,9,9,12,34,56)
    var i=0;while (i < 9) { name.storeU16(i*2,spelling.load(i));i=i+1 }
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    while (mode < 3) {
        writes=0;bad=false;i=0;while (i < 512) { boot.store(i,0);i=i+1 }
        boot.storeU16(11,512);boot.store(13,1);boot.store(16,2);boot.storeU16(510,0xaa55)
        if (mode == 0) { boot.storeU16(14,1);boot.storeU16(17,224);boot.storeU16(22,9);boot.storeU16(19,2880) }
        else { boot.storeU16(14,32);boot.storeU32(32,70000);boot.storeU32(36,600);boot.storeU32(44,2)
            boot.storeU16(48,1);boot.storeU16(50,6);boot.storeU16(40,if (mode == 2) 129 else 0) }
        val total=if (mode == 0) 2880 else 70000
        val firstCluster=if (mode == 0) 2 else 3
        i=0;while (i < 4096) { nativeBufferAt(image,4096).store(i,77);i=i+1 }
        i=0;while (i < 512) { nativeBufferAt(image+1024,512).store(i,0);i=i+1 }
        var copy=0
        while (copy < 2) {
            val fat=nativeBufferAt(image+copy*512,512);i=0
            while (i < 512) { fat.store(i,255);i=i+1 }
            if (mode != 0) { i=0;while (i < 512) { fat.storeU32(i,0xafffffff);i=i+4 } }
            var cluster=firstCluster
            while (cluster < firstCluster+3) {
                if (!fatLinkPatch(fatLinkLocate(boot,0,total,cluster),0,fat,NativeBuffer(0))) return i32(2)
                cluster=cluster+1
            }
            val info=nativeBufferAt(image+3072+copy*512,512)
            info.storeU32(0,0x41615252);info.storeU32(484,0x61417272);info.storeU32(508,0xaa550000)
            info.storeU32(488,123);info.storeU32(492,7)
