import "../src/storage/fat_directory_rename.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(8192)
val image=nativeStaticAllocate(4096)
var mode=0
var writes=0
var bad=false
fun diskSlot(lba: int): int = if (mode == 0)
    (if (lba == 1) 0 else if (lba == 10) 1 else if (lba == 19) 2 else if (lba >= 33 && lba <= 35) lba-30 else -1)
    else (if (lba == 32) 0 else if (lba == 632) 1 else if (lba >= 1232 && lba <= 1235) lba-1230
        else if (lba == 1) 6 else if (lba == 7) 7 else -1)
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    val selected=diskSlot(lba)
    if (selected < 0 && lba != 0) { bad=true;return false }
    val source=if (lba == 0) nativeBufferAt(memory+64,512) else nativeBufferAt(image+selected*512,512)
    var i=0;while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool {
    val selected=diskSlot(lba);writes=writes+1
    if (selected < 0 || (mode == 2 && selected == 0)) { bad=true;return false }
    val output=nativeBufferAt(image+selected*512,512);var i=0
    while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return true
}
@export("abla_fat_mutation_workflow_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,32);val reader=nativeBufferAt(memory+32,28);val boot=nativeBufferAt(memory+64,512)
