                while (cluster < firstCluster+3) {
                    if (fatLinkRaw(fatLinkLocate(boot,0,total,cluster),fat,NativeBuffer(0)) != 0) return i32(15)
                    if (mode != 0 && (fat.loadU32(cluster*4)>>>28) != 10) return i32(16)
                    cluster=cluster+1
                }
                if (mode == 0 && fatLinkRaw(fatLinkLocate(boot,0,total,5),fat,NativeBuffer(0)) != 4095) return i32(17)
            }
            if (mode != 0) {
                val info=nativeBufferAt(image+3072+copy*512,512)
