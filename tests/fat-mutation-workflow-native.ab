        i=0;while (i < 32) { expectedEntry.store(i,outer.load(96+i));i=i+1 }
        if (remounted.removeEntry(u32(7),firstCluster,0,3,expectedEntry,64,plan,work).freedClusters() != 1) return i32(34)
        val rootDirectory=nativeBufferAt(image+1024,512)
