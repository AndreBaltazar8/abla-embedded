        // Child handles stay usable: their directory entry and cluster do not move.
        if (nestedFile.readAt(u32(7),0,7,64,output,work).bytesRead() != 7 || output.load(0) != 97) return i32(46)
        val parentPath=nativeBufferAt(memory+6400,64)
