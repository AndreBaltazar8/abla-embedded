        val removedOuter=remounted.removeEntry(u32(7),rootParent,0,3,expectedEntry,64,plan,work)
        if (removedOuter.status() != 1 || removedOuter.freedClusters() != 1 || rootDirectory.load(64) != 229 || rootDirectory.load(96) != 229) return i32(35)
        if (fatFileOpenPathUtf16(reopenedStorage,u32(7),nestedPath,18,64,work).status() != 3) return i32(36)
        copy=0;while (copy < 2) {
            val fat=nativeBufferAt(image+copy*512,512);var cluster=firstCluster
            if (mode == 2 && copy == 0) { i=0;while (i < 512) { if (fat.load(i) != 85) return i32(37);i=i+1 } }
            else { while (cluster < firstCluster+3) {
                if (fatLinkRaw(fatLinkLocate(boot,0,total,cluster),fat,NativeBuffer(0)) != 0) return i32(38)
                cluster=cluster+1
            } }
            copy=copy+1
        }
        if (bad || !remounted.invalidate(u32(7))) return i32(31)
        mode=mode+1
    }
    return i32(0)
}
