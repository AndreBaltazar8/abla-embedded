        nestedFile=fatFileOpenPathUtf16(reopenedStorage,u32(7),nestedPath,18,64,work)
        if (nestedFile.status() != 1 || nestedFile.readAt(u32(7),0,7,64,output,work).bytesRead() != 7 || output.load(6) != 103) return i32(43)
        val directoryMoveWork=nativeBufferAt(nativeStaticAllocate(5864),5864)
        val movedDirectoryName=nativeBufferAt(memory+6336,2);movedDirectoryName.storeU16(0,102)
        val rootBeforeMove=nativeBufferAt(image+1024,512)
        i=0;while (i < 32) { expectedEntry.store(i,rootBeforeMove.load(96+i));i=i+1 }
        val beforeCycle=writes
        if (remounted.renameDirectory(u32(7),rootParent,0,3,expectedEntry,firstCluster+1,movedDirectoryName,1,1,8,64,directoryMoveWork).status() != 18 ||
            writes != beforeCycle) return i32(44)
        i=0;while (i < 32) { expectedEntry.store(i,outer.load(96+i));i=i+1 }
        val beforeMove=writes
        if (remounted.renameDirectory(u32(7),firstCluster,0,3,expectedEntry,rootParent,movedDirectoryName,1,1,8,64,directoryMoveWork).status() != 1 ||
