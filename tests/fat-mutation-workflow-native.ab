        val volume=fatVolumeOpen(state,u32(7),reader,total,-1,boot,output)
        if (volume == 0) return i32(3)
        val created=volume.createLongAuto(u32(7),0,name,9,1,8,64,modified,work)
        if (created.status() != 1 || created.entryIndex() != 1 || created.ordinal() != 0) return i32(4)
        if (!fatFileInitializeFresh(handle,volume,u32(7))) return i32(5)
        val file=fatFileOpenPathUtf16(handle,u32(7),name,9,64,work)
        if (file.status() != 1 || file.resize(u32(7),1200,64,modified,NativeBuffer(0),work).status() != 1) return i32(6)
        var offset=0
        while (offset < 1200) {
            val count=if (1200-offset < 512) 1200-offset else 512
            i=0;while (i < count) { input.store(i,(offset+i)*17&255);i=i+1 }
            val written=file.overwriteAt(u32(7),offset,count,64,input,modified,work)
            if (written.status() != 1 || written.dataBytesWritten() != count) return i32(7)
            offset=offset+count
        }
        offset=0
        while (offset < 1200) {
            val read=file.readAt(u32(7),offset,512,64,output,work)
            if (read.status() != 1 || read.bytesRead() == 0) return i32(8)
            i=0;while (i < read.bytesRead()) { if (output.load(i) != ((offset+i)*17&255)) return i32(9);i=i+1 }
            offset=offset+read.bytesRead()
        }
        val shrunk=file.resize(u32(7),100,64,modified,plan,work)
        if (shrunk.status() != 1 || shrunk.freedClusters() != 2 || file.resize(u32(7),700,64,modified,NativeBuffer(0),work).status() != 1) return i32(10)
        offset=0
        while (offset < 700) {
            val read=file.readAt(u32(7),offset,512,64,output,work)
            if (read.status() != 1 || read.bytesRead() == 0) return i32(11)
            i=0;while (i < read.bytesRead()) {
                if (output.load(i) != (if (offset+i < 100) (offset+i)*17&255 else 0)) return i32(12)
                i=i+1
