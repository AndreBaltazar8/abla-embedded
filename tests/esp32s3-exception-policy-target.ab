import "../src/esp32/exception_policy_esp32s3.ab"
import "../src/esp32/user_vector_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_exception_policy_target")
@section(".iram1.abla.s3ExceptionPolicyTarget")
trusted fun exceptionPolicyTarget(record: NativeBuffer,core: int,callback: int,context: int,mode: int): int {
    if (mode == 0) return esp32S3UserVectorAddress()
    if (mode == 1) return if (esp32S3ExceptionPolicyInstallOwned(record,core,callback,context)) 1 else 0
    return if (esp32S3ExceptionPolicyRemoveOwned(record,core)) 1 else 0
}
