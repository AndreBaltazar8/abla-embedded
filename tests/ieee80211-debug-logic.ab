import "../src/wifi/ieee80211_debug_logic.ab"

fun main: int {
    if (ieee80211DebugLevelLetter(0) != 78) return 1
    if (ieee80211DebugLevelLetter(1) != 69) return 2
    if (ieee80211DebugLevelLetter(2) != 87) return 3
    if (ieee80211DebugLevelLetter(3) != 73) return 4
    if (ieee80211DebugLevelLetter(4) != 68) return 5
    if (ieee80211DebugLevelLetter(5) != 86) return 6
    if (ieee80211DebugLevelLetter(6) != 0) return 7
    if (!ieee80211DebugLogEnabled(3, 3, true, true)) return 8
    if (ieee80211DebugLogEnabled(2, 3, true, true)) return 9
    if (ieee80211DebugLogEnabled(3, 3, false, true)) return 10
    if (ieee80211DebugLogEnabled(3, 3, true, false)) return 11
    if (!ieee80211DebugDumpReceiveTransmit(2)) return 12
    if (!ieee80211DebugDumpReceiveTransmit(3)) return 13
    if (ieee80211DebugDumpReceiveTransmit(1)) return 14
    90
}
