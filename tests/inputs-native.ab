import "../src/m5stack/inputs_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(72)
var calls=0
var event=3<<16
var bad=false
fun m5PmicKeyAxp(handle: int,kind: int): int = 0
fun m5PmicKeyPm1(handle: int): int = 0
trusted fun m5PowerButtonRead(pmic: M5PmicOpen): M5PowerKeyRead {
    calls=calls+1
    // Software level states must already be updated when IRQ read happens.
    val owner=m5InputsAt(nativeBufferAt(storage+4,64))
    if (owner.button(0).state().lastUpdateMilliseconds() != 10) bad=true
    M5PowerKeyRead(event)
}
@export("abla_inputs_test")
trusted fun inputTest(): i32 {
    val owner=m5InputsAt(nativeBufferAt(storage+4,64))
    val pmic=M5PmicOpen((1<<40)|(5<<32)|123)
    nativeAddressStoreU32(storage,0,123); nativeAddressStoreU32(storage,68,456)
    if (!owner.initialize()) return i32(1)
    var frame=m5ButtonFrame()
    var index=0
    while (index < 5) { frame=frame.withRead(index,m5ButtonRead(true,index%2 == 0)); index=index+1 }
    if (!owner.updateOwned(frame,pmic,false,0)) return i32(2)
    event=(3<<16)|1
    if (!owner.updateOwned(frame,pmic,true,10) || calls != 1 || bad || !owner.powerKey().wasClicked()) return i32(3)
    index=0
    while (index < 5) {
        if (!owner.button(index).sampleValid() || owner.button(index).state().isPressed() != (index%2 == 0) ||
            owner.button(index).state().wasPressed() != (index%2 == 0)) return i32(4)
        index=index+1
    }
    if (!owner.updateOwned(m5ButtonFrame(),pmic,false,1000) || calls != 1 || owner.powerKey().event() != 0 || owner.frame().validMask() != 0) return i32(5)
    index=0
    while (index < 5) {
        if (owner.button(index).sampleValid() || owner.button(index).state().wasPressed() ||
            owner.button(index).state().isPressed() != (index%2 == 0)) return i32(6)
        index=index+1
    }
    if (owner.button(-1).sampleValid() || owner.button(5).sampleValid() ||
        m5InputsAt(nativeBufferAt(storage+1,64)).initialize() || m5InputsAt(nativeBufferAt(storage,63)).initialize()) return i32(7)
    if (nativeAddressLoadU32(storage,0) != 123 || nativeAddressLoadU32(storage,68) != 456) return i32(8)
    nativeAddressStoreU32(storage,4,0)
    if (owner.updateOwned(frame,pmic,true,2000) || calls != 1) return i32(9)
    i32(0)
}
