import "../src/esp32/i2s/clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun i2sControlTarget(port: i32, transmit: bool, source: i32, divider: i32, latch: bool): bool {
    if (latch) return esp32s3I2sLatchConfiguration(int(port), transmit, 1000)
    esp32s3I2sSelectClock(int(port), transmit, int(source), int(divider))
}
#exportFunction("i2sControlTarget", "abla_s3_i2s_control_test")
