import "../src/m5stack/rtc_device.ab"
import "../src/i2c/results.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type I2cDevice = int
var step=0
var failAt=0
var cleanupFail=false
var bad=false
var enabled=false
val scratch=nativeStaticAllocate(4)
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; false }
fun I2cDevice.readRegister8(register: int): int { bad=true; 0 }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; I2cByteResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; false }
fun I2cDevice.readRegister(register: int,bytes: NativeBuffer,count: int): bool { bad=true; false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    step=step+1
    if (this != 7 || mask != 1) bad=true
    if (failAt > 0 && step > failAt) {
        if (step != failAt+1 || register != 211 || value != 0) bad=true
        return !cleanupFail
    }
    if (register != (if (step == 3) 176 else 211) ||
        value != (if (step == 1 || !enabled) 0 else 1) || step == 2) bad=true
    step != failAt
}
trusted fun I2cDevice.writeRegister(register: int,bytes: NativeBuffer,count: int): bool {
    step=step+1
    if (this != 7 || step != 2 || register != 208 || count != 3 ||
        bytes.load(0) != (if (enabled) 59 else 0) ||
        bytes.load(1) != (if (enabled) 23 else 0) ||
        bytes.load(2) != (if (enabled) 31 else 0)) bad=true
    step != failAt
}
@export("abla_powerhub_alarm_test")
trusted fun alarmTest(): i32 {
    val bytes=nativeBufferAt(scratch,4)
    var profile=0
    while (profile < 40) {
        failAt=profile/8; cleanupFail=(profile & 1) != 0; enabled=(profile & 2) != 0
        val facade=(profile & 4) != 0
        step=0; bad=false
        val minute=if (enabled) 59 else -1
        val hour=if (enabled) 23 else -1
        val day=if (enabled) 31 else -1
        val result=if (facade) M5Rtc((3<<32)|7).setAlarmInterruptWithBuffer(bytes,minute,hour,day)
            else PowerHubRtc(7).setAlarmInterruptWithBuffer(bytes,minute,hour,day)
        if (result.status() != (if (failAt == 0) 1 else if (cleanupFail) 5 else 4) ||
            step != (if (failAt == 0) 4 else failAt+1) || bad) return i32(1)
        profile=profile+1
    }
    step=0
    if (PowerHubRtc(0).setAlarmInterruptWithBuffer(bytes).status() != 2 ||
        PowerHubRtc(7).setAlarmInterruptWithBuffer(bytes,0,0,0).status() != 2 ||
        PowerHubRtc(7).setAlarmInterruptWithBuffer(nativeBufferAt(scratch,2)).status() != 2 ||
        PowerHubRtc(7).setAlarmInterruptWithBuffer(bytes,60).status() != 2 ||
        M5Rtc((3<<32)|7).setAlarmInterruptWithBuffer(bytes,-1,-1,-1,6).status() != 6 ||
        M5Rtc((3<<32)|7).setAlarmInterruptWithBuffer(bytes,-1,-1,-1,7).status() != 2 ||
        M5Rtc((3<<32)|7).supportsWeekdayAlarm() || step != 0) return i32(2)
    i32(0)
}
