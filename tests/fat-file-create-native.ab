import "../src/storage/fat_volume_create.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
val image=nativeStaticAllocate(1024)
val text=nativeStaticBytes("new.txt")
val shortName=nativeStaticBytes("NEW     TXT")
val otherName=nativeStaticBytes("OTHER   TXT")
var writes=0
var failAt=0
var bad=false
var boundary=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    if (lba != 0 && lba != 81 && lba != 82) return false
    val source=if (lba == 0) nativeBufferAt(memory+64,512) else nativeBufferAt(image+(lba-81)*512,512)
    var i=0
    while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool {
    writes=writes+1
    if (lba != (if (boundary && writes == 1) 82 else 81)) bad=true
    if (lba != 81 && lba != 82) return false
    val output=nativeBufferAt(image+(lba-81)*512,512);var i=0
    while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return writes != failAt
}
trusted fun shortEntry(directory: NativeBuffer,index: int,name: int): void {
    var byte=0
    while (byte < 32) { directory.store(index*32+byte,0);byte=byte+1 }
    byte=0
    while (byte < 11) { directory.store(index*32+byte,nativeBufferAt(name,11).load(byte));byte=byte+1 }
    directory.store(index*32+11,32);return
}
@export("abla_fat_file_create_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,32);val reader=nativeBufferAt(memory+32,28);val boot=nativeBufferAt(memory+64,512)
    val workspace=nativeBufferAt(memory+640,2624);val scratch=nativeBufferAt(memory+3328,512)
    val directory=nativeBufferAt(image,512);var i=0
    while (i < 512) { boot.store(i,0);i=i+1 }
    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2)
    boot.storeU16(17,32);boot.storeU16(22,40);boot.storeU16(19,10113);boot.storeU16(510,0xaa55)
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    val modified=rtcCalendarDateTime(2026,9,9,12,34,56)
    var scenario=0
    while (scenario < 11) {
        writes=0;bad=false;boundary=scenario >= 4 && scenario <= 6
        failAt=if (scenario == 5) 1 else if (scenario == 6) 2 else 0
        i=0
        while (i < 1024) { nativeBufferAt(image,1024).store(i,77);i=i+1 }
        directory.store(0,0)
        if (scenario == 1 || scenario == 3) {
            if (scenario == 3) { shortEntry(directory,0,otherName);directory.store(0,229) }
            shortEntry(directory,if (scenario == 3) 1 else 0,shortName)
            directory.store(if (scenario == 3) 64 else 32,0)
        }
        if (scenario == 2 || scenario == 7) {
            shortEntry(directory,1,otherName)
            var sum=0;i=0
            while (i < 11) { sum=(((sum&1)<<7)+(sum>>1)+directory.load(32+i))&255;i=i+1 }
            i=0
            while (i < 32) { directory.store(i,0);i=i+1 }
            directory.store(0,65);directory.store(11,15);directory.store(13,sum)
            i=0
            while (i < 13) {
                directory.storeU16(fatLongNameUnitOffset(i),if (i < 7) nativeBufferAt(text,7).load(i) else if (i == 7) 0 else 65535)
                i=i+1
            }
            directory.store(64,0)
            if (scenario == 7) directory.store(32,0)
        }
        if (boundary) {
            i=0
            while (i < 15) { shortEntry(directory,i,otherName);i=i+1 }
            directory.store(480,0)
        }
        if (scenario == 8) { shortEntry(directory,0,otherName);directory.store(0,229);directory.store(32,0) }
        if (scenario >= 9) {
            i=0
            while (i < 32) { shortEntry(nativeBufferAt(image,1024),i,otherName);i=i+1 }
        }
        val volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch)
        val result=volume.createShort(u32(7),0,nativeBufferAt(text,7),7,if (scenario == 10) 1 else 32,modified,workspace)
        val status=if (scenario == 0 || scenario == 4 || scenario == 8) 1 else if (scenario <= 3) 3 else if (scenario <= 6) 8 else if (scenario == 9) 7 else if (scenario == 10) 6 else 5
        if (result.status() != status || bad || writes != (if (scenario == 0 || scenario == 8) 1 else if (scenario == 4 || scenario == 6) 2 else if (scenario == 5) 1 else 0)) return i32(2)
        if (status == 1) {
            val entry=result.entryIndex()*32
            if (result.ordinal() != 0 || result.entryIndex() != (if (boundary) 15 else 0) ||
                directory.loadU32(entry+28) != 0 || directory.loadU16(entry+26) != 0 ||
                directory.loadU32(entry+22) != fatModifiedTimestamp(modified)) return i32(3)
            i=0
            while (i < 11) { if (directory.load(entry+i) != nativeBufferAt(shortName,11).load(i)) return i32(4);i=i+1 }
            if (boundary && (nativeBufferAt(image+512,512).load(0) != 0 || nativeBufferAt(image+512,512).load(1) != 77)) return i32(5)
        }
        if (!volume.invalidate(u32(7))) return i32(6)
        scenario=scenario+1
    }
    return i32(0)
}
