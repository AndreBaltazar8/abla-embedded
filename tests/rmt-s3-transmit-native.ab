import "../src/esp32/rmt_transmit_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var stage = 0
var failStage = 0
var eventReads = 0
var readyAfter = 0
var event = 1
var stopOk = true
var stops = 0
var published = 0
var bad = false
trusted fun nextStage(expected: int): bool { stage = stage + 1; if (stage != expected) bad = true; stage != failStage }
trusted fun esp32s3RmtConfigureSingleBlockTxOwned(channel: int, divider: int): bool = nextStage(1)
trusted fun esp32s3RmtLoadFrameOwned(channel: int, source: NativeBuffer, symbols: int): bool = nextStage(2)
trusted fun esp32s3RmtTxAcknowledge(channel: int, events: int): bool {
    if (stage == 2) { if (events != 15) bad = true; return nextStage(3) }
    if (stage != 4 || events != event) bad = true
    stage = 5; true
}
trusted fun esp32s3RmtTxRequestOwned(channel: int, start: bool): bool {
    if (start) return nextStage(4)
    if (stage != 4) bad = true
    stops = stops + 1; stopOk
}
trusted fun esp32s3RmtTxEvents(channel: int): int { eventReads = eventReads + 1; if (stage != 4) bad = true; if (eventReads > readyAfter) event else 0 }
trusted fun esp32s3RmtPublish(): void { published = published + 1; if (stage != 5) bad = true; return }
trusted fun runTx(): int = esp32s3RmtTransmitFrameOwned(1, 8, nativeBufferAt(4096, 100), 25, 4)
trusted fun rmtTransmitTest(): int {
    failStage = 1
    while (failStage <= 4) {
        stage = 0
        if (runTx() != failStage + 2 || stage != failStage || eventReads != 0 || stops != 0 || bad) return 1
        failStage = failStage + 1
    }
    failStage = 0
    while (readyAfter < 4) {
        stage = 0; eventReads = 0; published = 0
        if (runTx() != 257 || eventReads != readyAfter + 1 || stops != 0 || published != 1 || bad) return 2
        readyAfter = readyAfter + 1
    }
    var variant = 0
    while (variant < 4) {
        stage = 0; eventReads = 0; published = 0; stops = 0
        readyAfter = if (variant < 2) 0 else 4
        event = 3; stopOk = (variant & 1) == 0
        val expected = (if (variant < 2) 775 else 8) | (if (stopOk) 4096 else 8192)
        if (runTx() != expected || eventReads != (if (variant < 2) 1 else 4) || stops != 1 || published != 0 || bad) return 3
        variant = variant + 1
    }
    stage = 0
    if (esp32s3RmtTransmitFrameOwned(4, 8, nativeBufferAt(4096, 100), 25, 4) != 2 || stage != 0) return 4
    0
}
#exportFunction("rmtTransmitTest", "abla_rmt_transmit_test")
