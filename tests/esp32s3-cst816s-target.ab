import "../src/esp32/i2c_esp32s3.ab"
import "../src/touch/cst816s_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_cst816s_target")
trusted fun target(touch: Cst816s,buffer: NativeBuffer,operation: int): int {
    if (operation == 0) return if (touch.begin()) 1 else -1
    if (operation == 1) return touch.readFrame(buffer)
    if (operation == 2) return cst816sPoint(buffer) | 0
    return if (touch.close()) 1 else 0
}
