import "../src/esp32/i2c/prepare_probe_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(128)
var calls=0
var outcome=1
var steal=false
var bad=false
trusted fun c5I2cBusSetup(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int { bad=true; return 7 }
trusted fun c5I2cBusTeardown(sda: int,scl: int): int { bad=true; return 7 }
trusted fun c5I2cBusClear(sda: int,scl: int,budget: u32): bool { bad=true; return false }
trusted fun c5I2cBusTransfer(address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int { bad=true; return 7 }
trusted fun c5I2cBusRecover(sda: int,scl: int,scratch: NativeBuffer): int {
    calls=calls+1
    if (sda != 2 || scl != 3 || scratch.addressValue() != storage+64 ||
        atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(0x80000007)) bad=true
    if (steal) nativeAddressStoreU32(storage,0,0x80000009)
    outcome
}
@export("abla_c5_i2c_prepare_probe_test")
trusted fun probeTest(): i32 {
    val state=esp32C5I2cBusStateAt(nativeBufferAt(storage,64))
    val scratch=nativeBufferAt(storage+64,52)
    var profile=0
    while (profile < 528) {
        val cause=profile%12
        val faulted=profile/12%2 == 1
        outcome=profile/24%11+1
        val stale=profile/264 == 1
        state.initialize(); state.buffer().storeU32(8,2); state.buffer().storeU32(12,1)
        state.buffer().storeU32(16,2); state.buffer().storeU32(20,3); state.buffer().storeU32(48,cause)
        if (faulted) nativeAddressStoreU32(storage,0,0x80000000)
        calls=0; bad=false
        val recovery=faulted && cause == 3 && !stale
        val expected=if (stale) 7 else if (!faulted) 1 else if (recovery) outcome else 10
        if (state.prepareProbeOwned(if (stale) 1 else 2,u32(7),scratch) != expected ||
            calls != (if (recovery) 1 else 0) || bad || state.buffer().loadU32(48) != (if (recovery) outcome else cause)) return i32(1)
        val healthy= !faulted || (recovery && outcome == 1)
        if (atomicU32At(storage).compareExchange(u32(0),u32(0)) != (if (healthy) u32(0) else u32(0x80000000))) return i32(2)
        profile=profile+1
    }
    calls=0
    nativeAddressStoreU32(storage,0,9)
    if (state.prepareProbeOwned(2,u32(7),scratch) != 9 || calls != 0) return i32(3)
    nativeAddressStoreU32(storage,0,0x80000000); state.buffer().storeU32(48,3)
    if (state.prepareProbeOwned(2,u32(7),nativeBufferAt(storage+4,52)) != 7 ||
        state.prepareProbeOwned(2,u32(7),nativeBufferAt(storage+64,51)) != 7 || calls != 0) return i32(4)
    steal=true; outcome=1
    if (state.prepareProbeOwned(2,u32(7),scratch) != 11 || calls != 1 || bad) return i32(5)
    i32(0)
}
