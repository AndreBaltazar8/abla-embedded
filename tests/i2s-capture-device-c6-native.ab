import "./i2s-capture-session-c6-native.ab"
import "../src/esp32/i2s/capture_device_c6_sequence.ab"
trusted fun c6GpioClockRead(at: int): u32 = readRegister(at)
trusted fun c6GpioClockWrite(at: int,v: u32): void = writeRegister(at,v)
trusted fun initialRegister(at: int,value: int): void {
    var index=0
    while (index < entries) {
        if (registers.loadU32(index*12) == at) { registers.storeU32(index*12+4,value);registers.storeU32(index*12+8,value);return }
        index=index+1
    }
    bad=true;return
}
@export("abla_i2s_capture_device_c6_test")
trusted fun testDevice(): i32 {
    val memory=nativeStaticAllocate(2200);val device=nativeBufferAt(memory,452)
    registers=nativeBufferAt(memory+452,1536);descriptors=nativeBufferAt(memory+1988,24)
    channel=0;cancelModel=true
    while (channel < 3) {
        var mode=0
        while (mode < 4) {
            var at=0
            while (at < 452) { device.storeU32(at,0);at=at+4 }
            initialize(nativeBufferAt(memory+96,180));resetCount=0
            seed(0x60080000+channel*16,0);seed(0x6000c00c,0)
            initialRegister(0x60096078,0x803000)
            initialRegister(0x600960e8,0);initialRegister(0x600960ec,0x300000);initialRegister(0x6009162c,0)
            drop=if (mode == 2) 1 else 0;delayed=mode == 3
            val opened=c6CaptureDeviceOpenOwned(device,channel,1,240000000,48000,0,1,2,3,-1,16,16,16,true,0x40800000,2,0x40810000,64,64,1,true,true)
            if (opened != (if (mode == 2) 3 else if (mode == 3) 5 else 1) || bad) return i32(30)
            if (mode == 2) {
                drop=0
                if (c6CaptureDeviceCloseOwned(device,1,true) != 6 || device.loadU32(8) == 0 || starts != 0) return i32(31)
            } else if (mode == 0) {
                if (c6CaptureDeviceCloseOwned(device,1,true) != 2 || c6CaptureDeviceBufferOwned(device,0,true).addressValue() != 0) return i32(32)
                descriptors.storeU32(0,0x40040040);descriptors.storeU32(12,0x40040040)
                setRegister(0x60080000+channel*16,u32(3));setRegister(0x6000c00c,u32(1))
                if (c6CaptureDevicePollOwned(device,2,1,true) != 4 || c6CaptureDeviceBufferOwned(device,0,true).capacity() != 64 ||
                    c6CaptureDeviceCloseOwned(device,1,true) != 6 || c6CaptureDeviceBufferOwned(device,0,true).addressValue() != 0 || resetCount != 1) return i32(33)
            } else {
                if (mode == 3) {
                    if (c6CaptureDeviceCancelOwned(device,2,1,0,false,true) != 5 || starts != 0) return i32(34)
                    delayed=false
                } else {
                    setRegister(0x60080000+channel*16,u32(4));setRegister(0x6000c00c,u32(5))
                    if (c6CaptureDevicePollOwned(device,2,1,true) != 3 || c6CaptureDeviceCancelOwned(device,2,1,0,false,true) != 10 ||
                        c6CaptureDeviceCancelOwned(device,2,1,4,false,true,4) != 9 || resetCount != 1) return i32(35)
                }
                if (c6CaptureDeviceCancelOwned(device,2,1,if (mode == 1) 4 else 0,true,true,if (mode == 1) 4 else 0) != 8 ||
                    c6CaptureDevicePollOwned(device,2,1,true) != 8 || resetCount != (if (mode == 1) 2 else 1)) return i32(36)
            }
            if (bad) return i32(37)
            var index=0
            while (index < entries) {
                if (registers.loadU32(index*12+4) != registers.loadU32(index*12+8)) return i32(38)
                index=index+1
            }
            mode=mode+1
        }
        channel=channel+1
    }
    cancelModel=false;return i32(0)
}
