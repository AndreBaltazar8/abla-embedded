import "../src/esp32/interrupt_dispatcher_compat_esp32_logic.ab"

fun main(): int {
    var number = 0
    while (number < 32) {
        if (esp32DispatcherSupportsInterruptNumber(i32(number)) !=
            esp32XtensaInterruptSupportsNativeHandler(
                xtensaInterrupt(number)
            )) return 1
        if (esp32InterruptDispatcherIndex(i32(number), u32(0)) !=
            u32(number * 2)) return 2
        if (esp32InterruptDispatcherIndex(i32(number), u32(1)) !=
            u32(number * 2 + 1)) return 3
        number = number + 1
    }
    if (esp32DispatcherSupportsInterruptNumber(i32(-1)) ||
        esp32DispatcherSupportsInterruptNumber(i32(32))) return 4
    if (!esp32DispatcherSupportsExceptionNumber(i32(0)) ||
        !esp32DispatcherSupportsExceptionNumber(i32(63)) ||
        esp32DispatcherSupportsExceptionNumber(i32(-1)) ||
        esp32DispatcherSupportsExceptionNumber(i32(64))) return 5
    if (esp32ExceptionDispatcherIndex(i32(63), u32(1)) != u32(127)) {
        return 6
    }
    76
}
