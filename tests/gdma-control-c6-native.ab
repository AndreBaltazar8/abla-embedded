import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/gdma_control_c6_sequence.ab"
var channel=0
var tx=false
var conf=u32(0)
var link=u32(0)
var delay=0
var writes=0
var drop=0
var bad=false
var enabled=true
var fifoEmpty=true
var last=u32(0)
trusted fun c6GdmaBusRead(): u32 = if (enabled) u32(1) else u32(0)
trusted fun c6GdmaBusWrite(value: u32): void { bad=true;return }
trusted fun c6GdmaRead(at: int): u32 {
    if (!enabled) bad=true
    if (at == 0x64) return u32(8)
    val base=0x70+channel*192+(if (tx) 96 else 0)
    if (at == base) return conf
    if (at == base+8) return if (fifoEmpty) u32(2) else u32(0)
    if (at == base+16) {
        if ((link&u32(if (tx) 0x100000 else 0x200000)) != u32(0)) {
            if (delay == 0) link=(link&~u32(if (tx) 0xf00000 else 0x1e00000))|u32(if (tx) 0x800000 else 0x1000000) else delay=delay-1
        }
        return link
    }
    return u32(0)
}
trusted fun c6GdmaWrite(at: int,value: u32): void {
    writes=writes+1;last=value
    if (writes == drop) return
    val base=0x70+channel*192+(if (tx) 96 else 0)
    if (at == base) conf=value
    else if (at == base+16) {
        if ((value&u32(if (tx) 0x600000 else 0xc00000)) != u32(0)) bad=true
        link=value
    } else bad=true
    return
}
@export("abla_gdma_control_c6_test")
trusted fun test(): i32 {
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 1
            var lag=0
            while (lag < 32) {
                var polls=1
                while (polls <= 32) {
                    conf=u32(0);link=u32(if (tx) 0x80600123 else 0x80d00123);delay=lag;writes=0;drop=0
                    var stop=c6GdmaStopBeginOwned(channel,tx,polls,true)
                    if (stop.status() != (if (lag < polls) 1 else 5) || writes != 1 || last != u32(if (tx) 0x80100123 else 0x80300123)) return i32(1)
                    stop=stop.waitOwned(33,true)
                    if (stop.status() != 1 || writes != 1 || bad) return i32(2)
                    fifoEmpty=false
                    stop=stop.waitDrainedOwned(1,true)
                    if (stop.status() != 6 || writes != 1) return i32(9)
                    fifoEmpty=true
                    if (stop.waitDrainedOwned(1,true).status() != 1 || writes != 1) return i32(10)
                    polls=polls+1
                }
                lag=lag+1
            }
            link=u32(0);writes=0;drop=1
            var stop=c6GdmaStopBeginOwned(channel,tx,1,true)
            if (stop.status() != 5 || stop.waitOwned(2,true).status() != 5 || writes != 1) return i32(3)
            enabled=false
            if (stop.waitOwned(1,true).status() != 3 || writes != 1) return i32(4)
            enabled=true;drop=0
            if (c6GdmaResetOwned(channel,tx,true,true,false) != 4 || writes != 1) return i32(5)
            link=u32(if (tx) 0x800000 else 0x1000000)
            var fault=0
            while (fault < 3) {
                conf=u32(0x80000000);writes=0;drop=fault
                val result=c6GdmaResetOwned(channel,tx,true,true,false)
                if (result != (if (fault == 2) 5 else 1) || writes != 2) return i32(6)
                drop=0
                if (c6GdmaResetOwned(channel,tx,true,false,true) != 1 || conf != u32(0x80000000) || bad) return i32(7)
                fault=fault+1
            }
            writes=0
            if (c6GdmaResetOwned(channel,tx,true,false,false) != 2 || c6GdmaStopBeginOwned(3,tx,1,true).status() != 2 || writes != 0) return i32(8)
            direction=direction+1
        }
        channel=channel+1
    }
    return i32(0)
}
