import "./pm1-control-wire-native.ab"
import "../src/imu/mpu6886_device.ab"
import "../src/imu/sh200q_device.ab"
import "../src/imu/bmi270_device.ab"
import "../src/imu/bmm150_device.ab"
import "../src/imu/ak8963_device.ab"
trusted fun imuDelay(ticks: int): void { bad=true;return }
@export("abla_imu_handle_wire_test")
trusted fun testImuHandles(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    if (!device.valid()) return i32(1)
    val handle=device|0
    var sample=0
    while (sample < 36) {
        val raw=if (sample == 0) 0 else if (sample == 1) -1 else if (sample == 2) 4294967296 else if (sample == 3) -9223372036854775807-1 else handle|(1<<(sample+28))
        val a=Mpu6886(raw);val b=Sh200q(raw);val c=Bmi270(raw);val d=Bmm150(raw);val e=Ak8963(raw)
        val before=ackCount
        if (a.valid() || b.valid() || c.valid() || d.valid() || e.valid() || (a.device()|0) != 0 || (b.device()|0) != 0 || (c.device()|0) != 0 || (d.device()|0) != 0 || (e.device()|0) != 0) return i32(2)
        if (a.begin() != 0 || b.begin() != 0 || c.begin() != 0 || d.begin() != 0 || e.begin() != 0 || c.uploadConfiguration()) return i32(3)
        if (a.readAccelerationRaw().valid() || b.readAccelerationRaw().valid() || c.readAccelerationRaw().valid() || d.readMagneticFieldRaw().valid() || e.readMagneticFieldRaw().valid()) return i32(4)
        if (a.whoAmI() != 0 || b.whoAmI() != 0 || c.whoAmI() != 0 || d.whoAmI() != 0 || e.whoAmI() != 0 || a.close() || b.close() || c.close() || d.close() || e.close() || ackCount != before || bad) return i32(5)
        if (!device.writeRegister8(200,sample)) return i32(6)
        sample=sample+1
    }
    if (!Mpu6886(handle).valid() || !Sh200q(handle).valid() || !Bmi270(handle).valid() || !Bmm150(handle).valid() || !Ak8963(handle).valid() || !device.close() || !bus.close() || bad) return i32(7)
    return i32(0)
}
