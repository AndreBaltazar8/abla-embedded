import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/cores3_playback.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun playbackTarget(amplifier: u32, expander: u32, descriptors: u32,
    buffers: u32, source: u32, staging: u32, owner: u32): int {
    val result = cores3PlaybackBlocks(Aw88298(int(amplifier)), Aw9523(int(expander)),
        2, int(descriptors), int(buffers), nativeBufferAt(int(source), 64320),
        67, nativeBufferAt(int(staging), 960), owner, 1000)
    result.status() | (result.bytes() << 8) | (result.dmaStatus() << 32) |
        (result.amplifierStatus() << 48)
}
#exportFunction("playbackTarget", "abla_s3_playback_test")
