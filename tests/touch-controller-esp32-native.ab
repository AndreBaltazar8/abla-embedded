import "../src/esp32/touch/controller_esp32_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val regs=nativeBufferAt(nativeStaticAllocate(16),16)
var writes=0
var reads=0
var drop=-1
var bad=false
var timer=u32(0)
var irq=u32(0)
fun touchScanRead(address: int): u32 {
    reads=reads+1
    if (address == 0x3FF48018) return timer
    if (address == 0x3FF4803C) return irq
    var i=0
    while (i < 4) { if (address == esp32TouchControllerAddress(i)) return u32(regs.loadU32(i*4)); i=i+1 }
    bad=true; u32(0)
}
fun touchScanWrite(address: int,value: u32): void {
    val n=writes; writes=writes+1
    if (n == drop) return
    var i=0
    while (i < 4) {
        if (address == esp32TouchControllerAddress(i)) {
            if (i == 1 && (value&u32(0x40001000)) != u32(0)) bad=true
            regs.storeU32(i*4,int(value)); return
        }
        i=i+1
    }
    bad=true; return
}
@export("abla_touch_controller_esp32_test")
fun controllerTest(): i32 {
    val record=nativeBufferAt(nativeStaticAllocate(24),24)
    var mode=0
    while (mode < 256) {
        var fault=-1
        while (fault < 8) {
            regs.storeU32(0,0x84050607); regs.storeU32(4,0x12342800); regs.storeU32(8,0xA5A55A5A); regs.storeU32(12,0x98765432)
            record.storeU32(0,0); timer=u32(0); irq=u32(0); writes=0; reads=0; drop=fault; bad=false
            val high=mode&15
            val low=(mode>>4)&3
            val above=(mode&64)!=0
            val both=(mode&128)!=0
            val opened=esp32TouchControllerOpenOwned(record,144,mode,40000,48,high,low,above,both,true)
            if (opened != 1 && opened != 3) return i32(1)
            if (record.loadU32(0) != 0x54434831 || record.loadU32(8) != 0x84050607 || record.loadU32(12) != 0x12342800 ||
                record.loadU32(16) != 0xA5A55A5A || record.loadU32(20) != 0x98765432) return i32(2)
            if (fault == -1) {
                if (opened != 1 || regs.loadU32(0) != (0x84000000|40000|(mode<<16)|(if (above) 0x1000000 else 0)|(if (both) 0 else 0x2000000)) ||
                    regs.loadU32(4) != ((48<<14)|0x2800) || regs.loadU32(8) != ((0xA5A55A5A&0x81FFFFFF)|((high%4)<<29)|((high/4)<<25)|(low<<27)) ||
                    regs.loadU32(12) != ((0x98765432&~1023)|144)) return i32(3)
            }
            val before=writes
            if (esp32TouchControllerOpenOwned(record,144,1,1,1,7,0,false,true,true) != 2 ||
                esp32TouchControllerCloseOwned(record,false) != 2 || writes != before) return i32(4)
            val closed=esp32TouchControllerCloseOwned(record,true)
            if (closed != 1 && closed != 3) return i32(5)
            if (closed == 3) {
                if (record.loadU32(0) != 0x54434831) return i32(6)
                drop=-1
                if (esp32TouchControllerCloseOwned(record,true) != 1) return i32(7)
            }
            if (bad || record.loadU32(0) != 0 || regs.loadU32(0) != 0x84050607 || regs.loadU32(4) != 0x12342800 ||
                regs.loadU32(8) != 0xA5A55A5A || regs.loadU32(12) != 0x98765432) return i32(8)
            fault=fault+1
        }
        mode=mode+1
    }
    reads=0; writes=0
    if (esp32TouchControllerOpenOwned(record,0,0,1,0,0,0,false,true,true) != 2 ||
        esp32TouchControllerOpenOwned(record,1,256,1,0,0,0,false,true,true) != 2 ||
        esp32TouchControllerOpenOwned(record,1,0,0,0,0,0,false,true,true) != 2 ||
        esp32TouchControllerOpenOwned(record,1,0,1,0,16,0,false,true,true) != 2 || reads != 0 || writes != 0) return i32(9)
    timer=u32(0x800000)
    if (esp32TouchControllerOpenOwned(record,1,0,1,0,7,0,false,true,true) != 2 || writes != 0 || record.loadU32(0) != 0) return i32(10)
    timer=u32(0); irq=u32(64)
    if (esp32TouchControllerOpenOwned(record,1,0,1,0,7,0,false,true,true) != 2 || writes != 0 || record.loadU32(0) != 0) return i32(11)
    i32(0)
}
