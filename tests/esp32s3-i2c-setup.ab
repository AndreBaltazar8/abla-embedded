import "../src/esp32/i2c/setup_esp32s3.ab"

trusted fun main(): int {
    if (esp32S3I2cResetClockedControllerLocked(-1) || esp32S3I2cResetClockedControllerLocked(2)) return 1
    if (esp32S3I2cSetupMaster(2, 4, 5, u32(40000000), u32(100000))) return 2
    if (esp32S3I2cSetupMaster(0, 4, 4, u32(40000000), u32(100000))) return 3
    if (esp32S3I2cSetupMaster(0, 22, 5, u32(40000000), u32(100000))) return 4
    if (esp32S3I2cSetupMaster(0, 4, 5, u32(40000000), u32(0))) return 5
    if (esp32S3I2cSetupMaster(0, 4, 5, u32(40000000), u32(100000), true, 16)) return 6
    0
}
