import "../src/m5stack/button_touch_frame.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_button_touch_merge_test")
fun mergeTest(): i32 {
    var bits=0
    while (bits < 1024) {
        val physical=M5ButtonFrame(u32(bits))
        if (physical.withTouch(M5TouchButtons(0)) != physical) return i32(1)
        var mask=0
        while (mask < 8) {
            var pressed=0
            while (pressed < 8) {
                if ((pressed&~mask) == 0) {
                    val merged=physical.withTouch(M5TouchButtons(256|(mask<<4)|pressed))
                    var index=0
                    while (index < 5) {
                        val bit=1<<index
                        val controlled=(mask&bit) != 0
                        val wasValid=(bits&(bit<<5)) != 0
                        val wasPressed=wasValid && (bits&bit) != 0
                        if (merged.read(index).valid() != (controlled || wasValid) ||
                            merged.read(index).pressed() != (wasPressed || ((pressed&bit) != 0))) return i32(2)
                        index=index+1
                    }
                }
                pressed=pressed+1
            }
            mask=mask+1
        }
        bits=bits+1
    }
    i32(0)
}
