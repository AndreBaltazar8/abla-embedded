import "../src/esp32/wifi/ioctl_recovered_esp32.ab"
import "../src/esp32/wifi/ioctl_link_esp32.ab"
import "../src/xtensa/assembly.ab"
import "abla/build"

// Stands in for an opaque vendor caller: internalFunction binds a link name
// only when something reachable references it, so this exported adapter's
// assembly references the names the check expects to be bound.
@naked
trusted fun ioctlOpaqueCallerProbe(): void = xtensaAssemblyVoid(
    "entry\ta1, 32\nmovi a8, ieee80211_ioctl\ncallx8\ta8\nmovi a8, wifi_set_config_process\ncallx8\ta8\nretw.n",
    "~{memory}"
)

val linked = #esp32Idf6LinkIoctlOpaqueCallers()
val probed = #exportFunction("ioctlOpaqueCallerProbe", "abla_test_ioctl_opaque_caller")

fun main: int = if (linked && probed) 0 else 1
