import "../src/power/m5pm1_device.ab"
import "../src/i2c/register_access.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
fun I2cBus.valid(): bool = false
fun I2cBus.device(address: int,frequency: int): I2cDevice = I2cDevice(0)
fun I2cDevice.close(): bool = false
trusted fun I2cDevice.readRegister(register: int,bytes: NativeBuffer,count: int): bool = false
trusted fun I2cDevice.writeRegister(register: int,bytes: NativeBuffer,count: int): bool = false
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
var calls=0
var failures=0
var irqOnly=false
var bad=false
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    val slot=calls+(if (irqOnly) 1 else 0)
    if (this != 7 || register != (if (slot == 0) 5 else 63+slot) || value != 0) bad=true
    calls=calls+1
    (failures&(1<<slot)) == 0
}
@export("abla_pm1_wake_clear_test")
trusted fun test(): i32 {
    while (failures < 16) {
        calls=0;irqOnly=false
        if (M5Pm1(7).clearWakeInterruptChecked() != (256|(15^failures)) || calls != 4 || bad) return i32(1)
        calls=0;irqOnly=true
        if (M5Pm1(7).clearIrqStatus() != ((failures&14) == 0) || calls != 3 || bad) return i32(2)
        failures=failures+1
    }
    calls=0
    if (M5Pm1(0).clearWakeInterruptChecked() != 0 || M5Pm1(0).clearIrqStatus() || calls != 0) return i32(3)
    return i32(0)
}
