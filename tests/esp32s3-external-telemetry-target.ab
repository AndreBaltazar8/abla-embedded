import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/external_telemetry.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_external_telemetry_target")
trusted fun telemetryTarget(pm1: M5Pm1,monitor: Ina226,board: M5BoardId,ports: int,current: bool): int {
    if (board == m5BoardStampPLC) return (if (current) monitor.externalMilliampsChecked(board,ports) else monitor.externalMillivoltsChecked(board,ports)) | 0
    (if (current) pm1.externalMilliampsChecked(board,ports) else pm1.externalMillivoltsChecked(board,ports)) | 0
}
