import "../src/esp32/i2c_esp32s3.ab"
import "../src/power/axp192_device.ab"
import "../src/power/axp2101_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_power_key_target")
trusted fun keyTarget(device: int,newer: bool): PowerKeyEvent =
    if (newer) Axp2101(device).powerKeyPressChecked() else Axp192(device).powerKeyPressChecked()
