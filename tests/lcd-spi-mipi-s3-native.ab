import "../src/display/spi_mipi_sequence_esp32s3.ab"
import "../src/esp32/spi/buffer_sequence_esp32s3.ab"
import "../src/spi/pins.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
val gateStorage = nativeStaticMutableU32s([0,0,0,0])
val baseAddress = nativeStaticBytes("\x11\x00\xff\xff")
val extraAddress = nativeStaticBytes("\x29\x00\xff\xff")
var stage = 0
var failAt = -1
var bad = false
var rotation = 0
var bgr = false
var inverted = false
var extra = true
fun esp32s3SpiCommandPinsValid(peripheral: int, pins: SpiPins, select: Pin, dc: Pin, shared: bool): bool =
    peripheral == 2 && pins == spiPins(37,35,36) && select == 3 && dc == 35 && shared
trusted fun esp32s3SpiRead(address: int): int { bad = true; 0 }
trusted fun esp32s3SpiWrite(address: int, value: int): void { bad = true; return }
trusted fun nextStage(expected: int): int {
    if (nativeAddressLoadU32(gateStorage, 0) != 41 || stage != expected) bad = true
    stage = stage + 1
    if (expected == failAt) 0x20109 else 257
}
trusted fun esp32s3LcdRunProgramOwned(peripheral: int, select: Pin, dc: Pin,
    program: NativeBuffer, length: int, shared: bool): int {
    if (length != 4 || program.addressValue() != (if (stage == 0) baseAddress else extraAddress)) bad = true
    nextStage(if (program.addressValue() == baseAddress) 0 else 1)
}
trusted fun esp32s3SpiCommandWordOwned(peripheral: int, select: Pin, dc: Pin,
    command: int, value: u32, bytes: int, shared: bool): int {
    if (bytes != 1 || (command != 58 && command != 54) ||
        value != (if (command == 58) u32(85) else u32(lcdGeometry(320,240).view(rotation,bgr).madctl()))) bad = true
    nextStage((if (extra) 2 else 1) + (if (command == 58) 0 else 1))
}
trusted fun esp32s3SpiCommandOwned(peripheral: int, select: Pin, dc: Pin,
    command: int, data: NativeBuffer, bytes: int, shared: bool): int {
    if (bytes != 0 || command != (if (inverted) 33 else 32)) bad = true
    nextStage(if (extra) 4 else 3)
}
trusted fun resetMipi(): void { nativeAddressStoreU32(gateStorage, 0, 0); stage = 0; bad = false; return }
trusted fun runMipi(program: NativeBuffer, extraProgram: NativeBuffer): SpiTransactionResult =
    esp32s3LcdBeginRgb565(peripheralGateAt(gateStorage), u32(41), 2, spiPins(37,35,36),
        Pin(3), Pin(35), lcdGeometry(320,240), rotation, program, extraProgram, inverted, bgr, true)
trusted fun lcdSpiMipiTest(): int {
    val program = nativeBufferAt(baseAddress, 4)
    var variant = 0
    while (variant < 64) {
        rotation = variant & 7; bgr = (variant & 8) != 0
        inverted = (variant & 16) != 0; extra = (variant & 32) != 0
        val extension = if (extra) nativeBufferAt(extraAddress, 4) else nativeBufferAt(0,0)
        failAt = -1
        while (failAt < (if (extra) 5 else 4)) {
            resetMipi()
            val result = runMipi(program, extension)
            if (bad || result.status() != (if (failAt < 0) 1 else 6) ||
                stage != (if (failAt < 0) (if (extra) 5 else 4) else failAt + 1) ||
                nativeAddressLoadU32(gateStorage,0) != (if (failAt < 0) 0 else 0x80000000)) return 1
            if (failAt >= 0 && result.value() != u32(0x20109)) return 2
            failAt = failAt + 1
        }
        variant = variant + 1
    }
    resetMipi()
    if (runMipi(program, nativeBufferAt(extraAddress, 3)).status() != 3 || stage != 0 ||
        nativeAddressLoadU32(gateStorage,0) != 0) return 3
    if (runMipi(nativeBufferAt(baseAddress,3), nativeBufferAt(0,0)).status() != 3 || stage != 0) return 4
    nativeAddressStoreU32(gateStorage,0,42)
    if (runMipi(program,nativeBufferAt(0,0)).status() != 2 || stage != 0 ||
        nativeAddressLoadU32(gateStorage,0) != 42) return 5
    0
}
#exportFunction("lcdSpiMipiTest", "abla_lcd_spi_mipi_test")
