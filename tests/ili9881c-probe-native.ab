import "../src/display/ili9881c_probe_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(18)
var step=0
var fail=0
var revision=0
var mismatch=false
var bad=false
fun p4DsiRead(offset: int): u32 = u32(0)
fun p4DsiWrite(offset: int,value: u32): void { return }
trusted fun ili9881cDsiWrite(channel: int,payload: NativeBuffer,polls: int): DsiCommandResult {
    step=step+1
    if (channel != 2 || polls != 7 || (step != 1 && step != 5) ||
        payload.load(0) != 255 || payload.load(1) != 152 || payload.load(2) != 129 ||
        payload.load(3) != (if (step == 1) 1 else 0)) bad=true
    DsiCommandResult(if (step == fail) 53 | (1 << 32) else 49)
}
trusted fun ili9881cDsiRead(channel: int,command: int,reply: NativeBuffer,polls: int): DsiCommandResult {
    step=step+1
    if (channel != 2 || polls != 7 || command != step-2) bad=true
    reply.store(0,if (command == 0) (if (mismatch) 0 else 152) else if (command == 1) 129 else revision)
    DsiCommandResult(if (step == fail) 91 | (1 << 32) else 81)
}
@export("abla_ili9881c_probe_test")
trusted fun testProbe(): i32 {
    val whole=nativeBufferAt(storage,18)
    val scratch=nativeBufferAt(storage+1,16)
    whole.store(0,123); whole.store(17,234)
    while (revision < 256) {
        step=0
        val result=ili9881cProbeOwned(2,scratch,7)
        if (!result.matched() || result.identity() != (33176 | (revision << 16)) || step != 5 || bad) return i32(1)
        revision=revision+1
    }
    mismatch=true; step=0
    if (ili9881cProbeOwned(2,scratch,7).status() != 2 || step != 5) return i32(2)
    fail=1
    while (fail <= 5) {
        step=0
        val result=ili9881cProbeOwned(2,scratch,7)
        if (!result.recoveryRequired() || result.failedStep() != fail || step != fail ||
            scratch.load(12) != 1 || scratch.load(8) != (if (fail == 1 || fail == 5) 53 else 91)) return i32(3)
        fail=fail+1
    }
    step=0
    if (ili9881cProbeOwned(4,scratch,7).status() != 0 ||
        ili9881cProbeOwned(2,nativeBufferAt(storage+1,15),7).status() != 0 ||
        ili9881cProbeOwned(2,scratch,0).status() != 0 || step != 0 || bad) return i32(4)
    if (whole.load(0) != 123 || whole.load(17) != 234) return i32(5)
    i32(0)
}
