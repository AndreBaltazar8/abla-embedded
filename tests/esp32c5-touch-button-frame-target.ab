import "../src/m5stack/touch_button_frame.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_touch_button_frame_target")
trusted fun frameTarget(board: M5BoardId,tracker: TouchTracker,raw: NativeBuffer,count: int,time: int,previous: int,ratio: int): M5TouchButtons =
    board.touchButtonsFromFrame(tracker,raw,count,time,previous,ratio)
