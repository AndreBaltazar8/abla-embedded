import "../src/esp32/mspi_clock_state_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var flash=0
var ram=0
var reads=0
var writes=0
var bad=false
fun esp32S3MspiClockRead(address: int): int {
    reads=reads+1
    if (address == 0x600030EC) return core
    if (address == 0x60003014) return flash
    if (address == 0x60003050) return ram
    bad=true
    0
}
fun esp32S3MspiClockUpdate(address: int,mask: int,value: int): void {
    if (writes == 0 && address == 0x600030EC && mask == 3) core=(core & ~mask) | value
    else if (writes == 1 && address == 0x60003014 && mask == 0x80FFFFFF) flash=(flash & ~mask) | value
    else if (writes == 2 && address == 0x60003050 && mask == 0x80FFFFFF) ram=(ram & ~mask) | value
    else bad=true
    if ((value & ~mask) != 0) bad=true
    writes=writes+1
    return
}
@export("abla_mspi_clock_state_test")
trusted fun clockStateTest(): i32 {
    var variant=0
    while (variant < 8) {
        var bit=0
        while (bit < 33) {
            val initial=if (bit == 32) 0xFFFFFFFF else 1<<bit
            core=0xABCDEF00 | (variant & 3); flash=initial; ram=initial ^ 0xFFFFFFFF
            val ramBefore=ram
            val withRam=variant >= 4
            reads=0; writes=0; bad=false
            val saved=esp32S3MspiClockCaptureOwned(withRam)
            if (!saved.valid() || bad || reads != (if (withRam) 3 else 2)) return i32(1)
            core=0x12345678; flash=0x55000000; ram=0x2A000000
            if (!esp32S3MspiClockRestoreOwned(saved) || bad || writes != (if (withRam) 3 else 2) ||
                core != (0x12345678 | (variant & 3)) || flash != (0x55000000 | (initial & 0x80FFFFFF)) ||
                ram != (if (withRam) 0x2A000000 | (ramBefore & 0x80FFFFFF) else 0x2A000000)) return i32(2)
            bit=bit+1
        }
        variant=variant+1
    }
    writes=0
    if (esp32S3MspiClockRestoreOwned(Esp32S3MspiClockState(0)) || writes != 0) return i32(3)
    i32(0)
}
