import "../src/display/epd_waveform.ab"
import "abla/build"
// Independently generated full 256-pair action checksums from upstream LUT_MAKE
// columns. Also test individual wire ordering and current/queued transitions.
val waveformHashes=nativeStaticU32s([3983746640,1181409664,2166562560,0,187965424,1444375040,1444375040,722187520,722187520,1810607952,1907313888,2463704880,640105152,1654682704,1654682704,3653816080,1027753856,915939904,3763047952,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,0,3705290160,3705290160,3705290160,2269219168,1527711504,1701632624,2783366256,3469064064,2887144128,3530690832,399133216,2435410896,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,2166562560,0,2183117840,2183117840,4006862352,4006862352,4006862352,4006862352,4006862352,4006862352,2166562560,0,2183117840,4006862352,4006862352,4006862352,4006862352,2166562560,0])
val waveformState=nativeStaticAllocate(1920)
val waveformOutput=nativeStaticAllocate(248)
val waveformGray=nativeStaticAllocate(480)
@export("abla_epd_waveform_test")
fun testWaveform(): int {
    val state=nativeBufferAt(waveformState,1920)
    val output=nativeBufferAt(waveformOutput,248)
    val gray=nativeBufferAt(waveformGray,480)
    var row=0
    while (row < 85) {
        var checksum=0
        var value=0
        while (value < 256) {
            checksum=(checksum*33+epdWaveformAction(row*256+value))&4294967295
            value=value+1
        }
        if (checksum != nativeAddressLoadU32(waveformHashes,row*4)) return 1
        row=row+1
    }
    if (epdWaveformAction(21760) != -1 || epdWaveformAction(65536) != -1 || epdWaveformAction(0x8888) != 0) return 2
    var mode=1
    while (mode <= 4) {
        var value=0
        while (value < 256) {
            if (!epdWaveformInitialize(state,960,true)) return 3
            var index=0
            while (index < 480) { gray.store(index,value);index=index+1 }
            if (!epdWaveformUpdateOwned(state,gray,480,mode,true)) return 4
            val request=epdWaveformOffset(mode)*256+value
            val expected=if (mode >= 3) ((request+32768)<<16)|request else (request<<16)|136
            if (state.loadU32(0) != expected || state.loadU32(1916) != expected) return 5
            var frames=0
            var result=1
            while (result == 1 && frames < 40) {
                val before=state.loadU32(0)
                val current=before&65535
                val action=epdWaveformAction(current)
                val expectedByte=(action<<4)|action
                result=epdWaveformRenderOwned(state,output,960,8,true)
                if (result < 0 || output.load(0) != expectedByte || output.load(239) != expectedByte) return 6
                if (output.loadU32(240) != 0 || output.loadU32(244) != 0) return 7
                val queued=before>>>16
                val next=if ((current&32768) != 0) before else if (action == 0) ((queued|32768)<<16)|queued else (queued<<16)|(current+256)
                if (state.loadU32(0) != next || state.loadU32(1916) != next) return 8
                if (result != (if ((current&32768) != 0) 0 else 1)) return 9
                frames=frames+1
            }
            if (result != 0 || (state.loadU32(0)&32768) == 0) return 10
            // Once completed, text black refreshes through eraser, text white
            // stays idle, quality refreshes, fast unchanged requests stay idle.
            val completed=state.loadU32(0)
            val again=epdWaveformRequest(completed,value,mode)
            if ((mode >= 3 || (mode == 2 && value == 255)) && again != completed) return 11
            if ((mode == 1 || (mode == 2 && value != 255)) && (again&65535) != value) return 12
            // A new quality/text request must not restart an existing eraser.
            if (mode < 3 && (epdWaveformRequest((request<<16)|700,value^255,mode)&65535) != 700) return 13
            value=value+1
        }
        mode=mode+1
    }
    // Eight distinct pair nibbles verify little-endian byte/pair order.
    var index=0
    while (index < 8) { state.storeU32(index*4,(0x8888<<16)|(index*29));index=index+1 }
    if (epdWaveformRenderOwned(state,output,16,8,true) != 1) return 14
    index=0
    while (index < 4) {
        if (output.load(index) != ((epdWaveformAction(index*58)<<4)|epdWaveformAction((index*2+1)*29))) return 15
        index=index+1
    }
    // Invalid final pair must not mutate an earlier valid pair or output.
    state.storeU32(0,0x88880000);state.storeU32(28,21760)
    output.storeU32(0,123456)
    if (epdWaveformRenderOwned(state,output,16,0,true) != -1 || state.loadU32(0) != 0x88880000 || output.loadU32(0) != 123456) return 16
    if (epdWaveformUpdateOwned(state,gray,8,1,true) || state.loadU32(0) != 0x88880000) return 17
    if (epdWaveformRenderOwned(state,state,16,0,true) != -1 || epdWaveformRenderOwned(state,output,17,0,true) != -1 ||
        epdWaveformRenderOwned(state,output,960,9,true) != -1 || epdWaveformRenderOwned(state,output,16,0,false) != -1 ||
        epdWaveformUpdateOwned(state,state,8,1,true) || epdWaveformInitialize(state,960,false)) return 18
    return 0
}
