import "../src/esp32/scheduler_run_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var storage=nativeBufferAt(0,0)
var core=0
var status=0x4002F
var busy=false
var releaseOK=true
var selected=1
var phase=0
var bad=false
fun xtensaGuardCore(): int = core
fun xtensaGuardStatus(): int = status
fun xtensaGuardMaskLocal(): int { val previous=status; status=status | 15; previous }
fun xtensaGuardRestoreLevel(level: int): void { status=(status & ~15) | (level & 15); return }
fun esp32S3SchedulerRunCore(): int = core
fun esp32S3SchedulerRunStatus(): int = status
trusted fun esp32S3SchedulerRunRead(address: int): int = storage.loadU32(address-0x3FC90000)
trusted fun esp32S3SchedulerRunWrite(address: int,value: int): void { storage.storeU32(address-0x3FC90000,value); return }
fun esp32S3SchedulerRunLock(lock: NativeBuffer): XtensaInterruptGuard {
    if (phase != 0 || lock.addressValue() != 0x3FC91000 || status != 0x4002F) bad=true
    if (busy) return XtensaInterruptGuard(0)
    phase=1; XtensaInterruptGuard(47+core*16)
}
fun esp32S3SchedulerRunUnlock(lock: NativeBuffer,guard: XtensaInterruptGuard): bool {
    if (phase != 2 || lock.addressValue() != 0x3FC91000 || !guard.valid() || guard.core() != core || guard.previousLevel() != 15) bad=true
    phase=3; releaseOK
}
fun esp32S3SchedulerRunSelect(queue: NativeBuffer,records: NativeBuffer,running: NativeBuffer,current: NativeBuffer,owners: NativeBuffer,frame: NativeBuffer,c: int,level: int): int {
    if (phase != 1 || queue.addressValue() != 0x3FC92000 || queue.capacity() != 32 ||
        records.addressValue() != 0x3FC92100 || records.capacity() != 64 || running.addressValue() != 0x3FC92200 ||
        current.addressValue() != 0x3FC92210 || owners.addressValue() != 0x3FC92220 ||
        frame.addressValue() != 0x3FC93000 || c != core || level != 2) bad=true
    phase=2; selected
}
@export("abla_scheduler_run_test")
trusted fun runTest(): i32 {
    storage=nativeBufferAt(nativeStaticAllocate(44),44)
    val context=nativeBufferAt(0x3FC90000,44)
    val frame=nativeBufferAt(0x3FC93000,192)
    var profile=0
    while (profile < 12) {
        core=profile & 1; status=0x4002F; phase=0; bad=false; busy=false; releaseOK=true
        storage.storeU32(0,0x3FC91000); storage.storeU32(4,0x3FC92000); storage.storeU32(8,32)
        storage.storeU32(12,0x3FC92100); storage.storeU32(16,64); storage.storeU32(20,0x3FC92200)
        storage.storeU32(24,0x3FC92210); storage.storeU32(28,0x3FC92220)
        storage.storeU32(32,0); storage.storeU32(36,0); storage.storeU32(40,core)
        if (esp32S3SchedulerRunOwned(context,frame,core,2) != 0 || phase != 0) return i32(1)
        if (!esp32S3SchedulerRequestOwned(context) || storage.loadU32(32) != 1) return i32(2)
        busy=true
        if (esp32S3SchedulerRunOwned(context,frame,core,2) != 2 || phase != 0 || storage.loadU32(32) != 1) return i32(3)
        busy=false; selected=profile/2-4
        if (esp32S3SchedulerRunOwned(context,frame,core,2) != selected || bad || phase != 3 ||
            storage.loadU32(36) != (selected & 0xFFFFFFFF) || storage.loadU32(32) != (if (selected < 0) 1 else 0)) return i32(4)
        phase=0; releaseOK=false
        if (!esp32S3SchedulerRequestOwned(context) || esp32S3SchedulerRunOwned(context,frame,core,2) != -7 ||
            storage.loadU32(36) != 0xFFFFFFF9 || bad) return i32(5)
        phase=0; status=0x4002E
        if (esp32S3SchedulerRunOwned(context,frame,core,2) != -6 || phase != 0) return i32(6)
        storage.storeU32(40,core ^ 1)
        if (esp32S3SchedulerRequestOwned(context)) return i32(7)
        profile=profile+1
    }
    i32(0)
}
