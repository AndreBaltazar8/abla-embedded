import "../src/sd/block_c61_sequence.ab"
import "../src/sd/selected_command_c61_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
var sda=0
var scl=1
var writes=0
var drop=0
var fault=0
var bad=false
fun offset(address: int): int = if (address >= 0x60090000 && address < 0x60090078) address-0x60090000 else
    if (address >= 0x60091000 && address < 0x60091b4c) 256+address-0x60091000 else -1
fun c61GpioRead(address: int): u32 {
    if (address == 0x600960c0) return if (fault == 1) u32(3) else apb
    if (address == 0x600960c4) return if (fault == 2) u32(0) else functional
    if (address == 0x60091df8) return gpio
    if (address == 0x600b102c) return if (fault == 4) u32(1)<<u32(scl) else u32(0)
    if (address == 0x600b1028) return if (fault == 5) u32(127) else u32(0)
    if (address == 0x6000f018) return if (fault == 6) u32(16384) else u32(0)
    if (address == 0x60091064) return if (fault == 7) u32(0) else u32(0xffffffff)
    val at=offset(address)
    if (at < 0 || (at&3) != 0) { bad=true;return u32(0) }
    return u32(nativeBufferAt(memory,4096).loadU32(at))
}
fun c61GpioWrite(address: int,value: u32): void {
    writes=writes+1
    var at=offset(address);var wanted=value
    if (address == 0x60091008 || address == 0x60091038) { at=at-4;wanted=u32(nativeAddressLoadU32(memory,at))|value }
    else if (address == 0x6009100c || address == 0x6009103c) { at=at-8;wanted=u32(nativeAddressLoadU32(memory,at))&(u32(0xffffffff)^value) }
    if (at < 0 || at >= 4096 || (at&3) != 0) { bad=true;return }
    if (writes != drop) nativeAddressStoreU32(memory,at,int(wanted))
    return
}
fun seed(): void {
    var at=0
    while (at < 4096) { nativeAddressStoreU32(memory,at,0);at=at+4 }
    writes=0;drop=0;fault=0;bad=false;return
}



val spi=nativeStaticAllocate(256)
var bus=u32(4)
var spiFunctional=u32(0x100000)
var spiWrites=0
var spiDrop=0
var pending=0
var stall=false
var active=false
fun c61SpiRead(address: int): u32 {
    if (address == 0x60096094) return bus
    if (address == 0x60096098) return spiFunctional
    if (address == 0x60081000) {
        if (active) return u32(1<<24)
        if (pending > 0) { if (!stall) pending=pending-1;return u32(1<<23) }
        return u32(0)
    }
    return u32(nativeAddressLoadU32(spi,address-0x60081000))
}
fun c61SpiWrite(address: int,value: u32): void {
    spiWrites=spiWrites+1
    if (spiWrites == spiDrop) return
    if (address == 0x60096094) { bus=value;return }
    if (address == 0x60096098) { spiFunctional=value;return }
    if (address == 0x60081000) {
        if (value == u32(1<<23)) { pending=1;return }
        if (value != u32(1<<24)) { bad=true;return }
        starts=starts+1
        if (nativeAddressLoadU32(spi,28) != 7 || nativeAddressLoadU32(spi,152) > 255) bad=true
        if (starts == failAt && failureKind == 1) { active=true;return }
        val received=cardExchange(nativeAddressLoadU32(spi,152))
        nativeAddressStoreU32(spi,152,received)
        nativeAddressStoreU32(spi,60,if (starts == failAt && failureKind == 2) 4096|(1<<17) else 4096);return
    }
    if (address == 0x60081038) { nativeAddressStoreU32(spi,60,nativeAddressLoadU32(spi,60)&~int(value));return }
    nativeAddressStoreU32(spi,address-0x60081000,int(value));return
}
fun initialize(): void {
    seed()
    var at=0
    while (at < 256) { nativeAddressStoreU32(spi,at,0);at=at+4 }
    bus=u32(4);spiFunctional=u32(0x100000);spiWrites=0;spiDrop=0;pending=0;stall=false;active=false;return
}

val gateStorage=nativeStaticAllocate(4)
val buffers=nativeStaticAllocate(1040)
val sector=nativeStaticAllocate(512)
val staged=nativeStaticAllocate(512)
val header=nativeStaticAllocate(6)
val queue=nativeStaticAllocate(8)
val cardRegisters=nativeStaticAllocate(32)
var readPayloadBytes=512
var registerOffset=0
var starts=0
var failAt=0
var failureKind=0
var cardMode=0
var headerSize=0
var queued=0
var queueIndex=0
var stream=0
var dataIndex=0
var dataCrc=0
var wireCrc=0
var cardReady=false
var appPrefix=false
var startupClocks=0
var corruptRead=false
var readCommands=0
var writeCommands=0
fun sdSpiSelectedDelay(us: int): void { if (us != 1000) bad=true;return }
fun enqueue(value: int): void { nativeBufferAt(queue,8).store(queued,value);queued=queued+1;return }
fun receiveCommand(): void {
    val h=nativeBufferAt(header,6)
    val command=h.load(0)&63
    val argument=(h.load(1)<<24)|(h.load(2)<<16)|(h.load(3)<<8)|h.load(4)
    if (h.load(0) != (64|command) || h.load(5) != sdSpiCommandFrameCrc(command,argument)) bad=true
    queued=0;queueIndex=0
    if (command == 0) {
        if (startupClocks < 10 || argument != 0) bad=true
        cardReady=false;appPrefix=false;enqueue(1)
    } else if (command == 8) {
        if (argument != 426) bad=true
        if (cardMode == 2) enqueue(5)
        else { enqueue(1);enqueue(0);enqueue(0);enqueue(1);enqueue(170) }
    } else if (command == 55) { appPrefix=true;enqueue(if (cardReady) 0 else 1) }
    else if (command == 41) {
        if (!appPrefix || argument != (if (cardMode == 2) 0 else 1073741824)) bad=true
        appPrefix=false;cardReady=true;enqueue(0)
    } else if (command == 58) {
        if (!cardReady) bad=true
        enqueue(0);enqueue(if (cardMode == 0) 192 else 128);enqueue(255);enqueue(0);enqueue(0)
    } else if (command == 16) { if (cardMode == 0 || argument != 512) bad=true;enqueue(0) }
    else if (command == 9 || command == 10) {
        if (!cardReady || argument != 0) bad=true
        enqueue(0);stream=1;dataIndex=0;dataCrc=0;readPayloadBytes=16;registerOffset=if (command == 9) 0 else 16
    }
    else if (command == 17 || command == 24) {
        if (!cardReady || argument != (if (cardMode == 0) 3 else 1536)) bad=true
        enqueue(0);dataIndex=0;dataCrc=0;wireCrc=0
        if (command == 17) { stream=1;readPayloadBytes=512;readCommands=readCommands+1 }
        else { stream=2;writeCommands=writeCommands+1 }
    } else if (command == 13) { enqueue(0);enqueue(0) }
    else { bad=true;enqueue(4) }
    headerSize=0;return
}
fun cardExchange(value: int): int {
    if (peripheralGateAt(gateStorage).tryBegin(u32(99)) != 1) bad=true
    if ((c61GpioRead(0x60091004)&u32(1<<28)) != u32(0)) {
        if (value != 255) bad=true
        startupClocks=startupClocks+1;headerSize=0;queued=0;queueIndex=0;stream=0
        return 255
    }
    if (queueIndex < queued) {
        if (value != 255) bad=true
        val result=nativeBufferAt(queue,8).load(queueIndex);queueIndex=queueIndex+1;return result
    }
    if (stream == 1) {
        if (value != 255) bad=true
        var result=254
        if (dataIndex >= 1 && dataIndex <= readPayloadBytes) {
            result=if (readPayloadBytes == 512) nativeBufferAt(sector,512).load(dataIndex-1)
                else nativeBufferAt(cardRegisters,32).load(registerOffset+dataIndex-1)
            dataCrc=sdSpiCrc16Byte(dataCrc,result)
        } else if (dataIndex == readPayloadBytes+1) result=(dataCrc>>>8)&255
        else if (dataIndex == readPayloadBytes+2) { result=(dataCrc&255)^(if (corruptRead) 1 else 0);stream=0 }
        dataIndex=dataIndex+1;return result
    }
    if (stream == 2) {
        if (dataIndex == 0) { if (value != 254) bad=true }
        else if (dataIndex <= 512) {
            nativeBufferAt(staged,512).store(dataIndex-1,value);dataCrc=sdSpiCrc16Byte(dataCrc,value)
        } else if (dataIndex == 513) wireCrc=value<<8
        else if (dataIndex == 514) {
            wireCrc=wireCrc|value
            if (wireCrc != dataCrc) bad=true
            var at=0
            while (at < 512) { nativeBufferAt(sector,512).store(at,nativeBufferAt(staged,512).load(at));at=at+1 }
            queued=0;queueIndex=0;enqueue(5);enqueue(0);enqueue(255);stream=0
        }
        dataIndex=dataIndex+1;return 255
    }
    if (headerSize == 0 && value == 255) return 255
    nativeBufferAt(header,6).store(headerSize,value);headerSize=headerSize+1
    if (headerSize == 6) receiveCommand()
    return 255
}
fun resetCard(): void {
    initialize();nativeAddressStoreU32(gateStorage,0,0)
    starts=0;failAt=0;failureKind=0;headerSize=0;queued=0;queueIndex=0;stream=0;dataIndex=0;dataCrc=0;wireCrc=0
    cardReady=false;appPrefix=false;startupClocks=0;corruptRead=false;readCommands=0;writeCommands=0
    val r=nativeBufferAt(cardRegisters,32)
    var at=0
    while (at < 32) { r.store(at,0);at=at+1 }
    r.store(0,if (cardMode == 0) 64 else 0);r.store(5,9)
    var crc=0;at=0
    while (at < 15) { crc=sdSpiCrc7Byte(crc,r.load(at));at=at+1 }
    r.store(15,(crc<<1)|1);r.store(31,1)
    return
}
fun openCardMaster(): Esp32C61SpiMaster =
    esp32C61SpiMasterOpenOwned(spiPins(27,26,25),28,160000000,2,10,20,0,4,true)

import "../src/m5stack/corematrix_control_sequence.ab"
import "../src/m5stack/expander_open.ab"
import "../src/m5stack/pmic_open.ab"
import "../src/m5stack/corematrix_startup_sequence.ab"
import "../src/m5stack/corematrix_power.ab"
import "../src/m5stack/pm1_presence.ab"
var apb=u32(0)
var functional=u32(0)
var gpio=u32(0)
var gateWrites=0
var dropGate=0
var padWrites=0
var dropPad=0
var pads=0
var low=false
var ticks=0
fun c61DelayClockRead(address: int): int = if (address == 0x600960e8) 2<<16 else 1
fun c61DelayClockSetRomTicks(value: int): void { ticks=value;return }
fun c61GpioClockRead(address: int): u32 = if (address == 0x600960c0) apb else if (address == 0x600960c4) functional else gpio
fun c61GpioClockWrite(address: int,value: u32): void {
    gateWrites=gateWrites+1
    if (pads != 0 || nativeAddressLoadU32(memory,308) != 0) bad=true
    if (gateWrites == dropGate) return
    if (address == 0x600960c0) apb=value else if (address == 0x600960c4) functional=value else gpio=value
    return
}
fun c61SoftwareI2cReady(sda: int,scl: int): bool = apb == u32(1) && functional == u32(0x400000) && gpio == u32(1) && ticks == 80
fun c61SoftwareI2cConfigure(pin: int,enabled: bool): bool {
    padWrites=padWrites+1
    if (padWrites == dropPad) return false
    if (enabled) pads=pads|(1<<pin) else pads=pads&~(1<<pin)
    return true
}
fun softwareI2cSample(pin: int): bool = if (pin == 1) clockHigh else masterHigh && slaveHigh
fun softwareI2cDrive(pin: int,released: bool): void = wireDrive(pin,released)
fun softwareI2cDelay(us: int): void { return }
fun wireBoardSeed(borrow: int): void {
    apb=u32(borrow&1);functional=if ((borrow&2) != 0) u32(0x400000) else u32(0)
    gpio=u32((borrow>>>2)&1)
    gateWrites=0;dropGate=0;padWrites=0;dropPad=0;pads=0;bad=false;low=false;ticks=0
    return
}
fun open(): Esp32C61I2cSession = esp32C61I2cSessionOpenOwned(0,1,40000000,20000000,true,5,8)

val registers=nativeStaticAllocate(512)
val record=nativeStaticAllocate(64)
val presenceStorage=nativeStaticAllocate(32)
var irqCalls=0
fun coreMatrixStartupAdmission(owner: int,presence: Pm1BatteryPresence): bool = M5CoreMatrixControl(owner).ready()
fun coreMatrixStartupInputs(owner: int): int = M5CoreMatrixControl(owner).pmic().configureCoreMatrixPm1Inputs()|0
// GPIO2 MMIO handoff has its own register fault matrix; model only that leaf.
fun coreMatrixStartupIrq(): int { irqCalls=irqCalls+1;return 1 }
fun coreMatrixStartupChargeSense(owner: int): bool = M5Ioe1(M5CoreMatrixControl(owner).expanders().device(0)|0).setDirection(7,false)
fun coreMatrixStartupPresence(owner: int,presence: Pm1BatteryPresence,now: int): int {
    val control=M5CoreMatrixControl(owner)
    return presence.updateBoard(m5BoardCoreMatrix,control.pmic().pm1(),M5Ioe1(control.expanders().device(0)|0),now)
}
fun coreMatrixStartupSd(owner: int): int = M5CoreMatrixControl(owner).expanders().configureCoreMatrixSdPower()|0
var masterHigh=true
var slaveHigh=true
var clockHigh=true
var mode=0
var bits=0
var value=0
var index=0
var selected=-1
var pointer=0
var reading=false
var ack=true
var ackCount=0
var nackAt=0
var wireStarts=0
var stops=0
fun wireByte(): void {
    ackCount=ackCount+1
    ack=ackCount != nackAt
    if (index == 0) {
        selected=if ((value>>>1) == 79) 0 else if ((value>>>1) == 110) 256 else -1
        reading=(value&1) != 0
        if (selected < 0) ack=false
    } else if (ack && selected >= 0) {
        if (index == 1) pointer=value
        else { nativeBufferAt(registers,512).store(selected+pointer,value);pointer=(pointer+1)&255 }
    }
    index=index+1
    return
}
fun sendBit(): void {
    val byte=nativeBufferAt(registers,512).load(selected+pointer)
    slaveHigh=(byte&(128>>>bits)) != 0;return
}
fun wireDrive(pin: int,high: bool): void {
    if (pin == 0) {
        val old=masterHigh
        masterHigh=high
        if (clockHigh && slaveHigh && old != high) {
            if (!high) { wireStarts=wireStarts+1;mode=1;bits=0;value=0;index=0;reading=false }
            else { stops=stops+1;mode=0;slaveHigh=true }
        }
        return
    }
    if (pin != 1) { bad=true;return }
    if (clockHigh == high) return
    clockHigh=high
    if (high) {
        if (mode == 1) { value=(value<<1)|(if (masterHigh) 1 else 0);bits=bits+1 }
        else if (mode == 3) bits=bits+1
        else if (mode == 4) ack=!masterHigh
    } else {
        if (mode == 1 && bits == 8) { wireByte();mode=2;slaveHigh=!ack }
        else if (mode == 2) {
            slaveHigh=true;bits=0;value=0
            if (!ack) mode=5
            else if (reading) { mode=3;sendBit() }
            else mode=1
        } else if (mode == 3) {
            if (bits == 8) { mode=4;slaveHigh=true } else sendBit()
        } else if (mode == 4) {
            bits=0
            if (ack) { pointer=(pointer+1)&255;mode=3;sendBit() } else { mode=5;slaveHigh=true }
        }
    }
    return
}
fun wireSeed(): void {
    wireBoardSeed(0)
    masterHigh=true;slaveHigh=true;clockHigh=true;mode=0;bits=0;value=0;index=0
    selected=-1;pointer=0;reading=false;ack=true;ackCount=0;nackAt=0;wireStarts=0;stops=0
    var at=0
    while (at < 512) { nativeBufferAt(registers,512).store(at,255);at=at+1 }
    nativeBufferAt(registers,512).store(256,18)
    nativeBufferAt(registers,512).store(257,52)
    nativeBufferAt(registers,512).store(258,86)
    nativeBufferAt(registers,512).store(259,120)
    return
}

import "../src/m5stack/corematrix_sd_control_sequence.ab"
val boardMemory=nativeStaticAllocate(40)
val sessionMemory=nativeStaticAllocate(64)
var settleCalls=0
fun coreMatrixSdDelay(us: int): void {
    val r=nativeBufferAt(registers,512)
    if (us != 10000 || r.load(3) != 165 || r.load(5) != 85 || r.load(19) != 254 || starts != 0 || spiWrites != 0) bad=true
    settleCalls=settleCalls+1;return
}
fun combinedSeed(): void {
    cardMode=0;resetCard();wireSeed();settleCalls=0;return
}
@export("abla_corematrix_sd_wire_test")
trusted fun testCombined(): i32 {
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    val sd=m5CoreMatrixSdAt(nativeBufferAt(boardMemory,40))
    val sessionStorage=nativeBufferAt(sessionMemory,64)
    val gate=peripheralGateAt(gateStorage)
    val scratch=nativeBufferAt(buffers,2);val response=nativeBufferAt(buffers+4,16)
    val source=nativeBufferAt(buffers+16,512);val destination=nativeBufferAt(buffers+528,512)
    val r=nativeBufferAt(registers,512)
    combinedSeed()
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1 ||
        !sd.initializeFresh() || !esp32C61SdSessionInitializeFresh(sessionStorage) || bad) return i32(1)
    r.store(3,164);r.store(5,84);r.store(19,255)
    val beforePower=ackCount
    if (sd.openOwned(control|0,sessionStorage,gate,u32(7),160000000,scratch,response,10000,true) != 1 ||
        settleCalls != 1 || bad) return i32(2)
    val powerBytes=ackCount-beforePower
    val borrowedAck=ackCount;val borrowedSpi=spiWrites
    if (!control.sdRetained() || control.closeOwned(true) || !control.ready() || control.openFailure() != 0 || ackCount != borrowedAck || spiWrites != borrowedSpi || pads != 3) return i32(10)
    var at=0
    while (at < 512) { source.store(at,(at*19+11)&255);at=at+1 }
    val session=sd.session()
    if (!session.writeBlock(u32(7),3,scratch,source,4).valid() ||
        !session.readBlock(u32(7),3,scratch,destination,4).valid() || bad) return i32(3)
    at=0
    while (at < 512) { if (source.load(at) != destination.load(at)) return i32(4);at=at+1 }
    // SD never modifies PM1 IRQ status or other IOE output bits.
    if (r.load(3) != 165 || r.load(5) != 85 || r.load(19) != 254 ||
        r.load(320) != 255 || r.load(321) != 255 || r.load(322) != 255) return i32(5)
    if (!sd.closeOwned(u32(7),true) || control.sdRetained() || !sd.closeOwned(u32(7),true) || apb != u32(1) || functional != u32(0x400000) ||
        !control.closeOwned(true) || apb != u32(0) || functional != u32(0) || pads != 0 || bad) return i32(6)
    var failure=1
    while (failure <= powerBytes) {
        combinedSeed()
        if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1 ||
            !sd.initializeFresh()) return i32(7)
        r.store(3,164);r.store(5,84);r.store(19,255)
        nackAt=ackCount+failure
        if (sd.openOwned(control|0,sessionStorage,gate,u32(7),160000000,scratch,response,10000,true) != 3 ||
            ackCount != nackAt || starts != 0 || spiWrites != 0 || settleCalls != 0 || bad) return i32(8)
        val failedAck=ackCount
        if (!control.sdRetained() || control.closeOwned(true) || !control.ready() || ackCount != failedAck || spiWrites != 0) return i32(11)
        if (!sd.closeOwned(u32(7),true) || !control.closeOwned(true) || pads != 0 || bad) return i32(9)
        failure=failure+1
    }
    return i32(0)
}
