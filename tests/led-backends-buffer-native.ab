import "../src/led/m5pm1_state.ab"
import "../src/led/paper_mono_state.ab"
import "../src/led/powerhub_device.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type M5Pm1=int
type M5Ioe1=int
type I2cBus=int
type I2cDevice=int
val m5Pm1GpioFunctionSpecial=3
val m5Pm1GpioPushPull=0
var calls=0
var success=true
fun io(): bool { calls=calls+1; success }
fun M5Pm1.valid(): bool = this != 0
fun M5Ioe1.valid(): bool = this != 0
fun I2cBus.valid(): bool = this != 0
fun I2cDevice.valid(): bool = this != 0
fun M5Pm1.device(): I2cDevice = I2cDevice(this|0)
fun I2cBus.device(address: int,frequency: int): I2cDevice = I2cDevice(1)
fun I2cDevice.close(): bool = io()
fun I2cDevice.updateRegister8(reg: int,mask: int,value: int): bool = io()
fun I2cDevice.writeRegister8(reg: int,value: int): bool = io()
fun I2cDevice.writeRegister(reg: int,source: NativeBuffer,bytes: int): bool = io()
fun M5Pm1.setLedEnableLevel(level: bool): bool = io()
fun M5Pm1.setGpioFunction(pin: int,function: int): bool = io()
fun M5Pm1.setGpioDrive(pin: int,drive: int): bool = io()
fun M5Ioe1.setDirection(pin: int,output: bool): bool = io()
fun M5Ioe1.setHighImpedance(pin: int,enabled: bool): bool = io()
fun M5Ioe1.digitalWrite(pin: int,level: bool): bool = io()
fun M5Ioe1.setPwmDuty12(channel: int,duty: int,inverted: bool,enabled: bool): bool = io()
val pmicAddress=nativeStaticAllocate(104)
val paperAddress=nativeStaticAllocate(16)
val hubAddress=nativeStaticAllocate(32)
val colors=nativeBufferAt(nativeStaticAllocate(96),96)
@export("abla_led_backends_buffer_test")
trusted fun test(): i32 {
    val pmic=m5Pm1LedAt(pmicAddress,M5Pm1(1),31)
    val paper=paperMonoLedAt(paperAddress,M5Pm1(1),M5Ioe1(1))
    val hub=powerHubLedAt(hubAddress,I2cBus(1))
    var i=0
    while (i < 32) { colors.store(i*3,1); colors.store(i*3+1,2); colors.store(i*3+2,3); i=i+1 }
    calls=0
    if (!pmic.storeColors(colors,0,100) || !paper.storeColors(colors,0,100) || !hub.storeColors(colors,0,100) || calls != 0) return i32(1)
    i=0
    while (i < 31) { if (pmic.color(i) != rgbColor(1,2,3)) return i32(2); i=i+1 }
    i=0
    while (i < 8) { if (hub.color(i) != rgbColor(1,2,3)) return i32(3); i=i+1 }
    if (paper.color() != rgbColor(1,2,3)) return i32(4)
    pmic.setAutoDisplay(false); paper.setAutoDisplay(false); hub.setAutoDisplay(false)
    colors.store(0,0xf8); colors.store(1,0)
    if (!pmic.setPackedColors(colors,30,100,ledPixelsRgb565Be) || !paper.setPackedColors(colors,0,100,ledPixelsRgb565Be) || !hub.setPackedColors(colors,7,100,ledPixelsRgb565Be) || calls != 0) return i32(5)
    if (pmic.color(30) != rgbColor(255,0,0) || paper.color() != rgbColor(255,0,0) || hub.color(7) != rgbColor(255,0,0)) return i32(6)
    val short=nativeBufferAt(colors.addressValue(),1)
    if (pmic.storePackedColors(short,0,1,2) || paper.storePackedColors(short,0,1,2) || hub.storePackedColors(short,0,1,2) || calls != 0) return i32(7)
    // Auto-display must report uninitialized transport failure, not forced
    // success. Actual display uses 32-bit DMA/stack addresses: target check.
    pmic.setAutoDisplay(true); paper.setAutoDisplay(true); hub.setAutoDisplay(true)
    success=false
    if (pmic.setPackedColors(colors,0,1,3) || paper.setPackedColors(colors,0,1,3) || hub.setPackedColors(colors,0,1,3) || calls != 0) return i32(8)
    if (M5Pm1Led(0).storeColors(colors,0,1) || PaperMonoLed(0).storeColors(colors,0,1) || PowerHubLed(0).storeColors(colors,0,1)) return i32(9)
    return i32(0)
}
