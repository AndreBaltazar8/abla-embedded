import "../src/esp32/power/sleep_entry_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var phase=0
var polls=0
var wait=0
var raw=1
var wake=1
var reject=0
var busy=false
var deep=false
var bad=false
fun esp32S3SleepEntryRead(address: int): int {
    if (address == 0x60008018) return if (busy) 0x80000000 else 0
    if (address == 0x60008090) return if (deep) 0x80000000 else 0
    if (address == 0x60008044) {
        if (phase != 5) bad=true
        polls=polls+1
        return if (polls <= wait) 0x400 else raw | 0x400
    }
    bad=true; 0
}
fun esp32S3SleepEntryWrite(address: int,value: int): void {
    if (address != 0x6000804C || value != 3 || (phase != 2 && phase != 5)) bad=true
    phase=phase+1; return
}
fun esp32S3SleepEntryUpdate(address: int,mask: int,value: int): void {
    if (phase == 0) { if (address != 0x6000803C || mask != 0xFFFF8000 || value != (wake<<15)) bad=true }
    else if (phase == 1) { if (address != 0x60008068 || mask != 0x3FFFF000 || value != (reject<<12)) bad=true }
    else if (phase == 3) { if (address != 0x60008018 || mask != 2 || value != 2) bad=true }
    else if (phase == 4) { if (address != 0x60008018 || mask != 0x80000000 || value != 0x80000000) bad=true }
    else if (phase == 6) { if (address != 0x60008020 || mask != 0xFF8000 || value != 0x80000) bad=true }
    else bad=true
    phase=phase+1; return
}
@export("abla_sleep_entry_test")
trusted fun entryTest(): i32 {
    var bit=0
    while (bit < 18) {
        wake=1<<(bit % 17); reject=1<<bit
        raw=1
        while (raw <= 3) {
            wait=0
            while (wait < 8) {
                phase=0; polls=0; bad=false
                if (esp32S3LightSleepEnterOwned(wake,reject) != ((raw>>>1) & 1) || bad || phase != 7 || polls != wait+1) return i32(1)
                wait=wait+1
            }
            raw=raw+1
        }
        bit=bit+1
    }
    phase=0
    if (esp32S3LightSleepEnterOwned(0,0) != -1 || esp32S3LightSleepEnterOwned(0x20000,0) != -1 || esp32S3LightSleepEnterOwned(1,0x40000) != -1 || phase != 0) return i32(2)
    busy=true
    if (esp32S3LightSleepEnterOwned(1,0) != -2 || phase != 0) return i32(3)
    busy=false; deep=true
    if (esp32S3LightSleepEnterOwned(1,0) != -2 || phase != 0) return i32(4)
    i32(0)
}
