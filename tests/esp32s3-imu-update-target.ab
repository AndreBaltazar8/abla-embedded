import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/imu_update.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_update_target")
trusted fun updateTarget(imu: M5ImuProbeResult,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int): int =
    imu.updateSnapshot(snapshot,scratch,micros)
