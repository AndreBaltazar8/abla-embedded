import "../src/esp32/i2s/transfer_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val history=nativeStaticAllocate(32)
var port=0
var tx=false
var config=0x6ee08000
var eof=0xfffff000
var bus=0x1c000
var writes=0
var reads=0
var pending=false
var polls=0
var clearAfter=1
var stuck=0
var bad=false
trusted fun p4I2sTransferRead(address: int): int {
    reads=reads+1
    if (address == 0x500e601c) return bus
    val base=0x500c6000+port*4096
    if (address == base+100) return eof
    if (address != base+(if (tx) 36 else 32)) { bad=true;return 0 }
    if (pending) {
        polls=polls+1
        if (clearAfter > 0 && polls >= clearAfter) { pending=false;config=config & 0xfffffeff }
    }
    return config
}
trusted fun p4I2sTransferWrite(address: int,value: int): void {
    if (writes >= 8) { bad=true;return }
    nativeAddressStoreU32(history,writes*4,value)
    writes=writes+1
    val base=0x500c6000+port*4096
    if (address == base+100) { eof=if (stuck == 16) value ^ 1 else value;return }
    if (address != base+(if (tx) 36 else 32)) bad=true
    config=value | (stuck & 7)
    if (stuck == 8) config=config & 0xfffffffb
    if ((value & 256) != 0) { pending=true;polls=0 }
    return
}
trusted fun reset(): void {
    config=0x6ee08000;eof=0xfffff000;bus=0x1c000
    writes=0;reads=0;pending=false;polls=0;clearAfter=1;stuck=0;bad=false
    return
}
@export("abla_i2s_transfer_p4_test")
trusted fun test(): i32 {
    while (port < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction==1;reset()
            if (esp32p4I2sResetDirectionOwned(port,tx,true) != 1 || writes != 4 || bad || config != 0x6ee08000 ||
                nativeAddressLoadU32(history,0) != 0x6ee08001 || nativeAddressLoadU32(history,4) != 0x6ee08000 ||
                nativeAddressLoadU32(history,8) != 0x6ee08002 || nativeAddressLoadU32(history,12) != 0x6ee08000) return i32(1)
            reset();stuck=1
            if (esp32p4I2sResetDirectionOwned(port,tx,true) != 5 || writes != 2) return i32(2)
            reset();stuck=2
            if (esp32p4I2sResetDirectionOwned(port,tx,true) != 6 || writes != 4) return i32(3)
            var delay=1
            while (delay <= 8) {
                reset();clearAfter=delay
                if (esp32p4I2sStartDirectionOwned(port,tx,8,true) != 1 || writes != 2 || polls != delay || bad || config != 0x6ee08004 ||
                    nativeAddressLoadU32(history,0) != 0x6ee08100 || nativeAddressLoadU32(history,4) != 0x6ee08004) return i32(4)
                if (esp32p4I2sStopDirectionOwned(port,tx,true) != 1 || config != 0x6ee08000) return i32(5)
                delay=delay+1
            }
            reset();clearAfter=0
            if (esp32p4I2sStartDirectionOwned(port,tx,8,true) != 5 || writes != 1 || polls != 8 || (config & 256) == 0) return i32(6)
            reset();stuck=8
            if (esp32p4I2sStartDirectionOwned(port,tx,8,true) != 6 || writes != 2) return i32(7)
            reset();config=config | 4;stuck=4
            if (esp32p4I2sStopDirectionOwned(port,tx,true) != 5) return i32(8)
            var bit=1
            while (bit <= 256) {
                if ((bit & 263) != 0) {
                    reset();config=config | bit
                    if (esp32p4I2sResetDirectionOwned(port,tx,true) != 4 || esp32p4I2sLatchOwned(port,tx,8,true) != 4 || writes != 0) return i32(9)
                }
                bit=bit*2
            }
            reset();bus=0
            if (esp32p4I2sResetDirectionOwned(port,tx,true) != 3 || esp32p4I2sStartDirectionOwned(port,tx,8,true) != 3 ||
                esp32p4I2sStopDirectionOwned(port,tx,true) != 3 || reads != 3 || writes != 0) return i32(10)
            direction=direction+1
        }
        tx=false
        var bytes=1
        while (bytes <= 4095) {
            reset()
            if (esp32p4I2sSetReceiveBlockBytesOwned(port,bytes,true) != 1 || eof != 0xfffff000+bytes || writes != 1 || bad) return i32(11)
            bytes=bytes+1
        }
        reset();stuck=16
        if (esp32p4I2sSetReceiveBlockBytesOwned(port,64,true) != 5) return i32(12)
        port=port+1
    }
    reset()
    if (esp32p4I2sLatchOwned(0,false,0,true) != 2 || esp32p4I2sLatchOwned(0,false,1000001,true) != 2 ||
        esp32p4I2sStartDirectionOwned(3,false,1,true) != 2 || esp32p4I2sResetDirectionOwned(-1,false,true) != 2 ||
        esp32p4I2sStopDirectionOwned(0,false,false) != 2 || esp32p4I2sSetReceiveBlockBytesOwned(0,0,true) != 2 ||
        esp32p4I2sSetReceiveBlockBytesOwned(0,4096,true) != 2 || reads != 0 || writes != 0) return i32(13)
    return i32(0)
}
