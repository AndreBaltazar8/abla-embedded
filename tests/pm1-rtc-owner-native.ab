import "./pm1-control-wire-native.ab"
import "../src/m5stack/pm1_rtc_owner_sequence.ab"
var rtcAllocateFail=false
var rtcBeginFail=false
var rtcCloseFail=false
var rtcCalls=0
fun m5RtcOpenAllocate(bus: int,board: M5BoardId): int {
    rtcCalls=rtcCalls+1
    if (board.rtcKind() != m5RtcRx8130) bad=true
    val handle=if (rtcAllocateFail) 0 else I2cBus(bus).device(50,100000)|0
    return if (handle == 0) 0 else (2<<32)|handle
}
fun m5RtcOpenBegin(rtc: int): bool { rtcCalls=rtcCalls+1;return !rtcBeginFail }
fun m5RtcOpenClose(rtc: int): bool { rtcCalls=rtcCalls+1;return !rtcCloseFail && I2cDevice(rtc&0xffffffff).close() }
@export("abla_pm1_rtc_owner_test")
trusted fun testRtcOwner(): i32 {
    val owner=m5Pm1ControlAt(nativeBufferAt(record,72))
    var route=0
    while (route < 3) {
        val board=if (route == 0) m5BoardChainCaptain else if (route == 1) m5BoardPaperMono else m5BoardStopWatch
        var variant=0
        while (variant < 8) {
            wireSeed();bad=false
            val bus=i2cSoftwareMaster(0,1,5,8)
            if (!owner.initialize() || owner.openOwned(bus|0,board,true,true) != 1) return i32(1)
            rtcCalls=0;rtcAllocateFail=(variant&1) != 0;rtcBeginFail=(variant&2) != 0;rtcCloseFail=(variant&4) != 0
            if (owner.openRetainedRtcOwned(false,true).status() != 6 || owner.openRetainedRtcOwned(true,false).status() != 6 || rtcCalls != 0) return i32(2)
            val result=owner.openRetainedRtcOwned(true,true)
            val expected=if (rtcAllocateFail) 2 else if (!rtcBeginFail) 1 else if (rtcCloseFail) 4 else 3
            val retained=expected == 1 || expected == 4
            if (result.status() != expected || owner.rtcRetained() != retained || bad) return i32(3)
            if (retained) {
                val calls=rtcCalls;val before=ackCount
                if (owner.closeOwned(true) || !owner.ready() || owner.openRetainedRtcOwned(true,true).status() != 6 || owner.closeRetainedRtcOwned(result.handle(),false) ||
                    owner.closeRetainedRtcOwned(result.handle()^1,true) || owner.closeRetainedRtcOwned(result.handle()^(3<<32),true) || rtcCalls != calls || ackCount != before) return i32(4)
                rtcCloseFail=true
                if (owner.closeRetainedRtcOwned(result.handle(),true) || !owner.rtcRetained() || !owner.ready()) return i32(5)
                rtcCloseFail=false
                if (!owner.closeRetainedRtcOwned(result.handle(),true) || owner.rtcRetained()) return i32(6)
                val released=rtcCalls
                if (owner.closeRetainedRtcOwned(result.handle(),true) || rtcCalls != released) return i32(7)
            }
            if (!owner.closeOwned(true) || !bus.close() || pads != 0 || bad) return i32(8)
            variant=variant+1
        }
        route=route+1
    }
    return i32(0)
}
