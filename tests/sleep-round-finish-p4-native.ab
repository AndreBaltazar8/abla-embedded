import "../src/esp32/power/sleep_round_finish_p4_sequence.ab"
import "abla/build"
val finishStorage=nativeStaticAllocate(2192)
var finishEvents=0
var finishReject=u32(0x4000)
var finishWrites=0
var finishDrop=0
var finishBad=false
var finishInject=0
fun p4SleepPolicyRead(offset: int): u32 {
    if (offset == 356) return u32(finishEvents)<<u32(30)
    if (offset == 324) return u32(0x1000)
    if (offset == 328) return finishReject
    finishBad=true;return u32(0)
}
fun p4SleepPolicyWrite(offset: int,value: u32): void {
    finishWrites=finishWrites+1
    if (finishWrites == finishDrop) return
    if (offset == 368) finishEvents=(finishEvents&(~int(value>>u32(30))))|finishInject
    else if (offset == 304 && value == u32(0x80000000)) finishReject=u32(0)
    else finishBad=true
    return
}
@export("abla_sleep_round_finish_p4_test")
fun finishTest(): int {
    val r=nativeBufferAt((finishStorage+15)&(~15),2172)
    var scenario=0
    while (scenario < 12) {
        var i=0
        while (i < 2172) { r.storeU32(i,0);i=i+4 }
        val event=scenario%3+1;val fault=scenario/3
        r.storeU32(0,0x5034524e);r.storeU32(4,13);r.storeU32(52,if (event == 1) 2 else if (event == 2) 1 else 3)
        r.storeU32(2168,0x1234abcd);finishEvents=event;finishReject=u32(0x4000);finishWrites=0;finishDrop=fault;finishBad=false;finishInject=0
        esp32p4SleepRoundFinishOwned(r,true)
        finishDrop=0
        if (esp32p4SleepRoundFinishOwned(r,true) != 1 || finishEvents != 0 || r.loadU32(60) != 0x1000 ||
            r.loadU32(452) != 0x4000 || r.loadU32(456) != event || r.loadU32(460) != 2 ||
            ((event&1) != 0 && finishReject != u32(0)) || finishBad || r.loadU32(2168) != 0x1234abcd) return 1
        val writes=finishWrites
        if (esp32p4SleepRoundFinishOwned(r,true) != 1 || finishWrites != writes) return 2
        // Abort preserves unrelated status; mismatched event never acknowledged.
        r.storeU32(52,10);finishEvents=3
        if (esp32p4SleepRoundFinishOwned(r,true) != 1 || finishWrites != writes || finishEvents != 3) return 3
        r.storeU32(52,1);r.storeU32(460,0)
        if (esp32p4SleepRoundFinishOwned(r,true) != 3 || finishWrites != writes) return 4
        finishEvents=2;finishInject=1
        if (esp32p4SleepRoundFinishOwned(r,true) != 3 || finishEvents != 1 || r.loadU32(460) != 1 || r.loadU32(456) != 2) return 5
        finishInject=0
        scenario=scenario+1
    }
    return 0
}
