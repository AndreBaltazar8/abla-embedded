import "../src/touch/pins.ab"
import "../src/hal/delay.ab"
import "../src/hal/pin.ab"
var trace = 0
var delayError = false
@exportLocal("abla_pin_valid")
fun pinValidHook(pin: int): bool = Pin(pin) == 1 || Pin(pin) == 2 || Pin(pin) == 3
@exportLocal("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin) == 1
@exportLocal("abla_pin_pullCapable")
fun pinPullCapableHook(pin: int): bool = Pin(pin) == 1 || Pin(pin) == 2
fun event(code: int): void {
    trace = trace * 10 + code
    return
}
@exportLocal("abla_pin_write")
fun pinWriteHook(pin: int, high: bool): void = event(if (high) 4 else 1)
@exportLocal("abla_pin_output")
fun pinOutputHook(pin: int): void = event(2)
@exportLocal("abla_pin_input")
fun pinInputHook(pin: int): void = event(6)
@exportLocal("abla_pin_pullUp")
fun pinPullUpHook(pin: int): void = event(7)
@exportLocal("abla_pin_pullDown")
fun pinPullDownHook(pin: int): void = event(8)
@export("peripheralDelayMilliseconds")
fun peripheralDelayMillisecondsHook(duration: int): void {
    if (duration == 58 || duration == 5) event(3)
    else if (duration == 2) event(5)
    else delayError = true
    return
}
@export("peripheralDelayMicroseconds")
fun peripheralDelayMicrosecondsHook(duration: int): void {
    if (duration != 512) delayError = true
    event(9)
    return
}
trusted fun main(): int {
    if (!touchResetPulse(Pin(1), 5) || trace != 1234) return 1
    trace = 0
    if (!ft5x06WakeInterrupt(Pin(2)) || trace != 6897) return 2
    trace = 0
    if (!gt911WakeInterrupt(Pin(1)) || trace != 1234567) return 3
    trace = 0
    if (!gt911PrepareSleepInterrupt(Pin(1)) || trace != 12) return 4
    trace = 0
    if (gt911WakeInterrupt(Pin(2)) || gt911PrepareSleepInterrupt(Pin(2)) ||
        touchResetPulse(Pin(2), 5) || ft5x06WakeInterrupt(Pin(0)) || ft5x06WakeInterrupt(Pin(3)) ||
        touchResetPulse(Pin(1), 0) || touchResetPulse(Pin(1), 1001) || trace != 0 || delayError) return 5
    0
}
