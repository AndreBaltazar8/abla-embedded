import "../src/touch/pins.ab"
type Pin = int
var trace = 0
var delayError = false
fun Pin.valid(): bool = this == 1 || this == 2 || this == 3
fun Pin.outputCapable(): bool = this == 1
fun Pin.pullCapable(): bool = this == 1 || this == 2
fun event(code: int): void {
    trace = trace * 10 + code
    return
}
fun Pin.write(high: bool): void = event(if (high) 4 else 1)
fun Pin.output(): void = event(2)
fun Pin.input(): void = event(6)
fun Pin.pullUp(): void = event(7)
fun Pin.pullDown(): void = event(8)
fun peripheralDelayMilliseconds(duration: int): void {
    if (duration == 58 || duration == 5) event(3)
    else if (duration == 2) event(5)
    else delayError = true
    return
}
fun peripheralDelayMicroseconds(duration: int): void {
    if (duration != 512) delayError = true
    event(9)
    return
}
trusted fun main(): int {
    if (!touchResetPulse(Pin(1), 5) || trace != 1234) return 1
    trace = 0
    if (!ft5x06WakeInterrupt(Pin(2)) || trace != 6897) return 2
    trace = 0
    if (!gt911WakeInterrupt(Pin(1)) || trace != 1234567) return 3
    trace = 0
    if (!gt911PrepareSleepInterrupt(Pin(1)) || trace != 12) return 4
    trace = 0
    if (gt911WakeInterrupt(Pin(2)) || gt911PrepareSleepInterrupt(Pin(2)) ||
        touchResetPulse(Pin(2), 5) || ft5x06WakeInterrupt(Pin(0)) || ft5x06WakeInterrupt(Pin(3)) ||
        touchResetPulse(Pin(1), 0) || touchResetPulse(Pin(1), 1001) || trace != 0 || delayError) return 5
    0
}
