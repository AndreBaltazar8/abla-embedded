import "../src/display/dsi_bridge_dma_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(256)
var reads=0
var writes=0
var triggers=0
var drop=-1
var bad=false
trusted fun p4DsiBridgeRead(offset: int): u32 {
    reads=reads+1
    val value=u32(nativeBufferAt(storage,256).loadU32(offset))
    return if (offset == 12) value&u32(2147483647) else value
}
trusted fun p4DsiBridgeWrite(offset: int,value: u32): void {
    val expected=if (writes == 0 || writes == 6) 12 else if (writes == 1) 64 else if (writes == 2) 136 else if (writes == 3) 108 else if (writes == 4) 8 else 140
    if (offset != expected || writes > 6) bad=true
    if (offset == 12 && (value&u32(2147483648)) != u32(0)) {
        triggers=triggers+1
        if (writes != 6) bad=true
    }
    if (writes != drop) nativeBufferAt(storage,256).storeU32(offset,int(value))
    writes=writes+1
    return
}
trusted fun fill(pattern: int): void {
    var i=0
    while (i < 256) { nativeBufferAt(storage,256).store(i,pattern); i=i+1 }
    nativeBufferAt(storage,256).storeU32(4,0)
    nativeBufferAt(storage,256).storeU32(64,if (pattern == 0) 0 else 4294967294)
    writes=0; reads=0; triggers=0
    return
}
@export("abla_dsi_p4_bridge_dma_test")
trusted fun testDma(): i32 {
    var profile=0
    while (profile < 12) {
        val bits=if ((profile&1) == 0) 16 else 24
        val pattern=if ((profile&2) == 0) 0 else 255
        val blocks=if (profile/4 == 0) 1 else if (profile/4 == 1) 2 else 15
        var width=1
        while (width <= 9) {
            fill(pattern)
            val result=esp32P4DsiBridgeDmaConfigureOwned(width,7,bits,blocks)
            val bitCount=width*7*bits
            val initial=if (pattern == 0) u32(0) else u32(4294967295)
            val expectedRaw=(initial&u32(2139095040))|u32((bitCount+63)/64)|(if (bitCount%64 != 0) u32(4194304) else u32(0))
            if (result != 1 || writes != 7 || triggers != 1 || p4DsiBridgeRead(12) != expectedRaw || bad) return i32(1)
            if (p4DsiBridgeRead(136) != ((initial&u32(4294967054))|u32(blocks*16)) ||
                p4DsiBridgeRead(108) != ((initial&u32(4026531839))|(if (blocks > 1) u32(268435456) else u32(0))) ||
                p4DsiBridgeRead(64) != ((initial&u32(4294901774))|u32(width*16)) ||
                p4DsiBridgeRead(8) != ((initial&u32(4294963200))|u32(256)) ||
                p4DsiBridgeRead(140) != ((initial&u32(4294965248))|u32(768))) return i32(2)
            width=width+1
        }
        profile=profile+1
    }
    fill(0)
    if (esp32P4DsiBridgeDmaConfigureOwned(720,1280,16,1) != 1 || (p4DsiBridgeRead(12)&u32(4194303)) != u32(230400)) return i32(3)
    drop=0
    while (drop < 6) {
        fill(255)
        if (esp32P4DsiBridgeDmaConfigureOwned(720,1280,16,1) != 4 || writes != drop+1 || triggers != 0 || bad) return i32(4)
        drop=drop+1
    }
    drop= -1; fill(0)
    nativeBufferAt(storage,256).storeU32(4,1)
    if (esp32P4DsiBridgeDmaConfigureOwned(720,1280,16,1) != 3 || writes != 0) return i32(5)
    nativeBufferAt(storage,256).storeU32(4,0); nativeBufferAt(storage,256).storeU32(64,1)
    if (esp32P4DsiBridgeDmaConfigureOwned(720,1280,16,1) != 3 || writes != 0) return i32(6)
    reads=0
    if (esp32P4DsiBridgeDmaConfigureOwned(4095,4095,24,1) != 2 ||
        esp32P4DsiBridgeDmaConfigureOwned(720,1280,16,16) != 2 || reads != 0 || bad) return i32(7)
    i32(0)
}
