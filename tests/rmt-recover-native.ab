import "../src/esp32/rmt_recover_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var clockCase=0
var rmtWait=0
var dmaWait=0
var rmtPolls=0
var dmaPolls=0
var rmtCalls=0
var dmaCalls=0
var disableCalls=0
var published=0
var failure=0
var bad=false
fun reset(): void { clockCase=0;rmtWait=0;dmaWait=0;rmtPolls=0;dmaPolls=0;rmtCalls=0;dmaCalls=0;disableCalls=0;published=0;failure=0;bad=false;return }
fun esp32s3RmtRead(address: int): int {
    if (address == 0x600c0018) return if (clockCase == 1) 0 else 512
    if (address == 0x600c0020) return if (clockCase == 2) 512 else 0
    if (address == 0x600160c0) return if (clockCase == 3) 0 else 0x04000000
    if (address != 0x6001602c) bad=true
    if (disableCalls > 0) return if (failure == 4) 0x02000010 else 0
    rmtPolls=rmtPolls+1
    return 0x02000010|(if (rmtPolls <= rmtWait) 128 else 0)
}
fun esp32s3RmtTxRequestOwned(channel: int,start: bool): bool { if (channel != 3 || start) bad=true; rmtCalls=rmtCalls+1; failure != 1 }
fun esp32s3GdmaRequestStop(channel: int,tx: bool): bool { if (channel != 2 || !tx) bad=true; dmaCalls=dmaCalls+1; failure != 2 }
fun esp32s3GdmaParked(channel: int,tx: bool): bool { dmaPolls=dmaPolls+1; dmaPolls > dmaWait }
fun esp32s3GdmaPublish(): void { published=published+1;return }
fun esp32s3RmtSetTxDmaOwned(channel: int,enabled: bool): bool {
    if (channel != 3 || enabled || rmtPolls <= rmtWait || dmaPolls <= dmaWait || published != 1) bad=true
    disableCalls=disableCalls+1; failure != 3
}
@export("abla_rmt_recover_test")
fun test(): i32 {
    var r=0
    while (r < 6) {
        var d=0
        while (d < 6) {
            reset();rmtWait=r;dmaWait=d
            val done=r < 4 && d < 4
            if (esp32s3RmtRecoverDmaOwned(2,4) != (if (done) 1 else 5) || disableCalls != (if (done) 1 else 0) || bad) return i32(1)
            d=d+1
        }
        r=r+1
    }
    var f=1
    while (f < 5) {
        reset();failure=f
        if (esp32s3RmtRecoverDmaOwned(2,4) != (if (f < 3) 4 else 6) || rmtCalls != 1 || dmaCalls != 1 || bad) return i32(2)
        f=f+1
    }
    f=1
    while (f < 4) { reset();clockCase=f; if (esp32s3RmtRecoverDmaOwned(2,4) != 3 || rmtCalls != 0 || dmaCalls != 0) return i32(3); f=f+1 }
    reset()
    if (esp32s3RmtRecoverDmaOwned(-1,4) != 2 || esp32s3RmtRecoverDmaOwned(2,0) != 2 || rmtCalls != 0) return i32(4)
    return i32(0)
}
