import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/cores3_mix.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")

// Callable target check, not a standalone board image.
trusted fun wavMixTarget(amplifier: Aw88298,expander: Aw9523,channel: int,
    descriptors: int,buffers: int,mix: PcmWavMix,staging: NativeBuffer,
    accumulator: NativeBuffer,scratch: NativeBuffer,owner: u32,rate: int): CoreS3PlaybackResult =
    cores3PlaybackMix(amplifier,expander,channel,descriptors,buffers,mix,staging,
        accumulator,scratch,owner,1000,32768,rate)
#exportFunction("wavMixTarget","abla_wav_mix_target")
