import "../src/esp32/sd_spi_logic.ab"

fun main: int {
    val framing = sdSpiCommandCrc(0) == 149 &&
        sdSpiCommandCrc(8) == 135 && sdSpiCommandCrc(17) == 1
    val addressing = sdSpiBlockArgument(true, 7) == 7 &&
        sdSpiBlockArgument(false, 7) == 3584
    val responses = sdSpiR1Available(0) && sdSpiR1Available(1) &&
        !sdSpiR1Available(255) && sdSpiReadToken(254) &&
        !sdSpiReadToken(255) && sdSpiWriteAccepted(229) &&
        !sdSpiWriteAccepted(11)
    if (framing && addressing && responses) 51 else 1
}
