import "../src/esp32/sar_power_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var clk=0
var power=0
var phy=0
var writes=0
var order=0
var bad=false
fun esp32S3SarRead(address: int): int {
    if (address == 0x60008904) return clk
    if (address == 0x6000883C) return power
    if (address == 0x6000E060) return phy
    bad=true; 0
}
fun esp32S3SarWrite(address: int,value: int): void {
    if (address == 0x60008904) { if ((clk & ~0x40000000) != (value & ~0x40000000)) bad=true; clk=value; order=order*4+1 }
    else if (address == 0x6000883C) { if ((power & ~0x60000000) != (value & ~0x60000000)) bad=true; power=value; order=order*4+2 }
    else if (address == 0x6000E060) { if ((phy & ~192) != (value & ~192)) bad=true; phy=value; order=order*4+3 }
    else bad=true
    writes=writes+1; return
}
@export("abla_sar_power_test")
trusted fun sarTest(): i32 {
    var pattern=0
    while (pattern < 32) {
        var mode=-1
        while (mode <= 3) {
            val initial=0xFFFFFFFF ^ (1<<pattern)
            clk=initial; power=initial; phy=initial; writes=0; order=0; bad=false
            val valid=mode >= 0 && mode <= 2
            if (esp32S3SarPowerSetOwned(mode) != valid) return i32(1)
            if (valid) {
                if (order != 6 || writes != 2 || (clk & 0x40000000) != (if (mode == 2) 0 else 0x40000000) || (power & 0x60000000) != (if (mode == 0) 0 else if (mode == 1) 0x60000000 else 0x40000000)) return i32(2)
            } else if (writes != 0) return i32(3)
            writes=0; order=0
            if (esp32S3SarPwdetPowerSetOwned(mode) != valid) return i32(4)
            if (valid) {
                if (writes != (if (mode == 0) 1 else 2) || (phy & 192) != (if (mode == 0) initial & 64 else if (mode == 1) 192 else 128)) return i32(5)
            } else if (writes != 0) return i32(6)
            if (bad) return i32(7)
            mode=mode+1
        }
        pattern=pattern+1
    }
    writes=0
    val monitor=esp32S3SleepSarPrepareOwned(true)
    if (!esp32S3SleepSarRestoreOwned(monitor) || writes != 0) return i32(8)
    order=0
    val saved=esp32S3SleepSarPrepareOwned(false)
    clk=clk | 0x40000000
    if (esp32S3SleepSarRestoreOwned(saved) || writes != 2) return i32(9)
    clk=clk & ~0x40000000
    if (!esp32S3SleepSarRestoreOwned(saved) || writes != 4 || order != 102) return i32(10)
    if (esp32S3SleepSarRestoreOwned(Esp32S3SleepSar(0)) || writes != 4) return i32(11)
    i32(0)
}
