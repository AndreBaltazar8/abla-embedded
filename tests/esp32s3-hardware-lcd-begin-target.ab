import "../src/display/spi_mipi_esp32s3.ab"
import "../src/display/mipi_programs.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun hardwareLcdBeginTarget(gateAddress: u32, rotation: i32): int =
    esp32s3LcdBeginRgb565(peripheralGateAt(int(gateAddress)), u32(41), 2,
        spiPins(37,35,36), Pin(3), Pin(35), lcdGeometry(320,240), int(rotation),
        ili9342EInitProgram(), nativeBufferAt(0,0), false, true, true)
#exportFunction("hardwareLcdBeginTarget", "abla_s3_hardware_lcd_begin_test")
