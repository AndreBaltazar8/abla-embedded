import "../src/esp32/i2s/transfer_control_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var base = 0
var config = 0
var active = 0
var mode = 0
var bytes = 0
var writes = 0
var reads = 0
var latchOk = false
var bad = false
trusted fun esp32s3I2sClockRead(address: int): int {
    reads = reads + 1
    if (address != config && address != base + 32) bad = true
    active
}
trusted fun esp32s3I2sLatchConfiguration(port: int, transmit: bool, limit: int): bool {
    if (0x6000f000 + port * 0x1e000 != base || base + (if (transmit) 36 else 32) != config || limit != 17 || writes != 0) bad = true
    latchOk
}
trusted fun esp32s3I2sClockField(address: int, mask: int, value: int): void {
    if (mode == 0) {
        if (address != config || mask != (if (writes < 2) 1 else 2) || value != (if ((writes & 1) == 0) mask else 0) || writes > 3) bad = true
    } else if (mode == 1) {
        if (address != base + 100 || mask != 4095 || value != bytes) bad = true
    } else {
        if (address != config || mask != 4 || value != (if (mode == 2) 4 else 0)) bad = true
    }
    writes = writes + 1
    return
}
trusted fun i2sTransferTest(): int {
    var route = 0
    while (route < 4) {
        val tx = (route & 1) != 0
        base = 0x6000f000 + route / 2 * 0x1e000
        config = base + (if (tx) 36 else 32)
        mode = 0
        writes = 0
        if (!esp32s3I2sResetDirection(route / 2, tx) || writes != 4 || bad) return 1
        writes = 0
        active = 4
        if (esp32s3I2sResetDirection(route / 2, tx) || writes != 0) return 2
        active = 256
        if (esp32s3I2sResetDirection(route / 2, tx) || writes != 0) return 3
        active = 0
        mode = 1
        bytes = 1
        while (bytes <= 4095) {
            writes = 0
            if (!esp32s3I2sSetReceiveBlockBytes(route / 2, bytes) || writes != 1 || bad) return 4
            bytes = bytes + 1
        }
        mode = 2
        writes = 0
        latchOk = false
        if (esp32s3I2sStartDirection(route / 2, tx, 17) || writes != 0) return 5
        latchOk = true
        if (!esp32s3I2sStartDirection(route / 2, tx, 17) || writes != 1 || bad) return 6
        mode = 3
        writes = 0
        if (!esp32s3I2sStopDirection(route / 2, tx) || writes != 1 || bad) return 7
        route = route + 1
    }
    reads = 0
    writes = 0
    if (esp32s3I2sResetDirection(-1, false) || esp32s3I2sStopDirection(2, true) || esp32s3I2sSetReceiveBlockBytes(0, 0) || esp32s3I2sSetReceiveBlockBytes(1, 4096) || reads != 0 || writes != 0) return 8
    0
}
#exportFunction("i2sTransferTest", "abla_i2s_transfer_test")
