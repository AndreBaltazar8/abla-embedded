import "../src/m5stack/cores3_microphone_process_sequence.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Esp32S3GdmaPumpResult=int
fun Esp32S3GdmaPumpResult.status(): int = this&255
val memory=nativeStaticAllocate(2048)
val session=nativeBufferAt(memory,128)
val state=nativeBufferAt(memory+128,40)
val expectedState=nativeBufferAt(memory+168,40)
val raw=nativeBufferAt(memory+208,32)
val output=nativeBufferAt(memory+512,256)
val expected=nativeBufferAt(memory+768,256)
var calls=0
var pumpStatus=1
fun coreS3AudioSessionValid(r: NativeBuffer): bool = r.hasAddressRange(0,128) && r.loadU32(0) == 0x43334133
fun esp32s3GdmaRingLayoutValid(desc: int,count: int,payload: int,bytes: int,stride: int): bool =
    desc == memory+256 && count == 2 && payload == memory+320 && bytes == 32 && stride == 32
fun coreS3AudioSessionPumpOwned(r: NativeBuffer,destination: NativeBuffer,polls: int,exclusive: bool): Esp32S3GdmaPumpResult {
    calls=calls+1
    if (pumpStatus == 1) {
        var n=0
        while (n < 16) { destination.storeU16(n*2,n*4567-32768);n=n+1 }
    }
    return Esp32S3GdmaPumpResult(pumpStatus)
}
fun equal(a: NativeBuffer,b: NativeBuffer,bytes: int): bool {
    var n=0;while (n < bytes) { if (a.load(n) != b.load(n)) return false;n=n+1 };return true
}
@export("abla_cores3_microphone_process_test")
fun test(): i32 {
    session.storeU32(0,0x43334133);session.storeU32(4,2);session.storeU32(8,0)
    session.storeU32(24,memory+256);session.storeU32(48,2);session.storeU32(52,32);session.storeU32(112,memory+320)
    var os=1
    while (os <= 8) {
        var format=0
        while (format < 4) {
            val stereo=(format&1) != 0;val bits16=(format&2) != 0
            microphoneProcessInitialize(state,os,16,128,true,false,false)
            microphoneProcessInitialize(expectedState,os,16,128,true,false,false)
            var block=0
            while (block < 4) {
                calls=0;pumpStatus=3
                if (coreS3MicrophoneProcessBlockOwned(session,state,raw,output,stereo,bits16,4,true).status() != 3 || calls != 1 || !equal(state,expectedState,40)) return i32(1)
                pumpStatus=1
                val result=coreS3MicrophoneProcessBlockOwned(session,state,raw,output,stereo,bits16,4,true)
                val count=microphoneProcess(expectedState,raw,8,expected,stereo,bits16)
                if (result.status() != 1 || result.samples() != count || !equal(state,expectedState,40) || !equal(output,expected,count*(if (bits16) 2 else 1))) return i32(2)
                block=block+1
            }
            format=format+1
        }
        os=os+1
    }
    microphoneProcessInitialize(state,1,16,0,true,false,false);calls=0
    if (coreS3MicrophoneProcessBlockOwned(session,state,raw,nativeBufferAt(memory+512,1),true,true,4,true).status() != 2 || calls != 0) return i32(3)
    var alias=0
    while (alias < 3) {
        val address=if (alias == 0) memory else if (alias == 1) memory+256 else memory+352
        if (coreS3MicrophoneProcessBlockOwned(session,state,raw,nativeBufferAt(address,256),false,true,4,true).status() != 2 || calls != 0) return i32(4)
        alias=alias+1
    }
    if (coreS3MicrophoneProcessBlockOwned(session,state,raw,output,true,true,4,false).status() != 2 || calls != 0) return i32(5)
    session.storeU32(8,1)
    if (coreS3MicrophoneProcessBlockOwned(session,state,raw,output,true,true,4,true).status() != 2 || calls != 0) return i32(6)
    session.storeU32(8,0);pumpStatus=4
    while (pumpStatus <= 8) {
        val before=state.loadU32(28)
        if (coreS3MicrophoneProcessBlockOwned(session,state,raw,output,true,true,4,true).status() != pumpStatus || state.loadU32(28) != before) return i32(7)
        pumpStatus=pumpStatus+1
    }
    return i32(0)
}
