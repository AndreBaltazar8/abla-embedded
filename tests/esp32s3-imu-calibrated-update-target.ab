import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/imu_calibrated_update.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_calibrated_update_target")
trusted fun calibratedTarget(owner: M5ImuOwner,snapshot: ImuSnapshot,scratch: NativeBuffer,
    micros: int,calibration: ImuCalibration,offsets: ImuOffsets,initialized: int): M5ImuCalibratedUpdate =
    owner.updateCalibrated(snapshot,scratch,micros,calibration,offsets,initialized)
