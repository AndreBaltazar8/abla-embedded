import "../src/i2c/results.ab"
import "../src/m5stack/stopwatch_display_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
val registers=nativeStaticAllocate(96)
// device,register,mask,value: independent literal upstream register oracle.
val operations=nativeStaticU32s([
    9,6,23,23, 8,35,255,0, 8,19,157,0, 8,3,157,157, 8,5,153,153,
    8,5,24,0, 8,5,24,24, 8,20,2,0, 8,4,2,2, 8,6,2,0
])
var calls=0
var failure=0
var delays=0
var bad=false
fun I2cBus.valid(): bool { bad=true;return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true;return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true;return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true;return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true;return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true;return I2cByteResult(0) }
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true;return I2cWordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true;return I2cDwordResult(0) }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true;return false }
trusted fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    val index=calls;calls=calls+1
    if (index >= 10) { bad=true;return false }
    if (this != nativeAddressLoadU32(operations,index*16) || register != nativeAddressLoadU32(operations,index*16+4) ||
        mask != nativeAddressLoadU32(operations,index*16+8) || value != nativeAddressLoadU32(operations,index*16+12)) bad=true
    if (calls == failure) return false
    val offset=register+(if (this == 9) 48 else 0)
    val buffer=nativeBufferAt(registers,96)
    buffer.store(offset,(buffer.load(offset)&~mask)|value)
    return true
}
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool = this.updateRegister8(register,255,value)
fun peripheralDelayMilliseconds(ms: int): void {
    if (calls != delays+5 || (failure != 0 && calls >= failure) || ms != (if (delays == 0) 10 else if (delays == 1) 8 else 2)) bad=true
    delays=delays+1;return
}
@export("abla_stopwatch_display_power_test")
trusted fun test(): i32 {
    var initial=0
    while (initial < 256) {
        failure=0
        while (failure <= 10) {
            calls=0;delays=0;bad=false
            val buffer=nativeBufferAt(registers,96)
            var r=0
            while (r < 96) { buffer.store(r,initial);r=r+1 }
            val result=stopWatchDisplayPowerOwned(M5Pm1(9),M5Ioe1(8),true)
            val applied=if (failure == 0) 10 else failure-1
            val expectedDelays=if (applied < 5) 0 else if (applied < 7) applied-4 else 3
            if (result != ((if (failure == 0) 1 else 4)|(applied<<8)) || bad || delays != expectedDelays ||
                calls != (if (failure == 0) 10 else failure)) return i32(1)
            r=0
            while (r < 96) {
                var expected=initial
                var step=0
                while (step < applied) {
                    val offset=nativeAddressLoadU32(operations,step*16+4)+(if (nativeAddressLoadU32(operations,step*16) == 9) 48 else 0)
                    if (r == offset) expected=(expected&~nativeAddressLoadU32(operations,step*16+8))|nativeAddressLoadU32(operations,step*16+12)
                    step=step+1
                }
                if (buffer.load(r) != expected) return i32(2)
                r=r+1
            }
            failure=failure+1
        }
        initial=initial+1
    }
    calls=0;delays=0
    if (stopWatchDisplayPowerOwned(M5Pm1(9),M5Ioe1(8),false) != 3 ||
        stopWatchDisplayPowerOwned(M5Pm1(0),M5Ioe1(8),true) != 3 ||
        stopWatchDisplayPowerOwned(M5Pm1(9),M5Ioe1(0),true) != 3 ||
        stopWatchDisplayPowerOwned(M5Pm1(4294967296),M5Ioe1(8),true) != 3 || calls != 0 || delays != 0) return i32(3)
    return i32(0)
}
