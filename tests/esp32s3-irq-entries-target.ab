import "../src/esp32/irq_entries_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_irq_entries_target")
@section(".iram1.abla.s3IrqEntriesTarget")
trusted fun irqTarget(level: int): int {
    if (level == 0) return esp32S3IrqConfigAddress()
    esp32S3IrqEntryAddress(level)
}
