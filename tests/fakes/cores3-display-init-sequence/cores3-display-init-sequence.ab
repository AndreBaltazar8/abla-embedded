import "../../../src/m5stack/cores3_panel_logic.ab"
import "../../../src/m5stack/cores3_display_init_sequence.ab"
import "../../../src/hal/delay.ab"
import "../../../src/hal/root.ab"
import "../../../src/hal/m5stack_3.ab"
import "../../../src/m5stack/m5boardid_type.ab"
import "../../../src/power/axp2101_type.ab"
import "../../../src/io_expander/aw9523_type.ab"
import "../../../src/touch/ft5x06_type.ab"
import "../../../src/peripheralgate_type.ab"
import "../../../src/atomic_type.ab"
import "../../../src/hal/m5boardid_cores3.ab"
import "../../../src/hal/axp2101.ab"
import "../../../src/hal/peripheralgate.ab"
import "../../../src/hal/atomic.ab"
import "../../../src/spi/spitransactionresult_type.ab"
import "../../../src/hal/aw9523.ab"
import "../../../src/hal/ft5x06.ab"
import "../../../src/hal/spitransactionresult.ab"
import "../../../src/m5stack/cores3_display_init_result.ab"
@exportLocal("abla_m5boardid_displaySharedDataCommand")
fun mockM5BoardIdDisplaySharedDataCommand(recv: int): bool = recv == 10
@exportLocal("abla_axp2101_valid")
fun mockAxp2101Valid(recv: int): bool = recv == 1
@exportLocal("abla_aw9523_valid")
fun aw9523ValidHook(recv: int): bool = Aw9523(recv) == 2
@exportLocal("abla_ft5x06_valid")
fun ft5x06ValidHook(recv: int): bool = Ft5x06(recv) == 3
@exportLocal("abla_peripheralgate_word")
fun mockPeripheralGateWord(recv: int): AtomicU32 = AtomicU32(recv & 4294967295)
@exportLocal("abla_atomicu32_valid")
fun mockAtomicU32Valid(recv: int): bool = recv == 4
@export("peripheralOwnerValid")
fun peripheralOwnerValidHook(owner: u32): bool = owner == u32(7)
@exportLocal("abla_spitransactionresult_valid")
fun spiTransactionResultValidHook(recv: int): bool = SpiTransactionResult(recv) == 1
@exportLocal("abla_spitransactionresult_status")
fun spiTransactionResultStatusHook(recv: int): int = SpiTransactionResult(recv)
var step = 0
var fail = 0
var cleanFails = false
var cleanupCalls = 0
var revision = 1
var bad = false
fun reach(expected: int): bool {
    step = step + 1
    if (step != expected) bad = true
    fail != step
}
@export("peripheralDelayMilliseconds")
fun peripheralDelayMillisecondsHook(duration: int): void { if (duration != 5 || !reach(1)) bad = true; return }
@export("cores3ConfigurePmic")
fun cores3ConfigurePmicHook(power: Axp2101): bool = reach(2)
@export("cores3ConfigureExpander")
fun cores3ConfigureExpanderHook(expander: Aw9523, request: bool): bool { if (!request) bad = true; reach(3) }
@exportLocal("abla_m5boardid_configureCoreS3SpiPins")
fun mockM5BoardIdConfigureCoreS3SpiPins(recv: int, gate: PeripheralGate, owner: u32): SpiTransactionResult = SpiTransactionResult(if (reach(4)) 1 else 2)
@exportLocal("abla_m5boardid_prepareCoreS3SdSpi")
fun mockM5BoardIdPrepareCoreS3SdSpi(recv: int, gate: PeripheralGate, owner: u32): SpiTransactionResult = SpiTransactionResult(if (reach(5)) 1 else 4)
@export("cores3DisplayReset")
fun cores3DisplayResetHook(expander: Aw9523): bool = reach(6)
@export("cores3DetectPanel")
fun cores3DetectPanelHook(touch: Ft5x06): int = if (reach(7)) revision else -1
@exportLocal("abla_m5boardid_beginCoreS3SoftwareDisplay")
fun mockM5BoardIdBeginCoreS3SoftwareDisplay(recv: int, gate: PeripheralGate, owner: u32, panel: int, halfPeriodMicroseconds: int): SpiTransactionResult {
    if (panel != revision) bad = true
    SpiTransactionResult(if (reach(8)) 1 else 6)
}
@export("cores3DisplaySetBrightness")
fun cores3DisplaySetBrightnessHook(power: Axp2101, brightness: int): bool {
    if (brightness == 0) { cleanupCalls = cleanupCalls + 1; return !cleanFails }
    if (brightness != 100) bad = true
    reach(10)
}
@exportLocal("abla_m5boardid_clearCoreS3SoftwareDisplay")
fun mockM5BoardIdClearCoreS3SoftwareDisplay(recv: int, gate: PeripheralGate, owner: u32, halfPeriodMicroseconds: int): SpiTransactionResult = SpiTransactionResult(if (reach(9)) 1 else 4)
fun run(): CoreS3DisplayInitResult = M5BoardId(10).initializeCoreS3Display(Axp2101(1), Aw9523(2), Ft5x06(3), PeripheralGate(4), u32(7), true, 100)
fun main(): int {
    while (revision <= 2) {
        step = 0
        val result = run()
        if (!result.valid() || result.panel() != revision || step != 10 || cleanupCalls != 0 || bad) return 1
        revision = revision + 1
    }
    revision = 1
    fail = 2
    while (fail <= 10) {
        var cleanup = 0
        while (cleanup < 2) {
            step = 0
            cleanupCalls = 0
            cleanFails = cleanup == 1
            val result = run()
            if (result.valid() || result.status() != fail + 1 || step != fail || cleanupCalls != 1 || result.cleanup() != cleanup + 1 || bad) return 2
            val detail = if (fail == 4) 2 else if (fail == 5 || fail == 9) 4 else if (fail == 7) -1 else if (fail == 8) 6 else 0
            if (result.detail() != detail) return 3
            cleanup = cleanup + 1
        }
        fail = fail + 1
    }
    step = 0
    cleanupCalls = 0
    if (M5BoardId(0).initializeCoreS3Display(Axp2101(1), Aw9523(2), Ft5x06(3), PeripheralGate(4), u32(7), true, 100).status() != 2 || step != 0 || cleanupCalls != 0) return 4
    if (M5BoardId(10).initializeCoreS3Display(Axp2101(1), Aw9523(2), Ft5x06(3), PeripheralGate(4), u32(7), true, 256).status() != 2 || step != 0 || cleanupCalls != 0) return 5
    if (M5BoardId(10).initializeCoreS3Display(Axp2101(1), Aw9523(2), Ft5x06(3), PeripheralGate(0), u32(7), true, 100).status() != 2 || step != 0 || cleanupCalls != 0) return 6
    fail = 0
    revision = 0
    cleanFails = false
    val unknown = run()
    if (unknown.status() != 8 || unknown.detail() != 0 || step != 7 || cleanupCalls != 1 || bad) return 7
    0
}
