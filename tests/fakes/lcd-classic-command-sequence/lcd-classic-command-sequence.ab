import "../../../src/display/lcd_logic.ab"
import "../../../src/display/spi_lcd_command_sequence_esp32.ab"
import "abla/unsafe/memory/raw"
import "../../../src/hal/esp32.ab"
import "../../../src/hal/pin.ab"
import "../../../src/display/spilcd_type.ab"
import "../../../src/hal/spilcd.ab"
import "../../../src/hal/spidevice.ab"
import "../../../src/esp32/spidevice_type.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/hal/native_buffer.ab"
var acquired = false
var admissionFails = false
var acquisitions = 0
var releases = 0
var transfers = 0
var failAt = 0
var dc = true
var transitions = 0
var delayed = 0
var bad = false
var programMode = false
var command = 0
var argument = 0
@exportLocal("abla_spilcd_valid")
fun mockSpiLcdValid(recv: int): bool = recv == 1
@exportLocal("abla_spilcd_device")
fun mockSpiLcdDevice(recv: int): SpiDevice = SpiDevice(1)
@exportLocal("abla_spilcd_dataCommandPin")
fun mockSpiLcdDataCommandPin(recv: int): Pin = Pin(2)
@export("nativeBufferAt")
fun nativeBufferAtHook(address: int, size: int): NativeBuffer = NativeBuffer(size)
@exportLocal("abla_mocknb_hasAddressRange")
fun mockNativeBufferHasAddressRange(recv: int, offset: int, length: int): bool = offset == 0 && length >= 0 && length <= recv
@exportLocal("abla_mocknb_store")
fun mockNativeBufferStore(recv: int, offset: int, value: int): bool {
    if (offset != 0 || (recv != 1 && recv != 127)) bad = true
    if (recv == 1) command = value else argument = value
    true
}
@exportLocal("abla_spidevice_acquire")
fun mockSpiDeviceAcquire(recv: int): bool {
    acquisitions = acquisitions+1
    if (acquired) bad = true
    acquired = !admissionFails
    acquired
}
@exportLocal("abla_spidevice_release")
fun mockSpiDeviceRelease(recv: int): void {
    if (!acquired || !dc) bad = true
    releases = releases+1
    acquired = false
    return
}
@exportLocal("abla_pin_write")
fun pinWriteHook(pin: int, value: bool): void {
    if (!acquired || Pin(pin) != 2) bad = true
    transitions = transitions+1
    dc = value
    return
}
@exportLocal("abla_spidevice_writeWithFlags")
fun mockSpiDeviceWriteWithFlags(recv: int, data: NativeBuffer, length: int, flags: int): bool {
    if (!acquired) bad = true
    transfers = transfers+1
    if (!dc) {
        if (length != 1 || data != 1) bad = true
        if (programMode && command != (if (transfers == 1) 17 else 41)) bad = true
        if (flags != (if (transfers == 1) spiKeepChipSelect else 0)) bad = true
    } else {
        if (flags != 0 || length != (if (programMode) 1 else 3) ||
            (programMode && argument != 171)) bad = true
    }
    transfers != failAt
}
@export("taskDelay")
fun taskDelayHook(duration: int): void {
    if (!acquired || !dc || (failAt != 0 && transfers >= failAt)) bad = true
    delayed = delayed+duration
    return
}
fun resetTest(): void {
    acquisitions=0; releases=0; transfers=0; transitions=0; delayed=0
    acquired=false; dc=true; bad=false
    return
}
fun main(): int {
    failAt = 0
    while (failAt <= 3) {
        programMode=true
        resetTest()
        val result = SpiLcd(1).runCommandProgram("\x11\x81\xab\x05\x29\x80\xff\xff\xff")
        if (result != (failAt == 0) || transfers != (if (failAt == 0) 3 else failAt) ||
            delayed != (if (failAt == 0) 505 else if (failAt == 3) 5 else 0) ||
            acquisitions != 1 || releases != 1 || acquired || !dc || bad) return 1
        failAt=failAt+1
    }
    programMode=false
    failAt=0
    while (failAt <= 2) {
        resetTest()
        if (SpiLcd(1).writeCommand(42,NativeBuffer(3),3) != (failAt == 0) ||
            transfers != (if (failAt == 0) 2 else failAt) ||
            acquisitions != 1 || releases != 1 || acquired || !dc || bad) return 2
        failAt=failAt+1
    }
    resetTest()
    if (SpiLcd(1).writeCommand(-1,NativeBuffer(3),3) ||
        SpiLcd(1).writeCommand(256,NativeBuffer(3),3) ||
        SpiLcd(1).writeCommand(42,NativeBuffer(3),4) ||
        SpiLcd(1).writeCommand(42,NativeBuffer(3),-1) ||
        SpiLcd(1).runCommandProgram("\x11") || acquisitions != 0 || transitions != 0) return 3
    admissionFails=true
    if (SpiLcd(1).writeCommand(42,NativeBuffer(3),3) || acquisitions != 1 ||
        transfers != 0 || releases != 0 || transitions != 0 || bad) return 4
    0
}
// The NativeBuffer hooks this test does not mock, with the real bodies (this directory's raw_buffer.ab is a copy of src/esp32/sdk/raw_buffer.ab with
// addressValue, hasAddressRange and store as hooks, so a test can mock the buffer).
@exportLocal("abla_mocknb_addressValue")
fun defaultNativeBufferAddressValue(recv: int): int = recv & 4294967295
