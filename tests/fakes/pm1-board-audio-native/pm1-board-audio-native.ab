import "../../../src/i2c/results.ab"
import "../../../src/m5stack/pm1_audio_sequence.ab"
import "../../../src/audio/es8311_device.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../../../src/hal/delay.ab"
import "../../../src/hal/m5stack.ab"
import "../../../src/hal/pin.ab"
import "../../../src/hal/m5stack_3.ab"
import "../../../src/hal/m5ioe1.ab"
import "../../../src/hal/es8311.ab"
type I2cBus=int
type I2cDevice=int
import "../../../src/io_expander/m5ioe1_type.ab"
import "../../../src/m5stack/board_id.ab"
import "abla/unsafe/memory/raw"
import "../../../src/esp32/sdk/raw_buffer.ab"
import "../../../src/m5stack/m5boardid_type.ab"
import "../../../src/audio/es8311_type.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/hal/i2cdevice.ab"
var board=m5BoardStopWatch
var bus=8589934590
var writes=0
var fail=0
var bad=false
var allocated=0
var rail=false
var amp=false
var mode=0
val speakerOracle=nativeStaticU32s([0x8000,0xb501,0x1802,0x010d,0x0012,0x1013,0xef32,0x0837])
val micOracle=nativeStaticU32s([0x8000,0xba01,0x1802,0x010d,0x020e,0x1014,0xff17,0x6a1c])
val offOracle=nativeStaticU32s([0xfc0d,0x6a0e,0x0000])
fun I2cBus.valid(): bool = this == bus
fun I2cBus.device(address: int, frequency: int = 400000): I2cDevice {
    if (this != bus || address != 24 || frequency != 100000) bad=true
    allocated=allocated+1;return I2cDevice(17)
}
fun I2cDevice.close(): bool = this == 17
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    val oracle=if (mode == 0) speakerOracle else if (mode == 1) micOracle else offOracle
    if (this != 17 || !rail || amp || (register|(value<<8)) != nativeAddressLoadU32(oracle,writes*4)) bad=true
    writes=writes+1;return writes != fail
}
@exportLocal("abla_m5ioe1_valid")
fun m5Ioe1ValidHook(recv: int): bool = M5Ioe1(recv) == 3
@exportLocal("abla_m5ioe1_digitalWrite")
fun m5Ioe1DigitalWriteHook(recv: int, pin: int, high: bool): bool {
    if (M5Ioe1(recv) != 3) bad=true
    if (pin == (if (board == m5BoardStopWatch) 2 else 4)) rail=high
    else if (board == m5BoardStopWatch && pin == 9) amp=high
    else bad=true
    return true
}
@exportLocal("abla_m5ioe1_getWriteValueChecked")
fun m5Ioe1GetWriteValueCheckedHook(recv: int, pin: int): I2cByteResult = I2cByteResult(256|(if (pin == 9) (if (amp) 1 else 0) else (if (rail) 1 else 0)))
@exportLocal("abla_pin_outputLevelOwned")
fun pinOutputLevelOwnedHook(pin: int, high: bool): bool { if (Pin(pin) != 21 || board != m5BoardChainCaptain) bad=true;amp=high;return true }
@export("peripheralDelayMilliseconds")
fun peripheralDelayMillisecondsHook(ms: int): void { if (!rail || ms != (if (mode == 0) 10 else 5)) bad=true;return }
@export("pm1BoardAudioAdmission")
fun pm1BoardAudioAdmissionHook(control: int): bool = control == 7
@export("pm1BoardAudioBus")
fun pm1BoardAudioBusHook(control: int): int = bus
@export("pm1BoardAudioBoard")
fun pm1BoardAudioBoardHook(control: int): M5BoardId = board
@export("pm1BoardAudioExpander")
fun pm1BoardAudioExpanderHook(control: int): M5Ioe1 = M5Ioe1(3)
@export("pm1BoardAudioAllocate")
fun pm1BoardAudioAllocateHook(key: int): Es8311 = es8311(I2cBus(key),24,100000)
@export("pm1BoardAudioCodecMatches")
fun pm1BoardAudioCodecMatchesHook(control: int,codec: Es8311): bool = codec == 17
@export("abla_pm1_board_audio_test")
fun test(): i32 {
    var b=0
    while (b < 2) {
        board=if (b == 0) m5BoardStopWatch else m5BoardChainCaptain
        bus=if (b == 0) 4294967293 else 8589934590
        allocated=0
        if (pm1BoardAudioOpenOwned(7,true) != 17 || allocated != 1 || bad) return i32(1)
        mode=0
        while (mode < 3) {
            fail=0
            val count=if (mode == 2) 3 else 8
            while (fail <= count) {
                rail=mode == 2;amp=false;writes=0;bad=false
                val result=if (mode == 0) pm1BoardSpeakerOwned(7,Es8311(17),true,true)
                    else pm1BoardMicrophoneOwned(7,Es8311(17),mode == 1,true)
                if (bad || writes != (if (fail == 0) count else fail) ||
                    result != (if (fail == 0) 1 else 5|((fail+2)<<8)) ||
                    amp != (mode == 0 && fail == 0)) return i32(2)
                if (pm1BoardSpeakerOwned(7,Es8311(0),false,true) != 1 || rail || amp || bad) return i32(3)
                fail=fail+1
            }
            mode=mode+1
        }
        b=b+1
    }
    writes=0;allocated=0
    if (pm1BoardAudioOpenOwned(0,true) != 0 || pm1BoardAudioOpenOwned(7,false) != 0 ||
        pm1BoardSpeakerOwned(7,Es8311(18),true,true) != 8 ||
        pm1BoardMicrophoneOwned(7,Es8311(18),false,true) != 8 ||
        pm1BoardSpeakerOwned(7,Es8311(17),true,false) != 8 ||
        pm1BoardMicrophoneOwned(0,Es8311(17),true,true) != 8 || writes != 0 || allocated != 0) return i32(4)
    return i32(0)
}

// The shared I2C module's remaining declarations (this program is its remap target: it declares all of them).
fun I2cDevice.valid(): bool = false
trusted fun I2cDevice.write(source: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.read(destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int, destination: NativeBuffer,
    destinationLength: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
trusted fun I2cBus.close(): bool = false
