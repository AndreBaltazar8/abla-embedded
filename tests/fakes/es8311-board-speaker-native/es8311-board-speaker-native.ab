import "../../../src/hal/m5boardid_es8311.ab"
import "../../../src/i2c/results.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/m5stack/es8311_speaker_sequence.ab"
import "../../../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../../../src/hal/pin.ab"
import "../../../src/hal/m5ioe1.ab"
import "../../../src/hal/m5pm1.ab"
import "../../../src/hal/es8311.ab"
import "../../../src/audio/es8311_type.ab"
import "../../../src/power/m5pm1_type.ab"
import "../../../src/io_expander/m5ioe1_type.ab"
import "abla/unsafe/memory/raw"
import "../../../src/m5stack/board_id.ab"
import "../../../src/m5stack/m5boardid_type.ab"
@exportLocal("abla_es8311_valid")
fun es8311ValidHook(recv: int): bool = Es8311(recv) == 2
@exportLocal("abla_m5pm1_valid")
fun m5Pm1ValidHook(recv: int): bool = M5Pm1(recv) == 3
val order=nativeStaticU32s([3,4,0,0, 3,4,5,0, 6,3,0,0, 3,6,5,0, 0,0,0,0, 5,0,0,0, 6,0,0,0, 5,6,0,0])
val counts=nativeStaticU32s([2,3,2,3,0,1,1,2])
var row=0
var calls=0
var fail=0
var board=m5BoardStickS3
var enabled=false
var mismatch=false
var bad=false
trusted fun step(event: int): bool {
    if (event != nativeAddressLoadU32(order,(row*4+calls)*4)) bad=true
    calls=calls+1;return calls != fail
}
@exportLocal("abla_m5pm1_setGpioOutput")
trusted fun m5Pm1SetGpioOutputHook(recv: int, pin: int,high: bool): bool {
    if (M5Pm1(recv) != 3 || board != m5BoardStickS3 || pin != 3 || high != enabled) bad=true
    return step(3)
}
@exportLocal("abla_m5pm1_gpioOutputLatchBitsChecked")
trusted fun m5Pm1GpioOutputLatchBitsCheckedHook(recv: int): I2cByteResult {
    if (!step(4)) return I2cByteResult(if (mismatch) 256|(if (enabled) 0 else 8) else 0)
    return I2cByteResult(256|(if (enabled) 8 else 0))
}
@exportLocal("abla_es8311_configureSpeakerBclkOwned")
trusted fun es8311ConfigureSpeakerBclkOwnedHook(recv: int, exclusive: bool, volume: int): int {
    val expected=if (board == m5BoardPaperColor) 207 else if (board == m5BoardAtomVoiceS3R) 255 else 191
    if (Es8311(recv) != 2 || !exclusive || !enabled || volume != expected) bad=true
    return if (step(5)) 1 else 10
}
@exportLocal("abla_pin_outputLevelOwned")
trusted fun pinOutputLevelOwnedHook(pin: int, high: bool): bool {
    if (high != enabled || (board == m5BoardPaperColor && Pin(pin) != 45 && Pin(pin) != 46) ||
        (board == m5BoardAtomVoiceS3R && Pin(pin) != 18)) bad=true
    return step(if (Pin(pin) == 45) 3 else 6)
}
@exportLocal("abla_m5boardid_ioe1Es8311SpeakerOwned")
fun m5BoardIdIoe1Es8311SpeakerOwnedHook(recv: int, codec: Es8311, io: M5Ioe1, high: bool, exclusive: bool): int {
    if ((M5BoardId(recv) != m5BoardStopWatch && M5BoardId(recv) != m5BoardChainCaptain) || codec != Es8311(2) || io != M5Ioe1(4) || !exclusive) bad=true
    return 7
}
@export("abla_es8311_board_speaker_test")
trusted fun test(): i32 {
    while (row < 8) {
        board=if (row < 2) m5BoardStickS3 else if (row < 4) m5BoardPaperColor else if (row < 6) m5BoardCardputerADV else m5BoardAtomVoiceS3R
        enabled=(row&1) != 0
        val count=nativeAddressLoadU32(counts,row*4)
        var variant=0
        while (variant < 2) {
            mismatch=variant == 1;fail=0
            while (fail <= count) {
                calls=0
                val event=if (fail == 0) 1 else nativeAddressLoadU32(order,(row*4+fail-1)*4)
                val expected=if (event == 5) 5|(10<<8) else event
                if (board.es8311SpeakerOwned(Es8311(if (enabled) 2 else 0),M5Pm1(if (board == m5BoardStickS3) 3 else 0),M5Ioe1(0),enabled,true) != expected ||
                    calls != (if (fail == 0) count else fail) || bad) return i32(1)
                fail=fail+1
            }
            variant=variant+1
        }
        row=row+1
    }
    calls=0
    if (m5BoardStickS3.es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(0),true,true) != 2 ||
        m5BoardCardputerADV.es8311SpeakerOwned(Es8311(0),M5Pm1(0),M5Ioe1(0),true,true) != 2 ||
        m5BoardPaperColor.es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(0),true,false) != 2 ||
        M5BoardId(0).es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(0),true,true) != 2 || calls != 0) return i32(2)
    if (m5BoardStopWatch.es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(4),true,true) != 7 ||
        m5BoardChainCaptain.es8311SpeakerOwned(Es8311(2),M5Pm1(0),M5Ioe1(4),false,true) != 7 || bad) return i32(3)
    return i32(0)
}
// The rest of the I2C contract (src/i2c/device.ab): declared, never called by this test.
type I2cBus = int
type I2cDevice = int
fun I2cDevice.valid(): bool = false
trusted fun I2cDevice.close(): bool = false
trusted fun I2cDevice.write(source: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.read(destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int, destination: NativeBuffer,
    destinationLength: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool = false
fun I2cBus.valid(): bool = false
trusted fun I2cBus.close(): bool = false
trusted fun I2cBus.device(address: int, frequency: int = 400000): I2cDevice = I2cDevice(0)
