import "../../../src/display/lcd_logic.ab"
import "../../../src/display/color.ab"
import "../../../src/display/spi_lcd_fill_sequence_esp32.ab"
import "abla/unsafe/memory/raw"
import "../../../src/display/spilcd_type.ab"
import "../../../src/hal/spilcd.ab"
import "../../../src/hal/spidevice.ab"
import "../../../src/esp32/spidevice_type.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/hal/native_buffer.ab"
var owned=false
var busy=false
var bad=false
var calls=0
var failAt=0
var acquires=0
var releases=0
var stores=0
var sent=0
var width=0
@exportLocal("abla_spilcd_valid")
fun mockSpiLcdValid(recv: int): bool = recv == 1
@exportLocal("abla_spilcd_device")
fun mockSpiLcdDevice(recv: int): SpiDevice = SpiDevice(1)
@export("nativeBufferAt")
fun nativeBufferAtHook(address: int,size: int): NativeBuffer = NativeBuffer(size)
@exportLocal("abla_mocknb_store")
fun mockNativeBufferStore(recv: int, offset: int,value: int): bool {
    if (!owned || recv != 512 || offset != stores ||
        (value & 255) != (if ((offset & 1) == 0) 18 else 52)) bad=true
    stores=stores+1
    true
}
@exportLocal("abla_spidevice_acquire")
fun mockSpiDeviceAcquire(recv: int): bool {
    acquires=acquires+1
    owned=!busy
    owned
}
@exportLocal("abla_spidevice_release")
fun mockSpiDeviceRelease(recv: int): void {
    if (!owned) bad=true
    releases=releases+1; owned=false
    return
}
@exportLocal("abla_spilcd_setWindowSelected")
fun mockSpiLcdSetWindowSelected(recv: int, view: LcdView,x: int,y: int,w: int,h: int): bool {
    calls=calls+1
    if (!owned || x != 0 || y != 0 || w != width || h != 1) bad=true
    calls != failAt
}
@exportLocal("abla_spilcd_writeCommandSelected")
fun mockSpiLcdWriteCommandSelected(recv: int, command: int,data: NativeBuffer,length: int,keep: bool): bool {
    calls=calls+1
    if (!owned || command != 44 || data != 0 || length != 0 || !keep) bad=true
    calls != failAt
}
@exportLocal("abla_spidevice_writeWithFlags")
fun mockSpiDeviceWriteWithFlags(recv: int, data: NativeBuffer,length: int,flags: int): bool {
    calls=calls+1
    val count=if (width-sent > 256) 256 else width-sent
    if (!owned || data != 512 || length != count*2 || stores < length ||
        flags != (if (sent+count < width) spiKeepChipSelect else 0)) bad=true
    sent=sent+count
    calls != failAt
}
fun resetTest(): void {
    owned=false; bad=false; calls=0; acquires=0; releases=0; stores=0; sent=0
    return
}
fun main(): int {
    val lcd=SpiLcd(1)
    val view=lcdViewValue(600,2,0,0,0)
    width=1
    while (width <= 513) {
        failAt=0
        val expectedCalls=2+(width+255)/256
        while (failAt <= expectedCalls) {
            resetTest()
            if (lcd.fillRect(view,-1,-1,width+1,2,Rgb565(4660)) != (failAt == 0) ||
                calls != (if (failAt == 0) expectedCalls else failAt) ||
                acquires != 1 || releases != 1 || owned || bad ||
                stores != (if (failAt == 1 || failAt == 2) 0 else (if (width < 256) width else 256)*2)) return 1
            failAt=failAt+1
        }
        width=if (width == 1) 255 else if (width == 255) 256 else if (width == 256) 257 else if (width == 257) 513 else 514
    }
    resetTest()
    if (lcd.fillRect(view,0,0,-1,1,Rgb565(0)) || lcd.fill(LcdView(0),Rgb565(0)) ||
        !lcd.fillRect(view,700,0,1,1,Rgb565(0)) || acquires != 0 || stores != 0) return 2
    busy=true
    if (lcd.fillRect(view,0,0,1,1,Rgb565(0)) || acquires != 1 || releases != 0 || calls != 0) return 3
    0
}
// The NativeBuffer hooks this test does not mock, with the real bodies (this directory's raw_buffer.ab is a copy of src/esp32/sdk/raw_buffer.ab with
// addressValue, hasAddressRange and store as hooks, so a test can mock the buffer).
@exportLocal("abla_mocknb_addressValue")
fun defaultNativeBufferAddressValue(recv: int): int = recv & 4294967295
@exportLocal("abla_mocknb_hasAddressRange")
fun defaultNativeBufferHasAddressRange(recv: int, offset: int, count: int): bool {
    val capacity = (recv >>> 32) & 2147483647
    val address = recv & 4294967295
    if (offset < 0 || count < 0 || offset > capacity || count > capacity - offset) return false
    if (count == 0) return true
    address != 0 && address + offset <= 4294967296 - count
}
