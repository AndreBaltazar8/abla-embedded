import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/led/papermono_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../../../src/power/m5pm1_type.ab"
import "../../../src/io_expander/m5ioe1_type.ab"
import "../../../src/hal/m5ioe1.ab"
import "../../../src/hal/m5pm1.ab"
import "../../../src/hal/i2cdevice.ab"
type I2cDevice = int
@exportLocal("abla_m5pm1_valid")
fun m5Pm1ValidHook(recv: int): bool = M5Pm1(recv) != 0
@exportLocal("abla_m5ioe1_valid")
fun m5Ioe1ValidHook(recv: int): bool = M5Ioe1(recv) != 0
@exportLocal("abla_m5pm1_device")
fun m5Pm1DeviceHook(recv: int): I2cDevice = I2cDevice(M5Pm1(recv) & 4294967295)
var calls = 0
var failAt = 0
var bad = false
trusted fun step(): bool { calls = calls + 1; calls != failAt }
@exportLocal("abla_i2cdevice_updateRegister8")
trusted fun i2cDeviceUpdateRegister8Hook(recv: int, reg: int, mask: int, value: int): bool { if (calls != 0 || reg != 19 || mask != 32 || value != 0) bad = true; step() }
@exportLocal("abla_m5ioe1_setDirection")
trusted fun m5Ioe1SetDirectionHook(recv: int, pin: int, output: bool): bool { if (pin != calls + 7 || !output) bad = true; step() }
@exportLocal("abla_m5ioe1_setHighImpedance")
trusted fun m5Ioe1SetHighImpedanceHook(recv: int, pin: int, enabled: bool): bool { if (pin != calls + 5 || enabled) bad = true; step() }
@exportLocal("abla_m5pm1_setLedEnableLevel")
trusted fun m5Pm1SetLedEnableLevelHook(recv: int, high: bool): bool { if (calls != 0 || !high) bad = true; step() }
@exportLocal("abla_m5ioe1_digitalWrite")
trusted fun m5Ioe1DigitalWriteHook(recv: int, pin: int, high: bool): bool { if (pin != calls + 7 || high != (pin == 8)) bad = true; step() }
@exportLocal("abla_m5ioe1_setPwmDuty12")
trusted fun m5Ioe1SetPwmDuty12Hook(recv: int, channel: int, duty: int, inverted: bool, enabled: bool): bool { if (calls != 3 || channel != 1 || duty != 4095 || inverted || !enabled) bad = true; step() }
trusted fun paperMonoLedTest(): int {
    while (failAt <= 5) {
        calls = 0
        if (paperMonoLedConfigure(M5Pm1(1), M5Ioe1(1)) != (failAt == 0) || calls != (if (failAt == 0) 5 else failAt) || bad) return 1
        failAt = failAt + 1
    }
    failAt = 0
    while (failAt <= 4) {
        calls = 0
        if (paperMonoLedWrite(M5Pm1(1), M5Ioe1(1), 255, 255, 0, 255) != (failAt == 0) || calls != (if (failAt == 0) 4 else failAt) || bad) return 2
        failAt = failAt + 1
    }
    var brightness = 0
    while (brightness <= 255) {
        var component = 0
        while (component <= 255) {
            val raw = component * (brightness + 1) * (brightness + 1) / 256
            val expected = (if (raw >= 2048) 7 else 0) | ((if (raw > 4095) 4095 else raw) << 3)
            if (paperMonoLedLevels(component, component, component, brightness) != expected) return 3
            component = component + 1
        }
        brightness = brightness + 1
    }
    calls = 0
    if (paperMonoLedWrite(M5Pm1(1), M5Ioe1(1), 256, 0, 0, 255) || paperMonoLedConfigure(M5Pm1(0), M5Ioe1(1)) || calls != 0) return 4
    0
}
#exportFunction("paperMonoLedTest", "abla_papermono_led_test")
// The rest of the I2C contract (src/i2c/device.ab): declared, never called by this test.
type I2cBus = int
fun I2cDevice.valid(): bool = false
trusted fun I2cDevice.close(): bool = false
trusted fun I2cDevice.write(source: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.read(destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int, destination: NativeBuffer,
    destinationLength: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool = false
fun I2cBus.valid(): bool = false
trusted fun I2cBus.close(): bool = false
trusted fun I2cBus.device(address: int, frequency: int = 400000): I2cDevice = I2cDevice(0)
