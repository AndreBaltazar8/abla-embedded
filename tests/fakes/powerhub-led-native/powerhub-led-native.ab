import "../../../src/i2c/results.ab"
import "../../../src/led/powerhub_raw.ab"
import "abla/runtime/scalar"
import "abla/build"
import "abla/unsafe/memory/raw"
import "../../../src/esp32/sdk/raw_buffer.ab"
import "../../../src/hal/native_buffer.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/hal/i2cdevice.ab"
type I2cBus = int
type I2cDevice = int
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int, hz: int): I2cDevice = I2cDevice(if (address == 80 && hz == 400000) 1 else 0)
fun I2cDevice.close(): bool = this != 0
var calls = 0
var succeed = true
var expectedRegister = 0
var expectedBytes = 0
var bad = false
val colorsAddress = nativeStaticMutableU32s([0,0,0,0,0,0,0,0])
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool {
    calls = calls + 1
    if (register != 0 || value != 1) bad = true
    succeed
}
trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, bytes: int, timeoutMilliseconds: int = 1000): bool {
    calls = calls + 1
    if (register != expectedRegister || bytes != expectedBytes || source.addressValue() != colorsAddress) bad = true
    succeed
}
trusted fun powerHubLedTest(): int {
    val leds = powerHubLedRaw(I2cBus(1))
    val colors = nativeBufferAt(colorsAddress, 32)
    if (!leds.valid() || powerHubLedRaw(I2cBus(0)).valid()) return 1
    var variant = 0
    while (variant < 2) {
        succeed = variant == 0; calls = 0
        if (leds.enable() != succeed || calls != 1 || bad) return 2
        expectedRegister = 128; expectedBytes = 8; calls = 0
        if (leds.writeBrightness(colors) != succeed || calls != 1 || bad) return 3
        expectedRegister = 96; expectedBytes = 32; calls = 0
        if (leds.writeColors(colors) != succeed || calls != 1 || bad) return 4
        variant = variant + 1
    }
    var index = 0
    while (index < 8) {
        colors.store(index * 4 + 3, 1); calls = 0
        if (leds.writeColors(colors) || calls != 0) return 5
        colors.store(index * 4 + 3, 0); index = index + 1
    }
    calls = 0
    if (leds.writeColors(nativeBufferAt(colorsAddress, 31)) ||
        leds.writeBrightness(nativeBufferAt(colorsAddress, 7)) ||
        PowerHubLedRaw(0).enable() || calls != 0 || !leds.close()) return 6
    0
}
#exportFunction("powerHubLedTest", "abla_powerhub_led_test")

// The shared I2C module's remaining declarations (this program is its remap target: it declares all of them).
fun I2cDevice.valid(): bool = false
trusted fun I2cDevice.write(source: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.read(destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int, destination: NativeBuffer,
    destinationLength: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
trusted fun I2cBus.close(): bool = false
