import "../../../src/i2c/helpers/register_address16.ab"
import "../../../src/esp32/sdk/raw_buffer.ab"
import "../../../src/i2c/results.ab"
import "../../../src/hal/native_buffer.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/hal/i2cdevice.ab"
type I2cDevice = int
var calls = 0
fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int,
    destination: NativeBuffer, length: int, timeout: int): bool {
    calls = calls + 1
    return false
}
fun I2cDevice.write(source: NativeBuffer, length: int, timeout: int): bool {
    calls = calls + 1
    return false
}
trusted fun main(): int {
    val device = I2cDevice(1)
    val buffer = nativeBufferAt(4096, 4)
    if (device.readRegisterAddress16(-1, buffer, 1) || device.readRegisterAddress16(65536, buffer, 1) ||
        device.readRegisterAddress16(0, buffer, -1) || device.readRegisterAddress16(0, buffer, 5) ||
        device.readRegisterAddress16(0, nativeBufferAt(4294967295, 4), 4)) return 1
    if (device.writeRegisterAddress16Byte(-1, 0) || device.writeRegisterAddress16Byte(65536, 0) ||
        device.writeRegisterAddress16Byte(0, -1) || device.writeRegisterAddress16Byte(0, 256) || calls != 0) return 2
    // Failure propagates without reading an unwritten receive cell.
    if (device.readRegisterAddress16ByteChecked(65535).valid() || calls != 1) return 3
    if (device.writeRegisterAddress16Byte(65535, 255) || calls != 2) return 4
    return 0
}
fun I2cDevice.valid(): bool = false
trusted fun I2cDevice.close(): bool = false
trusted fun I2cDevice.read(destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool = false
type I2cBus = int
fun I2cBus.valid(): bool = false
trusted fun I2cBus.close(): bool = false
trusted fun I2cBus.device(address: int, frequency: int = 400000): I2cDevice = I2cDevice(0)
