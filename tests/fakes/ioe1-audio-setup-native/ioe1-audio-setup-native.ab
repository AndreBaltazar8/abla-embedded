import "../../../src/i2c/results.ab"
import "../../../src/m5stack/ioe1_audio_setup.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../../../src/hal/m5ioe1.ab"
import "abla/unsafe/memory/raw"
import "../../../src/esp32/sdk/raw_buffer.ab"
import "../../../src/m5stack/board_id.ab"
import "../../../src/io_expander/m5ioe1_type.ab"
import "../../../src/hal/native_buffer.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/hal/i2cdevice.ab"
type I2cBus=int
type I2cDevice=int
var calls=0
var failure=0
var bad=false
var initial=0
val registers=nativeStaticAllocate(24)
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int, timeoutMilliseconds: int = 1000): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int, timeoutMilliseconds: int = 1000): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
@exportLocal("abla_i2cdevice_writeRegister16LittleEndian")
fun i2cDeviceWriteRegister16LittleEndianHook(recv: int, register: int,value: int): bool { bad=true; return false }

// Independent register oracle from upstream enum values, not board helpers.
val watchOps=nativeStaticU32s([19,4,0,20,2,0,3,4,4,4,2,2,5,4,0,6,2,0])
val chainOps=nativeStaticU32s([19,16,0,3,16,16,5,16,0])
var ops=0
var count=0
@exportLocal("abla_i2cdevice_updateRegister8")
trusted fun i2cDeviceUpdateRegister8Hook(recv: int, register: int,mask: int,value: int): bool {
    val index=calls
    calls=calls+1
    if (I2cDevice(recv) != 8 || index >= count) { bad=true; return false }
    if (register != nativeAddressLoadU32(ops,index*12) ||
        mask != nativeAddressLoadU32(ops,index*12+4) ||
        value != nativeAddressLoadU32(ops,index*12+8)) bad=true
    if (calls == failure) return false
    val buffer=nativeBufferAt(registers,24)
    buffer.store(register,(buffer.load(register)&~mask)|value)
    return true
}
@export("abla_ioe1_audio_setup_test")
trusted fun test(): i32 {
    var route=0
    while (route < 2) {
        val board=if (route == 0) m5BoardStopWatch else m5BoardChainCaptain
        ops=if (route == 0) watchOps else chainOps
        count=if (route == 0) 6 else 3
        initial=0
        while (initial < 256) {
            failure=0
            while (failure <= count) {
                val buffer=nativeBufferAt(registers,24)
                var r=0
                while (r < 24) { buffer.store(r,initial); r=r+1 }
                calls=0; bad=false
                val result=board.prepareIoeAudioOwned(M5Ioe1(8),true)
                val applied=if (failure == 0) count else failure-1
                if (result != ((if (failure == 0) 1 else 4)|(applied<<8)) ||
                    calls != (if (failure == 0) count else failure) || bad) return i32(1)
                r=0
                while (r < 24) {
                    var expected=initial
                    var step=0
                    while (step < applied) {
                        if (r == nativeAddressLoadU32(ops,step*12)) {
                            expected=(expected&~nativeAddressLoadU32(ops,step*12+4))|
                                nativeAddressLoadU32(ops,step*12+8)
                        }
                        step=step+1
                    }
                    if (buffer.load(r) != expected) return i32(2)
                    r=r+1
                }
                failure=failure+1
            }
            initial=initial+1
        }
        calls=0
        if (board.prepareIoeAudioOwned(M5Ioe1(8),false) != 3 ||
            board.prepareIoeAudioOwned(M5Ioe1(0),true) != 3 ||
            board.prepareIoeAudioOwned(M5Ioe1(-1),true) != 3 ||
            board.prepareIoeAudioOwned(M5Ioe1(4294967296),true) != 3 || calls != 0) return i32(3)
        route=route+1
    }
    if (m5BoardCoreP4X.prepareIoeAudioOwned(M5Ioe1(8),true) != 2 || calls != 0) return i32(4)
    return i32(0)
}
// The rest of the I2C contract (src/i2c/device.ab): declared, never called by this test.
fun I2cDevice.valid(): bool = false
trusted fun I2cDevice.write(source: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.read(destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int, destination: NativeBuffer,
    destinationLength: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
trusted fun I2cBus.close(): bool = false
