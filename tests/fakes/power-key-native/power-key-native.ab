import "../../../src/power/key_event.ab"
import "../../../src/i2c/results.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../../../src/hal/i2cdevice.ab"
type I2cBus = int
type I2cDevice = int
var raw=0
var readOk=true
var writeOk=true
var writes=0
var written=0
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult =
    I2cByteResult(if (readOk) 256 | raw else 0)
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool {
    writes=writes+1; written=value; writeOk
}
@export("abla_power_key_test")
trusted fun keyTest(): i32 {
    var model=0
    while (model < 2) {
        val mask=if (model == 0) 3 else 12
        val shift=if (model == 0) 0 else 2
        raw=0
        while (raw < 256) {
            var failure=0
            while (failure < 3) {
                readOk=failure != 1; writeOk=failure != 2; writes=0; written=0
                val result=powerKeyReadAndClear(I2cDevice(1),if (model == 0) 70 else 73,mask,shift)
                val selected=raw & mask
                val expectedStatus=if (!readOk) 1 else if (selected != 0 && !writeOk) 2 else 3
                if (result.status() != expectedStatus || result.valid() != (expectedStatus == 3) ||
                    result.observed() != (if (readOk) selected >>> shift else 0) ||
                    writes != (if (readOk && selected != 0) 1 else 0) ||
                    (writes != 0 && written != selected)) return i32(1)
                failure=failure+1
            }
            raw=raw+1
        }
        model=model+1
    }
    i32(0)
}

// The shared I2C module's remaining declarations (this program is its remap target: it declares all of them).
fun I2cDevice.valid(): bool = false
trusted fun I2cDevice.close(): bool = false
trusted fun I2cDevice.write(source: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.read(destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int, destination: NativeBuffer,
    destinationLength: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
fun I2cBus.valid(): bool = false
trusted fun I2cBus.close(): bool = false
trusted fun I2cBus.device(address: int, frequency: int = 400000): I2cDevice = I2cDevice(0)
