trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool = false
