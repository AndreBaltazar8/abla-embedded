import "../../../src/i2c/results.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/m5stack/ioe1_es8311_speaker_sequence.ab"
import "../../../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../../../src/hal/delay.ab"
import "../../../src/hal/pin.ab"
import "../../../src/hal/m5ioe1.ab"
import "../../../src/hal/es8311.ab"
import "../../../src/audio/es8311_type.ab"
import "../../../src/io_expander/m5ioe1_type.ab"
import "abla/unsafe/memory/raw"
import "../../../src/m5stack/board_id.ab"
@exportLocal("abla_es8311_valid")
fun es8311ValidHook(recv: int): bool = Es8311(recv) == 2
@exportLocal("abla_m5ioe1_valid")
fun m5Ioe1ValidHook(recv: int): bool = M5Ioe1(recv) == 3
val enableEvents=nativeStaticU32s([3,4,8,5,6,7])
val disableWatchEvents=nativeStaticU32s([6,7,3,4])
val disableChainEvents=nativeStaticU32s([6,3,4])
var events=0
var calls=0
var fail=0
var watch=false
var enabled=false
var mismatch=false
var bad=false
trusted fun step(event: int): bool {
    if (event != nativeAddressLoadU32(events,calls*4)) bad=true
    calls=calls+1
    return calls != fail
}
@exportLocal("abla_m5ioe1_digitalWrite")
trusted fun m5Ioe1DigitalWriteHook(recv: int, pin: int, high: bool): bool {
    if (M5Ioe1(recv) != 3 || high != enabled || (pin != 9 && pin != (if (watch) 2 else 4))) bad=true
    return step(if (pin == 9) 6 else 3)
}
@exportLocal("abla_m5ioe1_getWriteValueChecked")
trusted fun m5Ioe1GetWriteValueCheckedHook(recv: int, pin: int): I2cByteResult {
    if (M5Ioe1(recv) != 3 || (pin != 9 && pin != (if (watch) 2 else 4))) bad=true
    if (!step(if (pin == 9) 7 else 4)) return I2cByteResult(if (mismatch) 256|(if (enabled) 0 else 1) else 0)
    return I2cByteResult(256|(if (enabled) 1 else 0))
}
@export("peripheralDelayMilliseconds")
trusted fun peripheralDelayMillisecondsHook(ms: int): void {
    if (ms != 10 || !enabled) bad=true
    step(8);return
}
@exportLocal("abla_es8311_configureSpeakerBclkOwned")
trusted fun es8311ConfigureSpeakerBclkOwnedHook(recv: int, exclusive: bool, volume: int): int {
    if (Es8311(recv) != 2 || !exclusive || volume != 239 || !enabled) bad=true
    return if (step(5)) 1 else 9
}
@exportLocal("abla_pin_outputLevelOwned")
trusted fun pinOutputLevelOwnedHook(pin: int, high: bool): bool {
    if (Pin(pin) != 21 || watch || high != enabled) bad=true
    return step(6)
}
@export("abla_ioe1_es8311_speaker_test")
trusted fun test(): i32 {
    var variant=0
    while (variant < 8) {
        watch=(variant&1) != 0;enabled=(variant&2) != 0;mismatch=(variant&4) != 0
        val board=if (watch) m5BoardStopWatch else m5BoardChainCaptain
        events=if (enabled) enableEvents else if (watch) disableWatchEvents else disableChainEvents
        val count=if (enabled) (if (watch) 6 else 5) else if (watch) 4 else 3
        fail=0
        while (fail <= count) {
            calls=0
            val event=if (fail == 0) 0 else nativeAddressLoadU32(events,(fail-1)*4)
            val ignored=event == 0 || event == 8
            val expected=if (ignored) 1 else if (event == 5) 5|(9<<8) else event
            if (board.ioe1Es8311SpeakerOwned(Es8311(if (enabled) 2 else 0),M5Ioe1(3),enabled,true) != expected ||
                calls != (if (ignored) count else fail) || bad) return i32(1)
            fail=fail+1
        }
        variant=variant+1
    }
    calls=0
    if (m5BoardStopWatch.ioe1Es8311SpeakerOwned(Es8311(2),M5Ioe1(3),true,false) != 2 ||
        m5BoardStopWatch.ioe1Es8311SpeakerOwned(Es8311(0),M5Ioe1(3),true,true) != 2 ||
        m5BoardStopWatch.ioe1Es8311SpeakerOwned(Es8311(2),M5Ioe1(0),false,true) != 2 ||
        m5BoardStickS3.ioe1Es8311SpeakerOwned(Es8311(2),M5Ioe1(3),true,true) != 2 || calls != 0) return i32(2)
    return i32(0)
}
// The rest of the I2C contract (src/i2c/device.ab): declared, never called by this test.
type I2cBus = int
type I2cDevice = int
fun I2cDevice.valid(): bool = false
trusted fun I2cDevice.close(): bool = false
trusted fun I2cDevice.write(source: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.read(destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int, destination: NativeBuffer,
    destinationLength: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool = false
fun I2cBus.valid(): bool = false
trusted fun I2cBus.close(): bool = false
trusted fun I2cBus.device(address: int, frequency: int = 400000): I2cDevice = I2cDevice(0)
