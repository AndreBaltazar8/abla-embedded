import "../../../src/display/lcd_logic.ab"
import "../../../src/display/mipi_rgb565_sequence_esp32.ab"
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"
import "../../../src/display/spilcd_type.ab"
import "../../../src/hal/spilcd.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/hal/native_buffer.ab"
var stage = 0
var failAt = 0
var bad = false
var rotation = 0
var stored = 0
@exportLocal("abla_spilcd_valid")
fun mockSpiLcdValid(recv: int): bool = recv == 1
@export("nativeBufferAt")
fun nativeBufferAtHook(address: int, size: int): NativeBuffer = NativeBuffer(size)
@exportLocal("abla_mocknb_store")
fun mockNativeBufferStore(recv: int, index: int, value: int): bool {
    if (recv != 1 || index != 0) bad = true
    stored = value
    true
}
fun next(expected: int): bool {
    stage = stage+1
    if (stage != expected) bad = true
    stage != failAt
}
@exportLocal("abla_spilcd_reset")
fun mockSpiLcdReset(recv: int): void { if (!next(1)) bad = true; return }
@exportLocal("abla_spilcd_runCommandProgram")
fun mockSpiLcdRunCommandProgram(recv: int, program: int, size: int): bool = next(if (size == 4) 2 else 3)
@exportLocal("abla_spilcd_writeCommand")
fun mockSpiLcdWriteCommand(recv: int, command: int, data: NativeBuffer, length: int): bool {
    if (command == 58) {
        if (length != 1 || stored != 85) bad = true
        return next(4)
    }
    if (command == 54) {
        if (length != 1 || stored != lcdMadctl(rotation,true)) bad = true
        return next(5)
    }
    if (command != 33 || length != 0) bad = true
    next(6)
}
@exportLocal("abla_spilcd_setBacklight")
fun mockSpiLcdSetBacklight(recv: int, enabled: bool): void {
    if (!enabled || !next(7)) bad = true
    return
}
trusted fun classicInitTest(): i32 {
    while (rotation < 8) {
        failAt = 0
        while (failAt <= 6) {
            if (failAt != 1) {
                stage = 0
                val view = SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),rotation,
                    "\x11\x00\xff\xff","\x29\x00\x20\x00\xff\xff",true,true)
                if ((view.width() != 0) != (failAt == 0) ||
                    stage != (if (failAt == 0) 7 else failAt) || bad) return i32(1)
            }
            failAt = failAt+1
        }
        rotation = rotation+1
    }
    stage = 0
    if (SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),8,"\xff\xff").width() != 0 ||
        SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),-1,"\xff\xff").width() != 0 ||
        SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),0,"\x11").width() != 0 ||
        SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),0,"\xff\xff","\x29").width() != 0 ||
        stage != 0) return i32(2)
    i32(0)
}
fun main(): int = int(classicInitTest())
// The NativeBuffer hooks this test does not mock, with the real bodies (this directory's raw_buffer.ab is a copy of src/esp32/sdk/raw_buffer.ab with
// addressValue, hasAddressRange and store as hooks, so a test can mock the buffer).
@exportLocal("abla_mocknb_addressValue")
fun defaultNativeBufferAddressValue(recv: int): int = recv & 4294967295
@exportLocal("abla_mocknb_hasAddressRange")
fun defaultNativeBufferHasAddressRange(recv: int, offset: int, count: int): bool {
    val capacity = (recv >>> 32) & 2147483647
    val address = recv & 4294967295
    if (offset < 0 || count < 0 || offset > capacity || count > capacity - offset) return false
    if (count == 0) return true
    address != 0 && address + offset <= 4294967296 - count
}
