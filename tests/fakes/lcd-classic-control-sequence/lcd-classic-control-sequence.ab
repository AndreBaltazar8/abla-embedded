import "../../../src/display/lcd_logic.ab"
import "../../../src/display/spi_lcd_control_sequence_esp32.ab"
import "abla/unsafe/memory/raw"
import "../../../src/hal/esp32.ab"
import "../../../src/display/spilcd_type.ab"
import "../../../src/hal/spilcd.ab"
import "../../../src/hal/spidevice.ab"
import "../../../src/esp32/spidevice_type.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/hal/native_buffer.ab"
var busy=false
var failure=false
var owned=false
var bad=false
var acquisitions=0
var releases=0
var writes=0
var delayed=0
var payload=0
var expectedCommand=0
var expectedBytes=0
var expectedValue=0
@exportLocal("abla_spilcd_valid")
fun mockSpiLcdValid(recv: int): bool = recv == 1
@exportLocal("abla_spilcd_device")
fun mockSpiLcdDevice(recv: int): SpiDevice = SpiDevice(1)
@export("nativeBufferAt")
fun nativeBufferAtHook(address: int,size: int): NativeBuffer = NativeBuffer(size)
@exportLocal("abla_mocknb_store")
fun mockNativeBufferStore(recv: int, offset: int,value: int): bool {
    if (recv != 1 || offset != 0) bad=true
    payload=value
    true
}
@exportLocal("abla_spidevice_acquire")
fun mockSpiDeviceAcquire(recv: int): bool {
    acquisitions=acquisitions+1
    if (owned) bad=true
    owned=!busy
    owned
}
@exportLocal("abla_spidevice_release")
fun mockSpiDeviceRelease(recv: int): void {
    if (!owned) bad=true
    releases=releases+1
    owned=false
    return
}
@exportLocal("abla_spilcd_writeCommandSelected")
fun mockSpiLcdWriteCommandSelected(recv: int, command: int,data: NativeBuffer,bytes: int, keepSelectedAfter: bool): bool {
    writes=writes+1
    if (!owned || data != 1 || command != expectedCommand ||
        bytes != expectedBytes || (bytes != 0 && payload != expectedValue)) bad=true
    !failure
}
@export("taskDelay")
fun taskDelayHook(milliseconds: int): void {
    if (!owned || failure) bad=true
    delayed=delayed+milliseconds
    return
}
fun resetTest(): void {
    owned=false; bad=false; acquisitions=0; releases=0; writes=0; delayed=0
    return
}
fun main(): int {
    val lcd=SpiLcd(1)
    val geometry=lcdGeometry(320,240)
    var profile=0
    while (profile < 22) {
        var outcome=0
        while (outcome < 3) {
            resetTest()
            busy=outcome == 1; failure=outcome == 2
            expectedBytes=if (profile < 16) 1 else 0
            var result=false
            if (profile < 16) {
                expectedCommand=54
                expectedValue=geometry.view(profile/2,(profile & 1) != 0).madctl()
                result=lcd.setRotation(geometry,profile/2,(profile & 1) != 0)
            } else if (profile < 18) {
                expectedCommand=if (profile == 16) 32 else 33
                result=lcd.setInverted(profile == 17)
            } else if (profile < 20) {
                expectedCommand=if (profile == 18) 17 else 16
                result=lcd.setSleep(profile == 19,120)
            } else {
                expectedCommand=if (profile == 20) 56 else 57
                result=lcd.setIdle(profile == 21)
            }
            if (result != (outcome == 0) || acquisitions != 1 ||
                writes != (if (busy) 0 else 1) || releases != writes || owned || bad ||
                delayed != (if (outcome == 0 && profile >= 18 && profile < 20) 120 else 0)) return 1
            outcome=outcome+1
        }
        profile=profile+1
    }
    resetTest(); busy=false; failure=false
    if (lcd.setRotation(geometry,-1) || lcd.setRotation(geometry,8) ||
        lcd.setRotation(LcdGeometry(0),0) || lcd.setSleep(true,-1) ||
        lcd.setSleep(false,5001) || SpiLcd(0).setIdle(true) || acquisitions != 0) return 2
    0
}
// The real NativeBuffer.addressValue and hasAddressRange (this directory's raw_buffer.ab is a copy of src/esp32/sdk/raw_buffer.ab with addressValue,
// hasAddressRange and store as hooks, so a test can mock the buffer).
@exportLocal("abla_mocknb_addressValue")
fun defaultNativeBufferAddressValue(recv: int): int = recv & 4294967295
@exportLocal("abla_mocknb_hasAddressRange")
fun defaultNativeBufferHasAddressRange(recv: int, offset: int, count: int): bool {
    val capacity = (recv >>> 32) & 2147483647
    val address = recv & 4294967295
    if (offset < 0 || count < 0 || offset > capacity || count > capacity - offset) return false
    if (count == 0) return true
    address != 0 && address + offset <= 4294967296 - count
}
