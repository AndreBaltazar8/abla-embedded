import "../../../src/i2c/results.ab"
import "../../../src/led/m5pm1_sequence.ab"
import "../../../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../../../src/power/m5pm1_type.ab"
import "../../../src/hal/m5pm1.ab"
import "../../../src/hal/native_buffer.ab"
import "../../../src/esp32/sdk/nativebuffer_type.ab"
import "../../../src/hal/i2cdevice.ab"
type I2cDevice = int
@exportLocal("abla_m5pm1_valid")
fun m5Pm1ValidHook(recv: int): bool = M5Pm1(recv) != 0
@exportLocal("abla_m5pm1_device")
fun m5Pm1DeviceHook(recv: int): I2cDevice = I2cDevice(M5Pm1(recv) & 4294967295)
var count = 1
var pin = -1
var calls = 0
var failAt = 0
var frame = false
var bad = false
@exportLocal("abla_m5pm1_setLedEnableLevel")
trusted fun m5Pm1SetLedEnableLevelHook(recv: int, enabled: bool): bool {
    calls = calls + 1
    if (!enabled || calls != 1 || frame) bad = true
    calls != failAt
}
@exportLocal("abla_i2cdevice_updateRegister8")
trusted fun i2cDeviceUpdateRegister8Hook(recv: int, register: int, mask: int, value: int): bool {
    calls = calls + 1
    if (frame) {
        if (calls != 2 || register != 80 || mask != 64 || value != 64) bad = true
    } else if (calls == 2) {
        if (register != 80 || mask != 31 || value != count) bad = true
    } else if (calls == 3) {
        val shift = (pin & 3) * 2
        if (register != (if (pin < 4) 22 else 23) || mask != (3 << shift) || value != mask) bad = true
    } else if (calls == 4) {
        if (register != 19 || mask != (1 << pin) || value != 0) bad = true
    } else bad = true
    calls != failAt
}
trusted fun I2cDevice.writeRegister(register: int, source: NativeBuffer, bytes: int, timeoutMilliseconds: int = 1000): bool {
    calls = calls + 1
    if (!frame || calls != 1 || register != 96 || bytes != count * 2 || source.addressValue() != 4096) bad = true
    calls != failAt
}
trusted fun pmicLedTest(): int {
    val pmic = M5Pm1(1)
    while (count <= 31) {
        pin = -1
        while (pin <= 4) {
            val total = if (pin < 0) 2 else 4
            failAt = 0
            while (failAt <= total) {
                calls = 0
                if (pmic.configureLedStrip(count, pin) != (failAt == 0) ||
                    calls != (if (failAt == 0) total else failAt) || bad) return 1
                failAt = failAt + 1
            }
            pin = pin + 1
        }
        frame = true; failAt = 0
        while (failAt <= 2) {
            calls = 0
            if (pmic.writeLedRgb565(nativeBufferAt(4096, count * 2), count) != (failAt == 0) ||
                calls != (if (failAt == 0) 2 else failAt) || bad) return 2
            failAt = failAt + 1
        }
        frame = false; count = count + 1
    }
    calls = 0
    if (pmic.configureLedStrip(0, 1) || pmic.configureLedStrip(32, 1) ||
        pmic.configureLedStrip(1, 5) || pmic.configureLedStrip(1, -2) ||
        pmic.writeLedRgb565(nativeBufferAt(4096, 1), 1) || calls != 0) return 3
    var component = 0
    while (component <= 255) {
        if (m5Pm1LedColor(component, 0, 0, 255) != ((component / 8) << 11) ||
            m5Pm1LedColor(0, component, 0, 255) != ((component / 4) << 5) ||
            m5Pm1LedColor(0, 0, component, 255) != component / 8 ||
            m5Pm1LedColor(component, component, component, 0) != 0) return 4
        component = component + 1
    }
    if (m5Pm1LedColor(256, 0, 0, 255) != -1 || m5Pm1LedColor(0, 0, 0, -1) != -1) return 5
    0
}
#exportFunction("pmicLedTest", "abla_pmic_led_test")
// The rest of the I2C contract (src/i2c/device.ab): declared, never called by this test.
type I2cBus = int
fun I2cDevice.valid(): bool = false
trusted fun I2cDevice.close(): bool = false
trusted fun I2cDevice.write(source: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.read(destination: NativeBuffer, length: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.writeRead(source: NativeBuffer, sourceLength: int, destination: NativeBuffer,
    destinationLength: int, timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister(register: int, destination: NativeBuffer, length: int,
    timeoutMilliseconds: int = 1000): bool = false
trusted fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
trusted fun I2cDevice.readRegister8(register: int, fallback: int = 0): int = fallback
trusted fun I2cDevice.writeRegister8(register: int, value: int): bool = false
fun I2cBus.valid(): bool = false
trusted fun I2cBus.close(): bool = false
trusted fun I2cBus.device(address: int, frequency: int = 400000): I2cDevice = I2cDevice(0)
