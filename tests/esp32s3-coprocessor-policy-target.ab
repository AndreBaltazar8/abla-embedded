import "../src/esp32/coprocessor_policy_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_coprocessor_policy_target")
@section(".iram1.abla.s3CpPolicyTarget")
trusted fun cpPolicyTarget(record: NativeBuffer,table: NativeBuffer,lock: NativeBuffer,core: int,fallback: int,resolver: int,mode: int): int {
    if (mode == 0) return esp32S3CoprocessorPolicyAddress()
    if (mode == 1) return if (esp32S3CoprocessorPolicyInstallOwned(record,table,lock,core,fallback,0,resolver,0)) 1 else 0
    if (esp32S3CoprocessorPolicyRemoveOwned(record,core)) 1 else 0
}
