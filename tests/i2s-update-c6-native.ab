import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/update_c6_sequence.ab"
var conf=u32(0)
var offset=0x20
var countdown=0
var writes=0
var enabled=true
var bad=false
trusted fun c6I2sClockRead(at: int): u32 = if (at == 0) u32(1) else if (enabled) u32(0x400000) else u32(0)
trusted fun c6I2sClockWrite(at: int,value: u32): void { bad=true;return }
trusted fun c6I2sRead(at: int): u32 {
    if (at == 0x6c) return u32(1)
    if (at != offset) return u32(0)
    if ((conf&u32(256)) != u32(0)) {
        if (countdown == 0) conf=conf&~u32(256) else countdown=countdown-1
    }
    return conf
}
trusted fun c6I2sWrite(at: int,value: u32): void {
    writes=writes+1
    if (at != offset || value != (conf|u32(256))) bad=true
    conf=value;return
}
@export("abla_i2s_update_c6_test")
trusted fun test(): i32 {
    var direction=0
    while (direction < 2) {
        offset=if (direction == 0) 0x20 else 0x24
        var delay=0
        while (delay <= 32) {
            var polls=1
            while (polls <= 32) {
                conf=u32(0xa5a5a0f8);writes=0;countdown=delay
                var update=c6I2sUpdateBeginOwned(0,direction == 1,polls,true)
                if (update.status() != (if (delay < polls) 1 else 5) || writes != 1) return i32(1)
                update=update.waitOwned(33,true)
                if (!update.complete() || writes != 1 || conf != u32(0xa5a5a0f8) || bad) return i32(2)
                polls=polls+1
            }
            delay=delay+1
        }
        conf=u32(0);writes=0;countdown=100
        var update=c6I2sUpdateBeginOwned(0,direction == 1,1,true)
        if (c6I2sUpdateBeginOwned(0,direction == 1,1,true).status() != 4 || writes != 1) return i32(3)
        enabled=false;update=update.waitOwned(1,true)
        if (update.status() != 3 || writes != 1) return i32(4)
        enabled=true;conf=conf|u32(8192);update=update.waitOwned(1,true)
        if (update.status() != 6 || writes != 1) return i32(5)
        conf=u32(0);update=update.waitOwned(1,true)
        if (!update.complete() || writes != 1) return i32(6)
        direction=direction+1
    }
    writes=0
    if (c6I2sUpdateBeginOwned(1,true,1,true).status() != 2 || c6I2sUpdateBeginOwned(0,true,0,true).status() != 2 || c6I2sUpdateBeginOwned(0,true,1,false).status() != 2 || writes != 0) return i32(7)
    return i32(0)
}
