import "../src/esp32/i2c/stream_p4_sequence.ab"
import "../src/esp32/i2c/jobs_p4_bindings.ab"
import "../src/esp32/i2c/session_jobs_p4.ab"
import "../src/esp32/i2c/hardware_jobs_bindings_p4.ab"
import "../src/esp32/i2c/timing_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(288)
val tx=nativeStaticAllocate(32)
val rx=nativeStaticAllocate(32)
val output=nativeStaticAllocate(132)
val input=nativeStaticAllocate(132)
val jobMemory=nativeStaticAllocate(64)
val sessionMemory=nativeStaticAllocate(72)
var readBoundary=-1
var sent=0
var received=0
var expectedRead=0
var prefix=-1
var prefixPending=false
var addressPending=false
var reading=false
var cursor=0
var starts=0
var restarts=0
var stops=0
var faultBatch=0
var fault=u32(0)
var tick=u32(0)
var bad=false
var providerWire=false
var dropAddress=-1
// Lifecycle creation/close are outside this pre-bound provider integration.
trusted fun p4I2cSessionClockOpen(port: int,source: int): int { bad=true;return 0 }
trusted fun p4I2cSessionInitialize(port: int,filter: int): int { bad=true;return 0 }
trusted fun p4I2cSessionPinsOpen(r: NativeBuffer,port: int,sda: int,scl: int,pullup: bool,layout: int): int { bad=true;return 0 }
trusted fun p4I2cSessionClockClose(token: int): int = 4102
trusted fun p4I2cSessionPinsClose(r: NativeBuffer): int = 2
trusted fun p4I2cSessionTiming(port: int,timing: P4I2cTiming): int = esp32p4I2cConfigureTimingOwned(port,timing,true)
trusted fun p4I2cSessionTransfer(port: int,address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    bad=true;return 7
}
trusted fun providerRun(bus: I2cBus,jobs: NativeBuffer,frequency: int,timeout: int = 1000): int {
    providerWire=true
    val result=bus.runJobsStatus(jobs,4,frequency,timeout)
    providerWire=false;return result
}
fun mapping(address: int): int =
    if (address >= 0x500c4000 && address < 0x500c4080) address-0x500c4000
    else if (address >= 0x500c5000 && address < 0x500c5080) address-0x500c5000+128
    else if (address == 0x500e601c) 256 else if (address == 0x500e6040) 260 else if (address == 0x500e6044) 264
    else if (address == 0x500e60c4) 268 else -1
trusted fun execute(base: int): void {
    val m=nativeBufferAt(memory,288)
    starts=starts+1
    m.storeU32(base+4,m.loadU32(base+4)&0xffffffdf)
    if (starts == faultBatch) { m.storeU32(base+32,int(fault));return }
    val queued=(m.loadU32(base+8)>>18)&63
    var consumed=0
    var filled=0
    var index=0
    while (index < 8) {
        val command=m.loadU32(base+88+index*4)
        val op=(command>>11)&7
        val count=command&255
        if (op == 6) { addressPending=true;restarts=restarts+1 }
        else if (op == 1) {
            if ((command&256) == 0) bad=true
            var i=0
            while (i < count) {
                if (consumed >= queued) { bad=true;return }
                val value=nativeBufferAt(tx,32).load(consumed)
                consumed=consumed+1
                if (addressPending) {
                    if ((value>>1) != (if (providerWire) 41+restarts else 42)) bad=true
                    reading=(value&1) != 0;addressPending=false
                } else if (prefixPending) {
                    if (value != prefix || reading) bad=true
                    prefixPending=false
                } else {
                    if (reading || value != ((sent^0xa5)&255)) bad=true
                    sent=sent+1
                }
                i=i+1
            }
        } else if (op == 3) {
            if (!reading || addressPending) bad=true
            var i=0
            while (i < count) {
                if (filled >= 32 || received >= expectedRead) { bad=true;return }
                if (((command&1024) != 0) != (received == expectedRead-1 || received == readBoundary)) bad=true
                nativeBufferAt(rx,32).store(filled,(received^0x5a)&255)
                filled=filled+1;received=received+1;i=i+1
            }
        } else if (op == 2 || op == 4) {
            if (consumed != queued || addressPending) bad=true
            if (op == 2) stops=stops+1
            m.storeU32(base+8,(filled<<8)|(if (op == 4) 16 else 0))
            m.storeU32(base+32,if (op == 4) 8 else 128)
            m.storeU32(base+88+index*4,command|0x80000000)
            cursor=0;return
        } else bad=true
        index=index+1
    }
    bad=true;return
}
trusted fun p4I2cRead(address: int): u32 {
    if (providerWire && p4HardwareLoad(0) != 1) bad=true
    val at=mapping(address)
    if (at < 0) { bad=true;return u32(0) }
    val m=nativeBufferAt(memory,288)
    val base=if (at < 128) 0 else 128
    if (at == base+28) {
        if (((m.loadU32(base+8)>>8)&63) == 0 || cursor >= 32) { bad=true;return u32(0) }
        val value=nativeBufferAt(rx,32).load(cursor)
        cursor=cursor+1;m.storeU32(base+8,m.loadU32(base+8)-256)
        return u32(value)
    }
    return u32(m.loadU32(at))
}
trusted fun p4I2cWrite(address: int,value: u32): void {
    if (providerWire && p4HardwareLoad(0) != 1) bad=true
    if (address == dropAddress) return
    val at=mapping(address)
    if (at < 0) { bad=true;return }
    val m=nativeBufferAt(memory,288)
    val base=if (at < 128) 0 else 128
    if (at == base+28) {
        val used=(m.loadU32(base+8)>>18)&63
        if (used >= 32) { bad=true;return }
        nativeBufferAt(tx,32).store(used,int(value)&255)
        m.storeU32(base+8,m.loadU32(base+8)+(1<<18));return
    }
    if (at == base+36) { m.storeU32(base+32,m.loadU32(base+32)&(0xffffffff^int(value)));return }
    if (at == base+4) {
        m.storeU32(at,int(value)&0xfffff7ff)
        if ((value&u32(32)) != u32(0)) execute(base)
        return
    }
    m.storeU32(at,int(value));return
}
trusted fun p4I2cCounter(): u32 { tick=tick+u32(1);return tick }
trusted fun seed(port: int,n: int,p: int): void {
    val m=nativeBufferAt(memory,288)
    var i=0
    while (i < 288) { m.storeU32(i,0);i=i+4 }
    m.storeU32(256,0x3000);m.storeU32(260,0x8000002)
    m.storeU32(port*128+4,0x110);m.storeU32(port*128+24,0x4000)
    i=0
    while (i < 132) {
        nativeBufferAt(output,132).store(i,i^0xa5)
        nativeBufferAt(input,132).store(i,0xcc);i=i+1
    }
    sent=0;received=0;expectedRead=n;prefix=p;prefixPending=p >= 0;readBoundary=-1
    addressPending=false;reading=false;cursor=0;starts=0;restarts=0;stops=0
    faultBatch=0;fault=u32(0);tick=u32(0);bad=false;dropAddress=-1;return
}
fun length(index: int): int = if (index < 2) index else if (index < 6) 28+index else if (index < 9) 57+index else 128
@export("abla_i2c_stream_p4_test")
trusted fun test(): i32 {
    val out=nativeBufferAt(output,132);val into=nativeBufferAt(input,132)
    var port=0
    while (port < 2) {
        var w=0
        while (w < 10) {
            var r=0
            while (r < 10) {
                var p=-1
                while (p < 256) {
                    val nw=length(w);val nr=length(r)
                    seed(port,nr,p)
                    if (esp32p4I2cTransferOwned(port,42,out,nw,into,nr,u32(1000),true,p) != 1 || bad) return i32(1)
                    if (sent != nw || received != nr || stops != 1 || prefixPending) return i32(2)
                    val writePhase=nw > 0 || nr == 0 || p >= 0
                    if (restarts != (if (writePhase) 1 else 0)+(if (nr > 0) 1 else 0)) return i32(3)
                    var i=0
                    while (i < 132) {
                        if (into.load(i) != (if (i < nr) i^0x5a else 0xcc)) return i32(4)
                        if (out.load(i) != (i^0xa5)) return i32(5)
                        i=i+1
                    }
                    p=p+256
                }
                r=r+1
            }
            w=w+1
        }
        var kind=0
        while (kind < 4) {
            var batch=1
            while (batch <= 5) {
                seed(port,65,-1);faultBatch=batch
                fault=if (kind == 0) u32(1024) else if (kind == 1) u32(32) else if (kind == 2) u32(256) else u32(4)
                if (esp32p4I2cTransferOwned(port,42,out,33,into,65,u32(1000),true) != kind+3 || starts != batch || stops != 0 || bad) return i32(6)
                batch=batch+1
            }
            kind=kind+1
        }
        seed(port,65,-1)
        if (esp32p4I2cTransferOwned(port,42,out,0,into,65,u32(7),true) != 5 || starts != 2 || stops != 0 || received != 64 || bad) return i32(7)
        seed(port,65,-1);tick=u32(0xfffffffc)
        if (esp32p4I2cTransferOwned(port,42,out,0,into,65,u32(100),true) != 1 || bad) return i32(8)
        seed(port,1,-1)
        if (esp32p4I2cTransferOwned(port,42,out,133,into,1,u32(100),true) != 7 || starts != 0 || tick != u32(0)) return i32(9)
        // A read phase ending before repeated START still NACKs its last byte.
        seed(port,1,-1)
        val started=p4I2cCounter()
        if (esp32p4I2cStreamChunkOwned(port,42,into,1,true,true,false,false,started,u32(100),-1,true) != 2 || stops != 0 || bad) return i32(10)
        if (esp32p4I2cStreamChunkOwned(port,42,out,1,false,true,true,true,started,u32(100)) != 1 || stops != 1 || restarts != 2 || sent != 1 || bad) return i32(11)
        // Four addressed phases: write, read, zero-byte probe, final read.
        // The first read must NACK before repeated START, not just at STOP.
        val jobs=nativeBufferAt(jobMemory,64)
        val session=nativeBufferAt(sessionMemory,72)
        session.storeU32(0,0x49324234);session.storeU32(20,port);session.storeU32(24,3)
        var jw=0
        while (jw < 10) {
            var jr=1
            while (jr < 10) {
                val nw=length(jw);val nr=length(jr)
                seed(port,nr+1,-1);readBoundary=nr-1
                if (!i2cJobSet(jobs,0,42,false,out,nw) || !i2cJobSet(jobs,1,42,true,into,nr) ||
                    !i2cJobSet(jobs,2,42,false,NativeBuffer(0),0) ||
                    !i2cJobSet(jobs,3,42,true,nativeBufferAt(input+nr,1),1)) return i32(12)
                session.storeU32(4,1)
                if (esp32p4I2cSessionJobsOwned(session,jobs,4,u32(1000),true) != 1 || bad || session.loadU32(4) != 1 ||
                    sent != nw || received != nr+1 || stops != 1 || restarts != 4) return i32(13)
                var i=0
                while (i < 132) {
                    if (into.load(i) != (if (i <= nr) i^0x5a else 0xcc) || out.load(i) != (i^0xa5)) return i32(14)
                    i=i+1
                }
                val batches=starts
                var kind=0
                while (kind < 4) {
                    var failed=1
                    while (failed <= batches) {
                        seed(port,nr+1,-1);readBoundary=nr-1;faultBatch=failed
                        fault=if (kind == 0) u32(1024) else if (kind == 1) u32(32) else if (kind == 2) u32(256) else u32(4)
                        session.storeU32(4,1)
                        if (esp32p4I2cSessionJobsOwned(session,jobs,4,u32(1000),true) != kind+3 || bad || starts != failed || stops != 0 ||
                            session.loadU32(4) != 3 || session.loadU32(8) != kind+3) return i32(15)
                        if (esp32p4I2cSessionJobsOwned(session,jobs,4,u32(1000),true) != 7 || starts != failed) return i32(16)
                        failed=failed+1
                    }
                    kind=kind+1
                }
                jr=jr+1
            }
            jw=jw+1
        }
        seed(port,1,-1);session.storeU32(4,1)
        // Payload overlap with session and absent exclusivity reject before
        // hardware or state changes. The table itself cannot alias either.
        if (!i2cJobSet(jobs,0,42,false,session,1)) return i32(17)
        if (esp32p4I2cSessionJobsOwned(session,jobs,1,u32(1000),true) != 7 || starts != 0 ||
            session.loadU32(4) != 1 || tick != u32(0)) return i32(18)
        if (!i2cJobSet(jobs,0,42,false,out,1)) return i32(19)
        if (esp32p4I2cSessionJobsOwned(session,jobs,1,u32(1000),false) != 7 || starts != 0 ||
            session.loadU32(4) != 1 || tick != u32(0)) return i32(20)
        // Full provider -> timing -> session -> job -> FIFO/MMIO composition.
        // Distinct addresses ensure each repeated START sends its own address.
        if (!i2cJobSet(jobs,0,42,false,out,33) || !i2cJobSet(jobs,1,43,true,into,33) ||
            !i2cJobSet(jobs,2,44,false,NativeBuffer(0),0) ||
            !i2cJobSet(jobs,3,45,true,nativeBufferAt(input+33,1),1)) return i32(21)
        var speed=0
        while (speed < 3) {
            val hz=if (speed == 0) 1000 else if (speed == 1) 100000 else 400000
            var scenario=0
            while (scenario < 27) {
                seed(port,34,-1);readBoundary=32;session.storeU32(4,1);session.storeU32(24,3)
                val bus=i2cHardwareBindOwned(session,u32(40000000),if (scenario == 26) u32(1000) else u32(400000000))
                if (!bus.valid()) return i32(22)
                if (scenario >= 1 && scenario <= 24) {
                    faultBatch=(scenario-1)%6+1
                    val kind=(scenario-1)/6
                    fault=if (kind == 0) u32(1024) else if (kind == 1) u32(32) else if (kind == 2) u32(256) else u32(4)
                }
                if (scenario == 25) dropAddress=p4I2cBase(port)+64
                val result=providerRun(bus,jobs,hz,if (scenario == 26) 1 else 1000)
                val wanted=if (scenario == 0) 1 else if (scenario <= 6) 5 else if (scenario <= 12) 4 else if (scenario <= 18 || scenario == 26) 3 else 6
                if (result != wanted || bad || p4HardwareLoad(0) != 0) return i32(23)
                if (scenario == 0) {
                    if (sent != 33 || received != 34 || restarts != 4 || stops != 1 || starts != 6 || session.loadU32(4) != 1) return i32(24)
                    var i=0
                    while (i < 132) {
                        if (into.load(i) != (if (i < 34) i^0x5a else 0xcc) || out.load(i) != (i^0xa5)) return i32(25)
                        i=i+1
                    }
                } else {
                    if (session.loadU32(4) != 3 || stops != 0 || starts != (if (scenario <= 24) faultBatch else 0)) return i32(26)
                    val previous=starts
                    if (providerRun(bus,jobs,hz) != 7 || starts != previous) return i32(27)
                }
                if (!bus.close()) return i32(28)
                scenario=scenario+1
            }
            speed=speed+1
        }
        port=port+1
    }
    return i32(0)
}
