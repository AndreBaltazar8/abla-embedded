import "../src/esp32/power/sleep_flash_hold_p4_sequence.ab"
import "./p4-shared-hold-model.ab"
var flashHolds=0xa400003f
var flashHoldWrites=0
var flashHoldDrop=0
var flashHoldBad=false
fun p4SleepFlashHoldRead(): int = if (p4HoldModelShared) p4HoldModelValue else flashHolds
fun p4SleepFlashHoldWrite(value: int): void {
    if ((value&0xffffffc0) != (p4SleepFlashHoldRead()&0xffffffc0)) flashHoldBad=true
    flashHoldWrites=flashHoldWrites+1
    if (flashHoldWrites != flashHoldDrop) { flashHolds=value;if (p4HoldModelShared) p4HoldModelValue=value }
    return
}
fun sleepFlashHoldChecks(): int {
    p4HoldModelShared=false
    var old=0
    while (old < 64) {
        var fault=0
        while (fault < 3) {
            flashHolds=0xa4000000|old;flashHoldWrites=0;flashHoldDrop=if (fault == 1) 1 else 0;flashHoldBad=false
            val token=esp32p4SleepFlashHoldOpenOwned(300,true)
            if (!token.hasSnapshot() || token.status() != (if (fault == 1 && old != 63) 3 else 1) || ((token>>>8)&63) != old) return 140
            // Simulate the independent PSRAM owner adding all its holds.
            // Flash cleanup must preserve the CURRENT sibling field.
            flashHolds=flashHolds|0x03ffffc0
            flashHoldDrop=if (fault == 2) flashHoldWrites+1 else 0
            val count=flashHoldWrites
            if (token.closeOwned(false) != token || flashHoldWrites != count) return 141
            val closed=token.closeOwned(true)
            if (closed.status() != (if (fault == 2 && old != 63) 3 else 4)) return 142
            flashHoldDrop=0
            val finalToken=closed.closeOwned(true)
            if (finalToken.status() != 4 || flashHolds != (0xa7ffffc0|old) || flashHoldBad) return 143
            val finalWrites=flashHoldWrites
            if (finalToken.closeOwned(true) != finalToken || flashHoldWrites != finalWrites) return 144
            fault=fault+1
        }
        old=old+1
    }
    flashHoldWrites=0
    if (esp32p4SleepFlashHoldOpenOwned(299,true).status() != 2 || esp32p4SleepFlashHoldOpenOwned(400,true).status() != 2 ||
        esp32p4SleepFlashHoldOpenOwned(300,false).status() != 2 || flashHoldWrites != 0) return 145
    flashHolds=0xa400003f;return 0
}
