import "./pm1-control-wire-native.ab"
import "../src/power/axp192_device.ab"
@export("abla_axp192_current_wire_test")
trusted fun testCurrent(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    if (!device.valid()) return i32(1)
    val registers=nativeBufferAt(chargeRegisters,256);val sensor=Axp192(device|0)
    var field=0
    while (field < 5) {
        val address=if (field == 0) 88 else if (field == 1) 92 else if (field == 2) 122 else if (field == 3) 124 else 112
        var sample=0
        while (sample < 8) {
            val maximum=if (field < 2) 4095 else if (field < 4) 8191 else 16777215
            val raw=if (sample < 4) sample else if (sample == 4) maximum/2 else if (sample == 5) maximum/2+1 else if (sample == 6) maximum-1 else maximum
            if (field == 4) { registers.store(address,raw>>>16);registers.store(address+1,raw>>>8);registers.store(address+2,raw) }
            else {
                val bits=if (field < 2) 4 else 5
                registers.store(address,raw>>>bits);registers.store(address+1,(raw&((1<<bits)-1))|(if (bits == 4) 240 else 224))
            }
            val expected=if (field == 0) raw*5/8 else if (field == 1) raw*3/8 else if (field < 4) raw/2 else raw*11/20000
            var fault=0
            while (fault < 4) {
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                val result=if (field == 0) sensor.acinMilliampsChecked() else if (field == 1) sensor.vbusMilliampsChecked() else if (field == 2) sensor.batteryChargeMilliampsChecked() else if (field == 3) sensor.batteryDischargeMilliampsChecked() else sensor.batteryMilliwattsChecked()
                if (result.valid() != (fault == 0) || (result.valid() && result.value() != expected) || ackCount-before != (if (fault == 0) 3 else fault) || bad) return i32(2)
                fault=fault+1
            }
            sample=sample+1
        }
        field=field+1
    }
    // Combined board reading: both 13-bit fields, independent reserved bits,
    // truncation before direction choice, and every address/data NACK.
    var pair=0
    while (pair < 64) {
        val charge=if (pair/8 < 4) pair/8 else if (pair/8 == 4) 31 else if (pair/8 == 5) 32 else if (pair/8 == 6) 8190 else 8191
        val discharge=if (pair%8 < 4) pair%8 else if (pair%8 == 4) 31 else if (pair%8 == 5) 32 else if (pair%8 == 6) 8190 else 8191
        registers.store(122,charge>>>5);registers.store(123,(charge&31)|224)
        registers.store(124,discharge>>>5);registers.store(125,(discharge&31)|160)
        var fault=0
        while (fault <= 6) {
            val start=ackCount;nackAt=if (fault == 0) 0 else start+fault
            val result=sensor.batteryMilliampsChecked()
            val expected=if (charge/2 < discharge/2) -(discharge/2) else charge/2
            if (result.valid() != (fault == 0) || (result.valid() && result.value() != expected) || ackCount-start != (if (fault == 0) 6 else fault) || bad) return i32(6)
            fault=fault+1
        }
        pair=pair+1
    }
    nackAt=0;val before=ackCount
    if (Axp192(0).batteryMilliampsChecked().valid() || ackCount != before) return i32(7)
    if (Axp192(0).acinMilliampsChecked().valid() || Axp192(0).vbusMilliampsChecked().valid() || Axp192(0).batteryChargeMilliampsChecked().valid() || Axp192(0).batteryDischargeMilliampsChecked().valid() || Axp192(0).batteryMilliwattsChecked().valid() || ackCount != before) return i32(3)
    var raw=0
    while (raw < 65536) {
        val sample=I2cWordResult(65536|raw)
        val a=axp192AcinMilliampsChecked(sample);val b=axp192VbusMilliampsChecked(sample);val c=axp192HalfMilliampChecked(sample)
        if (a.valid() != (raw <= 4095) || b.valid() != (raw <= 4095) || c.valid() != (raw <= 8191) || (a.valid() && a.value() != raw*5/8) || (b.valid() && b.value() != raw*3/8) || (c.valid() && c.value() != raw/2)) return i32(4)
        raw=raw+1
    }
    if (axp192BatteryMilliwattsChecked(I2cDwordResult(0)).valid() || axp192BatteryMilliwattsChecked(I2cDwordResult(4294967296|16777216)).valid() || axp192BatteryMilliwattsChecked(I2cDwordResult(4294967296|2000000)).value() != 1100) return i32(5)
    return i32(0)
}
