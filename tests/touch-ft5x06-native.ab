import "../src/input/touch_ft5x06_sequence.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
type Ft5x06 = int
val trackerStorage=nativeStaticAllocate(184)
val snapshotStorage=nativeStaticAllocate(29)
val frameStorage=nativeStaticAllocate(40)
val savedStorage=nativeStaticAllocate(184)
var readResult=1
var contactId=0
var reads=0
fun Ft5x06.valid(): bool = this == 1
trusted fun Ft5x06.readStable(snapshot: NativeBuffer): int {
    reads=reads+1
    if (readResult < 0 || readResult > 5) return readResult
    snapshot.store(0,readResult)
    var index=0
    while (index < readResult) {
        val offset=1+index*6
        snapshot.store(offset,1)
        snapshot.store(offset+1,63)
        snapshot.store(offset+2,contactId << 4)
        snapshot.store(offset+3,0)
        index=index+1
    }
    readResult
}
trusted fun saveState(): void {
    var index=0
    val source=nativeBufferAt(trackerStorage,184)
    val saved=nativeBufferAt(savedStorage,184)
    while (index < 184) { saved.store(index,source.load(index)); index=index+1 }
    return
}
trusted fun unchangedState(): bool {
    var index=0
    val source=nativeBufferAt(trackerStorage,184)
    val saved=nativeBufferAt(savedStorage,184)
    while (index < 184) {
        if (saved.load(index) != source.load(index)) return false
        index=index+1
    }
    true
}
@export("abla_touch_ft5x06_test")
trusted fun ftGestureTest(): i32 {
    val snapshot=nativeBufferAt(snapshotStorage,29)
    val frame=nativeBufferAt(frameStorage,40)
    val touch=Ft5x06(1)
    var rotation=0
    while (rotation < 8) {
        val tracker=touchTrackerAt(trackerStorage)
        if (tracker.updateFt5x06(touch,snapshot,frame,10,320,240,rotation) != 1 ||
            !tracker.detail(0).wasPressed()) return i32(1)
        val point=tracker.detail(0).point()
        val x=if (rotation == 0 || rotation == 4) 319 else if (rotation == 3 || rotation == 7) 239 else 0
        val y=if (rotation == 2 || rotation == 4) 239 else if (rotation == 3 || rotation == 5) 319 else 0
        if (point.x() != x || point.y() != y) return i32(2)
        val before=reads
        if (tracker.updateFt5x06(touch,snapshot,frame,12,320,240,rotation) != 1 || reads != before) return i32(3)
        saveState()
        readResult=-1
        if (tracker.updateFt5x06(touch,snapshot,frame,20,320,240,rotation) != -2 || !unchangedState()) return i32(4)
        readResult=-2
        if (tracker.updateFt5x06(touch,snapshot,frame,20,320,240,rotation) != -3 || !unchangedState()) return i32(5)
        readResult=2
        if (tracker.updateFt5x06(touch,snapshot,frame,20,320,240,rotation) != -4 || !unchangedState()) return i32(6)
        readResult=1; contactId=6
        if (tracker.updateFt5x06(touch,snapshot,frame,20,320,240,rotation) != -4 || !unchangedState()) return i32(7)
        contactId=0
        val nowReads=reads
        if (tracker.updateFt5x06(touch,nativeBufferAt(trackerStorage,29),frame,20,320,240,rotation) != -1 ||
            tracker.updateFt5x06(touch,snapshot,nativeBufferAt(snapshotStorage,40),20,320,240,rotation) != -1 ||
            tracker.updateFt5x06(touch,snapshot,frame,20,320,240,8) != -1 || reads != nowReads || !unchangedState()) return i32(8)
        readResult=0
        if (tracker.updateFt5x06(touch,snapshot,frame,20,320,240,rotation) != 1 || !tracker.detail(0).wasReleased()) return i32(9)
        readResult=1
        rotation=rotation+1
    }
    i32(0)
}
