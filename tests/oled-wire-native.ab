import "./corematrix-wire-native.ab"
import "../src/m5stack/oled_profile.ab"
import "abla/runtime/scalar"
val oledMemory=nativeStaticAllocate(1200)
val oledExpected=nativeStaticAllocate(16384)
var expectedCount=0
var transactionIndex=0
var expectedStage=0
var expectedPages=0
trusted fun expectByte(value: int): void {
    val e=nativeBufferAt(oledExpected,16384);val offset=expectedCount*4
    e.store(offset,transactionIndex);e.store(offset+1,value);e.store(offset+2,expectedStage);e.store(offset+3,expectedPages)
    transactionIndex=transactionIndex+1;expectedCount=expectedCount+1;return
}
fun expectStart(): void { transactionIndex=0;expectByte(120);return }
@export("abla_oled_wire_test")
trusted fun testOledWire(): i32 {
    wireSeed()
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    extraAddress=60
    val device=control.session().bus().device(60,100000)
    val frame=nativeBufferAt(oledMemory,1024);val scratch=nativeBufferAt(oledMemory+1024,176)
    if (!device.valid()) return i32(2)
    var variant=0
    while (variant < 2) {
        val profile=if (variant == 0) m5UnitMiniOledProfile else m5UnitOledProfile
        val width=profile.width();val pages=profile.height()>>>3
        var at=0;while (at < 1024) { frame.store(at,(at*73+19)&255);at=at+1 }
        if (!device.oledInitialize(profile,scratch)) return i32(3)
        expectedCount=0;expectedPages=0;expectedStage=3
        if (variant == 0) {
            expectStart();expectByte(0);expectByte(33);expectByte(28);expectByte(99);expectByte(34);expectByte(0);expectByte(4)
        }
        var page=0
        while (page < pages) {
            expectedPages=page;expectedStage=3
            if (variant == 1) { expectStart();expectByte(0);expectByte(176+page);expectByte(18);expectByte(0) }
            expectedStage=4;expectStart();expectByte(64)
            at=0;while (at < width) { expectByte(((page*width+at)*73+19)&255);at=at+1 }
            page=page+1
        }
        var failure=0
        while (failure <= expectedCount) {
            var commit=0
            while (commit < 2) {
                val before=ackCount;extraCount=0;nackAfterCommit=commit == 1
                nackAt=if (failure == 0) 0 else before+failure
                val result=device.oledDisplay(profile,frame,scratch)
                val e=nativeBufferAt(oledExpected,16384)
                val expected=if (failure == 0) 1|(pages<<8) else e.load((failure-1)*4+2)|(e.load((failure-1)*4+3)<<8)
                val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && e.load((failure-1)*4) > 1) 1 else 0)
                if (result != expected || ackCount-before != (if (failure == 0) expectedCount else failure) ||
                    extraCount != accepted || bad || mode != 0 || !masterHigh || !slaveHigh || !clockHigh) return i32(4)
                at=0
                while (at < accepted) {
                    if (nativeBufferAt(extraWire,8192).load(at*2) != e.load(at*4) ||
                        nativeBufferAt(extraWire,8192).load(at*2+1) != e.load(at*4+1)) return i32(5)
                    at=at+1
                }
                at=0;while (at < 1024) { if (frame.load(at) != ((at*73+19)&255)) return i32(6);at=at+1 }
                commit=commit+1
            }
            failure=failure+1
        }
        nackAt=0;nackAfterCommit=false;extraCount=0
        variant=variant+1
    }
    if (!device.oledSetSleep(true,scratch) || !device.close() || !control.closeOwned(true) || pads != 0 || bad) return i32(7)
    return i32(0)
}
