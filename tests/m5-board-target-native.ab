import "../src/m5stack/board_target.ab"
import "abla/runtime/scalar"
import "abla/build"
// Independent literal board-ID inventory grouped by documented target.
fun expectedTarget(id: int): int {
    if (id == 1 || id == 2 || id == 3 || id == 4 || id == 5 || id == 6 || id == 7 || id == 8 || id == 9 || id == 128 || id == 129 || id == 130 || id == 131 || id == 132 || id == 133 || id == 141 || id == 142) return 1
    if (id == 134 || id == 135) return 3
    if (id == 23 || id == 25 || id == 140 || id == 154) return 4
    if (id == 33 || id == 153) return 5
    if (id == 22 || id == 31 || id == 35 || id == 148 || id == 150 || id == 156) return 6
    if (id == 151) return 7
    if (id == 152) return 8
    if (id == 10 || id == 11 || id == 12 || id == 13 || id == 14 || id == 15 || id == 16 || id == 17 || id == 18 || id == 19 || id == 21 || id == 24 || id == 26 || id == 27 || id == 28 || id == 29 || id == 30 || id == 32 || id == 34 || id == 136 || id == 137 || id == 138 || id == 139 || id == 143 || id == 144 || id == 145 || id == 146 || id == 147 || id == 149 || id == 155) return 2
    return 0
}
@export("abla_m5_board_target_test")
fun testBoardTargets(): i32 {
    var id=-1
    while (id <= 513) {
        val board=M5BoardId(id);val expected=expectedTarget(id)
        if ((board.target()|0) != expected) return i32(1)
        var target=-1
        while (target <= 9) {
            val tag=M5BoardTarget(target);val match=expected != 0 && expected == target
            if (board.matchesTarget(tag) != match || m5SelectBoardForTarget(m5BoardUnknown,board,tag) != (if (match) board else m5BoardUnknown)) return i32(2)
            if (id != 0 && m5SelectBoardForTarget(board,m5BoardCoreMatrix,tag) != (if (match) board else m5BoardUnknown)) return i32(3)
            target=target+1
        }
        id=id+1
    }
    if (m5BoardAtomEcho().target() != m5TargetEsp32 || m5BoardAtomEchoS3R().target() != m5TargetEsp32S3 || m5BoardTab5X.target() != m5BoardTab5.target()) return i32(4)
    return i32(0)
}
