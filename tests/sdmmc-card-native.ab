import "../src/sd/mmc_card_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(96)
var command=0
var argument=0
var events=0
var hardwareStatus=0
var writes=0
var a=0
var b=0
var c=0
var d=0
trusted fun sdMmcS3Read(offset: int): int = if (offset == 44) command else if (offset == 40) argument else if (offset == 68) events else if (offset == 72) hardwareStatus else if (offset == 48) a else if (offset == 52) b else if (offset == 56) c else if (offset == 60) d else 0
trusted fun sdMmcS3Write(offset: int,value: int): void {
    writes=writes+1
    if (offset == 44) command=value
    if (offset == 40) argument=value
    if (offset == 68) events=events&~value
    return
}
trusted fun complete(card: NativeBuffer,now: u32,value: int): int {
    command=command&0x7fffffff; events=events|4; a=value
    return sdMmcCardPollOwned(card,now)
}
trusted fun scenario(legacy: bool,slot: int): int {
    val card=nativeBufferAt(storage,80)
    val now=u32(0xfffffff0)
    command=0; events=0x10001; hardwareStatus=0; b=0; c=0; d=0
    if (sdMmcCardBeginOwned(card,slot,now,2000,true) != 2) return 1
    var n=0
    var tick=now
    var seenSetLength=false
    var negotiated=false
    var readied=false
    while (n < 70 && sdMmcCardStatus(card) == 2) {
        val phase=card.load(4)
        if (phase == 11 || phase == 13 || phase == 12) {
            tick=tick+u32(10)
            sdMmcCardPollOwned(card,tick)
        } else {
            if (sdMmcCardPollOwned(card,tick) != 2 || (command&0x80000000) == 0 || ((command>>16)&31) != slot) return 2
            val op=command&63
            if (phase == 1 && (op != 0 || (command&32768) == 0)) return 3
            if (phase == 2 && (op != 8 || argument != 426)) return 4
            if (phase == 3 && (op != 55 || argument != 0)) return 5
            if (phase == 4 && (op != 41 || argument != (if (legacy) 0xff8000 else 0x40ff8000))) return 6
            if (phase == 5 && op != 2) return 7
            if (phase == 6 && op != 3) return 8
            if (phase == 7 && (op != 9 || argument != 0x12340000)) return 9
            if (phase == 8 && (op != 7 || argument != 0x12340000)) return 10
            if (phase == 9) { if (!legacy || op != 16 || argument != 512) return 11; seenSetLength=true }
            if (phase == 10 && (op != 13 || argument != 0x12340000)) return 12
            // First polling step is genuinely pending, never treated as completion.
            if (sdMmcCardPollOwned(card,tick) != 2 || card.load(4) != phase) return 13
            var reply=0
            if (phase == 2) reply=426
            if (phase == 3) reply=32
            if (phase == 4) {
                reply=0xff8000|(if (legacy) 0 else 0x40000000)|(if (negotiated) 0x80000000 else 0)
                negotiated=true
            }
            if (phase == 5) { reply=0x11223344; b=0x55667788; c=0x99aabbcc; d=0xddeeff00 }
            if (phase == 6) reply=0x12340700
            if (phase == 7) {
                reply=1
                b=if (legacy) 0xc0038000 else 0xffff0000
                c=if (legacy) 0x903ff else 0x9003f
                d=if (legacy) 0 else 0x40000000
            }
            if (phase == 10) { reply=if (readied) 0x900 else 0x800; readied=true }
            if (phase == 2 && legacy) {
                command=command&0x7fffffff; events=events|256
                if (sdMmcCardPollOwned(card,tick) != 2 || card.load(4) != 12) return 14
            } else if (phase == 8) {
                hardwareStatus=512
                if (complete(card,tick,reply) != 2 || card.load(4) != 8) return 15
                hardwareStatus=0; sdMmcCardPollOwned(card,tick)
            } else complete(card,tick,reply)
        }
        n=n+1
    }
    if (sdMmcCardStatus(card) != 1 || seenSetLength != legacy || !readied || card.loadU32(28) != 0x1234 || events != 0x10001) return 16
    if (card.loadU32(32) != 0x11223344 || card.loadU32(44) != 0xddeeff00) return 17
    if (sdMmcCardBlockCount(card) != (if (legacy) 2097152 else 4294967296)) return 18
    return 0
}
@export("abla_sdmmc_card_test")
trusted fun test(): i32 {
    val card=nativeBufferAt(storage,80)
    var mode=0
    while (mode < 4) {
        val result=scenario((mode&1) != 0,mode>>1)
        if (result != 0) return i32(result)
        mode=mode+1
    }
    // Every transport error fails closed; ONLY lone CMD8 RTO may downgrade.
    var phase=1
    while (phase <= 10) {
        var bit=0
        while (bit < 16) {
            if (((1<<bit)&0x1542) != 0) {
                command=0; events=0
                sdMmcCardBeginOwned(card,0,u32(0),100,true); card.store(4,phase)
                sdMmcCardPollOwned(card,u32(0)); command=0; events=1<<bit
                val result=sdMmcCardPollOwned(card,u32(1))
                if (result != (if (phase == 2 && bit == 8) 2 else 4)) return i32(20)
                if ((card.loadU32(8)>>16) != (1<<bit)) return i32(21)
            }
            bit=bit+1
        }
        phase=phase+1
    }
    // R7 echo, APP_CMD missing/error, zero/error RCA, incompatible OCR/CSD.
    var failure=0
    while (failure < 8) {
        command=0; events=0
        sdMmcCardBeginOwned(card,0,u32(0),100,true)
        card.store(4,if (failure == 0) 2 else if (failure < 3) 3 else if (failure < 5) 6 else if (failure < 7) 4 else 7)
        sdMmcCardPollOwned(card,u32(0))
        b=0; c=0; d=0x80000000
        val reply=if (failure == 0) 0x2aa else if (failure == 2) 0x80000020 else if (failure == 4) 0x1234e000 else if (failure == 6) 0xc0ff8000 else 0
        if (complete(card,u32(1),reply) != (if (failure == 7) 7 else 5)) return i32(22)
        failure=failure+1
    }
    // R1 error bits are never suppressed by APP_CMD/ready bits.
    var r1bit=0
    while (r1bit < 32) {
        if (((1<<r1bit)&0xfff9a088) != 0) {
            var stage=3
            while (stage <= 10) {
                if (stage == 3 || stage >= 8) {
                    command=0; events=0
                    sdMmcCardBeginOwned(card,0,u32(0),100,true); card.store(4,stage)
                    sdMmcCardPollOwned(card,u32(0))
                    if (complete(card,u32(1),(1<<r1bit)|0x920) != 5) return i32(25)
                }
                stage=stage+1
            }
        }
        r1bit=r1bit+1
    }
    command=0; events=0
    sdMmcCardBeginOwned(card,0,u32(0),100,true); card.store(4,2)
    sdMmcCardPollOwned(card,u32(0)); command=0; events=320
    if (sdMmcCardPollOwned(card,u32(1)) != 4 || card.load(6) != 0) return i32(26)
    // Host busy retries without submitting or losing the next command.
    command=0x80000000; events=0
    sdMmcCardBeginOwned(card,0,u32(0),100,true)
    val busyWrites=writes
    if (sdMmcCardPollOwned(card,u32(1)) != 2 || card.loadU32(8) != 0 || writes != busyWrites) return i32(27)
    command=0
    if (sdMmcCardPollOwned(card,u32(2)) != 2 || card.loadU32(8) == 0) return i32(28)
    // Wrapping deadline retains command and becomes sticky without further IO.
    command=0; events=0
    sdMmcCardBeginOwned(card,0,u32(0xfffffff0),32,true)
    sdMmcCardPollOwned(card,u32(0xfffffff0))
    val before=writes
    if (sdMmcCardPollOwned(card,u32(16)) != 6 || sdMmcCardPollOwned(card,u32(17)) != 6 || writes != before || (command&0x80000000) == 0) return i32(23)
    if (sdMmcCardBeginOwned(card,0,u32(0),100,false) != 3 || card.load(0) != 6 || sdMmcCardBeginOwned(nativeBufferAt(storage,79),0,u32(0),100,true) != 3) return i32(24)
    return i32(0)
}
