import "../src/audio/pcm_channel.ab"
import "abla/runtime/scalar"
import "abla/build"
val channelState=nativeStaticAllocate(32)
val channelSamples=nativeStaticAllocate(4)
val channelMetadata=nativeStaticAllocate(40)
val channelOutput=nativeStaticAllocate(128)
@export("abla_pcm_channel_test")
trusted fun channelTest(): i32 {
    val source=nativeBufferAt(channelSamples,4)
    source.storeU16(0,1000); source.storeU16(2,-1000)
    val first=pcmRaw(nativeBufferAt(channelSamples,2),nativeBufferAt(channelMetadata,20),8000,1,16)
    val second=pcmRaw(nativeBufferAt(channelSamples+2,2),nativeBufferAt(channelMetadata+20,20),16000,1,16)
    val output=nativeBufferAt(channelOutput,128)
    var split=0
    while (split <= 12) {
        val channel=pcmChannelAt(nativeBufferAt(channelState,32),16000)
        if (!channel.valid() || channel.isPlaying() != 0 || !channel.enqueue(first,3) ||
            !channel.enqueue(second,2) || channel.enqueue(second) || channel.isPlaying() != 2) return i32(1)
        if (!channel.render(split,output) || !channel.render(12-split,nativeBufferAt(channelOutput+split*4,128-split*4))) return i32(2)
        var i=0
        while (i < 12) {
            val expected=if (i < 6) 1000 else if (i < 8) -1000 else 0
            if (output.loadU16(i*4) != (expected & 65535) || output.loadU16(i*4+2) != (expected & 65535)) return i32(3)
            i=i+1
        }
        if (channel.isPlaying() != 0 || !channel.enqueue(first,0) || channel.enqueue(second)) return i32(4)
        if (!channel.render(32,output) || channel.isPlaying() != 1 || !channel.enqueue(second,1,true) ||
            !channel.setGain(16384) || !channel.render(2,output) || output.loadU16(0) != 65036 || output.loadU32(4) != 0) return i32(5)
        if (!channel.enqueue(first,0) || channel.render(1,nativeBufferAt(channelState,32)) ||
            channel.render(1,source) || channel.isPlaying() != 1 || !channel.stop() || channel.isPlaying() != 0) return i32(6)
        split=split+1
    }
    i32(0)
}
