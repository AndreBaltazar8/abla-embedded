    if (address == 0x600b0420) return calDigital
    if (address == 0x60096130) return calMux
    if (address == 0x60008068) {
        if ((calCfg&0x80000000) != 0) {
            if (calWaiting > 0) calWaiting=calWaiting-1
            else if ((calMux&7) != timeoutSource) return calCfg|0x8000
