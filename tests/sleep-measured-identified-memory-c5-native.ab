        return calCfg
    }
    if (address == 0x60008080) {
        if ((calTimeout&0xffffff80) == 128 || calWaiting == 0 && (calMux&7) == timeoutSource) return calTimeout|1
        return calTimeout
    }
    if (address == 0x6000806c) {
        calReads=calReads+1
