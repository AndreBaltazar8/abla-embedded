import "../src/esp32/scheduler_select_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_scheduler_select_target")
@section(".iram1.abla.s3SchedulerSelectTarget")
trusted fun selectTarget(queue: NativeBuffer,records: NativeBuffer,running: NativeBuffer,current: NativeBuffer,owners: NativeBuffer,interrupted: NativeBuffer,core: int,level: int): int =
    esp32S3SchedulerSelectOwned(queue,records,running,current,owners,interrupted,core,level)
