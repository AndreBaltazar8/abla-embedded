import "../src/esp32/i2c/bus_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_i2c_bus_target")
trusted fun busTarget(state: Esp32C5I2cBusState,owner: u32,sda: int,scl: int,sourceHz: u32,cpuHz: u32,busHz: u32,close: bool): int =
    if (close) (if (state.closeOwned(owner)) 1 else 0) else state.openOwned(owner,sda,scl,0,sourceHz,cpuHz,busHz)
