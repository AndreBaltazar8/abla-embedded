import "../src/m5stack/pm1_audio_storage_s3_logic.ab"
import "../src/i2c/device_slots.ab"
import "abla/runtime/scalar"
import "abla/build"
val slotsStorage=nativeStaticMutableU32s([0,0,0,0,0,0,0,0])
@export("abla_pm1_audio_storage_test")
fun test(): i32 {
    val control=nativeBufferAt(4096,72)
    val r=nativeBufferAt(8192,136)
    if (!pm1AudioStreamStorageSafe(r,136,12288,2,16384,64,control,20480,24576,28672)) return i32(1)
    var area=0
    while (area < 4) {
        val base=if (area == 0) 4096 else if (area == 1) 20480 else if (area == 2) 24576 else 28672
        val length=if (area == 0) 72 else if (area == 3) 200 else 36
        var offset=-136
        while (offset <= length) {
            val safe=offset+136 <= 0 || offset >= length
            if (pm1AudioStreamStorageSafe(nativeBufferAt(base+offset,136),136,12288,2,16384,64,
                control,20480,24576,28672) != safe) return i32(2)
            offset=offset+1
        }
        offset=-128
        while (offset <= length) {
            if (pm1AudioStreamStorageSafe(r,132,12288,2,base+offset,64,control,20480,24576,28672) !=
                (offset+128 <= 0 || offset >= length)) return i32(3)
            offset=offset+1
        }
        offset=-24
        while (offset <= length) {
            if (pm1AudioStreamStorageSafe(r,132,base+offset,2,16384,64,control,20480,24576,28672) !=
                (offset+24 <= 0 || offset >= length)) return i32(4)
            offset=offset+1
        }
        area=area+1
    }
    if (pm1AudioStreamStorageSafe(r,136,4294967296,2,16384,64,control,20480,24576,28672) ||
        pm1AudioStreamStorageSafe(r,136,12288,2147483647,16384,64,control,20480,24576,28672) ||
        pm1AudioStreamStorageSafe(r,136,12288,2,4294967280,64,control,20480,24576,28672) ||
        pm1AudioStreamStorageSafe(r,136,12288,2,16384,4096,control,20480,24576,28672) ||
        pm1AudioStreamStorageSafe(r,136,12288,2,16384,62,control,20480,24576,28672)) return i32(5)
    var port=0
    while (port < 2) {
        var epoch=1
        while (epoch <= 2147483647) {
            val bus=esp32S3I2cBusKey(port,epoch)
            val descriptor=esp32S3I2cDeviceKey(port,24,100000,epoch)
            val slots=i2cInitializeDeviceSlots(slotsStorage,2)
            val handle=slots.allocate(descriptor)
            if (handle == 0 || !pm1AudioCodecDescriptorMatches(slots.resolve(handle),bus) ||
                !slots.release(handle) || pm1AudioCodecDescriptorMatches(slots.resolve(handle),bus)) return i32(7)
            val replacement=slots.allocate(descriptor)
            if (replacement == 0 || replacement == handle || slots.resolve(handle) != 0 ||
                !pm1AudioCodecDescriptorMatches(slots.resolve(replacement),bus)) return i32(8)
            if (!pm1AudioCodecDescriptorMatches(descriptor,bus) ||
                pm1AudioCodecDescriptorMatches(descriptor,esp32S3I2cBusKey(1-port,epoch)) ||
                pm1AudioCodecDescriptorMatches(descriptor,esp32S3I2cBusKey(port,if (epoch == 1) 2 else 1)) ||
                pm1AudioCodecDescriptorMatches(esp32S3I2cDeviceKey(port,25,100000,epoch),bus) ||
                pm1AudioCodecDescriptorMatches(esp32S3I2cDeviceKey(port,24,400000,epoch),bus) ||
                pm1AudioCodecDescriptorMatches(0,bus)) return i32(6)
            if (epoch == 2147483647) break
            epoch=if (epoch == 1) 1073741824 else 2147483647
        }
        port=port+1
    }
    return i32(0)
}
