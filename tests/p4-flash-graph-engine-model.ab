import "./p4-retention-flash-transfer-checks.ab"
import "./p4-sleep-flash-rev3-checks.ab"
// Optional real-descriptor data path behind the PAU MMIO model. Completion
// IRQ remains separately controlled to exercise delayed/error observations.
var flashGraphEngineEnabled=false
var flashGraphBytes=0
var flashGraphTransfers=0
var flashGraphCopied=0
var flashGraphBad=false
trusted fun seedFlashGraphEngine(uart: int,psram: bool,pvt: bool): int {
    val configs=nativeBufferAt(profileConfigs,76*56+4)
    val backing=nativeBufferAt(profileBacking,6000)
    val scratch=nativeBufferAt(profileScratch,56)
    if (esp32p4RetentionProfileConfigs(configs,backing,scratch,uart,psram,pvt) == 0) return 0
    flashGraphBytes=esp32p4RetentionGraphEncode(nativeBufferAt(profileOutput,2000),nativeBufferAt(graphEntries,20),configs,scratch,uart,psram,pvt,300)
    if (flashGraphBytes == 0) return 0
    var word=0
    while (word < 8192) { nativeBufferAt(flashTransferRegisters,8192).storeU32(word,flashTransferInitial(word));word=word+4 }
    word=0
    while (word < 6000) { backing.storeU32(word,0xdeadbeef);word=word+4 }
    flashGraphTransfers=0;flashGraphCopied=0;flashGraphBad=false;flashGraphEngineEnabled=true
    return nativeBufferAt(graphEntries,20).loadU32(12)
}
trusted fun flashGraphEngineExecute(head: int,backup: bool): bool {
    val regs=nativeBufferAt(flashTransferRegisters,8192)
    if (!backup) {
        // Model lost controller configuration after MSPI reset. Every copied
        // word must be recovered from backing, not reconstructed by the test.
        var word=0
        while (word < 8192) { regs.storeU32(word,flashTransferInitial(word)^0xffffffff);word=word+4 }
    }
    // FCTRL is shared with the cache and wake-workaround models.
    regs.storeU32(0x3c,int(flashControl))
    val result=runFlashTransfer(nativeBufferAt(profileOutput,flashGraphBytes),nativeBufferAt(profileBacking,6000),head,3,backup)
    if (result != ((9<<16)|148)) { flashGraphBad=true;return false }
    flashGraphTransfers=flashGraphTransfers+1;flashGraphCopied=flashGraphCopied+148
    flashControl=u32(regs.loadU32(0x3c))
    if (!backup) {
        var word=0
        while (word < 8192) {
            if (word != 0x3c) {
                var expected=flashTransferInitial(word)
                if (!flashTransferSelected(0x5008c000+word)) expected=expected^0xffffffff
                if (word == 0x180) expected=expected|64
                if (regs.loadU32(word) != expected) { flashGraphBad=true;return false }
            }
            word=word+4
        }
    }
    return true
}
