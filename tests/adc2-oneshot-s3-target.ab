import "../src/esp32/adc2_oneshot_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc2_oneshot_s3_target")
trusted fun target(op: int,channel: int,polls: int): int {
    if (op == 0) return esp32S3Adc2StartOwned(channel)
    if (op == 1) return esp32S3Adc2FinishOwned(channel,polls)
    return esp32S3Adc2ReleaseOwned(channel,polls)
}
