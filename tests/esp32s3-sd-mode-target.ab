import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/spi/software_sd_mode.ab"
import "../src/m5stack/cores3_spi.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_sd_mode_test")
trusted fun sdModeTarget(address: u32, configure: bool): int =
    if (configure) m5BoardStackCoreS3.configureCoreS3SpiPins(peripheralGateAt(int(address)), u32(7)).status()
    else m5BoardStackCoreS3.prepareCoreS3SdSpi(peripheralGateAt(int(address)), u32(7)).status()
