import "../src/display/spi_control_sequence_esp32s3.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/spi/pins.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
val storage = nativeStaticMutableU32s([0])
var calls = 0
var bad = false
var expectedCommand = 54
var expectedValue = 0
var detail = 257
var delays = 0
fun peripheralDelayMilliseconds(duration: int): void {
    if (duration != 120 || calls != 1 || detail != 257 || nativeAddressLoadU32(storage,0) != 7) bad = true
    delays = delays+1
    return
}
// Existing panel mapping includes refresh-direction bits, not just MX/MY/MV.
val orientations = nativeStaticU32s([0,100,212,176,144,32,68,244])
fun esp32s3SpiCommandPinsValid(peripheral: int, pins: SpiPins, select: Pin, dc: Pin, shared: bool): bool =
    peripheral == 2 && pins == spiPins(37,35,36) && select == 3 && dc == 35 && shared
trusted fun check(command: int): int {
    calls = calls + 1
    if (command != expectedCommand || nativeAddressLoadU32(storage,0) != 7) bad = true
    detail
}
trusted fun esp32s3SpiCommandWordOwned(peripheral: int, select: Pin, dc: Pin,
    command: int, value: u32, bytes: int, shared: bool): int {
    if (bytes != 1 || value != u32(expectedValue) || !shared) bad = true
    check(command)
}
trusted fun esp32s3SpiCommandOwned(peripheral: int, select: Pin, dc: Pin,
    command: int, data: NativeBuffer, bytes: int, shared: bool): int {
    if (bytes != 0 || data.capacity() != 0 || !shared) bad = true
    check(command)
}
@export("abla_lcd_spi_control_test")
trusted fun main(): i32 {
    val gate = peripheralGateAt(storage)
    var variant = 0
    while (variant < 44) {
        nativeAddressStoreU32(storage,0,u32(0))
        calls = 0
        delays = 0
        detail = if ((variant & 1) == 0) 257 else 0x20109
        val profile = variant / 2
        val rotation = profile & 7
        val bgr = profile >= 8
        expectedCommand = if (profile < 16) 54 else if (profile == 16) 32 else if (profile == 17) 33
            else if (profile == 18) 17 else if (profile == 19) 16 else if (profile == 20) 56 else 57
        expectedValue = int(nativeAddressLoadU32(orientations,rotation*4)) | (if (bgr) 8 else 0)
        val result = if (profile < 16)
            esp32s3LcdSetRotation(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),lcdGeometry(320,240),rotation,bgr,true)
        else if (profile < 18) esp32s3LcdSetInverted(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),profile == 17,true)
        else if (profile < 20) esp32s3LcdSetSleep(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),profile == 19,120,true)
        else esp32s3LcdSetIdle(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),profile == 21,true)
        if (delays != (if (profile >= 18 && profile < 20 && detail == 257) 1 else 0)) return i32(7)
        if (result.status() != (if (detail == 257) 1 else 6) ||
            result.value() != u32(detail) || calls != 1 || bad) return i32(1)
        if (nativeAddressLoadU32(storage,0) != (if (detail == 257) u32(0) else u32(0x80000000))) return i32(2)
        variant = variant + 1
    }
    calls = 0
    if (esp32s3LcdSetSleep(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),false,-1,true).status() != 3 ||
        esp32s3LcdSetSleep(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),false,5001,true).status() != 3 || calls != 0) return i32(8)
    var rotation = -1
    while (rotation <= 8) {
        if (rotation == -1 || rotation == 8) {
            if (esp32s3LcdSetRotation(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),lcdGeometry(320,240),rotation,true,true).status() != 3) return i32(3)
        }
        rotation = rotation + 1
    }
    if (esp32s3LcdSetInverted(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),false,true).status() != 4) return i32(4)
    nativeAddressStoreU32(storage,0,u32(9))
    if (esp32s3LcdSetInverted(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),false,true).status() != 2) return i32(5)
    if (esp32s3LcdSetInverted(gate,u32(7),2,spiPins(37,35,36),Pin(3),Pin(35),false,false).status() != 3 || calls != 0) return i32(6)
    i32(0)
}
