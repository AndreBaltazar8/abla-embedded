import "../src/rtc/rx8130_device.ab"
import "../src/m5stack/rtc_device.ab"
import "../src/i2c/results.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type I2cDevice = int
val timerPreset=nativeStaticAllocate(2)
val timerVerify=nativeStaticAllocate(2)
var phase=0
var failure=0
var retries=0
var stopCalls=0
var cleanupBad=false
var bad=false
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister8(register: int): int { bad=true; return 0 }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    if (phase == 0) {
        if (register != 28) bad=true
        phase=1
        return I2cByteResult(if (failure == 1) 0 else 256)
    }
    if (phase == 9) {
        if (register != (if ((stopCalls & 3) == 2) 28 else 30)) bad=true
        stopCalls=stopCalls+1
        return I2cByteResult(if (cleanupBad) 272 else 256)
    }
    bad=true; I2cByteResult(0)
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    if (phase == 1) {
        if (register != 28 || value != 1) bad=true
        phase=2
        return failure != 2
    }
    if (phase == 2) {
        if (register != 29 || value != 175) bad=true
        phase=3
        return failure != 3
    }
    if (phase == 5) {
        if (register != 28 || value != 17) bad=true
        phase=6
        return failure != 7
    }
    bad=true; false
}
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    if (value == 16) {
        if (phase != 3 || register != 30 || mask != 16) bad=true
        phase=4
        return failure != 4
    }
    phase=9
    if (register != (if ((stopCalls & 3) == 0) 28 else 30) || mask != 16 || value != 0) bad=true
    stopCalls=stopCalls+1
    true
}
trusted fun I2cDevice.writeRegister(register: int,buffer: NativeBuffer,bytes: int): bool {
    if ((phase != 4 && phase != 5) || register != 26 || bytes != 2 || buffer.loadU16(0) != 64) bad=true
    retries=retries+1; phase=4
    failure != 5
}
trusted fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,bytes: int): bool {
    if (phase != 4 || register != 26 || bytes != 2) bad=true
    buffer.storeU16(0,if (failure == 6 || (failure == 8 && retries < 3)) 63 else 64)
    phase=5
    true
}
@export("abla_rx8130_timer_test")
trusted fun rxTimerTest(): i32 {
    while (failure <= 8) {
        var variant=0
        while (variant < 4) {
            phase=0; retries=0; stopCalls=0; bad=false; cleanupBad=(variant & 1) == 1
            val result=if (variant < 2) Rx8130(7).setTimerInterruptWithBuffers(1000,nativeBufferAt(timerPreset,2),nativeBufferAt(timerVerify,2))
                else M5Rtc((2<<32)|7).setTimerInterruptWithBuffers(1000,nativeBufferAt(timerPreset,2),nativeBufferAt(timerVerify,2))
            val success=failure == 0 || failure == 8
            val expected=if (success) 1 else if (failure == 1) 3 else if (cleanupBad) 5 else 4
            if (result.status() != expected || result.milliseconds() != (if (success) 1000 else 0) || bad ||
                stopCalls != (if (success || failure == 1) 0 else if (cleanupBad) 12 else 4) ||
                retries != (if (failure >= 1 && failure <= 4) 0 else if (failure == 5 || failure == 6 || failure == 8) 3 else 1)) return i32(1)
            variant=variant+1
        }
        failure=failure+1
    }
    phase=0
    if (Rx8130(7).setTimerInterruptWithBuffers(1000,nativeBufferAt(timerPreset,2),nativeBufferAt(timerPreset,2)).status() != 2 || phase != 0) return i32(2)
    i32(0)
}
