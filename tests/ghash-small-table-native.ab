import "../src/crypto/ghash_small_table.ab"
import "../src/crypto/block_modes.ab"
import "abla/runtime/scalar"
import "abla/build"

val storage = nativeStaticAllocate(384)
val knownH = nativeStaticBytes("\x66\xe9\x4b\xd4\xef\x8a\x2c\x3b\x88\x4c\xfa\x59\xca\x34\x2b\x2e")
val knownX = nativeStaticBytes("\x03\x88\xda\xce\x60\xb6\xa3\x92\xf3\x28\xc2\xb9\x71\xb2\xfe\x78")
val knownProduct = nativeStaticBytes("\x5e\x2e\xc7\x46\x91\x70\x62\x88\x2c\x85\xb0\x68\x53\x53\xde\xb7")
val reductions = nativeStaticBytes("\x00\x00\x20\x1c\x40\x38\x60\x24\x80\x70\xa0\x6c\xc0\x48\xe0\x54\x00\xe1\x20\xfd\x40\xd9\x60\xc5\x80\x91\xa0\x8d\xc0\xa9\xe0\xb5")
var random = u32(12345)
fun nextByte(): int {
    random = random ^ (random << u32(13))
    random = random ^ (random >>> u32(17))
    random = random ^ (random << u32(5))
    int(random & u32(255))
}
trusted fun ghashSmallTableTest(): int {
    val table = nativeBufferAt(storage, 256)
    val h = nativeBufferAt(storage + 256, 16)
    val x = nativeBufferAt(storage + 272, 16)
    val expected = nativeBufferAt(storage + 288, 16)
    val temporary = nativeBufferAt(storage + 304, 16)
    val actual = nativeBufferAt(storage + 320, 16)
    var profile = 0
    while (profile < 128) {
        var index = 0
        while (index < 16) {
            h.store(index, if (profile == 0) nativeBufferAt(knownH, 16).load(index) else nextByte())
            index = index + 1
        }
        var digit = 0
        while (digit < 16) {
            index = 0
            while (index < 16) { x.store(index, 0); index = index + 1 }
            x.store(0, digit << 4)
            if (!cryptoGhashMultiply(x, h, expected, temporary)) return 1
            // Table layout is two native-endian64-bit halves, not four
            // big-endian words. Build it independently using bitwise GF math.
            index = 0
            while (index < 16) {
                val reverse = if (index < 8) 7 - index else 23 - index
                table.store(digit * 16 + index, expected.load(reverse))
                index = index + 1
            }
            digit = digit + 1
        }
        var sample = 0
        while (sample < 16) {
            index = 0
            while (index < 16) {
                x.store(index, if (profile == 0 && sample == 0)
                    nativeBufferAt(knownX, 16).load(index) else nextByte())
                index = index + 1
            }
            if (!cryptoGhashMultiply(x, h, expected, temporary)) return 2
            cryptoGhashSmallTable(storage, reductions, x.addressValue(), actual.addressValue())
            index = 0
            while (index < 16) {
                if (actual.load(index) != expected.load(index)) return 3
                if (profile == 0 && sample == 0 && actual.load(index) !=
                    nativeBufferAt(knownProduct, 16).load(index)) return 5
                index = index + 1
            }
            var overlap = -3
            while (overlap <= 3) {
                val overlappingInput = nativeBufferAt(storage + 352, 16)
                index = 0
                while (index < 16) {
                    overlappingInput.store(index, x.load(index))
                    index = index + 1
                }
                cryptoGhashSmallTable(storage, reductions, storage + 352, storage + 352 + overlap)
                val overlappingOutput = nativeBufferAt(storage + 352 + overlap, 16)
                index = 0
                while (index < 16) {
                    if (overlappingOutput.load(index) != expected.load(index)) return 6
                    index = index + 1
                }
                overlap = overlap + 1
            }
            cryptoGhashSmallTable(storage, reductions, x.addressValue(), x.addressValue())
            index = 0
            while (index < 16) {
                if (x.load(index) != expected.load(index)) return 4
                index = index + 1
            }
            sample = sample + 1
        }
        profile = profile + 1
    }
    0
}
#exportFunction("ghashSmallTableTest", "abla_ghash_small_table_test")
