import "../src/display/it8951_readback.ab"
import "../src/display/it8951_session_readback.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(64)
var selected=false
var words=0
var failure=0
var bad=false
fun it8951TransportValid(context: int): bool = context == 7
fun it8951TransportSelect(context: int,active: bool): bool {
    if (context != 7 || (active && selected)) bad=true
    selected=active;return true
}
fun it8951TransportReady(context: int): int = if (context == 7) 1 else -1
fun it8951TransportDelay(context: int,us: int): void { bad=true;return }
fun it8951TransportExchange(context: int,word: int): int {
    words=words+1
    val expected=if (words == 1 || words == 8) 24576 else if (words == 2) 18 else if (words == 4) 0x36e0
        else if (words == 5) 0x12 else if (words == 6) 3 else if (words == 9) 19 else if (words == 10) 4096 else 0
    if (context != 7 || !selected || word != expected || words > 14) bad=true
    if (words == failure) return -1
    if (words == 12) 0x1234 else if (words == 13) 0xabcd else if (words == 14) 0xffff else 0
}
@export("abla_it8951_readback_test")
trusted fun testReadback(): i32 {
    val destination=nativeBufferAt(memory,16)
    val scratch=nativeBufferAt(memory+16,8)
    failure=0
    while (failure <= 14) {
        words=0;bad=false;selected=false
        var index=0
        while (index < 16) { destination.store(index,165);index=index+1 }
        val result=it8951ReadMemoryWords(7,0x1236e0,destination,3,scratch,3)
        val count=if (failure == 0) 3 else if (failure < 12) 0 else failure-12
        if (result.status() != (if (failure == 0) 1 else 4) ||
            result.stage() != (if (failure == 0 || failure >= 10) 11 else if (failure <= 7) 9 else 10) ||
            result.words() != count || selected || bad || words != (if (failure == 0) 14 else failure)) return i32(1)
        index=0
        while (index < 8) {
            val expected=if (index >= count) 0xa5a5 else if (index == 0) 0x1234 else if (index == 1) 0xabcd else 0xffff
            if (destination.loadU16(index*2) != expected) return i32(2)
            index=index+1
        }
        failure=failure+1
    }
    failure=0;words=0
    if (it8951ReadMemoryWords(7,1,destination,3,scratch,3).status() != 2 ||
        it8951ReadMemoryWords(7,4294967292,destination,3,scratch,3).status() != 2 ||
        it8951ReadMemoryWords(7,0x1236e0,destination,0,scratch,3).status() != 2 ||
        it8951ReadMemoryWords(7,0x1236e0,destination,3,destination,3).status() != 2 ||
        it8951ReadMemoryWords(7,0x1236e0,nativeBufferAt(memory,5),3,scratch,3).status() != 2 || words != 0) return i32(3)
    val session=it8951SessionAt(nativeBufferAt(nativeStaticAllocate(40),40))
    if (!session.initialize()) return i32(4)
    session.buffer().storeU32(4,1);session.buffer().storeU32(8,7)
    session.buffer().storeU32(16,8|(4<<16));session.buffer().storeU32(20,0x1236e0)
    if (!session.readImageWordsOwned(0,destination,3,scratch,3,true).success() || session.state() != 1 || words != 14 || bad) return i32(5)
    words=0;failure=12
    val failed=session.readImageWordsOwned(0,destination,3,scratch,3,true)
    if (failed.status() != 4 || session.state() != 2 || session.lastResult() != (failed|0) || words != 12 || bad) return i32(6)
    words=0;failure=0
    if (session.readImageWordsOwned(0,destination,3,scratch,3,true).status() != 2 || words != 0) return i32(7)
    session.buffer().storeU32(4,1)
    if (session.readImageWordsOwned(2,destination,3,scratch,3,true).status() != 2 ||
        session.readImageWordsOwned(28,destination,3,scratch,3,true).status() != 2 ||
        session.readImageWordsOwned(0,session.buffer(),3,scratch,3,true).status() != 2 ||
        session.readImageWordsOwned(0,destination,3,scratch,3,false).status() != 2 || words != 0 || session.state() != 1) return i32(8)
    i32(0)
}
