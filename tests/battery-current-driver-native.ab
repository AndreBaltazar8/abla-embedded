import "../src/m5stack/battery_current.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
type I2cBus=int
var calls=0
var trace=0
var fail=0
var raw=0
var charge=0
var bad=false
// Complete test transport declarations; any operation outside the selected
// current-read paths fails the test, rather than supplying fake success.
fun I2cBus.valid(): bool = this == 7
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister16BigEndian(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.readRegister24BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true; return I2cDwordResult(0) }
fun I2cDevice.readRegister16BigEndianChecked(register: int): I2cWordResult {
    calls=calls+1; trace=trace*1000+register
    if ((register == 122 || register == 124) && this != 7) bad=true
    if ((register == 1 || register == 4) && this != 8) bad=true
    if (register != 122 && register != 124 && register != 1 && register != 4) bad=true
    if (calls == fail) I2cWordResult(0) else I2cWordResult(65536|(if (register == 122) charge else raw))
}
@export("abla_battery_current_driver_test")
fun driverTest(): i32 {
    val axp=M5AxpPower(7|(3<<32)|(5<<40))
    val newer=M5AxpPower(7|(74<<32)|(5<<40))
    val ina=Ina3221(ina3221PackedValue(8))
    val tab=Ina226(8|(1000000<<32))
    var profile=0
    while (profile < 196608) {
        raw=profile & 65535; fail=profile/65536; charge=0x0100
        calls=0; trace=0; bad=false
        val result=m5BoardStackCore2.axpBatteryMilliampsChecked(axp,Ina3221(0))
        // The low register's bits 7:5 are reserved, as the driver treats them.
        val d=(((raw>>>8)<<5)|(raw&31))/2
        if (result.valid() != (fail == 0) || (result.valid() && result.value() != (if (d > 16) -d else 16)) ||
            calls != (if (fail == 1) 1 else 2) || trace != (if (fail == 1) 122 else 122124) || bad) return i32(1)
        profile=profile+1
    }
    profile=0
    while (profile < 131072) {
        raw=profile & 65535; fail=profile/65536
        val signed=if (raw >= 32768) raw-65536 else raw
        calls=0; trace=0; bad=false
        val classic=m5BoardStackCore2.axpBatteryMilliampsChecked(newer,ina)
        if (classic.valid() != (fail == 0) || (classic.valid() && classic.value() != signed*5/10) || calls != 1 || trace != 1 || bad) return i32(2)
        calls=0; trace=0; bad=false
        val tablet=(if ((profile & 1) == 0) m5BoardTab5 else m5BoardTab5X).tabBatteryMilliampsChecked(tab)
        if (tablet.valid() != (fail == 0) || (tablet.valid() && tablet.value() != -signed) || calls != 1 || trace != 4 || bad) return i32(3)
        profile=profile+1
    }
    calls=0
    if (m5BoardStackCoreS3.axpBatteryMilliampsChecked(newer,ina).valid() ||
        m5BoardTab5.tabBatteryMilliampsChecked(Ina226(8)).valid() ||
        m5BoardAtomVoice.tabBatteryMilliampsChecked(tab).valid() ||
        m5BoardStackCore2.axpBatteryMilliampsChecked(M5AxpPower(0),ina).valid() ||
        ina.currentMilliampsChecked(-1).valid() || ina.currentMilliampsChecked(3).valid() ||
        Ina3221(8).currentMilliampsChecked(0).valid() || calls != 0) return i32(4)
    i32(0)
}
