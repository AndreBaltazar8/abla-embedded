import "../src/m5stack/tab5_touch_probe_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var version=0
var valid=true
var gt=false
var trace=0
var prepares=0
var fail=0
fun tab5TouchPrepare(bus: int): int { trace=trace*10+1; prepares=prepares+1; if (prepares == fail) 10 else 1 }
fun tab5TouchFirmware(handle: int): I2cByteResult { trace=trace*10+2; I2cByteResult((if (valid) 256 else 0)|version) }
fun tab5TouchGtAck(bus: int): bool { trace=trace*10+3; gt }
@export("abla_tab5_touch_probe_test")
fun testProbe(): i32 {
    while (version < 256) {
        trace=0; prepares=0
        val result=m5BoardTab5.probeTab5TouchOwned(1,2)
        if (trace != 12 || result.firmware() != version || result.status() != (if (version == 1) 1 else if (version == 3) 2 else 4)) return i32(1)
        version=version+1
    }
    version=0; valid=false
    var profile=0
    while (profile < 8) {
        fail=profile&3; gt=(profile&4) != 0; trace=0; prepares=0
        val result=m5BoardTab5X.probeTab5TouchOwned(1,2)
        if (result.status() != (if (fail != 0) 6 else if (gt) 3 else 5) ||
            trace != (if (fail == 1) 1 else if (fail == 2) 121 else 12131)) return i32(2)
        profile=profile+1
    }
    trace=0
    if (m5BoardAtomVoice.probeTab5TouchOwned(1,2) != 0 || m5BoardTab5.probeTab5TouchOwned(0,2) != 0 || trace != 0) return i32(3)
    i32(0)
}
