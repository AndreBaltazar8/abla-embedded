import "./s3-psram-calibrate80-native.ab"
import "../src/esp32/psram/calibrated_final80_s3_sequence.ab"
var cfCalls=0
var cfStatus=1
var cfBad=false
fun s3PsramFinal80Owned(frequency: int,profile: int,flash: int,psram: int,base: int,original0: int,original1: int,pll: bool,proof: bool): int {
    if (frequency != 80 || profile != 2 || flash != 33 || psram != 68 || base != 5 || original0 != 2 || original1 != 3 || !pll || !proof) cfBad=true
    cfCalls=cfCalls+1;return cfStatus
}
fun cfApply(): int = s3PsramCalibratedFinal80Owned(nativeBufferAt(calMemory,340),80,2,33,true,true)
@export("abla_s3_psram_calibrated_final80_test")
fun testCalibratedFinal80(): int {
    // Build the input with the real coordinator/table/window implementations.
    calReset();calFailPhase=0;calWindow=0
    if (calRun() != 1 || calBad) return 1
    val r=nativeBufferAt(calMemory,340)
    if (s3PsramCalibration80Candidate(r) != 68 || cfApply() != 1 || cfCalls != 1 || cfBad) return 2
    // Exact errors propagate and the evidence remains valid for a retry.
    var stage=1
    while (stage <= 5) {
        cfStatus=(stage<<8)|4
        if (cfApply() != cfStatus || s3PsramCalibration80Candidate(r) != 68) return 3
        stage=stage+1
    }
    cfStatus=1;cfCalls=0
    var phase=0
    while (phase <= 9) {
        if (phase != 8) { r.storeU32(4,phase);if (cfApply() != 2 || cfCalls != 0) return 4 }
        phase=phase+1
    }
    r.storeU32(4,8)
    var offset=64
    while (offset < 240) {
        val original=r.loadU32(offset)
        // All table words and final read words must match exactly; incomplete
        // measurement sentinel invalidates selection even outside winning run.
        r.storeU32(offset,if (offset >= 120 && offset < 176) 4294967295 else original^1)
        if (cfApply() != 2 || cfCalls != 0) return 5
        r.storeU32(offset,original);offset=offset+4
    }
    offset=36
    while (offset < 64) {
        val original=r.loadU32(offset);r.storeU32(offset,original^1)
        if (cfApply() != 2 || cfCalls != 0) return 6
        r.storeU32(offset,original);offset=offset+4
    }
    if (s3PsramCalibratedFinal80Owned(r,80,0,33,true,true) != 2 ||
        s3PsramCalibratedFinal80Owned(r,80,2,33,false,true) != 2 ||
        s3PsramCalibratedFinal80Owned(r,80,2,33,true,false) != 2 ||
        s3PsramCalibratedFinal80Owned(nativeBufferAt(calMemory,339),80,2,33,true,true) != 2 || cfCalls != 0) return 7
    if (cfApply() != 1 || cfBad) return 8
    return 0
}
