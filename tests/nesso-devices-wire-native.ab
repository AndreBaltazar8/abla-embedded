import "./nesso-display-wire-native.ab"
import "../src/m5stack/nesso_devices_c6_bindings.ab"
val devicesStorage=nativeStaticAllocate(112)
val imuData=nativeStaticAllocate(64)
val touchData=nativeStaticAllocate(29)
var imuWaits=0
fun imuDelay(ms: int): void { if (ms != 1) bad=true;imuWaits=imuWaits+1;return }
@export("abla_nesso_devices_wire_test")
trusted fun testDevicesWire(): i32 {
    var scenario=0
    while (scenario < 5) {
        displayCapture=false;wireSeed();chargeAddress=85;afterCommit=false;bad=false;dropClose=false;ticks=0;commands=0;delayTotal=0;imuWaits=0
        val gpioRegs=nativeBufferAt(gpioMemory,4096);var at=0
        while (at < 4096) { gpioRegs.storeU32(at,0);at=at+4 }
        apb=u32(0);functional=u32(0x300000);gpioClock=u32(0)
        var session=esp32C6I2cSessionOpenOwned(10,8,40000000,20000000,true,5,8)
        val boardRegs=nativeBufferAt(registers,512)
        at=0;while (at < 512) { boardRegs.store(at,255);at=at+1 }
        boardRegs.store(1,1);boardRegs.store(266,73)
        e1Present=true;rtcPresent=true;rtcAddress=56;pm1ImuPresent=true;bmiModel=true;bmiExpectedConfig=bmi270ConfigurationAddress
        val e1=nativeBufferAt(e1Registers,256);val ft=nativeBufferAt(rtcRegisters,256);val bmi=nativeBufferAt(pm1ImuRegisters,256)
        at=0;while (at < 256) { e1.store(at,0);ft.store(at,0);bmi.store(at,0);at=at+1 }
        e1.store(1,1);ft.store(168,1);bmi.store(0,36)
        val devices=nessoDevicesAt(nativeBufferAt(devicesStorage,112))
        if (!session.ready() || !devices.initialize()) return i32(1)
        nativeAddressStoreU32(displayGate,0,0);displayGateAddress=displayGate;displayCapture=true
        expectDisplay(nativeBufferAt(initialStream,68),if (scenario == 1) 0 else 64868)
        nackAt=if (scenario == 1) 75 else if (scenario == 2) 102 else if (scenario == 3) 111 else if (scenario == 4) 115 else 0
        val result=devices.openOwned(session.bus()|0,peripheralGateAt(displayGate),u32(7),true)
        if (result != (if (scenario == 0) 1 else 10+scenario) || bad || displayByteCount != displayExpectedBytes || displayBits != 0) return i32(2)
        val expectedMask=if (scenario == 0) 15 else (1<<scenario)-1
        if (devices.pending() != expectedMask || devices.ready() != (scenario == 0)) return i32(3)
        nackAt=0
        if (scenario == 0) {
            if (!devices.power().ready() || !devices.display().ready() || !devices.touch().ready() || !devices.imu().ready() ||
                e1.load(5) != 194 || bmiUploaded != 8192 || imuWaits != 3) return i32(4)
            ft.store(2,1);ft.store(3,128);ft.store(4,12);ft.store(5,0);ft.store(6,34)
            val snapshot=nativeBufferAt(touchData,29)
            if (devices.display().readTouchOwned(session.bus()|0,devices.touch(),snapshot,true) != 1 ||
                nessoTouchPoint(snapshot,1,0,0).x() != 12) return i32(5)
            val imuSnapshot=imuSnapshotAt(nativeBufferAt(imuData,44));val scratch=nativeBufferAt(imuData+44,20)
            if (!imuSnapshot.initialize()) return i32(6)
            bmi.store(29,192);bmi.storeU16(12,123);bmi.storeU16(22,65536-456)
            if (devices.power().readImuOwned(session.bus()|0,devices.imu(),imuSnapshot,scratch,100,true) != 3 ||
                imuSnapshot.axes(0).axis(0) != 123 || imuSnapshot.axes(1).axis(2) != -456) return i32(7)
            val before=ackCount
            if (!softwareI2cProviderEnter()) return i32(8)
            val closed=devices.closeOwned(true)
            if (!softwareI2cProviderLeave() || closed || devices.pending() != 15 || devices.failure() != 24 || ackCount != before ||
                !nessoDevicesPower(devices.buffer()).ready() || !nessoDevicesDisplay(devices.buffer()).ready()) return i32(9)
        }
        expectDisplay(NativeBuffer(0),0)
        if (!devices.closeOwned(true) || devices.phase() != 0 || devices.pending() != 0 || bad ||
            (scenario != 1 && e1.load(5) != 130)) return i32(10)
        displayCapture=false
        if (scenario != 1 && (!Pin(17).inputOwned() || !Pin(16).inputOwned() || !Pin(20).inputOwned() || !Pin(21).inputOwned())) return i32(11)
        session=session.closeOwned(true)
        if (session != 0 || bad) return i32(12)
        scenario=scenario+1
    }
    return i32(0)
}
