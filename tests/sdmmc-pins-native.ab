import "../src/sd/mmc_pins_s3_sequence.ab"
import "../src/esp32/soc/gpio_capabilities.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this)
var calls=0
var failure=-1
var driveFailure=-1
var slot=0
var bad=false
trusted fun Pin.setPull(up: bool,down: bool): void { if (down || up != (this != 1)) bad=true; return }
trusted fun Pin.setDriveStrength(value: int): bool = value == 3 && this != driveFailure
trusted fun Pin.routeOutputSignal(signal: int,inverted: bool): bool { calls=calls+1; if (this != 1 || signal != 172+slot || inverted) bad=true; return this != failure }
trusted fun Pin.routeBidirectionalSignal(input: int,output: int): bool {
    calls=calls+1
    val expected=if (this == 2) 178+slot else (if (slot == 0) 180 else 213)+(this-3)
    if (input != expected || output != expected) bad=true
    return this != failure
}
@export("abla_sdmmc_pins_test")
trusted fun test(): i32 {
    val pins=sdMmcPins(1,2,3,4,5,6)
    while (slot < 2) {
        calls=0
        if (pins.routeOwned(slot,true,true) != 1 || calls != 6 || bad) return i32(1)
        calls=0
        if (sdMmcPins(1,2,3).routeOwned(slot,true,true) != 1 || calls != 3) return i32(2)
        failure=1
        while (failure <= 6) {
            calls=0
            if (pins.routeOwned(slot,true,true) != failure+2 || calls != failure) return i32(3)
            failure=failure+1
        }
        failure=-1; driveFailure=1
        while (driveFailure <= 6) {
            calls=0
            if (pins.routeOwned(slot,true,true) != driveFailure+15 || calls != driveFailure-1) return i32(4)
            driveFailure=driveFailure+1
        }
        driveFailure=-1; slot=slot+1
    }
    calls=0
    if (sdMmcPins(1,1,3).valid() || sdMmcPins(1,2,3,4).valid() || sdMmcPins(1,2,22).valid() || pins.routeOwned(0,false,true) != 2 || pins.routeOwned(0,true,false) != 2 || calls != 0 || bad) return i32(5)
    return i32(0)
}
