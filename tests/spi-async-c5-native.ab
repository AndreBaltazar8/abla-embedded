import "./spi-transfer-c5-native.ab"
import "../src/esp32/spi/async_c5_sequence.ab"
import "abla/runtime/scalar"
val asyncMemory=nativeStaticAllocate(32)
@export("abla_spi_async_c5_test")
trusted fun testAsyncC5(): i32 {
    val context=nativeBufferAt(asyncMemory,32)
    var bytes=1
    while (bytes <= 64) {
        var alignment=0
        while (alignment < 4) {
            seed(alignment,bytes)
            val tx=nativeBufferAt(txAddress,bytes);val rx=nativeBufferAt(ram+96,bytes)
            if (!esp32C5SpiAsyncInitialize(context) || esp32C5SpiAsyncBeginOwned(context,tx,rx,bytes,u32(4294967290),u32(10),true) != 0 || started != 0) return i32(1)
            if (esp32C5SpiAsyncBeginOwned(context,tx,rx,bytes,u32(0),u32(10),true) != 3) return i32(2)
            if (esp32C5SpiAsyncPollOwned(context,u32(4294967291)) != 0 || started != 0 ||
                esp32C5SpiAsyncPollOwned(context,u32(4294967292)) != 0 || started != 1 ||
                esp32C5SpiAsyncPollOwned(context,u32(3)) != 257 || bad) return i32(3)
            var at=0;while (at < bytes) { if (rx.load(at) != (tx.load(at)^255)) return i32(4);at=at+1 }
            val oldWrites=writes
            if (esp32C5SpiAsyncPollOwned(context,u32(20)) != 257 || writes != oldWrites || started != 1) return i32(5)
            alignment=alignment+1
        }
        bytes=bytes+1
    }
    var scenario=1
    while (scenario <= 7) {
        seed(0,17);fault=scenario
        val tx=nativeBufferAt(ram,17);val rx=nativeBufferAt(ram+96,17)
        esp32C5SpiAsyncInitialize(context)
        val began=esp32C5SpiAsyncBeginOwned(context,tx,rx,17,u32(4294967290),u32(10),true)
        if (scenario >= 5) {
            if (began != 5 || started != 0) return i32(6)
        } else {
            if (began != 0) return i32(7)
            esp32C5SpiAsyncPollOwned(context,u32(4294967291))
            esp32C5SpiAsyncPollOwned(context,u32(4294967292))
            val result=esp32C5SpiAsyncPollOwned(context,if (scenario == 4) u32(3) else u32(4))
            val expected=if (scenario == 1) 6 else if (scenario == 4) 265|int(fifoError) else 263
            if (result != expected || started != (if (scenario == 1) 0 else 1)) return i32(8)
        }
        var at=0;while (at < 17) { if (rx.load(at) != 90) return i32(9);at=at+1 }
        if (bad) return i32(10)
        scenario=scenario+1
    }
    var errorIndex=0
    while (errorIndex < 4) {
        seed(0,4);esp32C5SpiAsyncInitialize(context)
        val tx=nativeBufferAt(ram,4);val rx=nativeBufferAt(ram+96,4)
        if (esp32C5SpiAsyncBeginOwned(context,tx,rx,4,u32(0),u32(10),true) != 0) return i32(11)
        val raw=if (errorIndex == 0) 1 else if (errorIndex == 1) 2 else if (errorIndex == 2) 131072 else 262144
        events=u32(raw)
        if (esp32C5SpiAsyncPollOwned(context,u32(1)) != (9|(raw&0x60000)|((raw&3)<<19)) || started != 0) return i32(12)
        errorIndex=errorIndex+1
    }
    var receive=0
    while (receive < 2) {
        seed(0,17);esp32C5SpiAsyncInitialize(context)
        val tx=nativeBufferAt(ram,17)
        if (esp32C5SpiAsyncBeginOwned(context,tx,tx,17,u32(0),u32(10),receive == 1) != 0) return i32(13)
        esp32C5SpiAsyncPollOwned(context,u32(1));esp32C5SpiAsyncPollOwned(context,u32(2))
        if (esp32C5SpiAsyncPollOwned(context,u32(3)) != 257) return i32(14)
        var at=0;while (at < 17) { if (tx.load(at) != (((at*37+19)&255)^(if (receive == 1) 255 else 0))) return i32(15);at=at+1 }
        receive=receive+1
    }
    seed(0,4);esp32C5SpiAsyncInitialize(context)
    val tx=nativeBufferAt(ram,4)
    if (esp32C5SpiAsyncBeginOwned(context,context,tx,4,u32(0),u32(10),true) != 2 ||
        esp32C5SpiAsyncBeginOwned(context,tx,context,4,u32(0),u32(10),true) != 2 ||
        esp32C5SpiAsyncBeginOwned(context,tx,tx,4,u32(0),u32(0),true) != 2 || writes != 0) return i32(16)
    return i32(0)
}
