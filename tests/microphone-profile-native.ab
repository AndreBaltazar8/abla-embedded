import "../src/m5stack/microphone_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
// Expected values independently transcribed from pinned _begin_audio cases.
fun check(id: int,mode: int,data: int,ws: int,bclk: int,mclk: int,port: int,channel: int,gain: int,os: int,hz: int,enable: bool): bool {
    val board=M5BoardId(id);val p=board.microphoneProfile()
    return p.available() && p.transport() == mode && p.dataPin() == data && p.wordSelectPin() == ws &&
        p.bitClockPin() == bclk && p.masterClockPin() == mclk && p.port() == port && p.channel() == channel &&
        p.gain() == gain && p.oversampling() == os && p.sampleRate() == hz && board.microphoneNeedsEnableSequence() == enable &&
        (if (mode == 1) p.pdmPins() == pdmPins(ws,data) && p.pdmSlotMask() == 2 else !p.pdmPins().valid() && p.pdmSlotMask() == 0)
}
@export("abla_microphone_profile_test")
fun test(): i32 {
    if (!check(1,3,34,-1,-1,-1,0,0,16,4,16000,false) ||
        !check(2,1,34,0,-1,-1,0,0,16,1,16000,false) ||
        !check(3,1,34,0,-1,-1,0,0,16,1,16000,true) ||
        !check(4,1,34,0,-1,-1,0,0,16,1,16000,true) ||
        !check(5,1,34,0,-1,-1,0,0,16,1,16000,false) ||
        !check(8,1,34,0,-1,-1,0,0,16,1,16000,false) ||
        !check(10,2,14,33,34,0,1,2,2,1,16000,true) ||
        !check(14,1,46,43,-1,-1,0,0,16,1,16000,false) ||
        !check(17,2,14,33,34,0,1,2,2,1,16000,true) ||
        !check(22,2,28,29,27,30,0,2,2,1,16000,true) ||
        !check(24,2,46,43,41,-1,0,0,16,1,16000,true) ||
        !check(26,2,16,15,17,18,1,0,16,1,16000,true) ||
        !check(27,2,14,33,34,0,1,2,2,1,16000,true) ||
        !check(28,2,39,41,40,42,1,1,16,1,16000,true) ||
        !check(29,1,46,45,-1,-1,0,0,16,1,16000,true) ||
        !check(30,2,16,15,17,18,1,0,16,1,16000,true) ||
        !check(31,2,5,4,6,2,0,2,2,1,24000,true) ||
        !check(32,2,39,41,38,40,1,0,16,1,16000,true) ||
        !check(35,2,28,29,27,30,0,2,2,1,16000,true) ||
        !check(130,1,19,5,-1,-1,0,0,16,1,16000,false) ||
        !check(138,1,38,39,-1,-1,0,0,16,1,16000,false) ||
        !check(139,1,41,40,-1,-1,0,0,16,1,16000,false) ||
        !check(142,1,23,33,-1,-1,0,0,16,1,16000,false) ||
        !check(145,2,4,3,17,11,1,2,1,1,16000,true)) return i32(1)
    var board=0;var count=0
    while (board < 1024) {
        val p=M5BoardId(board).microphoneProfile()
        if (p.available()) count=count+1
        else if (p.dataPin() != -1 || p.sampleRate() != 0 || M5BoardId(board).microphoneNeedsEnableSequence()) return i32(2)
        board=board+1
    }
    if (count != 24 || m5BoardAtomEcho().microphoneProfile() != m5BoardAtomVoice.microphoneProfile()) return i32(3)
    if (m5MicrophoneProfile(1,10,11,-1,-1,0,1).pdmSlotMask() != 1 || m5MicrophoneProfile(1,10,11,-1,-1,0,2).pdmSlotMask() != 3 ||
        m5MicrophoneProfile(1,63,0).available()) return i32(4)
    return i32(0)
}
