import "../src/esp32/power/sleep_timing_apply_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(160)
var writes=0
var failAt=0
var bad=false
fun slot(offset: int): int = if (offset == 0x130) 0 else if (offset == 0x140) 1 else if (offset == 0x138) 2 else
    if (offset == 0xec) 3 else if (offset == 0xf0) 4 else if (offset == 0xf4) 5 else if (offset == 0x120) 6 else -1
trusted fun c5SleepTimingRead(offset: int): int {
    val index=slot(offset);if (index < 0) { bad=true;return 0 }
    nativeBufferAt(memory+112,28).loadU32(index*4)
}
trusted fun c5SleepTimingWrite(offset: int,value: int): void {
    writes=writes+1
    if (slot(offset) < 0) { bad=true;return }
    if (writes != failAt) nativeBufferAt(memory+112,28).storeU32(slot(offset)*4,value)
    return
}
@export("abla_sleep_timing_apply_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,48);val plan=nativeBufferAt(memory+48,56);val registers=nativeBufferAt(memory+112,28)
    var mode=0
    while (mode < 4) {
        var fault=0
        while (fault <= 14) {
            record.storeU32(0,0);writes=0;failAt=fault;bad=false
            var i=0;while (i < 14) { plan.storeU32(i*4,i+1);i=i+1 }
            i=0;while (i < 7) { registers.storeU32(i*4,0xdeadbeef);i=i+1 }
            val result=esp32C5SleepTimingApplyOwned(record,plan,(mode&1) != 0,true,if (mode >= 2) 12345 else -1)
            if (result != (if (fault >= 1 && fault <= 7) 3 else 1) || bad) return i32(1)
            if (result == 1) {
                if (registers.loadU32(0) != 0xdead0102 || registers.loadU32(4) != 0x0003beef ||
                    registers.loadU32(8) != (if (mode >= 2) 0x04a03039 else 0x04adbeef) || registers.loadU32(20) != 0x0a090c0b || registers.loadU32(24) != 0x000e000d) return i32(2)
                if (((registers.loadU32(12)>>>23)&511) != (if ((mode&1) != 0) 7 else 5)) return i32(3)
            }
            val before=writes
            if (esp32C5SleepTimingApplyOwned(record,plan,false,true) != 2 || writes != before) return i32(4)
            esp32C5SleepTimingCloseOwned(record,true);failAt=0
            if (esp32C5SleepTimingCloseOwned(record,true) != 4) return i32(5)
            i=0;while (i < 7) { if (registers.loadU32(i*4) != 0xdeadbeef) return i32(6);i=i+1 }
            fault=fault+1
        }
        mode=mode+1
    }
    writes=0;plan.storeU32(28,128)
    if (esp32C5SleepTimingApplyOwned(record,plan,false,true) != 2 || writes != 0) return i32(7)
    return i32(0)
}
