import "../src/esp32/clock.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_esp32_clock_scalar_test")
trusted fun testClockScalar(): i32 {
    val memory=nativeStaticAllocate(8)
    var sample=u64(0)
    var index=0
    while (index < 100000) {
        // Independent host division oracle; production path uses Abla divider.
        if (esp32MillisecondsFromTimerTicks(sample) != int((sample>>u64(1))/u64(1000))) return i32(1)
        sample=sample*u64(6364136223846793005)+u64(1442695040888963407)
        index=index+1
    }
    index=0
    while (index < 4001) {
        if (esp32MillisecondsFromTimerTicks(u64(index)) != index/2000) return i32(2)
        index=index+1
    }
    if (esp32MillisecondsFromTimerTicks(u64(18446744073709551615)) != 9223372036854775) return i32(3)
    index=0
    while (index < 32) {
        val word=u32(1)<<u32(index)
        xtensaDeviceStoreU32(u32(memory),word)
        if (xtensaDeviceLoadU32(u32(memory)) != word) return i32(4)
        index=index+1
    }
    return i32(0)
}
