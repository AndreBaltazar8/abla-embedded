import "../src/esp32/clock_state_s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_clock_state_test")
trusted fun clockStateTest(): i32 {
    var half=0
    while (half <= 65535) {
        val mirrored=half | (half<<16)
        val expected=if (half == 65535) 0 else half & 65534
        if (esp32S3StoredXtalMegahertz(mirrored) != expected ||
            esp32S3StoredXtalMegahertz(mirrored ^ (1<<16)) != 0) return i32(1)
        half=half+1
    }
    var divider=1
    while (divider <= 1024) {
        val state=esp32S3ClockDecode(divider-1,0,0x00290029)
        if (!state.valid() || state.source() != 0 || state.sourceMegahertz() != 40 ||
            state.divider() != divider || state.hertz() != 40000000/divider) return i32(2)
        divider=divider+1
    }
    var cpu=0
    while (cpu < 256) {
        val state=esp32S3ClockDecode(0xFFFFF7FF,cpu,0)
        val selector=cpu & 3
        val valid=selector < 2 || (selector == 2 && (cpu & 4) != 0)
        if (state.valid() != valid) return i32(3)
        if (valid && (state.source() != 1 || state.hertz() != (selector+1)*80000000 ||
            state.sourceMegahertz() != (if ((cpu & 4) != 0) 480 else 320))) return i32(4)
        cpu=cpu+1
    }
    if (esp32S3ClockDecode(0,0,0).valid() || esp32S3ClockDecode(3072,0,0x00280028).valid() ||
        esp32S3ClockDecode(2048,0,0).hertz() != 20000000 || Esp32S3ClockState(0).hertz() != 0) return i32(5)
    i32(0)
}
