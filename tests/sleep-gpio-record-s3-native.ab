import "./gpio-wake-session-s3-native.ab"
import "../src/esp32/power/sleep_gpio_record_s3_sequence.ab"
val gpioSleepMemory=nativeStaticAllocate(128)
type Esp32S3SleepResume=int
fun Esp32S3SleepResume.valid(): bool = this >= 0
fun Esp32S3SleepResume.complete(): bool = this == 1
var gpioResume=1
var gpioEntryCalls=0
fun esp32S3MspiStateLoad64(address: int): int = gpioResume
fun esp32S3SleepExternalOnlyRecordEnterOwned(sleep: NativeBuffer,flags: int,period: int,wake: int,reject: int): int {
    gpioEntryCalls=gpioEntryCalls+1;return if (flags == 0 && period == 123 && wake == 4 && reject == 7) 21 else -21
}
fun esp32S3SleepTimedRecordEnterOwned(sleep: NativeBuffer,flags: int,period: int,duration: int,wake: int,reject: int): int {
    gpioEntryCalls=gpioEntryCalls+1;return if (flags == 0 && period == 123 && duration == 456 && wake == 4 && reject == 7) 22 else -22
}
@export("abla_sleep_gpio_record_s3_test")
fun gpioSleepTest(): int {
    val sleep=nativeBufferAt(gpioSleepMemory,128);val wake=nativeBufferAt(sessionMemory,36)
    var pin=0
    while (pin < 49) {
        if (pin < 22 || pin > 25) {
            seedSession(wake,pin,true);sleep.storeU32(108,0)
            if (esp32S3GpioWakeSessionOpenOwned(wake,pin,false,true) != 1) return 1
            if (esp32S3SleepGpioEnterOwned(sleep,wake,0,123,0,7) != 21 || esp32S3SleepGpioEnterOwned(sleep,wake,0,123,456,7) != 22) return 2
            val calls=gpioEntryCalls;sleep.storeU32(108,2)
            if (esp32S3SleepGpioReadyOwned(sleep,wake) != (pin != 19 && pin != 20)) return 3
            if (esp32S3SleepGpioEnterOwned(sleep,wake,0,123,-1,7) != -6 || gpioEntryCalls != calls) return 4
            sleep.storeU32(0,0x53504C50);sleep.storeU32(4,11)
            val writes=sessionWrites
            if (esp32S3SleepGpioCleanupOwned(sleep,wake) || writes != sessionWrites) return 5
            sleep.storeU32(0,0);sleep.storeU32(4,6);gpioResume=0
            if (esp32S3SleepGpioCleanupOwned(sleep,wake) || writes != sessionWrites) return 6
            gpioResume=1;sessionDrop=sessionWrites+1
            if (esp32S3SleepGpioCleanupOwned(sleep,wake)) return 7
            sessionDrop=0
            if (!esp32S3SleepGpioCleanupOwned(sleep,wake) || !restoredSession(wake) || esp32S3SleepGpioReadyOwned(sleep,wake)) return 8
            val closedWrites=sessionWrites
            if (!esp32S3SleepGpioCleanupOwned(sleep,wake) || closedWrites != sessionWrites) return 9
        }
        pin=pin+1
    }
    seedSession(wake,48,true);sleep.storeU32(108,0)
    if (esp32S3GpioWakeSessionOpenOwned(wake,48,false,true) != 1) return 10
    sessionTrigger=sessionTrigger&(~0x20000)
    if (esp32S3SleepGpioReadyOwned(sleep,wake)) return 11
    sessionTrigger=sessionTrigger|0x20000;sessionPad=sessionPad|0x2000
    if (esp32S3SleepGpioReadyOwned(sleep,wake)) return 12
    sessionPad=sessionPad&(~0x3e780)
    if (esp32S3SleepGpioReadyOwned(sleep,wake) || esp32S3SleepGpioRecordsDisjoint(sleep,nativeBufferAt(gpioSleepMemory+4,32)) || esp32S3SleepGpioRecordsDisjoint(nativeBufferAt(gpioSleepMemory,124),wake)) return 13
    return 0
}
