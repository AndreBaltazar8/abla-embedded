import "../src/input/touch.ab"
import "abla/runtime/scalar"
import "abla/build"

// Host oracle entry only; never imported by an application or framework.
@export("abla_touch_transition")
trusted fun transition(address: i64, now: u32, operation: i32,
    x: i32, y: i32, size: u32, id: u32, hold: u32, flick: u32): i32 {
    val detail = TouchDetail(int(address))
    val visible = if (operation == i32(2))
        detail.advance(int(now), int(hold))
    else detail.update(int(now), operation != i32(0),
        gesturePoint(int(x), int(y), int(size), int(id)), int(hold), int(flick))
    if (visible) i32(1) else i32(0)
}
