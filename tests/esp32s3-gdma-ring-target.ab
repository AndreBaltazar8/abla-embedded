import "../src/esp32/gdma_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun gdmaRingTarget(descriptors: u32, count: i32, buffers: u32, stride: i32, capacity: i32, transmit: bool): bool =
    esp32s3GdmaInitializeRingOwned(int(descriptors), int(count), int(buffers), int(stride), int(capacity), transmit)
#exportFunction("gdmaRingTarget", "abla_s3_gdma_ring_test")
