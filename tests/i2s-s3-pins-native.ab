import "../src/esp32/i2s/pin_routes_esp32s3.ab"
import "../src/esp32/soc/gpio_capabilities.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = espChipS3().gpioValid(this)
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this)
var port = 0
var tx = false
var flags = 0
var count = 0
var bad = false
trusted fun routeCheck(number: int, signal: int, invert: bool, output: bool): bool {
    var expectedSignal = if (port == 0) 25 else 30
    var expectedPin = 14
    var expectedInvert = false
    var expectedOutput = tx
    if (count == 1) {
        expectedPin = 33
        expectedSignal = if (port == 0) (if (tx) 24 else 27) else (if (tx) 29 else 32)
        expectedInvert = (flags & 8) != 0
        expectedOutput = (flags & 1) == 0
    } else if (count == 2) {
        expectedPin = 34
        expectedSignal = if (port == 0) (if (tx) 22 else 26) else (if (tx) 28 else 31)
        expectedInvert = (flags & 4) != 0
        expectedOutput = (flags & 1) == 0
    } else if (count == 3) {
        expectedPin = 0
        expectedSignal = if (port == 0) 23 else 21
        expectedInvert = (flags & 16) != 0
        expectedOutput = (flags & 2) == 0
    }
    if (count > 3 || number != expectedPin || signal != expectedSignal || invert != expectedInvert || output != expectedOutput) bad = true
    count = count + 1
    true
}
trusted fun Pin.routeInputSignal(signal: int, inverted: bool = false): bool = routeCheck(this.number(), signal, inverted, false)
trusted fun Pin.routeOutputSignal(signal: int, inverted: bool = false): bool = routeCheck(this.number(), signal, inverted, true)
trusted fun i2sPinsTest(): int {
    var route = 0
    while (route < 4) {
        port = route / 2
        tx = (route & 1) != 0
        flags = 0
        while (flags < 32) {
            count = 0
            if (!esp32s3I2sRoutePins(port, tx, Pin(0), Pin(34), Pin(33), Pin(14), flags) || count != 4 || bad) return 1
            flags = flags + 1
        }
        route = route + 1
    }
    port = 1
    tx = true
    flags = 0
    count = 0
    if (!esp32s3I2sRoutePins(port, tx, Pin(-1), Pin(34), Pin(33), Pin(14), flags) || count != 3 || bad) return 2
    count = 0
    if (esp32s3I2sRoutePins(0, true, Pin(0), Pin(34), Pin(34), Pin(14), 0) || esp32s3I2sRoutePins(0, true, Pin(14), Pin(34), Pin(33), Pin(14), 0) || esp32s3I2sRoutePins(0, true, Pin(-1), Pin(34), Pin(33), Pin(14), 2) || esp32s3I2sRoutePins(0, true, Pin(0), Pin(22), Pin(33), Pin(14), 0) || count != 0) return 3
    // GPIO46 is output-capable on S3 (unlike S2); GPIO22..25 are absent.
    if (!esp32s3I2sPinsValid(0, false, Pin(-1), Pin(46), Pin(33), Pin(14), 1) || !esp32s3I2sPinsValid(0, true, Pin(0), Pin(34), Pin(33), Pin(46), 0) || esp32s3I2sPinsValid(2, true, Pin(0), Pin(34), Pin(33), Pin(14), 0)) return 4
    0
}
#exportFunction("i2sPinsTest", "abla_i2s_pins_test")
