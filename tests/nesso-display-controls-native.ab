import "./nesso-display-native.ab"
import "../src/m5stack/nesso_display_controls_sequence.ab"
var sleepCalls=0
var sleepFailure=false
var expectedSleeping=true
fun nessoDisplaySetPanelSleep(gate: PeripheralGate,owner: u32,sleeping: bool,settle: int): int {
    reentryCheck()
    if (sleeping != expectedSleeping || settle != 130 || lastBrightness != 0) bad=true
    sleepCalls=sleepCalls+1;return (if (sleepFailure) 6 else 1)<<32
}
fun openDisplay(): NessoDisplay {
    pinFailure=false;openFailure=0;setupFailure=0;initFailure=false;clearFailure=false
    lightFailure=false;closeFailure=false;parkFailure=false;stage=0;parks=0;owned=false;lightCalls=0;bad=false
    expectedRotation=0;expectedBgr=true;sleepCalls=0;sleepFailure=false;expectedSleeping=true
    val display=nessoDisplayAt(nativeBufferAt(displayStorage,40))
    if (!display.initialize() || display.openOwned(7,PeripheralGate(16),u32(7),0,true,true) != 1) bad=true
    return display
}
@export("abla_nesso_display_controls_test")
trusted fun testControls(): i32 {
    var brightness=0
    while (brightness <= 255) {
        val display=openDisplay()
        if (display.brightness() != 255 || !display.setBrightnessOwned(brightness,true) ||
            display.brightness() != brightness || lastBrightness != brightness) return i32(1)
        if (!display.setSleepingOwned(true,130,true) || !display.sleeping() || display.ready() || lastBrightness != 0 || sleepCalls != 1) return i32(2)
        val before=lightCalls
        if (!display.setBrightnessOwned(255-brightness,true) || lightCalls != before || display.brightness() != 255-brightness ||
            !display.setSleepingOwned(true,130,true) || sleepCalls != 1) return i32(3)
        expectedSleeping=false
        if (!display.setSleepingOwned(false,130,true) || !display.ready() || lastBrightness != 255-brightness || lightCalls != before+1 || sleepCalls != 2) return i32(4)
        val calls=lightCalls
        if (display.setBrightnessOwned(-1,true) || display.setBrightnessOwned(256,true) || display.setBrightnessOwned(1,false) ||
            display.setSleepingOwned(true,-1,true) || display.setSleepingOwned(true,5001,true) || display.setSleepingOwned(true,130,false) ||
            lightCalls != calls || sleepCalls != 2) return i32(5)
        if (!display.closeOwned(true) || owned || bad) return i32(6)
        brightness=brightness+1
    }
    var failure=0
    while (failure < 4) {
        val display=openDisplay()
        if (failure >= 2) {
            if (!display.setSleepingOwned(true,130,true)) return i32(7)
            expectedSleeping=false
        }
        lightFailure=failure == 0 || failure == 3;sleepFailure=failure == 1 || failure == 2
        val before=lightCalls;val commands=sleepCalls
        if (display.setSleepingOwned(failure < 2,130,true) || display.phase() != 2 || !owned ||
            display.failure() != (if (sleepFailure) 12 else 11)) return i32(8)
        if (sleepCalls-commands != (if (failure == 0) 0 else 1) ||
            lightCalls-before != (if (failure == 2) 0 else 1)) return i32(9)
        lightFailure=false;sleepFailure=false
        if (!display.closeOwned(true) || owned || bad) return i32(10)
        failure=failure+1
    }
    val sleepingDisplay=openDisplay()
    if (!sleepingDisplay.setSleepingOwned(true,130,true) || !sleepingDisplay.closeOwned(true) || owned || bad) return i32(11)
    return i32(0)
}
