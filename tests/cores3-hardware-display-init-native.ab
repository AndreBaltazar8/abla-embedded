import "abla/runtime/scalar"
import "abla/build"
#exportFunction("main", "abla_cores3_hardware_init_test")
import "../src/m5stack/cores3_panel_logic.ab"
import "../src/m5stack/cores3_display_hardware_init_sequence.ab"
type M5BoardId = int
type Axp2101 = int
type Aw9523 = int
type Ft5x06 = int
type PeripheralGate = int
type AtomicU32 = int
type SpiTransactionResult = int
fun M5BoardId.displaySharedDataCommand(): bool = this == 10
fun Axp2101.valid(): bool = this == 1
fun Aw9523.valid(): bool = this == 2
fun Ft5x06.valid(): bool = this == 3
fun PeripheralGate.word(): AtomicU32 = AtomicU32(this & 4294967295)
fun AtomicU32.valid(): bool = this == 4
fun peripheralOwnerValid(owner: u32): bool = owner == u32(7)
fun SpiTransactionResult.valid(): bool = this == 1
fun SpiTransactionResult.status(): int = this
var step = 0
var fail = 0
var cleanFails = false
var cleanupCalls = 0
var revision = 1
var bad = false
fun reach(expected: int): bool {
    step = step + 1
    if (step != expected) bad = true
    fail != step
}
fun peripheralDelayMilliseconds(duration: int): void { if (duration != 5 || !reach(1)) bad = true; return }
fun cores3ConfigurePmic(power: Axp2101): bool = reach(2)
fun cores3ConfigureExpander(expander: Aw9523, request: bool): bool { if (!request) bad = true; reach(3) }
fun M5BoardId.configureCoreS3SpiPins(gate: PeripheralGate, owner: u32): SpiTransactionResult = SpiTransactionResult(if (reach(4)) 1 else 2)
fun M5BoardId.prepareCoreS3SdSpi(gate: PeripheralGate, owner: u32): SpiTransactionResult = SpiTransactionResult(if (reach(5)) 1 else 4)
fun M5BoardId.configureCoreS3HardwareSpi(gate: PeripheralGate, owner: u32): SpiTransactionResult = SpiTransactionResult(if (reach(6)) 1 else 6)
fun cores3DisplayReset(expander: Aw9523): bool = reach(7)
fun cores3DetectPanel(touch: Ft5x06): int = if (reach(8)) revision else -1
fun M5BoardId.beginCoreS3SpiDisplay(gate: PeripheralGate, owner: u32, panel: int): SpiTransactionResult {
    if (panel != revision) bad = true
    SpiTransactionResult(if (reach(9)) 1 else 6)
}
fun cores3DisplaySetBrightness(power: Axp2101, brightness: int): bool {
    if (brightness == 0) { cleanupCalls = cleanupCalls + 1; return !cleanFails }
    if (brightness != 100) bad = true
    reach(11)
}
fun M5BoardId.clearCoreS3SpiDisplay(gate: PeripheralGate, owner: u32): SpiTransactionResult = SpiTransactionResult(if (reach(10)) 1 else 4)
fun run(): CoreS3DisplayInitResult = M5BoardId(10).initializeCoreS3HardwareDisplay(Axp2101(1), Aw9523(2), Ft5x06(3), PeripheralGate(4), u32(7), true, 100)
fun main(): int {
    while (revision <= 2) {
        step = 0
        val result = run()
        if (!result.valid() || result.panel() != revision || step != 11 || cleanupCalls != 0 || bad) return 1
        revision = revision + 1
    }
    revision = 1
    fail = 2
    while (fail <= 11) {
        var cleanup = 0
        while (cleanup < 2) {
            step = 0
            cleanupCalls = 0
            cleanFails = cleanup == 1
            val result = run()
            if (result.valid() || result.status() != (if (fail == 6) 12 else if (fail > 6) fail else fail + 1) || step != fail || cleanupCalls != 1 || result.cleanup() != cleanup + 1 || bad) return 2
            val detail = if (fail == 4) 2 else if (fail == 5 || fail == 10) 4 else if (fail == 8) -1 else if (fail == 6 || fail == 9) 6 else 0
            if (result.detail() != detail) return 3
            cleanup = cleanup + 1
        }
        fail = fail + 1
    }
    step = 0
    cleanupCalls = 0
    if (M5BoardId(0).initializeCoreS3HardwareDisplay(Axp2101(1), Aw9523(2), Ft5x06(3), PeripheralGate(4), u32(7), true, 100).status() != 2 || step != 0 || cleanupCalls != 0) return 4
    if (M5BoardId(10).initializeCoreS3HardwareDisplay(Axp2101(1), Aw9523(2), Ft5x06(3), PeripheralGate(4), u32(7), true, 256).status() != 2 || step != 0 || cleanupCalls != 0) return 5
    if (M5BoardId(10).initializeCoreS3HardwareDisplay(Axp2101(1), Aw9523(2), Ft5x06(3), PeripheralGate(0), u32(7), true, 100).status() != 2 || step != 0 || cleanupCalls != 0) return 6
    fail = 0
    revision = 0
    cleanFails = false
    val unknown = run()
    if (unknown.status() != 8 || unknown.detail() != 0 || step != 8 || cleanupCalls != 1 || bad) return 7
    0
}
