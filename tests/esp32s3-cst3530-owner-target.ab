import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/touch/cst3530_owner.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_cst3530_owner_target")
trusted fun target(bus: I2cBus,owner: Cst3530Owner,snapshot: NativeBuffer,operation: int): int =
    if (operation == 0) openCst3530(bus) | 0 else if (operation == 1) owner.readFrame(snapshot) else
    if (operation == 2) owner.wake() | 0 else owner.close() | 0
