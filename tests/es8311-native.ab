import "../src/audio/es8311_device.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type I2cDevice = int
fun I2cBus.valid(): bool = this == 1
fun I2cBus.device(address: int, frequency: int): I2cDevice =
    I2cDevice(if (address == 24 && frequency == 100000) 2 else 0)
fun I2cDevice.close(): bool = this == 2
val expectedRegisters = nativeStaticU32s([0,1,2,13,14,20,23,28,13,14,0])
val expectedValues = nativeStaticU32s([128,186,24,1,2,16,255,106,252,106,0])
var volume=255
var calls = 0
var failAt = 0
var offset = 0
var bad = false
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool {
    val index = offset + calls
    if (this != 2 || index >= 11) { bad = true; return false }
    if (register != nativeAddressLoadU32(expectedRegisters,index*4) || value != (if (index == 6) volume else nativeAddressLoadU32(expectedValues,index*4))) bad = true
    calls = calls + 1
    calls != failAt
}
trusted fun es8311Test(): int {
    val codec = es8311(I2cBus(1))
    if (!codec.valid() || es8311(I2cBus(0)).valid() || !codec.close()) return 1
    volume=0
    while (volume <= 255) {
    var mode = 0
    while (mode < 2) {
        val enabled = mode == 0
        offset = if (enabled) 0 else 8
        val count = if (enabled) 8 else 3
        failAt = 0
        while (failAt <= count) {
            calls = 0
            val result = codec.microphoneBclkOwned(enabled,true,volume)
            if (bad || result != (if (failAt == 0) 1 else failAt+2)) return 2
            if (calls != (if (failAt == 0) count else failAt)) return 3
            failAt = failAt + 1
        }
        calls = 0
        if (codec.microphoneBclkOwned(enabled,false) != 2 || Es8311(0).microphoneBclkOwned(enabled,true) != 2 || calls != 0) return 4
        mode = mode + 1
    }
    volume=volume+1
    }
    calls=0
    if (codec.microphoneBclkOwned(true,true,-1) != 2 || codec.microphoneBclkOwned(true,true,256) != 2 || calls != 0) return 5
    0
}
#exportFunction("es8311Test","abla_es8311_test")
