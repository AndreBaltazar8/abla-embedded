import "../src/display/it8951_read_rect.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(256)
var selected=false
var index=0
var preamble=0
var command=0
var address=0
var count=0
var calls=0
var failure=0
var bad=false
fun it8951TransportValid(context: int): bool = context == 7
fun it8951TransportSelect(context: int,active: bool): bool {
    if (context != 7 || (active && selected)) bad=true
    selected=active;if (active) index=0;return true
}
fun it8951TransportReady(context: int): int = if (context == 7) 1 else -1
fun it8951TransportDelay(context: int,us: int): void { bad=true;return }
fun rawByte(offset: int): int = (offset*13)&240
fun it8951TransportExchange(context: int,word: int): int {
    calls=calls+1
    if (context != 7 || !selected) bad=true
    if (calls == failure) return -1
    if (index == 0) preamble=word
    if (preamble == 24576 && index == 1) {
        command=word;if (word != 18 && word != 19) bad=true
    }
    if (preamble == 0 && command == 18) {
        if (index == 1) address=word
        if (index == 2) address=address|(word<<16)
        if (index == 3) count=word
        if (index == 4 && word != 0) bad=true
    }
    var value=0
    if (preamble == 4096 && index >= 2) {
        val offset=address-4096+(index-2)*2
        if (command != 19 || address < 4096 || (address&3) != 0 ||
            address+count*2 > 4160 || index-2 >= count || count%16 != 0) bad=true
        value=rawByte(offset)|(rawByte(offset+1)<<8)
    }
    index=index+1;return value
}
@export("abla_it8951_read_rect_test")
trusted fun testRect(): i32 {
    val session=it8951SessionAt(nativeBufferAt(memory,40))
    val output=nativeBufferAt(memory+40,64)
    val expected=nativeBufferAt(memory+104,64)
    val line=nativeBufferAt(memory+168,64)
    val args=nativeBufferAt(memory+232,8)
    if (!session.initialize()) return i32(1)
    session.buffer().storeU32(8,7);session.buffer().storeU32(16,8|(8<<16));session.buffer().storeU32(20,4096)
    var rotation=0
    while (rotation < 8) {
        var mode=0
        while (mode < 4) {
            var corner=0
            while (corner < 2) {
                val x=if (corner == 0) 0 else 5;val y=if (corner == 0) 0 else 6
                val pixelBytes=if (mode < 2) 3 else 2
                val stride=3*pixelBytes+2
                val physicalRows=if (rotation%2 == 0) 2 else 3
                failure=0
                while (failure <= physicalRows*27) {
                    var at=0
                    while (at < 64) { output.store(at,165);expected.store(at,165);at=at+1 }
                    session.buffer().storeU32(4,1);calls=0;bad=false;selected=false
                    val result=session.readRectOwned(x,y,3,2,rotation,output,stride,line,args,mode >= 2,mode%2 == 1,3,true)
                    val published=if (failure == 0) physicalRows else (failure-1)/27
                    if (result.status() != (if (failure == 0) 1 else 4) || result.rows() != published ||
                        session.state() != (if (failure == 0) 1 else 2) || bad || selected ||
                        calls != (if (failure == 0) physicalRows*27 else failure)) return i32(2)
                    val first=epdCanvasPosition(8,8,x,y,rotation)
                    val last=epdCanvasPosition(8,8,x+2,y+1,rotation)
                    val top=if ((first>>>16) < (last>>>16)) first>>>16 else last>>>16
                    var dy=0
                    while (dy < 2) {
                        var dx=0
                        while (dx < 3) {
                            val p=epdCanvasPosition(8,8,x+dx,y+dy,rotation)
                            if ((p>>>16)-top < published) {
                                val raw=rawByte((p>>>16)*8+(p&65535))
                                val gray=if (mode%2 == 1) 255-(8+raw) else 8+raw
                                val target=dy*stride+dx*pixelBytes
                                if (mode < 2) { expected.store(target,gray);expected.store(target+1,gray);expected.store(target+2,gray) }
                                else { val color=rgb565(gray,gray,gray);expected.store(target,(color&65535)>>>8);expected.store(target+1,color&255) }
                            }
                            dx=dx+1
                        }
                        dy=dy+1
                    }
                    at=0
                    while (at < 64) { if (output.load(at) != expected.load(at)) return i32(3);at=at+1 }
                    failure=failure+1
                }
                corner=corner+1
            }
            mode=mode+1
        }
        rotation=rotation+1
    }
    session.buffer().storeU32(4,1);calls=0;failure=0
    if (session.readRectOwned(0,0,3,2,0,output,11,output,args,false,false,3,true).status() != 2 ||
        session.readRectOwned(0,0,3,2,0,output,11,line,session.buffer(),false,false,3,true).status() != 2 ||
        session.readRectOwned(7,7,3,2,0,output,11,line,args,false,false,3,true).status() != 2 ||
        session.readRectOwned(0,0,3,2,0,output,11,line,args,false,false,3,false).status() != 2 || calls != 0) return i32(4)
    i32(0)
}
