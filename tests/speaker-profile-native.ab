import "../src/m5stack/speaker_profile.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
// Independent transcription: id,mode,data,WS,BCLK,MCLK,port,stereo,gain,Hz,callback.
val rows=nativeStaticU32s([
    1,2,25,-1,-1,-1,0,0,8,96000,0,
    2,1,2,0,12,-1,1,0,16,48000,1,
    4,3,2,-1,-1,-1,1,0,48,48000,0,
    5,3,2,-1,-1,-1,1,0,48,48000,0,
    6,3,2,-1,-1,-1,1,0,48,48000,0,
    8,1,2,0,12,-1,1,0,24,48000,1,
    10,1,13,33,34,-1,1,0,4,48000,1,
    12,3,3,-1,-1,-1,1,0,48,48000,0,
    13,3,3,-1,-1,-1,1,0,48,48000,0,
    14,1,42,43,41,-1,1,0,16,48000,0,
    15,3,9,-1,-1,-1,1,0,48,48000,0,
    16,3,14,-1,-1,-1,1,0,48,48000,0,
    17,1,13,33,34,-1,1,0,4,48000,1,
    19,3,21,-1,-1,-1,1,0,48,48000,0,
    21,3,44,-1,-1,-1,1,0,48,48000,0,
    22,1,26,29,27,30,0,0,4,48000,1,
    23,3,11,-1,-1,-1,0,0,48,48000,0,
    24,1,42,43,41,-1,1,0,16,48000,1,
    25,3,11,-1,-1,-1,0,0,48,48000,0,
    26,1,14,15,17,18,0,1,1,22050,1,
    27,1,13,33,34,-1,1,0,4,48000,1,
    28,1,38,41,40,42,0,1,1,44100,1,
    29,3,42,-1,-1,-1,1,0,48,48000,0,
    30,1,21,15,17,18,0,1,4,44100,1,
    31,1,3,4,6,2,0,0,4,24000,1,
    32,1,42,41,38,40,0,1,1,44100,1,
    35,1,26,29,27,30,0,0,4,48000,1,
    139,3,2,-1,-1,-1,1,0,48,48000,0,
    142,1,22,33,19,-1,1,0,12,48000,0,
    145,1,48,3,17,-1,1,0,1,48000,1
])
trusted fun expected(row: int,column: int): int {
    val value=nativeAddressLoadU32(rows,(row*11+column)*4)
    return if (value == 4294967295) -1 else value
}
@export("abla_speaker_profile_test")
trusted fun test(): i32 {
    var row=0
    while (row < 30) {
        val board=M5BoardId(expected(row,0));val p=board.speakerProfile()
        if (!p.available() || p.transport() != expected(row,1) || p.dataPin() != expected(row,2) ||
            p.wordSelectPin() != expected(row,3) || p.bitClockPin() != expected(row,4) || p.masterClockPin() != expected(row,5) ||
            p.port() != expected(row,6) || p.stereo() != (expected(row,7) != 0) || p.gain() != expected(row,8) ||
            p.sampleRate() != expected(row,9) || board.speakerNeedsEnableSequence() != (expected(row,10) != 0) || p.dacZeroLevel() != 0) return i32(1)
        row=row+1
    }
    var id=0;var total=0
    while (id < 1024) {
        if (M5BoardId(id).speakerProfile().available()) total=total+1
        id=id+1
    }
    if (total != 30 || m5BoardStickC.speakerProfile().available()) return i32(2)
    val maximum=m5SpeakerProfile(3,62,62,62,62,1,true,255,131071,255)
    if (maximum.transport() != 3 || maximum.dataPin() != 62 || maximum.wordSelectPin() != 62 ||
        maximum.bitClockPin() != 62 || maximum.masterClockPin() != 62 || maximum.port() != 1 || !maximum.stereo() ||
        maximum.gain() != 255 || maximum.sampleRate() != 131071 || maximum.dacZeroLevel() != 255) return i32(3)
    if (m5SpeakerProfile(0,1).available() || m5SpeakerProfile(4,1).available() || m5SpeakerProfile(1,63).available() ||
        m5SpeakerProfile(1,-1).available() || m5SpeakerProfile(1,1,63).available() || m5SpeakerProfile(1,1,-2).available() ||
        m5SpeakerProfile(1,1,-1,63).available() || m5SpeakerProfile(1,1,-1,-1,63).available() ||
        m5SpeakerProfile(1,1,-1,-1,-1,2).available() || m5SpeakerProfile(1,1,-1,-1,-1,1,false,256).available() ||
        m5SpeakerProfile(1,1,-1,-1,-1,1,false,1,0).available() || m5SpeakerProfile(1,1,-1,-1,-1,1,false,1,131072).available() ||
        m5SpeakerProfile(1,1,-1,-1,-1,1,false,1,48000,256).available()) return i32(4)
    return i32(0)
}
