import "../src/esp32/adc1_config_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var r0=0
var r8=0
var r12=0
var r16=0
var r44=0
var r52=0
var r84=0
var r88=0
var hall=0
var busy=false
var writes=0
var drop=0
var bad=false
fun esp32Adc1Read(offset: int): int {
    if (offset == 0) return r0
    if (offset == 8) return r8
    if (offset == 12) return r12
    if (offset == 16) return r16
    if (offset == 44) return r44
    if (offset == 52) return r52
    if (offset == 60) return if (busy) 0x400000 else 0
    if (offset == 84) return r84
    if (offset == 88) return r88
    bad=true; return 0
}
fun esp32Adc1Write(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0) r0=value else if (offset == 8) r8=value else if (offset == 12) r12=value else if (offset == 16) r16=value else if (offset == 44) r44=value else if (offset == 52) r52=value else if (offset == 84) r84=value else if (offset == 88) r88=value else bad=true
    return
}
fun esp32Adc1HallRead(): int = hall
fun esp32Adc1HallWrite(value: int): void { writes=writes+1; if (writes != drop) hall=value; return }
fun fresh(): void {
    r0=0x40000202; r8=0x11112222; r12=0x70001111; r16=0xf111fff1
    r44=0x90000000; r52=0xa0000000; r84=0x10000; r88=0x80000001; hall=0xc0000001
    busy=false; writes=0; drop=0; bad=false; return
}
@export("abla_adc1_config_test")
fun configTest(): i32 {
    var channel=0
    while (channel < 8) {
        var width=9
        while (width <= 12) {
            var atten=0
            while (atten < 4) {
                fresh()
                if (esp32Adc1ConfigureOwned(channel,width,atten,3) != 1 || !esp32Adc1Prepared() || writes != 9 || bad) return i32(1)
                if (r0 != (0x50000201|((width-9)<<16)) || r8 != 65537 || r12 != 0x70020001 || r16 != 0xf1110001 || r44 != (0x90000000|width-9) || r52 != (0xa0000000|(atten<<(channel*2))) || r88 != 0x8c000001 || hall != 0x40000001) return i32(2)
                atten=atten+1
            }
            width=width+1
        }
        channel=channel+1
    }
    var stage=1
    while (stage <= 9) {
        fresh(); drop=stage
        if (esp32Adc1ConfigureOwned(7,12,3,3) != (stage<<8|5) || writes != stage || bad) return i32(3)
        stage=stage+1
    }
    fresh(); busy=true
    if (esp32Adc1ConfigureOwned(0,12,3,3) != 4 || writes != 0) return i32(4)
    busy=false; r0=r0|0x8000000
    if (esp32Adc1ConfigureOwned(0,12,3,3) != 3 || writes != 0) return i32(5)
    fresh(); r84=0x20000
    if (esp32Adc1ConfigureOwned(0,12,3,3) != 4 || writes != 0 || esp32Adc1ConfigureOwned(8,12,3,3) != 2) return i32(6)
    return i32(0)
}
