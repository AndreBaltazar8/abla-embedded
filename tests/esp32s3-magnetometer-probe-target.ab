import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/imu_delay_1khz_esp32s3.ab"
import "../src/m5stack/magnetometer_probe.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_magnetometer_probe_target")
trusted fun probeTarget(state: M5Magnetometers,bus: I2cBus,snapshot: ImuSnapshot,scratch: NativeBuffer,micros: int,mode: int): int {
    if (mode == 0) return state.probe(bus)
    if (mode == 1) return if (state.releaseAll()) 0 else -1
    state.updateSnapshot(snapshot,scratch,micros)
}
