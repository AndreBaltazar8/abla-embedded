import "../src/esp32/watchdog/lp_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(64)
var writes=0
var drop=0
var delay=0
var commands=0
fun p4LpWatchdogRead(offset: int): int = nativeBufferAt(memory,64).loadU32(offset)
fun p4LpWatchdogDelay(): int = delay
fun p4LpWatchdogWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 24) { nativeBufferAt(memory,64).storeU32(offset,value); return }
    if (p4LpWatchdogRead(24) != 0x50d83aa1) return
    if (offset == 20) { if (value == 0x80000000) commands=commands|1; return }
    if (offset == 48) { if (value == 1) commands=commands|2; return }
    nativeBufferAt(memory,64).storeU32(offset,value)
    return
}
fun resetWatchdog(config: int): void {
    var offset=0
    while (offset < 64) { nativeBufferAt(memory,64).storeU32(offset,0); offset=offset+4 }
    nativeBufferAt(memory,64).storeU32(0,config)
    writes=0; drop=0; commands=0; return
}
@export("abla_p4_lp_watchdog_test")
trusted fun watchdogTest(): i32 {
    delay=0
    while (delay < 4) {
        val multiplier=1<<(delay+1)
        if (p4LpWatchdogHold(0,multiplier,delay) != 1 || p4LpWatchdogHold(0,4294967295*multiplier,delay) != 4294967295 ||
            p4LpWatchdogHold(0,4294967296*multiplier,delay) != -1 || p4LpWatchdogHold(0,multiplier+1,delay) != -1) return i32(1)
        var stage=0
        while (stage < 4) {
            var action=0
            while (action < 5) {
                resetWatchdog(0x0007efff&0xffffefff)
                val prior=p4LpWatchdogState()
                val ticks=if (stage == 0) multiplier*123 else 123
                if (p4LpWatchdogConfigureStageOwned(stage,ticks,action) != 1 || p4LpWatchdogRead(4+4*stage) != 123 ||
                    p4LpWatchdogState() != ((prior& (4294967295^(7<<(28-stage*3))))|(action<<(28-stage*3))) || p4LpWatchdogRead(24) != 0) return i32(2)
                action=action+1
            }
            stage=stage+1
        }
        delay=delay+1
    }
    delay=0
    var failed=1
    while (failed <= 4) {
        resetWatchdog(0); drop=failed
        val result=p4LpWatchdogConfigureStageOwned(0,20,3)
        if (result != (if (failed == 4) 257 else 5)) return i32(3)
        if (failed < 4 && p4LpWatchdogRead(24) != 0) return i32(4)
        failed=failed+1
    }
    var profile=0
    while (profile < 4) {
        val bits=(if ((profile&1) != 0) 0x80000000 else 0)|(if ((profile&2) != 0) 4096 else 0)
        resetWatchdog(bits|0x12340200)
        if (profile != 0 && (p4LpWatchdogConfigureStageOwned(0,20,1) != 3 || writes != 0 || !p4LpWatchdogRunning())) return i32(5)
        if (p4LpWatchdogEnableOwned(false,false) != 1 || p4LpWatchdogState() != 0x12340200 || p4LpWatchdogRunning()) return i32(6)
        if (p4LpWatchdogEnableOwned((profile&1) != 0,(profile&2) != 0) != 1 || p4LpWatchdogState() != (bits|0x12340200)) return i32(7)
        profile=profile+1
    }
    resetWatchdog(0)
    if (p4LpWatchdogConfigureStageOwned(-1,20,1) != 2 || p4LpWatchdogConfigureStageOwned(4,20,1) != 2 ||
        p4LpWatchdogConfigureStageOwned(0,3,1) != 2 || p4LpWatchdogConfigureStageOwned(1,4294967296,1) != 2 ||
        p4LpWatchdogConfigureStageOwned(1,20,5) != 2 || writes != 0) return i32(8)
    nativeBufferAt(memory,64).storeU32(24,0x50d83aa1)
    if (p4LpWatchdogFeedOwned() != 4 || writes != 0 || commands != 0) return i32(9)
    resetWatchdog(0)
    if (p4LpWatchdogFeedOwned() != 1 || commands != 1 || p4LpWatchdogState() != 0 || p4LpWatchdogRead(24) != 0) return i32(10)
    nativeBufferAt(memory,64).storeU32(44,2)
    nativeBufferAt(memory,64).storeU32(40,3)
    if (p4LpWatchdogInterruptEnabledOwned(true) != 1 || p4LpWatchdogRead(44) != 3 || !p4LpWatchdogInterruptPending() ||
        p4LpWatchdogInterruptAcknowledgeOwned() != 1 || commands != 3 || p4LpWatchdogInterruptEnabledOwned(false) != 1 || p4LpWatchdogRead(44) != 2) return i32(11)
    failed=1
    while (failed <= 3) {
        resetWatchdog(0); drop=failed
        if (p4LpWatchdogEnableOwned(true,true) != (if (failed == 3) 257 else 5)) return i32(13)
        resetWatchdog(0); drop=failed
        if (p4LpWatchdogResetPolicyOwned(true,true,true,7,7) != (if (failed == 3) 257 else 5)) return i32(14)
        resetWatchdog(0); drop=failed
        if (p4LpWatchdogInterruptEnabledOwned(true) != (if (failed == 3) 257 else 5)) return i32(15)
        failed=failed+1
    }
    resetWatchdog(4096)
    if (p4LpWatchdogResetPolicyOwned(true,true,true,0,0) != 3 || writes != 0) return i32(16)
    resetWatchdog(0)
    if (p4LpWatchdogResetPolicyOwned(true,true,true,-1,0) != 2 || p4LpWatchdogResetPolicyOwned(true,true,true,0,8) != 2 || writes != 0) return i32(17)
    var cpu=0
    while (cpu < 8) {
        var system=0
        while (system < 8) {
            var flags=0
            while (flags < 8) {
                resetWatchdog(0x765400ff)
                val policy=(if ((flags&1) != 0) 2048 else 0)|(if ((flags&2) != 0) 1024 else 0)|(if ((flags&4) != 0) 512 else 0)
                if (p4LpWatchdogResetPolicyOwned((flags&1) != 0,(flags&2) != 0,(flags&4) != 0,cpu,system) != 1 || p4LpWatchdogState() != ((0x765400ff&0xfff811ff)|(cpu<<16)|(system<<13)|policy)) return i32(12)
                flags=flags+1
            }
            system=system+1
        }
        cpu=cpu+1
    }
    return i32(0)
}
