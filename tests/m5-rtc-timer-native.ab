import "../src/m5stack/rtc_timer_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var bad=false
var status=1
var failMask=0
var duration=0
fun m5RtcCleanupRtcValid(rtc: int): bool = rtc == 1 || rtc == 3
fun m5RtcCleanupPmicValid(pmic: int): bool = pmic == 2
fun m5RtcTimerSupported(rtc: int): bool = rtc == 1
fun m5RtcConfigureTimer(rtc: int,milliseconds: int): RtcTimerResult {
    if (rtc != 1 || milliseconds != duration || calls != 0) bad=true
    calls=calls+1; RtcTimerResult(status | ((if (status == 1) duration else 0)<<8))
}
fun m5RtcCleanupRtc(rtc: int,disable: bool): bool { bad=true; false }
fun m5RtcCleanupWake(pmic: int): bool {
    if (pmic != 2 || calls != 1) bad=true
    calls=calls+1; (failMask & 1) == 0
}
fun m5RtcCleanupPmicIrq(pmic: int): bool {
    if (pmic != 2 || calls != 2) bad=true
    calls=calls+1; (failMask & 2) == 0
}
@export("abla_m5_rtc_timer_test")
fun timerTest(): i32 {
    var boardIndex=0
    while (boardIndex < 3) {
        val board=if (boardIndex == 0) m5BoardPaperMono else if (boardIndex == 1) m5BoardToughC5 else m5BoardStackCore2
        status=1
        while (status <= 5) {
            failMask=0
            while (failMask < 4) {
                var variant=0
                while (variant < 4) {
                    duration=if (variant == 0) 0 else if (variant == 1) 1000 else if (variant == 2) 65535000 else 3932100000
                    calls=0; bad=false
                    val result=m5RtcBoardTimerOwned(board,1,if (boardIndex == 2) 0 else 2,duration)
                    val completed=(if (status == 1) 1 else 0) | (if (boardIndex == 2) 0 else ((~failMask & 3)<<1))
                    if (result.timer().status() != status || result.timer().milliseconds() != (if (status == 1) duration else 0) ||
                        !result.cleanup().valid() || result.cleanup().completed() != completed ||
                        result.success() != (status == 1 && (boardIndex == 2 || failMask == 0)) ||
                        calls != (if (boardIndex == 2) 1 else 3) || bad) return i32(1)
                    variant=variant+1
                }
                failMask=failMask+1
            }
            status=status+1
        }
        boardIndex=boardIndex+1
    }
    calls=0
    if (m5RtcBoardTimerOwned(m5BoardPaperMono,0,2,1000).timer().status() != 2 ||
        m5RtcBoardTimerOwned(m5BoardPaperMono,1,0,1000).timer().status() != 2 ||
        m5RtcBoardTimerOwned(m5BoardStackCore2,3,0,1000).timer().status() != 6 || calls != 0) return i32(2)
    i32(0)
}
