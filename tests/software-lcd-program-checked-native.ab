import "../src/display/software_program_checked.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val bytes = nativeStaticBytes("\x01\x80\x05\x11\x81\xa5\xff\xff\xff")
var selected = false
var dataMode = true
var outputHigh = false
var bits = 0
var accumulated = 0
var delays = 0
var activity = 0
var bad = false
trusted fun Pin.write(high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) dataMode = high
    if (this == 3) {
        if (!high && (selected || dataMode)) bad = true
        if (high && (!selected || (bits != 8 && bits != 24))) bad = true
        selected = !high
    }
    if (this == 1 && selected && high) {
        accumulated = (accumulated << 1) | (if (outputHigh) 1 else 0)
        if (dataMode != (bits >= 16)) bad = true
        bits = bits + 1
    }
    return
}
var directionCalls=0
fun Pin.writeLevelOwned(high: bool): bool { bad=true;return false }
var failDirection=0
var inputMode=true
fun Pin.inputOwned(): bool {
    if (this != 4 || selected) bad=true
    directionCalls=directionCalls+1;inputMode=true
    return directionCalls != failDirection
}
trusted fun Pin.outputLevelOwned(high: bool): bool {
    if (this != 4 || selected || high) bad=true
    directionCalls=directionCalls+1;inputMode=false;dataMode=high
    return directionCalls != failDirection
}
fun Pin.read(): bool {
    bad = true
    false
}
fun peripheralDelayMicroseconds(duration: int): void {
    bad = true
    return
}
trusted fun peripheralDelayMilliseconds(duration: int): void {
    if (selected || nativeAddressLoadU32(gateStorage, 0) != 7 ||
        (delays == 0 && (duration != 5 || bits != 8)) ||
        (delays == 1 && (duration != 500 || bits != 24)) || delays > 1) bad = true
    delays = delays + 1
    return
}
@export("abla_lcd_program_checked_test")
trusted fun programNativeTest(): i32 {
    if (bytes <= 0 || bytes > 4294967286 || gateStorage <= 0 || gateStorage > 4294967292) return i32(10)
    val program = nativeBufferAt(bytes, 9)
    val gate = peripheralGateAt(gateStorage)
    val result = softwareLcdRunProgramChecked(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), program, 9, 0)
    if (!result.valid() || bad || selected || bits != 24 || accumulated != 0x0111a5 || delays != 2 ||
        nativeAddressLoadU32(gateStorage, 0) != 0) return i32(1)
    activity = 0
    if (softwareLcdRunProgramChecked(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), program, 8, 0).status() != 3 || activity != 0) return i32(2)
    if (lcdCommandBufferValid(program, 10) || lcdCommandBufferValid(program, 0) || lcdCommandBufferValid(program, -1)) return i32(3)
    var failed=0
    while (failed <= 4) {
        nativeAddressStoreU32(gateStorage,0,0)
        selected=false;dataMode=true;outputHigh=false;bits=0;accumulated=0;delays=0;bad=false
        directionCalls=0;failDirection=failed;inputMode=true
        val outcome=softwareLcdRunProgramChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),program,9,0,true)
        val expectedBits=if (failed == 1) 0 else if (failed == 2 || failed == 3) 8 else 24
        val expectedDelays=if (failed == 0) 2 else if (failed <= 2) 0 else 1
        if (outcome.valid() != (failed == 0) || bits != expectedBits || delays != expectedDelays || !inputMode || selected || bad ||
            nativeAddressLoadU32(gateStorage,0) != (if (failed == 0) 0 else 0x80000000)) return i32(4)
        if (failed != 0 && (int(outcome.value()) != (if ((failed&1) == 1) 1 else 4) || outcome.status() != 6)) return i32(5)
        failed=failed+1
    }
    i32(0)
}
