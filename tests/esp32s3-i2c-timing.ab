import "../src/esp32/i2c/timing_esp32s3.ab"

fun checkTiming(hz: u32, divider: u32, half: u32, wait: u32, timeout: u32): bool {
    val t = esp32S3I2cTiming(u32(40000000), hz)
    t.valid() && t.dividerRegister() + u32(1) == divider &&
        t.halfCycle() == half && t.waitHigh() == wait &&
        t.highPeriod() == half - wait && t.timeoutExponent() == timeout
}

trusted fun main(): int {
    if (!checkTiming(u32(100000), u32(1), u32(200), u32(98), u32(12))) return 1
    if (!checkTiming(u32(400000), u32(1), u32(50), u32(23), u32(10))) return 2
    if (!checkTiming(u32(1000000), u32(1), u32(20), u32(8), u32(9))) return 3
    if (!checkTiming(u32(10000), u32(4), u32(500), u32(125), u32(14))) return 4
    if (!checkTiming(u32(79999), u32(1), u32(250), u32(62), u32(13))) return 11
    if (!checkTiming(u32(80000), u32(1), u32(250), u32(123), u32(13))) return 12
    if (esp32S3I2cTiming(u32(0), u32(100000)).valid()) return 5
    if (esp32S3I2cTiming(u32(40000000), u32(0)).valid()) return 6
    if (esp32S3I2cTiming(u32(40000000), u32(1)).valid()) return 7
    if (esp32S3I2cTiming(u32(40000000), u32(4294967295)).valid()) return 8
    val invalid = esp32S3I2cTiming(u32(0), u32(0))
    // Invalid configurations must reject before any MMIO, even on the host.
    if (esp32S3I2cConfigureTiming(0, invalid)) return 9
    if (esp32S3I2cConfigureTiming(0, Esp32S3I2cTiming(u32(16777216)))) return 13
    if (esp32S3I2cConfigureTiming(0, Esp32S3I2cTiming(u32(4294967295)))) return 14
    val valid = esp32S3I2cTiming(u32(40000000), u32(100000))
    if (esp32S3I2cConfigureTiming(-1, valid) || esp32S3I2cConfigureTiming(2, valid)) return 10
    0
}
