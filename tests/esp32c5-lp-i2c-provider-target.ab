import "../src/esp32/i2c_lp_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_lp_i2c_provider_target")
trusted fun providerTarget(source: int,sourceHz: u32,cpuHz: u32,address: int,register: int,value: int): int {
    val bus=i2cMaster(0,2,3,sourceHz,cpuHz,source)
    if (!bus.valid()) return if (esp32C5LpI2cAbortSetup()) -1 else -2
    if (bus.prepareProbeStatus() != 1 || !bus.probe(address)) {
        val recovered=bus.recoverStatus()
        val closedBus=bus.close()
        return if (closedBus) -recovered else -99
    }
    val device=bus.device(address)
    if (!device.valid()) return if (bus.close()) 0 else -99
    val written=device.writeRegister16LittleEndian(register,value)
    val read=device.readRegister16BigEndianChecked(register)
    val closed=device.close()
    val busClosed=bus.close()
    if (written && closed && busClosed && read.valid()) read.value()+1 else 0
}
