import "../src/esp32/adc2_config_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var control=0xe7ff00fe
var mux=0x300000aa
var sample=0
var atten=0xaaaa5555
var arbiter=0x1910
var writes=0
var reads=0
var drop=0
var bad=false
fun esp32S3Adc2ArbiterRead(): int { reads=reads+1; return arbiter }
fun esp32S3Adc2Read(offset: int): int {
    reads=reads+1
    if (offset == 36) return control
    if (offset == 52) return mux
    if (offset == 48) return sample
    if (offset == 56) return atten
    bad=true; return 0
}
fun esp32S3Adc2Write(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 36) control=value
    else if (offset == 52) mux=value
    else if (offset == 48) sample=value
    else if (offset == 56) atten=value
    else bad=true
    return
}
fun reset(): void { control=0xe7ff00fe; mux=0x300000aa; sample=0; atten=0xaaaa5555; arbiter=0x1910; writes=0; reads=0; drop=0; return }
@export("abla_adc2_config_s3_test")
fun test(): i32 {
    var channel=0
    while (channel < 10) {
        var attenuation=0
        while (attenuation < 4) {
            reset()
            val expected=(atten&(4294967295^(3<<(channel*2))))|(attenuation<<(channel*2))
            if (esp32S3Adc2ConfigureOwned(channel,attenuation) != 1 || writes != 4 || !esp32S3Adc2Prepared()) return i32(1)
            if (control != 0x87ff0001 || mux != 0x400000aa || atten != expected || sample != 0x80040000 || arbiter != 0x1910 || bad) return i32(2)
            attenuation=attenuation+1
        }
        channel=channel+1
    }
    var stage=1
    while (stage <= 4) {
        reset(); drop=stage
        if (esp32S3Adc2ConfigureOwned(3,0) != ((stage<<8)|5) || writes != stage) return i32(3)
        drop=0
        if (esp32S3Adc2ConfigureOwned(3,0) != 1) return i32(4)
        stage=stage+1
    }
    reset(); sample=0x800c0000
    if (esp32S3Adc2ConfigureOwned(3,0) != 3 || writes != 0) return i32(5)
    reset(); sample=0x80060000
    if (esp32S3Adc2ConfigureOwned(3,0) != 4 || writes != 0) return i32(6)
    reset(); mux=mux|0x80000000
    if (esp32S3Adc2ConfigureOwned(3,0) != 3 || writes != 0) return i32(7)
    reset(); arbiter=0x1930
    if (esp32S3Adc2ConfigureOwned(3,0) != 3 || writes != 0) return i32(8)
    arbiter=0x1928
    if (esp32S3Adc2ConfigureOwned(3,0) != 1) return i32(9)
    reset()
    if (esp32S3Adc2ConfigureOwned(10,0) != 2 || esp32S3Adc2ConfigureOwned(0,4) != 2 || reads != 0 || writes != 0 || bad) return i32(10)
    return i32(0)
}
