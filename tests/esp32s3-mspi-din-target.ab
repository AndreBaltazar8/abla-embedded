import "../src/esp32/mspi_din_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_mspi_din_target")
@section(".iram1.abla.s3MspiDinTarget")
trusted fun dinTarget(ram: bool,mode: int,cycles: int): bool {
    val original=esp32S3MspiDinCaptureOwned(ram)
    val result=esp32S3MspiDinSetOwned(ram,mode,cycles)
    original.restoreOwned(ram)
    result
}
