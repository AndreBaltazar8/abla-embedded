import "../src/storage/fat_long_name_encode.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(2048)
val aliasBytes=nativeStaticBytes("LONGNA~1TXT")
@export("abla_fat_long_name_encode_test")
trusted fun test(): i32 {
    val name=nativeBufferAt(memory,512);val output=nativeBufferAt(memory+512,640)
    val assembly=nativeBufferAt(memory+1152,520);val shortEntry=nativeBufferAt(memory+1680,32)
    val alias=nativeBufferAt(aliasBytes,11)
    var i=0
    while (i < 32) { shortEntry.store(i,0);i=i+1 }
    i=0
    while (i < 11) { shortEntry.store(i,alias.load(i));i=i+1 }
    shortEntry.store(11,32)
    var length=1
    while (length <= 255) {
        i=0
        while (i < length) { name.storeU16(i*2,65+(i%26));i=i+1 }
        if (length >= 14) { name.storeU16(24,0xd83d);name.storeU16(26,0xde00) }
        i=0
        while (i < 640) { output.store(i,42);i=i+1 }
        val count=fatLongNameEncodeEntries(name,length,alias,output)
        if (count != (length+12)/13) return i32(1)
        var state=FatLongName(0);var slot=0
        while (slot < count) {
            val entry=nativeBufferAt(output.addressValue()+slot*32,32)
            if (entry.load(0) != (count-slot|(if (slot == 0) 64 else 0)) || entry.load(11) != 15 ||
                entry.load(12) != 0 || entry.loadU16(26) != 0) return i32(2)
            state=state.consume(entry,assembly);slot=slot+1
        }
        if (!state.matches(shortEntry,assembly) || state.length() != length) return i32(3)
        i=0
        while (i < length) { if (name.loadU16(i*2) != assembly.loadU16(i*2)) return i32(4);i=i+1 }
        i=count*32
        while (i < 640) { if (output.load(i) != 42) return i32(5);i=i+1 }
        // Alias checksum corruption must prevent attachment.
        shortEntry.store(0,88)
        if (state.matches(shortEntry,assembly)) return i32(6)
        shortEntry.store(0,alias.load(0));length=length+1
    }
    var invalid=0
    while (invalid < 42) {
        name.storeU16(0,65);name.storeU16(2,66)
        val unit=if (invalid < 32) invalid else if (invalid == 32) 34 else if (invalid == 33) 42 else if (invalid == 34) 47
            else if (invalid == 35) 58 else if (invalid == 36) 60 else if (invalid == 37) 62 else if (invalid == 38) 63
            else if (invalid == 39) 92 else if (invalid == 40) 124 else 0xd800
        name.storeU16(0,unit);output.store(0,42)
        if (fatLongNameEncodeEntries(name,2,alias,output) != 0 || output.load(0) != 42) return i32(7)
        invalid=invalid+1
    }
    name.storeU16(0,65);name.storeU16(2,32)
    if (fatLongNameEncodeEntries(name,2,alias,output) != 0) return i32(8)
    name.storeU16(2,46)
    if (fatLongNameEncodeEntries(name,2,alias,output) != 0) return i32(9)
    name.storeU16(2,66)
    if (fatLongNameEncodeEntries(name,2,alias,nativeBufferAt(output.addressValue(),31)) != 0 ||
        fatLongNameEncodeEntries(name,2,alias,name) != 0 ||
        fatLongNameEncodeEntries(name,256,alias,output) != 0 || output.load(0) != 42) return i32(10)
    return i32(0)
}
