import "../src/m5stack/tab5_dsi_owner_esp32p4.ab"
import "../src/m5stack/tab5_owned_video_esp32p4.ab"
import "../src/m5stack/tab5_video_shutdown_esp32p4.ab"
import "../src/m5stack/tab5_video_startup_esp32p4.ab"
import "../src/m5stack/tab5_detected_panel_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_tab5_owner_target")
trusted fun target(state: NativeBuffer,reference: NativeBuffer,operation: int,gate: int,table: NativeBuffer,irqLease: NativeBuffer): int {
    val owner=tab5DsiOwnerAt(state)
    if (operation == 0) return if (owner.initialize()) 1 else 0
    if (operation == 1) return owner.openOwned(reference,3,300,0,0,1,40000,1040000,0,10000,1000)
    if (operation == 2) return owner.initializePanelOwned(3,nativeBufferAt(nativeStackAllocate(32),32),10000)
    if (operation == 3) return owner.startVideoOwned(0,reference,nativeBufferAt(0x48000000,1843200),64,10000)
    if (operation == 4) return owner.stopVideoOwned(reference.addressValue(),10000)
    if (operation == 5) return owner.pollVideoOwned(reference,gate,u32(7),nativeBufferAt(0x4ff10000,64),nativeBufferAt(0x48000000,1843200),64,10000)|0
    if (operation == 6) return owner.stopVideoAndIrqOwned(reference,table,irqLease,gate,10000)
    if (operation == 7) return owner.startVideoAndIrqOwned(reference,table,irqLease,gate,0,16,3,nativeBufferAt(0x4ff10000,64),nativeBufferAt(0x48000000,1843200),64,10000)
    if (operation == 8) return owner.openDetectedPanelOwned(reference,3,table,3,300,0,0,1,40000,0,10000,1000)
    if (operation == 9) return owner.openDetectedPanelOnChipOwned(reference,3,table,0,0,1,40000,0,10000,1000)
    return owner.closeOwned(10000)
}
