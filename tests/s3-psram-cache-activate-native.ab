import "../src/esp32/psram/cache_activate_s3_sequence.ab"
import "abla/build"
val caMemory=nativeStaticAllocate(16)
var caEnabled=0
var caHold=false
var caIdle=true
var caEnables=0
var caDisables=0
var caWritebacks=0
var caBad=false
fun s3PsramCacheMappingStorageSafe(address: int,length: int): bool = address == caMemory && length == 16
fun s3PsramCacheMappingRead(address: int): int {
    if (address == 0x600c4000) return caEnabled
    if (address == 0x600c4130) return if (caIdle) 0x1001 else 0x2001
    caBad=true;return 0
}
fun s3PsramCacheMappingEnable(instruction: bool,state: int): void {
    if (instruction || state != 0) caBad=true
    caEnables=caEnables+1;if (!caHold) caEnabled=1;return
}
fun s3PsramCacheMappingWriteback(): void {
    if (caDisables != 0) caBad=true
    caWritebacks=caWritebacks+1;return
}
fun s3PsramCacheMappingDisable(instruction: bool): int {
    if (instruction || caWritebacks != 1) caBad=true
    caDisables=caDisables+1;caEnabled=0;return 0xffffffff
}
@export("abla_s3_psram_cache_activate_test")
fun testCacheActivate(): int {
    val r=nativeBufferAt(caMemory,16)
    var profile=0
    while (profile < 8) {
        val old=profile&1;val early=(profile&4) != 0
        caEnabled=old;caHold=(profile&2) != 0;caIdle=true
        caEnables=0;caDisables=0;caWritebacks=0;caBad=false;r.storeU32(0,0)
        if (s3PsramCacheActivateOwned(r,true) != (if (old == 0 && caHold) 3 else 1) || r.loadU32(8) != old) return 1
        if (!early) {
            caEnabled=1;caHold=false
            if (s3PsramCacheActivateOwned(r,true) != 1 || s3PsramCacheActivateOwned(r,true) != 1) return 2
        }
        if (s3PsramCacheDeactivateOwned(r,false) != 2 || caDisables != 0 || caWritebacks != 0) return 3
        caIdle=false
        if (s3PsramCacheDeactivateOwned(r,true) != (if (old == 0) 3 else 5)) return 4
        if (s3PsramCacheActivateOwned(r,true) != 2) return 5
        caIdle=true
        if (s3PsramCacheDeactivateOwned(r,true) != 5 || s3PsramCacheDeactivateOwned(r,true) != 5 || caEnabled != old ||
            caEnables != 1-old || caDisables != 1-old || caWritebacks != 1-old || caBad) return 6
        profile=profile+1
    }
    r.storeU32(0,0);caEnables=0
    if (s3PsramCacheActivateOwned(r,false) != 2 || r.loadU32(0) != 0 || caEnables != 0 || s3PsramCacheDeactivateOwned(r,true) != 2) return 7
    return 0
}
