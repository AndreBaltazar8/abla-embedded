import "../src/esp32/psram/pins_p4_sequence.ab"
import "../src/esp32/psram/prepare_p4_sequence.ab"
import "./p4-psram-tuning-checks.ab"
import "../src/esp32/sdk/raw_buffer.ab"
val pinMemory=nativeStaticAllocate(128)
var pinWrites=0
var pinDrop=0
var pinBad=false
fun p4PsramPinRead(offset: int): int = nativeBufferAt(pinMemory,128).loadU32(offset)
fun pinSet(offset: int,value: int): void { nativeBufferAt(pinMemory,128).storeU32(offset,value); return }
fun p4PsramPinWrite(offset: int,value: int): void {
    pinWrites=pinWrites+1
    val expected=if (pinWrites <= 20) 24+pinWrites*4 else if (pinWrites == 21) 60 else 104
    if (offset != expected || pinWrites > 22) pinBad=true
    if (pinWrites != pinDrop) pinSet(offset,value)
    return
}
fun resetPins(drive: int,dqs: bool): void {
    resetClock(1,1,7); pinWrites=0; pinDrop=0; pinBad=false
    var offset=0
    while (offset < 128) { pinSet(offset,0xffffcfff|((drive^3)<<12)); offset=offset+4 }
    pinSet(60,(p4PsramPinRead(60)&0xfffffffe)|(if (dqs) 0 else 1))
    pinSet(104,(p4PsramPinRead(104)&0xfffffffe)|(if (dqs) 0 else 1))
    return
}
fun psramPinsChecks(): int {
    var drive=0
    while (drive < 4) {
        var enabled=0
        while (enabled < 2) {
            resetPins(drive,enabled != 0)
            if (p4PsramPinsConfigureOwned(drive,enabled != 0,1) != 1 || pinWrites != 22 || pinBad) return 50
            var offset=0
            while (offset < 128) {
                var expected=0xffffcfff|((if (offset >= 28 && offset <= 104) drive else drive^3)<<12)
                if (offset == 60 || offset == 104) expected=(expected&0xfffffffe)|enabled
                if (p4PsramPinRead(offset) != expected) return 51
                offset=offset+4
            }
            enabled=enabled+1
        }
        drive=drive+1
    }
    var failure=1
    while (failure <= 22) {
        resetPins(2,true); pinDrop=failure
        if (p4PsramPinsConfigureOwned(2,true,1) != ((failure<<8)|5) || pinWrites != failure || pinBad) return 52
        failure=failure+1
    }
    resetPins(2,true); registerWrite(60,1)
    if (p4PsramPinsConfigureOwned(2,true,1) != 3 || pinWrites != 0) return 53
    registerWrite(60,0); registerWrite(4096,16)
    if (p4PsramPinsConfigureOwned(2,true,1) != 4 || pinWrites != 0) return 54
    registerWrite(4096,0); registerWrite(376,0)
    if (p4PsramPinsConfigureOwned(2,true,1) != 4 || pinWrites != 0) return 55
    resetPins(2,true); clockSet(20,0)
    if (p4PsramPinsConfigureOwned(2,true,1) != 6 || pinWrites != 0 || mappedReads != 0) return 56
    resetPins(2,true); clockSet(192,0xffffffff)
    if (p4PsramPinsConfigureOwned(2,true,1) != 6 || pinWrites != 0 || mappedReads != 0) return 57
    resetPins(2,true)
    if (p4PsramPinsConfigureOwned(-1,true,1) != 2 || p4PsramPinsConfigureOwned(4,true,1) != 2 ||
        p4PsramPinsConfigureOwned(2,true,0) != 2 || p4PsramPinsConfigureOwned(2,true,1000001) != 2 || pinWrites != 0 || mappedReads != 0) return 58
    resetPins(2,true)
    val owner=p4PsramClockOpenOwned(1,1)
    if (owner.prepareApControllerOwned(2,20,2,1) != 1 || pinWrites != 22 || writes != 6 || pinBad) return 59
    resetPins(2,true); pinDrop=22
    if (owner.prepareApControllerOwned(2,20,2,1) != ((1<<16)|(22<<8)|5) || writes != 0) return 60
    resetPins(2,true); drop=3
    if (owner.prepareApControllerOwned(2,20,2,1) != ((2<<16)|(3<<8)|5) || writes != 3 || pinWrites != 22) return 61
    resetPins(2,true)
    if (owner.prepareApControllerOwned(257,20,2,1) != 2 || pinWrites != 0 || writes != 0) return 62
    clockSet(48,p4PsramClockRead(48)^(1<<12))
    if (owner.prepareApControllerOwned(2,20,2,1) != 3 || pinWrites != 0 || writes != 0) return 63
    return psramTuningChecks()
}
