import "../src/sd/selected_read.ab"
import "abla/build"
val memory=nativeStaticAllocate(520)
var calls=0
var failAt=0
var response=0
var token=254
var corrupt=false
var argument=0
var bad=false
var delays=0
fun sdSpiSelectedAdmission(context: int,scratch: NativeBuffer,destination: NativeBuffer,bytes: int): bool = context == 123
fun sdSpiSelectedDelay(us: int): void { if (us != 1000) bad=true;delays=delays+1;return }
fun sdSpiSelectedExchange(context: int,value: int,scratch: NativeBuffer): int {
    calls=calls+1
    val index=calls-1
    val expected=if (index == 0) 81 else if (index == 5) sdSpiCommandFrameCrc(17,argument)
        else if (index < 5) (argument>>>((4-index)*8))&255 else 255
    if (value != expected || context != 123) bad=true
    if (calls == failAt) return 263
    // Sector filled with 0xff: CRC16-CCITT, initial zero, equals 0x7fa1.
    val input=if (calls == 7) response else if (calls == 10) token else
        if (calls == 523) 127 else if (calls == 524) (if (corrupt) 160 else 161) else 255
    return (1<<32)|input
}
fun resetRead(): void { calls=0;failAt=0;response=0;token=254;corrupt=false;bad=false;delays=0;return }
@export("abla_sd_selected_read_test")
trusted fun testRead(): i32 {
    val scratch=nativeBufferAt(memory,2);val destination=nativeBufferAt(memory+4,512)
    var mode=0
    while (mode < 2) {
        resetRead();argument=if (mode == 0) 1536 else 3
        val result=sdSpiReadBlockSelected(123,mode == 1,3,scratch,destination,4)
        if (!result.valid() || result.receivedBytes() != 512 || calls != 524 || delays != 2 || bad) return i32(1)
        var index=0
        while (index < 512) { if (destination.load(index) != 255) return i32(2);index=index+1 }
        mode=mode+1
    }
    var failure=1
    while (failure <= 524) {
        resetRead();argument=3;failAt=failure
        var index=0
        while (index < 512) { destination.store(index,90);index=index+1 }
        val result=sdSpiReadBlockSelected(123,true,3,scratch,destination,4)
        val prefix=if (failure <= 10) 0 else if (failure <= 523) failure-11 else 512
        if (result.status() != 4 || result.transportDetail() != 263 || result.receivedBytes() != prefix || calls != failure || bad) return i32(3)
        index=0
        while (index < 512) { if (destination.load(index) != (if (index < prefix) 255 else 90)) return i32(4);index=index+1 }
        failure=failure+1
    }
    resetRead();corrupt=true
    if (sdSpiReadBlockSelected(123,true,3,scratch,destination,4).status() != 7 || calls != 524) return i32(5)
    resetRead();response=4
    val rejected=sdSpiReadBlockSelected(123,true,3,scratch,destination,4)
    if (rejected.status() != 3 || rejected.cardDetail() != 4 || calls != 7) return i32(6)
    resetRead();token=8
    val rejectedToken=sdSpiReadBlockSelected(123,true,3,scratch,destination,4)
    if (rejectedToken.status() != 6 || rejectedToken.cardDetail() != 8 || calls != 10) return i32(7)
    resetRead()
    if (sdSpiReadBlockSelected(123,true,3,scratch,destination,2).status() != 5 || calls != 9 || delays != 1) return i32(8)
    resetRead()
    if (sdSpiReadBlockSelected(123,false,8388608,scratch,destination).status() != 2 ||
        sdSpiReadBlockSelected(123,true,4294967296,scratch,destination).status() != 2 ||
        sdSpiReadBlockSelected(123,true,3,scratch,nativeBufferAt(memory+1,512)).status() != 2 ||
        sdSpiReadBlockSelected(123,true,3,scratch,nativeBufferAt(memory+4,511)).status() != 2 ||
        sdSpiReadBlockSelected(0,true,3,scratch,destination).status() != 2 || calls != 0) return i32(9)
    return i32(0)
}
