import "../src/m5stack/tab5_board_session_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(40)
val expanderStorage=nativeStaticAllocate(32)
val scratchStorage=nativeStaticAllocate(32)
val panelStorage=nativeStaticAllocate(40)
val referenceStorage=nativeStaticAllocate(4)
var panelCalls=0
var panelBad=false
var panelCloseResult=1
var panelCloseCalls=0
fun tab5SessionPanelClose(owner: NativeBuffer,polls: int): int {
    panelCloseCalls=panelCloseCalls+1; trace=trace*10+7
    if (owner.addressValue() != panelStorage) panelBad=true
    return panelCloseResult
}
fun tab5SessionPanelOpen(owner: NativeBuffer,reference: NativeBuffer,probe: int,scratch: NativeBuffer,layout: int,
    cfg: int,ref: int,div: int,khz: int,vc: int,polls: int,settleUs: int): int {
    panelCalls=panelCalls+1
    if (probe != 257 || layout != 3 || vc != 2) panelBad=true
    return 4
}
var fail=0
var trace=0
fun tab5SessionStorageSafe(session: NativeBuffer,expanders: NativeBuffer,scratch: NativeBuffer): bool = true
fun tab5SessionBusOpen(layout: int): int { trace=trace*10+1; return (if (fail == 1) 4 else 1)<<40 }
fun tab5SessionPrepare(bus: int,board: M5BoardId,expanders: NativeBuffer,scratch: NativeBuffer): int { trace=trace*10+2; return if (fail == 2) 1285 else 1 }
fun tab5SessionScan(prepared: int,board: M5BoardId,bus: int,attempts: int): int { trace=trace*10+3; return if (fail == 3) (42<<32)|(257<<8)|4 else (257<<8)|1 }
fun tab5SessionScanClose(scan: int): int { trace=trace*10+4; return if (fail == 4) scan else scan&4294967295 }
fun tab5SessionExpandersClose(expanders: NativeBuffer): bool { trace=trace*10+5; return fail != 5 }
fun tab5SessionBusClose(bus: int): int { trace=trace*10+6; return if (fail == 6) bus else 0 }
@export("abla_tab5_board_session_test")
fun testSession(): i32 {
    val session=tab5BoardSessionAt(nativeBufferAt(storage,40))
    val expanders=nativeBufferAt(expanderStorage,32); val scratch=nativeBufferAt(scratchStorage,32)
    var stage=0
    while (stage < 4) {
        session.initialize(); trace=0; fail=stage
        val result=session.openOwned(m5BoardTab5,3,expanders,scratch)
        if (result != (if (stage == 0) 1 else stage+2) || trace != (if (stage == 1) 1 else if (stage == 2) 12 else 123) ||
            session.touchProbe() != (if (stage == 0) 257 else 0)) return i32(1)
        fail=0; trace=0
        if (session.closeOwned() != 1 || trace != (if (stage == 1) 6 else if (stage == 3) 456 else 56) || session.ready()) return i32(2)
        stage=stage+1
    }
    stage=4
    while (stage <= 6) {
        session.initialize(); fail=3
        session.openOwned(m5BoardTab5X,1,expanders,scratch)
        fail=stage; trace=0
        if (session.closeOwned() != stage-1 || session.ready()) return i32(3)
        fail=0; trace=0
        if (session.closeOwned() != 1 || trace != (if (stage == 4) 456 else if (stage == 5) 56 else 6)) return i32(4)
        trace=0
        if (session.closeOwned() != 1 || trace != 0) return i32(5)
        stage=stage+1
    }
    session.initialize(); trace=0
    if (session.openOwned(m5BoardTab5,3,nativeBufferAt(storage,32),scratch) != 2 || trace != 0) return i32(6)
    fail=0
    if (session.openOwned(m5BoardTab5,3,expanders,scratch) != 1 || session.layout() != 3) return i32(7)
    val panel=nativeBufferAt(panelStorage,40); val reference=nativeBufferAt(referenceStorage,4)
    if (session.openPanelOwned(panel,reference,scratch,0,0,1,40000,2,10,100) != 4 || panelCalls != 1 || panelBad) return i32(8)
    panelCalls=0
    if (session.openPanelOwned(nativeBufferAt(storage,40),reference,scratch,0,0,1,40000,2,10,100) != 2 ||
        session.openPanelOwned(panel,nativeBufferAt(expanderStorage,4),scratch,0,0,1,40000,2,10,100) != 2 || panelCalls != 0) return i32(9)
    panelCloseResult=6; trace=0
    if (session.closeOwned() != 6 || trace != 7 || session.buffer().loadU32(28) != panelStorage || session.touchProbe() != 257) return i32(11)
    panelCloseResult=1; fail=5; trace=0
    if (session.closeOwned() != 4 || trace != 75 || session.buffer().loadU32(28) != 0 || panelCloseCalls != 2) return i32(12)
    fail=0; trace=0
    if (session.closeOwned() != 1 || trace != 56 || panelCloseCalls != 2 || panelBad) return i32(13)
    if (session.openPanelOwned(panel,reference,scratch,0,0,1,40000,2,10,100) != 2 || panelCalls != 0) return i32(10)
    return i32(0)
}
