import "../src/esp32/spi/config_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun spiConfigTarget(peripheral: u32, source: u32, pre: u32, cycles: u32,
    high: u32, mode: u32, owner: u32): bool =
    esp32s3SpiEnableBusClock(int(peripheral), owner) &&
    esp32s3SpiConfigureClockOwned(int(peripheral), int(source), int(pre), int(cycles), int(high)) &&
    esp32s3SpiConfigureModeOwned(int(peripheral), int(mode), false, false)
#exportFunction("spiConfigTarget", "abla_s3_spi_config_test")
