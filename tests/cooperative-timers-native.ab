import "../src/cooperative_timers.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(204)
var callbacks=0
var replacement=-1
var bad=false
trusted fun cooperativeTimerDispatchOwned(owner: CooperativeTimers,id: int,token: u32): void {
    callbacks=callbacks+1
    if (token == u32(2)) {
        if (owner.run(u32(10)) != -2) bad=true
        replacement=owner.setTimeout(u32(5),u32(1),u32(10))
        if (replacement != id) bad=true
    }
    if (token == u32(3)) owner.deleteTimer(id)
    return
}
@export("abla_cooperative_timers_test")
trusted fun test(): i32 {
    val timers=cooperativeTimersAt(storage)
    if (!timers.initialize() || timers.getNumTimers() != 0 || timers.getNumAvailableTimers() != 10) return i32(1)
    if (timers.setTimer(u32(10),u32(1),u32(2),u32(0)) != 0 || timers.run(u32(9)) != 0 || timers.run(u32(10)) != 1 || timers.getNumTimers() != 1 || timers.run(u32(20)) != 1 || timers.getNumTimers() != 0 || callbacks != 2) return i32(2)
    timers.setInterval(u32(10),u32(1),u32(0))
    if (!timers.disable(0) || timers.isEnabled(0) || timers.run(u32(30)) != 0 || !timers.toggle(0) || timers.run(u32(30)) != 1 || timers.run(u32(30)) != 1 || timers.run(u32(30)) != 0) return i32(3)
    if (!timers.restartTimer(0,u32(100)) || timers.run(u32(109)) != 0 || timers.run(u32(110)) != 1 || !timers.deleteTimer(0)) return i32(4)
    timers.setTimeout(u32(10),u32(1),u32(4294967290))
    if (timers.run(u32(3)) != 0 || timers.run(u32(4)) != 1 || timers.getNumTimers() != 0) return i32(5)
    timers.setTimeout(u32(0),u32(2),u32(10))
    if (timers.run(u32(10)) != 1 || replacement != 0 || timers.getNumTimers() != 1 || timers.run(u32(14)) != 0 || timers.run(u32(15)) != 1 || timers.getNumTimers() != 0 || bad) return i32(6)
    timers.setInterval(u32(0),u32(3),u32(0))
    if (timers.run(u32(0)) != 1 || timers.getNumTimers() != 0) return i32(7)
    var id=0
    while (id < 10) {
        if (timers.setInterval(u32(0),u32(1),u32(0)) != id) return i32(8)
        id=id+1
    }
    if (timers.setTimeout(u32(1),u32(1),u32(0)) != -1 || timers.getNumAvailableTimers() != 0 || timers.run(u32(0)) != 10 || timers.run(u32(0)) != 10 || timers.getNumTimers() != 10) return i32(9)
    if (timers.enable(-1) || timers.deleteTimer(10) || timers.restartTimer(10,u32(0)) || timers.isEnabled(10) || timers.setInterval(u32(0),u32(0),u32(0)) != -1) return i32(10)
    if (cooperativeTimersAt(0).initialize() || cooperativeTimersAt(4294967093).valid() || cooperativeTimersAt(0).run(u32(0)) != -1) return i32(11)
    return i32(0)
}
