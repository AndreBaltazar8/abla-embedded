import "../src/m5stack/cores3_microphone_sequence.ab"
import "../src/m5stack/cores3_microphone_stream_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Es7210 = int
fun Es7210.valid(): bool = this != 0
var trace = 0
var configured = true
var resetOk = true
var parked = true
var startResult = 1
var stopResult = 1
var bad = false
trusted fun Es7210.configureStereoMic12(): bool { trace = trace * 10 + 2; configured }
trusted fun Es7210.reset(): bool { trace = trace * 10 + 4; resetOk }
fun esp32s3GdmaDescriptorValid(address: int): bool = address == 0x3fc88000
trusted fun esp32s3GdmaParked(channel: int, tx: bool): bool { if (channel != 2 || tx) bad = true; trace = trace * 10 + 1; parked }
trusted fun esp32s3I2sStartStream(port: int, tx: bool, channel: int, descriptor: int, polls: int): int { if (port != 1 || tx || channel != 2 || descriptor != 0x3fc88000 || polls != 4) bad = true; trace = trace * 10 + 3; startResult }
trusted fun esp32s3I2sStopStream(port: int, tx: bool, channel: int, polls: int): int { if (port != 1 || tx || channel != 2 || polls != 4) bad = true; trace = trace * 10 + 5; stopResult }
trusted fun microphoneStreamTest(): int {
    var variant = 0
    while (variant < 2) {
        resetOk = variant == 0
        configured = false
        trace = 0
        val failed = cores3StartMicrophoneStream(Es7210(1), 2, 0x3fc88000, 4)
        if (failed.status() != 4 || failed.codecStatus() != (if (resetOk) 259 else 771) || trace != 124 || bad) return 1
        configured = true
        startResult = 2
        while (startResult <= 8) {
            trace = 0
            val started = cores3StartMicrophoneStream(Es7210(1), 2, 0x3fc88000, 4)
            if (started.status() != 5 || started.dmaStatus() != startResult || started.codecStatus() != (if (resetOk) 1 else 4) || trace != 1234 || bad) return 2
            startResult = startResult + 1
        }
        startResult = 1288
        trace = 0
        if (cores3StartMicrophoneStream(Es7210(1), 2, 0x3fc88000, 4).dmaStatus() != 1288 || trace != 1234) return 3
        stopResult = 1
        while (stopResult <= 5) {
            trace = 0
            val stopped = cores3StopMicrophoneStream(Es7210(1), 2, 4)
            if (stopped.status() != (if (stopResult == 1 && resetOk) 1 else 6) || stopped.dmaStatus() != stopResult || stopped.codecStatus() != (if (resetOk) 1 else 4) || trace != 54 || bad) return 4
            stopResult = stopResult + 1
        }
        variant = variant + 1
    }
    startResult = 1
    trace = 0
    if (!cores3StartMicrophoneStream(Es7210(1), 2, 0x3fc88000, 4).valid() || trace != 123) return 5
    parked = false
    trace = 0
    if (cores3StartMicrophoneStream(Es7210(1), 2, 0x3fc88000, 4).status() != 3 || trace != 1) return 6
    trace = 0
    if (cores3StartMicrophoneStream(Es7210(0), 2, 0x3fc88000, 4).status() != 2 || cores3StopMicrophoneStream(Es7210(1), 5, 4).status() != 2 || trace != 0) return 7
    0
}
#exportFunction("microphoneStreamTest", "abla_cores3_microphone_stream_test")
