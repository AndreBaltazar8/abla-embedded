import "../src/esp32/i2s/clock_enable_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun i2sEnableTarget(port: i32, transmit: bool, owner: u32, activate: bool): bool {
    if (activate) return esp32s3I2sActivateClock(int(port), transmit)
    esp32s3I2sEnableClock(int(port), owner)
}
#exportFunction("i2sEnableTarget", "abla_s3_i2s_enable_test")
