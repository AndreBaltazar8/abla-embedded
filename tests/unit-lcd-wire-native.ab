import "./oled-wire-native.ab"
import "../src/display/unit_lcd.ab"
val lcdMemory=nativeStaticAllocate(64816)
val lcdReply=nativeStaticAllocate(256)
var lcdWaited=0
fun unitLcdDelayMicroseconds(us: int): void { if (us != 2000 || mode != 0) bad=true;lcdWaited=lcdWaited+us;return }
fun lcdExpectStart(address: int): void { transactionIndex=0;expectByte(address);return }
@export("abla_unit_lcd_wire_test")
trusted fun testLcdWire(): i32 {
    wireSeed();extraAddress=62;extraCanRead=true;extraReadValue=255
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val device=control.session().bus().device(62,100000)
    val output=nativeBufferAt(lcdMemory,64800);val scratch=nativeBufferAt(lcdMemory+64800,16)
    val reply=nativeBufferAt(lcdReply,256);reply.store(0,119);reply.store(1,137);reply.store(2,0);reply.store(3,91)
    extraReadAddress=lcdReply
    val beforeStop=stops;val beforeStart=starts
    val identity=device.unitLcdIdentify(scratch)
    if (!identity.valid() || identity.value() != 91 || stops != beforeStop+1 || starts != beforeStart+2 || bad) return i32(2)
    extraReadAddress=0
    var failure=0
    while (failure <= 13) {
        var at=0;while (at < 64800) { output.store(at,165);at=at+1 }
        val before=ackCount;extraCount=0;nackAt=if (failure == 0) 0 else before+failure
        val result=device.unitLcdRead16(0,0,135,240,0,output,scratch,1)
        val expected=if (failure == 0) 1 else if (failure <= 3) 3 else if (failure <= 10) 5 else 6
        if (result != expected || ackCount-before != (if (failure == 0) 13 else failure) || bad || mode != 0) return i32(3)
        at=0;while (at < 64800) { if (output.load(at) != (if (failure == 0) 255 else 165)) return i32(4);at=at+1 }
        failure=failure+1
    }
    nackAt=0;extraCount=0;expectedCount=0
    var row=0
    while (row < 2) {
        expectedPages=row;expectedStage=3
        lcdExpectStart(124);expectByte(9);lcdExpectStart(125)
        expectedStage=5;lcdExpectStart(124);expectByte(42);expectByte(7);expectByte(9);expectByte(43);expectByte(5+row);expectByte(5+row)
        expectedStage=6;lcdExpectStart(124);expectByte(66)
        var at=0;while (at < 6) { expectByte((row*8+at)*7);at=at+1 }
        row=row+1
    }
    var at=0;while (at < 16) { output.store(at,at*7);at=at+1 }
    failure=0
    while (failure <= expectedCount) {
        var commit=0
        while (commit < 2) {
            val before=ackCount;extraCount=0;nackAfterCommit=commit == 1
            nackAt=if (failure == 0) 0 else before+failure
            val result=device.unitLcdWrite16(7,5,3,2,0,output,8,scratch,1)
            val e=nativeBufferAt(oledExpected,16384)
            val expected=if (failure == 0) 513 else e.load((failure-1)*4+2)|(e.load((failure-1)*4+3)<<8)
            val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && e.load((failure-1)*4) > 1) 1 else 0)
            if (result != expected || ackCount-before != (if (failure == 0) expectedCount else failure) || extraCount != accepted || bad || mode != 0) return i32(5)
            at=0;while (at < accepted) {
                if (nativeBufferAt(extraWire,8192).load(at*2) != e.load(at*4) || nativeBufferAt(extraWire,8192).load(at*2+1) != e.load(at*4+1)) return i32(6)
                at=at+1
            }
            commit=commit+1
        }
        failure=failure+1
    }
    nackAt=0;nackAfterCommit=false;extraCount=0;extraReadValue=127;lcdWaited=0
    val before=ackCount
    if (device.unitLcdWrite16(7,5,3,2,0,output,8,scratch,2) != 4 || ackCount != before+6 || lcdWaited != 2000) return i32(7)
    if (!device.close() || !control.closeOwned(true) || pads != 0 || bad) return i32(8)
    return i32(0)
}
