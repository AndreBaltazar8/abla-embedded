import "../src/display/spi_window_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val gateMemory=nativeStaticAllocate(4)
val scratch=nativeStaticAllocate(14)
var calls=0
var failure=0
var bad=false
var column=0
var row=0
var wide=0
var tall=0
fun c5LcdProgramAdmission(master: int,dc: int): bool = master == 123 && dc == 26
trusted fun c5LcdProgramCommand(master: int,dc: int,command: int,data: NativeBuffer,bytes: int,polls: int): SpiBufferResult {
    if (peripheralGateAt(gateMemory).tryBegin(u32(8)) != 1 || bytes != 4 || polls != 4 ||
        command != (if (calls == 0) 42 else 43)) bad=true
    val begin=if (calls == 0) column else row
    val end=begin+(if (calls == 0) wide else tall)-1
    if (data.load(0) != (begin>>>8) || data.load(1) != (begin&255) ||
        data.load(2) != (end>>>8) || data.load(3) != (end&255)) bad=true
    calls=calls+1
    return SpiBufferResult(((if (calls == failure) 6 else 1)<<56)|257)
}
fun peripheralDelayMilliseconds(ms: int): void { bad=true;return }
@export("abla_spi_window_c5_test")
trusted fun test(): int {
    val gate=peripheralGateAt(gateMemory)
    var rotation=0
    while (rotation < 8) {
        val view=lcdGeometry(320,240,17,23,400,300).view(rotation,true)
        var edge=0
        while (edge < 4) {
            val x=if ((edge&1) != 0) view.width()-1 else 0
            val y=if ((edge&2) != 0) view.height()-1 else 0
            wide=view.width()-x;tall=view.height()-y
            column=view.columnStart()+x;row=view.rowStart()+y
            failure=0
            while (failure <= 2) {
                nativeAddressStoreU32(gateMemory,0,0);calls=0;bad=false
                val result=esp32C5LcdSetWindow(123,gate,u32(7),26,view,x,y,wide,tall,4)
                if (result.status() != (if (failure == 0) 1 else 6) ||
                    result.completedBytes() != (if (failure == 0) 14 else (failure-1)*6) ||
                    calls != (if (failure == 0) 2 else failure) || bad) return 1
                nativeAddressStoreU32(gateMemory,0,0);calls=0;bad=false
                val program=nativeBufferAt(scratch,14)
                if (!c5LcdWindowProgram(view,x,y,wide,tall,program) || gate.tryBegin(u32(7)) != 0) return 2
                val owned=c5LcdWindowOwned(123,26,program,4)
                if (owned.status() != (if (failure == 0) 1 else 6) ||
                    owned.completedBytes() != (if (failure == 0) 12 else (failure-1)*6) || bad ||
                    !gate.finish(u32(7),owned.valid())) return 3
                failure=failure+1
            }
            calls=0
            if (esp32C5LcdSetWindow(123,gate,u32(7),26,view,-1,0,1,1,4).status() != 3 ||
                esp32C5LcdSetWindow(123,gate,u32(7),26,view,0,0,view.width()+1,1,4).status() != 3 ||
                esp32C5LcdSetWindow(123,gate,u32(7),26,view,0,0,0,1,4).status() != 3 || calls != 0) return 4
            edge=edge+1
        }
        rotation=rotation+1
    }
    return 0
}
