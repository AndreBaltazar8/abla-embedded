import "../src/sd/registers.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage = nativeStaticAllocate(16)
trusted fun setField(data: NativeBuffer, low: int, width: int, value: int): void {
    var bit = 0
    while (bit < width) {
        val position = low + bit
        val byte = 15 - position / 8
        val mask = 1 << (position % 8)
        data.store(byte, (data.load(byte) & (255 ^ mask)) | (if (((value >> bit) & 1) != 0) mask else 0))
        bit = bit + 1
    }
    return
}
trusted fun seal(data: NativeBuffer): void {
    var crc = 0
    var index = 0
    while (index < 15) { crc = sdSpiCrc7Byte(crc, data.load(index)); index = index + 1 }
    data.store(15, (crc << 1) | 1)
    return
}
trusted fun sdRegisterTest(): int {
    val data = nativeBufferAt(storage, 16)
    var index = 0
    while (index < 16) { data.store(index, 0); index = index + 1 }
    var length = 9
    while (length <= 11) {
        setField(data, 80, 4, length)
        var multiplier = 0
        while (multiplier < 8) {
            setField(data, 47, 3, multiplier)
            var size = 0
            while (size < 4096) {
                setField(data, 62, 12, size)
                seal(data)
                if (sdCsdBlockCount(data) != ((size + 1) * (1 << (multiplier + 2)) * (1 << length)) / 512) return 1
                size = size + 1
            }
            multiplier = multiplier + 1
        }
        length = length + 1
    }
    setField(data, 126, 2, 1)
    setField(data, 80, 4, 9)
    var size = 0
    while (size < 4194304) {
        setField(data, 48, 22, size)
        seal(data)
        if (sdCsdBlockCount(data) != (size + 1) * 1024) return 2
        size = size + 2047
    }
    setField(data, 48, 22, 4194303)
    seal(data)
    if (sdCsdBlockCount(data) != 4294967296) return 3
    data.store(15, data.load(15) ^ 2)
    if (sdRegisterValid(data) || sdCsdBlockCount(data) != 0) return 4
    setField(data, 126, 2, 2)
    seal(data)
    if (sdCsdBlockCount(data) != 0) return 5
    if (!sdCardContainsBlocks(4294967296, 4294967295, 1) || sdCardContainsBlocks(4294967296, 4294967295, 2)) return 6
    if (sdCardContainsBlocks(100, -1, 1) || sdCardContainsBlocks(100, 1, -1) || sdCardContainsBlocks(0, 0, 0)) return 7
    if (sdRegisterValid(nativeBufferAt(0, 16)) || sdRegisterValid(nativeBufferAt(storage, 15))) return 8
    0
}
#exportFunction("sdRegisterTest", "abla_sd_register_test")
