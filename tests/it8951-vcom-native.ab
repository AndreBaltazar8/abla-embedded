import "../src/display/it8951_vcom.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(48)
var words=0
var failure=0
var selected=false
var bad=false
var current=2300
var target=2400
var waits=0
fun it8951TransportValid(context: int): bool = context == 7
fun it8951TransportSelect(context: int,active: bool): bool {
    if (context != 7 || (active && selected)) bad=true
    selected=active;return true
}
fun it8951TransportReady(context: int): int = if (context == 7) 1 else -1
fun it8951TransportDelay(context: int,us: int): void {
    if (context != 7 || us != 1000) bad=true
    waits=waits+1;return
}
fun it8951TransportExchange(context: int,word: int): int {
    words=words+1
    val expected=if (words == 1 || words == 8) 24576 else if (words == 2 || words == 9) 57
        else if (words == 5) 4096 else if (words == 11) 1 else if (words == 13) target else 0
    if (context != 7 || !selected || word != expected || words > 13) bad=true
    if (words == failure) return -1
    if (words == 7) current else 0
}
fun resetTrace(): void { words=0;selected=false;bad=false;waits=0;return }
@export("abla_it8951_vcom_test")
trusted fun testVcom(): i32 {
    val scratch=nativeBufferAt(memory,2)
    failure=0
    while (failure <= 13) {
        resetTrace()
        val result=it8951SetVcomRawIf(7,2300,2400,scratch,3)
        if (result.status() != (if (failure == 0) 1 else 4) || result.changed() != (failure == 0) ||
            words != (if (failure == 0) 13 else failure) || selected || bad ||
            waits != (if (failure > 0 && failure <= 4) 0 else 1)) return i32(1)
        failure=failure+1
    }
    failure=0;resetTrace()
    val mismatch=it8951SetVcomRawIf(7,2200,2400,scratch,3)
    if (mismatch.status() != 6 || mismatch.success() || words != 7 || bad || selected) return i32(2)
    resetTrace()
    val unchanged=it8951SetVcomRawIf(7,2300,2300,scratch,3)
    if (!unchanged.success() || unchanged.changed() || words != 7 || bad || selected) return i32(3)
    // Every raw16-bit response, including0 andFFFF, remains distinguishable
    // from a failed read; no guessed calibration defaults.
    current=0
    while (current <= 65535) {
        resetTrace()
        val read=it8951ReadVcomRaw(7,scratch,3)
        if (!read.valid() || read.value() != current || words != 7 || bad || selected) return i32(4)
        current=current+1
    }
    current=2300;resetTrace()
    val session=it8951SessionAt(nativeBufferAt(memory+8,40))
    session.initialize();session.buffer().storeU32(4,1);session.buffer().storeU32(8,7)
    if (session.setVcomRawIfOwned(2200,2400,scratch,3,true).status() != 6 || session.state() != 1) return i32(5)
    resetTrace();failure=13
    val failed=session.setVcomRawIfOwned(2300,2400,scratch,3,true)
    if (failed.status() != 4 || session.state() != 2 || session.lastResult() != (failed|0)) return i32(6)
    resetTrace();failure=0
    if (session.readVcomRawOwned(scratch,3,true).status() != 2 || words != 0) return i32(7)
    session.buffer().storeU32(4,1)
    if (session.setVcomRawIfOwned(-1,2400,scratch,3,true).status() != 2 ||
        session.setVcomRawIfOwned(2300,65536,scratch,3,true).status() != 2 ||
        session.setVcomRawIfOwned(2300,2400,session.buffer(),3,true).status() != 2 ||
        session.setVcomRawIfOwned(2300,2400,scratch,3,false).status() != 2 || words != 0) return i32(8)
    i32(0)
}
