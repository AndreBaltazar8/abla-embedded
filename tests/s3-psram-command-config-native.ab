import "../src/esp32/psram/command_config_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/build"
val ccMemory=nativeStaticAllocate(400)
var ccBase=0
var ccPoll=0
var ccBad=false
var ccWrites=0
fun s3PsramOpiRead(address: int): int {
    if (address < ccBase || address >= ccBase+256 || (address&3) != 0) ccBad=true
    if (address == ccBase) { ccPoll=ccPoll+1;return if (ccPoll <= 3) 1 else 0 }
    return nativeBufferAt(ccMemory,256).loadU32(address-ccBase)
}
fun s3PsramOpiWrite(address: int,value: int): void {
    if (ccPoll != 4 || address < ccBase+4 || address >= ccBase+152 || (address&3) != 0) ccBad=true
    nativeBufferAt(ccMemory,256).storeU32(address-ccBase,value)
    ccWrites=ccWrites+1;return
}
@export("abla_s3_psram_command_config_test")
trusted fun commandConfigTest(): int {
    val regs=nativeBufferAt(ccMemory,256)
    val d=nativeBufferAt(ccMemory+256,32)
    val tx=nativeBufferAt(ccMemory+288,64)
    var unit=0
    while (unit < 2) {
        ccBase=0x60003000-unit*4096
        var bits=0
        while (bits <= 512) {
            var profile=0
            while (profile < 4) {
                val seed=(bits*15485863+profile*32452843)&0xffffffff
                var i=0
                while (i < 256) { regs.storeU32(i,seed);i=i+4 }
                i=0
                while (i < 64) { tx.storeU32(i,0xa5ff005a^i);i=i+4 }
                val cb=if (profile == 0) 0 else if (profile == 1) 1 else if (profile == 2) 8 else 16
                val ab=if (profile == 0) 0 else if (profile == 1) 1 else if (profile == 2) 24 else 32
                val dummy=if (profile == 0) 0 else if (profile == 1) 1 else if (profile == 2) 18 else 64
                val rb=512-bits
                d.storeU32(0,(cb<<16)|0x8080);d.storeU32(4,ccMemory+352);d.storeU32(8,ab)
                d.storeU32(12,if (profile == 1) 0 else ccMemory+288);d.storeU32(16,bits)
                // Configure does not dereference RX; transfer-start owns it.
                d.storeU32(20,1);d.storeU32(24,rb);d.storeU32(28,dummy)
                nativeBufferAt(ccMemory+352,4).storeU32(0,0xfedcba98)
                ccPoll=0;ccWrites=0;ccBad=false
                s3PsramCommandConfigNativeOwned(unit,ccMemory+256)
                if (ccBad || ccPoll != 4 || ccWrites == 0) return 1
                var user=seed&0x07ffffff
                if (cb != 0) user=user|(1<<31)
                if (ab != 0) user=user|(1<<30)
                if (dummy != 0) user=user|(1<<29)
                if (rb != 0) user=user|(1<<28)
                if (bits != 0) user=user|(1<<27)
                val user1=(seed&0x03ffffc0)|(if (ab == 0) 0 else (ab-1)<<26)|(if (dummy == 0) 0 else dummy-1)
                val user2=if (cb == 0) seed&0x0fffffff else (seed&0x0fff0000)|((cb-1)<<28)|0x8080
                if (regs.loadU32(24) != user || regs.loadU32(28) != user1 || regs.loadU32(32) != user2) return 2
                if (regs.loadU32(36) != ((seed&0xfffffc00)|(if (bits == 0) 0 else bits-1)) ||
                    regs.loadU32(40) != ((seed&0xfffffc00)|(if (rb == 0) 0 else rb-1))) return 3
                if (regs.loadU32(4) != (if (ab == 0) seed else 0xfedcba98) ||
                    regs.loadU32(60) != (if (ab == 0) seed else if (ab == 32) seed|2 else seed&0xfffffffd)) return 4
                i=0
                while (i < 64) {
                    val expected=if (bits != 0 && profile != 1 && i < ((bits+31)>>>5)*4) 0xa5ff005a^i else seed
                    if (regs.loadU32(88+i) != expected) return 5
                    i=i+4
                }
                i=0
                while (i < 256) {
                    val changed=i == 4 || (i >= 24 && i <= 40) || i == 60 || (i >= 88 && i < 152)
                    if (!changed && regs.loadU32(i) != seed) return 6
                    i=i+4
                }
                profile=profile+1
            }
            bits=bits+1
        }
        unit=unit+1
    }
    return 0
}
