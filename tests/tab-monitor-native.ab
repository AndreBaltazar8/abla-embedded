import "../src/i2c/results.ab"
import "../src/m5stack/tab_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var calls=0
var failure=0
var wrongId=false
var bad=false
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; return false }
fun I2cDevice.readRegister16BigEndianChecked(register: int): I2cWordResult {
    calls=calls+1
    if (this != 8 || register != 255 || calls != 1) bad=true
    if (failure == calls) I2cWordResult(0) else I2cWordResult(65536|(if (wrongId) 0 else 8800))
}
fun I2cDevice.writeRegister16BigEndian(register: int,value: int): bool {
    calls=calls+1
    if (this != 8 || (calls != 2 && calls != 3) || register != (if (calls == 2) 0 else 5) ||
        value != (if (calls == 2) 1319 else 16776)) bad=true
    failure != calls
}
@export("abla_tab_monitor_test")
trusted fun monitorTest(): i32 {
    val owner=m5ExpandersAt(nativeBufferAt(nativeStaticAllocate(32),32))
    val previous=Ina226(8|(70000<<32))
    var profile=0
    while (profile < 16) {
        failure=profile%4; wrongId=(profile & 4) != 0
        owner.initialize(); owner.buffer().storeU32(8,if (profile < 8) m5BoardTab5 | 0 else m5BoardTab5X | 0)
        owner.storeSlot(0,M5ExpanderOpen(9|(1<<32)|(1<<40)))
        owner.storeSlot(1,M5ExpanderOpen(10|(1<<32)|(1<<40)))
        owner.buffer().storeU32(4,1)
        calls=0; bad=false
        val result=owner.configureTabCurrentMonitor(previous)
        val success=failure == 0 && !wrongId
        val expectedCalls=if (failure == 1 || wrongId) 1 else if (failure == 2) 2 else 3
        if (result.configured() != success || (result & 4294967295) != 8 ||
            result.currentLsbNanoamps() != (if (success) 61036 else 0) || calls != expectedCalls || bad || !owner.ready()) return i32(1)
        profile=profile+1
    }
    calls=0; bad=false
    if (owner.configureTabCurrentMonitor(Ina226(0)).configured() || calls != 0 || bad) return i32(2)
    owner.buffer().storeU32(4,6)
    if (owner.configureTabCurrentMonitor(previous).configured() || calls != 0) return i32(3)
    owner.buffer().storeU32(4,1); owner.buffer().storeU32(8,m5BoardArduinoNessoN1 | 0)
    if (owner.configureTabCurrentMonitor(previous).configured() || calls != 0 || bad) return i32(4)
    i32(0)
}
