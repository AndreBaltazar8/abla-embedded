import "../src/m5stack/core_s3_pins.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this
fun mbusMapsMatch(): bool {
    var board=0
    while (board < 256) {
        var position=-1
        while (position <= 32) {
            val expected=if (board == 31) (if (position == 1) -1 else if (position == 2) 17 else if (position == 3) -1 else if (position == 4) 20 else if (position == 5) -1 else if (position == 6) -1 else if (position == 7) 7 else if (position == 8) 21 else if (position == 9) 8 else if (position == 10) 22 else if (position == 11) 10 else if (position == 12) -1 else if (position == 13) 38 else if (position == 14) 37 else if (position == 15) 15 else if (position == 16) 14 else if (position == 17) 11 else if (position == 18) 9 else if (position == 19) 18 else if (position == 20) 16 else if (position == 21) 39 else if (position == 22) 12 else if (position == 23) 34 else if (position == 24) 23 else if (position == 25) -1 else if (position == 26) 19 else if (position == 27) -1 else if (position == 28) -1 else if (position == 29) -1 else if (position == 30) -1 else -1) else if (board == 22 || board == 35) (if (position == 1) -1 else if (position == 2) 16 else if (position == 3) -1 else if (position == 4) 17 else if (position == 5) -1 else if (position == 6) -1 else if (position == 7) 18 else if (position == 8) 45 else if (position == 9) 19 else if (position == 10) 52 else if (position == 11) 5 else if (position == 12) -1 else if (position == 13) 38 else if (position == 14) 37 else if (position == 15) 7 else if (position == 16) 6 else if (position == 17) 31 else if (position == 18) 32 else if (position == 19) 3 else if (position == 20) 4 else if (position == 21) 2 else if (position == 22) 48 else if (position == 23) 47 else if (position == 24) 35 else if (position == 25) -1 else if (position == 26) 51 else if (position == 27) -1 else if (position == 28) -1 else if (position == 29) -1 else if (position == 30) -1 else -1) else if (board == 10 || board == 17 || board == 27) (if (position == 1) -1 else if (position == 2) 10 else if (position == 3) -1 else if (position == 4) 8 else if (position == 5) -1 else if (position == 6) -1 else if (position == 7) 37 else if (position == 8) 5 else if (position == 9) 35 else if (position == 10) 9 else if (position == 11) 36 else if (position == 12) -1 else if (position == 13) 44 else if (position == 14) 43 else if (position == 15) 18 else if (position == 16) 17 else if (position == 17) 12 else if (position == 18) 11 else if (position == 19) 2 else if (position == 20) 1 else if (position == 21) 6 else if (position == 22) 7 else if (position == 23) 13 else if (position == 24) 0 else if (position == 25) -1 else if (position == 26) 14 else if (position == 27) -1 else if (position == 28) -1 else if (position == 29) -1 else if (position == 30) -1 else -1) else if (board == 152) (if (position == 1) -1 else if (position == 2) 3 else if (position == 3) -1 else if (position == 4) 4 else if (position == 5) -1 else if (position == 6) -1 else if (position == 7) 27 else if (position == 8) 5 else if (position == 9) 26 else if (position == 10) 6 else if (position == 11) 25 else if (position == 12) -1 else if (position == 13) 10 else if (position == 14) 11 else if (position == 15) 7 else if (position == 16) 8 else if (position == 17) 0 else if (position == 18) 1 else if (position == 19) 0 else if (position == 20) 1 else if (position == 21) 23 else if (position == 22) 22 else if (position == 23) 24 else if (position == 24) 9 else if (position == 25) -1 else if (position == 26) 29 else if (position == 27) -1 else if (position == 28) -1 else if (position == 29) -1 else if (position == 30) -1 else -1) else if (board == 1) (if (position == 1) -1 else if (position == 2) 35 else if (position == 3) -1 else if (position == 4) 36 else if (position == 5) -1 else if (position == 6) -1 else if (position == 7) 23 else if (position == 8) 25 else if (position == 9) 19 else if (position == 10) 26 else if (position == 11) 18 else if (position == 12) -1 else if (position == 13) 3 else if (position == 14) 1 else if (position == 15) 16 else if (position == 16) 17 else if (position == 17) 21 else if (position == 18) 22 else if (position == 19) 2 else if (position == 20) 5 else if (position == 21) 12 else if (position == 22) 13 else if (position == 23) 15 else if (position == 24) 0 else if (position == 25) -1 else if (position == 26) 34 else if (position == 27) -1 else if (position == 28) -1 else if (position == 29) -1 else if (position == 30) -1 else -1) else if (board == 2 || board == 8) (if (position == 1) -1 else if (position == 2) 35 else if (position == 3) -1 else if (position == 4) 36 else if (position == 5) -1 else if (position == 6) -1 else if (position == 7) 23 else if (position == 8) 25 else if (position == 9) 38 else if (position == 10) 26 else if (position == 11) 18 else if (position == 12) -1 else if (position == 13) 3 else if (position == 14) 1 else if (position == 15) 13 else if (position == 16) 14 else if (position == 17) 21 else if (position == 18) 22 else if (position == 19) 32 else if (position == 20) 33 else if (position == 21) 27 else if (position == 22) 19 else if (position == 23) 2 else if (position == 24) 0 else if (position == 25) -1 else if (position == 26) 34 else if (position == 27) -1 else if (position == 28) -1 else if (position == 29) -1 else if (position == 30) -1 else -1) else -1
            if (M5BoardId(board).mBusPin(position).number() != expected) return false
            position=position+1
        }
        board=board+1
    }
    return true
}
@export("abla_core_s3_pins_test")
fun testPins(): i32 {
    if (!mbusMapsMatch()) return i32(6)
    val core=m5CoreS3();val se=m5CoreS3SE()
    if (core.portA() != m5PortPins(1,2) || core.portB() != m5PortPins(8,9) || core.portC() != m5PortPins(18,17) || core.portD() != m5PortPins(14,10) || core.portE() != m5PortPins(18,17)) return i32(1)
    if (se.portA() != core.portA() || se.portB() != core.portB() || se.portC() != core.portC() || se.portD() != core.portD() || se.portE() != core.portE()) return i32(2)
    if (core.internalI2cClock().number() != 11 || core.internalI2cData().number() != 12 || core.externalI2cClock().number() != 1 || core.externalI2cData().number() != 2 ||
        se.internalI2cClock() != core.internalI2cClock() || se.internalI2cData() != core.internalI2cData() || se.externalI2cClock() != core.externalI2cClock() || se.externalI2cData() != core.externalI2cData()) return i32(3)
    val sd=core.sdPins()
    if (!sd.available() || sd.spiClock().number() != 36 || sd.spiMosi().number() != 37 || sd.spiMiso().number() != 35 || sd.spiChipSelect().number() != 4 || sd.usesSdmmcFourBit() || se.sdPins() != sd) return i32(4)
    // Upstream physical M-Bus positions, including NC/power positions.
    var position=-2
    while (position <= 33) {
        val expected=if (position == 1) -1 else if (position == 2) 10 else if (position == 3) -1 else if (position == 4) 8 else if (position == 5) -1 else if (position == 6) -1 else if (position == 7) 37 else if (position == 8) 5 else if (position == 9) 35 else if (position == 10) 9 else if (position == 11) 36 else if (position == 12) -1 else if (position == 13) 44 else if (position == 14) 43 else if (position == 15) 18 else if (position == 16) 17 else if (position == 17) 12 else if (position == 18) 11 else if (position == 19) 2 else if (position == 20) 1 else if (position == 21) 6 else if (position == 22) 7 else if (position == 23) 13 else if (position == 24) 0 else if (position == 25) -1 else if (position == 26) 14 else if (position == 27) -1 else if (position == 28) -1 else if (position == 29) -1 else if (position == 30) -1 else -1
        if (core.mBusPin(position).number() != expected || se.mBusPin(position).number() != expected) return i32(5)
        position=position+1
    }
    return i32(0)
}
