import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/inputs.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_inputs_target")
trusted fun inputTarget(owner: M5Inputs,board: M5BoardId,pi4: Pi4Ioe5v6408,pmic: M5PmicOpen,
    powerHub: I2cDevice,touch: M5TouchButtons,now: int): bool = owner.poll(board,pi4,pmic,powerHub,touch,now)
