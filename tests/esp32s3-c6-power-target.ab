// Actual peripheral graph check on S3; not a C6 bootable image.
import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/c6_power.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c6_power_target")
trusted fun powerTarget(owner: M5Expanders,charger: M5PmicOpen,gauge: Bq27220): M5C6PowerInit = owner.configureC6Power(charger,gauge)
