import "../src/esp32/power/pvt_park_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(48)
var writes=0
var failAt=0
var bad=false
var source=0
var revision=0x200
fun slot(address: int): int = if (address == 0x60019028) 0 else if (address == 0x600b0028) 1 else if (address == 0x600b009c) 2 else
    if (address == 0x60019064) 3 else if (address == 0x600960b8) 4 else if (address == 0x600960bc) 5 else -1
trusted fun c5PvtParkRead(address: int): int {
    if (address == 0x60096144) return 0
    if (address == 0x60096110) return source
    if (address == 0x600b484c) return revision
    val index=slot(address)
    if (index < 0) { bad=true;return 0 }
    val regs=nativeBufferAt(memory+24,24)
    if ((index == 0 || index == 3) && (regs.loadU32(16)&1) == 0) bad=true
    regs.loadU32(index*4)
}
trusted fun c5PvtParkWrite(address: int,value: int): void {
    writes=writes+1;val index=slot(address)
    if (index < 0) { bad=true;return }
    if (writes != failAt) nativeBufferAt(memory+24,24).storeU32(index*4,value)
    return
}
@export("abla_pvt_park_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,24);val regs=nativeBufferAt(memory+24,24)
    var pair=0
    while (pair < 1024) {
        val hp=pair&31;val lp=pair>>5
        var fault=0
        while (fault <= 7) {
            record.storeU32(0,0);writes=0;failAt=fault;bad=false
            regs.storeU32(0,0x76543610);regs.storeU32(4,0x80008000|(hp<<9)|(lp<<4));regs.storeU32(8,0x12345678)
            regs.storeU32(12,0xffff1234);regs.storeU32(16,0xabc001);regs.storeU32(20,0x40abcd)
            val result=esp32C5PvtParkOwned(record,true)
            if (result != 1 && result != 3) return i32(1)
            failAt=0
            if (esp32C5PvtParkOwned(record,true) != 1 || bad) return i32(2)
            if (record.loadU32(8) != hp || record.loadU32(12) != lp || regs.loadU32(0) != (0x76543610&~512) ||
                regs.loadU32(4) != (0xc000|(hp<<9)|(lp<<4)|(hp<<27)) || regs.loadU32(8) != ((0x12345678&0x7ffffff)|(lp<<27)) ||
                regs.loadU32(12) != 0x7fff1234 || regs.loadU32(16) != 0xabc000 || regs.loadU32(20) != 0xabcd) return i32(3)
            val before=writes
            if (esp32C5PvtParkOwned(record,true) != 1 || writes != before || esp32C5PvtParkOwned(record,false) != 2) return i32(4)
            fault=fault+1
        }
        pair=pair+1
    }
    record.storeU32(0,0);writes=0;source=0x20000
    if (esp32C5PvtParkOwned(record,true) != 2 || writes != 0) return i32(5)
    source=0;revision=0
    if (esp32C5PvtParkOwned(record,true) != 2 || writes != 0) return i32(6)
    revision=0x200
    if (esp32C5PvtParkOwned(record,true) != 2 || writes != 0) return i32(7)
    return i32(0)
}
