// The retained-path checker finds the call chain to a named source and rejects a missing
// entry and unreachable or absent boundaries.

import "abla/io"
import "abla/text"
import "../tools/check-target-reachability.ab"

var failures = 0

fun check(ok: bool, label: string): void {
    if (!ok) {
        failures = failures + 1
        println("FAIL $label")
    }
}

fun main: int {
    val ir = "define i64 @entry(i64 %x) #0 {\n  %r = call i64 @middle(i64 %x)\n  ret i64 %r\n}\n" +
        "define internal i64 @middle(i64 %x) #1 {\n  %r = call i64 @hardware(i64 %x)\n  ret i64 %r\n}\n" +
        "define internal i64 @hardware(i64 %x) #2 {\n  ret i64 %x\n}\n" +
        "define internal i64 @unreachable(i64 %x) #3 {\n  ret i64 %x\n}\n" +
        "attributes #0 = { \"abla.source\"=\"main\" }\nattributes #1 = { \"abla.source\"=\"driver\" }\n" +
        "attributes #2 = { \"abla.source\"=\"transfer\" }\nattributes #3 = { \"abla.source\"=\"dead\" }\n"
    val direct = inspectReachability(ir, "entry", ["transfer"])
    check(direct.error == "" && direct.chains.size == 1 && direct.chains[0] == "main -> driver -> transfer",
        "direct chain: ${direct.error} ${direct.chains.size}")
    val aliased = inspectReachability("@public = alias i64 (i64), ptr @entry\n" + ir, "public", ["transfer"])
    check(aliased.error == "" && aliased.chains.size == 1 && aliased.chains[0] == "public -> main -> driver -> transfer",
        "alias chain: ${aliased.error} ${aliased.chains.size}")
    check(inspectReachability(ir, "missing", ["transfer"]).error != "", "missing entry accepted")
    check(inspectReachability(ir, "entry", ["dead"]).error != "", "unreachable source accepted")
    check(inspectReachability(ir, "entry", ["absent"]).error != "", "absent source accepted")
    if (failures != 0) return 1
    println("PASS: retained-path checker rejects missing and unreachable boundaries")
    0
}
