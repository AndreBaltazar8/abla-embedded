import "../src/esp32/i2c_esp32s3.ab"
import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "../src/rtc/powerhub_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_partial_read_target")
trusted fun partialReadTarget(handle: int,model: int,date: bool): bool {
    if (model == 0) return if (date) Pcf8563(handle).date().valid() else Pcf8563(handle).time().valid()
    if (model == 1) return if (date) Rx8130(handle).date().valid() else Rx8130(handle).time().valid()
    if (date) PowerHubRtc(handle).date().valid() else PowerHubRtc(handle).time().valid()
}
