import "../src/power/ina_logic.ab"

fun main: int {
    val currentLsb = ina226CurrentLsbNanoamps(2000)
    val configuration = ina226ConfigurationValue(2, 4, 4, 7)
    val monitor = ina3221PackedWithShuntResistance(
        ina3221PackedValue(4660), 1, 25
    )
    val integerLogic = powerSigned16(65535) == -1 &&
        powerSigned16(32768) == -32768 && currentLsb == 61036 &&
        ina226CurrentLsbNanoamps(70368745) == 0 &&
        ina226CalibrationValue(100000, currentLsb) == 838 &&
        ina226CalibrationValue(5120000000001, 1) == 0 &&
        configuration == 1319 && ina3221BusMillivolts(12000) == 12000 &&
        ina3221ShuntMicrovolts(200) == 1000 &&
        (monitor & 4294967295) == 4660 &&
        ina3221PackedShuntResistance(monitor, 0) == 10 &&
        ina3221PackedShuntResistance(monitor, 1) == 25 &&
        ina3221PackedShuntResistance(monitor, 2) == 10
    val measurements = ina226BusVoltage(8000) == 10.0 &&
        ina226Current(100, 1000000) == 0.1 &&
        ina226Power(4, 1000000) == 0.1 &&
        ina3221BusVoltage(12000) == 12.0 &&
        ina3221Current(200, 10) == 0.1
    if (integerLogic && measurements) 52 else 1
}
