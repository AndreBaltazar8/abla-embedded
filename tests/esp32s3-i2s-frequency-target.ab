import "../src/esp32/i2s/clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun i2sFrequencyTarget(port: i32, transmit: bool, sourceHz: u32, targetHz: u32): u32 =
    u32(esp32s3I2sSetFrequency(int(port), transmit, int(sourceHz), int(targetHz)).frequency(int(sourceHz)))
#exportFunction("i2sFrequencyTarget", "abla_s3_i2s_frequency_test")
