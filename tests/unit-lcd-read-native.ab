import "../src/display/unit_lcd.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
fun I2cDevice.valid(): bool = this == 7
val memory=nativeStaticAllocate(64816)
var calls=0
var fail=0
var waited=0
var rotation=0
var copying=false
var bad=false
fun unitLcdDelayMicroseconds(us: int): void { if (us != 2000) bad=true;waited=waited+us;return }
trusted fun I2cDevice.writeRead(source: NativeBuffer,length: int,output: NativeBuffer,count: int): bool {
    calls=calls+1
    if (length != 1) bad=true
    if (source.load(0) == 9) {
        if (calls > (if (copying) 1 else 2) || count != 1) bad=true
        output.store(0,if (calls == 1) 128 else 255)
    } else {
        if (copying || calls != 4 || source.load(0) != 130 || count != 64800 || waited != 2000) bad=true
        val end=if (fail == calls) 13 else count
        var at=0;while (at < end) { output.store(at,(at*73+19)&255);at=at+1 }
    }
    return calls != fail
}
trusted fun I2cDevice.write(bytes: NativeBuffer,length: int): bool {
    calls=calls+1
    if (copying) {
        if (calls != 2 || length != 7 || bytes.load(0) != 35 || bytes.load(1) != 2 || bytes.load(2) != 3 ||
            bytes.load(3) != 11 || bytes.load(4) != 22 || bytes.load(5) != 4 || bytes.load(6) != 5) bad=true
    } else if (calls != 3 || length != 6 || bytes.load(0) != 42 || bytes.load(1) != 0 || bytes.load(2) != (if ((rotation&1) == 0) 134 else 239) ||
        bytes.load(3) != 43 || bytes.load(4) != 0 || bytes.load(5) != (if ((rotation&1) == 0) 239 else 134)) bad=true
    return calls != fail
}
@export("abla_unit_lcd_read_test")
trusted fun testRead(): i32 {
    val destination=nativeBufferAt(memory,64800);val scratch=nativeBufferAt(memory+64800,16);val device=I2cDevice(7)
    while (rotation < 8) {
        fail=0
        while (fail <= 4) {
            calls=0;waited=0
            var at=0;while (at < 64800) { destination.store(at,165);at=at+1 }
            val result=device.unitLcdRead16(0,0,if ((rotation&1) == 0) 135 else 240,if ((rotation&1) == 0) 240 else 135,rotation,destination,scratch,2)
            val expected=if (fail == 0) 1 else if (fail <= 2) 3 else if (fail == 3) 5 else 6
            if (result != expected || calls != (if (fail == 0) 4 else fail) || bad) return i32(1)
            at=0;while (at < 64800) {
                val value=if (fail == 0 || (fail == 4 && at < 13)) (at*73+19)&255 else 165
                if (destination.load(at) != value) return i32(2)
                at=at+1
            }
            fail=fail+1
        }
        rotation=rotation+1
    }
    copying=true;fail=0
    while (fail <= 2) {
        calls=0;waited=0
        if (device.unitLcdCopyRect(4,5,2,3,10,20,0,scratch,2) != (if (fail == 0) 1 else if (fail == 1) 3 else 5) ||
            calls != (if (fail == 0) 2 else fail) || waited != 0 || bad) return i32(3)
        fail=fail+1
    }
    calls=0
    if (device.unitLcdRead16(0,0,1,1,0,scratch,scratch,1) != 2 || device.unitLcdCopyRect(134,0,0,0,2,1,0,scratch,1) != 2 || calls != 0) return i32(4)
    return i32(0)
}
