import "../src/esp32/power/sleep_recovery_composition_c5.ab"
import "../src/esp32/power/sleep_prepare_composition_c5.ab"
import "../src/esp32/power/sleep_entry_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(2496)
var timeHigh=u32(0)
var timeLow=u32(0)
var timeLoads=0
trusted fun esp32C5TimerRead(address: int): u32 {
    if (recovering && (!clockReady || cacheResumes != 1 || regRead(1792,0x3c) != 0 || regRead(1792,0x13c) != 0)) bad=true
    if (address == 0x6009606c) return u32(5)
    if (address == 0x60096070) return u32(0x400000)
    if (address == 0x6000a004) return u32(0x20000000)
    if (address == 0x6000a040) return u32(0)
    if (address == 0x6000a044) return u32(1600)
    if (address == 0x6000a00c) return timeHigh
    if (address == 0x6000a010) return timeLow
    bad=true;return u32(0)
}
trusted fun esp32C5TimerWrite(address: int,value: u32): void {
    if (address == 0x6000a004) return
    if (address == 0x6000a00c) timeHigh=value
    else if (address == 0x6000a010) { if (fault == 6) { fault=0;return };timeLow=value }
    else if (address == 0x6000a05c) { if (value != u32(1)) bad=true;timeLoads=timeLoads+1 }
    else bad=true
    return
}
var fault=0
var recovering=false
var bad=false
var clockReady=false
var cacheResumes=0
var predictorRestores=0
var flashDelay=0
var expectedResult=0
var expectedMHz=0
var rcGate=0
var modeStore=1
var requests=0
var efuseBusy=0
trusted fun c5SleepEntryRead(address: int): int {
    if (address == 0x600b1020) return modeStore
    if (address == 0x600b49d4) { if (efuseBusy > 0) { efuseBusy=efuseBusy-1;return 0 };return 1 }
    return regRead(512,address-0x600b0000)
}
trusted fun c5SleepEntryWrite(address: int,value: int): void {
    if (address == 0x600b1020) { modeStore=value;return }
    val offset=address-0x600b0000
    if (offset == 0x12c && !recovering && expectedResult == -3) return
    if (offset == 0x128 && recovering && fault == 5) { fault=0;return }
    if (offset == 0x16c) regWrite(512,0x160,regRead(512,0x160)&~value)
    else if (offset == 0x134) regWrite(512,0x148,0)
    else if (offset == 0x124) {
        if (value != 0x80000000 || expectedResult < 0) bad=true
        requests=requests+1;efuseBusy=3
        regWrite(512,0x160,if (expectedResult == 0) 0x80000000 else 0x40000000)
    } else regWrite(512,offset,value)
    return
}
trusted fun regRead(bank: int,offset: int): int {
    if (offset < 0 || offset >= 512 || (offset&3) != 0) { bad=true;return 0 }
    nativeBufferAt(memory+bank,512).loadU32(offset)
}
trusted fun regWrite(bank: int,offset: int,value: int): void {
    if (offset < 0 || offset >= 512 || (offset&3) != 0) { bad=true;return }
    nativeBufferAt(memory+bank,512).storeU32(offset,value);return
}
trusted fun c5SleepPowerRead(offset: int): int = regRead(512,offset)
trusted fun c5SleepPowerWrite(offset: int,value: int): void { regWrite(512,offset,value);return }
trusted fun c5SleepDigitalRead(offset: int): int = regRead(512,offset)
trusted fun c5SleepDigitalWrite(offset: int,value: int): void { regWrite(512,offset,value);return }
trusted fun c5SleepAnalogRead(offset: int): int = regRead(512,offset)
trusted fun c5SleepAnalogWrite(offset: int,value: int): void { regWrite(512,offset,value);return }
trusted fun c5SleepTimingRead(offset: int): int = regRead(512,offset)
trusted fun c5SleepTimingWrite(offset: int,value: int): void {
    if (recovering && fault == 1 && offset == 0x120) { fault=0;return }
    regWrite(512,offset,value);return
}
trusted fun c5SleepEfuseRead(offset: int): int { bad=true;return 0 }
trusted fun c5CpuClockRead(offset: int): int = if (offset == 0x144) 0 else regRead(1024,offset)
trusted fun c5CpuClockWrite(offset: int,value: int): void {
    if (recovering && nativeBufferAt(memory+128,304).loadU32(4) != 4) bad=true
    if (offset == 0x118 && fault == 2) { fault=0;return }
    if (offset != 0x144) regWrite(1024,offset,value)
    return
}
trusted fun c5CpuClockTicks(mhz: int): void { if (mhz != (if (recovering) expectedMHz else 40)) bad=true;clockReady=recovering;return }
trusted fun c5ClockParkPvtActive(): bool { bad=true;return false }
trusted fun c5ClockParkPvt(record: NativeBuffer): int { bad=true;return 2 }
// These two paths must remain unused for XTAL/RC_FAST without PVT.
trusted fun c5ClockResumePll(record: NativeBuffer,limit: int): int { bad=true;return 3 }
trusted fun c5ClockResumePvt(record: NativeBuffer): int { bad=true;return 3 }
trusted fun c5ClockResumeRead(address: int): int = if (address == 0x600b00ac) regRead(512,0xac) else if (address == 0x600b0420) rcGate else 0
trusted fun c5ClockResumeWrite(address: int,value: int): void {
    if (address == 0x600b00ac) regWrite(512,0xac,value)
    else if (address == 0x600b0420) rcGate=value
    else bad=true
    return
}
trusted fun c5ClockResumeDelay(us: int): void { if (us != 50 && us != 5) bad=true;return }
trusted fun c5RtcTimerRead(offset: int): int = regRead(1536,offset)
trusted fun c5RtcTimerWrite(offset: int,value: int): void {
    if (offset == 0x34) {
        if (recovering && !clockReady) bad=true
        if (recovering && fault == 3) { fault=0;return }
        regWrite(1536,0x28,regRead(1536,0x28)&~value)
    } else if (offset == 4) regWrite(1536,offset,value&0x7fffffff)
    else regWrite(1536,offset,value)
    return
}
trusted fun c5SleepUartRead(address: int): int {
    if (address == 0x60096000 || address == 0x6009600c) {
        if (recovering && cacheResumes != 1) bad=true
        if (recovering && fault == 4 && address == 0x60096000) { fault=0;return 0 }
        return 1
    }
    if (address == 0x60096004 || address == 0x60096010) return 0x400000
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset == 0x98 || offset == 0x70) return 0
    return regRead(1792,port*256+offset)
}
trusted fun c5SleepUartWrite(address: int,value: int): void {
    val port=if (address >= 0x60001000) 1 else 0
    val offset=address-0x60000000-port*4096
    if (offset != 0x98) regWrite(1792,port*256+offset,value)
    return
}
trusted fun c5CachePredictorDisable(): int = 0x1030
trusted fun c5CacheRomSuspend(): int = 0x80000001
trusted fun c5SleepFlashReadyDelay(us: int): void { if (!clockReady || us != 700) bad=true;flashDelay=flashDelay+1;return }
trusted fun c5CacheRomResume(saved: int): void {
    if (!clockReady || nativeBufferAt(memory+432,24).loadU32(4) != 6 || saved != 0x80000001 || flashDelay != (if (expectedResult == 0) 1 else 0)) bad=true
    cacheResumes=cacheResumes+1;return
}
trusted fun c5CachePredictorRestore(saved: int): void { if (cacheResumes != 1 || saved != 0x1030) bad=true;predictorRestores=predictorRestores+1;return }
@export("abla_sleep_recovery_components_c5_test")
trusted fun test(): int {
    val record=nativeBufferAt(memory,128);val profile=nativeBufferAt(memory+128,304);val alarm=nativeBufferAt(memory+432,24)
    var mode=0
    while (mode < 10) {
        var failure=0
        while (failure < 7) {
            var i=0
            while (i < 2496) { nativeBufferAt(memory,2496).storeU32(i,0);i=i+4 }
            timeHigh=u32(0);timeLow=u32(0);timeLoads=0
            recovering=false;bad=false;fault=0;clockReady=false;cacheResumes=0;predictorRestores=0;flashDelay=0;rcGate=0
            // Start divided, so park really changes the CPU/AHB shadows and
            // the lost restore-write fault is observable (not identical data).
            expectedResult=(mode%5)-3;val source=if (mode < 5) 0 else 1;expectedMHz=if (source == 0) 20 else 10
            requests=0;modeStore=1;efuseBusy=0
            regWrite(1024,0x110,(40<<24)|(source<<16));regWrite(1024,0x118,1);regWrite(1024,0x11c,1)
            regWrite(1536,4,0x42);regWrite(1536,0,0x12345678)
            val preparation=nativeBufferAt(memory+2304,192)
            val timeRecord=nativeBufferAt(memory+2344,40)
            if (esp32C5SleepPrepareOwned(preparation,524288,3,2,false,true) != 1 || bad) return 12
            val savedPlan=C5CpuClock(preparation.loadU32(92))
            val uarts=Esp32C5SleepUarts(preparation.loadU32(36))
            if (!uarts.ready() || !esp32C5SleepPrepareTakeOwned(preparation,true) ||
                esp32C5SleepPrepareTakeOwned(preparation,true) || esp32C5SleepPrepareCancelOwned(preparation,true) != 2) return 3
            val cal=esp32C5SleepCalibrationDecode(u32(0x210),u32(0xffffffff),u32(1))
            if (esp32C5SleepConfigApplyOwned(profile,C5SleepPower(0),u32(0x1234),false,false,false,cal,3500000,30000,false,true,117) != 1) return 1
            if (esp32C5SleepAlarmBeginOwned(alarm,0x100000010,16,true) != 1) return 2
            val cache=esp32C5CacheSuspendOwned()
            if (expectedResult == -2) regWrite(512,0x68,regRead(512,0x68)|0x20000000)
            val entryRecord=nativeBufferAt(memory+456,32)
            val entered=if (expectedResult == -1) esp32C5LightSleepEnterOwned(u32(0),0,true) else esp32C5SleepEntryRunOwned(entryRecord,u32(16),0,true)
            if (entered != expectedResult || requests != (if (expectedResult < 0) 0 else 1) || efuseBusy != 0 || bad) return 9
            regWrite(1536,0x28,0xc0000000)
            regWrite(1536,0x14,20)
            recovering=true;fault=failure
            val result=esp32C5SleepRecoveryBeginOwned(record,profile,memory+432,savedPlan,false,entered,true,700,cache|0,uarts|0,true,if (expectedResult == -1) 0 else memory+456,memory+2344)
            // Rejected-before-configuration paths leave the original mask
            // already restored, so a dropped identical restore is harmless.
            if (result != (if (failure == 0 || failure == 5 && (expectedResult == -1 || expectedResult == -2) || failure == 6 && expectedResult != 0) 1 else 3) || bad) return 4
            if (esp32C5SleepRecoveryContinueOwned(record,true) != 1 || bad || cacheResumes != 1 || predictorRestores != 1 || alarm.loadU32(16) != 1 || regRead(1536,0) != 0x12345678 || regRead(1536,4) != 0x42 || regRead(1536,0x28) != 0x40000000) return 5
            if (regRead(1792,0x3c) != 0 || regRead(1792,0x13c) != 0 || profile.loadU32(4) != 4) return 6
            if (source == 1 && ((regRead(512,0xac)&0x40000000) == 0 || rcGate != 0x80000000)) return 7
            if (esp32C5SleepRecoveryContinueOwned(record,true) != 1 || cacheResumes != 1) return 8
            if (int(i32(record.loadU32(28))) != expectedResult) return 10
            if (expectedResult != -1 && (entryRecord.loadU32(4) != 4 || regRead(512,0x12c) != 0 || regRead(512,0x128) != 0 || modeStore != 1)) return 11
            if (timeRecord.loadU32(4) != 3 || timeLoads != (if (expectedResult == 0) 1 else 0) || expectedResult == 0 && timeLow != u32(1920)) return 13
            failure=failure+1
        }
        mode=mode+1
    }
    return 0
}
