// Offline tests; run after both P4 console ELFs have been built and packaged.
//
//     tools/abla-tool tests/p4-console-image-test.ab [BUILD_DIR]
//
// BUILD_DIR (default "build", relative to the working directory) holds
// p4-internal-console/layout-<n>/application.{elf,bin} for layouts 1 and 3.

import "abla/io"
import "abla/text"
import "abla/crypto"
import "abla/process/arguments"
import "../tools/check-p4-console-image.ab"

var failures = 0

fun expectRejected(error: string, label: string): void {
    if (error == "") {
        println("FAIL accepted: $label")
        failures = failures + 1
    }
}

fun expectMessage(error: string, part: string, label: string): void {
    if (error == "" || !error.contains(part)) {
        println("FAIL $label: expected a rejection mentioning \"$part\", got \"$error\"")
        failures = failures + 1
    }
}

fun flipped(data: string, offset: int): string = elfWithByte(data, offset, data[offset] ^ 1)

fun main: int {
    val build = if (processArgumentCount() >= 1) processArgument(0) else "build"
    var checks = 0
    for (layout in [1, 3]) {
        val prefix = "$build/p4-internal-console/layout-$layout/application"
        val elfFile = readBinaryFile(prefix + ".elf")
        val imageFile = readBinaryFile(prefix + ".bin")
        if (elfFile.error != "" || imageFile.error != "") {
            println("FAIL cannot read ${prefix}.elf/.bin")
            return 1
        }
        val elf = elfFile.data
        val image = imageFile.data
        val verdict = validateConsoleImage(elf, image, layout)
        if (verdict != "") {
            println("FAIL layout $layout rejected: $verdict")
            return 1
        }
        expectRejected(validateConsoleImage(elf, image, 4 - layout), "the other layout")
        var length = 0
        while (length < image.size) {
            expectRejected(validateConsoleImage(elf, image.slice(0, length), layout), "image truncated to $length")
            length = length + 1
        }
        for (offset in [0, 1, 4, 12, 15, 17, 23, 24, 28, 32, image.size - 33, image.size - 1]) {
            expectRejected(validateConsoleImage(elf, flipped(image, offset), layout), "image bit flipped at $offset")
            checks = checks + 1
        }
        // A validly checksummed but changed payload must fail ELF equivalence.
        var corrupt = flipped(image, 32)
        corrupt = flipped(corrupt, corrupt.size - 33)
        corrupt = corrupt.slice(0, corrupt.size - 32) + sha256(corrupt.slice(0, corrupt.size - 32))
        expectMessage(validateConsoleImage(elf, corrupt, layout), "differ from ELF", "re-checksummed payload")
        expectRejected(validateConsoleImage(elf, image + elfNul(), layout), "trailing byte")
        // A moved reservation must fail even if no bytes are loaded there.
        val phoff = elfU32(elf, 28)
        val count = elfU16(elf, 44)
        var moved = ""
        var index = 0
        while (index < count && moved == "") {
            val header = phoff + index * 32
            if (elfU32(elf, header) == 1 && elfU32(elf, header + 16) == 0 && elfU32(elf, header + 20) != 0) {
                moved = elfWithU32(elfWithU32(elf, header + 8, 0x4ff30000), header + 12, 0x4ff30000)
            }
            index = index + 1
        }
        if (moved == "") {
            println("FAIL missing stack reservation in fixture")
            return 1
        }
        expectMessage(validateConsoleImage(moved, image, layout), "outside selected RAM", "moved reservation")
        checks = checks + length + 4
    }
    if (failures != 0) return 1
    println("PASS: console image validator accepted both layouts and rejected $checks corruptions")
    0
}
