import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/power/axp192_device.ab"
import "../src/power/axp2101_device.ab"
import "../src/power/bq27220_device.ab"
import "../src/power/m5pm1_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_battery_voltage_target")
trusted fun batteryTarget(device: int,kind: int): I2cWordResult =
    if (kind == 0) Axp192(device).batteryMillivoltsChecked() else
    if (kind == 1) Axp2101(device).batteryMillivoltsChecked() else
    if (kind == 2) Bq27220(device).batteryMillivoltsChecked() else
    if (kind == 3) M5Pm1(device).batteryMillivoltsChecked() else I2cWordResult(0)
