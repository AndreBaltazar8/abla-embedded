import "../src/m5stack/es8311_playback_s3_sequence.ab"
import "../src/esp32/gdma_ring_esp32s3.ab"
import "../src/m5stack/es8311_playback_prepare_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun pin(n: int): Pin = Pin(n)
type Es8311=int
type M5Ioe1=int
type M5Pm1=int
fun M5Pm1.valid(): bool = this == 4
fun Es8311.valid(): bool = this == 2
fun M5Ioe1.valid(): bool = this == 3
type Esp32S3StandardDmaPreparation=int
fun Esp32S3StandardDmaPreparation.valid(): bool = (this&255) == 1
fun Esp32S3StandardDmaPreparation.sampleRate(): int = this>>>8
type Esp32S3GdmaPumpResult=int
fun Esp32S3GdmaPumpResult.status(): int = this&255
fun Esp32S3GdmaPumpResult.transferredBytes(): int = (this>>>8)&4095
fun Esp32S3GdmaPumpResult.nextIndex(): int = (this>>>20)&4095
var board=m5BoardStickS3
var bad=false
var prepareResult=1
var enableResult=1
var disableResult=1
var startResult=1
var stopResult=1
var restoreResult=2
var pumpStatus=1
var shortBlock=false
var starts=0
var stops=0
var enables=0
var disables=0
var restores=0
var reads=0
fun esp32s3I2sPinsValid(port: int,tx: bool,m: Pin,b: Pin,w: Pin,d: Pin,flags: int): bool {
    val p=board.speakerProfile()
    return port == board.speakerProfile().port() && tx && m == Pin(p.masterClockPin()) && b == Pin(p.bitClockPin()) &&
        w == Pin(p.wordSelectPin()) && d == Pin(p.dataPin()) && flags == 0
}
trusted fun esp32S3I2sPinsCaptureOwned(r: NativeBuffer,port: int,tx: bool,m: Pin,b: Pin,w: Pin,d: Pin,flags: int,exclusive: bool): int {
    if (!exclusive || !esp32s3I2sPinsValid(port,tx,m,b,w,d,flags)) bad=true
    r.storeU32(0,1);r.storeU32(4,3);return 1
}
trusted fun esp32S3I2sPinsCloseOwned(r: NativeBuffer,exclusive: bool): int {
    if (!exclusive || r.loadU32(0) != 1) bad=true
    restores=restores+1;return restoreResult
}
fun esp32s3PrepareStandard16Dma(port: int,tx: bool,m: Pin,b: Pin,w: Pin,d: Pin,slots: int,hz: int,
    channel: int,desc: int,count: int,payload: int,bytes: int,owner: u32,duplicateMono: bool): Esp32S3StandardDmaPreparation {
    if (!esp32s3I2sPinsValid(port,tx,m,b,w,d,0) || slots != 3 || duplicateMono == board.speakerProfile().stereo() || hz != 16000 || channel != 2 ||
        desc != 0x3fc88000 || count != 2 || payload != 0x3fc90000 || bytes != 16 || owner != u32(7)) bad=true
    return Esp32S3StandardDmaPreparation(prepareResult|(16000<<8))
}
fun M5BoardId.es8311SpeakerOwned(codec: Es8311,power: M5Pm1,io: M5Ioe1,enabled: bool,exclusive: bool): int {
    if (this != board || codec != Es8311(2) || power != M5Pm1(4) || !exclusive) bad=true
    if (enabled) { enables=enables+1;return enableResult }
    disables=disables+1;return disableResult
}
fun esp32s3I2sStartStream(port: int,tx: bool,channel: int,desc: int,polls: int): int {
    if (port != board.speakerProfile().port() || !tx || channel != 2 || desc != 0x3fc88000 || polls != 1 || enables != 1) bad=true
    starts=starts+1;return startResult
}
fun esp32s3I2sStopStream(port: int,tx: bool,channel: int,polls: int): int {
    if (port != board.speakerProfile().port() || !tx || channel != 2 || polls != 1 || disables != 0 || restores != 0) bad=true
    stops=stops+1;return stopResult
}
fun esp32s3GdmaPumpBlock(channel: int,tx: bool,desc: int,count: int,index: int,buffer: NativeBuffer,bytes: int,polls: int): Esp32S3GdmaPumpResult {
    if (channel != 2 || !tx || desc != 0x3fc88000 || count != 2 || bytes != 16 || polls != 1 || buffer.capacity() != 16) bad=true
    reads=reads+1
    return Esp32S3GdmaPumpResult(pumpStatus|((if (shortBlock) 8 else 16)<<8)|((if (pumpStatus == 1) 1-index else index)<<20)|(257<<32))
}
trusted fun esp32s3GdmaWrite(address: int,value: int): void { return }
trusted fun esp32s3GdmaPublish(): void { return }
val storage=nativeStaticAllocate(136)
val outputStorage=nativeStaticMutableU32s([0,0,0,0])
trusted fun reset(r: NativeBuffer): void {
    var i=0
    while (i < 136) { r.storeU32(i,0);i=i+4 }
    prepareResult=1;enableResult=1;disableResult=1;startResult=1;stopResult=1;restoreResult=2;pumpStatus=1;shortBlock=false
    starts=0;stops=0;enables=0;disables=0;restores=0;reads=0;return
}
trusted fun begin(r: NativeBuffer): int = board.beginEs8311PlaybackOwned(r,16000,2,0x3fc88000,2,0x3fc90000,16,u32(7),Es8311(2),M5Pm1(4),M5Ioe1(3),true)
@export("abla_board_es8311_playback_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(storage,136);val output=nativeBufferAt(outputStorage,16)
    var b=0
    while (b < 6) {
        board=if (b == 0) m5BoardStickS3 else if (b == 1) m5BoardStopWatch else if (b == 2) m5BoardChainCaptain else if (b == 3) m5BoardCardputerADV else if (b == 4) m5BoardAtomVoiceS3R else m5BoardPaperColor
        reset(r)
        if (begin(r) != 1 || enables != 0 || starts != 0 || begin(r) != 0 || m5Es8311PlaybackStartOwned(r,1,true) != 2) return i32(1)
        var n=0
        while (n < 5) {
            pumpStatus=3
            if (m5Es8311PlaybackWriteOwned(r,output,1,true).status() != 3 || r.loadU32(44) != (n&1)) return i32(2)
            pumpStatus=1
            if (m5Es8311PlaybackWriteOwned(r,output,1,true).status() != 1 || r.loadU32(44) != ((n+1)&1) || r.loadU32(72) != 257) return i32(3)
            n=n+1
        }
        val before=reads
        if (m5Es8311PlaybackWriteOwned(r,nativeBufferAt(storage+132,16),1,true).status() != 2 ||
            m5Es8311PlaybackWriteOwned(r,nativeBufferAt(0x3fc90010,16),1,true).status() != 2 || reads != before) return i32(4)
        stopResult=5
        if (m5Es8311PlaybackCloseOwned(r,1,true) != 3 || disables != 0 || restores != 0) return i32(5)
        stopResult=1;disableResult=773
        if (m5Es8311PlaybackCloseOwned(r,1,true) != 3 || stops != 2 || restores != 0 || r.loadU32(56) != 773) return i32(6)
        disableResult=1;restoreResult=3
        if (m5Es8311PlaybackCloseOwned(r,1,true) != 3 || stops != 2 || disables != 2) return i32(7)
        restoreResult=2
        if (m5Es8311PlaybackCloseOwned(r,1,true) != 4 || m5Es8311PlaybackCloseOwned(r,1,true) != 4 || stops != 2 || disables != 2 || restores != 2) return i32(8)
        reset(r);prepareResult=13
        if (begin(r) != 3 || m5Es8311PlaybackCloseOwned(r,1,true) != 4 || starts != 0 || stops != 0 || disables != 0 || restores != 1) return i32(9)
        reset(r);enableResult=773
        if (begin(r) != 1 || m5Es8311PlaybackStartOwned(r,1,true) != 3 || starts != 0 || m5Es8311PlaybackCloseOwned(r,1,true) != 4 || stops != 0 || disables != 1) return i32(10)
        reset(r);startResult=1288
        if (begin(r) != 1 || m5Es8311PlaybackStartOwned(r,1,true) != 3 || r.loadU32(60) != 1288 || m5Es8311PlaybackCloseOwned(r,1,true) != 4 || stops != 1 || disables != 1) return i32(11)
        reset(r)
        if (begin(r) != 1 || m5Es8311PlaybackStartOwned(r,1,true) != 2) return i32(12)
        shortBlock=true
        if (m5Es8311PlaybackWriteOwned(r,output,1,true).status() != 8 || r.loadU32(4) != 3 ||
            m5Es8311PlaybackWriteOwned(r,output,1,true).status() != 2 || reads != 1 || m5Es8311PlaybackCloseOwned(r,1,true) != 4) return i32(13)
        if (bad) return i32(14)
        b=b+1
    }
    return i32(0)
}
