import "../src/esp32/i2c_esp32s3.ab"
import "../src/rtc/pcf8563_device.ab"
import "../src/rtc/rx8130_device.ab"
import "../src/rtc/powerhub_device.ab"
import "../src/m5stack/rtc_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_partial_target")
trusted fun partialTarget(handle: int,value: int,model: int,date: bool,full: bool,bytes: NativeBuffer,buffered: bool): bool {
    if (model < 0 || model > 2) return false
    if (buffered) {
        val rtc=M5Rtc(((model+1)<<32) | (handle & 0xFFFFFFFF))
        if (full) return rtc.setDateTimeWithBuffer(RtcDateTime(value),bytes)
        if (date) return rtc.setDateWithBuffer(RtcDate(value),bytes)
        return rtc.setTimeWithBuffer(RtcTime(value),bytes)
    }
    if (full) {
        if (model == 0) return Pcf8563(handle).setDateTime(RtcDateTime(value))
        if (model == 1) return Rx8130(handle).setDateTime(RtcDateTime(value))
        return PowerHubRtc(handle).setDateTime(RtcDateTime(value))
    }
    if (model == 0) return if (date) Pcf8563(handle).setDate(RtcDate(value)) else Pcf8563(handle).setTime(RtcTime(value))
    if (model == 1) return if (date) Rx8130(handle).setDate(RtcDate(value)) else Rx8130(handle).setTime(RtcTime(value))
    if (date) PowerHubRtc(handle).setDate(RtcDate(value)) else PowerHubRtc(handle).setTime(RtcTime(value))
}
