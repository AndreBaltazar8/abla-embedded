import "../src/esp32/mspi_clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_mspi_clock_target")
@section(".iram1.abla.s3MspiClockTarget")
trusted fun mspiClockTarget(core: int,flash: int,psram: int,both: bool): bool {
    val saved=esp32S3MspiClockCaptureOwned(psram != 0)
    val result=esp32S3MspiClocksOwned(core,flash,psram,both)
    esp32S3MspiClockRestoreOwned(saved)
    result
}
