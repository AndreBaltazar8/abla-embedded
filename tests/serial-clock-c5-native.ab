import "../src/esp32/uart/clock_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var expectedUnit=0
var bus=0
var clock=0
var local=0
var writes=0
var drop=0
var busy=false
var bad=false
fun checkUnit(unit: int): void { if (unit != expectedUnit) bad=true;return }
fun c5SerialBusRead(unit: int): int { checkUnit(unit);return bus }
fun c5SerialClockRead(unit: int): int { checkUnit(unit);return clock }
fun c5SerialBusWrite(unit: int,value: int): void {
    checkUnit(unit);writes=writes+1
    if ((value&~1) != (bus&~1)) bad=true
    if (writes != drop) bus=value
    return
}
fun c5SerialClockWrite(unit: int,value: int): void {
    checkUnit(unit);writes=writes+1
    if ((value&~0x400000) != (clock&~0x400000)) bad=true
    if (writes != drop) clock=value
    return
}
fun c5SerialRead(unit: int,offset: int): int {
    checkUnit(unit)
    if ((bus&5) != 5) bad=true
    if (offset == 136) return local
    if (offset == 28) return if (busy) 65536 else 0
    if (offset == 12 || offset == 112 || offset == 152) return 0
    bad=true;return 0
}
fun c5SerialConfigWrite(unit: int,offset: int,value: int): void {
    checkUnit(unit);writes=writes+1
    if ((bus&5) != 5 || offset != 136 || (value&~0x3000000) != (local&~0x3000000)) bad=true
    if (writes != drop) local=value
    return
}
fun c5SerialWriteFifo(unit: int,value: int): void { bad=true;return }
@export("abla_serial_clock_c5_test")
trusted fun testClocks(): int {
    var scenario=0
    while (scenario < 384) {
        expectedUnit=scenario%2
        val source=(scenario/2)%3;val gates=(scenario/6)%16;val fault=scenario/96
        val originalBus=0x80000004|(gates&1)
        val originalClock=0x80012345|(source<<20)|((gates&2)<<21)
        val originalLocal=0x40000000|((gates&12)<<22)
        bus=originalBus;clock=originalClock;local=originalLocal;writes=0;drop=fault;busy=false;bad=false
        var owner=c5UartClockOpenOwned(expectedUnit,source,true,3)
        if (bad || (fault == 0 && (!owner.ready() || (bus&1) == 0 ||
            (clock&0x400000) == 0 || (local&0x3000000) != 0x3000000))) return 1
        if (owner.ready() && (owner&3840) != 0) {
            busy=true
            val oldWrites=writes
            val blocked=owner.closeOwned(true)
            if (blocked.status() != 8 || writes != oldWrites) return 2
            busy=false
        }
        // Drop the next close write once, then retry the retained replacement.
        drop=writes+1
        owner=owner.closeOwned(true)
        drop=0
        owner=owner.closeOwned(true)
        if (owner.status() != 0 || bus != originalBus || clock != originalClock || local != originalLocal || bad) return 3
        val closedWrites=writes
        if (owner.closeOwned(true).status() != 0 || writes != closedWrites) return 4
        scenario=scenario+1
    }
    expectedUnit=0;bus=0;clock=0;local=0;writes=0;drop=0
    var owner=c5UartClockOpenOwned(0,0,true,3)
    if (owner.status() != 5 || writes != 1 || bad) return 5
    owner=owner.closeOwned(true)
    if (owner.status() != 0 || bus != 0 || bad) return 6
    bus=6;writes=0
    if (c5UartClockOpenOwned(0,0,true,3).status() != 3 || writes != 0) return 7
    bus=4;clock=3<<20
    if (c5UartClockOpenOwned(0,0,true,3).status() != 3 || writes != 0) return 8
    if (c5UartClockOpenOwned(2,0,true,3).status() != 2 ||
        c5UartClockOpenOwned(0,0,false,3).status() != 2 || writes != 0) return 9
    return 0
}
