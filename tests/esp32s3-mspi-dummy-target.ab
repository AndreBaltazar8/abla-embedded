import "../src/esp32/mspi_dummy_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_mspi_dummy_target")
@section(".iram1.abla.s3DummyTarget")
trusted fun dummyTarget(kind: int,port: int,baseline: int,extra: int): bool {
    if (kind == 4) {
        val change=esp32S3QuadFlashDummyApplyOwned(port,baseline,0,extra)
        return esp32S3QuadFlashDummyRestoreOwned(change)
    }
    val saved=esp32S3MspiDummyCaptureOwned(kind,port)
    val result=esp32S3MspiDummySetOwned(kind,port,baseline,extra)
    esp32S3MspiDummyRestoreOwned(saved)
    result
}
