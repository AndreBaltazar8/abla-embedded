import "../src/esp32/cache_suspend_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var iword=0
var dword=0
var phase=0
var polls=0
var delay=0
var bad=false
fun esp32S3CacheRomSuspend(instruction: bool): int {
    if (phase != (if (instruction) 0 else 2)) bad=true
    phase=phase+1; polls=0
    if (instruction) iword else dword
}
fun esp32S3CacheSuspendRead(address: int): int {
    if (address != 0x600C4130 || (phase != 1 && phase != 3)) bad=true
    polls=polls+1
    val instruction=phase == 1
    if (polls > delay) { phase=phase+1; return if (instruction) 1 else 4096 }
    // Other cache being idle must not satisfy this cache's poll.
    if (instruction) 4096 else 1
}
fun esp32S3CacheRomResume(instruction: bool,state: int): void {
    if (phase != (if (instruction) 4 else 5) || state != (if (instruction) iword else dword)) bad=true
    phase=phase+1; return
}
@export("abla_cache_suspend_test")
trusted fun suspendTest(): i32 {
    var bit=0
    while (bit < 32) {
        delay=0
        while (delay < 8) {
            iword=1<<bit; dword=0xFFFFFFFF ^ iword
            phase=0; bad=false
            val saved=esp32S3CachesSuspendOwned()
            if (phase != 4 || ((saved | 0) & 0xFFFFFFFF) != iword || ((saved | 0)>>>32) != dword) return i32(1)
            esp32S3CachesResumeOwned(saved)
            if (phase != 6 || bad) return i32(2)
            delay=delay+1
        }
        bit=bit+1
    }
    i32(0)
}
