import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/rtc_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_m5_rtc_target")
trusted fun rtcTarget(bus: I2cBus,board: M5BoardId,handle: M5Rtc,mode: int,value: RtcDateTime): bool {
    if (mode == 0) return m5Rtc(bus,board).valid()
    if (mode == 1) return handle.begin()
    if (mode == 2) return handle.close()
    if (mode == 3) return handle.dateTime().valid()
    if (mode == 4) return handle.date().valid()
    if (mode == 5) return handle.time().valid()
    if (mode == 6) return handle.setDateTime(value)
    if (mode == 7) return handle.setDate(value.date())
    if (mode == 8) return handle.lowVoltageChecked().valid()
    if (mode == 9) return handle.interruptPendingChecked().valid()
    if (mode == 10) return handle.clearInterrupt()
    if (mode == 11) return handle.disableInterrupts()
    handle.setTime(value.time())
}
