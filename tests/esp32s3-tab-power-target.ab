import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/tab_power.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_tab_power_target")
trusted fun powerTarget(owner: M5Expanders,monitor: Ina226,configureMonitor: bool): int =
    if (configureMonitor) owner.configureTabCurrentMonitor(monitor) | 0 else owner.configureTabPower() | 0
