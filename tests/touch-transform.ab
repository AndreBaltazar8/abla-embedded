import "../src/touch/transform.ab"

fun main(): int {
    val corner = touchPoint(319, 0, 7, 2)
    val clockwise = corner.rotated(320, 240, 1)
    if (!clockwise.valid() || clockwise.x() != 239 || clockwise.y() != 319 ||
        clockwise.id() != 7 || clockwise.event() != 2) return 1
    var y = 0
    while (y < 13) {
        var x = 0
        while (x < 20) {
            val point = touchPoint(x, y, (x + y) & 15, (x + y) & 3)
            val once = point.rotated(20, 13, 1)
            val twice = once.rotated(13, 20, 1)
            val thrice = twice.rotated(20, 13, 1)
            val full = thrice.rotated(13, 20, 1)
            if (full != point || twice != point.rotated(20, 13, 2) ||
                thrice != point.rotated(20, 13, 3) || !once.inside(13, 20)) return 2
            if (point.mirrored(20, 13, true, false).mirrored(20, 13, true, false) != point ||
                point.mirrored(20, 13, false, true).mirrored(20, 13, false, true) != point ||
                point.mirrored(20, 13, true, true) != twice) return 3
            x = x + 1
        }
        y = y + 1
    }
    if (corner.rotated(320, 240, -1).valid() || corner.rotated(320, 240, 4).valid() ||
        corner.rotated(319, 240, 0).valid() || corner.mirrored(0, 240, false, false).valid() ||
        corner.rotated(65537, 240, 0).valid() || TouchPoint(0).inside(320, 240)) return 4
    val maximum = touchPoint(4095, 4095, 15, 3).rotated(4096, 4096, 2)
    if (!maximum.valid() || maximum.x() != 0 || maximum.y() != 0 || maximum.id() != 15 || maximum.event() != 3) return 5
    if (touchPoint(0, 0, 0, 0).rotated(1, 1, 3) != touchPoint(0, 0, 0, 0)) return 6
    val wide = touchPoint(65535, 65534, 255, 2, 65535).rotated(65536, 65536, 1)
    if (!wide.valid() || wide.x() != 1 || wide.y() != 65535 || wide.id() != 255 || wide.size() != 65535) return 7
    0
}
