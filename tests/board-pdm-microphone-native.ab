import "../src/m5stack/pdm_microphone_session_s3_sequence.ab"
import "../src/m5stack/pdm_microphone_process_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
type M5Pm1=int
type M5Ioe1=int
fun M5Pm1.valid(): bool = this == 11
fun M5Ioe1.valid(): bool = this == 12
type Esp32S3GdmaPumpResult=int
fun Esp32S3GdmaPumpResult.status(): int = this&255
val dsp=nativeBufferAt(nativeStaticAllocate(40),40)
val reference=nativeBufferAt(nativeStaticAllocate(40),40)
val processed=nativeBufferAt(nativeStaticAllocate(128),128)
val expected=nativeBufferAt(nativeStaticAllocate(128),128)
var readStatus=3
val r=nativeBufferAt(nativeStaticAllocate(152),152)
val output=nativeBufferAt(nativeStaticAllocate(32),32)
var board=m5BoardPaperMono
var powerResult=1
var powerOffResult=1
var startResult=2
var closeResult=4
var reads=0
var starts=0
var powerOn=0
var powerOff=0
var closes=0
var bad=false
var captures=0
var restores=0
var pinClose=2
var prepareResult=1
fun esp32s3PdmPinsCaptureOwned(saved: NativeBuffer,pins: PdmPins,slots: int,slave: bool,exclusive: bool): int {
    if (saved.addressValue() != r.addressValue()+96 || saved.capacity() != 56 || pins != board.microphoneProfile().pdmPins() || slots != 2 || slave || !exclusive) bad=true
    captures=captures+1;saved.storeU32(0,0x50445031);saved.storeU32(4,3);return 1
}
fun esp32s3PdmPinsCloseOwned(saved: NativeBuffer,exclusive: bool): int {
    if (r.loadU32(4) != 4 || r.loadU32(84) != 0 || saved.loadU32(0) != 0x50445031 || !exclusive) bad=true
    restores=restores+1;return pinClose
}
fun esp32s3GdmaRingLayoutValid(desc: int,count: int,payload: int,bytes: int,stride: int): bool = desc == 0x3fc90000 && count == 2 && payload == 0x3fc91000 && bytes == 32 && stride == 32
fun esp32s3PdmSessionStatus(child: NativeBuffer): int = child.loadU32(4)
fun esp32s3PdmSessionBeginOwned(child: NativeBuffer,pins: PdmPins,slots: int,pcm: bool,ds: bool,invert: bool,rate: int,source: int,hz: int,divider: int,channel: int,desc: int,count: int,payload: int,bytes: int,owner: u32,exclusive: bool): int {
    if (child.capacity() != 64 || pins != board.microphoneProfile().pdmPins() || slots != 2 || !pcm || ds || invert || rate != 16000 || source != 2 || hz != 160000000 || divider != 8 || !exclusive) bad=true
    if (captures < 1 || r.loadU32(96) != 0x50445031) bad=true
    if (prepareResult == 0) return 0
    child.storeU32(4,prepareResult);child.storeU32(24,32)
    child.storeU32(12,desc);child.storeU32(16,count);child.storeU32(20,payload);return prepareResult
}
fun paperMonoMicrophonePowerOwned(power: M5Pm1,expander: M5Ioe1,enabled: bool,exclusive: bool): int {
    if (board != m5BoardPaperMono || power != 11 || expander != 12 || !exclusive || r.loadU32(84) != 1) bad=true
    if (enabled) { powerOn=powerOn+1;if (starts != 0) bad=true;return powerResult }
    powerOff=powerOff+1;if (r.loadU32(4) != 4) bad=true;return powerOffResult
}
fun esp32s3PdmSessionStartOwned(child: NativeBuffer,polls: int,exclusive: bool): int {
    starts=starts+1;if (board == m5BoardPaperMono && powerOn != 1) bad=true
    child.storeU32(4,startResult);return startResult
}
fun esp32s3PdmSessionCloseOwned(child: NativeBuffer,polls: int,exclusive: bool): int {
    if (child.loadU32(4) == 4) return 4
    closes=closes+1;child.storeU32(4,closeResult);return closeResult
}
fun esp32s3PdmSessionReadOwned(child: NativeBuffer,buffer: NativeBuffer,polls: int,exclusive: bool): Esp32S3GdmaPumpResult {
    reads=reads+1
    if (readStatus == 1) {
        var n=0;while (n < 16) { buffer.storeU16(n*2,n*4567-32768);n=n+1 }
    } else if (readStatus >= 4) child.storeU32(4,3)
    return Esp32S3GdmaPumpResult(readStatus|(0x155<<32))
}
fun reset(): void {
    var i=0;while (i < 152) { r.storeU32(i,0);i=i+4 }
    captures=0;restores=0;pinClose=2;prepareResult=1
    starts=0;reads=0;closes=0;powerOn=0;powerOff=0;powerResult=1;powerOffResult=1;startResult=2;closeResult=4;return
}
fun begin(): int = board.beginPdmMicrophoneOwned(r,16000,2,0x3fc90000,2,0x3fc91000,32,u32(41),M5Pm1(11),M5Ioe1(12),true)
@export("abla_board_pdm_microphone_test")
fun test(): i32 {
    reset();board=m5BoardCardputer;begin();m5PdmMicrophoneStartOwned(r,4,true)
    var os=1
    while (os <= 8) {
        var format=0
        while (format < 4) {
            val stereo=(format&1) != 0;val bits16=(format&2) != 0
            microphoneProcessInitialize(dsp,os,16,128,false,false,false)
            microphoneProcessInitialize(reference,os,16,128,false,false,false)
            var block=0
            while (block < 3) {
                readStatus=3
                if (m5PdmMicrophoneProcessBlockOwned(r,dsp,output,processed,stereo,bits16,4,true).status() != 3) return i32(16)
                readStatus=1
                val result=m5PdmMicrophoneProcessBlockOwned(r,dsp,output,processed,stereo,bits16,4,true)
                val count=microphoneProcess(reference,output,8,expected,stereo,bits16)
                if (result.status() != 1 || result.samples() != count) return i32(17)
                var n=0
                while (n < count*(if (bits16) 2 else 1)) { if (processed.load(n) != expected.load(n)) return i32(18);n=n+1 }
                n=0;while (n < 40) { if (dsp.load(n) != reference.load(n)) return i32(19);n=n+1 }
                block=block+1
            }
            format=format+1
        }
        os=os+1
    }
    microphoneProcessInitialize(dsp,1,16,0,false,false,false);reads=0
    if (m5PdmMicrophoneProcessBlockOwned(r,dsp,output,nativeBufferAt(processed.addressValue(),1),true,true,4,true).status() != 2 ||
        m5PdmMicrophoneProcessBlockOwned(r,dsp,output,nativeBufferAt(r.addressValue()+128,64),true,true,4,true).status() != 2 ||
        m5PdmMicrophoneProcessBlockOwned(r,dsp,output,nativeBufferAt(0x3fc91020,64),true,true,4,true).status() != 2 || reads != 0) return i32(20)
    readStatus=4
    if (m5PdmMicrophoneProcessBlockOwned(r,dsp,output,processed,true,true,4,true).status() != 4 || m5PdmMicrophoneSessionStatus(r) != 3) return i32(21)
    readStatus=3
    var b=0
    while (b < 4) {
        board=if (b == 0) m5BoardPaperMono else if (b == 1) m5BoardAtomS3U else if (b == 2) m5BoardCardputer else m5BoardCapsule
        reset()
        if (begin() != 1 || begin() != 0 || m5PdmMicrophoneStartOwned(r,4,true) != 2 || powerOn != (if (b == 0) 1 else 0)) return i32(1)
        if ((m5PdmMicrophoneReadOwned(r,nativeBufferAt(r.addressValue()+64,32),4,true)|0) != 2 || reads != 0) return i32(2)
        if ((m5PdmMicrophoneReadOwned(r,nativeBufferAt(r.addressValue()+128,32),4,true)|0) != 2 || reads != 0) return i32(15)
        if ((m5PdmMicrophoneReadOwned(r,output,4,true)|0) != (3|(0x155<<32)) || m5PdmMicrophoneSessionStatus(r) != 2) return i32(3)
        closeResult=3
        if (m5PdmMicrophoneCloseOwned(r,4,true) != 3 || powerOff != 0 || restores != 0) return i32(4)
        closeResult=4;powerOffResult=8
        if (m5PdmMicrophoneCloseOwned(r,4,true) != (if (b == 0) 3 else 4)) return i32(5)
        val prior=closes;powerOffResult=1
        if (m5PdmMicrophoneCloseOwned(r,4,true) != 4 || closes != prior || r.loadU32(84) != 0 || restores != 1 || bad) return i32(6)
        b=b+1
    }
    board=m5BoardPaperMono
    var failure=2
    while (failure <= 8) {
        reset();powerResult=failure
        if (begin() != 1 || m5PdmMicrophoneStartOwned(r,4,true) != 3 || starts != 0 || r.loadU32(88) != failure || r.loadU32(84) != 1) return i32(7)
        if (m5PdmMicrophoneCloseOwned(r,4,true) != 4 || powerOff != 1 || bad) return i32(8)
        failure=failure+1
    }
    reset();startResult=3
    if (begin() != 1 || m5PdmMicrophoneStartOwned(r,4,true) != 3 || m5PdmMicrophoneCloseOwned(r,4,true) != 4 || powerOff != 1 || bad) return i32(9)
    reset();pinClose=3
    if (begin() != 1 || m5PdmMicrophoneStartOwned(r,4,true) != 2 || m5PdmMicrophoneCloseOwned(r,4,true) != 3 || restores != 1) return i32(11)
    val priorStops=closes;val priorOff=powerOff
    pinClose=2
    if (m5PdmMicrophoneCloseOwned(r,4,true) != 4 || closes != priorStops || powerOff != priorOff || restores != 2 || bad) return i32(12)
    reset();prepareResult=3
    if (begin() != 3 || m5PdmMicrophoneCloseOwned(r,4,true) != 4 || restores != 1 || powerOn != 0) return i32(13)
    reset();prepareResult=0
    if (begin() != 0 || r.loadU32(96) != 0 || restores != 0 || r.loadU32(64) != 0) return i32(14)
    reset();board=m5BoardAtomVoice
    if (begin() != 0 || r.loadU32(64) != 0 || starts != 0 || powerOn != 0) return i32(10)
    return i32(0)
}
