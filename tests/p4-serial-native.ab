import "../src/esp32/uart/serial_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var selected=0
var status=0
var fsm=0
var reads=0
var fifoReads=0
var writes=0
var value=-1
var bad=false
fun p4SerialRead(unit: int,offset: int): int {
    reads=reads+1
    if (unit != selected) bad=true
    if (offset == 28) return status
    if (offset == 112) return fsm
    if (offset == 0) { fifoReads=fifoReads+1; return 0x1ab }
    bad=true; return 0
}
fun p4SerialWriteFifo(unit: int,byte: int): void { if (unit != selected) bad=true; writes=writes+1; value=byte; return }
@export("abla_p4_serial_test")
fun testSerial(): i32 {
    while (selected < 5) {
        val port=serial(selected)
        var byte=0
        while (byte < 256) {
            status=127<<16
            if (!port.tryWriteByte(byte+256,1) || value != byte) return i32(1)
            byte=byte+1
        }
        status=128<<16; reads=0; writes=0
        if (port.tryWriteByte(3,4) || reads != 4 || writes != 0) return i32(2)
        status=0; fifoReads=0
        if (port.tryReadByte() != -1 || fifoReads != 0) return i32(3)
        status=1
        if (port.tryReadByte() != 171 || fifoReads != 1) return i32(4)
        status=0; fsm=16; reads=0
        if (port.tryFlush(3) || reads != 6) return i32(5)
        fsm=0
        if (!port.tryFlush(1)) return i32(6)
        status=1<<16; reads=0
        if (port.tryFlush(3) || reads != 3) return i32(7)
        selected=selected+1
    }
    reads=0; writes=0
    if (serial(-1).tryReadByte() != -2 || serial(5).tryWriteByte(1,1) || serial(0).tryFlush(0) ||
        serial(0).tryWriteByte(1,1000001) || reads != 0 || writes != 0 || bad) return i32(8)
    return i32(0)
}
