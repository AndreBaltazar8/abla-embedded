import "../src/esp32/psram/low_s3_sequence.ab"
import "abla/build"
val lowOwner=nativeStaticAllocate(24)
val lowRegisters=nativeStaticAllocate(60)
val lowAddresses=nativeStaticU32s([0x600030ec,0x60003014,0x60002014,0x60003050,0x600030ac,0x600030b0,0x600030c0,0x600030c4,0x600030bc,0x60003018,0x6000301c,0x60002018,0x6000201c,0x600030a8,0x600020a8])
var lowWrites=0
var lowFail=0
var lowBusy=false
var lowBad=false
var lowDummy0=2
var lowDummy1=3
var lowFirst=0
fun s3PsramLowStorageSafe(address: int,length: int): bool = address == lowOwner && length == 24
fun s3FlashLegacyPointer(): int = 0x3fc90000
fun s3FlashDummyByteRead(address: int): int {
    if (address == 0x3fc90018) return lowDummy0
    if (address == 0x3fc90019) return lowDummy1
    lowBad=true;return 0
}
fun s3FlashDummyByteWrite(address: int,value: int): void {
    if (lowWrites == 0) lowFirst=address
    lowWrites=lowWrites+1
    val stored=if (lowWrites == lowFail) value^1 else value
    if (address == 0x3fc90018) lowDummy0=stored else if (address == 0x3fc90019) lowDummy1=stored else lowBad=true
    return
}
fun lowSlot(address: int): int {
    var slot=0
    while (slot < 15) { if (nativeAddressLoadU32(lowAddresses,slot*4) == address) return slot;slot=slot+1 }
    return -1
}
fun s3PsramCsRead(address: int): int {
    if (address == 0x60002000 || address == 0x60003000) return if (lowBusy) 0x40000 else 0
    val slot=lowSlot(address)
    if (slot < 0) { lowBad=true;return 0 }
    return nativeAddressLoadU32(lowRegisters,slot*4)
}
fun s3PsramCsWrite(address: int,value: int): void {
    val slot=lowSlot(address)
    if (slot < 0) { lowBad=true;return }
    if (lowWrites == 0) lowFirst=address
    lowWrites=lowWrites+1
    nativeAddressStoreU32(lowRegisters,slot*4,if (lowWrites == lowFail) value^1 else value)
    return
}
@export("abla_s3_psram_low_test")
fun testPsramLow(): int {
    val r=nativeBufferAt(lowOwner,24)
    var kind=0
    while (kind < 2) {
        val octal=kind == 1;val count=if (octal) 14 else 18
        var failure=0
        while (failure <= count) {
            r.storeU32(0,0);lowWrites=0;lowFirst=0;lowBusy=false;lowBad=false;lowFail=failure
            lowDummy0=2;lowDummy1=3
            var i=0
            while (i < 15) { nativeAddressStoreU32(lowRegisters,i*4,0xa55a5abf);i=i+1 }
            if (s3PsramLowSpeedOwned(r,octal,5,true,true) != (if (failure == 0) 1 else 4) ||
                lowWrites != (if (failure == 0) count else failure) || lowBad) return 1
            if (failure != 0) {
                val phase=if (failure <= 4) 1 else if (failure <= 10) 2 else 3
                if (r.loadU32(4) != phase || r.loadU32(20) != phase*256+4) return 2
                if (!octal) { lowDummy0=17;lowDummy1=19 }
                lowWrites=0;lowFirst=0;lowFail=0
                if (s3PsramLowSpeedOwned(r,octal,6,true,true) != 2 || lowWrites != 0) return 3
                if (s3PsramLowSpeedOwned(r,octal,5,true,true) != 1 || lowFirst !=
                    (if (phase == 1) 0x600030ec else if (phase == 2) 0x600030ac else 0x600030a8)) return 4
            }
            if (r.loadU32(4) != 4 || r.loadU32(20) != 0 || lowDummy0 != 2 || lowDummy1 != 3) return 5
            if (s3PsramCsRead(0x600030ec) != (0xa55a5abf&0xfffffffc) ||
                s3PsramCsRead(0x60003014) != 0x30103 || s3PsramCsRead(0x60002014) != 0x30103 ||
                s3PsramCsRead(0x60003050) != 0x30103 || (s3PsramCsRead(0x600030ac)&0x7ffffff) != 0 ||
                (s3PsramCsRead(0x600030b0)&0x3ffff) != 0 || (s3PsramCsRead(0x600030c0)&0x7ffffff) != 0 ||
                (s3PsramCsRead(0x600030c4)&0x3ffff) != 0 || (s3PsramCsRead(0x600030bc)&30) != 0) return 6
            if (!octal && ((s3PsramCsRead(0x6000301c)&63) != 7 || (s3PsramCsRead(0x6000201c)&63) != 8)) return 7
            if ((s3PsramCsRead(0x600030a8)&30) != 0 || (s3PsramCsRead(0x600020a8)&30) != 0) return 8
            lowWrites=0
            if (s3PsramLowSpeedOwned(r,octal,5,true,true) != 1 || lowWrites != 0 || lowBad) return 9
            failure=failure+1
        }
        kind=kind+1
    }
    r.storeU32(0,0);lowBusy=true;lowWrites=0
    if (s3PsramLowSpeedOwned(r,false,5,true,true) != 3 || lowWrites != 0 || r.loadU32(4) != 1) return 10
    lowBusy=false
    if (s3PsramLowSpeedOwned(r,false,5,false,true) != 2 || s3PsramLowSpeedOwned(r,false,5,true,false) != 2 || lowWrites != 0) return 11
    return 0
}
