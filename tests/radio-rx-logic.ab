import "../src/esp32/radio/rx_esp32_logic.ab"

fun main(): int {
    val validFlags = espDmaDescriptorPackFlags(1600, 128, true, false)
    if (!esp32WifiRxDescriptorFlagsValid(validFlags)) return 1
    if (esp32WifiRxDescriptorFlagsValid(
        espDmaDescriptorPackFlags(1600, 128, true, true)
    )) return 2
    if (esp32WifiRxDescriptorFlagsValid(
        espDmaDescriptorPackFlags(64, 128, true, false)
    )) return 3
    if (esp32WifiRxDescriptorFlagsValid(
        espDmaDescriptorPackFlags(1600, 31, true, false)
    )) return 4
    val signalLengths = 64 | (96 << 12)
    if (esp32WifiRxLegacySignalLength(signalLengths) != 64 ||
        esp32WifiRxHtSignalLength(signalLengths) != 96) return 5
    if (!esp32WifiRxSignalLengthsValid(128, signalLengths)) return 6
    if (esp32WifiRxSignalLengthsValid(96, signalLengths)) return 7
    if (!esp32WifiRxFrameMetadataValid(
        validFlags, 1073479680, signalLengths
    )) return 8
    if (esp32WifiRxFrameMetadataValid(
        validFlags, 4294967265, signalLengths
    )) return 9
    73
}
