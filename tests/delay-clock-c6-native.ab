import "../src/esp32/delay_clock_c6_sequence.ab"
import "abla/build"
var systemWord=0
var cpuWord=0
var reads=0
var writes=0
var ticks=0
var changeAt=0
var bad=false
fun c6DelayClockRead(address: int): int {
    reads=reads+1
    val changed=changeAt != 0 && reads >= changeAt
    if (address == 0x60096110) return (systemWord^(if (changed) 65536 else 0))|0xa8000000
    if (address == 0x60096118) return cpuWord|0x80000000
    bad=true;return 0
}
fun c6DelayClockSetRomTicks(value: int): void { writes=writes+1;ticks=value;return }
@export("abla_delay_clock_c6_test")
trusted fun testDelayClock(): i32 {
    var source=0
    while (source < 4) {
        var rootDiv=1
        while (rootDiv <= 256) {
            var cpuDiv=1
            while (cpuDiv <= 256) {
                var force=0
                while (force < 2) {
                    systemWord=(source<<16)|((rootDiv-1)<<8)|(rootDiv-1)
                    cpuWord=(force<<16)|((cpuDiv-1)<<8)|(cpuDiv-1)
                    reads=0;writes=0;ticks=0
                    val result=esp32C6DelayClockConfigureOwned(40000000,20000000,true)
                    val root=if (source == 0) 40000000 else if (source == 1) 480000000 else 20000000
                    val div=if (source == 1 && cpuDiv == 1 && force == 1) 4 else rootDiv*cpuDiv
                    val valid=source < 3 && root%div == 0 && root/div <= 160000000 && root/div >= 1000000 && (root/div)%1000000 == 0
                    if (result.ready() != valid || writes != (if (valid) 1 else 0) || bad) return i32(1)
                    if (valid && (ticks != root/div/1000000 || result.ticksPerMicrosecond() != ticks)) return i32(2)
                    force=force+1
                }
                cpuDiv=cpuDiv+1
            }
            rootDiv=rootDiv+1
        }
        source=source+1
    }
    systemWord=65536|512;cpuWord=0
    changeAt=3
    while (changeAt <= 5) {
        reads=0;writes=0
        if (esp32C6DelayClockConfigureOwned(0,0,true).status() != 5 || writes != (if (changeAt == 5) 1 else 0)) return i32(3)
        changeAt=changeAt+2
    }
    changeAt=0;reads=0;writes=0
    if (esp32C6DelayClockConfigureOwned(0,0,false).status() != 2 || reads != 0 || writes != 0) return i32(4)
    systemWord=0;cpuWord=0
    if (esp32C6DelayClockConfigureOwned(0,0,true).status() != 3 || esp32C6DelayClockConfigureOwned(40000001,0,true).status() != 4 || writes != 0) return i32(5)
    return i32(0)
}
