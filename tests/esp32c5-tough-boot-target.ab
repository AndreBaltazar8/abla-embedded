// Actual C5 peripheral + GPIO graph. Callable after startup/clock/ownership
// prerequisites, not a bootable firmware or proof of physical board behavior.
import "../src/esp32/i2c_esp32c5.ab"
import "../src/esp32/peripheral_delay_esp32c5.ab"
import "../src/m5stack/tough_boot_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_tough_boot_target")
trusted fun bootTarget(owner: M5Expanders,pmic: M5PmicOpen,presence: Pm1BatteryPresence,now: int): M5ToughBoot =
    owner.configureToughPower(pmic,presence,now)
