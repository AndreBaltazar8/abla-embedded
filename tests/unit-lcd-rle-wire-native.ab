import "./unit-lcd-wire-native.ab"
@export("abla_unit_lcd_rle_wire_test")
trusted fun testLcdRleWire(): i32 {
    wireSeed();extraAddress=62;extraCanRead=true;extraReadValue=255
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val device=control.session().bus().device(62,100000)
    val source=nativeBufferAt(lcdMemory,1024);val scratch=nativeBufferAt(lcdMemory+1024,721)
    val e=nativeBufferAt(oledExpected,16384);val captured=nativeBufferAt(extraWire,8192)
    var variant=0
    while (variant < 5) {
        val width=if (variant < 3) variant+1 else if (variant == 3) 135 else 240
        val stride=width*2+3;val rotation=if (width == 240) 1 else 0
        var at=0;while (at < 1024) { source.store(at,165);at=at+1 }
        var pixel=0
        while (pixel < width) {
            source.store(pixel*2,205);source.store(pixel*2+1,171)
            source.store(stride+pixel*2,pixel*73);source.store(stride+pixel*2+1,pixel)
            pixel=pixel+1
        }
        expectedCount=0;var row=0
        while (row < 2) {
            expectedPages=row;expectedStage=3
            lcdExpectStart(124);expectByte(9);lcdExpectStart(125)
            expectedStage=5;lcdExpectStart(124);expectByte(42);expectByte(0);expectByte(width-1);expectByte(43);expectByte(5+row);expectByte(5+row)
            expectedStage=6;lcdExpectStart(124);expectByte(74)
            if (row == 0) { expectByte(width);expectByte(205);expectByte(171) }
            else {
                if (width >= 3) { expectByte(0);expectByte(width) }
                pixel=0;while (pixel < width) {
                    if (width < 3) expectByte(1)
                    expectByte(pixel*73);expectByte(pixel);pixel=pixel+1
                }
            }
            row=row+1
        }
        var failure=0
        while (failure <= expectedCount) {
            var commit=0
            while (commit < 2) {
                val before=ackCount;extraCount=0;nackAfterCommit=commit == 1
                nackAt=if (failure == 0) 0 else before+failure
                val result=device.unitLcdWrite16(0,5,width,2,rotation,source,stride,scratch,1,true)
                val expected=if (failure == 0) 513 else e.load((failure-1)*4+2)|(e.load((failure-1)*4+3)<<8)
                // The model retains the full transaction index even when its
                // byte-sized capture index wraps on long literal packets.
                val failedIndex=if (failure == 0) 0 else if (failure > 27 && width >= 3) failure-26 else e.load((failure-1)*4)
                val accepted=if (failure == 0) expectedCount else failure-1+(if (commit == 1 && failedIndex > 1) 1 else 0)
                if (result != expected || ackCount-before != (if (failure == 0) expectedCount else failure) || extraCount != accepted || bad || mode != 0) return i32(2)
                at=0;while (at < accepted) {
                    if (captured.load(at*2) != e.load(at*4) || captured.load(at*2+1) != e.load(at*4+1)) return i32(3)
                    at=at+1
                }
                at=0;while (at < 1024) {
                    val original=if (at < width*2) (if (at%2 == 0) 205 else 171) else if (at >= stride && at < stride+width*2) (if ((at-stride)%2 == 0) (((at-stride)/2*73)&255) else (at-stride)/2) else 165
                    if (source.load(at) != original) return i32(4)
                    at=at+1
                }
                commit=commit+1
            }
            failure=failure+1
        }
        variant=variant+1
    }
    nackAt=0;nackAfterCommit=false
    if (!device.close() || !control.closeOwned(true) || pads != 0 || bad) return i32(5)
    return i32(0)
}
