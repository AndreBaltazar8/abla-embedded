import "../src/m5stack/cores3_display_spi.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun cores3HardwareDisplayTarget(gateAddress: u32, panel: i32): int =
    m5BoardStackCoreS3.beginCoreS3SpiDisplay(peripheralGateAt(int(gateAddress)),u32(41),int(panel))
#exportFunction("cores3HardwareDisplayTarget", "abla_s3_cores3_hardware_display_test")
