import "../src/display/spi_control_c5_sequence.ab"
import "../src/m5stack/tough_display_view.ab"
import "abla/runtime/scalar"
import "abla/build"
val gateMemory=nativeStaticAllocate(4)
val madctls=nativeStaticU32s([0,100,212,176,144,32,68,244])
val commands=nativeStaticU32s([16,17,32,33,40,41,56,57])
var calls=0
var failure=0
var expectedMadctl=0
var inversion=false
var bad=false
var control=0
var expectedWait=0
var delays=0
fun c5LcdProgramAdmission(master: int,dc: int): bool = master == 123 && dc == 26
trusted fun c5LcdProgramCommand(master: int,dc: int,command: int,data: NativeBuffer,bytes: int,polls: int): SpiBufferResult {
    if (peripheralGateAt(gateMemory).tryBegin(u32(8)) != 1 || polls != 4) bad=true
    if (control == 0) {
        if (command != (if (calls == 0) 58 else if (calls == 1) 54 else if (inversion) 33 else 32) ||
            bytes != (if (calls < 2) 1 else 0)) bad=true
        if (calls < 2 && data.load(0) != (if (calls == 0) 85 else expectedMadctl)) bad=true
    } else if (command != control || bytes != 0) bad=true
    calls=calls+1
    return SpiBufferResult(((if (calls == failure) 6 else 1)<<56)|257)
}
fun peripheralDelayMilliseconds(ms: int): void {
    if (ms != expectedWait || peripheralGateAt(gateMemory).tryBegin(u32(8)) != 1) bad=true
    delays=delays+1;return
}
@export("abla_spi_control_c5_test")
trusted fun test(): int {
    val gate=peripheralGateAt(gateMemory)
    var rotation=0
    while (rotation < 8) {
        val internal=((rotation+3)&3)|(rotation&4)
        val view=toughDisplayView(rotation)
        if (view.width() != (if ((internal&1) == 0) 320 else 240) ||
            view.height() != (if ((internal&1) == 0) 240 else 320) ||
            view.madctl() != (nativeAddressLoadU32(madctls,internal*4)|8)) return 1
        var options=0
        while (options < 4) {
            expectedMadctl=nativeAddressLoadU32(madctls,internal*4)|(if ((options&1) != 0) 8 else 0)
            inversion=(options&2) != 0;failure=0
            while (failure <= 3) {
                nativeAddressStoreU32(gateMemory,0,0);calls=0;bad=false
                val result=esp32C5LcdConfigureRgb565(123,gate,u32(7),26,lcdGeometry(320,240),internal,(options&1) != 0,inversion,4)
                if (result.status() != (if (failure == 0) 1 else 6) ||
                    calls != (if (failure == 0) 3 else failure) || bad) return 2
                failure=failure+1
            }
            options=options+1
        }
        rotation=rotation+1
    }
    var index=0
    while (index < 8) {
        control=nativeAddressLoadU32(commands,index*4)
        var wait=0
        while (wait < 4) {
            expectedWait=if (wait == 0) 0 else if (wait == 1) 120 else if (wait == 2) 254 else 500
            failure=0
            while (failure <= 1) {
                nativeAddressStoreU32(gateMemory,0,0);calls=0;bad=false;delays=0
                val result=esp32C5LcdControl(123,gate,u32(7),26,control,expectedWait,4)
                if (result.status() != (if (failure == 0) 1 else 6) ||
                    delays != (if (failure == 0 && expectedWait > 0) 1 else 0) || calls != 1 || bad) return 3
                failure=failure+1
            }
            wait=wait+1
        }
        index=index+1
    }
    calls=0
    if (esp32C5LcdConfigureRgb565(123,gate,u32(7),26,lcdGeometry(320,240),8,true,true,4).status() != 3 ||
        esp32C5LcdControl(123,gate,u32(7),26,44,0,4).status() != 3 ||
        esp32C5LcdControl(123,gate,u32(7),26,17,255,4).status() != 3 || calls != 0 ||
        toughDisplayView(-1) != u64(0) || toughDisplayRotation(8) != -1) return 4
    return 0
}
