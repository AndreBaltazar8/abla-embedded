import "../src/esp32/cache_suspend_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_cache_suspend_target")
@section(".iram1.abla.s3CacheSuspendTarget")
trusted fun suspendTarget(): void {
    val saved=esp32S3CachesSuspendOwned()
    esp32S3CachesResumeOwned(saved)
    return
}
