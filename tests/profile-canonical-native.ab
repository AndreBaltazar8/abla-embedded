import "../src/m5stack/speaker_profile.ab"
import "../src/m5stack/microphone_profile.ab"
import "../src/m5stack/touch_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
fun profileMatchesConstructor(raw: int): bool {
    val s=M5SpeakerProfile(raw);val m=M5MicrophoneProfile(raw);val t=M5TouchProfile(raw)
    val speaker=m5SpeakerProfile(s.transport(),s.dataPin(),s.wordSelectPin(),s.bitClockPin(),s.masterClockPin(),s.port(),s.stereo(),s.gain(),s.sampleRate(),s.dacZeroLevel())
    val mic=m5MicrophoneProfile(m.transport(),m.dataPin(),m.wordSelectPin(),m.bitClockPin(),m.masterClockPin(),m.port(),m.channel(),m.gain(),m.oversampling(),m.sampleRate())
    val touch=m5TouchProfile(t.kind(),t.address(),t.interruptNumber(),t.sdaNumber(),t.sclNumber(),t.port(),t.rawWidth(),t.rawHeight(),t.rotationOffset())
    return s.available() == (speaker != 0 && speaker == s) && m.available() == (mic != 0 && mic == m) && t.valid() == (touch != 0 && touch == t) &&
        (m.available() || (!m.pdmPins().valid() && m.pdmSlotMask() == 0)) && (t.valid() || t.frequency() == 0)
}
@export("abla_profile_canonical_test")
fun testCanonical(): i32 {
    var state=u64(1234567);var index=0
    while (index < 100000) {
        state=state*u64(6364136223846793005)+u64(1442695040888963407)
        if (!profileMatchesConstructor(int(state)) || !profileMatchesConstructor(int(state&u64(0x3ffffffffffffff)))) return i32(1)
        index=index+1
    }
    var board=0
    while (board < 256) {
        val id=M5BoardId(board)
        var bit=0
        while (bit < 64) {
            val mask=int(u64(1)<<u64(bit))
            if (!profileMatchesConstructor((id.speakerProfile()|0)^mask) || !profileMatchesConstructor((id.microphoneProfile()|0)^mask) || !profileMatchesConstructor((id.touchProfile()|0)^mask)) return i32(2)
            bit=bit+1
        }
        board=board+1
    }
    return i32(0)
}
