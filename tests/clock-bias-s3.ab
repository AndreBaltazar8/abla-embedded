import "../src/esp32/clock_bias_s3.ab"
fun main(): int {
    var raw=0
    while (raw < 32768) {
        val k=raw & 127
        val v=raw>>>7
        val hvt=1+(raw % 31)
        val word4=(k<<13) | (k<<20) | ((v & 31)<<27)
        val word5=(v>>>5) | (v<<3) | (hvt<<11)
        val state=esp32S3ClockBiasDecode(1,2,word4,word5)
        val signedK=if (k < 64) k else 64-k
        val signedV=if (v < 128) v else 128-v
        val digBase=10841+signedV*20
        val rtcBase=10181+signedV*20
        var limit=31
        var b=30
        while (b >= 15) { if (digBase+(211+signedK)*(b-20) >= 13000) limit=b; b=b-1 }
        if (!state.calibrated() || state.digital240() != (if (hvt+3 < limit) hvt+3 else limit) ||
            state.digitalLow() != (if (hvt+2 < limit) hvt+2 else limit)) return 1
        var which=0
        while (which < 2) {
            val dig=if (which == 0) state.digital240() else state.digitalLow()
            val rtc=if (which == 0) state.rtc240() else state.rtcLow()
            val threshold=digBase+(211+signedK)*(dig-20)-250
            if (rtc < 15 || rtc > 31 || (rtc < 31 && rtcBase+(198+signedK)*(rtc-20) < threshold) ||
                (rtc > 15 && rtcBase+(198+signedK)*(rtc-21) >= threshold)) return 2
            which=which+1
        }
        raw=raw+1
    }
    var major=0
    while (major < 4) {
        var minor=0
        while (minor < 8) {
            val fallback=esp32S3ClockBiasDecode(major,minor,0,0)
            if (fallback.calibrated() || fallback.rtc240() != 28 || fallback.digital240() != 28 || fallback.rtcLow() != 27 || fallback.digitalLow() != 27) return 3
            val state=esp32S3ClockBiasDecode(major,minor,0,20<<11)
            if (state.calibrated() != ((major <= 1 && minor == 1) || major > 1 || (major == 1 && minor >= 2))) return 4
            minor=minor+1
        }
        major=major+1
    }
    0
}
