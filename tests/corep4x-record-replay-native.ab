import "../src/m5stack/corep4x_record_replay_sequence.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Es7210=int
type Es8311=int
type M5Ioe1=int
fun Es7210.valid(): bool = this == 7
fun Es8311.valid(): bool = this == 8
fun M5Ioe1.valid(): bool = this == 9
type M5P4RecordWindowResult=int
fun M5P4RecordWindowResult.status(): int = this&255
fun M5P4RecordWindowResult.bytes(): int = this >>> 32
type M5P4PlaybackWindowResult=int
fun M5P4PlaybackWindowResult.status(): int = this&255
val memory=nativeStaticAllocate(8192)
val base=(memory+63)&0xffffffc0
fun m5P4ReplayHandlesValid(mic: int,speaker: int,io: int,tab5: bool): bool = !tab5 && mic == 7 && speaker == 8 && io == 9
var step=0
var failure=0
var cleanupFail=false
var bad=false
var closes=0
trusted fun advance(n: int): void { step=step+1;if (step != n) bad=true;return }
fun esp32p4AhbGdmaRingLayoutValid(d: int,n: int,p: int,s: int,b: int): bool =
    d == base+512 && n == 2 && p == base+768 && s == 64 && b == 16
trusted fun m5P4ReplaySpeakerParked(channel: int,tab5: bool): int { if (tab5) bad=true; advance(1);if (channel != 1) bad=true;return if (failure == 1) 0 else 1 }
trusted fun m5P4ReplayMicrophonePrepareOwned(r: NativeBuffer,m: int,io: int,c: int,d: int,n: int,p: int,s: int,b: int,rev: int,polls: int,e: bool,tab5: bool): int {
    if (tab5) bad=true
    advance(2)
    if (m != 7 || io != 9 || c != 1 || !esp32p4AhbGdmaRingLayoutValid(d,n,p,s,b) || rev != 300 || polls != 7 || !e) bad=true
    r.storeU32(68,if (failure == 2) 3 else 1)
    return if (failure == 2) 3 else 1
}
trusted fun m5P4ReplayMicrophoneStartOwned(r: NativeBuffer,tab5: bool): int {
    val e=!tab5
    advance(3);if (!e || r.loadU32(68) != 1) bad=true
    r.storeU32(68,if (failure == 3) 3 else 2);return if (failure == 3) 3 else 2
}
trusted fun m5P4MicrophoneStopOwned(r: NativeBuffer,tab5: bool): int {
    val e=!tab5
    closes=closes+1;if (!e) bad=true;r.storeU32(68,if (cleanupFail) 3 else 4);return if (cleanupFail) 3 else 4
}
trusted fun m5P4RecordWindowOwned(r: NativeBuffer,out: NativeBuffer,blocks: int,maxIdle: int,e: bool,tab5: bool): M5P4RecordWindowResult {
    advance(4);if (tab5 || !e || blocks != 3 || maxIdle != 5 || r.loadU32(68) != 2) bad=true
    var i=0
    while (i < 10) { out.storeU16(i*4,10000);out.storeU16(i*4+2,-2000);i=i+1 }
    r.storeU32(68,if (failure == 4 && cleanupFail) 3 else 4)
    return M5P4RecordWindowResult((40 << 32)|(if (failure == 4) 3 else 1))
}
trusted fun m5P4ReplaySpeakerPrepareOwned(r: NativeBuffer,speaker: int,io: int,c: int,d: int,n: int,p: int,s: int,b: int,rev: int,polls: int,e: bool,tab5: bool): int {
    if (tab5) bad=true
    advance(5)
    if (!e || speaker != 8 || io != 9 || c != 1 || !esp32p4AhbGdmaRingLayoutValid(d,n,p,s,b) ||
        rev != 300 || polls != 7 || r.loadU32(0) != 0 || r.loadU32(64) != 0 || r.loadU32(128) != 0) bad=true
    var i=0
    while (i < 128) { if (nativeBufferAt(p,128).load(i) != 0) bad=true;i=i+1 }
    r.storeU32(68,if (failure == 5) 3 else 1);return if (failure == 5) 3 else 1
}
trusted fun m5P4ReplaySpeakerStartOwned(r: NativeBuffer,tab5: bool): int {
    val e=!tab5
    advance(6);if (!e || r.loadU32(68) != 1) bad=true
    r.storeU32(68,if (failure == 6) 3 else 2);return if (failure == 6) 3 else 2
}
trusted fun m5P4SpeakerStopOwned(r: NativeBuffer,tab5: bool): int {
    val e=!tab5
    closes=closes+1;if (!e) bad=true;r.storeU32(68,if (cleanupFail) 3 else 4);return if (cleanupFail) 3 else 4
}
trusted fun m5P4PlaybackChannelsWindowOwned(r: NativeBuffer,bank: PcmChannels,blocks: int,acc: NativeBuffer,
    scratch: NativeBuffer,staging: NativeBuffer,maxIdle: int,gain: int,e: bool,tab5: bool): M5P4PlaybackWindowResult {
    advance(7)
    if (tab5) bad=true
    if (!e || !bank.valid() || blocks != 2 || maxIdle != 5 || gain != 32768 || r.loadU32(68) != 2 ||
        acc.addressValue() != base+1536+144 || scratch.addressValue() != acc.addressValue()+64 || staging.addressValue() != scratch.addressValue()+32) bad=true
    // Real mixer consumes the actual40B processed clip (10 stereo frames),
    // not the48B reserved recording capacity. Two8frame mono blocks suffice.
    if (!bank.renderOutput(8,acc,scratch,staging,false,gain) || bank.playingChannels() != 1 ||
        !bank.renderOutput(8,acc,scratch,staging,false,gain) || bank.playingChannels() != 0) bad=true
    var i=4
    while (i < 16) { if (staging.load(i) != 0) bad=true;i=i+1 }
    r.storeU32(68,if (failure == 7 && cleanupFail) 3 else 4)
    return M5P4PlaybackWindowResult(if (failure == 7) 4 else 1)
}
trusted fun reset(): void {
    val r=nativeBufferAt(base,192)
    r.storeU32(0,0);r.storeU32(64,0);r.storeU32(128,0)
    var i=0
    while (i < 128) { nativeBufferAt(base+768,128).store(i,0xab);i=i+1 }
    step=0;closes=0;bad=false;return
}
trusted fun run(r: NativeBuffer,recorded: NativeBuffer,work: NativeBuffer): int =
    coreP4xRecordReplayOwned(r,1,base+512,2,base+768,64,16,300,7,Es7210(7),Es8311(8),M5Ioe1(9),recorded,work,3,5,true)
@export("abla_corep4x_record_replay_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(base,192);val recorded=nativeBufferAt(base+1024,48);val work=nativeBufferAt(base+1536,256)
    var mode=0
    while (mode < 2) {
        cleanupFail=mode == 1;failure=0
        while (failure <= 7) {
            reset()
            val result=run(r,recorded,work)
            val expected=if (failure == 0) 1 else if (failure == 1) 2 else if (failure < 5) failure+1 else failure+2
            if ((result&255) != expected || step != (if (failure == 0) 7 else failure) || bad ||
                (result >>> 32) != (if (failure != 0 && failure < 4) 0 else 40) ||
                ((result&(1 << 24)) != 0) != (cleanupFail && failure > 1)) return i32(1)
            failure=failure+1
        }
        mode=mode+1
    }
    reset()
    if (run(r,recorded,nativeBufferAt(work.addressValue(),255)) != 2 || step != 0 ||
        run(r,nativeBufferAt(base+188,48),work) != 2 || step != 0 ||
        run(r,nativeBufferAt(base+880,48),work) != 2 || step != 0 ||
        run(r,nativeBufferAt(base+520,48),work) != 2 || step != 0 ||
        run(r,recorded,nativeBufferAt(base+1024,256)) != 2 || step != 0) return i32(2)
    return i32(0)
}
