import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this|0
fun Pin.valid(): bool = espChipS3().gpioValid(this|0)
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this|0)
val gateStorage=nativeStaticAllocate(4)
val fifo=nativeStaticAllocate(64)
val wire=nativeStaticAllocate(262144)
val pixels=nativeStaticAllocate(192000)
val staging=nativeStaticAllocate(64)
val sessionStorage=nativeStaticAllocate(64)
var count=0
var transfers=0
var failAt=0
var cs=true
var dc=false
var bad=false
var user=0
var length=0
var events=0
var waits=0
var busyBefore=0
var busyAfter=0
var activated=false
var settled=false
var busyReads=0
var wakeSteps=0
var wakeFail=0
var startupSteps=0
var startupFail=0
fun paperMonoDisplayStorageAdmission(control: int,r: NativeBuffer,canvas: NativeBuffer,history: NativeBuffer,gate: PeripheralGate): bool =
    control == 7 && gate == peripheralGateAt(gateStorage)
trusted fun paperMonoDisplayFrontlight(control: int,level: int,initialize: bool): int {
    startupSteps=startupSteps+1
    val r=nativeBufferAt(sessionStorage,64)
    if (control != 7 || (initialize && (startupSteps != 1 || level != 0 || r.loadU32(4) != 2)) ||
        (!initialize && (startupSteps != 4 || level != 73 || r.loadU32(4) != 1 || (r.loadU32(24)&8) == 0))) bad=true
    return if (startupFail == startupSteps) 6 else 1
}
trusted fun paperMonoDisplayPanelStartup(control: int,gate: PeripheralGate,owner: u32,polls: int): int {
    startupSteps=startupSteps+1
    if (startupSteps != 2 || control != 7 || nativeBufferAt(sessionStorage,64).loadU32(4) != 2) bad=true
    if (startupFail == 2) return 3|(1796<<8)
    val result=esp32s3Ssd1677Initialize(gate,owner,2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),polls,true)
    return if (result.valid()) 1 else 6|((result|0)<<8)
}
trusted fun paperMonoDisplayRefresh(session: Ssd1677Session,gate: PeripheralGate,owner: u32,mode: int,polls: int): SpiTransactionResult {
    startupSteps=startupSteps+1
    if (startupSteps != 3 || session.buffer().loadU32(4) != 1 || session.buffer().loadU32(24) != 1) bad=true
    if (startupFail == 3) return SpiTransactionResult((6<<32)|14)
    return session.refreshOwned(gate,owner,2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),mode,polls,true)
}
fun paperMonoWakeAdmission(control: int,session: Ssd1677Session,gate: PeripheralGate): bool = control == 7 && session.valid() && gate == peripheralGateAt(gateStorage)
trusted fun paperMonoWakeSelect(): bool { wakeSteps=wakeSteps+1;return wakeFail != 1 && Pin(16).outputLevelOwned(true) }
trusted fun paperMonoWakeReset(control: int): int {
    wakeSteps=wakeSteps+1
    if (control != 7 || !cs || nativeAddressLoadU32(gateStorage,0) != 37 || wakeSteps != 2) bad=true
    return if (wakeFail == 2) 4 else 1
}
trusted fun paperMonoWakeInitializeOwned(polls: int): int {
    wakeSteps=wakeSteps+1
    if (wakeSteps != 3) bad=true
    return esp32s3Ssd1677InitializeOwned(2,Pin(16),Pin(17),Pin(18),polls)
}
trusted fun Pin.read(): bool {
    if (this != 18 || !cs || !settled || nativeAddressLoadU32(gateStorage,0) != 37) bad=true
    busyReads=busyReads+1
    if (activated) {
        if (busyAfter == 0) return false
        busyAfter=busyAfter-1;return true
    }
    if (busyBefore == 0) return false
    busyBefore=busyBefore-1;return true
}
trusted fun Pin.outputLevelOwned(high: bool): bool = this.writeLevelOwned(high)
trusted fun Pin.writeLevelOwned(high: bool): bool {
    if (nativeAddressLoadU32(gateStorage,0) != 37) bad=true
    if (this == 16) cs=high else if (this == 17) dc=high else bad=true
    return !bad
}
fun Pin.inputOwned(): bool { bad=true;return false }
fun Pin.routeOutputSignal(signal: int,inverted: bool): bool { bad=true;return false }
fun Pin.routeInputSignal(signal: int,inverted: bool): bool { bad=true;return false }
fun peripheralDelayMilliseconds(ms: int): void {
    if (!cs || (ms != 1 && ms != 2 && ms != 10) || nativeAddressLoadU32(gateStorage,0) != 37) bad=true
    if (ms == 2) settled=true
    waits=waits+ms;return
}
fun peripheralDelayMicroseconds(us: int): void { bad=true;return }
trusted fun esp32s3SpiRead(address: int): int {
    if (address == 0x60024000 || address == 0x60024030 || address == 0x60024034 || address == 0x600240e0) return 0
    if (address == 0x60024010) return user
    if (address == 0x6002401c) return length
    if (address == 0x6002403c) return events
    bad=true;return 0
}
trusted fun esp32s3SpiWrite(address: int,value: int): void {
    if (nativeAddressLoadU32(gateStorage,0) != 37) bad=true
    if (address == 0x60024010) user=value
    else if (address == 0x6002401c) length=value
    else if (address == 0x60024038) events=events&~value
    else if (address >= 0x60024098 && address < 0x600240d8 && (address&3) == 0) nativeAddressStoreU32(fifo,address-0x60024098,value)
    else if (address == 0x60024000) {
        if (value == 0x01000000) {
            transfers=transfers+1
            val bytes=((length&262143)+1)/8
            if (cs || bytes < 1 || bytes > 64 || (length&7) != 7 || (user&0x18000001) != 0x08000000) bad=true
            var n=0
            while (n < bytes) {
                if (count >= 131072) { bad=true;return }
                val payloadByte=nativeBufferAt(fifo,64).load(n)
                if (!dc && payloadByte == 32) { activated=true;settled=false }
                nativeBufferAt(wire,262144).storeU16(count*2,payloadByte|(if (dc) 256 else 0))
                count=count+1;n=n+1
            }
            events=4096|(if (transfers == failAt) 0x20000 else 0)
        } else if (value != 0x00800000) bad=true
    } else bad=true
    return
}
trusted fun seed(): void {
    nativeAddressStoreU32(gateStorage,0,0)
    count=0;transfers=0;failAt=0;cs=true;dc=false;bad=false;user=0;length=0;events=0;waits=0
    busyBefore=0;busyAfter=0;activated=false;settled=false;busyReads=0;return
}
trusted fun byte(index: int): int = nativeBufferAt(wire,262144).loadU16(index*2)

trusted fun upload(height: int,mode: int,odd: bool): SpiTransactionResult =
    esp32s3Ssd1677Upload(peripheralGateAt(gateStorage),u32(37),2,spiPins(14,-1,15),Pin(16),Pin(17),
        nativeBufferAt(pixels,100*height*2),nativeBufferAt(pixels+96000,100*height*2),
        800,height,mode,odd,false,3,1,19,1,true)
trusted fun checkWindow(offset: int,height: int): bool {
    return byte(offset) == 0x11 && byte(offset+1) == 257 &&
        byte(offset+2) == 0x44 && byte(offset+3) == 256 && byte(offset+4) == 256 &&
        byte(offset+5) == 287 && byte(offset+6) == 259 &&
        byte(offset+7) == 0x45 && byte(offset+8) == (256|((height-1)&255)) &&
        byte(offset+9) == (256|((height-1)>>8)) && byte(offset+10) == 256 && byte(offset+11) == 256 &&
        byte(offset+12) == 0x4e && byte(offset+13) == 256 && byte(offset+14) == 256 &&
        byte(offset+15) == 0x4f && byte(offset+16) == (256|((height-1)&255)) && byte(offset+17) == (256|((height-1)>>8))
}
trusted fun refresh(mode: int,on: bool): SpiTransactionResult =
    esp32s3Ssd1677Refresh(peripheralGateAt(gateStorage),u32(37),2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),
        nativeBufferAt(pixels,400),nativeBufferAt(pixels+96000,400),800,2,mode,false,false,on,3,1,19,1,3,true)
trusted fun initialize(): SpiTransactionResult =
    esp32s3Ssd1677Initialize(peripheralGateAt(gateStorage),u32(37),2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),3,true)
trusted fun sessionRefresh(session: Ssd1677Session,mode: int): SpiTransactionResult =
    session.refreshOwned(peripheralGateAt(gateStorage),u32(37),2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),mode,3,true)
trusted fun sessionPower(session: Ssd1677Session,action: int): SpiTransactionResult =
    session.powerOwned(peripheralGateAt(gateStorage),u32(37),2,spiPins(14,-1,15),Pin(16),Pin(17),Pin(18),action,3,true)
@export("abla_ssd1677_transport_test")
trusted fun test(): i32 {
    val canvas=nativeBufferAt(pixels,96000)
    val history=nativeBufferAt(pixels+96000,96000)
    var i=0
    while (i < 96000) { canvas.store(i,if (i < 48000) 85 else 170);history.store(i,255);i=i+1 }
    seed()
    if (!upload(480,1,false).valid() || bad || !cs || count != 96152 || transfers != 1951) return i32(1)
    if (!checkWindow(0,480) || !checkWindow(48019,480) || byte(18) != 36 || byte(48037) != 38) return i32(2)
    i=0
    while (i < 48000) {
        if (byte(19+i) != 426 || byte(48038+i) != 341) return i32(3)
        i=i+1
    }
    val lut=ssd1677LutQuality()
    if (byte(96038) != 50 || byte(96144) != 3 || byte(96146) != 4 || byte(96150) != 44) return i32(4)
    i=0
    while (i < 105) { if (byte(96039+i) != (256|lut.load(i))) return i32(5);i=i+1 }
    if (byte(96145) != (256|lut.load(105)) || byte(96147) != (256|lut.load(106)) ||
        byte(96148) != (256|lut.load(107)) || byte(96149) != (256|lut.load(108)) ||
        byte(96151) != (256|lut.load(109))) return i32(6)
    // Every hardware-transfer failure in a2-row upload, including LUT tail.
    var failure=1
    while (failure <= 39) {
        seed();failAt=failure
        val result=upload(2,1,false)
        if (result.status() != 6 || result.value() != u32(0x20109) || transfers != failure ||
            bad || !cs || nativeAddressLoadU32(gateStorage,0) != 2147483648) return i32(7)
        failure=failure+1
    }
    seed()
    if (!upload(2,3,true).valid() || count != 552 || transfers != 39 || bad || !cs) return i32(8)
    i=0
    while (i < 96000) {
        if (canvas.load(i) != (if (i < 48000) 85 else 170) || history.load(i) != 255) return i32(9)
        i=i+1
    }
    var mode=1
    while (mode <= 4) {
        var on=0
        while (on < 2) {
            seed();busyAfter=2
            if (!refresh(mode,on == 1).valid() || count != 557 || transfers != 44 || bad || !cs ||
                waits != 6 || busyReads != 4 || !activated) return i32(10)
            val control=(if (mode <= 2) 7 else 12)|(if (on == 0) 192 else 0)
            if (byte(552) != 33 || byte(553) != 256 || byte(554) != 34 ||
                byte(555) != (256|control) || byte(556) != 32) return i32(11)
            on=on+1
        }
        mode=mode+1
    }
    failure=1
    while (failure <= 44) {
        seed();failAt=failure
        val failed=refresh(3,false)
        if (failed.status() != 6 || failed.value() != u32(0x20109) || transfers != failure || bad || !cs ||
            nativeAddressLoadU32(gateStorage,0) != 2147483648) return i32(12)
        failure=failure+1
    }
    seed();busyBefore=4
    val early=refresh(1,false)
    if (early.status() != 6 || early.value() != u32(14) || transfers != 0 || busyReads != 4 || waits != 5 || bad) return i32(13)
    seed();busyAfter=4
    val late=refresh(1,false)
    if (late.status() != 6 || late.value() != u32(14) || transfers != 44 || busyReads != 5 || waits != 7 || bad || !cs ||
        nativeAddressLoadU32(gateStorage,0) != 2147483648) return i32(14)
    seed()
    if (!initialize().valid() || count != 37 || transfers != 23 || busyReads != 5 || waits != 20 || bad || !cs) return i32(15)
    val init=nativeBufferAt(nativeStaticBytes("\x12\x18\x80\x0c\xae\xc7\xc3\xc0\x40\x01\xdf\x01\x02\x3c\x01"),15)
    i=0
    while (i < 15) {
        val data=i != 0 && i != 1 && i != 3 && i != 9 && i != 13
        if (byte(i) != (init.load(i)|(if (data) 256 else 0))) return i32(16)
        i=i+1
    }
    if (!checkWindow(15,480) || byte(33) != 70 || byte(34) != 503 || byte(35) != 71 || byte(36) != 503) return i32(17)
    failure=1
    while (failure <= 23) {
        seed();failAt=failure
        val result=initialize()
        if (result.status() != 6 || result.value() != u32(0x20109) || transfers != failure || bad || !cs ||
            nativeAddressLoadU32(gateStorage,0) != 2147483648) return i32(18)
        failure=failure+1
    }
    val record=nativeBufferAt(sessionStorage,64)
    i=0
    while (i < 64) { record.store(i,0);i=i+1 }
    val session=ssd1677SessionOpenOwned(record,canvas,history,false,true)
    if (session == 0 || !session.valid() || record.loadU32(24) != 0 ||
        ssd1677SessionOpenOwned(record,canvas,history,false,true) != 0) return i32(19)
    seed()
    if (!sessionRefresh(session,4).valid() || bad || !cs || count != 96194 || transfers != 1979 ||
        record.loadU32(24) != 15 || record.loadU32(52) != 3 || record.loadU32(36) != 0) return i32(20)
    i=0
    while (i < 96000) { if (history.load(i) != canvas.load(i)) return i32(21);i=i+1 }
    seed()
    if (!sessionRefresh(session,4).valid() || transfers != 0 || waits != 0) return i32(22)
    canvas.store(48100,42)
    if (!session.markDirtyOwned(0,1,1,1,true)) return i32(23)
    seed()
    if (!sessionRefresh(session,4).valid() || count != 96157 || transfers != 1956 ||
        record.loadU32(24) != 13 || record.loadU32(52) != 4 || bad) return i32(24)
    i=0
    while (i < 96000) {
        val expected=if (i == 48100) 42 else if (i < 48000) 85 else 170
        if (history.load(i) != expected) return i32(25)
        i=i+1
    }
    if (!session.markDirtyOwned(1,1,2,2,true) || !session.markDirtyOwned(0,0,1,1,true) ||
        record.loadU32(28) != 0 || record.loadU32(32) != 0 || record.loadU32(36) != 3 || record.loadU32(40) != 3) return i32(26)
    seed();failAt=1956
    val broken=sessionRefresh(session,1)
    if (broken.status() != 6 || record.loadU32(4) != 2 || record.loadU32(24) != 0 ||
        record.loadU32(36) != 3 || record.loadU32(40) != 3 || bad || !cs) return i32(27)
    val before=transfers
    if (sessionRefresh(session,1).status() != 4 || transfers != before ||
        session.invalidateAfterResetOwned(false)) return i32(28)
    // Explicit model reset/recovery, never automatic hardware replay.
    seed()
    if (!session.invalidateAfterResetOwned(true) || !sessionRefresh(session,2).valid() ||
        record.loadU32(24) != 9 || record.loadU32(4) != 1 || record.loadU32(36) != 0 || bad) return i32(29)
    var rotation=0
    while (rotation < 8) {
        if (!session.drawPaperMonoOwned(-1,-1,2,2,rotation,NativeBuffer(0),0,0,true) ||
            session.readPaperMono(0,0,rotation) != 0) return i32(30)
        val right=rotation == 2 || rotation == 3 || rotation == 4 || rotation == 7
        val bottom=rotation == 0 || rotation == 3 || rotation == 4 || rotation == 5
        if (record.loadU32(28) != (if (right) 792 else 0) || record.loadU32(32) != (if (bottom) 479 else 0) ||
            record.loadU32(36) != 8 || record.loadU32(40) != 1) return i32(31)
        seed()
        if (!sessionRefresh(session,4).valid() || record.loadU32(36) != 0 || bad || !cs) return i32(32)
        rotation=rotation+1
    }
    // Invalid source storage and malformed dirty state must not change pixels.
    val firstPixel=canvas.load(0)
    if (session.drawPaperMonoOwned(0,0,1,1,0,record,1,-1,true) ||
        session.drawPaperMonoOwned(0,0,1,1,0,history,1,-1,true) ||
        session.drawPaperMonoOwned(0,0,1,1,0,canvas,1,-1,true) ||
        session.drawPaperMonoOwned(0,0,1,1,8,NativeBuffer(0),0,0,true) || record.loadU32(36) != 0 || canvas.load(0) != firstPixel) return i32(33)
    if (!session.drawPaperMonoOwned(1000,1000,2,2,0,NativeBuffer(0),0,0,true) || record.loadU32(36) != 0) return i32(34)
    record.storeU32(40,1)
    if (session.drawPaperMonoOwned(0,0,1,1,0,NativeBuffer(0),0,0,true) || canvas.load(0) != firstPixel) return i32(35)
    record.storeU32(40,0)
    var action=0
    while (action < 3) {
        // Known awake state in the model; no actual hardware reset performed.
        record.storeU32(4,1);record.storeU32(24,15)
        seed();busyAfter=2
        if (!sessionPower(session,action).valid() || bad || !cs || waits != 6 || busyReads != 4 ||
            count != (if (action == 2) 5 else 3) || transfers != (if (action == 2) 5 else 3) ||
            byte(0) != 34 || byte(1) != (256|(if (action == 1) 192 else 3)) || byte(2) != 32 ||
            record.loadU32(24) != (if (action == 1) 4 else 0) || record.loadU32(36) != 800 || record.loadU32(40) != 480 ||
            record.loadU32(4) != (if (action == 2) 3 else 1)) return i32(36)
        if (action == 2) {
            if (byte(3) != 16 || byte(4) != 257 || !sessionPower(session,2).valid() || transfers != 5 ||
                sessionPower(session,1).status() != 3 || sessionRefresh(session,1).status() != 3) return i32(37)
        }
        failure=1
        while (failure <= (if (action == 2) 5 else 3)) {
            record.storeU32(4,1);record.storeU32(24,15)
            seed();failAt=failure
            val failed=sessionPower(session,action)
            if (failed.status() != 6 || failed.value() != u32(0x20109) || record.loadU32(4) != 2 ||
                record.loadU32(24) != 0 || transfers != failure || bad || !cs) return i32(38)
            failure=failure+1
        }
        action=action+1
    }
    record.storeU32(4,1)
    seed();busyAfter=4
    if (sessionPower(session,2).value() != u32(14) || transfers != 3 || count != 3 || record.loadU32(4) != 2 || bad) return i32(39)
    wakeFail=0
    while (wakeFail <= 3) {
        record.storeU32(4,3);record.storeU32(24,0)
        seed();wakeSteps=0
        if (wakeFail == 3) failAt=23
        val result=paperMonoWakeOwned(7,session,peripheralGateAt(gateStorage),u32(37),3,true)
        val expected=if (wakeFail == 0) 1 else if (wakeFail == 1) 12 else if (wakeFail == 2) 1040 else 0x20109
        if (result.status() != (if (wakeFail == 0) 1 else 6) || result.value() != u32(expected) ||
            wakeSteps != (if (wakeFail == 1) 1 else if (wakeFail == 2) 2 else 3) ||
            record.loadU32(4) != (if (wakeFail == 0) 1 else 2) || record.loadU32(24) != (if (wakeFail == 0) 1 else 0) ||
            record.loadU32(36) != 800 || record.loadU32(40) != 480 || bad || !cs) return i32(40)
        wakeFail=wakeFail+1
    }
    startupFail=0
    while (startupFail <= 4) {
        i=0
        while (i < 64) { record.store(i,0);i=i+1 }
        seed();startupSteps=0
        val result=paperMonoDisplayStartupOwned(7,record,canvas,history,peripheralGateAt(gateStorage),u32(37),4,73,3,true)
        val expected=if (startupFail == 0) 1 else if (startupFail == 1) 3|(6<<8) else if (startupFail == 2)
            4|((3|(1796<<8))<<8) else if (startupFail == 3) 6|(((6<<32)|14)<<8) else 7|(6<<8)
        if (result != expected || bad || !cs || startupSteps != (if (startupFail == 0) 4 else startupFail) ||
            (record.loadU32(56)|(record.loadU32(60)<<32)) != result ||
            record.loadU32(4) != (if (startupFail == 0 || startupFail == 4) 1 else 2)) return i32(41)
        if ((startupFail == 0 || startupFail == 4) &&
            (record.loadU32(24) != 15 || record.loadU32(36) != 0 || transfers != 1979)) return i32(42)
        val savedSteps=startupSteps
        if (paperMonoDisplayStartupOwned(7,record,canvas,history,peripheralGateAt(gateStorage),u32(37),4,73,3,true) != 2 ||
            startupSteps != savedSteps) return i32(43)
        startupFail=startupFail+1
    }
    seed()
    if (session.setInvertOwned(true,false) || !session.setInvertOwned(true,true) ||
        record.loadU32(24) != 23 || record.loadU32(36) != 800 || record.loadU32(40) != 480 || transfers != 0) return i32(44)
    if (!sessionRefresh(session,4).valid() || record.loadU32(52) != 3 ||
        record.loadU32(24) != 29 || record.loadU32(36) != 0 || bad) return i32(45)
    i=0
    while (i < 48000) {
        if (byte(19+i) != (256|canvas.load(i)) || byte(48038+i) != (256|canvas.load(48000+i)) ||
            history.load(i) != canvas.load(i) || history.load(48000+i) != canvas.load(48000+i)) return i32(53)
        i=i+1
    }
    seed()
    if (!session.setInvertOwned(true,true) || !sessionRefresh(session,4).valid() || transfers != 0) return i32(46)
    if (!session.markDirtyOwned(3,1,5,1,true) || !sessionRefresh(session,4).valid() ||
        record.loadU32(52) != 4 || record.loadU32(24) != 31 || bad) return i32(47)
    seed()
    if (!sessionPower(session,2).valid() || record.loadU32(24) != 16 ||
        record.loadU32(4) != 3 || sessionRefresh(session,4).status() != 3) return i32(48)
    seed();wakeFail=0;wakeSteps=0
    if (!paperMonoWakeOwned(7,session,peripheralGateAt(gateStorage),u32(37),3,true).valid() ||
        record.loadU32(24) != 17 || bad) return i32(49)
    seed();failAt=1
    if (sessionRefresh(session,4).status() != 6 || record.loadU32(24) != 16 ||
        record.loadU32(4) != 2 || bad) return i32(50)
    seed()
    if (!session.invalidateAfterResetOwned(true) || record.loadU32(24) != 16 ||
        !sessionRefresh(session,4).valid() || record.loadU32(24) != 31 || bad) return i32(51)
    if (!session.setInvertOwned(false,true) || record.loadU32(24) != 7 || record.loadU32(36) != 800) return i32(52)
    return i32(0)
}
