import "../src/m5stack/power_off_pulse_sequence.ab"
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"
import "abla/build"
var calls=0
var failAt=0
var expectedPin=4
var expectedHandle=7
var bad=false
fun m5PowerOffPulseWrite(handle: int,pin: int,high: bool): bool {
    if (handle != expectedHandle || pin != expectedPin || high != ((calls & 1) != 0)) bad=true
    calls=calls+1
    calls != failAt
}
@export("abla_power_off_pulse_test")
trusted fun pulseTest(): i32 {
    val context=nativeBufferAt(nativeStaticAllocate(24),24)
    var model=0
    while (model < 3) {
        val board=if (model == 0) m5BoardTab5 else if (model == 1) m5BoardTab5X else m5BoardArduinoNessoN1
        expectedPin=if (model < 2) 4 else 0
        failAt=0
        while (failAt <= 10) {
            calls=0; bad=false
            var now=u32(4294967270)
            var status=board.beginPowerOffPulse(context,7,now,true)
            if (status != (if (failAt == 1) 4 else 2) || m5PowerOffPulseStatus(context) != status || calls != 1) return i32(1)
            var edge=1
            while (status == 2 && edge <= 10) {
                // Long transfer/late first poll must not shorten the hold.
                now=now+u32(100)
                if (m5PowerOffPulsePoll(context,now) != 2 || calls != edge) return i32(2)
                if (m5PowerOffPulsePoll(context,now+u32(49)) != 2 || calls != edge) return i32(3)
                now=now+u32(50)
                status=m5PowerOffPulsePoll(context,now)
                if (status != (if (edge == 10) 1 else if (failAt == edge+1) 4 else 2)) return i32(4)
                edge=edge+1
            }
            val before=calls
            if (m5PowerOffPulsePoll(context,now+u32(1000)) != status || calls != before || bad ||
                calls != (if (failAt == 0) 10 else failAt)) return i32(5)
            failAt=failAt+1
        }
        model=model+1
    }
    // GPIO power-hold reuses the exact edge/hold engine without an I2C handle.
    expectedHandle=0; expectedPin=44; failAt=0; calls=0; bad=false
    var tick=u32(0)
    if (m5PowerOffPulseBeginOwned(context,0,44,tick,true) != 2) return i32(7)
    var sent=1
    while (sent <= 10) {
        if (m5PowerOffPulsePoll(context,tick) != 2 || calls != sent) return i32(8)
        tick=tick+u32(50)
        if (m5PowerOffPulsePoll(context,tick) != (if (sent == 10) 1 else 2)) return i32(9)
        sent=sent+1
    }
    if (calls != 10 || bad) return i32(10)
    calls=0; context.storeU32(0,0xdeadbeef)
    if (m5BoardAtomVoice.beginPowerOffPulse(context,7,u32(0),true) != 3 ||
        m5BoardTab5.beginPowerOffPulse(context,7,u32(0),false) != 3 ||
        m5BoardTab5.beginPowerOffPulse(context,0,u32(0),true) != 3 ||
        m5BoardTab5.beginPowerOffPulse(context,4294967296,u32(0),true) != 3 ||
        m5BoardTab5.beginPowerOffPulse(nativeBufferAt(context.addressValue(),23),7,u32(0),true) != 3 ||
        m5PowerOffPulsePoll(context,u32(0)) != 3 || calls != 0 || context.loadU32(0) != 0xdeadbeef) return i32(6)
    i32(0)
}
